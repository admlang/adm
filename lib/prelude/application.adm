partial module builtin {
	use std.reflection::(DeclarationMetaContext, DiscoveryMetaContext)

	// Supplies a unit's identity when there is no `adm.toml` manifest. On an
	// application, `name` fills `__app_name__` (and `__app_id__`) and `version`
	// fills `__app_version__`; on a plugin, `version` is the plugin's version in
	// its `.admplugin`. A `adm.toml` in the build, when present, wins over both.
	// Read by the compiler at build time.
	//
	//     @manifest(name = "myapp", version = "1.2.0")
	//     application MyApp { ... }
	meta def manifest(ctx DiscoveryMetaContext<DeclarationMetaContext>, name string = "", version string = "") {
		// intrinsic
	}
}
