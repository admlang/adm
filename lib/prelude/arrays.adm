partial module builtin {
	use std.crypto

	// The array type is a generic, resizable list of elements of type T.
	@builtin(primitive = "array")
	type array<T> {
		// Internal pointer to the array data. For runtime use only.
		internal arrayPtr int
		// Internal length of the array. For runtime use only.
		internal length   int
		// Internal capacity of the array. For runtime use only.
		internal capacity int

		// Runtime hook: ensure the backing store can hold `newCap` elements and return the new pointer.
		// Backends replace this with an allocator/grow operation.
		internal asm def __rt_reserve(newCap int) int {
			reserve {self.arrayPtr} {self.length} {self.capacity} {newCap}
		}

		internal def ensureCapacity(required int) int {
			return capacity when required <= capacity

			let next = capacity
			next = 1 when next <= 0
			for next < required {
				next = next * 2
			}
			let ptr = __rt_reserve(next)
			arrayPtr = ptr
			capacity = next
			return capacity
		}

		// Creates a new, empty array.
		def new() {
			arrayPtr = 0
			length = 0
			capacity = 0
		}

		where T is byte {
			def base64() string {
				use std.data.encoding::(base64encode)

				return base64encode(self)
			}

			// Uppercase hex, two characters per byte.
			def hex() string {
				let out byte[]
				for let (_, b) in self {
					let hi = int(b) >> 4
					let lo = int(b) & 0x0F
					out.push(byte(hi + 48)) when hi < 10
					out.push(byte(hi + 55)) when hi > 9
					out.push(byte(lo + 48)) when lo < 10
					out.push(byte(lo + 55)) when lo > 9
				}
				return string(out)
			}
		}

		// Returns a new array containing only the elements for which the callback function returns true.
		def filter(fn def (T) bool) T[] {
			let res = T[]
			for let (i, v) in self {
				if fn(v) {
					res.push(v)
				}
			}
			return res
		}

		// Creates an array of elements split into groups the length of size. If array can't be split evenly, the final chunk will be the remaining elements.
		def chunk(size int) T[][] {
			// @TODO
			return []
		}

		// Returns a new array containing elements that exist in both this array and the other array.
		def intersect(other T[]) T[] {
			let res = T[]
			for let i = 0; i < len(); i++ {
				if other.includes(self[i]) {
					res.push(self[i])
				}
			}
			return res
		}

		// Returns a new array containing all elements from this array followed by all elements from the other array.
		def concat(other T[]) T[] {
			// intrinsic: lowered by the compiler/runtime (`concat(other)`)
		}

		// Alias for concat. Returns a new array containing elements from both arrays.
		def unions(other T[]) T[] {
			let res = clone()
			for let (_, v) in other {
				if !res.includes(v) {
					res = res.push(v)
				}
			}
			return res
		}

		// Returns the first index at which a given element can be found in the array, or -1 if it is not present.
		def indexOf(val T) int {
			for let (i, v) in self {
				if v == val {
					return i
				}
			}
			return -1
		}

		// Returns the last index at which a given element can be found in the array, or -1 if it is not present.
		def lastIndexOf(val T) int {
			for let i = len() - 1; i >= 0; i-- {
				if self[i] == val {
					return i
				}
			}
			return -1
		}

		// Returns true if the array contains the specified value, and false otherwise.
		def includes(value T) bool {
			return indexOf(value) != -1
		}

		// Returns a shallow copy of a portion of an array into a new array object.
		def slice(start int, count ?int) T[] {
			// intrinsic: lowered by the compiler/runtime (slicing and copying)
		}

		// Replaces the element at index with values, none or several, and returns the
		// new array.
		def splice(index int, values ...T) T[] {
			let tmp = self[:index] + values + self[index + 1:]
			return tmp
		}

		// Shuffles the elements into a random order in place and returns the array.
		// Use `clone().shuffle()` to leave the original alone.
		def shuffle() T[] {
			let n = len()
			for let i = n - 1; i > 0; i-- {
				let j = crypto.randRange<int>(0, i + 1)
				self[i], self[j] = self[j], self[i]
			}

			return self
		}

		// Reverses the elements in place and returns the array. Use
		// `clone().reverse()` to leave the original alone.
		def reverse() T[] {
			// intrinsic: lowered by the compiler/runtime (`reverse()`)
		}

		// Removes the element at the given index in place and returns the array.
		// Negative index removes from the end; an index still out of range after
		// normalizing leaves the array untouched. Capacity is kept. Use
		// `clone().remove(i)` to leave the original alone.
		def remove(index int) T[] {
			// intrinsic: lowered by the compiler/runtime (`remove(i)`)
		}

		// Removes every occurrence of the given elements in place and returns the
		// array. Use `clone().pull(...)` to leave the original alone.
		def pull(elem ...T) T[] {
			// Walk backwards so removing an element cannot shift an index that
			// has not been visited yet. `remove` releases ARC elements, which a
			// manual compact-and-shrink would not.
			for let i = len() - 1; i >= 0; i-- {
				if elem.includes(self[i]) {
					remove(i)
				}
			}
			return self
		}

		// Returns the last element of the array, or none if the array is empty.
		def last() ?T {
			// intrinsic: lowered by the compiler/runtime (`last()`)
		}

		// Returns the first element of the array, or none if the array is empty.
		def first() ?T {
			// intrinsic: lowered by the compiler/runtime (`first()`)
		}

		// Returns the number of elements in the array.
		def len() int {
			// intrinsic: lowered by the compiler/runtime (`len()`)
		}

		// Sets the length of the array.
		def len(size int) int {
			// intrinsic: lowered by the compiler/runtime (`len(size)`)
		}

		// Returns the capacity of the array.
		def cap() int {
			// intrinsic: lowered by the compiler/runtime (`cap()`)
		}

		// Sets the capacity of the array.
		def cap(size int) int {
			// intrinsic: lowered by the compiler/runtime (`cap(size)`)
		}

		// Appends one or more elements in place, growing capacity as needed, and
		// returns the array so calls can chain. Every holder of the array sees the
		// appended elements; use `clone().push(...)` for a copy.
		def push(values ...T) T[] {
			// intrinsic: lowered by the compiler/runtime (`push(...)`)
		}

		// Removes the last element from an array and returns that element.
		def pop() T {
			// intrinsic: lowered by the compiler/runtime (`pop()`)
		}

		// Removes the first element from an array and returns that removed element.
		def shift() T {
			// intrinsic: lowered by the compiler/runtime (`shift()`)
		}

		// Removes all elements from an array, leaving it empty.
		def flush() T[] {
			// intrinsic: lowered by the compiler/runtime (`flush()`)
		}

		// Creates a new array populated with the results of calling a provided function on every element in the calling array.
		def mapElem<V>(fn def (T) V) V[] {
			let result V[]
			for let (_, v) in self {
				result.push(fn(v))
			}
			return result
		}

		// Returns only elements that pass the test implemented by the provided function.
		def everyElem(fn def (value T) bool) T[] {
			return []
		}

		// Adds one or more values to the beginning of the array.
		def unshift(values ...T) T[] {
			// intrinsic: lowered by the compiler/runtime (`unshift(...)`)
		}

		// Fills all the elements of an array from a start index to an end index with a static value.
		// A negative `end` (the default) fills through the last element.
		def fill(value T, start int = 0, end int = -1) T[] {
			// `self[start:end]` reads a negative `end` as an index counted back
			// from the tail, so the default -1 stopped one short and left the
			// last element untouched.
			if end < 0 {
				self[start:] = value
			} else {
				self[start:end] = value
			}
			return self
		}

		// Returns the first element in the array that satisfies the provided testing function. Otherwise none is returned.
		def find(predicate def (value T) bool, start int = 0) ?T {
			let l = len()
			for let i = start; i < l; i++ {
				let v = self[i]
				if predicate(v) {
					return v
				}
			}
			return none
		}

		// Executes a user-supplied "reducer" callback function on each element of the array, passing in the return value from the calculation on the preceding element.
		def reduce<V>(predicate def (value T, accumulator V) T[], accumulator V) V {
			return new ()
		}

		// Returns the element at the specified index.
		def at(index int) ?T {
			// intrinsic: lowered by the compiler/runtime (`at(i)`)
		}

		// Sorts the values in the array in place using the given compare function.
		def sort(less def (i, j T) bool) T[] {
			let n = len()
			for let i = 1; i < n; i++ {
				for let j = i; j > 0 && less(self[j], self[j - 1]); j-- {
					self[j], self[j - 1] = self[j - 1], self[j]
				}
			}

			return self
		}

		// Sorts the array in place with `less`, which returns -1 when its first argument
		// sorts before its second. The sort is stable. Returns the array.
		def sort(less def (i, j T) int) T[] {
			let n = len()
			for let i = 1; i < n; i++ {
				for let j = i; j > 0 && less(self[j], self[j - 1]) == -1; j-- {
					self[j], self[j - 1] = self[j - 1], self[j]
				}
			}

			return self
		}

		// Returns a new string by concatenating all of the elements in an array, separated by commas or a specified separator string.
		def join(separator string) string {
			let tmp = ""
			for let i = 0; i < len(); i++ {
				if i > 0 {
					tmp += separator
				}
				match T {
					case Stringer:
						tmp += self[i].str()
					case string:
						tmp += self[i]
					default:
						tmp += sprint(self[i])
				}
			}
			return tmp
		}

		// Returns a new array instance containing all the values from the original array.
		def clone() T[] {
			// intrinsic: lowered by the compiler/runtime (`clone()`)
		}

		// Copies elements into `to`, as many as the shorter of the two holds, and returns
		// that count.
		def copy(to T[]) int {
			match T {
				case byte:
					use std.mem

					// Byte arrays can use a runtime-backed memmove for fast copying.
					return mem.copy(to, self)
				default:
					let src_len = len()
					let dest_len = to.len()

					let count = src_len
					count = dest_len when dest_len < count

					for let i = 0; i < count; i++ {
						to[i] = self[i]
					}

					return count
			}
		}

		// Sets the element at a specified index to a new value.
		def set(index int, value T) T[] {
			// intrinsic: lowered by the compiler/runtime (`set(i, v)` / indexing assignment)
		}

		// Whether the array has no elements.
		def isEmpty() bool {
			return len() == 0
		}

		// Whether the array has at least one element.
		def isNotEmpty() bool {
			return !isEmpty()
		}

		// Returns a string representation of the array.
		def str() string {
			return "[" + join(", ") + "]"
		}

		// Checks if this array is equal to another array.
		def equals(other T[]) bool {
			if len() != other.len() {
				return false
			}
			for let i = 0; i < len(); i++ {
				if self[i] != other[i] {
					return false
				}
			}
			return true
		}

		// Infix operator to push an element to the end of the array.
		infix def + (elem T) T[] {
			return clone().push(elem)
		}

		// Infix operator to concatenate two arrays.
		infix def + (other T[]) T[] {
			return clone().concat(other)
		}

		// Infix operator to remove all elements found in the `other` array from the array
		infix def - (other T[]) T[] {
			let tmp T[]
			for let (_, val) in self {
				if !other.includes(val) {
					tmp.push(val)
				}
			}
			return tmp
		}

		// Infix operator to remove the first occurrence of `elem` from the array.
		infix def - (elem T) T[] {
			// An operator yields a new value: `remove` works in place, so the
			// clone is what keeps `x - 4` from emptying `x`. The not-found path
			// must return that same clone rather than `self`, or the operator
			// would sometimes alias its own operand.
			let res = clone()
			if let idx = res.indexOf(elem); idx > -1 {
				res.remove(idx)
			}
			return res
		}

		// The elements found in exactly one of the two arrays.
		infix def ^ (other T[]) T[] {
			let res T[]
			for let (_, val) in self {
				if !other.includes(val) {
					res.push(val)
				}
			}
			for let (_, val) in other {
				if indexOf(val) == -1 {
					res.push(val)
				}
			}
			return res
		}

		// Infix operator to get the intersection of two arrays.
		infix def & (other T[]) T[] {
			return intersect(other)
		}

		// Infix operator to get the union of two arrays.
		infix def | (other T[]) T[] {
			return unions(other)
		}
	}
}
