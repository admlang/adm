partial module prelude.tests {
	use std.testing

	check "Arrays" {
		@test()
		def sortOrdersLargeArraysStably() !none {
			let values int[]
			let seed = uint32(7)
			for let i = 0; i < 3000; i++ {
				seed = seed * uint32(1664525) + uint32(1013904223)
				values.push(int(seed >> 20))
			}
			values.sort(def (a int, b int) bool {
				return a < b
			})
			for let i = 1; i < values.len(); i++ {
				assert values[i - 1] <= values[i]
			}
			// Equal keys keep their order: key = i % 7, payload = i.
			let pairs int[]
			for let i = 0; i < 1000; i++ {
				pairs.push(i)
			}
			pairs.sort(def (a int, b int) bool {
				return a % 7 < b % 7
			})
			for let i = 1; i < pairs.len(); i++ {
				let a = pairs[i - 1]
				let b = pairs[i]
				assert a % 7 < b % 7 || (a % 7 == b % 7 && a < b)
			}
			let words = ["pear", "fig", "apple", "kiwi", "date"]
			words.sort(def (a string, b string) int {
				return a < b ?? (-1, 1)
			})
			assert words.join(",") == "apple,date,fig,kiwi,pear"
			let few = [3, 1, 2]
			few.sort(def (a int, b int) bool {
				return a < b
			})
			assert few[0] == 1 && few[2] == 3
			let nothing int[]
			nothing.sort(def (a int, b int) bool {
				return a < b
			})
			assert nothing.len() == 0
		}

		@test()
		def byteArraysAppendCharactersAsUTF8() !none {
			let out byte[]
			out.append('a').append('\u00E9').append('\u20AC').append('\U0001F600')
			assert out.equals(byte[0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80])
			let more = out + 'z'
			assert more.len() == out.len() + 1
			assert string(more) == "a\u00E9\u20AC\U0001F600z"
		}

		@test()
		def byteArraysDecodeUTF16() !none {
			use std.bytes::(Endian)

			let text = "h\u00E9\U0001F600"
			assert text.utf16(Endian.Big).equals(byte[0x00, 0x68, 0x00, 0xE9, 0xD8, 0x3D, 0xDE, 0x00])
			assert text.utf16(Endian.Little).utf16(Endian.Little) == text
			assert text.utf16(Endian.Big).utf16(Endian.Big) == text
			// A byte order mark wins over the argument and is dropped.
			assert byte[0xFF, 0xFE, 0x68, 0x00].utf16(Endian.Big) == "h"
			// An unpaired surrogate becomes U+FFFD; an odd last byte is ignored.
			assert byte[0xD8, 0x3D, 0x00, 0x68, 0x00].utf16(Endian.Big) == "\uFFFDh"
		}

		@test()
		def arraysSplitIntoChunks() !none {
			let x = [1, 2, 3, 4, 5]
			assert x.chunk(2).str() == [[1, 2], [3, 4], [5]].str()
			assert x.chunk(5).str() == [[1, 2, 3, 4, 5]].str()
			assert x.chunk(9).str() == [[1, 2, 3, 4, 5]].str()
			assert x.chunk(0).len() == 0
			let blank int[]
			assert blank.chunk(3).len() == 0
			// Chunks are copies.
			let parts = x.chunk(2)
			parts[0][0] = 42
			assert x[0] == 1
		}

		@test()
		def TestInfixOperators() {
			let x = [1, 2, 3, 4, 5]
			let y = [4, 5, 6, 7, 8]

			let a = x + y // concat
			assert a.str() == [1, 2, 3, 4, 5, 4, 5, 6, 7, 8].str()

			let a1 = x + 42 // concat
			assert a1.str() == [1, 2, 3, 4, 5, 42].str()

			let b = x - y
			assert b.str() == [1, 2, 3].str()

			let b1 = x - 4
			assert b1.str() == [1, 2, 3, 5].str()

			let c = x | y
			assert c.str() == [1, 2, 3, 4, 5, 6, 7, 8].str()

			let d = x & y
			assert d.str() == [4, 5].str()

			let e = x ^ y
			assert e.str() == [1, 2, 3, 6, 7, 8].str()

			let w = [1, 3]
			let z = [1, 3]

			assert w != z
			assert w.equals(z)

			x[3:10] = 5
		}

		@test()
		def reduceFoldsInOrder() !none {
			let values = [1, 2, 3, 4]
			assert values.reduce((sum int, v int) => sum + v, 0) == 10
			// Untyped parameters take the accumulator type from the starting value.
			assert values.reduce((sum, v) => sum + v, 0) == 10
			assert values.reduce((text, v) => text + v.str(), "") == "1234"
			// The accumulator has its own type, and elements arrive first to last.
			assert values.reduce((text string, v int) => text + v.str(), "n") == "n1234"
			assert values.reduce((total float, v int) => total + float(v) / 2.0, 0.5) == 5.5
			let blank int[]
			assert blank.reduce((sum int, v int) => sum + v, 7) == 7
			let words = ["a", "bb", "ccc"]
			assert words.reduce((longest int, w string) => w.len() > longest ?? (w.len(), longest), 0) == 3
			// Without a starting value the first element is the accumulator.
			let largest = values.reduce((largest int, v int) => v > largest ?? (v, largest))
			assert largest is int && largest == 4
			let joined = words.reduce((all string, w string) => all + "-" + w)
			assert joined is string && joined == "a-bb-ccc"
			let single = [9].reduce((sum int, v int) => sum + v)
			assert single is int && single == 9
			assert blank.reduce((sum int, v int) => sum + v) is none
		}
	}
}
