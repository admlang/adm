partial module prelude.tests {
	use std.testing

	interface Ranked {
		def order() int
	}

	type Rank {
		n int

		def new(n int) {
			self.n = n
		}

		def order() int {
			return n
		}
	}

	check "Arrays" {
		// A spread among other arguments of push adds the array's elements
		// in its place, in the order written.
		@test()
		def pushTakesASpreadAmongValues() !none {
			let mark = "AB".bytes()
			let out byte[]
			out.push(...mark, 0x0D, 0x0A)
			assert out.equals(byte[0x41, 0x42, 0x0D, 0x0A])
			out.push(0x01, ...mark)
			assert out.equals(byte[0x41, 0x42, 0x0D, 0x0A, 0x01, 0x41, 0x42])
			let words string[]
			let more = string["b", "c"]
			words.push("a", ...more, "d")
			assert words.join("") == "abcd"
			// The array pushed onto may be the one spread.
			words.push(...words, "e")
			assert words.join("") == "abcdabcde"
		}

		// A char[] joins in one allocation, encoding each character as
		// UTF-8; slices and separators read as for any other array.
		@test()
		def joinEncodesChars() !none {
			let text = "héllo 😀 ok"
			let cs char[]
			for let (_, c) in text {
				cs.push(c)
			}
			assert cs.join("") == text
			assert cs[1:4].join("-") == "é-l-l"
			assert cs[6:7].join(", ") == "😀"
			assert cs[0:0].join(",") == ""
			let lone char[] = ['x']
			assert lone.join("::") == "x"
		}

		@test()
		def sortOrdersLargeArraysStably() !none {
			let values int[]
			let seed = uint32(7)
			for let i = 0; i < 3000; i++ {
				seed = seed * uint32(1664525) + uint32(1013904223)
				values.push(int(seed >> 20))
			}
			values.sort(def (a int, b int) bool {
				return a < b
			})
			for let i = 1; i < values.len(); i++ {
				assert values[i - 1] <= values[i]
			}
			// Equal keys keep their order: key = i % 7, payload = i.
			let pairs int[]
			for let i = 0; i < 1000; i++ {
				pairs.push(i)
			}
			pairs.sort(def (a int, b int) bool {
				return a % 7 < b % 7
			})
			for let i = 1; i < pairs.len(); i++ {
				let a = pairs[i - 1]
				let b = pairs[i]
				assert a % 7 < b % 7 || (a % 7 == b % 7 && a < b)
			}
			let words = ["pear", "fig", "apple", "kiwi", "date"]
			words.sort(def (a string, b string) int {
				return a < b ?? (-1, 1)
			})
			assert words.join(",") == "apple,date,fig,kiwi,pear"
			let few = [3, 1, 2]
			few.sort(def (a int, b int) bool {
				return a < b
			})
			assert few[0] == 1 && few[2] == 3
			let nothing int[]
			nothing.sort(def (a int, b int) bool {
				return a < b
			})
			assert nothing.len() == 0
		}

		@test()
		def byteArraysAppendCharactersAsUTF8() !none {
			let out byte[]
			out.append('a').append('\u00E9').append('\u20AC').append('\U0001F600')
			assert out.equals(byte[0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80])
			let more = out + 'z'
			assert more.len() == out.len() + 1
			assert string(more) == "a\u00E9\u20AC\U0001F600z"
		}

		@test()
		def byteArraysFindByteSequences() !none {
			let data = "abcabcabd".bytes()
			let blank byte[]
			assert data.indexOf("abc".bytes()) == 0
			assert data.indexOf("abc".bytes(), 1) == 3
			assert data.indexOf("abd".bytes()) == 6
			assert data.indexOf("abe".bytes()) == -1
			assert data.indexOf("bd".bytes(), -2) == 7
			assert data.indexOf(blank, 4) == 4
			assert data.indexOf(blank, 10) == -1
			assert data.lastIndexOf("abc".bytes()) == 3
			assert data.lastIndexOf("abc".bytes(), 5) == 0
			assert data.lastIndexOf("abc".bytes(), 6) == 3
			assert data.lastIndexOf("abc".bytes(), -1) == 3
			assert data.lastIndexOf("abc".bytes(), 2) == -1
			assert data.lastIndexOf("d".bytes()) == 8
			assert data.lastIndexOf("zz".bytes()) == -1
			assert data.lastIndexOf(blank) == 9
			assert blank.indexOf("a".bytes()) == -1
			assert blank.lastIndexOf("a".bytes()) == -1
			// A repetitive haystack with a near-miss everywhere.
			let zeros byte[]
			for let i = 0; i < 4096; i++ {
				zeros.push(byte(0))
			}
			zeros.push(byte(1))
			let tail = byte[0, 0, 0, 1]
			assert zeros.indexOf(tail) == 4093
			assert zeros.lastIndexOf(tail) == 4093
			assert zeros.lastIndexOf(tail, 4096) == -1
			// The element search is still there.
			assert data.indexOf(byte(0x64)) == 8
		}

		@test()
		def byteArraysDecodeUTF16() !none {
			use std.bytes::(Endian)

			let text = "h\u00E9\U0001F600"
			assert text.utf16(Endian.Big).equals(byte[0x00, 0x68, 0x00, 0xE9, 0xD8, 0x3D, 0xDE, 0x00])
			assert text.utf16(Endian.Little).utf16(Endian.Little) == text
			assert text.utf16(Endian.Big).utf16(Endian.Big) == text
			// A byte order mark wins over the argument and is dropped.
			assert byte[0xFF, 0xFE, 0x68, 0x00].utf16(Endian.Big) == "h"
			// An unpaired surrogate becomes U+FFFD; an odd last byte is ignored.
			assert byte[0xD8, 0x3D, 0x00, 0x68, 0x00].utf16(Endian.Big) == "\uFFFDh"
		}

		@test()
		def arraysSplitIntoChunks() !none {
			let x = [1, 2, 3, 4, 5]
			assert x.chunk(2).str() == [[1, 2], [3, 4], [5]].str()
			assert x.chunk(5).str() == [[1, 2, 3, 4, 5]].str()
			assert x.chunk(9).str() == [[1, 2, 3, 4, 5]].str()
			assert x.chunk(0).len() == 0
			let blank int[]
			assert blank.chunk(3).len() == 0
			// Chunks are copies.
			let parts = x.chunk(2)
			parts[0][0] = 42
			assert x[0] == 1
		}

		@test()
		def TestInfixOperators() {
			let x = [1, 2, 3, 4, 5]
			let y = [4, 5, 6, 7, 8]

			let a = x + y // concat
			assert a.str() == [1, 2, 3, 4, 5, 4, 5, 6, 7, 8].str()

			let a1 = x + 42 // concat
			assert a1.str() == [1, 2, 3, 4, 5, 42].str()

			let b = x - y
			assert b.str() == [1, 2, 3].str()

			let b1 = x - 4
			assert b1.str() == [1, 2, 3, 5].str()

			let c = x | y
			assert c.str() == [1, 2, 3, 4, 5, 6, 7, 8].str()

			let d = x & y
			assert d.str() == [4, 5].str()

			let e = x ^ y
			assert e.str() == [1, 2, 3, 6, 7, 8].str()

			let w = [1, 3]
			let z = [1, 3]

			assert w != z
			assert w.equals(z)

			x[3:10] = 5
		}

		@test()
		def reduceFoldsInOrder() !none {
			let values = [1, 2, 3, 4]
			assert values.reduce((sum int, v int) => sum + v, 0) == 10
			// Untyped parameters take the accumulator type from the starting value.
			assert values.reduce((sum, v) => sum + v, 0) == 10
			assert values.reduce((text, v) => text + v.str(), "") == "1234"
			// The accumulator has its own type, and elements arrive first to last.
			assert values.reduce((text string, v int) => text + v.str(), "n") == "n1234"
			assert values.reduce((total float, v int) => total + float(v) / 2.0, 0.5) == 5.5
			let blank int[]
			assert blank.reduce((sum int, v int) => sum + v, 7) == 7
			let words = ["a", "bb", "ccc"]
			assert words.reduce((longest int, w string) => w.len() > longest ?? (w.len(), longest), 0) == 3
			// Without a starting value the first element is the accumulator.
			let largest = values.reduce((largest int, v int) => v > largest ?? (v, largest))
			assert largest is int && largest == 4
			let joined = words.reduce((all string, w string) => all + "-" + w)
			assert joined is string && joined == "a-bb-ccc"
			let single = [9].reduce((sum int, v int) => sum + v)
			assert single is int && single == 9
			assert blank.reduce((sum int, v int) => sum + v) is none
		}

		// A sort over interface values: the comparator sees the values, and the
		// sort's own arithmetic stays on ints (a generic body lowered for an
		// interface once packed `min`'s argument into it).
		@test()
		def sortsInterfaceValues() {
			let all Ranked[] = []
			for let i = 40; i > 0; i-- {
				all.push(new Rank(i))
			}
			all.sort((a, b) => a.order() < b.order())
			assert all.len() == 40 && all[0].order() == 1 && all[39].order() == 40
			all.sort((a, b) => b.order() - a.order())
			assert all[0].order() == 40 && all[39].order() == 1
		}

		// Byte arrays compare whole through the runtime: equal bytes, a
		// difference at every position of a vector, a prefix, a length apart.
		@test()
		def byteArraysCompareWhole() {
			let base = "0123456789".repeat(10).bytes()
			let same = "0123456789".repeat(10).bytes()
			assert base.equals(same) && base.mismatch(same) == -1 && same.mismatch(base) == -1
			assert byte[].equals(byte[]) && byte[].mismatch(byte[]) == -1
			for let at = 0; at < 100; at++ {
				let other = "0123456789".repeat(10).bytes()
				other[at] = byte('x')
				assert !base.equals(other) && base.mismatch(other) == at && other.mismatch(base) == at
			}
			let shorter = base[0:37]
			assert !base.equals(shorter) && base.mismatch(shorter) == 37 && shorter.mismatch(base) == 37
			let window = base[10:60]
			let copy = base[10:60].clone()
			assert window.equals(copy) && window.mismatch(copy) == -1
			copy[49] = 0
			assert window.mismatch(copy) == 49
		}

		// Well-formed UTF-8 as the standard defines it, on inputs shorter and
		// longer than a vector, with the ill-formed byte at the end too.
		@test()
		def bytesAreUTF8() {
			assert byte[].isUTF8() && "plain".bytes().isUTF8() && "héllo wörld ✓ 🎉".bytes().isUTF8()
			assert !byte[0xC0, 0x80].isUTF8()
			assert !byte[0xE0, 0x80, 0x80].isUTF8()
			assert !byte[0xED, 0xA0, 0x80].isUTF8()
			assert !byte[0xF4, 0x90, 0x80, 0x80].isUTF8()
			assert !byte[0xF5, 0x80, 0x80, 0x80].isUTF8()
			assert !byte[0x80].isUTF8() && !byte[0xC3].isUTF8() && !byte[0x61, 0xC3].isUTF8()
			assert byte[0xC3, 0xA9].isUTF8() && byte[0xE2, 0x82, 0xAC].isUTF8() && byte[0xF0, 0x9F, 0x8E, 0x89].isUTF8()
			let text = "aé".repeat(50).bytes()
			assert text.len() == 150 && text.isUTF8()
			let cut = text[0:149]
			assert !cut.isUTF8()
			text.push(0xFF)
			assert !text.isUTF8()
			let ascii = "x".repeat(200).bytes()
			assert ascii.isUTF8()
			ascii[199] = 0xC3
			assert !ascii.isUTF8()
		}
	}
}
