partial module builtin {
	use std.testing

	check "Arrays" {
		@test()
		def TestInfixOperators() {
			let x = [1, 2, 3, 4, 5]
			let y = [4, 5, 6, 7, 8]

			let a = x + y // concat
			assert a.str() == [1, 2, 3, 4, 5, 4, 5, 6, 7, 8].str()

			let a1 = x + 42 // concat
			assert a1.str() == [1, 2, 3, 4, 5, 42].str()

			let b = x - y
			assert b.str() == [1, 2, 3].str()

			let b1 = x - 4
			assert b1.str() == [1, 2, 3, 5].str()

			let c = x | y
			assert c.str() == [1, 2, 3, 4, 5, 6, 7, 8].str()

			let d = x & y
			assert d.str() == [4, 5].str()

			let e = x ^ y
			assert e.str() == [1, 2, 3, 6, 7, 8].str()

			let w = [1, 3]
			let z = [1, 3]

			assert w != z
			assert w.equals(z)

			x[3:10] = 5
		}
	}
}
