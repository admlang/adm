partial module builtin {
	// Whether the task running this code has been cancelled: its future was
	// cancelled or timed out, or lost an `a || b` race. A cancelled task is not
	// stopped. Its sleeps, awaits and socket waits end early, and code that
	// computes without waiting asks here and returns when the answer is true:
	//
	//     for let file in files {
	//         return count when canceled()
	//         count += index(file)
	//     }
	//
	// False outside a task started by a future, such as the application's `new`.
	def canceled() bool {
		return __task_canceled()
	}

	// AsyncScope handles a group of futures as one: wait for all of them,
	// cancel them together, give them one deadline. `async<group> call()`
	// starts a call as a member; `future.scope(group)` adds a future that
	// already exists. A member stays an ordinary future and its result is
	// read from it after the wait.
	//
	//     let group = new AsyncScope()
	//     let profile = async<group> fetchProfile()
	//     let teams = async<group> fetchTeams()
	//     try await group
	//     show(await profile, await teams)
	//
	// A member that fails cancels the others, unless the scope was made with
	// `failFast=false`. A scope that is dropped cancels the members that
	// still run. Tasks a member starts are not members unless they join.
	type AsyncScope {
		// The runtime object; also read by the compiler for `future.scope(group)`
		// and `await group`.
		handle uint

		def new(failFast bool = true) {
			handle = __scope_make(failFast)
		}

		// Returns once no member is running; `await group` is the same call.
		// Fails with the error of the first member that failed, or with code
		// `canceled` or `timeout` when `cancel` or the deadline ended members
		// that were still running. Members that join while it waits are
		// waited for too.
		def wait() !none {
			return __scope_wait(handle)
		}

		// Cancels every member still running, and members that join later.
		// `reason` becomes the message of the error `wait` and the errorable
		// members yield.
		def cancel(reason string = "") AsyncScope {
			__scope_cancel(handle, reason)
			return self
		}

		// Cancels, as timed out, the members still running once the
		// duration has passed.
		def timeout(val duration) AsyncScope {
			__scope_timeout(handle, val)
			return self
		}

		// Lets at most `count` members run at once (0: no limit). Members
		// started with `async<group> call()` beyond it wait and start, in the
		// order they were written, as others end. A future added with
		// `scope(group)` is already running and only counts.
		def limit(count int) AsyncScope {
			__scope_limit(handle, count)
			return self
		}

		// Whether any member is still running.
		def running() bool {
			return __scope_running(handle)
		}

		// Whether every member has ended; true for a scope without members.
		def done() bool {
			return !__scope_running(handle)
		}

		// The number of futures that joined.
		def len() int {
			return __scope_len(handle)
		}

		// The errors of the members that failed, in the order they ended.
		// Members the scope cancelled are not listed.
		def errors() error[] {
			return __scope_errors(handle)
		}

		def dispose() {
			__scope_drop(handle)
		}
	}
}
