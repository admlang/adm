partial module builtin {
	// Whether the task running this code has been cancelled: its future was
	// cancelled or timed out, or lost an `a || b` race. A cancelled task is not
	// stopped. Its sleeps, awaits and socket waits end early, and code that
	// computes without waiting asks here and returns when the answer is true:
	//
	//     for let file in files {
	//         return count when canceled()
	//         count += index(file)
	//     }
	//
	// False outside a task started by a future, such as the application's `new`.
	def canceled() bool {
		return __task_canceled()
	}
}
