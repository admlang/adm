partial module builtin {
	use std.testing

	// A box of items, replaced whole by one task while others read it.
	type AtomicBox {
		items string[]

		def new(items string[]) {
			for let item in items {
				self.items.push(item)
			}
		}

		def count() int {
			return items.len()
		}
	}

	// Holds the box through an `atomic` field: a store and a read on two tasks
	// never hand the reader a freed box.
	type AtomicHolder {
		atomic box AtomicBox = new AtomicBox(["a", "b"])
	}

	check "Atomic fields" {
		async def replaceBoxes(held AtomicHolder, rounds int) {
			for let i = 0; i < rounds; i++ {
				held.box = new AtomicBox(["x", "y", "z"])
			}
		}

		async def countBoxes(held AtomicHolder, rounds int) int {
			let total = 0
			for let i = 0; i < rounds; i++ {
				let box = held.box
				total += box.count()
			}
			return total
		}

		// A read of an `atomic` object field retains the object under the field's
		// lock, so a store on another task, which releases the old object under the
		// same lock, cannot free it first; every read sees a whole box.
		@test()
		def atomicFieldReadsSurviveStores() {
			let held = new AtomicHolder()
			let writer = replaceBoxes(held, 2000)
			let first = countBoxes(held, 20000)
			let second = countBoxes(held, 20000)
			await writer
			let a = await first
			let b = await second
			assert a >= 40000 && a <= 60000 && b >= 40000 && b <= 60000
			assert held.box.count() == 3
		}
	}
}
