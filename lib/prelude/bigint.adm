partial module builtin {
	// Arbitrary-precision intrinsics (runtime-backed). Applications reach them
	// through the BigInt methods below.
	internal def __bigint_shl(val bigint, bits int) bigint {
		// intrinsic
	}

	internal def __bigint_shr(val bigint, bits int) bigint {
		// intrinsic
	}

	internal def __bigint_and(a, b bigint) bigint {
		// intrinsic
	}

	internal def __bigint_or(a, b bigint) bigint {
		// intrinsic
	}

	internal def __bigint_xor(a, b bigint) bigint {
		// intrinsic
	}

	internal def __bigint_not(val bigint) bigint {
		// intrinsic
	}

	internal def __bigint_abs(val bigint) bigint {
		// intrinsic
	}

	internal def __bigint_sign(val bigint) int {
		// intrinsic
	}

	internal def __bigint_bit_len(val bigint) int {
		// intrinsic
	}

	internal def __bigint_bit(val bigint, index int) bool {
		// intrinsic
	}

	internal def __bigint_mod(val, modulus bigint) bigint {
		// intrinsic
	}

	internal def __bigint_modpow(base, exponent, modulus bigint) bigint {
		// intrinsic
	}

	internal def __bigint_modinverse(val, modulus bigint) ?bigint {
		// intrinsic
	}

	internal def __bigint_gcd(a, b bigint) bigint {
		// intrinsic
	}

	internal def __bigint_is_probable_prime(val bigint, rounds int) bool {
		// intrinsic
	}

	internal def __bigint_bytes(val bigint, size int) !byte[] {
		// intrinsic
	}

	internal def __bigint_from_bytes(data byte[]) bigint {
		// intrinsic
	}

	internal def __bigint_to_radix(val bigint, radix int) string {
		// intrinsic
	}

	internal def __bigint_parse(text string, radix int) !bigint {
		// intrinsic
	}

	// parseBigInt reads an integer of any size from text in the given radix
	// (2 to 36): an optional sign, then digits, `_` between digits ignored.
	// Fails when the text is empty, holds a digit outside the radix, or the
	// radix is out of range.
	def parseBigInt(val string, radix int = 10) !bigint {
		return __bigint_parse(val, radix)
	}

	// parseBigInt reads a big-endian unsigned magnitude from bytes, the form
	// keys and signatures use; an empty array is zero.
	def parseBigInt(val byte[]) bigint {
		return __bigint_from_bytes(val)
	}

	// bigint is an integer of any size. Bitwise operators act on the two's
	// complement of an infinitely wide value, so `-1 & x` is `x` and
	// `x.not()` is `-x - 1`, as in Go's math/big.
	@builtin(primitive = "bigint")
	type bigint {
		// Shifts left by `bits` places; a negative count shifts right.
		infix def << (bits int) bigint {
			return __bigint_shl(self, bits)
		}

		// Shifts right by `bits` places, rounding toward minus infinity, so a
		// negative value never reaches zero; a negative count shifts left.
		infix def >> (bits int) bigint {
			return __bigint_shr(self, bits)
		}

		infix def & (other bigint) bigint {
			return __bigint_and(self, other)
		}

		infix def | (other bigint) bigint {
			return __bigint_or(self, other)
		}

		infix def ^ (other bigint) bigint {
			return __bigint_xor(self, other)
		}

		// not is the bitwise complement, `-value - 1`.
		def not() bigint {
			return __bigint_not(self)
		}

		def abs() bigint {
			return __bigint_abs(self)
		}

		// sign is -1, 0 or 1.
		def sign() int {
			return __bigint_sign(self)
		}

		def isZero() bool {
			return __bigint_sign(self) == 0
		}

		// bitLen is the number of bits in the magnitude; zero has none.
		def bitLen() int {
			return __bigint_bit_len(self)
		}

		// bit reads bit `index` of the two's complement value, bit 0 being the
		// least significant.
		def bit(index int) bool {
			return __bigint_bit(self, index)
		}

		// mod is the Euclidean remainder, always in `[0, |modulus|)`, unlike
		// `%` which keeps the sign of the dividend.
		def mod(modulus bigint) bigint {
			return __bigint_mod(self, modulus)
		}

		// modPow is `value ** exponent % modulus` reduced at every step, so a
		// 2048-bit exponent costs a few thousand multiplications. The
		// exponent must not be negative.
		def modPow(exponent, modulus bigint) bigint {
			return __bigint_modpow(self, exponent, modulus)
		}

		// modInverse is the `x` with `value * x mod modulus == 1`, or none
		// when the value and the modulus are not coprime.
		def modInverse(modulus bigint) ?bigint {
			return __bigint_modinverse(self, modulus)
		}

		def gcd(other bigint) bigint {
			return __bigint_gcd(self, other)
		}

		// isProbablePrime runs Miller-Rabin with `rounds` random bases after
		// trial division by the small primes; a composite passes with
		// probability at most 4 ** -rounds.
		def isProbablePrime(rounds int = 20) bool {
			return __bigint_is_probable_prime(self, rounds)
		}

		// bytes is the magnitude as big-endian bytes in the shortest form;
		// zero gives an empty array.
		def bytes() byte[] {
			return __bigint_bytes(self, 0) onerror recover []
		}

		// bytes is the magnitude as big-endian bytes padded with leading
		// zeros to `size`. Fails when the magnitude needs more bytes.
		def bytes(size int) !byte[] {
			return __bigint_bytes(self, size)
		}

		// toRadix renders the value in a radix from 2 to 36, lowercase
		// digits, `-` first when negative.
		def toRadix(radix int) string {
			return __bigint_to_radix(self, radix)
		}

		def hex() string {
			return __bigint_to_radix(self, 16)
		}
	}
}
