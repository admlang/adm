partial module prelude.tests {
	use std.testing

	check "BigInt" {
		@test()
		def shifts() {
			let one bigint = 1
			assert (one << 100).toRadix(10) == "1267650600228229401496703205376"
			assert ((one << 100) >> 99) == 2
			assert (bigint(-1) >> 5) == -1
			assert (bigint(-8) >> 1) == -4
			assert (one << -3) == 0
		}

		@test()
		def bitwise() {
			assert (bigint(12) & 10) == 8
			assert (bigint(12) | 10) == 14
			assert (bigint(12) ^ 10) == 6
			assert (bigint(-1) & 255) == 255
			assert (bigint(-12) & 10) == 0
			assert (bigint(-12) | 10) == -2
			assert (bigint(-12) ^ 10) == -2
			assert bigint(5).not() == -6
			assert bigint(-1).not() == 0
		}

		@test()
		def modular() !none {
			let one bigint = 1
			let mersenne = (one << 127) - 1
			assert bigint(4).modPow(13, 497) == 445
			assert bigint(2).modPow(mersenne - 1, mersenne) == 1
			assert bigint(-7).mod(3) == 2
			assert bigint(-7) % 3 == -1
			assert bigint(48).gcd(18) == 6
			let inv = bigint(3).modInverse(11)
			fail "3 has an inverse mod 11" when inv is none
			assert inv == 4
			assert bigint(6).modInverse(9) is none
			return none
		}

		@test()
		def bits() {
			let one bigint = 1
			assert bigint(0).bitLen() == 0
			assert bigint(255).bitLen() == 8
			assert bigint(256).bitLen() == 9
			assert ((one << 127) - 1).bitLen() == 127
			assert bigint(5).bit(0)
			assert !bigint(5).bit(1)
			assert bigint(-1).bit(100)
			assert bigint(-3).sign() == -1
			assert bigint(0).sign() == 0
			assert bigint(-3).abs() == 3
			assert bigint(0).isZero()
		}

		@test()
		def bytesRoundTrip() !none {
			assert bigint(0x1234).bytes().equals([byte(0x12), 0x34])
			assert bigint(0).bytes().len() == 0
			assert (try bigint(0x1234).bytes(4)).equals([byte(0), 0, 0x12, 0x34])
			assert parseBigInt([byte(0x12), 0x34]) == 4660
			let key = try parseBigInt("fffffffffffffffffffffffffffffffeffffffffffffffff", 16)
			assert parseBigInt(key.bytes()) == key
			let failed = false
			bigint(0x12345).bytes(2) onerror (err error) {
				failed = err.message.contains("3 bytes")
				recover []
			}
			assert failed
			return none
		}

		@test()
		def textRoundTrip() !none {
			assert (try parseBigInt("ff", 16)) == 255
			assert (try parseBigInt("-1_000")) == -1000
			assert (try parseBigInt("zz", 36)) == 1295
			assert bigint(255).hex() == "ff"
			assert bigint(-255).toRadix(2) == "-11111111"
			let one bigint = 1
			assert "{(one << 127) - 1}" == "170141183460469231731687303715884105727"
			let failed = false
			parseBigInt("12a") onerror (err error) {
				failed = err.message.contains("invalid digit")
				recover 0
			}
			assert failed
			return none
		}

		@test()
		def primes() {
			let one bigint = 1
			let mersenne = (one << 127) - 1
			assert mersenne.isProbablePrime()
			assert !(mersenne + 2).isProbablePrime()
			assert !bigint(561).isProbablePrime()
			assert bigint(97).isProbablePrime()
			assert bigint(2).isProbablePrime()
			assert !bigint(1).isProbablePrime()
			assert !bigint(-7).isProbablePrime()
		}
	}
}
