partial module builtin {
	enum ChanMode {
		FIFO = 0,
		LIFO = 1
	}

	@builtin(primitive = "channel")
	type channel<T> {
		closed bool {
			def get() bool {
				return value // returns true if the channels is closed
			}
		}

		def new(size int = 0, mode = ChanMode.FIFO) {
			// intrinsic
		}

		// returns the element from he channel without removing it
		atomic def peek() ?T {
			// intrinsic
		}

		// closes the channel, making it unreadable and unwritable
		def close() {
			// intrinsic
		}

		// returns number of elements in the channel
		def len() int {
			// intrinsic
		}

		// returns the maximum capacity of the channel
		def cap() int {
			// intrinsic
		}

		// clears all the elements in the channel
		def flush() {
			// intrinsic
		}

		def str() {
			// intrinsic
		}
	}
}
