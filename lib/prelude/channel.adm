partial module builtin {
	// ChanMode is the order a channel hands out its values: FIFO first in, first out;
	// LIFO last in, first out.
	enum ChanMode {
		FIFO = 0,
		LIFO = 1
	}

	// channel passes values of T between tasks. `size` values are buffered, 0 makes
	// every send wait for a receiver, and `mode` sets the order they come out in.
	@builtin(primitive = "channel")
	type channel<T> {
		closed bool {
			def get() bool {
				return value // returns true if the channels is closed
			}
		}

		def new(size int = 0, mode = ChanMode.FIFO) {
			// intrinsic
		}

		// returns the element from he channel without removing it
		atomic def peek() ?T {
			// intrinsic
		}

		// Sends `value` when that needs no waiting and returns whether it was sent: a
		// buffered channel must have room, a channel of size 0 a receiver waiting for
		// it. Never waits, and gives false on a closed channel. For a wake-up signal
		// several tasks may raise: `signal.offer(none)`. On a channel of size 0, true
		// means the value was left for a receiver that was waiting: when that receiver
		// goes first (a `select` that took another case, a cancelled task), the value
		// stays for the next one.
		def offer(value T) bool {
			// intrinsic
		}

		// closes the channel, making it unreadable and unwritable
		def close() {
			// intrinsic
		}

		// returns number of elements in the channel
		def len() int {
			// intrinsic
		}

		// returns the maximum capacity of the channel
		def cap() int {
			// intrinsic
		}

		// clears all the elements in the channel
		def flush() {
			// intrinsic
		}

		// The channel as text, for printing.
		def str() {
			// intrinsic
		}
	}
}
