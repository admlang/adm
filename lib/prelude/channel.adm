partial module builtin {
	// ChanMode is the order a channel hands out its values: FIFO first in, first out;
	// LIFO last in, first out.
	enum ChanMode {
		FIFO = 0,
		LIFO = 1
	}

	// channel passes values of T between tasks. `size` values are buffered, 0 makes
	// every send wait for a receiver, and `mode` sets the order they come out in.
	@builtin(primitive = "channel")
	type channel<T> {
		closed bool {
			def get() bool {
				return value // returns true if the channels is closed
			}
		}

		def new(size int = 0, mode = ChanMode.FIFO) {
			// intrinsic
		}

		// returns the element from he channel without removing it
		atomic def peek() ?T {
			// intrinsic
		}

		// closes the channel, making it unreadable and unwritable
		def close() {
			// intrinsic
		}

		// returns number of elements in the channel
		def len() int {
			// intrinsic
		}

		// returns the maximum capacity of the channel
		def cap() int {
			// intrinsic
		}

		// clears all the elements in the channel
		def flush() {
			// intrinsic
		}

		// The channel as text, for printing.
		def str() {
			// intrinsic
		}
	}
}
