partial module builtin {
	// char is one Unicode code point. The classifiers below cover ASCII, the
	// alphabet every wire format and config syntax is written in; text in
	// other scripts answers false to all of them except isASCII's negation.
	@builtin(primitive = "char")
	type char {
		// isDigit is true for `0` to `9`.
		def isDigit() bool {
			return self >= '0' && self <= '9'
		}

		// isLetter is true for `a` to `z` and `A` to `Z`.
		def isLetter() bool {
			return (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z')
		}

		// isAlphanumeric is true for an ASCII letter or digit.
		def isAlphanumeric() bool {
			return isLetter() || isDigit()
		}

		// isHexDigit is true for `0` to `9`, `a` to `f` and `A` to `F`.
		def isHexDigit() bool {
			return isDigit() || (self >= 'a' && self <= 'f') || (self >= 'A' && self <= 'F')
		}

		// isSpace is true for a space, tab, newline, carriage return, form
		// feed or vertical tab.
		def isSpace() bool {
			return self == ' ' || self == '\t' || self == '\n' || self == '\r' || self == '\u000c' || self == '\u000b'
		}

		def isUpper() bool {
			return self >= 'A' && self <= 'Z'
		}

		def isLower() bool {
			return self >= 'a' && self <= 'z'
		}

		// isASCII is true below U+0080.
		def isASCII() bool {
			return int(self) < 128
		}

		// digitValue is the value of the character as a digit in the radix
		// (2 to 36, letters in either case), -1 when it is not one.
		//
		// ```
		// 'f'.digitValue(16) == 15
		// 'z'.digitValue(36) == 35
		// '9'.digitValue(8) == -1
		// ```
		def digitValue(radix int = 10) int {
			let value = -1
			if isDigit() {
				value = int(self) - int('0')
			} else if isLower() {
				value = int(self) - int('a') + 10
			} else if isUpper() {
				value = int(self) - int('A') + 10
			}
			return -1 when value < 0 || value >= radix
			return value
		}

		// lower is the character in lower case when it is an ASCII letter,
		// itself otherwise.
		def lower() char {
			return char(int(self) + 32) when isUpper()
			return self
		}

		// upper is the character in upper case when it is an ASCII letter,
		// itself otherwise.
		def upper() char {
			return char(int(self) - 32) when isLower()
			return self
		}
	}
}
