partial module prelude.tests {
	use std.testing

	check "Chars" {
		@test()
		def classifies() {
			assert '7'.isDigit() && !'a'.isDigit()
			assert 'q'.isLetter() && 'Q'.isLetter() && !'1'.isLetter()
			assert 'q'.isAlphanumeric() && '1'.isAlphanumeric() && !'-'.isAlphanumeric()
			assert 'f'.isHexDigit() && 'F'.isHexDigit() && '9'.isHexDigit() && !'g'.isHexDigit()
			assert ' '.isSpace() && '\t'.isSpace() && '\n'.isSpace() && !'x'.isSpace()
			assert 'A'.isUpper() && !'a'.isUpper()
			assert 'a'.isLower() && !'A'.isLower()
			assert 'a'.isASCII() && !'é'.isASCII()
		}

		@test()
		def digitValues() {
			assert '7'.digitValue() == 7
			assert 'f'.digitValue(16) == 15
			assert 'F'.digitValue(16) == 15
			assert 'z'.digitValue(36) == 35
			assert '9'.digitValue(8) == -1
			assert 'g'.digitValue(16) == -1
			assert '-'.digitValue() == -1
		}

		@test()
		def cases() {
			assert 'a'.upper() == 'A'
			assert 'A'.lower() == 'a'
			assert '1'.upper() == '1'
		}
	}
}
