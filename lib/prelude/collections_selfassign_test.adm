partial module prelude.tests {
	use std.testing

	// A collection method mutates its receiver in place and returns that same
	// receiver, so the bare call is enough. Writing the result back to the same
	// variable must behave identically: that store must not release the handle
	// it is about to store.
	check "Collection self-assignment" {
		@test()
		def mapSetSelfAssign() {
			let m = map<string, int>{}
			m = m.set("a", 1)
			assert m.len() == 1
			assert m.hasKey("a")

			m = m.set("b", 2)
			assert m.len() == 2
			assert m.hasKey("b")
		}

		@test()
		def mapSetBare() {
			let m = map<string, int>{}
			m.set("a", 1)
			m.set("b", 2)
			assert m.len() == 2
		}

		@test()
		def mapDeleteSelfAssign() {
			let m = map<string, int>{}
			m["a"] = 1
			m["b"] = 2
			m = m.delete("a")
			assert m.len() == 1
			assert !m.hasKey("a")
		}

		@test()
		def arrayPushSelfAssign() {
			let a = [1, 2]
			a = a.push(3)
			assert a.len() == 3
			assert a[2] == 3
		}

		// A store inside a loop lands in the same iteration: the duplicate count
		// comes out right, not only the final size. Three or more repeats are
		// needed to show it.
		def dedupeCount(items string[]) int {
			let seen = map<string, bool>{}
			let dupes = 0
			for let (_, k) in items {
				if seen.hasKey(k) {
					dupes++
					continue
				}
				seen = seen.set(k, true)
			}
			return dupes
		}

		@test()
		def selfAssignInLoop() {
			assert dedupeCount(["a", "b", "a", "b", "c"]) == 2
			assert dedupeCount(["x", "x", "x"]) == 2
		}
	}
}
