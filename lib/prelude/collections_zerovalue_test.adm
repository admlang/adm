partial module builtin {
	use std.testing

	internal type ZeroBag {
		nums  int[]
		byKey map<string, int>

		def new() {}
	}

	internal def takesZeroArray(a int[]) int {
		return a.len()
	}

	check "Zero-value collections" {
		@test()
		def unsetLocalArrayReadsAsEmpty() !none {
			let a int[]
			assert a.len() == 0
			let total = 0
			for let (_, v) in a {
				total += v
			}
			assert total == 0
		}

		@test()
		def unsetLocalArrayGrowsOnFirstWrite() !none {
			let a int[]
			a.push(1)
			a.push(2)
			assert a.len() == 2
			assert a[0] == 1
		}

		@test()
		def unsetLocalMapReadsAsEmpty() !none {
			let m map<string, int>
			assert m.len() == 0
			assert m.get("absent") is none
			assert !m.hasKey("absent")
			let total = 0
			for let (_, v) in m {
				total += v
			}
			assert total == 0
		}

		@test()
		def unsetLocalMapGrowsOnFirstWrite() !none {
			let m map<string, int>
			m.set("a", 3)
			assert m.len() == 1
			assert m.hasKey("a")

			// Narrowing an optional and then comparing it used to abort the
			// compiler inside LLVMStructSetBody when compiled as part of
			// `builtin`: `error` resolved to its named struct by value, and its
			// `cause` field is `?error`, so the body was infinitely sized.
			let v = m.get("a")
			fail "expected the value just written" when v is none
			assert v == 3
		}

		// Fields matter most: a field has no initializer to run, so it starts as
		// a zero handle and stays one until first written.
		@test()
		def unsetFieldsReadAsEmpty() !none {
			let b = new ZeroBag()
			assert b.nums.len() == 0
			assert b.byKey.len() == 0
			assert b.byKey.get("absent") is none
		}

		@test()
		def unsetFieldsGrowOnFirstWrite() !none {
			let b = new ZeroBag()
			b.nums.push(5)
			b.byKey.set("k", 6)

			assert b.nums.len() == 1
			assert b.nums[0] == 5
			assert b.byKey.len() == 1
			assert b.byKey.hasKey("k")
		}

		// Passing one on, and the methods that build a new collection from it,
		// must cope with the zero handle too.
		@test()
		def unsetCollectionsSurviveBeingPassedAround() !none {
			let b = new ZeroBag()
			assert takesZeroArray(b.nums) == 0
			assert b.nums.clone().len() == 0
			assert b.nums.slice(0, 0).len() == 0
		}
	}
}
