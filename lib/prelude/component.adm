partial module builtin {
	use (
		std.reflection::(TypeMetaContext)
		std.math.geom::(Point, Rect, Size)
		std.ui::(Action, KeyEvent, Limit, PointerEvent, RenderContext, Viewport)
		std.ui.frames::(askFocus, askFrame, askRedraw, askRedrawPart, askReveal, follow, frameWorking, rebuildingAll, RedrawFrom, runsView, storeMarks, viewRunning)
		std.units::(Pixels)
	)

	// Marks the annotated type as a component's controller.
	meta def controller(ctx TypeMetaContext) {
		// intrinsic
	}

	// The base of every component. `ref`, `key` and `style` are reserved
	// arguments of a component call; a controller field with one of those
	// names is an error.
	@builtin(for = component)
	internal type Component<T: component> {
		// False: it and its descendants take no input and are in the
		// `disabled` state.
		@input
		enabled bool = true

		// What it is, for theme rules.
		@input
		role Role = Role.None

		// Text shown when the pointer rests on it or it has keyboard focus.
		@input
		tooltip string = ""

		// Runs when it is clicked: the primary button pressed and released over it, or
		// Space or Enter while it has the focus. Its own `clicked` runs first.
		@input
		onClick ?(def()) = none

		// Runs on the second click of a double click, in place of `onClick`.
		@input
		onDoubleClick ?(def()) = none

		// Runs when a press is held half a second without moving; the release that
		// follows clicks nothing.
		@input
		onLongPress ?(def()) = none

		// Can take the keyboard focus; none: when it takes clicks (`takesClicks`). Read
		// it as `takesFocus`.
		@input
		focusable ?bool = none

		// Reached with Tab; none: when it takes clicks and the focus. Read it as
		// `takesTab`.
		@input
		tabStop ?bool = none

		// Takes the focus when mounted.
		@input
		autofocus bool = false

		// While focused, keys reach it before shortcuts (a terminal).
		@input
		capturesKeys bool = false

		// What the call that makes it gives its style, `Button("Save", style = {...})`:
		// the function that sets the properties listed, and the two functions of the
		// states its `on` lists (as `Style<T>.onStates` and `onAny` are). The compiler
		// writes them and passes them by these names; the UI runtime applies them after
		// the component's own looks.
		@input
		_styleSet ?def(look style, owner component) = none

		@input
		_styleStates ?def(look style, owner component, held int, state def(string) bool) = none

		@input
		_styleAny ?def(held int, state def(string) bool) bool = none

		// The variants the call asks of its style, `style = {variant: [primary]}`.
		@input
		_styleVariant ?string[] = none

		// The mounted list the compiler fills; read it as `childNodes`.
		children component[]
		_parent  ?component
		view     view
		style    style

		// Set by the view runtime; read them as `hover`, `pressed`, `focused` and so on.
		isHover        bool
		isPressed      bool
		isFocused      bool
		isFocusWithin  bool
		isFocusVisible bool
		isDragging     bool
		isDropTarget   bool
		// An ancestor is not enabled.
		isBlocked      bool
		// It called `redraw()` since it was last drawn: what it draws counts as
		// changed even where it records the same calls (a picture changed in
		// place). Cleared by the view runtime.
		isRedrawn      bool
		// A bit per field it declares, in their order (the fields past the 63rd
		// share the last bit): its `@state` or `@input` field changed in place
		// (`counts[key] = 1`, `items.push(item)`) since its view last ran, which
		// gives the children that take what the field holds the same object again
		// as a change. The compiler sets the bits and the view's run clears them.
		_inPlace       int
		// What the UI runtime copied of it into its node may be out of date: one of the
		// fields it copies (`enabled`, `role`, `style`, `children`, `leaving`,
		// `provided`, the `_style` inputs, the states above) or a `@state` field took
		// another value since. Set by the compiler at such a store and by the methods
		// that change those fields in place (`stale`); cleared by the runtime when it
		// brings the node in step.
		isStale        bool
		// Its view is to run again in the next frame: set with `isStale`, by `redraw()`
		// and by the compiler at a store of one of its fields (`touched`); cleared once
		// its view ran (`rerunMarked`).
		needsBuild     bool
		// A component under it is stale: the frame goes down to it. Set on every
		// component above a stale one up to one that holds it already, so a component
		// with neither mark has none under it; cleared by the UI runtime as it passes.
		staleBelow     bool

		// What `1(em)` is for the component, in pixels, as of the last layout: the size
		// of its font, its own or the one it inherits. Set by the UI runtime.
		em float = 16.0

		// The window the tree was last laid out in: kept on the topmost component by
		// the UI runtime; read it as `viewport`.
		_viewport ?Viewport

		// True for a component declared `@scoped`. Set when it is built.
		isScoped bool

		// The children its view dropped whose style has an `exit`: out of `children`,
		// still mounted with what is under them, until `finishLeaving`. The place of
		// the view that dropped one keeps it and takes it back when it is reached again.
		leaving component[]

		// It is in its parent's `leaving`.
		isLeaving bool

		// `finishLeaving` let go of it: no view takes it back.
		hasLeft bool

		// The name the view that placed it gave it with `ref = name`; empty
		// without one. Set when it is built.
		refName string = ""

		// What `provide` gave it and those under it, one value per type.
		provided any[] = []

		// For a component written in the block of a call (`Card() { Leaf() }`), that
		// call's component, set when it is built: what it is under before
		// `children()` places it and gives it a parent.
		weak _heldIn ?component

		// The component whose view names it with `ref = name`, set when it is built: that
		// view reads it, so marking it marks that component too (`stale`).
		weak _refOf ?component

		// Its caller's view gave it code of its own to run or a place to write (a handler,
		// `onChange = pick`, a bound input), set when it is built: a drag it takes may change
		// what any view reads, so the UI runtime runs every view after such a move.
		_handed bool

		// The scope `tasks` returns, made when it is first read; read it as `tasks`.
		_tasks ?AsyncScope

		// The UI runtime cancelled `_tasks` when the component left the tree: the
		// next attach starts a new scope.
		_tasksEnded bool

		// Everything mounted under it, in order: its own parts, slot content
		// and the caller's children. Read-only: the view changes it.
		childNodes component[] {
			def get() component[] {
				return children
			}
		}

		// Its window as layouts see it, as of the last layout: size, size classes,
		// orientation, scale, whether it is the active one and fullscreen. A viewport
		// without a size before the first layout.
		viewport Viewport {
			def get() Viewport {
				let held = _viewport
				let above = _parent
				for {
					break when above is none
					held = above._viewport
					above = above._parent
				}
				return Viewport{} when held is none
				return held
			}
		}

		// The async scope of the work it does while it is in a window, `async<tasks>
		// watch()`: cancelled when it leaves the tree, before `detached` runs, so a
		// task started in it does not outlive the component's place there. A member
		// that fails does not cancel the others. Work that must go on after (saving
		// a document when its editor closes) belongs to a longer scope.
		tasks AsyncScope {
			def get() AsyncScope {
				let held = _tasks
				return held unless held is none
				let made = new AsyncScope(failFast = false)
				_tasks = made
				return made
			}
		}

		// The pointer is over it.
		hover bool {
			def get() bool {
				return isHover
			}
		}

		// A pointer button or key is held down on it.
		pressed bool {
			def get() bool {
				return isPressed
			}
		}

		// It has the keyboard focus.
		focused bool {
			def get() bool {
				return isFocused
			}
		}

		// It or one of its descendants has the keyboard focus.
		focusWithin bool {
			def get() bool {
				return isFocusWithin
			}
		}

		// It has the keyboard focus and the focus was moved with the keyboard.
		focusVisible bool {
			def get() bool {
				return isFocusVisible
			}
		}

		// It is being dragged.
		dragging bool {
			def get() bool {
				return isDragging
			}
		}

		// A drag it accepts is over it.
		dropTarget bool {
			def get() bool {
				return isDropTarget
			}
		}

		// Presses on it are clicks: it has `onClick`, `onDoubleClick` or `onLongPress`,
		// or declares one of the hooks `clicked`, `doubleClicked`, `longPressed`.
		takesClicks bool {
			def get() bool {
				let me component = self
				return me.__clicks() != 0 || !(onClick is none) || !(onDoubleClick is none) || !(onLongPress is none)
			}
		}

		// It can take the keyboard focus: `focusable`, else when it takes clicks.
		takesFocus bool {
			def get() bool {
				let asked = focusable
				return asked unless asked is none
				return takesClicks
			}
		}

		// Tab stops at it: `tabStop`, else when it takes clicks and the focus.
		takesTab bool {
			def get() bool {
				let asked = tabStop
				return asked unless asked is none
				return takesClicks && takesFocus
			}
		}

		// `enabled` is false here or on an ancestor.
		disabled bool {
			def get() bool {
				return !enabled || isBlocked
			}
		}

		// The built-in states that hold, a bit each, as a style's `on` asks for them:
		// hover 1, pressed 2, focused 4, focusWithin 8, focusVisible 16, disabled 32,
		// dragging 64, dropTarget 128. A disabled component is not hovered, pressed or
		// focused.
		def heldStates() int {
			let held = (isFocusWithin ?? (8, 0)) | (isDragging ?? (64, 0)) | (isDropTarget ?? (128, 0))
			return held | 32 when disabled
			return held | (isHover ?? (1, 0)) | (isPressed ?? (2, 0)) | (isFocused ?? (4, 0)) | (isFocusVisible ?? (16, 0))
		}

		// The actions its controller declares with `@action`, bound to it: what its
		// keys run while the focus is in it, and what a command palette lists (`actionsOf`
		// in std.ui). The compiler writes it for a component whose controller has any.
		def __actions() Action[] {
			return Action[]
		}

		// Runs when it is clicked, before the caller's `onClick`: a component declares it
		// to say what a click on it does (`def clicked() { press() }`), and presses on it
		// are then clicks. Nothing calls it while it is disabled.
		def clicked() {}

		// Runs on the second click of a double click, before the caller's
		// `onDoubleClick`; declared, the second click no longer runs `clicked`.
		def doubleClicked() {}

		// Runs when a press on it is held half a second without moving, before the
		// caller's `onLongPress`; the release that follows clicks nothing.
		def longPressed() {}

		// Clicks it as a press of the pointer does: `clicked`, then the caller's
		// `onClick`. Nothing happens while it is disabled.
		def click() {
			return when disabled
			let me component = self
			me.clicked()
			let run = onClick
			run() unless run is none
		}

		// Which of `clicked` (1), `doubleClicked` (2) and `longPressed` (4) its controller
		// declares. The compiler writes it for a component that declares any.
		def __clicks() int {
			return 0
		}

		// The logical parent; none for a root or a detached component.
		def parent() ?component {
			return _parent
		}

		// The sibling mounted after it.
		def next() ?component {
			let p = parent()
			return none when p is none
			let me component = self
			let list = p.children
			let n = list.len()
			for let (i, child) in list {
				if child == me {
					let j = i + 1
					return none when j >= n
					return list[j]
				}
			}
			return none
		}

		// The sibling mounted before it.
		def prev() ?component {
			let p = parent()
			return none when p is none
			let me component = self
			let list = p.children
			for let (i, child) in list {
				if child == me {
					let j = i - 1
					return none when j < 0
					return list[j]
				}
			}
			return none
		}

		// The nearest ancestor of component type or interface `C`.
		def closest<C>() ?C {
			let at = parent()
			for {
				return none when at is none
				return at when at is C
				at = at.parent()
			}
		}

		// The first descendant of type `C`; with `ref`, the first whose ref
		// has that name.
		def find<C>(ref string = "") ?C {
			for let child in children {
				let named = child.refName
				if child is C {
					return child when ref == "" || named == ref
				}
				let below = child.find<C>(ref)
				return below unless below is none
			}
			return none
		}

		// Makes `value` the `V` of this component and of those under it, in
		// place of one an ancestor provides. Called again, it replaces the
		// value; the views and styles that read it see it on the next frame.
		// Providing the value it already holds does nothing, so a view may
		// provide on every run. Two values of one type under one component
		// need a type of their own each, which also names them.
		def provide<V>(value V) {
			for let (at, held) in provided {
				if held is V {
					return when held == value
					provided[at] = value
					staleTree()
					askFrame()
					return
				}
			}
			provided.push(value)
			staleTree()
			askFrame()
		}

		// The `V` the nearest component provides, itself first, then its
		// parent and so on up the tree; none when none of them provides one.
		// It follows the logical tree: a popup finds what the component that
		// placed it does.
		def context<V>() ?V {
			let me component = self
			let at ?component = me
			for {
				return none when at is none
				for let held in at.provided {
					return held when held is V
				}
				at = at.parent()
			}
		}

		// A point of its own coordinates in the window's, transforms included.
		def toWindow(p Point<Pixels>) Point<Pixels> {
			return p
		}

		// A point of the window's coordinates in its own.
		def fromWindow(p Point<Pixels>) Point<Pixels> {
			return p
		}

		// Scrolls every scrolling ancestor so it is visible.
		def reveal() {
			let me component = self
			askReveal(me)
		}

		// Requests the keyboard focus; queued until layout when it is not
		// laid out yet. Call it from the task that runs the windows (an event
		// handler, a view), not from a task of the component's own.
		def focus() {
			let me component = self
			askFocus(me)
		}

		// Shows what it and the components under it read that changed in place (a model
		// object, a service): their views, styles and `render` run again on the next
		// frame. From its `render`, asks for that `render` alone to run again.
		def redraw() {
			let me component = self
			// Under the UI's state lock (`__global_lock(1)`), as a task's `@state` store: the
			// marks it sets and the frame's lists it adds to are the windows' loop's, which
			// holds the lock for each pass.
			__global_lock(1)
			marked(askRedraw(me))
			__global_unlock(1)
		}

		// Asks for part of it to be drawn again, `rect` in logical pixels of the window
		// (as `style.geom.frame` is): a caret's line is drawn again, not the editor.
		// What the frame shows again is that part of its box; the rest of what it draws
		// is taken as unchanged.
		def redraw(rect Rect<Pixels>) {
			let me component = self
			__global_lock(1)
			marked(askRedrawPart(me, rect))
			__global_unlock(1)
		}

		// What `redraw()` marks, from where `askRedraw` says it was called.
		internal def marked(from RedrawFrom) {
			if from == RedrawFrom.View {
				stale()
			} else if from == RedrawFrom.Elsewhere {
				staleTree()
			}
		}

		// Runs its view again: a component the view places for the first time is built, one
		// already there gets the arguments as they are now (one that differs from what was
		// passed last time is assigned and that child redrawn), what the view no longer
		// places leaves `children`, and each child that is marked (`needsBuild`) then runs
		// its own. The window runs the views of the components marked since its last
		// frame; a component whose view places nothing has nothing to do.
		def rerun() {}

		// Drops the children its view placed, and theirs: called once it has left the
		// tree for good. A child holds its parent through the handlers the view gave it
		// (`onPick = pick`), so a component that is dropped with its children still under
		// it stays alive with them. A later `rerun()` builds the children again.
		def unmount() {
			dropChildren()
		}

		// Lets go of a child in `leaving`, once its exit has been shown: it is unmounted
		// and cut loose. Nothing happens for a component that is not leaving here.
		def finishLeaving(child component) {
			let next component[] = []
			let found = false
			for let held in leaving {
				if held == child {
					found = true
				} else {
					next.push(held)
				}
			}
			if found {
				leaving = next
				child.isLeaving = false
				child.hasLeft = true
				child.unmount()
				child.orphan()
			}
		}

		// Takes `child`, which its view no longer places, out of the tree: into `leaving`
		// when its style has an `exit`, for good otherwise.
		internal def leave(child component) {
			if child.style.exit is none {
				child.unmount()
				child.orphan()
			} else {
				child.isLeaving = true
				leaving.push(child)
				stale()
			}
		}

		// Takes it back out of its parent's `leaving`: the view places it again.
		internal def rejoin() {
			isLeaving = false
			let p = _parent
			if p is none {
				return
			}
			let me component = self
			let next component[] = []
			for let held in p.leaving {
				next.push(held) when held != me
			}
			p.leaving = next
		}

		// Unmounts and lets go of every child, of what is leaving, and of what its
		// caller's block gave it; not of one that moved to another component since
		// (`_parent`, `_heldIn`).
		internal def dropChildren() {
			let me component = self
			for let child in children {
				let at = child._parent
				continue when !(at is none) && at != me
				child.unmount()
				child.orphan()
			}
			children = []
			for let child in leaving {
				child.isLeaving = false
				child.hasLeft = true
				child.unmount()
				child.orphan()
			}
			leaving = []
			for let child in content {
				let holder = child._heldIn
				continue when !(holder is none) && holder != me
				child.unmount()
				child.orphan()
			}
			content = []
		}

		// What its caller's block gave it, in order: its view places them where it calls
		// `children()`. Kept by the view code the compiler generates, with the methods below.
		internal content component[]

		// `content` is what `setChildren` gave it, which a call without a block keeps.
		internal contentGiven bool

		// The n-th component of its caller's block takes its place in `content`. Another
		// component there marks it: its view places the content where it says
		// `children()`.
		internal def giveContent(at int, child component) {
			let other = contentGiven || at >= content.len() || content[at] != child
			contentGiven = false
			content = placed(content, at, child)
			return unless other
			stale()
			// It is this component's content now, also when another held it before (a
			// view value placed by position in a loop of keyed rows moves so).
			let me component = self
			let holder = child._heldIn
			child._heldIn = me when holder is none || holder != me
		}

		// Keeps the first `count` of `content`: the rest left the caller's block. What
		// `setChildren` gave stays while the caller's block gives nothing.
		internal def trimContent(count int) {
			return when contentGiven
			if content.len() > count {
				stale()
				let me component = self
				let next component[] = []
				for let (i, held) in content {
					let holder = held._heldIn
					if i < count {
						next.push(held)
					} else if !(holder is none) && holder != me {
						// Given to another component since: it moved there.
						continue
					} else {
						// It leaves from where a `children()` put it; never
						// placed, it is in no tree to leave.
						let at = held._parent
						if at is none {
							held.unmount()
							held.orphan()
						} else {
							at.leave(held)
						}
					}
				}
				content = next
			}
		}

		// Places `content` in `children` from `at` on; returns the place after it.
		internal def placeContent(at int) int {
			let me component = self
			let place = at
			for let child in content {
				adopt(place, child)
				child._parent = me
				runGiven(child)
				place += 1
			}
			return place
		}

		// Runs the view of `child` again when `setChildren` gave it: a component made
		// in code has no caller's view to run it, as a caller's block has for what it
		// gave, so its host does each time it places it.
		internal def runGiven(child component) {
			child.rerun() when contentGiven
		}

		// Gives `content` to `to`, a child of its view, from `at` of that child's content
		// on; returns the place after it.
		internal def passContent(to component, at int) int {
			let place = at
			for let child in content {
				to.giveContent(place, child)
				runGiven(child)
				place += 1
			}
			return place
		}

		// True for a component its caller's block gave it.
		internal def holdsContent(child component) bool {
			for let held in content {
				return true when held == child
			}
			return false
		}

		// `held` with `child` at `at`, for the placing a view's run does and nothing else: a
		// run places from 0 on and each component once, so everything before `at` was
		// placed on this run and is another component. At the end the child is therefore
		// appended, and a list is mounted without a copy per element; as a general move
		// of a component that may already be in `held` it would be wrong.
		internal def placed(held component[], at int, child component) component[] {
			if at >= held.len() {
				held.push(child)
				return held
			}
			return held when held[at] == child
			let next component[] = []
			for let (i, other) in held {
				next.push(child) when i == at
				next.push(other) when other != child
			}
			return next
		}

		// Puts `child` at `at` of `children`. Kept by the view code the compiler
		// generates, with the methods below.
		internal def adopt(at int, child component) {
			// Appended in place, which the store does not see as a change.
			stale() when at >= children.len()
			children = placed(children, at, child)
		}

		// Marks it stale (`isStale`, `needsBuild`) and the components above it as holding
		// one (`staleBelow`).
		internal def stale() {
			isStale = true
			needsBuild = true
			climb()
			// A mark made outside the frame's own work (a task's `@state` store, a
			// handler's) asks for the frame that shows it: the windows' loop waits for
			// an event otherwise. From the run of a frame's views the ask is nothing
			// (`askFrame`); while the frame brings nodes in step, lays out or draws, the
			// frame itself asks for what its marks need (`Scene.arrange`).
			askFrame() unless frameWorking()
			// What the view of the component that names it with `ref` changed here (the
			// arguments, the call's style) marks nothing more: that run is under way, and
			// following it after layout would run it on every frame.
			let holder = _refOf
			return when holder is none || runsView(holder)
			holder.stale() unless holder.needsBuild
			// Its view reads this one as layout leaves it: it runs again once the
			// frame's layout is done (`frames.follow`).
			follow(holder)
		}

		// Marks it as a store of one of the fields its node copies does (`stale`): what it
		// shows changed in a way no store says. For the UI runtime (a `render` that asked
		// for a whole frame, a time a component asked to be woken at).
		def _mark() {
			stale()
		}

		// Sets `staleBelow` on the components above it, up to one that holds it already.
		internal def climb() {
			let above = _parent
			for {
				return when above is none || above.staleBelow
				above.staleBelow = true
				above = above._parent
			}
		}

		// Marks it stale for a store that changed one of its own fields or a property of
		// its style, unless the store is the work of the frame under way (its styles,
		// layout, or its own drawing): what those leave shows in the same frame, and a view
		// or style that reads it asks with `redraw()`. Another component's `render` that
		// changes it marks it for the next frame (`frames.storeMarks`). The compiler calls it at such a store; it is
		// not internal for the prelude's style code (`__style_wrote`).
		def _touched() {
			// Under the UI's state lock, as `redraw()`: the store may be a task's.
			let me component = self
			__global_lock(1)
			stale() when storeMarks(me)
			__global_unlock(1)
		}

		// Says that its view starts (`on`) or finished a run; the compiler calls it around
		// each run. What a view run stores is no frame's own work (`_touched`), wherever
		// it runs.
		internal def viewRuns(on bool) {
			let me component = self
			viewRunning(on, me)
		}

		// Marks it and everything under it stale: what they read may have changed in
		// place (a provided value, a model a `redraw()` names).
		internal def staleTree() {
			stale()
			for let child in children {
				child.staleTree()
			}
		}

		// Runs its view again when it is marked (`needsBuild`) or the frame runs every
		// view (`rebuildingAll`), and the views of the marked components under it
		// (`staleBelow`) that its run did not reach. For the run of the view that places
		// it and for the UI runtime, which calls it on the root of a window each frame.
		// What a run marks of its own component is that run's doing.
		def _rerunMarked() {
			if rebuildingAll() {
				rerun()
				needsBuild = false
				return
			}
			if needsBuild {
				rerun()
				needsBuild = false
			} else if !staleBelow {
				return
			}
			// What its run did not reach: what a caller's block gave it runs where that
			// caller's view runs, and the components under its children.
			for let child in children {
				child._rerunMarked() when child.needsBuild || child.staleBelow
			}
		}

		// Makes `given` what its view places where it calls `children()`, in order, in
		// place of what a caller's block gave it, and runs its view again. For a component
		// that holds others made in code: a window's chrome holds the window's root so,
		// and a `ViewHost` its views. A view gives a component its children in the block
		// of the call; given so, they stay until a block of its caller gives others.
		def setChildren(given component[]) {
			let same = content.len() == given.len()
			if same {
				for let (at, child) in given {
					same = false when content[at] != child
				}
			}
			return when same
			// What it held and is not given again leaves, as a child that left a caller's
			// block does.
			for let held in content {
				let stays = false
				for let child in given {
					stays = true when child == held
				}
				continue when stays
				let at = held._parent
				if at is none {
					held.unmount()
					held.orphan()
				} else {
					at.leave(held)
				}
			}
			let next component[] = []
			for let child in given {
				next.push(child)
			}
			content = next
			contentGiven = true
			rerun()
		}

		// Takes `child` out of what it holds, given with `setChildren` or placed as one
		// of its own children, without unmounting it: it leaves the tree with what is
		// under it (its `detached` runs) and keeps its state, to be given to another
		// component with `setChildren`. False when it holds no such child. For hosts
		// that move live components between places, as std.ui's `ViewHost.take` does.
		def _release(child component) bool {
			let found = false
			let given component[] = []
			for let held in content {
				if held == child {
					found = true
				} else {
					given.push(held)
				}
			}
			content = given when found
			let own component[] = []
			for let held in children {
				if held == child {
					found = true
				} else {
					own.push(held)
				}
			}
			children = own
			return false unless found
			child._parent = none
			child._heldIn = none
			rerun()
			return true
		}

		// A new place for a view value, for the call that places one in its view.
		internal def newPlacement() ViewPlacement {
			return new ViewPlacement()
		}

		// What the view body named `body` kept at `p`, none when it has not run there
		// yet. When another body ran there last, what that one kept is let go: the
		// components it placed leave with this run.
		internal def viewState(p ViewPlacement, body string) ?ViewPlacementState {
			if p.body != body {
				p.body = body
				p.state = none
			}
			return p.state
		}

		// Puts `child`, a component of a view value placed in it, at `at`: among its
		// own children, or in its content when the placing stands in the block of a
		// call.
		internal def placeView(at int, child component, asContent bool) {
			if asContent {
				giveContent(at, child)
			} else {
				let me component = self
				adopt(at, child)
				child._parent = me
			}
		}

		// Places its content in `host` from `at` on, for a `children()` written in a
		// view value that `host` places; returns the place after it.
		internal def lendContent(host component, at int, asContent bool) int {
			let place = at
			for let child in content {
				host.placeView(place, child, asContent)
				runGiven(child)
				place += 1
			}
			return place
		}

		// Cuts it and everything under it loose from its parents. A child names its
		// parent and the parent holds the child: left in place, the links of a subtree
		// the view dropped would keep it alive for ever.
		internal def orphan() {
			_parent = none
			// A view that places it again runs its view, which builds what it dropped.
			needsBuild = true
			for let child in children {
				child.orphan()
			}
		}

		// Drops its own children past the first `count`: its view no longer places them.
		// A dropped child is unmounted, so the handlers under it let go of it, or goes
		// to `leaving` when its style has an `exit` (`leave`). A component of its
		// caller's block that no `children()` reached on this run only leaves the
		// tree: the caller keeps it, with what is under it. One the caller's block
		// dropped is in `leaving` already. One another component placed since has moved
		// and stays as it is.
		internal def trimOwn(count int) {
			if children.len() > count {
				let me component = self
				let next component[] = []
				for let (i, held) in children {
					let at = held._parent
					if i < count {
						next.push(held)
					} else if held.isLeaving {
						continue
					} else if !(at is none) && at != me {
						// Another component placed it since: it moved there (a view value
						// placed by position in a loop of keyed rows).
						continue
					} else if holdsContent(held) {
						held._parent = none
					} else {
						leave(held)
					}
				}
				children = next
			}
		}

		// Runs when it is mounted in a window.
		def attached() {}

		// Runs when it is unmounted; `tasks` is already cancelled.
		def detached() {}

		// Draws it. Runs when its inputs, style or rectangle changed, or
		// after `redraw()`; not every frame.
		def render(ctx RenderContext) {
			ctx.outerShadows()
			ctx.background()
			ctx.borders()
			ctx.childNodes()
			ctx.innerShadows()
		}

		// Receives what a pointer does over it: offered to the component under the pointer,
		// then to its ancestors until one returns true. Enter and Leave go to the component
		// they concern only.
		def pointer(e PointerEvent) bool {
			return false
		}

		// Receives a key: offered to the focused component, then to its ancestors until one
		// returns true.
		def key(e KeyEvent) bool {
			return false
		}

		// The size of its own content within `limit`, for a component that has no child
		// nodes and sizes to what it draws (text, a chart legend); layout adds padding and
		// border. Called several times with different limits in one layout pass, so it must
		// depend on nothing but `limit` and the component's fields.
		def measure(limit Limit) Size<Pixels> {
			return new Size<Pixels>(0(px), 0(px))
		}

		// The distance from the top of its content to its first text baseline, for a row
		// that lines its children up on their text; none when it draws no text.
		def firstBaseline() ?Pixels {
			return none
		}

		def str() string {
			return ""
		}
	}
}
