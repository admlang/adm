partial module builtin {
	use (
		std.reflection::(TypeMetaContext)
		std.math.geom::(Point, Rect, Size)
		std.ui::(KeyEvent, Limit, PointerEvent, RenderContext)
		std.ui.frames::(askFocus, askFrame, askReveal)
		std.units::(Pixels)
	)

	// Marks the annotated type as a component's controller.
	meta def controller(ctx TypeMetaContext) {
		// intrinsic
	}

	// The base of every component. `ref`, `key` and `style` are reserved
	// arguments of a component call; a controller field with one of those
	// names is an error.
	@builtin(for = component)
	internal type Component<T: component> {
		// False: it and its descendants take no input and are in the
		// `disabled` state.
		@input
		enabled bool = true

		// What it is, for theme rules.
		@input
		role Role = Role.None

		// Text shown when the pointer rests on it or it has keyboard focus.
		@input
		tooltip string = ""

		// Can take the keyboard focus.
		@input
		focusable bool = false

		// Reached with Tab.
		@input
		tabStop bool = false

		// Takes the focus when mounted.
		@input
		autofocus bool = false

		// While focused, keys reach it before shortcuts (a terminal).
		@input
		capturesKeys bool = false

		// The mounted list the compiler fills; read it as `childNodes`.
		children component[]
		_parent  ?component
		view     view
		style    style

		// Set by the view runtime; read them as `hover`, `pressed`, `focused` and so on.
		isHover        bool
		isPressed      bool
		isFocused      bool
		isFocusWithin  bool
		isFocusVisible bool
		isDragging     bool
		isDropTarget   bool
		// An ancestor is not enabled.
		isBlocked      bool

		// True for a component declared `@scoped`. Set when it is built.
		isScoped bool

		// The children its view dropped whose style has an `exit`: out of `children`,
		// still mounted with what is under them, until `finishLeaving`. The place of
		// the view that dropped one keeps it and takes it back when it is reached again.
		leaving component[]

		// It is in its parent's `leaving`.
		isLeaving bool

		// `finishLeaving` let go of it: no view takes it back.
		hasLeft bool

		// The name the view that placed it gave it with `ref = name`; empty
		// without one. Set when it is built.
		refName string = ""

		// Everything mounted under it, in order: its own parts, slot content
		// and the caller's children. Read-only: the view changes it.
		childNodes component[] {
			def get() component[] {
				return children
			}
		}

		// The pointer is over it.
		hover bool {
			def get() bool {
				return isHover
			}
		}

		// A pointer button or key is held down on it.
		pressed bool {
			def get() bool {
				return isPressed
			}
		}

		// It has the keyboard focus.
		focused bool {
			def get() bool {
				return isFocused
			}
		}

		// It or one of its descendants has the keyboard focus.
		focusWithin bool {
			def get() bool {
				return isFocusWithin
			}
		}

		// It has the keyboard focus and the focus was moved with the keyboard.
		focusVisible bool {
			def get() bool {
				return isFocusVisible
			}
		}

		// It is being dragged.
		dragging bool {
			def get() bool {
				return isDragging
			}
		}

		// A drag it accepts is over it.
		dropTarget bool {
			def get() bool {
				return isDropTarget
			}
		}

		// `enabled` is false here or on an ancestor.
		disabled bool {
			def get() bool {
				return !enabled || isBlocked
			}
		}

		// The built-in states that hold, a bit each, as a style's `on` asks for them:
		// hover 1, pressed 2, focused 4, focusWithin 8, focusVisible 16, disabled 32,
		// dragging 64, dropTarget 128. A disabled component is not hovered, pressed or
		// focused.
		def heldStates() int {
			let held = (isFocusWithin ?? (8, 0)) | (isDragging ?? (64, 0)) | (isDropTarget ?? (128, 0))
			return held | 32 when !enabled || isBlocked
			return held | (isHover ?? (1, 0)) | (isPressed ?? (2, 0)) | (isFocused ?? (4, 0)) | (isFocusVisible ?? (16, 0))
		}

		// The logical parent; none for a root or a detached component.
		def parent() ?component {
			return _parent
		}

		// The sibling mounted after it.
		def next() ?component {
			let p = parent()
			return none when p is none
			let me component = self
			let list = p.children
			let n = list.len()
			for let (i, child) in list {
				if child == me {
					let j = i + 1
					return none when j >= n
					return list[j]
				}
			}
			return none
		}

		// The sibling mounted before it.
		def prev() ?component {
			let p = parent()
			return none when p is none
			let me component = self
			let list = p.children
			for let (i, child) in list {
				if child == me {
					let j = i - 1
					return none when j < 0
					return list[j]
				}
			}
			return none
		}

		// The nearest ancestor of component type or interface `C`.
		def closest<C>() ?C {
			let at = parent()
			for {
				return none when at is none
				return at when at is C
				at = at.parent()
			}
		}

		// The first descendant of type `C`; with `ref`, the first whose ref
		// has that name.
		def find<C>(ref string = "") ?C {
			for let child in children {
				let named = child.refName
				if child is C {
					return child when ref == "" || named == ref
				}
				let below = child.find<C>(ref)
				return below unless below is none
			}
			return none
		}

		// A point of its own coordinates in the window's, transforms included.
		def toWindow(p Point<Pixels>) Point<Pixels> {
			return p
		}

		// A point of the window's coordinates in its own.
		def fromWindow(p Point<Pixels>) Point<Pixels> {
			return p
		}

		// Scrolls every scrolling ancestor so it is visible.
		def reveal() {
			let me component = self
			askReveal(me)
		}

		// Requests the keyboard focus; queued until layout when it is not
		// laid out yet. Call it from the task that runs the windows (an event
		// handler, a view), not from a task of the component's own.
		def focus() {
			let me component = self
			askFocus(me)
		}

		// Asks for its `render` to run again on the next frame.
		def redraw() {
			askFrame()
		}

		// Asks for part of it to be drawn again: a blinking caret redraws
		// one line, not the editor.
		def redraw(rect Rect<Pixels>) {
			askFrame()
		}

		// Runs its view again: a component the view places for the first time is built, one
		// already there gets the arguments as they are now (one that differs from what was
		// passed last time is assigned and that child redrawn), what the view no longer
		// places leaves `children`, and each child then runs its own. The window does this
		// for its root on every frame that runs; a component whose view places nothing has
		// nothing to do.
		def rerun() {}

		// Drops the children its view placed, and theirs: called once it has left the
		// tree for good. A child holds its parent through the handlers the view gave it
		// (`onPick = pick`), so a component that is dropped with its children still under
		// it stays alive with them. A later `rerun()` builds the children again.
		def unmount() {
			dropChildren()
		}

		// Lets go of a child in `leaving`, once its exit has been shown: it is unmounted
		// and cut loose. Nothing happens for a component that is not leaving here.
		def finishLeaving(child component) {
			let next component[] = []
			let found = false
			for let held in leaving {
				if held == child {
					found = true
				} else {
					next.push(held)
				}
			}
			if found {
				leaving = next
				child.isLeaving = false
				child.hasLeft = true
				child.unmount()
				child.orphan()
			}
		}

		// Takes `child`, which its view no longer places, out of the tree: into `leaving`
		// when its style has an `exit`, for good otherwise.
		internal def leave(child component) {
			if child.style.exit is none {
				child.unmount()
				child.orphan()
			} else {
				child.isLeaving = true
				leaving.push(child)
			}
		}

		// Takes it back out of its parent's `leaving`: the view places it again.
		internal def rejoin() {
			isLeaving = false
			let p = _parent
			if p is none {
				return
			}
			let me component = self
			let next component[] = []
			for let held in p.leaving {
				next.push(held) when held != me
			}
			p.leaving = next
		}

		// Unmounts and lets go of every child, of what is leaving, and of what its
		// caller's block gave it.
		internal def dropChildren() {
			for let child in children {
				child.unmount()
				child.orphan()
			}
			children = []
			for let child in leaving {
				child.isLeaving = false
				child.hasLeft = true
				child.unmount()
				child.orphan()
			}
			leaving = []
			for let child in content {
				child.unmount()
				child.orphan()
			}
			content = []
		}

		// What its caller's block gave it, in order: its view places them where it calls
		// `children()`. Kept by the view code the compiler generates, with the methods below.
		internal content component[]

		// The n-th component of its caller's block takes its place in `content`.
		internal def giveContent(at int, child component) {
			content = placed(content, at, child)
		}

		// Keeps the first `count` of `content`: the rest left the caller's block.
		internal def trimContent(count int) {
			if content.len() > count {
				let next component[] = []
				for let (i, held) in content {
					if i < count {
						next.push(held)
					} else {
						// It leaves from where a `children()` put it; never
						// placed, it is in no tree to leave.
						let at = held._parent
						if at is none {
							held.unmount()
							held.orphan()
						} else {
							at.leave(held)
						}
					}
				}
				content = next
			}
		}

		// Places `content` in `children` from `at` on; returns the place after it.
		internal def placeContent(at int) int {
			let me component = self
			let place = at
			for let child in content {
				adopt(place, child)
				child._parent = me
				place += 1
			}
			return place
		}

		// Gives `content` to `to`, a child of its view, from `at` of that child's content
		// on; returns the place after it.
		internal def passContent(to component, at int) int {
			let place = at
			for let child in content {
				to.giveContent(place, child)
				place += 1
			}
			return place
		}

		// True for a component its caller's block gave it.
		internal def holdsContent(child component) bool {
			for let held in content {
				return true when held == child
			}
			return false
		}

		// `held` with `child` at `at`, for the placing a view's run does and nothing else: a
		// run places from 0 on and each component once, so everything before `at` was
		// placed on this run and is another component. At the end the child is therefore
		// appended, and a list is mounted without a copy per element; as a general move
		// of a component that may already be in `held` it would be wrong.
		internal def placed(held component[], at int, child component) component[] {
			if at >= held.len() {
				held.push(child)
				return held
			}
			return held when held[at] == child
			let next component[] = []
			for let (i, other) in held {
				next.push(child) when i == at
				next.push(other) when other != child
			}
			return next
		}

		// Puts `child` at `at` of `children`. Kept by the view code the compiler
		// generates, with the methods below.
		internal def adopt(at int, child component) {
			children = placed(children, at, child)
		}

		// A new place for a view value, for the call that places one in its view.
		internal def newPlacement() ViewPlacement {
			return new ViewPlacement()
		}

		// What the view body named `body` kept at `p`, none when it has not run there
		// yet. When another body ran there last, what that one kept is let go: the
		// components it placed leave with this run.
		internal def viewState(p ViewPlacement, body string) ?ViewPlacementState {
			if p.body != body {
				p.body = body
				p.state = none
			}
			return p.state
		}

		// Puts `child`, a component of a view value placed in it, at `at`: among its
		// own children, or in its content when the placing stands in the block of a
		// call.
		internal def placeView(at int, child component, asContent bool) {
			if asContent {
				giveContent(at, child)
			} else {
				let me component = self
				adopt(at, child)
				child._parent = me
			}
		}

		// Places its content in `host` from `at` on, for a `children()` written in a
		// view value that `host` places; returns the place after it.
		internal def lendContent(host component, at int, asContent bool) int {
			let place = at
			for let child in content {
				host.placeView(place, child, asContent)
				place += 1
			}
			return place
		}

		// Cuts it and everything under it loose from its parents. A child names its
		// parent and the parent holds the child: left in place, the links of a subtree
		// the view dropped would keep it alive for ever.
		internal def orphan() {
			_parent = none
			for let child in children {
				child.orphan()
			}
		}

		// Drops its own children past the first `count`: its view no longer places them.
		// A dropped child is unmounted, so the handlers under it let go of it, or goes
		// to `leaving` when its style has an `exit` (`leave`). A component of its
		// caller's block that no `children()` reached on this run only leaves the
		// tree: the caller keeps it, with what is under it. One the caller's block
		// dropped is in `leaving` already.
		internal def trimOwn(count int) {
			if children.len() > count {
				let next component[] = []
				for let (i, held) in children {
					if i < count {
						next.push(held)
					} else if held.isLeaving {
						continue
					} else if holdsContent(held) {
						held._parent = none
					} else {
						leave(held)
					}
				}
				children = next
			}
		}

		// Runs when it is mounted in a window.
		def attached() {}

		// Runs when it is unmounted; its tasks are cancelled.
		def detached() {}

		// Draws it. Runs when its inputs, style or rectangle changed, or
		// after `redraw()`; not every frame.
		def render(ctx RenderContext) {
			ctx.outerShadows()
			ctx.background()
			ctx.borders()
			ctx.childNodes()
			ctx.innerShadows()
		}

		// Receives what a pointer does over it: offered to the component under the pointer,
		// then to its ancestors until one returns true. Enter and Leave go to the component
		// they concern only.
		def pointer(e PointerEvent) bool {
			return false
		}

		// Receives a key: offered to the focused component, then to its ancestors until one
		// returns true.
		def key(e KeyEvent) bool {
			return false
		}

		// The size of its own content within `limit`, for a component that has no child
		// nodes and sizes to what it draws (text, a chart legend); layout adds padding and
		// border. Called several times with different limits in one layout pass, so it must
		// depend on nothing but `limit` and the component's fields.
		def measure(limit Limit) Size<Pixels> {
			return new Size<Pixels>(0(px), 0(px))
		}

		// The distance from the top of its content to its first text baseline, for a row
		// that lines its children up on their text; none when it draws no text.
		def firstBaseline() ?Pixels {
			return none
		}

		def str() string {
			return ""
		}
	}
}
