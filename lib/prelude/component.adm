partial module builtin {
	use (
		std.reflection::*
		std.gfx.canvas::*
	)

	// Marks the annotated type as a component's controller.
	meta def controller(ctx TypeMetaContext) {
		// intrinsic
	}

	@builtin(for = component)
	internal type Component<T: component> {
		// list of child components
		children component[]
		_parent  ?component
		view     view
		style    style

		def parent() ?component {
			return _parent
		}

		def next() ?component {
			let p = parent()
			return none when p is none
			let me component = self
			let list = p.children
			let n = list.len()
			for let (i, child) in list {
				if child == me {
					let j = i + 1
					return none when j >= n
					return list[j]
				}
			}
			return none
		}

		def prev() ?component {
			let p = parent()
			return none when p is none
			let me component = self
			let list = p.children
			for let (i, child) in list {
				if child == me {
					let j = i - 1
					return none when j < 0
					return list[j]
				}
			}
			return none
		}

		def render(ctx DrawContext) {
			// todo render component
			println("rendering component")
		}

		def str() string {
			return ""
		}
	}
}
