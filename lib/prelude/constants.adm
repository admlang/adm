partial module builtin {
	/**
	These constants are filled in in by the compiler and some of them vary depending on where they
	are being used (eg __file__, __line__).
	They are are declared here to provide the IDEs with intellisense and documentation.
	**/

	// Compiler and build metadata
	const (
		// The compiler’s semantic version string.
		__compiler_version__ = ""
		// Full target triple: CPU-Vendor-OS (e.g., "x86_64-unknown-linux-gnu"
		__target__           = ""
		// OS of the active compilation target (e.g., "linux", "windows", "macos", "android", "wasm")
		__os__               = ""
		// Architecture of the active compilation target. (e.g., "x86_64", "arm64", "wasm32")
		__arch__             = ""
		// ISO-8601 timestamp for when the compiler executed the build.
		__build_timestamp__  = ""
		// "little" or "big" depending on the target architecture.
		__endianness__       = ""
		// Pointer width in bytes for the target.
		__ptr_width__        = 8
		// Size of the default integer type, in bytes.
		__int_width__        = 8
		// Boolean true if compiling in debug mode.
		__debug__            = false
		// Boolean true if compiling in release/optimized mode.
		__release__          = false
		// Width of native register size (bytes)
		__word_size__        = 0
		// Required stack alignment for the target.
		__stack_alignment__  = 0
		// Active ABI (e.g., "sysv", "msvc")
		__abi__              = ""
	)

	// Build system
	const (
		// Git commit hash of the current build.
		// This is empty if the build was not compiled from a Git repository.
		__git_commit__ = ""
		// Git branch name of the current build.
		// This is empty if the build was not compiled from a Git repository.
		__git_branch__ = ""
		// Git tag name of the current build.
		// This is empty if the build was not compiled from a Git repository.
		__git_tag__    = ""
	)

	// Application identity.
	//
	// Filled from a `adm.toml` file (TOML) when present. Without one, the id and
	// name are the application's declared name (the file name for an anonymous
	// `application {}`) and the version is `0.1`; the publisher and update values
	// stay empty.
	const (
		// Stable application id: derived from publisher key + per-app slug with a
		// `adm.toml`, else the application name. Never empty.
		__app_id__           = ""
		// Human name the application is known by: the `adm.toml` slug when one is
		// configured, else the application name. Names the app's home folder,
		// `~/.<__app_name__>/`. Never empty.
		__app_name__         = ""
		// Application version from `adm.toml`, else `0.1`.
		__app_version__      = ""
		// Stable publisher id derived from the publisher public key.
		__publisher_id__     = ""
		// Publisher public key used for update verification.
		__publisher_pubkey__ = ""
		// Optional embedded update feed URL (resolved from `adm.toml`).
		__update_feed__      = ""
		// Optional embedded update channel (resolved from `adm.toml`).
		__update_channel__   = ""
		// Optional embedded update artifact id (resolved from `adm.toml`).
		__update_artifact__  = ""
		// Per-build unique identifier (not stable across builds).
		__build_id__         = ""
	)

	// Source location of a call site.
	//
	// Fields mirror the `__file_name__` / `__line__` / ... source-metadata
	// constants below. A function annotated `@trackCaller` receives this
	// implicitly from every call site, and those constants read from it inside
	// the annotated body instead of folding to the body's own location.
	//
	// There is no way to pass this explicitly: the compiler fills it, so a caller
	// cannot claim to be somewhere it is not.
	struct CallerLocation {
		// Basename of the calling source file.
		fileName   string
		// Absolute path to the calling source file.
		filePath   string
		// Absolute directory path of the calling source file.
		dir        string
		// Compiler-generated hash of the calling file's contents.
		fileHash   string
		// Line number of the call site (1-based).
		line       int
		// Fully-qualified module of the calling source file.
		// Named `moduleName` because `module` is a keyword.
		moduleName string
		// Name of the symbol the call site sits in.
		name       string
	}

	// Source metadata
	const (
		// Basename of the current source file.
		__file_name__ = ""
		// Absolute path to the current source file.
		__file_path__ = ""
		// Compiler-generated hash of the file contents (for caching).
		__file_hash__ = ""
		// Current line number (1-based).
		__line__      = 0
		// Fully-qualified module/package of the current file.
		__module__    = ""
		// Current symbol name (function, type, method, etc.).
		__name__      = ""
		// Absolute directory path of the current file.
		__dir__       = ""
	)

	// Helper functions
	const (
		// True when compiling for test mode.
		__in_test__ = false
	)
}
