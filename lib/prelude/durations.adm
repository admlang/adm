partial module builtin {
	// duration is a signed span of time in nanoseconds, written `1500ms`,
	// `2s` or `1h30m`.
	@builtin(primitive = "duration")
	type duration {
		// Returns -1 when this span is shorter than other, 1 when it is longer,
		// and 0 when they are equal.
		def compare(other duration) int {
			return -1 when self < other
			return 1 when self > other
			return 0
		}

		// Returns the span as Go writes it: `0s`, `750ns`, `1.5µs`, `2.25ms`,
		// `1.5s`, `1m0s`, `72h3m0.5s`; a negative span starts with `-`. Below
		// a second the largest unit that keeps a whole part is used, with its
		// fraction up to the nanosecond; from a second up it is hours,
		// minutes and seconds, the leading ones left out while zero.
		def str() string {
			let ns = int64(self)
			return "0s" when ns == 0
			// Through uint64, so the most negative span has a magnitude too.
			let u = ns < 0 ?? (uint64(0) - uint64(ns), uint64(ns))
			let sign = ns < 0 ?? ("-", "")
			if u < uint64(1000000000) {
				return "{sign}{u}ns" when u < uint64(1000)
				return "{sign}{durationFraction(u, 3)}µs" when u < uint64(1000000)
				return "{sign}{durationFraction(u, 6)}ms"
			}
			let text = durationFraction(u % uint64(60000000000), 9) + "s"
			let minutes = u / uint64(60000000000)
			if minutes > uint64(0) {
				text = "{minutes % uint64(60)}m" + text
				let hours = minutes / uint64(60)
				text = "{hours}h" + text when hours > uint64(0)
			}
			return sign + text
		}

		// Returns the span in nanoseconds.
		def nanoseconds() int64 {
			return int64(self)
		}

		// Returns the span in whole microseconds, truncated toward zero.
		def microseconds() int64 {
			return int64(self) / int64(1000)
		}

		// Returns the span in whole milliseconds, truncated toward zero.
		def milliseconds() int64 {
			return int64(self) / int64(1000000)
		}

		// Returns the span in seconds, with the fraction: `1500ms.seconds()`
		// is 1.5.
		def seconds() float {
			return durationIn(int64(self), int64(1000000000))
		}

		// Returns the span in minutes, with the fraction: `90s.minutes()` is 1.5.
		def minutes() float {
			return durationIn(int64(self), int64(60000000000))
		}

		// Returns the span in hours, with the fraction: `90m.hours()` is 1.5.
		def hours() float {
			return durationIn(int64(self), int64(3600000000000))
		}

		// Returns the span rounded toward zero to a multiple of unit:
		// `(1h15m30s).truncate(1m)` is `1h15m`. A unit of zero or less returns
		// the span unchanged.
		def truncate(unit duration) duration {
			let n = int64(self)
			let m = int64(unit)
			return self when m <= int64(0)
			return duration(n - n % m)
		}

		// Returns the span rounded to the nearest multiple of unit, halves away
		// from zero: `(1m30s).round(1m)` is `2m`. A result past the range of
		// duration is the largest or smallest duration; a unit of zero or less
		// returns the span unchanged.
		def round(unit duration) duration {
			let n = int64(self)
			let m = int64(unit)
			return self when m <= int64(0)
			let r = n % m
			if n < int64(0) {
				r = -r
				return duration(n + r) when uint64(r) + uint64(r) < uint64(m)
				let down = m - r
				return duration(-9223372036854775807 - 1) when n < -9223372036854775807 - 1 + down
				return duration(n - down)
			}
			return duration(n - r) when uint64(r) + uint64(r) < uint64(m)
			let up = m - r
			return duration(9223372036854775807) when n > 9223372036854775807 - up
			return duration(n + up)
		}

		// Returns the span without its sign. The smallest duration, which has
		// no positive counterpart, gives the largest.
		def abs() duration {
			let n = int64(self)
			return self when n >= int64(0)
			return duration(9223372036854775807) when n == -9223372036854775807 - 1
			return duration(-n)
		}

		// Returns the span multiplied by factor, for backoff and jitter:
		// `(200ms).scale(1.5)` is `300ms`. A result past the range of duration
		// is the largest or smallest duration; a NaN factor gives `0s`.
		def scale(factor float) duration {
			let v = float(int64(self)) * factor
			return 0s when v != v
			return duration(9223372036854775807) when v >= 9223372036854775807.0
			return duration(-9223372036854775807 - 1) when v <= -9223372036854775808.0
			return duration(int64(v))
		}
	}

	// ns in units of unit nanoseconds, split so the whole part keeps every
	// digit a float64 would lose on the raw count.
	internal def durationIn(ns int64, unit int64) float {
		return float(ns / unit) + float(ns % unit) / float(unit)
	}

	// `value` divided by 10^`digits`, written with its fraction when there is
	// one: 1500 and 3 give "1.5", 2000 and 3 give "2".
	internal def durationFraction(value uint64, digits int) string {
		let scale = uint64(1)
		for let i = 0; i < digits; i++ {
			scale *= uint64(10)
		}
		let whole = value / scale
		let rest = value % scale
		return "{whole}" when rest == uint64(0)
		let fraction = "{rest}".padStart(digits, "0").trimEnd("0")
		return "{whole}.{fraction}"
	}
}
