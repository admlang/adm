partial module prelude.tests {
	use std.testing

	check "duration" {
		// The forms Go's Duration.String gives, unit by unit.
		@test()
		def TestDurationStr() {
			assert duration(0).str() == "0s"
			assert duration(1).str() == "1ns"
			assert 999ns.str() == "999ns"
			assert 1500ns.str() == "1.5µs"
			assert 1us.str() == "1µs"
			assert 2250us.str() == "2.25ms"
			assert 100ms.str() == "100ms"
			assert 1s.str() == "1s"
			assert 1500ms.str() == "1.5s"
			assert duration(1000000001).str() == "1.000000001s"
			assert 60s.str() == "1m0s"
			assert 90s.str() == "1m30s"
			assert 1h.str() == "1h0m0s"
			assert (2h + 45m + 500ms).str() == "2h45m0.5s"
			assert 72h.str() == "72h0m0s"
			assert (-1500ms).str() == "-1.5s"
			assert (-3us).str() == "-3µs"
			assert duration(-9223372036854775807 - 1).str() == "-2562047h47m16.854775808s"
			assert duration(9223372036854775807).str() == "2562047h47m16.854775807s"
		}

		@test()
		def TestDurationUnits() {
			assert 1500ns.nanoseconds() == 1500
			assert 1999ns.microseconds() == 1
			assert (-1999ns).microseconds() == -1
			assert 2500us.milliseconds() == 2
			assert 1500ms.seconds() == 1.5
			assert 90s.minutes() == 1.5
			assert 90m.hours() == 1.5
			assert (-30m).hours() == -0.5
			assert duration(9223372036854775807).seconds() > 9223372036.0
		}

		@test()
		def TestDurationTruncateAndRound() {
			let d = 1h + 15m + 30s
			assert d.truncate(1m) == 1h + 15m
			assert d.round(1m) == 1h + 16m
			assert d.round(1h) == 1h
			assert (1m + 29s).round(1m) == 1m
			assert (-90s).round(1m) == -2m
			assert (-90s).truncate(1m) == -1m
			assert (-89s).round(1m) == -1m
			assert d.truncate(0s) == d
			assert d.round(-1s) == d
			assert duration(9223372036854775807).round(1h) == duration(9223372036854775807)
			assert duration(-9223372036854775807 - 1).round(1h) == duration(-9223372036854775807 - 1)
		}

		@test()
		def TestDurationAbsAndScale() {
			assert (-3s).abs() == 3s
			assert 3s.abs() == 3s
			assert duration(-9223372036854775807 - 1).abs() == duration(9223372036854775807)
			assert 200ms.scale(1.5) == 300ms
			assert 2s.scale(-0.5) == -1s
			assert 1h.scale(1e30) == duration(9223372036854775807)
			assert 1h.scale(-1e30) == duration(-9223372036854775807 - 1)
			assert 1s.scale(0.0 / 0.0) == 0s
		}

		// Interpolation writes a duration the same way.
		@test()
		def TestDurationInterpolation() {
			let d = 1m + 30s
			assert "{d}" == "1m30s"
			assert "took {250ms}" == "took 250ms"
		}
	}
}
