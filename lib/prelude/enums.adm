partial module builtin {
	// Enum is what every enum value and enum type has, whatever the enum.
	// The compiler provides these members; this declaration documents them
	// and gives tools a declaration to lead to. V is the enum's value type:
	// `int` unless the members are declared with strings.
	internal type Enum<V> {
		// The member's identifier, `Red` for `Color.Red`.
		name    string
		// The member's declared value, or its auto-incremented integer.
		value   V
		// The member's declaration index, from 0.
		ordinal int

		// str is the member's name.
		def str() string {
			// intrinsic
		}

		// keys is every member's name, in declaration order; on the type.
		def keys() string[] {
			// intrinsic
		}

		// values is every member's value, in declaration order; on the type.
		def values() V[] {
			// intrinsic
		}
	}
}
