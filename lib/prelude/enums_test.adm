partial module builtin {
	use std.testing

	enum TestColor {
		Red,
		Green
	}

	enum TestMode {
		On  = "on",
		Off = "off"
	}

	check "Enums" {
		// The members every enum has keep working beside the `Enum`
		// declaration that documents them.
		@test()
		def TestIntrinsicMembers() {
			let c = TestColor.Green
			assert c.name == "Green" && c.value == 1 && c.ordinal == 1 && c.str() == "Green"
			assert TestColor.keys().len() == 2 && TestColor.values()[1] == 1
			assert TestMode.Off.value == "off" && TestMode.values()[0] == "on"
			let b = 3 > 2
			assert b && "{b}" == "true"
		}
	}
}
