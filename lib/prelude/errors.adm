partial module builtin {
	use std.errors

	// error is the shape every error value has: a message, a code, an optional cause
	// and the stack trace of where it was raised.
	datatype error {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	// Error is the plain error value `fail` and `new Error` produce.
	struct Error {
		// Human-readable error message
		message string
		// Error code
		code    string
		// Optional underlying cause of this error
		cause   ?error
		// Stack trace. Depends on the build mode.
		// Production builds will not maintain stack traces
		stack   errors.StackTrace
	}
}
