partial module builtin {
	// The type of a `@fragment` function's uniform parameter.
	enum FragmentKind {
		Float32,
		Int32,
		Bool,
		Vec2,
		Vec3,
		Vec4,
	}

	// One uniform parameter of a `@fragment` function: every parameter after
	// the pixel position, in declaration order.
	struct FragmentParam {
		name   string
		kind   FragmentKind
		// Where the value starts in `Fragment.uniforms` order, in float32 slots
		// (Int32 and Bool take one slot holding the value, vectors take 2, 3 or 4).
		offset int
	}

	// A `@fragment` function compiled for every place it can run. The compiler
	// builds one when a `@fragment def` is used where a Fragment is expected.
	//
	// Positions are in the paint's space, at pixel centres; the result is
	// straight (not premultiplied) sRGB red, green, blue and alpha from 0 to 1.
	type Fragment {
		// The qualified ADM name of the function.
		name   string
		// The uniform parameters after the position.
		params FragmentParam[]
		// Float32 slots the uniforms take.
		size   int
		// GLSL 3.30 core source: `uniform` declarations named `adm_u_<param>`,
		// the helpers it calls, and `vec4 <entry>(vec2 p)`; no `main`.
		glsl   string
		// The GLSL function the paint calls.
		entry  string
		// A Vulkan fragment-stage module: entry point `main`, input
		// `layout(location = 0) vec2` position, output `layout(location = 0)
		// vec4`, uniforms in `layout(set = 0, binding = 0, std140)` in
		// parameter order. Empty when the compiler cannot make one.
		spirv  byte[]
		// Shades eight pixels along a row: lane i sits at (x + i·dx, y + i·dy);
		// then the uniforms, and the planar result (8 red, 8 green, 8 blue,
		// 8 alpha) written into out at `at`. Scalars, not vectors, cross the
		// call, since 256-bit vectors cannot pass between the x86-64-v3 and
		// baseline copies of a function.
		shade8 def(float32, float32, float32, float32, float32[], float32[], int) none

		def new(name string, params FragmentParam[], size int, glsl string, entry string, spirv byte[], shade8 def(float32, float32, float32, float32, float32[], float32[], int) none) {
			self.name = name
			self.params = params
			self.size = size
			self.glsl = glsl
			self.entry = entry
			self.spirv = spirv
			self.shade8 = shade8
		}

		// The parameter called name, if the function has one.
		def param(name string) ?FragmentParam {
			for let p in params {
				return p when p.name == name
			}
			return none
		}
	}
}
