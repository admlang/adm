partial module builtin {
	use std.io::(Writer)

	def print(args ...any) {
		// intrinsic
	}

	def fprint(writer Writer, args ...any) !int {
		// intrinsic
	}

	def sprint(args ...any) string {
		// intrinsic
	}

	def println(args ...any) {
		// intrinsic
	}

	def fprintln(writer Writer, args ...any) !int {
		// intrinsic
	}

	def sprintln(args ...any) string {
		// intrinsic
	}

	def printf(format string, args ...any) {
		// intrinsic
	}

	def fprintf(writer Writer, format string, args ...any) !int {
		// intrinsic
	}

	def sprintf(format string, args ...any) string {
		// intrinsic
	}

	@build("debug")
	def debug(value ...any) {
		print("debug:",)
		for let (_, v) in value {
			print(" ")
			if v is string {
				print(string(v))
			} else if v is bool {
				print(bool(v))
			} else if v is int {
				print(int(v))
			} else if v is int64 {
				print(int64(v))
			} else if v is uint {
				print(uint(v))
			} else if v is uint64 {
				print(uint64(v))
			} else if v is float32 {
				print(float32(v))
			} else if v is float64 {
				print(float64(v))
			} else {
				// Fallback: prints the dynamic type name for `any` values.
				print(v)
			}
		}
		println()
	}

	@build("release")
	def debug(value ...any) {
		// empty so debug prints nothing on release
	}

	@build("test")
	def debug(value ...any) {
		// empty so debug prints nothing on test
	}
}
