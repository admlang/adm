partial module builtin {
	use std.io::(Writer)

	// Prints the arguments to standard output.
	def print(args ...any) {
		// intrinsic
	}

	// Writes the arguments to writer and returns the number of bytes written. Fails when
	// the writer fails.
	def fprint(writer Writer, args ...any) !int {
		return try writer.write(joinArgs(args).bytes())
	}

	// The arguments as print writes them: each rendered like print renders it,
	// separated by single spaces.
	internal def joinArgs(args any[]) string {
		let text = ""
		for let (i, arg) in args {
			text += " " when i > 0
			text += stringOf(arg)
		}
		return text
	}

	// The arguments formatted as text.
	def sprint(args ...any) string {
		// intrinsic
	}

	// Prints the arguments to standard output followed by a newline.
	def println(args ...any) {
		// intrinsic
	}

	// Writes the arguments and a newline to writer and returns the number of bytes
	// written. Fails when the writer fails.
	def fprintln(writer Writer, args ...any) !int {
		return try writer.write((joinArgs(args) + "\n").bytes())
	}

	// The arguments formatted as text with a trailing newline.
	def sprintln(args ...any) string {
		// intrinsic
	}

	// Prints the arguments laid out by a printf-style format; the verbs are those of
	// `string.format`.
	def printf(format string, args ...any) {
		print(format.format(...args))
	}

	// Writes the arguments laid out by a printf-style format to writer and returns the
	// number of bytes written. Fails when the writer fails. The verbs are those of
	// `string.format`.
	def fprintf(writer Writer, format string, args ...any) !int {
		return try writer.write(format.format(...args).bytes())
	}

	// The arguments laid out by a printf-style format, as text; the verbs are those of
	// `string.format`.
	def sprintf(format string, args ...any) string {
		return format.format(...args)
	}

	// Prints the values on a debug build; a release build drops the call.
	@build("debug")
	def debug(value ...any) {
		print("debug:",)
		for let (_, v) in value {
			print(" ")
			if v is string {
				print(string(v))
			} else if v is bool {
				print(bool(v))
			} else if v is int {
				print(int(v))
			} else if v is int64 {
				print(int64(v))
			} else if v is uint {
				print(uint(v))
			} else if v is uint64 {
				print(uint64(v))
			} else if v is float32 {
				print(float32(v))
			} else if v is float64 {
				print(float64(v))
			} else {
				// Fallback: prints the dynamic type name for `any` values.
				print(v)
			}
		}
		println()
	}

	@build("release")
	def debug(value ...any) {
		// empty so debug prints nothing on release
	}

	@build("test")
	def debug(value ...any) {
		// empty so debug prints nothing on test
	}
}
