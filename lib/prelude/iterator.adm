partial module builtin {
	// Iterator produces a sequence of values, one call at a time.
	//
	// Any type implementing it can be iterated with `for`:
	//
	//     for let x in value { ... }
	//
	// The loop calls `iterate()` repeatedly and ends at the first `none`.
	// Implementers keep their own cursor and must reset it after returning
	// `none`, so the value can be iterated again later; iterating the same
	// value from two loops at once is not supported.
	interface Iterator<T> {
		// Returns the next value in the sequence, or `none` when exhausted.
		def iterate() ?T
	}
}
