partial module builtin {
	@c("adm_runtime.h", symbol = "adm_hash_seed", ret = "uint64_t", params = [])
	internal def __hash_seed() uint64;

	@c("adm_runtime.h", symbol = "adm_hash_word", ret = "uint64_t", params = ["uint64_t", "uint64_t"])
	internal def __hash_word(value uint64, seed uint64) uint64;

	@c("adm_runtime.h", symbol = "adm_hash_string", ret = "uint64_t", params = ["const char*", "uint64_t"])
	internal def __hash_string(value string, seed uint64) uint64;

	@c("adm_runtime.h", symbol = "adm_hash_float", ret = "uint64_t", params = ["double", "uint64_t"])
	internal def __hash_float(value float64, seed uint64) uint64;

	@c("adm_runtime.h", symbol = "adm_hash_bytes", ret = "uint64_t", params = ["const void*", "size_t", "uint64_t"])
	internal def __hash_bytes(value byte[], n uint, seed uint64) uint64;

	// KeyHasher builds the number a type's `hash()` returns, for a type that
	// is a map key by its own `hash()` and `equals()`. Add every value
	// `equals()` compares, in one fixed order, then take `sum()`: instances
	// that are equal must add equal values. The result differs between runs
	// of a program, so it is not a value to store or send.
	//
	// Example: A key that ignores the case of its text
	// ```example
	// type Tag {
	//     text string
	//     kind int
	//
	//     def hash() uint64 {
	//         return new KeyHasher().add(text.lower()).add(kind).sum()
	//     }
	//
	//     def equals(other Tag) bool {
	//         return kind == other.kind && text.lower() == other.text.lower()
	//     }
	// }
	// ```
	type KeyHasher {
		internal state uint64

		def new() {
			state = __hash_seed()
		}

		// Adds an integer.
		def add(value int) KeyHasher {
			state = __hash_word(uint64(value), state)
			return self
		}

		// Adds a string's content.
		def add(value string) KeyHasher {
			state = __hash_string(value, state)
			return self
		}

		// Adds a float. 0.0 and -0.0, which are equal, add the same.
		def add(value float) KeyHasher {
			state = __hash_float(float64(value), state)
			return self
		}

		// Adds a bool.
		def add(value bool) KeyHasher {
			state = __hash_word(value ?? (1, 0), state)
			return self
		}

		// Adds a char.
		def add(value char) KeyHasher {
			state = __hash_word(uint64(value), state)
			return self
		}

		// Adds the bytes and their count.
		def add(value byte[]) KeyHasher {
			state = __hash_bytes(value, uint(value.len()), state)
			return self
		}

		// The hash of what was added so far.
		def sum() uint64 {
			return state
		}
	}
}
