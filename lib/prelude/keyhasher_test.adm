partial module prelude.tests {
	use std.testing

	internal type KeyHasherTestTag {
		text string
		kind int

		def new(text string, kind int) {
			self.text = text
			self.kind = kind
		}

		def hash() uint64 {
			return new KeyHasher().add(text.lower()).add(kind).sum()
		}

		def equals(other KeyHasherTestTag) bool {
			return kind == other.kind && text.lower() == other.text.lower()
		}
	}

	check "KeyHasher" {
		@test()
		def equalValuesHashAlike() {
			let a = new KeyHasher().add(1).add("x").add(1.5).add(true).add('c').add(byte[1, 2, 3]).sum()
			let b = new KeyHasher().add(1).add("x").add(1.5).add(true).add('c').add(byte[1, 2, 3]).sum()
			assert a == b
			assert new KeyHasher().add(0.0).sum() == new KeyHasher().add(-0.0).sum()
		}

		@test()
		def valuesAndOrderMatter() {
			assert new KeyHasher().add("x").sum() != new KeyHasher().add("y").sum()
			assert new KeyHasher().add(1).add(2).sum() != new KeyHasher().add(2).add(1).sum()
			assert new KeyHasher().add(byte[1, 2]).sum() != new KeyHasher().add(byte[1, 2, 0]).sum()
		}

		@test()
		def keysATypeByItsMethods() {
			let m = map<KeyHasherTestTag, int>{}
			m.set(new KeyHasherTestTag("Tea", 1), 1)
			m.set(new KeyHasherTestTag("TEA", 1), 2)
			m.set(new KeyHasherTestTag("tea", 2), 3)
			assert m.len() == 2
			assert m.hasKey(new KeyHasherTestTag("tEa", 1))
		}
	}
}
