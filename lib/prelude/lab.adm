partial module builtin {
	// One condition of a service's lab: what the calls of `method` (every
	// method when empty) meet.
	internal struct LabRule {
		method  string
		delay   duration = 0s
		jitter  duration = 0s
		// The failure the call ends with; empty when the rule only delays.
		message string   = ""
		// The share of the calls that fail, and how many more may (-1: any number).
		rate    float    = 1.0
		left    int      = -1
	}

	// What a lab decided for one call.
	internal struct LabVerdict {
		wait    duration = 0s
		message string   = ""
	}

	// The conditions of a service that declares none.
	struct NoConditions {}

	// ServiceLab is the test bench of one service, reached as `Storage.lab`: it
	// sets the conditions the service's `@commit` and `@query` calls meet, so a
	// program can be watched under a slow, failing or absent service.
	//
	//     Storage.lab.delay(150ms)
	//     Storage.lab.refuse("disk full", method = "write")
	//     Network.lab.offline()
	//     Storage.lab.reset()
	//
	// A delay holds the calling task before the method runs. A refusal ends the
	// call with an error before the method runs, on methods that can fail; a
	// method that cannot fail is only delayed. Conditions stay until `reset`.
	//
	// What only the service can simulate is in `conditions`, a struct the
	// service declares with its lab and reads in its own code:
	//
	//     service Storage {
	//         lab = new ServiceLab<StorageConditions>()
	//         ...
	//     }
	//
	//     Storage.lab.conditions.diskFull = 0.85
	//
	// The conditions start as the struct's own defaults, which mean "nothing
	// simulated", and `reset` puts them back.
	//
	// Only a test build (`adm test`) and a build the IDE runs have labs
	// (`__labs__`): in any other the services run no lab check, and setting a
	// rule there stops the program with a message. Outside its service a lab
	// is named only in a test file.
	//
	// The lab's methods can be called from any task at any time, and
	// `conditions` hands each reader the conditions under the lab's lock, so
	// a call reading them keeps what it read when `reset` replaces them. Their
	// fields are an object's like any other: set them while no other task is
	// calling the service, as with any object two tasks share.
	type ServiceLab<T> {
		// What only the service can simulate, as the service declares it.
		conditions T {
			def get() T {
				return current unless __labs__
				return held()
			}

			atomic def set(next T) {
				current = next
			}
		}

		// The conditions `conditions` reads and writes.
		internal current T
		internal rules   LabRule[]        = []
		internal down    bool             = false
		internal seen    map<string, int> = map<string, int>{}
		internal random  int              = 20261011

		def new() {}

		// Holds every call of `method` (of every method when empty) for `by`,
		// plus up to `jitter` more.
		atomic def delay(by duration, method string = "", jitter duration = 0s) {
			__lab_needs_checks()
			rules.push(LabRule{method: method, delay: by, jitter: jitter})
			__lab_on = true
		}

		// Makes calls of `method` (of every method when empty) fail with
		// `message`: the share `rate` of them, and no more than `times` when
		// that is above zero.
		atomic def refuse(message string, method string = "", rate float = 1.0, times int = 0) {
			__lab_needs_checks()
			let left = -1
			left = times when times > 0
			rules.push(LabRule{method: method, message: message, rate: rate, left: left})
			__lab_on = true
		}

		// Makes every call that can fail do so, as if the service were not there.
		atomic def offline() {
			__lab_needs_checks()
			down = true
			__lab_on = true
		}

		// Ends `offline`.
		atomic def online() {
			down = false
		}

		// Removes every condition, the service's own back to their defaults, and
		// forgets the calls counted.
		atomic def reset() {
			let fresh T
			current = fresh
			rules = []
			down = false
			seen = map<string, int>{}
			random = 20261011
		}

		// The conditions as a new lab holds them, which `reset` puts back.
		def defaults() any {
			let fresh T
			return fresh
		}

		// The calls of `method` (of every method when empty) made since the
		// lab's first condition or the last `reset`.
		atomic def calls(method string = "") int {
			return count(method)
		}

		// True for the share `rate` of the times it is asked, drawn from the
		// lab's own sequence: for a service whose condition is "one read in ten".
		// Always false in a build without labs.
		def chance(rate float) bool {
			return false when !__labs__ || rate <= 0.0
			return true when rate >= 1.0
			return drawBelow(rate)
		}

		// What a call of `method` meets, for a method that can fail: the call is
		// counted, held, and failed as the conditions say. Written by the
		// compiler at the start of each `@commit` and `@query` method.
		def meet(method string) !none {
			let verdict = decide(method)
			__time_sleep(verdict.wait) when verdict.wait > 0s
			fail verdict.message when verdict.message != ""
			return none
		}

		// The same for a method that cannot fail: the call is counted and held.
		def hold(method string) {
			let verdict = decide(method)
			__time_sleep(verdict.wait) when verdict.wait > 0s
		}

		// Counts the call and gives what it meets.
		internal atomic def decide(method string) LabVerdict {
			seen[method] = count(method) + 1
			seen[""] = count("") + 1
			let verdict = LabVerdict{}
			verdict.message = "the service is offline (lab)" when down
			for let i = 0; i < rules.len(); i++ {
				let rule = rules[i]
				continue unless rule.method == "" || rule.method == method
				verdict.wait += rule.delay
				verdict.wait += duration(int64(float(int64(rule.jitter)) * draw())) when rule.jitter > 0s
				continue when rule.message == "" || verdict.message != "" || rule.left == 0
				continue when rule.rate < 1.0 && draw() >= rule.rate
				rule.left -= 1 when rule.left > 0
				verdict.message = rule.message
			}
			return verdict
		}

		internal def count(method string) int {
			return 0 unless seen.hasKey(method)
			return seen[method]
		}

		// The conditions as they stand, taken with the lab's lock held.
		internal atomic def held() T {
			return current
		}

		// Whether the next number of the lab's sequence is below rate.
		internal atomic def drawBelow(rate float) bool {
			return draw() < rate
		}

		// The next number in [0, 1) of the lab's own sequence, the same on every
		// run so a test that refuses "one call in five" refuses the same calls.
		internal def draw() float {
			random = (random * 1103515245 + 12345) % 2147483648
			return float(random) / 2147483648.0
		}
	}

	// The labs of the services that declare none, one per service asked for.
	internal type LabRegistry {
		internal owners service[]                  = []
		internal labs   ServiceLab<NoConditions>[] = []

		def new() {}

		atomic def of(owner service) ServiceLab<NoConditions> {
			for let i = 0; i < owners.len(); i++ {
				return labs[i] when owners[i] == owner
			}
			let made = new ServiceLab<NoConditions>()
			owners.push(owner)
			labs.push(made)
			return made
		}
	}

	internal let __labs = new LabRegistry()

	// False until some lab is given a condition. A `@commit` or `@query` method
	// starts with `if __lab_on { try self.lab.meet("<method>") }`, written there
	// by the compiler: until then a service call reads this and goes on.
	internal let __lab_on = false

	// Stops a build without labs that sets a lab rule: nothing there would
	// apply it.
	internal def __lab_needs_checks() {
		__panic("service labs are part of test builds and of the programs the IDE runs: use Service.lab in `adm test`") unless __labs__
	}
}
