partial module builtin {
	// Serializable is what a map key must be: a value that turns into bytes, which
	// the map hashes and compares.
	interface Serializable {
		def serialize() byte[]
	}

	// Keys are constrained to `Serializable` for now: the runtime hashes and
	// compares a key by its serialized bytes. This is a placeholder for a
	// hashing/equality concept (`hash()` + `equals()`), which will replace the
	// constraint so keys need not be encodable.
	@builtin(primitive = "map")
	type map<K: Serializable, V> {
		// Creates an empty map. `map<K, V>{}` and the literal form `map<K, V>{k: v, ...}` are the usual spellings.
		def new() {
			// intrinsic
		}

		// Returns every key as a new array. Iteration order is unspecified.
		def keys() K[] {
			// intrinsic: lowered by the compiler/runtime (`__map_keys`)
		}

		// Returns every value as a new array, in the same order `keys()` uses.
		def values() V[] {
			// intrinsic: lowered by the compiler/runtime (`__map_values`)
		}

		// Reports whether `key` is present.
		def hasKey(key K) bool {
			// intrinsic: lowered by the compiler/runtime (`__map_has`)
		}

		// Reports whether at least one entry holds `val`, compared with `==`. Walks the whole map.
		def hasValue(val V) bool {
			for let (k, v) in self {
				if v == val {
					return true
				}
			}
			return false
		}

		// Returns the key of the first entry whose value equals `val`, or `none` when no entry does.
		// When several keys hold the same value, which one is returned is unspecified.
		def keyOf(val V) ?K {
			for let (k, v) in self {
				if v == val {
					return k
				}
			}
			return none
		}

		// Returns the value stored under `key`, or `none` when the key is absent. Same as `get`.
		def valueOf(key K) ?V {
			// intrinsic: lowered by the compiler/runtime (`__map_get`)
		}

		// Returns a shallow copy: a new map with the same entries. Values are not cloned, so a copied
		// reference still points at the shared object; writes to the copy never touch the original.
		def clone() map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v
			}
			return tmp
		}

		// Returns a new map without the entries whose key is in `keys`. Keys that are not present are
		// ignored. The receiver is unchanged.
		def omitKeys(keys K[]) map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v unless keys.includes(k)
			}
			return tmp
		}

		// Returns a new map without the entries whose key makes `predicate` return true. The receiver is
		// unchanged.
		def omitKeys(predicate def (K) bool) map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v unless predicate(k)
			}
			return tmp
		}

		// Returns a new map without the entries whose value is in `values`, compared with `==`. The
		// receiver is unchanged.
		def omitValues(values V[]) map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v unless values.includes(v)
			}
			return tmp
		}

		// Returns a new map without the entries for which `predicate(key, value)` returns true. The
		// receiver is unchanged.
		def omitValues(predicate def (K, V) bool) map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v unless predicate(k, v)
			}
			return tmp
		}

		// Returns a new map holding only the entries whose key is in `keys`. Keys that are not present
		// are ignored, so the result can be smaller than `keys`. The receiver is unchanged.
		def pickKeys(keys K[]) map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v when keys.includes(k)
			}
			return tmp
		}

		// Returns a new map holding only the entries whose key makes `predicate` return true. The
		// receiver is unchanged.
		def pickKeys(predicate def (K) bool) map<K, V> {
			let out = new map<K, V>{}
			for let (k, v) in self {
				if predicate(k) {
					out[k] = v
				}
			}
			return out
		}

		// Returns a new map holding only the entries whose value is in `values`, compared with `==`. The
		// receiver is unchanged.
		def pickValues(values V[]) map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v when values.includes(v)
			}
			return tmp
		}

		// Returns a new map holding only the entries whose value makes `predicate` return true. The
		// receiver is unchanged.
		def pickValues(predicate def (V) bool) map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v when predicate(v)
			}
			return tmp
		}

		// Calls `predicate(key, value, self)` for every entry and returns a new map holding the entries
		// for which it returned true. The third argument is the map being walked, so the predicate can
		// look up other entries. The receiver is unchanged.
		def each(predicate def (K, V, map<K, V>) bool) map<K, V> {
			let tmp = new map<K, V>{}
			for let (k, v) in self {
				tmp[k] = v when predicate(k, v, self)
			}
			return tmp
		}

		// Copies every entry of `other` into this map, overwriting entries that share a key, and returns
		// this map. Mutates the receiver; use `clone().merge(other)` to keep it intact.
		def merge(other map<K, V>) map<K, V> {
			for let (k, v) in other {
				set(k, v)
			}
			return self
		}

		// Stores `value` under `key`, replacing any existing entry, and returns this map. Same as
		// `m[key] = value`.
		def set(key K, value V) map<K, V> {
			// intrinsic: lowered by the compiler/runtime (`__map_set`)
		}

		// Returns the value stored under `key`, or `none` when the key is absent. `m[key]` reads the value
		// directly when the key is known to be present.
		def get(key K) ?V {
			// intrinsic: lowered by the compiler/runtime (`__map_get`)
		}

		// Removes the entry under `key`, if any, and returns this map. Deleting an absent key is not an
		// error.
		def delete(key K) map<K, V> {
			// intrinsic: lowered by the compiler/runtime (`__map_delete`)
		}

		// Returns the keys of `other` that this map does not have.
		def missingKeys(other map<K, V>) K[] {
			let keys = []
			for let (k, _) in other {
				keys.push(k) unless hasKey(k)
			}
			return keys
		}

		// Returns the keys of `other` whose value differs from this map's value under the same key,
		// compared with `==`. Keys this map lacks are included; keys only this map has are not.
		def diffKeys(other map<K, V>) K[] {
			let keys = []
			for let (k, v) in other {
				let sv = get(k)
				match sv {
					case V:
						keys.push(k) when sv != v
					case none: keys.push(k)
				}
			}
			return keys
		}

		// Returns the number of entries.
		def len() int {
			// intrinsic: lowered by the compiler/runtime (`__map_len`)
		}

		// Formats the map as `{k: v, k: v, }` using `sprint` for keys and values. Entry order matches
		// `keys()`. An empty map formats as `{}`.
		def str() string {
			let tmp = ""
			for let (k, v) in self {
				tmp += sprint(k) + ": " + sprint(v) + ", "
			}
			return "\{" + tmp + "}"
		}

		// Merges `other` into this map, and returns a copy
		infix def + (other map<K, V>) map<K, V> {
			return clone().merge(other)
		}
	}
}
