partial module builtin {
	use std.testing

	internal def sortedKeys(keys string[]) string[] {
		return keys.sort(def (i, j string) bool {return i < j})
	}

	check "Maps" {
		@test()
		def literalAndLen() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			assert m.len() == 3
			assert map<string, int>{}.len() == 0
		}

		@test()
		def setGetDelete() !none {
			let m = map<string, int>{}
			m.set("a", 1)
			m.set("b", 2)
			assert m.len() == 2

			let a = m.get("a")
			fail "expected a" when a is none
			assert a == 1

			m.set("a", 10)
			assert m.len() == 2
			let a2 = m.get("a")
			fail "expected a after overwrite" when a2 is none
			assert a2 == 10

			assert m.get("absent") is none

			m.delete("a")
			assert m.len() == 1
			assert !m.hasKey("a")
			assert m.get("a") is none

			m.delete("absent")
			assert m.len() == 1
		}

		@test()
		def indexAccess() !none {
			let m = map<string, int>{}
			m["x"] = 5
			assert m.len() == 1
			assert m["x"] == 5
			m["x"] = 6
			assert m["x"] == 6
		}

		@test()
		def hasKeyAndHasValue() !none {
			let m = map<string, int>{"a": 1, "b": 2}
			assert m.hasKey("a")
			assert m.hasKey("b")
			assert !m.hasKey("c")

			assert m.hasValue(1)
			assert m.hasValue(2)
			assert !m.hasValue(3)
			assert !map<string, int>{}.hasValue(1)
		}

		@test()
		def keyOfAndValueOf() !none {
			let m = map<string, int>{"a": 1, "b": 2}

			let k = m.keyOf(2)
			fail "expected key for 2" when k is none
			assert k == "b"
			assert m.keyOf(3) is none

			let v = m.valueOf("a")
			fail "expected value for a" when v is none
			assert v == 1
			assert m.valueOf("c") is none
		}

		@test()
		def keysAndValues() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}

			let keys = sortedKeys(m.keys())
			assert keys.len() == 3
			assert keys[0] == "a"
			assert keys[1] == "b"
			assert keys[2] == "c"

			let values = m.values().sort(def (i, j int) bool {return i < j})
			assert values.len() == 3
			assert values[0] == 1
			assert values[1] == 2
			assert values[2] == 3

			assert map<string, int>{}.keys().len() == 0
			assert map<string, int>{}.values().len() == 0
		}

		@test()
		def iteration() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let total = 0
			let count = 0
			for let (k, v) in m {
				assert m.hasKey(k)
				total += v
				count += 1
			}
			assert count == 3
			assert total == 6
		}

		@test()
		def cloneIsIndependent() !none {
			let m = map<string, int>{"a": 1, "b": 2}
			let c = m.clone()
			assert c.len() == 2
			assert c["a"] == 1
			assert c["b"] == 2

			c.set("c", 3)
			c.set("a", 100)
			assert m.len() == 2
			assert m["a"] == 1
			assert !m.hasKey("c")

			assert map<string, int>{}.clone().len() == 0
		}

		@test()
		def omitKeysByList() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let r = m.omitKeys(["a", "c", "zzz"])
			assert r.len() == 1
			assert r.hasKey("b")
			assert !r.hasKey("a")
			assert !r.hasKey("c")
			assert m.len() == 3

			assert m.omitKeys([]).len() == 3
		}

		@test()
		def omitKeysByPredicate() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let r = m.omitKeys(def (k string) bool {return k == "b"})
			assert r.len() == 2
			assert r.hasKey("a")
			assert !r.hasKey("b")
			assert r.hasKey("c")
			assert m.len() == 3
		}

		@test()
		def omitValuesByList() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 2}
			let r = m.omitValues([2, 99])
			assert r.len() == 1
			assert r.hasKey("a")
			assert m.len() == 3

			assert m.omitValues([]).len() == 3
		}

		@test()
		def omitValuesByPredicate() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let r = m.omitValues(def (k string, v int) bool {return v > 1})
			assert r.len() == 1
			assert r.hasKey("a")
			assert m.len() == 3
		}

		@test()
		def pickKeysByList() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let r = m.pickKeys(["a", "c", "zzz"])
			assert r.len() == 2
			assert r["a"] == 1
			assert r["c"] == 3
			assert !r.hasKey("b")
			assert m.len() == 3

			assert m.pickKeys([]).len() == 0
		}

		@test()
		def pickKeysByPredicate() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let r = m.pickKeys(def (k string) bool {return k != "b"})
			assert r.len() == 2
			assert r["a"] == 1
			assert r["c"] == 3
			assert m.len() == 3
		}

		@test()
		def pickValuesByList() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 2}
			let r = m.pickValues([2, 99])
			assert r.len() == 2
			assert r["b"] == 2
			assert r["c"] == 2
			assert !r.hasKey("a")
			assert m.len() == 3

			assert m.pickValues([]).len() == 0
		}

		@test()
		def pickValuesByPredicate() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let r = m.pickValues(def (v int) bool {return v >= 2})
			assert r.len() == 2
			assert r["b"] == 2
			assert r["c"] == 3
			assert m.len() == 3
		}

		@test()
		def eachFiltersWithKeyValueAndMap() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let r = m.each(def (k string, v int, src map<string, int>) bool {
				assert src.len() == 3
				assert src[k] == v
				return k != "b"
			})
			assert r.len() == 2
			assert r["a"] == 1
			assert r["c"] == 3
			assert m.len() == 3
		}

		@test()
		def mergeMutatesReceiver() !none {
			let m = map<string, int>{"a": 1, "b": 2}
			let other = map<string, int>{"b": 20, "c": 30}
			let r = m.merge(other)
			assert m.len() == 3
			assert m["a"] == 1
			assert m["b"] == 20
			assert m["c"] == 30
			assert r.len() == 3
			assert other.len() == 2

			assert m.merge(map<string, int>{}).len() == 3
		}

		@test()
		def plusMerges() !none {
			let m = map<string, int>{"a": 1}
			let r = m + map<string, int>{"b": 2}
			assert r.len() == 2
			assert r["a"] == 1
			assert r["b"] == 2
		}

		@test()
		def missingKeys() !none {
			let m = map<string, int>{"a": 1, "b": 2}
			let other = map<string, int>{"b": 2, "c": 3, "d": 4}
			let missing = sortedKeys(m.missingKeys(other))
			assert missing.len() == 2
			assert missing[0] == "c"
			assert missing[1] == "d"

			assert m.missingKeys(map<string, int>{}).len() == 0
			assert m.missingKeys(m).len() == 0
			assert map<string, int>{}.missingKeys(other).len() == 3
		}

		@test()
		def diffKeys() !none {
			let m = map<string, int>{"a": 1, "b": 2, "c": 3}
			let other = map<string, int>{"a": 1, "b": 20, "d": 4}
			let diff = sortedKeys(m.diffKeys(other))
			assert diff.len() == 2
			assert diff[0] == "b"
			assert diff[1] == "d"

			assert m.diffKeys(m).len() == 0
			assert m.diffKeys(map<string, int>{}).len() == 0
			assert map<string, int>{}.diffKeys(other).len() == 3
		}

		@test()
		def str() !none {
			assert map<string, int>{}.str() == "\{}"
			assert map<string, int>{"a": 1}.str() == "\{a: 1, }"

			let s = map<string, int>{"a": 1, "b": 2}.str()
			assert s.startsWith("\{")
			assert s.endsWith(", }")
			assert s.contains("a: 1, ")
			assert s.contains("b: 2, ")
		}

		@test()
		def intKeys() !none {
			let m = map<int, string>{1: "one", 2: "two"}
			assert m.len() == 2
			assert m[1] == "one"
			assert m.hasKey(2)
			assert !m.hasKey(3)
			let k = m.keyOf("two")
			fail "expected key for two" when k is none
			assert k == 2
		}
	}
}
