partial module builtin {
	// A matrix is a rectangular grid of numbers stored as one flat row-major
	// array (spec §4.2). `matrix<T, R, C>` fixes the shape at compile time;
	// the compiler checks it and stores the value as this type.
	type matrix<T: SimdNumeric> {
		// The cells, row after row. For the compiler and runtime only.
		internal cells T[] = []
		// The shape. For the compiler and runtime only.
		internal nrows int = 0
		internal ncols int = 0

		// An empty 0×0 matrix.
		def new() {}

		// A rows×cols matrix over the given cells, row-major; the compiler
		// builds literals with it.
		internal def new(rows int, cols int, values T[]) {
			nrows = rows
			ncols = cols
			cells = values
		}

		// The number of rows.
		rows int {
			def get() int { return nrows }
		}

		// The number of columns.
		cols int {
			def get() int { return ncols }
		}

		// Reshapes the matrix to rows×cols and returns it: the cells that fit
		// in the top-left corner are kept and new cells are zero.
		@mutates
		def size(rows int, cols int) matrix<T> {
			if rows == nrows && cols == ncols {
				return self
			}
			let next T[]
			next.len(rows * cols)
			let keepRows = rows.min(nrows)
			let keepCols = cols.min(ncols)
			for let r = 0; r < keepRows; r++ {
				for let c = 0; c < keepCols; c++ {
					next[r * cols + c] = cells[r * ncols + c]
				}
			}
			cells = next
			nrows = rows
			ncols = cols
			return self
		}

		// The shape as (rows, cols).
		def size() (int, int) {
			return (nrows, ncols)
		}

		// The whole storage as a flat row-major array, sharing the cells.
		def data() T[] {
			return cells
		}

		// Row r as a view of the matrix's cells.
		def row(r int) T[] {
			return cells[r * ncols:(r + 1) * ncols]
		}

		// Column c, copied.
		def col(c int) T[] {
			let out T[]
			out.len(nrows)
			for let r = 0; r < nrows; r++ {
				out[r] = cells[r * ncols + c]
			}
			return out
		}

		// The h×w block whose top-left cell is (r, c), copied.
		def block(r int, c int, h int, w int) matrix<T> {
			let out T[]
			out.len(h * w)
			for let i = 0; i < h; i++ {
				for let j = 0; j < w; j++ {
					out[i * w + j] = cells[(r + i) * ncols + c + j]
				}
			}
			return new matrix<T>(h, w, out)
		}

		// A copy with its own cells.
		def clone() matrix<T> {
			return new matrix<T>(nrows, ncols, cells.clone())
		}

		// The rows as arrays, copied.
		def array() T[][] {
			let out T[][]
			for let r = 0; r < nrows; r++ {
				out.push(cells[r * ncols:(r + 1) * ncols].clone())
			}
			return out
		}

		// Sets every cell to v and returns the matrix.
		@mutates
		def fill(v T) matrix<T> {
			cells.fill(v)
			return self
		}

		// A matrix of the same shape holding f of each cell.
		def map(f def (T) T) matrix<T> {
			let out T[]
			out.len(cells.len())
			for let i = 0; i < cells.len(); i++ {
				out[i] = f(cells[i])
			}
			return new matrix<T>(nrows, ncols, out)
		}

		// The transpose: cols×rows.
		def transpose() matrix<T> {
			let out T[]
			out.len(cells.len())
			for let r = 0; r < nrows; r++ {
				for let c = 0; c < ncols; c++ {
					out[c * nrows + r] = cells[r * ncols + c]
				}
			}
			return new matrix<T>(ncols, nrows, out)
		}

		// Whether the shapes and every cell are equal.
		def equals(other matrix<T>) bool {
			return nrows == other.nrows && ncols == other.ncols && cells.equals(other.cells)
		}

		internal def sameShape(other matrix<T>, op string) {
			if nrows != other.nrows || ncols != other.ncols {
				__panic("matrix {op}: shapes {nrows}×{ncols} and {other.nrows}×{other.ncols} differ")
			}
		}

		// Element-wise sum; the shapes must match.
		infix def + (other matrix<T>) matrix<T> {
			sameShape(other, "+")
			return new matrix<T>(nrows, ncols, matrixZip(cells, other.cells, 0))
		}

		// Element-wise difference; the shapes must match.
		infix def - (other matrix<T>) matrix<T> {
			sameShape(other, "-")
			return new matrix<T>(nrows, ncols, matrixZip(cells, other.cells, 1))
		}

		// Element-wise product (`.*`); the shapes must match.
		def hadamard(other matrix<T>) matrix<T> {
			sameShape(other, ".*")
			return new matrix<T>(nrows, ncols, matrixZip(cells, other.cells, 2))
		}

		// Element-wise product; the shapes must match.
		infix def .* (other matrix<T>) matrix<T> {
			return hadamard(other)
		}

		// Every cell multiplied by k (`k * m`, `m * k`).
		def scale(k T) matrix<T> {
			return new matrix<T>(nrows, ncols, matrixScale(cells, k))
		}

		// Every cell divided by k (`m / k`).
		def divide(k T) matrix<T> {
			let out T[]
			out.len(cells.len())
			for let i = 0; i < cells.len(); i++ {
				out[i] = cells[i] / k
			}
			return new matrix<T>(nrows, ncols, out)
		}

		// Rows a..b-1 as a matrix sharing these cells (`m[a:b]`).
		def rowRange(a int, b int) matrix<T> {
			return new matrix<T>(b - a, ncols, cells[a * ncols:b * ncols])
		}

		// The matrix product: self.cols must equal other.rows.
		infix def * (other matrix<T>) matrix<T> {
			if ncols != other.nrows {
				__panic("matrix *: {nrows}×{ncols} times {other.nrows}×{other.ncols}: the columns of the left must equal the rows of the right")
			}
			return new matrix<T>(nrows, other.ncols, matrixMultiply(cells, other.cells, nrows, ncols, other.ncols))
		}

		// The matrix–vector product: v has cols elements, the result rows.
		infix def * (v T[]) T[] {
			if v.len() != ncols {
				__panic("matrix *: {nrows}×{ncols} times a vector of {v.len()}: the vector must have {ncols} elements")
			}
			return matrixMultiply(cells, v, nrows, ncols, 1)
		}
	}

	// Element-wise a op b over equal lengths: 0 add, 1 subtract, 2 multiply.
	internal def matrixZip<T: SimdNumeric>(a T[], b T[], op int) T[] {
		let n = a.len()
		let out T[]
		out.len(n)
		let i = 0
		let v vec8<T>
		for ; i + 8 <= n; i += 8 {
			let x = v.load(a, i)
			let y = v.load(b, i)
			let z = op == 0 ?? (x + y, op == 1 ?? (x - y, x * y))
			z.store(out, i)
		}
		for ; i < n; i++ {
			out[i] = op == 0 ?? (a[i] + b[i], op == 1 ?? (a[i] - b[i], a[i] * b[i]))
		}
		return out
	}

	// Every element of a multiplied by k.
	internal def matrixScale<T: SimdNumeric>(a T[], k T) T[] {
		let n = a.len()
		let out T[]
		out.len(n)
		let v vec8<T>
		let kv = v.splat(k)
		let i = 0
		for ; i + 8 <= n; i += 8 {
			(v.load(a, i) * kv).store(out, i)
		}
		for ; i < n; i++ {
			out[i] = a[i] * k
		}
		return out
	}

	// Rows of the left matrix one task computes, above which the product
	// splits into bands.
	internal const matrixBandRows = 64

	// The product of an n×k and a k×m row-major matrix, n×m. Rows go in bands
	// on tasks once the work is large; each output row is computed by one
	// task in a fixed order, so the result never depends on timing.
	internal def matrixMultiply<T: SimdNumeric>(a T[], b T[], n int, k int, m int) T[] {
		let out T[]
		out.len(n * m)
		if n * k * m < 1 << 18 || n <= matrixBandRows {
			matrixMultiplyRows(a, b, out, 0, n, k, m)
			return out
		}
		let bands array<async none> = []
		for let r = 0; r < n; r += matrixBandRows {
			bands.push(matrixMultiplyBand(a, b, out, r, (r + matrixBandRows).min(n), k, m))
		}
		for let t in bands {
			await t
		}
		return out
	}

	internal async def matrixMultiplyBand<T: SimdNumeric>(a T[], b T[], out T[], r0 int, r1 int, k int, m int) async none {
		matrixMultiplyRows(a, b, out, r0, r1, k, m)
		return none
	}

	// Rows r0..r1 of the product, i-k-j order: each left cell scales a row of
	// the right matrix into the output row, 8 lanes at a time.
	internal def matrixMultiplyRows<T: SimdNumeric>(a T[], b T[], out T[], r0 int, r1 int, k int, m int) {
		let v vec8<T>
		for let i = r0; i < r1; i++ {
			let o = i * m
			for let p = 0; p < k; p++ {
				let x = a[i * k + p]
				let xv = v.splat(x)
				let bo = p * m
				let j = 0
				for ; j + 8 <= m; j += 8 {
					(v.load(out, o + j) + xv * v.load(b, bo + j)).store(out, o + j)
				}
				for ; j < m; j++ {
					out[o + j] += x * b[bo + j]
				}
			}
		}
	}

	// A rows×cols matrix over cells, row-major; no cells means zeros. The
	// compiler builds matrix literals with it.
	internal def matrixOf<T: SimdNumeric>(rows int, cols int, cells T[]) matrix<T> {
		if cells.len() == 0 {
			cells.len(rows * cols)
		}
		return new matrix<T>(rows, cols, cells)
	}

	// A matrix of the rows of an array of arrays (`rows.matrix()`); the rows
	// must have the same length.
	internal def matrixFromRows<T: SimdNumeric>(rows T[][]) matrix<T> {
		let n = rows.len()
		let m = n == 0 ?? (0, rows[0].len())
		let out T[]
		out.len(n * m)
		for let r = 0; r < n; r++ {
			if rows[r].len() != m {
				__panic("matrix(): row {r} has {rows[r].len()} values, row 0 has {m}")
			}
			for let c = 0; c < m; c++ {
				out[r * m + c] = rows[r][c]
			}
		}
		return new matrix<T>(n, m, out)
	}
}
