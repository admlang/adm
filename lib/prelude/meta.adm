partial module builtin {
	use std.reflection

	/*
	* Built-in annotations shipped with the compiler. Signatures document the
	* context each meta function can target.
	*/

	// General lifecycle ------------------------------------------------------

	// Marks a constructor as an implicit conversion: a value of the constructor's
	// single parameter type converts to the type wherever the type is expected,
	// the way a `T` becomes a `?T`. One hop, inward only; the constructor cannot fail.
	meta def implicit(target reflection.MethodMetaContext) {
		// intrinsic
	}

	// Marks a method that changes its receiver in place. The compiler rejects a
	// call of it on a const's frozen value (spec §7.1, Constants); the runtime
	// checks the same thing where the compiler cannot see the const.
	meta def mutates(target reflection.MethodMetaContext) {
		// intrinsic
	}

	// Marks a declaration as deprecated. The compiler warns at every *use* of the
	// declaration, which an annotation on the declaration itself cannot observe,
	// so the body is empty and `internal/sema/deprecation.go` implements it.
	meta def deprecated(target reflection.DeclarationMetaContext, message string = "", since string = "") {
		// intrinsic
	}

	// Conditional compilation / build tags ----------------------------------

	// `@cfg` is the generalized form; the sugar annotations (`@os`, `@arch`,
	// `@build`, `@feature`, `@version`) map to the corresponding constraints.
	meta def cfg(target reflection.DeclarationMetaContext, os string = "", arch string = "", build string = "", features string[] = [], version string = "") {
		// intrinsic
	}

	// Compiles the declaration only for the named target operating system.
	meta def os(target reflection.DeclarationMetaContext, value string) {
		// intrinsic
	}

	// Launch shape of a `cuda def`. `block` is the threads per block
	// (1..1024, split evenly over the axes in use). `x`, `y`, `z` name
	// integer parameters holding the thread count per axis; without them
	// the grid is one thread per element of the first array or device
	// buffer parameter. `cpu = false` marks a kernel that only compiles for
	// the GPU (shared memory, __syncthreads, warp intrinsics), so no CPU
	// emulation is built and it fails without a GPU. Read by the compiler;
	// no runtime meta glue is generated.
	meta def launch(target reflection.FunctionMetaContext, block int = 256, x string = "", y string = "", z string = "", cpu bool = true) {
		// intrinsic
	}

	// Marks a `cuda def` as a helper for kernel bodies, never launched from
	// ADM: it may return a value, and the compiler pastes it in front of
	// every kernel that calls it (directly, through an import, or through
	// another helper). Array parameters arrive as a pointer plus
	// `<name>_len`, as in kernels. Read by the compiler; no runtime meta
	// glue is generated.
	meta def kernelOnly(target reflection.FunctionMetaContext) {
		// intrinsic
	}

	// @fragment marks a pixel function: one written in the device subset
	// (numbers, bool, Vec2..Vec4, no allocation) that the compiler also
	// builds for the GPU (GLSL, SPIR-V) and for eight pixels at a time on the
	// CPU. One whose first parameter is the position `p Vec2` and whose
	// result is the `Vec4` colour is a paint: used where a `Fragment` is
	// expected it becomes one, its other parameters being the uniforms.
	// Read by the compiler; no runtime meta glue is generated.
	meta def fragment(target reflection.FunctionMetaContext) {
		// intrinsic
	}

	// Compiles the declaration only for the named target architecture.
	meta def arch(target reflection.DeclarationMetaContext, value string) {
		// intrinsic
	}

	// Compiles the declaration only when the build's target version is `value`.
	meta def version(target reflection.DeclarationMetaContext, value string) {
		// intrinsic
	}

	// Compiles the declaration only when every named feature is enabled for the build.
	meta def feature(target reflection.DeclarationMetaContext, value string[]) {
		// intrinsic
	}

	// Compiles the declaration only for the named build kind, `debug` or `release`.
	meta def build(target reflection.DeclarationMetaContext, value string) {
		// intrinsic
	}

	// Compile-time data stitching --------------------------------------------
	// Bakes the file at `path` (relative to the source file) into the
	// annotated `byte[]` constant, every byte of it; `string(data)` turns a
	// text asset back into text. The constant takes no initializer. With
	// `gzip = true` the constant holds the file gzip-compressed, to inflate
	// with `std.data.compress.gzip.Reader`. Implemented by the compiler.
	meta def embed<T: byte[]>(target reflection.ConstMetaContext, path string, gzip bool = false) {
		// intrinsic
	}

	// Binds the variable to the command-line flag `name`, shown in help with description;
	// defaultValue applies when the flag is absent.
	meta def flag(target reflection.VariableMetaContext, name, description string, defaultValue string = "") {
		// intrinsic
	}

	// Binds the variable to the environment variable `name`; defaultValue applies when it
	// is unset.
	meta def env(target reflection.VariableMetaContext, name string, defaultValue string = "") {
		// intrinsic
	}

	// Binds the variable to the environment variable `name`; defaultValue applies when it
	// is unset.
	meta def env(target reflection.ConstMetaContext, name string, defaultValue string = "") {
		// intrinsic
	}

	// Function semantics -----------------------------------------------------

	// Gates a function or method on a permission a service declares
	// (`@requires("adm.process.spawn")`): every package on the calling
	// chain must hold it or the call fails with `PolicyDenied`, so the
	// function must return an errorable. Read by the compiler.
	meta def requires(target reflection.FunctionMetaContext, permission string) {
		// intrinsic
	}

	// The method form of `@requires`.
	meta def requires(target reflection.MethodMetaContext, permission string) {
		// intrinsic
	}

	// Asks the backend to inline the function at every call site it can. Ignored when the
	// function is also `@noinline` or `@noOptimize`.
	meta def inline(target reflection.FunctionMetaContext) {
		// intrinsic
	}

	// The method form of `@inline`.
	meta def inline(target reflection.MethodMetaContext) {
		// intrinsic
	}

	// Keeps the backend from inlining the function, so it keeps its own frame in a debugger and
	// in profiles.
	meta def noinline(target reflection.FunctionMetaContext) {
		// intrinsic
	}

	// The method form of `@noinline`.
	meta def noinline(target reflection.MethodMetaContext) {
		// intrinsic
	}

	// Reserved for marking a function that emits events on a channel; no effect today.
	meta def emits(target reflection.FunctionMetaContext, chan string = "") {
		// intrinsic
	}

	// Runs the body the first time it is called and skips every later call.
	meta def once(target reflection.FunctionMetaContext) {
		const key = "builtin.once.ran"
		if target.ctx.storage.load(key) == "1" {
			target.skip()
			return
		}
		target.ctx.storage.save(key, "1")
		target.invoke()
	}

	// Runs the body the first time it is called and skips every later call.
	meta def once(target reflection.MethodMetaContext) {
		const key = "builtin.once.ran"
		if target.ctx.storage.load(key) == "1" {
			target.skip()
			return
		}
		target.ctx.storage.save(key, "1")
		target.invoke()
	}

	// Runs the function `timeout` after it is called, on its own task.
	//
	// The caller does not wait: it receives the zero value immediately and the
	// body runs later with the arguments it was given. Meant for functions
	// that return nothing.
	meta def delay(target reflection.FunctionMetaContext, timeout duration) {
		async runAfter(target.detach(), timeout)
	}

	// Runs the body after `timeout` on its own task; the caller returns at once with the
	// zero value.
	meta def delay(target reflection.MethodMetaContext, timeout duration) {
		async runAfter(target.detach(), timeout)
	}

	internal def runAfter(call reflection.DetachedCall, timeout duration) {
		__time_sleep(timeout)
		call.invoke()
	}

	// Coalesces calls closer together than `window` into one: each call
	// restarts the window, and only the last call's arguments reach the body,
	// `window` after the calls stop. Callers receive the zero value
	// immediately, so this is meant for functions that return nothing.
	meta def debounce(target reflection.FunctionMetaContext, window duration) {
		async runDebounced(target.detach(), window, bumpGeneration(target.ctx.storage))
	}

	// The method form of `@debounce`.
	meta def debounce(target reflection.MethodMetaContext, window duration) {
		async runDebounced(target.detach(), window, bumpGeneration(target.ctx.storage))
	}

	// The metadata key holding the debounce generation count, which tells a late
	// call that a newer one replaced it.
	const debounceGenerationKey = "builtin.debounce.generation"

	internal def bumpGeneration(storage reflection.MetadataStore) int {
		let generation = storage.load(debounceGenerationKey).toInt<int>() + 1
		storage.save(debounceGenerationKey, "{generation}")
		return generation
	}

	internal def runDebounced(call reflection.DetachedCall, window duration, generation int) {
		__time_sleep(window)
		return unless call.storage.load(debounceGenerationKey) == "{generation}"
		call.invoke()
	}

	// --------------------------------------------------------------------

	// Range clamps values to [start, end].
	meta def range<T: Numeric>(target reflection.FieldMetaContext, start T, end T) {
		let v = T(target.editor.get())
		target.editor.set(v.max(start).min(end))
	}

	// Parameter-targeted runtime hook: invoked by the compiler-generated meta
	// wrapper before the function body runs.
	meta def range<T: Numeric>(target reflection.ParameterMetaContext, start T, end T) {
		let v = T(target.get())
		target.set(v.max(start).min(end))
	}

	// External interop ------------------------------------------------------
	//
	// These annotations are used by the build/tooling pipeline to link against
	// external libraries and bind signature-only functions.

	// link declares a linker dependency for the backend toolchain.
	meta def link(target reflection.ModuleMetaContext, lib string) {
		// intrinsic
	}

	// Marks a module as providing C-ABI bindings backed by a library: every
	// function it declares without a body is a C function of that library.
	// With `header`, each of them is checked against its prototype there,
	// unless its own `@c` names another header or describes it by hand.
	meta def c(target reflection.ModuleMetaContext, lib string, header string = "") {
		// intrinsic
	}

	// Marks a module as providing native-ABI bindings backed by a library.
	meta def native(target reflection.ModuleMetaContext, lib string) {
		// intrinsic
	}

	// Declares a signature-only function binding to a C-ABI symbol (optionally
	// specifying a header for C compilation units).
	//
	// `convention` names the calling convention where a target has more than
	// one: "cdecl" (the default), "stdcall", "fastcall" or "vectorcall".
	// They differ on 32-bit x86, and "vectorcall" on 64-bit Windows too;
	// every other target has one convention and ignores the name.
	meta def c(target reflection.FunctionMetaContext, header string = "", symbol string = "", name string = "", ret string = "", params string[] = [], convention string = "") {
		// intrinsic
	}

	// Marks a function parameter of a C declaration that the C library keeps
	// and calls later (event handlers, `sqlite3_create_function`):
	//
	//     def onClick(button uint, @callback handler def(int, int) int32);
	//
	// The C function pointer stays valid as long as the function value: a
	// named function or a lambda that captures nothing never dies, a lambda
	// that captures lives as long as the variable or field holding it
	// (`dispose handler` ends it), and a capturing lambda written directly in
	// the call is refused. A call from C after the function died panics. A
	// function parameter without it is borrowed: C may call it until the call
	// returns.
	meta def callback(target reflection.ParameterMetaContext) {
		// intrinsic
	}

	// Builds the Zig file at `file` (relative to the source file) with `zig`
	// and links it: every function the module declares without a body is an
	// `export fn` of it, or of a file it imports. A function's symbol is its
	// name after `prefix`; `@c(symbol = "...")` on a function names another.
	// Types cross as they do for `@c`.
	meta def zig(target reflection.ModuleMetaContext, file string, prefix string = "") {
		// intrinsic
	}

	// Binds one function to an `export fn` of the Zig file at `file`, or of
	// its module's Zig file when `file` is left out. `symbol` is the
	// exported name when it is not the function's.
	meta def zig(target reflection.FunctionMetaContext, file string = "", symbol string = "") {
		// intrinsic
	}

	// Builds the Rust file at `file` (relative to the source file) with
	// `rustc` and links it: every function the module declares without a
	// body is a `#[no_mangle] pub extern "C" fn` of it, or of a module it
	// declares. Symbols are named as for `zig`. The file is compiled as a
	// module of one crate that holds all the program's Rust files (edition
	// 2021), so it takes no crate attributes (`#![...]`); a panic ends the
	// program. `file` may be a crate's folder instead (the one with
	// `Cargo.toml`): cargo builds it with its dependencies, without
	// downloading anything.
	meta def rust(target reflection.ModuleMetaContext, file string, prefix string = "") {
		// intrinsic
	}

	// Binds one function to an exported function of the Rust file at `file`,
	// or of its module's Rust file when `file` is left out.
	meta def rust(target reflection.FunctionMetaContext, file string = "", symbol string = "") {
		// intrinsic
	}

	// Builds the Go package in `folder` (relative to the source file) with
	// `go` and links it: every function the module declares without a body
	// is a function the package marks `//export`. Symbols are named as for
	// `zig`. The package is an ordinary one inside a Go module (not
	// `package main`): all the program's Go packages are built into one
	// archive. The build downloads nothing; a panic ends the program.
	meta def go(target reflection.ModuleMetaContext, folder string, prefix string = "") {
		// intrinsic
	}

	// Binds one function to an exported function of the Go package in
	// `folder`, or of its module's Go package when `folder` is left out.
	meta def go(target reflection.FunctionMetaContext, folder string = "", symbol string = "") {
		// intrinsic
	}

	// Declares a signature-only function binding to a native-ABI symbol.
	// `convention` is the calling convention, as on `c`. With `lazy`, the
	// library is not linked: it is loaded at the function's first call, so a
	// program that never calls it runs where the library is not installed;
	// a call panics when the library or the function is missing.
	meta def native(target reflection.FunctionMetaContext, lib string, symbol string = "", name string = "", convention string = "", lazy bool = false) {
		// intrinsic
	}
}
