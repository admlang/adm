partial module builtin {
	type Signed = int | int8 | int16 | int32 | int64 | int128
	type Unsigned = uint | uint8 | byte | uint16 | uint32 | uint64 | uint128
	type Integer = Signed | Unsigned
	type Float = float | float16 | float32 | float64 | float128
	type Numeric = Integer | Float
	type Complex = complex32 | complex64 | complex128

	def parseInt<T: Integer>(val string, base int = 10) T {
		let s = val.trim()
		return T(0) when s == ""

		let i = 0
		let neg = false

		if s[0] == '-' {
			neg = true
			i = 1
		} else if s[0] == '+' {
			i = 1
		}

		let b = base
		b = 10 when b == 0

		// Prefix-based autodetection.
		if i + 1 < s.len() {
			let prefix = s[i:i + 2]
			if prefix == "0x" || prefix == "0X" {
				b = 16
				i += 2
			} else if prefix == "0b" || prefix == "0B" {
				b = 2
				i += 2
			} else if prefix == "0o" || prefix == "0O" {
				b = 8
				i += 2
			}
		}

		// Heuristic: if base is left at 10, but hex digits appear, treat as hex.
		if b == 10 {
			for let j = i; j < s.len(); j++ {
				let ch = s[j]
				if (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F') {
					b = 16
					break
				}
			}
		}

		return T(0) when b < 2 || b > 36

		let acc uint128 = 0
		for let j = i; j < s.len(); j++ {
			let ch = s[j]
			continue when ch == '_'

			let d = -1
			if ch >= '0' && ch <= '9' {
				d = int(ch) - int('0')
			} else if ch >= 'a' && ch <= 'z' {
				d = 10 + (int(ch) - int('a'))
			} else if ch >= 'A' && ch <= 'Z' {
				d = 10 + (int(ch) - int('A'))
			} else {
				break
			}

			break when d < 0 || d >= b
			acc = acc * uint128(b) + uint128(d)
		}

		if neg {
			match T {
				case uint, uint8, byte, uint16, uint32, uint64, uint128:
					return T(0)
				default:
					return T(-int128(acc))
			}
		}
		return T(acc)
	}

	def parseFloat<T: Float>(val string) T {
		let s = val.trim()
		return T(0.0) when s == ""

		let i = 0
		let neg = false
		if s[0] == '-' {
			neg = true
			i = 1
		} else if s[0] == '+' {
			i = 1
		}

		let intPart float = 0.0
		let anyDigits = false
		for let j = i; j < s.len(); j++ {
			let ch = s[j]
			continue when ch == '_'
			break when ch < '0' || ch > '9'
			intPart = intPart * 10.0 + float(int(ch) - int('0'))
			anyDigits = true
			i = j + 1
		}

		let fracPart float = 0.0
		let fracDiv float = 1.0
		if i < s.len() && s[i] == '.' {
			i++
			for let j = i; j < s.len(); j++ {
				let ch = s[j]
				continue when ch == '_'
				break when ch < '0' || ch > '9'
				fracPart = fracPart * 10.0 + float(int(ch) - int('0'))
				fracDiv *= 10.0
				anyDigits = true
				i = j + 1
			}
		}

		return T(0.0) unless anyDigits

		let v = intPart + (fracPart / fracDiv)

		// Optional exponent.
		if i < s.len() && (s[i] == 'e' || s[i] == 'E') {
			i++
			let expNeg = false
			if i < s.len() && s[i] == '-' {
				expNeg = true
				i++
			} else if i < s.len() && s[i] == '+' {
				i++
			}

			let exp = 0
			for let j = i; j < s.len(); j++ {
				let ch = s[j]
				continue when ch == '_'
				break when ch < '0' || ch > '9'
				exp = exp * 10 + (int(ch) - int('0'))
				i = j + 1
			}
			if expNeg {
				for let k = 0; k < exp; k++ {
					v /= 10.0
				}
			} else {
				for let k = 0; k < exp; k++ {
					v *= 10.0
				}
			}
		}

		if neg {
			v = -v
		}
		return T(v)
	}

	@builtin(for = Numeric)
	type Number<T: Numeric> {
		use (
			std.math::(*)
			std.bytes::(Endian)
		)

		internal value T

		internal def hb(bitCount int) int {
			// If the value is 0, there is no set bit.
			return -1 when self == 0
			// Iterate from the most significant bit downwards.
			for let i = bitCount - 1; i >= 0; i-- {
				// If we find the first '1' bit, its index is the highest bit position.
				if (self >> T(i)) & 1 == 1 {
					return i
				}
			}
			// This case is unreachable if self != 0.
			return -1
		}

		internal def leadingzeros(hb, bitCount int) int {
			// If highestBit is -1, the number is 0, so all bits are leading zeros.
			return bitCount when hb == -1
			// Otherwise, the number of leading zeros is the total bits minus the position of the highest bit, minus one.
			return (bitCount - 1) - hb
		}

		internal def trailingzeros(bits int) int {
			return bits when self == 0 // all bits are zero

			let v = self
			for let i = 0; i < bits; i++ {
				if (v >> T(i)) & 1 == 1 {
					return i
				}
			}
			return bits // Should be unreachable if self != 0
		}

		where T is uint8 | byte {
			def MIN() T { return 0 }
			def MAX() T { return MAX_UINT8 }
			def size() int { return 1 }
			def bits() int { return 8 }

			// Returns the number of leading zeros in the binary representation
			def leadingZeros() int {
				return leadingzeros(self.highestBit(), self.bits())
			}

			// Returns the number of trailing zeros in the binary representation
			def trailingZeros() int {
				return trailingzeros(self.bits())
			}

			// Returns the position of the highest set bit in the binary representation.
			// Returns -1 if there is no set bit.
			def highestBit() int {
				return hb(self.bits())
			}
		}

		where T is int8 {
			def MIN() T { return MIN_INT8 }
			def MAX() T { return MAX_INT8 }
			def size() int { return 1 }
			def bits() int { return 8 }
		}

		where T is uint16 {
			def MIN() T { return 0 }
			def MAX() T { return MAX_UINT16 }
			def size() int { return 2 }
			def bits() int { return 16 }

			// Returns the number of leading zeros in the binary representation
			def leadingZeros() int {
				return leadingzeros(self.highestBit(), self.bits())
			}

			// Returns the number of trailing zeros in the binary representation
			def trailingZeros() int {
				return trailingzeros(self.bits())
			}

			// Returns the position of the highest set bit in the binary representation.
			// Returns -1 if there is no set bit.
			def highestBit() int {
				return hb(self.bits())
			}
		}

		where T is int16 {
			def MIN() T { return MIN_INT16 }
			def MAX() T { return MAX_INT16 }
			def size() int { return 2 }
			def bits() int { return 16 }
		}

		where T is uint32 {
			def MIN() T { return 0 }
			def MAX() T { return MAX_UINT32 }
			def size() int { return 4 }
			def bits() int { return 32 }

			// Returns the number of leading zeros in the binary representation
			def leadingZeros() int {
				return leadingzeros(self.highestBit(), self.bits())
			}

			// Returns the number of trailing zeros in the binary representation
			def trailingZeros() int {
				return trailingzeros(self.bits())
			}

			// Returns the position of the highest set bit in the binary representation.
			// Returns -1 if there is no set bit.
			def highestBit() int {
				return hb(self.bits())
			}
		}

		where T is int32 {
			def MIN() T { return MIN_INT32 }
			def MAX() T { return MAX_UINT32 }
			def size() int { return 4 }
			def bits() int { return 32 }
		}

		where T is uint64 {
			def MIN() T { return 0 }
			def MAX() T { return MAX_UINT64 }
			def size() int { return 8 }
			def bits() int { return 64 }

			// Returns the number of leading zeros in the binary representation
			def leadingZeros() int {
				return leadingzeros(self.highestBit(), self.bits())
			}

			// Returns the number of trailing zeros in the binary representation
			def trailingZeros() int {
				return trailingzeros(self.bits())
			}

			// Returns the position of the highest set bit in the binary representation.
			// Returns -1 if there is no set bit.
			def highestBit() int {
				return hb(self.bits())
			}
		}

		where T is uint {
			def MIN() T { return 0 }
			def MAX() T { return MAX_UINT }
			def size() int { return __int_width__ }
			def bits() int { return __int_width__ * 8 }

			// Returns the number of leading zeros in the binary representation
			def leadingZeros() int {
				return leadingzeros(self.highestBit(), self.bits())
			}

			// Returns the number of trailing zeros in the binary representation
			def trailingZeros() int {
				return trailingzeros(self.bits())
			}

			// Returns the position of the highest set bit in the binary representation.
			// Returns -1 if there is no set bit.
			def highestBit() int {
				return hb(self.bits())
			}
		}

		where T is int64 | int {
			def MIN() T { return MIN_INT64 }
			def MAX() T { return MAX_INT64 }
			def size() int { return 8 }
			def bits() int { return 64 }
		}

		where T is uint128 {
			def MIN() T { return 0 }
			def MAX() T { return MAX_UINT128 }
			def size() int { return 16 }
			def bits() int { return 128 }

			// Returns the number of leading zeros in the binary representation
			def leadingZeros() int {
				return leadingzeros(self.highestBit(), self.bits())
			}

			// Returns the number of trailing zeros in the binary representation
			def trailingZeros() int {
				return bits() when self == 0

				let v = self
				for let i = 0; i < bits(); i++ {
					if (v >> i) & 1 == 1 {
						return i
					}
				}
				return bits()
			}

			// Returns the position of the highest set bit in the binary representation.
			// Returns -1 if there is no set bit.
			def highestBit() int {
				return hb(self.bits())
			}
		}

		where T is int128 {
			def MIN() T { return MIN_INT128 }
			def MAX() T { return MAX_UINT128 }
			def size() int { return 16 }
			def bits() int { return 128 }
		}

		where T is float16 {
			def MIN() T { return MIN_FLOAT16 }
			def MAX() T { return MAX_FLOAT16 }
			def size() int { return 2 }
			def bits() int { return 16 }
		}

		where T is float32 {
			def MIN() T { return MIN_FLOAT32 }
			def MAX() T { return MAX_FLOAT32 }
			def size() int { return 4 }
			def bits() int { return 32 }
		}

		where T is float64 | float {
			def MIN() T { return MIN_FLOAT64 }
			def MAX() T { return MAX_FLOAT64 }
			def size() int { return 8 }
			def bits() int { return 64 }
		}

		where T is float128 {
			def MIN() T { return 0 }
			def MAX() T { return 0 }
			def size() int { return 16 }
			def bits() int { return 128 }
		}

		where T is Integer {
			def bytes(endian = Endian.Little) byte[] {
				let s = self.size()
				let buf = byte[]
				buf.len(s)
				let v = uint128(value)

				if endian == Endian.Big {
					for let i = 0; i < s; i++ {
						let shift = (s - 1 - i) * 8
						buf[i] = byte((v >> shift) & 0xFF)
					}
				} else {
					for let i = 0; i < s; i++ {
						let shift = i * 8
						buf[i] = byte((v >> shift) & 0xFF)
					}
				}
				return buf
			}

			def fromBytes(buf byte[], endian = Endian.Little) T {
				let s = self.size()
				let intVal uint128 = 0
				if endian == Endian.Big {
					for let i = 0; i < s; i++ {
						let shift = (s - 1 - i) * 8
						intVal = intVal | (uint128(buf[i]) << shift)
					}
				} else {
					for let i = 0; i < s; i++ {
						let shift = i * 8
						intVal = intVal | (uint128(buf[i]) << shift)
					}
				}
				return T(intVal)
			}
		}

		where T is Float {
			def toFixed(decimalPlaces int) T {
				let scale = T(10 ** decimalPlaces)
				let val = value * scale
				return val.floor() / scale
			}

			// Largest integral value not above self. Values beyond the
			// int64 range are already integral and come back unchanged.
			def floor() T {
				return self when self != self || self > T(9007199254740992.0) || self < T(-9007199254740992.0)
				let t = T(int64(self))
				return t when t <= self
				return t - T(1)
			}

			// Smallest integral value not below self.
			def ceil() T {
				return self when self != self || self > T(9007199254740992.0) || self < T(-9007199254740992.0)
				let t = T(int64(self))
				return t when t >= self
				return t + T(1)
			}

			// Nearest integral value, halves away from zero.
			def round() T {
				return (self + T(0.5)).floor() when self >= T(0)
				return (self - T(0.5)).ceil()
			}

			// return the fractional part
			def frac() T {
				return self when self != self
				return self - T(int64(self))
			}

			def bytes(endian = Endian.Little) byte[] {
				let s = self.size()
				let buf = byte[]
				buf.len(s)
				let intVal uint128

				// Reinterpret float bits as an integer of the same size.
				match T {
					case float16:
					intVal = uint128(uint16(value))
					case float32, float:
					intVal = uint128(uint32(value))
					case float64:
					intVal = uint128(uint64(value))
					case float128:
					intVal = uint128(value)
				}

				if endian == Endian.Big {
					for let i = 0; i < s; i++ {
						let shift = (s - 1 - i) * 8
						buf[i] = byte((intVal >> shift) & 0xFF)
					}
				} else {
					for let i = 0; i < s; i++ {
						let shift = i * 8
						buf[i] = byte((intVal >> shift) & 0xFF)
					}
				}
				return buf
			}

			def fromBytes(buf byte[], endian = Endian.Little) T {
				let s = self.size()
				let intVal uint128 = 0

				if endian == Endian.Big {
					for let i = 0; i < s; i++ {
						let shift = (s - 1 - i) * 8
						intVal = intVal | (uint128(buf[i]) << shift)
					}
				} else {
					for let i = 0; i < s; i++ {
						let shift = i * 8
						intVal = intVal | (uint128(buf[i]) << shift)
					}
				}

				match T {
					case float16:
					return float16(uint16(intVal))
					case float32, float:
					return __bitcast_f32_from_u32(uint32(intVal))
					case float64:
					return __bitcast_f64_from_u64(uint64(intVal))
					case float128:
					return float128(intVal)
				}
				return self
			}
		}

		def even() bool {
			return int(value) % 2 == 0
		}

		def odd() bool {
			return int(value) % 2 != 0
		}

		def abs() T {
			return value when value >= T(0)
			return value * T(-1)
		}

		def min(other T) T {
			return value when value < other
			return other
		}

		def max(other T) T {
			return value when value > other
			return other
		}

		def clamp(lower, upper T) T {
			return max(lower).min(upper)
		}

		// Generic linear interpolation for all Numeric types.
		// Compute in float for precision, then cast back to T.
		def lerp(start T, end T, t float) T {
			let fs = float(start)
			let fe = float(end)
			return T(fs + (fe - fs) * t)
		}

		def toRadix(radix int, padding int = 0) string {
			let digits = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
			return "" when radix < 2 || radix > 36

			match T {
				case float16, float32, float, float64, float128:
					return str() when radix == 10
					return ""
			}

			let neg = false
			let v uint128 = uint128(self)

			match T {
				case int, int8, int16, int32, int64, int128:
					if self < 0 {
						neg = true
						v = uint128(0) - uint128(self)
					}
			}

			let out = ""
			if v == 0 {
				out = "0"
			} else {
				let parts = string[]
				for v > 0 {
					let d = int(v % uint128(radix))
					parts.push(string(digits[d]))
					v = v / uint128(radix)
				}
				out = parts.reverse().join("")
			}

			for out.len() < padding {
				out = "0" + out
			}
			if neg {
				out = "-" + out
			}
			return out
		}

		def hex(padding int = 0) string {
			return toRadix(16, padding)
		}

		def hex(format string) string {
			return sprintf(format, value)
		}

		def str() string {
			match T {
				case float16, float32, float, float64, float128:
					return sprintf("%g", float(self))
				default:
					return toRadix(10)
			}
		}
	}

	// Operations on the complex kinds. Parts and magnitudes are `float`
	// whatever the kind, so a generic `T: Complex` body can compute with
	// them; the backends implement the bodies.
	@builtin(for = Complex)
	type ComplexNumber<T: Complex> {
		internal value T

		// The real part.
		def real() float {
			// intrinsic
		}

		// The imaginary part.
		def imag() float {
			// intrinsic
		}

		// The magnitude |z|.
		def abs() float {
			// intrinsic
		}

		// The complex conjugate.
		def conj() T {
			// intrinsic
		}
	}

	// A complex128 from its parts.
	def complex(re float, im float = 0.0) complex128 {
		// intrinsic
	}
}
