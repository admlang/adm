partial module prelude.tests {
	use std.testing

	// Decodes a number of any width through a generic body, the way a byte
	// reader does: the call inside picks its `where` block per instance.
	internal def decodeAs<T: Numeric>(buf byte[]) T {
		return T(0).fromBytes(buf)
	}

	check "Numbers" {
		// NaN is unordered: every comparison but `!=` is false, even with
		// itself, and rounding keeps it NaN. The zero comes from a call so no
		// backend folds the division away.
		@test()
		def nanComparisons() {
			let zero = float("x".len() - 1)
			let nan = zero / zero
			assert !(nan < 1.0) && !(nan > 1.0) && !(nan <= 1.0) && !(nan >= 1.0)
			assert !(nan == nan)
			assert nan != nan
			assert nan.round() != nan.round()
			assert nan.floor() != nan.floor()
			let narrow = float32(nan)
			assert narrow != narrow
		}

		// Each float width takes its own `where` block: `where T is Float`
		// names an alias of a union, which float32 is a member of, and the
		// integer blocks never apply.
		@test()
		def floatWidthsUseTheirOwnBlocks() {
			assert decodeAs<float32>(byte[0, 0, 0, 0x3F]) == float32(0.5)
			assert decodeAs<float64>(byte[0, 0, 0, 0, 0, 0, 0xE0, 0x3F]) == 0.5
			let narrow float32 = 0
			assert narrow.size() == 4
			assert narrow.fromBytes(byte[0, 0, 0, 0x3F]) == float32(0.5)
			assert float32(0.5).bytes().len() == 4
			let wide float64 = 0
			assert wide.size() == 8
			assert wide.fromBytes(byte[0, 0, 0, 0, 0, 0, 0xE0, 0x3F]) == 0.5
		}

		@test()
		def parseIntAndRadix() {
			assert parseInt<uint16>("255") == uint16(255)
			assert parseInt<int>("-42") == -42
			assert parseInt<uint16>("1010", 2) == uint16(10)
			assert parseInt<uint8>("FF") == uint8(255)
			assert parseInt<uint32>("1_000") == uint32(1000)
			assert parseInt<int>("0x1f") == 31
			assert parseInt<int>("0b101") == 5
			assert parseInt<int>("0b", 16) == 11
			assert parseInt<int>("0B1", 16) == 177
			assert parseInt<int>("0x10", 16) == 16
			assert parseInt<int>("0o17", 8) == 15
			assert "1b".toInt<int>(16) == 27
			assert uint32(255).toRadix(16) == "FF"
			assert uint8(15).hex(2) == "0F"
			assert int64(-10).str() == "-10"
		}

		@test()
		def signedLimits() {
			// int32.MAX() returned the unsigned limit, which read back as -1
			// and sent flate's level table down the wrong branch.
			assert int32(0).MAX() == int32(2147483647)
			assert int32(0).MIN() == int32(-2147483648)
			assert int16(0).MAX() == int16(32767)
			assert int8(0).MAX() == int8(127)
			assert int64(0).MAX() > int64(0)
			assert int(int32(0).MAX()) == 2147483647
			assert int128(0).MAX() > int128(0)
			assert int128(0).MAX() == (int128(1) << 127) - int128(1)
			assert int128(0).MIN() < int128(0)
		}

		@test()
		def parseFloatAndStr() {
			let v = parseFloat<float>("3.5")
			assert (v - 3.5).abs() < 0.000001
			let e = parseFloat<float>("-1.25e2")
			assert (e + 125.0).abs() < 0.000001
			assert float(1.5).str() == "1.5"
		}

		check "uint8" {
			@test()
			def highestBit() {
				assert uint8(0).highestBit() == -1
				assert uint8(132).highestBit() == 7
				assert uint8(0xFF).highestBit() == 7
			}

			@test()
			def leadingZeros() {
				assert uint8(0).leadingZeros() == 8
				assert uint8(1).leadingZeros() == 7
				assert uint8(128).leadingZeros() == 0
				assert uint8(255).leadingZeros() == 0
			}
		}
		check "uint16" {
			@test()
			def highestBit() {
				assert uint16(0).highestBit() == -1
				assert uint16(132).highestBit() == 7
				assert uint16(0xFFFF).highestBit() == 15
			}

			@test()
			def leadingZeros() {
				assert uint16(0).leadingZeros() == 16
				assert uint16(1).leadingZeros() == 15
				assert uint16(32768).leadingZeros() == 0
			}
		}

		check "uint32" {
			@test()
			def highestBit() {
				assert uint32(0).highestBit() == -1
				assert uint32(132).highestBit() == 7
				assert uint32(0xFFFFFFFF).highestBit() == 31
			}

			@test()
			def leadingZeros() {
				assert uint32(0).leadingZeros() == 32
				assert uint32(1).leadingZeros() == 31
				assert uint32(0x80000000).leadingZeros() == 0
			}
		}

		check "uint64" {
			@test()
			def highestBit() {
				assert uint64(0).highestBit() == -1
				assert uint64(132).highestBit() == 7
				assert uint64(0xFFFFFFFFFFFFFFFF).highestBit() == 63
			}

			@test()
			def leadingZeros() {
				assert uint64(0).leadingZeros() == 64
				assert uint64(1).leadingZeros() == 63
				assert uint64(0x8000000000000000).leadingZeros() == 0
			}
		}

		check "uint128" {
			@test()
			def highestBit() {
				assert uint128(0).highestBit() == -1
				assert uint128(132).highestBit() == 7
				assert uint128(0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF).highestBit() == 127
			}

			@test()
			def leadingZeros() {
				assert uint128(0).leadingZeros() == 128
				assert uint128(1).leadingZeros() == 127
			}
		}
	}
}
