	// manager, which sets the status around it: 0 = start, 1 = stop,
	// 2 = restart.
	internal def __service_transition(name string, kind int) !none {
		// intrinsic
	}

	// Device buffers behind `std.gpu.DeviceBuffer<T>`. Handles are opaque;
	// 0 from upload and 1 from the copies mean failure, and __cuda_last_error
	// says why. The generic ones are filled in by the backends per instance.
	internal def __cuda_buffer_upload<T>(data T[]) uint {
		// intrinsic
	}

	// A buffer of `count` zero elements, nothing copied from the host; `sample`
	// has one element, which gives the element size.
	internal def __cuda_buffer_create<T>(sample T[], count int) uint {
		// intrinsic
	}

	internal def __cuda_buffer_download<T>(handle uint, into T[]) int {
		// intrinsic
	}

	internal def __cuda_buffer_write<T>(handle uint, from T[]) int {
		// intrinsic
	}

	// Overwrites the elements from `at` on; `from` must fit in the buffer.
	internal def __cuda_buffer_write_at<T>(handle uint, from T[], at int) int {
		// intrinsic
	}

	// Queued copies on a stream (std.gpu.Stream); synchronous on the CPU path.
	internal def __cuda_buffer_write_async<T>(handle uint, from T[], stream uint) int {
		// intrinsic
	}

	internal def __cuda_buffer_download_async<T>(handle uint, into T[], stream uint) int {
		// intrinsic
	}

	// Readbacks behind std.gpu.Readback<T>: a copy of a whole buffer queued on the
	// default queue with its own completion point. 0 from create and 1 from start
