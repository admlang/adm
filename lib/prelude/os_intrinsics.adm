	internal def __cuda_readback_create(buffer uint, overlap bool) uint {
		// intrinsic
	}

	internal def __cuda_readback_start(readback uint, buffer uint) int {
		// intrinsic
	}

	internal def __cuda_readback_finish<T>(readback uint, buffer uint, into T[]) int {
		// intrinsic
	}

	internal def __cuda_readback_free(readback uint) {
		// intrinsic
	}

	// Host buffers behind std.gpu.HostBuffer<T>: page-locked memory that copies to
	// device buffers are queued from. `sample` is an array with one element, which
	// gives the element size. 0 from create and 1 from the copies mean failure, and
	// __cuda_last_error says why.
	internal def __cuda_host_create<T>(sample T[], count int) uint {
		// intrinsic
	}

	internal def __cuda_host_write<T>(host uint, from T[], at int) int {
		// intrinsic
	}

	internal def __cuda_buffer_write_host(buffer uint, host uint, start int, count int, at int, overlap bool) int {
		// intrinsic
	}

	internal def __cuda_buffer_join(buffer uint) int {
		// intrinsic
	}

	internal def __cuda_host_free(host uint) {
		// intrinsic
	}

	// Streams behind std.gpu.Stream: 0 from create and 1 from wait mean
	// failure, and __cuda_last_error says why.
	internal def __cuda_stream_create() uint {
		// intrinsic
	}

	internal def __cuda_stream_wait(stream uint) int {
		// intrinsic
	}

	internal def __cuda_stream_free(stream uint) {
		// intrinsic
	}

	internal def __cuda_buffer_len(handle uint) int {
		// intrinsic
	}

	internal def __cuda_buffer_free(handle uint) {
		// intrinsic
	}

	internal def __cuda_last_error() string {
		// intrinsic
	}

	// Whether a launch would use the GPU right now.
	internal def __cuda_available() bool {
		// intrinsic
	}

	internal def __cuda_device_name() string {
		// intrinsic
	}

	// Bytes of device memory free on the selected GPU; 0 on the CPU path.
	internal def __cuda_free_memory() int {
		// intrinsic
	}

	// Compute capability of the selected GPU times ten; 0 on the CPU path.
	internal def __cuda_capability() int {
		// intrinsic
	}

	// What a call to a service's start(), stop() or restart() compiles to,
	// so the status is kept however the hook is invoked.
	internal async def __service_lifecycle(name string, kind int) !none {
		try __service_transition(name, kind)
		return none
	}

	// The machine's host name (gethostname; the DNS host name on Windows);
	// "" when the system does not say. Read from the system, not through
	// Storage.
	internal def __host_name() string {
		// intrinsic
	}

	// The kernel's release (uname); the build number on Windows.
	internal def __kernel_version() string {
		// intrinsic
	}

	// The operating system's name and version: os-release's PRETTY_NAME on
	// Linux, "macOS <version>", "Windows <major>.<minor>.<build>".
	internal def __os_version() string {
		// intrinsic
	}

	// Physical processor cores.
	internal def __cpu_count() int {
		// intrinsic
	}

	// Online logical processors (hardware threads).
	internal def __logical_cpu_count() int {
		// intrinsic
	}

	// The local time zone as an IANA name (TZ, else the zone /etc/localtime
	// links to, else /etc/timezone); on Windows the Windows zone id
	// ("W. Europe Standard Time"), which std.i18n maps to an IANA name. ""
	// when none is set.
	internal def __time_zone() string {
		// intrinsic
