	// Memory-mapped files.
	//
	// Maps `length` bytes of an open descriptor from `offset` and returns a
	// mapping handle. A length of 0 maps to the end of the file, which a device
	// node reporting no size cannot do; such a caller passes the length. Access
	// is 0 for shared read-only, 1 for shared read-write, 2 for a private
	// copy-on-write mapping.
	internal def __mem_map(fd int, offset int, length int, access int) !int {
		// intrinsic
	}

	// A copy of the mapped bytes. Fails when the range leaves the mapping.
	internal def __mem_map_read(handle int, offset int, length int) !byte[] {
		// intrinsic
	}

	// The mapped bytes as an array over the mapping's own pages, without a
	// copy; the mapping stays until it is unmapped and the last such array
	// is gone. Fails on a read-only mapping (a store would fault) or a range
	// that leaves the mapping.
	internal def __mem_map_view(handle int, offset int, length int) !byte[] {
		// intrinsic
	}

	// Writes into the mapping. Fails on a read-only mapping or a range that
	// leaves it.
	internal def __mem_map_write(handle int, offset int, data byte[]) !none {
		// intrinsic
	}

	// Bytes the mapping covers, 0 for a handle that is not a mapping.
	internal def __mem_map_length(handle int) int {
		// intrinsic
	}

	// Pushes a shared mapping's changes to the file.
	internal def __mem_map_flush(handle int) !none {
		// intrinsic
	}

	// Releases the mapping.
	internal def __mem_unmap(handle int) !none {
		// intrinsic
	}

