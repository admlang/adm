	// Enumerate local network interfaces.
	//
	// Returns parallel arrays:
	// - names: interface names (e.g. "lo0", "eth0")
	// - indices: stable OS interface indices
	// - flags: ADM-stable bitmask derived from OS flags
	// - mtus: MTU (0 if unknown)
	// - hw_addrs: hardware/MAC address as "aa:bb:cc:dd:ee:ff" ("" if unknown/not applicable)
	// - addrs: per-interface list of IP addresses (no ports)
	internal def __net_ifaces() !(string[], int[], int[], int[], string[], string[][]) {
		// intrinsic
	}

