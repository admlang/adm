	}

	// A descriptor that becomes readable when SIGINT or SIGTERM arrived,
	// one byte (the signal's number) per signal; -1 where there are no
	// signals. The first call installs the handlers.
	internal def __proc_signal_fd() int {
		// intrinsic
	}

	// Prints `panic: <message>` and aborts: for programming errors the
	// program cannot continue past, like a matrix shape mismatch.
	internal def __panic(message string) {
		// intrinsic
	}

	internal def __proc_executable_path() string {
		// intrinsic
	}

	// Runs the command through the shell with the text as its standard input
	// and returns what it printed and its exit code (128 + signal when it was
	// killed, 127 when the shell could not start). Fails when the process
	// could not be started at all. Only `Runtime.run` calls it, behind the
	// `adm.runtime.spawn` gate.
	internal def __proc_run(command string, input string) !(string, int) {
		// intrinsic
	}

	// Starts the program with the arguments, no shell between; `env` holds
	// `NAME=value` entries laid over this process's environment and `dir` the
	// child's working directory ("" for this one's). Returns the child's
	// handle, its process id and this side's ends of its standard input,
	// output and error pipes (the last -1 unless `errors`). Fails when the
	// program could not be started. Only `Runtime.start` calls it, behind the
	// `adm.runtime.spawn` gate.
	internal def __proc_start(program string, args string[], env string[], dir string, errors bool) !(int64, int, int, int, int) {
		// intrinsic
	}

	// Waits for the child to exit, at most `timeout` nanoseconds (forever
	// when negative): whether it has, and its exit code (128 + signal when it
	// was killed). Fails for a handle that was released.
	internal def __proc_wait(handle int64, timeout int64) !(bool, int) {
		// intrinsic
	}

	// Asks a child that has not exited to stop (SIGTERM), or stops it
	// (SIGKILL) with `force`.
	internal def __proc_signal(handle int64, force bool) !none {
		// intrinsic
	}

	// Forgets the child; the runtime reaps it when it exits.
	internal def __proc_release(handle int64) {
		// intrinsic
	}

	// This side's end of a child's pipe. A read or a write parks the task
	// until the pipe is ready; a write takes the whole buffer, and fails
	// when the child closed its input; a close wakes a parked task.
	internal def __proc_pipe_read(fd int, data byte[]) !int {
		// intrinsic
	}

	internal def __proc_pipe_write(fd int, data byte[]) !int {
		// intrinsic
	}

	internal def __proc_pipe_close(fd int) !none {
		// intrinsic
	}

	// Returns the current working directory for the process.
	internal def __proc_working_dir() string {
		// intrinsic
	}

	internal def __proc_start_wall_ns() int64 {
		// intrinsic
	}

	internal def __proc_start_mono_ns() int64 {
		// intrinsic
	}

	internal def __proc_uptime_ns() int64 {
		// intrinsic
