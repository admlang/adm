	// Plugin intrinsics, behind the plugin calls of the `Runtime` service.

	// The shape of the interface T as a host and a plugin compare it: its
	// qualified name, then for each method, in declaration order, its name
	// and its signature in the canonical spelling a plugin's export index
	// uses. Empty when T is not an interface.
	internal def __plugin_shape<T>() string[] {
		// intrinsic
	}

	// How the types a plugin asked for a T would meet are laid out: a name and
	// a layout per type, in the spelling a plugin package records its own
	// (`meta/layouts.json`). For an interface T, the declared types its methods
	// name, std's left out, followed through their fields; for any other T,
	// T itself first.
	internal def __plugin_layouts<T>() string[] {
		// intrinsic
	}

	// Loads the plugin object at the path, once per path, checks that it was
	// built for this program's plugin ABI and compiler and is the plugin
	// `name`, and runs its `new()`. `name` is the package the plugin is to
	// the policy: it is on the principal chain while the object loads and
	// `new()` runs, as during every later call into the plugin.
	// Returns the handle the other calls take. Fails when the object cannot
	// be loaded, was built for another ABI or compiler, or its `new()` fails.
	internal def __plugin_load(path string, name string, entry string, compiler string) !int64 {
		// intrinsic
	}

	// The same for an object held in memory, loaded without writing a file:
	// what runs is the bytes the caller checked. `path` is the package the
	// object came from.
	// Fails as `__plugin_load` does, and where the platform cannot load an
	// object that way (`__plugin_loads_in_place`).
	internal def __plugin_load_bytes(path string, name string, object byte[], entry string, compiler string) !int64 {
		// intrinsic
	}

	// How many plugins this program has loaded. What is found through
	// discovery grows with it: a plugin's annotated declarations are listed
	// once it is loaded.
	internal def __plugin_count() int {
		// intrinsic
	}

	// Whether this platform loads a plugin object from memory.
	internal def __plugin_loads_in_place() bool {
		// intrinsic
	}

	// The bytes of a stored part of the plugin package at the path. Fails when
	// the file is not a package, holds no such part, or compresses it.
	internal def __plugin_part(path string, name string) !byte[] {
		// intrinsic
	}

	// A copy of the struct value a loaded plugin exports under the name
	// `exported`, as a T: a new object with the value's fields. The caller has
	// checked that the plugin lays the value's type out as this program lays
	// T out. Fails when the plugin exports no such struct value.
	internal def __plugin_value<T>(handle int64, exported string) !T {
		// intrinsic
	}

	// Makes a T from a loaded plugin: a new object of its exported type
	// `exported`, or with an empty name the one object bound to the plugin,
	// whose methods are its exported functions. `shape` is
	// `__plugin_shape<T>()`. Fails when the plugin does not provide every
	// method of T, or the type cannot be built without arguments.
	internal def __plugin_create<T>(handle int64, exported string, shape string[]) !T {
		// intrinsic
	}

