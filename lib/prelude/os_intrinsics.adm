partial module builtin {
	// Time intrinsics (runtime-backed).
	internal def __time_wall_ns() int64 {
		// intrinsic
	}

	internal def __time_mono_ns() int64 {
		// intrinsic
	}

	internal def __time_sleep(ns duration) {
		// intrinsic
	}

	// Filesystem intrinsics (runtime-backed, minimal POSIX subset).
	internal def __fs_open(path string, mode string) !int {
		// intrinsic
	}

	internal def __fs_close(fd int) !none {
		// intrinsic
	}

	internal def __fs_read(fd int, buf byte[]) !int {
		// intrinsic
	}

	internal def __fs_write(fd int, data byte[]) !int {
		// intrinsic
	}

	internal def __fs_seek(fd int, offset int64, whence int) !int64 {
		// intrinsic
	}

	internal def __fs_read_at(fd int, buf byte[], offset int64) !int {
		// intrinsic
	}

	internal def __fs_write_at(fd int, data byte[], offset int64) !int {
		// intrinsic
	}

	internal def __fs_ftruncate(fd int, size int64) !none {
		// intrinsic
	}

	internal def __fs_read_all(path string) !byte[] {
		// intrinsic
	}

	internal def __fs_write_all(path string, data byte[]) !none {
		// intrinsic
	}

	internal def __fs_exists(path string) !bool {
		// intrinsic
	}

	internal def __fs_remove(path string) !none {
		// intrinsic
	}

	internal def __fs_rename(old_path string, new_path string) !none {
		// intrinsic
	}

	internal def __fs_mkdir(path string) !none {
		// intrinsic
	}

	internal def __fs_rmdir(path string) !none {
		// intrinsic
	}

	// Read directory entries (excluding "." and "..") and return their names.
	internal def __fs_read_dir(path string) !string[] {
		// intrinsic
	}

	// Filesystem metadata + permissions.
	internal def __fs_stat(path string) !(int64, int64, bool, int64) {
		// intrinsic
	}

	// Mode is typically an octal permission mask (e.g. 0o755).
	internal def __fs_chmod(path string, mode int64) !none {
		// intrinsic
	}

	// Network intrinsics (runtime-backed, minimal sockets).
	//
	// Address formats:
	// - IPv4:  "host:port" or ":port"
	// - IPv6:  "[host]:port" or "[]:port"
	// - Unix:  "/absolute/path" (domain=Unix)
	internal def __net_socket(domain int, typ int) !int {
		// intrinsic
	}

	internal def __net_bind(fd int, addr string) !none {
		// intrinsic
	}

	internal def __net_listen(fd int, backlog int) !none {
		// intrinsic
	}

	internal def __net_accept(fd int) !int {
		// intrinsic
	}

	internal def __net_connect(fd int, addr string, timeout_ns duration) !none {
		// intrinsic
	}

	internal def __net_close(fd int) !none {
		// intrinsic
	}

	internal def __net_write(fd int, data byte[], timeout_ns duration) !int {
		// intrinsic
	}

	internal def __net_read(fd int, data byte[], timeout_ns duration) !int {
		// intrinsic
	}

	internal def __net_resolve(name string) !string[] {
		// intrinsic
	}

	// Socket options / inspection.
	internal def __net_set_reuseaddr(fd int, enabled bool) !none {
		// intrinsic
	}

	internal def __net_local_addr(fd int) !string {
		// intrinsic
	}

	internal def __net_remote_addr(fd int) !string {
		// intrinsic
	}

	// UDP-style datagram helpers.
	internal def __net_send_to(fd int, data byte[], addr string, timeout_ns duration) !int {
		// intrinsic
	}

	// Returns (n, addr_string).
	internal def __net_recv_from(fd int, data byte[], timeout_ns duration) !(int, string) {
		// intrinsic
	}

	// TCP dial helper: resolves + creates a socket + connects, returning a connected fd.
	internal def __net_dial_stream(addr string, timeout_ns duration) !int {
		// intrinsic
	}

	// Shutdown halves: 0=read, 1=write, 2=both.
	internal def __net_shutdown(fd int, how int) !none {
		// intrinsic
	}

	// Generic socket options (int-valued).
	internal def __net_setsockopt_int(fd int, level int, opt int, val int) !none {
		// intrinsic
	}

	internal def __net_getsockopt_int(fd int, level int, opt int) !int {
		// intrinsic
	}

	// High-level socket options (portable wrappers).
	internal def __net_set_nodelay(fd int, enabled bool) !none {
		// intrinsic
	}

	internal def __net_set_keepalive(fd int, enabled bool) !none {
		// intrinsic
	}

	internal def __net_set_reuseport(fd int, enabled bool) !none {
		// intrinsic
	}

	internal def __net_set_linger(fd int, enabled bool, seconds int) !none {
		// intrinsic
	}

	internal def __net_set_recvbuf(fd int, bytes int) !none {
		// intrinsic
	}

	internal def __net_set_sendbuf(fd int, bytes int) !none {
		// intrinsic
	}

	// Enumerate local network interfaces.
	//
	// Returns parallel arrays:
	// - names: interface names (e.g. "lo0", "eth0")
	// - indices: stable OS interface indices
	// - flags: ADM-stable bitmask derived from OS flags
	// - mtus: MTU (0 if unknown)
	// - hw_addrs: hardware/MAC address as "aa:bb:cc:dd:ee:ff" ("" if unknown/not applicable)
	// - addrs: per-interface list of IP addresses (no ports)
	internal def __net_ifaces() !(string[], int[], int[], int[], string[], string[][]) {
		// intrinsic
	}

	// Process intrinsics.
	internal def __proc_pid() int {
		// intrinsic
	}

	internal def __proc_exit(code int) {
		// intrinsic
	}

	internal def __proc_executable_path() string {
		// intrinsic
	}

	// Returns the current working directory for the process.
	internal def __proc_working_dir() string {
		// intrinsic
	}

	internal def __proc_start_wall_ns() int64 {
		// intrinsic
	}

	internal def __proc_start_mono_ns() int64 {
		// intrinsic
	}

	internal def __proc_uptime_ns() int64 {
		// intrinsic
	}

	// Environment intrinsics.
	internal def __env_get(key string) ?string {
		// intrinsic
	}

	internal def __env_set(key string, value string) !none {
		// intrinsic
	}

	// Service-manager intrinsics.
	internal def __services_names() string[] {
		// intrinsic
	}

	// The ADM ServiceStatus ordinal: 0=Unknown, 1=Starting, 2=Started,
	// 3=Stopping, 4=Stopped, 5=Restarting, 6=Failed.
	internal def __service_status(name string) int {
		// intrinsic
	}

	// Runs one lifecycle hook of the named service through the service
	// manager, which sets the status around it: 0 = start, 1 = stop,
	// 2 = restart.
	internal def __service_transition(name string, kind int) !none {
		// intrinsic
	}

	// Device buffers behind `std.gpu.DeviceBuffer<T>`. Handles are opaque;
	// 0 from upload and 1 from the copies mean failure, and __cuda_last_error
	// says why. The generic ones are filled in by the backends per instance.
	internal def __cuda_buffer_upload<T>(data T[]) uint {
		// intrinsic
	}

	internal def __cuda_buffer_download<T>(handle uint, into T[]) int {
		// intrinsic
	}

	internal def __cuda_buffer_write<T>(handle uint, from T[]) int {
		// intrinsic
	}

	internal def __cuda_buffer_len(handle uint) int {
		// intrinsic
	}

	internal def __cuda_buffer_free(handle uint) {
		// intrinsic
	}

	internal def __cuda_last_error() string {
		// intrinsic
	}

	// Whether a launch would use the GPU right now.
	internal def __cuda_available() bool {
		// intrinsic
	}

	internal def __cuda_device_name() string {
		// intrinsic
	}

	// What a call to a service's start(), stop() or restart() compiles to,
	// so the status is kept however the hook is invoked.
	internal async def __service_lifecycle(name string, kind int) !none {
		try __service_transition(name, kind)
		return none
	}

	// Runtime memory counters (heap allocations via adm_alloc/adm_free).
	internal def __mem_live_bytes() int64 {
		// intrinsic
	}

	internal def __mem_total_alloc_bytes() int64 {
		// intrinsic
	}

	internal def __mem_total_free_bytes() int64 {
		// intrinsic
	}

	internal def __mem_alloc_count() int64 {
		// intrinsic
	}

	internal def __mem_free_count() int64 {
		// intrinsic
	}

	// Deep retained footprint of a dynamically typed value. Shared allocations
	// are counted once and cyclic object graphs are traversed safely.
	internal def __mem_size_of(value any) int64 {
		// intrinsic
	}

	// Bit-cast helpers used by binary I/O.
	// These reinterpret the raw IEEE bits without numeric conversion.
	def __bitcast_f32_from_u32(bits uint32) float32;

	def __bitcast_u32_from_f32(value float32) uint32;

	def __bitcast_f64_from_u64(bits uint64) float64;

	def __bitcast_u64_from_f64(value float64) uint64;
}
