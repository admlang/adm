partial module builtin {
	use (
		std.glob::(Glob)
		std.services::(Policy, PolicyRequest)
	)

	// The principal stack: the compiler brackets every call into a
	// dependency package with `__policy_enter`/`__policy_leave`, and a gated
	// function asks the Policy service whether every package on the chain
	// holds its permission. The application is always the root of the
	// chain and never pushed.
	internal def __policy_enter(package string) {
		// intrinsic
	}

	internal def __policy_leave() {
		// intrinsic
	}

	// The distinct packages on the current task's chain, outermost first.
	internal def __policy_chain() string[] {
		// intrinsic
	}

	// What the OS sandbox applied at startup, "" when nothing was.
	internal def __sandbox_report() string {
		// intrinsic
	}

	// The prologue the compiler inserts into every gated function:
	// `try __policy_require("adm.storage.read")`.
	internal def __policy_require(permission string) !none {
		return Policy.require(PolicyRequest{action: permission})
	}

	// Inserted after the prologue for every `Constrain<string, S>` parameter:
	// `try __policy_validate("adm.storage.read", "std.services.PathSpec", path.value())`.
	internal def __policy_validate(permission string, spec string, value string) !none {
		return Policy.validate(permission, spec, value)
	}

	// The contract of a policy spec: the datatype that is the rule for one
	// permission. Its fields are `Rule<...>` or scalars, and `validate` decides
	// one argument against the merged rule of the caller's package.
	interface Spec<T> {
		def validate(value T) !none
	}

	// A parameter of a gated function that the Policy service checks against
	// the caller's grant before the body runs. A `T` converts to
	// `Constrain<T, S>` wherever one is expected (implicit constructor); the
	// wrapped value is read with `value()`.
	//
	// std names the common ones: `Path` is `Constrain<string, PathSpec>`,
	// `Endpoint` is `Constrain<string, EndpointSpec>`.
	type Constrain<T, S: Spec<T>> {
		internal inner T

		@implicit
		def new(v T) {
			inner = v
		}

		// The constrained value.
		def value() T {
			return inner
		}

		// The constrained value as text.
		def str() string {
			return "{inner}"
		}
	}

	// The outcome of `Rule.decide`: which list matched, or none of them.
	enum Decision {
		Undecided = 0,
		Allow     = 1,
		Deny      = 2,
		Ask       = 3,
	}

	// One constrained field of a spec. `decide` answers deny > allow > ask >
	// undecided. Patterns are globs (`*`, `?`, `\` quotes) over the value's
	// text; a pattern of the form `a.b.c.d/n` matches an IPv4 address inside
	// that network.
	type Rule<T> {
		allow T[]
		deny  T[]
		ask   T[]

		// Which list names the value: deny wins over allow, allow over ask; Undecided
		// when none matches.
		def decide(value T) Decision {
			return Decision.Deny when matchesAny(deny, value)
			return Decision.Allow when matchesAny(allow, value)
			return Decision.Ask when matchesAny(ask, value)
			return Decision.Undecided
		}

		// Whether any rule list names the value.
		def mentions(value T) bool {
			return decide(value) != Decision.Undecided
		}

		internal def matchesAny(patterns T[], value T) bool {
			let text = "{value}"
			for let pattern in patterns {
				return true when matchesPattern("{pattern}", text)
			}
			return false
		}
	}

	// Glob match, or an IPv4 network match when the pattern is `a.b.c.d/n`
	// and the value is a dotted quad.
	internal def matchesPattern(pattern string, text string) bool {
		if pattern.contains("/") {
			let network = parseIPv4Network(pattern)
			if network.len() == 2 {
				let address = parseIPv4(text)
				if address >= 0 {
					return (address & network[1]) == (network[0] & network[1])
				}
			}
		}
		let g = new Glob(pattern)
		return g.matches(text)
	}

	// `a.b.c.d/n` as `[address, mask]`, or empty when the text is not one.
	internal def parseIPv4Network(text string) int[] {
		let parts = text.split("/")
		return [] when parts.len() != 2
		let address = parseIPv4(parts[0])
		return [] when address < 0
		let bits = parts[1]
		return [] when bits == "" || bits.len() > 2 || !allDigits(bits)
		let n = parseInt<int>(bits)
		return [] when n < 0 || n > 32
		let mask = 0
		if n > 0 {
			mask = (0xFFFFFFFF << (32 - n)) & 0xFFFFFFFF
		}
		return [address, mask]
	}

	internal def allDigits(text string) bool {
		for let i = 0; i < text.len(); i++ {
			return false when text[i] < '0' || text[i] > '9'
		}
		return true
	}

	// The 32-bit value of a dotted quad, or -1 when the text is not one.
	internal def parseIPv4(text string) int {
		let parts = text.split(".")
		return -1 when parts.len() != 4
		let value = 0
		for let part in parts {
			return -1 when part == "" || part.len() > 3 || !allDigits(part)
			let octet = parseInt<int>(part)
			return -1 when octet > 255
			value = (value << 8) | octet
		}
		return value
	}
}
