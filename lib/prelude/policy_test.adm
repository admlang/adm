partial module builtin {
	use std.testing

	internal type AnySpec {
		def validate(value string) !none {
			return none
		}
	}

	check "Policy" {
		@test()
		def TestRuleDecidePrecedence() {
			let hosts = Rule<string>{
				allow: ["*.example.com"],
				deny: ["evil.example.com"],
				ask: ["*"],
			}
			assert hosts.decide("cdn.example.com") == Decision.Allow
			assert hosts.decide("evil.example.com") == Decision.Deny
			assert hosts.decide("other.org") == Decision.Ask
			assert hosts.mentions("other.org")

			let unset Rule<string>
			assert unset.decide("x") == Decision.Undecided
			assert !unset.mentions("x")
		}

		@test()
		def TestRuleNetworkPatterns() {
			let hosts = Rule<string>{allow: ["10.0.0.0/8"], deny: ["10.1.2.0/24", "192.168.0.1/32"]}
			assert hosts.decide("10.3.4.5") == Decision.Allow
			assert hosts.decide("10.1.2.9") == Decision.Deny
			assert hosts.decide("192.168.0.1") == Decision.Deny
			assert hosts.decide("192.168.0.2") == Decision.Undecided
			assert hosts.decide("10.1.2.x") == Decision.Undecided
			assert hosts.decide("example.com/8") == Decision.Undecided
		}

		@test()
		def TestRuleNonStringValues() {
			let ports = Rule<int>{allow: [80, 443], deny: [22]}
			assert ports.decide(443) == Decision.Allow
			assert ports.decide(22) == Decision.Deny
			assert ports.decide(8080) == Decision.Undecided
		}

		@test()
		def TestConstrainWrapsImplicitly() {
			let c Constrain<string, AnySpec> = "/tmp/x"
			assert c.value() == "/tmp/x"
			assert "{c}" == "/tmp/x"
		}
	}
}
