partial module builtin {
	use std.text.regex::(Program, Matcher, Anchor, compile, failedProgram)

	// The compiled program of `r`, made on first use and kept in the info
	// `r` shares with its copies (a literal's own, or the one `new regex`
	// keeps per pattern and flags).
	internal def regexProgram(r regex) Program {
		if !__regex_compiled(r) {
			let made = compile(r.pattern, __regex_flags(r).replace("g", "")) onerror (err error) {
				recover failedProgram(err.message)
			}
			// A zero regex has nowhere to keep it.
			return made unless __regex_keep(r, made)
		}
		return __regex_program(r)
	}

	// The flags of `r`.
	internal def __regex_flags(r regex) string {
		// intrinsic
	}

	// Whether `r`'s program is compiled.
	internal def __regex_compiled(r regex) bool {
		// intrinsic
	}

	// `r`'s compiled program.
	internal def __regex_program(r regex) Program {
		// intrinsic
	}

	// Keeps `program` for `r` unless another task kept one first; false for
	// a zero regex, which has nowhere to keep it.
	internal def __regex_keep(r regex, program Program) bool {
		// intrinsic
	}

	// regex is a compiled regular expression in RE2 syntax, written as a
	// literal `/pattern/flags`.
	//
	// ```
	// let digits = /\d+/
	// digits.test("id 42")                  // true
	// digits.replaceAll("a1b22", "#")      // "a#b#"
	// digits.split("a1b22c")               // ["a", "b", "c"]
	// ```
	//
	// Flags: `i` caseless, `m` `^` and `$` at line breaks, `s` `.` matches
	// `\n`, `U` lazy and greedy swapped, `g` replace every match. A pattern
	// compiles on first use, once for every copy of the regex.
	// RegexMatch is one match of a regex in a text.
	//
	// ```
	// let m = /(?P<user>[a-z]+)@([a-z]+)\.com/.find("write to ana@example.com today")
	// m.text      // "ana@example.com"
	// m.groups    // ["ana", "example"]
	// m.named     // {"user": "ana"}
	// m.start     // 9
	// ```
	struct RegexMatch {
		// The text that matched.
		text   string
		// Where the match starts in the searched text and where it ends
		// (one past its last character), counted in characters.
		start  int
		end    int
		// What each parenthesised group matched, in the order of their
		// opening parentheses; "" for a group that took no part in the
		// match.
		groups string[]
		// What each named group (`(?P<name>...)`) matched, by name.
		named  map<string, string>
	}

	@builtin(primitive = "regex")
	type regex {
		internal pattern string
		// The runtime's ADMRegexInfo (flags and compiled program, read
		// through `__regex_flags` and `regexProgram`), never read as text: it
		// holds the place the value's second word takes.
		internal info    string

		def new(pattern string, flags string) {
			// intrinsic: lowered by the compiler/runtime (`__regex_new`)
		}

		// Whether the pattern compiles. A literal's always does; one made with
		// `new regex(pattern, flags)` from text may not, and then matches
		// nothing.
		def valid() bool {
			return regexProgram(self).fault == ""
		}

		// Whether text contains a match.
		def test(text string) bool {
			return regexProgram(self).test(text)
		}

		// Every match in text, in order, as the matched text.
		def matchAll(text string) string[] {
			let raw = text.bytes()
			let m = regexProgram(self).matcher()
			let at = [0, 0]
			let out string[] = []
			let from = 0
			for from <= raw.len() && m.search(raw, from, Anchor.Unanchored, at) {
				out.push(string(raw[at[0]:at[1]]))
				from = after(raw, at)
			}
			return out
		}

		// Replaces the first `count` matches in text with replacement; a count of -1
		// replaces every match, as does the `g` flag with the default count.
		// In the replacement `$0` stands for the match, `$1` to `$9` and
		// `${name}` (or `${10}`) for a group, `$$` for a `$`.
		def replace(text string, replacement string, count = 1) string {
			let limit = count == 1 && __regex_flags(self).contains("g") ?? (-1, count)
			return text when limit == 0
			let p = regexProgram(self)
			let raw = text.bytes()
			let m = p.matcher()
			let at int[]
			at.len(replacement.contains("$") ?? (2 * p.names.len(), 2))
			let out = ""
			let copied = 0
			let from = 0
			let done = 0
			for from <= raw.len() && (limit < 0 || done < limit) && m.search(raw, from, Anchor.Unanchored, at) {
				out += string(raw[copied:at[0]])
				out += expand(replacement, raw, at, p)
				copied = at[1]
				done++
				from = after(raw, at)
			}
			return done == 0 ?? (text, out + string(raw[copied:]))
		}

		// Replaces every match in text with `delimiter`, the replacement text.
		def replaceAll(text string, delimiter string) string {
			return self.replace(text, delimiter, -1)
		}

		// The pieces of text between the matches. An empty match at the start
		// or the end of the text makes no empty piece.
		def split(text string) string[] {
			let raw = text.bytes()
			let m = regexProgram(self).matcher()
			let at = [0, 0]
			let out string[] = []
			let (start, end) = (0, 0)
			let from = 0
			for from <= raw.len() && m.search(raw, from, Anchor.Unanchored, at) {
				end = at[0]
				out.push(string(raw[start:end])) when at[1] != 0
				start = at[1]
				from = after(raw, at)
			}
			out.push(string(raw[start:])) when end != raw.len() || out.len() == 0
			return out
		}

		// The first match at or after character `start`, with what its
		// groups matched; none when there is none.
		def find(text string, start int = 0) ?RegexMatch {
			return none when start > text.len()
			let raw = text.bytes()
			let from = 0
			from = text.slice(0, start).bytes().len() when start > 0
			let at = self.spans(raw, from)
			return none when at.len() < 2
			let first = start > 0 ?? (start, 0)
			return matchAt(raw, at, first + charsIn(raw, from, at[0]))
		}

		// Every match in text, in order, each with what its groups matched.
		def findAll(text string) RegexMatch[] {
			let out RegexMatch[] = []
			let p = regexProgram(self)
			let raw = text.bytes()
			let m = p.matcher()
			let at int[]
			at.len(2 * p.names.len())
			let from = 0
			// The character index of byte `from`.
			let chars = 0
			for from <= raw.len() && m.search(raw, from, Anchor.Unanchored, at) {
				let found = matchAt(raw, at, chars + charsIn(raw, from, at[0]))
				out.push(found)
				from = after(raw, at)
				chars = found.end + (at[1] > at[0] ?? (0, 1))
			}
			return out
		}

		// The names of the groups in order, "" for an unnamed one.
		def names() string[] {
			let all = regexProgram(self).names
			return all.slice(1, all.len() - 1)
		}

		// The literal form, `/pattern/flags`.
		def explain() string {
			return "/" + pattern + "/" + __regex_flags(self)
		}

		// The byte offsets of the first match at or after byte `from` and
		// of its groups, as pairs of start and end; empty without a match.
		internal def spans(raw byte[], from int) int[] {
			return regexProgram(self).find(raw, from)
		}

		// Where the walk over the matches goes on after the match in `at`:
		// at its end, or a character later after an empty match.
		internal def after(raw byte[], at int[]) int {
			return at[1] when at[1] > at[0]
			return at[1] + 1 when at[1] >= raw.len()
			let lead = int(raw[at[1]])
			return at[1] + (lead < 0x80 ?? (1, lead < 0xE0 ?? (2, lead < 0xF0 ?? (3, 4))))
		}

		// The number of characters in bytes `from` to `to` of `raw`: the
		// bytes that are not UTF-8 continuation bytes.
		internal def charsIn(raw byte[], from int, to int) int {
			let n = 0
			for let i = from; i < to; i++ {
				n += int(raw[i]) & 0xC0 != 0x80 ?? (1, 0)
			}
			return n
		}

		// The match the offsets in `at` describe, starting at character
		// `start` of the text whose bytes are `raw`.
		internal def matchAt(raw byte[], at int[], start int) RegexMatch {
			let found = RegexMatch{text: string(raw[at[0]:at[1]]), start: start, named: new map<string, string>()}
			found.end = start + found.text.len()
			let names = regexProgram(self).names
			for let i = 2; i + 1 < at.len(); i += 2 {
				let group = at[i] < 0 ?? ("", string(raw[at[i]:at[i + 1]]))
				found.groups.push(group)
				found.named.set(names[i / 2], group) when names[i / 2] != ""
			}
			return found
		}

		// The replacement text for the match in `at`, its `$` references
		// filled in.
		internal def expand(replacement string, raw byte[], at int[], p Program) string {
			let out = ""
			let r = replacement.bytes()
			let i = 0
			for i < r.len() {
				let ch = int(r[i])
				if ch != 36 || i + 1 >= r.len() {
					let next = i + 1
					for next < r.len() && int(r[next]) != 36 {
						next++
					}
					out += string(r[i:next])
					i = next
					continue
				}
				let c = int(r[i + 1])
				if c == 36 {
					out += "$"
					i += 2
				} else if c >= 48 && c <= 57 {
					out += group(raw, at, c - 48)
					i += 2
				} else if c == 123 {
					let close = i + 2
					for close < r.len() && int(r[close]) != 125 {
						close++
					}
					if close >= r.len() {
						out += "$"
						i++
						continue
					}
					let name = string(r[i + 2:close])
					let index = p.names.indexOf(name)
					if index < 0 && name.len() > 0 {
						// `${10}`: a group by number.
						index = 0
						for let (_, d) in name.bytes() {
							index = (int(d) >= 48 && int(d) <= 57 && index >= 0) ?? (index * 10 + int(d) - 48, -1)
						}
					}
					out += group(raw, at, index)
					i = close + 1
				} else {
					out += "$"
					i++
				}
			}
			return out
		}

		// What group `n` (0 for the match) matched, "" when it took no part
		// or does not exist.
		internal def group(raw byte[], at int[], n int) string {
			return "" when n < 0 || 2 * n + 1 >= at.len() || at[2 * n] < 0
			return string(raw[at[2 * n]:at[2 * n + 1]])
		}
	}

	partial type string {
		// Reports whether the end of the string matches pattern.
		def endsWith(pattern regex) bool {
			return regexProgram(pattern).matchesAtEnd(self.bytes())
		}

		// Reports whether the start of the string matches pattern.
		def startsWith(pattern regex) bool {
			return regexProgram(pattern).matcher().search(self.bytes(), 0, Anchor.Start)
		}

		// Returns a copy with matches of pattern replaced by val.
		//
		// A negative count replaces every match.
		def replace(pattern regex, val string, count = -1) string {
			return pattern.replace(self, val, count)
		}

		// Reports whether any part of the string matches pattern.
		def contains(pattern regex) bool {
			return pattern.test(self)
		}

		// Returns a copy with every match of val removed.
		infix def - (val regex) string {
			return val.replace(self, "", -1)
		}
	}
}
