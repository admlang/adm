partial module prelude.tests {
	check "Regex" {
		use std.testing

		@test()
		def basics() {
			let digits = /[0-9]+/
			assert digits.test("id 42") && !digits.test("none")
			assert digits.matchAll("a1b22c333").join(",") == "1,22,333"
			assert digits.replace("a1b22", "#") == "a#b22"
			assert digits.replaceAll("a1b22", "#") == "a#b#"
			assert digits.split("a1b22c").join(",") == "a,b,c"
			assert digits.explain() == "/[0-9]+/"
		}

		@test()
		def find_gives_groups() {
			let mail = /([a-z]+)@([a-z]+)\.(com|org)/
			let m = mail.find("write to ana@example.com today")
			assert !(m is none)
			if !(m is none) {
				assert m.text == "ana@example.com" && m.start == 9 && m.end == 24
				assert m.groups.len() == 3 && m.groups[0] == "ana" && m.groups[1] == "example" && m.groups[2] == "com"
			}
			assert mail.find("nothing here") is none
			assert mail.find("ana@example.com", 1) is none == false
			let later = mail.find("a@b.com then c@d.org", 3)
			assert !(later is none)
			if !(later is none) {
				assert later.text == "c@d.org" && later.start == 13 && later.groups[2] == "org"
			}
			assert mail.find("a@b.com", 99) is none

			// A group that took no part in the match is empty.
			let alternatives = /(a)|(b)/
			let either = alternatives.find("xb")
			assert !(either is none)
			if !(either is none) {
				assert either.text == "b" && either.start == 1 && either.groups.len() == 2 && either.groups[0] == "" && either.groups[1] == "b"
			}
			// A pattern without groups has none.
			let number = /[0-9]+/
			let plain = number.find("ab 12")
			assert !(plain is none)
			if !(plain is none) {
				assert plain.groups.len() == 0 && plain.start == 3 && plain.end == 5
			}
		}

		@test()
		def positions_count_characters() {
			let word = /((é)+)((€)?)/
			let m = word.find("aé€ ééx")
			assert !(m is none)
			if !(m is none) {
				assert m.text == "é€" && m.start == 1 && m.end == 3 && m.groups[0] == "é" && m.groups[2] == "€"
			}
			let all = word.findAll("aé€ ééx é")
			assert all.len() == 3
			assert all[0].start == 1 && all[1].text == "éé" && all[1].start == 4 && all[1].end == 6 && all[1].groups[2] == "" && all[1].groups[0] == "éé"
			assert all[2].start == 8 && all[2].end == 9
			let from = word.find("aé€ ééx", 3)
			assert !(from is none)
			if !(from is none) {
				assert from.start == 4 && from.text == "éé"
			}
		}

		@test()
		def findAll_walks_the_text() {
			let pair = /([a-z]+)=([0-9]*)/
			let all = pair.findAll("a=1, bb=22,c= ; d")
			assert all.len() == 3
			assert all[0].groups.join(":") == "a:1" && all[1].groups.join(":") == "bb:22" && all[2].groups.join(":") == "c:"
			assert all[1].start == 5 && all[1].end == 10
			assert pair.findAll("").len() == 0 && pair.findAll("===").len() == 0
			// Empty matches move on a character at a time and end with the
			// text.
			let maybe = /x*/
			let gaps = maybe.findAll("axéb")
			assert gaps.len() == 5
			assert gaps[0].text == "" && gaps[0].start == 0 && gaps[1].text == "x" && gaps[1].start == 1 && gaps[2].start == 2 && gaps[3].start == 3 && gaps[4].start == 4
			// A line start is one only at the start of the text.
			let lineStart = /^a/
			assert lineStart.findAll("aaa").len() == 1
		}

		// RE2 syntax: Perl classes, named and non-capturing groups, inline
		// flags, lazy quantifiers, Unicode classes, counted repeats.
		@test()
		def re2_syntax() {
			assert /\d+/.matchAll("a1b22").join(",") == "1,22"
			assert /\w+@\w+/.test("mail ana@example now")
			assert /(?i)hello/.test("Say HELLO") && !/hello/.test("Say HELLO")
			assert /a+?/.matchAll("aaa").len() == 3
			assert /\p{Greek}+/.matchAll("abc αβγ δ").join(",") == "αβγ,δ"
			assert /é+/.matchAll("éé e é").join(",") == "éé,é"
			assert /^\d{3}-\d{4}$/.test("555-1234") && !/^\d{3}-\d{4}$/.test("55-1234")
			let m = /(?P<user>[a-z]+)@(?:[a-z]+)\.(com)/.find("to ana@example.com")
			assert !(m is none)
			if !(m is none) {
				assert m.groups.join(",") == "ana,com" && m.named["user"] == "ana"
			}
			assert /(?P<user>[a-z]+)@(x)/.names().join(",") == "user,"
		}

		// Replacements: group references, names, `$$`, and the `g` flag.
		@test()
		def replacements() {
			assert /(\w+)@(\w+)/.replace("ana@site", "$2 at $1") == "site at ana"
			assert /(?P<user>\w+)@/.replace("ana@site", "$\{user\}:") == "ana:site"
			assert /x/.replace("axb", "$$") == "a$b"
			assert /x/.replace("axbx", "-") == "a-bx"
			assert /x/g.replace("axbx", "-") == "a-b-"
			assert /x/.replace("axbx", "-", -1) == "a-b-"
			assert /x/.replace("axbx", "-", 0) == "axbx"
			assert /(a)|(b)/.replace("b", "[$1]") == "[]"
			assert /x*/.replaceAll("ab", "-") == "-a-b-"
		}

		// Split: empty matches at the ends make no empty pieces.
		@test()
		def splitting() {
			assert /,\s*/.split("a, b,c").join("|") == "a|b|c"
			assert /,/.split("a,").join("|") == "a|"
			assert /,/.split("").len() == 1
			assert /x*/.split("abc").join("|") == "a|b|c"
		}

		// The string methods that take a regex.
		@test()
		def string_methods() {
			assert "abc123".startsWith(/[a-z]+/) && !"123abc".startsWith(/[a-z]+/)
			assert "abc123".endsWith(/\d+/) && !"abc123x".endsWith(/\d+/)
			assert "ab12cd".contains(/\d/) && !"abcd".contains(/\d/)
			assert "a1b2".replace(/\d/, "#") == "a#b#"
			assert "a1b22" - /\d/ == "ab"
			assert "id 42" == /\d+/ && "id" != /\d+/
		}

		// A regex made from text: equal ones share a program and compare
		// equal, an invalid one matches nothing, and map keys follow `==`.
		@test()
		def runtime_patterns() {
			let made = new regex("ab+", "i")
			assert made.valid() && made.test("xABBy")
			assert made == /ab+/i && made != /ab+/ && made != /ab/i
			let broken = new regex("(a", "")
			assert !broken.valid() && !broken.test("a") && broken.matchAll("aaa").len() == 0
			assert !new regex("(?<!a)b", "").valid()
			let keys = new map<regex, int>()
			keys.set(/ab+/i, 1)
			assert made in keys && !(/ab+/ in keys)
		}
	}
	check "RegexSearcher" {
		use std.testing

		// The offsets of the match and groups, "none" without a match.
		def spans(s RegexSearcher, raw byte[], pairs int) string {
			let at int[]
			at.len(2 * pairs)
			s.groups(raw, at)
			return at.mapElem((v int) => v.str()).join(" ")
		}

		@test()
		def TestByteOffsets() {
			// The é is two bytes: offsets count bytes, as `find` counts characters.
			let raw = "é b=12".bytes()
			let s = /(\w+)=(\d+)/.searcher()
			assert s.search(raw)
			assert s.start() == 3 && s.end() == 7
			assert spans(s, raw, 3) == "3 7 3 4 5 7"
			assert s.search(raw, from = 4) == false
		}

		@test()
		def TestAnchoredAtAnOffset() {
			let raw = "ab cd".bytes()
			let s = /cd/.searcher()
			assert !s.search(raw, anchored = true)
			assert s.search(raw, from = 3, anchored = true)
			assert s.start() == 3 && s.end() == 5
			assert !s.search(raw, from = 2, anchored = true)
			assert s.search(raw, from = 2)
		}

		// Assertions see what stands before `from`.
		@test()
		def TestAssertionsSeeBeforeTheStart() {
			let raw = "xfoo foo".bytes()
			let s = /\bfoo/.searcher()
			assert !s.search(raw, from = 1, anchored = true)
			assert s.search(raw, from = 5, anchored = true)
			let line = /^b/m.searcher()
			let lines = "a\nb".bytes()
			assert line.search(lines, from = 2, anchored = true)
			assert !/^b/.searcher().search(lines, from = 2, anchored = true)
		}

		// `end` is the end of the text: `$` and `\b` hold there, and nothing past it matches.
		@test()
		def TestEndIsTheEndOfTheText() {
			let raw = "abcdef".bytes()
			let s = /abc$/.searcher()
			assert !s.search(raw)
			assert s.search(raw, end = 3)
			assert s.end() == 3
			let word = /c\b/.searcher()
			assert !word.search(raw)
			assert word.search(raw, end = 3)
			assert word.start() == 2
			let longer = /[a-z]+/.searcher()
			assert longer.search(raw, end = 4)
			assert longer.end() == 4
			assert !/e/.searcher().search(raw, end = 4)
			// With a first byte to skip to, too.
			assert !/ef/.searcher().search(raw, from = 1, end = 5)
			// An unanchored search finds where the match starts, within the end.
			let late = /d+$/.searcher()
			assert late.search(raw, end = 4)
			assert late.start() == 3
			// Groups read with the same end.
			let group = /(c)$/.searcher()
			assert group.search(raw, end = 3)
			assert spans(group, raw, 2) == "2 3 2 3"
		}

		// `limit` stops reading without changing what assertions see.
		@test()
		def TestLimitStopsReading() {
			let raw = "aaaaaaaaab".bytes()
			let s = /a+b/.searcher()
			assert !s.search(raw, limit = 4, anchored = true)
			assert s.scanned() == 5
			assert s.search(raw, anchored = true)
			assert s.scanned() >= 10
			// What matched by the limit is the answer.
			let greedy = /a+/.searcher()
			assert greedy.search(raw, limit = 4, anchored = true)
			assert greedy.end() == 4
			// `$` is not fooled by the limit.
			assert !/aaaa$/.searcher().search(raw, limit = 4, anchored = true)
			// A failure stops as soon as nothing can match.
			let none_ = /xyz/.searcher()
			assert !none_.search(raw, anchored = true)
			assert none_.scanned() <= 1
		}

		// A searcher is reused, and its slots hold what the last search found.
		@test()
		def TestReuse() {
			let raw = "k1=v1 k2=v2".bytes()
			let s = /(\w+)=(\w+)/.searcher()
			let at = [0, 0, 0, 0, 0, 0]
			let from = 0
			let keys string[]
			for s.search(raw, from = from) {
				s.groups(raw, at)
				keys.push(string(raw[at[2]:at[3]]))
				from = s.end()
			}
			assert keys.join(",") == "k1,k2"
			// A group outside the match, and more room than there are groups.
			let either = /(a)|(b)/.searcher()
			let wide = [0, 0, 0, 0, 0, 0, 0, 0]
			assert either.search("b".bytes())
			either.groups("b".bytes(), wide)
			assert wide.mapElem((v int) => v.str()).join(" ") == "0 1 -1 -1 0 1 -1 -1"
			// A regex without groups still reports the match.
			let plain = /b/.searcher()
			let two = [9, 9, 9, 9]
			assert plain.search("ab".bytes())
			plain.groups("ab".bytes(), two)
			assert two.mapElem((v int) => v.str()).join(" ") == "1 2 -1 -1"
		}
	}

	check "RegexRules" {
		use std.testing

		// The rule and end of an anchored search at `from`, "none" without a match.
		def hit(rules RegexRules, text string, from int = 0) string {
			let s = rules.searcher()
			return s.search(text.bytes(), from = from, anchored = true) ?? ("{s.rule()} {s.end()}", "none")
		}

		// The earliest rule that matches wins, as the alternatives of one pattern do.
		@test()
		def TestEarliestRuleWins() {
			let rules = new RegexRules(["if", "[a-z]+", "\\d+", "\\s+"])
			assert rules.valid() && rules.failure() == ""
			assert hit(rules, "if") == "0 2"
			assert hit(rules, "iffy") == "0 2"
			assert hit(rules, "else") == "1 4"
			assert hit(rules, "42x") == "2 2"
			assert hit(rules, "  x") == "3 2"
			assert hit(rules, "?") == "none"
			assert hit(rules, "a 42", 2) == "2 4"
			let reversed = new RegexRules(["[a-z]+", "if"])
			assert hit(reversed, "if") == "0 2"
		}

		// Assertions and flags work per rule, and a rule can match nothing at all.
		@test()
		def TestAssertionsAndFlags() {
			let rules = new RegexRules(["if\\b", "[a-z]+", "^#.*$", "$"], "m")
			assert hit(rules, "if x") == "0 2"
			assert hit(rules, "iffy") == "1 4"
			assert hit(rules, "a\n# c\nd", 2) == "2 5"
			assert hit(rules, "") == "3 0"
			let caseless = new RegexRules(["select", "(?-i)Z"], "i")
			assert hit(caseless, "SELECT") == "0 6"
			assert hit(caseless, "z") == "none"
			assert hit(caseless, "Z") == "1 1"
		}

		// Which rule, against the program of all the alternatives taken apart by groups.
		@test()
		def TestAgreesWithOneAlternation() {
			let patterns = ["<!--", "</?[a-zA-Z_][\\w:.-]*", "[a-zA-Z_:][\\w:.-]*", "\"[^\"]*\"", "'[^']*'", "=", "\\s+", "&\\w+;", "/?>"]
			let wrapped string[]
			for let (_, p) in patterns {
				wrapped.push("({p})")
			}
			let joined = new regex(wrapped.join("|"), "")
			let rules = new RegexRules(patterns)
			let raw = "<a href=\"x\" b:c='y' d>t &amp; u</a><!-- z --> <e/>".bytes()
			let one = rules.searcher()
			let other = joined.searcher()
			let at int[]
			at.len(2 * (patterns.len() + 1))
			let pos = 0
			let tokens = 0
			for pos < raw.len() {
				let a = one.search(raw, from = pos, anchored = true)
				let b = other.search(raw, from = pos, anchored = true)
				assert a == b
				if !a {
					pos++
					continue
				}
				other.groups(raw, at)
				let which = -1
				for let i = 0; i < patterns.len(); i++ {
					which = i when which < 0 && at[2 * (i + 1)] >= 0
				}
				assert one.rule() == which && one.end() == other.end()
				tokens++
				pos = one.end() > pos ?? (one.end(), pos + 1)
			}
			assert tokens > 15
		}

		// A rule's groups are numbered from its own pattern, whichever rule it is.
		@test()
		def TestGroupsOfTheRuleThatMatched() {
			let rules = new RegexRules(["(a)(b)", "x", "(c)(d)?"])
			assert rules.groups(0) == 2 && rules.groups(1) == 0 && rules.groups(2) == 2
			let s = rules.searcher()
			let at = [0, 0, 0, 0, 0, 0]
			let raw = "zabxc".bytes()
			assert s.search(raw, from = 1, anchored = true)
			s.groups(raw, at)
			assert at.mapElem((v int) => v.str()).join(" ") == "1 3 1 2 2 3"
			assert s.search(raw, from = 3, anchored = true) && s.rule() == 1
			s.groups(raw, at)
			assert at.mapElem((v int) => v.str()).join(" ") == "3 4 -1 -1 -1 -1"
			assert s.search(raw, from = 4, anchored = true) && s.rule() == 2
			s.groups(raw, at)
			assert at.mapElem((v int) => v.str()).join(" ") == "4 5 4 5 -1 -1"
		}

		// The leftmost match of any rule, and which it is.
		@test()
		def TestUnanchored() {
			let s = new RegexRules(["cd", "b+"]).searcher()
			let raw = "aabbcd".bytes()
			assert s.search(raw)
			assert s.rule() == 1 && s.start() == 2 && s.end() == 4
			assert s.search(raw, from = 4)
			assert s.rule() == 0 && s.start() == 4
			assert !s.search(raw, end = 2)
		}

		@test()
		def TestWhatDoesNotCompile() {
			let bad = new RegexRules(["a", "(b"])
			assert !bad.valid()
			assert bad.failure().startsWith("rule 1:")
			assert !bad.searcher().search("a".bytes())
			let noRules = new RegexRules([])
			assert noRules.valid() && !noRules.searcher().search("a".bytes())
			// Past the limit it does not compile, in a rule or in the whole list.
			let huge = new RegexRules(["\\pL\{1000}"], "", 1000)
			assert !huge.valid() && huge.failure().contains("too large")
			let many string[]
			for let i = 0; i < 100; i++ {
				many.push("word{i}")
			}
			let wide = new RegexRules(many, "", 100)
			assert !wide.valid()
			assert new RegexRules(many, "", 2000).valid()
		}

		// A DFA cache that starts over keeps which rule is which.
		@test()
		def TestSmallCacheKeepsRules() {
			let patterns string[]
			for let i = 0; i < 40; i++ {
				patterns.push("[a-m]*{"a".repeat(i)}x{i}y")
			}
			let rules = new RegexRules(patterns, "", 1 << 12)
			assert rules.valid()
			let s = rules.searcher()
			for let round = 0; round < 4; round++ {
				for let i = 0; i < 40; i++ {
					let text = "abcdefghijklm{"a".repeat(i)}x{i}y"
					assert s.search(text.bytes(), anchored = true)
					assert s.rule() == i && s.end() == text.len()
				}
			}
		}

		def countNumbers(rules RegexRules, raw byte[]) int {
			let s = rules.searcher()
			let count = 0
			let pos = 0
			for pos < raw.len() && s.search(raw, from = pos, anchored = true) {
				count += s.rule() == 2 ?? (1, 0)
				pos = s.end()
			}
			return count
		}

		// Shared between tasks, each with its own searcher.
		@test()
		def TestSharedBetweenTasks() {
			let rules = new RegexRules(["if", "[a-z]+", "\\d+", "\\s+"])
			let raw = "if else 42 while 7 ".repeat(200).bytes()
			let futures (async int)[]
			for let i = 0; i < 8; i++ {
				futures.push(async countNumbers(rules, raw))
			}
			for let f in futures {
				let got = await f
				assert got == 400
			}
		}

		// One search of many rules against the same work with groups telling them apart,
		// over a page of markup; the pass alone, the rules made once.
		def lexerText() byte[] {
			return "<svg width=\"10\" xlink:href='#a'><rect x=\"1\"/><!-- c --> text &amp; more</svg>\n".repeat(200).bytes()
		}

		def lexerPatterns() string[] {
			return ["<!--", "</?[a-zA-Z_][\\w:.-]*", "[a-zA-Z_:][\\w:.-]*", "\"[^\"]*\"", "'[^']*'", "=", "\\s+", "&\\w+;", "/?>", "[^<&\\s]+"]
		}

		def lexerRegex() regex {
			let wrapped string[]
			for let (_, p) in lexerPatterns() {
				wrapped.push("({p})")
			}
			return new regex(wrapped.join("|"), "")
		}

		let benchRaw = lexerText()
		let benchRules = new RegexRules(lexerPatterns()).searcher()
		let benchJoined = lexerRegex().searcher()
		def lexerSlots() int[] {
			let slots int[]
			slots.len(22)
			return slots
		}

		let benchSlots = lexerSlots()

		@benchmark()
		def BenchRulesOnePass() {
			let (raw, s) = (benchRaw, benchRules)
			let pos = 0
			for pos < raw.len() {
				pos = s.search(raw, from = pos, anchored = true) ?? (s.end().max(pos + 1), pos + 1)
			}
		}

		@benchmark()
		def BenchRulesAsOneRegexWithGroups() {
			let (raw, s, at) = (benchRaw, benchJoined, benchSlots)
			let pos = 0
			for pos < raw.len() {
				if s.search(raw, from = pos, anchored = true) {
					s.groups(raw, at)
					pos = s.end().max(pos + 1)
				} else {
					pos++
				}
			}
		}
	}
}
