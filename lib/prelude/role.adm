partial module builtin {
	// What a component is, for theme rules: a custom component with
	// `role = Role.Button` is selected by the rules written for buttons.
	enum Role {
		None,
		// Controls.
		Button,
		Link,
		Checkbox,
		Radio,
		Switch,
		Slider,
		TextField,
		ComboBox,
		Tab,
		MenuItem,
		Option,
		// Containers and structure.
		Panel,
		Group,
		Heading,
		Paragraph,
		List,
		ListItem,
		Table,
		Row,
		Cell,
		ColumnHeader,
		Tree,
		TreeItem,
		TabList,
		TabPanel,
		Menu,
		MenuBar,
		Toolbar,
		Dialog,
		Tooltip,
		Separator,
		Image,
		Figure,
		Code,
		ProgressBar,
		Status,
		Alert,
		// Landmarks: the parts of a page.
		Banner,
		Navigation,
		Main,
		Complementary,
		Search,
		Footer,
		Region,
	}
}
