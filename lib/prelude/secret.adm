partial module builtin {
	// A value that must not leak. A `T` converts to `Secret<T>` at any boundary
	// that expects one (implicit constructor); the only way back is `reveal()`.
	// Printing and interpolation render `***`, service events, the Policy log
	// and error reasons skip Secret values.
	//
	// Example: Passing a secret where one is expected
	// ```example
	// def connect(token Secret<string>) none {
	//     print("using {token}")   // prints: using ***
	// }
	//
	// connect("sk-live-1234")     // the string converts on the way in
	// ```
	type Secret<T> {
		internal inner T

		@implicit
		def new(v T) {
			inner = v
		}

		// The wrapped value. Every read of a secret goes through here, so a
		// search for `reveal(` lists them all.
		//
		// Example: Reading the value at the one place that needs it
		// ```example
		// let token Secret<string> = "sk-live-1234"
		// let header = "Bearer {token.reveal()}"
		// ```
		def reveal() T {
			return inner
		}

		// Renders as `***`; the value never prints.
		def str() string {
			return "***"
		}
	}
}
