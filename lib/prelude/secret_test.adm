partial module prelude.tests {
	// A prelude generic type whose field is named `value`: only
	// `@builtin(for = ...)` types treat `value` as `self`.
	internal type SecretTestHolder<T> {
		internal value T

		def new(v T) {
			value = v
		}

		def get() T {
			return value
		}
	}

	check "Secret" {
		use std.testing

		internal def length(s Secret<string>) int {
			return s.reveal().len()
		}

		@test()
		def RevealReturnsWrappedValue() {
			let s Secret<string> = "sk-live-1234"
			assert s.reveal() == "sk-live-1234"
		}

		@test()
		def ConvertsImplicitlyAtParameter() {
			assert length("hunter2") == 7
		}

		@test()
		def PrintsMasked() {
			let s Secret<int> = 42
			assert s.str() == "***"
			assert "{s}" == "***"
		}

		@test()
		def PreludeGenericValueFieldIsStorage() {
			let n = new SecretTestHolder<int>(42)
			let s = new SecretTestHolder<string>("hi")
			assert n.get() == 42
			assert s.get() == "hi"
		}
	}
}
