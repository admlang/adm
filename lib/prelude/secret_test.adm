partial module prelude.tests {
	// A prelude generic type whose field is named `value`: only
	// `@builtin(for = ...)` types treat `value` as `self`.
	internal type SecretTestHolder<T> {
		internal value T

		def new(v T) {
			value = v
		}

		def get() T {
			return value
		}
	}

	check "Secret" {
		use std.testing

		internal def length(s Secret<string>) int {
			return s.reveal().len()
		}

		@test()
		def RevealReturnsWrappedValue() {
			let s Secret<string> = "sk-live-1234"
			assert s.reveal() == "sk-live-1234"
		}

		@test()
		def ConvertsImplicitlyAtParameter() {
			assert length("hunter2") == 7
		}

		@test()
		def PrintsMasked() {
			let s Secret<int> = 42
			assert s.str() == "***"
			assert "{s}" == "***"
		}

		// Disposing a secret over a byte array zeroes the array, which any
		// other reference to it sees; a secret over a string disposes without
		// effect on the string.
		@test()
		def DisposeZeroesBytes() {
			let bytes = byte[1, 2, 3, 4]
			let s Secret<byte[]> = bytes
			// Called directly: `dispose s` on a secret made by the implicit
			// conversion does not reach dispose() today
			// (docs/features/memory/todo.md).
			s.dispose()
			assert bytes[0] == 0 && bytes[3] == 0
			let text = "keep"
			let t Secret<string> = text
			dispose t
			assert text == "keep"
		}

		@test()
		def PreludeGenericValueFieldIsStorage() {
			let n = new SecretTestHolder<int>(42)
			let s = new SecretTestHolder<string>("hi")
			assert n.get() == 42
			assert s.get() == "hi"
		}
	}
}
