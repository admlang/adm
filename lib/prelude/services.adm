partial module builtin {
	use (
		std.reflection::(MethodMetaContext, FunctionMetaContext)
		std.services::(Dependencies, Lifecycle, ServiceStatus)
		std.time::(Time)
	)

	// Event is what a `@commit` method produces when it runs: the service, the method
	// name, its arguments, its result and the time. `@on` observers receive it.
	struct Event<T> {
		source service
		name   string
		params map<string, any>
		result T
		time   Time
	}

	// ComponentEvent is what an `@emit` method of a component produces when it runs: the
	// component, the method name and its result. `@on(Component.method)` observers receive it.
	struct ComponentEvent<T> {
		source component
		name   string
		result T
	}

	// ComponentMatcher says which components a handler hears: the second argument of
	// `@on(Component.method, matcher)`, asked about the source of each event.
	interface ComponentMatcher {
		def matches(c component) bool
	}

	// EventMatcher says which events of a service a handler hears: the second argument of
	// `@on(Service.method, matcher)`, asked about the result of each event. `listener` is
	// the component whose method listens, none for a handler that is a function or a
	// method of anything else.
	interface EventMatcher<T> {
		def matchesEvent(result T, listener ?component) bool
	}

	// Whether an event's source is the component a ref member holds: the test behind
	// `@on(member.method)`.
	internal def __event_from_ref(source component, held ?component) bool {
		return !(held is none) && held == source
	}

	// A capability a service declares. The full name is
	// `<owner>.<service lowercased>.<name>` (`adm.storage.read` for the
	// builtin services); a gate names it with `@commit(policy = ...)`,
	// `@query(policy = ...)` or `@requires(...)`.
	struct Permission {
		// The name under the service's prefix, one segment.
		name        string
		// What granting it allows; shown by install prompts and `adm lib`.
		description string
		// The spec type whose `Rule` fields are the rule for this permission,
		// written as a type name (`spec: PathSpec`) and carried as that
		// type's qualified name.
		spec        string
	}

	// ServiceDescriptor is the metadata block a service declares: description,
	// dependencies, lifecycle and the permissions it defines.
	datatype ServiceDescriptor {
		// Service description
		description  string
		// List of services this service depends on
		dependencies Dependencies
		// Service lifecycle
		lifecycle    Lifecycle
		// The permissions this service declares
		permissions  Permission[]
	}

	// ServiceHooks are the lifecycle methods the service manager calls; a service
	// implements the ones it needs.
	interface ServiceHooks {
		def start() async !none
		def stop() async !none
		def restart() async !none
	}

	// Service is the base every service has: its current status.
	@builtin(for = service)
	type Service {
		// Service status
		status ServiceStatus = ServiceStatus.Unknown
	}

	internal type eventHandler = def (Event)

	// A `@on` annotated method declares a service event observer.
	meta def on<eventHandler>(target FunctionMetaContext, serviceMethod any, filter ?def(Event) bool) {
		// intrinsic
	}

	// The method form of `@on`.
	meta def on<eventHandler>(target MethodMetaContext, serviceMethod any, filter ?def(Event) bool) {
		// intrinsic
	}

	// Selector form: `@on(Service.method, "selector")` or `@on(Service.method, "selector", filter=...)`.
	// The selector string is service-defined (e.g. UI can interpret it as an id/class/component name).
	//	meta def on<eventHandler>(target FunctionMetaContext, serviceMethod any, selector string, filter ?def(Event) bool = none) {}
	//
	//	meta def on<eventHandler>(target MethodMetaContext, serviceMethod any, selector string, filter ?def(Event) bool = none) {}

	// Named event forms used by some services (notably UI) where the event name is a string.
	// Example: `@on(UI, "click", "someButtonId") def onClick(evt Event<ui.ClickEvent>) { ... }`.
	//	meta def on<eventHandler>(target FunctionMetaContext, source service, name string, selector string, filter ?def(Event) bool = none) {}
	//
	//	meta def on<eventHandler>(target MethodMetaContext, source service, name string, selector string, filter ?def(Event) bool = none) {}
	//
	//	meta def on<eventHandler>(target FunctionMetaContext, source service, name string, filter ?def(Event) bool = none) {}
	//
	//	meta def on<eventHandler>(target MethodMetaContext, source service, name string, filter ?def(Event) bool = none) {}

	// A `@commit` annotated method declares a primary event.
	// All commit annotated methods are implicitly atomic.
	// `policy` names the permission a caller must hold (`"read"` for the
	// declaring service's own, `"adm.storage.read"` for any); a gated
	// method must return an errorable.
	// Note: Only available in service context
	meta def commit(target MethodMetaContext, policy string = "") {
		// intrinsic
	}

	// `@on(Component.method, matcher)`: the handler hears the components the matcher matches.
	meta def on<eventHandler>(target FunctionMetaContext, componentMethod any, source ComponentMatcher) {
		// intrinsic
	}

	// The method form of `@on` with a matcher.
	meta def on<eventHandler>(target MethodMetaContext, componentMethod any, source ComponentMatcher) {
		// intrinsic
	}

	// `@on(Service.method, matcher)`: the handler hears the events the matcher matches.
	meta def on<eventHandler>(target FunctionMetaContext, serviceMethod any, matcher EventMatcher) {
		// intrinsic
	}

	// The method form of `@on` with an event matcher.
	meta def on<eventHandler>(target MethodMetaContext, serviceMethod any, matcher EventMatcher) {
		// intrinsic
	}

	// An `@emit` annotated method declares a named event which can only be emitted from the service or
	// component declaring it. They cannot be asynchronous and should be side-effect free.
	// Called inside a commit, the event reaches its handlers once the outermost commit has
	// completed, after that commit's own event. With `immediate = true` the handlers run at the
	// call, inside a commit too and while it holds its lock, so what they wrote into the event is
	// there when the emitting code goes on.
	// Note: Only available in a service or a component's controller
	meta def emit(target MethodMetaContext, immediate bool = false) {
		// intrinsic
	}

	// A `@query` annotated method do not produce events but can be called from user code to return state snapshot.
	// They cannot be asynchronous and should be side-effect free.
	// `policy` gates the query as it does a commit.
	// Note: Only available in service context
	meta def query(target MethodMetaContext, policy string = "") {
		// intrinsic
	}
}
