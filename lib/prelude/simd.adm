partial module builtin {
	// SIMD vector primitives.
	//
	// These are backend-defined value types meant to map to hardware SIMD when
	// available (C backend: clang/gcc vector extensions; LLVM backend later).
	//
	// All operations below are intended to be compiler/runtime intrinsics.
	// The bodies are intentionally empty so the front-end can typecheck APIs
	// before the backends implement lowering.

	// Allowed lane types for SIMD vectors.
	// Keep this intentionally small and backend-friendly.
	type SimdInteger = int | int8 | int16 | int32 | int64 | uint | uint8 | byte | uint16 | uint32 | uint64

	// Signed and unsigned integer subsets (useful for where-bounded SIMD ops).
	type SimdSigned = int | int8 | int16 | int32 | int64
	type SimdUnsigned = uint | uint8 | byte | uint16 | uint32 | uint64

	type SimdFloat = float32 | float64

	type SimdNumeric = SimdInteger | SimdFloat

	@builtin(primitive = "vec4")
	type vec4<T: SimdNumeric> {
		def new() {
			// intrinsic
		}

		// load reads 4 contiguous lane values from `src` starting at element index `index`.
		//
		// Notes:
		// - `index` is an element index (not a byte offset).
		// - Backends are expected to treat this as an intrinsic.
		def load(src T[], index int) vec4<T> {
			// intrinsic
		}

		// store writes this vector's 4 lane values into `dst` starting at element index `index`.
		//
		// Notes:
		// - `index` is an element index (not a byte offset).
		// - Backends are expected to treat this as an intrinsic.
		def store(dst T[], index int) none {
			// intrinsic
		}

		def splat(x T) vec4<T> {
			// intrinsic: broadcast x to all lanes
		}

		def lane(i int) T {
			// intrinsic: extract lane i
		}

		def withLane(i int, x T) vec4<T> {
			// intrinsic: set lane i to x
		}

		// Comparisons return a lane mask.
		// The mask can be used with `mask.blend(t, f)` to build branchless code.
		def eq(other vec4<T>) mask4<T> {
			// intrinsic
		}

		def ne(other vec4<T>) mask4<T> {
			// intrinsic
		}

		def lt(other vec4<T>) mask4<T> {
			// intrinsic
		}

		def le(other vec4<T>) mask4<T> {
			// intrinsic
		}

		def gt(other vec4<T>) mask4<T> {
			// intrinsic
		}

		def ge(other vec4<T>) mask4<T> {
			// intrinsic
		}

		// convert converts each lane to a new numeric lane type U.
		//
		// This is an element-wise numeric conversion (not a bitcast).
		def convert<U: SimdNumeric>() vec4<U> {
			// intrinsic
		}

		// bitcast reinterprets the underlying bytes as a vector with lane type U.
		//
		// This is a raw bit reinterpretation; it requires that the source and
		// destination vector sizes match.
		def bitcast<U: SimdNumeric>() vec4<U> {
			// intrinsic
		}

		// shuffle permutes lanes according to `indices`.
		//
		// For each lane i:
		// - let j = indices[i] % lane_count
		// - out[i] = self[j]
		//
		// Notes:
		// - This is a "single-source" shuffle (it only selects from `self`).
		// - Use `shuffle2` when you need to select from two vectors.
		def shuffle(indices vec4<byte>) vec4<T> {
			// intrinsic
		}

		// shuffle2 permutes lanes by selecting from `self` and `other`.
		//
		// For each lane i:
		// - let j = indices[i] % (2 * lane_count)
		// - if j < lane_count: out[i] = self[j]
		// - else:            out[i] = other[j - lane_count]
		def shuffle2(other vec4<T>, indices vec4<byte>) vec4<T> {
			// intrinsic
		}

		where T is SimdNumeric {
			// min/max/clamp are lane-wise operations.
			def min(other vec4<T>) vec4<T> { /* intrinsic */ }
			def max(other vec4<T>) vec4<T> { /* intrinsic */ }
			def clamp(lo vec4<T>, hi vec4<T>) vec4<T> { /* intrinsic */ }

			// zipLo/zipHi interleave lanes from two vectors.
			//
			// For N lanes:
			// - zipLo uses the lower half of `self` and `other`
			// - zipHi uses the upper half of `self` and `other`
			def zipLo(other vec4<T>) vec4<T> { /* intrinsic */ }
			def zipHi(other vec4<T>) vec4<T> { /* intrinsic */ }

			// Reductions across lanes.
			def sum() T { /* intrinsic */ }
			def minLane() T { /* intrinsic */ }
			def maxLane() T { /* intrinsic */ }

		def add(other vec4<T>) vec4<T> {
			// intrinsic
		}

		def sub(other vec4<T>) vec4<T> {
			// intrinsic
		}

		def mul(other vec4<T>) vec4<T> {
			// intrinsic
		}

		def div(other vec4<T>) vec4<T> {
			// intrinsic
		}

		infix def + (other vec4<T>) vec4<T> { return add(other) }
		infix def - (other vec4<T>) vec4<T> { return sub(other) }
		infix def * (other vec4<T>) vec4<T> { return mul(other) }
		infix def / (other vec4<T>) vec4<T> { return div(other) }
		}

		where T is SimdFloat {
			// abs is lane-wise absolute value.
			def abs() vec4<T> { /* intrinsic */ }

			// sqrt is lane-wise square root.
			def sqrt() vec4<T> { /* intrinsic */ }

			// rsqrt is lane-wise reciprocal square root: `1 / sqrt(x)`.
			def rsqrt() vec4<T> { /* intrinsic */ }

			// floor is lane-wise floor.
			def floor() vec4<T> { /* intrinsic */ }

			// ceil is lane-wise ceiling.
			def ceil() vec4<T> { /* intrinsic */ }

			// round is lane-wise round-to-nearest (ties away from zero, matching C round()).
			def round() vec4<T> { /* intrinsic */ }

			// trunc is lane-wise round-toward-zero.
			def trunc() vec4<T> { /* intrinsic */ }

			// fract is lane-wise fractional part: `x - floor(x)`.
			def fract() vec4<T> { /* intrinsic */ }

			// Elementary functions (lane-wise).
			// Backends may lower these to libm calls or vectorized math where available.
			def sin() vec4<T> { /* intrinsic */ }
			def cos() vec4<T> { /* intrinsic */ }
			def exp() vec4<T> { /* intrinsic */ }
			def log() vec4<T> { /* intrinsic */ }
			def log2() vec4<T> { /* intrinsic */ }
			def log10() vec4<T> { /* intrinsic */ }

			// fma computes lane-wise fused multiply-add when available: `(self * b) + c`.
			def fma(b vec4<T>, c vec4<T>) vec4<T> { /* intrinsic */ }

		// dot computes the scalar dot product: `sum(self[i] * other[i])`.
		def dot(other vec4<T>) T { /* intrinsic */ }
		}

		where T is SimdSigned {
		// abs is lane-wise absolute value.
		// Note: for the minimum signed value (e.g. int32.min), abs is not
		// representable; backends return the original value for that lane.
			def abs() vec4<T> { /* intrinsic */ }

			// addSat/subSat are lane-wise signed saturating arithmetic.
			def addSat(other vec4<T>) vec4<T> { /* intrinsic */ }
			def subSat(other vec4<T>) vec4<T> { /* intrinsic */ }

			// narrowSat converts lanes to the smaller signed type U with saturation.
			def narrowSat<U: SimdSigned>() vec4<U> { /* intrinsic */ }
		}

		where T is SimdUnsigned {
		// addSat/subSat perform lane-wise saturating arithmetic.
		// For example, byte(250) + byte(10) saturates to 255.
			def addSat(other vec4<T>) vec4<T> { /* intrinsic */ }
			def subSat(other vec4<T>) vec4<T> { /* intrinsic */ }

			// avg computes lane-wise rounded-down average without overflow.
			def avg(other vec4<T>) vec4<T> { /* intrinsic */ }

			// narrowSat converts lanes to the smaller unsigned type U with saturation.
			def narrowSat<U: SimdUnsigned>() vec4<U> { /* intrinsic */ }
		}

		where T is SimdInteger {
		// shl/shr are lane-wise shifts by a scalar count.
		def shl(count int) vec4<T> { /* intrinsic */ }
		def shr(count int) vec4<T> { /* intrinsic */ }

			// rotl/rotr are lane-wise bit rotations by a scalar count.
			def rotl(count int) vec4<T> { /* intrinsic */ }
			def rotr(count int) vec4<T> { /* intrinsic */ }

			// mulHi returns the high half of the lane-wise product.
			def mulHi(other vec4<T>) vec4<T> { /* intrinsic */ }

			// popcount returns the number of set bits per lane.
			def popcount() vec4<byte> { /* intrinsic */ }

			// clz/ctz return leading/trailing zero counts per lane.
			// For a lane value of 0, the result is the lane bit-width.
			def clz() vec4<byte> { /* intrinsic */ }
			def ctz() vec4<byte> { /* intrinsic */ }

			infix def << (count int) vec4<T> { return shl(count) }
			infix def >> (count int) vec4<T> { return shr(count) }
			infix def <<< (count int) vec4<T> { return rotl(count) }
			infix def >>> (count int) vec4<T> { return rotr(count) }

		def and(other vec4<T>) vec4<T> {
			// intrinsic
		}

		def or(other vec4<T>) vec4<T> {
			// intrinsic
		}

		def xor(other vec4<T>) vec4<T> {
			// intrinsic
		}

		infix def & (other vec4<T>) vec4<T> { return and(other) }
		infix def | (other vec4<T>) vec4<T> { return or(other) }
		infix def ^ (other vec4<T>) vec4<T> { return xor(other) }
		}
	}

	@builtin(primitive = "vec8")
	type vec8<T: SimdNumeric> {
		def new() {
			// intrinsic
		}

		def load(src T[], index int) vec8<T> {
			// intrinsic
