	// Lane masks produced by SIMD comparisons.
	//
	// Masks are opaque backend-defined values. They can be combined with bitwise
	// operators and used to select values without branching.
	@builtin(primitive = "mask4")
	type mask4<T: SimdNumeric> {
		def new() {
			// intrinsic
		}

		def any() bool {} // true if any lane is set

		def all() bool {} // true if all lanes are set

		def noneSet() bool {} // true if no lanes are set

		def lane(i int) bool {} // true if lane i is set

		def bits() uint64 {} // bit i is set when lane i is set

		def and(other mask4<T>) mask4<T> {
			// intrinsic
		}

		def or(other mask4<T>) mask4<T> {
			// intrinsic
		}

		def xor(other mask4<T>) mask4<T> {
			// intrinsic
		}

		def invert() mask4<T> {
			// intrinsic
		}

		def blend(t vec4<T>, f vec4<T>) vec4<T> {} // intrinsic

		infix def & (other mask4<T>) mask4<T> {
			return and(other)
		}

		infix def | (other mask4<T>) mask4<T> {
			return or(other)
		}

		infix def ^ (other mask4<T>) mask4<T> {
			return xor(other)
		}
	}

