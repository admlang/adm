		}

		def gt(other vec8<T>) mask8<T> {
			// intrinsic
		}

		def ge(other vec8<T>) mask8<T> {
			// intrinsic
		}

		def convert<U: SimdNumeric>() vec8<U> {
			// intrinsic
		}

		def bitcast<U: SimdNumeric>() vec8<U> {
			// intrinsic
		}

		def shuffle(indices vec8<byte>) vec8<T> {
			// intrinsic
		}

		def shuffle2(other vec8<T>, indices vec8<byte>) vec8<T> {
			// intrinsic
		}

		where T is SimdNumeric {
			def min(other vec8<T>) vec8<T> {
				// intrinsic
			}
			def max(other vec8<T>) vec8<T> {
				// intrinsic
			}
			def clamp(lo vec8<T>, hi vec8<T>) vec8<T> {
				// intrinsic
			}
			def zipLo(other vec8<T>) vec8<T> {
				// intrinsic
			}
			def zipHi(other vec8<T>) vec8<T> {
				// intrinsic
			}
			def sum() T {
				// intrinsic
			}
			def minLane() T {
				// intrinsic
			}
			def maxLane() T {
				// intrinsic
			}

			def add(other vec8<T>) vec8<T> {
				// intrinsic
			}
			def sub(other vec8<T>) vec8<T> {
				// intrinsic
			}
			def mul(other vec8<T>) vec8<T> {
				// intrinsic
			}
			def div(other vec8<T>) vec8<T> {
				// intrinsic
			}
			infix def + (other vec8<T>) vec8<T> { return add(other) }
			infix def - (other vec8<T>) vec8<T> { return sub(other) }
			infix def * (other vec8<T>) vec8<T> { return mul(other) }
			infix def / (other vec8<T>) vec8<T> { return div(other) }
		}

		where T is SimdFloat {
			def abs() vec8<T> {
				// intrinsic
			}
			def sqrt() vec8<T> {
				// intrinsic
			}
			def rsqrt() vec8<T> {
				// intrinsic
			}
			def floor() vec8<T> {
				// intrinsic
			}
			def ceil() vec8<T> {
				// intrinsic
			}
			def round() vec8<T> {
				// intrinsic
			}
			def trunc() vec8<T> {
				// intrinsic
			}
			def fract() vec8<T> {
				// intrinsic
			}
			def sin() vec8<T> {
				// intrinsic
			}
			def cos() vec8<T> {
				// intrinsic
			}
			def exp() vec8<T> {
				// intrinsic
			}
			def log() vec8<T> {
				// intrinsic
			}
			def log2() vec8<T> {
				// intrinsic
			}
			def log10() vec8<T> {
				// intrinsic
			}
			def fma(b vec8<T>, c vec8<T>) vec8<T> {
				// intrinsic
			}
			def dot(other vec8<T>) T {
				// intrinsic
			}
		}

		where T is SimdSigned {
			def abs() vec8<T> {
				// intrinsic
			}
			def addSat(other vec8<T>) vec8<T> {
				// intrinsic
			}
			def subSat(other vec8<T>) vec8<T> {
