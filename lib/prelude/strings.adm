partial module builtin {
	use (
		std.crypto
		std.strings
		std.validations
	)

	// Provides a canonical string representation of a value.
	interface Stringer {
		// Returns the value's string representation.
		def str() string
	}

	// An immutable sequence of Unicode code points, stored as UTF-8.
	//
	// Every position in the API is a code-point index: `len()` counts code
	// points, `s[i]` is the code point at index `i`, `s[a:b]` selects code
	// points, and `for let (i, ch) in s` yields code-point indexes. Byte-level
	// access goes through `bytes()`. Comparison is byte-wise, so no Unicode
	// normalization or case folding is applied. See the language
	// specification, "Strings", for the full contract.
	//
	// String methods return new values and do not modify the receiver.
	@builtin(primitive = "string")
	type string {
		// Returns the number of code points in the string (not bytes, not
		// grapheme clusters). Cached after the first call on heap strings.
		def len() int {
			// intrinsic: lowered by the compiler/runtime
		}

		// Returns this string followed by other.
		def concat(other string) string {
			return self + other
		}

		// Splits the string around separator and returns the resulting parts.
		//
		// A negative limit returns every part. An empty separator splits the
		// string into individual characters.
		def split(separator string, limit = -1) string[] {
			if self.len() == 0 {
				return [""]
			}
			if separator.len() == 0 {
				// Special case: split into characters
				let chars = string[]
				for let (_, r) in self {
					chars.push(string(r))
				}
				return chars
			}

			let result = string[]
			let start = 0
			let sepLen = separator.len()
			let selfLen = self.len()

			for let i = 0; i <= selfLen - sepLen; {
				if limit != -1 && result.len() >= limit - 1 {
					break
				}
				if self[i:i + sepLen] == separator {
					result.push(self[start:i])
					start = i + sepLen
					i += sepLen
				} else {
					i++
				}
			}

			result.push(self[start:])
			return result
		}

		// Reports whether the string ends with suffix.
		def endsWith(suffix string) bool {
			return self[-suffix.len():] == suffix
		}

		// Reports whether the end of the string matches pattern.
		def endsWith(pattern regex) bool {
			// intrinsic: lowered by the compiler/runtime (`__str_ends_with_regex`)
		}

		// Reports whether the string starts with prefix.
		def startsWith(prefix string) bool {
			return self[:prefix.len()] == prefix
		}

		// Reports whether the start of the string matches pattern.
		def startsWith(pattern regex) bool {
			// intrinsic: lowered by the compiler/runtime (`__str_starts_with_regex`)
		}

		// Returns a copy with occurrences of find replaced by val.
		//
		// A negative count replaces every occurrence.
		def replace(find string, val string, count = -1) string {
			let tmp = self.split(find)
			return tmp.join(val)
		}

		// Returns a copy with matches of pattern replaced by val.
		//
		// A negative count replaces every match.
		def replace(pattern regex, val string, count = -1) string {
			return pattern.replace(self, val, count)
		}

		// Reports whether the string contains text.
		def contains(text string) bool {
			return indexOf(text) != -1
		}

		// Reports whether any part of the string matches pattern.
		def contains(pattern regex) bool {
			return pattern.test(self)
		}

		// Returns the number of non-overlapping occurrences of substr.
		//
		// An empty substring has no occurrences and returns 0.
		def count(substr string) int {
			return 0 when substr == "" || substr.len() > self.len()

			let matches = 0
			let i = 0
			for i <= self.len() - substr.len() {
				if self[i:i + substr.len()] == substr {
					matches++
					i += substr.len()
				} else {
					i++
				}
			}
			return matches
		}

		// Removes prefix from the start of the string if present, once.
		// Returns the string unchanged when it does not start with prefix.
		//
		//     "repo.git".trimPrefix("repo")   // ".git"
		//     "repo.git".trimPrefix("x")      // "repo.git"
		//     "aaa".trimPrefix("a")           // "aa"
		def trimPrefix(prefix string) string {
			return self when prefix == "" || !self.startsWith(prefix)
			return self[prefix.len():]
		}

		// Removes suffix from the end of the string if present, once.
		// Returns the string unchanged when it does not end with suffix.
		//
		//     "repo.git".trimSuffix(".git")   // "repo"
		//     "repo.git".trimSuffix("x")      // "repo.git"
		def trimSuffix(suffix string) string {
			return self when suffix == "" || !self.endsWith(suffix)
			return self[:-suffix.len()]
		}

		// Removes leading and trailing characters that appear in cutset.
		// cutset is a set of characters, not a sequence, and defaults to
		// whitespace.
		//
		//     "  hi\t".trim()        // "hi"
		//     "xxhixx".trim("x")     // "hi"
		//     "<<hi>>".trim("<>")    // "hi"
		def trim(cutset string = " \t\n\r") string {
			return self when self == "" || cutset == ""
			return self.trimStart(cutset).trimEnd(cutset)
		}

		// Removes leading characters that appear in cutset, which is a set of
		// characters rather than a sequence. Defaults to whitespace.
		def trimStart(cutset string = " \t\n\r") string {
			return self when self == "" || cutset == ""

			let i = 0
			for i < self.len() {
				let found = false
				for let c in cutset {
					if c == self[i] {
						found = true
					}
				}
				if !found {
					return self when i == 0
					return self[i:]
				}
				i++
			}

			return self[i:]
		}

		// Removes trailing characters that appear in cutset, which is a set of
		// characters rather than a sequence. Defaults to whitespace.
		def trimEnd(cutset string = " \t\n\r") string {
			return self when self == "" || cutset == ""

			let n = self.len()
			let i = n
			for i > 0 {
				let found = false
				for let c in cutset {
					if c == self[i - 1] {
						found = true
					}
				}
				if !found {
					return self when i == n
					return self[:i]
				}
				i--
			}

			return self[:i]
		}

		// Returns the index of the first occurrence of text at or after start.
		//
		// Returns -1 when text is not found.
		def indexOf(text string, start int = 0) int {
			for let i in start..self.len() {
				if self[i:i + text.len()] == text {
					return i
				}
			}
			return -1
		}

		// Parses the string as an integer of type T in the specified base.
		def toInt<T: Integer>(base int = 10) T {
			return parseInt<T>(self, base)
		}

		// Returns the substring bounded by start, inclusive, and end, exclusive.
		//
		// An omitted end selects through the end of the string.
		def slice(start int = 0, end ?int = none) string {
			return self[start:] when end is none
			return self[start:end]
		}

		// Reports whether the string is empty after trimming spaces.
		def isEmpty() bool {
			return trim().len() == 0
		}

		// Splits text into normalized words for case-conversion methods.
		internal def caseWords() string[] {
			let words = string[]
			let current = ""

			for let (i, ch) in self {
				let isUpper = ch >= 'A' && ch <= 'Z'
				let isLower = ch >= 'a' && ch <= 'z'
				let isDigit = ch >= '0' && ch <= '9'
				let isWord = isUpper || isLower || isDigit || int(ch) > 127

				if !isWord {
					if current != "" {
						words.push(current.lower())
						current = ""
					}
					continue
				}

				let boundary = false
				if current != "" && isUpper {
					let previous = self[i - 1]
					let previousIsLower = previous >= 'a' && previous <= 'z'
					let previousIsDigit = previous >= '0' && previous <= '9'
					let nextIsLower = false
					if i + 1 < self.len() {
						let next = self[i + 1]
						nextIsLower = next >= 'a' && next <= 'z'
					}
					boundary = previousIsLower || previousIsDigit || nextIsLower
				}

				if boundary {
					words.push(current.lower())
					current = ""
				}
				current += string(ch)
			}

			words.push(current.lower()) when current != ""
			return words
		}

		// Converts the string to camelCase.
		def camelCase() string {
			let words = caseWords()
			return "" when words.len() == 0

			let result = words[0]
			for let i = 1; i < words.len(); i++ {
				let word = words[i]
				result += word[:1].upper() + word[1:]
			}
			return result
		}

		// Converts the string to kebab-case.
		def kebabCase() string {
			return caseWords().join("-")
		}

		// Converts the string to snake_case.
		def snakeCase() string {
			return caseWords().join("_")
		}

		// Converts the string to Start Case.
		def startCase() string {
			let words = caseWords()
			let result = string[]
			for let (_, word) in words {
				result.push(word[:1].upper() + word[1:])
			}
			return result.join(" ")
		}

		// Returns the string with its first character uppercase and the remainder lowercase.
		def capitalize() string {
			return self when self == ""
			let normalized = self.lower()
			return normalized[:1].upper() + normalized[1:]
		}

		// Returns the string with ASCII letters converted to lowercase.
		def lower() string {
			let result = ""
			for let (_, ch) in self {
				if ch >= 'A' && ch <= 'Z' {
					result += string(ch + char(32))
				} else {
					result += string(ch)
				}
			}
			return result
		}

		// Returns the string with ASCII letters converted to uppercase.
		def upper() string {
			let result = ""
			for let (_, ch) in self {
				if ch >= 'a' && ch <= 'z' {
					result += string(ch - char(32))
				} else {
					result += string(ch)
				}
			}
			return result
		}

		// Centers the string in a field of length characters using set as padding.
		def pad(length int, set string = " ") string {
			let req = length - self.len()
			let padLeft = set * (req / 2)
			let padRight = set * (length - self.len() - padLeft.len())
			return padLeft + self + padRight
		}

		// Pads the start of the string with set until it reaches length characters.
		def padStart(length int, set string = " ") string {
			return self when len() > length
			let pad = set * (length - self.len())
			return pad + self
		}

		// Pads the end of the string with set until it reaches length characters.
		def padEnd(length int, set string = " ") string {
			return self when len() > length
			let pad = set * (length - self.len())
			return self + pad
		}

		// Returns count consecutive copies of the string.
		def repeat(count int) string {
			return self * count
		}

		// Returns at most the first length characters of the string.
		//
		// Non-positive lengths leave the string unchanged.
		def truncate(length int) string {
			return self when length <= 0 || length >= self.len()
			return self[:length]
		}

		// Wraps text into lines no wider than width when possible.
		//
		// Words wider than width remain intact unless splitWord is true.
		def wrap(width int, splitWord bool = false) string {
			return self when self.len() <= width || width <= 0

			let words = self.replace("\n", " ").split(" ")
			let lines = string[]
			let currentLine = ""

			for let (_, word) in words {
				if word.len() == 0 {
					continue
				}

				if word.len() > width && !splitWord {
					if currentLine.len() > 0 {
						lines.push(currentLine)
					}
					lines.push(word)
					currentLine = ""
					continue
				}

				if word.len() > width && splitWord {
					if currentLine.len() > 0 {
						lines.push(currentLine)
						currentLine = ""
					}
					let remainingWord = word
					for remainingWord.len() > width {
						lines.push(remainingWord[:width])
						remainingWord = remainingWord[width:]
					}
					if remainingWord.len() > 0 {
						currentLine = remainingWord
					}
					continue
				}

				if currentLine.len() == 0 {
					currentLine = word
				} else if (currentLine.len() + 1 + word.len()) <= width {
					currentLine += " " + word
				} else {
					lines.push(currentLine)
					currentLine = word
				}
			}

			if currentLine.len() > 0 {
				lines.push(currentLine)
			}

			return lines.join("\n")
		}

		// Splits the string into words while preserving their original spelling.
		//
		// Whitespace and punctuation separate words. Apostrophes surrounded by word
		// characters remain part of the word.
		def words() string[] {
			let result = string[]
			let current = ""

			for let (i, ch) in self {
				let isUpper = ch >= 'A' && ch <= 'Z'
				let isLower = ch >= 'a' && ch <= 'z'
				let isDigit = ch >= '0' && ch <= '9'
				let isWord = isUpper || isLower || isDigit || int(ch) > 127

				let isInnerApostrophe = false
				if ch == '\'' && current != "" && i + 1 < self.len() {
					let next = self[i + 1]
					let nextIsUpper = next >= 'A' && next <= 'Z'
					let nextIsLower = next >= 'a' && next <= 'z'
					let nextIsDigit = next >= '0' && next <= '9'
					isInnerApostrophe = nextIsUpper || nextIsLower || nextIsDigit || int(next) > 127
				}

				if isWord || isInnerApostrophe {
					current += string(ch)
				} else if current != "" {
					result.push(current)
					current = ""
				}
			}

			result.push(current) when current != ""
			return result
		}

		// Returns the characters of the string in reverse order.
		def reverse() string {
			let tmp = self.split("")
			return tmp.reverse().join("")
		}

		// Returns the characters of the string in random order.
		def shuffle() string {
			let chars = string[]
			for let (_, ch) in self {
				chars.push(string(ch))
			}

			for let i = chars.len() - 1; i > 0; i-- {
				let j = crypto.randRange<int>(0, i + 1)
				chars[i], chars[j] = chars[j], chars[i]
			}
			return chars.join("")
		}

		// Splits the string into sentences terminated by '.', '!', or '?'.
		//
		// Any non-empty trailing text is returned as the final sentence.
		def sentences() string[] {
			let result = string[]
			let start = 0

			for let (i, ch) in self {
				if ch := '.' || '!' || '?' {
					// Found a sentence-ending punctuation.
					// The sentence is from `start` up to and including this character.
					let sentence = self[start:i + 1].trim()
					if sentence.len() > 0 {
						result.push(sentence)
					}
					// The next sentence starts after this punctuation.
					start = i + 1
				}
			}

			// After the loop, check if there's any remaining text that wasn't terminated by punctuation.
			if start < self.len() {
				let remaining = self[start:].trim()
				if remaining.len() > 0 {
					result.push(remaining)
				}
			}

			return result
		}

		// Formats the string using C-style placeholders and args as their values.
		//
		// `%s` writes text or calls `str()` when its value implements `Stringer`;
		// `%c` writes a character, `%d` or `%i` a signed decimal
		// integer, `%u` an unsigned decimal integer, `%o` an octal integer, and
		// `%x` or `%X` a hexadecimal integer. `%f` and `%F` write decimal
		// floating point, `%e` and `%E` use scientific notation, and `%g` and
		// `%G` choose the more compact decimal or scientific form. `%v` uses a
		// primitive value's natural representation, while `%%` writes one `%`.
		//
		// A placeholder has the form `%[flags][width][.precision][length]verb`.
		// For example, `%04d` pads 7 to `0007`, `%-4d` pads it on the right,
		// `%.2f` writes two digits after the decimal point, and `%.3s` writes at
		// most three characters. Flags include `-` for left alignment, `+` for
		// an explicit sign, space for a leading space on positive numbers, `0`
		// for zero padding, and `#` for forms such as the `0x` hexadecimal prefix.
		// Dynamic `*` width and precision are not supported.
		def format(args ...any) string {
			return strings.format(self, ...args)
		}

		// Splits the string into tokens around the recognized separators, which
		// are kept as tokens of their own: `"a+b*c".tokenize(["+", "*"])` is
		// `["a", "+", "b", "*", "c"]`. Longer separators win where two match
		// at one position; text between separators is trimmed and empty
		// pieces are dropped, so spacing around a separator does not create
		// tokens.
		def tokenize(recognized string[]) string[] {
			let out = string[]
			let start = 0
			let i = 0
			for i < self.len() {
				let best = ""
				for let (_, sep) in recognized {
					continue when sep == "" || sep.len() <= best.len()
					if i + sep.len() <= self.len() && self[i:i + sep.len()] == sep {
						best = sep
					}
				}
				if best == "" {
					i += 1
					continue
				}
				let before = self[start:i].trim()
				out.push(before) when before != ""
				out.push(best)
				i += best.len()
				start = i
			}
			let tail = self[start:].trim()
			out.push(tail) when tail != ""
			return out
		}

		// Splits the string at newline characters. The newlines are removed, and
		// a trailing "\r" is dropped so CRLF text yields the same lines as LF.
		// A trailing newline does not produce an empty final line.
		def lines() string[] {
			let result = string[]
			let old = 0
			for let (idx, chr) in self {
				if chr == '\n' {
					result.push(self[old:idx].trimEnd("\r"))
					old = idx + 1
					continue
				}
			}
			if old < self.len() {
				result.push(self[old:].trimEnd("\r"))
			}
			return result
		}

		// Returns the string with the given words removed, compared as whole
		// whitespace-separated words, case-insensitively; the remaining words
		// are joined by single spaces.
		def stopWords(words string[]) string {
			let lowered = string[]
			for let (_, w) in words {
				lowered.push(w.lower())
			}
			let kept = string[]
			for let (_, word) in self.split(" ") {
				let w = word.trim()
				continue when w == ""
				continue when lowered.includes(w.lower())
				kept.push(w)
			}
			return kept.join(" ")
		}

		// Expands spaces so each eligible line occupies width characters.
		//
		// Empty lines, the final line, and lines already at least width characters
		// wide are returned unchanged.
		def justify(width int) string {
			let lines = self.split("\n")
			let resultLines = string[]
			let numLines = lines.len()

			for let (i, line) in lines {
				if line.len() >= width || line.len() == 0 || i == numLines - 1 {
					resultLines.push(line)
					continue
				}

				let originalWords = line.split(" ")
				let words = string[]
				for let (_, w) in originalWords {
					if w.len() > 0 {
						words.push(w)
					}
				}

				if words.len() <= 1 {
					resultLines.push(line)
					continue
				}

				let wordsLen = words.join("").len()
				let spacesNeeded = width - wordsLen
				let gaps = words.len() - 1

				if gaps == 0 {
					resultLines.push(line)
					continue
				}

				let spacesPerGap = spacesNeeded / gaps
				let extraSpaces = spacesNeeded % gaps

				let justifiedLine = ""
				for let (j, word) in words {
					justifiedLine += word
					if j < gaps {
						justifiedLine += " " * spacesPerGap
						if j < extraSpaces {
							justifiedLine += " "
						}
					}
				}
				resultLines.push(justifiedLine)
			}

			return resultLines.join("\n")
		}

		// Reports whether text contains this string.
		def contained(text string) bool {
			return text.contains(self)
		}

		// Returns the Levenshtein edit distance between this string and other.
		def distance(other string) int {
			return strings.levenshteinDistance(self, other)
		}

		// Returns the UTF-8 byte representation of the string.
		def bytes() byte[] {
			return byte[](self)
		}

		// Returns a similarity score between this string and other.
		//
		// The algorithm defaults to normalized Levenshtein similarity. Available
		// alternatives are Dice, Hamming, Jaro, and Jaro-Winkler.
		def similarity(other string, algorithm strings.SimilarityAlgorithm = strings.SimilarityAlgorithm.Levenshtein) float {
			return strings.similarity(self, other, algorithm)
		}

		// Reports whether the string represents a truthy value.
		def isTruthy() bool {
			return validations.isTruthy(self)
		}

		// Reports whether the string contains a valid numeric value.
		def isNumeric() bool {
			return validations.isNumeric(self)
		}

		// Reports whether the string contains only alphabetic characters.
		def isAlpha() bool {
			return validations.isAlpha(self)
		}

		// Reports whether the string contains only alphabetic characters and digits.
		def isAlphanumeric() bool {
			return validations.isAlphanumeric(self)
		}

		// Reports whether the string is valid UTF-8.
		def isUTF8() bool {
			return validations.isUTF8(self)
		}

		// Reports whether the string is valid UTF-16 text.
		def isUTF16() bool {
			return validations.isUTF16(self)
		}

		// Reports whether the string contains only ASCII characters.
		def isASCII() bool {
			return validations.isASCII(self)
		}

		// Reports whether every character in the string is printable.
		def isPrintable() bool {
			return validations.isPrintable(self)
		}

		// Reports whether the string contains no uppercase ASCII letters.
		def isLower() bool {
			return lower() == self
		}

		// Reports whether the string contains no lowercase ASCII letters.
		def isUpper() bool {
			return upper() == self
		}

		// Reports whether the string is a valid hexadecimal value.
		def isHexadecimal() bool {
			return validations.isHexadecimal(self)
		}

		// Reports whether the string is valid Base64-encoded data.
		def isBase64() bool {
			return validations.isBase64(self)
		}

		// Reports whether the string is a valid UUID.
		def isUUID() bool {
			return validations.isUUID(self)
		}

		// Reports whether the string is a valid email address.
		def isEmail() bool {
			return validations.isEmail(self)
		}

		// Reports whether the string is a valid IP address.
		def isIP() bool {
			return validations.isIP(self)
		}

		// Reports whether the string is a valid URL.
		def isURL() bool {
			return validations.isURL(self)
		}

		// Reports whether the string contains valid JSON.
		def isJSON() bool {
			return validations.isJSON(self)
		}

		// Reports whether the string contains valid XML.
		def isXML() bool {
			return validations.isXML(self)
		}

		// Compares this string lexicographically with other.
		//
		// Returns -1 when this string sorts before other, 1 when it sorts after
		// other, and 0 when the strings are equal.
		def compare(other string) int {
			let l = self.len()
			l = other.len() when other.len() < l

			for let i = 0; i < l; i++ {
				let c1, c2 = self[i], other[i]
				return -1 when c1 < c2
				return 1 when c1 > c2
			}
			return -1 when l < other.len()
			return 1 when l > other.len()
			return 0
		}

		// Returns count consecutive copies of the string.
		infix def * (count int) string {
			return "" when count <= 0
			let res string[] = []
			res.len(count)
			res[:] = self
			let tmp = res.join("")
			return tmp
		}

		// Returns a copy with every occurrence of val removed.
		infix def - (val string) string {
			return replace(val, "")
		}

		// Returns a copy with every match of val removed.
		infix def - (val regex) string {
			return val.replace(self, "")
		}
	}
}
