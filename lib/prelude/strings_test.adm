partial module builtin {
	internal type StringFormatTestValue {
		value int

		def str() string {
			return "value=" + value.str()
		}
	}

	check "Strings" {
		use (
			std.strings
			std.testing
		)

		@test()
		def Truthy() {
			assert "yes".isTruthy() == true
			assert "tmp".isTruthy() == false
		}

		@test()
		def URLEncode() !none {
			assert "https://example.com".URLEncode() == "https%3A%2F%2Fexample.com"
			assert "hello world".URLEncode() == "hello%20world"
			assert "a/b?c=d&e".URLEncode() == "a%2Fb%3Fc%3Dd%26e"
			assert "abc-123_.~".URLEncode() == "abc-123_.~"
		}

		@test()
		def URLDecode() {
			assert "https%3A%2F%2Fexample.com".URLDecode() == "https://example.com"
			assert "hello%20world".URLDecode() == "hello world"
			assert "a%2Fb%3Fc%3Dd%26e".URLDecode() == "a/b?c=d&e"
			assert "invalid%2G".URLDecode() == "invalid "
			assert "incomplete%".URLDecode() == "incomplete%"
		}

		@test()
		def pad() {
			assert "hello".pad(3) == "hello"
			assert "hello".pad(5) == "hello"
			assert "hello".pad(6, "-") == "hello-"
			assert "hello".pad(7, "-") == "-hello-"
			assert "hello".pad(8, "-") == "-hello--"
		}

		@test()
		def padStart() {
			assert "hello".padStart(3) == "hello"
			assert "hello".padStart(5) == "hello"
			assert "hello".padStart(6, "-") == "-hello"
			assert "hello".padStart(7, "-") == "--hello"
		}

		@test()
		def padEnd() {
			assert "hello".padEnd(3) == "hello"
			assert "hello".padEnd(5) == "hello"
			assert "hello".padEnd(6, "-") == "hello-"
			assert "hello".padEnd(7, "-") == "hello--"
		}

		@test()
		def repeat() {
			assert "a".repeat(-2) == ""
			assert "a".repeat(0) == ""
			assert "a".repeat(3) == "aaa"
		}

		@test()
		def count() {
			assert "".count("a") == 0
			assert "banana".count("") == 0
			assert "banana".count("na") == 2
			assert "aaaa".count("aa") == 2
			assert "aaa".count("aa") == 1
			assert "banana".count("banana") == 1
			assert "banana".count("pear") == 0
			assert "short".count("longer") == 0
		}

		@test()
		def slice() {
			assert "hello".slice() == "hello"
			assert "hello".slice(1) == "ello"
			assert "hello".slice(1, 4) == "ell"
			assert "hello".slice(-2) == "lo"
			assert "hello".slice(0, -1) == "hell"
			assert "hello".slice(-4, -1) == "ell"
			assert "hello".slice(2, 2) == ""
			assert "héllo".slice(1, 2) == "é"
		}

		@test()
		def trimPrefixAndSuffix() {
			assert "repo.git".trimSuffix(".git") == "repo"
			assert "repo.git".trimPrefix("repo") == ".git"

			// Unchanged when the affix is absent.
			assert "repo.git".trimSuffix(".zip") == "repo.git"
			assert "repo.git".trimPrefix("x") == "repo.git"

			// Once, not repeatedly.
			assert "aaa".trimPrefix("a") == "aa"
			assert "aaa".trimSuffix("a") == "aa"

			// A sequence, not a character set: this is what trim() cannot do.
			assert "a.git".trimSuffix(".git") == "a"
			assert "a.git".trim(".git") == "a"

			assert "".trimPrefix("x") == ""
			assert "hi".trimPrefix("") == "hi"
			assert "hi".trimSuffix("") == "hi"
			// The whole string is a valid affix.
			assert "hi".trimPrefix("hi") == ""
			assert "hi".trimSuffix("hi") == ""
		}

		@test()
		def trim() {
			// Defaults to whitespace, not just spaces.
			assert "  hi  ".trim() == "hi"
			assert "\thi\n".trim() == "hi"
			assert " \t\r\n".trim() == ""
			assert "hi".trim() == "hi"
			assert "".trim() == ""

			// cutset is a SET of characters, so order and repetition do not
			// matter and any of them are stripped.
			assert "xxhixx".trim("x") == "hi"
			assert "<<hi>>".trim("<>") == "hi"
			assert "><hi><".trim("<>") == "hi"

			// Only the ends, never the middle.
			assert "xhix".trim("x") == "hi"
			assert "x h i x".trim("x") == " h i "
		}

		@test()
		def trimStartAndEnd() {
			assert "  hi  ".trimStart() == "hi  "
			assert "  hi  ".trimEnd() == "  hi"
			assert "##hi##".trimStart("#") == "hi##"
			assert "##hi##".trimEnd("#") == "##hi"
			// An empty cutset leaves the string alone.
			assert "  hi  ".trim("") == "  hi  "
		}

		@test()
		def lines() {
			assert "".lines().len() == 0

			let one = "one".lines()
			assert one.len() == 1 && one[0] == "one"

			let two = "a\nb".lines()
			assert two.len() == 2 && two[0] == "a" && two[1] == "b"

			// A trailing newline terminates the last line rather than adding
			// an empty one.
			let trailing = "a\nb\n".lines()
			assert trailing.len() == 2 && trailing[0] == "a" && trailing[1] == "b"

			let blank = "a\n\nb".lines()
			assert blank.len() == 3 && blank[0] == "a" && blank[1] == "" && blank[2] == "b"

			// CRLF yields the same lines as LF.
			let crlf = "a\r\nb\r\n".lines()
			assert crlf.len() == 2 && crlf[0] == "a" && crlf[1] == "b"
		}

		@test()
		def camelCase() {
			assert "".camelCase() == ""
			assert "hello world".camelCase() == "helloWorld"
			assert "Hello-world_value".camelCase() == "helloWorldValue"
			assert "  multiple   words  ".camelCase() == "multipleWords"
			assert "alreadyCamelCase".camelCase() == "alreadyCamelCase"
			assert "XMLHttpRequest".camelCase() == "xmlHttpRequest"
			assert "version 2 value".camelCase() == "version2Value"
			assert "déjà vu".camelCase() == "déjàVu"
		}

		@test()
		def kebabCase() {
			assert "".kebabCase() == ""
			assert "hello world".kebabCase() == "hello-world"
			assert "Hello_world-value".kebabCase() == "hello-world-value"
			assert "  multiple   words  ".kebabCase() == "multiple-words"
			assert "alreadyKebabCase".kebabCase() == "already-kebab-case"
			assert "XMLHttpRequest".kebabCase() == "xml-http-request"
			assert "version 2 value".kebabCase() == "version-2-value"
			assert "déjà vu".kebabCase() == "déjà-vu"
		}

		@test()
		def snakeCase() {
			assert "".snakeCase() == ""
			assert "hello world".snakeCase() == "hello_world"
			assert "Hello-world_value".snakeCase() == "hello_world_value"
			assert "  multiple   words  ".snakeCase() == "multiple_words"
			assert "alreadySnakeCase".snakeCase() == "already_snake_case"
			assert "XMLHttpRequest".snakeCase() == "xml_http_request"
			assert "version 2 value".snakeCase() == "version_2_value"
			assert "déjà vu".snakeCase() == "déjà_vu"
		}

		@test()
		def startCase() {
			assert "".startCase() == ""
			assert "hello world".startCase() == "Hello World"
			assert "Hello-world_value".startCase() == "Hello World Value"
			assert "  multiple   words  ".startCase() == "Multiple Words"
			assert "alreadyStartCase".startCase() == "Already Start Case"
			assert "XMLHttpRequest".startCase() == "Xml Http Request"
			assert "version 2 value".startCase() == "Version 2 Value"
			assert "déjà vu".startCase() == "Déjà Vu"
		}

		@test()
		def capitalize() {
			assert "".capitalize() == ""
			assert "hello".capitalize() == "Hello"
			assert "Hello".capitalize() == "Hello"
			assert "hELLO".capitalize() == "Hello"
			assert "hello world".capitalize() == "Hello world"
			assert "hello WORLD".capitalize() == "Hello world"
			assert "1st place".capitalize() == "1st place"
		}

		@test()
		def HTMLEncode() {
			assert "".HTMLEncode() == ""
			assert "plain text".HTMLEncode() == "plain text"
			assert "<div class=\"x\">Tom & Jerry's</div>".HTMLEncode() == "&lt;div class=&quot;x&quot;&gt;Tom &amp; Jerry&#39;s&lt;/div&gt;"
			assert "&amp;".HTMLEncode() == "&amp;amp;"
			assert "déjà 😀".HTMLEncode() == "déjà 😀"
		}

		@test()
		def HTMLDecode() {
			assert "".HTMLDecode() == ""
			assert "plain text".HTMLDecode() == "plain text"
			assert "&lt;div class=&quot;x&quot;&gt;Tom &amp; Jerry&#39;s&lt;/div&gt;".HTMLDecode() == "<div class=\"x\">Tom & Jerry's</div>"
			assert "&lt;&gt;&amp;&quot;&apos;&#39;".HTMLDecode() == "<>&\"''"
			assert "&#65; &#x41; &#X1F600;".HTMLDecode() == "A A 😀"
			assert "&copy; &amp &#xZZ; &#; &#x110000;".HTMLDecode() == "&copy; &amp &#xZZ; &#; &#x110000;"
		}

		@test()
		def words() {
			assert "".words().len() == 0
			assert "Hello, world!".words().join("|") == "Hello|world"
			assert "one\ttwo\nthree".words().join("|") == "one|two|three"
			assert "don't stop".words().join("|") == "don't|stop"
			assert "'quoted' rock'n'roll".words().join("|") == "quoted|rock'n'roll"
			assert "snake_case/kebab-case".words().join("|") == "snake|case|kebab|case"
			assert "Version2 BETA".words().join("|") == "Version2|BETA"
			assert "déjà vu".words().join("|") == "déjà|vu"
		}

		@test()
		def shuffle() {
			assert "".shuffle() == ""
			assert "a".shuffle() == "a"

			let shuffled = "aabbcc😀".shuffle()
			assert shuffled.len() == "aabbcc😀".len()
			assert shuffled.count("a") == 2
			assert shuffled.count("b") == 2
			assert shuffled.count("c") == 2
			assert shuffled.count("😀") == 1
		}

		@test()
		def format() {
			assert "hello %s".format("world") == "hello world"
			assert "%s is %d".format("answer", 42) == "answer is 42"
			assert "%08x".format(uint32(255)) == "000000ff"
			assert "%#X".format(uint16(48879)) == "0XBEEF"
			assert "%.2f".format(3.14159) == "3.14"
			assert "%+8.2f".format(12.5) == "  +12.50"
			assert "%c %% %v".format(char(65), true) == "A % true"
			assert "%s %d".format("only") == "only %d"
			assert "%q".format("unchanged") == "%q"
			assert "%s".format("déjà 😀") == "déjà 😀"
			assert "custom: %s".format(StringFormatTestValue{value: 42}) == "custom: value=42"
		}

		@test()
		def similarity() {
			assert "kitten".distance("sitting") == 3
			assert "same".similarity("same") == 1.0
			assert "😀a".similarity("😀b", strings.SimilarityAlgorithm.Hamming) == 0.5
		}

		@test()
		def wrap() {
			use std.services::(*)
			let x = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed vel semper mauris. Sed euismod, ligula in pharetra posuere, lectus ligula iaculis nulla, in semp"
			let wrapped = x.wrap(30)
			let lines = wrapped.lines()

			assert lines.len() == 6
		}

		@test()
		def sort() {
			assert "a".compare("b") == -1
		}

		@test()
		def toInt() {
			assert "255".toInt<uint16>() == uint16(255)
			assert "-42".toInt<int>() == -42
			assert "1010".toInt<uint16>(2) == uint16(10)
		}

		@test()
		def tokenize() {
			assert "a+b*c".tokenize(["+", "*"]).str() == ["a", "+", "b", "*", "c"].str()
			assert "x <= y".tokenize(["<=", "<", "="]).str() == ["x", "<=", "y"].str()
			assert "  a , b ,c ".tokenize([","]).str() == ["a", ",", "b", ",", "c"].str()
			assert "abc".tokenize([","]).str() == ["abc"].str()
			assert "".tokenize([","]).len() == 0
		}

		@test()
		def stopWords() {
			assert "the quick brown fox".stopWords(["the", "a"]) == "quick brown fox"
			assert "The Quick the fox".stopWords(["the"]) == "Quick fox"
			assert "no  double   spaces".stopWords([]) == "no double spaces"
			assert "".stopWords(["x"]) == ""
		}
	}
}
