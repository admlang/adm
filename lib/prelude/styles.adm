partial module builtin {
	use (
		std.reflection::(LetMetaContext)
		std.ui::(Geometry)
	)

	// Marks a `let` in a style body as one of the style's properties: the
	// values a component reads and sets as `style.name`, and what embedding
	// the style copies. A `let` without it is internal to the style body.
	//
	// inherit: an unset (`none`) value takes the nearest ancestor's whose style
	// has the same style embedded; the property's type must be optional.
	meta def styleProperty(ctx LetMetaContext, inherit bool = false) {
		// intrinsic
	}

	// Marks a `let` in a container's style as a property its children set, not
	// the container: a grid's `cell`, a row's `alignSelf`. A child of that
	// container accepts it in `style = {...}`.
	meta def childProperty(ctx LetMetaContext) {
		// intrinsic
	}

	// The base of every style. It embeds `std.ui.styles.Box` (size, limits,
	// margin, padding, position, anchors, layer, visible, align, direction).
	// Four names are reserved in every style body: `on`, the state overrides,
	// `variants`, the style's named sets of declarations, and `enter` and
	// `exit`, the looks a component appears from and leaves to.
	@builtin(for = style)
	internal type Style<T: style> {
		// The sets of the style's `variants` to apply, in order, after its
		// own declarations and before its `on` states:
		// `style = {variant: [primary, big]}`. A name the style does not
		// declare is an error. A theme rule may select by it, never set it.
		@styleProperty
		let variant string[] = []

		// Where layout put the component, valid after layout. Read as
		// `style.geom`, or `$ref.geom` for another component; never set.
		let geom Geometry = Geometry{}

		// The look the component animates from when it appears: `enter = {opacity: 0.0}`
		// in the style body. The function assigns the listed properties on the style
		// given, a `clone()` of this one, for the component given, which a value may
		// read (`self.tint`, `$parent.width`). none for a style that writes no `enter`.
		let enter ?def(look style, owner component) = none

		// The look the component animates to before it is removed, written and
		// applied like `enter`. A child whose style has one stays in its parent's
		// `leaving` once the view drops it, until `finishLeaving`.
		let exit ?def(look style, owner component) = none

		// The looks of the states that hold: `on = {hover: {background: tint}}` in the
		// style body, an entry per state with the properties it changes. A key is a
		// built-in state (`hover`, `pressed`, `focused`, `focusWithin`, `focusVisible`,
		// `disabled`, `dragging`, `dropTarget`), a `@state` bool field of the component,
		// or a case of one of its `@state` enum fields; `[hover, selected]` asks for
		// both, and so does an `on` inside an entry. Entries apply in the order
		// written. The compiler writes the two functions: `onStates` assigns, on the
		// style given, the entries whose states hold; `onAny` tells whether any would.
		// `owner` is the component, which a value may read as in `enter`; `held` is
		// `Component<T>.heldStates()`, and `state` answers for a state of the
		// component by name. none for a style that writes no `on`.
		internal let onStates ?def(look style, owner component, held int, state def(name string) bool) = none
		internal let onAny ?def(held int, state def(name string) bool) bool = none

		// The assignments of the style body that read another component's style
		// (`width = $parent.geom.bounds.width`, `anchors = {top: $field.geom.bottom}`):
		// the compiler writes the function, which makes them on the style given for
		// the component given, and the UI runtime calls it before each layout. An
		// assignment whose component is not there is not made. So are the assignments
		// that read the component itself (`gap = new Axes<Extent>(self.gap)`). It answers
		// whether any of them reads another component. none for a style without such
		// assignments.
		internal let bound ?def(look style, owner component) bool = none

		// The assignments of the style body that read the theme (`background =
		// new BackgroundFill(theme.palette.surface)`): the compiler writes the function,
		// which makes them on the style given from the theme of the component given (the
		// nearest one provided to it, `std.ui.themeOf`) as it is then. It is called when
		// the style is made, with no component yet, and by the UI runtime when the
		// component's theme is another one or changed. none for a style whose
		// assignments read no theme.
		internal let themed ?def(look style, owner ?component) = none

		// The style of the nearest component above that has a node, as of the last
		// layout: the look in effect there. none for the top of a tree and before the
		// first layout.
		internal let outer ?style = none

		// Fills what the style's inherited properties (`@styleProperty(inherit = true)`)
		// take from a style above; the compiler writes the function. For the
		// `origin`-th style whose inherited properties this one has, it copies them from
		// `from` when that style has them too and answers whether it did; `clear`
		// empties them instead. none for a style without inherited properties.
		internal let inherits ?def(look style, from style, origin int, clear bool) bool = none

		// How many styles' inherited properties `inherits` answers for.
		internal let inheritOrigins int = 0

		// Tells whether the style itself gave the field `field` of `property`, an
		// inherited property that holds a struct (`font`) and is inherited field by
		// field; the compiler writes the function. none for a style without such
		// properties.
		internal let names ?def(look style, property string, field string) bool = none

		// What the style's `variants` give the sets `names` lists: the function that
		// assigns what each set lists, in the order of `names`, and the two functions
		// of the states the sets' `on` list (as `onStates` and `onAny` are for the
		// style's own). The compiler writes them; none for a style without variants.
		internal let variantSet ?def(look style, owner component, names string[]) = none
		internal let variantStates ?def(look style, owner component, held int, state def(string) bool, names string[]) = none
		internal let variantAny ?def(held int, state def(string) bool, names string[]) bool = none

		// How many times a property of the style was assigned: the compiler counts.
		// The UI runtime keeps the look it made of the style while the count stands.
		internal let version int = 0

		// Builds the copy `clone()` returns; the compiler sets it for every style.
		internal let cloner ?def(from style) style = none

		// The look in effect while a state of the component holds: the copy of this
		// style with the properties its `on` gives those states, set by the UI runtime
		// before each layout and none while no state holds. A property read through a
		// component's `style` (`style.foreground`, `$field.width`) takes its value from
		// it; an assignment is always to the style itself.
		internal let shown ?style = none

		// What a hot build (`adm run --hot`) keeps to give the style what a reload
		// changed, none in any other build and in a copy: the function that gives
		// the style the properties its builder makes now, and the properties code
		// other than the style's own body assigned since it was built, which keep
		// their values.
		internal let hotRenew ?def(look style) = none
		internal let hotWritten ?string[] = none

		// A copy of the style with the same properties, of the same declaration.
		// Values are shared, not copied (`geom` is the same object), and the copy
		// is no component's `style`.
		def clone() style {
			let me style = self
			let make = cloner
			return me when make is none
			let made = make(me)
			made.shown = none
			made.hotRenew = none
			made.hotWritten = none
			return made
		}
	}

	// Gives `look` what its inherited properties take while unset: for each style
	// that declares some of them, the values of the nearest style, from `above`
	// upwards, that has that style's properties too; none of them when no style
	// above does. Called by the UI runtime before each layout, top down, with the
	// look in effect of the component above.
	def __style_inherit(look style, above ?style) {
		look.outer = above
		let take = look.inherits
		return when take is none
		for let origin = 0; origin < look.inheritOrigins; origin++ {
			__style_take(look, take, above, origin)
		}
	}

	// Whether `look` itself gives the field `field` of its property `property`, as
	// opposed to taking it from a style above: false while the property is unset, or
	// set by assignments that named other fields only (`font = {weight:
	// FontWeight.Bold}` names `weight`). True for any property that is not inherited
	// field by field.
	def __style_names(look style, property string, field string) bool {
		let names = look.names
		return true when names is none
		return names(look, property, field)
	}

	internal def __style_take(look style, take def(look style, from style, origin int, clear bool) bool, above ?style, origin int) {
		let from = above
		for {
			if from is none {
				take(look, look, origin, true)
				return
			}
			return when take(look, from, origin, false)
			from = from.outer
		}
	}

	// Called by a style's builder in a hot build, with the style it built.
	def __style_hot_keep(look style, renew def(look style)) {
		look.hotRenew = renew
		look.hotWritten = []
	}

	// Called in a hot build where code other than a style body assigns the
	// property `name` of `look`.
	def __style_hot_wrote(look style, name string) {
		let written = look.hotWritten
		return when written is none || written.includes(name)
		written.push(name)
		look.hotWritten = written
	}

	// Whether the property `name` of `look` keeps its value on a reload: code
	// other than the style's body assigned it. Called by the function that renews
	// the style.
	def __style_hot_kept(look style, name string) bool {
		let written = look.hotWritten
		return false when written is none
		return written.includes(name)
	}

	// Gives `look` the properties its builder makes now, but those other code
	// assigned, after a reload loaded new code. False for a style built without a
	// hot build. Called by the UI runtime on the first layout after a reload.
	def __style_hot_renew(look style) bool {
		let renew = look.hotRenew
		return false when renew is none
		renew(look)
		return true
	}

	// The style a property of `look` is read from: the look in effect when the UI
	// runtime gave it one (`Style<T>.shown`), else `look`. Called by the lowering of
	// a property read through a component's `style`.
	def __style_shown(look style) style {
		let shown = look.shown
		return look when shown is none
		return shown
	}
}
