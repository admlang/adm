partial module builtin {
	use (
		std.gfx.color::(*)
		std.math.geom::(*)
		std.ui
	)

	type StyleNode = ui.StyleNode
	type StyleClass = ui.StyleClass
	type StyleStates = ui.StyleStates
	type StyleChildren = ui.StyleChildren

	@builtin(for = style)
	internal type Style {
		color Color
		size  Size

		width float {
			def get() float {
				return size.width
			}

			def set(val float) {
				size.width = val
			}
		}

		height float {
			def get() float {
				return size.height
			}

			def set(val float) {
				size.height = val
			}
		}
		// opacity
		// size (width/heihgt)
		// position (x, y)
		// margin
		// padding
		// anchors
		// border
		// cursor
	}
}
