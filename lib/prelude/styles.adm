partial module builtin {
	use std.reflection::(LetMetaContext)

	// Marks a `let` in a style body as one of the style's properties: the
	// values a component reads and sets as `style.name`, and what embedding
	// the style copies. A `let` without it is internal to the style body.
	meta def styleProperty(ctx LetMetaContext) {
		// intrinsic
	}

	@builtin(for = style)
	internal type Style<T: style> {
		// When enabled, absolutely positioned descendants are positioned
		// relative to this component instead of the next outer positioning scope.
		@styleProperty
		let positionScope bool = false

		@range(0.0, 1.0)
		@styleProperty
		let opacity float = 1.0
		// opacity
		// size (width/heihgt)
		// position (x, y)
		// margin
		// padding
		// anchors
		// border
		// cursor
	}
}
