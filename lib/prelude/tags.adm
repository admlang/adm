partial module builtin {
	// The tag set of a reference value (spec §10.2). Tags are strings meant
	// for tracing, ownership tracking and policy checks; they belong to the
	// object, so they follow it through assignments, calls, container slots,
	// channel sends, futures and errors. A copy of a value (a new string from
	// `+`, `clone()`, a slice) starts with an empty set.
	//
	//     let request = makeRequest()
	//     request.tags().add("Network/primary")
	//     if request.tags().has("Network/primary") { ... }
	//
	// Mutators return the set so calls can chain.
	type TagSet {
		internal entries string[]

		// Adds a tag; adding one already present is a no-op.
		def add(tag string) TagSet {
			let t = tag.trim()
			if t == "" {
				return self
			}
			if has(t) {
				return self
			}
			entries.push(t)
			return self
		}

		// Removes a tag; removing an absent one is a no-op.
		def remove(tag string) TagSet {
			let t = tag.trim()
			let kept string[]
			for let e in entries {
				if e != t {
					kept.push(e)
				}
			}
			entries = kept
			return self
		}

		// Adds the tag when absent, removes it when present.
		def toggle(tag string) TagSet {
			if has(tag) {
				return remove(tag)
			}
			return add(tag)
		}

		// Whether the tag is present.
		def has(tag string) bool {
			let t = tag.trim()
			for let e in entries {
				if e == t {
					return true
				}
			}
			return false
		}

		// The tags, in insertion order.
		def list() string[] {
			let out string[]
			for let e in entries {
				out.push(e)
			}
			return out
		}

		// Applies a whitespace-separated spec: `+tag` adds, `-tag` removes,
		// a bare `tag` adds. The empty spec clears the set.
		def set(spec string) TagSet {
			let s = spec.trim()
			if s == "" {
				return clear()
			}
			for let word in s.split(" ") {
				let w = word.trim()
				if w == "" {
					continue
				}
				if w.startsWith("-") {
					remove(w[1:])
				} else if w.startsWith("+") {
					add(w[1:])
				} else {
					add(w)
				}
			}
			return self
		}

		// Removes every tag.
		def clear() TagSet {
			let cleared string[]
			entries = cleared
			return self
		}

		// Number of tags.
		def len() int {
			return entries.len()
		}

		// An independent copy of the set.
		def clone() TagSet {
			let out = new TagSet()
			for let e in entries {
				out.entries.push(e)
			}
			return out
		}
	}

	// Scalar values (numbers, structs, ...) have no object identity; their
	// tag sets are keyed by the address of the storage that holds them and
	// the compiler moves them with the value. These intrinsics reach the
	// runtime's slot table.
	internal def __tags_slot_lookup(addr int64) ?TagSet {
		// intrinsic
	}

	internal def __tags_slot_shared(addr int64) bool {
		// intrinsic
	}

	internal def __tags_slot_attach(addr int64, tags TagSet) {
		// intrinsic
	}

	// `x.tags()` for a scalar `x` lowers to this: the set stored for `x`'s
	// slot, cloned first when a copy still shares it (so tagging one value
	// never changes another), or a fresh one attached to the slot.
	def __tags_of_slot(addr int64) TagSet {
		let existing = __tags_slot_lookup(addr)
		if existing is TagSet {
			if __tags_slot_shared(addr) {
				let own = existing.clone()
				__tags_slot_attach(addr, own)
				return own
			}
			return existing
		}
		let created = new TagSet()
		__tags_slot_attach(addr, created)
		return created
	}

	// Runtime side table: the tag set attached to a reference value, if any.
	internal def __tags_lookup(value any) ?TagSet {
		// intrinsic
	}

	// Attaches a tag set to a reference value; the runtime owns it from then
	// on and drops it when the value is freed.
	internal def __tags_attach(value any, tags TagSet) {
		// intrinsic
	}

	// A heap copy of a string that has none (a literal), else the string
	// itself; either way a reference the caller owns.
	internal def __str_own(s string) string {
		// intrinsic
	}

	// `value.tags()` lowers to this: the existing set, or a fresh one attached
	// to the value.
	def __tags_of(value any) TagSet {
		let existing = __tags_lookup(value)
		if existing is TagSet {
			return existing
		}
		let created = new TagSet()
		__tags_attach(value, created)
		return created
	}
}
