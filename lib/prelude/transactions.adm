partial module builtin {
	// Transactional is a resource that ends with a `transaction` block: a
	// database transaction, a queue session. A resource joins the running
	// block the first time code inside the block uses it; when the block's
	// body is done the block calls `commitTx` on each resource in the order
	// they joined, and `rollbackTx` when the body failed or an earlier
	// resource's commit did.
	interface Transactional {
		// commitTx makes the resource's work permanent.
		// Fails when the resource cannot commit; the block then rolls back
		// the resources after it and fails with that error.
		def commitTx() !none

		// rollbackTx discards the resource's work.
		// Fails when the resource cannot roll back; the block ignores it.
		def rollbackTx() !none
	}

	// The resource that joined the running outermost `transaction` block
	// under `key` (the object `key` holds, e.g. a connection), or none when
	// nothing joined under it or no block is running. For libraries that
	// bind a resource to the block (`std.data.db`).
	def __tx_participant(key any) any {
		// intrinsic
	}

	// Joins `participant` to the running outermost `transaction` block
	// under `key`. Does nothing outside a block.
	def __tx_participate(key any, participant Transactional) {
		// intrinsic
	}

	// How many resources the block that is ending has to end: its own when
	// it is the outermost block, none for a nested one.
	internal def __tx_ending() int {
		// intrinsic
	}

	internal def __tx_ending_at(index int) any {
		// intrinsic
	}

	// Forgets the ending block's resources: they were committed or rolled back.
	internal def __tx_ended() {
		// intrinsic
	}

	// Commits the resources of the `transaction` block whose body is done.
	// Returns the first commit error, after rolling back the resources that
	// joined after the one that failed. Called by the block's lowering.
	def __tx_commit_participants() ?error {
		let count = __tx_ending()
		return none when count == 0
		let failure ?error = none
		for let i in 0..count {
			let part = __tx_ending_at(i)
			continue unless part is Transactional
			if failure is none {
				part.commitTx() onerror (err error) {
					failure = err
					recover none
				}
			} else {
				part.rollbackTx() onerror recover none
			}
		}
		__tx_ended()
		return failure
	}

	// Rolls back the resources of the `transaction` block that failed, the
	// last one that joined first. Called by the block's lowering.
	def __tx_rollback_participants() {
		let count = __tx_ending()
		return when count == 0
		for let i in 0..count {
			let part = __tx_ending_at(count - 1 - i)
			continue unless part is Transactional
			part.rollbackTx() onerror recover none
		}
		__tx_ended()
	}
}
