partial module builtin {
	use (
		std.math
		std.reflection::(ConstMetaContext, TypeMetaContext)
	)

	// Declares a dimension: a quantity type that is a float at run time, in
	// the base unit `unit`, which quantity literals name: `@dimension(unit =
	// "m") type Length` makes `100(m)` a `Length`. Values of different
	// dimensions do not mix. The unit symbol lives only in the unit table, so
	// `m` stays free as a name.
	meta def dimension(ctx TypeMetaContext, unit string) {
		// intrinsic
	}

	// The prefixed forms a `@unit` adds to the unit table.
	enum Prefixes {
		// No prefixed forms.
		None,
		// The SI prefixes from quecto (q) to quetta (Q): `km`, `mg`, `µs`.
		SI,
		// Decimal prefixes from kilo up and binary ones: `kB`, `MB`, `KiB`,
		// `MiB`.
		Data
	}

	// Declares a unit: the constant's value in its dimension, and the symbol
	// quantity literals name it by, with the prefixed forms `prefixes` adds.
	// `log = 20` (amplitude) or `log = 10` (power) makes a logarithmic unit
	// whose constant is the reference level: `@unit("dBm", log = 10) const
	// dBm Power = 1(mW)` makes `10(dBm)` 10 mW. Values stay linear; only
	// literals, `to` and `str` apply the log.
	// `@unit("g", prefixes = Prefixes.SI) const gram Mass = 0.001(kg)` makes
	// `5(mg)` a Mass. `offset` is added when a literal is written in the unit
	// alone, for scales whose zero is not the base unit's:
	// `@unit("°C", offset = 273.15) const celsius Temperature = 1(K)`.
	meta def unit(ctx ConstMetaContext, symbol string, prefixes Prefixes = Prefixes.None, offset float = 0.0, log float = 0.0) {
		// intrinsic
	}

	// A unit of the dimension D, as a parameter of this type receives it: the
	// argument is written as a unit, not an expression (`parseUnit("10 kg",
	// kg)`), and carries every unit of D visible where it was written.
	struct Unit<D> {
		// The unit in canonical form: `km/h`.
		symbol  string
		// Converts a value in this unit to base units: value · factor + offset,
		// or factor · 10^(value / log) for a logarithmic unit (log 20 or 10).
		factor  float
		offset  float
		log     float
		// The units of D visible at the argument, the unit itself included.
		symbols string[]
		factors float[]
		offsets float[]
		logs    float[]
	}

	// The quantity of D whose value in base units is value.
	internal def quantityOf<D>(unit Unit<D>, value float) D {
		// intrinsic
	}

	// A linear value as a level in a logarithmic unit: scale · log10(value /
	// reference), -inf for 0. `gain.to(dB)` and `p.str(dBm)` lower to it.
	internal def logLevel(value float, reference float, scale float) float {
		return scale * math.log10(value / reference)
	}
}
