partial module builtin {
	enum Align {
		Start,
		Center,
		End,
		Stretch
	}

	enum Distribution {
		// Aligns all children to the begining of the parent
		// |ABC----------------|
		Start,
		// Aligns all children to the center of the parent
		// |--------ABC--------|
		Center,
		// Aligns all children to the end of the parent
		// |----------------ABC|
		End,
		// SpaceBetween puts all extra space between the children, with no extra space at the outer edges.
		// |A--------B--------C|
		SpaceBetween,
		// SpaceAround gives each child equal space around itself, so the outer edges get half as much space as
		// the gaps between children:
		// |---A------B------C---|
		SpaceAround,
		// SpaceEvenly distributes the extra space evenly among the children and the edges
		// |----A----B----C----|
		SpaceEvenly
	}

	// The base of every view. A `view` value has no members: it can be stored
	// in a field, passed as an argument and placed by calling it.
	@builtin(for = view)
	internal type View<T: view> {}

	// One place where a `view` value is placed: each call that places one in a
	// component's view keeps its own, so a view placed twice is mounted twice.
	// Kept by the view code the compiler generates.
	internal type ViewPlacement {
		// The position in the host where its first component goes when it is
		// placed, and the position after its last one once it was.
		at int = 0

		// True when its components are the content of the host (the placing
		// stands in the block of a call) and not the host's own children.
		content bool = false

		// Which `view { ... }` was placed here last, and what that one keeps
		// between two runs: the components it built.
		body  string              = ""
		state ?ViewPlacementState = none
	}

	// What the body of a `view { ... }` keeps at one place; the compiler declares
	// one type per body and reads it back as that.
	internal type ViewPlacementState {}
}
