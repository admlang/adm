partial module builtin {

    enum Align {
        Start,
        Center,
        End,
        Stretch
    }

    enum Distribution {
        // Aligns all children to the begining of the parent
        // |ABC----------------|
        Start,
        // Aligns all children to the center of the parent
        // |--------ABC--------|
        Center,
        // Aligns all children to the end of the parent
        // |----------------ABC|
        End,
        // SpaceBetween puts all extra space between the children, with no extra space at the outer edges.
        // |A--------B--------C|
        SpaceBetween,
        // SpaceAround gives each child equal space around itself, so the outer edges get half as much space as
        // the gaps between children:
        // |---A------B------C---|
        SpaceAround,
        // SpaceEvenly distributes the extra space evenly among the children and the edges
        // |----A----B----C----|
        SpaceEvenly
    }

	@builtin(for = view)
	internal type View<T: view> {
		// not sure what views should have.
	}
}
