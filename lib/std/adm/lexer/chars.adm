// Character classes of the ADM lexical grammar. ASCII takes the short path
// everywhere; other code points are classified by their Unicode general
// category.
internal partial module std.adm.lexer.chars {
	use std.text.unicode

	// isWhitespace is true for the ASCII white space (space, tab, line feed,
	// carriage return, vertical tab, form feed) and the Unicode White_Space
	// code points: U+0085 and the space, line and paragraph separators.
	def isWhitespace(c char) bool {
		return c.isSpace() when c.isASCII()
		return true when c == '\u0085'
		let category = unicode.category(c)
		return category == unicode.Category.SpaceSeparator || category == unicode.Category.LineSeparator || category == unicode.Category.ParagraphSeparator
	}

	// isLetter is true for an ASCII letter or a code point of a Unicode
	// letter category (Lu, Ll, Lt, Lm, Lo).
	def isLetter(c char) bool {
		return c.isLetter() when c.isASCII()
		return unicode.category(c).ordinal <= unicode.Category.OtherLetter.ordinal
	}

	// isDigit is true for `0` to `9` or a decimal digit of another script
	// (category Nd).
	def isDigit(c char) bool {
		return c.isDigit() when c.isASCII()
		return unicode.category(c) == unicode.Category.DecimalNumber
	}

	// isMark is true for a nonspacing or spacing combining mark (Mn, Mc).
	def isMark(c char) bool {
		return false when c.isASCII()
		let category = unicode.category(c)
		return category == unicode.Category.NonspacingMark || category == unicode.Category.SpacingMark
	}

	// isIdentStart is true for a code point that starts an identifier: a
	// letter, `_`, `$` or `°` (so a unit argument such as `°C` lexes as a
	// name).
	def isIdentStart(c char) bool {
		return isLetter(c) || c == '_' || c == '$' || c == '°'
	}

	// isIdentContinue is true for a code point that continues an identifier:
	// what starts one, a digit, a superscript or subscript digit (`m/s²`),
	// or a combining mark (a decomposed `café` is one identifier).
	def isIdentContinue(c char) bool {
		return isLetter(c) || isDigit(c) || c == '_' || c == '$' || isUnitScript(c) || isMark(c)
	}

	// isUnitScript is true for the superscript and subscript digits and the
	// superscript minus that unit exponents are written with.
	def isUnitScript(c char) bool {
		switch c {
			case '¹', '²', '³', '⁰', '⁻':
				return true
			default:
				return (c >= '⁴' && c <= '⁹') || (c >= '₀' && c <= '₉')
		}
	}

	// continuesIdent is true for a code point that would carry a duration
	// unit on into an identifier (`10max`); a digit does not (`1h30m`).
	def continuesIdent(c char) bool {
		return isLetter(c) || c == '_'
	}

	// isValidScalar is true for a Unicode scalar value that a char literal
	// may hold: at most U+10FFFF, no surrogate, and neither U+FFFE nor
	// U+FFFF.
	def isValidScalar(cp int) bool {
		return cp <= 0x10FFFF && (cp < 0xD800 || (cp > 0xDFFF && cp != 0xFFFE && cp != 0xFFFF))
	}
}
