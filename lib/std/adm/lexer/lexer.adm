partial module std.adm.lexer {
	use (
		std.adm.lexer.chars::*
		std.text.unicode
	)

	// tokenize is every token of the source in order, ending with EOF. With
	// `comments` false, comments are skipped instead of reported; with
	// `whitespace` true, every line break is a Newline token and every other
	// run of white space a Whitespace token, so the tokens spell the source.
	//
	// ```
	// let tokens = tokenize("let x = 1")
	// tokens[0].kind == TokenKind.Let && tokens[1].text == "x"
	// ```
	def tokenize(source string, comments bool = true, whitespace bool = false) Token[] {
		let lexer = new Lexer(source, comments, whitespace)
		let out Token[]
		for {
			let tok = lexer.next()
			out.push(tok)
			break when tok.kind == TokenKind.EOF
		}
		return out
	}

	// Lexer reads ADM source one token at a time, as the compiler's own
	// lexer does: identifiers in NFC, numbers with space separators and
	// unit suffixes, interpolated strings as string segments around the
	// tokens of each `{expr}`, regex literals where an operand can start,
	// nested block comments. It never fails: text that is no token comes
	// back as an Illegal token, and after the last token every call returns
	// EOF.
	//
	// ```
	// let lexer = new Lexer("x += 1")
	// let tok = lexer.next()
	// for tok.kind != TokenKind.EOF {
	// 	println("{tok.kind.name} {tok.text}")
	// 	tok = lexer.next()
	// }
	// ```
	type Lexer {
		internal src       string
		internal chars     char[]
		internal pos       int       = 0
		internal prev      TokenKind = TokenKind.EOF
		// Where the previous token ended, and whether it was a tuple index.
		internal prevEnd   int       = -1
		internal prevIndex bool      = false
		internal pending   Token[]
		internal pendingAt int       = 0
		internal comments  bool      = true
		internal spaces    bool      = false

		// With `comments` false, comments are skipped instead of reported;
		// with `whitespace` true, white space and line breaks are reported
		// as Whitespace and Newline tokens.
		def new(source string, comments bool = true, whitespace bool = false) {
			self.src = source
			self.chars = unicode.codePoints(source)
			self.comments = comments
			self.spaces = whitespace
		}

		// next is the next token; EOF at the end, again on every later call.
		def next() Token {
			if pendingAt < pending.len() {
				let tok = pending[pendingAt]
				pendingAt++
				if pendingAt == pending.len() {
					pending.len(0)
					pendingAt = 0
				}
				noteToken(tok.kind, tok.end)
				return tok
			}
			return lexNext()
		}

		// noteToken records the token just produced, for the decisions that
		// depend on the previous token: whether `/` starts a regex and
		// whether `.` before a digit is a tuple index.
		internal def noteToken(kind TokenKind, end int) {
			return when kind == TokenKind.Comment || kind == TokenKind.Whitespace || kind == TokenKind.Newline
			prev = kind
			prevEnd = end
			prevIndex = false
		}

		// afterOperand is true when the token that ends at `at`, with nothing
		// between it and the cursor, is an operand a tuple index can follow:
		// a name, `)`, `]`, `self`, or a tuple index itself.
		internal def afterOperand(at int) bool {
			return false when prevEnd != at
			switch prev {
				case TokenKind.Ident, TokenKind.RParen, TokenKind.RBrack, TokenKind.Self:
					return true
				case TokenKind.Integer:
					return prevIndex
				default:
					return false
			}
		}

		// takeRaw is the next token without the bookkeeping of `prev`: what
		// a string interpolation collects.
		internal def takeRaw() Token {
			if pendingAt < pending.len() {
				let tok = pending[pendingAt]
				pendingAt++
				return tok
			}
			return lexNext()
		}

		// queueFirst puts `tokens` before whatever is pending.
		internal def queueFirst(tokens Token[]) {
			pending = tokens + pending[pendingAt:]
			pendingAt = 0
		}

		internal def eof() bool {
			return pos >= chars.len()
		}

		// peek is the character at the cursor, char(0) at the end.
		internal def peek() char {
			return char(0) when pos >= chars.len()
			return chars[pos]
		}

		// peekN is the character `n` places after the cursor, char(0) past
		// the end.
		internal def peekN(n int) char {
			let at = pos + n
			return char(0) when at >= chars.len()
			return chars[at]
		}

		// advance consumes one character and returns it, char(0) at the end.
		internal def advance() char {
			return char(0) when pos >= chars.len()
			let c = chars[pos]
			pos++
			return c
		}

		// retreat undoes the last advance of a character.
		internal def retreat() {
			pos--
		}

		// consumeUntil advances to the end of the line or past `end`,
		// whichever comes first.
		internal def consumeUntil(end char) {
			for {
				let c = peek()
				return when c == char(0) || c == '\n'
				advance()
				return when c == end
			}
		}

		// lexWhitespace is a Newline token for the line break `r` starts
		// (`\r\n` as one), or a Whitespace token for the run of other white
		// space `r` starts.
		internal def lexWhitespace(start int, r char) Token {
			if r == '\r' {
				advance() when peek() == '\n'
				return emit(TokenKind.Newline, start)
			}
			return emit(TokenKind.Newline, start) when r == '\n'
			for isWhitespace(peek()) && peek() != '\n' && peek() != '\r' {
				advance()
			}
			return emit(TokenKind.Whitespace, start)
		}

		internal def skipWhitespace() {
			for pos < chars.len() && isWhitespace(chars[pos]) {
				pos++
			}
		}

		// emit is the token of `kind` from `start` to the cursor.
		internal def emit(kind TokenKind, start int) Token {
			noteToken(kind, pos)
			return Token{kind: kind, start: start, end: pos, text: textOf(kind, start, pos)}
		}

		internal def textOf(kind TokenKind, start int, end int) string {
			switch kind {
				case TokenKind.Ident:
					return identifier(start, end)
				case TokenKind.String, TokenKind.Char, TokenKind.Integer, TokenKind.Float, TokenKind.Imaginary, TokenKind.Bool, TokenKind.None, TokenKind.Duration, TokenKind.Regex, TokenKind.Comment, TokenKind.Illegal:
					return src[start:end]
				case TokenKind.Whitespace, TokenKind.Newline:
					return spaceText(start, end)
				case TokenKind.InterpLBrace:
					return "\{"
				case TokenKind.InterpRBrace:
					return "\}"
				default:
					return kind.value
			}
		}

		// spaceText is the text of a white space token; the common single
		// characters are shared constants rather than slices.
		internal def spaceText(start int, end int) string {
			if end - start == 1 {
				let c = chars[start]
				return " " when c == ' '
				return "\n" when c == '\n'
				return "\t" when c == '\t'
			}
			return "\r\n" when end - start == 2 && chars[start] == '\r' && chars[start + 1] == '\n'
			return "\t\t" when end - start == 2 && chars[start] == '\t' && chars[start + 1] == '\t'
			return src[start:end]
		}

		// identifier is the spelling of the identifier in NFC, so `café`
		// written either way names one thing. ASCII is already NFC.
		internal def identifier(start int, end int) string {
			let text = src[start:end]
			return text when text.isASCII()
			return unicode.normalize(text)
		}

		internal def lexNext() Token {
			for {
				let start = pos
				let r = advance()

				if r == char(0) {
					noteToken(TokenKind.EOF, pos)
					return Token{kind: TokenKind.EOF, start: pos, end: pos, text: ""}
				}

				if isWhitespace(r) {
					return lexWhitespace(start, r) when spaces
					skipWhitespace()
					continue
				}

				if isIdentStart(r) {
					for isIdentContinue(peek()) {
						advance()
					}
					let text = src[start:pos]
					let reserved = keywordKind(text)
					if reserved is TokenKind {
						noteToken(reserved, pos)
						return Token{kind: reserved, start: start, end: pos, text: text}
					}
					noteToken(TokenKind.Ident, pos)
					return Token{kind: TokenKind.Ident, start: start, end: pos, text: identifier(start, pos)}
				}

				if isDigit(r) {
					let before = prev
					if before == TokenKind.Dot && prevEnd == start {
						// A tuple index: digits only, so `nested.0.1` is two
						// elements and `pair.0(x)` a call.
						for isDigit(peek()) {
							advance()
						}
						let index = emit(TokenKind.Integer, start)
						prevIndex = true
						return index
					}
					retreat()
					return withUnit(lexNumber(start), before)
				}

				return lexString(start) when r == '"'
				return lexChar(start) when r == '\''

				if r == '/' {
					let c = peek()
					if c == '/' {
						return lexLineComment(start) when comments
						skipLineComment()
						continue
					}
					if c == '*' {
						return lexBlockComment(start) when comments
						skipBlockComment()
						continue
					}
					if canLexRegex() {
						let regex = lexRegex(start)
						return regex when regex is Token
					}
				}

				if r == '.' {
					if peek() == '.' {
						advance()
						if peek() == '.' {
							advance()
							return emit(TokenKind.Ellipsis, start)
						}
						return emit(TokenKind.Range, start)
					}
					if peek() == '*' {
						advance()
						return emit(TokenKind.DotMul, start)
					}
					// `.5` is a float, but `pair.5` names an element of a tuple.
					if isDigit(peek()) && !afterOperand(start) {
						let before = prev
						retreat()
						return withUnit(lexNumber(start), before)
					}
					return emit(TokenKind.Dot, start)
				}

				if r == ':' {
					switch peek() {
						case '=':
							advance()
							return emit(TokenKind.Junction, start)
						case ':':
							advance()
							return emit(TokenKind.ColonColon, start)
						default:
							return emit(TokenKind.Colon, start)
					}
				}

				if r == '<' {
					switch peek() {
						case '-':
							advance()
							return emit(TokenKind.LArrow, start)
						case '<':
							advance()
							if peek() == '<' {
								advance()
								if peek() == '=' {
									advance()
									return emit(TokenKind.RotlAssign, start)
								}
								return emit(TokenKind.Rotl, start)
							}
							if peek() == '=' {
								advance()
								return emit(TokenKind.ShlAssign, start)
							}
							return emit(TokenKind.Shl, start)
						case '=':
							advance()
							return emit(TokenKind.Leq, start)
						default:
							return emit(TokenKind.Lt, start)
					}
				}

				if r == '>' {
					switch peek() {
						case '>':
							advance()
							if peek() == '>' {
								advance()
								if peek() == '=' {
									advance()
									return emit(TokenKind.RotrAssign, start)
								}
								return emit(TokenKind.Rotr, start)
							}
							if peek() == '=' {
								advance()
								return emit(TokenKind.ShrAssign, start)
							}
							return emit(TokenKind.Shr, start)
						case '=':
							advance()
							return emit(TokenKind.Geq, start)
						default:
							return emit(TokenKind.Gt, start)
					}
				}

				if r == '=' {
					if peek() == '>' {
						advance()
						return emit(TokenKind.FatArrow, start)
					}
					if peek() == '=' {
						advance()
						return emit(TokenKind.Eq, start)
					}
					return emit(TokenKind.Assign, start)
				}

				if r == '!' {
					if peek() == '=' {
						advance()
						return emit(TokenKind.Neq, start)
					}
					return emit(TokenKind.Not, start)
				}

				if r == '+' {
					switch peek() {
						case '=':
							advance()
							return emit(TokenKind.AddAssign, start)
						case '+':
							advance()
							return emit(TokenKind.Inc, start)
						default:
							return emit(TokenKind.Add, start)
					}
				}

				if r == '-' {
					switch peek() {
						case '=':
							advance()
							return emit(TokenKind.SubAssign, start)
						case '-':
							advance()
							return emit(TokenKind.Dec, start)
						case '>':
							advance()
							return emit(TokenKind.RArrow, start)
						default:
							return emit(TokenKind.Sub, start)
					}
				}

				if r == '*' {
					switch peek() {
						case '=':
							advance()
							return emit(TokenKind.MulAssign, start)
						case '*':
							advance()
							return emit(TokenKind.Exp, start)
						default:
							return emit(TokenKind.Mul, start)
					}
				}

				if r == '%' {
					if peek() == '=' {
						advance()
						return emit(TokenKind.RemAssign, start)
					}
					return emit(TokenKind.Rem, start)
				}

				if r == '/' {
					if peek() == '=' {
						advance()
						return emit(TokenKind.DivAssign, start)
					}
					return emit(TokenKind.Div, start)
				}

				if r == '&' {
					if peek() == '=' {
						advance()
						return emit(TokenKind.AndAssign, start)
					}
					if peek() == '&' {
						advance()
						return emit(TokenKind.And, start)
					}
					return emit(TokenKind.BitAnd, start)
				}

				if r == '|' {
					if peek() == '=' {
						advance()
						return emit(TokenKind.OrAssign, start)
					}
					if peek() == '|' {
						advance()
						return emit(TokenKind.Or, start)
					}
					return emit(TokenKind.BitOr, start)
				}

				return emit(TokenKind.Tilde, start) when r == '~'

				if r == '^' {
					if peek() == '=' {
						advance()
						return emit(TokenKind.XorAssign, start)
					}
					return emit(TokenKind.Xor, start)
				}

				switch r {
					case '(':
						return emit(TokenKind.LParen, start)
					case ')':
						return emit(TokenKind.RParen, start)
					case '{':
						return emit(TokenKind.LBrace, start)
					case '}':
						return emit(TokenKind.RBrace, start)
					case '[':
						return emit(TokenKind.LBrack, start)
					case ']':
						return emit(TokenKind.RBrack, start)
					case ',':
						return emit(TokenKind.Comma, start)
					case ';':
						return emit(TokenKind.Semi, start)
					case '@':
						return emit(TokenKind.At, start)
					case '?':
						if peek() == '?' {
							advance()
							return emit(TokenKind.Choice, start)
						}
						return emit(TokenKind.Question, start)
					default:
						return emit(TokenKind.Illegal, start)
				}
			}
		}

		// ------------------------------------------------------------
		// Numbers
		// ------------------------------------------------------------

		internal def lexNumber(start int) Token {
			let hasDot = false
			let hasExp = false
			let inExp = false
			let sawExpDigit = false
			let isHex = false
			let isBin = false
			let isOct = false

			if peek() == '0' {
				let r2 = peekN(1)
				if r2 := 'x' || 'X' {
					isHex = true
					advance()
					advance()
				} else if r2 := 'b' || 'B' {
					isBin = true
					advance()
					advance()
				} else if r2 := 'o' || 'O' {
					isOct = true
					advance()
					advance()
				}
			}

			for {
				let r = peek()

				// A space inside a number groups its digits: `1 000 000`.
				if r == ' ' {
					if inExp {
						if isDigit(peekN(1)) {
							advance()
							continue
						}
						break
					}
					if continuesNumber(peekN(1), isHex, isBin, isOct) {
						advance()
						continue
					}
					break
				}

				if inExp {
					if isDigit(r) {
						sawExpDigit = true
						advance()
						continue
					}
					break
				}

				if isHex {
					if r.isHexDigit() {
						advance()
						continue
					}
					// A `.` belongs to a hex float only when a `p` exponent
					// follows (`0x1.2p3`), and never to a range.
					if r == '.' && !hasDot {
						break when peekN(1) == '.'
						if hexFloatHasExponentAhead() {
							hasDot = true
							advance()
							continue
						}
						break
					}
					if (r == 'p' || r == 'P') && !hasExp {
						hasExp = true
						inExp = true
						advance()
						advance() when peek() == '+' || peek() == '-'
						continue
					}
					break
				}

				if isBin {
					if r := '0' || '1' {
						advance()
						continue
					}
					break
				}

				if isOct {
					if r >= '0' && r <= '7' {
						advance()
						continue
					}
					break
				}

				if isDigit(r) {
					advance()
					continue
				}

				if r == '.' && !hasDot {
					let r2 = peekN(1)
					// `..` is a range; a letter after the dot starts a member
					// access on the literal (`10.max(n)`), not a fraction.
					break when r2 == '.' || isLetter(r2) || r2 == '_'
					hasDot = true
					advance()
					continue
				}

				if (r == 'e' || r == 'E') && !hasExp {
					hasExp = true
					inExp = true
					advance()
					advance() when peek() == '+' || peek() == '-'
					continue
				}

				break
			}

			return emit(TokenKind.Illegal, start) when inExp && !sawExpDigit

			let duration = tryDuration(start)
			return duration when duration is Token

			if peek() == 'i' {
				advance()
				return emit(TokenKind.Imaginary, start)
			}

			return emit(TokenKind.Float, start) when hasDot || hasExp
			return emit(TokenKind.Integer, start)
		}

		internal def continuesNumber(r char, isHex bool, isBin bool, isOct bool) bool {
			return false when r == char(0)
			return r.isHexDigit() when isHex
			return r == '0' || r == '1' when isBin
			return r >= '0' && r <= '7' when isOct
			return isDigit(r)
		}

		// hexFloatHasExponentAhead is true when the hex digits (and group
		// spaces) after the cursor end in a `p` or `P`.
		internal def hexFloatHasExponentAhead() bool {
			let i = 1
			for {
				let r = peekN(i)
				return false when r == char(0)
				return r == 'p' || r == 'P' unless r == ' ' || r.isHexDigit()
				i++
			}
		}

		// tryDuration reads a duration unit after the digits: `ns`, `us`,
		// `µs`, `ms`, `s`, `m`, `min`, `h`. A unit that runs on into a name
		// (`10max`) is no unit; a unit letter without its `s` (`3n`) is an
		// Illegal token.
		internal def tryDuration(start int) ?Token {
			let r1 = peek()
			return none when r1 == char(0)

			switch r1 {
				case 'n':
					if peekN(1) == 's' {
						advance()
						advance()
						return emit(TokenKind.Duration, start)
					}
					advance()
					return emit(TokenKind.Illegal, start)
				case 'u', 'µ':
					if peekN(1) == 's' {
						advance()
						advance()
						return emit(TokenKind.Duration, start)
					}
					advance()
					return emit(TokenKind.Illegal, start)
				case 'm':
					let r2 = peekN(1)
					if r2 == 's' && !continuesIdent(peekN(2)) {
						advance()
						advance()
						return emit(TokenKind.Duration, start)
					}
					if r2 == 'i' && peekN(2) == 'n' && !continuesIdent(peekN(3)) {
						advance()
						advance()
						advance()
						return emit(TokenKind.Duration, start)
					}
					return none when continuesIdent(r2)
					advance()
					return emit(TokenKind.Duration, start)
				case 's', 'h':
					return none when continuesIdent(peekN(1))
					advance()
					return emit(TokenKind.Duration, start)
				default:
					return none
			}
		}

		// withUnit queues a Unit token after an integer or float literal that
		// is followed by a parenthesised unit on the same line: `100(km)`,
		// `9.81 (m/s²)`. The token spans the parentheses and its text is what
		// is between them, which is read in the unit grammar. A number right after a `.`
		// token (`x. 0(y)`) is never a quantity.
		internal def withUnit(num Token, before TokenKind) Token {
			return num when (num.kind != TokenKind.Integer && num.kind != TokenKind.Float) || before == TokenKind.Dot
			let n = chars.len()
			let i = pos
			for i < n && (chars[i] == ' ' || chars[i] == '\t') {
				i++
			}
			return num when i >= n || chars[i] != '('
			let open = i
			let depth = 0
			for i < n {
				switch chars[i] {
					case '(':
						depth++
					case ')':
						depth--
					case '\n', '\r':
						return num
					default:
				}
				break when depth == 0
				i++
			}
			return num when i >= n
			pos = i + 1
			pending.push(Token{kind: TokenKind.Unit, start: open, end: pos, text: src[open + 1:i]})
			return num
		}

		// ------------------------------------------------------------
		// Strings and chars
		// ------------------------------------------------------------

		// lexString reads a string after its opening quote. A string with
		// interpolations comes back as its first segment, the rest queued:
		// String segments (the first with the opening quote, the last with
		// the closing one) around InterpLBrace, the tokens of the expression
		// and InterpRBrace.
		internal def lexString(startPos int) Token {
			let triple = false
			if peek() == '"' && peekN(1) == '"' {
				triple = true
				advance()
				advance()
			}
			let quoteLen = triple ?? (3, 1)
			let bodyStart = pos

			let out Token[]
			let segStart = bodyStart
			let firstSegment = true
			let sawInterpolation = false

			for {
				let r = advance()

				return emit(TokenKind.Illegal, startPos) when r == char(0)
				return emit(TokenKind.Illegal, startPos) when !triple && r == '\n'

				if r == '"' {
					if triple {
						if peek() == '"' && peekN(1) == '"' {
							let endQuotePos = pos - 1
							if !sawInterpolation {
								advance()
								advance()
								return emit(TokenKind.String, startPos)
							}
							out.push(stringSegment(firstSegment ?? (startPos, segStart), segStart, endQuotePos, quoteLen))
							advance()
							advance()
							break
						}
						continue
					}
					let endQuotePos = pos - 1
					return emit(TokenKind.String, startPos) when !sawInterpolation
					out.push(stringSegment(firstSegment ?? (startPos, segStart), segStart, endQuotePos, quoteLen))
					break
				}

				if r == '\\' && !triple {
					advance()
					continue
				}

				continue when r != '{'
				continue unless looksLikeInterpolationStart(pos)

				if !sawInterpolation {
					sawInterpolation = true
					segStart = bodyStart
					firstSegment = true
				}

				let bracePos = pos - 1
				out.push(stringSegment(firstSegment ?? (startPos, segStart), segStart, bracePos, 0))
				firstSegment = false
				out.push(Token{kind: TokenKind.InterpLBrace, start: bracePos, end: bracePos + 1, text: "\{"})

				let depth = 1
				for depth > 0 {
					// A string inside the braces may interpolate too: its
					// first token comes back and the rest wait in pending.
					let tok = takeRaw()
					if tok.kind == TokenKind.EOF || tok.kind == TokenKind.Illegal {
						out.push(tok)
						queueFirst(out[1:])
						return out[0]
					}
					switch tok.kind {
						case TokenKind.LBrace:
							depth++
							out.push(tok)
						case TokenKind.RBrace:
							depth--
							if depth == 0 {
								out.push(Token{kind: TokenKind.InterpRBrace, start: tok.start, end: tok.end, text: "\}"})
							} else {
								out.push(tok)
							}
						default:
							out.push(tok)
					}
				}

				segStart = pos
			}

			return emit(TokenKind.Illegal, startPos) when !sawInterpolation || out.len() == 0
			queueFirst(out[1:])
			return out[0]
		}

		// stringSegment is the String token of the text from `segStart` to
		// `segEnd`, spanning from `from` and, for the final segment, over the
		// closing quotes (`quoteLen` of them).
		internal def stringSegment(from int, segStart int, segEnd int, quoteLen int) Token {
			segEnd = segStart when segEnd < segStart
			let end = segEnd + quoteLen
			end = from when end < from
			return Token{kind: TokenKind.String, start: from, end: end, text: src[from:end]}
		}

		// looksLikeInterpolationStart is true when the text after a `{` in a
		// string starts an expression: a name, a number, a literal, an
		// opening bracket, a sign, `!`, `@`, `.5`, a receive `<-ch` or a
		// bitwise not `~x`. Anything else keeps the brace literal text.
		internal def looksLikeInterpolationStart(at int) bool {
			let n = chars.len()
			for at < n {
				let r = chars[at]
				return false when r == char(0)
				if !isWhitespace(r) {
					return at + 1 < n && isDigit(chars[at + 1]) when r == '.'
					return at + 1 < n && chars[at + 1] == '-' when r == '<'
					return at + 1 < n && looksLikeExprStart(chars[at + 1]) when r == '~'
					return looksLikeExprStart(r)
				}
				at++
			}
			return false
		}

		internal def looksLikeExprStart(r char) bool {
			return true when isLetter(r) || isDigit(r)
			switch r {
				case '_', '$', '"', '\'', '(', '[', '{', '+', '-', '!', '@':
					return true
				default:
					return false
			}
		}

		// lexChar reads a char literal after its opening quote: one code
		// point or one escape (`\n`, `\t`, `\r`, `\\`, `\'`, `\uXXXX`,
		// `\UXXXXXXXX`), then the closing quote. Anything else is Illegal up
		// to the next quote or the end of the line.
		internal def lexChar(start int) Token {
			let r = advance()
			return illegalChar(start) when r == char(0) || r == '\n'

			if r == '\\' {
				let esc = advance()
				return illegalChar(start) when esc == char(0) || esc == '\n'
				switch esc {
					case 'n', 't', 'r', '\\', '\'':
					case 'u':
						return illegalChar(start) unless hexEscape(4)
					case 'U':
						return illegalChar(start) unless hexEscape(8)
					default:
						return illegalChar(start)
				}
			} else {
				let cp = int(r)
				return illegalChar(start) when cp < 0x20 || cp == 0x7F || !isValidScalar(cp)
			}

			return illegalChar(start) when advance() != '\''
			return emit(TokenKind.Char, start)
		}

		// hexEscape consumes `digits` hex digits and reports whether they
		// spell a valid scalar value.
		internal def hexEscape(digits int) bool {
			let value = 0
			for let i = 0; i < digits; i++ {
				let d = advance()
				return false unless d.isHexDigit()
				value = value * 16 + d.digitValue(16)
			}
			return isValidScalar(value)
		}

		internal def illegalChar(start int) Token {
			consumeUntil('\'')
			return emit(TokenKind.Illegal, start)
		}

		// ------------------------------------------------------------
		// Comments
		// ------------------------------------------------------------

		internal def lexLineComment(start int) Token {
			skipLineComment()
			return emit(TokenKind.Comment, start)
		}

		// skipLineComment moves the cursor from the second `/` to the end of
		// the line, which stays unconsumed.
		internal def skipLineComment() {
			advance()
			let n = chars.len()
			for pos < n && chars[pos] != '\n' {
				pos++
			}
		}

		internal def lexBlockComment(start int) Token {
			skipBlockComment()
			return emit(TokenKind.Comment, start)
		}

		// skipBlockComment moves the cursor from the `*` of the opening `/*`
		// past the matching `*/`; block comments nest. An unterminated
		// comment runs to the end of the source.
		internal def skipBlockComment() {
			let depth = 1
			let n = chars.len()
			for pos < n {
				let c = chars[pos]
				if c == '/' && pos + 1 < n && chars[pos + 1] == '*' {
					pos += 2
					depth++
					continue
				}
				if c == '*' && pos + 1 < n && chars[pos + 1] == '/' {
					pos += 2
					depth--
					return when depth == 0
					continue
				}
				pos++
			}
		}

		// ------------------------------------------------------------
		// Regex
		// ------------------------------------------------------------

		// canLexRegex is true where a `/` starts a regex literal rather than
		// a division: after nothing, or after a token that cannot end an
		// operand.
		internal def canLexRegex() bool {
			switch prev {
				case TokenKind.EOF, TokenKind.Illegal, TokenKind.Comment, TokenKind.LParen, TokenKind.LBrack, TokenKind.LBrace, TokenKind.Comma, TokenKind.Semi, TokenKind.Colon, TokenKind.ColonColon, TokenKind.At, TokenKind.Question, TokenKind.Assign, TokenKind.Junction, TokenKind.Choice, TokenKind.Add, TokenKind.Sub, TokenKind.Mul, TokenKind.Div, TokenKind.Rem, TokenKind.AddAssign, TokenKind.SubAssign, TokenKind.MulAssign, TokenKind.DivAssign, TokenKind.RemAssign, TokenKind.AndAssign, TokenKind.OrAssign, TokenKind.XorAssign, TokenKind.And, TokenKind.Or, TokenKind.BitAnd, TokenKind.BitOr, TokenKind.Xor, TokenKind.Not, TokenKind.Lt, TokenKind.Gt, TokenKind.Leq, TokenKind.Geq, TokenKind.Eq, TokenKind.Neq, TokenKind.Shl, TokenKind.Shr, TokenKind.Rotl, TokenKind.Rotr, TokenKind.LArrow, TokenKind.RArrow, TokenKind.Range, TokenKind.Return, TokenKind.Fail, TokenKind.Await, TokenKind.Defer, TokenKind.Yield, TokenKind.Onerror, TokenKind.Try, TokenKind.If, TokenKind.Else, TokenKind.When, TokenKind.Unless, TokenKind.For, TokenKind.Forall, TokenKind.Switch, TokenKind.Match, TokenKind.Select, TokenKind.Case, TokenKind.Default, TokenKind.Let, TokenKind.Const, TokenKind.New, TokenKind.Cuda, TokenKind.Sql:
					return true
				default:
					return false
			}
		}

		// lexRegex reads `/pattern/flags` after the opening `/`; none when
		// no closing `/` follows on the line, or the pattern is blank.
		internal def lexRegex(start int) ?Token {
			let n = chars.len()
			let at = pos
			let escaped = false
			let hasContent = false

			for at < n {
				let r = chars[at]
				return none when r == '\n' || r == char(0)
				at++

				if escaped {
					escaped = false
					continue
				}
				if r == '\\' {
					escaped = true
					hasContent = true
					continue
				}
				if r != '/' {
					hasContent = true unless isWhitespace(r)
					continue
				}

				return none unless hasContent

				for at < n && isLetter(chars[at]) {
					at++
				}

				pos = at
				return emit(TokenKind.Regex, start)
			}

			return none
		}
	}
}
