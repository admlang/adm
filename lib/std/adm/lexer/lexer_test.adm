partial module std.adm.lexer {
	use std.testing

	// kinds is the kind of every token of the source, EOF included.
	internal def kinds(source string, comments bool = true) TokenKind[] {
		let out TokenKind[]
		for let (_, tok) in tokenize(source, comments) {
			out.push(tok.kind)
		}
		return out
	}

	// texts is the text of every token of the source but EOF.
	internal def texts(source string) string[] {
		let out string[]
		for let (_, tok) in tokenize(source) {
			out.push(tok.text) when tok.kind != TokenKind.EOF
		}
		return out
	}

	check "Lexer" {
		@test()
		def TestPunctuation() {
			assert kinds("( ) \{ \} [ ] ; , : :: . @ ? ...").equals(TokenKind[
				TokenKind.LParen, TokenKind.RParen, TokenKind.LBrace, TokenKind.RBrace,
				TokenKind.LBrack, TokenKind.RBrack, TokenKind.Semi, TokenKind.Comma,
				TokenKind.Colon, TokenKind.ColonColon, TokenKind.Dot, TokenKind.At,
				TokenKind.Question, TokenKind.Ellipsis, TokenKind.EOF])
			assert texts("#") .equals(["#"])
			assert kinds("#")[0] == TokenKind.Illegal
			assert texts("\{ \}").equals(["\{", "\}"])
			assert TokenKind.LBrace.value == "\{" && TokenKind.RBrace.value == "\}"
		}

		@test()
		def TestTupleIndexes() {
			assert texts("pair.0").equals(["pair", ".", "0"])
			assert kinds("pair.0").equals(TokenKind[TokenKind.Ident, TokenKind.Dot, TokenKind.Integer, TokenKind.EOF])
			assert texts("nested.0.12").equals(["nested", ".", "0", ".", "12"])
			assert kinds("f().1").equals(TokenKind[TokenKind.Ident, TokenKind.LParen, TokenKind.RParen, TokenKind.Dot, TokenKind.Integer, TokenKind.EOF])
			assert kinds("a[i].2").equals(TokenKind[TokenKind.Ident, TokenKind.LBrack, TokenKind.Ident, TokenKind.RBrack, TokenKind.Dot, TokenKind.Integer, TokenKind.EOF])
			assert kinds("pair.0(x)").equals(TokenKind[TokenKind.Ident, TokenKind.Dot, TokenKind.Integer, TokenKind.LParen, TokenKind.Ident, TokenKind.RParen, TokenKind.EOF])
			assert texts("pair.1e3").equals(["pair", ".", "1", "e3"])
			assert kinds("self.0").equals(TokenKind[TokenKind.Self, TokenKind.Dot, TokenKind.Integer, TokenKind.EOF])
			assert kinds("x .5").equals(TokenKind[TokenKind.Ident, TokenKind.Float, TokenKind.EOF])
			assert kinds("x * .5").equals(TokenKind[TokenKind.Ident, TokenKind.Mul, TokenKind.Float, TokenKind.EOF])
			assert kinds("(.5)").equals(TokenKind[TokenKind.LParen, TokenKind.Float, TokenKind.RParen, TokenKind.EOF])
			assert kinds("1.5").equals(TokenKind[TokenKind.Float, TokenKind.EOF])
			assert kinds("3 .5").equals(TokenKind[TokenKind.Integer, TokenKind.Float, TokenKind.EOF])
		}

		@test()
		def TestOperators() {
			let operators = ["=", ":=", "??", "+", "-", "*", "/", "%", "&", "|", "^", "!", "~", "<", ">",
				"&&", "||", "==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=",
				"<<", ">>", "<<=", ">>=", "<<<", ">>>", "<<<=", ">>>=", "..", ".*", "<-", "->", "=>", "++", "--", "**"]
			let expected = TokenKind[
				TokenKind.Assign, TokenKind.Junction, TokenKind.Choice, TokenKind.Add, TokenKind.Sub,
				TokenKind.Mul, TokenKind.Div, TokenKind.Rem, TokenKind.BitAnd, TokenKind.BitOr,
				TokenKind.Xor, TokenKind.Not, TokenKind.Tilde, TokenKind.Lt, TokenKind.Gt,
				TokenKind.And, TokenKind.Or, TokenKind.Eq, TokenKind.Neq, TokenKind.Leq, TokenKind.Geq,
				TokenKind.AddAssign, TokenKind.SubAssign, TokenKind.MulAssign, TokenKind.DivAssign,
				TokenKind.RemAssign, TokenKind.AndAssign, TokenKind.OrAssign, TokenKind.XorAssign,
				TokenKind.Shl, TokenKind.Shr, TokenKind.ShlAssign, TokenKind.ShrAssign,
				TokenKind.Rotl, TokenKind.Rotr, TokenKind.RotlAssign, TokenKind.RotrAssign,
				TokenKind.Range, TokenKind.DotMul, TokenKind.LArrow, TokenKind.RArrow, TokenKind.FatArrow,
				TokenKind.Inc, TokenKind.Dec, TokenKind.Exp]
			assert operators.len() == expected.len()
			for let (i, spelling) in operators {
				let tokens = tokenize("a " + spelling + " b")
				assert tokens.len() == 4
				assert tokens[1].kind == expected[i]
				assert tokens[1].text == spelling
				assert expected[i].value == spelling
				assert isOperator(expected[i])
			}
		}

		@test()
		def TestKeywords() {
			assert kinds("if else true false none self struct").equals(TokenKind[
				TokenKind.If, TokenKind.Else, TokenKind.Bool, TokenKind.Bool, TokenKind.None,
				TokenKind.Self, TokenKind.Struct, TokenKind.EOF])
			assert texts("true none").equals(["true", "none"])
			let tokens = tokenize("partial module std.adm.lexer")
			assert tokens[0].kind == TokenKind.Partial && tokens[0].text == "partial"
			assert tokens[1].kind == TokenKind.Module
			assert tokens[2].kind == TokenKind.Ident && tokens[2].text == "std"
			assert TokenKind.If.value == "if"
			assert TokenKind.Bool.value == "BOOL"
		}

		@test()
		def TestIdentifiers() {
			assert kinds("foo _bar $x x1 °C s² café").equals(TokenKind[
				TokenKind.Ident, TokenKind.Ident, TokenKind.Ident, TokenKind.Ident,
				TokenKind.Ident, TokenKind.Ident, TokenKind.Ident, TokenKind.EOF])
			assert texts("°C s²").equals(["°C", "s²"])
			// A decomposed spelling is one identifier, reported in NFC.
			let decomposed = "cafe" + string('́')
			let tokens = tokenize(decomposed + " = 1")
			assert tokens[0].kind == TokenKind.Ident
			assert tokens[0].text == "café"
			assert tokens[0].end == 5
			assert tokens[1].kind == TokenKind.Assign && tokens[1].start == 6
			// Spans count characters, not bytes.
			assert tokenize("é = 1")[1].start == 2
		}

		@test()
		def TestNumbers() {
			let sources = ["42", "0xDEAD BEEF", "0b1010", "0o755", "1 000 000", "3.14", ".5", "1 000.0 1", "1e-9", "2E+3", "0x1p-62", "0x1.2p3", "123i", "2.5i", "1e"]
			let expected = TokenKind[
				TokenKind.Integer, TokenKind.Integer, TokenKind.Integer, TokenKind.Integer, TokenKind.Integer,
				TokenKind.Float, TokenKind.Float, TokenKind.Float, TokenKind.Float, TokenKind.Float,
				TokenKind.Float, TokenKind.Float, TokenKind.Imaginary, TokenKind.Imaginary, TokenKind.Illegal]
			for let (i, source) in sources {
				let tokens = tokenize(source)
				assert tokens.len() == 2
				assert tokens[0].kind == expected[i]
				assert tokens[0].text == source
			}
			assert kinds("10.max(n)").equals(TokenKind[
				TokenKind.Integer, TokenKind.Dot, TokenKind.Ident, TokenKind.LParen, TokenKind.Ident, TokenKind.RParen, TokenKind.EOF])
			assert kinds("1..3").equals(TokenKind[TokenKind.Integer, TokenKind.Range, TokenKind.Integer, TokenKind.EOF])
			assert kinds("0x10..0x20").equals(TokenKind[TokenKind.Integer, TokenKind.Range, TokenKind.Integer, TokenKind.EOF])
			assert texts("1 + 2").equals(["1", "+", "2"])
		}

		@test()
		def TestDurations() {
			assert kinds("1ns 250ms 3h 2us 2µs 5m 7min 1.5s").equals(TokenKind[
				TokenKind.Duration, TokenKind.Duration, TokenKind.Duration, TokenKind.Duration,
				TokenKind.Duration, TokenKind.Duration, TokenKind.Duration, TokenKind.Duration, TokenKind.EOF])
			assert texts("1h30m").equals(["1h", "30m"])
			assert kinds("10max").equals(TokenKind[TokenKind.Integer, TokenKind.Ident, TokenKind.EOF])
			assert kinds("3n").equals(TokenKind[TokenKind.Illegal, TokenKind.EOF])
			assert kinds("3u").equals(TokenKind[TokenKind.Illegal, TokenKind.EOF])
		}

		@test()
		def TestUnits() {
			let tokens = tokenize("100(km)")
			assert tokens.len() == 3
			assert tokens[0].kind == TokenKind.Integer && tokens[0].text == "100"
			assert tokens[1].kind == TokenKind.Unit && tokens[1].text == "km"
			assert tokens[1].start == 3 && tokens[1].end == 7
			assert isLiteral(tokens[1].kind)
			let quantity = tokenize("9.81 (m/s²)")
			assert quantity[0].kind == TokenKind.Float
			assert quantity[1].kind == TokenKind.Unit && quantity[1].text == "m/s²"
			// A tuple index is never a quantity.
			assert kinds("pair.0(x)").equals(TokenKind[TokenKind.Ident, TokenKind.Dot, TokenKind.Integer, TokenKind.LParen, TokenKind.Ident, TokenKind.RParen, TokenKind.EOF])
			// A number right after a `.` token is never a quantity.
			assert kinds("x. 0(y)").equals(TokenKind[
				TokenKind.Ident, TokenKind.Dot, TokenKind.Integer, TokenKind.LParen, TokenKind.Ident, TokenKind.RParen, TokenKind.EOF])
			assert kinds("5(").equals(TokenKind[TokenKind.Integer, TokenKind.LParen, TokenKind.EOF])
			assert kinds("5(a\n)").equals(TokenKind[TokenKind.Integer, TokenKind.LParen, TokenKind.Ident, TokenKind.RParen, TokenKind.EOF])
			assert kinds("x(1)").equals(TokenKind[TokenKind.Ident, TokenKind.LParen, TokenKind.Integer, TokenKind.RParen, TokenKind.EOF])
		}

		@test()
		def TestStrings() {
			assert texts("\"hi\"").equals(["\"hi\""])
			assert kinds("\"a\\\"b\"").equals(TokenKind[TokenKind.String, TokenKind.EOF])
			let escapedBraces = "\"" + "\\" + "\{x" + "\\" + "\}\""
			assert kinds(escapedBraces).equals(TokenKind[TokenKind.String, TokenKind.EOF])
			assert kinds("\"\{\}\"").equals(TokenKind[TokenKind.String, TokenKind.EOF])
			assert kinds("\"\"\"\nmulti\nline\n\"\"\"").equals(TokenKind[TokenKind.String, TokenKind.EOF])
			assert kinds("\"abc").equals(TokenKind[TokenKind.Illegal, TokenKind.EOF])
			assert kinds("\"a\nb\"").equals(TokenKind[TokenKind.Illegal, TokenKind.Ident, TokenKind.Illegal, TokenKind.EOF])
		}

		// A backtick string is one String token over its source, lines,
		// backslashes, quotes and braces included.
		@test()
		def TestRawStrings() {
			// A backtick string cannot hold a backtick: the sources are joined.
			let tick = "`"
			let body = `a \n {x} "q"`
			assert texts(tick + body + tick).equals([tick + body + tick])
			assert kinds(tick + "line\n\tline" + tick).equals(TokenKind[TokenKind.String, TokenKind.EOF])
			assert kinds(tick + tick).equals(TokenKind[TokenKind.String, TokenKind.EOF])
			assert kinds(tick + "open").equals(TokenKind[TokenKind.Illegal, TokenKind.EOF])
			let hole = tokenize(`"a{` + tick + `{x}` + tick + `}b"`)
			assert hole.len() == 6 && hole[2].kind == TokenKind.String && hole[2].text == tick + `{x}` + tick
		}

		@test()
		def TestInterpolation() {
			let tokens = tokenize("\"Hello \{name\}!\"")
			assert tokens.len() == 6
			assert tokens[0].kind == TokenKind.String && tokens[0].text == "\"Hello "
			assert tokens[0].start == 0 && tokens[0].end == 7
			assert tokens[1].kind == TokenKind.InterpLBrace && tokens[1].text == "\{"
			assert tokens[1].start == 7 && tokens[1].end == 8
			assert tokens[2].kind == TokenKind.Ident && tokens[2].text == "name"
			assert tokens[3].kind == TokenKind.InterpRBrace && tokens[3].text == "\}"
			assert tokens[4].kind == TokenKind.String && tokens[4].text == "!\""
			assert tokens[4].start == 13 && tokens[4].end == 15
			assert tokens[5].kind == TokenKind.EOF
			assert kinds("\"\{a\} \{b\}\"").equals(TokenKind[
				TokenKind.String, TokenKind.InterpLBrace, TokenKind.Ident, TokenKind.InterpRBrace,
				TokenKind.String, TokenKind.InterpLBrace, TokenKind.Ident, TokenKind.InterpRBrace,
				TokenKind.String, TokenKind.EOF])
			// A string inside the braces interpolates on its own.
			assert kinds("\"\{f(\"x\")\}\"").equals(TokenKind[
				TokenKind.String, TokenKind.InterpLBrace, TokenKind.Ident, TokenKind.LParen, TokenKind.String,
				TokenKind.RParen, TokenKind.InterpRBrace, TokenKind.String, TokenKind.EOF])
			assert kinds("\"\{m\{1\}\}\"").equals(TokenKind[
				TokenKind.String, TokenKind.InterpLBrace, TokenKind.Ident, TokenKind.LBrace, TokenKind.Integer,
				TokenKind.RBrace, TokenKind.InterpRBrace, TokenKind.String, TokenKind.EOF])
			assert kinds("\"\"\"\{x\}\n\"\"\"").equals(TokenKind[
				TokenKind.String, TokenKind.InterpLBrace, TokenKind.Ident, TokenKind.InterpRBrace, TokenKind.String, TokenKind.EOF])
			// The tokens after an unterminated interpolation still come out.
			assert kinds("\"\{x").equals(TokenKind[TokenKind.String, TokenKind.InterpLBrace, TokenKind.Ident, TokenKind.EOF])
		}

		@test()
		def TestChars() {
			let valid = ["'a'", "'\\n'", "'\\''", "'\\u00e9'", "'\\U0001F30D'", "'🌍'"]
			for let (_, source) in valid {
				let tokens = tokenize(source)
				assert tokens.len() == 2
				assert tokens[0].kind == TokenKind.Char
				assert tokens[0].text == source
			}
			let invalid = ["''", "'ab'", "'\\q'", "'\\u12'", "'\\uD800'", "'a"]
			for let (_, source) in invalid {
				assert tokenize(source)[0].kind == TokenKind.Illegal
			}
		}

		@test()
		def TestWhitespaceTokens() {
			let tokens = tokenize("a  b\r\n\n\tc // x\n", comments = true, whitespace = true)
			let got string[]
			for let (_, t) in tokens {
				got.push(t.kind.name + ":" + t.text)
			}
			assert got.join("|") == "Ident:a|Whitespace:  |Ident:b|Newline:\r\n|Newline:\n|Whitespace:\t|Ident:c|Whitespace: |Comment:// x|Newline:\n|EOF:"
			let spelled = ""
			for let (_, t) in tokens {
				spelled += t.text
			}
			assert spelled == "a  b\r\n\n\tc // x\n"
			// White space between tokens leaves the regex and tuple-index decisions as they were.
			assert tokenize("x .5", comments = true, whitespace = true)[2].kind == TokenKind.Float
			assert tokenize("a / b", comments = true, whitespace = true)[2].kind == TokenKind.Div
		}

		@test()
		def TestComments() {
			let tokens = tokenize("x // note\ny")
			assert tokens.len() == 4
			assert tokens[1].kind == TokenKind.Comment && tokens[1].text == "// note"
			assert tokens[1].start == 2 && tokens[1].end == 9
			assert tokens[2].kind == TokenKind.Ident && tokens[2].text == "y"
			assert texts("/* a /* b */ c */ y").equals(["/* a /* b */ c */", "y"])
			assert kinds("x // note\ny", false).equals(TokenKind[TokenKind.Ident, TokenKind.Ident, TokenKind.EOF])
			assert kinds("/* x", false).equals(TokenKind[TokenKind.EOF])
			assert texts("/* x").equals(["/* x"])
			// A comment does not decide whether `/` starts a regex.
			assert kinds("a /* c */ / b").equals(TokenKind[TokenKind.Ident, TokenKind.Comment, TokenKind.Div, TokenKind.Ident, TokenKind.EOF])
		}

		@test()
		def TestRegex() {
			let tokens = tokenize("let r = /[a-z]+/mg")
			assert tokens.len() == 5
			assert tokens[3].kind == TokenKind.Regex && tokens[3].text == "/[a-z]+/mg"
			assert kinds("a / b / c").equals(TokenKind[
				TokenKind.Ident, TokenKind.Div, TokenKind.Ident, TokenKind.Div, TokenKind.Ident, TokenKind.EOF])
			assert kinds("x = / /").equals(TokenKind[TokenKind.Ident, TokenKind.Assign, TokenKind.Div, TokenKind.Div, TokenKind.EOF])
			assert kinds("f(/a\\/b/)").equals(TokenKind[TokenKind.Ident, TokenKind.LParen, TokenKind.Regex, TokenKind.RParen, TokenKind.EOF])
			assert kinds("return /x/").equals(TokenKind[TokenKind.Return, TokenKind.Regex, TokenKind.EOF])
			assert kinds("x /= 2").equals(TokenKind[TokenKind.Ident, TokenKind.DivAssign, TokenKind.Integer, TokenKind.EOF])
			// After the keywords an operand follows: `assert /re/.test(s)`.
			assert kinds("assert /a/.test(s)").equals(TokenKind[TokenKind.Assert, TokenKind.Regex, TokenKind.Dot, TokenKind.Ident, TokenKind.LParen, TokenKind.Ident, TokenKind.RParen, TokenKind.EOF])
			assert kinds("recover /x/")[1] == TokenKind.Regex
			assert kinds("expects /x/")[1] == TokenKind.Regex && kinds("provides /x/")[1] == TokenKind.Regex
			assert kinds("a in /x/")[2] == TokenKind.Regex
		}

		@test()
		def TestByteOrderMark() {
			assert kinds("\uFEFFlet x").equals(TokenKind[TokenKind.Let, TokenKind.Ident, TokenKind.EOF])
			let spelled = tokenize("\uFEFF  let x", whitespace = true)
			assert spelled[0].kind == TokenKind.Whitespace && spelled[0].start == 0 && spelled[0].end == 3
			assert spelled[1].kind == TokenKind.Let && spelled[1].start == 3
			// Only at the start of the source: elsewhere it is no token.
			assert kinds("let \uFEFFx")[1] == TokenKind.Illegal
		}

		@test()
		def TestSpans() {
			let source = "let x = 10 // ten"
			let tokens = tokenize(source)
			assert tokens.len() == 6
			let starts = [0, 4, 6, 8, 11, 17]
			let ends = [3, 5, 7, 10, 17, 17]
			for let (i, tok) in tokens {
				assert tok.start == starts[i] && tok.end == ends[i]
				assert tok.text == source[tok.start:tok.end]
			}
			assert tokens[5].kind == TokenKind.EOF && tokens[5].text == ""
		}

		@test()
		def TestStream() {
			let lexer = new Lexer("a b")
			assert lexer.next().text == "a"
			assert lexer.next().text == "b"
			assert lexer.next().kind == TokenKind.EOF
			assert lexer.next().kind == TokenKind.EOF
			assert tokenize("").len() == 1
			assert kinds("   \n\t ").equals(TokenKind[TokenKind.EOF])
		}

		// scan gives what next gives, less the text, for every kind of
		// token: queued interpolation segments and units included.
		@test()
		def TestScan() {
			let source = "let s = \"a\{b + 1\}c\" // note\n\tx := 10(km) + `raw` + 'q' + /re/i"
			let byText = new Lexer(source, true, true)
			let bySpan = new Lexer(source, true, true)
			for {
				let tok = byText.next()
				let (kind, start, end) = bySpan.scan()
				assert kind == tok.kind && start == tok.start && end == tok.end
				break when kind == TokenKind.EOF
			}
			let (kind, start, end) = bySpan.scan()
			assert kind == TokenKind.EOF && start == source.len() && end == start
		}

		@test()
		def TestClassification() {
			assert isKeyword(TokenKind.If) && isKeyword(TokenKind.Application) && isKeyword(TokenKind.Self)
			assert !isKeyword(TokenKind.Bool) && !isKeyword(TokenKind.Ident) && !isKeyword(TokenKind.Exp)
			assert isOperator(TokenKind.Assign) && isOperator(TokenKind.Exp) && !isOperator(TokenKind.Ellipsis)
			assert isPunctuation(TokenKind.LParen) && isPunctuation(TokenKind.Ellipsis) && !isPunctuation(TokenKind.Assign)
			assert isLiteral(TokenKind.Ident) && isLiteral(TokenKind.Unit) && !isLiteral(TokenKind.Comment)
			assert !isLiteral(TokenKind.EOF) && !isKeyword(TokenKind.EOF) && !isOperator(TokenKind.EOF) && !isPunctuation(TokenKind.EOF)
		}
	}
}
