partial module std.adm.lexer {
	// TokenKind is the class of a token. The value of a punctuation, operator
	// or keyword member is its spelling (`TokenKind.Shl.value == "<<"`); the
	// value of the other members is their class name in upper case.
	enum TokenKind {
		Illegal    = "ILLEGAL",
		EOF        = "EOF",
		Comment    = "COMMENT",
		// White space and line breaks, reported only on request.
		Whitespace = "WHITESPACE",
		Newline    = "NEWLINE",

		// Literals
		Ident     = "IDENT",
		String    = "STRING",
		Char      = "CHAR",
		Integer   = "INTEGER",
		Float     = "FLOAT",
		Imaginary = "IMAG",
		Bool      = "BOOL",
		None      = "NONE",
		Duration  = "DURATION",
		Regex     = "REGEX",
		Unit      = "UNIT",

		// Punctuation
		LParen       = "(",
		RParen       = ")",
		LBrace       = "\{",
		RBrace       = "\}",
		InterpLBrace = "INTERP_LBRACE",
		InterpRBrace = "INTERP_RBRACE",
		LBrack       = "[",
		RBrack       = "]",
		Semi         = ";",
		Comma        = ",",
		Colon        = ":",
		ColonColon   = "::",
		Dot          = ".",
		At           = "@",
		Question     = "?",
		Ellipsis     = "...",

		// Operators
		Assign     = "=",
		Junction   = ":=",
		Choice     = "??",
		Add        = "+",
		Sub        = "-",
		Mul        = "*",
		Div        = "/",
		Rem        = "%",
		BitAnd     = "&",
		BitOr      = "|",
		Xor        = "^",
		Not        = "!",
		Tilde      = "~",
		Lt         = "<",
		Gt         = ">",
		And        = "&&",
		Or         = "||",
		Eq         = "==",
		Neq        = "!=",
		Leq        = "<=",
		Geq        = ">=",
		AddAssign  = "+=",
		SubAssign  = "-=",
		MulAssign  = "*=",
		DivAssign  = "/=",
		RemAssign  = "%=",
		AndAssign  = "&=",
		OrAssign   = "|=",
		XorAssign  = "^=",
		Shl        = "<<",
		Shr        = ">>",
		ShlAssign  = "<<=",
		ShrAssign  = ">>=",
		Rotl       = "<<<",
		Rotr       = ">>>",
		RotlAssign = "<<<=",
		RotrAssign = ">>>=",
		Range      = "..",
		DotMul     = ".*",
		LArrow     = "<-",
		RArrow     = "->",
		FatArrow   = "=>",
		Inc        = "++",
		Dec        = "--",
		Exp        = "**",

		// Keywords
		Application = "application",
		Library     = "library",
		Plugin      = "plugin",
		Module      = "module",
		Check       = "check",
		View        = "view",
		Style       = "style",
		Component   = "component",
		Datatype    = "datatype",
		Service     = "service",
		Type        = "type",
		Union       = "union",
		Interface   = "interface",
		Enum        = "enum",
		Struct      = "struct",
		Partial     = "partial",
		Internal    = "internal",
		Let         = "let",
		Const       = "const",
		Def         = "def",
		Use         = "use",
		Atomic      = "atomic",
		Weak        = "weak",
		Async       = "async",
		Cuda        = "cuda",
		Sql         = "sql",
		Infix       = "infix",
		Meta        = "meta",
		Return      = "return",
		Fail        = "fail",
		Expects     = "expects",
		Provides    = "provides",
		Begin       = "begin",
		Rollback    = "rollback",
		Transaction = "transaction",
		Defer       = "defer",
		Yield       = "yield",
		Try         = "try",
		Onerror     = "onerror",
		Await       = "await",
		If          = "if",
		Else        = "else",
		When        = "when",
		Unless      = "unless",
		As          = "as",
		Is          = "is",
		In          = "in",
		For         = "for",
		Forall      = "forall",
		Every       = "every",
		Empty       = "empty",
		Break       = "break",
		Finish      = "finish",
		Switch      = "switch",
		Match       = "match",
		Select      = "select",
		Where       = "where",
		Case        = "case",
		Continue    = "continue",
		Default     = "default",
		Recover     = "recover",
		New         = "new",
		Dispose     = "dispose",
		Assert      = "assert",
		Self        = "self"
	}

	// Token is one lexical element of ADM source: its kind, the byte offsets
	// of its span in the source (`start` inclusive, `end` exclusive) and its
	// text. The text is the source text of the span, except that an
	// identifier is spelled in NFC and the braces of a string interpolation
	// are `{` and `}`. EOF has an empty span at the end of the source.
	struct Token {
		kind  TokenKind
		start int
		end   int
		text  string
	}

	// isLiteral is true for a token that carries user-written text: an
	// identifier, a string, char, number, bool, none, duration, regex or unit.
	def isLiteral(kind TokenKind) bool {
		return kind.ordinal >= TokenKind.Ident.ordinal && kind.ordinal <= TokenKind.Unit.ordinal
	}

	// isPunctuation is true for a delimiter: brackets, braces, parentheses,
	// `;`, `,`, `:`, `::`, `.`, `@`, `?` and `...`.
	def isPunctuation(kind TokenKind) bool {
		return kind.ordinal >= TokenKind.LParen.ordinal && kind.ordinal <= TokenKind.Ellipsis.ordinal
	}

	// isOperator is true for an operator, assignment operators included.
	def isOperator(kind TokenKind) bool {
		return kind.ordinal >= TokenKind.Assign.ordinal && kind.ordinal <= TokenKind.Exp.ordinal
	}

	// isKeyword is true for a reserved word. `true`, `false` and `none` are
	// literals (Bool and None), not keywords.
	def isKeyword(kind TokenKind) bool {
		return kind.ordinal >= TokenKind.Application.ordinal && kind.ordinal <= TokenKind.Self.ordinal
	}

	internal let keywords = buildKeywords()

	// buildKeywords maps every reserved spelling to its kind: the keywords,
	// and the literal words `true`, `false` and `none`.
	internal def buildKeywords() map<string, TokenKind> {
		let out map<string, TokenKind>
		let spellings = TokenKind.values()
		for let i = TokenKind.Application.ordinal; i <= TokenKind.Self.ordinal; i++ {
			out[spellings[i]] = TokenKind(i)
		}
		out["true"] = TokenKind.Bool
		out["false"] = TokenKind.Bool
		out["none"] = TokenKind.None
		return out
	}

	// keywordKind is the kind of a reserved word, or of `true`, `false` and
	// `none`; none for any other text.
	internal def keywordKind(text string) ?TokenKind {
		return keywords.get(text)
	}
}
