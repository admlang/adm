// `adm.lock`, the dependency lock beside `adm.toml`: the exact version and content hash of every
// package a build uses. This module reads it as `adm` does and writes the same bytes `adm` writes.
//
// Example:
// ```example
// let (path, exists) = lockfile.find(".")
// let lock = try lockfile.load(path)
// for let locked in lock.byName("adm.database.sqlite") {
//     println("{locked.namespace} {locked.version}")
// }
// ```
partial module std.adm.lockfile {
	use (
		std.adm.manifest
		std.adm.manifest::(Problem, ProblemKind)
		std.adm.manifest.text::*
		std.os
	)

	// The name of the lock file.
	const fileName = "adm.lock"

	// What the file says in place of a namespace for a package installed from a file or URL.
	const localNamespace = "local"

	internal const headerLine = "# adm.lock — namespace:name:hash:version [source=... publisher=... permissions=a,b foreign=yes]; written by adm install / adm get\n"

	// One entry of the lock.
	struct LockedPackage {
		name        string
		// The registry account it came from; empty for a package installed from a file or URL.
		namespace   string   = ""
		version     string   = ""
		// The SHA-256 of the container it was installed from.
		hash        string   = ""
		// Where it came from, a path or URL, for fetching it again.
		source      string   = ""
		// The signing key pinned for it.
		publisher   string   = ""
		// The permissions the developer accepted at install.
		permissions string[] = []
		// Whether the question was asked at all: an empty accepted set is a decision, an absent one
		// is not.
		accepted    bool     = false
		// Whether the developer accepted the package's foreign code.
		foreign     bool     = false
	}

	// Finds where the lock of a folder is: walking up from `dir`, the first `adm.lock`, which
	// exists; else, not existing yet, the one beside the nearest manifest, else the one in `dir`
	// itself. Returns the path, and whether the file exists.
	def find(dir string) (string, bool) {
		let start = trimmed(dir)
		start = "." when start == ""
		let info = os.stat(start)
		start = os.dir(start) when !(info is error) && !info.isDir
		let absolute = os.resolve(start) onerror recover start
		let folder = absolute
		for {
			let candidate = os.join(folder, fileName)
			let found = os.stat(candidate)
			return (candidate, true) when !(found is error) && !found.isDir
			for let name in [manifest.fileName, manifest.legacyFileName] {
				let beside = os.stat(os.join(folder, name))
				return (candidate, false) when !(beside is error) && !beside.isDir
			}
			let parent = os.dir(folder)
			break when parent == folder
			folder = parent
		}
		return (os.join(absolute, fileName), false)
	}

	// Reads the text of a lock. Never fails: what is wrong is in `problems()`, a line that is no entry
	// is left out, and `adm` refuses such a file.
	def parse(text string) Lock {
		return new Lock(text.bytes())
	}

	// Reads the lock at `path`; a missing file is an empty lock. Fails when the file cannot be read;
	// what is wrong in it is in `problems()`.
	def load(path string) !Lock {
		let there = try os.exists(path)
		return new Lock(byte[]) unless there
		return new Lock(try os.readFile(path))
	}

	// The parsed lock: its entries, kept and written in `adm`'s form. Comments do not survive a
	// write, as `adm` writes the whole file.
	type Lock {
		internal entries LockedPackage[]
		internal flaws   Problem[]

		internal def new(raw byte[]) {
			readLines(raw)
		}

		internal def readLines(raw byte[]) {
			let n = raw.len()
			let seen = map<string, bool>{}
			let number = 0
			let pos = 0
			for pos < n {
				let end = pos
				for end < n && raw[end] != byte('\n') {
					end++
				}
				number++
				let start = pos
				pos = end < n ?? (end + 1, n)
				let (ts, te) = trimSpan(raw, start, end)
				continue when ts == te || raw[ts] == byte('#')
				readEntry(raw, start, ts, te, number, seen)
			}
		}

		internal def readEntry(raw byte[], lineStart int, ts int, te int, number int, seen map<string, bool>) {
			let (fs, fe) = nextField(raw, ts, te)
			let fields = textOf(raw, fs, fe)
			let parts = fields.split(":")
			if parts.len() != 4 {
				flag(raw, ProblemKind.Unreadable, "an entry starts namespace:name:hash:version, not `{fields}`; adm refuses this file", lineStart, fs, fe, number)
				return
			}
			let entry = LockedPackage{namespace: parts[0] == localNamespace ?? ("", parts[0]), name: parts[1], hash: parts[2], version: parts[3], permissions: string[]}
			checkHash(raw, entry.hash, lineStart, fs, fe, number)
			let id = entry.namespace + ":" + entry.name
			flag(raw, ProblemKind.Duplicate, "`{id}` is locked twice", lineStart, fs, fe, number) when seen.hasKey(id)
			seen[id] = true

			let at = fe
			for {
				let (a, b) = nextField(raw, at, te)
				break when a == b
				at = b
				readExtra(raw, entry, lineStart, a, b, number)
			}
			entries.push(entry)
		}

		// The next run of text that is no white space from `from` on; an empty span at the end.
		internal def nextField(raw byte[], from int, to int) (int, int) {
			let start = from
			for start < to {
				let width = spaceAt(raw, start, to)
				break when width == 0
				start += width
			}
			let stop = start
			for stop < to && spaceAt(raw, stop, to) == 0 {
				stop++
			}
			return (start, stop)
		}

		internal def checkHash(raw byte[], hash string, lineStart int, fs int, fe int, number int) {
			let bytes = hash.bytes()
			let good = bytes.len() == 64
			for let c in bytes {
				good = false unless (c >= byte('0') && c <= byte('9')) || (c >= byte('a') && c <= byte('f'))
			}
			flag(raw, ProblemKind.BadValue, "the hash is the container's SHA-256 in lower-case hex, not `{hash}`", lineStart, fs, fe, number) unless good
		}

		internal def readExtra(raw byte[], entry LockedPackage, lineStart int, a int, b int, number int) {
			let extra = textOf(raw, a, b)
			let eq = extra.indexOf("=")
			if eq < 0 {
				flag(raw, ProblemKind.UnknownKey, "adm reads only key=value after an entry, and passes over `{extra}`", lineStart, a, b, number)
				return
			}
			let value = extra.slice(eq + 1)
			match extra.slice(0, eq) {
				case "source":
					entry.source = value
				case "publisher":
					entry.publisher = value
				case "foreign":
					entry.foreign = value == "yes"
					flag(raw, ProblemKind.BadValue, "foreign is `yes` or left out; adm reads `{value}` as no", lineStart, a, b, number) when value != "yes"
				case "permissions":
					entry.accepted = true
					for let name in value.split(",") {
						let permission = trimmed(name)
						entry.permissions.push(permission) when permission != ""
					}
				default:
					flag(raw, ProblemKind.UnknownKey, "adm reads no `{extra.slice(0, eq)}` on an entry", lineStart, a, b, number)
			}
		}

		internal def flag(raw byte[], kind ProblemKind, message string, lineStart int, start int, end int, number int) {
			flaws.push(Problem{kind: kind, message: message, start: start, end: end, line: number, column: charsIn(raw, lineStart, start) + 1, path: string[]})
		}

		// What is wrong in the text as it was read, in its order. Only a
		// `ProblemKind.Unreadable` keeps adm from reading the file.
		def problems() Problem[] {
			return flaws
		}

		// The entries, in the order they were read or added.
		def packages() LockedPackage[] {
			return entries
		}

		// The entry for a namespace and name; an empty namespace or `local` is a package installed
		// from a file or URL. None when there is no such entry.
		def find(namespace string, name string) ?LockedPackage {
			let wanted = namespace == localNamespace ?? ("", namespace)
			for let entry in entries {
				return entry when entry.name == name && entry.namespace == wanted
			}
			return none
		}

		// The first entry locked under a name, from any namespace, or none.
		def get(name string) ?LockedPackage {
			for let entry in entries {
				return entry when entry.name == name
			}
			return none
		}

		// Every entry locked under a name, one per namespace.
		def byName(name string) LockedPackage[] {
			let out LockedPackage[]
			for let entry in entries {
				out.push(entry) when entry.name == name
			}
			return out
		}

		// Adds an entry, or replaces the one of its namespace and name: two namespaces may lock the
		// same name, and are different packages.
		def set(entry LockedPackage) {
			for let (i, known) in entries {
				if known.name == entry.name && known.namespace == entry.namespace {
					entries[i] = entry
					return
				}
			}
			entries.push(entry)
		}

		// Takes a package out; an empty namespace or `local` is one installed from a file or URL.
		// Reports whether it was there.
		def remove(namespace string, name string) bool {
			let wanted = namespace == localNamespace ?? ("", namespace)
			for let (i, known) in entries {
				if known.name == name && known.namespace == wanted {
					entries.remove(i)
					return true
				}
			}
			return false
		}

		// The file as `adm` writes it: its header line, then one line per entry, sorted by name and
		// namespace, permissions sorted.
		def text() string {
			let sorted = entries.clone()
			sorted.sort(def (a LockedPackage, b LockedPackage) bool {
				return a.name.compare(b.name) < 0 when a.name != b.name
				return a.namespace.compare(b.namespace) < 0
			})
			let out = headerLine
			for let entry in sorted {
				out += (entry.namespace == "" ?? (localNamespace, entry.namespace)) + ":" + entry.name + ":" + entry.hash + ":" + entry.version
				out += " source=" + entry.source when entry.source != ""
				out += " publisher=" + entry.publisher when entry.publisher != ""
				if entry.accepted {
					let names = entry.permissions.clone()
					names.sort((a string, b string) => a.compare(b) < 0)
					out += " permissions=" + names.join(",")
				}
				out += " foreign=yes" when entry.foreign
				out += "\n"
			}
			return out
		}

		// Writes `text()` to `path`, whole or not at all. Fails when it cannot be written.
		def save(path string) !none {
			try writeWhole(path, text().bytes())
		}
	}
}
