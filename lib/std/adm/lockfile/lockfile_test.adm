partial module std.adm.lockfile {
	use (
		std.os
		std.testing
	)

	internal const goodHash = "b6a8504533a68156089ed1f541ae26be617fc70c59e93040d9cccda5acd7de62"

	// The value of an optional, failing the test when there is none.
	internal def required<T>(value ?T) !T {
		fail "nothing there" when value is none
		return value
	}

	check "Lock reading" {
		@test()
		def readsAnEntry() !none {
			let lock = parse("# comment\n\nadmlang:adm.b:{goodHash}:0.1.0 source=registry:public publisher=admpub_x permissions=b,a foreign=yes\n")
			assert lock.problems().len() == 0
			let entries = lock.packages()
			assert entries.len() == 1
			let entry = entries[0]
			assert entry.namespace == "admlang"
			assert entry.name == "adm.b"
			assert entry.hash == goodHash
			assert entry.version == "0.1.0"
			assert entry.source == "registry:public"
			assert entry.publisher == "admpub_x"
			assert entry.permissions.join("|") == "b|a"
			assert entry.accepted
			assert entry.foreign
		}

		@test()
		def anEmptyAcceptedSetIsADecision() {
			let lock = parse("n:a:{goodHash}:1 permissions=\nn:b:{goodHash}:1\n")
			let (asked, never) = (lock.packages()[0], lock.packages()[1])
			assert asked.accepted
			assert asked.permissions.len() == 0
			assert !never.accepted
		}

		@test()
		def anEmptyNamespaceIsLocal() {
			let lock = parse("local:a:{goodHash}:1\n:b:{goodHash}:1\n")
			assert lock.packages()[0].namespace == ""
			assert lock.packages()[1].namespace == ""
			assert !(lock.find("", "a") is none)
			assert !(lock.find("local", "b") is none)
			assert lock.problems().len() == 0
		}

		@test()
		def findsByNamespaceAndName() !none {
			let lock = parse("x:a:{goodHash}:1\ny:a:{goodHash}:2\nz:b:{goodHash}:3\n")
			let found = try required(lock.find("y", "a"))
			assert found.version == "2"
			assert lock.find("q", "a") is none
			let first = try required(lock.get("a"))
			assert first.namespace == "x"
			assert lock.get("c") is none
			assert lock.byName("a").len() == 2
			assert lock.byName("c").len() == 0
		}

		@test()
		def nothingIsEmpty() {
			assert parse("").packages().len() == 0
			assert parse("  \n\t\n# only\n").problems().len() == 0
		}
	}

	check "Lock problems" {
		internal def places(lock Lock) string[] {
			let out string[]
			for let problem in lock.problems() {
				out.push("{problem.line}:{problem.column} {problem.kind}")
			}
			return out
		}

		@test()
		def namesEachKindAtItsPlace() !none {
			let lock = parse("bad line\n\nn:a:{goodHash}:1 junk other=1 foreign=no\nn:b:short:1\nn:a:{goodHash}:2\n")
			let list = places(lock)
			assert list[0] == "1:1 Unreadable"
			assert list[1] == "3:72 UnknownKey"
			assert list[2] == "3:77 UnknownKey"
			assert list[3] == "3:85 BadValue"
			assert list[4] == "4:1 BadValue"
			assert list[5] == "5:1 Duplicate"
			assert list.len() == 6
			// The line that is no entry is left out, the rest is read.
			assert lock.packages().len() == 3
		}

		@test()
		def spansCoverTheText() {
			let text = "  n:a:{goodHash}:1 what=x\n"
			let lock = parse(text)
			let problem = lock.problems()[0]
			assert string(text.bytes()[problem.start:problem.end]) == "what=x"
		}
	}

	check "Lock writing" {
		@test()
		def writesWhatAdmWrites() {
			// The expected bytes come from internal/admapp over the same text.
			let lock = parse(`# comment
admlang:adm.b:b6a8504533a68156089ed1f541ae26be617fc70c59e93040d9cccda5acd7de62:0.1.0 source=registry:public publisher=admpub_6o permissions= foreign=yes

local:adm.a:ab:1.0.0 permissions=z,a,,b foreign=no junk other=1
zed:adm.a:ab:1.0.0   source=file:/x
:adm.c:ab:2.0.0
`)
			assert lock.text() == `# adm.lock — namespace:name:hash:version [source=... publisher=... permissions=a,b foreign=yes]; written by adm install / adm get
local:adm.a:ab:1.0.0 permissions=a,b,z
zed:adm.a:ab:1.0.0 source=file:/x
admlang:adm.b:b6a8504533a68156089ed1f541ae26be617fc70c59e93040d9cccda5acd7de62:0.1.0 source=registry:public publisher=admpub_6o permissions= foreign=yes
local:adm.c:ab:2.0.0
`
		}

		@test()
		def textReadsBackTheSame() {
			let lock = parse("y:b:{goodHash}:1 permissions=\nlocal:a:{goodHash}:2 source=/x foreign=yes\n")
			assert parse(lock.text()).text() == lock.text()
			assert parse(lock.text()).problems().len() == 0
		}

		@test()
		def setReplacesWithinANamespace() {
			let lock = parse("x:a:{goodHash}:1\n")
			lock.set(LockedPackage{namespace: "x", name: "a", hash: goodHash, version: "2"})
			assert lock.packages().len() == 1
			assert lock.packages()[0].version == "2"
			lock.set(LockedPackage{namespace: "y", name: "a", hash: goodHash, version: "3"})
			assert lock.packages().len() == 2
		}

		@test()
		def removeTakesOnePackage() {
			let lock = parse("x:a:{goodHash}:1\nlocal:a:{goodHash}:2\n")
			assert !lock.remove("y", "a")
			assert lock.remove("local", "a")
			assert lock.packages().len() == 1
			assert lock.remove("x", "a")
			assert lock.packages().len() == 0
			assert !lock.remove("x", "a")
		}

		@test()
		def noPermissionsAreWrittenWithoutTheQuestion() {
			let lock = parse("")
			lock.set(LockedPackage{name: "a", hash: goodHash, version: "1"})
			lock.set(LockedPackage{name: "b", hash: goodHash, version: "1", accepted: true})
			assert lock.text().endsWith("local:a:{goodHash}:1\nlocal:b:{goodHash}:1 permissions=\n")
		}
	}

	check "Lock files" {
		internal def scratchFolder(name string) !string {
			let folder = os.join(os.tempDir(), "adm-lockfile-test-" + name)
			try os.mkdir(os.join(folder, "a", "b"), true)
			return folder
		}

		@test()
		def findPrefersTheNearestLockThenTheManifest() !none {
			let folder = try scratchFolder("find")
			let inner = os.join(folder, "a", "b")
			let toml = os.join(folder, "a", "adm.toml")
			try os.writeFile(toml, "schema = 1\n".bytes())
			let (beside, there) = find(inner)
			assert beside == os.join(folder, "a", fileName)
			assert !there
			let lock = os.join(folder, "a", "b", fileName)
			try os.writeFile(lock, "".bytes())
			let (near, exists) = find(inner)
			assert near == lock
			assert exists
			let (fromFile, viaFile) = find(lock)
			assert fromFile == lock
			assert viaFile
			try os.remove(lock)
			try os.remove(toml)
		}

		@test()
		def loadsSavesAndAMissingFileIsEmpty() !none {
			let folder = try scratchFolder("save")
			let path = os.join(folder, "new", fileName)
			let lock = try load(path)
			assert lock.packages().len() == 0
			lock.set(LockedPackage{namespace: "x", name: "a", hash: goodHash, version: "1"})
			try lock.save(path)
			let back = try load(path)
			assert back.packages()[0].name == "a"
			assert string(try os.readFile(path)) == lock.text()
			try os.remove(path)
			try os.rmdir(os.join(folder, "new"))
		}
	}
}
