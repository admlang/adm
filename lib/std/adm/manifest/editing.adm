// Edits of `adm.toml` as splices of its bytes: a value is replaced where it stands, a key goes at
// the end of its table's own lines, and nothing else moves.
internal partial module std.adm.manifest.editing {
	use (
		std.adm.manifest.reading::*
		std.adm.manifest.text::*
	)

	// The bytes with `from` to `to` replaced by the text.
	def spliced(raw byte[], from int, to int, text string) byte[] {
		let add = text.bytes()
		let out byte[]
		out.len(raw.len() - (to - from) + add.len())
		let at = 0
		for let i = 0; i < from; i++ {
			out[at] = raw[i]
			at++
		}
		for let i = 0; i < add.len(); i++ {
			out[at] = add[i]
			at++
		}
		for let i = to; i < raw.len(); i++ {
			out[at] = raw[i]
			at++
		}
		return out
	}

	// The line break the file uses.
	def lineBreak(raw byte[]) string {
		for let i = 0; i < raw.len(); i++ {
			return i > 0 && raw[i - 1] == byte('\r') ?? ("\r\n", "\n") when raw[i] == byte('\n')
		}
		return "\n"
	}

	// The last line of that address that `adm` reads as a key.
	def lastEntry(read Reading, address string) ?Line {
		for let i = read.lines.len() - 1; i >= 0; i-- {
			let line = read.lines[i]
			return line when line.known && line.kind == LineKind.Entry && line.address == address
		}
		return none
	}

	// The index of the last header of that address, -1 without one.
	def lastHeader(read Reading, address string) int {
		for let i = read.lines.len() - 1; i >= 0; i-- {
			let line = read.lines[i]
			return i when line.kind == LineKind.Header && !line.continued && line.address == address
		}
		return -1
	}

	// Whether an address is that one, or below it.
	def isWithin(address string, top string) bool {
		return address == top || address.startsWith(top + separator)
	}

	// The index of the line a table's own lines end before, `first` being the first of them: the
	// next header's, or the first of the blank lines and the comment touching that header.
	def bodyEnd(read Reading, first int) int {
		let lines = read.lines
		let stop = first
		for stop < lines.len() && !(lines[stop].kind == LineKind.Header && !lines[stop].continued) {
			stop++
		}
		let end = stop
		if stop < lines.len() {
			for end > first && lines[end - 1].kind == LineKind.Comment {
				end--
			}
		}
		for end > first && lines[end - 1].kind == LineKind.Blank {
			end--
		}
		return end
	}

	// Where the line of that index starts; the end of the file past the last line.
	def offsetOf(read Reading, index int) int {
		return index < read.lines.len() ?? (read.lines[index].start, read.raw.len())
	}

	// Inserts whole lines where the line of that index starts, ending the line before when the
	// file stopped without a line break.
	def insertLines(read Reading, index int, lines string[]) byte[] {
		let raw = read.raw
		let breaks = lineBreak(raw)
		let at = offsetOf(read, index)
		let text = at > 0 && raw[at - 1] != byte('\n') ?? (breaks, "")
		for let line in lines {
			text += line + breaks
		}
		return spliced(raw, at, at, text)
	}

	// The white space a line opens with.
	def indentOf(read Reading, line Line) string {
		return textOf(read.raw, line.start, line.textStart)
	}

	// Writes `key = value` in the table of that header index (-1: the top of the file): after the
	// table's own lines.
	def insertIntoTable(read Reading, header int, entry string) byte[] {
		let first = header + 1
		let end = bodyEnd(read, first)
		let indent = ""
		for let i = end - 1; i >= first; i-- {
			if read.lines[i].kind == LineKind.Entry {
				indent = indentOf(read, read.lines[i])
				break
			}
		}
		return insertLines(read, end, [indent + entry])
	}

	// Writes a new table with its first key: after the tables of the nearest parent the file has,
	// else at the end of the file, a blank line apart.
	def insertTable(read Reading, path string[], rows bool, entry string) byte[] {
		let spelled = headerText(path)
		let header = rows ?? ("[[" + spelled + "]]", "[" + spelled + "]")
		let lines = read.lines
		for let size = path.len(); size >= 1; size-- {
			let top = address(path[:size])
			for let i = lines.len() - 1; i >= 0; i-- {
				let line = lines[i]
				if line.kind == LineKind.Header && !line.continued && isWithin(line.address, top) {
					let end = bodyEnd(read, i + 1)
					let block = ["", header, entry]
					block.push("") when end < lines.len() && lines[end].kind != LineKind.Blank
					return insertLines(read, end, block)
				}
			}
		}
		let block string[]
		block.push("") when lines.len() > 0 && lines[lines.len() - 1].kind != LineKind.Blank
		block.push(header)
		block.push(entry)
		return insertLines(read, lines.len(), block)
	}

	// Whether the table at that address is one header and nothing of its own: no key, no line
	// adm passes over, no comment (on the header's line or under it, one touching the next header
	// being that header's), no table below it, and no second header opening it again.
	def isEmptyTable(read Reading, top string) bool {
		let lines = read.lines
		let header = -1
		for let i = 0; i < lines.len(); i++ {
			let line = lines[i]
			continue when line.kind != LineKind.Header || line.continued || !isWithin(line.address, top)
			return false when header >= 0 || line.address != top
			header = i
		}
		return false when header < 0
		let line = lines[header]
		let (start, stop) = trimSpan(read.raw, line.textEnd, line.end)
		return false when start < stop
		let end = bodyEnd(read, header + 1)
		for let i = header + 1; i < end; i++ {
			return false when lines[i].kind != LineKind.Blank
		}
		return true
	}

	// The text with every line of that address, or below it, taken out. A table goes up to the
	// comment touching the next header, and the blank lines it leaves around it become one.
	// Reports whether anything was taken.
	def withoutAddress(read Reading, top string) (byte[], bool) {
		let lines = read.lines
		let dropped bool[]
		dropped.len(lines.len())
		let any = false
		for let i = 0; i < lines.len(); i++ {
			let line = lines[i]
			continue when line.continued || !isWithin(line.address, top)
			if line.kind == LineKind.Entry {
				dropped[i] = true
				any = true
				for let j = i + 1; j < lines.len() && lines[j].start < line.valueStop; j++ {
					dropped[j] = true
				}
			} else if line.kind == LineKind.Header {
				any = true
				let end = bodyEnd(read, i + 1)
				for let j = i; j < end; j++ {
					dropped[j] = true
				}
			}
		}
		return (read.raw, false) unless any

		let raw = read.raw
		let out byte[]
		let lastBlank = true
		let tookAny = false
		// Where the last line kept starts in `out`: a blank one the removal left at the end goes too.
		let lastStart = -1
		for let i = 0; i < lines.len(); i++ {
			let line = lines[i]
			if dropped[i] {
				tookAny = true
				continue
			}
			let isBlank = line.kind == LineKind.Blank
			if tookAny && isBlank && lastBlank {
				continue
			}
			tookAny = false
			lastStart = out.len()
			for let j = line.start; j < line.next; j++ {
				out.push(raw[j])
			}
			lastBlank = isBlank
		}
		out.len(lastStart) when tookAny && lastBlank && lastStart >= 0
		return (out, true)
	}
}
