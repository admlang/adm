// `adm.toml`, the project manifest: its identity, libraries, registries, policy, applications and
// packaging, read as `adm` reads it and edited without touching what an edit is not about. Comments,
// the order of keys and keys adm does not know stay as they are written.
//
// Example:
// ```example
// let path = manifest.find(".")
// if !(path is none) {
//     let m = try manifest.load(path)
//     for let problem in m.problems() {
//         println("{problem.line}:{problem.column} {problem.message}")
//     }
//     try m.set(["update", "channel"], "stable")
//     try m.save(path)
// }
// ```
partial module std.adm.manifest {
	use (
		std.adm.manifest.editing::*
		std.adm.manifest.reading::*
		std.adm.manifest.schema::*
		std.adm.manifest.text::*
		std.crypto.hash::(SHA256)
		std.data.encoding::(Base32)
		std.data.semver
		std.os
	)

	// The name of the manifest file.
	const fileName = "adm.toml"

	// The name manifests of old projects still have.
	const legacyFileName = ".admapp"

	// The version of the format this module reads.
	const schemaVersion = 1

	// What a key takes, which also says how a form asks for it.
	enum ValueKind {
		// A string.
		Text,
		// A whole number.
		Number,
		// `true` or `false`.
		Flag,
		// A list of strings on one line.
		List,
		// A version such as `1.2.0`.
		Version,
		// A range of versions such as `^1.2`.
		Range,
		// The name of an environment variable, `${NAME}`.
		EnvVar,
		// An Ed25519 public key, `ed25519:base64:...`.
		PublicKey,
		// A random salt, `base64:...`.
		Salt,
		// Permission bits in octal.
		Mode,
		// A table of keys.
		Table,
		// An array of tables, each element a row.
		Rows
	}

	// What is wrong with a place in the file.
	enum ProblemKind {
		// A key or table adm does not read: it passes over it.
		UnknownKey,
		// A value adm reads as nothing, or as something else than it says.
		BadValue,
		// A literal where `${ENV_VAR}` belongs: a secret in a file that gets committed.
		LiteralSecret,
		// A line that is neither a header nor a key: adm passes over it.
		Unreadable,
		// A key written twice, or a table opened twice.
		Duplicate,
		// A schema adm refuses: it does not build with this file.
		Schema
	}

	// A problem at a place in the text.
	struct Problem {
		kind    ProblemKind
		// What is wrong and what to do, in English; `kind` and `path` tell it to a program.
		message string
		// The bytes it covers, as offsets into the text.
		start   int
		end     int
		// Its line and the column on it, both from 1; the column counts characters.
		line    int
		column  int
		// The key or table it is about; empty for a line that is neither.
		path    string[]
	}

	// Something `Manifest.available` offers to add.
	struct Option {
		// The key or table's name; `*` when the file chooses it (an application, a library).
		name   string
		kind   ValueKind
		// What it may be; empty when it may be anything of its kind.
		values string[]
		doc    string
	}

	// The `[publisher]` table: the identity ids derive from.
	struct Publisher {
		pubkey   string = ""
		repoSalt string = ""
		name     string = ""
	}

	// An `[update]` table: the project's defaults, or an application's own.
	struct Update {
		feed     string = ""
		channel  string = ""
		artifact string = ""
	}

	// A row of `[[package.files]]`.
	struct FileRule {
		from string = ""
		to   string = ""
		mode string = ""
	}

	// A `[package]` table with its files.
	struct Package {
		format      string     = ""
		installRoot string     = ""
		binLink     string     = ""
		files       FileRule[]
	}

	// The `[plugins]` table: what an application lets the plugins it loads be and do.
	type Plugins {
		allowUnsigned bool     = false
		trusted       string[]
		permissions   string[]

		// The table as the constant a build gives the program: `unsigned=<0|1>;trusted=<id>,...;
		// permissions=<name>,...`, the lists sorted, without repeats or items holding `,`, `;` or `=`.
		def constant() string {
			return "unsigned=" + (allowUnsigned ?? ("1", "0")) + ";trusted=" + constantList(trusted) + ";permissions=" + constantList(permissions)
		}
	}

	internal def constantList(items string[]) string {
		let seen = map<string, bool>{}
		let out string[]
		for let raw in items {
			let item = trimmed(raw)
			continue when item == "" || seen.hasKey(item) || item.contains(",") || item.contains(";") || item.contains("=")
			seen[item] = true
			out.push(item)
		}
		out.sort((a string, b string) => a.compare(b) < 0)
		return out.join(",")
	}

	// An `[apps.<name>.compat]` table: where a published unit works. Informational: nothing refuses
	// an install over it.
	type Compat {
		os   string[]
		arch string[]
		adm  string   = ""

		// Whether it constrains nothing.
		def isAll() bool {
			return os.len() == 0 && arch.len() == 0 && trimmed(adm) == ""
		}

		// The constraints for a reader: `All`, or the parts set, such as
		// `windows · arm64 · adm ≥ 0.1.1500`.
		def summary() string {
			return "All" when isAll()
			let parts string[]
			parts.push(os.join(", ")) when os.len() > 0
			parts.push(arch.join(", ")) when arch.len() > 0
			let version = trimmed(adm)
			parts.push("adm ≥ " + version) when version != ""
			return parts.join(" · ")
		}
	}

	// A `[apps.<name>]` table and those below it.
	struct App {
		name        string
		slug        string  = ""
		version     string  = ""
		description string  = ""
		update      Update
		package     Package
		compat      Compat
	}

	// A line of `[deps]`.
	struct Dep {
		// As it is filed: `namespace:name`, or a bare name.
		key       string
		namespace string
		name      string
		// The versions accepted.
		range     string
		// The line it is written on, from 1.
		line      int
	}

	// A `[registries.<name>]` table.
	struct Registry {
		name  string
		url   string = ""
		token string = ""
	}

	// What a project's identity and updates come to for one application. Everything is empty when
	// the publisher's key or salt is missing or wrong: identity is optional.
	struct Resolved {
		publisherId     string = ""
		publisherPubkey string = ""
		appId           string = ""
		// The name the application is known by: its slug, else its own name.
		appName         string = ""
		appVersion      string = ""
		updateFeed      string = ""
		updateChannel   string = ""
		updateArtifact  string = ""
	}

	// Where a value of a section comes from.
	enum ValueSource {
		// The section's own table sets it.
		Here,
		// A unit's section has no value of its own, and the project's table sets it.
		Inherited,
		// Neither sets it.
		Unset
	}

	// A key of a section and what it comes to.
	struct Setting {
		key    string
		kind   ValueKind
		// What the key may be; empty when it may be anything of its kind.
		values string[]
		doc    string
		source ValueSource
		// The key's path in this section, whatever the source: `set` on it writes the section's own
		// value, `remove` takes that value out.
		path   string[]
		// What it comes to, as `adm` reads it; `true` or `false` for a flag, "" for a list and when
		// unset.
		value  string      = ""
		// What a list comes to.
		items  string[]    = []
	}

	// A row of a section's files.
	struct FileRow {
		rule   FileRule
		// `Here`, or `Inherited` for the project's row in a unit's list.
		source ValueSource
		// The row's path, to `set` its keys or `remove` it: `["package", "files", "0"]`.
		path   string[]
	}

	// Which part of a version `Manifest.bumpVersion` moves.
	enum VersionPart {
		Major,
		Minor,
		Patch
	}

	// Lower-case, unpadded Base32.
	internal def idText(sum byte[]) string {
		let codec = new Base32()
		codec.padded = false
		return codec.encode(sum).lower()
	}

	// The id a publisher's public key derives to.
	def publisherId(publicKey byte[]) string {
		return "admpub_" + idText((new SHA256()).hash(publicKey))
	}

	// The id an application derives to from its publisher's key, the project's salt and its slug;
	// "" when any of them is empty.
	def appId(publicKey byte[], repoSalt byte[], slug string) string {
		let name = trimmed(slug)
		return "" when publicKey.len() == 0 || repoSalt.len() == 0 || name == ""
		let digest = new SHA256()
		digest.write(publicKey)
		digest.write(":".bytes())
		digest.write(repoSalt)
		digest.write(":".bytes())
		digest.write(name.bytes())
		return "admapp_" + idText(digest.hash())
	}

	// Finds the nearest manifest: in the folder `start` names (or the file's folder) and those above
	// it, `adm.toml` before `.admapp`. None when there is none, or `start` is empty.
	def find(start string) ?string {
		let from = trimmed(start)
		return none when from == ""
		let folder = os.resolve(from) onerror recover from
		let info = os.stat(folder)
		folder = os.dir(folder) when !(info is error) && !info.isDir
		for {
			for let name in [fileName, legacyFileName] {
				let candidate = os.join(folder, name)
				let found = os.stat(candidate)
				return candidate when !(found is error) && (int(found.mode) & int(os.FileMode.Type)) == 0
			}
			let parent = os.dir(folder)
			break when parent == folder
			folder = parent
		}
		return none
	}

	// Reads the text of a manifest. Never fails: what is wrong is in `problems()`, and what adm would
	// read from such a text is what the reads give.
	def parse(text string) Manifest {
		return new Manifest(text.bytes())
	}

	// Reads the manifest at `path`. Fails when the file cannot be read; what is wrong in it is in
	// `problems()`.
	def load(path string) !Manifest {
		return new Manifest(try os.readFile(path))
	}

	// A manifest: its text, what adm reads from it, and the edits that keep the rest of the text as
	// it is.
	type Manifest {
		internal raw  byte[]
		internal data Reading

		internal def new(raw byte[]) {
			self.raw = raw
			data = new Reading(raw)
		}

		internal def edited(next byte[]) {
			raw = next
			data = new Reading(next)
		}

		// The whole text, with every edit made so far.
		def text() string {
			return string(raw)
		}

		// Writes the text to `path`, whole or not at all. Fails when it cannot be written.
		def save(path string) !none {
			try writeWhole(path, raw)
		}

		// What is wrong in the text, in its order. Only a `ProblemKind.Schema` keeps adm from
		// building; adm passes over the others.
		def problems() Problem[] {
			return data.problems
		}

		// The version of the format: 1 when the file does not say.
		def schema() int {
			return data.schema
		}

		// The `[publisher]` table.
		def publisher() Publisher {
			return data.publisher
		}

		// The `[update]` table: the defaults of every application.
		def update() Update {
			return data.update
		}

		// The `[package]` table with `[[package.files]]`: the defaults of every application.
		def package() Package {
			return data.packaging
		}

		// The lines of `[deps]`, in the file's order.
		def deps() Dep[] {
			return data.deps
		}

		// The line of `[deps]` under `key`, or none.
		def dep(key string) ?Dep {
			return data.depNamed(key)
		}

		// `[requires] permissions`: what the package asks to be granted. None without the key, which
		// asks for no narrowing; an empty list asks for nothing at all.
		def requires() ?string[] {
			return data.requires
		}

		// `[policy] sandbox`: whether the program applies the OS sandbox at startup.
		def sandbox() bool {
			return data.sandbox
		}

		// `[policy] build_read`: the paths outside the source tree a build-time meta may read.
		def buildRead() string[] {
			return data.buildRead
		}

		// The `[plugins]` table.
		def plugins() Plugins {
			return data.plugins
		}

		// The `[apps.<name>]` tables that hold a key, in the file's order.
		def apps() App[] {
			return data.apps
		}

		// The application of that name, or none.
		def app(name string) ?App {
			return data.appNamed(name)
		}

		// The `[registries.<name>]` tables, in the file's order.
		def registries() Registry[] {
			return data.registries
		}

		// The registry of that name, or none.
		def registry(name string) ?Registry {
			return data.registryNamed(name)
		}

		// `[registries] order`: the names in resolution order, empty when the file gives none.
		def registryOrder() string[] {
			return data.registryOrder
		}

		// What the project's identity and updates come to for an application, its own table over the
		// defaults. No name, with exactly one application configured, means that one. Everything is
		// empty when the publisher's key or salt is missing or wrong.
		def resolve(appName string = "") Resolved {
			let key = publicKeyBytes(data.publisher.pubkey)
			return Resolved{} when key is error
			let salt = saltBytes(data.publisher.repoSalt)
			return Resolved{} when salt is error

			let out = Resolved{publisherId: publisherId(key), publisherPubkey: data.publisher.pubkey}
			let name = trimmed(appName)
			name = trimmed(data.apps[0].name) when name == "" && data.apps.len() == 1
			return out when name == ""

			let own = data.appNamed(name)
			let slug = name
			out.updateFeed = trimmed(data.update.feed)
			out.updateChannel = trimmed(data.update.channel)
			out.updateArtifact = trimmed(data.update.artifact)
			if !(own is none) {
				let ownSlug = trimmed(own.slug)
				slug = ownSlug when ownSlug != ""
				out.appVersion = trimmed(own.version)
				out.updateFeed = chosen(own.update.feed, out.updateFeed)
				out.updateChannel = chosen(own.update.channel, out.updateChannel)
				out.updateArtifact = chosen(own.update.artifact, out.updateArtifact)
			}
			out.appId = appId(key, salt, slug)
			out.appName = slug
			return out
		}

		// How an application is packaged: its own table over the defaults, its files after theirs.
		def packageFor(appName string) Package {
			let out = Package{format: trimmed(data.packaging.format), installRoot: trimmed(data.packaging.installRoot), binLink: trimmed(data.packaging.binLink), files: FileRule[]}
			for let rule in data.packaging.files {
				out.files.push(rule)
			}
			let own = data.appNamed(trimmed(appName))
			return out when own is none
			out.format = chosen(own.package.format, out.format)
			out.installRoot = chosen(own.package.installRoot, out.installRoot)
			out.binLink = chosen(own.package.binLink, out.binLink)
			for let rule in own.package.files {
				out.files.push(rule)
			}
			return out
		}

		internal def chosen(own string, fallback string) string {
			let text = trimmed(own)
			return text == "" ?? (fallback, text)
		}

		// Every key of a section with what it comes to and where that comes from. `path` names the
		// table: `["publisher"]`, `["apps", "Main"]`, `["apps", "Main", "update"]`, which needs no table
		// in the file yet. As `resolve` and `packageFor` read them, a unit's `update` and `package` keys
		// with an empty or missing value take the project's. Empty for a table adm does not read; a
		// table's chosen names (`deps`) and `package.files` are not listed: `deps()`, `registries()`
		// and `files` give them.
		def settings(path string[] = []) Setting[] {
			let out Setting[]
			let spec = tableSpec(patternOf(path))
			return out when spec is none
			let inherits = path.len() == 3 && path[0] == "apps" && (path[2] == "update" || path[2] == "package")
			for let field in spec.fields {
				continue when field.key == "*"
				let keyPath = path.clone()
				keyPath.push(field.key)
				let setting = Setting{key: field.key, kind: field.kind, values: field.values, doc: field.doc, source: ValueSource.Unset, path: keyPath, items: string[]}
				fillSetting(setting, keyPath, ValueSource.Here, inherits)
				fillSetting(setting, [path[2], field.key], ValueSource.Inherited, true) when setting.source == ValueSource.Unset && inherits
				out.push(setting)
			}
			return out
		}

		// Gives a setting the value of the key at `from`, when it has one; `trim` reads a string as
		// `resolve` and `packageFor` do.
		internal def fillSetting(setting Setting, from string[], source ValueSource, trim bool) {
			let line = lastEntry(data, address(from))
			return when line is none
			let (vs, ve) = (line.valueStart, line.valueEnd)
			match setting.kind {
				case ValueKind.List:
					setting.items = data.listOrEmpty(vs, ve)
					setting.source = source
				case ValueKind.Flag:
					setting.value = textOf(raw, vs, ve) == "true" ?? ("true", "false")
					setting.source = source
				case ValueKind.Number:
					setting.value = textOf(raw, vs, ve)
					setting.source = source
				default:
					let text = data.stringOf(vs, ve)
					return when text is none
					let value = trim ?? (trimmed(text), text)
					return when trimmed(value) == ""
					setting.value = value
					setting.source = source
			}
		}

		// The units with their own value for a key of the project's `update` or `package` tables, which
		// wins over the project's there: `overriddenBy(["update", "feed"])`. Empty for any other path.
		def overriddenBy(path string[]) string[] {
			let out string[]
			return out when path.len() != 2 || (path[0] != "update" && path[0] != "package")
			for let app in data.apps {
				let line = lastEntry(data, address(["apps", app.name, path[0], path[1]]))
				continue when line is none
				let text = data.stringOf(line.valueStart, line.valueEnd)
				out.push(app.name) when !(text is none) && trimmed(text) != ""
			}
			return out
		}

		// The rows of `package.files`, with no name the project's own; with a unit's name the project's
		// rows and then the unit's, the list `packageFor` gives.
		def files(appName string = "") FileRow[] {
			let out FileRow[]
			let name = trimmed(appName)
			let own = name == "" ?? (ValueSource.Here, ValueSource.Inherited)
			for let (i, rule) in data.packaging.files {
				out.push(FileRow{rule: rule, source: own, path: ["package", "files", "{i}"]})
			}
			let app = data.appNamed(name)
			return out when app is none
			for let (i, rule) in app.package.files {
				out.push(FileRow{rule: rule, source: ValueSource.Here, path: ["apps", name, "package", "files", "{i}"]})
			}
			return out
		}

		// The line a key or table's header is written on, from 1 as `Problem.line`; the one adm reads
		// for a key written twice, the last for a table opened twice. None when the file has neither.
		def lineOf(path string[]) ?int {
			return none when path.len() == 0
			let top = address(path)
			for let i = data.lines.len() - 1; i >= 0; i-- {
				let line = data.lines[i]
				continue when line.continued || line.address != top
				return i + 1 when line.kind == LineKind.Header || (line.kind == LineKind.Entry && line.known)
			}
			return none
		}

		// What can still be added under a table: its keys the file does not have yet, the tables below
		// it it does not have, and always what can be added any number of times (an application, a
		// library, a row). `path` names the table: `[]` for the top of the file, `["apps", "Main"]`,
		// `["package", "files", "0"]`.
		def available(path string[] = []) Option[] {
			let out Option[]
			let pattern = patternOf(path)
			let spec = tableSpec(pattern)
			return out when spec is none
			let top = address(path)
			for let field in spec.fields {
				let keyed = top == "" ?? (field.key, top + separator + field.key)
				out.push(Option{name: field.key, kind: field.kind, values: field.values, doc: field.doc}) when field.key == "*" || lastEntry(data, keyed) is none
			}
			let stem = pattern == "" ?? ("", pattern + ".")
			for let table in tables {
				continue unless table.pattern != pattern && table.pattern.startsWith(stem)
				let name = table.pattern.slice(stem.len())
				continue when name.contains(".")
				let kind = table.rows ?? (ValueKind.Rows, ValueKind.Table)
				let many = table.rows || name == "*" || tableIsOpen(table)
				let below = top == "" ?? (name, top + separator + name)
				out.push(Option{name: name, kind: kind, values: string[], doc: table.doc}) when many || !hasTable(below)
			}
			return out
		}

		// Whether a table's own children have chosen names, so more of them can always be added.
		internal def tableIsOpen(table TableSpec) bool {
			let below = table.pattern + ".*"
			for let other in tables {
				return true when other.pattern == below
			}
			return false
		}

		internal def hasTable(top string) bool {
			for let line in data.lines {
				return true when line.kind == LineKind.Header && !line.continued && isWithin(line.address, top)
			}
			return false
		}

		// Sets a string key: over the value where it stands, keeping what else is on its line and
		// turning a value that ran over several lines into one line; else as a new line at the end of
		// its table, the table added when missing. A row of `package.files` is addressed by its index
		// (`["package", "files", "0", "to"]`); the index one past the last adds a row.
		//
		// Fails on a key adm does not read (`remove` still takes it out), a key that takes something
		// else than a string, a value that key refuses (see `available`), a line break in the value.
		def set(path string[], value string) !none {
			let field = try fieldAt(path)
			fail "`{path.join(".")}` takes {kindName(field.kind)}, not a string" when field.kind == ValueKind.List || field.kind == ValueKind.Flag || field.kind == ValueKind.Number
			fail "a value of adm.toml stays on one line" when value.contains("\n") || value.contains("\r")
			let wrong = textFlaw(field, value)
			fail wrong when wrong != ""
			try write(path, written(path[path.len() - 1]), quoted(value))
		}

		// Sets a key that takes a list, as `set(path, string)` does. Fails on any other key, an empty
		// item, one holding a comma or a line break (adm would not read it back), a value the key
		// refuses.
		def set(path string[], value string[]) !none {
			let field = try fieldAt(path)
			fail "`{path.join(".")}` takes {kindName(field.kind)}, not a list" when field.kind != ValueKind.List
			let items string[]
			for let item in value {
				fail "an item of a list is not empty" when item == ""
				fail "adm does not read an item holding a comma or a line break: `{item}`" when item.contains(",") || item.contains("\n") || item.contains("\r")
				fail "`{item}` is not one of {field.values.join(", ")}" when field.values.len() > 0 && !(item in field.values)
				items.push(quoted(item))
			}
			try write(path, written(path[path.len() - 1]), "[" + items.join(", ") + "]")
		}

		// Sets a key that takes `true` or `false`, as `set(path, string)` does. Fails on any other key.
		def set(path string[], value bool) !none {
			let field = try fieldAt(path)
			fail "`{path.join(".")}` takes {kindName(field.kind)}, not a flag" when field.kind != ValueKind.Flag
			try write(path, written(path[path.len() - 1]), value ?? ("true", "false"))
		}

		// Sets a key that takes a whole number, as `set(path, string)` does. Fails on any other key,
		// or a number the key refuses.
		def set(path string[], value int) !none {
			let field = try fieldAt(path)
			fail "`{path.join(".")}` takes {kindName(field.kind)}, not a number" when field.kind != ValueKind.Number
			fail "this adm reads schema {schemaVersion}, not {value}" when value != schemaVersion
			try write(path, written(path[path.len() - 1]), "{value}")
		}

		internal def kindName(kind ValueKind) string {
			match kind {
				case ValueKind.List:
					return "a list"
				case ValueKind.Flag:
					return "true or false"
				case ValueKind.Number:
					return "a number"
				default:
					return "a string"
			}
		}

		internal def fieldAt(path string[]) !FieldSpec {
			expects {
				assert path.len() != 0 onerror fail "a key's path has at least its name"
			}
			let spec = tableSpec(patternOf(path[:path.len() - 1]))
			fail "adm reads no `{path.join(".")}`" when spec is none
			let field = fieldSpec(spec, path[path.len() - 1])
			fail "adm reads no `{path.join(".")}`" when field is none
			return field
		}

		internal def write(path string[], key string, literal string) !none {
			let entry = key + " = " + literal
			let known = lastEntry(data, address(path))
			if !(known is none) {
				edited(spliced(raw, known.valueStart, known.valueStop, literal))
				return
			}
			let table = path[:path.len() - 1]
			if table.len() == 0 {
				edited(insertIntoTable(data, -1, entry))
				return
			}
			let header = lastHeader(data, address(table))
			if header >= 0 {
				edited(insertIntoTable(data, header, entry))
				return
			}
			let rowOf = rowOwner(table)
			if rowOf.len() > 0 {
				let index = integerOf(table[table.len() - 1])
				let base = address(rowOf)
				let count = data.rowCounts.hasKey(base) ?? (data.rowCounts[base], 0)
				fail "`{path.join(".")}`: this array has {count} rows, the next is row {count}" when index is none || index != count
				edited(insertTable(data, rowOf, true, entry))
				return
			}
			edited(insertTable(data, table, false, entry))
		}

		// The array a row's path is in; empty for any other table.
		internal def rowOwner(table string[]) string[] {
			let n = table.len()
			return string[] when n < 3 || table[n - 2] != "files" || table[n - 3] != "package"
			return table[:n - 1]
		}

		// Takes out a key with all its lines, a table with its own lines and every table below it, or
		// one row of an array of tables: any path, whether adm reads it or not. What is on the lines
		// goes with them; a comment above stays, and one touching the next header stays with it. A
		// table left with no key stays too. Reports whether anything was taken.
		def remove(path string[]) bool {
			return false when path.len() == 0
			let (next, changed) = withoutAddress(data, address(path))
			edited(next) when changed
			return changed
		}

		// Takes out a table that holds nothing: its header, when it has no key, no comment of its own
		// and no table below it. For a form whose last key of a table was emptied, as `remove` leaves
		// the table there. A comment above the header stays, and so does one touching the next header.
		// Reports whether it took it; a table not there, or holding something, stays as it is.
		def removeIfEmpty(path string[]) bool {
			return false when path.len() == 0 || !isEmptyTable(data, address(path))
			return remove(path)
		}

		// Files a library in `[deps]`, or changes the versions it accepts. `key` is `namespace:name`
		// or a bare name; `range` as `Semver.satisfies` reads it, or `latest`. Fails on a key holding
		// a quote, `=`, a line break or nothing, or a range that is none.
		def addDep(key string, range string) !none {
			expects {
				assert key != "" && !(key.contains("\"")) && !(key.contains("=")) && !(key.contains("\n")) && !(key.contains("\r")) onerror fail "a library's key is `namespace:name` or a name"
			}
			try set(["deps", key], range)
		}

		// Moves an application's version up by `part` to the nearest release above it, and returns it.
		// The parts after `part` go to 0, and pre-release and build go. A pre-release comes before its
		// release, so its version is already on the way there: `1.2.3-rc.2` goes to `1.2.3` on Patch and
		// `1.3.0` on Minor, `1.2.0-rc.1` to `1.2.0` on Minor, `2.0.0-rc.1` to `2.0.0` on Major. Build
		// metadata alone changes nothing of this: `1.2.3+x` goes to `1.2.4`. A short version reads its
		// missing parts as 0: `1.0` goes to `1.0.1`, `1.1.0` and `2.0.0`. An application with no version
		// gets the first of that part (0.0.1, 0.1.0, 1.0.0), its line after `slug`, or first in the
		// table. Fails when the file has no table for it, or its version is none.
		def bumpVersion(appName string, part VersionPart = VersionPart.Patch) !semver.Semver {
			let top = address(["apps", appName])
			let header = lastHeader(data, top)
			fail "adm.toml has no [apps.{written(appName)}]: add the application first" when header < 0

			let (major, minor, patch) = (uint(0), uint(0), uint(0))
			let isPre = false
			let path = ["apps", appName, "version"]
			let known = lastEntry(data, address(path))
			let current = ""
			if !(known is none) {
				let value = data.stringOf(known.valueStart, known.valueEnd)
				current = value is none ?? ("", trimmed(value))
			}
			if current != "" {
				let parsed = semver.parse(current) onerror (err error) {
					fail "cannot bump `{current}` of {appName}: {err.message}"
				}
				(major, minor, patch) = (parsed.major, parsed.minor, parsed.patch)
				isPre = parsed.prerelease.len() > 0
			}
			match part {
				case VersionPart.Major:
					major += 1 unless isPre && minor == 0 && patch == 0
					(minor, patch) = (0, 0)
				case VersionPart.Minor:
					minor += 1 unless isPre && patch == 0
					patch = 0
				case VersionPart.Patch:
					patch += 1 unless isPre
			}
			let next = "{major}.{minor}.{patch}"
			let literal = quoted(next)
			if !(known is none) {
				edited(spliced(raw, known.valueStart, known.valueStop, literal))
			} else {
				let after = header
				let slug = lastEntry(data, address(["apps", appName, "slug"]))
				after = lineIndexOf(slug) unless (slug is none)
				edited(insertLines(data, after + 1, ["version = " + literal]))
			}
			return try semver.parse(next)
		}

		internal def lineIndexOf(line Line) int {
			for let (i, other) in data.lines {
				return i when other.start == line.start
			}
			return -1
		}
	}
}
