partial module std.adm.manifest {
	use (
		std.os
		std.testing
	)

	internal const sampleKey = "ed25519:base64:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
	internal const sampleSalt = "base64:c2FsdC1ieXRlcw=="

	internal const sample = `# adm.toml
#
# The header comment.

schema = 1

[publisher]
# The key.
pubkey = "ed25519:base64:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
repo_salt = "base64:c2FsdC1ieXRlcw=="
# name = "Your Company"

[update]
feed = "https://x/feed" # the feed
mystery = 3

[deps]
"iacob:utils" = "^1"
plain = "1.2"

# The main program.
[apps."My.App"]
slug = "main"
version = "1.2.3"  # keep me

[apps."My.App".update]
channel = "beta"

# The library.
[apps.Lib]
description = "A library"
`

	// The kinds of the problems of a text, with their places, as `line:column kind`.
	internal def problemList(m Manifest) string[] {
		let out string[]
		for let problem in m.problems() {
			out.push("{problem.line}:{problem.column} {problem.kind}")
		}
		return out
	}

	// The value of an optional, failing the test when there is none.
	internal def required<T>(value ?T) !T {
		fail "nothing there" when value is none
		return value
	}

	check "Manifest reading" {
		@test()
		def readsEveryTable() !none {
			let m = parse(`schema = 1
[publisher]
pubkey = "ed25519:base64:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
repo_salt = "base64:c2FsdC1ieXRlcw=="
name = "A \"quoted\" # name \\ back"
[update]
feed = "f"
channel = "c"
artifact = "a"
[package]
format = "tar.gz"
install_root = "user"
bin_link = "main"
[[package.files]]
from = "build/main"
to = "bin/main"
mode = "0755"
[[package.files]]
from = "assets/"
[deps]
"iacob:utils" = "^1"
adm.database.sqlite = " 1.2 "
[requires]
permissions = ["adm.net.*"]
[policy]
sandbox = true
build_read = ["~/a", "b"]
[plugins]
allow_unsigned = true
trusted = ["self", "admpub_x", "self"]
permissions = ["adm.storage.*"]
[registries]
order = ["acme", "public"]
[registries.acme]
url = "https://git/acme"
token = "${ACME}"
[apps."My.App"]
slug = "main"
version = "1.2.3"
description = "d"
[apps."My.App".update]
feed = "own"
[apps."My.App".package]
format = "tar.gz"
[[apps."My.App".package.files]]
from = "x"
to = "y"
[apps."My.App".compat]
os = ["linux"]
arch = ["amd64"]
adm = "0.1.1500"
`)
			assert m.problems().len() == 0
			assert m.schema() == 1
			assert m.publisher().pubkey == sampleKey
			assert m.publisher().name == `A "quoted" # name \ back`
			assert m.update().artifact == "a"
			assert m.package().installRoot == "user"
			assert m.package().files.len() == 2
			assert m.package().files[0].mode == "0755"
			assert m.deps().len() == 2
			let dep = try required(m.dep("iacob:utils"))
			assert dep.namespace == "iacob"
			assert dep.name == "utils"
			assert dep.range == "^1"
			let bare = try required(m.dep("adm.database.sqlite"))
			assert bare.namespace == ""
			assert bare.range == "1.2"
			let wanted = try required(m.requires())
			assert wanted[0] == "adm.net.*"
			assert m.sandbox()
			assert m.buildRead().join("|") == "~/a|b"
			assert m.plugins().constant() == "unsigned=1;trusted=admpub_x,self;permissions=adm.storage.*"
			assert m.registryOrder().join("|") == "acme|public"
			let registry = try required(m.registry("acme"))
			assert registry.token == "$\{ACME}"
			let app = try required(m.app("My.App"))
			assert app.version == "1.2.3"
			assert app.update.feed == "own"
			assert app.package.files[0].to == "y"
			assert app.compat.summary() == "linux · amd64 · adm ≥ 0.1.1500"
			assert !app.compat.isAll()
			assert (new Compat()).isAll()
			assert (new Compat()).summary() == "All"
			assert m.registries().len() == 1
			let packed = m.packageFor("My.App")
			assert packed.binLink == "main"
			assert packed.files.len() == 3
			assert packed.files[2].from == "x"
		}

		@test()
		def absentReadsEmpty() {
			let m = parse("")
			assert m.schema() == 1
			assert m.requires() is none
			assert m.apps().len() == 0
			assert m.app("x") is none
			assert m.text() == ""
			assert m.problems().len() == 0
		}

		@test()
		def anEmptyRequiresIsNotAnAbsentOne() !none {
			let m = parse("[requires]\npermissions = []\n")
			let wanted = try required(m.requires())
			assert wanted.len() == 0
		}

		@test()
		def anAppExistsOnlyWithAKey() {
			let m = parse("[apps.Empty]\n\n[apps.Full]\nslug = \"s\"\n")
			assert m.apps().len() == 1
			assert m.app("Empty") is none
		}

		@test()
		def readsAsTheToolchainDoes() !none {
			let m = parse(`[update]
channel = 'single'
feed = "a" "b"
[plugins]
permissions = [
  "adm.storage.*",
]
[apps.Plain]
version = """
1.0.0"""
`)
			// Text the toolchain's reader does not take stays out; a string of three quotes reads as
			// one quote.
			assert m.update().channel == ""
			assert m.update().feed == `a" "b`
			assert m.plugins().permissions.len() == 0
			let app = try required(m.app("Plain"))
			assert app.version == `"`
		}
	}

	check "Manifest identity" {
		@test()
		def derivesTheToolchainsIds() {
			// The expected ids come from internal/admapp over the same text.
			let m = parse("[publisher]\npubkey = \"{sampleKey}\"\nrepo_salt = \"{sampleSalt}\"\n[update]\nfeed = \" https://x/feed \"\n[apps.\"My.App\"]\nslug = \"  main  \"\nversion = \" 1.2.3 \"\n[apps.\"My.App\".update]\nfeed = \"https://own/feed\"\n[apps.Two]\nslug = \"s\"\n")
			let top = m.resolve()
			assert top.publisherId == "admpub_mmg42klgyqzwneiskrelxms3j72bfje4omw3fsflyg4fqg6xcdoq"
			assert top.appId == ""
			let own = m.resolve("My.App")
			assert own.appId == "admapp_5sqzzscg7egj2ga4ub6shq5mzidr3ibivooca6qs64uad2rwpiia"
			assert own.appName == "main"
			assert own.appVersion == "1.2.3"
			assert own.updateFeed == "https://own/feed"
			let unknown = m.resolve("NoSuchApp")
			assert unknown.appId == "admapp_lmmxykpu6v2rr4q56q3he5axnrk3joeahsv46wlqnh6vtciz7grq"
			assert unknown.appName == "NoSuchApp"
			assert unknown.updateFeed == "https://x/feed"
		}

		@test()
		def oneAppIsTheDefault() {
			let m = parse("[publisher]\npubkey = \"{sampleKey}\"\nrepo_salt = \"{sampleSalt}\"\n[apps.One]\nversion = \"1.0.0\"\n")
			assert m.resolve().appName == "One"
			assert m.resolve().appVersion == "1.0.0"
		}

		@test()
		def aWrongKeyOrSaltMeansNoIdentity() {
			let cases = [
				"pubkey = \"{sampleKey}\"",
				"pubkey = \"ed25519:base64:AAEC\"\nrepo_salt = \"{sampleSalt}\"",
				"pubkey = \"{sampleKey}\"\nrepo_salt = \"c2FsdA==\"",
				"pubkey = \"{sampleKey}\"\nrepo_salt = \"base64:c2Fsd=A=\"",
				"pubkey = \"{sampleKey}\"\nrepo_salt = \"base64:c2Fsdg\"",
			]
			for let text in cases {
				let m = parse("[publisher]\n" + text + "\n")
				assert m.resolve().publisherId == ""
			}
		}

		@test()
		def anEmptySaltGivesNoAppId() {
			let m = parse("[publisher]\npubkey = \"{sampleKey}\"\nrepo_salt = \"base64:\"\n[apps.One]\nversion = \"1.0.0\"\n")
			let out = m.resolve()
			assert out.publisherId != ""
			assert out.appId == ""
			assert out.appName == "One"
		}
	}

	check "Manifest problems" {
		@test()
		def aCleanFileHasNone() {
			assert parse(sample.replace("mystery = 3\n", "")).problems().len() == 0
		}

		@test()
		def namesEachKindAtItsPlace() {
			let m = parse(`schema = 1
what = 1
[update]
feed = 3
mystery = "x"
feed = "again"
[registries.acme]
token = "ghp_secret"
[nothing]
not a line
[apps.A]
version = "one"
[apps.A.compat]
os = ["linux", "beos"]
[deps]
bad = "%%"
[package]
format = "zip"
[[package.files]]
mode = "99"
[plugins]
allow_unsigned = "yes"
`)
			let list = problemList(m)
			assert list[0] == "2:1 UnknownKey"
			assert list[1] == "4:8 BadValue"
			assert list[2] == "5:1 UnknownKey"
			assert list[3] == "6:1 Duplicate"
			assert list[4] == "8:9 LiteralSecret"
			assert list[5] == "9:1 UnknownKey"
			assert list[6] == "10:1 Unreadable"
			assert list[7] == "12:11 BadValue"
			assert list[8] == "14:16 BadValue"
			assert list[9] == "16:7 BadValue"
			assert list[10] == "18:10 BadValue"
			assert list[11] == "20:8 BadValue"
			assert list[12] == "22:18 BadValue"
			assert list.len() == 13
		}

		@test()
		def spansAreBytesAndColumnsAreCharacters() {
			let m = parse("[publisher]\nname = \"é\" # é\nwhat = 1\n[update]\n  chánnel = \"é\"\n")
			let problems = m.problems()
			assert problems.len() == 2
			assert problems[0].path.join("|") == "publisher|what"
			assert problems[0].line == 3
			let second = problems[1]
			assert second.column == 3
			assert second.path.join("|") == "update|chánnel"
			assert string(m.text().bytes()[second.start:second.end]) == "chánnel"
		}

		@test()
		def aValueOverSeveralLinesIsOneProblem() {
			let m = parse("[plugins]\npermissions = [\n  \"a\",\n  \"b\",\n]\ntrusted = [\"self\"]\n")
			let list = problemList(m)
			assert list.len() == 1
			assert list[0] == "2:15 BadValue"
			assert m.problems()[0].end > m.problems()[0].start + 10
		}

		@test()
		def schemaIsTheOneThatRefuses() {
			assert problemList(parse("schema = x\n"))[0] == "1:10 Schema"
			assert problemList(parse("schema = 2\n"))[0] == "1:10 Schema"
			assert parse("schema = 2\n").schema() == 2
		}

		@test()
		def anEmptyOverrideIsNamed() {
			let m = parse("[update]\nfeed = \"\"\n[apps.A.update]\nfeed = \" \"\n[apps.A.package]\nformat = \"\"\n[apps.A]\nslug = \"\"\n")
			let list = problemList(m)
			assert list.len() == 2
			assert list[0] == "4:8 BadValue"
			assert list[1] == "6:10 BadValue"
			assert m.problems()[0].path.join("|") == "apps|A|update|feed"
		}

		@test()
		def schemaIsAKnownKey() {
			assert parse("schema = 1\n").problems().len() == 0
		}

		@test()
		def tokensAreNamesOfVariables() {
			for let good in ["$\{A}", "$\{A_B9}", "$\{_x}"] {
				assert parse("[registries.r]\ntoken = \"{good}\"\n").problems().len() == 0
			}
			for let bad in ["abc", "$A", "$\{}", "$\{9A}", "$\{A B}", "x$\{A}"] {
				let m = parse("[registries.r]\ntoken = \"{bad}\"\n")
				assert m.problems().len() == 1
				assert m.problems()[0].kind == ProblemKind.LiteralSecret
			}
		}
	}

	// The version an application with this one gets from `bumpVersion`, as the file then spells it.
	internal def bumped(version string, part VersionPart) !string {
		let m = parse("[apps.A]\nversion = \"{version}\"\n")
		try m.bumpVersion("A", part)
		let app = try required(m.app("A"))
		return app.version
	}

	check "Manifest edits" {
		@test()
		def parsingKeepsEveryByte() {
			assert parse(sample).text() == sample
			let odd = "ï»¿[x]\r\n\tkey   =   'y'   # c\r\n\n\n=\n"
			assert parse(odd).text() == odd
		}

		@test()
		def setReplacesOnlyTheValue() !none {
			let m = parse(sample)
			try m.set(["apps", "My.App", "version"], "2.0.0")
			assert m.text() == sample.replace("\"1.2.3\"  # keep me", "\"2.0.0\"  # keep me")
			let app = try required(m.app("My.App"))
			assert app.version == "2.0.0"
			try m.set(["update", "feed"], "https://y")
			assert m.text().contains("feed = \"https://y\" # the feed\nmystery = 3\n")
		}

		@test()
		def aNewKeyEndsItsTable() !none {
			let m = parse(sample)
			try m.set(["update", "channel"], "stable")
			assert m.text().contains("mystery = 3\nchannel = \"stable\"\n\n[deps]")
			// After what is in the table, and before the comment touching the next header.
			try m.set(["apps", "My.App", "update", "feed"], "f")
			assert m.text().contains("channel = \"beta\"\nfeed = \"f\"\n\n# The library.\n[apps.Lib]")
			// A commented-out line is the table's own.
			try m.set(["publisher", "name"], "Ada")
			assert m.text().contains("# name = \"Your Company\"\nname = \"Ada\"\n\n[update]")
		}

		@test()
		def aNewTableGoesWithItsFamily() !none {
			let m = parse(sample)
			try m.set(["apps", "My.App", "compat", "adm"], "0.1.0")
			assert m.text().contains("channel = \"beta\"\n\n[apps.\"My.App\".compat]\nadm = \"0.1.0\"\n\n# The library.")
			try m.set(["apps", "New", "slug"], "n")
			assert m.text().endsWith("description = \"A library\"\n\n[apps.New]\nslug = \"n\"\n")
			try m.set(["policy", "sandbox"], true)
			assert m.text().endsWith("slug = \"n\"\n\n[policy]\nsandbox = true\n")
		}

		@test()
		def everyKindOfValue() !none {
			let m = parse("")
			try m.set(["schema"], 1)
			try m.set(["plugins", "trusted"], ["self", "admpub_x"])
			try m.set(["plugins", "allow_unsigned"], true)
			assert m.text() == "schema = 1\n\n[plugins]\ntrusted = [\"self\", \"admpub_x\"]\nallow_unsigned = true\n"
			assert m.plugins().allowUnsigned
			assert m.plugins().trusted.len() == 2
			try m.set(["plugins", "allow_unsigned"], false)
			assert !m.plugins().allowUnsigned
			assert m.problems().len() == 0
		}

		@test()
		def stringsComeBackTheSame() !none {
			for let value in ["plain", `quo"te`, `back\slash`, `end\`, `\"`, `both \" \\ #`, "é ünï", "# not a comment"] {
				let m = parse("[publisher]\n")
				try m.set(["publisher", "name"], value)
				assert m.publisher().name == value
				assert m.problems().len() == 0
			}
		}

		@test()
		def aValueOverSeveralLinesBecomesOne() !none {
			let m = parse("[plugins]\npermissions = [\n  \"a\", # why\n  \"b\",\n] # kept\ntrusted = []\n")
			try m.set(["plugins", "permissions"], ["c"])
			assert m.text() == "[plugins]\npermissions = [\"c\"] # kept\ntrusted = []\n"
			assert m.plugins().permissions[0] == "c"
			assert m.problems().len() == 0
		}

		@test()
		def lineBreaksFollowTheFile() !none {
			let m = parse("schema = 1\r\n\r\n[update]\r\nfeed = \"f\"\r\n")
			try m.set(["update", "channel"], "c")
			try m.set(["apps", "A", "slug"], "a")
			assert m.text() == "schema = 1\r\n\r\n[update]\r\nfeed = \"f\"\r\nchannel = \"c\"\r\n\r\n[apps.A]\r\nslug = \"a\"\r\n"
			let open = parse("[update]\nfeed = \"f\"")
			try open.set(["update", "channel"], "c")
			assert open.text() == "[update]\nfeed = \"f\"\nchannel = \"c\"\n"
		}

		@test()
		def aKeyKeepsItsTablesIndent() !none {
			let m = parse("[update]\n  feed = \"f\"\n")
			try m.set(["update", "channel"], "c")
			assert m.text() == "[update]\n  feed = \"f\"\n  channel = \"c\"\n"
		}

		@test()
		def aWrittenTwiceKeyChangesTheOneRead() !none {
			let m = parse("[update]\nfeed = \"a\"\nfeed = \"b\"\n")
			try m.set(["update", "feed"], "c")
			assert m.text() == "[update]\nfeed = \"a\"\nfeed = \"c\"\n"
			assert m.update().feed == "c"
			assert m.remove(["update", "feed"])
			assert m.text() == "[update]\n"
			assert m.update().feed == ""
		}

		@test()
		def rowsByIndex() !none {
			let m = parse("[package]\nformat = \"tar.gz\"\n")
			try m.set(["package", "files", "0", "from"], "a")
			try m.set(["package", "files", "0", "mode"], "0755")
			try m.set(["package", "files", "1", "from"], "b")
			assert m.text() == "[package]\nformat = \"tar.gz\"\n\n[[package.files]]\nfrom = \"a\"\nmode = \"0755\"\n\n[[package.files]]\nfrom = \"b\"\n"
			assert m.package().files.len() == 2
			let far = m.set(["package", "files", "5", "from"], "x")
			assert far is error
			assert m.remove(["package", "files", "0"])
			assert m.text() == "[package]\nformat = \"tar.gz\"\n\n[[package.files]]\nfrom = \"b\"\n"
			try m.set(["apps", "A", "package", "files", "0", "to"], "t")
			assert m.app("A") is none || m.text().contains("[[apps.A.package.files]]\nto = \"t\"\n")
		}

		@test()
		def setRefusesWhatAdmWouldNotRead() {
			let m = parse(sample)
			let before = m.text()
			assert m.set(["what"], "x") is error
			assert m.set(["update", "what"], "x") is error
			assert m.set(["nothing", "what"], "x") is error
			assert m.set(["update", "feed"], ["list"]) is error
			assert m.set(["update", "feed"], true) is error
			assert m.set(["update", "feed"], "two\nlines") is error
			assert m.set(["plugins", "trusted"], "self") is error
			assert m.set(["plugins", "trusted"], ["a,b"]) is error
			assert m.set(["plugins", "trusted"], [""]) is error
			assert m.set(["registries", "r", "token"], "ghp_secret") is error
			assert m.set(["package", "format"], "zip") is error
			assert m.set(["package", "files", "0", "mode"], "99") is error
			assert m.set(["apps", "A", "version"], "one") is error
			assert m.set(["apps", "A", "compat", "os"], ["beos"]) is error
			assert m.set(["schema"], 2) is error
			assert m.set(string[], "x") is error
			assert m.text() == before
		}

		@test()
		def anAppNamedLikeATableIsAnApp() !none {
			let m = parse("")
			try m.set(["apps", "files", "update", "feed"], "f")
			try m.set(["apps", "package", "version"], "1.0.0")
			let files = try required(m.app("files"))
			assert files.update.feed == "f"
			assert m.problems().len() == 0
		}

		@test()
		def removeTakesOnlyItsLines() {
			let m = parse(sample)
			assert !m.remove(["update", "channel"])
			assert !m.remove(string[])
			assert m.text() == sample
			assert m.remove(["update", "mystery"])
			assert m.text() == sample.replace("mystery = 3\n", "")
			assert m.remove(["apps", "My.App", "update"])
			assert m.text().contains("# keep me\n\n# The library.\n[apps.Lib]")
		}

		@test()
		def removeTakesATableWithThoseBelowIt() {
			let m = parse(sample)
			assert m.remove(["apps", "My.App"])
			assert m.app("My.App") is none
			// The comment above stays, and so does the one touching the next header.
			assert m.text().contains("plain = \"1.2\"\n\n# The main program.\n\n# The library.\n[apps.Lib]")
			assert m.remove(["apps"])
			assert m.apps().len() == 0
			assert m.text().endsWith("# The library.\n")
		}

		@test()
		def removeTakesAValueOverSeveralLines() {
			let m = parse("[plugins]\npermissions = [\n  \"a\",\n]\ntrusted = []\n")
			assert m.remove(["plugins", "permissions"])
			assert m.text() == "[plugins]\ntrusted = []\n"
		}

		@test()
		def removingTheLastTableLeavesNoBlankEnd() {
			let m = parse("schema = 1\n\n[update]\nfeed = \"f\"\n")
			assert m.remove(["update"])
			assert m.text() == "schema = 1\n"
		}

		@test()
		def removeTakesWhatAdmDoesNotRead() {
			let m = parse("[update]\nwhat = 1\n\"feed\" = \"x\"\n[nothing]\nkey = 1\n")
			assert m.remove(["update", "what"])
			assert m.remove(["update", "feed"])
			assert m.remove(["nothing"])
			assert m.text() == "[update]\n"
			assert m.problems().len() == 0
		}

		@test()
		def removeIfEmptyTakesOnlyABareHeader() !none {
			let m = parse("schema = 1\n\n[update]\nfeed = \"f\"\n\n[requires]\n")
			try m.set(["requires", "permissions"], ["adm.net.*"])
			assert m.remove(["requires", "permissions"])
			assert m.text().endsWith("[requires]\n")
			assert m.removeIfEmpty(["requires"])
			assert m.text() == "schema = 1\n\n[update]\nfeed = \"f\"\n"
			assert !m.removeIfEmpty(["requires"])
			assert !m.removeIfEmpty(["update"])
			assert !m.removeIfEmpty(["update", "feed"])
			assert !m.removeIfEmpty(string[])
		}

		@test()
		def removeIfEmptyKeepsWhatATableHolds() {
			let kept = [
				"[apps.A]\n\n[apps.A.update]\nfeed = \"f\"\n",
				"[update]\n# why\n\n[policy]\n",
				"[update] # why\n",
				"[update]\nwhat = 1\n",
				"[update]\nnot a line\n",
				"[update]\n[update]\n",
			]
			for let text in kept {
				let m = parse(text)
				let path = text.startsWith("[apps") ?? (["apps", "A"], ["update"])
				assert !m.removeIfEmpty(path)
				assert m.text() == text
			}
		}

		@test()
		def removeIfEmptyLeavesTheCommentsAround() {
			let m = parse("# Before.\n[update]\n\n# The next.\n[policy]\nsandbox = true\n")
			assert m.removeIfEmpty(["update"])
			assert m.text() == "# Before.\n\n# The next.\n[policy]\nsandbox = true\n"
			let touching = parse("[update]\n# The next.\n[policy]\nsandbox = true\n")
			assert touching.removeIfEmpty(["update"])
			assert touching.text() == "# The next.\n[policy]\nsandbox = true\n"
			let row = parse("[[package.files]]\nfrom = \"a\"\n\n[[package.files]]\n")
			assert row.removeIfEmpty(["package", "files", "1"])
			assert !row.removeIfEmpty(["package", "files", "0"])
			assert !row.removeIfEmpty(["package", "files"])
			assert row.text() == "[[package.files]]\nfrom = \"a\"\n"
		}

		@test()
		def addDepFilesAKey() !none {
			let m = parse(sample)
			try m.addDep("admlang:adm.interop.js", "^2")
			assert m.text().contains("plain = \"1.2\"\n\"admlang:adm.interop.js\" = \"^2\"\n\n# The main program.")
			try m.addDep("bare", "latest")
			assert m.text().contains("\nbare = \"latest\"\n")
			try m.addDep("iacob:utils", "^3")
			assert m.text().contains("\"iacob:utils\" = \"^3\"\n")
			let dep = try required(m.dep("iacob:utils"))
			assert dep.range == "^3"
			let fresh = parse("schema = 1\n")
			try fresh.addDep("x", "1")
			assert fresh.text() == "schema = 1\n\n[deps]\nx = \"1\"\n"
			assert m.addDep("x", "%%") is error
			assert m.addDep("", "1") is error
			assert m.addDep("a=b", "1") is error
			assert m.addDep("a\"b", "1") is error
		}

		@test()
		def bumpMovesTheVersion() !none {
			let m = parse(sample)
			assert (try m.bumpVersion("My.App")).canonical() == "1.2.4"
			assert (try m.bumpVersion("My.App", VersionPart.Minor)).canonical() == "1.3.0"
			assert (try m.bumpVersion("My.App", VersionPart.Major)).canonical() == "2.0.0"
			assert m.text().contains("version = \"2.0.0\"  # keep me\n")
			let app = try required(m.app("My.App"))
			assert app.version == "2.0.0"
		}

		@test()
		def bumpStartsAVersion() !none {
			let m = parse("[apps.A]\n# about\nslug = \"a\"\ndescription = \"d\"\n[apps.B]\ndescription = \"d\"\n[apps.C]\ndescription = \"d\"\n[apps.D]\ndescription = \"d\"\n")
			assert (try m.bumpVersion("A", VersionPart.Minor)).canonical() == "0.1.0"
			assert (try m.bumpVersion("B", VersionPart.Patch)).canonical() == "0.0.1"
			assert (try m.bumpVersion("C", VersionPart.Major)).canonical() == "1.0.0"
			assert m.text().contains("slug = \"a\"\nversion = \"0.1.0\"\ndescription")
			assert m.text().contains("[apps.B]\nversion = \"0.0.1\"\ndescription")
		}

		@test()
		def bumpRefusesWhatIsNoVersion() {
			assert parse("[apps.A]\nversion = \"one\"\n").bumpVersion("A") is error
			assert parse("schema = 1\n").bumpVersion("Missing") is error
		}

		@test()
		def bumpGoesToTheNearestRelease() !none {
			assert (try bumped("1.2.3-rc.2", VersionPart.Patch)) == "1.2.3"
			assert (try bumped("1.2.3-rc.2", VersionPart.Minor)) == "1.3.0"
			assert (try bumped("1.2.3-rc.2", VersionPart.Major)) == "2.0.0"
			assert (try bumped("1.2.0-rc.1", VersionPart.Patch)) == "1.2.0"
			assert (try bumped("1.2.0-rc.1", VersionPart.Minor)) == "1.2.0"
			assert (try bumped("1.2.0-rc.1", VersionPart.Major)) == "2.0.0"
			assert (try bumped("2.0.0-rc.1", VersionPart.Patch)) == "2.0.0"
			assert (try bumped("2.0.0-rc.1", VersionPart.Minor)) == "2.0.0"
			assert (try bumped("2.0.0-rc.1", VersionPart.Major)) == "2.0.0"
			assert (try bumped("1.2.3-rc.2+linux.x86_64", VersionPart.Patch)) == "1.2.3"
			assert (try bumped("1.2.3+linux.x86_64", VersionPart.Patch)) == "1.2.4"
			assert (try bumped("1.2.3+linux.x86_64", VersionPart.Minor)) == "1.3.0"
			assert (try bumped("1.2.3+linux.x86_64", VersionPart.Major)) == "2.0.0"
			assert (try bumped("v1.2.3", VersionPart.Patch)) == "1.2.4"
			assert (try bumped("1.0", VersionPart.Patch)) == "1.0.1"
			assert (try bumped("1.0", VersionPart.Minor)) == "1.1.0"
			assert (try bumped("1.0", VersionPart.Major)) == "2.0.0"
			assert (try bumped("2", VersionPart.Patch)) == "2.0.1"
			assert (try bumped("1.2-rc.1", VersionPart.Patch)) == "1.2.0"
			assert (try bumped("1.2-rc.1", VersionPart.Minor)) == "1.2.0"
			assert (try bumped("1-rc.1", VersionPart.Major)) == "1.0.0"
		}

		@test()
		def aFullVersionIsAVersion() !none {
			for let version in ["1.2.3-rc.2+linux.x86_64", "1.2.3-rc.2+dev", "1.0", "2", "v1.2.3"] {
				assert parse("[apps.A]\nversion = \"{version}\"\n").problems().len() == 0
			}
			let m = parse("[apps.A]\nslug = \"a\"\n")
			try m.set(["apps", "A", "version"], "1.2.3-rc.2+linux.x86_64")
			assert m.problems().len() == 0
			for let bad in ["1.2.3-", "1.2.3+", "1.2.3-01", "1.x.3", "one"] {
				let wrong = parse("[apps.A]\nversion = \"{bad}\"\n")
				assert wrong.problems().len() == 1
				assert wrong.problems()[0].kind == ProblemKind.BadValue
				assert m.set(["apps", "A", "version"], bad) is error
			}
		}
	}

	check "Manifest available" {
		@test()
		def offersWhatIsNotThere() {
			let m = parse("schema = 1\n[deps]\nx = \"1\"\n[apps.A]\nslug = \"a\"\n[apps.A.update]\nfeed = \"f\"\n")
			let names = def (path string[]) string {
				let out string[]
				for let option in m.available(path) {
					out.push(option.name)
				}
				return out.join(" ")
			}
			assert names([]) == "publisher requires policy plugins update package registries apps"
			assert names(["deps"]) == "*"
			assert names(["apps"]) == "*"
			assert names(["apps", "A"]) == "version description package compat"
			assert names(["apps", "A", "update"]) == "channel artifact"
			assert names(["apps", "B"]) == "slug version description update package compat"
			assert names(["package"]) == "format install_root bin_link files"
			assert names(["package", "files", "0"]) == "from to mode"
			assert names(["registries"]) == "order *"
			assert names(["nothing"]) == ""
		}

		@test()
		def saysWhatEachTakes() {
			let m = parse("")
			let kinds = map<string, Option>{}
			for let option in m.available(["apps", "A", "compat"]) {
				kinds[option.name] = option
			}
			assert kinds["os"].kind == ValueKind.List
			assert "darwin" in kinds["os"].values
			assert kinds["adm"].kind == ValueKind.Version
			assert kinds["adm"].doc != ""
			for let option in m.available(["registries", "r"]) {
				assert option.kind == ValueKind.EnvVar when option.name == "token"
			}
			for let option in m.available() {
				assert option.doc != ""
			}
		}

		@test()
		def everyOfferCanBeSet() !none {
			let m = parse("")
			for let option in m.available(["publisher"]) {
				assert option.name in ["pubkey", "repo_salt", "name"]
			}
			try m.set(["publisher", "pubkey"], sampleKey)
			try m.set(["publisher", "repo_salt"], sampleSalt)
			assert m.available(["publisher"]).len() == 1
			assert m.problems().len() == 0
			assert m.resolve().publisherId != ""
		}
	}

	check "Manifest settings" {
		internal const layered = `[update]
feed = "https://project"
channel = " stable "
[package]
format = "tar.gz"
[[package.files]]
from = "shared"
[plugins]
allow_unsigned = true
trusted = ["self"]
[apps.Main]
slug = "m"
[apps.Main.update]
feed = "https://own"
channel = "  "
[apps.Main.package]
bin_link = "main"
[[apps.Main.package.files]]
from = "own"
[apps.Other.update]
feed = "https://other"
`

		internal def settingOf(m Manifest, path string[], key string) !Setting {
			for let setting in m.settings(path) {
				return setting when setting.key == key
			}
			fail "no setting {key}"
		}

		@test()
		def aUnitOverridesInheritsOrLeavesUnset() !none {
			let m = parse(layered)
			let unit = ["apps", "Main", "update"]
			let own = try settingOf(m, unit, "feed")
			assert own.source == ValueSource.Here
			assert own.value == "https://own"
			assert own.path.join("|") == "apps|Main|update|feed"
			// An empty value of its own gives way to the project's, trimmed as `resolve` reads it.
			let blank = try settingOf(m, unit, "channel")
			assert blank.source == ValueSource.Inherited
			assert blank.value == "stable"
			assert blank.path.join("|") == "apps|Main|update|channel"
			let missing = try settingOf(m, unit, "artifact")
			assert missing.source == ValueSource.Unset
			assert missing.value == ""
		}

		@test()
		def settingsAgreeWithResolveAndPackageFor() !none {
			let m = parse("[publisher]\npubkey = \"{sampleKey}\"\nrepo_salt = \"{sampleSalt}\"\n" + layered)
			let resolved = m.resolve("Main")
			let packed = m.packageFor("Main")
			let update = ["apps", "Main", "update"]
			let package = ["apps", "Main", "package"]
			assert (try settingOf(m, update, "feed")).value == resolved.updateFeed
			assert (try settingOf(m, update, "channel")).value == resolved.updateChannel
			assert (try settingOf(m, update, "artifact")).value == resolved.updateArtifact
			assert (try settingOf(m, package, "format")).value == packed.format
			assert (try settingOf(m, package, "format")).source == ValueSource.Inherited
			assert (try settingOf(m, package, "bin_link")).value == packed.binLink
			assert (try settingOf(m, package, "bin_link")).source == ValueSource.Here
			assert (try settingOf(m, package, "install_root")).source == ValueSource.Unset
		}

		@test()
		def aUnitWithoutATableInheritsAll() !none {
			let m = parse(layered)
			let unit = ["apps", "New", "update"]
			let feed = try settingOf(m, unit, "feed")
			assert feed.source == ValueSource.Inherited
			assert feed.value == "https://project"
			assert (try settingOf(m, ["apps", "New"], "slug")).source == ValueSource.Unset
			// Typing overrides, and removing the override inherits again.
			try m.set(feed.path, "https://new")
			assert m.text().contains("[apps.New.update]\nfeed = \"https://new\"\n")
			assert (try settingOf(m, unit, "feed")).source == ValueSource.Here
			assert m.remove(feed.path)
			assert (try settingOf(m, unit, "feed")).source == ValueSource.Inherited
		}

		@test()
		def everyKindOfKey() !none {
			let m = parse(layered)
			let flag = try settingOf(m, ["plugins"], "allow_unsigned")
			assert flag.value == "true"
			assert flag.source == ValueSource.Here
			let list = try settingOf(m, ["plugins"], "trusted")
			assert list.items.join("|") == "self"
			assert list.source == ValueSource.Here
			assert (try settingOf(m, ["plugins"], "permissions")).source == ValueSource.Unset
			assert (try settingOf(m, [], "schema")).source == ValueSource.Unset
			assert m.settings(["nothing"]).len() == 0
			assert m.settings(["deps"]).len() == 0
			// Project-level keys do not inherit from anywhere.
			assert (try settingOf(m, ["update"], "artifact")).source == ValueSource.Unset
		}

		@test()
		def namesTheUnitsOverridingAKey() {
			let m = parse(layered)
			assert m.overriddenBy(["update", "feed"]).join("|") == "Main|Other"
			assert m.overriddenBy(["update", "channel"]).len() == 0
			assert m.overriddenBy(["package", "bin_link"]).join("|") == "Main"
			assert m.overriddenBy(["publisher", "name"]).len() == 0
		}

		@test()
		def filesAddToTheProjects() !none {
			let m = parse(layered)
			let rows = m.files("Main")
			assert rows.len() == 2
			assert rows[0].rule.from == "shared"
			assert rows[0].source == ValueSource.Inherited
			assert rows[0].path.join("|") == "package|files|0"
			assert rows[1].rule.from == "own"
			assert rows[1].source == ValueSource.Here
			assert rows[1].path.join("|") == "apps|Main|package|files|0"
			let project = m.files()
			assert project.len() == 1
			assert project[0].source == ValueSource.Here
			assert m.files("New").len() == 1
			try m.set(rows[1].path.concat(["to"]), "t")
			assert m.files("Main")[1].rule.to == "t"
			assert m.remove(rows[1].path)
			assert m.files("Main").len() == 1
		}
	}

	check "Manifest lines" {
		@test()
		def namesWhereThingsAreWritten() !none {
			let m = parse("schema = 1\n\n# Libraries.\n[deps]\na = \"1\"\n\"n:b\" = \"2\"\na = \"3\"\n\n[[package.files]]\nfrom = \"x\"\n")
			assert (try required(m.dep("n:b"))).line == 6
			assert (try required(m.dep("a"))).line == 7
			assert (try required(m.lineOf(["deps"]))) == 4
			assert (try required(m.lineOf(["deps", "n:b"]))) == 6
			assert (try required(m.lineOf(["schema"]))) == 1
			assert (try required(m.lineOf(["package", "files", "0"]))) == 9
			assert (try required(m.lineOf(["package", "files", "0", "from"]))) == 10
			assert m.lineOf(["update"]) is none
			assert m.lineOf(string[]) is none
			try m.addDep("c", "1")
			assert (try required(m.dep("c"))).line == 8
		}
	}

	check "Manifest files" {
		internal def scratchFolder(name string) !string {
			let folder = os.join(os.tempDir(), "adm-manifest-test-" + name)
			try os.mkdir(os.join(folder, "a", "b"), true)
			return folder
		}

		@test()
		def findWalksUp() !none {
			let folder = try scratchFolder("find")
			let legacy = os.join(folder, legacyFileName)
			try os.writeFile(legacy, "schema = 1\n".bytes())
			let inner = os.join(folder, "a", "b")
			assert (try required(find(inner))) == legacy
			let near = os.join(folder, "a", fileName)
			try os.writeFile(near, "schema = 1\n".bytes())
			assert (try required(find(inner))) == near
			assert (try required(find(near))) == near
			let beside = os.join(folder, fileName)
			try os.writeFile(beside, "schema = 1\n".bytes())
			assert (try required(find(folder))) == beside
			assert find("") is none
			assert find("   ") is none
			try os.remove(legacy)
			try os.remove(near)
			try os.remove(beside)
		}

		@test()
		def loadsAndSaves() !none {
			let folder = try scratchFolder("save")
			let path = os.join(folder, fileName)
			try os.writeFile(path, sample.bytes())
			let m = try load(path)
			assert m.text() == sample
			try m.set(["update", "feed"], "g")
			try m.save(path)
			assert string(try os.readFile(path)) == m.text()
			assert !(try os.exists(path + ".tmp"))
			try os.remove(path)
			assert load(os.join(folder, "missing.toml")) is error
		}
	}
}
