// Reads `adm.toml` line by line as `adm` does, so that what this module reports is what a build
// sees, and records where each thing is written, so that edits touch only its bytes.
internal partial module std.adm.manifest.reading {
	use (
		std.adm.manifest::*
		std.adm.manifest.schema::*
		std.adm.manifest.text::*
		std.data.encoding::(Base64)
		std.data.semver
	)

	// Stands between the parts of a line's address; no name holds it.
	const separator = "\u001F"

	// What a line of the file is.
	enum LineKind {
		Blank,
		Comment,
		// `[table]` or `[[table]]`.
		Header,
		// `key = value`.
		Entry,
		// Text that is neither, which `adm` passes over.
		Unread
	}

	// A line of the file: where it is and what is on it.
	struct Line {
		start      int
		// Where its text ends, before the line break.
		end        int
		// Where the next line starts.
		next       int
		kind       LineKind = LineKind.Blank
		textStart  int      = 0
		textEnd    int      = 0
		keyStart   int      = 0
		keyEnd     int      = 0
		valueStart int      = 0
		valueEnd   int      = 0
		// Where the value stops when it runs on over the next lines; else `valueEnd`.
		valueStop  int      = 0
		// The path of the table or key, its parts joined by `separator`; a row's index is one
		// of them.
		address    string   = ""
		// A key adm reads, as it is spelled here.
		known      bool     = false
		// A `[[table]]`.
		rows       bool     = false
		// Inside a value that started on an earlier line.
		continued  bool     = false
	}

	// The address of a path.
	def address(path string[]) string {
		return path.join(separator)
	}

	// The text of a string as `adm` writes it in a value: quoted, with its quotes and
	// backslashes escaped.
	def quoted(text string) string {
		return "\"" + text.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
	}

	// Whether a name can stand in a table's path or as a key without quotes.
	def isBare(name string) bool {
		return false when name.len() == 0
		for let c in name.bytes() {
			let isWord = c == byte('_') || c == byte('-') || (c >= byte('0') && c <= byte('9')) || (c >= byte('a') && c <= byte('z')) || (c >= byte('A') && c <= byte('Z'))
			return false unless isWord
		}
		return true
	}

	// A part of a path as it is written, quoted when it has to be.
	def written(name string) string {
		return isBare(name) ?? (name, quoted(name))
	}

	// A table's path as a header spells it.
	def headerText(path string[]) string {
		let parts string[]
		for let part in path {
			parts.push(written(part))
		}
		return parts.join(".")
	}

	// Decodes standard Base64 as strictly as the toolchain does: whole groups of four, `=` only
	// at the end. Fails on anything else.
	def strictBase64(text string) !byte[] {
		let src = text.replace("\r", "").bytes()
		let n = src.len()
		fail "the length of Base64 text is a multiple of 4" when n % 4 != 0
		let pad = byte('=')
		for let i = 0; i < n - 2; i++ {
			fail "Base64 has `=` only at its end" when src[i] == pad
		}
		fail "Base64 has `=` only at its end" when n >= 2 && src[n - 2] == pad && src[n - 1] != pad
		return try (new Base64()).decode(string(src))
	}

	// The bytes of a `pubkey` value. Fails unless it is `ed25519:base64:` and 32 bytes of Base64.
	def publicKeyBytes(value string) !byte[] {
		let text = trimmed(value)
		fail "a public key is missing" when text == ""
		let prefix = "ed25519:base64:"
		fail "a public key starts with `{prefix}`" unless text.startsWith(prefix)
		let key = try strictBase64(text.trimPrefix(prefix))
		fail "an Ed25519 public key is 32 bytes, this one {key.len()}" when key.len() != 32
		return key
	}

	// The bytes of a `repo_salt` value. Fails unless it is `base64:` and Base64.
	def saltBytes(value string) !byte[] {
		let text = trimmed(value)
		fail "a salt is missing" when text == ""
		let prefix = "base64:"
		fail "a salt starts with `{prefix}`" unless text.startsWith(prefix)
		return try strictBase64(text.trimPrefix(prefix))
	}

	// What is wrong with a string value for a key, "" when nothing is.
	def textFlaw(field FieldSpec, value string) string {
		let text = trimmed(value)
		return "" when text == ""
		match field.kind {
			case ValueKind.Version:
				let parsed = semver.parse(text)
				return "`{text}` is not a version such as 1.2.0" when parsed is error
			case ValueKind.Range:
				return "`{text}` is not a version range such as ^1.2" unless text == "latest" || semver.isRange(text)
			case ValueKind.EnvVar:
				return "a token is never written here: name its environment variable, `$\{NAME}`" unless isEnvVar(text)
			case ValueKind.PublicKey:
				let key = publicKeyBytes(text)
				return "no identity without this key: {key.message}" when key is error
			case ValueKind.Salt:
				let salt = saltBytes(text)
				return "no identity without this salt: {salt.message}" when salt is error
			case ValueKind.Mode:
				return "`{text}` is not a mode in octal such as 0755" unless isOctal(text)
			default:
		}
		return "`{text}` is not one of {field.values.join(", ")}" when field.values.len() > 0 && !(text in field.values)
		return ""
	}

	// Whether the text is `${NAME}`, with a name an environment variable can have.
	def isEnvVar(text string) bool {
		let raw = text.bytes()
		let n = raw.len()
		return false when n < 4 || raw[0] != byte('$') || raw[1] != byte('{') || raw[n - 1] != byte('}')
		for let i = 2; i < n - 1; i++ {
			let c = raw[i]
			let isLetter = c == byte('_') || (c >= byte('a') && c <= byte('z')) || (c >= byte('A') && c <= byte('Z'))
			let isDigit = c >= byte('0') && c <= byte('9')
			return false unless isLetter || (isDigit && i > 2)
		}
		return true
	}

	// Whether the text is octal digits.
	def isOctal(text string) bool {
		for let c in text.bytes() {
			return false when c < byte('0') || c > byte('7')
		}
		return true
	}

	// The integer a whole text spells, an optional sign and decimal digits, or none.
	def integerOf(text string) ?int {
		let raw = text.bytes()
		let from = raw.len() > 0 && (raw[0] == byte('+') || raw[0] == byte('-')) ?? (1, 0)
		return none when from == raw.len() || raw.len() - from > 18
		let value = 0
		for let i = from; i < raw.len(); i++ {
			let c = raw[i]
			return none when c < byte('0') || c > byte('9')
			value = value * 10 + int(c - byte('0'))
		}
		return raw[0] == byte('-') ?? (-value, value)
	}

	// One read of the file: its lines, what they say and what is wrong with them.
	type Reading {
		raw             byte[]
		lines           Line[]
		problems        Problem[]
		schema          int               = 0
		publisher       Publisher
		update          Update
		packaging       Package
		deps            Dep[]
		requires        ?string[]         = none
		sandbox         bool              = false
		buildRead       string[]
		plugins         Plugins
		apps            App[]
		registries      Registry[]
		registryOrder   string[]
		// How many rows each array of tables has, by the array's address.
		rowCounts       map<string, int>
		internal seen   map<string, bool>
		internal appAt  map<string, int>
		internal depAt  map<string, int>
		internal regAt  map<string, int>
		internal quiet  bool              = false
		internal stopAt int               = 0

		def new(raw byte[]) {
			self.raw = raw
			publisher = Publisher{}
			update = Update{}
			packaging = Package{files: FileRule[]}
			plugins = Plugins{trusted: string[], permissions: string[]}
			rowCounts = map<string, int>{}
			seen = map<string, bool>{}
			appAt = map<string, int>{}
			depAt = map<string, int>{}
			regAt = map<string, int>{}
			readLines()
		}

		internal def readLines() {
			let table string[]
			let inArray = false
			let row ?FileRule = none
			let spec = tableSpec("")
			let owner = ""
			let schemaLine ?Line = none
			let n = raw.len()
			let pos = 0
			for pos < n {
				let end = pos
				for end < n && raw[end] != byte('\n') {
					end++
				}
				let line = Line{start: pos, end: end, next: end < n ?? (end + 1, n)}
				lines.push(line)
				pos = line.next
				quiet = line.start < stopAt
				line.continued = quiet

				let cut = commentAt(line.start, end)
				let (ts, te) = trimSpan(raw, line.start, cut)
				line.textStart = ts
				line.textEnd = te
				if ts == te {
					line.kind = cut < end ?? (LineKind.Comment, LineKind.Blank)
					continue
				}

				let opensTwo = te - ts >= 2 && raw[ts] == byte('[') && raw[ts + 1] == byte('[')
				let closesTwo = te - ts >= 2 && raw[te - 1] == byte(']') && raw[te - 2] == byte(']')
				if (opensTwo && closesTwo) || (raw[ts] == byte('[') && raw[te - 1] == byte(']')) {
					inArray = opensTwo
					row = none
					let path = headerPath(ts, te, opensTwo)
					line.kind = LineKind.Header
					line.rows = inArray
					if inArray {
						table = string[]
						let base = address(path)
						let count = rowCounts.hasKey(base) ?? (rowCounts[base], 0)
						rowCounts[base] = count + 1
						owner = base + separator + "{count}"
						line.address = owner
						row = addRow(path)
					} else {
						table = path
						owner = address(path)
						line.address = owner
					}
					spec = tableSpec(patternOf(path))
					checkHeader(line, path, spec, inArray)
					continue
				}

				let eq = indexOfEquals(ts, te)
				let (ks, ke) = trimSpan(raw, ts, eq < 0 ?? (ts, eq))
				if eq < 0 || ks == ke {
					line.kind = LineKind.Unread
					flaw(ProblemKind.Unreadable, "adm reads no `key = value` here, so it passes over this line", ts, te)
					continue
				}
				let (vs, ve) = trimSpan(raw, eq + 1, te)
				let key = textOf(raw, ks, ke)
				line.kind = LineKind.Entry
				line.keyStart = ks
				line.keyEnd = ke
				line.valueStart = vs
				line.valueEnd = ve
				line.valueStop = ve
				let name = raw[ks] == byte('"') || raw[ke - 1] == byte('"') ?? (key.trim("\""), key)
				line.address = owner == "" ?? (name, owner + separator + name)

				let bad = checkEntry(line, spec, key, name, inArray)
				schemaLine = line when key == "schema" && table.len() == 0 && !(inArray && !(row is none))

				if inArray && !(row is none) {
					assignRow(row, key, vs, ve)
				} else {
					assign(table, key, name, vs, ve, bad)
				}
			}
			schema = 1 when schema == 0
			if schema != 1 {
				let at = schemaLine
				if !(at is none) {
					quiet = false
					flawAt(at, ProblemKind.Schema, "this adm reads schema 1, not {schema}", at.valueStart, at.valueEnd)
				}
			}
		}

		// Where the comment on a line starts, its end when it has none. A `#` starts one outside
		// a string, and a backslash anywhere keeps the next character from counting.
		internal def commentAt(from int, to int) int {
			let inString = false
			let escaped = false
			for let i = from; i < to; i++ {
				let c = raw[i]
				if escaped {
					escaped = false
				} else if c == byte('\\') {
					escaped = true
				} else if c == byte('"') {
					inString = !inString
				} else if c == byte('#') && !inString {
					return i
				}
			}
			return to
		}

		internal def indexOfEquals(from int, to int) int {
			for let i = from; i < to; i++ {
				return i when raw[i] == byte('=')
			}
			return -1
		}

		// The path a header names. A segment is whatever stands between dots outside quotes,
		// the quotes dropped; an empty one does not count.
		internal def headerPath(ts int, te int, opensTwo bool) string[] {
			let width = opensTwo ?? (2, 1)
			let from = ts + width
			let to = te
			to -= width when to - from >= width && raw[to - 1] == byte(']') && (width == 1 || raw[to - 2] == byte(']'))
			let (start, stop) = trimSpan(raw, from, to)
			let parts string[]
			let plain = true
			for let i = start; i < stop; i++ {
				if raw[i] == byte('"') || raw[i] == byte('\\') {
					plain = false
					break
				}
			}
			if plain {
				let segment = start
				for let i = start; i <= stop; i++ {
					continue unless i == stop || raw[i] == byte('.')
					let (a, b) = trimSpan(raw, segment, i)
					parts.push(textOf(raw, a, b)) when a < b
					segment = i + 1
				}
				return parts
			}
			let current byte[]
			let inString = false
			let escaped = false
			for let i = start; i < stop; i++ {
				let c = raw[i]
				if escaped {
					current.push(c)
					escaped = false
				} else if c == byte('\\') && inString {
					escaped = true
				} else if c == byte('"') {
					inString = !inString
				} else if c == byte('.') && !inString {
					addPart(parts, current)
					current = byte[]
				} else {
					current.push(c)
				}
			}
			addPart(parts, current)
			parts[1] = parts[1].trim("\"") when parts.len() >= 2 && parts[0] == "apps"
			return parts
		}

		internal def addPart(parts string[], current byte[]) {
			let (a, b) = trimSpan(current, 0, current.len())
			parts.push(textOf(current, a, b)) when a < b
		}

		internal def addRow(path string[]) ?FileRule {
			let isOwn = path.len() == 2 && path[0] == "package" && path[1] == "files"
			let isApps = path.len() == 4 && path[0] == "apps" && path[2] == "package" && path[3] == "files"
			return none unless isOwn || isApps
			let rule = FileRule{}
			if isOwn {
				packaging.files.push(rule)
			} else {
				ensureApp(path[1]).package.files.push(rule)
			}
			return rule
		}

		internal def ensureApp(name string) App {
			return apps[appAt[name]] when appAt.hasKey(name)
			let app = App{name: name, update: Update{}, package: Package{files: FileRule[]}, compat: new Compat()}
			appAt[name] = apps.len()
			apps.push(app)
			return app
		}

		// The app of that name, or none.
		def appNamed(name string) ?App {
			return none unless appAt.hasKey(name)
			return apps[appAt[name]]
		}

		// The library under that key of `[deps]`, or none.
		def depNamed(key string) ?Dep {
			return none unless depAt.hasKey(key)
			return deps[depAt[key]]
		}

		// The registry of that name, or none.
		def registryNamed(name string) ?Registry {
			return none unless regAt.hasKey(name)
			return registries[regAt[name]]
		}

		internal def ensureRegistry(name string) Registry {
			return registries[regAt[name]] when regAt.hasKey(name)
			let registry = Registry{name: name}
			regAt[name] = registries.len()
			registries.push(registry)
			return registry
		}

		// The string a value spells, whole between double quotes with `\"` and `\\` read, or
		// none when it is anything else.
		def stringOf(vs int, ve int) ?string {
			return none when ve - vs < 2 || raw[vs] != byte('"') || raw[ve - 1] != byte('"')
			let inner = textOf(raw, vs + 1, ve - 1)
			for let i = vs + 1; i < ve - 1; i++ {
				return inner.replace("\\\"", "\"").replace("\\\\", "\\") when raw[i] == byte('\\')
			}
			return inner
		}

		// The strings of a `["a", "b"]` on one line, an item that is no string left out; none
		// when the value is no such list.
		internal def listOf(vs int, ve int) ?string[] {
			return none when ve - vs < 2 || raw[vs] != byte('[') || raw[ve - 1] != byte(']')
			let out string[]
			let start = vs + 1
			for let i = vs + 1; i < ve; i++ {
				continue unless i == ve - 1 || raw[i] == byte(',')
				let (a, b) = trimSpan(raw, start, i)
				let item = stringOf(a, b)
				out.push(item) when !(item is none) && item != ""
				start = i + 1
			}
			return out
		}

		def listOrEmpty(vs int, ve int) string[] {
			let list = listOf(vs, ve)
			return list is none ?? (string[], list)
		}

		// What a key of a row of `package.files` says.
		internal def assignRow(row FileRule, key string, vs int, ve int) {
			let value = stringOf(vs, ve)
			return when value is none
			match key {
				case "from":
					row.from = value
				case "to":
					row.to = value
				case "mode":
					row.mode = value
				default:
			}
		}

		internal def assignUpdate(target Update, key string, value string) {
			match key {
				case "feed":
					target.feed = value
				case "channel":
					target.channel = value
				case "artifact":
					target.artifact = value
				default:
			}
		}

		internal def assignPackage(target Package, key string, value string) {
			match key {
				case "format":
					target.format = value
				case "install_root":
					target.installRoot = value
				case "bin_link":
					target.binLink = value
				default:
			}
		}

		// What a key of a table says. `bad` tells a `schema` that is no integer, which is not
		// taken.
		internal def assign(table string[], key string, name string, vs int, ve int, bad bool) {
			let size = table.len()
			if size == 0 {
				if key == "schema" && !bad {
					let number = integerOf(textOf(raw, vs, ve))
					schema = number when !(number is none)
				}
				return
			}
			let head = table[0]
			let value = stringOf(vs, ve)
			if size == 1 {
				match head {
					case "publisher":
						return when value is none
						match key {
							case "pubkey":
								publisher.pubkey = value
							case "repo_salt":
								publisher.repoSalt = value
							case "name":
								publisher.name = value
							default:
						}
					case "registries":
						registryOrder = listOrEmpty(vs, ve) when key == "order"
					case "deps":
						return when value is none
						assignDep(name, trimmed(value))
					case "policy":
						match key {
							case "sandbox":
								sandbox = textOf(raw, vs, ve) == "true"
							case "build_read":
								buildRead = listOrEmpty(vs, ve)
							default:
						}
					case "plugins":
						match key {
							case "allow_unsigned":
								plugins.allowUnsigned = textOf(raw, vs, ve) == "true"
							case "trusted":
								plugins.trusted = listOrEmpty(vs, ve)
							case "permissions":
								plugins.permissions = listOrEmpty(vs, ve)
							default:
						}
					case "requires":
						requires = listOrEmpty(vs, ve) when key == "permissions"
					case "update":
						return when value is none
						assignUpdate(update, key, value)
					case "package":
						return when value is none
						assignPackage(packaging, key, value)
					default:
				}
				return
			}
			if size == 2 && head == "registries" {
				let registry = ensureRegistry(table[1])
				return when value is none
				match key {
					case "url":
						registry.url = value
					case "token":
						registry.token = value
					default:
				}
				return
			}
			return unless head == "apps"
			if size == 2 {
				let app = ensureApp(table[1])
				return when value is none
				match key {
					case "slug":
						app.slug = value
					case "version":
						app.version = value
					case "description":
						app.description = value
					default:
				}
			} else if size == 3 {
				match table[2] {
					case "compat":
						let app = ensureApp(table[1])
						match key {
							case "os":
								app.compat.os = listOrEmpty(vs, ve)
							case "arch":
								app.compat.arch = listOrEmpty(vs, ve)
							case "adm":
								app.compat.adm = value when !(value is none)
							default:
						}
					case "update":
						let app = ensureApp(table[1])
						return when value is none
						assignUpdate(app.update, key, value)
					case "package":
						let app = ensureApp(table[1])
						return when value is none
						assignPackage(app.package, key, value)
					default:
				}
			}
		}

		internal def assignDep(key string, range string) {
			if depAt.hasKey(key) {
				deps[depAt[key]].range = range
				deps[depAt[key]].line = lines.len()
				return
			}
			let colon = key.indexOf(":")
			depAt[key] = deps.len()
			deps.push(Dep{key: key, namespace: colon < 0 ?? ("", key.slice(0, colon)), name: colon < 0 ?? (key, key.slice(colon + 1)), range: range, line: lines.len()})
		}

		// Reports a header adm does not read, or one written twice.
		internal def checkHeader(line Line, path string[], spec ?TableSpec, inArray bool) {
			let readable = !(spec is none) && spec.rows == inArray
			if !readable {
				let spelled = inArray ?? ("[[" + headerText(path) + "]]", "[" + headerText(path) + "]")
				flaw(ProblemKind.UnknownKey, "adm reads no table {spelled}", line.textStart, line.textEnd)
				return
			}
			return when inArray
			flaw(ProblemKind.Duplicate, "this table is opened twice; adm reads both", line.textStart, line.textEnd) when seen.hasKey(line.address)
			seen[line.address] = true
		}

		// Reports what is wrong with a key and its value, and whether a `schema` is unreadable.
		internal def checkEntry(line Line, spec ?TableSpec, key string, name string, inArray bool) bool {
			let (vs, ve) = (line.valueStart, line.valueEnd)
			let stop = multiLineStop(vs, ve)
			line.valueStop = stop
			let wasQuiet = quiet
			stopAt = stop when stop > ve

			return false when spec is none || spec.rows != inArray
			let field = fieldSpec(spec, key)
			if field is none {
				flaw(ProblemKind.UnknownKey, "adm reads no key `{key}` here", line.keyStart, line.keyEnd)
				return false
			}
			line.known = !wasQuiet
			flaw(ProblemKind.Duplicate, "`{name}` is written twice; adm takes the last", line.keyStart, line.keyEnd) when seen.hasKey(line.address)
			seen[line.address] = true

			if stop > ve {
				flaw(ProblemKind.BadValue, "adm reads a value on one line only, and takes nothing from this one", vs, stop)
				return false
			}
			match field.kind {
				case ValueKind.Number:
					let number = integerOf(textOf(raw, vs, ve))
					if number is none {
						flaw(ProblemKind.Schema, "the schema is a whole number", vs, ve)
						return true
					}
				case ValueKind.Flag:
					let text = textOf(raw, vs, ve)
					flaw(ProblemKind.BadValue, "this is `true` or `false`; adm reads `{text}` as false", vs, ve) when text != "true" && text != "false"
				case ValueKind.List:
					checkList(field, vs, ve)
				default:
					let value = stringOf(vs, ve)
					if value is none {
						flaw(ProblemKind.BadValue, "adm reads only a double-quoted string here", vs, ve)
					} else {
						if isUnitOverride(line.address) && trimmed(value) == "" {
							flaw(ProblemKind.BadValue, "an empty value here takes the project's: remove the key to inherit", vs, ve)
							return false
						}
						let wrong = textFlaw(field, value)
						flaw(wrongKind(field), wrong, vs, ve) when wrong != ""
					}
			}
			return false
		}

		// Whether a key's address is in a unit's `update` or `package` table, whose keys inherit.
		internal def isUnitOverride(at string) bool {
			let parts = at.split(separator)
			return parts.len() == 4 && parts[0] == "apps" && (parts[2] == "update" || parts[2] == "package")
		}

		internal def wrongKind(field FieldSpec) ProblemKind {
			return field.kind == ValueKind.EnvVar ?? (ProblemKind.LiteralSecret, ProblemKind.BadValue)
		}

		internal def checkList(field FieldSpec, vs int, ve int) {
			if ve - vs < 2 || raw[vs] != byte('[') || raw[ve - 1] != byte(']') {
				flaw(ProblemKind.BadValue, "adm reads only a list of strings here, `[\"a\", \"b\"]`", vs, ve)
				return
			}
			let start = vs + 1
			for let i = vs + 1; i < ve; i++ {
				continue unless i == ve - 1 || raw[i] == byte(',')
				let (a, b) = trimSpan(raw, start, i)
				start = i + 1
				continue when a == b
				let item = stringOf(a, b)
				if item is none || item == "" {
					flaw(ProblemKind.BadValue, "adm reads only non-empty strings without a comma in a list, and skips this", a, b)
				} else if field.values.len() > 0 && !(item in field.values) {
					flaw(ProblemKind.BadValue, "`{item}` is not one of {field.values.join(", ")}", a, b)
				}
			}
		}

		// Where a value that goes on past its line stops, by TOML's rules for lists and strings
		// of three quotes; `ve` when it ends on its line, or never ends.
		internal def multiLineStop(vs int, ve int) int {
			return ve when vs >= ve
			let n = raw.len()
			let c = raw[vs]
			if (c == byte('"') || c == byte('\'')) && vs + 2 < n && raw[vs + 1] == c && raw[vs + 2] == c {
				for let i = vs + 3; i + 2 < n; i++ {
					return i + 3 <= ve ?? (ve, i + 3) when raw[i] == c && raw[i + 1] == c && raw[i + 2] == c
				}
				return ve
			}
			return ve unless c == byte('[')
			let depth = 0
			let i = vs
			for i < n {
				let d = raw[i]
				if d == byte('"') || d == byte('\'') {
					i++
					for i < n && raw[i] != d && raw[i] != byte('\n') {
						i++ when d == byte('"') && raw[i] == byte('\\')
						i++
					}
				} else if d == byte('#') {
					for i < n && raw[i] != byte('\n') {
						i++
					}
					continue
				} else if d == byte('[') {
					depth++
				} else if d == byte(']') {
					depth--
					return i + 1 <= ve ?? (ve, i + 1) when depth == 0
				}
				i++
			}
			return ve
		}

		// Records a problem on the line being read, unless it is inside a value already reported.
		internal def flaw(kind ProblemKind, message string, start int, end int) {
			return when quiet
			flawAt(lines[lines.len() - 1], kind, message, start, end)
		}

		internal def flawAt(line Line, kind ProblemKind, message string, start int, end int) {
			let number = 1
			for let i = lines.len() - 1; i >= 0; i-- {
				if lines[i].start == line.start {
					number = i + 1
					break
				}
			}
			let path = line.address == "" ?? (string[], line.address.split(separator))
			problems.push(Problem{kind: kind, message: message, start: start, end: end, line: number, column: charsIn(raw, line.start, start) + 1, path: path})
		}
	}
}
