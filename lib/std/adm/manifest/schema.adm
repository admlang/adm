// What `adm.toml` holds: every table and every key adm reads, with what each takes. Problems,
// `Manifest.set` and `Manifest.available` all go by this table.
internal partial module std.adm.manifest.schema {
	use std.adm.manifest::(ValueKind)

	// A key of a table. `*` stands for a name the file chooses.
	struct FieldSpec {
		key    string
		kind   ValueKind
		values string[]  = []
		doc    string
	}

	// A table, by its path with `*` for a chosen name (`apps.*.update`).
	struct TableSpec {
		pattern string
		rows    bool        = false
		doc     string
		fields  FieldSpec[] = []
	}

	internal const updateDoc = "The feed, channel and artifact an application's updates come from."
	internal const packageDoc = "How `adm package build` packs an application."
	internal const filesDoc = "A file or folder `adm package build` puts in the package."

	internal const updateFields = [
		FieldSpec{key: "feed", kind: ValueKind.Text, doc: "The URL of the update feed."},
		FieldSpec{key: "channel", kind: ValueKind.Text, doc: "The update channel, such as `stable`."},
		FieldSpec{key: "artifact", kind: ValueKind.Text, doc: "What an update delivers, such as `bundle` or `exe`."},
	]

	internal const packageFields = [
		FieldSpec{key: "format", kind: ValueKind.Text, values: ["tar.gz"], doc: "The form of the package."},
		FieldSpec{key: "install_root", kind: ValueKind.Text, doc: "Where the package installs, such as `user`."},
		FieldSpec{key: "bin_link", kind: ValueKind.Text, doc: "The name the installed program is linked under."},
	]

	internal const fileFields = [
		FieldSpec{key: "from", kind: ValueKind.Text, doc: "The file or folder to take, relative to the manifest's folder."},
		FieldSpec{key: "to", kind: ValueKind.Text, doc: "Where it goes in the package."},
		FieldSpec{key: "mode", kind: ValueKind.Mode, doc: "Its permission bits in octal, such as `0755`. Left out: the file's own."},
	]

	// The tables adm reads.
	const tables = [
		TableSpec{pattern: "", doc: "The manifest.", fields: [
			FieldSpec{key: "schema", kind: ValueKind.Number, values: ["1"], doc: "The version of this file's format."},
		]},
		TableSpec{pattern: "publisher", doc: "Who publishes this project: the identity its ids derive from.", fields: [
			FieldSpec{key: "pubkey", kind: ValueKind.PublicKey, doc: "The publisher's Ed25519 public key, `ed25519:base64:...`."},
			FieldSpec{key: "repo_salt", kind: ValueKind.Salt, doc: "This project's random salt, `base64:...`; keeps application ids stable across renames."},
			FieldSpec{key: "name", kind: ValueKind.Text, doc: "The publisher's display name; no part of its identity."},
		]},
		TableSpec{pattern: "deps", doc: "The libraries this project uses; `adm get` resolves them into `adm.lock`.", fields: [
			FieldSpec{key: "*", kind: ValueKind.Range, doc: "A library, `namespace:name` or a bare name, and the versions accepted."},
		]},
		TableSpec{pattern: "requires", doc: "What the package asks to be granted.", fields: [
			FieldSpec{key: "permissions", kind: ValueKind.List, doc: "The permissions it wants, globs allowed (`adm.storage.*`); a build fails when the code reaches more."},
		]},
		TableSpec{pattern: "policy", doc: "The security policy of the program.", fields: [
			FieldSpec{key: "sandbox", kind: ValueKind.Flag, doc: "Apply the OS sandbox derived from the compiled policy at startup."},
			FieldSpec{key: "build_read", kind: ValueKind.List, doc: "Paths outside the source tree a build-time meta may read (`**` globs; relative to the manifest's folder, `~` the home folder)."},
		]},
		TableSpec{pattern: "plugins", doc: "What the plugins an application loads at run time may be and do.", fields: [
			FieldSpec{key: "allow_unsigned", kind: ValueKind.Flag, doc: "Load a package without a publisher's signature."},
			FieldSpec{key: "trusted", kind: ValueKind.List, doc: "The publisher ids whose plugins load, `self` for the application's own; empty: any valid signature."},
			FieldSpec{key: "permissions", kind: ValueKind.List, doc: "The most any plugin may be given, globs allowed (`adm.storage.*`)."},
		]},
		TableSpec{pattern: "update", doc: updateDoc, fields: updateFields},
		TableSpec{pattern: "package", doc: packageDoc, fields: packageFields},
		TableSpec{pattern: "package.files", rows: true, doc: filesDoc, fields: fileFields},
		TableSpec{pattern: "registries", doc: "Where libraries are resolved from; without any, the public registry alone.", fields: [
			FieldSpec{key: "order", kind: ValueKind.List, doc: "The registries' names in resolution order; left out: by name."},
		]},
		TableSpec{pattern: "registries.*", doc: "A registry.", fields: [
			FieldSpec{key: "url", kind: ValueKind.Text, doc: "The git URL of the registry's repository."},
			FieldSpec{key: "token", kind: ValueKind.EnvVar, doc: "The environment variable holding the token for its API, `$\{NAME}`; never the secret itself."},
		]},
		TableSpec{pattern: "apps", doc: "The applications and libraries of this project, by name."},
		TableSpec{pattern: "apps.*", doc: "An application or library.", fields: [
			FieldSpec{key: "slug", kind: ValueKind.Text, doc: "The stable name its id derives from; left out: its own name."},
			FieldSpec{key: "version", kind: ValueKind.Version, doc: "Its version, for update feeds and publishing."},
			FieldSpec{key: "description", kind: ValueKind.Text, doc: "The line `adm search` shows."},
		]},
		TableSpec{pattern: "apps.*.update", doc: updateDoc, fields: updateFields},
		TableSpec{pattern: "apps.*.package", doc: packageDoc, fields: packageFields},
		TableSpec{pattern: "apps.*.package.files", rows: true, doc: filesDoc, fields: fileFields},
		TableSpec{pattern: "apps.*.compat", doc: "Where a published unit works, for readers of the registry; left out: everywhere.", fields: [
			FieldSpec{key: "os", kind: ValueKind.List, values: ["linux", "windows", "darwin", "android", "ios", "wasm"], doc: "The operating systems it works on."},
			FieldSpec{key: "arch", kind: ValueKind.List, values: ["amd64", "arm64", "wasm32"], doc: "The architectures it works on."},
			FieldSpec{key: "adm", kind: ValueKind.Version, doc: "The oldest adm it builds with."},
		]},
	]

	// The table of that pattern.
	def tableSpec(pattern string) ?TableSpec {
		for let spec in tables {
			return spec when spec.pattern == pattern
		}
		return none
	}

	// The key of a table.
	def fieldSpec(spec TableSpec, key string) ?FieldSpec {
		for let field in spec.fields {
			return field when field.key == key || field.key == "*"
		}
		return none
	}

	// The pattern a table's path answers to: a chosen name reads `*`, a row of an array of
	// tables reads as the array.
	def patternOf(path string[]) string {
		let parts string[]
		for let (i, part) in path {
			let isNamed = i == 1 && (path[0] == "apps" || (path[0] == "registries" && path.len() == 2))
			let isRow = i >= 2 && path[i - 2] == "package" && path[i - 1] == "files"
			continue when isRow
			parts.push(isNamed ?? ("*", part))
		}
		return parts.join(".")
	}
}
