// Bytes of the toolchain's line-based files: white space as the toolchain's readers take it,
// spans, positions and the writing of a whole file.
internal std.adm partial module std.adm.manifest.text {
	use std.os

	// How many bytes the white space character starting at `at` takes, 0 when there is none. White
	// space is Unicode's White_Space, as the readers of `adm.toml` and `adm.lock` take it.
	def spaceAt(raw byte[], at int, limit int) int {
		let c = int(raw[at])
		if c < 0x80 {
			return 1 when c == 0x20 || (c >= 0x09 && c <= 0x0D)
			return 0
		}
		return 0 when at + 1 >= limit
		let d = int(raw[at + 1])
		if c == 0xC2 {
			return 2 when d := 0x85 || 0xA0
			return 0
		}
		return 0 when at + 2 >= limit
		let e = int(raw[at + 2])
		return 3 when c == 0xE1 && d == 0x9A && e == 0x80
		return 3 when c == 0xE3 && d == 0x80 && e == 0x80
		return 3 when c == 0xE2 && d == 0x81 && e == 0x9F
		return 3 when c == 0xE2 && d == 0x80 && ((e >= 0x80 && e <= 0x8A) || e == 0xA8 || e == 0xA9 || e == 0xAF)
		return 0
	}

	// How many bytes the white space character ending at `at` takes, 0 when there is none.
	def spaceBefore(raw byte[], at int, floor int) int {
		let c = int(raw[at - 1])
		if c < 0x80 {
			return 1 when c == 0x20 || (c >= 0x09 && c <= 0x0D)
			return 0
		}
		for let width = 2; width <= 3 && at - width >= floor; width++ {
			return width when spaceAt(raw, at - width, at) == width
		}
		return 0
	}

	// The span without the white space around it.
	def trimSpan(raw byte[], from int, to int) (int, int) {
		let (start, stop) = (from, to)
		for start < stop {
			let width = spaceAt(raw, start, stop)
			break when width == 0
			start += width
		}
		for stop > start {
			let width = spaceBefore(raw, stop, start)
			break when width == 0
			stop -= width
		}
		return (start, stop)
	}

	// The text without the white space around it.
	def trimmed(text string) string {
		let raw = text.bytes()
		let (start, stop) = trimSpan(raw, 0, raw.len())
		return text when stop - start == raw.len()
		return textOf(raw, start, stop)
	}

	// The text of a span.
	def textOf(raw byte[], from int, to int) string {
		return string(raw[from:to])
	}

	// How many characters a span holds.
	def charsIn(raw byte[], from int, to int) int {
		let count = 0
		for let i = from; i < to; i++ {
			count++ when (int(raw[i]) & 0xC0) != 0x80
		}
		return count
	}

	// Replaces the file at `path` with `data`, whole or not at all, making its folder when
	// missing. Fails when the folder cannot be made or the file cannot be written.
	def writeWhole(path string, data byte[]) !none {
		try os.mkdir(os.dir(path), true)
		let spare = path + ".tmp"
		try os.writeFile(spare, data)
		try os.rename(spare, path)
	}
}
