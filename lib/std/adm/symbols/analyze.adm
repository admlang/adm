partial module std.adm.symbols {
	use (
		std.adm.symbols.walk::*
		std.adm.syntax::(SyntaxTree, Trivia, TriviaKind)
	)

	// FileSymbols is what one file declares: its units, every declaration
	// with a path, and the scope tree that says what a name means at an
	// offset.
	type FileSymbols {
		tree                     SyntaxTree
		path                     string
		root                     Scope
		units                    Symbol[]
		declarations             Symbol[]
		// The types the file's type nodes spell, by node id, while
		// `typesEpoch` is the workspace's shape count (`writtenType`).
		internal writtenTypes    map<int, Type>
		internal typesEpoch      int                        = -1
		// What other files see of it when they lower a type
		// (`Workspace.shapeOf`).
		internal shape           string                     = ""
		// Where each name occurs, as the start offsets of its tokens
		// (`namesOf`), built on first use: a FileSymbols' tree does not
		// change.
		internal nameIndex       map<string, int[]>
		internal nameIndexBuilt  bool                       = false
		// For each name asked about, the declarations its occurrences lead
		// to by id and how often (`Navigator.referencesTo`), while
		// `referencesEpoch` is the workspace's shape count.
		internal references      map<string, map<int, int>>
		internal referencesEpoch int                        = -1

		def new(tree SyntaxTree, path string, root Scope) {
			self.tree = tree
			self.path = path
			self.root = root
		}

		// scopeAt is the innermost scope holding the offset.
		def scopeAt(offset int) Scope {
			return root.innermost(offset)
		}

		// resolve is what `name` means at `offset` inside this file: the
		// symbols (overloads) of the nearest scope that declares it, or the
		// import that brings it in, or the `*` imports in scope (the
		// workspace looks the name up in their modules), or nothing: the
		// name is the prelude's or undefined.
		def resolve(name string, offset int) Symbol[] {
			let wildcards Symbol[]
			return resolveFrom(scopeAt(offset), name, offset, wildcards)
		}

		internal def resolveFrom(scope ?Scope, name string, offset int, wildcards Symbol[]) Symbol[] {
			return wildcards when scope is none
			let found = scope.lookup(name, offset)
			return found when found.len() > 0
			for let (_, w) in scope.wildcards {
				wildcards.push(w)
			}
			return resolveFrom(scope.parent, name, offset, wildcards)
		}

		// unitAt is the module, application, library, plugin or check suite
		// whose text holds the offset, none outside every unit.
		def unitAt(offset int) ?Symbol {
			for let (_, u) in units {
				return u when offset >= u.start() && offset < u.end()
			}
			return none
		}

		// symbolAt is the declaration whose name holds the offset.
		def symbolAt(offset int) ?Symbol {
			return symbolIn(root, offset)
		}

		internal def symbolIn(scope Scope, offset int) ?Symbol {
			for let (_, s) in scope.symbols {
				return s when offset >= s.nameStart && offset < s.nameEnd
			}
			for let (_, c) in scope.children {
				if offset >= c.start && offset < c.end {
					let found = symbolIn(c, offset)
					return found unless found is none
				}
			}
			return none
		}
	}

	// analyze is the symbols of a parsed file.
	def analyze(tree SyntaxTree, path string = "") FileSymbols {
		let root = new Scope(ScopeKind.File, tree.root())
		let file = new FileSymbols(tree, path, root)
		let a = new Analyzer(file)
		a.walkFile()
		return file
	}

	// docText is the doc comment in the leading trivia of a declaration's
	// first token: the run of `//` lines right above it, without the
	// markers; a block comment right above it, without its delimiters.
	def docText(trivia Trivia[]) string {
		let lines string[]
		let breaks = 0
		for let i = trivia.len() - 1; i >= 0; i-- {
			let t = trivia[i]
			if t.kind == TriviaKind.Whitespace {
				continue
			}
			if t.kind == TriviaKind.Newline {
				breaks++
				break when breaks > 1 && lines.len() > 0
				continue
			}
			break when breaks > 1
			if t.kind == TriviaKind.LineComment {
				lines.push(stripLineComment(t.text))
				breaks = 0
				continue
			}
			if t.kind == TriviaKind.BlockComment && lines.len() == 0 {
				let inner = t.text[2:t.text.len() - 2]
				return inner.trim()
			}
			break
		}
		let out string[]
		for let i = lines.len() - 1; i >= 0; i-- {
			out.push(lines[i])
		}
		return out.join("\n")
	}

	// trailingDocText is the first `//` comment of a trailing trivia list,
	// without the marker: the comment on a declaration's own line.
	def trailingDocText(trivia Trivia[]) string {
		for let (_, t) in trivia {
			return stripLineComment(t.text) when t.kind == TriviaKind.LineComment
			return "" when t.kind == TriviaKind.Newline
		}
		return ""
	}

	// stripLineComment is the text of a `//` comment line without the
	// marker and one space after it.
	internal def stripLineComment(text string) string {
		let body = text[2:]
		return body[1:] when body.startsWith(" ")
		return body
	}
}
