internal partial module std.adm.symbols.walk {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.symbols::*
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// walkDeferred walks the block of a function or lambda that `scope`
	// deferred (Scope.deferBlock), declaring its locals and inner scopes in
	// it.
	def walkDeferred(file FileSymbols, scope Scope, block SyntaxNode) {
		new Analyzer(file).walkDeferredBlock(scope, block)
	}

	// Analyzer walks a syntax tree once and fills a FileSymbols: a scope
	// per unit, body, function, lambda, block, header and case, and a
	// symbol per declaration.
	type Analyzer {
		internal file  FileSymbols
		internal scope Scope

		def new(file FileSymbols) {
			self.file = file
			self.scope = file.root
		}

		// enter opens a child scope of the current one and makes it current.
		internal def enter(kind ScopeKind, node SyntaxNode) Scope {
			let s = new Scope(kind, node)
			s.parent = scope
			scope.children.push(s)
			scope = s
			return s
		}

		// leave returns to the parent scope.
		internal def leave() {
			let p = scope.parent
			return when p is none
			scope = p
		}

		def walkFile() {
			for let (_, n) in file.tree.root().children() {
				walkTopLevel(n)
			}
		}

		internal def walkTopLevel(n SyntaxNode) {
			switch n.kind() {
				case SyntaxKind.Use:
					declareImports(n)
				case SyntaxKind.Module, SyntaxKind.Application, SyntaxKind.Library, SyntaxKind.Plugin, SyntaxKind.Check:
					walkUnit(n, none)
				default:
			}
		}

		// walkUnit declares a module, application, library, plugin or check
		// suite and walks its body as the unit's scope.
		internal def walkUnit(n SyntaxNode, owner ?Symbol) {
			let kind = unitKind(n.kind())
			let nameNode = nameAfterKeyword(n)
			let name = textOf(nameNode)
			name = name.len() >= 2 ?? (name[1:name.len() - 1], "check") when n.kind() == SyntaxKind.Check
			let sym = symbol(kind, name, n, nameNode)
			sym.path = pathUnder(owner, name)
			sym.internalScope = internalScopeOf(n, name) when sym.isInternal && kind == SymbolKind.Module
			file.units.push(sym) when owner is none
			declare(sym, owner)
			let body = childOf(n, SyntaxKind.Body)
			return when body is none
			enter(ScopeKind.Unit, body)
			walkMembers(body, sym, false)
			leave()
		}

		// internalScopeOf is the namespace an `internal` module is visible in
		// (spec 3.5): the one written between `internal` and `module`, else
		// the parent namespace of its name, or the name itself when it has
		// one part.
		internal def internalScopeOf(n SyntaxNode, name string) string {
			for let (_, c) in n.children() {
				break when c.isToken() && c.token() == TokenKind.Module
				return c.text().replace(" ", "") when c.kind() == SyntaxKind.QualifiedName
			}
			let dot = name.lastIndexOf(".")
			return name when dot < 0
			return name[:dot]
		}

		internal def unitKind(k SyntaxKind) SymbolKind {
			return SymbolKind.Application when k == SyntaxKind.Application
			return SymbolKind.Library when k == SyntaxKind.Library
			return SymbolKind.Plugin when k == SyntaxKind.Plugin
			return SymbolKind.Check when k == SyntaxKind.Check
			return SymbolKind.Module
		}

		// walkMembers declares what a body holds: declarations as members
		// of `owner` (methods when `typed`), and the statements a check
		// suite's body may hold.
		internal def walkMembers(body SyntaxNode, owner Symbol, typed bool) {
			for let (_, n) in body.children() {
				switch n.kind() {
					case SyntaxKind.Use:
						declareImports(n)
					case SyntaxKind.LetDecl:
						declareFields(n, owner, SymbolKind.Local, true)
						// A function literal or lambda as the value declares its own
						// parameters.
						walkChildren(n)
					case SyntaxKind.ConstDecl:
						declareFields(n, owner, SymbolKind.Const, true)
						walkChildren(n)
					case SyntaxKind.Field:
						declareFields(n, owner, SymbolKind.Field, true)
						walkChildren(n)
					case SyntaxKind.FuncDecl:
						walkFunction(n, owner, typed ?? (SymbolKind.Method, SymbolKind.Function))
					case SyntaxKind.Property:
						walkProperty(n, owner)
					case SyntaxKind.TypeDecl, SyntaxKind.StructDecl, SyntaxKind.EnumDecl, SyntaxKind.UnionDecl, SyntaxKind.InterfaceDecl, SyntaxKind.DatatypeDecl, SyntaxKind.ServiceDecl, SyntaxKind.ComponentDecl, SyntaxKind.ViewDecl, SyntaxKind.StyleDecl:
						walkComposite(n, owner)
					case SyntaxKind.EnumMember:
						declareMember(n, owner, SymbolKind.EnumMember)
					case SyntaxKind.UnionMember:
						declareMember(n, owner, SymbolKind.UnionMember)
					case SyntaxKind.Where:
						walkMembersOf(childOf(n, SyntaxKind.Body), owner, typed)
						walkOptional(childOf(n, SyntaxKind.Block))
					case SyntaxKind.Check, SyntaxKind.Module, SyntaxKind.Application, SyntaxKind.Library, SyntaxKind.Plugin:
						walkUnit(n, owner)
					case SyntaxKind.Embedding, SyntaxKind.Export, SyntaxKind.Attribute, SyntaxKind.Skipped:
					default:
						walkNode(n)
				}
			}
		}

		// walkComposite declares a type, struct, enum, union, interface,
		// datatype, service, component, view or style and its members.
		internal def walkComposite(n SyntaxNode, owner Symbol) {
			let kind = compositeKind(n.kind())
			let nameNode = nameAfterKeyword(n)
			let name = textOf(nameNode)
			let sym = symbol(kind, name, n, nameNode)
			sym.path = join(owner.path, name) when name.len() > 0
			declare(sym, owner)
			let body = childOf(n, SyntaxKind.Body)
			if body is none {
				let block = childOf(n, SyntaxKind.Block)
				if block is none {
					// An alias's type parameters are visible in its target
					// (`type Pair<A, B> = (A, B)`).
					if !(childOf(n, SyntaxKind.TypeParams) is none) {
						enter(ScopeKind.Header, n)
						declareTypeParams(n)
						leave()
					}
					return
				}
				// A named style's top-level `let`s are its properties, the
				// keys of a `Box{width: ...}` literal; anything else in a
				// style or view block is statements.
				if n.kind() == SyntaxKind.StyleDecl && name.len() > 0 {
					enter(ScopeKind.Members, block)
					walkStyleBlock(block, sym)
					leave()
				} else {
					walkNode(block)
				}
				return
			}
			// The type parameters are visible over the whole declaration, its
			// `<T: Comparable<T>, I = T>` header included, so they get a scope
			// of their own around the body's.
			enter(ScopeKind.Header, n)
			declareTypeParams(n)
			enter(ScopeKind.Members, body)
			if n.kind() == SyntaxKind.ComponentDecl {
				declareViewRefs(n, sym)
				walkComponentBody(body, sym)
			} else {
				walkMembers(body, sym, true)
			}
			leave()
			leave()
		}

		// walkComponentBody declares the component's inline controller
		// members and walks its view and style blocks.
		internal def walkComponentBody(body SyntaxNode, owner Symbol) {
			for let (_, n) in body.children() {
				switch n.kind() {
					case SyntaxKind.Use:
						declareImports(n)
					case SyntaxKind.TypeDecl:
						// `type { ... }` declares the inline controller's members;
						// `type Name` refers to a controller declared elsewhere.
						let inner = childOf(n, SyntaxKind.Body)
						walkMembersOf(inner, owner, true)
					case SyntaxKind.ViewDecl, SyntaxKind.StyleDecl:
						walkOptional(childOf(n, SyntaxKind.Block))
					default:
						walkNode(n)
				}
			}
		}

		// walkStyleBlock declares a named style's top-level `let`s as its
		// members and walks the rest of the block as statements.
		internal def walkStyleBlock(block SyntaxNode, owner Symbol) {
			for let (_, c) in block.children() {
				continue when c.isToken()
				if c.kind() == SyntaxKind.LetDecl {
					declareFields(c, owner, SymbolKind.Field, true)
					walkChildren(c)
					continue
				}
				walkNode(c)
			}
		}

		// declareViewRefs declares the members a component's views make with
		// `ref = name` on a component call (`ScrollView(ref = port)`): a
		// field holding the placed component, typed by the Navigator from
		// the call. A ref is only given on a call that is a statement of the
		// component's view, so only its `view { ... }` blocks are searched.
		internal def declareViewRefs(comp SyntaxNode, owner Symbol) {
			let body = childOf(comp, SyntaxKind.Body)
			return when body is none
			let count = body.childCount()
			for let i = 0; i < count; i++ {
				continue unless body.childKind(i) == SyntaxKind.ViewDecl
				let decl = body.child(i)
				continue when decl is none
				let block = childOf(decl, SyntaxKind.Block)
				declareViewRefsUnder(block, owner) unless block is none
			}
		}

		// declareViewRefsUnder declares the refs of the nodes below `n`, in
		// source order: a node is made only when it is visited, a token never.
		internal def declareViewRefsUnder(n SyntaxNode, owner Symbol) {
			let count = n.childCount()
			for let i = 0; i < count; i++ {
				let kind = n.childKind(i)
				continue when kind == SyntaxKind.Token
				let c = n.child(i)
				continue when c is none
				declareViewRef(c, owner) when kind == SyntaxKind.Arg
				declareViewRefsUnder(c, owner)
			}
		}

		// declareViewRef declares the member an argument `ref = name` of a
		// component call makes.
		internal def declareViewRef(d SyntaxNode, owner Symbol) {
			return when d.childCount() < 3
			let (key, assign, target) = (d.child(0), d.child(1), d.child(2))
			return when key is none || assign is none || target is none
			return unless key.isToken() && key.text() == "ref" && assign.isToken() && assign.token() == TokenKind.Assign
			return unless target.kind() == SyntaxKind.Name
			let nameToken = target.firstToken()
			return when nameToken is none
			let args = d.parent
			return when args is none
			let call = args.parent
			return when call is none
			return unless call.kind() == SyntaxKind.ComponentCall || call.kind() == SyntaxKind.Call
			let sym = symbol(SymbolKind.Field, nameToken.text(), d, nameToken)
			sym.path = join(owner.path, nameToken.text())
			declare(sym, owner)
		}

		internal def compositeKind(k SyntaxKind) SymbolKind {
			return SymbolKind.Struct when k == SyntaxKind.StructDecl
			return SymbolKind.Enum when k == SyntaxKind.EnumDecl
			return SymbolKind.Union when k == SyntaxKind.UnionDecl
			return SymbolKind.Interface when k == SyntaxKind.InterfaceDecl
			return SymbolKind.Datatype when k == SyntaxKind.DatatypeDecl
			return SymbolKind.Service when k == SyntaxKind.ServiceDecl
			return SymbolKind.Component when k == SyntaxKind.ComponentDecl
			return SymbolKind.View when k == SyntaxKind.ViewDecl
			return SymbolKind.Style when k == SyntaxKind.StyleDecl
			return SymbolKind.Type
		}

		// walkFunction declares a function or method, then its type
		// parameters, parameters and body in a scope of its own.
		internal def walkFunction(n SyntaxNode, owner Symbol, kind SymbolKind) {
			let nameNode = functionName(n)
			let name = textOf(nameNode)
			let sym = symbol(kind, name, n, nameNode)
			sym.path = join(owner.path, name) when name.len() > 0
			sym.isMeta = !(firstToken(n, TokenKind.Meta) is none)
			declare(sym, owner)
			walkFunctionScope(n, ScopeKind.Function)
		}

		// walkFunctionScope opens the scope of a function or lambda: its
		// type parameters, parameters and body.
		internal def walkFunctionScope(n SyntaxNode, kind ScopeKind) {
			enter(kind, n)
			declareTypeParams(n)
			for let (_, c) in n.children() {
				switch c.kind() {
					case SyntaxKind.Params:
						for let (_, p) in c.children() {
							declareParam(p) when p.kind() == SyntaxKind.Param
						}
					case SyntaxKind.Param:
						declareParam(c)
					case SyntaxKind.Block:
						// Walked when the scope is first read: a file's
						// declarations need no function body.
						scope.deferBlock(c, file)
					case SyntaxKind.TypeParams, SyntaxKind.Attribute, SyntaxKind.RawBlock:
					default:
						walkNode(c) unless c.isToken()
				}
			}
			leave()
		}

		// walkProperty declares a property and its accessors.
		internal def walkProperty(n SyntaxNode, owner Symbol) {
			let nameNode = firstToken(n, TokenKind.Ident)
			let name = textOf(nameNode)
			let sym = symbol(SymbolKind.Property, name, n, nameNode)
			sym.path = join(owner.path, name)
			declare(sym, owner)
			let body = childOf(n, SyntaxKind.Body)
			return when body is none
			enter(ScopeKind.Members, body)
			// Each property implicitly defines `value` storage private to its
			// block (spec §7): a local with no name span of its own.
			let storage = new Symbol(SymbolKind.Local, "value", n, 0, 0)
			storage.file = file.path
			scope.declare(storage)
			walkMembers(body, sym, true)
			leave()
		}

		// declareParam declares the names of a parameter, or of its
		// destructuring.
		internal def declareParam(p SyntaxNode) {
			for let (_, c) in p.children() {
				// `@range(0.0, 1.0) strength float`: the annotation comes first.
				continue when c.kind() == SyntaxKind.Attribute
				if c.kind() == SyntaxKind.Destructure {
					for let (_, t) in c.tokens() {
						declareLocal(SymbolKind.Parameter, t, p) when t.token() == TokenKind.Ident
					}
					continue
				}
				break unless c.isToken()
				let k = c.token()
				continue when k == TokenKind.Comma
				// A parameter may be named `style` or `view` (the lexer's keywords).
				break unless k == TokenKind.Ident || k == TokenKind.Style || k == TokenKind.View
				declareLocal(SymbolKind.Parameter, c, p)
			}
		}

		internal def declareTypeParams(n SyntaxNode) {
			let params = childOf(n, SyntaxKind.TypeParams)
			return when params is none
			for let (_, p) in params.children() {
				continue unless p.kind() == SyntaxKind.TypeParam
				declareLocalIf(SymbolKind.TypeParameter, p.firstToken(), p)
			}
		}

		// declareFields declares the names of a let, const or field
		// declaration: each Field's names, or a destructuring's bindings.
		// With `pathed` they are members of the owner.
		internal def declareFields(n SyntaxNode, owner Symbol, kind SymbolKind, pathed bool) {
			if n.kind() == SyntaxKind.Field {
				declareFieldNames(n, owner, kind, pathed, false, "", [])
				return
			}
			// `internal let` and `internal const` carry the modifier on the
			// declaration, not on each field.
			let hidden = false
			// `// doc` above `const x = 1` sits on the declaration's first
			// token; a field without a doc of its own takes it. So do the
			// annotations written on the declaration (`@unit("g") const gram`).
			let shared = docOf(n.firstToken())
			let sharedAnnotations SyntaxNode[]
			for let (_, c) in n.children() {
				hidden = true when c.isToken() && c.token() == TokenKind.Internal
				sharedAnnotations.push(c) when c.kind() == SyntaxKind.Attribute
				if c.kind() == SyntaxKind.Field {
					declareFieldNames(c, owner, kind, pathed, hidden, shared, sharedAnnotations)
				} else if c.kind() == SyntaxKind.Destructure {
					declareBindings(c)
				}
			}
		}

		internal def declareFieldNames(field SyntaxNode, owner Symbol, kind SymbolKind, pathed bool, hidden bool, shared string, sharedAnnotations SyntaxNode[]) {
			for let (_, c) in field.children() {
				continue when c.kind() == SyntaxKind.Attribute
				if c.kind() == SyntaxKind.Destructure {
					declareBindings(c)
					return
				}
				break unless c.isToken()
				let k = c.token()
				continue when k == TokenKind.Internal || k == TokenKind.Atomic || k == TokenKind.Weak || k == TokenKind.Comma
				break unless k == TokenKind.Ident || k == TokenKind.View || k == TokenKind.Style
				// A dotted name (`size.width = 2` in a style body) declares
				// nothing.
				let next = c.nextSibling()
				break when !(next is none) && next.isToken() && next.token() == TokenKind.Dot
				if pathed {
					let sym = symbol(kind, c.text(), field, c)
					sym.path = join(owner.path, c.text())
					sym.isInternal = true when hidden
					sym.doc = shared when sym.doc.len() == 0
					if sym.annotations.len() == 0 {
						for let (_, a) in sharedAnnotations {
							sym.annotations.push(a)
						}
					}
					declare(sym, owner)
				} else {
					declareLocal(kind, c, field)
				}
			}
		}

		// declareBindings declares the names a destructuring binds: the
		// alias after `as` when there is one.
		internal def declareBindings(d SyntaxNode) {
			for let (_, b) in d.children() {
				if b.kind() == SyntaxKind.Binding {
					declareLocalIf(SymbolKind.Local, b.lastToken(), b)
					continue
				}
				declareLocal(SymbolKind.Local, b, d) when b.isToken() && b.token() == TokenKind.Ident
			}
		}

		// declareMember declares an enum or union member.
		internal def declareMember(n SyntaxNode, owner Symbol, kind SymbolKind) {
			let nameNode = firstToken(n, TokenKind.Ident)
			return when nameNode is none
			let sym = symbol(kind, nameNode.text(), n, nameNode)
			sym.path = join(owner.path, nameNode.text())
			declare(sym, owner)
		}

		// declareImports declares what a `use` brings into the scope.
		internal def declareImports(useNode SyntaxNode) {
			for let (_, item) in useNode.descendants() {
				declareImportItem(item) when item.kind() == SyntaxKind.UseItem
			}
		}

		// declareImportItem declares what one `use` item binds.
		internal def declareImportItem(item SyntaxNode) {
			let moduleNode = childOf(item, SyntaxKind.QualifiedName)
			return when moduleNode is none
			let moduleName = moduleNode.text().replace(" ", "")
			let alias = ""
			let listed = false
			let kids = item.children()
			for let (i, c) in kids {
				alias = kids[i + 1].text() when c.isToken() && c.token() == TokenKind.As && i + 1 < kids.len()
				if c.isToken() && c.token() == TokenKind.Mul {
					let w = new Symbol(SymbolKind.Import, "*", item, c.start(), c.end())
					w.moduleName = moduleName
					w.wildcard = true
					scope.wildcards.push(w)
					listed = true
				}
				if c.kind() == SyntaxKind.UseSymbol {
					declareImportedSymbol(c, moduleName)
					listed = true
				}
				if c.kind() == SyntaxKind.UseSymbols {
					for let (_, s) in c.children() {
						if s.kind() == SyntaxKind.UseSymbol {
							declareImportedSymbol(s, moduleName)
						} else if s.isToken() && s.token() == TokenKind.Mul {
							let w = new Symbol(SymbolKind.Import, "*", item, s.start(), s.end())
							w.moduleName = moduleName
							w.wildcard = true
							scope.wildcards.push(w)
						}
					}
					listed = true
				}
			}
			return when listed
			let last = moduleNode.lastToken()
			return when last is none
			let name = alias.len() > 0 ?? (alias, last.text())
			return when name == "_"
			let sym = new Symbol(SymbolKind.Import, name, item, last.start(), last.end())
			sym.moduleName = moduleName
			sym.file = file.path
			scope.declare(sym)
		}

		internal def declareImportedSymbol(s SyntaxNode, moduleName string) {
			let kids = s.children()
			return when kids.len() == 0
			let imported = kids[0].text()
			let bound = kids[kids.len() - 1]
			let sym = new Symbol(SymbolKind.Import, bound.text(), s, bound.start(), bound.end())
			sym.moduleName = moduleName
			sym.imported = imported
			scope.declare(sym)
		}

		// walkNode walks statements and expressions for what declares a
		// name inside a function: locals, loop variables, pattern bindings,
		// lambda parameters, handler bindings and nested functions.
		internal def walkNode(n SyntaxNode) {
			return when n.isToken()
			switch n.kind() {
				case SyntaxKind.Block:
					enter(ScopeKind.Block, n)
					walkBlockInPlace(n)
					leave()
				case SyntaxKind.Use:
					// A `use` inside a body binds its names for that block.
					declareImports(n)
				case SyntaxKind.LetDecl:
					declareFields(n, placeholder(), SymbolKind.Local, false)
					walkChildren(n)
				case SyntaxKind.ConstDecl:
					declareFields(n, placeholder(), SymbolKind.Const, false)
					walkChildren(n)
				case SyntaxKind.FuncDecl:
					walkFunctionScope(n, ScopeKind.Function)
				case SyntaxKind.Lambda:
					walkFunctionScope(n, ScopeKind.Lambda)
				case SyntaxKind.For, SyntaxKind.If, SyntaxKind.Switch, SyntaxKind.Match, SyntaxKind.Where:
					enter(ScopeKind.Header, n)
					walkChildren(n)
					leave()
				case SyntaxKind.Case:
					enter(ScopeKind.Case, n)
					declarePatterns(n)
					walkChildren(n)
					leave()
				case SyntaxKind.OnError:
					enter(ScopeKind.Handler, n)
					let kids = n.children()
					for let (i, c) in kids {
						if c.isToken() && c.token() == TokenKind.LParen && i + 1 < kids.len() {
							let bound = kids[i + 1]
							declareLocal(SymbolKind.Local, bound, n) when bound.isToken() && bound.token() == TokenKind.Ident
						}
					}
					walkChildren(n)
					leave()
				default:
					walkChildren(n)
			}
		}

		internal def walkChildren(n SyntaxNode) {
			for let (_, c) in n.children() {
				walkNode(c) unless c.isToken()
			}
		}

		// walkDeferredBlock walks the block a scope deferred, in that scope.
		def walkDeferredBlock(scope Scope, block SyntaxNode) {
			self.scope = scope
			walkBlockInPlace(block)
		}

		// walkBlockInPlace walks a block's statements in the current scope.
		internal def walkBlockInPlace(block SyntaxNode) {
			for let (_, c) in block.children() {
				walkNode(c) unless c.isToken()
			}
		}

		// declarePatterns declares the bindings of a case's patterns.
		internal def declarePatterns(c SyntaxNode) {
			for let (_, d) in c.descendants() {
				declareLocalIf(SymbolKind.Local, d.firstToken(), d) when d.kind() == SyntaxKind.Binding || d.kind() == SyntaxKind.PatternField
			}
		}

		// ------------------------------------------------------------
		// Helpers
		// ------------------------------------------------------------

		// symbol makes a declaration symbol with its doc comment and
		// annotations.
		internal def symbol(kind SymbolKind, name string, n SyntaxNode, nameNode ?SyntaxNode) Symbol {
			let sym = new Symbol(kind, name, n, startOf(nameNode, n.start()), endOf(nameNode, n.start()))
			sym.file = file.path
			sym.doc = docOf(n.firstToken())
			sym.doc = trailingDocOf(n.lastToken()) when sym.doc.len() == 0
			for let (_, c) in n.children() {
				break unless c.kind() == SyntaxKind.Attribute || (c.isToken() && c.token() == TokenKind.Internal)
				sym.annotations.push(c) when c.kind() == SyntaxKind.Attribute
			}
			for let (_, c) in n.children() {
				break unless c.isToken() || c.kind() == SyntaxKind.Attribute
				sym.isInternal = true when c.isToken() && c.token() == TokenKind.Internal
			}
			return sym
		}

		// declare records a symbol in the current scope, as a member of the
		// owner, and among the file's declarations when it has a path.
		internal def declare(sym Symbol, owner ?Symbol) {
			scope.declare(sym)
			attach(sym, owner)
			file.declarations.push(sym) when sym.path.len() > 0
			declareUnitSymbols(sym, owner)
		}

		// declareUnitSymbols declares the unit a `@unit("km", prefixes =
		// Prefixes.SI)` constant or a `@dimension(unit = "m")` type gives
		// quantity literals: a `Unit` symbol named by the string, with the
		// declaration's doc, in the module's scope and declarations (not
		// among the module's members, which `adm doc` lists).
		internal def declareUnitSymbols(sym Symbol, owner ?Symbol) {
			return unless sym.kind == SymbolKind.Const || sym.kind == SymbolKind.Type
			for let (_, a) in sym.annotations {
				let name = annotationName(a)
				continue unless name := "unit" || "dimension"
				let args = childOf(a, SyntaxKind.Args)
				continue when args is none
				let symbolToken ?SyntaxNode = none
				let prefixes = ""
				for let (_, arg) in args.children() {
					continue unless arg.kind() == SyntaxKind.Arg
					let kids = arg.children()
					continue when kids.len() == 0
					if kids.len() >= 3 && kids[0].isToken() && kids[1].isToken() && kids[1].token() == TokenKind.Assign {
						let key = kids[0].text()
						symbolToken = stringToken(kids[2]) when key == "unit"
						if key == "prefixes" {
							let last = kids[2].lastToken()
							prefixes = last.text() unless last is none
						}
						continue
					}
					symbolToken = stringToken(kids[0]) when symbolToken is none && name == "unit"
				}
				continue when symbolToken is none
				let text = symbolToken.text()
				continue when text.len() < 3
				let unitName = text[1:text.len() - 1]
				let unit = new Symbol(SymbolKind.Unit, unitName, sym.node, symbolToken.start() + 1, symbolToken.end() - 1)
				unit.file = file.path
				unit.doc = sym.doc
				unit.path = pathUnder(owner, unitName)
				unit.unitPrefixes = prefixes unless prefixes == "None"
				scope.declare(unit)
				file.declarations.push(unit)
			}
		}

		// annotationName is the last name of an annotation (`query` for
		// `@db.query()`), "" when it has none.
		internal def annotationName(attribute SyntaxNode) string {
			for let (_, c) in attribute.children() {
				continue unless c.kind() == SyntaxKind.Name || c.kind() == SyntaxKind.QualifiedName
				let last = c.lastToken()
				return "" when last is none
				return last.text()
			}
			return ""
		}

		// stringToken is the string token of a string literal node, none for
		// another expression.
		internal def stringToken(n SyntaxNode) ?SyntaxNode {
			return none unless n.kind() == SyntaxKind.Literal
			let t = n.firstToken()
			return none when t is none
			return t when t.token() == TokenKind.String
			return none
		}

		// attach makes the symbol a member of the owner, when there is one.
		internal def attach(sym Symbol, owner ?Symbol) {
			return when owner is none
			sym.parent = owner
			owner.members.push(sym)
		}

		// pathUnder is the path of `name` under the owner's path.
		internal def pathUnder(owner ?Symbol, name string) string {
			return name when owner is none
			return join(owner.path, name)
		}

		// textOf is the node's text, "" for none.
		internal def textOf(node ?SyntaxNode) string {
			return "" when node is none
			return node.text()
		}

		internal def startOf(node ?SyntaxNode, fallback int) int {
			return fallback when node is none
			return node.start()
		}

		internal def endOf(node ?SyntaxNode, fallback int) int {
			return fallback when node is none
			return node.end()
		}

		// trailingDocOf is the `//` comment on the token's own line (what a
		// constant in a table is explained by), "" for none.
		internal def trailingDocOf(last ?SyntaxNode) string {
			return "" when last is none
			return trailingDocText(last.trailingTrivia())
		}

		// docOf is the doc comment above the token, "" for none.
		internal def docOf(first ?SyntaxNode) string {
			return "" when first is none
			return docText(first.leadingTrivia())
		}

		// declareLocalIf declares a local for the token, when there is one.
		internal def declareLocalIf(kind SymbolKind, t ?SyntaxNode, n SyntaxNode) {
			return when t is none
			declareLocal(kind, t, n)
		}

		// walkOptional walks the node, when there is one.
		internal def walkOptional(node ?SyntaxNode) {
			return when node is none
			walkNode(node)
		}

		// walkMembersOf walks the body's members, when there is one.
		internal def walkMembersOf(body ?SyntaxNode, owner Symbol, typed bool) {
			return when body is none
			walkMembers(body, owner, typed)
		}

		// declareLocal records a local, parameter or type parameter named
		// by the token in the current scope.
		internal def declareLocal(kind SymbolKind, t SyntaxNode, n SyntaxNode) {
			let sym = new Symbol(kind, t.text(), n, t.start(), t.end())
			sym.file = file.path
			scope.declare(sym)
		}

		// placeholder is an owner for locals, which have no path.
		internal def placeholder() Symbol {
			return new Symbol(SymbolKind.Local, "", file.tree.root(), 0, 0)
		}

		// join is the path of a member of a path.
		internal def join(path string, name string) string {
			return name when path.len() == 0
			return path + "." + name
		}

		// nameAfterKeyword is the name node of a declaration: the Ident,
		// String or QualifiedName right after its keyword token.
		internal def nameAfterKeyword(n SyntaxNode) ?SyntaxNode {
			let kids = n.children()
			let seenKeyword = false
			for let (_, c) in kids {
				if c.isToken() {
					let k = c.token()
					if seenKeyword {
						return c when k == TokenKind.Ident || k == TokenKind.String
						return none
					}
					seenKeyword = true when k != TokenKind.Internal && k != TokenKind.Partial
					continue
				}
				if seenKeyword {
					return c when c.kind() == SyntaxKind.QualifiedName
					return none
				}
				return none unless c.kind() == SyntaxKind.Attribute || c.kind() == SyntaxKind.QualifiedName
			}
			return none
		}

		// functionName is the name token of a FuncDecl: what follows `def`
		// (and `async`, as an interface method may write it), else the first
		// name of an interface method written without `def`.
		internal def functionName(n SyntaxNode) ?SyntaxNode {
			let kids = n.children()
			for let (i, c) in kids {
				if c.isToken() && c.token() == TokenKind.Def {
					let at = i + 1
					at++ when at < kids.len() && kids[at].isToken() && kids[at].token() == TokenKind.Async
					return none when at >= kids.len()
					let next = kids[at]
					return next when next.isToken() && next.token() != TokenKind.LParen && next.token() != TokenKind.Lt && next.token() != TokenKind.Semi
					return none
				}
			}
			for let (_, c) in kids {
				return c when c.isToken() && c.token() == TokenKind.Ident
				return none unless c.isToken() || c.kind() == SyntaxKind.Attribute
			}
			return none
		}

		// childOf is the first child of the kind, found without making the
		// others.
		internal def childOf(n SyntaxNode, kind SyntaxKind) ?SyntaxNode {
			let count = n.childCount()
			for let i = 0; i < count; i++ {
				return n.child(i) when n.childKind(i) == kind
			}
			return none
		}

		// firstToken is the first child token of the kind; the children that
		// are nodes are passed over without being made.
		internal def firstToken(n SyntaxNode, kind TokenKind) ?SyntaxNode {
			let count = n.childCount()
			for let i = 0; i < count; i++ {
				continue unless n.childKind(i) == SyntaxKind.Token
				let c = n.child(i)
				return c when !(c is none) && c.token() == kind
			}
			return none
		}
	}
}
