partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// MetaConstraint is one type a meta's generic parameters ask of the
	// declaration it annotates (`trim<string>`, `codec<ImageCodec>`,
	// `embed<T: byte[]>`): a primitive by its spelling, a declaration, an
	// intersection, or any other type as written.
	internal struct MetaConstraint {
		primitive string             = ""
		symbol    ?Symbol            = none
		written   ?TypeRef           = none
		// An intersection (`FormatInfo & SignatureMatcher`), or the one a
		// symbol is an alias of: one constraint of every group admits.
		allOf     MetaConstraint[][] = []
	}

	partial type Navigator {
		// annotationSlot is the attribute whose name the offset completes:
		// right after its `@`, at the end of the name being typed (the last
		// part of `@db.que`), or right after a `.` of its name; none
		// anywhere else.
		internal def annotationSlot(file FileSymbols, offset int) ?SyntaxNode {
			return none when offset == 0
			let before = file.tree.find(offset - 1)
			return none when before is none
			return none unless before.isToken() && before.end() == offset
			let parent = before.parent
			return none when parent is none
			if before.token() == TokenKind.At {
				return parent when parent.kind() == SyntaxKind.Attribute
				return none
			}
			if before.token() == TokenKind.Dot {
				return none unless parent.kind() == SyntaxKind.QualifiedName
			} else {
				return none unless isTypedName(before) && isAnnotationName(parent, before)
			}
			let holder = parent.parent
			return none when holder is none
			return holder when holder.kind() == SyntaxKind.Attribute
			return none
		}

		// annotationCompletions is what the annotation can name at the
		// offset: each visible meta (the overload `annotationAt` would take)
		// that can annotate the declaration the annotation stands on, as the
		// compiler matches them (`fittingMeta`); one an import renames as
		// its Import symbol, named as written. After `db.` the metas the
		// module `db` binds declare. On no declaration, every visible meta.
		internal def annotationCompletions(file FileSymbols, attribute SyntaxNode, offset int) Symbol[] {
			let qualifier = qualifierBefore(attribute, offset)
			let names string[]
			let seen map<string, bool>
			let named = ""
			if qualifier.len() > 0 {
				// `@db.query()` names a meta of the module an import binds.
				return [] unless qualifier.len() == 1
				let bound = workspace.resolve(file, qualifier[0], offset)
				return [] unless bound.len() == 1 && bound[0].kind == SymbolKind.Import && !bound[0].wildcard && bound[0].imported.len() == 0
				named = bound[0].moduleName
				addPublicMetaNames(workspace.exports(named), names, seen)
			} else {
				visibleMetaNames(file, offset, names, seen)
			}
			let target = attribute.parent
			return [] when target is none
			let out Symbol[]
			for let (_, name) in names {
				let candidates = named.len() > 0 ?? (metasAmong(workspace.lookup(named, name)), annotationAt(file, name, offset))
				let fit = fittingMeta(file, candidates, target)
				continue when fit is none
				if fit.name == name {
					out.push(fit)
					continue
				}
				// `use m::(test as spec)`: the import, which the entry is
				// written as.
				let imp = namedImport(file.scopeAt(offset), name, offset)
				out.push(imp) unless imp is none
			}
			return out
		}

		// namedImport is the nearest `use m::(x as name)` that binds the
		// name, past what else is named so.
		internal def namedImport(scope ?Scope, name string, offset int) ?Symbol {
			return none when scope is none
			for let (_, s) in scope.lookup(name, offset) {
				return s when s.kind == SymbolKind.Import && s.imported.len() > 0
			}
			return namedImport(scope.parent, name, offset)
		}

		// qualifierBefore is the parts of the annotation's name written
		// before the one being typed at the offset: `db` for `@db.que|` and
		// `@db.|`, none for `@que|`.
		internal def qualifierBefore(attribute SyntaxNode, offset int) string[] {
			let out string[]
			let name = childOfKind(attribute, SyntaxKind.QualifiedName)
			return out when name is none
			for let (_, t) in name.tokens() {
				out.push(t.text()) when t.token() != TokenKind.Dot && !t.isMissing() && t.end() < offset
			}
			return out
		}

		// visibleMetaNames adds the name of every meta an annotation can name
		// at the offset, nearest first: the file's scopes (and what their
		// named imports bring in), the module's other parts, the `*` imports,
		// the modules a plain `use m` binds, the prelude.
		internal def visibleMetaNames(file FileSymbols, offset int, names string[], seen map<string, bool>) {
			let wildcards Symbol[]
			let modules Symbol[]
			scopeMetaNames(file.scopeAt(offset), names, seen, wildcards)
			collectModuleImports(file.scopeAt(offset), modules)
			let unit = file.unitAt(offset)
			addMetaNames(workspace.exports(unit.path), names, seen) when !(unit is none) && unit.kind == SymbolKind.Module
			for let (_, w) in wildcards {
				addPublicMetaNames(workspace.exports(w.moduleName), names, seen)
			}
			for let (_, m) in modules {
				addPublicMetaNames(workspace.exports(m.moduleName), names, seen)
			}
			addPublicMetaNames(workspace.exports("builtin"), names, seen)
		}

		internal def scopeMetaNames(scope ?Scope, names string[], seen map<string, bool>, wildcards Symbol[]) {
			return when scope is none
			for let (_, s) in scope.symbols {
				if s.kind == SymbolKind.Import && s.imported.len() > 0 {
					// `use m::(test as check)` names the meta `check`.
					addMetaName(s.name, metasAmong(workspace.lookup(s.moduleName, s.imported)).len() > 0, names, seen)
					continue
				}
				addMetaName(s.name, s.isMeta, names, seen)
			}
			for let (_, w) in scope.wildcards {
				wildcards.push(w)
			}
			scopeMetaNames(scope.parent, names, seen, wildcards)
		}

		internal def addMetaNames(symbols Symbol[], names string[], seen map<string, bool>) {
			for let (_, s) in symbols {
				addMetaName(s.name, s.isMeta, names, seen)
			}
		}

		// addPublicMetaNames adds the metas another module exports, its
		// internal ones left out.
		internal def addPublicMetaNames(symbols Symbol[], names string[], seen map<string, bool>) {
			for let (_, s) in symbols {
				addMetaName(s.name, s.isMeta && !s.isInternal, names, seen)
			}
		}

		internal def addMetaName(name string, isMeta bool, names string[], seen map<string, bool>) {
			return unless isMeta
			return when name.len() == 0 || seen.hasKey(name)
			seen[name] = true
			names.push(name)
		}

		// fittingMeta is the overload among a meta's candidates the compiler
		// would take for an annotation on the target declaration, none when
		// none can annotate it. A method takes an overload for methods over
		// one for any function, a `let` or `const` one for its own context
		// over one for any variable; then the overload's contexts have to
		// include one of the target's (`metaTargetContexts`), and its generic
		// constraints admit the target's type (`constraintsAdmit`). On a
		// target that is no declaration, the first overload with a context.
		internal def fittingMeta(file FileSymbols, candidates Symbol[], target SyntaxNode) ?Symbol {
			let supported string[][]
			for let (_, c) in candidates {
				supported.push(metaContexts(c))
			}
			let wanted = metaTargetContexts(file, target)
			if wanted.len() == 0 {
				for let (i, c) in candidates {
					return c when supported[i].len() > 0
				}
				return none
			}
			let preferMethod = false
			let own = ""
			for let (_, s) in supported {
				preferMethod = true when wanted.includes("MethodMetaContext") && s.includes("MethodMetaContext")
				for let (_, ctx) in ["LetMetaContext", "ConstMetaContext"] {
					own = ctx when wanted.includes(ctx) && s.includes(ctx)
				}
			}
			for let (i, c) in candidates {
				let s = supported[i]
				continue when preferMethod && !s.includes("MethodMetaContext")
				continue when own.len() > 0 && s.includes("VariableMetaContext") && !s.includes(own)
				continue unless sharesContext(s, wanted)
				return c when constraintsAdmit(file, c, target)
			}
			return none
		}

		internal def sharesContext(supported string[], wanted string[]) bool {
			for let (_, ctx) in supported {
				return true when wanted.includes(ctx)
			}
			return false
		}

		// metaContexts is the contexts a meta can annotate, read from the
		// type of its first parameter by the names `std.reflection` gives
		// them (`FieldMetaContext`): each branch of a union;
		// `DiscoveryMetaContext<T>` as T; `BuildMetaContext<D>` as the context
		// of what its descriptor describes (a `TypeDescriptor`'s a type's and
		// a component's). Empty for a function that is no meta, or whose
		// first parameter is not such a context, which the compiler rejects.
		def metaContexts(fn Symbol) string[] {
			let out string[]
			return out unless fn.isMeta
			let home = workspace.file(fn.file)
			return out when home is none
			let params = childOfKind(fn.node, SyntaxKind.Params)
			return out when params is none
			let first = childOfKind(params, SyntaxKind.Param)
			return out when first is none
			let written = writtenTypeOf(first)
			return out when written is none
			return [] unless collectContexts(home, written, out)
			return out
		}

		internal def collectContexts(home FileSymbols, typeNode SyntaxNode, out string[]) bool {
			if typeNode.kind() == SyntaxKind.UnionType {
				let ok = true
				for let (_, branch) in typeNode.children() {
					continue when branch.isToken()
					ok = false unless collectContexts(home, branch, out)
				}
				return ok
			}
			return false unless typeNode.kind() == SyntaxKind.NamedType
			let sym = typeSymbol(home, typeNode)
			return false when sym is none
			return false unless sym.path == reflectionModule + "." + sym.name
			let args = typeArgsOf(typeNode)
			switch sym.name {
				case "DiscoveryMetaContext":
					return false unless args.len() == 1
					return collectContexts(home, args[0], out)
				case "BuildMetaContext":
					return false unless args.len() == 1
					let descriptor = typeSymbol(home, args[0])
					return false when descriptor is none
					return false unless descriptor.path == reflectionModule + "." + descriptor.name
					switch descriptor.name {
						case "ConstDescriptor":
							addContext("ConstMetaContext", out)
						case "LetDescriptor":
							addContext("LetMetaContext", out)
						case "TypeDescriptor":
							// A type's build meta annotates a component too.
							addContext("TypeMetaContext", out)
							addContext("ComponentMetaContext", out)
						default:
							return false
					}
					return true
				default:
					return false unless isMetaContextName(sym.name)
					addContext(sym.name, out)
					return true
			}
		}

		internal def addContext(name string, out string[]) {
			out.push(name) unless out.includes(name)
		}

		// metaTargetContexts is the contexts of the declaration an annotation
		// stands on, as the compiler gives them: every declaration's
		// (`MetaContext`, `DeclarationMetaContext`) and its kind's; a method
		// is a function too, a struct or an enum a type, a field one whose
		// reads a meta can wrap, a `let` or `const` a variable, and a `let`
		// in a type, struct, component or service body a field as well.
		// Empty for a node that is no declaration.
		internal def metaTargetContexts(file FileSymbols, target SyntaxNode) string[] {
			let out = ["MetaContext", "DeclarationMetaContext"]
			switch target.kind() {
				case SyntaxKind.Application:
					out.push("ApplicationMetaContext")
				case SyntaxKind.Module:
					out.push("ModuleMetaContext")
				case SyntaxKind.Library:
					out.push("LibraryMetaContext")
				case SyntaxKind.Plugin:
					out.push("PluginMetaContext")
				case SyntaxKind.ServiceDecl:
					out.push("ServiceMetaContext")
				case SyntaxKind.ComponentDecl:
					out.push("ComponentMetaContext")
				case SyntaxKind.TypeDecl, SyntaxKind.UnionDecl, SyntaxKind.InterfaceDecl, SyntaxKind.DatatypeDecl, SyntaxKind.ViewDecl, SyntaxKind.StyleDecl:
					out.push("TypeMetaContext")
				case SyntaxKind.StructDecl:
					out.push("StructMetaContext")
					out.push("TypeMetaContext")
				case SyntaxKind.EnumDecl:
					out.push("EnumMetaContext")
					out.push("TypeMetaContext")
				case SyntaxKind.Check:
					out.push("CheckMetaContext")
				case SyntaxKind.Property:
					out.push("PropertyMetaContext")
				case SyntaxKind.Param:
					out.push("ParameterMetaContext")
				case SyntaxKind.FuncDecl:
					let declared = declarationOf(file, target)
					out.push("MethodMetaContext") when !(declared is none) && declared.kind == SymbolKind.Method
					out.push("FunctionMetaContext")
				case SyntaxKind.LetDecl:
					addVariableContexts(target, "LetMetaContext", out)
				case SyntaxKind.ConstDecl:
					addVariableContexts(target, "ConstMetaContext", out)
				case SyntaxKind.Field:
					// `@range(0, 1) let x = 0.5`: the annotation is the declaration's.
					let holder = target.parent
					if !(holder is none) && holder.kind() == SyntaxKind.LetDecl {
						addVariableContexts(holder, "LetMetaContext", out)
					} else if !(holder is none) && holder.kind() == SyntaxKind.ConstDecl {
						addVariableContexts(holder, "ConstMetaContext", out)
					} else {
						out.push("FieldMetaContext")
						out.push("FieldReadMetaContext")
					}
				case SyntaxKind.EnumMember, SyntaxKind.UnionMember:
				default:
					return []
			}
			return out
		}

		// addVariableContexts adds the contexts of a `let` or `const`
		// declaration: its own and a variable's, and a field's for a `let`
		// in a type, struct, component or service body.
		internal def addVariableContexts(decl SyntaxNode, own string, out string[]) {
			if own == "LetMetaContext" && isTypeMember(decl) {
				out.push("FieldMetaContext")
				out.push("FieldReadMetaContext")
			}
			out.push(own)
			out.push("VariableMetaContext")
		}

		// isTypeMember is true for a declaration in the body of a type,
		// struct, component or service.
		internal def isTypeMember(decl SyntaxNode) bool {
			let body = decl.parent
			return false when body is none
			let owner = body.parent
			return false when owner is none
			return owner.kind() := SyntaxKind.TypeDecl || SyntaxKind.StructDecl || SyntaxKind.ComponentDecl || SyntaxKind.ServiceDecl
		}

		// declarationOf is the symbol the file declares for a declaration
		// node, none for one without a path (a function inside a body).
		internal def declarationOf(file FileSymbols, node SyntaxNode) ?Symbol {
			for let (_, s) in file.declarations {
				return s when s.node.same(node)
			}
			return none
		}

		// metaConstraints is the types a meta's generic parameters ask of
		// what it annotates: a bound (`<T: Numeric>`), or a parameter that
		// names a type where the meta is declared (`trim<string>`,
		// `codec<ImageCodec>`); a union, and an alias of one, as each of its
		// branches besides. A parameter that names no type (`remote<I>`) and
		// a function type (`on<eventHandler>`, which the compiler checks
		// against the handler on its own) ask nothing.
		internal def metaConstraints(fn Symbol) MetaConstraint[] {
			let out MetaConstraint[]
			let home = workspace.file(fn.file)
			return out when home is none
			let params = childOfKind(fn.node, SyntaxKind.TypeParams)
			return out when params is none
			let around = enclosingScope(home, fn.node)
			for let (_, p) in params.children() {
				continue unless p.kind() == SyntaxKind.TypeParam
				let bound = boundOf(p)
				if !(bound is none) {
					addConstraints(home, bound, out, 0)
					continue
				}
				let nameToken = p.firstToken()
				continue when nameToken is none
				let name = nameToken.text()
				if primitiveTypeName(name).len() > 0 {
					out.push(MetaConstraint{primitive: name})
					continue
				}
				// Looked up around the meta: inside, the parameter names itself.
				let found = typeDeclaration(workspace.resolveType(home, around, name, fn.node.start()))
				continue when found is none || !isTypeLike(found.kind)
				let actual = followAlias(home, found, 0)
				continue when actual is none || isFunctionAlias(actual)
				addSymbolConstraint(home, actual, out, 0)
			}
			return out
		}

		// addConstraints adds what a written constraint type asks for.
		internal def addConstraints(home FileSymbols, bound SyntaxNode, out MetaConstraint[], depth int) {
			return when depth > 8
			if bound.kind() == SyntaxKind.UnionType {
				for let (_, branch) in bound.children() {
					addConstraints(home, branch, out, depth + 1) unless branch.isToken()
				}
				return
			}
			if bound.kind() == SyntaxKind.IntersectionType {
				out.push(MetaConstraint{allOf: intersectionGroups(home, bound, depth + 1)})
				return
			}
			let ref = TypeRef{file: home, node: bound, bindings: noBindings()}
			if bound.kind() == SyntaxKind.Name {
				// A type a cast names (`let next = int64(0)` is asked for again).
				if primitiveTypeName(bound.text()).len() > 0 {
					out.push(MetaConstraint{primitive: bound.text()})
					return
				}
				let named = typeSymbol(home, bound)
				addSymbolConstraint(home, named, out, depth) unless named is none
				return
			}
			if bound.kind() != SyntaxKind.NamedType {
				out.push(MetaConstraint{written: ref})
				return
			}
			let spelled = primitiveSpelling(ref)
			if spelled.len() > 0 {
				out.push(MetaConstraint{primitive: spelled})
				return
			}
			let sym = typeSymbol(home, bound)
			return when sym is none || isFunctionAlias(sym)
			addSymbolConstraint(home, sym, out, depth)
		}

		// addSymbolConstraint adds a declaration as a constraint, with the
		// branches of the union it is an alias of (`type Numeric = Integer |
		// Float` admits a `float`) or the parts of the intersection (`type
		// FontCodec = FontFormat & formats.FileFormat` admits what satisfies
		// both).
		internal def addSymbolConstraint(home FileSymbols, sym Symbol, out MetaConstraint[], depth int) {
			let aliased = sym.kind == SymbolKind.Type ?? (aliasTarget(sym.node), none)
			if !(aliased is none) && aliased.kind() == SyntaxKind.IntersectionType {
				out.push(MetaConstraint{symbol: sym, allOf: intersectionGroups(homeOf(sym, home), aliased, depth + 1)})
				return
			}
			out.push(MetaConstraint{symbol: sym})
			return when aliased is none
			addConstraints(homeOf(sym, home), aliased, out, depth + 1) when aliased.kind() == SyntaxKind.UnionType
		}

		// intersectionGroups is the constraints of each part of an
		// intersection type, a group per part.
		internal def intersectionGroups(home FileSymbols, intersection SyntaxNode, depth int) MetaConstraint[][] {
			let out MetaConstraint[][]
			for let (_, part) in intersection.children() {
				continue when part.isToken()
				let group MetaConstraint[]
				addConstraints(home, part, group, depth)
				out.push(group)
			}
			return out
		}

		// boundOf is the type after `:` in a type parameter, none without
		// one.
		internal def boundOf(param SyntaxNode) ?SyntaxNode {
			let seen = false
			for let (_, c) in param.children() {
				if c.isToken() {
					break when c.token() == TokenKind.Assign
					seen = true when c.token() == TokenKind.Colon
					continue
				}
				return c when seen && isTypeNode(c.kind())
			}
			return none
		}

		// enclosingScope is the scope a declaration stands in, outside the
		// one it opens.
		internal def enclosingScope(file FileSymbols, node SyntaxNode) Scope {
			let scope = file.scopeAt(node.start())
			return scope unless scope.node.same(node)
			let up = scope.parent
			return scope when up is none
			return up
		}

		// isFunctionAlias is true for `type eventHandler = def (Event)`.
		internal def isFunctionAlias(sym Symbol) bool {
			return false unless sym.kind == SymbolKind.Type
			let target = aliasTarget(sym.node)
			return false when target is none
			return target.kind() == SyntaxKind.FuncType
		}

		// constraintsAdmit is true when the meta's generic constraints admit
		// the target, as the compiler checks them: a parameter's written
		// type, or a type, struct, enum, interface or datatype itself, is one
		// of the constraint types or satisfies one of the interfaces or
		// datatypes among them. A type this layer cannot resolve, and any
		// other target, is admitted.
		internal def constraintsAdmit(file FileSymbols, fn Symbol, target SyntaxNode) bool {
			let wants = metaConstraints(fn)
			return true when wants.len() == 0
			switch target.kind() {
				case SyntaxKind.Param:
					let written = writtenTypeOf(target)
					return true when written is none
					return admitsWritten(TypeRef{file: file, node: written, bindings: noBindings()}, wants)
				case SyntaxKind.TypeDecl, SyntaxKind.StructDecl, SyntaxKind.EnumDecl, SyntaxKind.InterfaceDecl, SyntaxKind.DatatypeDecl:
					let declared = declarationOf(file, target)
					return true when declared is none
					return admitsDeclaration(file, declared, wants)
				default:
					return true
			}
		}

		// admitsWritten is true when a written type (a parameter's) is one
		// the constraints admit (`admits`).
		internal def admitsWritten(got TypeRef, wants MetaConstraint[]) bool {
			let spelled = primitiveSpelling(got)
			let sym ?Symbol = none
			if spelled.len() == 0 && got.node.kind() == SyntaxKind.NamedType {
				sym = typeSymbol(got.file, got.node)
				return true when sym is none
			}
			return admitsAny(spelled, sym, got, wants)
		}

		// admitsDeclaration is true when the constraints admit a type
		// declaration: an alias through its target, `type Name = string` as
		// the primitive.
		internal def admitsDeclaration(file FileSymbols, declared Symbol, wants MetaConstraint[]) bool {
			let actual = followAlias(file, declared, 0)
			return true when actual is none
			let spelled = ""
			let aliased = aliasTarget(declared.node)
			spelled = primitiveSpelling(TypeRef{file: homeOf(declared, file), node: aliased, bindings: noBindings()}) when !(aliased is none) && aliased.kind() == SyntaxKind.NamedType
			return admitsAny(spelled, actual, none, wants)
		}

		internal def admitsAny(spelled string, sym ?Symbol, written ?TypeRef, wants MetaConstraint[]) bool {
			for let (_, w) in wants {
				return true when admits(spelled, sym, written, w)
			}
			return false
		}

		// admits is true when a type, given by its primitive spelling, its
		// declaration and its written form, is one the constraint admits:
		// the same primitive; a declaration `admitsSymbol` takes; one that
		// every part of an intersection admits; the same written type
		// (`byte[]`).
		internal def admits(spelled string, sym ?Symbol, written ?TypeRef, want MetaConstraint) bool {
			return spelled == want.primitive when want.primitive.len() > 0
			return true when !(sym is none) && admitsSymbol(sym, want.symbol)
			if want.allOf.len() > 0 {
				for let (_, group) in want.allOf {
					return false unless admitsAny(spelled, sym, written, group)
				}
				return true
			}
			return false when written is none || want.written is none
			return sameWrittenType(written, want.written, 0)
		}

		// admitsSymbol is true when a value of type `got` can stand where the
		// constraint `want` is asked for: the same declaration, or one that
		// satisfies the interface or datatype.
		internal def admitsSymbol(got Symbol, want ?Symbol) bool {
			return false when want is none
			return true when sameDeclaration(got, want) || (got.path.len() > 0 && got.path == want.path)
			return satisfies(got, want)
		}
	}

	// reflectionModule declares the meta contexts.
	internal const reflectionModule = "std.reflection"

	// isMetaContextName is true for the name of a context type a meta's
	// first parameter can take (the compiler's table of them).
	internal def isMetaContextName(name string) bool {
		switch name {
			case "MetaContext", "DeclarationMetaContext", "ModuleMetaContext", "ApplicationMetaContext", "LibraryMetaContext", "PluginMetaContext", "ServiceMetaContext", "ComponentMetaContext", "TypeMetaContext", "StructMetaContext", "EnumMetaContext", "FunctionMetaContext", "MethodMetaContext", "PropertyMetaContext", "FieldMetaContext", "FieldReadMetaContext", "VariableMetaContext", "ConstMetaContext", "LetMetaContext", "ParameterMetaContext", "CheckMetaContext":
				return true
			default:
				return false
		}
	}
}
