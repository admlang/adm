partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	internal def reflectionSource() string {
		return fixture("""
module std.reflection «
	type MetaContext «»
	type DeclarationMetaContext «»
	type FunctionMetaContext «»
	type MethodMetaContext «»
	type FieldMetaContext «»
	type FieldReadMetaContext «»
	type VariableMetaContext «»
	type LetMetaContext «»
	type ConstMetaContext «»
	type ParameterMetaContext «»
	type TypeMetaContext «»
	type StructMetaContext «»
	type ComponentMetaContext «»
	type DiscoveryMetaContext<T> «»
	type BuildMetaContext<T> «»
	type ConstDescriptor «»
	type TypeDescriptor «»
»
""")
	}

	internal def metaPreludeSource() string {
		return fixture("""
partial module builtin «
	use std.reflection::*
	type string «»
	type Signed = int | int8
	type Float = float | float32
	type Numeric = Signed | Float
	internal type eventHandler = def (int)
	meta def cfg(target DeclarationMetaContext, os string = "") «»
	meta def commit(target MethodMetaContext) «»
	meta def on<eventHandler>(target FunctionMetaContext, source any) «»
	meta def on<eventHandler>(target MethodMetaContext, source any) «»
	meta def trim<string>(target ParameterMetaContext) «»
	meta def range<T: Numeric>(target FieldMetaContext | ParameterMetaContext, low T, high T) «»
	meta def embed<T: byte[]>(target ParameterMetaContext | ConstMetaContext, path string) «»
	meta def env(target VariableMetaContext, name string) «»
	meta def env(target LetMetaContext, name string, fallback string) «»
	meta def generated(target BuildMetaContext<TypeDescriptor>) «»
	meta def broken(target string) «»
	def helper() «»
»
""")
	}

	internal def metaLibSource() string {
		return fixture("""
module codecs «
	use std.reflection::(DiscoveryMetaContext, TypeMetaContext)
	interface Codec «
		def decode(data string) string
	»
	datatype Info «
		extension string[]
	»
	interface Closer «
		def close() !none
	»
	type Full = Codec & Info
	meta def codec<Codec>(ctx DiscoveryMetaContext<TypeMetaContext>, name string) «»
	meta def format<Full>(ctx DiscoveryMetaContext<TypeMetaContext>) «»
	meta def closing<Closer>(ctx DiscoveryMetaContext<TypeMetaContext>) «»
	meta def remote<I>(ctx DiscoveryMetaContext<TypeMetaContext>) «»
	internal meta def hidden(ctx DiscoveryMetaContext<TypeMetaContext>) «»
»
""")
	}

	internal def metaTestingSource() string {
		return fixture("""
module std.testing «
	use std.reflection
	meta def test(target reflection.FunctionMetaContext) «»
»
""")
	}

	internal def metaAppSource() string {
		return fixture("""
module app «
	use std.testing
	use codecs
	use std.testing::(test as spec)

	@te
	def plain() «»

	type Service «
		@
		def run() «»
		@
		count int
		@
		let cache = 0
		def test() «»
		@spec
		def other() «»
		def spec() «»
	»

	@
	type Png «
		extension string[]
		def decode(data string) string « return data »
		def close() !none «»
	»

	@
	type Other «»

	def call(@tr name string, @ra count int, @em data byte[], @ra maybe ?float) «»

	@
	let total = 1
	@
	const limit = 2
	@codecs.
	type Jpeg «
		def decode(data string) string « return data »
	»
	@std.testing.
	def nested() «»
	@xs
»
""")
	}

	check "Annotations" {
		@test()
		def TestAnnotationCompletions() {
			let w = new Workspace()
			w.add("reflection.adm", parse(reflectionSource()))
			w.add("builtin.adm", parse(metaPreludeSource()))
			w.add("codecs.adm", parse(metaLibSource()))
			w.add("testing.adm", parse(metaTestingSource()))
			let source = metaAppSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			// A type name looked up from a scope outwards.
			let moduleScope = app.scopeAt(source.indexOf("@te"))
			assert pathsOf(w.resolveType(app, moduleScope, "Png", 0)) == "app.Png" && w.resolveType(app, moduleScope, "count", 0).len() == 0
			// Only `meta def`s are metas; their kind stays Function.
			let cfg = w.lookup("builtin", "cfg")[0]
			assert cfg.isMeta && cfg.kind == SymbolKind.Function && !w.lookup("builtin", "helper")[0].isMeta
			assert nav.metaContexts(cfg).join(",") == "DeclarationMetaContext"
			assert nav.metaContexts(w.lookup("builtin", "range")[0]).join(",") == "FieldMetaContext,ParameterMetaContext"
			assert nav.metaContexts(w.lookup("codecs", "codec")[0]).join(",") == "TypeMetaContext"
			assert nav.metaContexts(w.lookup("builtin", "generated")[0]).join(",") == "TypeMetaContext,ComponentMetaContext"
			assert nav.metaContexts(w.lookup("builtin", "broken")[0]).len() == 0
			assert nav.metaContexts(w.lookup("builtin", "helper")[0]).len() == 0
			// A function: its metas and every declaration's.
			assert namesOf(nav.completionsAt(app, source.indexOf("@te") + 3)) == "spec,test,cfg,on"
			assert namesOf(nav.completionsAt(app, source.indexOf("@te") + 1)) == "spec,test,cfg,on"
			// A method, past the method `test` that is no meta; `on` is its
			// overload for methods.
			let onMethod = nav.completionsAt(app, source.indexOf("@\n\t\tdef run") + 1)
			assert namesOf(onMethod) == "spec,test,cfg,commit,on"
			assert nav.metaContexts(onMethod[4]).join(",") == "MethodMetaContext"
			assert pathsOf(nav.annotationAt(app, "test", source.indexOf("@\n\t\tdef run") + 1)) == "std.testing.test"
			// Past the method `spec` to the meta a named import binds.
			assert pathsOf(nav.annotationAt(app, "spec", source.indexOf("@spec") + 1)) == "std.testing.test"
			assert pathsOf(nav.definitionAt(app, source.indexOf("@spec") + 1)) == "std.testing.test"
			let renamed = nav.completionsAt(app, source.indexOf("@spec") + 5)
			assert renamed[0].name == "spec" && renamed[0].kind == SymbolKind.Import && renamed[1].isMeta
			// A field, a `let` in a type body (a field and a variable, `env`
			// for a `let` first), a module `let` and a `const`.
			assert namesOf(nav.completionsAt(app, source.indexOf("@\n\t\tcount") + 1)) == "cfg,range"
			let cache = nav.completionsAt(app, source.indexOf("@\n\t\tlet cache") + 1)
			assert namesOf(cache) == "cfg,range,env"
			assert nav.metaContexts(cache[2]).join(",") == "LetMetaContext"
			assert namesOf(nav.completionsAt(app, source.indexOf("@\n\tlet total") + 1)) == "cfg,env"
			let limit = nav.completionsAt(app, source.indexOf("@\n\tconst limit") + 1)
			assert namesOf(limit) == "cfg,embed,env" && nav.metaContexts(limit[2]).join(",") == "VariableMetaContext"
			// Types: `codec` only on one that implements Codec, `format` on one
			// that also has Info's fields, `closing` on one with `close() !none`;
			// `remote` asks nothing of its `I`.
			assert namesOf(nav.completionsAt(app, source.indexOf("@\n\ttype Png") + 1)) == "codec,format,closing,remote,cfg,generated"
			assert namesOf(nav.completionsAt(app, source.indexOf("@\n\ttype Other") + 1)) == "remote,cfg,generated"
			// Parameters by their types: `trim` on a string, `range` on a
			// number, `embed` on `byte[]`, none of them on an optional.
			assert namesOf(nav.completionsAt(app, source.indexOf("@tr") + 3)) == "cfg,trim"
			assert namesOf(nav.completionsAt(app, source.indexOf("@ra count") + 3)) == "cfg,range"
			assert namesOf(nav.completionsAt(app, source.indexOf("@em") + 3)) == "cfg,embed"
			assert namesOf(nav.completionsAt(app, source.indexOf("@ra maybe") + 3)) == "cfg"
			// After a module's name, that module's metas; a longer path names
			// none; on no declaration, every meta.
			assert namesOf(nav.completionsAt(app, source.indexOf("@codecs.") + 8)) == "codec,remote"
			assert nav.completionsAt(app, source.indexOf("@std.testing.") + 13).len() == 0
			assert namesOf(nav.completionsAt(app, source.indexOf("@xs") + 3)) == "spec,test,codec,format,closing,remote,cfg,commit,on,trim,range,embed,env,generated"
			// Not an annotation's name: the usual completions in a body, nothing
			// where a name is being declared.
			assert namesOf(nav.completionsAt(app, source.indexOf("def plain") + 13)).contains("helper")
			assert nav.completionsAt(app, source.indexOf("def plain") + 5).len() == 0
		}
	}
}
