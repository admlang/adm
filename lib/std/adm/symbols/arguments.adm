partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// namedArgument is the parameter a named argument names: the name
		// token before `=` (or `:`) in `f(width = 2)`, `new Box(width = 2)`,
		// `box.grow(by = 2)` or a component call `Row(text = t)`. None for
		// another token, or when the callee is unknown.
		def namedArgument(file FileSymbols, token SyntaxNode) ?Symbol {
			return none unless isNamedArgumentName(token)
			let arg = token.parent
			return none when arg is none
			let args = arg.parent
			return none when args is none
			let owner = args.parent
			return none when owner is none
			let name = token.text()
			switch owner.kind() {
				case SyntaxKind.Call:
					let callee = owner.child(0)
					return none when callee is none
					// Every overload: `str()` and `str(format, offset)` are one name.
					for let (_, fn) in calleeOverloads(file, callee) {
						if fn.kind == SymbolKind.Function || fn.kind == SymbolKind.Method {
							let param = parameterNamed(file, fn, name)
							return param unless param is none
							continue
						}
						return constructorArgument(file, fn, name) when isTypeLike(fn.kind)
					}
					return none
				case SyntaxKind.New:
					let made = typeOfDepth(file, owner, 1)
					return none when made is none
					return constructorArgument(file, made, name)
				case SyntaxKind.ComponentCall:
					let callee = owner.child(0)
					return none when callee is none
					let comp = symbolOfDepth(file, callee, 0)
					return none when comp is none
					return first(membersNamed(file, comp, name))
				default:
					return none
			}
		}

		// calleeOverloads is every declaration a callee may call: the
		// overloads of a name in scope, or of a member of the receiver's
		// type or module.
		internal def calleeOverloads(file FileSymbols, callee SyntaxNode) Symbol[] {
			if callee.kind() == SyntaxKind.Name {
				let t = callee.firstToken()
				return [] when t is none
				let found = workspace.resolve(file, t.text(), t.start())
				return found when found.len() > 0
				return oneOf(primitiveSymbol(t.text()))
			}
			return [] unless callee.kind() == SyntaxKind.Member
			return memberTargets(file, callee, 0)
		}

		// isNamedArgumentName is true for the name token of a named argument:
		// the first child of an Arg, followed by `=` or `:`.
		internal def isNamedArgumentName(token SyntaxNode) bool {
			return false unless token.isToken() && token.token() == TokenKind.Ident
			let arg = token.parent
			return false when arg is none
			return false unless arg.kind() == SyntaxKind.Arg && token.index == 0
			let sep = token.nextSibling()
			return false when sep is none
			return sep.isToken() && (sep.token() == TokenKind.Assign || sep.token() == TokenKind.Colon)
		}

		// constructorArgument is what a named argument of a construction
		// names: a parameter of the type's `new`, else a field of the type
		// (a struct is made from its fields).
		internal def constructorArgument(file FileSymbols, made Symbol, name string) ?Symbol {
			for let (_, ctor) in membersNamed(file, made, "new") {
				let param = parameterNamed(file, ctor, name)
				return param unless param is none
			}
			return first(membersNamed(file, made, name))
		}

		// parameterNamed is the parameter of a function or method with the
		// name, as the declaring file knows it.
		internal def parameterNamed(file FileSymbols, fn Symbol, name string) ?Symbol {
			let home = homeOf(fn, file)
			for let (_, t) in parameterNames(fn.node) {
				continue unless t.text() == name
				return home.symbolAt(t.start())
			}
			return none
		}

		// parameterAt is the parameter of a function or method at the
		// position, the last one for a position past the end (a variadic
		// takes the rest).
		internal def parameterAt(file FileSymbols, fn Symbol, position int) ?Symbol {
			let home = homeOf(fn, file)
			let names = parameterNames(fn.node)
			return none when names.len() == 0
			let at = position < names.len() ?? (position, names.len() - 1)
			return home.symbolAt(names[at].start())
		}

		// parameterNames is the name tokens of a function's parameters, in
		// order (`a, b int` declares two).
		internal def parameterNames(fn SyntaxNode) SyntaxNode[] {
			let out SyntaxNode[]
			let params = childOfKind(fn, SyntaxKind.Params)
			return out when params is none
			for let (_, p) in params.children() {
				continue unless p.kind() == SyntaxKind.Param
				for let (_, c) in p.children() {
					break unless c.isToken()
					let k = c.token()
					continue when k == TokenKind.Comma
					break unless k == TokenKind.Ident
					out.push(c)
				}
			}
			return out
		}

		// structKey is the field a struct literal's key names: `x` in
		// `Point{x: 1}`, or in `{x: 1}` where the literal's type is known
		// from its place (a typed `let`, an argument, a return). None for
		// another token or an unknown type.
		def structKey(file FileSymbols, token SyntaxNode) ?Symbol {
			return none unless isStructKeyName(token)
			let name = token.parent
			return none when name is none
			let init = name.parent
			return none when init is none
			let literal = init.parent
			return none when literal is none
			let made = typeRefSymbol(structLiteralRef(file, literal, 0))
			return none when made is none
			return first(membersNamed(file, made, token.text()))
		}

		// isMapLiteralKey is true for a key of a `map<K, V>{key: value}`
		// literal, which is an expression (a name in scope), not a field.
		def isMapLiteralKey(file FileSymbols, token SyntaxNode) bool {
			return false unless isStructKeyName(token)
			let name = token.parent
			return false when name is none
			let init = name.parent
			return false when init is none
			let literal = init.parent
			return false when literal is none
			let head = literal.child(0)
			return false when head is none
			return false unless head.kind() == SyntaxKind.NamedType
			let made = typeSymbol(file, head)
			return false when made is none
			return made.path == "builtin.map"
		}

		// isStructKeyName is true for the key token of a struct literal's
		// `key: value`: the token of a Name that is the first child of a
		// FieldInit and is followed by `:`.
		internal def isStructKeyName(token SyntaxNode) bool {
			return false unless token.isToken() && isNameToken(token.token())
			let name = token.parent
			return false when name is none
			return false unless name.kind() == SyntaxKind.Name && name.index == 0
			let init = name.parent
			return false when init is none
			return false unless init.kind() == SyntaxKind.FieldInit
			let sep = name.nextSibling()
			return false when sep is none
			return sep.isToken() && sep.token() == TokenKind.Colon
		}

		// structLiteralRef is the type of a struct literal: the type it is
		// written with (`Point{...}`), else the type its place asks for.
		internal def structLiteralRef(file FileSymbols, literal SyntaxNode, depth int) ?TypeRef {
			let head = literal.child(0)
			return none when head is none
			return TypeRef{file: file, node: head, bindings: noBindings()} when isTypeNode(head.kind())
			return contextRef(file, literal, depth + 1)
		}

		// contextRef is the type the place of an expression asks for: the
		// written type of the `let`, field or parameter it initializes, the
		// parameter it is passed as, the field it is the value of in a struct
		// literal, the return type of the function it is returned from, the
		// element type of the array literal it is an element of. None where
		// nothing is written.
		internal def contextRef(file FileSymbols, expr SyntaxNode, depth int) ?TypeRef {
			return none when depth > maxDepth
			let parent = expr.parent
			return none when parent is none
			switch parent.kind() {
				case SyntaxKind.Field, SyntaxKind.Param:
					let written = writtenTypeOf(parent)
					return none when written is none
					return TypeRef{file: file, node: written, bindings: noBindings()}
				case SyntaxKind.Arg:
					return argumentRef(file, parent, depth)
				case SyntaxKind.FieldInit:
					let keyNode = parent.child(0)
					return none when keyNode is none
					return none when keyNode.same(expr)
					let keyToken = keyNode.firstToken()
					return none when keyToken is none
					let field = structKey(file, keyToken)
					return none when field is none
					let literal = parent.parent
					return none when literal is none
					return memberTypeRef(file, structLiteralRef(file, literal, depth + 1), field)
				case SyntaxKind.Return:
					let fn = parent.ancestor(SyntaxKind.FuncDecl)
					return none when fn is none
					let written = returnTypeOf(fn)
					return none when written is none
					return TypeRef{file: file, node: written, bindings: noBindings()}
				case SyntaxKind.Assign:
					let target = parent.child(0)
					return none when target is none
					return none when target.same(expr)
					return typeRefOfDepth(file, target, depth + 1)
				case SyntaxKind.ArrayLit:
					return elementRef(contextRef(file, parent, depth + 1))
				case SyntaxKind.Paren:
					return contextRef(file, parent, depth + 1)
				default:
					return none
			}
		}

		// argumentRef is the type the parameter an argument is passed as is
		// written with: by name for `name = value`, by position otherwise.
		internal def argumentRef(file FileSymbols, arg SyntaxNode, depth int) ?TypeRef {
			let nameToken = arg.child(0)
			return none when nameToken is none
			if isNamedArgumentName(nameToken) {
				let param = namedArgument(file, nameToken)
				return none when param is none
				return memberTypeRef(file, none, param)
			}
			let args = arg.parent
			return none when args is none
			let owner = args.parent
			return none when owner is none
			let fn = calledFunction(file, owner, depth)
			return none when fn is none
			let param = parameterAt(file, fn, arg.index - 1)
			return none when param is none
			return memberTypeRef(file, none, param)
		}

		// calledFunction is the function, method or constructor a Call or New
		// node calls.
		internal def calledFunction(file FileSymbols, owner SyntaxNode, depth int) ?Symbol {
			if owner.kind() == SyntaxKind.New {
				let made = typeOfDepth(file, owner, depth + 1)
				return none when made is none
				return first(membersNamed(file, made, "new"))
			}
			return none unless owner.kind() == SyntaxKind.Call
			let callee = owner.child(0)
			return none when callee is none
			let fn = calleeSymbol(file, callee, depth)
			return none when fn is none
			return fn when fn.kind == SymbolKind.Function || fn.kind == SymbolKind.Method
			return none
		}
	}
}
