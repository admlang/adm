partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// TypeProblem is a type error or warning the IDE can mark: the
	// expression or statement the compiler reports it at, the compiler's
	// code for it (`E-TYPE-0096`; a warning's starts with `W-`, as
	// `W-TYPE-0002`) and its message.
	struct TypeProblem {
		node    SyntaxNode
		code    string
		message string
	}

	// Fit is how a value of one type goes where another is asked for.
	internal enum Fit {
		// It goes there.
		Fits,
		// This layer cannot tell: never reported.
		Unsure,
		// It does not (`E-TYPE-0096`).
		Mismatch,
		// An optional of the type asked for (`E-TYPE-0094`).
		Optional,
		// An errorable of the type asked for (`E-TYPE-0093`).
		Errorable,
		// A future of the type asked for (`E-ASYNC-0010`).
		Async,
		// A call of a function that returns nothing (`W-TYPE-0002`, a warning).
		NoValue
	}

	partial type Navigator {
		// Whether a function yields, by its node, for one `typeProblems`
		// query: every `return` asks it of its function.
		internal generators map<SyntaxNode, bool>

		// typeProblems is the type errors of the part of the file from
		// `start` to `end` that this layer is certain of, each with the
		// compiler's code: a value of another type in a typed `let`, `const`
		// or field, an assignment, a `return` or a struct literal's field; a
		// `return` without the value its function asks for, or with one its
		// function has no result for; a call no overload of its function
		// takes; a call of a value that is not a function; a result that may
		// be an error and is dropped; and, as a warning, a call of a function
		// that returns nothing used as a value. A rule that meets a type this
		// layer cannot tell reports nothing. In source order.
		def typeProblems(file FileSymbols, start int, end int) TypeProblem[] {
			freshQuery()
			let out TypeProblem[]
			collectProblems(file, file.tree.root(), start, end, out)
			out.sort((a TypeProblem, b TypeProblem) => a.node.start() < b.node.start())
			return out
		}

		// collectProblems adds the problems of the node and of the nodes
		// below it that overlap the range. View and style bodies are left
		// out: their names and values are the UI compiler's.
		internal def collectProblems(file FileSymbols, node SyntaxNode, start int, end int, out TypeProblem[]) {
			switch node.kind() {
				case SyntaxKind.ViewDecl, SyntaxKind.StyleDecl, SyntaxKind.ViewExpr:
					return
				case SyntaxKind.Field:
					initializerProblems(file, node, out)
				case SyntaxKind.ExprStmt:
					statementProblems(file, node, out)
				case SyntaxKind.Return:
					returnProblems(file, node, out)
				case SyntaxKind.StructLit:
					structLiteralProblems(file, node, out)
				case SyntaxKind.Call:
					callProblems(file, node, out)
				default:
			}
			// Walked by kind, a node made only for a child that may hold a
			// problem: a table's literals make none.
			let count = node.childCount()
			for let i = 0; i < count; i++ {
				let kind = node.childKind(i)
				continue when kind == SyntaxKind.Token || kind == SyntaxKind.Literal
				let c = node.child(i)
				continue when c is none
				continue when c.fullEnd() < start || c.fullStart() >= end
				collectProblems(file, c, start, end, out)
			}
		}

		// initializerProblems checks the value of a `let`, `const` or field
		// written with a type (`let n int = "x"`), each name against its
		// value (the checker's `initialize` context).
		internal def initializerProblems(file FileSymbols, field SyntaxNode, out TypeProblem[]) {
			let written ?SyntaxNode = none
			let names SyntaxNode[]
			let values SyntaxNode[]
			let seen = false
			for let (_, c) in field.children() {
				if c.isToken() {
					names.push(c) when !seen && c.token() == TokenKind.Ident && written is none
					seen = true when isAssignmentToken(c.token())
					continue
				}
				// `let (a, b) = pair` destructures: the tuple's rule.
				return when c.kind() == SyntaxKind.Destructure
				if seen {
					values.push(c)
				} else if isTypeNode(c.kind()) && written is none {
					written = c
				}
			}
			let typeNode = written
			return when values.len() == 0
			if typeNode is none {
				// `let y = log("a")`: an untyped name takes no value from a call
				// that returns nothing either (it holds none).
				return unless values.len() == 1 || values.len() == names.len()
				for let (i, name) in names {
					let value = values.len() == 1 ?? (values[0], values[i])
					// `let _ = log("a")` discards, which a call of nothing allows.
					continue when name.text() == "_"
					out.push(TypeProblem{node: value, code: "W-TYPE-0002", message: "initialize {name.text()}: the call returns nothing, so it gives no value"}) when resultlessCall(file, value) == Fit.NoValue
				}
				return
			}
			// `let a, b int = 1, 2` pairs names and values; `let a, b int = 0`
			// gives both the one value.
			return unless values.len() == 1 || values.len() == names.len()
			let wanted = writtenType(file, typeNode)
			for let (i, name) in names {
				let value = values.len() == 1 ?? (values[0], values[i])
				continue when name.text() == "_" && resultlessCall(file, value) == Fit.NoValue
				checkFit(file, wanted, value, value, "initialize " + name.text(), out)
			}
		}

		// statementProblems checks an expression statement: an assignment's
		// value against what it writes to, and a result that may be an error
		// dropped (`E-TYPE-0027`).
		internal def statementProblems(file FileSymbols, stmt SyntaxNode, out TypeProblem[]) {
			let expr = firstNonToken(stmt)
			return when expr is none
			if expr.kind() == SyntaxKind.Assign {
				assignmentProblems(file, expr, out)
				return
			}
			droppedErrorProblems(file, expr, out)
		}

		// assignmentProblems checks `target = value` against the target's
		// declared type. A compound assignment is an operator's rule, an
		// element (`a[i] = v`) and `_` are left alone.
		internal def assignmentProblems(file FileSymbols, assign SyntaxNode, out TypeProblem[]) {
			let kids = assign.children()
			return when kids.len() < 3
			let target = kids[0]
			let op = kids[1]
			let value = kids[kids.len() - 1]
			return unless op.isToken() && op.token() == TokenKind.Assign
			return unless target.kind() == SyntaxKind.Name || target.kind() == SyntaxKind.Member
			return when target.text() == "_"
			// A name only: a property's setter may take another type than its
			// getter gives, and the member's own symbol says which.
			let wanted = exprType(file, target, 0)
			checkFit(file, wanted, value, assign, "assignment", out)
		}

		// droppedErrorProblems reports an expression statement whose value
		// may be an error (the checker's `checkDroppedError`): neither tried,
		// nor handled with `onerror`, nor started with `async`.
		internal def droppedErrorProblems(file FileSymbols, expr SyntaxNode, out TypeProblem[]) {
			let inner = unparenthesized(expr)
			return unless inner.kind() == SyntaxKind.Call
			return unless certainlyErrorable(file, inner)
			out.push(TypeProblem{node: expr, code: "E-TYPE-0027", message: "the result may be an error and is dropped; use try, handle it with onerror, or discard it with _ ="})
		}

		// certainlyErrorable is true for a call whose result is `!T` whichever
		// of its function's overloads it calls.
		internal def certainlyErrorable(file FileSymbols, call SyntaxNode) bool {
			return false unless childOfKind(call, SyntaxKind.OnError) is none
			let t = exprType(file, call, 0)
			return false unless t.kind == TypeKind.Fallible
			let target = callTarget(file, call, 0)
			return false when target is none
			for let (_, fn) in callCandidates(file, call) {
				continue unless acceptsArguments(fn, call)
				let r = returnTypeOf(fn.node)
				return false when r is none
				return false unless writtenType(homeOf(fn, file), r).kind == TypeKind.Fallible
			}
			return true
		}

		// returnProblems checks a `return` against the result its function
		// is written with: a value of another type (the checker's `return`
		// context), no value where one is asked for (`E-TYPE-0174`), a value
		// where the function has no result (`E-TYPE-0175`). A lambda, a
		// generator and a function without a name (whose result may be
		// inferred) are left alone.
		internal def returnProblems(file FileSymbols, ret SyntaxNode, out TypeProblem[]) {
			let first = ret.firstToken()
			return unless !(first is none) && first.token() == TokenKind.Return
			let lambda = enclosingLambda(ret)
			if !(lambda is none) {
				lambdaReturnProblems(file, lambda, ret, out)
				return
			}
			let fn = enclosingFunction(ret)
			return when fn is none
			return when isGenerator(fn)
			let value = firstNonToken(ret)
			let written = returnTypeOf(fn)
			if written is none {
				return when value is none
				// A constructor, a view and a property's accessors have results
				// of their own.
				return unless isPlainFunction(fn)
				out.push(TypeProblem{node: value, code: "E-TYPE-0175", message: "function has no return value"})
				return
			}
			let wanted = writtenType(file, written)
			return when wanted.isUnknown()
			if value is none {
				// `none` and `!none` end with a bare return; an `async def`
				// returns what it is written with, as a future.
				let p = plain(wanted)
				return when isPrimitiveNamed(p, "none")
				return when p.kind == TypeKind.Fallible && isPrimitiveNamed(plain(p.args[0]), "none")
				let shown = isAsyncDecl(fn) ?? (table().wrapType(TypeKind.Async, wanted).str(), wanted.str())
				out.push(TypeProblem{node: ret, code: "E-TYPE-0174", message: "return needs a value: the function returns " + shown})
				return
			}
			checkFit(file, wanted, value, value, "return", out)
		}

		// lambdaReturnProblems checks a `return` in a lambda's statement body
		// against the result its place asks for (`lambdaResultAsked`): a
		// value where nothing is asked (`E-TYPE-0175`), none where a value
		// is (`E-TYPE-0174`), a value of another type (the `return`
		// context). A place this layer cannot tell reports nothing.
		internal def lambdaReturnProblems(file FileSymbols, lambda SyntaxNode, ret SyntaxNode, out TypeProblem[]) {
			let asked = lambdaResultAsked(file, lambda, 0)
			return when asked is none
			let wanted = asked
			let value = firstNonToken(ret)
			if isPrimitiveNamed(plain(wanted), "none") {
				out.push(TypeProblem{node: value, code: "E-TYPE-0175", message: "function has no return value"}) unless value is none
				return
			}
			if value is none {
				out.push(TypeProblem{node: ret, code: "E-TYPE-0174", message: "return needs a value: the function returns " + wanted.str()})
				return
			}
			checkFit(file, wanted, value, value, "return", out)
		}

		// enclosingLambda is the lambda a statement is in, when one stands
		// nearer than any `def`.
		internal def enclosingLambda(n SyntaxNode) ?SyntaxNode {
			let up = n.parent
			for {
				let current = up
				return none when current is none
				switch current.kind() {
					case SyntaxKind.Lambda:
						return current
					case SyntaxKind.FuncDecl, SyntaxKind.ViewDecl, SyntaxKind.StyleDecl, SyntaxKind.ViewExpr, SyntaxKind.Property:
						return none
					default:
				}
				up = current.parent
			}
			return none
		}

		// enclosingFunction is the named or anonymous `def` a statement is in;
		// none inside a lambda or outside a function.
		internal def enclosingFunction(n SyntaxNode) ?SyntaxNode {
			let up = n.parent
			for {
				let current = up
				return none when current is none
				switch current.kind() {
					case SyntaxKind.FuncDecl:
						return current
					case SyntaxKind.Lambda, SyntaxKind.ViewDecl, SyntaxKind.StyleDecl, SyntaxKind.ViewExpr, SyntaxKind.Property:
						return none
					default:
				}
				up = current.parent
			}
			return none
		}

		// isPlainFunction is true for a named function or method other than a
		// constructor or `dispose`.
		internal def isPlainFunction(fn SyntaxNode) bool {
			for let (_, c) in fn.children() {
				continue unless c.isToken()
				return !(c.text() := "new" || "dispose") when c.token() == TokenKind.Ident
				break when c.token() == TokenKind.LParen
			}
			return false
		}

		// isGenerator is true for a function whose body yields, outside the
		// functions and lambdas inside it.
		internal def isGenerator(fn SyntaxNode) bool {
			let known = generators.get(fn)
			return known unless known is none
			let body = childOfKind(fn, SyntaxKind.Block)
			let found = !(body is none) && yields(body)
			generators[fn] = found
			return found
		}

		// yields walks the children by kind, a node made only for one that
		// may hold a `yield`.
		internal def yields(n SyntaxNode) bool {
			let count = n.childCount()
			for let i = 0; i < count; i++ {
				let kind = n.childKind(i)
				continue when kind == SyntaxKind.Token || kind == SyntaxKind.Lambda || kind == SyntaxKind.FuncDecl
				return true when kind == SyntaxKind.Yield
				let c = n.child(i)
				return true when !(c is none) && yields(c)
			}
			return false
		}

		// structLiteralProblems checks each field value of a literal written
		// with its type (`Point{x: "no"}`) against the field's type
		// (`E-TYPE-0201`).
		internal def structLiteralProblems(file FileSymbols, literal SyntaxNode, out TypeProblem[]) {
			let head = literal.child(0)
			return when head is none || !isTypeNode(head.kind())
			let made = writtenType(file, head)
			return unless plain(made).kind == TypeKind.Named
			let decl = declarationOf(plain(made))
			return when decl is none
			return unless decl.kind == SymbolKind.Struct || decl.kind == SymbolKind.Type
			for let (_, init) in literal.children() {
				continue unless init.kind() == SyntaxKind.FieldInit
				let key = init.child(0)
				continue when key is none || key.kind() != SyntaxKind.Name
				let keyToken = key.firstToken()
				continue when keyToken is none
				let value = lastNonToken(init)
				continue when value is none || value.same(key)
				let field = structKey(file, keyToken)
				continue when field is none
				continue unless field.kind == SymbolKind.Field
				continue when declaredType(field) is none
				let wanted = instanceType(file, plain(made), field, valueTypeOf(file, field, 0), 0)
				let fit = fitOf(file, wanted, value)
				continue unless fit == Fit.Mismatch || fit == Fit.Optional || fit == Fit.Errorable || fit == Fit.Async
				let given = givenType(file, wanted, value)
				out.push(TypeProblem{node: value, code: "E-TYPE-0201", message: "cannot assign {given.str()} to field \"{keyToken.text()}\" of type {wanted.str()}"})
			}
		}

		// checkFit reports the value when its type certainly does not go
		// where `wanted` is asked for, with the checker's code and message
		// for the context (`initialize n`, `assignment`, `return`).
		internal def checkFit(file FileSymbols, wanted Type, value SyntaxNode, at SyntaxNode, context string, out TypeProblem[]) {
			let fit = fitOf(file, wanted, value)
			return when fit == Fit.Fits || fit == Fit.Unsure
			let given = givenType(file, wanted, value)
			switch fit {
				case Fit.NoValue:
					out.push(TypeProblem{node: value, code: "W-TYPE-0002", message: "{context}: the call returns nothing, so it gives no value"})
				case Fit.Optional:
					out.push(TypeProblem{node: at, code: "E-TYPE-0094", message: "{context}: optional value {given.str()} requires explicit none handling"})
				case Fit.Errorable:
					out.push(TypeProblem{node: at, code: "E-TYPE-0093", message: "{context}: use try to unwrap {given.str()}"})
				case Fit.Async:
					out.push(TypeProblem{node: at, code: "E-ASYNC-0010", message: "{context}: await async {given.args[0].str()} to use {given.str()}"})
				default:
					out.push(TypeProblem{node: at, code: "E-TYPE-0096", message: "{context} type mismatch: got {given.str()}, want {wanted.str()}"})
			}
		}

		// givenType is the type of a value as the place that asks for
		// `wanted` sees it: a numeric literal takes the number asked for.
		internal def givenType(file FileSymbols, wanted Type, value SyntaxNode) Type {
			return adoptLiteral(value, exprType(file, value, 0), bare(wanted))
		}

		// fitOf is how the value goes where `wanted` is asked for. A value
		// typed by its place (`{...}`, `[...]`, a lambda, `cond ?? (a, b)`, a
		// tuple, `new(...)`) takes the type asked for.
		internal def fitOf(file FileSymbols, wanted Type, value SyntaxNode) Fit {
			return Fit.Unsure when typedByItsPlace(value)
			let nothing = resultlessCall(file, value)
			return nothing unless nothing == Fit.Fits
			// A type named as a value (`spec: PathSpec` of a `Permission`) is
			// the checker's own case.
			return Fit.Unsure unless staticSymbol(file, unparenthesized(value)) is none
			return Fit.Unsure when overloadByPlace(file, value)
			return fitness(wanted, givenType(file, wanted, value), true)
		}

		// overloadByPlace is true for a call (or its `try`, `await`) whose
		// function has overloads and whose arguments include one typed by
		// its place: which overload it calls, so its result, is the
		// checker's choice (`getNext([oid])` beside `getNext(oid)`).
		internal def overloadByPlace(file FileSymbols, value SyntaxNode) bool {
			let current = unparenthesized(value)
			for current.kind() == SyntaxKind.Try || current.kind() == SyntaxKind.Await {
				let inner = firstNonToken(current)
				return false when inner is none
				current = unparenthesized(inner)
			}
			return false unless current.kind() == SyntaxKind.Call
			let args = childOfKind(current, SyntaxKind.Args)
			let callee = current.child(0)
			return false when args is none || callee is none
			let placed = false
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				let v = lastNonToken(arg)
				placed = true when !(v is none) && typedByItsPlace(v)
			}
			return false unless placed
			let fns = 0
			for let (_, s) in calleeOverloads(file, callee) {
				fns++ when s.kind == SymbolKind.Function || s.kind == SymbolKind.Method
			}
			return fns > 1
		}

		// resultlessCall is NoValue for a call of a function declared without
		// a result (the checker gives such a call no type), Unsure for a call
		// whose type is `none` otherwise (a value of function type, whose
		// result this layer cannot tell apart from a written `none`), Fits
		// for any other value.
		internal def resultlessCall(file FileSymbols, value SyntaxNode) Fit {
			let call = unparenthesized(value)
			return Fit.Fits unless call.kind() == SyntaxKind.Call
			return Fit.Fits unless isPrimitiveNamed(exprType(file, call, 0), "none")
			let target = callTarget(file, call, 0)
			return Fit.Unsure when target is none
			return Fit.Unsure unless returnTypeOf(target.fn.node) is none
			return Fit.Unsure when isAsyncDecl(target.fn.node)
			return Fit.NoValue
		}

		// typedByItsPlace is true for an expression the checker types from
		// what its place asks for.
		internal def typedByItsPlace(expr SyntaxNode) bool {
			let inner = unparenthesized(expr)
			return true when typedByPlace(inner)
			switch inner.kind() {
				case SyntaxKind.Choice, SyntaxKind.Tuple, SyntaxKind.FuncDecl, SyntaxKind.ViewExpr, SyntaxKind.If, SyntaxKind.Switch, SyntaxKind.Match:
					return true
				case SyntaxKind.New:
					// `new(...)` without a type makes what its place asks for.
					for let (_, c) in inner.children() {
						return false when isTypeNode(c.kind())
					}
					return true
				default:
					return false
			}
		}

		// unparenthesized is the expression inside any parentheses.
		internal def unparenthesized(expr SyntaxNode) SyntaxNode {
			let current = expr
			for current.kind() == SyntaxKind.Paren {
				let inner = firstNonToken(current)
				return current when inner is none
				current = inner
			}
			return current
		}

		// fitness is how a value of type `given` goes where `wanted` is asked
		// for, as the checker's `ensureAssignable` (`top`) and `canAssign`
		// (`internal/sema/checker.go`) decide. It answers Mismatch only where
		// the checker certainly refuses; anything this layer cannot tell (an
		// unknown part, a type parameter, an interface or datatype asked for,
		// an implicit constructor, a quantity, a function value) is Unsure.
		internal def fitness(wanted Type, given Type, top bool) Fit {
			return Fit.Unsure when wanted.isUnknown() || given.isUnknown()
			return Fit.Fits when wanted == given
			let w = plain(wanted)
			let g = plain(given)
			return Fit.Fits when w == g
			return Fit.Unsure when w.open || g.open
			return Fit.Unsure when isQuantity(wanted) || isQuantity(given) || isQuantity(w) || isQuantity(g)
			if w.kind == TypeKind.Primitive && (w.name := "any" || "anydata") {
				// `?any` is an `any` that may be missing.
				return Fit.Unsure when g.kind == TypeKind.Optional
				return Fit.Fits
			}
			// Asked for an interface or a datatype: what implements or
			// satisfies it is the checker's to tell.
			return Fit.Unsure when isOpenDeclaration(w)
			switch w.kind {
				case TypeKind.Intersection:
					return Fit.Unsure
				case TypeKind.Union:
					return unionFitness(w, g)
				case TypeKind.Optional:
					return Fit.Fits when isPrimitiveNamed(g, "none")
					return certainly(fitness(w.args[0], g.args[0], false)) when g.kind == TypeKind.Optional
					return wrapped(fitness(w.args[0], given, top))
				case TypeKind.Fallible:
					return certainly(fitness(w.args[0], g.args[0], false)) when g.kind == TypeKind.Fallible
					return wrapped(fitness(w.args[0], given, top))
				case TypeKind.Async:
					return certainly(fitness(w.args[0], g.args[0], false)) when g.kind == TypeKind.Async
					return wrapped(fitness(w.args[0], given, top))
				default:
			}
			// A wrapped value where its content is asked for: the checker
			// names the wrapper when the content is the type asked for.
			switch g.kind {
				case TypeKind.Optional:
					return unwrapFitness(w, g, Fit.Optional, top)
				case TypeKind.Fallible:
					return unwrapFitness(w, g, Fit.Errorable, top)
				case TypeKind.Async:
					return unwrapFitness(w, g, Fit.Async, top)
				case TypeKind.Union:
					return givenUnionFitness(w, g)
				default:
			}
			return Fit.Unsure when hasImplicitConstructor(w)
			return primitiveFitness(w, g) when w.kind == TypeKind.Primitive && g.kind == TypeKind.Primitive
			if w.kind != g.kind {
				return Fit.Mismatch when isConcrete(w) && isConcrete(g)
				return Fit.Unsure
			}
			switch w.kind {
				case TypeKind.Named:
					if w.path != g.path {
						return Fit.Mismatch when isConcrete(w) && isConcrete(g)
						return Fit.Unsure
					}
					return sameArguments(w.args, g.args)
				case TypeKind.Array, TypeKind.Map:
					return sameArguments(w.args, g.args)
				case TypeKind.Tuple:
					return Fit.Mismatch when w.args.len() != g.args.len()
					let all = Fit.Fits
					for let (i, a) in w.args {
						let f = certainly(fitness(a, g.args[i], false))
						return Fit.Mismatch when f == Fit.Mismatch
						all = Fit.Unsure when f == Fit.Unsure
					}
					return all
				case TypeKind.Func:
					return discardsResult(w, g) ?? (Fit.Fits, Fit.Unsure)
				default:
					return Fit.Unsure
			}
		}

		// certainly is a fit as a part of a larger type sees it: any refusal
		// is a mismatch of the whole.
		internal def certainly(fit Fit) Fit {
			return fit when fit == Fit.Fits || fit == Fit.Unsure
			return Fit.Mismatch
		}

		// wrapped is the fit of a value going into an optional, errorable or
		// future of what it fits: the checker reports such a refusal as a
		// mismatch of the whole.
		internal def wrapped(fit Fit) Fit {
			return certainly(fit)
		}

		// unwrapFitness is the fit of a wrapped value (`?T`, `!T`, `async T`)
		// where a plain one is asked for: the wrapper's own refusal when its
		// content is the type asked for, a mismatch when its content is
		// certainly another type.
		internal def unwrapFitness(w Type, g Type, refusal Fit, top bool) Fit {
			let inner = plain(g.args[0])
			return Fit.Unsure when inner.isUnknown() || inner.open
			return top ?? (refusal, Fit.Mismatch) when inner == w
			// The content fits or not: either way the wrapper is in the way,
			// unless the content fits only through something this layer
			// cannot tell.
			let f = fitness(w, inner, false)
			return Fit.Unsure when f == Fit.Unsure
			return Fit.Mismatch
		}

		// unionFitness is the fit of a value where a union is asked for: it
		// fits when it fits a member, or, a union itself, when each of its
		// members fits.
		internal def unionFitness(w Type, g Type) Fit {
			// A wrapped value going into a union: the checker's rules for
			// that are its own.
			return Fit.Unsure when g.kind == TypeKind.Optional || g.kind == TypeKind.Fallible || g.kind == TypeKind.Async
			let sure = true
			for let (_, m) in w.args {
				let f = certainly(fitness(m, g, false))
				return Fit.Fits when f == Fit.Fits
				sure = false when f == Fit.Unsure
			}
			if g.kind == TypeKind.Union {
				let all = Fit.Fits
				for let (_, m) in g.args {
					let f = certainly(fitness(w, m, false))
					return Fit.Mismatch when f == Fit.Mismatch
					all = Fit.Unsure when f == Fit.Unsure
				}
				return all
			}
			return sure ?? (Fit.Mismatch, Fit.Unsure)
		}

		// givenUnionFitness is the fit of a union value where a type that is
		// not a union is asked for: each member must fit.
		internal def givenUnionFitness(w Type, g Type) Fit {
			let all = Fit.Fits
			for let (_, m) in g.args {
				let f = certainly(fitness(w, m, false))
				return Fit.Mismatch when f == Fit.Mismatch
				all = Fit.Unsure when f == Fit.Unsure
			}
			return all
		}

		// sameArguments is the fit of two containers' or instances' type
		// arguments: the checker keeps them the same type (`sameElementType`:
		// each assigns to the other).
		internal def sameArguments(a Type[], b Type[]) Fit {
			return Fit.Unsure unless a.len() == b.len()
			let all = Fit.Fits
			for let (i, x) in a {
				let there = certainly(fitness(x, b[i], false))
				let back = certainly(fitness(b[i], x, false))
				return Fit.Mismatch when there == Fit.Mismatch || back == Fit.Mismatch
				all = Fit.Unsure when there == Fit.Unsure || back == Fit.Unsure
			}
			return all
		}

		// primitiveFitness is the fit of one primitive where another is
		// asked for: integers go where integers are, and where floats are; a
		// float only where the same float is; strings, chars, bools,
		// durations, regexes and `none` only where they themselves are.
		internal def primitiveFitness(w Type, g Type) Fit {
			if isIntegral(w) {
				return Fit.Fits when isIntegral(g)
				return Fit.Mismatch when isFloat(g) || isPlainPrimitive(g)
				return Fit.Unsure
			}
			if isFloat(w) {
				return Fit.Fits when isIntegral(g)
				return Fit.Mismatch when isFloat(g) || isPlainPrimitive(g)
				return Fit.Unsure
			}
			if isPlainPrimitive(w) {
				return Fit.Mismatch when isIntegral(g) || isFloat(g) || isPlainPrimitive(g)
			}
			return Fit.Unsure
		}

		// isOpenDeclaration is true for a named type a value of another type
		// may go into: an interface, a datatype, the kinds (`service`,
		// `component`, `view`, `style`), `error`, `enum`.
		internal def isOpenDeclaration(t Type) bool {
			return t.name := "service" || "component" || "view" || "style" || "error" || "enum" when t.kind == TypeKind.Primitive
			return false unless t.kind == TypeKind.Named
			let decl = declarationOf(t)
			return true when decl is none
			return decl.kind == SymbolKind.Interface || decl.kind == SymbolKind.Datatype || decl.kind == SymbolKind.TypeParameter
		}

		// isConcrete is true for a type whose values only it holds: a plain
		// primitive, a number, an array, a map, a channel, a tuple, a
		// function, a struct,
		// a type, an enum, a union declaration, a component or a service.
		internal def isConcrete(t Type) bool {
			switch t.kind {
				case TypeKind.Primitive:
					return isIntegral(t) || isFloat(t) || isPlainPrimitive(t)
				case TypeKind.Array, TypeKind.Map, TypeKind.Channel, TypeKind.Tuple, TypeKind.Func:
					return true
				case TypeKind.Named:
					return false unless t.underlying is none
					let decl = declarationOf(t)
					return false when decl is none
					return false when decl.path.startsWith("builtin.")
					switch decl.kind {
						case SymbolKind.Struct, SymbolKind.Enum, SymbolKind.Union, SymbolKind.Component, SymbolKind.Service:
							return true
						case SymbolKind.Type:
							return aliasTarget(decl.node) is none
						default:
							return false
					}
				default:
					return false
			}
		}

		// hasImplicitConstructor is true for a named type with an
		// `@implicit` constructor, through which values of another type go
		// into it.
		internal def hasImplicitConstructor(t Type) bool {
			return false unless t.kind == TypeKind.Named
			let decl = declarationOf(t)
			return false when decl is none
			// A declaration this layer cannot read the members of may have one.
			let home = workspace.file(decl.file)
			return true when home is none
			for let (_, ctor) in membersNamed(home, decl, "new") {
				for let (_, a) in ctor.annotations {
					return true when a.text().startsWith("@implicit")
				}
			}
			return false
		}

		// discardsResult is the checker's `discardsResult`: a function type
		// without a result takes a function of the same parameters whatever
		// it returns.
		internal def discardsResult(w Type, g Type) bool {
			let r = w.result
			return false unless r is none || isPrimitiveNamed(r, "none")
			return false unless g.kind == TypeKind.Func && w.variadic == g.variadic && w.args.len() == g.args.len()
			for let (i, p) in w.args {
				return false unless p == g.args[i]
			}
			return true
		}

		// callProblems checks a call: a value that is not a function called
		// (`E-TYPE-0154`), a function value called with the wrong number of
		// arguments (`E-TYPE-0157`), a call no overload of the function
		// takes (`E-TYPE-0155`).
		internal def callProblems(file FileSymbols, call SyntaxNode, out TypeProblem[]) {
			let callee = call.child(0)
			return when callee is none
			let args = childOfKind(call, SyntaxKind.Args)
			return when args is none
			// A spread passes an array's elements: their count is the run's.
			for let (_, t) in args.tokens() {
				return when t.token() == TokenKind.Ellipsis
			}
			let positional SyntaxNode[]
			let named SyntaxNode[]
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				let head = arg.child(0)
				continue when head is none
				if isNamedArgumentName(head) {
					// `style = {...}` becomes the functions that set those
					// properties (`argumentProblem`).
					return when head.text() == "style" && isStyleLiteral(arg)
					named.push(arg)
				} else {
					positional.push(head)
				}
			}
			if callee.kind() == SyntaxKind.Name {
				// `uint32(x)` converts, whatever else the name may mean there.
				return unless builtinType(callee.text(), [], []) is none
				let value = calledValue(file, callee)
				if !(value is none) {
					valueCallProblems(file, call, callee, value, positional, named, out)
					return
				}
			}
			let candidates = callCandidates(file, call)
			return when candidates.len() == 0
			// A named argument no overload declares is a name problem
			// (`UnknownParameter`), which the checker reports instead.
			for let (_, arg) in named {
				let head = arg.child(0)
				continue when head is none
				let declared = false
				for let (_, fn) in candidates {
					declared = true when head.text() in paramShape(fn.node).names
				}
				return unless declared
			}
			// The overload the typing chose takes the arguments in correct
			// code: asked first, it usually settles the call.
			let chosen = callTarget(file, call, 0)
			return unless chosen is none || certainlyRejects(file, call, chosen.fn, positional, named)
			for let (_, fn) in candidates {
				return unless certainlyRejects(file, call, fn, positional, named)
			}
			// Named arguments to the one function there is are checked against
			// it by name first.
			return when named.len() > 0 && candidates.len() == 1 && namedCallProblems(call, candidates[0], positional, named, out)
			let name = callee.lastToken()
			return when name is none
			let labels string[]
			for let (_, p) in positional {
				labels.push(exprType(file, p, 0).str())
			}
			let given = labels.join(", ")
			if named.len() > 0 {
				let keyed string[]
				for let (_, arg) in named {
					let head = arg.child(0)
					let value = lastNonToken(arg)
					continue when head is none || value is none
					keyed.push(head.text() + "=" + exprType(file, value, 0).str())
				}
				keyed.sort((a string, b string) => a < b)
				given = labels.len() == 0 ?? (keyed.join(", "), given + "; " + keyed.join(", "))
			}
			let signatures string[]
			for let (_, fn) in candidates {
				signatures.push(signatureLabel(file, call, fn))
			}
			out.push(TypeProblem{node: callee, code: "E-TYPE-0155", message: "no overload of \"{name.text()}\" matches arguments ({given}); candidates: {signatures.join(", ")}"})
		}

		// namedCallProblems checks named arguments against the one function a
		// call can call (the checker's `validateNamedCallAgainstCandidate`):
		// a variadic function takes none (`E-TYPE-0156`), more positional
		// arguments than parameters (`E-TYPE-0157`), a parameter given twice
		// (`E-TYPE-0158`), one left without a value or a default
		// (`E-TYPE-0159`). True when that ends the call's check; false when
		// only a parameter given twice was found, after which the checker
		// goes on to report that no overload matches.
		internal def namedCallProblems(call SyntaxNode, fn Symbol, positional SyntaxNode[], named SyntaxNode[], out TypeProblem[]) bool {
			let shape = paramShape(fn.node)
			if shape.variadic {
				out.push(TypeProblem{node: call, code: "E-TYPE-0156", message: "named arguments are not supported for variadic functions"})
				return true
			}
			let names = shape.names
			if positional.len() > names.len() {
				out.push(TypeProblem{node: call, code: "E-TYPE-0157", message: "call argument count mismatch: got {positional.len() + named.len()}, want {names.len()}"})
				return true
			}
			let provided bool[]
			for let i = 0; i < names.len(); i++ {
				provided.push(i < positional.len())
			}
			for let (_, arg) in named {
				let head = arg.child(0)
				continue when head is none
				let at = names.indexOf(head.text())
				continue when at < 0
				if provided[at] {
					out.push(TypeProblem{node: call, code: "E-TYPE-0158", message: "argument \"{head.text()}\" is provided more than once"})
					continue
				}
				provided[at] = true
			}
			let missing = false
			for let (i, name) in names {
				continue when provided[i] || shape.defaulted[i]
				missing = true
				out.push(TypeProblem{node: call, code: "E-TYPE-0159", message: "missing argument \"{name}\""})
			}
			return missing
		}

		// calledValue is the local, parameter, constant or field a called
		// name stands for, none when it names a function or a type.
		internal def calledValue(file FileSymbols, callee SyntaxNode) ?Symbol {
			let t = callee.firstToken()
			return none when t is none || t.token() != TokenKind.Ident
			let found = workspace.resolve(file, t.text(), t.start())
			return none unless found.len() == 1
			let s = found[0]
			return none unless s.kind == SymbolKind.Local || s.kind == SymbolKind.Parameter || s.kind == SymbolKind.Const || s.kind == SymbolKind.Field
			// A call looks past a value that is no function for the functions
			// of the name: a local `added` does not hide `added(...)`.
			return none when callsPast(file, found, 0) && workspace.resolveCallable(file, t.text(), t.start()).len() > 0
			return s
		}

		// valueCallProblems checks the call of a value: one that is not a
		// function (`E-TYPE-0154`), a function value given another number
		// of arguments than it takes (`E-TYPE-0157`, `E-TYPE-0169`).
		internal def valueCallProblems(file FileSymbols, call SyntaxNode, callee SyntaxNode, value Symbol, positional SyntaxNode[], named SyntaxNode[], out TypeProblem[]) {
			let t = plain(exprType(file, callee, 0))
			return when t.isUnknown()
			if t.kind != TypeKind.Func {
				let callable = t.kind == TypeKind.Primitive && (isIntegral(t) || isFloat(t) || isPlainPrimitive(t)) || t.kind == TypeKind.Array || t.kind == TypeKind.Map || t.kind == TypeKind.Tuple
				return unless callable
				out.push(TypeProblem{node: callee, code: "E-TYPE-0154", message: "\"{value.name}\" is not callable"})
				return
			}
			// Named arguments to a function value are a rule of their own.
			return when named.len() > 0
			let given = positional.len()
			let want = t.args.len()
			if t.variadic {
				return when given >= want - 1
				out.push(TypeProblem{node: call, code: "E-TYPE-0169", message: "call argument count mismatch: got {given}, want at least {want - 1}"})
				return
			}
			return when given == want
			out.push(TypeProblem{node: call, code: "E-TYPE-0157", message: "call argument count mismatch: got {given}, want {want}"})
		}

		// callCandidates is the functions a call may call, every overload its
		// callee names, when they are all functions or methods this layer
		// knows in full: of a name in scope, a module's, a type's static
		// ones, a closed type's (not a prelude type, whose overloads come
		// from every extension). Empty otherwise.
		internal def callCandidates(file FileSymbols, call SyntaxNode) Symbol[] {
			let callee = call.child(0)
			return [] when callee is none
			let found Symbol[]
			switch callee.kind() {
				case SyntaxKind.Name:
					let t = callee.firstToken()
					return [] when t is none || t.token() != TokenKind.Ident
					found = workspace.resolve(file, t.text(), t.start())
					found = workspace.resolveCallable(file, t.text(), t.start()) when callsPast(file, found, 0)
				case SyntaxKind.Member:
					let kids = callee.children()
					return [] when kids.len() < 3
					let name = kids[kids.len() - 1]
					return [] unless name.isToken()
					let owner = staticSymbol(file, kids[0])
					if owner is none {
						let receiver = exprType(file, kids[0], 0)
						return [] when receiver.isUnknown()
						let declaring = ownerOf(receiver)
						return [] when declaring is none
						return [] unless isClosedType(declaring) || declaring.kind == SymbolKind.Interface
						found = membersNamed(homeOf(declaring, file), declaring, name.text())
					} else {
						return [] unless owner.kind == SymbolKind.Import
						found = staticMembers(file, owner, name.text())
					}
				default:
					return []
			}
			for let (_, s) in found {
				return [] unless s.kind == SymbolKind.Function || s.kind == SymbolKind.Method
				return [] when s.isMeta
			}
			return found
		}

		// certainlyRejects is true when the function certainly does not take
		// the call's arguments: more than its parameters, a parameter left
		// without a default, a named argument it does not declare, an
		// argument of a type its parameter certainly refuses (the checker's
		// `callArgMatches`).
		internal def certainlyRejects(file FileSymbols, call SyntaxNode, fn Symbol, positional SyntaxNode[], named SyntaxNode[]) bool {
			// A parameter the compiler fills (`@implicit`) is not the call's.
			let list = childOfKind(fn.node, SyntaxKind.Params)
			if !(list is none) {
				for let (_, p) in list.children() {
					continue unless p.kind() == SyntaxKind.Param
					return false unless childOfKind(p, SyntaxKind.Attribute) is none
				}
			}
			return true unless acceptsArguments(fn, call)
			let receiver = callReceiver(file, call)
			let fnType = funcTypeOf(homeOf(fn, file), fn, 0)
			fnType = instanceType(file, receiver, fn, fnType, 0) unless receiver is none
			let params = fnType.args
			for let (i, arg) in positional {
				let at = i
				at = params.len() - 1 when fnType.variadic && at >= params.len()
				continue when at < 0 || at >= params.len()
				return true when refusesArgument(file, params[at], arg)
			}
			let names = paramShape(fn.node).names
			for let (_, arg) in named {
				let head = arg.child(0)
				let value = lastNonToken(arg)
				continue when head is none || value is none
				for let (i, n) in names {
					continue unless n == head.text() && i < params.len()
					return true when refusesArgument(file, params[i], value)
				}
			}
			return false
		}

		// refusesArgument is true when a parameter of the type certainly
		// does not take the argument. Overload choice takes any float for a
		// float and any integer for a bigint (`callArgMatches`).
		internal def refusesArgument(file FileSymbols, wanted Type, arg SyntaxNode) bool {
			return false when wanted.open || wanted.isUnknown()
			let fit = fitOf(file, wanted, arg)
			// A call that returns nothing passes as an argument to the checker.
			return false when fit == Fit.Fits || fit == Fit.Unsure || fit == Fit.NoValue
			let w = bare(wanted)
			let g = bare(givenType(file, wanted, arg))
			return false when isFloat(w) && isFloat(g)
			return false when isPrimitiveNamed(w, "bigint") && isIntegral(g)
			return true
		}

		// callReceiver is the value a method call is called on, or the type
		// a static call names, as a type; none for a plain function.
		internal def callReceiver(file FileSymbols, call SyntaxNode) ?Type {
			let callee = call.child(0)
			return none when callee is none || callee.kind() != SyntaxKind.Member
			let kids = callee.children()
			return none when kids.len() < 3
			let owner = staticSymbol(file, kids[0])
			return exprType(file, kids[0], 0) when owner is none
			return declaredTypeOf(file, owner, [], 0) when isTypeLike(owner.kind)
			return none
		}

		// signatureLabel is a candidate as the checker lists it:
		// `(int, string) -> int`.
		internal def signatureLabel(file FileSymbols, call SyntaxNode, fn Symbol) string {
			let t = funcTypeOf(homeOf(fn, file), fn, 0)
			let receiver = callReceiver(file, call)
			t = instanceType(file, receiver, fn, t, 0) unless receiver is none
			let params string[]
			for let (i, p) in t.args {
				params.push((t.variadic && i == t.args.len() - 1) ?? ("..." + p.str(), p.str()))
			}
			let head = "(" + params.join(", ") + ")"
			let r = t.result
			return head when r is none
			return head + " -> " + r.str()
		}
	}

	// isPlainPrimitive is true for the primitives that are neither numbers
	// nor stand for other types: string, char, bool, duration, regex, none.
	internal def isPlainPrimitive(t Type) bool {
		return t.kind == TypeKind.Primitive && (t.name := "string" || "char" || "bool" || "duration" || "regex" || "none")
	}
}
