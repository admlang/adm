partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	internal def checkedLibSource() string {
		return fixture("""
module shapes «
	struct Pair «
		a int
		b ?string = none
	»
	enum Mode «
		On = "on",
		Off = "off"
	»
	struct Circle «
		r float
	»
	struct Square «
		side float
	»
	type Shape = Circle | Square
	interface Named «
		def name() string
	»
	type Dog «
		def name() string « return "dog" »
		def grow(by int) int « return by »
	»
	def take(p Pair) int « return p.a »
	def many(xs ...int) int « return 0 »
	def opt(x ?int) int « return 0 »
	def two(a int, b string = "x") string « return b »
	def fails(x int) !int « return x »
	def named(n Named) string « return n.name() »
	def area(s Shape) float « return 0.0 »
»
""")
	}

	// problemsOf is each problem of the source as `code text`, the text
	// being what the problem marks.
	internal def problemsOf(source string) string[] {
		let w = new Workspace()
		w.add("builtin.adm", parse(preludeSource()))
		w.add("shapes.adm", parse(checkedLibSource()))
		let file = w.add("app.adm", parse(source))
		let nav = new Navigator(w)
		let shown string[]
		for let (_, p) in nav.typeProblems(file, 0, source.len()) {
			shown.push(p.code + " " + source[p.node.start():p.node.end()])
		}
		println(shown.join("\n")) when shown.len() > 0
		return shown
	}

	check "Checking" {
		@test()
		def TestValuesOfAnotherType() {
			let found = problemsOf(fixture("""
module app «
	use shapes::*
	def run() !none «
		let a Pair = Circle«r: 1.0»
		let b Mode = "on"
		let c Shape = Pair«a: 1»
		let d int[] = string[]
		let e float = fails(1)
		let f int = opt
		let g ?int = 3
		let h int = g
		let i int = fails(2)
		let n int = none
		g = "x"
		let p = Pair«a: "x", b: 3»
	»
	def back() Shape « return 3 »
	def wrapped() !int « return "x" »
»
"""))
			assert found.join("\n") == [
				fixture("E-TYPE-0096 Circle«r: 1.0»"),
				"E-TYPE-0096 \"on\"",
				fixture("E-TYPE-0096 Pair«a: 1»"),
				"E-TYPE-0096 string[]",
				"E-TYPE-0096 fails(1)",
				"E-TYPE-0096 opt",
				"E-TYPE-0094 g",
				"E-TYPE-0093 fails(2)",
				"E-TYPE-0096 none",
				"E-TYPE-0096 g = \"x\"",
				"E-TYPE-0201 \"x\"",
				"E-TYPE-0201 3",
				"E-TYPE-0096 3",
				"E-TYPE-0096 \"x\""
			].join("\n")
		}

		@test()
		def TestCallsAndReturns() {
			let found = problemsOf(fixture("""
module app «
	use shapes::*
	def run() «
		take(Circle«r: 1.0»)
		many(1, "x")
		two()
		two(1, 2)
		two(b = "y")
		two(1, a = 2)
		area(Pair«a: 1»)
		fails(2)
		new Dog().grow("a")
		let fv = (a int, b string) => a
		fv(1)
		let s = "x"
		s(1)
	»
	def none1() « return 3 »
	def result() int « return »
»
"""))
			assert found.join("\n") == [
				"E-TYPE-0155 take",
				"E-TYPE-0155 many",
				"E-TYPE-0155 two",
				"E-TYPE-0155 two",
				"E-TYPE-0159 two(b = \"y\")",
				"E-TYPE-0158 two(1, a = 2)",
				"E-TYPE-0155 two",
				"E-TYPE-0155 area",
				"E-TYPE-0027 fails(2)",
				"E-TYPE-0155 new Dog().grow",
				"E-TYPE-0157 fv(1)",
				"E-TYPE-0154 s",
				"E-TYPE-0175 3",
				"E-TYPE-0174 return"
			].join("\n")
		}

		@test()
		def TestNothingReportedWhereTheValueFits() {
			let found = problemsOf(fixture("""
module app «
	use shapes::*
	def run(maybe ?int, shape Shape) !none «
		let a Shape = Circle«r: 1.0»
		let b Named = new Dog()
		let c ?string = "s"
		let d !int = 3
		let e float = 3
		let f byte = 255
		let g any = Pair«a: 1»
		let h ?Pair = none
		let i float32 = 1.5
		let j float32[] = [1.0, 2.0]
		let k string[] = []
		let l = try fails(1)
		let m int = fails(1) onerror recover 0
		_ = fails(1)
		let n def(int) = (x int) => x + 1
		let o Mode = Mode.On
		let p = 0
		p = maybe when !(maybe is none)
		named(new Dog())
		area(Circle«r: 1.0»)
		many()
		many(1, 2, 3)
		two(1)
		two(1, b = "z")
		opt(3)
		opt(none)
		let take = 3
		take(Pair«a: take»)
		return when maybe is none
		let q int = maybe
		match shape «
			case Circle:
				let r Circle = shape
			default:
				let s Square = shape
		»
	»
	def gen(n int) Iterator<int> «
		yield n
		return
	»
	def ends() !none « return »
»
"""))
			assert found.len() == 0
		}

		@test()
		def TestLambdaReturnsAndResultlessCalls() {
			let found = problemsOf(fixture("""
module app «
	def each(xs int[], f def(int)) « f(xs[0]) »
	def mapped(xs int[], f def(int) int) int « return f(xs[0]) »
	def log(s string) « »
	def run() int «
		let a = (x int) => «
			return x + 1
		»
		each([1], (x int) => «
			return x
		»)
		let b = mapped([1], (x int) => «
			return x + 1
		»)
		let c = mapped([1], (x int) => «
			return "no"
		»)
		let d = log("a")
		_ = log("b")
		let n int = log("c")
		return log("d")
	»
»
"""))
			assert found.join("\n") == [
				"E-TYPE-0175 x + 1",
				"E-TYPE-0175 x",
				"E-TYPE-0096 \"no\"",
				"W-TYPE-0002 log(\"a\")",
				"W-TYPE-0002 log(\"c\")",
				"W-TYPE-0002 log(\"d\")"
			].join("\n")
		}

		@test()
		def TestCallsLookPastValues() {
			let source = fixture("""
module app «
	use shapes::*
	def run() «
		let take = 3
		let n = take(Pair«a: take»)
	»
»
""")
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("shapes.adm", parse(checkedLibSource()))
			let file = w.add("app.adm", parse(source))
			// The local `take` is no function: a call of the name calls the
			// module's.
			let at = source.indexOf("take(")
			let called = w.resolveCallable(file, "take", at)
			assert called.len() == 1 && called[0].kind == SymbolKind.Function
			assert new Navigator(w).typeAt(file, source.indexOf("let n") + 4).str() == "int"
		}

		@test()
		def TestOnlyTheRangeAsked() {
			let source = fixture("""
module app «
	use shapes::*
	def run() «
		let a int = "x"
		let b int = "y"
	»
»
""")
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("shapes.adm", parse(checkedLibSource()))
			let file = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let from = source.indexOf("let b")
			let found = nav.typeProblems(file, from, source.len())
			assert found.len() == 1 && found[0].message == "initialize b type mismatch: got string, want int"
		}
	}
}
