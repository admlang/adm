partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// TokenClass is what a name token stands for, for an editor's colours
	// and its x-ray view. Lexical classes (keywords, literals, operators)
	// are the lexer's `TokenKind`; this is the semantic layer over the
	// names.
	enum TokenClass {
		// A module, application, library, plugin or check suite, or an
		// import that binds a module.
		Namespace     = "namespace",
		// A type-like declaration: type, struct, enum, union, interface,
		// datatype, service, component, style, view.
		Type          = "type",
		TypeParameter = "type parameter",
		Function      = "function",
		Method        = "method",
		Field         = "field",
		Property      = "property",
		Parameter     = "parameter",
		// A local or loop variable.
		Variable      = "variable",
		Constant      = "constant",
		// A member of an enum or a union.
		EnumMember    = "enum member",
		// A unit symbol (`km`).
		Unit          = "unit",
		// The name of an annotation.
		Annotation    = "annotation",
		// `self`.
		Self          = "self",
		// A name no declaration answers.
		Unresolved    = "unresolved"
	}

	// Classified is one name token with its class, whether it is the
	// declaration itself (not a reference), and the declaration it refers
	// to when one is known.
	struct Classified {
		token       SyntaxNode
		class       TokenClass
		declaration bool
		symbol      ?Symbol
	}

	partial type Navigator {
		// classify is every name token of the file between `start` and
		// `end` (the whole file by default), in order, with its semantic
		// class: the kind of the declaration it names or declares, an
		// annotation's name, `self`, or unresolved. Keys of a map literal
		// and names inside view and style bodies are classified like any
		// other name (unresolved when nothing answers them).
		def classify(file FileSymbols, start int = 0, end int = -1) Classified[] {
			let out Classified[]
			let limit = end < 0 ?? (file.tree.text().len(), end)
			for let (_, t) in file.tree.root().tokens() {
				continue when t.end() <= start
				break when t.start() >= limit
				continue unless isNameToken(t.token())
				if t.token() == TokenKind.Self {
					out.push(Classified{token: t, class: TokenClass.Self, declaration: false, symbol: none})
					continue
				}
				// `_` names nothing; the `view` or `style` that opens a block
				// is the lexer's keyword, not a name.
				continue when t.text() == "_"
				let parent = t.parent
				continue when parent is none
				continue when isBlockKeyword(t, parent)
				if isAnnotationName(parent, t) {
					let target = first(annotationAt(file, t.text(), t.start()))
					out.push(Classified{token: t, class: TokenClass.Annotation, declaration: false, symbol: target})
					continue
				}
				// A part of a dotted module name (`use std.testing`, `module
				// std.adm.symbols`) names a namespace; the declaring unit's own
				// name is a declaration.
				if parent.kind() == SyntaxKind.QualifiedName {
					let holder = parent.parent
					if !(holder is none) && isModuleNameHolder(holder.kind()) {
						let unit = file.symbolAt(presentLast(parent).start())
						let declares = !(unit is none) && unit.kind != SymbolKind.Import
						out.push(Classified{token: t, class: TokenClass.Namespace, declaration: declares, symbol: unit})
						continue
					}
				}
				let own = file.symbolAt(t.start())
				if !(own is none) {
					// A `use` names a module or one of its declarations: a
					// reference with that declaration's class, not a declaration.
					if own.kind == SymbolKind.Import {
						let target = own.imported.len() > 0 ?? (first(workspace.lookup(own.moduleName, own.imported)), none)
						let class = target is none ?? (TokenClass.Namespace, classOf(presentTarget(target)))
						out.push(Classified{token: t, class: class, declaration: false, symbol: target is none ?? (own, target)})
						continue
					}
					out.push(Classified{token: t, class: classOf(own), declaration: true, symbol: own})
					continue
				}
				let found = first(definitionAt(file, t.start()))
				if found is none {
					out.push(Classified{token: t, class: TokenClass.Unresolved, declaration: false, symbol: none})
					continue
				}
				out.push(Classified{token: t, class: classOf(found), declaration: false, symbol: found})
			}
			return out
		}

		// isBlockKeyword is true for the `view` or `style` token that opens a
		// view or style declaration or a view expression: a keyword there,
		// which `isNameToken` counts as a name for `ref = view` and a
		// component's `style` member.
		internal def isBlockKeyword(t SyntaxNode, parent SyntaxNode) bool {
			return false unless t.token() == TokenKind.View || t.token() == TokenKind.Style
			return parent.kind() == SyntaxKind.ViewDecl || parent.kind() == SyntaxKind.StyleDecl || parent.kind() == SyntaxKind.ViewExpr
		}

		// isModuleNameHolder is true for a node whose qualified name is a
		// module's: a unit declaration or a `use`.
		internal def isModuleNameHolder(kind SyntaxKind) bool {
			switch kind {
				case SyntaxKind.Module, SyntaxKind.Application, SyntaxKind.Library, SyntaxKind.Plugin, SyntaxKind.Use, SyntaxKind.UseItem:
					return true
				default:
					return false
			}
		}

		// presentLast is the last token of a node that has one.
		internal def presentLast(node SyntaxNode) SyntaxNode {
			let last = node.lastToken()
			return last unless last is none
			return node
		}

		// presentTarget is the symbol, which the caller checked is there.
		internal def presentTarget(target ?Symbol) Symbol {
			return target unless target is none
			return new Symbol(SymbolKind.Import, "", workspace.allFiles().values()[0].tree.root(), 0, 0)
		}

		// classOf is the class a declaration's names have.
		def classOf(symbol Symbol) TokenClass {
			switch symbol.kind {
				case SymbolKind.Module, SymbolKind.Application, SymbolKind.Library, SymbolKind.Plugin, SymbolKind.Check:
					return TokenClass.Namespace
				case SymbolKind.Import:
					return TokenClass.Namespace
				case SymbolKind.Type, SymbolKind.Struct, SymbolKind.Enum, SymbolKind.Union, SymbolKind.Interface, SymbolKind.Datatype, SymbolKind.Service, SymbolKind.Component, SymbolKind.Style, SymbolKind.View:
					return TokenClass.Type
				case SymbolKind.TypeParameter:
					return TokenClass.TypeParameter
				case SymbolKind.Function:
					return TokenClass.Function
				case SymbolKind.Method:
					return TokenClass.Method
				case SymbolKind.Field:
					return TokenClass.Field
				case SymbolKind.Property:
					return TokenClass.Property
				case SymbolKind.Parameter:
					return TokenClass.Parameter
				case SymbolKind.Local:
					return TokenClass.Variable
				case SymbolKind.Const:
					return TokenClass.Constant
				case SymbolKind.EnumMember, SymbolKind.UnionMember:
					return TokenClass.EnumMember
				case SymbolKind.Unit:
					return TokenClass.Unit
				default:
					return TokenClass.Unresolved
			}
		}
	}
}
