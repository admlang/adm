partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	check "Classify" {
		@test()
		def TestTokenClasses() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(libSource()))
			let source = appSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let all = nav.classify(app)
			let byOffset map<int, Classified>
			for let (_, c) in all {
				byOffset[c.token.start()] = c
			}
			let at = def (text string, skip int) Classified {
				return byOffset[source.indexOf(text) + skip]
			}
			// Declarations carry the flag; references do not.
			assert at("module app", 7).class == TokenClass.Namespace && at("module app", 7).declaration
			assert at("def main", 4).class == TokenClass.Function && at("def main", 4).declaration
			assert at("f File", 0).class == TokenClass.Parameter && at("f File", 0).declaration
			assert at("f File", 2).class == TokenClass.Type && !at("f File", 2).declaration
			assert at("let text", 4).class == TokenClass.Variable && at("let text", 4).declaration
			assert at("f.read(1)", 2).class == TokenClass.Method && !at("f.read(1)", 2).declaration
			assert at("f.path", 2).class == TokenClass.Field
			assert at("lib.open", 0).class == TokenClass.Namespace && at("lib.open", 4).class == TokenClass.Function
			// `f.` on the line before makes `println` a member of File: unresolved.
			assert at("println(count", 0).class == TokenClass.Unresolved && at("println(count", 0).symbol is none
			// A `use` is a reference with the imported declaration's class.
			assert at("use lib::(File, open)", 10).class == TokenClass.Type && !at("use lib::(File, open)", 10).declaration
			assert at("use lib::(File, open)", 16).class == TokenClass.Function && pathOf(at("use lib::(File, open)", 16).symbol) == "lib.open"
			assert at("use lib\n", 4).class == TokenClass.Namespace && !at("use lib\n", 4).declaration
			assert at("count.abs()", 6).class == TokenClass.Method
			// Every name token is classified once, in order.
			assert all.len() > 20 && all[0].token.start() < all[1].token.start()
			// A range takes only the tokens inside it.
			let from = source.indexOf("let text")
			let part = nav.classify(app, from, source.indexOf("let p ="))
			assert part.len() == 3 && part[0].token.text() == "text" && part[2].token.text() == "read"
			// Annotations, self and unresolved names.
			let testing = "module std.testing \{\n\tmeta def test() \{\}\n\}\n"
			w.add("testing.adm", parse(testing))
			let suite = "module s \{\n\tuse std.testing\n\ttype T \{\n\t\tn int\n\t\tdef get() int \{ return self.n + missing \}\n\t\}\n\t@test()\n\tdef t() \{\}\n\}\n"
			let sf = w.add("suite.adm", parse(suite))
			let classes string[]
			for let (_, c) in nav.classify(sf) {
				classes.push(c.class.value)
			}
			assert classes.join(",") == "namespace,namespace,namespace,type,field,type,method,type,self,field,unresolved,annotation,function"
			let selfField = nav.classify(sf)[9]
			assert selfField.token.text() == "n" && pathOf(selfField.symbol) == "s.T.n"
			assert nav.classOf(w.lookup("lib", "File")[0]) == TokenClass.Type
			// The `view` and `style` that open a block are keywords and get no
			// class; `_` names nothing; a `view` named as a value is classified.
			let comp = fixture("""
module ui «
	use lib as _
	style Surface «»
	view Nothing «»
	component Tile «
		style Surface
		view Nothing
		type «
			def new() «»
		»
	»
	component Page «
		view «
			Tile(ref = view)
		»
	»
»
""")
			let cf = w.add("comp.adm", parse(comp))
			let texts string[]
			let types = 0
			let named = false
			for let (_, c) in nav.classify(cf) {
				texts.push(c.token.text())
				types++ when c.class == TokenClass.Type
				named = true when c.token.start() == comp.indexOf("ref = view") + 6
			}
			assert !("view" in texts.slice(0, texts.len() - 1)) && !("style" in texts) && !("_" in texts)
			assert types == 7 && named
		}
	}
}
