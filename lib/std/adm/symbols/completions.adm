partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// fieldCompletions is the fields a struct literal can still name at
		// the offset: inside `Point{` or `{` in a typed place, at a key
		// position (after `{` or `,`, or in the key being typed), the fields
		// of the type that no earlier key gives. Empty anywhere else.
		def fieldCompletions(file FileSymbols, offset int) Symbol[] {
			let literal = literalKeySlot(file, offset)
			return [] when literal is none
			let made = typeRefSymbol(structLiteralRef(file, literal, 0))
			return [] when made is none
			// The keys of the entries before the offset are spoken for; the
			// entry the cursor is in is the one being typed.
			let given map<string, bool>
			for let (_, init) in literal.children() {
				continue unless init.kind() == SyntaxKind.FieldInit && init.end() < offset
				let key = init.child(0)
				continue when key is none
				given[key.text()] = true when key.kind() == SyntaxKind.Name
			}
			let out Symbol[]
			for let (_, m) in members(file, made) {
				continue unless m.kind == SymbolKind.Field || m.kind == SymbolKind.Property
				out.push(m) unless given.hasKey(m.name)
			}
			return out
		}

		// parameterCompletions is the parameters a call can still name at
		// the offset as `name = value`: inside `f(`, at an argument start
		// (after `(` or `,`, or in the name being typed), the parameters of
		// what is called that no earlier named argument gives. Empty
		// anywhere else.
		def parameterCompletions(file FileSymbols, offset int) Symbol[] {
			let args = argumentSlot(file, offset)
			return [] when args is none
			let owner = args.parent
			return [] when owner is none
			let fn = calledFunction(file, owner, 0)
			return [] when fn is none
			// Earlier arguments spoke for their parameters: the positional ones
			// for the first parameters in order, the named ones by name.
			let given map<string, bool>
			let positional = 0
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				continue unless arg.end() < offset
				let name = arg.child(0)
				continue when name is none
				if isNamedArgumentName(name) {
					given[name.text()] = true
				} else {
					positional++
				}
			}
			let out Symbol[]
			let home = homeOf(fn, file)
			for let (i, t) in parameterNames(fn.node) {
				continue when i < positional || given.hasKey(t.text())
				let param = home.symbolAt(t.start())
				out.push(param) unless param is none
			}
			return out
		}

		// useCompletions is what a `use` can name at the offset. In the module
		// path (`use |`, `use std.|`, `use std.ne|`): every module of the
		// workspace whose path starts with the parts written before the name
		// being typed (`std.`), parsed or only registered, in path order,
		// each as a symbol of that module named by the rest of its path
		// (`net.http`), so that accepting one completes the path. After `::`
		// or inside `::( ... )`: the module's declarations no earlier item of
		// the list names, the internal ones left out, each name once. After
		// `as`, or after `::*`: nothing, since a new name or nothing is
		// written there. `slot` is the `Use` or `UseItem` from `useSlot`.
		internal def useCompletions(file FileSymbols, slot SyntaxNode, offset int) Symbol[] {
			let nothing Symbol[]
			if slot.kind() == SyntaxKind.Use {
				// Between the items of a `use ( ... )`, or after a bare `use`.
				let opening = childToken(slot, TokenKind.LParen)
				return moduleCompletions(file, "", offset) when !(opening is none) && insideBrackets(slot, TokenKind.LParen, TokenKind.RParen, offset)
				let keyword = childToken(slot, TokenKind.Use)
				return nothing when opening is none && (keyword is none || offset < keyword.end())
				return nothing unless opening is none
				return moduleCompletions(file, "", offset)
			}
			let alias = childToken(slot, TokenKind.As)
			return nothing when !(alias is none) && offset > alias.start()
			let listed = childToken(slot, TokenKind.ColonColon)
			if !(listed is none) && offset >= listed.end() {
				let path = childNode(slot, SyntaxKind.QualifiedName)
				return nothing when path is none
				return exportCompletions(path.text().replace(" ", ""), slot, offset)
			}
			// In the module path: the parts before the name being typed.
			let path = childNode(slot, SyntaxKind.QualifiedName)
			return moduleCompletions(file, "", offset) when path is none
			let typedFrom = offset
			if offset > 0 {
				let typed = file.tree.find(offset - 1)
				typedFrom = typed.start() when !(typed is none) && isTypedName(typed) && typed.end() == offset
			}
			let prefix = ""
			for let (_, t) in path.tokens() {
				break when t.isMissing() || t.end() > typedFrom
				prefix += t.text()
			}
			return moduleCompletions(file, prefix, offset)
		}

		// moduleCompletions is the modules of the workspace whose path starts
		// with `prefix` (`std.`, or "" for all) and that the file's unit at
		// the offset may `use` (`visibleModule`), each as a symbol named by
		// the rest of its path. The one `prefix` names itself (`std` for
		// `std.`) is no completion.
		internal def moduleCompletions(file FileSymbols, prefix string, offset int) Symbol[] {
			let out Symbol[]
			let own = ""
			let here = file.unitAt(offset)
			own = here.path when !(here is none) && here.kind == SymbolKind.Module
			for let (_, unit) in workspace.moduleSymbols() {
				continue unless unit.path.startsWith(prefix) && unit.path.len() > prefix.len()
				// A file never imports a unit it declares itself.
				continue when declaresUnit(file, unit.path)
				continue unless visibleModule(unit, own)
				let rest = unit.path[prefix.len():]
				if rest == unit.name {
					out.push(unit)
					continue
				}
				let item = new Symbol(SymbolKind.Module, rest, unit.node, unit.nameStart, unit.nameEnd)
				item.path = unit.path
				item.doc = unit.doc
				item.file = unit.file
				item.id = unit.id
				out.push(item)
			}
			return out
		}

		// declaresUnit is true when one of the file's units has the path.
		internal def declaresUnit(file FileSymbols, path string) bool {
			for let (_, u) in file.units {
				return true when u.path == path
			}
			return false
		}

		// visibleModule is true when a file whose unit is the module `own`
		// ("" for an application, library or plugin) may `use` the module:
		// every module that is not internal, and an internal one from a
		// module in its scope, names compared by whole parts (spec 3.5:
		// `std.data` covers `std.data.x`, not `std.database`).
		internal def visibleModule(unit Symbol, own string) bool {
			return true unless unit.isInternal
			let scope = unit.internalScope
			return own == scope || own.startsWith(scope + ".")
		}

		// exportCompletions is the declarations of the module a `use` item
		// imports from that no `UseSymbol` ending before the offset names, the
		// internal ones and the check suites left out, each name once; nothing
		// after `::*`, past the list's closing parenthesis or after an `as`.
		internal def exportCompletions(moduleName string, item SyntaxNode, offset int) Symbol[] {
			let out Symbol[]
			let given map<string, bool>
			for let (_, d) in item.descendants() {
				if d.isToken() {
					return out when d.token() == TokenKind.Mul
					return out when d.token() == TokenKind.As && d.start() < offset && !(d.ancestor(SyntaxKind.UseSymbol) is none)
					continue
				}
				if d.kind() == SyntaxKind.UseSymbols {
					return out unless insideBrackets(d, TokenKind.LParen, TokenKind.RParen, offset)
					continue
				}
				continue unless d.kind() == SyntaxKind.UseSymbol && d.end() < offset
				let name = d.child(0)
				given[name.text()] = true unless name is none
			}
			for let (_, s) in workspace.exports(moduleName) {
				continue when s.isInternal || s.kind == SymbolKind.Check || s.kind == SymbolKind.Unit
				addVisible(s, out, given)
			}
			return out
		}

		// useSlot is the `Use` or `UseItem` the offset completes in, none when
		// the offset is not in a `use`: from the element at the cursor
		// (`nodeForCompletion`) up to the `use`, stopping at a block, a body,
		// a function or a lambda.
		internal def useSlot(file FileSymbols, offset int) ?SyntaxNode {
			let start = nodeForCompletion(file, offset)
			return none when start is none
			let node = start
			for {
				switch node.kind() {
					case SyntaxKind.Use, SyntaxKind.UseItem:
						return node
					case SyntaxKind.Block, SyntaxKind.Body, SyntaxKind.FuncDecl, SyntaxKind.Lambda:
						return none
					default:
						let up = node.parent
						return none when up is none
						node = up
				}
			}
		}

		// literalKeySlot is the struct literal whose key position holds the
		// offset: between its braces, outside every value.
		internal def literalKeySlot(file FileSymbols, offset int) ?SyntaxNode {
			let start = nodeForCompletion(file, offset)
			return none when start is none
			let node = start
			for {
				switch node.kind() {
					case SyntaxKind.FieldInit:
						let sep = childToken(node, TokenKind.Colon)
						return none when !(sep is none) && sep.start() < offset
						return node.parent
					case SyntaxKind.StructLit:
						return node when insideBrackets(node, TokenKind.LBrace, TokenKind.RBrace, offset)
						return none
					case SyntaxKind.Block, SyntaxKind.Body, SyntaxKind.FuncDecl, SyntaxKind.Lambda, SyntaxKind.Args, SyntaxKind.ArrayLit, SyntaxKind.Paren:
						return none
					default:
						let up = node.parent
						return none when up is none
						node = up
				}
			}
		}

		// argumentSlot is the Args node whose argument-start position holds
		// the offset: between the parentheses, at the start of an argument
		// or in its first name.
		internal def argumentSlot(file FileSymbols, offset int) ?SyntaxNode {
			let start = nodeForCompletion(file, offset)
			return none when start is none
			let node = start
			for {
				switch node.kind() {
					case SyntaxKind.Arg:
						let first = node.child(0)
						return none when first is none
						// Past the first token of the argument, the name is spoken for.
						return none unless first.kind() == SyntaxKind.Name || (first.isToken() && isNameToken(first.token()))
						return none when first.end() < offset
						let sep = first.nextSibling()
						return none when !(sep is none) && sep.isToken() && sep.start() < offset
						return node.parent
					case SyntaxKind.Args:
						return node when insideBrackets(node, TokenKind.LParen, TokenKind.RParen, offset)
						return none
					case SyntaxKind.Block, SyntaxKind.Body, SyntaxKind.FuncDecl, SyntaxKind.Lambda, SyntaxKind.StructLit, SyntaxKind.ArrayLit, SyntaxKind.Paren:
						return none
					default:
						let up = node.parent
						return none when up is none
						node = up
				}
			}
		}

		// nodeForCompletion is the innermost element the offset completes in:
		// the name token ending at the offset when one is being typed, else
		// the parent of the token whose full span holds the offset.
		internal def nodeForCompletion(file FileSymbols, offset int) ?SyntaxNode {
			if offset > 0 {
				let before = file.tree.find(offset - 1)
				return before.parent when !(before is none) && isTypedName(before) && before.end() == offset
			}
			let at = file.tree.find(offset)
			return none when at is none
			return at.parent
		}

		// insideBrackets is true when the offset is after the opening token
		// and not after the closing one (a missing closing token counts as
		// the end of the node).
		internal def insideBrackets(node SyntaxNode, open TokenKind, close TokenKind, offset int) bool {
			let opening = childToken(node, open)
			return false when opening is none
			return false when offset < opening.end()
			let closing = childToken(node, close)
			return offset <= node.end() when closing is none || closing.isMissing()
			return offset <= closing.start()
		}

		// childNode is the first direct child node of the kind.
		internal def childNode(node SyntaxNode, kind SyntaxKind) ?SyntaxNode {
			for let (_, c) in node.children() {
				return c when !c.isToken() && c.kind() == kind
			}
			return none
		}

		// childToken is the first direct child token of the kind.
		internal def childToken(node SyntaxNode, kind TokenKind) ?SyntaxNode {
			for let (_, c) in node.children() {
				return c when c.isToken() && c.token() == kind
			}
			return none
		}
	}
}
