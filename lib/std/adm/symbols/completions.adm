partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// fieldCompletions is the fields a struct literal can still name at
		// the offset: inside `Point{` or `{` in a typed place, at a key
		// position (after `{` or `,`, or in the key being typed), the fields
		// of the type that no earlier key gives. Empty anywhere else.
		def fieldCompletions(file FileSymbols, offset int) Symbol[] {
			let literal = literalKeySlot(file, offset)
			return [] when literal is none
			let made = typeRefSymbol(structLiteralRef(file, literal, 0))
			return [] when made is none
			// The keys of the entries before the offset are spoken for; the
			// entry the cursor is in is the one being typed.
			let given map<string, bool>
			for let (_, init) in literal.children() {
				continue unless init.kind() == SyntaxKind.FieldInit && init.end() < offset
				let key = init.child(0)
				continue when key is none
				given[key.text()] = true when key.kind() == SyntaxKind.Name
			}
			let out Symbol[]
			for let (_, m) in members(file, made) {
				continue unless m.kind == SymbolKind.Field || m.kind == SymbolKind.Property
				out.push(m) unless given.hasKey(m.name)
			}
			return out
		}

		// parameterCompletions is the parameters a call can still name at
		// the offset as `name = value`: inside `f(`, at an argument start
		// (after `(` or `,`, or in the name being typed), the parameters of
		// what is called that no earlier named argument gives. Empty
		// anywhere else.
		def parameterCompletions(file FileSymbols, offset int) Symbol[] {
			let args = argumentSlot(file, offset)
			return [] when args is none
			let owner = args.parent
			return [] when owner is none
			let fn = calledFunction(file, owner, 0)
			return [] when fn is none
			// Earlier arguments spoke for their parameters: the positional ones
			// for the first parameters in order, the named ones by name.
			let given map<string, bool>
			let positional = 0
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				continue unless arg.end() < offset
				let name = arg.child(0)
				continue when name is none
				if isNamedArgumentName(name) {
					given[name.text()] = true
				} else {
					positional++
				}
			}
			let out Symbol[]
			let home = homeOf(fn, file)
			for let (i, t) in parameterNames(fn.node) {
				continue when i < positional || given.hasKey(t.text())
				let param = home.symbolAt(t.start())
				out.push(param) unless param is none
			}
			return out
		}

		// literalKeySlot is the struct literal whose key position holds the
		// offset: between its braces, outside every value.
		internal def literalKeySlot(file FileSymbols, offset int) ?SyntaxNode {
			let start = nodeForCompletion(file, offset)
			return none when start is none
			let node = start
			for {
				switch node.kind() {
					case SyntaxKind.FieldInit:
						let sep = childToken(node, TokenKind.Colon)
						return none when !(sep is none) && sep.start() < offset
						return node.parent
					case SyntaxKind.StructLit:
						return node when insideBrackets(node, TokenKind.LBrace, TokenKind.RBrace, offset)
						return none
					case SyntaxKind.Block, SyntaxKind.Body, SyntaxKind.FuncDecl, SyntaxKind.Lambda, SyntaxKind.Args, SyntaxKind.ArrayLit, SyntaxKind.Paren:
						return none
					default:
						let up = node.parent
						return none when up is none
						node = up
				}
			}
		}

		// argumentSlot is the Args node whose argument-start position holds
		// the offset: between the parentheses, at the start of an argument
		// or in its first name.
		internal def argumentSlot(file FileSymbols, offset int) ?SyntaxNode {
			let start = nodeForCompletion(file, offset)
			return none when start is none
			let node = start
			for {
				switch node.kind() {
					case SyntaxKind.Arg:
						let first = node.child(0)
						return none when first is none
						// Past the first token of the argument, the name is spoken for.
						return none unless first.kind() == SyntaxKind.Name || (first.isToken() && isNameToken(first.token()))
						return none when first.end() < offset
						let sep = first.nextSibling()
						return none when !(sep is none) && sep.isToken() && sep.start() < offset
						return node.parent
					case SyntaxKind.Args:
						return node when insideBrackets(node, TokenKind.LParen, TokenKind.RParen, offset)
						return none
					case SyntaxKind.Block, SyntaxKind.Body, SyntaxKind.FuncDecl, SyntaxKind.Lambda, SyntaxKind.StructLit, SyntaxKind.ArrayLit, SyntaxKind.Paren:
						return none
					default:
						let up = node.parent
						return none when up is none
						node = up
				}
			}
		}

		// nodeForCompletion is the innermost element the offset completes in:
		// the name token ending at the offset when one is being typed, else
		// the parent of the token whose full span holds the offset.
		internal def nodeForCompletion(file FileSymbols, offset int) ?SyntaxNode {
			if offset > 0 {
				let before = file.tree.find(offset - 1)
				return before.parent when !(before is none) && before.isToken() && isNameToken(before.token()) && before.end() == offset
			}
			let at = file.tree.find(offset)
			return none when at is none
			return at.parent
		}

		// insideBrackets is true when the offset is after the opening token
		// and not after the closing one (a missing closing token counts as
		// the end of the node).
		internal def insideBrackets(node SyntaxNode, open TokenKind, close TokenKind, offset int) bool {
			let opening = childToken(node, open)
			return false when opening is none
			return false when offset < opening.end()
			let closing = childToken(node, close)
			return offset <= node.end() when closing is none || closing.isMissing()
			return offset <= closing.start()
		}

		// childToken is the first direct child token of the kind.
		internal def childToken(node SyntaxNode, kind TokenKind) ?SyntaxNode {
			for let (_, c) in node.children() {
				return c when c.isToken() && c.token() == kind
			}
			return none
		}
	}
}
