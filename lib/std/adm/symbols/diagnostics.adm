partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// UnresolvedName is a plain name in a file that leads to no declaration
	// the workspace knows: the token and its text.
	struct UnresolvedName {
		token SyntaxNode
		name  string
	}

	// NameProblemKind is what a name problem is.
	enum NameProblemKind {
		// A plain name no declaration answers.
		Unresolved       = "unresolved name",
		// `x.name` where x's type (or module) is known and has no such member.
		UnknownMember    = "unknown member",
		// `Point{name: ...}` where Point has no such field.
		UnknownField     = "unknown field",
		// `f(name = ...)` where f has no such parameter.
		UnknownParameter = "unknown parameter"
	}

	// NameProblem is a name the IDE can mark: the token, its text, what is
	// wrong, and the declaration it was looked up in (the receiver's type,
	// the literal's type, the callee) when there is one.
	struct NameProblem {
		token SyntaxNode
		name  string
		kind  NameProblemKind
		owner ?Symbol
	}

	// universalMembers is what every value has, provided by the compiler
	// rather than declared: `str()`, the value tags.
	internal const universalMembers = ["str", "tags"]

	partial type Navigator {
		// unresolvedNames is every plain name of the file (a Name node, not
		// a member after `.`, a struct literal key or a named argument) that
		// `definitionAt` cannot resolve. Names inside view and style bodies
		// are left out, since those bodies predeclare their own names, as
		// are `_`, `$name` sigils and annotation names. Over a workspace that holds every
		// file a program and its imports consist of, with the prelude, each
		// is an undefined name or a gap of this layer.
		def unresolvedNames(file FileSymbols) UnresolvedName[] {
			let out UnresolvedName[]
			for let (_, t) in file.tree.root().tokens() {
				continue unless t.token() == TokenKind.Ident
				// `_` names nothing; a `$name` sigil is a style's bound value.
				continue when t.text() == "_" || t.text().startsWith("$")
				let parent = t.parent
				continue when parent is none
				continue unless parent.kind() == SyntaxKind.Name
				continue when isStructKeyName(t) && !isMapLiteralKey(file, t)
				let owner = parent.parent
				continue when !(owner is none) && owner.kind() == SyntaxKind.Attribute
				continue when inViewOrStyle(parent)
				continue when definitionAt(file, t.start()).len() > 0
				out.push(UnresolvedName{token: t, name: t.text()})
			}
			return out
		}

		// nameProblems is every name problem of the file: the unresolved plain
		// names, and the members, struct literal keys and named arguments
		// that name nothing where the type they are looked up in is known.
		// A receiver, literal or callee this layer cannot type is never
		// reported, nor are the members every value has (`str()`, `tags`),
		// a primitive's members from any prelude extension, or a component
		// call's reserved arguments (`ref`, `key`, `style`).
		def nameProblems(file FileSymbols) NameProblem[] {
			let out NameProblem[]
			for let (_, u) in unresolvedNames(file) {
				out.push(NameProblem{token: u.token, name: u.name, kind: NameProblemKind.Unresolved, owner: none})
			}
			for let (_, t) in file.tree.root().tokens() {
				continue unless isNameToken(t.token())
				let parent = t.parent
				continue when parent is none
				if parent.kind() == SyntaxKind.Member {
					let problem = memberProblem(file, parent, t)
					out.push(problem) unless problem is none
					continue
				}
				if isStructKeyName(t) && !isMapLiteralKey(file, t) {
					let problem = keyProblem(file, t)
					out.push(problem) unless problem is none
					continue
				}
				if isNamedArgumentName(t) {
					let problem = argumentProblem(file, t)
					out.push(problem) unless problem is none
				}
			}
			out.sort((a NameProblem, b NameProblem) => a.token.start() < b.token.start())
			return out
		}

		// memberProblem is the problem with `receiver.name` when the
		// receiver's type or module is known and has no such member.
		internal def memberProblem(file FileSymbols, member SyntaxNode, nameToken SyntaxNode) ?NameProblem {
			let kids = member.children()
			return none when kids.len() < 3
			return none unless kids[kids.len() - 1].same(nameToken)
			let name = nameToken.text()
			return none when name in universalMembers
			return none unless memberTarget(file, member, 0) is none
			let receiver = kids[0]
			let owner = symbolOf(file, receiver)
			if !(owner is none) {
				return NameProblem{token: nameToken, name: name, kind: NameProblemKind.UnknownMember, owner: owner} when owner.kind == SymbolKind.Import && owner.imported.len() == 0 && !owner.wildcard
				return NameProblem{token: nameToken, name: name, kind: NameProblemKind.UnknownMember, owner: owner} when isTypeLike(owner.kind) && isClosedType(owner)
				return none when isTypeLike(owner.kind) || owner.kind == SymbolKind.Import
			}
			let receiverType = typeOf(file, receiver)
			return none when receiverType is none
			return none unless isClosedType(receiverType)
			return NameProblem{token: nameToken, name: name, kind: NameProblemKind.UnknownMember, owner: receiverType}
		}

		// isClosedType is true for a declaration whose members this layer
		// knows in full: a struct, type, enum, union, datatype, component or
		// service of a program or std, not an interface (a value of an
		// interface type may be narrowed), not a prelude primitive (its
		// members come from every `@builtin(for = ...)` extension too), not
		// a type parameter.
		internal def isClosedType(symbol Symbol) bool {
			return false when symbol.kind == SymbolKind.Interface || symbol.kind == SymbolKind.TypeParameter || symbol.kind == SymbolKind.Style
			return false unless isTypeLike(symbol.kind)
			return false when symbol.path.startsWith("builtin.")
			// `type Effect = Blur | Glow` or `type OID = int[]`: a value may be
			// narrowed to a variant, or have the target's members.
			let target = aliasTarget(symbol.node)
			return false when !(target is none) && target.kind() != SyntaxKind.NamedType
			// An annotated type may get members from a meta at build time
			// (`@icons("dir")` declares one per file).
			return symbol.annotations.len() == 0
		}

		// keyProblem is the problem with a struct literal key that names no
		// field of the literal's known type.
		internal def keyProblem(file FileSymbols, token SyntaxNode) ?NameProblem {
			return none unless structKey(file, token) is none
			let name = token.parent
			return none when name is none
			let init = name.parent
			return none when init is none
			let literal = init.parent
			return none when literal is none
			let made = typeRefSymbol(structLiteralRef(file, literal, 0))
			return none when made is none
			return none unless isClosedType(made)
			return NameProblem{token: token, name: token.text(), kind: NameProblemKind.UnknownField, owner: made}
		}

		// argumentProblem is the problem with a named argument that names no
		// parameter of the known callee.
		internal def argumentProblem(file FileSymbols, token SyntaxNode) ?NameProblem {
			return none unless namedArgument(file, token) is none
			let arg = token.parent
			return none when arg is none
			let args = arg.parent
			return none when args is none
			let owner = args.parent
			return none when owner is none
			let name = token.text()
			// A call handed a function as a positional argument may name that
			// function's parameters (`new ShaderPaint(ripple, center = c)`).
			return none when forwardsToFunction(file, args)
			if owner.kind() == SyntaxKind.ComponentCall {
				return none when name := "ref" || "key" || "style"
				let callee = owner.child(0)
				return none when callee is none
				let comp = symbolOf(file, callee)
				return none when comp is none
				return none unless comp.kind == SymbolKind.Component
				return NameProblem{token: token, name: name, kind: NameProblemKind.UnknownParameter, owner: comp}
			}
			let fn = calledFunction(file, owner, 0)
			if !(fn is none) {
				// A prelude method may have overloads in another extension type.
				return none when fn.path.startsWith("builtin.")
				return NameProblem{token: token, name: name, kind: NameProblemKind.UnknownParameter, owner: fn}
			}
			// `Point(x = 1)` or a component placed outside a view: the type's
			// constructor parameters and fields were searched already.
			return none unless owner.kind() == SyntaxKind.Call
			let callee = owner.child(0)
			return none when callee is none
			for let (_, made) in calleeOverloads(file, callee) {
				return none unless isTypeLike(made.kind) && isClosedType(made)
				return none when name := "ref" || "key" || "style"
				return NameProblem{token: token, name: name, kind: NameProblemKind.UnknownParameter, owner: made}
			}
			return none
		}

		// forwardsToFunction is true when a positional argument of the call
		// names a function, whose parameters the named arguments may fill.
		internal def forwardsToFunction(file FileSymbols, args SyntaxNode) bool {
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				let head = arg.child(0)
				continue when head is none
				continue when isNamedArgumentName(head)
				continue unless head.kind() == SyntaxKind.Name || head.kind() == SyntaxKind.Member
				let sym = symbolOf(file, head)
				continue when sym is none
				return true when sym.kind == SymbolKind.Function || sym.kind == SymbolKind.Method
			}
			return false
		}

		// inViewOrStyle is true for a node inside a view or style
		// declaration or a `view { }` expression.
		internal def inViewOrStyle(n SyntaxNode) bool {
			return true unless n.ancestor(SyntaxKind.ViewDecl) is none
			return true unless n.ancestor(SyntaxKind.StyleDecl) is none
			return !(n.ancestor(SyntaxKind.ViewExpr) is none)
		}
	}
}
