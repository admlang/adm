partial module std.adm.symbols {
	// DocTag is one `@name text` line at the end of a doc comment
	// (`@see Buffer.readFrom`). Text runs on to the lines below until the
	// next tag.
	struct DocTag {
		name string
		text string
	}

	// DocExample is a usage example lifted out of a doc comment: a fenced
	// block whose language is `example`, titled by the paragraph above it
	// with any `Example:` label removed.
	struct DocExample {
		title string
		code  string
	}

	// DocTagGroup is every value of one tag name, in order of appearance,
	// under the label a renderer shows (`See Also` for `@see`).
	struct DocTagGroup {
		name   string
		label  string
		values string[]
	}

	// Doc is a doc comment taken apart the way `adm doc` and the compiler's
	// hover take it: the description, the examples lifted out of it, and
	// the trailing tags.
	struct Doc {
		description string
		examples    DocExample[]
		tags        DocTag[]
	}

	// parseDoc takes a doc comment apart: its `example` fences become
	// examples (each titled by the paragraph above it), the `@tag` lines it
	// ends in become tags, and what is left is the description with runs of
	// blank lines reduced to one.
	def parseDoc(text string) Doc {
		let examples DocExample[]
		let withoutExamples = splitExamples(text, examples)
		let tags DocTag[]
		let description = splitTags(withoutExamples, tags)
		return Doc{description: description.trim(), examples: examples, tags: tags}
	}

	// splitExamples removes the `example` fences from the comment, adding
	// them to `into`; the result is the comment without them.
	internal def splitExamples(text string, into DocExample[]) string {
		return text unless text.contains("```example")
		let lines = text.split("\n")
		let rest string[]
		let i = 0
		for i < lines.len() {
			if !isExampleFence(lines[i]) {
				rest.push(lines[i])
				i++
				continue
			}
			// The title is the paragraph the fence follows, taken back out
			// of the rest.
			let title string[]
			for rest.len() > 0 && rest[rest.len() - 1].trim().len() > 0 {
				title.push(rest[rest.len() - 1].trim())
				rest.len(rest.len() - 1)
			}
			title.reverse()
			let code string[]
			i++
			for i < lines.len() {
				break when lines[i].trim() == "```"
				code.push(lines[i])
				i++
			}
			i++
			into.push(DocExample{title: exampleTitle(title), code: dedent(code)})
		}
		return collapseBlank(rest)
	}

	internal def isExampleFence(line string) bool {
		let t = line.trim()
		return false unless t.startsWith("```")
		return t[3:].trim() == "example"
	}

	// exampleTitle joins the title lines and drops a leading `Example:` or
	// `Examples:` label.
	internal def exampleTitle(lines string[]) string {
		let title = lines.join(" ")
		for let (_, label) in ["Examples:", "Example:", "examples:", "example:"] {
			if title.startsWith(label) {
				title = title[label.len():]
				break
			}
		}
		return title.trim()
	}

	// dedent removes the indentation every non-blank line shares and the
	// blank lines at both ends.
	internal def dedent(lines string[]) string {
		let indent = -1
		for let (_, l) in lines {
			continue when l.trim().len() == 0
			let n = l.len() - l.trimStart(" \t").len()
			indent = n when indent < 0 || n < indent
		}
		let out string[]
		for let (_, l) in lines {
			if l.trim().len() == 0 {
				out.push("")
				continue
			}
			out.push(l[indent:])
		}
		let from = 0
		for from < out.len() && out[from].len() == 0 {
			from++
		}
		let to = out.len()
		for to > from && out[to - 1].len() == 0 {
			to--
		}
		return out[from:to].join("\n")
	}

	// collapseBlank joins the lines with runs of blank lines reduced to one
	// and the blank lines at both ends removed.
	internal def collapseBlank(lines string[]) string {
		let out string[]
		for let (_, l) in lines {
			if l.trim().len() == 0 {
				continue when out.len() == 0 || out[out.len() - 1].len() == 0
				out.push("")
				continue
			}
			out.push(l)
		}
		for out.len() > 0 && out[out.len() - 1].len() == 0 {
			out.len(out.len() - 1)
		}
		return out.join("\n")
	}

	// splitTags removes the trailing `@tag` lines from the comment, adding
	// them to `into`; the result is the comment without them. An `@` line
	// the prose resumes after is prose: the tags are the run of tag lines
	// (and their continuation lines) that reaches the end.
	internal def splitTags(text string, into DocTag[]) string {
		return text unless text.contains("@")
		let lines = text.split("\n")
		for let (start, line) in lines {
			continue unless isTagLine(line.trim())
			let tags DocTag[]
			continue unless parseTags(lines[start:], tags)
			for let (_, t) in tags {
				into.push(t)
			}
			return collapseBlank(lines[:start])
		}
		return text
	}

	// parseTags reads tag lines and their continuations to the end of the
	// comment into `into`; false when a line that is neither follows a blank
	// line or comes before the first tag.
	internal def parseTags(lines string[], into DocTag[]) bool {
		let afterBlank = false
		for let (_, raw) in lines {
			let line = raw.trim()
			if line.len() == 0 {
				afterBlank = true
				continue
			}
			if isTagLine(line) {
				into.push(tagOf(line))
				afterBlank = false
				continue
			}
			return false when into.len() == 0 || afterBlank
			let last = into[into.len() - 1]
			last.text = last.text.len() == 0 ?? (line, last.text + " " + line)
		}
		return into.len() > 0
	}

	// isTagLine is true for `@name` or `@name text`: a letter after the `@`,
	// then letters, digits, `_` and `-`, then the end or white space.
	internal def isTagLine(line string) bool {
		return false unless line.startsWith("@")
		let end = tagNameEnd(line)
		return false when end < 2
		return end == line.len() || line[end] == ' ' || line[end] == '\t'
	}

	// tagNameEnd is the index after the tag's name, 1 when there is none.
	internal def tagNameEnd(line string) int {
		let end = 1
		return end when end >= line.len() || !line[end].isLetter()
		for end < line.len() {
			let c = line[end]
			break unless c.isAlphanumeric() || c == '_' || c == '-'
			end++
		}
		return end
	}

	internal def tagOf(line string) DocTag {
		let end = tagNameEnd(line)
		return DocTag{name: line[1:end], text: line[end:].trim()}
	}

	// tagLabel is the heading a tag renders under: the Java names spelled
	// out (`Author`, `See Also`, `Since`, `Deprecated`), anything else
	// capitalised.
	def tagLabel(name string) string {
		switch name.lower() {
			case "author":
				return "Author"
			case "see":
				return "See Also"
			case "since":
				return "Since"
			case "deprecated":
				return "Deprecated"
			case "":
				return ""
			default:
				return name.capitalize()
		}
	}

	// groupTags collects the tags by name in the order a reader expects:
	// Author, See Also, Since, then the rest as they first appear.
	def groupTags(tags DocTag[]) DocTagGroup[] {
		let groups DocTagGroup[]
		let index map<string, int>
		for let (_, t) in tags {
			let key = t.name.lower()
			if !index.hasKey(key) {
				index[key] = groups.len()
				groups.push(DocTagGroup{name: key, label: tagLabel(t.name), values: []})
			}
			groups[index[key]].values.push(t.text)
		}
		// Stable: the known names first by rank, the rest keep their order.
		for let i = 1; i < groups.len(); i++ {
			for let j = i; j > 0 && tagRank(groups[j].name) < tagRank(groups[j - 1].name); j-- {
				let moved = groups[j]
				groups[j] = groups[j - 1]
				groups[j - 1] = moved
			}
		}
		return groups
	}

	internal def tagRank(name string) int {
		switch name {
			case "author":
				return 0
			case "see":
				return 1
			case "since":
				return 2
			default:
				return 3
		}
	}
}
