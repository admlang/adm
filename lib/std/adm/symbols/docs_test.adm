partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	check "Docs" {
		@test()
		def TestParseDoc() {
			let text = "Parses a colour from any supported notation.\n\n\nIt never fails on grey.\n\nExample: From a hex string\n```example\n  use std.gfx.color\n\n  let c = color.parse(\"#ff8800\")!\n```\n\nSee the formats:\n```\ncolor.parse(\"red\")\n```\n@author Ada Lovelace\n@see Writer\n@see Buffer.readFrom\n  continued here\n@since 0.2\n@note keep it\n  short"
			let doc = parseDoc(text)
			assert doc.description == "Parses a colour from any supported notation.\n\nIt never fails on grey.\n\nSee the formats:\n```\ncolor.parse(\"red\")\n```"
			assert doc.examples.len() == 1
			assert doc.examples[0].title == "From a hex string"
			assert doc.examples[0].code == "use std.gfx.color\n\nlet c = color.parse(\"#ff8800\")!"
			assert doc.tags.len() == 5
			assert doc.tags[0].name == "author" && doc.tags[0].text == "Ada Lovelace"
			assert doc.tags[2].name == "see" && doc.tags[2].text == "Buffer.readFrom continued here"
			assert doc.tags[4].name == "note" && doc.tags[4].text == "keep it short"
			let groups = groupTags(doc.tags)
			assert groups.len() == 4
			assert groups[0].label == "Author" && groups[1].label == "See Also" && groups[2].label == "Since" && groups[3].label == "Note"
			assert groups[1].values.join("|") == "Writer|Buffer.readFrom continued here"
			// Tags come after the description: an `@` line the prose resumes
			// after is prose, and so is a tag followed by a blank line and prose.
			let prose = parseDoc("Sends to @channel names.\nMore prose.")
			assert prose.tags.len() == 0 && prose.description == "Sends to @channel names.\nMore prose."
			let resumed = parseDoc("Reader wraps Read.\n@see Writer\n\nThen prose again.")
			assert resumed.tags.len() == 0 && resumed.description.endsWith("Then prose again.")
			// A tag without text, a tag whose name ends the line, a label that
			// is not a tag.
			let bare = parseDoc("Thing.\n@deprecated\n@since")
			assert bare.tags.len() == 2 && bare.tags[0].text == "" && tagLabel(bare.tags[0].name) == "Deprecated"
			assert parseDoc("Thing.\n@see: x").tags.len() == 0
			assert tagLabel("") == "" && tagLabel("Note") == "Note" && tagLabel("warning") == "Warning"
			// Several examples: the paragraph right above a fence is its title
			// (as `adm doc` reads it), a bare label leaves no title.
			let many = parseDoc("Does things.\n```example\nf()\n```\nExample:\n```example\n\tg()\n\th()\n```\nTail.")
			assert many.examples.len() == 2 && many.examples[0].title == "Does things." && many.examples[1].title == ""
			assert many.examples[1].code == "g()\nh()" && many.description == "Tail."
			let untitled = parseDoc("Does things.\n\n```example\nf()\n```")
			assert untitled.examples[0].title == "" && untitled.description == "Does things."
			assert parseDoc("").description == "" && parseDoc("").examples.len() == 0 && parseDoc("").tags.len() == 0
		}

		@test()
		def TestHover() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			let lib = w.add("lib.adm", parse(libSource()))
			let source = appSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let onRead = presentHover(nav.hoverAt(app, source.indexOf("read(1)")))
			assert onRead.symbol.path == "lib.File.read" && onRead.moduleName == "lib"
			assert onRead.signature == "def read(n int) !string" && onRead.valueType is none
			let onFile = presentHover(nav.hoverAt(app, source.indexOf("f File") + 2))
			assert onFile.doc.description == "File is a file." && onFile.signature == "type File" && onFile.valueType is none
			let onParam = presentHover(nav.hoverAt(app, source.indexOf("f File")))
			assert onParam.symbol.kind == SymbolKind.Parameter && onParam.moduleName == "app"
			assert pathOf(onParam.valueType) == "lib.File"
			let onLocal = presentHover(nav.hoverAt(app, source.indexOf("let opened") + 4))
			assert pathOf(onLocal.valueType) == "lib.File" && onLocal.signature == "opened"
			assert nav.hoverAt(app, source.indexOf("module app")) is none
			let direct = nav.hover(app, w.lookup("lib", "open")[0])
			assert direct.signature == "def open(path string) !File" && direct.moduleName == "lib" && direct.doc.description == ""
			assert nav.moduleOf(w.lookup("lib", "Base")[0], lib) == "lib"
		}
	}

	// presentHover is the hover, which the test expects to be there.
	internal def presentHover(value ?Hover) Hover {
		return value unless value is none
		assert false
		let w = new Workspace()
		let f = w.add("none.adm", parse(""))
		return Hover{symbol: new Symbol(SymbolKind.Local, "", f.tree.root(), 0, 0), moduleName: "", signature: "", valueType: none, doc: parseDoc("")}
	}
}
