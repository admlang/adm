partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// InlayHintKind is what an inlay hint shows.
	enum InlayHintKind {
		// The inferred type of a name declared without one.
		Type      = "type",
		// The name of the parameter a literal argument passes to.
		Parameter = "parameter"
	}

	// InlayHint is text an editor shows inside the code without it being
	// there: a type after a name (`let count` shows `int` at `offset`, the
	// end of the name), a parameter's name before an argument (`f(true)`
	// shows `visible` at the argument's start).
	struct InlayHint {
		kind   InlayHintKind
		offset int
		label  string
	}

	partial type Navigator {
		// inlayHints is the hints for the part of the file from `start` to
		// `end` (the lines shown): the inferred type of each `let`, `const`
		// and loop variable written without one, when this layer knows it
		// whole; the parameter's name before each literal passed by
		// position. In source order.
		def inlayHints(file FileSymbols, start int, end int) InlayHint[] {
			freshQuery()
			let out InlayHint[]
			collectHints(file, file.tree.root(), start, end, out)
			return out
		}

		// collectHints adds the hints of the node and those below it that
		// overlap the range, going into no other subtree.
		internal def collectHints(file FileSymbols, node SyntaxNode, start int, end int, out InlayHint[]) {
			let k = node.kind()
			if k == SyntaxKind.Field {
				typeHints(file, node, start, end, out)
			} else if k == SyntaxKind.Arg {
				parameterHint(file, node, start, end, out)
			}
			for let (_, c) in node.children() {
				continue when c.isToken()
				continue when c.end() < start || c.fullStart() >= end
				collectHints(file, c, start, end, out)
			}
		}

		// typeHints adds the type of each name a `let` or `const` field
		// declares without a written type, a loop variable's included.
		internal def typeHints(file FileSymbols, field SyntaxNode, start int, end int, out InlayHint[]) {
			let decl = field.parent
			return when decl is none
			return unless decl.kind() == SyntaxKind.LetDecl || decl.kind() == SyntaxKind.ConstDecl
			for let (_, c) in field.children() {
				return when isTypeNode(c.kind())
			}
			for let (_, c) in field.children() {
				continue unless c.isToken() && c.token() == TokenKind.Ident
				continue when c.start() < start || c.start() >= end
				let symbol = file.symbolAt(c.start())
				continue when symbol is none
				let t = valueTypeOf(file, symbol, 0)
				continue when t.isUnknown()
				out.push(InlayHint{kind: InlayHintKind.Type, offset: c.end(), label: t.str()})
			}
		}

		// parameterHint adds the name of the parameter a literal argument
		// passes to by position.
		internal def parameterHint(file FileSymbols, arg SyntaxNode, start int, end int, out InlayHint[]) {
			let head = arg.child(0)
			return when head is none
			return when head.start() < start || head.start() >= end
			return when isNamedArgumentName(head)
			return unless isLiteralArgument(head)
			let args = arg.parent
			return when args is none
			let call = args.parent
			return when call is none || call.kind() != SyntaxKind.Call
			let target = callTarget(file, call, 0)
			return when target is none
			let position = 0
			for let (_, a) in args.children() {
				continue unless a.kind() == SyntaxKind.Arg
				break when a.same(arg)
				let first = a.child(0)
				position++ unless first is none || isNamedArgumentName(first)
			}
			let names = parameterNames(target.fn.node)
			return when names.len() == 0
			let at = position
			at = names.len() - 1 when position >= names.len() && isVariadic(target.fn.node)
			return when at >= names.len()
			out.push(InlayHint{kind: InlayHintKind.Parameter, offset: head.start(), label: names[at].text()})
		}

		// isLiteralArgument is true for a literal argument, a signed number
		// included: what an argument's position alone does not explain.
		internal def isLiteralArgument(expr SyntaxNode) bool {
			switch expr.kind() {
				case SyntaxKind.Literal, SyntaxKind.InterpString:
					return true
				case SyntaxKind.Unary:
					let operand = firstNonToken(expr)
					return isSign(expr.child(0)) && !(operand is none) && operand.kind() == SyntaxKind.Literal
				default:
					return false
			}
		}
	}
}
