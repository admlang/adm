partial module std.adm.symbols {
	// Hover is what an editor shows for the symbol under the cursor: the
	// declaration, the module that declares it, its heading (`def open(path
	// string) !File`), the type of its value when it is not callable, and
	// its doc comment taken apart.
	struct Hover {
		symbol     Symbol
		moduleName string
		signature  string
		valueType  ?Symbol
		doc        Doc
	}

	partial type Navigator {
		// hoverAt is the hover for the token at the offset, none when no
		// declaration is known there.
		def hoverAt(file FileSymbols, offset int) ?Hover {
			let found = definitionAt(file, offset)
			return none when found.len() == 0
			return hover(file, found[0])
		}

		// hover is the hover of a declaration: its signature, the type of
		// its value (a field's, a parameter's, a local's, a property's) and
		// its parsed doc comment.
		def hover(file FileSymbols, symbol Symbol) Hover {
			let valueType ?Symbol = none
			switch symbol.kind {
				case SymbolKind.Field, SymbolKind.Parameter, SymbolKind.Local, SymbolKind.Const, SymbolKind.Property, SymbolKind.EnumMember, SymbolKind.UnionMember:
					valueType = symbolType(file, symbol, 0)
				default:
					valueType = none
			}
			return Hover{symbol: symbol, moduleName: moduleOf(symbol, file), signature: signature(symbol), valueType: valueType, doc: parseDoc(symbol.doc)}
		}

		// moduleOf is the path of the unit that declares the symbol, "" when
		// the declaring file is not in the workspace.
		def moduleOf(symbol Symbol, asking FileSymbols) string {
			let home = homeOf(symbol, asking)
			let unit = home.unitAt(symbol.nameStart)
			return "" when unit is none
			return unit.path
		}
	}
}
