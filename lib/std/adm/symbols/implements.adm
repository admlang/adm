partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode, parse)
	)

	partial type Navigator {
		// Type-like declarations by the names of their members, embedded
		// types' members included; built on first use for the workspace's
		// version it was built for.
		internal memberIndex    map<string, Symbol[]>
		internal indexedVersion int                   = -1
		// The members of each declaration the matcher looked at, for the
		// workspace version `membersVersion`.
		internal membersCache   map<string, Symbol[]>
		internal membersVersion int                   = -1

		// implementers is every declaration of the workspace that satisfies
		// the interface or datatype ("implemented by"), the contract itself
		// left out, each partial type once.
		def implementers(contract Symbol) Symbol[] {
			let out Symbol[]
			return out unless contract.kind == SymbolKind.Interface || contract.kind == SymbolKind.Datatype
			let home = homeOrAnyFile(contract)
			let required = requiredMembers(home, contract)
			return out when required.len() == 0
			buildMemberIndex()
			let seen map<string, bool>
			for let (_, candidate) in candidatesFor(required) {
				continue when sameDeclaration(candidate, contract)
				let key = candidate.kind.value + " " + candidate.path
				continue when seen.hasKey(key)
				seen[key] = true
				out.push(candidate) when satisfies(candidate, contract)
			}
			return out
		}

		// contracts is every interface and datatype of the workspace the
		// declaration satisfies ("implements"), itself left out.
		def contracts(symbol Symbol) Symbol[] {
			let out Symbol[]
			return out unless isImplementerKind(symbol.kind)
			for let (_, kind) in [SymbolKind.Interface, SymbolKind.Datatype] {
				for let (_, contract) in workspace.declarationsOfKind(kind) {
					continue when sameDeclaration(contract, symbol)
					out.push(contract) when satisfies(symbol, contract)
				}
			}
			return out
		}

		// satisfies is true when the declaration exposes every method of the
		// interface (same name, parameter count, parameter and return types)
		// or every field of the datatype (same name and type), as the
		// compiler's implicit implementation rule reads them from declared
		// types: a type parameter on either side matches anything, a type
		// alias stands for its target, and a type this layer cannot resolve
		// matches nothing.
		def satisfies(symbol Symbol, contract Symbol) bool {
			return false unless isImplementerKind(symbol.kind)
			return false unless contract.kind == SymbolKind.Interface || contract.kind == SymbolKind.Datatype
			let contractHome = homeOrAnyFile(contract)
			let required = requiredMembers(contractHome, contract)
			return false when required.len() == 0
			let have = cachedMembers(symbol, contractHome)
			let home = homeOf(symbol, contractHome)
			for let (_, r) in required {
				let found = false
				for let (_, m) in have {
					continue unless m.name == r.name
					continue unless memberMatches(home, m, contractHome, r)
					found = true
					break
				}
				return false unless found
			}
			return true
		}

		// requiredMembers is what the contract asks for: an interface's
		// methods, a datatype's fields and properties, embedded contracts'
		// included.
		internal def requiredMembers(home FileSymbols, contract Symbol) Symbol[] {
			let out Symbol[]
			for let (_, m) in cachedMembers(contract, home) {
				if contract.kind == SymbolKind.Interface {
					out.push(m) when m.kind == SymbolKind.Method
				} else {
					out.push(m) when m.kind == SymbolKind.Field || m.kind == SymbolKind.Property
				}
			}
			return out
		}

		// memberMatches is true when the declaration's member stands for the
		// contract's: a method with the same parameter count, variadic
		// flag, parameter types and return type; a field or property with
		// the same type.
		internal def memberMatches(home FileSymbols, m Symbol, contractHome FileSymbols, r Symbol) bool {
			if r.kind == SymbolKind.Method {
				return false unless m.kind == SymbolKind.Method
				let have = parameterNames(m.node)
				let want = parameterNames(r.node)
				return false when have.len() != want.len()
				return false when isVariadic(m.node) != isVariadic(r.node)
				for let (i, w) in want {
					let wantType = parameterType(contractHome, w)
					let haveType = parameterType(home, have[i])
					return false unless sameWrittenType(haveType, wantType, 0)
				}
				return sameWrittenType(returnRef(home, m), returnRef(contractHome, r), 0)
			}
			return false unless m.kind == SymbolKind.Field || m.kind == SymbolKind.Property
			return sameWrittenType(declaredRef(home, m), declaredRef(contractHome, r), 0)
		}

		// parameterType is the written type of the parameter a name token
		// declares (`a, b int` share one).
		internal def parameterType(file FileSymbols, nameToken SyntaxNode) ?TypeRef {
			let param = nameToken.parent
			return none when param is none
			let written = writtenTypeOf(param)
			return none when written is none
			return TypeRef{file: file, node: written, bindings: noBindings()}
		}

		internal def returnRef(file FileSymbols, fn Symbol) ?TypeRef {
			let written = returnTypeOf(fn.node)
			return none when written is none
			return TypeRef{file: file, node: written, bindings: noBindings()}
		}

		internal def declaredRef(file FileSymbols, symbol Symbol) ?TypeRef {
			let written = declaredType(symbol)
			return none when written is none
			return TypeRef{file: file, node: written, bindings: noBindings()}
		}

		// isVariadic is true for a function whose last parameter is `...T`.
		internal def isVariadic(fn SyntaxNode) bool {
			let params = childOfKind(fn, SyntaxKind.Params)
			return false when params is none
			for let (_, t) in params.tokens() {
				return true when t.token() == TokenKind.Ellipsis
			}
			return false
		}

		// sameWrittenType is true when two written types are one type: both
		// absent (a method without a return type), or the same modifiers
		// around the same type, the same element type of an array, the same
		// declaration with the same type arguments; a type parameter on
		// either side matches anything. A spelling this layer cannot resolve
		// matches only itself, text for text.
		internal def sameWrittenType(a ?TypeRef, b ?TypeRef, depth int) bool {
			return true when a is none && b is none
			return false when a is none || b is none
			return false when depth > maxDepth
			return true when isTypeParameterRef(a) || isTypeParameterRef(b)
			// Bindings only: the modifiers stay, `string` is not `!string`.
			let x = boundOnly(a)
			let y = boundOnly(b)
			return false when x.node.kind() != y.node.kind()
			switch x.node.kind() {
				case SyntaxKind.ModifiedType:
					return false unless modifiersOf(x.node) == modifiersOf(y.node)
					let innerX = firstNonToken(x.node)
					let innerY = firstNonToken(y.node)
					return false when innerX is none || innerY is none
					return sameWrittenType(TypeRef{file: x.file, node: innerX, bindings: x.bindings}, TypeRef{file: y.file, node: innerY, bindings: y.bindings}, depth + 1)
				case SyntaxKind.ArrayType:
					return sameWrittenType(elementRef(x), elementRef(y), depth + 1)
				case SyntaxKind.NamedType:
					// Primitives share one prelude type (`Number`): compare them by
					// name, `int` is not `float`.
					let px = primitiveSpelling(x)
					let py = primitiveSpelling(y)
					return px == py when px.len() > 0 || py.len() > 0
					let sx = typeSymbol(x.file, x.node)
					let sy = typeSymbol(y.file, y.node)
					// `none` in `!none`, a type from a module the workspace
					// lacks.
					return x.node.text() == y.node.text() when sx is none || sy is none
					return false unless sameDeclaration(sx, sy)
					let argsX = typeArgsOf(x.node)
					let argsY = typeArgsOf(y.node)
					return false when argsX.len() != argsY.len()
					for let (i, ax) in argsX {
						return false unless sameWrittenType(TypeRef{file: x.file, node: ax, bindings: x.bindings}, TypeRef{file: y.file, node: argsY[i], bindings: y.bindings}, depth + 1)
					}
					return true
				default:
					return x.node.text() == y.node.text()
			}
		}

		// primitiveSpelling is the name of a primitive type a written type
		// spells (`int`, `float32`, `string`), "" for anything else or a name
		// a declaration in scope shadows.
		internal def primitiveSpelling(ref TypeRef) string {
			return "" unless ref.node.kind() == SyntaxKind.NamedType && ref.node.childCount() == 1
			let t = ref.node.firstToken()
			return "" when t is none
			let found = workspace.resolve(ref.file, t.text(), t.start())
			// The prelude's own `type string` declares the primitive's
			// members; it shadows nothing.
			if found.len() == 0 || isPrimitiveDeclaration(found[0], t.text()) {
				return t.text() when primitiveTypeName(t.text()).len() > 0
				return ""
			}
			// `type Text = string` spells a primitive through its alias.
			let alias = found[0]
			return "" unless alias.kind == SymbolKind.Type
			let target = aliasTarget(alias.node)
			return "" when target is none
			return "" unless target.kind() == SyntaxKind.NamedType
			return primitiveSpelling(TypeRef{file: homeOf(alias, ref.file), node: target, bindings: noBindings()})
		}

		// isPrimitiveDeclaration is true for the prelude type that declares
		// the members of the primitive it is named after (`type string`), as
		// opposed to an alias (`type Text = string`).
		internal def isPrimitiveDeclaration(found Symbol, name string) bool {
			return found.path == "builtin." + name && aliasTarget(found.node) is none
		}

		// isTypeParameterRef is true for a written type that names a type
		// parameter of the declaration it stands in, unbound.
		internal def isTypeParameterRef(ref TypeRef) bool {
			let actual = boundOnly(ref)
			return false unless actual.node.kind() == SyntaxKind.NamedType && actual.node.childCount() == 1
			let sym = typeSymbol(actual.file, actual.node)
			return false when sym is none
			return sym.kind == SymbolKind.TypeParameter
		}

		// boundOnly replaces a bound type parameter by its binding, as
		// `followBindings` does, but leaves `?`, `!` and `async` in place.
		internal def boundOnly(ref TypeRef) TypeRef {
			let current = ref
			for let i = 0; i < 16; i++ {
				let node = current.node
				return current unless node.kind() == SyntaxKind.NamedType && node.childCount() == 1
				let t = node.firstToken()
				return current when t is none
				return current unless current.bindings.hasKey(t.text())
				current = current.bindings[t.text()]
			}
			return current
		}

		// modifiersOf is the modifier tokens of a modified type in order
		// (`?!` for `?!T`), for comparison.
		internal def modifiersOf(node SyntaxNode) string {
			let out = ""
			for let (_, c) in node.children() {
				out += c.text() when c.isToken()
			}
			return out
		}

		// cachedMembers is `members` remembered for the workspace's version.
		// It leaves the index alone: matching one declaration (a meta's
		// constraint) loads no file the two types do not reach.
		internal def cachedMembers(symbol Symbol, asking FileSymbols) Symbol[] {
			if membersVersion != workspace.version {
				let fresh map<string, Symbol[]>
				membersCache = fresh
				membersVersion = workspace.version
			}
			let key = symbol.kind.value + " " + symbol.path + " @" + symbol.file
			return membersCache[key] when membersCache.hasKey(key)
			let out = members(homeOf(symbol, asking), symbol)
			membersCache[key] = out
			return out
		}

		// candidatesFor is every declaration the index lists under the
		// required name the fewest declarations have, the cheapest filter
		// before `satisfies`.
		internal def candidatesFor(required Symbol[]) Symbol[] {
			let rarest = ""
			let count = -1
			for let (_, r) in required {
				return [] unless memberIndex.hasKey(r.name)
				let n = memberIndex[r.name].len()
				continue unless count < 0 || n < count
				count = n
				rarest = r.name
			}
			return [] when count < 0 || !memberIndex.hasKey(rarest)
			return memberIndex[rarest]
		}

		// buildMemberIndex indexes, once per workspace version, every
		// implementer-kind declaration under the names of its members, its
		// embedded types' members included.
		internal def buildMemberIndex() {
			return when indexedVersion == workspace.version
			let index map<string, Symbol[]>
			for let (_, file) in workspace.allFiles() {
				for let (_, d) in file.declarations {
					continue unless isImplementerKind(d.kind)
					let seen map<string, bool>
					for let (_, m) in members(file, d) {
						continue when seen.hasKey(m.name)
						seen[m.name] = true
						if index.hasKey(m.name) {
							index[m.name].push(d)
						} else {
							index[m.name] = [d]
						}
					}
				}
			}
			memberIndex = index
			indexedVersion = workspace.version
		}

		// homeOrAnyFile is the file that declares the symbol, else
		// `anyFile`, which loads every registered file: only when needed.
		internal def homeOrAnyFile(symbol Symbol) FileSymbols {
			let home = workspace.file(symbol.file)
			return home unless home is none
			return anyFile()
		}

		// anyFile is some file of the workspace, for resolutions that need
		// one when a symbol's own file is not held.
		internal def anyFile() FileSymbols {
			for let (_, file) in workspace.allFiles() {
				return file
			}
			let blank = new Workspace()
			return blank.add("", parse(""))
		}
	}

	// isImplementerKind is true for a declaration that can satisfy an
	// interface or a datatype, as the compiler pairs them.
	def isImplementerKind(kind SymbolKind) bool {
		switch kind {
			case SymbolKind.Struct, SymbolKind.Type, SymbolKind.Datatype, SymbolKind.Enum, SymbolKind.Union, SymbolKind.Interface, SymbolKind.Component, SymbolKind.Style:
				return true
			default:
				return false
		}
	}
}
