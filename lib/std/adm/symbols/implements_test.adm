partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	internal def contractsPreludeSource() string {
		return fixture("""
partial module builtin «
	type string «»
	type Number<T> «»
	interface Iterator<T> «
		def iterate() ?T
	»
	interface Stringer «
		def str() string
	»
»
""")
	}

	internal def contractsSource() string {
		return fixture("""
module io «
	interface Reader «
		def read(n int) !string
	»
	interface Closer «
		def close()
	»
	interface ReadCloser «
		Reader
		Closer
	»
	interface Sink «
		def write(parts ...string) int
	»
	datatype Pointy «
		x int
		y int
	»
	type Text = string
	type Base «
		def close() «»
	»
	// File reads and closes.
	type File «
		def read(n int) !Text « return "" »
		def close() «»
		def str() string « return "" »
	»
	type Derived «
		Base
		def read(n int) !string « return "" »
	»
	type Socket «
		def read(n int) string « return "" »
		def close() «»
	»
	type Half «
		def read(n int, m int) !string « return "" »
	»
	type Grid «
		def read(n float) !string « return "" »
	»
	type Lines «
		def iterate() ?File « return none »
	»
	type Log «
		def write(parts ...string) int « return 0 »
	»
	type Once «
		def write(parts string) int « return 0 »
	»
	struct Point «
		x int
		y int
		z int
	»
	struct Flat «
		x int
	»
	struct Named «
		x int
		y string
	»
»
""")
	}

	check "Implements" {
		@test()
		def TestContractsAndImplementers() {
			let w = new Workspace()
			w.add("builtin.adm", parse(contractsPreludeSource()))
			let f = w.add("io.adm", parse(contractsSource()))
			let nav = new Navigator(w)
			let reader = w.lookup("io", "Reader")[0]
			let closer = w.lookup("io", "Closer")[0]
			let readCloser = w.lookup("io", "ReadCloser")[0]
			let sink = w.lookup("io", "Sink")[0]
			let pointy = w.lookup("io", "Pointy")[0]
			let file = w.lookup("io", "File")[0]
			// A method's name, parameter count, parameter types and return type
			// decide; an alias stands for its target; embedded members count.
			assert nav.satisfies(file, reader) && nav.satisfies(file, closer) && nav.satisfies(file, readCloser)
			assert nav.satisfies(w.lookup("io", "Derived")[0], readCloser)
			assert !nav.satisfies(w.lookup("io", "Socket")[0], reader) && nav.satisfies(w.lookup("io", "Socket")[0], closer)
			assert !nav.satisfies(w.lookup("io", "Half")[0], reader) && !nav.satisfies(w.lookup("io", "Grid")[0], reader)
			// Variadic matters; a type parameter matches anything.
			assert nav.satisfies(w.lookup("io", "Log")[0], sink) && !nav.satisfies(w.lookup("io", "Once")[0], sink)
			assert nav.satisfies(w.lookup("io", "Lines")[0], w.lookup("builtin", "Iterator")[0])
			// A datatype asks for fields by name and type.
			assert nav.satisfies(w.lookup("io", "Point")[0], pointy)
			assert !nav.satisfies(w.lookup("io", "Flat")[0], pointy) && !nav.satisfies(w.lookup("io", "Named")[0], pointy)
			// Both directions over the workspace, in file and declaration order;
			// an interface that embeds another implements it too.
			assert pathsOf(nav.implementers(reader)) == "io.ReadCloser,io.File,io.Derived"
			assert pathsOf(nav.implementers(readCloser)) == "io.File,io.Derived"
			assert pathsOf(nav.implementers(closer)) == "io.ReadCloser,io.Base,io.File,io.Derived,io.Socket"
			assert pathsOf(nav.implementers(pointy)) == "io.Point"
			assert pathsOf(nav.implementers(w.lookup("builtin", "Stringer")[0])) == "io.File"
			assert pathsOf(nav.contracts(file)) == "builtin.Stringer,io.Reader,io.Closer,io.ReadCloser"
			assert pathsOf(nav.contracts(w.lookup("io", "Point")[0])) == "io.Pointy"
			assert nav.contracts(w.lookup("io", "Half")[0]).len() == 0
			assert nav.implementers(file).len() == 0 && nav.satisfies(reader, reader) && !pathsOf(nav.contracts(reader)).contains("io.Reader")
			assert isImplementerKind(SymbolKind.Struct) && !isImplementerKind(SymbolKind.Function)
			assert pathsOf(w.declarationsOfKind(SymbolKind.Datatype)) == "io.Pointy"
			// The index follows the workspace: a new implementer appears after an update.
			let more = fixture("""
partial module io «
	type Pipe «
		def read(n int) !string « return "" »
	»
»
""")
			w.add("pipe.adm", parse(more))
			assert pathsOf(nav.implementers(reader)) == "io.ReadCloser,io.File,io.Derived,io.Pipe"
			assert f.path == "io.adm"
		}
	}
}
