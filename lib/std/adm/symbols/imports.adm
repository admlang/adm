partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// ImportCompletion is a name the file can use once it imports it: the
	// declaration or module offered, the text written at the cursor, and
	// the edit that adds the `use` (`use std.formats.images::(JPG)` merged
	// into the file's imports, or `use std.formats.images` for a module).
	struct ImportCompletion {
		symbol Symbol
		insert string
		edit   Edit
	}

	// maxImportModules bounds how many modules a typed qualifier expands
	// to, and maxImportRows the rows one query offers: a short prefix
	// matches thousands of exports, which would bury the completions that
	// need no import.
	internal const maxImportModules = 4
	internal const maxImportRows = 60

	partial type Navigator {
		// importCompletions is what the name being typed at the offset can
		// become with an import the file does not have yet (the language
		// server's auto-import): the exported declarations of the parsed
		// modules and the modules of the workspace whose name starts with
		// what is typed (case aside), and, after a qualifier no import
		// binds (`images.|`), the exports of the modules whose name ends
		// with it. Never the file's own module, the prelude, a module the
		// file imports, an internal declaration, or a name already visible
		// there. Shorter names first.
		def importCompletions(file FileSymbols, offset int) ImportCompletion[] {
			let out ImportCompletion[]
			let unit = file.unitAt(offset)
			return out when unit is none
			let imported = importedModules(file, unit)
			imported[unit.path] = true
			imported["builtin"] = true
			let qualifier = unresolvedQualifier(file, offset)
			let place = namePlace(file, offset)
			let typed = file.tree.text()[place:offset]
			if !(qualifier is none) {
				return qualifiedImports(file, unit, qualifier, typed, imported)
			}
			return out when typed.len() == 0
			let lower = typed.lower()
			// Most names are told apart by their first character: only those
			// that pass it are lowered whole.
			let head = lower[0]
			let rows ImportCompletion[]
			for let (moduleName, parts) in workspace.modules {
				continue when imported.hasKey(moduleName) || parts.len() == 0
				continue unless parts[0].kind == SymbolKind.Module
				for let (_, part) in parts {
					for let (_, d) in part.members {
						continue when d.isInternal || d.name.len() < lower.len() || d.name[0].lower() != head
						continue unless d.name.lower().startsWith(lower)
						continue unless isImportable(d.kind)
						continue when workspace.resolve(file, d.name, place).len() > 0
						rows.push(ImportCompletion{symbol: d, insert: d.name, edit: useEdit(file, unit, moduleName, d.name)})
					}
				}
			}
			for let (_, m) in workspace.moduleSymbols() {
				continue when imported.hasKey(m.path) || m.kind != SymbolKind.Module
				let tail = lastSegment(m.path)
				continue unless tail.lower().startsWith(lower)
				continue when workspace.resolve(file, tail, place).len() > 0
				rows.push(ImportCompletion{symbol: m, insert: tail, edit: useEdit(file, unit, m.path, "")})
			}
			rows.sort((a ImportCompletion, b ImportCompletion) => a.insert.len() < b.insert.len() || a.insert.len() == b.insert.len() && a.symbol.path < b.symbol.path)
			for let i = 0; i < rows.len() && i < maxImportRows; i++ {
				out.push(rows[i])
			}
			return out
		}

		// importEditFor is the `use` edit that makes `name` of the module
		// nameable on its own at the offset, written as the unit's imports
		// are (the module itself when `name` is empty): what an
		// auto-import completion carries. None when the offset is in no
		// unit, or the name already reaches that module's declaration there
		// (its own module, the prelude, an import that lists it or takes
		// the module's every name); for an empty `name`, when the module is
		// the unit's own, the prelude or imported whole.
		def importEditFor(file FileSymbols, offset int, moduleName string, name string) ?Edit {
			let unit = file.unitAt(offset)
			return none when unit is none
			return none when moduleName == unit.path || moduleName == "builtin"
			if name.len() == 0 {
				return none when importedModules(file, unit).hasKey(moduleName)
				return useEdit(file, unit, moduleName, "")
			}
			for let (_, d) in workspace.resolve(file, name, offset) {
				return none when d.path == moduleName + "." + name
			}
			return useEdit(file, unit, moduleName, name)
		}

		// qualifiedImports is the exports of the modules not imported whose
		// name ends with the qualifier (`images` for `std.formats.images`),
		// each written as its name after the qualifier, with the edit that
		// imports the module.
		internal def qualifiedImports(file FileSymbols, unit Symbol, qualifier string, typed string, imported map<string, bool>) ImportCompletion[] {
			let out ImportCompletion[]
			let names string[]
			for let (_, m) in workspace.moduleSymbols() {
				continue when imported.hasKey(m.path) || m.kind != SymbolKind.Module
				names.push(m.path) when m.path == qualifier || m.path.endsWith("." + qualifier)
			}
			names.sort((a string, b string) => a.len() < b.len() || a.len() == b.len() && a < b)
			let lower = typed.lower()
			for let i = 0; i < names.len() && i < maxImportModules; i++ {
				let edit = useEdit(file, unit, names[i], "")
				let exported Symbol[]
				for let (_, d) in workspace.exports(names[i]) {
					exported.push(d) when !d.isInternal && isImportable(d.kind) && d.name.lower().startsWith(lower)
				}
				exported.sort((a Symbol, b Symbol) => a.name < b.name)
				for let k = 0; k < exported.len() && k < maxImportRows; k++ {
					out.push(ImportCompletion{symbol: exported[k], insert: exported[k].name, edit: edit})
				}
			}
			return out
		}

		// unresolvedQualifier is the name before a `.` that ends at the name
		// being typed (or at the offset) when no declaration or import of
		// the file answers it: `images` of `images.JP|`. None otherwise.
		internal def unresolvedQualifier(file FileSymbols, offset int) ?string {
			let receiver = receiverBefore(file, offset)
			return none when receiver is none || receiver.kind() != SyntaxKind.Name
			let t = receiver.firstToken()
			return none when t is none || t.token() != TokenKind.Ident
			return none when workspace.resolve(file, t.text(), t.start()).len() > 0
			return t.text()
		}

		// importedModules is every module the unit's `use`s import whole, by
		// path: `use m`, `use m as x`, `use m::*`. A module imported by a list
		// of names (`use m::(A)`) is not: its other names join that list.
		internal def importedModules(file FileSymbols, unit Symbol) map<string, bool> {
			let out map<string, bool>
			for let (_, item) in useItems(unit) {
				let path = childOfKind(item, SyntaxKind.QualifiedName)
				continue when path is none || !(childOfKind(item, SyntaxKind.UseSymbols) is none)
				out[path.text().replace(" ", "")] = true
			}
			return out
		}

		// useItems is the `use` items written directly in the unit's body, in
		// source order: the one of a single `use`, those of a group.
		internal def useItems(unit Symbol) SyntaxNode[] {
			let out SyntaxNode[]
			let body = childOfKind(unit.node, SyntaxKind.Body)
			return out when body is none
			for let (_, u) in body.children() {
				continue unless u.kind() == SyntaxKind.Use
				for let (_, item) in u.children() {
					out.push(item) when item.kind() == SyntaxKind.UseItem
				}
			}
			return out
		}

		// useEdit is the edit that imports `name` from the module (the whole
		// module when `name` is empty) in the unit, as its imports are
		// written: a name joins the module's `::(...)` list in its sorted
		// place; a new item joins the unit's `use (...)` group in sorted
		// place; else a line after the last `use`; else the unit's first
		// `use`, after its `{`, with a blank line after it.
		internal def useEdit(file FileSymbols, unit Symbol, moduleName string, name string) Edit {
			let source = file.tree.text()
			let items = useItems(unit)
			if name.len() > 0 {
				for let (_, item) in items {
					let path = childOfKind(item, SyntaxKind.QualifiedName)
					continue when path is none || path.text().replace(" ", "") != moduleName
					let list = childOfKind(item, SyntaxKind.UseSymbols)
					continue when list is none
					return symbolListEdit(file, list, name)
				}
			}
			let written = (name.len() > 0) ?? (moduleName + "::(" + name + ")", moduleName)
			let body = childOfKind(unit.node, SyntaxKind.Body)
			if !(body is none) {
				// A group takes the item on a line of its own, among the others
				// by module path.
				for let (_, u) in body.children() {
					continue unless u.kind() == SyntaxKind.Use && isUseGroup(u)
					let groupItems SyntaxNode[]
					for let (_, item) in u.children() {
						groupItems.push(item) when item.kind() == SyntaxKind.UseItem
					}
					continue when groupItems.len() == 0
					let indent = lineIndent(source, groupItems[0].start())
					for let (_, item) in groupItems {
						let path = childOfKind(item, SyntaxKind.QualifiedName)
						continue when path is none || path.text().replace(" ", "") < moduleName
						let at = lineStart(source, item.start())
						return Edit{file: file.path, start: at, end: at, text: indent + written + "\n"}
					}
					let last = groupItems[groupItems.len() - 1]
					let at = lineEnd(source, last.end())
					return Edit{file: file.path, start: at, end: at, text: "\n" + indent + written}
				}
				let lastUse ?SyntaxNode = none
				for let (_, u) in body.children() {
					lastUse = u when u.kind() == SyntaxKind.Use
				}
				let after = lastUse
				if !(after is none) {
					let at = lineEnd(source, after.end())
					return Edit{file: file.path, start: at, end: at, text: "\n" + lineIndent(source, after.start()) + "use " + written}
				}
				let open = body.firstToken()
				if !(open is none) {
					let at = lineEnd(source, open.end())
					let first = firstNonToken(body)
					let indent = first is none ?? (lineIndent(source, open.start()) + "\t", lineIndent(source, first.start()))
					return Edit{file: file.path, start: at, end: at, text: "\n" + indent + "use " + written + "\n"}
				}
			}
			return Edit{file: file.path, start: 0, end: 0, text: "use " + written + "\n"}
		}

		// symbolListEdit adds the name to a `::(...)` list: before the first
		// name that sorts after it when the list is sorted, else at its end.
		internal def symbolListEdit(file FileSymbols, list SyntaxNode, name string) Edit {
			let symbols SyntaxNode[]
			for let (_, s) in list.children() {
				symbols.push(s) when s.kind() == SyntaxKind.UseSymbol
			}
			let sorted = true
			for let i = 1; i < symbols.len(); i++ {
				sorted = false when symbols[i - 1].text() > symbols[i].text()
			}
			if sorted {
				for let (_, s) in symbols {
					return Edit{file: file.path, start: s.start(), end: s.start(), text: name + ", "} when s.text() > name
				}
			}
			if symbols.len() == 0 {
				let close = list.lastToken()
				let at = close is none ?? (list.end(), close.start())
				return Edit{file: file.path, start: at, end: at, text: name}
			}
			let last = symbols[symbols.len() - 1]
			return Edit{file: file.path, start: last.end(), end: last.end(), text: ", " + name}
		}
	}

	// isImportable is true for a declaration a `use` can bring in by name.
	internal def isImportable(kind SymbolKind) bool {
		switch kind {
			case SymbolKind.Module, SymbolKind.Application, SymbolKind.Library, SymbolKind.Plugin, SymbolKind.Check, SymbolKind.Import, SymbolKind.Keyword, SymbolKind.Local, SymbolKind.Parameter, SymbolKind.Unit:
				return false
			default:
				return true
		}
	}

	// isUseGroup is true for `use ( ... )`.
	internal def isUseGroup(u SyntaxNode) bool {
		let second = u.child(1)
		return !(second is none) && second.isToken() && second.token() == TokenKind.LParen
	}

	internal def lastSegment(path string) string {
		let dot = path.lastIndexOf(".")
		return (dot < 0) ?? (path, path[dot + 1:])
	}

	// lineStart is the offset of the start of the line holding `at`.
	internal def lineStart(source string, at int) int {
		let i = at
		for i > 0 && source[i - 1] != '\n' {
			i--
		}
		return i
	}

	// lineEnd is the offset of the line break ending the line holding `at`
	// (the end of the source on the last line).
	internal def lineEnd(source string, at int) int {
		let i = at
		for i < source.len() && source[i] != '\n' {
			i++
		}
		return i
	}

	// lineIndent is the white space that starts the line holding `at`.
	internal def lineIndent(source string, at int) string {
		let from = lineStart(source, at)
		let i = from
		for i < source.len() && (source[i] == '\t' || source[i] == ' ') {
			i++
		}
		return source[from:i]
	}
}
