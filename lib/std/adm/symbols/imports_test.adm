partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	// importingFile adds an images and a text module and the source to the
	// workspace, and is the source's file.
	internal def importingFile(w Workspace, source string) FileSymbols {
		w.add("builtin.adm", parse(preludeSource()))
		w.add("images.adm", parse(fixture("""
module std.formats.images «
	type JPG « »
	type PNG « »
	def decode(b byte[]) JPG « return new JPG() »
	internal def hidden() « »
»
""")))
		w.add("text.adm", parse(fixture("""
module std.text «
	def joinLines(s string[]) string « return "" »
»
""")))
		return w.add("app.adm", parse(source))
	}

	// applied is the source with the row's edit made and its text written
	// over the `typed` characters before `at` (the edit stands before them).
	internal def applied(source string, at int, typed int, row ImportCompletion) string {
		let written = source[:at - typed] + row.insert + source[at:]
		return written[:row.edit.start] + row.edit.text + written[row.edit.end:]
	}

	check "Imports" {
		@test()
		def TestNameJoinsTheModulesList() {
			let source = fixture("""
module app «
	use std.formats.images::(PNG)

	def run() « let j = JP »
»
""")
			let w = new Workspace()
			let app = importingFile(w, source)
			let at = source.indexOf(fixture("JP »")) + 2
			let rows = new Navigator(w).importCompletions(app, at)
			assert rows.len() == 1 && rows[0].insert == "JPG"
			assert applied(source, at, 2, rows[0]).contains("use std.formats.images::(JPG, PNG)\n")
		}

		@test()
		def TestNewItemInTheGroup() {
			let source = fixture("""
module app «
	use (
		std.formats.images::(PNG)
		std.zz
	)

	def run() « let s = joinL »
»
""")
			let w = new Workspace()
			let app = importingFile(w, source)
			let at = source.indexOf(fixture("joinL »")) + 5
			let rows = new Navigator(w).importCompletions(app, at)
			assert rows.len() == 1 && rows[0].insert == "joinLines"
			assert applied(source, at, 5, rows[0]).contains("\t\tstd.formats.images::(PNG)\n\t\tstd.text::(joinLines)\n\t\tstd.zz\n")
		}

		@test()
		def TestLineAfterTheLastUseOrFirstUse() {
			let source = fixture("""
module app «
	use std.zz

	def run() « let s = joinL »
»
""")
			let w = new Workspace()
			let app = importingFile(w, source)
			let at = source.indexOf(fixture("joinL »")) + 5
			let rows = new Navigator(w).importCompletions(app, at)
			assert rows.len() == 1
			assert applied(source, at, 5, rows[0]).contains("\tuse std.zz\n\tuse std.text::(joinLines)\n")
			let bare = fixture("""
module app «
	def run() « let s = joinL »
»
""")
			let w2 = new Workspace()
			let app2 = importingFile(w2, bare)
			let at2 = bare.indexOf(fixture("joinL »")) + 5
			let rows2 = new Navigator(w2).importCompletions(app2, at2)
			assert rows2.len() == 1
			assert applied(bare, at2, 5, rows2[0]).contains(fixture("module app «\n\tuse std.text::(joinLines)\n\n\tdef run()"))
		}

		@test()
		def TestModulesAndQualifiers() {
			let source = fixture("""
module app «
	def run() «
		let m = ima
		let d = images.dec
	»
»
""")
			let w = new Workspace()
			let app = importingFile(w, source)
			let nav = new Navigator(w)
			// A module, written by its last part.
			let at = source.indexOf("ima\n") + 3
			let rows = nav.importCompletions(app, at)
			assert rows.len() == 1 && rows[0].insert == "images" && rows[0].symbol.kind == SymbolKind.Module
			assert rows[0].edit.text == "\n\tuse std.formats.images\n"
			// After a qualifier no import binds, the module's exports.
			let after = source.indexOf("images.dec") + "images.dec".len()
			let members = nav.importCompletions(app, after)
			assert members.len() == 1 && members[0].insert == "decode" && members[0].edit.text == "\n\tuse std.formats.images\n"
		}

		@test()
		def TestNothingVisibleOrHidden() {
			let source = fixture("""
module app «
	use std.formats.images
	def hid() « »
	def run() « let a = hid »
»
""")
			let w = new Workspace()
			let app = importingFile(w, source)
			let at = source.indexOf(fixture("hid »")) + 3
			// `hidden` is internal, `hid` is visible, images is imported.
			assert new Navigator(w).importCompletions(app, at).len() == 0
			assert namesModule("use std.ui::(Row)", "std.ui") && !namesModule("use std.ui.components", "std.ui") && !namesModule("use my_std.ui", "std.ui")
		}
	}
}
