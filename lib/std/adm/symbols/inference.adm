partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(Green, SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// binaryType is the type of `left op right`, as the compiler's checker
		// gives it (`internal/sema/checker.go`, the `BinaryExpr` case of
		// `checkExpr` and `binaryOpType`): `bool` for `is`, `in`, a
		// comparison and a logical operator; a numeric literal on one side
		// takes the other side's type; an integer beside a float is the
		// float; `string + char`; a `duration` scaled by a float; an `infix`
		// method of the left side's type; else the left side's type. A
		// quantity, a matrix and a future's composition are Unknown.
		internal def binaryType(file FileSymbols, expr SyntaxNode, depth int) Type {
			let unknown = table().unknownType()
			let kids = expr.children()
			return unknown when kids.len() < 3
			let left = kids[0]
			let opToken = kids[1]
			let right = kids[kids.len() - 1]
			return unknown unless opToken.isToken()
			let op = opToken.token()
			switch op {
				case TokenKind.Is, TokenKind.In, TokenKind.Eq, TokenKind.Neq, TokenKind.Lt, TokenKind.Leq, TokenKind.Gt, TokenKind.Geq:
					return table().primitiveType("bool")
				case TokenKind.And, TokenKind.Or:
					let l = exprType(file, left, depth + 1)
					return unknown when l.kind == TypeKind.Async
					return table().primitiveType("bool")
				case TokenKind.Range:
					return table().primitiveType("int")
				default:
			}
			let l = exprType(file, left, depth + 1)
			let r = exprType(file, right, depth + 1)
			l = adoptLiteral(left, l, r)
			r = adoptLiteral(right, r, l) unless isShift(op) && isPrimitiveNamed(plain(l), "bigint")
			return unknown when l.kind == TypeKind.Unknown || r.kind == TypeKind.Unknown
			// Units: a quantity's dimension arithmetic is the checker's own.
			return unknown when isQuantity(l) || isQuantity(r)
			// The operands' structure is what their aliases stand for; the
			// result keeps the alias (`SubscriptionId + 1`).
			let pl = plain(l)
			let pr = plain(r)
			return table().primitiveType("duration") when op == TokenKind.Mul && (isPrimitiveNamed(pl, "duration") && isFloat(pr) || isFloat(pl) && isPrimitiveNamed(pr, "duration"))
			return table().primitiveType("duration") when op == TokenKind.Div && isPrimitiveNamed(pl, "duration") && isFloat(pr)
			if op == TokenKind.Add {
				return l when isPrimitiveNamed(pl, "string") && isPrimitiveNamed(pr, "char")
				return r when isPrimitiveNamed(pl, "char") && isPrimitiveNamed(pr, "string")
			}
			return unknown when pl.kind == TypeKind.Matrix || pr.kind == TypeKind.Matrix
			// A type's own operator: `infix def +(other T) T`.
			if pl.kind == TypeKind.Named {
				let operator = infixOperator(file, l, opToken.text(), right, r, depth)
				return unknown when operator is none
				let result = operator.result
				return unknown when result is none
				return result
			}
			return l when isFloat(pl) && isIntegral(pr)
			return r when isFloat(pr) && isIntegral(pl)
			return l
		}

		// infixOperator is the type of the left side's `infix def` for the
		// operator that takes the right side: among its overloads, the one
		// whose parameter is the right side's type (`Time - Time` is a
		// duration, `Time - duration` a Time), else the first.
		internal def infixOperator(file FileSymbols, left Type, op string, rightExpr SyntaxNode, right Type, depth int) ?Type {
			let owner = ownerOf(left)
			return none when owner is none
			let firstFound ?Type = none
			for let (_, m) in membersNamed(homeOf(owner, file), owner, op) {
				continue unless m.kind == SymbolKind.Function || m.kind == SymbolKind.Method
				let t = instanceType(file, left, m, funcTypeOf(homeOf(m, file), m, depth), depth)
				continue unless t.kind == TypeKind.Func
				firstFound = t when firstFound is none
				continue when t.args.len() == 0
				let wanted = t.args[0]
				return t when wanted == right || plain(wanted) == plain(right) || adoptLiteral(rightExpr, right, wanted) == wanted
			}
			return firstFound
		}

		// unaryType is the type of a prefix operator's result: the operand's
		// for `-`, `+`, `!`, `^`, `++`, `--`; the element of a channel for
		// `<-`.
		internal def unaryType(file FileSymbols, expr SyntaxNode, depth int) Type {
			let unknown = table().unknownType()
			let opToken = expr.child(0)
			let operand = firstNonToken(expr)
			return unknown when opToken is none || operand is none
			let t = exprType(file, operand, depth + 1)
			switch opToken.token() {
				case TokenKind.LArrow:
					return t.args[0] when t.kind == TypeKind.Channel
					return unknown
				case TokenKind.Sub, TokenKind.Add, TokenKind.Not, TokenKind.Xor, TokenKind.Inc, TokenKind.Dec, TokenKind.Tilde:
					return t
				default:
					return unknown
			}
		}

		// choiceType is the type of `cond ?? (a, b)` (the checker's
		// `ChoiceExpr` case, `combineChoiceTypes`): the arms' type when they
		// agree, a numeric literal arm taking the other's, an optional of the
		// other when one is `none`, the wider of two numbers, else a union.
		internal def choiceType(file FileSymbols, expr SyntaxNode, depth int) Type {
			let unknown = table().unknownType()
			let parts SyntaxNode[]
			for let (_, c) in expr.children() {
				parts.push(c) unless c.isToken()
			}
			return unknown when parts.len() < 3
			let a = exprType(file, parts[1], depth + 1)
			let b = exprType(file, parts[2], depth + 1)
			if a != b {
				a = adoptLiteral(parts[1], a, b) when isNumber(b)
				b = adoptLiteral(parts[2], b, a) when isNumber(a)
			}
			return unknown when a.kind == TypeKind.Unknown || b.kind == TypeKind.Unknown
			let wide = widerNumber(a, b)
			return wide unless wide is none
			return a when a == b
			if isPrimitiveNamed(a, "none") {
				return b when b.kind == TypeKind.Optional
				return table().wrapType(TypeKind.Optional, b)
			}
			if isPrimitiveNamed(b, "none") {
				return a when a.kind == TypeKind.Optional
				return table().wrapType(TypeKind.Optional, a)
			}
			return a when a.kind == TypeKind.Optional && a.args[0] == b
			return b when b.kind == TypeKind.Optional && b.args[0] == a
			return table().setType(TypeKind.Union, [a, b])
		}

		// arrayLiteralType is the type of `[a, b]` (the checker's `ArrayLit`
		// case): an array of the first element's type, a later numeric
		// literal taking it; elements of two primitive types make an
		// `any[]`; `T[a, b]` is a `T[]`. Rows (a matrix) and elements whose
		// agreement this layer cannot tell are Unknown, and so is `[]`.
		internal def arrayLiteralType(file FileSymbols, expr SyntaxNode, depth int) Type {
			let unknown = table().unknownType()
			let cached = cachedType(file, expr.green)
			return cached unless cached is none
			let written ?Type = none
			let items SyntaxNode[]
			let at = expr.fullStart()
			let first = true
			let element ?Type = none
			for let (i, g) in expr.green.children {
				let offset = at
				at += g.width
				continue when g.isToken()
				return unknown when g.kind == SyntaxKind.Row
				if isTypeNode(g.kind) && first && written is none {
					// `T[a, b]` is a `T[]` whatever its elements, unless rows make
					// it a matrix.
					// With rows, the last group before `]` is a Row too.
					let t = writtenType(file, new SyntaxNode(g, expr, offset, i))
					let kids = expr.green.children
					for let k = kids.len() - 1; k > i; k-- {
						continue when kids[k].isToken()
						return unknown when kids[k].kind == SyntaxKind.Row
						break
					}
					return unknown when t.kind == TypeKind.Matrix
					let typed = table().wrapType(TypeKind.Array, t)
					file.writtenTypes[expr.green] = typed
					return typed
				}
				// A table of literals: the elements after the first that are
				// literals of its type are read off the tree, nothing typed.
				let known = element
				if !first && !(known is none) && literalFits(g, known) {
					continue
				}
				let item = new SyntaxNode(g, expr, offset, i)
				if first {
					element = exprType(file, item, depth + 1)
					first = false
				}
				items.push(item)
			}
			if !(written is none) {
				return unknown when written.kind == TypeKind.Matrix
				return table().wrapType(TypeKind.Array, written)
			}
			// `[]` takes its element type from its place.
			let head = element
			return unknown when items.len() == 0 || head is none
			// A table of literals has the type its text gives it, wherever it
			// is read: the file keeps it.
			if items.len() == 1 && written is none && items[0].kind() == SyntaxKind.Literal && items[0].childCount() == 1 {
				let t = table().wrapType(TypeKind.Array, head)
				file.writtenTypes[expr.green] = t
				return t
			}
			for let i = 1; i < items.len(); i++ {
				let t = adoptLiteral(items[i], exprType(file, items[i], depth + 1), head)
				continue when t == head || isIntegral(head) && isIntegral(t)
				return table().wrapType(TypeKind.Array, unknown) unless head.kind == TypeKind.Primitive && t.kind == TypeKind.Primitive
				return table().wrapType(TypeKind.Array, table().primitiveType("any"))
			}
			return table().wrapType(TypeKind.Array, head)
		}

		// literalFits is true for a literal element that keeps an array of
		// the type its type: an integer beside numbers, a float beside floats,
		// a string, a char or a bool beside its own type.
		internal def literalFits(g Green, element Type) bool {
			return false unless g.kind == SyntaxKind.Literal && g.children.len() == 1
			let t = g.children[0]
			switch t.token {
				case TokenKind.Integer:
					return isIntegral(element) || isFloat(element) || isPrimitiveNamed(element, "bigint")
				case TokenKind.Float:
					return isFloat(element)
				case TokenKind.String:
					return isPrimitiveNamed(element, "string")
				case TokenKind.Char:
					return isPrimitiveNamed(element, "char")
				case TokenKind.Bool:
					return isPrimitiveNamed(element, "bool")
				default:
					return false
			}
		}

		// tupleLiteralType is the type of `(a, b)`: a tuple of the elements'.
		internal def tupleLiteralType(file FileSymbols, expr SyntaxNode, depth int) Type {
			let members Type[]
			for let (_, c) in expr.children() {
				members.push(exprType(file, c, depth + 1)) unless c.isToken()
			}
			return table().tupleType(members)
		}

		// lambdaType is the type of `x => expr` and `(a, b int) => { ... }`:
		// each parameter's written type, else what the function type its
		// place asks for gives it; the result of the expression, or of the
		// first `return` with a value in the block (`none` without one).
		internal def lambdaType(file FileSymbols, lambda SyntaxNode, depth int) Type {
			let params Type[]
			for let (i, p) in lambdaParams(lambda) {
				params.push(lambdaParamAt(file, lambda, p, i, depth))
			}
			let body = lambda.child(lambda.childCount() - 1)
			let result = table().primitiveType("none")
			if !(body is none) {
				if body.kind() == SyntaxKind.Block {
					// A statement body returns what its place asks for, nothing
					// where nothing is asked (spec "Lambda Expressions"); where
					// the place cannot be told, what its first `return` gives.
					let asked = lambdaResultAsked(file, lambda, depth)
					if asked is none {
						let returned = firstReturned(body)
						result = exprType(file, returned, depth + 1) unless returned is none
					} else {
						result = asked
					}
				} else {
					result = exprType(file, body, depth + 1)
				}
			}
			return table().funcType(params, result, false)
		}

		// lambdaResultAsked is the result the place of a lambda asks for:
		// `none` for an untyped `let` or `const` and for a function type
		// without a result, the result of the function type a typed `let`,
		// a field or an argument asks for. None (the value) where this layer
		// cannot tell: an argument of a call with overloads, which the lambda
		// itself may choose between.
		internal def lambdaResultAsked(file FileSymbols, lambda SyntaxNode, depth int) ?Type {
			let holder = lambda.parent
			return none when holder is none
			if holder.kind() == SyntaxKind.Field {
				let decl = holder.parent
				let untyped = true
				for let (_, c) in holder.children() {
					untyped = false when isTypeNode(c.kind())
				}
				return table().primitiveType("none") when untyped && !(decl is none) && (decl.kind() == SyntaxKind.LetDecl || decl.kind() == SyntaxKind.ConstDecl)
			}
			let expected ?Type = none
			if holder.kind() == SyntaxKind.Arg {
				let args = holder.parent
				let call = args is none ?? (none, args.parent)
				return none when call is none || call.kind() != SyntaxKind.Call
				let callee = call.child(0)
				return none when callee is none
				let fns = 0
				for let (_, c) in calleeOverloads(file, callee) {
					fns++ when c.kind == SymbolKind.Function || c.kind == SymbolKind.Method
				}
				return none when fns > 1
				expected = argumentPlaceType(file, holder, depth + 1)
			} else {
				let ref = contextRef(file, lambda, depth + 1)
				expected = refType(ref) unless ref is none
			}
			let place = expected
			return none when place is none
			let f = plain(unwrapped(place, TypeKind.Optional))
			return none unless f.kind == TypeKind.Func
			let r = f.result
			return table().primitiveType("none") when r is none
			return none when r.isUnknown() || r.open
			return r
		}

		// lambdaParams is the Param nodes of a lambda.
		internal def lambdaParams(lambda SyntaxNode) SyntaxNode[] {
			let out SyntaxNode[]
			for let (_, c) in lambda.children() {
				if c.kind() == SyntaxKind.Param {
					out.push(c)
				} else if c.kind() == SyntaxKind.Params {
					for let (_, p) in c.children() {
						out.push(p) when p.kind() == SyntaxKind.Param
					}
				}
			}
			return out
		}

		// lambdaParamAt is the type of a lambda's parameter: written, else the
		// parameter at its position of the function type the lambda's place
		// asks for, else Unknown.
		internal def lambdaParamAt(file FileSymbols, lambda SyntaxNode, param SyntaxNode, index int, depth int) Type {
			for let (_, c) in param.children() {
				return writtenType(file, c) when isTypeNode(c.kind())
			}
			return table().unknownType() when depth > maxDepth
			// An argument of a call takes the parameter's function type, with
			// the call's type arguments; another place what it says.
			let expected = table().unknownType()
			let arg = lambda.parent
			let fromCall ?Type = none
			fromCall = argumentPlaceType(file, arg, depth + 1) when !(arg is none) && arg.kind() == SyntaxKind.Arg
			if fromCall is none {
				expected = refType(contextRef(file, lambda, depth + 1))
			} else {
				expected = fromCall
			}
			// What the place asks for, through an alias (`Easing`).
			let asked = plain(expected)
			return table().unknownType() unless asked.kind == TypeKind.Func && index < asked.args.len()
			return asked.args[index]
		}

		// lambdaParamType is the type of a parameter symbol a lambda declares,
		// none for another symbol.
		internal def lambdaParamType(file FileSymbols, symbol Symbol, depth int) ?Type {
			let param = symbol.node
			return none unless param.kind() == SyntaxKind.Param
			let holder = param.parent
			return none when holder is none
			let lambda ?SyntaxNode = holder
			lambda = holder.parent when holder.kind() == SyntaxKind.Params
			return none when lambda is none || lambda.kind() != SyntaxKind.Lambda
			for let (i, p) in lambdaParams(lambda) {
				return lambdaParamAt(file, lambda, p, i, depth) when p.same(param)
			}
			return none
		}

		// firstReturned is the value of the first `return` of the block that
		// has one, outside the functions and lambdas inside it.
		internal def firstReturned(block SyntaxNode) ?SyntaxNode {
			for let (_, c) in block.children() {
				continue when c.isToken()
				let k = c.kind()
				continue when k == SyntaxKind.Lambda || k == SyntaxKind.FuncDecl
				if k == SyntaxKind.Return {
					let value = firstNonToken(c)
					return value unless value is none
					continue
				}
				let inner = firstReturned(c)
				return inner unless inner is none
			}
			return none
		}

		// adoptLiteral is the type a numeric literal (or a signed one) takes
		// beside a value of the type `want` (the checker's
		// `coerceNumericLiteral`): an integer literal any integral or float
		// type, a float literal a float type; `got` otherwise.
		internal def adoptLiteral(expr SyntaxNode, got Type, want Type) Type {
			let inner ?SyntaxNode = expr
			for {
				let current = inner
				return got when current is none
				let k = current.kind()
				if k == SyntaxKind.Paren || k == SyntaxKind.Unary && isSign(current.child(0)) {
					inner = firstNonToken(current)
					continue
				}
				return got unless k == SyntaxKind.Literal && current.childCount() == 1
				let t = current.firstToken()
				return got when t is none
				let p = plain(want)
				return want when t.token() == TokenKind.Integer && (isIntegral(p) || isFloat(p) || isPrimitiveNamed(p, "bigint"))
				return want when t.token() == TokenKind.Float && isFloat(p)
				return got
			}
		}

		// widerNumber is the wider of two primitive numbers of different
		// types (the checker's `widerPrimitiveNumber` and `numberRank`), none
		// otherwise.
		internal def widerNumber(a Type, b Type) ?Type {
			return none when a == b
			let ra = numberRank(a)
			let rb = numberRank(b)
			return none when ra == 0 || rb == 0
			return b when rb > ra
			return a
		}

		// bindCall binds the function's own type parameters from its
		// arguments (`unifyArguments`), as the checker infers type
		// arguments; then the type with them.
		internal def bindCall(file FileSymbols, fn Symbol, fnType Type, call SyntaxNode, t Type, depth int) Type {
			return t unless t.open
			let bindings map<int, Type>
			// Type arguments written at the call (`convert<float32, int32>(x)`)
			// come first.
			let written = childOfKind(call, SyntaxKind.TypeArgs)
			if !(written is none) {
				let names = typeParamsOf(fn)
				let i = 0
				for let (_, a) in written.children() {
					continue when a.isToken() || a.kind() == SyntaxKind.Literal
					bindings[table().typeParamType(fn.path, i, names[i]).id] = writtenType(file, a) when i < names.len()
					i++
				}
			}
			unifyArguments(file, fn, fnType, call, bindings, depth)
			return table().substitute(t, bindings)
		}

		// unifyArguments binds type parameters from each positional
		// argument's type against its parameter's, and from a named one
		// against the parameter of that name. An argument typed by its place
		// (a literal without a type, a lambda) binds nothing.
		internal def unifyArguments(file FileSymbols, fn Symbol, fnType Type, call SyntaxNode, bindings map<int, Type>, depth int) {
			let args = childOfKind(call, SyntaxKind.Args)
			return when args is none
			let names = paramShape(fn.node).names
			let position = 0
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				let head = arg.child(0)
				continue when head is none
				let at = position
				let value ?SyntaxNode = head
				if isNamedArgumentName(head) {
					at = -1
					for let (i, n) in names {
						at = i when n == head.text()
					}
					value = lastNonToken(arg)
				} else {
					position++
				}
				let given = value
				continue when at < 0 || given is none
				at = fnType.args.len() - 1 when fnType.variadic && at >= fnType.args.len()
				continue when at < 0 || at >= fnType.args.len()
				continue when typedByPlace(given)
				unify(fnType.args[at], exprType(file, given, depth + 1), bindings)
			}
		}

		// unify binds the type parameters of `wanted` from what `given`
		// holds in their places: `T[]` against `File[]` binds T to File, `?T`
		// against `File` too. The first binding of a parameter stays.
		internal def unify(written Type, seen Type, bindings map<int, Type>) {
			return unless written.open
			return when seen.kind == TypeKind.Unknown
			// A type parameter takes the argument's type as written (an alias
			// stays one); a structure is matched through aliases.
			let wanted = (written.kind == TypeKind.TypeParam) ?? (written, plain(written))
			let given = (wanted.kind == TypeKind.TypeParam) ?? (seen, plain(seen))
			if wanted.kind == TypeKind.TypeParam {
				bindings[wanted.id] = given unless bindings.hasKey(wanted.id)
				return
			}
			if wanted.kind == TypeKind.Optional && given.kind != TypeKind.Optional {
				unify(wanted.args[0], given, bindings)
				return
			}
			return unless wanted.kind == given.kind && wanted.path == given.path && wanted.args.len() == given.args.len()
			for let (i, a) in wanted.args {
				unify(a, given.args[i], bindings)
			}
			let wr = wanted.result
			let gr = given.result
			unify(wr, gr, bindings) unless wr is none || gr is none
		}

		// constructed is the type `new T(args)` or `T(args)` makes when T is
		// generic and its type arguments are left to the arguments (spec
		// "Components": `List(files)`): bound from the constructor `new`'s
		// parameters, else from the fields named arguments set.
		internal def constructed(file FileSymbols, made Type, call SyntaxNode, depth int) Type {
			return made unless made.kind == TypeKind.Named && made.isUnknown()
			let decl = declarationOf(made)
			return made when decl is none
			let names = typeParamsOf(decl)
			return made when names.len() == 0
			let generic Type[]
			for let (i, name) in names {
				generic.push(table().typeParamType(decl.path, i, name))
			}
			let open = table().namedType(decl, generic)
			let bindings map<int, Type>
			let home = homeOf(decl, file)
			let ctor = chooseOverload(file, call, membersNamed(home, decl, "new"), open, depth)
			if ctor is none {
				// Named arguments set the fields of the same name.
				let args = childOfKind(call, SyntaxKind.Args)
				if !(args is none) {
					for let (_, arg) in args.children() {
						let head = arg.child(0)
						continue when head is none || !isNamedArgumentName(head)
						let field = first(membersNamed(home, decl, head.text()))
						let value = lastNonToken(arg)
						continue when field is none || value is none || typedByPlace(value)
						unify(valueTypeOf(home, field, depth + 1), exprType(file, value, depth + 1), bindings)
					}
				}
			} else {
				// The constructor's parameters are written with the type's own
				// parameters: `def new(value T)`.
				unifyArguments(file, ctor, funcTypeOf(homeOf(ctor, file), ctor, depth), call, bindings, depth)
			}
			let bound Type[]
			for let (i, g) in generic {
				let b = bindings.get(g.id)
				if !(b is none) {
					bound.push(b)
				} else if i < made.args.len() {
					// A default the reference already took stays.
					bound.push(made.args[i])
				} else {
					bound.push(table().unknownType())
				}
			}
			return named(decl, bound)
		}

		// lastNonToken is the last child of the node that is not a token.
		internal def lastNonToken(n SyntaxNode) ?SyntaxNode {
			let kids = n.green.children
			for let i = kids.len() - 1; i >= 0; i-- {
				return n.child(i) unless kids[i].isToken()
			}
			return none
		}

		// isSign is true for a `+` or `-` token.
		internal def isSign(t ?SyntaxNode) bool {
			return !(t is none) && t.isToken() && (t.token() == TokenKind.Sub || t.token() == TokenKind.Add)
		}

		// isQuantity is true for a type of a dimension (`Length`, a unit's).
		internal def isQuantity(t Type) bool {
			return false unless t.kind == TypeKind.Named
			let decl = declarationOf(t)
			return false when decl is none
			for let (_, a) in decl.annotations {
				return true when a.text().startsWith("@dimension")
			}
			return false unless decl.kind == SymbolKind.Type
			let target = aliasTarget(decl.node)
			return !(target is none) && target.kind() == SyntaxKind.DimensionType
		}
	}

	internal def isShift(op TokenKind) bool {
		return op == TokenKind.Shl || op == TokenKind.Shr
	}

	internal def isPrimitiveNamed(t Type, name string) bool {
		return t.kind == TypeKind.Primitive && t.name == name
	}

	// isIntegral is true for the integral primitives (the checker's
	// `isIntegralName`).
	internal def isIntegral(t Type) bool {
		return false unless t.kind == TypeKind.Primitive
		switch t.name {
			case "int", "int8", "int16", "int32", "int64", "int128", "uint", "uint8", "uint16", "uint32", "uint64", "uint128", "byte":
				return true
			default:
				return false
		}
	}

	// isFloat is true for the float primitives (`isFloatName`).
	internal def isFloat(t Type) bool {
		return false unless t.kind == TypeKind.Primitive
		switch t.name {
			case "float", "float16", "float32", "float64", "float128":
				return true
			default:
				return false
		}
	}

	internal def isNumber(t Type) bool {
		return isIntegral(t) || isFloat(t) || isPrimitiveNamed(t, "bigint")
	}

	// numberRank is the checker's `numberRank`: which of two numbers is wider,
	// 0 for a type it does not rank.
	internal def numberRank(t Type) int {
		return 0 unless t.kind == TypeKind.Primitive
		switch t.name {
			case "int8", "uint8", "byte":
				return 1
			case "int16", "uint16":
				return 2
			case "int32", "uint32":
				return 3
			case "int", "int64":
				return 4
			case "uint", "uint64":
				return 5
			case "int128", "uint128":
				return 6
			case "bigint":
				return 7
			case "float32":
				return 8
			case "float", "float64":
				return 9
			default:
				return 0
		}
	}
}
