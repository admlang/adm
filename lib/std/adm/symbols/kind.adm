partial module std.adm.symbols {
	// SymbolKind is what a symbol declares. The value is the kind's name as
	// `adm doc` prints it.
	enum SymbolKind {
		Module        = "module",
		Application   = "application",
		Library       = "library",
		Plugin        = "plugin",
		Check         = "check",
		Type          = "type",
		Struct        = "struct",
		Enum          = "enum",
		EnumMember    = "enum member",
		Union         = "union",
		UnionMember   = "union member",
		Interface     = "interface",
		Datatype      = "datatype",
		Service       = "service",
		Component     = "component",
		View          = "view",
		Style         = "style",
		Function      = "function",
		Method        = "method",
		Field         = "field",
		Property      = "property",
		Parameter     = "parameter",
		TypeParameter = "type parameter",
		Const         = "const",
		Local         = "let",
		Import        = "import",
		// The symbol a `@unit("km")` constant or a `@dimension(unit = "m")`
		// type declares for quantity literals (`3(km)`, `quantity(3, km)`).
		Unit          = "unit"
	}

	// ScopeKind is what a scope belongs to.
	enum ScopeKind {
		// The file: its own `use` imports.
		File     = "file",
		// A module, application, library, plugin or check suite.
		Unit     = "unit",
		// The body of a type, struct, service, component, interface,
		// datatype, enum or union: its members.
		Members  = "members",
		// A function or method: its type parameters, parameters and body.
		Function = "function",
		// A lambda: its parameters and body.
		Lambda   = "lambda",
		// A block of statements.
		Block    = "block",
		// A statement with a header that declares (`for let x in`, `if let`):
		// spans the statement.
		Header   = "header",
		// A `case` of a match: its pattern bindings and statements.
		Case     = "case",
		// An `onerror` handler with a binding.
		Handler  = "handler"
	}
}
