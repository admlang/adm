partial module std.adm.symbols {
	use (
		std.adm.lexer::(Lexer, Token, TokenKind)
		std.adm.syntax::parse
	)

	// parallelLoads is how many registered files a workspace loads at once
	// (`loadFiles`); the scheduler runs as many of them as it has
	// processors, and the bound keeps the tasks waiting their turn from
	// being started.
	internal const parallelLoads = 64

	// loadSource is the symbols of a registered file's source, parsed as an
	// outline. It reads nothing of a workspace, so files load on tasks of
	// their own.
	internal def loadSource(source string, path string) FileSymbols {
		return analyze(parse(source, bodies = false), path)
	}

	partial type Workspace {
		// register makes a file part of the workspace without parsing it:
		// the module its header names is recorded, and the file is parsed
		// and analyzed the first time that module, the file itself or the
		// whole workspace is asked for. A registered file is parsed as an
		// outline: its function bodies are parsed when something reads
		// inside them. A file whose header is not one
		// unit's (several modules, no module) or that declares units
		// (`@unit`, `@dimension`, which every file may name) is parsed at
		// once. Registering a file added before replaces it.
		def register(path string, source string) {
			remove(path)
			// A module's lookups load its registered files once: one
			// registered after may change what a name means.
			shapes++
			let names = headerModules(source)
			if names.len() != 1 || unitHeaders(source) > 1 || source.contains("@unit(\"") || source.contains("@dimension(unit") {
				add(path, parse(source, bodies = false))
				return
			}
			pendingSources[path] = source
			let name = names[0]
			if pendingByModule.hasKey(name) {
				pendingByModule[name].push(path)
			} else {
				pendingByModule[name] = [path]
			}
		}

		// pending is how many registered files are not parsed yet.
		def pending() int {
			return pendingSources.len()
		}

		// loadAll parses every registered file that is not parsed yet (a
		// background pass before queries that need the whole workspace),
		// several at once.
		def loadAll() {
			loadFiles(pendingSources.keys())
		}

		// allFiles is every file of the workspace, the pending ones parsed
		// first.
		def allFiles() map<string, FileSymbols> {
			loadAll()
			return files
		}

		// ensureModule parses the registered files of the module.
		internal def ensureModule(name string) {
			return unless pendingByModule.hasKey(name)
			let paths = pendingByModule[name]
			pendingByModule = pendingByModule.delete(name)
			loadFiles(paths)
		}

		// loadFiles parses and analyzes the registered files among `paths`
		// on tasks of their own, at most `parallelLoads` at once, and adds
		// them in the order of `paths`. Should the task be cancelled while it
		// waits, the files not added yet stay registered.
		internal def loadFiles(paths string[]) {
			let todo string[]
			let jobs (async FileSymbols)[]
			let group = new AsyncScope()
			group.limit(parallelLoads)
			for let (_, path) in paths {
				let source = pendingSources.get(path)
				continue when source is none
				todo.push(path)
				jobs.push(async<group> loadSource(source, path))
			}
			for let (i, path) in todo {
				let file = await jobs[i]
				return when jobs[i].canceled()
				adopt(path, file)
			}
		}

		// ensureFile parses a registered file.
		internal def ensureFile(path string) {
			let source = pendingSources.get(path)
			return when source is none
			adopt(path, loadSource(source, path))
		}

		// adopt adds a registered file, as loadSource read it, in place of
		// its source.
		internal def adopt(path string, file FileSymbols) {
			pendingSources = pendingSources.delete(path)
			headers = headers.delete(path)
			lexed = lexed.delete(path)
			loading = true
			addAnalyzed(path, file)
			loading = false
		}

		// moduleSymbols is the module declared by each file of the workspace,
		// each path once, in path order, the prelude's (`builtin`) left out:
		// the unit symbol of a parsed module's first part, and for a
		// registered module not parsed yet the one its header declares
		// (`headerSymbol`). Nothing is parsed whole, so an editor's `use`
		// completions name every module the workspace knows at once.
		def moduleSymbols() Symbol[] {
			let byPath map<string, Symbol>
			for let (name, parts) in modules {
				continue when name == "builtin" || parts.len() == 0
				byPath[name] = parts[0]
			}
			for let (name, paths) in pendingByModule {
				continue when name == "builtin" || paths.len() == 0 || byPath.hasKey(name)
				let header = headerSymbol(paths[0])
				byPath[name] = header unless header is none
			}
			let names = byPath.keys()
			names.sort((a string, b string) => a < b)
			let out Symbol[]
			for let (_, name) in names {
				out.push(byPath[name])
			}
			return out
		}

		// headerSymbol is the module a registered file's header declares: the
		// source up to its opening brace, closed and parsed (a few tokens
		// whatever the file's size; the 2439 headers of std take 126 ms), so
		// the symbol carries the module's name, path and doc comment, with
		// its name span in the file. None for a file that is parsed or whose
		// header declares no module. Kept until the file is parsed or forgotten.
		internal def headerSymbol(path string) ?Symbol {
			return headers[path] when headers.hasKey(path)
			let source = pendingSources.get(path)
			return none when source is none
			let brace = source.indexOf("\{")
			return none when brace < 0
			let file = analyze(parse(source[:brace + 1] + "\}"), path)
			for let (_, unit) in file.units {
				continue unless unit.kind == SymbolKind.Module
				headers[path] = unit
				return unit
			}
			return none
		}

		// declaredNames is every top-level declaration of the kind in the
		// units of the workspace's files (check suites aside), each module's
		// name once, sorted by name and module, internal ones included and
		// marked. Nothing is parsed: a registered file is lexed the first time
		// it is asked about and its names kept until it is parsed or
		// forgotten, so a chooser can list every interface or datatype the
		// workspace knows.
		def declaredNames(kind SymbolKind) DeclaredName[] {
			let seen map<string, bool>
			let out DeclaredName[]
			for let (path, file) in files {
				for let (_, unit) in file.units {
					continue when unit.kind == SymbolKind.Check
					for let (_, d) in unit.members {
						continue unless d.kind == kind
						let key = unit.path + "." + d.name
						continue when seen.hasKey(key)
						seen[key] = true
						out.push(DeclaredName{name: d.name, kind: kind, moduleName: unit.path, file: path, isInternal: d.isInternal})
					}
				}
			}
			for let (path, source) in pendingSources {
				for let (_, d) in lexedFile(path, source).names {
					continue unless d.kind == kind
					let key = d.moduleName + "." + d.name
					continue when seen.hasKey(key)
					seen[key] = true
					out.push(d)
				}
			}
			out.sort((a DeclaredName, b DeclaredName) => a.name < b.name || a.name == b.name && a.moduleName < b.moduleName)
			return out
		}

		// lexedFile is what a registered file's tokens say, read once and
		// kept until the file is parsed or forgotten.
		internal def lexedFile(path string, source string) LexedFile {
			let known = lexed.get(path)
			return known unless known is none
			let read = lexFile(path, source)
			lexed[path] = read
			return read
		}

		// forgetPending drops a registered file that was not parsed.
		internal def forgetPending(path string) {
			return unless pendingSources.hasKey(path)
			pendingSources = pendingSources.delete(path)
			headers = headers.delete(path)
			lexed = lexed.delete(path)
			for let (name, paths) in pendingByModule {
				continue unless path in paths
				let kept string[]
				for let (_, p) in paths {
					kept.push(p) unless p == path
				}
				pendingByModule[name] = kept
			}
		}
	}

	// DeclaredName is a top-level declaration of a unit, known without
	// parsing its file: its name and kind, the module (or application) it
	// is in, the file, and whether it is internal to its module.
	struct DeclaredName {
		name       string
		kind       SymbolKind
		moduleName string
		file       string
		isInternal bool
	}

	// LexedFile is what a source's tokens say without parsing it: the
	// declarations written directly in its unit's body, and the module
	// paths its `use`s import, wherever they stand.
	internal struct LexedFile {
		names DeclaredName[]
		uses  string[]
	}

	// lexFile reads a source's one unit from its tokens: the name after a
	// declaration keyword at the body's depth (`internal` noted when it
	// stands before the keyword), and the path of every `use` item.
	internal def lexFile(path string, source string) LexedFile {
		let out = LexedFile{}
		let names = headerModules(source)
		return out when names.len() != 1
		let lex = new Lexer(source, comments = false)
		let depth = 0
		let internalSeen = false
		let tok = lex.next()
		for tok.kind != TokenKind.EOF {
			if tok.kind == TokenKind.Use {
				tok = readUse(lex, out.uses)
				continue
			}
			if tok.kind == TokenKind.LBrace {
				depth++
			} else if tok.kind == TokenKind.RBrace {
				depth--
				internalSeen = false
			} else if depth == 1 {
				if tok.kind == TokenKind.Internal {
					internalSeen = true
				} else {
					let kind = declarationKind(tok.kind)
					if !(kind is none) {
						tok = lex.next()
						tok = lex.next() when kind == SymbolKind.Function && tok.kind == TokenKind.Async
						out.names.push(DeclaredName{name: tok.text, kind: kind, moduleName: names[0], file: path, isInternal: internalSeen}) when tok.kind == TokenKind.Ident
						internalSeen = false
						continue
					}
				}
			}
			tok = lex.next()
		}
		return out
	}

	// readUse reads the `use` the lexer stands after, a single item or a
	// group, adding each item's module path to `into`; the token after it.
	internal def readUse(lex Lexer, into string[]) Token {
		let tok = lex.next()
		return readUseItem(lex, tok, into) unless tok.kind == TokenKind.LParen
		tok = lex.next()
		for tok.kind != TokenKind.RParen && tok.kind != TokenKind.EOF {
			if isWord(tok) {
				tok = readUseItem(lex, tok, into)
			} else {
				tok = lex.next()
			}
		}
		return tok.kind == TokenKind.RParen ?? (lex.next(), tok)
	}

	// readUseItem reads one item from `tok`: its dotted path, added to
	// `into`, then an `as` alias or a `::` list; the token after it.
	internal def readUseItem(lex Lexer, first Token, into string[]) Token {
		return first unless isWord(first)
		let path = first.text
		let tok = lex.next()
		for tok.kind == TokenKind.Dot {
			tok = lex.next()
			break unless isWord(tok)
			path += "." + tok.text
			tok = lex.next()
		}
		into.push(path)
		if tok.kind == TokenKind.As {
			lex.next()
			return lex.next()
		}
		return tok unless tok.kind == TokenKind.ColonColon
		tok = lex.next()
		return lex.next() unless tok.kind == TokenKind.LParen
		let depth = 1
		for depth > 0 {
			tok = lex.next()
			return tok when tok.kind == TokenKind.EOF
			depth++ when tok.kind == TokenKind.LParen
			depth-- when tok.kind == TokenKind.RParen
		}
		return lex.next()
	}

	// isWord is true for a name or a keyword, which a module path's parts
	// may be (`std.ui.view`).
	internal def isWord(tok Token) bool {
		return tok.text.len() > 0 && (tok.text[0].isLetter() || tok.text[0] == '_')
	}

	// declarationKind is the kind a keyword declares at a unit's top level;
	// none for any other token.
	internal def declarationKind(kind TokenKind) ?SymbolKind {
		switch kind {
			case TokenKind.Type:
				return SymbolKind.Type
			case TokenKind.Struct:
				return SymbolKind.Struct
			case TokenKind.Enum:
				return SymbolKind.Enum
			case TokenKind.Union:
				return SymbolKind.Union
			case TokenKind.Interface:
				return SymbolKind.Interface
			case TokenKind.Datatype:
				return SymbolKind.Datatype
			case TokenKind.Service:
				return SymbolKind.Service
			case TokenKind.Component:
				return SymbolKind.Component
			case TokenKind.View:
				return SymbolKind.View
			case TokenKind.Style:
				return SymbolKind.Style
			case TokenKind.Def:
				return SymbolKind.Function
			case TokenKind.Const:
				return SymbolKind.Const
			default:
				return none
		}
	}

	// headerModules is the module name the first unit of a source declares
	// (`module a.b`, `partial module a.b`, `application X`, `library X`,
	// `plugin X`), as a list of one; empty for a source that opens with
	// something else (a check suite, a syntax error). Lexing stops at the
	// name, so a header costs a few tokens whatever the file's size;
	// `unitHeaders` says whether more units follow.
	def headerModules(source string) string[] {
		let out string[]
		let lex = new Lexer(source, comments = false)
		let tok = lex.next()
		for tok.kind != TokenKind.EOF {
			break when tok.kind == TokenKind.LBrace
			if tok.kind == TokenKind.Module || tok.kind == TokenKind.Application || tok.kind == TokenKind.Library || tok.kind == TokenKind.Plugin {
				let name = ""
				tok = lex.next()
				for tok.kind == TokenKind.Ident || tok.kind == TokenKind.Dot {
					name += tok.text
					tok = lex.next()
				}
				out.push(name) when name.len() > 0
				return out
			}
			tok = lex.next()
		}
		return out
	}

	// unitHeaders counts the unit headers written at the start of a line
	// (where a top-level unit begins): a source with more than one holds
	// several units and is parsed rather than registered by its header.
	def unitHeaders(source string) int {
		let text = "\n" + source
		return text.count("\nmodule ") + text.count("\npartial module ") + text.count("\napplication ") + text.count("\nlibrary ") + text.count("\nplugin ") + text.count("\ncheck ")
	}
}
