partial module std.adm.symbols {
	use (
		std.adm.lexer::(Lexer, TokenKind)
		std.adm.syntax::(parse)
	)

	partial type Workspace {
		// register makes a file part of the workspace without parsing it:
		// the module its header names is recorded, and the file is parsed
		// and analyzed the first time that module, the file itself or the
		// whole workspace is asked for. A file whose header is not one
		// unit's (several modules, no module) or that declares units
		// (`@unit`, `@dimension`, which every file may name) is parsed at
		// once. Registering a file added before replaces it.
		def register(path string, source string) {
			remove(path)
			let names = headerModules(source)
			if names.len() != 1 || unitHeaders(source) > 1 || source.contains("@unit(\"") || source.contains("@dimension(unit") {
				add(path, parse(source))
				return
			}
			pendingSources[path] = source
			let name = names[0]
			if pendingByModule.hasKey(name) {
				pendingByModule[name].push(path)
			} else {
				pendingByModule[name] = [path]
			}
		}

		// pending is how many registered files are not parsed yet.
		def pending() int {
			return pendingSources.len()
		}

		// loadAll parses every registered file that is not parsed yet (a
		// background pass before queries that need the whole workspace).
		def loadAll() {
			for let (_, path) in pendingSources.keys() {
				ensureFile(path)
			}
		}

		// allFiles is every file of the workspace, the pending ones parsed
		// first.
		def allFiles() map<string, FileSymbols> {
			loadAll()
			return files
		}

		// ensureModule parses the registered files of the module.
		internal def ensureModule(name string) {
			return unless pendingByModule.hasKey(name)
			let paths = pendingByModule[name]
			pendingByModule = pendingByModule.delete(name)
			for let (_, path) in paths {
				ensureFile(path)
			}
		}

		// ensureFile parses a registered file.
		internal def ensureFile(path string) {
			let source = pendingSources.get(path)
			return when source is none
			pendingSources = pendingSources.delete(path)
			add(path, parse(source))
		}

		// forgetPending drops a registered file that was not parsed.
		internal def forgetPending(path string) {
			return unless pendingSources.hasKey(path)
			pendingSources = pendingSources.delete(path)
			for let (name, paths) in pendingByModule {
				continue unless path in paths
				let kept string[]
				for let (_, p) in paths {
					kept.push(p) unless p == path
				}
				pendingByModule[name] = kept
			}
		}
	}

	// headerModules is the module name the first unit of a source declares
	// (`module a.b`, `partial module a.b`, `application X`, `library X`,
	// `plugin X`), as a list of one; empty for a source that opens with
	// something else (a check suite, a syntax error). Lexing stops at the
	// name, so a header costs a few tokens whatever the file's size;
	// `unitHeaders` says whether more units follow.
	def headerModules(source string) string[] {
		let out string[]
		let lex = new Lexer(source, comments = false)
		let tok = lex.next()
		for tok.kind != TokenKind.EOF {
			break when tok.kind == TokenKind.LBrace
			if tok.kind == TokenKind.Module || tok.kind == TokenKind.Application || tok.kind == TokenKind.Library || tok.kind == TokenKind.Plugin {
				let name = ""
				tok = lex.next()
				for tok.kind == TokenKind.Ident || tok.kind == TokenKind.Dot {
					name += tok.text
					tok = lex.next()
				}
				out.push(name) when name.len() > 0
				return out
			}
			tok = lex.next()
		}
		return out
	}

	// unitHeaders counts the unit headers written at the start of a line
	// (where a top-level unit begins): a source with more than one holds
	// several units and is parsed rather than registered by its header.
	def unitHeaders(source string) int {
		let text = "\n" + source
		return text.count("\nmodule ") + text.count("\npartial module ") + text.count("\napplication ") + text.count("\nlibrary ") + text.count("\nplugin ") + text.count("\ncheck ")
	}
}
