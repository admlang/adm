partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	check "Lazy" {
		// The names of every interface or datatype, whether its file is
		// parsed or only registered, without parsing one.
		@test()
		def TestDeclaredNamesWithoutParsing() {
			let w = new Workspace()
			w.register("io.adm", fixture("""
module io «
	use std.text
	// Reader reads.
	@doc("x")
	interface Reader «
		read(n int) !string
	»
	internal interface Seeker «
		def seek(at int)
	»
	datatype Pointy «
		x int
	»
	def open() « »
	check "inner" «
		interface Ignored « »
	»
»
"""))
			w.register("io_more.adm", fixture("""
partial module io «
	interface Closer « def close() »
	type Box « internal def done() « » »
»
"""))
			w.add("shapes.adm", parse(fixture("""
module shapes «
	internal interface Drawable « draw() »
	interface Reader « »
»
""")))
			let interfaces = w.declaredNames(SymbolKind.Interface)
			let rows string[]
			for let (_, d) in interfaces {
				rows.push("{d.moduleName}.{d.name}:{d.isInternal}")
			}
			assert rows.join(",") == "io.Closer:false,shapes.Drawable:true,io.Reader:false,shapes.Reader:false,io.Seeker:true"
			assert interfaces[0].file == "io_more.adm" && interfaces[0].kind == SymbolKind.Interface
			assert w.pending() == 2
			let datatypes = w.declaredNames(SymbolKind.Datatype)
			assert datatypes.len() == 1 && datatypes[0].name == "Pointy"
			assert w.declaredNames(SymbolKind.Function).len() == 1 && w.declaredNames(SymbolKind.Type)[0].name == "Box"
			// Parsing a file answers from its symbols, once per name.
			assert w.lookup("io", "Reader").len() == 1 && w.pending() == 0
			assert w.declaredNames(SymbolKind.Interface).len() == 5
			w.remove("io_more.adm")
			assert w.declaredNames(SymbolKind.Interface).len() == 4
		}

		@test()
		def TestRegisterParsesOnDemand() {
			let w = new Workspace()
			let geometry = fixture("""
module geometry «
	struct Point «
		x int
		y int
	»
»
""")
			let colours = fixture("""
partial module colours «
	enum Hue «
		Red,
		Green
	»
»
""")
			let units = fixture("""
module measures «
	@dimension(unit = "m")
	type Length
»
""")
			let program = fixture("""
module app «
	use geometry::(Point)
	def main() «
		let p = Point«x: 1, y: 2»
	»
»
""")
			w.register("geometry.adm", geometry)
			w.register("colours.adm", colours)
			w.register("measures.adm", units)
			w.register("app.adm", program)
			// A file declaring units is parsed at once; the others wait.
			assert w.pending() == 3 && w.unitNamed("m").len() == 1
			// A lookup parses that module's files only.
			assert w.lookup("geometry", "Point").len() == 1 && w.pending() == 2
			assert w.files.hasKey("geometry.adm") && !w.files.hasKey("colours.adm")
			// Resolution from a program file parses the program and the module it imports.
			let app = presentFile(w.file("app.adm"))
			assert w.pending() == 1
			let nav = new Navigator(w)
			assert pathsOf(nav.definitionAt(app, program.indexOf("x: 1"))) == "geometry.Point.x"
			assert w.pending() == 1
			// Whole-workspace queries load the rest.
			assert w.declarationsOfKind(SymbolKind.Enum).len() == 1 && w.pending() == 0
			// Registering again replaces the parsed file; removing a pending one forgets it.
			w.register("colours.adm", colours)
			assert w.pending() == 1 && w.lookup("colours", "Hue").len() == 1 && w.pending() == 0
			w.register("colours.adm", colours)
			w.remove("colours.adm")
			assert w.pending() == 0 && w.lookup("colours", "Hue").len() == 0
			// Headers: dotted names, a doc comment before a partial module, a
			// check suite; several units at the top level count.
			assert headerModules("module a.b.c \{\n\}\n").join(",") == "a.b.c"
			assert headerModules("// doc\npartial module x \{ module y \{ \} \}\n").join(",") == "x"
			assert headerModules("check \"only\" \{\n\}\n").len() == 0
			assert unitHeaders("module x \{\n\}\napplication App \{\}\n") == 2 && unitHeaders("module x \{\n\tcheck \"c\" \{\}\n\}\n") == 1
			w.register("more.adm", geometry.replace("geometry", "shapes"))
			assert w.pending() == 1
			w.loadAll()
			assert w.pending() == 0 && w.allFiles().hasKey("more.adm")
			let twoModules = fixture("""
module one «»
module two «»
""")
			w.register("two.adm", twoModules)
			assert w.pending() == 0 && w.parts("two").len() == 1
		}

		// Files loaded together, each on a task of its own, read as the same
		// files added one by one.
		@test()
		def TestFilesLoadedTogetherReadAsAddedOneByOne() {
			let template = fixture("""
module shapes@ «
	use std.text
	// Reader@ reads.
	interface Reader@ «
		read(n int) !string
	»
	struct Point@ «
		x int
		y int
	»
	enum Hue@ «
		Red,
		Green
	»
	def area@(p Point@) int «
		let w = p.x
		return w * p.y
	»
»
""")
			let together = new Workspace()
			let alone = new Workspace()
			let paths string[]
			for let i = 0; i < 40; i++ {
				let path = "shapes{i}.adm"
				let source = template.replace("@", "{i}")
				paths.push(path)
				together.register(path, source)
				alone.add(path, parse(source, bodies = false))
			}
			assert together.pending() == 40
			together.loadAll()
			assert together.pending() == 0
			for let (_, path) in paths {
				assert symbolRows(presentFile(together.file(path))) == symbolRows(presentFile(alone.file(path)))
			}
			assert together.declarationsOfKind(SymbolKind.Interface).len() == 40
		}
	}

	// symbolRows spells what a file declares, in order: each declaration's
	// kind, path, name span, doc comment, parent and member count.
	internal def symbolRows(file FileSymbols) string {
		let rows string[]
		for let (_, d) in file.declarations {
			let parent = "-"
			let p = d.parent
			parent = p.path unless p is none
			rows.push("{d.kind}:{d.path}:{d.nameStart}-{d.nameEnd}:{d.doc}:{parent}:{d.members.len()}")
		}
		return rows.join("\n")
	}

	// presentFile is the file, which the test expects to be there.
	internal def presentFile(value ?FileSymbols) FileSymbols {
		return value unless value is none
		assert false
		let w = new Workspace()
		return w.add("", parse(""))
	}
}
