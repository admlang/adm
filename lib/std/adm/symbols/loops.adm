partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// loopVariableRef is the written type a loop variable takes from what
		// its loop ranges over: the element type of an array, the key or
		// value type of a map (`for let (k, v) in m`), the element type of a
		// channel, what a type's `iterate()` yields. None for another local,
		// and for an index, a range or a string's characters, whose types
		// are not written anywhere (`loopVariableType` knows them).
		internal def loopVariableRef(file FileSymbols, symbol Symbol, depth int) ?TypeRef {
			let ranged = rangedExpression(symbol)
			return none when ranged is none
			let container = typeRefOfDepth(file, ranged, depth + 1)
			return none when container is none
			let actual = followBindings(container)
			let position = loopVariablePosition(symbol)
			if actual.node.kind() == SyntaxKind.ArrayType {
				return none when position == 0
				return elementRef(actual)
			}
			return none unless actual.node.kind() == SyntaxKind.NamedType
			let name = builtinName(actual)
			if name == "map" {
				return keyRef(actual) when position == 0
				return elementRef(actual)
			}
			return elementRef(actual) when name == "channel" && position != 0
			return none when name.len() > 0
			// A value of a type with `def iterate() ?T` yields a T.
			return none when position == 0
			let owner = typeSymbol(actual.file, actual.node)
			return none when owner is none
			let iterate = first(membersNamed(file, owner, "iterate"))
			return none when iterate is none
			return memberTypeRef(file, actual, iterate)
		}

		// loopVariableType is the type of a loop variable whose type is not
		// written anywhere: the index of an array or a string is a `Number`,
		// a string's characters are `char`s, a range yields `Number`s. None
		// for another local.
		internal def loopVariableType(file FileSymbols, symbol Symbol, depth int) ?Symbol {
			let ranged = rangedExpression(symbol)
			return none when ranged is none
			let position = loopVariablePosition(symbol)
			if ranged.kind() == SyntaxKind.Binary {
				let op = ranged.child(1)
				return none when op is none
				return first(workspace.lookup("builtin", "Number")) when op.isToken() && op.token() == TokenKind.Range
				return none
			}
			let container = typeOfDepth(file, ranged, depth + 1)
			return none when container is none
			return none unless container.path.startsWith("builtin.")
			if container.name == "string" {
				return first(workspace.lookup("builtin", "Number")) when position == 0
				return first(workspace.lookup("builtin", "char"))
			}
			return first(workspace.lookup("builtin", "Number")) when container.name == "array" && position == 0
			return none
		}

		// rangedExpression is what the loop declaring the symbol ranges over
		// (`items` in `for let (i, x) in items`), none when the symbol is not
		// a loop variable.
		internal def rangedExpression(symbol Symbol) ?SyntaxNode {
			return none unless symbol.kind == SymbolKind.Local
			let field = symbol.node
			return none unless field.kind() == SyntaxKind.Field
			let decl = field.parent
			return none when decl is none
			return none unless decl.kind() == SyntaxKind.LetDecl
			let header = decl.parent
			return none when header is none
			return none unless header.kind() == SyntaxKind.Header
			let seenIn = false
			for let (_, c) in header.children() {
				if seenIn {
					return c unless c.isToken()
					continue
				}
				seenIn = true when c.isToken() && c.token() == TokenKind.In
			}
			return none
		}

		// loopVariablePosition is 0 for the first name of a `(key, value)`
		// pair, 1 for the second or a single name.
		internal def loopVariablePosition(symbol Symbol) int {
			let names = 0
			let at = 0
			for let (_, c) in symbol.node.children() {
				continue unless c.isToken() && c.token() == TokenKind.Ident
				at = names when c.start() == symbol.nameStart
				names++
			}
			return 1 when names < 2
			return at
		}
	}
}
