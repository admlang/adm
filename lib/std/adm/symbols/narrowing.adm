partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// narrowedType is the type a name has where it is read, given what
		// the code around it has tested (the compiler's `ifIsNarrowing`,
		// `conditionNarrowings`, `applyPersistentNarrowing`): the right side
		// of `&&` and `||`, an arm of `??`, the branches of an `if`, a
		// statement guarded by `when`/`unless`, a `match` arm, and the rest
		// of a block after a guarded or `if` statement that leaves it
		// (`return when x is none`). The nearest test wins; an assignment
		// to the name between a test and the read ends it.
		internal def narrowedType(file FileSymbols, read SyntaxNode, symbol Symbol, declared Type, depth int) Type {
			return declared when depth > maxDepth
			// A test changes nothing of a concrete type or a plain primitive:
			// most reads are of those, and they are not looked into.
			return declared unless narrowable(declared)
			let persistent = persists(symbol)
			let child = read
			let up = read.parent
			for {
				let node = up
				return declared when node is none
				let k = node.kind()
				// The function the name is read in is as far as tests reach; a
				// lambda and an anonymous `def` see the tests around them.
				return declared when k == SyntaxKind.FuncDecl && !isAnonymousDef(node)
				let found = factAbove(file, node, child, symbol, persistent, depth)
				return found unless found is none
				child = node
				up = node.parent
			}
		}

		// isAnonymousDef is true for a `def (...) { ... }` written as a value,
		// without a name.
		internal def isAnonymousDef(fn SyntaxNode) bool {
			// `def (` without a name, an operator (`infix def +(`) or type
			// parameters between.
			let last ?SyntaxNode = none
			for let (_, c) in fn.children() {
				if c.kind() == SyntaxKind.Params {
					let before = last
					return !(before is none) && before.isToken() && before.token() == TokenKind.Def
				}
				last = c
			}
			return false
		}

		// narrowable is true for a type an `is` test can narrow: an optional,
		// an errorable, a union, `any`, an interface, a datatype, a type
		// parameter.
		internal def narrowable(t Type) bool {
			let p = plain(t)
			switch p.kind {
				case TypeKind.Optional, TypeKind.Fallible, TypeKind.Union, TypeKind.TypeParam:
					return true
				case TypeKind.Primitive:
					return p.name == "any" || p.name == "anydata"
				case TypeKind.Named:
					let declared = declarationOf(p)
					return !(declared is none) && (declared.kind == SymbolKind.Interface || declared.kind == SymbolKind.Datatype)
				default:
					return false
			}
		}

		// persists is true for a symbol a test narrows for the rest of its
		// block (the compiler's `canPersistNarrowing`).
		internal def persists(symbol Symbol) bool {
			switch symbol.kind {
				case SymbolKind.Local, SymbolKind.Parameter, SymbolKind.Const, SymbolKind.Field, SymbolKind.Property:
					return true
				default:
					return false
			}
		}

		// factAbove is what the node above the read says of the symbol for
		// its child that holds the read, none when it says nothing.
		internal def factAbove(file FileSymbols, node SyntaxNode, child SyntaxNode, symbol Symbol, persistent bool, depth int) ?Type {
			switch node.kind() {
				case SyntaxKind.Binary:
					let kids = node.children()
					return none when kids.len() < 3 || !kids[kids.len() - 1].same(child)
					let op = kids[1]
					return none unless op.isToken()
					return conditionFact(file, kids[0], symbol, true, depth) when op.token() == TokenKind.And
					return conditionFact(file, kids[0], symbol, false, depth) when op.token() == TokenKind.Or
					return none
				case SyntaxKind.Choice:
					let parts SyntaxNode[]
					for let (_, c) in node.children() {
						parts.push(c) unless c.isToken()
					}
					return none when parts.len() < 3
					return conditionFact(file, parts[0], symbol, true, depth) when parts[1].same(child)
					return conditionFact(file, parts[0], symbol, false, depth) when parts[2].same(child)
					return none
				case SyntaxKind.If:
					let cond = ifCondition(node)
					return none when cond is none
					return conditionFact(file, cond, symbol, true, depth) when child.kind() == SyntaxKind.Block
					return conditionFact(file, cond, symbol, false, depth) when child.kind() == SyntaxKind.Else
					return none
				case SyntaxKind.Guard:
					let inner = node.child(0)
					return none when inner is none || !inner.same(child)
					let guard = guardOf(node)
					return none when guard is none
					return conditionFact(file, guard.cond, symbol, guard.holds, depth)
				case SyntaxKind.Case:
					// The clause's own statements before the read are nearer than
					// its patterns.
					if persistent {
						let exited = exitFact(file, node, child, symbol, depth)
						return exited unless exited is none
					}
					return caseFact(file, node, child, symbol, depth)
				case SyntaxKind.Default:
					if persistent {
						let exited = exitFact(file, node, child, symbol, depth)
						return exited unless exited is none
					}
					return defaultFact(file, node, symbol, depth)
				case SyntaxKind.Block, SyntaxKind.Body:
					return none unless persistent
					return exitFact(file, node, child, symbol, depth)
				default:
					return none
			}
		}

		// exitFact is what the statements of the block before the one holding
		// the read say once they let control reach it: a guarded `return`, `fail`,
		// `break` or `continue` (`return when x is none`: x is not none after
		// it), an `if` whose branch leaves.
		internal def exitFact(file FileSymbols, block SyntaxNode, child SyntaxNode, symbol Symbol, depth int) ?Type {
			let before SyntaxNode[]
			for let (_, s) in block.children() {
				break when s.same(child)
				before.push(s) unless s.isToken()
			}
			for let i = before.len() - 1; i >= 0; i-- {
				let s = before[i]
				// A test before an assignment says nothing after it; one in a
				// branch that leaves never reaches the read.
				return none when assignsOnTheWay(file, s, symbol)
				if s.kind() == SyntaxKind.Guard {
					let inner = s.child(0)
					let guard = guardOf(s)
					if !(inner is none) && !(guard is none) && terminates(inner) {
						let fact = conditionFact(file, guard.cond, symbol, !guard.holds, depth)
						return fact unless fact is none || isPrimitiveNamed(fact, "none") && !keepsNone(symbol)
					}
					continue
				}
				if s.kind() == SyntaxKind.If {
					let cond = ifCondition(s)
					continue when cond is none
					let thenLeaves = blockLeaves(childOfKind(s, SyntaxKind.Block))
					let elseLeaves = elseLeaves(childOfKind(s, SyntaxKind.Else))
					let fact ?Type = none
					if thenLeaves && !elseLeaves {
						fact = conditionFact(file, cond, symbol, false, depth)
					} else if elseLeaves && !thenLeaves {
						fact = conditionFact(file, cond, symbol, true, depth)
					}
					return fact unless fact is none || isPrimitiveNamed(fact, "none") && !keepsNone(symbol)
				}
			}
			return none
		}

		// keepsNone is false for a field or a property: what a test narrows
		// them to stays only when it is not `none`.
		internal def keepsNone(symbol Symbol) bool {
			return symbol.kind != SymbolKind.Field && symbol.kind != SymbolKind.Property
		}

		// caseFact is the type a `match` arm's patterns give the name the
		// match is on (`match x { case int: ... }`).
		internal def caseFact(file FileSymbols, clause SyntaxNode, child SyntaxNode, symbol Symbol, depth int) ?Type {
			let block = clause.parent
			return none when block is none
			let matched = block.parent
			return none when matched is none || matched.kind() != SyntaxKind.Match
			let subject = matchSubject(matched)
			return none when subject is none || !namesSymbol(file, subject, symbol)
			let tests Type[]
			for let (_, c) in clause.children() {
				break when c.isToken() && c.token() == TokenKind.Colon
				continue when c.isToken()
				// The arm's statements come after the `:`; the read is in them.
				return none when c.same(child)
				let test = patternType(file, c)
				return none when test is none
				tests.push(test)
			}
			return none when tests.len() == 0
			let scrutinee = exprType(file, subject, depth + 1)
			let narrowed Type[]
			for let (_, t) in tests {
				narrowed.push(narrowTypes(file, scrutinee, t).then)
			}
			return table().setType(TypeKind.Union, narrowed)
		}

		// defaultFact is the type a `match`'s `default` arm gives the name the
		// match is on (the compiler's `matchDefaultRemainder`): the members of
		// its union no `case` names.
		internal def defaultFact(file FileSymbols, clause SyntaxNode, symbol Symbol, depth int) ?Type {
			let block = clause.parent
			return none when block is none
			let matched = block.parent
			return none when matched is none || matched.kind() != SyntaxKind.Match
			let subject = matchSubject(matched)
			return none when subject is none || !namesSymbol(file, subject, symbol)
			let scrutinee = exprType(file, subject, depth + 1)
			let members = plain(scrutinee)
			return none unless members.kind == TypeKind.Union
			let covered Type[]
			for let (_, arm) in block.children() {
				continue unless arm.kind() == SyntaxKind.Case
				for let (_, c) in arm.children() {
					break when c.isToken() && c.token() == TokenKind.Colon
					continue when c.isToken()
					let test = patternType(file, c)
					continue when test is none
					let p = plain(test)
					if p.kind == TypeKind.Union {
						for let (_, m) in p.args {
							covered.push(m)
						}
					} else {
						covered.push(test)
					}
				}
			}
			return none when covered.len() == 0
			let keep Type[]
			for let (_, m) in members.args {
				let dropped = false
				for let (_, t) in covered {
					dropped = true when m == t || plain(m) == plain(t)
				}
				keep.push(m) unless dropped
			}
			return none when keep.len() == 0 || keep.len() == members.args.len()
			return table().setType(TypeKind.Union, keep)
		}

		// memberNarrowedType is the type a member path (`x.y`, `self.y`) has
		// where it is read inside a statement guarded by a test of that path
		// (the compiler's `ifIsMemberAccessNarrowing`: `x = c.v when c.v is
		// float`, `use(p.next) unless p.next is none`). Unlike a name's, such
		// a test reaches no further than its statement.
		internal def memberNarrowedType(file FileSymbols, read SyntaxNode, declared Type, depth int) Type {
			return declared when depth > maxDepth
			return declared unless narrowable(declared)
			let kids = read.children()
			return declared when kids.len() < 3
			let receiver = kids[0]
			return declared unless receiver.kind() == SyntaxKind.Name
			let path = read.text().replace(" ", "")
			let child = read
			let up = read.parent
			for {
				let node = up
				return declared when node is none
				let k = node.kind()
				return declared when k == SyntaxKind.FuncDecl || k == SyntaxKind.Lambda || k == SyntaxKind.Block
				if k == SyntaxKind.Guard {
					let inner = node.child(0)
					let guard = guardOf(node)
					if !(inner is none) && inner.same(child) && !(guard is none) {
						let fact = memberTestFact(file, guard.cond, path, guard.holds, depth)
						return fact unless fact is none
					}
				}
				child = node
				up = node.parent
			}
		}

		// memberTestFact is the type `path is T` (through `!` and parentheses)
		// leaves the path with when the condition is `truth`; none for
		// another condition.
		internal def memberTestFact(file FileSymbols, cond SyntaxNode, path string, truth bool, depth int) ?Type {
			let current = cond
			let holds = truth
			for {
				if current.kind() == SyntaxKind.Paren {
					let inner = firstNonToken(current)
					return none when inner is none
					current = inner
					continue
				}
				if current.kind() == SyntaxKind.Unary {
					let op = current.child(0)
					let inner = firstNonToken(current)
					return none when op is none || inner is none || !op.isToken() || op.token() != TokenKind.Not
					holds = !holds
					current = inner
					continue
				}
				break
			}
			return none unless current.kind() == SyntaxKind.Binary
			let kids = current.children()
			return none when kids.len() < 3
			let op = kids[1]
			return none unless op.isToken() && op.token() == TokenKind.Is
			let left = kids[0]
			return none unless left.kind() == SyntaxKind.Member && left.text().replace(" ", "") == path
			let test = testedType(file, kids[kids.len() - 1])
			return none when test is none
			let split = narrowTypes(file, exprType(file, left, depth + 1), test)
			let t = holds ?? (split.then, split.otherwise)
			return none when t.kind == TypeKind.Unknown
			return t
		}

		// patternType is the type a `case` pattern tests, none for a value
		// pattern.
		internal def patternType(file FileSymbols, pattern SyntaxNode) ?Type {
			if pattern.kind() == SyntaxKind.Literal {
				let t = pattern.firstToken()
				return table().primitiveType("none") when !(t is none) && t.token() == TokenKind.None
				return none
			}
			return writtenType(file, pattern) when isTypeNode(pattern.kind())
			// `x is float32[]` reads its right side as an empty typed literal.
			if pattern.kind() == SyntaxKind.ArrayLit {
				let element = typedArrayElement(pattern)
				return none when element is none || pattern.childCount() != 3
				return table().wrapType(TypeKind.Array, writtenType(file, element))
			}
			return none unless pattern.kind() == SyntaxKind.Name || pattern.kind() == SyntaxKind.Member
			let named = staticSymbol(file, pattern)
			if named is none {
				// A primitive's or the prelude's name (`case int:`).
				let t = pattern.firstToken()
				return none when t is none
				return builtinType(t.text(), [], [])
			}
			return none unless isTypeLike(named.kind)
			return declaredTypeOf(file, named, [], 0)
		}

		// conditionFact is the type a condition being `truth` gives the name
		// (the compiler's `conditionNarrowings`): `x is T` and `x is none`,
		// through `!`, `( )`, the parts of `&&` when it holds and of `||`
		// when it does not.
		internal def conditionFact(file FileSymbols, cond SyntaxNode, symbol Symbol, truth bool, depth int) ?Type {
			return none when depth > maxDepth
			switch cond.kind() {
				case SyntaxKind.Paren:
					let inner = firstNonToken(cond)
					return none when inner is none
					return conditionFact(file, inner, symbol, truth, depth + 1)
				case SyntaxKind.Unary:
					let op = cond.child(0)
					let inner = firstNonToken(cond)
					return none when op is none || inner is none || !(op.isToken() && op.token() == TokenKind.Not)
					return conditionFact(file, inner, symbol, !truth, depth + 1)
				case SyntaxKind.Binary:
					let kids = cond.children()
					return none when kids.len() < 3
					let op = kids[1]
					return none unless op.isToken()
					let left = kids[0]
					let right = kids[kids.len() - 1]
					switch op.token() {
						case TokenKind.And:
							return none unless truth
							let r = conditionFact(file, right, symbol, true, depth + 1)
							return r unless r is none
							return conditionFact(file, left, symbol, true, depth + 1)
						case TokenKind.Or:
							return none when truth
							let r = conditionFact(file, right, symbol, false, depth + 1)
							return r unless r is none
							return conditionFact(file, left, symbol, false, depth + 1)
						case TokenKind.Is:
							return none unless namesSymbol(file, left, symbol)
							let test = testedType(file, right)
							return none when test is none
							let split = narrowTypes(file, exprType(file, left, depth + 1), test)
							return truth ?? (split.then, split.otherwise)
						default:
							return none
					}
				default:
					return none
			}
		}

		// testedType is the type the right side of `is` names: `none`, a type
		// written, a name or a member chain naming one.
		internal def testedType(file FileSymbols, right SyntaxNode) ?Type {
			let t = patternType(file, right)
			return none when t is none || t.kind == TypeKind.Unknown
			return t
		}

		// narrowTypes is the type `x is test` leaves x with when it holds and
		// when it does not (the compiler's `narrowTypesForIs`): the members of
		// an optional, an errorable or a union that the test takes, and the
		// others; the test itself for a value of an interface or a datatype
		// it may hold, or of `any`. Unknown when this layer cannot tell.
		internal def narrowTypes(file FileSymbols, seen Type, test Type) Narrowed {
			let scrutinee = plain(seen)
			let unknown = table().unknownType()
			return Narrowed{then: unknown, otherwise: seen} when scrutinee.kind == TypeKind.Unknown
			let isNone = isPrimitiveNamed(test, "none")
			switch scrutinee.kind {
				case TypeKind.Optional:
					let element = scrutinee.args[0]
					if !isNone && element != test {
						let inner = narrowTypes(file, element, test)
						return Narrowed{then: inner.then, otherwise: seen} unless inner.then == element
					}
					return splitMembers(seen, [table().primitiveType("none"), element], test)
				case TypeKind.Fallible:
					let element = scrutinee.args[0]
					let failure = table().primitiveType("error")
					return Narrowed{then: test, otherwise: element} when isErrorType(test)
					return splitMembers(seen, [failure, element], test)
				case TypeKind.Union:
					return splitMembers(seen, scrutinee.args, test)
				case TypeKind.Primitive:
					return Narrowed{then: test, otherwise: seen} when scrutinee.name := "any" || "anydata"
					return Narrowed{then: test, otherwise: seen} when scrutinee == test
					return Narrowed{then: unknown, otherwise: seen}
				case TypeKind.Named:
					let declared = declarationOf(scrutinee)
					return Narrowed{then: test, otherwise: seen} when !(declared is none) && (declared.kind == SymbolKind.Interface || declared.kind == SymbolKind.Datatype)
					return Narrowed{then: test, otherwise: seen} when scrutinee == test || matchesTest(scrutinee, test)
					return Narrowed{then: unknown, otherwise: seen}
				default:
					return Narrowed{then: test, otherwise: seen} when scrutinee == test
					return Narrowed{then: unknown, otherwise: seen}
			}
		}

		// splitMembers splits the members of a union-like type by whether the
		// test takes them: one member left is that member, none left the type
		// as it was.
		internal def splitMembers(seen Type, all Type[], test Type) Narrowed {
			let taken Type[]
			let left Type[]
			for let (_, m) in all {
				if matchesTest(m, test) {
					taken.push(m)
				} else {
					left.push(m)
				}
			}
			let holding = (taken.len() == 0) ?? (seen, table().setType(TypeKind.Union, taken))
			let failing = (left.len() == 0) ?? (seen, table().setType(TypeKind.Union, left))
			return Narrowed{then: holding, otherwise: failing}
		}

		// matchesTest is true when a member is a value `is test` takes: the
		// test itself (type arguments aside when the test writes none),
		// `none` for `none`, what implements an interface or satisfies a
		// datatype the test names, a type parameter.
		internal def matchesTest(member Type, test Type) bool {
			let m = plain(member)
			let t = plain(test)
			return isPrimitiveNamed(m, "none") when isPrimitiveNamed(t, "none")
			return true when member == test || m == t
			return true when m.kind == TypeKind.TypeParam
			if m.kind == TypeKind.Named && t.kind == TypeKind.Named {
				return true when m.path == t.path && (t.args.len() == 0 || t.isUnknown())
				let contract = declarationOf(t)
				let candidate = declarationOf(m)
				return satisfies(candidate, contract) when !(contract is none) && !(candidate is none) && (contract.kind == SymbolKind.Interface || contract.kind == SymbolKind.Datatype)
			}
			return m.str() == t.str() when m.kind == t.kind && m.kind != TypeKind.Named && m.kind != TypeKind.Primitive
			return false
		}

		// isErrorType is true for the prelude's `error`.
		internal def isErrorType(t Type) bool {
			return isPrimitiveNamed(t, "error") || t.kind == TypeKind.Named && t.name == "error"
		}

		// namesSymbol is true for a name expression that refers to the
		// symbol.
		internal def namesSymbol(file FileSymbols, expr SyntaxNode, symbol Symbol) bool {
			return false unless expr.kind() == SyntaxKind.Name
			let t = expr.firstToken()
			return false when t is none || t.text() != symbol.name
			let found = nameSymbol(file, t)
			return !(found is none) && sameDeclaration(found, symbol)
		}

		// assignsOnTheWay is true for a statement that assigns the symbol
		// where control goes on past it: an `if` counts its condition and the
		// branches that do not leave.
		internal def assignsOnTheWay(file FileSymbols, stmt SyntaxNode, symbol Symbol) bool {
			return assigns(file, stmt, symbol) unless stmt.kind() == SyntaxKind.If
			for let (_, c) in stmt.children() {
				continue when c.isToken()
				if c.kind() == SyntaxKind.Block {
					continue when blockLeaves(c)
				} else if c.kind() == SyntaxKind.Else {
					continue when elseLeaves(c)
				}
				return true when assigns(file, c, symbol)
			}
			return false
		}

		// assigns is true for a statement that assigns the symbol (`x = ...`,
		// `x += ...`), at its top or in a statement nested in it.
		internal def assigns(file FileSymbols, stmt SyntaxNode, symbol Symbol) bool {
			return assignsName(stmt, symbol.name)
		}

		// assignsName is true when an assignment under the node writes a name
		// of that spelling, walking the children by kind (a node is made only
		// for one that may hold an assignment). A name of the spelling in an
		// inner scope counts too: the test is then not trusted past it.
		internal def assignsName(n SyntaxNode, name string) bool {
			return false when n.isToken()
			if n.kind() == SyntaxKind.Assign && n.childKind(0) == SyntaxKind.Name {
				let target = n.child(0)
				if !(target is none) && target.childCount() == 1 {
					let token = target.child(0)
					return true when !(token is none) && token.text() == name
				}
			}
			let count = n.childCount()
			for let i = 0; i < count; i++ {
				continue when n.childKind(i) == SyntaxKind.Token
				let c = n.child(i)
				return true when !(c is none) && assignsName(c, name)
			}
			return false
		}

		// terminates is true for a statement after which control does not go
		// on (the compiler's `stmtTerminates`): `return`, `fail`, `break`,
		// `continue`, a block whose last statement leaves, an `if` whose
		// branches both leave.
		internal def terminates(stmt SyntaxNode) bool {
			switch stmt.kind() {
				case SyntaxKind.Return, SyntaxKind.Fail, SyntaxKind.Break, SyntaxKind.Continue:
					return true
				case SyntaxKind.Block:
					return blockLeaves(stmt)
				case SyntaxKind.If:
					return blockLeaves(childOfKind(stmt, SyntaxKind.Block)) && elseLeaves(childOfKind(stmt, SyntaxKind.Else))
				default:
					return false
			}
		}

		// blockLeaves is true for a block whose last statement leaves
		// (`blockTerminates`).
		internal def blockLeaves(block ?SyntaxNode) bool {
			return false when block is none
			let last = lastNonToken(block)
			return !(last is none) && terminates(last)
		}

		// elseLeaves is true for an `else` whose block or `if` leaves.
		internal def elseLeaves(branch ?SyntaxNode) bool {
			return false when branch is none
			let inner = firstNonToken(branch)
			return !(inner is none) && terminates(inner)
		}

		// ifCondition is an `if`'s condition: what its header holds.
		internal def ifCondition(node SyntaxNode) ?SyntaxNode {
			let header = childOfKind(node, SyntaxKind.Header)
			return none when header is none
			return lastNonToken(header)
		}

		// matchSubject is what a `match` is on: its header's expression.
		internal def matchSubject(node SyntaxNode) ?SyntaxNode {
			let header = childOfKind(node, SyntaxKind.Header)
			return none when header is none
			return lastNonToken(header)
		}

		// guardOf is the condition of a `when`/`unless` guard and which.
		internal def guardOf(guard SyntaxNode) ?GuardTest {
			let seenWord = false
			let isWhen = true
			for let (_, c) in guard.children() {
				if c.isToken() && (c.token() == TokenKind.When || c.token() == TokenKind.Unless) {
					seenWord = true
					isWhen = c.token() == TokenKind.When
					continue
				}
				return GuardTest{cond: c, holds: isWhen} when seenWord && !c.isToken()
			}
			return none
		}
	}

	// Narrowed is the type a test leaves when it holds and when it does not.
	internal struct Narrowed {
		then      Type
		otherwise Type
	}

	// GuardTest is a guard's condition and whether it is a `when`.
	internal struct GuardTest {
		cond  SyntaxNode
		holds bool
	}
}
