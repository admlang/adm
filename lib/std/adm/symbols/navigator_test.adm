partial module std.adm.symbols {
	use (
		std.adm.syntax::(SyntaxNode, parse)
		std.testing
	)

	// namesOf is the names of the symbols, joined by `,`.
	internal def namesOf(found Symbol[]) string {
		let out string[]
		for let (_, s) in found {
			out.push(s.name)
		}
		return out.join(",")
	}

	// pathsOf is the paths of the symbols, joined by `,`.
	internal def pathsOf(found Symbol[]) string {
		let out string[]
		for let (_, s) in found {
			out.push(s.path)
		}
		return out.join(",")
	}

	// pathOf is the path of the symbol, "" for none.
	internal def pathOf(found ?Symbol) string {
		return "" when found is none
		return found.path
	}

	// fixture is ADM source for a test: `«` and `»` stand for the braces,
	// which a multi-line string would read as an interpolation.
	internal def fixture(text string) string {
		return text.replace("«", "\{").replace("»", "\}")
	}

	internal def preludeSource() string {
		return fixture("""
partial module builtin «
	meta def cfg(os string) «»
	type string «
		def len() int « return 0 »
		def upper() string « return self »
	»
	type array<T> «
		def len() int « return 0 »
		def push(v T) «»
	»
	type Number<T> «
		def abs() T « return self »
	»
	type map<K, V> «
		def len() int « return 0 »
	»
	type char «
		def isDigit() bool « return false »
	»
	interface Iterator<T> «
		def iterate() ?T
	»
	internal type Enum<V> «
		name string
		value V
		def keys() string[] « return [] »
	»
	def println(v any) «»
»
""")
	}

	internal def libSource() string {
		return fixture("""
module lib «
	// Base is embedded.
	type Base «
		id int
		def describe() string « return "" »
	»

	// File is a file.
	type File «
		Base
		path string
		lines string[]
		def read(n int) !string « return path »
		def owner() File « return self »
	»

	def open(path string) !File « return new File() »
»
""")
	}

	internal def genLibSource() string {
		return fixture("""
module lib «
	type File «
		path string
	»
	struct Point «
		x int
		y int
	»
	type Box<T> «
		value T
		items T[]
		def new(value T, label string = "") «»
		def get() T « return value »
		def label(text string) Box<T> « return self »
	»
	type Lines «
		def iterate() ?File « return none »
	»
	enum Color «
		Red,
		Green
	»
	def area(p Point, scale int = 1) int « return 0 »
»
""")
	}

	internal def genSource() string {
		return fixture("""
module gen «
	use lib::(Point, Box, Lines, area, File, Color)
	def run(files File[], m map<string, File>, s string, lines Lines) «
		let shade = Color.Green
		let shadeName = shade.name.upper()
		let names = Color.keys()
		let p = Point«x: 1, y: 2»
		let q Point = «x: 3»
		let n = area(p, scale = 2)
		let r = area(«x: 4, y: 5»)
		let b = new Box(value = p, label = "b")
		let typed Box<File> = new Box(files[0])
		let v = typed.value.path
		let first = typed.items[0].path
		let got = typed.get().path
		let chained = typed.label("x").value.path
		let k = int(s)
		for let (i, f) in files «
			let fp = f.path
			let ip = i.abs()
		»
		for let (key, val) in m «
			let kp = key.len()
			let vp = val.path
		»
		for let ch in s «
			let cp = ch
		»
		for let j in 0..3 «
			let jp = j.abs()
		»
		for let line in lines «
			let lp = line.path
		»
		typed.label(text = "t")
	»
»
""")
	}

	internal def appSource() string {
		return fixture("""
module app «
	use lib::(File, open)
	use lib

	def main(f File, items File[]) «
		let text = f.read(1)
		let p = f.path.upper()
		let o = f.owner().owner().path
		let first = items[0].path
		let opened = open("x")
		let count = 3
		let id = f.id
		let q = lib.open
		f.
		println(count.abs())
	»
»
""")
	}

	// initializerOf is the expression a `let name = ...` of the file holds.
	internal def initializerOf(file FileSymbols, source string, name string) SyntaxNode {
		let sym = presentSymbol(file.symbolAt(source.indexOf("let " + name + " ") + 4))
		let kids = sym.node.children()
		return kids[kids.len() - 1]
	}

	check "Navigator" {
		@test()
		def TestTypesThroughDeclarations() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(libSource()))
			let source = appSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let main = app.units[0].member("main")[0]
			let f = presentSymbol(app.symbolAt(source.indexOf("f File")))
			assert f.kind == SymbolKind.Parameter
			assert pathOf(nav.typeSymbol(app, presentNode(nav.declaredType(f)))) == "lib.File"
			assert nav.signature(main) == "def main(f File, items File[])"
			assert nav.signature(w.lookup("lib", "open")[0]) == "def open(path string) !File"
			assert nav.signature(w.lookup("lib", "File")[0].member("path")[0]) == "path string"
			assert nav.signature(w.lookup("lib", "File")[0]) == "type File"
			assert pathOf(nav.typeOf(app, initializerOf(app, source, "text"))) == "builtin.string"
			assert pathOf(nav.typeOf(app, initializerOf(app, source, "p"))) == "builtin.string"
			assert pathOf(nav.typeOf(app, initializerOf(app, source, "o"))) == "builtin.string"
			assert pathOf(nav.typeOf(app, initializerOf(app, source, "first"))) == "builtin.string"
			assert pathOf(nav.typeOf(app, initializerOf(app, source, "opened"))) == "lib.File"
			assert pathOf(nav.typeOf(app, initializerOf(app, source, "count"))) == "builtin.Number"
			assert pathOf(nav.symbolOf(app, initializerOf(app, source, "id"))) == "lib.Base.id"
			assert pathOf(nav.symbolOf(app, initializerOf(app, source, "q"))) == "lib.open"
			// An untyped local takes its initializer's type: `opened.` offers File's members.
			let opened = presentSymbol(app.symbolAt(source.indexOf("let opened") + 4))
			assert pathOf(nav.typeSymbolOf(app, opened)) == "lib.File"
			assert namesOf(nav.members(app, w.lookup("lib", "File")[0])) == "path,lines,read,owner,id,describe"
			assert namesOf(nav.membersNamed(app, w.lookup("lib", "File")[0], "read")) == "read"
			assert isTypeLike(SymbolKind.Struct) && !isTypeLike(SymbolKind.Function)
			let lines = w.lookup("lib", "File")[0].member("lines")[0]
			let linesType = presentNode(nav.declaredType(lines))
			assert isTypeNode(linesType.kind()) && presentNode(nav.elementType(linesType)).text() == "string"
			assert nav.elementType(presentNode(nav.declaredType(f))) is none
		}

		@test()
		def TestQueries() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(libSource()))
			let source = appSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			assert pathOf(presentIn(nav.definitionAt(app, source.indexOf("read(1)")))) == "lib.File.read"
			assert pathOf(presentIn(nav.definitionAt(app, source.indexOf("f File") + 2))) == "lib.File"
			assert pathOf(presentIn(nav.definitionAt(app, source.indexOf("owner().path")))) == "lib.File.owner"
			assert pathOf(presentIn(nav.definitionAt(app, source.indexOf(".path\n") + 1))) == "lib.File.path"
			assert presentIn(nav.definitionAt(app, source.indexOf("lib.open"))).kind == SymbolKind.Import
			assert pathOf(presentIn(nav.definitionAt(app, source.indexOf("lib.open") + 4))) == "lib.open"
			assert pathOf(presentIn(nav.definitionAt(app, source.indexOf("def main") + 4))) == "app.main"
			assert nav.definitionAt(app, source.indexOf("module app")).len() == 0
			let afterDot = source.indexOf("f.\n") + 2
			assert namesOf(nav.completionsAt(app, afterDot)) == "path,lines,read,owner,id,describe"
			let afterModuleDot = source.indexOf("lib.open") + 4
			assert namesOf(nav.completionsAt(app, afterModuleDot)) == "Base,File,open"
			let visible = namesOf(nav.visibleAt(app, source.indexOf("let count")))
			assert visible.startsWith("f,items,text,p,o,first,opened,")
			assert visible.contains(",main,") && visible.contains("File") && visible.contains("open") && visible.contains("lib") && visible.endsWith("println")
			assert !visible.contains("count")
			let f = presentSymbol(app.symbolAt(source.indexOf("f File")))
			let uses = nav.usages(app, f)
			assert uses.len() == 6 && uses[0].declaration && !uses[1].declaration
			// Annotations resolve through a plain `use`, then the prelude; a
			// primitive's members come from the prelude's Number.
			let testing = fixture("""
module std.testing «
	meta def test() «»
»
""")
			w.add("testing.adm", parse(testing))
			let suite = fixture("""
module s «
	use std.testing
	@test()
	@cfg(os = "linux")
	def t(n int) «
		let a = n.abs()
	»
»
""")
			let sf = w.add("suite.adm", parse(suite))
			assert pathsOf(nav.definitionAt(sf, suite.indexOf("@test") + 1)) == "std.testing.test"
			assert pathsOf(nav.definitionAt(sf, suite.indexOf("@cfg") + 1)) == "builtin.cfg"
			assert pathsOf(nav.definitionAt(sf, suite.indexOf("abs()"))) == "builtin.Number.abs"
			assert primitiveTypeName("int32") == "Number" && primitiveTypeName("string") == "string" && primitiveTypeName("File") == ""
			assert pathsOf(nav.annotationAt(sf, "test", suite.indexOf("@test") + 1)) == "std.testing.test"
			// `abs()` returns the type parameter T: unknown to this layer.
			assert pathOf(nav.typeOf(sf, initializerOf(sf, suite, "a"))) == ""
			let fileType = w.lookup("lib", "File")[0]
			assert nav.sameDeclaration(fileType, w.lookup("lib", "File")[0]) && !nav.sameDeclaration(fileType, f)
			assert isNameToken(presentNode(app.tree.find(source.indexOf("f.read"))).token())
			let across = nav.usagesAcross(fileType)
			assert across.len() == 6
			let declared = 0
			for let (_, u) in across {
				declared++ when u.declaration
			}
			assert declared == 1
			// Renaming File: one edit per usage, and the id survives the update.
			let fileId = fileType.id
			let edits = nav.renameEdits(fileType, "Document")
			assert edits.len() == 6 && edits[0].file == "lib.adm" && edits[0].text == "Document"
			w.rename(fileType, "Document")
			let libText = libSource()
			let renamedLib = libText
			for let i = edits.len() - 1; i >= 0; i-- {
				let e = edits[i]
				continue unless e.file == "lib.adm"
				renamedLib = renamedLib[:e.start] + e.text + renamedLib[e.end:]
			}
			w.update("lib.adm", parse(renamedLib))
			assert w.lookup("lib", "File").len() == 0
			assert w.lookup("lib", "Document")[0].id == fileId
			assert w.lookup("lib", "Document")[0].member("read")[0].id == w.lookup("lib", "Document")[0].member("read")[0].id
		}

		@test()
		def TestArgumentsLoopsAndGenerics() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			let lib = w.add("lib.adm", parse(genLibSource()))
			let source = genSource()
			let gen = w.add("gen.adm", parse(source))
			let nav = new Navigator(w)
			// Struct literal keys: typed, from the `let`'s type, from the parameter's type.
			assert pathsOf(nav.definitionAt(gen, source.indexOf("x: 1"))) == "lib.Point.x"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("y: 2"))) == "lib.Point.y"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("x: 3"))) == "lib.Point.x"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("y: 5"))) == "lib.Point.y"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "p"))) == "lib.Point"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "q"))) == "lib.Point"
			// Named arguments: a function's, a constructor's, a method's parameter.
			let scale = presentIn(nav.definitionAt(gen, source.indexOf("scale = 2")))
			assert scale.kind == SymbolKind.Parameter && scale.name == "scale" && scale.file == "lib.adm"
			let value = presentIn(nav.definitionAt(gen, source.indexOf("value = p")))
			assert value.kind == SymbolKind.Parameter && value.nameStart == genLibSource().indexOf("value T, label")
			assert presentIn(nav.definitionAt(gen, source.indexOf("label = \"b\""))).kind == SymbolKind.Parameter
			let text = presentIn(nav.definitionAt(gen, source.indexOf("text = \"t\"")))
			assert text.kind == SymbolKind.Parameter && text.nameStart == genLibSource().indexOf("text string")
			// A named argument never resolves to a local of the same name.
			assert nav.usages(gen, presentSymbol(gen.symbolAt(source.indexOf("let p ") + 4))).len() == 3
			// The call form of a cast is the prelude type.
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "k"))) == "builtin.Number"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("int(s)"))) == "builtin.Number"
			// Generics through member chains: T of Box<File> is File.
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "v"))) == "builtin.string"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "first"))) == "builtin.string"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "got"))) == "builtin.string"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "chained"))) == "builtin.string"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("value.path") + 6)) == "lib.File.path"
			assert namesOf(nav.completionsAt(gen, source.indexOf("value.path") + 6)) == "path"
			let typed = presentSymbol(gen.symbolAt(source.indexOf("let typed") + 4))
			assert pathOf(nav.typeSymbolOf(gen, typed)) == "lib.Box"
			assert presentIn(nav.definitionAt(gen, source.indexOf("x: 4"))).kind == SymbolKind.Field
			// Loop variables: array element and index, map key and value, string characters, a range, an iterator.
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "fp"))) == "builtin.string"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("i.abs()") + 2)) == "builtin.Number.abs"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("key.len()") + 4)) == "builtin.string.len"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "vp"))) == "builtin.string"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "cp"))) == "builtin.char"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("j.abs()") + 2)) == "builtin.Number.abs"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "lp"))) == "builtin.string"
			let f = presentSymbol(gen.symbolAt(source.indexOf("(i, f) in") + 4))
			assert pathOf(nav.typeSymbolOf(gen, f)) == "lib.File"
			assert pathOf(nav.typeRefSymbol(nav.typeRefOf(gen, initializerOf(gen, source, "typed")))) == "lib.Box"
			// Enums: a member is its enum, and every enum has the prelude Enum's members.
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "shade"))) == "lib.Color"
			assert pathOf(nav.typeOf(gen, initializerOf(gen, source, "shadeName"))) == "builtin.string"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("shade.name") + 6)) == "builtin.Enum.name"
			assert pathsOf(nav.definitionAt(gen, source.indexOf("keys()"))) == "builtin.Enum.keys"
			assert namesOf(nav.completionsAt(gen, source.indexOf("keys()"))) == "Red,Green,name,value,keys"
			// Completions at a struct literal's key: the fields left; at an
			// argument: the parameters left, then the visible names.
			assert namesOf(nav.completionsAt(gen, source.indexOf("y: 2"))) == "y"
			assert namesOf(nav.completionsAt(gen, source.indexOf("x: 3"))) == "x,y"
			assert namesOf(nav.completionsAt(gen, source.indexOf("x: 3") + 1)) == "x,y"
			assert namesOf(nav.completionsAt(gen, source.indexOf("x: 3") + 3)).startsWith("files,m,s,lines,")
			let atScale = namesOf(nav.completionsAt(gen, source.indexOf("scale = 2")))
			assert atScale.startsWith("scale,files,m,s,lines,") && !atScale.contains(",p,files")
			assert namesOf(nav.completionsAt(gen, source.indexOf("label = \"b\""))).startsWith("label,files,")
			assert namesOf(nav.completionsAt(gen, source.indexOf("value = p"))).startsWith("value,label,files,")
			assert namesOf(nav.completionsAt(gen, source.indexOf("text = \"t\""))).startsWith("text,files,")
			assert namesOf(nav.fieldCompletions(gen, source.indexOf("scale = 2"))) == ""
			assert namesOf(nav.parameterCompletions(gen, source.indexOf("y: 2"))) == ""
			// The resolvers behind definitionAt, and a bare type parameter.
			assert pathOf(nav.structKey(gen, presentNode(gen.tree.find(source.indexOf("y: 2"))))) == "lib.Point.y"
			assert presentSymbol(nav.namedArgument(gen, presentNode(gen.tree.find(source.indexOf("scale = 2"))))).name == "scale"
			assert nav.namedArgument(gen, presentNode(gen.tree.find(source.indexOf("files[0]")))) is none
			assert nav.structKey(gen, presentNode(gen.tree.find(source.indexOf("files[0]")))) is none
			let libSource = genLibSource()
			let t = presentIn(nav.definitionAt(lib, libSource.indexOf("def get() T") + 10))
			assert t.kind == SymbolKind.TypeParameter && t.nameStart == libSource.indexOf("Box<T>") + 4
		}
	}

	// presentIn is the first symbol of the list, which the test expects to
	// be there.
	internal def presentIn(found Symbol[]) Symbol {
		assert found.len() > 0
		return found[0]
	}
}
