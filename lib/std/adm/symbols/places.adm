partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode, TriviaKind)
	)

	// BodyRules is what a body may declare, as the compiler's composite
	// contexts say (`internal/parser/parser.go` `compositeContext`,
	// `partialTargets`, `internalTargets`).
	internal struct BodyRules {
		// The declaration keywords it takes besides `def`, `let`, `const`
		// and `use` (`type`, `struct`, ..., `partial`, `check`, `export`,
		// `where`).
		declarations    string[]
		methods         bool
		// Whether a method may take modifiers (an interface's are bare
		// signatures, a property's accessors take only `atomic`).
		methodModifiers bool
		fields          bool
		letConst        bool
		uses            bool
		// Whether a field may be `weak` (a property's storage may not).
		weakFields      bool
		internalMembers bool
		internalMethods bool
		infixMethods    bool
		// Whether statements may stand in it (a check suite's body), so the
		// names in scope are offered beside the keywords.
		statements      bool
		// Whether its fields take `internal`, `atomic`, `weak` (a datatype's
		// do not).
		fieldModifiers  bool        = true
		// The kind of declaration a bare name line embeds (a datatype's other
		// datatypes, an interface's interfaces, §4.6), offered at an empty
		// entry; none for the bodies whose embeds are not offered.
		embeds          ?SymbolKind = none
	}

	partial type Navigator {
		// placeCompletions is what can be written where a declaration may
		// start: at file scope the units and their modifiers, in a body the
		// declaration keywords and the modifiers that may follow those
		// written before the offset on its line (`atomic` leaves `async`,
		// `cuda`, `sql`, `meta`, `def`), nothing where a name is being
		// declared, the types after a field's name. None outside such a
		// place (a statement, an expression), where values are offered.
		internal def placeCompletions(file FileSymbols, offset int) ?Symbol[] {
			let at = namePlace(file, offset)
			let typed = typePlaceCompletions(file, at)
			return typed unless typed is none
			let body = enclosingBody(file, at)
			let head = lineHead(file, at)
			if body is none {
				// Outside every unit only units are declared.
				return [] when head is none
				return keywords(file, fileScopeWords(head))
			}
			// A component's body is its parts: `type`, `view`, `style`, each
			// once, and `use` (`parseComponentBody`).
			let holder = body.parent
			if body.kind() == SyntaxKind.Body && !(holder is none) && holder.kind() == SyntaxKind.ComponentDecl {
				return none when head is none
				return [] when head.len() > 0
				return keywords(file, componentWords(body, at))
			}
			let rules = bodyRules(body)
			if rules is none {
				return none unless body.kind() == SyntaxKind.Block
				let template = templateOf(body)
				return none when head is none
				if template == SyntaxKind.StyleDecl {
					// The top of a style body takes properties and embeds; a name
					// written there is assigned next (`width |`), nothing to offer.
					return none unless isStyleBlock(body)
					return styleCompletions(file, body, at) when head.len() == 0
					return [] when head.len() == 1
					return none
				}
				return viewCompletions(file, at) when template == SyntaxKind.ViewDecl && head.len() == 0
				return statementCompletions(file, body, at) when head.len() == 0
				// A local's name is followed by its type.
				return typeCompletions(file, at) when head.len() == 2 && (head[0].token() == TokenKind.Let || head[0].token() == TokenKind.Const) && head[1].token() == TokenKind.Ident
				return none
			}
			return none when head is none
			let words = head
			// After a field's name (`width |`, `internal atomic count |`) or a
			// `let`/`const` name: a type.
			if words.len() > 0 && words[words.len() - 1].token() == TokenKind.Ident {
				let named = words.len() >= 2 ?? (words[words.len() - 2].token(), TokenKind.EOF)
				return typeCompletions(file, at) when named == TokenKind.Let || named == TokenKind.Const || (rules.fields && allModifiers(words, words.len() - 1))
				return []
			}
			for let (_, w) in words {
				// A name is being declared after `def`, `type`, `let`, ...
				return [] when declaresName(w.token())
			}
			let offered = keywords(file, memberWords(rules, words))
			let embedded = rules.embeds
			if words.len() == 0 && !(embedded is none) {
				let seen map<string, bool>
				for let (_, s) in visibleWhere(file, at, c => c.kind == embedded || importsKind(c, embedded)) {
					addVisible(s, offered, seen)
				}
				return offered
			}
			return offered unless rules.statements && words.len() == 0
			// A check suite's body holds statements too: the values in scope
			// follow the keywords.
			let seen map<string, bool>
			for let (_, k) in offered {
				seen[k.name] = true
			}
			for let (_, s) in visibleAt(file, at) {
				addVisible(s, offered, seen)
			}
			return offered
		}

		// templateOf is `ViewDecl` for a block of a view's body (its
		// components' children blocks included), `StyleDecl` for one of a
		// style's, `Block` for a block of statements (a lambda's block inside
		// a view holds statements).
		internal def templateOf(block SyntaxNode) SyntaxKind {
			let n ?SyntaxNode = block
			for {
				let current = n
				return SyntaxKind.Block when current is none
				let k = current.kind()
				return k when k == SyntaxKind.ViewDecl || k == SyntaxKind.StyleDecl
				return SyntaxKind.Block when k == SyntaxKind.FuncDecl || k == SyntaxKind.Lambda
				n = current.parent
			}
		}

		// lineHead is the tokens between the start of the declaration the
		// offset is in and the offset, when they are all words that may
		// start one (modifiers, declaration keywords, a name): the tokens of
		// its line before it, after an annotation, a `{`, `}` or `;`. None
		// when another token stands there.
		internal def lineHead(file FileSymbols, at int) ?SyntaxNode[] {
			let reversed SyntaxNode[]
			let after = at
			let next = tokenBefore(file, at)
			for {
				let t = next
				break when t is none
				break when lineBreakAfter(file, t, after)
				let k = t.token()
				break when k == TokenKind.Semi
				if k == TokenKind.LBrace || k == TokenKind.RBrace {
					// A body's or a block's own brace starts a line's declaration or
					// statement; a literal's or a lambda's is inside an expression.
					return none unless isStatementBrace(t)
					break
				}
				// `@test() def`: the annotation ends what came before.
				break unless t.ancestor(SyntaxKind.Attribute) is none
				return none unless isHeadWord(k)
				reversed.push(t)
				after = t.start()
				next = tokenBefore(file, t.start())
			}
			let out SyntaxNode[]
			for let i = reversed.len() - 1; i >= 0; i-- {
				out.push(reversed[i])
			}
			return out
		}

		// isStatementBrace is true for a brace of a body or of a block of
		// statements that is not a lambda's.
		internal def isStatementBrace(brace SyntaxNode) bool {
			let holder = brace.parent
			return false when holder is none
			let k = holder.kind()
			return true when k == SyntaxKind.Body
			return false unless k == SyntaxKind.Block
			let owner = holder.parent
			return owner is none || owner.kind() != SyntaxKind.Lambda
		}

		// tokenBefore is the last token that ends at or before the offset,
		// none at the start of the file.
		internal def tokenBefore(file FileSymbols, offset int) ?SyntaxNode {
			let at = offset
			for at > 0 {
				let t = file.tree.find(at - 1)
				return none when t is none
				return t when t.end() <= offset && !t.isMissing() && t.end() > t.start()
				return none when t.fullStart() == 0
				at = t.fullStart()
			}
			return none
		}

		// enclosingBody is the innermost body (of a unit, a check suite, a
		// type-like declaration or a property) whose braces hold the offset,
		// none at file scope. A block of statements holds it first: that is
		// no declaration place, and the body found is the block itself.
		internal def enclosingBody(file FileSymbols, at int) ?SyntaxNode {
			let next = tokenBefore(file, at)
			for {
				let n = next
				return none when n is none
				let k = n.kind()
				return n when (k == SyntaxKind.Body || k == SyntaxKind.Block || k == SyntaxKind.RawBlock) && at > n.start() && at < n.end()
				next = n.parent
			}
		}

		// bodyRules is what the body may declare, none for a block of
		// statements, a view or a style, and the bodies whose entries are
		// names (enum and union members, a datatype's fields).
		internal def bodyRules(body SyntaxNode) ?BodyRules {
			return none unless body.kind() == SyntaxKind.Body
			let owner = body.parent
			return none when owner is none
			let nested = ["type", "struct", "enum", "union", "interface", "datatype", "service", "component", "view", "style"]
			switch owner.kind() {
				case SyntaxKind.Module, SyntaxKind.Library, SyntaxKind.Plugin:
					let decls = ["partial", "check"]
					for let (_, d) in nested {
						decls.push(d)
					}
					decls.push("export") unless owner.kind() == SyntaxKind.Module
					return BodyRules{declarations: decls, methods: true, methodModifiers: true, fields: true, letConst: true, uses: true, weakFields: true, internalMembers: true, internalMethods: true, infixMethods: true, statements: false}
				case SyntaxKind.Application:
					return BodyRules{declarations: [], methods: true, methodModifiers: true, fields: true, letConst: true, uses: true, weakFields: true, internalMembers: false, internalMethods: false, infixMethods: false, statements: false}
				case SyntaxKind.Check:
					let decls = ["partial", "check"]
					for let (_, d) in nested {
						decls.push(d)
					}
					return BodyRules{declarations: decls, methods: true, methodModifiers: true, fields: false, letConst: true, uses: true, weakFields: true, internalMembers: true, internalMethods: true, infixMethods: false, statements: true}
				case SyntaxKind.TypeDecl:
					return BodyRules{declarations: ["struct", "enum", "union", "where"], methods: true, methodModifiers: true, fields: true, letConst: true, uses: true, weakFields: true, internalMembers: true, internalMethods: true, infixMethods: true, statements: false}
				case SyntaxKind.StructDecl:
					return BodyRules{declarations: [], methods: false, methodModifiers: false, fields: true, letConst: true, uses: false, weakFields: true, internalMembers: true, internalMethods: false, infixMethods: false, statements: false}
				case SyntaxKind.ServiceDecl:
					let decls = ["partial", "where"]
					for let (_, d) in nested {
						decls.push(d)
					}
					return BodyRules{declarations: decls, methods: true, methodModifiers: true, fields: true, letConst: true, uses: true, weakFields: true, internalMembers: true, internalMethods: true, infixMethods: false, statements: false}
				case SyntaxKind.InterfaceDecl:
					return BodyRules{declarations: [], methods: true, methodModifiers: false, fields: false, letConst: false, uses: false, weakFields: false, internalMembers: false, internalMethods: false, infixMethods: false, statements: false, embeds: SymbolKind.Interface}
				case SyntaxKind.DatatypeDecl:
					// Fields and embedded datatypes only.
					return BodyRules{declarations: [], methods: false, methodModifiers: false, fields: true, letConst: false, uses: false, weakFields: false, internalMembers: false, internalMethods: false, infixMethods: false, statements: false, fieldModifiers: false, embeds: SymbolKind.Datatype}
				case SyntaxKind.Where:
					// A `where T: Bound { ... }` block declares what the type around
					// it does, except another `where`.
					let holder = owner.parent
					return none when holder is none
					let around = bodyRules(holder)
					return none when around is none
					let decls string[]
					for let (_, d) in around.declarations {
						decls.push(d) unless d == "where"
					}
					return BodyRules{declarations: decls, methods: around.methods, methodModifiers: around.methodModifiers, fields: around.fields, letConst: around.letConst, uses: around.uses, weakFields: around.weakFields, internalMembers: around.internalMembers, internalMethods: around.internalMethods, infixMethods: around.infixMethods, statements: false}
				case SyntaxKind.Property:
					// `def get()`, `atomic def set(v T)`, storage (`internal atomic value T`).
					return BodyRules{declarations: [], methods: true, methodModifiers: false, fields: true, letConst: false, uses: false, weakFields: false, internalMembers: true, internalMethods: true, infixMethods: false, statements: false}
				default:
					return none
			}
		}

		// componentWords is the parts a component's body may still take: its
		// controller `type`, its `view` and its `style` while it has none, and
		// `use`.
		internal def componentWords(body SyntaxNode, at int) string[] {
			let has map<SyntaxKind, bool>
			for let (_, c) in body.children() {
				continue when c.isToken() || c.start() == at
				has[c.kind()] = true
			}
			let out string[]
			out.push("type") unless has.hasKey(SyntaxKind.TypeDecl)
			out.push("view") unless has.hasKey(SyntaxKind.ViewDecl)
			out.push("style") unless has.hasKey(SyntaxKind.StyleDecl)
			out.push("use")
			return out
		}

		// memberWords is what may come next at the start of a member of a
		// body with the rules, after the words written: each word only after
		// the modifiers that may stand before it, so they come in the spec's
		// order (`internal atomic async def`, §5; `internal weak` for a
		// field), the declaration keywords after those that lead to them.
		// Checked against the compiler: `weak` and `atomic` exclude each
		// other, `infix` takes neither `internal` nor `async` nor `meta`, an
		// interface's methods take no modifier, an accessor only `atomic`.
		internal def memberWords(rules BodyRules, written SyntaxNode[]) string[] {
			let has string[]
			for let (_, w) in written {
				return [] when has.includes(w.text())
				has.push(w.text())
			}
			let hidden = has.includes("internal")
			let out string[]
			out.push("def") when rules.methods && writtenOnly(has, ["internal", "atomic", "async", "cuda", "sql", "meta", "infix"]) && (!hidden || rules.internalMethods) && (rules.methodModifiers || writtenOnly(has, ["internal", "atomic"]))
			if rules.letConst && writtenOnly(has, ["internal"]) && (!hidden || rules.internalMembers) {
				out.push("let")
				out.push("const")
			}
			out.push("use") when rules.uses && has.len() == 0
			for let (_, d) in rules.declarations {
				continue when has.includes(d)
				continue unless writtenOnly(has, ["internal", "partial"])
				continue when (d == "where" || d == "export") && has.len() > 0
				continue when has.includes("partial") && !isPartialTarget(d)
				continue when hidden && !(isInternalTarget(d) && rules.internalMembers)
				out.push(d)
			}
			for let (_, m) in ["internal", "atomic", "async", "cuda", "sql", "meta", "infix", "weak"] {
				continue when has.includes(m)
				out.push(m) when modifierFits(rules, m, has)
			}
			return out
		}

		// modifierFits is true when the modifier may follow the words written
		// in a body with the rules.
		internal def modifierFits(rules BodyRules, modifier string, has string[]) bool {
			switch modifier {
				case "internal":
					return writtenOnly(has, ["partial"]) && (rules.internalMembers || rules.internalMethods)
				case "atomic":
					return writtenOnly(has, ["internal"]) && (rules.fields && rules.fieldModifiers || rules.methods && rules.methodModifiers)
				case "async", "cuda", "sql", "meta":
					let before = ["internal", "atomic"]
					before.push("async") unless modifier == "async"
					return rules.methods && rules.methodModifiers && writtenOnly(has, before)
				case "infix":
					return rules.infixMethods && writtenOnly(has, ["atomic"])
				case "weak":
					return rules.fields && rules.fieldModifiers && rules.weakFields && writtenOnly(has, ["internal"])
				default:
					return false
			}
		}

		// fileScopeWords is what may come next outside every unit: `use`,
		// the units, `partial` and `internal` (in either order, §3.5), and
		// after `internal` its scope name.
		internal def fileScopeWords(written SyntaxNode[]) string[] {
			let has map<string, bool>
			for let (_, w) in written {
				return [] when w.token() != TokenKind.Ident && declaresName(w.token())
				has[w.text()] = true
			}
			let hidden = has.hasKey("internal")
			let split = has.hasKey("partial")
			return ["use", "module", "application", "library", "plugin", "check", "partial", "internal"] when written.len() == 0
			if hidden {
				return ["module"] when split
				return ["module", "partial"]
			}
			return ["module", "application", "library", "plugin", "internal"] when split
			return []
		}

		// typeCompletions is what a type may be written with at the offset:
		// the type-like declarations and type parameters in scope, the
		// modules imported (for `http.Response`), and the primitive and
		// container names.
		internal def typeCompletions(file FileSymbols, at int) Symbol[] {
			let out Symbol[]
			let seen map<string, bool>
			let types = visibleWhere(file, at, s => (isTypeLike(s.kind) || s.kind == SymbolKind.TypeParameter || importsType(s)) && !(s.isInternal && s.path.startsWith("builtin.")))
			for let (_, s) in types {
				addVisible(s, out, seen)
			}
			for let (_, name) in typeKeywords {
				addVisible(keywordSymbol(file, name), out, seen)
			}
			return out
		}

		// importsKind is true for an import of a module (for a qualified
		// name), or of a declaration of the kind by name.
		internal def importsKind(s Symbol, kind SymbolKind) bool {
			return false unless s.kind == SymbolKind.Import && !s.wildcard
			return true when s.imported.len() == 0
			for let (_, found) in workspace.lookup(s.moduleName, s.imported) {
				return true when found.kind == kind
			}
			return false
		}

		// importsType is true for an import of a module, or of a type by name.
		internal def importsType(s Symbol) bool {
			return false unless s.kind == SymbolKind.Import && !s.wildcard
			return true when s.imported.len() == 0
			for let (_, found) in workspace.lookup(s.moduleName, s.imported) {
				return true when isTypeLike(found.kind)
			}
			return false
		}

		// keywords is a completion row per word.
		internal def keywords(file FileSymbols, words string[]) Symbol[] {
			let out Symbol[]
			for let (_, w) in words {
				out.push(keywordSymbol(file, w))
			}
			return out
		}

		internal def keywordSymbol(file FileSymbols, word string) Symbol {
			let made = new Symbol(SymbolKind.Keyword, word, file.tree.root(), 0, 0)
			made.file = file.path
			return made
		}
	}

	// The type names the compiler knows without a declaration
	// (`builtinTypeNames` in internal/sema/checker.go), offered at a type.
	internal let typeKeywords = ["bool", "int", "int8", "int16", "int32", "int64", "int128", "uint", "uint8", "uint16", "uint32", "uint64", "uint128", "bigint", "float", "float16", "float32", "float64", "float128", "complex32", "complex64", "complex128", "string", "char", "byte", "duration", "regex", "none", "any", "error", "component", "service", "map", "channel", "vec2", "vec4", "vec8", "vec16", "vec32", "vec64", "vec128", "mask2", "mask4", "mask8", "mask16", "mask32", "mask64", "mask128"]

	// writtenOnly is true when every word written is one of the allowed.
	internal def writtenOnly(has string[], allowed string[]) bool {
		for let (_, w) in has {
			return false unless allowed.includes(w)
		}
		return true
	}

	// isHeadWord is true for a token that may stand before a member's name:
	// a modifier, a declaration keyword, a name.
	internal def isHeadWord(k TokenKind) bool {
		switch k {
			case TokenKind.Ident, TokenKind.Internal, TokenKind.Partial, TokenKind.Atomic, TokenKind.Async, TokenKind.Weak, TokenKind.Cuda, TokenKind.Sql, TokenKind.Meta, TokenKind.Infix:
				return true
			default:
				return declaresName(k)
		}
	}

	// declaresName is true for a keyword a declared name follows.
	internal def declaresName(k TokenKind) bool {
		switch k {
			case TokenKind.Def, TokenKind.Let, TokenKind.Const, TokenKind.Type, TokenKind.Struct, TokenKind.Enum, TokenKind.Union, TokenKind.Interface, TokenKind.Datatype, TokenKind.Service, TokenKind.Component, TokenKind.View, TokenKind.Style, TokenKind.Module, TokenKind.Application, TokenKind.Library, TokenKind.Plugin, TokenKind.Check:
				return true
			default:
				return false
		}
	}

	// allModifiers is true when the first `count` words are modifiers.
	internal def allModifiers(words SyntaxNode[], count int) bool {
		for let i = 0; i < count; i++ {
			let k = words[i].token()
			return false unless k == TokenKind.Internal || k == TokenKind.Atomic || k == TokenKind.Weak
		}
		return true
	}

	// isPartialTarget is true for a declaration `partial` may stand before
	// (`partialTargets` in internal/parser/parser.go).
	internal def isPartialTarget(word string) bool {
		return word == "type" || word == "service" || word == "component" || word == "check"
	}

	// isInternalTarget is true for a declaration `internal` may stand
	// before (`internalTargets`).
	internal def isInternalTarget(word string) bool {
		switch word {
			case "type", "struct", "enum", "union", "interface", "datatype", "service", "component", "check", "partial":
				return true
			default:
				return false
		}
	}

	// lineBreakAfter is true when a line break stands between the end of
	// the token and the offset: in its trailing trivia or the leading
	// trivia of the token after it, as far as the offset. Read from the
	// trivia, so the cost does not grow with the file.
	internal def lineBreakAfter(file FileSymbols, token SyntaxNode, upTo int) bool {
		let at = token.end()
		for let (_, piece) in token.trailingTrivia() {
			return false when at >= upTo
			return true when piece.kind == TriviaKind.Newline || piece.kind == TriviaKind.BlockComment && piece.text.contains("\n")
			at += piece.text.len()
		}
		return false when at >= upTo
		let next = file.tree.find(at)
		return false when next is none || !next.isToken()
		for let (_, piece) in next.leadingTrivia() {
			return false when at >= upTo
			return true when piece.kind == TriviaKind.Newline || piece.kind == TriviaKind.BlockComment && piece.text.contains("\n")
			at += piece.text.len()
		}
		return false
	}
}
