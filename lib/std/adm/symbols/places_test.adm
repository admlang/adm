partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	// completedAt is the names `completionsAt` offers at the `|` of the
	// source (a fixture: `«»` for braces), with the workspace's prelude and
	// library, joined by `,`; keyword rows only when `keywordsOnly`.
	internal def completedAt(text string, keywordsOnly bool) string {
		let w = new Workspace()
		w.add("builtin.adm", parse(preludeSource()))
		w.add("lib.adm", parse(libSource()))
		let marked = fixture(text).replace("module app \{\n", "module app \{\n\tuse lib::(File)\n")
		let at = marked.indexOf("|")
		let source = marked.replace("|", "")
		let file = w.add("app.adm", parse(source))
		let nav = new Navigator(w)
		let out string[]
		for let (_, s) in nav.completionsAt(file, at) {
			continue when keywordsOnly && s.kind != SymbolKind.Keyword
			out.push(s.name)
		}
		return out.join(",")
	}

	check "Places" {
		@test()
		def TestFileScope() {
			assert completedAt("|", false) == "use,module,application,library,plugin,check,partial,internal"
			assert completedAt("partial |", false) == "module,application,library,plugin,internal"
			assert completedAt("internal |", false) == "module,partial"
			assert completedAt("internal partial |", false) == "module"
			assert completedAt("partial internal |", false) == "module"
			assert completedAt("module |", false) == ""
			// After a unit: only units again, never the names it declares.
			assert completedAt("module app « def run() «» »\n|", false) == "use,module,application,library,plugin,check,partial,internal"
			assert completedAt("module app « »\nlet |", false) == ""
		}

		@test()
		def TestUnitBodies() {
			let start = "def,let,const,use,partial,check,type,struct,enum,union,interface,datatype,service,component,view,style,internal,atomic,async,cuda,sql,meta,infix,weak"
			assert completedAt("module app «\n\t|\n»", false) == start
			assert completedAt("module app «\n\tdef run() «»\n\t|\n»", false) == start
			assert completedAt("library lib2 «\n\t|\n»", false).contains("export")
			assert completedAt("application App «\n\t|\n»", false) == "def,let,const,use,atomic,async,cuda,sql,meta,weak"
			assert completedAt("module app «\n\tinternal |\n»", false) == "def,let,const,partial,check,type,struct,enum,union,interface,datatype,service,component,atomic,async,cuda,sql,meta,weak"
			assert completedAt("module app «\n\tpartial |\n»", false) == "check,type,service,component,internal"
			assert completedAt("module app «\n\t@cfg(\"linux\") |\n»", false) == start
			// A name being declared takes nothing.
			assert completedAt("module app «\n\tdef |\n»", false) == ""
			assert completedAt("module app «\n\ttype |\n»", false) == ""
		}

		@test()
		def TestModifierSequences() {
			let body = "module app «\n\ttype T «\n\t\t{0}\n\t»\n»"
			assert completedAt(body.replace("{0}", "|"), false) == "def,let,const,use,struct,enum,union,where,internal,atomic,async,cuda,sql,meta,infix,weak"
			assert completedAt(body.replace("{0}", "atomic |"), false) == "def,async,cuda,sql,meta,infix"
			assert completedAt(body.replace("{0}", "atomic async |"), false) == "def,cuda,sql,meta"
			assert completedAt(body.replace("{0}", "internal atomic async |"), false) == "def,cuda,sql,meta"
			assert completedAt(body.replace("{0}", "cuda |"), false) == "def"
			assert completedAt(body.replace("{0}", "infix |"), false) == "def"
			assert completedAt(body.replace("{0}", "weak |"), false) == ""
			assert completedAt(body.replace("{0}", "internal |"), false) == "def,let,const,struct,enum,union,atomic,async,cuda,sql,meta,weak"
			assert completedAt("module app «\n\tstruct S «\n\t\t|\n\t»\n»", false) == "let,const,internal,atomic,weak"
			// An interface: `def` and the interfaces it may embed; a datatype
			// only the datatypes it may embed, then types after a field's name.
			let ifaces = "module app «\n\tuse lib\n\tinterface Named « »\n\tdatatype Shape « »\n\tinterface I «\n\t\t|\n\t»\n»"
			assert completedAt(ifaces, false) == "def,lib,Named,I,Iterator"
			let shapes = "module app «\n\tuse lib\n\tinterface Named « »\n\tdatatype Shape « »\n\tdatatype D «\n\t\t|\n\t»\n»"
			assert completedAt(shapes, false) == "lib,Shape,D"
			assert completedAt(shapes.replace("\t\t|", "\t\twidth |"), false).contains("int")
			// A component's body takes its parts, each once.
			assert completedAt("module app «\n\tcomponent C «\n\t\t|\n\t»\n»", false) == "type,view,style,use"
			assert completedAt("module app «\n\tcomponent C «\n\t\tview «»\n\t\t|\n\t»\n»", false) == "type,style,use"
			assert completedAt("module app «\n\tcomponent C «\n\t\tview |\n\t»\n»", false) == ""
			assert completedAt("module app «\n\tservice S «\n\t\t|\n\t»\n»", false) == "def,let,const,use,partial,where,type,struct,enum,union,interface,datatype,service,component,view,style,internal,atomic,async,cuda,sql,meta,weak"
			assert completedAt("module app «\n\ttype T «\n\t\tsize int «\n\t\t\t|\n\t\t»\n\t»\n»", false) == "def,internal,atomic"
			assert completedAt("module app «\n\ttype T «\n\t\tsize int «\n\t\t\tinternal |\n\t\t»\n\t»\n»", false) == "def,atomic"
			assert completedAt("module app «\n\ttype T<V> «\n\t\twhere V: Number «\n\t\t\t|\n\t\t»\n\t»\n»", false) == "def,let,const,use,struct,enum,union,internal,atomic,async,cuda,sql,meta,infix,weak"
		}

		@test()
		def TestTypePositions() {
			let types = completedAt("module app «\n\tuse lib::(File, open)\n\tuse lib\n\ttype T «\n\t\twidth |\n\t»\n»", false)
			assert types.contains("File") && types.contains("int") && types.contains("map") && types.contains("lib")
			assert !types.contains("open") && !types.contains("println") && !types.contains("def")
			let local = completedAt("module app «\n\tdef run() «\n\t\tlet n |\n\t»\n»", false)
			assert local.contains("int") && !local.contains("println")
		}

		@test()
		def TestStatementsKeepValues() {
			// Inside a function body the values in scope are offered as before.
			let inBody = completedAt("module app «\n\tdef run(count int) «\n\t\t|\n\t»\n»", false)
			assert inBody.contains("count") && inBody.contains("println")
			let suite = completedAt("module app «\n\tcheck \"x\" «\n\t\t|\n\t»\n»", false)
			assert suite.startsWith("def,let,const,use") && suite.contains("println")
		}

		@test()
		def TestStatements() {
			let start = "let,const,if,for,forall,switch,match,select,return"
			let plain = completedAt("module app «\n\tdef run(count int) «\n\t\t|\n\t»\n»", false)
			assert plain.startsWith(start + ",defer,dispose,transaction,assert,try,await,new,begin,rollback,use") && plain.contains("count")
			let fallible = completedAt("module app «\n\tdef run() !int «\n\t\t|\n\t»\n»", true)
			assert fallible == start + ",fail,defer,dispose,transaction,assert,try,await,new,begin,rollback,expects,provides,use"
			let looped = completedAt("module app «\n\tdef run() «\n\t\tfor «\n\t\t\t|\n\t\t»\n\t»\n»", true)
			assert looped == start + ",break,continue,defer,dispose,transaction,assert,try,await,new,use"
			let generator = completedAt("module app «\n\tdef run() Iterator<int> «\n\t\t|\n\t»\n»", true)
			assert generator.contains("yield")
			let handler = completedAt("module app «\n\tdef run() «\n\t\ttransaction «» onerror «\n\t\t\t|\n\t\t»\n\t»\n»", true)
			assert handler.contains("recover") && handler.contains("fail")
			let method = completedAt("module app «\n\ttype T «\n\t\tdef run() «\n\t\t\t|\n\t\t»\n\t»\n»", true)
			assert method.contains("self")
			// After a block's `}` on its line, what may follow it comes first.
			assert completedAt("module app «\n\tdef run(ok bool) «\n\t\tif ok «» |\n\t»\n»", true).startsWith("else,let")
			assert completedAt("module app «\n\tdef run() «\n\t\tfor «» empty «» |\n\t»\n»", true).startsWith("every,break,finish,let")
			assert completedAt("module app «\n\tdef run() «\n\t\ttransaction «» |\n\t»\n»", true).startsWith("onerror,let")
			// A clause block: `case` and `default`, statements inside a clause.
			assert completedAt("module app «\n\tdef run(n int) «\n\t\tswitch n «\n\t\t\t|\n\t\t»\n\t»\n»", false) == "case,default"
			let inCase = completedAt("module app «\n\tdef run(n int) «\n\t\tswitch n «\n\t\t\tcase 1:\n\t\t\t\t|\n\t\t\tdefault:\n\t\t»\n\t»\n»", false)
			assert inCase.startsWith("case,let") && inCase.contains("n")
			// A view's block takes flow control and the components; a style's
			// block its properties: no statement or expression keywords.
			let viewed = completedAt("module app «\n\tcomponent C «\n\t\tview «\n\t\t\t|\n\t\t»\n\t»\n»", true)
			assert viewed == "let,const,if,for,switch,match"
			// A caret before an `else` already written still offers it.
			assert completedAt("module app «\n\tdef run(ok bool) «\n\t\tif ok «» |else «»\n\t»\n»", true).startsWith("else,")
			// A style's block takes its properties: no statement or expression keywords.
			assert completedAt("module app «\n\tstyle S «\n\t\t|\n\t»\n»", true) == "on,variants,let"
		}

		@test()
		def TestMoreTypePositions() {
			for let (_, text) in ["def f(path |)", "def f() |", "def f() !|", "def f(a ...|)", "def f<T: |>()"] {
				let rows = completedAt("module app «\n\t" + text + " «»\n»", false)
				assert rows.contains("int") && rows.contains("File") && !rows.contains("println")
			}
			let isType = completedAt("module app «\n\tdef f(x any) bool « return x is | »\n»", false)
			assert isType.contains("int") && !isType.contains("println")
			let args = completedAt("module app «\n\tdef f(x map<string, |>) «»\n»", false)
			assert args.contains("int")
			// A default value is a value: the parameter is typed by it.
			assert completedAt("module app «\n\tdef f(x = |) «»\n»", false).contains("println")
		}

		@test()
		def TestExpressionKeywords() {
			let value = completedAt("module app «\n\tdef f() « let x = | »\n»", false)
			assert value.contains("println") && value.contains("true") && value.contains("new") && value.contains("await")
		}

		@test()
		def TestKeywordInsertText() {
			let w = new Workspace()
			let source = "module app \{\n\t\n\}"
			let file = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let rows = nav.completionsAt(file, source.indexOf("\t") + 1)
			assert rows[0].kind == SymbolKind.Keyword && nav.insertText(file, 0, rows[0]) == "def "
			let typed = "module app \{\n\ttype T \{\n\t\twidth \n\t\}\n\}"
			let other = w.add("other.adm", parse(typed))
			let at = typed.indexOf("width ") + 6
			let found = false
			for let (_, row) in nav.completionsAt(other, at) {
				continue unless row.name == "int"
				found = true
				assert row.kind == SymbolKind.Keyword && nav.insertText(other, at, row) == "int"
			}
			assert found
		}

		@test()
		def TestUseSkipsOwnModule() {
			let w = new Workspace()
			w.add("lib.adm", parse(libSource()))
			let source = "use \nmodule lib.inner \{\n\}"
			let file = w.add("inner.adm", parse(source))
			let nav = new Navigator(w)
			let names string[]
			for let (_, s) in nav.completionsAt(file, 4) {
				names.push(s.path)
			}
			assert names.includes("lib") && !names.includes("lib.inner")
		}
	}
}
