partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind, isKeyword)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// Usage is one place a symbol is named: the token, and whether it is
	// the declaration itself.
	struct Usage {
		file        FileSymbols
		token       SyntaxNode
		declaration bool
	}

	partial type Navigator {
		// definitionAt is the declaration the token at the offset refers
		// to: a name, the member after a `.`, a type name, or a declaration's
		// own name. Empty when nothing is known.
		def definitionAt(file FileSymbols, offset int) Symbol[] {
			let own = file.symbolAt(offset)
			return [own] unless own is none
			let token = file.tree.find(offset)
			return [] when token is none
			return [] unless token.isToken() && isNameToken(token.token())
			let parent = token.parent
			return [] when parent is none
			return annotationAt(file, token.text(), token.start()) when isAnnotationName(parent, token)
			// `Button.style` on a line of a style body embeds that component's style.
			let embedded = embeddedStyleAt(file, token)
			return [embedded] unless embedded is none
			// A named argument and a struct literal's key name a parameter or
			// a field, never a name in scope.
			return oneOf(namedArgument(file, token)) when isNamedArgumentName(token)
			return oneOf(structKey(file, token)) when isStructKeyName(token) && !isMapLiteralKey(file, token)
			// The callee of a call: the overload its arguments pick.
			let call = parent.parent
			if !(call is none) && call.kind() == SyntaxKind.Call && parent.index == 0 && (parent.kind() == SyntaxKind.Name || parent.kind() == SyntaxKind.Member) {
				return oneOf(calleeSymbol(file, parent, 0)) unless parent.kind() == SyntaxKind.Member && !isLastToken(parent, token)
			}
			switch parent.kind() {
				case SyntaxKind.Member:
					return oneOf(memberTarget(file, parent, 0))
				case SyntaxKind.Name:
					return oneOf(nameSymbol(file, token))
				case SyntaxKind.NamedType:
					let found = typeSymbol(file, parent)
					return [] when found is none
					return [found]
				case SyntaxKind.QualifiedName:
					return qualifiedPart(file, parent, token)
				default:
					return workspace.resolve(file, token.text(), token.start())
			}
		}

		// isLastToken is true when the token is the node's last one (the
		// member name of `a.b`).
		internal def isLastToken(node SyntaxNode, token SyntaxNode) bool {
			let last = node.lastToken()
			return false when last is none
			return last.same(token)
		}

		// oneOf is the symbol as a list, empty for none.
		internal def oneOf(found ?Symbol) Symbol[] {
			return [] when found is none
			return [found]
		}

		// isAnnotationName is true when the token is the name of an
		// annotation (`@test()`, the last part of `@db.query()`).
		internal def isAnnotationName(parent SyntaxNode, token SyntaxNode) bool {
			return false unless parent.kind() == SyntaxKind.Name || parent.kind() == SyntaxKind.QualifiedName
			let owner = parent.parent
			return false when owner is none
			return false unless owner.kind() == SyntaxKind.Attribute
			let last = parent.lastToken()
			return false when last is none
			return last.same(token)
		}

		// annotationAt is the meta an annotation names (its overloads), the
		// first `meta def`s of the name found going out: the file's scopes
		// from the innermost (what their named imports bring in included),
		// the module's other parts, the `*` imports, the modules a plain
		// `use m` binds (an annotation is visible through such a `use`), the
		// prelude. What is no meta is passed over, as the compiler passes it
		// over: a method `json()` beside `@json("type")` on a field.
		def annotationAt(file FileSymbols, name string, offset int) Symbol[] {
			let wildcards Symbol[]
			let found = scopeMetas(file.scopeAt(offset), name, offset, wildcards)
			return found when found.len() > 0
			let unit = file.unitAt(offset)
			if !(unit is none) && unit.kind == SymbolKind.Module {
				let own = metasAmong(workspace.lookup(unit.path, name))
				return own when own.len() > 0
			}
			for let (_, w) in wildcards {
				let hit = metasAmong(workspace.lookup(w.moduleName, name))
				return hit when hit.len() > 0
			}
			let imports Symbol[]
			collectModuleImports(file.scopeAt(offset), imports)
			for let (_, imp) in imports {
				let hit = metasAmong(workspace.lookup(imp.moduleName, name))
				return hit when hit.len() > 0
			}
			return metasAmong(workspace.lookup("builtin", name))
		}

		// scopeMetas is the metas named `name` of the nearest scope that has
		// any, a named import's (`use m::(json)`) included; the `*` imports
		// passed on the way go to `wildcards`.
		internal def scopeMetas(scope ?Scope, name string, offset int, wildcards Symbol[]) Symbol[] {
			return [] when scope is none
			let out Symbol[]
			for let (_, s) in scope.lookup(name, offset) {
				if s.kind == SymbolKind.Import && s.imported.len() > 0 {
					for let (_, m) in metasAmong(workspace.lookup(s.moduleName, s.imported)) {
						out.push(m)
					}
					continue
				}
				out.push(s) when s.isMeta
			}
			return out when out.len() > 0
			for let (_, w) in scope.wildcards {
				wildcards.push(w)
			}
			return scopeMetas(scope.parent, name, offset, wildcards)
		}

		internal def metasAmong(found Symbol[]) Symbol[] {
			let out Symbol[]
			for let (_, s) in found {
				out.push(s) when s.isMeta
			}
			return out
		}

		internal def collectModuleImports(scope ?Scope, into Symbol[]) {
			return when scope is none
			for let (_, s) in scope.symbols {
				into.push(s) when s.kind == SymbolKind.Import && !s.wildcard && s.imported.len() == 0
			}
			collectModuleImports(scope.parent, into)
		}

		// qualifiedPart is what one part of `a.b.c` names: the import or
		// declaration for the first (in a type or an annotation, the nearest
		// type or import of that name, past a value that shares it:
		// `resolveType`), a member of what came before for the rest.
		internal def qualifiedPart(file FileSymbols, qualified SyntaxNode, token SyntaxNode) Symbol[] {
			let current Symbol[]
			let holder = qualified.parent
			let typed = !(holder is none) && (holder.kind() == SyntaxKind.NamedType || holder.kind() == SyntaxKind.Attribute)
			for let (_, t) in qualified.tokens() {
				continue when t.token() == TokenKind.Dot
				if current.len() == 0 {
					current = typed ?? (workspace.resolveType(file, t.text(), t.start()), workspace.resolve(file, t.text(), t.start()))
				} else {
					current = workspace.memberOf(current[0], t.text())
				}
				return current when t.same(token)
				return [] when current.len() == 0
			}
			return []
		}

		// completionsAt is what can be named at the offset: in a `use`, the
		// modules of the workspace or the declarations of the module imported
		// from (`useCompletions`); at an annotation's name (`@|`, `@te|`,
		// `@db.que|`), the metas that can annotate the declaration it stands
		// on (`isMeta` marks them), as the compiler matches them; after a
		// `.`, the members of what stands before it (a type's, a module's);
		// at a value whose type its place says (`key: |`, `name = |`, `let x
		// T = |`, `return |`, an argument), only what fits that type
		// (`typedValues`; `insertText` spells an enum member); at a struct
		// literal's key, the fields not yet given; at an argument, the
		// parameters not yet given (as named arguments) and then every name
		// visible there, innermost scope first, then the module's other
		// parts, the imports, the `*` imports' declarations and the prelude.
		def completionsAt(file FileSymbols, offset int) Symbol[] {
			let slot = useSlot(file, offset)
			return useCompletions(file, slot, offset) unless slot is none
			let attribute = annotationSlot(file, offset)
			return annotationCompletions(file, attribute, offset) unless attribute is none
			let receiver = receiverBefore(file, offset)
			return memberCompletions(file, receiver) unless receiver is none
			// Where a declaration starts, what may be declared there.
			let declaring = placeCompletions(file, offset)
			return declaring unless declaring is none
			// What is visible is looked up where the name being typed starts:
			// a `case` body without braces ends with its last token, so its end
			// is outside its scope.
			let place = namePlace(file, offset)
			// A value whose type its place says takes only what fits it.
			let holder = valueHolder(file, offset)
			if !(holder is none) {
				let expected = expectedAt(file, holder)
				return typedValues(file, place, expected) unless expected is none
				return withExpressionKeywords(file, place, visibleAt(file, place))
			}
			// A struct literal's key position takes only the fields left;
			// an argument position offers the parameters left as named
			// arguments before what fits the parameter it passes by position
			// (every visible name when that is not known).
			let fields = fieldCompletions(file, offset)
			return fields when fields.len() > 0
			let out = parameterCompletions(file, offset)
			let seen map<string, bool>
			for let (_, p) in out {
				seen[p.name] = true
			}
			let positional = positionalExpected(file, offset)
			let values Symbol[]
			if positional is none {
				values = withExpressionKeywords(file, place, visibleAt(file, place))
			} else {
				values = typedValues(file, place, positional)
			}
			for let (_, s) in values {
				addVisible(s, out, seen)
			}
			return out
		}

		// namePlace is where the name being typed at the offset starts, the
		// offset itself when none is.
		internal def namePlace(file FileSymbols, offset int) int {
			return offset when offset == 0
			let before = file.tree.find(offset - 1)
			return offset when before is none
			return before.start() when isTypedName(before) && before.end() == offset
			return offset
		}

		// receiverBefore is the expression before a `.` that ends right at
		// the offset (or before the name being typed there), none when the
		// offset is not a member position.
		internal def receiverBefore(file FileSymbols, offset int) ?SyntaxNode {
			let at = offset
			let token = file.tree.find(at)
			at = token.start() when !(token is none) && isTypedName(token) && token.start() < at
			return none when at == 0
			let before = file.tree.find(at - 1)
			return none when before is none
			return none unless before.isToken() && before.token() == TokenKind.Dot && before.end() == at
			let member = before.parent
			return none when member is none
			let kids = member.children()
			return none when kids.len() == 0
			return kids[0] when member.kind() == SyntaxKind.Member
			return none
		}

		internal def memberCompletions(file FileSymbols, receiver SyntaxNode) Symbol[] {
			let owner = symbolOf(file, receiver)
			if !(owner is none) {
				return workspace.exports(owner.moduleName) when owner.kind == SymbolKind.Import && owner.imported.len() == 0
				return members(file, owner) when isTypeLike(owner.kind)
			}
			let receiverType = typeOf(file, receiver)
			return [] when receiverType is none
			return members(file, receiverType)
		}

		// visibleAt is every name in scope at the offset, nearest first,
		// each name once.
		def visibleAt(file FileSymbols, offset int) Symbol[] {
			return visibleWhere(file, offset, s => true)
		}

		// visibleWhere is what visibleAt lists, keeping only the symbols
		// `keep` takes: a name once, the nearest symbol of it that is kept
		// (a style `Box` behind a component `Box` of the module).
		internal def visibleWhere(file FileSymbols, offset int, keep def(s Symbol) bool) Symbol[] {
			let out Symbol[]
			let seen map<string, bool>
			let wildcards Symbol[]
			collectVisible(file.scopeAt(offset), offset, out, seen, wildcards, keep)
			let unit = file.unitAt(offset)
			if !(unit is none) && unit.kind == SymbolKind.Module {
				for let (_, s) in workspace.exports(unit.path) {
					addVisible(s, out, seen) when keep(s)
				}
			}
			for let (_, w) in wildcards {
				for let (_, s) in workspace.exports(w.moduleName) {
					addVisible(s, out, seen) when !s.isInternal && keep(s)
				}
			}
			for let (_, s) in workspace.exports("builtin") {
				addVisible(s, out, seen) when !s.isInternal && keep(s)
			}
			return out
		}

		internal def collectVisible(scope ?Scope, offset int, out Symbol[], seen map<string, bool>, wildcards Symbol[], keep def(s Symbol) bool) {
			return when scope is none
			for let (_, s) in scope.symbols {
				continue when s.kind == SymbolKind.Local && s.path.len() == 0 && s.nameStart > offset
				addVisible(s, out, seen) when keep(s)
			}
			for let (_, w) in scope.wildcards {
				wildcards.push(w)
			}
			collectVisible(scope.parent, offset, out, seen, wildcards, keep)
		}

		internal def addVisible(s Symbol, out Symbol[], seen map<string, bool>) {
			return when s.name.len() == 0 || seen.hasKey(s.name)
			seen[s.name] = true
			out.push(s)
		}

		// usages is every place in the file that names the symbol, its
		// declaration first when the file holds it. Only the tokens of its
		// name are looked at (`namesOf`).
		def usages(file FileSymbols, symbol Symbol) Usage[] {
			let out Usage[]
			let offsets = namesOf(file).get(symbol.name)
			return out when offsets is none
			for let (_, at) in offsets {
				let found = definitionAt(file, at)
				continue when found.len() == 0
				continue unless sameDeclaration(throughImport(found[0]), symbol)
				let t = file.tree.find(at)
				continue when t is none
				out.push(Usage{file: file, token: t, declaration: isOwnName(file, symbol, t)})
			}
			return out
		}

		// throughImport is the declaration a `use m::(name)` brings in, for
		// the import's symbol: its name in the `use` and every name the
		// import binds stand for that declaration. The symbol itself for
		// another.
		internal def throughImport(symbol Symbol) Symbol {
			return symbol unless symbol.kind == SymbolKind.Import && !symbol.wildcard && symbol.imported.len() > 0
			let target = first(workspace.lookup(symbol.moduleName, symbol.imported))
			return symbol when target is none
			return target
		}

		internal def isOwnName(file FileSymbols, symbol Symbol, t SyntaxNode) bool {
			let own = file.symbolAt(t.start())
			return false when own is none
			return sameDeclaration(own, symbol)
		}

		// usagesAcross is every usage of the symbol in the files of the
		// workspace that may name it (`Workspace.filesNaming`: the parsed
		// files holding its name, and the registered ones that are parts of
		// its module or name the module, parsed for it; a prelude
		// declaration's usages in registered files not parsed yet are left
		// out). In path order.
		def usagesAcross(symbol Symbol) Usage[] {
			let out Usage[]
			let naming = workspace.filesNaming(symbol.name, moduleOfDeclaration(symbol))
			naming.sort((a FileSymbols, b FileSymbols) => a.path < b.path)
			for let (_, file) in naming {
				for let (_, u) in usages(file, symbol) {
					out.push(u)
				}
			}
			return out
		}

		// sameDeclaration is true for two symbols that are one declaration:
		// the same id in a workspace, else the same node.
		def sameDeclaration(a Symbol, b Symbol) bool {
			return a.id == b.id when a.id > 0 && b.id > 0
			return a.node.same(b.node) && a.nameStart == b.nameStart
		}
	}

	// isNameToken is true for a token that can name a symbol.
	def isNameToken(k TokenKind) bool {
		return k == TokenKind.Ident || k == TokenKind.Self || k == TokenKind.View || k == TokenKind.Style || k == TokenKind.New || k == TokenKind.Dispose
	}

	// isTypedName is true for a token that is the name being typed at a
	// completion point: a name token, or a keyword standing where a name goes
	// (after a `.`, in a qualified name), which the parser keeps in place.
	// `std.for` on the way to `std.formats` lexes `for` as a keyword.
	def isTypedName(token SyntaxNode) bool {
		return false unless token.isToken()
		return true when isNameToken(token.token())
		return false unless isKeyword(token.token())
		let parent = token.parent
		return false when parent is none
		return parent.kind() == SyntaxKind.QualifiedName || parent.kind() == SyntaxKind.Member || parent.kind() == SyntaxKind.Name
	}

	// Edit is one replacement in a file: the characters from `start` to
	// `end` (exclusive) become `text`.
	struct Edit {
		file  string
		start int
		end   int
		text  string
	}

	partial type Navigator {
		// renameEdits is every replacement that renames the symbol across the
		// workspace: its declaration and each usage, in file and offset order,
		// so an editor applies them from the end of each file backwards. The
		// symbol keeps its id when the workspace is updated with the new
		// trees through `Workspace.rename`.
		def renameEdits(symbol Symbol, newName string) Edit[] {
			let out Edit[]
			for let (_, u) in usagesAcross(symbol) {
				out.push(Edit{file: u.file.path, start: u.token.start(), end: u.token.end(), text: newName})
			}
			return out
		}
	}

	partial type Workspace {
		// rename re-keys the ids of a declaration and its members for a new
		// name, so that the trees updated after `Navigator.renameEdits` give
		// the same ids back. Call it before `update`.
		def rename(symbol Symbol, newName string) {
			let oldPath = symbol.path
			let dot = oldPath.lastIndexOf(".")
			let newPath = dot < 0 ?? (newName, oldPath[:dot + 1] + newName)
			let moved map<IdKey, int>
			let inside = oldPath + "."
			for let (key, id) in ids {
				let path = key.path
				continue unless path == oldPath || path.startsWith(inside)
				moved[IdKey{kind: key.kind, path: newPath + path[oldPath.len():], file: key.file, ordinal: key.ordinal}] = id
			}
			for let (key, id) in moved {
				ids[key] = id
			}
		}
	}
}
