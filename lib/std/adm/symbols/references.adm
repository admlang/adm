partial module std.adm.symbols {
	use std.adm.syntax::(Green)

	// UsageCount is how many places across the workspace name a
	// declaration, its own name left out.
	struct UsageCount {
		declaration Symbol
		count       int
	}

	// namesModule is true when the source holds the module's path as a
	// whole name, as a `use` writes it: `std.ui` in `use std.ui::(Row)`,
	// not in `std.ui.components` nor in `my_std.ui`.
	internal def namesModule(source string, moduleName string) bool {
		let from = 0
		for {
			let at = source.indexOf(moduleName, from)
			return false when at < 0
			let end = at + moduleName.len()
			let before = at == 0 || !isNameChar(source[at - 1]) && source[at - 1] != '.'
			let after = end >= source.len() || !isNameChar(source[end]) && !(source[end] == '.' && end + 1 < source.len() && isNameChar(source[end + 1]))
			return true when before && after
			from = at + 1
		}
	}

	internal def isNameChar(c char) bool {
		return c.isLetter() || c.isDigit() || c == '_'
	}

	// namesOf is the file's name index (`FileSymbols.nameIndex`), read off
	// the green tokens once.
	internal def namesOf(file FileSymbols) map<string, int[]> {
		return file.nameIndex when file.nameIndexBuilt
		collectNames(file.tree.root().green, 0, file.nameIndex)
		file.nameIndexBuilt = true
		return file.nameIndex
	}

	internal def collectNames(g Green, offset int, into map<string, int[]>) {
		if g.isToken() {
			return unless isNameToken(g.token) && g.text.len() > 0
			let start = offset + g.leadingWidth()
			if into.hasKey(g.text) {
				into[g.text].push(start)
			} else {
				into[g.text] = [start]
			}
			return
		}
		let at = offset
		for let (_, c) in g.children {
			collectNames(c, at, into)
			at += c.width
		}
	}

	partial type Workspace {
		// The registered files not parsed yet that may name a module's
		// declarations, by module, while the workspace is at
		// `namingVersion` (`filesNaming`).
		internal namingByModule map<string, string[]>
		internal namingVersion  int                            = -1
		// The parsed files each name occurs in, by path, once a query asked
		// for it (`filesNaming`); `nameFilesBuilt` says it was. A file added
		// or forgotten since is in `staleNames` with the FileSymbols it
		// replaced (none for a new file), indexed again by the next query,
		// so an edit costs nothing here.
		internal nameFiles      map<string, map<string, bool>>
		internal nameFilesBuilt bool                           = false
		internal staleNames     map<string, ?FileSymbols>

		// filesNaming is the files in which a name of a declaration of the
		// module may stand: the parsed files where the name occurs, after
		// parsing the registered files whose text holds the name and that
		// are a part of the module or name it (a `use`). Every file sees the
		// prelude (`builtin`): for its declarations no registered file is
		// parsed, so a count over them covers the parsed files only.
		def filesNaming(name string, moduleName string) FileSymbols[] {
			for let (_, path) in pendingNaming(moduleName) {
				let source = pendingSources.get(path)
				ensureFile(path) when !(source is none) && source.contains(name)
			}
			freshenNameFiles()
			let out FileSymbols[]
			let paths = nameFiles.get(name)
			return out when paths is none
			for let (path, _) in paths {
				let file = files.get(path)
				out.push(file) unless file is none
			}
			return out
		}

		// noteNames marks a file whose names changed: added (with the file
		// it replaced, none for a new one) or forgotten.
		internal def noteNames(path string, replaced ?FileSymbols) {
			return unless nameFilesBuilt
			// The first replaced file of a run of edits is the one indexed.
			return when staleNames.hasKey(path)
			staleNames[path] = replaced
		}

		// freshenNameFiles builds the name index on first use and indexes
		// again the files changed since.
		internal def freshenNameFiles() {
			if !nameFilesBuilt {
				for let (path, file) in files {
					indexNames(path, file)
				}
				nameFilesBuilt = true
				return
			}
			return when staleNames.len() == 0
			for let (path, old) in staleNames {
				if !(old is none) {
					for let (name, _) in namesOf(old) {
						let paths = nameFiles.get(name)
						continue when paths is none
						nameFiles[name] = paths.delete(path)
					}
				}
				let file = files.get(path)
				indexNames(path, file) unless file is none
			}
			let fresh map<string, ?FileSymbols>
			staleNames = fresh
		}

		internal def indexNames(path string, file FileSymbols) {
			for let (name, _) in namesOf(file) {
				if nameFiles.hasKey(name) {
					nameFiles[name][path] = true
				} else {
					let one map<string, bool>
					one[path] = true
					nameFiles[name] = one
				}
			}
		}

		// pendingNaming is the registered files not parsed yet that are a
		// part of the module or whose text names it; none for the prelude.
		// Kept per module until a file is added, parsed or removed.
		internal def pendingNaming(moduleName string) string[] {
			if namingVersion != version {
				let fresh map<string, string[]>
				namingByModule = fresh
				namingVersion = version
			}
			let known = namingByModule.get(moduleName)
			return known unless known is none
			let out string[]
			for let (path, source) in pendingSources {
				let own = pendingByModule.hasKey(moduleName) && path in pendingByModule[moduleName]
				out.push(path) when own || moduleName != "builtin" && namesModule(source, moduleName)
			}
			namingByModule[moduleName] = out
			return out
		}
	}

	partial type Navigator {
		// usageCounts is, for each declaration of the file (not a local or
		// a parameter), how many places across the workspace name it,
		// resolved as `definitionAt` resolves them, its own name left out.
		// Only the occurrences of the declarations' names are resolved, in
		// the files `Workspace.filesNaming` gives, and each file keeps what
		// they led to until it is edited or the workspace's shape changes (a
		// type-like declaration added, removed or renamed, a file added or
		// removed): an edit in a body elsewhere that changes what a member
		// chain there leads to is counted once that file is edited.
		def usageCounts(file FileSymbols) UsageCount[] {
			let out UsageCount[]
			for let (_, d) in file.declarations {
				continue unless isCounted(d)
				let home = moduleOfDeclaration(d)
				let count = 0
				for let (_, other) in workspace.filesNaming(d.name, home) {
					let found = referencesTo(other, d.name).get(d.id)
					count += found unless found is none
				}
				out.push(UsageCount{declaration: d, count: count})
			}
			return out
		}

		// isCounted is true for a declaration whose usages an editor counts:
		// one that has a stable id and is no unit, import or keyword.
		internal def isCounted(d Symbol) bool {
			return false when d.id <= 0 || d.name.len() == 0
			switch d.kind {
				case SymbolKind.Module, SymbolKind.Application, SymbolKind.Library, SymbolKind.Plugin, SymbolKind.Check, SymbolKind.Import, SymbolKind.Keyword, SymbolKind.Local, SymbolKind.Parameter:
					return false
				default:
					return true
			}
		}

		// moduleOfDeclaration is the path of the unit that declares the
		// symbol: `builtin` for the prelude's.
		internal def moduleOfDeclaration(d Symbol) string {
			let home = workspace.file(d.file)
			return "" when home is none
			let unit = home.unitAt(d.start())
			return "" when unit is none
			return unit.path
		}

		// referencesTo is what the occurrences of the name in the file lead
		// to, by declaration id and how often: each resolved once while the
		// workspace's shape stays the same.
		internal def referencesTo(file FileSymbols, name string) map<int, int> {
			if file.referencesEpoch != workspace.shapes {
				let fresh map<string, map<int, int>>
				file.references = fresh
				file.referencesEpoch = workspace.shapes
			}
			let known = file.references.get(name)
			return known unless known is none
			let counts map<int, int>
			let offsets = namesOf(file).get(name)
			if !(offsets is none) {
				for let (_, at) in offsets {
					let found = definitionAt(file, at)
					continue when found.len() == 0
					let target = throughImport(found[0])
					continue when target.id <= 0
					// A declaration's own name is not a usage of it.
					let own = file.symbolAt(at)
					continue when !(own is none) && sameDeclaration(own, target)
					counts[target.id] = counts.hasKey(target.id) ?? (counts[target.id] + 1, 1)
				}
			}
			file.references[name] = counts
			return counts
		}
	}
}
