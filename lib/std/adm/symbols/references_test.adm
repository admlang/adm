partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	check "References" {
		@test()
		def TestUsageCounts() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			let lib = w.add("lib.adm", parse(fixture("""
module lib «
	struct Point «
		x int
	»
	def area(p Point) int « return p.x »
	def unused() « »
»
""")))
			w.add("app.adm", parse(fixture("""
module app «
	use lib::(Point, area)
	def run() int «
		let p = Point«x: 1»
		let area = 2
		return area(p) + p.x
	»
»
""")))
			// Registered, not parsed: it names lib, so counting parses it.
			w.register("more.adm", fixture("""
module more «
	use lib
	def again() int « return lib.area(lib.Point«x: 2») »
»
"""))
			// Registered without naming lib: left alone.
			w.register("other.adm", fixture("""
module other «
	def area() int « return 0 »
»
"""))
			// Its text says lib, but no `use` imports it: left alone too.
			w.register("prose.adm", fixture("""
module prose «
	// Not the lib module's area: a lib of words.
	def lib() string « return "lib area" »
»
"""))
			let nav = new Navigator(w)
			let shown string[]
			for let (_, c) in nav.usageCounts(lib) {
				shown.push("{c.declaration.name}={c.count}")
			}
			// Point: the import, the literal, the parameter type, more's
			// literal; area: the import and both calls (the local `area` is
			// no function, so `area(p)` calls lib's); x: two keys and two
			// reads; unused: none.
			assert shown.join(",") == "Point=4,x=4,area=3,unused=0"
			assert w.pending() == 2
			// An edit counts again in the file edited only.
			w.update("app.adm", parse(fixture("""
module app «
	use lib::(Point, area)
	def run() int « return area(Point«x: 1») + unused() »
»
""")))
			let again string[]
			for let (_, c) in nav.usageCounts(lib) {
				again.push("{c.declaration.name}={c.count}")
			}
			assert again.join(",") == "Point=4,x=3,area=3,unused=0"
		}

		// An application's declarations are named only in its own parts:
		// counting them parses no other file, whatever its text says.
		@test()
		def TestUsageCountsOfAnApplication() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			let app = w.add("main.adm", parse(fixture("""
application main «
	type Host « »
	def new(args string[]) int « let h = new Host() return 0 »
»
""")))
			w.register("tool.adm", fixture("""
module tool «
	// main runs the Host.
	def main() « »
	type Host « »
»
"""))
			let shown string[]
			for let (_, c) in (new Navigator(w)).usageCounts(app) {
				shown.push("{c.declaration.name}={c.count}")
			}
			assert shown.join(",") == "Host=1,new=1"
			assert w.pending() == 1 && !w.files.hasKey("tool.adm")
		}
	}
}
