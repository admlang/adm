partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	internal def basePreludeSource() string {
		return fixture("""
partial module builtin «
	internal type Component<T> «
		disabled bool = false
		def redraw() «»
	»
	type Service «
		status int
	»
	enum Prefixes «
		None,
		SI,
		Data
	»
	meta def unit(symbol string, prefixes Prefixes = Prefixes.None, offset float = 0.0) «»
	meta def dimension(unit string) «»
	meta def range(low float, high float) «»
	meta def styleProperty() «»
	type map<K, V> «»
»
""")
	}

	internal def shopSource() string {
		return fixture("""
module shop «
	@dimension(unit = "m")
	type Length
	// gram is the unit of mass.
	@unit("g", prefixes = Prefixes.SI)
	const gram Length = 1
	@unit("°C", offset = 273.15)
	const celsius Length = 1
	struct Border «
		width int
	»
	type Edge = Border
	style Box «
		@styleProperty
		let width int = 0
		let height int = 0
	»
	component Scroller «
		type «
			offset int
		»
	»
	component Card «
		type «
			count int
			def room() int «
				let pane = port
				return count when disabled
				redraw()
				return pane.offset
			»
			frame int «
				def get() int « return value »
				def set(v int) « value = v »
			»
			def scale(@range(0.0, 1.0) strength float = 1.0) float « return strength »
		»
		view «
			Scroller(ref = port)
		»
	»
	service Shop «
		def start() « status = 1 »
	»
	def quantity(v int, u Length) Length « return u »
	def heat() «
		let t = quantity(20, °C)
		let w = quantity(1, kg)
		let d = quantity(2, m)
		let e = Edge«width: 2»
		let b = Box«width: 1, height: 2»
		let x = undefinedName
		let keys = map<string, int>«x: 1»
		use tools::(helper)
		helper()
	»
	struct Point «
		x int
		y int
	»
	type Shape = Border | Point
	interface Drawable «
		def draw()
	»
	def draws(d Drawable, s Shape, p Point, b Border) «
		d.anything()
		s.width
		p.nothere
		b.width.str()
		b.tags
		let q = Point«x: 1, bogus: 2»
		quantity(2, bogus = 1)
		measure(scale = 2)
		measure(unit = 3)
		Edge«width: 1»
		Scroller(ref = p, nope = 1)
	»
	def measure(scale int) int « return scale »
	def measure(unit int, scale int = 1) int « return unit »
	def metrics() Border « return Border«width: 1» »
	def metrics(glyph int) !Point « return Point«x: glyph, y: 0» »
	def picks() «
		let whole = metrics()
		let one = metrics(3)
		let named = metrics(glyph = 3)
		let byType = decode(Point«x: 1, y: 2»)
		let other = decode(Border«width: 1»)
	»
	def decode(b Border) Point « return Point«x: 1, y: 1» »
	def decode(p Point) Border « return Border«width: 1» »
	type Counting «
		count int
		def bump() «»
	»
	component Tally «
		type Counting
	»
	def tallies() «
		let t = Tally()
		let c = t.count
	»
»
module tools «
	def helper() «»
	let twice = def (n int) int « return n * 2 »
»
""")
	}

	check "Resolution" {
		@test()
		def TestNameProblems() {
			let w = new Workspace()
			w.add("builtin.adm", parse(basePreludeSource()))
			let source = shopSource()
			let f = w.add("shop.adm", parse(source))
			let nav = new Navigator(w)
			let problems = nav.nameProblems(f)
			let found string[]
			for let (_, p) in problems {
				found.push(p.kind.value + " " + p.name + (p.owner is none ?? ("", " on " + presentSymbol(p.owner).path)))
			}
			// An unknown member on a known closed type, an unknown struct key, an
			// unknown named argument (on a function, on a component); never on an
			// interface receiver, a union alias, a value every value has, a
			// reserved component argument, or a name another overload declares.
			assert found.join("|") == "unresolved name undefinedName|unknown member nothere on shop.Point|unknown field bogus on shop.Point|unknown parameter bogus on shop.quantity|unknown parameter nope on shop.Scroller"
			assert problems[1].token.start() == source.indexOf("nothere")
		}

		@test()
		def TestDeclarationsBeyondTypes() {
			let w = new Workspace()
			w.add("builtin.adm", parse(basePreludeSource()))
			let source = shopSource()
			let f = w.add("shop.adm", parse(source))
			let nav = new Navigator(w)
			// An annotated parameter is declared; a property's implicit `value` too.
			assert presentIn(w.resolve(f, "strength", source.indexOf("return strength"))).kind == SymbolKind.Parameter
			let storage = presentIn(nav.definitionAt(f, source.indexOf("return value") + 7))
			assert storage.kind == SymbolKind.Local && storage.name == "value" && storage.node.kind().value == "Property"
			assert pathsOf(nav.definitionAt(f, source.indexOf("value = v"))) == ""
			assert presentIn(nav.definitionAt(f, source.indexOf("value = v"))).name == "value"
			// A view ref declares a member holding the component the call places.
			let port = presentIn(nav.definitionAt(f, source.indexOf("= port") + 2))
			assert port.path == "shop.Card.port" && port.kind == SymbolKind.Field
			assert pathOf(nav.typeSymbolOf(f, port)) == "shop.Scroller"
			assert pathsOf(nav.definitionAt(f, source.indexOf("pane.offset") + 5)) == "shop.Scroller.offset"
			// Component and service bodies see their prelude base's members.
			assert pathsOf(nav.definitionAt(f, source.indexOf("when disabled") + 5)) == "builtin.Component.disabled"
			assert pathsOf(nav.definitionAt(f, source.indexOf("redraw()"))) == "builtin.Component.redraw"
			assert pathsOf(nav.definitionAt(f, source.indexOf("status = 1"))) == "builtin.Service.status"
			assert namesOf(nav.members(f, w.lookup("shop", "Card")[0])).contains("disabled")
			assert builtinBaseName(SymbolKind.Component) == "Component" && builtinBaseName(SymbolKind.Struct) == ""
			// Units: by symbol, with an SI prefix, from a dimension; the hover is the constant's.
			let celsius = presentIn(nav.definitionAt(f, source.indexOf("°C)")))
			assert celsius.kind == SymbolKind.Unit && celsius.name == "°C" && celsius.path == "shop.°C"
			let gram = presentIn(nav.definitionAt(f, source.indexOf("kg)")))
			assert gram.kind == SymbolKind.Unit && gram.name == "g" && gram.unitPrefixes == "SI" && gram.doc == "gram is the unit of mass."
			assert presentIn(nav.definitionAt(f, source.indexOf("m)"))).name == "m"
			assert celsius.unitPrefixes == "" && w.unitNamed("kcelsius").len() == 0 && w.unitNamed("Mg").len() == 1
			assert nav.signature(gram) == "gram Length"
			assert pathOf(nav.typeOf(f, initializerOf(f, source, "t"))) == "shop.Length"
			// A type alias leads to its target's fields; a style's lets are its members.
			assert pathsOf(nav.definitionAt(f, source.indexOf("width: 2"))) == "shop.Border.width"
			assert pathsOf(nav.definitionAt(f, source.indexOf("height: 2"))) == "shop.Box.height"
			assert namesOf(nav.members(f, w.lookup("shop", "Box")[0])) == "width,height"
			assert pathOf(nav.typeOf(f, initializerOf(f, source, "e"))) == "shop.Border"
			// Among overloads, the one whose parameters take the call's arguments.
			assert pathOf(nav.typeOf(f, initializerOf(f, source, "whole"))) == "shop.Border"
			assert pathOf(nav.typeOf(f, initializerOf(f, source, "one"))) == "shop.Point"
			assert pathOf(nav.typeOf(f, initializerOf(f, source, "named"))) == "shop.Point"
			assert presentIn(nav.definitionAt(f, source.indexOf("metrics(3)"))).nameStart == source.indexOf("def metrics(glyph") + 4
			assert presentIn(nav.definitionAt(f, source.indexOf("metrics()"))).nameStart == source.indexOf("def metrics()") + 4
			// Among overloads of one arity, the one whose parameter type is the argument's.
			assert pathOf(nav.typeOf(f, initializerOf(f, source, "byType"))) == "shop.Border"
			assert pathOf(nav.typeOf(f, initializerOf(f, source, "other"))) == "shop.Point"
			// A component declared with a named controller has that type's members.
			assert pathsOf(nav.definitionAt(f, source.indexOf("t.count") + 2)) == "shop.Counting.count"
			assert namesOf(nav.members(f, w.lookup("shop", "Tally")[0])).startsWith("count,bump,")
			// A `use` inside a body binds its names there.
			assert pathsOf(nav.definitionAt(f, source.indexOf("helper()"))) == "tools.helper"
			// A map literal's keys are expressions: `x` is the local, not a field.
			let mapKey = presentNode(f.tree.find(source.indexOf("x: 1")))
			assert nav.isMapLiteralKey(f, mapKey) && !nav.isMapLiteralKey(f, presentNode(f.tree.find(source.indexOf("width: 2"))))
			assert presentIn(nav.definitionAt(f, source.indexOf("x: 1"))).kind == SymbolKind.Local
			// A function literal at unit level declares its parameters.
			assert presentIn(nav.definitionAt(f, source.indexOf("n * 2"))).kind == SymbolKind.Parameter
			// Every plain name of the file resolves but the undefined one.
			let unresolved = nav.unresolvedNames(f)
			assert unresolved.len() == 1 && unresolved[0].name == "undefinedName"
			assert unresolved[0].token.start() == source.indexOf("undefinedName")
		}
	}
}
