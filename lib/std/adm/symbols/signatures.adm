partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// ParameterInfo is one parameter of a signature: its name, its type and
	// default value as written ("" for none), whether it takes the rest of
	// the arguments, and its `@param` text from the function's doc comment
	// (for a component input, its own doc comment). `typeSymbol` is the
	// declaration of its type (through `?T`, and the element type of a
	// variadic one): an enum's members or a struct's fields are what it
	// takes. None for a primitive, or a type this layer cannot tell.
	struct ParameterInfo {
		name        string
		typeText    string  = ""
		defaultText string  = ""
		variadic    bool    = false
		doc         string  = ""
		typeSymbol  ?Symbol = none
	}

	// SignatureInfo is one function a call may call, with its parameters in
	// order (`a, b int` gives two) and `active`, the parameter the argument
	// at the offset passes to (-1 for none: past the last parameter, or a
	// name the function has no parameter for). For a construction `fn` is
	// a `new` of the type, or the type itself when it is made from its
	// fields; for a component call, the component.
	struct SignatureInfo {
		fn         Symbol
		parameters ParameterInfo[]
		active     int             = -1
	}

	// SignatureHelp is what an editor shows while the arguments of a call
	// are written: the call (a Call, a New or a ComponentCall), the offset
	// of its `(`, every function its callee names (the overloads, in
	// declaration order), and `chosen`, the one the arguments written so
	// far call (-1 when none takes them).
	struct SignatureHelp {
		call       SyntaxNode
		open       int
		signatures SignatureInfo[]
		chosen     int             = -1
	}

	// The call whose parentheses hold an offset, its argument list and the
	// offset of its `(`.
	internal struct CallAround {
		call SyntaxNode
		args SyntaxNode
		open int
	}

	partial type Navigator {
		// signatureHelp is the signatures of the innermost call whose
		// parentheses hold the offset (a missing `)` counts as the call's
		// end), looking through no lambda or block between the offset and
		// the call. None outside a call's parentheses, or when the callee
		// names no function, constructor or component this layer knows.
		//
		// ```
		// // `f(1, |)` with `def f(a int, b string = "x")`:
		// let help = nav.signatureHelp(file, offset)
		// help.signatures[0].parameters[1].name   // "b"
		// help.signatures[0].active                // 1
		// ```
		def signatureHelp(file FileSymbols, offset int) ?SignatureHelp {
			freshQuery()
			let found = callAround(file, offset)
			return none when found is none
			let call = found.call
			let signatures SignatureInfo[]
			let chosen = -1
			switch call.kind() {
				case SyntaxKind.Call:
					let callee = call.child(0)
					return none when callee is none
					let fns Symbol[]
					let comp ?Symbol = none
					for let (_, s) in calleeOverloads(file, callee) {
						fns.push(s) when s.kind == SymbolKind.Function || s.kind == SymbolKind.Method
						comp = s when s.kind == SymbolKind.Component && comp is none
					}
					if fns.len() == 0 {
						// `Label("hi")` in a view calls a component.
						return none when comp is none
						signatures.push(inputSignature(file, comp))
						chosen = 0
					} else {
						let target = callTarget(file, call, 0)
						for let (i, fn) in fns {
							signatures.push(functionSignature(file, fn))
							chosen = i when !(target is none) && target.fn.node.same(fn.node)
						}
					}
				case SyntaxKind.New:
					let made = typeOfDepth(file, call, 1)
					return none when made is none
					let ctors = membersNamed(file, made, "new")
					if ctors.len() == 0 {
						signatures.push(fieldSignature(file, made))
						chosen = 0
					} else {
						let picked = chooseOverload(file, call, ctors, none, 0)
						for let (i, ctor) in ctors {
							signatures.push(functionSignature(file, ctor))
							chosen = i when !(picked is none) && picked.node.same(ctor.node)
						}
					}
				case SyntaxKind.ComponentCall:
					let callee = call.child(0)
					return none when callee is none
					let comp = symbolOfDepth(file, callee, 0)
					return none when comp is none || comp.kind != SymbolKind.Component
					signatures.push(inputSignature(file, comp))
					chosen = 0
				default:
					return none
			}
			let (position, named) = argumentAt(found.args, offset)
			for let (_, sig) in signatures {
				sig.active = activeParameter(sig, position, named)
			}
			return SignatureHelp{call: call, open: found.open, signatures: signatures, chosen: chosen}
		}

		// callAround is the innermost call whose parentheses hold the offset,
		// with its argument list and the offset of its `(`; none when a
		// lambda, a block or a body lies between the offset and the call.
		internal def callAround(file FileSymbols, offset int) ?CallAround {
			let next = tokenBefore(file, offset)
			for {
				let n = next
				return none when n is none
				switch n.kind() {
					case SyntaxKind.Lambda, SyntaxKind.Block, SyntaxKind.Body, SyntaxKind.RawBlock:
						return none
					case SyntaxKind.Args:
						let owner = n.parent
						if !(owner is none) && (owner.kind() := SyntaxKind.Call || SyntaxKind.New || SyntaxKind.ComponentCall) {
							let (inside, open) = holds(n, offset)
							return CallAround{call: owner, args: n, open: open} when inside
						}
					default:
				}
				next = n.parent
			}
		}

		// holds is whether the offset lies between an argument list's `(`
		// and its `)` (or the list's end when `)` is missing), and the offset
		// of the `(`.
		internal def holds(args SyntaxNode, offset int) (bool, int) {
			let open = args.child(0)
			return (false, 0) unless !(open is none) && open.isToken() && open.token() == TokenKind.LParen && !open.isMissing()
			return (false, 0) when offset < open.end()
			let close = args.lastToken()
			if !(close is none) && close.token() == TokenKind.RParen && !close.isMissing() && !close.same(open) {
				return (false, 0) when offset > close.start()
			}
			return (true, open.start())
		}

		// argumentAt is where the offset stands in an argument list: the
		// number of positional arguments before its argument, and the name
		// its argument gives (`name = v`, `name: v`), "" for a positional one.
		internal def argumentAt(args SyntaxNode, offset int) (int, string) {
			let position = 0
			for let (_, a) in args.children() {
				continue unless a.kind() == SyntaxKind.Arg
				let name = argumentName(a)
				return (position, name) when offset >= a.start() && offset <= a.end()
				break when a.start() > offset
				position++ when name == ""
			}
			return (position, "")
		}

		// argumentName is the name a named argument gives (`name = v`,
		// `name: v`), "" for a positional one.
		internal def argumentName(arg SyntaxNode) string {
			let head = arg.child(0)
			return "" when head is none
			return isNamedArgumentName(head) ?? (head.text(), "")
		}

		// activeParameter is the index of the parameter an argument passes
		// to: the one `named` names, else the parameter at `position` (the
		// variadic one taking the rest). A component call's positional
		// argument is its value input, listed first. -1 for none.
		internal def activeParameter(sig SignatureInfo, position int, named string) int {
			let params = sig.parameters
			if named != "" {
				for let (i, p) in params {
					return i when p.name == named
				}
				return -1
			}
			if sig.fn.kind == SymbolKind.Component {
				return 0 when position == 0 && params.len() > 0 && sig.active == 0
				return -1
			}
			return position when position < params.len()
			return params.len() - 1 when params.len() > 0 && params[params.len() - 1].variadic
			return -1
		}

		// functionSignature is a function's or method's parameters as its
		// declaration writes them, each with its `@param` text.
		internal def functionSignature(file FileSymbols, fn Symbol) SignatureInfo {
			let home = homeOf(fn, file)
			let docs = paramDocs(fn.doc)
			let out ParameterInfo[]
			let params = childOfKind(fn.node, SyntaxKind.Params)
			if !(params is none) {
				for let (_, p) in params.children() {
					continue unless p.kind() == SyntaxKind.Param
					let (typeText, defaultText, variadic) = parameterParts(p)
					for let (_, c) in p.children() {
						break unless c.isToken()
						let k = c.token()
						continue when k == TokenKind.Comma
						// A parameter may be named `style` or `view` (the lexer's keywords).
						break unless k == TokenKind.Ident || k == TokenKind.Style || k == TokenKind.View
						let declared = typeDeclaration(home, home.symbolAt(c.start()), variadic)
						out.push(ParameterInfo{name: c.text(), typeText: typeText, defaultText: defaultText, variadic: variadic, doc: docs.hasKey(c.text()) ?? (docs[c.text()], ""), typeSymbol: declared})
					}
				}
			}
			return SignatureInfo{fn: fn, parameters: out}
		}

		// parameterParts is a parameter's type and default value as written,
		// and whether it is variadic (`...T`).
		internal def parameterParts(p SyntaxNode) (string, string, bool) {
			let typeText = ""
			let defaultText = ""
			let variadic = false
			let afterAssign = false
			for let (_, c) in p.children() {
				if c.isToken() {
					variadic = true when c.token() == TokenKind.Ellipsis
					afterAssign = true when c.token() == TokenKind.Assign
					continue
				}
				if afterAssign {
					defaultText = c.text() when defaultText == ""
				} else if isTypeNode(c.kind()) {
					typeText = c.text()
				}
			}
			return (typeText, defaultText, variadic)
		}

		// fieldSignature is what a type made from its fields takes: each
		// field, with its type and initial value as written.
		internal def fieldSignature(file FileSymbols, made Symbol) SignatureInfo {
			let home = homeOf(made, file)
			let out ParameterInfo[]
			for let (_, m) in made.members {
				continue unless m.kind == SymbolKind.Field
				let (typeText, defaultText) = fieldParts(m.node)
				out.push(ParameterInfo{name: m.name, typeText: typeText, defaultText: defaultText, doc: parseDoc(m.doc, false).description, typeSymbol: typeDeclaration(home, m, false)})
			}
			return SignatureInfo{fn: made, parameters: out}
		}

		// inputSignature is what a component call takes: the component's
		// `@input` fields in declaration order, the value input
		// (`@input(value = true)`) first, which is the one a positional
		// argument gives. `active` starts at 0 when it has one.
		internal def inputSignature(file FileSymbols, comp Symbol) SignatureInfo {
			let home = homeOf(comp, file)
			let out ParameterInfo[]
			let hasValue = false
			for let (_, m) in comp.members {
				continue unless m.kind == SymbolKind.Field && hasAnnotation(m, "input")
				let (typeText, defaultText) = fieldParts(m.node)
				let info = ParameterInfo{name: m.name, typeText: typeText, defaultText: defaultText, doc: parseDoc(m.doc, false).description, typeSymbol: typeDeclaration(home, m, false)}
				if !hasValue && isValueInput(m) {
					out.unshift(info)
					hasValue = true
				} else {
					out.push(info)
				}
			}
			return SignatureInfo{fn: comp, parameters: out, active: hasValue ?? (0, -1)}
		}

		// isValueInput is true for an input annotated `@input(value = true)`.
		internal def isValueInput(m Symbol) bool {
			for let (_, a) in m.annotations {
				let args = childOfKind(a, SyntaxKind.Args)
				continue when args is none
				for let (_, arg) in args.children() {
					continue unless arg.kind() == SyntaxKind.Arg
					continue unless argumentName(arg) == "value"
					let kids = arg.children()
					return true when kids[kids.len() - 1].text() == "true"
				}
			}
			return false
		}

		// typeDeclaration is the declaration of the type of a parameter's or
		// field's value, through `?T` (and the element of a variadic
		// parameter's array); none for a primitive or an unknown type.
		internal def typeDeclaration(home FileSymbols, declared ?Symbol, variadic bool) ?Symbol {
			return none when declared is none
			let t = valueTypeOf(home, declared, 0)
			t = elementOf(t) when variadic
			t = plain(unwrapped(t, TypeKind.Optional))
			return none unless t.kind == TypeKind.Named
			return declarationOf(t)
		}

		// fieldParts is a field's type and initial value as written.
		internal def fieldParts(field SyntaxNode) (string, string) {
			let typeText = ""
			let defaultText = ""
			let afterAssign = false
			for let (_, c) in field.children() {
				if c.isToken() {
					afterAssign = true when isAssignmentToken(c.token())
					continue
				}
				if afterAssign {
					defaultText = c.text() when defaultText == ""
				} else if isTypeNode(c.kind()) {
					typeText = c.text()
				}
			}
			return (typeText, defaultText)
		}
	}

	// paramDocs is the `@param name text` lines of a doc comment by name.
	internal def paramDocs(doc string) map<string, string> {
		let out map<string, string>
		return out when doc == ""
		for let (_, tag) in parseDoc(doc, false).tags {
			continue unless tag.name == "param"
			let text = tag.text
			let space = text.indexOf(" ")
			if space < 0 {
				out[text] = ""
			} else {
				out[text[0:space]] = text[space + 1:].trim()
			}
		}
		return out
	}
}
