partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	check "Signature help" {
		internal def signaturesSource() string {
			return fixture("""
module sigs «
	// Draws a label.
	//
	// @param text What it says.
	// @param scale How large it draws.
	def draw(text string, scale float = 1.0) « »
	def draw(count int) « »
	def sum(first int, rest ...int) int « return first »
	def apply(f def(int) int, x int) int « return f(x) »
	type Box «
		width int
		def new(width int, label string = "box") « self.width = width »
	»
	struct Point «
		x int = 0
		y int = 0
	»
	enum Mode «
		Light,
		Dark
	»
	def paint(mode ?Mode, at Point, points ...Point) « »
	component Label «
		type «
			@input
			size int = 3
			// The text shown.
			@input(value = true)
			text string = ""
		»
		view « »
	»
	def run() «
		draw("hi", 2.0)
		draw(scale = 3.0, text = "x")
		sum(1, 2, 3, 4)
		draw(sum(1, 2), )
		apply((v) => « return v + 1 », 3)
		let b = new Box(4, label = "b")
		let p = new Point(x = 1)
		paint(Mode.Light, p)
	»
	view Main «
		Label("hi", size = 4)
	»
»
""")
		}

		// The help at the first `|` of `marked`, found in the source.
		def helpAt(source string, marked string) ?SignatureHelp {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			let file = w.add("sigs.adm", parse(source))
			let nav = new Navigator(w)
			let bar = marked.indexOf("|")
			let at = source.indexOf(marked.replace("|", ""))
			assert at >= 0
			return nav.signatureHelp(file, at + bar)
		}

		def names(sig SignatureInfo) string {
			let out string[]
			for let (_, p) in sig.parameters {
				out.push(p.name)
			}
			return out.join(",")
		}

		@test()
		def TestPositionalAndOverloads() {
			let source = signaturesSource()
			let h = helpAt(source, "draw(\"hi\", |2.0)")
			assert !(h is none)
			return when h is none
			// Both overloads, in declaration order; the arguments choose the first.
			assert h.signatures.len() == 2 && h.chosen == 0
			assert names(h.signatures[0]) == "text,scale" && h.signatures[0].active == 1
			assert names(h.signatures[1]) == "count" && h.signatures[1].active == -1
			let scale = h.signatures[0].parameters[1]
			assert scale.typeText == "float" && scale.defaultText == "1.0" && scale.doc == "How large it draws."
			assert h.signatures[0].parameters[0].doc == "What it says."
			assert source[h.open] == '('
			// Right after `(`: the first parameter.
			let start = helpAt(source, "draw(|\"hi\", 2.0)")
			assert !(start is none)
			return when start is none
			assert start.signatures[0].active == 0
		}

		@test()
		def TestNamedAndVariadic() {
			let source = signaturesSource()
			// A named argument passes to the parameter it names, whatever its place.
			let named = helpAt(source, "draw(scale = 3.0, text = |\"x\")")
			assert !(named is none)
			return when named is none
			assert named.signatures[0].active == 0
			// The variadic parameter takes the rest.
			let rest = helpAt(source, "sum(1, 2, 3, |4)")
			assert !(rest is none)
			return when rest is none
			assert rest.signatures[0].active == 1 && rest.signatures[0].parameters[1].variadic
		}

		@test()
		def TestInnermostCallAndLambdas() {
			let source = signaturesSource()
			// Inside the inner call's parentheses: the inner call.
			let inner = helpAt(source, "draw(sum(1, |2), )")
			assert !(inner is none)
			return when inner is none
			assert inner.signatures[0].fn.name == "sum"
			// Past the inner call's `)`: the outer one, at its second argument.
			let outer = helpAt(source, "draw(sum(1, 2), |)")
			assert !(outer is none)
			return when outer is none
			assert outer.signatures[0].fn.name == "draw" && outer.signatures[0].active == 1
			// A lambda's body is not the call's argument list.
			assert helpAt(source, "return |v + 1") is none
			// Outside every call.
			assert helpAt(source, "let |b = new Box") is none
		}

		// A parameter's type declaration: an enum (through `?`), a struct, a
		// variadic one's element; none for a primitive.
		@test()
		def TestParameterTypeDeclarations() {
			let source = signaturesSource()
			let h = helpAt(source, "paint(|Mode.Light, p)")
			assert !(h is none)
			return when h is none
			let params = h.signatures[0].parameters
			let mode = params[0].typeSymbol
			assert !(mode is none) && mode.name == "Mode" && mode.kind == SymbolKind.Enum && mode.members.len() == 2
			let at = params[1].typeSymbol
			assert !(at is none) && at.name == "Point" && at.kind == SymbolKind.Struct
			let each = params[2].typeSymbol
			assert !(each is none) && each.name == "Point"
			let text = helpAt(source, "draw(\"hi\", |2.0)")
			assert !(text is none)
			return when text is none
			assert text.signatures[0].parameters[0].typeSymbol is none
		}

		@test()
		def TestConstructionAndComponents() {
			let source = signaturesSource()
			let made = helpAt(source, "new Box(4, label = |\"b\")")
			assert !(made is none)
			return when made is none
			assert made.signatures.len() == 1 && names(made.signatures[0]) == "width,label" && made.signatures[0].active == 1
			// A type with no `new` is made from its fields.
			let fields = helpAt(source, "new Point(x = |1)")
			assert !(fields is none)
			return when fields is none
			assert names(fields.signatures[0]) == "x,y" && fields.signatures[0].active == 0
			// A component call takes its inputs, the value input first.
			let comp = helpAt(source, "Label(|\"hi\", size = 4)")
			assert !(comp is none)
			return when comp is none
			let inputs = comp.signatures[0]
			assert names(inputs) == "text,size" && inputs.active == 0 && inputs.parameters[0].doc == "The text shown."
			let sized = helpAt(source, "Label(\"hi\", size = |4)")
			assert !(sized is none)
			return when sized is none
			assert sized.signatures[0].active == 1
		}
	}
}
