partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// typePlaceCompletions is the types, where the token before the
		// offset makes a type the next thing written: a parameter's name
		// (`def f(path |`), a `)` closing parameters or a `?`, `!`, `async`
		// before a result (`def f() |`), a type argument's `<` or `,`, a
		// bound's `:`, `...`, `is`, `as`. None elsewhere.
		internal def typePlaceCompletions(file FileSymbols, at int) ?Symbol[] {
			let before = tokenBefore(file, at)
			return none when before is none
			let parent = before.parent
			return none when parent is none
			switch before.token() {
				case TokenKind.Ident:
					return typeCompletions(file, at) when parent.kind() == SyntaxKind.Param && !paramTyped(parent, before)
				case TokenKind.RParen:
					let owner = parent.parent
					return none when owner is none
					return none unless parent.kind() == SyntaxKind.Params
					return none when lineBreakAfter(file, before, at)
					switch owner.kind() {
						case SyntaxKind.FuncDecl, SyntaxKind.FuncType, SyntaxKind.Lambda:
							return typeCompletions(file, at)
						default:
					}
				case TokenKind.Question, TokenKind.Not, TokenKind.Async:
					return typeCompletions(file, at) when parent.kind() == SyntaxKind.ModifiedType
				case TokenKind.Lt, TokenKind.Comma:
					return typeCompletions(file, at) when parent.kind() == SyntaxKind.TypeArgs
				case TokenKind.Colon:
					return typeCompletions(file, at) when parent.kind() == SyntaxKind.TypeParam
				case TokenKind.Ellipsis:
					return typeCompletions(file, at) when parent.kind() == SyntaxKind.Param
				case TokenKind.Is, TokenKind.As:
					return typeCompletions(file, at)
				default:
			}
			return none
		}

		// paramTyped is true when the parameter already has its type, or a
		// default value, after the name.
		internal def paramTyped(param SyntaxNode, name SyntaxNode) bool {
			for let (_, c) in param.children() {
				continue unless c.start() > name.start()
				return true when isTypeNode(c.kind())
				return true when c.isToken() && c.token() == TokenKind.Assign
			}
			return false
		}

		// statementCompletions is what can start a statement in a block of
		// statements: the keywords a statement begins with that fit where it
		// stands, then the values in scope. A `}` before the offset on its
		// line offers what may follow the block it closes (`else`, a loop's
		// `every`, `break`, `empty`, `finish`, `onerror`) first; a clause
		// block `case` and `default`.
		internal def statementCompletions(file FileSymbols, block SyntaxNode, at int) Symbol[] {
			let words string[]
			for let (_, w) in followingWords(file, at) {
				words.push(w)
			}
			let owner = block.parent
			let clauses = !(owner is none) && (owner.kind() == SyntaxKind.Switch || owner.kind() == SyntaxKind.Match || owner.kind() == SyntaxKind.Select)
			if clauses {
				words.push("case")
				words.push("default") unless writtenElsewhere(block, SyntaxKind.Default, at)
			}
			// Between a clause block's braces and before its first clause only a
			// clause starts; in a clause, statements follow too.
			if !clauses || inClause(file, at) {
				for let (_, w) in statementWords(file, block, at) {
					words.push(w)
				}
			}
			let out = keywords(file, words)
			return out when clauses && !inClause(file, at)
			let seen map<string, bool>
			for let (_, k) in out {
				seen[k.name] = true
			}
			for let (_, s) in visibleAt(file, at) {
				addVisible(s, out, seen)
			}
			return out
		}

		// statementWords is the keywords a statement may begin with in the
		// block (§6): always the declarations, conditionals, loops, `return`,
		// `defer`, `dispose`, `transaction`, `assert` and what an expression
		// starts with; `fail` in a function that can fail, `break` and
		// `continue` in a loop, `yield` in a generator outside `forall` and
		// `transaction`, `recover` in an `onerror` handler, `begin`,
		// `rollback`, `expects` and `provides` in a function's own body.
		internal def statementWords(file FileSymbols, block SyntaxNode, at int) string[] {
			let out = ["let", "const", "if", "for", "forall", "switch", "match", "select", "return"]
			let fn ?SyntaxNode = none
			let inLoop = false
			let inHandler = false
			let yieldBlocked = false
			let n ?SyntaxNode = block
			for {
				let current = n
				break when current is none
				let k = current.kind()
				if k == SyntaxKind.FuncDecl || k == SyntaxKind.Lambda {
					fn = current
					break
				}
				inLoop = true when k == SyntaxKind.For
				inHandler = true when k == SyntaxKind.OnError
				yieldBlocked = true when k == SyntaxKind.Transaction || k == SyntaxKind.For && isForall(current)
				n = current.parent
			}
			let result ?SyntaxNode = none
			result = returnTypeOf(fn) unless (fn is none)
			// A declared result says whether the function can fail; a lambda
			// without one may.
			let lambda = !(fn is none) && fn.kind() == SyntaxKind.Lambda
			let fallible = (result is none && lambda) || (!(result is none) && isFallibleType(result))
			out.push("fail") when fallible || inHandler
			if inLoop {
				out.push("break")
				out.push("continue")
			}
			out.push("yield") when !yieldBlocked && !(result is none) && isIteratorType(result)
			out.push("recover") when inHandler
			for let (_, w) in ["defer", "dispose", "transaction", "assert", "try", "await", "new"] {
				out.push(w)
			}
			out.push("self") unless workspace.enclosingType(file, at) is none
			// Transaction and contract blocks stand in the function's own body.
			let up = block.parent
			if !(fn is none) && !(up is none) && up.same(fn) {
				out.push("begin")
				out.push("rollback")
				if !(result is none) && isFallibleType(result) {
					out.push("expects")
					out.push("provides")
				}
			}
			out.push("use")
			return out
		}

		// followingWords is what may follow the block a `}` right before the
		// offset on its line closes: `else` after an `if`'s block that has
		// none, a loop's suffix blocks not written yet, `onerror` after a
		// `transaction` block.
		internal def followingWords(file FileSymbols, at int) string[] {
			let out string[]
			let before = tokenBefore(file, at)
			return out when before is none
			return out unless before.token() == TokenKind.RBrace
			return out when lineBreakAfter(file, before, at)
			let closed = before.parent
			return out when closed is none
			let owner = closed.parent
			return out when owner is none
			switch owner.kind() {
				case SyntaxKind.If:
					out.push("else") unless writtenElsewhere(owner, SyntaxKind.Else, at)
				case SyntaxKind.For, SyntaxKind.LoopClause:
					let loop ?SyntaxNode = owner
					loop = owner.parent when owner.kind() == SyntaxKind.LoopClause
					return out when loop is none
					let written map<string, bool>
					for let (_, c) in loop.children() {
						continue unless c.kind() == SyntaxKind.LoopClause && c.start() != at
						let word = c.firstToken()
						written[word.text()] = true unless word is none
					}
					for let (_, w) in ["every", "break", "empty", "finish"] {
						out.push(w) unless written.hasKey(w)
					}
				case SyntaxKind.Transaction:
					out.push("onerror") unless writtenElsewhere(owner, SyntaxKind.OnError, at)
				default:
			}
			return out
		}

		// writtenElsewhere is true when the node has a child of the kind
		// that does not start at the offset: the one being typed there is not
		// written yet.
		internal def writtenElsewhere(node SyntaxNode, kind SyntaxKind, at int) bool {
			for let (_, c) in node.children() {
				return true when c.kind() == kind && c.start() != at
			}
			return false
		}

		// viewCompletions is what can start an entry of a view's body: the
		// flow-control statements a view takes (spec "Components": `if/else`,
		// `for`, `match`), `let` and `const`, then the values in scope (the
		// components it places).
		internal def viewCompletions(file FileSymbols, at int) Symbol[] {
			let out = keywords(file, followingWords(file, at))
			let seen map<string, bool>
			for let (_, k) in out {
				seen[k.name] = true
			}
			for let (_, w) in ["let", "const", "if", "for", "switch", "match"] {
				addVisible(keywordSymbol(file, w), out, seen)
			}
			for let (_, s) in visibleAt(file, at) {
				addVisible(s, out, seen)
			}
			return out
		}

		// inClause is true when the offset is after a clause's `:`, among its
		// statements.
		internal def inClause(file FileSymbols, at int) bool {
			let before = tokenBefore(file, at)
			return false when before is none
			let clause = before.ancestor(SyntaxKind.Case)
			clause = before.ancestor(SyntaxKind.Default) when clause is none
			return false when clause is none
			let colon = childToken(clause, TokenKind.Colon)
			return !(colon is none) && at >= colon.end()
		}

		// withExpressionKeywords is the values followed by the keywords an
		// expression may start with where no type is expected: `true`,
		// `false`, `none`, `new`, `try`, `await`, and `self` in a type's body.
		// A view's or a style's block takes the values only.
		internal def withExpressionKeywords(file FileSymbols, at int, values Symbol[]) Symbol[] {
			let body = enclosingBody(file, at)
			return values when !(body is none) && body.kind() == SyntaxKind.Block && templateOf(body) != SyntaxKind.Block
			let out Symbol[]
			let seen map<string, bool>
			for let (_, s) in values {
				addVisible(s, out, seen)
			}
			let words = ["true", "false", "none", "new", "try", "await"]
			words.push("self") unless workspace.enclosingType(file, at) is none
			for let (_, w) in words {
				addVisible(keywordSymbol(file, w), out, seen)
			}
			return out
		}

		// isForall is true for a `forall` loop.
		internal def isForall(loop SyntaxNode) bool {
			let first = loop.firstToken()
			return !(first is none) && first.token() == TokenKind.Forall
		}

		// isFallibleType is true for a type written with `!` (`!T`, `!?T`).
		internal def isFallibleType(t SyntaxNode) bool {
			return false unless t.kind() == SyntaxKind.ModifiedType
			for let (_, c) in t.children() {
				return true when c.isToken() && c.token() == TokenKind.Not
			}
			return false
		}

		// isIteratorType is true for `Iterator<T>`, a generator's result.
		internal def isIteratorType(t SyntaxNode) bool {
			return false unless t.kind() == SyntaxKind.NamedType
			let head = t.firstToken()
			return !(head is none) && head.text() == "Iterator"
		}
	}
}
