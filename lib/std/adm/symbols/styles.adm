partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// StyleBody is the body of a style, named or a component's `style { ... }`,
	// in the file that holds it.
	internal struct StyleBody {
		file  FileSymbols
		block SyntaxNode
	}

	// LookLevel is what the keys of a literal of a style body name: properties
	// (`enter = {opacity: 0.0}`, an entry of `on` or `variants`), states (`on =
	// {hover: ...}`), the names of variants (`variants = {big: ...}`), or none of
	// these (the value of a property, `margin = {left: 16(px)}`).
	internal enum LookLevel {
		Other,
		Properties,
		States,
		Variants,
	}

	partial type Navigator {
		// styleName is what a name in a style body means when the body itself
		// does not declare it: a property the style has from a style it
		// embeds (the line `Box`, `Button.style`), and those styles' own
		// embeds, the first found in the order they are named (spec §7, "A
		// style body assigns the properties of its style"); at the left of an
		// assignment at the top of the body, also a member every style has
		// from the prelude's `Style<T>` (`variant`, `enter`). The compiler
		// copies those properties into the body's scope, so they come before
		// the names around the style: `gap` in a component's `style { ... }`
		// is the style's property, not the component's field. None outside a
		// style body, for a name the body or a block in it declares, and for
		// one no embedded style has.
		internal def styleName(file FileSymbols, token SyntaxNode) ?Symbol {
			let block = styleBlockAround(token)
			return none when block is none
			return none when isEmbedLine(token, block)
			let found = file.resolve(token.text(), token.start())
			return none when found.len() > 0 && declaredIn(found[0], file, block)
			let visited map<string, bool>
			let embedded = embeddedProperty(StyleBody{file: file, block: block}, token.text(), visited, 0)
			return embedded unless embedded is none
			return none unless isTopAssignTarget(token, block)
			return styleMember(token.text())
		}

		// lookKey is the property a key of a literal in a style body names
		// where the keys are properties: `opacity` in `enter = {opacity: 0.0}`,
		// in `exit`, in an entry of `on` (`hover: {opacity: 0.8}`, and of an
		// `on` inside one) and in a set of `variants`. None for any other key.
		internal def lookKey(file FileSymbols, token SyntaxNode) ?Symbol {
			let name = token.parent
			return none when name is none
			let init = name.parent
			return none when init is none
			let literal = init.parent
			return none when literal is none
			let block = styleBlockAround(literal)
			return none when block is none
			return none unless lookLevel(literal, block) == LookLevel.Properties
			return none when token.text() == "on"
			return styleProperty(file, block, token.text(), token.start())
		}

		// styleProperty is the property `name` of the style whose body is
		// `block`: a `let` of the body, else one an embedded style has, else a
		// member of the prelude's `Style<T>`.
		internal def styleProperty(file FileSymbols, block SyntaxNode, name string, offset int) ?Symbol {
			let found = file.resolve(name, offset)
			return found[0] when found.len() > 0 && declaredIn(found[0], file, block)
			let visited map<string, bool>
			let embedded = embeddedProperty(StyleBody{file: file, block: block}, name, visited, 0)
			return embedded unless embedded is none
			return styleMember(name)
		}

		// embeddedProperty is the `@styleProperty` let named `name` of a style
		// the body embeds, or of one that style embeds, depth first in the
		// order the lines name them, each style once.
		internal def embeddedProperty(body StyleBody, name string, visited map<string, bool>, depth int) ?Symbol {
			return none when depth > maxDepth
			for let (_, line) in body.block.children() {
				let embedded = embedOf(body.file, line)
				continue when embedded is none
				let key = embedded.file.path + "@" + embedded.block.start().str()
				continue when visited.hasKey(key)
				visited[key] = true
				let own = ownProperty(embedded, name)
				return own unless own is none
				let deeper = embeddedProperty(embedded, name, visited, depth + 1)
				return deeper unless deeper is none
			}
			return none
		}

		// ownProperty is the `@styleProperty` let named `name` the body itself
		// declares; a `let` without the annotation stays the body's own.
		internal def ownProperty(body StyleBody, name string) ?Symbol {
			for let (_, decl) in body.block.children() {
				continue unless decl.kind() == SyntaxKind.LetDecl && isStyleProperty(decl)
				for let (_, field) in decl.children() {
					continue unless field.kind() == SyntaxKind.Field
					let nameToken = field.firstToken()
					continue when nameToken is none || nameToken.text() != name
					return body.file.symbolAt(nameToken.start())
				}
			}
			return none
		}

		// embedOf is the style a line of a style body embeds (`Box`,
		// `styles.Box`, `Button.style`, `widgets.Button.style`), none for a
		// line that embeds none.
		internal def embedOf(file FileSymbols, line SyntaxNode) ?StyleBody {
			return none unless line.kind() == SyntaxKind.ExprStmt
			let expr = firstNonToken(line)
			return none when expr is none
			let owner = embeddedComponent(file, expr)
			return componentStyle(owner) unless owner is none
			return none unless expr.kind() == SyntaxKind.Name || expr.kind() == SyntaxKind.Member
			let declared = symbolOfDepth(file, expr, 0)
			return none when declared is none || declared.kind != SymbolKind.Style
			return bodyOf(declared, file)
		}

		// embeddedComponent is the component of a `Button.style` line, none for
		// another expression.
		internal def embeddedComponent(file FileSymbols, expr SyntaxNode) ?Symbol {
			return none unless expr.kind() == SyntaxKind.Member
			let last = expr.lastToken()
			return none when last is none || last.token() != TokenKind.Style
			let receiver = firstNonToken(expr)
			return none when receiver is none
			let found = symbolOfDepth(file, receiver, 0)
			return none when found is none || found.kind != SymbolKind.Component
			return found
		}

		// componentStyle is the style a component writes in place (`style {
		// ... }`) or names (`style Card`), none for one without either.
		internal def componentStyle(owner Symbol) ?StyleBody {
			let home = workspace.file(owner.file)
			return none when home is none
			let decl = componentStyleDecl(owner)
			return none when decl is none
			let block = childOfKind(decl, SyntaxKind.Block)
			return StyleBody{file: home, block: block} unless block is none
			let named = childOfKind(decl, SyntaxKind.QualifiedName)
			return none when named is none
			let declared = qualifiedStyle(home, named)
			return none when declared is none
			return bodyOf(declared, home)
		}

		// componentStyleDecl is the `style` declaration of a component's body.
		internal def componentStyleDecl(owner Symbol) ?SyntaxNode {
			let body = childOfKind(owner.node, SyntaxKind.Body)
			return none when body is none
			return childOfKind(body, SyntaxKind.StyleDecl)
		}

		// qualifiedStyle is the style a component's `style Card` or `style
		// styles.Card` names.
		internal def qualifiedStyle(file FileSymbols, named SyntaxNode) ?Symbol {
			let parts string[]
			for let (_, t) in named.tokens() {
				parts.push(t.text()) unless t.token() == TokenKind.Dot
			}
			return none when parts.len() == 0
			let current = first(workspace.resolveType(file, parts[0], named.start()))
			for let i = 1; i < parts.len(); i++ {
				return none when current is none
				current = first(workspace.memberOf(current, parts[i]))
			}
			return none when current is none || current.kind != SymbolKind.Style
			return current
		}

		// bodyOf is the body of a named style, in the file that declares it.
		internal def bodyOf(declared Symbol, fallback FileSymbols) ?StyleBody {
			let block = childOfKind(declared.node, SyntaxKind.Block)
			return none when block is none
			return StyleBody{file: homeOf(declared, fallback), block: block}
		}

		// embeddedStyleAt is what the `style` of a `Button.style` line in a
		// style body names: the style of the component, the one it names or,
		// for one it writes in place, that `style` declaration.
		internal def embeddedStyleAt(file FileSymbols, token SyntaxNode) ?Symbol {
			return none unless token.token() == TokenKind.Style
			let member = token.parent
			return none when member is none || member.kind() != SyntaxKind.Member
			let line = member.parent
			return none when line is none || line.kind() != SyntaxKind.ExprStmt
			let block = line.parent
			return none when block is none || !isStyleBlock(block)
			let owner = embeddedComponent(file, member)
			return none when owner is none
			let decl = componentStyleDecl(owner)
			return none when decl is none
			let home = workspace.file(owner.file)
			return none when home is none
			let named = childOfKind(decl, SyntaxKind.QualifiedName)
			return qualifiedStyle(home, named) unless named is none
			let keyword = decl.firstToken()
			return none when keyword is none
			let declared = new Symbol(SymbolKind.Style, "style", decl, keyword.start(), keyword.end())
			declared.file = home.path
			declared.path = owner.path + ".style"
			declared.parent = owner
			return declared
		}

		// styleCompletions is what can start an entry at the top of a style
		// body: its own lets written above, the properties of the styles it
		// embeds (`@styleProperty` lets, depth first in the order the lines
		// name them, each once), the members every style may assign
		// (`variant`, `enter`, `exit` from the prelude's `Style<T>`, the `on`
		// and `variants` keys), `let` for a property of its own, and what it
		// may embed: the styles (a module imported, for `styles.Box`) and the
		// styles of the components that have one, as `Button.style` rows.
		// Never a value, and never a component alone.
		internal def styleCompletions(file FileSymbols, block SyntaxNode, at int) Symbol[] {
			let out Symbol[]
			let seen map<string, bool>
			for let (_, decl) in block.children() {
				break when decl.start() >= at
				continue unless decl.kind() == SyntaxKind.LetDecl
				for let (_, field) in decl.children() {
					continue unless field.kind() == SyntaxKind.Field
					let nameToken = field.firstToken()
					continue when nameToken is none
					let own = file.symbolAt(nameToken.start())
					addVisible(own, out, seen) unless own is none
				}
			}
			let visited map<string, bool>
			embeddedProperties(StyleBody{file: file, block: block}, out, seen, visited, 0)
			for let (_, name) in ["variant", "enter", "exit"] {
				let member = styleMember(name)
				addVisible(member, out, seen) unless member is none
			}
			for let (_, word) in ["on", "variants", "let"] {
				addVisible(keywordSymbol(file, word), out, seen)
			}
			for let (_, s) in visibleWhere(file, at, c => c.kind == SymbolKind.Style || importsKind(c, SymbolKind.Style)) {
				addVisible(s, out, seen)
			}
			// A component's own style does not embed itself.
			let holder = workspace.enclosingType(file, block.start())
			for let (_, c) in visibleWhere(file, at, s => s.kind == SymbolKind.Component) {
				continue when !(holder is none) && sameDeclaration(c, holder)
				let row = componentStyleRow(c)
				addVisible(row, out, seen) unless row is none
			}
			return out
		}

		// componentStyleRow is the `Button.style` a style body may embed for a
		// component with a style, none for one without.
		internal def componentStyleRow(owner Symbol) ?Symbol {
			let decl = componentStyleDecl(owner)
			return none when decl is none
			let keyword = decl.firstToken()
			return none when keyword is none
			let row = new Symbol(SymbolKind.Style, owner.name + ".style", decl, keyword.start(), keyword.end())
			row.file = owner.file
			row.path = owner.path + ".style"
			row.doc = owner.doc
			row.parent = owner
			return row
		}

		// embeddedProperties adds the `@styleProperty` lets of every style the
		// body embeds, and those styles' embeds, in the order
		// `embeddedProperty` looks them up.
		internal def embeddedProperties(body StyleBody, out Symbol[], seen map<string, bool>, visited map<string, bool>, depth int) {
			return when depth > maxDepth
			for let (_, line) in body.block.children() {
				let embedded = embedOf(body.file, line)
				continue when embedded is none
				let key = embedded.file.path + "@" + embedded.block.start().str()
				continue when visited.hasKey(key)
				visited[key] = true
				for let (_, decl) in embedded.block.children() {
					continue unless decl.kind() == SyntaxKind.LetDecl && isStyleProperty(decl)
					for let (_, field) in decl.children() {
						continue unless field.kind() == SyntaxKind.Field
						let nameToken = field.firstToken()
						continue when nameToken is none
						let property = embedded.file.symbolAt(nameToken.start())
						addVisible(property, out, seen) unless property is none
					}
				}
				embeddedProperties(embedded, out, seen, visited, depth + 1)
			}
		}

		// styleMember is a member every style has from the prelude's
		// `Style<T>`, none when the prelude is not in the workspace.
		internal def styleMember(name string) ?Symbol {
			for let (_, base) in workspace.lookup("builtin", "Style") {
				let found = base.member(name)
				return found[0] when found.len() > 0
			}
			return none
		}
	}

	// styleBlockAround is the body of the style the node is in, none outside
	// one.
	internal def styleBlockAround(node SyntaxNode) ?SyntaxNode {
		let at = node.parent
		for {
			return none when at is none
			return at when isStyleBlock(at)
			at = at.parent
		}
	}

	// isStyleBlock is true for the block of a style declaration.
	internal def isStyleBlock(node SyntaxNode) bool {
		return false unless node.kind() == SyntaxKind.Block
		let holder = node.parent
		return !(holder is none) && holder.kind() == SyntaxKind.StyleDecl
	}

	// isEmbedLine is true for a token of a line of the body that names a
	// style to embed: a name or a member alone on its line.
	internal def isEmbedLine(token SyntaxNode, block SyntaxNode) bool {
		let line = topStatement(token, block)
		return false when line is none || line.kind() != SyntaxKind.ExprStmt
		let expr = firstNonToken(line)
		return !(expr is none) && (expr.kind() == SyntaxKind.Name || expr.kind() == SyntaxKind.Member)
	}

	// topStatement is the statement of the body that holds the node.
	internal def topStatement(node SyntaxNode, block SyntaxNode) ?SyntaxNode {
		let at ?SyntaxNode = node
		for {
			return none when at is none
			let up = at.parent
			return none when up is none
			return at when up.same(block)
			at = up
		}
	}

	// isTopAssignTarget is true for the name assigned by a statement `name =
	// value` at the top of the body.
	internal def isTopAssignTarget(token SyntaxNode, block SyntaxNode) bool {
		let name = token.parent
		return false when name is none || name.kind() != SyntaxKind.Name
		let assign = name.parent
		return false when assign is none || assign.kind() != SyntaxKind.Assign || name.index != 0
		let line = assign.parent
		return false when line is none || line.kind() != SyntaxKind.ExprStmt
		let up = line.parent
		return !(up is none) && up.same(block)
	}

	// lookLevel is what the keys of a literal in a style body name: the
	// properties of the style in `enter`, `exit`, an entry of `on` and a set of
	// `variants`; states in `on` (and in an `on` inside an entry); names in
	// `variants`.
	internal def lookLevel(literal SyntaxNode, block SyntaxNode) LookLevel {
		return LookLevel.Other unless literal.kind() == SyntaxKind.StructLit
		let parent = literal.parent
		return LookLevel.Other when parent is none
		if parent.kind() == SyntaxKind.Assign {
			let target = parent.child(0)
			return LookLevel.Other when target is none || target.same(literal) || target.kind() != SyntaxKind.Name
			let line = parent.parent
			return LookLevel.Other when line is none
			let up = line.parent
			return LookLevel.Other when up is none || !up.same(block)
			switch target.text() {
				case "enter", "exit":
					return LookLevel.Properties
				case "on":
					return LookLevel.States
				case "variants":
					return LookLevel.Variants
				default:
					return LookLevel.Other
			}
		}
		return LookLevel.Other unless parent.kind() == SyntaxKind.FieldInit
		let key = parent.child(0)
		return LookLevel.Other when key is none || key.same(literal)
		let outer = parent.parent
		return LookLevel.Other when outer is none
		switch lookLevel(outer, block) {
			case LookLevel.States, LookLevel.Variants:
				return LookLevel.Properties
			case LookLevel.Properties:
				return LookLevel.States when key.text() == "on"
				return LookLevel.Other
			default:
				return LookLevel.Other
		}
	}

	// declaredIn is true for a symbol the block (or one inside it) declares.
	internal def declaredIn(symbol Symbol, file FileSymbols, block SyntaxNode) bool {
		return symbol.file == file.path && symbol.node.start() >= block.start() && symbol.node.end() <= block.end()
	}

	// isStyleProperty is true for a `let` declaration annotated
	// `@styleProperty`.
	internal def isStyleProperty(decl SyntaxNode) bool {
		for let (_, c) in decl.children() {
			continue unless c.kind() == SyntaxKind.Attribute
			for let (_, n) in c.children() {
				continue unless n.kind() == SyntaxKind.Name || n.kind() == SyntaxKind.QualifiedName
				let last = n.lastToken()
				return true when !(last is none) && last.text() == "styleProperty"
			}
		}
		return false
	}
}
