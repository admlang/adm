partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	internal def stylePreludeSource() string {
		return fixture("""
partial module builtin «
	internal type Style<T> «
		let variant string[] = []
		let enter ?def(look int) = none
	»
»
""")
	}

	internal def styleLibSource() string {
		return fixture("""
module ui «
	struct Edges «
		left int
		right int
	»
	style Box «
		@styleProperty
		let width int = 0
		@styleProperty
		let height int = 0
		@styleProperty
		let margin Edges = Edges«»
		let scratch = 1
	»
	style Layout «
		Box
		@styleProperty
		let gap int = 0
	»
»
""")
	}

	internal def styleAppSource() string {
		return fixture("""
module app «
	use ui
	use ui::(Layout)

	style Card «
		Layout
		@styleProperty
		let tint int = 0
		width = height
		gap = tint
		margin = «left: 1»
		variant = []
		enter = «opacity: 0, width: 2, margin: «right: 3»»
		on = «hover: «tint: 2, on: «pressed: «gap: 3»»»»
		variants = «big: «height: 4»»
		scratch = 5
	»

	component Button «
		type «
			gap int = 0
		»
		view «»
		style «
			Card
			gap = width
		»
	»

	component Chip «
		view «»
		style «
			Button.style
			tint = 1
		»
	»

	component Tag «
		view «»
		style Card
	»

	component Pill «
		view «»
		style «
			Tag.style
			height = 1
		»
	»

	def outside() int «
		let width = 3
		return width
	»
»
""")
	}

	check "Styles" {
		@test()
		def TestStyleBodyCompletions() {
			let w = new Workspace()
			w.add("builtin.adm", parse(stylePreludeSource()))
			w.add("ui.adm", parse(styleLibSource()))
			let source = styleAppSource().replace("\t\tgap = tint\n", "\t\tgap = tint\n\t\t\n")
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let at = source.indexOf("gap = tint\n") + 13
			// The properties of the embedded styles (Layout's, then the Box it
			// embeds), what every style assigns, `let`, and the styles it may
			// embed: no values, no components.
			let card = namesOf(nav.completionsAt(app, at))
			assert card.startsWith("tint,gap,width,height,margin,variant,enter,on,variants,let,ui,Layout,Card,Button.style")
			assert !card.contains("Button,") && !card.endsWith("Button")
			// A name being assigned takes nothing until its `=`.
			let named = source.indexOf("width = height") + 6
			assert nav.completionsAt(app, named).len() == 0
			// A component's own style body embeds through `Card`.
			let inButton = source.indexOf("\t\t\tgap = width")
			let rows = namesOf(nav.completionsAt(app, inButton))
			// Its own component's style is not offered to it.
			assert rows.startsWith("tint,gap,width") && rows.contains("Chip.style") && !rows.contains("Button.style")
		}

		@test()
		def TestStyleProperties() {
			let w = new Workspace()
			w.add("builtin.adm", parse(stylePreludeSource()))
			w.add("ui.adm", parse(styleLibSource()))
			let source = styleAppSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let at = def (text string, skip int) string {
				return pathsOf(nav.definitionAt(app, source.indexOf(text) + skip))
			}
			// Assigned at the top of the body and read in a value: a property of an
			// embedded style (through `Layout`, which embeds `Box`), the body's own.
			assert at("width = height", 0) == "ui.Box.width" && at("width = height", 8) == "ui.Box.height"
			assert at("gap = tint", 0) == "ui.Layout.gap" && at("gap = tint", 6) == "app.Card.tint"
			// A literal assigned to a property is of the property's type.
			assert at("margin = \{left", 0) == "ui.Box.margin" && at("margin = \{left", 10) == "ui.Edges.left"
			// What every style has from the prelude.
			assert at("variant = []", 0) == "builtin.Style.variant" && at("enter = \{", 0) == "builtin.Style.enter"
			// The keys of `enter`, of an entry of `on` and of an `on` in it, and of a
			// set of `variants` are properties; states, variant names and what no
			// style has are nothing.
			assert at("width: 2", 0) == "ui.Box.width" && at("right: 3", 0) == "ui.Edges.right" && at("opacity: 0", 0) == ""
			assert at("hover: \{", 0) == "" && at("tint: 2", 0) == "app.Card.tint" && at("pressed: \{", 0) == "" && at("gap: 3", 0) == "ui.Layout.gap"
			assert at("big: \{", 0) == "" && at("height: 4", 0) == "ui.Box.height"
			// A `let` without `@styleProperty` stays the body that declares it.
			assert at("scratch = 5", 0) == ""
			// In a component's style the style's property comes before the
			// component's field of the same name.
			assert at("gap = width", 0) == "ui.Layout.gap" && at("gap = width", 6) == "ui.Box.width"
			// `Button.style` embeds the style the component writes in place, and
			// what that style embeds; `Tag.style` the one the component names.
			assert at("tint = 1", 0) == "app.Card.tint" && at("height = 1", 0) == "ui.Box.height"
			let written = nav.definitionAt(app, source.indexOf("Button.style") + 7)
			assert written.len() == 1 && written[0].kind == SymbolKind.Style && written[0].path == "app.Button.style"
			assert at("Tag.style", 4) == "app.Card"
			// Outside a style body, nothing changes.
			assert at("return width", 7) == ""
			let local = nav.definitionAt(app, source.indexOf("return width") + 7)
			assert local.len() == 1 && local[0].kind == SymbolKind.Local
			// Hover reads the property.
			let shown = nav.hoverAt(app, source.indexOf("gap = width"))
			assert !(shown is none) && shown.symbol.path == "ui.Layout.gap"
		}
	}
}
