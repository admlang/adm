partial module std.adm.symbols {
	use std.adm.syntax::(SyntaxNode)

	// Symbol is a declaration: what it declares, its name, its qualified
	// path (empty for a local, a parameter or an import), the node that
	// declares it, the span of its name, its doc comment, its annotations,
	// and for a type-like declaration its members. `id` is the stable
	// identity a Workspace assigns, kept across edits that leave the path;
	// 0 outside a workspace.
	type Symbol {
		kind         SymbolKind
		name         string
		path         string       = ""
		node         SyntaxNode
		nameStart    int          = 0
		nameEnd      int          = 0
		doc          string       = ""
		annotations  SyntaxNode[]
		isInternal   bool         = false
		members      Symbol[]
		weak parent  ?Symbol      = none
		id           int          = 0
		// The path of the file that declares it, as given to `analyze`.
		file         string       = ""
		// For an import: the module it names (`moduleName`), the name it imports from it
		// ("" for the module itself or a wildcard), and whether it is `*`.
		moduleName   string       = ""
		imported     string       = ""
		wildcard     bool         = false
		// For a unit: the prefix table its declaration allows (`SI`, `Data`),
		// "" for none; `km` is `k` + a unit declared with `Prefixes.SI`.
		unitPrefixes string       = ""

		def new(kind SymbolKind, name string, node SyntaxNode, nameStart int, nameEnd int) {
			self.kind = kind
			self.name = name
			self.node = node
			self.nameStart = nameStart
			self.nameEnd = nameEnd
		}

		// start is where the declaration's own text starts.
		def start() int {
			return node.start()
		}

		// end is where the declaration's own text ends (exclusive).
		def end() int {
			return node.end()
		}

		// member is every member named `name`, in declaration order.
		def member(name string) Symbol[] {
			let out Symbol[]
			for let (_, m) in members {
				out.push(m) when m.name == name
			}
			return out
		}

		// describe is the kind and path (or name) for messages.
		def describe() string {
			return kind.value + " " + (path.len() > 0 ?? (path, name))
		}
	}

	// Scope is a region of a file with the symbols it declares, inside its
	// parent scope. Locals are visible from their declaration on, parameters
	// and members everywhere in the scope.
	type Scope {
		kind        ScopeKind
		node        SyntaxNode
		start       int
		end         int
		symbols     Symbol[]
		// The `*` imports of this scope, in source order.
		wildcards   Symbol[]
		children    Scope[]
		weak parent ?Scope     = none

		def new(kind ScopeKind, node SyntaxNode) {
			self.kind = kind
			self.node = node
			self.start = node.start()
			self.end = node.end()
		}

		// lookup is every symbol of this scope named `name` and visible at
		// `offset`: a local only from where it is declared.
		def lookup(name string, offset int) Symbol[] {
			let out Symbol[]
			for let (_, s) in symbols {
				continue unless s.name == name
				continue when s.kind == SymbolKind.Local && s.path.len() == 0 && s.nameStart > offset
				// A check suite's string name is no identifier: `check "Point"`
				// never shadows `type Point`.
				continue when s.kind == SymbolKind.Check
				out.push(s)
			}
			return out
		}

		// innermost is the deepest scope under this one that holds the
		// offset, itself when no child does.
		def innermost(offset int) Scope {
			for let (_, c) in children {
				return c.innermost(offset) when offset >= c.start && offset < c.end
			}
			return self
		}

		// declares adds a symbol to the scope.
		def declare(symbol Symbol) {
			symbols.push(symbol)
		}
	}
}
