partial module std.adm.symbols {
	use (
		std.adm.syntax::(SyntaxNode, parse)
		std.testing
	)

	// paths is the path of every declaration of the file, joined by spaces.
	internal def paths(file FileSymbols) string {
		let out string[]
		for let (_, s) in file.declarations {
			out.push(s.path)
		}
		return out.join(" ")
	}

	// unresolved is true when a lookup found no declaration: nothing, or
	// only the `*` imports in scope for the workspace to try.
	internal def unresolved(found Symbol[]) bool {
		for let (_, s) in found {
			return false unless s.kind == SymbolKind.Import && s.wildcard
		}
		return true
	}

	// kindsOf is the kinds of the symbols, joined by `,`.
	internal def kindsOf(found Symbol[]) string {
		let out string[]
		for let (_, s) in found {
			out.push(s.kind.value + ":" + s.name)
		}
		return out.join(",")
	}

	internal def sample() string {
		return fixture("""
use std.io

// Point things.
partial module m «
	use (
		std.os::(File as F, readFile)
		std.strings::*
	)

	// A is one.
	const A = 1
	let count int = 0

	// Point is a point.
	@portable()
	type Point<T> «
		// x is the abscissa.
		x, y T
		width int «
			def get() int « return 1 »
		»

		def new(x T, y T) «
			self.x = x
		»

		internal def add(o Point<T>) Point<T> «
			return new Point<T>(x + o.x, y + o.y)
		»
	»

	enum Kind « Open, Close »

	// f does things.
	@test()
	@cfg(os = "linux")
	def f(a int, b ...string) !int «
		let before = a
		for let (i, s) in b «
			let inner = s.len()
		»
		let after = xs.sort(def (p Point<int>, q Point<int>) bool « return p.x < q.x »)
		let g = v => v + 1
		match any «
		case (left, right):
			return left
		case «age int»:
			return age
		»
		let r = open() onerror (err error) « recover 0 »
		return before
	»
»
""")
	}

	check "Symbols" {
		@test()
		def TestDeclarationsAndDocs() {
			let source = sample()
			let file = analyze(parse(source), "m.adm")
			assert file.units.len() == 1 && file.units[0].kind == SymbolKind.Module && file.units[0].path == "m"
			assert file.units[0].doc == "Point things."
			assert paths(file) == "m m.A m.count m.Point m.Point.x m.Point.y m.Point.width m.Point.width.get m.Point.new m.Point.add m.Kind m.Kind.Open m.Kind.Close m.f"
			let point = file.units[0].member("Point")[0]
			assert point.kind == SymbolKind.Type && point.doc == "Point is a point."
			assert point.annotations.len() == 1 && point.annotations[0].text() == "@portable()"
			assert point.members.len() == 5
			assert point.member("x")[0].kind == SymbolKind.Field && point.member("x")[0].doc == "x is the abscissa."
			assert point.member("y")[0].doc == "x is the abscissa."
			assert point.member("width")[0].kind == SymbolKind.Property
			assert point.member("add")[0].kind == SymbolKind.Method && point.member("add")[0].isInternal
			assert !point.member("new")[0].isInternal
			let f = file.units[0].member("f")[0]
			assert f.kind == SymbolKind.Function && f.doc == "f does things." && f.annotations.len() == 2
			assert f.name == "f" && source[f.nameStart:f.nameEnd] == "f"
			assert file.units[0].member("A")[0].kind == SymbolKind.Const && file.units[0].member("count")[0].kind == SymbolKind.Local
			assert file.units[0].member("Kind")[0].member("Open")[0].kind == SymbolKind.EnumMember
			let table = analyze(parse("module t \{\n\tconst (\n\t\tboxAlac = 1 // alac\n\t\tboxMp4a = 2\n\t)\n\}\n"), "t.adm")
			assert table.units[0].member("boxAlac")[0].doc == "alac" && table.units[0].member("boxMp4a")[0].doc == ""
			assert trailingDocText(presentNode(table.units[0].member("boxAlac")[0].node.lastToken()).green.trailing) == "alac"
			let at = presentSymbol(file.symbolAt(f.nameStart))
			assert at.path == "m.f"
			assert file.symbolAt(0) is none
		}

		@test()
		def TestScopesAndResolution() {
			let source = sample()
			let file = analyze(parse(source), "m.adm")
			let inAdd = source.indexOf("return new Point")
			let f = file.units[0].member("f")[0]
			assert kindsOf(file.resolve("x", inAdd)) == "field:x"
			assert kindsOf(file.resolve("o", inAdd)) == "parameter:o"
			assert kindsOf(file.resolve("T", inAdd)) == "type parameter:T"
			assert kindsOf(file.resolve("add", inAdd)) == "method:add"
			assert kindsOf(file.resolve("A", inAdd)) == "const:A"
			assert kindsOf(file.resolve("f", inAdd)) == "function:f"
			let beforeDecl = source.indexOf("let before")
			let afterDecl = source.indexOf("for let (i, s)")
			assert unresolved(file.resolve("before", beforeDecl))
			assert kindsOf(file.resolve("before", afterDecl)) == "let:before"
			assert kindsOf(file.resolve("a", afterDecl)) == "parameter:a"
			assert kindsOf(file.resolve("b", afterDecl)) == "parameter:b"
			let inLoop = source.indexOf("let inner")
			assert kindsOf(file.resolve("i", inLoop)) == "let:i" && kindsOf(file.resolve("s", inLoop)) == "let:s"
			assert unresolved(file.resolve("i", afterDecl))
			assert unresolved(file.resolve("inner", source.indexOf("let after")))
			let inSort = source.indexOf("return p.x")
			assert kindsOf(file.resolve("p", inSort)) == "parameter:p"
			assert unresolved(file.resolve("p", source.indexOf("let g")))
			let inLambda = source.indexOf("v + 1")
			assert kindsOf(file.resolve("v", inLambda)) == "parameter:v"
			let inCase = source.indexOf("return left")
			assert kindsOf(file.resolve("left", inCase)) == "let:left" && kindsOf(file.resolve("right", inCase)) == "let:right"
			assert kindsOf(file.resolve("age", source.indexOf("return age"))) == "let:age"
			assert unresolved(file.resolve("age", inCase))
			assert kindsOf(file.resolve("err", source.indexOf("recover 0"))) == "let:err"
			assert unresolved(file.resolve("err", source.indexOf("return before")))
			// Imports: a module, an aliased symbol, a named symbol, and a `*`.
			let imports = file.resolve("F", inAdd)
			assert kindsOf(imports) == "import:F" && imports[0].moduleName == "std.os" && imports[0].imported == "File"
			assert file.resolve("readFile", inAdd)[0].imported == "readFile"
			assert file.resolve("io", inAdd)[0].moduleName == "std.io" && file.resolve("io", inAdd)[0].imported == ""
			let star = file.resolve("trim", inAdd)
			assert star.len() == 1 && star[0].wildcard && star[0].moduleName == "std.strings"
			assert unresolved(star) && !unresolved(imports)
			assert f.end() > f.start() && f.describe() == "function m.f"
			assert presentSymbol(file.unitAt(inAdd)).path == "m"
			let outside = file.unitAt(0)
			assert outside is none
			// A function's body shares the function's scope.
			assert file.root.innermost(inAdd).kind == ScopeKind.Function
			let extra = new Scope(ScopeKind.Block, file.tree.root())
			extra.declare(f)
			assert kindsOf(extra.lookup("f", 0)) == "function:f"
			assert docText(presentSymbol(file.symbolAt(f.nameStart)).node.green.leading) == "" && f.doc == "f does things."
			assert file.scopeAt(inAdd).kind == ScopeKind.Function
			assert file.scopeAt(source.indexOf("x, y T")).kind == ScopeKind.Members
			assert file.scopeAt(source.indexOf("const A")).kind == ScopeKind.Unit
			assert file.scopeAt(0).kind == ScopeKind.File
			assert file.scopeAt(inLoop).kind == ScopeKind.Block && presentScope(file.scopeAt(inLoop).parent).kind == ScopeKind.Header
		}

		@test()
		def TestWorkspace() {
			let one = fixture("""
module m «
	// helper helps.
	def helper() int « return 1 »
	def helper(x int) int « return x »
»
""")
			let two = fixture("""
partial module m «
	def other() int « return helper() »
»
""")
			let three0 = fixture("""
module pm «
	partial type Parser «
		pos int
		def parseName() bool « return at(1) && pos > 0 »
	»
»
""")
			let three1 = fixture("""
partial module pm «
	partial type Parser «
		def at(k int) bool « return false »
	»
»
""")
			let three = fixture("""
module n «
	use m::(helper as h)
	use m
	use m::*
	def g() int « return h() + m.other() + helper() »
»
""")
			let w = new Workspace()
			let f1 = w.add("one.adm", parse(one))
			let f2 = w.add("two.adm", parse(two))
			let f3 = w.add("three.adm", parse(three))
			let f0 = w.add("three0.adm", parse(three0))
			w.add("three1.adm", parse(three1))
			// A bare member name inside a partial type resolves through the
			// type's part in another file; the part's own field first.
			assert pathsOf(w.resolve(f0, "at", three0.indexOf("at(1)"))) == "pm.Parser.at"
			assert pathsOf(w.resolve(f0, "pos", three0.indexOf("pos > 0"))) == "pm.Parser.pos"
			assert w.resolve(f0, "at", three0.indexOf("partial type")).len() == 0
			assert pathOf(w.enclosingType(f0, three0.indexOf("at(1)"))) == "pm.Parser" && w.enclosingType(f0, 0) is none
			assert w.parts("m").len() == 2 && w.exports("m").len() == 3
			assert w.lookup("m", "helper").len() == 2 && w.lookup("m", "helper")[0].doc == "helper helps."
			let inOther = two.indexOf("return helper")
			assert kindsOf(w.resolve(f2, "helper", inOther)) == "function:helper,function:helper"
			let inG = three.indexOf("return h()")
			assert kindsOf(w.resolve(f3, "h", inG)) == "function:helper,function:helper"
			let asModule = w.resolve(f3, "m", inG)
			assert kindsOf(asModule) == "import:m"
			assert kindsOf(w.memberOf(asModule[0], "other")) == "function:other"
			assert kindsOf(w.resolve(f3, "helper", inG)) == "function:helper,function:helper"
			assert w.resolve(f3, "missing", inG).len() == 0
			// Ids: stable across an edit of a body, distinct per overload, new for a new name.
			let helperId = w.lookup("m", "helper")[0].id
			let secondId = w.lookup("m", "helper")[1].id
			let otherId = w.lookup("m", "other")[0].id
			assert helperId > 0 && secondId != helperId && otherId != helperId
			let edited = f1.tree.edit(one.indexOf("return 1") + 7, one.indexOf("return 1") + 8, "42")
			w.update("one.adm", edited)
			assert w.lookup("m", "helper")[0].id == helperId && w.lookup("m", "helper")[1].id == secondId
			assert w.lookup("m", "other")[0].id == otherId
			let renamed = f2.tree.edit(two.indexOf("other"), two.indexOf("other") + 5, "another")
			w.update("two.adm", renamed)
			assert w.lookup("m", "other").len() == 0
			assert w.lookup("m", "another")[0].id != otherId
			w.remove("one.adm")
			assert w.parts("m").len() == 1 && w.lookup("m", "helper").len() == 0
			assert w.file("one.adm") is none
		}
	}

	// presentSymbol is the symbol, which the test expects to be there.
	internal def presentSymbol(value ?Symbol) Symbol {
		return value unless value is none
		assert false
		return new Symbol(SymbolKind.Local, "", parse("").root(), 0, 0)
	}

	// presentNode is the node, which the test expects to be there.
	internal def presentNode(value ?SyntaxNode) SyntaxNode {
		return value unless value is none
		assert false
		return parse("").root()
	}

	// presentScope is the scope, which the test expects to be there.
	internal def presentScope(value ?Scope) Scope {
		return value unless value is none
		assert false
		return new Scope(ScopeKind.File, parse("").root())
	}
}
