partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(Green, SyntaxKind, SyntaxNode)
	)

	// TypeKind is what a Type is made of.
	enum TypeKind {
		Unknown,
		Primitive,
		Named,
		TypeParam,
		Optional,
		Fallible,
		Async,
		Array,
		Map,
		Channel,
		Vector,
		Mask,
		Matrix,
		Func,
		Tuple,
		Union,
		Intersection
	}

	// Type is a type as the editor knows it. A Workspace interns its
	// types, so two types are equal when they are the same object. Unknown
	// is what this layer cannot tell: it fits every place and is never
	// reported.
	type Type {
		id                  int
		kind                TypeKind
		// A primitive's name (`int`, `string`, `none`); a named type's or a
		// type parameter's as written.
		name                string   = ""
		// A named type's declaration path; the path of a type parameter's
		// owner.
		path                string   = ""
		// Named: the type arguments. Optional, Fallible, Async, Array,
		// Channel, Vector, Mask, Matrix: the element. Map: the key and the
		// value. Func: the parameters. Tuple, Union, Intersection: the
		// members.
		args                Type[]
		// Func: the result, `none` for a function that returns nothing.
		result              ?Type    = none
		// Func: the last parameter takes any number of arguments.
		variadic            bool     = false
		// TypeParam: its position among its owner's type parameters.
		// Vector, Mask: the lanes. Matrix: the rows, 0 for a matrix shaped
		// at run time.
		index               int      = 0
		// Matrix: the columns, 0 for a matrix shaped at run time.
		columns             int      = 0
		// Named, for an alias (`type Value = Tensor | Tensor[]`): the type it
		// stands for. The alias keeps its name, as the compiler's types do
		// (`Named{Name, Underlying}`); what depends on the structure reads
		// through it (`Navigator.plain`).
		internal underlying ?Type    = none
		// Whether a type parameter occurs in it: substitution passes over
		// the types without one.
		internal open       bool     = false

		def new(id int, kind TypeKind) {
			self.id = id
			self.kind = kind
		}

		// str is the type as ADM spells it: `?File`, `Box<int>`, `string[]`,
		// `map<string, int>`, `def(int) bool`, `(int, string)`; `unknown`
		// for what this layer cannot tell.
		def str() string {
			switch kind {
				case TypeKind.Unknown:
					return "unknown"
				case TypeKind.Primitive, TypeKind.TypeParam:
					return name
				case TypeKind.Named:
					return name when args.len() == 0
					return name + "<" + joinTypes(args, ", ") + ">"
				case TypeKind.Optional:
					return "?" + args[0].str()
				case TypeKind.Fallible:
					return "!" + args[0].str()
				case TypeKind.Async:
					return "async " + args[0].str()
				case TypeKind.Array:
					// `?int[]` is the optional of an array: an array of optionals is
					// `array<?int>`, as the compiler spells it.
					return "array<" + args[0].str() + ">" when args[0].bindsLoosely()
					return args[0].str() + "[]"
				case TypeKind.Map:
					return "map<" + args[0].str() + ", " + args[1].str() + ">"
				case TypeKind.Channel:
					return "channel<" + args[0].str() + ">"
				case TypeKind.Vector:
					return "vec{index}<" + args[0].str() + ">"
				case TypeKind.Mask:
					return "mask{index}<" + args[0].str() + ">"
				case TypeKind.Matrix:
					return "matrix<" + args[0].str() + ">" when index == 0
					return "matrix<" + args[0].str() + ", {index}, {columns}>"
				case TypeKind.Func:
					let params string[]
					for let (i, p) in args {
						params.push((variadic && i == args.len() - 1) ?? ("..." + p.str(), p.str()))
					}
					let head = "def(" + params.join(", ") + ")"
					let r = result
					return head when r is none
					return head when r.kind == TypeKind.Primitive && r.name == "none"
					return head + " " + r.str()
				case TypeKind.Tuple:
					return "(" + joinTypes(args, ", ") + ")"
				case TypeKind.Union:
					let parts string[]
					for let (_, m) in args {
						if m.kind == TypeKind.Optional || m.kind == TypeKind.Fallible {
							parts.push("(" + m.str() + ")")
						} else {
							parts.push(m.str())
						}
					}
					return parts.join(" | ")
				case TypeKind.Intersection:
					return joinTypes(args, " & ")
				default:
					return "unknown"
			}
		}

		// isUnknown is true for Unknown and for a type made with it
		// (`?unknown`, `Box<unknown>`): what such a type says is not certain.
		def isUnknown() bool {
			return true when kind == TypeKind.Unknown
			for let (_, a) in args {
				return true when a.isUnknown()
			}
			let r = result
			return !(r is none) && r.isUnknown()
		}

		// bindsLoosely is true for a type whose spelling a `[]` after it
		// would change the meaning of.
		internal def bindsLoosely() bool {
			switch kind {
				case TypeKind.Optional, TypeKind.Fallible, TypeKind.Async, TypeKind.Func, TypeKind.Union, TypeKind.Intersection:
					return true
				default:
					return false
			}
		}
	}

	internal def joinTypes(types Type[], separator string) string {
		let out string[]
		for let (_, t) in types {
			out.push(t.str())
		}
		return out.join(separator)
	}

	// TypeKey is what makes a type the same type: its kind, its name and
	// path, its sizes, and its parts by id.
	internal struct TypeKey {
		kind  TypeKind
		name  string
		path  string
		index int
		parts string
	}

	// TypeTable is a workspace's types, each made once.
	internal type TypeTable {
		// Every type made so far, by id, and by what makes it the same type.
		types     Type[]
		typeIndex map<TypeKey, Type>
		// Unknown, asked for more than any other type.
		unknown   ?Type              = none

		// intern is the type of the kind made of the parts: the one made
		// before when there is one.
		def intern(kind TypeKind, name string, path string, index int, args Type[], result ?Type, variadic bool, columns int) Type {
			let parts = ""
			let open = kind == TypeKind.TypeParam
			for let (i, a) in args {
				parts += (i == 0) ?? ("{a.id}", ",{a.id}")
				open = true when a.open
			}
			if !(result is none) {
				parts += ">{result.id}"
				open = true when result.open
			}
			parts += "..." when variadic
			parts += "x{columns}" when columns != 0
			let key = TypeKey{kind: kind, name: name, path: path, index: index, parts: parts}
			let found = typeIndex.get(key)
			return found unless found is none
			let t = new Type(types.len(), kind)
			t.name = name
			t.path = path
			t.index = index
			t.columns = columns
			t.variadic = variadic
			t.open = open
			for let (_, a) in args {
				t.args.push(a)
			}
			t.result = result
			types.push(t)
			typeIndex[key] = t
			return t
		}

		def unknownType() Type {
			let held = unknown
			return held unless held is none
			let made = intern(TypeKind.Unknown, "", "", 0, [], none, false, 0)
			unknown = made
			return made
		}

		def primitiveType(name string) Type {
			return intern(TypeKind.Primitive, name, "", 0, [], none, false, 0)
		}

		// namedType is the type a type-like declaration declares, with the
		// type arguments.
		def namedType(declaration Symbol, args Type[]) Type {
			// A declaration without a path is told apart by its id.
			let path = declaration.path.len() > 0 ?? (declaration.path, "#{declaration.id}")
			return intern(TypeKind.Named, declaration.name, path, 0, args, none, false, 0)
		}

		// typeParamType is the type parameter at the index of the owner with
		// the path (overloads share a path, and their parameters of one name
		// and position one type).
		def typeParamType(ownerPath string, index int, name string) Type {
			return intern(TypeKind.TypeParam, name, ownerPath, index, [], none, false, 0)
		}

		// wrapType is the optional, errorable, async, array or channel of
		// the type.
		def wrapType(kind TypeKind, inner Type) Type {
			return intern(kind, "", "", 0, [inner], none, false, 0)
		}

		def mapType(key Type, value Type) Type {
			return intern(TypeKind.Map, "", "", 0, [key, value], none, false, 0)
		}

		// laneType is a SIMD vector or mask of the lanes.
		def laneType(kind TypeKind, lanes int, element Type) Type {
			return intern(kind, "", "", lanes, [element], none, false, 0)
		}

		def matrixType(element Type, rows int, columns int) Type {
			return intern(TypeKind.Matrix, "", "", rows, [element], none, false, columns)
		}

		def funcType(params Type[], result Type, variadic bool) Type {
			return intern(TypeKind.Func, "", "", 0, params, result, variadic, 0)
		}

		def tupleType(members Type[]) Type {
			return intern(TypeKind.Tuple, "", "", 0, members, none, false, 0)
		}

		// setType is the union or intersection of the members: nested ones
		// flattened, each member once, in written order; the member itself
		// when only one is left.
		def setType(kind TypeKind, members Type[]) Type {
			let flat Type[]
			let seen map<int, bool>
			for let (_, m) in members {
				let inner = (m.kind == kind) ?? (m.args, [m])
				for let (_, t) in inner {
					continue when seen.hasKey(t.id)
					seen[t.id] = true
					flat.push(t)
				}
			}
			return unknownType() when flat.len() == 0
			return flat[0] when flat.len() == 1
			return intern(kind, "", "", 0, flat, none, false, 0)
		}

		// rebuilt is a type of the same kind, name and sizes as `t` made of
		// other parts.
		def rebuilt(t Type, args Type[], result ?Type) Type {
			return setType(t.kind, args) when t.kind == TypeKind.Union || t.kind == TypeKind.Intersection
			return intern(t.kind, t.name, t.path, t.index, args, result, t.variadic, t.columns)
		}

		// substitute is the type with the type parameters the bindings name
		// (by type id) replaced.
		def substitute(t Type, bindings map<int, Type>) Type {
			return t unless t.open
			return t when bindings.len() == 0
			if t.kind == TypeKind.TypeParam {
				let bound = bindings.get(t.id)
				return bound unless bound is none
				return t
			}
			let args Type[]
			for let (_, a) in t.args {
				args.push(substitute(a, bindings))
			}
			let r = t.result
			return rebuilt(t, args, r) when r is none
			return rebuilt(t, args, substitute(r, bindings))
		}
	}

	// CallTarget is the function a call calls and its type as the call sees
	// it (a method's with its receiver's type arguments).
	internal struct CallTarget {
		fn        Symbol
		signature Type
	}

	partial type Workspace {
		internal typeTable TypeTable = new TypeTable()
		// Counts the changes that can change what a written type means in
		// another file: a type-like declaration added, removed or renamed, an
		// alias given another target, a file added or removed. A file's
		// lowered types (`FileSymbols.writtenTypes`) hold while it is the
		// same.
		internal shapes    int       = 0

		// shapeOf is what other files see of a file when they lower a
		// written type: its units, its type-like declarations by path, and
		// each alias's target.
		internal def shapeOf(file FileSymbols) string {
			let out string[]
			for let (_, u) in file.units {
				out.push(u.path)
			}
			for let (_, d) in file.declarations {
				continue unless isTypeLike(d.kind)
				if d.kind == SymbolKind.Type && aliasTargetOf(d.node) {
					out.push(d.path + " " + d.node.text())
				} else {
					out.push(d.path)
				}
			}
			return out.join("\n")
		}
	}

	// aliasTargetOf is true for a `type X = T` declaration.
	internal def aliasTargetOf(decl SyntaxNode) bool {
		for let (_, c) in decl.children() {
			return true when c.isToken() && c.token() == TokenKind.Assign
			return false when c.kind() == SyntaxKind.Body
		}
		return false
	}

	partial type Navigator {
		// declarationAt is the type-like declaration with the path (the
		// first part of a partial type), none when no file declares it.
		internal def declarationAt(path string) ?Symbol {
			let names = path.split(".")
			// The longest module name the path starts with: `std.os.File` is
			// File in std.os, `m.Panel.Inner` a member of Panel in m.
			for let cut = names.len() - 1; cut > 0; cut-- {
				let found = typesOnly(workspace.lookup(names[:cut].join("."), names[cut]))
				continue when found.len() == 0
				let current = found[0]
				for let i = cut + 1; i < names.len(); i++ {
					let inner = typesOnly(current.member(names[i]))
					return none when inner.len() == 0
					current = inner[0]
				}
				return current
			}
			return none
		}

		// plain is the type an alias stands for, through aliases of aliases;
		// the type itself for another.
		internal def plain(t Type) Type {
			let current = t
			for let i = 0; i < maxDepth; i++ {
				let u = current.underlying
				return current when u is none
				current = u
			}
			return current
		}

		// typesOnly is the type-like declarations among the symbols.
		internal def typesOnly(found Symbol[]) Symbol[] {
			let out Symbol[]
			for let (_, s) in found {
				out.push(s) when isTypeLike(s.kind)
			}
			return out
		}

		// table is the workspace's types.
		internal def table() TypeTable {
			return workspace.typeTable
		}

		// writtenType is the type a type node spells, read in the file that
		// holds it. A file keeps what it lowered while its tree and the
		// workspace's shape stay the same.
		internal def writtenType(file FileSymbols, node SyntaxNode) Type {
			let cached = cachedType(file, node.green)
			return cached unless cached is none
			let t = lowerType(file, node, 0)
			file.writtenTypes[node.green] = t
			return t
		}

		// cachedType is what the file holds for a node whose type depends
		// on its own text and the workspace's shape only (a written type, a
		// table of literals); none when it holds nothing for it.
		internal def cachedType(file FileSymbols, green Green) ?Type {
			if file.typesEpoch != workspace.shapes {
				let fresh map<Green, Type>
				file.writtenTypes = fresh
				file.typesEpoch = workspace.shapes
			}
			return file.writtenTypes.get(green)
		}

		// lowerType is the type a type node spells (`writtenType` without
		// the cache). An inline struct and a dimension expression are
		// Unknown.
		internal def lowerType(file FileSymbols, node SyntaxNode, depth int) Type {
			return table().unknownType() when depth > maxDepth
			switch node.kind() {
				case SyntaxKind.NamedType:
					return lowerNamed(file, node, depth)
				case SyntaxKind.ArrayType:
					let element = elementType(node)
					return table().unknownType() when element is none
					return table().wrapType(TypeKind.Array, lowerType(file, element, depth + 1))
				case SyntaxKind.ModifiedType:
					let inner = firstNonToken(node)
					return table().unknownType() when inner is none
					let t = lowerType(file, inner, depth + 1)
					// The modifier nearest the type applies first: `async ?T` is
					// a future of an optional.
					let kids = node.children()
					for let i = kids.len() - 1; i >= 0; i-- {
						let c = kids[i]
						continue unless c.isToken()
						switch c.token() {
							case TokenKind.Question:
								t = table().wrapType(TypeKind.Optional, t)
							case TokenKind.Not:
								t = table().wrapType(TypeKind.Fallible, t)
							case TokenKind.Async:
								t = table().wrapType(TypeKind.Async, t)
							default:
						}
					}
					return t
				case SyntaxKind.TupleType:
					let members = lowerMembers(file, node, depth)
					// `(!string) | User`: parentheses around one type group it.
					return members[0] when members.len() == 1
					return table().tupleType(members)
				case SyntaxKind.UnionType:
					return table().setType(TypeKind.Union, lowerMembers(file, node, depth))
				case SyntaxKind.IntersectionType:
					return table().setType(TypeKind.Intersection, lowerMembers(file, node, depth))
				case SyntaxKind.FuncType:
					return lowerFuncType(file, node, depth)
				case SyntaxKind.Name, SyntaxKind.Member:
					// A callee standing for the type it makes (`Row(...)`).
					let sym = staticSymbol(file, node)
					return table().unknownType() when sym is none
					return declaredTypeOf(file, sym, [], depth + 1)
				default:
					return table().unknownType()
			}
		}

		// insideOwnBody is true when the offset of the file is inside a part
		// of the generic declaration.
		internal def insideOwnBody(file FileSymbols, declaration Symbol, offset int) bool {
			return false unless isTypeLike(declaration.kind) && typeParamsOf(declaration).len() > 0
			return true when declaration.file == file.path && offset >= declaration.start() && offset < declaration.end()
			for let (_, part) in partsOf(declaration) {
				return true when part.file == file.path && offset >= part.start() && offset < part.end()
			}
			return false
		}

		// lowerMembers is the types among the node's children.
		internal def lowerMembers(file FileSymbols, node SyntaxNode, depth int) Type[] {
			let out Type[]
			for let (_, c) in node.children() {
				out.push(lowerType(file, c, depth + 1)) unless c.isToken()
			}
			return out
		}

		// lowerNamed is the type a name with its type arguments spells: a
		// primitive, a container, a SIMD vector, a matrix, a declared type
		// (an alias expanded), or a type parameter.
		internal def lowerNamed(file FileSymbols, node SyntaxNode, depth int) Type {
			let head = node.child(0)
			return table().unknownType() when head is none
			let args Type[]
			let sizes int[]
			let list = childOfKind(node, SyntaxKind.TypeArgs)
			if !(list is none) {
				for let (_, a) in list.children() {
					continue when a.isToken()
					if a.kind() == SyntaxKind.Literal {
						// A matrix's rows and columns.
						sizes.push(a.text().toInt<int>())
						continue
					}
					args.push(lowerType(file, a, depth + 1))
				}
			}
			if head.isToken() {
				let builtin = builtinType(head.text(), args, sizes)
				return builtin unless builtin is none
				let found = typeDeclaration(workspace.resolveType(file, head.text(), head.start()))
				return table().unknownType() when found is none
				// Inside a generic type's own body its bare name is the type
				// itself (spec §5).
				return selfType(found) when args.len() == 0 && insideOwnBody(file, found, head.start())
				return declaredTypeOf(file, found, args, depth + 1)
			}
			let found = namedTypeSymbol(file, node)
			return table().unknownType() when found is none
			return declaredTypeOf(file, found, args, depth + 1)
		}

		// builtinType is the type a name the compiler knows spells
		// (`builtinTypeNames` and `builtinTypes` in internal/sema/checker.go:
		// `error` and the kinds `service`, `component`, `view`, `style`
		// among them) with its type arguments; none for another name.
		internal def builtinType(name string, args Type[], sizes int[]) ?Type {
			switch name {
				case "bool", "int", "int8", "int16", "int32", "int64", "int128", "uint", "uint8", "uint16", "uint32", "uint64", "uint128", "bigint", "float", "float16", "float32", "float64", "float128", "complex32", "complex64", "complex128", "string", "char", "byte", "duration", "regex", "none", "any", "anydata", "enum", "error", "service", "component", "view", "style":
					return table().primitiveType(name)
				case "array":
					return table().wrapType(TypeKind.Array, argOrUnknown(args, 0))
				case "channel", "chan":
					return table().wrapType(TypeKind.Channel, argOrUnknown(args, 0))
				case "map":
					return table().mapType(argOrUnknown(args, 0), argOrUnknown(args, 1))
				case "matrix":
					return table().matrixType(argOrUnknown(args, 0), sizes[0], sizes[1]) when sizes.len() == 2
					return table().matrixType(argOrUnknown(args, 0), 0, 0)
				case "vec2", "vec4", "vec8", "vec16", "vec32", "vec64", "vec128":
					return table().laneType(TypeKind.Vector, name[3:].toInt<int>(), argOrUnknown(args, 0))
				case "mask2", "mask4", "mask8", "mask16", "mask32", "mask64", "mask128":
					return table().laneType(TypeKind.Mask, name[4:].toInt<int>(), argOrUnknown(args, 0))
				default:
					return none
			}
		}

		internal def argOrUnknown(args Type[], i int) Type {
			return args[i] when i < args.len()
			return table().unknownType()
		}

		// declaredTypeOf is the type a type-like declaration or a type
		// parameter stands for with the type arguments: the prelude's
		// declarations of primitives and containers as those types, an alias
		// as its target, a type parameter as itself; type arguments left out
		// are Unknown.
		internal def declaredTypeOf(file FileSymbols, declaration Symbol, args Type[], depth int) Type {
			return table().unknownType() when depth > maxDepth
			return typeParamOf(homeOf(declaration, file), declaration) when declaration.kind == SymbolKind.TypeParameter
			return table().unknownType() unless isTypeLike(declaration.kind)
			if declaration.path.startsWith("builtin.") {
				let builtin = builtinType(declaration.name, args, [])
				return builtin unless builtin is none
			}
			let names = typeParamsOf(declaration)
			let full Type[]
			let defaults = typeParamDefaults(file, declaration)
			for let (i, _) in names {
				let given ?Type = none
				given = defaults[i] when i < defaults.len()
				if i < args.len() {
					full.push(args[i])
				} else if !(given is none) {
					// A parameter left out takes its default (spec §5: `Size` and
					// `new Size(...)` instantiate the defaults), which may name the
					// parameters before it (`Pair<A, B = A>`).
					full.push(table().substitute(given, bindingsOf(declaration, full)))
				} else {
					full.push(table().unknownType())
				}
			}
			if declaration.kind == SymbolKind.Type {
				let target = aliasTarget(declaration.node)
				// A derived dimension (`Length / Time`) is a type of its own.
				if !(target is none) && target.kind() != SyntaxKind.DimensionType {
					let alias = named(declaration, full)
					if alias.underlying is none {
						let home = homeOf(declaration, file)
						let expanded = writtenType(home, target)
						alias.underlying = table().substitute(expanded, bindingsOf(declaration, full))
					}
					return alias
				}
			}
			return named(declaration, full)
		}

		// typeParamDefaults is each type parameter's default type, none for
		// one without, read in the file of the part that declares them.
		internal def typeParamDefaults(asking FileSymbols, owner Symbol) array<?Type> {
			let out array<?Type>
			let holder ?Symbol = owner
			let params = childOfKind(owner.node, SyntaxKind.TypeParams)
			if params is none {
				for let (_, part) in partsOf(owner) {
					params = childOfKind(part.node, SyntaxKind.TypeParams)
					if !(params is none) {
						holder = part
						break
					}
				}
			}
			let list = params
			let declaring = holder
			return out when list is none || declaring is none
			let home = homeOf(declaring, asking)
			for let (_, p) in list.children() {
				continue unless p.kind() == SyntaxKind.TypeParam
				let seen = false
				let given ?Type = none
				for let (_, c) in p.children() {
					if c.isToken() && c.token() == TokenKind.Assign {
						seen = true
						continue
					}
					if seen && isTypeNode(c.kind()) {
						given = writtenType(home, c)
						break
					}
				}
				out.push(given)
			}
			return out
		}

		// typeParamOf is the type a type parameter declaration declares,
		// owned by the declaration whose `<...>` holds it.
		internal def typeParamOf(file FileSymbols, param Symbol) Type {
			let list = param.node.parent
			return table().typeParamType("", 0, param.name) when list is none
			let index = 0
			for let (_, c) in list.children() {
				continue unless c.kind() == SyntaxKind.TypeParam
				break when c.same(param.node)
				index++
			}
			// The owner's name stands right before its `<`.
			let ownerPath = ""
			let nameToken = list.prevSibling()
			if !(nameToken is none) {
				let owner = file.symbolAt(nameToken.start())
				ownerPath = owner.path unless owner is none
			}
			return table().typeParamType(ownerPath, index, param.name)
		}

		// bindingsOf maps the owner's type parameters to the arguments (by
		// position; Unknown for one left out).
		internal def bindingsOf(owner Symbol, args Type[]) map<int, Type> {
			let out map<int, Type>
			for let (i, name) in typeParamsOf(owner) {
				out[table().typeParamType(owner.path, i, name).id] = argOrUnknown(args, i)
			}
			return out
		}

		// lowerFuncType is the type `def(a int, b ...string) bool` spells.
		internal def lowerFuncType(file FileSymbols, node SyntaxNode, depth int) Type {
			let params Type[]
			let variadic = false
			let result = table().primitiveType("none")
			let seenParams = false
			for let (_, c) in node.children() {
				if c.kind() == SyntaxKind.Params {
					seenParams = true
					variadic = paramTypes(file, c, params, depth)
					continue
				}
				result = lowerType(file, c, depth + 1) when seenParams && isTypeNode(c.kind())
			}
			return table().funcType(params, result, variadic)
		}

		// paramTypes adds the type of each parameter of a parameter list (a
		// name list `a, b int` adds one per name; a parameter written with a
		// default value only takes the value's type); true when the last is
		// variadic.
		internal def paramTypes(file FileSymbols, params SyntaxNode, into Type[], depth int) bool {
			let variadic = false
			for let (_, p) in params.children() {
				continue unless p.kind() == SyntaxKind.Param
				let names = 0
				let written ?SyntaxNode = none
				let value ?SyntaxNode = none
				let seenAssign = false
				variadic = false
				for let (_, c) in p.children() {
					if c.isToken() {
						names++ when c.token() == TokenKind.Ident && written is none && !seenAssign
						variadic = true when c.token() == TokenKind.Ellipsis
						seenAssign = true when c.token() == TokenKind.Assign
						continue
					}
					if c.kind() == SyntaxKind.Destructure {
						names++
					} else if isTypeNode(c.kind()) && written is none && !seenAssign {
						written = c
					} else if c.kind() != SyntaxKind.Attribute && value is none {
						value = c
					}
				}
				let t = table().unknownType()
				if !(written is none) {
					t = lowerType(file, written, depth + 1)
				} else if !(value is none) {
					t = exprType(file, value, depth + 1)
				}
				// A variadic parameter keeps its element type, as the compiler's
				// function types do (`def(...string)`).
				let count = (names == 0) ?? (1, names)
				for let i = 0; i < count; i++ {
					into.push(t)
				}
			}
			return variadic
		}
	}
}
