partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// TypeRef is a type as it is written somewhere: the type node, the file
	// whose scopes and imports give its names their meaning, and what the
	// type parameters named in it stand for (`T` of `Box<T>` is `File` in
	// the type of `box.value` when `box` is a `Box<File>`). It is how a
	// declared type travels through a member chain without being resolved
	// before the end.
	struct TypeRef {
		file     FileSymbols
		node     SyntaxNode
		bindings map<string, TypeRef>
	}

	partial type Navigator {
		// typeRefOf is the written type of an expression: the declared type
		// of the name, member or call it ends with, the type of a `new`, a
		// cast or a typed struct literal, the element type of an index. None
		// for a literal or an expression whose type is not written anywhere.
		def typeRefOf(file FileSymbols, expr SyntaxNode) ?TypeRef {
			return typeRefOfDepth(file, expr, 0)
		}

		internal def typeRefOfDepth(file FileSymbols, expr SyntaxNode, depth int) ?TypeRef {
			return none when depth > maxDepth
			switch expr.kind() {
				case SyntaxKind.Name:
					let t = expr.firstToken()
					return none when t is none
					return symbolTypeRef(file, nameSymbol(file, t), depth)
				case SyntaxKind.Member:
					let target = memberTarget(file, expr, depth)
					return none when target is none
					return memberTypeRef(file, receiverRef(file, expr, depth), target)
				case SyntaxKind.Call:
					return callTypeRef(file, expr, depth)
				case SyntaxKind.New:
					for let (_, c) in expr.children() {
						return TypeRef{file: file, node: c, bindings: noBindings()} when isTypeNode(c.kind())
					}
					return contextRef(file, expr, depth + 1)
				case SyntaxKind.Cast:
					for let (_, c) in expr.children() {
						return TypeRef{file: file, node: c, bindings: noBindings()} when isTypeNode(c.kind())
					}
					return none
				case SyntaxKind.Paren, SyntaxKind.Try, SyntaxKind.Await:
					for let (_, c) in expr.children() {
						return typeRefOfDepth(file, c, depth + 1) unless c.isToken()
					}
					return none
				case SyntaxKind.Index:
					let kids = expr.children()
					return none when kids.len() == 0
					return elementRef(typeRefOfDepth(file, kids[0], depth + 1))
				case SyntaxKind.StructLit:
					return structLiteralRef(file, expr, depth)
				default:
					return none
			}
		}

		// receiverRef is the written type of a member expression's receiver,
		// none when the receiver is a type or a module rather than a value.
		internal def receiverRef(file FileSymbols, member SyntaxNode, depth int) ?TypeRef {
			let kids = member.children()
			return none when kids.len() == 0
			return typeRefOfDepth(file, kids[0], depth + 1)
		}

		// callTypeRef is the written return type of what a call calls, with
		// the receiver's type arguments when it is a method; the type for
		// `Type(value)`.
		internal def callTypeRef(file FileSymbols, call SyntaxNode, depth int) ?TypeRef {
			let kids = call.children()
			return none when kids.len() == 0
			let callee = kids[0]
			let fn = calleeSymbol(file, callee, depth)
			return none when fn is none
			return TypeRef{file: file, node: callee, bindings: noBindings()} when isTypeLike(fn.kind)
			return none unless fn.kind == SymbolKind.Function || fn.kind == SymbolKind.Method
			return memberTypeRef(file, receiverRef(file, callee, depth), fn) when callee.kind() == SyntaxKind.Member
			return memberTypeRef(file, none, fn)
		}

		// symbolTypeRef is the written type of a symbol's value: its declared
		// type, else its initializer's when it is an untyped local, else what
		// it ranges over when it is a loop variable. None for a type or a
		// module.
		internal def symbolTypeRef(file FileSymbols, symbol ?Symbol, depth int) ?TypeRef {
			return none when symbol is none
			return none when isTypeLike(symbol.kind) || symbol.kind == SymbolKind.Import
			let home = homeOf(symbol, file)
			let written = declaredType(symbol)
			return TypeRef{file: home, node: written, bindings: noBindings()} unless written is none
			// A view ref (`ScrollView(ref = port)`) holds the component the
			// call places.
			return viewRefType(home, symbol.node) when symbol.node.kind() == SyntaxKind.Arg
			return none unless symbol.kind == SymbolKind.Local || symbol.kind == SymbolKind.Const
			let init = initializerOf(symbol.node)
			return typeRefOfDepth(home, init, depth + 1) unless init is none
			return loopVariableRef(home, symbol, depth)
		}

		// viewRefType is the callee of the component call a `ref = name`
		// argument belongs to, as the type of the member it declares.
		internal def viewRefType(file FileSymbols, arg SyntaxNode) ?TypeRef {
			let args = arg.parent
			return none when args is none
			let call = args.parent
			return none when call is none
			let callee = call.child(0)
			return none when callee is none
			return none unless callee.kind() == SyntaxKind.Name || callee.kind() == SyntaxKind.Member
			return TypeRef{file: file, node: callee, bindings: noBindings()}
		}

		// memberTypeRef is the written type of a member read on a receiver
		// of the given type: the member's declared type, with the receiver's
		// type arguments standing for the owner's type parameters.
		internal def memberTypeRef(file FileSymbols, receiver ?TypeRef, member Symbol) ?TypeRef {
			let written = declaredType(member)
			return none when written is none
			let home = homeOf(member, file)
			return TypeRef{file: home, node: written, bindings: noBindings()} when receiver is none
			return TypeRef{file: home, node: written, bindings: bindingsFor(receiver, member.parent)}
		}

		// bindingsFor pairs the owner's type parameters with the receiver's
		// type arguments: `Box<File>` binds `T` to `File`.
		internal def bindingsFor(receiver TypeRef, owner ?Symbol) map<string, TypeRef> {
			let out map<string, TypeRef>
			return out when owner is none
			let params = typeParamsOf(owner)
			return out when params.len() == 0
			let actual = followBindings(receiver)
			let args = typeArgsOf(actual.node)
			for let (i, name) in params {
				break when i >= args.len()
				out[name] = TypeRef{file: actual.file, node: args[i], bindings: actual.bindings}
			}
			return out
		}

		// typeParamsOf is the names of a declaration's type parameters, from
		// the part that declares them.
		internal def typeParamsOf(owner Symbol) string[] {
			let out string[]
			let params = childOfKind(owner.node, SyntaxKind.TypeParams)
			if params is none {
				for let (_, part) in partsOf(owner) {
					params = childOfKind(part.node, SyntaxKind.TypeParams)
					break unless params is none
				}
			}
			return out when params is none
			for let (_, p) in params.children() {
				continue unless p.kind() == SyntaxKind.TypeParam
				let t = p.firstToken()
				out.push(t.text()) unless t is none
			}
			return out
		}

		// typeArgsOf is the type nodes between `<` and `>` of a named type,
		// empty when it has none.
		internal def typeArgsOf(typeNode SyntaxNode) SyntaxNode[] {
			let out SyntaxNode[]
			let args = childOfKind(typeNode, SyntaxKind.TypeArgs)
			return out when args is none
			for let (_, c) in args.children() {
				out.push(c) unless c.isToken()
			}
			return out
		}

		// followBindings is the type a reference stands for once its type
		// parameters are replaced and its `?`, `!` and `async` modifiers
		// taken off: `?T` with `T` bound to `File` is `File`.
		internal def followBindings(ref TypeRef) TypeRef {
			let current = ref
			for let i = 0; i < 16; i++ {
				let node = current.node
				if node.kind() == SyntaxKind.ModifiedType {
					let inner = firstNonToken(node)
					return current when inner is none
					current = TypeRef{file: current.file, node: inner, bindings: current.bindings}
					continue
				}
				return current unless node.kind() == SyntaxKind.NamedType && node.childCount() == 1
				let t = node.firstToken()
				return current when t is none
				return current unless current.bindings.hasKey(t.text())
				current = current.bindings[t.text()]
			}
			return current
		}

		// typeRefSymbol is the type declaration a reference leads to.
		def typeRefSymbol(ref ?TypeRef) ?Symbol {
			return none when ref is none
			let actual = followBindings(ref)
			switch actual.node.kind() {
				case SyntaxKind.Name:
					let t = actual.node.firstToken()
					return none when t is none
					let sym = nameSymbol(actual.file, t)
					return none when sym is none
					return sym when isTypeLike(sym.kind)
					return none
				case SyntaxKind.Member:
					let sym = memberTarget(actual.file, actual.node, 0)
					return none when sym is none
					return sym when isTypeLike(sym.kind)
					return none
				default:
					return typeSymbol(actual.file, actual.node)
			}
		}

		// elementRef is the written type of an element of a container: the
		// element type of `T[]`, the value type of a `map<K, V>` or a
		// `channel<T>`; none for another type.
		internal def elementRef(container ?TypeRef) ?TypeRef {
			return none when container is none
			let actual = followBindings(container)
			let node = actual.node
			if node.kind() == SyntaxKind.ArrayType {
				let element = elementType(node)
				return none when element is none
				return TypeRef{file: actual.file, node: element, bindings: actual.bindings}
			}
			return none unless node.kind() == SyntaxKind.NamedType
			let args = typeArgsOf(node)
			let name = builtinName(actual)
			return TypeRef{file: actual.file, node: args[1], bindings: actual.bindings} when name == "map" && args.len() > 1
			return TypeRef{file: actual.file, node: args[0], bindings: actual.bindings} when name == "channel" && args.len() > 0
			return none
		}

		// keyRef is the written key type of a `map<K, V>`, none for another
		// type.
		internal def keyRef(container TypeRef) ?TypeRef {
			let actual = followBindings(container)
			return none unless actual.node.kind() == SyntaxKind.NamedType
			let args = typeArgsOf(actual.node)
			return none unless builtinName(actual) == "map" && args.len() > 0
			return TypeRef{file: actual.file, node: args[0], bindings: actual.bindings}
		}

		// builtinName is the name of the prelude type a reference leads to,
		// "" when it leads elsewhere.
		internal def builtinName(ref TypeRef) string {
			let sym = typeSymbol(ref.file, ref.node)
			return "" when sym is none
			return "" unless sym.path.startsWith("builtin.")
			return sym.name
		}

		// nameSymbol is what a name token refers to: its declaration (in a
		// style body, a property of an embedded style first: `styleName`),
		// else the prelude type of a primitive type name (`int(x)` casts to
		// `Number`).
		internal def nameSymbol(file FileSymbols, token SyntaxNode) ?Symbol {
			// `self` is the enclosing type.
			return workspace.enclosingType(file, token.start()) when token.token() == TokenKind.Self
			let property = styleName(file, token)
			return property unless property is none
			let found = first(workspace.resolve(file, token.text(), token.start()))
			return found unless found is none
			return primitiveSymbol(token.text())
		}

		// primitiveSymbol is the prelude type declaring a primitive's
		// members, none for another name.
		internal def primitiveSymbol(name string) ?Symbol {
			let primitive = primitiveTypeName(name)
			return none when primitive.len() == 0
			return first(workspace.lookup("builtin", primitive))
		}

		internal def noBindings() map<string, TypeRef> {
			let out map<string, TypeRef>
			return out
		}
	}

	// childOfKind is the first direct child of the node with the kind. The
	// children are looked at by kind: only the one returned is made a node.
	internal def childOfKind(n SyntaxNode, kind SyntaxKind) ?SyntaxNode {
		let count = n.childCount()
		for let i = 0; i < count; i++ {
			return n.child(i) when n.childKind(i) == kind
		}
		return none
	}

	// firstNonToken is the first direct child of the node that is not a
	// token.
	internal def firstNonToken(n SyntaxNode) ?SyntaxNode {
		let count = n.childCount()
		for let i = 0; i < count; i++ {
			return n.child(i) unless n.childKind(i) == SyntaxKind.Token
		}
		return none
	}
}
