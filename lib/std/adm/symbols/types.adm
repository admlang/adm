partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	// Navigator answers what the IDE asks about names and members from
	// declared types alone: the type a declaration is written with, the
	// return type of a call, the module an import binds. It infers nothing
	// beyond that: an untyped local takes the type of its initializer when
	// that is itself declared, and a name that leads nowhere resolves to
	// nothing rather than a guess.
	partial type Navigator {
		workspace                   Workspace
		// The members of each declared type by name (`membersNamed`), while
		// the workspace is at `memberIndexVersion`.
		internal memberIndexes      map<string, map<string, Symbol[]>>
		internal memberIndexVersion int                                = -1

		def new(workspace Workspace) {
			self.workspace = workspace
		}

		// declaredType is the type node a declaration is written with: a
		// field's, parameter's or local's type, a function's return type,
		// a property's type; none when it is not written.
		def declaredType(symbol Symbol) ?SyntaxNode {
			let n = symbol.node
			switch symbol.kind {
				case SymbolKind.Function, SymbolKind.Method:
					return returnTypeOf(n)
				case SymbolKind.Type, SymbolKind.Struct, SymbolKind.Enum, SymbolKind.Union, SymbolKind.Interface, SymbolKind.Datatype, SymbolKind.Service, SymbolKind.Component, SymbolKind.Style, SymbolKind.Module, SymbolKind.Import:
					return none
				default:
					return writtenTypeOf(n)
			}
		}

		// writtenTypeOf is the first type node among the direct children
		// of a field, parameter or property node.
		internal def writtenTypeOf(n SyntaxNode) ?SyntaxNode {
			for let (i, c) in n.green.children {
				return n.child(i) when isTypeNode(c.kind)
				break when c.isToken() && c.token == TokenKind.Assign
			}
			return none
		}

		// returnTypeOf is the type node after a function's parameters.
		internal def returnTypeOf(n SyntaxNode) ?SyntaxNode {
			let seenParams = false
			for let (_, c) in n.children() {
				if seenParams {
					return c when isTypeNode(c.kind())
					return none unless c.isToken()
					continue
				}
				seenParams = true when c.kind() == SyntaxKind.Params
			}
			return none
		}

		// typeSymbol is the declaration a type node names, through `?`, `!`,
		// `async` and `[]`: `?File` and `File[]` both lead to File (arrays to
		// the prelude's `array`), `map<K, V>` to the prelude's `map`.
		def typeSymbol(file FileSymbols, typeNode SyntaxNode) ?Symbol {
			switch typeNode.kind() {
				case SyntaxKind.ModifiedType:
					for let (_, c) in typeNode.children() {
						return typeSymbol(file, c) unless c.isToken()
					}
					return none
				case SyntaxKind.ArrayType:
					return first(workspace.lookup("builtin", "array"))
				case SyntaxKind.NamedType, SyntaxKind.Name:
					return namedTypeSymbol(file, typeNode)
				default:
					return none
			}
		}

		// elementType is the type node of an array type's elements, none
		// for another type.
		def elementType(typeNode SyntaxNode) ?SyntaxNode {
			return none unless typeNode.kind() == SyntaxKind.ArrayType
			for let (_, c) in typeNode.children() {
				return c unless c.isToken()
			}
			return none
		}

		internal def namedTypeSymbol(file FileSymbols, typeNode SyntaxNode) ?Symbol {
			let kids = typeNode.children()
			return none when kids.len() == 0
			let head = kids[0]
			if head.kind() == SyntaxKind.QualifiedName {
				// `http.Response`: the module an import binds, then its declaration.
				let parts = head.tokens()
				let names string[]
				for let (_, t) in parts {
					names.push(t.text()) when t.token() != TokenKind.Dot
				}
				return none when names.len() == 0
				let found = workspace.resolveType(file, names[0], head.start())
				let current = first(found)
				for let i = 1; i < names.len(); i++ {
					return none when current is none
					current = first(workspace.memberOf(current, names[i]))
				}
				return current
			}
			return none unless head.isToken()
			let name = head.text()
			let primitive = primitiveTypeName(name)
			return first(workspace.lookup("builtin", primitive)) when primitive.len() > 0
			let found = workspace.resolveType(file, name, head.start())
			return followAlias(file, typeDeclaration(found), 0)
		}

		// followAlias is the declaration a type alias stands for (`type
		// Border = canvas.Border` leads to canvas's Border), resolved in the
		// alias's own file; the symbol itself when it is no alias or its
		// target is no single type (a union, a dimension expression).
		internal def followAlias(file FileSymbols, symbol ?Symbol, depth int) ?Symbol {
			return none when symbol is none
			return symbol when depth > 4 || symbol.kind != SymbolKind.Type
			let target = aliasTarget(symbol.node)
			return symbol when target is none
			return symbol unless target.kind() == SyntaxKind.NamedType
			let found = typeSymbol(homeOf(symbol, file), target)
			return symbol when found is none
			return followAlias(file, found, depth + 1)
		}

		// aliasTarget is the type node after `=` in `type X = T`, none for a
		// type with a body or without a target.
		internal def aliasTarget(decl SyntaxNode) ?SyntaxNode {
			let seen = false
			for let (_, c) in decl.children() {
				return c when seen && isTypeNode(c.kind())
				return none when seen && !c.isToken()
				seen = true when c.isToken() && c.token() == TokenKind.Assign
			}
			return none
		}

		// typeDeclaration is the first type-like declaration among symbols,
		// else the type parameter among them (`T` in `def first() ?T`).
		internal def typeDeclaration(found Symbol[]) ?Symbol {
			for let (_, s) in found {
				return s when isTypeLike(s.kind)
			}
			for let (_, s) in found {
				return s when s.kind == SymbolKind.TypeParameter
			}
			return none
		}

		// typeOf is the type declaration of an expression, when declared
		// types say it: a name's declared type, a member's, a call's return
		// type, `new T`, a literal's prelude type, a cast's type, an element
		// of a container, a loop variable's element type. A type parameter is
		// followed to the type argument the receiver was declared with.
		def typeOf(file FileSymbols, expr SyntaxNode) ?Symbol {
			return typeOfDepth(file, expr, 0)
		}

		internal def typeOfDepth(file FileSymbols, expr SyntaxNode, depth int) ?Symbol {
			return none when depth > maxDepth
			switch expr.kind() {
				case SyntaxKind.Name, SyntaxKind.Member:
					let sym = symbolOfDepth(file, expr, depth)
					return none when sym is none
					// A type or a module named as a value is itself; `Color.Red` is a Color.
					return sym when isTypeLike(sym.kind) || sym.kind == SymbolKind.Import
					return sym.parent when sym.kind == SymbolKind.EnumMember || sym.kind == SymbolKind.UnionMember
					let ref = typeRefOfDepth(file, expr, depth)
					return typeRefSymbol(ref) unless ref is none
					return valueType(file, sym, depth)
				case SyntaxKind.Call:
					let callee = expr.child(0)
					return none when callee is none
					let fn = calleeSymbol(file, callee, depth)
					return none when fn is none
					// `Type(value)` and `int(value)` are casts to that type.
					return fn when isTypeLike(fn.kind)
					return typeRefSymbol(callTypeRef(file, expr, depth))
				case SyntaxKind.Literal, SyntaxKind.InterpString:
					return literalType(expr)
				case SyntaxKind.Index:
					let ref = typeRefOfDepth(file, expr, depth)
					return typeRefSymbol(ref) unless ref is none
					// A character of a string.
					let container = expr.child(0)
					return none when container is none
					let containerType = typeOfDepth(file, container, depth + 1)
					return none when containerType is none
					return first(workspace.lookup("builtin", "char")) when containerType.path == "builtin.string"
					return none
				default:
					return typeRefSymbol(typeRefOfDepth(file, expr, depth))
			}
		}

		// symbolOf is the declaration a name or member expression refers to.
		def symbolOf(file FileSymbols, expr SyntaxNode) ?Symbol {
			return symbolOfDepth(file, expr, 0)
		}

		internal def symbolOfDepth(file FileSymbols, expr SyntaxNode, depth int) ?Symbol {
			switch expr.kind() {
				case SyntaxKind.Name:
					let t = expr.firstToken()
					return none when t is none
					return nameSymbol(file, t)
				case SyntaxKind.Member:
					return memberTarget(file, expr, depth)
				default:
					return none
			}
		}

		// memberTarget is the declaration `receiver.name` refers to.
		internal def memberTarget(file FileSymbols, member SyntaxNode, depth int) ?Symbol {
			return first(memberTargets(file, member, depth))
		}

		// memberTargets is every declaration `receiver.name` may refer to:
		// the overloads of a member of the receiver's type, or of the
		// module or type the receiver names.
		internal def memberTargets(file FileSymbols, member SyntaxNode, depth int) Symbol[] {
			let kids = member.children()
			return [] when kids.len() < 3
			let receiver = kids[0]
			let nameToken = kids[kids.len() - 1]
			return [] unless nameToken.isToken()
			let name = nameToken.text()
			let owner = symbolOfDepth(file, receiver, depth + 1)
			if !(owner is none) {
				// A module import or a type name: its declarations directly
				// (an alias stands for its target: `LineStyle.None`).
				return workspace.memberOf(owner, name) when owner.kind == SymbolKind.Import
				if isTypeLike(owner.kind) {
					let actual = followAlias(file, owner, 0)
					return [] when actual is none
					return membersNamed(file, actual, name)
				}
			}
			let receiverType = typeOfDepth(file, receiver, depth + 1)
			return [] when receiverType is none
			return membersNamed(file, receiverType, name)
		}

		// calleeSymbol is the function, method or type a call's callee
		// names: among overloads, the first whose parameters take the call's
		// arguments (as many positional ones as parameters without a
		// default allow, every named one declared), else the first.
		internal def calleeSymbol(file FileSymbols, callee SyntaxNode, depth int) ?Symbol {
			let found = symbolOfDepth(file, callee, depth + 1)
			// A called name whose nearest meaning is a value that is no
			// function calls the function of the name further out.
			if callee.kind() == SyntaxKind.Name && (found is none || !isCallableKind(found.kind)) {
				let past = first(calleeOverloads(file, callee))
				found = past when !(past is none) && isCallableKind(past.kind)
			}
			return none when found is none
			return found unless found.kind == SymbolKind.Function || found.kind == SymbolKind.Method
			let call = callee.parent
			return found when call is none
			return found unless call.kind() == SyntaxKind.Call
			let overloads = calleeOverloads(file, callee)
			return found when overloads.len() < 2
			// Among the overloads that take the arguments, the one whose
			// parameter types agree with the most argument types (a type
			// this layer cannot tell is neutral, a known mismatch rules out).
			let best ?Symbol = none
			let bestScore = -1
			let firstAccepting ?Symbol = none
			for let (_, fn) in overloads {
				continue unless fn.kind == SymbolKind.Function || fn.kind == SymbolKind.Method
				continue unless acceptsArguments(fn, call)
				firstAccepting = fn when firstAccepting is none
				let score = argumentTypeScore(file, fn, call, depth)
				continue when score < 0 || score <= bestScore
				best = fn
				bestScore = score
			}
			return best unless best is none
			// Every accepting overload disagrees with a known argument type:
			// the arity still rules out the others.
			return firstAccepting unless firstAccepting is none
			return found
		}

		// argumentTypeScore counts the positional arguments whose type is
		// the parameter's declared type; -1 when one is known to differ.
		internal def argumentTypeScore(file FileSymbols, fn Symbol, call SyntaxNode, depth int) int {
			let args = childOfKind(call, SyntaxKind.Args)
			return 0 when args is none
			let params = parameterNames(fn.node)
			let home = homeOf(fn, file)
			let score = 0
			let i = 0
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				let head = arg.child(0)
				continue when head is none
				break when isNamedArgumentName(head)
				break when i >= params.len()
				let wanted = typeRefSymbol(parameterType(home, params[i]))
				i++
				continue when wanted is none
				continue when wanted.kind == SymbolKind.TypeParameter
				// An argument typed by its place (`{x: 1}`, `[]`, a lambda) takes
				// its type from the overload being chosen: scoring it would choose
				// again, once per overload and argument at every level.
				continue when typedByPlace(head)
				let given = typeOfDepth(file, head, depth + 1)
				continue when given is none
				if sameDeclaration(given, wanted) {
					score++
				} else {
					return -1
				}
			}
			return score
		}

		// typedByPlace is true for an expression whose type comes from where
		// it stands: a struct or map literal or an array literal written
		// without its type, a lambda.
		internal def typedByPlace(expr SyntaxNode) bool {
			switch expr.kind() {
				case SyntaxKind.StructLit:
					let head = expr.child(0)
					return head is none || !isTypeNode(head.kind())
				case SyntaxKind.ArrayLit:
					// `T[a, b]` says its own type.
					return typedArrayElement(expr) is none
				case SyntaxKind.Lambda:
					return true
				default:
					return false
			}
		}

		// typedArrayElement is the element type an array literal is written
		// with (`T` of `T[a, b]`), none for one without.
		internal def typedArrayElement(literal SyntaxNode) ?SyntaxNode {
			let head = literal.child(0)
			return none when head is none || !isTypeNode(head.kind())
			return head
		}

		// acceptsArguments is true when the function's parameters take the
		// call's arguments: the positional ones fill the first parameters
		// (a variadic takes any number, and then no named one), the rest
		// have defaults or are named, and every named one is a parameter
		// no other argument fills.
		internal def acceptsArguments(fn Symbol, call SyntaxNode) bool {
			let args = childOfKind(call, SyntaxKind.Args)
			return true when args is none
			let positional = 0
			let named string[]
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				let head = arg.child(0)
				continue when head is none
				if isNamedArgumentName(head) {
					named.push(head.text())
				} else {
					positional++
				}
			}
			let shape = paramShape(fn.node)
			let params = shape.names
			return false when positional > params.len() && !shape.variadic
			// A variadic function takes no named arguments, and a parameter
			// takes one value (the checker's `matchCallWithGenerics`).
			return false when shape.variadic && named.len() > 0
			for let (i, n) in named {
				let at = params.indexOf(n)
				return false when at < 0 || at < positional
				for let k = 0; k < i; k++ {
					return false when named[k] == n
				}
			}
			for let (i, p) in params {
				continue when i < positional || shape.defaulted[i] || p in named
				return false
			}
			return true
		}

		// hasDefault is true for a parameter name token whose parameter has
		// a default value or is the variadic one.
		internal def hasDefault(nameToken SyntaxNode) bool {
			let param = nameToken.parent
			return false when param is none
			for let (_, c) in param.children() {
				return true when c.isToken() && (c.token() == TokenKind.Assign || c.token() == TokenKind.Ellipsis)
			}
			return false
		}

		// typeSymbolOf is the type declaration of a symbol's value: its
		// declared type, or its initializer's when it is an untyped local.
		def typeSymbolOf(file FileSymbols, symbol Symbol) ?Symbol {
			return symbolType(file, symbol, 0)
		}

		// symbolType is the type declaration of a symbol's value: its
		// written type, else the type of the initializer of an untyped local,
		// else what a loop variable ranges over; the symbol itself for a type
		// or an import.
		internal def symbolType(file FileSymbols, symbol ?Symbol, depth int) ?Symbol {
			return none when symbol is none
			return symbol when isTypeLike(symbol.kind) || symbol.kind == SymbolKind.Import
			// `Color.Red` is a Color.
			return symbol.parent when symbol.kind == SymbolKind.EnumMember || symbol.kind == SymbolKind.UnionMember
			let ref = symbolTypeRef(file, symbol, depth)
			return typeRefSymbol(ref) unless ref is none
			return valueType(file, symbol, depth)
		}

		// valueType is the type of a symbol's value when no written type
		// leads to it: the type of an untyped local's initializer (a literal,
		// an enum member), else what a loop variable ranges over.
		internal def valueType(file FileSymbols, symbol Symbol, depth int) ?Symbol {
			let home = homeOf(symbol, file)
			if symbol.kind == SymbolKind.Local || symbol.kind == SymbolKind.Const {
				let init = initializerOf(symbol.node)
				return typeOfDepth(home, init, depth + 1) unless init is none
			}
			return loopVariableType(home, symbol, depth)
		}

		// initializerOf is the expression after `=` in a field declaration.
		internal def initializerOf(field SyntaxNode) ?SyntaxNode {
			let seen = false
			for let (_, c) in field.children() {
				return c when seen && !c.isToken()
				seen = true when c.isToken() && isAssignmentToken(c.token())
			}
			return none
		}

		// literalType is the prelude type of a literal token.
		internal def literalType(expr SyntaxNode) ?Symbol {
			return first(workspace.lookup("builtin", "string")) when expr.kind() == SyntaxKind.InterpString
			let t = expr.firstToken()
			return none when t is none
			let name = ""
			switch t.token() {
				case TokenKind.String:
					name = "string"
				case TokenKind.Char:
					name = "char"
				case TokenKind.Integer, TokenKind.Float, TokenKind.Imaginary:
					name = "Number"
				case TokenKind.Bool:
					name = "bool"
				case TokenKind.Duration:
					name = "duration"
				case TokenKind.Regex:
					name = "regex"
				default:
					return none
			}
			return first(workspace.lookup("builtin", name))
		}

		// members is every member of a type-like declaration, the members
		// of its embedded types and interfaces included.
		def members(file FileSymbols, owner Symbol) Symbol[] {
			let out Symbol[]
			for let (_, m) in owner.members {
				out.push(m)
			}
			for let (_, part) in partsOf(owner) {
				for let (_, m) in part.members {
					out.push(m) unless part == owner
				}
			}
			for let (_, embedded) in embeddedTypes(file, owner) {
				for let (_, m) in embedded.members {
					out.push(m)
				}
			}
			// A component declared with a named controller (`type Counting`
			// in its body) has that type's members.
			if owner.kind == SymbolKind.Component {
				let controller = controllerType(file, owner)
				if !(controller is none) {
					for let (_, m) in members(file, controller) {
						out.push(m)
					}
				}
			}
			// Every enum, component and service has the members of its
			// prelude base (`Enum`, `Component<T>`, `Service`).
			let baseName = builtinBaseName(owner.kind)
			if baseName.len() > 0 {
				for let (_, base) in workspace.lookup("builtin", baseName) {
					for let (_, m) in base.members {
						out.push(m)
					}
				}
			}
			return out
		}

		// membersNamed is every member of the owner named `name`.
		def membersNamed(file FileSymbols, owner Symbol, name string) Symbol[] {
			// A declared owner's members by name are kept until the workspace
			// changes: a type's member list is built once, not per lookup.
			if owner.path.len() > 0 {
				if memberIndexVersion != workspace.version {
					let fresh map<string, map<string, Symbol[]>>
					memberIndexes = fresh
					memberIndexVersion = workspace.version
				}
				let key = owner.kind.value + " " + owner.path
				let index = memberIndexes.get(key)
				if index is none {
					let built map<string, Symbol[]>
					for let (_, m) in members(file, owner) {
						if built.hasKey(m.name) {
							built[m.name].push(m)
						} else {
							built[m.name] = [m]
						}
					}
					memberIndexes[key] = built
					return copyOf(built.get(name))
				}
				return copyOf(index.get(name))
			}
			let out Symbol[]
			for let (_, m) in members(file, owner) {
				out.push(m) when m.name == name
			}
			return out
		}

		// copyOf is a list of its own of the symbols, empty for none: what a
		// cache holds is never handed out to be changed.
		internal def copyOf(found ?Symbol[]) Symbol[] {
			let out Symbol[]
			return out when found is none
			for let (_, s) in found {
				out.push(s)
			}
			return out
		}

		// partsOf is every part of a partial type across the workspace's
		// files: the declarations with the owner's path and kind.
		internal def partsOf(owner Symbol) Symbol[] {
			let out Symbol[]
			let dot = owner.path.lastIndexOf(".")
			return out when dot < 0
			let moduleName = owner.path[:dot]
			for let (_, s) in workspace.lookup(moduleName, owner.name) {
				out.push(s) when s.kind == owner.kind
			}
			return out
		}

		// controllerType is the named type a component's body refers to with
		// `type Name` (no body of its own), resolved in the component's file;
		// none for an inline or absent controller.
		internal def controllerType(asking FileSymbols, owner Symbol) ?Symbol {
			let body = childOfKind(owner.node, SyntaxKind.Body)
			return none when body is none
			let file = homeOf(owner, asking)
			for let (_, c) in body.children() {
				continue unless c.kind() == SyntaxKind.TypeDecl
				continue unless childOfKind(c, SyntaxKind.Body) is none
				// The name is a QualifiedName (`type Counting`, `type ui.Counting`)
				// or a bare token.
				for let (_, t) in c.children() {
					continue when t.isToken() && t.token() == TokenKind.Type
					let found ?Symbol = none
					if t.kind() == SyntaxKind.QualifiedName {
						found = qualifiedSymbol(file, t.tokens())
					} else if t.isToken() && isNameToken(t.token()) {
						found = followAlias(file, typeDeclaration(workspace.resolve(file, t.text(), t.start())), 0)
					}
					return none when found is none
					return none when found.kind == SymbolKind.Component
					return found
				}
				return none
			}
			return none
		}

		// embeddedTypes is the declarations the owner's body embeds, resolved
		// in the file that declares the owner.
		internal def embeddedTypes(asking FileSymbols, owner Symbol) Symbol[] {
			let out Symbol[]
			let file = homeOf(owner, asking)
			let body = childOfKind(owner.node, SyntaxKind.Body)
			return out when body is none
			// Embeddings are direct entries of the body: an Embedding node (a
			// type node, a qualified name, or a bare name token in an
			// interface), or in a datatype a Field spelled as a dotted name.
			for let (_, c) in body.children() {
				if c.kind() == SyntaxKind.Embedding {
					for let (_, t) in c.children() {
						let found = embeddedSymbol(file, t)
						out.push(found) unless found is none
					}
					continue
				}
				continue unless c.kind() == SyntaxKind.Field && isDottedName(c)
				let found = qualifiedSymbol(file, c.tokens())
				out.push(found) unless found is none
			}
			return out
		}

		// embeddedSymbol is the declaration one element of an Embedding
		// names: a type node, a qualified name or a bare name.
		internal def embeddedSymbol(file FileSymbols, t SyntaxNode) ?Symbol {
			return typeSymbol(file, t) when isTypeNode(t.kind())
			return qualifiedSymbol(file, t.tokens()) when t.kind() == SyntaxKind.QualifiedName
			return none unless t.isToken() && isNameToken(t.token())
			return followAlias(file, typeDeclaration(workspace.resolve(file, t.text(), t.start())), 0)
		}

		// qualifiedSymbol is the declaration a dotted name's tokens lead to:
		// the import or declaration for the first, a member for each next.
		internal def qualifiedSymbol(file FileSymbols, tokens SyntaxNode[]) ?Symbol {
			let names SyntaxNode[]
			for let (_, t) in tokens {
				names.push(t) when t.token() != TokenKind.Dot
			}
			return none when names.len() == 0
			let current = first(workspace.resolve(file, names[0].text(), names[0].start()))
			for let i = 1; i < names.len(); i++ {
				return none when current is none
				current = first(workspace.memberOf(current, names[i].text()))
			}
			return none when current is none
			return followAlias(file, current, 0) when isTypeLike(current.kind)
			return none
		}

		// isDottedName is true for a Field whose tokens are names and dots
		// only: `other.Shape` embedded in a datatype.
		internal def isDottedName(field SyntaxNode) bool {
			let names = 0
			let dots = 0
			for let (_, c) in field.children() {
				return false unless c.isToken()
				if c.token() == TokenKind.Dot {
					dots++
				} else if isNameToken(c.token()) {
					names++
				} else {
					return false
				}
			}
			return dots > 0 && names == dots + 1
		}

		// signature is the declaration's heading for a hover: its text up
		// to its body or its value, annotations and doc comment left out.
		def signature(symbol Symbol) string {
			let node = symbol.node
			let full = node.fullText()
			let from = node.green.leadingWidth()
			let to = full.len() - node.green.trailingWidth()
			for let (_, c) in node.children() {
				if c.kind() == SyntaxKind.Attribute {
					from = c.fullEnd() - node.fullStart()
					continue
				}
				if c.kind() == SyntaxKind.Block || c.kind() == SyntaxKind.Body || c.kind() == SyntaxKind.RawBlock || (c.isToken() && isAssignmentToken(c.token())) {
					to = c.fullStart() - node.fullStart()
					break
				}
			}
			return full[from:to].trim()
		}

		// homeOf is the file that declares the symbol, `fallback` when the
		// workspace does not hold it.
		internal def homeOf(symbol Symbol, fallback FileSymbols) FileSymbols {
			let home = workspace.file(symbol.file)
			return fallback when home is none
			return home
		}

		internal def first(found Symbol[]) ?Symbol {
			return none when found.len() == 0
			return found[0]
		}
	}

	// maxDepth bounds the recursion through initializers, calls and
	// member chains: a guard against a cycle (`let a = b.x; let b = a.y`),
	// generous enough for any chain real code writes, since every hop
	// (an index, a call, a receiver, an initializer) costs one.
	internal const maxDepth = 48

	// primitiveTypeName is the prelude type that declares the members of a
	// primitive: `Number` for the integers and floats (`@builtin(for =
	// Numeric)`), `ComplexNumber` for the complex kinds (`for = Complex`),
	// the type of the same name for `bigint`, `string`, `char`, `duration`
	// and `regex` (`@builtin(primitive = ...)`); "" for another name.
	def primitiveTypeName(name string) string {
		switch name {
			case "int", "int8", "int16", "int32", "int64", "int128", "uint", "uint8", "uint16", "uint32", "uint64", "uint128", "byte", "float", "float16", "float32", "float64", "float128":
				return "Number"
			case "complex32", "complex64", "complex128":
				return "ComplexNumber"
			case "bigint", "string", "char", "duration", "regex":
				return name
			default:
				return ""
		}
	}

	// isNumberName is true for the name of a numeric primitive: an
	// integer, a float, a complex kind, `bigint`.
	internal def isNumberName(name string) bool {
		let owner = primitiveTypeName(name)
		return owner == "Number" || owner == "ComplexNumber" || name == "bigint"
	}

	// builtinBaseName is the prelude type whose members every declaration
	// of the kind has: `Enum` for enums, `Component` for components,
	// `Service` for services; "" for the other kinds.
	def builtinBaseName(kind SymbolKind) string {
		switch kind {
			case SymbolKind.Enum:
				return "Enum"
			case SymbolKind.Component:
				return "Component"
			case SymbolKind.Service:
				return "Service"
			default:
				return ""
		}
	}

	// isCallableKind is true for what a call may call by name: a function,
	// a method, a type (its constructor or a conversion).
	internal def isCallableKind(kind SymbolKind) bool {
		return kind == SymbolKind.Function || kind == SymbolKind.Method || isTypeLike(kind)
	}

	// isTypeLike is true for a declaration whose members a value has (a
	// named style's are its `let`s, the keys of a `Box{width: ...}`).
	def isTypeLike(kind SymbolKind) bool {
		switch kind {
			case SymbolKind.Type, SymbolKind.Struct, SymbolKind.Enum, SymbolKind.Union, SymbolKind.Interface, SymbolKind.Datatype, SymbolKind.Service, SymbolKind.Component, SymbolKind.Style:
				return true
			default:
				return false
		}
	}

	// isTypeNode is true for a syntax node that spells a type.
	def isTypeNode(kind SyntaxKind) bool {
		switch kind {
			case SyntaxKind.NamedType, SyntaxKind.ArrayType, SyntaxKind.ModifiedType, SyntaxKind.TupleType, SyntaxKind.FuncType, SyntaxKind.UnionType, SyntaxKind.IntersectionType, SyntaxKind.InlineStruct, SyntaxKind.DimensionType:
				return true
			default:
				return false
		}
	}

	internal def isAssignmentToken(k TokenKind) bool {
		return k == TokenKind.Assign
	}
}
