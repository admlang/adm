partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// The types of the expressions one query has typed, by node: a
		// chain or a nested call is typed once however often its parts are
		// asked for.
		internal exprTypes         map<SyntaxNode, Type>
		// The declarations of the named types met while the workspace is at
		// `declaredVersion`, by type id: emptied when it changes, so a
		// replaced file's symbols are neither answered nor kept alive.
		internal namedDeclarations map<int, Symbol>
		internal declaredVersion   int                         = -1
		// `ownerOf`'s answers by type id while the workspace is at
		// `declaredVersion`: the declarations found, and the types without.
		internal owners            map<int, Symbol>
		internal ownerless         map<int, bool>
		// The function each call calls, by node, for one query
		// (`callTarget`); the calls of none in `untargeted`.
		internal callTargets       map<SyntaxNode, CallTarget>
		internal untargeted        map<SyntaxNode, bool>

		// typeAt is the type of what the token at the offset names: a
		// declaration's own name (the type it is written with, or the one its
		// initializer gives it), a name, a member, a literal. Unknown when
		// this layer cannot tell.
		def typeAt(file FileSymbols, offset int) Type {
			freshQuery()
			let declared = file.symbolAt(offset)
			return valueTypeOf(file, declared, 0) unless declared is none
			let token = file.tree.find(offset)
			return table().unknownType() when token is none
			let expr = expressionAt(token)
			return table().unknownType() when expr is none
			return exprType(file, expr, 0)
		}

		// freshQuery forgets what the last query typed: a query's answers
		// hold for the tree it was asked of.
		internal def freshQuery() {
			let types map<SyntaxNode, Type>
			exprTypes = types
			let targets map<SyntaxNode, CallTarget>
			callTargets = targets
			let untargetedCalls map<SyntaxNode, bool>
			untargeted = untargetedCalls
			let yielding map<SyntaxNode, bool>
			generators = yielding
		}

		// expressionAt is the expression a token ends: its name, the member
		// it is the name of, its literal; none for punctuation and keywords
		// of a statement.
		internal def expressionAt(token SyntaxNode) ?SyntaxNode {
			let p = token.parent
			return none when p is none
			switch p.kind() {
				case SyntaxKind.Name, SyntaxKind.Literal, SyntaxKind.InterpString:
					return p
				case SyntaxKind.Member:
					let last = p.lastToken()
					return p when !(last is none) && last.start() == token.start()
					return none
				default:
					return none
			}
		}

		// exprType is the type of an expression, from declared types: a
		// name's, a member's, a call's result, `new T`, a cast, `try` and
		// `await` taking their wrapper off, an element or a slice, a typed
		// struct literal, a literal.
		internal def exprType(file FileSymbols, expr SyntaxNode, depth int) Type {
			let known = exprTypes.get(expr)
			return known unless known is none
			let t = computeExprType(file, expr, depth)
			// A handler on the expression (`f() onerror recover x`, `await job
			// onerror { ... }`) answers the error: its value is what succeeds.
			t = handled(t) when endsInHandler(expr)
			exprTypes[expr] = t
			return t
		}

		// endsInHandler is true for an expression that ends in an `onerror`
		// handler, read off the kinds of its last children: a table's
		// thousands of elements are not looked at.
		internal def endsInHandler(n SyntaxNode) bool {
			for let i = n.childCount() - 1; i >= 0; i-- {
				let kind = n.childKind(i)
				continue when kind == SyntaxKind.Token
				return kind == SyntaxKind.OnError
			}
			return false
		}

		internal def computeExprType(file FileSymbols, expr SyntaxNode, depth int) Type {
			let unknown = table().unknownType()
			return unknown when depth > maxDepth
			switch expr.kind() {
				case SyntaxKind.Name:
					let t = expr.firstToken()
					return unknown when t is none
					if t.token() == TokenKind.Self {
						let owner = workspace.enclosingType(file, t.start())
						return unknown when owner is none
						return selfType(owner)
					}
					let sym = nameSymbol(file, t)
					// A primitive or container named as a value (`int` in `int(x)`),
					// whatever prelude type declares its members.
					if sym is none || (isTypeLike(sym.kind) && sym.path.startsWith("builtin.")) {
						let builtin = builtinType(t.text(), [], [])
						return builtin unless builtin is none
					}
					return unknown when sym is none
					let declared = valueTypeOf(file, sym, depth + 1)
					// What an assignment writes to is the name as declared, not what
					// a test made it.
					return declared when isAssignTarget(expr)
					return narrowedType(file, expr, sym, declared, depth + 1)
				case SyntaxKind.Member:
					let declared = memberExprType(file, expr, depth)
					return declared when isAssignTarget(expr)
					return memberNarrowedType(file, expr, declared, depth + 1)
				case SyntaxKind.Call:
					return callType(file, expr, depth)
				case SyntaxKind.New, SyntaxKind.Cast:
					for let (_, c) in expr.children() {
						continue unless isTypeNode(c.kind())
						return constructed(file, writtenType(file, c), expr, depth) when expr.kind() == SyntaxKind.New
						return writtenType(file, c)
					}
					return refType(contextRef(file, expr, depth + 1)) when expr.kind() == SyntaxKind.New
					return unknown
				case SyntaxKind.Paren:
					let inner = firstNonToken(expr)
					return unknown when inner is none
					return exprType(file, inner, depth + 1)
				case SyntaxKind.Try:
					let inner = firstNonToken(expr)
					return unknown when inner is none
					return unwrapped(exprType(file, inner, depth + 1), TypeKind.Fallible)
				case SyntaxKind.Await:
					let inner = firstNonToken(expr)
					return unknown when inner is none
					return unwrapped(exprType(file, inner, depth + 1), TypeKind.Async)
				case SyntaxKind.Index:
					let container = expr.child(0)
					return unknown when container is none
					return elementOf(exprType(file, container, depth + 1))
				case SyntaxKind.Slice:
					let container = expr.child(0)
					return unknown when container is none
					return exprType(file, container, depth + 1)
				case SyntaxKind.StructLit:
					return refType(structLiteralRef(file, expr, depth + 1))
				case SyntaxKind.Binary:
					return binaryType(file, expr, depth)
				case SyntaxKind.Unary:
					return unaryType(file, expr, depth)
				case SyntaxKind.Choice:
					return choiceType(file, expr, depth)
				case SyntaxKind.ArrayLit:
					return arrayLiteralType(file, expr, depth)
				case SyntaxKind.Tuple:
					return tupleLiteralType(file, expr, depth)
				case SyntaxKind.Lambda:
					return lambdaType(file, expr, depth)
				case SyntaxKind.FuncDecl:
					// An anonymous `def (x int) bool { ... }`.
					return funcTypeOfNode(file, expr, depth)
				case SyntaxKind.Async:
					// `async f()` and `async<scope> f()`: the call is the last part.
					let inner = lastNonToken(expr)
					return unknown when inner is none
					// An `async def` called with `async` is one future, not two.
					let started = exprType(file, inner, depth + 1)
					return started when plain(started).kind == TypeKind.Async
					return table().wrapType(TypeKind.Async, started)
				case SyntaxKind.Literal:
					return literalTypeOf(expr)
				case SyntaxKind.InterpString:
					return table().primitiveType("string")
				default:
					return unknown
			}
		}

		// selfType is the type `self` has in a type's body: the type with its
		// own type parameters as arguments.
		internal def selfType(owner Symbol) Type {
			let args Type[]
			for let (i, name) in typeParamsOf(owner) {
				args.push(table().typeParamType(owner.path, i, name))
			}
			return named(owner, args)
		}

		// refType is the type a TypeRef stands for: its type node read in
		// its file, with its bindings.
		internal def refType(ref ?TypeRef) Type {
			return table().unknownType() when ref is none
			let t = writtenType(ref.file, ref.node)
			return t when ref.bindings.len() == 0 || !t.open
			let bindings map<int, Type>
			for let (name, bound) in ref.bindings {
				// A binding names the parameter only: every type parameter of
				// that name in the type takes it.
				for let (_, p) in typeParamsIn(t) {
					bindings[p.id] = refType(bound) when p.name == name
				}
			}
			return table().substitute(t, bindings)
		}

		// typeParamsIn is the type parameters a type is made with.
		internal def typeParamsIn(t Type) Type[] {
			let out Type[]
			collectTypeParams(t, out)
			return out
		}

		internal def collectTypeParams(t Type, into Type[]) {
			return unless t.open
			if t.kind == TypeKind.TypeParam {
				into.push(t)
				return
			}
			for let (_, a) in t.args {
				collectTypeParams(a, into)
			}
			let r = t.result
			collectTypeParams(r, into) unless r is none
		}

		// literalTypeOf is the type a literal has where nothing asks for
		// another: `int`, `float`, `complex64` for an imaginary number,
		// `string`, `char`, `bool`, `duration`, `regex`, `none`.
		internal def literalTypeOf(expr SyntaxNode) Type {
			let t = expr.firstToken()
			return table().unknownType() when t is none
			// A quantity (`2(m)`) is its unit's dimension.
			return table().unknownType() when expr.childCount() > 1
			switch t.token() {
				case TokenKind.Integer:
					return table().primitiveType("int")
				case TokenKind.Float:
					return table().primitiveType("float")
				case TokenKind.Imaginary:
					return table().primitiveType("complex64")
				case TokenKind.String:
					return table().primitiveType("string")
				case TokenKind.Char:
					return table().primitiveType("char")
				case TokenKind.Bool:
					return table().primitiveType("bool")
				case TokenKind.Duration:
					return table().primitiveType("duration")
				case TokenKind.Regex:
					return table().primitiveType("regex")
				case TokenKind.None:
					return table().primitiveType("none")
				default:
					return table().unknownType()
			}
		}

		// unwrapped is the type inside a wrapper of the kind (`!T` after
		// `try`, `async T` after `await`), the type itself when it has none.
		internal def unwrapped(t Type, kind TypeKind) Type {
			let p = plain(t)
			return p.args[0] when p.kind == kind
			return t
		}

		// elementOf is the type of an element of a container read by index:
		// an array's or a channel's element, a map's value, a string's char.
		internal def elementOf(container Type) Type {
			let t = plain(container)
			switch t.kind {
				case TypeKind.Array, TypeKind.Channel, TypeKind.Vector, TypeKind.Mask:
					return t.args[0]
				case TypeKind.Map:
					return t.args[1]
				case TypeKind.Primitive:
					return table().primitiveType("char") when t.name == "string"
					return table().unknownType()
				default:
					return table().unknownType()
			}
		}

		// valueTypeOf is the type of a symbol's value: the type it is
		// written with, a function's type, an enum member's enum, a type
		// named as a value; an untyped local's initializer's, a loop
		// variable's from what it ranges over, a destructured name's from
		// its place in the tuple.
		internal def valueTypeOf(file FileSymbols, symbol ?Symbol, depth int) Type {
			let unknown = table().unknownType()
			return unknown when symbol is none
			return unknown when depth > maxDepth
			let home = homeOf(symbol, file)
			switch symbol.kind {
				case SymbolKind.EnumMember, SymbolKind.UnionMember:
					let owner = symbol.parent
					return unknown when owner is none
					return declaredTypeOf(home, owner, [], depth + 1)
				case SymbolKind.Function, SymbolKind.Method:
					return funcTypeOf(home, symbol, depth)
				case SymbolKind.Import, SymbolKind.Module, SymbolKind.Application, SymbolKind.Library, SymbolKind.Plugin, SymbolKind.Check:
					return unknown
				case SymbolKind.TypeParameter:
					return typeParamOf(home, symbol)
				default:
			}
			return declaredTypeOf(home, symbol, [], depth + 1) when isTypeLike(symbol.kind)
			let written = declaredType(symbol)
			if !(written is none) {
				let t = writtenType(home, written)
				// `rest ...string` is a `string[]` in its function.
				return table().wrapType(TypeKind.Array, t) when symbol.kind == SymbolKind.Parameter && isVariadicParam(symbol.node)
				return t
			}
			let node = symbol.node
			switch node.kind() {
				case SyntaxKind.Arg:
					// A view ref (`ScrollView(ref = port)`) holds the component the
					// call places, while the view has placed it: `?ScrollView`.
					let placed = refType(viewRefType(home, node))
					return placed when placed.kind == TypeKind.Unknown
					return table().wrapType(TypeKind.Optional, placed)
				case SyntaxKind.Destructure, SyntaxKind.Binding:
					return destructuredType(home, symbol, depth)
				default:
			}
			if symbol.kind == SymbolKind.Parameter {
				let fromLambda = lambdaParamType(home, symbol, depth)
				return fromLambda unless fromLambda is none
			}
			if symbol.kind == SymbolKind.Local || symbol.kind == SymbolKind.Const || symbol.kind == SymbolKind.Parameter || symbol.kind == SymbolKind.Field {
				let init = initializerFor(node, symbol)
				return exprType(home, init, depth + 1) unless init is none
			}
			return loopVariableTypeOf(home, symbol, depth)
		}

		// handled is the type of an expression whose error a handler
		// answers: without its `!`, inside a future too (`fetched() onerror
		// ...` on an `async def f() !int` is an `async int`).
		internal def handled(t Type) Type {
			let p = plain(t)
			return p.args[0] when p.kind == TypeKind.Fallible
			if p.kind == TypeKind.Async {
				let inner = plain(p.args[0])
				return table().wrapType(TypeKind.Async, inner.args[0]) when inner.kind == TypeKind.Fallible
			}
			return t
		}

		// isAssignTarget is true for a name or member an assignment writes
		// (`x = ...`, `p.x = ...`).
		internal def isAssignTarget(name SyntaxNode) bool {
			let up = name.parent
			return false when up is none || up.kind() != SyntaxKind.Assign
			let target = up.child(0)
			return !(target is none) && target.same(name)
		}

		// isVariadicParam is true for a parameter written `name ...T`.
		internal def isVariadicParam(param SyntaxNode) bool {
			return false unless param.kind() == SyntaxKind.Param
			for let (_, c) in param.children() {
				return true when c.isToken() && c.token() == TokenKind.Ellipsis
			}
			return false
		}

		// initializerFor is the value a name of a declaration starts with:
		// `let a, b = 1, f()` gives each name the value at its place, and
		// `let x, y = 1` both names the one value.
		internal def initializerFor(field SyntaxNode, symbol Symbol) ?SyntaxNode {
			let names = 0
			let at = 0
			let values SyntaxNode[]
			let seen = false
			for let (_, c) in field.children() {
				if c.isToken() {
					if !seen && c.token() == TokenKind.Ident {
						at = names when c.start() == symbol.nameStart
						names++
					}
					seen = true when isAssignmentToken(c.token())
					continue
				}
				values.push(c) when seen
			}
			return none when values.len() == 0
			return values[at] when values.len() == names && at < values.len()
			return values[0]
		}

		// funcTypeOf is a function's type: its parameters' types and its
		// result (`none` when it returns nothing).
		internal def funcTypeOf(file FileSymbols, fn Symbol, depth int) Type {
			return funcTypeOfNode(file, fn.node, depth)
		}

		// funcTypeOfNode is the type of the function the node declares.
		internal def funcTypeOfNode(file FileSymbols, node SyntaxNode, depth int) Type {
			let list = childOfKind(node, SyntaxKind.Params)
			// A function whose parameters are all written has the type its
			// text gives it: the file keeps it by its parameter list, as it
			// keeps written types. One typed by a default value is not kept.
			let key ?SyntaxNode = none
			if !(list is none) && paramsWritten(list) {
				let cached = cachedType(file, list)
				return cached unless cached is none
				key = list
			}
			let params Type[]
			let variadic = false
			variadic = paramTypes(file, list, params, depth) unless list is none
			let written = returnTypeOf(node)
			let result = table().primitiveType("none")
			result = writtenType(file, written) unless written is none
			// `async def f() T` gives a future: `async T` (`async none` without
			// a result), as the compiler types it.
			result = table().wrapType(TypeKind.Async, result) when isAsyncDecl(node) && result.kind != TypeKind.Async
			let t = table().funcType(params, result, variadic)
			let kept = key
			file.writtenTypes[kept.id()] = t unless kept is none
			return t
		}

		// isAsyncDecl is true for a function declared `async def`.
		internal def isAsyncDecl(node SyntaxNode) bool {
			for let (_, c) in node.children() {
				continue unless c.isToken()
				return true when c.token() == TokenKind.Async
				return false when c.token() == TokenKind.Def
			}
			return false
		}

		// paramsWritten is true when every parameter of the list is written
		// with its type.
		internal def paramsWritten(list SyntaxNode) bool {
			for let i = 0; i < list.childCount(); i++ {
				continue unless list.childKind(i) == SyntaxKind.Param
				let p = list.child(i)
				continue when p is none
				let typed = false
				for let k = 0; k < p.childCount(); k++ {
					typed = true when isTypeNode(p.childKind(k))
				}
				return false unless typed
			}
			return true
		}

		// destructuredType is the type of a name a destructuring binds: the
		// member of the tuple at its position.
		internal def destructuredType(file FileSymbols, symbol Symbol, depth int) Type {
			let unknown = table().unknownType()
			let pattern = symbol.node
			if pattern.kind() == SyntaxKind.Binding {
				let up = pattern.parent
				return unknown when up is none
				pattern = up
			}
			return unknown unless pattern.kind() == SyntaxKind.Destructure
			let position = -1
			let at = 0
			for let (_, c) in pattern.children() {
				if c.kind() == SyntaxKind.Binding || (c.isToken() && c.token() == TokenKind.Ident) {
					let last = c.lastToken()
					position = at when !(last is none) && last.start() == symbol.nameStart
					at++
				}
			}
			return unknown when position < 0
			let holder = pattern.parent
			return unknown when holder is none
			let init = initializerOf(holder)
			return unknown when init is none
			let whole = exprType(file, init, depth + 1)
			return unknown unless whole.kind == TypeKind.Tuple && position < whole.args.len()
			return whole.args[position]
		}

		// loopVariableTypeOf is the type of a loop variable from what its
		// loop ranges over: an array's index and element, a map's key and
		// value, a channel's element, a string's index and char, a range's
		// numbers, what a type's `iterate()` yields. Unknown for another
		// local.
		internal def loopVariableTypeOf(file FileSymbols, symbol Symbol, depth int) Type {
			let unknown = table().unknownType()
			let ranged = rangedExpression(symbol)
			return unknown when ranged is none
			let position = loopVariablePosition(symbol)
			if ranged.kind() == SyntaxKind.Binary {
				let op = ranged.child(1)
				return unknown when op is none
				return unknown unless op.isToken() && op.token() == TokenKind.Range
				let from = ranged.child(0)
				return unknown when from is none
				return exprType(file, from, depth + 1)
			}
			let container = plain(exprType(file, ranged, depth + 1))
			switch container.kind {
				case TypeKind.Array, TypeKind.Vector, TypeKind.Mask:
					return table().primitiveType("int") when position == 0
					return container.args[0]
				case TypeKind.Map:
					return container.args[0] when position == 0
					return container.args[1]
				case TypeKind.Channel:
					return unknown when position == 0
					return container.args[0]
				case TypeKind.Primitive:
					return unknown unless container.name == "string"
					return table().primitiveType("int") when position == 0
					return table().primitiveType("char")
				case TypeKind.Named:
					// A value of a type with `def iterate() ?T` yields a T.
					return unknown when position == 0
					let yielded = memberType(file, container, "iterate", depth)
					return unknown unless yielded.kind == TypeKind.Func
					let r = yielded.result
					return unknown when r is none
					return unwrapped(r, TypeKind.Optional)
				default:
					return unknown
			}
		}

		// memberExprType is the type of `receiver.name`: a member of the
		// module or type the receiver names, else a member of the
		// receiver's type.
		internal def memberExprType(file FileSymbols, expr SyntaxNode, depth int) Type {
			let unknown = table().unknownType()
			let kids = expr.children()
			return unknown when kids.len() < 3
			let receiver = kids[0]
			let nameToken = kids[kids.len() - 1]
			return unknown unless nameToken.isToken()
			let owner = staticSymbol(file, receiver)
			if !(owner is none) {
				let member = first(staticMembers(file, owner, nameToken.text()))
				return unknown when member is none
				let t = valueTypeOf(file, member, depth + 1)
				// A member a type has from its prelude base (`Color.values()`)
				// sees the type as its receiver.
				return t unless t.open && isTypeLike(owner.kind)
				return instanceType(file, declaredTypeOf(file, owner, [], depth + 1), member, t, depth)
			}
			return memberType(file, exprType(file, receiver, depth + 1), nameToken.text(), depth)
		}

		// memberType is the type of the member `name` read on a value of the
		// type: its declared type with the receiver's type arguments for the
		// owner's type parameters.
		internal def memberType(file FileSymbols, receiver Type, name string, depth int) Type {
			let unknown = table().unknownType()
			let owner = ownerOf(receiver)
			return unknown when owner is none
			let member = first(membersNamed(homeOf(owner, file), owner, name))
			return unknown when member is none
			return instanceType(file, receiver, member, valueTypeOf(file, member, depth + 1), depth)
		}

		// instanceType is a member's type as a receiver of the type sees it:
		// the type parameters of the member's owner replaced by what the
		// receiver binds them to, Unknown where it binds nothing.
		internal def instanceType(file FileSymbols, receiver Type, member Symbol, t Type, depth int) Type {
			return t unless t.open
			let owner = member.parent
			return t when owner is none
			let args = instanceArgs(file, receiver, owner, depth)
			let given Type[]
			given = args unless args is none
			return table().substitute(t, bindingsOf(owner, given))
		}

		// instanceArgs is the type arguments the owner of a member has in a
		// receiver of the type: the receiver's own, those of the type it
		// embeds that declares the member, an array's or a map's element
		// types for the prelude's `array` and `map`, the receiver itself for
		// the prelude bases (`Number<T>`, `Component<T>`). None when the
		// receiver does not reach the owner.
		internal def instanceArgs(file FileSymbols, seen Type, owner Symbol, depth int) ?Type[] {
			return none when depth > maxDepth
			// An alias's members are those of what it stands for.
			let receiver = plain(seen)
			switch owner.path {
				case "builtin.Number", "builtin.ComplexNumber", "builtin.Component":
					return [receiver]
				case "builtin.Enum":
					// `Enum<V>`'s V is what the members hold: strings when they are
					// written with them, else ints.
					let declared = declarationOf(receiver)
					return none when declared is none || declared.kind != SymbolKind.Enum
					return [enumValueType(declared)]
				default:
			}
			switch receiver.kind {
				case TypeKind.Array, TypeKind.Channel, TypeKind.Map, TypeKind.Vector, TypeKind.Mask, TypeKind.Matrix:
					return receiver.args
				case TypeKind.Named:
					return receiver.args when receiver.path == owner.path
					let decl = declarationOf(receiver)
					return none when decl is none
					let home = homeOf(decl, file)
					let bindings = bindingsOf(decl, receiver.args)
					for let (_, embedded) in embeddingTypes(home, decl) {
						let instance = table().substitute(embedded, bindings)
						continue unless instance.kind == TypeKind.Named
						let found = instanceArgs(file, instance, owner, depth + 1)
						return found unless found is none
					}
					return none
				default:
					return none
			}
		}

		// enumValueType is the type of an enum's member values: `string` when
		// a member is written with a string, else `int`.
		internal def enumValueType(declared Symbol) Type {
			for let (_, m) in declared.members {
				continue unless m.kind == SymbolKind.EnumMember
				for let (_, c) in m.node.children() {
					continue unless c.kind() == SyntaxKind.Literal
					let t = c.firstToken()
					return table().primitiveType("string") when !(t is none) && t.token() == TokenKind.String
				}
			}
			return table().primitiveType("int")
		}

		// embeddingTypes is the types a declaration's body embeds, read in
		// its file.
		internal def embeddingTypes(file FileSymbols, owner Symbol) Type[] {
			let out Type[]
			let body = childOfKind(owner.node, SyntaxKind.Body)
			return out when body is none
			for let (_, c) in body.children() {
				continue unless c.kind() == SyntaxKind.Embedding
				for let (_, t) in c.children() {
					if isTypeNode(t.kind()) {
						out.push(writtenType(file, t))
						continue
					}
					let found = embeddedSymbol(file, t)
					out.push(declaredTypeOf(file, found, [], 0)) unless found is none
				}
			}
			return out
		}

		// ownerOf is the declaration whose members a value of the type has:
		// a named type's declaration, the prelude's type for a primitive, an
		// array, a map, a channel, a SIMD vector or a matrix. None for
		// another type.
		internal def ownerOf(receiver Type) ?Symbol {
			forgetStaleDeclarations()
			let held = owners.get(receiver.id)
			return held unless held is none
			return none when ownerless.hasKey(receiver.id)
			let found = findOwner(receiver)
			if found is none {
				ownerless[receiver.id] = true
			} else {
				owners[receiver.id] = found
			}
			return found
		}

		// findOwner is `ownerOf` without the memo.
		internal def findOwner(receiver Type) ?Symbol {
			let t = plain(receiver)
			switch t.kind {
				case TypeKind.Named:
					return declarationOf(t)
				case TypeKind.Primitive:
					let prelude = primitiveTypeName(t.name)
					return first(workspace.lookup("builtin", (prelude.len() > 0) ?? (prelude, t.name)))
				case TypeKind.Array:
					return first(workspace.lookup("builtin", "array"))
				case TypeKind.Map:
					return first(workspace.lookup("builtin", "map"))
				case TypeKind.Channel:
					return first(workspace.lookup("builtin", "channel"))
				case TypeKind.Matrix:
					return first(workspace.lookup("builtin", "matrix"))
				case TypeKind.Vector:
					return first(workspace.lookup("builtin", "vec{t.index}"))
				case TypeKind.Mask:
					return first(workspace.lookup("builtin", "mask{t.index}"))
				default:
					return none
			}
		}

		// declarationOf is the declaration a named type stands for, looked
		// up again by its path once the workspace changed.
		internal def declarationOf(t Type) ?Symbol {
			return none unless t.kind == TypeKind.Named
			forgetStaleDeclarations()
			let held = namedDeclarations.get(t.id)
			return held unless held is none
			let found = declarationAt(t.path)
			namedDeclarations[t.id] = found unless found is none
			return found
		}

		// named is the named type of the declaration with the arguments; the
		// declaration is remembered for `declarationOf`.
		internal def named(declaration Symbol, args Type[]) Type {
			let t = table().namedType(declaration, args)
			forgetStaleDeclarations()
			namedDeclarations[t.id] = declaration unless namedDeclarations.hasKey(t.id)
			return t
		}

		internal def forgetStaleDeclarations() {
			return when declaredVersion == workspace.version
			let fresh map<int, Symbol>
			namedDeclarations = fresh
			let freshOwners map<int, Symbol>
			owners = freshOwners
			let freshOwnerless map<int, bool>
			ownerless = freshOwnerless
			// What one query typed holds for the workspace it was typed in.
			freshQuery()
			declaredVersion = workspace.version
		}

		// callType is the type of a call's result: a function's declared
		// result (a method's with the receiver's type arguments, the
		// function's own type parameters Unknown until arguments infer
		// them), the type a type-like callee makes, the result of a value of
		// function type.
		internal def callType(file FileSymbols, call SyntaxNode, depth int) Type {
			let unknown = table().unknownType()
			let callee = call.child(0)
			return unknown when callee is none
			let target = callTarget(file, call, depth)
			if target is none {
				// `Type(value)` and `int(value)` make the type; `f(x)` on a value
				// of function type gives its result.
				let made = exprType(file, callee, depth + 1)
				let called = plain(made)
				if called.kind == TypeKind.Func {
					let r = called.result
					return unknown when r is none
					return r
				}
				return constructed(file, made, call, depth) when made.kind == TypeKind.Named
				// `int(x)` and `T(x)` convert to the type.
				return made when made.kind == TypeKind.Primitive || made.kind == TypeKind.TypeParam
				return unknown
			}
			let r = target.signature.result
			return unknown when r is none
			return withoutOwnParams(bindCall(file, target.fn, target.signature, call, r, depth), target.fn)
		}

		// callTarget is the function a call calls, among the overloads its
		// callee names (`chooseOverload`), with its type as the receiver of a
		// method sees it; none when the callee names no function (a type, a
		// value of function type).
		internal def callTarget(file FileSymbols, call SyntaxNode, depth int) ?CallTarget {
			forgetStaleDeclarations()
			let held = callTargets.get(call)
			return held unless held is none
			return none when untargeted.hasKey(call)
			let found = findCallTarget(file, call, depth)
			if found is none {
				untargeted[call] = true
			} else {
				callTargets[call] = found
			}
			return found
		}

		// findCallTarget is `callTarget` without the memo.
		internal def findCallTarget(file FileSymbols, call SyntaxNode, depth int) ?CallTarget {
			let callee = call.child(0)
			return none when callee is none
			// What the callee may name, and the value a method is called on.
			let candidates Symbol[]
			let receiver ?Type = none
			switch callee.kind() {
				case SyntaxKind.Name:
					let t = callee.firstToken()
					return none when t is none
					if t.token() != TokenKind.Self {
						candidates = workspace.resolve(file, t.text(), t.start())
						// A value of the name nearer than its functions does not
						// hide them from a call.
						candidates = workspace.resolveCallable(file, t.text(), t.start()) when callsPast(file, candidates, depth)
					}
				case SyntaxKind.Member:
					let kids = callee.children()
					return none when kids.len() < 3
					let name = kids[kids.len() - 1].text()
					let owner = staticSymbol(file, kids[0])
					if owner is none {
						let value = exprType(file, kids[0], depth + 1)
						receiver = value
						let declaring = ownerOf(value)
						candidates = membersNamed(homeOf(declaring, file), declaring, name) unless declaring is none
					} else {
						candidates = staticMembers(file, owner, name)
						// A type's member from its prelude base (`Color.values()`)
						// sees the type as its receiver.
						receiver = declaredTypeOf(file, owner, [], depth + 1) when isTypeLike(owner.kind)
					}
				default:
			}
			let fn = chooseOverload(file, call, candidates, receiver, depth)
			return none when fn is none
			let fnType = funcTypeOf(homeOf(fn, file), fn, depth)
			fnType = instanceType(file, receiver, fn, fnType, depth) unless receiver is none
			return CallTarget{fn: fn, signature: fnType}
		}

		// callsPast is true when a call of a name that means the symbols
		// calls something further out (`Workspace.resolveCallable`): none of
		// them is a function, a method or a type, and none is a value of a
		// function type, nor one this layer cannot type.
		internal def callsPast(file FileSymbols, found Symbol[], depth int) bool {
			return false when found.len() == 0 || depth > maxDepth
			for let (_, s) in found {
				return false when isCallableKind(s.kind) || s.kind == SymbolKind.Import
				let t = plain(unwrapped(valueTypeOf(file, s, depth + 1), TypeKind.Optional))
				return false when t.kind == TypeKind.Func || t.isUnknown()
			}
			return true
		}

		// argumentPlaceType is the type the parameter an argument of a call
		// passes to asks for: by position, or by name for a named one, with
		// the receiver's type arguments and those the other arguments bind.
		// None when the argument's call calls no function this layer knows.
		internal def argumentPlaceType(file FileSymbols, arg SyntaxNode, depth int) ?Type {
			let args = arg.parent
			return none when args is none || args.kind() != SyntaxKind.Args
			let call = args.parent
			return none when call is none || call.kind() != SyntaxKind.Call
			let target = callTarget(file, call, depth)
			return none when target is none
			let fnType = target.signature
			let head = arg.child(0)
			return none when head is none
			let at = 0
			if isNamedArgumentName(head) {
				at = -1
				for let (i, n) in parameterNames(target.fn.node) {
					at = i when n.text() == head.text()
				}
			} else {
				for let (_, a) in args.children() {
					continue unless a.kind() == SyntaxKind.Arg
					break when a.same(arg)
					let first = a.child(0)
					at++ unless first is none || isNamedArgumentName(first)
				}
			}
			at = fnType.args.len() - 1 when fnType.variadic && at >= fnType.args.len()
			return none when at < 0 || at >= fnType.args.len()
			let wanted = fnType.args[at]
			return wanted unless wanted.open
			let bindings map<int, Type>
			unifyArguments(file, target.fn, fnType, call, bindings, depth)
			return table().substitute(wanted, bindings)
		}

		// chooseOverload is the function a call calls among the candidates
		// its callee names: among those whose parameters take the
		// arguments (`acceptsArguments`), the one whose parameter types agree
		// with the most argument types (a type this layer cannot tell is
		// neutral, a known mismatch rules out), else the first that takes
		// them, else the first. None when no candidate is a function.
		internal def chooseOverload(file FileSymbols, call SyntaxNode, candidates Symbol[], receiver ?Type, depth int) ?Symbol {
			let fns Symbol[]
			for let (_, c) in candidates {
				fns.push(c) when c.kind == SymbolKind.Function || c.kind == SymbolKind.Method
			}
			return none when fns.len() == 0
			return fns[0] when fns.len() == 1
			let best ?Symbol = none
			let bestScore = -1
			let firstAccepting ?Symbol = none
			for let (_, fn) in fns {
				continue unless acceptsArguments(fn, call)
				firstAccepting = fn when firstAccepting is none
				let score = overloadScore(file, fn, call, receiver, depth)
				continue when score <= bestScore
				best = fn
				bestScore = score
			}
			return best unless best is none
			return firstAccepting unless firstAccepting is none
			return fns[0]
		}

		// overloadScore counts the positional arguments whose type has the
		// declaration of the parameter's type; -1 when one is known to have
		// another.
		internal def overloadScore(file FileSymbols, fn Symbol, call SyntaxNode, receiver ?Type, depth int) int {
			let args = childOfKind(call, SyntaxKind.Args)
			return 0 when args is none
			let fnType = funcTypeOf(homeOf(fn, file), fn, depth)
			fnType = instanceType(file, receiver, fn, fnType, depth) unless receiver is none
			let params = fnType.args
			let score = 0
			let i = 0
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg
				let head = arg.child(0)
				continue when head is none
				break when isNamedArgumentName(head)
				let at = i
				at = params.len() - 1 when fnType.variadic && at >= params.len()
				break when at < 0 || at >= params.len()
				let wanted = params[at]
				i++
				continue when wanted.kind == TypeKind.TypeParam || wanted.kind == TypeKind.Unknown
				// An array literal goes only where an array of its elements'
				// type does (`[oid]` for `OID[]`, not for `OID`).
				if head.kind() == SyntaxKind.ArrayLit && typedArrayElement(head) is none {
					let agreement = literalElementAgreement(file, head, wanted, depth)
					return -1 when agreement < 0
					score += agreement
					continue
				}
				// An argument typed by its place (`{x: 1}`, a lambda) takes its
				// type from the overload being chosen.
				continue when typedByPlace(head)
				let given = adoptLiteral(head, exprType(file, head, depth + 1), wanted)
				continue when given.kind == TypeKind.Unknown
				let agreement = typeAgreement(given, wanted)
				return -1 when agreement < 0
				score += agreement
			}
			return score
		}

		// literalElementAgreement is how well an array literal without a
		// written type fits an array parameter: its first element's type
		// against the parameter's element type; 0 for another parameter, an
		// empty literal, rows, or an element typed by its place.
		internal def literalElementAgreement(file FileSymbols, literal SyntaxNode, wanted Type, depth int) int {
			let w = plain(wanted)
			return 0 unless w.kind == TypeKind.Array
			let item = firstNonToken(literal)
			return 0 when item is none || item.kind() == SyntaxKind.Row || typedByPlace(item)
			let element = w.args[0]
			return 0 when element.open || element.isUnknown()
			let given = adoptLiteral(item, exprType(file, item, depth + 1), element)
			return 0 when given.kind == TypeKind.Unknown
			return typeAgreement(given, element)
		}

		// typeAgreement is how well an argument's type fits a parameter's:
		// 2 when it is the type, 1 when it has the type's declaration (a
		// `File` for a `?File`, an `int` for a `float`), 0 when this layer
		// cannot tell, -1 when it is known not to fit. Containers keep their
		// element types exact (spec §4.2), so `float64[]` does not fit
		// `float16[]`.
		internal def typeAgreement(given Type, wanted Type) int {
			let g = bare(given)
			let w = bare(wanted)
			return 2 when g == w
			if g.kind == w.kind && (g.kind == TypeKind.Array || g.kind == TypeKind.Map || g.kind == TypeKind.Channel) {
				for let (i, ga) in g.args {
					let wa = w.args[i]
					continue when ga.isUnknown() || wa.open || wa.isUnknown()
					return -1 unless plain(ga) == plain(wa)
				}
				return 2
			}
			let a = ownerOf(g)
			let b = ownerOf(w)
			return 0 when a is none || b is none
			return 1 when a.path == b.path && a.kind == b.kind
			return -1
		}

		// bare is the type without its `?`, `!` and `async` wrappers.
		internal def bare(t Type) Type {
			let current = plain(t)
			for current.kind == TypeKind.Optional || current.kind == TypeKind.Fallible || current.kind == TypeKind.Async {
				current = plain(current.args[0])
			}
			return current
		}

		// withoutOwnParams is the type with the function's own type
		// parameters made Unknown: what they stand for comes from the
		// arguments, which this layer does not infer.
		internal def withoutOwnParams(t Type, fn Symbol) Type {
			return t unless t.open
			let bindings map<int, Type>
			for let (i, name) in typeParamsOf(fn) {
				bindings[table().typeParamType(fn.path, i, name).id] = table().unknownType()
			}
			return table().substitute(t, bindings)
		}

		// staticSymbol is the module import or type-like declaration a name
		// or a member chain of names spells, none when it is a value.
		internal def staticSymbol(file FileSymbols, expr ?SyntaxNode) ?Symbol {
			return none when expr is none
			switch expr.kind() {
				case SyntaxKind.Name:
					let t = expr.firstToken()
					return none when t is none
					return none when t.token() == TokenKind.Self
					let found = first(workspace.resolve(file, t.text(), t.start()))
					return none when found is none
					return found when found.kind == SymbolKind.Import && !found.wildcard
					return found when isTypeLike(found.kind)
					return none
				case SyntaxKind.Member:
					let kids = expr.children()
					return none when kids.len() < 3
					let owner = staticSymbol(file, kids[0])
					return none when owner is none
					let found = first(staticMembers(file, owner, kids[kids.len() - 1].text()))
					return none when found is none
					return found when isTypeLike(found.kind)
					return none
				default:
					return none
			}
		}

		// staticMembers is what `name` means after a module import or a type
		// name: a declaration of the module, a member of the type (an alias
		// stands for its target: `LineStyle.None`).
		internal def staticMembers(file FileSymbols, owner Symbol, name string) Symbol[] {
			return workspace.memberOf(owner, name) when owner.kind == SymbolKind.Import
			let actual = followAlias(file, owner, 0)
			return [] when actual is none
			return membersNamed(homeOf(actual, file), actual, name)
		}
	}
}
