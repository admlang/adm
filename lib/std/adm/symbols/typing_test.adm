partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	internal def typesSource() string {
		return fixture("""
module tys «
	use lib::(File)
	type Pair<A, B> = (A, B)
	type Id = int | string
	type Grid<T> «
		cells T[]
		def at(i int) T « return cells[i] »
		def run() «
			let mine = self
			let cell = self.cells[0]
			let fromAt = at(0)
		»
	»
	def make() (int, string) « return (1, "x") »
	def first<T>(items T[]) T « return items[0] »
	def run(m map<string, File[]>, c channel<?int>, v vec4<float32>, g Grid<File>, f def(int, ...string) bool, p Pair<int, File>, u Id, w ?!File, x async int[], mx matrix<float, 2, 3>, h (!string) | File, ks mask8<int32>) «
		let mv = m["k"]
		let lane = v[0]
		let cell = g.at(0).path
		let ok = f(1, "a")
		let (num, text) = make()
		let o = 2.5
		let im = 3i
		let d = 5s
		let s = "a«o»"
		let sl = "abc"[1:2]
		let ch = "abc"[0]
		let picked = first(g.cells)
		let len = g.cells.len()
		let shown = ks
	»
»
""")
	}

	// typeMismatches is `name: got X, want Y` for each `let` (or other
	// text, found as written, at its `^` when it has one) whose type is not
	// the expected one.
	internal def typeMismatches(nav Navigator, file FileSymbols, source string, expected map<string, string>) string[] {
		let wrong string[]
		for let (name, want) in expected {
			// `^` marks the offset inside a longer text: `(i, ^f)`.
			let at = source.indexOf("let " + name + " ")
			if at >= 0 {
				at += 4
			} else {
				let mark = name.indexOf("^")
				at = source.indexOf(name.replace("^", "")) + ((mark < 0) ?? (0, mark))
			}
			let got = nav.typeAt(file, at).str()
			wrong.push("{name}: got {got}, want {want}") unless got == want
		}
		println(wrong.join("\n")) when wrong.len() > 0
		return wrong
	}

	check "Typing" {
		@test()
		def TestTypesOfNamesAndMembers() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(libSource()))
			let source = appSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let expected map<string, string> = {
				"text":         "!string",
				"p":            "string",
				"o":            "string",
				"first":        "string",
				"opened":       "!File",
				"count":        "int",
				"id":           "int",
				"q":            "def(string) !File",
				"f File":       "File",
				"items File[]": "File[]"
			}
			assert typeMismatches(nav, app, source, expected).len() == 0
		}

		@test()
		def TestTypesThroughGenericsAndLoops() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(genLibSource()))
			let source = genSource()
			let gen = w.add("gen.adm", parse(source))
			let nav = new Navigator(w)
			let expected map<string, string> = {
				"shade":     "Color",
				"shadeName": "string",
				"names":     "string[]",
				"p":         "Point",
				"q":         "Point",
				"n":         "int",
				"r":         "int",
				// The type argument comes from the constructor's arguments.
				"b":           "Box<Point>",
				"typed":       "Box<File>",
				"v":           "string",
				"first":       "string",
				"got":         "string",
				"chained":     "string",
				"k":           "int",
				"fp":          "string",
				"ip":          "int",
				"kp":          "int",
				"vp":          "string",
				"cp":          "char",
				"jp":          "int",
				"lp":          "string",
				"(^i, f)":     "int",
				"(i, ^f)":     "File",
				"(^key, val)": "string",
				"(key, ^val)": "File",
				"^ch in":      "char",
				"^j in":       "int",
				"^line in":    "File"
			}
			assert typeMismatches(nav, gen, source, expected).len() == 0
		}

		@test()
		def TestTypeKinds() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(libSource()))
			let source = typesSource()
			let tys = w.add("tys.adm", parse(source))
			let nav = new Navigator(w)
			let expected map<string, string> = {
				"m map":        "map<string, File[]>",
				"c channel":    "channel<?int>",
				"v vec4":       "vec4<float32>",
				"g Grid":       "Grid<File>",
				"f def":        "def(int, ...string) bool",
				"p Pair":       "Pair<int, File>",
				"u Id":         "Id",
				"w ?!":         "?!File",
				"x async":      "async int[]",
				"mx matrix":    "matrix<float, 2, 3>",
				"h (!string)":  "(!string) | File",
				"ks mask8":     "mask8<int32>",
				"mine":         "Grid<T>",
				"fromAt":       "T",
				"mv":           "File[]",
				"lane":         "float32",
				"cell = g":     "string",
				"ok":           "bool",
				"(^num, text)": "int",
				"(num, ^text)": "string",
				"o":            "float",
				"im":           "complex64",
				"d":            "duration",
				"s":            "string",
				"sl":           "string",
				"ch":           "char",
				// `first<T>`'s T comes from its argument.
				"picked": "File",
				"len":    "int",
				"shown":  "mask8<int32>"
			}
			assert typeMismatches(nav, tys, source, expected).len() == 0
			// `self.cells[0]` in Grid's body is a T.
			assert nav.typeAt(tys, source.indexOf("let cell = self") + 4).str() == "T"
			// One type, one object.
			let g = nav.typeAt(tys, source.indexOf("g Grid"))
			assert g == nav.typeAt(tys, source.indexOf("g.at"))
			assert g.kind == TypeKind.Named && g.args[0].str() == "File"
			// An alias keeps its name, as the compiler shows it, and knows what it
			// stands for.
			let pair = nav.typeAt(tys, source.indexOf("p Pair"))
			let expanded = pair.underlying
			assert !(expanded is none) && expanded.str() == "(int, File)"
			assert !g.isUnknown() && !nav.typeAt(tys, source.indexOf("let picked") + 4).isUnknown()
		}

		@test()
		def TestInferredExpressions() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(genLibSource()))
			let source = fixture("""
module inf «
	use lib::(File, Box, Point)
	type Money «
		cents int
		infix def +(other Money) Money « return self »
	»
	def pick<T>(a T, b T) T « return a »
	enum Mode «
		Fast = "fast",
		Slow = "slow"
	»
	enum Level «
		Low,
		High
	»
	type Size<T = float> «
		w T
	»
	type Clock «
		infix def -(other Clock) duration « return 0s »
		infix def -(d duration) Clock « return self »
	»
	type Node<T> «
		def again() Node « return self »
	»
	def spread(v float32[]) int « return 0 »
	def spread(v float64[]) string « return "" »
	async def later() int « return 1 »
	def keepIf<T>(items T[], keep def(item T) bool) T[] « return items »
	def run(n int, x float32, s string, c char, d duration, m Money, files File[], ch channel<File>, c1 Clock, c2 Clock, node Node<int>, wide float64[], group any) «
		let sum = n + 1
		let scaled = x * 2
		let mixed = 1.5 + n
		let text = s + c
		let longer = d * 2.0
		let money = m + m
		let same = n == 3
		let both = same && n > 1
		let neg = -n
		let got = <-ch
		let either = same ?? (n, 2)
		let wide = same ?? (n, 2.5)
		let maybe = same ?? (files[0], none)
		let mixedKinds = same ?? (n, s)
		let nums = [1, 2, 3]
		let floats = [x, 1]
		let anything = [1, "a"]
		let empty = []
		let pair = (n, s)
		let square = (v int) => v * v
		let shout = def (v string) string « return v »
		let block = (v int) => « return v + 1 »
		let boxed = new Box(files[0])
		let boxedByName = new Box(value = m)
		let chosen = pick(s, s)
		let fut = async pick(n, n)
		let kept = keepIf(files, f => f.path.len() > 0)
		let mode = Mode.Fast
		let modeValue = mode.value
		let levelValue = Level.High.value
		let size = new Size()
		let gap = c1 - c2
		let earlier = c1 - 5s
		let again = node.again()
		let spreadWide = spread(wide)
		let one, two = 1, s
		let fut2 = later()
		let scoped = async<group> pick(n, n)
		let once = async later()
	»
»
""")
			let file = w.add("inf.adm", parse(source))
			let nav = new Navigator(w)
			let expected map<string, string> = {
				"sum":        "int",
				"scaled":     "float32",
				"mixed":      "float",
				"text":       "string",
				"longer":     "duration",
				"money":      "Money",
				"same":       "bool",
				"both":       "bool",
				"neg":        "int",
				"got":        "File",
				"either":     "int",
				"wide":       "float",
				"maybe":      "?File",
				"mixedKinds": "int | string",
				"nums":       "int[]",
				"floats":     "float32[]",
				"anything":   "any[]",
				"empty":      "unknown",
				"pair":       "(int, string)",
				"square":     "def(int) int",
				"shout":      "def(string) string",
				// A statement body returns what its place asks for: an untyped
				// `let` asks for nothing (and the checker refuses the `return`).
				"block":       "def(int)",
				"boxed":       "Box<File>",
				"boxedByName": "Box<Money>",
				"chosen":      "string",
				"fut":         "async int",
				"kept":        "File[]",
				// `Enum<V>`'s V: strings when the members are written with them.
				"modeValue":  "string",
				"levelValue": "int",
				// A parameter left out takes its default; `Node` in its own body
				// is the type itself; an operator's overload by the right side.
				"size":    "Size<float>",
				"again":   "Node<int>",
				"gap":     "duration",
				"earlier": "Clock",
				// Overloads by their arrays' element types; each name of a `let`
				// its own value; `async def` and `async<scope>` give futures.
				"spreadWide": "string",
				"one, two":   "int",
				"one, ^two":  "string",
				"fut2":       "async int",
				"scoped":     "async int",
				"once":       "async int",
				// The lambda's parameter takes the element type the other
				// argument binds.
				"f =>": "File"
			}
			assert typeMismatches(nav, file, source, expected).len() == 0
		}

		@test()
		def TestInlayHints() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(genLibSource()))
			let source = fixture("""
module hinted «
	use lib::(File, Point, area)
	def show(visible bool, count int, label string = "") « »
	def run(files File[]) «
		let n = 3
		let typed int = 4
		let p = Point«x: 1, y: 2»
		let unknownish = nothing()
		for let (i, f) in files « »
		show(true, -2, label = "x")
		show(n == 1, n)
		area(p, 2)
	»
»
""")
			let file = w.add("hinted.adm", parse(source))
			let nav = new Navigator(w)
			let shown string[]
			for let (_, h) in nav.inlayHints(file, 0, source.len()) {
				shown.push("{h.kind.value}:{h.label}@{source[h.offset - 1]}")
			}
			// Types after untyped names (the character before the hint is the
			// name's last), parameters before literals passed by position.
			assert shown.join(",") == "type:int@n,type:Point@p,type:int@i,type:File@f,parameter:visible@(,parameter:count@ ,parameter:scale@ "
			// A range shows only its own hints.
			let from = source.indexOf("show(true")
			let inRange = nav.inlayHints(file, from, from + "show(true, -2".len())
			assert inRange.len() == 2 && inRange[0].label == "visible"
		}

		@test()
		def TestNarrowing() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(genLibSource()))
			let source = fixture("""
module nar «
	use lib::(File)
	def maybe() ?File « return none »
	def f(x ?File) «
		let before = x
		if x is none «
			return
		»
		let afterIf = x
	»
	def g(x ?File) «
		return when x is none
		let afterGuard = x
	»
	def h(x ?File, u int | string, a any) «
		let both = !(x is none) && x.path.len() > 0
		let arm = (x is none) ?? (0, x.path.len())
		if u is int «
			let asInt = u
		» else «
			let asString = u
		»
		match u «
			case string:
				let inArm = u
			default:
		»
		if a is File «
			let asFile = a
		»
	»
	def k(x ?File) «
		return when x is none
		x = maybe()
		let reassigned = x
	»
	def opened() !File « return new File() »
	async def fetched() !int « return 1 »
	def all(rest ...string) «
		let given = rest
	»
	def fill(x ?File) !none «
		if x is none «
			x = maybe()
		»
		let waited = await fetched() onerror recover 0
	»
	def m(run def() !int) !none «
		let got = opened()
		return when got is error
		let ok = got
		let handled = run() onerror recover 0
	»
»
""")
			let file = w.add("nar.adm", parse(source))
			let nav = new Navigator(w)
			let expected map<string, string> = {
				"before":     "?File",
				"afterIf":    "File",
				"afterGuard": "File",
				"both":       "bool",
				// The read after `&&` and in the arm of `??` sees the test.
				"&& ^x.path": "File",
				", ^x.path":  "File",
				"asInt":      "int",
				"asString":   "string",
				"inArm":      "string",
				"asFile":     "File",
				// An assignment after the test ends what it said.
				"reassigned": "?File",
				// `is error` splits an errorable; a handler takes a call\'s `!`
				// off, a function value\'s too.
				"ok":      "File",
				"handled": "int",
				// A variadic parameter is an array in its function; an assignment\'s
				// target keeps its declared type; a handler on `await` too.
				"given":            "string[]",
				"\t\t\t^x = maybe": "?File",
				"waited":           "int"
			}
			assert typeMismatches(nav, file, source, expected).len() == 0
		}

		@test()
		def TestWrittenTypesCachedPerFile() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("lib.adm", parse(libSource()))
			let source = appSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let at = source.indexOf("f File")
			assert nav.typeAt(app, at).str() == "File"
			let held = app.writtenTypes.len()
			assert held > 0
			nav.typeAt(app, at)
			assert app.writtenTypes.len() == held
			// A body edit elsewhere keeps the shape: the cache holds.
			let shapes = w.shapes
			w.update("lib.adm", parse(libSource().replace("return path", "return path + \"\"")))
			assert w.shapes == shapes
			assert app.typesEpoch == w.shapes
			// A type renamed elsewhere changes the shape: written types are
			// lowered again, and `File` no longer names a declaration.
			w.update("lib.adm", parse(libSource().replace("type File", "type Doc")))
			assert w.shapes != shapes
			assert nav.typeAt(app, at).str() == "unknown"
		}
	}
}
