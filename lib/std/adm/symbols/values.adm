partial module std.adm.symbols {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::(SyntaxKind, SyntaxNode)
	)

	partial type Navigator {
		// valueHolder is the node whose value the offset completes: a struct
		// literal's `key: |`, an assignment's `name = |`, a named argument's
		// `name = |`, a declaration's `let x T = |`, a `return |`; with
		// nothing typed after the separator, or with the name being typed as
		// the whole value. None anywhere else.
		internal def valueHolder(file FileSymbols, offset int) ?SyntaxNode {
			return none when offset == 0
			let before = file.tree.find(offset - 1)
			return none when before is none || !before.isToken()
			if isTypedName(before) && before.end() == offset {
				let name = before.parent
				return none when name is none || name.kind() != SyntaxKind.Name
				let holder = name.parent
				return none when holder is none
				let sep = name.prevSibling()
				return none when sep is none || !sep.isToken() || !isValueSeparator(holder, sep)
				return holder
			}
			return none when before.end() > offset
			let holder = before.parent
			return none when holder is none || !isValueSeparator(holder, before)
			// Nothing after the separator yet.
			let next = before.nextSibling()
			return none unless next is none || (next.isToken() && next.isMissing())
			return holder
		}

		// expectedAt is the type the value of `holder` is asked to have, none
		// where nothing says.
		internal def expectedAt(file FileSymbols, holder SyntaxNode) ?TypeRef {
			switch holder.kind() {
				case SyntaxKind.FieldInit:
					let keyNode = holder.child(0)
					return none when keyNode is none
					let keyToken = keyNode.firstToken()
					return none when keyToken is none
					let field = structKey(file, keyToken)
					return none when field is none
					let literal = holder.parent
					return none when literal is none
					return memberTypeRef(file, structLiteralRef(file, literal, 0), field)
				case SyntaxKind.Assign:
					let target = holder.child(0)
					return none when target is none
					return typeRefOfDepth(file, target, 0)
				case SyntaxKind.Arg:
					let nameToken = holder.child(0)
					return none when nameToken is none
					let param = namedArgument(file, nameToken)
					return none when param is none
					return memberTypeRef(file, none, param)
				case SyntaxKind.Field:
					let written = writtenTypeOf(holder)
					return none when written is none
					return TypeRef{file: file, node: written, bindings: noBindings()}
				case SyntaxKind.Return:
					// The nearest function or lambda: a lambda's `return` is its own.
					let fn = enclosingFunction(holder)
					return none when fn is none
					let written = returnTypeOf(fn)
					return none when written is none
					return TypeRef{file: file, node: written, bindings: noBindings()}
				default:
					return none
			}
		}

		// positionalExpected is the type the parameter an argument start
		// passes by position asks for (`f(a, |`, `f(wi|`), none where the
		// callee or its parameter is not known.
		internal def positionalExpected(file FileSymbols, offset int) ?TypeRef {
			let args = argumentSlot(file, offset)
			return none when args is none
			let owner = args.parent
			return none when owner is none
			let fn = calledFunction(file, owner, 0)
			return none when fn is none
			let positional = 0
			for let (_, arg) in args.children() {
				continue unless arg.kind() == SyntaxKind.Arg && arg.end() < offset
				let first = arg.child(0)
				positional++ unless first is none || isNamedArgumentName(first)
			}
			let param = parameterAt(file, fn, positional)
			return none when param is none
			return memberTypeRef(file, none, param)
		}

		// typedValues is what fits a value of the expected type, nearest first:
		// for an enum its members (written `Wrap.Words`, see `insertText`), for
		// `bool` `true` and `false`, `none` for an optional; the names in scope
		// whose type is the expected one or one it admits (a branch of a union,
		// what satisfies an interface), the functions returning such a value,
		// and the types themselves, made with `T{...}` or `new T(...)`; `self`
		// in a type it fits; in a `!T` function an `error` as well. Only what is
		// known not to fit is left out (`fits`): a name whose type this layer
		// cannot tell stays; a declaration the offset is in (`let n = f(|`)
		// does not. A type parameter left open, `any` and a kind (`component`)
		// take anything: every visible name.
		internal def typedValues(file FileSymbols, offset int, expected TypeRef) Symbol[] {
			let out Symbol[]
			let (inner, optional, fallible) = unwrapExpected(expected)
			return visibleAt(file, offset) when takesAnything(inner)
			let wants MetaConstraint[]
			addConstraints(inner.file, inner.node, wants, 0)
			wants.push(MetaConstraint{written: expected}) when optional
			if fallible {
				// `return err` in a function that can fail.
				let failure = first(workspace.lookup("builtin", "error"))
				wants.push(MetaConstraint{symbol: failure}) unless failure is none
			}
			let kind = typeRefSymbol(inner)
			addImplicit(file, inner, kind, wants)
			let want = Expected{wants: wants, plain: inner, spelled: primitiveSpelling(inner), symbol: kind, function: isFunctionType(inner, kind)}
			let isEnum = false
			if !(kind is none) && kind.kind == SymbolKind.Enum {
				isEnum = true
				for let (_, m) in members(homeOf(kind, file), kind) {
					out.push(m) when m.kind == SymbolKind.EnumMember
				}
			}
			if isBool(inner, kind) {
				out.push(keywordValue(file, "true"))
				out.push(keywordValue(file, "false"))
			}
			out.push(keywordValue(file, "none")) when optional
			let own = workspace.enclosingType(file, offset)
			out.push(keywordValue(file, "self")) when !(own is none) && declarationFits(own, want)
			let seen map<string, bool>
			for let (_, s) in out {
				seen[s.name] = true
			}
			for let (_, s) in visibleAt(file, offset) {
				continue when seen.hasKey(s.name)
				continue when isBeingDeclared(s, offset)
				// The compiler's own hooks (`__tx_participant`) are not written by
				// hand; its constants (`__name__`, `__file_name__`) are.
				continue when s.name.startsWith("__") && !s.name.endsWith("__")
				// A type imported by name (`use ui::(Font)`) is the type.
				let named = importedType(s)
				if isTypeLike(named.kind) {
					continue when isEnum || named.kind == SymbolKind.Interface || named.kind == SymbolKind.Datatype
					continue unless admitsAny("", named, none, wants)
				} else {
					continue unless fits(file, s, want)
				}
				seen[s.name] = true
				out.push(s)
			}
			return out
		}

		// isBool is true for an expected `bool`: the prelude's, or the
		// primitive when no prelude declares it.
		internal def isBool(ref TypeRef, kind ?Symbol) bool {
			return false unless ref.node.kind() == SyntaxKind.NamedType && ref.node.text() == "bool"
			return kind is none || kind.path == "builtin.bool"
		}

		// importedType is the type an import by name brings in, the symbol
		// itself for anything else.
		internal def importedType(s Symbol) Symbol {
			return s unless s.kind == SymbolKind.Import && s.imported.len() > 0
			for let (_, t) in workspace.lookup(s.moduleName, s.imported) {
				return t when isTypeLike(t.kind)
			}
			return s
		}

		// takesAnything is true for a type every value fits, as far as this
		// layer can tell: a type parameter nothing binds, `any`, and a kind
		// (`component`, `service`, `style`), which takes every declaration of
		// that kind.
		internal def takesAnything(ref TypeRef) bool {
			return true when isTypeParameterRef(ref)
			return false unless ref.node.kind() == SyntaxKind.NamedType
			return ref.node.text() := "any" || "component" || "service" || "style" || "type"
		}

		// unwrapExpected is the type a value of `expected` is written as, its
		// `?`, `!` and `async` taken off and its type parameters followed, and
		// whether it was optional and whether it could fail.
		internal def unwrapExpected(expected TypeRef) (TypeRef, bool, bool) {
			let (optional, fallible) = (false, false)
			let ref = boundOnly(expected)
			let node = ref.node
			for let i = 0; i < 8; i++ {
				// A type in parentheses (`?(def())`) is that type.
				break unless node.kind() == SyntaxKind.ModifiedType || isParenthesized(node)
				let modifiers = modifiersOf(node)
				optional = true when modifiers.contains("?")
				fallible = true when modifiers.contains("!")
				let inner = firstNonToken(node)
				break when inner is none
				ref = boundOnly(TypeRef{file: ref.file, node: inner, bindings: ref.bindings})
				node = ref.node
			}
			return (followBindings(ref), optional, fallible)
		}

		// fits is true when a value named by `s` may be what is expected: by
		// its written type (a function by its return type), else by the type of
		// its initializer (`let n = 3` is a number, `let w = Wrap.None` a
		// Wrap), and when neither tells its type.
		internal def fits(file FileSymbols, s Symbol, want Expected) bool {
			if s.kind == SymbolKind.Function || s.kind == SymbolKind.Method {
				// Named where a function is asked for, it is the value.
				return true when want.function
				let ret = returnRef(homeOf(s, file), s)
				return false when ret is none || returnsNothing(ret)
				return writtenFits(ret, want)
			}
			if s.kind == SymbolKind.Import {
				// A module is no value; a value imported by name is judged as its
				// declaration.
				return false when s.imported.len() == 0
				let target = first(workspace.lookup(s.moduleName, s.imported))
				return true when target is none
				return fits(file, target, want)
			}
			return false unless s.kind := SymbolKind.Local || SymbolKind.Const || SymbolKind.Parameter || SymbolKind.Field || SymbolKind.Property
			let written = symbolTypeRef(file, s, 0)
			if !(written is none) {
				// `any` fits where it was narrowed (`if v is float`): a local's
				// or a parameter's, not a constant's (`__caller__ ?any`).
				let (plain, _, _) = unwrapExpected(written)
				return false when isAnyType(plain) && !(s.kind := SymbolKind.Local || SymbolKind.Parameter)
				return writtenFits(written, want)
			}
			let t = typeSymbolOf(file, s)
			return true when t is none
			return declarationFits(t, want)
		}

		// wantsNumber is true when a numeric primitive is among the
		// constraints.
		internal def wantsNumber(wants MetaConstraint[]) bool {
			for let (_, w) in wants {
				return true when w.primitive.len() > 0 && isNumberName(w.primitive)
			}
			return false
		}

		// returnsNothing is true for a function's `none` or `!none`: its call
		// gives no value.
		internal def returnsNothing(ret TypeRef) bool {
			let (plain, _, _) = unwrapExpected(ret)
			return plain.node.kind() == SyntaxKind.NamedType && plain.node.text() == "none"
		}

		// writtenFits is true when a value of the written type may be what is
		// expected. This layer does not follow narrowing, so its `?`, `!` and
		// `async` are taken off (`return v` after `return x when v is none` is
		// the plain type), and a wider type that may hold the expected one
		// fits (`let rsa RSAPrivateKey = key` after `if key is RSAPrivateKey`);
		// nor the conversions between numbers, so a number fits any number.
		// `any`, a type parameter and a kind may be anything.
		internal def writtenFits(written TypeRef, want Expected) bool {
			let (plain, _, _) = unwrapExpected(written)
			if isTypeParameterRef(plain) {
				// `def parseInt<T: Integer>() T`: what its bound admits.
				let param = typeSymbol(plain.file, plain.node)
				return true when param is none
				let bound = boundOf(param.node)
				return true when bound is none
				return writtenFits(TypeRef{file: homeOf(param, plain.file), node: bound, bindings: noBindings()}, want)
			}
			return true when takesAnything(plain)
			if plain.node.kind() == SyntaxKind.Name || plain.node.kind() == SyntaxKind.Member {
				// A type a cast or a construction names (`int(x)`, `string(bytes)`).
				return wantsNumber(want.wants) when isNumberName(plain.node.text())
				let named = typeRefSymbol(plain)
				return true when named is none
				return declarationFits(named, want)
			}
			// A function value where a function is asked for: its signature is
			// the compiler's to check.
			return true when want.function && isFunctionType(plain, typeRefSymbol(plain))
			let spelled = primitiveSpelling(plain)
			return wantsNumber(want.wants) when spelled.len() > 0 && isNumberName(spelled)
			return true when admitsWritten(plain, want.wants) || admitsWritten(written, want.wants)
			let held = typeSymbol(plain.file, plain.node)
			return false when held is none || !mayHoldOthers(held)
			let theirs MetaConstraint[]
			addConstraints(plain.file, plain.node, theirs, 0)
			return admitsAny(want.spelled, want.symbol, want.plain, theirs)
		}

		// declarationFits is true when a value of the type declaration `t`
		// may be what is expected; the prelude's `Number` stands for every
		// numeric primitive, its `string` for `string`, and a wider type may
		// hold the expected one.
		internal def declarationFits(t Symbol, want Expected) bool {
			return wantsNumber(want.wants) when t.path == "builtin.Number"
			let spelled = t.path == "builtin." + t.name ?? (t.name, "")
			return true when admitsAny(spelled, t, none, want.wants)
			return false unless mayHoldOthers(t)
			let home = workspace.file(t.file)
			return false when home is none
			let theirs MetaConstraint[]
			addSymbolConstraint(home, t, theirs, 0)
			return admitsAny(want.spelled, want.symbol, want.plain, theirs)
		}

		// addImplicit adds what a type's `@implicit` constructor takes: a
		// value of its one parameter's type converts (`let secret
		// Secret<string> = password`).
		internal def addImplicit(file FileSymbols, expected TypeRef, kind ?Symbol, wants MetaConstraint[]) {
			return when kind is none || !isTypeLike(kind.kind)
			for let (_, made) in membersNamed(homeOf(kind, file), kind, "new") {
				continue unless hasAnnotation(made, "implicit")
				let names = parameterNames(made.node)
				continue unless names.len() == 1
				let param = homeOf(made, file).symbolAt(names[0].start())
				continue when param is none
				// The parameter's type with the expected type's arguments for the
				// type's parameters (`T` of `Secret<string>` is `string`).
				let written = declaredType(param)
				continue when written is none
				let plain = followBindings(TypeRef{file: homeOf(param, file), node: written, bindings: bindingsFor(expected, kind)})
				addConstraints(plain.file, plain.node, wants, 0) unless takesAnything(plain)
			}
		}

		// isAnyType is true for `any`.
		internal def isAnyType(ref TypeRef) bool {
			return ref.node.kind() == SyntaxKind.NamedType && ref.node.text() == "any"
		}

		// isFunctionType is true for an expected function type (`def
		// (Event)`, a `type` alias of one).
		internal def isFunctionType(ref TypeRef, kind ?Symbol) bool {
			return true when ref.node.kind() == SyntaxKind.FuncType
			return false when kind is none
			return isFunctionAlias(kind)
		}

		// mayHoldOthers is true for a type a value of another type can be:
		// an interface, a datatype, a union or an intersection.
		internal def mayHoldOthers(t Symbol) bool {
			return true when t.kind == SymbolKind.Interface || t.kind == SymbolKind.Datatype || t.kind == SymbolKind.Union
			return false unless t.kind == SymbolKind.Type
			let aliased = aliasTarget(t.node)
			return !(aliased is none) && (aliased.kind() == SyntaxKind.UnionType || aliased.kind() == SyntaxKind.IntersectionType)
		}

		// keywordValue is a value written as a keyword (`true`, `false`,
		// `none`), as a completion.
		internal def keywordValue(file FileSymbols, word string) Symbol {
			let made = new Symbol(SymbolKind.Const, word, file.tree.root(), 0, 0)
			made.file = file.path
			return made
		}

		// insertText is what a completion is written as at the offset: its
		// name, and for an enum member the enum's name before it as the file
		// names it (`Wrap.Words`, `ui.Wrap.Words` when only the module is
		// imported), except after a `.` (`Alignment.|`), where the name alone
		// completes it.
		def insertText(file FileSymbols, offset int, symbol Symbol) string {
			// A declaration keyword or modifier is followed by what it leads to.
			return symbol.name + " " when symbol.kind == SymbolKind.Keyword && !typeKeywords.includes(symbol.name)
			return symbol.name unless symbol.kind == SymbolKind.EnumMember
			// After `Alignment.` the member's own name is what is missing.
			return symbol.name unless receiverBefore(file, offset) is none
			let owner = symbol.parent
			return symbol.name when owner is none
			let named = first(workspace.resolveType(file, owner.name, offset))
			return owner.name + "." + symbol.name when !(named is none) && (sameDeclaration(named, owner) || named.path == owner.path)
			let dot = owner.path.lastIndexOf(".")
			if dot > 0 {
				let moduleName = owner.path[:dot]
				let imports Symbol[]
				collectModuleImports(file.scopeAt(offset), imports)
				for let (_, imp) in imports {
					return imp.name + "." + owner.name + "." + symbol.name when imp.moduleName == moduleName
				}
			}
			return owner.name + "." + symbol.name
		}
	}

	// Expected is what a value is asked to be: the constraints its type
	// gives, and that type plain (its `?` and `!` taken off), as a
	// primitive's spelling and as a declaration.
	internal struct Expected {
		wants    MetaConstraint[]
		plain    TypeRef
		spelled  string
		symbol   ?Symbol
		// A function is asked for: functions and methods are values.
		function bool
	}

	// enclosingFunction is the nearest function or lambda around the node.
	internal def enclosingFunction(node SyntaxNode) ?SyntaxNode {
		let at = node.parent
		for {
			return none when at is none
			return at when at.kind() == SyntaxKind.FuncDecl || at.kind() == SyntaxKind.Lambda
			at = at.parent
		}
	}

	// isParenthesized is true for a type in parentheses, a tuple of one.
	internal def isParenthesized(node SyntaxNode) bool {
		return false unless node.kind() == SyntaxKind.TupleType
		let types = 0
		for let (_, c) in node.children() {
			types++ unless c.isToken()
		}
		return types == 1
	}

	// hasAnnotation is true for a declaration annotated `@name`.
	internal def hasAnnotation(s Symbol, name string) bool {
		for let (_, a) in s.annotations {
			for let (_, c) in a.children() {
				continue unless c.kind() == SyntaxKind.Name || c.kind() == SyntaxKind.QualifiedName
				let last = c.lastToken()
				return true when !(last is none) && last.text() == name
			}
		}
		return false
	}

	// isBeingDeclared is true for a local, constant or field whose
	// declaration holds the offset: its value cannot name it.
	internal def isBeingDeclared(s Symbol, offset int) bool {
		return false unless s.kind := SymbolKind.Local || SymbolKind.Const || SymbolKind.Field
		// A binding whose node is its whole scope (`onerror (err error) {
		// ... }`, a loop variable) is in scope there.
		return false unless s.node.kind() == SyntaxKind.Field
		// A declaration whose value is not written yet ends before the space
		// the offset follows.
		return s.node.start() <= offset && offset <= s.node.fullEnd()
	}

	// isValueSeparator is true for the token after which `holder` takes its
	// value: the `:` of a struct literal entry, the `=` of an assignment, a
	// named argument or a declaration, the `return` keyword.
	internal def isValueSeparator(holder SyntaxNode, sep SyntaxNode) bool {
		switch holder.kind() {
			case SyntaxKind.FieldInit:
				return sep.token() == TokenKind.Colon
			case SyntaxKind.Assign, SyntaxKind.Arg, SyntaxKind.Field:
				return sep.token() == TokenKind.Assign
			case SyntaxKind.Return:
				return sep.token() == TokenKind.Return
			default:
				return false
		}
	}
}
