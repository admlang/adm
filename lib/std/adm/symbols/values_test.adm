partial module std.adm.symbols {
	use (
		std.adm.syntax::(parse)
		std.testing
	)

	internal def valuesLibSource() string {
		return fixture("""
module ui «
	enum Wrap «
		None,
		Words,
		Anywhere,
	»
	struct Font «
		size int
	»
	type Wrapped<T> «
		@implicit
		def new(v T) «»
	»
	struct Para «
		wrap  Wrap
		bold  bool
		font  ?Font
		count int
		label string
	»
»
""")
	}

	internal def valuesAppSource() string {
		return fixture("""
module app «
	use ui
	use ui::(Para, Font)

	def big() Font «
		return Font«size: 2»
	»

	def count() int «
		return 1
	»

	def make(p Para, w ui.Wrap) ui.Wrap «
		let base Font = big()
		let n = 3
		let title = "t"
		let a = Para«wrap: »
		let b = Para«wrap: W»
		let c = Para«bold: »
		let d = Para«font: »
		let e = Para«count: »
		let f = Para«label: »
		let g = Para«wrap: ui.Wrap.None, »
		take(width = )
		let h Font = 
		let k ui.Wrapped<int> = 
		return 
	»

	def take(width int) «»

	def put(p Para) «»

	def put(f Font) «»

	def nested() «
		let deep = put(«wrap: ui.Wrap.Words»)
		let after = ui.Wrap.
	»
»
""")
	}

	internal def valuesNamedSource() string {
		return fixture("""
module named «
	use ui::(Wrap, Para)

	def pick() Para «
		return Para«wrap: »
	»
»
""")
	}

	check "Values" {
		@test()
		def TestTypedValueCompletions() {
			let w = new Workspace()
			w.add("builtin.adm", parse(preludeSource()))
			w.add("ui.adm", parse(valuesLibSource()))
			let source = valuesAppSource()
			let app = w.add("app.adm", parse(source))
			let nav = new Navigator(w)
			let after = def (text string) string {
				return namesOf(nav.completionsAt(app, source.indexOf(text) + text.len()))
			}
			// An enum field takes the enum's members and what holds a Wrap, typed
			// or not (a function returning one too); the members are written
			// through the import that sees the enum.
			assert after("Para\{wrap: ") == "None,Words,Anywhere,w,make"
			assert after("Para\{wrap: W") == "None,Words,Anywhere,w,make"
			let members = nav.completionsAt(app, source.indexOf("Para\{wrap: ") + 11)
			assert nav.insertText(app, source.indexOf("Para\{wrap: ") + 11, members[1]) == "ui.Wrap.Words"
			assert nav.insertText(app, 0, members[3]) == "w"
			// `bool` is true or false; an optional takes none, the values of its
			// type (a function returning one) and the type itself.
			assert after("Para\{bold: ") == "true,false"
			assert after("Para\{font: ") == "none,base,Font,big"
			// A number: an untyped local holding one and a function returning
			// one, never the local being declared; a string.
			assert after("Para\{count: ") == "n,count"
			assert after("Para\{label: ") == "title"
			// The keys of a literal are still the fields left.
			assert after("ui.Wrap.None, ") == "bold,font,count,label"
			// A named argument, a typed `let`, a `return`.
			assert after("take(width = ") == "n,count"
			assert after("let h Font = ") == "base,Font,big"
			// An `@implicit` constructor's parameter type converts.
			assert after("let k ui.Wrapped<int> = ") == "n,count"
			let bare = source.indexOf("return \n") + 7
			assert namesOf(nav.completionsAt(app, bare)) == "None,Words,Anywhere,w,make"
			// After `ui.Wrap.` a member is written by its own name.
			let dotted = source.indexOf("ui.Wrap.\n") + 8
			let listed = nav.completionsAt(app, dotted)
			assert listed.len() > 0 && nav.insertText(app, dotted, listed[0]) == listed[0].name
			// An overload chosen for an untyped literal argument: the literal
			// takes its type from the call, which is not scored by it again.
			assert nav.definitionAt(app, source.indexOf("put(\{wrap")).len() == 1
			// Where the enum is imported by name it is written by its name.
			let namedSource = valuesNamedSource()
			let named = w.add("named.adm", parse(namedSource))
			let offset = namedSource.indexOf("wrap: ") + 6
			let found = nav.completionsAt(named, offset)
			assert namesOf(found) == "None,Words,Anywhere" && nav.insertText(named, offset, found[0]) == "Wrap.None"
		}
	}
}
