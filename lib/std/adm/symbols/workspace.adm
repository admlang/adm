partial module std.adm.symbols {
	use std.adm.syntax::(SyntaxTree)

	// Workspace is the symbols of many files together: the parts of each
	// module, the declarations a `use` reaches, and stable identities. A
	// declaration keeps its `id` across edits that leave its path (module,
	// enclosing types, name, position among its overloads in its file).
	// What keeps a declaration's id across edits: its kind, path and file, and
	// which of the declarations with those three it is, in source order.
	internal struct IdKey {
		kind    SymbolKind
		path    string
		file    string
		ordinal int
	}

	partial type Workspace {
		// Unit declarations by symbol (`km`), across every file.
		internal units           map<string, Symbol[]>
		files                    map<string, FileSymbols>
		internal modules         map<string, Symbol[]>
		internal ids             map<IdKey, int>
		internal nextId          int                                = 1
		// Counts the adds and removes, so a Navigator knows when an index
		// it built over the workspace is stale.
		version                  int                                = 0
		// Files registered but not yet parsed: their source by path, and
		// the paths each module name has among them.
		internal pendingSources  map<string, string>
		internal pendingByModule map<string, string[]>
		// The module symbol each registered file's header declares, by path,
		// for the files asked for before they were parsed (`headerSymbol`).
		internal headers         map<string, Symbol>
		// Each module's declarations by name (`lookup`), while the workspace
		// is at `lookupVersion`.
		internal lookupIndex     map<string, map<string, Symbol[]>>
		internal lookupVersion   int                                = -1
		// What the tokens of each registered file not parsed yet say (its
		// top-level declarations and imports), for the files lexed so far.
		internal lexed           map<string, LexedFile>
		// True while a file a lookup reached is parsed (`ensureFile`).
		internal loading         bool                               = false

		// add analyzes a file (again, when it was added before) and
		// registers its modules.
		def add(path string, tree SyntaxTree) FileSymbols {
			return addAnalyzed(path, analyze(tree, path))
		}

		// addAnalyzed is add for a file already analyzed: what `analyze`
		// made of its tree, on another task when files load together.
		internal def addAnalyzed(path string, file FileSymbols) FileSymbols {
			let before = files.get(path)
			forget(path)
			version++
			file.shape = shapeOf(file)
			// A file parsed because a lookup reached its module changes no
			// answer given before; one added, or edited into another shape,
			// may.
			if before is none {
				shapes++ unless loading
			} else if before.shape != file.shape {
				shapes++
			}
			files[path] = file
			noteNames(path, before)
			for let (_, unit) in file.units {
				continue unless unit.kind == SymbolKind.Module
				if modules.hasKey(unit.path) {
					modules[unit.path].push(unit)
				} else {
					modules[unit.path] = [unit]
				}
			}
			assignIds(file)
			for let (_, d) in file.declarations {
				continue unless d.kind == SymbolKind.Unit
				if units.hasKey(d.name) {
					units[d.name].push(d)
				} else {
					units[d.name] = [d]
				}
			}
			return file
		}

		// update is add for a file whose tree changed.
		def update(path string, tree SyntaxTree) FileSymbols {
			return add(path, tree)
		}

		// remove forgets a file and the module parts it held.
		def remove(path string) {
			shapes++ when forget(path)
		}

		// forget drops a file and the module parts it held; true when it
		// was parsed or registered.
		internal def forget(path string) bool {
			let registered = pendingSources.hasKey(path)
			forgetPending(path)
			let file = files.get(path)
			return registered when file is none
			version++
			for let (_, unit) in file.units {
				continue unless modules.hasKey(unit.path)
				let kept Symbol[]
				for let (_, p) in modules[unit.path] {
					kept.push(p) unless p == unit
				}
				modules[unit.path] = kept
			}
			for let (_, d) in file.declarations {
				continue unless d.kind == SymbolKind.Unit && units.hasKey(d.name)
				let kept Symbol[]
				for let (_, u) in units[d.name] {
					kept.push(u) unless u.file == path
				}
				units[d.name] = kept
			}
			files = files.delete(path)
			noteNames(path, file)
			return true
		}

		// unitNamed is every unit declaration a quantity literal's symbol
		// names, across the workspace: `m`, or `km` as the `k` prefix on a
		// unit declared with `Prefixes.SI`. Unit symbols need no import.
		def unitNamed(name string) Symbol[] {
			let out Symbol[]
			if units.hasKey(name) {
				for let (_, u) in units[name] {
					out.push(u)
				}
			}
			for let (_, table) in ["SI", "Data"] {
				for let (_, prefix) in unitPrefixes(table) {
					continue unless name.startsWith(prefix) && name.len() > prefix.len()
					let rest = name[prefix.len():]
					continue unless units.hasKey(rest)
					for let (_, u) in units[rest] {
						out.push(u) when u.unitPrefixes == table
					}
				}
			}
			return out
		}

		// declarationsOfKind is every declaration of the kind across the
		// workspace's files, in file order.
		def declarationsOfKind(kind SymbolKind) Symbol[] {
			let out Symbol[]
			for let (_, file) in allFiles() {
				for let (_, d) in file.declarations {
					out.push(d) when d.kind == kind
				}
			}
			return out
		}

		// file is the symbols of a path, none when it was not added; a
		// registered file is parsed first.
		def file(path string) ?FileSymbols {
			ensureFile(path)
			return files.get(path)
		}

		// parts is every part of a module (one per file), in the order the
		// files were added.
		def parts(name string) Symbol[] {
			ensureModule(name)
			let found = modules.get(name)
			return [] when found is none
			return found
		}

		// exports is every declaration of a module, all parts together, the
		// internal ones included.
		def exports(name string) Symbol[] {
			let out Symbol[]
			for let (_, part) in parts(name) {
				for let (_, m) in part.members {
					out.push(m)
				}
			}
			return out
		}

		// lookup is every declaration of a module named `name`.
		def lookup(moduleName string, name string) Symbol[] {
			let all = parts(moduleName)
			let out Symbol[]
			return out when all.len() == 0
			let found = moduleIndex(moduleName, all).get(name)
			return out when found is none
			for let (_, m) in found {
				out.push(m)
			}
			return out
		}

		// moduleIndex is the module's declarations by name, built once while
		// the workspace is unchanged (`parts` may load files first, so it is
		// asked after them).
		internal def moduleIndex(moduleName string, all Symbol[]) map<string, Symbol[]> {
			if lookupVersion != version {
				let fresh map<string, map<string, Symbol[]>>
				lookupIndex = fresh
				lookupVersion = version
			}
			let kept = lookupIndex.get(moduleName)
			return kept unless kept is none
			let built map<string, Symbol[]>
			for let (_, part) in all {
				for let (_, m) in part.members {
					continue when m.kind == SymbolKind.Check
					if built.hasKey(m.name) {
						built[m.name].push(m)
					} else {
						built[m.name] = [m]
					}
				}
			}
			lookupIndex[moduleName] = built
			return built
		}

		// resolve is what `name` means at `offset` of a file, across the
		// workspace: a declaration of the file's own scopes, one of the
		// module's other parts, what a named import brings in, the module an
		// import binds (the Import symbol itself), or the first `*` import
		// whose module declares the name, then the prelude (module `builtin`,
		// when its files were added). Empty for an undefined name.
		def resolve(file FileSymbols, name string, offset int) Symbol[] {
			let found = file.resolve(name, offset)
			return found when found.len() > 0 && found[0].kind != SymbolKind.Import
			// Inside a type's body, the members its other parts declare.
			let fromParts = partMembers(file, name, offset)
			return fromParts when fromParts.len() > 0
			// The module's declarations in its other files come before imports.
			let unit = file.unitAt(offset)
			if !(unit is none) {
				let own = ownDeclarations(unit, name)
				return own when own.len() > 0
			}
			for let (_, imp) in found {
				if imp.wildcard {
					let hit = lookup(imp.moduleName, name)
					return hit when hit.len() > 0
					continue
				}
				return lookup(imp.moduleName, imp.imported) when imp.imported.len() > 0
				return [imp]
			}
			// A unit's symbol, from wherever it is declared.
			let unitDecls = unitNamed(name)
			return unitDecls when unitDecls.len() > 0
			// The prelude, when its files are in the workspace.
			return lookup("builtin", name)
		}

		// resolveCallable is what a called `name(...)` means at `offset`: the
		// nearest functions, methods or types of the name, looking past the
		// values that stand nearer (a local `added` does not hide the
		// function `added`, as the compiler's call lookup does not); then the
		// module's own declarations, the `*` imports and the prelude. Empty
		// when none is visible.
		def resolveCallable(file FileSymbols, name string, offset int) Symbol[] {
			let wildcards Symbol[]
			let scope = file.scopeAt(offset)
			for {
				let found Symbol[]
				for let (_, s) in scope.lookup(name, offset) {
					if s.kind == SymbolKind.Import && !s.wildcard && s.imported.len() > 0 {
						found = callablesAmong(lookup(s.moduleName, s.imported))
						break when found.len() > 0
						continue
					}
					found.push(s) when isCallableKind(s.kind)
				}
				return found when found.len() > 0
				for let (_, w) in scope.wildcards {
					wildcards.push(w)
				}
				let up = scope.parent
				break when up is none
				scope = up
			}
			let fromParts = callablesAmong(partMembers(file, name, offset))
			return fromParts when fromParts.len() > 0
			let own = callablesAmong(ownDeclarations(file.unitAt(offset), name))
			return own when own.len() > 0
			for let (_, w) in wildcards {
				let hit = callablesAmong(lookup(w.moduleName, name))
				return hit when hit.len() > 0
			}
			return callablesAmong(lookup("builtin", name))
		}

		// callablesAmong is the functions, methods and type-like declarations
		// among the symbols.
		internal def callablesAmong(found Symbol[]) Symbol[] {
			let out Symbol[]
			for let (_, s) in found {
				out.push(s) when isCallableKind(s.kind)
			}
			return out
		}

		// resolveType is what `name` means where a type is written: the
		// nearest type-like declaration, type parameter or module import of
		// that name, past the values that share it (a `paint` method beside a
		// `paint.ShadowCache` field, a `bool` accessor beside a `bool` type);
		// a name imported by name leads to the type it names; then the
		// module's own declarations, the `*` imports and the prelude. Empty
		// for a name that is no type.
		def resolveType(file FileSymbols, name string, offset int) Symbol[] {
			return resolveType(file, file.scopeAt(offset), name, offset)
		}

		// resolveType is what `name` means where a type is written, looking
		// from the scope outwards: from a declaration's enclosing scope, past
		// what the declaration itself declares (a meta's own type
		// parameters).
		def resolveType(file FileSymbols, start Scope, name string, offset int) Symbol[] {
			let wildcards Symbol[]
			let scope = start
			for {
				for let (_, s) in scope.lookup(name, offset) {
					return [s] when isTypeLike(s.kind) || s.kind == SymbolKind.TypeParameter
					continue unless s.kind == SymbolKind.Import && !s.wildcard
					return [s] when s.imported.len() == 0
					let named = typesAmong(lookup(s.moduleName, s.imported))
					return named when named.len() > 0
				}
				for let (_, w) in scope.wildcards {
					wildcards.push(w)
				}
				let up = scope.parent
				break when up is none
				scope = up
			}
			let own = typesAmong(ownDeclarations(file.unitAt(offset), name))
			return own when own.len() > 0
			for let (_, w) in wildcards {
				let hit = typesAmong(lookup(w.moduleName, name))
				return hit when hit.len() > 0
			}
			return typesAmong(lookup("builtin", name))
		}

		// typesAmong is the type-like declarations and type parameters among
		// the symbols.
		internal def typesAmong(found Symbol[]) Symbol[] {
			let out Symbol[]
			for let (_, s) in found {
				out.push(s) when isTypeLike(s.kind) || s.kind == SymbolKind.TypeParameter
			}
			return out
		}

		// partMembers is what `name` means as a bare member name inside the
		// body of a partial type: the members named so by the type's parts in
		// other files (a method of `partial type Parser` in parser.adm,
		// called from parser_expr.adm).
		internal def partMembers(file FileSymbols, name string, offset int) Symbol[] {
			let out Symbol[]
			let owner = enclosingType(file, offset)
			return out when owner is none
			let dot = owner.path.lastIndexOf(".")
			return out when dot < 0
			for let (_, part) in lookup(owner.path[:dot], owner.name) {
				continue unless part.kind == owner.kind
				continue when part.node.same(owner.node) && part.file == owner.file
				for let (_, m) in part.member(name) {
					out.push(m)
				}
			}
			return out when out.len() > 0
			// The members of the prelude base every enum, component and
			// service has (`disabled`, `redraw()`, `status`).
			let baseName = builtinBaseName(owner.kind)
			return out when baseName.len() == 0
			for let (_, base) in lookup("builtin", baseName) {
				for let (_, m) in base.member(name) {
					out.push(m)
				}
			}
			return out
		}

		// enclosingType is the type-like declaration whose body holds the
		// offset (what `self` means there), none outside every type body.
		def enclosingType(file FileSymbols, offset int) ?Symbol {
			let scope = file.scopeAt(offset)
			for {
				if scope.kind == ScopeKind.Members {
					// The scope is the body; the declaration is its parent.
					let decl = scope.node.parent
					return none when decl is none
					for let (_, d) in file.declarations {
						return d when isTypeLike(d.kind) && d.node.same(decl)
					}
					return none
				}
				let up = scope.parent
				return none when up is none
				scope = up
			}
		}

		// unitPrefixes is the compiler's prefix table of that name
		// (`internal/units/prefixes.go`): the SI prefixes from quecto to
		// quetta, or the decimal-from-kilo and binary prefixes of data sizes.
		internal def unitPrefixes(table string) string[] {
			return ["q", "r", "y", "z", "a", "f", "p", "n", "µ", "m", "c", "d", "da", "h", "k", "M", "G", "T", "P", "E", "Z", "Y", "R", "Q"] when table == "SI"
			return ["k", "M", "G", "T", "P", "E", "Ki", "Mi", "Gi", "Ti", "Pi", "Ei"] when table == "Data"
			return []
		}

		// ownDeclarations is what the module of the unit declares as `name`
		// across its parts; nothing for a unit that is not a module.
		internal def ownDeclarations(unit ?Symbol, name string) Symbol[] {
			let nothing Symbol[]
			return nothing when unit is none
			return nothing unless unit.kind == SymbolKind.Module
			return lookup(unit.path, name)
		}

		// memberOf is what `name` means after `symbol.`: a declaration of
		// the module an import binds, or a member of the symbol.
		def memberOf(symbol Symbol, name string) Symbol[] {
			return lookup(symbol.moduleName, name) when symbol.kind == SymbolKind.Import && !symbol.wildcard && symbol.imported.len() == 0
			return symbol.member(name)
		}

		// assignIds gives every declaration of the file its stable id: the
		// one its key had before, else a new one.
		internal def assignIds(file FileSymbols) {
			// How many declarations of each kind and path came before.
			let seen map<IdKey, int>
			for let (_, sym) in file.declarations {
				let base = IdKey{kind: sym.kind, path: sym.path, file: file.path, ordinal: 0}
				let before = seen.get(base)
				let ordinal = before is none ?? (0, before)
				seen[base] = ordinal + 1
				let key = IdKey{kind: sym.kind, path: sym.path, file: file.path, ordinal: ordinal}
				let held = ids.get(key)
				if held is none {
					sym.id = nextId
					ids[key] = nextId
					nextId++
				} else {
					sym.id = held
				}
			}
		}
	}
}
