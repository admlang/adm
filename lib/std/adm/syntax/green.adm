partial module std.adm.syntax {
	use std.adm.lexer::(TokenKind)

	// Trivia is a run of text between tokens: white space, a line break or
	// a comment.
	struct Trivia {
		kind TriviaKind
		text string
	}

	// Diagnostic is what the parser found wrong, at character offsets
	// relative to the start of the green element that holds it (`end`
	// exclusive); the tree gives absolute positions.
	struct Diagnostic {
		message string
		start   int
		end     int
	}

	// Green is a position-free, immutable element of the tree: a token
	// (`kind == SyntaxKind.Token`) with its text and trivia, or a node with
	// its children. `width` is the full width in characters, trivia included.
	// A missing token is a token the parser expected and did not find: zero
	// width, no text. Dispatch on `kind`; two elements are the same element
	// when they are the same object.
	type Green {
		kind     SyntaxKind
		token    TokenKind    = TokenKind.EOF
		text     string       = ""
		leading  Trivia[]
		trailing Trivia[]
		children Green[]
		errors   Diagnostic[]
		width    int          = 0
		missing  bool         = false
		// Whether a diagnostic hangs on this element or one below it.
		troubled bool         = false

		// A token with its trivia.
		def new(token TokenKind, text string, leading Trivia[], trailing Trivia[]) {
			self.kind = SyntaxKind.Token
			self.token = token
			self.text = text
			self.leading = leading
			self.trailing = trailing
			self.width = text.len() + triviaWidth(leading) + triviaWidth(trailing)
		}

		// A node over its children.
		def new(kind SyntaxKind, children Green[]) {
			self.kind = kind
			self.children = children
			let w = 0
			let anyTroubled = false
			for let (_, c) in children {
				w += c.width
				anyTroubled = anyTroubled || c.troubled
			}
			self.width = w
			self.troubled = anyTroubled
		}

		// isToken is true for a token, missing ones included.
		def isToken() bool {
			return kind == SyntaxKind.Token
		}

		// leadingWidth is the width of the leading trivia: the token's own,
		// or the first token's below a node.
		def leadingWidth() int {
			return triviaWidth(leading) when kind == SyntaxKind.Token
			let first = firstToken()
			return 0 when first is none
			return triviaWidth(first.leading)
		}

		// trailingWidth is the width of the trailing trivia: the token's
		// own, or the last token's below a node.
		def trailingWidth() int {
			return triviaWidth(trailing) when kind == SyntaxKind.Token
			let last = lastToken()
			return 0 when last is none
			return triviaWidth(last.trailing)
		}

		// firstToken is the first token below the element (itself for a
		// token); none for a node without tokens.
		def firstToken() ?Green {
			return self when kind == SyntaxKind.Token
			for let (_, c) in children {
				let t = c.firstToken()
				return t unless t is none
			}
			return none
		}

		// lastToken is the last token below the element (itself for a
		// token); none for a node without tokens.
		def lastToken() ?Green {
			return self when kind == SyntaxKind.Token
			for let i = children.len() - 1; i >= 0; i-- {
				let t = children[i].lastToken()
				return t unless t is none
			}
			return none
		}

		// fullText is the text of the element with its trivia.
		def fullText() string {
			return writeText("")
		}

		internal def writeText(out string) string {
			if kind == SyntaxKind.Token {
				for let (_, t) in leading {
					out += t.text
				}
				out += text
				for let (_, t) in trailing {
					out += t.text
				}
				return out
			}
			for let (_, c) in children {
				out = c.writeText(out)
			}
			return out
		}

		// withErrors is a copy of the element carrying `errors`.
		def withErrors(errors Diagnostic[]) Green {
			let copy = kind == SyntaxKind.Token ?? (new Green(token, text, leading, trailing), new Green(kind, children))
			copy.missing = missing
			copy.errors = errors
			copy.troubled = troubled || errors.len() > 0
			return copy
		}
	}

	// triviaWidth is the width of a trivia list.
	def triviaWidth(trivia Trivia[]) int {
		let w = 0
		for let (_, t) in trivia {
			w += t.text.len()
		}
		return w
	}

	// missingToken is a zero-width token of `kind` standing where the parser
	// expected one.
	def missingToken(kind TokenKind) Green {
		let t = new Green(kind, "", [], [])
		t.missing = true
		return t
	}
}
