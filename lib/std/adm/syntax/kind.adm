partial module std.adm.syntax {
	// SyntaxKind is the kind of a green element: `Token` for every token, or
	// the construct a node holds. The value is the kind's name.
	enum SyntaxKind {
		Token   = "Token",
		// Tokens that fit nowhere, kept so the tree stays lossless.
		Skipped = "Skipped",

		// Units and the file
		File        = "File",
		Module      = "Module",
		Application = "Application",
		Library     = "Library",
		Plugin      = "Plugin",
		Check       = "Check",
		Body        = "Body",

		// Declarations
		Use          = "Use",
		UseGroup     = "UseGroup",
		UseItem      = "UseItem",
		UseSymbols   = "UseSymbols",
		UseSymbol    = "UseSymbol",
		Attribute    = "Attribute",
		ConstDecl    = "ConstDecl",
		ConstGroup   = "ConstGroup",
		LetDecl      = "LetDecl",
		FuncDecl     = "FuncDecl",
		Params       = "Params",
		Param        = "Param",
		TypeParams   = "TypeParams",
		TypeParam    = "TypeParam",
		TypeDecl     = "TypeDecl",
		StructDecl   = "StructDecl",
		Field        = "Field",
		Property     = "Property",
		EnumDecl     = "EnumDecl",
		EnumMember   = "EnumMember",
		UnionDecl    = "UnionDecl",
		UnionMember  = "UnionMember",
		InterfaceDecl = "InterfaceDecl",
		DatatypeDecl = "DatatypeDecl",
		ServiceDecl  = "ServiceDecl",
		ComponentDecl = "ComponentDecl",
		ViewDecl     = "ViewDecl",
		StyleDecl    = "StyleDecl",
		Embedding    = "Embedding",
		Export       = "Export",
		RawBlock     = "RawBlock",

		// Types
		NamedType     = "NamedType",
		QualifiedName = "QualifiedName",
		TypeArgs      = "TypeArgs",
		ArrayType     = "ArrayType",
		MapType       = "MapType",
		TupleType     = "TupleType",
		ModifiedType  = "ModifiedType",
		FuncType      = "FuncType",
		UnionType     = "UnionType",
		IntersectionType = "IntersectionType",
		InlineStruct  = "InlineStruct",
		DimensionType = "DimensionType",

		// Statements
		Block         = "Block",
		ExprStmt      = "ExprStmt",
		Assign        = "Assign",
		Return        = "Return",
		Fail          = "Fail",
		If            = "If",
		Else          = "Else",
		For           = "For",
		Header        = "Header",
		LoopClause    = "LoopClause",
		Switch        = "Switch",
		Match         = "Match",
		Select        = "Select",
		Case          = "Case",
		Default       = "Default",
		Break         = "Break",
		Continue      = "Continue",
		Defer         = "Defer",
		Yield         = "Yield",
		Transaction   = "Transaction",
		Dispose       = "Dispose",
		Assert        = "Assert",
		Guard         = "Guard",
		OnError       = "OnError",
		Recover       = "Recover",
		Rollback      = "Rollback",
		Where         = "Where",
		Send          = "Send",
		MultiAssign   = "MultiAssign",
		Destructure   = "Destructure",
		Binding       = "Binding",
		StructPattern = "StructPattern",
		TuplePattern  = "TuplePattern",
		PatternField  = "PatternField",

		// Expressions
		Name          = "Name",
		Literal       = "Literal",
		InterpString  = "InterpString",
		Interpolation = "Interpolation",
		Paren         = "Paren",
		Tuple         = "Tuple",
		ArrayLit      = "ArrayLit",
		Row           = "Row",
		StructLit     = "StructLit",
		FieldInit     = "FieldInit",
		Unary         = "Unary",
		Binary        = "Binary",
		Junction      = "Junction",
		Choice        = "Choice",
		Call          = "Call",
		ComponentCall = "ComponentCall",
		Args          = "Args",
		Arg           = "Arg",
		Index         = "Index",
		Slice         = "Slice",
		Member        = "Member",
		Lambda        = "Lambda",
		New           = "New",
		Try           = "Try",
		Await         = "Await",
		Async         = "Async",
		Cast          = "Cast",
		ViewExpr      = "ViewExpr"
	}

	// TriviaKind is what a run of trivia is.
	enum TriviaKind {
		Whitespace   = "Whitespace",
		Newline      = "Newline",
		LineComment  = "LineComment",
		BlockComment = "BlockComment"
	}
}
