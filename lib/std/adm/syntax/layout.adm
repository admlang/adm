// The storage of std.adm.syntax trees: numbers in arrays, no object per
// token or node. A tree has one token table and one or more segments of
// nodes; the red nodes of std.adm.syntax read them.
internal partial module std.adm.syntax.layout {
	use (
		std.adm.lexer
		std.adm.syntax::(Diagnostic, SyntaxKind, Trivia, TriviaKind)
	)

	// A child of a node is an item: the index of a token of the table, of a
	// node of the segment or of a missing token of the segment, shifted left
	// two bits over its tag.
	const tokenTag = 0
	const nodeTag = 1
	const missingTag = 2

	// item is the child `index` of the kind `tag` names.
	def item(index int, tag int) int {
		return index << 2 | tag
	}

	// tagOf is the kind of an item's child: tokenTag, nodeTag or missingTag.
	def tagOf(item int) int {
		return item & 3
	}

	// itemIndex is the index an item's child has in its table.
	def itemIndex(item int) int {
		return item >> 2
	}

	// The flags of a token.
	//
	// lineBreakBefore: a line break lies between the token and the one
	// before it (the trivia split cannot tell that from a line break right
	// before the token).
	const lineBreakBefore byte = 1

	// The flags of a node.
	//
	// hasErrors: diagnostics hang on the node. troubled: on it or below it
	// (an unparsed body counts, since its diagnostics are not known yet).
	// unparsed: a function body an outline tree parses when it is read.
	// bareStart, bareEnd: the node's first (last) leaf is a missing token or
	// it has none, so its text starts (ends) where its full span does.
	// leafless: the node holds no token, missing ones included.
	const hasErrors byte = 1
	const troubled byte = 2
	const unparsed byte = 4
	const bareStart byte = 8
	const bareEnd byte = 16
	const leafless byte = 32

	// Tokens is every token of a source in order, EOF last, by index:
	// kind, flags, and the character offsets of its leading trivia, its
	// text and its text's end. Trivia is not a token: a token's leading
	// trivia runs from its full start to its start, its trailing trivia from
	// its end to the next token's full start. What follows a token up to and
	// including the first line break is its trailing trivia, the rest the
	// next token's leading trivia; the EOF token holds what ends the file.
	type Tokens {
		source     string
		// The source's length in characters.
		length     int
		kinds      byte[]
		flags      byte[]
		fullStarts int32[]
		starts     int32[]
		ends       int32[]

		// Lexes the source into the table.
		def new(source string) {
			self.source = source
			self.length = source.len()
			let lex = new lexer.Lexer(source, comments = true, whitespace = true)
			// Where the first line break since the last token ends, -1 when
			// none came yet.
			let split = -1
			let first = true
			for {
				let (kind, start, end) = lex.scan()
				switch kind {
					case lexer.TokenKind.Whitespace, lexer.TokenKind.Comment:
						continue
					case lexer.TokenKind.Newline:
						split = end when split < 0
						continue
					default:
				}
				let atEnd = kind == lexer.TokenKind.EOF
				let textStart = atEnd ?? (length, start)
				let textEnd = atEnd ?? (length, end)
				// The first token's trivia is all leading; after a token, the
				// trivia up to the first line break is that token's.
				let fullStart = first ?? (0, split >= 0 ?? (split, textStart))
				kinds.push(byte(kind.ordinal))
				flags.push((!first && split >= 0) ?? (lineBreakBefore, byte(0)))
				fullStarts.push(int32(fullStart))
				starts.push(int32(textStart))
				ends.push(int32(textEnd))
				first = false
				split = -1
				break when atEnd
			}
		}

		// A table over arrays already made: an edit's (spliceBlock, shifted).
		def new(source string, kinds byte[], flags byte[], fullStarts int32[], starts int32[], ends int32[]) {
			self.source = source
			self.length = source.len()
			self.kinds = kinds
			self.flags = flags
			self.fullStarts = fullStarts
			self.starts = starts
			self.ends = ends
		}

		// shifted is the table of `source`, this table's text with
		// `delta` characters more after token `from`'s full start: the
		// offsets of the tokens from `from` on move by delta. Kinds and
		// flags are shared.
		def shifted(source string, from int, delta int) Tokens {
			let full = fullStarts.clone()
			let at = starts.clone()
			let to = ends.clone()
			shift(full, from, full.len(), delta)
			shift(at, from, at.len(), delta)
			shift(to, from, to.len(), delta)
			return new Tokens(source, kinds, flags, full, at, to)
		}

		// count is the number of tokens, EOF included.
		def count() int {
			return kinds.len()
		}

		def kind(i int) lexer.TokenKind {
			return lexer.TokenKind(kinds[i])
		}

		def start(i int) int {
			return int(starts[i])
		}

		def end(i int) int {
			return int(ends[i])
		}

		// fullStart is where token `i` starts with its leading trivia; the
		// source's length for the index after the last token.
		def fullStart(i int) int {
			return length when i >= kinds.len()
			return int(fullStarts[i])
		}

		// fullEnd is where token `i` ends with its trailing trivia.
		def fullEnd(i int) int {
			return fullStart(i + 1)
		}

		def lineBreak(i int) bool {
			return flags[i] & lineBreakBefore != 0
		}

		// text is the source text of token `i`.
		def text(i int) string {
			return source[int(starts[i]):int(ends[i])]
		}

		// textIs is true when token `i` spells `word`, read in place.
		def textIs(i int, word string) bool {
			let from = int(starts[i])
			let n = int(ends[i]) - from
			return false unless n == word.len()
			for let k = 0; k < n; k++ {
				return false when source[from + k] != word[k]
			}
			return true
		}

		// startsUpper is true when the text of token `i` starts with an
		// upper-case letter.
		def startsUpper(i int) bool {
			let from = int(starts[i])
			return from < int(ends[i]) && source[from].isUpper()
		}

		// leading and trailing are the trivia of token `i`, built when asked.
		def leading(i int) Trivia[] {
			return trivia(fullStart(i), int(starts[i]))
		}

		def trailing(i int) Trivia[] {
			return trivia(int(ends[i]), fullEnd(i))
		}

		// trivia is the source between `from` and `to` read as trivia: white
		// space, line breaks and comments. A run that is one common piece (a
		// line break, up to 16 spaces or tabs) is a shared list.
		def trivia(from int, to int) Trivia[] {
			return noTrivia when from >= to
			let common = commonPieceAt(source, from, to)
			return commonTriviaLists[common] when common >= 0
			let text = source[from:to]
			let lex = new lexer.Lexer(text, comments = true, whitespace = true)
			let out Trivia[]
			for {
				let (kind, start, end) = lex.scan()
				break when kind == lexer.TokenKind.EOF
				let shared = commonPieceAt(text, start, end)
				if shared >= 0 {
					out.push(commonTrivia[shared])
				} else {
					out.push(Trivia{kind: triviaKind(text, kind, start), text: text[start:end]})
				}
			}
			return out
		}
	}

	// Segment is a tree's nodes, or one lazily parsed body's, over the
	// tree's token table, in the order the parser completed them (each
	// node after its children, the root last), and the children of every
	// node, node after node, as items. A node's children run from its
	// `firstItem` to the next node's (the item count for the last). Its
	// tokens are the table's from `firstToken` to `endToken` (exclusive);
	// a node over missing tokens only, or over nothing, has an empty range
	// at the token it stands before.
	type Segment {
		tokens          Tokens
		// Which segment of its tree: 0 for the tree's own, 1 + the slot for
		// a body's.
		number          int
		kinds           byte[]
		flags           byte[]
		firstItem       int32[]
		firstToken      int32[]
		endToken        int32[]
		items           int32[]
		// A missing token's kind, and the index of the table token it stands
		// before.
		missingKinds    byte[]
		missingAt       int32[]
		// The parse diagnostics at absolute offsets, and the node each hangs
		// on, in node order.
		diagnostics     Diagnostic[]
		diagnosticNodes int32[]
		// The unparsed bodies of an outline tree, in node order: the node,
		// and what the parser needs to parse it alone (inside a view, the
		// unit kind).
		unparsedNodes   int32[]
		unparsedInView  bool[]
		unparsedUnits   byte[]

		def new(tokens Tokens, number int) {
			self.tokens = tokens
			self.number = number
		}

		def nodeCount() int {
			return kinds.len()
		}

		// root is the last node, the one completed last.
		def root() int {
			return kinds.len() - 1
		}

		// firstNodeOf is the first node of node `n`'s subtree in completion
		// order: a node completes after all of its children, its first
		// node child's subtree first, so the subtree of `n` is the nodes from
		// this one to `n`.
		def firstNodeOf(n int) int {
			let at = n
			for {
				let (from, to) = itemsOf(at)
				let next = -1
				for let k = from; k < to; k++ {
					let it = int(items[k])
					if tagOf(it) == nodeTag {
						next = itemIndex(it)
						break
					}
				}
				return at when next < 0
				at = next
			}
		}

		// retargeted is this segment over `tokens`, a table an edit of one
		// token or its trivia made: every array is shared, but for the
		// diagnostics at or after `bound`, which move by `delta`.
		def retargeted(tokens Tokens, bound int, delta int) Segment {
			let out = new Segment(tokens, number)
			out.kinds = kinds
			out.flags = flags
			out.firstItem = firstItem
			out.firstToken = firstToken
			out.endToken = endToken
			out.items = items
			out.missingKinds = missingKinds
			out.missingAt = missingAt
			out.diagnostics = movedDiagnostics(diagnostics, 0, diagnostics.len(), bound, delta)
			out.diagnosticNodes = diagnosticNodes
			out.unparsedNodes = unparsedNodes
			out.unparsedInView = unparsedInView
			out.unparsedUnits = unparsedUnits
			return out
		}

		def kind(n int) SyntaxKind {
			return SyntaxKind(kinds[n])
		}

		def has(n int, flag byte) bool {
			return flags[n] & flag != 0
		}

		// itemsOf is where the children of node `n` start and end in `items`.
		def itemsOf(n int) (int, int) {
			let from = int(firstItem[n])
			return (from, n + 1 < kinds.len() ?? (int(firstItem[n + 1]), items.len()))
		}

		def itemAt(k int) int {
			return int(items[k])
		}

		def missingKind(m int) lexer.TokenKind {
			return lexer.TokenKind(missingKinds[m])
		}

		// firstTokenOf and endTokenOf are the table range an item covers.
		def firstTokenOf(it int) int {
			let i = itemIndex(it)
			switch tagOf(it) {
				case tokenTag:
					return i
				case nodeTag:
					return int(firstToken[i])
				default:
					return int(missingAt[i])
			}
		}

		def endTokenOf(it int) int {
			let i = itemIndex(it)
			switch tagOf(it) {
				case tokenTag:
					return i + 1
				case nodeTag:
					return int(endToken[i])
				default:
					return int(missingAt[i])
			}
		}

		// fullStartOf and fullEndOf are an item's full span.
		def fullStartOf(it int) int {
			return tokens.fullStart(firstTokenOf(it))
		}

		def fullEndOf(it int) int {
			let first = firstTokenOf(it)
			let end = endTokenOf(it)
			return tokens.fullStart(end == first ?? (first, end))
		}

		// unparsedSlot is the slot of node `n` among the unparsed bodies,
		// -1 for a node that is not one.
		def unparsedSlot(n int) int {
			return -1 unless has(n, unparsed)
			let lo = 0
			let hi = unparsedNodes.len() - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let at = int(unparsedNodes[mid])
				return mid when at == n
				if at < n {
					lo = mid + 1
				} else {
					hi = mid - 1
				}
			}
			return -1
		}

		// diagnosticsOf is where the diagnostics of node `n` start and end in
		// `diagnostics`.
		def diagnosticsOf(n int) (int, int) {
			return (0, 0) unless has(n, hasErrors)
			// The first diagnostic of a node at or after `n`.
			let lo = 0
			let hi = diagnosticNodes.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				if int(diagnosticNodes[mid]) < n {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			let end = lo
			for end < diagnosticNodes.len() && int(diagnosticNodes[end]) == n {
				end++
			}
			return (lo, end)
		}

		// addNode appends a node of `kind` over the items `children` holds
		// from `from` on, covering the table tokens from `first` to `end`
		// when it has none; the node's index.
		def addNode(kind SyntaxKind, children int[], from int, first int, end int) int {
			let n = kinds.len()
			let at = items.len()
			let edges byte = bareStart | bareEnd | leafless
			let anyTroubled = false
			let last = children.len() - 1
			if last >= from {
				for let k = from; k <= last; k++ {
					let it = children[k]
					items.push(int32(it))
					anyTroubled = anyTroubled || (tagOf(it) == nodeTag && flags[itemIndex(it)] & troubled != 0)
				}
				first = firstTokenOf(children[from])
				end = endTokenOf(children[last])
				edges = edgeFlags(children, from)
			}
			kinds.push(byte(kind.ordinal))
			flags.push(anyTroubled ?? (edges | troubled, edges))
			firstItem.push(int32(at))
			firstToken.push(int32(first))
			endToken.push(int32(end))
			return n
		}

		// edgeFlags is bareStart, bareEnd and leafless of a node over the
		// items `children` holds from `from` on: whether its first and last
		// leaves are missing tokens (or absent), whether it has any.
		internal def edgeFlags(children int[], from int) byte {
			let out byte = 0
			let first = -1
			for let k = from; k < children.len(); k++ {
				let leaf = leafOf(children[k])
				if leaf >= 0 {
					first = leaf
					break
				}
			}
			return bareStart | bareEnd | leafless when first < 0
			out |= bareStart when first == missingTag
			for let k = children.len() - 1; k >= from; k-- {
				let leaf = lastLeafOf(children[k])
				if leaf >= 0 {
					out |= bareEnd when leaf == missingTag
					break
				}
			}
			return out
		}

		// leafOf is the tag of an item's first leaf: tokenTag, missingTag,
		// -1 for a node without leaves. lastLeafOf is its last leaf's.
		internal def leafOf(it int) int {
			return tagOf(it) unless tagOf(it) == nodeTag
			let n = itemIndex(it)
			return -1 when has(n, leafless)
			return has(n, bareStart) ?? (missingTag, tokenTag)
		}

		internal def lastLeafOf(it int) int {
			return tagOf(it) unless tagOf(it) == nodeTag
			let n = itemIndex(it)
			return -1 when has(n, leafless)
			return has(n, bareEnd) ?? (missingTag, tokenTag)
		}

		// refreshFlags computes again what node `n`'s flags say of what is
		// below it (troubled, its edges), from its children: after a splice
		// changed a descendant.
		def refreshFlags(n int) {
			let (from, to) = itemsOf(n)
			let children int[]
			let anyTroubled = false
			for let k = from; k < to; k++ {
				let it = int(items[k])
				children.push(it)
				anyTroubled = anyTroubled || (tagOf(it) == nodeTag && flags[itemIndex(it)] & troubled != 0)
			}
			let own = flags[n] & (hasErrors | unparsed)
			let edges = children.len() > 0 ?? (edgeFlags(children, 0), bareStart | bareEnd | leafless)
			let next byte = own | edges
			next |= troubled when anyTroubled || own != 0
			flags[n] = next
		}

		// addUnparsed appends an unparsed body over the table tokens from
		// `first` to `end` (its braces included); the node's index.
		def addUnparsed(first int, end int, inView bool, unit SyntaxKind) int {
			let n = kinds.len()
			kinds.push(byte(SyntaxKind.Block.ordinal))
			flags.push(unparsed | troubled)
			firstItem.push(int32(items.len()))
			firstToken.push(int32(first))
			endToken.push(int32(end))
			unparsedNodes.push(int32(n))
			unparsedInView.push(inView)
			unparsedUnits.push(byte(unit.ordinal))
			return n
		}

		// addMissing appends a missing token of `kind` standing before table
		// token `at`; its index.
		def addMissing(kind lexer.TokenKind, at int) int {
			missingKinds.push(byte(kind.ordinal))
			missingAt.push(int32(at))
			return missingKinds.len() - 1
		}

		// attach hangs `found` on node `n`, the last node added.
		def attach(n int, found Diagnostic[], from int) {
			return when from >= found.len()
			for let k = from; k < found.len(); k++ {
				diagnostics.push(found[k])
				diagnosticNodes.push(int32(n))
			}
			flags[n] = flags[n] | hasErrors | troubled
		}

		// truncate forgets the nodes from `nodes` on and the missing tokens
		// from `missing` on, with their items, diagnostics and bodies: what a
		// parser's backtracking undoes.
		def truncate(nodes int, missing int) {
			if nodes < kinds.len() {
				items.len(int(firstItem[nodes]))
				kinds.len(nodes)
				flags.len(nodes)
				firstItem.len(nodes)
				firstToken.len(nodes)
				endToken.len(nodes)
				for diagnosticNodes.len() > 0 && int(diagnosticNodes[diagnosticNodes.len() - 1]) >= nodes {
					diagnosticNodes.len(diagnosticNodes.len() - 1)
					diagnostics.len(diagnostics.len() - 1)
				}
				for unparsedNodes.len() > 0 && int(unparsedNodes[unparsedNodes.len() - 1]) >= nodes {
					let last = unparsedNodes.len() - 1
					unparsedNodes.len(last)
					unparsedInView.len(last)
					unparsedUnits.len(last)
				}
			}
			missingKinds.len(missing) when missing < missingKinds.len()
			missingAt.len(missing) when missing < missingAt.len()
		}

		// seal gives every array back the capacity it does not use: a
		// segment is not added to once its parse is done.
		def seal() Segment {
			kinds.cap(kinds.len())
			flags.cap(flags.len())
			firstItem.cap(firstItem.len())
			firstToken.cap(firstToken.len())
			endToken.cap(endToken.len())
			items.cap(items.len())
			missingKinds.cap(missingKinds.len())
			missingAt.cap(missingAt.len())
			return self
		}
	}

	// noTrivia is the trivia list of a token that has none on that side;
	// shared, and never added to.
	let noTrivia Trivia[]

	// commonTrivia is the trivia pieces most of a source's are, shared by
	// every token that has one, and commonTriviaLists the list of each one
	// alone: a line feed, a CRLF, then runs of 1 to 16 spaces and of 1 to
	// 16 tabs. Shared, and never changed.
	let commonTrivia = buildCommonTrivia()
	let commonTriviaLists = buildCommonTriviaLists()

	// commonRun is the longest run of spaces or tabs commonTrivia holds.
	const commonRun = 16

	internal def buildCommonTrivia() Trivia[] {
		let out = [Trivia{kind: TriviaKind.Newline, text: "\n"}, Trivia{kind: TriviaKind.Newline, text: "\r\n"}]
		for let c in [" ", "\t"] {
			for let n = 1; n <= commonRun; n++ {
				out.push(Trivia{kind: TriviaKind.Whitespace, text: c * n})
			}
		}
		return out
	}

	internal def buildCommonTriviaLists() Trivia[][] {
		let out Trivia[][]
		for let (_, t) in commonTrivia {
			out.push([t])
		}
		return out
	}

	// commonPieceAt is the index in commonTrivia of the text from `start` to
	// `end`, -1 when it is not one of them.
	def commonPieceAt(text string, start int, end int) int {
		let n = end - start
		return -1 when n <= 0 || n > commonRun
		let c = text[start]
		if c := '\n' || '\r' {
			return 0 when n == 1 && c == '\n'
			return 1 when n == 2 && c == '\r' && text[start + 1] == '\n'
			return -1
		}
		return -1 unless c := ' ' || '\t'
		for let i = start + 1; i < end; i++ {
			return -1 when text[i] != c
		}
		return (c == ' ' ?? (2, 2 + commonRun)) + n - 1
	}

	// triviaKind is the trivia kind of a white space, line break or comment
	// token that starts at `start`.
	def triviaKind(text string, kind lexer.TokenKind, start int) TriviaKind {
		return TriviaKind.Whitespace when kind == lexer.TokenKind.Whitespace
		return TriviaKind.Newline when kind == lexer.TokenKind.Newline
		return text[start + 1] == '/' ?? (TriviaKind.LineComment, TriviaKind.BlockComment)
	}
}
