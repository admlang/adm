partial module std.adm.syntax {
	use (
		std.adm.lexer
		std.adm.syntax.parsing::*
	)

	// parse is the tree of an ADM source: every character of it, with a
	// diagnostic at each place the grammar was not followed. It never
	// fails; an incomplete source gives a tree with missing tokens and
	// Skipped nodes.
	//
	// ```
	// let tree = parse("module m \{ def f() int \{ return 1 \} \}")
	// tree.diagnostics().len() == 0 && tree.root().kind() == SyntaxKind.File
	// ```
	def parse(source string) SyntaxTree {
		let parser = new Parser(source)
		parser.parseFile()
		return new SyntaxTree(parser.root(), source)
	}

	partial type SyntaxTree {
		// edit is the tree of this tree's text with `replacement` in place of
		// the characters from `start` to `end` (exclusive). The smallest
		// block that holds the edited range away from its braces is parsed
		// again from its new text and spliced in; every node outside it is
		// the same object as before, so what the IDE attached to those nodes
		// stays attached. When the edit changes the brace balance, touches
		// a block's braces or stands outside every block, the whole text is
		// parsed again.
		def edit(start int, end int, replacement string) SyntaxTree {
			start = 0 when start < 0
			end = source.len() when end > source.len()
			end = start when end < start
			let text = source[:start] + replacement + source[end:]
			let delta = replacement.len() - (end - start)
			let anchor = root().find(start)
			anchor = root().lastToken() when anchor is none
			return parse(text) when anchor is none
			let spliced = reparseWithin(anchor.parent, start, end, text, delta)
			return spliced unless spliced is none
			return parse(text)
		}

		// reparseWithin is the tree with the edit parsed inside the nearest
		// reparseable ancestor that holds it away from its braces, none when
		// no ancestor can take it.
		internal def reparseWithin(node ?SyntaxNode, start int, end int, text string, delta int) ?SyntaxTree {
			return none when node is none
			return reparseWithin(node.parent, start, end, text, delta) unless isReparseable(node.kind())
			let first = node.firstToken()
			let last = node.lastToken()
			return reparseWithin(node.parent, start, end, text, delta) when first is none || last is none
			if start >= first.end() && end <= last.start() {
				let spliced = reparse(node, text, delta)
				return spliced unless spliced is none
			}
			return reparseWithin(node.parent, start, end, text, delta)
		}

		// reparse parses the node's new text as a node of its kind and
		// splices it into a copy of the path to the root; none when the
		// block cannot be parsed on its own or its braces changed.
		internal def reparse(node SyntaxNode, text string, delta int) ?SyntaxTree {
			let from = node.fullStart()
			let to = node.fullEnd() + delta
			let fragment = text[from:to]
			let parser = new Parser(fragment)
			return none unless parser.bracesBalanced()
			let fresh = parser.parseFragment(node.kind(), insideView(node.parent), kindOf(node.parent))
			return none when fresh is none
			return none when fresh.width != fragment.len()
			let child = fresh
			let at = node
			for !(at.parent is none) {
				let parent = present(at.parent)
				let kids = parent.green.children.clone()
				kids[at.index] = child
				let copy = new Green(parent.green.kind, kids)
				copy = copy.withErrors(parent.green.errors) when parent.green.errors.len() > 0
				child = copy
				at = parent
			}
			return new SyntaxTree(child, text)
		}
	}

	// insideView is true when the node or an ancestor is a view's block or
	// a component placed in one, where a call may take a block of children.
	internal def insideView(node ?SyntaxNode) bool {
		return false when node is none
		return true when node.kind() == SyntaxKind.ViewExpr || node.kind() == SyntaxKind.ComponentCall
		return insideView(node.parent)
	}

	// kindOf is the node's kind, Block for none.
	internal def kindOf(node ?SyntaxNode) SyntaxKind {
		return SyntaxKind.Block when node is none
		return node.kind()
	}

	// isReparseable is true for a node kind an edit can parse on its own.
	internal def isReparseable(kind SyntaxKind) bool {
		return kind == SyntaxKind.Block || kind == SyntaxKind.Body || kind == SyntaxKind.RawBlock
	}

	// present is the node, which the caller knows to be there.
	internal def present(node ?SyntaxNode) SyntaxNode {
		return node unless node is none
		return new SyntaxNode(missingToken(lexer.TokenKind.EOF), none, 0, 0)
	}
}
