partial module std.adm.syntax {
	use (
		std.adm.lexer
		std.adm.syntax.parsing::*
	)

	// parse is the tree of an ADM source: every character of it, with a
	// diagnostic at each place the grammar was not followed. It never
	// fails; an incomplete source gives a tree with missing tokens and
	// Skipped nodes.
	//
	// ```
	// let tree = parse("module m \{ def f() int \{ return 1 \} \}")
	// tree.diagnostics().len() == 0 && tree.root().kind() == SyntaxKind.File
	// ```
	def parse(source string) SyntaxTree {
		let parser = new Parser(source)
		parser.parseFile()
		return new SyntaxTree(parser.root(), source)
	}

	partial type SyntaxTree {
		// edit is the tree of this tree's text with `replacement` in place of
		// the characters from `start` to `end` (exclusive). An edit inside one
		// token's own text that leaves it one token of the same kind (a name,
		// a number or a string typed letter by letter), or inside the trivia
		// beside a token that leaves it trivia (spaces, a comment's text),
		// replaces that token alone (`retoken`, `retrivia`). Otherwise the
		// smallest block that holds the edited range away from its braces is
		// parsed again from its new text and spliced in. Either way every node
		// outside the replaced one is the same object as before, so what the
		// IDE attached to those nodes stays attached. When the edit changes
		// the brace balance, touches a block's braces or stands outside every
		// block, the whole text is parsed again.
		def edit(start int, end int, replacement string) SyntaxTree {
			start = 0 when start < 0
			end = source.len() when end > source.len()
			end = start when end < start
			let text = source[:start] + replacement + source[end:]
			let delta = replacement.len() - (end - start)
			let anchor = root().find(start)
			anchor = root().lastToken() when anchor is none
			return parse(text) when anchor is none
			let quick = retoken(anchor, start, end, text, delta)
			quick = retrivia(anchor, start, end, replacement, text, delta) when quick is none
			return quick unless quick is none
			let spliced = reparseWithin(anchor.parent, start, end, text, delta)
			return spliced unless spliced is none
			return parse(text)
		}

		// retoken is the tree with the anchor token's text replaced, for an
		// edit that stays within its own text (its edges included) and leaves
		// it one token of the same kind; none for any other edit, for one that
		// splits the token or makes a keyword of a name, and for a token the
		// parser hung a diagnostic on.
		internal def retoken(anchor SyntaxNode, start int, end int, text string, delta int) ?SyntaxTree {
			return none unless anchor.isToken() && !anchor.isMissing() && anchor.green.errors.len() == 0
			return none unless isRetokenable(anchor.token())
			return none unless start >= anchor.start() && end <= anchor.end()
			let fresh = text[anchor.start():anchor.end() + delta]
			return none when fresh.len() == 0
			let tokens = lexer.tokenize(fresh, comments = true, whitespace = true)
			return none unless tokens.len() == 2 && tokens[1].kind == lexer.TokenKind.EOF
			let tok = tokens[0]
			return none unless tok.kind == anchor.token() && tok.start == 0 && tok.end == fresh.len()
			return splice(anchor, new Green(tok.kind, tokenText(fresh, tok), anchor.green.leading, anchor.green.trailing), text)
		}

		// retrivia is the tree with the trivia on one side of the anchor token
		// replaced, for an edit inside that trivia that leaves it trivia. The
		// trailing trivia of a token ends at the first line break, so an edit
		// that adds a line break to it, or takes its one away, belongs to
		// another token too and is left to the parser; none then, for an
		// edit that is not trivia any more, and for one that leaves no trailing
		// trivia (the tokens on both sides may then lex as one).
		internal def retrivia(anchor SyntaxNode, start int, end int, replacement string, text string, delta int) ?SyntaxTree {
			return none unless anchor.isToken() && anchor.green.errors.len() == 0
			let g = anchor.green
			if start >= anchor.fullStart() && end <= anchor.start() && start < anchor.start() {
				let fresh = text[anchor.fullStart():anchor.start() + delta]
				let leading = triviaOf(fresh)
				return none when leading is none
				return splice(anchor, new Green(g.token, g.text, leading, g.trailing), text)
			}
			if start >= anchor.end() && end <= anchor.fullEnd() && start < anchor.fullEnd() {
				return none when g.trailing.len() == 0
				let fresh = text[anchor.end():anchor.fullEnd() + delta]
				let trailing = triviaOf(fresh)
				// Nothing left before the next token on the line: the two may
				// lex as one (`comp` + `onent`), which only the parser finds out.
				// Leading trivia follows a line break, so emptying it joins nothing.
				return none when trailing is none || trailing.len() == 0
				return none unless lineBreaks(trailing) == lineBreaks(g.trailing)
				return none when lineBreaks(trailing) > 0 && trailing[trailing.len() - 1].kind != TriviaKind.Newline
				return splice(anchor, new Green(g.token, g.text, g.leading, trailing), text)
			}
			return none
		}

		// splice is the tree with `child` in place of the node `at`: a copy of
		// the path from `at` to the root over the same other children.
		internal def splice(at SyntaxNode, child Green, text string) SyntaxTree {
			let node = at
			let made = child
			for !(node.parent is none) {
				let parent = present(node.parent)
				let kids = parent.green.children.clone()
				kids[node.index] = made
				let copy = new Green(parent.green.kind, kids)
				copy = copy.withErrors(parent.green.errors) when parent.green.errors.len() > 0
				made = copy
				node = parent
			}
			return new SyntaxTree(made, text)
		}

		// reparseWithin is the tree with the edit parsed inside the nearest
		// reparseable ancestor that holds it away from its braces, none when
		// no ancestor can take it.
		internal def reparseWithin(node ?SyntaxNode, start int, end int, text string, delta int) ?SyntaxTree {
			return none when node is none
			return reparseWithin(node.parent, start, end, text, delta) unless isReparseable(node.kind())
			let first = node.firstToken()
			let last = node.lastToken()
			return reparseWithin(node.parent, start, end, text, delta) when first is none || last is none
			if start >= first.end() && end <= last.start() {
				let spliced = reparse(node, text, delta)
				return spliced unless spliced is none
			}
			return reparseWithin(node.parent, start, end, text, delta)
		}

		// reparse parses the node's new text as a node of its kind and
		// splices it into a copy of the path to the root; none when the
		// block cannot be parsed on its own or its braces changed.
		internal def reparse(node SyntaxNode, text string, delta int) ?SyntaxTree {
			let from = node.fullStart()
			let to = node.fullEnd() + delta
			let fragment = text[from:to]
			let parser = new Parser(fragment)
			return none unless parser.bracesBalanced()
			let fresh = parser.parseFragment(node.kind(), insideView(node.parent), ownerOf(node))
			return none when fresh is none
			return none when fresh.width != fragment.len()
			return splice(node, fresh, text)
		}
	}

	// isRetokenable is true for a token kind an edit inside its text can
	// relex on its own: a name or a literal whose text is what the lexer
	// read (a unit's text leaves its parentheses out).
	internal def isRetokenable(kind lexer.TokenKind) bool {
		return kind == lexer.TokenKind.Ident || kind == lexer.TokenKind.Integer || kind == lexer.TokenKind.Float || kind == lexer.TokenKind.String || kind == lexer.TokenKind.Char
	}

	// triviaOf is the text read as trivia only: white space, line breaks
	// and comments; none when anything else is in it.
	internal def triviaOf(text string) ?Trivia[] {
		let out Trivia[]
		for let (_, tok) in lexer.tokenize(text, comments = true, whitespace = true) {
			switch tok.kind {
				case lexer.TokenKind.Whitespace:
					out.push(Trivia{kind: TriviaKind.Whitespace, text: tok.text})
				case lexer.TokenKind.Newline:
					out.push(Trivia{kind: TriviaKind.Newline, text: tok.text})
				case lexer.TokenKind.Comment:
					let kind = tok.text.startsWith("//") ?? (TriviaKind.LineComment, TriviaKind.BlockComment)
					out.push(Trivia{kind: kind, text: tok.text})
				case lexer.TokenKind.EOF:
					break
				default:
					return none
			}
		}
		return out
	}

	// lineBreaks is how many line breaks the trivia holds.
	internal def lineBreaks(trivia Trivia[]) int {
		let n = 0
		for let (_, t) in trivia {
			n += 1 when t.kind == TriviaKind.Newline
		}
		return n
	}

	// insideView is true when the node or an ancestor is a view (a `view`
	// declaration's block or a `view { }` expression) or a component placed
	// in one, where a call may take a block of children.
	internal def insideView(node ?SyntaxNode) bool {
		return false when node is none
		return true when node.kind() == SyntaxKind.ViewDecl || node.kind() == SyntaxKind.ViewExpr || node.kind() == SyntaxKind.ComponentCall
		return insideView(node.parent)
	}

	// ownerOf is the kind whose grammar the node is parsed in: its parent's,
	// or for the body of a `where` clause the declaration the clause is in,
	// whose members the clause holds.
	internal def ownerOf(node SyntaxNode) SyntaxKind {
		let parent = node.parent
		return SyntaxKind.Block when parent is none
		return parent.kind() unless parent.kind() == SyntaxKind.Where
		let body = parent.parent
		return SyntaxKind.Block when body is none
		return kindOf(body.parent)
	}

	// kindOf is the node's kind, Block for none.
	internal def kindOf(node ?SyntaxNode) SyntaxKind {
		return SyntaxKind.Block when node is none
		return node.kind()
	}

	// isReparseable is true for a node kind an edit can parse on its own.
	internal def isReparseable(kind SyntaxKind) bool {
		return kind == SyntaxKind.Block || kind == SyntaxKind.Body || kind == SyntaxKind.RawBlock
	}

	// present is the node, which the caller knows to be there.
	internal def present(node ?SyntaxNode) SyntaxNode {
		return node unless node is none
		return new SyntaxNode(missingToken(lexer.TokenKind.EOF), none, 0, 0)
	}
}
