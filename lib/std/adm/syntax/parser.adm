// The parser of std.adm.syntax: recursive descent over the token table of a
// source, completing nodes over the items of a stack into a segment. It never
// fails: an expected token that is absent becomes a missing token with a
// diagnostic, and tokens that fit nowhere go into a Skipped node, so every
// input gives a tree that spells it back.
internal partial module std.adm.syntax.parsing {
	use (
		std.adm.lexer::(TokenKind, isKeyword)
		std.adm.syntax::*
		std.adm.syntax.layout::*
	)

	// Mark is where a node began: the stack length, the pending diagnostic
	// count, the cursor, and the segment's node and missing token counts at
	// that point. A tuple, so making one, which every grammar rule does,
	// allocates nothing.
	internal type Mark = (int, int, int, int, int)

	// Depth counts the open brackets of a scan, parentheses, brackets,
	// braces and interpolation braces in that order: a terminator counts
	// only when every kind is closed.
	internal type Depth = (int, int, int, int)

	// noDepth is a scan's depth before its first token.
	internal const noDepth Depth = (0, 0, 0, 0)

	// step is `d` after the bracket `kind` opens or closes.
	def step(d Depth, kind TokenKind) Depth {
		switch kind {
			case TokenKind.LParen:
				return (d.0 + 1, d.1, d.2, d.3)
			case TokenKind.RParen:
				return (d.0 - 1, d.1, d.2, d.3) when d.0 > 0
			case TokenKind.LBrack:
				return (d.0, d.1 + 1, d.2, d.3)
			case TokenKind.RBrack:
				return (d.0, d.1 - 1, d.2, d.3) when d.1 > 0
			case TokenKind.LBrace:
				return (d.0, d.1, d.2 + 1, d.3)
			case TokenKind.RBrace:
				return (d.0, d.1, d.2 - 1, d.3) when d.2 > 0
			case TokenKind.InterpLBrace:
				return (d.0, d.1, d.2, d.3 + 1)
			case TokenKind.InterpRBrace:
				return (d.0, d.1, d.2, d.3 - 1) when d.3 > 0
			default:
		}
		return d
	}

	// balanced is true when no bracket is open.
	def balanced(d Depth) bool {
		return d.0 == 0 && d.1 == 0 && d.2 == 0 && d.3 == 0
	}

	// The tokens that end an expression parsed with parseExpressionUpTo,
	// outside brackets, by where it stands. Shared, and never changed.
	//
	// guardEnd: the condition of a trailing `when` or `unless`.
	internal let guardEnd = [TokenKind.Semi, TokenKind.When, TokenKind.Unless, TokenKind.RBrace]
	// listItemEnd: a value of a list ended by a line, `;` or `}` (the
	// values of a multiple assignment or of fields declared together).
	internal let listItemEnd = [TokenKind.Comma, TokenKind.Semi, TokenKind.RBrace]
	// assignTargetEnd: a target of a multiple assignment.
	internal let assignTargetEnd = [TokenKind.Comma, TokenKind.Assign, TokenKind.Semi, TokenKind.RBrace]
	// blockStart: what runs up to a block, such as an `every` interval.
	internal let blockStart = [TokenKind.LBrace]
	// caseGuardEnd: the guard of a `case` after its `;`.
	internal let caseGuardEnd = [TokenKind.Colon]
	// caseItemEnd: a value or pattern of a `case`.
	internal let caseItemEnd = [TokenKind.Comma, TokenKind.Semi, TokenKind.Colon]
	// itemInParensEnd: an element of a parenthesised list (a tuple
	// pattern, a parameter's default value).
	internal let itemInParensEnd = [TokenKind.Comma, TokenKind.RParen]
	// interpolationEnd: the expression of a string interpolation.
	internal let interpolationEnd = [TokenKind.InterpRBrace]
	// assertEnd: the condition of an `assert`.
	internal let assertEnd = [TokenKind.Onerror, TokenKind.Semi, TokenKind.When, TokenKind.Unless, TokenKind.RBrace]

	// primitives is every builtin type name: what a cast or a type literal
	// may start with in lower case.
	internal let primitives = ["bool", "int", "int8", "int16", "int32", "int64", "int128",
		"uint", "uint8", "uint16", "uint32", "uint64", "uint128",
		"bigint", "float", "float16", "float32", "float64", "float128",
		"complex32", "complex64", "complex128",
		"string", "char", "byte", "duration", "regex", "none",
		"map", "channel"]

	// The bits of a token's name class (Parser.nameClass).
	internal const nameKnown byte = 1
	internal const nameBuiltin byte = 2
	internal const nameTypeLiteral byte = 4
	internal const nameUpper byte = 8
	internal const nameLower byte = 16

	// typeLiteralNames is every lower-case name that may start a type
	// literal: the primitives, then `matrix`, `any` and `anydata`.
	// namesByLetter holds, for each letter `a` to `z`, the indices of the
	// names that start with it, so a name is compared only with those it
	// could be. Shared, and never changed.
	internal let typeLiteralNames = primitives.concat(["matrix", "any", "anydata"])
	internal let namesByLetter = buildNamesByLetter()

	internal def buildNamesByLetter() int[][] {
		let out int[][]
		for let c = 0; c < 26; c++ {
			out.push([])
		}
		for let (k, name) in typeLiteralNames {
			out[int(name[0]) - int('a')].push(k)
		}
		return out
	}

	// describe is how a diagnostic names a token kind.
	def describe(kind TokenKind) string {
		return "an identifier" when kind == TokenKind.Ident
		return "a string" when kind == TokenKind.String
		return "the end of the file" when kind == TokenKind.EOF
		return "`" + kind.value + "`"
	}

	// Parser reads the token table of one source and completes nodes over
	// the items of its stack into a segment. `limit` bounds the tokens a
	// nested parse may read: beyond it the cursor reports EOF, which is how
	// an expression stops at the end of a header or an interpolation.
	partial type Parser {
		internal tokens      Tokens
		internal out         Segment
		internal pos         int          = 0
		internal limit       int          = 0
		// The items of the elements made since the node being parsed began.
		internal stack       int[]
		// Diagnostics not yet hung on a node, at absolute offsets.
		internal diags       Diagnostic[]
		internal inView      bool         = false
		// The unit being parsed, for what its body may hold (`export` in a
		// library or plugin).
		internal unitKind    SyntaxKind   = SyntaxKind.File
		// Closes owed by a `>>` or `>>>` token an inner type argument list
		// consumed; cleared by any advance.
		internal pendingGt   int          = 0
		// Whether a function's block is left unparsed (an outline).
		internal outline     bool         = false
		// What lookahead learned of each token's name, from token `classBase`
		// on (nameClass): lookahead asks about a name many times, and it is
		// read once.
		internal nameClasses byte[]
		internal classBase   int          = 0

		// A parser of the whole source, into segment 0 of its tree.
		def new(source string) {
			self.tokens = new Tokens(source)
			self.out = new Segment(self.tokens, 0)
			self.limit = self.tokens.count() - 1
			self.nameClasses.len(self.tokens.count())
		}

		// A parser of the table's tokens from `from` to `to` (exclusive), into
		// segment `number`: a body an outline left unparsed.
		def new(tokens Tokens, from int, to int, number int) {
			self.tokens = tokens
			self.out = new Segment(tokens, number)
			self.pos = from
			self.limit = to
			self.classBase = from
			self.nameClasses.len(to - from)
		}

		// bracesBalanced is true when the tokens open and close as many
		// braces, interpolation braces included.
		def bracesBalanced() bool {
			let depth = 0
			for let i = 0; i < tokens.count(); i++ {
				switch tokens.kind(i) {
					case TokenKind.LBrace, TokenKind.InterpLBrace:
						depth++
					case TokenKind.RBrace, TokenKind.InterpRBrace:
						depth--
					default:
				}
				return false when depth < 0
			}
			return depth == 0
		}

		// ------------------------------------------------------------
		// Cursor
		// ------------------------------------------------------------

		// kindAt is the kind of token `i`, EOF at or past the limit.
		internal def kindAt(i int) TokenKind {
			return TokenKind.EOF when i < 0 || i >= limit
			return TokenKind(tokens.kinds[i])
		}

		internal def kind() TokenKind {
			return kindAt(pos)
		}

		internal def peek(n int = 1) TokenKind {
			return kindAt(pos + n)
		}

		internal def at(k TokenKind) bool {
			return kindAt(pos) == k
		}

		internal def atEnd() bool {
			return pos >= limit
		}

		// textAt is the text of token `i`, "" past the limit.
		internal def textAt(i int) string {
			return "" when i < 0 || i >= limit
			return tokens.text(i)
		}

		// textIs is true when token `i` spells `word`; false past the limit.
		internal def textIs(i int, word string) bool {
			return false when i < 0 || i >= limit
			return tokens.textIs(i, word)
		}

		// textLength is the length of token `i`'s text, 0 past the limit.
		internal def textLength(i int) int {
			return 0 when i < 0 || i >= limit
			return tokens.end(i) - tokens.start(i)
		}

		// The names of token `i` by their spelling, read in place (no text
		// is made); false past the limit.
		//
		// upperAt: it starts with an upper-case letter. lowerAt: with a
		// lower-case one.
		internal def upperAt(i int) bool {
			return nameClass(i) & nameUpper != 0
		}

		internal def lowerAt(i int) bool {
			return nameClass(i) & nameLower != 0
		}

		// builtinTypeAt: a primitive type's name, what a cast or a type
		// literal may start with in lower case.
		internal def builtinTypeAt(i int) bool {
			return nameClass(i) & nameBuiltin != 0
		}

		// typeLiteralNameAt: a lower-case name that may start a type
		// literal, a primitive, `matrix`, `any` or `anydata`.
		internal def typeLiteralNameAt(i int) bool {
			return nameClass(i) & nameTypeLiteral != 0
		}

		// nameClass is what token `i`'s name is (its first letter's case,
		// whether it names a primitive or may start a type literal), read the
		// first time asked.
		internal def nameClass(i int) byte {
			return 0 when i < 0 || i >= limit
			let known = nameClasses[i - classBase]
			return known unless known == 0
			let class = nameKnown
			if textLength(i) > 0 {
				let c = tokens.source[tokens.start(i)]
				class |= nameUpper when c.isUpper()
				class |= nameLower when c.isLower()
			}
			let k = typeLiteralNameIndex(i)
			if k >= 0 {
				class |= nameTypeLiteral
				class |= nameBuiltin when k < primitives.len()
			}
			nameClasses[i - classBase] = class
			return class
		}

		// typeLiteralNameIndex is the index in typeLiteralNames of the name
		// token `i` spells, -1 for any other.
		internal def typeLiteralNameIndex(i int) int {
			let n = textLength(i)
			return -1 when n == 0
			let lead = tokens.source[tokens.start(i)]
			return -1 unless lead >= 'a' && lead <= 'z'
			for let (_, k) in namesByLetter[int(lead) - int('a')] {
				return k when tokens.textIs(i, typeLiteralNames[k])
			}
			return -1
		}

		// constantStyleAt: at least two upper-case letters, digits and
		// underscores only (`MAX_INT`).
		internal def constantStyleAt(i int) bool {
			let n = textLength(i)
			let from = tokens.start(i)
			let letters = 0
			for let k = 0; k < n; k++ {
				let c = tokens.source[from + k]
				if c.isUpper() {
					letters++
				} else if !(c.isDigit() || c == '_') {
					return false
				}
			}
			return letters >= 2
		}

		// textStart and textEnd bound the text of token `i` without trivia.
		internal def textStart(i int) int {
			let last = tokens.count() - 1
			return tokens.start(i < last ?? (i, last))
		}

		internal def textEnd(i int) int {
			let last = tokens.count() - 1
			return tokens.end(i < last ?? (i, last))
		}

		// lineBreakBefore is true when a line break separates token `i`
		// from the one before it.
		internal def lineBreakBefore(i int) bool {
			return false when i <= 0 || i >= tokens.count()
			return tokens.lineBreak(i)
		}

		// adjacent is true when nothing separates token `i` from token `j`.
		internal def adjacent(i int, j int) bool {
			return textEnd(i) == textStart(j)
		}

		// advance puts the current token on the stack and moves on; nothing
		// past the limit.
		internal def advance() {
			return when pos >= limit
			stack.push(item(pos, tokenTag))
			pos++
			pendingGt = 0
		}

		// take consumes the current token when it is of kind `k`.
		internal def take(k TokenKind) bool {
			return false unless at(k)
			advance()
			return true
		}

		// expect consumes a token of kind `k`, or puts a missing one with a
		// diagnostic where it should have been.
		internal def expect(k TokenKind) {
			if at(k) {
				advance()
				return
			}
			missing(k)
		}

		internal def missing(k TokenKind) {
			let place = textStart(pos)
			report("expected " + describe(k) + ", found " + describe(kind()), place, place)
			stack.push(item(out.addMissing(k, pos), missingTag))
		}

		// atGenericClose is true when a type argument list can close here:
		// at `>`, or at a `>>` or `>>>` that closes two or three lists at
		// once, one of which may already be owed from a `>>` an inner list
		// took.
		internal def atGenericClose() bool {
			return true when pendingGt > 0
			return at(TokenKind.Gt) || at(TokenKind.Shr) || at(TokenKind.Rotr)
		}

		// expectGenericClose closes a type argument list. A `>>` token goes
		// to the innermost list and leaves one close owed to the next, so
		// `Box<Box<int>>` parses without touching the tokens.
		internal def expectGenericClose() {
			if pendingGt > 0 {
				pendingGt--
				return
			}
			if at(TokenKind.Shr) {
				advance()
				pendingGt = 1
				return
			}
			if at(TokenKind.Rotr) {
				advance()
				pendingGt = 2
				return
			}
			expect(TokenKind.Gt)
		}

		// ------------------------------------------------------------
		// Nodes and diagnostics
		// ------------------------------------------------------------

		internal def mark() Mark {
			return (stack.len(), diags.len(), pos, out.kinds.len(), out.missingKinds.len())
		}

		// reset forgets everything since the mark, the nodes and missing
		// tokens made since then included.
		internal def reset(m Mark) {
			stack.len(m.0)
			diags.len(m.1)
			pos = m.2
			out.truncate(m.3, m.4)
		}

		// complete makes a node of `kind` over what the stack holds since the
		// mark, carrying the diagnostics raised since then; a node over
		// nothing stands before the token at the cursor.
		internal def complete(kind SyntaxKind, m Mark) {
			let n = out.addNode(kind, stack, m.0, pos, pos)
			stack.len(m.0)
			if diags.len() > m.1 {
				out.attach(n, diags, m.1)
				diags.len(m.1)
			}
			stack.push(item(n, nodeTag))
		}

		// topKind is the kind of the element last put on the stack, Token for
		// a token.
		internal def topKind() SyntaxKind {
			let it = stack[stack.len() - 1]
			return SyntaxKind.Token unless tagOf(it) == nodeTag
			return out.kind(itemIndex(it))
		}

		// pushed is true when something was put on the stack since the mark.
		internal def pushed(m Mark) bool {
			return stack.len() > m.0
		}

		internal def report(message string, start int, end int) {
			diags.push(Diagnostic{message: message, start: start, end: end})
		}

		// errorHere raises a diagnostic on the current token.
		internal def reportHere(message string) {
			report(message, textStart(pos), textEnd(pos))
		}

		// unexpected is the diagnostic for a token that fits nowhere.
		internal def unexpected(context string) string {
			let text = textAt(pos)
			let spelling = text.len() > 0 ?? (text, kind().value)
			return "unexpected `" + spelling + "` in " + context
		}

		// skipOne puts the current token into a Skipped node with a
		// diagnostic.
		internal def skipOne(context string) {
			let m = mark()
			reportHere(unexpected(context))
			advance()
			complete(SyntaxKind.Skipped, m)
		}

		// skipTo puts the tokens before `end` into a Skipped node with one
		// diagnostic; nothing when the cursor is there already.
		internal def skipTo(end int, context string) {
			return when end <= pos
			let m = mark()
			report(unexpected(context), textStart(pos), textEnd(end - 1))
			for pos < end {
				advance()
			}
			complete(SyntaxKind.Skipped, m)
		}

		// ------------------------------------------------------------
		// Ranges: where an expression, a header or a statement ends
		// ------------------------------------------------------------

		// exprEnd is the index after the last token of an expression that
		// starts at the cursor: before a terminator outside brackets, and
		// with `stopOnNewline` before a line break outside brackets. Angle
		// brackets count only where they open type arguments.
		internal def exprEnd(stopOnNewline bool, terminators TokenKind[]) int {
			let i = pos
			let depth = noDepth
			let angle = 0
			let prev = TokenKind.EOF
			for i < limit {
				let k = tokens.kind(i)
				if balanced(depth) && angle == 0 {
					return i when terminators.includes(k)
					return i when stopOnNewline && i > pos && lineBreakBefore(i)
				}
				switch k {
					case TokenKind.Lt:
						angle++ when angle == 0 && prev == TokenKind.Ident && typeArgListAhead(i)
					case TokenKind.Gt:
						angle-- when angle > 0
					case TokenKind.Shr:
						angle -= 2 when angle > 0
						angle = 0 when angle < 0
					case TokenKind.Rotr:
						angle -= 3 when angle > 0
						angle = 0 when angle < 0
					default:
				}
				depth = step(depth, k)
				prev = k
				i++
			}
			return i
		}

		// typeArgListAhead is true when the `<` at `i` closes as a type
		// argument list (`map<string, int>{}`) rather than comparing.
		internal def typeArgListAhead(i int) bool {
			let depth = 0
			for i < limit {
				switch tokens.kind(i) {
					case TokenKind.Lt:
						depth++
					case TokenKind.Gt:
						depth-- when depth > 0
						return true when depth == 0
					case TokenKind.Shr:
						return true when depth > 0 && depth <= 2
						depth -= 2 when depth > 0
					case TokenKind.Rotr:
						return true when depth > 0 && depth <= 3
						depth -= 3 when depth > 0
					case TokenKind.LParen, TokenKind.RParen, TokenKind.LBrack, TokenKind.RBrack, TokenKind.Dot, TokenKind.Ident, TokenKind.Question, TokenKind.Not, TokenKind.BitOr, TokenKind.BitAnd, TokenKind.Comma:
					default:
						return false
				}
				i++
			}
			return false
		}

		// headerEnd is the index of the `{` that ends the header of an
		// `if`, `for`, `switch`, `match` or `where`: the first `{` outside
		// brackets that does not start a literal (`Point{x: 1}`).
		internal def headerEnd(allowEmpty bool) int {
			let i = pos
			let depth = noDepth
			for i < limit {
				let k = tokens.kind(i)
				if balanced(depth) && k == TokenKind.LBrace {
					return i when allowEmpty && i == pos
					return i unless lbraceStartsLiteral(pos, i)
				}
				depth = step(depth, k)
				i++
			}
			return i
		}

		// lbraceStartsLiteral is true when the `{` at `brace`, inside a
		// header that starts at `start`, opens a struct literal: it follows
		// `struct`, or an upper-case or builtin type name (with type
		// arguments or `[]` suffixes) written against it.
		internal def lbraceStartsLiteral(start int, brace int) bool {
			return true when brace <= start
			let next = kindAt(brace + 1)
			return false when next == TokenKind.Case || next == TokenKind.Default
			let prevIdx = brace - 1
			return true when prevIdx < start
			let prev = tokens.kind(prevIdx)
			return true when prev == TokenKind.Struct
			for prev == TokenKind.RBrack {
				return false when prevIdx - 1 < start || tokens.kind(prevIdx - 1) != TokenKind.LBrack
				prevIdx -= 2
				return false when prevIdx < start
				prev = tokens.kind(prevIdx)
			}
			if prev == TokenKind.Gt {
				let depth = 1
				let i = prevIdx - 1
				for i >= start && depth != 0 {
					switch tokens.kind(i) {
						case TokenKind.Gt:
							depth++
						case TokenKind.Lt:
							depth--
						case TokenKind.Shr:
							depth += 2
						case TokenKind.Rotr:
							depth += 3
						default:
					}
					i--
				}
				return false when depth != 0 || i < start
				prevIdx = i
				prev = tokens.kind(prevIdx)
			}
			return false unless prev == TokenKind.Ident
			return false unless upperAt(prevIdx) || builtinTypeAt(prevIdx)
			switch kindAt(prevIdx - 1) {
				case TokenKind.Is, TokenKind.Colon, TokenKind.As, TokenKind.BitOr, TokenKind.BitAnd:
					return false
				default:
			}
			return adjacent(prevIdx, brace)
		}

		// statementEnd is the index after the last token of a statement
		// that starts at the cursor: before `}` outside brackets (and `)`
		// or `]` with `nested`), after `;`, or at a line break outside
		// brackets. Used to skip what no grammar rule takes.
		internal def statementEnd(nested bool) int {
			let i = pos
			let depth = noDepth
			for i < limit {
				let k = tokens.kind(i)
				return i when balanced(depth) && k == TokenKind.RBrace
				return i when nested && balanced(depth) && (k == TokenKind.RParen || k == TokenKind.RBrack)
				depth = step(depth, k)
				i++
				if balanced(depth) {
					return i when i >= limit
					let next = tokens.kind(i)
					return i + 1 when next == TokenKind.Semi
					return i when next == TokenKind.RBrace
					return i when lineBreakBefore(i)
				}
			}
			return i
		}

		// ------------------------------------------------------------
		// Lookahead over type syntax
		// ------------------------------------------------------------

		// typeArgsAt is true when the `<` at `i` opens a type argument list
		// (and, with `needCall`, a `(` follows its close).
		internal def typeArgsAt(i int, needCall bool) bool {
			return false unless kindAt(i) == TokenKind.Lt
			let depth = 0
			let groups = 0
			for i < limit {
				switch tokens.kind(i) {
					case TokenKind.Lt:
						depth++
					case TokenKind.Gt, TokenKind.Shr:
						depth--
						depth-- when tokens.kind(i) == TokenKind.Shr
						if depth <= 0 {
							return false when depth != 0
							return !needCall || kindAt(i + 1) == TokenKind.LParen
						}
					case TokenKind.LParen, TokenKind.LBrack:
						groups++
					case TokenKind.RParen, TokenKind.RBrack:
						groups--
						return false when groups < 0
					case TokenKind.Ident, TokenKind.Dot, TokenKind.Comma, TokenKind.Question, TokenKind.Not, TokenKind.BitOr, TokenKind.BitAnd, TokenKind.Def, TokenKind.Async, TokenKind.Weak:
					default:
						return false
				}
				i++
			}
			return false
		}

		// genericTypeAhead is true when a (qualified) name at the cursor is
		// followed by a closed type argument list.
		internal def genericTypeAhead() bool {
			let i = pos
			return false unless kindAt(i) == TokenKind.Ident
			i++
			for kindAt(i) == TokenKind.Dot && kindAt(i + 1) == TokenKind.Ident {
				i += 2
			}
			return typeArgsAt(i, false)
		}

		// skipGenericArgs is the index after a type argument list that
		// starts at `i`, `i` when none starts there, -1 when it does not
		// close as one.
		internal def skipGenericArgs(i int) int {
			return i unless kindAt(i) == TokenKind.Lt
			let depth = 0
			for i < limit {
				switch tokens.kind(i) {
					case TokenKind.Lt:
						depth++
					case TokenKind.Gt, TokenKind.Shr:
						depth--
						depth-- when tokens.kind(i) == TokenKind.Shr
						return i + 1 when depth == 0
						return -1 when depth < 0
					case TokenKind.Ident, TokenKind.Dot, TokenKind.Comma, TokenKind.Question, TokenKind.Not, TokenKind.BitOr, TokenKind.BitAnd, TokenKind.Def, TokenKind.Async, TokenKind.Weak, TokenKind.LParen, TokenKind.RParen, TokenKind.LBrack, TokenKind.RBrack, TokenKind.Integer:
					default:
						return -1
				}
				i++
			}
			return -1
		}

		// skipTypeArgsOfValue is the index after the type arguments of a
		// value whose name ends at `i - 1` (`Box<int>{}`), -1 when the `<`
		// at `i` is not that.
		internal def skipTypeArgsOfValue(i int) int {
			return -1 when i == 0 || kindAt(i) != TokenKind.Lt
			return -1 unless kindAt(i - 1) == TokenKind.Ident
			return -1 unless upperAt(i - 1) || typeLiteralNameAt(i - 1)
			let end = skipGenericArgs(i)
			return -1 when end <= i || end >= limit
			switch kindAt(end) {
				case TokenKind.LParen, TokenKind.LBrace, TokenKind.LBrack:
					return end
				default:
					return -1
			}
		}

		// isTypeNameAt is true when token `i` can be a type name: a name,
		// or a keyword (`component`, `view`).
		internal def isTypeNameAt(i int) bool {
			let k = kindAt(i)
			return k == TokenKind.Ident || isKeyword(k)
		}

		// looksLikeTypeLiteral is true when the name at the cursor starts a
		// struct literal (`Point{...}`) or a typed array literal
		// (`int[1, 2]`), by the compiler's rules on case and context.
		internal def looksLikeTypeLiteral() bool {
			let i = pos
			return false when i >= limit
			let allowLower = i == 0
			if i > 0 {
				switch kindAt(i - 1) {
					case TokenKind.If, TokenKind.Else, TokenKind.Switch, TokenKind.Match, TokenKind.Select, TokenKind.For, TokenKind.Forall, TokenKind.When, TokenKind.Unless:
						return false
					case TokenKind.Assign, TokenKind.AddAssign, TokenKind.SubAssign, TokenKind.MulAssign, TokenKind.DivAssign, TokenKind.RemAssign, TokenKind.AndAssign, TokenKind.OrAssign, TokenKind.XorAssign, TokenKind.ShlAssign, TokenKind.ShrAssign, TokenKind.RotlAssign, TokenKind.RotrAssign, TokenKind.Comma, TokenKind.LParen, TokenKind.LBrack, TokenKind.LBrace, TokenKind.Semi, TokenKind.Colon, TokenKind.Return, TokenKind.Let, TokenKind.Const, TokenKind.New:
						allowLower = true
					default:
				}
			}
			return false unless isTypeNameAt(i)
			let last = i
			i++
			for kindAt(i) == TokenKind.Dot {
				i++
				return false unless isTypeNameAt(i)
				last = i
				i++
			}
			let lastIsIdent = kindAt(last) == TokenKind.Ident && textLength(last) > 0
			return false when lastIsIdent && !upperAt(last) && !typeLiteralNameAt(last) && !allowLower
			i = skipGenericArgs(i)
			return false when i < 0 || i >= limit
			switch kindAt(i) {
				case TokenKind.LBrace:
					return true
				case TokenKind.LBrack:
					if lastIsIdent {
						let lowerIdent = lowerAt(last) && !typeLiteralNameAt(last)
						return false when lowerIdent && !allowLower
						let depth = 0
						let braces = 0
						let parens = 0
						let separator = false
						let j = i
						for j < limit {
							let k = tokens.kind(j)
							let done = false
							switch k {
								case TokenKind.LBrack:
									depth++
								case TokenKind.RBrack:
									depth--
									done = depth == 0
								case TokenKind.LBrace:
									braces++
								case TokenKind.RBrace:
									braces-- when braces > 0
								case TokenKind.LParen:
									parens++
								case TokenKind.RParen:
									parens-- when parens > 0
								case TokenKind.Lt:
									let end = skipTypeArgsOfValue(j)
									j = end - 1 when end > 0
								case TokenKind.Comma, TokenKind.Semi:
									separator = true when depth == 1 && braces == 0 && parens == 0
								case TokenKind.Colon:
									return false when depth == 1 && braces == 0 && parens == 0
								default:
							}
							j = limit when done
							j++
						}
						return false when lowerIdent && allowLower && !separator && peek() != TokenKind.RBrack
						return false when constantStyleAt(last) && !separator && peek() != TokenKind.RBrack
					}
					return true
				default:
					return false
			}
		}

		// looksLikeTypeCast is true for `Type[](expr)`: an upper-case or
		// builtin name, type arguments, at least one `[]` and a `(`.
		internal def looksLikeTypeCast() bool {
			let i = pos
			return false unless kindAt(i) == TokenKind.Ident
			let last = i
			i++
			for kindAt(i) == TokenKind.Dot {
				i++
				return false unless kindAt(i) == TokenKind.Ident
				last = i
				i++
			}
			return false when textLength(last) == 0
			return false unless upperAt(last) || builtinTypeAt(last)
			i = skipGenericArgs(i)
			return false when i < 0
			let suffix = false
			for kindAt(i) == TokenKind.LBrack && kindAt(i + 1) == TokenKind.RBrack {
				suffix = true
				i += 2
			}
			return false unless suffix
			return kindAt(i) == TokenKind.LParen
		}

		// looksLikeLambdaParams is true for `(...)` followed by `=>` or `->`.
		internal def looksLikeLambdaParams() bool {
			return false unless at(TokenKind.LParen)
			let depth = 0
			for let i = pos; i < limit; i++ {
				switch tokens.kind(i) {
					case TokenKind.LParen:
						depth++
					case TokenKind.RParen:
						depth--
						if depth == 0 {
							let k = kindAt(i + 1)
							return k == TokenKind.FatArrow || k == TokenKind.RArrow
						}
					default:
				}
			}
			return false
		}

		// looksLikeDestructuringLet is true for `let (a, b) = ...`: the
		// parenthesis closes on the line of an assignment.
		internal def looksLikeDestructuringLet() bool {
			let depth = 0
			for let i = pos; i < limit; i++ {
				switch tokens.kind(i) {
					case TokenKind.LParen:
						depth++
					case TokenKind.RParen:
						return false when depth == 0
						depth--
						if depth == 0 {
							return false when i + 1 >= limit || lineBreakBefore(i + 1)
							return isAssignment(kindAt(i + 1))
						}
					default:
				}
			}
			return false
		}

		// canStartType is true when a type can start at the cursor.
		internal def canStartType() bool {
			switch kind() {
				case TokenKind.Async, TokenKind.Question, TokenKind.Not, TokenKind.LParen, TokenKind.Struct, TokenKind.Ident, TokenKind.None, TokenKind.Component, TokenKind.Service, TokenKind.View, TokenKind.Style, TokenKind.LBrack:
					return true
				case TokenKind.Def:
					let next = peek()
					return next == TokenKind.LParen || next == TokenKind.Lt
				default:
					return isKeyword(kind()) && peek() == TokenKind.Dot
			}
		}
	}

	// isAssignment is true for `=` and the compound assignment operators.
	def isAssignment(k TokenKind) bool {
		switch k {
			case TokenKind.Assign, TokenKind.AddAssign, TokenKind.SubAssign, TokenKind.MulAssign, TokenKind.DivAssign, TokenKind.RemAssign, TokenKind.AndAssign, TokenKind.OrAssign, TokenKind.XorAssign, TokenKind.ShlAssign, TokenKind.ShrAssign, TokenKind.RotlAssign, TokenKind.RotrAssign:
				return true
			default:
				return false
		}
	}

	// isStatementBoundary is true for a token that ends a statement or
	// starts the next one.
	def isStatementBoundary(k TokenKind) bool {
		switch k {
			case TokenKind.EOF, TokenKind.RBrace, TokenKind.Semi, TokenKind.Case, TokenKind.Default, TokenKind.For, TokenKind.Forall, TokenKind.If, TokenKind.Return, TokenKind.Fail, TokenKind.Switch, TokenKind.Select, TokenKind.Match, TokenKind.Break, TokenKind.Continue, TokenKind.Defer, TokenKind.Yield, TokenKind.Dispose, TokenKind.Transaction, TokenKind.Check, TokenKind.Expects, TokenKind.Provides, TokenKind.Begin, TokenKind.Rollback, TokenKind.Let, TokenKind.Const, TokenKind.Use, TokenKind.Def, TokenKind.Assert, TokenKind.Application, TokenKind.Library, TokenKind.Plugin, TokenKind.Module, TokenKind.View, TokenKind.Style, TokenKind.Component, TokenKind.Datatype, TokenKind.Service, TokenKind.Type, TokenKind.Union, TokenKind.Interface, TokenKind.Enum, TokenKind.Struct, TokenKind.New:
				return true
			default:
				return false
		}
	}

	// binaryPrecedence is the precedence of a binary operator, 0 for a token
	// that is none; `**` groups from the right.
	def binaryPrecedence(k TokenKind) int {
		switch k {
			case TokenKind.Or:
				return 1
			case TokenKind.And:
				return 2
			case TokenKind.Eq, TokenKind.Neq, TokenKind.Lt, TokenKind.Gt, TokenKind.Leq, TokenKind.Geq, TokenKind.Is, TokenKind.In:
				return 3
			case TokenKind.Range:
				return 4
			case TokenKind.Add, TokenKind.Sub, TokenKind.BitOr, TokenKind.Xor:
				return 5
			case TokenKind.Mul, TokenKind.DotMul, TokenKind.Div, TokenKind.Rem, TokenKind.BitAnd, TokenKind.Shl, TokenKind.Shr, TokenKind.Rotl, TokenKind.Rotr:
				return 6
			case TokenKind.Exp:
				return 7
			default:
				return 0
		}
	}
}
