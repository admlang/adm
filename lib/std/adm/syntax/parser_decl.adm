internal partial module std.adm.syntax.parsing {
	use (
		std.adm.lexer::(TokenKind, isKeyword, isOperator)
		std.adm.syntax::*
	)

	partial type Parser {
		// parseFile parses the whole source into the File node.
		def parseFile() {
			let m = mark()
			for !atEnd() {
				skipOne("file") unless parseTopLevel()
			}
			let last = tokens.len() - 1
			stack.push(tokens[last])
			stackStarts.push(starts[last])
			complete(SyntaxKind.File, m)
		}

		// root is the File node, once parseFile ran.
		def root() Green {
			return stack[0]
		}

		// parseFragment parses the whole source as one node of `kind` (a
		// Block, a Body or a RawBlock), inside a view when `inside` says so;
		// a Block whose parent is `clausesOf` (Switch, Select or Match)
		// holds clauses, not statements. None when the node did not take
		// every token, which is how an incremental edit learns that the
		// block cannot stand alone.
		def parseFragment(kind SyntaxKind, inside bool, clausesOf SyntaxKind) ?Green {
			inView = inside
			switch kind {
				case SyntaxKind.Body:
					parseBodyOf(clausesOf)
				case SyntaxKind.RawBlock:
					parseRawBlock()
				default:
					if clausesOf == SyntaxKind.Switch || clausesOf == SyntaxKind.Select {
						parseClauseBlock(false)
					} else if clausesOf == SyntaxKind.Match {
						parseClauseBlock(true)
					} else {
						parseBlock()
					}
			}
			return none unless atEnd() && stack.len() == 1
			return stack[0]
		}

		// parseBodyOf parses a body in the grammar of what holds it, `owner`
		// (the parent's kind, or the declaration's for a `where` clause): a
		// unit's declarations, a component's parts, an enum's, union's,
		// interface's or datatype's members, a property's accessors, else the
		// members of a type, struct or service. An incremental edit inside a
		// component's `type { }` must parse as the full parse did, or the
		// tree it gives differs from a fresh parse of the same text.
		internal def parseBodyOf(owner SyntaxKind) {
			switch owner {
				case SyntaxKind.ComponentDecl:
					parseComponentBody()
				case SyntaxKind.EnumDecl:
					parseEnumBody()
				case SyntaxKind.UnionDecl:
					parseUnionBody()
				case SyntaxKind.InterfaceDecl:
					parseInterfaceBody()
				case SyntaxKind.DatatypeDecl:
					parseDatatypeBody()
				case SyntaxKind.Property:
					parsePropertyBody()
				case SyntaxKind.TypeDecl, SyntaxKind.StructDecl, SyntaxKind.ServiceDecl:
					parseCompositeBody(owner)
				default:
					parseBody()
			}
		}

		// parseTopLevel parses one unit of a file: a `use`, a module, an
		// application, library or plugin, or a check suite.
		internal def parseTopLevel() bool {
			let m = mark()
			parseAttributes()
			switch kind() {
				case TokenKind.Use:
					parseUseDecl(m)
				case TokenKind.Semi:
					advance()
				case TokenKind.Module, TokenKind.Internal, TokenKind.Partial, TokenKind.Application, TokenKind.Library, TokenKind.Plugin:
					parseUnit(m)
				case TokenKind.Check:
					parseCheck(m)
				default:
					return false unless pushed(m)
					reportHere("expected a declaration after the annotations")
			}
			return true
		}

		// parseUnit parses `[internal [scope]] [partial] module a.b { }`
		// and the application, library and plugin forms.
		internal def parseUnit(m Mark) {
			// `internal` (with its scope) and `partial` come in either
			// order, as the compiler's parseModuleDecl reads them.
			for at(TokenKind.Internal) || at(TokenKind.Partial) {
				if take(TokenKind.Internal) {
					parseQualifiedName() when at(TokenKind.Ident)
				}
				take(TokenKind.Partial)
			}
			let k = kind()
			let node = SyntaxKind.Module
			switch k {
				case TokenKind.Module:
					node = SyntaxKind.Module
				case TokenKind.Application:
					node = SyntaxKind.Application
				case TokenKind.Library:
					node = SyntaxKind.Library
				case TokenKind.Plugin:
					node = SyntaxKind.Plugin
				default:
					reportHere("expected `module`, `application`, `library` or `plugin`")
					complete(SyntaxKind.Module, m)
					return
			}
			advance()
			parseQualifiedName() when at(TokenKind.Ident)
			let outer = unitKind
			unitKind = node
			parseBody()
			unitKind = outer
			complete(node, m)
		}

		internal def parseCheck(m Mark) {
			expect(TokenKind.Check)
			expect(TokenKind.String)
			let outer = unitKind
			unitKind = SyntaxKind.Check
			parseBody()
			unitKind = outer
			complete(SyntaxKind.Check, m)
		}

		// parseBody parses `{ members and statements }` of a unit, a check
		// suite or a composite declaration.
		internal def parseBody() {
			let m = mark()
			expect(TokenKind.LBrace)
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Semi) {
					advance()
					continue
				}
				continue when parseMember()
				continue when parseStatement()
				skipOne("body")
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Body, m)
		}

		// parseMember parses a declaration of a body; false, consuming
		// nothing but annotations, when no declaration starts here.
		internal def parseMember() bool {
			let m = mark()
			parseAttributes()
			let i = pos
			for isModifier(kindAt(i)) {
				i++
			}
			let k = kindAt(i)
			switch k {
				case TokenKind.Def:
					parseFuncDecl(m)
				case TokenKind.Let:
					parseLetDecl(m)
				case TokenKind.Const:
					parseConstDecl(m)
				case TokenKind.Use:
					return false when i != pos
					parseUseDecl(m)
				case TokenKind.Check:
					return false when i != pos
					parseCheck(m)
				case TokenKind.Type, TokenKind.Struct, TokenKind.Enum, TokenKind.Union, TokenKind.Interface, TokenKind.Datatype, TokenKind.Service, TokenKind.Component, TokenKind.View, TokenKind.Style:
					parseComposite(m, k)
				case TokenKind.Module, TokenKind.Application, TokenKind.Library, TokenKind.Plugin:
					parseUnit(m)
				default:
					if i == pos && at(TokenKind.Ident) && current().text == "export" && (unitKind == SyntaxKind.Library || unitKind == SyntaxKind.Plugin) {
						parseExport(m)
						return true
					}
					// A unit's body holds fields and properties as a type's
					// does (the compiler parses both as composite bodies); a
					// check suite's holds statements instead.
					return true when unitKind != SyntaxKind.Check && parseFieldOrProperty(m)
					return false unless pushed(m)
					reportHere("expected a declaration after the annotations")
			}
			return true
		}

		// parseExport parses a library's or plugin's `export a.b::(x)` list,
		// shaped like a `use`.
		internal def parseExport(m Mark) {
			advance()
			if at(TokenKind.LParen) {
				advance()
				for !at(TokenKind.RParen) && !atEnd() {
					let before = pos
					parseUseItem()
					take(TokenKind.Comma)
					skipOne("export") when pos == before
				}
				expect(TokenKind.RParen)
			} else {
				parseUseItem()
			}
			complete(SyntaxKind.Export, m)
		}

		// parseComposite parses a type, struct, enum, union, interface,
		// datatype, service, component, view or style declaration from the
		// mark (which may hold annotations): modifiers, the keyword, the
		// name, type parameters, then an alias or the body the kind takes.
		internal def parseComposite(m Mark, k TokenKind) {
			for isModifier(kind()) {
				advance()
			}
			advance()
			let node = compositeKind(k)
			if at(TokenKind.Ident) {
				advance()
			} else if k != TokenKind.View && k != TokenKind.Style && k != TokenKind.Struct {
				missing(TokenKind.Ident)
			}
			parseTypeParams() when at(TokenKind.Lt) && k != TokenKind.Enum && k != TokenKind.Union && k != TokenKind.Datatype
			switch k {
				case TokenKind.Type:
					if take(TokenKind.Assign) {
						parseAliasType()
					} else {
						parseCompositeBody(node) when at(TokenKind.LBrace)
					}
				case TokenKind.Struct, TokenKind.Service:
					parseCompositeBody(node)
				case TokenKind.Enum:
					parseEnumBody()
				case TokenKind.Union:
					parseUnionBody()
				case TokenKind.Interface:
					parseInterfaceBody()
				case TokenKind.Datatype:
					parseDatatypeBody()
				case TokenKind.Component:
					parseComponentBody()
				case TokenKind.View:
					parseViewBlock()
				default:
					parseBlock()
			}
			complete(node, m)
		}

		// parseAliasType parses the target of `type X = ...`: a type, or a
		// dimension expression over types (`Length / Time ** 2`).
		internal def parseAliasType() {
			let m = mark()
			reportHere("type alias requires a target type") unless parseType()
			return unless at(TokenKind.Mul) || at(TokenKind.Div) || at(TokenKind.Exp)
			parseDimensionTail()
			complete(SyntaxKind.DimensionType, m)
		}

		// parseDimensionTail parses `** n`, `* D` and `/ D` after a
		// dimension, with parenthesised groups.
		internal def parseDimensionTail() {
			parseDimensionPower()
			for at(TokenKind.Mul) || at(TokenKind.Div) {
				advance()
				if !parseDimensionOperand() {
					reportHere("expected a dimension after the operator")
					return
				}
				parseDimensionPower()
			}
		}

		internal def parseDimensionOperand() bool {
			if at(TokenKind.LParen) {
				let m = mark()
				advance()
				return false unless parseDimensionOperand()
				parseDimensionTail()
				expect(TokenKind.RParen)
				complete(SyntaxKind.DimensionType, m)
				return true
			}
			return parseType()
		}

		internal def parseDimensionPower() {
			for at(TokenKind.Exp) {
				advance()
				take(TokenKind.Sub)
				if at(TokenKind.Integer) {
					advance()
				} else {
					reportHere("a dimension's exponent is an integer: Length ** 2")
					return
				}
			}
		}

		// parseCompositeBody parses the body of a type, struct or service:
		// declarations, methods, fields, properties and embedded types.
		internal def parseCompositeBody(owner SyntaxKind) {
			let m = mark()
			expect(TokenKind.LBrace)
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Semi) {
					advance()
					continue
				}
				continue when parseCompositeMember(owner)
				skipOne(describeOwner(owner) + " body")
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Body, m)
		}

		internal def describeOwner(owner SyntaxKind) string {
			return "struct" when owner == SyntaxKind.StructDecl
			return "service" when owner == SyntaxKind.ServiceDecl
			return "type"
		}

		// parseCompositeMember parses one member of a composite body; false,
		// consuming nothing, when none starts here.
		internal def parseCompositeMember(owner SyntaxKind) bool {
			let m = mark()
			parseAttributes()
			let i = pos
			for kindAt(i) == TokenKind.Internal || kindAt(i) == TokenKind.Partial {
				i++
			}
			let k = kindAt(i)
			switch k {
				case TokenKind.Use:
					if i == pos {
						parseUseDecl(m)
						return true
					}
				case TokenKind.Check:
					if i == pos {
						parseCheck(m)
						return true
					}
				case TokenKind.Let:
					parseLetDecl(m)
					return true
				case TokenKind.Const:
					parseConstDecl(m)
					return true
				case TokenKind.Where:
					if i == pos {
						advance()
						parseHeader(allowEmpty = false, allowInit = false)
						parseCompositeBody(owner)
						complete(SyntaxKind.Where, m)
						return true
					}
				// `view` and `style` inside a type body name members
				// (`style style`), not declarations.
				case TokenKind.Type, TokenKind.Struct, TokenKind.Enum, TokenKind.Union, TokenKind.Interface, TokenKind.Datatype, TokenKind.Service, TokenKind.Component:
					parseComposite(m, k)
					return true
				case TokenKind.Module, TokenKind.Application, TokenKind.Library, TokenKind.Plugin:
					parseUnit(m)
					return true
				default:
			}
			if memberStartsFunction() {
				parseFuncDecl(m)
				return true
			}
			if atEmbedField() {
				parseNamedType()
				complete(SyntaxKind.Embedding, m)
				return true
			}
			return true when parseFieldOrProperty(m)
			return false unless pushed(m)
			reportHere("expected a declaration after the annotations")
			return true
		}

		// memberStartsFunction is true when, past the member modifiers, a
		// `def` follows.
		internal def memberStartsFunction() bool {
			let i = pos
			for isMemberModifier(kindAt(i)) {
				i++
			}
			return kindAt(i) == TokenKind.Def
		}

		// atEmbedField is true for a type name alone on its line (`Base`,
		// `a.B<T>`): an embedded struct or type.
		internal def atEmbedField() bool {
			let i = pos
			return false unless kindAt(i) == TokenKind.Ident
			i++
			for kindAt(i) == TokenKind.Dot && kindAt(i + 1) == TokenKind.Ident {
				i += 2
			}
			if kindAt(i) == TokenKind.Lt && !lineBreakBefore(i) {
				let depth = 0
				for {
					let k = kindAt(i)
					return false when k == TokenKind.EOF || k == TokenKind.LBrace || k == TokenKind.RBrace || k == TokenKind.Semi || k == TokenKind.Assign
					depth++ when k == TokenKind.Lt
					depth-- when k == TokenKind.Gt
					depth -= 2 when k == TokenKind.Shr
					i++
					break when depth <= 0
				}
			}
			let next = kindAt(i)
			return true when next == TokenKind.EOF || next == TokenKind.Semi || next == TokenKind.RBrace
			return lineBreakBefore(i)
		}

		// parseFieldOrProperty parses `[internal] [atomic] [weak] names
		// [Type] [= values]`, or a property `name Type { accessors }`.
		internal def parseFieldOrProperty(m Mark) bool {
			parseFieldModifiers()
			let names = parseMemberIdentList()
			if names == 0 {
				reset(m)
				return false
			}
			let typed = false
			typed = parseType() when canStartType()
			if at(TokenKind.LBrace) {
				parsePropertyBody()
				complete(SyntaxKind.Property, m)
				return true
			}
			reportHere("a member declaration requires a type or an initializer") when !typed && !isAssignment(kind())
			parseMemberValues(names)
			complete(SyntaxKind.Field, m)
			return true
		}

		// parseMemberValues parses `= v, w` after a member's names; a comma
		// that starts another declaration ends the values.
		internal def parseMemberValues(names int) {
			return unless isAssignment(kind())
			advance()
			let values = 0
			for {
				values++ when parseExpressionUpTo(true, [TokenKind.Comma, TokenKind.Semi, TokenKind.RBrace])
				break unless at(TokenKind.Comma)
				break when commaSeparatesDeclaration() && (names <= 1 || values >= names)
				advance()
			}
		}

		// parseMemberIdentList consumes member names (a name, `view` or
		// `style`) with their commas, and is how many there were.
		internal def parseMemberIdentList() int {
			let count = 0
			for at(TokenKind.Ident) || at(TokenKind.View) || at(TokenKind.Style) {
				advance()
				count++
				let next = peek()
				break unless at(TokenKind.Comma) && (next == TokenKind.Ident || next == TokenKind.View || next == TokenKind.Style)
				advance()
			}
			return count
		}

		// parsePropertyBody parses `{ get/set accessors and storage fields }`.
		internal def parsePropertyBody() {
			let m = mark()
			expect(TokenKind.LBrace)
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Semi) {
					advance()
					continue
				}
				let pm = mark()
				parseAttributes()
				if memberStartsFunction() {
					parseFuncDecl(pm)
					continue
				}
				take(TokenKind.Internal)
				take(TokenKind.Atomic)
				let names = parseIdentList(false)
				if names == 0 {
					reset(pm)
					skipOne("property body")
					continue
				}
				let typed = false
				typed = parseType() when canStartType()
				reportHere("property storage declarations require a type or initializer") when !typed && !isAssignment(kind())
				parseMemberValues(names)
				complete(SyntaxKind.Field, pm)
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Body, m)
		}

		// parseEnumBody parses `{ Name, Name = value, ... }`.
		internal def parseEnumBody() {
			let m = mark()
			expect(TokenKind.LBrace)
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Semi) || at(TokenKind.Comma) {
					advance()
					continue
				}
				let em = mark()
				parseAttributes()
				if !at(TokenKind.Ident) {
					reset(em)
					skipOne("enum body")
					continue
				}
				advance()
				if take(TokenKind.Assign) {
					reportHere("expected a value after `=`") unless parseExpression()
				}
				take(TokenKind.Comma)
				complete(SyntaxKind.EnumMember, em)
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Body, m)
		}

		// parseUnionBody parses `{ [internal] Name [Type], ... }`.
		internal def parseUnionBody() {
			let m = mark()
			expect(TokenKind.LBrace)
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Semi) || at(TokenKind.Comma) {
					advance()
					continue
				}
				let um = mark()
				parseAttributes()
				take(TokenKind.Internal)
				if !at(TokenKind.Ident) {
					reset(um)
					skipOne("union body")
					continue
				}
				advance()
				parseType() unless at(TokenKind.RBrace) || at(TokenKind.Comma) || at(TokenKind.Semi)
				take(TokenKind.Comma)
				complete(SyntaxKind.UnionMember, um)
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Body, m)
		}

		// parseInterfaceBody parses method signatures (`[def] [async] name
		// [<T>](params) [async] [Return]`) and embedded interfaces (a name
		// alone).
		internal def parseInterfaceBody() {
			let m = mark()
			expect(TokenKind.LBrace)
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Semi) || at(TokenKind.Comma) {
					advance()
					continue
				}
				let im = mark()
				parseAttributes()
				take(TokenKind.Def)
				take(TokenKind.Async)
				if !at(TokenKind.Ident) {
					reset(im)
					skipOne("interface body")
					continue
				}
				advance()
				for take(TokenKind.Dot) {
					if at(TokenKind.Ident) {
						advance()
					} else {
						missing(TokenKind.Ident)
					}
				}
				if !at(TokenKind.LParen) && !at(TokenKind.Lt) {
					complete(SyntaxKind.Embedding, im)
					continue
				}
				parseTypeParams() when at(TokenKind.Lt)
				parseParams()
				take(TokenKind.Async)
				parseType() when canStartType()
				complete(SyntaxKind.FuncDecl, im)
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Body, m)
		}

		// parseDatatypeBody parses the fields of a datatype.
		internal def parseDatatypeBody() {
			let m = mark()
			expect(TokenKind.LBrace)
			parseFieldsUntil(TokenKind.RBrace, true)
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Body, m)
		}

		// parseComponentBody parses `{ use ...; view ...; style ...; type ... }`:
		// each of view, style and type either inline (`view { }`, `type <T>
		// { }`) or a reference to a declaration (`view Name`).
		internal def parseComponentBody() {
			let m = mark()
			expect(TokenKind.LBrace)
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Semi) {
					advance()
					continue
				}
				let cm = mark()
				parseAttributes()
				switch kind() {
					case TokenKind.Use:
						parseUseDecl(cm)
					case TokenKind.View:
						advance()
						if at(TokenKind.LBrace) {
							parseViewBlock()
						} else {
							parseQualifiedName()
							parseViewBlock() when at(TokenKind.LBrace)
						}
						complete(SyntaxKind.ViewDecl, cm)
					case TokenKind.Style:
						advance()
						if at(TokenKind.LBrace) {
							parseBlock()
						} else {
							parseQualifiedName()
							parseBlock() when at(TokenKind.LBrace)
						}
						complete(SyntaxKind.StyleDecl, cm)
					case TokenKind.Type:
						advance()
						if at(TokenKind.LBrace) || at(TokenKind.Lt) {
							parseTypeParams() when at(TokenKind.Lt)
							parseCompositeBody(SyntaxKind.TypeDecl)
						} else {
							parseQualifiedName()
							parseCompositeBody(SyntaxKind.TypeDecl) when at(TokenKind.LBrace)
						}
						complete(SyntaxKind.TypeDecl, cm)
					default:
						if pushed(cm) {
							reportHere("expected `use`, `view`, `style` or `type` after the annotations")
						} else {
							skipOne("component body")
						}
				}
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Body, m)
		}

		internal def compositeKind(k TokenKind) SyntaxKind {
			switch k {
				case TokenKind.Struct:
					return SyntaxKind.StructDecl
				case TokenKind.Enum:
					return SyntaxKind.EnumDecl
				case TokenKind.Union:
					return SyntaxKind.UnionDecl
				case TokenKind.Interface:
					return SyntaxKind.InterfaceDecl
				case TokenKind.Datatype:
					return SyntaxKind.DatatypeDecl
				case TokenKind.Service:
					return SyntaxKind.ServiceDecl
				case TokenKind.Component:
					return SyntaxKind.ComponentDecl
				case TokenKind.View:
					return SyntaxKind.ViewDecl
				case TokenKind.Style:
					return SyntaxKind.StyleDecl
				default:
					return SyntaxKind.TypeDecl
			}
		}

		// parseRawBlock keeps a brace-balanced block as raw tokens.
		internal def parseRawBlock() {
			let m = mark()
			expect(TokenKind.LBrace)
			let depth = 1
			for !atEnd() {
				depth++ when at(TokenKind.LBrace)
				if at(TokenKind.RBrace) {
					depth--
					break when depth == 0
				}
				advance()
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.RawBlock, m)
		}

		// ------------------------------------------------------------
		// Annotations
		// ------------------------------------------------------------

		// parseAttributes parses every `@name(args)` at the cursor.
		internal def parseAttributes() {
			for at(TokenKind.At) {
				let m = mark()
				advance()
				// An annotation's name follows its `@` on the same line: a bare
				// `@` being typed above `def f()` or `count int` leaves the
				// declaration in place instead of naming the annotation after
				// its first word.
				if lineBreakBefore(pos) || !parseAttributeTarget() {
					reportHere("expected an annotation name")
					complete(SyntaxKind.Attribute, m)
					break
				}
				parseTypeArgs() when at(TokenKind.Lt) && typeArgsAt(pos, false)
				parseAttributeArgs() when at(TokenKind.LParen)
				complete(SyntaxKind.Attribute, m)
			}
		}

		internal def parseAttributeTarget() bool {
			let m = mark()
			return false unless at(TokenKind.Ident) || isKeyword(kind())
			advance()
			let qualified = false
			for at(TokenKind.Dot) {
				advance()
				qualified = true
				if !lineBreakBefore(pos) && (at(TokenKind.Ident) || isKeyword(kind())) {
					advance()
				} else {
					missing(TokenKind.Ident)
					break
				}
			}
			complete(qualified ?? (SyntaxKind.QualifiedName, SyntaxKind.Name), m)
			return true
		}

		internal def parseAttributeArgs() {
			let m = mark()
			expect(TokenKind.LParen)
			let count = 0
			for !at(TokenKind.RParen) && !atEnd() {
				if count > 0 {
					if !take(TokenKind.Comma) {
						reportHere("expected `,` in attribute arguments")
						break
					}
				}
				let am = mark()
				let sep = peek()
				if isAttributeArgName() && (sep == TokenKind.Colon || sep == TokenKind.Assign) {
					advance()
					advance()
				}
				parseAttributeArg()
				complete(SyntaxKind.Arg, am)
				count++
			}
			expect(TokenKind.RParen)
			complete(SyntaxKind.Args, m)
		}

		// isAttributeArgName is true when the current token spells a plain
		// ASCII name, keyword or not.
		internal def isAttributeArgName() bool {
			let text = current().text
			return false when text.len() == 0
			for let (i, c) in text {
				return false unless c.isASCII()
				return false when i == 0 && !(c == '_' || c.isLetter())
				return false unless c == '_' || c.isLetter() || c.isDigit()
			}
			return true
		}

		// parseAttributeArg parses one annotation argument: a name chain or
		// a literal when one stands alone, else an expression.
		internal def parseAttributeArg() {
			let m = mark()
			if parseSimpleExpr() {
				return when at(TokenKind.Comma) || at(TokenKind.RParen) || atEnd()
				reset(m)
			}
			return when parseExpression()
			skipOne("annotation argument")
		}

		// parseSimpleExpr parses the simple forms an annotation argument
		// takes: a name chain, a literal, a signed literal, a function, an
		// array or struct literal.
		internal def parseSimpleExpr() bool {
			let m = mark()
			let k = kind()
			switch k {
				case TokenKind.Self:
					advance()
					complete(SyntaxKind.Name, m)
					return true
				case TokenKind.Def:
					return parseFuncDecl(m)
				case TokenKind.String, TokenKind.Char, TokenKind.Integer, TokenKind.Float, TokenKind.Imaginary, TokenKind.Bool, TokenKind.None, TokenKind.Duration:
					return parseInterpolatedString() when k == TokenKind.String && peek() == TokenKind.InterpLBrace
					advance()
					advance() when at(TokenKind.Unit) && (k == TokenKind.Integer || k == TokenKind.Float)
					complete(SyntaxKind.Literal, m)
					return true
				case TokenKind.Sub, TokenKind.Add:
					advance()
					reportHere("expected an operand") unless parseSimpleExpr()
					complete(SyntaxKind.Unary, m)
					return true
				case TokenKind.LBrack:
					parseArrayLiteral(m)
					return true
				case TokenKind.LBrace:
					parseStructLiteral(m)
					return true
				default:
					return false unless k == TokenKind.Ident || isKeyword(k)
					advance()
					let qualified = false
					for at(TokenKind.Dot) {
						advance()
						qualified = true
						expectMemberName()
					}
					complete(qualified ?? (SyntaxKind.QualifiedName, SyntaxKind.Name), m)
					return true
			}
		}

		// ------------------------------------------------------------
		// let, const and fields
		// ------------------------------------------------------------

		internal def parseLetDecl(m Mark) {
			take(TokenKind.Internal)
			expect(TokenKind.Let)
			if at(TokenKind.LParen) && looksLikeDestructuringLet() {
				let dm = mark()
				expect(TokenKind.LParen)
				for !at(TokenKind.RParen) && !atEnd() {
					if !at(TokenKind.Ident) {
						reportHere("expected identifier in destructuring let")
						break
					}
					let bm = mark()
					advance()
					if take(TokenKind.As) {
						if at(TokenKind.Ident) {
							advance()
						} else {
							reportHere("expected identifier after `as`")
						}
					}
					complete(SyntaxKind.Binding, bm)
					break unless take(TokenKind.Comma)
				}
				expect(TokenKind.RParen)
				complete(SyntaxKind.Destructure, dm)
				if isAssignment(kind()) {
					advance()
					reportHere("expected an expression") unless parseExpression()
				} else {
					reportHere("destructuring let requires initializer")
				}
			} else if at(TokenKind.LParen) {
				advance()
				parseFieldsUntil(TokenKind.RParen, false)
				expect(TokenKind.RParen)
			} else {
				parseUngroupedFields()
			}
			complete(SyntaxKind.LetDecl, m)
		}

		internal def parseConstDecl(m Mark) {
			take(TokenKind.Internal)
			expect(TokenKind.Const)
			if at(TokenKind.LParen) {
				advance()
				parseFieldsUntil(TokenKind.RParen, false)
				expect(TokenKind.RParen)
			} else {
				parseUngroupedFields()
			}
			complete(SyntaxKind.ConstDecl, m)
		}

		// parseFieldsUntil parses field declarations up to `end`, one per
		// line or separated by commas.
		internal def parseFieldsUntil(end TokenKind, stopAtComma bool) {
			let count = 0
			for !at(end) && !atEnd() {
				if at(TokenKind.Semi) {
					advance()
					continue
				}
				if count > 0 && !take(TokenKind.Comma) && !lineBreakBefore(pos) {
					reportHere("expected `,` between declarations")
					break
				}
				break unless parseField(stopAtComma)
				count++
			}
		}

		internal def parseUngroupedFields() {
			return unless parseField(true)
			for take(TokenKind.Comma) {
				break unless parseField(true)
			}
		}

		// parseFieldModifiers consumes `internal`, `atomic` and `weak` in
		// any order, each at most once (the compiler's parseFieldPrefix).
		internal def parseFieldModifiers() {
			let seenInternal = false
			let seenAtomic = false
			let seenWeak = false
			for {
				if !seenInternal && at(TokenKind.Internal) {
					seenInternal = true
				} else if !seenAtomic && at(TokenKind.Atomic) {
					seenAtomic = true
				} else if !seenWeak && at(TokenKind.Weak) {
					seenWeak = true
				} else {
					return
				}
				advance()
			}
		}

		// parseField parses `[annotations] [internal] [atomic] [weak] names
		// [Type] [= values]`; false when no name starts here.
		internal def parseField(stopAtComma bool) bool {
			let m = mark()
			parseAttributes()
			parseFieldModifiers()
			let names = parseIdentList(stopAtComma)
			if names == 0 && at(TokenKind.LParen) {
				let dm = mark()
				advance()
				for !at(TokenKind.RParen) && !atEnd() {
					if !at(TokenKind.Ident) {
						reportHere("expected identifier")
						break
					}
					advance()
					names++
					continue when take(TokenKind.Comma)
					break unless at(TokenKind.RParen)
				}
				expect(TokenKind.RParen)
				complete(SyntaxKind.Destructure, dm)
			}
			if names == 0 {
				if isKeyword(kind()) {
					reportHere("expected identifier, found a keyword; it cannot be used as a name")
				} else {
					reportHere("expected identifier in declaration")
				}
				if pushed(m) {
					complete(SyntaxKind.Field, m)
					return true
				}
				reset(m)
				return false
			}
			if stopAtComma && !atEnd() && lineBreakBefore(pos) {
				complete(SyntaxKind.Field, m)
				return true
			}
			let typed = false
			typed = parseType() when canStartType()
			typed = parseType() when !typed && take(TokenKind.Colon)
			if isAssignment(kind()) {
				advance()
				let values = 0
				for {
					values++ when parseExpression()
					break unless at(TokenKind.Comma)
					break when stopAtComma && commaSeparatesDeclaration() && (names <= 1 || values >= names)
					advance()
				}
			}
			complete(SyntaxKind.Field, m)
			return true
		}

		// commaSeparatesDeclaration is true when the token after the comma
		// at the cursor starts another declaration rather than a value.
		internal def commaSeparatesDeclaration() bool {
			switch peek() {
				case TokenKind.EOF, TokenKind.Semi, TokenKind.RParen, TokenKind.RBrace, TokenKind.At, TokenKind.Internal, TokenKind.Atomic, TokenKind.Weak, TokenKind.Ident:
					return true
				default:
					return false
			}
		}

		// parseIdentList consumes the names of a declaration, with their
		// commas, and is how many there were. With `stopAtComma` a dotted
		// name (`size.width`) is one name and a comma before a line break
		// ends the list.
		internal def parseIdentList(stopAtComma bool) int {
			let count = 0
			for at(TokenKind.Ident) {
				advance()
				if stopAtComma {
					for at(TokenKind.Dot) && peek() == TokenKind.Ident {
						advance()
						advance()
					}
				}
				count++
				break unless at(TokenKind.Comma) && peek() == TokenKind.Ident
				break when stopAtComma && lineBreakBefore(pos + 1)
				advance()
			}
			return count
		}

		// ------------------------------------------------------------
		// use
		// ------------------------------------------------------------

		internal def parseUseDecl(m Mark) {
			expect(TokenKind.Use)
			if at(TokenKind.LParen) {
				advance()
				for !at(TokenKind.RParen) && !atEnd() {
					let before = pos
					parseUseItem()
					take(TokenKind.Comma)
					skipOne("use") when pos == before
				}
				expect(TokenKind.RParen)
			} else {
				parseUseItem()
			}
			complete(SyntaxKind.Use, m)
		}

		// parseUseItem parses `a.b [as x] [::symbols]`.
		internal def parseUseItem() {
			let m = mark()
			parseQualifiedName()
			if take(TokenKind.As) {
				if at(TokenKind.Ident) {
					advance()
				} else {
					missing(TokenKind.Ident)
				}
			}
			if take(TokenKind.ColonColon) {
				if at(TokenKind.LParen) {
					let sm = mark()
					advance()
					if at(TokenKind.Mul) {
						advance()
						for !at(TokenKind.RParen) && !atEnd() {
							skipOne("wildcard import")
						}
					} else {
						let count = 0
						for !at(TokenKind.RParen) && !atEnd() {
							if count > 0 && !take(TokenKind.Comma) {
								reportHere("expected `,` between imported symbols")
								break
							}
							if at(TokenKind.Mul) {
								reportHere("wildcard import cannot be combined with named symbols") when count > 0
								advance()
								break
							}
							parseUseSymbol()
							count++
						}
					}
					expect(TokenKind.RParen)
					complete(SyntaxKind.UseSymbols, sm)
				} else if at(TokenKind.Mul) {
					advance()
				} else {
					parseUseSymbol()
				}
			}
			complete(SyntaxKind.UseItem, m)
		}

		internal def parseUseSymbol() {
			let m = mark()
			if at(TokenKind.Ident) {
				advance()
			} else {
				missing(TokenKind.Ident)
			}
			if take(TokenKind.As) {
				if at(TokenKind.Ident) {
					advance()
				} else {
					missing(TokenKind.Ident)
				}
			}
			complete(SyntaxKind.UseSymbol, m)
		}

		// parseQualifiedName parses `a.b.c`; a keyword part is accepted
		// as the compiler does, with a missing name where a part is absent.
		internal def parseQualifiedName() {
			let m = mark()
			if at(TokenKind.Ident) || isKeyword(kind()) {
				advance()
			} else {
				missing(TokenKind.Ident)
				complete(SyntaxKind.QualifiedName, m)
				return
			}
			for at(TokenKind.Dot) {
				advance()
				if at(TokenKind.Ident) || isKeyword(kind()) {
					advance()
				} else {
					missing(TokenKind.Ident)
					break
				}
			}
			complete(SyntaxKind.QualifiedName, m)
		}

		// ------------------------------------------------------------
		// Functions
		// ------------------------------------------------------------

		// parseFuncDecl parses a function or method, named or not, from the
		// mark (which may hold annotations): modifiers, `def`, the name,
		// type parameters, parameters, the return type and the body or a
		// `;` for a signature.
		internal def parseFuncDecl(m Mark) bool {
			take(TokenKind.Internal)
			let isInfix = false
			let raw = false
			for isModifier(kind()) {
				if at(TokenKind.Weak) {
					reportHere("weak applies to fields only")
				} else if at(TokenKind.Partial) {
					reportHere("partial applies to types and modules only")
				}
				isInfix = true when at(TokenKind.Infix)
				raw = true when at(TokenKind.Cuda) || at(TokenKind.Sql)
				advance()
			}
			expect(TokenKind.Def)
			if at(TokenKind.Ident) || at(TokenKind.New) || at(TokenKind.Dispose) {
				advance()
			} else if isInfix && isOperator(kind()) {
				advance()
			} else if isInfix {
				reportHere("expected an operator")
			} else if isKeyword(kind()) {
				reportHere("expected identifier, found a keyword; it cannot be used as a name")
				advance()
			}
			parseTypeParams() when at(TokenKind.Lt)
			parseParams()
			parseType() when canStartType()
			if take(TokenKind.Semi) {
				complete(SyntaxKind.FuncDecl, m)
				return true
			}
			if raw {
				parseRawBlock()
			} else {
				parseBlock()
			}
			complete(SyntaxKind.FuncDecl, m)
			return true
		}

		internal def parseParams() {
			let m = mark()
			expect(TokenKind.LParen)
			let count = 0
			for !at(TokenKind.RParen) && !atEnd() {
				if count > 0 {
					if !take(TokenKind.Comma) {
						reportHere("expected `,` between parameters")
						break
					}
				}
				break unless parseParam()
				count++
			}
			expect(TokenKind.RParen)
			complete(SyntaxKind.Params, m)
		}

		// parseParam parses `[annotations] names [...] [Type] [= default]`
		// or a parenthesised destructuring; false when nothing starts here.
		internal def parseParam() bool {
			let m = mark()
			parseAttributes()
			if at(TokenKind.LParen) {
				let dm = mark()
				let depth = 0
				for !atEnd() {
					depth++ when at(TokenKind.LParen)
					if at(TokenKind.RParen) {
						depth--
						if depth == 0 {
							advance()
							break
						}
					}
					advance()
				}
				complete(SyntaxKind.Destructure, dm)
			} else {
				for at(TokenKind.Ident) {
					advance()
					break unless at(TokenKind.Comma) && peek() == TokenKind.Ident
					advance()
				}
			}
			let ellipsis = take(TokenKind.Ellipsis)
			let typed = false
			typed = parseType() when canStartType()
			reportHere("variadic parameter requires a type") when ellipsis && !typed
			let valued = false
			if take(TokenKind.Assign) {
				valued = parseExpressionUpTo(false, [TokenKind.Comma, TokenKind.RParen])
				reportHere("parameter default value requires an expression") unless valued
			} else if !at(TokenKind.Comma) && !at(TokenKind.RParen) {
				valued = parseExpressionUpTo(false, [TokenKind.Comma, TokenKind.RParen])
			}
			return false unless pushed(m)
			reportHere("variadic parameter must be last") when ellipsis && !at(TokenKind.RParen)
			reportHere("parameter requires a type (or a default value)") when !typed && !valued
			complete(SyntaxKind.Param, m)
			return true
		}
	}

	// isMemberModifier is true for a keyword that may precede a member of
	// a composite body.
	def isMemberModifier(k TokenKind) bool {
		switch k {
			case TokenKind.Internal, TokenKind.Atomic, TokenKind.Weak, TokenKind.Async, TokenKind.Cuda, TokenKind.Sql, TokenKind.Meta, TokenKind.Infix:
				return true
			default:
				return false
		}
	}

	// isModifier is true for a keyword that may precede a declaration.
	def isModifier(k TokenKind) bool {
		switch k {
			case TokenKind.Internal, TokenKind.Partial, TokenKind.Atomic, TokenKind.Async, TokenKind.Cuda, TokenKind.Sql, TokenKind.Meta, TokenKind.Infix, TokenKind.Weak:
				return true
			default:
				return false
		}
	}
}
