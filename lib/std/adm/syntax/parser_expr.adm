internal partial module std.adm.syntax.parsing {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::*
	)

	partial type Parser {
		// parseExpressionUpTo parses an expression that ends before a
		// terminator outside brackets, or at a line break with
		// `stopOnNewline`; what is left of that range goes into a Skipped
		// node. False when nothing was consumed.
		internal def parseExpressionUpTo(stopOnNewline bool, terminators TokenKind[]) bool {
			let end = exprEnd(stopOnNewline, terminators)
			return false when end <= pos
			let m = mark()
			let saved = limit
			limit = end
			parseExpression()
			skipTo(end, "expression") when pos < end
			limit = saved
			return pushed(m)
		}

		internal def parseExpression() bool {
			return parseAssignmentExpr()
		}

		// parseAssignmentExpr parses a binary expression with its `??`
		// choices, a conditional junction `:=`, or an assignment, which
		// groups from the right.
		internal def parseAssignmentExpr() bool {
			let m = mark()
			return false unless parseBinaryExpr(1)
			for at(TokenKind.Choice) {
				advance()
				expect(TokenKind.LParen)
				reportHere("choice operator requires expressions for both branches") unless parseExpression()
				expect(TokenKind.Comma)
				reportHere("choice operator requires expressions for both branches") unless parseExpression()
				expect(TokenKind.RParen)
				complete(SyntaxKind.Choice, m)
			}
			if at(TokenKind.Junction) {
				advance()
				reportHere("conditional junction requires at least one expression") unless parseBinaryExpr(1)
				complete(SyntaxKind.Junction, m)
				return true
			}
			return true unless isAssignment(kind())
			advance()
			reportHere("expected an expression") unless parseAssignmentExpr()
			complete(SyntaxKind.Assign, m)
			return true
		}

		// parseBinaryExpr parses binary operators by precedence climbing;
		// `**` groups from the right, and `is` takes a type on its right.
		internal def parseBinaryExpr(minPrec int) bool {
			let m = mark()
			return false unless parseUnaryExpr()
			for {
				let op = kind()
				let prec = binaryPrecedence(op)
				break when prec == 0 || prec < minPrec
				advance()
				let next = op == TokenKind.Exp ?? (prec, prec + 1)
				if op == TokenKind.Is && genericTypeAhead() {
					parseBaseType()
				} else {
					// An open bound (`a..`) has no right operand.
					parseBinaryExpr(next)
				}
				complete(SyntaxKind.Binary, m)
			}
			return true
		}

		// parseUnaryExpr parses prefix operators and the keyword forms
		// `await`, `async`, `try` and `new`.
		internal def parseUnaryExpr() bool {
			let m = mark()
			switch kind() {
				case TokenKind.Inc, TokenKind.Dec, TokenKind.Add, TokenKind.Sub, TokenKind.Not, TokenKind.Xor, TokenKind.Tilde, TokenKind.LArrow, TokenKind.Question, TokenKind.Ellipsis:
					advance()
					reportHere("expected an operand") unless parseUnaryExpr()
					complete(SyntaxKind.Unary, m)
					return true
				case TokenKind.Await:
					advance()
					reportHere("expected an expression after `await`") unless parseBinaryExpr(0)
					parseOnError() when at(TokenKind.Onerror)
					complete(SyntaxKind.Await, m)
					return true
				case TokenKind.Async:
					advance()
					if at(TokenKind.Lt) {
						advance()
						reportHere("expected the scope of async<scope>") unless parsePostfixExpr()
						if at(TokenKind.Gt) {
							advance()
						} else {
							reportHere("expected `>` after the scope of async<scope>")
						}
					}
					reportHere("async call prefix expects a call expression") unless parseUnaryExpr()
					complete(SyntaxKind.Async, m)
					return true
				case TokenKind.Try:
					advance()
					reportHere("expected an expression after `try`") unless parseUnaryExpr()
					complete(SyntaxKind.Try, m)
					return true
				case TokenKind.New:
					advance()
					let called = parseNewRest()
					complete(SyntaxKind.New, m)
					parsePostfixOps(m) when called
					return true
				default:
					return parsePostfixExpr()
			}
		}

		// parseNewRest parses what follows `new`: the type, unless the
		// arguments come right away, then the arguments. True when there
		// were arguments, which a method chain may follow.
		internal def parseNewRest() bool {
			if !at(TokenKind.LParen) {
				reportHere("new expression requires a type") unless parseType()
			}
			return false unless at(TokenKind.LParen)
			parseArgs(true)
			return true
		}

		// parseArgs parses `(a, name = b)` into an Args node of Arg nodes;
		// with `allowColon`, `name: b` names an argument too.
		internal def parseArgs(allowColon bool) {
			let m = mark()
			expect(TokenKind.LParen)
			let count = 0
			let seenNamed = false
			for !at(TokenKind.RParen) && !atEnd() {
				if count > 0 {
					if !take(TokenKind.Comma) {
						reportHere("expected `,` between arguments")
						break
					}
					break when at(TokenKind.RParen)
				}
				let am = mark()
				let sep = peek()
				// `style = {...}` on a component call or a rule names the
				// argument with the keyword.
				let named = sep == TokenKind.Assign || (allowColon && sep == TokenKind.Colon)
				if (at(TokenKind.Ident) && named) || (at(TokenKind.Style) && sep == TokenKind.Assign) {
					advance()
					advance()
					reportHere("expected an expression") unless parseExpression()
					complete(SyntaxKind.Arg, am)
					seenNamed = true
					count++
					continue
				}
				reportHere("positional arguments cannot follow named arguments") when seenNamed
				break unless parseExpression()
				complete(SyntaxKind.Arg, am)
				count++
			}
			expect(TokenKind.RParen)
			complete(SyntaxKind.Args, m)
		}

		internal def parsePostfixExpr() bool {
			let m = mark()
			return false unless parsePrimaryExpr()
			parsePostfixOps(m)
			return true
		}

		// parsePostfixOps applies calls, member accesses, indexes and
		// postfix `++`/`--` to the operand that began at the mark. A `(` or
		// `[` on a new line starts the next statement instead.
		internal def parsePostfixOps(m Mark) {
			for {
				if at(TokenKind.Lt) && typeArgsAt(pos, true) {
					parseTypeArgs()
					parseArgs(false)
					parseOnError() when at(TokenKind.Onerror)
					complete(SyntaxKind.Call, m)
					continue
				}
				switch kind() {
					case TokenKind.LParen:
						return when lineBreakBefore(pos)
						parseArgs(false)
						parseOnError() when at(TokenKind.Onerror)
						complete(SyntaxKind.Call, m)
					case TokenKind.Dot:
						advance()
						if at(TokenKind.Integer) {
							advance()
						} else {
							expectMemberName()
						}
						complete(SyntaxKind.Member, m)
					case TokenKind.LBrack:
						return when lineBreakBefore(pos)
						parseIndexOrSlice(m)
					case TokenKind.Inc, TokenKind.Dec:
						advance()
						complete(SyntaxKind.Unary, m)
					default:
						return
				}
			}
		}

		internal def parseIndexOrSlice(m Mark) {
			expect(TokenKind.LBrack)
			let slice = false
			parseExpression() unless at(TokenKind.Colon) || at(TokenKind.RBrack)
			if at(TokenKind.Colon) {
				advance()
				slice = true
				parseExpression() unless at(TokenKind.RBrack)
			}
			expect(TokenKind.RBrack)
			complete(slice ?? (SyntaxKind.Slice, SyntaxKind.Index), m)
		}

		// parsePrimaryExpr parses an atom: a literal, a name, a lambda, a
		// parenthesised expression or tuple, a literal of a type, `assert`.
		internal def parsePrimaryExpr() bool {
			let m = mark()
			let k = kind()
			switch k {
				case TokenKind.String:
					return parseInterpolatedString() when peek() == TokenKind.InterpLBrace
					advance()
					complete(SyntaxKind.Literal, m)
					return true
				case TokenKind.Char, TokenKind.Integer, TokenKind.Float, TokenKind.Imaginary, TokenKind.Bool, TokenKind.None, TokenKind.Duration:
					advance()
					advance() when at(TokenKind.Unit) && (k == TokenKind.Integer || k == TokenKind.Float)
					complete(SyntaxKind.Literal, m)
					return true
				case TokenKind.Def:
					return parseFuncDecl(m)
				case TokenKind.Sql:
					return parseFuncDecl(m) when peek() == TokenKind.Def
					return false
				case TokenKind.Regex:
					advance()
					complete(SyntaxKind.Literal, m)
					return true
				case TokenKind.Ident:
					return parseLambdaSingle() when peek() == TokenKind.FatArrow || peek() == TokenKind.RArrow
					if looksLikeTypeCast() {
						return true when parseCast()
					}
					if looksLikeTypeLiteral() {
						return true when parseTypeLiteral()
					}
					advance()
					complete(SyntaxKind.Name, m)
					return true
				case TokenKind.View, TokenKind.Style:
					if k == TokenKind.View && peek() == TokenKind.LBrace {
						advance()
						parseViewBlock()
						complete(SyntaxKind.ViewExpr, m)
						return true
					}
					if peek() == TokenKind.Dot {
						advance()
						complete(SyntaxKind.Name, m)
						return true
					}
					return false
				case TokenKind.Self:
					advance()
					complete(SyntaxKind.Name, m)
					return true
				case TokenKind.LParen:
					return parseLambdaParen() when looksLikeLambdaParams()
					return parseParen()
				case TokenKind.LBrack:
					parseArrayLiteral(m)
					return true
				case TokenKind.LBrace:
					parseStructLiteral(m)
					return true
				case TokenKind.Struct:
					advance()
					parseStructLiteral(m)
					return true
				case TokenKind.Assert:
					return parseAssertExpr()
				default:
					return false
			}
		}

		// parseInterpolatedString parses the segments of a string and the
		// expressions between them.
		internal def parseInterpolatedString() bool {
			let m = mark()
			expect(TokenKind.String)
			for at(TokenKind.InterpLBrace) {
				let im = mark()
				advance()
				reportHere("expected expression in string interpolation") unless parseExpressionUpTo(true, interpolationEnd)
				expect(TokenKind.InterpRBrace)
				complete(SyntaxKind.Interpolation, im)
				expect(TokenKind.String)
			}
			complete(SyntaxKind.InterpString, m)
			return true
		}

		// parseLambdaSingle parses `x => body` and `x -> body`.
		internal def parseLambdaSingle() bool {
			let m = mark()
			let pm = mark()
			advance()
			complete(SyntaxKind.Param, pm)
			advance()
			parseLambdaBody()
			complete(SyntaxKind.Lambda, m)
			return true
		}

		// parseLambdaParen parses `(a, b int) => body`.
		internal def parseLambdaParen() bool {
			let m = mark()
			let params = mark()
			expect(TokenKind.LParen)
			let count = 0
			for !at(TokenKind.RParen) && !atEnd() {
				if count > 0 {
					if !take(TokenKind.Comma) {
						reportHere("expected `,` between lambda parameters")
						break
					}
				}
				break unless at(TokenKind.Ident)
				let pm = mark()
				advance()
				parseType() when canStartType()
				complete(SyntaxKind.Param, pm)
				count++
			}
			expect(TokenKind.RParen)
			complete(SyntaxKind.Params, params)
			if at(TokenKind.FatArrow) || at(TokenKind.RArrow) {
				advance()
			} else {
				reportHere("expected `=>` after lambda parameters")
			}
			parseLambdaBody()
			complete(SyntaxKind.Lambda, m)
			return true
		}

		internal def parseLambdaBody() {
			if at(TokenKind.LBrace) {
				parseBlock()
				return
			}
			reportHere("lambda requires an expression body") unless parseAssignmentExpr()
		}

		// parseParen parses `(expr)` or a tuple `(a, b)`.
		internal def parseParen() bool {
			let m = mark()
			expect(TokenKind.LParen)
			let count = 0
			let hadComma = false
			for !at(TokenKind.RParen) && !atEnd() {
				count++ when parseExpression()
				break unless take(TokenKind.Comma)
				hadComma = true
				break when at(TokenKind.RParen)
			}
			expect(TokenKind.RParen)
			complete(count == 1 && !hadComma ?? (SyntaxKind.Paren, SyntaxKind.Tuple), m)
			return true
		}

		// parseAssertExpr parses `assert cond` with an optional handler.
		internal def parseAssertExpr() bool {
			let m = mark()
			expect(TokenKind.Assert)
			reportHere("assert requires an expression") unless parseExpressionUpTo(true, assertEnd)
			parseOnError() when at(TokenKind.Onerror)
			complete(SyntaxKind.Assert, m)
			return true
		}

		// parseArrayLiteral parses `[a, b]` after the mark (which may hold
		// an element type); rows separated by `;` become Row nodes.
		internal def parseArrayLiteral(m Mark) {
			expect(TokenKind.LBrack)
			let row = mark()
			let rows = false
			for !at(TokenKind.RBrack) && !atEnd() {
				if at(TokenKind.Semi) {
					complete(SyntaxKind.Row, row)
					advance()
					row = mark()
					rows = true
					continue
				}
				if !parseExpression() {
					skipOne("array literal") unless at(TokenKind.RBrack) || at(TokenKind.Comma) || at(TokenKind.Semi) || atEnd()
				}
				take(TokenKind.Comma)
			}
			complete(SyntaxKind.Row, row) when rows
			expect(TokenKind.RBrack)
			complete(SyntaxKind.ArrayLit, m)
		}

		// parseStructLiteral parses `{key: value, ...spread}` after the mark
		// (which may hold a type).
		internal def parseStructLiteral(m Mark) {
			expect(TokenKind.LBrace)
			let count = 0
			for !at(TokenKind.RBrace) && !atEnd() {
				if count > 0 {
					break unless take(TokenKind.Comma) || take(TokenKind.Semi)
				}
				break when at(TokenKind.RBrace)
				let fm = mark()
				if (at(TokenKind.View) || at(TokenKind.Style)) && peek() == TokenKind.Colon {
					advance()
				} else {
					break unless parseExpression()
				}
				if at(TokenKind.Colon) {
					advance()
					reportHere("expected a value after `:`") unless parseExpression()
				}
				complete(SyntaxKind.FieldInit, fm)
				count++
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.StructLit, m)
		}

		// parseTypeLiteral parses `Type{...}` and `Type[...]`; false,
		// consuming nothing, when neither follows the type.
		internal def parseTypeLiteral() bool {
			let m = mark()
			return false unless parseTypeReference()
			switch kind() {
				case TokenKind.LBrace:
					parseStructLiteral(m)
					return true
				case TokenKind.LBrack:
					for at(TokenKind.LBrack) && peek() == TokenKind.RBrack && kindAt(pos + 2) == TokenKind.LBrack {
						advance()
						advance()
						complete(SyntaxKind.ArrayType, m)
					}
					parseArrayLiteral(m)
					return true
				default:
					reset(m)
					return false
			}
		}

		// parseCast parses `Type(expr)`; false, consuming nothing, when no
		// `(` follows the type.
		internal def parseCast() bool {
			let m = mark()
			return false unless parseType()
			if !at(TokenKind.LParen) {
				reset(m)
				return false
			}
			expect(TokenKind.LParen)
			let count = 0
			for !at(TokenKind.RParen) && !atEnd() {
				if count > 0 {
					break unless take(TokenKind.Comma)
					break when at(TokenKind.RParen)
				}
				break unless parseExpression()
				count++
			}
			reportHere("type cast requires an expression") when count == 0
			reportHere("type cast expects exactly 1 argument") when count > 1
			expect(TokenKind.RParen)
			complete(SyntaxKind.Cast, m)
			return true
		}

		// parseOnError parses `onerror`, an optional `(name Type)` binding,
		// and a block or an inline handler statement.
		internal def parseOnError() {
			let m = mark()
			expect(TokenKind.Onerror)
			if take(TokenKind.LParen) {
				if at(TokenKind.Ident) {
					advance()
				} else {
					reportHere("expected identifier for onerror binding")
				}
				reportHere("expected type for onerror binding") unless parseType()
				expect(TokenKind.RParen)
			}
			if at(TokenKind.LBrace) {
				parseBlock()
				complete(SyntaxKind.OnError, m)
				return
			}
			let end = statementEnd(true)
			if end > pos {
				let saved = limit
				let handler = mark()
				limit = end
				parseStatement()
				if pos < end {
					// Inside a call's arguments the handler ends at the comma:
					// `f(x onerror recover 0, y)`.
					let comma = topLevelIndex(handler.2, end, TokenKind.Comma)
					if comma > handler.2 {
						reset(handler)
						limit = comma
						parseStatement()
					}
					skipTo(limit, "onerror handler") when pos < limit
				}
				limit = saved
			}
			complete(SyntaxKind.OnError, m)
		}

		// topLevelIndex is the index of the first token of kind `k` outside
		// brackets between `from` and `to`, -1 when there is none.
		internal def topLevelIndex(from int, to int, k TokenKind) int {
			let depth = noDepth
			for let i = from; i < to; i++ {
				return i when balanced(depth) && tokens.kind(i) == k
				depth = step(depth, tokens.kind(i))
			}
			return -1
		}
	}
}
