internal partial module std.adm.syntax.parsing {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax::*
	)

	partial type Parser {
		// parseBlock parses `{ statements }` into a Block node.
		internal def parseBlock() {
			let m = mark()
			expect(TokenKind.LBrace)
			parseStatementsUntilClose()
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Block, m)
		}

		// parseViewBlock parses the block of a view, where a call followed
		// by a block places a component.
		internal def parseViewBlock() {
			let outer = inView
			inView = true
			parseBlock()
			inView = outer
		}

		internal def parseStatementsUntilClose() {
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Semi) {
					advance()
					continue
				}
				skipOne("block") unless parseStatement()
			}
		}

		// parseStatement parses one statement at the cursor; false at `}`
		// or the end.
		internal def parseStatement() bool {
			return false when at(TokenKind.RBrace) || atEnd()
			let m = mark()
			switch kind() {
				case TokenKind.At:
					parseAttributes()
					if at(TokenKind.Let) {
						parseLetDecl(m)
					} else if at(TokenKind.Const) {
						parseConstDecl(m)
					} else {
						reportHere("annotations in a statement position must decorate a `let` or `const`")
						skipStatement()
					}
				case TokenKind.For, TokenKind.Forall:
					parseFor(m)
				case TokenKind.If:
					parseIf(m)
				case TokenKind.Return:
					parseValueStatement(m, SyntaxKind.Return, true)
				case TokenKind.Fail:
					parseValueStatement(m, SyntaxKind.Fail, false)
				case TokenKind.Recover:
					parseValueStatement(m, SyntaxKind.Recover, false)
				case TokenKind.Yield:
					parseValueStatement(m, SyntaxKind.Yield, true)
				case TokenKind.Switch:
					parseSwitch(m, SyntaxKind.Switch, allowEmpty = true)
				case TokenKind.Match:
					parseSwitch(m, SyntaxKind.Match, allowEmpty = false)
				case TokenKind.Select:
					advance()
					parseClauseBlock(false)
					complete(SyntaxKind.Select, m)
				case TokenKind.Where:
					parseWhere(m)
				case TokenKind.Break:
					advance()
					endSimple(m, SyntaxKind.Break)
				case TokenKind.Continue:
					advance()
					endSimple(m, SyntaxKind.Continue)
				case TokenKind.Defer:
					advance()
					reportHere("defer requires a call expression") unless parseExpression()
					take(TokenKind.Semi)
					complete(SyntaxKind.Defer, m)
				case TokenKind.Dispose:
					advance()
					reportHere("dispose requires an expression") unless parseExpression()
					endSimple(m, SyntaxKind.Dispose)
				case TokenKind.Transaction:
					advance()
					parseBlock()
					parseOnError() when at(TokenKind.Onerror)
					complete(SyntaxKind.Transaction, m)
				case TokenKind.Check:
					reportHere("check suites are not allowed inside function bodies")
					skipStatement()
				case TokenKind.Expects, TokenKind.Provides, TokenKind.Begin:
					parseGuardedBlock(m)
				case TokenKind.Rollback:
					if peek() == TokenKind.LBrace {
						parseGuardedBlock(m)
					} else {
						advance()
						parseExpression() unless at(TokenKind.When) || at(TokenKind.Unless)
						endSimple(m, SyntaxKind.Rollback)
					}
				case TokenKind.Let:
					parseLetDecl(m)
				case TokenKind.Const:
					parseConstDecl(m)
				case TokenKind.Use:
					parseUseDecl(m)
				case TokenKind.LBrace:
					parseBlock()
				default:
					parseExpressionStatement(m)
			}
			return true
		}

		// skipStatement puts the rest of the statement into a Skipped node.
		internal def skipStatement() {
			let end = statementEnd(false)
			if end > pos {
				skipTo(end, "statement")
			} else {
				skipOne("statement")
			}
		}

		// endSimple finishes a statement node, wraps it in its guards and
		// takes a trailing `;`.
		internal def endSimple(m Mark, kind SyntaxKind) {
			complete(kind, m)
			wrapGuards(m)
			take(TokenKind.Semi)
		}

		// wrapGuards wraps the node since the mark in a Guard for each
		// trailing `when cond` or `unless cond`.
		internal def wrapGuards(m Mark) {
			for at(TokenKind.When) || at(TokenKind.Unless) {
				advance()
				reportHere("expected a condition") unless parseExpressionUpTo(true, guardEnd)
				complete(SyntaxKind.Guard, m)
			}
		}

		// parseValueStatement parses `return`, `fail`, `recover` or `yield`
		// with an optional value; `stopsAtBoundary` leaves the value out
		// before `;`, `case`, `default`, `}` and the end as well.
		internal def parseValueStatement(m Mark, kind SyntaxKind, stopsAtBoundary bool) {
			advance()
			let bare = at(TokenKind.When) || at(TokenKind.Unless)
			bare = bare || at(TokenKind.Semi) || at(TokenKind.Case) || at(TokenKind.Default) || at(TokenKind.RBrace) || atEnd() when stopsAtBoundary
			if !bare {
				let had = parseExpression()
				reportHere("recover requires an expression") when !had && kind == SyntaxKind.Recover
				reportHere("yield requires a value") when !had && kind == SyntaxKind.Yield
			}
			endSimple(m, kind)
		}

		// parseExpressionStatement parses an expression as a statement: a
		// send, a parallel assignment, a component placed in a view, or a
		// plain expression with its guards.
		internal def parseExpressionStatement(m Mark) {
			if !parseExpression() {
				skipStatement()
				return
			}
			if at(TokenKind.LArrow) && !lineBreakBefore(pos) {
				advance()
				reportHere("send statement requires a value") unless parseExpression()
				endSimple(m, SyntaxKind.Send)
				return
			}
			if inView {
				parseViewComponentStatement(m)
				return
			}
			if at(TokenKind.Comma) {
				return when parseMultiAssign(m)
			}
			complete(SyntaxKind.ExprStmt, m)
			wrapGuards(m)
			return when take(TokenKind.Semi)
			skipStatement() when !lineBreakBefore(pos) && !isStatementBoundary(kind())
		}

		// parseMultiAssign parses the rest of `a, b = b, a` after the first
		// expression; false, consuming nothing, when no `=` follows the
		// list.
		internal def parseMultiAssign(m Mark) bool {
			let s = mark()
			for take(TokenKind.Comma) {
				if !parseExpressionUpTo(true, assignTargetEnd) {
					reset(s)
					return false
				}
			}
			if !at(TokenKind.Assign) {
				reset(s)
				return false
			}
			advance()
			for {
				break unless parseExpressionUpTo(true, listItemEnd)
				break unless take(TokenKind.Comma)
			}
			endSimple(m, SyntaxKind.MultiAssign)
			return true
		}

		// parseViewComponentStatement finishes a statement of a view: a call
		// followed by a block places a component with children.
		internal def parseViewComponentStatement(m Mark) {
			if topKind() == SyntaxKind.Call && at(TokenKind.LBrace) {
				parseViewBlock()
				endSimple(m, SyntaxKind.ComponentCall)
				return
			}
			endSimple(m, SyntaxKind.ExprStmt)
		}

		// parseHeader parses the header of `if`, `switch`, `match` or
		// `where`: an optional `init;` and a condition, up to the `{` of
		// the body.
		internal def parseHeader(allowEmpty bool, allowInit bool) {
			let end = headerEnd(allowEmpty)
			return when end <= pos
			let m = mark()
			let saved = limit
			limit = end
			let semi = allowInit ?? (topLevelIndex(pos, end, TokenKind.Semi), -1)
			if semi >= 0 {
				limit = semi
				parseInitStatement()
				skipTo(semi, "header") when pos < semi
				limit = end
				advance()
			}
			reportHere("expected a condition") unless parseExpression()
			skipTo(end, "header") when pos < end
			limit = saved
			complete(SyntaxKind.Header, m)
		}

		// parseInitStatement parses the init part of a header: a `let` or
		// an expression statement.
		internal def parseInitStatement() {
			let m = mark()
			if at(TokenKind.Let) {
				parseLetDecl(m)
				return
			}
			return unless parseExpression()
			if at(TokenKind.Comma) {
				return when parseMultiAssign(m)
			}
			complete(SyntaxKind.ExprStmt, m)
		}

		internal def parseIf(m Mark) {
			expect(TokenKind.If)
			parseHeader(allowEmpty = false, allowInit = true)
			parseBlock()
			if at(TokenKind.Else) {
				let em = mark()
				advance()
				if at(TokenKind.If) {
					parseIf(mark())
				} else {
					parseBlock()
				}
				complete(SyntaxKind.Else, em)
			}
			complete(SyntaxKind.If, m)
		}

		// parseFor parses `for` and `forall` loops: a header that is a
		// condition, `init; cond; post` or `init in expr`, the body, and
		// the `every`, `empty`, `break` and `finish` clauses.
		internal def parseFor(m Mark) {
			advance()
			let end = headerEnd(true)
			if end > pos {
				let hm = mark()
				let saved = limit
				limit = end
				let inAt = topLevelIndex(pos, end, TokenKind.In)
				if inAt >= 0 {
					limit = inAt
					parseInitStatement()
					skipTo(inAt, "loop header") when pos < inAt
					limit = end
					advance()
					reportHere("expected what the loop ranges over") unless parseExpression()
				} else {
					let first = topLevelIndex(pos, end, TokenKind.Semi)
					if first < 0 {
						parseExpression()
					} else {
						limit = first
						parseInitStatement()
						skipTo(first, "loop header") when pos < first
						limit = end
						advance()
						let second = topLevelIndex(pos, end, TokenKind.Semi)
						if second >= 0 {
							limit = second
							parseExpression()
							skipTo(second, "loop header") when pos < second
							limit = end
							advance()
							parseInitStatement()
						} else {
							parseExpression()
						}
					}
				}
				skipTo(end, "loop header") when pos < end
				limit = saved
				complete(SyntaxKind.Header, hm)
			}
			parseBlock()
			let seenEvery = false
			let seenEmpty = false
			let seenBreak = false
			let seenFinish = false
			for {
				let cm = mark()
				let k = kind()
				if k == TokenKind.Every {
					reportHere("duplicate every block") when seenEvery
					seenEvery = true
					advance()
					parseExpressionUpTo(false, blockStart) unless at(TokenKind.LBrace)
				} else if k == TokenKind.Empty {
					reportHere("duplicate empty block") when seenEmpty
					seenEmpty = true
					advance()
				} else if k == TokenKind.Finish {
					reportHere("duplicate finish block") when seenFinish
					seenFinish = true
					advance()
				} else if k == TokenKind.Break && peek() == TokenKind.LBrace && !seenBreak {
					seenBreak = true
					advance()
				} else {
					break
				}
				parseBlock()
				complete(SyntaxKind.LoopClause, cm)
			}
			complete(SyntaxKind.For, m)
		}

		internal def parseSwitch(m Mark, kind SyntaxKind, allowEmpty bool) {
			advance()
			parseHeader(allowEmpty, true)
			parseClauseBlock(kind == SyntaxKind.Match)
			complete(kind, m)
		}

		// parseClauseBlock parses `{ case ...: ... default: ... }`.
		internal def parseClauseBlock(isMatch bool) {
			let m = mark()
			expect(TokenKind.LBrace)
			for !at(TokenKind.RBrace) && !atEnd() {
				if at(TokenKind.Case) || at(TokenKind.Default) {
					parseClause(isMatch)
					continue
				}
				if at(TokenKind.Semi) {
					advance()
					continue
				}
				skipOne("switch body: expected `case` or `default`")
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.Block, m)
		}

		// parseClause parses one `case` or `default` clause with its
		// values or patterns, an optional `; guard`, and its statements.
		internal def parseClause(isMatch bool) {
			let m = mark()
			let isCase = at(TokenKind.Case)
			advance()
			if isCase {
				if isMatch {
					parsePatternList()
				} else {
					parseClauseExprList()
				}
			}
			if take(TokenKind.Semi) {
				reportHere("expected a guard condition") unless parseExpressionUpTo(false, caseGuardEnd)
			}
			expect(TokenKind.Colon)
			for !atEnd() {
				break when at(TokenKind.Case) || at(TokenKind.Default) || at(TokenKind.RBrace)
				if at(TokenKind.Semi) {
					advance()
					continue
				}
				skipOne("clause") unless parseStatement()
			}
			complete(isCase ?? (SyntaxKind.Case, SyntaxKind.Default), m)
		}

		internal def parseClauseExprList() {
			let count = 0
			for !at(TokenKind.Colon) && !at(TokenKind.Semi) && !atEnd() {
				count++ when parseExpressionUpTo(false, caseItemEnd)
				break unless take(TokenKind.Comma)
				break when at(TokenKind.Semi) || at(TokenKind.Colon)
			}
			reportHere("case requires at least one expression") when count == 0
		}

		internal def parsePatternList() {
			let count = 0
			for !at(TokenKind.Colon) && !at(TokenKind.Semi) && !atEnd() {
				count++ when parsePattern()
				break unless take(TokenKind.Comma)
				break when at(TokenKind.Semi) || at(TokenKind.Colon)
			}
			reportHere("match case requires at least one pattern") when count == 0
		}

		// parsePattern parses a match pattern: `none`, a struct or tuple
		// pattern, a qualified value such as an enum member, a type, or an
		// expression.
		internal def parsePattern() bool {
			let m = mark()
			if at(TokenKind.None) {
				advance()
				complete(SyntaxKind.Literal, m)
				return true
			}
			return parseStructPattern() when at(TokenKind.LBrace)
			return parseTuplePattern() when at(TokenKind.LParen)
			if at(TokenKind.Ident) && peek() == TokenKind.Dot && kindAt(pos + 2) == TokenKind.Ident {
				let threeNames = kindAt(pos + 3) == TokenKind.Dot && kindAt(pos + 4) == TokenKind.Ident
				if threeNames || upperAt(pos) {
					return true when parseExpressionUpTo(false, caseItemEnd)
				}
			}
			if canStartType() {
				return true when parseType()
			}
			return true when parseExpressionUpTo(false, caseItemEnd)
			reportHere("invalid match pattern")
			return false
		}

		internal def parseStructPattern() bool {
			let m = mark()
			expect(TokenKind.LBrace)
			let count = 0
			for !at(TokenKind.RBrace) && !atEnd() {
				if count > 0 {
					if !take(TokenKind.Comma) {
						reportHere("expected `,` between struct pattern fields")
						break
					}
					break when at(TokenKind.RBrace)
				}
				break unless at(TokenKind.Ident)
				let fm = mark()
				advance()
				if take(TokenKind.Colon) {
					parseType()
				} else if canStartType() && !at(TokenKind.Comma) && !at(TokenKind.RBrace) {
					parseType()
				}
				complete(SyntaxKind.PatternField, fm)
				count++
			}
			expect(TokenKind.RBrace)
			complete(SyntaxKind.StructPattern, m)
			return true
		}

		internal def parseTuplePattern() bool {
			let m = mark()
			expect(TokenKind.LParen)
			for !at(TokenKind.RParen) && !atEnd() {
				parseTupleElement()
				break unless take(TokenKind.Comma)
				break when at(TokenKind.RParen)
			}
			expect(TokenKind.RParen)
			complete(SyntaxKind.TuplePattern, m)
			return true
		}

		internal def parseTupleElement() {
			switch kind() {
				case TokenKind.LBrace:
					parseStructPattern()
				case TokenKind.LParen:
					parseTuplePattern()
				case TokenKind.Ident:
					let m = mark()
					advance()
					complete(SyntaxKind.Binding, m)
				default:
					reportHere("invalid tuple pattern element") unless parseExpressionUpTo(false, itemInParensEnd)
			}
		}

		internal def parseWhere(m Mark) {
			advance()
			parseHeader(allowEmpty = false, allowInit = false)
			reportHere("unterminated where block") when atEnd()
			parseBlock()
			endSimple(m, SyntaxKind.Where)
		}

		// parseGuardedBlock parses `expects { }`, `provides { }`, `begin
		// { }` and `rollback { }`, each with an optional handler.
		internal def parseGuardedBlock(m Mark) {
			advance()
			parseBlock()
			parseOnError() when at(TokenKind.Onerror)
			complete(SyntaxKind.Block, m)
		}
	}
}
