partial module std.adm.syntax {
	use std.testing

	// kindsOf is the kinds of the nodes (not tokens) below the root, parents
	// first, as names joined by spaces.
	internal def kindsOf(tree SyntaxTree) string {
		let out string[]
		for let (_, n) in tree.root().descendants() {
			out.push(n.kind().name) unless n.isToken()
		}
		return out.join(" ")
	}

	// firstOf is the first node of `kind` below the root.
	internal def firstOf(tree SyntaxTree, kind SyntaxKind) SyntaxNode {
		for let (_, n) in tree.root().descendants() {
			return n when n.kind() == kind
		}
		assert false
		return tree.root()
	}

	// countOf is how many nodes of `kind` the tree holds.
	internal def countOf(tree SyntaxTree, kind SyntaxKind) int {
		let count = 0
		for let (_, n) in tree.root().descendants() {
			count++ when n.kind() == kind
		}
		return count
	}

	// messages is every diagnostic message of the tree, joined by `; `.
	internal def messages(tree SyntaxTree) string {
		let out string[]
		for let (_, d) in tree.diagnostics() {
			out.push("{d.start}: {d.message}")
		}
		return out.join("; ")
	}

	// clean parses the source and asserts that it has no diagnostic and
	// spells the source back.
	internal def clean(source string) SyntaxTree {
		let tree = parse(source)
		assert tree.text() == source
		assert tree.root().fullText() == source
		assert tree.diagnostics().len() == 0
		return tree
	}

	// diagnosticsText is the tree's diagnostics as `start-end message` lines.
	internal def diagnosticsText(tree SyntaxTree) string {
		let out = ""
		for let (_, d) in tree.diagnostics() {
			out += "{d.start}-{d.end} {d.message}\n"
		}
		return out
	}

	check "Parser" {
		@test()
		def TestExpressions() {
			let tree = clean("module m \{\n\tdef f() int \{\n\t\treturn 1 + 2 * 3 ** 4 ** 5\n\t\}\n\}\n")
			let sum = firstOf(tree, SyntaxKind.Binary)
			assert sum.text() == "1 + 2 * 3 ** 4 ** 5"
			let product = present(sum.child(2))
			assert product.kind() == SyntaxKind.Binary && product.text() == "2 * 3 ** 4 ** 5"
			let power = present(product.child(2))
			assert power.text() == "3 ** 4 ** 5"
			assert present(power.child(2)).text() == "4 ** 5"
			let unary = clean("module m \{\n\tdef f() \{\n\t\tlet v = -a.b[1:2](c, d = 3)++ ?? (x, y)\n\t\}\n\}\n")
			let kinds = kindsOf(unary)
			assert kinds.contains("Choice Unary Unary Call Slice Member Name Literal Literal Args Arg Name Arg Literal Name Name")
			let junction = clean("module m \{\n\tdef f() \{\n\t\tlet ok = x := 1 || 2\n\t\tlet cast = int(y)\n\t\tlet lit = Point\{x: 1, ...base\}\n\t\tlet arr = int[1, 2; 3, 4]\n\t\tlet text = \"a \{name\} b\"\n\t\tlet pair = t.0\n\t\}\n\}\n")
			assert countOf(junction, SyntaxKind.Junction) == 1
			// `int(y)` is a call; a cast is written `Type[](value)`.
			assert countOf(junction, SyntaxKind.Cast) == 0 && countOf(junction, SyntaxKind.Call) == 1
			let cast = clean("module m \{\n\tdef f() \{\n\t\tlet b = byte[](data)\n\t\}\n\}\n")
			assert countOf(cast, SyntaxKind.Cast) == 1 && countOf(cast, SyntaxKind.ArrayType) == 1
			assert countOf(junction, SyntaxKind.StructLit) == 1 && countOf(junction, SyntaxKind.FieldInit) == 2
			assert countOf(junction, SyntaxKind.ArrayLit) == 1 && countOf(junction, SyntaxKind.Row) == 2
			assert countOf(junction, SyntaxKind.InterpString) == 1 && countOf(junction, SyntaxKind.Interpolation) == 1
			assert firstOf(junction, SyntaxKind.Member).text() == "t.0"
			let lambdas = clean("module m \{\n\tdef f() \{\n\t\tlet a = x => x + 1\n\t\tlet b = (x, y int) => \{ return x \}\n\t\tlet c = def (c char) bool \{ return c.isDigit() \}\n\t\tlet d = new Point(1, 2).str()\n\t\tlet e = try g() onerror recover 0\n\t\tlet f = await h() onerror (err error) \{ recover none \}\n\t\}\n\}\n")
			assert countOf(lambdas, SyntaxKind.Lambda) == 2
			assert countOf(lambdas, SyntaxKind.FuncDecl) == 2
			assert countOf(lambdas, SyntaxKind.New) == 1 && firstOf(lambdas, SyntaxKind.New).text() == "new Point(1, 2)"
			assert countOf(lambdas, SyntaxKind.Try) == 1 && countOf(lambdas, SyntaxKind.Await) == 1
			assert countOf(lambdas, SyntaxKind.OnError) == 2
		}

		@test()
		def TestStatements() {
			let tree = clean("module m \{\n\tdef f(xs int[]) int \{\n\t\tlet n = 0\n\t\tfor let (i, x) in xs \{\n\t\t\tcontinue when x < 0\n\t\t\tn += x\n\t\t\} every i % 2 \{\n\t\t\tn++\n\t\t\} finish \{\n\t\t\tn--\n\t\t\}\n\t\tif let y = n; y > 10 \{\n\t\t\treturn y\n\t\t\} else if n == 0 \{\n\t\t\tfail \"zero\"\n\t\t\} else \{\n\t\t\tn, m = m, n\n\t\t\}\n\t\tswitch n \{\n\t\tcase 1, 2:\n\t\t\treturn 1\n\t\tcase 3; n > 2:\n\t\t\treturn 3\n\t\tdefault:\n\t\t\}\n\t\tmatch v \{\n\t\tcase \{age int, name string\}; age < 20:\n\t\tcase (a, b):\n\t\tcase Kind.Open:\n\t\tcase none:\n\t\tcase string:\n\t\t\}\n\t\tch <- n\n\t\tdefer close()\n\t\treturn n unless n < 0\n\t\treturn 0\n\t\}\n\}\n")
			assert countOf(tree, SyntaxKind.For) == 1 && countOf(tree, SyntaxKind.LoopClause) == 2
			assert countOf(tree, SyntaxKind.If) == 2 && countOf(tree, SyntaxKind.Else) == 2
			assert countOf(tree, SyntaxKind.Header) == 5
			assert countOf(tree, SyntaxKind.MultiAssign) == 1
			assert countOf(tree, SyntaxKind.Switch) == 1 && countOf(tree, SyntaxKind.Match) == 1
			assert countOf(tree, SyntaxKind.Case) == 7 && countOf(tree, SyntaxKind.Default) == 1
			assert countOf(tree, SyntaxKind.StructPattern) == 1 && countOf(tree, SyntaxKind.TuplePattern) == 1
			assert countOf(tree, SyntaxKind.Send) == 1 && countOf(tree, SyntaxKind.Defer) == 1
			assert countOf(tree, SyntaxKind.Guard) == 2
			assert countOf(tree, SyntaxKind.Return) == 5 && countOf(tree, SyntaxKind.Fail) == 1
		}

		@test()
		def TestDeclarations() {
			let tree = clean("// doc\n@cfg(os = \"linux\")\ninternal partial module a.b \{\n\tuse (\n\t\tstd.io\n\t\tstd.os::(File as F, readFile)\n\t\tstd.strings::*\n\t)\n\n\tconst (\n\t\tA = 1\n\t\tB, C = 2, 3\n\t)\n\n\tinternal let count int = 0\n\n\t// Adds things.\n\t@test()\n\tasync def add<T: Numeric>(a T, b T = 1, rest ...int) !T \{\n\t\treturn a + b\n\t\}\n\n\ttype Point \{\n\t\tx float\n\t\}\n\n\tenum Kind \{ Open, Close \}\n\n\ttype Speed = Length / Time\n\}\n\napplication Demo \{\n\tdef new(args string[]) int \{\n\t\treturn 0\n\t\}\n\}\n\ncheck \"Suite\" \{\n\t@test()\n\tdef TestA() \{\n\t\tassert 1 == 1\n\t\}\n\}\n")
			assert countOf(tree, SyntaxKind.Module) == 1 && countOf(tree, SyntaxKind.Application) == 1 && countOf(tree, SyntaxKind.Check) == 1
			assert countOf(tree, SyntaxKind.Use) == 1 && countOf(tree, SyntaxKind.UseItem) == 3 && countOf(tree, SyntaxKind.UseSymbol) == 2
			assert countOf(tree, SyntaxKind.ConstDecl) == 1 && countOf(tree, SyntaxKind.Field) == 4
			assert countOf(tree, SyntaxKind.LetDecl) == 1
			assert countOf(tree, SyntaxKind.FuncDecl) == 3 && countOf(tree, SyntaxKind.Param) == 4
			assert countOf(tree, SyntaxKind.TypeParams) == 1 && countOf(tree, SyntaxKind.TypeParam) == 1
			assert countOf(tree, SyntaxKind.Attribute) == 3
			assert countOf(tree, SyntaxKind.TypeDecl) == 2 && countOf(tree, SyntaxKind.EnumDecl) == 1
			assert countOf(tree, SyntaxKind.Assert) == 1
			let add = firstOf(tree, SyntaxKind.FuncDecl)
			assert add.text().startsWith("@test()\n\tasync def add")
			assert present(add.firstToken()).text() == "@"
		}

		@test()
		def TestTokenEdits() {
			let source = "module m \{\n\tdef a() int \{\n\t\tlet value = 12 // sum\n\t\treturn value\n\t\}\n\n\tdef b() int \{\n\t\treturn 2\n\t\}\n\}\n"
			let tree = clean(source)
			let fnA = firstOf(tree, SyntaxKind.FuncDecl)
			let fnB = present(fnA.nextSibling())
			let valueAt = source.indexOf("value")
			// A letter typed into a name changes that token alone: every other
			// token keeps its text, b's node its text one character later; the
			// new tree is a new version, none of its nodes the same as before.
			let typed = tree.edit(valueAt + 2, valueAt + 2, "x")
			assert typed.text() == source.replace("let value", "let vaxlue")
			assert typed.root().fullText() == typed.text()
			assert typed.diagnostics().len() == 0
			assert typed.root().dump() == parse(typed.text()).root().dump()
			let typedB = present(present(firstOf(typed, SyntaxKind.FuncDecl)).nextSibling())
			assert !typedB.same(fnB) && typedB.text() == fnB.text() && typedB.start() == fnB.start() + 1
			assert !typed.root().same(tree.root())
			let oldTokens = fnA.tokens()
			let newTokens = present(firstOf(typed, SyntaxKind.FuncDecl)).tokens()
			assert oldTokens.len() == newTokens.len()
			let changed = 0
			for let (i, old) in oldTokens {
				changed += 1 unless old.text() == newTokens[i].text()
			}
			assert changed == 1
			// A digit typed at the end of a number extends that token.
			let numAt = source.indexOf("12")
			let longer = tree.edit(numAt + 2, numAt + 2, "3")
			assert longer.text().contains("let value = 123")
			assert longer.root().dump() == parse(longer.text()).root().dump()
			// A name that becomes a keyword, or a token that splits, is parsed
			// again and still agrees with a full parse.
			let retAt = source.indexOf("return value")
			let keyword = tree.edit(valueAt, valueAt + 5, "return")
			assert keyword.root().dump() == parse(keyword.text()).root().dump()
			let split = tree.edit(valueAt + 2, valueAt + 2, "+")
			assert split.root().dump() == parse(split.text()).root().dump()
			assert split.diagnostics().len() == parse(split.text()).diagnostics().len()
			// Spaces typed into trivia and letters typed into a comment keep
			// the tokens; a line break typed into trailing trivia moves to the
			// parser and still agrees.
			let spaced = tree.edit(numAt, numAt, "  ")
			assert spaced.text().contains("= " + "  12")
			assert spaced.root().dump() == parse(spaced.text()).root().dump()
			assert present(present(firstOf(spaced, SyntaxKind.FuncDecl)).nextSibling()).text() == fnB.text()
			let commentAt = source.indexOf("sum") + 3
			let commented = tree.edit(commentAt, commentAt, " of two")
			assert commented.text().contains("// sum of two")
			assert commented.root().dump() == parse(commented.text()).root().dump()
			let broken = tree.edit(numAt + 2, numAt + 2, "\n")
			assert broken.root().dump() == parse(broken.text()).root().dump()
			let _ = retAt
		}

		// Every character of a source deleted and typed back, and a space typed
		// and deleted at every offset: the incremental tree after each step is
		// the full parse of the same text, its diagnostics too. Covers an edit
		// that leaves no trivia between two tokens (`comp` + `onent` lex as
		// one), a body reparsed in the grammar of what holds it (a
		// component's `type { }`), and a `view` declaration's block reparsed
		// as a view.
		@test()
		def TestEveryEditMatchesAFullParse() {
			let source = "module m \{\n\tuse std.testing\n\n\tcomponent Card \{\n\t\ttype \{\n\t\t\ttitle string = \"a\" // note\n\t\t\}\n\t\tview \{\n\t\t\tText(title)\n\t\t\}\n\t\}\n\n\tdef f(a int, b int) int \{\n\t\tlet x = a + b * 2\n\t\treturn x when x >= 1\n\t\}\n\}\n"
			let base = clean(source)
			let differs = def (tree SyntaxTree) bool {
				let fresh = parse(tree.text())
				return tree.root().dump() != fresh.root().dump() || diagnosticsText(tree) != diagnosticsText(fresh)
			}
			let mismatches = 0
			for let i = 0; i < source.len(); i++ {
				let gone = base.edit(i, i + 1, "")
				mismatches++ when differs(gone)
				mismatches++ when differs(gone.edit(i, i, source[i:i + 1]))
				let spaced = base.edit(i, i, " ")
				mismatches++ when differs(spaced)
				mismatches++ when differs(spaced.edit(i, i + 1, ""))
			}
			assert mismatches == 0
			// The three shapes by name: the only space of `component Card`
			// deleted, the `t` of a component's `type` retyped, a space in a
			// view's `Text`.
			let compAt = source.indexOf("component")
			let joined = base.edit(compAt + 9, compAt + 10, "")
			assert joined.text().contains("componentCard") && !differs(joined)
			let typeAt = source.indexOf("type")
			let retyped = base.edit(typeAt, typeAt + 1, "").edit(typeAt, typeAt, "t")
			assert retyped.text() == source && retyped.diagnostics().len() == 0 && !differs(retyped)
			let textAt = source.indexOf("Text(")
			assert !differs(base.edit(textAt + 1, textAt + 1, " "))
		}

		@test()
		def TestIncrementalEdit() {
			let source = "module m \{\n\tdef a() int \{\n\t\treturn 1\n\t\}\n\n\tdef b() int \{\n\t\treturn 2\n\t\}\n\}\n"
			let tree = clean(source)
			let before = tree.root()
			let fnA = firstOf(tree, SyntaxKind.FuncDecl)
			let fnB = present(fnA.nextSibling())
			assert fnB.kind() == SyntaxKind.FuncDecl
			// Change the body of b: a keeps its text and place, b gets the new text.
			let at = source.indexOf("return 2")
			let edited = tree.edit(at + 7, at + 8, "22 + x")
			assert edited.text() == source.replace("return 2", "return 22 + x")
			assert edited.root().fullText() == edited.text()
			assert edited.diagnostics().len() == 0
			let afterA = firstOf(edited, SyntaxKind.FuncDecl)
			let afterB = present(afterA.nextSibling())
			assert afterA.text() == fnA.text() && afterA.start() == fnA.start() && !afterA.same(fnA)
			assert afterB.text() != fnB.text() && !afterB.same(fnB)
			assert !edited.root().same(before)
			assert present(afterB.lastToken()).end() == edited.text().len() - 3
			let full = parse(edited.text())
			assert full.root().dump() == edited.root().dump()
			// An edit that opens a brace cannot stay in its block: the whole
			// text is parsed again, and still spells itself.
			let unbalanced = edited.edit(at + 7, at + 7, "\{ ")
			assert unbalanced.text() == edited.text().replace("return 22", "return \{ 22")
			assert unbalanced.root().fullText() == unbalanced.text()
			assert unbalanced.diagnostics().len() > 0
			assert unbalanced.root().dump() == parse(unbalanced.text()).root().dump()
			// An edit outside every block parses the whole text again.
			let renamed = tree.edit(7, 8, "renamed")
			assert renamed.text().startsWith("module renamed")
			assert renamed.diagnostics().len() == 0
			assert renamed.root().dump() == parse(renamed.text()).root().dump()
			// A clause block keeps its role: a statement inserted into a
			// `switch` body is refused the same way by both parses.
			let clauses = clean("module m \{\n\tdef f(n int) int \{\n\t\tswitch n \{\n\t\tcase 1:\n\t\t\treturn 1\n\t\tdefault:\n\t\t\treturn 0\n\t\t\}\n\t\}\n\}\n")
			let caseAt = clauses.text().indexOf("case 1")
			let inClauses = clauses.edit(caseAt, caseAt, "x = 1\n")
			assert inClauses.root().dump() == parse(inClauses.text()).root().dump()
			assert inClauses.diagnostics().len() == parse(inClauses.text()).diagnostics().len()
			let inCase = clauses.edit(caseAt + 8, caseAt + 8, "x = 1\n")
			assert inCase.diagnostics().len() == 0
			assert inCase.root().dump() == parse(inCase.text()).root().dump()
			// An insertion at each edge of the text.
			let headed = tree.edit(0, 0, "// head\n")
			assert headed.text().startsWith("// head\nmodule m")
			let tailed = tree.edit(source.len(), source.len(), "// tail")
			assert tailed.text().endsWith("\}\n// tail") && tailed.diagnostics().len() == 0
		}

		@test()
		def TestCompositeBodies() {
			let tree = clean("module m \{\n\ttype Point<T> \{\n\t\tBase\n\t\tinternal x, y T\n\t\tweak owner ?Node\n\t\tcount int = 0, 1\n\t\twidth int \{\n\t\t\tinternal stored int\n\t\t\tdef get() int \{ return stored \}\n\t\t\tdef set(v int) \{ stored = v \}\n\t\t\}\n\t\tdef new(x T) \{ self.x = x \}\n\t\tinfix def +(o Point<T>) Point<T> \{ return self \}\n\t\twhere T is Point \{\n\t\t\tdef len() int \{ return 0 \}\n\t\t\}\n\t\}\n\n\tstruct Pair \{ a, b int \}\n\n\tenum Kind \{ Open = \"open\", Close \}\n\n\tunion Shape \{ Circle float, Dot \}\n\n\tinterface Reader \{\n\t\tio.Closer\n\t\tdef read(buf byte[]) !int\n\t\tasync fetch(url string) !string\n\t\}\n\n\tdatatype Pet \{\n\t\tname string\n\t\tage int = 1\n\t\}\n\n\tservice Clock \{\n\t\tdescription = \"time\"\n\t\tpermissions Permission[]\n\t\t@query()\n\t\tdef now() int \{ return 0 \}\n\t\}\n\n\tcomponent Button \{\n\t\tuse std.ui\n\t\tview \{\n\t\t\tText(label) \{ Icon(name) \}\n\t\t\}\n\t\tstyle ButtonStyle\n\t\ttype \{\n\t\t\tlabel string\n\t\t\}\n\t\}\n\n\tview Header \{\n\t\tText(title)\n\t\}\n\n\tstyle Dark \{\n\t\tbackground = theme.palette.surface\n\t\}\n\n\ttype Speed = Length / Time ** 2\n\t@dimension(unit = \"m\") type Length\n\}\n")
			assert countOf(tree, SyntaxKind.TypeDecl) == 4 && countOf(tree, SyntaxKind.Embedding) == 2
			assert countOf(tree, SyntaxKind.Field) == 10 && countOf(tree, SyntaxKind.Property) == 1
			assert countOf(tree, SyntaxKind.FuncDecl) == 8
			assert countOf(tree, SyntaxKind.Where) == 1
			assert countOf(tree, SyntaxKind.StructDecl) == 1 && countOf(tree, SyntaxKind.EnumDecl) == 1 && countOf(tree, SyntaxKind.EnumMember) == 2
			assert countOf(tree, SyntaxKind.UnionDecl) == 1 && countOf(tree, SyntaxKind.UnionMember) == 2
			assert countOf(tree, SyntaxKind.InterfaceDecl) == 1 && countOf(tree, SyntaxKind.DatatypeDecl) == 1
			assert countOf(tree, SyntaxKind.ServiceDecl) == 1 && countOf(tree, SyntaxKind.Attribute) == 2
			assert countOf(tree, SyntaxKind.ComponentDecl) == 1 && countOf(tree, SyntaxKind.ViewDecl) == 2 && countOf(tree, SyntaxKind.StyleDecl) == 2
			assert countOf(tree, SyntaxKind.ComponentCall) == 1
			assert countOf(tree, SyntaxKind.DimensionType) == 1
			assert countOf(tree, SyntaxKind.RawBlock) == 0
			let exported = clean("library acme.imaging \{\n\tuse acme.imaging.codecs\n\texport (\n\t\tacme.imaging.codecs::(Decoder)\n\t\tacme.imaging.core\n\t)\n\}\n")
			assert countOf(exported, SyntaxKind.Library) == 1 && countOf(exported, SyntaxKind.Export) == 1 && countOf(exported, SyntaxKind.UseItem) == 3
			let at = tree.position(tree.text().indexOf("struct Pair"))
			assert at.line == 19 && at.column == 2
			assert tree.position(0).line == 1 && tree.position(0).column == 1
		}

		// Forms the compiler's parser accepts, each parsed the same here.
		@test()
		def TestCallStyleArgument() {
			let tree = clean("module m \{\n\tcomponent C \{\n\t\tview \{\n\t\t\tButton(\"Save\", style = \{background: accent, on: \{hover: \{opacity: 0.8\}\}\})\n\t\t\trule(kind<Button>().hover(), style = \{opacity: 0.5\})\n\t\t\tRow(gap = 8(px), style = \{align: 1\}) \{\n\t\t\t\tText(\"x\")\n\t\t\t\}\n\t\t\}\n\t\}\n\}\n")
			assert countOf(tree, SyntaxKind.Arg) == 7
			let named = 0
			for let (_, n) in tree.root().descendants() {
				continue unless n.kind() == SyntaxKind.Arg
				named++ when present(n.firstToken()).text() == "style"
			}
			assert named == 3
		}

		@test()
		def TestArraySuffixAfterNestedTypeArgs() {
			let tree = clean("module m \{\n\ttype T \{\n\t\tkept map<string, Box<int>>[]\n\t\tdef f() \{\n\t\t\tlet x map<string, map<string, int>>[] = []\n\t\t\}\n\t\}\n\}\n")
			// The `[]` belongs to the outer type, not to the inner list the `>>` closed.
			assert countOf(tree, SyntaxKind.ArrayType) == 2
			assert firstOf(tree, SyntaxKind.ArrayType).text() == "map<string, Box<int>>[]"
		}

		@test()
		def TestLoopHeaderMultiAssign() {
			let tree = clean("module m \{\n\tdef f() \{\n\t\tfor let i, j = 0, 0; i < 3; i, j = i + 1, j + 1 \{\n\t\t\}\n\t\}\n\}\n")
			assert countOf(tree, SyntaxKind.MultiAssign) == 1
			assert firstOf(tree, SyntaxKind.MultiAssign).text() == "i, j = i + 1, j + 1"
		}

		@test()
		def TestUnitModifierOrder() {
			assert countOf(clean("partial internal module a.b \{\n\tconst x = 1\n\}\n"), SyntaxKind.Module) == 1
			assert countOf(clean("partial internal std.data module a.b \{\n\}\n"), SyntaxKind.Module) == 1
		}

		@test()
		def TestUnitFields() {
			let tree = clean("application App \{\n\t@keep()\n\tatomic name pkg.Kind = \"x\"\n\tcount = 1\n\tp1, p2 int\n\tprop Type \{\n\t\tvalue Type\n\t\tdef get() Type \{\n\t\t\treturn value\n\t\t\}\n\t\}\n\}\n")
			assert countOf(tree, SyntaxKind.Field) == 4 && countOf(tree, SyntaxKind.Property) == 1
			assert countOf(tree, SyntaxKind.ExprStmt) == 0
			// A check suite's body holds statements, not fields.
			let suite = clean("module m \{\n\tcheck \"s\" \{\n\t\tcount = 1\n\t\}\n\}\n")
			assert countOf(suite, SyntaxKind.Field) == 0 && countOf(suite, SyntaxKind.ExprStmt) == 1
		}

		@test()
		def TestFieldModifierOrder() {
			let tree = clean("module m \{\n\ttype Node \{\n\t\tweak internal later ?Node\n\t\tatomic internal weak spread ?Node\n\t\tinternal atomic weak third ?Node\n\t\}\n\tstruct S \{\n\t\tweak internal a ?Node\n\t\}\n\}\n")
			assert countOf(tree, SyntaxKind.Field) == 4
		}

		@test()
		def TestFoldingRanges() {
			let tree = clean("module m \{\n\tdef a() int \{ return 1 \}\n\tdef b() int \{\n\t\treturn 2\n\t\}\n\}\n")
			let folds = tree.foldingRanges()
			assert folds.len() == 2
			assert folds[0].kind == SyntaxKind.Body && folds[0].start == 9 && folds[0].end == tree.text().len() - 1
			assert folds[1].kind == SyntaxKind.Block && tree.text()[folds[1].start:folds[1].end].startsWith("\{\n\t\treturn 2")
			// A `use ( ... )` group over several lines folds between its
			// parentheses; one on a line, or a bare `use`, does not.
			let uses = clean("module m \{\n\tuse (\n\t\tstd.io\n\t\tstd.os\n\t)\n\tuse (std.time)\n\tuse std.testing\n\}\n")
			let grouped = uses.foldingRanges()
			assert grouped.len() == 2 && grouped[1].kind == SyntaxKind.UseGroup
			assert uses.text()[grouped[1].start:grouped[1].end] == "(\n\t\tstd.io\n\t\tstd.os\n\t)"
		}

		@test()
		def TestRecovery() {
			let source = "module m \{\n\tdef f() \{\n\t\tlet x = (1 +\n\t\tlet y = 2\n\t\}\n\}\n"
			let tree = parse(source)
			assert tree.text() == source && tree.root().fullText() == source
			assert tree.diagnostics().len() > 0
			assert countOf(tree, SyntaxKind.LetDecl) >= 1
			let stray = parse("module m \{\n\tdef f() \{\n\t\t) ;\n\t\treturn 1\n\t\}\n\}\n")
			assert stray.root().fullText().endsWith("return 1\n\t\}\n\}\n")
			assert countOf(stray, SyntaxKind.Skipped) >= 1
			assert countOf(stray, SyntaxKind.Return) == 1
			let unterminated = parse("module m \{\n\tdef f() \{\n")
			assert unterminated.diagnostics().len() >= 2
			assert countOf(unterminated, SyntaxKind.FuncDecl) == 1
			let blank = parse("")
			assert blank.diagnostics().len() == 0 && blank.root().childCount() == 1
			// A bare `@` above a declaration being typed: the attribute is
			// empty and still the declaration's, whatever word the next line
			// starts with.
			let bare = parse("module m \{\n\t@\n\tdef f() \{\}\n\ttype T \{\n\t\t@\n\t\tcount int\n\t\}\n\}\n")
			assert countOf(bare, SyntaxKind.FuncDecl) == 1 && countOf(bare, SyntaxKind.Field) == 1
			assert countOf(bare, SyntaxKind.Name) == 0
			let attribute = firstOf(bare, SyntaxKind.Attribute)
			let target = attribute.parent
			assert !(target is none) && target.kind() == SyntaxKind.FuncDecl && attribute.text() == "@"
			assert messages(bare).contains("expected an annotation name")
		}
	}
}
