internal partial module std.adm.syntax.parsing {
	use (
		std.adm.lexer::(TokenKind, isKeyword)
		std.adm.syntax::*
	)

	partial type Parser {
		// parseType parses a type at the cursor: `async`, `?` and `!`
		// prefixes over a union of intersections of base types. False when
		// no type starts here.
		internal def parseType() bool {
			let m = mark()
			let prefixed = false
			for at(TokenKind.Async) || at(TokenKind.Question) || at(TokenKind.Not) {
				advance()
				prefixed = true
			}
			if !parseUnionType() {
				return false unless prefixed
				reportHere("expected a type")
				complete(SyntaxKind.ModifiedType, m)
				return true
			}
			complete(SyntaxKind.ModifiedType, m) when prefixed
			return true
		}

		internal def parseUnionType() bool {
			let m = mark()
			return false unless parseIntersectionType()
			let isUnion = false
			for at(TokenKind.BitOr) {
				advance()
				isUnion = true
				if !parseIntersectionType() {
					reportHere("union requires a type on the right-hand side")
					break
				}
			}
			complete(SyntaxKind.UnionType, m) when isUnion
			return true
		}

		internal def parseIntersectionType() bool {
			let m = mark()
			return false unless parseBaseType()
			let intersection = false
			for at(TokenKind.BitAnd) {
				advance()
				intersection = true
				if !parseBaseType() {
					reportHere("intersection requires a type on the right-hand side")
					break
				}
			}
			complete(SyntaxKind.IntersectionType, m) when intersection
			return true
		}

		// parseBaseType parses a tuple, function, inline struct or named
		// type, with any `[]` suffixes.
		internal def parseBaseType() bool {
			let m = mark()
			let ok = false
			if at(TokenKind.LParen) {
				ok = parseTupleType()
			} else if at(TokenKind.Def) {
				ok = parseFuncType()
			} else if at(TokenKind.Struct) && peek() == TokenKind.LBrace {
				ok = parseInlineStruct()
			} else {
				ok = parseNamedType()
			}
			return false unless ok
			for at(TokenKind.LBrack) && peek() == TokenKind.RBrack {
				advance()
				advance()
				complete(SyntaxKind.ArrayType, m)
			}
			return true
		}

		internal def parseTupleType() bool {
			let m = mark()
			expect(TokenKind.LParen)
			let count = 0
			for !at(TokenKind.RParen) && !atEnd() {
				if count > 0 {
					break unless take(TokenKind.Comma)
				}
				break unless parseType()
				count++
			}
			expect(TokenKind.RParen)
			complete(SyntaxKind.TupleType, m)
			return true
		}

		// parseNamedType parses a simple or qualified type name with its
		// type arguments.
		internal def parseNamedType() bool {
			let m = mark()
			return false unless atTypeNamePart()
			advance()
			let qualified = false
			for at(TokenKind.Dot) {
				advance()
				qualified = true
				if atTypeNamePart() {
					advance()
				} else {
					missing(TokenKind.Ident)
				}
			}
			complete(SyntaxKind.QualifiedName, m) when qualified
			parseTypeArgs() when at(TokenKind.Lt)
			complete(SyntaxKind.NamedType, m)
			return true
		}

		// atTypeNamePart is true when the cursor holds a name, `none` or a
		// keyword, which type-name positions accept (`component`, `view`).
		internal def atTypeNamePart() bool {
			let k = kind()
			return k == TokenKind.Ident || k == TokenKind.None || isKeyword(k)
		}

		// expectMemberName consumes the name after a `.`: a name, `none`
		// or a keyword (`new`, `view`).
		internal def expectMemberName() {
			if atTypeNamePart() {
				advance()
				return
			}
			missing(TokenKind.Ident)
		}

		// parseTypeArgs parses `<T, U>` into a TypeArgs node.
		internal def parseTypeArgs() {
			let m = mark()
			expect(TokenKind.Lt)
			for !atGenericClose() && !atEnd() {
				break unless parseTypeArg()
				// An inner `Box<int>>` closed this list too.
				break when atGenericClose()
				break unless take(TokenKind.Comma)
			}
			expectGenericClose()
			complete(SyntaxKind.TypeArgs, m)
		}

		// parseTypeArg parses one type argument: a type, or an integer (a
		// matrix dimension).
		internal def parseTypeArg() bool {
			if at(TokenKind.Integer) {
				let m = mark()
				advance()
				complete(SyntaxKind.Literal, m)
				return true
			}
			return parseType()
		}

		// parseFuncType parses `def (params) Return`; the return type sits
		// on the line of the `)`.
		internal def parseFuncType() bool {
			let m = mark()
			expect(TokenKind.Def)
			parseTypeParams() when at(TokenKind.Lt)
			parseFuncTypeParams()
			parseType() when canStartType() && !lineBreakBefore(pos)
			complete(SyntaxKind.FuncType, m)
			return true
		}

		internal def parseFuncTypeParams() {
			let m = mark()
			expect(TokenKind.LParen)
			let count = 0
			for !at(TokenKind.RParen) && !atEnd() {
				if count > 0 {
					if !take(TokenKind.Comma) {
						reportHere("expected `,` between parameters")
						break
					}
				}
				break unless parseFuncTypeParam()
				count++
			}
			expect(TokenKind.RParen)
			complete(SyntaxKind.Params, m)
		}

		// parseFuncTypeParam parses a parameter of a function type: `name
		// Type`, `a, b Type`, or a type alone, each with an optional `...`.
		internal def parseFuncTypeParam() bool {
			let m = mark()
			parseAttributes()
			if at(TokenKind.Ident) {
				let names = mark()
				advance()
				for at(TokenKind.Comma) && peek() == TokenKind.Ident {
					advance()
					advance()
				}
				let ellipsis = take(TokenKind.Ellipsis)
				if canStartType() && (ellipsis || !arraySuffixAhead()) {
					parseType()
					complete(SyntaxKind.Param, m)
					return true
				}
				reset(names)
			}
			let ellipsis = take(TokenKind.Ellipsis)
			if !canStartType() {
				if ellipsis {
					reportHere("variadic parameter requires a type")
					complete(SyntaxKind.Param, m)
					return true
				}
				reset(m)
				return false
			}
			parseType()
			complete(SyntaxKind.Param, m)
			return true
		}

		// arraySuffixAhead is true when the `[` at the cursor ends the type
		// before it (`byte[]`), not a parameter's type: empty pairs followed
		// by `,` or `)`.
		internal def arraySuffixAhead() bool {
			let i = pos
			for kindAt(i) == TokenKind.LBrack && kindAt(i + 1) == TokenKind.RBrack {
				i += 2
			}
			return false when i == pos || i >= limit
			let k = kindAt(i)
			return k == TokenKind.Comma || k == TokenKind.RParen
		}

		internal def parseInlineStruct() bool {
			let m = mark()
			expect(TokenKind.Struct)
			expect(TokenKind.LBrace)
			parseFieldsUntil(TokenKind.RBrace, false)
			expect(TokenKind.RBrace)
			complete(SyntaxKind.InlineStruct, m)
			return true
		}

		// parseTypeParams parses `<T, U: Bound = Default>`.
		internal def parseTypeParams() {
			let m = mark()
			expect(TokenKind.Lt)
			for !atGenericClose() && !atEnd() {
				break unless at(TokenKind.Ident)
				let pm = mark()
				advance()
				if take(TokenKind.Colon) {
					reportHere("expected a bound after `:`") unless parseType()
				}
				if take(TokenKind.Assign) {
					reportHere("expected a default type after `=`") unless parseType()
				}
				complete(SyntaxKind.TypeParam, pm)
				break when atGenericClose()
				break unless take(TokenKind.Comma)
			}
			expectGenericClose()
			complete(SyntaxKind.TypeParams, m)
		}

		// parseTypeReference parses `a.b.C<T>` in expression position, as
		// the type of a literal; false, consuming nothing, when the dots
		// do not join names.
		internal def parseTypeReference() bool {
			let m = mark()
			return false unless at(TokenKind.Ident)
			advance()
			let qualified = false
			for at(TokenKind.Dot) {
				if peek() != TokenKind.Ident {
					reset(m)
					return false
				}
				advance()
				advance()
				qualified = true
			}
			complete(SyntaxKind.QualifiedName, m) when qualified
			parseTypeArgs() when at(TokenKind.Lt)
			complete(SyntaxKind.NamedType, m)
			return true
		}
	}
}
