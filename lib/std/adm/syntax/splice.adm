// Edits of a tree's arrays: a block parsed again from its new text takes the
// place of the old one, and every offset and index after it moves.
internal partial module std.adm.syntax.layout {
	use (
		std.adm.syntax::(Diagnostic)
		std.simd
	)

	// spliced is `a[:from] + b[:count] + a[to:]`, a new array.
	def spliced<T>(a T[], from int, to int, b T[], count int) T[] {
		let out T[]
		out.len(from + count + a.len() - to)
		a[:from].copy(out)
		b[:count].copy(out[from:])
		a[to:].copy(out[from + count:])
		return out
	}

	// shift adds delta to the values of a from index `from` up to `to`.
	def shift(a int32[], from int, to int, delta int) {
		return when delta == 0
		let d = int32(delta)
		let step = simd.splat8<int32>(d)
		let i = from
		for i + 8 <= to {
			simd.store8<int32>(a, i, simd.load8<int32>(a, i) + step)
			i += 8
		}
		for i < to {
			a[i] = a[i] + d
			i++
		}
	}

	// shiftAtLeast adds delta to the values of a from index `from` up to `to`
	// that are at least `bound`.
	def shiftAtLeast(a int32[], from int, to int, bound int, delta int) {
		return when delta == 0
		let d = int32(delta)
		let b = int32(bound)
		let step = simd.splat8<int32>(d)
		let floor = simd.splat8<int32>(b)
		let i = from
		for i + 8 <= to {
			let v = simd.load8<int32>(a, i)
			simd.store8<int32>(a, i, v.ge(floor).blend(v + step, v))
			i += 8
		}
		for i < to {
			a[i] = a[i] + d when a[i] >= b
			i++
		}
	}

	// rebaseItems moves the items of a from index `from` up to `to`: a token
	// at index `tokenBound` or later by `tokenDelta`, a node at `nodeBound` or
	// later by `nodeDelta`, a missing token at `missingBound` or later by
	// `missingDelta`.
	def rebaseItems(a int32[], from int, to int, tokenBound int, tokenDelta int, nodeBound int, nodeDelta int, missingBound int, missingDelta int) {
		let tags = simd.splat8<int32>(int32(3))
		let tokenTags = simd.splat8<int32>(int32(tokenTag))
		let nodeTags = simd.splat8<int32>(int32(nodeTag))
		let missingTags = simd.splat8<int32>(int32(missingTag))
		let tokenFloor = simd.splat8<int32>(int32(item(tokenBound, tokenTag)))
		let nodeFloor = simd.splat8<int32>(int32(item(nodeBound, nodeTag)))
		let missingFloor = simd.splat8<int32>(int32(item(missingBound, missingTag)))
		let tokenStep = simd.splat8<int32>(int32(tokenDelta << 2))
		let nodeStep = simd.splat8<int32>(int32(nodeDelta << 2))
		let missingStep = simd.splat8<int32>(int32(missingDelta << 2))
		let i = from
		for i + 8 <= to {
			let v = simd.load8<int32>(a, i)
			let tag = v & tags
			let tokens = tag.eq(tokenTags) & v.ge(tokenFloor)
			let nodes = tag.eq(nodeTags) & v.ge(nodeFloor)
			let missing = tag.eq(missingTags) & v.ge(missingFloor)
			let moved = tokens.blend(v + tokenStep, v)
			moved = nodes.blend(moved + nodeStep, moved)
			moved = missing.blend(moved + missingStep, moved)
			simd.store8<int32>(a, i, moved)
			i += 8
		}
		for i < to {
			let it = int(a[i])
			let index = itemIndex(it)
			switch tagOf(it) {
				case tokenTag:
					a[i] = int32(item(index + tokenDelta, tokenTag)) when index >= tokenBound
				case nodeTag:
					a[i] = int32(item(index + nodeDelta, nodeTag)) when index >= nodeBound
				default:
					a[i] = int32(item(index + missingDelta, missingTag)) when index >= missingBound
			}
			i++
		}
	}

	// movedDiagnostics is `list[from:to]` with every offset at or after
	// `bound` moved by `delta`.
	def movedDiagnostics(list Diagnostic[], from int, to int, bound int, delta int) Diagnostic[] {
		let out Diagnostic[]
		out.cap(to - from)
		for let k = from; k < to; k++ {
			let d = list[k]
			let start = d.start >= bound ?? (d.start + delta, d.start)
			let end = d.end >= bound ?? (d.end + delta, d.end)
			out.push(Diagnostic{message: d.message, start: start, end: end})
		}
		return out
	}

	// spliceBlock is the token table and segment of `source`, this
	// segment's text with a block's new text in place: node `nb` of `seg`,
	// whose full span started at `base` and ended at `oldEnd`, `delta`
	// characters longer now, is replaced by the root of `fragSeg`, the
	// block's new text parsed over `frag` (offsets from the block's full
	// start, EOF last). `ancestors` are the indices of the block's
	// ancestors, innermost first. A segment of a tree with every body
	// parsed, so with no unparsed body.
	def spliceBlock(seg Segment, nb int, ancestors int[], frag Tokens, fragSeg Segment, source string, base int, oldEnd int, delta int) (Tokens, Segment) {
		let old = seg.tokens
		let ta = int(seg.firstToken[nb])
		let tb = int(seg.endToken[nb])
		// The fragment's EOF stands for the text after the block: the file's.
		let fcount = frag.count() - 1
		let tokenDelta = fcount - (tb - ta)
		let mid = ta + fcount

		let full = spliced(old.fullStarts, ta, tb, frag.fullStarts, fcount)
		let at = spliced(old.starts, ta, tb, frag.starts, fcount)
		let to = spliced(old.ends, ta, tb, frag.ends, fcount)
		shift(full, ta, mid, base)
		shift(at, ta, mid, base)
		shift(to, ta, mid, base)
		shift(full, mid, full.len(), delta)
		shift(at, mid, at.len(), delta)
		shift(to, mid, to.len(), delta)
		let tokenFlags = spliced(old.flags, ta, tb, frag.flags, fcount)
		// What separates the block from the token before it is outside the
		// edit; the fragment, which starts with the block, cannot tell.
		tokenFlags[ta] = old.flags[ta] when fcount > 0
		let tokens = new Tokens(source, spliced(old.kinds, ta, tb, frag.kinds, fcount), tokenFlags, full, at, to)

		let na = seg.firstNodeOf(nb)
		let fnodes = fragSeg.nodeCount()
		let nodeDelta = fnodes - (nb + 1 - na)
		let ia = int(seg.firstItem[na])
		let ib = nb + 1 < seg.nodeCount() ?? (int(seg.firstItem[nb + 1]), seg.items.len())
		let fitems = fragSeg.items.len()
		let itemDelta = fitems - (ib - ia)

		let out = new Segment(tokens, seg.number)
		out.kinds = spliced(seg.kinds, na, nb + 1, fragSeg.kinds, fnodes)
		out.flags = spliced(seg.flags, na, nb + 1, fragSeg.flags, fnodes)
		out.firstItem = spliced(seg.firstItem, na, nb + 1, fragSeg.firstItem, fnodes)
		shift(out.firstItem, na, na + fnodes, ia)
		shift(out.firstItem, na + fnodes, out.firstItem.len(), itemDelta)
		out.firstToken = spliced(seg.firstToken, na, nb + 1, fragSeg.firstToken, fnodes)
		shift(out.firstToken, na, na + fnodes, ta)
		shiftAtLeast(out.firstToken, na + fnodes, out.firstToken.len(), tb, tokenDelta)
		out.endToken = spliced(seg.endToken, na, nb + 1, fragSeg.endToken, fnodes)
		shift(out.endToken, na, na + fnodes, ta)
		shiftAtLeast(out.endToken, na + fnodes, out.endToken.len(), tb, tokenDelta)

		// The missing tokens of the block's subtree go and the fragment's
		// come after the others, which keep their order.
		let kept = spliceMissing(seg, out, ia, ib, tb, tokenDelta, fragSeg, ta)
		out.items = spliced(seg.items, ia, ib, fragSeg.items, fitems)
		rebaseItems(out.items, ia, ia + fitems, 0, ta, 0, na, 0, kept)
		rebaseItems(out.items, ia + fitems, out.items.len(), tb, tokenDelta, nb, nodeDelta, seg.missingKinds.len(), 0)
		renumberMissing(seg, out.items, ia, ib, out.items.len() - (ia + fitems), ia + fitems) when kept < seg.missingKinds.len()

		// Diagnostics are in node order: those before the subtree, the
		// fragment's, those after it.
		let d0 = 0
		for d0 < seg.diagnosticNodes.len() && int(seg.diagnosticNodes[d0]) < na {
			d0++
		}
		let d1 = d0
		for d1 < seg.diagnosticNodes.len() && int(seg.diagnosticNodes[d1]) <= nb {
			d1++
		}
		out.diagnostics = movedDiagnostics(seg.diagnostics, 0, d0, oldEnd, 0).concat(movedDiagnostics(fragSeg.diagnostics, 0, fragSeg.diagnostics.len(), 0, base)).concat(movedDiagnostics(seg.diagnostics, d1, seg.diagnostics.len(), oldEnd, delta))
		out.diagnosticNodes = spliced(seg.diagnosticNodes, d0, d1, fragSeg.diagnosticNodes, fragSeg.diagnosticNodes.len())
		let fd = fragSeg.diagnosticNodes.len()
		shift(out.diagnosticNodes, d0, d0 + fd, na)
		shift(out.diagnosticNodes, d0 + fd, out.diagnosticNodes.len(), nodeDelta)

		// What the ancestors hold below them changed: whether a diagnostic
		// does, and their first and last leaves.
		for let (_, a) in ancestors {
			out.refreshFlags(a + nodeDelta)
		}
		return (tokens, out)
	}

	// spliceMissing fills the missing tokens of `out`, the splice of `seg`
	// with `fragSeg` over the items from `ia` to `ib`: the old ones those
	// items do not hold, in order, a token they stand before moved by
	// `tokenDelta` when it is at `tb` or later, then the fragment's, moved
	// to the block's first token `ta`. How many old ones are kept.
	def spliceMissing(seg Segment, out Segment, ia int, ib int, tb int, tokenDelta int, fragSeg Segment, ta int) int {
		let dropped bool[]
		dropped.len(seg.missingKinds.len())
		for let k = ia; k < ib; k++ {
			let it = int(seg.items[k])
			dropped[itemIndex(it)] = true when tagOf(it) == missingTag
		}
		for let m = 0; m < seg.missingKinds.len(); m++ {
			continue when dropped[m]
			let before = int(seg.missingAt[m])
			out.missingKinds.push(seg.missingKinds[m])
			out.missingAt.push(int32(before >= tb ?? (before + tokenDelta, before)))
		}
		let kept = out.missingKinds.len()
		for let m = 0; m < fragSeg.missingKinds.len(); m++ {
			out.missingKinds.push(fragSeg.missingKinds[m])
			out.missingAt.push(int32(int(fragSeg.missingAt[m]) + ta))
		}
		return kept
	}

	// renumberMissing gives the old missing tokens that the items of `seg`
	// outside the block's hold (those before `ia`, and the `tail` items from
	// `ib`, now at `newTail` of `items`) their kept positions
	// (spliceMissing).
	def renumberMissing(seg Segment, items int32[], ia int, ib int, tail int, newTail int) {
		let numbers int[]
		numbers.len(seg.missingKinds.len())
		let dropped bool[]
		dropped.len(seg.missingKinds.len())
		for let k = ia; k < ib; k++ {
			let it = int(seg.items[k])
			dropped[itemIndex(it)] = true when tagOf(it) == missingTag
		}
		let next = 0
		for let m = 0; m < numbers.len(); m++ {
			numbers[m] = dropped[m] ?? (-1, next)
			next += 1 unless dropped[m]
		}
		let renumber = def (k int) {
			let it = int(items[k])
			items[k] = int32(item(numbers[itemIndex(it)], missingTag)) when tagOf(it) == missingTag
		}
		for let k = 0; k < ia; k++ {
			renumber(k)
		}
		for let k = newTail; k < newTail + tail; k++ {
			renumber(k)
		}
	}
}
