partial module std.adm.syntax {
	use (
		std.adm.lexer::(TokenKind)
		std.testing
	)

	// triviaTexts is the texts of a trivia list joined by `|`.
	internal def triviaTexts(trivia Trivia[]) string {
		let out string[]
		for let (_, t) in trivia {
			out.push(t.text)
		}
		return out.join("|")
	}

	check "Syntax tree" {
		@test()
		def TestTriviaAttachment() {
			let source = "let x = 1 // one\n\n  let y = 2\n"
			let tokens = greenTokens(source)
			// let x = 1 let y = 2 EOF
			assert tokens.len() == 9
			assert tokens[0].token == TokenKind.Let && tokens[0].leading.len() == 0
			assert triviaTexts(tokens[0].trailing) == " "
			assert tokens[3].text == "1"
			assert triviaTexts(tokens[3].trailing) == " |// one|\n"
			assert tokens[3].trailing[1].kind == TriviaKind.LineComment
			assert triviaTexts(tokens[4].leading) == "\n|  "
			assert tokens[4].leading[0].kind == TriviaKind.Newline
			assert tokens[4].leading[1].kind == TriviaKind.Whitespace
			assert triviaTexts(tokens[7].trailing) == "\n"
			assert tokens[8].token == TokenKind.EOF && tokens[8].leading.len() == 0
			let full = ""
			for let (_, t) in tokens {
				full += t.fullText()
			}
			assert full == source
		}

		@test()
		def TestRoundTrip() {
			let source = "/* head */\r\nmodule a \{\r\n\tdef f() \{ return \"x \{y\}\" \}\r\n\}\r\n\r\n// tail"
			let tokens = greenTokens(source)
			let full = ""
			for let (_, t) in tokens {
				full += t.fullText()
			}
			assert full == source
			assert tokens[0].leading[0].kind == TriviaKind.BlockComment
			assert tokens[0].leading[1].text == "\r\n"
			let eof = tokens[tokens.len() - 1]
			assert eof.token == TokenKind.EOF
			assert triviaTexts(eof.leading) == "\r\n|// tail"
			let node = new Green(SyntaxKind.File, tokens)
			assert node.width == source.len()
			assert node.fullText() == source
		}

		@test()
		def TestWidths() {
			let tokens = greenTokens("  a  \n b")
			assert tokens[0].width == 6 && tokens[0].leadingWidth() == 2 && tokens[0].trailingWidth() == 3
			assert tokens[0].isToken() && triviaWidth(tokens[0].leading) == 2
			let node = new Green(SyntaxKind.Block, tokens[:2].clone())
			assert node.width == 8
			assert node.leadingWidth() == 2 && node.trailingWidth() == 0
			let missing = missingToken(TokenKind.RParen)
			assert missing.missing && missing.width == 0 && missing.text == ""
			let troubled = missing.withErrors([Diagnostic{message: "expected )", start: 0, end: 0}])
			assert troubled.troubled && troubled.missing && !missing.troubled
			let parent = new Green(SyntaxKind.Paren, [tokens[0], troubled])
			assert parent.troubled
		}

		@test()
		def TestNavigation() {
			let source = "let x = 1\n"
			let tokens = greenTokens(source)
			let decl = new Green(SyntaxKind.LetDecl, tokens[:4].clone())
			let file = new Green(SyntaxKind.File, [decl, tokens[4]])
			let tree = new SyntaxTree(file, source)
			let root = tree.root()
			assert root.kind() == SyntaxKind.File && root.childCount() == 2
			assert !root.isToken() && !root.isMissing()
			assert root.fullStart() == 0 && root.fullEnd() == source.len()
			let let1 = present(root.child(0))
			assert let1.kind() == SyntaxKind.LetDecl
			assert let1.start() == 0 && let1.end() == 9 && let1.fullEnd() == 10
			assert let1.text() == "let x = 1" && let1.fullText() == source
			let kids = let1.children()
			assert kids.len() == 4
			assert kids[1].text() == "x" && kids[1].start() == 4 && kids[1].end() == 5 && kids[1].fullEnd() == 6
			let eq = present(kids[1].nextSibling())
			assert eq.token() == TokenKind.Assign && eq.start() == 6
			assert present(eq.prevSibling()).same(kids[1])
			assert kids[0].prevSibling() is none
			assert present(let1.firstToken()).text() == "let"
			assert present(let1.lastToken()).text() == "1"
			assert present(tree.find(5)).text() == "x"
			let one = present(tree.find(8))
			assert one.text() == "1"
			assert present(one.ancestor(SyntaxKind.LetDecl)).same(let1)
			assert one.ancestor(SyntaxKind.Block) is none
			assert tree.find(10) is none
			assert root.tokens().len() == 5
			assert root.descendants().len() == 6
			assert tree.diagnostics().len() == 0
			let dump = root.dump()
			assert dump.startsWith("File [0..10)\n  LetDecl [0..9)\n    Token.Let \"let\" [0..3)\n")
		}

		@test()
		def TestDiagnosticOffsets() {
			let source = "f(\n"
			let tokens = greenTokens(source)
			let close = missingToken(TokenKind.RParen).withErrors([Diagnostic{message: "expected `)`", start: 0, end: 0}])
			let call = new Green(SyntaxKind.Call, [tokens[0], tokens[1], close])
			let file = new Green(SyntaxKind.File, [call, tokens[2]])
			let tree = new SyntaxTree(file, source)
			let found = tree.diagnostics()
			assert found.len() == 1
			assert found[0].start == 3 && found[0].end == 3 && found[0].message == "expected `)`"
			let kids = present(tree.root().child(0)).children()
			assert kids[2].isMissing() && kids[2].start() == 3 && kids[2].end() == 3
		}
	}
}
