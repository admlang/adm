partial module std.adm.syntax {
	use (
		std.adm.lexer::(TokenKind)
		std.testing
	)

	// triviaTexts is the texts of a trivia list joined by `|`.
	internal def triviaTexts(trivia Trivia[]) string {
		let out string[]
		for let (_, t) in trivia {
			out.push(t.text)
		}
		return out.join("|")
	}

	// tokensOf is every token of the tree in order, walked with nextToken.
	internal def tokensOf(tree SyntaxTree) SyntaxNode[] {
		let out SyntaxNode[]
		let at = tree.root().firstToken()
		for {
			let t = at
			break when t is none
			out.push(t)
			at = t.nextToken()
		}
		return out
	}

	check "Syntax tree" {
		@test()
		def TestTriviaAttachment() {
			let source = "let x = 1 // one\n\n  let y = 2\n"
			let tokens = tokensOf(parse(source))
			// let x = 1 let y = 2 EOF
			assert tokens.len() == 9
			assert tokens[0].token() == TokenKind.Let && tokens[0].leadingTrivia().len() == 0
			assert triviaTexts(tokens[0].trailingTrivia()) == " "
			assert tokens[3].text() == "1"
			assert triviaTexts(tokens[3].trailingTrivia()) == " |// one|\n"
			assert tokens[3].trailingTrivia()[1].kind == TriviaKind.LineComment
			assert triviaTexts(tokens[4].leadingTrivia()) == "\n|  "
			assert tokens[4].leadingTrivia()[0].kind == TriviaKind.Newline
			assert tokens[4].leadingTrivia()[1].kind == TriviaKind.Whitespace
			assert triviaTexts(tokens[7].trailingTrivia()) == "\n"
			assert tokens[8].token() == TokenKind.EOF && tokens[8].leadingTrivia().len() == 0
			let full = ""
			for let (_, t) in tokens {
				full += t.fullText()
			}
			assert full == source
		}

		@test()
		def TestRoundTrip() {
			let source = "/* head */\r\nmodule a \{\r\n\tdef f() \{ return \"x \{y\}\" \}\r\n\}\r\n\r\n// tail"
			let tree = parse(source)
			let tokens = tokensOf(tree)
			let full = ""
			for let (_, t) in tokens {
				full += t.fullText()
			}
			assert full == source
			assert tokens[0].leadingTrivia()[0].kind == TriviaKind.BlockComment
			assert tokens[0].leadingTrivia()[1].text == "\r\n"
			let eof = tokens[tokens.len() - 1]
			assert eof.token() == TokenKind.EOF
			assert triviaTexts(eof.leadingTrivia()) == "\r\n|// tail"
			assert tree.root().fullEnd() == source.len() && tree.root().fullText() == source
		}

		@test()
		def TestPositions() {
			let tree = parse("  a  \n b")
			let a = present(tree.find(2))
			assert a.text() == "a" && a.fullStart() == 0 && a.start() == 2 && a.end() == 3 && a.fullEnd() == 6
			assert triviaTexts(a.leadingTrivia()) == "  " && triviaTexts(a.trailingTrivia()) == "  |\n"
			let root = tree.root()
			assert triviaTexts(root.leadingTrivia()) == "  " && root.start() == 2
		}

		@test()
		def TestNavigation() {
			let source = "module m \{\n\tlet x = 1\n\}\n"
			let tree = parse(source)
			let root = tree.root()
			assert root.kind() == SyntaxKind.File && !root.isToken() && !root.isMissing()
			assert root.fullStart() == 0 && root.fullEnd() == source.len()
			let x = present(tree.find(source.indexOf("x")))
			assert x.text() == "x" && x.token() == TokenKind.Ident
			let decl = present(x.ancestor(SyntaxKind.LetDecl))
			assert decl.text() == "let x = 1" && decl.start() == source.indexOf("let")
			let kids = decl.children()
			assert kids.len() == decl.childCount() && kids[0].text() == "let"
			assert present(kids[1].prevSibling()).same(kids[0]) && present(kids[0].nextSibling()).same(kids[1])
			assert kids[0].prevSibling() is none
			assert present(decl.firstToken()).text() == "let" && present(decl.lastToken()).text() == "1"
			assert decl.childKind(0) == SyntaxKind.Token && root.childKind(0) == SyntaxKind.Module
			// A token reached through the table finds its place when asked.
			let eq = present(x.nextToken())
			assert eq.token() == TokenKind.Assign && present(eq.prevToken()).same(x)
			assert present(eq.parent).same(present(x.parent)) && eq.index == x.index + 1
			assert tree.find(source.len()) is none
			assert root.tokens().len() == tokensOf(tree).len()
			assert tree.diagnostics().len() == 0
			assert root.dump().startsWith("File [0..")
		}

		@test()
		def TestIdentity() {
			let tree = parse("module m \{ def f() \{ \} \}")
			let a = present(tree.find(tree.text().indexOf("f(")))
			let b = present(tree.find(tree.text().indexOf("f(")))
			assert a.same(b) && a.id() == b.id() && a.equals(b) && a.hash() == b.hash()
			assert !a.same(present(a.nextToken()))
			let seen map<SyntaxNode, int>
			seen[a] = 1
			assert seen.hasKey(b) && seen[b] == 1
			// Another tree, even of the same text, has none of these nodes.
			let again = parse(tree.text())
			assert !again.root().same(tree.root())
		}

		@test()
		def TestDiagnosticOffsets() {
			let source = "module m \{ def g() \{ f(\n\} \}"
			let tree = parse(source)
			let found = tree.diagnostics()
			assert found.len() > 0
			let close = source.indexOf("\}")
			assert found[0].message == "expected `)`, found `\}`" && found[0].start == close && found[0].end == close
		}

		@test()
		def TestOutlineReadsLikeTheFullTree() {
			let source = "module m \{\n\tdef f(a int) int \{\n\t\tlet b = a + 1\n\t\treturn b\n\t\}\n\n\tdef g() \{ f( \}\n\}\n"
			let full = parse(source)
			let outline = parse(source, bodies = false)
			assert outline.root().dump() == full.root().dump()
			assert outline.diagnostics().len() == full.diagnostics().len()
			// A body is read only when something looks inside it.
			let fresh = parse(source, bodies = false)
			let body = present(fresh.find(source.indexOf("let b")))
			assert body.text() == "let" && present(body.ancestor(SyntaxKind.FuncDecl)).childKind(0) == SyntaxKind.Token
			// An outline's edit is an outline of the new text.
			let edited = outline.edit(source.indexOf("+ 1"), source.indexOf("+ 1") + 3, "* 2")
			assert edited.root().dump() == parse(edited.text()).root().dump()
		}
	}
}
