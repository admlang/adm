partial module std.adm.syntax {
	use std.adm.lexer

	// greenTokens is every token of the source as a green token carrying its
	// trivia, EOF last. A token's text is the source text of its span (an
	// identifier as written, a unit with its parentheses), not the lexer's
	// spelling of it. What follows a token up to and including the first
	// line break is its trailing trivia, the rest the next token's leading
	// trivia; the EOF token holds what ends the file. Concatenating the
	// tokens' full text gives the source back.
	def greenTokens(source string) Green[] {
		let out Green[]
		let pending Trivia[]
		let previous ?lexer.Token = none
		let previousLeading Trivia[]
		for let (_, tok) in lexer.tokenize(source, comments = true, whitespace = true) {
			switch tok.kind {
				case lexer.TokenKind.Whitespace:
					pending.push(Trivia{kind: TriviaKind.Whitespace, text: tok.text})
					continue
				case lexer.TokenKind.Newline:
					pending.push(Trivia{kind: TriviaKind.Newline, text: tok.text})
					continue
				case lexer.TokenKind.Comment:
					let kind = tok.text.startsWith("//") ?? (TriviaKind.LineComment, TriviaKind.BlockComment)
					pending.push(Trivia{kind: kind, text: tok.text})
					continue
				default:
			}
			if previous is none {
				previousLeading = pending
			} else {
				// Most tokens take all the pending trivia (a space, a line
				// break) or none: those cases hand the array over uncopied.
				let split = trailingSplit(pending)
				if split == pending.len() {
					out.push(new Green(previous.kind, tokenText(source, previous), previousLeading, pending))
					previousLeading = noTrivia
				} else if split == 0 {
					out.push(new Green(previous.kind, tokenText(source, previous), previousLeading, noTrivia))
					previousLeading = pending
				} else {
					out.push(new Green(previous.kind, tokenText(source, previous), previousLeading, pending[:split].clone()))
					previousLeading = pending[split:].clone()
				}
			}
			pending = []
			previous = tok
		}
		// The last token is EOF, holding what ends the file.
		out.push(new Green(lexer.TokenKind.EOF, "", previousLeading, noTrivia)) unless previous is none
		return out
	}

	// noTrivia is the trivia list of every token that has none on that side;
	// shared, and never added to.
	internal let noTrivia Trivia[]

	// tokenText is the source text of a token's span: the lexer's own text
	// for every token but a unit (its text leaves the parentheses out) and
	// a non-ASCII identifier (its text is in NFC).
	internal def tokenText(source string, tok lexer.Token) string {
		return source[tok.start:tok.end] when tok.kind == lexer.TokenKind.Unit
		return source[tok.start:tok.end] when tok.kind == lexer.TokenKind.Ident && !tok.text.isASCII()
		return tok.text
	}

	// trailingSplit is how many of the pending trivia belong to the token
	// before them: up to and including the first line break, all of them
	// when there is none.
	internal def trailingSplit(pending Trivia[]) int {
		for let (i, t) in pending {
			return i + 1 when t.kind == TriviaKind.Newline
		}
		return pending.len()
	}
}
