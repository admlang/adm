partial module std.adm.syntax {
	use (
		std.adm.lexer::(TokenKind)
		std.adm.syntax.layout::*
		std.adm.syntax.parsing::(parseBody)
	)

	// Trivia is a run of text between tokens: white space, a line break or
	// a comment.
	struct Trivia {
		kind TriviaKind
		text string
	}

	// Diagnostic is what the parser found wrong, at character offsets into
	// the tree's text (`end` exclusive).
	struct Diagnostic {
		message string
		start   int
		end     int
	}

	// SyntaxTree is the parsed form of a source text: every token of it and
	// the nodes over them. Positions are character offsets into that text. A
	// tree never changes: an edit gives a new tree.
	//
	// The tree of `parse(source, bodies = false)` leaves each function body
	// unparsed until something reads inside it, so it is read from one task
	// at a time. A tree with every body parsed can be shared.
	partial type SyntaxTree {
		internal source string
		internal tokens Tokens
		internal main   Segment
		// The segment of each unparsed body of `main`, by slot, `noBody`
		// until it is read.
		internal bodies Segment[]

		def new(source string, tokens Tokens, main Segment) {
			self.source = source
			self.tokens = tokens
			self.main = main
			let unparsedCount = main.unparsedNodes.len()
			if unparsedCount > 0 {
				bodies.len(unparsedCount)
				bodies.fill(noBody, 0, unparsedCount)
			}
		}

		// root is the file node.
		def root() SyntaxNode {
			return new SyntaxNode(self, main, item(main.root(), nodeTag), none, 0)
		}

		// text is the source the tree spells, trivia included.
		def text() string {
			return source
		}

		// diagnostics is every parse diagnostic, at absolute offsets, a node's
		// before those below it, in source order. Every body is parsed first.
		def diagnostics() Diagnostic[] {
			let out Diagnostic[]
			collectDiagnostics(main, main.root(), out)
			return out
		}

		internal def collectDiagnostics(seg Segment, n int, into Diagnostic[]) {
			return unless seg.has(n, troubled)
			let slot = seg.unparsedSlot(n)
			if slot >= 0 {
				let body = bodyOf(self, slot)
				collectDiagnostics(body, body.root(), into)
				return
			}
			let (from, to) = seg.diagnosticsOf(n)
			for let k = from; k < to; k++ {
				into.push(seg.diagnostics[k])
			}
			let (first, end) = seg.itemsOf(n)
			for let k = first; k < end; k++ {
				let it = seg.itemAt(k)
				collectDiagnostics(seg, itemIndex(it), into) when tagOf(it) == nodeTag
			}
		}

		// find is the token at `offset`, none when the offset is past the end.
		def find(offset int) ?SyntaxNode {
			return root().find(offset)
		}

		// position is the 1-based line and column of a character offset,
		// counting a `\r\n` as one line break; an offset past the end is
		// the end's position.
		def position(offset int) Position {
			let line = 1
			let column = 1
			let n = source.len()
			offset = n when offset > n
			for let i = 0; i < offset; i++ {
				let c = source[i]
				if c == '\n' || (c == '\r' && (i + 1 >= n || source[i + 1] != '\n')) {
					line++
					column = 1
				} else if c != '\r' {
					column++
				}
			}
			return Position{line: line, column: column}
		}
	}

	// bodyOf is the segment of the tree's unparsed body in `slot`, parsed
	// the first time it is asked for.
	internal def bodyOf(tree SyntaxTree, slot int) Segment {
		let known = tree.bodies[slot]
		return known unless known == noBody
		let main = tree.main
		let n = int(main.unparsedNodes[slot])
		let parsed = parseBody(tree.tokens, int(main.firstToken[n]), int(main.endToken[n]), main.unparsedInView[slot], SyntaxKind(main.unparsedUnits[slot]), slot + 1)
		tree.bodies[slot] = parsed
		return parsed
	}

	// contentOf is where the children of node `n` of `seg` are: the node
	// itself, or for an unparsed body the root of its segment.
	internal def contentOf(tree SyntaxTree, seg Segment, n int) (Segment, int) {
		let slot = seg.unparsedSlot(n)
		return (seg, n) when slot < 0
		let body = bodyOf(tree, slot)
		return (body, body.root())
	}

	// tokenNode is table token `i` of the tree as a node; its parent is
	// found when asked for.
	internal def tokenNode(tree SyntaxTree, i int) SyntaxNode {
		return new SyntaxNode(tree, tree.main, item(i, tokenTag), none, -1)
	}

	// pathTo is the node of the tree holding table token `i` as a child,
	// and the token's index among its children: a walk down from the root.
	internal def pathTo(tree SyntaxTree, i int) (SyntaxNode, int) {
		let at = tree.root()
		for {
			let (seg, n) = contentOf(tree, at.seg, itemIndex(at.item))
			let (first, end) = seg.itemsOf(n)
			// The last child that starts at or before the token: a child
			// before it ends at or before it.
			let lo = first
			let hi = end - 1
			for lo < hi {
				let mid = (lo + hi + 1) / 2
				if seg.firstTokenOf(seg.itemAt(mid)) <= i {
					lo = mid
				} else {
					hi = mid - 1
				}
			}
			let it = seg.itemAt(lo)
			return (at, lo - first) when it == item(i, tokenTag)
			at = new SyntaxNode(tree, seg, it, at, lo - first)
		}
	}

	// noBody stands in a tree's slot for a body not parsed yet; shared, and
	// never added to.
	internal let noBody = new Segment(new Tokens(""), -1)

	// Position is a place in the source as an editor shows it: 1-based line
	// and column, in characters.
	struct Position {
		line   int
		column int
	}

	// SyntaxNode is an element of a tree, a token (missing ones included) or
	// a node, with its place: made on demand by navigation, never stored by
	// the tree. Two nodes are the same node when `same` says so.
	type SyntaxNode {
		internal tree  SyntaxTree
		internal seg   Segment
		internal item  int
		internal known ?SyntaxNode
		// Which child of `known` the element is; -1 while neither is known
		// (a token reached by nextToken).
		internal place int

		def new(tree SyntaxTree, seg Segment, item int, parent ?SyntaxNode, place int) {
			self.tree = tree
			self.seg = seg
			self.item = item
			self.known = parent
			self.place = place
		}

		// parent is the node this element is a child of, none for the root.
		parent ?SyntaxNode {
			def get() ?SyntaxNode {
				return known unless place < 0
				let (holder, at) = pathTo(tree, itemIndex(item))
				known = holder
				place = at
				return holder
			}
		}

		// offset is where the element starts, leading trivia included.
		offset int {
			def get() int {
				return fullStart()
			}
		}

		// index is which child of the parent the element is.
		index int {
			def get() int {
				return place unless place < 0
				let (holder, at) = pathTo(tree, itemIndex(item))
				known = holder
				place = at
				return at
			}
		}

		// kind is the element's kind, Token for a token.
		def kind() SyntaxKind {
			return SyntaxKind.Token unless tagOf(item) == nodeTag
			return seg.kind(itemIndex(item))
		}

		// token is the token kind of a token element, EOF for a node.
		def token() TokenKind {
			switch tagOf(item) {
				case tokenTag:
					return tree.tokens.kind(itemIndex(item))
				case missingTag:
					return seg.missingKind(itemIndex(item))
				default:
					return TokenKind.EOF
			}
		}

		// isToken is true for a token, missing ones included.
		def isToken() bool {
			return tagOf(item) != nodeTag
		}

		// isMissing is true for a token the parser expected and did not find.
		def isMissing() bool {
			return tagOf(item) == missingTag
		}

		// same is true when the other node is this node: the same element of
		// the same tree. An edit makes a new tree, none of whose nodes is the
		// same as one of the old tree.
		def same(other SyntaxNode) bool {
			return tree == other.tree && id() == other.id()
		}

		// id is a number naming the element within its tree: two nodes of one
		// tree are the same node when their ids are equal. Ids of different
		// trees mean nothing to each other.
		def id() int {
			return item when tagOf(item) == tokenTag
			return seg.number << 32 | item
		}

		// hash and equals make a node a map key: two keys are equal when they
		// are the same node (`same`).
		def hash() uint64 {
			return new KeyHasher().add(id()).sum()
		}

		// equals is `same`, for a node used as a map key.
		def equals(other SyntaxNode) bool {
			return same(other)
		}

		// fullStart is where the element starts, leading trivia included.
		def fullStart() int {
			return seg.fullStartOf(item)
		}

		// fullEnd is where the element ends, trailing trivia included.
		def fullEnd() int {
			return seg.fullEndOf(item)
		}

		// start is where the element's own text starts.
		def start() int {
			let i = itemIndex(item)
			switch tagOf(item) {
				case tokenTag:
					return tree.tokens.start(i)
				case missingTag:
					return fullStart()
				default:
					return fullStart() when seg.has(i, bareStart)
					return tree.tokens.start(int(seg.firstToken[i]))
			}
		}

		// end is where the element's own text ends (exclusive).
		def end() int {
			let i = itemIndex(item)
			switch tagOf(item) {
				case tokenTag:
					return tree.tokens.end(i)
				case missingTag:
					return fullStart()
				default:
					return fullEnd() when seg.has(i, bareEnd)
					return tree.tokens.end(int(seg.endToken[i]) - 1)
			}
		}

		// text is the element's own text, without the trivia around it.
		def text() string {
			return tree.tokens.text(itemIndex(item)) when tagOf(item) == tokenTag
			return tree.source[start():end()]
		}

		// fullText is the element's text with its trivia.
		def fullText() string {
			return tree.source[fullStart():fullEnd()]
		}

		// leadingTrivia is the trivia before the element's text: a token's
		// own, a node's first token's; none for a missing token.
		def leadingTrivia() Trivia[] {
			let i = itemIndex(item)
			switch tagOf(item) {
				case tokenTag:
					return tree.tokens.leading(i)
				case missingTag:
					return noTrivia
				default:
					return noTrivia when seg.has(i, bareStart)
					return tree.tokens.leading(int(seg.firstToken[i]))
			}
		}

		// trailingTrivia is the trivia after the element's text: a token's
		// own, a node's last token's; none for a missing token.
		def trailingTrivia() Trivia[] {
			let i = itemIndex(item)
			switch tagOf(item) {
				case tokenTag:
					return tree.tokens.trailing(i)
				case missingTag:
					return noTrivia
				default:
					return noTrivia when seg.has(i, bareEnd)
					return tree.tokens.trailing(int(seg.endToken[i]) - 1)
			}
		}

		// childCount is the number of children, 0 for a token.
		def childCount() int {
			return 0 unless tagOf(item) == nodeTag
			let (s, n) = contentOf(tree, seg, itemIndex(item))
			let (first, end) = s.itemsOf(n)
			return end - first
		}

		// child is the i-th child, none past the last.
		def child(i int) ?SyntaxNode {
			return none when i < 0 || tagOf(item) != nodeTag
			let (s, n) = contentOf(tree, seg, itemIndex(item))
			let (first, end) = s.itemsOf(n)
			return none when first + i >= end
			return new SyntaxNode(tree, s, s.itemAt(first + i), self, i)
		}

		// childKind is the kind of the i-th child, Token for a token, read
		// without making the child: a scan over many children (a table's
		// elements) makes a node only for those it keeps. Token past the
		// last child.
		def childKind(i int) SyntaxKind {
			return SyntaxKind.Token when i < 0 || tagOf(item) != nodeTag
			let (s, n) = contentOf(tree, seg, itemIndex(item))
			let (first, end) = s.itemsOf(n)
			return SyntaxKind.Token when first + i >= end
			let it = s.itemAt(first + i)
			return SyntaxKind.Token unless tagOf(it) == nodeTag
			return s.kind(itemIndex(it))
		}

		// children is every child in source order, empty for a token.
		def children() SyntaxNode[] {
			let out SyntaxNode[]
			return out unless tagOf(item) == nodeTag
			let (s, n) = contentOf(tree, seg, itemIndex(item))
			let (first, end) = s.itemsOf(n)
			out.cap(end - first)
			for let k = first; k < end; k++ {
				out.push(new SyntaxNode(tree, s, s.itemAt(k), self, k - first))
			}
			return out
		}

		// nextSibling is the next child of the parent, none for the last.
		def nextSibling() ?SyntaxNode {
			let p = parent
			return none when p is none
			return p.child(index + 1)
		}

		// prevSibling is the previous child of the parent, none for the first.
		def prevSibling() ?SyntaxNode {
			let p = parent
			return none when p is none
			return p.child(index - 1)
		}

		// firstToken is the first token below the element, itself for a
		// token; none for a node without tokens.
		def firstToken() ?SyntaxNode {
			return self when tagOf(item) != nodeTag
			let (s, n) = contentOf(tree, seg, itemIndex(item))
			let (first, end) = s.itemsOf(n)
			for let k = first; k < end; k++ {
				let t = new SyntaxNode(tree, s, s.itemAt(k), self, k - first).firstToken()
				return t unless t is none
			}
			return none
		}

		// lastToken is the last token below the element, itself for a token;
		// none for a node without tokens.
		def lastToken() ?SyntaxNode {
			return self when tagOf(item) != nodeTag
			let (s, n) = contentOf(tree, seg, itemIndex(item))
			let (first, end) = s.itemsOf(n)
			for let k = end - 1; k >= first; k-- {
				let t = new SyntaxNode(tree, s, s.itemAt(k), self, k - first).lastToken()
				return t unless t is none
			}
			return none
		}

		// nextToken is the token after the element in the text, none after
		// the last; missing tokens are left out. One step through the token
		// table, for walking a whole text token by token.
		def nextToken() ?SyntaxNode {
			let i = itemIndex(item)
			let next = 0
			switch tagOf(item) {
				case tokenTag:
					next = i + 1
				case missingTag:
					next = int(seg.missingAt[i])
				default:
					next = int(seg.endToken[i])
			}
			return none when next >= tree.tokens.count()
			return tokenNode(tree, next)
		}

		// prevToken is the token before the element in the text, none before
		// the first; missing tokens are left out.
		def prevToken() ?SyntaxNode {
			let i = itemIndex(item)
			let prev = 0
			switch tagOf(item) {
				case tokenTag:
					prev = i - 1
				case missingTag:
					prev = int(seg.missingAt[i]) - 1
				default:
					prev = int(seg.firstToken[i]) - 1
			}
			return none when prev < 0
			return tokenNode(tree, prev)
		}

		// tokens is every token below the element in source order.
		def tokens() SyntaxNode[] {
			let out SyntaxNode[]
			collectTokens(out)
			return out
		}

		internal def collectTokens(into SyntaxNode[]) {
			if tagOf(item) != nodeTag {
				into.push(self)
				return
			}
			for let (_, c) in children() {
				c.collectTokens(into)
			}
		}

		// descendants is every element below this one, parents before
		// children, in source order; the element itself is not included.
		def descendants() SyntaxNode[] {
			let out SyntaxNode[]
			collectDescendants(out)
			return out
		}

		internal def collectDescendants(into SyntaxNode[]) {
			for let (_, c) in children() {
				into.push(c)
				c.collectDescendants(into)
			}
		}

		// find is the token whose full span holds `offset`, none when the
		// offset is outside the element.
		def find(offset int) ?SyntaxNode {
			return none when offset < fullStart() || offset >= fullEnd()
			let at = self
			for tagOf(at.item) == nodeTag {
				let (s, n) = contentOf(tree, at.seg, itemIndex(at.item))
				let (first, end) = s.itemsOf(n)
				return none when first == end
				// The last child starting at or before the offset that is not
				// empty: a missing token has no width and holds nothing.
				let lo = first
				let hi = end - 1
				for lo < hi {
					let mid = (lo + hi + 1) / 2
					if s.fullStartOf(s.itemAt(mid)) <= offset {
						lo = mid
					} else {
						hi = mid - 1
					}
				}
				for lo > first && s.fullStartOf(s.itemAt(lo)) == s.fullEndOf(s.itemAt(lo)) {
					lo--
				}
				at = new SyntaxNode(tree, s, s.itemAt(lo), at, lo - first)
			}
			return at
		}

		// ancestor is the nearest enclosing node of `kind`, none without one.
		def ancestor(kind SyntaxKind) ?SyntaxNode {
			let p = parent
			return none when p is none
			return p when p.kind() == kind
			return p.ancestor(kind)
		}

		// dump is the subtree as indented lines, for tests and debugging:
		// a node as `Kind [start..end)`, a token as `Token.Kind "text"
		// [start..end)`, a missing token marked `missing`.
		def dump() string {
			let out = ""
			return writeDump(out, 0)
		}

		internal def writeDump(out string, depth int) string {
			out += "  ".repeat(depth)
			if isToken() {
				out += "Token." + token().name
				out += isMissing() ?? (" missing", " \"" + text() + "\"")
			} else {
				out += kind().name
			}
			out += " [{start()}..{end()})\n"
			for let (_, c) in children() {
				out = c.writeDump(out, depth + 1)
			}
			return out
		}
	}

	// breakBetween is true when one of the sorted line-break offsets lies
	// in `[from, to)`.
	internal def breakBetween(breaks int[], from int, to int) bool {
		let lo = 0
		let hi = breaks.len()
		// The first break at or after `from`.
		for lo < hi {
			let mid = (lo + hi) / 2
			if breaks[mid] < from {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo < breaks.len() && breaks[lo] < to
	}

	// FoldingRange is a span an editor may collapse: the lines of a block
	// or body from its opening brace to its closing one, or of a `use ( ... )`
	// group from its opening parenthesis to its closing one (kind `UseGroup`).
	struct FoldingRange {
		start int
		end   int
		kind  SyntaxKind
	}

	partial type SyntaxTree {
		// foldingRanges is every block, body and raw block that spans more
		// than one line, outermost first, with the offsets of its braces, and
		// every `use ( ... )` group spanning more than one line, with the
		// offsets of its parentheses, as kind `UseGroup`. Every body is
		// parsed first.
		def foldingRanges() FoldingRange[] {
			let out FoldingRange[]
			collectFolds(root(), breakOffsets(), out)
			return out
		}

		// collectFolds adds the folding ranges of the node and below it,
		// outermost first. Only nodes are made: a node's own tokens are read
		// from the arrays.
		internal def collectFolds(node SyntaxNode, breaks int[], out FoldingRange[]) {
			let seg = node.seg
			let n = itemIndex(node.item)
			let k = seg.kind(n)
			let (s, m) = contentOf(self, seg, n)
			let (first, end) = s.itemsOf(m)
			if k == SyntaxKind.Use {
				// The group's parentheses are the node's own tokens.
				let open = -1
				let openEnd = -1
				let close = -1
				let closeEnd = -1
				for let j = first; j < end; j++ {
					let it = s.itemAt(j)
					continue unless tagOf(it) == tokenTag
					let t = itemIndex(it)
					let kind = tokens.kind(t)
					if kind == TokenKind.LParen && open < 0 {
						open = tokens.start(t)
						openEnd = tokens.end(t)
					} else if kind == TokenKind.RParen && close < 0 {
						close = tokens.start(t)
						closeEnd = tokens.end(t)
					}
				}
				out.push(FoldingRange{start: open, end: closeEnd, kind: SyntaxKind.UseGroup}) when open >= 0 && close >= 0 && breakBetween(breaks, openEnd, close)
			} else if k == SyntaxKind.Block || k == SyntaxKind.Body || k == SyntaxKind.RawBlock {
				addBraceFold(node, k, breaks, out)
			}
			for let j = first; j < end; j++ {
				let it = s.itemAt(j)
				collectFolds(new SyntaxNode(self, s, it, node, j - first), breaks, out) when tagOf(it) == nodeTag
			}
		}

		// addBraceFold adds the range of a block from its first token to its
		// last when a line break lies between them. Either may be a missing
		// token, which spans nothing where it stands.
		internal def addBraceFold(node SyntaxNode, kind SyntaxKind, breaks int[], out FoldingRange[]) {
			let n = itemIndex(node.item)
			let seg = node.seg
			return when seg.has(n, leafless)
			let firstTok = int(seg.firstToken[n])
			let endTok = int(seg.endToken[n])
			if seg.has(n, bareStart) || seg.has(n, bareEnd) {
				// One leaf alone is both edges: no range.
				let first = node.firstToken()
				let last = node.lastToken()
				return when first is none || last is none || first.same(last)
			} else {
				return when endTok - firstTok < 2
			}
			let openStart = node.start()
			let openEnd = seg.has(n, bareStart) ?? (openStart, tokens.end(firstTok))
			let closeEnd = node.end()
			let closeStart = seg.has(n, bareEnd) ?? (closeEnd, tokens.start(endTok - 1))
			out.push(FoldingRange{start: openStart, end: closeEnd, kind: kind}) when breakBetween(breaks, openEnd, closeStart)
		}

		// breakOffsets is the offset of every `\n` of the source, in order: one
		// pass, so a check per block costs a search instead of a slice (which
		// seeks from the start of the string).
		internal def breakOffsets() int[] {
			let out int[]
			for let (i, c) in source {
				out.push(i) when c == '\n'
			}
			return out
		}

		// useParen is the parenthesis of that kind among a `use` node's own
		// tokens, none for a `use` without a group.
		internal def useParen(node SyntaxNode, kind TokenKind) ?SyntaxNode {
			for let (_, c) in node.children() {
				return c when c.isToken() && c.token() == kind && !c.isMissing()
			}
			return none
		}
	}
}
