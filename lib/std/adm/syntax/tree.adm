partial module std.adm.syntax {
	use std.adm.lexer::(TokenKind)

	// SyntaxTree is the parsed form of a source text: the green root and the
	// text it spells. Positions are character offsets into that text.
	partial type SyntaxTree {
		internal green  Green
		internal source string

		def new(root Green, source string) {
			self.green = root
			self.source = source
		}

		// root is the file node.
		def root() SyntaxNode {
			return new SyntaxNode(green, none, 0, 0)
		}

		// text is the source the tree spells, trivia included.
		def text() string {
			return source
		}

		// diagnostics is every parse diagnostic, at absolute offsets, in
		// source order.
		def diagnostics() Diagnostic[] {
			let out Diagnostic[]
			collectDiagnostics(green, 0, out)
			return out
		}

		// find is the token at `offset`, none when the offset is past the end.
		def find(offset int) ?SyntaxNode {
			return root().find(offset)
		}

		// position is the 1-based line and column of a character offset,
		// counting a `\r\n` as one line break; an offset past the end is
		// the end's position.
		def position(offset int) Position {
			let line = 1
			let column = 1
			let n = source.len()
			offset = n when offset > n
			for let i = 0; i < offset; i++ {
				let c = source[i]
				if c == '\n' || (c == '\r' && (i + 1 >= n || source[i + 1] != '\n')) {
					line++
					column = 1
				} else if c != '\r' {
					column++
				}
			}
			return Position{line: line, column: column}
		}
	}

	// Position is a place in the source as an editor shows it: 1-based line
	// and column, in characters.
	struct Position {
		line   int
		column int
	}

	internal def collectDiagnostics(g Green, offset int, into Diagnostic[]) {
		return unless g.troubled
		for let (_, d) in g.errors {
			into.push(Diagnostic{message: d.message, start: offset + d.start, end: offset + d.end})
		}
		let at = offset
		for let (_, c) in g.children {
			collectDiagnostics(c, at, into)
			at += c.width
		}
	}

	// SyntaxNode is a green element at a place in its tree: the element, its
	// parent and its absolute offset. Made on demand by navigation, never
	// stored by the tree. Two nodes are the same node when `same` says so.
	type SyntaxNode {
		green  Green
		parent ?SyntaxNode
		// Where the element starts, leading trivia included.
		offset int
		// Which child of the parent it is.
		index  int

		def new(green Green, parent ?SyntaxNode, offset int, index int) {
			self.green = green
			self.parent = parent
			self.offset = offset
			self.index = index
		}

		// kind is the element's kind, Token for a token.
		def kind() SyntaxKind {
			return green.kind
		}

		// token is the token kind of a token element, EOF for a node.
		def token() TokenKind {
			return green.token
		}

		// isToken is true for a token, missing ones included.
		def isToken() bool {
			return green.isToken()
		}

		// isMissing is true for a token the parser expected and did not find.
		def isMissing() bool {
			return green.missing
		}

		// same is true when the other node is this node: the same green
		// element, whichever tree version it is reached from.
		def same(other SyntaxNode) bool {
			return green == other.green
		}

		// fullStart is where the element starts, leading trivia included.
		def fullStart() int {
			return offset
		}

		// fullEnd is where the element ends, trailing trivia included.
		def fullEnd() int {
			return offset + green.width
		}

		// start is where the element's own text starts.
		def start() int {
			return offset + green.leadingWidth()
		}

		// end is where the element's own text ends (exclusive).
		def end() int {
			return offset + green.width - green.trailingWidth()
		}

		// text is the element's own text, without the trivia around it.
		def text() string {
			return green.text when green.isToken()
			let full = green.fullText()
			let from = green.leadingWidth()
			let to = full.len() - green.trailingWidth()
			return full[from:to]
		}

		// fullText is the element's text with its trivia.
		def fullText() string {
			return green.fullText()
		}

		// childCount is the number of children, 0 for a token.
		def childCount() int {
			return green.children.len()
		}

		// child is the i-th child, none past the last.
		def child(i int) ?SyntaxNode {
			return none when i < 0 || i >= green.children.len()
			let at = offset
			for let k = 0; k < i; k++ {
				at += green.children[k].width
			}
			return new SyntaxNode(green.children[i], self, at, i)
		}

		// children is every child in source order, empty for a token.
		def children() SyntaxNode[] {
			let out SyntaxNode[]
			let at = offset
			for let (i, c) in green.children {
				out.push(new SyntaxNode(c, self, at, i))
				at += c.width
			}
			return out
		}

		// nextSibling is the next child of the parent, none for the last.
		def nextSibling() ?SyntaxNode {
			let p = parent
			return none when p is none
			return p.child(index + 1)
		}

		// prevSibling is the previous child of the parent, none for the first.
		def prevSibling() ?SyntaxNode {
			let p = parent
			return none when p is none
			return p.child(index - 1)
		}

		// firstToken is the first token below the element, itself for a
		// token; none for a node without tokens.
		def firstToken() ?SyntaxNode {
			return self when green.isToken()
			for let (_, c) in children() {
				let t = c.firstToken()
				return t unless t is none
			}
			return none
		}

		// lastToken is the last token below the element, itself for a token;
		// none for a node without tokens.
		def lastToken() ?SyntaxNode {
			return self when green.isToken()
			let kids = children()
			for let i = kids.len() - 1; i >= 0; i-- {
				let t = kids[i].lastToken()
				return t unless t is none
			}
			return none
		}

		// tokens is every token below the element in source order.
		def tokens() SyntaxNode[] {
			let out SyntaxNode[]
			collectTokens(out)
			return out
		}

		internal def collectTokens(into SyntaxNode[]) {
			if green.isToken() {
				into.push(self)
				return
			}
			for let (_, c) in children() {
				c.collectTokens(into)
			}
		}

		// descendants is every element below this one, parents before
		// children, in source order; the element itself is not included.
		def descendants() SyntaxNode[] {
			let out SyntaxNode[]
			collectDescendants(out)
			return out
		}

		internal def collectDescendants(into SyntaxNode[]) {
			for let (_, c) in children() {
				into.push(c)
				c.collectDescendants(into)
			}
		}

		// find is the token whose full span holds `offset`, none when the
		// offset is outside the element.
		def find(offset int) ?SyntaxNode {
			return none when offset < self.offset || offset >= fullEnd()
			return self when green.isToken()
			let at = self.offset
			for let (i, c) in green.children {
				return new SyntaxNode(c, self, at, i).find(offset) when offset < at + c.width
				at += c.width
			}
			return none
		}

		// ancestor is the nearest enclosing node of `kind`, none without one.
		def ancestor(kind SyntaxKind) ?SyntaxNode {
			let p = parent
			return none when p is none
			return p when p.kind() == kind
			return p.ancestor(kind)
		}

		// dump is the subtree as indented lines, for tests and debugging:
		// a node as `Kind [start..end)`, a token as `Token.Kind "text"
		// [start..end)`, a missing token marked `missing`.
		def dump() string {
			let out = ""
			return writeDump(out, 0)
		}

		internal def writeDump(out string, depth int) string {
			out += "  ".repeat(depth)
			if green.isToken() {
				out += "Token." + green.token.name
				out += green.missing ?? (" missing", " \"" + green.text + "\"")
			} else {
				out += green.kind.name
			}
			out += " [{start()}..{end()})\n"
			for let (_, c) in children() {
				out = c.writeDump(out, depth + 1)
			}
			return out
		}
	}

	// FoldingRange is a span an editor may collapse: the lines of a block
	// or body from its opening brace to its closing one.
	struct FoldingRange {
		start int
		end   int
		kind  SyntaxKind
	}

	partial type SyntaxTree {
		// foldingRanges is every block, body and raw block that spans more
		// than one line, outermost first, with the offsets of its braces.
		def foldingRanges() FoldingRange[] {
			let out FoldingRange[]
			for let (_, n) in root().descendants() {
				let k = n.kind()
				continue unless k == SyntaxKind.Block || k == SyntaxKind.Body || k == SyntaxKind.RawBlock
				let open = n.firstToken()
				let close = n.lastToken()
				continue when open is none || close is none
				continue when open.same(close)
				continue unless source[open.end():close.start()].contains("\n")
				out.push(FoldingRange{start: open.start(), end: close.end(), kind: k})
			}
			return out
		}
	}
}
