// Pictures from sentences with Stable Diffusion 1.x and 2.x in ONNX form:
// the CLIP text encoder reads the prompt, the UNet removes noise from a
// latent picture step by step (DDIM), and the VAE decoder turns the
// latents into pixels. LoRAs are merged into the weights at load.
//
// ```
// let painter = try diffusion.load("stable-diffusion-v1-5", loras = [diffusion.Lora{path: "pixel-art.safetensors", strength: 0.8}])
// let picture = try painter.draw("a lighthouse at dusk, pixel art", steps = 30, seed = 42)
// try picture.save("lighthouse.png")
// ```
partial module std.ai.diffusion {
	use (
		std.os
		std.math
		std.math::(Random)
		std.crypto
		std.data.encoding::(JSON)
		std.formats.image::(Image)
		std.formats.ai
		std.formats.ai::(ModelFile)
		std.formats.ai.onnx as onnxfile
		std.formats.ai.onnx::(ElementType, OnnxModel, TensorData)
		std.ai.onnx
		std.ai.tensor::(Tensor)
		std.ai.llm::(Tokenizer, loadTokenizer, Device)
	)

	// A LoRA file (kohya or diffusers keys, safetensors) and how strongly
	// its change applies: 1 as trained, 0 not at all.
	struct Lora {
		path     string
		strength float  = 1.0
	}

	// A loaded Stable Diffusion pipeline.
	type DiffusionModel {
		// The picture size `draw` makes unless told otherwise (multiples of 8).
		width                int
		height               int
		// Where the models run.
		device               Device
		internal text        onnx.Model
		internal unet        onnx.Model
		internal vae         onnx.Model
		internal tokenizer   Tokenizer
		internal idType      ElementType
		internal timeType    ElementType
		internal alphas      float[]
		internal trainSteps  int
		internal stepsOffset int
		internal spacing     string
		internal alphaOne    bool
		internal velocity    bool
		internal latentScale float
		internal channels    int
		internal textLength  int
		internal padToken    int

		def new(text onnx.Model, unet onnx.Model, vae onnx.Model, tokenizer Tokenizer) {
			self.text = text
			self.unet = unet
			self.vae = vae
			self.tokenizer = tokenizer
		}

		// A picture of `prompt`, steered away from `negative`, after
		// `steps` DDIM steps with classifier-free `guidance`. The same seed
		// gives the same picture; without one each picture is new.
		// `width` and `height` (0 for the model's own size) are rounded down
		// to multiples of 8.
		// Fails when a model run does.
		def draw(prompt string, negative string = "", steps int = 30, seed ?int = none, guidance float = 7.5, width int = 0, height int = 0) !Image {
			let w = (width > 0 ?? (width, self.width)) / 8
			let h = (height > 0 ?? (height, self.height)) / 8
			fail "diffusion: a picture needs at least 8 × 8 pixels" when w <= 0 || h <= 0
			let count = steps.clamp(1, trainSteps)
			let blank = try embed(negative)
			let wanted = try embed(prompt)
			let context = new Tensor(int[2, textLength, wanted.shape[2]], blank.floats + wanted.floats)
			let plane = channels * h * w
			let random = new Random(seed is int ?? (seed, crypto.randOf<int>()))
			let latents float32[]
			latents.len(plane)
			for let i = 0; i < plane; i++ {
				latents[i] = float32(random.normal())
			}
			let times = timesteps(count)
			for let (i, t) in times {
				let feeds = new map<string, onnx.Value>()
				feeds.set("sample", new Tensor(int[2, channels, h, w], latents + latents))
				feeds.set("timestep", timeTensor(t))
				feeds.set("encoder_hidden_states", context)
				let out = try unet.run(feeds)
				let predicted = out.get("out_sample")
				fail "diffusion: the UNet gave no out_sample" unless predicted is Tensor
				let previous = i + 1 < times.len() ?? (times[i + 1], -1)
				let alpha = alphas[t]
				let alphaPrevious = previous >= 0 ?? (alphas[previous], alphaOne ?? (1.0, alphas[0]))
				let (sa, sb) = (math.sqrt(alpha), math.sqrt(1.0 - alpha))
				let (pa, pb) = (math.sqrt(alphaPrevious), math.sqrt(1.0 - alphaPrevious))
				for let k = 0; k < plane; k++ {
					let uncond = float(predicted.floats[k])
					let model = uncond + guidance * (float(predicted.floats[plane + k]) - uncond)
					let x = float(latents[k])
					// The model predicts the noise (epsilon) or the velocity.
					let eps = velocity ?? (sa * model + sb * x, model)
					let x0 = velocity ?? (sa * x - sb * model, (x - sb * eps) / sa)
					latents[k] = float32(pa * x0 + pb * eps)
				}
			}
			let scaled float32[]
			scaled.len(plane)
			for let k = 0; k < plane; k++ {
				scaled[k] = float32(float(latents[k]) / latentScale)
			}
			let feeds = new map<string, onnx.Value>()
			feeds.set("latent_sample", new Tensor(int[1, channels, h, w], scaled))
			let decoded = (try vae.run(feeds)).get("sample")
			fail "diffusion: the VAE gave no sample" unless decoded is Tensor
			return toImage(decoded)
		}

		// The text encoder's vectors of `prompt`: its tokens cut or padded to
		// the encoder's length.
		internal def embed(prompt string) !Tensor {
			let ids = tokenizer.encode(prompt)
			if ids.len() > textLength {
				let last = ids[ids.len() - 1]
				ids = ids[0:textLength]
				ids[textLength - 1] = last
			}
			for ids.len() < textLength {
				ids.push(padToken)
			}
			let feeds = new map<string, onnx.Value>()
			feeds.set("input_ids", new Tensor(int[1, textLength], ids, idType))
			let out = try text.run(feeds)
			let hidden = out.get("last_hidden_state")
			fail "diffusion: the text encoder gave no last_hidden_state" unless hidden is Tensor
			return hidden
		}

		// The DDIM timesteps of `count` steps, noisiest first, spaced as
		// the scheduler config says.
		internal def timesteps(count int) int[] {
			let out int[]
			match spacing {
				case "trailing":
					let ratio = float(trainSteps) / float(count)
					for let i = count; i >= 1; i-- {
						out.push(int(float(i) * ratio + 0.5) - 1)
					}
				case "linspace":
					for let i = count - 1; i >= 0; i-- {
						out.push(int(float(i) * float(trainSteps - 1) / float((count - 1).max(1)) + 0.5))
					}
				default:
					let ratio = trainSteps / count
					for let i = count - 1; i >= 0; i-- {
						out.push(i * ratio + stepsOffset)
					}
			}
			for let i = 0; i < out.len(); i++ {
				out[i] = out[i].clamp(0, trainSteps - 1)
			}
			return out
		}

		// The two timesteps of a guided step, in the UNet's element type.
		internal def timeTensor(t int) Tensor {
			return new Tensor(int[2], int[t, t], timeType) unless timeType := ElementType.Float || ElementType.Float16 || ElementType.Double
			return new Tensor(int[2], float32[float32(t), float32(t)])
		}
	}

	// Loads the Stable Diffusion export in `folder` (as optimum lays it out:
	// model_index.json, text_encoder/, unet/, vae_decoder/, tokenizer/ and
	// scheduler/), merges `loras` into its text encoder and UNet, and readies
	// it on `device`.
	// Fails when a file is missing or cannot be read, or a LoRA names a
	// layer the model does not have.
	def load(folder string, loras Lora[] = [], device Device = Device.Auto) !DiffusionModel {
		let textFile = try onnxfile.load(os.join(folder, "text_encoder", "model.onnx"))
		let unetFile = try onnxfile.load(os.join(folder, "unet", "model.onnx"))
		for let (_, lora) in loras {
			try mergeLora(lora, textFile, unetFile)
		}
		let text = try onnx.load(textFile, device)
		let unet = try onnx.load(unetFile, device)
		let vae = try onnx.load(os.join(folder, "vae_decoder", "model.onnx"), device)
		let tokenizer = try loadTokenizer(os.join(folder, "tokenizer"))
		let model = new DiffusionModel(text, unet, vae, tokenizer)
		model.device = unet.device
		let scheduler = try jsonAt(os.join(folder, "scheduler"), "scheduler_config.json")
		model.trainSteps = intAt(scheduler, "num_train_timesteps", 1000)
		model.stepsOffset = intAt(scheduler, "steps_offset", 0)
		model.spacing = textAt(scheduler, "timestep_spacing", "leading")
		model.alphaOne = boolAt(scheduler, "set_alpha_to_one", false)
		model.velocity = textAt(scheduler, "prediction_type", "epsilon") == "v_prediction"
		model.alphas = cumulativeAlphas(model.trainSteps, numberAt(scheduler, "beta_start", 0.00085), numberAt(scheduler, "beta_end", 0.012), textAt(scheduler, "beta_schedule", "scaled_linear"))
		let vaeConfig = try jsonAt(os.join(folder, "vae_decoder"), "config.json")
		model.latentScale = numberAt(vaeConfig, "scaling_factor", 0.18215)
		let unetConfig = try jsonAt(os.join(folder, "unet"), "config.json")
		model.channels = intAt(unetConfig, "in_channels", 4)
		let sample = intAt(unetConfig, "sample_size", 64)
		model.width = sample * 8
		model.height = sample * 8
		let tokenizerConfig = try jsonAt(os.join(folder, "tokenizer"), "tokenizer_config.json")
		model.textLength = intAt(tokenizerConfig, "model_max_length", 77).min(77)
		let pad = tokenizer.encode(textAt(tokenizerConfig, "pad_token", "<|endoftext|>"), addStart = false)
		model.padToken = pad.len() == 1 ?? (pad[0], tokenizer.endToken())
		model.idType = ElementType.Int32
		for let (_, input) in text.inputs {
			model.idType = input.valueType.element when input.name == "input_ids"
		}
		model.timeType = ElementType.Float
		for let (_, input) in unet.inputs {
			model.timeType = input.valueType.element when input.name == "timestep"
		}
		return model
	}

	// The cumulative products of 1 − β over the training steps, β running
	// linearly from `start` to `end` ("linear") or in their square roots
	// ("scaled_linear").
	internal def cumulativeAlphas(steps int, start float, end float, schedule string) float[] {
		let out float[]
		let product = 1.0
		let scaled = schedule == "scaled_linear"
		let (first, last) = scaled ?? ((math.sqrt(start), math.sqrt(end)), (start, end))
		for let i = 0; i < steps; i++ {
			let b = first + (last - first) * float(i) / float((steps - 1).max(1))
			product *= 1.0 - (scaled ?? (b * b, b))
			out.push(product)
		}
		return out
	}

	// The VAE's [1, 3, h, w] output in [-1, 1] as a picture.
	internal def toImage(t Tensor) Image {
		let (h, w) = (t.shape[2], t.shape[3])
		let img = new Image(w, h)
		let px = img.raw()
		let plane = h * w
		for let i = 0; i < plane; i++ {
			for let c = 0; c < 3; c++ {
				let v = (float(t.floats[c * plane + i]) + 1.0) / 2.0
				px[i * 4 + c] = byte(int(v.clamp(0.0, 1.0) * 255.0 + 0.5))
			}
			px[i * 4 + 3] = byte(255)
		}
		return img
	}

	internal def jsonAt(folder string, name string) !map<string, any> {
		let path = os.join(folder, name)
		return new map<string, any>() unless try os.exists(path)
		let doc = try new JSON().parse(try os.readFile(path))
		fail "diffusion: {path} is not a JSON object" unless doc is map<string, any>
		return doc
	}

	internal def intAt(m map<string, any>, key string, fallback int) int {
		let v = m.get(key)
		return v is int ?? (v, fallback)
	}

	internal def numberAt(m map<string, any>, key string, fallback float) float {
		let v = m.get(key)
		return float(v) when v is int
		return v is float ?? (v, fallback)
	}

	internal def textAt(m map<string, any>, key string, fallback string) string {
		let v = m.get(key)
		return v is string ?? (v, fallback)
	}

	internal def boolAt(m map<string, any>, key string, fallback bool) bool {
		let v = m.get(key)
		return v is bool ?? (v, fallback)
	}
}
