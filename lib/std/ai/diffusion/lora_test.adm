partial module std.ai.diffusion {
	use (
		std.testing
		std.formats.ai.onnx::(ElementType, TensorData)
	)

	check "LoRA" {
		internal def weight(values float32[], dims int[]) TensorData {
			let t = new TensorData()
			t.name = "w"
			t.element = ElementType.Float
			t.dims = dims
			t.data = bytesOf(values, ElementType.Float)
			return t
		}

		// A LoRA tensor's layer and role as "layer|role".
		internal def role(name string) string {
			let (base, kind) = loraRole(name)
			return "{base}|{kind}"
		}

		@test()
		def keys_name_their_layers() {
			assert role("lora_unet_down_blocks_0_attentions_0_proj_in.lora_down.weight") == "lora_unet_down_blocks_0_attentions_0_proj_in|down"
			assert role("lora_unet_mid_block_attentions_0_proj_out.lora_up.weight") == "lora_unet_mid_block_attentions_0_proj_out|up"
			assert role("lora_te_text_model_encoder_layers_0_mlp_fc1.alpha") == "lora_te_text_model_encoder_layers_0_mlp_fc1|alpha"
			assert role("unet.up_blocks.1.attentions.0.transformer_blocks.0.attn2.to_k.lora_A.weight") == "unet.up_blocks.1.attentions.0.transformer_blocks.0.attn2.to_k|down"
			assert role("unet.mid_block.attentions.0.transformer_blocks.0.attn1.processor.to_out_lora.up.weight") == "unet.mid_block.attentions.0.transformer_blocks.0.attn1.to_out.0|up"
			assert role("unet.conv_in.weight") == "|"
			assert pathOf("/down_blocks.0/attentions.0/transformer_blocks.0/attn1/to_q/MatMul") == "down_blocks.0.attentions.0.transformer_blocks.0.attn1.to_q"
		}

		// up [2, 1] · down [1, 3] = [[1, 2, 3], [2, 4, 6]], at strength 0.5
		// and alpha 2 over rank 1: scale 1.
		@test()
		def products_add_in_both_layouts() !none {
			let down = float32[1, 2, 3]
			let up = float32[1, 2]
			// [out, in] as Gemm with transB and Conv keep it.
			let plain = weight(float32[10, 10, 10, 20, 20, 20], int[2, 3])
			try addProduct(LoraTarget{tensor: plain, transposed: false}, down, up, 2.0, 0.5, "plain")
			assert (try plain.floats()).equals(float32[11, 12, 13, 22, 24, 26])
			// [in, out] as MatMul takes it.
			let flipped = weight(float32[10, 20, 10, 20, 10, 20], int[3, 2])
			try addProduct(LoraTarget{tensor: flipped, transposed: true}, down, up, 2.0, 0.5, "flipped")
			assert (try flipped.floats()).equals(float32[11, 22, 12, 24, 13, 26])
			// A 3×3 convolution of one input channel: down [1, 1, 3, 3].
			let conv = weight(float32[0, 0, 0, 0, 0, 0, 0, 0, 0], int[1, 1, 3, 3])
			try addProduct(LoraTarget{tensor: conv, transposed: false}, float32[1, 2, 3, 4, 5, 6, 7, 8, 9], float32[2], -1.0, 1.0, "conv")
			assert (try conv.floats()).equals(float32[2, 4, 6, 8, 10, 12, 14, 16, 18])
			return testing.expectError(addProduct(LoraTarget{tensor: plain, transposed: false}, float32[1, 2], up, 2.0, 1.0, "bad"))
		}
	}
}
