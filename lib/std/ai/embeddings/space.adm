// The shape of a set of vectors: the few directions along which it spreads
// most, for drawing texts or tokens as points on a plane, and its groups.
//
// ```
// let stored = try model.embed(texts)
// let plane = try embeddings.principalComponents(stored, 2)
// let points = plane.project(stored)             // x and y per text
// let kept = plane.explained[0] + plane.explained[1]
// let found = try embeddings.clusters(stored, 5, seed = 1)
// let colour = found.groups                       // a group per text
// ```
partial module std.ai.embeddings {
	use (
		std.math
		std.math::(Random)
		std.math.linalg
		std.simd
	)

	// The directions kept beside the ones asked for while the components
	// are searched: they take up what would otherwise leak into the last
	// of those.
	internal const spareComponents = 8

	// The most passes over the vectors the search for components makes,
	// and the relative change of the components' spread it stops at.
	internal const componentPasses = 48
	internal const componentSettled = 1e-6

	// The most rounds k-means moves its centres.
	internal const clusterRounds = 100

	// Projection is a map from vectors onto the directions along which the
	// vectors it was fitted on spread most (their principal components):
	// what keeps the most of how they differ in few numbers.
	type Projection {
		// The mean of the fitted vectors, which is taken off a vector before
		// it is projected.
		centre     float32[]
		// The directions, widest spread first: unit vectors at right angles,
		// each with its greatest entry positive.
		components float32[][]
		// The share of the fitted vectors' spread (their variance) each
		// component keeps, from 0 to 1; their sum is what a drawing of the
		// components shows of the whole.
		explained  float[]

		internal def new(centre float32[], components float32[][], explained float[]) {
			self.centre = centre
			self.components = components
			self.explained = explained
		}

		// The vector's coordinate along each component. A vector that was
		// not among the fitted ones is placed among them.
		def project(vector float32[]) float32[] {
			let out float32[]
			out.len(components.len())
			for let (j, direction) in components {
				out[j] = centredDot(vector, centre, direction)
			}
			return out
		}

		// Each vector's coordinates along the components. Large lists are
		// projected on tasks.
		def project(vectors float32[][]) float32[][] {
			let out float32[][]
			out.len(vectors.len())
			let tasks = spaceTasks(vectors.len(), centre.len() * components.len())
			forall let b in 0..tasks {
				let directions = components
				let middle = centre
				for let i = vectors.len() * b / tasks; i < vectors.len() * (b + 1) / tasks; i++ {
					let at float32[]
					at.len(directions.len())
					for let (j, direction) in directions {
						at[j] = centredDot(vectors[i], middle, direction)
					}
					out[i] = at
				}
			}
			return out
		}
	}

	// Clusters is a set of vectors split into groups of vectors that lie
	// close together, each group around its centre.
	type Clusters {
		// The mean of each group's vectors.
		centres float32[][]
		// The group of each vector, as a position in `centres`.
		groups  int[]

		internal def new(centres float32[][], groups int[]) {
			self.centres = centres
			self.groups = groups
		}

		// The group whose centre is nearest the vector, the lowest of
		// those equally near.
		def group(vector float32[]) int {
			let best = 0
			let least = 0.0
			for let (j, centre) in centres {
				let away = float(apart(vector, centre))
				if j == 0 || away < least {
					best = j
					least = away
				}
			}
			return best
		}
	}

	// How many tasks a pass over `rows` vectors is split into when each row
	// costs `work` multiplications: by the sizes alone, so a result never
	// depends on the machine.
	internal def spaceTasks(rows int, work int) int {
		return (rows * work / (1 << 18)).clamp(1, 32).min(rows.max(1))
	}

	// Adds `scale` times `from` to `into`.
	internal def addScaled(into float32[], from float32[], scale float32) {
		let n = into.len().min(from.len())
		let by = simd.splat8<float32>(scale)
		let i = 0
		for; i + 8 <= n; i += 8 {
			simd.store8<float32>(into, i, simd.fma(by, simd.load8<float32>(from, i), simd.load8<float32>(into, i)))
		}
		for; i < n; i++ {
			into[i] += scale * from[i]
		}
	}

	// The coordinate of `vector` less `centre` along `direction`. The
	// centre is taken off inside the sum: a product with the vector as it
	// is, less the centre's, loses the digits the two have in common.
	internal def centredDot(vector float32[], centre float32[], direction float32[]) float32 {
		let n = vector.len().min(centre.len()).min(direction.len())
		let acc = simd.splat8<float32>(float32(0))
		let i = 0
		for; i + 8 <= n; i += 8 {
			acc = simd.fma(simd.load8<float32>(vector, i) - simd.load8<float32>(centre, i), simd.load8<float32>(direction, i), acc)
		}
		let sum = simd.sum(acc)
		for; i < n; i++ {
			sum += (vector[i] - centre[i]) * direction[i]
		}
		return sum
	}

	// Adds `scale` times (`from` less `centre`) to `into`.
	internal def addCentred(into float32[], from float32[], centre float32[], scale float32) {
		let n = into.len().min(from.len()).min(centre.len())
		let by = simd.splat8<float32>(scale)
		let i = 0
		for; i + 8 <= n; i += 8 {
			simd.store8<float32>(into, i, simd.fma(by, simd.load8<float32>(from, i) - simd.load8<float32>(centre, i), simd.load8<float32>(into, i)))
		}
		for; i < n; i++ {
			into[i] += scale * (from[i] - centre[i])
		}
	}

	// The squared distance between two vectors.
	internal def apart(a float32[], b float32[]) float32 {
		let n = a.len().min(b.len())
		let acc = simd.splat8<float32>(float32(0))
		let i = 0
		for; i + 8 <= n; i += 8 {
			let d = simd.load8<float32>(a, i) - simd.load8<float32>(b, i)
			acc = simd.fma(d, d, acc)
		}
		let sum = simd.sum(acc)
		for; i < n; i++ {
			sum += (a[i] - b[i]) * (a[i] - b[i])
		}
		return sum
	}

	// The width every vector has. Fails when there are fewer than `least`
	// vectors, they have no numbers, or one is of another width.
	internal def spaceWidth(vectors float32[][], least int, what string) !int {
		expects {
			assert vectors.len() >= least onerror fail "embeddings: {what} need at least {least} vectors, got {vectors.len()}"
		}
		let width = vectors[0].len()
		fail "embeddings: {what} need vectors with numbers in them" when width == 0
		for let (i, vector) in vectors {
			fail "embeddings: vector {i} holds {vector.len()} numbers and the first holds {width}" when vector.len() != width
		}
		return width
	}

	// The mean of the vectors, summed on tasks.
	internal def spaceMean(vectors float32[][], width int) float32[] {
		let tasks = spaceTasks(vectors.len(), width)
		let parts float32[][]
		parts.len(tasks)
		forall let b in 0..tasks {
			let sum float32[]
			sum.len(width)
			for let i = vectors.len() * b / tasks; i < vectors.len() * (b + 1) / tasks; i++ {
				addScaled(sum, vectors[i], float32(1))
			}
			parts[b] = sum
		}
		let mean float32[]
		mean.len(width)
		for let (_, part) in parts {
			addScaled(mean, part, float32(1.0 / float(vectors.len())))
		}
		return mean
	}

	// Makes the rows unit vectors at right angles to one another, each
	// freed of the ones before it (twice, which keeps them at right angles
	// in the last place). A row that the ones before it already span is
	// replaced by a random direction they do not.
	internal def orthonormal(rows float32[][], random Random) {
		let width = rows[0].len()
		for let j = 0; j < rows.len(); j++ {
			let row = rows[j]
			for let attempt = 0; attempt < 8; attempt++ {
				let before = math.sqrt(float(dot(row, row)))
				for let pass = 0; pass < 2; pass++ {
					for let k = 0; k < j; k++ {
						addScaled(row, rows[k], -dot(row, rows[k]))
					}
				}
				let length = math.sqrt(float(dot(row, row)))
				if length > before * 1e-5 && length > 0.0 {
					let by = float32(1.0 / length)
					for let i = 0; i < width; i++ {
						row[i] *= by
					}
					break
				}
				for let i = 0; i < width; i++ {
					row[i] = float32(random.normal())
				}
			}
		}
	}

	// What one pass over the vectors gives the search for components: for
	// the directions Q and the vectors less their mean X, the rows of
	// XᵀXQ (the directions sharpened towards the components), the products
	// of the vectors' coordinates along each two directions, and the
	// vectors' whole spread.
	internal type ComponentPass {
		sharpened float32[][]
		products  float[]
		spread    float

		def new() {}
	}

	internal def componentPass(vectors float32[][], centre float32[], directions float32[][]) ComponentPass {
		let count = directions.len()
		let width = centre.len()
		let tasks = spaceTasks(vectors.len(), width * count * 2)
		let parts ComponentPass[]
		for let b = 0; b < tasks; b++ {
			parts.push(new ComponentPass())
		}
		forall let b in 0..tasks {
			let own = directions
			let part = parts[b]
			let rows float32[][]
			for let j = 0; j < count; j++ {
				let row float32[]
				row.len(width)
				rows.push(row)
			}
			let products float[]
			products.len(count * count)
			let along float[]
			along.len(count)
			let spread = 0.0
			for let i = vectors.len() * b / tasks; i < vectors.len() * (b + 1) / tasks; i++ {
				let vector = vectors[i]
				spread += float(apart(vector, centre))
				for let j = 0; j < count; j++ {
					let at = centredDot(vector, centre, own[j])
					along[j] = float(at)
					addCentred(rows[j], vector, centre, at)
				}
				for let j = 0; j < count; j++ {
					for let k = 0; k <= j; k++ {
						products[j * count + k] += along[j] * along[k]
					}
				}
			}
			part.sharpened = rows
			part.products = products
			part.spread = spread
		}
		let out = new ComponentPass()
		out.products.len(count * count)
		for let j = 0; j < count; j++ {
			let row float32[]
			row.len(width)
			out.sharpened.push(row)
		}
		for let (_, part) in parts {
			out.spread += part.spread
			for let j = 0; j < count; j++ {
				addScaled(out.sharpened[j], part.sharpened[j], float32(1))
				for let k = 0; k <= j; k++ {
					out.products[j * count + k] += part.products[j * count + k]
					out.products[k * count + j] = out.products[j * count + k]
				}
			}
		}
		return out
	}

	// The `count` directions along which the vectors spread most, widest
	// first, with the share of the spread each keeps: the vectors'
	// principal components. `project` then gives a vector's coordinates
	// along them, which for two components is a point on a plane.
	//
	// The components are found without the vectors' covariance, by passes
	// over the vectors that sharpen a few directions towards them
	// (subspace iteration), on tasks; the result is the same on every
	// machine. Vectors that span fewer directions than asked for give
	// components that keep nothing for the rest.
	//
	// Fails when there are fewer than two vectors, they are of different
	// widths, or `count` is below 1 or above the vectors' width.
	def principalComponents(vectors float32[][], count int = 2) !Projection {
		let width = try spaceWidth(vectors, 2, "principal components")
		fail "embeddings: {count} components asked of vectors of {width} numbers" when count < 1 || count > width
		let centre = spaceMean(vectors, width)
		let random = new Random(1)
		let held = (count + spareComponents).min(width)
		let directions float32[][]
		for let j = 0; j < held; j++ {
			let row float32[]
			row.len(width)
			for let i = 0; i < width; i++ {
				row[i] = float32(random.normal())
			}
			directions.push(row)
		}
		orthonormal(directions, random)
		let kept = 0.0
		let pass = componentPass(vectors, centre, directions)
		for let round = 1; round < componentPasses; round++ {
			let found = try spreadsOf(pass, held)
			let now = 0.0
			for let j = 0; j < count; j++ {
				now += found.values[held - 1 - j]
			}
			break when round > 1 && (now - kept).abs() <= componentSettled * now
			kept = now
			directions = pass.sharpened
			orthonormal(directions, random)
			pass = componentPass(vectors, centre, directions)
		}
		// Within the directions held, the components are the ones that
		// make the coordinates' products a diagonal.
		let found = try spreadsOf(pass, held)
		let turn = found.vectors.data()
		let components float32[][]
		let explained float[]
		for let j = 0; j < count; j++ {
			let column = held - 1 - j
			let axis float32[]
			axis.len(width)
			for let k = 0; k < held; k++ {
				addScaled(axis, directions[k], float32(turn[k * held + column]))
			}
			let length = math.sqrt(float(dot(axis, axis)))
			let greatest = 0
			for let i = 1; i < width; i++ {
				greatest = i when axis[i].abs() > axis[greatest].abs()
			}
			let by = float32((axis[greatest] < 0 ?? (-1.0, 1.0)) / (length == 0.0 ?? (1.0, length)))
			for let i = 0; i < width; i++ {
				axis[i] *= by
			}
			components.push(axis)
			explained.push(pass.spread <= 0.0 ?? (0.0, (found.values[column] / pass.spread).clamp(0.0, 1.0)))
		}
		return new Projection(centre, components, explained)
	}

	// The spreads along the directions of a pass, and the turn that
	// separates them: the eigenvalues, ascending, and eigenvectors of the
	// coordinates' products.
	internal def spreadsOf(pass ComponentPass, held int) !linalg.SymmetricEigen {
		let products = matrix<float>[].size(held, held)
		let cells = products.data()
		for let i = 0; i < held * held; i++ {
			cells[i] = pass.products[i]
		}
		return linalg.eigenSymmetric(products)
	}

	// What one task of a k-means round found among its vectors: per group
	// the sum and number of the vectors nearest its centre, and how many
	// vectors changed group.
	internal type ClusterPart {
		sums    float32[][]
		counts  int[]
		changed int

		def new() {}
	}

	// Splits the vectors into `count` groups of vectors that lie close
	// together (k-means): each vector belongs to the group whose centre,
	// the mean of the group's vectors, is nearest it. The first centres are
	// vectors drawn far from one another (k-means++) by a generator started
	// from `seed`, so one seed always gives the same groups; another seed
	// may give others, since the method settles on a good split, not the
	// best. Rounds run on tasks, and stop when no vector changes group.
	//
	// Fails when there are no vectors, they are of different widths, or
	// `count` is below 1 or above the number of vectors.
	def clusters(vectors float32[][], count int, seed int = 0) !Clusters {
		let width = try spaceWidth(vectors, 1, "clusters")
		let n = vectors.len()
		fail "embeddings: {count} clusters asked of {n} vectors" when count < 1 || count > n
		let random = new Random(seed)
		// Each vector's squared distance to the nearest centre so far.
		let away float[]
		away.len(n)
		let tasks = spaceTasks(n, width * count)
		let centres float32[][]
		centres.push(vectors[random.range<int>(0, n)].clone())
		for centres.len() < count || centres.len() == 1 {
			let latest = centres[centres.len() - 1]
			let first = centres.len() == 1
			forall let b in 0..tasks {
				for let i = n * b / tasks; i < n * (b + 1) / tasks; i++ {
					let d = float(apart(vectors[i], latest))
					away[i] = d when first || d < away[i]
				}
			}
			break when centres.len() == count
			// The next centre is a vector drawn with a chance in proportion
			// to its squared distance from the centres there are.
			let total = 0.0
			for let (_, d) in away {
				total += d
			}
			let pick = n - 1
			if total > 0.0 {
				let target = random.of<float>() * total
				let run = 0.0
				for let i = 0; i < n; i++ {
					run += away[i]
					if run > target {
						pick = i
						break
					}
				}
			} else {
				pick = random.range<int>(0, n)
			}
			centres.push(vectors[pick].clone())
		}
		let groups int[]
		groups.len(n)
		groups.fill(-1)
		for let round = 0; round < clusterRounds; round++ {
			let parts ClusterPart[]
			for let b = 0; b < tasks; b++ {
				parts.push(new ClusterPart())
			}
			forall let b in 0..tasks {
				let part = parts[b]
				let nearest = centres
				let sums float32[][]
				let counts int[]
				counts.len(count)
				for let j = 0; j < count; j++ {
					let sum float32[]
					sum.len(width)
					sums.push(sum)
				}
				let changed = 0
				for let i = n * b / tasks; i < n * (b + 1) / tasks; i++ {
					let vector = vectors[i]
					let best = 0
					let least = 0.0
					for let j = 0; j < count; j++ {
						let d = float(apart(vector, nearest[j]))
						if j == 0 || d < least {
							best = j
							least = d
						}
					}
					changed++ when groups[i] != best
					groups[i] = best
					away[i] = least
					counts[best]++
					addScaled(sums[best], vector, float32(1))
				}
				part.sums = sums
				part.counts = counts
				part.changed = changed
			}
			let changed = 0
			let counts int[]
			counts.len(count)
			let sums float32[][]
			for let j = 0; j < count; j++ {
				let sum float32[]
				sum.len(width)
				sums.push(sum)
			}
			for let (_, part) in parts {
				changed += part.changed
				for let j = 0; j < count; j++ {
					counts[j] += part.counts[j]
					addScaled(sums[j], part.sums[j], float32(1))
				}
			}
			break when changed == 0
			for let j = 0; j < count; j++ {
				if counts[j] > 0 {
					let centre float32[]
					centre.len(width)
					addScaled(centre, sums[j], float32(1.0 / float(counts[j])))
					centres[j] = centre
					continue
				}
				// A group left without vectors takes the vector furthest
				// from its own centre.
				let furthest = 0
				for let i = 1; i < n; i++ {
					furthest = i when away[i] > away[furthest]
				}
				away[furthest] = 0.0
				centres[j] = vectors[furthest].clone()
			}
		}
		return new Clusters(centres, groups)
	}
}
