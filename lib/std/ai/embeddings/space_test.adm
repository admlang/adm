partial module std.ai.embeddings {
	use (
		std.math
		std.math::(Random)
		std.math.linalg
		std.math.stats
		std.testing
	)

	check "Embedding space" {
		// `count` vectors of `width` numbers spread along the first axes by
		// the given amounts and by a hundredth of the least along the rest,
		// turned so that no axis of the space is one of theirs, about a
		// centre away from the origin.
		def cloud(count int, width int, spreads float[], seed int) float32[][] {
			let random = new Random(seed)
			let out float32[][]
			for let i = 0; i < count; i++ {
				let row float32[]
				row.len(width)
				for let k = 0; k < width; k++ {
					let spread = k < spreads.len() ?? (spreads[k], spreads[spreads.len() - 1] / 100.0)
					row[k] = float32(random.normal(0.0, spread))
				}
				// Two turns in planes that mix every axis with its neighbours.
				for let k = 0; k + 1 < width; k++ {
					let a = row[k]
					let b = row[k + 1]
					row[k] = a * float32(0.8) - b * float32(0.6)
					row[k + 1] = a * float32(0.6) + b * float32(0.8)
				}
				for let k = 0; k < width; k++ {
					row[k] += float32(3 + k)
				}
				out.push(row)
			}
			return out
		}

		// The components and shares the vectors' covariance gives, widest
		// first: what the search is checked against.
		def reference(vectors float32[][], count int) !(float[][], float[]) {
			let width = vectors[0].len()
			let data = matrix<float>[].size(vectors.len(), width)
			let cells = data.data()
			for let (i, row) in vectors {
				for let k = 0; k < width; k++ {
					cells[i * width + k] = float(row[k])
				}
			}
			let found = try linalg.eigenSymmetric(stats.covarianceMatrix(data))
			let turn = found.vectors.data()
			let total = 0.0
			for let (_, value) in found.values {
				total += value
			}
			let axes float[][]
			let shares float[]
			for let j = 0; j < count; j++ {
				let column = width - 1 - j
				let axis float[]
				for let k = 0; k < width; k++ {
					axis.push(turn[k * width + column])
				}
				axes.push(axis)
				shares.push(found.values[column] / total)
			}
			return (axes, shares)
		}

		def along(a float32[], b float[]) float {
			let sum = 0.0
			for let (i, v) in a {
				sum += float(v) * b[i]
			}
			return sum
		}

		def refused(vectors float32[][], count int) string {
			let message = ""
			principalComponents(vectors, count) onerror (err error) {
				message = err.message
				recover new Projection(float32[], float32[][], float[])
			}
			return message
		}

		@test()
		def TestPrincipalComponents() !none {
			// Few vectors and many, the latter enough for several tasks.
			for let (_, size) in int[][int[40, 12], int[3000, 64]] {
				let vectors = cloud(size[0], size[1], float[5, 2, 1, 0.5], 7)
				let fit = try principalComponents(vectors, 3)
				let (axes, shares) = try reference(vectors, 3)
				assert fit.components.len() == 3 && fit.explained.len() == 3 && fit.centre.len() == size[1]
				for let j = 0; j < 3; j++ {
					// The same direction, either way round, and the same share.
					assert along(fit.components[j], axes[j]).abs() > 0.9999
					assert math.approx(fit.explained[j], shares[j], 1e-4)
					// Unit length, at right angles, the greatest entry positive.
					assert math.approx(float(dot(fit.components[j], fit.components[j])), 1.0, 1e-5)
					for let k = 0; k < j; k++ {
						assert float(dot(fit.components[j], fit.components[k])).abs() < 1e-4
					}
					let greatest = float32(0)
					for let (_, v) in fit.components[j] {
						greatest = v when v.abs() > greatest.abs()
					}
					assert greatest > 0
				}
				assert fit.explained[0] > fit.explained[1] && fit.explained[1] > fit.explained[2]
				// The coordinates: about zero on average, with the spread the
				// share says, and one vector's the same alone as in the list.
				let points = fit.project(vectors)
				assert points.len() == size[0] && points[0].len() == 3
				let mean = 0.0
				let square = 0.0
				for let (_, point) in points {
					mean += float(point[0])
					square += float(point[0]) * float(point[0])
				}
				assert (mean / float(size[0])).abs() < 1e-3
				let alone = fit.project(vectors[5])
				assert math.approx(float(alone[0]), float(points[5][0]), 1e-4) && math.approx(float(alone[2]), float(points[5][2]), 1e-4)
				// The same again: nothing in the search depends on timing.
				let again = try principalComponents(vectors, 3)
				assert again.components[1].equals(fit.components[1]) && again.explained[2] == fit.explained[2]
			}
			// The default is a plane.
			assert (try principalComponents(cloud(30, 8, float[3, 1], 2))).components.len() == 2
			return none
		}

		@test()
		def TestComponentsOfFlatAndFewVectors() !none {
			// Vectors on one line: the first component is the line and keeps
			// everything; a second keeps nothing.
			let line float32[][]
			for let i = 0; i < 20; i++ {
				line.push(float32[float32(i) * 3 + 1, float32(i) * -4 + 2, 5])
			}
			let fit = try principalComponents(line, 2)
			assert math.approx(fit.explained[0], 1.0, 1e-5) && fit.explained[1] < 1e-5
			assert math.approx(float(fit.components[0][0]).abs(), 0.6, 1e-4) && math.approx(float(fit.components[0][1]).abs(), 0.8, 1e-4)
			assert float(fit.components[0][2]).abs() < 1e-4 && fit.components[0][1] > 0
			let ends = fit.project(float32[][line[0], line[19]])
			assert math.approx((float(ends[1][0]) - float(ends[0][0])).abs(), 95.0, 1e-2)
			// A vector off the line is placed by the same map.
			assert math.approx(float(fit.project(float32[1, 2, 9])[0]), float(ends[0][0]), 1e-3)
			// Two vectors, more numbers than vectors, every component asked.
			let pair = try principalComponents(float32[][float32[0, 0, 0, 0], float32[2, 0, 0, 0]], 4)
			assert math.approx(pair.explained[0], 1.0, 1e-6) && pair.explained[3] == 0.0 && pair.components[0][0] > 0.999
			// Vectors that are all one point spread nowhere.
			let still = try principalComponents(float32[][float32[1, 2], float32[1, 2], float32[1, 2]], 1)
			assert still.explained[0] == 0.0 && still.project(float32[1, 2])[0] == 0
			assert refused(float32[][float32[1, 2]], 1).contains("at least 2 vectors")
			assert refused(float32[][float32[1, 2], float32[1]], 1).contains("vector 1 holds 1 numbers")
			assert refused(float32[][float32[1, 2], float32[3, 4]], 3).contains("3 components asked of vectors of 2 numbers")
			assert refused(float32[][float32[1, 2], float32[3, 4]], 0).contains("0 components")
			assert refused(float32[][float32[], float32[]], 1).contains("numbers in them")
			return none
		}

		// `each` vectors around every centre, in the centres' order.
		def blobs(centres float32[][], each int, spread float, seed int) float32[][] {
			let random = new Random(seed)
			let out float32[][]
			for let (_, centre) in centres {
				for let i = 0; i < each; i++ {
					let row float32[]
					for let (_, c) in centre {
						row.push(c + float32(random.normal(0.0, spread)))
					}
					out.push(row)
				}
			}
			return out
		}

		@test()
		def TestClusters() !none {
			for let (_, each) in int[30, 4000] {
				let width = 24
				let middles float32[][]
				for let j = 0; j < 3; j++ {
					let middle float32[]
					middle.len(width)
					middle[j * 5] = 10
					middle[j * 5 + 1] = float32(-4 * j)
					middles.push(middle)
				}
				let vectors = blobs(middles, each, 0.5, 11)
				let found = try clusters(vectors, 3, seed = 4)
				assert found.centres.len() == 3 && found.groups.len() == each * 3
				// Every blob is one group, and the three groups differ.
				for let j = 0; j < 3; j++ {
					let group = found.groups[j * each]
					for let i = 0; i < each; i++ {
						assert found.groups[j * each + i] == group
					}
					// The group's centre is the blob's middle, and a vector
					// there is given that group.
					let centre = found.centres[group]
					for let k = 0; k < width; k++ {
						assert (float(centre[k]) - float(middles[j][k])).abs() < 0.5
					}
					assert found.group(middles[j]) == group
				}
				assert found.groups[0] != found.groups[each] && found.groups[each] != found.groups[2 * each] && found.groups[0] != found.groups[2 * each]
				// One seed, one answer.
				let again = try clusters(vectors, 3, seed = 4)
				assert again.groups.equals(found.groups) && again.centres[2].equals(found.centres[2])
			}
			// One group is all the vectors about their mean; as many groups
			// as vectors is each vector alone.
			let few = float32[][float32[0, 0], float32[2, 0], float32[2, 4], float32[0, 4]]
			let whole = try clusters(few, 1)
			assert whole.groups.equals(int[0, 0, 0, 0]) && whole.centres[0].equals(float32[1, 2])
			let apart = try clusters(few, 4, seed = 9)
			let seen = bool[false, false, false, false]
			for let (i, group) in apart.groups {
				assert !seen[group] && apart.centres[group].equals(few[i])
				seen[group] = true
			}
			// Vectors that repeat still fill every group asked for.
			let same = try clusters(float32[][float32[1, 1], float32[1, 1], float32[1, 1]], 2)
			assert same.centres.len() == 2 && same.groups.len() == 3
			let message = ""
			clusters(few, 5) onerror (err error) {
				message = err.message
				recover new Clusters(float32[][], int[])
			}
			assert message.contains("5 clusters asked of 4 vectors")
			clusters(float32[][], 1) onerror (err error) {
				message = err.message
				recover new Clusters(float32[][], int[])
			}
			assert message.contains("at least 1 vectors")
			return none
		}
	}
}
