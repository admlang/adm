partial module std.ai.llm {
	use (
		std.text.unicode
	)

	// SentencePiece's precompiled normalization map (XLM-R, T5, multilingual
	// e5): a double-array trie (darts-clone units) over UTF-8 byte strings
	// whose leaves point at their replacements, null-ended, in `normalized`.
	internal type Charsmap {
		units      int[]
		normalized byte[]

		def new() {
			units = int[]
			normalized = byte[]
		}

		// Whether the map holds anything.
		def present() bool {
			return units.len() > 0
		}

		// The replacements of the prefixes of `data[from:to]` the trie holds,
		// shortest first, with their lengths: (length, offset) pairs, flat.
		// Stops at a zero byte, as darts-clone does.
		internal def prefixes(data byte[], from int, to int, out int[]) {
			out.len(0)
			return when units.len() == 0
			let node = unitOffset(units[0])
			for let i = from; i < to; i++ {
				let c = int(data[i])
				break when c == 0
				node ^= c
				break when node >= units.len()
				let unit = units[node]
				break when (unit & 0x800000FF) != c
				node ^= unitOffset(unit)
				out.push(i + 1 - from, units[node] & 0x7FFFFFFF) when (unit >> 8) & 1 == 1 && node < units.len()
			}
		}

		// Appends the null-ended replacement at `offset` to `out`.
		internal def emit(offset int, out byte[]) {
			let end = offset
			for end < normalized.len() && normalized[end] != byte(0) {
				end++
			}
			out.push(...normalized[offset:end])
		}

		// `text` normalized as the tokenizers library does (`Precompiled`):
		// each grapheme of fewer than 6 bytes that starts with a key becomes
		// the shortest key's replacement, else each character that starts
		// with one becomes its replacement.
		def byGraphemes(text string) string {
			let data = text.bytes()
			let out byte[]
			let found int[]
			let starts int[]
			let at = 0
			for let (_, ch) in text {
				starts.push(at)
				at += utf8Length(ch)
			}
			starts.push(at)
			let from = 0
			for let (_, end) in unicode.graphemeBreaks(text) {
				let a = starts[from]
				let b = starts[end]
				if b - a < 6 {
					prefixes(data, a, b, found)
					if found.len() > 0 {
						emit(found[1], out)
						from = end
						continue
					}
				}
				for let c = from; c < end; c++ {
					prefixes(data, starts[c], starts[c + 1], found)
					if found.len() > 0 {
						emit(found[1], out)
					} else {
						out.push(...data[starts[c]:starts[c + 1]])
					}
				}
				from = end
			}
			return string(out)
		}

		// `text` normalized as SentencePiece and llama.cpp do: from each
		// position the longest key there is replaced, else one character is
		// kept.
		def byLongest(text string) string {
			let data = text.bytes()
			let out byte[]
			let found int[]
			let i = 0
			for i < data.len() {
				prefixes(data, i, data.len(), found)
				if found.len() > 0 {
					let k = found.len() - 2
					emit(found[k + 1], out)
					i += found[k]
					continue
				}
				let n = utf8Run(data[i])
				let end = (i + n).min(data.len())
				out.push(...data[i:end])
				i = end
			}
			return string(out)
		}
	}

	// The map in `data` as SentencePiece writes it: the trie's size in
	// bytes (32 bits, little-endian), the trie, then the replacements.
	// Fails when the sizes do not add up.
	internal def readCharsmap(data byte[]) !Charsmap {
		let map = new Charsmap()
		return map when data.len() == 0
		fail "llm: the precompiled character map is cut short" when data.len() < 4
		let size = int(data[0]) | (int(data[1]) << 8) | (int(data[2]) << 16) | (int(data[3]) << 24)
		fail "llm: the precompiled character map's trie is {size} bytes, beyond the map's {data.len() - 4}" when size % 4 != 0 || 4 + size > data.len()
		map.units.len(size / 4)
		for let i = 0; i < size / 4; i++ {
			let at = 4 + i * 4
			map.units[i] = int(data[at]) | (int(data[at + 1]) << 8) | (int(data[at + 2]) << 16) | (int(data[at + 3]) << 24)
		}
		map.normalized = data[4 + size:].clone()
		return map
	}

	// darts-clone: where a unit's children start, relative to it.
	internal def unitOffset(unit int) int {
		return (unit >> 10) << ((unit & (1 << 9)) >> 6)
	}

	// Bytes `ch` takes in UTF-8.
	internal def utf8Length(ch char) int {
		let c = int(ch)
		return c < 0x80 ?? (1, c < 0x800 ?? (2, c < 0x10000 ?? (3, 4)))
	}

	// Bytes of the UTF-8 sequence a byte starts; 1 for a stray byte.
	internal def utf8Run(b byte) int {
		let c = int(b)
		return c < 0xC0 ?? (1, c < 0xE0 ?? (2, c < 0xF0 ?? (3, 4)))
	}
}
