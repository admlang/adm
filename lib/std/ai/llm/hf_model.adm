internal partial module std.ai.llm.model {
	use (
		std.os
		std.math
		std.data.encoding::(JSON)
		std.formats.ai
		std.formats.ai::(ModelFile, TensorInfo, TensorType, MetaValue, MetaArray)
		std.ai.llm::(Tokenizer, loadTokenizer)
	)

	// The metadata key that says a llama model's query and key rows are in
	// Hugging Face's order (its RoPE pairs the halves of each head), not in
	// the order llama.cpp's converter permutes them into.
	const hfHalvesKey = "adm.rope.halves"

	// A Hugging Face model folder as the model file `readParts` reads:
	// config.json's numbers under the GGUF keys llama.cpp writes, the
	// safetensors tensors under llama.cpp's names (taken from their shards
	// without copies), and what llama.cpp's converter changes on the way:
	// Gemma's norms stored plus one, the experts of a mixture stacked into
	// one tensor per projection, Llama 3's RoPE frequencies as factors. The
	// tokenizer and chat template come from tokenizer.json and
	// tokenizer_config.json. Reads Llama (and Mistral), Qwen2, Qwen3,
	// Qwen3-MoE, Gemma 2, Gemma 3 and Phi-3.
	// Fails when the folder holds no config.json or safetensors, names
	// another architecture, or a file cannot be read.
	def readHfFolder(folder string) !(ModelFile, Tokenizer) {
		let top = try jsonObject(os.join(folder, "config.json"))
		let kind = firstString(top.get("architectures"))
		// Gemma 3's multimodal models keep the language model's numbers in
		// text_config.
		let nested = top.get("text_config")
		let config = nested is map<string, any> ?? (nested, top)
		let arch = try archOf(kind)
		let out = new ModelFile()
		let set = def (key string, value ?any) {
			if value is int {
				out.metadata.set(key, value)
			} else if value is float {
				out.metadata.set(key, value)
			} else if value is string {
				out.metadata.set(key, value)
			} else if value is bool {
				out.metadata.set(key, value)
			}
		}
		set("general.architecture", arch)
		set("general.name", os.base(folder))
		let layers = intOf(config.get("num_hidden_layers"), 0)
		let heads = intOf(config.get("num_attention_heads"), 0)
		let width = intOf(config.get("hidden_size"), 0)
		fail "llm: {folder}/config.json lacks num_hidden_layers, num_attention_heads or hidden_size" when layers == 0 || heads == 0 || width == 0
		set(arch + ".block_count", layers)
		set(arch + ".embedding_length", width)
		set(arch + ".attention.head_count", heads)
		set(arch + ".attention.head_count_kv", intOf(config.get("num_key_value_heads"), heads))
		set(arch + ".feed_forward_length", intOf(config.get("intermediate_size"), 0))
		set(arch + ".context_length", intOf(config.get("max_position_embeddings"), 2048))
		let headDim = intOf(config.get("head_dim"), 0)
		set(arch + ".attention.key_length", headDim) when headDim > 0
		set(arch + ".attention.value_length", headDim) when headDim > 0
		set(arch + ".rope.freq_base", floatOf(config.get("rope_theta"), 10000.0))
		set(arch + ".attention.layer_norm_rms_epsilon", floatOf(config.get("rms_norm_eps"), 0.00001))
		let experts = intOf(config.get("num_experts"), 0)
		if experts > 0 {
			set(arch + ".expert_count", experts)
			set(arch + ".expert_used_count", intOf(config.get("num_experts_per_tok"), 0))
			set(arch + ".expert_feed_forward_length", intOf(config.get("moe_intermediate_size"), 0))
		}
		let window = config.get("sliding_window")
		let windowed = config.get("use_sliding_window")
		set(arch + ".attention.sliding_window", window) when window is int && !(windowed is bool && !windowed)
		// Floats a config may write as whole numbers (30 for 30.0).
		for let (_, pair) in [("final_logit_softcapping", ".final_logit_softcapping"), ("attn_logit_softcapping", ".attn_logit_softcapping"), ("rope_local_base_freq", ".rope.freq_base_swa")] {
			let (field, key) = pair
			let value = config.get(field)
			set(arch + key, floatOf(value, 0.0)) when value is int || value is float
		}
		let layerTypes = config.get("layer_types")
		if layerTypes is any[] && layerTypes.len() == layers {
			// Gemma 3: the layers that slide, as Gemma 4's files list them.
			let flags MetaValue[]
			for let (_, t) in layerTypes {
				flags.push(t is string && t == "sliding_attention")
			}
			out.metadata.set(arch + ".attention.sliding_window_pattern", new MetaArray(flags))
		} else {
			set(arch + ".attention.sliding_window_pattern", config.get("sliding_window_pattern"))
		}
		// Hugging Face's query and key rows pair the halves of each head.
		out.metadata.set(hfHalvesKey, true) when arch == "llama"

		let shards = try shardsOf(folder)
		let files ModelFile[]
		for let (_, path) in shards {
			files.push(try ai.load(path))
		}
		let gemma = arch := "gemma2" || "gemma3"
		let stacked = new map<string, ModelFile>()
		for let (_, file) in files {
			for let (_, t) in file.tensors {
				let name = hfTensorName(t.name, gemma)
				continue when name.len() == 0
				if name.contains(".experts.") {
					// Gathered below, one stack per layer and projection.
					stacked.set(t.name, file)
					continue
				}
				if gemma && name.endsWith("norm.weight") {
					// llama.cpp stores Gemma's RMSNorm weights plus one.
					let values = try file.readFloats(t.name)
					for let i = 0; i < values.len(); i++ {
						values[i] += float32(1)
					}
					try out.add(TensorInfo{name: name, kind: TensorType.F32, shape: t.shape}, floatBytes(values))
					continue
				}
				try out.adopt(file, t.name, name)
			}
		}
		if experts > 0 {
			try stackExperts(out, stacked, layers, experts)
		}
		try addRopeFactors(out, config, arch, headDim > 0 ?? (headDim, width / heads))
		try addLongRope(out, config, arch)
		let tokenizer = try loadTokenizer(folder)
		let template = try chatTemplateOf(folder)
		out.metadata.set("tokenizer.chat_template", template) when template.len() > 0
		return (out, tokenizer)
	}

	// The GGUF architecture of a Hugging Face model class.
	// Fails for a class this does not read.
	internal def archOf(kind string) !string {
		match kind {
			case "LlamaForCausalLM", "MistralForCausalLM":
				return "llama"
			case "Qwen2ForCausalLM":
				return "qwen2"
			case "Qwen3ForCausalLM":
				return "qwen3"
			case "Qwen3MoeForCausalLM":
				return "qwen3moe"
			case "Gemma2ForCausalLM":
				return "gemma2"
			case "Gemma3ForCausalLM", "Gemma3ForConditionalGeneration":
				return "gemma3"
			case "Phi3ForCausalLM":
				return "phi3"
			default:
				fail "llm: Hugging Face models of class {kind} are not read; convert it to GGUF (llama.cpp's convert_hf_to_gguf.py)"
		}
	}

	// llama.cpp's name of a Hugging Face tensor; "" for one the language
	// model does not use (vision and audio towers, projectors).
	internal def hfTensorName(given string, gemma bool) string {
		let name = given
		for let (_, prefix) in string["model.language_model.", "language_model.model.", "language_model."] {
			if name.startsWith(prefix) {
				name = "model." + name.slice(prefix.len())
				break
			}
		}
		return "" when name.contains("vision") || name.contains("multi_modal") || name.contains("audio")
		match name {
			case "model.embed_tokens.weight":
				return "token_embd.weight"
			case "model.norm.weight":
				return "output_norm.weight"
			case "lm_head.weight":
				return "output.weight"
			default:
		}
		return "" unless name.startsWith("model.layers.")
		let rest = name.slice("model.layers.".len())
		let dot = rest.indexOf(".")
		return "" when dot <= 0
		let layer = rest.slice(0, dot)
		let part = rest.slice(dot + 1)
		let p = "blk.{layer}."
		if part.startsWith("mlp.experts.") {
			// Kept under its own name until the stacking.
			return p + part
		}
		match part {
			case "input_layernorm.weight":
				return p + "attn_norm.weight"
			case "post_attention_layernorm.weight":
				// Gemma norms the attention's output there; the others the
				// feed-forward's input.
				return p + (gemma ?? ("post_attention_norm.weight", "ffn_norm.weight"))
			case "pre_feedforward_layernorm.weight":
				return p + "ffn_norm.weight"
			case "post_feedforward_layernorm.weight":
				return p + "post_ffw_norm.weight"
			case "self_attn.q_proj.weight":
				return p + "attn_q.weight"
			case "self_attn.k_proj.weight":
				return p + "attn_k.weight"
			case "self_attn.v_proj.weight":
				return p + "attn_v.weight"
			case "self_attn.q_proj.bias":
				return p + "attn_q.bias"
			case "self_attn.k_proj.bias":
				return p + "attn_k.bias"
			case "self_attn.v_proj.bias":
				return p + "attn_v.bias"
			case "self_attn.o_proj.weight":
				return p + "attn_output.weight"
			case "self_attn.qkv_proj.weight":
				return p + "attn_qkv.weight"
			case "self_attn.q_norm.weight":
				return p + "attn_q_norm.weight"
			case "self_attn.k_norm.weight":
				return p + "attn_k_norm.weight"
			case "mlp.gate_proj.weight":
				return p + "ffn_gate.weight"
			case "mlp.up_proj.weight":
				return p + "ffn_up.weight"
			case "mlp.down_proj.weight":
				return p + "ffn_down.weight"
			case "mlp.gate_up_proj.weight":
				return p + "ffn_up.weight"
			case "mlp.gate.weight":
				return p + "ffn_gate_inp.weight"
			default:
				return ""
		}
	}

	// The experts' matrices stacked per layer and projection, the first
	// expert first, as llama.cpp's ffn_gate_exps, ffn_up_exps and
	// ffn_down_exps.
	// Fails when an expert's matrix is missing or differs in type or shape.
	internal def stackExperts(out ModelFile, found map<string, ModelFile>, layers int, experts int) !none {
		let projections = string["gate_proj", "up_proj", "down_proj"]
		let names = string["ffn_gate_exps", "ffn_up_exps", "ffn_down_exps"]
		for let n = 0; n < layers; n++ {
			for let (k, projection) in projections {
				let first = "model.layers.{n}.mlp.experts.0.{projection}.weight"
				let firstFile = expertFile(found, first)
				continue when firstFile is none
				let info = firstFile.tensor(expertSource(found, first))
				fail "llm: the expert matrix {first} is missing" when info is none
				let data byte[]
				for let e = 0; e < experts; e++ {
					let name = "model.layers.{n}.mlp.experts.{e}.{projection}.weight"
					let file = expertFile(found, name)
					fail "llm: the expert matrix {name} is missing" when file is none
					let source = expertSource(found, name)
					let t = file.tensor(source)
					fail "llm: {name} differs from the first expert's matrix" unless !(t is none) && t.kind == info.kind && t.shape.equals(info.shape)
					data.push(...(try file.read(source)))
				}
				let shape = info.shape.clone()
				shape.push(experts)
				try out.add(TensorInfo{name: "blk.{n}.{names[k]}.weight", kind: info.kind, shape: shape}, data)
			}
		}
		return none
	}

	// The shard holding an expert's matrix, under any of the prefixes a
	// checkpoint puts before the model's names.
	internal def expertFile(found map<string, ModelFile>, name string) ?ModelFile {
		let source = expertSource(found, name)
		return found.get(source)
	}

	internal def expertSource(found map<string, ModelFile>, name string) string {
		return name unless found.get(name) is none
		let bare = name.slice("model.".len())
		for let (_, prefix) in string["model.language_model.", "language_model.model."] {
			return prefix + bare unless found.get(prefix + bare) is none
		}
		return name
	}

	// Llama 3's RoPE scaling as llama.cpp keeps it: a factor per pair of
	// each head, in `rope_freqs.weight`; linear and YaRN scaling as keys.
	internal def addRopeFactors(out ModelFile, config map<string, any>, arch string, headSize int) !none {
		let scaling = config.get("rope_scaling")
		return none unless scaling is map<string, any>
		let kind = textOf(scaling.get("rope_type"), textOf(scaling.get("type"), ""))
		let factor = floatOf(scaling.get("factor"), 1.0)
		match kind {
			case "linear":
				out.metadata.set(arch + ".rope.scaling.type", "linear")
				out.metadata.set(arch + ".rope.scaling.factor", factor)
			case "yarn":
				out.metadata.set(arch + ".rope.scaling.type", "yarn")
				out.metadata.set(arch + ".rope.scaling.factor", factor)
				out.metadata.set(arch + ".rope.scaling.original_context_length", intOf(scaling.get("original_max_position_embeddings"), 0))
			case "llama3":
				let base = floatOf(config.get("rope_theta"), 10000.0)
				let low = floatOf(scaling.get("low_freq_factor"), 1.0)
				let high = floatOf(scaling.get("high_freq_factor"), 4.0)
				let original = float(intOf(scaling.get("original_max_position_embeddings"), 8192))
				let lowWave = original / low
				let highWave = original / high
				let factors float32[]
				for let i = 0; i < headSize; i += 2 {
					let frequency = 1.0 / base ** (float(i) / float(headSize))
					let wave = 2.0 * math.Pi / frequency
					if wave < highWave {
						factors.push(float32(1))
					} else if wave > lowWave {
						factors.push(float32(factor))
					} else {
						let smooth = (original / wave - low) / (high - low)
						factors.push(float32(1.0 / ((1.0 - smooth) / factor + smooth)))
					}
				}
				try out.add(TensorInfo{name: "rope_freqs.weight", kind: TensorType.F32, shape: [factors.len()]}, floatBytes(factors))
			default:
		}
		return none
	}

	// Phi-3's long RoPE: its short and long factors as tensors, the
	// original context and the attention factor as keys.
	internal def addLongRope(out ModelFile, config map<string, any>, arch string) !none {
		let scaling = config.get("rope_scaling")
		return none unless scaling is map<string, any>
		return none unless textOf(scaling.get("type"), textOf(scaling.get("rope_type"), "")) == "longrope"
		let original = intOf(config.get("original_max_position_embeddings"), 4096)
		let context = intOf(config.get("max_position_embeddings"), original)
		out.metadata.set(arch + ".rope.scaling.type", "longrope")
		out.metadata.set(arch + ".rope.scaling.original_context_length", original)
		let scale = float(context) / float(original)
		out.metadata.set(arch + ".rope.scaling.attn_factor", scale <= 1.0 ?? (1.0, math.sqrt(1.0 + math.ln(scale) / math.ln(float(original)))))
		for let (_, pair) in [("short_factor", "rope_factors_short.weight"), ("long_factor", "rope_factors_long.weight")] {
			let (key, name) = pair
			let list = scaling.get(key)
			continue unless list is any[]
			let values float32[]
			for let (_, v) in list {
				values.push(float32(floatOf(v, 1.0)))
			}
			try out.add(TensorInfo{name: name, kind: TensorType.F32, shape: [values.len()]}, floatBytes(values))
		}
		return none
	}

	// The safetensors files of a folder: its index's shards, else
	// model.safetensors.
	// Fails when there are none.
	internal def shardsOf(folder string) !string[] {
		let index = os.join(folder, "model.safetensors.index.json")
		if try os.exists(index) {
			let map = (try jsonObject(index)).get("weight_map")
			fail "llm: {index} has no weight_map" unless map is map<string, any>
			let out string[]
			for let (_, file) in map {
				let path = file is string ?? (os.join(folder, file), "")
				out.push(path) when path.len() > 0 && !out.includes(path)
			}
			return out.sort((a, b) => a.compare(b))
		}
		let single = os.join(folder, "model.safetensors")
		fail "llm: {folder} holds no model.safetensors and no shard index" unless try os.exists(single)
		return [single]
	}

	// The chat template of a folder: tokenizer_config.json's (a named
	// list's "default"), else chat_template.jinja; "" for none.
	internal def chatTemplateOf(folder string) !string {
		let config = os.join(folder, "tokenizer_config.json")
		if try os.exists(config) {
			let given = (try jsonObject(config)).get("chat_template")
			return given when given is string
			if given is any[] {
				for let (_, entry) in given {
					continue unless entry is map<string, any>
					let name = entry.get("name")
					let template = entry.get("template")
					return template when name is string && name == "default" && template is string
				}
			}
		}
		let jinja = os.join(folder, "chat_template.jinja")
		return (try os.exists(jinja)) ?? (string(try os.readFile(jinja)), "")
	}

	internal def jsonObject(path string) !map<string, any> {
		let parsed = try (new JSON()).parse(try os.readFile(path))
		fail "llm: {path} is not a JSON object" unless parsed is map<string, any>
		return parsed
	}

	internal def firstString(v ?any) string {
		return "" unless v is any[] && v.len() > 0
		let first = v[0]
		return first is string ?? (first, "")
	}

	internal def intOf(v ?any, otherwise int) int {
		return v when v is int
		return int(v) when v is float
		return otherwise
	}

	internal def floatOf(v ?any, otherwise float) float {
		return v when v is float
		return float(v) when v is int
		return otherwise
	}

	internal def textOf(v ?any, otherwise string) string {
		return v is string ?? (v, otherwise)
	}
}
