partial module std.ai.llm {
	use (
		std.testing
		std.os
		std.data.encoding::(JSON)
		std.formats.ai
		std.formats.ai::(ModelFile, TensorInfo, TensorType)
		std.ai.llm.model::(readParts, readHfFolder, ForwardState)
		std.ai.llm.testmodels::*
		std.services.runtime::(Runtime)
	)

	// A Hugging Face folder made from a tiny GGUF model reads into the same
	// model: its tokenizer gives the same ids and its logits match.
	check "Hugging Face models" {
		// The Hugging Face name of a llama.cpp tensor, and for an expert
		// stack the name with "{e}" where the expert's number goes.
		internal def hfName(name string, gemma bool) string {
			match name {
				case "token_embd.weight":
					return "model.embed_tokens.weight"
				case "output_norm.weight":
					return "model.norm.weight"
				case "output.weight":
					return "lm_head.weight"
				default:
			}
			let rest = name.slice("blk.".len())
			let dot = rest.indexOf(".")
			let p = "model.layers.{rest.slice(0, dot)}."
			match rest.slice(dot + 1) {
				case "attn_norm.weight":
					return p + "input_layernorm.weight"
				case "ffn_norm.weight":
					return p + (gemma ?? ("pre_feedforward_layernorm.weight", "post_attention_layernorm.weight"))
				case "post_attention_norm.weight":
					return p + "post_attention_layernorm.weight"
				case "post_ffw_norm.weight":
					return p + "post_feedforward_layernorm.weight"
				case "attn_q.weight":
					return p + "self_attn.q_proj.weight"
				case "attn_k.weight":
					return p + "self_attn.k_proj.weight"
				case "attn_v.weight":
					return p + "self_attn.v_proj.weight"
				case "attn_output.weight":
					return p + "self_attn.o_proj.weight"
				case "attn_q_norm.weight":
					return p + "self_attn.q_norm.weight"
				case "attn_k_norm.weight":
					return p + "self_attn.k_norm.weight"
				case "ffn_gate.weight":
					return p + "mlp.gate_proj.weight"
				case "ffn_up.weight":
					return p + "mlp.up_proj.weight"
				case "ffn_down.weight":
					return p + "mlp.down_proj.weight"
				case "ffn_gate_inp.weight":
					return p + "mlp.gate.weight"
				case "ffn_gate_exps.weight":
					return p + "mlp.experts.\{e}.gate_proj.weight"
				case "ffn_up_exps.weight":
					return p + "mlp.experts.\{e}.up_proj.weight"
				case "ffn_down_exps.weight":
					return p + "mlp.experts.\{e}.down_proj.weight"
				default:
					return ""
			}
		}

		internal def bytesOf(values float32[]) byte[] {
			let out byte[]
			for let (_, v) in values {
				put(out, int(__bitcast_u32_from_f32(v)), 4)
			}
			return out
		}

		// The rows of a llama query or key matrix in Hugging Face's order:
		// llama.cpp's converter moves row i of each head's first half to
		// 2i and row i of its second half to 2i + 1.
		internal def unpermuted(data byte[], t TensorInfo, heads int) byte[] {
			let row = t.shape[0] * 4
			let size = t.shape[1] / heads
			let half = size / 2
			let out byte[]
			out.len(data.len())
			for let h = 0; h < heads; h++ {
				for let s = 0; s < 2; s++ {
					for let i = 0; i < half; i++ {
						let from = (h * size + 2 * i + s) * row
						let to = (h * size + s * half + i) * row
						for let b = 0; b < row; b++ {
							out[to + b] = data[from + b]
						}
					}
				}
			}
			return out
		}

		// The Hugging Face folder of `kind` that llama.cpp's converter
		// would turn into the GGUF file `gguf`: its tensors under their
		// Hugging Face names (a llama model's query and key rows unpermuted,
		// Gemma's norms less one, each expert's matrix on its own),
		// config.json from its numbers, and a byte-level tokenizer.json of
		// its vocabulary.
		internal def hfTwin(gguf string, kind string) !string {
			// The name says everything the files follow from: a folder written
			// before is the same, and a model still loaded may map its
			// tensors, which Windows lets nobody rewrite. tokenizer.json is
			// written last.
			let folder = os.join(try os.appHome(), "hf-" + os.base(gguf).replace(".gguf", "") + "-" + kind)
			return folder when try os.exists(os.join(folder, "tokenizer.json"))
			let file = try ai.load(gguf)
			defer file.close()
			let arch = file.getString("general.architecture")
			fail "{gguf} names no architecture" when arch is none
			let gemma = arch == "gemma3"
			let heads = file.getInt(arch + ".attention.head_count")
			let kvHeads = file.getInt(arch + ".attention.head_count_kv")
			let layers = file.getInt(arch + ".block_count")
			let width = file.getInt(arch + ".embedding_length")
			let context = file.getInt(arch + ".context_length")
			fail "{gguf} lacks the layer and head numbers" when heads is none || kvHeads is none || layers is none || width is none || context is none
			let experts = file.getInt(arch + ".expert_count")
			let out = new ModelFile()
			for let (_, t) in file.tensors {
				let name = hfName(t.name, gemma)
				fail "{t.name} has no Hugging Face name" when name.len() == 0
				let data = try file.read(t.name)
				if t.name.endsWith("_exps.weight") {
					let count = t.shape[2]
					let each = data.len() / count
					for let e = 0; e < count; e++ {
						try out.add(TensorInfo{name: name.replace("\{e}", "{e}"), kind: t.kind, shape: int[t.shape[0], t.shape[1]]}, data[e * each:(e + 1) * each].clone())
					}
					continue
				}
				if gemma && t.name.endsWith("norm.weight") {
					let values = try file.readFloats(t.name)
					for let i = 0; i < values.len(); i++ {
						values[i] -= float32(1)
					}
					data = bytesOf(values)
				}
				if arch == "llama" && t.name.endsWith("attn_q.weight") {
					data = unpermuted(data, t, heads)
				} else if arch == "llama" && t.name.endsWith("attn_k.weight") {
					data = unpermuted(data, t, kvHeads)
				}
				try out.add(TensorInfo{name: name, kind: t.kind, shape: t.shape.clone()}, data)
			}
			try os.mkdir(folder, true) unless try os.exists(folder)
			try out.save(os.join(folder, "model.safetensors"))

			let config = map<string, any>{"architectures": any[kind], "num_hidden_layers": layers, "num_attention_heads": heads, "num_key_value_heads": kvHeads, "hidden_size": width, "intermediate_size": 32, "max_position_embeddings": context, "rms_norm_eps": 0.00001, "rope_theta": 10000.0}
			config.set("head_dim", file.getInt(arch + ".attention.key_length")) unless file.getInt(arch + ".attention.key_length") is none
			config.set("sliding_window", file.getInt(arch + ".attention.sliding_window")) unless file.getInt(arch + ".attention.sliding_window") is none
			config.set("final_logit_softcapping", file.getFloat(arch + ".final_logit_softcapping")) unless file.getFloat(arch + ".final_logit_softcapping") is none
			if !(experts is none) {
				config.set("num_experts", experts)
				config.set("num_experts_per_tok", file.getInt(arch + ".expert_used_count"))
				config.set("moe_intermediate_size", 32)
			}
			try os.writeFile(os.join(folder, "config.json"), (new JSON()).encode(config))

			let vocab = new map<string, any>()
			let added any[] = []
			for let (id, token) in file.getStrings("tokenizer.ggml.tokens") {
				vocab.set(token, id)
				added.push(map<string, any>{"id": id, "content": token, "single_word": false, "lstrip": false, "rstrip": false, "normalized": false, "special": true}) when token.startsWith("<|")
			}
			let merges any[] = []
			for let (_, merge) in file.getStrings("tokenizer.ggml.merges") {
				let parts = merge.split(" ")
				merges.push(any[parts[0], parts[1]])
			}
			let byteLevel = map<string, any>{"type": "ByteLevel", "add_prefix_space": false, "trim_offsets": true, "use_regex": true}
			let tokenizer = map<string, any>{"version": "1.0", "added_tokens": added, "normalizer": none, "pre_tokenizer": byteLevel, "post_processor": none, "decoder": byteLevel, "model": map<string, any>{"type": "BPE", "vocab": vocab, "merges": merges}}
			try os.writeFile(os.join(folder, "tokenizer.json"), (new JSON()).encode(tokenizer))
			return folder
		}

		// The GGUF model and its Hugging Face twin of `kind` give the same
		// ids and logits for a few prompts.
		internal def agree(gguf string, kind string) !none {
			let twin = try hfTwin(gguf, kind)
			let (file, tokenizer) = try readHfFolder(twin)
			let hf = try readParts(file, tokenizer)
			let native = try readParts(try ai.load(gguf))
			assert hf.info.architecture == native.info.architecture && hf.info.layers == native.info.layers && hf.info.parameters == native.info.parameters
			for let (_, prompt) in string["ab a ab!12 ab a b", "1a2b!ba21 aab ab1"] {
				let tokens = native.tokenizer.encode(prompt, false)
				let theirs = hf.tokenizer.encode(prompt, false)
				fail "{kind}: ids {theirs}, the GGUF tokenizer gives {tokens}" unless theirs.equals(tokens)
				assert hf.tokenizer.decode(tokens) == prompt
				let (one, two) = (new ForwardState(native, 64), new ForwardState(hf, 64))
				try one.forward(tokens, 0)
				try two.forward(tokens, 0)
				for let (k, want) in one.logits {
					fail "{kind}, logit {k}: {two.logits[k]} from the folder, {want} from the GGUF file" unless (two.logits[k] - want).abs() <= float32(0.00001) * want.abs().max(float32(1))
				}
			}
			return none
		}

		// Two llama layers: the query and key rows in Hugging Face's order
		// turn with RoPE over each head's halves.
		@test()
		def llama() !none {
			return try agree(try tinyModel("llama", 0, 2), "LlamaForCausalLM")
		}

		// Gemma 3: norms stored less one, 8-value heads, a sliding window and
		// capped logits.
		@test()
		def gemma3() !none {
			return try agree(try tinyModel("gemma3"), "Gemma3ForCausalLM")
		}

		// Qwen 3 MoE: three experts' matrices stacked per projection.
		@test()
		def qwen3moe() !none {
			return try agree(try tinyModel("qwen3moe", 3), "Qwen3MoeForCausalLM")
		}

		// `load` reads a folder, and generates as the GGUF file does.
		@test()
		def loadFolder() !none {
			let path = try tinyModel("llama", 0, 2)
			let twin = try hfTwin(path, "LlamaForCausalLM")
			let texts string[]
			for let (_, source) in string[path, twin] {
				let chat = (try load(source, Device.Cpu)).session()
				chat.temperature = 0.0
				chat.repeatPenalty = 1.0
				chat.limit = 8
				texts.push(try chat.generate("ab a ab"))
			}
			fail "the folder generates [{texts[1]}], the GGUF file [{texts[0]}]" unless texts[0] == texts[1]
			return none
		}

		// With ADM_TEST_HF_MODEL naming Qwen3 0.6B's Hugging Face folder:
		// it continues a sentence as transformers does (greedy, no penalty).
		@test()
		def realFolder() !none {
			let path = Runtime.getEnv("ADM_TEST_HF_MODEL")
			return none when path is none || path.len() == 0
			let chat = (try load(path)).session()
			chat.temperature = 0.0
			chat.repeatPenalty = 1.0
			chat.limit = 8
			let text = try chat.generate("The capital of France is")
			fail "the folder continues with [{text}]" unless text.startsWith(" Paris. The capital of Italy is Rome")
			return none
		}

		// A model class it does not read names llama.cpp's converter.
		@test()
		def otherClass() !none {
			let twin = try hfTwin(try tinyModel("llama"), "FalconForCausalLM")
			readHfFolder(twin) onerror (err error) {
				fail "the refusal says [{err}]" unless "{err}".contains("convert_hf_to_gguf.py")
				return none
			}
			fail "a FalconForCausalLM folder was read"
		}
	}
}
