partial module std.ai.llm {
	use (
		std.os
		std.data.encoding::(JSON)
		std.text.unicode
		std.text.unicode::(NormalForm, Category)
		std.formats.ai::(ModelFile)
		std.ai.llm.text::*
	)

	// Reads a Hugging Face tokenizer: `path` is a tokenizer.json file or a
	// folder holding one, or else the files of an older tokenizer class
	// (vocab.json and merges.txt for GPT-2, Whisper, RoBERTa and CLIP,
	// vocab.txt for BERT) with its tokenizer_config.json. Normalizers,
	// pre-tokenizers, the BPE, WordPiece, WordLevel and Unigram models,
	// post-processors and decoders follow the tokenizers library.
	// Fails when no tokenizer files are found or they use a part this
	// does not know.
	def loadTokenizer(path string) !Tokenizer {
		let isFolder = (try os.stat(path, true)).isDir
		let folder = isFolder ?? (path, os.dir(path))
		let file = isFolder ?? (os.join(path, "tokenizer.json"), path)
		if try os.exists(file) {
			let doc = try new JSON().parse(try os.readFile(file))
			fail "llm: {file} is not a JSON object" unless doc is map<string, any>
			return try hfTokenizer(doc)
		}
		let config = try configOf(folder)
		if (try os.exists(os.join(folder, "vocab.json"))) && (try os.exists(os.join(folder, "merges.txt"))) {
			return try legacyBytePairs(folder, config)
		}
		if try os.exists(os.join(folder, "vocab.txt")) {
			return try legacyWordPiece(folder, config)
		}
		fail "llm: no tokenizer.json, vocab.json with merges.txt, or vocab.txt in {folder}"
	}

	// tokenizer_config.json of `folder`, empty when there is none.
	internal def configOf(folder string) !map<string, any> {
		let file = os.join(folder, "tokenizer_config.json")
		return new map<string, any>() unless try os.exists(file)
		let doc = try new JSON().parse(try os.readFile(file))
		fail "llm: {file} is not a JSON object" unless doc is map<string, any>
		return doc
	}

	// A tokenizer from a parsed tokenizer.json.
	internal def hfTokenizer(doc map<string, any>) !Tokenizer {
		let model = objectAt(doc, "model")
		fail "llm: tokenizer.json has no model" when model is none
		let pipe = new HfPipeline()
		try pipe.readModel(model)
		for let (_, entry) in listAt(doc, "added_tokens") {
			continue unless entry is map<string, any>
			let id = intAt(entry, "id", -1)
			let content = textAt(entry, "content", "")
			continue when id < 0 || content.len() == 0
			pipe.place(id, content, boolAt(entry, "special", false) ?? (3, 4))
		}
		pipe.normalizers = try normalizersOf(doc.get("normalizer"))
		pipe.splits = try splitsOf(doc.get("pre_tokenizer"))
		try pipe.readPost(doc.get("post_processor"))
		pipe.decoders = try decodersOf(doc.get("decoder"))
		return new Tokenizer(pipe)
	}

	// vocab.json and merges.txt of a GPT-2-style byte-level BPE, or of CLIP's
	// BPE (lower-cased words ending in </w>) when the config names it.
	internal def legacyBytePairs(folder string, config map<string, any>) !Tokenizer {
		let vocab = try new JSON().parse(try os.readFile(os.join(folder, "vocab.json")))
		fail "llm: vocab.json is not a JSON object" unless vocab is map<string, any>
		let merges string[]
		for let (n, line) in string(try os.readFile(os.join(folder, "merges.txt"))).split("\n") {
			let pair = line.trimEnd("\r")
			continue when pair.len() == 0 || (n == 0 && pair.startsWith("#version"))
			merges.push(pair)
		}
		let kind = textAt(config, "tokenizer_class", "")
		let clip = kind.startsWith("CLIP")
		let model = new map<string, any>()
		model.set("type", "BPE")
		model.set("vocab", vocab)
		let mergeList any[]
		for let (_, m) in merges {
			mergeList.push(m)
		}
		model.set("merges", mergeList)
		let pipe = new HfPipeline()
		if clip {
			model.set("end_of_word_suffix", "</w>")
			model.set("unk_token", "<|endoftext|>")
			try pipe.readModel(model)
			pipe.normalizers = [NormalStep{kind: NormalKind.Nfc}, NormalStep{kind: NormalKind.Collapse}, NormalStep{kind: NormalKind.Lowercase}]
			pipe.splits = [
				SplitStep{kind: SplitKind.Pattern, pattern: /<\|startoftext\|>|<\|endoftext\|>|'s|'t|'re|'ve|'m|'ll|'d|[\p{L}]+|[\p{N}]|[^\s\p{L}\p{N}]+/i, behavior: SplitBehavior.Removed, invert: true},
				SplitStep{kind: SplitKind.ByteLevel}
			]
			pipe.decoders = [DecodeStep{kind: DecodeKind.ByteLevel}, DecodeStep{kind: DecodeKind.Suffix, text: "</w>"}]
			let bos = pipe.idOf("<|startoftext|>")
			let eos = pipe.idOf("<|endoftext|>")
			pipe.before = bos >= 0 ?? (int[bos], int[])
			pipe.after = eos >= 0 ?? (int[eos], int[])
		} else {
			try pipe.readModel(model)
			pipe.splits = [SplitStep{kind: SplitKind.ByteLevel, prefixSpace: boolAt(config, "add_prefix_space", false), gpt2: true}]
			pipe.decoders = [DecodeStep{kind: DecodeKind.ByteLevel}]
		}
		try addedFromConfig(pipe, folder, config)
		return new Tokenizer(pipe)
	}

	// vocab.txt of a BERT WordPiece tokenizer.
	internal def legacyWordPiece(folder string, config map<string, any>) !Tokenizer {
		let vocab = new map<string, any>()
		for let (n, line) in string(try os.readFile(os.join(folder, "vocab.txt"))).split("\n") {
			let piece = line.trimEnd("\r")
			continue when piece.len() == 0
			vocab.set(piece, n)
		}
		let model = new map<string, any>()
		model.set("type", "WordPiece")
		model.set("vocab", vocab)
		model.set("unk_token", textAt(config, "unk_token", "[UNK]"))
		let pipe = new HfPipeline()
		try pipe.readModel(model)
		let lower = boolAt(config, "do_lower_case", true)
		pipe.normalizers = [NormalStep{kind: NormalKind.Bert, flags: bool[true, boolAt(config, "tokenize_chinese_chars", true), lower, lower]}]
		pipe.splits = [SplitStep{kind: SplitKind.Bert}]
		pipe.decoders = [DecodeStep{kind: DecodeKind.WordPiece, text: "##", flag: true}]
		let cls = pipe.idOf(textAt(config, "cls_token", "[CLS]"))
		let sep = pipe.idOf(textAt(config, "sep_token", "[SEP]"))
		pipe.before = cls >= 0 ?? (int[cls], int[])
		pipe.after = sep >= 0 ?? (int[sep], int[])
		for let (_, name) in string["[PAD]", "[UNK]", "[CLS]", "[SEP]", "[MASK]"] {
			let id = pipe.idOf(name)
			pipe.place(id, name, 3) when id >= 0
		}
		return new Tokenizer(pipe)
	}

	// BERT's WordPiece from a GGUF file's vocabulary, as llama.cpp reads it:
	// lower case with accents stripped, punctuation and CJK characters set
	// apart, [CLS] and [SEP] around the text.
	internal def ggufWordPiece(file ModelFile) !Tokenizer {
		let pipe = new HfPipeline()
		let vocab = new map<string, any>()
		for let (id, piece) in file.getStrings("tokenizer.ggml.tokens") {
			vocab.set(piece, id)
		}
		let model = new map<string, any>()
		model.set("type", "WordPiece")
		model.set("vocab", vocab)
		let unknown = file.getInt("tokenizer.ggml.unknown_token_id")
		let tokens = file.getStrings("tokenizer.ggml.tokens")
		model.set("unk_token", unknown is int && unknown < tokens.len() ?? (tokens[unknown], "[UNK]"))
		try pipe.readModel(model)
		// llama.cpp stores the vocabulary with ▁ before a word's first piece
		// and continuing pieces bare.
		pipe.prefix = ""
		pipe.wordStart = "▁"
		pipe.normalizers = [NormalStep{kind: NormalKind.Bert, flags: bool[true, true, true, true]}]
		pipe.splits = [SplitStep{kind: SplitKind.Bert}]
		pipe.decoders = [DecodeStep{kind: DecodeKind.Metaspace, text: "▁", flag: true}]
		let cls = file.getInt("tokenizer.ggml.cls_token_id")
		let sep = file.getInt("tokenizer.ggml.seperator_token_id")
		pipe.before = cls is int ?? (int[cls], int[])
		pipe.after = sep is int ?? (int[sep], int[])
		for let (id, kind) in typesOf(file, tokens.len()) {
			pipe.place(id, tokens[id], kind) when kind := 3 || 4
		}
		for let (_, key) in string["tokenizer.ggml.cls_token_id", "tokenizer.ggml.seperator_token_id", "tokenizer.ggml.padding_token_id", "tokenizer.ggml.unknown_token_id", "tokenizer.ggml.mask_token_id"] {
			let id = file.getInt(key)
			pipe.place(id, tokens[id], 3) when id is int && id < tokens.len()
		}
		return new Tokenizer(pipe)
	}

	// added_tokens.json beside the files and the config's
	// added_tokens_decoder.
	internal def addedFromConfig(t HfPipeline, folder string, config map<string, any>) !none {
		let file = os.join(folder, "added_tokens.json")
		if try os.exists(file) {
			let added = try new JSON().parse(try os.readFile(file))
			if added is map<string, any> {
				for let (text, id) in added {
					t.place(id, text, 3) when id is int
				}
			}
		}
		let decoder = config.get("added_tokens_decoder")
		if decoder is map<string, any> {
			for let (key, entry) in decoder {
				continue unless entry is map<string, any>
				let id = key.len() > 0 && key[0].isDigit() ?? (parseInt<int>(key), -1)
				let content = textAt(entry, "content", "")
				t.place(id, content, boolAt(entry, "special", false) ?? (3, 4)) when id >= 0 && content.len() > 0
			}
		}
		return none
	}

	// ---- the pipeline ----------------------------------------------------

	internal enum ModelKind {
		BytePairs,
		WordPiece,
		WordLevel,
		Unigram,
	}

	internal enum NormalKind {
		// clean text, Chinese characters spaced, strip accents, lowercase.
		Bert,
		Lowercase,
		Nfc,
		Nfd,
		Nfkc,
		Nfkd,
		StripAccents,
		// Strips whitespace at the start (flags[0]) and end (flags[1]).
		Strip,
		// Replaces `pattern` (or the literal `text`) with `content`.
		Replace,
		Prepend,
		// Runs of whitespace become one space and the ends are trimmed
		// (CLIP's cleanup).
		Collapse,
	}

	internal struct NormalStep {
		kind    NormalKind
		flags   bool[]     = []
		text    string     = ""
		content string     = ""
		pattern ?regex     = none
	}

	internal enum SplitKind {
		ByteLevel,
		Bert,
		Whitespace,
		WhitespaceSplit,
		Metaspace,
		Pattern,
		Punctuation,
		Digits,
		Delimiter,
	}

	internal enum SplitBehavior {
		Removed,
		Isolated,
		MergedWithPrevious,
		MergedWithNext,
		Contiguous,
	}

	internal struct SplitStep {
		kind        SplitKind
		behavior    SplitBehavior = SplitBehavior.Isolated
		invert      bool          = false
		pattern     ?regex        = none
		text        string        = ""
		prefixSpace bool          = false
		// ByteLevel: split with GPT-2's pattern first.
		gpt2        bool          = true
		// Metaspace: prepend the replacement always (0), to the first
		// piece (1) or never (2); split at it.
		scheme      int           = 0
		split       bool          = true
		individual  bool          = false
	}

	internal enum DecodeKind {
		ByteLevel,
		WordPiece,
		Metaspace,
		// Turns `text` (</w>) into a space between words.
		Suffix,
		ByteFallback,
		Fuse,
		Strip,
		Replace,
		Ctc,
	}

	internal struct DecodeStep {
		kind    DecodeKind
		text    string     = ""
		content string     = ""
		flag    bool       = false
		// Strip: characters off the start and the end.
		start   int        = 0
		stop    int        = 0
	}

	// How a Hugging Face tokenizer turns text into tokens and back.
	internal type HfPipeline {
		model        ModelKind          = ModelKind.BytePairs
		normalizers  NormalStep[]       = []
		splits       SplitStep[]        = []
		decoders     DecodeStep[]       = []
		// BPE
		unknown      string             = ""
		prefix       string             = ""
		suffix       string             = ""
		byteFallback bool               = false
		fuseUnknown  bool               = false
		ignoreMerges bool               = false
		// WordPiece: the longest word read, and what a word's first piece
		// starts with in the vocabulary (GGUF's ▁; nothing in BERT's).
		longest      int                = 100
		wordStart    string             = ""
		// Unigram: each piece's log probability, and the unknown token's.
		scores       float[]            = []
		unknownScore float              = 0.0
		longestPiece int                = 1
		// Tokens the post-processor puts around a text.
		before       int[]              = []
		after        int[]              = []
		// The vocabulary, its token types as GGUF numbers them (1 normal,
		// 3 control, 4 user-defined, 5 unused), merge ranks and the tokens of
		// words seen before.
		tokens       string[]           = []
		types        int[]              = []
		ids          map<string, int>
		ranks        map<string, int>
		cache        map<string, int[]>

		def new() {
			ids = new map<string, int>()
			ranks = new map<string, int>()
			cache = new map<string, int[]>()
		}

		// Sets token `id` to `text` of type `kind`, growing the vocabulary to
		// hold it.
		def place(id int, text string, kind int) {
			for tokens.len() <= id {
				tokens.push("")
				types.push(5)
			}
			tokens[id] = text
			types[id] = kind
			ids.set(text, id)
		}

		// The id of the token spelled `text`; -1 when there is none.
		def idOf(text string) int {
			let id = ids.get(text)
			return id is none ?? (-1, id)
		}

		def readModel(m map<string, any>) !none {
			let kind = textAt(m, "type", "")
			let vocab = m.get("vocab")
			match kind {
				case "BPE", "":
					model = ModelKind.BytePairs
					fail "llm: the BPE model has no vocabulary" unless vocab is map<string, any>
					for let (piece, id) in vocab {
						place(id, piece, 1) when id is int
					}
					for let (n, m2) in listAt(m, "merges") {
						if m2 is string {
							ranks.set(m2, n)
						} else if m2 is any[] {
							ranks.set("{m2[0]} {m2[1]}", n) when m2.len() == 2
						}
					}
					unknown = textAt(m, "unk_token", "")
					prefix = textAt(m, "continuing_subword_prefix", "")
					suffix = textAt(m, "end_of_word_suffix", "")
					byteFallback = boolAt(m, "byte_fallback", false)
					fuseUnknown = boolAt(m, "fuse_unk", false)
					ignoreMerges = boolAt(m, "ignore_merges", false)
				case "WordPiece":
					model = ModelKind.WordPiece
					fail "llm: the WordPiece model has no vocabulary" unless vocab is map<string, any>
					for let (piece, id) in vocab {
						place(id, piece, 1) when id is int
					}
					unknown = textAt(m, "unk_token", "[UNK]")
					prefix = textAt(m, "continuing_subword_prefix", "##")
					longest = intAt(m, "max_input_chars_per_word", 100)
				case "WordLevel":
					model = ModelKind.WordLevel
					fail "llm: the WordLevel model has no vocabulary" unless vocab is map<string, any>
					for let (piece, id) in vocab {
						place(id, piece, 1) when id is int
					}
					unknown = textAt(m, "unk_token", "")
				case "Unigram":
					model = ModelKind.Unigram
					fail "llm: the Unigram model has no vocabulary" unless vocab is any[]
					let lowest = 0.0
					for let (id, entry) in vocab {
						continue unless entry is any[] && entry.len() == 2
						let piece = entry[0]
						continue unless piece is string
						let score = numberOf(entry[1])
						place(id, piece, 1)
						scores.len(id + 1) when scores.len() <= id
						scores[id] = score
						lowest = score.min(lowest)
						longestPiece = longestPiece.max(piece.len())
					}
					let unk = intAt(m, "unk_id", -1)
					unknown = unk >= 0 ?? (tokens[unk], "")
					unknownScore = lowest - 10.0
					byteFallback = boolAt(m, "byte_fallback", false)
				default:
					fail "llm: the {kind} tokenizer model is not supported"
			}
			return none
		}

		def readPost(post ?any) !none {
			return none unless post is map<string, any>
			match textAt(post, "type", "") {
				case "TemplateProcessing":
					let specials = objectAt(post, "special_tokens")
					let seenSequence = false
					for let (_, item) in listAt(post, "single") {
						continue unless item is map<string, any>
						let special = objectAt(item, "SpecialToken")
						if special is map<string, any> {
							let ids = specialIds(specials, textAt(special, "id", ""))
							seenSequence ?? (after.push(...ids), before.push(...ids))
						} else if objectAt(item, "Sequence") is map<string, any> {
							seenSequence = true
						}
					}
				case "BertProcessing", "RobertaProcessing":
					let cls = listAt(post, "cls")
					let sep = listAt(post, "sep")
					before.push(int(numberOf(cls[1]))) when cls.len() == 2
					after.push(int(numberOf(sep[1]))) when sep.len() == 2
				case "Sequence":
					for let (_, p) in listAt(post, "processors") {
						try readPost(p)
					}
				case "ByteLevel":
				default:
					fail "llm: the {textAt(post, "type", "")} post-processor is not supported"
			}
			return none
		}

		// The token ids TemplateProcessing's special_tokens gives `name`.
		internal def specialIds(specials ?map<string, any>, name string) int[] {
			let out int[]
			if specials is map<string, any> {
				let entry = specials.get(name)
				if entry is map<string, any> {
					for let (_, id) in listAt(entry, "ids") {
						out.push(int(numberOf(id)))
					}
					return out
				}
			}
			let id = idOf(name)
			out.push(id) when id >= 0
			return out
		}

		// ---- encoding ----

		// The tokens of text holding no added tokens.
		def encode(text string, out int[]) {
			let normal = text
			for let (_, step) in normalizers {
				normal = normalized(step, normal)
			}
			let pieces = string[normal]
			for let (_, step) in splits {
				let next string[]
				for let (k, p) in pieces {
					splitInto(step, p, k == 0, next)
				}
				pieces = next
			}
			for let (_, word) in pieces {
				continue when word.len() == 0
				let known = cache.get(word)
				if known is int[] {
					out.push(...known)
					continue
				}
				let ids int[]
				match model {
					case ModelKind.WordPiece:
						wordPieces(word, ids)
					case ModelKind.WordLevel:
						let id = idOf(word)
						let unk = idOf(unknown)
						ids.push(id >= 0 ?? (id, unk)) when id >= 0 || unk >= 0
					case ModelKind.Unigram:
						unigram(word, ids)
					default:
						bytePairs(word, ids)
				}
				cache.set(word, ids)
				out.push(...ids)
			}
		}

		internal def normalized(step NormalStep, text string) string {
			match step.kind {
				case NormalKind.Bert:
					return bertNormal(text, step.flags[0], step.flags[1], step.flags[2], step.flags[3])
				case NormalKind.Lowercase:
					return unicode.toLower(text)
				case NormalKind.Nfc:
					return unicode.normalize(text, NormalForm.NFC)
				case NormalKind.Nfd:
					return unicode.normalize(text, NormalForm.NFD)
				case NormalKind.Nfkc:
					return unicode.normalize(text, NormalForm.NFKC)
				case NormalKind.Nfkd:
					return unicode.normalize(text, NormalForm.NFKD)
				case NormalKind.StripAccents:
					return stripMarks(text)
				case NormalKind.Strip:
					let s = step.flags[0] ?? (text.trimStart(), text)
					return step.flags[1] ?? (s.trimEnd(), s)
				case NormalKind.Replace:
					let p = step.pattern
					return p is regex ?? (p.replace(text, step.content, -1), text.replace(step.text, step.content, -1))
				case NormalKind.Prepend:
					return text.len() == 0 ?? (text, step.text + text)
				case NormalKind.Collapse:
					return collapseWhitespace(text)
				default:
					return text
			}
		}

		// Appends the pieces `step` splits `piece` into to `out`; `first`
		// says the piece starts the text.
		internal def splitInto(step SplitStep, piece string, first bool, out string[]) {
			match step.kind {
				case SplitKind.ByteLevel:
					let text = step.prefixSpace && !piece.startsWith(" ") ?? (" " + piece, piece)
					if step.gpt2 {
						for let (_, word) in new PreTokenizer(Digits.Runs, false).split(text.bytes()) {
							out.push(byteLevel(word))
						}
					} else {
						out.push(byteLevel(text.bytes()))
					}
				case SplitKind.Bert:
					for let (_, word) in splitWhitespace(piece) {
						isolate(word, isPunctuation, out)
					}
				case SplitKind.WhitespaceSplit:
					out.push(...splitWhitespace(piece))
				case SplitKind.Whitespace:
					whitespaceWords(piece, out)
				case SplitKind.Metaspace:
					let text = piece.replace(" ", step.text, -1)
					let prepend = step.scheme == 0 || (step.scheme == 1 && first)
					text = step.text + text when prepend && !text.startsWith(step.text)
					if step.split {
						splitAround(text, matchesOf(text, step.text), SplitBehavior.MergedWithNext, out)
					} else {
						out.push(text)
					}
				case SplitKind.Pattern:
					let p = step.pattern
					let spans = p is regex ?? (regexSpans(p, piece), matchesOf(piece, step.text))
					spans = complement(spans, piece.len()) when step.invert
					splitAround(piece, spans, step.behavior, out)
				case SplitKind.Punctuation:
					let spans int[]
					let chars = unicode.codePoints(piece)
					for let (i, c) in chars {
						spans.push(i, i + 1) when isPunctuation(c)
					}
					splitAround(piece, spans, step.behavior, out)
				case SplitKind.Digits:
					let spans int[]
					let chars = unicode.codePoints(piece)
					let i = 0
					for i < chars.len() {
						if unicode.category(chars[i]) == Category.DecimalNumber {
							let j = i + 1
							for !step.individual && j < chars.len() && unicode.category(chars[j]) == Category.DecimalNumber {
								j++
							}
							spans.push(i, j)
							i = j
						} else {
							i++
						}
					}
					splitAround(piece, spans, SplitBehavior.Isolated, out)
				case SplitKind.Delimiter:
					splitAround(piece, matchesOf(piece, step.text), SplitBehavior.Removed, out)
			}
		}

		// BPE over one word: its characters (the last one carrying the
		// end-of-word suffix, the rest after the first the continuing
		// prefix), merged pair by pair in rank order.
		internal def bytePairs(word string, out int[]) {
			if ignoreMerges {
				let whole = idOf(word)
				if whole >= 0 {
					out.push(whole)
					return
				}
			}
			let chars = unicode.codePoints(word)
			let symbols string[]
			for let (i, c) in chars {
				let s = string(c)
				s = prefix + s when i > 0 && prefix.len() > 0
				s = s + suffix when i == chars.len() - 1 && suffix.len() > 0
				symbols.push(s)
			}
			for symbols.len() > 1 {
				let best = -1
				let bestRank = 0
				for let k = 0; k + 1 < symbols.len(); k++ {
					let rank = ranks.get(withoutPrefix(symbols[k], k) + " " + withoutPrefix(symbols[k + 1], k + 1))
					continue when rank is none
					if best < 0 || rank < bestRank {
						best = k
						bestRank = rank
					}
				}
				break when best < 0
				let joined = symbols[best] + withoutPrefix(symbols[best + 1], best + 1)
				symbols[best] = joined
				symbols.remove(best + 1)
			}
			let unk = idOf(unknown)
			let lastUnknown = false
			for let (_, s) in symbols {
				let id = idOf(s)
				if id >= 0 {
					out.push(id)
					lastUnknown = false
					continue
				}
				if byteFallback {
					let all = true
					let ids int[]
					for let (_, b) in s.bytes() {
						let bt = idOf(byteToken(int(b)))
						all = all && bt >= 0
						ids.push(bt)
					}
					if all {
						out.push(...ids)
						lastUnknown = false
						continue
					}
				}
				if unk >= 0 && !(fuseUnknown && lastUnknown) {
					out.push(unk)
				}
				lastUnknown = true
			}
		}

		// A merged symbol's text as merges.txt spells it: without the
		// continuing prefix after the first symbol.
		internal def withoutPrefix(symbol string, index int) string {
			return symbol unless index > 0 && prefix.len() > 0 && symbol.startsWith(prefix)
			return symbol.slice(prefix.len(), symbol.len())
		}

		// WordPiece: the longest vocabulary piece from the start, then the
		// longest "##" piece from where it ended, and so on; one unknown
		// token for the word when a stretch matches nothing.
		internal def wordPieces(word string, out int[]) {
			let chars = unicode.codePoints(word)
			let unk = idOf(unknown)
			if chars.len() > longest {
				out.push(unk) when unk >= 0
				return
			}
			let ids int[]
			let start = 0
			for start < chars.len() {
				let end = chars.len()
				let found = -1
				for end > start {
					let piece = charText(chars, start, end)
					piece = (start > 0 ?? (prefix, wordStart)) + piece
					let id = idOf(piece)
					if id >= 0 {
						found = id
						break
					}
					end--
				}
				if found < 0 {
					out.push(unk) when unk >= 0
					return
				}
				ids.push(found)
				start = end
			}
			out.push(...ids)
		}

		// Unigram: the split of the word whose pieces' log probabilities sum
		// highest (Viterbi over character positions); a character no piece
		// covers is the unknown token, or its bytes with byte fallback.
		internal def unigram(word string, out int[]) {
			let chars = unicode.codePoints(word)
			let n = chars.len()
			let best float[]
			let from int[]
			let token int[]
			best.len(n + 1)
			from.len(n + 1)
			token.len(n + 1)
			for let i = 1; i <= n; i++ {
				best[i] = -1e300
				from[i] = -1
			}
			for let i = 0; i < n; i++ {
				continue when i > 0 && from[i] < 0
				let matched = false
				for let j = i + 1; j <= n && j - i <= longestPiece; j++ {
					let id = idOf(charText(chars, i, j))
					continue when id < 0 || id >= scores.len()
					matched = matched || j == i + 1
					let s = best[i] + scores[id]
					if s > best[j] {
						best[j] = s
						from[j] = i
						token[j] = id
					}
				}
				if !matched {
					let s = best[i] + unknownScore
					if s > best[i + 1] {
						best[i + 1] = s
						from[i + 1] = i
						token[i + 1] = -1
					}
				}
			}
			let pieces int[]
			let starts int[]
			let at = n
			for at > 0 {
				pieces.push(token[at])
				starts.push(from[at])
				at = from[at]
			}
			let unk = idOf(unknown)
			let lastUnknown = false
			for let k = pieces.len() - 1; k >= 0; k-- {
				let id = pieces[k]
				if id >= 0 {
					out.push(id)
					lastUnknown = false
					continue
				}
				let ch = string(chars[starts[k]])
				if byteFallback {
					for let (_, b) in ch.bytes() {
						let bt = idOf(byteToken(int(b)))
						out.push(bt) when bt >= 0
					}
					continue
				}
				out.push(unk) when unk >= 0 && !lastUnknown
				lastUnknown = true
			}
		}

		// ---- decoding ----

		// The text of token pieces (added tokens included as their text).
		def decode(pieces string[]) string {
			// With no decoder the tokenizers library puts a space between tokens.
			return pieces.join(" ") when decoders.len() == 0
			let parts = pieces
			for let (_, step) in decoders {
				parts = decoded(step, parts)
			}
			return parts.join("")
		}

		internal def decoded(step DecodeStep, parts string[]) string[] {
			let out string[]
			match step.kind {
				case DecodeKind.ByteLevel:
					let bytes byte[]
					for let (_, p) in parts {
						for let (_, c) in unicode.codePoints(p) {
							let b = gpt2Byte(int(c))
							if b >= 0 {
								bytes.push(byte(b))
							} else {
								bytes.push(...string(c).bytes())
							}
						}
					}
					out.push(string(bytes))
				case DecodeKind.WordPiece:
					for let (i, p) in parts {
						if p.startsWith(step.text) {
							out.push(p.slice(step.text.len(), p.len()))
						} else {
							out.push(i > 0 ?? (" " + p, p))
						}
					}
					if step.flag {
						return string[cleanup(out.join(""))]
					}
				case DecodeKind.Metaspace:
					for let (i, p) in parts {
						let s = p.replace(step.text, " ", -1)
						s = s.slice(1, s.len()) when i == 0 && step.flag && s.startsWith(" ")
						out.push(s)
					}
				case DecodeKind.Suffix:
					// Each word's end becomes a space; none after the last word.
					let joined = parts.join("").replace(step.text, " ", -1)
					out.push(joined.endsWith(" ") ?? (joined.slice(0, joined.len() - 1), joined))
				case DecodeKind.ByteFallback:
					let pending byte[]
					for let (_, p) in parts {
						if p.len() == 6 && p.startsWith("<0x") && p.endsWith(">") {
							pending.push(byte(hexValue(p.bytes(), 3)))
							continue
						}
						if pending.len() > 0 {
							out.push(string(pending))
							pending = byte[]
						}
						out.push(p)
					}
					out.push(string(pending)) when pending.len() > 0
				case DecodeKind.Fuse:
					out.push(parts.join(""))
				case DecodeKind.Strip:
					for let (_, p) in parts {
						let chars = unicode.codePoints(p)
						let a = 0
						for a < step.start && a < chars.len() && string(chars[a]) == step.content {
							a++
						}
						let b = chars.len()
						for chars.len() - b < step.stop && b > a && string(chars[b - 1]) == step.content {
							b--
						}
						out.push(charText(chars, a, b))
					}
				case DecodeKind.Replace:
					for let (_, p) in parts {
						out.push(p.replace(step.text, step.content, -1))
					}
				case DecodeKind.Ctc:
					let last = ""
					for let (_, p) in parts {
						if p != last && p != step.text {
							out.push(p.replace(step.content, " ", -1))
						}
						last = p
					}
			}
			return out
		}
	}

	// ---- reading the JSON ----

	internal def normalizersOf(n ?any) !NormalStep[] {
		let out NormalStep[]
		return out unless n is map<string, any>
		let kind = textAt(n, "type", "")
		match kind {
			case "Sequence":
				for let (_, inner) in listAt(n, "normalizers") {
					out.push(...(try normalizersOf(inner)))
				}
			case "BertNormalizer":
				let lower = boolAt(n, "lowercase", true)
				let strip = n.get("strip_accents")
				out.push(NormalStep{kind: NormalKind.Bert, flags: bool[boolAt(n, "clean_text", true), boolAt(n, "handle_chinese_chars", true), strip is bool ?? (strip, lower), lower]})
			case "Lowercase":
				out.push(NormalStep{kind: NormalKind.Lowercase})
			case "NFC":
				out.push(NormalStep{kind: NormalKind.Nfc})
			case "NFD":
				out.push(NormalStep{kind: NormalKind.Nfd})
			case "NFKC":
				out.push(NormalStep{kind: NormalKind.Nfkc})
			case "NFKD":
				out.push(NormalStep{kind: NormalKind.Nfkd})
			case "StripAccents":
				out.push(NormalStep{kind: NormalKind.StripAccents})
			case "Strip":
				out.push(NormalStep{kind: NormalKind.Strip, flags: bool[boolAt(n, "strip_left", true), boolAt(n, "strip_right", true)]})
			case "Replace":
				let (text, pattern) = try patternOf(n)
				out.push(NormalStep{kind: NormalKind.Replace, text: text, pattern: pattern, content: textAt(n, "content", "")})
			case "Prepend":
				out.push(NormalStep{kind: NormalKind.Prepend, text: textAt(n, "prepend", "")})
			default:
				fail "llm: the {kind} normalizer is not supported"
		}
		return out
	}

	internal def splitsOf(p ?any) !SplitStep[] {
		let out SplitStep[]
		return out unless p is map<string, any>
		let kind = textAt(p, "type", "")
		match kind {
			case "Sequence":
				for let (_, inner) in listAt(p, "pretokenizers") {
					out.push(...(try splitsOf(inner)))
				}
			case "ByteLevel":
				out.push(SplitStep{kind: SplitKind.ByteLevel, prefixSpace: boolAt(p, "add_prefix_space", true), gpt2: boolAt(p, "use_regex", true)})
			case "BertPreTokenizer":
				out.push(SplitStep{kind: SplitKind.Bert})
			case "Whitespace":
				out.push(SplitStep{kind: SplitKind.Whitespace})
			case "WhitespaceSplit":
				out.push(SplitStep{kind: SplitKind.WhitespaceSplit})
			case "Metaspace":
				let scheme = textAt(p, "prepend_scheme", boolAt(p, "add_prefix_space", true) ?? ("always", "never"))
				out.push(SplitStep{kind: SplitKind.Metaspace, text: textAt(p, "replacement", "▁"), scheme: scheme == "always" ?? (0, scheme == "first" ?? (1, 2)), split: boolAt(p, "split", true)})
			case "Split":
				let (text, pattern) = try patternOf(p)
				out.push(SplitStep{kind: SplitKind.Pattern, text: text, pattern: pattern, behavior: try behaviorOf(textAt(p, "behavior", "Isolated")), invert: boolAt(p, "invert", false)})
			case "Punctuation":
				out.push(SplitStep{kind: SplitKind.Punctuation, behavior: try behaviorOf(textAt(p, "behavior", "Isolated"))})
			case "Digits":
				out.push(SplitStep{kind: SplitKind.Digits, individual: boolAt(p, "individual_digits", false)})
			case "CharDelimiterSplit":
				out.push(SplitStep{kind: SplitKind.Delimiter, text: textAt(p, "delimiter", " ")})
			default:
				fail "llm: the {kind} pre-tokenizer is not supported"
		}
		return out
	}

	internal def decodersOf(d ?any) !DecodeStep[] {
		let out DecodeStep[]
		return out unless d is map<string, any>
		let kind = textAt(d, "type", "")
		match kind {
			case "Sequence":
				for let (_, inner) in listAt(d, "decoders") {
					out.push(...(try decodersOf(inner)))
				}
			case "ByteLevel":
				out.push(DecodeStep{kind: DecodeKind.ByteLevel})
			case "WordPiece":
				out.push(DecodeStep{kind: DecodeKind.WordPiece, text: textAt(d, "prefix", "##"), flag: boolAt(d, "cleanup", true)})
			case "Metaspace":
				let scheme = textAt(d, "prepend_scheme", boolAt(d, "add_prefix_space", true) ?? ("always", "never"))
				out.push(DecodeStep{kind: DecodeKind.Metaspace, text: textAt(d, "replacement", "▁"), flag: scheme != "never"})
			case "BPEDecoder":
				out.push(DecodeStep{kind: DecodeKind.Suffix, text: textAt(d, "suffix", "</w>")})
			case "ByteFallback":
				out.push(DecodeStep{kind: DecodeKind.ByteFallback})
			case "Fuse":
				out.push(DecodeStep{kind: DecodeKind.Fuse})
			case "Strip":
				out.push(DecodeStep{kind: DecodeKind.Strip, content: textAt(d, "content", " "), start: intAt(d, "start", 0), stop: intAt(d, "stop", 0)})
			case "Replace":
				let (text, _) = try patternOf(d)
				out.push(DecodeStep{kind: DecodeKind.Replace, text: text, content: textAt(d, "content", "")})
			case "CTC":
				out.push(DecodeStep{kind: DecodeKind.Ctc, text: textAt(d, "pad_token", "<pad>"), content: textAt(d, "word_delimiter_token", "|")})
			default:
				fail "llm: the {kind} decoder is not supported"
		}
		return out
	}

	// A `pattern` field: {"String": text} or {"Regex": pattern}.
	internal def patternOf(m map<string, any>) !(string, ?regex) {
		let p = objectAt(m, "pattern")
		fail "llm: a tokenizer step has no pattern" unless p is map<string, any>
		let literal = p.get("String")
		return (literal, none) when literal is string
		let pattern = p.get("Regex")
		fail "llm: a tokenizer pattern is neither String nor Regex" unless pattern is string
		let r = new regex(pattern, "")
		fail "llm: the tokenizer pattern {pattern} does not compile" unless r.valid()
		return ("", r)
	}

	internal def behaviorOf(name string) !SplitBehavior {
		match name {
			case "Removed":
				return SplitBehavior.Removed
			case "Isolated":
				return SplitBehavior.Isolated
			case "MergedWithPrevious":
				return SplitBehavior.MergedWithPrevious
			case "MergedWithNext":
				return SplitBehavior.MergedWithNext
			case "Contiguous":
				return SplitBehavior.Contiguous
		}
		fail "llm: the split behavior {name} is not supported"
	}

	internal def textAt(m map<string, any>, key string, fallback string) string {
		let v = m.get(key)
		return v is string ?? (v, fallback)
	}

	internal def intAt(m map<string, any>, key string, fallback int) int {
		let v = m.get(key)
		return v is int ?? (v, fallback)
	}

	internal def boolAt(m map<string, any>, key string, fallback bool) bool {
		let v = m.get(key)
		return v is bool ?? (v, fallback)
	}

	internal def listAt(m map<string, any>, key string) any[] {
		let v = m.get(key)
		return v is any[] ?? (v, any[])
	}

	internal def objectAt(m map<string, any>, key string) ?map<string, any> {
		let v = m.get(key)
		return v is map<string, any> ?? (v, none)
	}

	internal def numberOf(v any) float {
		return float(v) when v is int
		return v when v is float
		return 0.0
	}

	// ---- text helpers ----

	// BERT's normalizer: control characters dropped and whitespace made
	// spaces, CJK ideographs set apart by spaces, accents stripped, lower
	// case.
	internal def bertNormal(text string, clean bool, chinese bool, strip bool, lower bool) string {
		let out string[]
		for let (_, c) in unicode.codePoints(text) {
			let code = int(c)
			if clean {
				continue when code == 0 || code == 0xFFFD
				if code == 9 || code == 10 || code == 13 || isSpace(c) {
					out.push(" ")
					continue
				}
				let cat = unicode.category(c)
				continue when cat == Category.Control || cat == Category.Format
			}
			if chinese && isIdeograph(code) {
				out.push(" ", string(c), " ")
				continue
			}
			out.push(string(c))
		}
		let s = out.join("")
		s = unicode.toLower(s) when lower
		s = stripMarks(s) when strip
		return s
	}

	// NFD, then nonspacing marks left out.
	internal def stripMarks(text string) string {
		let out string[]
		for let (_, c) in unicode.codePoints(unicode.normalize(text, NormalForm.NFD)) {
			out.push(string(c)) unless unicode.category(c) == Category.NonspacingMark
		}
		return out.join("")
	}

	internal def collapseWhitespace(text string) string {
		let words string[]
		let current string[]
		for let (_, c) in unicode.codePoints(text) {
			if isSpace(c) {
				if current.len() > 0 {
					words.push(current.join(""))
					current = string[]
				}
			} else {
				current.push(string(c))
			}
		}
		words.push(current.join("")) when current.len() > 0
		return words.join(" ")
	}

	internal def isSpace(c char) bool {
		let code = int(c)
		return code == 32 || code == 9 || code == 10 || code == 13 || unicode.category(c) == Category.SpaceSeparator
	}

	internal def isIdeograph(code int) bool {
		return (code >= 0x4E00 && code <= 0x9FFF) || (code >= 0x3400 && code <= 0x4DBF) || (code >= 0x20000 && code <= 0x2A6DF) || (code >= 0x2A700 && code <= 0x2B73F) || (code >= 0x2B740 && code <= 0x2B81F) || (code >= 0x2B820 && code <= 0x2CEAF) || (code >= 0xF900 && code <= 0xFAFF) || (code >= 0x2F800 && code <= 0x2FA1F)
	}

	// BERT's punctuation: ASCII symbols and every Unicode punctuation category.
	internal def isPunctuation(c char) bool {
		let code = int(c)
		return true when (code >= 33 && code <= 47) || (code >= 58 && code <= 64) || (code >= 91 && code <= 96) || (code >= 123 && code <= 126)
		return unicode.category(c) := Category.ConnectorPunctuation || Category.DashPunctuation || Category.OpenPunctuation || Category.ClosePunctuation || Category.InitialPunctuation || Category.FinalPunctuation || Category.OtherPunctuation
	}

	internal def splitWhitespace(text string) string[] {
		let out string[]
		let current string[]
		for let (_, c) in unicode.codePoints(text) {
			if isSpace(c) {
				if current.len() > 0 {
					out.push(current.join(""))
					current = string[]
				}
			} else {
				current.push(string(c))
			}
		}
		out.push(current.join("")) when current.len() > 0
		return out
	}

	// Each character `test` picks becomes a piece of its own.
	internal def isolate(word string, test def(char) bool, out string[]) {
		let current string[]
		for let (_, c) in unicode.codePoints(word) {
			if test(c) {
				if current.len() > 0 {
					out.push(current.join(""))
					current = string[]
				}
				out.push(string(c))
			} else {
				current.push(string(c))
			}
		}
		out.push(current.join("")) when current.len() > 0
	}

	// The Whitespace pre-tokenizer: \w+ and [^\w\s]+ runs.
	internal def whitespaceWords(text string, out string[]) {
		let current string[]
		let kind = 0
		for let (_, c) in unicode.codePoints(text) {
			let k = isSpace(c) ?? (0, isWordChar(c) ?? (1, 2))
			if k != kind && current.len() > 0 {
				out.push(current.join(""))
				current = string[]
			}
			kind = k
			current.push(string(c)) when k != 0
		}
		out.push(current.join("")) when current.len() > 0
	}

	internal def isWordChar(c char) bool {
		return true when c == '_'
		let cat = unicode.category(c)
		return cat := Category.UppercaseLetter || Category.LowercaseLetter || Category.TitlecaseLetter || Category.ModifierLetter || Category.OtherLetter || Category.DecimalNumber || Category.LetterNumber || Category.OtherNumber || Category.NonspacingMark || Category.SpacingMark || Category.EnclosingMark || Category.ConnectorPunctuation
	}

	// A word's bytes as GPT-2's printable stand-ins.
	internal def byteLevel(word byte[]) string {
		let out string[]
		for let (_, b) in word {
			out.push(gpt2Char(int(b)))
		}
		return out.join("")
	}

	// GPT-2's stand-in for a byte: the byte itself when it is a visible
	// Latin-1 character, else 256 and up in byte order.
	internal def gpt2Char(b int) string {
		let visible = (b >= 0x21 && b <= 0x7E) || (b >= 0xA1 && b <= 0xAC) || (b >= 0xAE && b <= 0xFF)
		return encodeRune(b) when visible
		return encodeRune(256 + b) when b <= 0x20
		return encodeRune(256 + b - 0x5E) when b <= 0xA0
		return encodeRune(256 + 0x43)
	}

	// The byte a GPT-2 stand-in character stands for; -1 for another.
	internal def gpt2Byte(c int) int {
		let visible = (c >= 0x21 && c <= 0x7E) || (c >= 0xA1 && c <= 0xAC) || (c >= 0xAE && c <= 0xFF)
		return c when visible
		let k = c - 256
		return -1 when k < 0 || k > 0x43
		return k when k <= 0x20
		return k + 0x5E when k <= 0x42
		return 0xAD
	}

	// Character spans [start, end) of each literal occurrence of `text`.
	internal def matchesOf(piece string, text string) int[] {
		let spans int[]
		return spans when text.len() == 0
		let chars = unicode.codePoints(piece)
		let needle = unicode.codePoints(text)
		let i = 0
		for i + needle.len() <= chars.len() {
			let same = true
			for let k = 0; k < needle.len(); k++ {
				if chars[i + k] != needle[k] {
					same = false
					break
				}
			}
			if same {
				spans.push(i, i + needle.len())
				i += needle.len()
			} else {
				i++
			}
		}
		return spans
	}

	internal def regexSpans(r regex, piece string) int[] {
		let spans int[]
		for let (_, m) in r.findAll(piece) {
			spans.push(m.start, m.end) when m.end > m.start
		}
		return spans
	}

	// The stretches between the spans, as spans.
	internal def complement(spans int[], length int) int[] {
		let out int[]
		let at = 0
		for let k = 0; k < spans.len(); k += 2 {
			out.push(at, spans[k]) when spans[k] > at
			at = spans[k + 1]
		}
		out.push(at, length) when length > at
		return out
	}

	// Splits `piece` at the matched spans the way `behavior` says.
	internal def splitAround(piece string, spans int[], behavior SplitBehavior, out string[]) {
		let chars = unicode.codePoints(piece)
		let n = chars.len()
		let parts string[]
		let matched bool[]
		let at = 0
		for let k = 0; k < spans.len(); k += 2 {
			if spans[k] > at {
				parts.push(charText(chars, at, spans[k]))
				matched.push(false)
			}
			parts.push(charText(chars, spans[k], spans[k + 1]))
			matched.push(true)
			at = spans[k + 1]
		}
		if at < n {
			parts.push(charText(chars, at, n))
			matched.push(false)
		}
		match behavior {
			case SplitBehavior.Removed:
				for let (i, p) in parts {
					out.push(p) unless matched[i]
				}
			case SplitBehavior.Isolated:
				out.push(...parts)
			case SplitBehavior.MergedWithPrevious:
				let current = ""
				for let (i, p) in parts {
					current += p
					if matched[i] {
						out.push(current)
						current = ""
					}
				}
				out.push(current) when current.len() > 0
			case SplitBehavior.MergedWithNext:
				let current = ""
				for let (i, p) in parts {
					if matched[i] && current.len() > 0 {
						out.push(current)
						current = ""
					}
					current += p
				}
				out.push(current) when current.len() > 0
			case SplitBehavior.Contiguous:
				let current = ""
				let last = false
				for let (i, p) in parts {
					if current.len() > 0 && !(matched[i] && last) {
						out.push(current)
						current = ""
					}
					current += p
					last = matched[i]
				}
				out.push(current) when current.len() > 0
		}
	}

	// Characters from..to of `chars` as text.
	internal def charText(chars char[], from int, to int) string {
		let out string[]
		for let i = from; i < to; i++ {
			out.push(string(chars[i]))
		}
		return out.join("")
	}

	// WordPiece's cleanup: no space before punctuation and contractions.
	internal def cleanup(text string) string {
		let s = text
		for let (_, pair) in string[" .", " ?", " !", " ,", " ' ", " n't", " 'm", " 's", " 've", " 're"] {
			let to = pair == " ' " ?? ("'", pair.slice(1, pair.len()))
			s = s.replace(pair, to, -1)
		}
		return s
	}
}
