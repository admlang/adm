partial module std.ai.llm {
	use (
		std.formats.audio::(Audio)
		std.formats.image::(Image)
		std.ai.llm.calls::(methodTools, runToolOutput)
	)

	// What a live conversation brings.
	enum LiveEventKind {
		// A piece of the model's speech (`sound`).
		Sound,
		// A piece of the model's text, or of the words it speaks.
		Text,
		// What the user said, as words, once the provider transcribes it.
		Heard,
		// The user began to speak over the model: stop playing what it was
		// saying.
		Interrupted,
		// A call of a tool with no `run`: answer it with `LiveChat.answer`.
		Call,
		// The model finished its turn (`usage` counts it).
		Done,
	}

	// One thing a live conversation brings.
	struct LiveEvent {
		kind  LiveEventKind
		sound ?Audio        = none
		text  string        = ""
		call  ?ToolCall     = none
		usage Usage         = Usage{}
	}

	// What a live connection opens with.
	struct LiveSetup {
		model       string
		system      string = ""
		tools       Tool[] = []
		// The provider's voice name; "" for its default.
		voice       string = ""
		temperature ?float = none
		// Whether the model answers with speech (and the words it speaks
		// as text), or with text alone.
		speech      bool   = true
		// Whether the user's speech comes back as words (`Heard`).
		transcribe  bool   = true
		// Whether the provider tells when the user stopped speaking and
		// answers then; false: the program ends each turn with `commit`.
		turns       bool   = true
	}

	// What a provider library implements so `LiveChat` runs over its live
	// API (OpenAI's Realtime API, Gemini's Live API).
	interface LiveProvider {
		// Opens a connection with `setup`.
		def connect(setup LiveSetup) !LiveConnection
	}

	// One open live connection. One task reads (`next`) while others send;
	// a connection serializes its own sends.
	interface LiveConnection {
		// Sends a piece of the user's sound, at any rate and channel count.
		def send(sound Audio) !none
		// Sends a user message of text and pictures, and asks for a reply.
		def send(text string, images Image[]) !none
		// Ends the user's spoken turn now and asks for a reply (without the
		// provider's turn detection).
		def commit() !none
		// Gives the model a call's result; it goes on.
		def answer(call ToolCall, output ToolOutput) !none
		// The next event; none once the connection closed.
		def next() !?LiveEvent
		def close()
	}

	// A spoken conversation with a hosted model, both ways at once: the
	// user's sound goes in as it is recorded, the model's speech, text and
	// calls come back as they are made. Tools run as in a `RemoteChat`:
	// calls of tools with a `run` (or `look`) are answered on the way,
	// others come back as `Call` events. The settings hold from `open` on.
	//
	//     let live = client.live()
	//     live.useTool(new Desk())
	//     try live.hear(try microphone.read(100ms))
	//     for let event = try live.next(); !(event is none); event = try live.next() {
	//         speaker.play(event.sound) when event.kind == llm.LiveEventKind.Sound
	//     }
	type LiveChat {
		model               string
		system              string          = ""
		tools               Tool[]          = []
		voice               string          = ""
		temperature         ?float          = none
		speech              bool            = true
		transcribe          bool            = true
		turns               bool            = true
		internal provider   LiveProvider
		internal connection ?LiveConnection = none

		def new(provider LiveProvider, model string) {
			self.provider = provider
			self.model = model
		}

		// Offers the model every `@tool` method of `value`'s type.
		def useTool(value any) {
			tools.push(...methodTools(value))
		}

		// Opens the connection with the settings as they are now; the
		// first `hear` or `say` opens it otherwise.
		// Fails when the provider refuses the connection.
		def open() !none {
			return none unless connection is none
			connection = try provider.connect(LiveSetup{model: model, system: system, tools: tools, voice: voice, temperature: temperature, speech: speech, transcribe: transcribe, turns: turns})
			return none
		}

		// Sends a piece of the user's sound.
		// Fails when the connection does.
		def hear(sound Audio) !none {
			return try (try opened()).send(sound)
		}

		// Sends a message of text (and pictures) and asks for a reply.
		// Fails when the connection does.
		def say(text string, images Image[] = Image[]) !none {
			return try (try opened()).send(text, images)
		}

		// Ends the user's spoken turn now (with `turns` off).
		// Fails when the connection does.
		def commit() !none {
			return try (try opened()).commit()
		}

		// The next event; none once the connection closed. Calls of tools
		// that run are run here and answered.
		// Fails when the connection does.
		def next() !?LiveEvent {
			let open = try opened()
			for {
				let event = try open.next()
				return none when event is none
				let call = event.call
				if event.kind == LiveEventKind.Call && !(call is none) {
					let tool = toolNamed(call.name)
					if !(tool is none) && !(tool.run is none && tool.look is none) {
						try open.answer(call, runToolOutput(tool, call))
						continue
					}
				}
				return event
			}
		}

		// Gives the model the result of a `Call`.
		// Fails when the connection does.
		def answer(call ToolCall, result string) !none {
			return try (try opened()).answer(call, ToolOutput{text: result})
		}

		// The same with pictures in the result.
		// Fails when the connection does.
		def answer(call ToolCall, output ToolOutput) !none {
			return try (try opened()).answer(call, output)
		}

		// Closes the connection; `open` makes a new one.
		def close() {
			let open = connection
			open.close() unless open is none
			connection = none
		}

		internal def opened() !LiveConnection {
			try open()
			let open = connection
			fail "llm: the live connection is closed" when open is none
			return open
		}

		internal def toolNamed(name string) ?Tool {
			for let (_, t) in tools {
				return t when t.name == name
			}
			return none
		}
	}
}
