partial module std.ai.llm {
	use (
		std.os
		std.testing
		std.formats.audio::(Audio, AudioInfo)
		std.formats.image::(Image)
		std.formats.video
		std.ai.llm.model::(videoPictures)
	)

	// A live connection that plays a script: what was sent is kept, each
	// `next` gives the next scripted event.
	internal type ScriptedLive {
		events   LiveEvent[]
		sent     string[]
		answered ToolOutput[]

		def send(sound Audio) !none {
			sent.push("sound {sound.samples.len()}")
			return none
		}

		def send(text string, images Image[]) !none {
			sent.push("text {text} {images.len()}")
			return none
		}

		def commit() !none {
			sent.push("commit")
			return none
		}

		def answer(call ToolCall, output ToolOutput) !none {
			sent.push("answer {call.id} {output.text} {output.images.len()}")
			answered.push(output)
			return none
		}

		def next() !?LiveEvent {
			return none when events.len() == 0
			let event = events[0]
			events.remove(0)
			return event
		}

		def close() {
			sent.push("close")
		}
	}

	internal type ScriptedLiveProvider {
		live   ScriptedLive
		setups LiveSetup[]

		def connect(setup LiveSetup) !LiveConnection {
			setups.push(setup)
			return live
		}
	}

	check "Live chat" {
		// Settings at the first send, calls of runnable tools answered on
		// the way (pictures included), others handed out.
		@test()
		def TestLiveChatRunsTools() !none {
			let script = new ScriptedLive()
			script.events = [LiveEvent{kind: LiveEventKind.Heard, text: "time?"}, LiveEvent{kind: LiveEventKind.Call, call: new ToolCall("c1", "clock", "\{}")}, LiveEvent{kind: LiveEventKind.Call, call: new ToolCall("c2", "camera", "\{}")}, LiveEvent{kind: LiveEventKind.Call, call: new ToolCall("c3", "ask", "\{}")}, LiveEvent{kind: LiveEventKind.Done}]
			let provider = new ScriptedLiveProvider()
			provider.live = script
			let live = new LiveChat(provider, "m")
			live.system = "Be brief."
			live.tools.push(Tool{name: "clock", description: "", run: def (call ToolCall) !string {
				return "noon"
			}})
			live.tools.push(Tool{name: "camera", description: "", look: def (call ToolCall) !ToolOutput {
				return ToolOutput{text: "a view", images: [new Image(1, 1)]}
			}})
			live.tools.push(Tool{name: "ask", description: ""})
			try live.hear(Audio{info: AudioInfo{sampleRate: uint32(16000), channels: uint16(1)}, samples: float32[0, 0]})
			assert provider.setups.len() == 1 && provider.setups[0].system == "Be brief." && provider.setups[0].tools.len() == 3
			let heard = try live.next()
			assert !(heard is none) && heard.kind == LiveEventKind.Heard
			let handed = try live.next()
			fail "no call handed out" unless !(handed is none) && handed.kind == LiveEventKind.Call
			let call = handed.call
			fail "the call is missing" when call is none
			assert call.name == "ask"
			try live.answer(call, "yes")
			let done = try live.next()
			assert !(done is none) && done.kind == LiveEventKind.Done && (try live.next()) is none
			live.close()
			assert script.sent.equals(string["sound 2", "answer c1 noon 0", "answer c2 a view 1", "answer c3 yes 0", "close"])
			return none
		}

		// Pictures a tool returns go with its message to a hosted model.
		@test()
		def TestRemoteChatPictureResults() !none {
			let provider = new ScriptedProvider()
			provider.replies.push([callEvent("p1", "camera", "\{}"), doneEvent(StopReason.Calls, 3, 3)])
			provider.replies.push([textEvent("A view."), doneEvent(StopReason.End, 3, 3)])
			let chat = new RemoteChat(provider, "m")
			chat.tools.push(Tool{name: "camera", description: "", look: def (call ToolCall) !ToolOutput {
				return ToolOutput{text: "taken", images: [new Image(2, 2)]}
			}})
			assert (try chat.say("Look.")) == "A view."
			let result = provider.requests[1].messages[2]
			assert result.role == Role.Tool && result.text == "taken" && result.images.len() == 1 && result.callId == "p1"
			return none
		}

		// A video as pictures spread through it, when the sample is there.
		@test()
		def TestVideoPictures() !none {
			let path = "samples/video/mp4/mp4_5s_sample_file_279KB.mp4"
			return none unless try os.exists(path)
			let clip = try video.open(path)
			let pictures = try videoPictures([clip])
			let size = clip.info()
			assert pictures.len() == 8 && pictures[0].size().width == size.width && pictures[7].size().height == size.height
			return none
		}
	}
}
