partial module std.ai.llm {
	use (
		std.testing
		std.gpu
		std.math
		std.os
		std.formats.ai
		std.ai.llm.text::*
		std.ai.llm.unicode
		std.ai.llm.model::(topCandidates, clampedSwiglu, readParts, withDocuments, targetSize, readProjector)
		std.services::(Runtime)
		std.formats.image::(Image)
		std.formats.docs::(Document)
		std.ai.llm.chat::(render, ChatText)
		std.ai.llm.calls::*
		std.ai.llm.decisions::*
		std.ai.llm.testdesk::*
		std.reflection
		std.text.templates.jinja
	)

	check "Language models" {
		internal def put(out byte[], v int, n int) {
			for let k = 0; k < n; k++ {
				out.push(byte((v >> (k * 8)) & 0xFF))
			}
		}

		internal def putString(out byte[], s string) {
			put(out, s.bytes().len(), 8)
			out.push(...s.bytes())
		}

		internal def putStrings(out byte[], key string, values string[]) {
			putString(out, key)
			put(out, 9, 4)
			put(out, 8, 4)
			put(out, values.len(), 8)
			for let (_, v) in values {
				putString(out, v)
			}
		}

		internal def putInts(out byte[], key string, values int[]) {
			putString(out, key)
			put(out, 9, 4)
			put(out, 5, 4)
			put(out, values.len(), 8)
			for let (_, v) in values {
				put(out, v, 4)
			}
		}

		internal def putBools(out byte[], key string, values bool[]) {
			putString(out, key)
			put(out, 9, 4)
			put(out, 7, 4)
			put(out, values.len(), 8)
			for let (_, v) in values {
				put(out, v ?? (1, 0), 1)
			}
		}

		internal def putText(out byte[], key string, value string) {
			putString(out, key)
			put(out, 8, 4)
			putString(out, value)
		}

		internal def putUint(out byte[], key string, value int) {
			putString(out, key)
			put(out, 4, 4)
			put(out, value, 4)
		}

		// A GGUF file holding only a tokenizer: `count` metadata keys written by `body`.
		internal def tokenizerFile(count int, body def(byte[])) !ai.ModelFile {
			let out byte[]
			put(out, 0x46554747, 4)
			put(out, 3, 4)
			put(out, 0, 8)
			put(out, count, 8)
			body(out)
			return ai.load(out)
		}

		// Byte-level BPE (GPT-2 style): Ġ stands for the space byte.
		internal def bytePairs() !Tokenizer {
			let file = try tokenizerFile(7, def (out byte[]) {
				putText(out, "tokenizer.ggml.model", "gpt2")
				putText(out, "tokenizer.ggml.pre", "smollm")
				putStrings(out, "tokenizer.ggml.tokens", string["<|endoftext|>", "a", "b", "Ġ", "ab", "Ġab", "!", "1", "2", "<|im_end|>"])
				putInts(out, "tokenizer.ggml.token_type", int[3, 1, 1, 1, 1, 1, 1, 1, 1, 3])
				putStrings(out, "tokenizer.ggml.merges", string["a b", "Ġ ab"])
				putUint(out, "tokenizer.ggml.bos_token_id", 0)
				putUint(out, "tokenizer.ggml.eos_token_id", 0)
			})
			return loadTokenizer(file)
		}

		@test()
		def TestLlama3StartToken() !none {
			// Llama 3 files often carry no add_bos_token; its pre-tokenizer
			// family starts every text with the start token all the same.
			let file = try tokenizerFile(7, def (out byte[]) {
				putText(out, "tokenizer.ggml.model", "gpt2")
				putText(out, "tokenizer.ggml.pre", "llama-bpe")
				putStrings(out, "tokenizer.ggml.tokens", string["<|begin_of_text|>", "a", "b", "Ġ", "ab", "Ġab", "!"])
				putInts(out, "tokenizer.ggml.token_type", int[3, 1, 1, 1, 1, 1, 1])
				putStrings(out, "tokenizer.ggml.merges", string["a b", "Ġ ab"])
				putUint(out, "tokenizer.ggml.bos_token_id", 0)
				putUint(out, "tokenizer.ggml.eos_token_id", 6)
			})
			let t = try loadTokenizer(file)
			assert t.encode("ab ab").equals(int[0, 4, 5])
			return none
		}

		// SentencePiece: ▁ for spaces, merges by score, byte fallback.
		// Byte-pair merges over characters (Gemma 4): ▁ for spaces, byte
		// tokens for the rest.
		internal def characterPairs() !Tokenizer {
			let file = try tokenizerFile(6, def (out byte[]) {
				putText(out, "tokenizer.ggml.model", "gemma4")
				putStrings(out, "tokenizer.ggml.tokens", string["<pad>", "<eos>", "<bos>", "a", "b", "▁", "ab", "▁ab", "\n", "\n\n", "<0x21>"])
				putInts(out, "tokenizer.ggml.token_type", int[3, 3, 3, 1, 1, 1, 1, 1, 1, 1, 6])
				putStrings(out, "tokenizer.ggml.merges", string["a b", "▁ ab"])
				putUint(out, "tokenizer.ggml.bos_token_id", 2)
				putUint(out, "tokenizer.ggml.eos_token_id", 1)
			})
			return loadTokenizer(file)
		}

		internal def sentencePiece() !Tokenizer {
			let file = try tokenizerFile(5, def (out byte[]) {
				putText(out, "tokenizer.ggml.model", "llama")
				putStrings(out, "tokenizer.ggml.tokens", string["<unk>", "<s>", "</s>", "▁", "a", "b", "▁a", "ab", "▁ab", "<0x21>"])
				putString(out, "tokenizer.ggml.scores")
				put(out, 9, 4)
				put(out, 6, 4)
				put(out, 10, 8)
				for let (_, bits) in int[0, 0, 0, 0xBF800000, 0xC0000000, 0xC0400000, 0xBFC00000, 0xBF800000, 0xBF000000, 0] {
					put(out, bits, 4)
				}
				putInts(out, "tokenizer.ggml.token_type", int[2, 3, 3, 1, 1, 1, 1, 1, 1, 6])
				putUint(out, "tokenizer.ggml.bos_token_id", 1)
			})
			return loadTokenizer(file)
		}

		// A deterministic weight in [-0.5, 0.5] for element `k` of tensor `t`.
		internal def weight(t int, k int) float32 {
			let h = ((t + 1) * 7919 + k * 104729) % 2003
			return float32(h - 1001) / float32(2003)
		}

		internal def putTensor(out byte[], name string, shape int[], offset int) {
			putString(out, name)
			put(out, shape.len(), 4)
			for let (_, n) in shape {
				put(out, n, 8)
			}
			put(out, 0, 4)
			put(out, offset, 8)
		}

		internal def putFloat(out byte[], key string, value float) {
			putString(out, key)
			put(out, 6, 4)
			put(out, int(__bitcast_u32_from_f32(float32(value))), 4)
		}

		// A one-layer Llama model with F32 weights over the byte-pair
		// vocabulary, saved in the test's home folder; returns its path.
		// As "gemma3": 8-value heads (narrower than 32 / 2) with query and
		// key norms, post-norms, a sliding window of 2 and capped logits.
		// As "phi3": query, key and value in one matrix, gate and up in one,
		// RoPE over 8 of 16 head values with LongRoPE factors.
		// As "gemma4": three layers, sliding ones with 4-value heads around a
		// global one with 8, the last reading the first's cache without keys
		// or values of its own, feed-forwards of two widths, per-layer inputs
		// and output scales.
		// With `experts`, the Llama feed-forward becomes that many experts
		// (two used), each a copy of the dense weights, behind a router.
		internal def tinyModel(arch string = "llama", experts int = 0) !string {
			let gemma = arch == "gemma3"
			let names = string["token_embd.weight", "output_norm.weight", "blk.0.attn_norm.weight", "blk.0.attn_q.weight", "blk.0.attn_k.weight", "blk.0.attn_v.weight", "blk.0.attn_output.weight", "blk.0.ffn_norm.weight", "blk.0.ffn_gate.weight", "blk.0.ffn_up.weight", "blk.0.ffn_down.weight"]
			let shapes = int[][int[32, 10], int[32], int[32], int[32, 32], int[32, 16], int[32, 16], int[32, 32], int[32], int[32, 32], int[32, 32], int[32, 32]]
			if gemma {
				shapes[3] = int[32, 16]
				shapes[4] = int[32, 8]
				shapes[5] = int[32, 8]
				shapes[6] = int[16, 32]
				names.push("blk.0.attn_q_norm.weight", "blk.0.attn_k_norm.weight", "blk.0.post_attention_norm.weight", "blk.0.post_ffw_norm.weight")
				shapes.push(int[8], int[8], int[32], int[32])
			}
			// Tensor `t` takes the values of tensor `source[t]` (its dense twin).
			let source int[]
			for let t = 0; t < names.len(); t++ {
				source.push(t)
			}
			if experts > 0 {
				for let (_, t) in int[8, 9, 10] {
					names[t] = names[t].replace(".weight", "_exps.weight")
					shapes[t] = int[32, 32, experts]
				}
				names.push("blk.0.ffn_gate_inp.weight")
				shapes.push(int[32, experts])
				source.push(names.len() - 1)
			}
			let phi = arch == "phi3"
			if phi {
				names = string["token_embd.weight", "output_norm.weight", "blk.0.attn_norm.weight", "blk.0.attn_qkv.weight", "blk.0.attn_output.weight", "blk.0.ffn_norm.weight", "blk.0.ffn_up.weight", "blk.0.ffn_down.weight", "rope_factors_short.weight", "rope_factors_long.weight"]
				shapes = int[][int[32, 10], int[32], int[32], int[32, 64], int[32, 32], int[32], int[32, 64], int[32, 32], int[4], int[4]]
			}
			// Qwen 3.5: a Gated DeltaNet layer, then a gated attention layer.
			let hybrid = arch == "qwen35"
			if hybrid {
				names = string["token_embd.weight", "output_norm.weight",
					"blk.0.attn_norm.weight", "blk.0.attn_qkv.weight", "blk.0.attn_gate.weight", "blk.0.ssm_conv1d.weight", "blk.0.ssm_dt.bias", "blk.0.ssm_a", "blk.0.ssm_beta.weight", "blk.0.ssm_alpha.weight", "blk.0.ssm_norm.weight", "blk.0.ssm_out.weight", "blk.0.post_attention_norm.weight", "blk.0.ffn_gate.weight", "blk.0.ffn_up.weight", "blk.0.ffn_down.weight",
					"blk.1.attn_norm.weight", "blk.1.attn_q.weight", "blk.1.attn_k.weight", "blk.1.attn_v.weight", "blk.1.attn_q_norm.weight", "blk.1.attn_k_norm.weight", "blk.1.attn_output.weight", "blk.1.post_attention_norm.weight", "blk.1.ffn_gate.weight", "blk.1.ffn_up.weight", "blk.1.ffn_down.weight"]
				shapes = int[][int[32, 10], int[32],
					int[32], int[32, 32], int[32, 16], int[4, 32], int[2], int[2], int[32, 2], int[32, 2], int[8], int[16, 32], int[32], int[32, 32], int[32, 32], int[32, 32],
					int[32], int[32, 32], int[32, 8], int[32, 8], int[8], int[8], int[16, 32], int[32], int[32, 32], int[32, 32], int[32, 32]]
			}
			let gemma4 = arch == "gemma4"
			if gemma4 {
				names = string["token_embd.weight", "output_norm.weight", "rope_freqs.weight", "per_layer_token_embd.weight", "per_layer_model_proj.weight", "per_layer_proj_norm.weight"]
				shapes = int[][int[32, 10], int[32], int[4], int[12, 10], int[32, 12], int[4]]
				for let n = 0; n < 3; n++ {
					let p = "blk.{n}."
					let hs = n == 1 ?? (8, 4)
					let ffn = n == 0 ?? (32, 64)
					names.push(p + "attn_norm.weight", p + "attn_q.weight", p + "attn_q_norm.weight", p + "attn_output.weight", p + "post_attention_norm.weight", p + "ffn_norm.weight", p + "ffn_gate.weight", p + "ffn_up.weight", p + "ffn_down.weight", p + "post_ffw_norm.weight", p + "inp_gate.weight", p + "proj.weight", p + "post_norm.weight", p + "layer_output_scale.weight")
					shapes.push(int[32], int[32, 2 * hs], int[hs], int[2 * hs, 32], int[32], int[32], int[32, ffn], int[32, ffn], int[ffn, 32], int[32], int[32, 4], int[4, 32], int[32], int[1])
					if n < 2 {
						names.push(p + "attn_k.weight", p + "attn_v.weight", p + "attn_k_norm.weight")
						shapes.push(int[32, hs], int[32, hs], int[hs])
					}
				}
				source.len(0)
				for let t = 0; t < names.len(); t++ {
					source.push(t)
				}
			}
			let out byte[]
			put(out, 0x46554747, 4)
			put(out, 3, 4)
			put(out, names.len(), 8)
			put(out, gemma ?? (17, phi ?? (16, experts > 0 ?? (15, hybrid ?? (21, gemma4 ?? (22, 13))))), 8)
			putText(out, "general.architecture", arch)
			putUint(out, arch + ".block_count", hybrid ?? (2, gemma4 ?? (3, 1)))
			putUint(out, arch + ".embedding_length", 32)
			putUint(out, arch + ".attention.head_count", 2)
			putUint(out, arch + ".attention.head_count_kv", 1)
			putUint(out, arch + ".context_length", 64)
			if gemma {
				putUint(out, "gemma3.attention.key_length", 8)
				putUint(out, "gemma3.attention.value_length", 8)
				putUint(out, "gemma3.attention.sliding_window", 2)
				putFloat(out, "gemma3.final_logit_softcapping", 5.0)
			}
			if gemma4 {
				putUint(out, "gemma4.attention.key_length", 8)
				putUint(out, "gemma4.attention.value_length", 8)
				putUint(out, "gemma4.attention.key_length_swa", 4)
				putUint(out, "gemma4.attention.value_length_swa", 4)
				putUint(out, "gemma4.attention.sliding_window", 2)
				putBools(out, "gemma4.attention.sliding_window_pattern", bool[true, false, true])
				putUint(out, "gemma4.attention.shared_kv_layers", 1)
				putUint(out, "gemma4.embedding_length_per_layer_input", 4)
				putFloat(out, "gemma4.final_logit_softcapping", 5.0)
			}
			if experts > 0 {
				putUint(out, arch + ".expert_count", experts)
				putUint(out, arch + ".expert_used_count", 2)
			}
			if hybrid {
				putUint(out, "qwen35.attention.key_length", 8)
				putUint(out, "qwen35.attention.value_length", 8)
				putUint(out, "qwen35.rope.dimension_count", 4)
				putUint(out, "qwen35.full_attention_interval", 2)
				putUint(out, "qwen35.ssm.group_count", 1)
				putUint(out, "qwen35.ssm.time_step_rank", 2)
				putUint(out, "qwen35.ssm.state_size", 8)
				putUint(out, "qwen35.ssm.conv_kernel", 4)
			}
			if phi {
				putUint(out, "phi3.rope.dimension_count", 8)
				putUint(out, "phi3.rope.scaling.original_context_length", 16)
				putFloat(out, "phi3.rope.scaling.attn_factor", 1.2)
			}
			putText(out, "tokenizer.ggml.model", "gpt2")
			putText(out, "tokenizer.ggml.pre", "smollm")
			putStrings(out, "tokenizer.ggml.tokens", string["<|endoftext|>", "a", "b", "Ġ", "ab", "Ġab", "!", "1", "2", "<|im_end|>"])
			putInts(out, "tokenizer.ggml.token_type", int[3, 1, 1, 1, 1, 1, 1, 1, 1, 3])
			putStrings(out, "tokenizer.ggml.merges", string["a b", "Ġ ab"])
			putUint(out, "tokenizer.ggml.bos_token_id", 0)
			putUint(out, "tokenizer.ggml.eos_token_id", 0)
			let offset = 0
			for let (t, name) in names {
				putTensor(out, name, shapes[t], offset)
				let count = 1
				for let (_, n) in shapes[t] {
					count *= n
				}
				offset += count * 4
			}
			for out.len() % 32 != 0 {
				out.push(byte(0))
			}
			for let (t, name) in names {
				let count = 1
				for let (_, n) in shapes[t] {
					count *= n
				}
				let norm = name.endsWith("norm.weight") || name.startsWith("rope_factors") || name.startsWith("rope_freqs")
				let each = name.endsWith("_exps.weight") ?? (count / experts, count)
				let from = t < source.len() ?? (source[t], t)
				for let k = 0; k < count; k++ {
					put(out, int(__bitcast_u32_from_f32(norm ?? (float32(1 + k % 2), weight(from, k % each)))), 4)
				}
			}
			let path = os.join(try os.appHome(), "tiny-{arch}-{experts}.gguf")
			try os.writeFile(path, out)
			return path
		}

		internal def pieces(splitter PreTokenizer, text string) string[] {
			let out string[]
			for let (_, p) in splitter.split(text.bytes()) {
				out.push(string(p))
			}
			return out
		}

		@test()
		def TestBytePairEncoding() !none {
			let t = try bytePairs()
			assert t.size() == 10 && t.startToken() == 0 && t.endToken() == 0
			// The model does not ask for a start token, so none is added.
			assert t.encode("ab ab!12").equals(int[4, 5, 6, 7, 8])
			assert t.encode("<|endoftext|>ab").equals(int[0, 4])
			assert t.decode(int[4, 5, 6]) == "ab ab!"
			assert t.decode(int[0, 1]) == "a"
			assert t.isEnd(0) && t.isEnd(9) && !t.isEnd(4)
			return none
		}

		@test()
		def TestSentencePieceEncoding() !none {
			let t = try sentencePiece()
			assert t.encode("ab!").equals(int[1, 8, 9])
			assert t.encode("ab!", false).equals(int[8, 9])
			assert t.decode(int[8, 9]) == " ab!"
			assert t.piece(9).equals(byte[byte(0x21)])
			assert t.piece(1).len() == 0
			return none
		}

		@test()
		def TestCharacterPairEncoding() !none {
			let t = try characterPairs()
			// The start token always opens; a run of newlines that is a token
			// stays whole, and what no merge covers becomes byte tokens.
			assert t.encode("ab ab\n\nab!").equals(int[2, 6, 7, 9, 6, 10])
			assert t.encode("a\n\n\nb", false).equals(int[3, 8, 8, 8, 4])
			assert t.decode(int[6, 7, 9, 6, 10]) == "ab ab\n\nab!"
			return none
		}

		@test()
		def TestUnsupportedTokenizer() !none {
			let file = try tokenizerFile(2, def (out byte[]) {
				putText(out, "tokenizer.ggml.model", "t5")
				putStrings(out, "tokenizer.ggml.tokens", string["a"])
			})
			return testing.expectError(loadTokenizer(file))
		}

		@test()
		def TestGpt2PreTokenizer() !none {
			let gpt2 = new PreTokenizer(Digits.Runs, false)
			assert pieces(gpt2, "Hello world's 123  x\n").equals(string["Hello", " world", "'s", " 123", " ", " x", "\n"])
			let smollm = new PreTokenizer(Digits.Single, false)
			assert pieces(smollm, "a 12").equals(string["a", " ", "1", "2"])
			assert pieces(gpt2, "héllo, мир").equals(string["héllo", ",", " мир"])
			return none
		}

		@test()
		def TestGpt4oPreTokenizer() !none {
			let cased = new PreTokenizer(Digits.Triples, true, true)
			assert pieces(cased, "HelloWorld XMLHttpRequest").equals(string["Hello", "World", " XMLHttp", "Request"])
			assert pieces(cased, " don't I'LL").equals(string[" don't", " I'LL"])
			// Letters outside ASCII count as both cases.
			assert pieces(cased, " ÉCOLE café").equals(string[" É", "COLE", " café"])
			assert pieces(cased, "12345 a/b/\nend").equals(string["123", "45", " a", "/b", "/\n", "end"])
			return none
		}

		@test()
		def TestLlama3PreTokenizer() !none {
			let llama3 = new PreTokenizer(Digits.Triples, true)
			assert pieces(llama3, "I'M 12345 ok.\n\nNo").equals(string["I", "'M", " ", "123", "45", " ok", ".\n\n", "No"])
			let qwen = new PreTokenizer(Digits.Single, true)
			assert pieces(qwen, "x=12").equals(string["x", "=", "1", "2"])
			return none
		}

		@test()
		def TestUnicodeClasses() !none {
			assert unicode.isLetter(0x41) && unicode.isLetter(0x416) && unicode.isLetter(0x4E2D)
			assert !unicode.isLetter(0x31) && unicode.isNumber(0x31) && unicode.isNumber(0x0663)
			assert unicode.isSpace(0x20) && unicode.isSpace(0x3000) && !unicode.isSpace(0x41)
			return none
		}

		@test()
		def TestUtf8Helpers() !none {
			let text = "aé€😀"
			let runes = runesOf(text.bytes())
			assert runes.equals(int[0x61, 0xE9, 0x20AC, 0x1F600])
			let joined = ""
			for let (_, r) in runes {
				joined = joined + encodeRune(r)
			}
			assert joined == text
			let bytes = "é€".bytes()
			assert completeUtf8(bytes) == 5
			assert completeUtf8(bytes[:4]) == 2
			assert completeUtf8(bytes[:1]) == 0
			assert byteToken(0x0A) == "<0x0A>" && hexValue("<0x3F>".bytes(), 3) == 0x3F
			return none
		}

		@test()
		def TestTopCandidates() !none {
			let logits = float32[0.5, 3, -1, 2, 7, 2]
			assert topCandidates(logits, 3).equals(int[4, 1, 3])
			assert topCandidates(logits, 6)[5] == 2
			return none
		}

		@test()
		def TestTinyGemmaModel() !none {
			let model = try load(try tinyModel("gemma3"))
			assert model.info.architecture == "gemma3" && model.info.heads == 2
			let chat = model.session()
			chat.temperature = 0.0
			chat.limit = 6
			let text = try chat.generate("ab")
			assert chat.stats().generatedTokens <= 6
			let again = model.session()
			again.temperature = 0.0
			again.limit = 6
			assert (try again.generate("ab")) == text
			return none
		}

		@test()
		def TestTinyGemma4Model() !none {
			let path = try tinyModel("gemma4")
			let parts = try readParts(try ai.load(path))
			// The last layer slides and reads the first's cache; only the
			// global layer divides its frequencies by rope_freqs.
			assert parts.layers[0].headSize == 4 && parts.layers[1].headSize == 8 && parts.layers[2].headSize == 4
			assert parts.layers[0].sharedCache == -1 && parts.layers[1].sharedCache == -1 && parts.layers[2].sharedCache == 0
			assert parts.layers[0].window == 2 && parts.layers[1].window == 0
			assert parts.layers[0].ropeFactors.len() == 0 && parts.layers[1].ropeFactors.len() == 4
			assert parts.layerWidth == 4 && parts.layers[2].gate.rows == 64
			let model = try load(path)
			assert model.info.architecture == "gemma4" && model.info.layers == 3
			let one = model.session()
			one.batch = 1
			one.temperature = 0.0
			one.limit = 6
			let many = model.session()
			many.batch = 4
			many.temperature = 0.0
			many.limit = 6
			let prompt = "ab ab!12 ab a b"
			assert (try one.generate(prompt)) == (try many.generate(prompt))
			assert one.length() == many.length()
			return none
		}

		@test()
		def TestTinyPhiModel() !none {
			let model = try load(try tinyModel("phi3"))
			assert model.info.architecture == "phi3" && model.info.embedding == 32
			// A context past the original 16 turns with the long factors.
			for let (_, context) in int[16, 64] {
				let chat = model.session(context)
				chat.temperature = 0.0
				chat.limit = 6
				let text = try chat.generate("ab")
				let again = model.session(context)
				again.temperature = 0.0
				again.limit = 6
				assert (try again.generate("ab")) == text
			}
			return none
		}

		@test()
		def TestTinyMixtureOfExperts() !none {
			// Experts that all copy the dense feed-forward, weighted to a sum
			// of one, give the dense model's output.
			let dense = try load(try tinyModel())
			let mixed = try load(try tinyModel("llama", 3))
			let a = dense.session()
			let b = mixed.session()
			for let (_, s) in Session[a, b] {
				s.temperature = 0.0
				s.limit = 8
			}
			assert (try a.generate("ab")) == (try b.generate("ab"))
			return none
		}

		@test()
		def TestClampedSwiglu() !none {
			// Nine values: eight in vector lanes, one in the scalar tail.
			let gate = float32[0, 10, -1, 0, 0, 0, 0, 0, 10]
			let up = float32[0, 10, -10, 0, 0, 0, 0, 0, 10]
			clampedSwiglu(gate, up)
			// min(g, 7)·sigmoid(1.702·min(g, 7))·(clamp(u, ±7) + 1)
			assert (float(gate[1]) - 55.99963).abs() < 0.001 && (float(gate[8]) - 55.99963).abs() < 0.001
			assert (float(gate[2]) - 0.925236).abs() < 0.0001 && gate[0] == float32(0)
			return none
		}

		@test()
		def TestTinyModel() !none {
			let model = try load(try tinyModel())
			let info = model.info
			assert info.architecture == "llama" && info.layers == 1 && info.embedding == 32
			assert info.heads == 2 && info.kvHeads == 1 && info.contextLength == 64
			assert info.vocabulary == 10 && info.weightType == "F32"
			let chat = model.session()
			chat.temperature = 0.0
			chat.limit = 5
			let text = try chat.generate("ab")
			let stats = chat.stats()
			assert stats.promptTokens == 1 && stats.generatedTokens <= 5
			assert chat.length() == 1 + stats.generatedTokens
			// Greedy decoding gives the same text every time.
			let again = model.session()
			again.temperature = 0.0
			again.limit = 5
			assert (try again.generate("ab")) == text
			chat.reset()
			assert chat.length() == 0 && chat.stats().generatedTokens == 0
			return none
		}

		@test()
		def TestSeededSampling() !none {
			let model = try load(try tinyModel())
			let first = model.session()
			first.seed = uint(7)
			first.temperature = 1.0
			first.limit = 8
			let second = model.session()
			second.seed = uint(7)
			second.temperature = 1.0
			second.limit = 8
			assert (try first.generate("a")) == (try second.generate("a"))
			return none
		}

		@test()
		def TestSessionLimits() !none {
			let model = try load(try tinyModel())
			let small = model.session(3)
			try testing.expectError(small.append("ab ab!12"))
			let chat = model.session()
			chat.limit = 0
			try chat.append("a")
			assert (try chat.next()) is none
			try testing.expectError(load(try tinyModel(), Device.Gpu)) unless gpu.available()
			return none
		}

		@test()
		def TestDocumentsGoBeforeTheText() !none {
			let doc = new Document("Contract")
			doc.heading(1, "Terms")
			doc.paragraph("Pay within 30 days.")
			let shown = withDocuments(Message{role: Role.User, text: "Summarise.", documents: [doc]})
			assert shown.text.contains("Pay within 30 days.") && shown.text.endsWith("Summarise.")
			assert shown.text.indexOf("Terms") < shown.text.indexOf("Summarise.")
			let plain = Message{role: Role.User, text: "Hi"}
			assert withDocuments(plain).text == "Hi"
			let model = try load(try tinyModel())
			let chat = model.session()
			chat.limit = 2
			try chat.ask("a", documents = [doc])
			assert !model.info.vision && !model.info.audio
			try testing.expectError(chat.ask("a", images = [new Image(4, 4)]))
			return none
		}

		@test()
		def TestImageSizes() !none {
			// Sides round to multiples of 48, within 70 to 1120 tokens of 48².
			let (w, h) = targetSize(900, 360, 48, 70 * 48 * 48, 1120 * 48 * 48)
			assert w == 912 && h == 384
			let (bw, bh) = targetSize(4000, 3000, 48, 70 * 48 * 48, 1120 * 48 * 48)
			assert bw % 48 == 0 && bh % 48 == 0 && bw * bh <= 1120 * 48 * 48 && bw > bh
			let (sw, sh) = targetSize(20, 20, 48, 70 * 48 * 48, 1120 * 48 * 48)
			assert sw == sh && sw * sh >= 70 * 48 * 48
			return none
		}

		// Needs ADM_TEST_GEMMA4_PROJECTOR: the gemma4 E2B projector file
		// (Ollama's sha256-7ba3bb… blob). The checkerboard's rows were checked
		// against llama.cpp b11261 mtmd-debug (equal within its BF16 rounding
		// once both use the same GELU; llama.cpp takes quick GELU for this
		// file, Gemma 4 defines the tanh form used here).
		@test()
		def TestGemma4VisionEncoder() !none {
			let path = Runtime.getEnv("ADM_TEST_GEMMA4_PROJECTOR")
			return none when path is none || path.len() == 0
			let projector = try readProjector(path, 1536)
			let vision = projector.vision
			fail "the projector has no image encoder" when vision is none
			let img = new Image(96, 96)
			let data = img.raw()
			for let y = 0; y < 96; y++ {
				for let x = 0; x < 96; x++ {
					let v = (x + y) % 2 == 1 ?? (byte(0), byte(255))
					for let c = 0; c < 4; c++ {
						data[y * img.stride() + x * 4 + c] = c == 3 ?? (byte(255), v)
					}
				}
			}
			vision.minTokens = 1
			let rows = vision.encode(img)
			assert rows.rows == 4 && rows.cols == 1536
			let want = float32[0.096087, 0.549058, 0.420262]
			for let (i, v) in want {
				assert (rows.row(0)[i] - v).abs() < float32(0.001)
			}
			return none
		}

		@test()
		def TestGpuMatchesCpu() !none {
			return none unless gpu.available()
			for let (_, arch) in string["llama", "gemma3"] {
				let path = try tinyModel(arch)
				let cpu = try load(path, Device.Cpu)
				let onGpu = try load(path, Device.Gpu)
				assert cpu.device == Device.Cpu && onGpu.device == Device.Gpu
				let texts string[]
				for let (_, model) in LanguageModel[cpu, onGpu] {
					let session = model.session()
					session.temperature = 0.0
					session.repeatPenalty = 1.0
					session.limit = 12
					texts.push(try session.generate("ab a"))
				}
				assert texts[0] == texts[1]
			}
			return none
		}

		// The rendered text, with the message text in [brackets].
		internal def shown(text ChatText) string {
			let out = ""
			for let (k, piece) in text.pieces {
				out = out + (text.markup[k] ?? (piece, "[{piece}]"))
			}
			return out
		}

		internal def conversation() Message[] {
			return Message[
				Message{role: Role.System, text: "Be brief."},
				Message{role: Role.User, text: " Hi "},
				Message{role: Role.Assistant, text: "Hello", thinking: "greet"},
				Message{role: Role.User, text: "Bye"},
			]
		}

		@test()
		def TestChatFormatDetection() !none {
			let cases = [
				("\{% for m in messages %\}<|im_start|>\{\{ m.role \}\}", ChatFormat.ChatMl),
				("<|im_start|>\{\{ role \}\}<|im_sep|>", ChatFormat.Phi4),
				("<|start_header_id|>\{\{ role \}\}<|end_header_id|>", ChatFormat.Llama3),
				("<start_of_turn>user", ChatFormat.Gemma),
				("<|user|>\{\{ c \}\}<|end|><|assistant|>", ChatFormat.Phi3),
				("<|start|>assistant<|channel|>final", ChatFormat.GptOss),
				("[INST] <<SYS>>", ChatFormat.Llama2System),
				("\{\{ bos_token + '[INST] ' \}\}", ChatFormat.Llama2SystemStart),
				("\{\{ '[INST] ' + content \}\}", ChatFormat.Llama2),
				("[AVAILABLE_TOOLS] [INST]", ChatFormat.MistralV1),
				("[AVAILABLE_TOOLS]\{\{ \"[INST]\" \}\}", ChatFormat.MistralV3Tekken),
				("[SYSTEM_PROMPT]\{\{ m \}\}[/SYSTEM_PROMPT][INST]", ChatFormat.MistralV7),
				("mistral-v7-tekken", ChatFormat.MistralV7Tekken),
				("chatml", ChatFormat.ChatMl),
				("gpt-oss", ChatFormat.GptOss),
			]
			for let (_, c) in cases {
				let (template, want) = c
				let found = detectChatFormat(template)
				assert !(found is none) && found == want
			}
			assert detectChatFormat("plain text") is none
			return none
		}

		@test()
		def TestChatRendering() !none {
			let all = conversation()
			assert shown(render(ChatFormat.ChatMl, all, open = true)) == "<|im_start|>system\n[Be brief.]<|im_end|>\n<|im_start|>user\n[ Hi ]<|im_end|>\n<|im_start|>assistant\n[Hello]<|im_end|>\n<|im_start|>user\n[Bye]<|im_end|>\n<|im_start|>assistant\n"
			// Thinking off on a template with enable_thinking.
			assert shown(render(ChatFormat.ChatMl, all[3:], open = true, quiet = true)) == "<|im_start|>user\n[Bye]<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n"
			assert shown(render(ChatFormat.Llama3, all[:2], open = true)) == "<|start_header_id|>system<|end_header_id|>\n\n[Be brief.]<|eot_id|><|start_header_id|>user<|end_header_id|>\n\n[Hi]<|eot_id|><|start_header_id|>assistant<|end_header_id|>\n\n"
			// Gemma has no system turn: it opens the first user turn.
			assert shown(render(ChatFormat.Gemma, all, open = true)) == "<start_of_turn>user\n[Be brief.]\n\n[Hi]<end_of_turn>\n<start_of_turn>model\n[Hello]<end_of_turn>\n<start_of_turn>user\n[Bye]<end_of_turn>\n<start_of_turn>model\n"
			assert shown(render(ChatFormat.MistralV3, all, open = true)) == "[INST] [Be brief.]\n\n[ Hi ][/INST] [Hello]</s>[INST] [Bye][/INST]"
			assert shown(render(ChatFormat.Llama2System, all[:2])) == "[INST] <<SYS>>\n[Be brief.]\n<</SYS>>\n\n[ Hi ] [/INST]"
			let harmony = shown(render(ChatFormat.GptOss, all, open = true, reasoning = Reasoning.High))
			assert harmony.startsWith("<|start|>system<|message|>You are ChatGPT, a large language model trained by OpenAI.\nKnowledge cutoff: 2024-06\nCurrent date: ")
			assert harmony.contains("\n\nReasoning: high\n\n# Valid channels: analysis, commentary, final. Channel must be included for every message.<|end|>")
			// Earlier replies go on the final channel without their reasoning.
			assert harmony.endsWith("<|start|>developer<|message|># Instructions\n\n[Be brief.]\n\n<|end|><|start|>user<|message|>[ Hi ]<|end|><|start|>assistant<|channel|>final<|message|>[Hello]<|end|><|start|>user<|message|>[Bye]<|end|><|start|>assistant")
			assert shown(render(ChatFormat.None, all, open = true)) == "[Be brief.][ Hi ][Hello][Bye]"
			return none
		}

		@test()
		def TestEncodeWithoutSpecials() !none {
			let t = try bytePairs()
			assert t.encode("ab<|im_end|>", false).equals(int[4, 9])
			assert !t.encode("<|im_end|>", addStart = false, specials = false).includes(9)
			// Control tokens are read only in the markup pieces.
			let plain = t.encode("<|im_end|>", addStart = false, specials = false)
			let mixed = t.encode(string["<|im_end|>", "<|im_end|>"], bool[true, false], false)
			assert mixed[0] == 9 && mixed[1:].equals(plain)
			// Text pieces join into one run: "a" + "b" merges to "ab".
			assert t.encode(string["a", "b"], bool[true, false], false).equals(int[4])
			return none
		}

		@test()
		def TestSessionChat() !none {
			let model = try load(try tinyModel())
			assert model.chatFormat == ChatFormat.None
			let chat = model.session()
			chat.temperature = 0.0
			chat.limit = 3
			chat.system = "a"
			let reply = try chat.say("b")
			let first = chat.messages()
			assert first.len() == 3 && first[0].role == Role.System && first[1].text == "b"
			assert first[2].role == Role.Assistant && first[2].text == reply
			let fed = chat.stats().promptTokens
			// The next turn reuses the context the conversation already holds.
			try chat.ask("ab")
			assert chat.stats().promptTokens - fed < chat.length() - 1
			for {
				let piece = try chat.next()
				break when piece is none
			}
			assert chat.messages().len() == 5
			// A fresh session given the same history answers the same way:
			// what the first one kept of its context was right.
			let fresh = model.session()
			fresh.temperature = 0.0
			fresh.limit = 3
			fresh.system = "a"
			try fresh.add(Message{role: Role.User, text: "b"})
			try fresh.add(Message{role: Role.Assistant, text: reply})
			assert (try fresh.say("ab")) == chat.messages()[4].text
			try chat.add(Message{role: Role.User, text: "a"})
			assert chat.messages().len() == 6
			chat.reset()
			assert chat.messages().len() == 1 && chat.length() == 0
			return none
		}

		// A chat template writing calls with `call` (the call's markup, from
		// `c.name` and `c.args`) and results as `tool` turns.
		internal def callTemplate(call string) string {
			let head = "\{%- for m in messages -%\}<|im_start|>\{\{ m.role \}\}\n\{% if m.tool_calls %\}\{% for t in m.tool_calls %\}\{% set c = namespace(name=t.function.name, args=t.function.arguments) %\}"
			let tail = "\{% endfor %\}\{% else %\}\{\{ m.content \}\}\{% endif %\}<|im_end|>\n\{%- endfor -%\}\{% if add_generation_prompt %\}<|im_start|>assistant\n\{% endif %\}\{# tools #\}"
			return head + call + tail
		}

		internal def learned(call string) !CallFormat {
			let source = callTemplate(call)
			let template = try jinja.parse(source, jinja.Options{trimBlocks: true, lstripBlocks: true})
			return learnCallFormat(template, source, new map<string, any>())
		}

		internal def weatherKinds() map<string, ToolParameter[]> {
			let kinds = new map<string, ToolParameter[]>()
			kinds.set("get_weather", ToolParameter[ToolParameter{name:"city", kind:ParameterKind.String}, ToolParameter{name:"days", kind:ParameterKind.Integer}])
			return kinds
		}

		internal def readsWeather(format CallFormat, reply string, text string) !none {
			let (before, calls) = readCalls(format, reply, weatherKinds())
			assert calls.len() == 1 && calls[0].name == "get_weather" && before == text
			let args = try parseJson(calls[0].arguments)
			assert textOf(entry(args, "city")) == "Paris" && textOf(entry(args, "days")) == "2"
			return none
		}

		@test()
		def TestJsonValues() !none {
			let v = try parseJson("\{\"a\": [1, 2.5, true, null, \"x\\u00e9\\n\"], \"b\": \{\}\}")
			assert reflection.keysOf(v).equals(string["a", "b"])
			let a = reflection.elements(entry(v, "a"))
			assert a.len() == 5 && textOf(a[0]) == "1" && textOf(a[1]) == "2.5" && textOf(a[2]) == "true" && textOf(a[4]) == "xé\n"
			assert toJson(v) == "\{\"a\":[1,2.5,true,null,\"xé\\n\"],\"b\":\{\}\}"
			try testing.expectError(parseJson("\{\"a\": \}"))
			let schema = toolSchema(Tool{name: "f", description: "d", parameters: ToolParameter[ToolParameter{name:"x", kind:ParameterKind.Integer, required:false}, ToolParameter{name:"u", kind:ParameterKind.String, choices:string["c", "f"]}]})
			assert toJson(schema) == "\{\"type\":\"function\",\"function\":\{\"name\":\"f\",\"description\":\"d\",\"parameters\":\{\"type\":\"object\",\"properties\":\{\"x\":\{\"type\":\"integer\"\},\"u\":\{\"type\":\"string\",\"enum\":[\"c\",\"f\"]\}\},\"required\":[\"u\"]\}\}\}"
			return none
		}

		@test()
		def TestCallFormats() !none {
			// Hermes and Qwen: JSON between <tool_call> tags.
			let hermes = try learned("<tool_call>\n\{\"name\": \"\{\{ c.name \}\}\", \"arguments\": \{\{ c.args|tojson \}\}\}\n</tool_call>")
			assert hermes.shape == CallShape.Json && hermes.nameKey == "name" && hermes.argsKey == "arguments"
			try readsWeather(hermes, "Checking.\n<tool_call>\n\{\"name\": \"get_weather\", \"arguments\": \{\"city\": \"Paris\", \"days\": 2\}\}\n</tool_call>", "Checking.")
			// Llama 3: the whole reply is the JSON call.
			let llama = try learned("\{\"name\": \"\{\{ c.name \}\}\", \"parameters\": \{\{ c.args|tojson \}\}\}")
			assert llama.shape == CallShape.Json && llama.argsKey == "parameters"
			try readsWeather(llama, "\{\"name\": \"get_weather\", \"parameters\": \{\"city\": \"Paris\", \"days\": 2\}\}", "")
			assert callStart(llama, "\{\"name\"") == 0 && callStart(llama, "Hello") < 0
			// Qwen3-Coder: XML parameters.
			let coder = try learned("<tool_call>\n<function=\{\{ c.name \}\}>\n\{% for k, v in c.args.items() %\}<parameter=\{\{ k \}\}>\n\{\{ v \}\}\n</parameter>\n\{% endfor %\}</function>\n</tool_call>")
			assert coder.shape == CallShape.Pairs
			try readsWeather(coder, "<tool_call>\n<function=get_weather>\n<parameter=city>\nParis\n</parameter>\n<parameter=days>\n2\n</parameter>\n</function>\n</tool_call>", "")
			// GLM: <arg_key>/<arg_value> pairs after the name.
			let glm = try learned("<tool_call>\{\{ c.name \}\}\n\{% for k, v in c.args.items() %\}<arg_key>\{\{ k \}\}</arg_key>\n<arg_value>\{\{ v \}\}</arg_value>\n\{% endfor %\}</tool_call>")
			assert glm.shape == CallShape.Pairs
			try readsWeather(glm, "<tool_call>get_weather\n<arg_key>city</arg_key>\n<arg_value>Paris</arg_value>\n<arg_key>days</arg_key>\n<arg_value>2</arg_value>\n</tool_call>", "")
			// Kimi K2: name, index and JSON arguments between markers.
			let kimi = try learned("<|tool_calls_section_begin|><|tool_call_begin|>functions.\{\{ c.name \}\}:\{\{ loop.index0 \}\}<|tool_call_argument_begin|>\{\{ c.args|tojson \}\}<|tool_call_end|><|tool_calls_section_end|>")
			assert kimi.shape == CallShape.NameJson
			try readsWeather(kimi, "<|tool_calls_section_begin|><|tool_call_begin|>functions.get_weather:0<|tool_call_argument_begin|>\{\"city\": \"Paris\", \"days\": 2\}<|tool_call_end|><|tool_calls_section_end|>", "")
			// gpt-oss: the recipient in the message header.
			let harmony = try learned("<|start|>assistant to=functions.\{\{ c.name \}\}<|channel|>commentary json<|message|>\{\{ c.args|tojson \}\}<|call|>")
			assert harmony.shape == CallShape.Harmony
			try readsWeather(harmony, "<|channel|>analysis<|message|>Need weather.<|end|><|start|>assistant to=functions.get_weather<|channel|>commentary json<|message|>\{\"city\": \"Paris\", \"days\": 2\}", "")
			// LFM2 writes no calls in its template; its markers name the format.
			let lfm = knownFormat("<|tool_call_start|>")
			try readsWeather(lfm, "<|tool_call_start|>[get_weather(city=\"Paris\", days=2)]<|tool_call_end|>", "")
			// Gemma 4: `call:name\{key:value\}` with strings between <|"|>.
			let gemma = try learned("<|tool_call>call:\{\{ c.name \}\}\{\{ '\{' \}\}\{% for k, v in c.args|dictsort %\}\{% if not loop.first %\},\{% endif %\}\{\{ k \}\}:\{% if v is string %\}<|\"|>\{\{ v \}\}<|\"|>\{% else %\}\{\{ v \}\}\{% endif %\}\{% endfor %\}\}<tool_call|>")
			assert gemma.shape == CallShape.Gemma4 && gemma.start == "<|tool_call>call:" && gemma.end == "<tool_call|>"
			try readsWeather(gemma, "Checking.<|tool_call>call:get_weather\{city:<|\"|>Paris<|\"|>,days:2\}<tool_call|>", "Checking.")
			let (_, nested) = readCalls(gemma, "<|tool_call>call:plan\{at:\{<|\"|>x<|\"|>:1.5,y:[true,null,<|\"|>a,b\}<|\"|>]\},n:-3\}<tool_call|>", new map<string, ToolParameter[]>())
			assert nested.len() == 1 && nested[0].arguments == "\{\"at\":\{\"x\":1.5,\"y\":[true,null,\"a,b\}\"]\},\"n\":-3\}"
			// Text that may still open a call is held back until it does or cannot.
			assert openingTail(gemma, "Hi <|tool") == 6 && openingTail(gemma, "Hi") == 0
			return none
		}

		@test()
		def TestDecisionPrompt() !none {
			let questions = Question[
				Question{name: "sentiment", text: "Feeling?", choices: string["pos", "neg"], described: string["", "unhappy"]},
				Question{name: "refund", text: "Refund?", kind: QuestionKind.YesNo},
				Question{name: "urgency", text: "Urgent?", kind: QuestionKind.Score, choices: string["low", "high"]},
			]
			// Go's encoding/json, as Ollama's decision compiler writes it.
			let want = "\{\"context\":\"a\\u003cb \\u0026 \\\"c\\\"\\n\",\"schema\":[\{\"name\":\"sentiment\",\"description\":\"Feeling?\",\"choices\":[\{\"code\":\"A\",\"value\":\"pos\",\"description\":\"pos\"\},\{\"code\":\"B\",\"value\":\"neg\",\"description\":\"unhappy\"\}]\},\{\"name\":\"refund\",\"description\":\"Refund?\",\"choices\":[\{\"code\":\"A\",\"value\":false,\"description\":\"No\"\},\{\"code\":\"B\",\"value\":true,\"description\":\"Yes\"\}]\},\{\"name\":\"urgency\",\"description\":\"Urgent?\",\"choices\":[\{\"code\":\"A\",\"value\":\"0\",\"description\":\"low\"\},\{\"code\":\"B\",\"value\":\"1\",\"description\":\"high\"\}]\}]\}"
			assert (try schemaJson("a<b & \"c\"\n", questions)) == want
			assert requestLine("sentiment") == "\n\nRequested field: \"sentiment\""
			try testing.expectError(optionsOf(Question{name: "one", choices: string["only"]}))
			return none
		}

		@test()
		def TestDecisionAnswers() !none {
			let yesNo = Question{name: "refund", kind: QuestionKind.YesNo}
			let a = answerOf(yesNo, try optionsOf(yesNo), float[0.0, math.ln(3.0)])
			assert a.choice == "yes" && (a.probability - 0.75).abs() < 1e-9 && a.choices[0].text == "no"
			let score = Question{name: "level", kind: QuestionKind.Score, choices: string["a", "b", "c"]}
			let s = answerOf(score, try optionsOf(score), float[0.0, 0.0, 0.0])
			assert (s.score - 1.0).abs() < 1e-9 && s.confidence < 1e-9 && s.choice == "0"
			let pick = Question{name: "pick", choices: string["x", "y"]}
			let p = answerOf(pick, try optionsOf(pick), float[5.0, -30.0])
			assert p.choice == "x" && p.confidence > 0.99
			// A session answers without changing its conversation.
			let model = try load(try tinyModel())
			let chat = model.session()
			// Its 64-token context is too small for the prompt: decide fails like append.
			try testing.expectError(chat.decide("ab", Question[pick, yesNo]))
			assert chat.messages().len() == 0
			return none
		}

		@test()
		def TestToolMethods() !none {
			let model = try load(try tinyModel())
			let chat = model.session()
			chat.useTool(new TestDesk())
			assert chat.tools.len() == 3
			let adder = chat.tools.find(t => t.name == "add")
			fail "no add tool" when adder is none
			assert adder.parameters.len() == 2 && adder.parameters[0].kind == ParameterKind.Integer
			assert adder.description == "Adds two numbers."
			assert runTool(adder, new ToolCall("c1", "add", "\{\"a\": 2, \"b\": 40\}")) == "42"
			// An enum parameter offers its member names; a default makes it optional.
			let speak = chat.tools.find(t => t.name == "speak")
			fail "no speak tool" when speak is none
			assert speak.description == "Says a text."
			let volume = speak.parameters[1]
			assert volume.kind == ParameterKind.String && volume.choices.equals(string["Quiet", "Normal", "Loud"]) && !volume.required
			assert volume.description == "how loud" && speak.parameters[0].required
			assert runTool(speak, new ToolCall("c2", "speak", "\{\"text\": \"hi\", \"volume\": \"Loud\"\}")) == "hi!"
			assert runTool(speak, new ToolCall("c3", "speak", "\{\"text\": \"hi\", \"volume\": \"Silent\"\}")).startsWith("error: llm: volume is one of Quiet, Normal, Loud")
			assert chat.pendingCalls().len() == 0
			try testing.expectError(chat.answer(new ToolCall("c9", "add", "\{\}"), "no reply waits"))
			return none
		}

		@test()
		def TestBatchedPrompts() !none {
			// Batched and one-at-a-time feeding give the same logits, so the
			// same greedy text, on every architecture the tiny models cover.
			for let (_, arch) in string["llama", "gemma3", "phi3"] {
				let model = try load(try tinyModel(arch))
				let one = model.session()
				one.batch = 1
				one.temperature = 0.0
				one.limit = 6
				let many = model.session()
				many.batch = 4
				many.temperature = 0.0
				many.limit = 6
				let prompt = "ab ab!12 ab a b"
				assert (try one.generate(prompt)) == (try many.generate(prompt))
				assert one.length() == many.length()
			}
			let moe = try load(try tinyModel("llama", 3))
			let a = moe.session()
			a.batch = 1
			a.temperature = 0.0
			let b = moe.session()
			b.temperature = 0.0
			assert (try a.generate("ab ab!12")) == (try b.generate("ab ab!12"))
			return none
		}

		@test()
		def TestTinyHybridModel() !none {
			let model = try load(try tinyModel("qwen35"))
			assert model.info.architecture == "qwen35" && model.info.layers == 2
			// Batched and one-at-a-time feeding agree through the recurrence.
			let one = model.session()
			one.batch = 1
			one.temperature = 0.0
			one.limit = 6
			let many = model.session()
			many.batch = 4
			many.temperature = 0.0
			many.limit = 6
			assert (try one.generate("ab ab!12 ab a b")) == (try many.generate("ab ab!12 ab a b"))
			// A conversation that goes back over its reply resumes from a saved
			// state and continues as a fresh session given the same messages.
			let chat = model.session()
			chat.temperature = 0.0
			chat.limit = 4
			let first = try chat.say("ab ab")
			let second = try chat.say("12")
			let fresh = model.session()
			fresh.temperature = 0.0
			fresh.limit = 4
			try fresh.add(Message{role: Role.User, text: "ab ab"})
			try fresh.add(Message{role: Role.Assistant, text: first})
			assert (try fresh.say("12")) == second
			return none
		}
	}
}

internal partial module std.ai.llm.testdesk {
	use std.ai.llm::(tool)

	// Tools the suite discovers through `@tool`.
	type TestDesk {
		// Adds two numbers.
		@tool(name = "add")
		def add(a int, b int) int {
			return a + b
		}

		// Echoes its text.
		@tool
		def echo(text string) string {
			return text
		}

		// Says a text.
		// @param text what to say
		// @param volume how loud
		@tool
		def speak(text string, volume Volume = Volume.Normal) string {
			return volume == Volume.Loud ?? (text + "!", text)
		}
	}

	enum Volume {
		Quiet,
		Normal,
		Loud,
	}
}
