partial module std.ai.llm {
	use (
		std.reflection
		std.proto.mcp
		std.ai.llm.calls::*
	)

	// The tools of an MCP server as tools a session offers its model: one
	// per tool of the server, described by the server's own schema, and run
	// by calling the server.
	//
	// ```
	// let client = try mcp.connect("https://tools.example.com/mcp")
	// chat.tools += try llm.toolsOf(client)
	// ```
	//
	// A tool's result is the text of its contents; a tool that fails gives
	// the model its message as an error. The client must stay open while the
	// session uses the tools. Fails when the server cannot list its tools.
	def toolsOf(client mcp.Client) !Tool[] {
		let out Tool[] = []
		for let (_, offered) in try client.tools() {
			let name = offered.name
			let parameters ToolParameter[] = []
			let properties = entry(offered.inputSchema, "properties")
			let needed string[] = []
			for let (_, key) in reflection.elements(entry(offered.inputSchema, "required")) {
				needed.push(textOf(key))
			}
			for let (_, key) in reflection.keysOf(properties) {
				let schema = reflection.entryOf(properties, key)
				match schema {
					case map<string, any>:
						parameters.push(parameterOf(key, schema, key in needed))
					default:
				}
			}
			out.push(Tool{
				name:        name,
				description: offered.description,
				parameters:  parameters,
				run:         def (call ToolCall) !string {
					let parsed = try parseJson(call.arguments)
					let arguments = new map<string, any>()
					for let (_, key) in reflection.keysOf(parsed) {
						let value = reflection.entryOf(parsed, key)
						arguments.set(key, value) unless value is none
					}
					let result = try client.call(name, arguments)
					let lines string[] = []
					for let (_, piece) in result.content {
						lines.push(piece.text) when piece.kind == mcp.ContentKind.Text
					}
					let said = lines.join("\n")
					fail said when result.isError
					return said
				},
			})
		}
		return out
	}
}
