partial module std.ai.llm {
	use (
		std.testing
		std.bytes
		std.proto.mcp
		std.ai.llm.calls::*
	)

	internal async def llmServeTools(server mcp.Server, reader bytes.Pipe, writer bytes.Pipe) {
		server.serve(reader, writer)
	}

	check "MCP tools for a session" {
		@test()
		def TestToolsOfAnMcpServer() !none {
			let server = new mcp.Server("shelf", "1.0")
			let schema = map<string, any>{"type": "object", "properties": map<string, any>{"title": map<string, any>{"type": "string", "description": "the book"}, "copies": map<string, any>{"type": "integer"}}, "required": ["title"]}
			server.tool(mcp.Tool{name: "order", description: "Orders a book.", inputSchema: schema}, def (_request mcp.Request, arguments map<string, any>) !mcp.ToolResult {
				fail "out of print" when "{arguments["title"]}" == "Lost"
				return mcp.ToolResult{content: [mcp.text("ordered {arguments["title"]}")]}
			})
			let up = new bytes.Pipe()
			let down = new bytes.Pipe()
			let serving = llmServeTools(server, up, down)
			let client = try mcp.connect(down, up)
			let tools = try toolsOf(client)
			assert tools.len() == 1 && tools[0].name == "order" && tools[0].description == "Orders a book."
			let title = tools[0].parameters[0]
			assert title.name == "title" && title.kind == ParameterKind.String && title.required && title.description == "the book"
			assert tools[0].parameters[1].kind == ParameterKind.Integer && !tools[0].parameters[1].required
			assert runTool(tools[0], new ToolCall("c1", "order", "\{\"title\": \"Dune\"\}")) == "ordered Dune"
			assert runTool(tools[0], new ToolCall("c2", "order", "\{\"title\": \"Lost\"\}")) == "error: out of print"
			try client.close()
			await serving
			return none
		}
	}
}
