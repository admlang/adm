partial module std.ai.llm {
	use (
		std.formats.image::(Image)
		std.formats.audio::(Audio)
		std.formats.docs::(Document)
	)

	// What becomes of the turns a `ChatMemory` lets go.
	enum Forgetting {
		// The model sums them up; the summary stays at the start.
		Summarize,
		// They are dropped.
		Drop,
	}

	// The summary `ChatMemory` asks the model for.
	internal struct Recap {
		// What the conversation established: facts, decisions, names,
		// numbers, and what is still open.
		summary string
	}

	// A conversation kept within a budget of tokens. Before a question is
	// sent, when it would take the conversation past `budget` tokens, and
	// after each reply that did, the older turns go: summed up by the model
	// into a short recap at the start (`Forgetting.Summarize`), or dropped.
	// The newest `keep` messages stay as they are, fewer when they and the
	// question do not fit the budget together (none when the question
	// alone takes it). The system message and the settings of the chat
	// stay. It is itself a `Chat`: hand it out where a chat goes.
	//
	//     let chat = new llm.ChatMemory(client.chat(), budget = 8000)
	//     for {
	//         print(try chat.say(try readLine()))
	//     }
	//
	// The summary is the same model's, asked in the same conversation, so
	// it costs a reply. Calls and their results stay together: a kept
	// stretch never starts with a result.
	type ChatMemory {
		// The conversation held.
		chat        Chat
		// Tokens the conversation may take before older turns go.
		budget      int
		// Messages kept as they are, the newest, at most.
		keep        int        = 6
		forgetting  Forgetting = Forgetting.Summarize
		// What the model is asked to sum the older turns up with.
		recapPrompt string     = "Sum up the conversation so far for your own later use: the facts, decisions, names and numbers it established and what is still open. Be brief; do not call tools."

		def new(chat Chat, budget int, keep int = 6) {
			self.chat = chat
			self.budget = budget
			self.keep = keep
		}

		// As `Chat.ask`, the conversation fitted to the budget with the
		// question first. Fails like it, and like `fit`.
		def ask(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !none {
			try makeRoom(Message{role: Role.User, text: text, images: images, audio: audio, documents: documents})
			return try chat.ask(text, images, audio, documents)
		}

		// As `Chat.ask`, the conversation fitted to the budget with the
		// question first. Fails like it, and like `fit`.
		def ask(message Message) !none {
			try makeRoom(message)
			return try chat.ask(message)
		}

		// As `Chat.next`; when the reply ends the conversation is fitted to
		// the budget. Fails like it, and like `fit`.
		def next() !?string {
			let piece = try chat.next()
			try fit() when piece is none && chat.pendingCalls().len() == 0
			return piece
		}

		// As `Chat.say`, the conversation fitted to the budget with the
		// question before it is sent and after the reply. Fails like it, and
		// like `fit`.
		def say(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !string {
			try makeRoom(Message{role: Role.User, text: text, images: images, audio: audio, documents: documents})
			let reply = try chat.say(text, images, audio, documents)
			try fit() when chat.pendingCalls().len() == 0
			return reply
		}

		// As `Chat.answer`; fails like it.
		def answer(call ToolCall, result string) !none {
			return try chat.answer(call, result)
		}

		// As `Chat.answer` with pictures; fails like it.
		def answer(call ToolCall, output ToolOutput) !none {
			return try chat.answer(call, output)
		}

		// As `Chat.add`; fails like it.
		def add(message Message) !none {
			return try chat.add(message)
		}

		// As `Chat.messages`: the recap (a question and its answer) first when
		// older turns were summed up.
		def messages() Message[] {
			return chat.messages()
		}

		// As `Chat.pendingCalls`.
		def pendingCalls() ToolCall[] {
			return chat.pendingCalls()
		}

		// As `Chat.useTool`.
		def useTool(value any) {
			chat.useTool(value)
		}

		// As `Chat.fill`, the conversation fitted to the budget before and
		// after it. Fails like it, and like `fit`.
		def fill(target any, text string) !none {
			try makeRoom(Message{role: Role.User, text: text})
			try chat.fill(target, text)
			return try fit()
		}

		// As `Chat.reset`.
		def reset() {
			chat.reset()
		}

		// As `Chat.length`.
		def length() int {
			return chat.length()
		}

		// As `Chat.length` of a message.
		// Fails when the chat cannot count it (a local session that cannot
		// render it).
		def length(message Message) !int {
			return try chat.length(message)
		}

		// Lets the older turns go now when the conversation takes more than
		// `budget` tokens.
		// Fails when the recap's reply fails, or the kept messages cannot be
		// added back (a local model's context).
		def fit() !none {
			return none when chat.length() <= budget
			return try forget(0)
		}

		// Lets the older turns go when `message` would take the conversation
		// past the budget.
		internal def makeRoom(message Message) !none {
			let room = try chat.length(message)
			return none when chat.length() + room <= budget
			return try forget(room)
		}

		// Lets the turns go that do not fit within the budget beside `room`
		// tokens: the newest `keep` messages stay while they fit.
		internal def forget(room int) !none {
			let all = chat.messages()
			let from = all.len() > 0 && all[0].role == Role.System ?? (1, 0)
			let turns = all[from:].clone()
			let used = room
			for let i = 0; i < from; i++ {
				used += try chat.length(all[i])
			}
			let cut = turns.len()
			for cut > 0 && turns.len() - cut < keep {
				let size = try chat.length(turns[cut - 1])
				break when used + size > budget
				used += size
				cut--
			}
			// The kept stretch starts at a user message, so no call loses
			// its result nor a result its call.
			for cut < turns.len() && turns[cut].role != Role.User {
				cut++
			}
			return none when cut == 0
			let older = turns[:cut].clone()
			let kept = turns[cut:].clone()
			let recap = ""
			if forgetting == Forgetting.Summarize {
				let written = Recap{}
				chat.reset()
				for let (_, m) in older {
					try chat.add(plain(m))
				}
				try chat.fill(written, recapPrompt)
				recap = written.summary
			}
			chat.reset()
			if recap.len() > 0 {
				try chat.add(Message{role: Role.User, text: "What did we talk about before?"})
				try chat.add(Message{role: Role.Assistant, text: recap})
			}
			for let (_, m) in kept {
				try chat.add(plain(m))
			}
			return none
		}
	}

	// `m` without its provider state: a conversation whose history
	// changed sends no signed thinking from before the change, which
	// providers refuse in an edited history.
	internal def plain(m Message) Message {
		return m when m.providerState.len() == 0
		return Message{role: m.role, text: m.text, images: m.images, audio: m.audio, videos: m.videos, documents: m.documents, thinking: m.thinking, calls: m.calls, callId: m.callId, files: m.files}
	}
}
