partial module std.ai.llm {
	use (
		std.testing
		std.services.runtime::(Runtime)
		std.ai.llm.testmodels::(tinyModel)
	)

	// A reply of `text` whose prompt and text took `tokens` tokens.
	internal def sized(text string, tokens int) ReplyEvent[] {
		return [textEvent(text), doneEvent(StopReason.End, tokens - 5, 5)]
	}

	check "Conversation memory" {
		@test()
		def TestOlderTurnsAreSummedUp() !none {
			let provider = new ScriptedProvider()
			provider.replies.push(sized("Hello Ada.", 20))
			provider.replies.push(sized("Tea, then.", 60))
			provider.replies.push(sized("\{\"summary\":\"The user is Ada.\"}", 30))
			let remote = new RemoteChat(provider, "m")
			remote.system = "Be brief."
			let chat = new ChatMemory(remote, 50, keep = 2)
			let held Chat = chat
			assert (try held.say("I am Ada.")) == "Hello Ada."
			assert remote.messages().len() == 3
			// Over the budget after the second reply: the first exchange is
			// summed up and the last two messages kept.
			assert (try chat.say("Tea or coffee?")) == "Tea, then."
			let all = chat.messages()
			assert all.len() == 5 && all[0].role == Role.System
			assert all[1].text == "What did we talk about before?" && all[2].text == "The user is Ada." && all[2].role == Role.Assistant
			assert all[3].text == "Tea or coffee?" && all[4].text == "Tea, then."
			// The recap was asked with the older turns and a schema.
			let asked = provider.requests[2]
			assert asked.messages.len() == 3 && asked.messages[0].text == "I am Ada." && !(asked.schema is none)
			return none
		}

		@test()
		def TestOlderTurnsAreDropped() !none {
			let provider = new ScriptedProvider()
			provider.replies.push(sized("One.", 10))
			provider.replies.push(sized("Two.", 30))
			provider.replies.push(sized("Three.", 70))
			let chat = new ChatMemory(new RemoteChat(provider, "m"), 50, keep = 2)
			chat.forgetting = Forgetting.Drop
			try chat.say("a")
			try chat.say("b")
			assert chat.messages().len() == 4
			// Under the budget: nothing to let go.
			try chat.fit()
			assert chat.messages().len() == 4
			try chat.say("c")
			let all = chat.messages()
			assert all.len() == 2 && all[0].text == "c" && all[1].text == "Three." && provider.requests.len() == 3
			return none
		}

		// A question that would take the conversation past the budget
		// makes room before it is sent; one that alone takes more goes
		// with no earlier turn.
		@test()
		def TestQuestionsMakeRoomBeforeTheyAreSent() !none {
			let provider = new ScriptedProvider()
			provider.replies.push(sized("One.", 20))
			provider.replies.push(sized("Two.", 40))
			provider.replies.push(sized("Three.", 45))
			let chat = new ChatMemory(new RemoteChat(provider, "m"), 50, keep = 4)
			chat.forgetting = Forgetting.Drop
			try chat.say("a")
			// 20 counted and about 24 for the question: it fits beside them.
			try chat.say("q".repeat(20))
			assert provider.requests[1].messages.len() == 3
			// 40 counted and about 14 more: the first exchange goes first.
			try chat.say("r".repeat(10))
			let sent = provider.requests[2].messages
			assert sent.len() == 3 && sent[0].text == "q".repeat(20) && sent[2].text == "r".repeat(10)
			// More than the budget alone: sent without the turns before it.
			provider.replies.push(sized("Four.", 60))
			try chat.say("s".repeat(200))
			assert provider.requests[3].messages.len() == 1
			return none
		}

		// A hosted chat counts what the provider counted and estimates what
		// was added since, at the characters a token took.
		@test()
		def TestHostedLengthEstimates() !none {
			let provider = new ScriptedProvider()
			provider.replies.push(sized("Hi.", 25))
			let remote = new RemoteChat(provider, "m")
			let question = Message{role: Role.User, text: "abcdefgh"}
			// Four characters a token before any count, and four for the message.
			assert (try remote.length(question)) == 6
			try remote.say("x".repeat(40))
			// 40 characters were 20 tokens: two a token.
			assert remote.length() == 25 && (try remote.length(question)) == 8
			try remote.add(question)
			assert remote.length() == 33
			remote.reset()
			try remote.add(question)
			assert remote.length() == 8
			return none
		}

		// A local session: its context is what is counted.
		@test()
		def TestLocalSessionStaysWithinTheBudget() !none {
			let model = try load(try tinyModel("llama"), Device.Cpu)
			let session = model.session()
			session.temperature = 0.0
			session.limit = 4
			let chat = new ChatMemory(session, 24, keep = 2)
			chat.forgetting = Forgetting.Drop
			for let k = 0; k < 6; k++ {
				try chat.say("ab ab 12")
				fail "turn {k}: {session.length()} tokens" when session.length() > 24
			}
			assert chat.messages().len() < 12
			return none
		}

		// With ADM_TEST_TUNING_MODEL (Qwen3 0.6B): the model sums up the
		// older turns, and the recap keeps what they established.
		@test()
		def TestRealModelSumsUp() !none {
			let path = Runtime.getEnv("ADM_TEST_TUNING_MODEL")
			return none when path is none || path.len() == 0
			let session = (try load(path)).session()
			session.temperature = 0.0
			session.thinking = false
			session.limit = 80
			let chat = new ChatMemory(session, 80, keep = 2)
			try chat.say("My name is Ada and my cat is called Pixel.")
			try chat.say("I live in Oslo.")
			try chat.say("What is my cat called? Answer with the name only.")
			let all = chat.messages()
			assert all[0].text == "What did we talk about before?"
			fail "recap: {all[1].text}" unless all[1].text.contains("Pixel") || all[1].text.contains("Ada")
			return none
		}
	}
}
