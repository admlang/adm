partial module std.ai.llm {
	use (
		std.errors
		std.reflection
		std.formats.image::(Image)
		std.formats.audio::(Audio)
		std.formats.docs
		std.formats.docs::(Document)
		std.ai.llm.calls::*
		std.data.encoding::(JSON)
	)

	// A conversation with a model, on this machine (`Session`) or behind a
	// provider's API (`RemoteChat`): code written against it runs on either.
	//
	//     def summarise(chat llm.Chat, text string) !string {
	//         return try chat.say("Summarise in one line: {text}")
	//     }
	interface Chat {
		// Adds a user message and opens the reply; `next` returns it.
		def ask(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !none
		// The same for a whole message (its files among the rest).
		def ask(message Message) !none
		// The next piece of the reply; none when it ends.
		def next() !?string
		// `ask`, then the whole reply.
		def say(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !string
		// The result of a call the reply is waiting for.
		def answer(call ToolCall, result string) !none
		// A finished message of any role, added without a reply.
		def add(message Message) !none
		// The conversation so far, the system message first.
		def messages() Message[]
		// The calls of the reply still waiting for an `answer`.
		def pendingCalls() ToolCall[]
		// Offers the model every `@tool` method of `value`'s type.
		def useTool(value any)
		// Asks `text` and fills `target` (a struct) from an answer held to
		// its JSON Schema.
		def fill(target any, text string) !none
		// Forgets the messages; the settings stay.
		def reset()
		// Tokens the conversation takes: a local session's context, a hosted
		// one's prompt and reply as the provider counted them last.
		def length() int
	}

	// Tokens a hosted model counted for one reply, or for every reply
	// since `RemoteChat.reset`.
	struct Usage {
		// Prompt tokens, those read from the provider's cache included.
		inputTokens      int
		// Generated tokens, the thinking included.
		outputTokens     int
		// Prompt tokens the provider read from its cache.
		cachedTokens     int
		// Prompt tokens the provider wrote to its cache.
		cacheWriteTokens int
		// The part of `outputTokens` the model spent thinking.
		thinkingTokens   int
	}

	// Why a hosted reply ended.
	enum StopReason {
		// The model finished its turn.
		End,
		// The reply reached `limit` tokens.
		Limit,
		// The text reached one of `stopAt`.
		Stop,
		// The model asked for tool calls.
		Calls,
		// The provider's safety system held the reply back, or the model
		// refused.
		Filtered,
	}

	// What a provider's stream reports.
	enum ReplyEventKind {
		// A piece of the answer.
		Text,
		// A piece of the reasoning before the answer.
		Thinking,
		// A tool call, complete with its arguments.
		Call,
		// The reply ended: `usage`, `stop` and `state` are set.
		Done,
	}

	// One step of a hosted reply as a `ReplyStream` reads it.
	struct ReplyEvent {
		kind  ReplyEventKind
		// The piece of a `Text` or `Thinking` event.
		text  string
		// The call of a `Call` event.
		call  ?ToolCall
		usage Usage
		stop  StopReason
		// What the provider needs back with this reply in later requests
		// (signed thinking, reasoning items), kept in
		// `Message.providerState`.
		state string
	}

	// Everything a provider is asked for one reply.
	struct ChatRequest {
		model       string
		// Instructions for the whole conversation; "" for none.
		system      string
		// The turns so far, without the system message.
		messages    Message[]
		tools       Tool[]
		// The most tokens the reply may take.
		limit       int
		// none leaves each setting at the provider's default.
		temperature ?float
		topP        ?float
		topK        ?int
		seed        ?uint
		stopAt      string[]
		// none: the model's own default, which differs between providers.
		thinking    ?bool
		reasoning   ?Reasoning
		// A JSON Schema the answer follows; none for free text.
		schema      ?map<string, any>
	}

	// The streamed reply of a provider.
	interface ReplyStream {
		// The next event; none after `Done`. Fails when the connection
		// breaks or the provider reports an error mid-reply (RemoteError).
		def next() !?ReplyEvent
		// Stops reading; the provider ends the reply.
		def close()
	}

	// A hosted model's API: what a provider library implements so that
	// `RemoteChat` can hold a conversation over it.
	interface ChatProvider {
		// Sends the request and returns the reply as it streams.
		// Fails with RemoteError when the provider refuses the request.
		def reply(request ChatRequest) !ReplyStream
	}

	// What went wrong with a hosted model's API.
	enum RemoteErrorKind {
		// The key is missing, wrong, or may not do this (401, 403).
		Auth            = "auth",
		// Too many requests or tokens for the account (429).
		RateLimited     = "ratelimited",
		// The provider is too busy now (503, 529).
		Overloaded      = "overloaded",
		// The request is wrong: an unknown setting, a prompt longer than
		// the model's context, a malformed message (400, 413, 422).
		BadRequest      = "badrequest",
		// The model, file or batch does not exist (404).
		NotFound        = "notfound",
		// The provider's safety system refused the prompt.
		ContentFiltered = "filtered",
		// The provider could not be reached, or the connection broke.
		Transport       = "transport",
		// The provider failed (500 and other 5xx).
		Server          = "server",
		// The reply is not what the provider's API sends.
		Protocol        = "protocol",
	}

	// The payload every failure of a provider library carries. `code`
	// repeats `kind.value`.
	struct RemoteError {
		message    string
		code       string
		cause      ?error
		stack      errors.StackTrace
		kind       RemoteErrorKind
		// The HTTP status; 0 when there was no reply.
		status     int
		// The provider's own error type or code ("overloaded_error",
		// "context_length_exceeded"); "" when it gave none.
		remoteCode string
		// The provider's id of the request, for its support.
		requestId  string
		// The pause the provider asked for before the next attempt.
		retryAfter ?duration
	}

	// The kind of failure an HTTP status means for a provider's API.
	def remoteErrorKind(status int) RemoteErrorKind {
		return RemoteErrorKind.Auth when status := 401 || 403
		return RemoteErrorKind.NotFound when status == 404
		return RemoteErrorKind.RateLimited when status == 429
		return RemoteErrorKind.Overloaded when status := 503 || 529
		return RemoteErrorKind.Server when status >= 500
		return RemoteErrorKind.BadRequest
	}

	// `m` with its documents written as Markdown before its text, as a
	// model that reads no documents of its own takes them; `m` itself
	// when it has none.
	def withDocuments(m Message) Message {
		return m when m.documents.len() == 0
		let text = ""
		for let (_, doc) in m.documents {
			text += new docs.Markdown().encode(doc) + "\n\n"
		}
		return Message{role: m.role, text: text + m.text, images: m.images, audio: m.audio, thinking: m.thinking, calls: m.calls, callId: m.callId, files: m.files, providerState: m.providerState}
	}

	// The JSON Schema of a tool's parameters: an object whose properties
	// are the parameters, as provider APIs take it.
	def schemaOf(tool Tool) map<string, any> {
		let properties = new map<string, any>()
		let required any[] = []
		for let (_, p) in tool.parameters {
			properties.set(p.name, parameterSchema(p))
			required.push(p.name) when p.required
		}
		return map<string, any>{"type": "object", "properties": properties, "required": required}
	}

	// A conversation with a hosted model: the messages, the tools and the
	// settings, sent whole to the provider for every reply. A provider
	// library makes one (`client.chat()`); `model` can change between
	// replies, the conversation going on with the new model.
	//
	//     let chat = client.chat()
	//     chat.system = "Answer in one sentence."
	//     chat.useTool(new Weather())
	//     try chat.ask("Do I need a coat in Oslo?")
	//     for {
	//         let piece = try chat.next()
	//         break when piece is none
	//         print(piece)
	//     }
	//     chat.model = "a-larger-model"
	//     print(try chat.say("Why?"))
	//
	// It is a `Chat`, as a `Session` is.
	type RemoteChat {
		// The provider's name of the model the next reply comes from.
		model        string
		// Instructions for the whole conversation.
		system       string
		// The tools the model may call.
		tools        Tool[]
		// How many rounds of calls one `ask` may run before the reply stops.
		toolRounds   int               = 8
		// The most tokens one reply may take.
		limit        int               = 4096
		// Settings left at none take the provider's defaults.
		temperature  ?float            = none
		topP         ?float            = none
		topK         ?int              = none
		seed         ?uint             = none
		// The reply stops when its text reaches one of these.
		stopAt       string[]
		// Whether the model reasons before it answers; none for the model's
		// own default.
		thinking     ?bool             = none
		// How long it reasons, where the provider lets that be chosen.
		reasoning    ?Reasoning        = none
		// Whether `next` also returns the thinking text. It is always kept
		// in the reply's `Message.thinking`.
		showThinking bool              = false
		// A JSON Schema the answer of each reply follows (`fill` sets one
		// from a struct), sent in the provider's own form; none for free
		// text.
		schema       ?map<string, any> = none

		internal provider     ChatProvider
		internal conversation Message[]
		internal reply        Message
		internal stream       ?ReplyStream
		internal replying     bool
		internal calls        ToolCall[]
		internal waiting      ToolCall[]
		internal results      map<string, string>
		internal rounds       int
		internal total        Usage
		internal last         Usage
		internal ended        ?StopReason

		def new(provider ChatProvider, model string) {
			self.provider = provider
			self.model = model
			self.results = new map<string, string>()
		}

		// Adds a user message and sends the conversation; `next` then
		// returns the reply as it streams. `images`, `audio` and
		// `documents` go with the text (see Message).
		// Fails with RemoteError when the provider refuses the request.
		def ask(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !none {
			return try ask(Message{role: Role.User, text: text, images: images, audio: audio, documents: documents})
		}

		// Adds `message` as the user's (its uploaded `files` among the rest)
		// and sends the conversation, as the other `ask` does.
		// Fails like it.
		def ask(message Message) !none {
			message.role = Role.User
			conversation.push(message)
			rounds = 0
			waiting.len(0)
			send() onerror (err error) {
				conversation.pop()
				return err
			}
			return none
		}

		// The next piece of the reply: none when it ends, or when it stops
		// at calls waiting for `answer`. Calls to tools that have a `run`
		// are run and the reply goes on, up to `toolRounds` rounds.
		// Fails when the stream breaks (RemoteError), or when a call's
		// round cannot be sent.
		def next() !?string {
			for {
				let current = stream
				return none when !replying || current is none
				let event = try current.next()
				if event is none {
					closeStream()
					fail RemoteError{message: "llm: the reply ended without its end event", code: "protocol", kind: RemoteErrorKind.Protocol}
				}
				match event.kind {
					case ReplyEventKind.Text:
						reply.text = reply.text + event.text
						return event.text when event.text.len() > 0
					case ReplyEventKind.Thinking:
						reply.thinking = reply.thinking + event.text
						return event.text when showThinking && event.text.len() > 0
					case ReplyEventKind.Call:
						let call = event.call
						calls.push(call) unless call is none
					case ReplyEventKind.Done:
						count(total, event.usage)
						last = event.usage
						reply.providerState = event.state
						// Calls of a reply cut short (the limit, a refusal) may be
						// incomplete: they are not run, nor kept.
						calls = ToolCall[] unless event.stop == StopReason.Calls
						reply.calls = calls
						ended = event.stop
						closeStream()
						return none unless try runCalls()
				}
			}
		}

		// `ask(text, ...)`, then `next` until it returns `none`; returns the
		// reply without the thinking. Fails like `ask` and `next`.
		def say(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !string {
			try ask(text, images, audio, documents)
			for {
				let piece = try next()
				break when piece is none
			}
			return reply.text
		}

		// Adds the result of `call` and, once every call of the reply has
		// one, sends the conversation again so `next` goes on. Fails when no
		// reply is waiting for `call`, or like `ask`.
		def answer(call ToolCall, result string) !none {
			let at = -1
			for let (k, w) in waiting {
				at = k when w.id == call.id
			}
			fail "llm: no reply is waiting for the call {call.id} ({call.name})" when at < 0
			waiting.remove(at)
			results.set(call.id, result)
			return none when waiting.len() > 0
			try continueAfterCalls()
			return none
		}

		// Asks `text` and fills `target` (a struct or type) from the answer,
		// which the provider holds to `target`'s JSON Schema (`schema` for
		// this reply).
		// Fails like `say`, and when the answer does not decode into
		// `target` (the reply was cut at `limit`).
		def fill(target any, text string) !none {
			let held = schema
			schema = try schemaFor(target)
			let answer = say(text) onerror (err error) {
				schema = held
				return err
			}
			schema = held
			try (new JSON()).decode(answer, target)
			return none
		}

		// Adds a finished message of any role without a reply: restores a
		// saved conversation, or gives examples. Never fails; `!` matches
		// `Chat`.
		def add(message Message) !none {
			conversation.push(message)
			return none
		}

		// The conversation so far, the system message first; a reply still
		// streaming is last.
		def messages() Message[] {
			let all Message[]
			all.push(Message{role: Role.System, text: system}) when system.len() > 0
			all.push(...conversation)
			return all
		}

		// The calls of the reply still waiting for an `answer`.
		def pendingCalls() ToolCall[] {
			return waiting.clone()
		}

		// Adds a tool for every `@tool` method of `value`'s type, each run on
		// `value`.
		def useTool(value any) {
			tools.push(...methodTools(value))
		}

		// Ends a reply still streaming and forgets the messages and the
		// usage; the settings and `system` stay.
		def reset() {
			closeStream()
			conversation.len(0)
			waiting.len(0)
			calls = ToolCall[]
			results = new map<string, string>()
			rounds = 0
			total = Usage{}
			last = Usage{}
			ended = none
		}

		// Tokens counted since the last reset.
		def usage() Usage {
			return total
		}

		// Tokens of the last reply's prompt and the reply, as the provider
		// counted them: what the conversation takes; 0 before the first
		// reply and after `reset`.
		def length() int {
			return last.inputTokens + last.outputTokens
		}

		// Why the last reply ended; none before the first one ends.
		def stopReason() ?StopReason {
			return ended
		}

		// Sends the conversation and opens the reply.
		internal def send() !none {
			closeStream()
			let request = ChatRequest{model: model, system: system, messages: conversation.clone(), tools: tools.clone(), limit: limit, temperature: temperature, topP: topP, topK: topK, seed: seed, stopAt: stopAt.clone(), thinking: thinking, reasoning: reasoning, schema: schema}
			stream = try provider.reply(request)
			reply = Message{role: Role.Assistant}
			conversation.push(reply)
			replying = true
			// A new array: the last reply's message keeps the old one.
			calls = ToolCall[]
			ended = none
			return none
		}

		// Closes the stream of the reply, if one is open.
		internal def closeStream() {
			replying = false
			let open = stream
			stream = none
			open.close() unless open is none
		}

		// After a reply that made calls: runs those whose tools have a `run`
		// and sends the next round when every call has a result. False when
		// the reply stays stopped (no calls, calls waiting for `answer`, or
		// `toolRounds` used up).
		internal def runCalls() !bool {
			return false when calls.len() == 0
			rounds++
			if rounds > toolRounds {
				waiting = calls.clone()
				return false
			}
			let runnable ToolCall[]
			for let (_, c) in calls {
				let t = toolNamed(c.name)
				if t is none {
					results.set(c.id, "error: there is no tool named {c.name}")
				} else if t.run is none {
					waiting.push(c)
				} else {
					runnable.push(c)
				}
			}
			try runTools(runnable)
			return false when waiting.len() > 0
			try continueAfterCalls()
			return true
		}

		// Runs `list` on tasks when there is more than one, recording each
		// result, or its error message, under the call's id.
		internal def runTools(list ToolCall[]) !none {
			if list.len() == 1 {
				results.set(list[0].id, runTool(toolNamed(list[0].name), list[0]))
				return none
			}
			let done = new channel<ToolResult>(size = list.len().max(1))
			for let (_, c) in list {
				async runToolTask(toolNamed(c.name), c, done)
			}
			for let k = 0; k < list.len(); k++ {
				let r = <-done
				results.set(r.id, r.text)
			}
			return none
		}

		// Adds the results of the last reply's calls in their order and
		// sends the next round.
		internal def continueAfterCalls() !none {
			for let (_, c) in calls {
				let result = results.get(c.id)
				conversation.push(Message{role: Role.Tool, text: result is none ?? ("", result), callId: c.id})
			}
			results = new map<string, string>()
			try send()
			return none
		}

		internal def toolNamed(name string) ?Tool {
			for let (_, t) in tools {
				return t when t.name == name
			}
			return none
		}

		internal def count(sum Usage, part Usage) {
			sum.inputTokens += part.inputTokens
			sum.outputTokens += part.outputTokens
			sum.cachedTokens += part.cachedTokens
			sum.cacheWriteTokens += part.cacheWriteTokens
			sum.thinkingTokens += part.thinkingTokens
		}
	}
}
