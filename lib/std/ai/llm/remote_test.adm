partial module std.ai.llm {
	use (
		std.testing
		std.ai.llm.testdesk::(TestDesk)
	)

	// A provider that answers each request with the next scripted reply
	// and keeps the requests it was sent.
	internal type ScriptedProvider {
		replies  ReplyEvent[][]
		requests ChatRequest[]
		closed   int

		def reply(request ChatRequest) !ReplyStream {
			fail RemoteError{message: "no reply left", code: "server", kind: RemoteErrorKind.Server, status: 500} when replies.len() == 0
			requests.push(request)
			let events = replies[0]
			replies.remove(0)
			return new ScriptedStream(self, events)
		}
	}

	internal type ScriptedStream {
		internal owner  ScriptedProvider
		internal events ReplyEvent[]
		internal at     int

		def new(owner ScriptedProvider, events ReplyEvent[]) {
			self.owner = owner
			self.events = events
		}

		def next() !?ReplyEvent {
			return none when at >= events.len()
			at++
			return events[at - 1]
		}

		def close() {
			owner.closed++
		}
	}

	internal def textEvent(text string) ReplyEvent {
		return ReplyEvent{kind: ReplyEventKind.Text, text: text}
	}

	internal def doneEvent(stop StopReason, input int, output int) ReplyEvent {
		return ReplyEvent{kind: ReplyEventKind.Done, stop: stop, usage: Usage{inputTokens: input, outputTokens: output}}
	}

	internal def callEvent(id string, name string, arguments string) ReplyEvent {
		return ReplyEvent{kind: ReplyEventKind.Call, call: new ToolCall(id, name, arguments)}
	}

	internal def pieceText(piece ?string) string {
		return piece is none ?? ("<none>", piece)
	}

	internal def stopOf(chat RemoteChat) string {
		let stop = chat.stopReason()
		return stop is none ?? ("<none>", "{stop}")
	}

	// Compiles only while a local session is a `Chat`.
	internal def sessionChat(session Session) Chat {
		return session
	}

	// Reads a `Chat` reply through the interface, so either kind of
	// conversation can be handed in.
	internal def replyOf(chat Chat, text string) !string {
		return try chat.say(text)
	}

	check "Remote chat" {
		@test()
		def TestStreamsTextAndKeepsTheConversation() !none {
			let provider = new ScriptedProvider()
			provider.replies.push([ReplyEvent{kind: ReplyEventKind.Thinking, text: "hmm"}, textEvent("Hel"), textEvent("lo"), ReplyEvent{kind: ReplyEventKind.Done, stop: StopReason.End, usage: Usage{inputTokens: 10, outputTokens: 3, cachedTokens: 4}, state: "sig-1"}])
			provider.replies.push([textEvent("Fine."), doneEvent(StopReason.Limit, 20, 2)])
			let chat = new RemoteChat(provider, "small")
			chat.system = "Be brief."
			chat.temperature = 0.5
			try chat.ask("Hi")
			let pieces string[]
			for {
				let piece = try chat.next()
				break when piece is none
				pieces.push(piece)
			}
			assert pieces.len() == 2 && pieces[0] == "Hel" && pieces[1] == "lo"
			assert stopOf(chat) == "End"
			let request = provider.requests[0]
			assert request.model == "small" && request.system == "Be brief." && request.messages.len() == 1 && "{request.temperature}" == "0.500000"
			assert request.topP is none && request.thinking is none

			// The conversation goes on with another model, the first reply's
			// provider state sent back with it.
			chat.model = "large"
			assert (try replyOf(chat, "How are you?")) == "Fine."
			let second = provider.requests[1]
			assert second.model == "large" && second.messages.len() == 3
			assert second.messages[1].role == Role.Assistant && second.messages[1].text == "Hello" && second.messages[1].thinking == "hmm" && second.messages[1].providerState == "sig-1"
			assert stopOf(chat) == "Limit"
			let used = chat.usage()
			assert used.inputTokens == 30 && used.outputTokens == 5 && used.cachedTokens == 4
			let all = chat.messages()
			assert all.len() == 5 && all[0].role == Role.System && all[4].text == "Fine."
			assert provider.closed == 2

			chat.reset()
			assert chat.messages().len() == 1 && chat.usage().inputTokens == 0 && chat.stopReason() is none
			return none
		}

		@test()
		def TestRunsToolsAndWaitsForAnswers() !none {
			let provider = new ScriptedProvider()
			provider.replies.push([textEvent("Let me add."), callEvent("c1", "add", "\{\"a\": 2, \"b\": 3}"), callEvent("c2", "echo", "\{\"text\": \"hi\"}"), doneEvent(StopReason.Calls, 5, 5)])
			provider.replies.push([callEvent("c3", "lookup", "\{}"), doneEvent(StopReason.Calls, 5, 5)])
			provider.replies.push([textEvent("It is 5."), doneEvent(StopReason.End, 5, 5)])
			let chat = new RemoteChat(provider, "m")
			chat.useTool(new TestDesk())
			chat.tools.push(Tool{name: "lookup", description: "Looks up a thing."})
			try chat.ask("2 + 3?")
			let text = ""
			for {
				let piece = try chat.next()
				break when piece is none
				text = text + piece
			}
			// Round one ran both calls on the desk; round two waits for the
			// program's answer to `lookup`.
			assert text == "Let me add."
			let tools = provider.requests[0].tools
			assert tools.len() == 4
			let second = provider.requests[1].messages
			assert second.len() == 4 && second[1].calls.len() == 2 && second[2].role == Role.Tool && second[2].callId == "c1" && second[2].text == "5" && second[3].text == "hi"
			let waiting = chat.pendingCalls()
			assert waiting.len() == 1 && waiting[0].name == "lookup"
			try chat.answer(waiting[0], "found")
			assert pieceText(try chat.next()) == "It is 5."
			assert (try chat.next()) is none
			let third = provider.requests[2].messages
			assert third[third.len() - 1].role == Role.Tool && third[third.len() - 1].text == "found"

			let refused = false
			chat.answer(waiting[0], "again") onerror (err error) {
				refused = err.message.contains("no reply is waiting")
				recover none
			}
			assert refused
			return none
		}

		@test()
		def TestToolRoundsAreBounded() !none {
			let provider = new ScriptedProvider()
			provider.replies.push([callEvent("a", "echo", "\{\"text\": \"1\"}"), doneEvent(StopReason.Calls, 1, 1)])
			provider.replies.push([callEvent("b", "echo", "\{\"text\": \"2\"}"), doneEvent(StopReason.Calls, 1, 1)])
			let chat = new RemoteChat(provider, "m")
			chat.useTool(new TestDesk())
			chat.toolRounds = 1
			assert (try chat.say("loop")) == ""
			assert provider.requests.len() == 2 && chat.pendingCalls().len() == 1
			return none
		}

		// A reply cut at the limit runs none of its calls, which may be
		// incomplete, and does not keep them.
		@test()
		def TestCutRepliesRunNoCalls() !none {
			let provider = new ScriptedProvider()
			provider.replies.push([callEvent("a", "echo", "\{\"text\": \"1"), doneEvent(StopReason.Limit, 1, 1)])
			let chat = new RemoteChat(provider, "m")
			chat.useTool(new TestDesk())
			assert (try chat.say("echo")) == ""
			assert provider.requests.len() == 1 && chat.pendingCalls().len() == 0 && chat.messages()[1].calls.len() == 0
			return none
		}

		@test()
		def TestFailuresLeaveTheConversation() !none {
			let provider = new ScriptedProvider()
			let chat = new RemoteChat(provider, "m")
			let kind = RemoteErrorKind.Protocol
			chat.ask("hello") onerror (err error) {
				kind = err.kind when err is RemoteError
				recover none
			}
			assert kind == RemoteErrorKind.Server && chat.messages().len() == 0

			// A stream that ends without its end event is a protocol error.
			provider.replies.push([textEvent("cut")])
			try chat.ask("again")
			assert pieceText(try chat.next()) == "cut"
			chat.next() onerror (err error) {
				kind = err.kind when err is RemoteError
				recover none
			}
			assert kind == RemoteErrorKind.Protocol
			assert (try chat.next()) is none
			return none
		}

		@test()
		def TestStatusKindsAndToolSchemas() {
			assert remoteErrorKind(401) == RemoteErrorKind.Auth && remoteErrorKind(403) == RemoteErrorKind.Auth
			assert remoteErrorKind(404) == RemoteErrorKind.NotFound && remoteErrorKind(429) == RemoteErrorKind.RateLimited
			assert remoteErrorKind(529) == RemoteErrorKind.Overloaded && remoteErrorKind(503) == RemoteErrorKind.Overloaded
			assert remoteErrorKind(500) == RemoteErrorKind.Server && remoteErrorKind(400) == RemoteErrorKind.BadRequest
			let tool = Tool{name: "add", parameters: [ToolParameter{name: "a", kind: ParameterKind.Integer}, ToolParameter{name: "note", kind: ParameterKind.String, required: false, choices: ["x", "y"]}]}
			let schema = schemaOf(tool)
			assert "{schema["type"]}" == "object"
			let required = schema["required"]
			assert required is any[] && required.len() == 1
			let properties = schema["properties"]
			assert properties is map<string, any> && properties.len() == 2
		}
	}
}
