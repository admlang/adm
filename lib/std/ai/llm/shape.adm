internal partial module std.ai.llm.calls {
	use (
		std.reflection
		std.data.encoding::(JSON)
		std.data.encoding.jsonschema
		std.text.regex
		std.text.regex::(Program)
	)

	// Structured output: a recognizer of the JSON texts a JSON Schema
	// allows, fed a reply byte by byte, so sampling keeps only the tokens
	// whose bytes it accepts. It accepts a prefix only when some value the
	// schema allows starts with it, so sampling never walks into a dead
	// end. It reads:
	//
	// - objects: `properties`, `required`, `additionalProperties` (absent:
	//   only the declared properties when there are any, else any key),
	//   `patternProperties`, `propertyNames`, `minProperties`,
	//   `maxProperties`;
	// - arrays: `items`, `prefixItems` (and the older array `items` with
	//   `additionalItems`), `minItems`, `maxItems`;
	// - strings: `minLength`, `maxLength` (characters), `pattern` (RE2
	//   syntax, matched anywhere unless anchored, on the decoded text) and
	//   `format` (date, time, date-time, duration, email, hostname, ipv4,
	//   ipv6, uuid, uri; others do not narrow);
	// - numbers and integers: `minimum`, `maximum`, `exclusiveMinimum`,
	//   `exclusiveMaximum` (numbers or the older booleans), `multipleOf`;
	//   a bounded number is written without an exponent;
	// - `enum`, `const`, `type` lists, `anyOf`, `oneOf` (as one of them),
	//   `allOf` (merged), `$ref` to the schema itself (`#`, `#/$defs/...`,
	//   `#/definitions/...`, any JSON pointer in it, recursion included),
	//   `true`, `false`, and `{}` for any JSON.
	//
	// Not narrowed: `uniqueItems`, `contains`, `not`, `if`/`then`/`else`,
	// `dependentRequired`, `dependentSchemas`, references to other
	// documents.

	// What a schema node allows.
	enum ShapeKind {
		Any,
		// Nothing (the `false` schema).
		Never,
		Object,
		Array,
		Text,
		Number,
		Integer,
		Boolean,
		Null,
		// One of `constants` (JSON texts).
		Constant,
		// One of `options`.
		Either,
		// The node `target` (a `$ref`).
		Ref,
		// `constants[0]`, then any bytes: a tool call's markup, after which
		// the call is read by the call parser.
		Free,
	}

	// A schema compiled for recognizing.
	type ShapeNode {
		kind         ShapeKind
		// Object: the declared properties, in order, and the required ones.
		names        string[]
		values       ShapeNode[]
		required     string[]
		// Object: whether keys beyond the declared may come, and the value
		// they take; keys matching `keyPatterns` take the matching
		// `keyValues`; `keyNames` constrains the other keys; key counts.
		extraAllowed bool          = false
		extra        ?ShapeNode    = none
		keyPatterns  Pattern[]     = []
		keyValues    ShapeNode[]   = []
		keySchemas   any[]         = []
		keyNames     ?ShapeNode    = none
		leastKeys    int           = 0
		mostKeys     int           = -1
		// Array: the nodes of the first items, the node of the rest, and
		// the count bounds (-1 for none).
		prefix       ShapeNode[]   = []
		items        ?ShapeNode
		least        int           = 0
		most         int           = -1
		// Text: length bounds in characters (-1 for none) and the patterns
		// the text matches (`pattern`, `format`).
		shortest     int           = 0
		longest      int           = -1
		patterns     Pattern[]     = []
		// Number: the bounds (open when exclusive) and the step values are
		// multiples of (0 for none).
		low          float         = 0.0
		high         float         = 0.0
		lowSet       bool          = false
		highSet      bool          = false
		lowOpen      bool          = false
		highOpen     bool          = false
		step         float         = 0.0
		constants    string[]
		options      ShapeNode[]
		// Ref: the node referred to, kept alive by the root's `kept`.
		weak target  ?ShapeNode
		// Root: the nodes `$ref`s name, and the compiler (which a key
		// several patterns match asks for their schemas together).
		kept         ShapeNode[]   = []
		compiler     ?ShapeContext
		weak book    ?ShapeContext

		def new(kind ShapeKind) {
			self.kind = kind
		}

		// The node of property `name`; none when the object declares no
		// such property.
		def property(name string) ?ShapeNode {
			for let (k, n) in names {
				return values[k] when n == name
			}
			return none
		}

		// Whether a number has bounds or a step (and is written without an
		// exponent).
		def bounded() bool {
			return lowSet || highSet || step > 0.0
		}

		// Takes every field of `other`, keeping this node (what `$ref`s to
		// it hold).
		def become(other ShapeNode) {
			kind = other.kind
			names = other.names
			values = other.values
			required = other.required
			extraAllowed = other.extraAllowed
			extra = other.extra
			keyPatterns = other.keyPatterns
			keyValues = other.keyValues
			keySchemas = other.keySchemas
			book = other.book
			keyNames = other.keyNames
			leastKeys = other.leastKeys
			mostKeys = other.mostKeys
			prefix = other.prefix
			items = other.items
			least = other.least
			most = other.most
			shortest = other.shortest
			longest = other.longest
			patterns = other.patterns
			low = other.low
			high = other.high
			lowSet = other.lowSet
			highSet = other.highSet
			lowOpen = other.lowOpen
			highOpen = other.highOpen
			step = other.step
			constants = other.constants
			options = other.options
			target = other.target
		}
	}

	// The node `node` stands for: what a `$ref` names, followed.
	internal def resolved(node ShapeNode) ShapeNode {
		let at = node
		for let hops = 0; at.kind == ShapeKind.Ref && hops < 64; hops++ {
			let next = at.target
			return new ShapeNode(ShapeKind.Never) when next is none
			at = next
		}
		return at
	}

	// The node a JSON Schema (as JSON.parse builds it) describes.
	// Fails when a `pattern` is not valid RE2 syntax, a `$ref` names
	// nothing in the schema, or `allOf`s nest past 64.
	def compileShape(schema ?any) !ShapeNode {
		let root = new ShapeNode(ShapeKind.Any)
		let context = new ShapeContext(schema, root)
		root.compiler = context
		root.become(try context.compile(schema))
		return root
	}

	// The schema being compiled, and where the nodes its `$ref`s name
	// are kept: in the root's `kept`, by position.
	internal type ShapeContext {
		root        ?any
		cache       map<string, int>
		weak keeper ?ShapeNode
		depth       int              = 0

		def new(root ?any, keeper ShapeNode) {
			self.root = root
			self.keeper = keeper
			cache = new map<string, int>()
		}

		def compile(schema ?any) !ShapeNode {
			if schema is bool {
				return new ShapeNode(schema ?? (ShapeKind.Any, ShapeKind.Never))
			}
			return new ShapeNode(ShapeKind.Any) unless schema is map<string, any>
			depth++
			fail "llm: the schema's references and allOf nest past 64" when depth > 64
			let node = try compileMap(schema)
			depth--
			return node
		}

		def compileMap(schema map<string, any>) !ShapeNode {
			let ref = schema.get("$ref")
			if ref is string {
				return try refNode(ref) unless hasRules(schema, "$ref")
				let rest = without(schema, "$ref")
				let both = new map<string, any>()
				both.set("allOf", any[map<string, any>{"$ref": ref}, rest])
				return try compile(both)
			}
			if schema.get("allOf") is any[] {
				return try compile(try merged(schema))
			}
			if schema.hasKey("const") {
				let node = new ShapeNode(ShapeKind.Constant)
				node.constants.push(jsonText(schema.get("const")))
				return node
			}
			let choices = schema.get("enum")
			if choices is any[] {
				let node = new ShapeNode(ShapeKind.Constant)
				for let (_, c) in choices {
					node.constants.push(jsonText(c))
				}
				return node
			}
			for let (_, key) in string["anyOf", "oneOf"] {
				let list = schema.get(key)
				if list is any[] && list.len() > 0 {
					let node = new ShapeNode(ShapeKind.Either)
					let rest = without(schema, key)
					let shared = hasRules(rest, "")
					for let (_, option) in list {
						if shared {
							// The rest of the schema holds for every option.
							let both = new map<string, any>()
							both.set("allOf", any[rest, option])
							node.options.push(try compile(both))
						} else {
							node.options.push(try compile(option))
						}
					}
					return node
				}
			}
			let declared = schema.get("type")
			if declared is any[] {
				let node = new ShapeNode(ShapeKind.Either)
				for let (_, one) in declared {
					let alone = without(schema, "type")
					alone.set("type", one) unless one is none
					node.options.push(try compile(alone))
				}
				return node
			}
			let kind = declared is string ?? (declared, inferredType(schema))
			match kind {
				case "object":
					return try objectShape(schema)
				case "array":
					return try arrayShape(schema)
				case "string":
					return try textShape(schema)
				case "number", "integer":
					return numberShape(schema, kind == "integer")
				case "boolean":
					return new ShapeNode(ShapeKind.Boolean)
				case "null":
					return new ShapeNode(ShapeKind.Null)
				default:
					return new ShapeNode(ShapeKind.Any)
			}
		}

		// A node that refers to the one `ref` names, compiled once.
		def refNode(ref string) !ShapeNode {
			let link = new ShapeNode(ShapeKind.Ref)
			let holder = keeper
			fail "llm: the schema's root is gone" when holder is none
			let known = cache.get(ref)
			if known is int {
				link.target = holder.kept[known]
				return link
			}
			let named = try pointed(ref)
			let node = new ShapeNode(ShapeKind.Any)
			cache.set(ref, holder.kept.len())
			holder.kept.push(node)
			node.become(try compile(named))
			link.target = node
			return link
		}

		// The part of the schema `ref` points at.
		def pointed(ref string) !any {
			fail "llm: the schema refers to {ref}, outside itself" unless ref.startsWith("#")
			let at = root
			let path = ref.slice(1)
			if path.len() > 0 {
				fail "llm: the schema's $ref {ref} is not a JSON pointer" unless path.startsWith("/")
				for let (_, raw) in path.slice(1).split("/") {
					let part = raw.replace("~1", "/", -1).replace("~0", "~", -1)
					if at is map<string, any> {
						at = at.get(part)
					} else if at is any[] && part.len() > 0 && part.isNumeric() {
						let i = parseInt<int>(part)
						at = i < at.len() ?? (at[i], none)
					} else {
						at = none
					}
					fail "llm: the schema's $ref {ref} names nothing in it" when at is none
				}
			}
			fail "llm: the schema's $ref {ref} names nothing in it" when at is none
			return at
		}

		// `schema`'s `allOf` and itself merged into one schema: properties
		// joined (one named twice held to both), required keys joined,
		// bounds the tightest, `enum`s intersected, other keywords the last
		// one's.
		def merged(schema map<string, any>) !map<string, any> {
			let out = new map<string, any>()
			try mergeInto(out, without(schema, "allOf"))
			let list = schema.get("allOf")
			if list is any[] {
				for let (_, part) in list {
					try mergeInto(out, try followed(part))
				}
			}
			return out
		}

		// `part` with its `$ref`s followed and its own `allOf` merged.
		def followed(part ?any) !map<string, any> {
			if part is bool {
				return part ?? (new map<string, any>(), map<string, any>{"enum": any[]})
			}
			return new map<string, any>() unless part is map<string, any>
			depth++
			fail "llm: the schema's references and allOf nest past 64" when depth > 64
			let ref = part.get("$ref")
			let out = new map<string, any>()
			if ref is string {
				try mergeInto(out, try followed(try pointed(ref)))
				try mergeInto(out, without(part, "$ref"))
			} else if part.get("allOf") is any[] {
				out = try merged(part)
			} else {
				out = part
			}
			depth--
			return out
		}

		def mergeInto(out map<string, any>, part map<string, any>) !none {
			for let (key, value) in part {
				continue when value is none
				let held = out.get(key)
				if held is none {
					out.set(key, value)
					continue
				}
				match key {
					case "properties":
						if held is map<string, any> && value is map<string, any> {
							let joined = new map<string, any>()
							for let (k, v) in held {
								joined.set(k, v) unless v is none
							}
							for let (k, v) in value {
								continue when v is none
								let before = joined.get(k)
								if before is none {
									joined.set(k, v)
								} else {
									joined.set(k, map<string, any>{"allOf": any[before, v]})
								}
							}
							out.set(key, joined)
						}
					case "required":
						if held is any[] && value is any[] {
							let joined = held.clone()
							for let (_, r) in value {
								joined.push(r) unless joined.includes(r)
							}
							out.set(key, joined)
						}
					case "minimum", "exclusiveMinimum", "minLength", "minItems", "minProperties":
						out.set(key, numberOf(value).max(numberOf(held))) unless value is bool
					case "maximum", "exclusiveMaximum", "maxLength", "maxItems", "maxProperties":
						out.set(key, numberOf(value).min(numberOf(held))) unless value is bool
					case "enum":
						if held is any[] && value is any[] {
							let both any[]
							for let (_, a) in held {
								for let (_, b) in value {
									if jsonText(a) == jsonText(b) {
										both.push(a)
										break
									}
								}
							}
							out.set(key, both)
						}
					case "items", "additionalProperties":
						out.set(key, map<string, any>{"allOf": any[held, value]})
					case "type":
						// The types both allow; none left, no value.
						let both any[]
						for let (_, a) in typeList(held) {
							for let (_, b) in typeList(value) {
								let common = a == b ?? (a, (a := "integer" || "number") && (b := "integer" || "number") ?? ("integer", ""))
								both.push(common) when common.len() > 0 && !both.includes(common)
							}
						}
						out.set(key, both.len() == 1 ?? (both[0], both))
						out.set("enum", any[]) when both.len() == 0
					default:
						out.set(key, value)
				}
			}
			return none
		}

		def objectShape(schema map<string, any>) !ShapeNode {
			let node = new ShapeNode(ShapeKind.Object)
			let properties = schema.get("properties")
			if properties is map<string, any> {
				for let (_, name) in properties.keys() {
					node.names.push(name)
					node.values.push(try compile(properties.get(name)))
				}
			}
			let required = schema.get("required")
			if required is any[] {
				for let (_, r) in required {
					node.required.push(r) when r is string
				}
			}
			let patterned = schema.get("patternProperties")
			if patterned is map<string, any> {
				for let (_, source) in patterned.keys() {
					node.keyPatterns.push(try patternOf(source))
					node.keyValues.push(try compile(patterned.get(source)))
					let raw = patterned.get(source)
					node.keySchemas.push(raw) unless raw is none
				}
				node.book = self
			}
			let additional = schema.get("additionalProperties")
			if additional is bool {
				node.extraAllowed = additional
			} else if additional is map<string, any> {
				node.extraAllowed = true
				node.extra = try compile(additional)
			} else {
				// Absent: the declared properties alone when there are any,
				// as a reply should not invent keys.
				node.extraAllowed = node.names.len() == 0 && node.keyPatterns.len() == 0
			}
			if schema.hasKey("propertyNames") {
				node.keyNames = try compile(schema.get("propertyNames"))
			}
			node.leastKeys = countAt(schema, "minProperties", 0)
			node.mostKeys = countAt(schema, "maxProperties", -1)
			return node
		}

		def arrayShape(schema map<string, any>) !ShapeNode {
			let node = new ShapeNode(ShapeKind.Array)
			let prefixed = schema.get("prefixItems")
			let items = schema.get("items")
			if prefixed is any[] {
				for let (_, p) in prefixed {
					node.prefix.push(try compile(p))
				}
				node.items = try compile(items)
			} else if items is any[] {
				// The older tuple form.
				for let (_, p) in items {
					node.prefix.push(try compile(p))
				}
				node.items = try compile(schema.get("additionalItems"))
			} else {
				node.items = try compile(items)
			}
			node.least = countAt(schema, "minItems", 0)
			node.most = countAt(schema, "maxItems", -1)
			return node
		}

		def textShape(schema map<string, any>) !ShapeNode {
			let node = new ShapeNode(ShapeKind.Text)
			node.shortest = countAt(schema, "minLength", 0)
			node.longest = countAt(schema, "maxLength", -1)
			let source = schema.get("pattern")
			node.patterns.push(try patternOf(source)) when source is string
			let format = schema.get("format")
			if format is string {
				let known = formatPattern(format)
				node.patterns.push(try patternOf(known)) when known.len() > 0
			}
			return node
		}
	}

	internal def numberShape(schema map<string, any>, integer bool) ShapeNode {
		let node = new ShapeNode(integer ?? (ShapeKind.Integer, ShapeKind.Number))
		let minimum = schema.get("minimum")
		let maximum = schema.get("maximum")
		let lowExclusive = schema.get("exclusiveMinimum")
		let highExclusive = schema.get("exclusiveMaximum")
		if isNumber(minimum) {
			node.low = numberOf(minimum)
			node.lowSet = true
			// Draft 4: a boolean beside the bound.
			node.lowOpen = lowExclusive is bool && lowExclusive
		}
		if isNumber(lowExclusive) && (!node.lowSet || numberOf(lowExclusive) >= node.low) {
			node.low = numberOf(lowExclusive)
			node.lowSet = true
			node.lowOpen = true
		}
		if isNumber(maximum) {
			node.high = numberOf(maximum)
			node.highSet = true
			node.highOpen = highExclusive is bool && highExclusive
		}
		if isNumber(highExclusive) && (!node.highSet || numberOf(highExclusive) <= node.high) {
			node.high = numberOf(highExclusive)
			node.highSet = true
			node.highOpen = true
		}
		let step = schema.get("multipleOf")
		node.step = numberOf(step) when isNumber(step) && numberOf(step) > 0.0
		return node
	}

	// The type a schema without `type` describes by its keywords.
	internal def inferredType(schema map<string, any>) string {
		for let (_, key) in string["properties", "additionalProperties", "patternProperties", "required", "propertyNames", "minProperties", "maxProperties"] {
			return "object" when schema.hasKey(key)
		}
		for let (_, key) in string["items", "prefixItems", "minItems", "maxItems"] {
			return "array" when schema.hasKey(key)
		}
		for let (_, key) in string["pattern", "format", "minLength", "maxLength"] {
			return "string" when schema.hasKey(key)
		}
		for let (_, key) in string["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf"] {
			return "number" when schema.hasKey(key)
		}
		return ""
	}

	// Whether `schema` holds keywords besides `except` and annotations.
	internal def hasRules(schema map<string, any>, except string) bool {
		for let (key, _) in schema {
			continue when key == except
			continue when key := "description" || "title" || "$comment" || "default" || "examples" || "$schema" || "$id" || "$defs" || "definitions" || "deprecated" || "readOnly" || "writeOnly"
			return true
		}
		return false
	}

	// A `type` keyword's types as a list.
	internal def typeList(t any) string[] {
		let out string[]
		if t is string {
			out.push(t)
		} else if t is any[] {
			for let (_, one) in t {
				out.push(one) when one is string
			}
		}
		return out
	}

	internal def without(schema map<string, any>, key string) map<string, any> {
		let out = new map<string, any>()
		for let (k, v) in schema {
			out.set(k, v) unless k == key || v is none
		}
		return out
	}

	internal def jsonText(value ?any) string {
		return value is none ?? ("null", string((new JSON()).encode(value)))
	}

	internal def isNumber(v ?any) bool {
		return v is int || v is float
	}

	internal def numberOf(v ?any) float {
		return float(v) when v is int
		return v when v is float
		return 0.0
	}

	internal def countAt(schema map<string, any>, key string, otherwise int) int {
		let v = schema.get(key)
		return v when v is int
		return int(v) when v is float
		return otherwise
	}

	// The pattern a `format` stands for; "" for a format that does not
	// narrow.
	internal def formatPattern(format string) string {
		let date = "[0-9]\{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])"
		let time = "([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])"
		let label = "[A-Za-z0-9]([A-Za-z0-9-]\{0,61}[A-Za-z0-9])?"
		let octet = "(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
		let h16 = "[0-9A-Fa-f]\{1,4}"
		let v4 = "{octet}(\\.{octet})\{3}"
		match format {
			case "date":
				return "^{date}$"
			case "time":
				return "^{time}$"
			case "date-time":
				return "^{date}[Tt]{time}$"
			case "duration":
				let seconds = "[0-9]+(\\.[0-9]+)?S"
				let clock = "T([0-9]+H([0-9]+M)?({seconds})?|[0-9]+M({seconds})?|{seconds})"
				let calendar = "([0-9]+Y([0-9]+M)?([0-9]+D)?|[0-9]+M([0-9]+D)?|[0-9]+D)"
				return "^P([0-9]+W|{calendar}({clock})?|{clock})$"
			case "email":
				return "^[A-Za-z0-9.!#$%&'*+/=?^_`\{|}~-]+@{label}(\\.{label})+$"
			case "hostname":
				return "^{label}(\\.{label})*$"
			case "ipv4":
				return "^{v4}$"
			case "ipv6":
				// RFC 4291's text forms, :: and an IPv4 tail included.
				let forms = string[
					"({h16}:)\{7}{h16}",
					"({h16}:)\{1,7}:",
					"({h16}:)\{1,6}:{h16}",
					"({h16}:)\{1,5}(:{h16})\{1,2}",
					"({h16}:)\{1,4}(:{h16})\{1,3}",
					"({h16}:)\{1,3}(:{h16})\{1,4}",
					"({h16}:)\{1,2}(:{h16})\{1,5}",
					"{h16}:(:{h16})\{1,6}",
					":((:{h16})\{1,7}|:)",
					"({h16}:)\{6}{v4}",
					"({h16}:)\{0,5}:{v4}",
					"::({h16}:)\{0,5}{v4}"
				]
				return "^(" + forms.join("|") + ")$"
			case "uuid":
				return "^[0-9A-Fa-f]\{8}-[0-9A-Fa-f]\{4}-[0-9A-Fa-f]\{4}-[0-9A-Fa-f]\{4}-[0-9A-Fa-f]\{12}$"
			case "uri":
				return "^[A-Za-z][A-Za-z0-9+.-]*:[^\\x00-\\x20\"<>\\\\^`\{|}]*$"
			default:
				return ""
		}
	}

	// ---- patterns ------------------------------------------------------

	// A pattern compiled for matching a text as it is written: the RE2
	// program, and per instruction whether a match can follow it and the
	// fewest and most characters before one (-1: no bound).
	internal type Pattern {
		program Program
		reach   bool[]  = []
		fewest  int[]   = []
		most    int[]   = []

		def new(program Program) {
			self.program = program
			analyse()
		}

		// The instructions `pc` goes on to, and the characters each step
		// takes (1 for a byte that starts a character, else 0; -1 for an
		// instruction that consumes nothing).
		def steps(pc int, to int[], cost int[]) {
			to.len(0)
			cost.len(0)
			let op = program.op[pc]
			if op == regex.opByte {
				to.push(program.c[pc])
				cost.push(startsChar(program.a[pc]) ?? (1, 0))
			} else if op == regex.opSwitch {
				let base = program.a[pc]
				for let i = 0; i < program.b[pc]; i++ {
					to.push(program.table[base + 3 * i + 2])
					cost.push(startsChar(program.table[base + 3 * i]) ?? (1, 0))
				}
			} else if op == regex.opSplit {
				to.push(program.a[pc], program.b[pc])
				cost.push(-1, -1)
			} else if op == regex.opJump {
				to.push(program.a[pc])
				cost.push(-1)
			} else if op == regex.opSave || op == regex.opAssert {
				to.push(program.c[pc])
				cost.push(-1)
			}
		}

		// Which instructions reach a match, and in how many characters at
		// least and at most.
		def analyse() {
			let n = program.op.len()
			reach.len(n)
			fewest.len(n)
			most.len(n)
			// Edges backwards, to walk from the matches.
			let into int[][]
			let intoCost int[][]
			into.len(n)
			intoCost.len(n)
			let to int[]
			let cost int[]
			for let pc = 0; pc < n; pc++ {
				into[pc] = int[]
				intoCost[pc] = int[]
			}
			for let pc = 0; pc < n; pc++ {
				steps(pc, to, cost)
				for let (k, t) in to {
					continue when t < 0 || t >= n
					into[t].push(pc)
					intoCost[t].push(cost[k].max(0))
				}
			}
			// Fewest: 0-1 breadth first from every match.
			let queue int[]
			for let pc = 0; pc < n; pc++ {
				fewest[pc] = -1
				if program.op[pc] == regex.opMatch {
					fewest[pc] = 0
					reach[pc] = true
					queue.push(pc)
				}
			}
			for let head = 0; head < queue.len(); head++ {
				let pc = queue[head]
				for let (k, from) in into[pc] {
					let d = fewest[pc] + intoCost[pc][k]
					if fewest[from] < 0 || d < fewest[from] {
						fewest[from] = d
						reach[from] = true
						queue.push(from)
					}
				}
			}
			// Most: unbounded where a character-taking cycle lies on the
			// way to a match, else the longest way.
			let state int[]
			state.len(n)
			for let pc = 0; pc < n; pc++ {
				longestFrom(pc, state)
			}
		}

		// The most characters from `pc` to a match (-1 unbounded): a walk
		// over the instructions that reach one, memoised in `most`
		// (`state`: 0 new, 1 on the walk, 2 done).
		def longestFrom(pc int, state int[]) int {
			return most[pc] when state[pc] == 2
			if state[pc] == 1 || !reach[pc] {
				// A cycle: unbounded when it takes characters, which the
				// caller cannot tell; take it as unbounded.
				return -1
			}
			state[pc] = 1
			let to int[]
			let cost int[]
			steps(pc, to, cost)
			let best = program.op[pc] == regex.opMatch ?? (0, -2)
			for let (k, t) in to {
				continue when t < 0 || t >= reach.len() || !reach[t]
				let rest = longestFrom(t, state)
				if rest < 0 {
					best = -1
					break
				}
				best = best.max(rest + cost[k].max(0)) unless best == -1
			}
			state[pc] = 2
			most[pc] = best == -2 ?? (-1, best)
			return most[pc]
		}

		// The instructions the threads `threads` (each waiting at an
		// instruction, after the byte `before`) stand at once the zero-width
		// steps are taken, the byte after being `after` (-1 the end of the
		// text, -2 not known yet: assertions on it are taken as holding).
		def closure(threads int[], before int, after int) int[] {
			let out int[]
			let seen bool[]
			seen.len(program.op.len())
			let stack = threads.clone()
			for stack.len() > 0 {
				let pc = stack.pop()
				continue when pc < 0 || pc >= seen.len() || seen[pc]
				seen[pc] = true
				let op = program.op[pc]
				if op == regex.opSplit {
					stack.push(program.b[pc], program.a[pc])
				} else if op == regex.opJump {
					stack.push(program.a[pc])
				} else if op == regex.opSave {
					stack.push(program.c[pc])
				} else if op == regex.opAssert {
					stack.push(program.c[pc]) when assertionHolds(program.a[pc], before, after)
				} else {
					out.push(pc)
				}
			}
			return out
		}
	}

	// Whether a byte in a range starting at `lo` starts a character.
	internal def startsChar(lo int) bool {
		return lo < 0x80 || lo >= 0xC0
	}

	// Whether zero-width assertion `a` holds between `before` and `after`
	// (-1 the edge of the text; -2 for `after` not known yet, which holds).
	internal def assertionHolds(a int, before int, after int) bool {
		if a == regex.beginText {
			return before == -1
		} else if a == regex.beginLine {
			return before == -1 || before == 10
		}
		return true when after == -2
		if a == regex.endText {
			return after == -1
		} else if a == regex.endLine {
			return after == -1 || after == 10
		}
		let word = regex.isWordChar(before) != regex.isWordChar(after)
		return a == regex.wordBoundary ?? (word, !word)
	}

	// The pattern of `source`, matched anywhere in a text unless it is
	// anchored at either end, as JSON Schema's `pattern` is.
	// Fails when `source` is not valid RE2 syntax.
	internal def patternOf(source string) !Pattern {
		let lead = source.startsWith("^") ?? ("", "(?s:.*)")
		let tail = source.endsWith("$") && !source.endsWith("\\$") ?? ("", "(?s:.*)")
		let program = regex.compile(lead + "(?:" + source + ")" + tail) onerror (err error) {
			fail "llm: the schema's pattern {source} is not RE2 syntax: {err.message}"
		}
		return new Pattern(program)
	}

	// One pattern being matched as a text is written: the threads after
	// the bytes so far and the last byte.
	internal type PatternRun {
		pattern Pattern
		threads int[]   = []
		before  int     = -1

		def new(pattern Pattern) {
			self.pattern = pattern
			threads.push(0)
		}

		def copy() PatternRun {
			let out = new PatternRun(pattern)
			out.threads = threads.clone()
			out.before = before
			return out
		}

		// Takes byte `b`; false when no thread can.
		def take(b int) bool {
			let program = pattern.program
			let next int[]
			for let (_, pc) in pattern.closure(threads, before, b) {
				let op = program.op[pc]
				let to = -1
				if op == regex.opByte {
					to = program.c[pc] when b >= program.a[pc] && b <= program.b[pc]
				} else if op == regex.opSwitch {
					to = regex.switchTarget(program.table, program.a[pc], program.b[pc], b)
				}
				next.push(to) when to >= 0 && !next.includes(to)
			}
			threads = next
			before = b
			return next.len() > 0
		}

		// The fewest and most characters (-1: no bound) the text can still
		// take before it matches; (-1, -1) when it cannot match any more.
		def room() (int, int) {
			let fewest = -1
			let most = 0
			for let (_, pc) in pattern.closure(threads, before, -2) {
				continue unless pattern.reach[pc]
				let f = pattern.fewest[pc]
				fewest = fewest < 0 ?? (f, fewest.min(f))
				let m = pattern.most[pc]
				most = most < 0 || m < 0 ?? (-1, most.max(m))
			}
			return fewest < 0 ?? ((-1, -1), (fewest, most))
		}

		// Whether the text matches if it ends here.
		def matches() bool {
			for let (_, pc) in pattern.closure(threads, before, -1) {
				return true when pattern.program.op[pc] == regex.opMatch
			}
			return false
		}
	}

	// ---- the recognizer ------------------------------------------------

	// Where one alternative of the recognizer is: a stack of frames, the
	// innermost last.
	enum FrameKind {
		// A value of `node` comes next.
		Value,
		// Inside an object: `phase` 0 key or end, 1 key (after a comma),
		// 2 colon, 3 comma or end, 4 in a value.
		Object,
		// Inside an array: `phase` 0 value or end, 1 value (after a
		// comma), 2 comma or end, 4 in an item.
		Array,
		// Inside a string; `known` holds the texts it may still be (enum
		// members, keys), each without its quotes; empty for any.
		Text,
		// Inside a number; `phase` as `numberStep`.
		Number,
		// The rest of a literal (`true`, a constant) in `literal`.
		Literal,
		// Any bytes (a tool call after its opening markup).
		Free,
	}

	type Frame {
		kind    FrameKind
		node    ?ShapeNode
		phase   int
		count   int
		// Object: the keys written; the key being written.
		seen    string[]
		key     string
		// Text: the bytes so far (as written), the texts allowed, whether
		// an escape opened, whether this string is an object's key, the
		// characters of the decoded text and the patterns it is matched
		// against. A \u escape: its hex digits so far (-1 none), its value,
		// and a high surrogate waiting for its pair (-1 none).
		text    byte[]
		known   string[]
		escaped bool
		isKey   bool
		chars   int
		runs    PatternRun[]
		hex     int          = -1
		code    int
		high    int          = -1
		// Key: keys other than the declared may come, held to the object's
		// `propertyNames` (fed the key as written).
		open    bool
		named   bool
		names   Frame[][]
		namesOk bool         = true
		// Number: integers only; Literal: the bytes left.
		integer bool
		literal byte[]

		def new(kind FrameKind, node ?ShapeNode) {
			self.kind = kind
			self.node = node
		}

		def copy() Frame {
			let out = new Frame(kind, node)
			out.phase = phase
			out.count = count
			out.seen = seen.clone()
			out.key = key
			out.text = text.clone()
			out.known = known.clone()
			out.escaped = escaped
			out.isKey = isKey
			out.chars = chars
			for let (_, r) in runs {
				out.runs.push(r.copy())
			}
			out.hex = hex
			out.code = code
			out.high = high
			out.open = open
			out.named = named
			out.namesOk = namesOk
			for let (_, stack) in names {
				out.names.push(forked(stack))
			}
			out.integer = integer
			out.literal = literal.clone()
			return out
		}
	}

	// A copy of `stack` whose frames the copy alone changes.
	internal def forked(stack Frame[]) Frame[] {
		let out Frame[]
		for let (_, f) in stack {
			out.push(f.copy())
		}
		return out
	}

	// The recognizer: the alternatives still alive, each a stack of
	// frames, and the whitespace run (bounded, so a reply cannot loop on
	// spaces).
	type ShapeMatcher {
		internal stacks Frame[][]
		internal spaces int
		internal fed    int
		// The root, held while the frames point into it.
		internal root   ShapeNode

		def new(root ShapeNode) {
			self.root = root
			stacks.push([new Frame(FrameKind.Value, root)])
		}

		// A copy to try bytes on.
		def copy() ShapeMatcher {
			let out = new ShapeMatcher(root)
			out.stacks.len(0)
			for let (_, s) in stacks {
				out.stacks.push(forked(s))
			}
			out.spaces = spaces
			out.fed = fed
			return out
		}

		// Whether nothing has been fed yet.
		def untouched() bool {
			return fed == 0
		}

		// Feeds `bytes`; false when no alternative accepts them (the
		// matcher is then dead).
		def feed(bytes byte[]) bool {
			for let (_, b) in bytes {
				return false unless step(b)
			}
			return true
		}

		// Whether a whole value has been read (only whitespace may follow).
		def complete() bool {
			for let (_, s) in stacks {
				return true when s.len() == 0
				let top = s[s.len() - 1]
				return true when top.kind == FrameKind.Free
				return true when s.len() == 1 && top.kind == FrameKind.Number && numberEnds(top)
			}
			return false
		}

		internal def step(b byte) bool {
			let white = b == byte(32) || b == byte(10) || b == byte(9) || b == byte(13)
			if white && !inString() {
				spaces++
				return false when spaces > 2
			} else {
				spaces = 0
			}
			fed++
			let next Frame[][]
			for let (_, s) in stacks {
				for let (_, out) in advance(s, b) {
					next.push(out)
				}
			}
			stacks = next
			return stacks.len() > 0
		}

		// Whether every alternative is inside a string or a call (where
		// whitespace is text).
		internal def inString() bool {
			for let (_, s) in stacks {
				return false when s.len() == 0
				return false unless s[s.len() - 1].kind := FrameKind.Text || FrameKind.Free
			}
			return stacks.len() > 0
		}
	}

	// The stacks byte `b` leads `stack` to: none when it rejects it,
	// several when a value may be one of several shapes.
	internal def advance(stack Frame[], b byte) Frame[][] {
		let out Frame[][]
		let white = b == byte(32) || b == byte(10) || b == byte(9) || b == byte(13)
		if stack.len() == 0 {
			out.push(stack) when white
			return out
		}
		let top = stack[stack.len() - 1]
		match top.kind {
			case FrameKind.Value:
				if white {
					out.push(stack)
					return out
				}
				let node = top.node
				let opened = opening(node is none ?? (new ShapeNode(ShapeKind.Any), node), b)
				for let (k, frames) in opened {
					// Each alternative changes the frames under it on its own.
					let base = k == 0 ?? (stack[:stack.len() - 1].clone(), forked(stack[:stack.len() - 1]))
					base.push(...frames)
					out.push(base)
				}
			case FrameKind.Text:
				let next = textStep(stack, top, b)
				out.push(next) unless next is none
			case FrameKind.Number:
				if numberStep(top, b) {
					out.push(stack)
				} else if numberEnds(top) {
					// The number ended: the byte belongs to what holds it.
					let rest = stack[:stack.len() - 1].clone()
					for let (_, after) in advance(close(rest), b) {
						out.push(after)
					}
				}
			case FrameKind.Literal:
				if top.literal.len() > 0 && top.literal[0] == b {
					top.literal = top.literal[1:].clone()
					out.push(top.literal.len() == 0 ?? (close(stack[:stack.len() - 1].clone()), stack))
				}
			case FrameKind.Free:
				out.push(stack)
			case FrameKind.Object:
				if white {
					out.push(stack)
					return out
				}
				let node = top.node
				if (top.phase == 0 || top.phase == 3) && b == byte(125) {
					// `}` once every required key is there and enough keys are.
					for let (_, r) in requiredOf(node) {
						return out unless top.seen.indexOf(r) >= 0
					}
					return out when !(node is none) && top.seen.len() < node.leastKeys
					out.push(close(stack[:stack.len() - 1].clone()))
				} else if (top.phase == 0 || top.phase == 1) && b == byte(34) {
					return out unless moreKeys(node, top.seen)
					let key = new Frame(FrameKind.Text, none)
					key.isKey = true
					if node is none {
						key.open = true
					} else {
						key.known = keysLeft(node, top.seen)
						key.open = node.extraAllowed
						for let (_, p) in node.keyPatterns {
							key.runs.push(new PatternRun(p))
						}
						let names = node.keyNames
						if !(names is none) {
							key.named = true
							key.names.push([new Frame(FrameKind.Value, names)])
							written(key, byte(34))
							key.text.len(0)
							return out unless key.namesOk
						}
					}
					return out unless keyViable(key)
					let next = stack.clone()
					next.push(key)
					out.push(next)
				} else if top.phase == 2 && b == byte(58) {
					top.phase = 4
					let next = stack.clone()
					next.push(new Frame(FrameKind.Value, valueOf(node, top.key)))
					out.push(next)
				} else if top.phase == 3 && b == byte(44) {
					// A comma only when a key may follow it.
					if moreKeys(node, top.seen) {
						top.phase = 1
						out.push(stack)
					}
				}
			case FrameKind.Array:
				if white {
					out.push(stack)
					return out
				}
				let node = top.node
				let most = node is none ?? (-1, node.most)
				let least = node is none ?? (0, node.least)
				if (top.phase == 0 || top.phase == 2) && b == byte(93) {
					out.push(close(stack[:stack.len() - 1].clone())) when top.count >= least
				} else if top.phase == 2 && b == byte(44) {
					if (most < 0 || top.count < most) && itemAllowed(node, top.count) {
						top.phase = 1
						out.push(stack)
					}
				} else if top.phase == 0 || top.phase == 1 {
					return out when top.phase == 0 && (most == 0 || !itemAllowed(node, 0))
					top.phase = 4
					let inner = stack.clone()
					inner.push(new Frame(FrameKind.Value, itemNode(node, top.count)))
					for let (_, after) in advance(inner, b) {
						out.push(after)
					}
				}
			default:
		}
		return out
	}

	// The frames a value of `node` opens with byte `b` (the value's first).
	internal def opening(given ShapeNode, b byte) Frame[][] {
		let out Frame[][]
		let node = resolved(given)
		match node.kind {
			case ShapeKind.Either:
				for let (_, option) in node.options {
					out.push(...opening(option, b))
				}
			case ShapeKind.Any:
				for let (_, kind) in [ShapeKind.Object, ShapeKind.Array, ShapeKind.Text, ShapeKind.Number, ShapeKind.Boolean, ShapeKind.Null] {
					let any = new ShapeNode(kind)
					any.extraAllowed = true
					out.push(...opening(any, b))
				}
			case ShapeKind.Object:
				out.push([new Frame(FrameKind.Object, node)]) when b == byte(123)
			case ShapeKind.Array:
				out.push([new Frame(FrameKind.Array, node)]) when b == byte(91)
			case ShapeKind.Text:
				if b == byte(34) {
					let text = new Frame(FrameKind.Text, node)
					for let (_, p) in node.patterns {
						text.runs.push(new PatternRun(p))
					}
					out.push([text]) when textViable(text)
				}
			case ShapeKind.Number, ShapeKind.Integer:
				let number = new Frame(FrameKind.Number, node)
				number.integer = node.kind == ShapeKind.Integer
				out.push([number]) when numberStep(number, b)
			case ShapeKind.Boolean:
				for let (_, word) in string["true", "false"] {
					if word.bytes()[0] == b {
						let literal = new Frame(FrameKind.Literal, node)
						literal.literal = word.bytes()[1:].clone()
						out.push(literal.literal.len() == 0 ?? (Frame[], [literal]))
					}
				}
			case ShapeKind.Null:
				if b == byte(110) {
					let literal = new Frame(FrameKind.Literal, node)
					literal.literal = "ull".bytes()
					out.push([literal])
				}
			case ShapeKind.Constant:
				for let (_, c) in node.constants {
					let bytes = c.bytes()
					continue unless bytes.len() > 0 && bytes[0] == b
					if b == byte(34) {
						let text = new Frame(FrameKind.Text, node)
						text.known.push(string(bytes[1:bytes.len() - 1]))
						out.push([text])
					} else if bytes.len() == 1 {
						out.push(Frame[])
					} else {
						let literal = new Frame(FrameKind.Literal, node)
						literal.literal = bytes[1:].clone()
						out.push([literal])
					}
				}
			case ShapeKind.Free:
				let marker = node.constants.len() > 0 ?? (node.constants[0].bytes(), byte[])
				if marker.len() > 0 && marker[0] == b {
					let literal = new Frame(FrameKind.Literal, node)
					literal.literal = marker[1:].clone()
					out.push([new Frame(FrameKind.Free, node), literal])
				}
			default:
		}
		return out
	}

	// `stack` after the value on its top finished: what holds it moves on.
	internal def close(stack Frame[]) Frame[] {
		return stack when stack.len() == 0
		let top = stack[stack.len() - 1]
		if top.kind == FrameKind.Object && top.phase == 4 {
			top.phase = 3
		} else if top.kind == FrameKind.Array && top.phase == 4 {
			top.phase = 2
			top.count++
		}
		return stack
	}

	// One byte of a string: none when it rejects it.
	internal def textStep(stack Frame[], top Frame, b byte) ?Frame[] {
		if top.hex >= 0 {
			let digit = hexDigit(b)
			return none when digit < 0
			written(top, b)
			top.code = top.code * 16 + digit
			top.hex++
			return (prefixOk(top) ?? (stack, none)) when top.hex < 4
			top.hex = -1
			let code = top.code
			if code >= 0xD800 && code <= 0xDBFF {
				// A high surrogate: its low half comes as the next escape.
				return none when top.high >= 0
				top.high = code
				return prefixOk(top) ?? (stack, none)
			}
			if code >= 0xDC00 && code <= 0xDFFF {
				return none when top.high < 0
				code = 0x10000 + ((top.high - 0xD800) << 10) + (code - 0xDC00)
				top.high = -1
			} else if top.high >= 0 {
				return none
			}
			return decoded(top, code) ?? (stack, none)
		}
		if top.escaped {
			top.escaped = false
			written(top, b)
			if b == byte(117) {
				top.hex = 0
				top.code = 0
				return prefixOk(top) ?? (stack, none)
			}
			return none when top.high >= 0
			let code = escapeCode(b)
			return none when code < 0
			return decoded(top, code) ?? (stack, none)
		}
		if b == byte(92) {
			top.escaped = true
			written(top, b)
			return prefixOk(top) ?? (stack, none)
		}
		// A high surrogate takes nothing but its low half's escape.
		return none when top.high >= 0
		if b == byte(34) {
			// The string ends: one of the allowed texts, if any; long
			// enough; every pattern matched.
			let written = string(top.text)
			return none when !top.isKey && top.known.len() > 0 && top.known.indexOf(written) < 0
			let rest = stack[:stack.len() - 1].clone()
			if top.isKey {
				let owner = rest[rest.len() - 1]
				return none when owner.seen.includes(written)
				return none unless keyEnds(top, written)
				owner.key = written
				owner.seen.push(written)
				owner.phase = 2
				return rest
			}
			return none unless textEnds(top)
			return close(rest)
		}
		return none when b < byte(32)
		written(top, b)
		top.chars++ when startsChar(int(b))
		for let (_, r) in top.runs {
			r.take(int(b))
		}
		return viable(top) ?? (stack, none)
	}

	// Adds a byte as written to a string, and to the `propertyNames`
	// matcher of a key.
	internal def written(frame Frame, b byte) {
		frame.text.push(b)
		return unless frame.named
		let next Frame[][]
		for let (_, stack) in frame.names {
			next.push(...advance(stack, b))
		}
		frame.names = next
		frame.namesOk = next.len() > 0
	}

	// Whether a string or key can still be finished.
	internal def viable(frame Frame) bool {
		return frame.isKey ?? (keyViable(frame), fits(frame) && textViable(frame))
	}

	// Whether a key can still become one the object takes: a declared key
	// not written yet, or (as an extra key or by a pattern) one its
	// `propertyNames` allow.
	internal def keyViable(frame Frame) bool {
		let written = string(frame.text)
		for let (_, k) in frame.known {
			return true when k.startsWith(written)
		}
		let other = frame.open
		for let (_, r) in frame.runs {
			let (fewest, _) = r.room()
			other = other || fewest >= 0
		}
		return other && frame.namesOk
	}

	// Whether a key ending as `written` is one the object takes.
	internal def keyEnds(frame Frame, written string) bool {
		return false when frame.hex >= 0 || frame.high >= 0
		return true when frame.known.includes(written)
		let other = frame.open
		for let (_, r) in frame.runs {
			other = other || r.matches()
		}
		return false unless other
		return true unless frame.named
		for let (_, stack) in frame.names {
			for let (_, after) in advance(forked(stack), byte(34)) {
				return true when after.len() == 0
			}
		}
		return false
	}

	// Takes the character `code` an escape decoded into the text's
	// patterns and count; false when that leaves the text no way on.
	internal def decoded(top Frame, code int) bool {
		let bytes = string(char(code)).bytes()
		top.chars++
		for let (_, r) in top.runs {
			for let (_, x) in bytes {
				r.take(int(x))
			}
		}
		return viable(top)
	}

	// The character an escape `\b` stands for; -1 when it is no escape.
	internal def escapeCode(b byte) int {
		match int(b) {
			case 34, 92, 47:
				return int(b)
			case 98:
				return 8
			case 102:
				return 12
			case 110:
				return 10
			case 114:
				return 13
			case 116:
				return 9
			default:
				return -1
		}
	}

	internal def hexDigit(b byte) int {
		let c = int(b)
		return c - 48 when c >= 48 && c <= 57
		return c - 87 when c >= 97 && c <= 102
		return c - 55 when c >= 65 && c <= 70
		return -1
	}

	// Inside an escape: whether the bytes so far may still start an
	// allowed text (the escape's character is checked once decoded).
	internal def prefixOk(frame Frame) bool {
		return frame.isKey ?? (frame.known.len() == 0 || frame.open || frame.runs.len() > 0 || fits(frame), fits(frame))
	}

	// Whether a string's bytes so far start one of its allowed texts.
	internal def fits(frame Frame) bool {
		return true when frame.known.len() == 0
		let written = string(frame.text)
		for let (_, k) in frame.known {
			return true when k.startsWith(written)
		}
		return false
	}

	// Whether a text can still be finished within its node's bounds and
	// patterns. A key is checked when it ends.
	internal def textViable(frame Frame) bool {
		return true when frame.isKey
		let node = frame.node
		return true when node is none
		let longest = node.longest
		return false when longest >= 0 && frame.chars > longest
		for let (_, r) in frame.runs {
			let (fewest, most) = r.room()
			return false when fewest < 0
			return false when longest >= 0 && frame.chars + fewest > longest
			return false when most >= 0 && frame.chars + most < node.shortest
		}
		return true
	}

	// Whether a text may end where it is.
	internal def textEnds(frame Frame) bool {
		return false when frame.hex >= 0 || frame.high >= 0
		let node = frame.node
		return true when node is none
		return false when frame.chars < node.shortest
		return false when node.longest >= 0 && frame.chars > node.longest
		for let (_, r) in frame.runs {
			return false unless r.matches()
		}
		return true
	}

	// One byte of a number; false when it cannot continue the number (the
	// frame is then as it was). Phases: 0 start, 1 after '-', 2 after a
	// leading 0, 3 in the whole digits, 4 after '.', 5 in the fraction, 6
	// after e/E, 7 after its sign, 8 in the exponent.
	internal def numberStep(frame Frame, b byte) bool {
		return false when frame.count >= 24
		let digit = b >= byte(48) && b <= byte(57)
		let given = frame.node
		let node = given is none ?? (new ShapeNode(ShapeKind.Any), resolved(given))
		let bounded = node.bounded()
		let next = -1
		match frame.phase {
			case 0:
				next = b == byte(45) ?? (1, digit ?? (b == byte(48) ?? (2, 3), -1))
			case 1:
				next = digit ?? (b == byte(48) ?? (2, 3), -1)
			case 2, 3:
				if digit && frame.phase == 3 {
					next = 3
				} else if !frame.integer && b == byte(46) {
					next = 4
				} else if !frame.integer && !bounded && (b == byte(101) || b == byte(69)) {
					next = 6
				}
			case 4, 5:
				if digit {
					next = 5
				} else if frame.phase == 5 && !bounded && (b == byte(101) || b == byte(69)) {
					next = 6
				}
			case 6:
				next = (b == byte(43) || b == byte(45)) ?? (7, digit ?? (8, -1))
			case 7, 8:
				next = digit ?? (8, -1)
			default:
		}
		return false when next < 0
		if bounded {
			let text = frame.text.clone()
			text.push(b)
			return false unless numberViable(text, node, frame.integer)
		}
		frame.phase = next
		frame.count++
		frame.text.push(b)
		return true
	}

	// Whether a number may end where it is.
	internal def numberEnds(frame Frame) bool {
		return false unless frame.phase := 2 || 3 || 5 || 8
		let node = frame.node
		return true when node is none
		let n = resolved(node)
		return true unless n.bounded()
		let v = parseFloat<float>(string(frame.text))
		return inBounds(v, n) && onStep(v, n.step)
	}

	internal def inBounds(v float, n ShapeNode) bool {
		return false when n.lowSet && (v < n.low || (n.lowOpen && v == n.low))
		return false when n.highSet && (v > n.high || (n.highOpen && v == n.high))
		return true
	}

	internal def onStep(v float, step float) bool {
		return true when step <= 0.0
		let k = v / step
		return (k - k.round()).abs() < 1e-9 * k.abs().max(1.0)
	}

	// Whether some number written as `text` goes on to (without an
	// exponent) lies within `n`'s bounds and on its step.
	internal def numberViable(text byte[], n ShapeNode, integer bool) bool {
		let s = string(text)
		let negative = s.startsWith("-")
		let body = negative ?? (s.slice(1), s)
		let unbounded = 1.0 / 0.0
		if body.len() == 0 {
			// Only the sign: any magnitude.
			return rangeHolds(0.0, unbounded, negative, n, integer, loClosed = true, hiClosed = false)
		}
		let dot = body.indexOf(".")
		if dot < 0 {
			if body == "0" {
				return integer ?? (rangeHolds(0.0, 0.0, negative, n, integer, loClosed = true, hiClosed = true), rangeHolds(0.0, 1.0, negative, n, integer, loClosed = true, hiClosed = false))
			}
			let v = parseFloat<float>(body)
			// More digits multiply the value by ten each, up to 17 digits.
			let scale = 1.0
			for let extra = 0; body.len() + extra <= 17; extra++ {
				let lo = v * scale
				let hi = (v + 1.0) * scale
				return true when rangeHolds(lo, integer ?? (hi - 1.0, hi), negative, n, integer, loClosed = true, hiClosed = integer)
				scale *= 10.0
			}
			return false
		}
		let digits = body.len() - dot - 1
		let v = parseFloat<float>(body)
		return rangeHolds(v, v + 10.0 ** float(-digits), negative, n, integer, loClosed = true, hiClosed = false)
	}

	// Whether a magnitude in [lo, hi] (each end closed or open), negated
	// when `negative`, can lie within `n`'s bounds on its step.
	internal def rangeHolds(lo float, hi float, negative bool, n ShapeNode, integer bool, loClosed bool = true, hiClosed bool = false) bool {
		let (a, aClosed, b, bClosed) = negative ?? ((-hi, hiClosed, -lo, loClosed), (lo, loClosed, hi, hiClosed))
		if n.lowSet && (n.low > a || (n.low == a && n.lowOpen)) {
			a = n.low
			aClosed = !n.lowOpen
		}
		if n.highSet && (n.high < b || (n.high == b && n.highOpen)) {
			b = n.high
			bClosed = !n.highOpen
		}
		return false when a > b || (a == b && !(aClosed && bClosed))
		let step = integer && n.step <= 0.0 ?? (1.0, n.step)
		return true when step <= 0.0
		// The first multiple of the step at or past a.
		let k = (a / step).ceil()
		let x = k * step
		x += step when !aClosed && x <= a
		let slack = 1e-9 * x.abs().max(1.0)
		return x < b - slack || (bClosed && x <= b + slack)
	}

	internal def requiredOf(node ?ShapeNode) string[] {
		return node is none ?? (string[], node.required)
	}

	// Whether an object may take another key.
	internal def moreKeys(node ?ShapeNode, seen string[]) bool {
		return true when node is none
		return false when node.mostKeys >= 0 && seen.len() >= node.mostKeys
		return openKeys(node) || keysLeft(node, seen).len() > 0
	}

	// Whether keys beyond the declared may come.
	internal def openKeys(node ShapeNode) bool {
		return node.extraAllowed || node.keyPatterns.len() > 0
	}

	// The node of the value of key `key`: the declared property's, else
	// every matching pattern's, else the extra keys'.
	internal def valueOf(node ?ShapeNode, key string) ShapeNode {
		return new ShapeNode(ShapeKind.Any) when node is none
		let declared = node.property(key)
		return declared unless declared is none
		let matched int[]
		for let (k, p) in node.keyPatterns {
			let run = new PatternRun(p)
			let all = true
			for let (_, b) in key.bytes() {
				all = all && run.take(int(b))
			}
			matched.push(k) when all && run.matches()
		}
		return node.keyValues[matched[0]] when matched.len() == 1
		let compiler = node.book
		if matched.len() > 1 && !(compiler is none) {
			// Every matching pattern's schema holds for the value.
			let parts any[]
			for let (_, k) in matched {
				parts.push(node.keySchemas[k])
			}
			// The parts compiled one by one already: together they compile.
			return compiler.compile(map<string, any>{"allOf": parts}) onerror recover node.keyValues[matched[0]]
		}
		let extra = node.extra
		return extra is none ?? (new ShapeNode(ShapeKind.Any), extra)
	}

	// Whether item `index` may come.
	internal def itemAllowed(node ?ShapeNode, index int) bool {
		return true when node is none
		return true when index < node.prefix.len()
		let rest = node.items
		return rest is none || resolved(rest).kind != ShapeKind.Never
	}

	// The node of item `index`.
	internal def itemNode(node ?ShapeNode, index int) ShapeNode {
		return new ShapeNode(ShapeKind.Any) when node is none
		return node.prefix[index] when index < node.prefix.len()
		let rest = node.items
		return rest is none ?? (new ShapeNode(ShapeKind.Any), rest)
	}

	// The declared keys an object has not written yet.
	internal def keysLeft(node ?ShapeNode, seen string[]) string[] {
		let out string[]
		return out when node is none
		for let (_, n) in node.names {
			out.push(n) unless seen.indexOf(n) >= 0
		}
		return out
	}

	// The JSON Schema of the type `target` has, for `fill`.
	// Fails when `target` is none.
	def schemaFor(target any) !map<string, any> {
		let described = reflection.descriptorOf(target)
		fail "llm: fill takes a struct or type to fill" when described is none
		return jsonschema.schemaOf(described)
	}
}
