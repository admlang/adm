partial module std.ai.llm {
	use (
		std.testing
		std.services.runtime::(Runtime)
		std.data.encoding::(JSON)
		std.ai.llm.calls::*
		std.ai.llm.testmodels::(tinyModel)
	)

	// What `fill` writes into.
	internal struct Booking {
		// The guest's name.
		guest     string
		nights    int
		// Whether breakfast is included.
		breakfast bool
	}

	// Whether the recognizer of `schema` takes the whole of `text` and
	// sees a complete value.
	internal def takes(schema string, text string) bool {
		let parsed = (new JSON()).parse(schema) onerror recover none
		let matcher = new ShapeMatcher(compileShape(parsed))
		return matcher.feed(text.bytes()) && matcher.complete()
	}

	// Whether it takes `text` as the start of a value (not yet complete).
	internal def starts(schema string, text string) bool {
		let parsed = (new JSON()).parse(schema) onerror recover none
		let matcher = new ShapeMatcher(compileShape(parsed))
		return matcher.feed(text.bytes()) && !matcher.complete()
	}

	check "Structured output" {
		@test()
		def TestObjects() {
			let order = "\{\"type\":\"object\",\"properties\":\{\"item\":\{\"type\":\"string\"},\"count\":\{\"type\":\"integer\"},\"size\":\{\"enum\":[\"small\",\"large\"]},\"note\":\{\"type\":\"string\"}},\"required\":[\"item\",\"count\",\"size\"]}"
			assert takes(order, "\{\"item\":\"tea\",\"count\":2,\"size\":\"large\"}")
			assert takes(order, "\{ \"size\": \"small\", \"count\": -12, \"item\": \"a \\\"b\\\"\", \"note\": \"x\" }")
			// A required key missing, an unknown key, a wrong enum member, a
			// fraction for an integer, a key twice.
			assert !takes(order, "\{\"item\":\"tea\",\"count\":2}")
			assert !starts(order, "\{\"colour\"")
			assert !starts(order, "\{\"size\":\"medium")
			assert !starts(order, "\{\"item\":\"tea\",\"count\":2.5")
			assert !starts(order, "\{\"item\":\"a\",\"item\"")
			// No comma once every declared key is written.
			assert !starts(order, "\{\"item\":\"t\",\"count\":1,\"size\":\"small\",\"note\":\"n\",")
			assert starts(order, "\{\"item\":\"tea\",\"count\":2")
			assert starts(order, "\{\"si")
			// Runs of whitespace are bounded.
			assert !starts(order, "\{   \"item\"")
		}

		@test()
		def TestArraysChoicesAndScalars() {
			let list = "\{\"type\":\"array\",\"items\":\{\"type\":\"number\"},\"minItems\":1,\"maxItems\":3}"
			assert takes(list, "[1, -0.5, 2e3]")
			assert !takes(list, "[]")
			assert !starts(list, "[1,2,3,")
			assert !starts(list, "[01")
			let either = "\{\"anyOf\":[\{\"type\":\"boolean\"},\{\"type\":\"null\"},\{\"const\":7}]}"
			assert takes(either, "true") && takes(either, "null") && takes(either, "7") && !starts(either, "8")
			let nullable = "\{\"type\":[\"string\",\"null\"]}"
			assert takes(nullable, "\"x\"") && takes(nullable, "null") && !starts(nullable, "1")
			// A number at the top is complete where it may end.
			assert takes("\{\"type\":\"integer\"}", "42") && !takes("\{\"type\":\"integer\"}", "-")
			// Any JSON for an empty schema.
			assert takes("\{}", "\{\"a\":[1,\{\"b\":null}],\"c\":\"d\"}")
			assert !starts("\{}", "\{\"a\":]")
		}

		@test()
		def TestStructSchemas() !none {
			// What jsonschema.schemaOf writes for a struct.
			let schema = parameterSchema(ToolParameter{name: "p", kind: ParameterKind.Object, fields: [ToolParameter{name: "city", kind: ParameterKind.String}, ToolParameter{name: "days", kind: ParameterKind.Integer, required: false}]})
			let matcher = new ShapeMatcher(compileShape(schema))
			assert matcher.feed("\{\"city\":\"Oslo\"}".bytes()) && matcher.complete()
			return none
		}

		// A local session held to a schema: the tiny model's vocabulary has
		// digits, so an integer answer; it is one, whatever the weights.
		@test()
		def TestSessionAnswerFollowsTheSchema() !none {
			let model = try load(try tinyModel("llama"), Device.Cpu)
			for let seed = 1; seed <= 4; seed++ {
				let session = model.session()
				session.seed = uint(seed)
				session.limit = 6
				session.schema = map<string, any>{"type": "integer"}
				let answer = try session.say("ab 12")
				fail "seed {seed}: {answer}" unless answer.len() > 0 && answer.trim().isNumeric()
			}
			return none
		}

		// `fill` on a remote chat: the request carries the struct's schema,
		// the answer fills the struct, and the schema is the chat's again.
		@test()
		def TestRemoteFill() !none {
			let provider = new ScriptedProvider()
			provider.replies.push([textEvent("\{\"guest\":\"Ada\",\"nights\":3,\"breakfast\":true}"), doneEvent(StopReason.End, 1, 1)])
			let chat = new RemoteChat(provider, "m")
			let booking = Booking{}
			try chat.fill(booking, "Ada stays three nights with breakfast.")
			assert booking.guest == "Ada" && booking.nights == 3 && booking.breakfast
			let sent = provider.requests[0].schema
			fail "no schema" when sent is none
			let properties = sent["properties"]
			fail "no properties" unless properties is map<string, any>
			assert properties.len() == 3 && chat.schema is none
			return none
		}

		// With ADM_TEST_TUNING_MODEL (Qwen3 0.6B): a real model fills a
		// struct from a sentence.
		@test()
		def TestRealModelFills() !none {
			let path = Runtime.getEnv("ADM_TEST_TUNING_MODEL")
			return none when path is none || path.len() == 0
			let model = try load(path)
			let session = model.session()
			session.temperature = 0.0
			session.thinking = false
			session.limit = 120
			let booking = Booking{}
			try session.fill(booking, "Book a room for Ada Lovelace: three nights, breakfast included. Answer as JSON.")
			fail "filled {booking.guest} {booking.nights} {booking.breakfast}" unless booking.guest.contains("Ada") && booking.nights == 3 && booking.breakfast
			return none
		}
	}
}
