partial module std.ai.llm {
	use (
		std.testing
		std.services.runtime::(Runtime)
		std.data.encoding::(JSON)
		std.ai.llm.calls::*
		std.ai.llm.testmodels::(tinyModel)
	)

	// What `fill` writes into.
	internal struct Booking {
		// The guest's name.
		guest     string
		nights    int
		// Whether breakfast is included.
		breakfast bool
	}

	// Whether the recognizer of `schema` takes the whole of `text` and
	// sees a complete value.
	internal def takes(schema string, text string) bool {
		let parsed = (new JSON()).parse(schema) onerror recover none
		let root = compileShape(parsed) onerror recover new ShapeNode(ShapeKind.Never)
		let matcher = new ShapeMatcher(root)
		return matcher.feed(text.bytes()) && matcher.complete()
	}

	// Whether it takes `text` as the start of a value (not yet complete).
	internal def starts(schema string, text string) bool {
		let parsed = (new JSON()).parse(schema) onerror recover none
		let root = compileShape(parsed) onerror recover new ShapeNode(ShapeKind.Never)
		let matcher = new ShapeMatcher(root)
		return matcher.feed(text.bytes()) && !matcher.complete()
	}

	check "Structured output" {
		@test()
		def TestObjects() {
			let order = "\{\"type\":\"object\",\"properties\":\{\"item\":\{\"type\":\"string\"},\"count\":\{\"type\":\"integer\"},\"size\":\{\"enum\":[\"small\",\"large\"]},\"note\":\{\"type\":\"string\"}},\"required\":[\"item\",\"count\",\"size\"]}"
			assert takes(order, "\{\"item\":\"tea\",\"count\":2,\"size\":\"large\"}")
			assert takes(order, "\{ \"size\": \"small\", \"count\": -12, \"item\": \"a \\\"b\\\"\", \"note\": \"x\" }")
			// A required key missing, an unknown key, a wrong enum member, a
			// fraction for an integer, a key twice.
			assert !takes(order, "\{\"item\":\"tea\",\"count\":2}")
			assert !starts(order, "\{\"colour\"")
			assert !starts(order, "\{\"size\":\"medium")
			assert !starts(order, "\{\"item\":\"tea\",\"count\":2.5")
			assert !starts(order, "\{\"item\":\"a\",\"item\"")
			// No comma once every declared key is written.
			assert !starts(order, "\{\"item\":\"t\",\"count\":1,\"size\":\"small\",\"note\":\"n\",")
			assert starts(order, "\{\"item\":\"tea\",\"count\":2")
			assert starts(order, "\{\"si")
			// Runs of whitespace are bounded.
			assert !starts(order, "\{   \"item\"")
		}

		@test()
		def TestArraysChoicesAndScalars() {
			let list = "\{\"type\":\"array\",\"items\":\{\"type\":\"number\"},\"minItems\":1,\"maxItems\":3}"
			assert takes(list, "[1, -0.5, 2e3]")
			assert !takes(list, "[]")
			assert !starts(list, "[1,2,3,")
			assert !starts(list, "[01")
			let either = "\{\"anyOf\":[\{\"type\":\"boolean\"},\{\"type\":\"null\"},\{\"const\":7}]}"
			assert takes(either, "true") && takes(either, "null") && takes(either, "7") && !starts(either, "8")
			let nullable = "\{\"type\":[\"string\",\"null\"]}"
			assert takes(nullable, "\"x\"") && takes(nullable, "null") && !starts(nullable, "1")
			// A number at the top is complete where it may end.
			assert takes("\{\"type\":\"integer\"}", "42") && !takes("\{\"type\":\"integer\"}", "-")
			// Any JSON for an empty schema.
			assert takes("\{}", "\{\"a\":[1,\{\"b\":null}],\"c\":\"d\"}")
			assert !starts("\{}", "\{\"a\":]")
		}

		@test()
		def TestStringBoundsAndPatterns() {
			let short = "\{\"type\":\"string\",\"minLength\":2,\"maxLength\":3}"
			assert takes(short, "\"éé\"") && takes(short, "\"a\\u00e9b\"") && !takes(short, "\"a\"")
			assert !starts(short, "\"abcd")
			let code = "\{\"type\":\"string\",\"pattern\":\"^[A-Z]\{3}-[0-9]+$\"}"
			assert takes(code, "\"ABC-12\"") && starts(code, "\"AB") && !starts(code, "\"ABx")
			assert !takes(code, "\"ABC-\"")
			// Matched anywhere unless anchored.
			let cat = "\{\"type\":\"string\",\"pattern\":\"cat\"}"
			assert takes(cat, "\"a cat!\"") && starts(cat, "\"dog") && !takes(cat, "\"dog\"")
			// No room left for the pattern's end within the length.
			let tight = "\{\"type\":\"string\",\"pattern\":\"^a+b$\",\"maxLength\":3}"
			assert takes(tight, "\"aab\"") && starts(tight, "\"aa") && !starts(tight, "\"aaa")
			// Escapes are matched as the characters they stand for.
			let accent = "\{\"type\":\"string\",\"pattern\":\"^é\\\\n$\"}"
			assert takes(accent, "\"\\u00e9\\n\"") && takes(accent, "\"é\\n\"") && !starts(accent, "\"e")
			// A surrogate pair is one character.
			assert takes("\{\"type\":\"string\",\"maxLength\":1}", "\"\\ud83d\\ude00\"")
			assert !starts("\{\"type\":\"string\"}", "\"\\ud83d\\u0041")
		}

		@test()
		def TestFormats() {
			let date = "\{\"type\":\"string\",\"format\":\"date\"}"
			assert takes(date, "\"2026-10-15\"") && !starts(date, "\"2026-13") && !takes(date, "\"2026-10\"")
			assert takes("\{\"format\":\"date-time\"}", "\"2026-10-15T09:30:00.5+02:00\"")
			assert takes("\{\"format\":\"time\"}", "\"23:59:60Z\"") && !starts("\{\"format\":\"time\"}", "\"24")
			let email = "\{\"type\":\"string\",\"format\":\"email\"}"
			assert takes(email, "\"ada@example.org\"") && !takes(email, "\"ada@example\"") && !starts(email, "\"a b")
			assert takes("\{\"format\":\"ipv4\"}", "\"192.168.0.255\"") && !starts("\{\"format\":\"ipv4\"}", "\"256")
			let v6 = "\{\"format\":\"ipv6\"}"
			assert takes(v6, "\"::1\"") && takes(v6, "\"2001:db8::8a2e:370:7334\"") && takes(v6, "\"::ffff:192.0.2.1\"") && !takes(v6, "\"1::2::3\"")
			assert takes("\{\"format\":\"uuid\"}", "\"123e4567-e89b-12d3-a456-426614174000\"")
			let duration = "\{\"format\":\"duration\"}"
			assert takes(duration, "\"P3DT4H\"") && takes(duration, "\"P2W\"") && !takes(duration, "\"PT\"") && !takes(duration, "\"P\"")
			assert takes("\{\"format\":\"hostname\"}", "\"a-b.example\"") && takes("\{\"format\":\"uri\"}", "\"https://a.b/c?d\"")
			// A format this does not know narrows nothing.
			assert takes("\{\"type\":\"string\",\"format\":\"color\"}", "\"anything\"")
		}

		@test()
		def TestNumberBounds() {
			let range = "\{\"type\":\"integer\",\"minimum\":1,\"maximum\":10}"
			assert takes(range, "1") && takes(range, "10") && !starts(range, "0") && !takes(range, "11") && !starts(range, "-")
			assert takes("\{\"type\":\"integer\",\"minimum\":-5,\"maximum\":-2}", "-3") && !starts("\{\"type\":\"integer\",\"minimum\":-5,\"maximum\":-2}", "-1")
			let below = "\{\"type\":\"number\",\"exclusiveMaximum\":10}"
			assert takes(below, "9.99") && !takes(below, "10") && !starts(below, "10.")
			// A bounded number is written without an exponent.
			assert !starts("\{\"type\":\"number\",\"minimum\":0}", "1e")
			let quarter = "\{\"type\":\"number\",\"minimum\":0,\"maximum\":1,\"multipleOf\":0.25}"
			assert takes(quarter, "0.5") && takes(quarter, "0.25") && !starts(quarter, "0.3") && starts(quarter, "0.2") && !takes(quarter, "0.2")
			assert takes("\{\"type\":\"integer\",\"multipleOf\":5}", "35") && !takes("\{\"type\":\"integer\",\"multipleOf\":5}", "36")
			// Draft 4's boolean exclusiveMinimum.
			assert !takes("\{\"type\":\"integer\",\"minimum\":3,\"exclusiveMinimum\":true}", "3")
		}

		@test()
		def TestObjectKeysAndArrays() {
			let open = "\{\"type\":\"object\",\"properties\":\{\"a\":\{\"type\":\"integer\"}},\"additionalProperties\":\{\"type\":\"boolean\"}}"
			assert takes(open, "\{\"a\":1,\"zz\":true}") && !starts(open, "\{\"zz\":1")
			assert takes("\{\"type\":\"object\",\"additionalProperties\":true,\"properties\":\{\"a\":\{}}}", "\{\"b\":[1]}")
			assert !starts("\{\"type\":\"object\",\"additionalProperties\":false}", "\{\"")
			let patterned = "\{\"type\":\"object\",\"patternProperties\":\{\"^x-\":\{\"type\":\"string\"},\"-n$\":\{\"type\":\"integer\"}}}"
			assert takes(patterned, "\{\"x-a\":\"s\",\"b-n\":2}") && !takes(patterned, "\{\"y\":1}") && !starts(patterned, "\{\"x-a\":1")
			// A key both patterns match is held to both: no value is both.
			assert !takes(patterned, "\{\"x-n\":2}") && !takes(patterned, "\{\"x-n\":\"s\"}")
			let named = "\{\"type\":\"object\",\"additionalProperties\":true,\"propertyNames\":\{\"pattern\":\"^[a-z]+$\"},\"maxProperties\":2,\"minProperties\":1}"
			assert takes(named, "\{\"ab\":1}") && !starts(named, "\{\"A") && !takes(named, "\{}") && !starts(named, "\{\"a\":1,\"b\":2,")
			let pair = "\{\"type\":\"array\",\"prefixItems\":[\{\"type\":\"string\"},\{\"type\":\"integer\"}],\"items\":false}"
			assert takes(pair, "[\"a\",1]") && takes(pair, "[\"a\"]") && !starts(pair, "[1") && !starts(pair, "[\"a\",1,")
			assert !starts("false", "1") && takes("true", "[]")
		}

		@test()
		def TestReferencesAndAllOf() {
			let tree = "\{\"$defs\":\{\"node\":\{\"type\":\"object\",\"properties\":\{\"name\":\{\"type\":\"string\"},\"kids\":\{\"type\":\"array\",\"items\":\{\"$ref\":\"#/$defs/node\"}}},\"required\":[\"name\"]}},\"$ref\":\"#/$defs/node\"}"
			assert takes(tree, "\{\"name\":\"a\",\"kids\":[\{\"name\":\"b\",\"kids\":[\{\"name\":\"c\"}]}]}")
			assert !takes(tree, "\{\"name\":\"a\",\"kids\":[\{}]}")
			let nested = "\{\"type\":\"array\",\"items\":\{\"anyOf\":[\{\"type\":\"integer\"},\{\"$ref\":\"#\"}]}}"
			assert takes(nested, "[1,[2,[3]],[]]") && !starts(nested, "[\"a")
			let merged = "\{\"definitions\":\{\"named\":\{\"properties\":\{\"name\":\{\"type\":\"string\"}},\"required\":[\"name\"]}},\"allOf\":[\{\"$ref\":\"#/definitions/named\"},\{\"properties\":\{\"age\":\{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"age\"]}]}"
			assert takes(merged, "\{\"name\":\"a\",\"age\":3}") && !takes(merged, "\{\"name\":\"a\"}") && !starts(merged, "\{\"age\":-1")
			// A $ref beside other keywords holds with them.
			assert !takes("\{\"$defs\":\{\"n\":\{\"type\":\"integer\"}},\"$ref\":\"#/$defs/n\",\"maximum\":3}", "4")
		}

		@test()
		def TestSchemasThatCannotBeRead() !none {
			try testing.expectError(compileShape((new JSON()).parse("\{\"type\":\"string\",\"pattern\":\"(\"}") onerror recover none))
			try testing.expectError(compileShape((new JSON()).parse("\{\"$ref\":\"#/$defs/missing\"}") onerror recover none))
			return testing.expectError(compileShape((new JSON()).parse("\{\"$ref\":\"other.json#/a\"}") onerror recover none))
		}

		// With tools offered, a reply is the schema's value or a call.
		@test()
		def TestCallsBesideTheSchema() !none {
			let schema = (new JSON()).parse("\{\"type\":\"integer\"}") onerror recover none
			let either = new ShapeNode(ShapeKind.Either)
			either.options.push(try compileShape(schema))
			let marker = new ShapeNode(ShapeKind.Free)
			marker.constants.push("<tool_call>")
			either.options.push(marker)
			let call = new ShapeMatcher(either)
			assert call.feed("<tool_call>\n\{\"name\": \"f\",   \"arguments\": \{}}\n</tool_call>".bytes()) && call.complete()
			let answer = new ShapeMatcher(either)
			assert answer.feed("42".bytes()) && answer.complete() && !(new ShapeMatcher(either)).feed("<x".bytes())
			// Bare JSON calls (Llama 3): the tool's name and arguments.
			let tool = Tool{name: "weather", parameters: [ToolParameter{name: "city", kind: ParameterKind.String}]}
			let format = CallFormat{shape: CallShape.Json, nameKey: "name", argsKey: "parameters"}
			let calls = try compileShape(callSchema(format, [tool]))
			let bare = new ShapeMatcher(calls)
			assert bare.feed("\{\"name\":\"weather\",\"parameters\":\{\"city\":\"Oslo\"}}".bytes()) && bare.complete()
			assert !(new ShapeMatcher(calls)).feed("\{\"name\":\"rain\"".bytes())
			return none
		}

		@test()
		def TestStructSchemas() !none {
			// What jsonschema.schemaOf writes for a struct.
			let schema = parameterSchema(ToolParameter{name: "p", kind: ParameterKind.Object, fields: [ToolParameter{name: "city", kind: ParameterKind.String}, ToolParameter{name: "days", kind: ParameterKind.Integer, required: false}]})
			let matcher = new ShapeMatcher(try compileShape(schema))
			assert matcher.feed("\{\"city\":\"Oslo\"}".bytes()) && matcher.complete()
			return none
		}

		// A local session held to a schema: the tiny model's vocabulary has
		// digits, so an integer answer; it is one, whatever the weights.
		@test()
		def TestSessionAnswerFollowsTheSchema() !none {
			let model = try load(try tinyModel("llama"), Device.Cpu)
			for let seed = 1; seed <= 4; seed++ {
				let session = model.session()
				session.seed = uint(seed)
				session.limit = 6
				session.schema = map<string, any>{"type": "integer"}
				let answer = try session.say("ab 12")
				fail "seed {seed}: {answer}" unless answer.len() > 0 && answer.trim().isNumeric()
			}
			return none
		}

		// `fill` on a remote chat: the request carries the struct's schema,
		// the answer fills the struct, and the schema is the chat's again.
		@test()
		def TestRemoteFill() !none {
			let provider = new ScriptedProvider()
			provider.replies.push([textEvent("\{\"guest\":\"Ada\",\"nights\":3,\"breakfast\":true}"), doneEvent(StopReason.End, 1, 1)])
			let chat = new RemoteChat(provider, "m")
			let booking = Booking{}
			try chat.fill(booking, "Ada stays three nights with breakfast.")
			assert booking.guest == "Ada" && booking.nights == 3 && booking.breakfast
			let sent = provider.requests[0].schema
			fail "no schema" when sent is none
			let properties = sent["properties"]
			fail "no properties" unless properties is map<string, any>
			assert properties.len() == 3 && chat.schema is none
			return none
		}

		// With ADM_TEST_TUNING_MODEL (Qwen3 0.6B): a real model fills a
		// struct from a sentence.
		@test()
		def TestRealModelFills() !none {
			let path = Runtime.getEnv("ADM_TEST_TUNING_MODEL")
			return none when path is none || path.len() == 0
			let model = try load(path)
			let session = model.session()
			session.temperature = 0.0
			session.thinking = false
			session.limit = 120
			let booking = Booking{}
			try session.fill(booking, "Book a room for Ada Lovelace: three nights, breakfast included. Answer as JSON.")
			fail "filled {booking.guest} {booking.nights} {booking.breakfast}" unless booking.guest.contains("Ada") && booking.nights == 3 && booking.breakfast
			// A date format and bounds a small model would not keep alone.
			let dated = model.session()
			dated.temperature = 0.0
			dated.thinking = false
			dated.limit = 60
			let parsed = try (new JSON()).parse("\{\"type\":\"object\",\"properties\":\{\"day\":\{\"type\":\"string\",\"format\":\"date\"},\"guests\":\{\"type\":\"integer\",\"minimum\":1,\"maximum\":8}},\"required\":[\"day\",\"guests\"]}")
			fail "the schema is not an object" unless parsed is map<string, any>
			dated.schema = parsed
			let answer = try dated.say("A table for three on the second of March 2027, please. Answer as JSON.")
			let recognizer = new ShapeMatcher(try compileShape(dated.schema))
			fail "answer {answer}" unless recognizer.feed(answer.trim().bytes()) && recognizer.complete() && answer.contains("\"guests\": 3")
			// With a tool offered the model calls it, then answers in the
			// schema's shape from its result.
			let asked = model.session()
			asked.temperature = 0.0
			asked.thinking = false
			asked.limit = 120
			let calls = 0
			asked.tools.push(Tool{name: "temperature", description: "The temperature in a city now, in degrees Celsius.", parameters: [ToolParameter{name: "city", kind: ParameterKind.String}], run: def (_ ToolCall) !string {
				calls++
				return "17"
			}})
			let weather = try (new JSON()).parse("\{\"type\":\"object\",\"properties\":\{\"celsius\":\{\"type\":\"integer\"}},\"required\":[\"celsius\"]}")
			fail "the schema is not an object" unless weather is map<string, any>
			asked.schema = weather
			let reply = try asked.say("How warm is it in Oslo now? Use the temperature tool, then answer as JSON.")
			fail "{calls} calls, answer {reply}" unless calls == 1 && reply.replace(" ", "", -1).contains("\"celsius\":17")
			return none
		}
	}
}
