partial module std.ai.llm {
	use (
		std.testing
		std.math
		std.math::(Random)
		std.os
		std.ai.llm.model::(Trainer, devicePair, DevicePair, readParts, uploadModel)
		std.formats.ai
		std.gpu
		std.ai.llm.testmodels::*
		std.services.runtime::(Runtime)
		std.time
	)

	check "Tuning" {
		// The tokens the tiny models are tuned on (their vocabulary has 10);
		// `long` gives 75, which Gated DeltaNet layers run in three chunks.
		internal def sequence(long bool = false) int[] {
			let short = int[0, 1, 2, 4, 5, 6, 7, 8, 3, 1, 2]
			return short unless long
			let out int[]
			for let i = 0; i < 62; i++ {
				out.push(short[(i * 7) % short.len()])
			}
			return out
		}

		// Every position but the last is learnt.
		internal def allTargets(tokens int[]) int[] {
			let out int[]
			for let i = 0; i + 1 < tokens.len(); i++ {
				out.push(i)
			}
			return out
		}

		// A tuning of `path` with B set to small random values, so every
		// pair changes the model and its A has a gradient.
		internal def started(path string, device Device = Device.Cpu) !Tuning {
			let model = try load(path, device)
			let tuning = try model.tune(rank = 3, alpha = 6.0, seed = 5)
			let random = new Random(11)
			for let (_, pair) in tuning.trainer.pairs {
				let b = pair.b.data()
				for let i = 0; i < b.len(); i++ {
					b[i] = float32(random.range<float>(-0.2, 0.2))
				}
				let held = pair.device
				try held.b.write(b, 0) when held is DevicePair
			}
			return tuning
		}

		// The loss of the trainer's sequence with every value of `values`
		// moved by step times `direction`, then put back.
		internal def lossMoved(trainer Trainer, values float32[], direction float32[], step float, long bool = false) !float {
			let kept = values.clone()
			for let i = 0; i < values.len(); i++ {
				values[i] = float32(float(values[i]) + step * float(direction[i]))
			}
			try pushPairs(trainer)
			let tokens = sequence(long)
			let loss = try trainer.run(tokens, allTargets(tokens), float32(0))
			kept.copy(values)
			try pushPairs(trainer)
			return loss
		}

		// The host values of the pairs copied to their device copies.
		internal def pushPairs(trainer Trainer) !none {
			for let (_, pair) in trainer.pairs {
				let held = pair.device
				continue unless held is DevicePair
				try held.a.write(pair.a.data(), 0)
				try held.b.write(pair.b.data(), 0)
			}
			return none
		}

		// The loss's slope along `direction` by central differences at
		// `step` and half of it, extrapolated (Richardson) so the curvature's
		// error cancels, and how far float32 rounding of the loss (a sum
		// of float32 values, `loss` large) can move it.
		internal def slopeAlong(trainer Trainer, values float32[], direction float32[], step float, loss float, long bool) !(float, float) {
			let wide = ((try lossMoved(trainer, values, direction, step, long)) - (try lossMoved(trainer, values, direction, -step, long))) / (2.0 * step)
			let near = ((try lossMoved(trainer, values, direction, step / 2.0, long)) - (try lossMoved(trainer, values, direction, -step / 2.0, long))) / step
			let numeric = (4.0 * near - wide) / 3.0
			return (numeric, 0.02 * numeric.abs() + 16.0 * loss * 0.00000006 / step)
		}

		// The gradient of each pair's A and B agrees with the loss's slope
		// along a random direction (central differences).
		internal def gradientsAgree(path string, long bool = false, device Device = Device.Cpu) !none {
			let tuning = try started(path, device)
			let trainer = tuning.trainer
			// The tiny models' random weights saturate the attention softmax,
			// which leaves the query and key gradients below what float32
			// differences resolve; a smaller scale spreads it.
			tuning.model.parts.attentionScale *= float32(0.1)
			let tokens = sequence(long)
			try trainer.clearGradients()
			let loss = try trainer.run(tokens, allTargets(tokens), float32(1))
			let random = new Random(23)
			let wrong string[]
			for let (_, pair) in trainer.pairs {
				for let half = 0; half < 2; half++ {
					let values = half == 0 ?? (pair.a.data(), pair.b.data())
					let grads = half == 0 ?? (pair.gradA, pair.gradB)
					let held = pair.device
					if held is DevicePair {
						let buffer = half == 0 ?? (held.gradA, held.gradB)
						grads.len(values.len())
						try buffer.download(grads) when buffer is gpu.DeviceBuffer<float32>
					}
					let direction float32[]
					direction.len(values.len())
					let slope = 0.0
					for let i = 0; i < values.len(); i++ {
						direction[i] = float32(random.range<float>(-1.0, 1.0))
						slope += float(direction[i]) * float(grads[i])
					}
					// A step can cross a change of the experts a token picks,
					// where the loss jumps: a pair whose slope disagrees is
					// measured again over a step ten times smaller.
					let wide = try slopeAlong(trainer, values, direction, 0.01, loss, long)
					let (numeric, tolerance) = wide
					let agrees = (numeric - slope).abs() <= tolerance + 0.02 * slope.abs()
					if !agrees {
						let (fine, fineTolerance) = try slopeAlong(trainer, values, direction, 0.001, loss, long)
						agrees = (fine - slope).abs() <= fineTolerance + 0.02 * slope.abs()
					}
					wrong.push("{pair.name} {half == 0 ?? ("A", "B")}: gradient gives {slope}, the loss's slope {numeric}") unless agrees
				}
			}
			fail "tuning: {path}: " + wrong.join("; ") when wrong.len() > 0
			return none
		}

		@test()
		def TestLlamaGradients() !none {
			return gradientsAgree(try tinyModel("llama", 0, 2))
		}

		@test()
		def TestLlamaOneLayerGradients() !none {
			return gradientsAgree(try tinyModel("llama"))
		}

		@test()
		def TestQwen2Gradients() !none {
			return gradientsAgree(try tinyModel("qwen2"))
		}

		@test()
		def TestExpertsGradients() !none {
			return gradientsAgree(try tinyModel("llama", 4, 2))
		}

		@test()
		def TestGptOssGradients() !none {
			return gradientsAgree(try tinyModel("gpt-oss", 4))
		}

		@test()
		def TestGemma4Gradients() !none {
			return gradientsAgree(try tinyModel("gemma4"))
		}

		@test()
		def TestQwen35Gradients() !none {
			return gradientsAgree(try tinyModel("qwen35"))
		}

		@test()
		def TestQwen35LongGradients() !none {
			return gradientsAgree(try tinyModel("qwen35"), long = true)
		}

		@test()
		def TestGpuQwen35LongGradients() !none {
			return none unless gpu.available()
			return gradientsAgree(try tinyModel("qwen35", 0, 1, 32), long = true, device = Device.Gpu)
		}

		@test()
		def TestQwen35ExpertsGradients() !none {
			return gradientsAgree(try tinyModel("qwen35moe", 4))
		}

		@test()
		def TestGemma3Gradients() !none {
			return gradientsAgree(try tinyModel("gemma3", 0, 2))
		}

		@test()
		def TestPhi3Gradients() !none {
			return gradientsAgree(try tinyModel("phi3"))
		}

		// The trainer's loss is the cross-entropy of the session's logits:
		// its forward pass is the model's, adapters included.
		@test()
		def TestTrainerLossIsTheModels() !none {
			for let (_, arch) in string["llama", "gemma3", "phi3", "experts", "gpt-oss", "gemma4", "qwen35", "qwen35moe"] {
				let path = arch == "experts" ?? (try tinyModel("llama", 4, 2), arch == "gpt-oss" || arch == "qwen35moe" ?? (try tinyModel(arch, 4), try tinyModel(arch, 0, arch == "phi3" || arch == "gemma4" || arch == "qwen35" ?? (1, 2))))
				let tuning = try started(path)
				let tokens = sequence()
				let loss = try tuning.trainer.run(tokens, allTargets(tokens), float32(0))
				let session = tuning.model.session()
				let expected = 0.0
				for let i = 0; i + 1 < tokens.len(); i++ {
					try session.append(int[tokens[i]])
					let logits = session.state.logits
					let top = logits[0]
					for let (_, l) in logits {
						top = top.max(l)
					}
					let sum = 0.0
					for let (_, l) in logits {
						sum += math.E ** float(l - top)
					}
					expected += float(top) + math.ln(sum) - float(logits[tokens[i + 1]])
				}
				fail "tuning: {arch}: the trainer's loss is {loss}, the model's {expected}" unless (loss - expected).abs() <= 0.0001 * expected.abs() + 0.00001
				assert tuning.steps == 0
			}
			return none
		}

		// Learning a text again and again makes it likelier.
		@test()
		def TestLearningLowersTheLoss() !none {
			let model = try load(try tinyModel("llama", 0, 2), Device.Cpu)
			let tuning = try model.tune(rank = 4, seed = 2)
			tuning.learningRate = 0.01
			let text = "ab ab!12ab"
			let first = try tuning.loss(text)
			for let k = 0; k < 30; k++ {
				try tuning.learn(text)
			}
			let last = try tuning.loss(text)
			assert tuning.steps == 30
			fail "tuning: the loss went from {first} to {last}" unless last < first * 0.5
			return none
		}

		// A saved adapter loaded with the model gives the logits the tuned
		// model gives; at scale 0 the model is as it was. Phi-3 shares one
		// pair among its query, key and value; expert stacks are saved as
		// 3D pairs; Qwen 3.5 adapts its Gated DeltaNet projections.
		@test()
		def TestSavedAdapterLoads() !none {
			for let (_, arch) in string["phi3", "experts", "qwen35moe"] {
				let path = arch == "experts" ?? (try tinyModel("llama", 4, 2), arch == "qwen35moe" ?? (try tinyModel(arch, 4), try tinyModel(arch)))
				let model = try load(path, Device.Cpu)
				let before = model.session()
				try before.append(int[0, 1, 2])
				let plain = before.state.logits.clone()
				let tuning = try model.tune(rank = 2, alpha = 5.0, seed = 9)
				tuning.learningRate = 0.01
				for let k = 0; k < 3; k++ {
					try tuning.learn("ab ab!12")
				}
				let tuned = model.session()
				try tuned.append(int[0, 1, 2])
				let saved = os.join(try os.appHome(), "tuned-{arch}.gguf")
				try tuning.save(saved)
				fail "tuning: {arch}: learning changed nothing" when tuned.state.logits.equals(plain)
				let again = try load(path, Device.Cpu, adapters = Adapter[Adapter{path: saved}])
				let s = again.session()
				try s.append(int[0, 1, 2])
				fail "tuning: {arch}: the loaded adapter gives other logits" unless s.state.logits.equals(tuned.state.logits)
				let off = try load(path, Device.Cpu, adapters = Adapter[Adapter{path: saved, scale: 0.0}])
				let h = off.session()
				try h.append(int[0, 1, 2])
				assert h.state.logits.equals(plain)
				// Ended, the tuning leaves its adapter in the model.
				tuning.dispose()
				let after = model.session()
				try after.append(int[0, 1, 2])
				assert after.state.logits.equals(tuned.state.logits)
			}
			return none
		}

		@test()
		def TestAdapterRefusals() !none {
			let path = try tinyModel("llama")
			let model = try load(path, Device.Cpu)
			let tuning = try model.tune(rank = 2)
			try testing.expectError(model.tune())
			let saved = os.join(try os.appHome(), "llama-adapter.gguf")
			try tuning.save(saved)
			// An adapter for another architecture.
			try testing.expectError(load(try tinyModel("gemma3"), Device.Cpu, adapters = Adapter[Adapter{path: saved}]))
			// A model file is not an adapter.
			try testing.expectError(load(path, Device.Cpu, adapters = Adapter[Adapter{path: path}]))
			try testing.expectError(tuning.learn("a"))
			return none
		}

		// A text to tune on and measure with.
		internal def passage() string {
			return "The lighthouse keeper climbed the spiral stairs every evening at dusk, carrying a can of oil and a cloth for the lens. " + "From the gallery he could see the fishing boats returning to the harbour, their lanterns swinging with the swell. " + "On clear nights the beam reached twenty miles out to sea, and sailors used it to find the narrow channel between the rocks. " + "In winter the storms came from the west, and the keeper wrote in his logbook the height of the waves and the direction of the wind. " + "His daughter learned to trim the wick and wind the clockwork that turned the great lens, and when he grew old she kept the light herself."
		}

		// A real model when ADM_TEST_TUNING_MODEL names one (Qwen3 0.6B,
		// Ollama's qwen3:0.6b): the perplexity of the passage's tokens in
		// the second half of its first 64 (as llama-perplexity -c 64 scores
		// one chunk) is llama.cpp's before tuning (66.6252) and with the
		// adapter three steps make (1.0689 for llama.cpp reading the saved
		// file, ADM_TEST_TUNING_OUT or the test's home), within 0.05 nats
		// a token: llama.cpp's CPU path rounds activations to 8 bits (0.033
		// apart before, 0.0045 after, 2026-10-15).
		@test()
		def TestRealModel() !none {
			let path = Runtime.getEnv("ADM_TEST_TUNING_MODEL")
			return none when path is none || path.len() == 0
			let model = try load(path, Device.Cpu)
			let tuning = try model.tune(rank = 8, seed = 3)
			tuning.learningRate = 0.001
			let text = passage()
			let tokens = model.tokenizer.encode(text, true)
			let chunk = 64
			let targets int[]
			for let i = chunk / 2; i < chunk - 1; i++ {
				targets.push(i)
			}
			let perplexity = def () !float {
				let sum = try tuning.trainer.run(tokens[:chunk], targets, float32(0))
				return math.E ** (sum / float(targets.len()))
			}
			let base = try perplexity()
			for let k = 0; k < 3; k++ {
				let began = time.now()
				let loss = try tuning.learn(text)
				print("step {k}: loss {loss} in {time.since(began).seconds()} s\n")
			}
			let out = Runtime.getEnv("ADM_TEST_TUNING_OUT")
			let saved = out is none || out.len() == 0 ?? (os.join(try os.appHome(), "real.gguf"), out)
			try tuning.save(saved)
			let tuned = try perplexity()
			print("perplexity {base} before, {tuned} after (tokens {tokens.len()}, adapter {saved})\n")
			fail "tuning: perplexity {base} before tuning, llama.cpp's 66.6252" unless (math.ln(base) - math.ln(66.6252)).abs() < 0.05
			fail "tuning: perplexity {tuned} after tuning, llama.cpp's 1.0689 with the adapter" unless (math.ln(tuned) - math.ln(1.0689)).abs() < 0.05
			return none
		}

		// A tuning on the GPU gives the loss and gradients the CPU's gives,
		// to float32 rounding, from the same pairs.
		internal def deviceAgrees(path string, slots int = 0, long bool = false) !none {
			let cpu = try started(path)
			let model = try load(path, Device.Gpu)
			if slots > 0 {
				// Fewer experts on the device than the layer has: a tuning
				// brings the ones it needs into slots.
				let file = try ai.load(path)
				let parts = try readParts(file)
				file.close()
				parts.device = try uploadModel(parts, expertSlots = slots)
				model = new LanguageModel(parts)
			}
			let gpuTuning = try model.tune(rank = 3, alpha = 6.0, seed = 5)
			for let (i, pair) in gpuTuning.trainer.pairs {
				cpu.trainer.pairs[i].b.data().copy(pair.b.data())
				let d = try devicePair(pair)
				try d.b.write(pair.b.data(), 0)
			}
			// Spread the tiny models' attention (see gradientsAgree).
			cpu.model.parts.attentionScale *= float32(0.1)
			model.parts.attentionScale *= float32(0.1)
			let tokens = sequence(long)
			let targets = allTargets(tokens)
			try cpu.trainer.clearGradients()
			try gpuTuning.trainer.clearGradients()
			let want = try cpu.trainer.run(tokens, targets, float32(1))
			let got = try gpuTuning.trainer.run(tokens, targets, float32(1))
			fail "tuning on the GPU: {path}: loss {got}, the CPU's {want}" unless (got - want).abs() <= 0.0002 * want.abs() + 0.0001
			for let (i, pair) in gpuTuning.trainer.pairs {
				let d = try devicePair(pair)
				let other = cpu.trainer.pairs[i]
				for let half = 0; half < 2; half++ {
					let wantGrad = half == 0 ?? (other.gradA, other.gradB)
					let buffer = half == 0 ?? (d.gradA, d.gradB)
					fail "tuning on the GPU: {pair.name} has no gradient" when buffer is none
					let gotGrad float32[]
					gotGrad.len(wantGrad.len())
					try buffer.download(gotGrad)
					let largest = float32(0)
					for let (_, w) in wantGrad {
						largest = largest.max(w.abs())
					}
					for let (j, w) in wantGrad {
						fail "tuning on the GPU: {path} {pair.name} {half == 0 ?? ("A", "B")}[{j}]: {gotGrad[j]}, the CPU's {w}" unless (gotGrad[j] - w).abs() <= float32(0.002) * largest + float32(0.000001)
					}
				}
			}
			return none
		}

		@test()
		def TestGpuTuningAgrees() !none {
			return none unless gpu.available()
			try deviceAgrees(try tinyModel("llama", 0, 2))
			try deviceAgrees(try tinyModel("qwen2"))
			try deviceAgrees(try tinyModel("gemma3", 0, 2))
			try deviceAgrees(try tinyModel("phi3"))
			try deviceAgrees(try tinyModel("gemma4"))
			try deviceAgrees(try tinyModel("llama", 4, 2))
			try deviceAgrees(try tinyModel("gpt-oss", 4))
			try deviceAgrees(try tinyModel("llama", 4, 2), slots = 2)
			try deviceAgrees(try tinyModel("qwen35", 0, 1, 32))
			try deviceAgrees(try tinyModel("qwen35moe", 4, 1, 32))
			try deviceAgrees(try tinyModel("qwen35", 0, 1, 32), long = true)
			return none
		}

		// An adapter loaded on the GPU gives the logits it gives on the CPU,
		// for a batch of prompt tokens and for single tokens after it.
		internal def deviceAdapterAgrees(path string, arch string) !none {
			let model = try load(path, Device.Cpu)
			let tuning = try model.tune(rank = 2, alpha = 5.0, seed = 9, targets = Target[Target.Query, Target.Key, Target.Value, Target.Output, Target.Gate, Target.Up, Target.Down])
			tuning.learningRate = 0.02
			for let k = 0; k < 3; k++ {
				try tuning.learn("ab ab!12")
			}
			let saved = os.join(try os.appHome(), "device-{arch}.gguf")
			try tuning.save(saved)
			let cpu = try load(path, Device.Cpu, adapters = Adapter[Adapter{path: saved}])
			let device = try load(path, Device.Gpu, adapters = Adapter[Adapter{path: saved}])
			let plain = try load(path, Device.Gpu)
			let (a, b, c) = (cpu.session(), device.session(), plain.session())
			for let (_, chunk) in [int[0, 1, 2, 4], int[5], int[6]] {
				try a.append(chunk)
				try b.append(chunk)
				try c.append(chunk)
				let want = a.state.logits
				let got = b.state.logits
				fail "adapter on the GPU: {arch}: the adapter changed nothing" when got.equals(c.state.logits)
				for let (i, w) in want {
					fail "adapter on the GPU: {arch}: logit {i} after {chunk}: {got[i]}, the CPU's {w}" unless (got[i] - w).abs() <= float32(0.001) * w.abs().max(float32(1))
				}
			}
			return none
		}

		@test()
		def TestGpuAdapterAgrees() !none {
			return none unless gpu.available()
			try deviceAdapterAgrees(try tinyModel("llama", 0, 2), "llama")
			try deviceAdapterAgrees(try tinyModel("gemma3", 0, 2), "gemma3")
			try deviceAdapterAgrees(try tinyModel("phi3"), "phi3")
			try deviceAdapterAgrees(try tinyModel("gemma4"), "gemma4")
			try deviceAdapterAgrees(try tinyModel("qwen35", 0, 1, 32), "qwen35")
			try deviceAdapterAgrees(try tinyModel("llama", 4, 2), "experts")
			try deviceAdapterAgrees(try tinyModel("gpt-oss", 4), "gpt-oss")
			return none
		}
	}
}
