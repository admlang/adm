internal partial module std.ai.llm.unicode {
	use (
		std.text.unicode
		std.text.unicode::(Category)
	)

	// The character classes the pre-tokenizers' patterns name, from the
	// Unicode Character Database in `std.text.unicode`.

	// \p{L}
	def isLetter(c int) bool {
		return (c >= 0x61 && c <= 0x7A) || (c >= 0x41 && c <= 0x5A) when c < 0x80
		return unicode.category(char(c)) := Category.UppercaseLetter || Category.LowercaseLetter || Category.TitlecaseLetter || Category.ModifierLetter || Category.OtherLetter
	}

	// \p{N}
	def isNumber(c int) bool {
		return c >= 0x30 && c <= 0x39 when c < 0x80
		return unicode.category(char(c)) := Category.DecimalNumber || Category.LetterNumber || Category.OtherNumber
	}

	// \p{M}
	def isMark(c int) bool {
		return false when c < 0x300
		return unicode.category(char(c)) := Category.NonspacingMark || Category.SpacingMark || Category.EnclosingMark
	}

	// \s: Unicode White_Space.
	def isSpace(c int) bool {
		return c := 0x9 || 0xA || 0xB || 0xC || 0xD || 0x1C || 0x1D || 0x1E || 0x1F || 0x20 || 0x85 || 0xA0 || 0x1680 || 0x2000 || 0x2001 || 0x2002 || 0x2003 || 0x2004 || 0x2005 || 0x2006 || 0x2007 || 0x2008 || 0x2009 || 0x200A || 0x2028 || 0x2029 || 0x202F || 0x205F || 0x3000
	}
}
