partial module std.ai.onnx {
	use (
		std.formats.ai.onnx::(ElementType)
		std.ai.tensor::(Tensor, storageOf, Storage)
	)

	// Runs the control flow, sequence and optional operators; false for an
	// operator this family does not have.
	// Fails when the operator fails on its inputs.
	internal def applyControl(c Call) !bool {
		match c.step.op {
			case "If":
				try ifOp(c)
			case "Loop":
				try loopOp(c)
			case "Scan":
				try scanOp(c)
			case "SequenceConstruct":
				let items Tensor[]
				for let i = 0; i < c.inputs.len(); i++ {
					items.push(try c.tensor(i))
				}
				c.out(0, items)
			case "SequenceEmpty":
				c.out(0, Tensor[])
			case "SequenceLength":
				c.out(0, new Tensor(int[], int[(try c.sequence(0)).len()]))
			case "SequenceAt":
				let items = try c.sequence(0)
				let at = try position(c, 1, items.len(), false)
				c.out(0, items[at])
			case "SequenceInsert":
				let given = try c.sequence(0)
				let at = c.has(2) ?? (try position(c, 2, given.len(), true), given.len())
				c.out(0, given[:at] + Tensor[try c.tensor(1)] + given[at:])
			case "SequenceErase":
				let items = (try c.sequence(0)).clone()
				let at = c.has(1) ?? (try position(c, 1, items.len(), false), items.len() - 1)
				fail c.about() + "erase from an empty sequence" when items.len() == 0
				items.remove(at)
				c.out(0, items)
			case "SequenceMap":
				try sequenceMap(c)
			case "SplitToSequence":
				try splitToSequence(c)
			case "ConcatFromSequence":
				try concatFromSequence(c)
			case "Optional":
				c.out(0, c.input(0))
			case "OptionalHasElement":
				c.out(0, new Tensor(int[], int[c.has(0) ?? (1, 0)], ElementType.Bool))
			case "OptionalGetElement":
				fail c.about() + "the optional holds no value" unless c.has(0)
				c.out(0, c.input(0))
			default:
				return false
		}
		return true
	}

	// The position input `i` names in a sequence of `n` items (negative
	// counts from the end); `end` allows n itself (insertion at the end).
	// Fails when it is out of range.
	internal def position(c Call, i int, n int, end bool) !int {
		let p = (try c.ints(i))[0]
		let at = p < 0 ?? (p + n, p)
		fail c.about() + "position {p} is out of range for {n} items" unless at >= 0 && (at < n || (end && at == n))
		return at
	}

	// Runs plan `sub` (a graph attribute of `c`'s node) with `inputs` bound
	// to its formal inputs, in a scope inside the node's; its outputs.
	// Fails when a node of it fails.
	internal def runGraph(c Call, sub Plan, inputs Held[]) !Held[] {
		let env = new Scope(sub, c.scope)
		for let (i, name) in sub.inputs {
			env.set(name, i < inputs.len() ?? (inputs[i].v, none))
		}
		try execute(c.model, sub, env)
		let outs Held[]
		for let (_, name) in sub.outputs {
			outs.push(Held{v: try env.get(name)})
		}
		return outs
	}

	// The plan of graph attribute `name` of `c`'s node.
	// Fails when the node has none.
	internal def graphOf(c Call, name string) !Plan {
		let p = c.step.graphs.get(name)
		fail c.about() + "has no {name} graph" unless p is Plan
		return p
	}

	// If: the then_branch or else_branch graph, by the condition.
	internal def ifOp(c Call) !none {
		let condition = try c.tensor(0)
		let holds = storageOf(condition.element) == Storage.Ints ?? (condition.ints[0] != 0, condition.floats.len() > 0 && condition.floats[0] != float32(0))
		let outs = try runGraph(c, try graphOf(c, holds ?? ("then_branch", "else_branch")), Held[])
		for let (i, h) in outs {
			c.out(i, h.v)
		}
		return none
	}

	// Loop: the body runs while the trip count (input M) and the condition
	// allow, carrying its state; per-iteration scan outputs are stacked.
	internal def loopOp(c Call) !none {
		let body = try graphOf(c, "body")
		let limit = c.has(0) ?? ((try c.ints(0))[0], -1)
		let going = c.has(1) ?? ((try c.ints(1))[0] != 0, true)
		let carried Held[]
		for let i = 2; i < c.inputs.len(); i++ {
			carried.push(Held{v: c.input(i)})
		}
		let scans = body.outputs.len() - 1 - carried.len()
		let collected Tensor[][]
		for let k = 0; k < scans; k++ {
			collected.push(Tensor[])
		}
		let iteration = 0
		for going && (limit < 0 || iteration < limit) {
			let inputs = Held[Held{v: new Tensor(int[], int[iteration])}, Held{v: new Tensor(int[], int[going ?? (1, 0)], ElementType.Bool)}]
			inputs.push(...carried)
			let outs = try runGraph(c, body, inputs)
			let condition = outs[0].v
			going = condition is Tensor ?? (intValues(condition)[0] != 0, going)
			for let k = 0; k < carried.len(); k++ {
				carried[k] = Held{v: outs[1 + k].v}
			}
			for let s = 0; s < scans; s++ {
				let v = outs[1 + carried.len() + s].v
				fail c.about() + "scan output {s} is not a tensor" unless v is Tensor
				collected[s].push(v)
			}
			iteration++
		}
		for let (k, h) in carried {
			c.out(k, h.v)
		}
		for let s = 0; s < scans; s++ {
			c.out(carried.len() + s, stack(collected[s], 0, ElementType.Float))
		}
		return none
	}

	// Scan: the body runs once per slice of the scan inputs along their
	// axes, carrying its state; per-iteration outputs are stacked along the
	// scan output axes. Version 8 has a batch dimension first and optional
	// sequence lengths.
	internal def scanOp(c Call) !none {
		let body = try graphOf(c, "body")
		let scanCount = c.int("num_scan_inputs", 0)
		if c.opset < 9 {
			return scanBatched(c, body, scanCount)
		}
		let stateCount = c.inputs.len() - scanCount
		let scanned Tensor[]
		for let i = stateCount; i < c.inputs.len(); i++ {
			scanned.push(try c.tensor(i))
		}
		let inputAxes = c.ints("scan_input_axes", int[])
		let inputDirections = c.ints("scan_input_directions", int[])
		let outputAxes = c.ints("scan_output_axes", int[])
		let outputDirections = c.ints("scan_output_directions", int[])
		let length = -1
		for let (k, t) in scanned {
			let axis = normalAxis(k < inputAxes.len() ?? (inputAxes[k], 0), t.rank())
			fail c.about() + "scan inputs differ in length" unless length < 0 || t.shape[axis] == length
			length = t.shape[axis]
		}
		let states Held[]
		for let i = 0; i < stateCount; i++ {
			states.push(Held{v: c.input(i)})
		}
		let outCount = body.outputs.len() - stateCount
		let collected Tensor[][]
		for let k = 0; k < outCount; k++ {
			collected.push(Tensor[])
		}
		for let it = 0; it < length.max(0); it++ {
			let inputs Held[]
			for let (_, h) in states {
				inputs.push(Held{v: h.v})
			}
			for let (k, t) in scanned {
				let axis = normalAxis(k < inputAxes.len() ?? (inputAxes[k], 0), t.rank())
				let reverse = k < inputDirections.len() && inputDirections[k] == 1
				inputs.push(Held{v: sliceAxis(t, axis, reverse ?? (length - 1 - it, it))})
			}
			let outs = try runGraph(c, body, inputs)
			for let k = 0; k < stateCount; k++ {
				states[k] = Held{v: outs[k].v}
			}
			for let s = 0; s < outCount; s++ {
				let v = outs[stateCount + s].v
				fail c.about() + "scan output {s} is not a tensor" unless v is Tensor
				collected[s].push(v)
			}
		}
		for let (k, h) in states {
			c.out(k, h.v)
		}
		for let s = 0; s < outCount; s++ {
			let items = collected[s]
			if s < outputDirections.len() && outputDirections[s] == 1 {
				items = items.reverse()
			}
			let rank = items.len() > 0 ?? (items[0].rank() + 1, 1)
			let axis = normalAxis(s < outputAxes.len() ?? (outputAxes[s], 0), rank)
			c.out(stateCount + s, stack(items, axis, ElementType.Float))
		}
		return none
	}

	// Scan version 8: input 0 the optional sequence lengths, then the
	// states and scan inputs, all with a batch dimension first; the scan
	// axis is 1.
	internal def scanBatched(c Call, body Plan, scanCount int) !none {
		let stateCount = c.inputs.len() - 1 - scanCount
		let directions = c.ints("directions", int[])
		let lengths = c.has(0) ?? (try c.ints(0), int[])
		let first = try c.tensor(1)
		let batch = first.shape[0]
		let outCount = body.outputs.len() - stateCount
		let finals Tensor[][]
		for let k = 0; k < stateCount; k++ {
			finals.push(Tensor[])
		}
		let scanOuts Tensor[][]
		for let k = 0; k < outCount; k++ {
			scanOuts.push(Tensor[])
		}
		for let b = 0; b < batch; b++ {
			let states Held[]
			for let i = 0; i < stateCount; i++ {
				states.push(Held{v: sliceAxis(try c.tensor(1 + i), 0, b)})
			}
			let scanned Tensor[]
			for let i = 0; i < scanCount; i++ {
				scanned.push(sliceAxis(try c.tensor(1 + stateCount + i), 0, b))
			}
			let length = scanned.len() > 0 ?? (scanned[0].shape[0], 0)
			length = lengths.len() > 0 ?? (lengths[b], length)
			let collected Tensor[][]
			for let k = 0; k < outCount; k++ {
				collected.push(Tensor[])
			}
			for let it = 0; it < length; it++ {
				let inputs Held[]
				for let (_, h) in states {
					inputs.push(Held{v: h.v})
				}
				for let (k, t) in scanned {
					let reverse = k < directions.len() && directions[k] == 1
					inputs.push(Held{v: sliceAxis(t, 0, reverse ?? (length - 1 - it, it))})
				}
				let outs = try runGraph(c, body, inputs)
				for let k = 0; k < stateCount; k++ {
					states[k] = Held{v: outs[k].v}
				}
				for let s = 0; s < outCount; s++ {
					let v = outs[stateCount + s].v
					fail c.about() + "scan output {s} is not a tensor" unless v is Tensor
					collected[s].push(v)
				}
			}
			for let k = 0; k < stateCount; k++ {
				let v = states[k].v
				fail c.about() + "state {k} is not a tensor" unless v is Tensor
				finals[k].push(v)
			}
			for let s = 0; s < outCount; s++ {
				scanOuts[s].push(stack(collected[s], 0, ElementType.Float))
			}
		}
		for let k = 0; k < stateCount; k++ {
			c.out(k, stack(finals[k], 0, ElementType.Float))
		}
		for let s = 0; s < outCount; s++ {
			c.out(stateCount + s, stack(scanOuts[s], 0, ElementType.Float))
		}
		return none
	}

	// `axis` counted from the end when negative, for a tensor of `rank`.
	internal def normalAxis(axis int, rank int) int {
		return axis < 0 ?? (axis + rank, axis)
	}

	// Slice `i` of `t` along `axis`, that dimension removed.
	internal def sliceAxis(t Tensor, axis int, i int) Tensor {
		let shape int[]
		for let (d, n) in t.shape {
			shape.push(n) unless d == axis
		}
		let out = zerosLike(t.element, shape)
		let outer = 1
		for let d = 0; d < axis; d++ {
			outer *= t.shape[d]
		}
		let inner = 1
		for let d = axis + 1; d < t.rank(); d++ {
			inner *= t.shape[d]
		}
		let size = t.shape[axis]
		for let o = 0; o < outer; o++ {
			copyRun(t, (o * size + i) * inner, out, o * inner, inner)
		}
		return out
	}

	// Copies n values of `from` from `at` to `to` from `to_at`.
	internal def copyRun(from Tensor, at int, to Tensor, toAt int, n int) {
		match storageOf(from.element) {
			case Storage.Floats:
				from.floats[at:at + n].copy(to.floats[toAt:toAt + n])
			case Storage.Doubles:
				from.doubles[at:at + n].copy(to.doubles[toAt:toAt + n])
			case Storage.Ints:
				from.ints[at:at + n].copy(to.ints[toAt:toAt + n])
			default:
				from.strings[at:at + n].copy(to.strings[toAt:toAt + n])
		}
	}

	// `items` (one shape) stacked along a new dimension `axis`; with no
	// items an empty tensor of `element` (shape [0]).
	internal def stack(items Tensor[], axis int, element ElementType) Tensor {
		if items.len() == 0 {
			return zerosLike(element, int[0])
		}
		let first = items[0]
		let shape int[]
		for let d = 0; d < axis; d++ {
			shape.push(first.shape[d])
		}
		shape.push(items.len())
		for let d = axis; d < first.rank(); d++ {
			shape.push(first.shape[d])
		}
		let out = zerosLike(first.element, shape)
		let outer = 1
		for let d = 0; d < axis; d++ {
			outer *= first.shape[d]
		}
		let inner = first.count() / outer.max(1)
		for let (k, t) in items {
			for let o = 0; o < outer; o++ {
				copyRun(t, o * inner, out, (o * items.len() + k) * inner, inner)
			}
		}
		return out
	}

	// SequenceMap: the body once per item of the sequence input (with the
	// matching item of further sequence inputs, or the same tensor input),
	// each output collected into a sequence.
	internal def sequenceMap(c Call) !none {
		let body = try graphOf(c, "body")
		let first = try c.sequence(0)
		let outputs Tensor[][]
		for let k = 0; k < body.outputs.len(); k++ {
			outputs.push(Tensor[])
		}
		for let i = 0; i < first.len(); i++ {
			let inputs = Held[Held{v: first[i]}]
			for let k = 1; k < c.inputs.len(); k++ {
				let v = c.input(k)
				if v is Tensor[] {
					inputs.push(Held{v: v[i]})
				} else {
					inputs.push(Held{v: v})
				}
			}
			let outs = try runGraph(c, body, inputs)
			for let (k, h) in outs {
				let v = h.v
				fail c.about() + "body output {k} is not a tensor" unless v is Tensor
				outputs[k].push(v)
			}
		}
		for let (k, items) in outputs {
			c.out(k, items)
		}
		return none
	}

	// SplitToSequence: pieces along `axis`: of the sizes input 1 gives (a
	// scalar: pieces of that size, the last shorter), else of size 1 with
	// the axis removed unless keepdims.
	internal def splitToSequence(c Call) !none {
		let t = try c.tensor(0)
		let axis = normalAxis(c.int("axis", 0), t.rank())
		let size = t.shape[axis]
		let sizes int[]
		let keep = true
		if c.has(1) {
			let given = try c.tensor(1)
			let values = intValues(given)
			if given.rank() == 0 {
				for let at = 0; at < size; at += values[0] {
					sizes.push(values[0].min(size - at))
				}
			} else {
				sizes = values
			}
		} else {
			for let i = 0; i < size; i++ {
				sizes.push(1)
			}
			keep = c.int("keepdims", 1) != 0
		}
		let items Tensor[]
		let at = 0
		for let (_, n) in sizes {
			let piece = rangeAxis(t, axis, at, n)
			if !keep {
				piece = sliceAxis(piece, axis, 0)
			}
			items.push(piece)
			at += n
		}
		c.out(0, items)
		return none
	}

	// Values `from` to `from + n` of `t` along `axis`.
	internal def rangeAxis(t Tensor, axis int, from int, n int) Tensor {
		let shape = t.shape.clone()
		shape[axis] = n
		let out = zerosLike(t.element, shape)
		let outer = 1
		for let d = 0; d < axis; d++ {
			outer *= t.shape[d]
		}
		let inner = 1
		for let d = axis + 1; d < t.rank(); d++ {
			inner *= t.shape[d]
		}
		for let o = 0; o < outer; o++ {
			copyRun(t, (o * t.shape[axis] + from) * inner, out, o * n * inner, n * inner)
		}
		return out
	}

	// ConcatFromSequence: the items joined along `axis`, or stacked along a
	// new one with new_axis.
	internal def concatFromSequence(c Call) !none {
		let items = try c.sequence(0)
		fail c.about() + "the sequence is empty" when items.len() == 0
		let newAxis = c.int("new_axis", 0) != 0
		let rank = items[0].rank() + (newAxis ?? (1, 0))
		let axis = normalAxis(c.int("axis", 0), rank)
		if newAxis {
			c.out(0, stack(items, axis, items[0].element))
			return none
		}
		let shape = items[0].shape.clone()
		shape[axis] = 0
		for let (_, t) in items {
			shape[axis] += t.shape[axis]
		}
		let out = zerosLike(items[0].element, shape)
		let outer = 1
		for let d = 0; d < axis; d++ {
			outer *= shape[d]
		}
		let inner = 1
		for let d = axis + 1; d < shape.len(); d++ {
			inner *= shape[d]
		}
		let at = 0
		for let (_, t) in items {
			let n = t.shape[axis]
			for let o = 0; o < outer; o++ {
				copyRun(t, o * n * inner, out, (o * shape[axis] + at) * inner, n * inner)
			}
			at += n
		}
		c.out(0, out)
		return none
	}
}
