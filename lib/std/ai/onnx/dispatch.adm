partial module std.ai.onnx {
	use (
		std.formats.ai.onnx::(ElementType)
		std.ai.tensor::(Tensor, storageOf, Storage)
	)

	// Runs the operator of `c`'s node.
	// Fails when the operator, its domain or a version of it is not
	// supported, or it fails on its inputs.
	internal def apply(c Call) !none {
		if c.step.domain != "" {
			return none when c.step.domain == "ai.onnx.ml" && try applyMl(c)
			return none when c.step.domain == "ai.onnx.preview.training" && try applyTraining(c)
			return none when c.step.domain == "ai.onnx.preview" && try applyPreview(c)
			fail "onnx: operator {c.step.op} of domain {c.step.domain} is not supported"
		}
		match c.step.op {
			case "Add":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Add, c.consumes(0), c.pool))
			case "Sub":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Sub, c.consumes(0), c.pool))
			case "Mul":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Mul, c.consumes(0), c.pool))
			case "Div":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Div, c.consumes(0), c.pool))
			case "Pow":
				return out(c, try power(try c.tensor(0), try c.tensor(1), c.consumes(0), c.pool))
			case "Mod":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), c.int("fmod", 0) == 1 ?? (Binary.Fmod, Binary.Mod)))
			case "PRelu":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.PRelu))
			case "BitShift":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), c.text("direction", "LEFT") == "LEFT" ?? (Binary.ShiftLeft, Binary.ShiftRight)))
			case "BitwiseAnd":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.BitAnd))
			case "BitwiseOr":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.BitOr))
			case "BitwiseXor":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.BitXor))
			case "And":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.And))
			case "Or":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Or))
			case "Xor":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Xor))
			case "Equal":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Equal))
			case "Less":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Less))
			case "LessOrEqual":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.LessOrEqual))
			case "Greater":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.Greater))
			case "GreaterOrEqual":
				return out(c, try binary(try c.tensor(0), try c.tensor(1), Binary.GreaterOrEqual))
			case "Sum":
				return variadic(c, Binary.Add, false)
			case "Mean":
				return variadic(c, Binary.Add, true)
			case "Max":
				return variadic(c, Binary.Max, false)
			case "Min":
				return variadic(c, Binary.Min, false)
			case "Where":
				return choose(c)
			case "Not":
				return invert(c, false)
			case "BitwiseNot":
				return invert(c, true)
			case "IsNaN":
				return classify(c, true)
			case "IsInf":
				return classify(c, false)
			case "Clip":
				return clip(c)
			case "Cast":
				let to = ElementType(c.int("to", 1))
				return out(c, try cast(try c.tensor(0), to, c.int("saturate", 1) != 0, c.text("round_mode", "up")))
			case "CastLike":
				return out(c, try cast(try c.tensor(0), (try c.tensor(1)).element, c.int("saturate", 1) != 0, c.text("round_mode", "up")))
			case "Identity":
				c.out(0, c.input(0))
				return none
			default:
				return none when try applyShapes(c)
				return none when try applyReductions(c)
				return none when try applyLinalg(c)
				return none when try applyConvolutions(c)
				return none when try applyRecurrent(c)
				return none when try applyControl(c)
				return none when try applySignals(c)
				let named = unaryOf(c.step.op)
				fail "onnx: operator {c.step.op} is not supported" unless named is Unary
				let fn = named == Unary.Gelu && c.text("approximate", "none") == "tanh" ?? (Unary.GeluTanh, named)
				return out(c, try unary(try c.tensor(0), fn, unaryParams(c, fn), c.consumes(0), c.pool))
		}
	}

	// Sets output 0 of `c`.
	internal def out(c Call, t Tensor) !none {
		c.out(0, t)
		return none
	}

	// The elementwise function an operator name stands for.
	internal def unaryOf(op string) ?Unary {
		match op {
			case "Abs":
				return Unary.Abs
			case "Neg":
				return Unary.Neg
			case "Exp":
				return Unary.Exp
			case "Log":
				return Unary.Log
			case "Sqrt":
				return Unary.Sqrt
			case "Reciprocal":
				return Unary.Reciprocal
			case "Floor":
				return Unary.Floor
			case "Ceil":
				return Unary.Ceil
			case "Round":
				return Unary.Round
			case "Sin":
				return Unary.Sin
			case "Cos":
				return Unary.Cos
			case "Tan":
				return Unary.Tan
			case "Asin":
				return Unary.Asin
			case "Acos":
				return Unary.Acos
			case "Atan":
				return Unary.Atan
			case "Sinh":
				return Unary.Sinh
			case "Cosh":
				return Unary.Cosh
			case "Asinh":
				return Unary.Asinh
			case "Acosh":
				return Unary.Acosh
			case "Atanh":
				return Unary.Atanh
			case "Erf":
				return Unary.Erf
			case "Sigmoid":
				return Unary.Sigmoid
			case "Tanh":
				return Unary.Tanh
			case "Relu":
				return Unary.Relu
			case "Softplus":
				return Unary.Softplus
			case "Softsign":
				return Unary.Softsign
			case "Sign":
				return Unary.Sign
			case "Elu":
				return Unary.Elu
			case "Selu":
				return Unary.Selu
			case "LeakyRelu":
				return Unary.LeakyRelu
			case "ThresholdedRelu":
				return Unary.ThresholdedRelu
			case "HardSigmoid":
				return Unary.HardSigmoid
			case "HardSwish":
				return Unary.HardSwish
			case "Mish":
				return Unary.Mish
			case "Celu":
				return Unary.Celu
			case "Gelu":
				return Unary.Gelu
			case "Swish":
				return Unary.Swish
			case "Shrink":
				return Unary.Shrink
			default:
				return none
		}
	}

	// The attribute values of an elementwise function, with ONNX's
	// defaults.
	internal def unaryParams(c Call, fn Unary) UnaryParams {
		match fn {
			case Unary.Elu, Unary.Celu:
				return UnaryParams{alpha: c.float("alpha", float32(1))}
			case Unary.Selu:
				return UnaryParams{alpha: c.float("alpha", float32(1.67326319217681884765625)), gamma: c.float("gamma", float32(1.05070102214813232421875))}
			case Unary.LeakyRelu:
				return UnaryParams{alpha: c.float("alpha", float32(0.01))}
			case Unary.ThresholdedRelu:
				return UnaryParams{alpha: c.float("alpha", float32(1))}
			case Unary.HardSigmoid:
				return UnaryParams{alpha: c.float("alpha", float32(0.2)), beta: c.float("beta", float32(0.5))}
			case Unary.Swish:
				return UnaryParams{alpha: c.float("alpha", float32(1))}
			case Unary.Shrink:
				return UnaryParams{alpha: c.float("bias", float32(0)), beta: c.float("lambd", float32(0.5))}
			default:
				return UnaryParams{}
		}
	}

	// Pow: x to the power y, the result of x's type (y may be of another
	// numeric type).
	// With `reuse` the result may take x's arrays (see Call.consumes).
	internal def power(x Tensor, y Tensor, reuse bool = false, pool ?Pool = none) !Tensor {
		let exponent = y.element == x.element ?? (y, try cast(y, x.element, true))
		// A float squared (the variance of layer norms, as exported):
		// x · x, which equals C's pow(x, 2) exactly.
		if storageOf(x.element) == Storage.Floats && exponent.count() == 1 && exponent.floats[0] == float32(2) {
			return binary(x, x, Binary.Mul, reuse, pool)
		}
		return binary(x, exponent, Binary.Pow, reuse, pool)
	}
}
