partial module std.ai.onnx {
	use (
		std.gpu
		std.ai.tensor.gpu::(blockSum, blockMax, tileAsync, copyAsync, copyCommit, copyWait, warpTileTf32)
	)

	// The CUDA kernels of the operators that run on the GPU (see
	// gpu_graph.adm). Tensors are float32, row-major; shapes reach a
	// kernel collapsed to at most six axes (`deviceAxes`), the innermost
	// last, each with its stride per operand (0 where it broadcasts).

	// out[oo + i] = a[...] op b[...] for the i-th position of the shape
	// d0..d5, a and b read through their strides. op: 0 add, 1 sub, 2 mul,
	// 3 div, 4 pow, 5 max, 6 min.
	@launch(block = 256, x = "n", cpu = false)
	internal cuda def deviceBinary(a gpu.DeviceBuffer<float32>, ao int, b gpu.DeviceBuffer<float32>, bo int, out gpu.DeviceBuffer<float32>, oo, op, d0, d1, d2, d3, d4, d5, a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5, n int) !none {
		int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
		if (i >= n) return;
		int64_t r = i, ia = ao, ib = bo, c;
		c = r % d5; r /= d5; ia += c * a5; ib += c * b5;
		c = r % d4; r /= d4; ia += c * a4; ib += c * b4;
		c = r % d3; r /= d3; ia += c * a3; ib += c * b3;
		c = r % d2; r /= d2; ia += c * a2; ib += c * b2;
		c = r % d1; r /= d1; ia += c * a1; ib += c * b1;
		ia += r * a0; ib += r * b0;
		float x = a[ia], y = b[ib], v;
		switch (op) {
			case 0:  v = x + y; break;
			case 1:  v = x - y; break;
			case 2:  v = x * y; break;
			case 3:  v = x / y; break;
			case 4:  v = powf(x, y); break;
			case 5:  v = (x != x || y != y) ? x + y: fmaxf(x, y); break;
			default: v = (x != x || y != y) ? x + y: fminf(x, y); break;
		}
		out[oo + i] = v;
	}

	// out[oo + i] = f(x[xo + i]) for i < n. op: 0 identity, 1 sigmoid,
	// 2 tanh, 3 relu, 4 exp, 5 log, 6 sqrt, 7 neg, 8 abs, 9 reciprocal,
	// 10 erf, 11 gelu (erf), 12 gelu (tanh), 13 sin, 14 cos, 15 leaky relu
	// (alpha), 16 floor, 17 ceil.
	@launch(block = 256, x = "n", cpu = false)
	internal cuda def deviceUnary(x gpu.DeviceBuffer<float32>, xo int, out gpu.DeviceBuffer<float32>, oo, op int, alpha float32, n int) !none {
		int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
		if (i >= n) return;
		float v = x[xo + i], r;
		switch (op) {
			case 0:  r = v; break;
			case 1:  r = 1.0f / (1.0f + expf(-v)); break;
			case 2:  r = tanhf(v); break;
			case 3:  r = v > 0.0f ? v: 0.0f; break;
			case 4:  r = expf(v); break;
			case 5:  r = logf(v); break;
			case 6:  r = sqrtf(v); break;
			case 7:  r = -v; break;
			case 8:  r = fabsf(v); break;
			case 9:  r = 1.0f / v; break;
			case 10: r = erff(v); break;
			case 11: r = 0.5f * v * (1.0f + erff(v * 0.70710678118654752f)); break;
			case 12: r = 0.5f * v * (1.0f + tanhf(0.79788456080286536f * (v + 0.044715f * v * v * v))); break;
			case 13: r = sinf(v); break;
			case 14: r = cosf(v); break;
			case 15: r = v < 0.0f ? alpha * v: v; break;
			case 16: r = floorf(v); break;
			default: r = ceilf(v); break;
		}
		out[oo + i] = r;
	}

	// Copies the shape d0..d5 from src (strides s0..s5 from so) to dst
	// (strides t0..t5 from to).
	@launch(block = 256, x = "n", cpu = false)
	internal cuda def deviceCopy(src gpu.DeviceBuffer<float32>, so int, dst gpu.DeviceBuffer<float32>, to, d0, d1, d2, d3, d4, d5, s0, s1, s2, s3, s4, s5, t0, t1, t2, t3, t4, t5, n int) !none {
		int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
		if (i >= n) return;
		int64_t r = i, is = so, it = to, c;
		c = r % d5; r /= d5; is += c * s5; it += c * t5;
		c = r % d4; r /= d4; is += c * s4; it += c * t4;
		c = r % d3; r /= d3; is += c * s3; it += c * t3;
		c = r % d2; r /= d2; is += c * s2; it += c * t2;
		c = r % d1; r /= d1; is += c * s1; it += c * t1;
		is += r * s0; it += r * t0;
		dst[it] = src[is];
	}

	// Batched C = alpha · op(A) · op(B) + beta · C over `batches` products
	// (A, B and C `sa`, `sb`, `sc` apart; 0 repeats one): op(A) is m × k
	// (A stored k × m when ta), op(B) k × n (stored n × k when tb), rows
	// lda, ldb and ldc apart. Blocks of 256 threads compute 128 × 128
	// tiles of C, 8 × 8 a thread, over shared slices of 8 steps of k;
	// `threads` = tiles · batches · 256.
	@launch(block = 256, x = "threads", cpu = false)
	internal cuda def deviceGemm(a gpu.DeviceBuffer<float32>, ao, lda, ta, sa int, b gpu.DeviceBuffer<float32>, bo, ldb, tb, sb int, c gpu.DeviceBuffer<float32>, co, ldc, sc, m, n, k, batches int, alpha, beta float32, threads int) !none {
		__shared__ __align__(16) float As[8][128];
		__shared__ __align__(16) float Bs[8][128];
		int64_t tilesM = (m + 127) / 128, tilesN = (n + 127) / 128;
		int64_t blk = blockIdx.x, tiles = tilesM * tilesN;
		int64_t bt = blk / tiles, rem = blk % tiles;
		if (bt >= batches) return;
		int64_t tm = (rem % tilesM) * 128, tn = (rem / tilesM) * 128;
		const float * A = a + ao + bt * sa;
		const float * B = b + bo + bt * sb;
		float * C = c + co + bt * sc;
		int tid = threadIdx.x, tx = tid % 16, ty = tid / 16;
		float acc[8][8];
		for (int i = 0; i < 8; i++) {
			for (int j = 0; j < 8; j++) acc[i][j] = 0.0f;
		}
		for (int64_t k0 = 0; k0 < k; k0 += 8) {
			for (int l = 0; l < 4; l++) {
				int idx = tid + l * 256;
				int row, kk;
				if (ta) { kk = idx / 128; row = idx % 128; } else { row = idx / 8; kk = idx % 8; }
				int64_t gm = tm + row, gk = k0 + kk;
				float v = 0.0f;
				if (gm < m && gk < k) v = ta ? A[gk * lda + gm]: A[gm * lda + gk];
				As[kk][row] = v;
			}
			for (int l = 0; l < 4; l++) {
				int idx = tid + l * 256;
				int col, kk;
				if (tb) { col = idx / 8; kk = idx % 8; } else { kk = idx / 128; col = idx % 128; }
				int64_t gk = k0 + kk, gn = tn + col;
				float v = 0.0f;
				if (gk < k && gn < n) v = tb ? B[gn * ldb + gk]: B[gk * ldb + gn];
				Bs[kk][col] = v;
			}
			__syncthreads();
			for (int kk = 0; kk < 8; kk++) {
				float4 a0 = *(float4 *) & As[kk][ty * 8];
				float4 a1 = *(float4 *) & As[kk][ty * 8 + 4];
				float4 b0 = *(float4 *) & Bs[kk][tx * 8];
				float4 b1 = *(float4 *) & Bs[kk][tx * 8 + 4];
				float ar[8] = {a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w};
				float br[8] = {b0.x, b0.y, b0.z, b0.w, b1.x, b1.y, b1.z, b1.w};
				for (int i = 0; i < 8; i++) {
					for (int j = 0; j < 8; j++) acc[i][j] += ar[i] * br[j];
				}
			}
			__syncthreads();
		}
		for (int i = 0; i < 8; i++) {
			int64_t gm = tm + ty * 8 + i;
			if (gm >= m) continue;
			for (int j = 0; j < 8; j++) {
				int64_t gn = tn + tx * 8 + j;
				if (gn >= n) continue;
				float v = alpha * acc[i][j];
				if (beta != 0.0f) v += beta * C[gm * ldc + gn];
				C[gm * ldc + gn] = v;
			}
		}
	}

	// deviceGemm on the tensor cores: A and B rounded to TF32, products
	// added in float32. Blocks of 256 threads compute 128 × 128 tiles of
	// C, each warp 64 × 32 of them, over slices of 16 steps of k copied to
	// shared memory asynchronously, the next slice while the tensor cores
	// work on this one. `threads` as deviceGemm's.
	@launch(block = 256, x = "threads", cpu = false, arch = 80)
	internal cuda def deviceGemmTf32(a gpu.DeviceBuffer<float32>, ao, lda, ta, sa int, b gpu.DeviceBuffer<float32>, bo, ldb, tb, sb int, c gpu.DeviceBuffer<float32>, co, ldc, sc, m, n, k, batches int, alpha, beta float32, threads int) !none {
		__shared__ __align__(16) float As[2][2720];
		__shared__ __align__(16) float Bs[2][2720];
		int64_t tilesM = (m + 127) / 128, tilesN = (n + 127) / 128;
		int64_t blk = blockIdx.x, tiles = tilesM * tilesN;
		int64_t bt = blk / tiles, rem = blk % tiles;
		if (bt >= batches) return;
		int64_t tm = (rem % tilesM) * 128, tn = (rem / tilesM) * 128;
		float * A = a + ao + bt * sa;
		float * B = b + bo + bt * sb;
		float * C = c + co + bt * sc;
		int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
		// Row-major A and transposed B have k along memory.
		int alongA = !ta, alongB = tb != 0;
		int wideA = lda % 4 == 0 && (ao + bt * sa) % 4 == 0, wideB = ldb % 4 == 0 && (bo + bt * sb) % 4 == 0;
		int aO = alongA ? 20: 1, aK = alongA ? 1: 136, bO = alongB ? 20: 1, bK = alongB ? 1: 136;
		float acc[64];
		#pragma unroll
		for (int i = 0; i < 64; i++) acc[i] = 0.0f;
		int64_t slices = (k + 15) / 16;
		tileAsync(As[0], 2720, A, 0, lda, alongA, tm, m, 0, k, wideA);
		tileAsync(Bs[0], 2720, B, 0, ldb, alongB, tn, n, 0, k, wideB);
		copyCommit();
		for (int64_t q = 0; q < slices; q++) {
			int cur = q & 1;
			if (q + 1 < slices) {
				tileAsync(As[cur ^ 1], 2720, A, 0, lda, alongA, tm, m, (q + 1) * 16, k, wideA);
				tileAsync(Bs[cur ^ 1], 2720, B, 0, ldb, alongB, tn, n, (q + 1) * 16, k, wideB);
				copyCommit();
				copyWait(1);
			} else {
				copyWait(0);
			}
			__syncthreads();
			warpTileTf32(As[cur], 2720, aO, aK, Bs[cur], 2720, bO, bK, acc, 64, (warp >> 2) * 64, (warp & 3) * 32, 4, 4);
			__syncthreads();
		}
		int g = lane >> 2, t = lane & 3;
		#pragma unroll
		for (int i = 0; i < 4; i++) {
			#pragma unroll
			for (int j = 0; j < 4; j++) {
				#pragma unroll
				for (int r = 0; r < 4; r++) {
					int64_t gm = tm + (warp >> 2) * 64 + i * 16 + g + (r >> 1) * 8;
					int64_t gn = tn + (warp & 3) * 32 + j * 8 + t * 2 + (r & 1);
					if (gm >= m || gn >= n) continue;
					float v = alpha * acc[(i * 4 + j) * 4 + r];
					if (beta != 0.0f) v += beta * C[gm * ldc + gn];
					C[gm * ldc + gn] = v;
				}
			}
		}
	}

	// deviceConv on the tensor cores, rounded and tiled as deviceGemmTf32:
	// the weights' rows keep k along shared memory, the window columns
	// keep the positions. Each thread copies the window values of one
	// position, walking its taps without divisions. `threads` as
	// deviceConv's.
	@launch(block = 256, x = "threads", cpu = false, arch = 80)
	internal cuda def deviceConvTf32(x gpu.DeviceBuffer<float32>, xo int, w gpu.DeviceBuffer<float32>, wo int, bias gpu.DeviceBuffer<float32>, bo int, out gpu.DeviceBuffer<float32>, oo, batch, channels, height, width, maps, groups, kh, kw, sh, sw, ph, pw, dh, dw, oh, ow, threads int) !none {
		__shared__ __align__(16) float As[2][2720];
		__shared__ __align__(16) float Bs[2][2720];
		int cg = channels / groups, mg = maps / groups;
		int m = mg, k = cg * kh * kw;
		int64_t n = (int64_t) batch * oh * ow;
		int64_t tilesM = (m + 127) / 128, tilesN = (n + 127) / 128;
		int64_t blk = blockIdx.x, tiles = tilesM * tilesN;
		int64_t g = blk / tiles, rem = blk % tiles;
		if (g >= groups) return;
		int64_t tm = (rem % tilesM) * 128, tn = (rem / tilesM) * 128;
		float * W = w + wo + g * mg * k;
		int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
		int wide = k % 4 == 0 && wo % 4 == 0;
		int64_t plane = (int64_t) height * width;
		// This thread's position (column o of the tile) and where its
		// window starts.
		int o = tid & 127, first = tid >> 7;
		int64_t gn = tn + o;
		int inRange = gn < n;
		int64_t positions = (int64_t) oh * ow, nb = gn / positions, p = gn % positions;
		int iy0 = (int) (p / ow) * sh - ph, ix0 = (int) (p % ow) * sw - pw;
		const float * X = x + xo + (nb * channels + g * cg) * plane;
		// The tap of step `first` of the next slice: channel, row, column.
		int taps = kh * kw;
		int ci = first / taps, tr = (first % taps) / kw, ts = first % kw;
		float acc[64];
		#pragma unroll
		for (int i = 0; i < 64; i++) acc[i] = 0.0f;
		#define WINDOW_ASYNC(buf, k0) \
		for (int l = 0; l < 8; l++) { \
			int kk = first + 2 * l; \
			int iy = iy0 + tr * dh, ix = ix0 + ts * dw; \
			int bytes = inRange && (k0) + kk < k && iy >= 0 && iy < height && ix >= 0 && ix < width ? 4: 0; \
			const float * src = bytes ? X + ci * plane + (int64_t) iy * width + ix: x; \
			copyAsync(Bs[buf] + kk * 136 + o, 1, (float *) src, 1, 4, bytes); \
			ts += 2; \
			while (ts >= kw) { ts -= kw; tr++; } \
			while (tr >= kh) { tr -= kh; ci++; } \
		}
		int64_t slices = (k + 15) / 16;
		tileAsync(As[0], 2720, W, 0, k, 1, tm, m, 0, k, wide);
		WINDOW_ASYNC(0, 0)
		copyCommit();
		for (int64_t q = 0; q < slices; q++) {
			int cur = q & 1;
			if (q + 1 < slices) {
				tileAsync(As[cur ^ 1], 2720, W, 0, k, 1, tm, m, (q + 1) * 16, k, wide);
				WINDOW_ASYNC(cur ^ 1, (q + 1) * 16)
				copyCommit();
				copyWait(1);
			} else {
				copyWait(0);
			}
			__syncthreads();
			warpTileTf32(As[cur], 2720, 20, 1, Bs[cur], 2720, 1, 136, acc, 64, (warp >> 2) * 64, (warp & 3) * 32, 4, 4);
			__syncthreads();
		}
		#undef WINDOW_ASYNC
		int fg = lane >> 2, ft = lane & 3;
		// Column by column: one division per position, not per value.
		#pragma unroll
		for (int j = 0; j < 4; j++) {
			#pragma unroll
			for (int c2 = 0; c2 < 2; c2++) {
				int64_t pn = tn + (warp & 3) * 32 + j * 8 + ft * 2 + c2;
				if (pn >= n) continue;
				int64_t pb = pn / positions, pp = pn % positions;
				float * column = out + oo + pb * maps * positions + pp;
				#pragma unroll
				for (int i = 0; i < 4; i++) {
					#pragma unroll
					for (int r2 = 0; r2 < 2; r2++) {
						int64_t gm = tm + (warp >> 2) * 64 + i * 16 + fg + r2 * 8;
						if (gm >= m) continue;
						float add = bo >= 0 ? bias[bo + g * mg + gm]: 0.0f;
						column[(g * mg + gm) * positions] = acc[(i * 4 + j) * 4 + r2 * 2 + c2] + add;
					}
				}
			}
		}
	}

	// 2D convolution as an implicit product: for group g, C (mg output
	// channels × batch · oh · ow positions) = W_g (mg × cg · kh · kw) ·
	// the window values of x, read straight from x (NCHW) with the
	// strides s, pads p and dilations d; bias added when bo >= 0. Tiles
	// as deviceGemm; `threads` = tiles · groups · 256.
	@launch(block = 256, x = "threads", cpu = false)
	internal cuda def deviceConv(x gpu.DeviceBuffer<float32>, xo int, w gpu.DeviceBuffer<float32>, wo int, bias gpu.DeviceBuffer<float32>, bo int, out gpu.DeviceBuffer<float32>, oo, batch, channels, height, width, maps, groups, kh, kw, sh, sw, ph, pw, dh, dw, oh, ow, threads int) !none {
		__shared__ __align__(16) float As[8][128];
		__shared__ __align__(16) float Bs[8][128];
		int64_t cg = channels / groups, mg = maps / groups;
		int64_t m = mg, n = batch * oh * ow, k = cg * kh * kw, taps = kh * kw;
		int64_t tilesM = (m + 127) / 128, tilesN = (n + 127) / 128;
		int64_t blk = blockIdx.x, tiles = tilesM * tilesN;
		int64_t g = blk / tiles, rem = blk % tiles;
		if (g >= groups) return;
		int64_t tm = (rem % tilesM) * 128, tn = (rem / tilesM) * 128;
		const float * W = w + wo + g * mg * k;
		int tid = threadIdx.x, tx = tid % 16, ty = tid / 16;
		float acc[8][8];
		for (int i = 0; i < 8; i++) {
			for (int j = 0; j < 8; j++) acc[i][j] = 0.0f;
		}
		int64_t plane = height * width, positions = oh * ow;
		for (int64_t k0 = 0; k0 < k; k0 += 8) {
			for (int l = 0; l < 4; l++) {
				int idx = tid + l * 256;
				int row = idx / 8, kk = idx % 8;
				int64_t gm = tm + row, gk = k0 + kk;
				As[kk][row] = (gm < m && gk < k) ? W[gm * k + gk]: 0.0f;
			}
			for (int l = 0; l < 4; l++) {
				int idx = tid + l * 256;
				int kk = idx / 128, col = idx % 128;
				int64_t gk = k0 + kk, gn = tn + col;
				float v = 0.0f;
				if (gk < k && gn < n) {
					int64_t ci = gk / taps, t = gk % taps, r = t / kw, s = t % kw;
					int64_t nb = gn / positions, p = gn % positions, y = p / ow, xx = p % ow;
					int64_t iy = y * sh - ph + r * dh, ix = xx * sw - pw + s * dw;
					if (iy >= 0 && iy < height && ix >= 0 && ix < width) {
						v = x[xo + (nb * channels + g * cg + ci) * plane + iy * width + ix];
					}
				}
				Bs[kk][col] = v;
			}
			__syncthreads();
			for (int kk = 0; kk < 8; kk++) {
				float4 a0 = *(float4 *) & As[kk][ty * 8];
				float4 a1 = *(float4 *) & As[kk][ty * 8 + 4];
				float4 b0 = *(float4 *) & Bs[kk][tx * 8];
				float4 b1 = *(float4 *) & Bs[kk][tx * 8 + 4];
				float ar[8] = {a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w};
				float br[8] = {b0.x, b0.y, b0.z, b0.w, b1.x, b1.y, b1.z, b1.w};
				for (int i = 0; i < 8; i++) {
					for (int j = 0; j < 8; j++) acc[i][j] += ar[i] * br[j];
				}
			}
			__syncthreads();
		}
		for (int i = 0; i < 8; i++) {
			int64_t gm = tm + ty * 8 + i;
			if (gm >= m) continue;
			float add = bo >= 0 ? bias[bo + g * mg + gm]: 0.0f;
			for (int j = 0; j < 8; j++) {
				int64_t gn = tn + tx * 8 + j;
				if (gn >= n) continue;
				int64_t nb = gn / positions, p = gn % positions;
				out[oo + (nb * maps + g * mg + gm) * positions + p] = acc[i][j] + add;
			}
		}
	}

	// Softmax (or its log when `log`) of each of `rows` rows of `cols`
	// values, a block per row; `threads` = rows · 256.
	@launch(block = 256, x = "threads", cpu = false)
	internal cuda def deviceSoftmax(x gpu.DeviceBuffer<float32>, xo int, out gpu.DeviceBuffer<float32>, oo, cols, rows, log, threads int) !none {
		__shared__ float scratch[8];
		int64_t row = blockIdx.x;
		if (row >= rows) return;
		const float * in = x + xo + row * cols;
		float * o = out + oo + row * cols;
		float best = -INFINITY;
		for (int64_t j = threadIdx.x; j < cols; j += 256) best = fmaxf(best, in[j]);
		best = blockMax(best, scratch, 8);
		float sum = 0.0f;
		for (int64_t j = threadIdx.x; j < cols; j += 256) sum += expf(in[j] - best);
		sum = blockSum(sum, scratch, 8);
		if (log) {
			float shift = best + logf(sum);
			for (int64_t j = threadIdx.x; j < cols; j += 256) o[j] = in[j] - shift;
		} else {
			float scale = 1.0f / sum;
			for (int64_t j = threadIdx.x; j < cols; j += 256) o[j] = expf(in[j] - best) * scale;
		}
	}

	// Normalizes each of `rows` rows of `cols` values to mean 0 and
	// variance 1 (+ eps), then scales by scale[so + j] and adds
	// shift[bo + j] (each offset -1 for none; `perRow` makes them one value a row,
	// indexed by row % groups, for instance normalization); a block per
	// row; `threads` = rows · 256. With `meanOnly` the row's mean is
	// written to out[oo + row] instead (ReduceMean).
	@launch(block = 256, x = "threads", cpu = false)
	internal cuda def deviceNormalize(x gpu.DeviceBuffer<float32>, xo int, out gpu.DeviceBuffer<float32>, oo int, scale gpu.DeviceBuffer<float32>, so int, shift gpu.DeviceBuffer<float32>, bo, cols, rows, perRow, groups, meanOnly int, eps float32, threads int) !none {
		__shared__ float scratch[8];
		int64_t row = blockIdx.x;
		if (row >= rows) return;
		const float * in = x + xo + row * cols;
		float sum = 0.0f;
		for (int64_t j = threadIdx.x; j < cols; j += 256) sum += in[j];
		float mean = blockSum(sum, scratch, 8) / (float) cols;
		if (meanOnly) {
			if (threadIdx.x == 0) out[oo + row] = mean;
			return;
		}
		float squares = 0.0f;
		for (int64_t j = threadIdx.x; j < cols; j += 256) {
			float d = in[j] - mean;
			squares += d * d;
		}
		float inv = rsqrtf(blockSum(squares, scratch, 8) / (float) cols + eps);
		float * o = out + oo + row * cols;
		int64_t g = row % groups;
		for (int64_t j = threadIdx.x; j < cols; j += 256) {
			float v = (in[j] - mean) * inv;
			int64_t at = perRow ? g: j;
			if (so >= 0) v *= scale[so + at];
			if (bo >= 0) v += shift[bo + at];
			o[j] = v;
		}
	}

	// Resizes `planes` planes of ih × iw to oh × ow: nearest (mode 0,
	// rounding `nearest`: 0 round half down, 1 round half up, 2 floor,
	// 3 ceil) or bilinear (mode 1), the input coordinate of output x being
	// (x + a) / d - b per axis, computed in double as the reference does
	// (a float reciprocal moves 3.5 / 3.5 off 1).
	@launch(block = 256, x = "n", cpu = false)
	internal cuda def deviceResize(x gpu.DeviceBuffer<float32>, xo int, out gpu.DeviceBuffer<float32>, oo, planes, ih, iw, oh, ow, mode, nearest int, dy, dx, ay, ax, by, bx float, n int) !none {
		int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
		if (i >= n) return;
		int64_t xx = i % ow, yy = (i / ow) % oh, plane = i / (ow * oh);
		float sy = (float) (((double) yy + ay) / dy - by);
		float sx = (float) (((double) xx + ax) / dx - bx);
		const float * in = x + xo + plane * ih * iw;
		float v;
		if (mode == 0) {
			float ry, rx;
			switch (nearest) {
				case 0:  ry = ceilf(sy - 0.5f); rx = ceilf(sx - 0.5f); break;
				case 1:  ry = floorf(sy + 0.5f); rx = floorf(sx + 0.5f); break;
				case 2:  ry = floorf(sy); rx = floorf(sx); break;
				default: ry = ceilf(sy); rx = ceilf(sx); break;
			}
			int64_t y0 = (int64_t) fminf(fmaxf(ry, 0.0f), (float) (ih - 1));
			int64_t x0 = (int64_t) fminf(fmaxf(rx, 0.0f), (float) (iw - 1));
			v = in[y0 * iw + x0];
		} else {
			sy = fminf(fmaxf(sy, 0.0f), (float) (ih - 1));
			sx = fminf(fmaxf(sx, 0.0f), (float) (iw - 1));
			int64_t y0 = (int64_t) floorf(sy), x0 = (int64_t) floorf(sx);
			int64_t y1 = y0 + 1 < ih ? y0 + 1: y0, x1 = x0 + 1 < iw ? x0 + 1: x0;
			float wy = sy - (float) y0, wx = sx - (float) x0;
			float top = in[y0 * iw + x0] * (1.0f - wx) + in[y0 * iw + x1] * wx;
			float bottom = in[y1 * iw + x0] * (1.0f - wx) + in[y1 * iw + x1] * wx;
			v = top * (1.0f - wy) + bottom * wy;
		}
		out[oo + i] = v;
	}
}
