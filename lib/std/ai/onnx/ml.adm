partial module std.ai.onnx {
	use (
		std.ai.tensor.gemm::*
		std.simd
		std.math
		std.formats.ai.onnx::(ElementType, Attribute, TensorData)
		std.ai.tensor::(Tensor, tensorOf, storageOf, Storage)
	)

	// Runs the operators of the ai.onnx.ml domain; false for an operator
	// this family does not have. Where the specification leaves a case
	// open the operators do what onnxruntime does.
	// Fails when the operator fails on its inputs.
	internal def applyMl(c Call) !bool {
		match c.step.op {
			case "ArrayFeatureExtractor":
				try featureColumns(c)
			case "Binarizer":
				try binarizer(c)
			case "CategoryMapper":
				try categoryMapper(c)
			case "FeatureVectorizer":
				try featureVectorizer(c)
			case "Imputer":
				try imputer(c)
			case "LabelEncoder":
				try labelEncoder(c)
			case "LinearClassifier":
				try linearClassifier(c)
			case "LinearRegressor":
				try linearRegressor(c)
			case "Normalizer":
				try normalizer(c)
			case "OneHotEncoder":
				try oneHotEncoder(c)
			case "Scaler":
				try scaler(c)
			case "SVMClassifier":
				try svmClassifier(c)
			case "SVMRegressor":
				try svmRegressor(c)
			case "TreeEnsemble":
				try treeEnsemble(c)
			case "TreeEnsembleClassifier":
				try treeClassifier(c)
			case "TreeEnsembleRegressor":
				try treeRegressor(c)
			case "ZipMap", "DictVectorizer", "CastMap":
				fail c.about() + "takes or gives maps, which a value of this library cannot hold"
			default:
				return false
		}
		return true
	}

	// ----- Attributes and inputs -----

	// The strings of list attribute `name`, empty when it is absent.
	internal def textsOf(c Call, name string) string[] {
		let out string[]
		let a = c.attribute(name)
		if a is Attribute {
			for let (_, s) in a.strings {
				out.push(string(s))
			}
		}
		return out
	}

	// Tensor attribute `name` as a tensor, none when absent.
	// Fails when its data cannot be read.
	internal def tensorAttr(c Call, name string) !?Tensor {
		let a = c.attribute(name)
		return none unless a is Attribute
		let t = a.t
		return none unless t is TensorData
		return try tensorOf(t)
	}

	// The values of a numeric tensor as float64.
	// Fails for strings.
	internal def doublesOf(c Call, t Tensor) !float[] {
		match storageOf(t.element) {
			case Storage.Doubles:
				return t.doubles
			case Storage.Floats:
				let out float[]
				out.len(t.floats.len())
				for let (i, v) in t.floats {
					out[i] = float(v)
				}
				return out
			case Storage.Ints:
				let out float[]
				out.len(t.ints.len())
				for let (i, v) in t.ints {
					out[i] = float(v)
				}
				return out
			default:
				fail c.about() + "takes numbers, not strings"
		}
	}

	// Float-list attribute `name`, or its double form `name_as_tensor`
	// when the node has that, as float64; empty when neither is there.
	// Fails when the tensor cannot be read.
	internal def numbersOf(c Call, name string) !float[] {
		let t = try tensorAttr(c, name + "_as_tensor")
		return try doublesOf(c, t) when t is Tensor
		let out float[]
		for let (_, v) in c.floats(name, float32[]) {
			out.push(float(v))
		}
		return out
	}

	// The values of a numeric tensor as float32 (the tensor's own array
	// for the float types).
	// Fails for strings.
	internal def floats32(c Call, t Tensor) !float32[] {
		match storageOf(t.element) {
			case Storage.Floats:
				return t.floats
			case Storage.Doubles:
				let out float32[]
				out.len(t.doubles.len())
				for let (i, v) in t.doubles {
					out[i] = float32(v)
				}
				return out
			case Storage.Ints:
				let out float32[]
				out.len(t.ints.len())
				for let (i, v) in t.ints {
					out[i] = float32(v)
				}
				return out
			default:
				fail c.about() + "takes numbers, not strings"
		}
	}

	// The rows and values per row of an input read as [N, F]: one row
	// for a vector, the dimensions after the first merged for more.
	internal def rowsOf(t Tensor) (int, int) {
		return (1, t.count()) when t.rank() <= 1
		let cols = 1
		for let d = 1; d < t.rank(); d++ {
			cols *= t.shape[d]
		}
		return (t.shape[0], cols)
	}

	// ----- Score transforms -----

	// The transform a classifier or regressor applies to its scores.
	internal enum Post {
		None,
		Softmax,
		Logistic,
		SoftmaxZero,
		Probit,
	}

	// The post_transform attribute (text).
	// Fails for an unknown name.
	internal def postOf(c Call) !Post {
		let name = c.text("post_transform", "NONE")
		match name {
			case "NONE":
				return Post.None
			case "SOFTMAX":
				return Post.Softmax
			case "LOGISTIC":
				return Post.Logistic
			case "SOFTMAX_ZERO":
				return Post.SoftmaxZero
			case "PROBIT":
				return Post.Probit
			default:
				fail c.about() + "unknown post_transform {name}"
		}
	}

	// 1 / (1 + e^−v), computed from |v| so that it never overflows.
	internal def logistic(v float) float {
		let e = 1.0 / (1.0 + math.E ** -v.abs())
		return v < 0.0 ?? (1.0 - e, e)
	}

	// √2 · erf⁻¹(2v − 1) by the approximation onnxruntime and the ONNX
	// reference use (Winitzki, a = 0.147), in float64 (onnxruntime's
	// float32 loses digits near 0.5): ±infinity at 0 and 1, NaN outside
	// [0, 1].
	internal def probit(v float) float {
		let x = 2.0 * v - 1.0
		let sign = x < 0.0 ?? (-1.0, 1.0)
		let w = (1.0 - x) * (1.0 + x)
		return 0.0 / 0.0 unless w >= 0.0
		return sign / 0.0 when w == 0.0
		let lg = math.ln(w)
		let a = 2.0 / (3.14159265358979 * 0.147) + 0.5 * lg
		return 1.41421356 * sign * math.sqrt(-a + math.sqrt(a * a - lg / 0.147))
	}

	// Applies `post` to each row of `n` scores of `z` (`rows` rows); a
	// single score per row takes only PROBIT, as onnxruntime does.
	internal def transformScores<T: SimdFloat>(z T[], rows int, n int, post Post) {
		return when post == Post.None || n == 0
		return when n == 1 && post != Post.Probit
		inBands(rows, rows * n * 16, def (lo int, hi int) {
			for let r = lo; r < hi; r++ {
				transformRow(z, r * n, n, post)
			}
		})
	}

	// Applies `post` to the `n` scores of z from `at`.
	internal def transformRow<T: SimdFloat>(z T[], at int, n int, post Post) {
		match post {
			case Post.Logistic:
				for let i = at; i < at + n; i++ {
					z[i] = T(logistic(float(z[i])))
				}
			case Post.Probit:
				for let i = at; i < at + n; i++ {
					z[i] = T(probit(float(z[i])))
				}
			case Post.Softmax:
				let m = float(z[at])
				for let i = at + 1; i < at + n; i++ {
					m = float(z[i]) > m ?? (float(z[i]), m)
				}
				let sum = 0.0
				for let i = at; i < at + n; i++ {
					let e = math.E ** (float(z[i]) - m)
					z[i] = T(e)
					sum += e
				}
				for let i = at; i < at + n; i++ {
					z[i] = T(float(z[i]) / sum)
				}
			case Post.SoftmaxZero:
				// Softmax over the values that are not zero; zeros stay
				// (nearly) zero.
				let m = float(z[at])
				for let i = at + 1; i < at + n; i++ {
					m = float(z[i]) > m ?? (float(z[i]), m)
				}
				let shrink = math.E ** -m
				let sum = 0.0
				for let i = at; i < at + n; i++ {
					let v = float(z[i])
					let e = (v > 0.0000001 || v < -0.0000001) ?? (math.E ** (v - m), v * shrink)
					z[i] = T(e)
					sum += e
				}
				for let i = at; i < at + n; i++ {
					z[i] = sum == 0.0 ?? (T(0.5), T(float(z[i]) / sum))
				}
			default:
		}
	}

	// The two scores of a binary model that computes one score `s` for
	// the second class: (1 − p, p) with p the score through LOGISTIC or
	// PROBIT, else (−s, s) when `negate` and (1 − s, s) when not.
	internal def twoScores(s float, post Post, negate bool) (float, float) {
		match post {
			case Post.Logistic:
				let p = logistic(s)
				return (1.0 - p, p)
			case Post.Probit:
				let p = probit(s)
				return (1.0 - p, p)
			default:
				return (negate ?? (-s, 1.0 - s), s)
		}
	}

	// ----- Class labels -----

	// A classifier's labels: integers, or strings when `text`.
	internal struct Labels {
		ints    int[]
		strings string[]
		text    bool
	}

	// The classlabels_strings attribute, else integer-list `intsName`.
	internal def labelsOf(c Call, intsName string) Labels {
		let s = textsOf(c, "classlabels_strings")
		return Labels{ints: c.ints(intsName, int[]), strings: s, text: s.len() > 0}
	}

	internal def labelCount(l Labels) int {
		return l.text ?? (l.strings.len(), l.ints.len())
	}

	// The label tensor [picks] for the classes picked per row: label
	// `p`, or for −1 no class (0 or ""); `p` itself when there are no
	// labels.
	internal def labelTensor(l Labels, picks int[]) Tensor {
		if l.text {
			let out string[]
			out.len(picks.len())
			for let (i, p) in picks {
				out[i] = p >= 0 ?? (l.strings[p], "")
			}
			return new Tensor(int[picks.len()], out)
		}
		let out int[]
		out.len(picks.len())
		for let (i, p) in picks {
			out[i] = l.ints.len() == 0 ?? (p, p >= 0 ?? (l.ints[p], 0))
		}
		return new Tensor(int[picks.len()], out)
	}

	// ----- Simple transforms -----

	// ArrayFeatureExtractor: the values at the given indices of the last
	// axis; a vector gives one row.
	// Fails when an index is out of range.
	internal def featureColumns(c Call) !none {
		let x = try c.tensor(0)
		let picks = try c.ints(1)
		fail c.about() + "X needs at least one dimension" when x.rank() == 0
		let s = x.shape[x.rank() - 1]
		for let (_, p) in picks {
			fail c.about() + "index {p} is out of range for {s} values" unless p >= 0 && p < s
		}
		let k = picks.len()
		let shape = x.shape.clone()
		let rows = 1
		if x.rank() == 1 {
			shape = int[1, k]
		} else {
			shape[shape.len() - 1] = k
			for let d = 0; d < x.rank() - 1; d++ {
				rows *= x.shape[d]
			}
		}
		let out = zerosLike(x.element, shape)
		inBands(rows, rows * k, def (lo int, hi int) {
			match storageOf(x.element) {
				case Storage.Floats:
					pickColumns(x.floats, s, out.floats, picks, lo, hi)
				case Storage.Doubles:
					pickColumns(x.doubles, s, out.doubles, picks, lo, hi)
				case Storage.Ints:
					pickColumns(x.ints, s, out.ints, picks, lo, hi)
				default:
					pickColumns(x.strings, s, out.strings, picks, lo, hi)
			}
		})
		c.out(0, out)
		return none
	}

	// Rows lo to hi of `dst` (picks.len() values each) from the picked
	// values of the rows of `src` (`s` values each).
	internal def pickColumns<T>(src T[], s int, dst T[], picks int[], lo int, hi int) {
		let k = picks.len()
		for let r = lo; r < hi; r++ {
			let a = r * s
			let b = r * k
			for let j = 0; j < k; j++ {
				dst[b + j] = src[a + picks[j]]
			}
		}
	}

	// Binarizer: 1 where the value is greater than the threshold, else
	// 0 (NaN too), in the input's type.
	// Fails for strings.
	internal def binarizer(c Call) !none {
		let x = try c.tensor(0)
		let th = c.float("threshold", float32(0))
		let out = zerosLike(x.element, x.shape)
		let n = x.count()
		match storageOf(x.element) {
			case Storage.Floats:
				inBands(n, n, def (lo int, hi int) {
					binarize(x.floats, out.floats, th, lo, hi)
				})
			case Storage.Doubles:
				inBands(n, n, def (lo int, hi int) {
					binarize(x.doubles, out.doubles, float(th), lo, hi)
				})
			case Storage.Ints:
				let limit = float(th)
				inBands(n, n, def (lo int, hi int) {
					for let i = lo; i < hi; i++ {
						out.ints[i] = float(x.ints[i]) > limit ?? (1, 0)
					}
				})
			default:
				fail c.about() + "takes numbers, not strings"
		}
		c.out(0, out)
		return none
	}

	internal def binarize<T: SimdFloat>(x T[], y T[], th T, lo int, hi int) {
		let v vec8<T>
		let limit = v.splat(th)
		let one = v.splat(T(1))
		let zero = v.splat(T(0))
		let i = lo
		for; i + 8 <= hi; i += 8 {
			simd.blend(simd.gt(v.load(x, i), limit), one, zero).store(y, i)
		}
		for; i < hi; i++ {
			y[i] = x[i] > th ?? (T(1), T(0))
		}
	}

	// CategoryMapper: strings to their integers (default_int64 when not
	// listed) or integers to their strings (default_string).
	// Fails for another input type or lists of different lengths.
	internal def categoryMapper(c Call) !none {
		let x = try c.tensor(0)
		let cats = textsOf(c, "cats_strings")
		let ids = c.ints("cats_int64s", int[])
		fail c.about() + "cats_strings has {cats.len()} values, cats_int64s {ids.len()}" unless cats.len() == ids.len()
		let n = x.count()
		if x.element == ElementType.String {
			let index = new map<string, int>()
			for let (i, s) in cats {
				index.set(s, ids[i]) unless index.get(s) is int
			}
			let otherwise = c.int("default_int64", -1)
			let out = zerosLike(ElementType.Int64, x.shape)
			inBands(n, n * 4, def (lo int, hi int) {
				for let i = lo; i < hi; i++ {
					let v = index.get(x.strings[i])
					out.ints[i] = v is int ?? (v, otherwise)
				}
			})
			c.out(0, out)
			return none
		}
		fail c.about() + "takes strings or int64, not {x.element.name}" unless storageOf(x.element) == Storage.Ints
		let index = new map<int, string>()
		for let (i, v) in ids {
			index.set(v, cats[i]) unless index.get(v) is string
		}
		let otherwise = c.text("default_string", "_Unused")
		let out = zerosLike(ElementType.String, x.shape)
		inBands(n, n * 4, def (lo int, hi int) {
			for let i = lo; i < hi; i++ {
				let s = index.get(x.ints[i])
				out.strings[i] = s is string ?? (s, otherwise)
			}
		})
		c.out(0, out)
		return none
	}

	// FeatureVectorizer: the inputs side by side as float, each cut or
	// padded with zeros to its inputdimensions entry; a vector is one row.
	// Fails when the inputs have different row counts.
	internal def featureVectorizer(c Call) !none {
		let dims = c.ints("inputdimensions", int[])
		let count = c.inputs.len()
		fail c.about() + "needs an input" when count == 0
		let (rows, _) = rowsOf(try c.tensor(0))
		let widths int[]
		let total = 0
		for let i = 0; i < count; i++ {
			let (r, per) = rowsOf(try c.tensor(i))
			fail c.about() + "input {i + 1} has {r} rows, input 1 {rows}" unless r == rows
			let w = i < dims.len() ?? (dims[i], per)
			fail c.about() + "inputdimensions holds a negative size" when w < 0
			widths.push(w)
			total += w
		}
		let sources float32[][]
		let pers int[]
		for let i = 0; i < count; i++ {
			let t = try c.tensor(i)
			let (_, per) = rowsOf(t)
			sources.push(try floats32(c, t))
			pers.push(per)
		}
		let out = zerosLike(ElementType.Float, int[rows, total])
		inBands(rows, rows * total, def (lo int, hi int) {
			for let r = lo; r < hi; r++ {
				let at = r * total
				for let i = 0; i < count; i++ {
					let m = widths[i].min(pers[i])
					let from = r * pers[i]
					sources[i][from:from + m].copy(out.floats[at:at + m]) when m > 0
					at += widths[i]
				}
			}
		})
		c.out(0, out)
		return none
	}

	// Imputer: values equal to the replaced value (NaN matching NaN) set
	// to the imputed value of their feature (the last axis), or to the
	// single imputed value.
	// Fails when the imputed values are missing or do not fit the
	// features.
	internal def imputer(c Call) !none {
		let x = try c.tensor(0)
		let cols = x.rank() == 0 ?? (1, x.shape[x.rank() - 1])
		let rows = cols == 0 ?? (0, x.count() / cols)
		let out = cloneTensor(x)
		match storageOf(x.element) {
			case Storage.Floats, Storage.Doubles:
				let with = c.floats("imputed_value_floats", float32[])
				fail c.about() + "imputed_value_floats is empty" when with.len() == 0
				fail c.about() + "imputed_value_floats has {with.len()} values for {cols} features" unless with.len() == 1 || with.len() == cols
				let what = c.float("replaced_value_float", float32(0))
				let wide float[]
				for let (_, v) in with {
					wide.push(float(v))
				}
				inBands(rows, rows * cols, def (lo int, hi int) {
					if x.element == ElementType.Double {
						imputeRows(out.doubles, cols, float(what), wide, lo, hi)
					} else {
						imputeRows(out.floats, cols, what, with, lo, hi)
					}
				})
			case Storage.Ints:
				let with = c.ints("imputed_value_int64s", int[])
				fail c.about() + "imputed_value_int64s is empty" when with.len() == 0
				fail c.about() + "imputed_value_int64s has {with.len()} values for {cols} features" unless with.len() == 1 || with.len() == cols
				let what = c.int("replaced_value_int64", 0)
				inBands(rows, rows * cols, def (lo int, hi int) {
					for let r = lo; r < hi; r++ {
						for let j = 0; j < cols; j++ {
							let i = r * cols + j
							out.ints[i] = with[with.len() == 1 ?? (0, j)] when out.ints[i] == what
						}
					}
				})
			default:
				fail c.about() + "takes numbers, not strings"
		}
		c.out(0, out)
		return none
	}

	internal def imputeRows<T: SimdFloat>(y T[], cols int, what T, with T[], lo int, hi int) {
		let nan = what != what
		for let r = lo; r < hi; r++ {
			let base = r * cols
			for let j = 0; j < cols; j++ {
				let v = y[base + j]
				y[base + j] = with[with.len() == 1 ?? (0, j)] when nan ?? (v != v, v == what)
			}
		}
	}

	// ----- LabelEncoder -----

	// LabelEncoder: each value replaced by the value its key maps to, the
	// default where no key matches. Version 1 maps strings to their index
	// in classes_strings and back.
	// Fails when the keys or values are missing or of another type than
	// the input.
	internal def labelEncoder(c Call) !none {
		let x = try c.tensor(0)
		return try labelEncoderV1(c, x) when c.opset < 2
		let keys = try encoderList(c, "keys")
		let values = try encoderList(c, "values")
		fail c.about() + "needs keys" unless keys is Tensor
		fail c.about() + "needs values" unless values is Tensor
		fail c.about() + "has {keys.count()} keys and {values.count()} values" unless keys.count() == values.count()
		let table = try withDefault(c, values)
		let at = try keyIndex(c, x, keys)
		let out = zerosLike(table.element, x.shape)
		let n = x.count()
		inBands(n, n, def (lo int, hi int) {
			match storageOf(table.element) {
				case Storage.Floats:
					gatherAt(table.floats, at, out.floats, lo, hi)
				case Storage.Doubles:
					gatherAt(table.doubles, at, out.doubles, lo, hi)
				case Storage.Ints:
					gatherAt(table.ints, at, out.ints, lo, hi)
				default:
					gatherAt(table.strings, at, out.strings, lo, hi)
			}
		})
		c.out(0, out)
		return none
	}

	internal def gatherAt<T>(table T[], at int[], out T[], lo int, hi int) {
		for let i = lo; i < hi; i++ {
			out[i] = table[at[i]]
		}
	}

	// LabelEncoder version 1: strings to their index in classes_strings
	// (default_int64 when absent), integers to the string at that index
	// (default_string when out of range).
	// Fails for another input type.
	internal def labelEncoderV1(c Call, x Tensor) !none {
		let classes = textsOf(c, "classes_strings")
		let n = x.count()
		if x.element == ElementType.String {
			let index = new map<string, int>()
			for let (i, s) in classes {
				index.set(s, i) unless index.get(s) is int
			}
			let otherwise = c.int("default_int64", -1)
			let out = zerosLike(ElementType.Int64, x.shape)
			inBands(n, n * 4, def (lo int, hi int) {
				for let i = lo; i < hi; i++ {
					let v = index.get(x.strings[i])
					out.ints[i] = v is int ?? (v, otherwise)
				}
			})
			c.out(0, out)
			return none
		}
		fail c.about() + "takes strings or int64, not {x.element.name}" unless storageOf(x.element) == Storage.Ints
		let otherwise = c.text("default_string", "_Unused")
		let out = zerosLike(ElementType.String, x.shape)
		inBands(n, n, def (lo int, hi int) {
			for let i = lo; i < hi; i++ {
				let v = x.ints[i]
				out.strings[i] = (v >= 0 && v < classes.len()) ?? (classes[v], otherwise)
			}
		})
		c.out(0, out)
		return none
	}

	// The keys or values of a LabelEncoder as a tensor: `<prefix>_tensor`,
	// `_strings`, `_int64s` or `_floats`, whichever the node has.
	// Fails when the tensor cannot be read.
	internal def encoderList(c Call, prefix string) !?Tensor {
		let t = try tensorAttr(c, prefix + "_tensor")
		return t when t is Tensor
		if c.attribute(prefix + "_strings") is Attribute {
			let s = textsOf(c, prefix + "_strings")
			return new Tensor(int[s.len()], s)
		}
		let a = c.attribute(prefix + "_int64s")
		return new Tensor(int[a.ints.len()], a.ints.clone()) when a is Attribute
		let f = c.attribute(prefix + "_floats")
		return new Tensor(int[f.floats.len()], f.floats.clone()) when f is Attribute
		return none
	}

	// `values` with the default value appended (as the last one): the
	// default_tensor's, else default_string, default_int64 or
	// default_float by the values' type.
	// Fails when default_tensor cannot be read.
	internal def withDefault(c Call, values Tensor) !Tensor {
		let n = values.count()
		let table = zerosLike(values.element, int[n + 1])
		for let i = 0; i < n; i++ {
			copyValue(values, i, table, i)
		}
		let d = try tensorAttr(c, "default_tensor")
		if d is Tensor && d.count() > 0 && storageOf(d.element) == storageOf(values.element) {
			copyValue(d, 0, table, n)
			return table
		}
		match storageOf(values.element) {
			case Storage.Strings:
				table.strings[n] = c.text("default_string", "_Unused")
			case Storage.Ints:
				table.ints[n] = c.int("default_int64", -1)
			case Storage.Floats:
				table.floats[n] = c.float("default_float", float32(-0.0))
			default:
				table.doubles[n] = float(c.float("default_float", float32(-0.0)))
		}
		return table
	}

	// Per value of `x` the index of the key it matches (the last of
	// repeated keys; NaN matches a NaN key), or `keys.count()`.
	// Fails when the keys are of another type than `x`.
	internal def keyIndex(c Call, x Tensor, keys Tensor) !int[] {
		let n = x.count()
		let missing = keys.count()
		let at int[]
		at.len(n)
		let ks = storageOf(keys.element)
		let xs = storageOf(x.element)
		if ks == Storage.Strings || xs == Storage.Strings {
			fail c.about() + "the keys are {keys.element.name}, the input {x.element.name}" unless ks == xs
			let index = new map<string, int>()
			for let (i, s) in keys.strings {
				index.set(s, i)
			}
			inBands(n, n * 4, def (lo int, hi int) {
				for let i = lo; i < hi; i++ {
					let k = index.get(x.strings[i])
					at[i] = k is int ?? (k, missing)
				}
			})
			return at
		}
		if ks == Storage.Ints && xs == Storage.Ints {
			let index = new map<int, int>()
			for let (i, v) in keys.ints {
				index.set(v, i)
			}
			inBands(n, n * 4, def (lo int, hi int) {
				for let i = lo; i < hi; i++ {
					let k = index.get(x.ints[i])
					at[i] = k is int ?? (k, missing)
				}
			})
			return at
		}
		fail c.about() + "the keys are {keys.element.name}, the input {x.element.name}" when ks == Storage.Ints || xs == Storage.Ints
		// Float keys by the bits of their float64 value, -0 as 0; NaN apart.
		let wanted = try doublesOf(c, keys)
		let values = try doublesOf(c, x)
		let index = new map<int, int>()
		let nanAt = missing
		for let (i, v) in wanted {
			if v != v {
				nanAt = i
			} else {
				index.set(int(__bitcast_u64_from_f64(v + 0.0)), i)
			}
		}
		inBands(n, n * 4, def (lo int, hi int) {
			for let i = lo; i < hi; i++ {
				let v = values[i]
				if v != v {
					at[i] = nanAt
				} else {
					let k = index.get(int(__bitcast_u64_from_f64(v + 0.0)))
					at[i] = k is int ?? (k, missing)
				}
			}
		})
		return at
	}

	// ----- Linear models -----

	// out (rows × k) = X (rows × f) · Wᵀ (W k × f) + bias (k values, or
	// none).
	internal def linearScores(xs float32[], rows int, f int, w float32[], k int, bias float32[], out float32[]) {
		if bias.len() == k {
			for let r = 0; r < rows; r++ {
				bias.copy(out[r * k:r * k + k])
			}
		}
		gemm(rows, k, f, float32(1), xs, 0, f, false, w, 0, f, true, bias.len() == k ?? (float32(1), float32(0)), out, 0, k)
	}

	// The first index of the greatest of the `n` values of z from `at`.
	internal def argmaxOf(z float32[], at int, n int) int {
		let best = 0
		for let j = 1; j < n; j++ {
			best = j when z[at + j] > z[at + best]
		}
		return best
	}

	// LinearClassifier: scores X · Wᵀ + intercepts per class and the class
	// of the greatest. One row of coefficients with two labels is a
	// binary model: the second class when the score is positive, scores
	// (1 − p, p).
	// Fails when the coefficients or intercepts do not fit the features.
	internal def linearClassifier(c Call) !none {
		let x = try c.tensor(0)
		let (rows, f) = rowsOf(x)
		let xs = try floats32(c, x)
		let w = c.floats("coefficients", float32[])
		fail c.about() + "{w.len()} coefficients do not fit {f} features" when f == 0 || w.len() == 0 || w.len() % f != 0
		let k = w.len() / f
		let bias = c.floats("intercepts", float32[])
		fail c.about() + "{bias.len()} intercepts for {k} classes" unless bias.len() == 0 || bias.len() == k
		let post = try postOf(c)
		let labels = labelsOf(c, "classlabels_ints")
		let z float32[]
		z.len(rows * k)
		linearScores(xs, rows, f, w, k, bias, z)
		let picks int[]
		picks.len(rows)
		if k == 1 && labelCount(labels) == 2 {
			let two = zerosLike(ElementType.Float, int[rows, 2])
			for let r = 0; r < rows; r++ {
				let s = float(z[r])
				picks[r] = s > 0.0 ?? (1, 0)
				let (a, b) = twoScores(s, post, false)
				two.floats[2 * r] = float32(a)
				two.floats[2 * r + 1] = float32(b)
			}
			c.out(0, labelTensor(labels, picks))
			c.out(1, two)
			return none
		}
		if k == 1 {
			// One class: its label where the score passes 0 (0.5 once
			// transformed), else none.
			let limit = post == Post.None ?? (0.0, 0.5)
			for let r = 0; r < rows; r++ {
				transformRow(z, r, 1, post)
				let pass = float(z[r]) >= limit
				picks[r] = labelCount(labels) == 0 ?? (pass ?? (1, 0), pass ?? (0, -1))
			}
		} else {
			for let r = 0; r < rows; r++ {
				picks[r] = argmaxOf(z, r * k, k)
			}
			transformScores(z, rows, k, post)
		}
		c.out(0, labelTensor(labels, picks))
		c.out(1, new Tensor(int[rows, k], z))
		return none
	}

	// LinearRegressor: X · Wᵀ + intercepts for each target, then the
	// post transform.
	// Fails when the coefficients or intercepts do not fit.
	internal def linearRegressor(c Call) !none {
		let x = try c.tensor(0)
		let (rows, f) = rowsOf(x)
		let xs = try floats32(c, x)
		let targets = c.int("targets", 1)
		let w = c.floats("coefficients", float32[])
		fail c.about() + "{w.len()} coefficients for {targets} targets of {f} features" unless targets > 0 && w.len() == targets * f
		let bias = c.floats("intercepts", float32[])
		fail c.about() + "{bias.len()} intercepts for {targets} targets" unless bias.len() == 0 || bias.len() == targets
		let post = try postOf(c)
		let z float32[]
		z.len(rows * targets)
		linearScores(xs, rows, f, w, targets, bias, z)
		transformScores(z, rows, targets, post)
		c.out(0, new Tensor(int[rows, targets], z))
		return none
	}

	// ----- Normalizer, OneHotEncoder, Scaler -----

	// Normalizer: each row divided by its maximum (MAX), the sum of its
	// absolute values (L1) or its Euclidean length (L2); a row whose
	// divisor is 0 stays as it is.
	// Fails for an unknown norm.
	internal def normalizer(c Call) !none {
		let x = try c.tensor(0)
		let norm = c.text("norm", "MAX")
		let kind = norm == "MAX" ?? (0, norm == "L1" ?? (1, norm == "L2" ?? (2, -1)))
		fail c.about() + "unknown norm {norm}" when kind < 0
		let (rows, cols) = rowsOf(x)
		let xs = try floats32(c, x)
		let out = zerosLike(ElementType.Float, x.shape)
		inBands(rows, rows * cols, def (lo int, hi int) {
			normalizeRows(xs, out.floats, cols, kind, lo, hi)
		})
		c.out(0, out)
		return none
	}

	internal def normalizeRows(x float32[], y float32[], n int, kind int, lo int, hi int) {
		let v vec8<float32>
		for let r = lo; r < hi; r++ {
			let base = r * n
			let i = 0
			let d = float32(0)
			if kind == 0 {
				d = n > 0 ?? (x[base], float32(0))
				if n >= 8 {
					let acc = v.load(x, base)
					for i = 8; i + 8 <= n; i += 8 {
						acc = simd.max(acc, v.load(x, base + i))
					}
					d = simd.maxLane(acc)
				}
				for; i < n; i++ {
					d = x[base + i] > d ?? (x[base + i], d)
				}
			} else {
				let acc = v.splat(float32(0))
				for; i + 8 <= n; i += 8 {
					let e = v.load(x, base + i)
					acc = acc + (kind == 1 ?? (simd.abs(e), e * e))
				}
				d = simd.sum(acc)
				for; i < n; i++ {
					let e = x[base + i]
					d += kind == 1 ?? (e.abs(), e * e)
				}
				d = float32(math.sqrt(float(d))) when kind == 2
			}
			if d == float32(0) {
				x[base:base + n].copy(y[base:base + n])
				continue
			}
			let scale = v.splat(float32(1) / d)
			i = 0
			for; i + 8 <= n; i += 8 {
				(v.load(x, base + i) * scale).store(y, base + i)
			}
			for; i < n; i++ {
				y[base + i] = x[base + i] / d
			}
		}
	}

	// OneHotEncoder: a last axis of the category count, 1 at the input's
	// category (numbers truncated to integers); all 0 for a value that is
	// no category unless `zeros` is 0.
	// Fails for a value that is no category when zeros is 0.
	internal def oneHotEncoder(c Call) !none {
		let x = try c.tensor(0)
		let zeros = c.int("zeros", 1) != 0
		let n = x.count()
		let at int[]
		at.len(n)
		let k = 0
		if x.element == ElementType.String {
			let cats = textsOf(c, "cats_strings")
			k = cats.len()
			let index = new map<string, int>()
			for let (i, s) in cats {
				index.set(s, i) unless index.get(s) is int
			}
			inBands(n, n * 4, def (lo int, hi int) {
				for let i = lo; i < hi; i++ {
					let j = index.get(x.strings[i])
					at[i] = j is int ?? (j, -1)
				}
			})
		} else {
			let cats = c.ints("cats_int64s", int[])
			k = cats.len()
			let index = new map<int, int>()
			for let (i, v) in cats {
				index.set(v, i) unless index.get(v) is int
			}
			let ints = storageOf(x.element) == Storage.Ints
			let values float[]
			values = try doublesOf(c, x) unless ints
			inBands(n, n * 4, def (lo int, hi int) {
				for let i = lo; i < hi; i++ {
					at[i] = -1
					if ints {
						let j = index.get(x.ints[i])
						at[i] = j is int ?? (j, -1)
					} else if values[i] == values[i] {
						let j = index.get(truncated(values[i]))
						at[i] = j is int ?? (j, -1)
					}
				}
			})
		}
		fail c.about() + "needs cats_int64s or cats_strings" when k == 0
		let shape = x.shape.clone()
		shape.push(k)
		if !zeros {
			for let i = 0; i < n; i++ {
				fail c.about() + "value {i} is not one of the categories" when at[i] < 0
			}
		}
		let out = zerosLike(ElementType.Float, shape)
		inBands(n, n * k, def (lo int, hi int) {
			for let i = lo; i < hi; i++ {
				out.floats[i * k + at[i]] = float32(1) when at[i] >= 0
			}
		})
		c.out(0, out)
		return none
	}

	// Scaler: (x − offset) · scale per feature (the last axis), as float.
	// Fails when offset or scale is neither one value nor one per feature.
	internal def scaler(c Call) !none {
		let x = try c.tensor(0)
		let cols = x.rank() == 0 ?? (1, x.shape[x.rank() - 1])
		let rows = cols == 0 ?? (0, x.count() / cols)
		let offset = try perFeature(c, c.floats("offset", float32[]), cols, float32(0), "offset")
		let scale = try perFeature(c, c.floats("scale", float32[]), cols, float32(1), "scale")
		let xs = try floats32(c, x)
		let out = zerosLike(ElementType.Float, x.shape)
		inBands(rows, rows * cols, def (lo int, hi int) {
			scaleRows(xs, out.floats, cols, offset, scale, lo, hi)
		})
		c.out(0, out)
		return none
	}

	// `values` as one per feature: one repeated, none as `otherwise`.
	// Fails for another count.
	internal def perFeature(c Call, values float32[], cols int, otherwise float32, name string) !float32[] {
		return values when values.len() == cols
		fail c.about() + "{name} has {values.len()} values for {cols} features" when values.len() > 1
		let out float32[]
		out.len(cols)
		let v = values.len() == 1 ?? (values[0], otherwise)
		for let i = 0; i < cols; i++ {
			out[i] = v
		}
		return out
	}

	internal def scaleRows(x float32[], y float32[], n int, offset float32[], scale float32[], lo int, hi int) {
		let v vec8<float32>
		for let r = lo; r < hi; r++ {
			let base = r * n
			let i = 0
			for; i + 8 <= n; i += 8 {
				((v.load(x, base + i) - v.load(offset, i)) * v.load(scale, i)).store(y, base + i)
			}
			for; i < n; i++ {
				y[base + i] = (x[base + i] - offset[i]) * scale[i]
			}
		}
	}

	// ----- Support vector machines -----

	// A kernel: 0 LINEAR (x·y), 1 POLY ((γ·x·y + c)^d), 2 RBF
	// (e^(−γ·|x − y|²)), 3 SIGMOID (tanh(γ·x·y + c)).
	internal struct Kernel {
		kind   int
		gamma  float32
		coef0  float32
		degree int
	}

	// The kernel_type and kernel_params of an SVM node.
	// Fails for an unknown kernel.
	internal def kernelOf(c Call) !Kernel {
		let name = c.text("kernel_type", "LINEAR")
		let kind = name == "LINEAR" ?? (0, name == "POLY" ?? (1, name == "RBF" ?? (2, name == "SIGMOID" ?? (3, -1))))
		fail c.about() + "unknown kernel_type {name}" when kind < 0
		let p = c.floats("kernel_params", float32[])
		return Kernel{kind: kind, gamma: p.len() > 0 ?? (p[0], float32(0)), coef0: p.len() > 1 ?? (p[1], float32(0)), degree: p.len() > 2 ?? (int(p[2]), 0)}
	}

	// The kernel of every row of X (rows × f) with every support vector
	// (v × f): rows × v, the dot products through gemm; RBF from the
	// differences themselves, eight support vectors at a time.
	internal def kernelMatrix(xs float32[], rows int, f int, sv float32[], v int, k Kernel) float32[] {
		let out float32[]
		out.len(rows * v)
		if k.kind == 2 {
			let svT float32[]
			svT.len(f * v)
			for let j = 0; j < v; j++ {
				for let d = 0; d < f; d++ {
					svT[d * v + j] = sv[j * f + d]
				}
			}
			inBands(rows, rows * v * f, def (lo int, hi int) {
				rbfRows(xs, f, svT, v, k.gamma, out, lo, hi)
			})
			return out
		}
		gemm(rows, v, f, float32(1), xs, 0, f, false, sv, 0, f, true, float32(0), out, 0, v)
		return out when k.kind == 0
		inBands(rows, rows * v * 8, def (lo int, hi int) {
			kernelRows(out, v, k, lo, hi)
		})
		return out
	}

	// Rows lo to hi of e^(−γ·|x − s|²) for the support vectors `svT`
	// (stored f × v).
	internal def rbfRows(xs float32[], f int, svT float32[], v int, gamma float32, out float32[], lo int, hi int) {
		let w vec8<float32>
		let g = w.splat(-gamma)
		for let r = lo; r < hi; r++ {
			let xb = r * f
			let ob = r * v
			let j = 0
			for; j + 8 <= v; j += 8 {
				let acc = w.splat(float32(0))
				for let d = 0; d < f; d++ {
					let e = w.splat(xs[xb + d]) - w.load(svT, d * v + j)
					acc = acc + e * e
				}
				simd.exp(acc * g).store(out, ob + j)
			}
			for; j < v; j++ {
				let acc = float32(0)
				for let d = 0; d < f; d++ {
					let e = xs[xb + d] - svT[d * v + j]
					acc += e * e
				}
				out[ob + j] = float32(math.E ** float(-gamma * acc))
			}
		}
	}

	// Rows lo to hi of the dot products `k` (v per row) turned into the
	// POLY or SIGMOID kernel's values.
	internal def kernelRows(k float32[], v int, kern Kernel, lo int, hi int) {
		let w vec8<float32>
		let gamma = w.splat(kern.gamma)
		let coef0 = w.splat(kern.coef0)
		for let r = lo; r < hi; r++ {
			let base = r * v
			let j = 0
			if kern.kind == 1 {
				for; j + 8 <= v; j += 8 {
					let s = w.load(k, base + j) * gamma + coef0
					let p = w.splat(float32(1))
					for let d = 0; d < kern.degree; d++ {
						p = p * s
					}
					p.store(k, base + j)
				}
			} else {
				for; j + 8 <= v; j += 8 {
					simd.tanh(w.load(k, base + j) * gamma + coef0).store(k, base + j)
				}
			}
			for; j < v; j++ {
				let s = float(kern.gamma) * float(k[base + j]) + float(kern.coef0)
				if kern.kind == 1 {
					let p = 1.0
					for let e = 0; e < kern.degree; e++ {
						p *= s
					}
					k[base + j] = float32(p)
				} else {
					k[base + j] = float32(math.tanh(s))
				}
			}
		}
	}

	// SVMRegressor: Σ coefficient · kernel(x, support vector) + rho over
	// the n_supports support vectors, or x · coefficients + rho without
	// them; ±1 by sign for a one-class SVM; PROBIT applies.
	// Fails when the attributes do not fit the features.
	internal def svmRegressor(c Call) !none {
		let x = try c.tensor(0)
		let (rows, f) = rowsOf(x)
		let xs = try floats32(c, x)
		let kern = try kernelOf(c)
		let supports = c.int("n_supports", 0)
		let w = c.floats("coefficients", float32[])
		let rho = c.floats("rho", float32[])
		let shift = rho.len() > 0 ?? (rho[0], float32(0))
		let z float32[]
		z.len(rows)
		if supports > 0 {
			let sv = c.floats("support_vectors", float32[])
			fail c.about() + "{sv.len()} support vector values for {supports} vectors of {f} features" unless sv.len() == supports * f
			fail c.about() + "{w.len()} coefficients for {supports} support vectors" unless w.len() == supports
			let k = kernelMatrix(xs, rows, f, sv, supports, kern)
			for let r = 0; r < rows; r++ {
				z[r] = shift
			}
			gemm(rows, 1, supports, float32(1), k, 0, supports, false, w, 0, 1, false, float32(1), z, 0, 1)
		} else {
			fail c.about() + "{w.len()} coefficients for {f} features" unless w.len() == f
			linearScores(xs, rows, f, w, 1, float32[shift], z)
		}
		if c.int("one_class", 0) != 0 {
			for let r = 0; r < rows; r++ {
				z[r] = z[r] > float32(0) ?? (float32(1), float32(-1))
			}
		}
		transformScores(z, rows, 1, try postOf(c))
		c.out(0, new Tensor(int[rows, 1], z))
		return none
	}

	// SVMClassifier. With support vectors (vectors_per_class) each pair of
	// classes i < j scores rho + the kernels of both classes' vectors
	// weighted by their coefficients and votes for i when positive; the
	// class with the most votes wins, the scores are the pairs' (or, with
	// prob_a and prob_b, the classes' probabilities, coupled as libsvm
	// does). Without support vectors each class scores x · its
	// coefficients + rho and the greatest wins.
	// Fails when the attributes do not fit.
	internal def svmClassifier(c Call) !none {
		let x = try c.tensor(0)
		let (rows, f) = rowsOf(x)
		let xs = try floats32(c, x)
		let kern = try kernelOf(c)
		let labels = labelsOf(c, "classlabels_ints")
		let classes = labelCount(labels).max(1)
		let perClass = c.ints("vectors_per_class", int[])
		let w = c.floats("coefficients", float32[])
		let rho = c.floats("rho", float32[])
		let post = try postOf(c)
		let vectors = 0
		for let (_, n) in perClass {
			vectors += n
		}
		let picks int[]
		picks.len(rows)
		if vectors == 0 {
			fail c.about() + "{w.len()} coefficients for {classes} classes of {f} features" unless w.len() == classes * f
			let z float32[]
			z.len(rows * classes)
			let bias float32[]
			bias.len(classes)
			let shift = rho.len() > 0 ?? (rho[0], float32(0))
			for let i = 0; i < classes; i++ {
				bias[i] = shift
			}
			linearScores(xs, rows, f, w, classes, bias, z)
			let positive = true
			for let (_, v) in w {
				positive = false when v < float32(0)
			}
			// Two labels and one rho: the second class when the greatest
			// score passes 0.5 (weights all positive) or 0.
			let binary = labelCount(labels) == 2 && rho.len() == 1
			for let r = 0; r < rows; r++ {
				let best = argmaxOf(z, r * classes, classes)
				let top = z[r * classes + best]
				best = 1 when binary && ((positive && top >= float32(0.5)) || (!positive && top > float32(0)))
				picks[r] = best
			}
			transformScores(z, rows, classes, post)
			c.out(0, labelTensor(labels, picks))
			c.out(1, new Tensor(int[rows, classes], z))
			return none
		}
		fail c.about() + "vectors_per_class has {perClass.len()} classes, the labels {classes}" unless perClass.len() == classes
		let sv = c.floats("support_vectors", float32[])
		fail c.about() + "{sv.len()} support vector values for {vectors} vectors of {f} features" unless sv.len() == vectors * f
		fail c.about() + "{w.len()} coefficients for {vectors} support vectors of {classes} classes" unless w.len() == (classes - 1) * vectors
		let pairs = classes * (classes - 1) / 2
		fail c.about() + "rho has {rho.len()} values for {pairs} class pairs" when rho.len() < pairs
		let probA = c.floats("prob_a", float32[])
		let probB = c.floats("prob_b", float32[])
		let withProb = probA.len() > 0
		fail c.about() + "prob_a and prob_b need {pairs} values" when withProb && (probA.len() < pairs || probB.len() < pairs)
		let starts int[]
		let at = 0
		for let (_, n) in perClass {
			starts.push(at)
			at += n
		}
		let k = kernelMatrix(xs, rows, f, sv, vectors, kern)
		let width = withProb ?? (classes, pairs)
		let z float32[]
		z.len(rows * width)
		inBands(rows, rows * vectors * classes, def (lo int, hi int) {
			svmPairRows(k, vectors, classes, perClass, starts, w, rho, withProb, probA, probB, z, picks, lo, hi)
		})
		if width == 1 {
			// Binary without probabilities: one score, written for both
			// classes.
			let two = zerosLike(ElementType.Float, int[rows, 2])
			for let r = 0; r < rows; r++ {
				let (a, b) = twoScores(float(z[r]), post, post == Post.None)
				two.floats[2 * r] = float32(a)
				two.floats[2 * r + 1] = float32(b)
			}
			c.out(0, labelTensor(labels, picks))
			c.out(1, two)
			return none
		}
		transformScores(z, rows, width, post)
		c.out(0, labelTensor(labels, picks))
		c.out(1, new Tensor(int[rows, width], z))
		return none
	}

	// Rows lo to hi of an SVM classifier with support vectors: the pair
	// scores (or class probabilities) into z and the winning class into
	// picks.
	internal def svmPairRows(k float32[], vectors int, classes int, perClass int[], starts int[], w float32[], rho float32[], withProb bool, probA float32[], probB float32[], z float32[], picks int[], lo int, hi int) {
		let pairs = classes * (classes - 1) / 2
		let votes int[]
		votes.len(classes)
		let scores float32[]
		scores.len(pairs)
		let pairProb float32[]
		let p float32[]
		if withProb {
			pairProb.len(classes * classes)
			p.len(classes)
		}
		for let r = lo; r < hi; r++ {
			let kr = r * vectors
			for let i = 0; i < classes; i++ {
				votes[i] = 0
			}
			let e = 0
			for let i = 0; i < classes; i++ {
				for let j = i + 1; j < classes; j++ {
					let s = rho[e]
					let wi = (j - 1) * vectors + starts[i]
					for let t = 0; t < perClass[i]; t++ {
						s += w[wi + t] * k[kr + starts[i] + t]
					}
					let wj = i * vectors + starts[j]
					for let t = 0; t < perClass[j]; t++ {
						s += w[wj + t] * k[kr + starts[j] + t]
					}
					scores[e] = s
					if s > float32(0) {
						votes[i]++
					} else {
						votes[j]++
					}
					e++
				}
			}
			let best = 0
			for let i = 1; i < classes; i++ {
				best = i when votes[i] > votes[best]
			}
			picks[r] = best
			if withProb {
				e = 0
				for let i = 0; i < classes; i++ {
					for let j = i + 1; j < classes; j++ {
						let v = float32(1) - float32(logistic(float(scores[e] * probA[e] + probB[e])))
						v = v.max(float32(0.0000001)).min(float32(1) - float32(0.0000001))
						pairProb[i * classes + j] = v
						pairProb[j * classes + i] = float32(1) - v
						e++
					}
				}
				coupled(pairProb, classes, p)
				p.copy(z[r * classes:r * classes + classes])
			} else {
				scores.copy(z[r * pairs:r * pairs + pairs])
			}
		}
	}

	// The class probabilities `p` (k values) from the pairwise ones `r`
	// (k × k), by libsvm's second method of Wu, Lin and Weng.
	internal def coupled(r float32[], k int, p float32[]) {
		let q float32[]
		q.len(k * k)
		let qp float32[]
		qp.len(k)
		for let t = 0; t < k; t++ {
			p[t] = float32(1) / float32(k)
			q[t * k + t] = float32(0)
			for let j = 0; j < t; j++ {
				q[t * k + t] += r[j * k + t] * r[j * k + t]
				q[t * k + j] = q[j * k + t]
			}
			for let j = t + 1; j < k; j++ {
				q[t * k + t] += r[j * k + t] * r[j * k + t]
				q[t * k + j] = -r[j * k + t] * r[t * k + j]
			}
		}
		let rounds = k.max(100)
		let eps = float32(0.005) / float32(k)
		for let it = 0; it < rounds; it++ {
			let pqp = float32(0)
			for let t = 0; t < k; t++ {
				let s = float32(0)
				for let j = 0; j < k; j++ {
					s += q[t * k + j] * p[j]
				}
				qp[t] = s
				pqp += p[t] * s
			}
			let worst = float32(0)
			for let t = 0; t < k; t++ {
				worst = (qp[t] - pqp).abs().max(worst)
			}
			break when worst < eps
			for let t = 0; t < k; t++ {
				let diff = (-qp[t] + pqp) / q[t * k + t]
				p[t] += diff
				pqp = (pqp + diff * (diff * q[t * k + t] + float32(2) * qp[t])) / (float32(1) + diff) / (float32(1) + diff)
				for let j = 0; j < k; j++ {
					qp[j] = (qp[j] + diff * q[t * k + j]) / (float32(1) + diff)
					p[j] /= float32(1) + diff
				}
			}
		}
	}

	// ----- Tree ensembles -----

	// Trees in flat arrays: per node its feature, threshold (as float64 and
	// float32), comparison (0 ≤, 1 <, 2 ≥, 3 >, 4 =, 5 ≠, 6 member of the
	// node's set, −1 a leaf), the next node when it holds (`yes`) and when
	// not (`no`), −1 − leaf for a leaf, and whether NaN takes `yes`; per
	// tree its root; per leaf its votes (output, weight).
	internal type Forest {
		feature   int[]
		th        float[]
		th32      float32[]
		mode      int[]
		yes       int[]
		no        int[]
		missing   bool[]
		memberLo  int[]
		memberHi  int[]
		members   float[]
		members32 float32[]
		roots     int[]
		voteLo    int[]
		voteHi    int[]
		voteTo    int[]
		voteW     float[]
		outputs   int

		def new() {}
	}

	// How the trees' votes for an output combine: their sum, mean, least
	// or greatest.
	internal enum Aggregate {
		Sum,
		Average,
		Min,
		Max,
	}

	// The comparison a nodes_modes name stands for, -1 for LEAF.
	// Fails for an unknown name.
	internal def modeOf(c Call, name string) !int {
		match name {
			case "BRANCH_LEQ":
				return 0
			case "BRANCH_LT":
				return 1
			case "BRANCH_GTE":
				return 2
			case "BRANCH_GT":
				return 3
			case "BRANCH_EQ":
				return 4
			case "BRANCH_NEQ":
				return 5
			case "LEAF":
				return -1
			default:
				fail c.about() + "unknown node mode {name}"
		}
	}

	// The trees of a TreeEnsembleRegressor or TreeEnsembleClassifier
	// (nodes by tree and node id, votes `<votes>_treeids`, `_nodeids`,
	// `_ids` and `_weights`) for `outputs` outputs. A tree's root is its
	// node 0 (its first node when it has no node 0).
	// Fails when the lists differ in length or name nodes that are not
	// there.
	internal def oldForest(c Call, votes string, outputs int) !Forest {
		let trees = c.ints("nodes_treeids", int[])
		let ids = c.ints("nodes_nodeids", int[])
		let features = c.ints("nodes_featureids", int[])
		let modes = textsOf(c, "nodes_modes")
		let values = try numbersOf(c, "nodes_values")
		let yes = c.ints("nodes_truenodeids", int[])
		let no = c.ints("nodes_falsenodeids", int[])
		let missing = c.ints("nodes_missing_value_tracks_true", int[])
		let n = trees.len()
		fail c.about() + "the nodes_* lists differ in length" unless ids.len() == n && modes.len() == n
		let f = new Forest()
		f.outputs = outputs
		let at = new map<int, int>()
		let leafOf int[]
		leafOf.len(n)
		let leaves = 0
		for let i = 0; i < n; i++ {
			at.set((trees[i] << 32) | ids[i], i)
			let m = try modeOf(c, modes[i])
			f.mode.push(m)
			if m < 0 {
				leafOf[i] = leaves
				leaves++
			} else {
				leafOf[i] = -1
			}
		}
		let rootOf = new map<int, int>()
		let order int[]
		for let i = 0; i < n; i++ {
			let first = rootOf.get(trees[i])
			if first is int {
				rootOf.set(trees[i], i) when ids[i] == 0 && ids[first] != 0
			} else {
				rootOf.set(trees[i], i)
				order.push(trees[i])
			}
			let interior = f.mode[i] >= 0
			fail c.about() + "the nodes_* lists of interior nodes differ in length" when interior && (i >= features.len() || i >= yes.len() || i >= no.len())
			let v = i < values.len() ?? (values[i], 0.0)
			f.feature.push(interior ?? (features[i], 0))
			f.th.push(v)
			f.th32.push(float32(v))
			f.missing.push(i < missing.len() && missing[i] != 0)
			f.memberLo.push(0)
			f.memberHi.push(0)
			if interior {
				f.yes.push(try nextOf(c, at, leafOf, trees[i], yes[i]))
				f.no.push(try nextOf(c, at, leafOf, trees[i], no[i]))
			} else {
				f.yes.push(0)
				f.no.push(0)
			}
		}
		for let (_, tree) in order {
			let r = rootOf.get(tree)
			f.roots.push(leafOf[r] >= 0 ?? (-1 - leafOf[r], r)) when r is int
		}
		// Votes grouped by leaf.
		let vTrees = c.ints(votes + "_treeids", int[])
		let vNodes = c.ints(votes + "_nodeids", int[])
		let vIds = c.ints(votes + "_ids", int[])
		let vWeights = try numbersOf(c, votes + "_weights")
		let m = vTrees.len()
		fail c.about() + "the {votes}_* lists differ in length" unless vNodes.len() == m && vIds.len() == m && vWeights.len() == m
		let leafVote int[]
		leafVote.len(m)
		let counts int[]
		counts.len(leaves + 1)
		for let i = 0; i < m; i++ {
			let node = at.get((vTrees[i] << 32) | vNodes[i])
			fail c.about() + "a vote names node {vNodes[i]} of tree {vTrees[i]}, which is not there" unless node is int
			fail c.about() + "a vote names node {vNodes[i]} of tree {vTrees[i]}, which is not a leaf" unless leafOf[node] >= 0
			fail c.about() + "a vote is for output {vIds[i]} of {outputs}" unless vIds[i] >= 0 && vIds[i] < outputs
			leafVote[i] = leafOf[node]
			counts[leafOf[node] + 1]++
		}
		groupVotes(f, leaves, counts, leafVote, vIds, vWeights)
		return f
	}

	// Sets the votes of `f`: vote i, of leaf leafVote[i], for output to[i]
	// with weight w[i]; counts[l + 1] votes for leaf l.
	internal def groupVotes(f Forest, leaves int, counts int[], leafVote int[], to int[], w float[]) {
		for let l = 0; l < leaves; l++ {
			counts[l + 1] += counts[l]
		}
		f.voteLo = counts[0:leaves].clone()
		f.voteHi = counts[1:leaves + 1].clone()
		let fill = counts[0:leaves].clone()
		f.voteTo.len(leafVote.len())
		f.voteW.len(leafVote.len())
		for let (i, l) in leafVote {
			f.voteTo[fill[l]] = to[i]
			f.voteW[fill[l]] = w[i]
			fill[l]++
		}
	}

	// The next of a node: the position of node `id` of `tree`, −1 − leaf
	// for a leaf.
	// Fails when there is no such node.
	internal def nextOf(c Call, at map<int, int>, leafOf int[], tree int, id int) !int {
		let i = at.get((tree << 32) | id)
		fail c.about() + "tree {tree} has no node {id}" unless i is int
		return leafOf[i] >= 0 ?? (-1 - leafOf[i], i)
	}

	// The trees of a TreeEnsemble (ai.onnx.ml 5): interior nodes by
	// position, branches to nodes or (`*leafs`) leaves, a vote per leaf.
	// Fails when the lists differ in length or point outside them.
	internal def newForest(c Call) !Forest {
		let features = c.ints("nodes_featureids", int[])
		let n = features.len()
		let modes = try tensorAttr(c, "nodes_modes")
		let splits = try tensorAttr(c, "nodes_splits")
		let yes = c.ints("nodes_truenodeids", int[])
		let yesLeaf = c.ints("nodes_trueleafs", int[])
		let no = c.ints("nodes_falsenodeids", int[])
		let noLeaf = c.ints("nodes_falseleafs", int[])
		let missing = c.ints("nodes_missing_value_tracks_true", int[])
		let targets = c.ints("leaf_targetids", int[])
		let weights = try tensorAttr(c, "leaf_weights")
		let memberSet = try tensorAttr(c, "membership_values")
		fail c.about() + "needs nodes_modes" unless modes is Tensor
		fail c.about() + "needs nodes_splits" unless splits is Tensor
		fail c.about() + "needs leaf_weights" unless weights is Tensor
		let modeValues = intValues(modes)
		let th = try doublesOf(c, splits)
		fail c.about() + "the nodes_* lists differ in length" unless modeValues.len() == n && th.len() == n && yes.len() == n && yesLeaf.len() == n && no.len() == n && noLeaf.len() == n
		let leaves = targets.len()
		let w = try doublesOf(c, weights)
		fail c.about() + "leaf_targetids has {leaves} values, leaf_weights {w.len()}" unless w.len() == leaves
		let outputs = c.int("n_targets", 1)
		let f = new Forest()
		f.outputs = outputs
		let members float[]
		members = try doublesOf(c, memberSet) when memberSet is Tensor
		let next = 0
		for let i = 0; i < n; i++ {
			let m = modeValues[i]
			fail c.about() + "unknown node mode {m}" unless m >= 0 && m <= 6
			f.mode.push(m)
			f.feature.push(features[i])
			f.th.push(th[i])
			f.th32.push(float32(th[i]))
			f.missing.push(i < missing.len() && missing[i] != 0)
			f.yes.push(try branchOf(c, yes[i], yesLeaf[i] != 0, n, leaves))
			f.no.push(try branchOf(c, no[i], noLeaf[i] != 0, n, leaves))
			let lo = next
			if m == 6 {
				fail c.about() + "membership_values has no set for node {i}" when next >= members.len()
				for; next < members.len() && members[next] == members[next]; next++ {}
			}
			f.memberLo.push(lo)
			f.memberHi.push(m == 6 ?? (next, lo))
			next++ when m == 6
		}
		for let (_, v) in members {
			f.members.push(v)
			f.members32.push(float32(v))
		}
		for let (_, r) in c.ints("tree_roots", int[]) {
			fail c.about() + "tree root {r} is not a node" unless r >= 0 && r < n
			f.roots.push(r)
		}
		let counts int[]
		counts.len(leaves + 1)
		let leafVote int[]
		for let i = 0; i < leaves; i++ {
			fail c.about() + "leaf {i} is for target {targets[i]} of {outputs}" unless targets[i] >= 0 && targets[i] < outputs
			leafVote.push(i)
			counts[i + 1] = 1
		}
		groupVotes(f, leaves, counts, leafVote, targets, w)
		return f
	}

	// A branch of a TreeEnsemble node: node `id`, or −1 − id for leaf id.
	// Fails when it is out of range.
	internal def branchOf(c Call, id int, leaf bool, nodes int, leaves int) !int {
		if leaf {
			fail c.about() + "leaf {id} is not there" unless id >= 0 && id < leaves
			return -1 - id
		}
		fail c.about() + "node {id} is not there" unless id >= 0 && id < nodes
		return id
	}

	// The trees' scores for every row: per row and output the combined
	// votes and whether any vote reached it.
	internal struct Votes {
		scores float[]
		voted  bool[]
	}

	// Runs the trees of `f` on X ([N, F]); compares in float64 for double
	// input, else in float32 as the input's values are.
	// Fails when a node reads a feature X does not have.
	internal def runForest(c Call, f Forest, x Tensor, how Aggregate) !Votes {
		let (rows, cols) = rowsOf(x)
		for let (i, feature) in f.feature {
			fail c.about() + "node {i} reads feature {feature} of {cols}" unless f.mode[i] < 0 || (feature >= 0 && feature < cols)
		}
		let out = Votes{scores: float[], voted: bool[]}
		out.scores.len(rows * f.outputs)
		out.voted.len(rows * f.outputs)
		let work = rows * f.roots.len() * 8
		if x.element == ElementType.Double {
			inBands(rows, work, def (lo int, hi int) {
				forestRows(f, f.th, f.members, x.doubles, cols, how, out, lo, hi)
			})
		} else {
			let xs = try floats32(c, x)
			inBands(rows, work, def (lo int, hi int) {
				forestRows(f, f.th32, f.members32, xs, cols, how, out, lo, hi)
			})
		}
		return out
	}

	// Rows lo to hi through every tree, the leaves' votes combined. A
	// comparison with NaN fails, so NaN takes `no` unless the node says
	// it tracks `yes` (≠ holds for NaN).
	internal def forestRows<T: SimdFloat>(f Forest, th T[], members T[], x T[], cols int, how Aggregate, out Votes, lo int, hi int) {
		let outputs = f.outputs
		for let r = lo; r < hi; r++ {
			let base = r * cols
			let sb = r * outputs
			for let (_, root) in f.roots {
				let n = root
				for n >= 0 {
					let v = x[base + f.feature[n]]
					let t = th[n]
					let go = false
					match f.mode[n] {
						case 0:
							go = v <= t
						case 1:
							go = v < t
						case 2:
							go = v >= t
						case 3:
							go = v > t
						case 4:
							go = v == t
						case 5:
							go = v != t
						default:
							for let m = f.memberLo[n]; m < f.memberHi[n]; m++ {
								if v == members[m] {
									go = true
									break
								}
							}
					}
					go = go || (f.missing[n] && v != v)
					n = go ?? (f.yes[n], f.no[n])
				}
				let leaf = -1 - n
				for let i = f.voteLo[leaf]; i < f.voteHi[leaf]; i++ {
					let at = sb + f.voteTo[i]
					let w = f.voteW[i]
					if !out.voted[at] {
						out.voted[at] = true
						out.scores[at] = w
						continue
					}
					match how {
						case Aggregate.Min:
							out.scores[at] = out.scores[at].min(w)
						case Aggregate.Max:
							out.scores[at] = out.scores[at].max(w)
						default:
							out.scores[at] += w
					}
				}
			}
		}
	}

	// The aggregate_function of the older ensembles (text).
	// Fails for an unknown name.
	internal def aggregateOf(c Call) !Aggregate {
		let name = c.text("aggregate_function", "SUM")
		match name {
			case "SUM":
				return Aggregate.Sum
			case "AVERAGE":
				return Aggregate.Average
			case "MIN":
				return Aggregate.Min
			case "MAX":
				return Aggregate.Max
			default:
				fail c.about() + "unknown aggregate_function {name}"
		}
	}

	// The regression of `v` into `z`: per output the combined votes (0
	// where none came, the sum divided by the tree count for AVERAGE) plus
	// its base value.
	internal def regression<T: SimdFloat>(v Votes, trees int, how Aggregate, base float[], z T[]) {
		let outputs = base.len()
		let n = v.scores.len()
		for let i = 0; i < n; i++ {
			let s = v.voted[i] ?? (v.scores[i], 0.0)
			s /= float(trees) when how == Aggregate.Average && trees > 0
			z[i] = T(s + (outputs > 0 ?? (base[i % outputs], 0.0)))
		}
	}

	// TreeEnsembleRegressor: per target the leaves' weights combined over
	// the trees, plus base_values, then the post transform; float output.
	// Fails when the attributes do not describe trees.
	internal def treeRegressor(c Call) !none {
		let x = try c.tensor(0)
		let outputs = c.int("n_targets", 1)
		let f = try oldForest(c, "target", outputs)
		let how = try aggregateOf(c)
		let post = try postOf(c)
		let base = try numbersOf(c, "base_values")
		fail c.about() + "base_values has {base.len()} values for {outputs} targets" unless base.len() == 0 || base.len() == outputs
		let (rows, _) = rowsOf(x)
		let v = try runForest(c, f, x, how)
		let z float32[]
		z.len(rows * outputs)
		regression(v, f.roots.len(), how, base, z)
		transformScores(z, rows, outputs, post)
		c.out(0, new Tensor(int[rows, outputs], z))
		return none
	}

	// TreeEnsemble (ai.onnx.ml 5): TreeEnsembleRegressor's sum, mean, least
	// or greatest per target in the input's floating-point type.
	// Fails when the attributes do not describe trees.
	internal def treeEnsemble(c Call) !none {
		let x = try c.tensor(0)
		fail c.about() + "takes float, double or float16, not {x.element.name}" unless storageOf(x.element) := Storage.Floats || Storage.Doubles
		let f = try newForest(c)
		let code = c.int("aggregate_function", 1)
		fail c.about() + "unknown aggregate_function {code}" unless code >= 0 && code <= 3
		let how = code == 0 ?? (Aggregate.Average, code == 1 ?? (Aggregate.Sum, code == 2 ?? (Aggregate.Min, Aggregate.Max)))
		let p = c.int("post_transform", 0)
		fail c.about() + "unknown post_transform {p}" unless p >= 0 && p <= 4
		let post = p == 0 ?? (Post.None, p == 1 ?? (Post.Softmax, p == 2 ?? (Post.Logistic, p == 3 ?? (Post.SoftmaxZero, Post.Probit))))
		let (rows, _) = rowsOf(x)
		let v = try runForest(c, f, x, how)
		let out = zerosLike(x.element, int[rows, f.outputs])
		let base float[]
		base.len(f.outputs)
		if x.element == ElementType.Double {
			regression(v, f.roots.len(), how, base, out.doubles)
			transformScores(out.doubles, rows, f.outputs, post)
		} else {
			regression(v, f.roots.len(), how, base, out.floats)
			transformScores(out.floats, rows, f.outputs, post)
			roundTo(out)
		}
		c.out(0, out)
		return none
	}

	// TreeEnsembleClassifier: per class the leaves' weights summed over the
	// trees (plus base_values) and the class of the greatest score among
	// those that got one. With two labels the second class wins when its
	// score (the first class's when the second got none) passes 0.5
	// (weights all positive, all for one class) or 0; a lone first score is written for both
	// classes. Classes without a score score 0. The binary rules are
	// onnxruntime's, which the specification leaves open.
	// Fails when the attributes do not describe trees.
	internal def treeClassifier(c Call) !none {
		let x = try c.tensor(0)
		let labels = labelsOf(c, "classlabels_int64s")
		let classes = labelCount(labels)
		fail c.about() + "needs class labels" when classes == 0
		let f = try oldForest(c, "class", classes)
		let post = try postOf(c)
		let base = try numbersOf(c, "base_values")
		let (rows, _) = rowsOf(x)
		let v = try runForest(c, f, x, Aggregate.Sum)
		// Weights all positive and every vote for one class: the second
		// class needs 0.5.
		let positive = true
		let oneClass = true
		for let (i, w) in f.voteW {
			positive = false when w < 0.0
			oneClass = false when f.voteTo[i] != f.voteTo[0]
		}
		let z float32[]
		z.len(rows * classes)
		let picks int[]
		picks.len(rows)
		inBands(rows, rows * classes * 8, def (lo int, hi int) {
			classRows(v, classes, base, positive, oneClass, post, z, picks, lo, hi)
		})
		transformScores(z, rows, classes, post) when classes != 2
		c.out(0, labelTensor(labels, picks))
		c.out(1, new Tensor(int[rows, classes], z))
		return none
	}

	// Rows lo to hi of a tree classifier: the scores into z (transformed
	// for two classes, by the caller for more) and the class picked.
	internal def classRows(v Votes, classes int, base float[], positive bool, oneClass bool, post Post, z float32[], picks int[], lo int, hi int) {
		for let r = lo; r < hi; r++ {
			let at = r * classes
			if classes != 2 {
				let best = -1
				let top = 0.0
				for let k = 0; k < classes; k++ {
					let s = v.scores[at + k]
					let voted = v.voted[at + k]
					if k < base.len() {
						s = voted ?? (s + base[k], base[k])
						voted = true
					} else if !voted {
						s = 0.0
					}
					z[at + k] = float32(s)
					if voted && (best < 0 || s > top) {
						best = k
						top = s
					}
				}
				picks[r] = best < 0 ?? (0, best)
				continue
			}
			let has0 = v.voted[at]
			let has1 = v.voted[at + 1]
			let s0 = has0 ?? (v.scores[at], 0.0)
			let s1 = has1 ?? (v.scores[at + 1], 0.0)
			// Two scores, or (`two` false) only the first.
			let two = true
			if base.len() == 2 {
				if has1 {
					s1 = base[1] + s0
					s0 = -s1
				} else {
					s1 += base[1]
					s0 += base[0]
				}
			} else if base.len() == 1 {
				s0 += base[0]
				two = has1
			} else {
				two = has1
			}
			let weight = (two && has1) ?? (s1, has0 ?? (s0, 0.0))
			let pass = (positive && oneClass) ?? (weight > 0.5, weight > 0.0)
			picks[r] = pass ?? (1, 0)
			if two {
				// A class without votes scores 0.
				z[at] = float32(has0 ?? (s0, 0.0))
				z[at + 1] = float32(has1 ?? (s1, 0.0))
				transformRow(z, at, 2, post)
				continue
			}
			// One score written for both: (1 − s, s) for weights all
			// positive, (−s, s) for mixed ones.
			let (a, b) = twoScores(s0, post, !positive)
			z[at] = float32(a)
			z[at + 1] = float32(b)
		}
	}
}
