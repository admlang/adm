partial module std.ai.onnx {
	use (
		std.simd
		std.math
		std.formats.ai.onnx::(ElementType, elementBits)
		std.ai.tensor::(Tensor, storageOf, Storage)
	)

	// Runs the reductions, ArgMax/ArgMin/TopK, cumulative sums, softmax and normalization operators; false for an operator this family does not have.
	// Fails when the operator fails on its inputs.
	internal def applyReductions(c Call) !bool {
		match c.step.op {
			case "ReduceSum":
				try reduceOp(c, Reduction.Sum)
			case "ReduceSumSquare":
				try reduceOp(c, Reduction.SumSquare)
			case "ReduceL1":
				try reduceOp(c, Reduction.L1)
			case "ReduceL2":
				try reduceOp(c, Reduction.L2)
			case "ReduceLogSum":
				try reduceOp(c, Reduction.LogSum)
			case "ReduceLogSumExp":
				try reduceOp(c, Reduction.LogSumExp)
			case "ReduceMean":
				try reduceOp(c, Reduction.Mean)
			case "ReduceMax":
				try reduceOp(c, Reduction.Max)
			case "ReduceMin":
				try reduceOp(c, Reduction.Min)
			case "ReduceProd":
				try reduceOp(c, Reduction.Prod)
			case "ArgMax":
				try argOp(c, true)
			case "ArgMin":
				try argOp(c, false)
			case "TopK":
				try topK(c)
			case "CumSum":
				try cumulative(c, false)
			case "CumProd":
				try cumulative(c, true)
			case "Softmax":
				try softmaxOp(c, false)
			case "LogSoftmax":
				try softmaxOp(c, true)
			case "Hardmax":
				try hardmax(c)
			case "LayerNormalization":
				try layerNorm(c, false)
			case "RMSNormalization":
				try layerNorm(c, true)
			case "GroupNormalization":
				try groupNorm(c, false)
			case "InstanceNormalization":
				try groupNorm(c, true)
			case "BatchNormalization":
				try batchNorm(c)
			case "LpNormalization":
				try lpNorm(c)
			case "MeanVarianceNormalization":
				try meanVariance(c)
			case "LRN":
				try lrn(c)
			case "Det":
				try det(c)
			default:
				return false
		}
		return true
	}

	// The Reduce operators.
	internal enum Reduction {
		Sum,
		SumSquare,
		L1,
		L2,
		LogSum,
		LogSumExp,
		Mean,
		Max,
		Min,
		Prod,
	}

	// How the values of a reduction combine.
	internal enum Fold {
		Sum,
		Prod,
		Max,
		Min,
	}

	// What a reduction takes of each value before combining it.
	internal enum Pre {
		None,
		Abs,
		Square,
	}

	// A shape seen around one axis: `outer` slices of `n` values along
	// the axis, each value `inner` apart.
	internal struct Axis3 {
		outer int
		n     int
		inner int
	}

	// The input shape of a reduction with its dimensions of size 1 left
	// out and neighbours that are both reduced or both kept merged:
	// `dims` alternate between reduced and kept runs. `outShape` is the
	// result's shape with the reduced dimensions kept as 1.
	internal struct Layout {
		dims      int[]
		reduced   bool[]
		inStride  int[]
		outStride int[]
		outShape  int[]
		inCount   int
		outCount  int
	}

	// `shape` split around `axis`.
	internal def splitAt(shape int[], axis int) Axis3 {
		return Axis3{outer: spanOf(shape, 0, axis), n: shape[axis], inner: spanOf(shape, axis + 1, shape.len())}
	}

	// The product of shape[from:to].
	internal def spanOf(shape int[], from int, to int) int {
		let n = 1
		for let d = from; d < to; d++ {
			n *= shape[d]
		}
		return n
	}

	// Signed 64-bit values ordered as the unsigned ones they stand for.
	internal def flipped(v int[]) int[] {
		let out int[]
		out.len(v.len())
		for let i = 0; i < v.len(); i++ {
			out[i] = v[i] ^ math.MIN_INT64
		}
		return out
	}

	// The values of `t` as float64.
	internal def valuesOf(t Tensor) float[] {
		match storageOf(t.element) {
			case Storage.Doubles:
				return t.doubles
			case Storage.Floats:
				let out float[]
				out.len(t.floats.len())
				for let i = 0; i < t.floats.len(); i++ {
					out[i] = float(t.floats[i])
				}
				return out
			default:
				let out float[]
				out.len(t.ints.len())
				for let i = 0; i < t.ints.len(); i++ {
					out[i] = t.element == ElementType.Uint64 && t.ints[i] < 0 ?? (float(uint(t.ints[i])), float(t.ints[i]))
				}
				return out
		}
	}

	// float64 values as float32.
	internal def narrowed(v float[]) float32[] {
		let out float32[]
		out.len(v.len())
		for let i = 0; i < v.len(); i++ {
			out[i] = float32(v[i])
		}
		return out
	}

	// A tensor of `element` and `shape` holding `values` (rounded to a
	// narrow float type, truncated to an integer type).
	internal def tensorFrom(element ElementType, shape int[], values float[]) Tensor {
		let t = zerosLike(element, shape)
		match storageOf(element) {
			case Storage.Floats:
				for let i = 0; i < values.len(); i++ {
					t.floats[i] = float32(values[i])
				}
				roundTo(t)
			case Storage.Doubles:
				for let i = 0; i < values.len(); i++ {
					t.doubles[i] = values[i]
				}
			default:
				for let i = 0; i < values.len(); i++ {
					t.ints[i] = values[i] != values[i] ?? (0, truncated(values[i]))
				}
		}
		return t
	}

	// Reduce*: the reduction of the data over `axes` (an attribute before
	// opset 18, 13 for ReduceSum; an input from then on). No axes reduce
	// all of them, or none with noop_with_empty_axes.
	// Fails when an axis is out of range or the element type is not
	// numeric.
	internal def reduceOp(c Call, kind Reduction) !none {
		let t = try c.tensor(0)
		let rank = t.rank()
		let axesInput = c.opset >= 18 || (kind == Reduction.Sum && c.opset >= 13)
		let axes int[]
		if axesInput {
			axes = try c.ints(1) when c.has(1)
		} else {
			axes = c.ints("axes", int[])
		}
		let reduce bool[]
		reduce.len(rank)
		for let (_, a) in axes {
			let d = try axisOf(c, a, rank)
			reduce[d] = true
		} empty {
			reduce.fill(true) when c.int("noop_with_empty_axes", 0) == 0
		}
		let out = try reduced(c, t, reduce, kind)
		if c.int("keepdims", 1) == 0 {
			let shape int[]
			for let d = 0; d < rank; d++ {
				shape.push(t.shape[d]) unless reduce[d]
			}
			out.shape = shape
		}
		c.out(0, out)
		return none
	}

	// The reduction `kind` of `t` over the dimensions `reduce` marks, those
	// dimensions kept as 1.
	// Fails for strings.
	internal def reduced(c Call, t Tensor, reduce bool[], kind Reduction) !Tensor {
		let storage = storageOf(t.element)
		fail c.about() + "{kind.name} of {t.element.name}" when storage == Storage.Strings
		if storage == Storage.Ints && (kind := Reduction.L2 || Reduction.LogSum || Reduction.LogSumExp) {
			// Computed in float64 and truncated back, as numpy's astype does.
			let wide = try reduced(c, try cast(t, ElementType.Double, true), reduce, kind)
			return cast(wide, t.element, true)
		}
		return logSumExp(t, reduce) when kind == Reduction.LogSumExp
		let count = 1
		for let d = 0; d < t.rank(); d++ {
			count *= t.shape[d] when reduce[d]
		}
		let fold = Fold.Sum
		let pre = Pre.None
		match kind {
			case Reduction.SumSquare, Reduction.L2:
				pre = Pre.Square
			case Reduction.L1:
				pre = Pre.Abs
			case Reduction.Max:
				fold = Fold.Max
			case Reduction.Min:
				fold = Fold.Min
			case Reduction.Prod:
				fold = Fold.Prod
			default:
				fold = Fold.Sum
		}
		let out = folded(t, reduce, fold, pre)
		let completes = kind := Reduction.L2 || Reduction.LogSum || Reduction.Mean
		match storage {
			case Storage.Floats:
				if completes {
					for let i = 0; i < out.floats.len(); i++ {
						out.floats[i] = float32(completed(float(out.floats[i]), kind, count))
					}
				}
				roundTo(out)
			case Storage.Doubles:
				if completes {
					for let i = 0; i < out.doubles.len(); i++ {
						out.doubles[i] = completed(out.doubles[i], kind, count)
					}
				}
			default:
				if kind == Reduction.Mean {
					// numpy's integer mean: the sum in the type, divided and
					// truncated.
					for let i = 0; i < out.ints.len(); i++ {
						out.ints[i] = count == 0 ?? (0, out.ints[i] / count)
					}
				}
		}
		return out
	}

	// The last step of a reduction on its folded value.
	internal def completed(v float, kind Reduction, count int) float {
		match kind {
			case Reduction.L2:
				return math.sqrt(v)
			case Reduction.LogSum:
				return v < 0.0 || v != v ?? (0.0 / 0.0, v == 0.0 ?? (-1.0 / 0.0, math.ln(v)))
			case Reduction.Mean:
				return v / float(count)
			default:
				return v
		}
	}

	// ReduceLogSumExp: log(Σ exp(x − m)) + m with m the largest value of
	// each reduced set (0 when it is not finite); −∞ for an empty set.
	internal def logSumExp(t Tensor, reduce bool[]) !Tensor {
		let lay = layoutOf(t.shape, reduce)
		let out = zerosLike(t.element, lay.outShape)
		if lay.inCount == 0 {
			if storageOf(t.element) == Storage.Floats {
				out.floats.fill(float32(-1) / float32(0))
			} else {
				out.doubles.fill(-1.0 / 0.0)
			}
			return out
		}
		let last = lay.dims.len() - 1
		if lay.reduced[last] && (last == 0 || (last == 1 && !lay.reduced[0])) {
			// The trailing dimensions: one pass per contiguous row.
			let n = lay.dims[last]
			if storageOf(t.element) == Storage.Floats {
				inBands(lay.outCount, lay.inCount, def (lo int, hi int) {
					logSumExpRows(t.floats, out.floats, n, lo, hi)
				})
				roundTo(out)
			} else {
				inBands(lay.outCount, lay.inCount, def (lo int, hi int) {
					logSumExpRows(t.doubles, out.doubles, n, lo, hi)
				})
			}
			return out
		}
		let shift = folded(t, reduce, Fold.Max, Pre.None)
		let plan = try broadcast(t.shape, lay.outShape)
		let e = zerosLike(t.element, t.shape)
		if storageOf(t.element) == Storage.Floats {
			for let i = 0; i < shift.floats.len(); i++ {
				let m = shift.floats[i]
				shift.floats[i] = m - m == float32(0) ?? (m, float32(0))
			}
			runBlocks(plan, def (o int, from int, n int) {
				expShifted(t.floats, plan.aOffsets[o] + from * plan.aStep, shift.floats, plan.bOffsets[o] + from * plan.bStep, plan.bStep, e.floats, o * plan.inner + from, n)
			})
			let sum = folded(e, reduce, Fold.Sum, Pre.None)
			for let i = 0; i < out.floats.len(); i++ {
				out.floats[i] = float32(completed(float(sum.floats[i]), Reduction.LogSum, 0) + float(shift.floats[i]))
			}
			roundTo(out)
		} else {
			for let i = 0; i < shift.doubles.len(); i++ {
				let m = shift.doubles[i]
				shift.doubles[i] = m - m == 0.0 ?? (m, 0.0)
			}
			runBlocks(plan, def (o int, from int, n int) {
				expShifted(t.doubles, plan.aOffsets[o] + from * plan.aStep, shift.doubles, plan.bOffsets[o] + from * plan.bStep, plan.bStep, e.doubles, o * plan.inner + from, n)
			})
			let sum = folded(e, reduce, Fold.Sum, Pre.None)
			for let i = 0; i < out.doubles.len(); i++ {
				out.doubles[i] = completed(sum.doubles[i], Reduction.LogSum, 0) + shift.doubles[i]
			}
		}
		return out
	}

	// log Σ exp(x − m) + m of the rows lo to hi of n values, m the row's
	// largest value (0 when it is not finite).
	internal def logSumExpRows<T: SimdFloat>(x T[], out T[], n int, lo int, hi int) {
		let v vec8<T>
		for let r = lo; r < hi; r++ {
			let at = r * n
			let acc = v.splat(x[at])
			let i = 0
			for; i + 8 <= n; i += 8 {
				acc = simd.max(acc, v.load(x, at + i))
			}
			let m = simd.maxLane(acc)
			for; i < n; i++ {
				m = x[at + i] > m ?? (x[at + i], m)
			}
			m = m - m == T(0) ?? (m, T(0))
			let mv = v.splat(m)
			let sum = v.splat(T(0))
			i = 0
			for; i + 8 <= n; i += 8 {
				sum = sum + simd.exp(v.load(x, at + i) - mv)
			}
			let total = float(simd.sum(sum))
			for; i < n; i++ {
				total += math.E ** float(x[at + i] - m)
			}
			out[r] = T(completed(total, Reduction.LogSum, 0) + float(m))
		}
	}

	// out[oo + i] = exp(x[xo + i] − s[so + i · sStep]) for i < n.
	internal def expShifted<T: SimdFloat>(x T[], xo int, s T[], so int, sStep int, out T[], oo int, n int) {
		let v vec8<T>
		let i = 0
		if sStep == 0 {
			let sv = v.splat(s[so])
			for; i + 8 <= n; i += 8 {
				simd.exp(v.load(x, xo + i) - sv).store(out, oo + i)
			}
		} else {
			for; i + 8 <= n; i += 8 {
				simd.exp(v.load(x, xo + i) - v.load(s, so + i)).store(out, oo + i)
			}
		}
		for; i < n; i++ {
			out[oo + i] = T(math.E ** float(x[xo + i] - s[so + i * sStep]))
		}
	}

	// The layout of reducing `shape` over the dimensions `reduce` marks.
	internal def layoutOf(shape int[], reduce bool[]) Layout {
		let lay = Layout{inCount: 1, outCount: 1}
		for let d = 0; d < shape.len(); d++ {
			lay.inCount *= shape[d]
			lay.outShape.push(reduce[d] ?? (1, shape[d]))
			lay.outCount *= reduce[d] ?? (1, shape[d])
			continue when shape[d] == 1
			let last = lay.dims.len() - 1
			if last >= 0 && lay.reduced[last] == reduce[d] {
				lay.dims[last] *= shape[d]
			} else {
				lay.dims.push(shape[d])
				lay.reduced.push(reduce[d])
			}
		}
		if lay.dims.len() == 0 {
			lay.dims.push(1)
			lay.reduced.push(false)
		}
		let g = lay.dims.len()
		lay.inStride.len(g)
		lay.outStride.len(g)
		let (si, so) = (1, 1)
		for let d = g - 1; d >= 0; d-- {
			lay.inStride[d] = si
			lay.outStride[d] = lay.reduced[d] ?? (0, so)
			si *= lay.dims[d]
			so *= lay.reduced[d] ?? (1, lay.dims[d])
		}
		return lay
	}

	// `t` folded over the dimensions `reduce` marks, kept as 1; integer
	// sums and products wrapped to the type's width. An empty set gives
	// the fold's identity: 0, 1, the type's lowest value (−∞) for Max,
	// its highest (+∞) for Min.
	internal def folded(t Tensor, reduce bool[], fold Fold, pre Pre) Tensor {
		let lay = layoutOf(t.shape, reduce)
		let out = zerosLike(t.element, lay.outShape)
		match storageOf(t.element) {
			case Storage.Floats:
				let id = float32(floatIdentity(fold))
				out.floats.fill(id)
				foldAll(t.floats, out.floats, lay, fold, pre, id) when lay.inCount > 0
			case Storage.Doubles:
				let id = floatIdentity(fold)
				out.doubles.fill(id)
				foldAll(t.doubles, out.doubles, lay, fold, pre, id) when lay.inCount > 0
			default:
				let flip = t.element == ElementType.Uint64 && (fold := Fold.Max || Fold.Min)
				let bias = flip ?? (math.MIN_INT64, 0)
				let id = intIdentity(t.element, fold) ^ bias
				out.ints.fill(id)
				let signed = signedType(t.element)
				// |x| of an unsigned value is the value.
				let p = (!signed && pre == Pre.Abs) ?? (Pre.None, pre)
				foldAll(flip ?? (flipped(t.ints), t.ints), out.ints, lay, fold, p, id) when lay.inCount > 0
				let bits = elementBits(t.element)
				let wraps = fold := Fold.Sum || Fold.Prod
				for let i = 0; i < out.ints.len(); i++ {
					let v = out.ints[i] ^ bias
					out.ints[i] = wraps ?? (wrap(v, bits, signed), v)
				}
		}
		return out
	}

	internal def floatIdentity(fold Fold) float {
		match fold {
			case Fold.Sum:
				return 0.0
			case Fold.Prod:
				return 1.0
			case Fold.Max:
				return -1.0 / 0.0
			default:
				return 1.0 / 0.0
		}
	}

	internal def intIdentity(element ElementType, fold Fold) int {
		match fold {
			case Fold.Sum:
				return 0
			case Fold.Prod:
				return 1
			case Fold.Max:
				return lowest(element)
			default:
				return highest(element)
		}
	}

	// The lowest value of an integer type (Bool's false).
	internal def lowest(element ElementType) int {
		return 0 unless signedType(element)
		let bits = elementBits(element)
		return bits >= 64 ?? (math.MIN_INT64, -(1 << (bits - 1)))
	}

	// The highest value of an integer type (Bool's true; all ones for
	// Uint64).
	internal def highest(element ElementType) int {
		return 1 when element == ElementType.Bool
		let bits = elementBits(element)
		return bits >= 64 ?? (math.MAX_INT64, (1 << (bits - 1)) - 1) when signedType(element)
		return bits >= 64 ?? (-1, (1 << bits) - 1)
	}

	// Folds all of `x` into `out` (filled with `identity`) on several
	// tasks for large inputs: bands of the outermost kept run, else
	// strips of wide kept rows, else partial folds of bands of the one
	// reduced run.
	internal def foldAll<T: SimdNumeric>(x T[], out T[], lay Layout, fold Fold, pre Pre, identity T) {
		let last = lay.dims.len() - 1
		let size = lay.dims[last]
		let tasks = (lay.inCount / parallelFrom).clamp(1, 32)
		if tasks == 1 {
			foldRun(x, out, 0, lay, fold, pre, identity, -1, 0, 0, 0, size)
			return
		}
		let p = -1
		for let d = 0; d < last; d++ {
			if !lay.reduced[d] {
				p = d
				break
			}
		}
		if p >= 0 {
			inBands(lay.dims[p], lay.inCount, def (lo int, hi int) {
				foldRun(x, out, 0, lay, fold, pre, identity, p, lo, hi, 0, size)
			})
			return
		}
		if !lay.reduced[last] && (last == 0 || size / tasks >= 4096) {
			// Wide kept rows: strips of columns, each read row by row.
			inBands(size, lay.inCount, def (lo int, hi int) {
				foldRun(x, out, 0, lay, fold, pre, identity, -1, 0, 0, lo, hi)
			})
			return
		}
		// One reduced run, alone or before narrow kept rows: bands of it
		// folded into partial results of their own, then those folded in
		// order, so the result never depends on timing.
		let alone = lay.reduced[last]
		let width = alone ?? (1, size)
		let rows = lay.dims[0]
		let parts = alone ?? (tasks, tasks.min(rows))
		let partials T[]
		partials.len(parts * width)
		partials.fill(identity)
		inTasks(parts, def (t int) {
			if alone {
				foldRun(x, partials, t, lay, fold, pre, identity, -1, 0, 0, size * t / parts, size * (t + 1) / parts)
			} else {
				foldRun(x, partials, t * width, lay, fold, pre, identity, 0, rows * t / parts, rows * (t + 1) / parts, 0, size)
			}
		})
		let merge = Layout{dims: int[parts, width], reduced: bool[true, false], inStride: int[width, 1], outStride: int[0, 1], inCount: parts * width, outCount: width}
		foldRun(partials, out, 0, merge, fold, Pre.None, identity, -1, 0, 0, 0, width)
	}

	// Runs task(t) for t from 0 to `tasks`, each on a task of its own
	// when there are several.
	internal def inTasks(tasks int, task def(int)) {
		if tasks == 1 {
			task(0)
			return
		}
		forall let t in 0..tasks {
			task(t)
		}
	}

	// Runs slices(lo, hi, jlo, jhi) over the slices of `a` from lo to hi
	// and their columns from jlo to jhi: bands of whole slices, or bands
	// of the columns of each slice when there are fewer slices than tasks.
	internal def inSlices(a Axis3, slices def(int, int, int, int)) {
		let work = a.outer * a.n * a.inner
		let tasks = (work / parallelFrom).clamp(1, 32)
		if a.outer >= tasks || a.inner == 1 {
			inBands(a.outer, work, def (lo int, hi int) {
				slices(lo, hi, 0, a.inner)
			})
			return
		}
		// Columns in chunks of a page (1024 float32) or more, so that tasks
		// share few cache lines and pages.
		let chunks = (a.inner + 1023) / 1024
		for let o = 0; o < a.outer; o++ {
			inBands(chunks, a.n * a.inner, def (lo int, hi int) {
				slices(o, o + 1, lo * 1024, (hi * 1024).min(a.inner))
			})
		}
	}

	// Folds the blocks of `x` into `out` from `oo`: every run but the
	// innermost walked in order (run `p` only from pLo to pHi), the
	// innermost from jLo to jHi: across eight lanes when it is reduced,
	// lane by lane into the outputs when it is kept.
	internal def foldRun<T: SimdNumeric>(x T[], out T[], oo int, lay Layout, fold Fold, pre Pre, identity T, p int, pLo int, pHi int, jLo int, jHi int) {
		let last = lay.dims.len() - 1
		let idx int[]
		idx.len(last + 1)
		let blocks = 1
		let (ib, ob) = (0, 0)
		for let d = 0; d < last; d++ {
			if d == p {
				idx[d] = pLo
				blocks *= pHi - pLo
				ib += pLo * lay.inStride[d]
				ob += pLo * lay.outStride[d]
			} else {
				blocks *= lay.dims[d]
			}
		}
		let rowReduced = lay.reduced[last]
		let minmax = fold := Fold.Max || Fold.Min
		let v vec8<T>
		let zero = v.splat(T(0))
		let start = v.splat(identity)
		for let b = 0; b < blocks; b++ {
			if rowReduced {
				let end = ib + jHi
				let i = ib + jLo
				let a0 = start
				let a1 = start
				let nan = zero
				for; i + 16 <= end; i += 16 {
					let y0 = v.load(x, i)
					let y1 = v.load(x, i + 8)
					if pre == Pre.Abs {
						y0 = simd.blend(simd.lt(y0, zero), zero - y0, y0)
						y1 = simd.blend(simd.lt(y1, zero), zero - y1, y1)
					} else if pre == Pre.Square {
						y0 = y0 * y0
						y1 = y1 * y1
					}
					match fold {
						case Fold.Sum:
							a0 = a0 + y0
							a1 = a1 + y1
						case Fold.Prod:
							a0 = a0 * y0
							a1 = a1 * y1
						case Fold.Max:
							a0 = simd.max(a0, y0)
							a1 = simd.max(a1, y1)
							nan = simd.blend(simd.ne(y0, y0), y0, simd.blend(simd.ne(y1, y1), y1, nan))
						default:
							a0 = simd.min(a0, y0)
							a1 = simd.min(a1, y1)
							nan = simd.blend(simd.ne(y0, y0), y0, simd.blend(simd.ne(y1, y1), y1, nan))
					}
				}
				for; i + 8 <= end; i += 8 {
					let y = v.load(x, i)
					if pre == Pre.Abs {
						y = simd.blend(simd.lt(y, zero), zero - y, y)
					} else if pre == Pre.Square {
						y = y * y
					}
					match fold {
						case Fold.Sum:
							a0 = a0 + y
						case Fold.Prod:
							a0 = a0 * y
						case Fold.Max:
							a0 = simd.max(a0, y)
							nan = simd.blend(simd.ne(y, y), y, nan)
						default:
							a0 = simd.min(a0, y)
							nan = simd.blend(simd.ne(y, y), y, nan)
					}
				}
				let r = out[oo + ob]
				match fold {
					case Fold.Sum:
						r = r + simd.sum(a0 + a1)
					case Fold.Prod:
						let m = a0 * a1
						for let k = 0; k < 8; k++ {
							r = r * simd.lane(m, k)
						}
					case Fold.Max:
						r = combine(r, simd.maxLane(simd.max(a0, a1)), fold)
					default:
						r = combine(r, simd.minLane(simd.min(a0, a1)), fold)
				}
				if minmax {
					// A NaN lane makes the sum NaN.
					let s = simd.sum(nan)
					r = s != s ?? (s, r)
				}
				for; i < end; i++ {
					r = combine(r, prepare(x[i], pre), fold)
				}
				out[oo + ob] = r
			} else {
				let to = oo + ob
				let j = jLo
				for; j + 8 <= jHi; j += 8 {
					let y = v.load(x, ib + j)
					if pre == Pre.Abs {
						y = simd.blend(simd.lt(y, zero), zero - y, y)
					} else if pre == Pre.Square {
						y = y * y
					}
					let o = v.load(out, to + j)
					let r = o
					match fold {
						case Fold.Sum:
							r = o + y
						case Fold.Prod:
							r = o * y
						case Fold.Max:
							r = simd.blend(simd.ne(y, y), y, simd.blend(simd.ne(o, o), o, simd.max(o, y)))
						default:
							r = simd.blend(simd.ne(y, y), y, simd.blend(simd.ne(o, o), o, simd.min(o, y)))
					}
					r.store(out, to + j)
				}
				for; j < jHi; j++ {
					out[to + j] = combine(out[to + j], prepare(x[ib + j], pre), fold)
				}
			}
			for let d = last - 1; d >= 0; d-- {
				idx[d]++
				ib += lay.inStride[d]
				ob += lay.outStride[d]
				break when idx[d] < (d == p ?? (pHi, lay.dims[d]))
				let lo = d == p ?? (pLo, 0)
				ib -= (idx[d] - lo) * lay.inStride[d]
				ob -= (idx[d] - lo) * lay.outStride[d]
				idx[d] = lo
			}
		}
	}

	// One value as a reduction takes it.
	internal def prepare<T: SimdNumeric>(y T, pre Pre) T {
		match pre {
			case Pre.Abs:
				return y < T(0) ?? (T(0) - y, y)
			case Pre.Square:
				return y * y
			default:
				return y
		}
	}

	// Two values folded; Max and Min keep a NaN.
	internal def combine<T: SimdNumeric>(a T, b T, fold Fold) T {
		match fold {
			case Fold.Sum:
				return a + b
			case Fold.Prod:
				return a * b
			case Fold.Max:
				return a != a ?? (a, b != b ?? (b, b > a ?? (b, a)))
			default:
				return a != a ?? (a, b != b ?? (b, b < a ?? (b, a)))
		}
	}

	// ArgMax and ArgMin: the index of the largest (smallest) value along
	// `axis`, the first one (the last with select_last_index); a NaN
	// counts as the extreme, as numpy has it.
	// Fails when the axis is out of range or empty.
	internal def argOp(c Call, largest bool) !none {
		let t = try c.tensor(0)
		let rank = t.rank()
		let axis = try axisOf(c, c.int("axis", 0), rank)
		let a = splitAt(t.shape, axis)
		fail c.about() + "the axis is empty" when a.n == 0 && a.outer * a.inner > 0
		let index = try argIndices(c, t, a, largest, c.int("select_last_index", 0) != 0)
		let shape int[]
		for let d = 0; d < rank; d++ {
			if d != axis {
				shape.push(t.shape[d])
			} else if c.int("keepdims", 1) != 0 {
				shape.push(1)
			}
		}
		c.out(0, new Tensor(shape, index, ElementType.Int64))
		return none
	}

	// The arg extreme of every slice of `t` along the axis `a` describes,
	// outer × inner indices.
	// Fails for strings.
	internal def argIndices(c Call, t Tensor, a Axis3, largest bool, last bool) !int[] {
		let out int[]
		out.len(a.outer * a.inner)
		return out when out.len() == 0 || a.n == 0
		match storageOf(t.element) {
			case Storage.Floats:
				argRows(t.floats, a, largest, last, out)
			case Storage.Doubles:
				argRows(t.doubles, a, largest, last, out)
			case Storage.Ints:
				argRows(t.element == ElementType.Uint64 ?? (flipped(t.ints), t.ints), a, largest, last, out)
			default:
				fail c.about() + "strings have no order here"
		}
		return out
	}

	internal def argRows<T: SimdNumeric>(x T[], a Axis3, largest bool, last bool, out int[]) {
		inSlices(a, def (lo int, hi int, jlo int, jhi int) {
			argBand(x, a, largest, last, out, lo, hi, jlo, jhi)
		})
	}

	// The arg extremes of slices lo to hi: along contiguous rows the
	// extreme is found eight lanes at a time and then its place; across
	// rows each column keeps its best so far.
	internal def argBand<T: SimdNumeric>(x T[], a Axis3, largest bool, last bool, out int[], lo int, hi int, jlo int, jhi int) {
		let n = a.n
		if a.inner == 1 {
			let v vec8<T>
			for let o = lo; o < hi; o++ {
				let base = o * n
				let acc = v.splat(x[base])
				let nan = v.splat(T(0))
				let i = 0
				for; i + 8 <= n; i += 8 {
					let y = v.load(x, base + i)
					if largest {
						acc = simd.max(acc, y)
					} else {
						acc = simd.min(acc, y)
					}
					nan = simd.blend(simd.ne(y, y), y, nan)
				}
				let best = largest ?? (simd.maxLane(acc), simd.minLane(acc))
				let s = simd.sum(nan)
				let hasNaN = s != s
				for; i < n; i++ {
					let y = x[base + i]
					hasNaN = hasNaN || y != y
					if largest {
						best = y > best ?? (y, best)
					} else {
						best = y < best ?? (y, best)
					}
				}
				let found = 0
				if last {
					for let k = n - 1; k >= 0; k-- {
						let y = x[base + k]
						if hasNaN ?? (y != y, y == best) {
							found = k
							break
						}
					}
				} else {
					for let k = 0; k < n; k++ {
						let y = x[base + k]
						if hasNaN ?? (y != y, y == best) {
							found = k
							break
						}
					}
				}
				out[o] = found
			}
			return
		}
		let inner = a.inner
		let best T[]
		best.len(inner)
		for let o = lo; o < hi; o++ {
			let base = o * n * inner
			let ob = o * inner
			for let j = jlo; j < jhi; j++ {
				best[j] = x[base + j]
				out[ob + j] = 0
			}
			for let k = 1; k < n; k++ {
				let row = base + k * inner
				for let j = jlo; j < jhi; j++ {
					let y = x[row + j]
					let b = best[j]
					let take = false
					if b != b {
						take = last && y != y
					} else if y != y {
						take = true
					} else if largest {
						take = last ?? (y >= b, y > b)
					} else {
						take = last ?? (y <= b, y < b)
					}
					if take {
						best[j] = y
						out[ob + j] = k
					}
				}
			}
		}
	}

	// TopK: the k largest (smallest) values along `axis` and their
	// indices, best first; equal values in index order, a NaN above every
	// number. k is an attribute before opset 10, an input after.
	// Fails when k is negative or larger than the axis.
	internal def topK(c Call) !none {
		let t = try c.tensor(0)
		let rank = t.rank()
		let axis = try axisOf(c, c.int("axis", -1), rank)
		let k = 0
		if c.opset < 10 {
			k = c.int("k", 0)
		} else {
			let ks = try c.ints(1)
			fail c.about() + "K holds no value" when ks.len() == 0
			k = ks[0]
		}
		let a = splitAt(t.shape, axis)
		fail c.about() + "k {k} is outside 0 to {a.n}" unless k >= 0 && k <= a.n
		let largest = c.int("largest", 1) != 0
		let shape = t.shape.clone()
		shape[axis] = k
		let values = zerosLike(t.element, shape)
		let index int[]
		index.len(a.outer * k * a.inner)
		if index.len() > 0 {
			match storageOf(t.element) {
				case Storage.Floats:
					topRows(t.floats, a, k, largest, values.floats, index)
				case Storage.Doubles:
					topRows(t.doubles, a, k, largest, values.doubles, index)
				case Storage.Ints:
					if t.element == ElementType.Uint64 {
						topRows(flipped(t.ints), a, k, largest, values.ints, index)
						values.ints = flipped(values.ints)
					} else {
						topRows(t.ints, a, k, largest, values.ints, index)
					}
				default:
					fail c.about() + "strings have no order here"
			}
		}
		c.out(0, values)
		c.out(1, new Tensor(shape, index, ElementType.Int64))
		return none
	}

	internal def topRows<T: SimdNumeric>(x T[], a Axis3, k int, largest bool, values T[], index int[]) {
		let slices = a.outer * a.inner
		inBands(slices, slices * a.n, def (lo int, hi int) {
			topBand(x, a, k, largest, values, index, lo, hi)
		})
	}

	// Whether (a, ia) comes before (b, ib) in TopK's order.
	internal def ranksBefore<T: SimdNumeric>(a T, ia int, b T, ib int, largest bool) bool {
		let an = a != a
		let bn = b != b
		return an && bn ?? (ia < ib, an == largest) when an || bn
		return ia < ib when a == b
		return largest ?? (a > b, a < b)
	}

	// TopK of slices lo to hi: a heap of the k best so far with the one
	// that ranks last on top, taken off into place, best first, at the
	// end of each slice.
	internal def topBand<T: SimdNumeric>(x T[], a Axis3, k int, largest bool, values T[], index int[], lo int, hi int) {
		let heapValues T[]
		let heapIndex int[]
		heapValues.len(k)
		heapIndex.len(k)
		for let s = lo; s < hi; s++ {
			let o = s / a.inner
			let j = s % a.inner
			let base = o * a.n * a.inner + j
			let size = 0
			for let i = 0; i < a.n; i++ {
				let y = x[base + i * a.inner]
				if size < k {
					// Sift up: a parent ranks after its children.
					let at = size
					size++
					for at > 0 {
						let up = (at - 1) / 2
						break unless ranksBefore(heapValues[up], heapIndex[up], y, i, largest)
						heapValues[at] = heapValues[up]
						heapIndex[at] = heapIndex[up]
						at = up
					}
					heapValues[at] = y
					heapIndex[at] = i
				} else if ranksBefore(y, i, heapValues[0], heapIndex[0], largest) {
					siftDown(heapValues, heapIndex, size, y, i, largest)
				}
			}
			for let n = size; n > 0; n-- {
				let wv = heapValues[0]
				let wi = heapIndex[0]
				siftDown(heapValues, heapIndex, n - 1, heapValues[n - 1], heapIndex[n - 1], largest) when n > 1
				let at = (o * k + n - 1) * a.inner + j
				values[at] = wv
				index[at] = wi
			}
		}
	}

	// Places (y, iy) at the top of the heap of `size` and moves it down
	// until both children rank before it.
	internal def siftDown<T: SimdNumeric>(heapValues T[], heapIndex int[], size int, y T, iy int, largest bool) {
		let p = 0
		for 2 * p + 1 < size {
			let l = 2 * p + 1
			let worst = l
			worst = l + 1 when l + 1 < size && ranksBefore(heapValues[l], heapIndex[l], heapValues[l + 1], heapIndex[l + 1], largest)
			break unless ranksBefore(y, iy, heapValues[worst], heapIndex[worst], largest)
			heapValues[p] = heapValues[worst]
			heapIndex[p] = heapIndex[worst]
			p = worst
		}
		heapValues[p] = y
		heapIndex[p] = iy
	}

	// CumSum and CumProd along the axis input: inclusive or exclusive,
	// forward or reversed; integers wrap to their width.
	// Fails when the axis is out of range.
	internal def cumulative(c Call, product bool) !none {
		let t = try c.tensor(0)
		let rank = t.rank()
		let axes = try c.ints(1)
		fail c.about() + "the axis input holds no value" when axes.len() == 0
		let axis = try axisOf(c, axes[0], rank)
		let a = splitAt(t.shape, axis)
		let exclusive = c.int("exclusive", 0) != 0
		let reverse = c.int("reverse", 0) != 0
		let out = zerosLike(t.element, t.shape)
		if out.count() > 0 {
			match storageOf(t.element) {
				case Storage.Floats:
					scanRows(t.floats, out.floats, a, product, exclusive, reverse, product ?? (float32(1), float32(0)))
					roundTo(out)
				case Storage.Doubles:
					scanRows(t.doubles, out.doubles, a, product, exclusive, reverse, product ?? (1.0, 0.0))
				case Storage.Ints:
					scanRows(t.ints, out.ints, a, product, exclusive, reverse, product ?? (1, 0))
					let bits = elementBits(t.element)
					let signed = signedType(t.element)
					for let i = 0; i < out.ints.len(); i++ {
						out.ints[i] = wrap(out.ints[i], bits, signed)
					}
				default:
					fail c.about() + "strings do not add up"
			}
		}
		c.out(0, out)
		return none
	}

	internal def scanRows<T: SimdNumeric>(x T[], y T[], a Axis3, product bool, exclusive bool, reverse bool, identity T) {
		inSlices(a, def (lo int, hi int, jlo int, jhi int) {
			scanBand(x, y, a, product, exclusive, reverse, identity, lo, hi, jlo, jhi)
		})
	}

	// The running sums (products) of slices lo to hi: along a row one at
	// a time, across rows eight columns at a time.
	internal def scanBand<T: SimdNumeric>(x T[], y T[], a Axis3, product bool, exclusive bool, reverse bool, identity T, lo int, hi int, jlo int, jhi int) {
		let inner = a.inner
		let acc T[]
		acc.len(inner)
		let v vec8<T>
		for let o = lo; o < hi; o++ {
			let base = o * a.n * inner
			acc.fill(identity)
			for let s = 0; s < a.n; s++ {
				let row = base + (reverse ?? (a.n - 1 - s, s)) * inner
				let j = jlo
				for; j + 8 <= jhi; j += 8 {
					let r = v.load(acc, j)
					let xv = v.load(x, row + j)
					r.store(y, row + j) when exclusive
					if product {
						r = r * xv
					} else {
						r = r + xv
					}
					r.store(y, row + j) unless exclusive
					r.store(acc, j)
				}
				for; j < jhi; j++ {
					let r = acc[j]
					y[row + j] = r when exclusive
					r = product ?? (r * x[row + j], r + x[row + j])
					y[row + j] = r unless exclusive
					acc[j] = r
				}
			}
		}
	}

	// The slices Softmax, LogSoftmax and Hardmax work on: before opset 13
	// the input as a matrix of the dimensions before `axis` by those from
	// it, from 13 the one axis.
	// Fails when the axis is out of range.
	internal def softAxis(c Call, t Tensor) !Axis3 {
		let rank = t.rank()
		if c.opset < 13 {
			let axis = try axisOf(c, c.int("axis", 1), rank)
			return Axis3{outer: spanOf(t.shape, 0, axis), n: spanOf(t.shape, axis, rank), inner: 1}
		}
		return splitAt(t.shape, try axisOf(c, c.int("axis", -1), rank))
	}

	// Softmax and LogSoftmax: exp(x − max) / Σ exp(x − max) along the
	// axis, and x − max − log Σ exp(x − max).
	// Fails when the axis is out of range or the type is not a float.
	internal def softmaxOp(c Call, log bool) !none {
		let t = try c.tensor(0)
		let a = try softAxis(c, t)
		if t.count() == 0 {
			c.out(0, t)
			return none
		}
		let out = c.pool.tensor(t.element, t.shape)
		if t.element := ElementType.Float16 || ElementType.BFloat16 {
			narrowSoftmax(t, out, a, log)
			c.out(0, out)
			return none
		}
		match storageOf(t.element) {
			case Storage.Floats:
				softRows(t.floats, out.floats, a, log)
				roundTo(out)
			case Storage.Doubles:
				softRows(t.doubles, out.doubles, a, log)
			default:
				fail c.about() + "{t.element.name} is not a floating-point type"
		}
		c.out(0, out)
		return none
	}

	// Softmax (and its log) of a float16 or bfloat16 tensor as the ONNX
	// reference computes it in the type: x − max, its exponential, their
	// sum and the quotient (then its logarithm) each rounded to the type.
	// float16 sums add in float32; bfloat16 sums round after every
	// addition, as ml_dtypes does.
	internal def narrowSoftmax(t Tensor, out Tensor, a Axis3, log bool) {
		let x = t.floats
		let y = out.floats
		for let o = 0; o < a.outer; o++ {
			for let j = 0; j < a.inner; j++ {
				let base = o * a.n * a.inner + j
				let top = x[base]
				for let k = 1; k < a.n; k++ {
					top = x[base + k * a.inner] > top ?? (x[base + k * a.inner], top)
				}
				for let k = 0; k < a.n; k++ {
					y[base + k * a.inner] = x[base + k * a.inner] - top
				}
			}
		}
		roundTo(out)
		for let i = 0; i < y.len(); i++ {
			y[i] = float32(math.E ** float(y[i]))
		}
		roundTo(out)
		let sums = zerosLike(t.element, int[a.outer * a.inner])
		let stepwise = t.element == ElementType.BFloat16
		let one = zerosLike(t.element, int[1])
		for let o = 0; o < a.outer; o++ {
			for let j = 0; j < a.inner; j++ {
				let base = o * a.n * a.inner + j
				let sum = float32(0)
				for let k = 0; k < a.n; k++ {
					sum += y[base + k * a.inner]
					if stepwise {
						one.floats[0] = sum
						roundTo(one)
						sum = one.floats[0]
					}
				}
				sums.floats[o * a.inner + j] = sum
			}
		}
		roundTo(sums)
		for let o = 0; o < a.outer; o++ {
			for let j = 0; j < a.inner; j++ {
				let base = o * a.n * a.inner + j
				let sum = sums.floats[o * a.inner + j]
				for let k = 0; k < a.n; k++ {
					y[base + k * a.inner] /= sum
				}
			}
		}
		roundTo(out)
		return unless log
		for let i = 0; i < y.len(); i++ {
			y[i] = float32(math.ln(float(y[i])))
		}
		roundTo(out)
	}

	internal def softRows<T: SimdFloat>(x T[], y T[], a Axis3, log bool) {
		inSlices(a, def (lo int, hi int, jlo int, jhi int) {
			softBand(x, y, a, log, lo, hi, jlo, jhi)
		})
	}

	// Softmax of slices lo to hi: along a contiguous row in three passes
	// of eight lanes (max, exponentials and their sum, scale), across rows
	// the same per column eight columns at a time.
	internal def softBand<T: SimdFloat>(x T[], y T[], a Axis3, log bool, lo int, hi int, jlo int, jhi int) {
		let n = a.n
		let inner = a.inner
		let v vec8<T>
		if inner == 1 {
			for let o = lo; o < hi; o++ {
				let base = o * n
				let acc = v.splat(x[base])
				let i = 0
				for; i + 8 <= n; i += 8 {
					acc = simd.max(acc, v.load(x, base + i))
				}
				let m = simd.maxLane(acc)
				for; i < n; i++ {
					m = x[base + i] > m ?? (x[base + i], m)
				}
				let mv = v.splat(m)
				let sum = v.splat(T(0))
				i = 0
				for; i + 8 <= n; i += 8 {
					let e = simd.exp(v.load(x, base + i) - mv)
					e.store(y, base + i) unless log
					sum = sum + e
				}
				let total = simd.sum(sum)
				for; i < n; i++ {
					let e = T(math.E ** float(x[base + i] - m))
					y[base + i] = e unless log
					total += e
				}
				i = 0
				if log {
					let shift = m + T(math.ln(float(total)))
					let sv = v.splat(shift)
					for; i + 8 <= n; i += 8 {
						(v.load(x, base + i) - sv).store(y, base + i)
					}
					for; i < n; i++ {
						y[base + i] = x[base + i] - shift
					}
				} else {
					let scale = T(1) / total
					let sv = v.splat(scale)
					for; i + 8 <= n; i += 8 {
						(v.load(y, base + i) * sv).store(y, base + i)
					}
					for; i < n; i++ {
						y[base + i] *= scale
					}
				}
			}
			return
		}
		let mx T[]
		let sum T[]
		mx.len(inner)
		sum.len(inner)
		for let o = lo; o < hi; o++ {
			let base = o * n * inner
			for let j = jlo; j < jhi; j++ {
				mx[j] = x[base + j]
				sum[j] = T(0)
			}
			for let k = 1; k < n; k++ {
				let row = base + k * inner
				let j = jlo
				for; j + 8 <= jhi; j += 8 {
					simd.max(v.load(mx, j), v.load(x, row + j)).store(mx, j)
				}
				for; j < jhi; j++ {
					mx[j] = x[row + j] > mx[j] ?? (x[row + j], mx[j])
				}
			}
			for let k = 0; k < n; k++ {
				let row = base + k * inner
				let j = jlo
				for; j + 8 <= jhi; j += 8 {
					let e = simd.exp(v.load(x, row + j) - v.load(mx, j))
					e.store(y, row + j) unless log
					(v.load(sum, j) + e).store(sum, j)
				}
				for; j < jhi; j++ {
					let e = T(math.E ** float(x[row + j] - mx[j]))
					y[row + j] = e unless log
					sum[j] += e
				}
			}
			// sum becomes what each column subtracts (log) or multiplies by.
			for let j = jlo; j < jhi; j++ {
				sum[j] = log ?? (mx[j] + T(math.ln(float(sum[j]))), T(1) / sum[j])
			}
			for let k = 0; k < n; k++ {
				let row = base + k * inner
				let j = jlo
				for; j + 8 <= jhi; j += 8 {
					if log {
						(v.load(x, row + j) - v.load(sum, j)).store(y, row + j)
					} else {
						(v.load(y, row + j) * v.load(sum, j)).store(y, row + j)
					}
				}
				for; j < jhi; j++ {
					y[row + j] = log ?? (x[row + j] - sum[j], y[row + j] * sum[j])
				}
			}
		}
	}

	// Hardmax: 1 at the first largest value of each slice, 0 elsewhere.
	// Fails when the axis is out of range or the type is not a float.
	internal def hardmax(c Call) !none {
		let t = try c.tensor(0)
		let a = try softAxis(c, t)
		let out = zerosLike(t.element, t.shape)
		let storage = storageOf(t.element)
		fail c.about() + "{t.element.name} is not a floating-point type" unless storage := Storage.Floats || Storage.Doubles
		if t.count() > 0 {
			let index = try argIndices(c, t, a, largest = true, last = false)
			for let o = 0; o < a.outer; o++ {
				for let j = 0; j < a.inner; j++ {
					let at = (o * a.n + index[o * a.inner + j]) * a.inner + j
					if storage == Storage.Floats {
						out.floats[at] = float32(1)
					} else {
						out.doubles[at] = 1.0
					}
				}
			}
		}
		c.out(0, out)
		return none
	}

	// Σ x[at:at + n].
	internal def segSum<T: SimdFloat>(x T[], at int, n int) T {
		let v vec8<T>
		let a0 = v.splat(T(0))
		let a1 = a0
		let i = at
		let end = at + n
		for; i + 16 <= end; i += 16 {
			a0 = a0 + v.load(x, i)
			a1 = a1 + v.load(x, i + 8)
		}
		for; i + 8 <= end; i += 8 {
			a0 = a0 + v.load(x, i)
		}
		let s = simd.sum(a0 + a1)
		for; i < end; i++ {
			s += x[i]
		}
		return s
	}

	// Σ (x[at:at + n] − m)².
	internal def segDev<T: SimdFloat>(x T[], at int, n int, m T) T {
		let v vec8<T>
		let mv = v.splat(m)
		let a0 = v.splat(T(0))
		let a1 = a0
		let i = at
		let end = at + n
		for; i + 16 <= end; i += 16 {
			let d0 = v.load(x, i) - mv
			let d1 = v.load(x, i + 8) - mv
			a0 = simd.fma(d0, d0, a0)
			a1 = simd.fma(d1, d1, a1)
		}
		for; i + 8 <= end; i += 8 {
			let d = v.load(x, i) - mv
			a0 = simd.fma(d, d, a0)
		}
		let s = simd.sum(a0 + a1)
		for; i < end; i++ {
			let d = x[i] - m
			s += d * d
		}
		return s
	}

	// Σ |x[at:at + n]|.
	internal def absSum<T: SimdFloat>(x T[], at int, n int) T {
		let v vec8<T>
		let acc = v.splat(T(0))
		let i = at
		let end = at + n
		for; i + 8 <= end; i += 8 {
			acc = acc + simd.abs(v.load(x, i))
		}
		let s = simd.sum(acc)
		for; i < end; i++ {
			s += x[i] < T(0) ?? (T(0) - x[i], x[i])
		}
		return s
	}

	// The mean and 1 / √(variance + eps) of `segs` contiguous segments of
	// `len` values (with `rms` the mean is taken as 0, so the variance is
	// the mean square), two passes over each.
	internal def segmentStats<T: SimdFloat>(x T[], segs int, len int, eps float, rms bool, means float[], invs float[]) {
		inBands(segs, segs * len, def (lo int, hi int) {
			statsBand(x, len, eps, rms, means, invs, lo, hi)
		})
	}

	internal def statsBand<T: SimdFloat>(x T[], len int, eps float, rms bool, means float[], invs float[], lo int, hi int) {
		for let s = lo; s < hi; s++ {
			let at = s * len
			let mu = rms ?? (0.0, float(segSum(x, at, len)) / float(len))
			let vr = float(segDev(x, at, len, T(mu))) / float(len)
			means[s] = mu
			invs[s] = 1.0 / math.sqrt(vr + eps)
		}
	}

	// Values of a tensor that broadcasts to a shape, for the positions
	// from an axis on: one row of them (`full` false) when the tensor is
	// the same for every index before the axis, else every position.
	internal struct Spread {
		values float[]
		full   bool
	}

	// The values of `t` spread over `shape` from `axis` on.
	// Fails when `t` does not broadcast to `shape`.
	internal def spread(c Call, t Tensor, shape int[], axis int) !Spread {
		let plan = try broadcast(shape, t.shape)
		fail c.about() + "a tensor of shape {t.shape} does not broadcast to {shape}" unless plan.shape.equals(shape)
		let lead = shape.len() - t.rank()
		let full = false
		for let d = 0; d < t.rank(); d++ {
			full = full || (d + lead < axis && t.shape[d] != 1)
		}
		let all = valuesOf(t)
		let n = full ?? (spanOf(shape, 0, shape.len()), spanOf(shape, axis, shape.len()))
		let out = Spread{full: full}
		out.values.len(n)
		for let i = 0; i < n; i++ {
			out.values[i] = all[outerIndex(plan, i)]
		}
		return out
	}

	// LayerNormalization (and RMSNormalization with `rms`): each row of
	// the dimensions from `axis` on standardized, times Scale plus B. The
	// Mean and InvStdDev outputs have the stash type.
	// Fails when the axis is out of range, Scale or B do not broadcast, or
	// the type is not a float.
	internal def layerNorm(c Call, rms bool) !none {
		let x = try c.tensor(0)
		let rank = x.rank()
		let axis = try axisOf(c, c.int("axis", -1), rank)
		let eps = float(c.float("epsilon", float32(0.00001)))
		let rows = spanOf(x.shape, 0, axis)
		let n = spanOf(x.shape, axis, rank)
		let s = try spread(c, try c.tensor(1), x.shape, axis)
		let hasBias = !rms && c.has(2)
		let b = Spread{}
		b = try spread(c, try c.tensor(2), x.shape, axis) when hasBias
		let means float[]
		let invs float[]
		means.len(rows)
		invs.len(rows)
		let y = zerosLike(x.element, x.shape)
		if x.count() > 0 {
			match storageOf(x.element) {
				case Storage.Floats:
					segmentStats(x.floats, rows, n, eps, rms, means, invs)
					normalizeRows(x.floats, y.floats, rows, n, narrowed(s.values), s.full, narrowed(b.values), b.full, hasBias, means, invs)
					roundTo(y)
				case Storage.Doubles:
					segmentStats(x.doubles, rows, n, eps, rms, means, invs)
					normalizeRows(x.doubles, y.doubles, rows, n, s.values, s.full, b.values, b.full, hasBias, means, invs)
				default:
					fail c.about() + "{x.element.name} is not a floating-point type"
			}
		}
		c.out(0, y)
		if !rms && (c.wants(1) || c.wants(2)) {
			let stash = ElementType(c.int("stash_type", 1))
			let element = (storageOf(stash) := Storage.Floats || Storage.Doubles) ?? (stash, ElementType.Float)
			let shape = x.shape.clone()
			for let d = axis; d < rank; d++ {
				shape[d] = 1
			}
			c.out(1, tensorFrom(element, shape, means))
			c.out(2, tensorFrom(element, shape, invs))
		}
		return none
	}

	internal def normalizeRows<T: SimdFloat>(x T[], y T[], rows int, n int, s T[], sFull bool, b T[], bFull bool, hasBias bool, means float[], invs float[]) {
		inBands(rows, rows * n, def (lo int, hi int) {
			normalizeBand(x, y, n, s, sFull, b, bFull, hasBias, means, invs, lo, hi)
		})
	}

	// y = (x − mean) · inv · scale (+ bias) for rows lo to hi.
	internal def normalizeBand<T: SimdFloat>(x T[], y T[], n int, s T[], sFull bool, b T[], bFull bool, hasBias bool, means float[], invs float[], lo int, hi int) {
		let v vec8<T>
		for let r = lo; r < hi; r++ {
			let at = r * n
			let so = sFull ?? (at, 0)
			let bo = bFull ?? (at, 0)
			let mu = T(means[r])
			let inv = T(invs[r])
			let mv = v.splat(mu)
			let iv = v.splat(inv)
			let i = 0
			for; i + 8 <= n; i += 8 {
				let d = (v.load(x, at + i) - mv) * iv * v.load(s, so + i)
				d = d + v.load(b, bo + i) when hasBias
				d.store(y, at + i)
			}
			for; i < n; i++ {
				let d = (x[at + i] - mu) * inv * s[so + i]
				y[at + i] = hasBias ?? (d + b[bo + i], d)
			}
		}
	}

	// y = x · a + b with a and b of `statShape` broadcast to x.
	// Fails when the shapes do not broadcast or x is not a float tensor.
	internal def affine(x Tensor, a float[], b float[], statShape int[]) !Tensor {
		let y = zerosLike(x.element, x.shape)
		return y when y.count() == 0
		let plan = try broadcast(x.shape, statShape)
		match storageOf(x.element) {
			case Storage.Floats:
				let fa = narrowed(a)
				let fb = narrowed(b)
				runBlocks(plan, def (o int, from int, n int) {
					affineBlock(x.floats, plan.aOffsets[o] + from * plan.aStep, fa, fb, plan.bOffsets[o] + from * plan.bStep, plan.bStep, y.floats, o * plan.inner + from, n)
				})
				roundTo(y)
			case Storage.Doubles:
				runBlocks(plan, def (o int, from int, n int) {
					affineBlock(x.doubles, plan.aOffsets[o] + from * plan.aStep, a, b, plan.bOffsets[o] + from * plan.bStep, plan.bStep, y.doubles, o * plan.inner + from, n)
				})
			default:
				fail "onnx: {x.element.name} is not a floating-point type"
		}
		return y
	}

	// y[yo + i] = x[xo + i] · a[so + i · sStep] + b[so + i · sStep].
	internal def affineBlock<T: SimdFloat>(x T[], xo int, a T[], b T[], so int, sStep int, y T[], yo int, n int) {
		let v vec8<T>
		let i = 0
		if sStep == 0 {
			let av = v.splat(a[so])
			let bv = v.splat(b[so])
			for; i + 8 <= n; i += 8 {
				simd.fma(v.load(x, xo + i), av, bv).store(y, yo + i)
			}
		} else {
			for; i + 8 <= n; i += 8 {
				simd.fma(v.load(x, xo + i), v.load(a, so + i), v.load(b, so + i)).store(y, yo + i)
			}
		}
		for; i < n; i++ {
			y[yo + i] = x[xo + i] * a[so + i * sStep] + b[so + i * sStep]
		}
	}

	// The shape of per-channel statistics of x: [1, C, 1, ...].
	internal def channelShape(x Tensor) int[] {
		let shape int[]
		for let d = 0; d < x.rank(); d++ {
			shape.push(d == 1 ?? (x.shape[1], 1))
		}
		return shape
	}

	// GroupNormalization and InstanceNormalization (a group per channel):
	// each instance's group of channels standardized, then scaled and
	// shifted per channel (per group in GroupNormalization before opset
	// 21).
	// Fails when the input has no channel dimension, the groups do not
	// divide the channels, or scale and bias have the wrong size.
	internal def groupNorm(c Call, instance bool) !none {
		let x = try c.tensor(0)
		let rank = x.rank()
		fail c.about() + "the input needs a channel dimension" unless rank >= 2
		let batch = x.shape[0]
		let channels = x.shape[1]
		let spatial = spanOf(x.shape, 2, rank)
		let groups = instance ?? (channels, c.int("num_groups", 0))
		fail c.about() + "{groups} groups do not divide {channels} channels" unless groups > 0 && channels % groups == 0
		let eps = float(c.float("epsilon", float32(0.00001)))
		let scale = valuesOf(try c.tensor(1))
		let bias = valuesOf(try c.tensor(2))
		let perGroup = !instance && c.opset < 21
		let params = perGroup ?? (groups, channels)
		fail c.about() + "scale and bias need {params} values" unless scale.len() == params && bias.len() == params
		let per = channels / groups
		let segs = batch * groups
		let means float[]
		let invs float[]
		means.len(segs)
		invs.len(segs)
		if x.count() > 0 {
			match storageOf(x.element) {
				case Storage.Floats:
					segmentStats(x.floats, segs, per * spatial, eps, false, means, invs)
				case Storage.Doubles:
					segmentStats(x.doubles, segs, per * spatial, eps, false, means, invs)
				default:
					fail c.about() + "{x.element.name} is not a floating-point type"
			}
		}
		let a float[]
		let b float[]
		a.len(batch * channels)
		b.len(batch * channels)
		for let n = 0; n < batch; n++ {
			for let ch = 0; ch < channels; ch++ {
				let g = n * groups + ch / per
				let k = perGroup ?? (ch / per, ch)
				let at = n * channels + ch
				a[at] = scale[k] * invs[g]
				b[at] = bias[k] - means[g] * a[at]
			}
		}
		let statShape = channelShape(x)
		statShape[0] = batch
		c.out(0, try affine(x, a, b, statShape))
		return none
	}

	// BatchNormalization: x normalized per channel (per value of C × D...
	// with spatial = 0 before opset 9) by the given mean and variance, or
	// in training mode by the batch's, which also update the running
	// statistics: training_mode from opset 14, before it when the node
	// asks for the statistics outputs (and is_test is not set).
	// Fails when the input has no channel dimension or the parameters
	// have the wrong size.
	internal def batchNorm(c Call) !none {
		let x = try c.tensor(0)
		let rank = x.rank()
		fail c.about() + "the input needs a channel dimension" unless rank >= 2
		let eps = float(c.float("epsilon", float32(0.00001)))
		let momentum = float(c.float("momentum", float32(0.9)))
		let scale = valuesOf(try c.tensor(1))
		let bias = valuesOf(try c.tensor(2))
		let meanIn = try c.tensor(3)
		let varIn = try c.tensor(4)
		let statShape = channelShape(x)
		if c.opset < 9 && c.int("spatial", 1) == 0 {
			statShape = x.shape.clone()
			statShape[0] = 1
		}
		let features = spanOf(statShape, 0, rank)
		fail c.about() + "scale, B, mean and var need {features} values" unless scale.len() == features && bias.len() == features && meanIn.count() == features && varIn.count() == features
		let training = false
		if c.opset >= 14 {
			training = c.int("training_mode", 0) != 0
		} else {
			training = (c.wants(1) || c.wants(2) || c.wants(3) || c.wants(4)) && !(c.opset < 7 && c.int("is_test", 0) != 0)
		}
		let mean = valuesOf(meanIn)
		let variance = valuesOf(varIn)
		if training {
			let reduce bool[]
			for let d = 0; d < rank; d++ {
				reduce.push(statShape[d] == 1)
			}
			let count = x.count() / features
			let sums = valuesOf(folded(x, reduce, Fold.Sum, Pre.None))
			let ones float[]
			let shift float[]
			ones.len(features)
			shift.len(features)
			ones.fill(1.0)
			for let f = 0; f < features; f++ {
				shift[f] = -sums[f] / float(count)
			}
			let deviations = valuesOf(folded(try affine(x, ones, shift, statShape), reduce, Fold.Sum, Pre.Square))
			let batchMean float[]
			let batchVar float[]
			let runMean float[]
			let runVar float[]
			for let f = 0; f < features; f++ {
				batchMean.push(-shift[f])
				batchVar.push(deviations[f] / float(count))
				runMean.push(mean[f] * momentum + batchMean[f] * (1.0 - momentum))
				runVar.push(variance[f] * momentum + batchVar[f] * (1.0 - momentum))
			}
			c.out(1, tensorFrom(meanIn.element, meanIn.shape, runMean))
			c.out(2, tensorFrom(varIn.element, varIn.shape, runVar))
			if c.opset < 14 {
				c.out(3, tensorFrom(meanIn.element, meanIn.shape, batchMean))
				c.out(4, tensorFrom(varIn.element, varIn.shape, batchVar))
			}
			mean = batchMean
			variance = batchVar
		}
		let a float[]
		let b float[]
		for let f = 0; f < features; f++ {
			a.push(scale[f] / math.sqrt(variance[f] + eps))
			b.push(bias[f] - mean[f] * a[f])
		}
		c.out(0, try affine(x, a, b, statShape))
		return none
	}

	// LpNormalization: x divided by its L1 or L2 norm along `axis` (0
	// where the norm is 0).
	// Fails when the axis is out of range, p is not 1 or 2, or the type is
	// not a float.
	internal def lpNorm(c Call) !none {
		let t = try c.tensor(0)
		let a = splitAt(t.shape, try axisOf(c, c.int("axis", -1), t.rank()))
		let p = c.int("p", 2)
		fail c.about() + "p must be 1 or 2, not {p}" unless p := 1 || 2
		let out = zerosLike(t.element, t.shape)
		if out.count() > 0 {
			match storageOf(t.element) {
				case Storage.Floats:
					lpRows(t.floats, out.floats, a, p == 2)
					roundTo(out)
				case Storage.Doubles:
					lpRows(t.doubles, out.doubles, a, p == 2)
				default:
					fail c.about() + "{t.element.name} is not a floating-point type"
			}
		}
		c.out(0, out)
		return none
	}

	internal def lpRows<T: SimdFloat>(x T[], y T[], a Axis3, l2 bool) {
		inSlices(a, def (lo int, hi int, jlo int, jhi int) {
			lpBand(x, y, a, l2, lo, hi, jlo, jhi)
		})
	}

	// The norms of slices lo to hi (of a contiguous row, or of eight
	// columns at a time), then each value times the norm's reciprocal.
	internal def lpBand<T: SimdFloat>(x T[], y T[], a Axis3, l2 bool, lo int, hi int, jlo int, jhi int) {
		let n = a.n
		let inner = a.inner
		let v vec8<T>
		let norm T[]
		norm.len(inner)
		for let o = lo; o < hi; o++ {
			let base = o * n * inner
			if inner == 1 {
				let s = l2 ?? (T(math.sqrt(float(segDev(x, base, n, T(0))))), absSum(x, base, n))
				let r = s == T(0) ?? (T(0), T(1) / s)
				let rv = v.splat(r)
				let i = 0
				for; i + 8 <= n; i += 8 {
					(v.load(x, base + i) * rv).store(y, base + i)
				}
				for; i < n; i++ {
					y[base + i] = x[base + i] * r
				}
				continue
			}
			norm.fill(T(0))
			for let k = 0; k < n; k++ {
				let row = base + k * inner
				let j = jlo
				for; j + 8 <= jhi; j += 8 {
					let e = v.load(x, row + j)
					if l2 {
						simd.fma(e, e, v.load(norm, j)).store(norm, j)
					} else {
						(v.load(norm, j) + simd.abs(e)).store(norm, j)
					}
				}
				for; j < jhi; j++ {
					let e = x[row + j]
					norm[j] += l2 ?? (e * e, e < T(0) ?? (T(0) - e, e))
				}
			}
			for let j = jlo; j < jhi; j++ {
				let r = l2 ?? (T(math.sqrt(float(norm[j]))), norm[j])
				norm[j] = r == T(0) ?? (T(0), T(1) / r)
			}
			for let k = 0; k < n; k++ {
				let row = base + k * inner
				let j = jlo
				for; j + 8 <= jhi; j += 8 {
					(v.load(x, row + j) * v.load(norm, j)).store(y, row + j)
				}
				for; j < jhi; j++ {
					y[row + j] = x[row + j] * norm[j]
				}
			}
		}
	}

	// MeanVarianceNormalization: (x − E[x]) / (√(E[x²] − E[x]²) + 1e-9)
	// over `axes`, as the operator's function body computes it.
	// Fails when an axis is out of range or the type is not a float.
	internal def meanVariance(c Call) !none {
		let x = try c.tensor(0)
		let rank = x.rank()
		let reduce bool[]
		reduce.len(rank)
		for let (_, axis) in c.ints("axes", int[0, 2, 3]) {
			let d = try axisOf(c, axis, rank)
			reduce[d] = true
		}
		let lay = layoutOf(x.shape, reduce)
		let count = float(lay.outCount == 0 ?? (0, lay.inCount / lay.outCount))
		let sums = valuesOf(folded(x, reduce, Fold.Sum, Pre.None))
		let squares = valuesOf(folded(x, reduce, Fold.Sum, Pre.Square))
		let a float[]
		let b float[]
		for let i = 0; i < sums.len(); i++ {
			let m = sums[i] / count
			let sd = math.sqrt((squares[i] / count - m * m).max(0.0)) + 0.000000001
			a.push(1.0 / sd)
			b.push(-m / sd)
		}
		c.out(0, try affine(x, a, b, lay.outShape))
		return none
	}

	// The channels before and after each one LRN sums over, and its
	// constants (scale is alpha / size).
	internal struct LrnWindow {
		before int
		after  int
		scale  float
		beta   float
		bias   float
	}

	// LRN: x / (bias + alpha / size · Σ x²)^beta, the sum over the
	// channels from (size − 1) / 2 before each one to size / 2 after.
	// Fails when the input has no channel dimension, size is not
	// positive, or the type is not a float.
	internal def lrn(c Call) !none {
		let x = try c.tensor(0)
		let rank = x.rank()
		fail c.about() + "the input needs a channel dimension" unless rank >= 2
		let size = c.int("size", 0)
		fail c.about() + "size must be positive" unless size > 0
		let alpha = float(c.float("alpha", float32(0.0001)))
		let window = LrnWindow{before: (size - 1) / 2, after: size / 2, scale: alpha / float(size), beta: float(c.float("beta", float32(0.75))), bias: float(c.float("bias", float32(1)))}
		let a = Axis3{outer: x.shape[0], n: x.shape[1], inner: spanOf(x.shape, 2, rank)}
		let out = zerosLike(x.element, x.shape)
		if out.count() > 0 {
			match storageOf(x.element) {
				case Storage.Floats:
					lrnRows(x.floats, out.floats, a, window)
					roundTo(out)
				case Storage.Doubles:
					lrnRows(x.doubles, out.doubles, a, window)
				default:
					fail c.about() + "{x.element.name} is not a floating-point type"
			}
		}
		c.out(0, out)
		return none
	}

	internal def lrnRows<T: SimdFloat>(x T[], y T[], a Axis3, w LrnWindow) {
		let rows = a.outer * a.n
		inBands(rows, rows * a.inner, def (lo int, hi int) {
			lrnBand(x, y, a, w, lo, hi)
		})
	}

	// Channels lo to hi (counted over the batch): the window's squares
	// summed eight positions at a time, the power as exp(−beta · log).
	internal def lrnBand<T: SimdFloat>(x T[], y T[], a Axis3, w LrnWindow, lo int, hi int) {
		let s = a.inner
		let v vec8<T>
		let scale = v.splat(T(w.scale))
		let bias = v.splat(T(w.bias))
		let negBeta = v.splat(T(-w.beta))
		for let r = lo; r < hi; r++ {
			let image = r / a.n
			let ch = r % a.n
			let first = (ch - w.before).max(0)
			let end = (ch + w.after).min(a.n - 1)
			let at = r * s
			let j = 0
			for; j + 8 <= s; j += 8 {
				let sum = v.splat(T(0))
				for let k = first; k <= end; k++ {
					let e = v.load(x, (image * a.n + k) * s + j)
					sum = simd.fma(e, e, sum)
				}
				let base = simd.fma(sum, scale, bias)
				(v.load(x, at + j) * simd.exp(negBeta * simd.log(base))).store(y, at + j)
			}
			for; j < s; j++ {
				let sum = 0.0
				for let k = first; k <= end; k++ {
					let e = float(x[(image * a.n + k) * s + j])
					sum += e * e
				}
				y[at + j] = T(float(x[at + j]) / (w.bias + w.scale * sum) ** w.beta)
			}
		}
	}

	// Det: the determinants of the input's trailing square matrices, by
	// LU decomposition with partial pivoting in float64.
	// Fails when the input is not a batch of square matrices or not of a
	// float type.
	internal def det(c Call) !none {
		let x = try c.tensor(0)
		let rank = x.rank()
		fail c.about() + "the input needs two dimensions" unless rank >= 2
		let m = x.shape[rank - 1]
		fail c.about() + "the matrices are {x.shape[rank - 2]} × {m}, not square" unless x.shape[rank - 2] == m
		fail c.about() + "{x.element.name} is not a floating-point type" unless storageOf(x.element) := Storage.Floats || Storage.Doubles
		let shape = x.shape[:rank - 2].clone()
		let count = spanOf(shape, 0, shape.len())
		let values = valuesOf(x)
		let out float[]
		out.len(count)
		inBands(count, count * m * m * m, def (lo int, hi int) {
			for let k = lo; k < hi; k++ {
				out[k] = determinant(values, k * m * m, m)
			}
		})
		c.out(0, tensorFrom(x.element, shape, out))
		return none
	}

	// The determinant of the m × m matrix at v[at].
	internal def determinant(v float[], at int, m int) float {
		let a = v[at:at + m * m].clone()
		let d = 1.0
		let w vec4<float>
		for let k = 0; k < m; k++ {
			let pivot = k
			for let i = k + 1; i < m; i++ {
				pivot = a[i * m + k].abs() > a[pivot * m + k].abs() ?? (i, pivot)
			}
			let p = a[pivot * m + k]
			return p when p == 0.0 || p != p
			if pivot != k {
				for let j = k; j < m; j++ {
					let t = a[k * m + j]
					a[k * m + j] = a[pivot * m + j]
					a[pivot * m + j] = t
				}
				d = -d
			}
			d *= p
			for let i = k + 1; i < m; i++ {
				let f = a[i * m + k] / p
				continue when f == 0.0
				let fv = w.splat(f)
				let j = k + 1
				for; j + 4 <= m; j += 4 {
					(w.load(a, i * m + j) - fv * w.load(a, k * m + j)).store(a, i * m + j)
				}
				for; j < m; j++ {
					a[i * m + j] -= f * a[k * m + j]
				}
			}
		}
		return d
	}
}
