partial module std.ai.onnx {
	use (
		std.simd
		std.crypto
		std.formats.ai.onnx::(ElementType, TensorData, SparseTensorData, Attribute, elementBits)
		std.ai.tensor::(Tensor, tensorOf, storageOf, Storage)
	)

	// Runs the data movement, shape and indexing operators; false for an operator this family does not have.
	// Fails when the operator fails on its inputs.
	internal def applyShapes(c Call) !bool {
		match c.step.op {
			case "Reshape":
				try reshape(c)
			case "Flatten":
				try flatten(c)
			case "Squeeze":
				try squeeze(c)
			case "Unsqueeze":
				try unsqueeze(c)
			case "Transpose":
				try transpose(c)
			case "Concat":
				try concat(c)
			case "Split":
				try split(c)
			case "Slice":
				try slice(c)
			case "Gather":
				try gather(c)
			case "GatherElements":
				try gatherElements(c)
			case "GatherND":
				try gatherND(c)
			case "ScatterElements", "Scatter":
				try scatterElements(c)
			case "ScatterND":
				try scatterND(c)
			case "TensorScatter":
				try tensorScatter(c)
			case "Expand":
				try expand(c)
			case "Tile":
				try tile(c)
			case "Pad":
				try pad(c)
			case "Shape":
				try shapeOf(c)
			case "Size":
				c.out(0, new Tensor(int[], int[(try c.tensor(0)).count()]))
			case "ConstantOfShape":
				try constantOfShape(c)
			case "Constant":
				try constant(c)
			case "Range":
				try range(c)
			case "EyeLike":
				try eyeLike(c)
			case "OneHot":
				try oneHot(c)
			case "Trilu":
				try trilu(c)
			case "Compress":
				try compress(c)
			case "NonZero":
				try nonZero(c)
			case "Unique":
				try unique(c)
			case "ReverseSequence":
				try reverseSequence(c)
			case "DepthToSpace":
				try depthToSpace(c)
			case "SpaceToDepth":
				try spaceToDepth(c)
			case "CenterCropPad":
				try centerCropPad(c)
			case "Dropout":
				try dropout(c)
			case "BitCast":
				try bitCast(c)
			default:
				return false
		}
		return true
	}

	// Runs from which a contiguous move copies through a slice view
	// instead of value by value (a view costs about as much as 64 values).
	const copyFrom = 64

	// The row-major strides of `shape`, in values.
	internal def stridesOf(shape int[]) int[] {
		let s int[]
		s.len(shape.len())
		let n = 1
		for let k = shape.len() - 1; k >= 0; k-- {
			s[k] = n
			n *= shape[k]
		}
		return s
	}

	// The product of `dims[from:to]`.
	internal def product(dims int[], from int, to int) int {
		let n = 1
		for let k = from; k < to; k++ {
			n *= dims[k]
		}
		return n
	}

	// `axis` counted from the front of `rank` dimensions.
	// Fails when it is outside them.
	internal def axisOf(c Call, axis int, rank int) !int {
		let a = axis < 0 ?? (axis + rank, axis)
		fail c.about() + "axis {axis} is outside rank {rank}" unless a >= 0 && a < rank
		return a
	}

	// `t`'s values seen with another shape: no copy, the arrays shared
	// (operators never change their inputs).
	internal def reshaped(t Tensor, shape int[]) Tensor {
		let v = new Tensor(shape, t.floats, t.element)
		v.doubles = t.doubles
		v.ints = t.ints
		v.strings = t.strings
		return v
	}

	// Moves `n` values of `a` from `ai` by `aStep` to `b` from `bi` by
	// `bStep`: contiguous runs through a slice copy, a repeated value as a
	// fill.
	internal def moveIn<T>(a T[], ai int, aStep int, b T[], bi int, bStep int, n int) {
		if n >= copyFrom && bStep == 1 {
			if aStep == 1 {
				a[ai:ai + n].copy(b[bi:bi + n])
				return
			}
			if aStep == 0 {
				b[bi:bi + n] = a[ai]
				return
			}
		}
		if aStep == 1 && bStep == 1 {
			for let i = 0; i < n; i++ {
				b[bi + i] = a[ai + i]
			}
			return
		}
		for let i = 0; i < n; i++ {
			b[bi + i * bStep] = a[ai + i * aStep]
		}
	}

	// Moves one row of `n` values of `src` (from `si`, by `ss`) to `dst`
	// (from `di`, by `ds`); both of one storage.
	internal def moveRow(src Tensor, si int, ss int, dst Tensor, di int, ds int, n int) {
		match storageOf(dst.element) {
			case Storage.Floats:
				moveIn(src.floats, si, ss, dst.floats, di, ds, n)
			case Storage.Doubles:
				moveIn(src.doubles, si, ss, dst.doubles, di, ds, n)
			case Storage.Ints:
				moveIn(src.ints, si, ss, dst.ints, di, ds, n)
			default:
				moveIn(src.strings, si, ss, dst.strings, di, ds, n)
		}
	}

	// Moves `n` values of `src` at `si + places[j]` (j < n) to `dst` from `di`.
	internal def gatherRow(src Tensor, si int, places int[], dst Tensor, di int, n int) {
		match storageOf(dst.element) {
			case Storage.Floats:
				for let j = 0; j < n; j++ {
					dst.floats[di + j] = src.floats[si + places[j]]
				}
			case Storage.Doubles:
				for let j = 0; j < n; j++ {
					dst.doubles[di + j] = src.doubles[si + places[j]]
				}
			case Storage.Ints:
				for let j = 0; j < n; j++ {
					dst.ints[di + j] = src.ints[si + places[j]]
				}
			default:
				for let j = 0; j < n; j++ {
					dst.strings[di + j] = src.strings[si + places[j]]
				}
		}
	}

	// Runs `band(from, to)` over `rows` rows split in bands on several
	// tasks when `work` (the values they move) is large.
	internal def inBands(rows int, work int, band def(int, int)) {
		let tasks = (work / parallelFrom).clamp(1, 32).min(rows)
		if tasks <= 1 {
			band(0, rows)
			return
		}
		forall let t in 0..tasks {
			band(rows * t / tasks, rows * (t + 1) / tasks)
		}
	}

	// Copies a block of `dims` values from `src` (at `sBase`, by
	// `sStrides` per dimension, 0 to repeat) to `dst` (at `dBase`, by
	// `dStrides`), as rows of the dimensions merged where both sides are
	// contiguous, over several tasks for a large block.
	internal def copyBlock(src Tensor, sBase int, sStrides int[], dst Tensor, dBase int, dStrides int[], dims int[]) {
		let total = product(dims, 0, dims.len())
		return when total == 0
		let d int[]
		let ss int[]
		let ds int[]
		for let k = 0; k < dims.len(); k++ {
			continue when dims[k] == 1
			let r = d.len()
			if r > 0 && ss[r - 1] == sStrides[k] * dims[k] && ds[r - 1] == dStrides[k] * dims[k] {
				d[r - 1] *= dims[k]
				ss[r - 1] = sStrides[k]
				ds[r - 1] = dStrides[k]
			} else {
				d.push(dims[k])
				ss.push(sStrides[k])
				ds.push(dStrides[k])
			}
		}
		if d.len() == 0 {
			moveRow(src, sBase, 0, dst, dBase, 0, 1)
			return
		}
		let r = d.len()
		let inner = d[r - 1]
		let rows = total / inner
		if rows == 1 {
			// One long run: split it.
			let sStep = ss[0]
			let dStep = ds[0]
			inBands(inner, inner, def (from int, to int) {
				moveRow(src, sBase + from * sStep, sStep, dst, dBase + from * dStep, dStep, to - from)
			})
			return
		}
		inBands(rows, total, def (from int, to int) {
			copyRows(src, sBase, ss, dst, dBase, ds, d, from, to)
		})
	}

	// Rows `from` to `to` of a block `copyBlock` simplified.
	internal def copyRows(src Tensor, sBase int, ss int[], dst Tensor, dBase int, ds int[], d int[], from int, to int) {
		let r = d.len()
		let index int[]
		index.len(r - 1)
		let rest = from
		let so = sBase
		let dOff = dBase
		for let k = r - 2; k >= 0; k-- {
			index[k] = rest % d[k]
			rest /= d[k]
			so += index[k] * ss[k]
			dOff += index[k] * ds[k]
		}
		let inner = d[r - 1]
		let sStep = ss[r - 1]
		let dStep = ds[r - 1]
		for let row = from; row < to; row++ {
			moveRow(src, so, sStep, dst, dOff, dStep, inner)
			for let k = r - 2; k >= 0; k-- {
				index[k]++
				so += ss[k]
				dOff += ds[k]
				break when index[k] < d[k]
				so -= ss[k] * d[k]
				dOff -= ds[k] * d[k]
				index[k] = 0
			}
		}
	}

	// `t` seen with `shape` and its dimensions put in the order `perm`
	// (output dimension k is dimension perm[k]), copied.
	internal def permuted(t Tensor, shape int[], perm int[]) Tensor {
		let strides = stridesOf(shape)
		let dims int[]
		let ss int[]
		for let (_, p) in perm {
			dims.push(shape[p])
			ss.push(strides[p])
		}
		let out = zerosLike(t.element, dims)
		copyBlock(t, 0, ss, out, 0, stridesOf(dims), dims)
		return out
	}

	// The integer values of optional input `i`, `otherwise` when absent.
	internal def intsOr(c Call, i int, otherwise int[]) !int[] {
		return otherwise unless c.has(i)
		return c.ints(i)
	}

	// Reshape: the input's values with the shape the second input (the
	// `shape` attribute before opset 5) gives; 0 keeps the input's size
	// (unless `allowzero`), -1 takes the rest.
	internal def reshape(c Call) !none {
		let t = try c.tensor(0)
		let wanted = c.opset < 5 ?? (c.ints("shape", int[]), try c.ints(1))
		let allowZero = c.int("allowzero", 0) == 1
		let shape int[]
		let known = 1
		let infer = -1
		for let (k, s) in wanted {
			let dim = s
			if s == 0 && !allowZero {
				fail c.about() + "dimension {k} copies one the input does not have" unless k < t.rank()
				dim = t.shape[k]
			}
			if dim == -1 {
				fail c.about() + "two dimensions are -1" unless infer < 0
				infer = k
			} else {
				fail c.about() + "dimension {dim}" unless dim >= 0
				known *= dim
			}
			shape.push(dim)
		}
		let n = t.count()
		if infer >= 0 {
			fail c.about() + "{n} values do not fill {wanted}" unless known != 0 && n % known == 0
			shape[infer] = n / known
		}
		fail c.about() + "{n} values do not make shape {shape}" unless product(shape, 0, shape.len()) == n
		c.out(0, reshaped(t, shape))
		return none
	}

	// Flatten: a matrix of the dimensions before `axis` by those from it.
	internal def flatten(c Call) !none {
		let t = try c.tensor(0)
		let axis = c.int("axis", 1)
		axis += axis < 0 ?? (t.rank(), 0)
		fail c.about() + "axis {axis}" unless axis >= 0 && axis <= t.rank()
		c.out(0, reshaped(t, int[product(t.shape, 0, axis), product(t.shape, axis, t.rank())]))
		return none
	}

	// The axes of Squeeze and Unsqueeze: an attribute before opset 13, an
	// input from it.
	internal def axesOf(c Call) !int[] {
		return c.opset < 13 ?? (c.ints("axes", int[]), try intsOr(c, 1, int[]))
	}

	// Squeeze: the input without the given dimensions of size 1 (all of
	// them when none are given).
	internal def squeeze(c Call) !none {
		let t = try c.tensor(0)
		let axes = try axesOf(c)
		let drop bool[]
		drop.len(t.rank())
		for let (_, a) in axes {
			let k = try axisOf(c, a, t.rank())
			fail c.about() + "dimension {k} is {t.shape[k]}, not 1" unless t.shape[k] == 1
			drop[k] = true
		} empty {
			for let (k, d) in t.shape {
				drop[k] = d == 1
			}
		}
		let shape int[]
		for let (k, d) in t.shape {
			shape.push(d) unless drop[k]
		}
		c.out(0, reshaped(t, shape))
		return none
	}

	// Unsqueeze: the input with dimensions of size 1 at the given places
	// of the output.
	internal def unsqueeze(c Call) !none {
		let t = try c.tensor(0)
		let axes = try axesOf(c)
		let rank = t.rank() + axes.len()
		let added bool[]
		added.len(rank)
		for let (_, a) in axes {
			let k = try axisOf(c, a, rank)
			fail c.about() + "axis {a} given twice" when added[k]
			added[k] = true
		}
		let shape int[]
		let next = 0
		for let k = 0; k < rank; k++ {
			if added[k] {
				shape.push(1)
			} else {
				shape.push(t.shape[next])
				next++
			}
		}
		c.out(0, reshaped(t, shape))
		return none
	}

	// Transpose: the dimensions in the order `perm` (reversed by default).
	internal def transpose(c Call) !none {
		let t = try c.tensor(0)
		let perm = c.ints("perm", int[]).clone()
		if perm.len() == 0 {
			for let k = t.rank() - 1; k >= 0; k-- {
				perm.push(k)
			}
		}
		fail c.about() + "perm {perm} for rank {t.rank()}" unless perm.len() == t.rank()
		let seen bool[]
		seen.len(t.rank())
		for let (i, p) in perm {
			let k = try axisOf(c, p, t.rank())
			fail c.about() + "perm {perm} repeats {p}" when seen[k]
			seen[k] = true
			perm[i] = k
		}
		c.out(0, permuted(t, t.shape, perm))
		return none
	}

	// Concat: the inputs joined along `axis`.
	internal def concat(c Call) !none {
		let first = try c.tensor(0)
		let rank = first.rank()
		let axis = try axisOf(c, c.int("axis", c.opset < 4 ?? (1, 0)), rank)
		let shape = first.shape.clone()
		shape[axis] = 0
		let parts Tensor[]
		for let i = 0; i < c.inputs.len(); i++ {
			let t = try c.tensor(i)
			fail c.about() + "input {i + 1} is {t.element.name}, not {first.element.name}" unless t.element == first.element
			fail c.about() + "input {i + 1} has rank {t.rank()}, not {rank}" unless t.rank() == rank
			for let k = 0; k < rank; k++ {
				fail c.about() + "input {i + 1} has shape {t.shape}, not {first.shape} off the axis" unless k == axis || t.shape[k] == first.shape[k]
			}
			shape[axis] += t.shape[axis]
			parts.push(t)
		}
		let out = zerosLike(first.element, shape)
		let strides = stridesOf(shape)
		let at = 0
		for let (_, t) in parts {
			copyBlock(t, 0, stridesOf(t.shape), out, at * strides[axis], strides, t.shape)
			at += t.shape[axis]
		}
		c.out(0, out)
		return none
	}

	// Split: the input cut along `axis` into the outputs, by the sizes
	// `split` gives (an attribute before opset 13, an input from it), else
	// into `num_outputs` (opset 18) or as many outputs as the node has,
	// equal but for a smaller last part.
	internal def split(c Call) !none {
		let t = try c.tensor(0)
		let axis = try axisOf(c, c.int("axis", 0), t.rank())
		let dim = t.shape[axis]
		let sizes = c.opset < 13 && !c.has(1) ?? (c.ints("split", int[]).clone(), try intsOr(c, 1, int[]))
		let n = c.outputs.len()
		if sizes.len() == 0 {
			let parts = c.int("num_outputs", n)
			fail c.about() + "{parts} parts for {n} outputs" unless parts == n && parts > 0
			fail c.about() + "dimension {dim} does not split into {parts}" unless c.opset >= 18 || dim % parts == 0
			let each = (dim + parts - 1) / parts
			for let i = 0; i < parts; i++ {
				sizes.push(each.min(dim - each * i).max(0))
			}
		}
		fail c.about() + "{sizes.len()} sizes for {n} outputs" unless sizes.len() == n
		let total = 0
		for let (_, s) in sizes {
			total += s
		}
		fail c.about() + "sizes {sizes} do not add up to {dim}" unless total == dim
		let strides = stridesOf(t.shape)
		let at = 0
		for let (i, s) in sizes {
			let shape = t.shape.clone()
			shape[axis] = s
			if c.wants(i) {
				let out = zerosLike(t.element, shape)
				copyBlock(t, at * strides[axis], strides, out, 0, stridesOf(shape), shape)
				c.out(i, out)
			}
			at += s
		}
		return none
	}

	// Slice: per axis the values from `starts` to `ends` by `steps`
	// (attributes before opset 10, inputs from it), clamped to the
	// dimension as numpy does.
	internal def slice(c Call) !none {
		let t = try c.tensor(0)
		let layout = try sliceLayout(c, t.shape)
		let out = zerosLike(t.element, layout.shape)
		copyBlock(t, layout.base, layout.strides, out, 0, stridesOf(layout.shape), layout.shape)
		c.out(0, out)
		return none
	}

	// What a Slice of a tensor of `shape` reads: its output shape, and
	// where and with which strides (per axis, in values) it reads the input.
	internal struct SliceLayout {
		shape   int[]
		base    int
		strides int[]
	}

	// The layout of `c`'s Slice of a tensor of `shape`: starts, ends,
	// axes and steps from the inputs (attributes before opset 10), clamped
	// as ONNX says.
	// Fails when they do not match each other or the rank.
	internal def sliceLayout(c Call, input int[]) !SliceLayout {
		let rank = input.len()
		let starts int[]
		let ends int[]
		let axes int[]
		let steps int[]
		if c.opset < 10 {
			starts = c.ints("starts", int[])
			ends = c.ints("ends", int[])
			axes = c.ints("axes", int[]).clone()
		} else {
			starts = try c.ints(1)
			ends = try c.ints(2)
			axes = (try intsOr(c, 3, int[])).clone()
			steps = try intsOr(c, 4, int[])
		}
		fail c.about() + "{starts.len()} starts, {ends.len()} ends" unless starts.len() == ends.len()
		if axes.len() == 0 {
			for let k = 0; k < starts.len(); k++ {
				axes.push(k)
			}
		}
		fail c.about() + "{axes.len()} axes for {starts.len()} starts" unless axes.len() == starts.len()
		fail c.about() + "{steps.len()} steps for {starts.len()} starts" unless steps.len() == 0 || steps.len() == starts.len()
		let shape = input.clone()
		let strides = stridesOf(input)
		let sStrides = strides.clone()
		let base = 0
		let seen bool[]
		seen.len(rank)
		for let (i, a) in axes {
			let k = try axisOf(c, a, rank)
			fail c.about() + "axis {a} given twice" when seen[k]
			seen[k] = true
			let step = steps.len() > 0 ?? (steps[i], 1)
			fail c.about() + "step 0" when step == 0
			let dim = input[k]
			let start = starts[i] < 0 ?? (starts[i] + dim, starts[i])
			let end = ends[i] < 0 ?? (ends[i] + dim, ends[i])
			let count = 0
			if step > 0 {
				start = start.clamp(0, dim)
				end = end.clamp(0, dim)
				count = end > start ?? ((end - start + step - 1) / step, 0)
			} else {
				start = start.clamp(-1, dim - 1)
				end = end.clamp(-1, dim - 1)
				count = start > end ?? ((start - end - step - 1) / - step, 0)
			}
			shape[k] = count
			base += count > 0 ?? (start * strides[k], 0)
			sStrides[k] = strides[k] * step
		}
		return SliceLayout{shape: shape, base: base, strides: sStrides}
	}

	// `indices` checked against a dimension of `dim` values, negative ones
	// counted from its end.
	// Fails when one is outside it.
	internal def indicesIn(c Call, indices int[], dim int) !int[] {
		let out int[]
		out.len(indices.len())
		for let (i, v) in indices {
			let k = v < 0 ?? (v + dim, v)
			fail c.about() + "index {v} is outside a dimension of {dim}" unless k >= 0 && k < dim
			out[i] = k
		}
		return out
	}

	// Gather: the slices of the data along `axis` the indices pick, in the
	// indices' shape.
	internal def gather(c Call) !none {
		let data = try c.tensor(0)
		let index = try c.tensor(1)
		let axis = try axisOf(c, c.int("axis", 0), data.rank())
		let dim = data.shape[axis]
		let picks = try indicesIn(c, intValues(index), dim)
		let shape = data.shape.slice(0, axis).clone()
		shape += index.shape
		for let k = axis + 1; k < data.rank(); k++ {
			shape.push(data.shape[k])
		}
		let out = zerosLike(data.element, shape)
		let outer = product(data.shape, 0, axis)
		let inner = product(data.shape, axis + 1, data.rank())
		let n = picks.len()
		inBands(outer * n, outer * n * inner, def (from int, to int) {
			for let r = from; r < to; r++ {
				moveRow(data, (r / n * dim + picks[r % n]) * inner, 1, out, r * inner, 1, inner)
			}
		})
		c.out(0, out)
		return none
	}

	// The data offset of each value of a tensor of `shape` (the indices of
	// GatherElements and ScatterElements) with its coordinate on `axis`
	// replaced by `picks`.
	internal def elementOffsets(shape int[], dataShape int[], axis int, picks int[]) int[] {
		let n = picks.len()
		let offsets int[]
		offsets.len(n)
		let rank = shape.len()
		return offsets when n == 0
		let ds = stridesOf(dataShape)
		let inner = shape[rank - 1]
		inBands(n / inner, n, def (from int, to int) {
			for let row = from; row < to; row++ {
				let rest = row
				let base = 0
				for let k = rank - 2; k >= 0; k-- {
					let i = rest % shape[k]
					rest /= shape[k]
					base += k == axis ?? (0, i * ds[k])
				}
				let at = row * inner
				if axis == rank - 1 {
					for let j = 0; j < inner; j++ {
						offsets[at + j] = base + picks[at + j]
					}
				} else {
					let step = ds[rank - 1]
					let along = ds[axis]
					for let j = 0; j < inner; j++ {
						offsets[at + j] = base + j * step + picks[at + j] * along
					}
				}
			}
		})
		return offsets
	}

	// GatherElements: per index value, the data value at its own
	// coordinates with the one on `axis` taken from it.
	internal def gatherElements(c Call) !none {
		let data = try c.tensor(0)
		let index = try c.tensor(1)
		let axis = try axisOf(c, c.int("axis", 0), data.rank())
		fail c.about() + "indices of rank {index.rank()}, data {data.rank()}" unless index.rank() == data.rank()
		let picks = try indicesIn(c, intValues(index), data.shape[axis])
		let offsets = elementOffsets(index.shape, data.shape, axis, picks)
		let out = zerosLike(data.element, index.shape)
		gatherRow(data, 0, offsets, out, 0, offsets.len())
		c.out(0, out)
		return none
	}

	// The data offset of each index tuple (the last dimension of GatherND
	// and ScatterND indices), within the batch of the `batch` leading
	// dimensions it belongs to.
	// Fails when a tuple is too long or an index outside its dimension.
	internal def tupleOffsets(c Call, data Tensor, index Tensor, batch int) !int[] {
		let q = index.rank()
		fail c.about() + "indices need rank 1 or more" unless q >= 1
		fail c.about() + "batch_dims {batch}" unless batch >= 0 && batch < q && batch <= data.rank()
		let m = index.shape[q - 1]
		fail c.about() + "index tuples of {m} past {batch} batch dimensions for data of rank {data.rank()}" unless batch + m <= data.rank()
		for let k = 0; k < batch; k++ {
			fail c.about() + "batch dimension {k} differs" unless index.shape[k] == data.shape[k]
		}
		let values = intValues(index)
		let ds = stridesOf(data.shape)
		let tuples = product(index.shape, 0, q - 1)
		let perBatch = product(index.shape, batch, q - 1)
		let batchStride = batch > 0 ?? (ds[batch - 1], 0)
		let offsets int[]
		offsets.len(tuples)
		for let i = 0; i < tuples; i++ {
			let at = perBatch == 0 ?? (0, i / perBatch * batchStride)
			for let j = 0; j < m; j++ {
				let dim = data.shape[batch + j]
				let v = values[i * m + j]
				let k = v < 0 ?? (v + dim, v)
				fail c.about() + "index {v} is outside a dimension of {dim}" unless k >= 0 && k < dim
				at += k * ds[batch + j]
			}
			offsets[i] = at
		}
		return offsets
	}

	// GatherND: per index tuple (past `batch_dims`), the data slice it
	// names.
	internal def gatherND(c Call) !none {
		let data = try c.tensor(0)
		let index = try c.tensor(1)
		let batch = c.int("batch_dims", 0)
		let offsets = try tupleOffsets(c, data, index, batch)
		let m = index.shape[index.rank() - 1]
		let shape = index.shape.slice(0, index.rank() - 1).clone()
		for let k = batch + m; k < data.rank(); k++ {
			shape.push(data.shape[k])
		}
		let inner = product(data.shape, batch + m, data.rank())
		let out = zerosLike(data.element, shape)
		let n = offsets.len()
		inBands(n, n * inner, def (from int, to int) {
			for let i = from; i < to; i++ {
				moveRow(data, offsets[i], 1, out, i * inner, 1, inner)
			}
		})
		c.out(0, out)
		return none
	}

	// How a scatter combines an update with the value it lands on.
	internal enum ScatterReduction {
		None,
		Add,
		Mul,
		Max,
		Min,
	}

	// The `reduction` attribute.
	// Fails for an unknown one.
	internal def reductionOf(c Call) !ScatterReduction {
		let name = c.text("reduction", "none")
		match name {
			case "none":
				return ScatterReduction.None
			case "add":
				return ScatterReduction.Add
			case "mul":
				return ScatterReduction.Mul
			case "max":
				return ScatterReduction.Max
			case "min":
				return ScatterReduction.Min
			default:
				fail c.about() + "reduction {name}"
		}
	}

	// Places `n` values of `updates` from `ui` at `out` from `oi`,
	// combined with what is there by `how`.
	internal def scatterRun(out Tensor, oi int, updates Tensor, ui int, n int, how ScatterReduction) {
		if how == ScatterReduction.None {
			moveRow(updates, ui, 1, out, oi, 1, n)
			return
		}
		match storageOf(out.element) {
			case Storage.Floats:
				for let j = 0; j < n; j++ {
					let a = out.floats[oi + j]
					let b = updates.floats[ui + j]
					match how {
						case ScatterReduction.Add:
							out.floats[oi + j] = a + b
						case ScatterReduction.Mul:
							out.floats[oi + j] = a * b
						case ScatterReduction.Max:
							out.floats[oi + j] = a != a || b != b ?? (a + b, a.max(b))
						default:
							out.floats[oi + j] = a != a || b != b ?? (a + b, a.min(b))
					}
				}
			case Storage.Doubles:
				for let j = 0; j < n; j++ {
					let a = out.doubles[oi + j]
					let b = updates.doubles[ui + j]
					match how {
						case ScatterReduction.Add:
							out.doubles[oi + j] = a + b
						case ScatterReduction.Mul:
							out.doubles[oi + j] = a * b
						case ScatterReduction.Max:
							out.doubles[oi + j] = a != a || b != b ?? (a + b, a.max(b))
						default:
							out.doubles[oi + j] = a != a || b != b ?? (a + b, a.min(b))
					}
				}
			default:
				let bits = elementBits(out.element)
				let signed = out.element := ElementType.Int8 || ElementType.Int16 || ElementType.Int32 || ElementType.Int64 || ElementType.Int4 || ElementType.Int2
				let logical = out.element == ElementType.Bool
				for let j = 0; j < n; j++ {
					let a = out.ints[oi + j]
					let b = updates.ints[ui + j]
					let r = 0
					match how {
						case ScatterReduction.Add:
							r = logical ?? (a | b, a + b)
						case ScatterReduction.Mul:
							r = logical ?? (a & b, a * b)
						case ScatterReduction.Max:
							r = signed ?? (a.max(b), uint(a) > uint(b) ?? (a, b))
						default:
							r = signed ?? (a.min(b), uint(a) < uint(b) ?? (a, b))
					}
					out.ints[oi + j] = wrap(r, bits, signed)
				}
		}
	}

	// ScatterElements (and Scatter before it): a copy of the data with each
	// update placed at its own coordinates, the one on `axis` taken from
	// the indices, combined by `reduction`.
	internal def scatterElements(c Call) !none {
		let data = try c.tensor(0)
		let index = try c.tensor(1)
		let updates = try c.tensor(2)
		let axis = try axisOf(c, c.int("axis", 0), data.rank())
		fail c.about() + "indices of shape {index.shape}, updates {updates.shape}" unless index.shape.equals(updates.shape)
		fail c.about() + "indices of rank {index.rank()}, data {data.rank()}" unless index.rank() == data.rank()
		fail c.about() + "updates are {updates.element.name}, data {data.element.name}" unless updates.element == data.element
		let how = try reductionOf(c)
		fail c.about() + "reduction on strings" unless how == ScatterReduction.None || data.element != ElementType.String
		let picks = try indicesIn(c, intValues(index), data.shape[axis])
		let offsets = elementOffsets(index.shape, data.shape, axis, picks)
		let out = cloneTensor(data)
		for let (i, at) in offsets {
			scatterRun(out, at, updates, i, 1, how)
		}
		roundTo(out) unless how == ScatterReduction.None
		c.out(0, out)
		return none
	}

	// ScatterND: a copy of the data with each update slice placed at the
	// index tuple naming it, combined by `reduction`.
	internal def scatterND(c Call) !none {
		let data = try c.tensor(0)
		let index = try c.tensor(1)
		let updates = try c.tensor(2)
		fail c.about() + "updates are {updates.element.name}, data {data.element.name}" unless updates.element == data.element
		let how = try reductionOf(c)
		fail c.about() + "reduction on strings" unless how == ScatterReduction.None || data.element != ElementType.String
		let offsets = try tupleOffsets(c, data, index, 0)
		let m = index.shape[index.rank() - 1]
		let inner = product(data.shape, m, data.rank())
		fail c.about() + "updates of {updates.count()} values for {offsets.len()} slices of {inner}" unless updates.count() == offsets.len() * inner
		let out = cloneTensor(data)
		for let (i, at) in offsets {
			scatterRun(out, at, updates, i * inner, inner, how)
		}
		roundTo(out) unless how == ScatterReduction.None
		c.out(0, out)
		return none
	}

	// TensorScatter: a copy of the cache with the update's sequence
	// written from each batch's write index along `axis`, wrapping around
	// in `circular` mode.
	internal def tensorScatter(c Call) !none {
		let past = try c.tensor(0)
		let update = try c.tensor(1)
		let rank = past.rank()
		let axis = try axisOf(c, c.int("axis", -2), rank)
		fail c.about() + "axis 0 is the batch" when axis == 0
		let mode = c.text("mode", "linear")
		fail c.about() + "mode {mode}" unless mode := "linear" || "circular"
		fail c.about() + "update is {update.element.name}, cache {past.element.name}" unless update.element == past.element
		fail c.about() + "update of rank {update.rank()}, cache {rank}" unless update.rank() == rank
		for let k = 0; k < rank; k++ {
			fail c.about() + "update of shape {update.shape} for a cache of {past.shape}" unless (k == axis && update.shape[k] <= past.shape[k]) || update.shape[k] == past.shape[k]
		}
		let batch = past.shape[0]
		let writes = (try intsOr(c, 2, int[])).clone()
		writes.len(batch) when writes.len() < batch
		let length = past.shape[axis]
		let count = update.shape[axis]
		let inner = product(past.shape, axis + 1, rank)
		let prefixes = product(past.shape, 0, axis)
		let perBatch = product(past.shape, 1, axis)
		let out = cloneTensor(past)
		for let p = 0; p < prefixes; p++ {
			let w = writes[p / perBatch]
			for let s = 0; s < count; s++ {
				let at = w + s
				at = mode == "circular" ?? (((at % length) + length) % length, at)
				fail c.about() + "write index {w} + {s} is past the cache of {length}" unless at >= 0 && at < length
				moveRow(update, (p * count + s) * inner, 1, out, (p * length + at) * inner, 1, inner)
			}
		}
		c.out(0, out)
		return none
	}

	// The strides that read `t` broadcast to `shape` (0 on the dimensions
	// it repeats).
	internal def broadcastStrides(t Tensor, shape int[]) int[] {
		let strides = stridesOf(t.shape)
		let rank = shape.len()
		let lead = rank - t.rank()
		let ss int[]
		ss.len(rank)
		for let k = lead; k < rank; k++ {
			ss[k] = t.shape[k - lead] == 1 ?? (0, strides[k - lead])
		}
		return ss
	}

	// Expand: the input broadcast with the given shape.
	internal def expand(c Call) !none {
		let t = try c.tensor(0)
		let plan = try broadcast(t.shape, try c.ints(1))
		let shape = plan.shape
		let out = zerosLike(t.element, shape)
		copyBlock(t, 0, broadcastStrides(t, shape), out, 0, stridesOf(shape), shape)
		c.out(0, out)
		return none
	}

	// Tile: the input repeated `repeats` times along each dimension (Tile 1:
	// `tiles` times along `axis`).
	internal def tile(c Call) !none {
		let t = try c.tensor(0)
		let rank = t.rank()
		let repeats int[]
		if c.opset < 6 {
			repeats.len(rank)
			repeats[:] = 1
			let axis = try axisOf(c, scalarInt(try c.tensor(2)), rank)
			repeats[axis] = scalarInt(try c.tensor(1))
		} else {
			repeats = try c.ints(1)
		}
		fail c.about() + "{repeats.len()} repeats for rank {rank}" unless repeats.len() == rank
		let shape int[]
		for let k = 0; k < rank; k++ {
			fail c.about() + "repeat {repeats[k]}" when repeats[k] < 0
			shape.push(t.shape[k] * repeats[k])
		}
		let out = zerosLike(t.element, shape)
		// Each output dimension as (copy, value): a copy reads the input again.
		let strides = stridesOf(t.shape)
		let os = stridesOf(shape)
		let dims int[]
		let ss int[]
		let ds int[]
		for let k = 0; k < rank; k++ {
			dims.push(repeats[k], t.shape[k])
			ss.push(0, strides[k])
			ds.push(t.shape[k] * os[k], os[k])
		}
		copyBlock(t, 0, ss, out, 0, ds, dims)
		c.out(0, out)
		return none
	}

	// Where each output coordinate of one dimension reads the input: an
	// input coordinate, or -1 for the pad value.
	internal def padMap(c Call, mode string, before int, dim int, size int) !int[] {
		let places int[]
		places.len(size)
		for let o = 0; o < size; o++ {
			let i = o - before
			if i >= 0 && i < dim {
				places[o] = i
				continue
			}
			fail c.about() + "{mode} padding of an empty dimension" when dim == 0 && mode != "constant"
			match mode {
				case "constant":
					places[o] = -1
				case "edge":
					places[o] = i.clamp(0, dim - 1)
				case "reflect":
					if dim == 1 {
						places[o] = 0
					} else {
						let period = 2 * (dim - 1)
						let r = ((i % period) + period) % period
						places[o] = r >= dim ?? (period - r, r)
					}
				case "wrap":
					places[o] = ((i % dim) + dim) % dim
				default:
					fail c.about() + "mode {mode}"
			}
		}
		return places
	}

	// Copies `t` into `out` (of `shape`) reading output coordinate o of
	// dimension k from input coordinate maps[k][o]; a -1 leaves the value
	// `out` holds. The last dimension moves as runs where its map counts
	// up by one, else value by value.
	internal def mapInto(t Tensor, out Tensor, shape int[], maps int[][]) {
		let rank = shape.len()
		if rank == 0 {
			moveRow(t, 0, 1, out, 0, 1, 1)
			return
		}
		let total = product(shape, 0, rank)
		return when total == 0
		let strides = stridesOf(t.shape)
		let inner = shape[rank - 1]
		let last = maps[rank - 1]
		// Runs of the last dimension as (output start, input start, length),
		// input start -1 for pad values.
		let runs int[]
		let o = 0
		let holes = false
		for o < inner {
			let start = o
			let from = last[o]
			holes = holes || from < 0
			o++
			for o < inner && ((from < 0 && last[o] < 0) || (from >= 0 && last[o] == from + (o - start))) {
				o++
			}
			runs.push(start, from, o - start)
		}
		let useRuns = runs.len() / 3 * 8 <= inner || holes
		let gathered int[]
		gathered = last unless useRuns
		inBands(total / inner, total, def (from int, to int) {
			for let row = from; row < to; row++ {
				let rest = row
				let at = 0
				let skip = false
				for let k = rank - 2; k >= 0; k-- {
					let i = maps[k][rest % shape[k]]
					rest /= shape[k]
					if i < 0 {
						skip = true
						break
					}
					at += i * strides[k]
				}
				continue when skip
				let dOff = row * inner
				if useRuns {
					for let r = 0; r < runs.len(); r += 3 {
						moveRow(t, at + runs[r + 1], 1, out, dOff + runs[r], 1, runs[r + 2]) when runs[r + 1] >= 0
					}
				} else {
					gatherRow(t, at, gathered, out, dOff, inner)
				}
			}
		})
	}

	// A tensor of `element` and `shape` with every value `value`'s first
	// (zeros when it is none or empty).
	internal def filled(element ElementType, shape int[], value ?Tensor) Tensor {
		let out = zerosLike(element, shape)
		if value is Tensor && value.count() > 0 {
			match storageOf(element) {
				case Storage.Floats:
					out.floats[:] = value.floats[0]
				case Storage.Doubles:
					out.doubles[:] = value.doubles[0]
				case Storage.Ints:
					out.ints[:] = value.ints[0]
				default:
					out.strings[:] = value.strings[0]
			}
		}
		return out
	}

	// Pad: the input with `pads` values added (removed when negative)
	// before and after each axis: the constant value, the edge value, a
	// reflection or a wrap around (`mode`). Pads and value are attributes
	// before opset 11, inputs from it; axes an input from opset 18.
	internal def pad(c Call) !none {
		let t = try c.tensor(0)
		let rank = t.rank()
		let mode = c.text("mode", "constant")
		let pads int[]
		let value ?Tensor = none
		let axes int[]
		if c.opset < 11 {
			pads = c.ints(c.opset < 2 ?? ("paddings", "pads"), int[])
			let v = zerosLike(t.element, int[])
			let given = c.float("value", float32(0))
			match storageOf(t.element) {
				case Storage.Floats:
					v.floats[0] = given
				case Storage.Doubles:
					v.doubles[0] = float(given)
				case Storage.Ints:
					v.ints[0] = int(given)
				default:
			}
			value = v
		} else {
			pads = try c.ints(1)
			if c.has(2) {
				let v = try c.tensor(2)
				fail c.about() + "constant value is {v.element.name}, data {t.element.name}" unless v.element == t.element
				value = v
			}
			axes = (try intsOr(c, 3, int[])).clone()
		}
		if axes.len() == 0 {
			for let k = 0; k < rank; k++ {
				axes.push(k)
			}
		}
		fail c.about() + "{pads.len()} pads for {axes.len()} axes" unless pads.len() == 2 * axes.len()
		let before int[]
		let after int[]
		before.len(rank)
		after.len(rank)
		for let (i, a) in axes {
			let k = try axisOf(c, a, rank)
			before[k] = pads[i]
			after[k] = pads[i + axes.len()]
		}
		let shape int[]
		let maps int[][]
		for let k = 0; k < rank; k++ {
			let size = t.shape[k] + before[k] + after[k]
			fail c.about() + "pads {pads} leave dimension {k} of size {size}" when size < 0
			shape.push(size)
			maps.push(try padMap(c, mode, before[k], t.shape[k], size))
		}
		let out = mode == "constant" ?? (filled(t.element, shape, value), zerosLike(t.element, shape))
		mapInto(t, out, shape, maps)
		c.out(0, out)
		return none
	}

	// Shape: the input's dimensions from `start` to `end` (opset 15),
	// clamped to its rank.
	internal def shapeOf(c Call) !none {
		let t = try c.tensor(0)
		let rank = t.rank()
		let start = c.int("start", 0)
		let end = c.int("end", rank)
		start = (start < 0 ?? (start + rank, start)).clamp(0, rank)
		end = (end < 0 ?? (end + rank, end)).clamp(0, rank)
		let dims = end > start ?? (t.shape.slice(start, end - start), int[])
		c.out(0, new Tensor(int[dims.len()], dims.clone()))
		return none
	}

	// ConstantOfShape: a tensor of the given shape with every value the
	// `value` attribute's (a Float 0 by default).
	internal def constantOfShape(c Call) !none {
		let shape = (try c.ints(0)).clone()
		for let (_, d) in shape {
			fail c.about() + "dimension {d}" when d < 0
		}
		let a = c.attribute("value")
		if a is Attribute {
			let data = a.t
			if data is TensorData {
				let v = try tensorOf(data)
				c.out(0, filled(v.element, shape, v))
				return none
			}
		}
		c.out(0, zerosLike(ElementType.Float, shape))
		return none
	}

	// Constant: the tensor its one value attribute holds.
	internal def constant(c Call) !none {
		for let (_, a) in c.step.node.attributes {
			match a.name {
				case "value":
					let data = a.t
					fail c.about() + "value holds no tensor" unless data is TensorData
					c.out(0, try tensorOf(data))
				case "sparse_value":
					let sparse = a.sparse
					fail c.about() + "sparse_value holds no tensor" unless sparse is SparseTensorData
					c.out(0, try tensorOf(try denseOf(sparse)))
				case "value_float":
					c.out(0, new Tensor(int[], float32[a.f]))
				case "value_floats":
					c.out(0, new Tensor(int[a.floats.len()], a.floats.clone()))
				case "value_int":
					c.out(0, new Tensor(int[], int[a.i]))
				case "value_ints":
					c.out(0, new Tensor(int[a.ints.len()], a.ints.clone()))
				case "value_string":
					c.out(0, new Tensor(int[], string[a.text()]))
				case "value_strings":
					let texts string[]
					for let (_, s) in a.strings {
						texts.push(string(s))
					}
					c.out(0, new Tensor(int[texts.len()], texts))
				default:
					continue
			}
			return none
		}
		fail c.about() + "no value attribute"
	}

	// Range: start, start + delta, ... up to (not including) limit.
	internal def range(c Call) !none {
		let start = try c.tensor(0)
		let limit = try c.tensor(1)
		let delta = try c.tensor(2)
		fail c.about() + "start, limit and delta are {start.element.name}, {limit.element.name}, {delta.element.name}" unless start.element == limit.element && start.element == delta.element
		match storageOf(start.element) {
			case Storage.Ints:
				let s = start.ints[0]
				let l = limit.ints[0]
				let d = delta.ints[0]
				fail c.about() + "delta 0" when d == 0
				let n = d > 0 ?? ((l - s + d - 1) / d, (s - l - d - 1) / - d)
				n = n.max(0)
				let out = zerosLike(start.element, int[n])
				let bits = elementBits(start.element)
				for let i = 0; i < n; i++ {
					out.ints[i] = wrap(s + i * d, bits, true)
				}
				c.out(0, out)
			case Storage.Floats, Storage.Doubles:
				let s = scalarFloat(start)
				let l = scalarFloat(limit)
				let d = scalarFloat(delta)
				fail c.about() + "delta 0" when d == 0.0
				let n = int(((l - s) / d).ceil()).max(0)
				let out = zerosLike(start.element, int[n])
				if storageOf(start.element) == Storage.Doubles {
					for let i = 0; i < n; i++ {
						out.doubles[i] = s + float(i) * d
					}
				} else {
					for let i = 0; i < n; i++ {
						out.floats[i] = float32(s + float(i) * d)
					}
					roundTo(out)
				}
				c.out(0, out)
			default:
				fail c.about() + "Range of strings"
		}
		return none
	}

	// Sets value `i` of `t` to one (true for Bool).
	internal def setOne(t Tensor, i int) {
		match storageOf(t.element) {
			case Storage.Floats:
				t.floats[i] = float32(1)
			case Storage.Doubles:
				t.doubles[i] = 1.0
			case Storage.Ints:
				t.ints[i] = 1
			default:
		}
	}

	// EyeLike: a matrix of the input's shape with ones on diagonal `k`, of
	// type `dtype` (the input's by default).
	internal def eyeLike(c Call) !none {
		let t = try c.tensor(0)
		fail c.about() + "input of rank {t.rank()}, not 2" unless t.rank() == 2
		let element = c.attribute("dtype") is Attribute ?? (ElementType(c.int("dtype", 1)), t.element)
		fail c.about() + "EyeLike of strings" when element == ElementType.String
		let out = zerosLike(element, t.shape)
		let k = c.int("k", 0)
		let rows = t.shape[0]
		let cols = t.shape[1]
		for let i = 0; i < rows; i++ {
			let j = i + k
			setOne(out, i * cols + j) when j >= 0 && j < cols
		}
		c.out(0, out)
		return none
	}

	// OneHot: per index, `depth` values along `axis`, all the off value
	// (values[0]) but the on value (values[1]) at the index; an index
	// outside the depth (negative ones counted from its end) puts none on.
	internal def oneHot(c Call) !none {
		let index = try c.tensor(0)
		let values = try c.tensor(2)
		fail c.about() + "values hold {values.count()}, not 2" unless values.count() == 2
		let depth = int(scalarFloat(try c.tensor(1)))
		fail c.about() + "depth {depth}" unless depth > 0
		let axis = try axisOf(c, c.int("axis", -1), index.rank() + 1)
		let shape = index.shape.slice(0, axis).clone()
		shape.push(depth)
		shape += index.shape.slice(axis, index.rank() - axis)
		let out = filled(values.element, shape, values)
		let picks = intValues(index)
		let inner = product(index.shape, axis, index.rank())
		for let (i, v) in picks {
			let k = v < 0 ?? (v + depth, v)
			continue unless k >= 0 && k < depth
			moveRow(values, 1, 1, out, (i / inner * depth + k) * inner + i % inner, 1, 1)
		}
		c.out(0, out)
		return none
	}

	// Trilu: the last two dimensions' upper (`upper` 1) or lower triangle
	// from diagonal `k`, zeros elsewhere.
	internal def trilu(c Call) !none {
		let t = try c.tensor(0)
		let rank = t.rank()
		fail c.about() + "input of rank {rank}" unless rank >= 2
		let k = c.has(1) ?? (scalarInt(try c.tensor(1)), 0)
		let upper = c.int("upper", 1) == 1
		let h = t.shape[rank - 2]
		let w = t.shape[rank - 1]
		let out = zerosLike(t.element, t.shape)
		c.out(0, out)
		return none when t.count() == 0
		inBands(t.count() / w, t.count(), def (from int, to int) {
			for let row = from; row < to; row++ {
				let i = row % h
				let lo = upper ?? ((i + k).clamp(0, w), 0)
				let hi = upper ?? (w, (i + k + 1).clamp(0, w))
				moveRow(t, row * w + lo, 1, out, row * w + lo, 1, hi - lo) when hi > lo
			}
		})
		return none
	}

	// Compress: the slices along `axis` (the flattened values without it)
	// whose condition holds.
	internal def compress(c Call) !none {
		let t = try c.tensor(0)
		let condition = intValues(try c.tensor(1))
		let flat = !(c.attribute("axis") is Attribute)
		let axis = flat ?? (0, try axisOf(c, c.int("axis", 0), t.rank()))
		let dims = flat ?? (int[t.count()], t.shape)
		let dim = dims[axis]
		fail c.about() + "condition of {condition.len()} for a dimension of {dim}" when condition.len() > dim
		let picks int[]
		for let (i, v) in condition {
			picks.push(i) when v != 0
		}
		let shape = dims.clone()
		shape[axis] = picks.len()
		let out = zerosLike(t.element, shape)
		let outer = product(dims, 0, axis)
		let inner = product(dims, axis + 1, dims.len())
		let n = picks.len()
		inBands(outer * n, outer * n * inner, def (from int, to int) {
			for let r = from; r < to; r++ {
				moveRow(t, (r / n * dim + picks[r % n]) * inner, 1, out, r * inner, 1, inner)
			}
		})
		c.out(0, out)
		return none
	}

	// Whether value `i` of `t` is not zero (a string not empty).
	internal def nonZeroAt(t Tensor, i int) bool {
		match storageOf(t.element) {
			case Storage.Floats:
				return t.floats[i] != float32(0)
			case Storage.Doubles:
				return t.doubles[i] != 0.0
			case Storage.Ints:
				return t.ints[i] != 0
			default:
				return t.strings[i].len() > 0
		}
	}

	// NonZero: the coordinates of the non-zero values, one row per
	// dimension (a scalar counts as one dimension of one).
	internal def nonZero(c Call) !none {
		let t = try c.tensor(0)
		let shape = t.rank() == 0 ?? (int[1], t.shape)
		let rank = shape.len()
		let found int[]
		let n = t.count()
		for let i = 0; i < n; i++ {
			found.push(i) when nonZeroAt(t, i)
		}
		let count = found.len()
		let out = zerosLike(ElementType.Int64, int[rank, count])
		let strides = stridesOf(shape)
		for let (j, at) in found {
			for let k = 0; k < rank; k++ {
				out.ints[k * count + j] = at / strides[k] % shape[k]
			}
		}
		c.out(0, out)
		return none
	}

	// Orders value `i` of `a` against value `j` of `b` (one storage): -1, 0
	// or 1; NaN after every number and equal to NaN, as numpy sorts.
	internal def compareAt(a Tensor, i int, b Tensor, j int) int {
		match storageOf(a.element) {
			case Storage.Floats:
				let x = float(a.floats[i])
				let y = float(b.floats[j])
				return orderOf(x, y)
			case Storage.Doubles:
				return orderOf(a.doubles[i], b.doubles[j])
			case Storage.Ints:
				let x = a.ints[i]
				let y = b.ints[j]
				return uint(x) < uint(y) ?? (-1, uint(x) > uint(y) ?? (1, 0)) when a.element == ElementType.Uint64
				return x < y ?? (-1, x > y ?? (1, 0))
			default:
				let x = a.strings[i]
				let y = b.strings[j]
				return x < y ?? (-1, x > y ?? (1, 0))
		}
	}

	// -1, 0 or 1 as x is below, equal to or above y; NaN last.
	internal def orderOf(x float, y float) int {
		return x != x && y != y ?? (0, x != x ?? (1, -1)) when x != x || y != y
		return x < y ?? (-1, x > y ?? (1, 0))
	}

	// Unique: the distinct values (or slices along `axis`), sorted (by
	// default) or in the order they first appear, with where each first
	// appears, which one each input value is, and how often each appears.
	internal def unique(c Call) !none {
		let t = try c.tensor(0)
		let sorted = c.int("sorted", 1) == 1
		let flat = !(c.attribute("axis") is Attribute)
		let dims = flat ?? (int[t.count()], t.shape)
		let axis = flat ?? (0, try axisOf(c, c.int("axis", 0), t.rank()))
		let dim = dims[axis]
		let outer = product(dims, 0, axis)
		let inner = product(dims, axis + 1, dims.len())
		// Slice i holds the values (o · dim + i) · inner + k, compared in
		// the order of o, then k.
		let order = def (i int, j int) int {
			for let o = 0; o < outer; o++ {
				let a = (o * dim + i) * inner
				let b = (o * dim + j) * inner
				for let k = 0; k < inner; k++ {
					let r = compareAt(t, a + k, t, b + k)
					return r unless r == 0
				}
			}
			return 0
		}
		let byValue int[]
		for let i = 0; i < dim; i++ {
			byValue.push(i)
		}
		byValue.sort(def (i int, j int) bool {
			let r = order(i, j)
			return r < 0 || (r == 0 && i < j)
		})
		// Runs of equal slices: the first of each is where it first appears.
		let firsts int[]
		let groupOf int[]
		groupOf.len(dim)
		let counts int[]
		for let (p, i) in byValue {
			if p == 0 || order(byValue[p - 1], i) != 0 {
				firsts.push(i)
				counts.push(0)
			}
			groupOf[i] = firsts.len() - 1
			counts[counts.len() - 1]++
		}
		let n = firsts.len()
		let ordered int[]
		for let g = 0; g < n; g++ {
			ordered.push(g)
		}
		ordered.sort((g, h) => firsts[g] < firsts[h]) unless sorted
		let place int[]
		place.len(n)
		for let (p, g) in ordered {
			place[g] = p
		}
		let shape = dims.clone()
		shape[axis] = n
		let y = zerosLike(t.element, shape)
		let indices int[]
		let counted int[]
		for let (p, g) in ordered {
			indices.push(firsts[g])
			counted.push(counts[g])
			for let o = 0; o < outer; o++ {
				moveRow(t, (o * dim + firsts[g]) * inner, 1, y, (o * n + p) * inner, 1, inner)
			}
		}
		let inverse int[]
		for let i = 0; i < dim; i++ {
			inverse.push(place[groupOf[i]])
		}
		c.out(0, y)
		c.out(1, new Tensor(int[n], indices))
		c.out(2, new Tensor(int[dim], inverse))
		c.out(3, new Tensor(int[n], counted))
		return none
	}

	// ReverseSequence: per batch, the first `sequence_lens` steps along
	// `time_axis` reversed, the rest kept.
	internal def reverseSequence(c Call) !none {
		let t = try c.tensor(0)
		let lengths = try c.ints(1)
		let rank = t.rank()
		fail c.about() + "input of rank {rank}" unless rank >= 2
		let batchAxis = try axisOf(c, c.int("batch_axis", 1), rank)
		let timeAxis = try axisOf(c, c.int("time_axis", 0), rank)
		fail c.about() + "batch_axis and time_axis must be 0 and 1" unless batchAxis + timeAxis == 1
		let batch = t.shape[batchAxis]
		let steps = t.shape[timeAxis]
		fail c.about() + "{lengths.len()} sequence lengths for a batch of {batch}" unless lengths.len() == batch
		let inner = product(t.shape, 2, rank)
		let out = zerosLike(t.element, t.shape)
		// Where step s of batch b starts.
		let (sStep, bStep) = timeAxis == 0 ?? ((batch * inner, inner), (inner, steps * inner))
		for let b = 0; b < batch; b++ {
			let n = lengths[b]
			fail c.about() + "sequence length {n} for {steps} steps" unless n >= 0 && n <= steps
			for let s = 0; s < steps; s++ {
				let from = s < n ?? (n - 1 - s, s)
				moveRow(t, b * bStep + from * sStep, 1, out, b * bStep + s * sStep, 1, inner)
			}
		}
		c.out(0, out)
		return none
	}

	// DepthToSpace: blocks of channels moved into `blocksize` squares of
	// space, depth-column-row (DCR, the default) or column-row-depth (CRD).
	internal def depthToSpace(c Call) !none {
		let t = try c.tensor(0)
		fail c.about() + "input of rank {t.rank()}, not 4" unless t.rank() == 4
		let b = c.int("blocksize", 0)
		let n = t.shape[0]
		let ch = t.shape[1]
		let h = t.shape[2]
		let w = t.shape[3]
		fail c.about() + "{ch} channels for blocks of {b}" unless b > 0 && ch % (b * b) == 0
		let depth = ch / (b * b)
		let crd = c.text("mode", "DCR") == "CRD"
		let out = crd ?? (permuted(t, int[n, depth, b, b, h, w], int[0, 1, 4, 2, 5, 3]), permuted(t, int[n, b, b, depth, h, w], int[0, 3, 4, 1, 5, 2]))
		c.out(0, reshaped(out, int[n, depth, h * b, w * b]))
		return none
	}

	// SpaceToDepth: `blocksize` squares of space moved into channels,
	// depth-column-row (DCR, the default) or column-row-depth (CRD, opset 28).
	internal def spaceToDepth(c Call) !none {
		let t = try c.tensor(0)
		fail c.about() + "input of rank {t.rank()}, not 4" unless t.rank() == 4
		let b = c.int("blocksize", 0)
		let n = t.shape[0]
		let ch = t.shape[1]
		let h = t.shape[2]
		let w = t.shape[3]
		fail c.about() + "{h}x{w} for blocks of {b}" unless b > 0 && h % b == 0 && w % b == 0
		let perm = c.text("mode", "DCR") == "CRD" ?? (int[0, 1, 3, 5, 2, 4], int[0, 3, 5, 1, 2, 4])
		let out = permuted(t, int[n, ch, h / b, b, w / b, b], perm)
		c.out(0, reshaped(out, int[n, ch * b * b, h / b, w / b]))
		return none
	}

	// CenterCropPad: the input cropped or padded with zeros, about its
	// center, to the given sizes on `axes` (all by default).
	internal def centerCropPad(c Call) !none {
		let t = try c.tensor(0)
		let sizes = try c.ints(1)
		let rank = t.rank()
		let axes = c.ints("axes", int[]).clone()
		if axes.len() == 0 {
			for let k = 0; k < rank; k++ {
				axes.push(k)
			}
		}
		fail c.about() + "{sizes.len()} sizes for {axes.len()} axes" unless sizes.len() == axes.len()
		let shape = t.shape.clone()
		let dims = t.shape.clone()
		let starts int[]
		starts.len(rank)
		let outStarts int[]
		outStarts.len(rank)
		for let (i, a) in axes {
			let k = try axisOf(c, a, rank)
			let dim = t.shape[k]
			let size = sizes[i]
			fail c.about() + "size {size}" when size < 0
			shape[k] = size
			if size < dim {
				starts[k] = (dim - size) / 2
				dims[k] = size
			} else {
				outStarts[k] = (size - dim) / 2
			}
		}
		let strides = stridesOf(t.shape)
		let os = stridesOf(shape)
		let sBase = 0
		let dBase = 0
		for let k = 0; k < rank; k++ {
			sBase += starts[k] * strides[k]
			dBase += outStarts[k] * os[k]
		}
		let out = zerosLike(t.element, shape)
		copyBlock(t, sBase, strides, out, dBase, os, dims)
		c.out(0, out)
		return none
	}

	// Dropout: in inference the input as it is, and a mask of all true
	// when asked; in training (the `training_mode` input, opset 12) each
	// value dropped with probability `ratio` and the rest scaled by
	// 1 / (1 - ratio), the draws numpy's RandomState(seed) makes.
	internal def dropout(c Call) !none {
		let t = try c.tensor(0)
		let ratio = c.float("ratio", float32(0.5))
		let training = false
		if c.opset >= 12 {
			ratio = c.has(1) ?? (float32(scalarFloat(try c.tensor(1))), float32(0.5))
			training = c.has(2) && scalarInt(try c.tensor(2)) != 0
		}
		let n = t.count()
		if !training || ratio == float32(0) {
			c.out(0, t)
			if c.wants(1) {
				let mask = zerosLike(c.opset >= 10 ?? (ElementType.Bool, t.element), t.shape)
				for let i = 0; i < n; i++ {
					setOne(mask, i)
				}
				c.out(1, mask)
			}
			return none
		}
		fail c.about() + "ratio {ratio} outside [0, 1)" unless ratio > float32(0) && ratio < float32(1)
		let seed = c.attribute("seed") is Attribute ?? (c.int("seed", 0), int(crypto.randOf<uint32>()))
		let random = new Twister(seed)
		let out = zerosLike(t.element, t.shape)
		let mask = zerosLike(ElementType.Bool, t.shape)
		for let i = 0; i < n; i++ {
			mask.ints[i] = random.uniform() >= float(ratio) ?? (1, 0)
		}
		match storageOf(t.element) {
			case Storage.Floats:
				let scale = float32(1) / (float32(1) - ratio)
				for let i = 0; i < n; i++ {
					out.floats[i] = mask.ints[i] == 1 ?? (t.floats[i] * scale, float32(0))
				}
				roundTo(out)
			case Storage.Doubles:
				let scale = 1.0 / (1.0 - float(ratio))
				for let i = 0; i < n; i++ {
					out.doubles[i] = mask.ints[i] == 1 ?? (t.doubles[i] * scale, 0.0)
				}
			default:
				fail c.about() + "training Dropout of {t.element.name}"
		}
		c.out(0, out)
		c.out(1, mask)
		return none
	}

	// The MT19937 generator as numpy's legacy RandomState seeds and draws
	// it, so a seeded operator matches the reference.
	internal type Twister {
		state int[]
		next  int

		def new(seed int) {
			state.len(624)
			state[0] = seed & 0xFFFFFFFF
			for let i = 1; i < 624; i++ {
				let p = state[i - 1]
				state[i] = (1812433253 * (p ^ (p >> 30)) + i) & 0xFFFFFFFF
			}
			next = 624
		}

		// The next 32 random bits.
		def bits() int {
			if next >= 624 {
				for let i = 0; i < 624; i++ {
					let y = (state[i] & 0x80000000) | (state[(i + 1) % 624] & 0x7FFFFFFF)
					let v = state[(i + 397) % 624] ^ (y >> 1)
					state[i] = (y & 1) == 1 ?? (v ^ 0x9908B0DF, v)
				}
				next = 0
			}
			let y = state[next]
			next++
			y ^= y >> 11
			y ^= (y << 7) & 0x9D2C5680
			y ^= (y << 15) & 0xEFC60000
			y ^= y >> 18
			return y & 0xFFFFFFFF
		}

		// A uniform double in [0, 1) from 53 random bits.
		def uniform() float {
			let a = bits() >> 5
			let b = bits() >> 6
			return (float(a) * 67108864.0 + float(b)) / 9007199254740992.0
		}
	}

	// BitCast: the input's bits read as type `to` of the same width,
	// little-endian.
	internal def bitCast(c Call) !none {
		let t = try c.tensor(0)
		let to = ElementType(c.int("to", 0))
		fail c.about() + "BitCast of strings" when t.element == ElementType.String || to == ElementType.String
		fail c.about() + "{t.element.name} and {to.name} differ in width" unless elementBits(t.element) == elementBits(to)
		let data = t.toData("")
		data.element = to
		c.out(0, try tensorOf(data))
		return none
	}
}
