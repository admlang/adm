partial module std.ai.onnx {
	use (
		std.math
		std.ai.tensor::(Tensor, storageOf, Storage)
	)

	// Runs the optimizer operators of the ai.onnx.preview.training domain
	// (Adagrad, Adam, Momentum); false for another operator.
	// Fails when the operator fails on its inputs.
	internal def applyTraining(c Call) !bool {
		match c.step.op {
			case "Adagrad":
				try optimize(c, Optimizer.Adagrad, 3)
			case "Adam":
				try optimize(c, Optimizer.Adam, 4)
			case "Momentum":
				try optimize(c, Optimizer.Momentum, 3)
			default:
				return false
		}
		return true
	}

	internal enum Optimizer {
		Adagrad,
		Adam,
		Momentum,
	}

	// One optimizer step over every tensor it updates: the learning rate R
	// and the step count T, then `per` groups of n inputs (the tensors X,
	// their gradients G, and their states: H for Adagrad, V for Momentum,
	// V then H for Adam). The outputs are the new X, then the new states,
	// group by group. Values are computed in float64 and stored in each
	// tensor's own type.
	// Fails when the inputs do not come in whole groups or their shapes
	// differ.
	internal def optimize(c Call, kind Optimizer, per int) !none {
		let count = c.inputs.len() - 2
		fail c.about() + "takes R, T and {per} tensors per updated tensor, not {c.inputs.len()} inputs" unless count > 0 && count % per == 0
		let n = count / per
		let rate = scalarFloat(try c.tensor(0))
		let step = scalarInt(try c.tensor(1))
		for let i = 0; i < n; i++ {
			let x = try c.tensor(2 + i)
			let g = try c.tensor(2 + n + i)
			let s1 = try c.tensor(2 + 2 * n + i)
			fail c.about() + "X, G and the state of tensor {i + 1} differ in shape" unless g.shape.equals(x.shape) && s1.shape.equals(x.shape)
			let xs = floatValues(x)
			let gs = floatValues(g)
			let a = floatValues(s1)
			let b float[]
			if kind == Optimizer.Adam {
				let s2 = try c.tensor(2 + 3 * n + i)
				fail c.about() + "the second state of tensor {i + 1} differs in shape" unless s2.shape.equals(x.shape)
				b = floatValues(s2)
			}
			let norm = float(c.float("norm_coefficient", float32(0)))
			match kind {
				case Optimizer.Adagrad:
					let r = rate / (1.0 + float(step) * float(c.float("decay_factor", float32(0))))
					let eps = float(c.float("epsilon", float32(1e-6)))
					for let k = 0; k < xs.len(); k++ {
						let gr = norm * xs[k] + gs[k]
						a[k] += gr * gr
						xs[k] -= r * gr / (math.sqrt(a[k]) + eps)
					}
				case Optimizer.Adam:
					let alpha = float(c.float("alpha", float32(0.9)))
					let beta = float(c.float("beta", float32(0.999)))
					let eps = float(c.float("epsilon", float32(1e-6)))
					let post = float(c.float("norm_coefficient_post", float32(0)))
					let r = step > 0 ?? (rate * math.sqrt(1.0 - beta ** float(step)) / (1.0 - alpha ** float(step)), rate)
					for let k = 0; k < xs.len(); k++ {
						let gr = norm * xs[k] + gs[k]
						a[k] = alpha * a[k] + (1.0 - alpha) * gr
						b[k] = beta * b[k] + (1.0 - beta) * gr * gr
						xs[k] = (1.0 - post) * (xs[k] - r * a[k] / (math.sqrt(b[k]) + eps))
					}
				case Optimizer.Momentum:
					let alpha = float(c.float("alpha", float32(0)))
					let beta = step > 0 ?? (float(c.float("beta", float32(0))), 1.0)
					let nesterov = c.text("mode", "standard") == "nesterov"
					for let k = 0; k < xs.len(); k++ {
						let gr = norm * xs[k] + gs[k]
						a[k] = alpha * a[k] + beta * gr
						xs[k] -= rate * (nesterov ?? (gr + alpha * a[k], a[k]))
					}
			}
			c.out(i, tensorLike(x, xs))
			c.out(n + i, tensorLike(s1, a))
			c.out(2 * n + i, tensorLike(x, b)) when kind == Optimizer.Adam
		}
		return none
	}

	// The values of a floating-point tensor as float64.
	internal def floatValues(t Tensor) float[] {
		return t.doubles.clone() when storageOf(t.element) == Storage.Doubles
		let out float[]
		out.len(t.floats.len())
		for let i = 0; i < out.len(); i++ {
			out[i] = float(t.floats[i])
		}
		return out
	}

	// A tensor of `like`'s type and shape holding `values`.
	internal def tensorLike(like Tensor, values float[]) Tensor {
		let out = zerosLike(like.element, like.shape.clone())
		if storageOf(like.element) == Storage.Doubles {
			out.doubles = values
			return out
		}
		for let i = 0; i < values.len(); i++ {
			out.floats[i] = float32(values[i])
		}
		roundTo(out)
		return out
	}
}
