partial module std.ai.onnx {
	use (
		std.simd
		std.math
		std.formats.ai.onnx::(ElementType, elementBits)
		std.ai.tensor
		std.ai.tensor::(Tensor, storageOf, Storage)
		std.formats.ai.onnx::(minifloat)
	)

	// The one-input elementwise functions.
	internal enum Unary {
		Abs,
		Neg,
		Exp,
		Log,
		Sqrt,
		Reciprocal,
		Floor,
		Ceil,
		Round,
		Sin,
		Cos,
		Tan,
		Asin,
		Acos,
		Atan,
		Sinh,
		Cosh,
		Asinh,
		Acosh,
		Atanh,
		Erf,
		Sigmoid,
		Tanh,
		Relu,
		Softplus,
		Softsign,
		Sign,
		Elu,
		Selu,
		LeakyRelu,
		ThresholdedRelu,
		HardSigmoid,
		HardSwish,
		Mish,
		Celu,
		Gelu,
		GeluTanh,
		Swish,
		Shrink,
	}

	// The parameters of the functions that take some (alpha, beta,
	// gamma; Shrink's bias and lambda).
	internal struct UnaryParams {
		alpha float32
		beta  float32
		gamma float32
	}

	// `op` on every value of `t`: floating-point types (narrow ones
	// rounded back), and the integer types for Abs, Neg, Sign and Relu.
	// Fails for a type the function does not take.
	internal def unary(t Tensor, op Unary, p UnaryParams, reuse bool = false, pool ?Pool = none) !Tensor {
		match storageOf(t.element) {
			case Storage.Floats:
				// With `reuse` (see Call.consumes) the values are written over
				// t's: each is read before its own is written.
				let out = reuse ?? (t, pool is Pool ?? (pool.tensor(t.element, t.shape), zerosLike(t.element, t.shape)))
				let n = t.floats.len()
				let tasks = (n / parallelFrom).clamp(1, 32)
				if tasks == 1 {
					unaryFloats(op, p, t.floats, out.floats, 0, n)
				} else {
					forall let k in 0..tasks {
						let from = n * k / tasks
						unaryFloats(op, p, t.floats, out.floats, from, n * (k + 1) / tasks - from)
					}
				}
				roundTo(out)
				return out
			case Storage.Doubles:
				let out = zerosLike(t.element, t.shape)
				for let i = 0; i < t.doubles.len(); i++ {
					out.doubles[i] = unaryDouble(op, p, t.doubles[i])
				}
				return out
			case Storage.Ints:
				fail "onnx: {op.name} of {t.element.name}" unless op := Unary.Abs || Unary.Neg || Unary.Sign || Unary.Relu
				let out = zerosLike(t.element, t.shape)
				let bits = elementBits(t.element)
				let signed = t.element := ElementType.Int8 || ElementType.Int16 || ElementType.Int32 || ElementType.Int64 || ElementType.Int4 || ElementType.Int2
				for let i = 0; i < t.ints.len(); i++ {
					let v = t.ints[i]
					let r = v
					match op {
						case Unary.Abs:
							r = v.abs()
						case Unary.Neg:
							r = -v
						case Unary.Sign:
							r = v > 0 ?? (1, v < 0 ?? (-1, 0))
						default:
							r = v.max(0)
					}
					out.ints[i] = wrap(r, bits, signed)
				}
				return out
			default:
				fail "onnx: {op.name} of {t.element.name}"
		}
	}

	// `op` on n values of `x` from `from` into `out`, eight lanes at a time
	// where the function has a lane form.
	internal def unaryFloats(op Unary, p UnaryParams, x float32[], out float32[], from int, n int) {
		if op == Unary.Erf {
			tensor.erf(x, out, from, n)
			return
		}
		let i = from
		let end = from + n
		let zero = simd.splat8<float32>(float32(0))
		let one = simd.splat8<float32>(float32(1))
		let vectorized = op := Unary.Abs || Unary.Neg || Unary.Exp || Unary.Sqrt || Unary.Reciprocal || Unary.Floor || Unary.Ceil || Unary.Sigmoid || Unary.Tanh || Unary.Relu || Unary.LeakyRelu || Unary.Swish || Unary.HardSigmoid || Unary.HardSwish
		if vectorized {
			let alpha = simd.splat8<float32>(p.alpha)
			let beta = simd.splat8<float32>(p.beta)
			for; i + 8 <= end; i += 8 {
				let v = simd.load8<float32>(x, i)
				let r = v
				match op {
					case Unary.Abs:
						r = simd.abs(v)
					case Unary.Neg:
						r = zero - v
					case Unary.Exp:
						r = simd.exp(v)
					case Unary.Sqrt:
						r = simd.sqrt(v)
					case Unary.Reciprocal:
						r = one / v
					case Unary.Floor:
						r = simd.floor(v)
					case Unary.Ceil:
						r = simd.ceil(v)
					case Unary.Sigmoid:
						r = one / (one + simd.exp(zero - v))
					case Unary.Tanh:
						r = simd.tanh(v)
					case Unary.Relu:
						r = simd.max(v, zero)
					case Unary.LeakyRelu:
						r = simd.blend(simd.lt(v, zero), v * alpha, v)
					case Unary.Swish:
						r = v / (one + simd.exp(zero - alpha * v))
					case Unary.HardSigmoid:
						r = simd.max(zero, simd.min(one, alpha * v + beta))
					default:
						// HardSwish: x · max(0, min(1, x / 6 + 1/2)).
						r = v * simd.max(zero, simd.min(one, v * simd.splat8<float32>(float32(1) / float32(6)) + simd.splat8<float32>(float32(0.5))))
				}
				simd.store8<float32>(out, i, r)
			}
		}
		for; i < end; i++ {
			out[i] = float32(unaryDouble(op, p, float(x[i])))
		}
	}

	// One value of `op`, computed in float64.
	internal def unaryDouble(op Unary, p UnaryParams, v float) float {
		let alpha = float(p.alpha)
		let beta = float(p.beta)
		match op {
			case Unary.Abs:
				return v.abs()
			case Unary.Neg:
				return -v
			case Unary.Exp:
				return math.E ** v
			case Unary.Log:
				return v < 0.0 || v != v ?? (0.0 / 0.0, v == 0.0 ?? (-1.0 / 0.0, math.ln(v)))
			case Unary.Sqrt:
				return v < 0.0 ?? (0.0 / 0.0, math.sqrt(v))
			case Unary.Reciprocal:
				return 1.0 / v
			case Unary.Floor:
				return v.floor()
			case Unary.Ceil:
				return v.ceil()
			case Unary.Round:
				return roundEven(v)
			case Unary.Sin:
				return math.sin(v)
			case Unary.Cos:
				return math.cos(v)
			case Unary.Tan:
				return math.tan(v)
			case Unary.Asin:
				return v.abs() > 1.0 ?? (0.0 / 0.0, math.atan2(v, math.sqrt(1.0 - v * v)))
			case Unary.Acos:
				return v.abs() > 1.0 ?? (0.0 / 0.0, math.acos(v))
			case Unary.Atan:
				return math.atan(v)
			case Unary.Sinh:
				return (math.E ** v - math.E ** -v) / 2.0
			case Unary.Cosh:
				return (math.E ** v + math.E ** -v) / 2.0
			case Unary.Asinh:
				let a = v.abs()
				let r = math.ln(a + math.sqrt(a * a + 1.0))
				return v < 0.0 ?? (-r, r)
			case Unary.Acosh:
				return v < 1.0 ?? (0.0 / 0.0, math.ln(v + math.sqrt(v * v - 1.0)))
			case Unary.Atanh:
				return v.abs() > 1.0 ?? (0.0 / 0.0, v.abs() == 1.0 ?? (v / 0.0, 0.5 * math.ln((1.0 + v) / (1.0 - v))))
			case Unary.Erf:
				return math.erf(v)
			case Unary.Sigmoid:
				return v >= 0.0 ?? (1.0 / (1.0 + math.E ** -v), math.E ** v / (1.0 + math.E ** v))
			case Unary.Tanh:
				return math.tanh(v)
			case Unary.Relu:
				return v != v ?? (v, v.max(0.0))
			case Unary.Softplus:
				return v > 20.0 ?? (v, math.ln(1.0 + math.E ** v))
			case Unary.Softsign:
				return v / (1.0 + v.abs())
			case Unary.Sign:
				return v > 0.0 ?? (1.0, v < 0.0 ?? (-1.0, v))
			case Unary.Elu:
				return v < 0.0 ?? (alpha * (math.E ** v - 1.0), v)
			case Unary.Selu:
				return float(p.gamma) * (v <= 0.0 ?? (alpha * (math.E ** v - 1.0), v))
			case Unary.LeakyRelu:
				return v < 0.0 ?? (alpha * v, v)
			case Unary.ThresholdedRelu:
				return v > alpha ?? (v, 0.0)
			case Unary.HardSigmoid:
				return (alpha * v + beta).clamp(0.0, 1.0)
			case Unary.HardSwish:
				return v * (v / 6.0 + 0.5).clamp(0.0, 1.0)
			case Unary.Mish:
				return v * math.tanh(v > 20.0 ?? (v, math.ln(1.0 + math.E ** v)))
			case Unary.Celu:
				return v.max(0.0) + (alpha * (math.E ** (v / alpha) - 1.0)).min(0.0)
			case Unary.Gelu:
				return 0.5 * v * (1.0 + math.erf(v / math.Sqrt2))
			case Unary.GeluTanh:
				return 0.5 * v * (1.0 + math.tanh(math.sqrt(2.0 / math.Pi) * (v + 0.044715 * v * v * v)))
			case Unary.Swish:
				return v / (1.0 + math.E ** (-alpha * v))
			default:
				// Shrink: alpha holds bias, beta lambd.
				return v < -beta ?? (v + alpha, v > beta ?? (v - alpha, 0.0))
		}
	}

	// v rounded to the nearest integer, halves to even.
	internal def roundEven(v float) float {
		return v when v != v || v.abs() == 1.0 / 0.0
		let f = v.floor()
		let d = v - f
		if d > 0.5 {
			return f + 1.0
		}
		if d < 0.5 {
			return f
		}
		return (f / 2.0).floor() * 2.0 == f ?? (f, f + 1.0)
	}

	// IsNaN and IsInf: Bool values of the same shape.
	internal def classify(c Call, nan bool) !none {
		let t = try c.tensor(0)
		let out = zerosLike(ElementType.Bool, t.shape)
		let negative = c.int("detect_negative", 1) != 0
		let positive = c.int("detect_positive", 1) != 0
		let n = t.count()
		for let i = 0; i < n; i++ {
			let v = storageOf(t.element) == Storage.Doubles ?? (t.doubles[i], float(t.floats[i]))
			if nan {
				out.ints[i] = v != v ?? (1, 0)
			} else {
				out.ints[i] = (v == 1.0 / 0.0 && positive) || (v == -1.0 / 0.0 && negative) ?? (1, 0)
			}
		}
		c.out(0, out)
		return none
	}

	// Not of Bool values, BitwiseNot of integers.
	internal def invert(c Call, bitwise bool) !none {
		let t = try c.tensor(0)
		let out = zerosLike(t.element, t.shape)
		let bits = elementBits(t.element)
		let signed = t.element := ElementType.Int8 || ElementType.Int16 || ElementType.Int32 || ElementType.Int64 || ElementType.Int4 || ElementType.Int2
		for let i = 0; i < t.ints.len(); i++ {
			out.ints[i] = bitwise ?? (wrap(~t.ints[i], bits, signed), t.ints[i] == 0 ?? (1, 0))
		}
		c.out(0, out)
		return none
	}

	// Clip: values held within min and max (inputs from opset 11,
	// attributes before; a missing bound does not clip).
	internal def clip(c Call) !none {
		let t = try c.tensor(0)
		let low = float(-3.4028234663852886e38)
		let high = float(3.4028234663852886e38)
		let (lowInt, highInt) = (math.MIN_INT64, math.MAX_INT64)
		if c.opset < 11 {
			low = float(c.float("min", float32(-3.4028234663852886e38)))
			high = float(c.float("max", float32(3.4028234663852886e38)))
		} else {
			if c.has(1) {
				let m = try c.tensor(1)
				low = scalarFloat(m)
				lowInt = scalarInt(m)
			}
			if c.has(2) {
				let m = try c.tensor(2)
				high = scalarFloat(m)
				highInt = scalarInt(m)
			}
		}
		let out = zerosLike(t.element, t.shape)
		match storageOf(t.element) {
			case Storage.Floats:
				// min first, then max: with min above max every value is max.
				let (l, h) = (float32(low), float32(high))
				for let i = 0; i < t.floats.len(); i++ {
					let v = t.floats[i]
					let r = v < l ?? (l, v)
					out.floats[i] = v != v ?? (v, r > h ?? (h, r))
				}
			case Storage.Doubles:
				for let i = 0; i < t.doubles.len(); i++ {
					let v = t.doubles[i]
					let r = v < low ?? (low, v)
					out.doubles[i] = v != v ?? (v, r > high ?? (high, r))
				}
			default:
				for let i = 0; i < t.ints.len(); i++ {
					let r = t.ints[i].max(lowInt)
					out.ints[i] = r.min(highInt)
				}
		}
		c.out(0, out)
		return none
	}

	// The first value of `t` as a float.
	internal def scalarFloat(t Tensor) float {
		match storageOf(t.element) {
			case Storage.Floats:
				return float(t.floats[0])
			case Storage.Doubles:
				return t.doubles[0]
			default:
				return float(t.ints[0])
		}
	}

	// The first value of `t` as an int.
	internal def scalarInt(t Tensor) int {
		match storageOf(t.element) {
			case Storage.Floats:
				return int(t.floats[0])
			case Storage.Doubles:
				return int(t.doubles[0])
			default:
				return t.ints[0]
		}
	}

	// Cast and CastLike: every value converted to `to`: floats rounded to
	// the narrower float types (saturating where `saturate` asks, the
	// default), truncated toward zero into integers and wrapped to their
	// width, Bool true for non-zero; strings parsed as numbers and
	// numbers written as text.
	internal def cast(t Tensor, to ElementType, saturate bool, roundMode string = "up") !Tensor {
		let out = zerosLike(to, t.shape)
		let n = t.count()
		let from = storageOf(t.element)
		if to == ElementType.Float8E8M0 {
			for let i = 0; i < n; i++ {
				out.floats[i] = minifloat(to, e8m0Code(float32(try asFloat(t, i)), saturate, roundMode))
			}
			return out
		}
		match storageOf(to) {
			case Storage.Floats:
				for let i = 0; i < n; i++ {
					out.floats[i] = float32(try asFloat(t, i))
				}
				if !(to := ElementType.Float || ElementType.Float16 || ElementType.BFloat16) {
					// Without saturation an overflow becomes infinity or NaN;
					// with it infinities too become the largest finite value.
					for let i = 0; i < n; i++ {
						let v = out.floats[i]
						if !saturate {
							out.floats[i] = overflowed(to, v) ?? (unsaturated(to, v), v)
						} else if v.abs() == float32(1) / float32(0) {
							out.floats[i] = v > float32(0) ?? (float32(3.4e38), float32(-3.4e38))
						}
					}
				}
				roundTo(out)
			case Storage.Doubles:
				for let i = 0; i < n; i++ {
					out.doubles[i] = try asFloat(t, i)
				}
			case Storage.Ints:
				let bits = elementBits(to)
				let signed = to := ElementType.Int8 || ElementType.Int16 || ElementType.Int32 || ElementType.Int64 || ElementType.Int4 || ElementType.Int2
				for let i = 0; i < n; i++ {
					if to == ElementType.Bool {
						out.ints[i] = (try asFloat(t, i)) != 0.0 ?? (1, 0)
					} else if from == Storage.Ints {
						out.ints[i] = wrap(t.ints[i], bits, signed)
					} else {
						let v = try asFloat(t, i)
						out.ints[i] = v != v ?? (0, wrap(truncated(v), bits, signed))
					}
				}
			default:
				for let i = 0; i < n; i++ {
					out.strings[i] = textOf(t, i)
				}
		}
		return out
	}

	// Value `i` of `t` as a float; a string parsed.
	// Fails for a string that is not a number.
	internal def asFloat(t Tensor, i int) !float {
		match storageOf(t.element) {
			case Storage.Floats:
				return float(t.floats[i])
			case Storage.Doubles:
				return t.doubles[i]
			case Storage.Ints:
				let unsigned64 = t.element == ElementType.Uint64 && t.ints[i] < 0
				return unsigned64 ?? (float(uint(t.ints[i])), float(t.ints[i]))
			default:
				let s = t.strings[i].trim().lower()
				return 1.0 / 0.0 when s := "inf" || "+inf" || "infinity" || "+infinity"
				return -1.0 / 0.0 when s := "-inf" || "-infinity"
				return 0.0 / 0.0 when s := "nan" || "+nan" || "-nan"
				return parseFloat<float>(s)
		}
	}

	// A float truncated toward zero to an integer, saturated at the int64
	// range (the wrap to `bits` follows).
	internal def truncated(v float) int {
		let t = v < 0.0 ?? (v.ceil(), v.floor())
		return math.MAX_INT64 when t >= 9.2233720368547758e18
		return math.MIN_INT64 when t <= -9.2233720368547758e18
		return int(t)
	}

	// The E8M0 code (a power of two, biased as float32's exponent) of `v`
	// for a cast: rounded `up` (away from zero), `down` or to the
	// `nearest` (ties up), and saturated to the codes 0 to 254 or, without
	// saturation, NaN (255) out of range.
	internal def e8m0Code(v float32, saturate bool, roundMode string) int {
		return 255 when v != v
		if v == float32(0) || v.abs() == float32(1) / float32(0) {
			return saturate ?? (v == float32(0) ?? (0, 254), 255)
		}
		let bits = int(__bitcast_u32_from_f32(v.abs()))
		let exponent = (bits >> 23) & 255
		let mantissa = bits & 0x7FFFFF
		let code = exponent
		match roundMode {
			case "down":
				code = exponent
			case "nearest":
				code = exponent + (mantissa >= 0x400000 ?? (1, 0))
			default:
				code = exponent + (mantissa != 0 ?? (1, 0))
		}
		return code > 254 ?? (saturate ?? (254, 255), code)
	}

	// Whether `v` is beyond the largest finite value of the narrow float
	// type `to`.
	internal def overflowed(to ElementType, v float32) bool {
		let largest = float32(0)
		match to {
			case ElementType.Float8E4M3FN:
				largest = float32(448)
			case ElementType.Float8E4M3FNUZ:
				largest = float32(240)
			case ElementType.Float8E5M2:
				largest = float32(57344)
			case ElementType.Float8E5M2FNUZ:
				largest = float32(57344)
			default:
				return false
		}
		return v.abs() > largest
	}

	// What an unsaturated cast stores for a value beyond the type's range:
	// infinity for E5M2, NaN for the others.
	internal def unsaturated(to ElementType, v float32) float32 {
		return to == ElementType.Float8E5M2 ?? (v > float32(0) ?? (float32(1) / float32(0), float32(-1) / float32(0)), float32(0) / float32(0))
	}

	// Value `i` of `t` as text, as ONNX's Cast writes numbers.
	internal def textOf(t Tensor, i int) string {
		match storageOf(t.element) {
			case Storage.Floats:
				return floatText(float(t.floats[i]))
			case Storage.Doubles:
				return floatText(t.doubles[i])
			case Storage.Ints:
				return t.element == ElementType.Bool ?? (t.ints[i] != 0 ?? ("1", "0"), "{t.ints[i]}")
			default:
				return t.strings[i]
		}
	}

	internal def floatText(v float) string {
		return "NaN" when v != v
		return "INF" when v == 1.0 / 0.0
		return "-INF" when v == -1.0 / 0.0
		return "{v}"
	}
}
