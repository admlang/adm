partial module std.ai.retrieval {
	use (
		std.math
		std.simd
	)

	// Links a node keeps per level above the bottom one; the bottom level
	// keeps twice as many.
	internal const graphLinks = 16

	// Candidates an insertion follows per level.
	internal const buildBreadth = 200

	// Nodes inserted together at most: they search the graph as it was
	// before them on tasks, and find each other by comparing every pair.
	internal const graphBatch = 1024

	// A hierarchical navigable small world graph (Malkov and Yashunin,
	// 2016) over unit vectors: the approximate nearest neighbours of a
	// question in about logarithmic time. Each node is on levels 0 to its
	// own, drawn so that each level holds about 1/16 of the one below;
	// a search walks greedily down from the top node's level and searches
	// the bottom level broadly. Inserted in batches whose searches run on
	// tasks; the links come out the same whatever the timing.
	internal type Graph {
		// Per node, its links level by level: at each level a count then
		// room for the level's links (2 × graphLinks at 0, graphLinks
		// above).
		links  int32[][] = []
		levels int[]     = []
		entry  int       = -1
		top    int       = -1

		def new() {}

		def len() int {
			return levels.len()
		}

		def clear() {
			links = int32[][]
			levels = int[]
			entry = -1
			top = -1
		}

		// The nodes up to `count` added: vectors `vectors[node * dims:]`.
		def grow(vectors float32[], dims int, count int) {
			for len() < count {
				let start = len()
				let size = start == 0 ?? ((count - start).min(1024), (count - start).min(start.clamp(1, graphBatch)))
				insertBatch(vectors, dims, start, start + size)
			}
		}

		// Inserts nodes `from` to `to`, which are not in the graph yet.
		def insertBatch(vectors float32[], dims int, from int, to int) {
			let size = to - from
			for let node = from; node < to; node++ {
				let level = levelOf(node)
				levels.push(level)
				let room int32[]
				room.len(slotOf(level + 1))
				links.push(room)
			}
			// Each new node's candidates per level: from the graph as it was,
			// then from the other new nodes, best first.
			let picked int32[][][]
			picked.len(size)
			let bands = size.clamp(1, 64)
			forall let band in 0..bands {
				let seen = new Visited(from)
				let sims float32[]
				sims.len(size)
				for let k = size * band / bands; k < size * (band + 1) / bands; k++ {
					let node = from + k
					let level = levels[node]
					let found = searchFor(vectors, dims, vectors, node * dims, level, buildBreadth, seen)
					for let j = 0; j < size; j++ {
						sims[j] = j == k ?? (float32(-3), dotAt(vectors, node * dims, vectors, (from + j) * dims, dims))
					}
					let mine int32[][]
					for let l = 0; l <= level; l++ {
						let cands = new Ranked(true)
						if l < found.len() {
							let f = found[l]
							for let i = 0; i < f.len(); i++ {
								cands.keep(f.scores[i], f.ids[i], buildBreadth)
							}
						}
						for let j = 0; j < size; j++ {
							cands.keep(sims[j], from + j, buildBreadth) when j != k && levels[from + j] >= l
						}
						mine.push(chooseLinks(vectors, dims, cands, graphLinks))
					}
					picked[k] = mine
				}
			}
			// Each new node's own links, then the links back to it from the
			// nodes it chose, gathered in node order.
			let incoming = new map<int, int[]>()
			for let k = 0; k < size; k++ {
				let node = from + k
				for let (l, chosen) in picked[k] {
					setLinks(node, l, chosen)
					for let (_, other) in chosen {
						let list = incoming.get(int(other))
						if list is int[] {
							list.push(l, node)
						} else {
							incoming.set(int(other), int[l, node])
						}
					}
				}
			}
			let touched int[]
			for let (node, _) in incoming {
				touched.push(node)
			}
			touched = touched.sort((a, b) => a - b)
			forall let band in 0..touched.len().clamp(1, 64) {
				let parts = touched.len().clamp(1, 64)
				for let t = touched.len() * band / parts; t < touched.len() * (band + 1) / parts; t++ {
					let node = touched[t]
					let pairs = incoming.get(node)
					continue when pairs is none
					for let l = 0; l <= levels[node]; l++ {
						let merged = new Ranked(true)
						let at = slotOf(l)
						let own = links[node]
						let wide = capOf(l)
						let extra = 0
						for let p = 0; p < pairs.len(); p += 2 {
							extra++ when pairs[p] == l
						}
						continue when extra == 0
						// Room for every new link: appended as they come.
						if int(own[at]) + extra <= wide {
							for let p = 0; p < pairs.len(); p += 2 {
								continue unless pairs[p] == l
								let count = int(own[at])
								let other = int32(pairs[p + 1])
								let known = false
								for let i = 0; i < count; i++ {
									known = known || own[at + 1 + i] == other
								}
								continue when known
								own[at + 1 + count] = other
								own[at] = int32(count + 1)
							}
							continue
						}
						for let i = 0; i < int(own[at]); i++ {
							let other = int(own[at + 1 + i])
							merged.keep(dotAt(vectors, node * dims, vectors, other * dims, dims), other, wide + extra)
						}
						for let p = 0; p < pairs.len(); p += 2 {
							continue unless pairs[p] == l
							let other = pairs[p + 1]
							continue when merged.holds(other)
							merged.keep(dotAt(vectors, node * dims, vectors, other * dims, dims), other, wide + extra)
						}
						let chosen = merged.len() <= wide ?? (merged.bestFirst(), chooseLinks(vectors, dims, merged, wide))
						setLinks(node, l, chosen)
					}
				}
			}
			for let node = from; node < to; node++ {
				if levels[node] > top {
					top = levels[node]
					entry = node
				}
			}
		}

		// The `count` nodes nearest the unit vector `query[at:]`, nearest
		// first, searching the bottom level `breadth` wide.
		def search(vectors float32[], dims int, query float32[], at int, count int, breadth int) (int[], float32[]) {
			let ids int[]
			let sims float32[]
			return (ids, sims) when entry < 0
			let seen = new Visited(len())
			let found = searchFor(vectors, dims, query, at, 0, breadth.max(count), seen)
			let bottom = found[0]
			let order = bottom.bestFirst()
			for let i = 0; i < order.len().min(count); i++ {
				ids.push(int(order[i]))
				sims.push(bottom.scoreOf(int(order[i])))
			}
			return (ids, sims)
		}

		// The best nodes per level from 0 to `level` for `query[at:]` (`breadth`
		// of them each), walking greedily down from the entry above it.
		// Empty while the graph is.
		internal def searchFor(vectors float32[], dims int, query float32[], at int, level int, breadth int, seen Visited) Ranked[] {
			let out Ranked[]
			return out when entry < 0
			let current = entry
			let best = dotAt(query, at, vectors, entry * dims, dims)
			for let l = top; l > level; l-- {
				let moved = true
				for moved {
					moved = false
					let own = links[current]
					let slot = slotOf(l)
					for let i = 0; i < int(own[slot]); i++ {
						let other = int(own[slot + 1 + i])
						let s = dotAt(query, at, vectors, other * dims, dims)
						if s > best {
							best = s
							current = other
							moved = true
						}
					}
				}
			}
			out.len(level.min(top) + 1)
			let starts = int[current]
			for let l = level.min(top); l >= 0; l-- {
				let found = searchLevel(vectors, dims, query, at, starts, l, breadth, seen)
				out[l] = found
				starts = int[]
				for let (_, id) in found.bestFirst() {
					starts.push(int(id))
				}
			}
			return out
		}

		// The `breadth` best nodes of level `level` reached from `starts`.
		internal def searchLevel(vectors float32[], dims int, query float32[], at int, starts int[], level int, breadth int, seen Visited) Ranked {
			seen.reset()
			let results = new Ranked(true)
			let frontier = new Ranked(false)
			for let (_, s) in starts {
				seen.mark(s)
				let sim = dotAt(query, at, vectors, s * dims, dims)
				results.keep(sim, s, breadth)
				frontier.push(sim, s)
			}
			let slot = slotOf(level)
			for frontier.len() > 0 {
				let sim = frontier.topScore()
				let node = frontier.topId()
				frontier.pop()
				break when results.len() >= breadth && sim < results.topScore()
				let own = links[node]
				for let i = 0; i < int(own[slot]); i++ {
					let other = int(own[slot + 1 + i])
					continue unless seen.mark(other)
					let s = dotAt(query, at, vectors, other * dims, dims)
					if results.len() < breadth || s > results.topScore() {
						frontier.push(s, other)
						results.keep(s, other, breadth)
					}
				}
			}
			return results
		}

		// Sets `node`'s links at `level`.
		internal def setLinks(node int, level int, chosen int32[]) {
			let own = links[node]
			let at = slotOf(level)
			own[at] = int32(chosen.len())
			for let (i, other) in chosen {
				own[at + 1 + i] = other
			}
		}
	}

	// Where level `level`'s count sits in a node's links.
	internal def slotOf(level int) int {
		return level == 0 ?? (0, 2 * graphLinks + 1 + (level - 1) * (graphLinks + 1))
	}

	// Links a node keeps at `level`.
	internal def capOf(level int) int {
		return level == 0 ?? (2 * graphLinks, graphLinks)
	}

	// The level of node `node`: ⌊-ln(u) / ln 16⌋ for a u in (0, 1] drawn
	// from the node's number, so a graph built again is the same.
	internal def levelOf(node int) int {
		let x = uint64(node) + uint64(0x9E3779B97F4A7C15)
		x = (x ^ (x >> 30)) * uint64(0xBF58476D1CE4E5B9)
		x = (x ^ (x >> 27)) * uint64(0x94D049BB133111EB)
		x = x ^ (x >> 31)
		let u = (float(x >> 11) + 1.0) / 9007199254740992.0
		return int(-math.ln(u) / math.ln(float(graphLinks))).min(30)
	}

	// Up to `count` of `cands` as links: best first, each kept only when
	// it is nearer the node than to every link kept before it, so links
	// point different ways (the paper's heuristic).
	internal def chooseLinks(vectors float32[], dims int, cands Ranked, count int) int32[] {
		let order = cands.bestFirst()
		let out int32[]
		for let (_, id) in order {
			break when out.len() >= count
			let toNode = cands.scoreOf(int(id))
			let kept = true
			for let (_, other) in out {
				if dotAt(vectors, int(id) * dims, vectors, int(other) * dims, dims) > toNode {
					kept = false
					break
				}
			}
			out.push(id) when kept
		}
		return out
	}

	// Scores with ids in a binary heap: the lowest score on top (`lowest`),
	// or the highest.
	internal type Ranked {
		scores float32[] = []
		ids    int32[]   = []
		lowest bool

		def new(lowest bool) {
			self.lowest = lowest
		}

		def len() int {
			return ids.len()
		}

		def topScore() float32 {
			return scores[0]
		}

		def topId() int {
			return int(ids[0])
		}

		// Whether `a` belongs above `b`.
		internal def above(a int, b int) bool {
			return lowest ?? (scores[a] < scores[b], scores[a] > scores[b])
		}

		internal def swap(a int, b int) {
			let s = scores[a]
			scores[a] = scores[b]
			scores[b] = s
			let i = ids[a]
			ids[a] = ids[b]
			ids[b] = i
		}

		def push(score float32, id int) {
			scores.push(score)
			ids.push(int32(id))
			let at = ids.len() - 1
			for at > 0 {
				let up = (at - 1) / 2
				break unless above(at, up)
				swap(at, up)
				at = up
			}
		}

		def pop() {
			let last = ids.len() - 1
			swap(0, last)
			scores.len(last)
			ids.len(last)
			let at = 0
			for {
				let l = 2 * at + 1
				break when l >= last
				let c = l + 1 < last && above(l + 1, l) ?? (l + 1, l)
				break unless above(c, at)
				swap(c, at)
				at = c
			}
		}

		// Adds the pair and drops the top while more than `most` are held:
		// on a lowest-first heap, the `most` best stay.
		def keep(score float32, id int, most int) {
			push(score, id)
			pop() when ids.len() > most
		}

		def holds(id int) bool {
			return ids.includes(int32(id))
		}

		def scoreOf(id int) float32 {
			let at = ids.indexOf(int32(id))
			return at >= 0 ?? (scores[at], float32(-3))
		}

		// The ids, highest score first.
		def bestFirst() int32[] {
			let order int[]
			for let i = 0; i < ids.len(); i++ {
				order.push(i)
			}
			order = order.sort((a, b) => scores[b] > scores[a] ?? (1, scores[b] < scores[a] ?? (-1, int(ids[a]) - int(ids[b]))))
			let out int32[]
			for let (_, i) in order {
				out.push(ids[i])
			}
			return out
		}
	}

	// The nodes a search has reached: a bit each, cleared word by word.
	internal type Visited {
		bits    uint64[] = []
		touched int[]    = []

		def new(count int) {
			bits.len((count + 63) / 64 + 1)
		}

		// Marks `node`; false when it was marked already.
		def mark(node int) bool {
			let w = node >> 6
			bits.len(w + 1) when w >= bits.len()
			let bit = uint64(1) << uint64(node & 63)
			return false when bits[w] & bit != uint64(0)
			touched.push(w) when bits[w] == uint64(0)
			bits[w] |= bit
			return true
		}

		def reset() {
			for let (_, w) in touched {
				bits[w] = uint64(0)
			}
			touched.len(0)
		}
	}

	// a[at:at + n] · b[bt:bt + n].
	internal def dotAt(a float32[], at int, b float32[], bt int, n int) float32 {
		let s0 = simd.splat8<float32>(float32(0))
		let s1 = simd.splat8<float32>(float32(0))
		let i = 0
		for; i + 16 <= n; i += 16 {
			s0 = simd.fma(simd.load8<float32>(a, at + i), simd.load8<float32>(b, bt + i), s0)
			s1 = simd.fma(simd.load8<float32>(a, at + i + 8), simd.load8<float32>(b, bt + i + 8), s1)
		}
		for; i + 8 <= n; i += 8 {
			s0 = simd.fma(simd.load8<float32>(a, at + i), simd.load8<float32>(b, bt + i), s0)
		}
		let sum = simd.sum(s0 + s1)
		for; i < n; i++ {
			sum += a[at + i] * b[bt + i]
		}
		return sum
	}
}
