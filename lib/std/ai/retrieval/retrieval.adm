// Retrieval: texts and documents cut into passages, embedded, and found
// again by meaning, so a model answers from them. Any embedder works: a
// model loaded with std.ai.embeddings, or a hosted one of the adm.ai
// libraries; any chat answers: a local session or a hosted one.
//
//     let index = new retrieval.Index(try embeddings.load("all-minilm.gguf"))
//     try index.add(try docs.load("handbook.md"), source = "handbook")
//     let answer = try index.ask(model.session(), "How many days of leave do I get?")
//
// Passages are searched by the cosine similarity of their vectors to the
// question's.
partial module std.ai.retrieval {
	use (
		std.os
		std.bytes
		std.formats.docs
		std.formats.docs::(Document)
		std.ai.embeddings
		std.ai.embeddings::(Embedder)
		std.ai.llm::(Chat)
	)

	// What starts an index file.
	internal const indexMagic = "ADMRIDX1"

	// Texts embedded per request to the embedder.
	internal const embedBatch = 32

	// A passage found for a question.
	struct Passage {
		text   string
		// Where the passage came from, as `Index.add` was told.
		source string
		// Cosine similarity to the question: 1 the same meaning, 0
		// unrelated.
		score  float
	}

	// Passages of texts and documents with their vectors, searched by
	// meaning. Add to it, search it, ask a chat from it; `save` keeps it
	// in a file `load` reads back.
	type Index {
		embedder         Embedder
		// Characters a passage holds at most; consecutive passages of one
		// text share `overlap` characters, so a sentence cut at a passage's
		// end is whole in the next.
		size             int         = 1200
		overlap          int         = 200
		internal texts   string[]
		internal sources string[]
		internal vectors float32[][]

		def new(embedder Embedder, size int = 1200, overlap int = 200) {
			self.embedder = embedder
			self.size = size
			self.overlap = overlap
		}

		// Passages held.
		def len() int {
			return texts.len()
		}

		// Cuts `text` into passages and adds them with their vectors;
		// returns how many.
		// Fails when the embedder does.
		def add(text string, source string = "") !int {
			let pieces = passagesOf(text, size, overlap)
			for let from = 0; from < pieces.len(); from += embedBatch {
				let batch = pieces[from:(from + embedBatch).min(pieces.len())].clone()
				let made = try embedder.embed(batch)
				for let (k, v) in made {
					texts.push(batch[k])
					sources.push(source)
					vectors.push(v)
				}
			}
			return pieces.len()
		}

		// Adds `document` as Markdown; `source` is its title when left out.
		// Fails like the other `add`.
		def add(document Document, source string = "") !int {
			return try add(new docs.Markdown().encode(document), source.len() > 0 ?? (source, document.title))
		}

		// The `count` passages nearest in meaning to `question`, nearest
		// first.
		// Fails when the embedder does.
		def search(question string, count int = 4) !Passage[] {
			let out Passage[]
			return out when texts.len() == 0
			let query = try embedder.embed(question)
			for let (_, at) in embeddings.nearest(query, vectors, count) {
				out.push(Passage{text: texts[at], source: sources[at], score: embeddings.similarity(query, vectors[at])})
			}
			return out
		}

		// Asks `chat` `question` with the `count` nearest passages before it,
		// to answer from them and name the sources it used; returns the
		// answer.
		// Fails like `search` and `Chat.say`.
		def ask(chat Chat, question string, count int = 4) !string {
			let found = try search(question, count)
			let prompt = "Answer the question from these passages. Name the sources you used; say so when the passages do not hold the answer.\n\n"
			for let (k, p) in found {
				prompt += "[{k + 1}] ({p.source.len() > 0 ?? (p.source, "unnamed")})\n{p.text}\n\n"
			}
			return try chat.say(prompt + "Question: " + question)
		}

		// Drops the passages of `source`; returns how many.
		def remove(source string) int {
			let kept = 0
			for let i = 0; i < texts.len(); i++ {
				continue when sources[i] == source
				texts[kept] = texts[i]
				sources[kept] = sources[i]
				vectors[kept] = vectors[i]
				kept++
			}
			let removed = texts.len() - kept
			texts.len(kept)
			sources.len(kept)
			vectors.len(kept)
			return removed
		}

		// Writes the passages and vectors to `path`.
		// Fails when the file cannot be written.
		def save(path string) !none {
			let out = new bytes.Buffer()
			try out.writeString(indexMagic)
			try out.write(uint32(texts.len()), bytes.Endian.Little)
			for let (i, text) in texts {
				try writeText(out, sources[i])
				try writeText(out, text)
				let v = vectors[i]
				try out.write(uint32(v.len()), bytes.Endian.Little)
				for let (_, x) in v {
					try out.write(x, bytes.Endian.Little)
				}
			}
			return os.writeFile(path, out.bytes())
		}
	}

	// An index `save` wrote, its questions embedded by `embedder` (the one
	// that made it, or the vectors do not compare).
	// Fails when the file cannot be read or is not an index.
	def load(path string, embedder Embedder) !Index {
		let data = try os.readFile(path)
		let reader = new bytes.BinaryReader(new bytes.Reader(data), bytes.Endian.Little, none)
		fail "retrieval: {path} is not an index" unless (try reader.readString(indexMagic.len())) == indexMagic
		let index = new Index(embedder)
		let count = int(try reader.read<uint32>())
		for let i = 0; i < count; i++ {
			index.sources.push(try readText(reader))
			index.texts.push(try readText(reader))
			let n = int(try reader.read<uint32>())
			let v float32[]
			v.len(n)
			for let k = 0; k < n; k++ {
				v[k] = try reader.read<float32>()
			}
			index.vectors.push(v)
		}
		return index
	}

	internal def writeText(out bytes.Buffer, text string) !none {
		let data = text.bytes()
		try out.write(uint32(data.len()), bytes.Endian.Little)
		try out.write(data)
		return none
	}

	internal def readText(reader bytes.BinaryReader) !string {
		let n = int(try reader.read<uint32>())
		return string(try reader.read(n))
	}

	// `text` cut into passages of at most `size` characters at paragraph
	// ends, else sentence ends, else spaces, each after the first opening
	// with the last `overlap` characters of the one before (from a word's
	// start).
	def passagesOf(text string, size int, overlap int) string[] {
		let out string[]
		let units string[]
		for let (_, paragraph) in text.split("\n\n") {
			let trimmed = paragraph.trim()
			continue when trimmed.len() == 0
			units.push(...splitLong(trimmed, size))
		}
		let current = ""
		for let (_, unit) in units {
			if current.len() > 0 && current.len() + 2 + unit.len() > size {
				out.push(current)
				let tail = tailOf(current, overlap)
				current = tail.len() > 0 && tail.len() + 2 + unit.len() <= size ?? (tail + "\n\n" + unit, unit)
			} else {
				current = current.len() > 0 ?? (current + "\n\n" + unit, unit)
			}
		}
		out.push(current) when current.len() > 0
		return out
	}

	// A paragraph longer than `size` cut at sentence ends, else spaces,
	// else anywhere.
	internal def splitLong(paragraph string, size int) string[] {
		let out string[]
		let rest = paragraph
		for rest.len() > size {
			let cut = -1
			for let (_, end) in string[". ", "? ", "! ", "\n", "; ", ", ", " "] {
				let at = rest.slice(0, size).lastIndexOf(end)
				if at > size / 3 {
					cut = at + end.len()
					break
				}
			}
			cut = size when cut <= 0
			out.push(rest.slice(0, cut).trim())
			rest = rest.slice(cut).trim()
		}
		out.push(rest) when rest.len() > 0
		return out
	}

	// The last `count` characters of `text` from a word's start; "" for 0.
	internal def tailOf(text string, count int) string {
		return "" when count <= 0 || text.len() <= count
		let tail = text.slice(text.len() - count)
		let space = tail.indexOf(" ")
		return space >= 0 ?? (tail.slice(space + 1), tail)
	}
}
