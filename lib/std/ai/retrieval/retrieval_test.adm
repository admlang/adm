partial module std.ai.retrieval {
	use (
		std.os
		std.testing
		std.services.runtime::(Runtime)
		std.formats.image::(Image)
		std.formats.audio::(Audio)
		std.formats.docs::(Document)
		std.ai.embeddings
		std.ai.llm::(Message, ToolCall)
	)

	// Vectors that count the letters of a text: texts that share words
	// are near, whatever their order.
	internal type LetterEmbedder {
		calls int

		def embed(text string) !float32[] {
			return (try embed(string[text]))[0]
		}

		def embed(texts string[]) !float32[][] {
			calls++
			let out float32[][]
			for let (_, t) in texts {
				let v float32[]
				v.len(26)
				for let (_, b) in t.lower().bytes() {
					v[int(b) - 97] += float32(1) when b >= byte(97) && b <= byte(122)
				}
				out.push(v)
			}
			return out
		}
	}

	// A chat that answers every question with what it was asked.
	internal type EchoChat {
		asked string

		def ask(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !none {
			asked = text
			return none
		}

		def ask(message Message) !none {
			asked = message.text
			return none
		}

		def next() !?string {
			return none
		}

		def say(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !string {
			asked = text
			return "answered"
		}

		def answer(call ToolCall, result string) !none {
			return none
		}

		def add(message Message) !none {
			return none
		}

		def messages() Message[] {
			return Message[]
		}

		def pendingCalls() ToolCall[] {
			return ToolCall[]
		}

		def useTool(value any) {}

		def fill(target any, text string) !none {
			return none
		}

		def reset() {}

		def length() int {
			return 0
		}
	}

	check "Retrieval" {
		@test()
		def TestPassagesAreCutAtBoundaries() {
			let text = "First paragraph about kettles.\n\nSecond paragraph about teapots. It has two sentences.\n\n" + "word ".repeat(80)
			let pieces = passagesOf(text, 120, 30)
			assert pieces.len() >= 4
			for let (_, p) in pieces {
				assert p.len() <= 120
			}
			assert pieces[0].startsWith("First paragraph") && pieces[0].contains("Second paragraph")
			// The next passage opens with the end of the one before.
			assert pieces[2].startsWith("word")
			assert passagesOf("", 100, 10).len() == 0
		}

		@test()
		def TestSearchRemoveSaveLoad() !none {
			let embedder = new LetterEmbedder()
			let index = new Index(embedder, size = 60, overlap = 0)
			assert (try index.add("zebra zebra zebra", source = "zoo")) == 1
			try index.add("apple pie with apples", source = "kitchen")
			try index.add("quick brown fox", source = "story")
			let found = try index.search("apples", count = 2)
			assert found.len() == 2 && found[0].source == "kitchen" && found[0].score > found[1].score && found[0].score <= 1.0
			let path = os.join(try os.appHome(), "index.bin")
			try index.save(path)
			let back = try load(path, embedder)
			assert back.len() == 3 && (try back.search("zebras", count = 1))[0].source == "zoo"
			assert back.remove("zoo") == 1 && back.len() == 2 && (try back.search("zebras", count = 1))[0].source != "zoo"
			let chat = new EchoChat()
			assert (try index.ask(chat, "What is in the pie?", count = 1)) == "answered"
			assert chat.asked.contains("[1] (kitchen)\napple pie with apples") && chat.asked.endsWith("Question: What is in the pie?")
			return none
		}

		// With ADM_TEST_EMBEDDINGS_MINILM_GGUF (all-MiniLM-L6-v2): passages
		// found by meaning, not by shared words.
		@test()
		def TestRealEmbedder() !none {
			let path = Runtime.getEnv("ADM_TEST_EMBEDDINGS_MINILM_GGUF")
			return none when path is none || path.len() == 0
			let index = new Index(try embeddings.load(path))
			try index.add("The office closes at six in the evening on weekdays.", source = "hours")
			try index.add("Employees get twenty-five days of paid leave a year.", source = "leave")
			try index.add("The cafeteria serves vegetarian lunch on Fridays.", source = "food")
			let found = try index.search("How much holiday do I have?", count = 1)
			fail "found {found[0].source}" unless found[0].source == "leave"
			return none
		}
	}
}
