partial module std.ai.retrieval {
	use (
		std.os
		std.testing
		std.services.runtime::(Runtime)
		std.formats.image::(Image)
		std.formats.audio::(Audio)
		std.formats.docs::(Document)
		std.ai.embeddings
		std.ai.llm::(Message, ToolCall, ToolOutput)
	)

	// Vectors that count the letters of a text: texts that share words
	// are near, whatever their order.
	internal type LetterEmbedder {
		calls int

		def embed(text string) !float32[] {
			return (try embed(string[text]))[0]
		}

		def embed(texts string[]) !float32[][] {
			calls++
			let out float32[][]
			for let (_, t) in texts {
				let v float32[]
				v.len(26)
				for let (_, b) in t.lower().bytes() {
					v[int(b) - 97] += float32(1) when b >= byte(97) && b <= byte(122)
				}
				out.push(v)
			}
			return out
		}
	}

	// Ranks a passage by how often it says "fox".
	internal type FoxReranker {
		def rank(question string, passages string[]) !float[] {
			let out float[]
			for let (_, p) in passages {
				out.push(float(p.split("fox").len() - 1) / 10.0)
			}
			return out
		}
	}

	// A unit vector of `dims` numbers drawn from `seed`.
	internal def randomUnit(seed int, dims int) float32[] {
		let v float32[]
		let x = uint64(seed) * uint64(0x9E3779B97F4A7C15) + uint64(1)
		for let i = 0; i < dims; i++ {
			x = x ^ (x << uint64(13))
			x = x ^ (x >> uint64(7))
			x = x ^ (x << uint64(17))
			v.push(float32(float(x >> 11) / 9007199254740992.0 - 0.5))
		}
		return unit(v)
	}

	// "#n" as the n-th random unit vector of `dims` numbers.
	internal type NumberEmbedder {
		dims int

		def new(dims int) {
			self.dims = dims
		}

		def embed(text string) !float32[] {
			return randomUnit(parseInt<int>(text.slice(1)), dims)
		}

		def embed(texts string[]) !float32[][] {
			let out float32[][]
			for let (_, t) in texts {
				out.push(try embed(t))
			}
			return out
		}
	}

	// A chat that answers every question with what it was asked.
	internal type EchoChat {
		asked string

		def ask(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !none {
			asked = text
			return none
		}

		def ask(message Message) !none {
			asked = message.text
			return none
		}

		def next() !?string {
			return none
		}

		def say(text string, images Image[] = Image[], audio Audio[] = Audio[], documents Document[] = Document[]) !string {
			asked = text
			return "answered"
		}

		def answer(call ToolCall, result string) !none {
			return none
		}

		def answer(call ToolCall, output ToolOutput) !none {
			return none
		}

		def add(message Message) !none {
			return none
		}

		def messages() Message[] {
			return Message[]
		}

		def pendingCalls() ToolCall[] {
			return ToolCall[]
		}

		def useTool(value any) {}

		def fill(target any, text string) !none {
			return none
		}

		def reset() {}

		def length() int {
			return 0
		}

		def length(message Message) !int {
			return 0
		}
	}

	check "Retrieval" {
		@test()
		def TestPassagesAreCutAtBoundaries() {
			let text = "First paragraph about kettles.\n\nSecond paragraph about teapots. It has two sentences.\n\n" + "word ".repeat(80)
			let pieces = passagesOf(text, 120, 30)
			assert pieces.len() >= 4
			for let (_, p) in pieces {
				assert p.len() <= 120
			}
			assert pieces[0].startsWith("First paragraph") && pieces[0].contains("Second paragraph")
			// The next passage opens with the end of the one before.
			assert pieces[2].startsWith("word")
			assert passagesOf("", 100, 10).len() == 0
		}

		@test()
		def TestSearchRemoveSaveLoad() !none {
			let embedder = new LetterEmbedder()
			let index = new Index(embedder, size = 60, overlap = 0)
			assert (try index.add("zebra zebra zebra", source = "zoo")) == 1
			try index.add("apple pie with apples", source = "kitchen")
			try index.add("quick brown fox", source = "story")
			let found = try index.search("apples", count = 2)
			assert found.len() == 2 && found[0].source == "kitchen" && found[0].score > found[1].score && found[0].score <= 1.0
			let path = os.join(try os.appHome(), "index.bin")
			try index.save(path)
			let back = try load(path, embedder)
			assert back.len() == 3 && (try back.search("zebras", count = 1))[0].source == "zoo"
			assert back.remove("zoo") == 1 && back.len() == 2 && (try back.search("zebras", count = 1))[0].source != "zoo"
			let chat = new EchoChat()
			assert (try index.ask(chat, "What is in the pie?", count = 1)) == "answered"
			assert chat.asked.contains("[1] (kitchen)\napple pie with apples") && chat.asked.endsWith("Question: What is in the pie?")
			return none
		}

		@test()
		def TestWordsAreFoldedUnicodeWords() {
			assert wordsOf("Straße, ÉCOLE! 3.14 can't — ½ 東京").equals(string["strasse", "école", "3.14", "can't", "½", "東", "京"])
			assert wordsOf("  ... ").len() == 0
		}

		// Words find a code no vector of letters tells apart; meaning finds
		// what shares no word; both together rank the passage both agree
		// on first.
		@test()
		def TestMatchingByWordsMeaningAndBoth() !none {
			let index = new Index(new LetterEmbedder(), size = 80, overlap = 0)
			try index.add("Error ERR-4471 means the disk is full.", source = "codes")
			try index.add("Error ERR-7144 means the disk is missing.", source = "other")
			try index.add("rorre 4471-RRE", source = "anagram")
			let words = try index.search("ERR-4471", count = 1, matching = Matching.Words)
			fail "by words {words[0].source}" unless words[0].source == "codes" && words[0].score > 0.0
			let meaning = try index.search("rorre RRE", count = 1, matching = Matching.Meaning)
			fail "by meaning {meaning[0].source}" unless meaning[0].source == "anagram"
			let both = try index.search("ERR-4471 disk full", count = 3)
			fail "both {both[0].source}" unless both[0].source == "codes" && both.len() == 3
			assert fuse(int[1, 2, 3], int[3, 1], 2).equals(int[1, 3])
			return none
		}

		@test()
		def TestRerankerOrdersTheCandidates() !none {
			let index = new Index(new LetterEmbedder(), size = 80, overlap = 0, reranker = new FoxReranker())
			try index.add("A quick brown fox.", source = "one")
			try index.add("A fox, a fox and a fox.", source = "three")
			try index.add("No animals here at all.", source = "none")
			let found = try index.search("animals", count = 2)
			fail "reranked {found[0].source} {found[0].score}" unless found[0].source == "three" && found[0].score == 0.3 && found[1].source == "one"
			return none
		}

		// The graph finds nearly every true nearest neighbour.
		@test()
		def TestGraphRecall() {
			let dims = 24
			let count = 3000
			let vectors float32[]
			for let i = 0; i < count; i++ {
				vectors.push(...randomUnit(i, dims))
			}
			let graph = new Graph()
			graph.grow(vectors, dims, count)
			assert graph.len() == count && graph.entry >= 0
			let hits = 0
			let asked = 0
			for let q = 0; q < 40; q++ {
				let query = randomUnit(100000 + q, dims)
				let exact = new Ranked(true)
				for let i = 0; i < count; i++ {
					exact.keep(dotAt(query, 0, vectors, i * dims, dims), i, 10)
				}
				let (ids, sims) = graph.search(vectors, dims, query, 0, 10, 64)
				assert ids.len() == 10 && sims[0] >= sims[9]
				for let (_, id) in exact.bestFirst() {
					hits++ when ids.includes(int(id))
					asked++
				}
			}
			assert hits * 100 >= asked * 95
		}

		// A large index searches through its graph and keeps it in the
		// file; a removal drops it.
		@test()
		def TestLargeIndexKeepsItsGraph() !none {
			let dims = 26
			let index = new Index(new NumberEmbedder(dims), size = 40, overlap = 0)
			for let i = 0; i <= exactLimit; i++ {
				try place(index, "#{i}", i % 2 == 0 ?? ("even", "odd"), randomUnit(i, dims))
			}
			let found = try index.search("#7", count = 1, matching = Matching.Meaning)
			assert found[0].text == "#7" && index.graph.len() == index.len()
			let path = os.join(try os.appHome(), "large.bin")
			try index.save(path)
			let back = try load(path, index.embedder)
			assert back.graph.len() == index.len() && (try back.search("#7", count = 1, matching = Matching.Meaning))[0].text == "#7"
			assert (try back.search("#7", count = 1, matching = Matching.Words))[0].text == "#7"
			assert back.remove("odd") == exactLimit / 2 && back.graph.len() == 0
			// Half the passages are searched one by one again.
			assert (try back.search("#8", count = 1))[0].text == "#8" && back.graph.len() == 0
			return none
		}

		// Files of the first version: source, text and vector per passage.
		@test()
		def TestFirstVersionFilesLoad() !none {
			let out byte[]
			out.push(...firstMagic.bytes())
			putU32(out, 1)
			putText(out, "zoo")
			putText(out, "zebra")
			putU32(out, 26)
			let v float32[]
			v.len(26)
			v[25] = float32(3)
			putFloats(out, v)
			let path = os.join(try os.appHome(), "first.bin")
			try os.writeFile(path, out)
			let back = try load(path, new LetterEmbedder())
			let found = try back.search("zebra", count = 1)
			// The question's letters against a vector of z only: 1/√5.
			assert back.len() == 1 && found[0].source == "zoo" && (found[0].score - 0.4472136).abs() < 1e-6
			return none
		}

		// With ADM_TEST_EMBEDDINGS_MINILM_GGUF (all-MiniLM-L6-v2): passages
		// found by meaning, not by shared words.
		@test()
		def TestRealEmbedder() !none {
			let path = Runtime.getEnv("ADM_TEST_EMBEDDINGS_MINILM_GGUF")
			return none when path is none || path.len() == 0
			let index = new Index(try embeddings.load(path))
			try index.add("The office closes at six in the evening on weekdays.", source = "hours")
			try index.add("Employees get twenty-five days of paid leave a year.", source = "leave")
			try index.add("The cafeteria serves vegetarian lunch on Fridays.", source = "food")
			let found = try index.search("How much holiday do I have?", count = 1)
			fail "found {found[0].source}" unless found[0].source == "leave"
			// A passage longer than the model reads is cut further.
			let long = new Index(index.embedder, size = 100000, overlap = 0)
			let made = try long.add("The kettle boils water quickly. ".repeat(200))
			fail "{made} passages" unless made > 1
			return none
		}
	}
}
