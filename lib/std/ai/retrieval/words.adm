partial module std.ai.retrieval {
	use (
		std.math
		std.text.unicode
		std.text.unicode::(Category)
	)

	// BM25's term frequency saturation and length normalisation (the
	// values Lucene and most search engines use).
	internal const bm25K1 = 1.2
	internal const bm25B = 0.75

	// The passages' words for searching by words: each word's passages
	// with how often it occurs there, and every passage's length in words.
	internal type Keywords {
		// Per word, its passages and counts in pairs, passages ascending.
		postings map<string, int[]>
		lengths  int[]              = []
		total    int                = 0

		def new() {
			postings = new map<string, int[]>()
		}

		def clear() {
			postings = new map<string, int[]>()
			lengths = int[]
			total = 0
		}

		// Adds the next passage, whose text is `text`.
		def add(text string) {
			let passage = lengths.len()
			let words = wordsOf(text)
			lengths.push(words.len())
			total += words.len()
			let counts = new map<string, int>()
			for let (_, w) in words {
				let n = counts.get(w)
				counts.set(w, n is int ?? (n + 1, 1))
			}
			for let (w, n) in counts {
				let list = postings.get(w)
				if list is int[] {
					list.push(passage, n)
				} else {
					postings.set(w, int[passage, n])
				}
			}
		}

		// The `count` passages that best match `question`'s words by BM25,
		// best first, with their scores; passages sharing no word with it
		// are left out.
		def search(question string, count int) (int[], float[]) {
			let ids int[]
			let found float[]
			let n = lengths.len()
			return (ids, found) when n == 0 || count <= 0
			let average = float(total) / float(n)
			let scores float[]
			scores.len(n)
			let asked = new map<string, bool>()
			for let (_, w) in wordsOf(question) {
				continue when asked.get(w) is bool
				asked.set(w, true)
				let list = postings.get(w)
				continue when list is none
				let df = float(list.len() / 2)
				let idf = math.ln(1.0 + (float(n) - df + 0.5) / (df + 0.5))
				for let p = 0; p < list.len(); p += 2 {
					let tf = float(list[p + 1])
					let norm = 1.0 - bm25B + bm25B * float(lengths[list[p]]) / average
					scores[list[p]] += idf * tf * (bm25K1 + 1.0) / (tf + bm25K1 * norm)
				}
			}
			let best = new Ranked(true)
			for let i = 0; i < n; i++ {
				best.keep(float32(scores[i]), i, count) when scores[i] > 0.0
			}
			for let (_, id) in best.bestFirst() {
				ids.push(int(id))
				found.push(scores[int(id)])
			}
			return (ids, found)
		}
	}

	// The words of `text` for searching: its UAX #29 words holding a
	// letter or a digit, case folded.
	internal def wordsOf(text string) string[] {
		let out string[]
		let folded = unicode.caseFold(text)
		let breaks = unicode.wordBreaks(folded)
		let next = 0
		let word = ""
		let wordy = false
		for let (i, ch) in folded {
			if next < breaks.len() && i == breaks[next] {
				out.push(word) when wordy
				word = ""
				wordy = false
				next++
			}
			word += ch
			wordy = wordy || isWordChar(ch)
		}
		out.push(word) when wordy
		return out
	}

	// Whether `ch` is a letter or a number.
	internal def isWordChar(ch char) bool {
		return true when ch.isAlphanumeric()
		return false when ch.isASCII()
		return unicode.category(ch) := Category.UppercaseLetter || Category.LowercaseLetter || Category.TitlecaseLetter || Category.ModifierLetter || Category.OtherLetter || Category.DecimalNumber || Category.LetterNumber || Category.OtherNumber
	}
}
