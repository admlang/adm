// The data English speech is read with, generated by tools/ai/gen_english.py
// (the layouts are written there) and embedded: misaki's word lists, spaCy's
// en_core_web_sm tokenizer and tagger, and g2p_en's model for the words the
// lists lack. Each file is decoded on first use.
internal partial module std.ai.speech.english {
	use (
		std.io
		std.bytes
		std.data.compress.flate
	)

	@embed("lexicon_us.bin")
	const usBlob byte[]

	@embed("lexicon_gb.bin")
	const gbBlob byte[]

	@embed("spacy.bin")
	const spacyBlob byte[]

	@embed("g2p_en.bin")
	const g2pBlob byte[]

	// The word lists, decoded on first use and shared by every task.
	type LexiconStore {
		internal us ?Lexicon
		internal gb ?Lexicon

		// The word lists of American (`british` false) or British English.
		// Fails when the embedded data does not decode.
		atomic def get(british bool) !Lexicon {
			if british && gb is none {
				let r = try open(gbBlob, "ADMLEX1", true)
				let golds = readWords(r)
				gb = new Lexicon(true, golds, readWords(r))
			}
			if !british && us is none {
				let r = try open(usBlob, "ADMLEX1", true)
				let golds = readWords(r)
				us = new Lexicon(false, golds, readWords(r))
			}
			let found = british ?? (gb, us)
			fail "speech: no English word lists" unless found is Lexicon
			return found
		}
	}

	// spaCy's English tokenizer and part-of-speech tagger, read on first use.
	type TaggerStore {
		internal tagger ?Tagger

		// Fails when the embedded data does not decode.
		atomic def get() !Tagger {
			tagger = readTagger(try open(spacyBlob, "ADMSPCY1", false)) when tagger is none
			let found = tagger
			fail "speech: no English tagger" unless found is Tagger
			return found
		}
	}

	// The model that spells out the sounds of a word no list holds, read on
	// first use.
	type GuesserStore {
		internal guesser ?Guesser

		// Fails when the embedded data does not decode.
		atomic def get() !Guesser {
			guesser = readGuesser(try open(g2pBlob, "ADMG2P1", false)) when guesser is none
			let found = guesser
			fail "speech: no English spelling model" unless found is Guesser
			return found
		}
	}

	// Each its own lock, so the first G2P reads the three at once.
	let lexicons = new LexiconStore()
	let taggers = new TaggerStore()
	let guessers = new GuesserStore()

	// The body of an embedded file after its magic: inflated when
	// `deflated`, else read in place.
	def open(blob byte[], magic string, deflated bool) !Cursor {
		let m = magic.bytes()
		fail "speech: embedded data is not {magic}" unless blob.len() > m.len() && blob[0:m.len()].equals(m)
		return new Cursor(blob[m.len():]) unless deflated
		let r = new flate.Reader(new bytes.Reader(blob[m.len():]))
		return new Cursor(try io.readAll(r))
	}

	// Cursor reads the varints, strings and float arrays of the files.
	type Cursor {
		data byte[]
		pos  int

		def new(data byte[]) {
			self.data = data
		}

		def varint() int {
			let n = 0
			let shift = 0
			for pos < data.len() {
				let b = int(data[pos])
				pos++
				n |= (b & 0x7f) << shift
				return n when b < 0x80
				shift += 7
			}
			return n
		}

		def byte1() int {
			pos++
			return int(data[pos - 1])
		}

		def text() string {
			let n = varint()
			let s = string(data[pos:pos + n])
			pos += n
			return s
		}

		// Skips a string, giving where its bytes start.
		def skipText() int {
			let n = varint()
			let at = pos
			pos += n
			return at
		}

		def uint64le() uint64 {
			let v = uint64(0)
			for let i = 7; i >= 0; i-- {
				v = (v << uint64(8)) | uint64(data[pos + i])
			}
			pos += 8
			return v
		}

		// A float array as its little-endian bytes.
		def floatBytes() byte[] {
			let n = varint()
			pos += 4 * n
			return data[pos - 4 * n:pos]
		}

		def floats() float32[] {
			let n = varint()
			let out float32[]
			out.len(n)
			for let i = 0; i < n; i++ {
				let a = pos + 4 * i
				out[i] = __bitcast_f32_from_u32(uint32(int(data[a]) | (int(data[a + 1]) << 8) | (int(data[a + 2]) << 16) | (int(data[a + 3]) << 24)))
			}
			pos += 4 * n
			return out
		}
	}

	// One word list: the entries in byte order of their words, read in
	// place.
	type Words {
		internal data    byte[]
		// Where each entry starts.
		internal entries int[]

		def new(data byte[], entries int[]) {
			self.data = data
			self.entries = entries
		}

		def has(word string) bool {
			return find(word.bytes()) >= 0
		}

		// The entry of `word`, none when the list lacks it.
		def get(word string) ?Entry {
			let at = find(word.bytes())
			return none when at < 0
			let r = new Cursor(data)
			r.pos = at
			r.skipText()
			let n = r.varint()
			let e = Entry{}
			if n == 0 {
				e.phonemes = r.text()
				return e
			}
			for let k = 0; k < n; k++ {
				e.tags.push(r.text())
				let present = r.byte1() == 1
				e.present.push(present)
				e.values.push(present ?? (r.text(), ""))
			}
			return e
		}

		// The start of the entry of `key`, or -1.
		internal def find(key byte[]) int {
			let lo = 0
			let hi = entries.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				let c = compareAt(entries[mid], key)
				return entries[mid] when c == 0
				if c < 0 {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			return -1
		}

		// The order of the word at `at` against `key`, by bytes.
		internal def compareAt(at int, key byte[]) int {
			// The word's length (a varint), read in place.
			let n = 0
			let shift = 0
			let from = at
			for {
				let b = int(data[from])
				from++
				n |= (b & 0x7f) << shift
				break when b < 0x80
				shift += 7
			}
			let m = n.min(key.len())
			for let i = 0; i < m; i++ {
				let a = int(data[from + i])
				let b = int(key[i])
				return a < b ?? (-1, 1) when a != b
			}
			return n < key.len() ?? (-1, n > key.len() ?? (1, 0))
		}
	}

	// A word's sounds: one for every use (`phonemes`), or one per part of
	// speech (`tags`, `DEFAULT` among them), where a tag may name none.
	struct Entry {
		phonemes ?string
		tags     string[]
		values   string[]
		present  bool[]
	}

	// Reads a word list, leaving the cursor after it.
	def readWords(r Cursor) Words {
		let count = r.varint()
		let entries int[]
		entries.len(count)
		for let i = 0; i < count; i++ {
			entries[i] = r.pos
			r.skipText()
			let n = r.varint()
			r.skipText() when n == 0
			for let k = 0; k < n; k++ {
				r.skipText()
				let present = r.byte1() == 1
				r.skipText() when present
			}
		}
		return new Words(r.data, entries)
	}
}
