internal partial module std.ai.speech.english {
	use (
		std.os
		std.testing
		std.data.encoding::(JSON)
		std.services.runtime::(Runtime)
	)

	// What misaki 0.9.4 with spaCy en_core_web_sm 3.8.0 makes of the text,
	// with the g2p_en guesser as its fallback (tools/ai/gen_english.py has
	// the data; the reference script is described in docs/std/ai/coverage.md).
	check "English G2P" {
		internal def phonemesOf(g G2P, text string) string {
			let out = ""
			for let (_, t) in g.tokens(text) {
				let ps = t.phonemes
				out += (ps is string ?? (ps, "")) + t.whitespace
			}
			return out
		}

		internal def reads(british bool, cases string[]) !none {
			let g = try g2pOf(british)
			for let k = 0; k < cases.len(); k += 2 {
				let got = phonemesOf(g, cases[k])
				fail "[{cases[k]}]: [{got}], want [{cases[k + 1]}]" unless got == cases[k + 1]
			}
			return none
		}

		// Heteronyms by part of speech, contractions, numbers, years,
		// ordinals, currencies, "a"/"an"/"the" before vowels, "used to",
		// hyphenated words and markup.
		@test()
		def american() !none {
			return try reads(false, string[
				"I read the book yesterday, and I'll read it again tomorrow.", "ˌI ɹˈɛd ðə bˈʊk jˈɛstəɹdˌA, ænd ˌIl ɹˈid ɪt əɡˈɛn təmˈɑɹO.",
				"Don't record the record! It's $5.30 at 3:45pm in the U.S.A.", "dˈOnt ɹəkˈɔɹd ðə ɹˈɛkəɹd! ˌɪts fˈIv dˈɑləɹz ænd θˈɜɹTi sˈɛnts æt pˈiˈɛm ɪn ðə jˌuˌɛsˈA",
				"They live near the live wire; lead the way to the lead mine.", "ðˌA lˈɪv nˌɪɹ ðə lˈIv wˈIəɹ; lˈid ðə wˈA tə ðə lˈid mˈIn.",
				"The year 1984 was followed by 2001, 2005, 1905 and 1900.", "ðə jˈɪɹ nˌIntˈin ˈATi fˈɔɹ wʌz fˈɑlOd bI tˈu θˈWzᵊnd wˈʌn, tˈu θˈWzᵊnd fˈIv, nˌIntˈin ˈO fˈIv ænd nˌIntˈin hˈʌndɹəd.",
				"She finished 1st, he was 22nd and they came 103rd.", "ʃˌi fˈɪnəʃt fˈɜɹst, hi wʌz twˈɛnti sˈɛkənd ænd ðA kˈAm wˈʌn hˈʌndɹəd θˈɜɹd.",
				"It costs £12.50, €3 or $1,000,000 — whichever you prefer.", "ˌɪt kˈɔsts twˈɛlv pˈWndz ænd fˈɪfti pˈɛns, θɹˈi jˈʊɹOz ɔɹ wˈʌn mˈɪljᵊn dˈɑləɹz — wˌɪʧˈɛvəɹ ju pɹifˈɜɹ.",
				"A well-known state-of-the-art co-op re-entered the market.", "ɐ wˌɛlnˈOn stˈAtʌvðiˈɑɹt kˈOˌɑp ɹiˈɛntəɹd ðə mˈɑɹkət.",
				"An apple a day keeps the doctor away. A hour? An hour.", "ɐn ˈæpᵊl ɐ dˈA kˈips ðə dˈɑktəɹ əwˈA. ɐ ˈWəɹ? ɐn ˈWəɹ.",
				"The used car was used to carry used tires; I used to drive it.", "ðə jˈuzd kˈɑɹ wʌz jˈuzd tə kˈɛɹi jˈuzd tˈIəɹz; ˌI jˈust tə dɹˈIv ɪt.",
				"Read [Kokoro](/kˈOkəɹO/) aloud, and [stress](2) this [word](-1).", "ɹˈid kˈOkəɹO əlˈWd, ænd stɹˈɛs ðɪs wˌɜɹd.",
				"Number flags: [1](#a#) hundred and [101](#&#) dalmatians.", "nˈʌmbəɹ flˈæɡz: wˈʌn hˈʌndɹəd ænd wˈʌn hˈʌndɹəd ænd wˈʌn dælmˈAʃənz.",
				"Prices: $0.99, $10, $100.50 and 3 cents.", "pɹˈIsᵻz: nˈIndi nˈIn sˈɛnts, tˈɛn dˈɑləɹz, wˈʌn hˈʌndɹəd dˈɑləɹz ænd fˈɪfti sˈɛnts ænd θɹˈi sˈɛnts.",
			])
		}

		@test()
		def british() !none {
			return try reads(true, string[
				"I read the book yesterday, and I'll read it again tomorrow.", "ˌI ɹˈɛd ðə bˈʊk jˈɛstədA, and ˌIl ɹˈiːd ɪt əɡˈɛn tʊmˈɒɹQ.",
				"Don't record the record! It's $5.30 at 3:45pm in the U.S.A.", "dˈQnt ɹɪkˈɔːd ðə ɹˈɛkɔːd! ˌɪts fˈIv dˈɒləz and θˈɜːti sˈɛnts at pˈiːˈɛm ɪn ðə jˌuːˌɛsˈA",
				"They live near the live wire; lead the way to the lead mine.", "ðˌA lˈɪv nˌɪə ðə lˈIv wˈIə; lˈiːd ðə wˈA tə ðə lˈiːd mˈIn.",
				"The year 1984 was followed by 2001, 2005, 1905 and 1900.", "ðə jˈɪə nˌIntˈiːn ˈAti fˈɔː wɒz fˈɒlQd bI tˈuː θˈWzᵊnd wˈʌn, tˈuː θˈWzᵊnd fˈIv, nˌIntˈiːn ˈQ fˈIv and nˌIntˈiːn hˈʌndɹəd.",
				"She finished 1st, he was 22nd and they came 103rd.", "ʃˌiː fˈɪnɪʃt fˈɜːst, hiː wɒz twˈɛnti sˈɛkᵊnd and ðA kˈAm wˈʌn hˈʌndɹəd θˈɜːd.",
				"It costs £12.50, €3 or $1,000,000 — whichever you prefer.", "ˌɪt kˈɒsts twˈɛlv pˈWndz and fˈɪfti pˈɛns, θɹˈiː jˈʊəɹQz ɔː wˈʌn mˈɪljən dˈɒləz — wɪʧˈɛvə juː pɹɪfˈɜː.",
				"A well-known state-of-the-art co-op re-entered the market.", "ɐ wˌɛlnˈQn stˈAtɒvðiˈɑːt kˈQɒp ɹˌiːˈɛntəd ðə mˈɑːkɪt.",
				"An apple a day keeps the doctor away. A hour? An hour.", "ɐn ˈapᵊl ɐ dˈA kˈiːps ðə dˈɒktə əwˈA. ɐ ˈWə? ɐn ˈWə.",
				"The used car was used to carry used tires; I used to drive it.", "ðə jˈuːzd kˈɑː wɒz jˈuːzd tə kˈaɹi jˈuːzd tˈIəz; ˌI jˈuːst tə dɹˈIv ɪt.",
				"Read [Kokoro](/kˈOkəɹO/) aloud, and [stress](2) this [word](-1).", "ɹˈiːd kˈOkəɹO əlˈWd, and stɹˈɛs ðɪs wˌɜːd.",
				"Number flags: [1](#a#) hundred and [101](#&#) dalmatians.", "nˈʌmbə flˈaɡz: wˈʌn hˈʌndɹəd and wˈʌn hˈʌndɹəd and wˈʌn dalmˈAʃᵊnz.",
				"Prices: $0.99, $10, $100.50 and 3 cents.", "pɹˈIsɪz: nˈInti nˈIn sˈɛnts, tˈɛn dˈɒləz, wˈʌn hˈʌndɹəd dˈɒləz and fˈɪfti sˈɛnts and θɹˈiː sˈɛnts.",
			])
		}

		// With ADM_TEST_ENGLISH_US or ADM_TEST_ENGLISH_GB naming a file of
		// misaki's output (JSON lines: text, spaCy's tokens and tags, the
		// G2P's tokens): every token, tag and phoneme string equal.
		@test()
		def corpus() !none {
			for let (_, variant) in string["US", "GB"] {
				let path = Runtime.getEnv("ADM_TEST_ENGLISH_{variant}")
				continue unless path is string && path.len() > 0
				let g = try g2pOf(variant == "GB")
				let lines = string(try os.readFile(path)).split("\n", -1)
				let (spacyBad, tokenBad, total) = (0, 0, 0)
				let shown = 0
				for let (_, line) in lines {
					continue when line.len() == 0
					total++
					let doc = try new JSON().parse(line.bytes())
					fail "not a JSON object" unless doc is map<string, any>
					let text = doc.get("text")
					fail "no text" unless text is string
					let wantTags = describe(doc.get("spacy"))
					let gotTags = ""
					for let (_, t) in g.tagger.tag(preprocess(text).0) {
						gotTags += "{t.text}|{t.space ?? (" ", "")}|{t.tag} "
					}
					if gotTags != wantTags {
						spacyBad++
						if shown < 15 {
							println("spaCy [{text}]\n  got  {gotTags}\n  want {wantTags}")
							shown++
						}
						continue
					}
					let wantTokens = describe(doc.get("tokens"))
					let gotTokens = ""
					for let (_, t) in g.tokens(text) {
						let ps = t.phonemes
						gotTokens += "{t.text}|{t.whitespace}|{ps is string ?? (ps, "")} "
					}
					if gotTokens != wantTokens {
						tokenBad++
						if shown < 15 {
							println("G2P [{text}]\n  got  {gotTokens}\n  want {wantTokens}")
							shown++
						}
					}
				}
				println("{variant}: {total} lines, {spacyBad} tokenized or tagged differently, {tokenBad} read differently")
				fail "{variant}: {spacyBad + tokenBad} of {total} lines differ" when spacyBad + tokenBad > 0
			}
			return none
		}

		// A reference token list as "a|b|c " per token.
		internal def describe(v ?any) string {
			let out = ""
			if v is any[] {
				for let (_, t) in v {
					continue unless t is any[]
					let parts string[]
					for let (_, x) in t {
						parts.push(x is string ?? (x, ""))
					}
					out += parts.join("|") + " "
				}
			}
			return out
		}
	}
}
