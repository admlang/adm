// The sounds of words no list holds, guessed by g2p_en's model (Kyubyong
// Park and Jongseok Kim, Apache-2.0): a GRU reads the letters, a second one
// writes CMU dictionary phonemes greedily, which become misaki's symbols
// (stress before the vowel; a flap, a syllabic l; British vowels and no r
// before a consonant). It stands where misaki has espeak.
internal partial module std.ai.speech.english {
	use (
		std.math
		std.text.unicode
		std.text.unicode::(NormalForm, Category)
		std.ai.tensor::(Weights)
		std.formats.ai::(TensorType)
	)

	// One GRU's weights.
	struct Gru {
		input   Weights
		hidden  Weights
		inBias  float32[]
		hidBias float32[]
	}

	type Guesser {
		internal phonemes string[]
		internal encEmbed float32[]
		internal encoder  Gru
		internal decEmbed float32[]
		internal decoder  Gru
		internal output   Weights
		internal outBias  float32[]
		internal size     int
		// Each input's product with the GRU's input weights, plus their
		// bias: the 29 letters (and marks) and the 74 phonemes are the only
		// inputs there are.
		internal encIn    float32[]
		internal decIn    float32[]
		// Words predicted lately (cleared at 4096): text repeats them.
		internal known    map<string, string[]>

		def new(phonemes string[], encEmbed float32[], encoder Gru, decEmbed float32[], decoder Gru, output Weights, outBias float32[]) {
			self.phonemes = phonemes
			self.encEmbed = encEmbed
			self.encoder = encoder
			self.decEmbed = decEmbed
			self.decoder = decoder
			self.output = output
			self.outBias = outBias
			size = encoder.hidden.cols
			encIn = inputTable(encoder, encEmbed)
			decIn = inputTable(decoder, decEmbed)
			known = new map<string, string[]>()
		}

		internal atomic def remembered(word string) ?string[] {
			return known.get(word)
		}

		internal atomic def remember(word string, ps string[]) {
			known = new map<string, string[]>() when known.len() >= 4096
			known.set(word, ps)
		}

		internal def inputTable(g Gru, embed float32[]) float32[] {
			let rows = embed.len() / size
			let width = g.inBias.len()
			let out float32[]
			out.len(rows * width)
			let x float32[]
			x.len(size)
			for let r = 0; r < rows; r++ {
				embed[r * size:(r + 1) * size].copy(x)
				let row = out[r * width:(r + 1) * width]
				g.input.multiply(x, row)
				for let j = 0; j < width; j++ {
					row[j] += g.inBias[j]
				}
			}
			return out
		}

		// The sounds of `text`: its letters without accents, run by run;
		// none when it has no letters.
		def guess(text string, british bool) ?Sounds {
			let plain = ""
			for let (_, c) in unicode.normalize(text, NormalForm.NFD) {
				plain += string(c) unless unicode.category(c) == Category.NonspacingMark
			}
			plain = lowerText(plain)
			let out = ""
			let run = ""
			let padded = plain + " "
			for let (_, c) in padded {
				if c >= 'a' && c <= 'z' {
					run += string(c)
					continue
				}
				if run.len() > 0 {
					let cached = remembered(run)
					let ps = cached is string[] ?? (cached, predict(run))
					remember(run, ps) unless cached is string[]
					out += toMisaki(ps, british)
					run = ""
				}
			}
			return none when out.len() == 0
			return Sounds{phonemes: out, rating: 2}
		}

		// g2p_en's G2p.predict: CMU phonemes of a word of a to z.
		def predict(word string) string[] {
			let h float32[]
			h.len(size)
			let width = 3 * size
			let marked = word + "\u0001"
			for let (_, c) in marked {
				// Letters are 3 to 28, the end mark 2.
				let id = c == '\u0001' ?? (2, int(c) - int('a') + 3)
				h = cell(encoder, encIn[id * width:(id + 1) * width], h)
			}
			let out string[]
			let prev = 2
			for let step = 0; step < 20; step++ {
				h = cell(decoder, decIn[prev * width:(prev + 1) * width], h)
				let logits float32[]
				logits.len(outBias.len())
				output.multiply(h, logits)
				let best = 0
				for let k = 0; k < logits.len(); k++ {
					logits[k] += outBias[k]
					best = k when logits[k] > logits[best]
				}
				break when best == 3
				out.push(phonemes[best])
				prev = best
			}
			return out
		}

		// One GRU step (PyTorch's gate order: reset, update, new), `a` the
		// input's row of the table.
		internal def cell(g Gru, a float32[], h float32[]) float32[] {
			let n = size
			let b float32[]
			b.len(3 * n)
			g.hidden.multiply(h, b)
			let next float32[]
			next.len(n)
			for let j = 0; j < n; j++ {
				let r = sigmoid(a[j] + b[j] + g.hidBias[j])
				let z = sigmoid(a[n + j] + b[n + j] + g.hidBias[n + j])
				let m = float32(math.tanh(float(a[2 * n + j] + r * (b[2 * n + j] + g.hidBias[2 * n + j]))))
				next[j] = (float32(1) - z) * m + z * h[j]
			}
			return next
		}
	}

	internal def sigmoid(x float32) float32 {
		return float32(1.0 / (1.0 + math.E ** float(-x)))
	}

	// CMU phonemes in misaki's symbols.
	def toMisaki(ph string[], british bool) string {
		let out = ""
		for let (k, p) in ph {
			let base = p.trimEnd("012")
			let stress = p[base.len():]
			let s = ""
			if base == "AH" && stress == "0" {
				s = "ə"
			} else if base == "ER" && stress == "0" {
				s = british ?? ("ə", "əɹ")
			} else {
				s = arpabet(base, british)
			}
			let next = k + 1 < ph.len() ?? (ph[k + 1].trimEnd("012"), "")
			if british {
				if base == "IY" && (stress := "1" || "2") {
					s = "iː"
				} else if base == "AA" {
					s = next == "R" ?? ("ɑː", "ɒ")
				} else if base == "R" && !isVowelPhone(next) {
					// Non-rhotic: no r unless a vowel follows.
					s = ""
				}
			} else if base == "T" && k > 0 && k + 1 < ph.len() {
				// A flap between a vowel (or r) and an unstressed vowel.
				let before = ph[k - 1].trimEnd("012")
				s = "ɾ" when (isVowelPhone(before) || before == "R") && isVowelPhone(next) && ph[k + 1].endsWith("0")
			}
			if stress == "1" {
				s = primary + s
			} else if stress == "2" {
				s = secondary + s
			}
			out += s
		}
		// A syllabic l after a consonant at the end.
		out = out[0:out.len() - 2] + "ᵊl" when out.endsWith("əl") && out.len() > 2 && "bdfɡkmnpstvzθðʃʒʧʤ".contains(string(out[-3]))
		return out
	}

	internal def isVowelPhone(base string) bool {
		return base := "AA" || "AE" || "AH" || "AO" || "AW" || "AY" || "EH" || "ER" || "EY" || "IH" || "IY" || "OW" || "OY" || "UH" || "UW"
	}

	// A CMU phoneme (without stress) in misaki's symbols.
	internal def arpabet(base string, british bool) string {
		match base {
			case "AA":
				return british ?? ("ɑː", "ɑ")
			case "AE":
				return british ?? ("a", "æ")
			case "AH":
				return "ʌ"
			case "AO":
				return british ?? ("ɔː", "ɔ")
			case "AW":
				return "W"
			case "AY":
				return "I"
			case "EH":
				return "ɛ"
			case "ER":
				return british ?? ("ɜː", "ɜɹ")
			case "EY":
				return "A"
			case "IH":
				return "ɪ"
			case "IY":
				return "i"
			case "OW":
				return british ?? ("Q", "O")
			case "OY":
				return "Y"
			case "UH":
				return "ʊ"
			case "UW":
				return british ?? ("uː", "u")
			case "CH":
				return "ʧ"
			case "DH":
				return "ð"
			case "G":
				return "ɡ"
			case "HH":
				return "h"
			case "JH":
				return "ʤ"
			case "NG":
				return "ŋ"
			case "R":
				return "ɹ"
			case "SH":
				return "ʃ"
			case "TH":
				return "θ"
			case "Y":
				return "j"
			case "ZH":
				return "ʒ"
			default:
				return lowerText(base)
		}
	}

	// Reads g2p_en's model.
	def readGuesser(r Cursor) Guesser {
		let phonemes string[]
		let count = r.varint()
		for let i = 0; i < count; i++ {
			phonemes.push(r.text())
		}
		let encEmbed = r.floats()
		let encoder = readGru(r)
		let decEmbed = r.floats()
		let decoder = readGru(r)
		let outBytes = r.floatBytes()
		let outBias = r.floats()
		let size = encoder.hidden.cols
		return new Guesser(phonemes, encEmbed, encoder, decEmbed, decoder, new Weights(TensorType.F32, outBias.len(), size, outBytes), outBias)
	}

	internal def readGru(r Cursor) Gru {
		let wi = r.floatBytes()
		let wh = r.floatBytes()
		let bi = r.floats()
		let bh = r.floats()
		let rows = bi.len()
		let inputs = wi.len() / 4 / rows
		let size = wh.len() / 4 / rows
		return Gru{input: new Weights(TensorType.F32, rows, inputs, wi), hidden: new Weights(TensorType.F32, rows, size, wh), inBias: bi, hidBias: bh}
	}
}
