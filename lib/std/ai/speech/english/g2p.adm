// misaki's English G2P (misaki/en.py, Apache-2.0): spaCy tokens and tags,
// each token split into words, numbers and marks, looked up from the last
// token to the first (a word's sound depends on the one after it: "the
// apple"), runs of pieces joined where the lexicon knows the whole, words
// no list knows guessed by g2p_en. Markup gives sounds outright:
// `[Kokoro](/kˈOkəɹO/)`, a stress `[word](-1)` or number flags `[1](#a#)`.
internal partial module std.ai.speech.english {
	use (
		std.text.unicode
	)

	// misaki's MToken: a token with what the pipeline learns of it.
	struct MToken {
		text       string
		tag        string
		// " " when a space follows, else "".
		whitespace string
		phonemes   ?string
		rating     ?int
		isHead     bool    = true
		alias      ?string
		stress     ?float
		currency   string
		numFlags   string
		prespace   bool
	}

	// A token, or a run of pieces with no space between.
	struct Word {
		token  ?MToken
		pieces MToken[]
	}

	// The English G2P of one variety.
	type G2P {
		lexicon Lexicon
		tagger  Tagger
		guesser Guesser
		// What a token no source can read becomes.
		unk     string

		def new(lexicon Lexicon, tagger Tagger, guesser Guesser, unk string = "") {
			self.lexicon = lexicon
			self.tagger = tagger
			self.guesser = guesser
			self.unk = unk
		}

		// The tokens of `text` with their phonemes.
		def tokens(text string) MToken[] {
			let (plain, words, features) = preprocess(text)
			let tokens = fold(tokenize(plain, words, features))
			let list = retokenize(tokens)
			let ctx = Context{}
			for let i = list.len() - 1; i >= 0; i-- {
				let w = list[i]
				let single = w.token
				if single is MToken {
					if single.phonemes is none {
						let found = lexicon.word(single, ctx)
						if found is Sounds {
							single.phonemes = found.phonemes
							single.rating = found.rating
						}
					}
					if single.phonemes is none {
						let guessed = guesser.guess(single.text, lexicon.british)
						if guessed is Sounds {
							single.phonemes = guessed.phonemes
							single.rating = guessed.rating
						}
					}
					ctx = tokenContext(ctx, single.phonemes, single)
					list[i] = Word{token: single}
					continue
				}
				let pieces = w.pieces
				let left = 0
				let right = pieces.len()
				let fallback = false
				for left < right {
					let free = true
					for let k = left; k < right && free; k++ {
						free = pieces[k].alias is none && pieces[k].phonemes is none
					}
					let found ?Sounds = none
					let merged = merge(pieces[left:right], none)
					found = lexicon.word(merged, ctx) when free
					if found is Sounds {
						pieces[left].phonemes = found.phonemes
						pieces[left].rating = found.rating
						for let k = left + 1; k < right; k++ {
							pieces[k].phonemes = ""
						}
						ctx = tokenContext(ctx, found.phonemes, merged)
						right = left
						left = 0
					} else if left + 1 < right {
						left++
					} else {
						right--
						let tk = pieces[right]
						if tk.phonemes is none {
							if allIn(tk.text, subtokenJunks) {
								tk.phonemes = ""
								tk.rating = 3
								pieces[right] = tk
							} else {
								fallback = true
								break
							}
						}
						left = 0
					}
				}
				if fallback {
					let merged = merge(pieces, none)
					let guessed = guesser.guess(merged.text, lexicon.british)
					pieces[0].phonemes = guessed is Sounds ?? (guessed.phonemes, none)
					pieces[0].rating = guessed is Sounds ?? (guessed.rating, none)
					for let k = 1; k < pieces.len(); k++ {
						pieces[k].phonemes = ""
					}
				} else {
					resolve(pieces)
				}
				list[i] = Word{pieces: pieces}
			}
			let out MToken[]
			for let (_, w) in list {
				let t = w.token
				let tk = t is MToken ?? (t, merge(w.pieces, unk))
				let ps = tk.phonemes
				tk.phonemes = ps.replace("ɾ", "T", -1).replace("ʔ", "t", -1) when ps is string
				out.push(tk)
			}
			return out
		}

		// G2P.tokenize: spaCy's tokens, the markup's features put on the
		// tokens they cover.
		internal def tokenize(text string, words string[], features map<int, string>) MToken[] {
			let tokens MToken[]
			for let (_, t) in tagger.tag(text) {
				tokens.push(MToken{text: t.text, tag: t.tag, whitespace: t.space ?? (" ", "")})
			}
			return tokens when features.len() == 0
			let data = alignment(words, tokens)
			for let (k, v) in features {
				let hit = 0
				for let (pos, x) in data {
					continue unless x == k
					let i = hit
					hit++
					continue when pos >= tokens.len()
					let tk = tokens[pos]
					if v.startsWith("/") {
						tk.isHead = i == 0
						tk.phonemes = i == 0 ?? (v.trimStart("/"), "")
						tk.rating = 5
					} else if v.startsWith("#") {
						tk.numFlags = v.trimStart("#")
					} else {
						tk.stress = parseFloat<float>(v)
					}
					tokens[pos] = tk
				}
			}
			return tokens
		}

		// G2P.retokenize: each token split by misaki's subtoken pattern;
		// currency signs, dashes and punctuation read; pieces with no space
		// between gathered into one word.
		internal def retokenize(tokens MToken[]) Word[] {
			let words Word[]
			let currency = ""
			for let (i, token) in tokens {
				let tks MToken[]
				if token.alias is none && token.phonemes is none {
					let chars = unicode.codePoints(token.text)
					let found = tagger.subtoken.findAll(chars, 0, chars.len())
					for let k = 0; k < found.len(); k += 2 {
						tks.push(MToken{text: text(chars, found[k], found[k + 1]), tag: token.tag, numFlags: token.numFlags, stress: token.stress})
					}
				} else {
					tks.push(token)
				}
				continue when tks.len() == 0
				tks[tks.len() - 1].whitespace = token.whitespace
				for let j = 0; j < tks.len(); j++ {
					let tk = tks[j]
					if tk.alias is string || tk.phonemes is string {
						// given
					} else if tk.tag == "$" && currencyUnits(tk.text).len() > 0 {
						currency = tk.text
						tk.phonemes = ""
						tk.rating = 4
					} else if tk.tag == ":" && (tk.text := "-" || "–") {
						tk.phonemes = "—"
						tk.rating = 3
					} else if isPunctTag(tk.tag) && !allLowerLetters(tk.text) {
						tk.phonemes = punctPhonemes(tk.tag, tk.text)
						tk.rating = 4
					} else if currency.len() > 0 {
						if tk.tag != "CD" {
							currency = ""
						} else if j + 1 == tks.len() && (i + 1 == tokens.len() || tokens[i + 1].tag != "CD") {
							tk.currency = currency
						}
					} else if j > 0 && j < tks.len() - 1 && tk.text == "2" && isAlphaText(string(tks[j - 1].text[-1]) + string(tks[j + 1].text[0])) {
						tk.alias = "to"
					}
					tks[j] = tk
					let last = words.len() - 1
					if tk.alias is string || tk.phonemes is string {
						words.push(Word{token: tk})
					} else if last >= 0 && words[last].token is none && words[last].pieces[words[last].pieces.len() - 1].whitespace.len() == 0 {
						tk.isHead = false
						let group = words[last]
						group.pieces.push(tk)
						words[last] = group
					} else if tk.whitespace.len() > 0 {
						words.push(Word{token: tk})
					} else {
						words.push(Word{pieces: MToken[tk]})
					}
				}
			}
			for let (k, w) in words {
				words[k] = Word{token: w.pieces[0]} when w.token is none && w.pieces.len() == 1
			}
			return words
		}
	}

	// The G2P of American (`british` false) or British English, as
	// Kokoro's pipeline sets misaki up: a token no source reads is silent.
	// Fails when the embedded data does not decode.
	def g2pOf(british bool) !G2P {
		let group = new AsyncScope()
		let words = async<group> lexicons.get(british)
		let tagger = async<group> taggers.get()
		let guesser = async<group> guessers.get()
		try await group
		return new G2P(try await words, try await tagger, try await guesser)
	}

	// G2P.preprocess: the text with markup `[text](feature)` replaced by
	// its text, the words split at white space, and each feature by the
	// index of the word it is on.
	def preprocess(input string) (string, string[], map<int, string>) {
		// str.lstrip(): Python's white space.
		let all = unicode.codePoints(input)
		let skip = 0
		for skip < all.len() && isSpace(all[skip]) {
			skip++
		}
		let chars = all[skip:]
		let result = ""
		let words string[]
		let features = new map<int, string>()
		let last = 0
		let i = 0
		for i < chars.len() {
			if chars[i] != '[' {
				i++
				continue
			}
			// \[([^\]]+)\]\(([^\)]*)\)
			let close = i + 1
			for close < chars.len() && chars[close] != ']' {
				close++
			}
			if close == i + 1 || close + 1 >= chars.len() || chars[close + 1] != '(' {
				i++
				continue
			}
			let end = close + 2
			for end < chars.len() && chars[end] != ')' {
				end++
			}
			if end >= chars.len() {
				i++
				continue
			}
			let before = text(chars, last, i)
			result += before
			words.push(...splitSpace(before))
			let inner = text(chars, i + 1, close)
			let feature = featureOf(text(chars, close + 2, end))
			features.set(words.len(), feature) when feature.len() > 0
			result += inner
			words.push(inner)
			last = end + 1
			i = end + 1
		}
		if last < chars.len() {
			let rest = text(chars, last, chars.len())
			result += rest
			words.push(...splitSpace(rest))
		}
		return (result, words, features)
	}

	// A markup feature as misaki keeps it: a whole number or ±0.5 (a
	// stress), "/phonemes" or "#flags"; "" for anything else.
	internal def featureOf(f string) string {
		let digits = f.startsWith("-") || f.startsWith("+") ?? (f[1:], f)
		return f.trimStart("+") when isDigitText(digits)
		return f when f := "0.5" || "-0.5"
		return "0.5" when f == "+0.5"
		return "/" + f[1:].trimEnd("/") when f.len() > 1 && f[0] == '/' && f[-1] == '/'
		return "#" + f[1:].trimEnd("#") when f.len() > 1 && f[0] == '#' && f[-1] == '#'
		return ""
	}

	// str.split(): the runs of non-space characters.
	internal def splitSpace(s string) string[] {
		let out string[]
		let cur = ""
		for let (_, c) in s {
			if isSpace(c) {
				if cur.len() > 0 {
					out.push(cur)
					cur = ""
				}
			} else {
				cur += string(c)
			}
		}
		out.push(cur) when cur.len() > 0
		return out
	}

	// spaCy's Alignment.from_strings(words, tokens).y2x.data: for each
	// token in order, the words its characters fall in.
	internal def alignment(words string[], tokens MToken[]) int[] {
		let owner int[]
		for let (i, w) in words {
			for let (_, c) in lowerText(w) {
				owner.push(i) unless c == ' '
			}
		}
		let data int[]
		let at = 0
		for let (_, t) in tokens {
			let seen int[]
			for let (_, c) in lowerText(t.text) {
				continue when c == ' '
				seen.push(owner[at]) when at < owner.len() && !seen.includes(owner[at])
				at++
			}
			data.push(...seen)
		}
		return data
	}

	// G2P.fold_left: tokens that are not heads join the one before.
	internal def fold(tokens MToken[]) MToken[] {
		let out MToken[]
		for let (_, tk) in tokens {
			if out.len() > 0 && !tk.isHead {
				let prev = out.pop()
				out.push(merge(MToken[prev, tk], ""))
			} else {
				out.push(tk)
			}
		}
		return out
	}

	// misaki's merge_tokens: one token of several, its phonemes joined
	// (none when `unk` is none; a missing one becomes `unk`).
	def merge(tokens MToken[], unk ?string) MToken {
		let n = tokens.len()
		let text = ""
		for let k = 0; k < n; k++ {
			text += tokens[k].text
			text += tokens[k].whitespace when k + 1 < n
		}
		let best = 0
		let bestWeight = -1
		for let (k, tk) in tokens {
			let weight = 0
			for let (_, c) in tk.text {
				weight += lowerText(string(c)) == string(c) ?? (1, 2)
			}
			if weight > bestWeight {
				best = k
				bestWeight = weight
			}
		}
		let phonemes ?string = none
		if unk is string {
			let ps = ""
			for let (_, tk) in tokens {
				let own = tk.phonemes
				ps += " " when tk.prespace && ps.len() > 0 && !isSpace(ps[-1]) && own is string && own.len() > 0
				ps += own is string ?? (own, unk)
			}
			phonemes = ps
		}
		let stresses float[]
		let currency = ""
		let flags string[]
		let rating ?int = tokens[0].rating
		let missing = false
		for let (_, tk) in tokens {
			let s = tk.stress
			stresses.push(s) when s is float && !stresses.includes(s)
			currency = tk.currency when tk.currency > currency
			for let (_, c) in tk.numFlags {
				flags.push(string(c)) unless flags.includes(string(c))
			}
			let r = tk.rating
			if r is int {
				let cur = rating
				rating = cur is int ?? (cur.min(r), r)
			} else {
				missing = true
			}
		}
		flags.sort((a string, b string) => a < b)
		return MToken{
			text:       text,
			tag:        tokens[best].tag,
			whitespace: tokens[n - 1].whitespace,
			phonemes:   phonemes,
			rating:     missing ?? (none, rating),
			isHead:     tokens[0].isHead,
			stress:     stresses.len() == 1 ?? (stresses[0], none),
			currency:   currency,
			numFlags:   flags.join(""),
			prespace:   tokens[0].prespace,
		}
	}

	// G2P.token_context: whether the words after begin with a vowel, from
	// the first sound of `ps`; whether this token is "to".
	internal def tokenContext(ctx Context, ps ?string, token MToken) Context {
		let vowel = ctx.futureVowel
		if ps is string {
			for let (_, c) in ps {
				let s = string(c)
				if nonQuotePuncts.contains(s) {
					vowel = none
					break
				}
				if vowels.contains(s) || consonants.contains(s) {
					vowel = vowels.contains(s)
					break
				}
			}
		}
		let to = (token.text := "to" || "To") || (token.text == "TO" && (token.tag := "TO" || "IN"))
		return Context{futureVowel: vowel, futureTo: to}
	}

	// G2P.resolve_tokens: marks left alone, a space between pieces read
	// separately, and the stress of joined pieces lowered so at most about
	// half keep a primary.
	internal def resolve(tokens MToken[]) {
		let n = tokens.len()
		let text = ""
		for let k = 0; k < n; k++ {
			text += tokens[k].text
			text += tokens[k].whitespace when k + 1 < n
		}
		let kinds int[]
		for let (_, c) in text {
			continue when subtokenJunks.contains(string(c))
			let kind = isAlpha(c) ?? (0, c >= '0' && c <= '9' ?? (1, 2))
			kinds.push(kind) unless kinds.includes(kind)
		}
		let prespace = text.contains(" ") || text.contains("/") || kinds.len() > 1
		for let i = 0; i < n; i++ {
			let tk = tokens[i]
			if tk.phonemes is none {
				if i == n - 1 && nonQuotePuncts.contains(tk.text) {
					tk.phonemes = tk.text
					tk.rating = 3
				} else if allIn(tk.text, subtokenJunks) {
					tk.phonemes = ""
					tk.rating = 3
				}
			} else if i > 0 {
				tk.prespace = prespace
			}
			tokens[i] = tk
		}
		return when prespace
		// (has primary, weight, index) of the pieces with phonemes.
		let marked int[]
		for let (i, tk) in tokens {
			let ps = tk.phonemes
			continue unless ps is string && ps.len() > 0
			marked.push(ps.contains(primary) ?? (1, 0), stressWeight(ps), i)
		}
		let count = marked.len() / 3
		if count == 2 && tokens[marked[2]].text.len() == 1 {
			lower(tokens, marked[5])
			return
		}
		let stressed = 0
		for let k = 0; k < count; k++ {
			stressed += marked[3 * k]
		}
		return when count < 2 || stressed <= (count + 1) / 2
		let order int[]
		for let k = 0; k < count; k++ {
			order.push(k)
		}
		order.sort(def (a int, b int) bool {
			for let f = 0; f < 3; f++ {
				let x = marked[3 * a + f]
				let y = marked[3 * b + f]
				return x < y when x != y
			}
			return false
		})
		for let k = 0; k < count / 2; k++ {
			lower(tokens, marked[3 * order[k] + 2])
		}
	}

	internal def lower(tokens MToken[], i int) {
		let tk = tokens[i]
		let ps = tk.phonemes
		if ps is string {
			tk.phonemes = applyStress(ps, -0.5)
			tokens[i] = tk
		}
	}

	internal def allIn(s string, set string) bool {
		for let (_, c) in s {
			return false unless set.contains(string(c))
		}
		return true
	}

	// Whether every character is a letter of ASCII once lower-cased.
	internal def allLowerLetters(s string) bool {
		for let (_, c) in s {
			let l = lowerText(string(c))
			return false unless l.len() == 1 && l[0] >= 'a' && l[0] <= 'z'
		}
		return true
	}

	internal def isPunctTag(tag string) bool {
		return tag := "." || "," || "-LRB-" || "-RRB-" || "``" || "\"\"" || "''" || ":" || "$" || "#" || "NFP"
	}

	// The phonemes of a punctuation token: brackets and quotes by tag, else
	// the marks Kokoro reads.
	internal def punctPhonemes(tag string, text string) string {
		match tag {
			case "-LRB-":
				return "("
			case "-RRB-":
				return ")"
			case "``":
				return "“"
			case "\"\"", "''":
				return "”"
			default:
				let out = ""
				for let (_, c) in text {
					out += string(c) when puncts.contains(string(c))
				}
				return out
		}
	}
}
