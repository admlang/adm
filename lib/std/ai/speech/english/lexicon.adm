// misaki's English Lexicon (misaki/en.py, Apache-2.0): a word's phonemes
// from the gold list, then the silver one, by its part of speech where the
// list tells pronunciations apart ("read", "live"); -s, -ed and -ing on known
// stems; numbers, currencies and years in words; capitals spelled out.
internal partial module std.ai.speech.english {
	use (
		std.text.unicode
		std.text.unicode::(NormalForm)
		std.i18n::(Locale, SpellOut)
	)

	internal const (
		primary        = "ˈ"
		secondary      = "ˌ"
		vowels         = "AIOQWYaiuæɑɒɔəɛɜɪʊʌᵻ"
		consonants     = "bdfhjklmnpstvwzðŋɡɹɾʃʒʤʧθ"
		diphthongs     = "AIOQWYʤʧ"
		usTaus         = "AIOWYiuæɑəɛɪɹʊʌ"
		puncts         = ";:,.!?—…\"“”"
		nonQuotePuncts = ";:,.!?—…"
		subtokenJunks  = "',-._‘’/"
	)

	// What the words after a token begin with: a vowel (true), a consonant
	// (false) or nothing known (none); and whether the next word is "to".
	struct Context {
		futureVowel ?bool
		futureTo    bool
	}

	// A word's phonemes and how sure the source is (5 given, 4 gold list,
	// 3 silver list or rule, 2 guessed).
	struct Sounds {
		phonemes string
		rating   int
	}

	type Lexicon {
		british              bool
		internal golds       Words
		internal silvers     Words
		internal capStresses float[]

		def new(british bool, golds Words, silvers Words) {
			self.british = british
			self.golds = golds
			self.silvers = silvers
			capStresses = float[0.5, 2.0]
		}

		// Lexicon.__call__: the phonemes of a token, none when no list or
		// rule knows it.
		def word(tk MToken, ctx Context) ?Sounds {
			let alias = tk.alias
			let w = alias is string ?? (alias, tk.text)
			w = w.replace("‘", "'", -1).replace("’", "'", -1)
			w = unicode.normalize(w, NormalForm.NFKC) unless w.isASCII()
			w = digitsOf(w)
			let stress ?float = none
			stress = capStresses[w == upperText(w) ?? (1, 0)] unless w == lowerText(w)
			let found = getWord(w, tk.tag, stress, ctx)
			return Sounds{phonemes: applyStress(appendCurrency(found.phonemes, tk.currency), tk.stress), rating: found.rating} when found is Sounds
			if isNumber(w, tk.isHead) {
				let n = getNumber(w, tk.currency, tk.isHead, tk.numFlags)
				return none unless n is Sounds
				return Sounds{phonemes: applyStress(n.phonemes, tk.stress), rating: n.rating}
			}
			return none
		}

		// Spells out the letters of a word with a capital stressed last.
		def nnp(w string) ?Sounds {
			let ps = ""
			for let (_, c) in w {
				continue unless isAlpha(c)
				let letter = plainGold(upperText(string(c)))
				return none unless letter is string
				ps += letter
			}
			let stressed = applyStress(ps, 0.0)
			let cut = stressed.lastIndexOf(secondary)
			stressed = stressed[0:cut] + primary + stressed[cut + 1:] when cut >= 0
			return Sounds{phonemes: stressed, rating: 3}
		}

		// The gold entry of `w` when it is one pronunciation.
		internal def plainGold(w string) ?string {
			let e = golds.get(w)
			return none unless e is Entry
			return e.phonemes
		}

		// The gold pronunciation of `w` for `tag`, or its default.
		internal def goldFor(w string, tag string) string {
			let e = golds.get(w)
			return "" unless e is Entry
			let p = e.phonemes
			return p when p is string
			let at = e.tags.indexOf(tag)
			at = e.tags.indexOf("DEFAULT") when at < 0
			return at >= 0 && e.present[at] ?? (e.values[at], "")
		}

		internal def specialCase(w string, tag string, stress ?float, ctx Context) ?Sounds {
			if tag == "ADD" && (w := "." || "/") {
				return lookup(w == "." ?? ("dot", "slash"), "", -0.5, ctx)
			}
			let symbol = symbolWord(w)
			return lookup(symbol, "", none, ctx) when symbol.len() > 0
			let stripped = w.trim(".")
			if stripped.contains(".") && isAlphaText(w.replace(".", "", -1)) {
				let longest = 0
				for let (_, part) in w.split(".", -1) {
					longest = longest.max(part.len())
				}
				return nnp(w) when longest < 3
			}
			if w := "a" || "A" {
				return Sounds{phonemes: tag == "DT" ?? ("ɐ", "ˈA"), rating: 4}
			}
			if w := "am" || "Am" || "AM" {
				return nnp(w) when tag.startsWith("NN")
				let s = stress
				return Sounds{phonemes: goldFor("am", "DEFAULT"), rating: 4} when ctx.futureVowel is none || w != "am" || (s is float && s > 0.0)
				return Sounds{phonemes: "ɐm", rating: 4}
			}
			if w := "an" || "An" || "AN" {
				return nnp(w) when w == "AN" && tag.startsWith("NN")
				return Sounds{phonemes: "ɐn", rating: 4}
			}
			return Sounds{phonemes: secondary + "I", rating: 4} when w == "I" && tag == "PRP"
			if (w := "by" || "By" || "BY") && parentTag(tag) == "ADV" {
				return Sounds{phonemes: "bˈI", rating: 4}
			}
			if (w := "to" || "To") || (w == "TO" && (tag := "TO" || "IN")) {
				let v = ctx.futureVowel
				let ps = goldFor("to", "DEFAULT")
				ps = v ?? ("tʊ", "tə") when v is bool
				return Sounds{phonemes: ps, rating: 4}
			}
			if (w := "in" || "In") || (w == "IN" && tag != "NNP") {
				let mark = ctx.futureVowel is none || tag != "IN" ?? (primary, "")
				return Sounds{phonemes: mark + "ɪn", rating: 4}
			}
			if (w := "the" || "The") || (w == "THE" && tag == "DT") {
				let v = ctx.futureVowel
				return Sounds{phonemes: v is bool && v ?? ("ði", "ðə"), rating: 4}
			}
			if tag == "IN" && (lowerText(w) := "vs" || "vs.") {
				return lookup("versus", "", none, ctx)
			}
			if w := "used" || "Used" || "USED" {
				let past = (tag := "VBD" || "JJ") && ctx.futureTo
				return Sounds{phonemes: goldFor("used", past ?? ("VBD", "DEFAULT")), rating: 4}
			}
			return none
		}

		// Lexicon.is_known.
		def isKnown(w string) bool {
			return true when golds.has(w) || symbolWord(w).len() > 0 || silvers.has(w)
			return false unless isAlphaText(w) && lexiconLetters(w)
			return true when w.len() == 1
			return true when w == upperText(w) && golds.has(lowerText(w))
			let rest = w[1:]
			return rest == upperText(rest)
		}

		// Lexicon.lookup.
		def lookup(word string, tag string, stress ?float, ctx ?Context) ?Sounds {
			let w = word
			let isNNP = false
			if w == upperText(w) && !golds.has(w) {
				w = lowerText(w)
				isNNP = tag == "NNP"
			}
			let entry = golds.get(w)
			let rating = 4
			if entry is none && !isNNP {
				entry = silvers.get(w)
				rating = 3
			}
			let ps ?string = none
			if entry is Entry {
				ps = entry.phonemes
				if entry.tags.len() > 0 {
					let t = tag
					if ctx is Context && ctx.futureVowel is none && entry.tags.includes("None") {
						t = "None"
					} else if !entry.tags.includes(t) {
						t = parentTag(t)
					}
					let at = entry.tags.indexOf(t)
					at = entry.tags.indexOf("DEFAULT") when at < 0
					ps = at >= 0 && entry.present[at] ?? (entry.values[at], none)
				}
			}
			if ps is none || (isNNP && !ps.contains(primary)) {
				let spelled = nnp(w)
				return spelled when spelled is Sounds
			}
			return none unless ps is string
			return Sounds{phonemes: applyStress(ps, stress), rating: rating}
		}

		internal def s(stem string) ?string {
			return none when stem.len() == 0
			let last = stem[-1]
			return stem + "s" when "ptkfθ".contains(string(last))
			return stem + (british ?? ("ɪ", "ᵻ")) + "z" when "szʃʒʧʤ".contains(string(last))
			return stem + "z"
		}

		internal def stemS(w string, tag string, stress ?float, ctx ?Context) ?Sounds {
			return none when w.len() < 3 || !w.endsWith("s")
			let stem = ""
			if !w.endsWith("ss") && isKnown(w[0:w.len() - 1]) {
				stem = w[0:w.len() - 1]
			} else if (w.endsWith("'s") || (w.len() > 4 && w.endsWith("es") && !w.endsWith("ies"))) && isKnown(w[0:w.len() - 2]) {
				stem = w[0:w.len() - 2]
			} else if w.len() > 4 && w.endsWith("ies") && isKnown(w[0:w.len() - 3] + "y") {
				stem = w[0:w.len() - 3] + "y"
			} else {
				return none
			}
			return withSuffix(lookup(stem, tag, stress, ctx), 0)
		}

		internal def ed(stem string) ?string {
			return none when stem.len() == 0
			let last = stem[-1]
			return stem + "t" when "pkfθʃsʧ".contains(string(last))
			return stem + (british ?? ("ɪ", "ᵻ")) + "d" when last == 'd'
			return stem + "d" when last != 't'
			return stem + "ɪd" when british || stem.len() < 2
			return stem[0:stem.len() - 1] + "ɾᵻd" when usTaus.contains(string(stem[-2]))
			return stem + "ᵻd"
		}

		internal def stemEd(w string, tag string, stress ?float, ctx ?Context) ?Sounds {
			return none when w.len() < 4 || !w.endsWith("d")
			let stem = ""
			if !w.endsWith("dd") && isKnown(w[0:w.len() - 1]) {
				stem = w[0:w.len() - 1]
			} else if w.len() > 4 && w.endsWith("ed") && !w.endsWith("eed") && isKnown(w[0:w.len() - 2]) {
				stem = w[0:w.len() - 2]
			} else {
				return none
			}
			return withSuffix(lookup(stem, tag, stress, ctx), 1)
		}

		internal def ing(stem string) ?string {
			return none when stem.len() == 0
			if british {
				return none when "əː".contains(string(stem[-1]))
			} else if stem.len() > 1 && stem[-1] == 't' && usTaus.contains(string(stem[-2])) {
				return stem[0:stem.len() - 1] + "ɾɪŋ"
			}
			return stem + "ɪŋ"
		}

		internal def stemIng(w string, tag string, stress ?float, ctx ?Context) ?Sounds {
			return none when w.len() < 5 || !w.endsWith("ing")
			let base = w[0:w.len() - 3]
			let stem = ""
			if w.len() > 5 && isKnown(base) {
				stem = base
			} else if isKnown(base + "e") {
				stem = base + "e"
			} else if w.len() > 5 && doubledBeforeIng(w) && isKnown(w[0:w.len() - 4]) {
				stem = w[0:w.len() - 4]
			} else {
				return none
			}
			return withSuffix(lookup(stem, tag, stress, ctx), 2)
		}

		// The stem's phonemes with -s (0), -ed (1) or -ing (2).
		internal def withSuffix(stem ?Sounds, kind int) ?Sounds {
			return none unless stem is Sounds
			let ps = kind == 0 ?? (s(stem.phonemes), kind == 1 ?? (ed(stem.phonemes), ing(stem.phonemes)))
			return none unless ps is string
			return Sounds{phonemes: ps, rating: stem.rating}
		}

		// Lexicon.get_word.
		def getWord(word string, tag string, stress ?float, ctx Context) ?Sounds {
			let special = specialCase(word, tag, stress, ctx)
			return special when special is Sounds
			let w = word
			let wl = lowerText(w)
			w = wl when w.len() > 1 && isAlphaText(w.replace("'", "", -1)) && w != wl && (tag != "NNP" || w.len() > 7) && !golds.has(w) && !silvers.has(w) && (w == upperText(w) || w[1:] == lowerText(w[1:])) && (golds.has(wl) || silvers.has(wl) || stemS(wl, tag, stress, ctx) is Sounds || stemEd(wl, tag, stress, ctx) is Sounds || stemIng(wl, tag, stress, ctx) is Sounds)
			return lookup(w, tag, stress, ctx) when isKnown(w)
			return lookup(w[0:w.len() - 2] + "'s", tag, stress, ctx) when w.endsWith("s'") && isKnown(w[0:w.len() - 2] + "'s")
			return lookup(w[0:w.len() - 1], tag, stress, ctx) when w.endsWith("'") && isKnown(w[0:w.len() - 1])
			let found = stemS(w, tag, stress, ctx)
			return found when found is Sounds
			found = stemEd(w, tag, stress, ctx)
			return found when found is Sounds
			return stemIng(w, tag, stress is float ?? (stress, 0.5), ctx)
		}

		internal def appendCurrency(ps string, currency string) string {
			let unit = currencyUnits(currency)
			return ps when unit.len() == 0
			let plural = stemS(unit[0] + "s", "", none, none)
			return plural is Sounds ?? ("{ps} {plural.phonemes}", ps)
		}

		// Lexicon.get_number: digits in words, with an ordinal or -s, -ed,
		// -ing ending, a currency, or digit by digit where they are no
		// quantity.
		def getNumber(word string, currency string, isHead bool, flags string) ?Sounds {
			let suffix = ""
			let cut = word.len()
			for cut > 0 && (isLowerAscii(word[cut - 1]) || word[cut - 1] == '\'') {
				cut--
			}
			suffix = word[cut:]
			let w = word[0:cut]
			let result Sounds[]
			if w.startsWith("-") {
				let minus = lookup("minus", "", none, none)
				result.push(minus) when minus is Sounds
				w = w[1:]
			}
			if isDigitText(w) && isOrdinal(suffix) {
				extendNum(result, numberWords(w.toInt<int>(10), NumberForm.Ordinal), first = true, spelled = true, flags = flags)
			} else if result.len() == 0 && w.len() == 4 && currencyUnits(currency).len() == 0 && isDigitText(w) {
				extendNum(result, yearWords(w.toInt<int>(10)), first = true, spelled = true, flags = flags)
			} else if !isHead && !w.contains(".") {
				let num = w.replace(",", "", -1)
				if num[0] == '0' || num.len() > 3 {
					for let (_, d) in num {
						extendNum(result, string(d), first = false, spelled = false, flags = flags)
					}
				} else if num.len() == 3 && !num.endsWith("00") {
					extendNum(result, num[0:1], first = true, spelled = false, flags = flags)
					if num[1] == '0' {
						let o = lookup("O", "", -2.0, none)
						result.push(o) when o is Sounds
						extendNum(result, num[2:3], first = false, spelled = false, flags = flags)
					} else {
						extendNum(result, num[1:], first = false, spelled = false, flags = flags)
					}
				} else {
					extendNum(result, num, first = true, spelled = false, flags = flags)
				}
			} else if w.count(".") > 1 || !isHead {
				let first = true
				for let (_, num) in w.replace(",", "", -1).split(".", -1) {
					if num.len() == 0 {
						// nothing
					} else if num[0] == '0' || (num.len() != 2 && num[1:].trim("0").len() > 0) {
						for let (_, d) in num {
							extendNum(result, string(d), first = false, spelled = false, flags = flags)
						}
					} else {
						extendNum(result, num, first = first, spelled = false, flags = flags)
					}
					first = false
				}
			} else if currencyUnits(currency).len() > 0 && isCurrencyAmount(w) {
				let units = currencyUnits(currency)
				let parts = w.replace(",", "", -1).split(".", -1)
				let nums int[]
				let names string[]
				for let k = 0; k < parts.len() && k < 2; k++ {
					nums.push(parts[k].len() == 0 ?? (0, parts[k].toInt<int>(10)))
					names.push(units[k])
				}
				if nums.len() > 1 {
					if nums[1] == 0 {
						nums = nums[0:1]
						names = names[0:1]
					} else if nums[0] == 0 {
						nums = nums[1:]
						names = names[1:]
					}
				}
				for let k = 0; k < nums.len(); k++ {
					if k > 0 {
						let and = lookup("and", "", none, none)
						result.push(and) when and is Sounds
					}
					extendNum(result, "{nums[k]}", first = k == 0, spelled = false, flags = flags)
					let unit = nums[k].abs() != 1 && names[k] != "pence" ?? (stemS(names[k] + "s", "", none, none), lookup(names[k], "", none, none))
					result.push(unit) when unit is Sounds
				}
			} else {
				let words = ""
				if isDigitText(w) {
					words = numberWords(w.toInt<int>(10), NumberForm.Cardinal)
				} else if !w.contains(".") {
					words = numberWords(w.replace(",", "", -1).toInt<int>(10), isOrdinal(suffix) ?? (NumberForm.Ordinal, NumberForm.Cardinal))
				} else {
					let plain = w.replace(",", "", -1)
					if plain[0] == '.' {
						words = "point"
						for let (_, d) in plain[1:] {
							words += " " + numberWords(int(d) - int('0'), NumberForm.Cardinal)
						}
					} else {
						words = floatWords(plain)
					}
				}
				extendNum(result, words, first = true, spelled = true, flags = flags)
			}
			return none when result.len() == 0
			let ps string[]
			let rating = 5
			for let (_, r) in result {
				ps.push(r.phonemes)
				rating = rating.min(r.rating)
			}
			let joined = ps.join(" ")
			let ended ?string = joined
			if suffix := "s" || "'s" {
				ended = s(joined)
			} else if suffix := "ed" || "'d" {
				ended = ed(joined)
			} else if suffix == "ing" {
				ended = ing(joined)
			}
			return none unless ended is string
			return Sounds{phonemes: ended, rating: rating}
		}

		// get_number's extend_num: the words of a number (digits, or the
		// words themselves when `spelled`), "and" left out unless the `&`
		// flag keeps it ("n" joins it to the word before), "one" as "a" first
		// with the `a` flag.
		internal def extendNum(result Sounds[], num string, first bool, spelled bool, flags string) {
			let text = spelled ?? (num, numberWords(num.toInt<int>(10), NumberForm.Cardinal))
			let splits = splitWords(text)
			for let (i, w) in splits {
				if w != "and" || flags.contains("&") {
					if first && i == 0 && splits.len() > 1 && w == "one" && flags.contains("a") {
						result.push(Sounds{phonemes: "ə", rating: 4})
					} else {
						let found = lookup(w, "", w == "point" ?? (-2.0, none), none)
						result.push(found) when found is Sounds
					}
				} else if w == "and" && flags.contains("n") && result.len() > 0 {
					let last = result[result.len() - 1]
					result[result.len() - 1] = Sounds{phonemes: last.phonemes + "ən", rating: last.rating}
				}
			}
		}
	}

	// The word misaki reads a symbol as, "" for none.
	internal def symbolWord(w string) string {
		match w {
			case "%":
				return "percent"
			case "&":
				return "and"
			case "+":
				return "plus"
			case "@":
				return "at"
			default:
				return ""
		}
	}

	// A currency sign's unit names, none for other text.
	internal def currencyUnits(sign string) string[] {
		match sign {
			case "$":
				return string["dollar", "cent"]
			case "£":
				return string["pound", "pence"]
			case "€":
				return string["euro", "cent"]
			default:
				return string[]
		}
	}

	internal def isOrdinal(suffix string) bool {
		return suffix := "st" || "nd" || "rd" || "th"
	}

	// str.lower: ASCII through the prelude, the rest by Unicode's full
	// mappings.
	def lowerText(s string) string {
		return s.isASCII() ?? (s.lower(), unicode.toLower(s))
	}

	// str.upper, as `lowerText`.
	def upperText(s string) string {
		return s.isASCII() ?? (s.upper(), unicode.toUpper(s))
	}

	// Lexicon.get_parent_tag.
	def parentTag(tag string) string {
		return "VERB" when tag.startsWith("VB")
		return "NOUN" when tag.startsWith("NN")
		return "ADV" when tag.startsWith("ADV") || tag.startsWith("RB")
		return "ADJ" when tag.startsWith("ADJ") || tag.startsWith("JJ")
		return tag
	}

	// Moves each stress mark to just before the next vowel.
	internal def restress(ps string) string {
		let chars = unicode.codePoints(ps)
		let keys float[]
		for let (i, c) in chars {
			let key = float(i)
			if c := 'ˈ' || 'ˌ' {
				let j = i
				for j < chars.len() && !vowels.contains(string(chars[j])) {
					j++
				}
				key = float(j) - 0.5
			}
			keys.push(key)
		}
		let order int[]
		for let i = 0; i < chars.len(); i++ {
			order.push(i)
		}
		order.sort((a int, b int) => keys[a] != keys[b] ?? (keys[a] < keys[b], chars[a] < chars[b]))
		let out = ""
		for let (_, i) in order {
			out += string(chars[i])
		}
		return out
	}

	internal def hasVowel(ps string) bool {
		for let (_, c) in ps {
			return true when vowels.contains(string(c))
		}
		return false
	}

	// misaki's apply_stress: none keeps the marks; below -1 removes them;
	// -1 (and 0 or -0.5 on a stressed word) lowers them; 0 to 1 adds a
	// secondary to an unstressed word; 1 and above raises a lone secondary;
	// above 1 adds a primary to an unstressed word.
	def applyStress(ps string, stress ?float) string {
		return ps unless stress is float
		let hasPrimary = ps.contains(primary)
		let unmarked = !hasPrimary && !ps.contains(secondary)
		return ps.replace(primary, "", -1).replace(secondary, "", -1) when stress < -1.0
		return ps.replace(secondary, "", -1).replace(primary, secondary, -1) when stress == -1.0 || ((stress == 0.0 || stress == -0.5) && hasPrimary)
		return hasVowel(ps) ?? (restress(secondary + ps), ps) when (stress == 0.0 || stress == 0.5 || stress == 1.0) && unmarked
		return ps.replace(secondary, primary, -1) when stress >= 1.0 && !hasPrimary && ps.contains(secondary)
		return hasVowel(ps) ?? (restress(primary + ps), ps) when stress > 1.0 && unmarked
		return ps
	}

	// misaki's stress_weight: diphthongs count twice.
	internal def stressWeight(ps string) int {
		let n = 0
		for let (_, c) in ps {
			n += diphthongs.contains(string(c)) ?? (2, 1)
		}
		return n
	}

	// Lexicon.is_number: digits (a leading minus on a head token, commas
	// and dots between) with an optional ending.
	def isNumber(w string, isHead bool) bool {
		let any = false
		for let (_, c) in w {
			any = any || (c >= '0' && c <= '9')
		}
		return false unless any
		let body = w
		for let (_, end) in string["ing", "'d", "ed", "'s", "st", "nd", "rd", "th", "s"] {
			if body.endsWith(end) {
				body = body[0:body.len() - end.len()]
				break
			}
		}
		for let (i, c) in body {
			continue when (c >= '0' && c <= '9') || c == ',' || c == '.'
			continue when isHead && i == 0 && c == '-'
			return false
		}
		return true
	}

	// Lexicon.is_currency: whole units, or at most two digits of cents.
	internal def isCurrencyAmount(w string) bool {
		return true unless w.contains(".")
		return false when w.count(".") > 1
		return w.split(".", -1)[1].len() < 3
	}

	// The text's digits of other scripts as ASCII digits, as misaki's
	// numeric_if_needed writes them.
	internal def digitsOf(w string) string {
		let changed = false
		for let (_, c) in w {
			changed = changed || (int(c) >= 0x80 && isDigitChar(c))
		}
		return w unless changed
		let out = ""
		for let (_, c) in w {
			let v = int(c) >= 0x80 && isDigitChar(c) ?? (digitValue(c), -1)
			out += v >= 0 ?? ("{v}", string(c))
		}
		return out
	}

	// The value of a digit of any script.
	internal def digitValue(c char) int {
		let v = int(c)
		if isDecimal(c) {
			// Unicode puts each script's 0 to 9 together, 0 first.
			let zero = v
			for zero > 0 && isDecimal(char(zero - 1)) {
				zero--
			}
			return (v - zero) % 10
		}
		// The digits that NFKC leaves alone count up from one.
		let starts = int[0x1369, 0x19DA, 0x10A40, 0x10E60, 0x11052]
		for let (_, s) in starts {
			return v - s + 1 when v >= s && v < s + 9
		}
		return 0
	}

	internal def isLowerAscii(c char) bool {
		return c >= 'a' && c <= 'z'
	}

	// misaki's is_digit: ASCII digits only.
	internal def isDigitText(w string) bool {
		return false when w.len() == 0
		for let (_, c) in w {
			return false unless c >= '0' && c <= '9'
		}
		return true
	}

	// str.isalpha of a whole string.
	def isAlphaText(w string) bool {
		return false when w.len() == 0
		for let (_, c) in w {
			return false unless isAlpha(c)
		}
		return true
	}

	// Whether every character is a letter, an apostrophe or a hyphen of
	// ASCII (misaki's LEXICON_ORDS).
	internal def lexiconLetters(w string) bool {
		for let (_, c) in w {
			return false unless (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '\'' || c == '-'
		}
		return true
	}

	internal def doubledBeforeIng(w string) bool {
		return true when w.endsWith("cking")
		let n = w.len()
		return false when n < 5
		let c = w[n - 4]
		return c == w[n - 5] && "bcdgklmnprstvxz".contains(string(c))
	}

	// The lower-case words of number text, split at anything else.
	internal def splitWords(text string) string[] {
		let out string[]
		let cur = ""
		for let (_, c) in text {
			if c >= 'a' && c <= 'z' {
				cur += string(c)
			} else {
				out.push(cur)
				cur = ""
			}
		}
		out.push(cur)
		return out
	}

	enum NumberForm {
		Cardinal,
		Ordinal,
	}

	// Number words as num2words writes English, "and" after a hundred
	// before what is left below it ("one hundred and five"), and before
	// the last group below a hundred ("two thousand and five").
	def numberWords(n int, form NumberForm) string {
		let en = new Locale("en")
		let words = new SpellOut(en, form == NumberForm.Ordinal ?? ("%spellout-ordinal", "%spellout-cardinal")).format(n)
		return words when n.abs() < 100
		return insertAnd(words, n.abs())
	}

	internal def insertAnd(words string, n int) string {
		// The groups of three digits, and where the words of each end.
		let parts = words.split(" ", -1)
		let out string[]
		let scales = string["thousand", "million", "billion", "trillion", "quadrillion", "quintillion",
			"thousandth", "millionth", "billionth", "trillionth", "quadrillionth", "quintillionth"]
		let lastGroup = n % 1000
		for let (i, p) in parts {
			out.push(p)
			let next = i + 1 < parts.len() ?? (parts[i + 1], "")
			continue when next.len() == 0 || scales.includes(next)
			if p := "hundred" {
				out.push("and")
			} else if scales.includes(p) && lastGroup > 0 && lastGroup < 100 && i + 1 < parts.len() && isLastScale(parts, i, scales) {
				out.push("and")
			}
		}
		return out.join(" ")
	}

	internal def isLastScale(parts string[], i int, scales string[]) bool {
		for let k = i + 1; k < parts.len(); k++ {
			return false when scales.includes(parts[k]) || parts[k] == "hundred"
		}
		return true
	}

	// num2words' English years: 1984 "nineteen eighty-four", 1905
	// "nineteen oh-five", 1900 "nineteen hundred"; years with no two-digit
	// first part, or a round thousand and a single digit, as cardinals.
	def yearWords(n int) string {
		let high = n / 100
		let low = n % 100
		return numberWords(n, NumberForm.Cardinal) when high == 0 || (high % 10 == 0 && low < 10) || high >= 100
		let lowText = low == 0 ?? ("hundred", low < 10 ?? ("oh-" + numberWords(low, NumberForm.Cardinal), numberWords(low, NumberForm.Cardinal)))
		return numberWords(high, NumberForm.Cardinal) + " " + lowText
	}

	// num2words of a decimal ("3.10"): the whole part, "point", then each
	// digit of the fraction as Python's float repr writes it (trailing
	// zeros dropped).
	internal def floatWords(text string) string {
		let dot = text.indexOf(".", 0)
		let whole = numberWords(text[0:dot].toInt<int>(10), NumberForm.Cardinal)
		// A whole number ("2.0", "1.") reads as one.
		let fraction = text[dot + 1:].trimEnd("0")
		return whole when fraction.len() == 0
		let out = whole + " point"
		for let (_, d) in fraction {
			out += " " + numberWords(int(d) - int('0'), NumberForm.Cardinal)
		}
		return out
	}
}
