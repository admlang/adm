// The regular expressions spaCy splits words with, run as Python's `re`
// runs them: the generator stores Python's own parse of each pattern, and
// this backtracking matcher walks it, look-behind and look-ahead included
// (RE2 has neither). Text is matched as code points, bounded by the slice
// a Python call would have been given.
internal partial module std.ai.speech.english {
	use (
		std.text.unicode
		std.text.unicode::(Category)
	)

	internal const (
		opLiteral    = 0
		opNotLiteral = 1
		opAny        = 2
		opSet        = 3
		opRepeat     = 4
		opGroup      = 5
		opBranch     = 6
		opAssert     = 7
		opAt         = 8
		opCategory   = 9
	)

	// One node of a parsed pattern.
	struct RxNode {
		op       int
		// The code point (literal), the position (at: 0 start, 1 end, 2
		// end of text) or the category.
		value    int
		// Repeat bounds; `max` -1 is unbounded.
		min      int
		max      int
		greedy   bool
		negate   bool
		behind   bool
		width    int
		// Set items, three ints each: kind (0 code point, 1 range, 2
		// category), then the values.
		items    int[]
		body     RxNode[]
		branches RxNode[][]
	}

	// A compiled pattern.
	type Rx {
		nodes    RxNode[]
		// Every branch starts with `^`: only position 0 can match.
		anchored bool
		// For a pattern that is one alternation: the node each branch's
		// first character must match (op -1 when it is not known), so a
		// branch is tried only where it can start.
		internal firsts RxNode[]

		def new(nodes RxNode[]) {
			self.nodes = nodes
			anchored = startsAnchored(nodes)
			if nodes.len() == 1 && nodes[0].op == opBranch {
				for let (_, b) in nodes[0].branches {
					firsts.push(firstConsumed(b))
				}
			}
		}

		// The end of a match of the whole pattern at `pos` within
		// text[lo:hi], or -1.
		def matchAt(text char[], lo int, hi int, pos int) int {
			return attempt(new RxRun(text, lo, hi), pos)
		}

		// re.search: the first (leftmost) match in text[lo:hi], as its
		// start and end, or (-1, -1).
		def search(text char[], lo int, hi int) (int, int) {
			let m = new RxRun(text, lo, hi)
			let last = anchored ?? (lo, hi)
			for let at = lo; at <= last; at++ {
				let end = attempt(m, at)
				return (at, end) when end >= 0
			}
			return (-1, -1)
		}

		// re.finditer: the matches in text[lo:hi], none overlapping, as
		// start, end pairs.
		def findAll(text char[], lo int, hi int) int[] {
			let m = new RxRun(text, lo, hi)
			let out int[]
			let at = lo
			for at <= hi {
				let end = attempt(m, at)
				if end < 0 {
					at++
					continue
				}
				out.push(at, end)
				at = end > at ?? (end, at + 1)
			}
			return out
		}

		// A match at `at`: the branches in order, skipping those whose
		// first character cannot be there.
		internal def attempt(m RxRun, at int) int {
			return m.step(nodes, 0, at, none) when firsts.len() == 0
			let branches = nodes[0].branches
			for let (k, b) in branches {
				let f = firsts[k]
				continue when f.op >= 0 && (at >= m.hi || !single(f, m.text[at]))
				let end = m.step(b, 0, at, none)
				return end when end >= 0
			}
			return -1
		}
	}

	// The single-character node the first character a sequence consumes
	// must match, past zero-width assertions; op -1 when that is not known.
	internal def firstConsumed(seq RxNode[]) RxNode {
		for let (_, n) in seq {
			continue when n.op := opAt || opAssert
			return n when isSingle(n.op)
			return n.body[0] when n.op == opRepeat && n.min >= 1 && n.body.len() == 1 && isSingle(n.body[0].op)
			if n.op == opGroup {
				let inner = firstConsumed(n.body)
				return inner when inner.op >= 0
			}
			break
		}
		return RxNode{op: -1}
	}

	internal def startsAnchored(nodes RxNode[]) bool {
		return false when nodes.len() == 0
		let first = nodes[0]
		return first.value == 0 when first.op == opAt
		return false unless first.op == opBranch
		for let (_, b) in first.branches {
			return false unless startsAnchored(b)
		}
		return true
	}

	// What follows a group or a repeat's body: the rest of the enclosing
	// sequence (`repeat` none), or the next round of a repeat.
	struct RxNext {
		nodes  RxNode[]
		at     int
		repeat ?RxNode
		count  int
		start  int
		next   ?RxNext
	}

	// One match attempt over text[lo:hi].
	type RxRun {
		text char[]
		lo   int
		hi   int

		def new(text char[], lo int, hi int) {
			self.text = text
			self.lo = lo
			self.hi = hi
		}

		// Matches nodes[i:] at pos, then what `next` holds: the end of the
		// match, or -1.
		def step(nodes RxNode[], i int, pos int, next ?RxNext) int {
			if i == nodes.len() {
				return pos when next is none
				return resume(next, pos)
			}
			let n = nodes[i]
			return step(n.body, 0, pos, RxNext{nodes: nodes, at: i + 1, next: next}) when n.op == opGroup
			if n.op == opBranch {
				let after = RxNext{nodes: nodes, at: i + 1, next: next}
				for let (_, b) in n.branches {
					let end = step(b, 0, pos, after)
					return end when end >= 0
				}
				return -1
			}
			return repeatAt(n, nodes, i, pos, next) when n.op == opRepeat
			return atHolds(n.value, pos) ?? (step(nodes, i + 1, pos, next), -1) when n.op == opAt
			if n.op == opAssert {
				let held = false
				if n.behind {
					held = pos - n.width >= lo && step(n.body, 0, pos - n.width, none) == pos
				} else {
					held = step(n.body, 0, pos, none) >= 0
				}
				return held != n.negate ?? (step(nodes, i + 1, pos, next), -1)
			}
			return (pos < hi && single(n, text[pos])) ?? (step(nodes, i + 1, pos + 1, next), -1)
		}

		internal def resume(c RxNext, pos int) int {
			let r = c.repeat
			return step(c.nodes, c.at, pos, c.next) unless r is RxNode
			// A round that matched nothing ends the repeat, as in Python.
			return c.count >= r.min ?? (step(c.nodes, c.at + 1, pos, c.next), -1) when pos == c.start
			return rounds(r, c.count, pos, c.nodes, c.at, c.next)
		}

		internal def repeatAt(n RxNode, nodes RxNode[], i int, pos int, next ?RxNext) int {
			if n.body.len() == 1 && isSingle(n.body[0].op) {
				// One code point a round: count how far it reaches, then back
				// off (or step up, when lazy).
				let one = n.body[0]
				let most = 0
				let limit = n.max < 0 ?? (hi - pos, n.max.min(hi - pos))
				for most < limit && single(one, text[pos + most]) {
					most++
				}
				return -1 when most < n.min
				if n.greedy {
					for let c = most; c >= n.min; c-- {
						let end = step(nodes, i + 1, pos + c, next)
						return end when end >= 0
					}
				} else {
					for let c = n.min; c <= most; c++ {
						let end = step(nodes, i + 1, pos + c, next)
						return end when end >= 0
					}
				}
				return -1
			}
			return rounds(n, 0, pos, nodes, i, next)
		}

		// A repeat after `count` rounds, at pos.
		internal def rounds(n RxNode, count int, pos int, nodes RxNode[], i int, next ?RxNext) int {
			let more = n.max < 0 || count < n.max
			let again = RxNext{nodes: nodes, at: i, repeat: n, count: count + 1, start: pos, next: next}
			if n.greedy {
				if more {
					let end = step(n.body, 0, pos, again)
					return end when end >= 0
				}
				return count >= n.min ?? (step(nodes, i + 1, pos, next), -1)
			}
			if count >= n.min {
				let end = step(nodes, i + 1, pos, next)
				return end when end >= 0
			}
			return more ?? (step(n.body, 0, pos, again), -1)
		}

		internal def atHolds(kind int, pos int) bool {
			match kind {
				case 0:
					return pos == lo
				case 1:
					return pos == hi || (pos == hi - 1 && text[pos] == '\n')
				default:
					return pos == hi
			}
		}
	}

	internal def isSingle(op int) bool {
		return op := opLiteral || opNotLiteral || opAny || opSet || opCategory
	}

	// Whether one code point matches a single-character node.
	internal def single(n RxNode, ch char) bool {
		return int(ch) == n.value when n.op == opLiteral
		return int(ch) != n.value when n.op == opNotLiteral
		return ch != '\n' when n.op == opAny
		return inCategory(n.value, ch) when n.op == opCategory
		let found = false
		let c = int(ch)
		for let k = 0; k < n.items.len() && !found; k += 3 {
			match n.items[k] {
				case 0:
					found = c == n.items[k + 1]
				case 1:
					found = c >= n.items[k + 1] && c <= n.items[k + 2]
				default:
					found = inCategory(n.items[k + 1], ch)
			}
		}
		return found != n.negate
	}

	// Python's Unicode classes: \d, \D, \s, \S, \w, \W.
	internal def inCategory(category int, ch char) bool {
		match category {
			case 0:
				return isDecimal(ch)
			case 1:
				return !isDecimal(ch)
			case 2:
				return isSpace(ch)
			case 3:
				return !isSpace(ch)
			case 4:
				return isWord(ch)
			default:
				return !isWord(ch)
		}
	}

	// str.isdecimal for one code point.
	def isDecimal(ch char) bool {
		return ch >= '0' && ch <= '9' when int(ch) < 0x80
		return unicode.category(ch) == Category.DecimalNumber
	}

	// str.isspace for one code point: the separators, and the controls
	// Python counts as white space.
	def isSpace(ch char) bool {
		let c = int(ch)
		return c == 0x20 || (c >= 0x09 && c <= 0x0D) || (c >= 0x1C && c <= 0x1F) when c < 0x80
		return c == 0x85 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000
	}

	// str.isalpha for one code point: a letter of any kind.
	def isAlpha(ch char) bool {
		let c = int(ch)
		return (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) when c < 0x80
		return unicode.category(ch) := Category.UppercaseLetter || Category.LowercaseLetter || Category.TitlecaseLetter || Category.ModifierLetter || Category.OtherLetter
	}

	// str.isnumeric for one code point (\w counts these).
	def isNumeric(ch char) bool {
		return ch >= '0' && ch <= '9' when int(ch) < 0x80
		return unicode.category(ch) := Category.DecimalNumber || Category.LetterNumber || Category.OtherNumber
	}

	internal def isWord(ch char) bool {
		return ch == '_' || isAlpha(ch) || isNumeric(ch)
	}

	// Reads a pattern written by the generator.
	def readRx(r Cursor) Rx {
		return new Rx(readRxSeq(r))
	}

	internal def readRxSeq(r Cursor) RxNode[] {
		let count = r.varint()
		let out RxNode[]
		for let i = 0; i < count; i++ {
			out.push(readRxNode(r))
		}
		return out
	}

	internal def readRxNode(r Cursor) RxNode {
		let n = RxNode{op: r.byte1(), max: -1, greedy: true}
		match n.op {
			case 0, 1:
				n.value = r.varint()
			case 3:
				n.negate = r.byte1() == 1
				let count = r.varint()
				for let k = 0; k < count; k++ {
					let kind = r.byte1()
					match kind {
						case 0:
							n.items.push(0, r.varint(), 0)
						case 1:
							let a = r.varint()
							n.items.push(1, a, r.varint())
						default:
							n.items.push(2, r.byte1(), 0)
					}
				}
			case 4:
				n.min = r.varint()
				n.max = r.varint() - 1
				n.greedy = r.byte1() == 1
				n.body = readRxSeq(r)
			case 5:
				n.body = readRxSeq(r)
			case 6:
				let count = r.varint()
				for let k = 0; k < count; k++ {
					n.branches.push(readRxSeq(r))
				}
			case 7:
				n.behind = r.byte1() == 1
				n.negate = r.byte1() == 1
				n.width = r.varint()
				n.body = readRxSeq(r)
			case 8, 9:
				n.value = r.byte1()
		}
		return n
	}
}
