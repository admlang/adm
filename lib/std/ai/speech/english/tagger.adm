// spaCy's en_core_web_sm part-of-speech tagger: each token's norm, first
// letter, last three letters, shape and spacing, hashed into embedding rows
// (MultiHashEmbed), a maxout layer, four residual maxout blocks over a
// window of three tokens (MaxoutWindowEncoder, the sequence padded by four
// zero rows on each side), then a linear layer whose best score is the tag.
internal partial module std.ai.speech.english {
	use (
		std.math
		std.crypto.hash::(murmur3, murmur64a)
		std.text.unicode
		std.text.unicode::(Category)
		std.ai.tensor::(Weights)
		std.formats.ai::(TensorType)
	)

	// One maxout layer with its layer norm.
	struct Maxout {
		weights Weights
		bias    float32[]
		gain    float32[]
		shift   float32[]
	}

	// The tokenizer and the tagger.
	type Tagger {
		splitter          Splitter
		labels            string[]
		// misaki's pattern for splitting a token into words, numbers and
		// marks.
		subtoken          Rx
		internal width    int
		internal rows     int[]
		internal seeds    int[]
		internal tables   float32[][]
		internal layers   Maxout[]
		internal output   Weights
		internal outBias  float32[]
		internal norms    map<uint64, string>
		internal baseNorm map<string, string>
		// spaCy's symbols ("X", "NOUN", ...), whose ids stand for hashes.
		internal symbols  map<string, uint64>

		def new(splitter Splitter) {
			self.splitter = splitter
			subtoken = new Rx(RxNode[])
			norms = new map<uint64, string>()
			baseNorm = new map<string, string>()
		}

		// The tokens of `text` with their tags.
		def tag(text string) Token[] {
			let doc = splitter.split(text)
			let n = doc.len()
			return doc when n == 0
			let w = width
			let pad = 4
			let x = matrix<float32>[].size(n, 6 * w)
			for let (t, tok) in doc {
				let ids = features(tok)
				let row = x.row(t)
				for let k = 0; k < 6; k++ {
					let (h1, h2) = murmur3(ids[k], uint32(seeds[k]))
					let table = tables[k]
					let at = k * w
					for let (_, part) in uint64[h1 & uint64(0xFFFFFFFF), h1 >> uint64(32), h2 & uint64(0xFFFFFFFF), h2 >> uint64(32)] {
						let from = int(part % uint64(rows[k])) * w
						for let j = 0; j < w; j++ {
							row[at + j] += table[from + j]
						}
					}
				}
			}
			// The embedding, into the padded sequence.
			let h = matrix<float32>[].size(n + 2 * pad, w)
			let first = maxout(layers[0], x)
			for let t = 0; t < n; t++ {
				first.row(t).copy(h.row(pad + t))
			}
			for let b = 1; b < layers.len(); b++ {
				let m = n + 2 * pad
				let window = matrix<float32>[].size(m, 3 * w)
				for let t = 0; t < m; t++ {
					let row = window.row(t)
					h.row(t - 1).copy(row[0:w]) when t > 0
					h.row(t).copy(row[w:2 * w])
					h.row(t + 1).copy(row[2 * w:3 * w]) when t + 1 < m
				}
				let y = maxout(layers[b], window)
				for let t = 0; t < m; t++ {
					let hr = h.row(t)
					let yr = y.row(t)
					for let j = 0; j < w; j++ {
						hr[j] += yr[j]
					}
				}
			}
			let scores float32[]
			scores.len(labels.len())
			for let t = 0; t < n; t++ {
				output.multiply(h.row(pad + t), scores)
				let best = 0
				for let k = 0; k < scores.len(); k++ {
					scores[k] += outBias[k]
					best = k when scores[k] > scores[best]
				}
				doc[t].tag = labels[best]
			}
			return doc
		}

		// spaCy's id of a string: its symbol's, else its hash; 0 for "".
		def idOf(s string) uint64 {
			return uint64(0) when s.len() == 0
			let symbol = symbols.get(s)
			return symbol when symbol is uint64
			return murmur64a(s.bytes(), 1)
		}

		// The token's NORM, PREFIX, SUFFIX, SHAPE, SPACY and IS_SPACE ids.
		def features(tok Token) uint64[] {
			return uint64[
				idOf(normOf(tok)),
				idOf(tok.text[0:1]),
				idOf(tok.text[-3:]),
				idOf(wordShape(tok.text)),
				uint64(tok.space ?? (1, 0)),
				uint64(isSpaceText(tok.text) ?? (1, 0)),
			]
		}

		// Maxout over three pieces, then the layer norm, of each row of x.
		internal def maxout(layer Maxout, x matrix<float32>) matrix<float32> {
			let w = width
			let y = matrix<float32>[].size(x.rows, 3 * w)
			layer.weights.multiply(x, y)
			let out = matrix<float32>[].size(x.rows, w)
			for let t = 0; t < x.rows; t++ {
				let yr = y.row(t)
				let o = out.row(t)
				for let j = 0; j < w; j++ {
					let a = yr[3 * j] + layer.bias[3 * j]
					let b = yr[3 * j + 1] + layer.bias[3 * j + 1]
					let c = yr[3 * j + 2] + layer.bias[3 * j + 2]
					o[j] = a.max(b).max(c)
				}
				let mean = float32(0)
				for let j = 0; j < w; j++ {
					mean += o[j]
				}
				mean /= float32(w)
				let variance = float32(0)
				for let j = 0; j < w; j++ {
					let d = o[j] - mean
					variance += d * d
				}
				variance = variance / float32(w) + float32(1e-8)
				let scale = float32(1.0 / math.sqrt(float(variance)))
				for let j = 0; j < w; j++ {
					o[j] = (o[j] - mean) * scale * layer.gain[j] + layer.shift[j]
				}
			}
			return out
		}

		// The token's norm: a special case's, else the lookup table's, else
		// the language's exceptions', else the word in lower case.
		def normOf(tok Token) string {
			return tok.norm when tok.norm.len() > 0
			let looked = norms.get(idOf(tok.text))
			return looked when looked is string
			let base = baseNorm.get(tok.text)
			return base when base is string
			return lowerText(tok.text)
		}
	}

	// spaCy's word_shape: letters as X and x, digits as d, other characters
	// themselves, runs cut at four.
	def wordShape(text string) string {
		return "LONG" when text.len() >= 100
		let out = ""
		let last = char(0)
		let run = 0
		for let (_, ch) in text {
			let shape = ch
			if isAlpha(ch) {
				shape = isUpperChar(ch) ?? ('X', 'x')
			} else if isDigitChar(ch) {
				shape = 'd'
			}
			if shape == last {
				run++
			} else {
				run = 0
				last = shape
			}
			out += string(shape) when run < 4
		}
		return out
	}

	// str.isspace of a whole string.
	internal def isSpaceText(s string) bool {
		return false when s.len() == 0
		for let (_, ch) in s {
			return false unless isSpace(ch)
		}
		return true
	}

	// Code points besides the uppercase letters Python's isupper takes
	// (Other_Uppercase), in ranges.
	const otherUpper = int[0x2160, 0x216F, 0x24B6, 0x24CF, 0x1F130, 0x1F149, 0x1F150, 0x1F169, 0x1F170, 0x1F189]

	// Code points besides the lowercase letters Python's islower takes
	// (Other_Lowercase), in ranges.
	const otherLower = int[0xAA, 0xAA, 0xBA, 0xBA, 0x2B0, 0x2B8, 0x2C0, 0x2C1, 0x2E0, 0x2E4, 0x345, 0x345,
		0x37A, 0x37A, 0x1D2C, 0x1D6A, 0x1D78, 0x1D78, 0x1D9B, 0x1DBF, 0x2071, 0x2071, 0x207F, 0x207F,
		0x2090, 0x209C, 0x2170, 0x217F, 0x24D0, 0x24E9, 0x2C7C, 0x2C7D, 0xA69C, 0xA69D, 0xA770, 0xA770,
		0xA7F8, 0xA7F9, 0xAB5C, 0xAB5F, 0x10780, 0x10780, 0x10783, 0x10785, 0x10787, 0x107B0, 0x107B2, 0x107BA]

	// Code points besides the decimal digits Python's isdigit takes
	// (Numeric_Type Digit: superscripts, circled digits), in ranges.
	const otherDigits = int[0xB2, 0xB3, 0xB9, 0xB9, 0x1369, 0x1371, 0x19DA, 0x19DA, 0x2070, 0x2070,
		0x2074, 0x2079, 0x2080, 0x2089, 0x2460, 0x2468, 0x2474, 0x247C, 0x2488, 0x2490, 0x24EA, 0x24EA,
		0x24F5, 0x24FD, 0x24FF, 0x24FF, 0x2776, 0x277E, 0x2780, 0x2788, 0x278A, 0x2792, 0x10A40, 0x10A43,
		0x10E60, 0x10E68, 0x11052, 0x1105A, 0x1F100, 0x1F10A]

	internal def inRanges(ranges int[], c int) bool {
		for let k = 0; k < ranges.len(); k += 2 {
			return true when c >= ranges[k] && c <= ranges[k + 1]
		}
		return false
	}

	// str.isupper for one code point.
	def isUpperChar(ch char) bool {
		let c = int(ch)
		return c >= 0x41 && c <= 0x5A when c < 0x80
		return unicode.category(ch) == Category.UppercaseLetter || inRanges(otherUpper, c)
	}

	// str.islower for one code point.
	def isLowerChar(ch char) bool {
		let c = int(ch)
		return c >= 0x61 && c <= 0x7A when c < 0x80
		return unicode.category(ch) == Category.LowercaseLetter || inRanges(otherLower, c)
	}

	// str.isdigit for one code point.
	def isDigitChar(ch char) bool {
		return isDecimal(ch) || inRanges(otherDigits, int(ch))
	}

	// Reads the tokenizer and tagger.
	def readTagger(r Cursor) Tagger {
		let width = r.varint()
		let labels string[]
		let count = r.varint()
		for let i = 0; i < count; i++ {
			labels.push(r.text())
		}
		let rows int[]
		let seeds int[]
		let tables float32[][]
		for let k = 0; k < 6; k++ {
			rows.push(r.varint())
			seeds.push(r.varint())
			tables.push(r.floats())
		}
		let layers Maxout[]
		for let k = 0; k < 5; k++ {
			let w = r.floatBytes()
			let inputs = w.len() / 4 / (3 * width)
			let weights = new Weights(TensorType.F32, 3 * width, inputs, w)
			let bias = r.floats()
			let gain = r.floats()
			layers.push(Maxout{weights: weights, bias: bias, gain: gain, shift: r.floats()})
		}
		let out = r.floatBytes()
		let output = new Weights(TensorType.F32, labels.len(), width, out)
		let outBias = r.floats()
		let norms = new map<uint64, string>()
		count = r.varint()
		for let i = 0; i < count; i++ {
			let key = r.uint64le()
			norms.set(key, r.text())
		}
		let base = new map<string, string>()
		count = r.varint()
		for let i = 0; i < count; i++ {
			let key = r.text()
			base.set(key, r.text())
		}
		let t = new Tagger(readSplitter(r))
		t.subtoken = readRx(r)
		count = r.varint()
		for let i = 0; i < count; i++ {
			let name = r.text()
			t.symbols.set(name, uint64(r.varint()))
		}
		t.labels = labels
		t.width = width
		t.rows = rows
		t.seeds = seeds
		t.tables = tables
		t.layers = layers
		t.output = output
		t.outBias = outBias
		t.norms = norms
		t.baseNorm = base
		return t
	}
}
