// spaCy's tokenizer with the English rules of en_core_web_sm: text splits
// at white space, then each piece loses prefixes and suffixes and splits at
// infixes, special cases ("don't", "a.m.") answering first; a second pass
// puts back the special cases the affix rules broke apart.
internal partial module std.ai.speech.english {
	use (
		std.text.unicode
	)

	// A token as spaCy makes it.
	struct Token {
		text  string
		// The norm a special case gives it, else "" (the word's own norm).
		norm  string
		// Whether a space follows it.
		space bool
		// Its part-of-speech tag, once tagged.
		tag   string
	}

	// One token of a special case.
	struct Piece {
		orth string
		norm string
	}

	// A special case as the matcher finds it: the tokens the affix rules
	// make of its text.
	struct Pattern {
		text  string
		orths string[]
	}

	// The tokenizer's rules.
	type Splitter {
		internal specials map<string, Piece[]>
		// The special cases by the first token the affix rules make of them.
		internal patterns map<string, Pattern[]>
		internal prefixRx Rx
		internal suffixRx Rx
		internal infixRx  Rx
		internal urlRx    Rx

		def new(specials map<string, Piece[]>, patterns map<string, Pattern[]>, prefixRx Rx, suffixRx Rx, infixRx Rx, urlRx Rx) {
			self.specials = specials
			self.patterns = patterns
			self.prefixRx = prefixRx
			self.suffixRx = suffixRx
			self.infixRx = infixRx
			self.urlRx = urlRx
		}

		// The tokens of `text`.
		def split(text string) Token[] {
			let chars = unicode.codePoints(text)
			let doc Token[]
			let n = chars.len()
			return doc when n == 0
			let inSpace = isSpace(chars[0])
			let start = 0
			for let i = 0; i < n; i++ {
				let uc = chars[i]
				continue when isSpace(uc) == inSpace
				piece(doc, chars, start, i) when start < i
				if uc == ' ' {
					doc[doc.len() - 1].space = true
					start = i + 1
				} else {
					start = i
				}
				inSpace = !inSpace
			}
			if start < n {
				piece(doc, chars, start, n)
				doc[doc.len() - 1].space = chars[n - 1] == ' ' && !inSpace
			}
			return applySpecials(doc)
		}

		// One run of white space or of other characters.
		internal def piece(doc Token[], chars char[], from int, to int) {
			return when special(doc, text(chars, from, to))
			let prefixes string[]
			let suffixes string[]
			let (lo, hi) = splitAffixes(chars, from, to, prefixes, suffixes)
			attach(doc, chars, lo, hi, prefixes, suffixes)
		}

		// Adds the tokens of the special case `s`, if it is one.
		internal def special(doc Token[], s string) bool {
			let pieces = specials.get(s)
			return false unless pieces is Piece[]
			for let (_, p) in pieces {
				doc.push(Token{text: p.orth, norm: p.norm})
			}
			return true
		}

		// Tokenizer._split_affixes: strips prefixes and suffixes from
		// chars[from:to] until none is left or a special case remains.
		internal def splitAffixes(chars char[], from int, to int, prefixes string[], suffixes string[]) (int, int) {
			let lo = from
			let hi = to
			let lastSize = -1
			for lo < hi && hi - lo != lastSize {
				break when specials.hasKey(text(chars, lo, hi))
				lastSize = hi - lo
				let preLen = prefixLength(chars, lo, hi)
				if preLen != 0 && lo + preLen < hi && specials.hasKey(text(chars, lo + preLen, hi)) {
					prefixes.push(text(chars, lo, lo + preLen))
					lo += preLen
					break
				}
				let sufLen = suffixLength(chars, lo + preLen, hi)
				if sufLen != 0 && hi - sufLen > lo && specials.hasKey(text(chars, lo, hi - sufLen)) {
					suffixes.push(text(chars, hi - sufLen, hi))
					hi -= sufLen
					break
				}
				if preLen != 0 && sufLen != 0 && preLen + sufLen <= hi - lo {
					prefixes.push(text(chars, lo, lo + preLen))
					suffixes.push(text(chars, hi - sufLen, hi))
					lo += preLen
					hi -= sufLen
				} else if preLen != 0 {
					prefixes.push(text(chars, lo, lo + preLen))
					lo += preLen
				} else if sufLen != 0 {
					suffixes.push(text(chars, hi - sufLen, hi))
					hi -= sufLen
				}
			}
			return (lo, hi)
		}

		// Tokenizer._attach_tokens: the prefixes, what is left split at its
		// infixes, then the suffixes innermost first.
		internal def attach(doc Token[], chars char[], lo int, hi int, prefixes string[], suffixes string[]) {
			for let (_, p) in prefixes {
				doc.push(Token{text: p})
			}
			if lo < hi && !special(doc, text(chars, lo, hi)) {
				if urlRx.matchAt(chars, lo, hi, lo) >= 0 {
					doc.push(Token{text: text(chars, lo, hi)})
				} else {
					let found = infixRx.findAll(chars, lo, hi)
					let start = lo
					for let k = 0; k < found.len(); k += 2 {
						let (a, b) = (found[k], found[k + 1])
						continue when a == lo
						doc.push(Token{text: text(chars, start, a)}) when a != start
						doc.push(Token{text: text(chars, a, b)}) when a != b
						start = b
					}
					doc.push(Token{text: text(chars, start, hi)}) when start < hi
				}
			}
			for let k = suffixes.len() - 1; k >= 0; k-- {
				doc.push(Token{text: suffixes[k]})
			}
		}

		internal def prefixLength(chars char[], lo int, hi int) int {
			let (a, b) = prefixRx.search(chars, lo, hi)
			return a < 0 ?? (0, b - a)
		}

		internal def suffixLength(chars char[], lo int, hi int) int {
			let (a, b) = suffixRx.search(chars, lo, hi)
			return a < 0 ?? (0, b - a)
		}

		// Tokenizer._apply_special_cases: the special cases among runs of
		// tokens, longest first, then earliest, none sharing a first or last
		// token with one taken before.
		internal def applySpecials(doc Token[]) Token[] {
			let spans int[]
			for let i = 0; i < doc.len(); i++ {
				let candidates = patterns.get(doc[i].text)
				continue unless candidates is Pattern[]
				for let (_, p) in candidates {
					continue when i + p.orths.len() > doc.len()
					let same = true
					for let k = 1; k < p.orths.len() && same; k++ {
						same = doc[i + k].text == p.orths[k]
					}
					spans.push(i, i + p.orths.len()) when same
				}
			}
			return doc when spans.len() == 0
			// Longest first, then earliest start.
			let order int[]
			for let k = 0; k < spans.len(); k += 2 {
				order.push(k)
			}
			order.sort(def (a int, b int) bool {
				let la = spans[a + 1] - spans[a]
				let lb = spans[b + 1] - spans[b]
				return la != lb ?? (la > lb, spans[a] < spans[b])
			})
			let seen bool[]
			seen.len(doc.len())
			let taken = new map<int, int>()
			for let (_, k) in order {
				let (a, b) = (spans[k], spans[k + 1])
				taken.set(a, b) unless seen[a] || seen[b - 1]
				for let t = a; t < b; t++ {
					seen[t] = true
				}
			}
			let out Token[]
			let i = 0
			for i < doc.len() {
				let end = taken.get(i)
				if !(end is int) {
					out.push(doc[i])
					i++
					continue
				}
				let s = ""
				for let t = i; t < end; t++ {
					s += doc[t].text
					s += " " when t + 1 < end && doc[t].space
				}
				let pieces = specials.get(s)
				if pieces is Piece[] {
					for let (_, p) in pieces {
						out.push(Token{text: p.orth, norm: p.norm})
					}
					out[out.len() - 1].space = doc[end - 1].space
				} else {
					for let t = i; t < end; t++ {
						out.push(doc[t])
					}
				}
				i = end
			}
			return out
		}
	}

	internal def text(chars char[], from int, to int) string {
		return chars[from:to].join("")
	}

	// Reads the tokenizer's rules.
	def readSplitter(r Cursor) Splitter {
		let specials = new map<string, Piece[]>()
		let count = r.varint()
		for let i = 0; i < count; i++ {
			let key = r.text()
			let n = r.varint()
			let pieces Piece[]
			for let k = 0; k < n; k++ {
				let orth = r.text()
				pieces.push(Piece{orth: orth, norm: r.text()})
			}
			specials.set(key, pieces)
		}
		let patterns = new map<string, Pattern[]>()
		count = r.varint()
		for let i = 0; i < count; i++ {
			let p = Pattern{text: r.text()}
			let n = r.varint()
			for let k = 0; k < n; k++ {
				p.orths.push(r.text())
			}
			continue when p.orths.len() == 0
			let list = patterns.get(p.orths[0])
			if list is Pattern[] {
				list.push(p)
				patterns.set(p.orths[0], list)
			} else {
				patterns.set(p.orths[0], Pattern[p])
			}
		}
		let prefixRx = readRx(r)
		let suffixRx = readRx(r)
		let infixRx = readRx(r)
		return new Splitter(specials, patterns, prefixRx, suffixRx, infixRx, readRx(r))
	}
}
