partial module std.ai.speech {
	use (
		std.testing
		std.formats.audio
		std.services.runtime::(Runtime)
		std.ai.llm::(Device)
	)

	check "Speech" {
		// With ADM_TEST_SPEECH_WHISPER (a Whisper export) and
		// ADM_TEST_SPEECH_SOUND (a recording) set: the transcript holds
		// ADM_TEST_SPEECH_WORDS, and listening to the recording ends with a
		// final sentence holding them too.
		@test()
		def whisper_transcribes_and_listens() !none {
			let dir = Runtime.getEnv("ADM_TEST_SPEECH_WHISPER")
			let file = Runtime.getEnv("ADM_TEST_SPEECH_SOUND")
			let words = Runtime.getEnv("ADM_TEST_SPEECH_WORDS")
			return none when dir is none || file is none || words is none || dir.len() == 0
			let model = try load(dir, language = "en")
			let sound = try audio.load(file)
			let text = try model.transcribe(sound)
			fail "transcript [{text}] lacks [{words}]" unless text.contains(words)
			let finals string[]
			for let heard in model.listen(try audio.open(file)) {
				fail heard.error.message when heard.error is error
				finals.push(heard.text) when heard.final
			}
			fail "listening heard no sentence" when finals.len() == 0
			fail "the last sentence [{finals[finals.len() - 1]}] lacks [{words}]" unless finals[finals.len() - 1].contains(words)
			return none
		}

		// With ADM_TEST_SPEECH_KOKORO (a Kokoro export) set: a sentence said
		// by an American and a British voice is mono 24 kHz sound of about
		// its length; with ADM_TEST_SPEECH_WHISPER too, Whisper hears it.
		@test()
		def kokoro_speaks() !none {
			let dir = Runtime.getEnv("ADM_TEST_SPEECH_KOKORO")
			return none when dir is none || dir.len() == 0
			let voice = try loadVoice(dir)
			fail "device {voice.device()}" unless voice.device() := Device.Gpu || Device.Cpu
			fail "voices {try voice.voices()} lack af_heart" unless (try voice.voices()).includes("af_heart")
			let ear = Runtime.getEnv("ADM_TEST_SPEECH_WHISPER")
			let listener = ear is string && ear.len() > 0 ?? (try load(ear, language = "en"), none)
			for let (_, name) in string["af_heart", "bf_emma"] {
				continue unless (try voice.voices()).includes(name)
				voice.name = name
				let sound = try voice.speak("The quick brown fox jumps over the lazy dog.")
				fail "{name}: {sound.info.sampleRate} Hz, {sound.info.channels} channels" unless sound.info.sampleRate == 24000 && sound.info.channels == 1
				let seconds = float(sound.samples.len()) / 24000.0
				fail "{name}: {seconds} s" unless seconds > 1.5 && seconds < 5.0
				fail "{name}: silent" unless loudness(sound.samples) > float32(0.01)
				if listener is SpeechModel {
					let heard = (try listener.transcribe(sound)).lower()
					fail "{name}: Whisper heard [{heard}]" unless heard.contains("quick brown fox") && heard.contains("lazy dog")
				}
			}
			voice.name = "zz_nobody"
			try testing.expectError(voice.speak("Hello."))
			return none
		}
	}
}
