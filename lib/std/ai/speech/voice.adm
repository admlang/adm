// Text to speech with Kokoro models in ONNX form, reading English with
// misaki's word lists, spaCy's tagger and g2p_en, all built in:
//
// ```
// let voice = try speech.loadVoice("Kokoro-82M-v1.0-ONNX")
// let speaker = try devices.openSpeaker()
// try speaker.play(try voice.speak("Hello! How are you today?"))
// ```
partial module std.ai.speech {
	use (
		std.os
		std.os::(DirEntry)
		std.formats.audio::(Audio, AudioInfo, SampleFormat)
		std.ai.onnx
		std.ai.tensor::(Tensor)
		std.ai.llm::(Device)
		std.ai.speech.english
		std.ai.speech.english::(G2P, MToken)
	)

	// Kokoro speaks at 24 kHz.
	const kokoroRate = 24000

	// The phonemes Kokoro reads in one pass, at most.
	const kokoroLength = 510

	// A Kokoro model and the voice it speaks with.
	type Voice {
		// The voice, as its file in the model's `voices` folder is named
		// (`af_heart`, `bm_george`): the first letter is the accent, `a`
		// American and `b` British English; other languages are not read.
		name             string
		// How fast it speaks: 1 is the voice's own pace, 1.2 a fifth faster.
		speed            float
		internal model   onnx.Model
		internal folder  string
		internal idsName string
		internal vocab   map<string, int>
		internal styles  map<string, float32[]>
		internal readers map<bool, G2P>

		internal def new(model onnx.Model, folder string, vocab map<string, int>, name string, table float32[]) {
			self.model = model
			self.folder = folder
			self.vocab = vocab
			self.name = name
			speed = 1.0
			styles = new map<string, float32[]>()
			styles.set(name, table)
			readers = new map<bool, G2P>()
			idsName = "input_ids"
			for let (_, info) in model.inputs {
				idsName = info.name when info.name == "tokens"
			}
		}

		// Where the model runs.
		def device() Device {
			return model.device
		}

		// The voices of the model, by name.
		// Fails when its `voices` folder cannot be read.
		def voices() !string[] {
			let out string[]
			for let (_, entry) in try os.readDir(os.join(folder, "voices")) {
				let file = os.base(entry.path)
				out.push(file.trimSuffix(".bin")) when file.endsWith(".bin")
			}
			out.sort((a string, b string) => a < b)
			return out
		}

		// `text` said aloud: mono, 24 kHz. Lines are read one after the
		// other; a long one is cut where a sentence ends, else at a comma,
		// so each pass fits the model.
		// Fails when the voice is not one of the model's or not English, or
		// a model run fails.
		def speak(text string) !Audio {
			let table = try styleOf(name)
			let reader = try readerOf(name)
			let samples float32[]
			for let (_, line) in paragraphs(text) {
				for let (_, ps) in chunks(reader.tokens(line)) {
					continue when ps.len() == 0
					samples.push(...(try say(ps, table)))
				}
			}
			let info = AudioInfo{sampleRate: uint32(kokoroRate), channels: 1, bitDepth: 32, format: SampleFormat.Float32, frames: uint64(samples.len()), codec: "pcm"}
			info.length = duration(int64(samples.len()) * 1000000000 / int64(kokoroRate))
			return Audio{info: info, samples: samples}
		}

		// The sound of one pass of at most 510 phonemes.
		internal def say(phonemes string, table float32[]) !float32[] {
			let ps = phonemes.len() > kokoroLength ?? (phonemes[0:kokoroLength], phonemes)
			let ids = int[0]
			for let (_, c) in ps {
				let id = vocab.get(string(c))
				ids.push(id) when id is int
			}
			ids.push(0)
			let n = ps.len()
			let at = (n - 1).clamp(0, table.len() / 256 - 1) * 256
			let feeds = new map<string, onnx.Value>()
			feeds.set(idsName, new Tensor(int[1, ids.len()], ids))
			feeds.set("style", new Tensor(int[1, 256], table[at:at + 256]))
			feeds.set("speed", new Tensor(int[1], float32[float32(speed)]))
			let out = try model.run(feeds)
			for let (_, info) in model.outputs {
				let w = out.get(info.name)
				return w.floats when w is Tensor
			}
			fail "speech: the model gave no sound"
		}

		// The style vectors of a voice, read once.
		internal def styleOf(voice string) !float32[] {
			let known = styles.get(voice)
			return known when known is float32[]
			let values = try readStyles(folder, voice)
			styles.set(voice, values)
			return values
		}

		// The G2P for the accent the voice's name begins with.
		internal def readerOf(voice string) !G2P {
			let accent = voice[0]
			fail "speech: {voice} is not an English voice (a… American, b… British); other languages are not read" unless accent := 'a' || 'b'
			let british = accent == 'b'
			let known = readers.get(british)
			return known when known is G2P
			let made = try english.g2pOf(british)
			readers.set(british, made)
			return made
		}
	}

	// Loads the Kokoro export in `folder` (as onnx-community lays
	// Kokoro-82M-v1.0-ONNX out: onnx/model.onnx, tokenizer.json, and the
	// voices as voices/<name>.bin) to speak with the voice `name`, on
	// `device`.
	// Fails when a file is missing or cannot be read.
	def loadVoice(folder string, name string = "af_heart", device Device = Device.Auto) !Voice {
		let onnxDir = os.join(folder, "onnx")
		let file = os.join(onnxDir, "model.onnx")
		file = os.join(folder, "model.onnx") unless (try os.exists(file))
		let model = try onnx.load(file, device)
		let tokenizer = try jsonAt(folder, "tokenizer.json")
		let vocab = new map<string, int>()
		let m = tokenizer.get("model")
		if m is map<string, any> {
			let v = m.get("vocab")
			if v is map<string, any> {
				for let (phoneme, id) in v {
					vocab.set(phoneme, id) when id is int
				}
			}
		}
		fail "speech: {folder}/tokenizer.json has no phoneme vocabulary" when vocab.len() == 0
		return new Voice(model, folder, vocab, name, try readStyles(folder, name))
	}

	// The style vectors of the voice `name` of the model in `folder`: 510
	// of 256 values, one per length of the phoneme string.
	// Fails when the model has no such voice or its file is not one.
	internal def readStyles(folder string, name string) !float32[] {
		let path = os.join(folder, "voices", name + ".bin")
		if !(try os.exists(path)) {
			let names string[]
			for let (_, entry) in os.readDir(os.join(folder, "voices")) onerror recover DirEntry[] {
				let file = os.base(entry.path)
				names.push(file.trimSuffix(".bin")) when file.endsWith(".bin")
			}
			fail "speech: the model has no voice {name} (voices: {names.join(", ")})"
		}
		let data = try os.readFile(path)
		fail "speech: {path} is not a voice (256 float32 values a row)" unless data.len() > 0 && data.len() % 1024 == 0
		let values float32[]
		values.len(data.len() / 4)
		for let i = 0; i < values.len(); i++ {
			let a = 4 * i
			values[i] = __bitcast_f32_from_u32(uint32(int(data[a]) | (int(data[a + 1]) << 8) | (int(data[a + 2]) << 16) | (int(data[a + 3]) << 24)))
		}
		return values
	}

	// The text cut at runs of newlines, blank lines left out (KPipeline's
	// split_pattern).
	internal def paragraphs(text string) string[] {
		let out string[]
		for let (_, line) in text.trim(" \t\n\r").split("\n", -1) {
			out.push(line) when line.trim(" \t\r\u000b\u000c").len() > 0
		}
		return out
	}

	// Kokoro's en_tokenize: the phonemes of the tokens in passes of at most
	// 510, each cut after the last sentence end it holds, else the last
	// colon, else the last comma or dash.
	internal def chunks(tokens MToken[]) string[] {
		let out string[]
		let tks MToken[]
		let count = 0
		for let (_, t) in tokens {
			let own = t.phonemes
			let ps = own is string ?? (own, "")
			t.phonemes = ps
			let next = ps + (t.whitespace.len() > 0 ?? (" ", ""))
			let nextCount = count + next.trimEnd(" ").len()
			if nextCount > kokoroLength {
				let z = waterfall(tks, nextCount)
				out.push(phonemesOf(tks[0:z]))
				tks = tks[z:].clone()
				count = phonemesOf(tks).len()
				next = next.trimStart(" ") when tks.len() == 0
			}
			tks.push(t)
			count += next.len()
		}
		out.push(phonemesOf(tks)) when tks.len() > 0
		return out
	}

	// KPipeline.waterfall_last: where to cut so the rest still fits.
	internal def waterfall(tokens MToken[], nextCount int) int {
		for let (_, marks) in string["!.?…", ":;", ",—"] {
			let z = -1
			for let i = tokens.len() - 1; i >= 0 && z < 0; i-- {
				let ps = tokens[i].phonemes
				z = i when ps is string && ps.len() == 1 && marks.contains(ps)
			}
			continue when z < 0
			z++
			if z < tokens.len() {
				let ps = tokens[z].phonemes
				z++ when ps is string && (ps := ")" || "”")
			}
			return z when nextCount - phonemesOf(tokens[0:z]).len() <= kokoroLength
		}
		return tokens.len()
	}

	// KPipeline.tokens_to_ps.
	internal def phonemesOf(tokens MToken[]) string {
		let out = ""
		for let (_, t) in tokens {
			let ps = t.phonemes
			out += ps is string ?? (ps, "")
			out += " " when t.whitespace.len() > 0
		}
		return out.trim(" \t\n\r")
	}
}
