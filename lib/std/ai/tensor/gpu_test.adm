partial module std.ai.tensor {
	use (
		std.gpu
		std.math
		std.testing
		std.formats.ai
		std.formats.ai::(TensorType)
		std.ai.tensor.gpu::*
	)

	check "Tensor kernels on the GPU" {
		// Pseudo-random bytes, the same every run.
		internal def noise(n int, seed int) byte[] {
			let out byte[]
			let s = seed
			for let i = 0; i < n; i++ {
				s = (s * 1103515245 + 12345) & 0x7FFFFFFF
				out.push(byte((s >> 16) & 0xFF))
			}
			return out
		}

		internal def values(n int, seed int) float32[] {
			let bytes = noise(n, seed)
			let out float32[]
			for let i = 0; i < n; i++ {
				out.push(float32(int(bytes[i]) - 128) / float32(64))
			}
			return out
		}

		// Blocks of `kind` with random quants and the half scales at `scales`
		// set to small finite values.
		internal def blocks(kind TensorType, rows int, cols int, seed int = 7) byte[] {
			let size = ai.blockBytes(kind)
			let count = rows * cols / ai.blockSize(kind)
			let data = noise(count * size, seed)
			let at = kind == TensorType.Q6_K ?? (int[208], kind == TensorType.Q4_K ?? (int[0, 2], int[0]))
			for let b = 0; b < count; b++ {
				for let (_, o) in at {
					// 0x1C00..0x1CFF: about 0.004
					data[b * size + o + 1] = byte(0x1C)
				}
			}
			return data
		}

		// Plain F16/BF16/F32 bytes of small values.
		internal def plain(kind TensorType, n int) byte[] {
			let v = values(n, 11)
			let out byte[]
			for let i = 0; i < n; i++ {
				let bits = int(__bitcast_u32_from_f32(v[i]))
				match kind {
					case TensorType.F32:
						for let k = 0; k < 4; k++ {
							out.push(byte((bits >> (k * 8)) & 0xFF))
						}
					case TensorType.BF16:
						out.push(byte((bits >> 16) & 0xFF))
						out.push(byte((bits >> 24) & 0xFF))
					default:
						// v is a multiple of 1/64 in [-2, 2): exact in F16.
						let sign = (bits >> 31) & 1
						let e = ((bits >> 23) & 0xFF) - 127 + 15
						let h = v[i] == float32(0) ?? (0, (sign << 15) | (e << 10) | ((bits >> 13) & 0x3FF))
						out.push(byte(h & 0xFF))
						out.push(byte(h >> 8))
				}
			}
			return out
		}

		internal def close(a float32[], b float32[], tolerance float32) bool {
			for let i = 0; i < a.len(); i++ {
				let scale = float32(1).max(a[i].abs())
				if (a[i] - b[i]).abs() > tolerance * scale {
					println("at {i}: {a[i]} vs {b[i]}")
					return false
				}
			}
			return true
		}

		internal def zeros(n int) float32[] {
			let out float32[]
			out.len(n)
			return out
		}

		@test()
		def TestGpuMultiply() !none {
			return none unless gpu.available()
			let rows = 70
			let cols = 512
			let x = values(cols + 4, 3)
			let dx = try gpu.upload(x)
			for let (_, kind) in TensorType[TensorType.Q4_K, TensorType.Q6_K, TensorType.Q8_0, TensorType.F32, TensorType.F16, TensorType.BF16] {
				let data = (kind := TensorType.F32 || TensorType.F16 || TensorType.BF16) ?? (plain(kind, rows * cols), blocks(kind, rows, cols))
				let w = new Weights(kind, rows, cols, data)
				let want = zeros(rows)
				w.multiply(x[4:], want)
				let dw = try upload(w)
				let out = try gpu.upload(zeros(rows + 5))
				try dw.multiply(dx, 4, out, 5)
				let got = zeros(rows + 5)
				try out.download(got)
				assert close(want, got[5:], float32(0.0001))
			}
		}

		@test()
		def TestGpuGatedMultiply() !none {
			return none unless gpu.available()
			let rows = 40
			let cols = 768
			let x = values(cols, 41)
			let dx = try gpu.upload(x)
			for let (_, kind) in TensorType[TensorType.Q4_K, TensorType.Q6_K, TensorType.Q8_0] {
				let gate = new Weights(kind, rows, cols, blocks(kind, rows, cols))
				let up = new Weights(kind, rows, cols, blocks(kind, rows, cols, 99))
				let want = zeros(rows)
				let other = zeros(rows)
				gate.multiply(x, want)
				up.multiply(x, other)
				gelu(want)
				for let i = 0; i < rows; i++ {
					want[i] *= other[i]
				}
				let out = try gpu.upload(zeros(rows))
				try (try upload(gate)).multiplyGated(try upload(up), dx, out, true)
				let got = zeros(rows)
				try out.download(got)
				assert close(want, got, float32(0.0001))
			}
		}

		@test()
		def TestGpuMultiplyThree() !none {
			return none unless gpu.available()
			let cols = 512
			let x = values(cols, 61)
			let a = new Weights(TensorType.Q6_K, 24, cols, blocks(TensorType.Q6_K, 24, cols, 5))
			let b = new Weights(TensorType.Q4_K, 8, cols, blocks(TensorType.Q4_K, 8, cols, 6))
			let c = new Weights(TensorType.Q8_0, 8, cols, blocks(TensorType.Q8_0, 8, cols, 7))
			let outA = try gpu.upload(zeros(24))
			let outBC = try gpu.upload(zeros(40))
			try multiplyThree(try upload(a), try upload(b), try upload(c), try gpu.upload(x), outA, 0, outBC, 4, outBC, 20)
			let got = zeros(40)
			let gotA = zeros(24)
			try outA.download(gotA)
			try outBC.download(got)
			let want = zeros(24)
			a.multiply(x, want)
			assert close(want, gotA, float32(0.0001))
			let wb = zeros(8)
			b.multiply(x, wb)
			assert close(wb, got[4:12], float32(0.0001))
			let wc = zeros(8)
			c.multiply(x, wc)
			assert close(wc, got[20:28], float32(0.0001))
		}

		@test()
		def TestGpuAddNormed() !none {
			return none unless gpu.available()
			let n = 600
			let x = values(n, 51)
			let p = values(n, 52)
			let weights = values(2 * n, 53)
			let want = p.clone()
			rmsNorm(want, weights[:n], float32(0.00001))
			for let i = 0; i < n; i++ {
				want[i] = (want[i] + x[i]) * float32(0.5)
			}
			let normedWant = want.clone()
			rmsNorm(normedWant, weights[n:], float32(0.00001))
			let dx = try gpu.upload(x)
			let normed = try gpu.upload(zeros(n))
			try addNormed(dx, try gpu.upload(p), n, try gpu.upload(weights), 0, float32(0.00001), float32(0.5), normed, n, 256)
			let got = zeros(n)
			try dx.download(got)
			assert close(want, got, float32(0.0001))
			try normed.download(got)
			assert close(normedWant, got, float32(0.0001))
		}

		@test()
		def TestGpuNormAndRope() !none {
			return none unless gpu.available()
			let heads = 3
			let hs = 64
			let x = values(heads * hs, 5)
			let weight = values(hs, 9)
			let factors = float32[1.0, 2.0, 4.0]
			let want = x.clone()
			for let h = 0; h < heads; h++ {
				rmsNorm(want[h * hs:(h + 1) * hs], weight, float32(0.000001))
			}
			rope(want, 17, heads, hs, float32(10000), RopeStyle.Halves, float32(0.5), factors, 48, float32(1.5))
			let dx = try gpu.upload(x)
			let dw = try gpu.upload(weight)
			let table = try gpu.upload(ropeTable(48, float32(10000), float32(0.5), factors))
			try prepareHeads(dx, 0, hs, heads, 1, dw, 0, float32(0.000001), 1, 17, table, 0, 48, 1, float32(1.5), heads * 256)
			let got = zeros(x.len())
			try dx.download(got)
			assert close(want, got, float32(0.0001))
		}

		@test()
		def TestGpuAttention() !none {
			return none unless gpu.available()
			let heads = 4
			let kvHeads = 2
			let hs = 32
			let positions = 150
			let kvSize = kvHeads * hs
			let q = values(heads * hs, 21)
			let keys = values(positions * kvSize, 22)
			let vals = values(positions * kvSize, 23)
			let first = 2
			let count = positions - first
			let want = zeros(heads * hs)
			for let h = 0; h < heads; h++ {
				let kv = (h / (heads / kvHeads)) * hs
				let scores = zeros(count)
				for let t = 0; t < count; t++ {
					let s = float32(0)
					for let i = 0; i < hs; i++ {
						s += q[h * hs + i] * keys[(first + t) * kvSize + kv + i]
					}
					scores[t] = s * float32(0.25)
				}
				softmax(scores)
				for let t = 0; t < count; t++ {
					for let i = 0; i < hs; i++ {
						want[h * hs + i] += scores[t] * vals[(first + t) * kvSize + kv + i]
					}
				}
			}
			let out = try gpu.upload(zeros(heads * hs))
			let work = try gpu.upload(zeros(partsSize(heads, hs, count)))
			try attention(try gpu.upload(q), try gpu.upload(keys), try gpu.upload(vals), out, work, heads, kvHeads, hs, first, count, float32(0.25), float32(0))
			let got = zeros(heads * hs)
			try out.download(got)
			assert close(want, got, float32(0.0001))
		}

		@test()
		def TestGpuMultiplyTokens() !none {
			return none unless gpu.available()
			let rows = 70
			let cols = 512
			let n = 67
			let xs = cols + 8
			let os = rows + 3
			let x = values(4 + n * xs, 71)
			let dx = try gpu.upload(x)
			let work = try gpu.upload(zeros(splitWork))
			for let (_, kind) in TensorType[TensorType.Q4_K, TensorType.Q6_K, TensorType.Q8_0, TensorType.F32, TensorType.F16, TensorType.BF16] {
				let data = (kind := TensorType.F32 || TensorType.F16 || TensorType.BF16) ?? (plain(kind, rows * cols), blocks(kind, rows, cols))
				let w = new Weights(kind, rows, cols, data)
				let out = try gpu.upload(zeros(2 + n * os))
				try (try upload(w)).multiplyTokens(dx, 4, xs, out, 2, os, n, work)
				let got = zeros(2 + n * os)
				try out.download(got)
				let want = zeros(rows)
				for let t = 0; t < n; t++ {
					w.multiply(x[4 + t * xs:4 + t * xs + cols], want)
					// Dequantized weights sum in another order than the row kernels'
					// block-scaled sums: Q6_K's large products differ by about 2e-4.
					assert close(want, got[2 + t * os:2 + t * os + rows], float32(0.0005))
				}
			}
		}

		@test()
		def TestGpuAttendTokens() !none {
			return none unless gpu.available()
			let heads = 4
			let kvHeads = 2
			let hs = 320
			let start = 62
			let n = 5
			let kvSize = kvHeads * hs
			let q = values(n * heads * hs, 81)
			let keys = values((start + n) * kvSize, 82)
			let vals = values((start + n) * kvSize, 83)
			let dq = try gpu.upload(q)
			let dk = try gpu.upload(keys)
			let dv = try gpu.upload(vals)
			for let (_, window) in int[0, 40] {
				let want = zeros(n * heads * hs)
				for let t = 0; t < n; t++ {
					let pos = start + t
					let first = window > 0 ?? ((pos - window + 1).max(0), 0)
					let count = pos + 1 - first
					for let h = 0; h < heads; h++ {
						let kv = (h / (heads / kvHeads)) * hs
						let qo = (t * heads + h) * hs
						let scores = zeros(count)
						for let p = 0; p < count; p++ {
							let s = float32(0)
							for let i = 0; i < hs; i++ {
								s += q[qo + i] * keys[(first + p) * kvSize + kv + i]
							}
							scores[p] = float32(30) * float32(math.tanh(float(s * float32(0.05) / float32(30))))
						}
						softmax(scores)
						for let p = 0; p < count; p++ {
							for let i = 0; i < hs; i++ {
								want[qo + i] += scores[p] * vals[(first + p) * kvSize + kv + i]
							}
						}
					}
				}
				let out = try gpu.upload(zeros(n * heads * hs))
				try attendTokens(dq, dk, dv, out, heads, kvHeads, hs, start, window, float32(0.05), float32(30), n * heads * 256)
				let got = zeros(n * heads * hs)
				try out.download(got)
				assert close(want, got, float32(0.0001))
			}
		}

		@test()
		def TestGpuActivations() !none {
			return none unless gpu.available()
			let n = 300
			let a = values(n, 31)
			let b = values(n, 32)
			for let (_, useGelu) in bool[true, false] {
				let want = a.clone()
				if useGelu {
					gelu(want)
				} else {
					silu(want)
				}
				for let i = 0; i < n; i++ {
					want[i] *= b[i]
				}
				let da = try gpu.upload(a)
				try activate(da, 0, 0, try gpu.upload(b), 0, 0, n, n, useGelu ?? (1, 0))
				let got = zeros(n)
				try da.download(got)
				assert close(want, got, float32(0.0001))
			}
		}
	}
}
