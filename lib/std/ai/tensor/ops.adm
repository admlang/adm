partial module std.ai.tensor {
	use (
		std.simd
		std.math
	)

	// Which form of GELU `gelu` computes.
	enum GeluForm {
		// 0.5x(1 + tanh(√(2/π)(x + 0.044715x³))): GPT-2's and llama.cpp's.
		Tanh,
		// 0.5x(1 + erf(x/√2)): the exact one BERT and its kin are trained with.
		Erf,
	}

	// The error function of n values of `x` from `from` into `out` (the
	// same positions), eight at a time: Cephes's erff polynomials.
	def erf(x float32[], out float32[], from int, n int) {
		let i = from
		let end = from + n
		let zero = simd.splat8<float32>(float32(0))
		let one = simd.splat8<float32>(float32(1))
		for; i + 8 <= end; i += 8 {
			let v = simd.load8<float32>(x, i)
			// Cephes erff: below 1 an odd polynomial in x; above,
			// 1 − erfc(|x|) with erfc = e^(−x²)/x · P(1/x²), the
			// sign of x put back. Lanes take the branch they need.
			let ax = simd.abs(v)
			let x2 = v * v
			let small = simd.fma(x2, simd.splat8<float32>(float32(7.853861353153693e-5)), simd.splat8<float32>(float32(-8.010193625184903e-4)))
			small = simd.fma(x2, small, simd.splat8<float32>(float32(5.188327685732524e-3)))
			small = simd.fma(x2, small, simd.splat8<float32>(float32(-2.685381193529856e-2)))
			small = simd.fma(x2, small, simd.splat8<float32>(float32(1.128358514861418e-1)))
			small = simd.fma(x2, small, simd.splat8<float32>(float32(-3.761262582423300e-1)))
			small = simd.fma(x2, small, simd.splat8<float32>(float32(1.128379165726710)))
			small = v * small
			let q = one / ax
			let y = q * q
			let near = simd.fma(y, simd.splat8<float32>(float32(2.326819970068386e-2)), simd.splat8<float32>(float32(-1.387039388740657e-1)))
			near = simd.fma(y, near, simd.splat8<float32>(float32(3.687424674597105e-1)))
			near = simd.fma(y, near, simd.splat8<float32>(float32(-5.824733027278666e-1)))
			near = simd.fma(y, near, simd.splat8<float32>(float32(6.210004621745983e-1)))
			near = simd.fma(y, near, simd.splat8<float32>(float32(-4.944515323274145e-1)))
			near = simd.fma(y, near, simd.splat8<float32>(float32(3.404879937665872e-1)))
			near = simd.fma(y, near, simd.splat8<float32>(float32(-2.741127028184656e-1)))
			near = simd.fma(y, near, simd.splat8<float32>(float32(5.638259427386472e-1)))
			let far = simd.fma(y, simd.splat8<float32>(float32(-1.047766399936249e1)), simd.splat8<float32>(float32(1.297719955372516e1)))
			far = simd.fma(y, far, simd.splat8<float32>(float32(-7.495518717768503)))
			far = simd.fma(y, far, simd.splat8<float32>(float32(2.921019019210786)))
			far = simd.fma(y, far, simd.splat8<float32>(float32(-1.015265279202700)))
			far = simd.fma(y, far, simd.splat8<float32>(float32(4.218463358204948e-1)))
			far = simd.fma(y, far, simd.splat8<float32>(float32(-2.820767439740514e-1)))
			far = simd.fma(y, far, simd.splat8<float32>(float32(5.641895067754075e-1)))
			let tail = simd.exp(zero - x2) * q * simd.blend(simd.lt(ax, simd.splat8<float32>(float32(2))), near, far)
			let large = one - tail
			large = simd.blend(simd.lt(v, zero), zero - large, large)
			simd.store8<float32>(out, i, simd.blend(simd.lt(ax, one), small, large))
		}
		for; i < end; i++ {
			out[i] = float32(math.erf(float(x[i])))
		}
	}

	// Which elements rotary embedding pairs up in a head.
	enum RopeStyle {
		// Elements 2i and 2i+1 (Llama as GGUF stores it).
		Adjacent,
		// Elements i and i + headSize/2 (NeoX, Qwen2).
		Halves,
	}

	// x = x / rms(x) * weight
	def rmsNorm(x float32[], weight float32[], epsilon float32) {
		let n = x.len()
		let acc = simd.splat8<float32>(float32(0))
		let i = 0
		for; i + 8 <= n; i += 8 {
			let v = simd.load8<float32>(x, i)
			acc = simd.fma(v, v, acc)
		}
		let squares = simd.sum(acc)
		for; i < n; i++ {
			squares += x[i] * x[i]
		}
		let scale = simd.splat8<float32>(float32(1.0 / math.sqrt(float(squares) / float(n) + float(epsilon))))
		i = 0
		for; i + 8 <= n; i += 8 {
			simd.store8<float32>(x, i, simd.load8<float32>(x, i) * scale * simd.load8<float32>(weight, i))
		}
		let s = simd.lane(scale, 0)
		for; i < n; i++ {
			x[i] = x[i] * s * weight[i]
		}
	}

	// x = (x - mean) / sqrt(variance + epsilon) * weight + bias
	def layerNorm(x float32[], weight float32[], bias float32[], epsilon float32) {
		let n = x.len()
		let total = 0.0
		for let i = 0; i < n; i++ {
			total += float(x[i])
		}
		let mean = total / float(n)
		let spread = 0.0
		for let i = 0; i < n; i++ {
			let d = float(x[i]) - mean
			spread += d * d
		}
		let scale = float32(1.0 / math.sqrt(spread / float(n) + float(epsilon)))
		let m = float32(mean)
		let i = 0
		let vm = simd.splat8<float32>(m)
		let vs = simd.splat8<float32>(scale)
		for; i + 8 <= n; i += 8 {
			let v = (simd.load8<float32>(x, i) - vm) * vs
			simd.store8<float32>(x, i, simd.fma(v, simd.load8<float32>(weight, i), simd.load8<float32>(bias, i)))
		}
		for; i < n; i++ {
			x[i] = (x[i] - m) * scale * weight[i] + bias[i]
		}
	}

	// In place, numerically stable (subtracts the maximum first).
	def softmax(x float32[]) {
		let n = x.len()
		return when n == 0
		let top = x[0]
		for let i = 1; i < n; i++ {
			top = top.max(x[i])
		}
		let vt = simd.splat8<float32>(top)
		let acc = simd.splat8<float32>(float32(0))
		let i = 0
		for; i + 8 <= n; i += 8 {
			let e = simd.exp(simd.load8<float32>(x, i) - vt)
			simd.store8<float32>(x, i, e)
			acc = acc + e
		}
		let total = simd.sum(acc)
		for; i < n; i++ {
			let e = float32(math.E) ** (x[i] - top)
			x[i] = e
			total += e
		}
		let inv = simd.splat8<float32>(float32(1) / total)
		i = 0
		for; i + 8 <= n; i += 8 {
			simd.store8<float32>(x, i, simd.load8<float32>(x, i) * inv)
		}
		let s = simd.lane(inv, 0)
		for; i < n; i++ {
			x[i] = x[i] * s
		}
	}

	// x = x * sigmoid(x)
	def silu(x float32[]) {
		let n = x.len()
		let one = simd.splat8<float32>(float32(1))
		let zero = simd.splat8<float32>(float32(0))
		let i = 0
		for; i + 8 <= n; i += 8 {
			let v = simd.load8<float32>(x, i)
			simd.store8<float32>(x, i, v / (one + simd.exp(zero - v)))
		}
		for; i < n; i++ {
			let v = simd.splat8<float32>(x[i])
			x[i] = simd.lane(v / (one + simd.exp(zero - v)), 0)
		}
	}

	// GELU of x in place, in the tanh form (GPT-2, llama.cpp) or the exact
	// erf form (BERT).
	def gelu(x float32[], form GeluForm = GeluForm.Tanh) {
		let n = x.len()
		if form == GeluForm.Erf {
			let scaled float32[]
			scaled.len(n)
			let s = float32(1) / float32(math.Sqrt2)
			for let i = 0; i < n; i++ {
				scaled[i] = x[i] * s
			}
			erf(scaled, scaled, 0, n)
			for let i = 0; i < n; i++ {
				x[i] = float32(0.5) * x[i] * (float32(1) + scaled[i])
			}
			return
		}
		let half = simd.splat8<float32>(float32(0.5))
		let one = simd.splat8<float32>(float32(1))
		let two = simd.splat8<float32>(float32(2))
		let k = simd.splat8<float32>(float32(0.7978845608028654))
		let c = simd.splat8<float32>(float32(0.044715))
		let i = 0
		for; i < n; i += 8 {
			let at = i + 8 <= n ?? (i, n - 8)
			if at < 0 {
				// Fewer than 8 values: one lane at a time.
				for let j = 0; j < n; j++ {
					let v = simd.splat8<float32>(x[j])
					let t = one - two / (simd.exp(two * k * simd.fma(c * v, v * v, v)) + one)
					x[j] = simd.lane(half * v * (one + t), 0)
				}
				return
			}
			if at < i {
				// The tail overlaps values already done: redo only the new ones.
				for let j = i; j < n; j++ {
					let v = simd.splat8<float32>(x[j])
					let t = one - two / (simd.exp(two * k * simd.fma(c * v, v * v, v)) + one)
					x[j] = simd.lane(half * v * (one + t), 0)
				}
				return
			}
			let v = simd.load8<float32>(x, at)
			let t = one - two / (simd.exp(two * k * simd.fma(c * v, v * v, v)) + one)
			simd.store8<float32>(x, at, half * v * (one + t))
		}
	}

	// Rotary position embedding over `heads` heads of `headSize` values, in place.
	// `pairing` picks adjacent pairs (Llama) or split halves (NeoX, Qwen2).
	// `scale` multiplies the position (linear RoPE scaling, 1/factor), and
	// `factors`, when given, divides pair i's frequency by factors[i] (the
	// per-pair `rope_freqs` of Llama 3.1 and later, LongRoPE's factors).
	// Only the first `rotated` values of each head turn (0 for all of them);
	// `magnitude` multiplies the turned values (the LongRoPE and YaRN
	// attention factor).
	def rope(x float32[], position int, heads int, headSize int, base float32, pairing RopeStyle = RopeStyle.Adjacent, scale float32 = float32(1), factors float32[] = float32[], rotated int = 0, magnitude float32 = float32(1)) {
		let dims = rotated > 0 ?? (rotated, headSize)
		let pairs = dims / 2
		let cs float32[]
		let sn float32[]
		cs.len(pairs)
		sn.len(pairs)
		for let i = 0; i < pairs; i++ {
			let theta = float(position) * float(scale) * float(base) ** (-2.0 * float(i) / float(dims))
			theta = theta / float(factors[i]) when i < factors.len()
			cs[i] = float32(math.cos(theta)) * magnitude
			sn[i] = float32(math.sin(theta)) * magnitude
		}
		for let h = 0; h < heads; h++ {
			let o = h * headSize
			for let i = 0; i < pairs; i++ {
				let a = pairing == RopeStyle.Adjacent ?? (o + 2 * i, o + i)
				let b = pairing == RopeStyle.Adjacent ?? (a + 1, a + pairs)
				let va = x[a]
				let vb = x[b]
				x[a] = va * cs[i] - vb * sn[i]
				x[b] = va * sn[i] + vb * cs[i]
			}
		}
	}
}
