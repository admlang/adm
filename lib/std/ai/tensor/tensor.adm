partial module std.ai.tensor {
	use (
		std.simd
		std.formats.ai
		std.formats.ai::(TensorType, ModelFile)
		std.ai.tensor.bands::*
		std.ai.tensor.kernels::*
	)

	// A 2D weight matrix in its stored form (quantized blocks, F16 or F32),
	// row-major, `rows` rows of `cols` elements. Multiplying dequantizes on
	// the fly: every quantized type ggml defines is read in place; F32, F16
	// and BF16 are held as a float32 matrix.
	type Weights {
		kind TensorType
		rows int
		cols int
		data byte[]

		// The values the indices of grid and table types select.
		internal table float32[]
		// The float32 values of the plain types.
		internal dense matrix<float32>

		def new(kind TensorType, rows int, cols int, data byte[]) {
			self.kind = kind
			self.rows = rows
			self.cols = cols
			self.data = data
			match kind {
				case TensorType.F32, TensorType.F16, TensorType.BF16:
					dense = matrix<float32>[].size(rows, cols)
					let values = dense.data()
					for let i = 0; i < values.len(); i++ {
						values[i] = plainValue(kind, data, i)
					}
				default:
					table = ai.grid(kind)
			}
		}

		// out = W · x, with x of length `cols` and out of length `rows`
		// (a shorter one stops the program with an index error).
		// Large matrices split into row bands on tasks.
		def multiply(x float32[], out float32[]) {
			match kind {
				case TensorType.F32, TensorType.F16, TensorType.BF16:
					let product = dense * x
					product.copy(out)
				default:
					forRows(rows, cols, def (from int, to int) {
						multiplyRows(kind, data, table, x, out, from, to, cols)
					})
			}
		}

		// One row as float32 (embedding lookup).
		def row(r int, out float32[]) {
			match kind {
				case TensorType.F32, TensorType.F16, TensorType.BF16:
					dense.row(r).copy(out)
				default:
					let size = cols / ai.blockSize(kind) * ai.blockBytes(kind)
					ai.dequantize(kind, data[r * size:(r + 1) * size], cols).copy(out)
			}
		}

		// The whole matrix as float32.
		def toMatrix() matrix<float32> {
			match kind {
				case TensorType.F32, TensorType.F16, TensorType.BF16:
					return dense.clone()
				default:
					let m = matrix<float32>[].size(rows, cols)
					for let r = 0; r < rows; r++ {
						row(r, m.row(r))
					}
					return m
			}
		}
	}

	// Reads a 2D tensor from a model file.
	// Fails when the tensor is missing, is not 2D, holds F64 or integer
	// values, or the read fails.
	def loadWeights(file ModelFile, name string) !Weights {
		let t = file.tensor(name)
		fail "tensor: no tensor named {name}" when t is none
		fail "tensor: {name} has {t.shape.len()} dimensions, weights have 2" unless t.shape.len() == 2
		fail "tensor: {name} is {t.kind.name}, which weights cannot be" when t.kind := TensorType.F64 || TensorType.I8 || TensorType.I16 || TensorType.I32 || TensorType.I64
		return new Weights(t.kind, t.shape[1], t.shape[0], try file.read(name))
	}

	// The float32 value of element `i` of a plain F32, F16 or BF16 tensor.
	internal def plainValue(kind TensorType, data byte[], i int) float32 {
		match kind {
			case TensorType.F16:
				return halfToFloat(int(data[i * 2]) | (int(data[i * 2 + 1]) << 8))
			case TensorType.BF16:
				return __bitcast_f32_from_u32(uint32((int(data[i * 2]) | (int(data[i * 2 + 1]) << 8)) << 16))
			default:
				let at = i * 4
				return __bitcast_f32_from_u32(uint32(int(data[at]) | (int(data[at + 1]) << 8) | (int(data[at + 2]) << 16) | (int(data[at + 3]) << 24)))
		}
	}

	// An IEEE half-precision value from its 16 bits.
	internal def halfToFloat(h int) float32 {
		let sign = (h >> 15) & 1
		let exponent = (h >> 10) & 0x1F
		let mantissa = h & 0x3FF
		if exponent == 0 {
			let v = float32(mantissa) * float32(5.9604644775390625e-8)
			return sign == 1 ?? (-v, v)
		}
		let bits = exponent == 31 ?? (0x7F800000 | (mantissa << 13), ((exponent + 112) << 23) | (mantissa << 13))
		return __bitcast_f32_from_u32(uint32((sign << 31) | bits))
	}
}

internal partial module std.ai.tensor.bands {
	// Multiply-adds (at least) per task, and the most tasks.
	const bandWork = 262144
	const maxTasks = 16

	// Runs `work(from, to)` over bands of `rows` rows of `cols` columns, on
	// tasks when the matrix is large enough, and returns when all are done.
	def forRows(rows int, cols int, work def(int, int)) {
		let tasks = (rows * cols / bandWork).clamp(1, maxTasks).min(rows.max(1))
		if tasks == 1 {
			work(0, rows)
			return
		}
		let done = new channel<bool>(size = tasks)
		for let t = 0; t < tasks; t++ {
			async band(work, rows * t / tasks, rows * (t + 1) / tasks, done)
		}
		for let t = 0; t < tasks; t++ {
			<-done
		}
	}

	async def band(work def(int, int), from int, to int, done channel<bool>) {
		work(from, to)
		done <- true
	}
}
