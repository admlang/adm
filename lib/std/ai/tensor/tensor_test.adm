partial module std.ai.tensor {
	use (
		std.testing
		std.formats.ai
		std.formats.ai::(TensorType)
	)

	check "Tensor kernels" {
		internal def near(a float32, b float, tolerance float = 0.0001) bool {
			return (float(a) - b).abs() <= tolerance
		}

		internal def put(out byte[], v int, n int) {
			for let k = 0; k < n; k++ {
				out.push(byte((v >> (k * 8)) & 0xFF))
			}
		}

		internal def ones(n int) float32[] {
			let x float32[]
			x.len(n)
			return x.fill(float32(1))
		}

		internal def counting(n int) float32[] {
			let x float32[]
			for let k = 0; k < n; k++ {
				x.push(float32(k))
			}
			return x
		}

		// Q4 bytes whose low nibbles count up 0–15 and high nibbles down 15–0.
		internal def nibbles(out byte[]) {
			for let j = 0; j < 16; j++ {
				out.push(byte(j | ((15 - j) << 4)))
			}
		}

		@test()
		def TestQ8Multiply() !none {
			let data byte[]
			put(data, 0x3800, 2)
			for let k = 0; k < 32; k++ {
				put(data, k - 16, 1)
			}
			put(data, 0x3400, 2)
			for let k = 0; k < 32; k++ {
				put(data, 1, 1)
			}
			let w = new Weights(TensorType.Q8_0, 2, 32, data)
			let out float32[]
			out.len(2)
			w.multiply(ones(32), out)
			assert near(out[0], -8.0) && near(out[1], 8.0)
			w.multiply(counting(32), out)
			let expected = 0.0
			for let k = 0; k < 32; k++ {
				expected += 0.5 * float(k) * float(k - 16)
			}
			assert near(out[0], expected, 0.01) && near(out[1], 0.25 * 496.0)
			let row float32[]
			row.len(32)
			w.row(0, row)
			assert near(row[0], -8.0) && near(row[31], 7.5)
			let m = w.toMatrix()
			assert m.rows == 2 && m.cols == 32 && near(m[1][5], 0.25)
			return none
		}

		@test()
		def TestQ4Multiply() !none {
			let data byte[]
			put(data, 0x3C00, 2)
			nibbles(data)
			let w = new Weights(TensorType.Q4_0, 1, 32, data)
			let out float32[]
			out.len(1)
			w.multiply(ones(32), out)
			assert near(out[0], -16.0)
			let row float32[]
			row.len(32)
			w.row(0, row)
			assert near(row[0], -8.0) && near(row[15], 7.0) && near(row[16], 7.0) && near(row[31], -8.0)
			w.multiply(counting(32), out)
			let expected = 0.0
			for let k = 0; k < 32; k++ {
				expected += float(row[k]) * float(k)
			}
			assert near(out[0], expected, 0.01)
			return none
		}

		@test()
		def TestQ41Multiply() !none {
			let data byte[]
			put(data, 0x3C00, 2)
			put(data, 0x3800, 2)
			nibbles(data)
			let w = new Weights(TensorType.Q4_1, 1, 32, data)
			let out float32[]
			out.len(1)
			w.multiply(ones(32), out)
			assert near(out[0], 256.0)
			let row float32[]
			row.len(32)
			w.row(0, row)
			assert near(row[0], 0.5) && near(row[16], 15.5)
			return none
		}

		// Two copies of one block per row, so the second row starts past
		// the first one's blocks.
		internal def twice(block byte[]) byte[] {
			let out byte[]
			out.push(...block)
			out.push(...block)
			return out
		}

		// multiply agrees with each row times x.
		internal def consistent(w Weights) bool {
			let x = counting(w.cols)
			let out float32[]
			out.len(w.rows)
			w.multiply(x, out)
			let row float32[]
			row.len(w.cols)
			for let r = 0; r < w.rows; r++ {
				w.row(r, row)
				let expected = 0.0
				for let k = 0; k < w.cols; k++ {
					expected += float(row[k]) * float(x[k])
				}
				return false unless near(out[r], expected, expected.abs() * 0.00001 + 0.01)
			}
			// A batch gives each row exactly what the vector form gives it.
			let batch = matrix<float32>[].size(3, w.cols)
			for let i = 0; i < 3; i++ {
				for let k = 0; k < w.cols; k++ {
					batch.row(i)[k] = x[k] * float32(i + 1) - float32(i)
				}
			}
			let products = matrix<float32>[].size(3, w.rows)
			w.multiply(batch, products)
			let single float32[]
			single.len(w.rows)
			for let i = 0; i < 3; i++ {
				w.multiply(batch.row(i), single)
				return false unless products.row(i).equals(single)
			}
			return true
		}

		// The 12 packed scale bytes of a Q4_K/Q5_K block: sub-blocks 0–7
		// get scales 1, 2, 3, 4, 21, 6, 7, 8 and minimums 1, 2, 3, 4, 1, 2, 3, 4.
		internal def scalesK4(out byte[]) {
			for let (_, v) in int[0x41, 2, 3, 4, 1, 2, 3, 4, 0x15, 0x26, 0x37, 0x48] {
				out.push(byte(v))
			}
		}

		@test()
		def TestQ5Multiply() !none {
			let data byte[]
			put(data, 0x3C00, 2)
			put(data, 0x00FF00FF, 4)
			nibbles(data)
			let w = new Weights(TensorType.Q5_0, 2, 32, twice(data))
			let row float32[]
			row.len(32)
			w.row(1, row)
			assert near(row[3], 3.0) && near(row[8], -8.0) && near(row[16], 15.0) && near(row[24], -9.0)
			assert consistent(w)
			let data1 byte[]
			put(data1, 0x3C00, 2)
			put(data1, 0x3800, 2)
			put(data1, 0x00FF00FF, 4)
			nibbles(data1)
			let w1 = new Weights(TensorType.Q5_1, 2, 32, twice(data1))
			w1.row(1, row)
			assert near(row[3], 19.5) && near(row[8], 8.5) && near(row[16], 31.5) && near(row[24], 7.5)
			assert consistent(w1)
			return none
		}

		@test()
		def TestQ4KMultiply() !none {
			let data byte[]
			put(data, 0x3C00, 2)
			put(data, 0x3800, 2)
			scalesK4(data)
			for let k = 0; k < 8; k++ {
				nibbles(data)
			}
			let w = new Weights(TensorType.Q4_K, 2, 256, twice(data))
			let row float32[]
			row.len(256)
			w.row(1, row)
			assert near(row[0], -0.5) && near(row[5], 4.5) && near(row[32], 29.0)
			assert near(row[128], -0.5) && near(row[129], 20.5) && near(row[224], 118.0) && near(row[255], -2.0)
			assert consistent(w)
			return none
		}

		@test()
		def TestQ5KMultiply() !none {
			let data byte[]
			put(data, 0x3C00, 2)
			put(data, 0x3800, 2)
			scalesK4(data)
			for let k = 0; k < 32; k++ {
				data.push(byte(0x55))
			}
			for let k = 0; k < 8; k++ {
				nibbles(data)
			}
			let w = new Weights(TensorType.Q5_K, 2, 256, twice(data))
			let row float32[]
			row.len(256)
			w.row(1, row)
			assert near(row[0], 15.5) && near(row[32], 29.0) && near(row[129], 356.5) && near(row[255], -2.0)
			assert consistent(w)
			return none
		}

		@test()
		def TestQ6KMultiply() !none {
			let data byte[]
			for let k = 0; k < 8; k++ {
				nibbles(data)
			}
			for let k = 0; k < 64; k++ {
				data.push(byte(0xE4))
			}
			for let k = 0; k < 16; k++ {
				put(data, k - 8, 1)
			}
			put(data, 0x3800, 2)
			let w = new Weights(TensorType.Q6_K, 2, 256, twice(data))
			let row float32[]
			row.len(256)
			w.row(1, row)
			assert near(row[0], 128.0) && near(row[17], 108.5) && near(row[32], 48.0) && near(row[64], -30.0) && near(row[96], -31.0)
			assert near(row[128], 0.0) && near(row[144], -16.0)
			assert consistent(w)
			let m = w.toMatrix()
			assert near(m[1][17], 108.5)
			return none
		}

		// Pseudo-random blocks of `kind` for `rows` × `cols`, with every
		// scale field set to a finite value near 0.1 (0x2E66).
		internal def randomBlocks(kind TensorType, rows int, cols int) byte[] {
			let size = ai.blockBytes(kind)
			let blocks = rows * cols / ai.blockSize(kind)
			let data byte[]
			let state = 12345
			for let k = 0; k < blocks * size; k++ {
				state = (state * 1103515245 + 12345) & 0x7FFFFFFF
				data.push(byte((state >> 16) & 0xFF))
			}
			for let b = 0; b < blocks; b++ {
				let at = b * size
				match kind {
					case TensorType.Q8_1:
						setHalf(data, at)
						setHalf(data, at + 2)
					case TensorType.Q8_K:
						data[at] = byte(0)
						data[at + 1] = byte(0)
						data[at + 2] = byte(0x80)
						data[at + 3] = byte(0x3D)
					case TensorType.Q2_K:
						setHalf(data, at + 80)
						setHalf(data, at + 82)
					case TensorType.Q3_K:
						setHalf(data, at + 108)
					case TensorType.TQ1_0:
						setHalf(data, at + 52)
					case TensorType.TQ2_0:
						setHalf(data, at + 64)
					case TensorType.MXFP4:
						data[at] = byte(120 + b % 8)
					case TensorType.NVFP4:
					case TensorType.IQ1_M:
						for let k = 0; k < 4; k++ {
							data[at + 49 + k * 2] = byte((int(data[at + 49 + k * 2]) & 0x0F) | 0x30)
						}
					default:
						setHalf(data, at)
				}
			}
			return data
		}

		internal def setHalf(data byte[], at int) {
			data[at] = byte(0x66)
			data[at + 1] = byte(0x2E)
		}

		@test()
		def TestEveryTypeMultiply() !none {
			let kinds = TensorType[TensorType.Q8_1, TensorType.Q8_K, TensorType.Q2_K, TensorType.Q3_K, TensorType.TQ1_0, TensorType.TQ2_0, TensorType.IQ4_NL, TensorType.IQ4_XS, TensorType.MXFP4, TensorType.NVFP4, TensorType.Q1_0, TensorType.Q2_0, TensorType.IQ2_XXS, TensorType.IQ2_XS, TensorType.IQ2_S, TensorType.IQ3_XXS, TensorType.IQ3_S, TensorType.IQ1_S, TensorType.IQ1_M]
			for let (_, kind) in kinds {
				let w = new Weights(kind, 3, 512, randomBlocks(kind, 3, 512))
				assert consistent(w)
			}
			return none
		}

		@test()
		def TestQ8KRow() !none {
			let data byte[]
			put(data, 0x3F000000, 4)
			for let k = 0; k < 256; k++ {
				put(data, k - 128, 1)
			}
			for let k = 0; k < 16; k++ {
				put(data, 0, 2)
			}
			let w = new Weights(TensorType.Q8_K, 1, 256, data)
			let row float32[]
			row.len(256)
			w.row(0, row)
			assert near(row[0], -64.0) && near(row[255], 63.5)
			assert consistent(w)
			return none
		}

		@test()
		def TestLoadWeights() !none {
			// A safetensors file with an F32 2×2 "w" and a 1D "b".
			let header = "\{\"w\":\{\"dtype\":\"F32\",\"shape\":[2,2],\"data_offsets\":[0,16]},\"b\":\{\"dtype\":\"F32\",\"shape\":[2],\"data_offsets\":[16,24]}}   ".bytes()
			let file byte[]
			put(file, header.len(), 8)
			file.push(...header)
			for let (_, bits) in int[0x3F800000, 0x40000000, 0x40400000, 0x40800000, 0, 0] {
				put(file, bits, 4)
			}
			let model = try ai.load(file)
			let w = try loadWeights(model, "w")
			assert w.rows == 2 && w.cols == 2
			let out float32[]
			out.len(2)
			w.multiply(float32[1, 1], out)
			assert near(out[0], 3.0) && near(out[1], 7.0)
			try testing.expectError(loadWeights(model, "b"))
			return testing.expectError(loadWeights(model, "missing"))
		}

		@test()
		def TestPlainWeights() !none {
			let data byte[]
			for let (_, bits) in int[0x3F800000, 0, 0, 0x40000000] {
				put(data, bits, 4)
			}
			let w = new Weights(TensorType.F32, 2, 2, data)
			let out float32[]
			out.len(2)
			w.multiply(float32[3, 5], out)
			assert near(out[0], 3.0) && near(out[1], 10.0)

			let half byte[]
			put(half, 0x3C00, 2)
			put(half, 0xC000, 2)
			let h = new Weights(TensorType.F16, 1, 2, half)
			let one float32[]
			one.len(1)
			h.multiply(float32[2, 1], one)
			assert near(one[0], 0.0)
			let row float32[]
			row.len(2)
			h.row(0, row)
			assert near(row[0], 1.0) && near(row[1], -2.0)
			return none
		}

		@test()
		def TestNorms() !none {
			let x = float32[3, 4]
			rmsNorm(x, float32[1, 2], float32(0))
			assert near(x[0], 0.848528) && near(x[1], 2.262742)
			// Long enough for the vector loop and the tail.
			let y float32[]
			for let k = 0; k < 11; k++ {
				y.push(float32(2))
			}
			rmsNorm(y, ones(11), float32(0))
			assert near(y[0], 1.0) && near(y[10], 1.0)

			let z = float32[1, 2, 3]
			layerNorm(z, ones(3), float32[0, 0, 1], float32(0))
			assert near(z[0], -1.224745) && near(z[1], 0.0) && near(z[2], 2.224745)
			return none
		}

		@test()
		def TestSoftmax() !none {
			let x = float32[0, float32(0.6931472)]
			softmax(x)
			assert near(x[0], 0.333333) && near(x[1], 0.666667)
			let y = counting(11)
			softmax(y)
			let total = 0.0
			for let k = 0; k < 11; k++ {
				total += float(y[k])
			}
			assert (total - 1.0).abs() < 0.0001 && y[10] > y[9]
			return none
		}

		@test()
		def TestActivations() !none {
			let x = float32[0, 1, -1]
			silu(x)
			assert near(x[0], 0.0) && near(x[1], 0.731059) && near(x[2], -0.268941)
			let long = counting(10)
			silu(long)
			assert near(long[9], 8.998890)
			let g = float32[0, 1, -1]
			gelu(g)
			assert near(g[0], 0.0) && near(g[1], 0.841192) && near(g[2], -0.158808)
			let wide = counting(9)
			gelu(wide)
			assert near(wide[1], 0.841192) && near(wide[8], 8.0)
			return none
		}

		@test()
		def TestRope() !none {
			let x = float32[1, 0, 1, 0]
			rope(x, 0, 2, 2, float32(10000))
			assert near(x[0], 1.0) && near(x[1], 0.0)
			rope(x, 1, 2, 2, float32(10000))
			assert near(x[0], 0.540302) && near(x[1], 0.841471) && near(x[2], 0.540302)
			// Split halves: element i pairs with i + headSize/2.
			let y = float32[1, 1, 0, 0]
			rope(y, 1, 1, 4, float32(10000), RopeStyle.Halves)
			assert near(y[0], 0.540302) && near(y[2], 0.841471)
			assert near(y[1], 0.99995) && near(y[3], 0.01)
			// Linear scaling halves the position; a factor of 2 halves the
			// pair's frequency: both turn position 2 into position 1.
			let z = float32[1, 0]
			rope(z, 2, 1, 2, float32(10000), RopeStyle.Adjacent, float32(0.5))
			assert near(z[0], 0.540302) && near(z[1], 0.841471)
			let w = float32[1, 0]
			rope(w, 2, 1, 2, float32(10000), RopeStyle.Adjacent, float32(1), float32[2])
			assert near(w[0], 0.540302) && near(w[1], 0.841471)
			// Only the first two of four values turn, scaled by 2.
			let v = float32[1, 0, 1, 1]
			rope(v, 1, 1, 4, float32(10000), RopeStyle.Halves, float32(1), float32[], 2, float32(2))
			assert near(v[0], 1.080605) && near(v[1], 1.682942) && near(v[2], 1.0) && near(v[3], 1.0)
			return none
		}
	}
}
