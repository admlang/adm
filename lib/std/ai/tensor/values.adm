partial module std.ai.tensor {
	use (
		std.formats.ai.onnx::(ElementType, TensorData, isFloat, elementBits)
	)

	// An n-dimensional array of values, row-major: `shape` holds the
	// sizes (none for a scalar) and `element` the type of the values. The
	// values are in one array, by type: `floats` for Float and the
	// narrower floating-point types (computed as float32, Complex64 as
	// real, imaginary pairs), `doubles` for Double and Complex128,
	// `ints` for the integer types and Bool (0 or 1), `strings` for
	// String; the other arrays stay empty.
	type Tensor {
		element ElementType
		shape   int[]
		floats  float32[]
		doubles float[]
		ints    int[]
		strings string[]

		// A tensor of float32 values (or of the narrower floating-point
		// `element` they stand for).
		def new(shape int[], values float32[], element ElementType = ElementType.Float) {
			self.shape = shape
			self.floats = values
			self.element = element
		}

		// A tensor of integer values: Int64 unless `element` says another
		// integer type or Bool.
		def new(shape int[], values int[], element ElementType = ElementType.Int64) {
			self.shape = shape
			self.ints = values
			self.element = element
		}

		// A tensor of Double values.
		def new(shape int[], values float[]) {
			self.shape = shape
			self.doubles = values
			self.element = ElementType.Double
		}

		// A tensor of String values.
		def new(shape int[], values string[]) {
			self.shape = shape
			self.strings = values
			self.element = ElementType.String
		}

		// The number of values: the product of the shape (1 for a scalar).
		def count() int {
			let n = 1
			for let (_, d) in shape {
				n *= d
			}
			return n
		}

		// The number of dimensions.
		def rank() int {
			return shape.len()
		}

		// The tensor as model data called `name`: its values in raw form,
		// floating-point types rounded to `element`.
		def toData(name string) TensorData {
			let t = new TensorData()
			t.name = name
			t.element = element
			t.dims = shape.clone()
			match storageOf(element) {
				case Storage.Floats:
					t.data = rawFloats(element, floats)
				case Storage.Doubles:
					for let (_, v) in doubles {
						putLe(t.data, int(__bitcast_u64_from_f64(v)), 8)
					}
				case Storage.Ints:
					t.data = rawInts(element, ints)
				case Storage.Strings:
					for let (_, s) in strings {
						t.strings.push(s.bytes())
					}
			}
			return t
		}
	}

	// Which array of a Tensor holds the values of an element type.
	enum Storage {
		Floats,
		Doubles,
		Ints,
		Strings,
	}

	// The array a Tensor of `element` values keeps them in.
	def storageOf(element ElementType) Storage {
		return Storage.Strings when element == ElementType.String
		return Storage.Doubles when element := ElementType.Double || ElementType.Complex128
		return Storage.Floats when isFloat(element)
		return Storage.Ints
	}

	// The tensor `data` holds, its values read into the array its element
	// type uses.
	// Fails when the data is shorter than its elements, or of a type
	// without values (Undefined).
	def tensorOf(data TensorData) !Tensor {
		fail "tensor: {data.name} has no element type" when data.element == ElementType.Undefined
		match storageOf(data.element) {
			case Storage.Floats:
				return new Tensor(data.dims.clone(), try data.floats(), data.element)
			case Storage.Doubles:
				let t = new Tensor(data.dims.clone(), try data.doubles())
				t.element = data.element
				return t
			case Storage.Ints:
				return new Tensor(data.dims.clone(), try data.ints(), data.element)
			default:
				return new Tensor(data.dims.clone(), data.texts())
		}
	}

	internal def putLe(out byte[], v int, count int) {
		for let k = 0; k < count; k++ {
			out.push(byte((v >> (8 * k)) & 255))
		}
	}

	// `values` as raw data of the floating-point type `element`.
	internal def rawFloats(element ElementType, values float32[]) byte[] {
		let out byte[]
		match element {
			case ElementType.Float, ElementType.Complex64:
				for let (_, v) in values {
					putLe(out, int(__bitcast_u32_from_f32(v)), 4)
				}
			case ElementType.Float16:
				for let (_, v) in values {
					putLe(out, halfBits(v), 2)
				}
			case ElementType.BFloat16:
				for let (_, v) in values {
					putLe(out, bfloatBits(v), 2)
				}
			default:
				let codes int[]
				for let (_, v) in values {
					codes.push(miniCode(element, v))
				}
				out = packCodes(codes, elementBits(element))
		}
		return out
	}

	// `values` as raw data of the integer type (or Bool) `element`.
	internal def rawInts(element ElementType, values int[]) byte[] {
		let bits = elementBits(element)
		if bits < 8 {
			let codes int[]
			for let (_, v) in values {
				codes.push(v & ((1 << bits) - 1))
			}
			return packCodes(codes, bits)
		}
		let out byte[]
		for let (_, v) in values {
			putLe(out, v, bits / 8)
		}
		return out
	}

	// Codes narrower than a byte, packed from the low bits up as ONNX
	// packs them (8-bit codes one per byte).
	internal def packCodes(codes int[], bits int) byte[] {
		let out byte[]
		let acc = 0
		let filled = 0
		for let (_, c) in codes {
			acc |= (c & ((1 << bits) - 1)) << filled
			filled += bits
			for filled >= 8 {
				out.push(byte(acc & 255))
				acc >>= 8
				filled -= 8
			}
		}
		out.push(byte(acc & 255)) when filled > 0
		return out
	}

	// The IEEE half-precision bits nearest `v`, ties to even.
	def halfBits(v float32) int {
		let bits = int(__bitcast_u32_from_f32(v))
		let sign = (bits >> 16) & 0x8000
		let exponent = (bits >> 23) & 255
		let mantissa = bits & 0x7FFFFF
		if exponent == 255 {
			return sign | 0x7C00 | (mantissa != 0 ?? (0x200, 0))
		}
		let e = exponent - 127 + 15
		if e >= 31 {
			return sign | 0x7C00
		}
		if e <= 0 {
			return sign when e < -10
			// Subnormal: the implicit bit joins the mantissa, then shifts.
			let m = mantissa | 0x800000
			let shift = 14 - e
			let half = m >> shift
			let rest = m & ((1 << shift) - 1)
			let middle = 1 << (shift - 1)
			if rest > middle || (rest == middle && (half & 1) == 1) {
				half++
			}
			return sign | half
		}
		let half = (e << 10) | (mantissa >> 13)
		let rest = mantissa & 0x1FFF
		if rest > 0x1000 || (rest == 0x1000 && (half & 1) == 1) {
			half++
		}
		return sign | half
	}

	// The bfloat16 bits nearest `v`, ties to even.
	def bfloatBits(v float32) int {
		let bits = int(__bitcast_u32_from_f32(v))
		if (bits >> 23) & 255 == 255 && bits & 0x7FFFFF != 0 {
			return ((bits >> 16) & 0xFFFF) | 0x40
		}
		let rest = bits & 0xFFFF
		let upper = bits >> 16
		if rest > 0x8000 || (rest == 0x8000 && (upper & 1) == 1) {
			upper++
		}
		return upper & 0xFFFF
	}

	// The code of the narrow floating-point type `element` nearest `v`
	// (ties to even); a finite value beyond the type's range saturates to
	// its largest finite value, infinity stays infinite in E5M2 and
	// saturates in the types without one.
	def miniCode(element ElementType, v float32) int {
		match element {
			case ElementType.Float8E8M0:
				return v != v ?? (255, roundE8M0(v))
			case ElementType.Float8E4M3FN:
				return encodeMini(v, 4, 3, 7, MiniKind.Fn)
			case ElementType.Float8E4M3FNUZ:
				return encodeMini(v, 4, 3, 8, MiniKind.Fnuz)
			case ElementType.Float8E5M2:
				return encodeMini(v, 5, 2, 15, MiniKind.Ieee)
			case ElementType.Float8E5M2FNUZ:
				return encodeMini(v, 5, 2, 16, MiniKind.Fnuz)
			case ElementType.Float4E2M1:
				return encodeMini(v, 2, 1, 1, MiniKind.Finite)
			case ElementType.Float6E2M3:
				return encodeMini(v, 2, 3, 1, MiniKind.Finite)
			case ElementType.Float6E3M2:
				return encodeMini(v, 3, 2, 3, MiniKind.Finite)
			default:
				return 0
		}
	}

	// How a narrow floating-point type spends its top codes: IEEE-like
	// infinities and NaNs (E5M2), all-ones NaN only (E4M3FN), negative
	// zero as NaN (the FNUZ types), or no special values (FP4, FP6).
	enum MiniKind {
		Ieee,
		Fn,
		Fnuz,
		Finite,
	}

	// The E8M0 code (a power of two) nearest `v`: the exponent rounded up
	// from halfway, as ONNX rounds.
	internal def roundE8M0(v float32) int {
		let bits = int(__bitcast_u32_from_f32(v))
		let exponent = (bits >> 23) & 255
		let mantissa = bits & 0x7FFFFF
		return 254.min(exponent + (mantissa >= 0x400000 ?? (1, 0)))
	}

	// The code of `v` in a sign, `e`-bit exponent, `m`-bit mantissa type
	// with bias `bias`, rounded to nearest even and saturated.
	internal def encodeMini(v float32, e int, m int, bias int, kind MiniKind) int {
		let signBit = 1 << (e + m)
		if v != v {
			match kind {
				case MiniKind.Ieee:
					return (((1 << e) - 1) << m) | 1
				case MiniKind.Fn:
					return signBit - 1
				case MiniKind.Fnuz:
					return signBit
				default:
					return 0
			}
		}
		let sign = v < float32(0) || (v == float32(0) && float32(1) / v < float32(0)) ?? (signBit, 0)
		let a = float(v.abs())
		// The largest finite code's magnitude.
		let topExponent = kind == MiniKind.Ieee ?? ((1 << e) - 2, (1 << e) - 1)
		let topMantissa = kind == MiniKind.Fn ?? ((1 << m) - 2, (1 << m) - 1)
		// Infinity stays infinite in the type that has one; any other value
		// beyond the largest finite one saturates to it.
		if a == 1.0 / 0.0 && kind == MiniKind.Ieee {
			return sign | (((1 << e) - 1) << m)
		}
		let largest = (1.0 + float(topMantissa) / float(1 << m)) * 2.0 ** float(topExponent - bias)
		if a > largest {
			return sign | (topExponent << m) | topMantissa
		}
		// Steps of the smallest exponent band reach down to zero (subnormals).
		let exponent = 1
		for exponent < topExponent && a >= 2.0 ** float(exponent + 1 - bias) {
			exponent++
		}
		let step = 2.0 ** float(exponent - bias - m)
		let units = a / step
		let whole = units.floor()
		let frac = units - whole
		let q = int(whole)
		if frac > 0.5 || (frac == 0.5 && q % 2 == 1) {
			q++
		}
		// q counts steps of the band: below 1 << m it is subnormal when the
		// band is the first.
		if q >= 1 << (m + 1) {
			exponent++
			q >>= 1
		}
		if exponent == 1 && q < 1 << m {
			let code = sign | q
			return kind == MiniKind.Fnuz && code == signBit ?? (0, code)
		}
		if exponent > topExponent || (exponent == topExponent && q - (1 << m) > topMantissa) {
			return sign | (topExponent << m) | topMantissa
		}
		return sign | (exponent << m) | (q - (1 << m))
	}
}
