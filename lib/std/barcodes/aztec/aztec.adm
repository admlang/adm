partial module std.barcodes.aztec {
	// Aztec Code (ISO/IEC 24778): compact and full-range symbols and runes;
	// encode to a `Symbol` and decode a sampled module grid.
	use (
		std.barcodes::*
		std.barcodes.aztec.coding::*
		std.barcodes.scan::(Gray, BitGrid)
		std.formats.image::(Image)
	)

	// Format picks between the two kinds of Aztec symbol.
	enum Format {
		// Compact when the data fits one, else full-range.
		Auto
		// Compact: 1 to 4 layers, 15x15 to 27x27, no reference grid.
		Compact
		// Full-range: 1 to 32 layers, 19x19 to 151x151.
		Full
	}

	// Encodes text as an Aztec symbol. The text is split between the upper,
	// lower, mixed, punctuation and digit modes and binary runs, whichever is
	// shortest. Latin-1 text is stored as is; other text as UTF-8 announced
	// by ECI 26. A leading 0x1d (GS) makes a GS1 symbol (FNC1), and later
	// ones are FNC1 separators. ecc is the smallest share of the data area,
	// in percent, given to error correction (the standard recommends 23);
	// layers (1 to 32, compact 1 to 4) is chosen when 0. Fails when the text
	// does not fit.
	//
	// ```
	// let sym = aztec.encode("Aztec Code 2D :)")!
	// ```
	def encode(text string, ecc int = 23, layers int = 0, format Format = Format.Auto) !Symbol {
		let latin = true
		for let ch in text {
			latin = false when int(ch) > 255
		}
		let gs1 = text.startsWith("\u001d")
		let msg int[]
		if latin {
			for let ch in text {
				msg.push(int(ch) == 0x1d && gs1 ?? (256, int(ch)))
			}
		} else {
			for let b in text.bytes() {
				msg.push(int(b) == 0x1d && gs1 ?? (256, int(b)))
			}
		}
		return build(msg, latin ?? (-1, 26), ecc, layers, format)
	}

	// Encodes binary data as an Aztec symbol, as the text form does without
	// the GS1 and ECI handling. Fails when it does not fit.
	def encode(data byte[], ecc int = 23, layers int = 0, format Format = Format.Auto) !Symbol {
		let msg int[]
		for let b in data {
			msg.push(int(b))
		}
		return build(msg, -1, ecc, layers, format)
	}

	// An Aztec rune: an 11x11 bullseye holding a value from 0 to 255.
	// Fails when the value is out of range.
	def rune(value int) !Symbol {
		expects {
			assert value >= 0 && value <= 255 onerror fail "aztec: a rune holds 0 to 255"
		}
		return buildRune(value)
	}

	// Decodes an Aztec module grid (no quiet zone) in any orientation,
	// mirrored too. A rune reads as its value in decimal. Fails when the
	// mode message or the data cannot be read or corrected.
	def decode(sym Symbol) !Barcode {
		let content = try readGrid(sym)
		return Barcode{symbology: Symbology.Aztec, text: content.text, data: content.data}
	}

	// Finds and decodes every Aztec symbol (and rune) in an image, at any
	// rotation, mirrored ones included.
	def decode(img Image) Barcode[] {
		return detectAll(new BitGrid(new Gray(img)))
	}

	internal def build(msg int[], eci int, ecc int, layers int, format Format) !Symbol {
		expects {
			assert ecc >= 5 && ecc <= 95 onerror fail "aztec: ecc is a percentage from 5 to 95"
		}
		let f = format == Format.Auto ?? (0, format == Format.Compact ?? (1, 2))
		fail "aztec: compact symbols have 1 to 4 layers" when f == 1 && layers > 4
		fail "aztec: symbols have 1 to 32 layers" when layers < 0 || layers > 32
		return buildSymbol(msg, eci, ecc, layers, f)
	}
}
