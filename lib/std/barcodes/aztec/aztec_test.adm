partial module std.barcodes.aztec {
	use (
		std.testing
		std.barcodes::*
		std.barcodes.aztec.coding::*
	)

	// The symbol turned a quarter turn clockwise.
	def quarter(sym Symbol) Symbol {
		let out = new Symbol(sym.symbology, sym.height, sym.width, 2)
		for let y = 0; y < sym.height; y++ {
			for let x = 0; x < sym.width; x++ {
				out.dark(sym.height - 1 - y, x, sym.dark(x, y))
			}
		}
		return out
	}

	check "Aztec" {
		@test()
		def TestRoundTrip() !none {
			let texts = [
				"Aztec Code 2D :)",
				"0123456789",
				"hello WORLD mixed Case 12.5, ok: yes!",
				"a\r\nb. c, d: e",
				"ÀÁÂÃÄÅÆÇ binary ÿ",
				"世界 Grüße",
				"\u001d0112345678901231\u001d10ABC",
				"A",
				"The quick brown fox jumps over the lazy dog ".repeat(6),
				"0123456789".repeat(80)
			]
			for let text in texts {
				let sym = try encode(text)
				let back = try decode(sym)
				fail "'{text}' read '{back.text}'" when back.text != text || back.symbology != Symbology.Aztec
			}
			let bin = byte[0, 1, 2, 128, 200, 255, 31, 32]
			assert (try decode(try encode(bin))).data.hex() == bin.hex()
		}

		@test()
		def TestFormats() !none {
			let compact = try encode("compact", format = Format.Compact)
			assert compact.width == 15 || compact.width == 19
			let full = try encode("full range", format = Format.Full)
			assert (try decode(full)).text == "full range"
			let sized = try encode("layers", layers = 6)
			assert sized.width == symbolSize(6, false)
			assert (try decode(sized)).text == "layers"
			let long = "more error correction needs more layers ".repeat(3)
			let heavy = try encode(long, ecc = 80)
			assert heavy.width > (try encode(long)).width
			assert (try decode(heavy)).text == long
			let r = try rune(147)
			assert r.width == 11
			assert (try decode(r)).text == "147"
		}

		@test()
		def TestDamageAndTurns() !none {
			let sym = try encode("Aztec corrects its errors too", ecc = 40)
			for let x = 0; x < 6; x++ {
				sym.dark(x, 1, !sym.dark(x, 1))
			}
			assert (try decode(sym)).text == "Aztec corrects its errors too"
			let turnedOnce = quarter(try encode("turned"))
			assert (try decode(turnedOnce)).text == "turned"
		}

		@test()
		def TestImages() !none {
			let sym = try encode("Aztec in an image, turned", format = Format.Full)
			let found = decode(quarter(sym).toImage(scale = 4))
			assert found.len() == 1 && found[0].text == "Aztec in an image, turned"
			let compact = decode(quarter(quarter(try encode("compact one"))).toImage(scale = 3))
			assert compact.len() == 1 && compact[0].text == "compact one"
			let r = decode((try rune(42)).toImage(scale = 4))
			assert r.len() == 1 && r[0].text == "42"
		}
	}
}
