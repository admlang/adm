internal partial module std.barcodes.aztec.coding {
	use (
		std.barcodes::*
		std.math.ecc::(ReedSolomon)
		std.data.encoding.codepages
	)

	// What a grid's mode message says.
	struct Mode {
		compact   bool
		layers    int
		dataWords int
		// The rune value for an 11x11 rune, else -1.
		rune      int
	}

	// Reads and corrects the mode message of an upright grid, a rune's when
	// rune is set; none when it does not check out.
	def readMode(sym Symbol, compact bool, rune bool) ?Mode {
		let center = sym.width / 2
		let bits int[]
		if compact {
			bits.len(28)
			for let i = 0; i < 7; i++ {
				let offset = center - 3 + i
				bits[i] = sym.dark(offset, center - 5) ?? (1, 0)
				bits[i + 7] = sym.dark(center + 5, offset) ?? (1, 0)
				bits[20 - i] = sym.dark(offset, center + 5) ?? (1, 0)
				bits[27 - i] = sym.dark(center - 5, offset) ?? (1, 0)
			}
		} else {
			bits.len(40)
			for let i = 0; i < 10; i++ {
				let offset = center - 5 + i + i / 5
				bits[i] = sym.dark(offset, center - 7) ?? (1, 0)
				bits[i + 10] = sym.dark(center + 7, offset) ?? (1, 0)
				bits[29 - i] = sym.dark(offset, center + 7) ?? (1, 0)
				bits[39 - i] = sym.dark(center - 7, offset) ?? (1, 0)
			}
		}
		if rune {
			for let k = 0; k < 28; k++ {
				bits[k] = bits[k] ^ (k % 2 == 0 ?? (1, 0))
			}
		}
		let words int[]
		for let k = 0; k < bits.len(); k += 4 {
			words.push((bits[k] << 3) | (bits[k + 1] << 2) | (bits[k + 2] << 1) | bits[k + 3])
		}
		let dataCount = compact ?? (2, 4)
		let rs = new ReedSolomon(field4, words.len() - dataCount, 1)
		let fixed = rs.correct(words) onerror recover -1
		return none when fixed < 0
		return Mode{compact: true, layers: 0, dataWords: 0, rune: (words[0] << 4) | words[1]} when rune
		if compact {
			let v = (words[0] << 4) | words[1]
			return Mode{compact: true, layers: (v >> 6) + 1, dataWords: (v & 63) + 1, rune: -1}
		}
		let v = (words[0] << 12) | (words[1] << 8) | (words[2] << 4) | words[3]
		return Mode{compact: false, layers: (v >> 11) + 1, dataWords: (v & 2047) + 1, rune: -1}
	}

	// Whether the orientation marks around the mode message of an upright
	// grid are right: three dark at the top left, two at the top right, one
	// at the bottom right.
	def upright(sym Symbol, compact bool) bool {
		let c = sym.width / 2
		let r = compact ?? (5, 7)
		let wrong = 0
		let want = (x int, y int, dark bool) => sym.dark(x, y) == dark
		wrong += want(c - r, c - r, true) ?? (0, 1)
		wrong += want(c - r + 1, c - r, true) ?? (0, 1)
		wrong += want(c - r, c - r + 1, true) ?? (0, 1)
		wrong += want(c + r, c - r, true) ?? (0, 1)
		wrong += want(c + r, c - r + 1, true) ?? (0, 1)
		wrong += want(c + r - 1, c - r, false) ?? (0, 1)
		wrong += want(c + r, c + r - 1, true) ?? (0, 1)
		wrong += want(c + r, c + r, false) ?? (0, 1)
		wrong += want(c - r, c + r, false) ?? (0, 1)
		wrong += want(c - r + 1, c + r, false) ?? (0, 1)
		wrong += want(c - r, c + r - 1, false) ?? (0, 1)
		return wrong <= 2
	}

	// The grid turned a quarter turn clockwise, or mirrored about its main
	// diagonal.
	def turned(sym Symbol, mirror bool) Symbol {
		let n = sym.width
		let out = new Symbol(sym.symbology, n, n, sym.quietZone)
		for let y = 0; y < n; y++ {
			for let x = 0; x < n; x++ {
				if mirror {
					out.dark(y, x, sym.dark(x, y))
				} else {
					out.dark(n - 1 - y, x, sym.dark(x, y))
				}
			}
		}
		return out
	}

	// Decoded content.
	struct Content {
		text string
		data byte[]
		rune int
	}

	// Reads a grid in any of its eight orientations. Fails when no
	// orientation has a valid mode message and data.
	def readGrid(sym Symbol) !Content {
		expects {
			assert sym.width == sym.height onerror fail "aztec: symbol is not square"
		}
		let formats bool[]
		let n = sym.width
		formats.push(true) when n := 11 || 15 || 19 || 23 || 27
		for let l = 1; l <= 32; l++ {
			formats.push(false) when symbolSize(l, false) == n
		}
		fail "aztec: no symbol is {n} modules a side" when formats.len() == 0
		let reason = "aztec: no orientation reads"
		let grid = sym
		for let mirror = 0; mirror < 2; mirror++ {
			grid = mirror == 1 ?? (turned(sym, true), sym)
			for let turn = 0; turn < 4; turn++ {
				for let compact in formats {
					continue when !upright(grid, compact)
					let mode = readMode(grid, compact, compact && n == 11)
					continue when mode is none
					let m = mode
					return Content{text: m.rune.str(), data: byte[], rune: m.rune} when m.rune >= 0
					continue when symbolSize(m.layers, m.compact) != n
					let content = readData(grid, m) onerror (err error) {
						reason = err.message
						recover Content{rune: -2}
					}
					return content when content.rune != -2
				}
				grid = turned(grid, false)
			}
		}
		fail reason
	}

	// Reads, corrects, unstuffs and parses the data layers.
	def readData(sym Symbol, m Mode) !Content {
		let layers = m.layers
		let compact = m.compact
		let base = (compact ?? (11, 14)) + layers * 4
		let at = alignmentMap(layers, compact)
		let total = layerBits(layers, compact)
		let raw byte[]
		raw.len(total)
		let rowOffset = 0
		for let i = 0; i < layers; i++ {
			let rowSize = (layers - i) * 4 + (compact ?? (9, 12))
			for let j = 0; j < rowSize; j++ {
				let col = j * 2
				for let k = 0; k < 2; k++ {
					raw[rowOffset + col + k] = sym.dark(at[i * 2 + k], at[i * 2 + j]) ?? (1, 0)
					raw[rowOffset + rowSize * 2 + col + k] = sym.dark(at[i * 2 + j], at[base - 1 - i * 2 - k]) ?? (1, 0)
					raw[rowOffset + rowSize * 4 + col + k] = sym.dark(at[base - 1 - i * 2 - k], at[base - 1 - i * 2 - j]) ?? (1, 0)
					raw[rowOffset + rowSize * 6 + col + k] = sym.dark(at[base - 1 - i * 2 - j], at[i * 2 + k]) ?? (1, 0)
				}
			}
			rowOffset += rowSize * 8
		}
		let wordSize = wordSizes[layers]
		let count = total / wordSize
		fail "aztec: more data words than the symbol holds" when m.dataWords > count
		let words int[]
		let start = total % wordSize
		for let k = 0; k < count; k++ {
			let v = 0
			for let j = 0; j < wordSize; j++ {
				v = (v << 1) | int(raw[start + k * wordSize + j])
			}
			words.push(v)
		}
		let rs = new ReedSolomon(fieldFor(wordSize), count - m.dataWords, 1)
		try rs.correct(words)
		let mask = (1 << wordSize) - 1
		let bits byte[]
		for let k = 0; k < m.dataWords; k++ {
			let w = words[k]
			fail "aztec: invalid data word" when w == 0 || w == mask
			if w == 1 || w == mask - 1 {
				for let j = 0; j < wordSize - 1; j++ {
					bits.push(w > 1 ?? (1, 0))
				}
				continue
			}
			for let j = wordSize - 1; j >= 0; j-- {
				bits.push(byte((w >> j) & 1))
			}
		}
		return parseBits(bits)
	}

	def readCode(bits byte[], at int, n int) int {
		let v = 0
		for let k = 0; k < n; k++ {
			v = (v << 1) | int(bits[at + k])
		}
		return v
	}

	// Parses the unstuffed data bits: characters in the five modes with their
	// latches and shifts, binary shift runs and FLG(n) for FNC1 and ECI.
	// Fails on a reserved FLG(7) or a bad ECI digit.
	def parseBits(bits byte[]) !Content {
		let text = ""
		let data byte[]
		let pending byte[]
		let eci = -1
		let latched = upper
		let current = upper
		let binary = false
		let i = 0
		let end = bits.len()
		for i < end {
			if binary {
				break when end - i < 5
				let length = readCode(bits, i, 5)
				i += 5
				if length == 0 {
					break when end - i < 11
					length = readCode(bits, i, 11) + 31
					i += 11
				}
				for let k = 0; k < length; k++ {
					if end - i < 8 {
						i = end
						break
					}
					let b = byte(readCode(bits, i, 8))
					pending.push(b)
					data.push(b)
					i += 8
				}
				binary = false
				current = latched
				continue
			}
			let size = modeBits(current)
			break when end - i < size
			let code = readCode(bits, i, size)
			i += size
			let mode = current
			// Characters return to the latched mode after a shift.
			current = latched
			if mode == punct && code == 0 {
				break when end - i < 3
				let flg = readCode(bits, i, 3)
				i += 3
				fail "aztec: reserved FLG(7)" when flg == 7
				if flg == 0 {
					text += decodeBytes(pending, eci)
					pending = byte[]
					text += "\u001d"
					data.push(0x1d)
					continue
				}
				break when end - i < 4 * flg
				let value = 0
				for let k = 0; k < flg; k++ {
					let d = readCode(bits, i, 4)
					i += 4
					fail "aztec: bad ECI digit" when d < 2 || d > 11
					value = value * 10 + d - 2
				}
				text += decodeBytes(pending, eci)
				pending = byte[]
				eci = value
				continue
			}
			let action = controlOf(mode, code)
			if action >= 0 {
				// action: target mode * 2 + latch flag, or 10 for binary shift.
				if action == 10 {
					latched = mode
					binary = true
					continue
				}
				let target = action / 2
				if action % 2 == 1 {
					latched = target
					current = target
				} else {
					latched = mode
					current = target
				}
				continue
			}
			for let b in charsOf(mode, code) {
				pending.push(byte(b))
				data.push(byte(b))
			}
		}
		text += decodeBytes(pending, eci)
		return Content{text: text, data: data, rune: -1}
	}

	// The control a code is in a mode: target * 2 + 1 for a latch, target * 2
	// for a shift, 10 for binary shift; -1 for a character.
	def controlOf(mode int, code int) int {
		switch {
			case mode == upper || mode == lower:
				return punct * 2 when code == 0
				return lower * 2 + 1 when mode == upper && code == 28
				return upper * 2 when mode == lower && code == 28
				return mixed * 2 + 1 when code == 29
				return digit * 2 + 1 when code == 30
				return 10 when code == 31
			case mode == mixed:
				return punct * 2 when code == 0
				return lower * 2 + 1 when code == 28
				return upper * 2 + 1 when code == 29
				return punct * 2 + 1 when code == 30
				return 10 when code == 31
			case mode == punct:
				return upper * 2 + 1 when code == 31
			default:
				return punct * 2 when code == 0
				return upper * 2 + 1 when code == 14
				return upper * 2 when code == 15
		}
		return -1
	}

	// The bytes a character code stands for in a mode.
	def charsOf(mode int, code int) int[] {
		switch {
			case mode == upper:
				return code == 1 ?? (int[32], int[64 + code - 1])
			case mode == lower:
				return code == 1 ?? (int[32], int[96 + code - 1])
			case mode == mixed:
				return int[mixedChars[code]]
			case mode == digit:
				return int[32] when code == 1
				return int[44] when code == 12
				return int[46] when code == 13
				return int[48 + code - 2]
		}
		switch {
			case code == 2:
				return int[13, 10]
			case code == 3:
				return int[46, 32]
			case code == 4:
				return int[44, 32]
			case code == 5:
				return int[58, 32]
		}
		return int[punctChars[code]]
	}

	// Bytes as text in the character set the ECI names; without one, UTF-8
	// when they are valid UTF-8, else Latin-1 (the Aztec default).
	def decodeBytes(pending byte[], eci int) string {
		return "" when pending.len() == 0
		switch {
			case eci == 26:
				return string(pending)
			case eci == 0 || eci == 2:
				return codepages.decode(pending, codepages.CodePage.CP437)
			case eci == 1 || eci == 3:
				return codepages.decode(pending, codepages.CodePage.Latin1)
			case eci == 21:
				return codepages.decode(pending, codepages.CodePage.Windows1252)
		}
		let s = string(pending)
		return s when s.isUTF8()
		return codepages.decode(pending, codepages.CodePage.Latin1)
	}
}
