internal partial module std.barcodes.aztec.coding {
	use (
		std.barcodes::*
		std.barcodes.scan::*
		std.math.geom::(Point)
		std.math
	)

	// A bullseye candidate: centre and module size.
	struct Eye {
		x     float
		y     float
		size  float
		count int
	}

	// Whether seven runs from i are all about one width: the bullseye's
	// rings as a line through its centre crosses them.
	def eyeRuns(runs int[], i int) bool {
		return false when i < 0 || i + 7 > runs.len()
		let total = 0
		for let k = 0; k < 7; k++ {
			total += runs[i + k]
		}
		let w = float(total) / 7.0
		return false when w < 1.0
		for let k = 0; k < 7; k++ {
			let v = float(runs[i + k])
			return false when v < w * 0.5 || v > w * 1.5
		}
		return true
	}

	// Runs of a column through x from y outwards: three runs past the one
	// holding y each way, with the centre run; -1 when too short.
	def columnCheck(img BitGrid, x int, y int, w float) float {
		return -1.0 when !img.dark(x, y)
		let up = y
		for up > 0 && img.dark(x, up - 1) {
			up--
		}
		let down = y
		for down < img.height - 1 && img.dark(x, down + 1) {
			down++
		}
		let center = float(down - up + 1)
		return -1.0 when center < w * 0.5 || center > w * 1.5
		let lengths int[]
		let at = up - 1
		for let k = 0; k < 3; k++ {
			let start = at
			let dark = img.dark(x, at)
			for at >= 0 && img.dark(x, at) == dark {
				at--
			}
			lengths.push(start - at)
			return -1.0 when at < 0
		}
		at = down + 1
		for let k = 0; k < 3; k++ {
			let start = at
			let dark = img.dark(x, at)
			for at < img.height && img.dark(x, at) == dark {
				at++
			}
			lengths.push(at - start)
			return -1.0 when at >= img.height
		}
		for let v in lengths {
			return -1.0 when float(v) < w * 0.5 || float(v) > w * 1.5
		}
		return float(up + down) / 2.0 + 0.5
	}

	// Every bullseye candidate in the image.
	def findEyes(img BitGrid) Eye[] {
		let eyes Eye[]
		let step = (img.height / 600).max(1)
		for let y = 0; y < img.height; y += step {
			let runs int[]
			let starts int[]
			let x = 0
			for x < img.width {
				let d = img.dark(x, y)
				let start = x
				for x < img.width && img.dark(x, y) == d {
					x++
				}
				runs.push(x - start)
				starts.push(start)
			}
			let firstDark = img.dark(0, y) ?? (0, 1)
			for let k = firstDark; k < runs.len(); k += 2 {
				continue when !eyeRuns(runs, k - 3)
				let w = float(runs[k - 3] + runs[k - 2] + runs[k - 1] + runs[k] + runs[k + 1] + runs[k + 2] + runs[k + 3]) / 7.0
				let cx = float(starts[k]) + float(runs[k]) / 2.0
				let cy = columnCheck(img, int(cx), y, w)
				continue when cy < 0.0
				let merged = false
				for let e = 0; e < eyes.len(); e++ {
					let c = eyes[e]
					continue when (c.x - cx).abs() > w || (c.y - cy).abs() > w
					let n = float(c.count)
					eyes[e] = Eye{x: (c.x * n + cx) / (n + 1.0), y: (c.y * n + cy) / (n + 1.0), size: (c.size * n + w) / (n + 1.0), count: c.count + 1}
					merged = true
					break
				}
				eyes.push(Eye{x: cx, y: cy, size: w, count: 1}) when !merged
			}
		}
		return eyes
	}

	// How far from the centre along a ray the nth colour change is, in
	// pixels; -1 when the ray leaves the image first.
	def transition(img BitGrid, e Eye, angle float, nth int) float {
		let dx = math.cos(angle)
		let dy = math.sin(angle)
		let dark = true
		let seen = 0
		let r = 0.0
		let limit = e.size * 14.0
		for r < limit {
			let x = int(e.x + dx * r)
			let y = int(e.y + dy * r)
			return -1.0 when x < 0 || y < 0 || x >= img.width || y >= img.height
			if img.dark(x, y) != dark {
				dark = !dark
				seen++
				return r when seen == nth
			}
			r += 0.25
		}
		return -1.0
	}

	// The image corners of the bullseye square whose edge is the nth colour
	// change out from the centre, in order around it; each is the farthest
	// reach within 25 degrees of the corner direction.
	def eyeCorners(img BitGrid, e Eye, axis float, nth int) ?float[] {
		let out float[]
		for let q = 0; q < 4; q++ {
			let base = axis + 3.14159265358979 / 4.0 + float(q) * 3.14159265358979 / 2.0
			let best = -1.0
			let bestAngle = base
			for let k = -25; k <= 25; k++ {
				let a = base + float(k) * 3.14159265358979 / 180.0
				let r = transition(img, e, a, nth)
				continue when r <= best
				best = r
				bestAngle = a
			}
			return none when best <= 0.0
			out.push(e.x + math.cos(bestAngle) * best)
			out.push(e.y + math.sin(bestAngle) * best)
		}
		return out
	}

	// Samples an n x n grid centred on the bullseye through p, which maps
	// coordinates relative to the centre module's middle.
	def sampleAround(img BitGrid, p Perspective, n int) ?Symbol {
		let half = float(n / 2) + 0.5
		let cells byte[]
		cells.len(n * n)
		for let y = 0; y < n; y++ {
			for let x = 0; x < n; x++ {
				let (px, py) = p.map(float(x) + 0.5 - half, float(y) + 0.5 - half)
				return none when px < -1.0 || py < -1.0 || px > float(img.width) || py > float(img.height)
				cells[y * n + x] = img.dark(int(px.floor()), int(py.floor())) ?? (1, 0)
			}
		}
		let sym = new Symbol(Symbology.Aztec, n, n, 0)
		for let k = 0; k < n * n; k++ {
			sym.dark(k % n, k / n, cells[k] != 0)
		}
		return sym
	}

	// The mode message around a bullseye in any orientation; none when it
	// does not read.
	def modeAround(small Symbol, compact bool) ?Mode {
		let grid = small
		for let mirror = 0; mirror < 2; mirror++ {
			grid = mirror == 1 ?? (turned(small, true), small)
			for let turn = 0; turn < 4; turn++ {
				if upright(grid, compact) {
					let m = readMode(grid, compact, false)
					return m unless m is none
					if compact {
						let r = readMode(grid, true, rune = true)
						return r unless r is none
					}
				}
				grid = turned(grid, false)
			}
		}
		return none
	}

	// Refines a map from module coordinates (0 at the middle of the centre
	// module) to the image by least squares on ring edges: along rays at
	// every 3 degrees, colour changes 2 to rings lie on squares of half-size
	// 1.5, 2.5, ...; each point is snapped to its square under the current
	// map and the map refitted, three times.
	def refineRings(img BitGrid, e Eye, start Perspective, rings int) ?Perspective {
		let current = start
		for let round = 0; round < 3; round++ {
			let inverse = current.adjoint()
			let us float[]
			let vs float[]
			let xs float[]
			let ys float[]
			for let k = 0; k < 120; k++ {
				let angle = float(k) * 3.14159265358979 / 60.0
				let dx = math.cos(angle)
				let dy = math.sin(angle)
				for let nth = 2; nth <= rings; nth++ {
					let r = transition(img, e, angle, nth)
					continue when r < 0.0
					let px = e.x + dx * r
					let py = e.y + dy * r
					let (u0, v0) = inverse.map(px, py)
					let h = float(nth) - 0.5
					let u = u0
					let v = v0
					if u.abs() >= v.abs() {
						continue when v.abs() > h
						u = u < 0.0 ?? (-h, h)
					} else {
						continue when u.abs() > h
						v = v < 0.0 ?? (-h, h)
					}
					us.push(u)
					vs.push(v)
					xs.push(px)
					ys.push(py)
				}
			}
			return none when us.len() < 16
			let fitted = fitHomography(us, vs, xs, ys)
			return none when fitted is none
			current = fitted
		}
		return current
	}

	// Refines the map of a full-range symbol n modules across on its
	// reference grid: the lines through the centre and every 16 modules out
	// alternate dark and light modules to the edge. Each dark module's centre
	// is found along its line (its neighbours along the line are light) and
	// the map refitted to them with the ring points' map as the guide.
	def refineGrid(img BitGrid, start Perspective, n int) ?Perspective {
		let half = n / 2
		let current = start
		let reach = 10
		for {
			let next = refineGridTo(img, current, start, reach.min(half))
			if !(next is none) {
				let p = next
				current = p
			}
			break when reach >= half
			reach = reach * 3 / 2
		}
		return current
	}

	// One step of refineGrid over the modules within reach of the centre.
	// Each grid module constrains the map along its line only; the corners
	// of the bullseye squares under the ring map anchor it in both
	// directions.
	def refineGridTo(img BitGrid, start Perspective, rings Perspective, reach int) ?Perspective {
		let us float[]
		let vs float[]
		let xs float[]
		let ys float[]
		let ds float[]
		let es float[]
		for let h in [3.5, 5.5] {
			let hu = [-h, h, h, -h, 0.0, h, 0.0, -h]
			let hv = [-h, -h, h, h, -h, 0.0, h, 0.0]
			for let k = 0; k < 8; k++ {
				let (ax, ay) = rings.map(hu[k], hv[k])
				us.push(hu[k])
				vs.push(hv[k])
				xs.push(ax)
				ys.push(ay)
				ds.push(0.0)
				es.push(0.0)
			}
		}
		let lines int[]
		for let j = 0; j <= reach; j += 16 {
			lines.push(j)
			lines.push(-j) when j > 0
		}
		for let j in lines {
			for let t = -reach; t <= reach; t++ {
				continue when (t & 1) != 0 || (t.abs() <= 7 && j.abs() <= 7)
				for let horizontal in [true, false] {
					let u = float(horizontal ?? (t, j))
					let v = float(horizontal ?? (j, t))
					let (px, py) = start.map(u, v)
					let (ax, ay) = start.map(u + (horizontal ?? (1.0, 0.0)), v + (horizontal ?? (0.0, 1.0)))
					let stepX = ax - px
					let stepY = ay - py
					let pitch = math.sqrt(stepX * stepX + stepY * stepY)
					continue when pitch < 1.0
					let dirX = stepX / pitch
					let dirY = stepY / pitch
					continue when !img.dark(int(px), int(py))
					// The dark run along the line through the prediction.
					let back = 0.0
					for back < pitch && img.dark(int(px - dirX * (back + 0.5)), int(py - dirY * (back + 0.5))) {
						back += 0.5
					}
					let ahead = 0.0
					for ahead < pitch && img.dark(int(px + dirX * (ahead + 0.5)), int(py + dirY * (ahead + 0.5))) {
						ahead += 0.5
					}
					continue when back >= pitch || ahead >= pitch
					let shift = (ahead - back) / 2.0
					us.push(u)
					vs.push(v)
					xs.push(px + dirX * shift)
					ys.push(py + dirY * shift)
					ds.push(dirX)
					es.push(dirY)
				}
			}
		}
		return none when us.len() < 28
		return fitHomography(us, vs, xs, ys, ds, es)
	}

	// Reads the symbol around a bullseye; none when it does not decode.
	def readEye(img BitGrid, e Eye) ?Barcode {
		// Orientation: the angle whose four corner directions reach farthest
		// to the edge of the fourth ring (3.5 modules out).
		let best = 0.0
		let axis = 0.0
		for let k = 0; k < 90; k++ {
			let phi = float(k) * 3.14159265358979 / 180.0
			let r = 0.0
			for let q = 0; q < 4; q++ {
				r += transition(img, e, phi + 3.14159265358979 / 4.0 + float(q) * 3.14159265358979 / 2.0, 4).max(0.0)
			}
			continue when r <= best
			best = r
			axis = phi
		}
		let inner = eyeCorners(img, e, axis, 4)
		return none when inner is none
		let c = inner
		let first = quadToQuad([-3.5, -3.5, 3.5, -3.5, 3.5, 3.5, -3.5, 3.5], c)
		for let compact in [true, false] {
			// Compact bullseyes have clean ring edges out to 3.5 modules,
			// full-range ones to 5.5.
			let maps Perspective[]
			let refined = refineRings(img, e, first, compact ?? (4, 6))
			maps.push(refined) unless refined is none
			maps.push(first)
			for let p in maps {
				let small = sampleAround(img, p, compact ?? (11, 15))
				continue when small is none
				let mode = modeAround(small, compact)
				continue when mode is none
				let m = mode
				let n = m.rune >= 0 ?? (11, symbolSize(m.layers, m.compact))
				let sampling = p
				if !m.compact {
					let grid = refineGrid(img, p, n)
					sampling = grid unless grid is none
				}
				let whole = sampleAround(img, sampling, n)
				continue when whole is none
				let content = readGrid(whole) onerror recover Content{rune: -2}
				continue when content.rune == -2
				let half = float(n) / 2.0
				let corners Point[]
				let xs = [-half, half, half, -half]
				let ys = [-half, -half, half, half]
				for let q = 0; q < 4; q++ {
					let (px, py) = sampling.map(xs[q], ys[q])
					corners.push(new Point(px, py))
				}
				return Barcode{symbology: Symbology.Aztec, text: content.text, data: content.data, corners: corners}
			}
		}
		return none
	}

	// Every Aztec symbol in a binarized image.
	def detectAll(img BitGrid) Barcode[] {
		let out Barcode[]
		for let e in findEyes(img) {
			let found = readEye(img, e)
			continue when found is none
			let b = found
			let dup = false
			for let o in out {
				dup = true when o.text == b.text && (o.corners[0].x - b.corners[0].x).abs() < e.size * 4.0
			}
			out.push(b) when !dup
		}
		return out
	}
}
