internal partial module std.barcodes.aztec.coding {
	use (
		std.barcodes::*
		std.math.ecc::(ReedSolomon)
	)

	// Bits is a growing bit string, most significant bit first.
	type Bits {
		bits byte[]

		// Appends the low n bits of value.
		def add(value int, n int) {
			for let k = n - 1; k >= 0; k-- {
				bits.push(byte((value >> k) & 1))
			}
		}

		def len() int {
			return bits.len()
		}

		def at(i int) bool {
			return bits[i] != 0
		}
	}

	// One step of an encoding: codes to write, and how many input bytes they
	// take.
	struct Step {
		// Previous state index, -1 at the start.
		from   int
		// Kind: 0 latch, 1 character in the mode, 2 shifted character,
		// 3 pair in punctuation, 4 shifted pair, 5 binary run, 6 FLG(0).
		kind   int
		mode   int
		count  int
		// The mode a shifted character is in.
		target int
	}

	// The shortest bit string for msg (byte values; 256 stands for FNC1),
	// by dynamic programming over (position, mode) with latches, shifts,
	// punctuation pairs and binary shift runs.
	def encodeBits(msg int[]) Bits {
		let n = msg.len()
		let big = 1 << 40
		let cost int[]
		cost.len((n + 1) * 5)
		cost.fill(big)
		let steps Step[]
		steps.len((n + 1) * 5)
		cost[upper] = 0
		steps[upper] = Step{from: -1}
		for let i = 0; i <= n; i++ {
			// Latches at this position, twice to settle chains.
			for let round = 0; round < 2; round++ {
				for let from = 0; from < 5; from++ {
					let here = cost[i * 5 + from]
					continue when here >= big
					for let to = 0; to < 5; to++ {
						continue when to == from
						let (bits, _) = latch(from, to)
						let c = here + bits
						continue when c >= cost[i * 5 + to]
						cost[i * 5 + to] = c
						steps[i * 5 + to] = Step{from: i * 5 + from, kind: 0, mode: to, count: 0}
					}
				}
			}
			break when i == n
			let ch = msg[i]
			let pair = i + 1 < n ?? (pairCode(ch, msg[i + 1]), 0)
			for let m = 0; m < 5; m++ {
				let here = cost[i * 5 + m]
				continue when here >= big
				let relax = (next int, add int, kind int, count int, target int) => {
					let k = next * 5 + m
					if here + add < cost[k] {
						cost[k] = here + add
						steps[k] = Step{from: i * 5 + m, kind: kind, mode: m, count: count, target: target}
					}
				}
				if ch == 256 {
					// FLG(0) through punctuation: shift (or latched) plus 5 + 3 bits.
					relax(i + 1, (m == punct ?? (0, modeBits(m))) + 8, 6, 1, punct)
					continue
				}
				relax(i + 1, modeBits(m), 1, 1, m) when codeOf(m, ch) > 0
				relax(i + 2, 5, 3, 2, punct) when pair > 0 && m == punct
				if m != punct {
					relax(i + 2, modeBits(m) + 5, 4, 2, punct) when pair > 0
					for let t = 0; t < 5; t++ {
						continue when t == m || shift(m, t) < 0 || codeOf(t, ch) == 0
						relax(i + 1, modeBits(m) + modeBits(t), 2, 1, t)
					}
				}
				// Binary shift from upper, lower or mixed.
				if m == upper || m == lower || m == mixed {
					let bytes = 0
					for let k = 1; k <= 2078 && i + k <= n; k++ {
						break when msg[i + k - 1] == 256
						bytes += 8
						let header = 5 + (k <= 31 ?? (5, k <= 62 ?? (10, 16)))
						relax(i + k, header + bytes, 5, k, m)
					}
				}
			}
		}
		let end = 0
		for let m = 1; m < 5; m++ {
			end = m when cost[n * 5 + m] < cost[n * 5 + end]
		}
		// Walk back, then write forwards.
		let path int[]
		let at = n * 5 + end
		for steps[at].from >= 0 {
			path.push(at)
			at = steps[at].from
		}
		let out = new Bits()
		for let p = path.len() - 1; p >= 0; p-- {
			let k = path[p]
			let s = steps[k]
			let prevMode = s.from % 5
			let pos = s.from / 5
			switch {
				case s.kind == 0:
					let (bits, value) = latch(prevMode, s.mode)
					out.add(value, bits)
				case s.kind == 1:
					out.add(codeOf(s.mode, msg[pos]), modeBits(s.mode))
				case s.kind == 2:
					out.add(shift(s.mode, s.target), modeBits(s.mode))
					out.add(codeOf(s.target, msg[pos]), modeBits(s.target))
				case s.kind == 3:
					out.add(pairCode(msg[pos], msg[pos + 1]), 5)
				case s.kind == 4:
					out.add(0, modeBits(s.mode))
					out.add(pairCode(msg[pos], msg[pos + 1]), 5)
				case s.kind == 5:
					let count = s.count
					out.add(31, 5)
					if count <= 31 {
						out.add(count, 5)
					} else if count <= 62 {
						// Two runs: 31 bytes, then the rest.
						out.add(31, 5)
						for let j = 0; j < 31; j++ {
							out.add(msg[pos + j], 8)
						}
						out.add(31, 5)
						out.add(count - 31, 5)
						for let j = 31; j < count; j++ {
							out.add(msg[pos + j], 8)
						}
						continue
					} else {
						out.add(count - 31, 16)
					}
					for let j = 0; j < count; j++ {
						out.add(msg[pos + j], 8)
					}
				default:
					out.add(0, modeBits(s.mode)) when s.mode != punct
					out.add(0, 5)
					out.add(0, 3)
			}
		}
		return out
	}

	// Bits split into words with stuffing: a word whose leading bits are all
	// equal gets the opposite last bit and the bit it displaced goes on.
	def stuff(bits Bits, wordSize int) Bits {
		let out = new Bits()
		let n = bits.len()
		let mask = (1 << wordSize) - 2
		let i = 0
		for i < n {
			let word = 0
			for let j = 0; j < wordSize; j++ {
				word = word | (1 << (wordSize - 1 - j)) when i + j >= n || bits.at(i + j)
			}
			if (word & mask) == mask {
				out.add(word & mask, wordSize)
				i += wordSize - 1
			} else if (word & mask) == 0 {
				out.add(word | 1, wordSize)
				i += wordSize - 1
			} else {
				out.add(word, wordSize)
				i += wordSize
			}
		}
		return out
	}

	// Data words followed by their Reed-Solomon words, as the bits of a
	// layer area totalBits long (padded at the front).
	def withChecks(bits Bits, totalBits int, wordSize int) Bits {
		let words int[]
		for let k = 0; k + wordSize <= bits.len(); k += wordSize {
			let v = 0
			for let j = 0; j < wordSize; j++ {
				v = (v << 1) | int(bits.bits[k + j])
			}
			words.push(v)
		}
		let total = totalBits / wordSize
		let rs = new ReedSolomon(fieldFor(wordSize), total - words.len(), 1)
		let all = words + rs.encode(words)
		let out = new Bits()
		out.add(0, totalBits % wordSize)
		for let w in all {
			out.add(w, wordSize)
		}
		return out
	}

	// The mode message: layers and data word count with their check words.
	def modeMessage(compact bool, layers int, dataWords int) Bits {
		let m = new Bits()
		if compact {
			m.add(layers - 1, 2)
			m.add(dataWords - 1, 6)
			return withChecks(m, 28, 4)
		}
		m.add(layers - 1, 5)
		m.add(dataWords - 1, 11)
		return withChecks(m, 40, 4)
	}

	// Draws the bullseye, orientation marks, mode message, reference grid
	// and data layers of a symbol.
	def layout(data Bits, mode Bits, layers int, compact bool) Symbol {
		let size = symbolSize(layers, compact)
		let sym = new Symbol(Symbology.Aztec, size, size, 0)
		let base = (compact ?? (11, 14)) + layers * 4
		let at = alignmentMap(layers, compact)
		let rowOffset = 0
		for let i = 0; i < layers; i++ {
			let rowSize = (layers - i) * 4 + (compact ?? (9, 12))
			for let j = 0; j < rowSize; j++ {
				let col = j * 2
				for let k = 0; k < 2; k++ {
					sym.dark(at[i * 2 + k], at[i * 2 + j], true) when data.at(rowOffset + col + k)
					sym.dark(at[i * 2 + j], at[base - 1 - i * 2 - k], true) when data.at(rowOffset + rowSize * 2 + col + k)
					sym.dark(at[base - 1 - i * 2 - k], at[base - 1 - i * 2 - j], true) when data.at(rowOffset + rowSize * 4 + col + k)
					sym.dark(at[base - 1 - i * 2 - j], at[i * 2 + k], true) when data.at(rowOffset + rowSize * 6 + col + k)
				}
			}
			rowOffset += rowSize * 8
		}
		drawMode(sym, compact, mode)
		let center = size / 2
		bullseye(sym, center, compact ?? (5, 7))
		if !compact {
			let j = 0
			for let i = 0; i < base / 2 - 1; i += 15 {
				for let k = center & 1; k < size; k += 2 {
					sym.dark(center - j, k, true)
					sym.dark(center + j, k, true)
					sym.dark(k, center - j, true)
					sym.dark(k, center + j, true)
				}
				j += 16
			}
		}
		return sym
	}

	// Draws the mode message around the bullseye.
	def drawMode(sym Symbol, compact bool, mode Bits) {
		let center = sym.width / 2
		if compact {
			for let i = 0; i < 7; i++ {
				let offset = center - 3 + i
				sym.dark(offset, center - 5, true) when mode.at(i)
				sym.dark(center + 5, offset, true) when mode.at(i + 7)
				sym.dark(offset, center + 5, true) when mode.at(20 - i)
				sym.dark(center - 5, offset, true) when mode.at(27 - i)
			}
			return
		}
		for let i = 0; i < 10; i++ {
			let offset = center - 5 + i + i / 5
			sym.dark(offset, center - 7, true) when mode.at(i)
			sym.dark(center + 7, offset, true) when mode.at(i + 10)
			sym.dark(offset, center + 7, true) when mode.at(29 - i)
			sym.dark(center - 7, offset, true) when mode.at(39 - i)
		}
	}

	// Draws the bullseye rings out to size, and the orientation marks.
	def bullseye(sym Symbol, center int, size int) {
		for let i = 0; i < size; i += 2 {
			for let j = center - i; j <= center + i; j++ {
				sym.dark(j, center - i, true)
				sym.dark(j, center + i, true)
				sym.dark(center - i, j, true)
				sym.dark(center + i, j, true)
			}
		}
		sym.dark(center - size, center - size, true)
		sym.dark(center - size + 1, center - size, true)
		sym.dark(center - size, center - size + 1, true)
		sym.dark(center + size, center - size, true)
		sym.dark(center + size, center - size + 1, true)
		sym.dark(center + size, center + size - 1, true)
	}

	// Builds a symbol for msg with at least eccPercent of the data area as
	// error correction (plus 3 words). layers 0 picks the smallest symbol;
	// format 0 allows compact and full, 1 compact only, 2 full only.
	def buildSymbol(msg int[], eci int, eccPercent int, layers int, format int) !Symbol {
		let bits = new Bits()
		if eci >= 0 {
			// P/S FLG(n) and the ECI number's digits, back in upper case after.
			let digits = eci.str()
			bits.add(0, 5)
			bits.add(0, 5)
			bits.add(digits.len(), 3)
			for let ch in digits.bytes() {
				bits.add(int(ch) - 48 + 2, 4)
			}
		}
		for let b in encodeBits(msg).bits {
			bits.bits.push(b)
		}
		let eccBits = bits.len() * eccPercent / 100 + 11
		let total = bits.len() + eccBits
		for let i = 0; i <= 36; i++ {
			let compact = i < 4
			let l = compact ?? (i + 1, i - 3)
			continue when compact && format == 2
			continue when !compact && format == 1
			continue when layers > 0 && l != layers
			continue when !compact && l > 32
			let capacity = layerBits(l, compact)
			continue when total > capacity
			let wordSize = wordSizes[l]
			let stuffed = stuff(bits, wordSize)
			let usable = capacity - capacity % wordSize
			continue when compact && stuffed.len() > wordSize * 64
			continue when !compact && stuffed.len() > wordSize * 2048
			continue when stuffed.len() + eccBits > usable
			let data = withChecks(stuffed, capacity, wordSize)
			let mode = modeMessage(compact, l, stuffed.len() / wordSize)
			return layout(data, mode, l, compact)
		}
		fail "aztec: data too long for the symbol"
	}

	// An Aztec rune: the 11x11 bullseye alone, holding a value 0 to 255 in
	// its mode message.
	def buildRune(value int) Symbol {
		let m = new Bits()
		m.add(value, 8)
		let mode = withChecks(m, 28, 4)
		for let k = 0; k < 28; k++ {
			mode.bits[k] = mode.bits[k] ^ (k % 2 == 0 ?? (1, 0))
		}
		let sym = new Symbol(Symbology.Aztec, 11, 11, 0)
		drawMode(sym, true, mode)
		bullseye(sym, 5, 5)
		return sym
	}
}
