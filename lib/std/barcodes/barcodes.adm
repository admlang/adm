partial module std.barcodes {
	// Barcodes, linear and 2D. Shared here: the `Symbology` enum, `Symbol`
	// (the encoded symbol as a grid of dark/light modules, or bar and space
	// widths for linear codes), rendering a `Symbol` to an image or a draw
	// context with its quiet zone, and `detect(image)`, which finds and
	// decodes every symbol in a picture (binarization, finder patterns,
	// perspective correction, grid sampling). Each symbology lives in its own
	// submodule; the Reed-Solomon codes they use are `std.math.ecc`.
}
