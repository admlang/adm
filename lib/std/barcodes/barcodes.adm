partial module std.barcodes {
	// Barcodes, linear and 2D. Shared here: the `Symbology` enum, `Symbol`
	// (the encoded symbol as a grid of dark/light modules, or bar and space
	// widths for linear codes), rendering a `Symbol` to an image or a draw
	// context with its quiet zone, and `decode(image)`, which finds and
	// decodes every symbol in a picture (binarization, finder patterns,
	// perspective correction, grid sampling). Each symbology lives in its own
	// submodule; the Reed-Solomon codes they use are `std.math.ecc`.
	use (
		std.barcodes.linear
		std.barcodes.qr
		std.barcodes.datamatrix
		std.barcodes.aztec
		std.barcodes.pdf417
		std.formats.image::(Image)
	)

	// Encodes text in the given symbology with its defaults. Each symbology's
	// module takes the options: `qr.encode`, `datamatrix.encode`,
	// `aztec.encode`, `pdf417.encode`, `linear.encode`. Fails when the text
	// does not fit the symbology.
	def encode(text string, symbology Symbology) !Symbol {
		switch {
			case symbology == Symbology.Qr:
				return qr.encode(text)
			case symbology == Symbology.MicroQr:
				return qr.encode(text, level = qr.Level.L, micro = true)
			case symbology == Symbology.DataMatrix:
				return datamatrix.encode(text)
			case symbology == Symbology.Aztec:
				return aztec.encode(text)
			case symbology == Symbology.Pdf417:
				return pdf417.encode(text)
			case symbology == Symbology.MicroPdf417:
				return pdf417.encode(text, micro = true)
		}
		return linear.encode(text, symbology)
	}

	// Decodes a symbol's modules or widths, as an encoder made them or a
	// scanner sampled them. Fails when they do not decode.
	def decode(sym Symbol) !Barcode {
		switch {
			case sym.symbology == Symbology.Qr || sym.symbology == Symbology.MicroQr:
				return qr.decode(sym)
			case sym.symbology == Symbology.DataMatrix:
				return datamatrix.decode(sym)
			case sym.symbology == Symbology.Aztec:
				return aztec.decode(sym)
			case sym.symbology == Symbology.Pdf417 || sym.symbology == Symbology.MicroPdf417:
				return pdf417.decode(sym)
		}
		return linear.decode(sym)
	}

	// Finds and decodes every barcode in an image, whatever its symbology.
	def decode(img Image) Barcode[] {
		return qr.decode(img) + datamatrix.decode(img) + aztec.decode(img) + pdf417.decode(img) + linear.decode(img)
	}
}
