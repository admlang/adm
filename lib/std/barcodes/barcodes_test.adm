partial module std.barcodes {
	use (
		std.testing
		std.formats.image::(Image)
		std.gfx.canvas::(DrawContext)
	)

	// Images side by side on white.
	def row(images Image[]) Image {
		let w = 0
		let h = 0
		for let img in images {
			w += int(img.size().width)
			h = h.max(int(img.size().height))
		}
		let out = new Image(w, h)
		let px = out.raw()
		px.fill(255)
		let left = 0
		for let img in images {
			let src = img.raw()
			for let y = 0; y < int(img.size().height); y++ {
				for let x = 0; x < int(img.size().width) * 4; x++ {
					px[y * out.stride() + left * 4 + x] = src[y * img.stride() + x]
				}
			}
			left += int(img.size().width)
		}
		return out
	}

	check "Barcodes" {
		@test()
		def TestEveryEncoder() !none {
			let cases = [
				(Symbology.Qr, "QR Code"),
				(Symbology.MicroQr, "MICRO"),
				(Symbology.DataMatrix, "Data Matrix"),
				(Symbology.Aztec, "Aztec"),
				(Symbology.Pdf417, "PDF417"),
				(Symbology.MicroPdf417, "MicroPDF417"),
				(Symbology.Ean13, "5901234123457"),
				(Symbology.Ean8, "96385074"),
				(Symbology.UpcA, "036000291452"),
				(Symbology.UpcE, "01234565"),
				(Symbology.Code128, "Code 128"),
				(Symbology.Code39, "CODE 39"),
				(Symbology.Code93, "Code 93"),
				(Symbology.Itf, "12345670"),
				(Symbology.Codabar, "A123456B")
			]
			for let c in cases {
				let (symbology, text) = c
				let sym = try encode(text, symbology)
				assert sym.symbology == symbology
				let back = try decode(sym)
				fail "{symbology} read '{back.text}'" when back.text != text || back.symbology != symbology
			}
		}

		@test()
		def TestSymbol() !none {
			let sym = new Symbol(Symbology.Qr, 3, 2, 1)
			sym.dark(1, 1, true)
			assert sym.dark(1, 1) && !sym.dark(0, 0) && !sym.dark(5, 5)
			assert sym.str() == "...\n.#."
			assert !sym.linear()
			let img = sym.toImage(scale = 2)
			assert int(img.size().width) == (3 + 2) * 2
			let bars = new Symbol(Symbology.Code39, int[1, 2, 3], "x", 1)
			assert bars.linear() && bars.width == 6 && bars.dark(0, 0) && !bars.dark(1, 0) && bars.dark(3, 0)
			// One rectangle per run of dark modules in a row, one per bar.
			let ctx = new DrawContext()
			sym.draw(ctx, 0.0, 0.0, scale = 2.0)
			assert ctx.commands().len() == 1
			let barCtx = new DrawContext()
			bars.draw(barCtx, 10.0, 10.0)
			assert barCtx.commands().len() == 2
		}

		@test()
		def TestMixedImage() !none {
			let images = [
				(try encode("first QR", Symbology.Qr)).toImage(scale = 3),
				(try encode("then Data Matrix", Symbology.DataMatrix)).toImage(scale = 3),
				(try encode("an Aztec", Symbology.Aztec)).toImage(scale = 3),
				(try encode("CODE128 TOO", Symbology.Code128)).toImage(scale = 2)
			]
			let found = decode(row(images))
			let texts = found.mapElem(b => b.text)
			for let want in ["first QR", "then Data Matrix", "an Aztec", "CODE128 TOO"] {
				fail "missing {want}: {texts}" when !texts.includes(want)
			}
		}
	}
}
