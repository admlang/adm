internal partial module std.barcodes.datamatrix.coding {
	use (
		std.barcodes::*
		std.math.ecc::(ReedSolomon)
		std.data.encoding.codepages
	)

	// Data followed by the interleaved error correction codewords.
	def withEcc(data int[], s Size) int[] {
		let out = data.clone()
		out.len(s.dataWords + s.eccWords)
		let per = s.eccWords / s.blocks
		let rs = new ReedSolomon(dmField, per, 1)
		for let b = 0; b < s.blocks; b++ {
			let block int[]
			for let d = b; d < s.dataWords; d += s.blocks {
				block.push(data[d])
			}
			let ecc = rs.encode(block)
			for let k = 0; k < per; k++ {
				out[s.dataWords + b + k * s.blocks] = ecc[k]
			}
		}
		return out
	}

	// The symbol of the codewords in a size: data regions with their finder
	// and timing patterns.
	def buildSymbol(words int[], s Size) Symbol {
		let rows = mappingRows(s)
		let cols = mappingCols(s)
		let bits byte[]
		bits.len(rows * cols)
		bits.fill(0)
		let place = placement(rows, cols, words.len())
		for let k = 0; k < words.len() * 8; k++ {
			let at = place[k]
			continue when at < 0
			bits[at] = ((words[k / 8] >> (7 - k % 8)) & 1) == 1 ?? (1, 0)
		}
		for let k = words.len() * 8; k < place.len(); k++ {
			bits[place[k]] = 1
		}
		let sym = new Symbol(Symbology.DataMatrix, s.cols, s.rows, 1)
		for let y = 0; y < s.rows; y++ {
			let ry = y % (s.regionRows + 2)
			for let x = 0; x < s.cols; x++ {
				let rx = x % (s.regionCols + 2)
				let on = false
				switch {
					case ry == s.regionRows + 1: on = true
					case rx == 0: on = true
					case ry == 0: on = x % 2 == 0
					case rx == s.regionCols + 1: on = y % 2 == 1
					default:
						let my = (y / (s.regionRows + 2)) * s.regionRows + ry - 1
						let mx = (x / (s.regionCols + 2)) * s.regionCols + rx - 1
						on = bits[my * cols + mx] != 0
				}
				sym.dark(x, y, on)
			}
		}
		return sym
	}

	// Reads the codewords of a grid, corrects them and returns the data
	// codewords. Fails when the size is not an ECC 200 size or the damage is
	// beyond the error correction.
	def readWords(sym Symbol) !(int[], Size) {
		let found = sizeOf(sym.height, sym.width)
		fail "datamatrix: no symbol is {sym.width}x{sym.height}" when found is none
		let s = found
		let rows = mappingRows(s)
		let cols = mappingCols(s)
		let total = s.dataWords + s.eccWords
		let place = placement(rows, cols, total)
		let words int[]
		words.len(total)
		words.fill(0)
		for let k = 0; k < total * 8; k++ {
			let at = place[k]
			continue when at < 0
			let my = at / cols
			let mx = at % cols
			let y = (my / s.regionRows) * (s.regionRows + 2) + my % s.regionRows + 1
			let x = (mx / s.regionCols) * (s.regionCols + 2) + mx % s.regionCols + 1
			words[k / 8] = words[k / 8] | ((sym.dark(x, y) ?? (1, 0)) << (7 - k % 8))
		}
		let per = s.eccWords / s.blocks
		let rs = new ReedSolomon(dmField, per, 1)
		let data int[]
		data.len(s.dataWords)
		for let b = 0; b < s.blocks; b++ {
			let block int[]
			for let d = b; d < s.dataWords; d += s.blocks {
				block.push(words[d])
			}
			for let k = 0; k < per; k++ {
				block.push(words[s.dataWords + b + k * s.blocks])
			}
			try rs.correct(block)
			let at = 0
			for let d = b; d < s.dataWords; d += s.blocks {
				data[d] = block[at]
				at++
			}
		}
		return (data, s)
	}

	// Text and bytes read from data codewords.
	struct Decoded {
		text string
		data byte[]
	}

	// Parses data codewords through every encodation. Fails on a codeword
	// that is not valid where it stands.
	def parseWords(words int[]) !Decoded {
		let out = new Output()
		let trailer = ""
		let i = 0
		let n = words.len()
		for i < n {
			let w = words[i]
			i++
			switch {
				case w == 0:
					fail "datamatrix: codeword 0"
				case w <= 128:
					out.emit(w - 1)
				case w == pad:
					i = n
				case w <= 229:
					let v = w - 130
					out.emit(48 + v / 10)
					out.emit(48 + v % 10)
				case w == fnc1Word:
					out.gs()
				case w == 233:
					i += 3
				case w == 234:
					continue
				case w == upperShift:
					out.upper = true
				case w == macro05 || w == macro06:
					let header = "[)>\u001e0" + (w == macro05 ?? ("5", "6")) + "\u001d"
					for let ch in header {
						out.emit(int(ch))
					}
					trailer = "\u001e\u0004"
				case w == eciWord:
					out.flush()
					fail "datamatrix: truncated ECI" when i >= n
					let c1 = words[i]
					i++
					if c1 <= 127 {
						out.eci = c1 - 1
					} else if c1 <= 191 {
						out.eci = (c1 - 128) * 254 + words[i] - 1 + 127
						i++
					} else {
						out.eci = (c1 - 192) * 64516 + (words[i] - 1) * 254 + words[i + 1] - 1 + 16383
						i += 2
					}
				case w == latchC40 || w == latchText:
					let isText = w == latchText
					let shift = 0
					for i + 1 < n {
						break when words[i] == unlatch
						let v = words[i] * 256 + words[i + 1] - 1
						i += 2
						for let c in int[v / 1600, (v / 40) % 40, v % 40] {
							if shift == 0 {
								switch {
									case c <= 2: shift = c + 1
									case c == 3: out.emit(32)
									case c <= 13: out.emit(48 + c - 4)
									default: out.emit((isText ?? (97, 65)) + c - 14)
								}
								continue
							}
							let set = shift
							shift = 0
							switch {
								case set == 1:
									out.emit(c)
								case set == 2:
									switch {
										case c <= 14: out.emit(33 + c)
										case c <= 21: out.emit(58 + c - 15)
										case c <= 26: out.emit(91 + c - 22)
										case c == 27: out.gs()
										case c == 30: out.upper = true
										default:
											fail "datamatrix: bad shift 2 value {c}"
									}
								default:
									if isText {
										switch {
											case c == 0: out.emit(96)
											case c <= 26: out.emit(64 + c)
											default: out.emit(123 + c - 27)
										}
									} else {
										out.emit(96 + c)
									}
							}
						}
					}
					i++ when i < n && words[i] == unlatch
				case w == latchX12:
					for i + 1 < n {
						break when words[i] == unlatch
						let v = words[i] * 256 + words[i + 1] - 1
						i += 2
						for let c in int[v / 1600, (v / 40) % 40, v % 40] {
							switch {
								case c == 0: out.emit(13)
								case c == 1: out.emit(42)
								case c == 2: out.emit(62)
								case c == 3: out.emit(32)
								case c <= 13: out.emit(48 + c - 4)
								default: out.emit(65 + c - 14)
							}
						}
					}
					i++ when i < n && words[i] == unlatch
				case w == latchEdifact:
					let done = false
					for !done && i < n {
						if n - i < 3 {
							// Fewer than three codewords left: the rest is ASCII.
							break
						}
						let v = (words[i] << 16) | (words[i + 1] << 8) | words[i + 2]
						i += 3
						for let k = 0; k < 4; k++ {
							let c = (v >> (18 - 6 * k)) & 0x3f
							if c == 31 {
								done = true
								break
							}
							out.emit((c & 0x20) == 0 ?? (c | 0x40, c))
						}
					}
				case w == latchBase256:
					fail "datamatrix: truncated Base 256 field" when i >= n
					let d1 = unrandomize(words[i], i + 1)
					i++
					let count = d1
					if d1 == 0 {
						count = n - i
					} else if d1 >= 250 {
						fail "datamatrix: truncated Base 256 field" when i >= n
						count = 250 * (d1 - 249) + unrandomize(words[i], i + 1)
						i++
					}
					fail "datamatrix: Base 256 field runs past the data" when i + count > n
					for let k = 0; k < count; k++ {
						out.emit(unrandomize(words[i], i + 1))
						i++
					}
				default:
					fail "datamatrix: invalid codeword {w}"
			}
		}
		out.flush()
		for let ch in trailer {
			out.text += string(ch)
			out.data.push(byte(int(ch)))
		}
		return Decoded{text: out.text, data: out.data}
	}

	// Output collects decoded characters: bytes wait in pending until the
	// character set (from an ECI) turns them into text.
	type Output {
		text    string
		data    byte[]
		pending byte[]
		eci     int
		upper   bool

		def new() {
			eci = -1
		}

		// Adds one byte value, plus 128 after an upper shift.
		def emit(c int) {
			let v = upper ?? (c + 128, c)
			upper = false
			pending.push(byte(v))
			data.push(byte(v))
		}

		// Adds FNC1, read as the GS1 group separator.
		def gs() {
			flush()
			text += "\u001d"
			data.push(0x1d)
		}

		def flush() {
			text += flushBytes(pending, eci)
			pending = byte[]
		}
	}

	def unrandomize(v int, position int) int {
		let t = v - (((149 * position) % 255) + 1)
		return t >= 0 ?? (t, t + 256)
	}

	// Bytes as text in the character set the ECI names; without one, UTF-8
	// when they are valid UTF-8, else Latin-1 (the ECC 200 default).
	def flushBytes(pending byte[], eci int) string {
		return "" when pending.len() == 0
		switch {
			case eci == 26:
				return string(pending)
			case eci == 0 || eci == 2:
				return codepages.decode(pending, codepages.CodePage.CP437)
			case eci == 1 || eci == 3:
				return codepages.decode(pending, codepages.CodePage.Latin1)
			case eci == 21:
				return codepages.decode(pending, codepages.CodePage.Windows1252)
		}
		let s = string(pending)
		return s when s.isUTF8()
		return codepages.decode(pending, codepages.CodePage.Latin1)
	}
}
