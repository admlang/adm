partial module std.barcodes.datamatrix {
	// Data Matrix ECC 200 (ISO/IEC 16022): encode to a `Symbol` (ASCII, C40,
	// Text, X12, EDIFACT and Base 256 encodation; square and rectangular
	// sizes; GS1) and decode a sampled module grid.
	use (
		std.barcodes::*
		std.barcodes.datamatrix.coding::*
		std.barcodes.scan::(Gray, BitGrid)
		std.formats.image::(Image)
	)

	// Shape limits the symbol sizes encode picks from.
	enum Shape {
		// 10x10 to 144x144.
		Square
		// 8x18 to 16x48.
		Rectangle
		// Whichever holds the data in the fewest modules.
		Any
	}

	// Encodes text as a Data Matrix symbol in the smallest size of the shape.
	// Encodation switches between ASCII, C40, Text, X12, EDIFACT and Base 256
	// as the ISO 16022 look-ahead finds shortest. Text in Latin-1 is stored
	// as is; other text as UTF-8 announced by ECI 26. A leading 0x1d (GS)
	// makes a GS1 symbol, and later ones are FNC1 separators. Text framed as
	// `[)>` RS `05` GS ... RS EOT (or `06`) is shortened to the macro
	// codeword. Fails when the text does not fit the largest size.
	//
	// ```
	// let sym = datamatrix.encode("\u001d0112345678901231")!
	// ```
	def encode(text string, shape Shape = Shape.Square) !Symbol {
		let latin = true
		for let ch in text {
			latin = false when int(ch) > 255
		}
		let msg int[]
		let gs1 = text.startsWith("\u001d")
		if latin {
			for let ch in text {
				msg.push(int(ch) == 0x1d && gs1 ?? (256, int(ch)))
			}
		} else {
			for let b in text.bytes() {
				msg.push(int(b) == 0x1d && gs1 ?? (256, int(b)))
			}
		}
		msg = msg.slice(1, msg.len() - 1) when gs1
		return build(msg, shape, latin ?? (-1, 26), gs1)
	}

	// Encodes binary data as a Data Matrix symbol, as the text form does
	// without the GS1, ECI and macro handling. Fails when it does not fit.
	def encode(data byte[], shape Shape = Shape.Square) !Symbol {
		let msg int[]
		for let b in data {
			msg.push(int(b))
		}
		return build(msg, shape, -1, false)
	}

	// Decodes a Data Matrix module grid (no quiet zone), also when it is
	// mirrored. Text of a GS1 symbol starts with 0x1d (GS). Fails when the
	// size is not an ECC 200 size, the error correction cannot repair it or
	// the data is malformed.
	def decode(sym Symbol) !Barcode {
		let reason = ""
		for let attempt = 0; attempt < 2; attempt++ {
			let grid = attempt == 0 ?? (sym, transposed(sym))
			let result = readSymbol(grid) onerror (err error) {
				reason = err.message when attempt == 0
				recover Barcode{symbology: Symbology.Qr}
			}
			return result when result.symbology == Symbology.DataMatrix
		}
		fail reason
	}

	// Finds and decodes every Data Matrix symbol in an image, at any
	// rotation and under perspective, mirrored ones included. Each symbol
	// needs its quiet zone to stand apart from what is around it.
	def decode(img Image) Barcode[] {
		return detectAll(new BitGrid(new Gray(img)))
	}

	internal def readSymbol(sym Symbol) !Barcode {
		let (words, _) = try readWords(sym)
		let content = try parseWords(words)
		return Barcode{symbology: Symbology.DataMatrix, text: content.text, data: content.data}
	}

	internal def transposed(sym Symbol) Symbol {
		let out = new Symbol(sym.symbology, sym.height, sym.width, sym.quietZone)
		for let y = 0; y < sym.height; y++ {
			for let x = 0; x < sym.width; x++ {
				out.dark(y, x, sym.dark(x, y))
			}
		}
		return out
	}

	internal def build(msg int[], shape Shape, eci int, gs1 bool) !Symbol {
		let limit = shape == Shape.Square ?? (squareOnly, shape == Shape.Rectangle ?? (rectOnly, anyShape))
		let (words, size) = try encodeWords(msg, limit, eci, gs1)
		return buildSymbol(withEcc(words, size), size)
	}
}
