partial module std.barcodes.datamatrix {
	use (
		std.testing
		std.barcodes::*
		std.barcodes.datamatrix.coding::*
	)

	// The symbol turned a quarter turn clockwise.
	def turned(sym Symbol) Symbol {
		let out = new Symbol(sym.symbology, sym.height, sym.width, sym.quietZone)
		for let y = 0; y < sym.height; y++ {
			for let x = 0; x < sym.width; x++ {
				out.dark(sym.height - 1 - y, x, sym.dark(x, y))
			}
		}
		return out
	}

	check "DataMatrix" {
		@test()
		def TestEncodations() !none {
			let texts = [
				"123456",
				"HELLO WORLD ABC DEF GHI",
				"hello world lowercase text here",
				"ABC>DEF*123\r456*789>X12X12",
				"ABC:DEF;GHI=JKL@MNOP?QRS<TUV",
				"ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ",
				"\u001d0112345678901231\u001d10ABC123",
				"世界 Grüße",
				"A",
				"Mixed 123 abc DEF !@# 4567890 xyz",
				"[)>\u001e05\u001dHELLO WORLD\u001e\u0004",
				"x".repeat(300)
			]
			for let text in texts {
				let sym = try encode(text)
				let back = try decode(sym)
				fail "'{text}' read '{back.text}'" when back.text != text || back.symbology != Symbology.DataMatrix
			}
			let bin = byte[0, 1, 2, 128, 200, 255]
			assert (try decode(try encode(bin))).data.hex() == bin.hex()
		}

		@test()
		def TestSizes() !none {
			let small = try encode("123456")
			assert small.width == 10 && small.height == 10
			let (words, size) = try readWords(small)
			// Digit pairs in ASCII encodation: 130 + the pair's value.
			assert words[0] == 142 && words[1] == 164 && words[2] == 186
			assert size.dataWords == 3
			let rect = try encode("HELLO", shape = Shape.Rectangle)
			assert rect.height < rect.width
			assert (try decode(rect)).text == "HELLO"
			let big = try encode("0123456789".repeat(300))
			assert big.width == 144
			assert (try decode(big)).text == "0123456789".repeat(300)
			let tooLong = false
			encode("x".repeat(3000)) onerror (err error) {
				tooLong = true
				recover new Symbol(Symbology.DataMatrix, 1, 1)
			}
			assert tooLong
		}

		@test()
		def TestDamageAndMirror() !none {
			let sym = try encode("error correction in data matrix")
			for let x = 3; x < 9; x++ {
				sym.dark(x, 5, !sym.dark(x, 5))
			}
			assert (try decode(sym)).text == "error correction in data matrix"
			let flipped = new Symbol(Symbology.DataMatrix, sym.height, sym.width)
			let clean = try encode("mirrored")
			flipped = new Symbol(Symbology.DataMatrix, clean.height, clean.width)
			for let y = 0; y < clean.height; y++ {
				for let x = 0; x < clean.width; x++ {
					flipped.dark(y, x, clean.dark(x, y))
				}
			}
			assert (try decode(flipped)).text == "mirrored"
		}

		@test()
		def TestImages() !none {
			let sym = try encode("Data Matrix in a picture")
			let found = decode(turned(sym).toImage(scale = 4))
			assert found.len() == 1 && found[0].text == "Data Matrix in a picture"
			assert found[0].corners.len() == 4
			let rect = try encode("rectangular", shape = Shape.Rectangle)
			let r = decode(rect.toImage(scale = 3))
			assert r.len() == 1 && r[0].text == "rectangular"
		}
	}
}
