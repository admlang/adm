internal partial module std.barcodes.datamatrix.coding {
	use (
		std.barcodes::*
		std.barcodes.scan::*
		std.math.geom::(Point)
		std.math
	)

	// The map from the unit square to a quadrilateral (x, y pairs).
	def unitToQuad(q float[]) Perspective {
		return squareTo(q[0], q[1], q[2], q[3], q[4], q[5], q[6], q[7])
	}

	// The share of dark pixels along a line of the unit square mapped by p,
	// from (u0, v0) to (u1, v1).
	def darkShare(img BitGrid, p Perspective, u0, v0, u1, v1 float) float {
		let n = 64
		let dark = 0
		for let k = 0; k < n; k++ {
			let t = (float(k) + 0.5) / float(n)
			let (x, y) = p.map(u0 + (u1 - u0) * t, v0 + (v1 - v0) * t)
			dark += img.dark(int(x.floor()), int(y.floor())) ?? (1, 0)
		}
		return float(dark) / float(n)
	}

	// The number of dark runs along a line of the unit square mapped by p,
	// ignoring specks shorter than a fifth of the typical run.
	def darkRuns(img BitGrid, p Perspective, u0, v0, u1, v1 float) int {
		let n = 800
		let runs int[]
		let current = false
		let length = 0
		for let k = 0; k < n; k++ {
			let t = (float(k) + 0.5) / float(n)
			let (x, y) = p.map(u0 + (u1 - u0) * t, v0 + (v1 - v0) * t)
			let d = img.dark(int(x.floor()), int(y.floor()))
			if k > 0 && d != current {
				runs.push(current ?? (length, -length))
				length = 0
			}
			current = d
			length++
		}
		runs.push(current ?? (length, -length))
		let lengths int[]
		for let r in runs {
			lengths.push(r.abs())
		}
		let sorted = lengths.clone().sort((a, b) => a < b)
		let typical = sorted[sorted.len() / 2]
		let count = 0
		let inDark = false
		for let r in runs {
			let dark = r > 0
			continue when r.abs() * 5 < typical
			count += 1 when dark && !inDark
			inDark = dark
		}
		return count
	}

	// Decodes the symbol a quadrilateral frames, finding its L-shaped finder
	// and counting its timing patterns; none when it does not decode.
	def readQuad(img BitGrid, q float[]) ?Barcode {
		let p = unitToQuad(q)
		// Inset about half a module; start with a pixel and a half.
		let w = math.sqrt((q[2] - q[0]) * (q[2] - q[0]) + (q[3] - q[1]) * (q[3] - q[1]))
		let h = math.sqrt((q[6] - q[0]) * (q[6] - q[0]) + (q[7] - q[1]) * (q[7] - q[1]))
		let eu = 1.5 / w
		let ev = 1.5 / h
		let shares = [
			darkShare(img, p, 0.0, ev, 1.0, ev),
			darkShare(img, p, 1.0 - eu, 0.0, 1.0 - eu, 1.0),
			darkShare(img, p, 1.0, 1.0 - ev, 0.0, 1.0 - ev),
			darkShare(img, p, eu, 1.0, eu, 0.0)
		]
		// The solid sides meet at the corner after the darkest pair.
		let s = 0
		for let k = 1; k < 4; k++ {
			s = k when shares[k] + shares[(k + 1) % 4] > shares[s] + shares[(s + 1) % 4]
		}
		return none when shares[s] < 0.8 || shares[(s + 1) % 4] < 0.8
		let c = (s + 1) % 4
		let bl = c
		let tl = s
		let br = (c + 1) % 4
		let tr = (c + 2) % 4
		let cross = (q[2 * tl] - q[2 * bl]) * (q[2 * br + 1] - q[2 * bl + 1]) - (q[2 * tl + 1] - q[2 * bl + 1]) * (q[2 * br] - q[2 * bl])
		if cross < 0.0 {
			let t = tl
			tl = br
			br = t
		}
		let quad = [q[2 * tl], q[2 * tl + 1], q[2 * tr], q[2 * tr + 1], q[2 * br], q[2 * br + 1], q[2 * bl], q[2 * bl + 1]]
		let m = unitToQuad(quad)
		let cols = 2 * darkRuns(img, m, 0.0, ev, 1.0, ev)
		let rows = 2 * darkRuns(img, m, 1.0 - eu, 0.0, 1.0 - eu, 1.0)
		// Count again half a module in.
		if cols > 0 && rows > 0 {
			cols = 2 * darkRuns(img, m, 0.0, 0.5 / float(rows), 1.0, 0.5 / float(rows))
			rows = 2 * darkRuns(img, m, 1.0 - 0.5 / float(cols.max(2)), 0.0, 1.0 - 0.5 / float(cols.max(2)), 1.0)
		}
		for let dr in int[0, -2, 2, -4, 4] {
			for let dc in int[0, -2, 2, -4, 4] {
				let found = sizeOf(rows + dr, cols + dc)
				continue when found is none
				let size = found
				let pm = quadToQuad([0.0, 0.0, float(size.cols), 0.0, float(size.cols), float(size.rows), 0.0, float(size.rows)], quad)
				let cells = sampleGrid(img, size.cols, size.rows, pm)
				continue when cells is none
				let grid = cells
				let sym = new Symbol(Symbology.DataMatrix, size.cols, size.rows, 1)
				for let y = 0; y < size.rows; y++ {
					for let x = 0; x < size.cols; x++ {
						sym.dark(x, y, grid[y * size.cols + x] != 0)
					}
				}
				let decoded = readGridBarcode(sym)
				continue when decoded is none
				let b = decoded
				let corners Point[]
				let us = [0.0, float(size.cols), float(size.cols), 0.0]
				let vs = [0.0, 0.0, float(size.rows), float(size.rows)]
				for let k = 0; k < 4; k++ {
					let (x, y) = pm.map(us[k], vs[k])
					corners.push(new Point(x, y))
				}
				return Barcode{symbology: Symbology.DataMatrix, text: b.text, data: b.data, corners: corners}
			}
		}
		return none
	}

	// Reads a sampled grid, mirrored too; none when it does not decode.
	def readGridBarcode(sym Symbol) ?Barcode {
		for let attempt = 0; attempt < 2; attempt++ {
			let grid = sym
			if attempt == 1 {
				grid = new Symbol(sym.symbology, sym.height, sym.width, 1)
				for let y = 0; y < sym.height; y++ {
					for let x = 0; x < sym.width; x++ {
						grid.dark(y, x, sym.dark(x, y))
					}
				}
				continue when sizeOf(grid.height, grid.width) is none
			}
			let words = readWords(grid) onerror recover (int[], sizes[0])
			let (data, _) = words
			continue when data.len() == 0
			let content = parseWords(data) onerror recover Decoded{text: "\u0000"}
			continue when content.text == "\u0000"
			return Barcode{symbology: Symbology.DataMatrix, text: content.text, data: content.data}
		}
		return none
	}

	// Every Data Matrix symbol in a binarized image.
	def detectAll(img BitGrid) Barcode[] {
		let out Barcode[]
		for let b in blobs(img, 40) {
			continue when b.right - b.left < 7 || b.bottom - b.top < 7
			let quad = blobQuad(b)
			continue when quad is none
			let found = readQuad(img, quad)
			out.push(found) unless found is none
		}
		return out
	}
}
