internal partial module std.barcodes.datamatrix.coding {
	use std.math.ecc::(BinaryField)

	// The Data Matrix field: GF(256) over x^8 + x^5 + x^3 + x^2 + 1.
	let dmField = new BinaryField(8, 0x12d)

	// One ECC 200 symbol size.
	struct Size {
		// Whole symbol, finder and timing patterns included.
		rows          int
		cols          int
		// One data region.
		regionRows    int
		regionCols    int
		// Data regions down and across.
		regionsDown   int
		regionsAcross int
		dataWords     int
		eccWords      int
		// Reed-Solomon blocks the codewords are interleaved over.
		blocks        int
		rect          bool
	}

	def size(rows, cols, rr, rc, down, across, data, ecc, blocks int) Size {
		return Size{rows: rows, cols: cols, regionRows: rr, regionCols: rc, regionsDown: down, regionsAcross: across, dataWords: data, eccWords: ecc, blocks: blocks, rect: rows != cols}
	}

	// Every ECC 200 size, smallest capacity first.
	let sizes = [
		size(10, 10, 8, 8, 1, 1, 3, 5, 1),
		size(12, 12, 10, 10, 1, 1, 5, 7, 1),
		size(8, 18, 6, 16, 1, 1, 5, 7, 1),
		size(14, 14, 12, 12, 1, 1, 8, 10, 1),
		size(8, 32, 6, 14, 1, 2, 10, 11, 1),
		size(16, 16, 14, 14, 1, 1, 12, 12, 1),
		size(12, 26, 10, 24, 1, 1, 16, 14, 1),
		size(18, 18, 16, 16, 1, 1, 18, 14, 1),
		size(20, 20, 18, 18, 1, 1, 22, 18, 1),
		size(12, 36, 10, 16, 1, 2, 22, 18, 1),
		size(22, 22, 20, 20, 1, 1, 30, 20, 1),
		size(16, 36, 14, 16, 1, 2, 32, 24, 1),
		size(24, 24, 22, 22, 1, 1, 36, 24, 1),
		size(26, 26, 24, 24, 1, 1, 44, 28, 1),
		size(16, 48, 14, 22, 1, 2, 49, 28, 1),
		size(32, 32, 14, 14, 2, 2, 62, 36, 1),
		size(36, 36, 16, 16, 2, 2, 86, 42, 1),
		size(40, 40, 18, 18, 2, 2, 114, 48, 1),
		size(44, 44, 20, 20, 2, 2, 144, 56, 1),
		size(48, 48, 22, 22, 2, 2, 174, 68, 1),
		size(52, 52, 24, 24, 2, 2, 204, 84, 2),
		size(64, 64, 14, 14, 4, 4, 280, 112, 2),
		size(72, 72, 16, 16, 4, 4, 368, 144, 4),
		size(80, 80, 18, 18, 4, 4, 456, 192, 4),
		size(88, 88, 20, 20, 4, 4, 576, 224, 4),
		size(96, 96, 22, 22, 4, 4, 696, 272, 4),
		size(104, 104, 24, 24, 4, 4, 816, 336, 6),
		size(120, 120, 18, 18, 6, 6, 1050, 408, 6),
		size(132, 132, 20, 20, 6, 6, 1304, 496, 8),
		size(144, 144, 22, 22, 6, 6, 1558, 620, 10)
	]

	// The size with these whole-symbol dimensions, or none.
	def sizeOf(rows, cols int) ?Size {
		for let s in sizes {
			return s when s.rows == rows && s.cols == cols
		}
		return none
	}

	// Rows and columns of the mapping matrix: the data regions without
	// their finder and timing patterns.
	def mappingRows(s Size) int {
		return s.regionRows * s.regionsDown
	}

	def mappingCols(s Size) int {
		return s.regionCols * s.regionsAcross
	}

	// The module (row, col) of each bit of each codeword in the mapping
	// matrix, by the ECC 200 placement: 8 entries per codeword, most
	// significant bit first, as row * cols + col; -1 for a bit the corner
	// cases leave out. The last entry holds the unused corner fill (the
	// modules to set dark), or is empty.
	def placement(rows, cols int, words int) int[] {
		let out int[]
		out.len(words * 8)
		out.fill(-1)
		let used byte[]
		used.len(rows * cols)
		used.fill(0)
		let put = (pos int, bit int, r0 int, c0 int) => {
			let r = r0
			let c = c0
			if r < 0 {
				r += rows
				c += 4 - ((rows + 4) % 8)
			}
			if c < 0 {
				c += cols
				r += 4 - ((cols + 4) % 8)
			}
			out[pos * 8 + bit] = r * cols + c when pos < words
			used[r * cols + c] = 1
		}
		let utah = (r int, c int, pos int) => {
			put(pos, 0, r - 2, c - 2)
			put(pos, 1, r - 2, c - 1)
			put(pos, 2, r - 1, c - 2)
			put(pos, 3, r - 1, c - 1)
			put(pos, 4, r - 1, c)
			put(pos, 5, r, c - 2)
			put(pos, 6, r, c - 1)
			put(pos, 7, r, c)
		}
		let pos = 0
		let row = 4
		let col = 0
		for {
			if row == rows && col == 0 {
				put(pos, 0, rows - 1, 0)
				put(pos, 1, rows - 1, 1)
				put(pos, 2, rows - 1, 2)
				put(pos, 3, 0, cols - 2)
				put(pos, 4, 0, cols - 1)
				put(pos, 5, 1, cols - 1)
				put(pos, 6, 2, cols - 1)
				put(pos, 7, 3, cols - 1)
				pos++
			}
			if row == rows - 2 && col == 0 && cols % 4 != 0 {
				put(pos, 0, rows - 3, 0)
				put(pos, 1, rows - 2, 0)
				put(pos, 2, rows - 1, 0)
				put(pos, 3, 0, cols - 4)
				put(pos, 4, 0, cols - 3)
				put(pos, 5, 0, cols - 2)
				put(pos, 6, 0, cols - 1)
				put(pos, 7, 1, cols - 1)
				pos++
			}
			if row == rows - 2 && col == 0 && cols % 8 == 4 {
				put(pos, 0, rows - 3, 0)
				put(pos, 1, rows - 2, 0)
				put(pos, 2, rows - 1, 0)
				put(pos, 3, 0, cols - 2)
				put(pos, 4, 0, cols - 1)
				put(pos, 5, 1, cols - 1)
				put(pos, 6, 2, cols - 1)
				put(pos, 7, 3, cols - 1)
				pos++
			}
			if row == rows + 4 && col == 2 && cols % 8 == 0 {
				put(pos, 0, rows - 1, 0)
				put(pos, 1, rows - 1, cols - 1)
				put(pos, 2, 0, cols - 3)
				put(pos, 3, 0, cols - 2)
				put(pos, 4, 0, cols - 1)
				put(pos, 5, 1, cols - 3)
				put(pos, 6, 1, cols - 2)
				put(pos, 7, 1, cols - 1)
				pos++
			}
			for {
				if row < rows && col >= 0 && used[row * cols + col] == 0 {
					utah(row, col, pos)
					pos++
				}
				row -= 2
				col += 2
				break when row < 0 || col >= cols
			}
			row++
			col += 3
			for {
				if row >= 0 && col < cols && used[row * cols + col] == 0 {
					utah(row, col, pos)
					pos++
				}
				row += 2
				col -= 2
				break when row >= rows || col < 0
			}
			row += 3
			col++
			break when row >= rows && col >= cols
		}
		// The bottom-right 2x2 corner a placement leaves empty is filled in
		// a fixed pattern.
		if used[rows * cols - 1] == 0 {
			out.push(rows * cols - 1)
			out.push((rows - 2) * cols + cols - 2)
		}
		return out
	}
}
