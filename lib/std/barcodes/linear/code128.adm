internal partial module std.barcodes.linear.coding {
	use std.barcodes::*

	// Code 128 symbol character widths, values 0 to 105; 106 is the stop
	// character without its final 2-module bar.
	let code128Table = tableOf([
		"212222", "222122", "222221", "121223", "121322", "131222", "122213", "122312", "132212", "221213",
		"221312", "231212", "112232", "122132", "122231", "113222", "123122", "123221", "223211", "221132",
		"221231", "213212", "223112", "312131", "311222", "321122", "321221", "312212", "322112", "322211",
		"212123", "212321", "232121", "111323", "131123", "131321", "112313", "132113", "132311", "211313",
		"231113", "231311", "112133", "112331", "132131", "113123", "113321", "133121", "313121", "211331",
		"231131", "213113", "213311", "213131", "311123", "311321", "331121", "312113", "312311", "332111",
		"314111", "221411", "431111", "111224", "111422", "121124", "121421", "141122", "141221", "112214",
		"112412", "122114", "122411", "142112", "142211", "241211", "221114", "413111", "241112", "134111",
		"111242", "121142", "121241", "114212", "124112", "124211", "411212", "421112", "421211", "212141",
		"214121", "412121", "111143", "111341", "131141", "114113", "114311", "411113", "411311", "113141",
		"114131", "311141", "411131", "211412", "211214", "211232", "233111"
	])

	// The input symbol for FNC1 in a Code 128 message.
	const fnc1 = 256

	// Code set indexes.
	const setA = 0
	const setB = 1
	const setC = 2

	// The value of character ch in code set A or B, or -1.
	def code128Value(ch int, set int) int {
		let low = ch & 0x7f
		if set == setA {
			return low < 32 ?? (low + 64, low - 32) when low < 96
			return -1
		}
		return low - 32 when low >= 32
		return -1
	}

	// Whether symbols[pos] and symbols[pos + 1] are both digits.
	def digitPair(symbols int[], pos int) bool {
		return pos + 1 < symbols.len() && symbols[pos] >= 48 && symbols[pos] <= 57 && symbols[pos + 1] >= 48 && symbols[pos + 1] <= 57
	}

	// The fewest codewords that encode symbols, found by dynamic programming
	// over (position, code set) with code set switches, shifts and FNC4.
	def code128Values(symbols int[]) !int[] {
		let n = symbols.len()
		let big = 1 << 30
		let cost int[]
		cost.len(3 * (n + 1))
		cost.fill(big)
		// How each state was reached: previous position, previous set, action.
		let fromPos int[]
		let fromSet int[]
		let action int[]
		fromPos.len(3 * (n + 1))
		fromSet.len(3 * (n + 1))
		action.len(3 * (n + 1))
		for let s = 0; s < 3; s++ {
			cost[s] = 1
			fromPos[s] = -1
		}
		for let pos = 0; pos <= n; pos++ {
			// Switching sets at this position, twice to reach every set.
			for let round = 0; round < 2; round++ {
				for let s = 0; s < 3; s++ {
					for let t = 0; t < 3; t++ {
						continue when s == t || cost[3 * pos + t] + 1 >= cost[3 * pos + s]
						cost[3 * pos + s] = cost[3 * pos + t] + 1
						fromPos[3 * pos + s] = pos
						fromSet[3 * pos + s] = t
						action[3 * pos + s] = 0
					}
				}
			}
			break when pos == n
			let ch = symbols[pos]
			for let s = 0; s < 3; s++ {
				let here = cost[3 * pos + s]
				continue when here >= big
				// (next position, codewords, action)
				let steps (int, int, int)[]
				if ch == fnc1 {
					steps += (pos + 1, 1, 1)
				} else if s == setC {
					steps += (pos + 2, 1, 3) when digitPair(symbols, pos)
				} else {
					let extra = ch >= 128 ?? (1, 0)
					steps += (pos + 1, 1 + extra, 1) when code128Value(ch, s) >= 0
					steps += (pos + 1, 2, 2) when ch < 128 && code128Value(ch, 1 - s) >= 0
				}
				for let st in steps {
					let (next, words, act) = st
					let k = 3 * next + s
					continue when here + words >= cost[k]
					cost[k] = here + words
					fromPos[k] = pos
					fromSet[k] = s
					action[k] = act
				}
			}
		}
		let best = 0
		for let s = 1; s < 3; s++ {
			best = s when cost[3 * n + s] < cost[3 * n + best]
		}
		fail "text cannot be encoded in Code 128" when cost[3 * n + best] >= big

		// Walk back to the start, then emit forwards.
		let states int[]
		let pos = n
		let set = best
		for fromPos[3 * pos + set] >= 0 {
			states += 3 * pos + set
			let k = 3 * pos + set
			pos = fromPos[k]
			set = fromSet[k]
		}
		let values = int[103 + set]
		for let at = states.len() - 1; at >= 0; at-- {
			let k = states[at]
			let s = k % 3
			let p = fromPos[k]
			let act = action[k]
			if act == 0 {
				values += s == setA ?? (101, s == setB ?? (100, 99))
				continue
			}
			let ch = symbols[p]
			if ch == fnc1 {
				values += 102
				continue
			}
			if act == 3 {
				values += (ch - 48) * 10 + (symbols[p + 1] - 48)
				continue
			}
			let target = act == 2 ?? (1 - s, s)
			values += 98 when act == 2
			values += target == setA ?? (101, 100) when ch >= 128
			values += code128Value(ch, target)
		}
		let sum = values[0]
		for let k = 1; k < values.len(); k++ {
			sum += k * values[k]
		}
		values += sum % 103
		return values
	}

	// Code 128 from text; a 0x1d (GS) character stands for FNC1, so a leading
	// one makes GS1-128. Characters above 0x7f use FNC4 and must be Latin-1.
	def encodeCode128(text string) !Symbol {
		let symbols int[]
		for let ch in text {
			let c = int(ch)
			fail "Code 128 holds Latin-1 text only" when c > 255
			symbols += c == 0x1d ?? (fnc1, c)
		}
		fail "Code 128 needs at least one character" when symbols.len() == 0
		let values = try code128Values(symbols)
		let widths int[]
		for let v in values {
			widths += code128Table[v]
		}
		widths += int[2, 3, 3, 1, 1, 1, 2]
		return new Symbol(Symbology.Code128, widths, text, 10)
	}

	// Decodes a Code 128 symbol whose start character's first bar is runs[i].
	def decodeCode128(runs int[], i int) ?Hit {
		let start = bestMatch(runs, i, code128Table, 0.25)
		return none when start < 103 || start > 105
		let unit = float(span(runs, i, 6)) / 11.0
		return none when !quiet(runs, i - 1, unit, 5.0)
		let values = int[start]
		let j = i + 6
		for {
			return none when j + 7 > runs.len()
			let v = bestMatch(runs, j, code128Table, 0.25)
			return none when v < 0 || v > 106 || (v >= 103 && v <= 105)
			if v == 106 {
				return none when variance(runs, j, int[2, 3, 3, 1, 1, 1, 2]) < 0.0
				j += 7
				break
			}
			values += v
			j += 6
		}
		return none when values.len() < 3 || !quiet(runs, j, unit, 5.0)
		let cd = values[values.len() - 1]
		let sum = values[0]
		for let k = 1; k < values.len() - 1; k++ {
			sum += k * values[k]
		}
		return none when sum % 103 != cd
		let text = code128Text(values.slice(0, values.len() - 1))
		return none when text is none
		return Hit{symbology: Symbology.Code128, text: text, end: j}
	}

	// The text of Code 128 values from the start character on, or none when
	// they break the code set rules.
	def code128Text(values int[]) ?string {
		let set = values[0] - 103
		let out = ""
		let shift = false
		let fnc4Once = false
		let fnc4Latch = false
		for let k = 1; k < values.len(); k++ {
			let v = values[k]
			let s = shift ?? (1 - set, set)
			shift = false
			if v == 102 {
				out += string(char(0x1d))
				continue
			}
			if s == setC {
				if v < 100 {
					out += (v < 10 ?? ("0", "")) + v.str()
					continue
				}
				switch {
					case v == 100: set = setB
					case v == 101: set = setA
					default:
						return none
				}
				continue
			}
			if v < 96 {
				let c = s == setA ?? (v < 64 ?? (v + 32, v - 64), v + 32)
				let high = fnc4Latch != fnc4Once
				fnc4Once = false
				c += 128 when high
				out += string(char(c))
				continue
			}
			let fnc4 = s == setA ?? (101, 100)
			let other = s == setA ?? (100, 101)
			switch {
				case v == 96 || v == 97:
					continue
				case v == 98:
					shift = true
				case v == 99:
					set = setC
				case v == fnc4:
					if k + 1 < values.len() && values[k + 1] == fnc4 {
						fnc4Latch = !fnc4Latch
						k++
					} else {
						fnc4Once = true
					}
				case v == other:
					set = s == setA ?? (setB, setA)
				default:
					return none
			}
		}
		return out
	}
}
