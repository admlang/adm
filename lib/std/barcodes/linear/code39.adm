internal partial module std.barcodes.linear.coding {
	use std.barcodes::*

	// Code 39 characters in value order; `*` is the start and stop character.
	const code39Chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%*"
	// Wide elements of each Code 39 character, 9 bits, first element first.
	let code39Bits = int[
		0x034, 0x121, 0x061, 0x160, 0x031, 0x130, 0x070, 0x025, 0x124, 0x064,
		0x109, 0x049, 0x148, 0x019, 0x118, 0x058, 0x00D, 0x10C, 0x04C, 0x01C,
		0x103, 0x043, 0x142, 0x013, 0x112, 0x052, 0x007, 0x106, 0x046, 0x016,
		0x181, 0x0C1, 0x1C0, 0x091, 0x190, 0x0D0, 0x085, 0x184, 0x0C4, 0x0A8,
		0x0A2, 0x08A, 0x02A, 0x094
	]
	// Code 93 characters in value order; a b c d are the shift characters
	// ($) (%) (/) (+) of full ASCII, `*` is start and stop.
	const code93Chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%abcd*"
	// Each Code 93 character as 9 modules, first module in the high bit.
	let code93Modules = int[
		0x114, 0x148, 0x144, 0x142, 0x128, 0x124, 0x122, 0x150, 0x112, 0x10A,
		0x1A8, 0x1A4, 0x1A2, 0x194, 0x192, 0x18A, 0x168, 0x164, 0x162, 0x134,
		0x11A, 0x158, 0x14C, 0x146, 0x12C, 0x116, 0x1B4, 0x1B2, 0x1AC, 0x1A6,
		0x196, 0x19A, 0x16C, 0x166, 0x136, 0x13A, 0x12E, 0x1D4, 0x1D2, 0x1CA,
		0x16E, 0x176, 0x1AE, 0x126, 0x1DA, 0x1D6, 0x132, 0x15E
	]
	let code93Table = code93Widths()

	// The bar and space widths of every Code 93 character.
	def code93Widths() int[][] {
		let out int[][]
		for let m in code93Modules {
			let widths int[]
			let run = 1
			for let k = 7; k >= 0; k-- {
				if ((m >> k) & 1) == ((m >> (k + 1)) & 1) {
					run++
				} else {
					widths += run
					run = 1
				}
			}
			widths += run
			out += widths
		}
		return out
	}

	// The Code 39 full ASCII spelling of character c (0 to 127).
	def fullAsciiOf(c int) string {
		let letter = (k int) => string(char(65 + k))
		switch {
			case c == 0:
				return "%U"
			case c <= 26:
				return "$" + letter(c - 1)
			case c <= 31:
				return "%" + letter(c - 27)
			case c == 32 || c == 45 || c == 46 || (c >= 48 && c <= 57) || (c >= 65 && c <= 90):
				return string(char(c))
			case c <= 44:
				return "/" + letter(c - 33)
			case c == 47:
				return "/O"
			case c == 58:
				return "/Z"
			case c <= 63:
				return "%" + letter(c - 59 + 5)
			case c == 64:
				return "%V"
			case c <= 95:
				return "%" + letter(c - 91 + 10)
			case c == 96:
				return "%W"
			case c <= 122:
				return "+" + letter(c - 97)
		}
		return "%" + letter(c - 123 + 15)
	}

	// Undoes the full ASCII pairs in text, or none when a pair is invalid.
	// shifts names the four shift characters in the order $ % / +.
	def fromFullAscii(text string, shifts string) ?string {
		let out = ""
		let chars = text.bytes()
		for let k = 0; k < chars.len(); k++ {
			let s = shifts.indexOf(string(char(int(chars[k]))))
			if s < 0 {
				out += string(char(int(chars[k])))
				continue
			}
			return none when k + 1 >= chars.len()
			k++
			let l = int(chars[k])
			let c = -1
			switch {
				case s == 0 && l >= 65 && l <= 90: c = l - 64
				case s == 1 && l >= 65 && l <= 69: c = l - 65 + 27
				case s == 1 && l >= 70 && l <= 74: c = l - 70 + 59
				case s == 1 && l >= 75 && l <= 79: c = l - 75 + 91
				case s == 1 && l >= 80 && l <= 84: c = l - 80 + 123
				case s == 1 && l == 85: c = 0
				case s == 1 && l == 86: c = 64
				case s == 1 && l == 87: c = 96
				case s == 1 && l >= 88 && l <= 90: c = 127
				case s == 2 && l >= 65 && l <= 76: c = l - 65 + 33
				case s == 2 && l == 79: c = 47
				case s == 2 && l == 90: c = 58
				case s == 3 && l >= 65 && l <= 90: c = l + 32
			}
			return none when c < 0
			out += string(char(c))
		}
		return out
	}

	// Code 39: the 43 characters, or any ASCII with fullAscii. checkDigit
	// appends the mod 43 check character.
	def encodeCode39(text string, checkDigit bool, fullAscii bool) !Symbol {
		let body = ""
		for let ch in text {
			let c = int(ch)
			if fullAscii {
				fail "Code 39 full ASCII holds ASCII only" when c > 127
				body += fullAsciiOf(c)
			} else {
				fail "Code 39 has no character " + string(ch) + "; use full ASCII" when c > 127 || c == 42 || code39Chars.indexOf(string(ch)) < 0
				body += string(ch)
			}
		}
		fail "Code 39 needs at least one character" when body.len() == 0
		if checkDigit {
			let sum = 0
			for let ch in body {
				sum += code39Chars.indexOf(string(ch))
			}
			body += code39Chars.slice(sum % 43, sum % 43 + 1)
		}
		let widths int[]
		let framed = "*" + body + "*"
		for let ch in framed {
			widths += 1 when widths.len() > 0
			widths += wideNarrow(code39Bits[code39Chars.indexOf(string(ch))], 9, 3)
		}
		return new Symbol(Symbology.Code39, widths, body, 10)
	}

	// The Code 39 character at runs[j], or -1.
	def code39At(runs int[], j int) int {
		let bits = classify(runs, j, 9, 3, 3)
		return -1 when bits < 0
		return code39Bits.indexOf(bits)
	}

	// Decodes a Code 39 symbol whose start character's first bar is runs[i].
	def decodeCode39(runs int[], i int, fullAscii bool) ?Hit {
		return none when code39At(runs, i) != 43
		let charWidth = float(span(runs, i, 9))
		return none when !quiet(runs, i - 1, charWidth / 15.0, 5.0)
		let text = ""
		let j = i + 10
		for {
			return none when j + 9 > runs.len()
			let v = code39At(runs, j)
			return none when v < 0
			let w = float(span(runs, j, 9))
			return none when w < charWidth * 0.75 || w > charWidth * 1.33
			return none when float(runs[j - 1]) > charWidth * 0.5
			if v == 43 {
				j += 9
				break
			}
			text += code39Chars.slice(v, v + 1)
			j += 10
		}
		return none when text.len() == 0 || !quiet(runs, j, charWidth / 15.0, 5.0)
		if fullAscii {
			let plain = fromFullAscii(text, "$%/+")
			return none when plain is none
			return Hit{symbology: Symbology.Code39, text: plain, end: j}
		}
		return Hit{symbology: Symbology.Code39, text: text, end: j}
	}

	// Code 93 of any ASCII text, with its two check characters.
	def encodeCode93(text string) !Symbol {
		let values int[]
		for let ch in text {
			let c = int(ch)
			fail "Code 93 holds ASCII only" when c > 127
			let direct = code93Chars.indexOf(string(ch))
			if direct >= 0 && direct < 43 {
				values += direct
				continue
			}
			let pair = fullAsciiOf(c)
			values += "$%/+".indexOf(pair.slice(0, 1)) + 43
			values += code93Chars.indexOf(pair.slice(1, 2))
		}
		fail "Code 93 needs at least one character" when values.len() == 0
		values += code93Check(values, 20)
		values += code93Check(values, 15)
		let widths int[]
		widths += code93Table[47]
		for let v in values {
			widths += code93Table[v]
		}
		widths += code93Table[47]
		widths += 1
		return new Symbol(Symbology.Code93, widths, text, 10)
	}

	// A Code 93 check character: weights 1 to maxWeight from the right, mod 47.
	def code93Check(values int[], maxWeight int) int {
		let sum = 0
		for let k = 0; k < values.len(); k++ {
			let weight = (values.len() - 1 - k) % maxWeight + 1
			sum += weight * values[k]
		}
		return sum % 47
	}

	// Decodes a Code 93 symbol whose start character's first bar is runs[i].
	def decodeCode93(runs int[], i int) ?Hit {
		return none when bestMatch(runs, i, code93Table, 0.25) != 47
		let unit = float(span(runs, i, 6)) / 9.0
		return none when !quiet(runs, i - 1, unit, 5.0)
		let values int[]
		let j = i + 6
		for {
			return none when j + 7 > runs.len()
			let v = bestMatch(runs, j, code93Table, 0.25)
			return none when v < 0
			if v == 47 {
				return none when float(runs[j + 6]) > unit * 2.0
				j += 7
				break
			}
			values += v
			j += 6
		}
		return none when values.len() < 3 || !quiet(runs, j, unit, 5.0)
		let data = values.slice(0, values.len() - 2)
		return none when code93Check(data, 20) != values[values.len() - 2]
		return none when code93Check(values.slice(0, values.len() - 1), 15) != values[values.len() - 1]
		let raw = ""
		for let v in data {
			raw += code93Chars.slice(v, v + 1)
		}
		let text = fromFullAscii(raw, "abcd")
		return none when text is none
		return Hit{symbology: Symbology.Code93, text: text, end: j}
	}
}
