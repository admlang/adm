internal partial module std.barcodes.linear.coding {
	use std.barcodes::*

	// A decoded run of a linear symbol: its text and the index of the light
	// run after its last bar.
	struct Hit {
		symbology Symbology
		text      string
		end       int
	}

	// EAN/UPC digit widths of the L set (space first); the R set has the same
	// widths bar first, the G set is L reversed.
	let eanL = tableOf(["3211", "2221", "2122", "1411", "1132", "1231", "1114", "1312", "1213", "3112"])
	let eanG = tableOf(["1123", "1222", "2212", "1141", "2311", "1321", "4111", "2131", "3121", "2113"])
	let eanLG = tableOf(["3211", "2221", "2122", "1411", "1132", "1231", "1114", "1312", "1213", "3112", "1123", "1222", "2212", "1141", "2311", "1321", "4111", "2131", "3121", "2113"])
	// EAN-13 parity of the six left digits for each leading digit.
	let eanFirst = ["LLLLLL", "LLGLGG", "LLGGLG", "LLGGGL", "LGLLGG", "LGGLLG", "LGGGLL", "LGLGLG", "LGLGGL", "LGGLGL"]
	// UPC-E parity for number system 0 by check digit; number system 1 swaps L and G.
	let upcEParity = ["GGGLLL", "GGLGLL", "GGLLGL", "GGLLLG", "GLGGLL", "GLLGGL", "GLLLGG", "GLGLGL", "GLGLLG", "GLLGLG"]
	let ean2Parity = ["LL", "LG", "GL", "GG"]
	let ean5Parity = ["GGLLL", "GLGLL", "GLLGL", "GLLLG", "LGGLL", "LLGGL", "LLLGG", "LGLGL", "LGLLG", "LLGLG"]

	// The widths of digit d in set L, G or R.
	def eanDigit(d int, set string) int[] {
		return set == "G" ?? (eanG[d], eanL[d])
	}

	// The check digit completed text, or a failure when text has a wrong one.
	def withCheck(text string, digits int, name string) !string {
		fail name + " takes " + (digits - 1).str() + " or " + digits.str() + " digits" when !allDigits(text) || (text.len() != digits - 1 && text.len() != digits)
		let body = text.slice(0, digits - 1)
		let cd = (gs1Check(body)).str()
		fail name + " check digit should be " + cd when text.len() == digits && text.slice(digits - 1, digits) != cd
		return body + cd
	}

	// EAN-13 (and UPC-A with a leading 0), with an optional add-on after a space.
	def encodeEan13(text string, symbology Symbology) !Symbol {
		let parts = text.split(" ")
		fail "one add-on at most, after a space" when parts.len() > 2
		let digits = parts[0]
		if symbology == Symbology.UpcA {
			digits = "0" + try withCheck(digits, 12, "UPC-A")
		} else {
			digits = try withCheck(digits, 13, "EAN-13")
		}
		let d = digits.bytes().mapElem(b => int(b) - 48)
		let widths = int[1, 1, 1]
		let parity = eanFirst[d[0]]
		for let k = 1; k <= 6; k++ {
			widths += eanDigit(d[k], parity.slice(k - 1, k))
		}
		widths += int[1, 1, 1, 1, 1]
		for let k = 7; k <= 12; k++ {
			widths += eanDigit(d[k], "R")
		}
		widths += int[1, 1, 1]
		let shown = symbology == Symbology.UpcA ?? (digits.slice(1, 13), digits)
		if parts.len() == 2 {
			widths += try addOn(parts[1])
			shown += " " + parts[1]
		}
		return new Symbol(symbology, widths, shown, 11)
	}

	// EAN-8.
	def encodeEan8(text string) !Symbol {
		expects {
			assert !(text.contains(" ")) onerror fail "EAN-8 takes no add-on"
		}
		let digits = try withCheck(text, 8, "EAN-8")
		let d = digits.bytes().mapElem(b => int(b) - 48)
		let widths = int[1, 1, 1]
		for let k = 0; k < 4; k++ {
			widths += eanDigit(d[k], "L")
		}
		widths += int[1, 1, 1, 1, 1]
		for let k = 4; k < 8; k++ {
			widths += eanDigit(d[k], "R")
		}
		widths += int[1, 1, 1]
		return new Symbol(Symbology.Ean8, widths, digits, 7)
	}

	// The UPC-A digits (number system, 10 digits) a UPC-E body expands to.
	def upcEExpand(ns string, six string) string {
		let d = six
		let last = int(d.bytes()[5]) - 48
		switch {
			case last <= 2:
				return ns + d.slice(0, 2) + d.slice(5, 6) + "0000" + d.slice(2, 5)
			case last == 3:
				return ns + d.slice(0, 3) + "00000" + d.slice(3, 5)
			case last == 4:
				return ns + d.slice(0, 4) + "00000" + d.slice(4, 5)
		}
		return ns + d.slice(0, 5) + "0000" + d.slice(5, 6)
	}

	// UPC-E from 6 digits (number system 0), 7 (number system and 6) or 8
	// (with the check digit), with an optional add-on after a space.
	def encodeUpcE(text string) !Symbol {
		let parts = text.split(" ")
		fail "one add-on at most, after a space" when parts.len() > 2
		let t = parts[0]
		fail "UPC-E takes 6, 7 or 8 digits" when !allDigits(t) || t.len() < 6 || t.len() > 8
		t = "0" + t when t.len() == 6
		let ns = t.slice(0, 1)
		fail "UPC-E number system must be 0 or 1" when ns != "0" && ns != "1"
		let cd = gs1Check(upcEExpand(ns, t.slice(1, 7)))
		fail "UPC-E check digit should be " + cd.str() when t.len() == 8 && t.slice(7, 8) != cd.str()
		let parity = upcEParity[cd]
		let widths = int[1, 1, 1]
		for let k = 0; k < 6; k++ {
			let set = parity.slice(k, k + 1)
			set = set == "G" ?? ("L", "G") when ns == "1"
			widths += eanDigit(int(t.bytes()[k + 1]) - 48, set)
		}
		widths += int[1, 1, 1, 1, 1, 1]
		let shown = t.slice(0, 7) + cd.str()
		if parts.len() == 2 {
			widths += try addOn(parts[1])
			shown += " " + parts[1]
		}
		return new Symbol(Symbology.UpcE, widths, shown, 9)
	}

	// The widths of a 2- or 5-digit add-on, 9 modules after the main symbol.
	def addOn(digits string) !int[] {
		expects {
			assert allDigits(digits) && (digits.len() == 2 || digits.len() == 5) onerror fail "an add-on has 2 or 5 digits"
		}
		let d = digits.bytes().mapElem(b => int(b) - 48)
		let parity = ""
		if d.len() == 2 {
			parity = ean2Parity[(d[0] * 10 + d[1]) % 4]
		} else {
			parity = ean5Parity[(3 * (d[0] + d[2] + d[4]) + 9 * (d[1] + d[3])) % 10]
		}
		let widths = int[9, 1, 1, 2]
		for let k = 0; k < d.len(); k++ {
			widths += int[1, 1] when k > 0
			widths += eanDigit(d[k], parity.slice(k, k + 1))
		}
		return widths
	}

	// Decodes an EAN-13, UPC-A, EAN-8 or UPC-E whose start guard's first bar
	// is runs[i], with any add-on after it.
	def decodeEan(runs int[], i int) ?Hit {
		let unit = float(span(runs, i, 3)) / 3.0
		return none when variance(runs, i, int[1, 1, 1]) < 0.0 || !quiet(runs, i - 1, unit, 5.0)
		let found = decodeEan13(runs, i)
		found = decodeEan8(runs, i) when found is none
		found = decodeUpcE(runs, i) when found is none
		return none when found is none
		let hit = found
		let extra = decodeAddOn(runs, hit.end, unit)
		return hit when extra is none
		let add = extra
		return Hit{symbology: hit.symbology, text: hit.text + " " + add.text, end: add.end}
	}

	// Reads count left-half digits from runs[at], each in the L or G set.
	// Returns the digits and the parity string, or none.
	def eanLeft(runs int[], at int, count int) ?(string, string) {
		let digits = ""
		let parity = ""
		for let k = 0; k < count; k++ {
			let m = bestMatch(runs, at + 4 * k, eanLG, 0.3)
			return none when m < 0
			digits += (m % 10).str()
			parity += m < 10 ?? ("L", "G")
		}
		return (digits, parity)
	}

	// Reads count right-half digits (R set) from runs[at].
	def eanRight(runs int[], at int, count int) ?string {
		let digits = ""
		for let k = 0; k < count; k++ {
			let m = bestMatch(runs, at + 4 * k, eanL, 0.3)
			return none when m < 0
			digits += m.str()
		}
		return digits
	}

	def decodeEan13(runs int[], i int) ?Hit {
		return none when i + 60 > runs.len()
		return none when variance(runs, i + 27, int[1, 1, 1, 1, 1]) < 0.0 || variance(runs, i + 56, int[1, 1, 1]) < 0.0
		let left = eanLeft(runs, i + 3, 6)
		return none when left is none
		let (ld, lp) = left
		let right = eanRight(runs, i + 32, 6)
		return none when right is none
		let first = eanFirst.indexOf(lp)
		return none when first < 0
		let unit = float(span(runs, i, 59)) / 95.0
		return none when !quiet(runs, i + 59, unit, 5.0)
		let digits = first.str() + ld + right
		return none when gs1Check(digits.slice(0, 12)) != int(digits.bytes()[12]) - 48
		return Hit{symbology: Symbology.UpcA, text: digits.slice(1, 13), end: i + 59} when first == 0
		return Hit{symbology: Symbology.Ean13, text: digits, end: i + 59}
	}

	def decodeEan8(runs int[], i int) ?Hit {
		return none when i + 44 > runs.len()
		return none when variance(runs, i + 19, int[1, 1, 1, 1, 1]) < 0.0 || variance(runs, i + 40, int[1, 1, 1]) < 0.0
		let left = eanLeft(runs, i + 3, 4)
		return none when left is none
		let (ld, lp) = left
		return none when lp != "LLLL"
		let right = eanRight(runs, i + 24, 4)
		return none when right is none
		let unit = float(span(runs, i, 43)) / 67.0
		return none when !quiet(runs, i + 43, unit, 5.0)
		let digits = ld + right
		return none when gs1Check(digits.slice(0, 7)) != int(digits.bytes()[7]) - 48
		return Hit{symbology: Symbology.Ean8, text: digits, end: i + 43}
	}

	def decodeUpcE(runs int[], i int) ?Hit {
		return none when i + 34 > runs.len()
		return none when variance(runs, i + 27, int[1, 1, 1, 1, 1, 1]) < 0.0
		let left = eanLeft(runs, i + 3, 6)
		return none when left is none
		let (ld, lp) = left
		let unit = float(span(runs, i, 33)) / 51.0
		return none when !quiet(runs, i + 33, unit, 5.0)
		for let ns = 0; ns <= 1; ns++ {
			for let cd = 0; cd < 10; cd++ {
				let p = upcEParity[cd]
				p = p.replace("G", "x").replace("L", "G").replace("x", "L") when ns == 1
				continue when p != lp
				continue when gs1Check(upcEExpand(ns.str(), ld)) != cd
				return Hit{symbology: Symbology.UpcE, text: ns.str() + ld + cd.str(), end: i + 33}
			}
		}
		return none
	}

	// A 2- or 5-digit add-on starting in the light run at index gap.
	def decodeAddOn(runs int[], gap int, unit float) ?Hit {
		return none when gap + 14 > runs.len()
		let g = float(runs[gap]) / unit
		return none when g < 5.0 || g > 16.0
		let at = gap + 1
		return none when variance(runs, at, int[1, 1, 2]) < 0.0
		for let count in int[5, 2] {
			let n = 3 + 4 * count + 2 * (count - 1)
			continue when at + n + 1 > runs.len()
			let digits = ""
			let parity = ""
			let ok = true
			for let k = 0; k < count && ok; k++ {
				let pos = at + 3 + 6 * k
				if k > 0 && variance(runs, pos - 2, int[1, 1]) < 0.0 {
					ok = false
					break
				}
				let m = bestMatch(runs, pos, eanLG, 0.3)
				if m < 0 {
					ok = false
					break
				}
				digits += (m % 10).str()
				parity += m < 10 ?? ("L", "G")
			}
			continue when !ok
			let d = digits.bytes().mapElem(b => int(b) - 48)
			let want = ""
			if count == 2 {
				want = ean2Parity[(d[0] * 10 + d[1]) % 4]
			} else {
				want = ean5Parity[(3 * (d[0] + d[2] + d[4]) + 9 * (d[1] + d[3])) % 10]
			}
			continue when want != parity
			continue when !quiet(runs, at + n, unit, 3.0)
			return Hit{symbology: Symbology.Ean13, text: digits, end: at + n}
		}
		return none
	}
}
