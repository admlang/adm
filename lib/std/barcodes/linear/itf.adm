internal partial module std.barcodes.linear.coding {
	use std.barcodes::*

	// Wide elements of each Interleaved 2 of 5 digit, 5 bits, first first.
	let itfBits = int[0x06, 0x11, 0x09, 0x18, 0x05, 0x14, 0x0C, 0x03, 0x12, 0x0A]

	// Codabar characters in table order; A B C D are start and stop.
	const codabarChars = "0123456789-$:/.+ABCD"
	// Wide elements of each Codabar character, 7 bits, first first.
	let codabarBits = int[
		0x003, 0x006, 0x009, 0x060, 0x012, 0x042, 0x021, 0x024, 0x030, 0x048,
		0x00c, 0x018, 0x045, 0x051, 0x054, 0x015, 0x01A, 0x029, 0x00B, 0x00E
	]

	// Interleaved 2 of 5 of an even number of digits; checkDigit appends the
	// GS1 mod 10 check digit first, so the digits before it must be odd.
	def encodeItf(text string, checkDigit bool) !Symbol {
		expects {
			assert allDigits(text) onerror fail "ITF holds digits only"
		}
		let digits = checkDigit ?? (text + (gs1Check(text)).str(), text)
		fail "ITF needs an even number of digits" when digits.len() % 2 != 0
		let d = digits.bytes().mapElem(b => int(b) - 48)
		let widths = int[1, 1, 1, 1]
		for let k = 0; k < d.len(); k += 2 {
			let bars = wideNarrow(itfBits[d[k]], 5, 3)
			let spaces = wideNarrow(itfBits[d[k + 1]], 5, 3)
			for let e = 0; e < 5; e++ {
				widths += bars[e]
				widths += spaces[e]
			}
		}
		widths += int[3, 1, 1]
		return new Symbol(Symbology.Itf, widths, digits, 10)
	}

	// Decodes an ITF symbol whose start pattern's first bar is runs[i]; at
	// least 6 digits.
	def decodeItf(runs int[], i int) ?Hit {
		return none when variance(runs, i, int[1, 1, 1, 1], 0.5) < 0.0
		let narrow = float(span(runs, i, 4)) / 4.0
		return none when !quiet(runs, i - 1, narrow, 8.0)
		let digits = ""
		let j = i + 4
		for {
			return none when j + 3 > runs.len()
			let stop = classify(runs, j, 3, 1, 1)
			if stop == 4 && float(runs[j]) > narrow * 1.5 && quiet(runs, j + 3, narrow, 8.0) {
				j += 3
				break
			}
			return none when j + 10 > runs.len()
			let bars int[]
			let spaces int[]
			for let e = 0; e < 5; e++ {
				bars += runs[j + 2 * e]
				spaces += runs[j + 2 * e + 1]
			}
			let b = itfBits.indexOf(classify(bars, 0, 5, 2, 2))
			let s = itfBits.indexOf(classify(spaces, 0, 5, 2, 2))
			return none when b < 0 || s < 0
			digits += b.str() + s.str()
			j += 10
		}
		return none when digits.len() < 6
		return Hit{symbology: Symbology.Itf, text: digits, end: j}
	}

	// Codabar: text between start and stop characters A to D; A is added at
	// both ends when text does not start and end with one.
	def encodeCodabar(text string) !Symbol {
		let body = text.upper()
		let first = body.len() > 0 ?? (body.slice(0, 1), "")
		let last = body.len() > 0 ?? (body.slice(body.len() - 1, body.len()), "")
		let guards = "ABCD"
		body = "A" + body + "A" when body.len() < 2 || guards.indexOf(first) < 0 || guards.indexOf(last) < 0
		let widths int[]
		for let (k, ch) in body {
			let v = codabarChars.indexOf(string(ch))
			let inner = k > 0 && k < body.len() - 1
			fail "Codabar has no character " + string(ch) when v < 0 || (inner && v >= 16)
			widths += 1 when k > 0
			widths += wideNarrow(codabarBits[v], 7, 3)
		}
		return new Symbol(Symbology.Codabar, widths, body, 10)
	}

	// The Codabar character at runs[j], or -1.
	def codabarAt(runs int[], j int) int {
		let bits = classify(runs, j, 7, 2, 3)
		return -1 when bits < 0
		return codabarBits.indexOf(bits)
	}

	// Decodes a Codabar symbol whose start character's first bar is runs[i].
	def decodeCodabar(runs int[], i int) ?Hit {
		let start = codabarAt(runs, i)
		return none when start < 16
		let charWidth = float(span(runs, i, 7))
		return none when !quiet(runs, i - 1, charWidth / 12.0, 5.0)
		let text = codabarChars.slice(start, start + 1)
		let j = i + 8
		for {
			return none when j + 7 > runs.len()
			let v = codabarAt(runs, j)
			return none when v < 0
			return none when float(runs[j - 1]) > charWidth * 0.5
			text += codabarChars.slice(v, v + 1)
			if v >= 16 {
				j += 7
				break
			}
			j += 8
		}
		return none when text.len() < 3 || !quiet(runs, j, charWidth / 12.0, 5.0)
		return Hit{symbology: Symbology.Codabar, text: text, end: j}
	}
}
