partial module std.barcodes.linear {
	// Linear (1D) barcodes: EAN-13, EAN-8, UPC-A, UPC-E (with 2/5-digit
	// add-ons), Code 128 (GS1-128), Code 39, Code 93, Interleaved 2 of 5 and
	// Codabar. Encode to bar and space widths with check digits, and decode a
	// scanline of widths.
	use (
		std.barcodes::*
		std.barcodes.linear.coding::*
		std.barcodes.scan::(Gray)
		std.formats.image::(Image)
		std.math.geom::(Point)
	)

	// Encodes text as a linear symbol.
	//
	//     Ean13, UpcA, Ean8, UpcE  digits, with or without the check digit (a
	//                              wrong one fails); EAN-13, UPC-A and UPC-E
	//                              take a 2- or 5-digit add-on after a space
	//     Code128                  Latin-1 text; 0x1d (GS) is FNC1, so a
	//                              leading one makes GS1-128
	//     Code39                   0-9 A-Z - . space $ / + %, or any ASCII with
	//                              fullAscii
	//     Code93                   any ASCII
	//     Itf                      an even number of digits
	//     Codabar                  0-9 - $ : / . +, between start and stop
	//                              characters A to D (A added when missing)
	//
	// checkDigit appends the optional check character of Code 39 (mod 43) and
	// ITF (mod 10). Fails when the symbology is not linear or the text does
	// not fit it.
	//
	// ```
	// let sym = linear.encode("5901234123457", Symbology.Ean13)!
	// ```
	def encode(text string, symbology Symbology, checkDigit bool = false, fullAscii bool = false) !Symbol {
		switch {
			case symbology == Symbology.Ean13 || symbology == Symbology.UpcA:
				return encodeEan13(text, symbology)
			case symbology == Symbology.Ean8:
				return encodeEan8(text)
			case symbology == Symbology.UpcE:
				return encodeUpcE(text)
			case symbology == Symbology.Code128:
				return encodeCode128(text)
			case symbology == Symbology.Code39:
				return encodeCode39(text, checkDigit, fullAscii)
			case symbology == Symbology.Code93:
				return encodeCode93(text)
			case symbology == Symbology.Itf:
				return encodeItf(text, checkDigit)
			case symbology == Symbology.Codabar:
				return encodeCodabar(text)
		}
		fail "not a linear symbology"
	}

	// Decodes a scanline given as alternating light and dark run lengths,
	// starting with the light margin, in either reading direction. The first
	// symbol found wins; an EAN-13 with a leading 0 reads as UPC-A. With
	// fullAscii, Code 39 text has its full ASCII pairs undone. Fails when no
	// symbol decodes.
	def decode(runs int[], fullAscii bool = false) !Barcode {
		let found = scanRuns(runs, fullAscii)
		fail "no linear barcode found" when found is none
		let (hit, _, _) = found
		return Barcode{symbology: hit.symbology, text: hit.text, data: hit.text.bytes()}
	}

	// Decodes a linear symbol from its widths, as encode made them. Fails
	// when the widths do not decode.
	def decode(sym Symbol, fullAscii bool = false) !Barcode {
		expects {
			assert sym.linear() onerror fail "not a linear symbol"
		}
		let runs = int[20]
		runs += sym.widths
		runs += 20
		return decode(runs, fullAscii)
	}

	// Finds and decodes the linear symbols in an image, scanning rows from
	// the middle out. Each symbol is reported once, with the corners of the
	// rows that read it.
	def decode(img Image, fullAscii bool = false) Barcode[] {
		let gray = new Gray(img)
		let found Barcode[]
		let rows = gray.height
		let step = (rows / 40).max(1)
		let mid = rows / 2
		for let k = 0; k * step <= mid + step; k++ {
			for let sign in int[1, -1] {
				continue when k == 0 && sign == -1
				let y = mid + sign * k * step
				continue when y < 0 || y >= rows
				let runs = gray.rowRuns(y)
				continue when runs.len() < 20
				let hit = scanRuns(runs, fullAscii)
				continue when hit is none
				let (h, x0, x1) = hit
				let known = -1
				for let (n, b) in found {
					known = n when b.symbology == h.symbology && b.text == h.text
				}
				if known < 0 {
					let corners = [new Point(float(x0), float(y)), new Point(float(x1), float(y)), new Point(float(x1), float(y)), new Point(float(x0), float(y))]
					found += Barcode{symbology: h.symbology, text: h.text, data: h.text.bytes(), corners: corners}
					continue
				}
				let c = found[known].corners
				if float(y) < c[0].y {
					c[0] = new Point(c[0].x, float(y))
					c[1] = new Point(c[1].x, float(y))
				}
				if float(y) > c[3].y {
					c[2] = new Point(c[2].x, float(y))
					c[3] = new Point(c[3].x, float(y))
				}
			}
		}
		return found
	}

	// The first symbol in runs, forwards then backwards, with the pixel
	// offsets of its first and last bar along the original direction.
	internal def scanRuns(input int[], fullAscii bool) ?(Hit, int, int) {
		let runs = input.clone()
		runs = int[0] + runs when runs.len() % 2 == 0
		runs += 0 when runs.len() % 2 == 0
		let total = span(runs, 0, runs.len())
		for let reverse in [false, true] {
			let r = reverse ?? (runs.clone().reverse(), runs)
			for let i = 1; i < r.len(); i += 2 {
				let hit = decodeAt(r, i, fullAscii)
				continue when hit is none
				let h = hit
				let start = span(r, 0, i)
				let stop = span(r, 0, h.end)
				return reverse ?? ((h, total - stop, total - start), (h, start, stop))
			}
		}
		return none
	}

	// Tries every symbology at dark run i.
	internal def decodeAt(runs int[], i int, fullAscii bool) ?Hit {
		let hit = decodeEan(runs, i)
		hit = decodeCode128(runs, i) when hit is none
		hit = decodeCode39(runs, i, fullAscii) when hit is none
		hit = decodeCode93(runs, i) when hit is none
		hit = decodeItf(runs, i) when hit is none
		hit = decodeCodabar(runs, i) when hit is none
		return hit
	}
}
