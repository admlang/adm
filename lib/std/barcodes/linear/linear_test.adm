partial module std.barcodes.linear {
	use (
		std.testing
		std.barcodes::*
	)

	// Encodes text, then reads it back from the widths and from a rendered image.
	def roundTrip(text string, symbology Symbology, want string, checkDigit bool = false, fullAscii bool = false) !none {
		let sym = try encode(text, symbology, checkDigit = checkDigit, fullAscii = fullAscii)
		let back = try decode(sym, fullAscii = fullAscii)
		fail "{symbology}: widths read {back.symbology} '{back.text}'" when back.symbology != symbology || back.text != want
		let found = decode(sym.toImage(scale = 2), fullAscii = fullAscii)
		fail "{symbology}: image read nothing" when found.len() != 1
		fail "{symbology}: image read '{found[0].text}'" when found[0].text != want || found[0].symbology != symbology
	}

	check "Linear" {
		@test()
		def TestEanUpc() !none {
			let ean = try encode("590123412345", Symbology.Ean13)
			assert ean.text == "5901234123457"
			assert ean.width == 95
			try roundTrip("5901234123457", Symbology.Ean13, "5901234123457")
			try roundTrip("03600029145", Symbology.UpcA, "036000291452")
			try roundTrip("9638507", Symbology.Ean8, "96385074")
			try roundTrip("0123456", Symbology.UpcE, "01234565")
			try roundTrip("1654321", Symbology.UpcE, "16543214")
			try roundTrip("9781234567897 51299", Symbology.Ean13, "9781234567897 51299")
			try roundTrip("03600029145 12", Symbology.UpcA, "036000291452 12")
			let wrong = false
			encode("5901234123450", Symbology.Ean13) onerror (err error) {
				wrong = true
				recover new Symbol(Symbology.Ean13, 1, 1)
			}
			assert wrong
		}

		@test()
		def TestCode128() !none {
			try roundTrip("Hello, World!", Symbology.Code128, "Hello, World!")
			try roundTrip("1234567890", Symbology.Code128, "1234567890")
			try roundTrip("ab12345678cd\t", Symbology.Code128, "ab12345678cd\t")
			try roundTrip("\u001d0112345678901231\u001d10ABC", Symbology.Code128, "\u001d0112345678901231\u001d10ABC")
			try roundTrip("caf\u00e9", Symbology.Code128, "caf\u00e9")
			let sym = try encode("1234", Symbology.Code128)
			// Start C, 12, 34, check, stop: 5 characters of 11 modules and 13 for the stop.
			assert sym.width == 4 * 11 + 13
		}

		@test()
		def TestCode39And93() !none {
			try roundTrip("CODE 39-$/+%.", Symbology.Code39, "CODE 39-$/+%.")
			try roundTrip("ABC", Symbology.Code39, "ABCX", checkDigit = true)
			try roundTrip("Mixed case!", Symbology.Code39, "Mixed case!", fullAscii = true)
			try roundTrip("CODE93", Symbology.Code93, "CODE93")
			try roundTrip("Full ASCII: a~z", Symbology.Code93, "Full ASCII: a~z")
		}

		@test()
		def TestItfCodabar() !none {
			try roundTrip("12345670", Symbology.Itf, "12345670")
			try roundTrip("1234567", Symbology.Itf, "12345670", checkDigit = true)
			try roundTrip("A40156B", Symbology.Codabar, "A40156B")
			try roundTrip("31117013206375", Symbology.Codabar, "A31117013206375A")
		}
	}
}
