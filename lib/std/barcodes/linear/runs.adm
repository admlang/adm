internal partial module std.barcodes.linear.coding {
	use std.barcodes::*

	// How far runs[i .. i + pattern.len()) are from the pattern (widths in
	// modules): 0 is exact, larger is worse, -1 when one element is off by
	// more than maxElement modules.
	def variance(runs int[], i int, pattern int[], maxElement float = 0.7) float {
		return -1.0 when i < 0 || i + pattern.len() > runs.len()
		let total = 0
		let modules = 0
		for let k = 0; k < pattern.len(); k++ {
			total += runs[i + k]
			modules += pattern[k]
		}
		return -1.0 when total == 0
		let unit = float(total) / float(modules)
		let sum = 0.0
		for let k = 0; k < pattern.len(); k++ {
			let d = (float(runs[i + k]) - float(pattern[k]) * unit).abs() / unit
			return -1.0 when d > maxElement
			sum += d
		}
		return sum / float(modules)
	}

	// The index of the pattern in table that runs[i ..] matches best, or -1
	// when none is within maxVariance.
	def bestMatch(runs int[], i int, table int[][], maxVariance float = 0.25, maxElement float = 0.7) int {
		let best = -1
		let bestV = maxVariance
		for let (k, p) in table {
			let v = variance(runs, i, p, maxElement)
			continue when v < 0.0 || v >= bestV
			best = k
			bestV = v
		}
		return best
	}

	// The sum of runs[i .. i + n).
	def span(runs int[], i int, n int) int {
		let total = 0
		for let k = i; k < i + n && k < runs.len(); k++ {
			total += runs[k]
		}
		return total
	}

	// Whether the light run at index i is at least modules wide, for a symbol
	// whose module is unit wide. Index -1 or past the end is the image edge,
	// which never counts as a quiet zone.
	def quiet(runs int[], i int, unit float, modules float) bool {
		return false when i < 0 || i >= runs.len()
		return float(runs[i]) >= unit * modules
	}

	// Splits a width string such as "3211" into its digits.
	def widthsOf(text string) int[] {
		let out int[]
		for let ch in text.bytes() {
			out += int(ch) - 48
		}
		return out
	}

	// A table of width patterns from their strings.
	def tableOf(patterns string[]) int[][] {
		let out int[][]
		for let p in patterns {
			out += widthsOf(p)
		}
		return out
	}

	// Widths for a narrow/wide pattern given as bits, most significant first
	// (1 = wide), n elements long.
	def wideNarrow(bits int, n int, wide int) int[] {
		let out int[]
		for let k = n - 1; k >= 0; k-- {
			out += ((bits >> k) & 1) == 1 ?? (wide, 1)
		}
		return out
	}

	// Classifies n runs from i as narrow (0) or wide (1) with one threshold
	// between the widest narrow and the narrowest wide run. Returns the bits,
	// most significant first, or -1 when the runs do not split cleanly into
	// between minWide and maxWide wide elements.
	def classify(runs int[], i int, n int, minWide int, maxWide int) int {
		return -1 when i < 0 || i + n > runs.len()
		let sorted int[]
		for let k = 0; k < n; k++ {
			sorted += runs[i + k]
		}
		sorted.sort((a, b) => a < b)
		let best = -1
		let bestRatio = 1.5
		for let wides = minWide; wides <= maxWide; wides++ {
			let narrowMax = sorted[n - wides - 1]
			let wideMin = sorted[n - wides]
			continue when narrowMax <= 0
			let ratio = float(wideMin) / float(narrowMax)
			continue when ratio < bestRatio
			bestRatio = ratio
			best = wides
		}
		return -1 when best < 0
		let threshold = sorted[n - best]
		let bits = 0
		let count = 0
		for let k = 0; k < n; k++ {
			let wide = runs[i + k] >= threshold
			bits = (bits << 1) | (wide ?? (1, 0))
			count += wide ?? (1, 0)
		}
		return -1 when count != best
		return bits
	}

	// Mod-10 check digit of the GS1 family (EAN, UPC, ITF-14): weights 3 and 1
	// from the rightmost digit.
	def gs1Check(digits string) int {
		let sum = 0
		let bytes = digits.bytes()
		for let k = 0; k < bytes.len(); k++ {
			let d = int(bytes[bytes.len() - 1 - k]) - 48
			sum += k % 2 == 0 ?? (3 * d, d)
		}
		return (10 - sum % 10) % 10
	}

	// Whether text is all ASCII digits, and not empty.
	def allDigits(text string) bool {
		return false when text.len() == 0
		for let ch in text.bytes() {
			return false when ch < 48 || ch > 57
		}
		return true
	}
}
