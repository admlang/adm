internal partial module std.barcodes.pdf417.coding {
	use (
		std.barcodes::*
		std.barcodes.pdf417.tables::*
		std.barcodes.scan::*
		std.math.geom::(Point)
		std.math
	)

	// Where a row's start pattern (or MicroPDF417 left row address pattern)
	// begins, and the module width there.
	struct Hit {
		x    float
		y    int
		unit float
	}

	// A column of hits, one per image row, down the left edge of a symbol.
	struct Edge {
		hits Hit[]
	}

	// The runs of image row y, dark and light alternating from a light run,
	// with where each starts.
	def rowRuns(img BitGrid, y int) (int[], int[]) {
		let runs int[]
		let starts int[]
		let x = 0
		if img.dark(0, y) {
			runs.push(0)
			starts.push(0)
		}
		for x < img.width {
			let d = img.dark(x, y)
			let s = x
			for x < img.width && img.dark(x, y) == d {
				x++
			}
			runs.push(x - s)
			starts.push(s)
		}
		return (runs, starts)
	}

	// The start of every PDF417 start pattern (micro false) or MicroPDF417
	// left row address pattern followed by a codeword (micro true).
	def findHits(img BitGrid, micro bool) Hit[] {
		let hits Hit[]
		for let y = 0; y < img.height; y++ {
			let (runs, starts) = rowRuns(img, y)
			for let k = 1; k < runs.len(); k += 2 {
				if micro {
					continue when rapAt(runs, k, rapSide) < 0 || codewordAt(runs, k + 6) < 0
					let total = runs[k] + runs[k + 1] + runs[k + 2] + runs[k + 3] + runs[k + 4] + runs[k + 5]
					// The light run before must be wider than a module.
					continue when float(runs[k - 1]) < float(total) / 10.0
					hits.push(Hit{x: float(starts[k]), y: y, unit: float(total) / 10.0})
				} else {
					continue when !matches(runs, k, startPattern)
					let total = 0
					for let j = 0; j < 8; j++ {
						total += runs[k + j]
					}
					hits.push(Hit{x: float(starts[k]), y: y, unit: float(total) / 17.0})
				}
			}
		}
		return hits
	}

	// Groups hits into edges: a hit joins an edge whose last hit is at most
	// three rows up and two modules across.
	def edgesOf(hits Hit[]) Edge[] {
		let edges Edge[]
		for let h in hits {
			let joined = false
			for let e in edges {
				let last = e.hits[e.hits.len() - 1]
				continue when h.y - last.y > 3 || h.y == last.y || (h.x - last.x).abs() > 2.0 * h.unit
				e.hits.push(h)
				joined = true
				break
			}
			if !joined {
				let e = Edge{}
				e.hits.push(h)
				edges.push(e)
			}
		}
		return edges.filter(e => e.hits.len() >= 4)
	}

	// Samples the image along a line from (x, y) in direction (dx, dy) until
	// the image ends, as runs from a light run.
	def lineRuns(img BitGrid, x, y, dx, dy float, back float) int[] {
		let runs = int[0]
		let dark = false
		let t = -back
		let entered = false
		for t < float(img.width + img.height) {
			let px = x + dx * t
			let py = y + dy * t
			if px < 0.0 || py < 0.0 || px >= float(img.width) || py >= float(img.height) {
				break when entered
				// Before the image: count it as light margin.
				runs[0] += 1 when runs.len() == 1
				t += 1.0
				continue
			}
			entered = true
			let d = img.dark(int(px), int(py))
			if d != dark {
				runs.push(0)
				dark = d
			}
			runs[runs.len() - 1] += 1
			t += 1.0
		}
		return runs
	}

	// An edge as the line x = a * y + b from row top to row bottom, with
	// the mean module width of its hits; valid false for no edge.
	struct EdgeLine {
		a, b        float
		top, bottom int
		unit        float
		valid       bool
	}

	// The least-squares line through an edge's hits.
	def lineOf(e Edge) EdgeLine {
		let n = float(e.hits.len())
		let sy = 0.0
		let sx = 0.0
		let syy = 0.0
		let sxy = 0.0
		let unit = 0.0
		for let h in e.hits {
			let y = float(h.y)
			sy += y
			sx += h.x
			syy += y * y
			sxy += y * h.x
			unit += h.unit
		}
		let den = n * syy - sy * sy
		let a = den.abs() < 1e-9 ?? (0.0, (n * sxy - sy * sx) / den)
		return EdgeLine{a: a, b: (sx - a * sy) / n, top: e.hits[0].y, bottom: e.hits[e.hits.len() - 1].y, unit: unit / n, valid: true}
	}

	// The end of every PDF417 stop pattern, as hits at its right edge.
	def findStops(img BitGrid) Hit[] {
		let hits Hit[]
		for let y = 0; y < img.height; y++ {
			let (runs, starts) = rowRuns(img, y)
			for let k = 1; k + 9 <= runs.len(); k += 2 {
				continue when !matches(runs, k, stopPattern)
				let total = 0
				for let j = 0; j < 9; j++ {
					total += runs[k + j]
				}
				hits.push(Hit{x: float(starts[k] + total), y: y, unit: float(total) / 18.0})
			}
		}
		return hits
	}

	// Reads the symbol along an edge, rows running to the matching points
	// of the right edge when there is one; none when it does not decode.
	def readEdge(img BitGrid, e Edge, micro bool, right EdgeLine) ?Barcode {
		let line = lineOf(e)
		let a = line.a
		let b = line.b
		let unit = line.unit
		// Rows run perpendicular to the edge.
		let len = math.sqrt(1.0 + a * a)
		let dx = 1.0 / len
		let dy = -a / len
		let scans RowScan[]
		let microScans = [RowScan[], RowScan[], RowScan[], RowScan[]]
		let top = e.hits[0].y
		let bottom = e.hits[e.hits.len() - 1].y
		for let y = top; y <= bottom; y++ {
			let x = a * float(y) + b
			let rdx = dx
			let rdy = dy
			if right.valid {
				// Towards the matching point on the right edge.
				let t = float(y - top) / float((bottom - top).max(1))
				let ry = float(right.top) + t * float(right.bottom - right.top)
				let rx = right.a * ry + right.b
				let ex = rx - x
				let ey = ry - float(y)
				let el = math.sqrt(ex * ex + ey * ey)
				if el > unit * 20.0 {
					rdx = ex / el
					rdy = ey / el
				}
			}
			let runs = lineRuns(img, x, float(y), rdx, rdy, unit * 3.0)
			// The first dark run at or after the edge.
			let k = 1
			let pos = -unit * 3.0
			for k < runs.len() {
				pos += float(runs[k - 1])
				break when pos >= -unit
				pos += float(runs[k])
				k += 2
			}
			continue when k >= runs.len()
			if micro {
				for let cols = 1; cols <= 4; cols++ {
					let row = readMicroRow(runs, k, cols)
					continue when row is none
					let r = row
					continue when r.rightRap < 0
					microScans[cols - 1].push(r)
				}
			} else {
				let row = readPdfRow(runs, k)
				scans.push(row) unless row is none
			}
		}
		let corners Point[]
		let x0 = a * float(top) + b
		let x1 = a * float(bottom) + b
		corners.push(new Point(x0, float(top)))
		if right.valid {
			corners.push(new Point(right.a * float(right.top) + right.b, float(right.top)))
			corners.push(new Point(right.a * float(right.bottom) + right.b, float(right.bottom)))
		} else {
			corners.push(new Point(x0, float(top)))
			corners.push(new Point(x1, float(bottom)))
		}
		corners.push(new Point(x1, float(bottom)))
		if micro {
			let best = 0
			for let c = 1; c < 4; c++ {
				best = c when microScans[c].len() > microScans[best].len()
			}
			return none when microScans[best].len() == 0
			let decoded = assembleMicro(microScans[best], best + 1) onerror recover Decoded{segment: -2}
			return none when decoded.segment == -2
			return Barcode{symbology: Symbology.MicroPdf417, text: decoded.text, data: decoded.data, corners: corners}
		}
		return none when scans.len() < 3
		let decoded = assemble(scans) onerror recover Decoded{segment: -2}
		return none when decoded.segment == -2
		return Barcode{symbology: Symbology.Pdf417, text: decoded.text, data: decoded.data, corners: corners}
	}

	// Every PDF417 and MicroPDF417 symbol in the image, in each quarter turn.
	def detectAll(image BitGrid) Barcode[] {
		let out Barcode[]
		let img = image
		for let turn = 0; turn < 4; turn++ {
			let rights EdgeLine[]
			for let r in edgesOf(findStops(img)) {
				rights.push(lineOf(r))
			}
			for let micro in [false, true] {
				for let e in edgesOf(findHits(img, micro)) {
					let left = lineOf(e)
					// The nearest stop edge to the right that shares most rows.
					let right = EdgeLine{valid: false}
					let mid = (left.top + left.bottom) / 2
					let lx = left.a * float(mid) + left.b
					let bestX = 1e300
					for let r in rights {
						continue when micro
						let overlap = left.bottom.min(r.bottom) - left.top.max(r.top)
						continue when overlap * 2 < left.bottom - left.top
						let rx = r.a * float(mid) + r.b
						continue when rx <= lx || rx - lx >= bestX
						bestX = rx - lx
						right = r
					}
					let found = readEdge(img, e, micro, right)
					continue when found is none
					let b = found
					// Back from the turned image: each quarter turn took
					// (x, y) to (h - 1 - y, x) with h the height before it,
					// undone from the last turn back.
					let w = image.width
					let h = image.height
					for let k = 0; k < b.corners.len(); k++ {
						let x = b.corners[k].x
						let y = b.corners[k].y
						for let t = turn - 1; t >= 0; t-- {
							let before = t % 2 == 0 ?? (h, w)
							let nx = y
							let ny = float(before) - 1.0 - x
							x = nx
							y = ny
						}
						b.corners[k] = new Point(x, y)
					}
					let dup = false
					for let o in out {
						dup = true when o.text == b.text && o.symbology == b.symbology
					}
					out.push(b) when !dup
				}
			}
			img = img.rotated()
		}
		return out
	}
}
