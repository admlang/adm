partial module std.barcodes.pdf417 {
	// PDF417 and MicroPDF417 (ISO/IEC 15438, 24728): text, byte and numeric
	// compaction, error correction levels 0-8, Macro PDF417; encode to a
	// `Symbol` and decode a sampled row-and-codeword grid.
	use (
		std.barcodes::*
		std.barcodes.pdf417.coding::*
		std.barcodes.scan::(Gray, BitGrid)
		std.formats.image::(Image)
	)

	// Encodes text as a PDF417 symbol, or MicroPDF417 with micro. The text
	// is split between text, byte and numeric compaction, whichever is
	// shorter. ASCII is stored as is, other Latin-1 text with ECI 3 and
	// anything else as UTF-8 with ECI 26. level is the error correction
	// level 0 to 8 (2 to 5 by size when -1); MicroPDF417 has its own fixed
	// correction per size. columns is the number of data columns (1 to 30,
	// MicroPDF417 1 to 4), chosen when 0 for a symbol about three times as
	// wide as tall. compact makes a compact PDF417 (no right row indicator,
	// a one-module stop). Each row is rowHeight modules tall (3 by default,
	// 2 for MicroPDF417). Fails when the text does not fit.
	//
	// ```
	// let sym = pdf417.encode("PDF417 holds up to 1850 characters", level = 4)!
	// ```
	def encode(text string, level int = -1, columns int = 0, compact bool = false, micro bool = false, rowHeight int = 0) !Symbol {
		let (msg, eci) = messageOf(text)
		let words int[]
		encodeEci(eci, words) when eci >= 0
		encodeData(msg, words)
		return build(words, level, columns, compact, micro, rowHeight)
	}

	// Encodes binary data as PDF417 or MicroPDF417, as the text form does
	// without the ECI. Fails when it does not fit.
	def encode(data byte[], level int = -1, columns int = 0, compact bool = false, micro bool = false, rowHeight int = 0) !Symbol {
		let msg int[]
		for let b in data {
			msg.push(int(b))
		}
		let words int[]
		encodeData(msg, words)
		return build(words, level, columns, compact, micro, rowHeight)
	}

	// Splits text over parts PDF417 symbols (2 to 99999) joined by Macro
	// PDF417: every symbol carries its segment index, the segment count and
	// a shared file ID, so a reader can put them back together. Fails when
	// parts is out of range or a piece does not fit.
	def sequence(text string, parts int, level int = -1) !Symbol[] {
		expects {
			assert parts >= 2 && parts <= 99999 onerror fail "pdf417: a sequence has 2 to 99999 symbols"
		}
		let (msg, eci) = messageOf(text)
		fail "pdf417: fewer characters than symbols" when msg.len() < parts
		// The file ID: two codewords from a checksum of the message.
		let sum = 0
		for let c in msg {
			sum = (sum * 31 + c) % 810000
		}
		let fileId = int[sum / 900, sum % 900]
		let per = (msg.len() + parts - 1) / parts
		let out Symbol[]
		for let k = 0; k < parts; k++ {
			let start = k * per
			let count = (msg.len() - start).min(per)
			let words int[]
			encodeEci(eci, words) when eci >= 0
			encodeData(msg.slice(start, count), words)
			encodeMacro(k, parts, fileId, words)
			out.push(try build(words, level, 0, compact = false, micro = false, rowHeight = 0))
		}
		return out
	}

	// Decodes a PDF417 or MicroPDF417 module grid (no quiet zone): each row
	// of modules is read as a scanline, rows are placed by their row
	// indicators (row address patterns for MicroPDF417) and the codewords
	// corrected. The text of a Macro PDF417 segment is that segment's part.
	// Fails when the rows cannot be read or corrected.
	def decode(sym Symbol) !Barcode {
		let scans RowScan[]
		let microScans RowScan[]
		let micro = sym.symbology == Symbology.MicroPdf417
		let cols = 0
		if micro {
			for let c = 1; c <= 4; c++ {
				cols = c when sym.width == 17 * c + 21 + (c >= 3 ?? (10, 0))
			}
			fail "pdf417: no MicroPDF417 is {sym.width} modules wide" when cols == 0
		}
		for let y = 0; y < sym.height; y++ {
			let runs int[]
			let dark = true
			let length = 0
			for let x = 0; x < sym.width; x++ {
				if sym.dark(x, y) != dark {
					runs.push(length)
					dark = !dark
					length = 0
				}
				length++
			}
			runs.push(length)
			if micro {
				let row = readMicroRow(runs, 0, cols)
				microScans.push(row) unless row is none
			} else {
				let row = readPdfRow(runs, 0)
				scans.push(row) unless row is none
			}
		}
		let decoded = micro ?? (try assembleMicro(microScans, cols), try assemble(scans))
		return Barcode{symbology: micro ?? (Symbology.MicroPdf417, Symbology.Pdf417), text: decoded.text, data: decoded.data}
	}

	// Finds and decodes every PDF417 and MicroPDF417 symbol in an image
	// that lies within a few degrees of upright or of a quarter turn. The
	// text of a Macro PDF417 segment is that segment's part.
	def decode(img Image) Barcode[] {
		return detectAll(new BitGrid(new Gray(img)))
	}

	// The message bytes of text and the ECI they need (-1 for ASCII).
	internal def messageOf(text string) (int[], int) {
		let msg int[]
		let top = 0
		for let ch in text {
			top = top.max(int(ch))
		}
		if top <= 255 {
			for let ch in text {
				msg.push(int(ch))
			}
			return (msg, top < 128 ?? (-1, 3))
		}
		for let b in text.bytes() {
			msg.push(int(b))
		}
		return (msg, 26)
	}

	internal def build(words int[], level int, columns int, compact bool, micro bool, rowHeight int) !Symbol {
		expects {
			assert level >= -1 && level <= 8 onerror fail "pdf417: levels are 0 to 8"
		}
		if micro {
			fail "pdf417: MicroPDF417 has 1 to 4 columns" when columns < 0 || columns > 4
			return buildMicro(words, columns, rowHeight > 0 ?? (rowHeight, 2))
		}
		fail "pdf417: columns are 1 to 30" when columns < 0 || columns > 30
		return buildPdf417(words, level, columns, rowHeight > 0 ?? (rowHeight, 3), compact)
	}
}
