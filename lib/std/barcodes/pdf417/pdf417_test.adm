partial module std.barcodes.pdf417 {
	use (
		std.testing
		std.barcodes::*
		std.barcodes.pdf417.coding::*
	)

	check "Pdf417" {
		@test()
		def TestRoundTrip() !none {
			let texts = [
				"PDF417",
				"Hello, PDF417 World! 12345",
				"12345678901234567890123456789",
				"lower case and UPPER; punct: \{x\}",
				"ÀÁÂ Latin-1 é",
				"世界 unicode",
				"\u0001\u0002 binary bytes ÿ",
				"A".repeat(500),
				"0123456789".repeat(60),
				"Mixed 1234567890123 then text"
			]
			for let text in texts {
				for let compact in [false, true] {
					let sym = try encode(text, compact = compact)
					let back = try decode(sym)
					fail "'{text}' read '{back.text}'" when back.text != text || back.symbology != Symbology.Pdf417
				}
			}
			let bin = byte[0, 1, 2, 128, 200, 255, 10, 13, 30, 40, 50, 60, 70]
			assert (try decode(try encode(bin))).data.hex() == bin.hex()
		}

		@test()
		def TestLayout() !none {
			let sym = try encode("layout", level = 5, columns = 4)
			// Start, left indicator, 4 data columns, right indicator, stop.
			assert sym.width == 17 * 4 + 69
			assert (try decode(sym)).text == "layout"
			let compact = try encode("layout", columns = 4, compact = true)
			assert compact.width == 17 * 4 + 35
			let tall = try encode("rows", rowHeight = 5)
			assert tall.height % 5 == 0
			let bad = false
			encode("x", level = 9) onerror (err error) {
				bad = true
				recover new Symbol(Symbology.Pdf417, 1, 1)
			}
			assert bad
		}

		@test()
		def TestMicro() !none {
			for let text in ["PDF417", "Hello, PDF417 World! 12345", "12345678901234567890123456789", "ÀÁÂ Latin-1 é"] {
				let sym = try encode(text, micro = true)
				let back = try decode(sym)
				fail "micro '{text}' read '{back.text}'" when back.text != text || back.symbology != Symbology.MicroPdf417
			}
			let four = try encode("four columns of MicroPDF417", micro = true, columns = 4)
			assert four.width == 17 * 4 + 31
			assert (try decode(four)).text == "four columns of MicroPDF417"
		}

		@test()
		def TestDamage() !none {
			let sym = try encode("PDF417 error correction", level = 4)
			// Wipe the middle of a few rows.
			for let y = 3; y < 6; y++ {
				for let x = 40; x < 70; x++ {
					sym.dark(x, y, false)
				}
			}
			assert (try decode(sym)).text == "PDF417 error correction"
		}

		@test()
		def TestSequence() !none {
			let parts = try sequence("Macro PDF417 splits a message", 3)
			assert parts.len() == 3
			let joined = ""
			for let sym in parts {
				let back = try decode(sym)
				joined += back.text
			}
			assert joined == "Macro PDF417 splits a message"
		}

		@test()
		def TestImages() !none {
			let found = decode((try encode("PDF417 in an image")).toImage(scale = 2))
			assert found.len() == 1 && found[0].text == "PDF417 in an image"
			let micro = decode((try encode("micro in an image", micro = true)).toImage(scale = 3))
			assert micro.len() == 1 && micro[0].text == "micro in an image"
		}
	}
}
