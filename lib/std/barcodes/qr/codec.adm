internal partial module std.barcodes.qr.coding {
	use (
		std.barcodes::*
		std.math.ecc::(ReedSolomon)
	)

	// Structured append header for one symbol of a sequence; count 0 for a
	// symbol that stands alone.
	struct Append {
		index  int
		count  int
		parity int
	}

	// The segment bits of units in the smallest version from minVersion
	// that holds them at the level, or none. Returns (version, bits).
	def fitQr(units Unit[], level int, minVersion int, maxVersion int, eci int, append Append) ?(int, Bits) {
		for let v = minVersion; v <= maxVersion; v++ {
			let modes = chooseModes(units, v, 0)
			continue when !modesValid(modes)
			let bits = new Bits()
			if append.count > 0 {
				bits.add(3, 4)
				bits.add(append.index, 4)
				bits.add(append.count - 1, 4)
				bits.add(append.parity, 8)
			}
			writeEci(bits, eci) when eci >= 0
			continue when writeSegments(bits, units, modes, v, 0) < 0
			continue when bits.len() > dataCodewords(v, level) * 8
			return (v, bits)
		}
		return none
	}

	// Terminates and pads bits to capacity bits (a multiple of 4), as data
	// codewords; a final half codeword sits in the high nibble.
	def padded(bits Bits, capacity int, terminator int) byte[] {
		bits.add(0, terminator.min(capacity - bits.len()))
		bits.add(0, (8 - bits.len() % 8) % 8) when bits.len() + (8 - bits.len() % 8) % 8 <= capacity
		let pad = 0xec
		for capacity - bits.len() >= 8 {
			bits.add(pad, 8)
			pad = pad ^ (0xec ^ 0x11)
		}
		bits.add(0, capacity - bits.len())
		let out byte[]
		for let k = 0; k < bits.len(); k += 8 {
			let v = 0
			for let j = 0; j < 8; j++ {
				v = (v << 1) | (k + j < bits.len() ?? (int(bits.bits[k + j]), 0))
			}
			out.push(byte(v))
		}
		return out
	}

	// The codewords of a QR Code symbol: data split into blocks, each with
	// its error correction, interleaved.
	def interleave(data byte[], version int, level int) byte[] {
		let blocks = eccBlocks[level][version]
		let ecc = eccPerBlock[level][version]
		let total = rawModules(version) / 8
		let shortLen = total / blocks
		let shortCount = blocks - total % blocks
		let rs = new ReedSolomon(qrField, ecc)
		let dataBlocks int[][]
		let eccBlocksOut int[][]
		let at = 0
		for let b = 0; b < blocks; b++ {
			let n = shortLen - ecc + (b >= shortCount ?? (1, 0))
			let block int[]
			for let k = 0; k < n; k++ {
				block.push(int(data[at + k]))
			}
			at += n
			dataBlocks.push(block)
			eccBlocksOut.push(rs.encode(block))
		}
		let out byte[]
		for let k = 0; k <= shortLen - ecc; k++ {
			for let b = 0; b < blocks; b++ {
				out.push(byte(dataBlocks[b][k])) when k < dataBlocks[b].len()
			}
		}
		for let k = 0; k < ecc; k++ {
			for let b = 0; b < blocks; b++ {
				out.push(byte(eccBlocksOut[b][k]))
			}
		}
		return out
	}

	// Builds a QR Code symbol. mask -1 picks the lowest penalty.
	def buildQr(units Unit[], level int, version int, mask int, eci int, append Append) !Symbol {
		let fit = fitQr(units, level, version > 0 ?? (version, 1), version > 0 ?? (version, 40), eci, append)
		fail "qr: data too long for the version and level" when fit is none
		let (v, bits) = fit
		let data = padded(bits, dataCodewords(v, level) * 8, 4)
		let codewords = interleave(data, v, level)
		let size = v * 4 + 17
		let grid = new Grid(size, 0)
		grid.drawFunctions(v)
		let order = grid.dataOrder()
		for let (i, pos) in order {
			let k = i / 8
			grid.dark[pos] = k < codewords.len() ?? ((codewords[k] >> (7 - i % 8)) & 1, 0)
		}
		let best = mask
		if mask < 0 {
			let bestScore = 1 << 30
			for let m = 0; m < 8; m++ {
				grid.applyMask(m)
				grid.drawFormat(formatBits((levelBits[level] << 3) | m, 0x5412))
				let s = grid.penalty()
				grid.applyMask(m)
				continue when s >= bestScore
				bestScore = s
				best = m
			}
		}
		grid.applyMask(best)
		grid.drawFormat(formatBits((levelBits[level] << 3) | best, 0x5412))
		return toSymbol(grid, Symbology.Qr, 4)
	}

	// Builds a Micro QR symbol at the smallest size that holds units at the
	// level (0 L, 1 M, 2 Q). mask -1 picks the best of the four.
	def buildMicro(units Unit[], level int, version int, mask int) !Symbol {
		for let sn = 0; sn < 8; sn++ {
			let mv = microVersion[sn]
			continue when version > 0 && mv != version
			continue when microLevel[sn] != level && !(sn == 0 && level == 0)
			let modes = chooseModes(units, 0, mv)
			continue when !modesValid(modes)
			let bits = new Bits()
			continue when writeSegments(bits, units, modes, 0, mv) < 0
			let capacity = microDataBits[sn]
			continue when bits.len() > capacity
			let data = padded(bits, capacity, mv * 2 + 1)
			let rs = new ReedSolomon(qrField, microEcc[sn])
			let block int[]
			for let b in data {
				block.push(int(b))
			}
			let ecc = rs.encode(block)
			let stream = new Bits()
			for let (k, b) in data {
				let half = k == data.len() - 1 && capacity % 8 == 4
				stream.add(half ?? (int(b) >> 4, int(b)), half ?? (4, 8))
			}
			for let e in ecc {
				stream.add(e, 8)
			}
			let size = mv * 2 + 9
			let grid = new Grid(size, mv)
			grid.drawFunctions(0)
			for let (i, pos) in grid.dataOrder() {
				grid.dark[pos] = i < stream.len() ?? (stream.bits[i], 0)
			}
			let best = mask
			if mask < 0 {
				let bestScore = -1
				for let m = 0; m < 4; m++ {
					grid.applyMask(m)
					let s = grid.microScore()
					grid.applyMask(m)
					continue when s <= bestScore
					bestScore = s
					best = m
				}
			}
			grid.applyMask(best)
			grid.drawMicroFormat(formatBits((sn << 2) | best, 0x4445))
			return toSymbol(grid, Symbology.MicroQr, 2)
		}
		fail "qr: data too long for Micro QR at this level"
	}

	def toSymbol(grid Grid, symbology Symbology, quiet int) Symbol {
		let sym = new Symbol(symbology, grid.size, grid.size, quiet)
		for let y = 0; y < grid.size; y++ {
			for let x = 0; x < grid.size; x++ {
				sym.dark(x, y, grid.at(x, y))
			}
		}
		return sym
	}

	// Reads a QR Code or Micro QR grid, trying its mirror image when the
	// first reading fails. Fails when neither decodes.
	def readGrid(sym Symbol) !Content {
		expects {
			assert sym.width == sym.height onerror fail "qr: symbol is not square"
		}
		let size = sym.width
		let micro = size <= 17 ?? ((size - 9) / 2, 0)
		fail "qr: no QR Code has {size} modules a side" when (micro > 0 && (size - 9) % 2 != 0) || (micro == 0 && ((size - 17) % 4 != 0 || size < 21 || size > 177))
		let grid = new Grid(size, micro)
		for let y = 0; y < size; y++ {
			for let x = 0; x < size; x++ {
				grid.put(x, y, sym.dark(x, y))
			}
		}
		let reason = ""
		let content = readOne(grid) onerror (err error) {
			reason = err.message
			recover Content{count: -1}
		}
		return content when content.count >= 0
		let mirrored = readOne(grid.transposed()) onerror (err error) {
			recover Content{count: -1}
		}
		return mirrored when mirrored.count >= 0
		fail reason
	}

	// Reads one orientation of a grid.
	def readOne(grid Grid) !Content {
		let size = grid.size
		if grid.micro > 0 {
			let raw = grid.readMicroFormat()
			let found = -1
			let bestD = 4
			for let sn = 0; sn < 8; sn++ {
				continue when microVersion[sn] != grid.micro
				for let m = 0; m < 4; m++ {
					let d = bitDistance(raw, formatBits((sn << 2) | m, 0x4445))
					continue when d >= bestD
					bestD = d
					found = (sn << 2) | m
				}
			}
			fail "qr: unreadable Micro QR format information" when found < 0
			let sn = found >> 2
			let clean = new Grid(size, grid.micro)
			clean.drawFunctions(0)
			clean.drawMicroFormat(0)
			for let k = 0; k < size * size; k++ {
				clean.dark[k] = grid.dark[k] when clean.fn[k] == 0
			}
			clean.applyMask(found & 3)
			let order = clean.dataOrder()
			let capacity = microDataBits[sn]
			let dataCount = (capacity + 7) / 8
			let eccCount = microEcc[sn]
			let words int[]
			let at = 0
			for let k = 0; k < dataCount + eccCount; k++ {
				let half = k == dataCount - 1 && capacity % 8 == 4
				let n = half ?? (4, 8)
				let v = 0
				for let j = 0; j < n; j++ {
					v = (v << 1) | (at + j < order.len() ?? (int(clean.dark[order[at + j]]), 0))
				}
				at += n
				words.push(half ?? (v << 4, v))
			}
			let rs = new ReedSolomon(qrField, eccCount)
			try rs.correct(words)
			let bits byte[]
			for let k = 0; k < dataCount; k++ {
				let n = (k == dataCount - 1 && capacity % 8 == 4) ?? (4, 8)
				for let j = 7; j > 7 - n; j-- {
					bits.push(byte((words[k] >> j) & 1))
				}
			}
			return parseSegments(bits, 0, grid.micro)
		}

		let version = (size - 17) / 4
		let (fa, fb) = grid.readFormat()
		let found = -1
		let bestD = 4
		for let l = 0; l < 4; l++ {
			for let m = 0; m < 8; m++ {
				let f = formatBits((levelBits[l] << 3) | m, 0x5412)
				let d = bitDistance(fa, f).min(bitDistance(fb, f))
				continue when d >= bestD
				bestD = d
				found = (l << 3) | m
			}
		}
		fail "qr: unreadable format information" when found < 0
		let level = found >> 3
		let clean = new Grid(size, 0)
		clean.drawFunctions(version)
		for let k = 0; k < size * size; k++ {
			clean.dark[k] = grid.dark[k] when clean.fn[k] == 0
		}
		clean.applyMask(found & 7)
		let order = clean.dataOrder()
		let total = rawModules(version) / 8
		let raw int[]
		for let k = 0; k < total; k++ {
			let v = 0
			for let j = 0; j < 8; j++ {
				v = (v << 1) | int(clean.dark[order[k * 8 + j]])
			}
			raw.push(v)
		}

		// Undo the interleaving, correct each block, join the data.
		let blocks = eccBlocks[level][version]
		let ecc = eccPerBlock[level][version]
		let shortLen = total / blocks
		let shortCount = blocks - total % blocks
		let words int[][]
		for let b = 0; b < blocks; b++ {
			let block int[]
			block.len(shortLen + (b >= shortCount ?? (1, 0)))
			words.push(block)
		}
		let at = 0
		for let k = 0; k <= shortLen - ecc; k++ {
			for let b = 0; b < blocks; b++ {
				let dataLen = shortLen - ecc + (b >= shortCount ?? (1, 0))
				continue when k >= dataLen
				words[b][k] = raw[at]
				at++
			}
		}
		for let k = 0; k < ecc; k++ {
			for let b = 0; b < blocks; b++ {
				let dataLen = shortLen - ecc + (b >= shortCount ?? (1, 0))
				words[b][dataLen + k] = raw[at]
				at++
			}
		}
		let rs = new ReedSolomon(qrField, ecc)
		let bits byte[]
		for let b = 0; b < blocks; b++ {
			let block = words[b]
			try rs.correct(block)
			let dataLen = block.len() - ecc
			for let k = 0; k < dataLen; k++ {
				for let j = 7; j >= 0; j-- {
					bits.push(byte((block[k] >> j) & 1))
				}
			}
		}
		return parseSegments(bits, version, 0)
	}
}
