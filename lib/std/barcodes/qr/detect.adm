internal partial module std.barcodes.qr.coding {
	use (
		std.barcodes::*
		std.barcodes.scan::*
		std.math.geom::(Point)
		std.math
	)

	// A finder pattern candidate: centre, module size, and how many scans
	// confirmed it.
	struct Finder {
		x     float
		y     float
		size  float
		count int
	}

	// Three finders that may frame a symbol, with how far they are from a
	// right isosceles triangle.
	struct Triple {
		err     float
		i, j, k int
	}

	// A decoded symbol found in an image.
	struct Found {
		content Content
		micro   bool
		corners Point[]
	}

	// Whether five run lengths look like a finder pattern, 1:1:3:1:1.
	def finderRatio(s int[]) bool {
		let total = 0
		for let v in s {
			return false when v == 0
			total += v
		}
		return false when total < 7
		let m = float(total) / 7.0
		let tol = m / 2.0
		return (m - float(s[0])).abs() < tol && (m - float(s[1])).abs() < tol && (3.0 * m - float(s[2])).abs() < 3.0 * tol && (m - float(s[3])).abs() < tol && (m - float(s[4])).abs() < tol
	}

	def centerFromEnd(s int[], end int) float {
		return float(end - s[4] - s[3]) - float(s[2]) / 2.0
	}

	// Re-measures a finder candidate along a column (vertical) or row
	// through (cx, cy); the centre along that line, or -1.
	def crossCheck(img BitGrid, cx, cy int, vertical bool, maxCount int, originalTotal int) float {
		let limit = vertical ?? (img.height, img.width)
		let at = (k int) => vertical ?? (img.dark(cx, k), img.dark(k, cy))
		let s = int[0, 0, 0, 0, 0]
		let start = vertical ?? (cy, cx)
		let i = start
		for i >= 0 && at(i) {
			s[2]++
			i--
		}
		return -1.0 when i < 0
		for i >= 0 && !at(i) && s[1] <= maxCount {
			s[1]++
			i--
		}
		return -1.0 when i < 0 || s[1] > maxCount
		for i >= 0 && at(i) && s[0] <= maxCount {
			s[0]++
			i--
		}
		return -1.0 when s[0] > maxCount
		i = start + 1
		for i < limit && at(i) {
			s[2]++
			i++
		}
		return -1.0 when i == limit
		for i < limit && !at(i) && s[3] < maxCount {
			s[3]++
			i++
		}
		return -1.0 when i == limit || s[3] >= maxCount
		for i < limit && at(i) && s[4] < maxCount {
			s[4]++
			i++
		}
		return -1.0 when s[4] >= maxCount
		let total = s[0] + s[1] + s[2] + s[3] + s[4]
		return -1.0 when 5 * (total - originalTotal).abs() >= 2 * originalTotal
		return finderRatio(s) ?? (centerFromEnd(s, i), -1.0)
	}

	// Every finder pattern in the image.
	def findFinders(img BitGrid) Finder[] {
		let centers Finder[]
		let step = (img.height / 400).max(1)
		for let i = 0; i < img.height; i += step {
			let s = int[0, 0, 0, 0, 0]
			let state = 0
			for let j = 0; j <= img.width; j++ {
				let dark = j < img.width && img.dark(j, i)
				if dark {
					state++ when (state & 1) == 1
					s[state]++
					continue
				}
				if (state & 1) == 1 {
					s[state]++
					continue
				}
				if state < 4 {
					state++
					s[state]++
					continue
				}
				if finderRatio(s) && confirm(img, s, i, j, centers) {
					s = int[0, 0, 0, 0, 0]
					state = 0
					continue
				}
				s = int[s[2], s[3], s[4], 1, 0]
				state = 3
			}
		}
		return centers
	}

	// Checks a row candidate across and adds or merges it into centers.
	def confirm(img BitGrid, s int[], row int, end int, centers Finder[]) bool {
		let total = s[0] + s[1] + s[2] + s[3] + s[4]
		let cx = centerFromEnd(s, end)
		let cy = crossCheck(img, int(cx), row, true, s[2], total)
		return false when cy < 0.0
		cx = crossCheck(img, int(cx), int(cy), false, s[2], total)
		return false when cx < 0.0
		let size = float(total) / 7.0
		for let k = 0; k < centers.len(); k++ {
			let c = centers[k]
			continue when (cy - c.y).abs() > size || (cx - c.x).abs() > size
			continue when (size - c.size).abs() > 1.0 && (size - c.size).abs() > c.size
			let n = float(c.count)
			centers[k] = Finder{x: (c.x * n + cx) / (n + 1.0), y: (c.y * n + cy) / (n + 1.0), size: (c.size * n + size) / (n + 1.0), count: c.count + 1}
			return true
		}
		centers.push(Finder{x: cx, y: cy, size: size, count: 1})
		return true
	}

	def distance(a, b Finder) float {
		let dx = a.x - b.x
		let dy = a.y - b.y
		return math.sqrt(dx * dx + dy * dy)
	}

	// Orders three finders as bottom-left, top-left, top-right.
	def ordered(p0, p1, p2 Finder) (Finder, Finder, Finder) {
		let d01 = distance(p0, p1)
		let d12 = distance(p1, p2)
		let d02 = distance(p0, p2)
		let a = p1
		let b = p0
		let c = p2
		if d02 >= d12 && d02 >= d01 {
			a = p0
			b = p1
			c = p2
		} else if d01 >= d12 && d01 >= d02 {
			a = p0
			b = p2
			c = p1
		}
		let cross = (c.x - b.x) * (a.y - b.y) - (c.y - b.y) * (a.x - b.x)
		return cross < 0.0 ?? ((c, b, a), (a, b, c))
	}

	// Looks for an alignment pattern (dark module ringed light, ringed dark)
	// near (ex, ey); none when there is none within allowance modules.
	def findAlignment(img BitGrid, size float, ex, ey int, allowance int) ?Finder {
		let reach = int(float(allowance) * size)
		let left = (ex - reach).max(0)
		let right = (ex + reach).min(img.width - 1)
		let top = (ey - reach).max(0)
		let bottom = (ey + reach).min(img.height - 1)
		return none when float(right - left) < size * 3.0 || float(bottom - top) < size * 3.0
		let seen Finder[]
		let rows = bottom - top
		let mid = top + rows / 2
		for let g = 0; g < rows; g++ {
			let i = mid + ((g & 1) == 0 ?? ((g + 1) / 2, -((g + 1) / 2)))
			continue when i < top || i > bottom
			let s = int[0, 0, 0]
			let j = left
			for j < right && !img.dark(j, i) {
				j++
			}
			let state = 0
			for j <= right {
				if j < right && img.dark(j, i) {
					if state == 1 {
						s[1]++
					} else if state == 2 {
						let hit = alignmentAt(img, s, i, j, size, seen)
						return hit unless hit is none
						s = int[s[2], 1, 0]
						state = 1
					} else {
						state++
						s[state]++
					}
				} else {
					state++ when state == 1
					s[state]++ when j < right
					if j == right && state == 2 {
						let hit = alignmentAt(img, s, i, j, size, seen)
						return hit unless hit is none
					}
				}
				j++
			}
		}
		return none when seen.len() == 0
		return seen[0]
	}

	def alignmentRatio(s int[], size float) bool {
		let tol = size / 2.0
		for let v in s {
			return false when (size - float(v)).abs() >= tol
		}
		return true
	}

	// A candidate seen twice is confirmed; the first sighting is kept in seen.
	def alignmentAt(img BitGrid, s int[], row int, end int, size float, seen Finder[]) ?Finder {
		return none when !alignmentRatio(s, size)
		let total = s[0] + s[1] + s[2]
		let cx = float(end - s[2]) - float(s[1]) / 2.0
		let max = 2 * s[1]
		let v = int[0, 0, 0]
		let i = row
		let x = int(cx)
		for i >= 0 && img.dark(x, i) && v[1] <= max {
			v[1]++
			i--
		}
		return none when i < 0 || v[1] > max
		for i >= 0 && !img.dark(x, i) && v[0] <= max {
			v[0]++
			i--
		}
		return none when v[0] > max
		i = row + 1
		for i < img.height && img.dark(x, i) && v[1] <= max {
			v[1]++
			i++
		}
		return none when i == img.height || v[1] > max
		for i < img.height && !img.dark(x, i) && v[2] <= max {
			v[2]++
			i++
		}
		return none when v[2] > max
		let vt = v[0] + v[1] + v[2]
		return none when 5 * (vt - total).abs() >= 2 * total || !alignmentRatio(v, size)
		let cy = float(i - v[2]) - float(v[1]) / 2.0
		let est = float(total) / 3.0
		for let c in seen {
			return Finder{x: (c.x + cx) / 2.0, y: (c.y + cy) / 2.0, size: (c.size + est) / 2.0, count: 2} when (cy - c.y).abs() <= est && (cx - c.x).abs() <= est
		}
		seen.push(Finder{x: cx, y: cy, size: est, count: 1})
		return none
	}

	// Length of the dark-light-dark run from (fromX, fromY) towards
	// (toX, toY), along a Bresenham line; -1 when the line ends first.
	def runLength(img BitGrid, fromX, fromY, toX, toY int) float {
		let steep = (toY - fromY).abs() > (toX - fromX).abs()
		let x0 = steep ?? (fromY, fromX)
		let y0 = steep ?? (fromX, fromY)
		let x1 = steep ?? (toY, toX)
		let y1 = steep ?? (toX, toY)
		let dx = (x1 - x0).abs()
		let dy = (y1 - y0).abs()
		let err = -dx / 2
		let xstep = x0 < x1 ?? (1, -1)
		let ystep = y0 < y1 ?? (1, -1)
		let state = 0
		let y = y0
		let x = x0
		for x != x1 + xstep {
			let rx = steep ?? (y, x)
			let ry = steep ?? (x, y)
			if (state == 1) == img.dark(rx, ry) {
				if state == 2 {
					let ddx = float(x - x0)
					let ddy = float(y - y0)
					return math.sqrt(ddx * ddx + ddy * ddy)
				}
				state++
			}
			err += dy
			if err > 0 {
				break when y == y1
				y += ystep
				err -= dx
			}
			x += xstep
		}
		if state == 2 {
			let ddx = float(x1 + xstep - x0)
			let ddy = float(y1 - y0)
			return math.sqrt(ddx * ddx + ddy * ddy)
		}
		return -1.0
	}

	// The dark-light-dark run through (fromX, fromY) both ways along the
	// line to (toX, toY), clipped to the image: 7 modules across a finder.
	def runBothWays(img BitGrid, fromX, fromY, toX, toY int) float {
		let result = runLength(img, fromX, fromY, toX, toY)
		let scale = 1.0
		let otherX = fromX - (toX - fromX)
		if otherX < 0 {
			scale = float(fromX) / float(fromX - otherX)
			otherX = 0
		} else if otherX >= img.width {
			scale = float(img.width - 1 - fromX) / float(otherX - fromX)
			otherX = img.width - 1
		}
		let otherY = int(float(fromY) - float(toY - fromY) * scale)
		scale = 1.0
		if otherY < 0 {
			scale = float(fromY) / float(fromY - otherY)
			otherY = 0
		} else if otherY >= img.height {
			scale = float(img.height - 1 - fromY) / float(otherY - fromY)
			otherY = img.height - 1
		}
		otherX = int(float(fromX) + float(otherX - fromX) * scale)
		let back = runLength(img, fromX, fromY, otherX, otherY)
		return -1.0 when result < 0.0 || back < 0.0
		return result + back - 1.0
	}

	// Module size measured across finder a towards b and across b towards a.
	def moduleSizeOneWay(img BitGrid, a, b Finder) float {
		let e1 = runBothWays(img, int(a.x), int(a.y), int(b.x), int(b.y))
		let e2 = runBothWays(img, int(b.x), int(b.y), int(a.x), int(a.y))
		return e2 / 7.0 when e1 < 0.0
		return e1 / 7.0 when e2 < 0.0
		return (e1 + e2) / 14.0
	}

	// Samples and reads the symbol three finders frame; none when it does
	// not decode.
	def readTriple(img BitGrid, bl, tl, tr Finder) ?Found {
		let size = (moduleSizeOneWay(img, tl, tr) + moduleSizeOneWay(img, tl, bl)) / 2.0
		size = (bl.size + tl.size + tr.size) / 3.0 when size <= 0.0
		let across = int((distance(tl, tr) / size).round())
		let down = int((distance(tl, bl) / size).round())
		let base = (across + down) / 2 + 7
		for let dim in int[base, base + 1, base - 1, base + 2, base - 2] {
			continue when dim < 21 || dim > 177 || (dim - 17) % 4 != 0
			let found = readAt(img, bl, tl, tr, size, dim)
			return found unless found is none
		}
		return none
	}

	// Reads a dim x dim symbol framed by the finders: first through a
	// homography fitted to the finders' outer corners (and the alignment
	// pattern), then through the finder centres and the alignment pattern,
	// then through the centres alone.
	def readAt(img BitGrid, bl, tl, tr Finder, size float, dim int) ?Found {
		let version = (dim - 17) / 4
		let brx = tr.x - tl.x + bl.x
		let bry = tr.y - tl.y + bl.y
		let far = float(dim) - 3.5
		let align ?Finder = none
		if version >= 2 {
			let correction = 1.0 - 3.0 / float(dim - 7)
			let ex = int(tl.x + correction * (brx - tl.x))
			let ey = int(tl.y + correction * (bry - tl.y))
			for let allowance in int[4, 8, 16] {
				align = findAlignment(img, size, ex, ey, allowance)
				break unless align is none
			}
		}
		let span = float(dim - 7)
		let ux = (tr.x - tl.x) / span
		let uy = (tr.y - tl.y) / span
		let vx = (bl.x - tl.x) / span
		let vy = (bl.y - tl.y) / span
		let mx float[]
		let my float[]
		let ix float[]
		let iy float[]
		let d = float(dim)
		let originX = [0.0, d - 7.0, 0.0]
		let originY = [0.0, 0.0, d - 7.0]
		let centers = [tl, tr, bl]
		let cornerX = [0.0, 7.0, 7.0, 0.0]
		let cornerY = [0.0, 0.0, 7.0, 7.0]
		for let k = 0; k < 3; k++ {
			let f = centers[k]
			let c = finderCorners(img, f, ux, uy, vx, vy)
			for let q = 0; q < 4; q++ {
				mx.push(originX[k] + cornerX[q])
				my.push(originY[k] + cornerY[q])
				ix.push(c[2 * q])
				iy.push(c[2 * q + 1])
			}
			mx.push(originX[k] + 3.5)
			my.push(originY[k] + 3.5)
			ix.push(f.x)
			iy.push(f.y)
		}
		let maps Perspective[]
		if !(align is none) {
			let al = align
			mx.push(far - 3.0)
			my.push(far - 3.0)
			ix.push(al.x)
			iy.push(al.y)
		}
		let fitted = fitHomography(mx, my, ix, iy)
		maps.push(fitted) unless fitted is none
		if !(align is none) {
			let al = align
			maps.push(quadToQuad([3.5, 3.5, far, 3.5, far - 3.0, far - 3.0, 3.5, far], [tl.x, tl.y, tr.x, tr.y, al.x, al.y, bl.x, bl.y]))
		}
		maps.push(quadToQuad([3.5, 3.5, far, 3.5, far, far, 3.5, far], [tl.x, tl.y, tr.x, tr.y, brx, bry, bl.x, bl.y]))
		for let p in maps {
			let found = sampleAndRead(img, p, dim, false)
			return found unless found is none
		}
		return none
	}

	// Samples a size x size grid through p and reads it.
	def sampleAndRead(img BitGrid, p Perspective, size int, micro bool) ?Found {
		let cells = sampleGrid(img, size, size, p)
		return none when cells is none
		let grid = cells
		let sym = new Symbol(micro ?? (Symbology.MicroQr, Symbology.Qr), size, size)
		for let y = 0; y < size; y++ {
			for let x = 0; x < size; x++ {
				sym.dark(x, y, grid[y * size + x] != 0)
			}
		}
		return none when micro && !microTiming(sym)
		let content = readGrid(sym) onerror recover Content{count: -1}
		return none when content.count < 0
		return Found{content: content, micro: micro, corners: cornersOf(p, float(size), float(size))}
	}

	// The image corners of a symbol dim modules across under a map.
	def cornersOf(p Perspective, w, h float) Point[] {
		let xs = [0.0, w, w, 0.0]
		let ys = [0.0, 0.0, h, h]
		let out Point[]
		for let k = 0; k < 4; k++ {
			let (px, py) = p.map(xs[k], ys[k])
			out.push(new Point(px, py))
		}
		return out
	}

	// Tries a Micro QR symbol around a lone finder: finds the finder's
	// orientation from its outer corners, then tries each quarter turn and
	// each size, keeping the first that decodes.
	def readMicro(img BitGrid, f Finder) ?Found {
		// The orientation whose four corner directions reach farthest.
		let bestAngle = 0.0
		let best = 0.0
		for let k = 0; k < 90; k++ {
			let phi = float(k) * 3.14159265358979 / 180.0
			let r = 0.0
			for let q = 0; q < 4; q++ {
				r += reach(img, f, phi + 3.14159265358979 / 4.0 + float(q) * 3.14159265358979 / 2.0)
			}
			continue when r <= best
			best = r
			bestAngle = phi
		}
		let axis = bestAngle
		let unit = best / 4.0 / (3.5 * 1.41421356)
		for let turn = 0; turn < 4; turn++ {
			let a = axis + float(turn) * 3.14159265358979 / 2.0
			let ux = math.cos(a) * unit
			let uy = math.sin(a) * unit
			let vx = -uy
			let vy = ux
			let ox = f.x - 3.5 * ux - 3.5 * vx
			let oy = f.y - 3.5 * uy - 3.5 * vy
			let affine = new Perspective(ux, vx, ox, uy, vy, oy, 0.0, 0.0, 1.0)
			let c = finderCorners(img, f, ux, uy, vx, vy)
			let mx = [0.0, 7.0, 7.0, 0.0, 3.5]
			let my = [0.0, 0.0, 7.0, 7.0, 3.5]
			let ix = [c[0], c[2], c[4], c[6], f.x]
			let iy = [c[1], c[3], c[5], c[7], f.y]
			let first = fitHomography(mx, my, ix, iy)
			let p = affine
			if !(first is none) {
				let q = first
				p = q
			}
			// The timing patterns fix the size and the far edges.
			let across = traceTiming(img, p, true)
			let down = traceTiming(img, p, false)
			let sizes int[]
			if across.len() >= 4 && across.len() == down.len() {
				let count = across.len() / 2
				sizes.push(2 * count + 7)
				for let k = 0; k < count; k++ {
					mx.push(8.5 + 2.0 * float(k))
					my.push(0.5)
					ix.push(across[2 * k])
					iy.push(across[2 * k + 1])
					mx.push(0.5)
					my.push(8.5 + 2.0 * float(k))
					ix.push(down[2 * k])
					iy.push(down[2 * k + 1])
				}
			}
			let maps Perspective[]
			let fitted = fitHomography(mx, my, ix, iy)
			maps.push(fitted) unless fitted is none
			maps.push(p)
			maps.push(affine)
			for let size in int[11, 13, 15, 17] {
				sizes.push(size) when !sizes.includes(size)
			}
			for let map in maps {
				for let size in sizes {
					let found = sampleAndRead(img, map, size, true)
					return found unless found is none
				}
			}
		}
		return none
	}

	// How far the dark ring of finder f reaches along a ray at angle, in
	// pixels: the ray walks out of the dark core, across the light ring and
	// the dark ring, and stops at the light beyond. -1 when it does not
	// find that within 10 module sizes.
	def reach(img BitGrid, f Finder, angle float) float {
		let dx = math.cos(angle)
		let dy = math.sin(angle)
		let limit = f.size * 10.0
		let state = 0
		let r = 0.0
		for r < limit {
			let dark = img.dark(int(f.x + dx * r), int(f.y + dy * r))
			if dark == (state % 2 == 1) {
				state++
				return r when state == 3
			}
			r += 0.25
		}
		return -1.0
	}

	// The outer corners of a finder in the order (-u -v), (+u -v), (+u +v),
	// (-u +v), as x, y pairs; each is the farthest reach of the dark ring
	// within 25 degrees of the direction the axes put it in.
	def finderCorners(img BitGrid, f Finder, ux, uy, vx, vy float) float[] {
		let out float[]
		let sus = [-1.0, 1.0, 1.0, -1.0]
		let svs = [-1.0, -1.0, 1.0, 1.0]
		for let q = 0; q < 4; q++ {
			let su = sus[q]
			let sv = svs[q]
			let base = math.atan2(su * uy + sv * vy, su * ux + sv * vx)
			let best = 0.0
			let bestAngle = base
			for let k = -25; k <= 25; k++ {
				let a = base + float(k) * 3.14159265358979 / 180.0
				let r = reach(img, f, a)
				continue when r <= best
				best = r
				bestAngle = a
			}
			out.push(f.x + math.cos(bestAngle) * best)
			out.push(f.y + math.sin(bestAngle) * best)
		}
		return out
	}

	// The image centres of the dark timing modules of a Micro QR symbol,
	// along the top row (across) or the left column, as x, y pairs: walks the
	// line through the middle of that row or column from the separator on
	// until a light stretch longer than two modules ends the pattern.
	def traceTiming(img BitGrid, p Perspective, across bool) float[] {
		let (sx, sy) = across ?? (p.map(7.5, 0.5), p.map(0.5, 7.5))
		let (ex, ey) = across ?? (p.map(8.5, 0.5), p.map(0.5, 8.5))
		let dx = ex - sx
		let dy = ey - sy
		let pitch = math.sqrt(dx * dx + dy * dy)
		let out float[]
		return out when pitch < 0.5
		dx = dx / pitch
		dy = dy / pitch
		let t = 0.0
		let limit = pitch * 14.0
		let runStart = -1.0
		let lightFrom = 0.0
		for t < limit {
			let dark = img.dark(int(sx + dx * t), int(sy + dy * t))
			if dark && runStart < 0.0 {
				runStart = t
			} else if !dark && runStart >= 0.0 {
				let mid = (runStart + t) / 2.0
				out.push(sx + dx * mid)
				out.push(sy + dy * mid)
				runStart = -1.0
				lightFrom = t
			} else if !dark && t - lightFrom > pitch * 2.2 {
				break
			}
			t += 0.25
		}
		return out
	}

	// Whether the timing patterns along the top row and left column
	// alternate, and the module past them is the quiet zone.
	def microTiming(sym Symbol) bool {
		let wrong = 0
		for let i = 8; i < sym.width; i++ {
			wrong += sym.dark(i, 0) != (i % 2 == 0) ?? (1, 0)
			wrong += sym.dark(0, i) != (i % 2 == 0) ?? (1, 0)
		}
		return wrong <= 1
	}

	// Every QR Code and Micro QR symbol in a binarized image.
	def detectAll(img BitGrid) Found[] {
		let finders = findFinders(img)
		let out Found[]
		let used byte[]
		used.len(finders.len())
		used.fill(0)
		let n = finders.len()
		// Candidate triples, closest to a right isosceles triangle first.
		let triples Triple[]
		for let i = 0; i < n; i++ {
			for let j = i + 1; j < n; j++ {
				for let k = j + 1; k < n; k++ {
					let a = finders[i]
					let b = finders[j]
					let c = finders[k]
					let lo = a.size.min(b.size).min(c.size)
					let hi = a.size.max(b.size).max(c.size)
					continue when hi > lo * 1.5
					let (bl, tl, tr) = ordered(a, b, c)
					let d1 = distance(tl, tr)
					let d2 = distance(tl, bl)
					let d3 = distance(bl, tr)
					continue when d1 < tl.size * 8.0 || d2 < tl.size * 8.0
					let ratio = d1 / d2
					continue when ratio < 0.5 || ratio > 2.0
					let diag = math.sqrt(d1 * d1 + d2 * d2)
					let err = (d3 - diag).abs() / diag + (ratio - 1.0).abs()
					continue when (d3 - diag).abs() / diag > 0.25
					triples.push(Triple{err: err, i: i, j: j, k: k})
				}
			}
		}
		triples.sort((x, y) => x.err < y.err)
		for let t in triples {
			let i = t.i
			let j = t.j
			let k = t.k
			continue when used[i] != 0 || used[j] != 0 || used[k] != 0
			let (bl, tl, tr) = ordered(finders[i], finders[j], finders[k])
			let hit = readTriple(img, bl, tl, tr)
			continue when hit is none
			out.push(hit)
			used[i] = 1
			used[j] = 1
			used[k] = 1
		}
		for let i = 0; i < n; i++ {
			continue when used[i] != 0
			let hit = readMicro(img, finders[i])
			continue when hit is none
			out.push(hit)
			used[i] = 1
		}
		return out
	}
}
