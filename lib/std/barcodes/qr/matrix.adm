internal partial module std.barcodes.qr.coding {
	// Grid is a square module matrix under construction or being read, with
	// a flag for each module that belongs to a function pattern.
	type Grid {
		size  int
		// 0 for QR Code, else the Micro QR version 1 to 4.
		micro int
		dark  byte[]
		fn    byte[]

		def new(size int, micro int) {
			self.size = size
			self.micro = micro
			dark.len(size * size)
			dark.fill(0)
			fn.len(size * size)
			fn.fill(0)
		}

		def at(x, y int) bool {
			return dark[y * size + x] != 0
		}

		def put(x, y int, on bool) {
			dark[y * size + x] = on ?? (1, 0)
		}

		// Sets a function module.
		def function(x, y int, on bool) {
			return when x < 0 || y < 0 || x >= size || y >= size
			dark[y * size + x] = on ?? (1, 0)
			fn[y * size + x] = 1
		}

		def isFunction(x, y int) bool {
			return fn[y * size + x] != 0
		}

		// Draws a finder pattern centred at (cx, cy) with its separator.
		def finder(cx, cy int) {
			for let dy = -4; dy <= 4; dy++ {
				for let dx = -4; dx <= 4; dx++ {
					let d = dx.abs().max(dy.abs())
					function(cx + dx, cy + dy, d != 2 && d != 4)
				}
			}
		}

		// Draws the function patterns of a QR Code version, format and
		// version areas reserved (light).
		def drawFunctions(version int) {
			if micro > 0 {
				finder(3, 3)
				for let i = 8; i < size; i++ {
					function(i, 0, i % 2 == 0)
					function(0, i, i % 2 == 0)
				}
				for let i = 1; i <= 8; i++ {
					function(i, 8, false)
					function(8, i, false)
				}
				return
			}
			for let i = 0; i < size; i++ {
				function(6, i, i % 2 == 0)
				function(i, 6, i % 2 == 0)
			}
			finder(3, 3)
			finder(size - 4, 3)
			finder(3, size - 4)
			let align = alignmentPositions(version)
			let n = align.len()
			for let i = 0; i < n; i++ {
				for let j = 0; j < n; j++ {
					continue when (i == 0 && j == 0) || (i == 0 && j == n - 1) || (i == n - 1 && j == 0)
					for let dy = -2; dy <= 2; dy++ {
						for let dx = -2; dx <= 2; dx++ {
							function(align[i] + dx, align[j] + dy, dx.abs().max(dy.abs()) != 1)
						}
					}
				}
			}
			drawFormat(0)
			drawVersion(version) when version >= 7
		}

		// Writes the 15 format bits of a QR Code symbol, both copies.
		def drawFormat(bits int) {
			let bit = (i int) => ((bits >> i) & 1) != 0
			for let i = 0; i <= 5; i++ {
				function(8, i, bit(i))
			}
			function(8, 7, bit(6))
			function(8, 8, bit(7))
			function(7, 8, bit(8))
			for let i = 9; i < 15; i++ {
				function(14 - i, 8, bit(i))
			}
			for let i = 0; i < 8; i++ {
				function(size - 1 - i, 8, bit(i))
			}
			for let i = 8; i < 15; i++ {
				function(8, size - 15 + i, bit(i))
			}
			function(8, size - 8, true)
		}

		// Writes the 15 format bits of a Micro QR symbol.
		def drawMicroFormat(bits int) {
			for let x = 1; x <= 8; x++ {
				function(x, 8, ((bits >> (15 - x)) & 1) != 0)
			}
			for let y = 1; y <= 7; y++ {
				function(8, y, ((bits >> (y - 1)) & 1) != 0)
			}
		}

		// Writes the version information blocks.
		def drawVersion(version int) {
			let bits = versionBits(version)
			for let i = 0; i < 18; i++ {
				let on = ((bits >> i) & 1) != 0
				let a = size - 11 + i % 3
				let b = i / 3
				function(a, b, on)
				function(b, a, on)
			}
		}

		// The format bits of a QR Code symbol as read, both copies.
		def readFormat() (int, int) {
			let a = 0
			let b = 0
			let bit = (x int, y int) => at(x, y) ?? (1, 0)
			for let i = 0; i <= 5; i++ {
				a |= bit(8, i) << i
			}
			a |= bit(8, 7) << 6
			a |= bit(8, 8) << 7
			a |= bit(7, 8) << 8
			for let i = 9; i < 15; i++ {
				a |= bit(14 - i, 8) << i
			}
			for let i = 0; i < 8; i++ {
				b |= bit(size - 1 - i, 8) << i
			}
			for let i = 8; i < 15; i++ {
				b |= bit(8, size - 15 + i) << i
			}
			return (a, b)
		}

		// The format bits of a Micro QR symbol as read.
		def readMicroFormat() int {
			let v = 0
			for let x = 1; x <= 8; x++ {
				v |= (at(x, 8) ?? (1, 0)) << (15 - x)
			}
			for let y = 1; y <= 7; y++ {
				v |= (at(8, y) ?? (1, 0)) << (y - 1)
			}
			return v
		}

		// Visits the data modules in placement order: two-column strips from
		// the right, alternately upwards and downwards, skipping the vertical
		// timing pattern of QR Code.
		def dataOrder() int[] {
			let out int[]
			let right = size - 1
			for right >= 1 {
				right = 5 when micro == 0 && right == 6
				let upward = micro == 0 ?? (((right + 1) & 2) == 0, ((size - 1 - right) / 2) % 2 == 0)
				for let v = 0; v < size; v++ {
					let y = upward ?? (size - 1 - v, v)
					for let j = 0; j < 2; j++ {
						let x = right - j
						continue when isFunction(x, y)
						out.push(y * size + x)
					}
				}
				right -= 2
			}
			return out
		}

		// Flips the data modules the mask selects.
		def applyMask(mask int) {
			for let y = 0; y < size; y++ {
				for let x = 0; x < size; x++ {
					continue when isFunction(x, y)
					let flip = micro == 0 ?? (maskBit(mask, x, y), maskBit(int[1, 4, 6, 7][mask], x, y))
					dark[y * size + x] = dark[y * size + x] ^ 1 when flip
				}
			}
		}

		// The QR Code penalty score of the current modules (lower is better).
		def penalty() int {
			let score = 0
			for let horizontal in [true, false] {
				for let a = 0; a < size; a++ {
					let run = 0
					let last = false
					let window = 0
					for let b = 0; b < size; b++ {
						let on = horizontal ?? (at(b, a), at(a, b))
						if b > 0 && on == last {
							run++
						} else {
							score += 3 + run - 5 when run >= 5
							run = 1
						}
						last = on
						window = ((window << 1) | (on ?? (1, 0))) & 0x7ff
						score += 40 when b >= 10 && (window == 0x5d0 || window == 0x05d)
					}
					score += 3 + run - 5 when run >= 5
				}
			}
			let darkCount = 0
			for let y = 0; y < size; y++ {
				for let x = 0; x < size; x++ {
					darkCount += at(x, y) ?? (1, 0)
					continue when x == size - 1 || y == size - 1
					let c = at(x, y)
					score += 3 when at(x + 1, y) == c && at(x, y + 1) == c && at(x + 1, y + 1) == c
				}
			}
			let total = size * size
			let k = ((darkCount * 20 - total * 10).abs() + total - 1) / total - 1
			score += k * 10
			return score
		}

		// The Micro QR mask score (higher is better): dark modules along the
		// right and bottom edges.
		def microScore() int {
			let right = 0
			let bottom = 0
			for let i = 1; i < size; i++ {
				right += at(size - 1, i) ?? (1, 0)
				bottom += at(i, size - 1) ?? (1, 0)
			}
			return right.min(bottom) * 16 + right.max(bottom)
		}

		// The grid flipped about its main diagonal.
		def transposed() Grid {
			let g = new Grid(size, micro)
			for let y = 0; y < size; y++ {
				for let x = 0; x < size; x++ {
					g.dark[x * size + y] = dark[y * size + x]
				}
			}
			return g
		}
	}

	// Whether QR Code mask pattern k flips module (x, y).
	def maskBit(k int, x, y int) bool {
		switch {
			case k == 0:
				return (x + y) % 2 == 0
			case k == 1:
				return y % 2 == 0
			case k == 2:
				return x % 3 == 0
			case k == 3:
				return (x + y) % 3 == 0
			case k == 4:
				return (x / 3 + y / 2) % 2 == 0
			case k == 5:
				return x * y % 2 + x * y % 3 == 0
			case k == 6:
				return (x * y % 2 + x * y % 3) % 2 == 0
		}
		return ((x + y) % 2 + x * y % 3) % 2 == 0
	}
}
