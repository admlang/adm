partial module std.barcodes.qr {
	// QR Code (ISO/IEC 18004) and Micro QR: encode text or bytes to a
	// `Symbol` (numeric, alphanumeric, byte, kanji and ECI segments; error
	// correction level L/M/Q/H; version and mask chosen unless given;
	// structured append), and decode a sampled module grid back to its data.
	use (
		std.barcodes::*
		std.barcodes.qr.coding::*
		std.barcodes.scan::(Gray, BitGrid)
		std.formats.image::(Image)
	)

	// Level is the share of the symbol that error correction can restore:
	// L about 7%, M 15%, Q 25%, H 30%. Micro QR has L, M and Q (M4 only),
	// and M1 detects errors without correcting them.
	enum Level {
		L
		M
		Q
		H
	}

	// Encodes text as a QR Code, or a Micro QR symbol with micro. The text
	// is split into numeric, alphanumeric, kanji and byte segments, whichever
	// is shortest; byte segments hold UTF-8, announced by ECI 26 when the
	// text is not ASCII (Micro QR has no ECI). version (1 to 40, Micro QR 1
	// to 4) and mask (0 to 7, Micro QR 0 to 3) are chosen when left at 0
	// and -1. Fails when the text does not fit the level (and version), or
	// Micro QR is asked for level H.
	//
	// ```
	// let sym = qr.encode("https://adm-lang.dev", level = Level.Q)!
	// ```
	def encode(text string, level Level = Level.M, version int = 0, mask int = -1, micro bool = false) !Symbol {
		let units = unitsOf(text)
		return build(units, level, version, mask, micro, eciFor(units), Append{})
	}

	// Encodes binary data as a QR Code, or Micro QR with micro, in byte
	// segments (numeric and alphanumeric where the bytes allow). Fails as
	// the text form does.
	def encode(data byte[], level Level = Level.M, version int = 0, mask int = -1, micro bool = false) !Symbol {
		return build(unitsOf(data), level, version, mask, micro, -1, Append{})
	}

	// Splits text over parts QR Code symbols (2 to 16) joined by structured
	// append: a reader puts the pieces back in order whatever order they are
	// scanned in. Fails when parts is out of range or a piece does not fit.
	def sequence(text string, parts int, level Level = Level.M) !Symbol[] {
		expects {
			assert parts >= 2 && parts <= 16 onerror fail "qr: a sequence has 2 to 16 symbols"
		}
		let units = unitsOf(text)
		fail "qr: fewer characters than symbols" when units.len() < parts
		let parity = 0
		for let b in text.bytes() {
			parity = parity ^ int(b)
		}
		let eci = eciFor(units)
		let out Symbol[]
		let per = (units.len() + parts - 1) / parts
		for let k = 0; k < parts; k++ {
			let start = k * per
			let count = (units.len() - start).min(per)
			out.push(try build(units.slice(start, count), level, 0, -1, false, eci, Append{index: k, count: parts, parity: parity}))
		}
		return out
	}

	// Decodes a QR Code or Micro QR module grid (no quiet zone), also when
	// it is mirrored. Fails when the format information or the error
	// correction cannot be read, or the data is malformed.
	def decode(sym Symbol) !Barcode {
		let content = try readGrid(sym)
		let kind = sym.width <= 17 ?? (Symbology.MicroQr, Symbology.Qr)
		return Barcode{symbology: kind, text: content.text, data: content.data}
	}

	// Finds and decodes every QR Code and Micro QR symbol in an image, at
	// any rotation and under perspective, mirrored ones included.
	def decode(img Image) Barcode[] {
		let out Barcode[]
		for let f in detectAll(new BitGrid(new Gray(img))) {
			out.push(Barcode{symbology: f.micro ?? (Symbology.MicroQr, Symbology.Qr), text: f.content.text, data: f.content.data, corners: f.corners})
		}
		return out
	}

	internal def build(units Unit[], level Level, version int, mask int, micro bool, eci int, append Append) !Symbol {
		let l = levelIndex(level)
		if micro {
			fail "qr: Micro QR has no level H" when l == 3
			fail "qr: Micro QR versions are 1 to 4" when version < 0 || version > 4
			fail "qr: Micro QR masks are 0 to 3" when mask < -1 || mask > 3
			return buildMicro(units, l, version, mask)
		}
		fail "qr: versions are 1 to 40" when version < 0 || version > 40
		fail "qr: masks are 0 to 7" when mask < -1 || mask > 7
		return buildQr(units, l, version, mask, eci, append)
	}

	internal def levelIndex(level Level) int {
		match level {
			case Level.L:
				return 0
			case Level.M:
				return 1
			case Level.Q:
				return 2
			case Level.H:
				return 3
		}
	}

	// ECI 26 (UTF-8) when a character outside ASCII will go in a byte segment.
	internal def eciFor(units Unit[]) int {
		for let u in units {
			return 26 when u.value >= 128 && u.sjis == 0
		}
		return -1
	}
}
