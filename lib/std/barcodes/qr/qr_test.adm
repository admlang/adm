partial module std.barcodes.qr {
	use (
		std.testing
		std.barcodes::*
		std.barcodes.qr.coding::*
		std.formats.image::(Image)
	)

	// The symbol turned a quarter turn clockwise.
	def turned(sym Symbol) Symbol {
		let out = new Symbol(sym.symbology, sym.height, sym.width, sym.quietZone)
		for let y = 0; y < sym.height; y++ {
			for let x = 0; x < sym.width; x++ {
				out.dark(sym.height - 1 - y, x, sym.dark(x, y))
			}
		}
		return out
	}

	// Two images side by side on white.
	def sideBySide(a, b Image) Image {
		let w = int(a.size().width) + int(b.size().width)
		let h = int(a.size().height).max(int(b.size().height))
		let out = new Image(w, h)
		let px = out.raw()
		px.fill(255)
		let left = 0
		for let img in [a, b] {
			let src = img.raw()
			for let y = 0; y < int(img.size().height); y++ {
				for let x = 0; x < int(img.size().width) * 4; x++ {
					px[y * out.stride() + left * 4 + x] = src[y * img.stride() + x]
				}
			}
			left += int(img.size().width)
		}
		return out
	}

	check "QrCode" {
		@test()
		def TestRoundTrip() !none {
			let texts = ["HELLO WORLD", "01234567890123456789", "https://adm-lang.dev/?q=1", "Grüße, 世界", "点茗 kanji 漢字テスト", "a"]
			for let level in [Level.L, Level.M, Level.Q, Level.H] {
				for let text in texts {
					let sym = try encode(text, level = level)
					let back = try decode(sym)
					fail "{level} '{text}' read '{back.text}'" when back.text != text || back.symbology != Symbology.Qr
				}
			}
			let bin = byte[0, 1, 2, 250, 255, 48, 49]
			let back = try decode(try encode(bin))
			assert back.data.hex() == bin.hex()
		}

		@test()
		def TestVersionAndMask() !none {
			let sym = try encode("HELLO WORLD", level = Level.Q, version = 7, mask = 3)
			assert sym.width == 45
			assert (try decode(sym)).text == "HELLO WORLD"
			let tooSmall = false
			encode("0123456789012345678901234567890123456789", level = Level.H, version = 1) onerror (err error) {
				tooSmall = true
				recover new Symbol(Symbology.Qr, 1, 1)
			}
			assert tooSmall
			// Version 40-L holds 2953 bytes.
			let big = try encode("x".repeat(2953), level = Level.L)
			assert big.width == 177
		}

		@test()
		def TestMicro() !none {
			let cases = ["12345", "HELLO WORLD", "hello", "0123456789012345678901234567890123"]
			for let text in cases {
				let sym = try encode(text, level = Level.L, micro = true)
				assert sym.width <= 17
				let back = try decode(sym)
				fail "micro '{text}' read '{back.text}'" when back.text != text || back.symbology != Symbology.MicroQr
			}
			assert (try encode("12345", level = Level.L, micro = true)).width == 11
			assert (try decode(try encode("HELLO", level = Level.Q, micro = true))).text == "HELLO"
			let noH = false
			encode("1", level = Level.H, micro = true) onerror (err error) {
				noH = true
				recover new Symbol(Symbology.Qr, 1, 1)
			}
			assert noH
		}

		@test()
		def TestErrorCorrection() !none {
			let sym = try encode("error correction at level H", level = Level.H)
			// Damage a band of data modules, well under 30% of the codewords.
			for let y = 10; y < 14; y++ {
				for let x = 9; x < 21; x++ {
					sym.dark(x, y, !sym.dark(x, y))
				}
			}
			assert (try decode(sym)).text == "error correction at level H"
			let mirrored = try encode("mirror", level = Level.M)
			let flipped = new Symbol(Symbology.Qr, mirrored.width, mirrored.height)
			for let y = 0; y < mirrored.height; y++ {
				for let x = 0; x < mirrored.width; x++ {
					flipped.dark(y, x, mirrored.dark(x, y))
				}
			}
			assert (try decode(flipped)).text == "mirror"
		}

		@test()
		def TestSequence() !none {
			let parts = try sequence("structured append joins these pieces", 3)
			assert parts.len() == 3
			let joined = ""
			for let (k, sym) in parts {
				let content = try readGrid(sym)
				assert content.index == k && content.count == 3
				joined += content.text
			}
			assert joined == "structured append joins these pieces"
		}

		@test()
		def TestImages() !none {
			let a = try encode("first symbol", level = Level.M)
			let b = try encode("second, turned", level = Level.Q)
			let img = sideBySide(a.toImage(scale = 4), turned(b).toImage(scale = 3))
			let found = decode(img)
			assert found.len() == 2
			let texts = found.mapElem(f => f.text)
			assert texts.includes("first symbol") && texts.includes("second, turned")
			assert found[0].corners.len() == 4
			let micro = try encode("MICRO", level = Level.M, micro = true)
			let small = decode(turned(turned(micro)).toImage(scale = 5))
			assert small.len() == 1 && small[0].text == "MICRO" && small[0].symbology == Symbology.MicroQr
		}
	}
}
