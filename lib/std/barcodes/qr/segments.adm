internal partial module std.barcodes.qr.coding {
	use (
		std.data.encoding.codepages
		std.data.encoding.shiftjis
	)

	// Segment modes, in the order of the mode cost tables.
	const modeByte = 0
	const modeAlnum = 1
	const modeNumeric = 2
	const modeKanji = 3

	// The 45 characters of alphanumeric mode, in value order.
	const alnumChars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"

	// Bits is a growing bit string, most significant bit first.
	type Bits {
		bits byte[]

		// Appends the low n bits of value.
		def add(value int, n int) {
			for let k = n - 1; k >= 0; k-- {
				bits.push(byte((value >> k) & 1))
			}
		}

		def len() int {
			return bits.len()
		}
	}

	// One unit of input: a character (or a byte of binary input) with the
	// bytes byte mode writes for it and its Shift JIS code (0 when none).
	struct Unit {
		value int
		bytes byte[]
		sjis  int
	}

	// Input units of text: its characters with their UTF-8 bytes.
	def unitsOf(text string) Unit[] {
		let out Unit[]
		for let ch in text {
			let c = int(ch)
			let code = shiftjis.encode(ch)
			let kanji = code is none ?? (0, code)
			out.push(Unit{value: c, bytes: string(ch).bytes(), sjis: kanjiCode(kanji) >= 0 ?? (kanji, 0)})
		}
		return out
	}

	// Input units of binary data: one per byte.
	def unitsOf(data byte[]) Unit[] {
		let out Unit[]
		for let b in data {
			out.push(Unit{value: int(b), bytes: byte[b], sjis: 0})
		}
		return out
	}

	// The 13-bit kanji mode value of a Shift JIS code, or -1 when the code
	// is outside the two ranges kanji mode holds.
	def kanjiCode(sjis int) int {
		let v = -1
		switch {
			case sjis >= 0x8140 && sjis <= 0x9ffc: v = sjis - 0x8140
			case sjis >= 0xe040 && sjis <= 0xebbf: v = sjis - 0xc140
		}
		return -1 when v < 0
		let low = v & 0xff
		return -1 when low < 0x40 || low == 0x7f || low > 0xfc
		return (v >> 8) * 0xc0 + low
	}

	def isNumeric(c int) bool {
		return c >= 48 && c <= 57
	}

	def isAlnum(c int) bool {
		return c < 128 && alnumChars.indexOf(string(char(c))) >= 0
	}

	// Whether a mode can hold the unit.
	def modeHolds(mode int, u Unit) bool {
		switch {
			case mode == modeNumeric:
				return isNumeric(u.value)
			case mode == modeAlnum:
				return isAlnum(u.value)
			case mode == modeKanji:
				return u.sjis != 0
		}
		return true
	}

	// Width of the character count field. micro is 0 for QR Code, else the
	// Micro QR version 1 to 4.
	def countBits(mode int, version int, micro int) int {
		if micro > 0 {
			switch {
				case mode == modeNumeric:
					return micro + 2
				case mode == modeAlnum:
					return micro + 1
				case mode == modeByte:
					return micro + 1
			}
			return micro
		}
		let group = version <= 9 ?? (0, version <= 26 ?? (1, 2))
		switch {
			case mode == modeNumeric:
				return int[10, 12, 14][group]
			case mode == modeAlnum:
				return int[9, 11, 13][group]
			case mode == modeByte:
				return int[8, 16, 16][group]
		}
		return int[8, 10, 12][group]
	}

	// The modes a symbol version allows: Micro QR M1 has numeric only, M2
	// adds alphanumeric.
	def modeAllowed(mode int, micro int) bool {
		return true when micro == 0 || micro >= 3
		return mode == modeNumeric when micro == 1
		return mode == modeNumeric || mode == modeAlnum
	}

	// Width of the mode indicator.
	def modeBits(micro int) int {
		return micro == 0 ?? (4, micro - 1)
	}

	// The mode indicator value.
	def modeIndicator(mode int, micro int) int {
		if micro == 0 {
			switch {
				case mode == modeNumeric:
					return 1
				case mode == modeAlnum:
					return 2
				case mode == modeByte:
					return 4
			}
			return 8
		}
		switch {
			case mode == modeNumeric:
				return 0
			case mode == modeAlnum:
				return 1
			case mode == modeByte:
				return 2
		}
		return 3
	}

	// The cheapest mode of every unit for a symbol version, by dynamic
	// programming over the four modes with costs in sixths of a bit.
	def chooseModes(units Unit[], version int, micro int) int[] {
		let n = units.len()
		let modes int[]
		return modes when n == 0
		let big = 1 << 40
		let head int[]
		for let m = 0; m < 4; m++ {
			head += modeAllowed(m, micro) ?? ((modeBits(micro) + countBits(m, version, micro)) * 6, big)
		}
		// cost[i * 4 + m]: units 0..i with unit i in mode m, its segment still
		// open; back[i * 4 + m]: the mode of unit i - 1 on that path.
		let cost int[]
		let back int[]
		cost.len(n * 4)
		back.len(n * 4)
		cost.fill(big)
		back.fill(-1)
		for let i = 0; i < n; i++ {
			let u = units[i]
			for let m = 0; m < 4; m++ {
				continue when head[m] >= big || !modeHolds(m, u)
				let step = 0
				switch {
					case m == modeByte: step = u.bytes.len() * 48
					case m == modeAlnum: step = 33
					case m == modeNumeric: step = 20
					default: step = 78
				}
				if i == 0 {
					cost[m] = head[m] + step
					continue
				}
				for let p = 0; p < 4; p++ {
					let before = cost[(i - 1) * 4 + p]
					continue when before >= big
					let c = p == m ?? (before + step, (before + 5) / 6 * 6 + head[m] + step)
					continue when c >= cost[i * 4 + m]
					cost[i * 4 + m] = c
					back[i * 4 + m] = p
				}
			}
		}
		let m = 0
		for let k = 1; k < 4; k++ {
			m = k when cost[(n - 1) * 4 + k] < cost[(n - 1) * 4 + m]
		}
		modes.len(n)
		for let i = n - 1; i >= 0; i-- {
			modes[i] = m
			m = back[i * 4 + m]
		}
		return modes
	}

	// Whether a mode choice is possible (every unit has a mode).
	def modesValid(modes int[]) bool {
		for let m in modes {
			return false when m < 0
		}
		return true
	}

	// Appends the segments of units with the given modes and returns the
	// bit length, or -1 when a character count does not fit its field.
	def writeSegments(out Bits, units Unit[], modes int[], version int, micro int) int {
		let start = out.len()
		let i = 0
		for i < units.len() {
			let mode = modes[i]
			let j = i
			for j < units.len() && modes[j] == mode {
				j++
			}
			let seg = units.slice(i, j - i)
			let count = seg.len()
			if mode == modeByte {
				count = 0
				for let u in seg {
					count += u.bytes.len()
				}
			}
			return -1 when count >= (1 << countBits(mode, version, micro))
			out.add(modeIndicator(mode, micro), modeBits(micro))
			out.add(count, countBits(mode, version, micro))
			switch {
				case mode == modeNumeric:
					let k = 0
					for k + 3 <= seg.len() {
						out.add((seg[k].value - 48) * 100 + (seg[k + 1].value - 48) * 10 + seg[k + 2].value - 48, 10)
						k += 3
					}
					if seg.len() - k == 2 {
						out.add((seg[k].value - 48) * 10 + seg[k + 1].value - 48, 7)
					} else if seg.len() - k == 1 {
						out.add(seg[k].value - 48, 4)
					}
				case mode == modeAlnum:
					let k = 0
					for k + 2 <= seg.len() {
						out.add(alnumValue(seg[k].value) * 45 + alnumValue(seg[k + 1].value), 11)
						k += 2
					}
					out.add(alnumValue(seg[k].value), 6) when k < seg.len()
				case mode == modeByte:
					for let u in seg {
						for let b in u.bytes {
							out.add(int(b), 8)
						}
					}
				default:
					for let u in seg {
						out.add(kanjiCode(u.sjis), 13)
					}
			}
			i = j
		}
		return out.len() - start
	}

	def alnumValue(c int) int {
		return alnumChars.indexOf(string(char(c)))
	}

	// Appends an ECI designator: 8, 16 or 24 bits by size.
	def writeEci(out Bits, eci int) {
		out.add(7, 4)
		if eci < 128 {
			out.add(eci, 8)
		} else if eci < 16384 {
			out.add(0x8000 | eci, 16)
		} else {
			out.add(0xc00000 | eci, 24)
		}
	}

	// Content read back from the data bits of a symbol.
	struct Content {
		text   string
		data   byte[]
		// Structured append: this symbol's position (0-based), the count
		// and the parity byte; count 0 when the symbol stands alone.
		index  int
		count  int
		parity int
	}

	// Reads the bits after pos as n bits, or -1 past the end.
	def readBits(bits byte[], pos int, n int) int {
		return -1 when pos + n > bits.len()
		let v = 0
		for let k = 0; k < n; k++ {
			v = (v << 1) | int(bits[pos + k])
		}
		return v
	}

	// Parses the segments of a data bit string. Fails on a mode the version
	// does not have or a segment that runs past the data.
	def parseSegments(bits byte[], version int, micro int) !Content {
		let pos = 0
		let text = ""
		let data byte[]
		let pending byte[]
		let eci = -1
		let fnc1 = false
		let index = 0
		let count = 0
		let parity = 0
		let mb = modeBits(micro)
		for {
			break when pos + mb > bits.len()
			let indicator = readBits(bits, pos, mb)
			// A mode indicator of all zero bits (or a short tail) is the terminator.
			break when indicator == 0 && (micro == 0 || readBits(bits, pos, micro * 2 + 1) <= 0)
			pos += mb
			let mode = -1
			if micro == 0 {
				switch {
					case indicator == 1: mode = modeNumeric
					case indicator == 2: mode = modeAlnum
					case indicator == 4: mode = modeByte
					case indicator == 8: mode = modeKanji
					case indicator == 7:
						text += flush(pending, eci)
						pending = byte[]
						let first = readBits(bits, pos, 8)
						fail "qr: truncated ECI" when first < 0
						if (first & 0x80) == 0 {
							eci = first
							pos += 8
						} else if (first & 0xc0) == 0x80 {
							eci = readBits(bits, pos, 16) & 0x3fff
							pos += 16
						} else {
							eci = readBits(bits, pos, 24) & 0x1fffff
							pos += 24
						}
						continue
					case indicator == 5:
						fnc1 = true
						continue
					case indicator == 9:
						fnc1 = true
						pos += 8
						continue
					case indicator == 3:
						index = readBits(bits, pos, 4)
						count = readBits(bits, pos + 4, 4) + 1
						parity = readBits(bits, pos + 8, 8)
						pos += 16
						continue
					default:
						fail "qr: unknown mode indicator {indicator}"
				}
			} else {
				mode = int[modeNumeric, modeAlnum, modeByte, modeKanji][indicator]
				fail "qr: mode not in this Micro QR version" when !modeAllowed(mode, micro)
			}
			let n = readBits(bits, pos, countBits(mode, version, micro))
			fail "qr: truncated segment" when n < 0
			pos += countBits(mode, version, micro)
			switch {
				case mode == modeNumeric:
					let digits = ""
					let left = n
					for left > 0 {
						let take = left >= 3 ?? (3, left)
						let width = take == 3 ?? (10, take == 2 ?? (7, 4))
						let v = readBits(bits, pos, width)
						fail "qr: bad numeric segment" when v < 0 || v >= int[1, 10, 100, 1000][take]
						pos += width
						let s = v.str()
						for s.len() < take {
							s = "0" + s
						}
						digits += s
						left -= take
					}
					text += flush(pending, eci)
					pending = byte[]
					text += digits
					data += digits.bytes()
				case mode == modeAlnum:
					let chars = ""
					let left = n
					for left > 0 {
						if left >= 2 {
							let v = readBits(bits, pos, 11)
							fail "qr: bad alphanumeric segment" when v < 0 || v >= 45 * 45
							chars += alnumChars.slice(v / 45, v / 45 + 1) + alnumChars.slice(v % 45, v % 45 + 1)
							pos += 11
							left -= 2
						} else {
							let v = readBits(bits, pos, 6)
							fail "qr: bad alphanumeric segment" when v < 0 || v >= 45
							chars += alnumChars.slice(v, v + 1)
							pos += 6
							left -= 1
						}
					}
					chars = chars.replace("%%", "\u0000").replace("%", "\u001d").replace("\u0000", "%") when fnc1
					text += flush(pending, eci)
					pending = byte[]
					text += chars
					data += chars.bytes()
				case mode == modeByte:
					for let k = 0; k < n; k++ {
						let v = readBits(bits, pos, 8)
						fail "qr: truncated byte segment" when v < 0
						pending.push(byte(v))
						data.push(byte(v))
						pos += 8
					}
				default:
					text += flush(pending, eci)
					pending = byte[]
					let sj byte[]
					for let k = 0; k < n; k++ {
						let v = readBits(bits, pos, 13)
						fail "qr: truncated kanji segment" when v < 0
						pos += 13
						let code = (v / 0xc0) << 8 | (v % 0xc0)
						code += code < 0x1f00 ?? (0x8140, 0xc140)
						sj.push(byte(code >> 8))
						sj.push(byte(code & 0xff))
					}
					data += sj
					text += shiftjis.decode(sj)
			}
		}
		text += flush(pending, eci)
		return Content{text: text, data: data, index: index, count: count, parity: parity}
	}

	// Byte segment bytes as text in the character set the ECI names: UTF-8
	// when the bytes are valid UTF-8 and no ECI says otherwise, else Latin-1.
	def flush(pending byte[], eci int) string {
		return "" when pending.len() == 0
		switch {
			case eci == 26:
				return string(pending)
			case eci == 20:
				return shiftjis.decode(pending)
			case eci == 0 || eci == 2:
				return codepages.decode(pending, codepages.CodePage.CP437)
			case eci == 1 || eci == 3:
				return codepages.decode(pending, codepages.CodePage.Latin1)
			case eci == 21:
				return codepages.decode(pending, codepages.CodePage.Windows1252)
		}
		let s = string(pending)
		return s when s.isUTF8()
		return codepages.decode(pending, codepages.CodePage.Latin1)
	}
}
