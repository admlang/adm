internal partial module std.barcodes.scan {
	use std.math

	// BitGrid is a binarized image: true where the pixel is dark.
	type BitGrid {
		width  int
		height int
		bits   byte[]

		def new(width, height int) {
			self.width = width
			self.height = height
			bits.len(width * height)
			bits.fill(0)
		}

		// Binarizes a grayscale image with a threshold per 8x8 block, the
		// average of the 5x5 blocks around it, so uneven lighting keeps its
		// contrast. Blocks with little contrast take their neighbours' level.
		def new(gray Gray) {
			width = gray.width
			height = gray.height
			bits.len(width * height)
			bits.fill(0)
			let bw = (width + 7) / 8
			let bh = (height + 7) / 8
			if bw < 5 || bh < 5 {
				let lo = 255
				let hi = 0
				for let v in gray.pix {
					lo = int(v) when int(v) < lo
					hi = int(v) when int(v) > hi
				}
				let t = (lo + hi) / 2
				for let k = 0; k < gray.pix.len(); k++ {
					bits[k] = int(gray.pix[k]) < t ?? (1, 0)
				}
				return
			}
			// A block counts as flat when its spread is small beside the
			// image's contrast, so sensor noise on a blank area stays light.
			let lo = 255
			let hi = 0
			for let v in gray.pix {
				lo = int(v) when int(v) < lo
				hi = int(v) when int(v) > hi
			}
			let flat = (float(hi - lo) * 0.15).max(8.0)
			let black int[]
			black.len(bw * bh)
			for let by = 0; by < bh; by++ {
				let y0 = (by * 8).min(height - 8)
				for let bx = 0; bx < bw; bx++ {
					let x0 = (bx * 8).min(width - 8)
					let sum = 0
					let squares = 0
					let low = 255
					for let y = y0; y < y0 + 8; y++ {
						let row = y * width
						for let x = x0; x < x0 + 8; x++ {
							let v = int(gray.pix[row + x])
							sum += v
							squares += v * v
							low = v when v < low
						}
					}
					let average = sum >> 6
					let spread = math.sqrt(float(squares) / 64.0 - float(average * average))
					if spread < flat {
						average = low / 2
						if by > 0 && bx > 0 {
							let around = (black[(by - 1) * bw + bx] + 2 * black[by * bw + bx - 1] + black[(by - 1) * bw + bx - 1]) / 4
							average = around when low < around
						}
					}
					black[by * bw + bx] = average
				}
			}
			for let by = 0; by < bh; by++ {
				let y0 = (by * 8).min(height - 8)
				let top = by.clamp(2, bh - 3)
				for let bx = 0; bx < bw; bx++ {
					let x0 = (bx * 8).min(width - 8)
					let left = bx.clamp(2, bw - 3)
					let sum = 0
					for let dy = -2; dy <= 2; dy++ {
						for let dx = -2; dx <= 2; dx++ {
							sum += black[(top + dy) * bw + left + dx]
						}
					}
					let threshold = sum / 25
					for let y = y0; y < y0 + 8; y++ {
						let row = y * width
						for let x = x0; x < x0 + 8; x++ {
							bits[row + x] = int(gray.pix[row + x]) <= threshold ?? (1, 0)
						}
					}
				}
			}
		}

		// Whether (x, y) is dark; outside the image is light.
		def dark(x, y int) bool {
			return false when x < 0 || y < 0 || x >= width || y >= height
			return bits[y * width + x] != 0
		}

		// The grid rotated a quarter turn clockwise.
		def rotated() BitGrid {
			let g = new BitGrid(height, width)
			for let y = 0; y < height; y++ {
				for let x = 0; x < width; x++ {
					g.bits[x * height + (height - 1 - y)] = bits[y * width + x]
				}
			}
			return g
		}
	}

	// Perspective is a projective map of the plane, as a 3x3 matrix.
	type Perspective {
		a11, a21, a31, a12, a22, a32, a13, a23, a33 float

		def new(a11, a21, a31, a12, a22, a32, a13, a23, a33 float) {
			self.a11 = a11
			self.a21 = a21
			self.a31 = a31
			self.a12 = a12
			self.a22 = a22
			self.a32 = a32
			self.a13 = a13
			self.a23 = a23
			self.a33 = a33
		}

		// Maps (x, y).
		def map(x, y float) (float, float) {
			let d = a13 * x + a23 * y + a33
			return ((a11 * x + a21 * y + a31) / d, (a12 * x + a22 * y + a32) / d)
		}

		def adjoint() Perspective {
			return new Perspective(
				a22 * a33 - a23 * a32, a23 * a31 - a21 * a33, a21 * a32 - a22 * a31,
				a13 * a32 - a12 * a33, a11 * a33 - a13 * a31, a12 * a31 - a11 * a32,
				a12 * a23 - a13 * a22, a13 * a21 - a11 * a23, a11 * a22 - a12 * a21)
		}

		def times(o Perspective) Perspective {
			return new Perspective(
				a11 * o.a11 + a21 * o.a12 + a31 * o.a13, a11 * o.a21 + a21 * o.a22 + a31 * o.a23, a11 * o.a31 + a21 * o.a32 + a31 * o.a33,
				a12 * o.a11 + a22 * o.a12 + a32 * o.a13, a12 * o.a21 + a22 * o.a22 + a32 * o.a23, a12 * o.a31 + a22 * o.a32 + a32 * o.a33,
				a13 * o.a11 + a23 * o.a12 + a33 * o.a13, a13 * o.a21 + a23 * o.a22 + a33 * o.a23, a13 * o.a31 + a23 * o.a32 + a33 * o.a33)
		}
	}

	// The map taking the unit square's corners (0,0) (1,0) (1,1) (0,1) to
	// the four points.
	def squareTo(x0, y0, x1, y1, x2, y2, x3, y3 float) Perspective {
		let dx3 = x0 - x1 + x2 - x3
		let dy3 = y0 - y1 + y2 - y3
		return new Perspective(x1 - x0, x2 - x1, x0, y1 - y0, y2 - y1, y0, 0.0, 0.0, 1.0) when dx3.abs() < 1e-9 && dy3.abs() < 1e-9
		let dx1 = x1 - x2
		let dx2 = x3 - x2
		let dy1 = y1 - y2
		let dy2 = y3 - y2
		let den = dx1 * dy2 - dx2 * dy1
		let a13 = (dx3 * dy2 - dx2 * dy3) / den
		let a23 = (dx1 * dy3 - dx3 * dy1) / den
		return new Perspective(x1 - x0 + a13 * x1, x3 - x0 + a23 * x3, x0, y1 - y0 + a13 * y1, y3 - y0 + a23 * y3, y0, a13, a23, 1.0)
	}

	// The map taking one quadrilateral (corners in order) to another.
	def quadToQuad(from float[], to float[]) Perspective {
		let toSquare = squareTo(from[0], from[1], from[2], from[3], from[4], from[5], from[6], from[7]).adjoint()
		let fromSquare = squareTo(to[0], to[1], to[2], to[3], to[4], to[5], to[6], to[7])
		return fromSquare.times(toSquare)
	}

	// The projective map that best takes the module points (mx, my) to the
	// image points (ix, iy), by least squares; none when they are degenerate.
	def fitHomography(mx float[], my float[], ix float[], iy float[]) ?Perspective {
		let both float[]
		both.len(mx.len())
		both.fill(0.0)
		return fitHomography(mx, my, ix, iy, both, both)
	}

	// As fitHomography, where a point with a direction (dx, dy) other than
	// (0, 0) is only known along that unit image direction: the fit matches
	// the projection of the image point onto it and leaves the other
	// coordinate free.
	def fitHomography(mx float[], my float[], ix float[], iy float[], dx float[], dy float[]) ?Perspective {
		// Normal equations of the 8 unknowns h11 h12 h13 h21 h22 h23 h31 h32.
		let n = 8
		let m float[]
		m.len(n * (n + 1))
		m.fill(0.0)
		for let k = 0; k < mx.len(); k++ {
			let x = mx[k]
			let y = my[k]
			let rows float[][]
			if dx[k] == 0.0 && dy[k] == 0.0 {
				rows.push([x, y, 1.0, 0.0, 0.0, 0.0, -x * ix[k], -y * ix[k], ix[k]])
				rows.push([0.0, 0.0, 0.0, x, y, 1.0, -x * iy[k], -y * iy[k], iy[k]])
			} else {
				let a = dx[k]
				let b = dy[k]
				let t = a * ix[k] + b * iy[k]
				rows.push([a * x, a * y, a, b * x, b * y, b, -x * t, -y * t, t])
			}
			for let row in rows {
				for let i = 0; i < n; i++ {
					for let j = 0; j <= n; j++ {
						m[i * (n + 1) + j] += row[i] * row[j]
					}
				}
			}
		}
		for let c = 0; c < n; c++ {
			let pivot = c
			for let r = c + 1; r < n; r++ {
				pivot = r when m[r * (n + 1) + c].abs() > m[pivot * (n + 1) + c].abs()
			}
			return none when m[pivot * (n + 1) + c].abs() < 1e-12
			if pivot != c {
				for let j = 0; j <= n; j++ {
					let t = m[c * (n + 1) + j]
					m[c * (n + 1) + j] = m[pivot * (n + 1) + j]
					m[pivot * (n + 1) + j] = t
				}
			}
			for let r = 0; r < n; r++ {
				continue when r == c
				let factor = m[r * (n + 1) + c] / m[c * (n + 1) + c]
				continue when factor == 0.0
				for let j = c; j <= n; j++ {
					m[r * (n + 1) + j] -= factor * m[c * (n + 1) + j]
				}
			}
		}
		let h float[]
		for let i = 0; i < n; i++ {
			h.push(m[i * (n + 1) + n] / m[i * (n + 1) + i])
		}
		return new Perspective(h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], 1.0)
	}

	// Samples a width x height module grid whose module centres (x + 0.5,
	// y + 0.5) the map takes into the image. None when a sample falls more
	// than a pixel outside the image.
	def sampleGrid(img BitGrid, width, height int, p Perspective) ?byte[] {
		let out byte[]
		out.len(width * height)
		for let y = 0; y < height; y++ {
			for let x = 0; x < width; x++ {
				let (px, py) = p.map(float(x) + 0.5, float(y) + 0.5)
				return none when px < -1.0 || py < -1.0 || px > float(img.width) || py > float(img.height)
				let ix = int(px.floor()).clamp(0, img.width - 1)
				let iy = int(py.floor()).clamp(0, img.height - 1)
				out[y * width + x] = img.dark(ix, iy) ?? (1, 0)
			}
		}
		return out
	}
}
