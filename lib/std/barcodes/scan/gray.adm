internal partial module std.barcodes.scan {
	use std.formats.image::(Image)

	// Gray is an image reduced to luminance, 0 black to 255 white, with
	// transparent pixels over white.
	type Gray {
		width  int
		height int
		pix    byte[]

		def new(img Image) {
			width = int(img.size().width)
			height = int(img.size().height)
			pix.len(width * height)
			let raw = img.raw()
			let stride = img.stride()
			for let y = 0; y < height; y++ {
				let row = y * stride
				let out = y * width
				for let x = 0; x < width; x++ {
					let o = row + x * 4
					let a = int(raw[o + 3])
					let l = (int(raw[o]) * 306 + int(raw[o + 1]) * 601 + int(raw[o + 2]) * 117) >> 10
					l = (l * a + 255 * (255 - a)) / 255
					pix[out + x] = byte(l)
				}
			}
		}

		// The luminance at (x, y); 255 outside the image.
		def at(x, y int) int {
			return 255 when x < 0 || y < 0 || x >= width || y >= height
			return int(pix[y * width + x])
		}

		// Row y as alternating light and dark run lengths, starting with a
		// light run (0 long when the row starts dark) and ending with one.
		// The threshold sits halfway between the row's darkest and lightest
		// pixels; a row with less contrast than minContrast has no runs.
		def rowRuns(y int, minContrast int = 32) int[] {
			let lo = 255
			let hi = 0
			let base = y * width
			for let x = 0; x < width; x++ {
				let v = int(pix[base + x])
				lo = v when v < lo
				hi = v when v > hi
			}
			return int[] when hi - lo < minContrast
			let threshold = (lo + hi) / 2
			let runs = int[0]
			let dark = false
			for let x = 0; x < width; x++ {
				let d = int(pix[base + x]) < threshold
				if d != dark {
					runs += 0
					dark = d
				}
				runs[runs.len() - 1] += 1
			}
			runs += 0 when dark
			return runs
		}
	}
}
