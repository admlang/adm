internal partial module std.barcodes.scan {
	use std.math

	// Blob is one 8-connected set of dark pixels: its bounding box, size and
	// the pixels on its edge (a light 4-neighbour), as x, y pairs.
	struct Blob {
		left, top, right, bottom int
		count                    int
		edge                     int[]
	}

	// The dark 8-connected blobs of at least minCount pixels.
	def blobs(img BitGrid, minCount int) Blob[] {
		let out Blob[]
		let seen byte[]
		seen.len(img.width * img.height)
		seen.fill(0)
		let stack int[]
		for let start = 0; start < img.bits.len(); start++ {
			continue when img.bits[start] == 0 || seen[start] != 0
			seen[start] = 1
			stack.len(0)
			stack.push(start)
			let b = Blob{left: img.width, top: img.height, right: 0, bottom: 0}
			let edge int[]
			for stack.len() > 0 {
				let p = stack[stack.len() - 1]
				stack.len(stack.len() - 1)
				let x = p % img.width
				let y = p / img.width
				b.count++
				b.left = b.left.min(x)
				b.right = b.right.max(x)
				b.top = b.top.min(y)
				b.bottom = b.bottom.max(y)
				if !img.dark(x - 1, y) || !img.dark(x + 1, y) || !img.dark(x, y - 1) || !img.dark(x, y + 1) {
					edge.push(x)
					edge.push(y)
				}
				for let dy = -1; dy <= 1; dy++ {
					for let dx = -1; dx <= 1; dx++ {
						let nx = x + dx
						let ny = y + dy
						continue when nx < 0 || ny < 0 || nx >= img.width || ny >= img.height
						let q = ny * img.width + nx
						continue when img.bits[q] == 0 || seen[q] != 0
						seen[q] = 1
						stack.push(q)
					}
				}
			}
			continue when b.count < minCount
			b.edge = edge
			out.push(b)
		}
		return out
	}

	// The convex hull of points (x, y pairs), counter-clockwise in image
	// coordinates, as x, y pairs of pixel centres.
	def convexHull(points int[]) float[] {
		let n = points.len() / 2
		let idx int[]
		for let k = 0; k < n; k++ {
			idx.push(k)
		}
		idx.sort((a, b) => points[2 * a] < points[2 * b] || (points[2 * a] == points[2 * b] && points[2 * a + 1] < points[2 * b + 1]))
		let cross = (o int, a int, b int) => (points[2 * a] - points[2 * o]) * (points[2 * b + 1] - points[2 * o + 1]) - (points[2 * a + 1] - points[2 * o + 1]) * (points[2 * b] - points[2 * o])
		let hull int[]
		for let k in idx {
			for hull.len() >= 2 && cross(hull[hull.len() - 2], hull[hull.len() - 1], k) <= 0 {
				hull.len(hull.len() - 1)
			}
			hull.push(k)
		}
		let lower = hull.len() + 1
		for let j = idx.len() - 2; j >= 0; j-- {
			let k = idx[j]
			for hull.len() >= lower && cross(hull[hull.len() - 2], hull[hull.len() - 1], k) <= 0 {
				hull.len(hull.len() - 1)
			}
			hull.push(k)
		}
		hull.len(hull.len() - 1) when hull.len() > 1
		let out float[]
		for let k in hull {
			out.push(float(points[2 * k]) + 0.5)
			out.push(float(points[2 * k + 1]) + 0.5)
		}
		return out
	}

	// The smallest-area rectangle around a convex polygon (x, y pairs), as
	// its four corners in order around it.
	def minAreaRect(hull float[]) float[] {
		let n = hull.len() / 2
		let best = 1e300
		let out float[]
		for let i = 0; i < n; i++ {
			let j = (i + 1) % n
			let ex = hull[2 * j] - hull[2 * i]
			let ey = hull[2 * j + 1] - hull[2 * i + 1]
			let len = math.sqrt(ex * ex + ey * ey)
			continue when len < 1e-9
			ex = ex / len
			ey = ey / len
			let minU = 1e300
			let maxU = -1e300
			let minV = 1e300
			let maxV = -1e300
			for let k = 0; k < n; k++ {
				let u = hull[2 * k] * ex + hull[2 * k + 1] * ey
				let v = -hull[2 * k] * ey + hull[2 * k + 1] * ex
				minU = minU.min(u)
				maxU = maxU.max(u)
				minV = minV.min(v)
				maxV = maxV.max(v)
			}
			let area = (maxU - minU) * (maxV - minV)
			continue when area >= best
			best = area
			out = float[]
			let us = [minU, maxU, maxU, minU]
			let vs = [minV, minV, maxV, maxV]
			for let k = 0; k < 4; k++ {
				out.push(us[k] * ex - vs[k] * ey)
				out.push(us[k] * ey + vs[k] * ex)
			}
		}
		return out
	}

	// Line is a*x + b*y = c with (a, b) a unit normal.
	struct Line {
		a float
		b float
		c float
	}

	// The least-squares line through points (x, y pairs), by their principal
	// direction; none for fewer than two distinct points.
	def fitLine(points float[]) ?Line {
		let n = points.len() / 2
		return none when n < 2
		let mx = 0.0
		let my = 0.0
		for let k = 0; k < n; k++ {
			mx += points[2 * k]
			my += points[2 * k + 1]
		}
		mx = mx / float(n)
		my = my / float(n)
		let sxx = 0.0
		let sxy = 0.0
		let syy = 0.0
		for let k = 0; k < n; k++ {
			let dx = points[2 * k] - mx
			let dy = points[2 * k + 1] - my
			sxx += dx * dx
			sxy += dx * dy
			syy += dy * dy
		}
		return none when sxx + syy < 1e-9
		// Direction of largest spread; the normal is perpendicular to it.
		let angle = 0.5 * math.atan2(2.0 * sxy, sxx - syy)
		let a = -math.sin(angle)
		let b = math.cos(angle)
		return Line{a: a, b: b, c: a * mx + b * my}
	}

	// Where two lines cross; none when they are parallel.
	def intersect(p, q Line) ?(float, float) {
		let det = p.a * q.b - p.b * q.a
		return none when det.abs() < 1e-9
		return ((p.c * q.b - p.b * q.c) / det, (p.a * q.c - p.c * q.a) / det)
	}

	// The distance of (x, y) from a line.
	def distance(l Line, x, y float) float {
		return (l.a * x + l.b * y - l.c).abs()
	}

	// The line along one side of a blob: from (x0, y0) along the unit
	// direction (ux, uy) for len pixels, (cx, cy) inside. Takes the outermost
	// edge pixel of each pixel-wide slice across the middle 90% of the side,
	// keeps the slices within a pixel and a half of the outermost (so the
	// gaps of a timing pattern drop out), fits a line and refits without the
	// points more than a pixel off it.
	def sideLine(b Blob, x0, y0, ux, uy, len float, cx, cy float) ?Line {
		// Outward normal.
		let nx = -uy
		let ny = ux
		if (cx - x0) * nx + (cy - y0) * ny > 0.0 {
			nx = -nx
			ny = -ny
		}
		let bins = int(len) + 1
		let outer float[]
		outer.len(bins)
		outer.fill(-1e300)
		let px float[]
		let py float[]
		px.len(bins)
		py.len(bins)
		let depth = len * 0.15
		for let k = 0; k < b.edge.len() / 2; k++ {
			let x = float(b.edge[2 * k]) + 0.5
			let y = float(b.edge[2 * k + 1]) + 0.5
			let t = (x - x0) * ux + (y - y0) * uy
			continue when t < len * 0.05 || t > len * 0.95
			let o = (x - x0) * nx + (y - y0) * ny
			continue when o < -depth
			let bin = int(t)
			continue when o <= outer[bin]
			outer[bin] = o
			px[bin] = x
			py[bin] = y
		}
		let top = -1e300
		for let o in outer {
			top = o when o > top
		}
		return none when top < -1e299
		let points float[]
		for let k = 0; k < bins; k++ {
			continue when outer[k] < top - 1.5
			points.push(px[k])
			points.push(py[k])
		}
		let first = fitLine(points)
		return none when first is none
		let l = first
		let kept float[]
		for let k = 0; k < points.len() / 2; k++ {
			continue when distance(l, points[2 * k], points[2 * k + 1]) > 1.0
			kept.push(points[2 * k])
			kept.push(points[2 * k + 1])
		}
		return kept.len() >= 4 ?? (fitLine(kept), first)
	}

	// The quadrilateral a blob fills: the minimum-area rectangle around its
	// hull, each side refined by a line through the outermost edge pixels
	// along it.
	// Corners as x, y pairs in order around the shape; none when degenerate.
	def blobQuad(b Blob) ?float[] {
		let hull = convexHull(b.edge)
		return none when hull.len() < 8
		let rect = minAreaRect(hull)
		return none when rect.len() != 8
		let cx = (rect[0] + rect[2] + rect[4] + rect[6]) / 4.0
		let cy = (rect[1] + rect[3] + rect[5] + rect[7]) / 4.0
		let lines Line[]
		for let s = 0; s < 4; s++ {
			let x0 = rect[2 * s]
			let y0 = rect[2 * s + 1]
			let x1 = rect[(2 * s + 2) % 8]
			let y1 = rect[(2 * s + 3) % 8]
			let dx = x1 - x0
			let dy = y1 - y0
			let len = math.sqrt(dx * dx + dy * dy)
			return none when len < 4.0
			let side = Line{a: -dy / len, b: dx / len, c: (-dy * x0 + dx * y0) / len}
			let fitted = sideLine(b, x0, y0, dx / len, dy / len, len, cx, cy)
			if fitted is none {
				lines.push(side)
			} else {
				let f = fitted
				lines.push(f)
			}
		}
		// Edge points are pixel centres: move each side out half a pixel to
		// the pixels' outer edge.
		for let k = 0; k < 4; k++ {
			let l = lines[k]
			let side = l.a * cx + l.b * cy - l.c
			lines[k] = Line{a: l.a, b: l.b, c: side > 0.0 ?? (l.c - 0.5, l.c + 0.5)}
		}
		let out float[]
		for let s = 0; s < 4; s++ {
			let p = intersect(lines[(s + 3) % 4], lines[s])
			return none when p is none
			let (x, y) = p
			out.push(x)
			out.push(y)
		}
		return out
	}
}
