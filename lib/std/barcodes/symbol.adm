partial module std.barcodes {
	use (
		std.gfx.color::(Color)
		std.gfx.canvas::(DrawContext)
		std.math.geom::(Rect, Point)
		std.formats.image::(Image)
	)

	// Symbology names a barcode type.
	enum Symbology {
		// QR Code (ISO/IEC 18004), versions 1 to 40.
		Qr
		// Micro QR Code (ISO/IEC 18004), M1 to M4.
		MicroQr
		// Data Matrix ECC 200 (ISO/IEC 16022).
		DataMatrix
		// Aztec Code (ISO/IEC 24778), runes included.
		Aztec
		// PDF417 (ISO/IEC 15438).
		Pdf417
		// MicroPDF417 (ISO/IEC 24728).
		MicroPdf417
		// EAN-13 (ISO/IEC 15420), 12 digits and the check digit.
		Ean13
		// EAN-8, 7 digits and the check digit.
		Ean8
		// UPC-A, 11 digits and the check digit.
		UpcA
		// UPC-E, the zero-suppressed UPC-A: number system 0 or 1, 6 digits, check digit.
		UpcE
		// Code 128 (ISO/IEC 15417), GS1-128 when the text starts with FNC1.
		Code128
		// Code 39 (ISO/IEC 16388).
		Code39
		// Code 93.
		Code93
		// Interleaved 2 of 5 (ISO/IEC 16390).
		Itf
		// Codabar (NW-7).
		Codabar
	}

	// Symbol is an encoded barcode ready to print: a grid of dark and light
	// modules for the 2D symbologies, and for the linear ones the bar and
	// space widths in modules as well (a one-row grid holding the same bars).
	//
	// ```
	// let sym = qr.encode("https://adm-lang.dev")!
	// sym.toImage(scale = 8).save("qr.png")!
	// ```
	type Symbol {
		symbology      Symbology
		// Modules across.
		width          int
		// Module rows; 1 for a linear symbol.
		height         int
		// The light margin each side needs, in modules.
		quietZone      int
		// For a linear symbol: bar, space, bar, ... widths in modules, starting
		// and ending with a bar. Empty for a 2D symbol.
		widths         int[]
		// The human-readable text: for a linear symbol the digits or
		// characters printed under the bars, check digits included.
		text           string
		internal cells byte[]

		def new(symbology Symbology, width, height int, quietZone int = 4) {
			self.symbology = symbology
			self.width = width
			self.height = height
			self.quietZone = quietZone
			cells.len(width * height)
			cells.fill(0)
		}

		// A linear symbol from its bar and space widths.
		def new(symbology Symbology, widths int[], text string, quietZone int = 10) {
			self.symbology = symbology
			self.widths = widths
			self.text = text
			self.quietZone = quietZone
			let total = 0
			for let w in widths {
				total += w
			}
			width = total
			height = 1
			cells.len(total)
			cells.fill(0)
			let x = 0
			for let (i, w) in widths {
				for let k = 0; k < w; k++ {
					cells[x + k] = 1 when i % 2 == 0
				}
				x += w
			}
		}

		// Whether this is a linear (1D) symbol.
		def linear() bool {
			return widths.len() > 0
		}

		// Whether the module at column x, row y is dark. Modules outside the
		// symbol are light.
		def dark(x, y int) bool {
			return false when x < 0 || y < 0 || x >= width || y >= height
			return cells[y * width + x] != 0
		}

		// Sets the module at column x, row y; outside the symbol it is ignored.
		def dark(x, y int, on bool) {
			return when x < 0 || y < 0 || x >= width || y >= height
			cells[y * width + x] = on ?? (1, 0)
		}

		// Renders the symbol with its quiet zone, scale pixels per module.
		// A linear symbol's bars are barHeight modules tall.
		def toImage(scale int = 4, barHeight int = 50, ink Color = new Color("#000000"), paper Color = new Color("#ffffff")) Image {
			let rows = linear() ?? (barHeight, height)
			let w = (width + 2 * quietZone) * scale
			let h = (rows + 2 * quietZone) * scale
			let img = new Image(w, h)
			let px = img.raw()
			let stride = img.stride()
			for let y = 0; y < h; y++ {
				let my = y / scale - quietZone
				for let x = 0; x < w; x++ {
					let mx = x / scale - quietZone
					let on = my >= 0 && my < rows && dark(mx, linear() ?? (0, my))
					let c = on ?? (ink, paper)
					let o = y * stride + x * 4
					px[o] = c.red
					px[o + 1] = c.green
					px[o + 2] = c.blue
					px[o + 3] = c.alpha
				}
			}
			return img
		}

		// Draws the dark modules into ctx with the symbol's top-left module at
		// (x, y), each module scale units wide. The quiet zone is not painted:
		// leave that much room around it on a light background.
		def draw(ctx DrawContext, x, y float, scale float = 1.0, barHeight int = 50, ink Color = new Color("#000000")) {
			if linear() {
				let left = x
				for let (i, w) in widths {
					let right = left + float(w) * scale
					ctx.fill(Rect{left: left, top: y, right: right, bottom: y + float(barHeight) * scale}, ink) when i % 2 == 0
					left = right
				}
				return
			}
			for let row = 0; row < height; row++ {
				let col = 0
				for col < width {
					if !dark(col, row) {
						col++
						continue
					}
					let start = col
					for col < width && dark(col, row) {
						col++
					}
					ctx.fill(Rect{left: x + float(start) * scale, top: y + float(row) * scale, right: x + float(col) * scale, bottom: y + float(row + 1) * scale}, ink)
				}
			}
		}

		// The grid as text, one line per row, `#` for dark and `.` for light,
		// without the quiet zone.
		def str() string {
			let lines string[]
			for let y = 0; y < height; y++ {
				let line = ""
				for let x = 0; x < width; x++ {
					line += dark(x, y) ?? ("#", ".")
				}
				lines += line
			}
			return lines.join("\n")
		}
	}

	// Barcode is a decoded symbol: what it says and where it was found.
	struct Barcode {
		symbology Symbology
		// The content as text: bytes decoded as UTF-8, or in the character set
		// an ECI named. GS1 data shows FNC1 as the group separator (0x1d).
		text      string
		// The content as the raw bytes of the data segments.
		data      byte[]
		// The corners in image pixels, clockwise from the top-left of the
		// symbol as it reads; empty when decoded from a grid or widths.
		corners   Point[]
	}
}
