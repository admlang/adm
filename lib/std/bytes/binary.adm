partial module std.bytes {
	use (
		std.io
		std.crypto.hash
	)

	// BinaryReader reads from a binary stream and provides methods to read structured data.
	type BinaryReader {
		internal r        io.Reader
		internal buf      byte[]
		internal count    int
		internal endianes Endian
		internal hasher   ?hash.Hasher

		def new(reader io.Reader, endian Endian = Endian.Little, hasher ?hash.Hasher = none) {
			r = reader
			endianes = endian
			self.hasher = hasher
		}

		// Read from the binary stream into b and returns the number of bytes read.
		// Fails when the underlying reader does.
		def read(b byte[]) !int {
			let n = try r.read(b)
			hasher.write(b[:n]) unless hasher is none
			count += n
			return n
		}

		// Read n bytes from the binary stream and return them as a byte array.
		// Fails when the underlying reader does.
		def read(n int) !byte[] {
			let tmp byte[]
			tmp.len(n)
			tmp[:] = 0
			try self.read(tmp)
			return tmp
		}

		// readByte reads the next byte. Fails when the underlying reader does.
		def readByte() !byte {
			buf.len(1)
			try read(buf)
			return buf[0]
		}

		// Read a fixed-size string from the binary stream.
		// Fails when the underlying reader does.
		def readString(n int) !string {
			let b byte[]
			b.len(n)
			try self.read(b)
			return string(b)
		}

		// Read a null terminated string from the binary stream.
		// Fails when the underlying reader does, or the stream ends before the terminator.
		def readString() !string {
			let tmp byte[]
			tmp.cap(1024)
			let total = 0
			let b byte
			for {
				b = try readByte()
				if b == 0 {
					break
				}
				tmp += b
			}
			return string(tmp)
		}

		// skip reads and discards n bytes, counting them as read. Fails when the
		// underlying reader does.
		def skip(n int) !none {
			buf.len(n)
			try r.read(buf)
			count += n
			return none
		}

		// read decodes a number of type T from the stream, in the given byte order or
		// the reader's default. Fails when the underlying reader does or the stream
		// ends first.
		def read<T: Numeric>(endian ?Endian = none) !T {
			let end Endian = endianes
			end = endian unless endian is none

			let out T = 0
			buf.len(out.size())
			try self.read(buf)
			return out.fromBytes(buf, end)
		}

		// reset points the reader at another source, clears the byte count and
		// installs the hasher the read bytes feed, if any.
		def reset(reader io.Reader, hasher ?hash.Hasher = none) {
			count = 0
			r = reader
			buf.len(0)
			self.hasher = hasher
		}

		// totalRead returns how many bytes have been read since the reader was
		// created or reset.
		def totalRead() int {
			return count
		}

		// hash returns the digest of every byte read so far, empty when no hasher
		// is installed.
		def hash() byte[] {
			return byte[] when hasher is none
			return hasher.hash()
		}
	}
}
