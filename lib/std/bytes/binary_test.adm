partial module std.bytes {
	use (
		std.testing
	)

	check "BinaryReader varints" {
		@test()
		def TestReadsUnsignedVarints() !none {
			let r = new BinaryReader(new Reader(byte[0x00, 0x01, 0x7F, 0x80, 0x01, 0xAC, 0x02, 0xFF, 0xFF, 0xFF, 0xFF, 0x0F]))
			try testing.expectEqual(0, int(try r.readUvarint()))
			try testing.expectEqual(1, int(try r.readUvarint()))
			try testing.expectEqual(127, int(try r.readUvarint()))
			try testing.expectEqual(128, int(try r.readUvarint()))
			try testing.expectEqual(300, int(try r.readUvarint()))
			try testing.expectEqual(4294967295, int(try r.readUvarint()))
			try testing.expectError(r.readUvarint())
		}

		@test()
		def TestReadsSignedVarints() !none {
			let r = new BinaryReader(new Reader(byte[0x00, 0x01, 0x02, 0x03, 0xFE, 0xFF, 0x03]))
			try testing.expectEqual(0, try r.readVarint())
			try testing.expectEqual(-1, try r.readVarint())
			try testing.expectEqual(1, try r.readVarint())
			try testing.expectEqual(-2, try r.readVarint())
			try testing.expectEqual(32767, try r.readVarint())
		}

		@test()
		def TestRefusesAVarintPastSixtyFourBits() !none {
			let r = new BinaryReader(new Reader(byte[0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x01]))
			try testing.expectError(r.readUvarint())
		}
	}

	check "Float bytes" {
		@test()
		def TestFloatBytesAreTheIeeeBits() !none {
			try testing.expectEqual("0000C03F", float32(1.5).bytes(Endian.Little).hex())
			try testing.expectEqual("3FF8000000000000", float64(1.5).bytes(Endian.Big).hex())
			try testing.expectEqual(1.5, float64(0).fromBytes(float64(1.5).bytes()))
			try testing.expectEqual(-2.25, float64(float32(0).fromBytes(float32(-2.25).bytes())))
			try testing.expectEqual(8, float(0).bytes().len())
		}
	}
}
