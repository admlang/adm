partial module std.bytes {
	type Bitstream {
		internal buf    byte[]
		internal length int
		internal pos    int

		def new(length int = 0) {
			if length != 0 {
				buf.len(length / 8 + 1)
				self.length = length
			}
			pos = 0
		}

		def from(b byte[]) Bitstream {
			buf = b
			length = b.len() * 8
			pos = 0
			return self
		}

		internal def extend(index int) int {
			let old = buf.len()
			buf.len(index / 8 + 1)
			let newLen = buf.len()
			length = length.max(index + 1)
			buf[old:newLen] = 0
			return index / 8
		}

		def clear(index int) Bitstream {
			return self when index < 0
			let b = extend(index)
			buf[b] &= ^(1 << (7 - (index % 8)))
			return self
		}

		def set(index int) Bitstream {
			return self when index < 0
			let b = extend(index)
			buf[b] |= 1 << (7 - (index % 8))
			return self
		}

		def set(index int, value bool) Bitstream {
			if value {
				set(index)
			} else {
				clear(index)
			}
			return self
		}

		def write(value int, bits int) Bitstream {
			for let i in 0..bits {
				set(pos) when (value >> i) & 1 != 0
				pos += 1
			}
			length = length.max(pos)
			return self
		}

		def read(bits int) int {
			let out = 0
			for let i in 0..bits {
				out |= (1 << i) when get(pos)
				pos += 1
			}
			return out
		}

		def seek(index int) Bitstream {
			pos = 0 when index < 0
			pos = length when index >= length
			pos = index when index >= 0 && index < length
			return self
		}

		def toggle(index int) Bitstream {
			return self when index < 0 || index >= length
			if get(index) {
				clear(index)
			} else {
				set(index)
			}
			return self
		}

		def get(index int) bool {
			return false when index < 0 || index >= length
			return(buf[index / 8] & (1 << (7 - (index % 8)))) != 0
		}

		def add(bits ...bool) Bitstream {
			for let (_, b) in bits {
				if b {
					set(pos)
				}
				pos += 1
			}
			length = length.max(pos)
			return self
		}

		def add(bits ...int) Bitstream {
			for let (_, b) in bits {
				if b != 0 {
					set(pos)
				}
				pos += 1
			}
			return self
		}

		def all() bool {
			for let i in 0..pos {
				return false unless get(i)
			}
			return true
		}

		def any() bool {
			for let (_, b) in buf {
				return true when b != 0
			}
			return false
		}

		def setAll() Bitstream {
			for let i in 0..pos {
				set(i)
			}
			return self
		}

		def clearAll() Bitstream {
			for let i in 0..pos {
				clear(i)
			}
			return self
		}

		def reset() Bitstream {
			buf = byte[]
			buf.len(0)
			length = 0
			pos = 0
			return self
		}

		def count() int {
			let total = 0
			for let i in 0..pos {
				total++ when get(i)
			}
			return total
		}

		def clone() Bitstream {
			let b = new Bitstream()
			b.buf = buf.clone()
			b.pos = pos
			b.length = length
			return b
		}

		def bytes() byte[] {
			return buf
		}

		def capacity() int {
			return buf.len()
		}

		def len() int {
			return length
		}

		def position() int {
			return pos
		}

		def str() string {
			let tmp int[]
			tmp.len(length)
			tmp[:] = 0
			for let i in 0..length {
				tmp[i] = get(i) ?? (1, 0)
			}
			let fmt string = tmp.join("")
			return "Bitstream(cap={capacity()} pos={pos} len={length} data={fmt})"
		}

		infix def & (other Bitstream) Bitstream {
			let out = new Bitstream()
			let maxLen = length.max(other.length)

			for let i in 0..maxLen {
				out.set(i) when get(i) && other.get(i)
			}

			out.length = maxLen
			out.pos = maxLen
			return out
		}

		infix def | (other Bitstream) Bitstream {
			let out = new Bitstream()
			let maxLen = length.max(other.length)

			for let i in 0..maxLen {
				out.set(i) when get(i) || other.get(i)
			}

			out.length = maxLen
			out.pos = maxLen
			return out
		}

		infix def ^ (other Bitstream) Bitstream {
			let out = new Bitstream()
			let maxLen = length.max(other.length)

			for let i in 0..maxLen {
				out.set(i) when get(i) != other.get(i)
			}

			out.length = maxLen
			out.pos = maxLen
			return out
		}

		infix def << (other int) Bitstream {
			let out = new Bitstream()
			return out when other <= 0

			for let i in 0..length {
				out.set(i + other) when get(i)
			}

			out.length = length + other
			out.pos = out.length
			return out
		}

		infix def >> (other int) Bitstream {
			let out = new Bitstream()
			return out when other <= 0 || other >= length

			for let i in other..length {
				out.set(i - other) when get(i)
			}

			out.length = length - other
			out.pos = out.length
			return out
		}

		infix def <<< (other int) Bitstream {
			let out = new Bitstream()
			return out when length == 0

			let n = other % length
			for let i in 0..length {
				let src = (i + n) % length
				out.set(i) when get(src)
			}

			out.length = length
			out.pos = out.length
			return out
		}

		infix def >>> (other int) Bitstream {
			let out = new Bitstream()
			return out when length == 0

			let n = other % length
			for let i in 0..length {
				let src = (i - n + length) % length
				out.set(i) when get(src)
			}

			out.length = length
			out.pos = out.length
			return out
		}
	}
}
