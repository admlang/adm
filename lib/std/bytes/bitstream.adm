partial module std.bytes {
	// Bitstream is a growable sequence of bits, most significant bit of each byte
	// first, with a cursor for sequential reads and writes and the usual bitwise
	// operators.
	type Bitstream {
		internal buf    byte[]
		internal length int
		internal pos    int

		def new(length int = 0) {
			if length != 0 {
				buf.len(length / 8 + 1)
				self.length = length
			}
			pos = 0
		}

		// from replaces the contents with the bytes and rewinds the cursor; returns
		// the stream for chaining.
		def from(b byte[]) Bitstream {
			buf = b
			length = b.len() * 8
			pos = 0
			return self
		}

		internal def extend(index int) int {
			let old = buf.len()
			buf.len(index / 8 + 1)
			let newLen = buf.len()
			length = length.max(index + 1)
			buf[old:newLen] = 0
			return index / 8
		}

		// clear sets the bit at index to 0, growing the stream to reach it; a
		// negative index is ignored.
		def clear(index int) Bitstream {
			return self when index < 0
			let b = extend(index)
			buf[b] &= ^(1 << (7 - (index % 8)))
			return self
		}

		// set sets the bit at index to 1, growing the stream to reach it; a negative
		// index is ignored.
		def set(index int) Bitstream {
			return self when index < 0
			let b = extend(index)
			buf[b] |= 1 << (7 - (index % 8))
			return self
		}

		// set sets the bit at index to value, growing the stream to reach it.
		def set(index int, value bool) Bitstream {
			if value {
				set(index)
			} else {
				clear(index)
			}
			return self
		}

		// write appends the low `bits` bits of value at the cursor, least significant
		// first, and advances it.
		def write(value int, bits int) Bitstream {
			for let i in 0..bits {
				set(pos) when (value >> i) & 1 != 0
				pos += 1
			}
			length = length.max(pos)
			return self
		}

		// read takes `bits` bits at the cursor, least significant first, as an
		// integer and advances the cursor; bits past the end read as 0.
		def read(bits int) int {
			let out = 0
			for let i in 0..bits {
				out |= (1 << i) when get(pos)
				pos += 1
			}
			return out
		}

		// seek moves the cursor to index, clamped to the stream's bounds.
		def seek(index int) Bitstream {
			pos = 0 when index < 0
			pos = length when index >= length
			pos = index when index >= 0 && index < length
			return self
		}

		// toggle flips the bit at index; an index outside the stream is ignored.
		def toggle(index int) Bitstream {
			return self when index < 0 || index >= length
			if get(index) {
				clear(index)
			} else {
				set(index)
			}
			return self
		}

		// get returns the bit at index, false outside the stream.
		def get(index int) bool {
			return false when index < 0 || index >= length
			return(buf[index / 8] & (1 << (7 - (index % 8)))) != 0
		}

		// add appends one bit per value at the cursor and advances it.
		def add(bits ...bool) Bitstream {
			for let (_, b) in bits {
				if b {
					set(pos)
				}
				pos += 1
			}
			length = length.max(pos)
			return self
		}

		// add appends one bit per value at the cursor, set when the value is not 0,
		// and advances it.
		def add(bits ...int) Bitstream {
			for let (_, b) in bits {
				if b != 0 {
					set(pos)
				}
				pos += 1
			}
			return self
		}

		// all reports whether every bit before the cursor is set.
		def all() bool {
			for let i in 0..pos {
				return false unless get(i)
			}
			return true
		}

		// any reports whether any bit of the stream is set.
		def any() bool {
			for let (_, b) in buf {
				return true when b != 0
			}
			return false
		}

		// setAll sets every bit before the cursor.
		def setAll() Bitstream {
			for let i in 0..pos {
				set(i)
			}
			return self
		}

		// clearAll clears every bit before the cursor.
		def clearAll() Bitstream {
			for let i in 0..pos {
				clear(i)
			}
			return self
		}

		// reset empties the stream and rewinds the cursor.
		def reset() Bitstream {
			buf = byte[]
			buf.len(0)
			length = 0
			pos = 0
			return self
		}

		// count returns how many bits before the cursor are set.
		def count() int {
			let total = 0
			for let i in 0..pos {
				total++ when get(i)
			}
			return total
		}

		// clone returns a copy with its own bytes, cursor and length.
		def clone() Bitstream {
			let b = new Bitstream()
			b.buf = buf.clone()
			b.pos = pos
			b.length = length
			return b
		}

		// bytes returns the backing bytes, shared with the stream.
		def bytes() byte[] {
			return buf
		}

		// capacity returns how many bits the backing bytes can hold.
		def capacity() int {
			return buf.len()
		}

		// len returns the number of bits in the stream.
		def len() int {
			return length
		}

		// position returns the cursor, in bits from the start.
		def position() int {
			return pos
		}

		// str renders the bits as a string of 0s and 1s, first bit first.
		def str() string {
			let tmp int[]
			tmp.len(length)
			tmp[:] = 0
			for let i in 0..length {
				tmp[i] = get(i) ?? (1, 0)
			}
			let fmt string = tmp.join("")
			return "Bitstream(cap={capacity()} pos={pos} len={length} data={fmt})"
		}

		// & returns the bitwise and of the two streams, the shorter one read as
		// zeros past its end.
		infix def & (other Bitstream) Bitstream {
			let out = new Bitstream()
			let maxLen = length.max(other.length)

			for let i in 0..maxLen {
				out.set(i) when get(i) && other.get(i)
			}

			out.length = maxLen
			out.pos = maxLen
			return out
		}

		// | returns the bitwise or of the two streams.
		infix def | (other Bitstream) Bitstream {
			let out = new Bitstream()
			let maxLen = length.max(other.length)

			for let i in 0..maxLen {
				out.set(i) when get(i) || other.get(i)
			}

			out.length = maxLen
			out.pos = maxLen
			return out
		}

		// ^ returns the bitwise exclusive or of the two streams.
		infix def ^ (other Bitstream) Bitstream {
			let out = new Bitstream()
			let maxLen = length.max(other.length)

			for let i in 0..maxLen {
				out.set(i) when get(i) != other.get(i)
			}

			out.length = maxLen
			out.pos = maxLen
			return out
		}

		// << returns the stream shifted left by other bits, the vacated bits clear; a
		// shift of 0 or less gives an empty stream.
		infix def << (other int) Bitstream {
			let out = new Bitstream()
			return out when other <= 0

			for let i in 0..length {
				out.set(i + other) when get(i)
			}

			out.length = length + other
			out.pos = out.length
			return out
		}

		// >> returns the stream shifted right by other bits; a shift of 0 or less, or
		// of the whole length or more, gives an empty stream.
		infix def >> (other int) Bitstream {
			let out = new Bitstream()
			return out when other <= 0 || other >= length

			for let i in other..length {
				out.set(i - other) when get(i)
			}

			out.length = length - other
			out.pos = out.length
			return out
		}

		// <<< returns the stream rotated left by other bits.
		infix def <<< (other int) Bitstream {
			let out = new Bitstream()
			return out when length == 0

			let n = other % length
			for let i in 0..length {
				let src = (i + n) % length
				out.set(i) when get(src)
			}

			out.length = length
			out.pos = out.length
			return out
		}

		// >>> returns the stream rotated right by other bits.
		infix def >>> (other int) Bitstream {
			let out = new Bitstream()
			return out when length == 0

			let n = other % length
			for let i in 0..length {
				let src = (i - n + length) % length
				out.set(i) when get(src)
			}

			out.length = length
			out.pos = out.length
			return out
		}
	}
}
