partial module std.bytes {
	use std.testing

	check "Bitstream" {
		@test()
		def basic_add_get() {
			let b = new Bitstream()
			b.add(1, 0, 1, 1, 0)

			assert b.position() == 5
			assert b.count() == 3
			assert b.get(0)
			assert !b.get(1)
			assert b.get(2)
			assert b.get(3)
			assert !b.get(4)
		}

		@test()
		def set_clear_toggle() {
			let b = new Bitstream()
			b.set(3)
			b.set(5)
			b.toggle(3)
			b.clear(5)

			assert !b.get(3)
			assert !b.get(5)
			assert b.count() == 0
		}

		@test()
		def write_read_lsb_first() {
			let b = new Bitstream()

			// 0b1011 = 11
			b.write(11, 4)
			b.seek(0)

			let v = b.read(4)
			assert v == 11
		}

		@test()
		def write_partial_byte() {
			let b = new Bitstream()
			b.write(0b11010110, 5) // LSB-first: 0,1,1,0,1
			assert !b.get(0)
			assert b.get(1)
			assert b.get(2)
			assert !b.get(3)
			assert b.get(4)
		}

		@test()
		def and_or_xor() {
			let a = new Bitstream()
			let b = new Bitstream()

			a.add(1, 0, 1, 0)
			b.add(1, 1, 0, 0)

			let c = a & b
			let d = a | b
			let e = a ^ b
			assert c.count() == 1 // 1000
			assert d.count() == 3 // 1110
			assert e.count() == 2 // 0110
		}

		@test()
		def logical_shifts() {
			let b = new Bitstream()
			b.add(1, 0, 1, 1) // 1011

			let l = b << 2
			let r = b >> 2

			assert l.len() == 6
			assert l.get(2)
			assert l.get(4)
			assert l.get(5)

			assert r.len() == 2
			assert r.get(0)
			assert r.get(1)
		}

		@test()
		def rotates() {
			let b = new Bitstream()
			b.add(1, 0, 0, 1) // 1001

			let rl = b <<< 1 // 0011
			let rr = b >>> 1 // 1100

			assert !rl.get(0)
			assert !rl.get(1)
			assert rl.get(2)
			assert rl.get(3)

			assert rr.get(0)
			assert rr.get(1)
			assert !rr.get(2)
			assert !rr.get(3)
		}

		@test()
		def clone_independent() {
			let b = new Bitstream()
			b.add(1, 1, 0)

			let c = b.clone()
			c.set(2)

			assert !b.get(2)
			assert c.get(2)
		}

		@test()
		def reset_and_reuse() {
			let b = new Bitstream()
			b.add(1, 1, 1)
			b.reset()
			b.add(0, 1)

			assert b.position() == 2
			assert b.count() == 1
			assert !b.get(0)
			assert b.get(1)
		}
	}
}
