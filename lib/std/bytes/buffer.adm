partial module std.bytes {
	use std.io

	// A Buffer is a variable-sized buffer of bytes with an underlying byte array which can be written to and read from/
	type Buffer {
		internal b     byte[]
		internal buf   byte[]
		internal index int

		def new(initBuf byte[] = []) {
			self.b = initBuf
			index = 0
		}

		// Read implements std.io.Reader: copies what is unread into `val` and
		// returns how much; 0 once everything written has been read.
		// It cannot fail; the error type comes from io.Reader.
		def read(val byte[]) !int {
			return 0 when index >= b.len()
			let n = (b[index:]).copy(val)
			index += n
			return n
		}

		// read decodes a number of type T from the unread bytes, in the given byte
		// order. Fails when fewer bytes than the number needs are left.
		def read<T: Numeric>(endian Endian = Endian.Big) !T {
			let out T = 0
			buf.len(out.size())
			let got = try self.read(buf)
			fail "reader is at end of buffer" when got < buf.len()
			return out.fromBytes(buf, endian)
		}

		// readFrom appends everything r yields until it reports the end of its
		// stream and returns how many bytes were added. Fails when r does.
		def readFrom(r io.Reader) !int {
			let total = 0
			for {
				let start = b.len()
				grow(32768)
				let n = r.read(b[start:]) onerror (err error) {
					b.len(start)
					fail err
				}
				b.len(start + n)
				break when n == 0
				total += n
			}
			return total
		}

		// grow makes room for at least `extra` more bytes, doubling the
		// capacity so a run of appends stays linear, and extends the length
		// over the new room.
		internal def grow(extra int) {
			let need = b.len() + extra
			b.cap(need.max(b.cap() * 2)) when need > b.cap()
			b.len(need)
		}

		// seek moves the read position to offset, counted from the start, the
		// current position or the end, and returns the new position. Fails when that
		// position lies outside the buffer.
		def seek(offset int, whence Whence = Whence.Start) !int {
			let abs int64
			switch whence {
				case Whence.Start:
					abs = offset
				case Whence.Current:
					abs = int64(index) + offset
				case Whence.End:
					abs = int64(b.len()) + offset
				default:
					fail "invalid seek whence"
			}
			fail "negative seek offset" when abs < 0
			index = uint64(abs)
			return int(abs)
		}

		// Write implements std.io.Writer. Writes append to the backing buffer.
		// It cannot fail; the error type comes from io.Writer.
		def write(val byte[]) !int {
			let start = b.len()
			grow(val.len())
			val.copy(b[start:])
			return val.len()
		}

		// writeString appends the string's bytes and returns how many. It cannot fail.
		def writeString(val string) !int {
			return write(val.bytes())
		}

		// write appends a number encoded in the given byte order. It cannot fail.
		def write<T: Numeric>(val T, endian Endian = Endian.Big) !none {
			try self.write(val.bytes(endian))
			return none
		}

		// Writes the buffer to the provided Writer.
		// Ther return value is the number of bytes written.
		// Fails when w does.
		def writeTo(w io.Writer) !int {
			let n = 0
			for let i = 0; i < b.len() {
				let wn = try w.write(b[i:])
				i += wn
				n += wn
				if n == 0 {
					break
				}
			}
			return n
		}

		// reset discards the contents and rewinds the read position.
		def reset() {
			index = 0
			b.len(0)
		}

		// len returns how many bytes the buffer holds, read or not.
		def len() int {
			return b.len()
		}

		// bytes returns the bytes written so far. The storage is shared with the
		// buffer, but the length is fixed: later writes do not show up in it.
		def bytes() byte[] {
			return b[:b.len()]
		}
	}
}
