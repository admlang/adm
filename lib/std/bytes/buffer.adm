partial module std.bytes {
	use std.io

	// A Buffer is a variable-sized buffer of bytes with an underlying byte array which can be written to and read from/
	type Buffer {
		internal b     byte[]
		internal buf   byte[]
		internal index int

		def new(initBuf byte[] = []) {
			self.b = initBuf
			index = 0
		}

		// Read implements std.io.Reader.
		def read(val byte[]) !int {
			expects {
				assert index < b.len() onerror fail "reader is at end of buffer"
			}
			let n = (b[index:]).copy(val)
			index += n
			return n
		}

		def read<T: Numeric>(endian Endian = Endian.Big) !T {
			let out T = 0
			buf.len(out.size())
			let got = try self.read(buf)
			return out.fromBytes(buf, endian)
		}

		def readFrom(r io.Reader) !int {
			let buffer byte[]
			buffer.cap(1024)
			buffer.len(1024)
			let total = 0
			for {
				let n = r.read(buffer) onerror recover -1
				break when n == -1
				total += n
				if n == 0 {
					break
				}

				b = b + buffer[:n]
			}
			return total
		}

		def seek(offset int, whence Whence = Whence.Start) !int {
			let abs int64
			switch whence {
				case Whence.Start:
					abs = offset
				case Whence.Current:
					abs = int64(index) + offset
				case Whence.End:
					abs = int64(b.len()) + offset
				default:
					fail "invalid seek whence"
			}
			fail "negative seek offset" when abs < 0
			index = uint64(abs)
			return 0
		}

		// Write implements std.io.Writer. Writes append to the backing buffer.
		def write(val byte[]) !int {
			b = b + val
			return val.len()
		}

		def writeString(val string) !int {
			b = b + val.bytes()
			return val.len()
		}

		def write<T: Numeric>(val T, endian Endian = Endian.Big) !none {
			try self.write(val.bytes(endian))
			return none
		}

		// Writes the buffer to the provided Writer.
		// Ther return value is the number of bytes written.
		def writeTo(w io.Writer) !int {
			let n = 0
			for let i = 0; i < b.len() {
				let wn = try w.write(b[i:])
				i += wn
				n += wn
				if n == 0 {
					break
				}
			}
			return n
		}

		def reset() {
			index = 0
			b.len(0)
		}

		def len() int {
			return b.len()
		}

		def bytes() byte[] {
			return b
		}
	}
}
