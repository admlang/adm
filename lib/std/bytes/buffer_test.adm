partial module std.bytes {
	use std.testing

	check "Buffer" {
		@test()
		def writesAppendAcrossGrowth() !none {
			let buf = new Buffer()
			let chunk byte[]
			chunk.len(1000)
			for let i = 0; i < 1000; i++ {
				chunk[i] = byte(i % 251)
			}
			for let i = 0; i < 100; i++ {
				try buf.write(chunk)
			}
			assert buf.len() == 100000
			let all = buf.bytes()
			assert all[0] == byte(0)
			assert all[99999] == byte(999 % 251)
			assert all[50500] == byte(500 % 251)
			try buf.writeString("end")
			assert buf.len() == 100003
		}

		@test()
		def readFromTakesEveryChunk() !none {
			let src byte[]
			src.len(100000)
			for let i = 0; i < src.len(); i++ {
				src[i] = byte(i % 253)
			}
			let buf = new Buffer(byte[1, 2])
			let n = try buf.readFrom(new Reader(src))
			assert n == 100000
			assert buf.len() == 100002
			let all = buf.bytes()
			assert all[1] == byte(2)
			assert all[2] == byte(0)
			assert all[100001] == byte(99999 % 253)
		}

		@test()
		def readReturnsWhatWasWritten() !none {
			let buf = new Buffer()
			try buf.writeString("hello")
			let out byte[]
			out.len(8)
			let n = try buf.read(out)
			assert n == 5
			assert string(out[:n]) == "hello"
		}
	}
}
