partial module std.bytes {
	enum Endian {
		// Byte order where the most significant byte is stored first.
		// Example: 0x12345678 → [12 34 56 78]
		Big,
		// Byte order where the least significant byte is stored first.
		// Example: 0x12345678 → [78 56 34 12]
		Little,
	}

	// nativeEndian returns the target platform's native byte order as an Endian.
	@c("adm_runtime.h", symbol = "adm_is_little_endian", ret = "bool", params = [])
	internal def __isLittleEndian() bool;

	def nativeEndian() Endian {
		return __isLittleEndian() ?? (Endian.Little, Endian.Big)
	}

	enum Whence {
		Start = 0,
		Current = 1,
		End = 2,
	}
}
