// bsdiff 4 (Colin Percival): the patch holds, for one matching region
// after another, the byte differences against the old data (mostly
// zeros, which bzip2 packs to almost nothing) and the new bytes between
// the regions.
//
// The file: `BSDIFF40`, the lengths of the bzip2 streams of the control
// triples and of the differences, the new data's length (each a 64-bit
// little-endian number whose top bit is the sign), then the three bzip2
// streams, the third (the new bytes) to the end. A control triple is how
// many difference bytes to add to the old data, how many new bytes follow,
// and how far the old position then moves.
internal partial module std.bytes.diff.bsdiff {
	use (
		std.bytes
		std.bytes.diff::*
		std.bytes.diff.faults::*
		std.data.compress.bzip2
		std.io
		std.simd
	)

	// Whether the bytes start as a bsdiff patch does.
	def matches(patch byte[]) bool {
		return patch.len() >= 8 && string(patch[:8]) == "BSDIFF40"
	}

	// The patch from `before` to `after`.
	def encode(before byte[], after byte[]) byte[] {
		let index = suffixArray(before)
		let oldSize = before.len()
		let newSize = after.len()
		let ctrl byte[] = []
		let differences byte[] = []
		let extra byte[] = []
		let scan = 0
		let length = 0
		let pos = 0
		let lastScan = 0
		let lastPos = 0
		let lastOffset = 0
		for scan < newSize {
			let oldScore = 0
			scan += length
			let scsc = scan
			for scan < newSize {
				let (found, at) = search(index, before, after, scan)
				length = found
				pos = at
				for scsc < scan + length {
					oldScore++ when scsc + lastOffset < oldSize && before[scsc + lastOffset] == after[scsc]
					scsc++
				}
				break when (length == oldScore && length != 0) || length > oldScore + 8
				oldScore-- when scan + lastOffset < oldSize && before[scan + lastOffset] == after[scan]
				scan++
			}
			if length != oldScore || scan == newSize {
				// How far the last region extends forward, and this one back,
				// where more than half the bytes agree.
				let s = 0
				let sf = 0
				let lenf = 0
				let i = 0
				for lastScan + i < scan && lastPos + i < oldSize {
					s++ when before[lastPos + i] == after[lastScan + i]
					i++
					if s * 2 - i > sf * 2 - lenf {
						sf = s
						lenf = i
					}
				}
				let lenb = 0
				if scan < newSize {
					s = 0
					let sb = 0
					for i = 1; scan >= lastScan + i && pos >= i; i++ {
						s++ when before[pos - i] == after[scan - i]
						if s * 2 - i > sb * 2 - lenb {
							sb = s
							lenb = i
						}
					}
				}
				if lastScan + lenf > scan - lenb {
					let overlap = (lastScan + lenf) - (scan - lenb)
					s = 0
					let ss = 0
					let lens = 0
					for i = 0; i < overlap; i++ {
						s++ when after[lastScan + lenf - overlap + i] == before[lastPos + lenf - overlap + i]
						s-- when after[scan - lenb + i] == before[pos - lenb + i]
						if s > ss {
							ss = s
							lens = i + 1
						}
					}
					lenf += lens - overlap
					lenb -= lens
				}
				appendDifference(differences, after, lastScan, before, lastPos, lenf)
				let extraLength = (scan - lenb) - (lastScan + lenf)
				appendSlice(extra, after, lastScan + lenf, extraLength)
				putInt64(ctrl, lenf)
				putInt64(ctrl, extraLength)
				putInt64(ctrl, (pos - lenb) - (lastPos + lenf))
				lastScan = scan - lenb
				lastPos = pos - lenb
				lastOffset = pos - scan
			}
		}
		let packedCtrl = bzip(ctrl)
		let packedDifferences = bzip(differences)
		let out byte[] = []
		out.push(...("BSDIFF40".bytes()))
		putInt64(out, packedCtrl.len())
		putInt64(out, packedDifferences.len())
		putInt64(out, newSize)
		out.push(...packedCtrl)
		out.push(...packedDifferences)
		out.push(...bzip(extra))
		return out
	}

	// Applies the patch to `before`. Fails `Damaged` when the patch is cut
	// short, its streams are not bzip2, or its triples run past the data.
	def decode(before byte[], patch byte[]) !byte[] {
		fail damaged("a bsdiff patch holds a 32-byte header") when patch.len() < 32
		let ctrlLength = int64At(patch, 8)
		let differencesLength = int64At(patch, 16)
		let newSize = int64At(patch, 24)
		fail damaged("the bsdiff header's lengths are inconsistent") when ctrlLength < 0 || differencesLength < 0 || newSize < 0 || 32 + ctrlLength + differencesLength > patch.len()
		let ctrl = new bzip2.Reader(new bytes.Reader(patch[32:32 + ctrlLength]))
		let differences = new bzip2.Reader(new bytes.Reader(patch[32 + ctrlLength:32 + ctrlLength + differencesLength]))
		let extra = new bzip2.Reader(new bytes.Reader(patch[32 + ctrlLength + differencesLength:]))
		let out byte[] = []
		out.len(newSize)
		let oldSize = before.len()
		let newPos = 0
		let oldPos = 0
		let triple byte[] = []
		triple.len(24)
		for newPos < newSize {
			try fill(ctrl, triple, "control")
			let addLength = int64At(triple, 0)
			let extraLength = int64At(triple, 8)
			let seek = int64At(triple, 16)
			fail damaged("a bsdiff control triple runs past the new data") when addLength < 0 || extraLength < 0 || newPos + addLength > newSize || newPos + addLength + extraLength > newSize
			try fill(differences, out[newPos:newPos + addLength], "difference")
			// The old bytes under the region are added where there are any.
			let from = oldPos.max(0)
			let to = (oldPos + addLength).min(oldSize)
			addOld(out, newPos + (from - oldPos), before, from, to - from) when to > from
			newPos += addLength
			oldPos += addLength
			try fill(extra, out[newPos:newPos + extraLength], "new bytes")
			newPos += extraLength
			oldPos += seek
		}
		return out
	}

	// Fills `buf` from the stream, or fails `Damaged` naming the stream.
	internal def fill(stream bzip2.Reader, buf byte[], what string) !none {
		return none when buf.len() == 0
		io.readFull(stream, buf) onerror (err error) {
			fail PatchError{message: "diff: the bsdiff {what} stream ends early or is damaged: {err.message}", code: PatchErrorKind.Damaged.value, cause: err, kind: PatchErrorKind.Damaged}
		}
		return none
	}

	// The longest match of `after[from:]` among the suffixes of `before`:
	// its length and where it is in `before`.
	internal def search(index int[], before byte[], after byte[], from int) (int, int) {
		let st = 0
		let en = before.len()
		for en - st >= 2 {
			let x = st + (en - st) / 2
			if suffixBefore(before, index[x], after, from) {
				st = x
			} else {
				en = x
			}
		}
		let x = matchLength(before, index[st], after, from)
		let y = matchLength(before, index[en], after, from)
		return x > y ?? ((x, index[st]), (y, index[en]))
	}

	// Whether the suffix of `before` at `i` sorts before `after[from:]`,
	// comparing as far as the shorter of the two.
	internal def suffixBefore(before byte[], i int, after byte[], from int) bool {
		let n = (before.len() - i).min(after.len() - from)
		let k = commonPrefix(before, i, after, from, n)
		return false when k == n
		return before[i + k] < after[from + k]
	}

	// How many bytes the suffix of `before` at `i` and `after[from:]` share.
	internal def matchLength(before byte[], i int, after byte[], from int) int {
		return commonPrefix(before, i, after, from, (before.len() - i).min(after.len() - from))
	}

	// How many bytes from `a[ai]` and `b[bi]` agree, at most `n`: 32 at a
	// time while they do.
	internal def commonPrefix(a byte[], ai int, b byte[], bi int, n int) int {
		let k = 0
		for k + 32 <= n {
			break unless simd.eq(simd.loadBytes32(a, ai + k), simd.loadBytes32(b, bi + k)).all()
			k += 32
		}
		for k < n && a[ai + k] == b[bi + k] {
			k++
		}
		return k
	}

	// Appends `after[at:at+n] - before[from:from+n]`, byte by byte.
	internal def appendDifference(out byte[], after byte[], at int, before byte[], from int, n int) {
		let start = out.len()
		out.len(start + n)
		let k = 0
		for k + 32 <= n {
			simd.storeBytes32(out, start + k, simd.sub(simd.loadBytes32(after, at + k), simd.loadBytes32(before, from + k)))
			k += 32
		}
		for k < n {
			out[start + k] = byte((int(after[at + k]) - int(before[from + k])) & 0xFF)
			k++
		}
	}

	// Adds `before[from:from+n]` onto `out[at:at+n]`, byte by byte.
	internal def addOld(out byte[], at int, before byte[], from int, n int) {
		let k = 0
		for k + 32 <= n {
			simd.storeBytes32(out, at + k, simd.add(simd.loadBytes32(out, at + k), simd.loadBytes32(before, from + k)))
			k += 32
		}
		for k < n {
			out[at + k] = byte((int(out[at + k]) + int(before[from + k])) & 0xFF)
			k++
		}
	}

	internal def appendSlice(out byte[], data byte[], from int, n int) {
		let start = out.len()
		out.len(start + n)
		for let k = 0; k < n; k++ {
			out[start + k] = data[from + k]
		}
	}

	// One bzip2 stream of the bytes.
	internal def bzip(data byte[]) byte[] {
		let buffer = new bytes.Buffer()
		let writer = new bzip2.Writer(buffer)
		writer.write(data) onerror recover 0
		writer.close() onerror recover none
		return buffer.bytes()
	}

	// bsdiff's number: 64 bits little-endian, the top bit the sign of the
	// magnitude.
	internal def putInt64(out byte[], value int) {
		let magnitude = value < 0 ?? (-value, value)
		for let i = 0; i < 8; i++ {
			out.push(byte((magnitude >> (8 * i)) & 0xFF))
		}
		out[out.len() - 1] |= byte(0x80) when value < 0
	}

	internal def int64At(data byte[], at int) int {
		let magnitude = 0
		for let i = 0; i < 7; i++ {
			magnitude |= int(data[at + i]) << (8 * i)
		}
		magnitude |= int(data[at + 7] & byte(0x7F)) << 56
		return data[at + 7] & byte(0x80) != byte(0) ?? (-magnitude, magnitude)
	}
}
