// Binary diffs: a patch that turns one byte array into another, read and
// written in the formats the common tools use, so a patch made here applies
// with bspatch, xdelta3, `zstd --patch-from` or hpatchz, and theirs applies
// here.
//
// ```
// use std.bytes.diff
//
// let patch = diff.diff(before, after)                       // bsdiff
// let patch = diff.diff(before, after, PatchFormat.Vcdiff)   // what xdelta3 reads
// let after = try diff.patch(before, patch)                   // any of the formats
// ```
partial module std.bytes.diff {
	use (
		std.bytes.diff.bsdiff
		std.bytes.diff.hdiff
		std.bytes.diff.vcdiff
		std.data.compress.zstd
		std.errors
	)

	// The format a patch is written in.
	enum PatchFormat {
		// bsdiff 4 (`BSDIFF40`): a suffix array finds the matching regions,
		// the byte differences and the new bytes are bzip2-compressed.
		// The smallest for executables, at the cost of the whole of both
		// files in memory and the slowest run.
		Bsdiff,
		// VCDIFF (RFC 3284) as xdelta3 reads and writes it: windows of
		// ADD, COPY and RUN instructions over the old data, each window
		// with xdelta3's Adler-32 check. Written without secondary
		// compression (`xdelta3 -S none`); read with xdelta3's LZMA too.
		Vcdiff,
		// A Zstandard frame compressed with the old data as its dictionary,
		// as `zstd --patch-from` makes: the fastest, applied by any zstd
		// given the old data.
		Zstd,
		// HDiffPatch's compressed diff (`HDIFF13&`): covers over the old
		// data with their byte differences run-length coded, written with
		// its zstd plugin; read with its zlib, bzip2, lzma and lzma2 ones too.
		HDiff,
	}

	// Why a patch could not be applied.
	enum PatchErrorKind {
		// The bytes are in no format known here.
		Unknown = "EUNKNOWN",
		// The patch is damaged, cut short, or asks for what cannot be.
		Damaged = "EDAMAGED",
		// The patch uses an option of its format that is not supported
		// here: xdelta3's DJW and FGK secondary compressors, an HDiffPatch
		// compression plugin other than the five named.
		Unsupported = "EUNSUPPORTED",
		// The old data is not the data the patch was made against: a
		// checksum does not match (a bsdiff patch carries none, so wrong
		// old data gives wrong new data there).
		Mismatch = "EMISMATCH",
	}

	// The error `patch` fails with: `kind` says why, `code` is its text.
	struct PatchError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    PatchErrorKind
	}

	// Writes the patch that turns `before` into `after`, in `format`.
	def diff(before byte[], after byte[], format PatchFormat = PatchFormat.Bsdiff) byte[] {
		switch format {
			case PatchFormat.Vcdiff:
				return vcdiff.encode(before, after)
			case PatchFormat.Zstd:
				return zstd.compress(after, before)
			case PatchFormat.HDiff:
				return hdiff.encode(before, after)
		}
		return bsdiff.encode(before, after)
	}

	// The format `patch` is in, told by its first bytes; none for bytes in
	// no format known here.
	def formatOf(patch byte[]) ?PatchFormat {
		return PatchFormat.Bsdiff when bsdiff.matches(patch)
		return PatchFormat.Vcdiff when vcdiff.matches(patch)
		return PatchFormat.HDiff when hdiff.matches(patch)
		return PatchFormat.Zstd when patch.len() >= 4 && patch[0] == byte(0x28) && patch[1] == byte(0xB5) && patch[2] == byte(0x2F) && patch[3] == byte(0xFD)
		return none
	}

	// Applies `delta`, a patch in any of the formats, to `before` and
	// returns the data it was made for.
	//
	// Fails with a `PatchError`: `Unknown` for bytes in no format known
	// here, `Damaged` for a patch cut short or inconsistent, `Unsupported`
	// for an option of its format not read here, `Mismatch` when a check
	// shows `before` is not what the patch was made against.
	def patch(before byte[], delta byte[]) !byte[] {
		let format = formatOf(delta)
		fail PatchError{message: "diff: the patch is in no known format", code: PatchErrorKind.Unknown.value, kind: PatchErrorKind.Unknown} when format is none
		switch format {
			case PatchFormat.Bsdiff:
				return bsdiff.decode(before, delta)
			case PatchFormat.Vcdiff:
				return vcdiff.decode(before, delta)
			case PatchFormat.HDiff:
				return hdiff.decode(before, delta)
		}
		return zstd.decompress(delta, 0, before) onerror (err error) {
			let kind = err.message.contains("checksum") ?? (PatchErrorKind.Mismatch, PatchErrorKind.Damaged)
			fail PatchError{message: "diff: {err.message}", code: kind.value, cause: err, kind: kind}
		}
	}
}
