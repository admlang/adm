partial module std.bytes.diff {
	use std.testing

	// `length` bytes from a linear congruential generator: the same for the
	// same seed, as the fixtures of this suite were made from in Python.
	internal def noise(length int, seed int) byte[] {
		let out byte[] = []
		let state = uint32(seed)
		for let i = 0; i < length; i++ {
			state = state * uint32(1664525) + uint32(1013904223)
			out.push(byte((state >> 24) & uint32(0xFF)))
		}
		return out
	}

	// The sample the tool fixtures were made for: 600 bytes of noise from
	// seed 12345, and an edited copy of it (bytes replaced, a region moved,
	// a tail added).
	internal def sampleBefore() byte[] {
		return noise(600, 12345)
	}

	internal def sampleAfter() byte[] {
		let old = sampleBefore()
		let out = old[:100].clone()
		out.push(...("HELLOWORLD".bytes()))
		out.push(...old[110:300])
		out.push(...old[350:])
		out.push(...("tail".bytes()))
		return out
	}

	// Whether a format read from a patch is the one wanted.
	internal def isFormat(found ?PatchFormat, want PatchFormat) bool {
		return false when found is none
		return found == want
	}

	internal def hex(text string) byte[] {
		let out byte[] = []
		let digits = text.bytes()
		for let i = 0; i + 1 < digits.len(); i += 2 {
			out.push(byte(parseInt<int>(string(digits[i:i + 2]), 16)))
		}
		return out
	}

	// Pairs of old and new data that exercise the formats: identical,
	// empty on one side, small edits, moved blocks, long runs, all new.
	internal def pairs() (byte[], byte[])[] {
		let base = noise(5000, 7)
		let moved = base[2000:].clone()
		moved.push(...base[:2000])
		let edited = base[:1000].clone()
		edited.push(...("some new text in the middle".bytes()))
		edited.push(...base[1000:3000])
		edited.push(...base[3100:])
		let runs byte[] = []
		runs.len(4000)
		runs.fill(byte(0))
		runs.fill(byte(0xFF), 1000, 1500)
		let runsEdited = runs.clone()
		runsEdited.fill(byte(7), 2000, 2010)
		let blank byte[] = []
		return [
			(base, base),
			(base, edited),
			(base, moved),
			(blank, base),
			(base, blank),
			(blank, blank),
			(runs, runsEdited),
			(base, noise(3000, 99)),
			(noise(100, 3), noise(100, 3)[:50]),
			(noise(200000, 11), noise(200000, 11)[:150000]),
		]
	}

	check "Binary diffs" {
		// Every format turns the old data into the new, and a patch names
		// its format.
		@test()
		def TestRoundTrips() !none {
			for let (_, format) in [PatchFormat.Bsdiff, PatchFormat.Vcdiff, PatchFormat.Zstd, PatchFormat.HDiff] {
				for let (i, pair) in pairs() {
					let (before, after) = pair
					let delta = diff(before, after, format)
					assert isFormat(formatOf(delta), format)
					let back = patch(before, delta) onerror (err error) {
						fail "{format} pair {i}: {err.message}"
					}
					fail "{format} pair {i}: the patch gives other data" unless back.equals(after)
				}
			}
			return none
		}

		// A patch of a small edit is far smaller than the data, in every format.
		@test()
		def TestPatchesAreSmall() !none {
			let before = noise(50000, 5)
			let after = before[:20000].clone()
			after.push(...("a few bytes".bytes()))
			after.push(...before[20000:])
			for let (_, format) in [PatchFormat.Bsdiff, PatchFormat.Vcdiff, PatchFormat.Zstd, PatchFormat.HDiff] {
				let delta = diff(before, after, format)
				fail "{format}: {delta.len()} bytes for an edit of 11" when delta.len() > 400
				assert delta.len() > 0
			}
			return none
		}

		// Patches the tools made apply here: bsdiff 4.3, xdelta3 with and
		// without its LZMA secondary compression, and zstd --patch-from.
		@test()
		def TestReadsTheToolsPatches() !none {
			let before = sampleBefore()
			let after = sampleAfter()
			let bs = hex("")
			assert isFormat(formatOf(bs), PatchFormat.Bsdiff)
			assert (try patch(before, bs)).equals(after)
			let plain = hex("d6c3c400000584580026842a000e0a04503c17d448454c4c4f574f524c447461696c13640b13813e43817a05006e8170")
			let lzma = hex("d6c3c4000502096e65772f2f6f6c642f058458005e842a032a2604503c17d40efd377a585a000000ff12d941020021010c0000008f98419c01000d48454c4c4f574f524c447461696c0afd377a585a000000ff12d941020021010c0000008f98419c01000913640b13813e43817a05006e8170")
			let zst = hex("28b52ffd642a01e500007048454c4c4f574f524c447461696c0300f71482023b4061d8920a20838614c1")
			assert isFormat(formatOf(plain), PatchFormat.Vcdiff) && isFormat(formatOf(lzma), PatchFormat.Vcdiff) && isFormat(formatOf(zst), PatchFormat.Zstd)
			assert (try patch(before, plain)).equals(after)
			assert (try patch(before, lzma)).equals(after)
			assert (try patch(before, zst)).equals(after)
			return none
		}

		// What cannot be applied says why.
		@test()
		def TestErrors() !none {
			let before = sampleBefore()
			let after = sampleAfter()
			let kinds PatchErrorKind[] = []
			patch(before, "not a patch".bytes()) onerror (err error) {
				kinds.push(err.kind) when err is PatchError
				recover []
			}
			// Wrong old data of the same length: the formats with a checksum
			// say so; bsdiff and HDiffPatch carry none and give wrong data.
			let other = noise(600, 1)
			for let (_, format) in [PatchFormat.Vcdiff, PatchFormat.Zstd] {
				patch(other, diff(before, after, format)) onerror (err error) {
					kinds.push(err.kind) when err is PatchError
					recover []
				}
			}
			for let (_, format) in [PatchFormat.Bsdiff, PatchFormat.HDiff] {
				let wrong = try patch(other, diff(before, after, format))
				assert wrong.len() == after.len() && !wrong.equals(after)
			}
			for let (_, format) in [PatchFormat.Bsdiff, PatchFormat.Vcdiff, PatchFormat.HDiff] {
				let cut = diff(before, after, format)
				patch(before, cut[:cut.len() / 2]) onerror (err error) {
					kinds.push(err.kind) when err is PatchError
					recover []
				}
			}
			// xdelta3's DJW secondary compression.
			patch(before, hex("d6c3c40001010000")) onerror (err error) {
				kinds.push(err.kind) when err is PatchError
				recover []
			}
			assert kinds.len() == 7
			assert kinds[0] == PatchErrorKind.Unknown
			assert kinds[1] == PatchErrorKind.Mismatch && kinds[2] == PatchErrorKind.Mismatch
			assert kinds[3] == PatchErrorKind.Damaged && kinds[4] == PatchErrorKind.Damaged && kinds[5] == PatchErrorKind.Damaged
			assert kinds[6] == PatchErrorKind.Unsupported
			return none
		}
	}
}
