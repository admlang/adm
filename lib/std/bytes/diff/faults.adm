// The errors the formats fail with, by kind.
internal partial module std.bytes.diff.faults {
	use std.bytes.diff::(PatchError, PatchErrorKind)

	// A `Damaged` error with this reason.
	def damaged(reason string) PatchError {
		return PatchError{message: "diff: {reason}", code: PatchErrorKind.Damaged.value, kind: PatchErrorKind.Damaged}
	}

	// An `Unsupported` error with this reason.
	def unsupported(reason string) PatchError {
		return PatchError{message: "diff: {reason}", code: PatchErrorKind.Unsupported.value, kind: PatchErrorKind.Unsupported}
	}

	// A `Mismatch` error with this reason.
	def mismatch(reason string) PatchError {
		return PatchError{message: "diff: {reason}", code: PatchErrorKind.Mismatch.value, kind: PatchErrorKind.Mismatch}
	}
}
