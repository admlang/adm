// HDiffPatch's compressed diff (`HDIFF13&`): the new data as covers, runs
// found in the old data, with the byte differences under each cover
// run-length coded, and the new bytes between the covers as they are;
// each of the four parts compressed by a named codec, or stored.
//
// The file: `HDIFF13&`, the codec's name and a zero byte, then the new
// and old lengths, the cover count and the stored and compressed lengths
// of the four parts (covers, run-length control, run-length bytes, new
// bytes), each a base-128 number, high bits first, the continuation bit
// at the top of each byte; then the four parts. A cover is its start in
// the old data relative to the last cover's end there (the top bit of the
// first byte its sign), its start in the new data relative to the last
// cover's end there, and its length. The run-length control codes a type
// in its top two bits (a run of 0, of 255, of the byte that follows in the
// bytes part, or that many bytes from the bytes part) over a length less
// one. Written with the `zstd` codec; read with `zlib` (a window-bits
// byte, then raw deflate), `bz2`, `lzma` (a properties byte, the
// dictionary size, raw LZMA), `lzma2` (a dictionary byte, raw LZMA2) and
// `zstd`, and stored parts.
internal partial module std.bytes.diff.hdiff {
	use (
		std.bytes
		std.bytes.diff::*
		std.bytes.diff.faults::*
		std.bytes.diff.matcher::(Matcher)
		std.data.compress.bzip2
		std.data.compress.flate
		std.data.compress.lzma
		std.data.compress.zstd
		std.io
	)

	internal const (
		typeRle0   = 0
		typeRle255 = 1
		typeRle    = 2
		typeUnrle  = 3
		// A match shorter than this costs more as a cover than as new bytes.
		leastMatch = 6
	)

	// Whether the bytes start as an HDiffPatch compressed diff does.
	def matches(patch byte[]) bool {
		return patch.len() >= 8 && string(patch[:8]) == "HDIFF13&"
	}

	// The patch from `before` to `after`.
	def encode(before byte[], after byte[]) byte[] {
		let matcher = new Matcher(before, after.len())
		let found = matcher.matches(after, 0, after.len(), leastMatch, false)
		let covers byte[] = []
		let rleCtrl byte[] = []
		let rleCode byte[] = []
		let fresh byte[] = []
		let oldBack = 0
		let newBack = 0
		let pos = 0
		let differences byte[] = []
		for let (_, m) in found {
			if m.address >= oldBack {
				packNumber(covers, m.address - oldBack, 0, 1)
			} else {
				packNumber(covers, oldBack - m.address, 1, 1)
			}
			packNumber(covers, m.at - newBack, 0, 0)
			packNumber(covers, m.length, 0, 0)
			oldBack = m.address + m.length
			newBack = m.at + m.length
			appendSlice(fresh, after, pos, m.at - pos)
			for let i = 0; i < m.length; i++ {
				differences.push(byte((int(after[m.at + i]) - int(before[m.address + i])) & 0xFF))
			}
			pos = m.at + m.length
		}
		appendSlice(fresh, after, pos, after.len() - pos)
		runLength(differences, rleCtrl, rleCode)

		let out byte[] = []
		out.push(...("HDIFF13&zstd".bytes()))
		out.push(byte(0))
		packNumber(out, after.len(), 0, 0)
		packNumber(out, before.len(), 0, 0)
		packNumber(out, found.len(), 0, 0)
		let packedCovers = pack(covers)
		let packedCtrl = pack(rleCtrl)
		let packedCode = pack(rleCode)
		let packedFresh = pack(fresh)
		packNumber(out, covers.len(), 0, 0)
		packNumber(out, packedCovers.len(), 0, 0)
		packNumber(out, rleCtrl.len(), 0, 0)
		packNumber(out, packedCtrl.len(), 0, 0)
		packNumber(out, rleCode.len(), 0, 0)
		packNumber(out, packedCode.len(), 0, 0)
		packNumber(out, fresh.len(), 0, 0)
		packNumber(out, packedFresh.len(), 0, 0)
		out.push(...(packedCovers.len() > 0 ?? (packedCovers, covers)))
		out.push(...(packedCtrl.len() > 0 ?? (packedCtrl, rleCtrl)))
		out.push(...(packedCode.len() > 0 ?? (packedCode, rleCode)))
		out.push(...(packedFresh.len() > 0 ?? (packedFresh, fresh)))
		return out
	}

	// The part zstd-compressed, or empty when that is no smaller: the part
	// is then stored.
	internal def pack(part byte[]) byte[] {
		return [] when part.len() == 0
		let packed = zstd.compress(part)
		return packed.len() < part.len() ?? (packed, [])
	}

	// Codes the bytes run-length: runs of 0 and of 255 of 3 or more, runs
	// of another byte of 4 or more, the rest as they are.
	internal def runLength(data byte[], ctrl byte[], code byte[]) {
		let n = data.len()
		let pos = 0
		let literalStart = 0
		for pos < n {
			let end = pos + 1
			for end < n && data[end] == data[pos] {
				end++
			}
			let run = end - pos
			let b = int(data[pos])
			let worth = (b == 0 || b == 255) ?? (run >= 3, run >= 4)
			if !worth {
				pos = end
				continue
			}
			if pos > literalStart {
				packNumber(ctrl, pos - literalStart - 1, typeUnrle, 2)
				appendSlice(code, data, literalStart, pos - literalStart)
			}
			if b == 0 {
				packNumber(ctrl, run - 1, typeRle0, 2)
			} else if b == 255 {
				packNumber(ctrl, run - 1, typeRle255, 2)
			} else {
				packNumber(ctrl, run - 1, typeRle, 2)
				code.push(data[pos])
			}
			pos = end
			literalStart = end
		}
		if n > literalStart {
			packNumber(ctrl, n - literalStart - 1, typeUnrle, 2)
			appendSlice(code, data, literalStart, n - literalStart)
		}
	}

	// Applies the patch to `before`.
	def decode(before byte[], patch byte[]) !byte[] {
		let r = new Cursor(patch, 8)
		let name byte[] = []
		for {
			let b = try r.byte()
			break when b == 0
			name.push(byte(b))
		}
		let codec = string(name)
		fail unsupported("HDiffPatch compression codec \"{codec}\" is not read") unless codec := "" || "zstd" || "zlib" || "bz2" || "lzma" || "lzma2"
		let newSize = try r.number(0)
		let oldSize = try r.number(0)
		fail mismatch("the patch was made against {oldSize} bytes, not {before.len()}") when oldSize != before.len()
		let coverCount = try r.number(0)
		let sizes int[] = []
		for let i = 0; i < 8; i++ {
			sizes.push(try r.number(0))
		}
		let covers = try part(r, codec, sizes[0], sizes[1])
		let rleCtrl = try part(r, codec, sizes[2], sizes[3])
		let rleCode = try part(r, codec, sizes[4], sizes[5])
		let fresh = try part(r, codec, sizes[6], sizes[7])
		fail damaged("the HDiffPatch file holds more than its parts") unless r.done()

		let out byte[] = []
		out.len(newSize)
		let coverAt = new Cursor(covers, 0)
		let ctrlAt = new Cursor(rleCtrl, 0)
		let codeAt = new Cursor(rleCode, 0)
		let freshAt = 0
		let differences = new RunLengthReader(ctrlAt, codeAt)
		let oldBack = 0
		let newBack = 0
		let pos = 0
		for let c = 0; c < coverCount; c++ {
			let (oldStep, back) = try coverAt.numberWithTag(1)
			let oldPos = back == 0 ?? (oldBack + oldStep, oldBack - oldStep)
			let newPos = newBack + (try coverAt.number(0))
			let length = try coverAt.number(0)
			fail damaged("a cover is outside the data") when oldPos < 0 || oldPos + length > oldSize || newPos < pos || newPos + length > newSize
			freshAt = try copyFresh(out, pos, fresh, freshAt, newPos - pos)
			for let i = 0; i < length; i++ {
				out[newPos + i] = byte((int(before[oldPos + i]) + (try differences.next())) & 0xFF)
			}
			pos = newPos + length
			oldBack = oldPos + length
			newBack = pos
		}
		freshAt = try copyFresh(out, pos, fresh, freshAt, newSize - pos)
		fail damaged("the HDiffPatch parts hold more than the covers use") unless freshAt == fresh.len() && coverAt.done() && differences.done()
		return out
	}

	// Copies `n` of the new bytes into `out` at `at`; returns where the new
	// bytes continue.
	internal def copyFresh(out byte[], at int, fresh byte[], from int, n int) !int {
		fail damaged("the covers want more new bytes than the patch holds") when from + n > fresh.len()
		for let i = 0; i < n; i++ {
			out[at + i] = fresh[from + i]
		}
		return from + n
	}

	// One part: stored (`packed` 0) or decompressed by the codec to
	// `size` bytes.
	internal def part(r Cursor, codec string, size int, packed int) !byte[] {
		return r.take(size) when packed == 0
		let data = try r.take(packed)
		let out byte[] = []
		if codec == "zstd" {
			out = zstd.decompress(data, size) onerror (err error) {
				fail partDamaged(codec, err)
			}
		} else if codec == "bz2" {
			out = io.readAll(new bzip2.Reader(new bytes.Reader(data))) onerror (err error) {
				fail partDamaged(codec, err)
			}
		} else if codec == "zlib" {
			fail damaged("a zlib part starts with its window bits") when data.len() < 1
			let (inflated, _) = flate.inflate(data, 1, size) onerror (err error) {
				fail partDamaged(codec, err)
			}
			out = inflated
		} else if codec == "lzma" {
			fail damaged("an lzma part starts with 5 property bytes") when data.len() < 5
			out = io.readAll(new lzma.Reader(new bytes.Reader(data[5:]), data[:5], int64(size))) onerror (err error) {
				fail partDamaged(codec, err)
			}
		} else {
			fail damaged("an lzma2 part starts with its dictionary byte") when data.len() < 1
			out = io.readAll(new lzma.Reader2(new bytes.Reader(data[1:]), data[:1], int64(size))) onerror (err error) {
				fail partDamaged(codec, err)
			}
		}
		fail damaged("a {codec} part decompresses to {out.len()} bytes, the header says {size}") when out.len() != size
		return out
	}

	internal def partDamaged(codec string, err error) PatchError {
		return PatchError{message: "diff: an HDiffPatch {codec} part is damaged: {err.message}", code: PatchErrorKind.Damaged.value, cause: err, kind: PatchErrorKind.Damaged}
	}

	// Reads the run-length coded byte differences in turn.
	internal type RunLengthReader {
		ctrl   Cursor
		code   Cursor
		kind   int
		left   int
		repeat int

		def new(ctrl Cursor, code Cursor) {
			self.ctrl = ctrl
			self.code = code
			kind = typeUnrle
			left = 0
			repeat = 0
		}

		def next() !int {
			if left == 0 {
				let (length, tag) = try ctrl.numberWithTag(2)
				kind = tag
				left = length + 1
				repeat = 0 when kind == typeRle0
				repeat = 255 when kind == typeRle255
				repeat = try code.byte() when kind == typeRle
			}
			left--
			return try code.byte() when kind == typeUnrle
			return repeat
		}

		def done() bool {
			return left == 0 && ctrl.done() && code.done()
		}
	}

	// A position in a part, with the readers of HDiffPatch's numbers that
	// fail `Damaged` at the end.
	internal type Cursor {
		data byte[]
		pos  int

		def new(data byte[], pos int) {
			self.data = data
			self.pos = pos
		}

		def done() bool {
			return pos >= data.len()
		}

		def byte() !int {
			fail damaged("the HDiffPatch data ends early") when pos >= data.len()
			let v = int(data[pos])
			pos++
			return v
		}

		def take(n int) !byte[] {
			fail damaged("the HDiffPatch data ends early") when n < 0 || pos + n > data.len()
			let out = data[pos:pos + n]
			pos += n
			return out
		}

		def number(tagBits int) !int {
			let (value, _) = try numberWithTag(tagBits)
			return value
		}

		// A number whose first byte carries `tagBits` tag bits at the top,
		// then the continuation bit, then the highest value bits; the bytes
		// after hold a continuation bit and 7 value bits each.
		def numberWithTag(tagBits int) !(int, int) {
			let first = try byte()
			let tag = first >> (8 - tagBits)
			let more = 1 << (7 - tagBits)
			let value = first & (more - 1)
			if first & more != 0 {
				for let i = 0; i < 10; i++ {
					let b = try byte()
					value = (value << 7) | (b & 0x7F)
					break when b & 0x80 == 0
					fail damaged("an HDiffPatch number is too long") when i == 9
				}
			}
			return (value, tag)
		}
	}

	// Appends a number as HDiffPatch packs it, with `tag` in the top
	// `tagBits` bits of the first byte.
	internal def packNumber(out byte[], value int, tag int, tagBits int) {
		let firstBits = 7 - tagBits
		let groups int[] = []
		let v = value
		for v >= (1 << firstBits) {
			groups.push(v & 0x7F)
			v >>= 7
		}
		let first = (tag << (8 - tagBits)) | v
		first |= 1 << firstBits when groups.len() > 0
		out.push(byte(first))
		for let i = groups.len() - 1; i >= 0; i-- {
			out.push(byte(i > 0 ?? (groups[i] | 0x80, groups[i])))
		}
	}

	internal def appendSlice(out byte[], data byte[], from int, n int) {
		let start = out.len()
		out.len(start + n)
		for let k = 0; k < n; k++ {
			out[start + k] = data[from + k]
		}
	}
}
