// The match finder the VCDIFF and HDiffPatch writers share: where runs of
// the new data are found in the old data, or earlier in the new data.
internal partial module std.bytes.diff.matcher {
	use std.simd

	// A run of the new data found elsewhere: `at` is its start in the new
	// data, `address` where the same bytes are in the address space the
	// matcher works in (the old data, then the new data from the window's
	// start), `length` how many.
	struct Match {
		at      int
		length  int
		address int
	}

	// Finds, for a window of the new data at a time, the runs that the old
	// data or the window before them already holds. It remembers where
	// every 4-byte word was seen last; the old data is indexed once, at
	// every position when the table has room for that, else at one in every
	// `step`, which still finds every run of `step` + 3 bytes or more.
	type Matcher {
		// The old data, then the window of the new data being matched.
		internal data  byte[]
		// Where the window starts in `data`: the old data's length.
		internal split int
		internal table int[]
		internal shift uint32

		def new(old byte[], windowSize int) {
			split = old.len()
			data = []
			data.len(split + windowSize)
			for let i = 0; i < split; i++ {
				data[i] = old[i]
			}
			let slots = 131072
			for slots < 2 * (split + windowSize) && slots < 16777216 {
				slots *= 2
			}
			table = []
			table.len(slots)
			table.fill(-1)
			shift = uint32(32)
			for let n = 1; n < slots; n *= 2 {
				shift -= uint32(1)
			}
			let room = slots / 2
			let step = (split + room - 1) / room
			step = 1 when step < 1
			for let pos = 0; pos + 4 <= split; pos += step {
				table[slotOf(pos)] = pos
			}
		}

		// The old data's length: addresses below it are in the old data,
		// those from it on in the window.
		def oldLength() int {
			return split
		}

		internal def slotOf(pos int) int {
			let word = uint32(data[pos]) | (uint32(data[pos + 1]) << 8) | (uint32(data[pos + 2]) << 16) | (uint32(data[pos + 3]) << 24)
			return int((word * uint32(2654435761)) >> shift)
		}

		// The matches of `fresh[from:to]`, in order and not overlapping, each
		// at least `least` bytes long; with `within` off only the old data is
		// matched, else the window before a position too. A match never runs
		// across the end of the old data.
		def matches(fresh byte[], from int, to int, least int, within bool) Match[] {
			let size = to - from
			data.len(split + size)
			for let i = 0; i < size; i++ {
				data[split + i] = fresh[from + i]
			}
			let found Match[] = []
			let end = split + size
			let anchor = split
			let pos = split
			for pos + 4 <= end {
				let slot = slotOf(pos)
				let seen = table[slot]
				table[slot] = pos when within
				if seen < 0 || (seen >= split && !within) || !sameWord(seen, pos) {
					pos++
					continue
				}
				// The match reaches forward as far as the bytes agree, and
				// back to the last match, but never across the old data's end.
				let limit = seen < split ?? ((split - seen).min(end - pos), end - pos)
				let length = commonPrefix(seen, pos, limit)
				let start = pos
				let at = seen
				let floor = seen < split ?? (0, split)
				for start > anchor && at > floor && data[start - 1] == data[at - 1] {
					start--
					at--
					length++
				}
				if length < least {
					pos++
					continue
				}
				found.push(Match{at: from + (start - split), length: length, address: at})
				if within {
					for let p = pos + 1; p < start + length && p + 4 <= end; p++ {
						table[slotOf(p)] = p
					}
				}
				pos = start + length
				anchor = pos
			}
			return found
		}

		internal def sameWord(a int, b int) bool {
			return data[a] == data[b] && data[a + 1] == data[b + 1] && data[a + 2] == data[b + 2] && data[a + 3] == data[b + 3]
		}

		// How many bytes from `a` and from `b` agree, at most `limit`:
		// 32 at a time while they do.
		internal def commonPrefix(a int, b int, limit int) int {
			let k = 0
			for k + 32 <= limit {
				break unless simd.eq(simd.loadBytes32(data, a + k), simd.loadBytes32(data, b + k)).all()
				k += 32
			}
			for k < limit && data[a + k] == data[b + k] {
				k++
			}
			return k
		}
	}
}
