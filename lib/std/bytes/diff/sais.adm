// The suffix array bsdiff searches: every suffix of the old data in sorted
// order, built by induced sorting (SA-IS, Nong, Zhang and Chan 2009) in
// time linear in the data.
internal partial module std.bytes.diff.bsdiff {
	// The suffixes of `data` sorted, one more than its length: the first
	// entry is the empty suffix at `data.len()`, which sorts before every
	// other, as the suffix array bsdiff builds has it.
	def suffixArray(data byte[]) int[] {
		let n = data.len()
		let text int[] = []
		text.len(n + 1)
		for let i = 0; i < n; i++ {
			text[i] = int(data[i]) + 1
		}
		text[n] = 0
		return induce(text, 257)
	}

	// The suffix array of `text`, whose last symbol is 0 and occurs there
	// alone; the symbols are below `symbols`.
	internal def induce(text int[], symbols int) int[] {
		let n = text.len()
		let sa int[] = []
		sa.len(n)
		if n == 1 {
			sa[0] = 0
			return sa
		}
		// Each suffix is S-type when it sorts after the next one.
		let stype bool[] = []
		stype.len(n)
		stype[n - 1] = true
		stype[n - 2] = false
		for let i = n - 3; i >= 0; i-- {
			stype[i] = text[i] < text[i + 1] || (text[i] == text[i + 1] && stype[i + 1])
		}
		let buckets int[] = []
		buckets.len(symbols)

		// Sort the LMS substrings by putting each at the end of its bucket and
		// inducing the rest.
		bucketEnds(text, buckets, symbols)
		sa.fill(-1)
		for let i = 1; i < n; i++ {
			if stype[i] && !stype[i - 1] {
				buckets[text[i]]--
				sa[buckets[text[i]]] = i
			}
		}
		induceL(text, sa, stype, buckets, symbols)
		induceS(text, sa, stype, buckets, symbols)

		// Name the sorted LMS substrings: equal ones get one name.
		let lms = 0
		for let i = 0; i < n; i++ {
			let p = sa[i]
			if p > 0 && stype[p] && !stype[p - 1] {
				sa[lms] = p
				lms++
			}
		}
		for let i = lms; i < n; i++ {
			sa[i] = -1
		}
		let names = 0
		let prev = -1
		for let i = 0; i < lms; i++ {
			let pos = sa[i]
			let differs = false
			for let d = 0; d < n; d++ {
				if prev < 0 || text[pos + d] != text[prev + d] || stype[pos + d] != stype[prev + d] {
					differs = true
					break
				}
				let lmsPos = pos + d > 0 && stype[pos + d] && !stype[pos + d - 1]
				let lmsPrev = prev + d > 0 && stype[prev + d] && !stype[prev + d - 1]
				break when d > 0 && (lmsPos || lmsPrev)
			}
			if differs {
				names++
				prev = pos
			}
			sa[lms + pos / 2] = names - 1
		}
		let reduced int[] = []
		reduced.len(lms)
		let j = lms - 1
		for let i = n - 1; i >= lms; i-- {
			if sa[i] >= 0 {
				reduced[j] = sa[i]
				j--
			}
		}

		// Sort the LMS suffixes through the reduced problem, directly when
		// every name is distinct.
		let order int[] = []
		if names < lms {
			order = induce(reduced, names)
		} else {
			order.len(lms)
			for let i = 0; i < lms; i++ {
				order[reduced[i]] = i
			}
		}

		// Induce the whole array from the sorted LMS suffixes.
		let positions int[] = []
		positions.len(lms)
		j = 0
		for let i = 1; i < n; i++ {
			if stype[i] && !stype[i - 1] {
				positions[j] = i
				j++
			}
		}
		bucketEnds(text, buckets, symbols)
		sa.fill(-1)
		for let i = lms - 1; i >= 0; i-- {
			let p = positions[order[i]]
			buckets[text[p]]--
			sa[buckets[text[p]]] = p
		}
		induceL(text, sa, stype, buckets, symbols)
		induceS(text, sa, stype, buckets, symbols)
		return sa
	}

	// Where each symbol's bucket starts.
	internal def bucketStarts(text int[], buckets int[], symbols int) {
		buckets.fill(0)
		for let (_, c) in text {
			buckets[c]++
		}
		let sum = 0
		for let c = 0; c < symbols; c++ {
			let count = buckets[c]
			buckets[c] = sum
			sum += count
		}
	}

	// Where each symbol's bucket ends (one past its last slot).
	internal def bucketEnds(text int[], buckets int[], symbols int) {
		buckets.fill(0)
		for let (_, c) in text {
			buckets[c]++
		}
		let sum = 0
		for let c = 0; c < symbols; c++ {
			sum += buckets[c]
			buckets[c] = sum
		}
	}

	// Places the L-type suffixes from the sorted ones, scanning forward.
	internal def induceL(text int[], sa int[], stype bool[], buckets int[], symbols int) {
		bucketStarts(text, buckets, symbols)
		for let i = 0; i < sa.len(); i++ {
			let j = sa[i] - 1
			if j >= 0 && !stype[j] {
				sa[buckets[text[j]]] = j
				buckets[text[j]]++
			}
		}
	}

	// Places the S-type suffixes from the L-type ones, scanning backward.
	internal def induceS(text int[], sa int[], stype bool[], buckets int[], symbols int) {
		bucketEnds(text, buckets, symbols)
		for let i = sa.len() - 1; i >= 0; i-- {
			let j = sa[i] - 1
			if j >= 0 && stype[j] {
				buckets[text[j]]--
				sa[buckets[text[j]]] = j
			}
		}
	}
}
