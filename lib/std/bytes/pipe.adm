partial module std.bytes {
	// Pipe is an in-memory stream between two tasks: what one writes the
	// other reads, in order. A program joins a client and a server of its
	// own with two of them, one for each direction.
	//
	// ```
	// let pipe = new Pipe()
	// async produce(pipe)          // writes, then pipe.close()
	// let n = try pipe.read(buf)   // blocks until bytes arrive; 0 after close
	// ```
	type Pipe {
		internal chunks        channel<byte[]>
		internal rest          byte[]
		internal ended         bool
		internal atomic closed bool

		// capacity is how many writes may wait unread before a write blocks.
		def new(capacity int = 256) {
			chunks = new channel<byte[]>(capacity)
		}

		// Write implements std.io.Writer: hands a copy of buf to the reader
		// and returns its length, blocking while the pipe is full. Fails
		// once the pipe is closed.
		def write(buf byte[]) !int {
			fail "pipe: write after close" when closed
			chunks <- buf.clone() when buf.len() > 0
			return buf.len()
		}

		// Read implements std.io.Reader: blocks until bytes arrive and
		// returns how many it copied into buf; 0 once the pipe is closed and
		// everything written before was read. Does not fail.
		def read(buf byte[]) !int {
			return 0 when buf.len() == 0
			if rest.len() == 0 {
				return 0 when ended
				let chunk = <-chunks
				if chunk.len() == 0 {
					ended = true
					return 0
				}
				rest = chunk
			}
			let n = rest.copy(buf)
			rest = rest[n:]
			return n
		}

		// Close implements std.io.Closer: the reader sees the end of the
		// stream after what was written. Closing again does nothing. Does
		// not fail.
		def close() !none {
			return none when closed
			closed = true
			chunks <- byte[]
			return none
		}
	}
}
