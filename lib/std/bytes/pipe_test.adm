partial module std.bytes {
	use std.testing

	internal async def pipeProduce(pipe Pipe) {
		pipe.write("hello ".bytes()) onerror recover 0
		pipe.write("world".bytes()) onerror recover 0
		pipe.close() onerror recover none
	}

	check "Pipe" {
		@test()
		def TestPipe() !none {
			let pipe = new Pipe()
			let made = pipeProduce(pipe)
			let got byte[]
			let buf byte[]
			buf.len(4)
			for {
				let n = try pipe.read(buf)
				break when n == 0
				got += buf[0:n]
			}
			await made
			assert string(got) == "hello world"
			// The end stays the end, and a closed pipe takes no more.
			assert (try pipe.read(buf)) == 0
			try testing.expectError(pipe.write("more".bytes()))
			try pipe.close()
			return none
		}
	}
}
