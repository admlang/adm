partial module std.bytes {
	type Reader {
		internal b        byte[]
		internal index    uint64
		internal endianes Endian

		def new(b byte[], endian Endian = Endian.Little) {
			index = 0
			endianes = endian
			self.b = b
		}

		// Len returns the number of bytes of the unread portion of underlying buffer.
		def len() int {
			return b.len() - index
		}

		// Size returns the original length of the underlying buffer
		def size() int {
			return b.len()
		}

		// Read implements the [io.Reader] interface.
		def read(buf byte[]) !int {
			expects {
				assert index < b.len() onerror fail "reader is at end of buffer"
			}
			let n = (b[int(index):]).copy(buf)
			index += n
			return n
		}

		def readByte() !byte {
			expects {
				assert index < b.len() onerror fail "reader is at end of buffer"
			}
			let n = b[int(index)]
			index += 1
			return n
		}

		def skip(count int) !none {
			expects {
				assert index + count <= b.len() onerror fail "reader is at end of buffer"
			}
			index += count
			return none
		}

		def read<T: Numeric>(endian ?Endian = none) !T {
			let end Endian = endianes
			end = endian unless endian is none

			let out T = 0
			let buf = byte[]
			buf.len(out.size())
			try self.read(buf)
			return out.fromBytes(buf, end)
		}

		def readAt(buf byte[], offset int) !int {
			expects {
				assert offset < b.len() onerror fail "provided read offset is beyond source length"
				assert offset >= 0 onerror fail "negative offset"
			}
			// Reads from `offset`, not from the cursor: readAt is the random
			// access counterpart of read and must leave the cursor alone.
			let n = (b[offset:]).copy(buf)
			return n
		}

		// Seek moves the cursor at the given offset
		def seek(offset int, whence Whence = Whence.Start) !int {
			let abs int64
			switch whence {
				case Whence.Start:
					abs = offset
				case Whence.Current:
					abs = int64(index) + offset
				case Whence.End:
					abs = int64(b.len()) + offset
				default:
					fail "invalid seek whence"
			}
			fail "negative seek offset" when abs < 0
			index = uint64(abs)
			return 0
		}

		// Reset, changes the Reader to read from the new source provided here
		def reset(src byte[]) {
			index = 0
			b = src
		}
	}
}
