partial module std.bytes {
	// Reader reads values out of a byte array: bytes, fixed-size strings and
	// numbers in a chosen byte order, from a cursor it advances, plus random
	// access through readAt.
	type Reader {
		internal b        byte[]
		internal index    uint64
		internal endianes Endian

		def new(b byte[], endian Endian = Endian.Little) {
			index = 0
			endianes = endian
			self.b = b
		}

		// Len returns the number of bytes of the unread portion of underlying buffer.
		def len() int {
			return b.len() - index
		}

		// Size returns the original length of the underlying buffer
		def size() int {
			return b.len()
		}

		// Read implements std.io.Reader: copies what is left into `buf` and
		// returns how much; 0 once the buffer is exhausted.
		// It cannot fail; the error type comes from io.Reader.
		def read(buf byte[]) !int {
			return 0 when index >= b.len()
			let n = (b[int(index):]).copy(buf)
			index += n
			return n
		}

		// readByte returns the byte at the cursor and advances it. Fails at the end
		// of the buffer.
		def readByte() !byte {
			expects {
				assert index < b.len() onerror fail "reader is at end of buffer"
			}
			let n = b[int(index)]
			index += 1
			return n
		}

		// skip advances the cursor by count bytes. Fails when that passes the end of
		// the buffer.
		def skip(count int) !none {
			expects {
				assert index + count <= b.len() onerror fail "reader is at end of buffer"
			}
			index += count
			return none
		}

		// read decodes a number of type T at the cursor, in the given byte order or
		// the reader's default, and advances past it. Fails when fewer bytes than the
		// number needs are left.
		def read<T: Numeric>(endian ?Endian = none) !T {
			let end Endian = endianes
			end = endian unless endian is none

			let out T = 0
			let buf = byte[]
			buf.len(out.size())
			let got = try self.read(buf)
			fail "reader is at end of buffer" when got < buf.len()
			return out.fromBytes(buf, end)
		}

		// readAt copies bytes from offset into buf without moving the cursor and
		// returns how many were copied. Fails when the offset is negative or past the
		// end.
		def readAt(buf byte[], offset int) !int {
			expects {
				assert offset < b.len() onerror fail "provided read offset is beyond source length"
				assert offset >= 0 onerror fail "negative offset"
			}
			// Reads from `offset`, not from the cursor: readAt is the random
			// access counterpart of read and must leave the cursor alone.
			let n = (b[offset:]).copy(buf)
			return n
		}

		// Seek moves the cursor at the given offset
		// Fails when the resulting position lies outside the buffer.
		def seek(offset int, whence Whence = Whence.Start) !int {
			let abs int64
			switch whence {
				case Whence.Start:
					abs = offset
				case Whence.Current:
					abs = int64(index) + offset
				case Whence.End:
					abs = int64(b.len()) + offset
				default:
					fail "invalid seek whence"
			}
			fail "negative seek offset" when abs < 0
			index = uint64(abs)
			return 0
		}

		// Reset, changes the Reader to read from the new source provided here
		def reset(src byte[]) {
			index = 0
			b = src
		}
	}
}
