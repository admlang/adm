partial module std.bytes {
	use (
		std.testing
		std.io
	)

	check "Reader" {
		let buf = byte[1, 2, 3, 4, 5, 6, 7, 8, 9]

		def printme(b !int) {
			println(b)
		}

		@test()
		def reader() !none {
			let r = new Reader(buf)
			assert r.size() == buf.len() // Check the size of the reader
			assert r.len() == buf.len() // Check the length of the reader

			let b byte[]
			b.len(3)
			assert try r.read(b) == 3 // Check reading 3 bytes from the reader
			assert b.equals(buf[0:3])
			assert r.len() == buf.len() - 3 // Check the length of the reader after reading 3 bytes

			assert r is io.Reader // Check the type of the reader

			b.flush()
			b.len(1000)
			let tmp io.Reader = new Reader(buf)
			assert try tmp.read(b) == buf.len()

			r = new Reader(b)
			b.flush()
			b.len(buf.len())

			r.read(b)
			assert b.equals(buf) // Check the reader's ability to read from a byte array'

			b.flush()
			use std.reflection

			let e = r.read(b) onerror (err error) {
				fail err unless err.message == "reader is at end of buffer"
				recover -1
			}
			assert e == -1
		}
	}
}
