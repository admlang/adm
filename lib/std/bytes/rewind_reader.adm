partial module std.bytes {
	use std.io

	// RewindReader is a reader that can get a byte[] that was already read and it will feed from it when reading
	// until complete and then feed from the underlying reader.
	type RewindReader {
		internal peeked byte[]
		internal r      io.Reader
		internal idx    int

		def new(peeked byte[], r io.Reader) {
			self.peeked = peeked
			self.r = r
		}

		// read serves the bytes rewound into the peek buffer first, then reads from
		// the wrapped reader. Fails when the wrapped reader does.
		def read(buf byte[]) !int {
			let nread = 0
			let buf_len = buf.len()

			// First, read from the peeked buffer if there are unread bytes.
			if idx < peeked.len() {
				let remaining_in_peek = peeked.len() - idx
				let to_copy = remaining_in_peek < buf_len ?? (remaining_in_peek, buf_len)

				for let i = 0; i < to_copy; i = i + 1 {
					buf[i] = peeked[idx + i]
				}
				idx += to_copy
				nread += to_copy
			}

			// If the buffer is not yet full, read from the underlying reader.
			if nread < buf_len {
				let n = r.read(buf[nread:]) onerror (err error) {
					// If we already read some bytes from peeked, return that count.
					// The error will be returned on the next call.
					if nread > 0 {
						recover nread
					}
					fail err
				}
				nread += n
			}

			return nread
		}
	}
}
