partial module std.bytes {
	use std.io

	// RewindableReader is a reader wrapper that can be rewound back to position 0.
	//
	// It records every byte that has ever been read from the underlying stream,
	// so after any sequence of reads you can call rewind() and the next reads
	// will replay from the beginning, then continue from the underlying stream.
	//
	// This is useful for "probe then decode" workflows (e.g. image codecs):
	// - codec A reads 2 bytes to check a signature, then rewind()
	// - codec B reads 20 bytes, then rewind()
	// - codec C reads 10 bytes, then rewind()
	//
	// The recorded byte slice grows as the max amount read increases, so rewind()
	// remains valid across multiple probe attempts.
	//
	// Note: by default this keeps recording forever. If you only need rewind
	// during probing and want to avoid retaining the whole file during decoding,
	// call freeze() once you have selected the final consumer.
	type RewindableReader {
		internal recorder RecordReader
		internal replay   RewindReader
		internal frozen   bool

		def new(r io.Reader) {
			recorder = new RecordReader(r)
			replay = new RewindReader([], recorder)
			frozen = false
		}

		// read implements std.io.Reader.
		// Fails when the recorded stream or the wrapped reader does.
		def read(buf byte[]) !int {
			return replay.read(buf)
		}

		// rewind resets the read cursor to the start of the recorded stream.
		//
		// After calling rewind(), reads will replay the recorded bytes from the
		// start and then resume reading from the underlying reader at the current
		// position.
		def rewind() RewindableReader {
			if frozen {
				replay = new RewindReader(recorder.bytes(), recorder.underlying())
			} else {
				replay = new RewindReader(recorder.bytes(), recorder)
			}
			return self
		}

		// Prebuffer reads length bytes from the underlying reader and records them
		// then rewinds the cursor to start.
		// Fails when the wrapped reader does, or ends before length bytes.
		def prebuffer(length int) !none {
			let probe byte[]
			probe.len(length)
			probe[:] = 0
			try read(probe)
			rewind()
			return none
		}

		// freeze disables further recording.
		//
		// After freeze(), the reader can still rewind back to the start of the
		// already-recorded bytes, but bytes read after freeze() will not be
		// retained for future rewinds.
		def freeze() RewindableReader {
			frozen = true
			replay = new RewindReader(recorder.bytes(), recorder.underlying())
			return self
		}

		// count returns the number of bytes recorded so far.
		def count() int {
			return recorder.count()
		}

		// bytes returns the recorded bytes.
		def bytes() byte[] {
			return recorder.bytes()
		}
	}
}
