// Command-line arguments, read by asking for them.
//
// `parseArgs` splits nothing up front: whether `--port` is a switch or takes
// the word after it is decided by the question asked, `flag("port")` or
// `value("port", 8080)`. Positional arguments are what is left when every
// named one has been asked for.
//
// Example: A small tool
// ```example
// use std.cli
//
// let args = cli.parseArgs()                       // tool -v --port 9000 -I a -I b in.txt
// let verbose = try args.flag("verbose", "v")      // true
// let port = try args.value("port", 8080, "p")     // 9000
// let include = try args.values("include", "I")    // ["a", "b"]
// let wait = try args.value("wait", 30s)           // a duration: --wait 1m30s
// let files = try args.end()                       // ["in.txt"]; refuses names nobody asked for
// ```
partial module std.cli {
	use (
		std.cli.flags::*
		std.errors
		std.reflection
	)

	// UsageKind says what is wrong with a command line.
	enum UsageKind {
		// An option that takes a value is the last word of the command line.
		MissingValue,
		// A value is not what the option takes: text where a number belongs.
		BadValue,
		// A named argument was asked for after `rest` or `unknown`.
		Closed,
		// A named argument nobody asked for.
		Unknown,
		// A flag the program cannot run without was not given.
		Required,
		// Two flags that cannot be used together were both given.
		Conflict,
	}

	// UsageError is the error a command line the program cannot use fails
	// with. A program reports `message` and exits with status 2.
	struct UsageError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    UsageKind
		// The option the error is about, as written: `--port`, `-p`.
		option  string
	}

	// Args is a command line being read. Each question removes the arguments
	// it answers, so what remains at the end is what nobody asked for.
	//
	// Named arguments are written `--name`, `--name=value`, `--name value`,
	// `-n`, `-nvalue` and `-n value`; short ones bundle (`-abc`, `-vp8080`).
	// A name of one letter is a short name. `--` ends the named arguments:
	// everything after it is positional. A lone `-` and a negative number
	// (`-5`) are positional too.
	type Args {
		internal named   string[]
		internal trailer string[]
		internal closed  bool
		// Every name asked for so far, long names without their dashes.
		internal asked   string[]
		// Every short name asked for so far, one letter each.
		internal letters string
		// The named part of the command line as it was given.
		internal written string[]

		// Takes the arguments as given, without the program's own path.
		def new(arguments string[]) {
			let split = arguments.indexOf("--")
			asked = []
			if split < 0 {
				named = arguments.clone()
				trailer = []
			} else {
				named = arguments[0:split].clone()
				trailer = arguments[split + 1:].clone()
			}
			written = named.clone()
		}

		// Reports whether a named argument was written at all, in any form,
		// without answering it: `flag`, `value` and the others still find it.
		def has(name string, short string = "") bool {
			let long = name.len() > 1 ?? ("--" + name, "")
			let letters = name.len() == 1 ?? (name + short, short)
			for let (_, word) in named {
				return true when long != "" && (word == long || word.startsWith(long + "="))
				continue unless letters != "" && isBundle(word)
				for let (_, letter) in word[1:] {
					break when letter == '='
					return true when letters.contains(string(letter))
				}
			}
			return false
		}

		// Reports whether a switch was given: `--verbose`, `-v`, or
		// `--verbose=false` and `--no-verbose` to turn it off; the last one
		// given wins.
		//
		// Fails when the switch has a value that is not a boolean, or after
		// `rest` or `unknown`.
		def flag(name string, short string = "") !bool {
			let given = try take(name, short, false, negatable = true)
			return false when given.len() == 0
			return parseSwitch(given[given.len() - 1], spelled(name))
		}

		// Returns how many times a switch was given: `-vvv` is 3.
		//
		// Fails after `rest` or `unknown`.
		def count(name string, short string = "") !int {
			return (try take(name, short, false)).len()
		}

		// Returns the value of an option, or fallback when it was not given;
		// the last one given wins.
		//
		// Fails when the option is the last word of the command line, or
		// after `rest` or `unknown`.
		def value(name string, fallback string = "", short string = "") !string {
			let given = try take(name, short, true)
			return fallback when given.len() == 0
			return given[given.len() - 1]
		}

		// Returns the value of an option as a whole number, or fallback when
		// it was not given.
		//
		// Fails when the value is not a whole number, the option is the last
		// word of the command line, or after `rest` or `unknown`.
		def value(name string, fallback int, short string = "") !int {
			let given = try take(name, short, true)
			return fallback when given.len() == 0
			let text = given[given.len() - 1]
			fail badValue(spelled(name), "'{text}' is not a whole number") unless /^[+-]?[0-9]+$/.test(text)
			return parseInt<int>(text)
		}

		// Returns the value of an option as a number, or fallback when it was
		// not given.
		//
		// Fails when the value is not a number, the option is the last word
		// of the command line, or after `rest` or `unknown`.
		def value(name string, fallback float, short string = "") !float {
			let given = try take(name, short, true)
			return fallback when given.len() == 0
			let text = given[given.len() - 1]
			fail badValue(spelled(name), "'{text}' is not a number") unless /^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/.test(text)
			return parseFloat<float>(text)
		}

		// Returns the value of an option as a duration (`--wait 1m30s`), or
		// fallback when it was not given.
		//
		// Fails when the value is not a duration, the option is the last
		// word of the command line, or after `rest` or `unknown`.
		def value(name string, fallback duration, short string = "") !duration {
			let given = try take(name, short, true)
			return fallback when given.len() == 0
			return readDuration(given[given.len() - 1], spelled(name))
		}

		// Returns the value of an option as a member of the enum fallback
		// belongs to, or fallback when it was not given. A member is written
		// by its name in any case or in kebab case: `--level warn`.
		//
		// Fails when the value names no member, the option is the last word
		// of the command line, or after `rest` or `unknown`.
		def value<T>(name string, fallback T, short string = "") !T {
			let given = try take(name, short, true)
			return fallback when given.len() == 0
			let described = reflection.descriptorOf(fallback)
			fail badValue(spelled(name), "its value is not one of an enum's members") when described is none || described.kind != reflection.TypeKind.Enum
			return T(try readChoice(reflection.members(described), given[given.len() - 1], spelled(name)))
		}

		// Returns every value of an option that may repeat, in the order
		// given: `-I a -I b` is `["a", "b"]`.
		//
		// Fails when the option is the last word of the command line, or
		// after `rest` or `unknown`.
		def values(name string, short string = "") !string[] {
			return take(name, short, true)
		}

		// Returns the named arguments nobody asked for, as written without
		// their values (`--colour`, `-x`), so a program can refuse them. Ask
		// after every `flag`, `count`, `value` and `values`: it ends the
		// questions.
		def unknown() string[] {
			closed = true
			let out string[] = []
			for let (_, word) in named {
				continue unless isNamed(word)
				let cut = word.indexOf("=")
				out.push(cut > 0 ?? (word[0:cut], word))
			}
			return out
		}

		// Returns the positional arguments: the words that are not named
		// arguments, then everything after `--`. Ask after every `flag`,
		// `count`, `value` and `values`, since only they know which words
		// are values: it ends the questions.
		def rest() string[] {
			closed = true
			let out string[] = []
			for let (_, word) in named {
				out.push(word) unless isNamed(word)
			}
			out.push(...trailer)
			return out
		}

		// Keeps a name that was asked for out of the names `end` suggests,
		// for an argument the program takes without telling anyone.
		def hide(name string) {
			let at = asked.indexOf(name)
			asked.remove(at) when at >= 0
		}

		// Returns the positional arguments, as `rest` does, once every named
		// argument has been asked for; what ends the reading of a command
		// line that takes no names but its own.
		//
		// Fails with `UsageKind.Unknown` when a named argument is left,
		// naming it and what was most likely meant: the long name asked for
		// that is closest to it, a long name written with one dash, or the
		// same letter in the other case.
		def end() !string[] {
			let stray = unknown()
			return rest() when stray.len() == 0
			let option = stray[0]
			let near = ""
			if option.startsWith("--") {
				near = closest(option[2:], asked)
				near = "--" + near unless near == ""
			} else {
				// `-verbose` for `--verbose` was read as letters: the word as
				// it was written says more than what is left of it.
				for let (_, word) in written {
					continue unless isBundle(word) && word.len() > 2
					let cut = word.indexOf("=")
					let name = cut > 0 ?? (word[1:cut], word[1:])
					continue unless asked.includes(name)
					option = cut > 0 ?? (word[0:cut], word)
					near = "--" + name
					break
				}
				let letter = string(option[1])
				let other = letter == letter.lower() ?? (letter.upper(), letter.lower())
				near = "-" + other when near == "" && other != letter && letters.contains(other)
			}
			let hint = near == "" ?? ("", "; did you mean {near}?")
			fail UsageError{message: "unknown option {option}{hint}", code: "Unknown", kind: UsageKind.Unknown, option: option}
		}

		// Removes every occurrence of a named argument and returns what each
		// one carried: its value when it takes one, else the text after `=`
		// or "true". With negatable, `--no-name` is taken too, as "false".
		internal def take(name string, short string, valued bool, negatable bool = false) !string[] {
			fail UsageError{message: "{spelled(name)} was asked for after the positional arguments", code: "Closed", kind: UsageKind.Closed, option: spelled(name)} when closed
			let long = name.len() > 1 ?? (name, "")
			let letters = name.len() == 1 ?? (name + short, short)
			asked.push(long) unless long == "" || asked.includes(long)
			self.letters += letters
			let found string[] = []
			let kept string[] = []
			let i = 0
			for i < named.len() {
				let word = named[i]
				i++
				if long != "" && word == "--" + long {
					if !valued {
						found.push("true")
						continue
					}
					fail missingValue(word) when i >= named.len()
					found.push(named[i])
					i++
					continue
				}
				if negatable && long != "" && word == "--no-" + long {
					found.push("false")
					continue
				}
				if long != "" && word.startsWith("--" + long + "=") {
					found.push(word[long.len() + 3:])
					continue
				}
				if letters == "" || !isBundle(word) {
					kept.push(word)
					continue
				}
				let bundle = word[1:]
				let left = ""
				let j = 0
				for j < bundle.len() {
					let letter = string(bundle[j])
					j++
					if !letters.contains(letter) {
						left += letter
						continue
					}
					if !valued {
						found.push("true")
						continue
					}
					// The value is what follows the letter in the same word,
					// else the next word.
					if j < bundle.len() {
						found.push(bundle[j:].trimPrefix("="))
						j = bundle.len()
						continue
					}
					fail missingValue("-" + letter) when i >= named.len()
					found.push(named[i])
					i++
				}
				kept.push("-" + left) unless left == ""
			}
			named = kept
			return found
		}
	}

	// Returns the application's own command line, ready to be asked. The
	// program's path, which the system passes first, is left out, and so
	// are the words that belong to the program's `@flag` variables: what
	// is left is what the program reads itself.
	//
	// In a program with `@flag` variables this is also where `--help` is
	// answered and a flag's bad value reported, when no flag was read yet.
	def parseArgs() Args {
		let args = new Args(applicationWords())
		let specs = declaredFlags()
		return args when specs.len() == 0
		startFlags()
		for let (_, spec) in specs {
			fill(args, spec, none) onerror recover none
			args.hide(spec.name) when spec.hidden
		}
		return args
	}

	// Returns a command line given as a list, without a program path; what
	// check suites use.
	def parseArgs(arguments string[]) Args {
		return new Args(arguments)
	}

	// Reports whether a word is a named argument: `--name`, `--name=value`
	// or a bundle of short names.
	internal def isNamed(word string) bool {
		return word.startsWith("--") && word.len() > 2 || isBundle(word)
	}

	// Reports whether a word is one or more short names: a dash, then
	// something that is not a second dash, a digit or a decimal point.
	internal def isBundle(word string) bool {
		return false unless word.len() > 1 && word.startsWith("-")
		let second = word[1]
		return second != '-' && second != '.' && !second.isDigit()
	}

	// An argument's name as the user writes it.
	internal def spelled(name string) string {
		return name.len() == 1 ?? ("-" + name, "--" + name)
	}

	// Reads what a switch carried: "true" for the bare switch, else the text
	// after `=`.
	internal def parseSwitch(text string, option string) !bool {
		let word = text.lower()
		return true when word := "true" || "1" || "yes" || "on"
		return false when word := "false" || "0" || "no" || "off"
		fail badValue(option, "'{text}' is not true or false")
	}

	internal def missingValue(option string) UsageError {
		return UsageError{message: "{option} needs a value", code: "MissingValue", kind: UsageKind.MissingValue, option: option}
	}

	internal def badValue(option string, reason string) UsageError {
		return UsageError{message: "{option}: {reason}", code: "BadValue", kind: UsageKind.BadValue, option: option}
	}
}
