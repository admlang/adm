partial module std.cli {
	use std.testing

	enum ArgLevel {
		Info,
		Warn,
		VeryLoud,
	}

	check "Command-line arguments" {
		// The kind and option a value query fails with; "" when it succeeds.
		def valueFailure(args Args, name string, short string = "") string {
			let kind = ""
			args.value(name, "", short) onerror (err error) {
				kind = "other"
				kind = err.kind.name + " " + err.option when err is UsageError
				recover ""
			}
			return kind
		}

		@test()
		def TestSwitches() !none {
			let args = parseArgs(["-v", "--force", "--color=false", "--dry-run=yes", "file"])
			assert try args.flag("verbose", "v")
			assert try args.flag("force")
			assert !(try args.flag("color"))
			assert try args.flag("dry-run")
			assert !(try args.flag("missing", "m"))
			assert args.unknown().len() == 0
			assert args.rest().join(",") == "file"
			return none
		}

		@test()
		def TestLastSwitchWins() !none {
			assert !(try parseArgs(["--color", "--color=off"]).flag("color"))
			assert try parseArgs(["--color=off", "--color"]).flag("color")
			assert try parseArgs(["--color=no", "-c"]).flag("color", "c")
			return none
		}

		@test()
		def TestCounts() !none {
			let args = parseArgs(["-vvv", "-q", "--verbose", "-v"])
			assert (try args.count("verbose", "v")) == 5
			assert (try args.count("q")) == 1
			assert (try args.count("x")) == 0
			assert args.unknown().len() == 0
			return none
		}

		@test()
		def TestValues() !none {
			let args = parseArgs(["--port", "9000", "--host=example.test", "-o", "out.txt", "-j8", "--ratio", "0.5", "--name="])
			assert (try args.value("port", 8080, "p")) == 9000
			assert (try args.value("host", "localhost")) == "example.test"
			assert (try args.value("output", "", "o")) == "out.txt"
			assert (try args.value("jobs", 1, "j")) == 8
			assert (try args.value("ratio", 1.0)) == 0.5
			assert (try args.value("name", "unset")) == ""
			assert (try args.value("absent", "fallback")) == "fallback"
			assert (try args.value("absent", 7)) == 7
			assert (try args.value("absent", 2.5)) == 2.5
			assert args.unknown().len() == 0 && args.rest().len() == 0
			return none
		}

		@test()
		def TestValueForms() !none {
			// A value may start with a dash, and the last one given wins.
			let args = parseArgs(["--offset", "-5", "-n", "-3", "--level=1", "--level", "2", "-p=80"])
			assert (try args.value("offset", 0)) == -5
			assert (try args.value("n", 0)) == -3
			assert (try args.value("level", 0)) == 2
			assert (try args.value("port", 0, "p")) == 80
			return none
		}

		@test()
		def TestRepeatedValues() !none {
			let args = parseArgs(["-I", "a", "--include=b", "-Ic", "--include", "d", "x"])
			assert (try args.values("include", "I")).join(",") == "a,b,c,d"
			assert (try args.values("exclude", "X")).len() == 0
			assert args.rest().join(",") == "x"
			return none
		}

		@test()
		def TestBundles() !none {
			// The question decides: `p` takes the rest of the word as its value.
			let args = parseArgs(["-abc", "-vp8080", "-xo", "out"])
			assert try args.flag("a")
			assert try args.flag("c")
			assert (try args.value("port", 0, "p")) == 8080
			assert try args.flag("verbose", "v")
			assert (try args.value("o")) == "out"
			assert args.unknown().join(",") == "-b,-x"
			return none
		}

		@test()
		def TestPositionals() !none {
			let args = parseArgs(["build", "-v", "a.adm", "-", "-5", "-.5", "--", "-x", "--not-a-flag", "--"])
			assert try args.flag("v")
			assert args.rest().join(" ") == "build a.adm - -5 -.5 -x --not-a-flag --"
			// Nothing is positional until the values have been asked for.
			let early = parseArgs(["--port", "80", "file"])
			assert early.rest().join(" ") == "80 file"
			assert early.unknown().join(" ") == "--port"
			assert parseArgs([]).rest().len() == 0
			return none
		}

		@test()
		def TestHasLeavesTheArgumentInPlace() !none {
			let args = parseArgs(["--color=false", "-vq", "--", "--late"])
			assert args.has("color") && args.has("verbose", "v") && args.has("q")
			assert !args.has("late") && !args.has("col") && !args.has("x")
			assert !(try args.flag("color"))
			assert !args.has("color")
			return none
		}

		@test()
		def TestUnknown() !none {
			let args = parseArgs(["--colour=red", "-x", "--", "--kept"])
			assert args.unknown().join(",") == "--colour,-x"
			assert args.rest().join(",") == "--kept"
			return none
		}

		@test()
		def TestUsageErrors() {
			assert valueFailure(parseArgs(["--port"]), "port") == "MissingValue --port"
			assert valueFailure(parseArgs(["-vp"]), "port", "p") == "MissingValue -p"
			assert valueFailure(parseArgs(["--port", "--", "80"]), "port") == "MissingValue --port"

			let number = ""
			parseArgs(["--port", "eighty"]).value("port", 8080) onerror (err error) {
				number = err.message
				recover 0
			}
			assert number == "--port: 'eighty' is not a whole number"

			let ratio = ""
			parseArgs(["-r", "half"]).value("r", 1.0) onerror (err error) {
				ratio = err.message
				recover 0.0
			}
			assert ratio == "-r: 'half' is not a number"

			let switched = ""
			parseArgs(["--color=maybe"]).flag("color") onerror (err error) {
				switched = err.message
				recover false
			}
			assert switched == "--color: 'maybe' is not true or false"
		}

		@test()
		def TestQuestionsEndAtThePositionals() {
			let args = parseArgs(["-v", "file"])
			assert args.rest().join(",") == "file"
			assert valueFailure(args, "output") == "Closed --output"
			let failed = false
			args.flag("v") onerror (err error) {
				failed = true
				recover false
			}
			assert failed
		}

		@test()
		def TestNoTurnsASwitchOff() !none {
			assert !(try parseArgs(["--no-color"]).flag("color"))
			assert try parseArgs(["--no-color", "--color"]).flag("color")
			assert !(try parseArgs(["-c", "--no-color"]).flag("color", "c"))
			// Only a switch is turned off: a count or a value leaves the word.
			let args = parseArgs(["--no-verbose", "--no-port"])
			assert (try args.count("verbose")) == 0
			assert (try args.value("port", 80)) == 80
			assert args.unknown().join(",") == "--no-verbose,--no-port"
			return none
		}

		@test()
		def TestEnumValues() !none {
			let args = parseArgs(["--level", "warn", "-n", "very-loud", "--bad", "shout", "--port", "9", "in"])
			assert (try args.value("level", ArgLevel.Info)) == ArgLevel.Warn
			assert (try args.value("noise", ArgLevel.Info, "n")) == ArgLevel.VeryLoud
			assert (try args.value("other", ArgLevel.Warn)) == ArgLevel.Warn
			assert (try args.value("port", 80)) == 9
			let message = ""
			args.value("bad", ArgLevel.Info) onerror (err error) {
				message = err.message
				recover ArgLevel.Info
			}
			assert message == "--bad: 'shout' is not one of info, warn, very-loud"
			assert (try args.end()).join(",") == "in"
			return none
		}

		@test()
		def TestDurationValues() !none {
			let args = parseArgs(["--wait", "1m30s", "-t250ms", "--pause", "soon"])
			assert (try args.value("wait", 5s)) == 90s
			assert (try args.value("timeout", 1s, "t")) == 250ms
			assert (try args.value("absent", 2h)) == 2h
			let message = ""
			args.value("pause", 1s) onerror (err error) {
				message = err.message
				recover 0s
			}
			assert message == "--pause: 'soon' is not a duration, such as 30s, 5m or 1h30m"
			return none
		}

		@test()
		def TestEndGivesThePositionals() !none {
			let args = parseArgs(["-v", "in.txt", "--port", "80", "--", "--raw"])
			assert try args.flag("verbose", "v")
			assert (try args.value("port", 8080)) == 80
			assert (try args.end()).join(",") == "in.txt,--raw"
			return none
		}

		// The kind, option and message `end` fails with.
		def refusal(args Args) string {
			let out = ""
			args.end() onerror (err error) {
				out = err.message
				out = "{err.kind.name} {err.option}: {err.message}" when err is UsageError
				recover []
			}
			return out
		}

		@test()
		def TestEndRefusesWhatNobodyAskedFor() !none {
			let args = parseArgs(["--prot", "80", "in.txt"])
			try args.value("port", 8080, "p")
			try args.flag("verbose", "v")
			assert refusal(args) == "Unknown --prot: unknown option --prot; did you mean --port?"
			let short = parseArgs(["-x", "--verb"])
			try short.flag("verbose", "v")
			assert refusal(short) == "Unknown -x: unknown option -x"
			let prefix = parseArgs(["--verb"])
			try prefix.flag("verbose", "v")
			assert refusal(prefix) == "Unknown --verb: unknown option --verb; did you mean --verbose?"
			let secret = parseArgs(["--verb"])
			try secret.flag("verbose", "v")
			secret.hide("verbose")
			assert refusal(secret) == "Unknown --verb: unknown option --verb"
			let far = parseArgs(["--zzz"])
			try far.flag("verbose")
			assert refusal(far) == "Unknown --zzz: unknown option --zzz"
			return none
		}

		@test()
		def TestEndSaysWhatAShortNameWasMeantToBe() !none {
			let single = parseArgs(["-verbose"])
			try single.flag("verbose", "v")
			assert refusal(single) == "Unknown -verbose: unknown option -verbose; did you mean --verbose?"
			let valued = parseArgs(["in", "-port=80"])
			try valued.value("port", 1)
			assert refusal(valued) == "Unknown -port: unknown option -port; did you mean --port?"
			let cased = parseArgs(["-V"])
			try cased.flag("verbose", "v")
			assert refusal(cased) == "Unknown -V: unknown option -V; did you mean -v?"
			let bundle = parseArgs(["-xvf"])
			try bundle.flag("verbose", "v")
			try bundle.value("file", "")
			assert refusal(bundle) == "Unknown -xf: unknown option -xf"
			return none
		}
	}
}
