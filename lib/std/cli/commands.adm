// Commands and subcommands, declared with annotations.
//
// A `@command` function is a command: its parameters with a default are
// flags, the others positional arguments. A `@command` type is a group: its
// `@command` methods and fields are its subcommands, its `@flag` fields the
// flags they share. `cli.run()` follows the command line to the one meant.
//
// Example: A tool with two levels
// ```example
// use std.cli
// use std.cli::(command, flag)
//
// // Start the server.
// // @param port Port to listen on.
// @command
// def serve(@flag(short = "p") port int = 8080, config ?os.File = none) !none {
//     ...
// }
//
// // Manage remotes.
// @command
// type Remote {
//     @flag(description = "Say more")
//     verbose bool
//
//     // Add a remote.
//     @command
//     def add(name string, address url.URL) !none { ... }
//
//     // Remove a remote.
//     @command(aliases = "rm")
//     def remove(name string) !none { ... }
// }
//
// application tool {
//     def new(args string[]) int {
//         return cli.run()            // tool remote add origin https://...
//     }
// }
// ```
partial module std.cli {
	use (
		std.cli.commands::*
		std.cli.flags::*
		std.os
		std.reflection
		std.reflection::(DiscoveryMetaContext, FieldMetaContext, FunctionMetaContext, MethodMetaContext, ParameterMetaContext, TypeMetaContext)
		std.services::(Application)
	)

	// Makes the function a command of the program, named after it in kebab
	// case. A parameter without a default is a positional argument, taken in
	// order; one with a default, and any `bool`, is a flag named after it,
	// the default being the flag's. `@flag` or `@arg` on a parameter says
	// which it is and adds what the flag or argument needs (a short name, an
	// environment variable). A variadic last parameter takes the words that
	// are left. The types are the ones `@flag` reads.
	//
	// The doc comment is the command's help, its first line the text in a
	// list of commands, its `@param` lines the help of the parameters.
	// name renames the command, description replaces the doc comment,
	// aliases are other names for it, between commas, and a hidden command
	// runs but is not listed.
	meta def command(target DiscoveryMetaContext<FunctionMetaContext>, name string = "", description string = "", aliases string = "", hidden bool = false) {}

	// Makes the method a subcommand of its type, which must be a `@command`
	// type; see `command` on a function. The method runs on an object of
	// the type whose `@flag` fields were filled from the command line.
	meta def command(target DiscoveryMetaContext<MethodMetaContext>, name string = "", description string = "", aliases string = "", hidden bool = false) {}

	// Makes the type a command, named after it in kebab case. Its `@flag`
	// fields are flags and its `@arg` fields positional arguments, in the
	// order they are declared; an array `@arg` takes the words that are
	// left. With `@command` methods or fields it is a group: they are its
	// subcommands, and its flags are theirs too. A `run() !none` method is
	// what the type does when it is the command meant; a group without one
	// shows its help. `validate() !none`, when declared, is called before
	// `run`.
	//
	// A field of the type of a group above is given that group's object,
	// which is how a subcommand type reads the flags it inherits.
	meta def command(target DiscoveryMetaContext<TypeMetaContext>, name string = "", description string = "", aliases string = "", hidden bool = false) {}

	// Makes the field's type, a `@command` type, a subcommand of the type
	// the field is in, named after the field in kebab case. The field holds
	// the subcommand's object when it is the one meant.
	meta def command(target FieldMetaContext, name string = "", description string = "", aliases string = "", hidden bool = false) {}

	// Makes the field a flag of its `@command` type; see `flag` on a
	// variable. The value the field is declared with is the default.
	// description is the text help shows.
	meta def flag(target FieldMetaContext, name string = "", short string = "", description string = "", hidden bool = false, env string = "", required bool = false, count bool = false, mode string = "r", placeholder string = "", group string = "", excludes string = "", requires string = "") {}

	// Makes the parameter a flag of its `@command` function or method, and
	// says what the flag needs beyond its name; see `flag` on a variable.
	// The parameter's default is the flag's.
	meta def flag(target DiscoveryMetaContext<ParameterMetaContext>, name string = "", short string = "", description string = "", hidden bool = false, env string = "", required bool = false, count bool = false, mode string = "r", placeholder string = "", group string = "", excludes string = "", requires string = "") {}

	// Makes the field a positional argument of its `@command` type. name
	// is what help calls it; left out, it is the field's name in kebab
	// case. description is the text help shows, placeholder the stand-in
	// for its value.
	meta def arg(target FieldMetaContext, name string = "", description string = "", placeholder string = "") {}

	// Makes the parameter a positional argument of its `@command` function
	// or method, whatever its default says; see `arg` on a field.
	meta def arg(target DiscoveryMetaContext<ParameterMetaContext>, name string = "", description string = "", placeholder string = "") {}

	// Adds a command the program declares by a call instead of an
	// annotation: path is its name, after the names of the groups it is
	// under, between spaces (`"remote add"`); a group that does not exist is
	// made. action gets the words left for the command once the program's
	// flags and the flags of the groups above are taken, to read as it
	// likes; description is its help. Call it before `run`.
	//
	// Example: A command by a call
	// ```example
	// cli.addCommand("cache clear", "Remove every cached file.", def (args cli.Args) !none {
	//     let all = try args.flag("all")
	//     try args.end()
	//     ...
	// })
	// ```
	def addCommand(path string, description string, action def (Args) !none) {
		declare(path, description, action)
	}

	// Runs the command the application's command line names and returns
	// the program's exit status: 0 when it ran through or a help screen or
	// the version was asked for, 1 when the command failed, with its
	// message on standard error, and 2 when the command line cannot be
	// used, with what is wrong and where help is.
	//
	// `--help` or `-h` after a command shows that command's help, as does
	// `help` before it; a group named without a subcommand shows its own.
	// `completion bash`, `completion zsh` and `completion fish` write the
	// script that makes the shell complete the program's commands, flags
	// and values (`eval "$(tool completion bash)"`), unless the program has
	// a command of that name.
	// A mistake in how a command is declared (a `@command` method on a type
	// that is not one, a field no flag reads, a `run` with parameters) ends
	// every run with status 2 and says which command it is, so it shows the
	// first time the program is run at all.
	// The program's `@flag` variables are accepted anywhere on the line.
	// Call it before the program reads a `@flag` variable, so that help is
	// the commands'.
	def run() int {
		return run(applicationWords())
	}

	// Runs the command a list of words names, without a program path; what
	// a program with a command line of its own making uses.
	def run(arguments string[]) int {
		// The commands answer `--help` and check every flag from here on.
		flagsStarted = true
		let program = programName()
		let tree = commandTree(reflection.attrs(command))
		// A command declared wrongly is the program's mistake, whichever
		// command this run names: it is said at once. The shell's completion
		// is not the place to say it.
		let wrong = treeProblem(program, tree, [])
		if wrong != "" && !(arguments.len() > 0 && arguments[0] == completeWord) {
			os.stderr.write("{wrong}\n".bytes()) onerror recover 0
			return 2
		}
		let failure ?error = none
		let outcome = dispatch(tree, program, Application.version(), arguments, declaredFlags()) onerror (err error) {
			failure = err
			recover Outcome{}
		}
		if !(failure is none) {
			os.stderr.write("{program}: {failure.message}\nTry '{program} --help'.\n".bytes()) onerror recover 0
			return 2
		}
		if outcome.screen != "" {
			os.stdout.write(outcome.screen.bytes()) onerror recover 0
			return 0
		}
		let failed = outcome.failure
		return 0 when failed is none
		os.stderr.write("{program}: {failed.message}\n".bytes()) onerror recover 0
		return 1
	}
}
