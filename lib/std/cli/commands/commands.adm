// Commands and subcommands: the tree a program's `@command` functions,
// methods and types make, the walk from a command line to the one meant, the
// reading of its flags and arguments, and its help.
internal partial module std.cli.commands {
	use (
		std.cli::(Args, UsageError, UsageKind)
		std.cli.flags::*
		std.reflection
		std.reflection::(AttrHit, Field, FunctionDescriptor, ReflectionKind, TypeDescriptor)
	)

	// The qualified names of the annotations, as reflection reports them.
	const commandMeta = "std.cli.command"
	const flagMeta = "std.cli.flag"
	const argMeta = "std.cli.arg"

	// Input is one thing a command takes: a flag or a positional argument,
	// and where its value goes.
	struct Input {
		// Whether it is positional.
		positional bool
		spec       FlagSpec
		// The parameter's place, for a function or method; -1 for a field.
		index      int
		// The field's name, for a type; "" for a parameter.
		field      string
		// The default as written, for a parameter.
		literal    string
		// A positional that takes every word left.
		rest       bool
		// A positional the command cannot run without.
		needed     bool
		// Which of the command's bundles the field is in; -1 for none.
		bundle     int
	}

	// Bundle is a set of flags and arguments declared once, as the `@flag`
	// and `@arg` fields of a type of their own, and taken by any command:
	// through a parameter of that type, or a `@flag` field of it. A `@flag`
	// field of a bundle that is a bundle itself adds its own.
	struct Bundle {
		described TypeDescriptor
		// The parameter's place; -1 for a field.
		index     int
		// The field's name; "" for a parameter.
		field     string
		// The bundle whose field holds this one, by its number among the
		// command's bundles; -1 for a bundle the command takes itself.
		parent    int
	}

	// Added is a command a program declares by a call.
	struct Added {
		// Its name, after the names of the groups it is under.
		path        string[]
		description string
		action      def (Args) !none
	}

	// The commands declared by calls, in the order they were.
	let added Added[] = []

	def declare(path string, description string, action def (Args) !none) {
		added.push(Added{path: path.split(" ").filter(word => word != ""), description: description, action: action})
	}

	// Command is one node of the tree: the program itself at the root, a
	// group with commands under it, or a command that runs.
	type Command {
		name        string
		aliases     string[]
		// The first line of what it does, for a list of commands.
		summary     string
		// All of what it does.
		description string
		hidden      bool
		// The function or method that is the command; none for a type and
		// for the root.
		action      ?FunctionDescriptor
		// The type that is the command or the group; none for a function
		// and for the root.
		described   ?TypeDescriptor
		// The type's `run` and `validate` methods, when it has them.
		runner      ?FunctionDescriptor
		validator   ?FunctionDescriptor
		// What a command declared by a call runs, with the words left for it.
		handler     ?def (Args) !none
		// How many parameters the action takes.
		arity       int
		inputs      Input[]
		bundles     Bundle[]
		children    Command[]
		// The fields of the type that hold its subcommand types, by the
		// child's name.
		childFields map<string, string>
		// Why the declaration cannot be a command; "" when it can.
		problem     string

		def new(name string) {
			self.name = name
			aliases = []
			inputs = []
			bundles = []
			children = []
			childFields = new map<string, string>()
		}

		// The child a word names, by name or alias; none when no child does.
		def child(word string) ?Command {
			for let (_, candidate) in children {
				return candidate when candidate.name == word || candidate.aliases.includes(word)
			}
			return none
		}

		// Whether the node runs something itself.
		def runs() bool {
			return !(action is none) || !(runner is none) || !(handler is none)
		}

		def flags() FlagSpec[] {
			let out FlagSpec[] = []
			for let (_, input) in inputs {
				out.push(input.spec) unless input.positional
			}
			return out
		}

		def positionals() Input[] {
			return inputs.filter(input => input.positional)
		}
	}

	// Outcome is what following a command line came to.
	struct Outcome {
		// Text to print in place of a run: a help screen or the version.
		screen  string
		// The error the command's own code failed with.
		failure ?error
	}

	// Builds the tree from the program's `@command` occurrences.
	def commandTree(hits AttrHit[]) Command {
		let root = new Command("")
		let types = new map<string, Command>()
		let nested string[] = []
		// Types first: methods and fields hang on them.
		for let (_, hit) in hits {
			continue unless hit.node.kind == ReflectionKind.Type
			let found = reflection.asType(hit.node)
			continue when found is none
			let described TypeDescriptor = found
			let node = typeCommand(described, hit)
			types.set(described.typeName, node)
		}
		for let (_, hit) in hits {
			continue unless hit.node.kind := ReflectionKind.Function || ReflectionKind.Method
			let found = reflection.asFunction(hit.node)
			continue when found is none
			let fn FunctionDescriptor = found
			let node = functionCommand(fn, hit)
			if hit.node.kind == ReflectionKind.Function {
				root.children.push(node)
				continue
			}
			let owner = fn.ownerType.typeName
			if types.hasKey(owner) {
				types[owner].children.push(node)
			} else {
				node.problem = "its type {owner} is not a @command"
				root.children.push(node)
			}
		}
		// A type held in a field of another is that one's subcommand, under
		// the field's name.
		for let (_, parent) in types.values() {
			for let (field, typeName) in parent.childFields {
				continue unless types.hasKey(typeName)
				let made = types[typeName]
				made.name = kebabCase(field)
				parent.children.push(made)
				nested.push(typeName)
			}
		}
		for let (typeName, node) in types {
			root.children.push(node) unless nested.includes(typeName)
		}
		for let (_, call) in added {
			continue when call.path.len() == 0
			let at = root
			for let (_, word) in call.path {
				let below = at.child(word)
				if below is none {
					let made = new Command(word)
					at.children.push(made)
					at = made
				} else {
					at = below
				}
			}
			at.handler = call.action
			at.description = call.description
			at.summary = firstLine(call.description)
		}
		ordered(root)
		return root
	}

	// Puts the commands of every level in name order.
	def ordered(node Command) {
		node.children.sort((a, b) => a.name.compare(b.name))
		for let (_, below) in node.children {
			ordered(below)
		}
	}

	// What the `@command` annotation says, over what the declaration does.
	def named(node Command, hit AttrHit, doc string) {
		let given = hit.attr.arguments
		let name = text(argument(given, "name", 0))
		node.name = name unless name == ""
		let described = text(argument(given, "description", 1))
		node.description = described == "" ?? (doc, described)
		node.summary = firstLine(node.description)
		node.aliases = flagNames(text(argument(given, "aliases", 2)))
		node.hidden = text(argument(given, "hidden", 3)) == "true"
	}

	// A function or method as a command: a parameter with a default is a
	// flag, one without is a positional argument, unless an annotation on
	// it says otherwise.
	def functionCommand(fn FunctionDescriptor, hit AttrHit) Command {
		let node = new Command(kebabCase(hit.node.name))
		node.action = fn
		named(node, hit, fn.node.doc)
		let params = fn.signature.parameters
		node.arity = params.len()
		for let (index, param) in params {
			let options = FlagOptions{}
			let marked = ""
			for let (_, attr) in param.attributes {
				continue unless attr.name := flagMeta || argMeta
				marked = attr.name
				options = attr.name == flagMeta ?? (optionsOf(attr.arguments), argOptions(attr.arguments))
			}
			if marked == "" && holdsFlags(param.paramType) {
				addBundle(node, param.paramType, index, "", -1)
				continue
			}
			let positional = marked == argMeta || marked == "" && param.defaultLiteral == "" && !isSwitch(param.paramType)
			let input = inputOf(param.node.name, param.paramType, param.node.doc, param.defaultLiteral, options, positional)
			input.index = index
			input.rest = positional && param.variadic
			input.needed = positional && !param.variadic && param.defaultLiteral == "" && !param.paramType.optional
			input.spec.problem = "only the last parameter can take the words that are left" when param.variadic && index != params.len() - 1
			node.problem = "{param.node.name}: {input.spec.problem}" unless input.spec.problem == "" || node.problem != ""
			node.inputs.push(input)
		}
		return node
	}

	// A type as a command or a group: its `@flag` and `@arg` fields are what
	// it takes, its `@command` fields its subcommand types, `run` what it
	// does when it is the one meant.
	def typeCommand(described TypeDescriptor, hit AttrHit) Command {
		let simple = described.typeName.split(".")
		let node = new Command(kebabCase(simple[simple.len() - 1]))
		node.described = described
		named(node, hit, hit.node.doc)
		let sample = reflection.instantiate(described)
		for let (_, field) in reflection.fields(sample) {
			if field.hasAttr(commandMeta) {
				let renamed = field.attr(commandMeta, "name")
				node.childFields.set(renamed == "" ?? (field.name, renamed), field.typeName)
				continue
			}
			takeField(node, field, -1)
		}
		for let (_, method) in reflection.methods(described) {
			let name = method.node.name
			continue unless name := "run" || "validate"
			// A `@command` method of the name is a subcommand.
			continue when method.node.attributes.filter(attr => attr.name == commandMeta).len() > 0
			if method.signature.parameters.len() > 0 {
				node.problem = "{name} takes no parameters: what the command reads is declared as its @flag and @arg fields" when node.problem == ""
				continue
			}
			node.runner = method when name == "run"
			node.validator = method when name == "validate"
		}
		return node
	}

	// Makes a field of a command type, or of bundle number bundle of the
	// command, one of the command's inputs when it is marked `@flag` or
	// `@arg`; a `@flag` field whose type is a bundle adds that bundle.
	def takeField(node Command, field Field, bundle int) {
		let positional = field.hasAttr(argMeta)
		return unless positional || field.hasAttr(flagMeta)
		let declared = field.descriptor
		if declared is none {
			node.problem = "{field.name}: a field of type {field.typeName} cannot be a flag or an argument" when node.problem == ""
			return
		}
		if !positional && holdsFlags(declared) {
			addBundle(node, declared, -1, field.name, bundle)
			return
		}
		let input = inputOf(field.name, declared, field.doc, fieldDefault(field), fieldOptions(field, positional ?? (argMeta, flagMeta)), positional)
		input.field = field.name
		input.bundle = bundle
		input.rest = positional && input.spec.shape == FlagShape.List
		input.needed = positional && !input.rest && !declared.optional && input.spec.defaultValue == ""
		node.problem = "{field.name}: {input.spec.problem}" unless input.spec.problem == "" || node.problem != ""
		node.inputs.push(input)
	}

	// Adds a bundle to a command, with the inputs its fields make and the
	// bundles those hold. index is the parameter that takes it, or field
	// the field that holds it, in the command's type or in bundle number
	// parent.
	def addBundle(node Command, described TypeDescriptor, index int, field string, parent int) {
		// A bundle type that holds itself would never end.
		let above = parent
		for above >= 0 {
			if node.bundles[above].described.typeName == described.typeName {
				node.problem = "{field}: the type {described.typeName} holds itself" when node.problem == ""
				return
			}
			above = node.bundles[above].parent
		}
		let at = node.bundles.len()
		node.bundles.push(Bundle{described: described, index: index, field: field, parent: parent})
		for let (_, inner) in reflection.fields(reflection.instantiate(described)) {
			takeField(node, inner, at)
		}
	}

	// Whether a type is a bundle: one no flag reads as a value, with `@flag`
	// or `@arg` fields of its own.
	def holdsFlags(declared TypeDescriptor) bool {
		// A `type` named by a parameter or a field is described as an alias.
		return false unless (declared.kind := reflection.TypeKind.Struct || reflection.TypeKind.Alias) && kindOf(declared) == "" && !declared.optional
		for let (_, field) in reflection.fields(reflection.instantiate(declared)) {
			return true when field.hasAttr(flagMeta) || field.hasAttr(argMeta)
		}
		return false
	}

	def isSwitch(declared TypeDescriptor) bool {
		return declared.typeName.replace("builtin.", "") == "bool"
	}

	// One input of a command, described as a flag is so that it reads the
	// same way.
	def inputOf(name string, declared TypeDescriptor, doc string, literal string, options FlagOptions, positional bool) Input {
		let spec = specFor(name, declared, doc, literal, options)
		// A positional file is given whenever the command runs.
		spec.problem = "" when positional && spec.kind == "file"
		return Input{positional: positional, spec: spec, index: -1, literal: literal, bundle: -1}
	}

	// The options of an `@arg`: a name, a description and a placeholder.
	def argOptions(given map<string, any>) FlagOptions {
		return FlagOptions{name: text(argument(given, "name", 0)), description: text(argument(given, "description", 1)), placeholder: text(argument(given, "placeholder", 2))}
	}

	// The options a field's annotation gives.
	def fieldOptions(field Field, annotation string) FlagOptions {
		return FlagOptions{
			name:        field.attr(annotation, "name"),
			short:       field.attr(annotation, "short"),
			description: field.attr(annotation, "description"),
			hidden:      field.attr(annotation, "hidden") == "true",
			env:         field.attr(annotation, "env"),
			required:    field.attr(annotation, "required") == "true",
			count:       field.attr(annotation, "count") == "true",
			mode:        field.attr(annotation, "mode"),
			placeholder: field.attr(annotation, "placeholder"),
			group:       field.attr(annotation, "group"),
			excludes:    field.attr(annotation, "excludes"),
			requires:    field.attr(annotation, "requires"),
		}
	}

	// The value a field is declared with, written as a literal would be; ""
	// for a value that says nothing (zero, an off switch, no text).
	def fieldDefault(field Field) string {
		let kind = field.kind
		return field.asBool() ?? ("true", "") when kind == reflection.FieldKind.Bool
		return field.asString() == "" ?? ("", "\"" + field.asString() + "\"") when kind == reflection.FieldKind.String
		return field.asInt() == 0 ?? ("", "{field.asInt()}") when kind == reflection.FieldKind.Int
		return field.asUint() == 0 ?? ("", "{field.asUint()}") when kind == reflection.FieldKind.Uint
		return field.asFloat() == 0.0 ?? ("", field.asFloat().str()) when kind == reflection.FieldKind.Float
		let declared = field.descriptor
		return "" unless kind == reflection.FieldKind.Enum && field.asInt() != 0 && !(declared is none)
		for let (_, member) in reflection.members(declared) {
			return member.node.name when reflection.scalarText(member.value) == "{field.asInt()}"
		}
		return ""
	}

	// The index in words of the first one that is neither a named argument
	// nor the value of one of specs; -1 when there is none. Words after
	// `--` are all positional.
	def firstPositional(words string[], specs FlagSpec[]) int {
		let at = 0
		for at < words.len() {
			let word = words[at]
			return at + 1 < words.len() ?? (at + 1, -1) when word == "--"
			return at unless word.len() > 1 && word.startsWith("-") && !word[1].isDigit() && word[1] != '.'
			at++
			continue when word.contains("=")
			if word.startsWith("--") {
				at++ when takesValue(specs, word[2:], true)
				continue
			}
			// A bundle: only its last letter can leave its value in the
			// next word.
			at++ when takesValue(specs, word[word.len() - 1:], false)
		}
		return -1
	}

	// Whether a name written on the command line is a flag of specs that
	// takes a value.
	def takesValue(specs FlagSpec[], name string, long bool) bool {
		for let (_, spec) in specs {
			let matches = long ?? (spec.name == name && name.len() > 1, spec.short == name || spec.name == name && name.len() == 1)
			continue unless matches
			return !(spec.shape := FlagShape.Switch || FlagShape.Count)
		}
		return false
	}

	// Reached is where a command line leads in the tree.
	struct Reached {
		// The nodes from the root to the one the words name.
		path    Command[]
		// The flags that may be given on the way and at the end.
		scope   FlagSpec[]
		// The words without the ones that named commands.
		left    string[]
		// Whether `help` came before the command.
		explain bool
		// The word that names no command where one was expected; "" when
		// every word was followed.
		unknown string
	}

	// Follows words down the tree from root as far as they name commands.
	// globals are the program's `@flag` variables, which any command line
	// may hold.
	def descend(root Command, words string[], globals FlagSpec[]) Reached {
		let out = Reached{path: [root], scope: globals.clone(), left: words.clone()}
		let node = root
		for node.problem == "" {
			out.scope.push(...node.flags()) unless node.runs() && node.children.len() == 0
			break when node.children.len() == 0
			// A flag of a command further down may be written before the
			// word that names it: its value is no command name.
			let ahead = out.scope.clone()
			ahead.push(...flagsBelow(node))
			let at = firstPositional(out.left, ahead)
			break when at < 0
			let word = out.left[at]
			if word == "help" && node == root && root.child("help") is none && !out.explain {
				out.explain = true
				out.left.remove(at)
				continue
			}
			let below = node.child(word)
			if below is none {
				out.unknown = word
				return out
			}
			out.left.remove(at)
			node = below
			out.path.push(node)
		}
		out.scope.push(...node.flags()) when node.runs() && node.children.len() == 0
		return out
	}

	// The flags of the commands under node, for telling a flag's value from
	// a command's name before the command is known. A name that takes a
	// value under one command and none under another is left out: such a
	// flag is written after its command.
	def flagsBelow(node Command) FlagSpec[] {
		let all FlagSpec[] = []
		gather(node, all)
		let out FlagSpec[] = []
		for let (_, spec) in all {
			let bare = spec.shape := FlagShape.Switch || FlagShape.Count
			let disputed = false
			for let (_, other) in all {
				let shared = other.name == spec.name || other.short != "" && other.short == spec.short
				let otherBare = other.shape := FlagShape.Switch || FlagShape.Count
				disputed = true when shared && bare != otherBare
			}
			out.push(spec) unless disputed
		}
		return out
	}

	def gather(node Command, into FlagSpec[]) {
		for let (_, below) in node.children {
			into.push(...below.flags())
			gather(below, into)
		}
	}

	// Follows words down the tree from root and does what they ask: runs
	// the command they name, or returns the screen to print for `--help`,
	// `help`, `--version`, `completion` and a group named without a
	// command. globals are the program's `@flag` variables.
	//
	// Fails with a UsageError when the words name no command, hold a flag
	// or argument that cannot be read, or leave a required one out.
	def dispatch(root Command, program string, version string, words string[], globals FlagSpec[]) !Outcome {
		// What the shell's completion asks, and the script that makes it ask.
		if words.len() > 0 && words[0] == completeWord && root.child(completeWord) is none {
			let line string[] = []
			line = words[2:].clone() when words.len() > 2
			return Outcome{screen: completions(root, words.len() > 1 ?? (words[1], ""), line, globals)}
		}
		let first = firstPositional(words, globals)
		if first >= 0 && words[first] == "completion" && root.children.len() > 0 && root.child("completion") is none {
			let shell = first + 1 < words.len() ?? (words[first + 1], "")
			let script = completionScript(shell, program)
			fail UsageError{message: "completion takes the shell to write the script for: {completionShells.join(", ")}", code: "BadValue", kind: UsageKind.BadValue, option: "completion"} when script == ""
			return Outcome{screen: script}
		}
		let reached = descend(root, words, globals)
		let path = reached.path
		let node = path[path.len() - 1]
		fail UsageError{message: "{commandLine(program, path)}: {node.problem}", code: "BadValue", kind: UsageKind.BadValue, option: node.name} unless node.problem == ""
		if reached.unknown != "" {
			let names string[] = []
			for let (_, candidate) in node.children {
				names.push(candidate.name) unless candidate.hidden
			}
			let near = closest(reached.unknown, names)
			let hint = near == "" ?? ("", "; did you mean {near}?")
			fail UsageError{message: "unknown command '{reached.unknown}'{hint}", code: "Unknown", kind: UsageKind.Unknown, option: reached.unknown}
		}
		let asked = try checkLine(reached.left, reached.scope)
		return Outcome{screen: "{program} {version}\n"} when asked == "version"
		return Outcome{screen: try helpScreen(commandHelp(program, version, path, globals))} when reached.explain || asked == "help" || !node.runs()
		return try execute(path, reached.left, globals)
	}

	// The first mistake in how the commands under node are declared, in
	// name order, with the command line that names the command; "" when
	// every declaration can be a command. above are the nodes down to node.
	def treeProblem(program string, node Command, above Command[]) string {
		let path = above.clone()
		path.push(node)
		return "{commandLine(program, path)}: {node.problem}" unless node.problem == ""
		for let (_, below) in node.children {
			let found = treeProblem(program, below, path)
			return found unless found == ""
		}
		return ""
	}

	// The command line that names the last node of path.
	def commandLine(program string, path Command[]) string {
		let out = program
		for let (_, node) in path {
			out += " " + node.name unless node.name == ""
		}
		return out
	}

	// Runs the last command of path with the words left for it: makes the
	// objects of the types on the way, fills their fields and the action's
	// parameters, and calls it. The outcome holds the error the command's
	// own code failed with, when it did.
	//
	// Fails with a UsageError when a flag or argument cannot be read, a
	// required argument is missing, or words are left over.
	def execute(path Command[], words string[], globals FlagSpec[]) !Outcome {
		let args = new Args(words)
		for let (_, spec) in globals {
			fill(args, spec, none) onerror recover none
			args.hide(spec.name) when spec.hidden
		}
		let last = path[path.len() - 1]
		// The object of each type on the path, the innermost last.
		let objects any[] = []
		let owners Command[] = []
		for let (_, node) in path {
			let described = node.described
			continue when described is none
			let made = reflection.instantiate(described)
			link(made, node, objects, owners)
			objects.push(made)
			owners.push(node)
		}
		// Flags first, anywhere on the line; then the words that are left go
		// to the arguments in order.
		let values any[] = []
		for let i = 0; i < last.arity; i++ {
			values.push(none)
		}
		// The parameters nothing on the line gives a value.
		let missing Input[] = []
		// The object of each bundle of each node on the path.
		let held any[][]
		for let (_, node) in path {
			let made any[] = []
			for let (_, bundle) in node.bundles {
				made.push(reflection.instantiate(bundle.described))
			}
			held.push(made)
		}
		for let (step, node) in path {
			let level = owners.indexOf(node)
			for let (_, input) in node.inputs {
				continue when input.positional
				let value = try resolve(args, input.spec, true)
				if input.bundle >= 0 {
					store(held[step][input.bundle], input, value)
				} else if input.index >= 0 {
					values[input.index] = value unless value is none
					missing.push(input) when value is none
				} else {
					store(objects[level], input, value)
				}
			}
		}
		let handler = last.handler
		if !(handler is none) {
			let failure ?error = none
			handler(args) onerror (err error) {
				failure = err
				recover none
			}
			// What the command's own reading of the line refuses is the
			// line's fault.
			fail failure when failure is UsageError
			return Outcome{failure: failure}
		}
		let given = try args.end()
		let taken = 0
		for let (step, node) in path {
			for let (_, input) in node.inputs {
				continue unless input.positional
				let label = "<{input.spec.name}>"
				let value ?any = none
				if input.rest {
					let rest = given[taken:].clone()
					taken = given.len()
					value = try readList(input.spec, rest, label, true)
				} else if taken < given.len() {
					value = try read(input.spec, given[taken], label, true)
					taken++
				} else if input.needed {
					fail UsageError{message: "the argument {label} is missing", code: "Required", kind: UsageKind.Required, option: label} unless canAsk()
					value = try read(input.spec, try askFor(input.spec), label, true)
				}
				if input.bundle >= 0 {
					store(held[step][input.bundle], input, value)
				} else if input.index >= 0 {
					values[input.index] = value unless value is none
					missing.push(input) when value is none
				} else if !(value is none) {
					store(objects[owners.indexOf(node)], input, value)
				}
			}
		}
		fail UsageError{message: "unexpected argument '{given[taken]}'", code: "Unknown", kind: UsageKind.Unknown, option: given[taken]} when taken < given.len()
		// Each bundle goes where it is taken, the inner ones first.
		for let (step, node) in path {
			for let at = node.bundles.len() - 1; at >= 0; at-- {
				let bundle = node.bundles[at]
				if bundle.parent >= 0 {
					let slot = reflection.field(held[step][bundle.parent], bundle.field)
					slot.set(held[step][at]) unless slot is none
				} else if bundle.index >= 0 {
					values[bundle.index] = held[step][at]
				} else {
					let slot = reflection.field(objects[owners.indexOf(node)], bundle.field)
					slot.set(held[step][at]) unless slot is none
				}
			}
		}
		// A parameter left out takes its default, the earlier ones first: a
		// default may read the parameters before its own.
		missing.sort((a, b) => a.index - b.index)
		for let (_, input) in missing {
			let option = input.positional ?? ("<{input.spec.name}>", spelled(input.spec.name))
			let value = try defaultFor(last, input, option, values)
			values[input.index] = value unless value is none
		}

		let action = last.action
		if !(action is none) {
			let receiver any = none
			receiver = objects[objects.len() - 1] when objects.len() > 0 && owners[owners.len() - 1] != last
			return outcomeOf(reflection.invoke(action, receiver, values))
		}
		let subject = objects[objects.len() - 1]
		let checks = last.validator
		if !(checks is none) {
			let refused = outcomeOf(reflection.invoke(checks, subject, []))
			return refused unless refused.failure is none
		}
		let runner = last.runner
		return Outcome{} when runner is none
		return outcomeOf(reflection.invoke(runner, subject, []))
	}

	// Ties a new object into the ones above it: the parent's field for
	// this subcommand holds it, and its own fields of an ancestor's type
	// hold that ancestor.
	def link(made any, node Command, objects any[], owners Command[]) {
		return when objects.len() == 0
		let parent = owners[owners.len() - 1]
		for let (name, field) in parent.childFields {
			continue unless kebabCase(name) == node.name
			let slot = reflection.field(objects[objects.len() - 1], field == "" ?? (name, name))
			slot.set(made) unless slot is none
		}
		for let (_, field) in reflection.fields(made) {
			for let (level, owner) in owners {
				let described = owner.described
				continue when described is none || field.hasAttr(commandMeta)
				field.set(objects[level]) when field.typeName == described.typeName
			}
		}
	}

	// The value a parameter left off the command line takes: what its
	// default computes, as a direct call would get it, given the values of
	// the parameters before it; else what the default as written stands
	// for.
	//
	// Fails when the default reads the command's object or a parameter
	// after its own.
	def defaultFor(node Command, input Input, option string, given any[]) !?any {
		let action = node.action
		if !(action is none) && input.index >= 0 {
			let made = reflection.defaultOf(action, input.index, given)
			return made unless made is none
		}
		return literalValue(input.spec, input.literal, option)
	}

	def store(target any, input Input, value ?any) {
		return when value is none
		let slot = reflection.field(target, input.field)
		slot.set(value) unless slot is none
	}

	// What a call through reflection came to: a failure when it returned
	// an error.
	def outcomeOf(result any) Outcome {
		let out = Outcome{}
		out.failure = result when result is error
		return out
	}

	// The commands every program with commands answers at its root, unless
	// it has one of the name.
	def builtinCommands(root Command) HelpRow[] {
		let rows = [HelpRow{usage:"completion", description:"Write the completion script for a shell"}, HelpRow{usage:"help", description:"Show the help of a command"}]
		return rows.filter(row => root.child(row.usage) is none)
	}

	// The help screen's data for the last command of path.
	def commandHelp(program string, version string, path Command[], globals FlagSpec[]) HelpData {
		let node = path[path.len() - 1]
		let own FlagSpec[] = []
		let inherited = globals.clone()
		for let (level, above) in path {
			let leaf = level == path.len() - 1
			let action = above.action
			for let (_, input) in above.inputs {
				continue when input.positional
				let spec = input.spec
				if !leaf {
					inherited.push(spec)
					continue
				}
				// A default that is not written as a plain value is worked
				// out, for the command whose help this is only.
				if spec.defaultValue == "" && input.index >= 0 && input.literal != "" && !(action is none) {
					spec = FlagSpec{...spec, defaultValue: shownValue(spec, reflection.defaultOf(action, input.index))}
				}
				own.push(spec)
			}
		}
		let specs = own.clone()
		for let (_, spec) in inherited {
			let shared = spec
			// On a command's screen the flags from above get a heading of
			// their own.
			shared = FlagSpec{...spec, group: "Global options"} when path.len() > 1 && spec.group == ""
			specs.push(shared)
		}
		let data = helpData(program, version, specs)
		data.description = node.description
		let usage = commandLine(program, path)
		usage += " <command>" when node.children.len() > 0
		usage += " [options]"
		usage += " [arguments]" unless node.handler is none
		for let (_, above) in path {
			for let (_, input) in above.positionals() {
				let name = input.spec.name
				usage += input.rest ?? (" [{name}...]", input.needed ?? (" <{name}>", " [{name}]"))
				let row = HelpRow{usage: name, description: input.spec.description}
				data.width = row.usage.len() when row.usage.len() > data.width
				data.arguments.push(row)
			}
		}
		data.usage = usage
		for let (_, below) in node.children {
			continue when below.hidden
			let names = [below.name]
			names.push(...below.aliases)
			let row = HelpRow{usage: names.join(", "), description: below.summary}
			data.width = row.usage.len() when row.usage.len() > data.width
			data.commands.push(row)
		}
		if path.len() == 1 && node.children.len() > 0 {
			for let (_, row) in builtinCommands(node) {
				data.width = row.usage.len() when row.usage.len() > data.width
				data.commands.push(row)
			}
			data.commands.sort((a, b) => a.usage.compare(b.usage))
		}
		return data
	}
}
