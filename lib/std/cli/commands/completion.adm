// Shell completion for a program with commands: what it answers when the
// shell asks what may come next on its command line.
internal partial module std.cli.commands {
	use std.cli.flags::*

	// What the last of words may become, as the shell wants it listed: a
	// candidate a line and `:files` when file names fit too (see `listed`). words are the words of the command line after the program,
	// the one being written last. globals are the program's `@flag`
	// variables.
	def completions(root Command, shell string, words string[], globals FlagSpec[]) string {
		let line = writtenOf(shell, words)
		let before = line.before
		let current = line.current
		// The shell the script of `completion` is written for.
		let first = firstPositional(before, globals)
		if first >= 0 && before[first] == "completion" && root.child("completion") is none {
			return listed(valuesOf(completionFlag()), line, shell, false)
		}
		let reached = descend(root, before, globals)
		let node = reached.path[reached.path.len() - 1]
		let positionalOnly = before.includes("--")
		let names string[] = []
		for let (_, above) in reached.path {
			names.push(above.name) unless above.name == ""
		}
		let found Candidate[] = []
		let files = false
		let wanted = flagAwaited(line, reached.scope)
		if !(wanted is none) {
			let given = supplied(names, wanted.name, current)
			found = given is none ?? (valuesOf(wanted), given)
			files = given is none && (wanted.kind := "file" || "string")
		} else if current.startsWith("-") && !positionalOnly {
			found = flagCandidates(reached.scope, before)
		} else if reached.unknown == "" {
			for let (_, below) in node.children {
				found.push(Candidate{text: below.name, description: below.summary}) unless below.hidden
			}
			if node == root && root.children.len() > 0 {
				for let (_, row) in builtinCommands(root) {
					found.push(Candidate{text: row.usage, description: row.description})
				}
				found.sort((a, b) => a.text.compare(b.text))
			}
			// The argument the word would be: as many are taken as words
			// that are not flags came before.
			let taken = 0
			let rest = reached.left
			for {
				let at = firstPositional(rest, reached.scope)
				break when at < 0
				taken++
				rest = rest[at + 1:].clone()
			}
			let places Input[] = []
			for let (_, above) in reached.path {
				places.push(...above.positionals())
			}
			let place = taken < places.len() ?? (taken, places.len() - 1)
			if place >= 0 && (place == taken || places[place].rest) {
				let given = supplied(names, places[place].spec.name, current)
				found.push(...(given is none ?? (valuesOf(places[place].spec), given)))
				files = given is none && (places[place].spec.kind := "file" || "string")
			}
			// A command that reads its own words may take a file anywhere,
			// unless the program says what it takes.
			if !(node.handler is none) {
				let given = supplied(names, "", current)
				found.push(...given) unless given is none
				files = given is none
			}
		}
		return listed(found, line, shell, files)
	}
}
