partial module std.cli {
	use (
		std.cli.commands::*
		std.cli.flags::*
		std.reflection
		std.testing
	)

	// What the demo commands did, one line a run.
	let commandLog string[] = []

	enum DemoLevel {
		Low,
		High,
	}

	// Start the server.
	// Listens until it is stopped.
	// @param port Port to listen on.
	// @param rest Folders to serve.
	@command
	def serveDemo(@flag(short = "p") port int = 8080, verbose bool = false, level DemoLevel = DemoLevel.Low, config ?string = none, rest ...string) !none {
		commandLog.push("serve port={port} verbose={verbose} level={level.name} config={config is none ?? ("-", config)} rest={rest.join("+")}")
		return none
	}

	@command(name = "fail", hidden = true)
	def failDemo(reason string, @arg times int = 1) !none {
		fail "{reason} x{times}"
	}

	// Manage remotes.
	@command(aliases = "remotes")
	type RemoteDemo {
		@flag(short = "q", description = "Say less")
		quiet bool
		@flag(description = "Where remotes are kept")
		store string = "default"
		@command
		add RemoteAddDemo

		// Remove a remote.
		// @param name Which one.
		@command(aliases = "rm")
		def remove(name string, force bool = false) !none {
			commandLog.push("remove {name} force={force} quiet={quiet} store={store}")
			return none
		}

		// List remotes.
		@command
		def list() !none {
			commandLog.push("list quiet={quiet}")
			return none
		}
	}

	// Add a remote.
	@command
	type RemoteAddDemo {
		@flag(short = "f")
		fetch bool
		@arg(description = "Its name")
		name string
		@arg
		tags string[]
		// The group this command is under.
		remote RemoteDemo

		def validate() !none {
			fail "the name is too short" when name.len() < 2
			return none
		}

		def run() !none {
			commandLog.push("add {name} fetch={fetch} tags={tags.join("+")} quiet={remote.quiet}")
			return none
		}
	}

	// How the demo commands write their output: flags declared once, taken
	// by any command.
	type OutputDemo {
		// How to write it.
		@flag(short = "o")
		format DemoLevel
		@flag(description = "Lines at most")
		limit int = 10
		@flag
		level DemoLevel = DemoLevel.High
		@flag
		ratio float = 0.5
	}

	// Show what is there.
	// @param what Which kind.
	@command
	def showDemo(what DemoLevel, output OutputDemo, plain bool = false) !none {
		commandLog.push("show {what.name} format={output.format.name} limit={output.limit} plain={plain}")
		return none
	}

	// Send things out.
	@command
	type ExportDemo {
		@flag
		output OutputDemo
		// Leave the old file.
		// Whatever it holds.
		@flag(excludes = "quiet")
		keep bool
		@flag(requires = "limit")
		quiet bool
		// Where to.
		@arg
		target ?string

		def run() !none {
			let to = target
			commandLog.push("export to={to is none ?? ("-", to)} keep={keep} format={output.format.name} limit={output.limit}")
			return none
		}
	}

	// Where a deploy goes: flags and an argument inside a set of flags.
	type TargetDemo {
		@flag
		region string = "eu"
		// What to send.
		@arg
		artifact string
	}

	type DeployOptionsDemo {
		@flag(short = "n")
		dryRun bool
		@flag
		target TargetDemo
	}

	// Send a build out.
	@command
	def deployDemo(options DeployOptionsDemo, tag string = "latest", store bool = false) !none {
		commandLog.push("deploy {options.target.artifact} region={options.target.region} dry={options.dryRun} tag={tag} store={store}")
		return none
	}

	def demoPort() int {
		return 9000 + 90
	}

	def demoLevel() DemoLevel {
		return DemoLevel.High
	}

	// Ping a host.
	@command(hidden = true)
	def pingDemo(host string = "local" + "host", port int = demoPort(), level DemoLevel = demoLevel(), quiet bool = demoPort() > 1, @arg times int = demoPort() / 1000, twice int = port * 2) !none {
		commandLog.push("ping {host}:{port} level={level.name} quiet={quiet} times={times} twice={twice}")
		return none
	}

	@command(hidden = true)
	type BrokenDemo {
		def run(times int) !none {
			return none
		}
	}

	check "Commands" {
		// What a command line comes to: "ok", a screen, "usage: ..." or
		// "failed: ...".
		def demo(words string[]) string {
			let tree = commandTree(reflection.attrs(command))
			let message = ""
			let outcome = dispatch(tree, "tool", "1.0", words, []) onerror (err error) {
				message = "usage: " + err.message
				recover Outcome{}
			}
			return message unless message == ""
			return outcome.screen unless outcome.screen == ""
			let failed = outcome.failure
			return failed is none ?? ("ok", "failed: " + failed.message)
		}

		@test()
		def TestFunctionCommand() {
			assert demo(["serve-demo", "--port", "9000", "a", "--verbose", "b", "--level", "high"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "serve port=9000 verbose=true level=High config=- rest=a+b"
			assert demo(["serve-demo"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "serve port=8080 verbose=false level=Low config=- rest="
			assert demo(["serve-demo", "-p", "1", "--config", "c.toml"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "serve port=1 verbose=false level=Low config=c.toml rest="
		}

		@test()
		def TestGroupMethodsShareTheGroupsFlags() {
			assert demo(["remote-demo", "remove", "origin", "--force", "-q"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "remove origin force=true quiet=true store=default"
			assert demo(["remotes", "rm", "x", "--store", "s"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "remove x force=false quiet=false store=s"
			// A group's flag may come before the subcommand.
			assert demo(["remote-demo", "-q", "--store=t", "list"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "list quiet=true"
		}

		@test()
		def TestTypeCommandUnderAGroup() {
			assert demo(["remote-demo", "add", "origin", "t1", "-f", "t2", "-q"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "add origin fetch=true tags=t1+t2 quiet=true"
			assert demo(["remote-demo", "add", "upstream"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "add upstream fetch=false tags= quiet=false"
			assert demo(["remote-demo", "add", "o"]) == "failed: the name is too short"
		}

		@test()
		def TestWhatACommandLineGetsWrong() {
			assert demo(["remot"]) == "usage: unknown command 'remot'; did you mean remote-demo?"
			assert demo(["remote-demo", "delete", "x"]) == "usage: unknown command 'delete'"
			assert demo(["serve-demo", "--prot", "1"]) == "usage: unknown option --prot; did you mean --port?"
			assert demo(["serve-demo", "--port", "nine"]) == "usage: --port: 'nine' is not a whole number"
			assert demo(["serve-demo", "--level", "mid"]) == "usage: --level: 'mid' is not one of low, high"
			assert demo(["remote-demo", "remove"]) == "usage: the argument <name> is missing"
			assert demo(["remote-demo", "list", "x"]) == "usage: unexpected argument 'x'"
			assert demo(["fail", "boom"]) == "failed: boom x1"
			assert demo(["fail", "boom", "3"]) == "failed: boom x3"
			assert demo(["fail", "boom", "many"]) == "usage: <times>: 'many' is not a whole number"
		}

		@test()
		def TestFlagsDeclaredOnceAsATypeOfTheirOwn() {
			assert demo(["show-demo", "high", "-o", "high", "--limit", "3", "--plain"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "show High format=High limit=3 plain=true"
			assert demo(["show-demo", "low"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "show Low format=Low limit=10 plain=false"
			assert demo(["export-demo", "out.txt", "--format=high", "--keep"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "export to=out.txt keep=true format=High limit=10"
			assert demo(["export-demo"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "export to=- keep=false format=Low limit=10"
			let screen = demo(["show-demo", "--help"])
			assert screen.startsWith("Usage: tool show-demo [options] <what>\n\nShow what is there.\n")
			let lines = screen.split("\n")
			assert lines.filter(line => line.startsWith("  -o, --format <low|high> ") && line.endsWith("How to write it.")).len() == 1
			assert lines.filter(line => line.startsWith("      --limit <int> ") && line.endsWith("Lines at most (default 10)")).len() == 1
			assert lines.filter(line => line.startsWith("      --level <low|high> ") && line.endsWith("(default high)")).len() == 1
			assert lines.filter(line => line.startsWith("      --ratio <number> ") && line.endsWith("(default 0.5)")).len() == 1
		}

		@test()
		def TestAFieldsDocCommentIsItsHelp() {
			let screen = demo(["export-demo", "--help"])
			let lines = screen.split("\n")
			assert lines.filter(line => line.startsWith("      --keep ") && line.endsWith("Leave the old file.")).len() == 1
			assert lines.filter(line => line.startsWith("  target ") && line.endsWith("Where to.")).len() == 1
		}

		@test()
		def TestFlagsOfDifferentLevelsExcludeAndRequireEachOther() {
			assert demo(["export-demo", "--keep", "--quiet", "--limit", "1"]) == "usage: --keep cannot be used with --quiet"
			assert demo(["export-demo", "--quiet"]) == "usage: --quiet needs --limit"
			assert demo(["export-demo", "--quiet", "--limit", "2"]) == "ok"
		}

		@test()
		def TestCommandsDeclaredByACall() {
			if commandTree(reflection.attrs(command)).child("cache") is none {
				addCommand("cache clear", "Remove every cached file.\nAll of them.", def (args Args) !none {
					let all = try args.flag("all")
					let rest = try args.end()
					fail "nothing to clear" when rest.includes("nothing")
					commandLog.push("clear all={all} rest={rest.join("+")}")
					return none
				})
			}
			assert demo(["cache", "clear", "--all", "a", "b"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "clear all=true rest=a+b"
			assert demo(["cache", "clear", "--al"]) == "usage: unknown option --al; did you mean --all?"
			assert demo(["cache", "clear", "nothing"]) == "failed: nothing to clear"
			let group = demo(["cache"])
			assert group.startsWith("Usage: tool cache <command> [options]\n\nCommands:\n  clear ") && group.contains(" Remove every cached file.\n")
			assert demo(["cache", "clear", "--help"]).startsWith("Usage: tool cache clear [options] [arguments]\n\nRemove every cached file.\nAll of them.\n")
		}

		// What the shell is told may come next after words, between commas.
		def offered(shell string, words string[]) string {
			let line = [completeWord, shell]
			line.push(...words)
			let said = demo(line)
			// Nothing to offer is an empty screen, which `demo` calls a run.
			return said == "ok" ?? ("", said.trimSuffix("\n").replace("\n", ","))
		}

		@test()
		def TestCompletionOfCommandsFlagsAndValues() {
			let first = offered("bash", [""]).replace("cache,", "")
			assert first == "completion,deploy-demo,export-demo,help,remote-demo,serve-demo,show-demo"
			assert offered("bash", ["completion", ""]) == "bash,zsh,fish,powershell"
			assert offered("bash", ["re"]) == "remote-demo"
			assert offered("bash", ["remote-demo", ""]) == "add,list,remove"
			assert offered("bash", ["remote-demo", "-q", "r"]) == "remove"
			assert offered("bash", ["serve-demo", "--"]) == "--config,--help,--level,--port,--verbose"
			assert offered("bash", ["serve-demo", "--port", "1", "--"]) == "--config,--help,--level,--verbose"
			assert offered("bash", ["remote-demo", "remove", "--"]) == "--force,--help,--quiet,--store"
			// The value of a flag: after it, and after `=`.
			assert offered("bash", ["serve-demo", "--level", ""]) == "low,high"
			assert offered("bash", ["serve-demo", "--level", "h"]) == "high"
			assert offered("bash", ["serve-demo", "--level", "="]) == "low,high"
			assert offered("bash", ["serve-demo", "--level", "=", "l"]) == "low"
			assert offered("zsh", ["serve-demo", "--level=h"]) == "--level=high"
			assert offered("bash", ["serve-demo", "--port", ""]) == ""
			assert offered("bash", ["serve-demo", "--config", ""]) == ":files"
			assert offered("bash", ["serve-demo", "-p", ""]) == ""
			// Arguments: an enum's members, file names for text.
			assert offered("bash", ["show-demo", ""]) == "low,high"
			assert offered("bash", ["show-demo", "low", ""]) == ""
			assert offered("bash", ["serve-demo", "a", ""]) == ":files"
			assert offered("bash", ["export-demo", ""]) == ":files"
			assert offered("bash", ["serve-demo", "--", "-"]) == ":files"
			assert offered("bash", ["nothing", ""]) == ""
			assert demo([completeWord]).contains("serve-demo\n") && demo([completeWord, "bash"]).contains("serve-demo\n")
		}

		@test()
		def TestCompletionSaysWhatACandidateIs() {
			assert offered("zsh", ["remote-demo", "l"]) == "list:List remotes."
			assert offered("fish", ["remote-demo", "l"]) == "list\tList remotes."
			assert offered("zsh", ["remote-demo", "--q"]) == "--quiet:Say less"
			assert offered("powershell", ["remote-demo", "l"]) == "list\tList remotes."
			// PowerShell writes the empty word as two quotes.
			assert offered("powershell", ["remote-demo", "\"\""]) == offered("fish", ["remote-demo", ""])
		}

		@test()
		def TestCompletionWithCandidatesOfTheProgram() {
			completeWith("remote-demo remove name", (word string) => ["origin", "upstream"])
			completeWith("--tag", (word string) => ["latest", "stable", word + "-rc"])
			completeWith("cache clear", (word string) => ["everything", "nothing"])
			assert offered("bash", ["remote-demo", "remove", ""]) == "origin,upstream"
			assert offered("bash", ["remote-demo", "rm", "u"]) == "upstream"
			// The name alone answers under any command.
			assert offered("bash", ["deploy-demo", "--tag", ""]) == "latest,stable,-rc"
			assert offered("bash", ["deploy-demo", "--tag", "s"]) == "stable,s-rc"
			assert offered("zsh", ["deploy-demo", "--tag=l"]) == "--tag=latest,--tag=l-rc"
			// A command added by a call, for the words it reads itself.
			if !(commandTree(reflection.attrs(command)).child("cache") is none) {
				assert offered("bash", ["cache", "clear", "n"]) == "nothing"
			}
		}

		@test()
		def TestFlagsInsideFlagsAndArgumentsAmongThem() {
			assert demo(["deploy-demo", "app.tar", "--region", "us", "-n", "--tag", "v2"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "deploy app.tar region=us dry=true tag=v2 store=false"
			assert demo(["deploy-demo", "app.tar"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "deploy app.tar region=eu dry=false tag=latest store=false"
			assert demo(["deploy-demo"]) == "usage: the argument <artifact> is missing"
			let screen = demo(["deploy-demo", "--help"])
			assert screen.startsWith("Usage: tool deploy-demo [options] <artifact>\n\nSend a build out.\n\nArguments:\n")
			assert screen.contains("  artifact ") && screen.contains("What to send.")
			assert screen.contains("      --region <text> ") && screen.contains("  -n, --dry-run")
		}

		@test()
		def TestAFlagBeforeTheCommandItBelongsTo() {
			assert demo(["--port", "9000", "serve-demo", "x"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "serve port=9000 verbose=false level=Low config=- rest=x"
			assert demo(["-p", "7", "--verbose", "serve-demo"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "serve port=7 verbose=true level=Low config=- rest="
			assert demo(["remote-demo", "--force", "remove", "x"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "remove x force=true quiet=false store=default"
			// A flag that belongs to another command is still refused.
			assert demo(["--port", "9000", "show-demo", "low"]) == "usage: unknown option --port"
			// `--store` takes a value under one command and none under
			// another, so before the command it is read as taking none.
			assert demo(["--store", "deploy-demo", "app.tar"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "deploy app.tar region=eu dry=false tag=latest store=true"
			assert demo(["--store", "s", "remote-demo", "list"]) == "usage: unknown command 's'"
		}

		@test()
		def TestDefaultsThatAreWorkedOut() {
			assert demo(["ping-demo", "--twice", "1"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "ping localhost:9090 level=High quiet=true times=9 twice=1"
			assert demo(["ping-demo", "3", "--twice", "1", "--port", "7", "--no-quiet", "--level", "low"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "ping localhost:7 level=Low quiet=false times=3 twice=1"
			// A default that reads the parameters before it gets them.
			assert demo(["ping-demo"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "ping localhost:9090 level=High quiet=true times=9 twice=18180"
			assert demo(["ping-demo", "--port", "4"]) == "ok"
			assert commandLog[commandLog.len() - 1] == "ping localhost:4 level=High quiet=true times=9 twice=8"
			let screen = demo(["ping-demo", "--help"])
			let lines = screen.split("\n")
			assert lines.filter(line => line.startsWith("      --host <text> ") && line.endsWith("(default localhost)")).len() == 1
			assert lines.filter(line => line.startsWith("      --port <int> ") && line.endsWith("(default 9090)")).len() == 1
			assert lines.filter(line => line.startsWith("      --level <low|high> ") && line.endsWith("(default high)")).len() == 1
			assert lines.filter(line => line.startsWith("      --twice <int>") && !line.contains("default")).len() == 1
		}

		@test()
		def TestTheFirstMistakeInTheTreeIsFound() {
			let tree = commandTree(reflection.attrs(command))
			assert treeProblem("tool", tree, []) == "tool broken-demo: run takes no parameters: what the command reads is declared as its @flag and @arg fields"
			let fine = new Command("")
			fine.children.push(new Command("ok"))
			assert treeProblem("tool", fine, []) == ""
			let deep = new Command("fix")
			deep.problem = "its type Missing is not a @command"
			fine.children[0].children.push(deep)
			assert treeProblem("tool", fine, []) == "tool ok fix: its type Missing is not a @command"
		}

		@test()
		def TestRunWithParametersIsRefused() {
			assert demo(["broken-demo"]) == "usage: tool broken-demo: run takes no parameters: what the command reads is declared as its @flag and @arg fields"
		}

		@test()
		def TestCompletionScripts() {
			let bash = demo(["completion", "bash"])
			assert bash.contains("complete -o default -F _my_tool_complete my-tool\n") == false
			assert bash.contains("complete -o default -F _tool_complete tool\n")
			assert bash.contains("\"$\{COMP_WORDS[0]\}\" __complete bash \"$\{COMP_WORDS[@]:1:COMP_CWORD\}\"")
			assert demo(["completion", "zsh"]).startsWith("#compdef tool\n_tool() \{\n")
			assert demo(["completion", "fish"]).contains("complete -c tool -f -a '(__tool_complete)'\n")
			assert completionScript("bash", "my-tool").contains("complete -o default -F _my_tool_complete my-tool\n")
			assert demo(["completion", "powershell"]).contains("Register-ArgumentCompleter -Native -CommandName 'tool' -ScriptBlock \{\n")
			assert demo(["completion"]) == "usage: completion takes the shell to write the script for: bash, zsh, fish, powershell"
			assert demo(["completion", "csh"]) == "usage: completion takes the shell to write the script for: bash, zsh, fish, powershell"
		}

		@test()
		def TestHelpOfTheProgram() {
			let screen = demo(["--help"])
			assert screen.startsWith("Usage: tool <command> [options]\n\nCommands:\n")
			assert screen.contains("  completion            Write the completion script for a shell\n")
			assert screen.contains("  help                  Show the help of a command\n")
			assert screen.contains("  remote-demo, remotes  Manage remotes.\n")
			assert screen.contains("  serve-demo            Start the server.\n")
			assert !screen.contains("fail")
			assert screen.contains("\nOptions:\n") && screen.contains("-h, --help")
			assert demo([]) == screen
			assert demo(["help"]) == screen
			assert demo(["--version"]) == "tool 1.0\n"
		}

		@test()
		def TestHelpOfACommand() {
			let screen = demo(["serve-demo", "--help"])
			assert screen.startsWith("Usage: tool serve-demo [options] [rest...]\n\nStart the server.\nListens until it is stopped.\n\nArguments:\n")
			assert screen.contains("  rest") && screen.contains("Folders to serve.")
			let lines = screen.split("\n")
			assert lines.filter(line => line.startsWith("  -p, --port <int> ") && line.endsWith("Port to listen on. (default 8080)")).len() == 1
			assert lines.filter(line => line.startsWith("      --level <low|high> ") && line.endsWith("(default low)")).len() == 1
			assert screen.contains("      --config <text>") && screen.contains("      --verbose")
			assert demo(["help", "serve-demo"]) == screen
			assert demo(["serve-demo", "-h", "--port", "nine"]) == screen
		}

		@test()
		def TestHelpOfAGroupAndBelow() {
			let group = demo(["remote-demo"])
			assert group.startsWith("Usage: tool remote-demo <command> [options]\n\nManage remotes.\n\nCommands:\n")
			assert group.contains("  add ") && group.contains("Add a remote.")
			assert group.contains("  remove, rm ") && group.contains("Remove a remote.")
			assert group.contains("  -q, --quiet ") && group.contains("Say less")
			assert group.contains("      --store <text> ") && group.contains("Where remotes are kept (default default)")
			assert demo(["help", "remotes"]) == group && demo(["remote-demo", "--help"]) == group
			let below = demo(["remote-demo", "add", "--help"])
			assert below.startsWith("Usage: tool remote-demo add [options] <name> [tags...]\n\nAdd a remote.\n\nArguments:\n")
			assert below.contains("  name ") && below.contains("Its name")
			assert below.contains("\nOptions:\n  -f, --fetch\n")
			assert below.contains("\nGlobal options:\n") && below.indexOf("--quiet") > below.indexOf("Global options:")
			let method = demo(["help", "remote-demo", "rm"])
			assert method.startsWith("Usage: tool remote-demo remove [options] <name>\n\nRemove a remote.\n")
			assert method.contains("  name ") && method.contains("Which one.") && method.contains("      --force")
		}

		@test()
		def TestBuiltInHelpEqualsTheTemplateForCommands() !none {
			let tree = commandTree(reflection.attrs(command))
			let group = tree.child("remote-demo")
			fail "no remote-demo" when group is none
			let leaf = group.child("add")
			fail "no add" when leaf is none
			for let (_, path) in [[tree], [tree, group], [tree, group, leaf]] {
				let data = commandHelp("tool", "1.0", path, [])
				assert plainHelp(data) == (try renderTemplate(defaultHelpTemplate(), data))
			}
			return none
		}

		@test()
		def TestFirstPositionalSkipsFlagsAndTheirValues() {
			let port = FlagSpec{name: "port", short: "p", shape: FlagShape.Value, kind: "int"}
			let quiet = FlagSpec{name: "quiet", short: "q", shape: FlagShape.Switch, kind: "bool"}
			let specs = [port, quiet]
			assert firstPositional(["serve"], specs) == 0
			assert firstPositional(["-q", "serve"], specs) == 1
			assert firstPositional(["--port", "80", "serve"], specs) == 2
			assert firstPositional(["--port=80", "serve"], specs) == 1
			assert firstPositional(["-qp", "80", "serve"], specs) == 2
			assert firstPositional(["-p80", "serve"], specs) == 1
			assert firstPositional(["--other", "serve"], specs) == 1
			assert firstPositional(["--quiet", "--port", "80"], specs) == -1
			assert firstPositional(["--", "--port"], specs) == 1
			assert firstPositional(["-5", "x"], specs) == 0
			assert firstPositional([], specs) == -1
		}
	}
}
