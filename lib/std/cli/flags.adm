partial module std.cli {
	use (
		std.cli.flags::*
		std.os
		std.reflection
		std.reflection::(ConstMetaContext, ValueEditor, VariableDescriptor, VariableMetaContext)
		std.services::(Application)
	)

	// Fills the variable from the command line when the program first uses
	// it: `@flag let port int = 8080` reads `--port 9000`, `--port=9000`.
	// The value the variable is declared with is the flag's default: it
	// stays when the flag is not given, and help shows it.
	//
	// The variable's type decides what the flag takes:
	//
	//   - `bool` is a switch: `--verbose`, `--verbose=false`, `--no-verbose`.
	//   - `string`, the integer and the float types take a value; a number
	//     that does not fit the type is refused.
	//   - `duration` takes `30s`, `5m`, `1h30m`.
	//   - An enum takes a member's name in kebab case (`--mode dev`).
	//   - `?os.File` takes a path and holds the file opened for reading;
	//     `-` is standard input, and `~/` the user's home folder.
	//   - `time.Time`, `url.URL` (`std.net.url`) and `semver.Semver`
	//     (`std.data.semver`) take what their `parse` reads.
	//   - `?T` of any of those is none until the flag is given.
	//   - An array of any of those but `bool` collects every occurrence;
	//     a `map<string, T>` of `string`, `int`, `float`, `bool` or
	//     `duration` collects `--define key=value`.
	//
	// name is the flag's long name; left out, it is the variable's name in
	// kebab case (`dryRun` is `--dry-run`). short is the one-letter form
	// (`short = "p"` also reads `-p 9000`); a name of one letter is a short
	// flag with no long form. description is the text help shows; left out,
	// it is the first line of the variable's doc comment. A hidden flag is
	// read like any other and left out of help.
	//
	// env names an environment variable read when the flag is not given:
	// the command line wins, then the variable, then the declared value. A
	// list or a map takes the values between its commas. A required flag
	// must be given one way or the other; on a terminal the program asks
	// for it instead of ending. count makes an integer count how
	// often its flag is written: `-vvv` is 3. mode is how a file flag opens
	// its file: `r`, `w`, `a`, with `+` for both ways; `-` is then standard
	// output for the modes that write. placeholder is the stand-in for
	// the value in help (`placeholder = "port"` shows `--port <port>`),
	// group the heading help lists the flag under, and excludes the names,
	// between commas, of flags this one cannot be given with; requires
	// names the flags that must be given when this one is. A flag counts as
	// given when it is written or its environment variable is set.
	//
	// The first flag a program reads checks the whole command line: `--help`
	// or `-h` prints `help()` and `--version` the program's name and
	// version, and the program ends; a value that does not fit its flag
	// ends it with a message on standard error and exit status 2, as do a
	// required flag left out and a variable of a type no flag fills.
	// `--completion bash` (or `zsh`, `fish`, `powershell`) writes the script
	// that makes the shell complete the program's flags and their values.
	meta def flag(target VariableMetaContext, name string = "", short string = "", description string = "", hidden bool = false, env string = "", required bool = false, count bool = false, mode string = "r", placeholder string = "", group string = "", excludes string = "", requires string = "") {
		bindFlag(target.descriptor, target.editor, FlagOptions{name: name, short: short, env: env, required: required, count: count, mode: mode, placeholder: placeholder, excludes: excludes, requires: requires})
	}

	// Fills the constant from the command line when the program first uses
	// it; see `flag` on a variable.
	meta def flag(target ConstMetaContext, name string = "", short string = "", description string = "", hidden bool = false, env string = "", required bool = false, count bool = false, mode string = "r", placeholder string = "", group string = "", excludes string = "", requires string = "") {
		bindFlag(target.descriptor.variable, target.editor, FlagOptions{name: name, short: short, env: env, required: required, count: count, mode: mode, placeholder: placeholder, excludes: excludes, requires: requires})
	}

	// Returns the help screen `--help` prints: the program's usage line and
	// its `@flag` variables with their descriptions and defaults, under
	// their group headings. A program replaces the layout with
	// `helpTemplate` and has descriptions read as Markdown with
	// `helpMarkdown`.
	//
	// Fails when a template given to `helpTemplate` cannot be rendered.
	def help() !string {
		return helpScreen(helpData(programName(), Application.version(), declaredFlags(), completes = true))
	}

	// Gives the shell's completion the candidates for a value only the
	// program knows: the names of its profiles, of the hosts it has seen.
	// path names what they are for: a flag or an argument by its name
	// (`"profile"`), after the names of its command when only that command's
	// is meant (`"remote add name"`), or a command added with `addCommand`
	// for the words it reads itself. candidates gets the word as far as it
	// is written and returns what it may become; those that do not begin
	// with the word are left out. Call it before `run`, or before the first
	// `@flag` variable is read.
	//
	// Example: Completing a flag's value
	// ```example
	// cli.complete("profile", (word string) => ["dev", "staging", "production"])
	// ```
	def complete(path string, candidates def (string) string[]) {
		completeWith(path, candidates)
	}

	// Whether the command line was checked.
	internal let flagsStarted = false

	// Fills variable from the application's command line.
	internal def bindFlag(variable VariableDescriptor, editor ValueEditor, options FlagOptions) {
		startFlags()
		fill(new Args(applicationWords()), specOf(variable, options), editor) onerror (err error) {
			endWithUsage(err.message)
			recover none
		}
	}

	// Checks the application's command line against every `@flag` variable,
	// once: answers `--help` and `--version`, and ends the program on the
	// first flag that cannot be read.
	internal def startFlags() {
		return when flagsStarted
		flagsStarted = true
		let failure = ""
		let script = scriptAsked(applicationWords(), declaredFlags()) onerror (err error) {
			failure = err.message
			recover ""
		}
		endWithUsage(failure) unless failure == ""
		if script != "" {
			os.stdout.write(script.bytes()) onerror recover 0
			Application.exit(0)
		}
		let asked = checkLine(applicationWords(), declaredFlags()) onerror (err error) {
			failure = err.message
			recover ""
		}
		endWithUsage(failure) unless failure == ""
		return when asked == ""
		let screen = "{programName()} {Application.version()}\n"
		if asked == "help" {
			screen = help() onerror (err error) {
				failure = err.message
				recover ""
			}
			endWithUsage("the help template cannot be rendered: {failure}") unless failure == ""
		}
		os.stdout.write(screen.bytes()) onerror recover 0
		Application.exit(0)
	}

	// What a program without commands writes in place of a run when its
	// command line is the shell's completion asking (`__complete`) or asks
	// for a completion script (`--completion bash`): the candidates or the
	// script; "" when it is neither. A flag named `completion` takes the
	// name over.
	//
	// Fails with a UsageError when `--completion` names no shell a script
	// exists for.
	internal def scriptAsked(words string[], specs FlagSpec[]) !string {
		if words.len() > 0 && words[0] == completeWord {
			let line string[] = []
			line = words[2:].clone() when words.len() > 2
			// A program is never silent here: an empty answer is a line.
			return flagCompletions(words.len() > 1 ?? (words[1], ""), line, specs) + "\n"
		}
		return "" when specs.filter(spec => spec.name == "completion").len() > 0
		// The flags take their words first, so that a value is never taken
		// for the name.
		let args = new Args(words)
		for let (_, spec) in specs {
			fill(args, spec, none) onerror recover none
		}
		return "" unless args.has("completion")
		let shell = try args.value("completion")
		let script = completionScript(shell, programName())
		fail UsageError{message: "--completion takes the shell to write the script for: {completionShells.join(", ")}", code: "BadValue", kind: UsageKind.BadValue, option: "--completion"} when script == ""
		return script
	}

	// The program's `@flag` variables.
	internal def declaredFlags() FlagSpec[] {
		let out FlagSpec[] = []
		for let (_, hit) in reflection.attrs(flag) {
			let spec = specOf(hit)
			out.push(spec) unless spec is none
		}
		return out
	}

	// The application's arguments without the program's path.
	internal def applicationWords() string[] {
		let all = Application.arguments()
		return [] when all.len() == 0
		return all[1:]
	}

	// The name the program was started as.
	internal def programName() string {
		let all = Application.arguments()
		return Application.name() when all.len() == 0 || all[0] == ""
		return os.base(all[0])
	}

	// Ends the program over a command line it cannot use: the message and
	// where help is, on standard error, and exit status 2.
	internal def endWithUsage(message string) {
		let program = programName()
		os.stderr.write("{program}: {message}\nTry '{program} --help'.\n".bytes()) onerror recover 0
		Application.exit(2)
	}
}
