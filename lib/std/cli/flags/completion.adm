// Shell completion: the scripts that make bash, zsh, fish and PowerShell ask
// a program what may come next on its command line, the candidates a
// program's flags give, and the ones a program supplies itself.
internal partial module std.cli.flags {
	// The word a completion script calls the program with, before the shell's
	// name and the words of the line up to the one being written.
	const completeWord = "__complete"

	// The shells a script is written for.
	const completionShells = ["bash", "zsh", "fish", "powershell"]

	// Candidate is one thing the word being written may become.
	struct Candidate {
		text        string
		description string
	}

	// Completer is where a program gives the candidates for one value.
	struct Completer {
		// The command's name, group by group, then the flag's or argument's
		// name; the name alone for any command; a command added by a call
		// alone for the words it reads itself.
		path       string[]
		candidates def (string) string[]
	}

	// The completers a program registered, in the order it did.
	let completers Completer[] = []

	def completeWith(path string, candidates def (string) string[]) {
		let words string[] = []
		for let (_, word) in path.split(" ") {
			words.push(word.trimStart("-")) unless word == ""
		}
		completers.push(Completer{path: words, candidates: candidates})
	}

	// The candidates the program supplies for what is named name under the
	// command at path, for the word being written; none when it registered
	// nothing for it. A completer registered for the name alone answers
	// under every command.
	def supplied(path string[], name string, word string) ?Candidate[] {
		let full = path.clone()
		full.push(name) unless name == ""
		let found ?Completer = none
		for let (_, completer) in completers {
			let exact = completer.path.join(" ") == full.join(" ")
			let bare = name != "" && completer.path.len() == 1 && completer.path[0] == name
			continue unless exact || bare
			// The one that names the command wins over the bare name.
			found = completer when exact || found is none
		}
		return none when found is none
		let out Candidate[] = []
		for let (_, text) in found.candidates(word) {
			out.push(Candidate{text: text})
		}
		return out
	}

	// The script that makes a shell ask program for its completions; "" for
	// a shell that is none of `completionShells`.
	def completionScript(shell string, program string) string {
		let lines string[] = []
		if shell == "bash" {
			lines = [
			"# bash completion for NAME",
			"_FUNC_complete() \{",
			"    local line files=0",
			"    COMPREPLY=()",
			"    while IFS= read -r line; do",
			"        if [[ $line == :files ]]; then",
			"            files=1",
			"        elif [[ -n $line ]]; then",
			"            COMPREPLY+=(\"$line\")",
			"        fi",
			"    done < <(\"$\{COMP_WORDS[0]\}\" __complete bash \"$\{COMP_WORDS[@]:1:COMP_CWORD\}\" 2>/dev/null)",
			"    (( files )) || compopt +o default 2>/dev/null",
			"\}",
			"complete -o default -F _FUNC_complete NAME",
			]
		} else if shell == "zsh" {
			lines = [
			"#compdef NAME",
			"_FUNC() \{",
			"    local -a items",
			"    local line files=0",
			"    while IFS= read -r line; do",
			"        if [[ $line == :files ]]; then",
			"            files=1",
			"        elif [[ -n $line ]]; then",
			"            items+=(\"$line\")",
			"        fi",
			"    done < <(\"$\{words[1]\}\" __complete zsh \"$\{(@)words[2,CURRENT]\}\" 2>/dev/null)",
			"    (( $\{#items\} )) && _describe -t values value items",
			"    (( files )) && _files",
			"    return 0",
			"\}",
			"if [[ $funcstack[1] == _FUNC ]]; then",
			"    _FUNC \"$@\"",
			"else",
			"    compdef _FUNC NAME",
			"fi",
			]
		} else if shell == "fish" {
			lines = [
			"# fish completion for NAME",
			"function __FUNC_complete",
			"    set -l words (commandline -opc) (commandline -ct)",
			"    set -l files 0",
			"    for line in ($words[1] __complete fish $words[2..-1] 2>/dev/null)",
			"        if test \"$line\" = \":files\"",
			"            set files 1",
			"        else if test -n \"$line\"",
			"            echo $line",
			"        end",
			"    end",
			"    if test $files -eq 1",
			"        __fish_complete_path (commandline -ct)",
			"    end",
			"end",
			"complete -c NAME -f -a '(__FUNC_complete)'",
			]
		} else if shell == "powershell" {
			// An empty last word is written `\"\"`: PowerShell before 7.3
			// drops an empty argument to a program, and passes this one as
			// empty, while later ones pass it as written; `completions`
			// reads both as the empty word.
			lines = [
			"# PowerShell completion for NAME",
			"Register-ArgumentCompleter -Native -CommandName 'NAME' -ScriptBlock \{",
			"    param($wordToComplete, $commandAst, $cursorPosition)",
			"    $elements = @($commandAst.CommandElements)",
			"    $words = @()",
			"    for ($i = 1; $i -lt $elements.Count; $i++) \{",
			"        if ($elements[$i].Extent.StartOffset -lt $cursorPosition) \{",
			"            $words += $elements[$i].Extent.Text",
			"        \}",
			"    \}",
			"    if ($wordToComplete -eq '') \{",
			"        $words += '\"\"'",
			"    \}",
			"    $files = $false",
			"    & $elements[0].Extent.Text __complete powershell @words 2>$null | ForEach-Object \{",
			"        if ($_ -eq ':files') \{",
			"            $files = $true",
			"        \} elseif ($_ -ne '') \{",
			"            $text, $about = $_ -split \"`t\", 2",
			"            if (-not $about) \{",
			"                $about = $text",
			"            \}",
			"            [System.Management.Automation.CompletionResult]::new($text, $text, 'ParameterValue', $about)",
			"        \}",
			"    \}",
			"    if ($files) \{",
			"        [System.Management.Automation.CompletionCompleters]::CompleteFilename($wordToComplete)",
			"    \}",
			"\}",
			]
		} else {
			return ""
		}
		// The program's name as a function name may be written.
		let plain = ""
		for let (_, ch) in program {
			plain += string(ch.isLetter() || ch.isDigit() ?? (ch, '_'))
		}
		return lines.join("\n").replace("FUNC", plain).replace("NAME", program) + "\n"
	}

	// Written is the end of a command line as completion sees it.
	struct Written {
		// The words before the one being written, without the name and `=`
		// of a flag whose value it is.
		before  string[]
		// The word being written; the value alone after `--name=`.
		current string
		// The flag whose value is being written after `=`, as written; ""
		// for none.
		glued   string
		// What a candidate starts with so that it replaces the whole word.
		lead    string
	}

	// Takes the words a completion script hands over apart: the one being
	// written is the last. bash hands `--name=value` over as three words
	// and wants the value alone back; the other shells want the whole word.
	def writtenOf(shell string, words string[]) Written {
		let out = Written{before: words.clone()}
		if out.before.len() > 0 {
			out.current = out.before[out.before.len() - 1]
			out.before.remove(out.before.len() - 1)
		}
		out.current = "" when shell == "powershell" && out.current == "\"\""
		if out.current == "=" && out.before.len() > 0 {
			out.glued = out.before[out.before.len() - 1]
			out.current = ""
			out.before.remove(out.before.len() - 1)
		} else if out.before.len() > 1 && out.before[out.before.len() - 1] == "=" {
			out.glued = out.before[out.before.len() - 2]
			out.before.remove(out.before.len() - 1)
			out.before.remove(out.before.len() - 1)
		} else if out.current.startsWith("--") && out.current.contains("=") {
			let cut = out.current.indexOf("=")
			out.glued = out.current[0:cut]
			out.lead = out.glued + "="
			out.current = out.current[cut + 1:]
		}
		return out
	}

	// The flag whose value the word being written is: the one before `=`,
	// or the one the word before names when it takes a value; none when the
	// word is no flag's value.
	def flagAwaited(line Written, scope FlagSpec[]) ?FlagSpec {
		return flagWritten(scope, line.glued, false) unless line.glued == ""
		return none when line.before.len() == 0 || line.before.includes("--")
		return flagWritten(scope, line.before[line.before.len() - 1], true)
	}

	// The flags of scope that may still be written, as candidates: a flag
	// already given is left out unless it repeats.
	def flagCandidates(scope FlagSpec[], before string[]) Candidate[] {
		let found Candidate[] = []
		for let (_, spec) in scope {
			continue when spec.hidden || spec.problem != ""
			let repeats = spec.shape := FlagShape.List || FlagShape.Map || FlagShape.Count
			continue when !repeats && before.includes(spelled(spec.name))
			let name = spelled(spec.name)
			name = "--no-" + spec.name when isNegated(spec)
			found.push(Candidate{text: name, description: spec.description})
		}
		found.push(Candidate{text: "--help", description: "Show this help"})
		found.sort((a, b) => a.text.compare(b.text))
		return found
	}

	// The candidates that begin with the word being written, as the shell
	// wants them listed: a candidate a line (for zsh `name:description`, for
	// fish and PowerShell the two with a tab between, for bash the name
	// alone), then `:files` when file names fit too.
	def listed(found Candidate[], line Written, shell string, files bool) string {
		let lines string[] = []
		for let (_, candidate) in found {
			continue unless candidate.text.startsWith(line.current)
			let text = line.lead + candidate.text
			if shell == "zsh" {
				text = text.replace(":", "\\:")
				text += ":" + candidate.description unless candidate.description == ""
			} else if shell := "fish" || "powershell" {
				text += "\t" + candidate.description unless candidate.description == ""
			}
			lines.push(text)
		}
		lines.push(":files") when files
		return lines.len() == 0 ?? ("", lines.join("\n") + "\n")
	}

	// What the last of words may become in a program that has flags and no
	// commands, listed as `listed` does: a flag when the word starts with a
	// dash, the values of the flag it follows, and file names wherever the
	// program reads the word itself.
	def flagCompletions(shell string, words string[], specs FlagSpec[]) string {
		let line = writtenOf(shell, words)
		let scope = specs.clone()
		scope.push(completionFlag()) unless specs.filter(spec => spec.name == "completion").len() > 0
		let wanted = flagAwaited(line, scope)
		if !(wanted is none) {
			let given = supplied([], wanted.name, line.current)
			return listed(given, line, shell, false) unless given is none
			return listed(valuesOf(wanted), line, shell, wanted.kind := "file" || "string")
		}
		return listed(flagCandidates(scope, line.before), line, shell, false) when line.current.startsWith("-") && !line.before.includes("--")
		return listed([], line, shell, true)
	}

	// The flag a program without commands writes its completion script
	// for: `--completion bash`.
	def completionFlag() FlagSpec {
		return FlagSpec{name: "completion", description: "Write the completion script for a shell", shape: FlagShape.Value, kind: "shell", placeholder: "<{completionShells.join("|")}>"}
	}

	// The flag of specs a word names when it is written alone (`--port`,
	// `-p`, the last letter of a bundle); none when the word is no flag of
	// them or, with valued, one that takes no value.
	def flagWritten(specs FlagSpec[], word string, valued bool) ?FlagSpec {
		return none unless word.len() > 1 && word.startsWith("-") && !word.contains("=")
		let long = word.startsWith("--")
		let name = long ?? (word[2:], word[word.len() - 1:])
		for let (_, spec) in specs {
			let matches = long ?? (spec.name == name && name.len() > 1, spec.short == name || spec.name == name && name.len() == 1)
			continue unless matches
			return none when valued && (spec.shape := FlagShape.Switch || FlagShape.Count)
			return spec
		}
		return none
	}

	// The values a flag or argument can only have: an enum's members, the
	// two a switch is written with after `=`, the shells a script exists
	// for.
	def valuesOf(spec FlagSpec) Candidate[] {
		let out Candidate[] = []
		if spec.kind == "enum" {
			for let (_, member) in spec.choices {
				out.push(Candidate{text: kebabCase(member.node.name), description: firstLine(member.node.doc)})
			}
		} else if spec.kind == "bool" {
			out.push(Candidate{text: "true"}, Candidate{text: "false"})
		} else if spec.kind == "shell" {
			for let (_, shell) in completionShells {
				out.push(Candidate{text: shell})
			}
		}
		return out
	}
}
