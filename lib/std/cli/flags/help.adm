// The help screen: the flags of a program as rows, and the built-in layout
// of them. A template (`template.adm`) and Markdown descriptions take its
// place through the two hooks here, so a program that asks for neither
// carries neither.
internal partial module std.cli.flags {
	use std.cli.terminal

	// HelpRow is one flag as help lists it.
	struct HelpRow {
		// The names and the value's stand-in: `-p, --port <int>`.
		usage        string
		// The heading the flag is listed under; "" for the general one.
		group        string
		name         string
		short        string
		placeholder  string
		description  string
		// The declared value; "" when there is none to show.
		defaultValue string
		env          string
		required     bool
		// What follows the description in parentheses: `required`, or the
		// default, and the environment variable.
		notes        string
		// Whether the flag may be given several times.
		repeats      bool
	}

	// HelpGroup is the flags listed under one heading.
	struct HelpGroup {
		name string
		rows HelpRow[]
	}

	// HelpData is everything a help screen shows.
	struct HelpData {
		program     string
		version     string
		// What follows `Usage:`: the program, the command path, and what
		// they take.
		usage       string
		// What the program or command does; "" when nothing says.
		description string
		// The positional arguments of the command shown, each with `usage`
		// (its name) and `description`.
		arguments   HelpRow[]
		// The commands under the one shown, each with `usage` (its name
		// and aliases) and `description`.
		commands    HelpRow[]
		// Every row, in name order, `--help` and `--version` last.
		rows        HelpRow[]
		// The same rows by heading: `Options` first, then the groups in
		// name order.
		groups      HelpGroup[]
		// The length of the longest `usage`.
		width       int
	}

	// What draws the help screen in place of the built-in layout; none
	// until a program gives a template.
	let helpDrawer ?def (HelpData) !string = none

	// What turns a description into the text shown; none shows it as
	// written.
	let helpDescriber ?def (string) string = none

	def drawHelpWith(drawer ?def (HelpData) !string) {
		helpDrawer = drawer
	}

	def describeHelpWith(describer ?def (string) string) {
		helpDescriber = describer
	}

	// The rows of a help screen for a program called program: the flags of
	// specs that are not hidden, in name order, then `--help` and
	// `--version` unless a flag took those names. With completes,
	// `--completion` is listed among them, as a program without commands
	// answers it.
	def helpData(program string, version string, specs FlagSpec[], completes bool = false) HelpData {
		let shown = specs.filter(spec => !spec.hidden && spec.problem == "")
		shown.push(completionFlag()) when completes && specs.filter(spec => spec.name == "completion").len() == 0
		shown.sort((a, b) => sortName(a).compare(sortName(b)))
		let help = FlagSpec{name: "help", short: "h", description: "Show this help", shape: FlagShape.Switch}
		let about = FlagSpec{name: "version", description: "Show the version", shape: FlagShape.Switch}
		for let (_, spec) in specs {
			help.short = "" when spec.name == "h" || spec.short == "h"
			help.name = "" when spec.name == "help"
			about.name = "" when spec.name == "version"
		}
		help.name = help.short when help.name == ""
		shown.push(help) unless help.name == ""
		shown.push(about) unless about.name == ""
		let data = HelpData{program: program, version: version, usage: "{program} [options] [arguments]", arguments: [], commands: [], rows: [], groups: []}
		data.groups.push(HelpGroup{name: "Options", rows: []})
		let headings string[] = []
		for let (_, spec) in shown {
			headings.push(spec.group) unless spec.group == "" || headings.includes(spec.group)
		}
		headings.sort((a, b) => a.lower().compare(b.lower()))
		for let (_, name) in headings {
			data.groups.push(HelpGroup{name: name, rows: []})
		}
		let describe = helpDescriber
		for let (_, spec) in shown {
			let negated = isNegated(spec)
			let notes string[] = []
			notes.push("required") when spec.required
			notes.push("default " + spec.defaultValue) unless spec.defaultValue == "" || negated || spec.required || spec.shape == FlagShape.Count && spec.defaultValue == "0"
			notes.push("env " + spec.env) unless spec.env == ""
			let row = HelpRow{
				usage:        usageOf(spec),
				group:        spec.group,
				name:         spec.name.len() == 1 ?? ("", spec.name),
				short:        spec.name.len() == 1 ?? (spec.name, spec.short),
				placeholder:  spec.placeholder,
				description:  describe is none ?? (spec.description, describe(spec.description)),
				defaultValue: negated ?? ("", spec.defaultValue),
				env:          spec.env,
				required:     spec.required,
				notes:        notes.join(", "),
				repeats:      spec.shape := FlagShape.List || FlagShape.Map || FlagShape.Count,
			}
			data.width = row.usage.len() when row.usage.len() > data.width
			data.rows.push(row)
			for let (_, group) in data.groups {
				group.rows.push(row) when group.name == (spec.group == "" ?? ("Options", spec.group))
			}
		}
		data.groups = data.groups.filter(group => group.rows.len() > 0)
		return data
	}

	// The help screen for data: what the program's template draws, or the
	// built-in layout.
	//
	// Fails when the template cannot be rendered.
	def helpScreen(data HelpData) !string {
		let draw = helpDrawer
		return plainHelp(data) when draw is none
		return draw(data)
	}

	// The built-in layout: a usage line, then each heading with its flags,
	// usage in one column, description and notes after it.
	def plainHelp(data HelpData) string {
		let lines = ["{terminal.heading("Usage:")} {data.usage}"]
		lines.push("", data.description) unless data.description == ""
		if data.arguments.len() > 0 {
			lines.push("", terminal.heading("Arguments:"))
			for let (_, row) in data.arguments {
				lines.push(helpLine(row, data.width))
			}
		}
		if data.commands.len() > 0 {
			lines.push("", terminal.heading("Commands:"))
			for let (_, row) in data.commands {
				lines.push(helpLine(row, data.width))
			}
		}
		for let (_, group) in data.groups {
			lines.push("", terminal.heading(group.name + ":"))
			for let (_, row) in group.rows {
				lines.push(helpLine(row, data.width))
			}
		}
		return lines.join("\n") + "\n"
	}

	// One row: its usage in a column of the width, then its description
	// and notes.
	def helpLine(row HelpRow, width int) string {
		return "  " + row.usage when row.description == "" && row.notes == ""
		let between = row.description != "" && row.notes != "" ?? (" ", "")
		let notes = row.notes == "" ?? ("", terminal.dim("(" + row.notes + ")"))
		return "  {row.usage.padEnd(width)}  {row.description}{between}{notes}"
	}

	// A flag as the options list writes it, the long names in one column:
	// `-p, --port <int>`, `    --include <text>...`. A switch that is on
	// unless turned off is written as what turns it off, `--no-color`.
	def usageOf(spec FlagSpec) string {
		let names = spelling(spec)
		names = names.replace("--", "--no-") when isNegated(spec)
		names = "    " + names when names.startsWith("--")
		let value = spec.placeholder == "" ?? ("", " " + spec.placeholder)
		let repeats = spec.shape := FlagShape.List || FlagShape.Map || FlagShape.Count
		return names + value + (repeats ?? ("...", ""))
	}

	// Whether a switch is declared on and has a long name to turn it off by.
	def isNegated(spec FlagSpec) bool {
		return spec.shape == FlagShape.Switch && spec.defaultValue == "true" && spec.name.len() > 1
	}

	def sortName(spec FlagSpec) string {
		return spec.name.lower()
	}
}
