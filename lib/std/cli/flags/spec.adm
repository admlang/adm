// What `@flag` variables are and how they are read: the description of a
// flag worked out from its variable, the text-to-value reading for each type
// a flag fills, and the closest-name search behind "did you mean".
internal partial module std.cli.flags {
	use (
		std.cli::(Args, UsageError, UsageKind)
		std.cli.prompts
		std.cli.terminal
		std.os
		std.reflection
		std.data.semver
		std.net.url
		std.reflection::(AttrHit, EnumMember, TypeDescriptor, TypeKind, ValueEditor, VariableDescriptor)
		std.services.runtime::(Runtime)
		std.strings
		std.time
	)

	// FlagShape is what a flag takes on the command line.
	enum FlagShape {
		// Nothing: `--verbose`, `--verbose=false`.
		Switch,
		// One value; the last one given wins.
		Value,
		// A value per occurrence, collected in order.
		List,
		// A `key=value` per occurrence.
		Map,
		// Nothing, counted: `-vvv` is 3.
		Count,
	}

	// FlagOptions are the arguments of a `@flag` annotation.
	struct FlagOptions {
		name        string
		short       string
		description string
		hidden      bool
		env         string
		required    bool
		count       bool
		mode        string
		placeholder string
		group       string
		excludes    string
		requires    string
	}

	// FlagSpec describes one flag.
	struct FlagSpec {
		// The name as `Args` takes it: the long name, or one letter for a
		// flag with no long form.
		name         string
		// The one-letter form beside the name; "" when there is none.
		short        string
		// The one-line text help shows.
		description  string
		hidden       bool
		// The environment variable read when the flag is not given; ""
		// when there is none.
		env          string
		// Whether the program cannot run without the flag or its
		// environment variable.
		required     bool
		// How a file is opened: `r`, `w`, `a`, with `+` for both ways.
		mode         string
		// The heading help lists the flag under; "" for the general one.
		group        string
		// The names of the flags this one cannot be given with.
		excludes     string[]
		// The names of the flags that must be given when this one is.
		requires     string[]
		shape        FlagShape
		// What one value is read as: `kindOf` of the variable's type, of an
		// array's elements or of a map's values.
		kind         string
		// The type of a list's elements or of a map's values; none for the
		// other shapes.
		element      ?TypeDescriptor
		// The enum's members when kind is "enum".
		choices      EnumMember[]
		// The value's stand-in in help: `<int>`, `<file>`, `<dev|prod>`.
		placeholder  string
		// The value the variable is declared with, as help shows it; ""
		// when there is nothing worth showing.
		defaultValue string
		// Why the variable cannot be a flag; "" when it can.
		problem      string
	}

	// Describes the flag a variable declares with an annotation's options.
	def specOf(variable VariableDescriptor, options FlagOptions) FlagSpec {
		return specFor(variable.node.name, variable.typeDescriptor, variable.node.doc, variable.defaultLiteral, options)
	}

	// Describes the flag a declaration makes: its name, declared type, doc
	// comment and initializer or default as written, with an annotation's
	// options.
	def specFor(name string, declared TypeDescriptor, doc string, defaultLiteral string, options FlagOptions) FlagSpec {
		let spec = FlagSpec{name: options.name == "" ?? (kebabCase(name), options.name), short: options.short, hidden: options.hidden, shape: FlagShape.Value}
		spec.description = options.description == "" ?? (firstLine(doc), options.description)
		spec.env = options.env
		spec.required = options.required
		spec.mode = options.mode == "" ?? ("r", options.mode)
		let value = declared
		if declared.kind == TypeKind.Array || declared.kind == TypeKind.Map {
			spec.shape = declared.kind == TypeKind.Array ?? (FlagShape.List, FlagShape.Map)
			let element = declared.element
			if element is none {
				spec.problem = "a variable of type {declared.typeName} cannot be a flag"
				return spec
			}
			value = element
			spec.element = element
		}
		spec.kind = kindOf(value)
		spec.shape = FlagShape.Switch when spec.kind == "bool" && spec.shape == FlagShape.Value
		spec.problem = "only a whole number counts how often a flag is given" when options.count && !(spec.shape == FlagShape.Value && isWholeKind(spec.kind))
		spec.shape = FlagShape.Count when options.count && spec.problem == ""
		spec.choices = reflection.members(value) when spec.kind == "enum"
		spec.placeholder = placeholderOf(spec)
		spec.placeholder = "<" + options.placeholder.trimPrefix("<").trimSuffix(">") + ">" unless options.placeholder == "" || spec.placeholder == ""
		spec.group = options.group
		spec.excludes = flagNames(options.excludes)
		spec.requires = flagNames(options.requires)
		spec.defaultValue = shownDefault(defaultLiteral, spec)
		spec.problem = problemOf(spec, declared) when spec.problem == ""
		return spec
	}

	// The flag names a comma-separated argument lists, without their dashes.
	def flagNames(list string) string[] {
		let out string[] = []
		for let (_, name) in list.split(",") {
			out.push(name.trim().trimStart("-")) unless name.trim() == ""
		}
		return out
	}

	// Describes the flag behind one `@flag` occurrence. skip is how many
	// positional arguments the annotation takes before `name`.
	def specOf(hit AttrHit, skip int = 0) ?FlagSpec {
		let variable = reflection.asVariable(hit.node)
		return none when variable is none
		return specOf(variable, optionsOf(hit.attr.arguments, skip))
	}

	// The options an annotation's arguments give, by name or by position.
	def optionsOf(given map<string, any>, skip int = 0) FlagOptions {
		return FlagOptions{
			name:        text(argument(given, "name", skip)),
			short:       text(argument(given, "short", skip + 1)),
			description: text(argument(given, "description", skip + 2)),
			hidden:      text(argument(given, "hidden", skip + 3)) == "true",
			env:         text(argument(given, "env", skip + 4)),
			required:    text(argument(given, "required", skip + 5)) == "true",
			count:       text(argument(given, "count", skip + 6)) == "true",
			mode:        text(argument(given, "mode", skip + 7)),
			placeholder: text(argument(given, "placeholder", skip + 8)),
			group:       text(argument(given, "group", skip + 9)),
			excludes:    text(argument(given, "excludes", skip + 10)),
			requires:    text(argument(given, "requires", skip + 11)),
		}
	}

	// An annotation argument, given by name or at a position.
	def argument(given map<string, any>, name string, position int) ?any {
		return given.get(name) when given.hasKey(name)
		let key = "#{position}"
		return given.get(key) when given.hasKey(key)
		return none
	}

	def text(value ?any) string {
		return "" when value is none
		return reflection.scalarText(value)
	}

	// The name a type has among the kinds a flag reads; "" for a type no
	// flag fills.
	def kindOf(declared TypeDescriptor) string {
		return "enum" when declared.kind == TypeKind.Enum
		// The prelude's types are named with their module: `builtin.string`.
		let name = declared.typeName.replace("builtin.", "")
		return "file" when name == "std.os.File"
		return "time" when name == "std.time.Time"
		return "url" when name == "std.net.url.URL"
		return "semver" when name == "std.data.semver.Semver"
		return "uint8" when name == "byte"
		return name when name := "bool" || "string" || "duration" || "float" || "float32" || "float64"
		return name when name := "int" || "int8" || "int16" || "int32" || "int64" || "uint" || "uint8" || "uint16" || "uint32" || "uint64"
		return ""
	}

	def isWholeKind(kind string) bool {
		return kind.startsWith("int") || kind.startsWith("uint")
	}

	def problemOf(spec FlagSpec, declared TypeDescriptor) string {
		let refused = "a variable of type {declared.typeName} cannot be a flag"
		return "the short form '{spec.short}' is not one letter" unless spec.short.len() <= 1 && spec.short != "-"
		return refused when spec.kind == ""
		return "mode '{spec.mode}' is not one of r, w, a, r+, w+, a+" unless spec.mode := "r" || "w" || "a" || "r+" || "w+" || "a+"
		return "mode is for a file flag" when spec.mode != "r" && spec.kind != "file"
		return "a file flag is declared ?os.File, since it holds no file until one is given" when spec.kind == "file" && spec.shape == FlagShape.Value && !declared.optional
		return refused when spec.kind == "file" && spec.shape == FlagShape.Map
		return refused when spec.shape == FlagShape.List && spec.kind == "bool"
		if spec.shape == FlagShape.Map {
			let key = declared.key
			return refused when key is none
			return refused unless kindOf(key) == "string"
		}
		return ""
	}

	def placeholderOf(spec FlagSpec) string {
		return "<key=value>" when spec.shape == FlagShape.Map
		return "" when spec.shape := FlagShape.Switch || FlagShape.Count
		return "<text>" when spec.kind == "string"
		return "<number>" when spec.kind.startsWith("float")
		return "<{spec.kind}>" when spec.kind := "duration" || "file" || "time" || "url"
		return "<version>" when spec.kind == "semver"
		return "<int>" unless spec.kind == "enum"
		let names string[] = []
		for let (_, member) in spec.choices {
			names.push(kebabCase(member.node.name))
		}
		return "<{names.join("|")}>"
	}

	// The declared value as help shows it: literal is the initializer as
	// written. Values that say nothing (an off switch, an empty list, zero
	// text) and initializers that are not plain values are left out.
	def shownDefault(literal string, spec FlagSpec) string {
		let written = literal.trim()
		return "" when written := "" || "false" || "none" || "[]" || "\"\""
		return "" unless spec.shape := FlagShape.Value || FlagShape.Switch || FlagShape.Count
		return written[1:written.len() - 1] when isPlainText(written)
		if spec.kind == "enum" {
			return "" unless /^[A-Za-z_][A-Za-z0-9_.]*$/.test(written)
			let dot = written.split(".")
			return kebabCase(dot[dot.len() - 1])
		}
		return written when /^[+-]?[0-9][0-9a-zA-Zµ._]*$/.test(written) || written == "true"
		return ""
	}

	// A default worked out when the program runs, as help shows it: text,
	// a number, `true`, an enum member in kebab case; "" for a value that
	// says nothing or that help has no short form for.
	def shownValue(spec FlagSpec, value ?any) string {
		return "" when value is none
		return "" unless spec.shape := FlagShape.Value || FlagShape.Switch || FlagShape.Count
		let written = reflection.scalarText(value)
		if spec.kind == "enum" {
			for let (_, member) in spec.choices {
				return kebabCase(member.node.name) when reflection.scalarText(member.value) == written
			}
			return ""
		}
		return "" when spec.kind == "duration" || written == "false" || written == "0" && spec.kind != "string"
		return written when (spec.kind := "string" || "bool") || isWholeKind(spec.kind) || spec.kind.startsWith("float")
		return ""
	}

	// Whether source text is one string literal that stands for itself:
	// in quotes, with no interpolation, escape or second literal in it.
	def isPlainText(written string) bool {
		return false unless written.len() > 1 && written.startsWith("\"") && written.endsWith("\"")
		let inside = written[1:written.len() - 1]
		return !inside.contains("\"") && !inside.contains("\{") && !inside.contains("\\")
	}

	// The names a flag is written with: `-p, --port`.
	def spelling(spec FlagSpec) string {
		return "-{spec.name}" when spec.name.len() == 1
		return "--{spec.name}" when spec.short == ""
		return "-{spec.short}, --{spec.name}"
	}

	// Reads the flag from args, which loses the words that belong to it, and
	// stores the value through editor. A flag that is not given is read
	// from its environment variable, when it has one that is set: a list or
	// a map from the values between its commas. Without an editor the value
	// is only checked, and a file is not opened.
	//
	// Fails with a UsageError when a value is missing or does not fit the
	// variable's type, when a required flag is given neither way, or when
	// the variable cannot be a flag.
	def fill(args Args, spec FlagSpec, editor ?ValueEditor) !none {
		let value = try resolve(args, spec, !(editor is none))
		return none when value is none
		editor.set(value) unless editor is none
		return none
	}

	// Reads the flag from args, which loses the words that belong to it, and
	// returns its value boxed as the type it is declared with; none when
	// the flag is given nowhere and need not be. open says whether a file is
	// opened or only named.
	//
	// Fails as `fill` does.
	def resolve(args Args, spec FlagSpec, open bool) !?any {
		let option = spec.name.len() == 1 ?? ("-" + spec.name, "--" + spec.name)
		fail invalid(option, spec.problem) unless spec.problem == ""
		let given string[] = []
		if spec.shape == FlagShape.Switch {
			let written = args.has(spec.name, spec.short) || spec.name.len() > 1 && args.has("no-" + spec.name)
			given.push((try args.flag(spec.name, spec.short)) ?? ("true", "false")) when written
		} else if spec.shape == FlagShape.Count {
			let times = try args.count(spec.name, spec.short)
			given.push("{times}") when times > 0
		} else {
			given = try args.values(spec.name, spec.short)
		}
		if given.len() == 0 && spec.env != "" {
			let held = Runtime.getEnv(spec.env)
			if !(held is none) && held != "" {
				// What is wrong with the variable is reported under its name.
				option = spec.env
				let repeats = spec.shape := FlagShape.List || FlagShape.Map
				given = repeats ?? (held.split(","), [held])
			}
		}
		if given.len() == 0 && answers.hasKey(spec.name) {
			let repeats = spec.shape := FlagShape.List || FlagShape.Map
			given = repeats ?? (answers[spec.name].split(","), [answers[spec.name]])
		}
		if given.len() == 0 {
			return none unless spec.required
			let other = spec.env == "" ?? ("", ", on the command line or as {spec.env} in the environment")
			fail UsageError{message: "{option} is required{other}", code: "Required", kind: UsageKind.Required, option: option}
		}
		let value any = ""
		if spec.shape == FlagShape.Map {
			value = try readMap(spec, given, option)
		} else if spec.shape == FlagShape.List {
			value = try readList(spec, given, option, open)
		} else {
			value = try read(spec, given[given.len() - 1], option, open)
		}
		return value
	}

	// The value a default written in source stands for, boxed as the flag's
	// type: a number, a duration, `true` or `false`, a string without
	// interpolation, an enum member, `none`, an empty list. None for `none`
	// and for no default at all. What a command falls back on for a
	// default reflection cannot compute.
	//
	// Fails when the text is any other expression.
	def literalValue(spec FlagSpec, literal string, option string) !?any {
		let written = literal.trim()
		return none when written := "" || "none"
		if spec.shape == FlagShape.List {
			let element = spec.element
			fail invalid(option, "the default `{written}` is not an empty list") unless written.endsWith("[]") && !(element is none)
			let nothing any[] = []
			return reflection.arrayOf(element, nothing)
		}
		fail invalid(option, "a default cannot be given for this type") when spec.shape == FlagShape.Map
		if isPlainText(written) {
			return try read(spec, written[1:written.len() - 1], option, true)
		}
		if spec.kind == "enum" && /^[A-Za-z_][A-Za-z0-9_.]*$/.test(written) {
			let parts = written.split(".")
			return try readChoice(spec.choices, kebabCase(parts[parts.len() - 1]), option)
		}
		fail invalid(option, "the default `{written}` cannot be worked out before the command is called") unless (written := "true" || "false") || /^[+-]?[0-9][0-9a-zA-Zµ._]*$/.test(written)
		return try read(spec, written, option, true)
	}

	// One value of the flag's kind, boxed as exactly the type the variable
	// holds. open says whether a file is opened or only named.
	def read(spec FlagSpec, text string, option string, open bool) !any {
		let kind = spec.kind
		return text when kind == "string"
		if kind == "bool" {
			let word = text.lower()
			return true when word := "true" || "1" || "yes" || "on"
			return false when word := "false" || "0" || "no" || "off"
			fail invalid(option, "'{text}' is not true or false")
		}
		return try readDuration(text, option) when kind == "duration"
		return try readChoice(spec.choices, text, option) when kind == "enum"
		if kind == "file" {
			return "" unless open
			let reads = spec.mode.startsWith("r")
			return reads ?? (os.stdin, os.stdout) when text == "-"
			let failure = ""
			let path = os.resolve(text) onerror (err error) {
				failure = err.message
				recover text
			}
			fail invalid(option, failure) unless failure == ""
			let file = os.open(path, spec.mode) onerror (err error) {
				failure = err.message
				recover os.stdin
			}
			fail invalid(option, "cannot open '{path}': {failure}") unless failure == ""
			return file
		}
		if kind := "time" || "url" || "semver" {
			return try readParsed(kind, text, option)
		}
		if kind.startsWith("float") {
			fail invalid(option, "'{text}' is not a number") unless isNumber(text)
			return float32(parseFloat<float>(text)) when kind == "float32"
			return parseFloat<float>(text)
		}
		return try readWhole(kind, text, option)
	}

	// A whole number as the integer type named kind.
	def readWhole(kind string, text string, option string) !any {
		fail invalid(option, "'{text}' is not a whole number") unless isWholeNumber(text)
		let negative = text.startsWith("-")
		let digits = text.trimPrefix("-").trimPrefix("+").trimStart("0")
		let unsigned = kind.startsWith("uint")
		let bits = (kind := "int" || "uint") ?? (64, parseInt<int>(kind.trimPrefix("uint").trimPrefix("int")))
		let top = "9223372036854775807"
		top = "18446744073709551615" when unsigned
		let fits = !(unsigned && negative && digits != "") && (digits.len() < top.len() || digits.len() == top.len() && digits.compare(top) <= 0)
		if fits && unsigned {
			let wide = parseInt<uint64>(digits)
			fits = bits == 64 || wide < uint64(1) << uint64(bits)
			if fits {
				return uint8(wide) when bits == 8
				return uint16(wide) when bits == 16
				return uint32(wide) when bits == 32
				return uint(wide) when kind == "uint"
				return wide
			}
		}
		if fits && !unsigned {
			let wide = parseInt<int64>(text)
			let limit = int64(1) << int64(bits - 1)
			fits = bits == 64 || wide >= -limit && wide < limit
			if fits {
				return int8(wide) when bits == 8
				return int16(wide) when bits == 16
				return int32(wide) when bits == 32
				return int(wide) when kind == "int"
				return wide
			}
		}
		fail invalid(option, "{text} does not fit {kind == "uint8" ?? ("a byte", "an " + kind)}") when kind.startsWith("i") || kind == "uint8"
		fail invalid(option, "{text} does not fit a {kind}")
	}

	def readDuration(text string, option string) !duration {
		let failed = false
		let span = time.parseDuration(text) onerror (err error) {
			failed = true
			recover 0s
		}
		fail invalid(option, "'{text}' is not a duration, such as 30s, 5m or 1h30m") when failed
		return span
	}

	// A value of a type that reads its own text: a time, a URL, a version.
	def readParsed(kind string, text string, option string) !any {
		let failure = ""
		if kind == "time" {
			let moment = time.parse(text) onerror (err error) {
				failure = "'{text}' is not a date or time, such as 2026-09-03 or 2026-09-03T14:05:09Z"
				recover time.now()
			}
			if failure != "" {
				// A date alone is the start of that day.
				let unread = failure
				failure = ""
				moment = time.parse(text, time.TimeFormat.DateOnly) onerror (err error) {
					failure = unread
					recover time.now()
				}
			}
			fail invalid(option, failure) unless failure == ""
			return moment
		}
		if kind == "url" {
			let address = url.parse(text) onerror (err error) {
				failure = "'{text}' is not a URL: {err.message}"
				recover new url.URL()
			}
			fail invalid(option, failure) unless failure == ""
			return address
		}
		let version = semver.parse(text) onerror (err error) {
			failure = "'{text}' is not a version, such as 1.4.0"
			recover new semver.Semver()
		}
		fail invalid(option, failure) unless failure == ""
		return version
	}

	// The member text names: its name in any case, or in kebab case.
	def readChoice(choices EnumMember[], text string, option string) !any {
		let wanted = text.lower()
		let names string[] = []
		for let (_, member) in choices {
			let name = kebabCase(member.node.name)
			return member.value when wanted == name || wanted == member.node.name.lower()
			names.push(name)
		}
		let near = closest(wanted, names)
		let hint = near == "" ?? ("", "; did you mean {near}?")
		fail invalid(option, "'{text}' is not one of {names.join(", ")}{hint}")
	}

	def readList(spec FlagSpec, given string[], option string, open bool) !any {
		let values any[] = []
		for let (_, text) in given {
			values.push(try read(spec, text, option, open))
		}
		// Checked only: a file's stand-in is no element.
		return given unless open
		let element = spec.element
		fail invalid(option, "a variable of this type cannot be a flag") when element is none
		let made = reflection.arrayOf(element, values)
		fail invalid(option, "a list of {element.typeName} cannot be a flag") when made is none
		return made
	}

	// A map from the `key=value` texts given, its values read as the
	// flag's kind; a key given twice keeps its last value.
	def readMap(spec FlagSpec, given string[], option string) !any {
		let keys string[] = []
		let values any[] = []
		for let (_, text) in given {
			let cut = text.indexOf("=")
			fail invalid(option, "'{text}' is not written key=value") unless cut > 0
			keys.push(text[0:cut])
			values.push(try read(spec, text[cut + 1:], option, true))
		}
		let element = spec.element
		fail invalid(option, "a variable of this type cannot be a flag") when element is none
		let made = reflection.mapOf(element, keys, values)
		fail invalid(option, "a map of {element.typeName} cannot be a flag") when made is none
		return made
	}

	// Reads every flag of specs from words without storing anything, and
	// returns what was asked for instead of a run: "help" for `--help` or
	// `-h`, "version" for `--version`, "" for neither. A flag of one of
	// those names takes the name over.
	//
	// Fails with the UsageError of a flag whose words cannot be read,
	// unless help or the version was asked for.
	def checkLine(words string[], specs FlagSpec[]) !string {
		let args = new Args(words)
		let failure ?error = none
		let long = "help"
		let short = "h"
		let version = "version"
		let asked FlagSpec[] = []
		let given string[] = []
		// In name order, so the flag reported when several are wrong is
		// always the same one.
		let ordered = specs.clone()
		ordered.sort((a, b) => a.name.compare(b.name))
		for let (_, spec) in ordered {
			long = "" when spec.name == "help"
			version = "" when spec.name == "version"
			short = "" when spec.name == "h" || spec.short == "h"
			let held = spec.env == "" ?? ("", envText(spec.env))
			given.push(spec.name) when args.has(spec.name, spec.short) || held != ""
			fill(args, spec, none) onerror (err error) {
				let wanting = false
				wanting = err.kind == UsageKind.Required when err is UsageError
				if wanting && canAsk() {
					asked.push(spec)
				} else {
					failure = err when failure is none
				}
				recover none
			}
		}
		return "help" when long != "" && args.has(long) || short != "" && args.has(short)
		return "version" when version != "" && args.has(version)
		fail failure unless failure is none
		for let (_, spec) in ordered {
			continue unless given.includes(spec.name)
			for let (_, other) in spec.excludes {
				continue unless given.includes(other)
				let (first, second) = (spelled(spec.name), spelled(other))
				fail UsageError{message: "{first} cannot be used with {second}", code: "Conflict", kind: UsageKind.Conflict, option: first}
			}
			for let (_, other) in spec.requires {
				continue when given.includes(other)
				let (first, second) = (spelled(spec.name), spelled(other))
				fail UsageError{message: "{first} needs {second}", code: "Required", kind: UsageKind.Required, option: second}
			}
		}
		asked.sort((a, b) => a.name.compare(b.name))
		for let (_, spec) in asked {
			answers.set(spec.name, try askFor(spec))
		}
		return ""
	}

	// What the person typed for required flags left off the command line,
	// by flag name: `fill` reads them where the command line has nothing.
	let answers = new map<string, string>()

	// What an environment variable holds; "" when it is not set.
	def envText(name string) string {
		let held = Runtime.getEnv(name)
		return held is none ?? ("", held)
	}

	// Whether a flag left out can be asked for: the program sits at a
	// terminal on both sides.
	def canAsk() bool {
		return terminal.isTTY(os.stdin) && terminal.isTTY(os.stdout)
	}

	// Asks for the value of a flag: yes or no for a switch, a choice for an
	// enum, any number of them for a list of an enum, a line that must read
	// as the flag's type for the rest (a list's or a map's values between
	// commas). The answer is the text the flag would have been given.
	//
	// Fails with `prompts.Cancelled` when the person leaves the question.
	def askFor(spec FlagSpec) !string {
		let label = spec.description == "" ?? (spelled(spec.name), spec.description.trimSuffix("."))
		if spec.shape == FlagShape.Switch {
			let yes = try prompts.confirm(label)
			return yes ?? ("true", "false")
		}
		if spec.kind == "enum" && (spec.shape := FlagShape.Value || FlagShape.List) {
			let names string[] = []
			for let (_, member) in spec.choices {
				names.push(kebabCase(member.node.name))
			}
			return prompts.choose(label, names) when spec.shape == FlagShape.Value
			for {
				let picked = try prompts.chooseMany(label, names)
				return picked.join(",") when picked.len() > 0
			}
		}
		return prompts.ask(label, "", (text string) => unreadable(spec, text))
	}

	// What is wrong with text as the value of a flag; "" when it reads.
	def unreadable(spec FlagSpec, text string) string {
		return "a value is needed" when text == ""
		let problem = ""
		let repeats = spec.shape := FlagShape.List || FlagShape.Map
		for let (_, part) in repeats ?? (text.split(","), [text]) {
			if spec.shape == FlagShape.Map {
				readMap(spec, [part], "") onerror (err error) {
					problem = err.message.trimPrefix(": ")
					recover ""
				}
				continue
			}
			read(spec, part, "", false) onerror (err error) {
				problem = err.message.trimPrefix(": ")
				recover ""
			}
		}
		return problem
	}

	def spelled(name string) string {
		return name.len() == 1 ?? ("-" + name, "--" + name)
	}

	// The candidate nearest to word, when it is near enough to be what was
	// meant: word begins it, or a third of the longer one's letters differ
	// at most. "" when none is.
	def closest(word string, candidates string[]) string {
		let best = ""
		let bestDistance = 0
		for let (_, candidate) in candidates {
			continue when candidate == ""
			let distance = strings.levenshteinDistance(word, candidate)
			distance = 1 when distance > 1 && word.len() > 1 && candidate.startsWith(word)
			let longer = word.len() > candidate.len() ?? (word.len(), candidate.len())
			continue when distance > (longer + 2) / 3
			continue unless best == "" || distance < bestDistance
			best = candidate
			bestDistance = distance
		}
		return best
	}

	// A camel-case name in kebab case: `dryRun` is `dry-run`.
	def kebabCase(name string) string {
		let out = ""
		for let (i, ch) in name {
			if ch.isUpper() {
				out += "-" unless i == 0
				out += string(ch.lower())
				continue
			}
			out += string(ch == '_' ?? ('-', ch))
		}
		return out
	}

	def firstLine(doc string) string {
		let cut = doc.indexOf("\n")
		return cut < 0 ?? (doc, doc[0:cut])
	}

	def isWholeNumber(text string) bool {
		return /^[+-]?[0-9]+$/.test(text)
	}

	def isNumber(text string) bool {
		return /^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/.test(text)
	}

	def invalid(option string, reason string) UsageError {
		return UsageError{message: "{option}: {reason}", code: "BadValue", kind: UsageKind.BadValue, option: option}
	}
}
