// The help screen from a Jinja template, for a program that gives one.
internal partial module std.cli.flags {
	use (
		std.cli.terminal
		std.reflection
		std.text.templates.jinja
	)

	// The template a program gave; "" while the built-in layout is in use.
	let helpSource = ""

	// The template help is rendered from until a program gives its own.
	def defaultHelpTemplate() string {
		let lines = [
			"\{\{ heading(\"Usage:\") \}\} \{\{ usage \}\}",
			"\{% if description %\}",
			"",
			"\{\{ description \}\}",
			"\{% endif %\}",
			"\{% for section in sections %\}",
			"",
			"\{\{ heading(section.name ~ \":\") \}\}",
			"\{% for row in section.rows %\}",
			"\{% if row.description or row.notes %\}",
			"  \{\{ pad(row.usage, width) \}\}  \{\{ row.description \}\}\{% if row.description and row.notes %\} \{% endif %\}\{% if row.notes %\}\{\{ dim(\"(\" ~ row.notes ~ \")\") \}\}\{% endif %\}",
			"",
			"\{% else %\}",
			"  \{\{ row.usage \}\}",
			"\{% endif %\}",
			"\{% endfor %\}",
			"\{% endfor %\}",
		]
		return lines.join("\n")
	}

	// Makes source the template help is drawn from.
	def useHelpTemplate(source string) {
		helpSource = source
		drawHelpWith((data HelpData) => renderTemplate(helpSource, data))
	}

	def currentHelpTemplate() string {
		return helpSource == "" ?? (defaultHelpTemplate(), helpSource)
	}

	// Renders source with the rows of data.
	//
	// Fails when source is not a valid template or cannot be rendered,
	// naming the line and column.
	def renderTemplate(source string, data HelpData) !string {
		let flags any[] = []
		let groups any[] = []
		// Every list the screen shows, in order: arguments, commands, then
		// the flags by heading.
		let sections any[] = []
		let arguments = templateRows(data.arguments)
		let commands = templateRows(data.commands)
		sections.push(map<string, any>{"name": "Arguments", "rows": arguments}) when arguments.len() > 0
		sections.push(map<string, any>{"name": "Commands", "rows": commands}) when commands.len() > 0
		for let (_, group) in data.groups {
			let rows = templateRows(group.rows)
			groups.push(map<string, any>{"name": group.name, "flags": rows})
			sections.push(map<string, any>{"name": group.name, "rows": rows})
		}
		for let (_, row) in data.rows {
			flags.push(templateRow(row))
		}
		let template = try jinja.parse(source, jinja.Options{trimBlocks: true, lstripBlocks: true})
		template.define("heading", (args any[]) => styled(args, "heading"))
		template.define("emphasis", (args any[]) => styled(args, "emphasis"))
		template.define("dim", (args any[]) => styled(args, "dim"))
		template.define("code", (args any[]) => styled(args, "code"))
		template.define("pad", padded)
		return try template.render(map<string, any>{"program": data.program, "version": data.version, "usage": data.usage, "description": data.description, "arguments": arguments, "commands": commands, "sections": sections, "flags": flags, "groups": groups, "width": data.width})
	}

	// Renders source for a program called program with the flags of specs.
	//
	// Fails as `renderTemplate` does.
	def renderHelp(source string, program string, version string, specs FlagSpec[]) !string {
		return renderTemplate(source, helpData(program, version, specs))
	}

	def templateRows(rows HelpRow[]) any[] {
		let out any[] = []
		for let (_, row) in rows {
			out.push(templateRow(row))
		}
		return out
	}

	// A row as a template reads it.
	def templateRow(row HelpRow) map<string, any> {
		return map<string, any>{
			"usage":       row.usage,
			"group":       row.group,
			"name":        row.name,
			"short":       row.short,
			"placeholder": row.placeholder,
			"description": row.description,
			"default":     row.defaultValue,
			"env":         row.env,
			"required":    row.required,
			"notes":       row.notes,
			"repeats":     row.repeats,
		}
	}

	// The template function behind a role: its first argument in the
	// role's style, when standard output shows colors.
	def styled(args any[], role string) !any {
		expects {
			assert args.len() > 0 onerror "{role}() takes the text to style"
		}
		let content = reflection.scalarText(args[0])
		return terminal.heading(content) when role == "heading"
		return terminal.emphasis(content) when role == "emphasis"
		return terminal.dim(content) when role == "dim"
		return terminal.code(content)
	}

	// The template function `pad(text, width)`: text with spaces after it
	// up to width characters.
	def padded(args any[]) !any {
		expects {
			assert args.len() > 1 onerror "pad() takes the text and a width"
		}
		let content = reflection.scalarText(args[0])
		return content.padEnd(parseInt<int>(reflection.scalarText(args[1])))
	}
}
