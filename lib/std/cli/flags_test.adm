partial module std.cli {
	use (
		std.cli.flags::*
		std.cli.pty
		std.data.semver
		std.net.url
		std.os
		std.reflection
		std.reflection::(VariableMetaContext)
		std.services.runtime::(Runtime)
		std.testing
		std.time
	)

	// What `flagFrom` could not fill, as the messages a program would print.
	let flagFromFailures string[] = []

	// Fills the annotated variable as `@flag` does, from a command line
	// given as text instead of the application's own.
	meta def flagFrom(target VariableMetaContext, line string, name string = "", short string = "", description string = "", hidden bool = false, env string = "", required bool = false, count bool = false, mode string = "r", placeholder string = "", group string = "", excludes string = "", requires string = "") {
		let words = line.split(" ").filter(word => word != "")
		let options = FlagOptions{name: name, short: short, description: description, hidden: hidden, env: env, required: required, count: count, mode: mode, placeholder: placeholder, group: group, excludes: excludes, requires: requires}
		fill(parseArgs(words), specOf(target.descriptor, options), target.editor) onerror (err error) {
			flagFromFailures.push(err.message)
			recover none
		}
	}

	enum FlagMode {
		Dev,
		Prod,
		DryRun,
	}

	check "Flags on variables" {
		@flagFrom("--port 9000 extra")
		let port int = 8080

		@flagFrom("-v --other")
		let quiet bool = true

		@flagFrom("--color=false")
		let color bool = true

		@flagFrom("-v", name = "v")
		let verbose bool = false

		@flagFrom("-p 9100", short = "p")
		let listenPort int = 1

		@flagFrom("--listen 9200", name = "listen", short = "l")
		let renamedPort int = 1

		@flagFrom("-xq", short = "q")
		let bundled bool = false

		@flagFrom("-I a --include b", name = "include", short = "I")
		let bothForms string[] = []

		@flagFrom("--wide 1", short = "ww")
		let wide int = 4

		@flagFrom("--dry-run")
		let dryRun bool = false

		@flagFrom("--ratio=.25")
		let ratio float = 1.0

		@flagFrom("--half-ratio 0.5")
		let halfRatio float32 = 1.0

		@flagFrom("--host example.test")
		let host string = "localhost"

		@flagFrom("-I a --include=b -I c", name = "I")
		let shortIncludes string[] = []

		@flagFrom("--include a --include=b")
		let include string[] = ["default"]

		@flagFrom("--other 1")
		let untouched string[] = ["kept"]

		@flagFrom("--limit eighty")
		let limit int = 5

		@flagFrom("--depth")
		let depth int = 2

		@flagFrom("--size 3")
		let size int32 = 1

		@flagFrom("--tiny 300")
		let tiny int8 = 1

		@flagFrom("--level -128")
		let level int8 = 1

		@flagFrom("--octet 255")
		let octet byte = 1

		@flagFrom("--count -1")
		let count uint = 1

		@flagFrom("--big 18446744073709551615")
		let big uint64 = 1

		@flagFrom("--huge 9223372036854775808")
		let huge int = 1

		@flagFrom("--wait 1m30s")
		let wait duration = 5s

		@flagFrom("--pause soon")
		let pause duration = 5s

		@flagFrom("--mode prod")
		let mode FlagMode = FlagMode.Dev

		@flagFrom("--run-mode dry-run")
		let runMode FlagMode = FlagMode.Dev

		@flagFrom("--shouted DRYRUN")
		let shouted FlagMode = FlagMode.Dev

		@flagFrom("--stage prd")
		let stage FlagMode = FlagMode.Dev

		@flagFrom("--weights 1 --weights 2.5")
		let weights float[] = []

		@flagFrom("--ports 80 --ports 443")
		let ports int[] = []

		@flagFrom("--delays 1s --delays 2m")
		let delays duration[] = []

		@flagFrom("-D a=1 -D b=x=y", name = "define", short = "D")
		let defines map<string, string> = new map<string, string>()

		@flagFrom("--label bare")
		let label map<string, string> = new map<string, string>()

		@flagFrom("--retries 3")
		let retries ?int

		@flagFrom("")
		let absent ?int

		@flagFrom("--title hello")
		let title ?string

		@flagFrom("--source /dev/null")
		let source ?os.File

		@flagFrom("--from -")
		let from ?os.File

		@flagFrom("")
		let unopened ?os.File

		@flagFrom("--missing /no/such/folder/file")
		let missing ?os.File

		@flagFrom("--plain /dev/null")
		let plain os.File = os.stdin

		@flagFrom("--modes dev --modes dry-run")
		let modes FlagMode[] = []

		@flagFrom("--modes-bad dev --modes-bad x")
		let modesBad FlagMode[] = [FlagMode.Prod]

		@flagFrom("--bytes 1 --bytes 255")
		let bytes byte[] = []

		@flagFrom("--halves 0.5 --halves 2")
		let halves float32[] = []

		@flagFrom("--inputs /dev/null --inputs -")
		let inputs os.File[] = []

		@flagFrom("--toggles true")
		let toggles bool[] = []

		@flagFrom("--home-file ~/.")
		let homeFile ?os.File

		@flagFrom("", env = "ADM_CLI_TEST_PORT")
		let envPort int = 1

		@flagFrom("--env-wins 5", env = "ADM_CLI_TEST_PORT")
		let envWins int = 1

		@flagFrom("", env = "ADM_CLI_TEST_LIST")
		let envList string[] = []

		@flagFrom("", env = "ADM_CLI_TEST_SWITCH")
		let envSwitch bool = false

		@flagFrom("", env = "ADM_CLI_TEST_BAD")
		let envBad int = 1

		@flagFrom("", env = "ADM_CLI_TEST_UNSET")
		let envUnset int = 1

		@flagFrom("", required = true)
		let needed int = 1

		@flagFrom("", env = "ADM_CLI_TEST_UNSET", required = true)
		let neededEither int = 1

		@flagFrom("", env = "ADM_CLI_TEST_PORT", required = true)
		let neededFromEnv int = 1

		@flagFrom("-vvv --verbosity -xv", short = "v", count = true)
		let verbosity int = 0

		@flagFrom("", count = true)
		let uncounted int = 2

		@flagFrom("--counted-text", count = true)
		let countedText string = "kept"

		@flagFrom("--no-cache")
		let cache bool = true

		@flagFrom("--no-fast --fast")
		let fast bool = false

		@flagFrom("--strict --no-strict")
		let strict bool = false

		@flagFrom("--since 2026-09-03T14:05:09Z")
		let since ?time.Time

		@flagFrom("--until tomorrow")
		let until ?time.Time

		@flagFrom("--endpoint https://example.test/a?b=1")
		let endpoint ?url.URL

		@flagFrom("--release 1.4.0-rc.1")
		let release ?semver.Semver

		@flagFrom("--bad-release one")
		let badRelease ?semver.Semver

		@flagFrom("--log /dev/null", mode = "w")
		let log ?os.File

		@flagFrom("--sink -", mode = "a")
		let sink ?os.File

		@flagFrom("--odd /dev/null", mode = "x")
		let odd ?os.File

		@flagFrom("--moded 3", mode = "w")
		let moded int = 1

		@flagFrom("--limits cpu=4 --limits mem=16")
		let limits map<string, int> = new map<string, int>()

		@flagFrom("--features fast=yes --features safe=off")
		let features map<string, bool> = new map<string, bool>()

		@flagFrom("--waits read=5s")
		let waits map<string, duration> = new map<string, duration>()

		@flagFrom("--scales x=many")
		let scales map<string, float> = new map<string, float>()

		@flagFrom("--mode-of api=prod --mode-of web=dry-run --mode-of api=dev")
		let modeOf map<string, FlagMode> = new map<string, FlagMode>()

		@flagFrom("--pins core=1.4.0 --pins extra=2.0.1")
		let pins map<string, semver.Semver> = new map<string, semver.Semver>()

		@flagFrom("--small a=7 --small b=300")
		let small map<string, int8> = new map<string, int8>()

		@flagFrom("--day 2026-09-03")
		let day ?time.Time

		@flagFrom("", placeholder = "addr", group = "Network")
		let bind string = "0.0.0.0"

		// Uses **TLS** with the `cert` given.
		@flagFrom("", group = "Network", excludes = "insecure")
		let secure bool = false

		@flagFrom("", excludes = "--secure, bind")
		let insecure bool = false

		@flagFrom("", requires = "key-file")
		let certFile string = ""

		@flagFrom("", env = "ADM_CLI_TEST_KEY")
		let keyFile string = ""

		@flagFrom("", excludes = "key-file")
		let noTls bool = false

		@flagFrom("", required = true)
		let answered int = 1

		@flagFrom("", required = true)
		let answeredList string[] = []

		// Where the output goes.
		// Left out, it goes to the terminal.
		@flagFrom("", short = "o")
		let output string = "out.txt"

		@flagFrom("", description = "Trace every step", hidden = true)
		let trace bool = false

		@flagFrom("", name = "x")
		let extended bool = false

		@test()
		def TestValuesByType() {
			assert port == 9000
			assert ratio == 0.25
			assert halfRatio == float32(0.5)
			assert host == "example.test"
			assert size == 3
		}

		@test()
		def TestSwitches() {
			assert quiet
			assert !color
			assert verbose
			assert dryRun
		}

		@test()
		def TestShortForms() {
			assert listenPort == 9100
			assert renamedPort == 9200
			assert bundled
			assert bothForms.join(",") == "a,b"
			assert wide == 4
			assert flagFromFailures.join(" | ").contains("--wide: the short form 'ww' is not one letter")
		}

		@test()
		def TestRepeatedValues() {
			assert shortIncludes.join(",") == "a,c"
			assert include.join(",") == "a,b"
			assert untouched.join(",") == "kept"
			assert weights.len() == 2 && weights[1] == 2.5
			assert ports.len() == 2 && ports[0] == 80 && ports[1] == 443
			assert delays.len() == 2 && delays[0] == 1s && delays[1] == 2m
		}

		@test()
		def TestMaps() {
			assert defines.len() == 2
			assert defines["a"] == "1" && defines["b"] == "x=y"
			assert label.len() == 0
			assert flagFromFailures.join(" | ").contains("--label: 'bare' is not written key=value")
		}

		@test()
		def TestBadValuesAreReportedAndLeaveTheVariable() {
			assert limit == 5 && depth == 2
			let report = flagFromFailures.join(" | ")
			assert report.contains("--limit: 'eighty' is not a whole number")
			assert report.contains("--depth needs a value")
		}

		@test()
		def TestIntegersAreHeldToTheirType() {
			assert level == -128 && octet == 255 && big == uint64(18446744073709551615)
			assert tiny == 1 && count == 1 && huge == 1
			let report = flagFromFailures.join(" | ")
			assert report.contains("--tiny: 300 does not fit an int8")
			assert report.contains("--count: -1 does not fit a uint")
			assert report.contains("--huge: 9223372036854775808 does not fit an int")
		}

		@test()
		def TestDurations() {
			assert wait == 90s
			assert pause == 5s
			assert flagFromFailures.join(" | ").contains("--pause: 'soon' is not a duration, such as 30s, 5m or 1h30m")
		}

		@test()
		def TestEnums() {
			assert mode == FlagMode.Prod
			assert runMode == FlagMode.DryRun
			assert shouted == FlagMode.DryRun
			assert stage == FlagMode.Dev
			assert flagFromFailures.join(" | ").contains("--stage: 'prd' is not one of dev, prod, dry-run; did you mean prod?")
		}

		@test()
		def TestOptionalsStayNoneUntilGiven() !none {
			assert absent is none
			let tries = retries
			fail "--retries was not read" when tries is none
			assert tries == 3
			let heading = title
			fail "--title was not read" when heading is none
			assert heading == "hello"
			return none
		}

		@test()
		def TestFiles() !none {
			assert unopened is none
			let opened = source
			fail "--source was not opened" when opened is none
			assert opened.path() == "/dev/null"
			try opened.close()
			let input = from
			fail "--from - is standard input" when input is none
			assert input.descriptor() == os.stdin.descriptor()
			assert missing is none
			assert plain.descriptor() == os.stdin.descriptor()
			let report = flagFromFailures.join(" | ")
			assert report.contains("--missing: cannot open '/no/such/folder/file'")
			assert report.contains("--plain: a file flag is declared ?os.File")
			return none
		}

		@test()
		def TestListsOfAnyValueType() !none {
			assert modes.len() == 2 && modes[0] == FlagMode.Dev && modes[1] == FlagMode.DryRun
			assert modesBad.len() == 1 && modesBad[0] == FlagMode.Prod
			assert bytes.len() == 2 && bytes[0] == 1 && bytes[1] == 255
			assert halves.len() == 2 && halves[0] == float32(0.5) && halves[1] == float32(2)
			assert inputs.len() == 2 && inputs[0].path() == "/dev/null" && inputs[1].descriptor() == os.stdin.descriptor()
			try inputs[0].close()
			assert flagFromFailures.join(" | ").contains("--modes-bad: 'x' is not one of dev, prod, dry-run")
			return none
		}

		@test()
		def TestTypesNoFlagFills() {
			assert toggles.len() == 0
			assert flagFromFailures.join(" | ").contains("--toggles: a variable of type")
		}

		@test()
		def TestHomeFolderInAFilePath() !none {
			let opened = homeFile
			fail "--home-file was not opened" when opened is none
			assert opened.path() == os.clean(try os.homeDir())
			try opened.close()
			return none
		}

		@test()
		def TestEnvironmentWhenTheFlagIsNotGiven() !none {
			try Runtime.setEnv("ADM_CLI_TEST_PORT", "7000")
			try Runtime.setEnv("ADM_CLI_TEST_LIST", "a,b,c")
			try Runtime.setEnv("ADM_CLI_TEST_SWITCH", "yes")
			try Runtime.setEnv("ADM_CLI_TEST_BAD", "many")
			assert envPort == 7000
			assert envWins == 5
			assert envList.join("|") == "a|b|c"
			assert envSwitch
			assert envBad == 1 && envUnset == 1
			assert flagFromFailures.join(" | ").contains("ADM_CLI_TEST_BAD: 'many' is not a whole number")
			return none
		}

		@test()
		def TestRequiredFlags() !none {
			try Runtime.setEnv("ADM_CLI_TEST_PORT", "7000")
			assert needed == 1 && neededEither == 1 && neededFromEnv == 7000
			let report = flagFromFailures.join(" | ")
			assert report.contains("--needed is required")
			assert report.contains("--needed-either is required, on the command line or as ADM_CLI_TEST_UNSET in the environment")
			assert !report.contains("--needed-from-env")
			return none
		}

		@test()
		def TestCountedFlags() {
			assert verbosity == 5
			assert uncounted == 2
			assert countedText == "kept"
			assert flagFromFailures.join(" | ").contains("--counted-text: only a whole number counts how often a flag is given")
		}

		@test()
		def TestSwitchesTurnedOffByNo() {
			assert !cache
			assert fast
			assert !strict
		}

		@test()
		def TestTypesThatParseThemselves() !none {
			let moment = since
			fail "--since was not read" when moment is none
			assert moment.year() == 2026
			assert until is none
			let address = endpoint
			fail "--endpoint was not read" when address is none
			assert address.str() == "https://example.test/a?b=1"
			let version = release
			fail "--release was not read" when version is none
			assert version.major == 1 && version.minor == 4
			assert badRelease is none
			let report = flagFromFailures.join(" | ")
			assert report.contains("--until: 'tomorrow' is not a date or time")
			assert report.contains("--bad-release: 'one' is not a version, such as 1.4.0")
			return none
		}

		@test()
		def TestFileModes() !none {
			let written = log
			fail "--log was not opened" when written is none
			assert (try written.write("x".bytes())) == 1
			try written.close()
			let out = sink
			fail "--sink - is standard output" when out is none
			assert out.descriptor() == os.stdout.descriptor()
			assert odd is none && moded == 1
			let report = flagFromFailures.join(" | ")
			assert report.contains("--odd: mode 'x' is not one of r, w, a, r+, w+, a+")
			assert report.contains("--moded: mode is for a file flag")
			return none
		}

		@test()
		def TestMapsOfOtherValueTypes() !none {
			assert limits.len() == 2 && limits["cpu"] == 4 && limits["mem"] == 16
			assert features["fast"] && !features["safe"]
			assert waits["read"] == 5s
			assert scales.len() == 0
			assert flagFromFailures.join(" | ").contains("--scales: 'many' is not a number")
			// Values of any type a flag reads; a key given twice keeps the last.
			assert modeOf.len() == 2 && modeOf["api"] == FlagMode.Dev && modeOf["web"] == FlagMode.DryRun
			assert pins.len() == 2 && pins["core"].str() == "1.4.0" && pins["extra"].str() == "2.0.1"
			assert small.len() == 0
			assert flagFromFailures.join(" | ").contains("--small: 300 does not fit an int8")
			return none
		}

		@test()
		def TestDateAlone() !none {
			let moment = day
			fail "--day was not read" when moment is none
			assert moment.year() == 2026 && moment.str().startsWith("2026-09-03T00:00:00")
			return none
		}

		@test()
		def TestAnswersStandInForARequiredFlag() {
			answers.set("answered", "41")
			answers.set("answered-list", "a,b")
			assert answered == 41
			assert answeredList.join("|") == "a|b"
			assert !flagFromFailures.join(" | ").contains("--answered")
		}

		@test()
		def TestRequiredFlagsAreAskedForOnATerminal() !none {
			let screen = try pty.open()
			defer screen.close()
			let sure = FlagSpec{name: "asked-sure", description: "Go ahead.", shape: FlagShape.Switch, kind: "bool", required: true}
			let amount = FlagSpec{name: "asked-size", shape: FlagShape.Value, kind: "int", required: true}
			// In name order: a number, refused once, then yes to the switch.
			screen.pressWhenRaw("x\r\u007f12\ry")
			assert (try checkLine(["in.txt"], [amount, sure])) == ""
			assert answers["asked-sure"] == "true" && answers["asked-size"] == "12"
			let drawn = screen.output()
			assert drawn.contains("Go ahead") && drawn.contains("--asked-size") && drawn.contains("is not a whole number")
			// Leaving the question ends the reading of the line.
			let again = FlagSpec{name: "asked-again", shape: FlagShape.Value, kind: "string", required: true}
			let left = false
			screen.pressWhenRaw("\u001b")
			checkLine([], [again]) onerror (err error) {
				left = true
				recover ""
			}
			assert left && !answers.hasKey("asked-again")
			return none
		}

		@test()
		def TestWhatIsWrongWithATypedAnswer() {
			let number = FlagSpec{name: "port", shape: FlagShape.Value, kind: "int"}
			assert unreadable(number, "") == "a value is needed"
			assert unreadable(number, "x") == "'x' is not a whole number"
			assert unreadable(number, "80") == ""
			let list = FlagSpec{name: "ports", shape: FlagShape.List, kind: "int"}
			assert unreadable(list, "80,443") == "" && unreadable(list, "80,x") == "'x' is not a whole number"
		}

		@test()
		def TestFlagsThatExcludeEachOther() !none {
			let flags = suiteFlags().filter(spec => spec.name := "secure" || "insecure" || "bind")
			assert (try checkLine(["--secure"], flags)) == ""
			assert (try checkLine(["--insecure"], flags)) == ""
			let messages string[] = []
			for let (_, line) in [["--secure", "--insecure"], ["--insecure", "--bind", "x"]] {
				checkLine(line, flags) onerror (err error) {
					messages.push(err.message)
					messages.push(err.kind.name) when err is UsageError
					recover ""
				}
			}
			assert messages.len() == 4 && messages[1] == "Conflict" && messages[3] == "Conflict"
			assert messages[0] := "--secure cannot be used with --insecure" || "--insecure cannot be used with --secure"
			assert messages[2] == "--insecure cannot be used with --bind"
			return none
		}

		@test()
		def TestFlagsThatNeedEachOther() !none {
			let flags = suiteFlags().filter(spec => spec.name := "cert-file" || "key-file" || "no-tls")
			assert (try checkLine(["--cert-file", "c", "--key-file", "k"], flags)) == ""
			assert (try checkLine(["--key-file", "k"], flags)) == ""
			let messages string[] = []
			checkLine(["--cert-file", "c"], flags) onerror (err error) {
				messages.push(err.message)
				recover ""
			}
			// A flag whose environment variable is set counts as given.
			try Runtime.setEnv("ADM_CLI_TEST_KEY", "k.pem")
			assert (try checkLine(["--cert-file", "c"], flags)) == ""
			checkLine(["--no-tls"], flags) onerror (err error) {
				messages.push(err.message)
				recover ""
			}
			try Runtime.setEnv("ADM_CLI_TEST_KEY", "")
			assert messages.join(" | ") == "--cert-file needs --key-file | --no-tls cannot be used with --key-file"
			return none
		}

		@test()
		def TestTheFlagReportedIsTheFirstByName() !none {
			let flags = suiteFlags().filter(spec => spec.name := "port" || "wait" || "mode")
			for let i = 0; i < 3; i++ {
				let message = ""
				checkLine(["--wait", "x", "--port", "nine", "--mode", "x"], flags) onerror (err error) {
					message = err.message
					recover ""
				}
				assert message.startsWith("--mode: 'x' is not one of")
			}
			return none
		}

		@test()
		def TestHelpGroupsAndMarkdown() !none {
			let screen = try renderHelp(defaultHelpTemplate(), "tool", "1.2", suiteFlags())
			let network = screen.indexOf("\nNetwork:\n")
			assert network > screen.indexOf("\nOptions:\n") && network > screen.indexOf("--version")
			let section = screen[network:]
			assert section.contains("      --bind <addr>") && section.contains("(default 0.0.0.0)")
			assert section.contains("      --secure") && section.contains("Uses **TLS** with the `cert` given.")
			helpMarkdown()
			let read = try renderHelp(defaultHelpTemplate(), "tool", "1.2", suiteFlags())
			helpMarkdown(false)
			assert read.contains("Uses *TLS* with the cert given.") && read.contains("Where the output goes.")
			assert !section.contains("--insecure") && !section.contains("--port ")
			return none
		}

		// The flags of this suite, as a program's `@flag` variables are found.
		def suiteFlags() FlagSpec[] {
			let out FlagSpec[] = []
			for let (_, hit) in reflection.attrs(flagFrom) {
				let spec = specOf(hit, 1)
				out.push(spec) unless spec is none
			}
			return out
		}

		@test()
		def TestHelpListsTheFlags() !none {
			let screen = try renderHelp(defaultHelpTemplate(), "tool", "1.2", suiteFlags())
			let lines = screen.split("\n")
			assert lines[0] == "Usage: tool [options] [arguments]"
			assert screen.contains("\n\nOptions:\n")
			assert lines.filter(line => line.startsWith("      --port <int> ") && line.endsWith("  (default 8080)")).len() == 1
			assert screen.contains("  -o, --output <text>")
			assert screen.contains("Where the output goes. (default out.txt)")
			assert !screen.contains("Left out, it goes")
			assert screen.contains("      --mode <dev|prod|dry-run>") && screen.contains("(default dev)")
			assert screen.contains("      --wait <duration>") && screen.contains("(default 5s)")
			assert screen.contains("  -D, --define <key=value>...")
			assert screen.contains("      --include <text>...")
			assert screen.contains("      --source <file>")
			assert screen.contains("      --no-color") && !screen.contains("(default true)")
			assert screen.contains("  -v, --verbosity...")
			assert lines.filter(line => line.startsWith("      --needed <int> ") && line.endsWith("  (required)")).len() == 1
			assert screen.contains("      --env-port <int>") && screen.contains("(default 1, env ADM_CLI_TEST_PORT)")
			assert screen.contains("      --since <time>") && screen.contains("      --endpoint <url>") && screen.contains("      --release <version>")
			assert screen.contains("      --version") && screen.contains("Show the version")
			assert screen.contains("\n  -x\n")
			assert screen.contains("  -h, --help") && screen.contains("Show this help")
			assert !screen.contains("--trace") && !screen.contains("Trace every step")
			assert !screen.contains("--wide") && !screen.contains("--plain")
			// Name order, the help flag last.
			assert screen.indexOf("--big") < screen.indexOf("--no-color") && screen.indexOf("--no-color") < screen.indexOf("--wait")
			assert screen.indexOf("--help") > screen.indexOf("--wait") && screen.indexOf("--version") > screen.indexOf("--help")
			return none
		}

		@test()
		def TestHelpTemplateOfTheProgram() !none {
			assert helpTemplate() == defaultHelpTemplate()
			let usual = try help()
			// The built-in layout is what the default template draws.
			assert plainHelp(helpData("tool", "1.2", suiteFlags())) == (try renderHelp(defaultHelpTemplate(), "tool", "1.2", suiteFlags()))
			assert usual.contains("Usage: ") && usual.contains("  -h, --help ") && usual.contains(" Show this help\n") && usual.contains("      --version ")
			assert usual.contains("      --completion <bash|zsh|fish|powershell>  Write the completion script for a shell\n")
			try helpTemplate("\{\{ flags | length \}\} flags of \{\{ program \}\}")
			assert (try help()).startsWith("3 flags of ")
			let refused = false
			helpTemplate("\{% if %\}") onerror (err error) {
				refused = true
				recover none
			}
			assert refused && (try help()).startsWith("3 flags of ")
			try helpTemplate(defaultHelpTemplate())
			assert (try help()) == usual
			drawHelpWith(none)
			assert (try help()) == usual
			return none
		}

		@test()
		def TestHelpFromAnotherTemplate() !none {
			let custom = "\{\{ program \}\} \{\{ version \}\}:\{% for flag in flags %\}\{% if flag.short %\} \{\{ flag.short \}\}=\{\{ flag.name \}\}\{% endif %\}\{% endfor %\} [\{\{ pad(\"ab\", 4) \}\}]"
			let screen = try renderHelp(custom, "tool", "1.2", suiteFlags())
			assert screen == "tool 1.2: q=bundled D=define I= I=include l=listen p=listen-port o=output v= v=verbosity x= h=help [ab  ]"
			let failed = false
			renderHelp("\{% for flag in %\}", "tool", "1.2", []) onerror (err error) {
				failed = true
				recover ""
			}
			assert failed
			return none
		}

		@test()
		def TestWholeLineIsCheckedBeforeAnyFlagIsRead() !none {
			let flags = suiteFlags().filter(spec => spec.problem == "" && !spec.required && spec.env == "" && spec.excludes.len() == 0)
			assert (try checkLine(["--port", "9000", "-o", "x", "in.txt", "--unknown"], flags)) == ""
			assert (try checkLine(["--help"], flags)) == "help"
			assert (try checkLine(["in.txt", "-qh"], flags)) == "help"
			assert (try checkLine(["--version"], flags)) == "version"
			assert (try checkLine(["--version", "-h"], flags)) == "help"
			// Help is answered even when another flag is wrong.
			assert (try checkLine(["--port", "nine", "--help"], flags)) == "help"
			// A flag's value is not a request for help.
			assert (try checkLine(["--output", "--help"], flags)) == ""
			let message = ""
			checkLine(["--wait", "1m", "--port", "nine", "--mode", "prod"], flags) onerror (err error) {
				message = err.message
				recover ""
			}
			assert message == "--port: 'nine' is not a whole number"
			// A file is named, not opened.
			assert (try checkLine(["--source", "/no/such/file"], flags)) == ""
			let must = FlagSpec{name: "token", shape: FlagShape.Value, kind: "string", required: true}
			message = ""
			checkLine(["--port", "1"], [must]) onerror (err error) {
				message = "{err.message}"
				message = "{err.kind.name}: {err.message}" when err is UsageError
				recover ""
			}
			assert message == "Required: --token is required"
			assert (try checkLine(["-h"], [must])) == "help"
			return none
		}

		@test()
		def TestAFlagNamedHelpTakesItOver() !none {
			let own = FlagSpec{name: "help", short: "h", shape: FlagShape.Switch, kind: "bool"}
			assert (try checkLine(["--help", "-h"], [own])) == ""
			let about = FlagSpec{name: "version", shape: FlagShape.Value, kind: "string"}
			assert (try checkLine(["--version", "2"], [about])) == ""
			return none
		}

		@test()
		def TestDeclaredValueShownInHelp() {
			let value = FlagSpec{shape: FlagShape.Value, kind: "int"}
			assert shownDefault("8080", value) == "8080"
			assert shownDefault("\"out.txt\"", value) == "out.txt"
			assert shownDefault("1m30s", value) == "1m30s"
			assert shownDefault("0.5", value) == "0.5"
			assert shownDefault("true", value) == "true"
			assert shownDefault("", value) == "" && shownDefault("false", value) == "" && shownDefault("none", value) == ""
			assert shownDefault("\"\"", value) == "" && shownDefault("defaultPort()", value) == ""
			assert shownDefault("FlagMode.DryRun", FlagSpec{shape: FlagShape.Value, kind: "enum"}) == "dry-run"
			assert shownDefault("[\"a\"]", FlagSpec{shape: FlagShape.List, kind: "string"}) == ""
		}

		@test()
		def TestKebabCase() {
			assert kebabCase("dryRun") == "dry-run"
			assert kebabCase("port") == "port"
			assert kebabCase("maxOpenFiles") == "max-open-files"
			assert kebabCase("max_open") == "max-open"
			assert kebabCase("URL") == "u-r-l"
		}

		@test()
		def TestClosestName() {
			assert closest("prot", ["host", "port", "verbose"]) == "port"
			assert closest("verb", ["host", "port", "verbose"]) == "verbose"
			assert closest("colour", ["color", "count"]) == "color"
			assert closest("zzz", ["host", "port"]) == ""
		}

		// What a program with only these flags tells the shell may come
		// next, between commas.
		def completed(shell string, words string[]) string {
			let portFlag = FlagSpec{name: "port", short: "p", shape: FlagShape.Value, kind: "int", description: "Where to listen"}
			let quietFlag = FlagSpec{name: "quiet", shape: FlagShape.Switch, kind: "bool"}
			let configFlag = FlagSpec{name: "config", shape: FlagShape.Value, kind: "string"}
			let profileFlag = FlagSpec{name: "profile", shape: FlagShape.Value, kind: "string"}
			return flagCompletions(shell, words, [portFlag, quietFlag, configFlag, profileFlag]).trimSuffix("\n").replace("\n", ",")
		}

		@test()
		def TestCompletionOfAProgramWithoutCommands() {
			assert completed("bash", ["--"]) == "--completion,--config,--help,--port,--profile,--quiet"
			assert completed("bash", ["--quiet", "--p"]) == "--port,--profile"
			assert completed("bash", ["--quiet", "--q"]) == ""
			assert completed("fish", ["--po"]) == "--port\tWhere to listen"
			assert completed("bash", ["--port", ""]) == ""
			assert completed("bash", ["--config", ""]) == ":files"
			assert completed("bash", ["in.txt", ""]) == ":files"
			assert completed("bash", ["--", "-"]) == ":files"
			assert completed("bash", ["--completion", ""]) == "bash,zsh,fish,powershell"
			assert completed("zsh", ["--completion=z"]) == "--completion=zsh"
			assert completed("powershell", ["--quiet", "\"\""]) == ":files"
			complete("profile", (word string) => ["dev", "staging"])
			assert completed("bash", ["--profile", "s"]) == "staging"
			assert completed("bash", ["--profile", "=", ""]) == "dev,staging"
		}

		@test()
		def TestCompletionAskedOfAProgramWithoutCommands() !none {
			let portFlag = FlagSpec{name: "port", short: "p", shape: FlagShape.Value, kind: "string"}
			assert (try scriptAsked(["in.txt", "-p", "1"], [portFlag])) == ""
			assert (try scriptAsked([completeWord, "bash", "--p"], [portFlag])) == "--port\n\n"
			assert (try scriptAsked([completeWord], [portFlag])) == ":files\n\n"
			assert (try scriptAsked(["--completion", "zsh"], [portFlag])).startsWith("#compdef ")
			assert (try scriptAsked(["--completion=powershell"], [portFlag])).contains("Register-ArgumentCompleter -Native")
			// The value of another flag is not the name.
			assert (try scriptAsked(["--port", "--completion"], [portFlag])) == ""
			let message = ""
			scriptAsked(["--completion", "csh"], [portFlag]) onerror (err error) {
				message = err.message
				recover ""
			}
			assert message == "--completion takes the shell to write the script for: bash, zsh, fish, powershell"
			// A flag of the name takes it over.
			let own = FlagSpec{name: "completion", shape: FlagShape.Value, kind: "string"}
			assert (try scriptAsked(["--completion", "bash"], [own])) == ""
			let screen = plainHelp(helpData("tool", "1.0", [portFlag], completes = true))
			assert screen.contains("      --completion <bash|zsh|fish|powershell>  Write the completion script for a shell\n")
			assert !plainHelp(helpData("tool", "1.0", [portFlag, own], completes = true)).contains("Write the completion script")
			assert !plainHelp(helpData("tool", "1.0", [portFlag])).contains("--completion")
			return none
		}
	}
}
