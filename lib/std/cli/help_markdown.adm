partial module std.cli {
	use (
		std.cli.flags::*
		std.cli.terminal
		std.formats.docs
		std.os
	)

	// Has the help screen read descriptions as Markdown: `code`, **bold**
	// and links take the terminal's styles, or their plain text forms where
	// standard output shows no colors. Off, which is how a program starts,
	// descriptions are shown as written. Call it before the first flag is
	// read. A program that calls it carries the Markdown reader; others do
	// not.
	def helpMarkdown(on bool = true) {
		if !on {
			describeHelpWith(none)
			return
		}
		describeHelpWith((description string) => markdownLine(description))
	}

	// A line of Markdown as terminal text.
	internal def markdownLine(text string) string {
		return text when text == ""
		let doc = (new docs.Markdown()).decode(text)
		return terminal.render(doc, os.stdout, 100000).trim().replace("\n", " ")
	}
}
