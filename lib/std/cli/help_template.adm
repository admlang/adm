partial module std.cli {
	use (
		std.cli.flags::*
		std.services::(Application)
	)

	// Draws the help screen from a template instead of the built-in layout:
	// a Jinja template (`std.text.templates.jinja`). It gets:
	//
	//   - `program`: the name the program was started as.
	//   - `version`: the application's version.
	//   - `usage`: what follows `Usage:`, and `description`: what the
	//     program or the command shown does.
	//   - `arguments` and `commands`: the positional arguments of the
	//     command shown and the commands under it, as rows with `usage` and
	//     `description`; both empty for a program without commands.
	//   - `sections`: every list on the screen in order (`Arguments`,
	//     `Commands`, then each heading of flags), each with `name` and
	//     `rows`.
	//   - `groups`: the flags by the heading they are listed under, each
	//     with `name` (`Options` for flags with no group) and `flags`.
	//   - `flags`: the flags that are not hidden, in name order, each with
	//     `usage` (`-p, --port <int>`), `name`, `short`, `placeholder`,
	//     `description`, `group`, `default` (the declared value, "" when there is
	//     none to show), `env`, `required`, `notes` (those three as one
	//     text: `default 8080, env PORT`, or `required, env PORT`) and `repeats`.
	//   - `width`: the length of the longest `usage`.
	//   - `heading(text)`, `emphasis(text)`, `dim(text)`, `code(text)`: the
	//     terminal roles, plain text when standard output shows no colors.
	//   - `pad(text, width)`: text followed by spaces up to width.
	//
	// Fails when source is not a valid template.
	def helpTemplate(source string) !none {
		try renderHelp(source, programName(), Application.version(), [])
		useHelpTemplate(source)
		return none
	}

	// Returns the template in use: the one given, or the one that draws the
	// built-in layout.
	def helpTemplate() string {
		return currentHelpTemplate()
	}
}
