// Questions and progress on the terminal, for tools that never go full
// screen.
//
// A question is asked on the terminal when the program has one: keys are
// read as they are typed and the question redraws in place. With standard
// input or output redirected the same call reads its answer as a line, so a
// script can feed a tool what a person would type.
//
// Example: A small wizard
// ```example
// use std.cli.prompts
//
// let name = try prompts.ask("Project name", "demo")
// let kind = try prompts.choose("Kind", ["application", "library", "plugin"])
// let extras = try prompts.chooseMany("Add", ["tests", "docs", "ci"])
// return unless try prompts.confirm("Create {name}?", true)
// let work = prompts.spinner("Creating files")
// // ...
// work.done("Created {name}")
// ```
partial module std.cli.prompts {
	use (
		std.cli.prompts.views::*
		std.cli.terminal
		std.cli.terminal::(Key, KeyCode)
		std.errors
		std.os
		std.text.unicode
		std.time
	)

	// Cancelled is the error a question fails with when the person leaves
	// it with Escape or Ctrl+C.
	struct Cancelled {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	// Asks for a line of text and returns it. An empty answer is fallback.
	// validate, when given, returns what is wrong with an answer, or "" when
	// it will do: on the terminal the message is shown and the question
	// stays.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, when the terminal cannot
	// be read, and, with no terminal, when the input has ended or the line
	// read does not pass validate.
	def ask(label string, fallback string = "", validate ?def (string) string = none) !string {
		if interactive() {
			let shown = new TextView(label, fallback, validate)
			try run(shown)
			return shown.value
		}
		let line = try terminal.input(plainQuestion(label, fallback))
		let answer = line == "" ?? (fallback, line)
		let problem = ""
		problem = validate(answer) unless validate is none
		fail "{label}: {problem}" unless problem == ""
		return answer
	}

	// Asks for text of several lines and returns it, its lines joined with
	// line feeds: Enter starts a new line, Ctrl+D ends the text, and a
	// paste keeps its lines. Text left empty is fallback. With no terminal
	// the text is everything standard input still holds.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, and when the terminal
	// cannot be read.
	def text(label string, fallback string = "") !string {
		if interactive() {
			let shown = new LinesView(label, fallback)
			try run(shown)
			return shown.value
		}
		let lines string[] = []
		let ended = false
		let prompt = plainQuestion(label, "")
		for !ended {
			let line = terminal.input(prompt) onerror (err error) {
				ended = true
				recover ""
			}
			lines.push(line) unless ended
			prompt = ""
		}
		return lines.len() == 0 ?? (fallback, lines.join("\n"))
	}

	// Asks for a line that must not be seen: a dot is shown for each
	// character typed. With no terminal the line is read as it comes.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, when the terminal cannot
	// be read, and, with no terminal, when the input has ended.
	def secret(label string) !Secret<string> {
		if interactive() {
			let shown = new TextView(label, "", none)
			shown.masked = true
			try run(shown)
			return shown.value
		}
		return try terminal.input(plainQuestion(label, ""))
	}

	// Asks for a date, or a date and time, and returns it: `2026-09-03`, or
	// what `time.parse` reads. An empty answer is fallback, when one is
	// given.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, when the terminal cannot
	// be read, and, with no terminal, when the input has ended or the line
	// read is no date.
	def date(label string, fallback string = "") !time.Time {
		let text = try ask(label, fallback, (answer string) => readsAsDate(answer) ?? ("", "a date such as 2026-09-03, please"))
		return readDate(text)
	}

	// Asks for a file by walking folders from start: the arrow keys move,
	// typing narrows, Enter opens the marked folder or takes the marked
	// file. Returns the file's path. With extensions (`["png", "jpg"]`) only
	// the files that have one of them are listed, in any case; entries
	// whose names start with a dot are listed only with hidden. With no
	// terminal the answer is a line holding the path, whatever its name.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, when start cannot be
	// resolved, when the terminal cannot be read, and, with no terminal,
	// when the input has ended.
	def file(label string, start string = ".", extensions string[] = [], hidden bool = false) !string {
		let folder = try os.resolve(start)
		if interactive() {
			let shown = new FileView(label, folder, extensions, hidden)
			try run(shown)
			return shown.value
		}
		return os.resolve(try terminal.input(plainQuestion(label, "")))
	}

	// Asks a yes-or-no question: `y` or `n` answers it, Enter takes
	// fallback.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, when the terminal cannot
	// be read, and, with no terminal, when the input has ended or the line
	// read is neither yes nor no.
	def confirm(label string, fallback bool = false) !bool {
		if interactive() {
			let shown = new ConfirmView(label, fallback)
			try run(shown)
			return shown.value
		}
		return readConfirm(try terminal.input(plainQuestion(label, fallback ?? ("Y/n", "y/N"))), fallback)
	}

	// Asks for one of choices and returns it. The arrow keys move, typing
	// narrows the list, Enter takes the marked one; initial is the index
	// marked first. With no terminal the answer is a line holding the
	// choice or its number from 1, and an empty line takes initial.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, when choices is empty,
	// when the terminal cannot be read, and, with no terminal, when the
	// input has ended or the line names no choice.
	def choose(label string, choices string[], initial int = 0) !string {
		expects {
			assert choices.len() > 0 onerror "{label}: there is nothing to choose from"
		}
		if interactive() {
			let shown = new ListView(label, choices, initial, false, [])
			try run(shown)
			return choices[shown.value]
		}
		return choices[try readChoice(try terminal.input(plainQuestion(label, choices.join(", "))), choices, initial)]
	}

	// Asks for any number of choices and returns the picked ones in the
	// order they are listed. Space picks or drops the marked one, Enter
	// accepts; chosen are picked to begin with. With no terminal the answer
	// is a line of choices or numbers between commas, and an empty line
	// takes chosen.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, when the terminal cannot
	// be read, and, with no terminal, when the input has ended or a part of
	// the line names no choice.
	def chooseMany(label string, choices string[], chosen string[] = []) !string[] {
		if interactive() {
			let shown = new ListView(label, choices, 0, true, chosen)
			try run(shown)
			return shown.values()
		}
		return readChoices(try terminal.input(plainQuestion(label, choices.join(", "))), choices, chosen)
	}

	// Shows label beside a turning mark until the work it stands for ends,
	// and returns the spinner to end it with. With standard output
	// redirected the label is written once as a line.
	def spinner(label string) Spinner {
		let made = new Spinner(label)
		made.start()
		return made
	}

	// Shows label beside a bar that fills as work is reported, out of
	// total steps, and returns the bar to report to. With standard output
	// redirected only the line that ends it is written.
	def progress(label string, total int) Progress {
		return new Progress(label, total)
	}

	// Spinner is a line that turns while something runs. `done` or `failed`
	// ends it; until then what the program has to say goes through `log`,
	// since anything else written to standard output lands on the
	// spinner's line.
	type Spinner {
		internal atomic text    string
		internal atomic stopped bool
		// Set by the turning task when it has drawn its last mark.
		internal atomic idle    bool
		internal atomic step    int
		internal live           bool

		// A spinner showing label; use `spinner`.
		def new(label string) {
			text = label
			live = terminal.isTTY(os.stdout)
			idle = true
		}

		// Starts turning; `spinner` does it.
		def start() {
			if !live {
				os.stdout.write("{text}\n".bytes()) onerror recover 0
				return
			}
			terminal.showCursor(false)
			idle = false
			async turn()
		}

		// Replaces the text beside the mark.
		def label(next string) {
			text = next
		}

		// Writes a line above the spinner, which goes on turning under it:
		// how a program reports something while the spinner runs.
		def log(line string) {
			if !live || stopped {
				os.stdout.write("{line}\n".bytes()) onerror recover 0
				return
			}
			os.stdout.write("\r\u001b[2K{line}\n{terminal.prompt(mark())} {text}".bytes()) onerror recover 0
		}

		// The mark of the step the spinner is on.
		internal def mark() string {
			let marks = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
			return string(marks[step % marks.len()])
		}

		// Ends the spinner, leaving a line that says it went well: closing,
		// or the label when left out.
		def done(closing string = "") {
			close(terminal.success("✔"), closing)
		}

		// Ends the spinner, leaving a line that says it went wrong:
		// closing, or the label when left out.
		def failed(closing string = "") {
			close(terminal.failure("✖"), closing)
		}

		internal def close(mark string, closing string) {
			return when stopped
			stopped = true
			for !idle {
				time.sleep(2ms)
			}
			let line = "{mark} {closing == "" ?? (text, closing)}\n"
			if live {
				terminal.showCursor(true)
				line = "\r\u001b[2K" + line
			}
			os.stdout.write(line.bytes()) onerror recover 0
		}

		internal async def turn() {
			for !stopped {
				os.stdout.write("\r\u001b[2K{terminal.prompt(mark())} {text}".bytes()) onerror recover 0
				step++
				time.sleep(80ms)
			}
			idle = true
		}
	}

	// Progress is a bar that fills as steps are reported. `done` or `failed`
	// ends it; until then what the program has to say goes through `log`,
	// since anything else written to standard output lands on the bar's
	// line.
	type Progress {
		internal label   string
		internal total   int
		internal reached int
		internal live    bool
		internal ended   bool
		// The percentage last drawn, so a step that changes nothing on
		// screen writes nothing.
		internal drawn   int

		// A bar for total steps; use `progress`.
		def new(label string, total int) {
			self.label = label
			self.total = total < 1 ?? (1, total)
			live = terminal.isTTY(os.stdout)
			drawn = -1
			if live {
				terminal.showCursor(false)
				draw()
			}
		}

		// Reports steps more as finished.
		def advance(steps int = 1) {
			update(reached + steps)
		}

		// Reports how many steps are finished in all.
		def update(finished int) {
			reached = finished < 0 ?? (0, finished > total ?? (total, finished))
			draw() when live && !ended
		}

		// Writes a line above the bar, which stays under it.
		def log(line string) {
			if !live || ended {
				os.stdout.write("{line}\n".bytes()) onerror recover 0
				return
			}
			os.stdout.write("\r\u001b[2K{line}\n".bytes()) onerror recover 0
			drawn = -1
			draw()
		}

		// Ends the bar, leaving a line that says it went well: closing, or
		// the label when left out.
		def done(closing string = "") {
			close(terminal.success("✔"), closing)
		}

		// Ends the bar, leaving a line that says it went wrong: closing, or
		// the label when left out.
		def failed(closing string = "") {
			close(terminal.failure("✖"), closing)
		}

		internal def close(mark string, closing string) {
			return when ended
			ended = true
			let line = "{mark} {closing == "" ?? (label, closing)}\n"
			if live {
				terminal.showCursor(true)
				line = "\r\u001b[2K" + line
			}
			os.stdout.write(line.bytes()) onerror recover 0
		}

		internal def draw() {
			let percent = reached * 100 / total
			return when percent == drawn
			drawn = percent
			let room = 30
			let size = terminal.size()
			room = size.columns - unicode.displayWidth(label) - 24 unless size is none
			room = room < 10 ?? (10, room > 40 ?? (40, room))
			os.stdout.write("\r\u001b[2K{progressLine(label, reached, total, room)}".bytes()) onerror recover 0
		}
	}

	// A date alone, or what `time.parse` reads.
	internal def readDate(text string) !time.Time {
		let failed = false
		let moment = time.parse(text) onerror (err error) {
			failed = true
			recover time.now()
		}
		return moment unless failed
		return time.parse(text, time.TimeFormat.DateOnly)
	}

	internal def readsAsDate(text string) bool {
		let reads = true
		readDate(text) onerror (err error) {
			reads = false
			recover time.now()
		}
		return reads
	}

	// Whether questions are asked key by key: standard input and output
	// are both a terminal.
	internal def interactive() bool {
		return terminal.isTTY(os.stdin) && terminal.isTTY(os.stdout)
	}

	// The question as one line, for an answer read as a line.
	internal def plainQuestion(label string, hint string) string {
		return hint == "" ?? ("{label}: ", "{label} ({hint}): ")
	}

	// Shows a view on the terminal and feeds it keys until it is answered,
	// then leaves its summary line in its place.
	//
	// Fails with `Cancelled` on Escape or Ctrl+C, and when the terminal
	// cannot be read.
	internal def run(shown View) !none {
		terminal.raw(true)
		defer terminal.raw(false)
		terminal.bracketedPaste(true)
		defer terminal.bracketedPaste(false)
		// The row of the frame the cursor was left on.
		let row = 0
		for {
			// A frame taller or wider than the window would scroll it or
			// wrap, and leave the redraw nowhere to go back to: only the
			// lines around the row in focus are written, each cut to the
			// window's columns.
			let size = terminal.size()
			shown.fit(size is none ?? (0, size.columns))
			let lines = shown.frame()
			let (cursorRow, column) = shown.cursor()
			if !(size is none) {
				let (first, past) = windowOf(lines.len(), shown.focus(), size.rows - 1)
				lines = lines[first:past].clone()
				cursorRow -= first when cursorRow >= 0
				for let (i, line) in lines {
					lines[i] = clipped(line, size.columns)
				}
			}
			let out = backTo(row) + lines.join("\r\n")
			row = lines.len() - 1
			if cursorRow < 0 {
				out += "\u001b[?25l"
			} else {
				out += "\u001b[?25h" + rise(row - cursorRow) + "\r" + (column > 0 ?? ("\u001b[{column}C", ""))
				row = cursorRow
			}
			try os.stdout.write(out.bytes())
			let failure ?error = none
			let event = terminal.readEvent() onerror (err error) {
				failure = err
				recover terminal.Event{}
			}
			if failure is none && event.kind != terminal.EventKind.Key {
				// A resized window is drawn again; a paste goes into the
				// text being typed.
				shown.insert(event.text) when event.kind == terminal.EventKind.Paste && shown is Pasting
				continue
			}
			let key = event.key
			// Ctrl+D ends text of several lines; everywhere else it is a
			// way out, like Ctrl+C.
			let ways = shown is Multiline ?? ("c", "cd")
			let left = failure is none && (key.code == KeyCode.Escape || key.code == KeyCode.Char && key.ctrl && key.text != "" && ways.contains(key.text))
			if left || !(failure is none) {
				os.stdout.write("{backTo(row)}\u001b[?25h".bytes()) onerror recover 0
				fail failure unless failure is none
				fail Cancelled{message: "cancelled", code: "Cancelled"}
			}
			break when shown.handle(key)
		}
		try os.stdout.write("{backTo(row)}\u001b[?25h{shown.summary()}\r\n".bytes())
		return none
	}

	// The sequence that takes the cursor from a row of the frame to the
	// start of its first line and clears from there down.
	internal def backTo(row int) string {
		return rise(row) + "\r\u001b[J"
	}

	internal def rise(rows int) string {
		return rows > 0 ?? ("\u001b[{rows}A", "")
	}
}
