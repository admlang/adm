partial module std.cli.prompts {
	use (
		std.cli.prompts.views::*
		std.cli.terminal::(Key, KeyCode)
		std.cli.pty
		std.os
		std.testing
	)

	check "Prompts" {
		def typedKey(text string) Key {
			return Key{code: KeyCode.Char, text: text}
		}

		def pressed(code KeyCode) Key {
			return Key{code: code}
		}

		// Feeds text to a view a character at a time.
		def typeInto(shown View, text string) {
			for let (_, ch) in text {
				shown.handle(typedKey(string(ch)))
			}
		}

		@test()
		def TestTextIsTypedAndEdited() {
			let line = new TextView("Name", "", none)
			typeInto(line, "helo")
			assert line.frame().join("|") == "? Name › helo"
			let (row, column) = line.cursor()
			assert row == 0 && column == "? Name › helo".len()
			line.handle(pressed(KeyCode.Left))
			line.handle(typedKey("l"))
			assert line.typed == "hello" && line.at == 4
			line.handle(pressed(KeyCode.Home))
			line.handle(pressed(KeyCode.Delete))
			assert line.typed == "ello"
			line.handle(pressed(KeyCode.End))
			line.handle(pressed(KeyCode.Backspace))
			assert line.typed == "ell"
			line.handle(Key{code: KeyCode.Char, text: "a", ctrl: true})
			line.handle(typedKey("w"))
			assert line.typed == "well"
			line.handle(pressed(KeyCode.Right))
			line.handle(Key{code: KeyCode.Char, text: "k", ctrl: true})
			assert line.typed == "we"
			line.handle(Key{code: KeyCode.Char, text: "u", ctrl: true})
			assert line.typed == "" && line.at == 0
			typeInto(line, "żółw")
			assert line.at == 4
			let wide = new TextView("名前", "", none)
			typeInto(wide, "田中a")
			let (_, wideColumn) = wide.cursor()
			assert wideColumn == 4 + 5 + 5
			assert line.handle(pressed(KeyCode.Enter))
			assert line.value == "żółw"
			assert line.summary() == "✔ Name › żółw"
		}

		@test()
		def TestTextFallsBackAndValidates() {
			let plain = new TextView("Port", "8080", none)
			assert plain.frame().join("|") == "? Port › 8080"
			assert plain.handle(pressed(KeyCode.Enter)) && plain.value == "8080"
			let checked = new TextView("Port", "", (text string) => text.isNumeric() ?? ("", "a number, please"))
			typeInto(checked, "x")
			assert !checked.handle(pressed(KeyCode.Enter))
			assert checked.frame().join("|") == "? Port › x|  ✖ a number, please"
			checked.handle(pressed(KeyCode.Backspace))
			assert checked.frame().len() == 1
			typeInto(checked, "9")
			assert checked.handle(pressed(KeyCode.Enter)) && checked.value == "9"
		}

		@test()
		def TestSecretIsMaskedAndPasteGoesIn() {
			let line = new TextView("Token", "", none)
			line.masked = true
			typeInto(line, "ab")
			line.insert("cd\nrest")
			assert line.typed == "abcd" && line.at == 4
			assert line.frame().join("|") == "? Token › ••••"
			let (_, column) = line.cursor()
			assert column == "? Token › ".len() + 4
			assert line.handle(pressed(KeyCode.Enter))
			assert line.summary() == "✔ Token › ••••" && line.value == "abcd"
		}

		@test()
		def TestDates() !none {
			assert readsAsDate("2026-09-03") && readsAsDate("2026-09-03T14:05:09Z") && !readsAsDate("tomorrow")
			assert (try readDate("2026-09-03")).year() == 2026
			return none
		}

		@test()
		def TestFilePickerWalksFolders() !none {
			let root = try os.resolve("{try os.appHome()}/picker")
			try os.mkdir(root + "/sub", true)
			try os.writeFile(root + "/b.txt", "b".bytes())
			try os.writeFile(root + "/sub/a.txt", "a".bytes())
			let picker = new FileView("File", root)
			let first = picker.frame()
			assert first[1] == "  " + root
			assert first[2:].join("|") == "❯ ..|  sub/|  b.txt"
			picker.handle(pressed(KeyCode.Down))
			assert !picker.handle(pressed(KeyCode.Enter))
			assert picker.folder == root + "/sub"
			assert picker.frame()[2:].join("|") == "❯ ..|  a.txt"
			picker.handle(pressed(KeyCode.Down))
			assert picker.handle(pressed(KeyCode.Enter))
			assert picker.value == root + "/sub/a.txt"
			assert picker.summary() == "✔ File › " + root + "/sub/a.txt"
			// Up again from the sub folder.
			let back = new FileView("File", root + "/sub")
			assert !back.handle(pressed(KeyCode.Enter)) && back.folder == root
			try os.remove(root, true)
			return none
		}

		@test()
		def TestConfirm() {
			let yes = new ConfirmView("Deploy", true)
			assert yes.frame().join("|") == "? Deploy › Y/n"
			assert !yes.handle(typedKey("x"))
			assert yes.handle(pressed(KeyCode.Enter)) && yes.value
			assert yes.summary() == "✔ Deploy › yes"
			let no = new ConfirmView("Deploy", true)
			assert no.handle(typedKey("N")) && !no.value
			let other = new ConfirmView("Deploy", false)
			assert other.frame().join("|") == "? Deploy › y/N"
			assert other.handle(typedKey("y")) && other.value
			let (row, _) = other.cursor()
			assert row == -1
		}

		@test()
		def TestListMovesAndChooses() {
			let list = new ListView("Kind", ["app", "library", "plugin"], 1, false, [])
			assert list.frame().join("|") == "? Kind › ↑↓ to move, enter to choose, type to narrow|  app|❯ library|  plugin"
			list.handle(pressed(KeyCode.Down))
			list.handle(pressed(KeyCode.Down))
			assert list.at == 0
			list.handle(pressed(KeyCode.Up))
			assert list.at == 2
			assert list.handle(pressed(KeyCode.Enter)) && list.value == 2
			assert list.summary() == "✔ Kind › plugin"
		}

		@test()
		def TestListNarrowsAsItIsTyped() {
			let list = new ListView("Kind", ["app", "library", "plugin"], 0, false, [])
			typeInto(list, "L")
			assert list.frame().join("|") == "? Kind › L|❯ library|  plugin"
			typeInto(list, "u")
			assert list.frame().join("|") == "? Kind › Lu|❯ plugin"
			typeInto(list, "x")
			assert list.frame().join("|") == "? Kind › Lux|  nothing matches"
			assert !list.handle(pressed(KeyCode.Enter))
			list.handle(pressed(KeyCode.Backspace))
			assert list.handle(pressed(KeyCode.Enter)) && list.value == 2
		}

		@test()
		def TestLongListScrolls() {
			let names string[] = []
			for let i = 1; i <= 12; i++ {
				names.push("item {i}")
			}
			let list = new ListView("Pick", names, 0, false, [])
			let first = list.frame()
			assert first.len() == 10 && first[1] == "❯ item 1" && first[9] == "  … 4 more"
			list.handle(pressed(KeyCode.PageDown))
			assert list.at == 8 && list.top == 1
			list.handle(pressed(KeyCode.End))
			let last = list.frame()
			assert last.len() == 9 && last[1] == "  item 5" && last[8] == "❯ item 12"
			list.handle(pressed(KeyCode.Home))
			assert list.top == 0
			list.handle(pressed(KeyCode.Up))
			assert list.at == 11 && list.top == 4
		}

		@test()
		def TestManyArePicked() {
			let list = new ListView("Add", ["tests", "docs", "ci"], 0, true, ["ci"])
			assert list.frame().join("|") == "? Add › ↑↓ to move, space to pick, enter to accept, type to narrow|❯ ◯ tests|  ◯ docs|  ◉ ci"
			list.handle(typedKey(" "))
			list.handle(pressed(KeyCode.Down))
			list.handle(pressed(KeyCode.Down))
			list.handle(typedKey(" "))
			assert list.values().join(",") == "tests"
			typeInto(list, "do")
			list.handle(typedKey(" "))
			assert list.handle(pressed(KeyCode.Enter))
			assert list.values().join(",") == "tests,docs"
			assert list.summary() == "✔ Add › tests, docs"
		}

		@test()
		def TestAnswersReadAsLines() !none {
			assert try readConfirm(" Yes ", false)
			assert !(try readConfirm("n", true))
			assert try readConfirm("", true)
			assert (try readChoice("Library", ["app", "library"], 0)) == 1
			assert (try readChoice("1", ["app", "library"], 1)) == 0
			assert (try readChoice("", ["app", "library"], 1)) == 1
			assert (try readChoices("ci, 1", ["tests", "docs", "ci"], [])).join(",") == "tests,ci"
			assert (try readChoices("", ["tests", "docs", "ci"], ["docs"])).join(",") == "docs"
			let messages string[] = []
			readConfirm("maybe", false) onerror (err error) {
				messages.push(err.message)
				recover false
			}
			readChoice("3", ["app", "library"], 0) onerror (err error) {
				messages.push(err.message)
				recover 0
			}
			readChoices("tests,none", ["tests"], []) onerror (err error) {
				messages.push(err.message)
				recover []
			}
			assert messages.join(" | ") == "'maybe' is not yes or no | '3' is not one of app, library | 'none' is not one of tests"
			return none
		}

		@test()
		def TestProgressLine() {
			assert progressLine("Copy", 0, 4, 8) == "Copy ──────── 0% 0/4"
			assert progressLine("Copy", 1, 4, 8) == "Copy ━━────── 25% 1/4"
			assert progressLine("Copy", 9, 4, 8) == "Copy ━━━━━━━━ 100% 4/4"
			assert progressLine("Copy", -1, 0, 4) == "Copy ──── 0% 0/1"
		}

		@test()
		def TestQuestionAsALine() {
			assert plainQuestion("Name", "") == "Name: "
			assert plainQuestion("Deploy", "y/N") == "Deploy (y/N): "
		}

		def held(letter string) Key {
			return Key{code: KeyCode.Char, text: letter, ctrl: true}
		}

		@test()
		def TestTextOfSeveralLines() {
			let text = new LinesView("Notes", "nothing")
			assert text.frame().join("|") == "? Notes › enter for a new line, ctrl+d to end|  nothing"
			typeInto(text, "ab")
			assert !text.handle(pressed(KeyCode.Enter))
			typeInto(text, "cd")
			assert text.lines.join("|") == "ab|cd" && text.lineCount() == 2
			let (row, column) = text.cursor()
			assert row == 2 && column == 4 && text.focus() == 2
			text.handle(pressed(KeyCode.Up))
			text.handle(pressed(KeyCode.Home))
			typeInto(text, "x")
			text.handle(pressed(KeyCode.End))
			text.handle(pressed(KeyCode.Right))
			assert text.row == 1 && text.at == 0
			// Backspace at the start of a line joins it to the one above.
			text.handle(pressed(KeyCode.Backspace))
			assert text.lines.join("|") == "xabcd" && text.row == 0 && text.at == 3
			text.handle(pressed(KeyCode.Enter))
			text.handle(pressed(KeyCode.Left))
			text.handle(pressed(KeyCode.Delete))
			assert text.lines.join("|") == "xabcd"
			text.insert(" one\r\ntwo\nthree ")
			assert text.lines.join("|") == "xab one|two|three cd" && text.row == 2 && text.at == 6
			text.handle(held("k"))
			assert text.lines[2] == "three "
			assert text.handle(held("d"))
			assert text.value == "xab one\ntwo\nthree "
			assert text.summary() == "✔ Notes › xab one … 2 more lines"
			let blank = new LinesView("Notes", "nothing")
			assert blank.handle(held("d")) && blank.value == "nothing"
		}

		@test()
		def TestFilePickerLeavesOutWhatIsNotAskedFor() !none {
			let root = try os.resolve("{try os.appHome()}/filtered")
			try os.mkdir(root + "/sub", true)
			try os.mkdir(root + "/.git", true)
			try os.writeFile(root + "/a.txt", "a".bytes())
			try os.writeFile(root + "/b.PNG", "b".bytes())
			try os.writeFile(root + "/.env", "c".bytes())
			assert new FileView("File", root).frame()[2:].join("|") == "❯ ..|  sub/|  a.txt|  b.PNG"
			assert new FileView("File", root, [".png", "jpg"]).frame()[2:].join("|") == "❯ ..|  sub/|  b.PNG"
			assert new FileView("File", root, [], true).frame()[2:].join("|") == "❯ ..|  .git/|  sub/|  .env|  a.txt|  b.PNG"
			try os.remove(root, true)
			return none
		}

		@test()
		def TestTheRowsOfAFrameAShortWindowShows() {
			let (first, past) = windowOf(10, 9, 4)
			assert first == 6 && past == 10
			(first, past) = windowOf(10, 0, 4)
			assert first == 0 && past == 4
			(first, past) = windowOf(10, 5, 4)
			assert first == 3 && past == 7
			(first, past) = windowOf(3, 2, 5)
			assert first == 0 && past == 3
			(first, past) = windowOf(3, 2, 0)
			assert first == 0 && past == 3
			let list = new ListView("Kind", ["app", "library", "plugin"], 0, false, [])
			list.handle(pressed(KeyCode.Down))
			list.handle(pressed(KeyCode.Down))
			assert list.focus() == 3
			typeInto(list, "zzz")
			assert list.focus() == 0
		}

		@test()
		def TestTheCursorStepsOverWhatIsDrawnAsOne() {
			let coder = string(char(0x1F469)) + string(char(0x200D)) + string(char(0x1F4BB))
			let accented = "e" + string(char(0x0301))
			assert stops("a" + coder + accented + "b").join(",") == "0,1,4,6,7"
			assert stops("").join(",") == "0" && stops("ab").join(",") == "0,1,2"
			let line = new TextView("Name", "", none)
			line.insert("a" + coder + "b")
			line.handle(pressed(KeyCode.Left))
			line.handle(pressed(KeyCode.Left))
			assert line.at == 1
			line.handle(pressed(KeyCode.Right))
			assert line.at == 4
			line.handle(pressed(KeyCode.Backspace))
			assert line.typed == "ab" && line.at == 1
			line.insert(coder)
			line.handle(pressed(KeyCode.Home))
			line.handle(pressed(KeyCode.Right))
			line.handle(pressed(KeyCode.Delete))
			assert line.typed == "ab"
		}

		@test()
		def TestALineLongerThanTheWindowShowsTheStretchAroundTheCursor() {
			let line = new TextView("N", "", none)
			line.fit(16)
			// The label takes 6 columns and the last one stays free: 9 for text.
			line.insert("0123456789abcdef")
			assert line.frame()[0] == "? N › 789abcdef"
			let (_, column) = line.cursor()
			assert column == 15
			line.handle(pressed(KeyCode.Home))
			assert line.frame()[0] == "? N › 012345678"
			let (_, start) = line.cursor()
			assert start == 6
			let text = new LinesView("N", "")
			text.fit(8)
			text.insert("0123456789\nab")
			assert text.frame()[1:].join("|") == "  01234|  ab"
			text.handle(pressed(KeyCode.Up))
			text.handle(pressed(KeyCode.End))
			assert text.frame()[1:].join("|") == "  56789|  "
			let (row, at) = text.cursor()
			assert row == 1 && at == 7
		}

		@test()
		def TestAStyledLineCutToTheWindow() {
			assert clipped("plain text", 0) == "plain text" && clipped("short", 80) == "short"
			assert clipped("0123456789", 4) == "0123"
			assert clipped("\u001b[1mbold text\u001b[22m!", 6) == "\u001b[1mbold t\u001b[22m"
			assert clipped("\u001b]8;;https://x.test\u0007link here\u001b]8;;\u0007", 4) == "\u001b]8;;https://x.test\u0007link\u001b]8;;\u0007"
			assert clipped("日本語", 5) == "日本"
		}
	}

	check "Prompts on a pseudo-terminal" {
		// Text as it reads on screen: without the sequences that style it
		// and move the cursor.
		def visible(text string) string {
			let out = ""
			let state = 0
			for let (_, ch) in text {
				let code = int(ch)
				if state == 0 {
					if code == 0x1b {
						state = 1
					} else {
						out += string(ch)
					}
				} else if state == 1 {
					state = code == 0x5b ?? (2, 0)
				} else if code >= 0x40 && code <= 0x7e {
					state = 0
				}
			}
			return out
		}

		// The longest line a drawing holds, in characters.
		def widest(drawn string) int {
			let most = 0
			for let (_, line) in visible(drawn).replace("\r", "\n").split("\n") {
				most = line.len() when line.len() > most
			}
			return most
		}

		@test()
		def TestALineIsAskedForAndAnswered() !none {
			let screen = try pty.open()
			defer screen.close()
			screen.pressWhenRaw("Adx\u007fa\r")
			assert (try ask("Name", "nobody")) == "Ada"
			let drawn = visible(screen.output())
			assert drawn.contains("? Name › nobody") && drawn.endsWith("✔ Name › Ada\r\n")
			assert screen.isCooked()
			screen.pressWhenRaw("\r")
			assert (try ask("Name", "nobody")) == "nobody"
			screen.pressWhenRaw("x\r\u007f7\r")
			assert (try ask("Port", "", (text string) => text.isNumeric() ?? ("", "a number, please"))) == "7"
			assert visible(screen.output()).contains("✖ a number, please")
			return none
		}

		@test()
		def TestLeavingAQuestion() !none {
			let screen = try pty.open()
			defer screen.close()
			let message = ""
			let left = false
			screen.pressWhenRaw("ab\u0003")
			ask("Name") onerror (err error) {
				message = err.message
				left = err is Cancelled
				recover ""
			}
			assert left && message == "cancelled" && screen.isCooked()
			screen.pressWhenRaw("\u001b")
			left = false
			confirm("Sure") onerror (err error) {
				left = err is Cancelled
				recover false
			}
			assert left
			return none
		}

		@test()
		def TestChoicesAndYesOrNo() !none {
			let screen = try pty.open()
			defer screen.close()
			screen.pressWhenRaw("\u001b[B\u001b[B\r")
			assert (try choose("Kind", ["app", "library", "plugin"])) == "plugin"
			screen.pressWhenRaw("lib\r")
			assert (try choose("Kind", ["app", "library", "plugin"])) == "library"
			screen.pressWhenRaw(" \u001b[B\u001b[B \r")
			assert (try chooseMany("Add", ["tests", "docs", "ci"])).join(",") == "tests,ci"
			screen.pressWhenRaw("y")
			assert try confirm("Create")
			screen.pressWhenRaw("\r")
			assert !(try confirm("Create"))
			let drawn = visible(screen.output())
			assert drawn.contains("✔ Kind › plugin") && drawn.contains("✔ Add › tests, ci") && drawn.contains("✔ Create › yes")
			return none
		}

		@test()
		def TestSeveralLinesAndWhatMustNotShow() !none {
			let screen = try pty.open()
			defer screen.close()
			screen.pressWhenRaw("ab\rcd\u001b[200~x\ny\u001b[201~\u0004")
			assert (try text("Notes")) == "ab\ncdx\ny"
			assert visible(screen.output()).endsWith("✔ Notes › ab … 2 more lines\r\n")
			screen.pressWhenRaw("hunter2\r")
			let word = try secret("Token")
			assert word.reveal() == "hunter2"
			let drawn = visible(screen.output())
			assert !drawn.contains("hunter2") && drawn.contains("•••••••")
			return none
		}

		@test()
		def TestAWindowTooSmallForTheFrame() !none {
			let screen = try pty.open(20, 5)
			defer screen.close()
			let names string[] = []
			for let i = 0; i < 30; i++ {
				names.push("a rather long choice number {i}")
			}
			screen.pressWhenRaw("\u001b[B\u001b[B\r")
			assert (try choose("Pick one of these", names, 6)) == names[8]
			let drawn = screen.output()
			// No frame taller than the window less a row, no line wider than it.
			for let (_, frame) in drawn.split("\u001b[J") {
				assert frame.split("\r\n").len() <= 4
			}
			assert widest(drawn.replace(visible("✔ Pick one of these › " + names[8]), "")) <= 20 || widest(drawn.split("✔")[0]) <= 20
			screen.pressWhenRaw("0123456789012345678901234567890123456789\r")
			assert (try ask("N")).len() == 40
			let typed = screen.output()
			assert widest(typed.split("✔")[0]) <= 20
			return none
		}

		@test()
		def TestSpinnerAndBarWithLinesAboveThem() !none {
			let screen = try pty.open()
			defer screen.close()
			let work = spinner("Working")
			work.log("step one")
			work.done("Finished")
			let bar = progress("Copying", 4)
			bar.advance()
			bar.log("copied a")
			bar.advance(3)
			bar.done()
			let drawn = visible(screen.output())
			assert drawn.contains("step one\r\n") && drawn.contains("✔ Finished\r\n")
			assert drawn.contains("copied a\r\n") && drawn.contains("25% 1/4") && drawn.contains("100% 4/4") && drawn.endsWith("✔ Copying\r\n")
			return none
		}
	}
}
