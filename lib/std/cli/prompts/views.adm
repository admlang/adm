// The prompts as state: what a prompt holds, how a key changes it and the
// lines it shows, apart from any terminal, plus the reading of answers that
// arrive as lines when there is none.
internal partial module std.cli.prompts.views {
	use (
		std.cli.terminal
		std.cli.terminal::(Key, KeyCode)
		std.os
		std.text.unicode
	)

	// How many choices a list shows at once.
	const listRows = 8

	// View is a prompt on screen.
	interface View {
		// Takes a key and reports whether the prompt is answered.
		def handle(key Key) bool
		// Returns the lines to show, styled.
		def frame() string[]
		// Returns the line that stays once the prompt is answered.
		def summary() string
		// Returns where the text cursor goes: the row among the frame's
		// lines and the column on it, or a row of -1 for no cursor.
		def cursor() (int, int)
		// Returns the row of the frame that must stay in sight when the
		// window is too short for all of it.
		def focus() int
		// Tells the view how many columns the window has, before each
		// frame; 0 when nobody knows. A view that takes text keeps the
		// cursor in sight with it.
		def fit(columns int)
	}

	// The views that take Ctrl+D as their own key instead of a way out.
	interface Multiline {
		def lineCount() int
	}

	// The places in text where a cursor may stand: before each character
	// that takes a place of its own on screen, and after the last. An emoji
	// made of several characters, and a letter with its accents, are one
	// place.
	def stops(text string) int[] {
		let out = [0]
		let before = 0
		let past = 0
		for let (i, ch) in text {
			let width = unicode.displayWidth(text[0:i + 1])
			out.push(i) when width > before && i > 0 && int(ch) != 0xFE0F
			before = width
			past = i + 1
		}
		out.push(past) when past > 0
		return out
	}

	// The stop before at; 0 at the start.
	def stopBefore(text string, at int) int {
		let found = 0
		for let (_, stop) in stops(text) {
			found = stop when stop < at
		}
		return found
	}

	// The stop after at; the end of the text at its end.
	def stopAfter(text string, at int) int {
		for let (_, stop) in stops(text) {
			return stop when stop > at
		}
		return text.len()
	}

	// Where a line being typed starts on screen so that the cursor at at
	// is within room columns of it: first, moved as little as that takes.
	def scrolled(text string, first int, at int, room int) int {
		return 0 when room <= 0
		let out = first > at ?? (at, first)
		for out < at && unicode.displayWidth(text[out:at]) > room {
			out = stopAfter(text, out)
		}
		return out
	}

	// The start of text that fits room columns, cut between two stops.
	def fitted(text string, room int) string {
		return text when room <= 0 || unicode.displayWidth(text) <= room
		let end = 0
		for let (_, stop) in stops(text) {
			break when unicode.displayWidth(text[0:stop]) > room
			end = stop
		}
		return text[0:end]
	}

	// A styled line cut to the window's columns, so that it never wraps:
	// the characters past the last column are left out, the sequences that
	// style the line are all kept, so what was opened is closed.
	def clipped(line string, columns int) string {
		return line when columns <= 0 || line.len() <= columns / 2
		let out = ""
		let used = 0
		// 0 outside a sequence, 1 after ESC, 2 in a CSI sequence, 3 in an
		// OSC one, 4 after an ESC inside an OSC one.
		let state = 0
		for let (_, ch) in line {
			let code = int(ch)
			if state == 0 && code != 0x1b {
				let width = unicode.displayWidth(ch)
				continue when used + width > columns
				used += width
				out += string(ch)
				continue
			}
			out += string(ch)
			if state == 0 {
				state = 1
			} else if state == 1 {
				state = code == 0x5b ?? (2, code == 0x5d ?? (3, 0))
			} else if state == 2 {
				state = 0 when code >= 0x40 && code <= 0x7e
			} else if state == 3 {
				state = code == 0x07 ?? (0, code == 0x1b ?? (4, 3))
			} else {
				state = 0
			}
		}
		return out
	}

	// The part of a frame of lines that a window of room rows shows: the
	// first row shown and one past the last, around the row in focus.
	def windowOf(lines int, focus int, room int) (int, int) {
		return (0, lines) when room < 1 || lines <= room
		let first = focus - room / 2
		first = 0 when first < 0
		first = lines - room when first + room > lines
		return (first, first + room)
	}

	// The views that take text typed, which a paste goes into.
	interface Pasting {
		def insert(text string)
	}

	// The mark, label and separator every prompt line starts with, and the
	// number of columns they take.
	def opening(mark string, label string) (string, int) {
		return ("{mark} {terminal.emphasis(label)} {terminal.dim("›")} ", unicode.displayWidth(label) + 5)
	}

	def answered(label string, answer string) string {
		let (lead, _) = opening(terminal.success("✔"), label)
		return lead + terminal.dim(answer)
	}

	// TextView is a line being typed.
	type TextView {
		label    string
		fallback string
		// Returns what is wrong with a value, or "" when it will do.
		validate ?def (string) string
		typed    string
		// Where the next character goes, counted in characters.
		at       int
		problem  string
		value    string
		// Whether a dot is shown for each character in place of it.
		masked   bool
		// The window's columns, and the first character of the line shown
		// when it is too long for them.
		columns  int
		first    int

		def new(label string, fallback string, validate ?def (string) string) {
			self.label = label
			self.fallback = fallback
			self.validate = validate
		}

		def handle(key Key) bool {
			problem = ""
			match key.code {
				case KeyCode.Enter:
					let entered = typed == "" ?? (fallback, typed)
					let rule = validate
					problem = rule(entered) unless rule is none
					return false unless problem == ""
					value = entered
					return true
				case KeyCode.Backspace:
					if at > 0 {
						let from = stopBefore(typed, at)
						typed = typed[0:from] + typed[at:]
						at = from
					}
				case KeyCode.Delete:
					typed = typed[0:at] + typed[stopAfter(typed, at):] when at < typed.len()
				case KeyCode.Left:
					at = stopBefore(typed, at)
				case KeyCode.Right:
					at = stopAfter(typed, at)
				case KeyCode.Home:
					at = 0
				case KeyCode.End:
					at = typed.len()
				case KeyCode.Char:
					edit(key)
				default:
					return false
			}
			return false
		}

		// A character typed, or one of the line-editing control keys.
		internal def edit(key Key) {
			if key.ctrl {
				if key.text == "a" {
					at = 0
				} else if key.text == "e" {
					at = typed.len()
				} else if key.text == "u" {
					typed = typed[at:]
					at = 0
				} else if key.text == "k" {
					typed = typed[0:at]
				}
				return
			}
			return when key.alt
			typed = typed[0:at] + key.text + typed[at:]
			at += key.text.len()
		}

		def frame() string[] {
			let (lead, taken) = opening(terminal.prompt("?"), label)
			let shown = masked ?? ("•".repeat(typed.len()), typed)
			// A line too long for the window shows the stretch around the
			// cursor.
			let room = columns > taken + 1 ?? (columns - taken - 1, 0)
			first = scrolled(shown, first, at, room)
			shown = fitted(shown[first:], room)
			shown = terminal.dim(fallback) when typed == "" && fallback != ""
			let lines = [lead + shown]
			lines.push("  " + terminal.failure("✖ " + problem)) unless problem == ""
			return lines
		}

		def summary() string {
			return answered(label, masked ?? ("•".repeat(value.len()), value))
		}

		def cursor() (int, int) {
			let (_, width) = opening("?", label)
			return (0, width + (masked ?? (at - first, unicode.displayWidth(typed[first:at]))))
		}

		def focus() int {
			return 0
		}

		def fit(columns int) {
			self.columns = columns
		}

		// Text arriving at once, as from a paste: its first line goes in at
		// the cursor.
		def insert(text string) {
			let line = text.split("\n")[0].trimEnd("\r")
			typed = typed[0:at] + line + typed[at:]
			at += line.len()
			problem = ""
		}
	}

	// ConfirmView is a yes-or-no question.
	type ConfirmView {
		label    string
		fallback bool
		value    bool

		def new(label string, fallback bool) {
			self.label = label
			self.fallback = fallback
		}

		def handle(key Key) bool {
			if key.code == KeyCode.Enter {
				value = fallback
				return true
			}
			return false unless key.code == KeyCode.Char && !key.ctrl
			let letter = key.text.lower()
			return false unless letter := "y" || "n"
			value = letter == "y"
			return true
		}

		def frame() string[] {
			let (lead, _) = opening(terminal.prompt("?"), label)
			return [lead + terminal.dim(fallback ?? ("Y/n", "y/N"))]
		}

		def summary() string {
			return answered(label, value ?? ("yes", "no"))
		}

		def cursor() (int, int) {
			return (-1, 0)
		}

		def focus() int {
			return 0
		}

		def fit(columns int) {}
	}

	// ListView is one choice, or several, picked from a list that typing
	// narrows.
	type ListView {
		label   string
		choices string[]
		many    bool
		// Which choices are picked, by index; only with many.
		picked  bool[]
		// The text typed to narrow the list.
		filter  string
		// The indexes of the choices the filter leaves.
		shown   int[]
		// The position in shown the marker is on, and the first one drawn.
		at      int
		top     int
		// The index of the single choice made.
		value   int

		def new(label string, choices string[], initial int, many bool, chosen string[]) {
			self.label = label
			self.choices = choices
			self.many = many
			picked = []
			for let (_, choice) in choices {
				picked.push(chosen.includes(choice))
			}
			narrow()
			at = initial when initial > 0 && initial < choices.len()
			scroll()
		}

		// The picked choices, in the order they are listed.
		def values() string[] {
			let out string[] = []
			for let (i, choice) in choices {
				out.push(choice) when picked[i]
			}
			return out
		}

		internal def narrow() {
			shown = []
			let wanted = filter.lower()
			for let (i, choice) in choices {
				shown.push(i) when wanted == "" || choice.lower().contains(wanted)
			}
			at = 0
			top = 0
		}

		internal def scroll() {
			top = at when at < top
			top = at - listRows + 1 when at >= top + listRows
		}

		def handle(key Key) bool {
			match key.code {
				case KeyCode.Enter:
					return true when many
					return false when shown.len() == 0
					value = shown[at]
					return true
				case KeyCode.Up:
					at = at == 0 ?? (shown.len() - 1, at - 1) when shown.len() > 0
				case KeyCode.Down:
					at = at + 1 >= shown.len() ?? (0, at + 1) when shown.len() > 0
				case KeyCode.Home:
					at = 0
				case KeyCode.End:
					at = shown.len() - 1 when shown.len() > 0
				case KeyCode.PageUp:
					at = at < listRows ?? (0, at - listRows)
				case KeyCode.PageDown:
					at = at + listRows >= shown.len() ?? (shown.len() - 1, at + listRows) when shown.len() > 0
				case KeyCode.Backspace:
					if filter != "" {
						filter = filter[0:filter.len() - 1]
						narrow()
					}
				case KeyCode.Char:
					return false when key.ctrl || key.alt
					if many && key.text == " " {
						picked[shown[at]] = !picked[shown[at]] when shown.len() > 0
						return false
					}
					filter += key.text
					narrow()
				default:
					return false
			}
			scroll()
			return false
		}

		def frame() string[] {
			let (lead, _) = opening(terminal.prompt("?"), label)
			let hint = many ?? ("space to pick, enter to accept", "enter to choose")
			let lines = [lead + (filter == "" ?? (terminal.dim("↑↓ to move, {hint}, type to narrow"), filter))]
			lines.push("  " + terminal.dim("nothing matches")) when shown.len() == 0
			for let row = top; row < shown.len() && row < top + listRows; row++ {
				let index = shown[row]
				let name = choices[index]
				let box = ""
				box = picked[index] ?? (terminal.success("◉") + " ", terminal.dim("◯") + " ") when many
				if row == at {
					lines.push("{terminal.prompt("❯")} {box}{terminal.emphasis(name)}")
				} else {
					lines.push("  {box}{name}")
				}
			}
			let more = shown.len() - top - listRows
			lines.push("  " + terminal.dim("… {more} more")) when more > 0
			return lines
		}

		def summary() string {
			return answered(label, values().join(", ")) when many
			return answered(label, choices[value])
		}

		def cursor() (int, int) {
			return (-1, 0)
		}

		def focus() int {
			return shown.len() == 0 ?? (0, 1 + at - top)
		}

		def fit(columns int) {}
	}

	// FileView is a file picked by walking folders: Enter on a folder opens
	// it, on a file takes it.
	type FileView {
		label      string
		// The folder being shown, absolute.
		folder     string
		list       ListView
		// Which entries of the list are folders, by index.
		isDir      bool[]
		// The path taken.
		value      string
		// Why the folder last asked for could not be read.
		problem    string
		// The extensions a file must have one of to be listed, in lower
		// case without the dot; empty for every file.
		extensions string[]
		// Whether entries whose names start with a dot are listed.
		hidden     bool

		def new(label string, folder string, extensions string[] = [], hidden bool = false) {
			self.label = label
			self.hidden = hidden
			self.extensions = []
			for let (_, extension) in extensions {
				self.extensions.push(extension.trimPrefix(".").lower())
			}
			open(folder)
		}

		// Shows a folder: `..` unless it is the root, then its folders and
		// the files that pass the filter, each in name order.
		def open(path string) {
			let failure = ""
			let entries = os.readDir(path) onerror (err error) {
				failure = err.message
				recover []
			}
			if failure != "" {
				problem = failure
				return
			}
			problem = ""
			folder = path
			let names string[] = []
			isDir = []
			if os.dir(path) != path {
				names.push("..")
				isDir.push(true)
			}
			entries.sort((a, b) => a.info.isDir == b.info.isDir ?? (a.info.name.lower().compare(b.info.name.lower()), a.info.isDir ?? (-1, 1)))
			for let (_, entry) in entries {
				let name = entry.info.name
				continue when name.startsWith(".") && !hidden
				continue unless entry.info.isDir || extensions.len() == 0 || extensions.includes(os.extension(name).lower())
				names.push(entry.info.isDir ?? (name + "/", name))
				isDir.push(entry.info.isDir)
			}
			list = new ListView(label, names, 0, false, [])
		}

		def handle(key Key) bool {
			problem = ""
			return false unless list.handle(key)
			let name = list.choices[list.value].trimSuffix("/")
			let path = name == ".." ?? (os.dir(folder), os.join(folder, name))
			if isDir[list.value] {
				open(path)
				return false
			}
			value = path
			return true
		}

		def frame() string[] {
			let listed = list.frame()
			let lines = [listed[0], "  " + terminal.dim(folder)]
			let rest = listed[1:]
			lines.push(...rest)
			lines.push("  " + terminal.failure("✖ " + problem)) unless problem == ""
			return lines
		}

		def summary() string {
			return answered(label, value)
		}

		def cursor() (int, int) {
			return (-1, 0)
		}

		def focus() int {
			// The folder's line sits between the question and the list.
			return list.shown.len() == 0 ?? (0, list.focus() + 1)
		}

		def fit(columns int) {}
	}

	// The lines with one more put in at a place.
	def withLine(lines string[], at int, line string) string[] {
		let out = lines[0:at].clone()
		out.push(line)
		out.push(...lines[at:])
		return out
	}

	// LinesView is text of several lines being typed: Enter starts a new
	// line, Ctrl+D ends the text.
	type LinesView {
		label    string
		fallback string
		lines    string[]
		// The line the cursor is on, and where on it the next character
		// goes, counted in characters.
		row      int
		at       int
		value    string
		// The window's columns, and the first character shown of every
		// line when the one being typed is too long for them.
		columns  int
		first    int

		def new(label string, fallback string) {
			self.label = label
			self.fallback = fallback
			lines = [""]
		}

		def lineCount() int {
			return lines.len()
		}

		def handle(key Key) bool {
			let line = lines[row]
			match key.code {
				case KeyCode.Enter:
					lines[row] = line[0:at]
					lines = withLine(lines, row + 1, line[at:])
					row++
					at = 0
				case KeyCode.Backspace:
					if at > 0 {
						let from = stopBefore(line, at)
						lines[row] = line[0:from] + line[at:]
						at = from
					} else if row > 0 {
						at = lines[row - 1].len()
						lines[row - 1] = lines[row - 1] + line
						lines.remove(row)
						row--
					}
				case KeyCode.Delete:
					if at < line.len() {
						lines[row] = line[0:at] + line[stopAfter(line, at):]
					} else if row + 1 < lines.len() {
						lines[row] = line + lines[row + 1]
						lines.remove(row + 1)
					}
				case KeyCode.Left:
					if at > 0 {
						at = stopBefore(line, at)
					} else if row > 0 {
						row--
						at = lines[row].len()
					}
				case KeyCode.Right:
					if at < line.len() {
						at = stopAfter(line, at)
					} else if row + 1 < lines.len() {
						row++
						at = 0
					}
				case KeyCode.Up:
					row-- when row > 0
					at = lines[row].len() when at > lines[row].len()
				case KeyCode.Down:
					row++ when row + 1 < lines.len()
					at = lines[row].len() when at > lines[row].len()
				case KeyCode.Home:
					at = 0
				case KeyCode.End:
					at = line.len()
				case KeyCode.Char:
					return edit(key)
				default:
					return false
			}
			return false
		}

		// A character typed, or a control key: Ctrl+D ends the text, the
		// others edit the line as they do in a `TextView`.
		internal def edit(key Key) bool {
			let line = lines[row]
			if key.ctrl {
				if key.text == "d" {
					value = lines.join("\n")
					value = fallback when value == ""
					return true
				}
				if key.text == "a" {
					at = 0
				} else if key.text == "e" {
					at = line.len()
				} else if key.text == "u" {
					lines[row] = line[at:]
					at = 0
				} else if key.text == "k" {
					lines[row] = line[0:at]
				}
				return false
			}
			return false when key.alt
			lines[row] = line[0:at] + key.text + line[at:]
			at += key.text.len()
			return false
		}

		def frame() string[] {
			let (lead, _) = opening(terminal.prompt("?"), label)
			let out = [lead + terminal.dim("enter for a new line, ctrl+d to end")]
			let untouched = lines.len() == 1 && lines[0] == "" && fallback != ""
			// Every line starts at the same character, the one that keeps
			// the cursor's line in sight.
			let room = columns > 3 ?? (columns - 3, 0)
			first = scrolled(lines[row], first, at, room)
			for let (_, line) in untouched ?? (fallback.split("\n"), lines) {
				let part = line.len() > first ?? (fitted(line[first:], room), "")
				out.push("  " + (untouched ?? (terminal.dim(line), part)))
			}
			return out
		}

		def summary() string {
			let all = value.split("\n")
			let more = all.len() - 1
			return answered(label, all[0] + (more > 0 ?? (" … {more} more {more == 1 ?? ("line", "lines")}", "")))
		}

		def cursor() (int, int) {
			return (1 + row, 2 + unicode.displayWidth(lines[row][first:at]))
		}

		def fit(columns int) {
			self.columns = columns
		}

		def focus() int {
			return 1 + row
		}

		// Text arriving at once, as from a paste: it goes in at the cursor,
		// its line ends starting new lines.
		def insert(text string) {
			let parts = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
			let line = lines[row]
			let tail = line[at:]
			lines[row] = line[0:at] + parts[0]
			for let i = 1; i < parts.len(); i++ {
				row++
				lines = withLine(lines, row, parts[i])
			}
			at = lines[row].len()
			lines[row] = lines[row] + tail
		}
	}

	// A yes or a no read from a line: `y`, `yes`, `true`, `1`, `on` and
	// their opposites in any case; an empty line is fallback.
	//
	// Fails when the line is none of them.
	def readConfirm(line string, fallback bool) !bool {
		let word = line.trim().lower()
		return fallback when word == ""
		return true when word := "y" || "yes" || "true" || "1" || "on"
		return false when word := "n" || "no" || "false" || "0" || "off"
		fail "'{line.trim()}' is not yes or no"
	}

	// The index of the choice a line names: the choice itself in any case,
	// or its number counted from 1; an empty line is initial.
	//
	// Fails when the line names none.
	def readChoice(line string, choices string[], initial int) !int {
		let word = line.trim()
		return initial when word == "" && initial >= 0 && initial < choices.len()
		for let (i, choice) in choices {
			return i when choice.lower() == word.lower()
		}
		if /^[0-9]+$/.test(word) {
			let number = parseInt<int>(word)
			return number - 1 when number >= 1 && number <= choices.len()
		}
		fail "'{word}' is not one of {choices.join(", ")}"
	}

	// The choices a line of comma-separated names or numbers picks, in the
	// order they are listed; an empty line is chosen.
	//
	// Fails when a part names no choice.
	def readChoices(line string, choices string[], chosen string[]) !string[] {
		return chosen when line.trim() == ""
		let picked bool[] = []
		for let (_, choice) in choices {
			picked.push(false)
		}
		for let (_, part) in line.split(",") {
			picked[try readChoice(part, choices, -1)] = true unless part.trim() == ""
		}
		let out string[] = []
		for let (i, choice) in choices {
			out.push(choice) when picked[i]
		}
		return out
	}

	// A progress line: the label, a bar of width cells, the percentage and
	// the counts.
	def progressLine(label string, done int, total int, width int) string {
		let whole = total < 1 ?? (1, total)
		let reached = done < 0 ?? (0, done > whole ?? (whole, done))
		let filled = reached * width / whole
		let bar = terminal.success("━".repeat(filled)) + terminal.dim("─".repeat(width - filled))
		return "{label} {bar} {reached * 100 / whole}% {terminal.dim("{reached}/{whole}")}"
	}
}
