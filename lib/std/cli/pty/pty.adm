// A pseudo-terminal in place of the program's own, for the check suites of
// what only runs on a terminal: key reads, modes, prompts. While one is open
// the process's standard input and output are the terminal, so the code
// under test runs unchanged; the suite types into it and reads what was
// drawn. Linux only.
internal partial module std.cli.pty {
	use (
		std.cli.terminal
		std.os
		std.time
	)

	@c(symbol = "adm_term_pty_open", ret = "int32_t", params = ["int32_t", "int32_t"])
	def ptyOpen(columns int32, rows int32) int32;

	@c(symbol = "adm_term_pty_close", ret = "int32_t", params = [])
	def ptyClose() int32;

	@c(symbol = "adm_term_pty_write", ret = "int64_t", params = ["const uint8_t*", "int64_t"])
	def ptyWrite(buf byte[], n int) int;

	@c(symbol = "adm_term_pty_read", ret = "int64_t", params = ["uint8_t*", "int64_t", "int64_t"])
	def ptyRead(buf byte[], n int, timeout int) int;

	@c(symbol = "adm_term_pty_flags", ret = "int32_t", params = [])
	def ptyFlags() int32;

	@c(symbol = "adm_term_pty_resize", ret = "int32_t", params = ["int32_t", "int32_t"])
	def ptyResize(columns int32, rows int32) int32;

	// Opens a pseudo-terminal of the given size and makes it the process's
	// terminal until `Pty.close`. One at a time. After limit it is closed
	// whatever the suite is doing, so that code waiting for a key nobody
	// types fails instead of waiting for ever.
	//
	// Fails when the system has none to give, and anywhere but Linux.
	def open(columns int = 80, rows int = 24, limit duration = 10s) !Pty {
		// How many colors each standard stream shows is worked out once: it
		// must be while the streams are still what the suite was given.
		terminal.colors(os.stdout)
		terminal.colors(os.stderr)
		let refused = ptyOpen(int32(columns), int32(rows))
		fail "pty: cannot open a pseudo-terminal (error {refused})" when refused != 0
		let made = new Pty()
		async made.watch(limit)
		return made
	}

	// Pty is the near end of the pseudo-terminal: the person's side.
	type Pty {
		// Set when everything given to `pressWhenRaw` has been typed.
		atomic typed  bool
		// Set once the pseudo-terminal is closed.
		atomic closed bool

		def new() {
			typed = true
		}

		// Types keys now. With the terminal in its usual mode they are
		// edited as a line and echoed, as a terminal does.
		def press(keys string) {
			let data = keys.bytes()
			ptyWrite(data, data.len())
		}

		// Types keys once the program has put the terminal in raw mode, as
		// a person does who waits for the question: what a suite calls
		// before the call that reads keys.
		def pressWhenRaw(keys string) {
			typed = false
			async wait(keys, true)
		}

		// Types keys once the program has turned the echo off, as a person
		// does who waits for the password prompt.
		def pressWhenHidden(keys string) {
			typed = false
			async wait(keys, false)
		}

		// Closes the pseudo-terminal when limit has passed and the suite
		// has not.
		async def watch(limit duration) {
			let steps = int(limit) / int(10ms)
			for let step = 0; step < steps && !closed; step++ {
				time.sleep(10ms)
			}
			close()
		}

		internal async def wait(keys string, raw bool) {
			// Two seconds at most, so a program that never asks ends the test
			// instead of hanging it.
			for let tries = 0; tries < 2000 && (raw ?? (isCooked(), echoes())) && !closed; tries++ {
				time.sleep(1ms)
			}
			press(keys) unless closed
			typed = true
		}

		// Whether lines are edited before the program reads them: the mode
		// a terminal is in until a program asks for raw input.
		def isCooked() bool {
			return (ptyFlags() & 1) != 0
		}

		// Whether what is typed is echoed.
		def echoes() bool {
			return (ptyFlags() & 2) != 0
		}

		// Returns what the program wrote since the last call, waiting until
		// nothing more comes for quiet.
		def output(quiet duration = 20ms) string {
			let got byte[] = []
			let chunk byte[] = []
			chunk.len(4096)
			for {
				let n = ptyRead(chunk, chunk.len(), int(quiet))
				break when n <= 0
				let part = chunk[0:n]
				got.push(...part)
			}
			return string(got)
		}

		// Changes the window's size, which the program is told of.
		def resize(columns int, rows int) {
			ptyResize(int32(columns), int32(rows))
		}

		// Gives the process its own standard input and output back.
		def close() {
			return when closed
			for let tries = 0; tries < 2000 && !typed; tries++ {
				time.sleep(1ms)
			}
			closed = true
			ptyClose()
		}
	}
}
