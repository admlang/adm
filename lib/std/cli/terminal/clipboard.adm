partial module std.cli.terminal {
	use (
		std.cli.terminal.native
		std.cli.terminal.sgr::*
		std.data.encoding
		std.os
	)

	// Puts text on the system clipboard through the terminal (OSC 52), which
	// works over SSH too. Terminals may refuse, or ask the person first;
	// nothing reports back. Does nothing when standard output is not a
	// terminal.
	def copy(text string) {
		control("{esc}]52;c;{encoding.base64encode(text.bytes())}{terminator}")
	}

	// Asks the terminal for the text on the system clipboard (OSC 52) and
	// returns it; none when the program has no terminal, the terminal does
	// not answer in time, or it refuses, as most do unless the person
	// allowed it.
	def clipboard() ?string {
		return none unless isTTY(os.stdout) && isTTY(os.stdin)
		return none when native.mode(native.modeRaw, 1) != 0
		defer native.mode(native.modeRaw, 0)
		let lead = "{esc}]52;c;"
		let query = "{lead}?{terminator}".bytes()
		return none when native.write(query, query.len()) < 0
		let reply = queryReply(lead, 1 << 20)
		return none when reply == ""
		let failed = false
		let text = encoding.base64decode(reply[lead.len():]) onerror (err error) {
			failed = true
			recover []
		}
		return none when failed
		return string(text)
	}
}
