partial module std.cli.terminal {
	use std.cli.terminal.sgr::*

	// Ansi names the 16 colors of the terminal's own palette. The user's
	// terminal theme decides what each looks like, so text in these colors
	// fits any terminal. `Default` is the terminal's normal text or
	// background color.
	enum Ansi {
		Default,
		Black,
		Red,
		Green,
		Yellow,
		Blue,
		Magenta,
		Cyan,
		White,
		BrightBlack,
		BrightRed,
		BrightGreen,
		BrightYellow,
		BrightBlue,
		BrightMagenta,
		BrightCyan,
		BrightWhite,
	}

	// ColorDepth is how many colors a terminal shows; `.value` is the count.
	enum ColorDepth {
		// No colors and no text attributes: output is plain text.
		None = 0,
		// The 16 palette colors.
		Basic = 16,
		// The 256 indexed colors.
		Ansi256 = 256,
		// 24-bit color.
		TrueColor = 16777216,
	}

	// Color is a terminal color: one of the 16 palette colors, one of the 256
	// indexed colors, or a red, green and blue value. A terminal that cannot
	// show a color gets the nearest one it can.
	//
	// An `Ansi` name converts to a Color wherever one is expected.
	//
	// Example: The three kinds of color
	// ```example
	// let palette Color = Ansi.Red
	// let indexed = new Color(214)
	// let orange = new Color(255, 135, 0)
	// ```
	type Color {
		internal kind  int
		internal index int
		internal red   int
		internal green int
		internal blue  int

		// A palette color.
		@implicit
		def new(name Ansi) {
			kind = name == Ansi.Default ?? (kindDefault, kindPalette)
			index = name.ordinal - 1
		}

		// One of the 256 indexed colors: 0 to 15 are the palette, 16 to 231 a
		// 6x6x6 color cube, 232 to 255 a gray ramp. A number outside 0..255 is
		// brought into it.
		def new(index int) {
			kind = kindIndexed
			self.index = index.clamp(0, 255)
		}

		// A color from its red, green and blue parts, each 0 to 255; a part
		// outside that is brought into it.
		def new(red int, green int, blue int) {
			kind = kindRgb
			self.red = red.clamp(0, 255)
			self.green = green.clamp(0, 255)
			self.blue = blue.clamp(0, 255)
		}

		// The parameters of the escape sequence that selects this color as the
		// text color, or as the background color, on a terminal of the given
		// depth: `31`, `38;5;214`, `48;2;255;135;0`. Empty for
		// `ColorDepth.None`.
		def sgr(depth ColorDepth, background bool = false) string {
			return "" when depth == ColorDepth.None
			let base = background ?? (40, 30)
			return "{base + 9}" when kind == kindDefault
			return paletteCode(index, base) when kind == kindPalette
			if kind == kindIndexed {
				return paletteCode(index, base) when index < 16
				return "{base + 8};5;{index}" when depth != ColorDepth.Basic
				let (r, g, b) = indexedRgb(index)
				return paletteCode(nearestPalette(r, g, b), base)
			}
			return "{base + 8};2;{red};{green};{blue}" when depth == ColorDepth.TrueColor
			return "{base + 8};5;{nearestIndexed(red, green, blue)}" when depth == ColorDepth.Ansi256
			return paletteCode(nearestPalette(red, green, blue), base)
		}
	}

	// Reads a color from text, as theme files write it: a palette name
	// (`red`, `brightBlue`, `bright-blue`, `gray`, `default`; case does not
	// matter), an indexed color (`214`), or a hex value (`#5fd7ff`, `#5df`).
	//
	// Fails when the text is none of those.
	def parseColor(text string) !Color {
		let name = text.trim().lower().replace("-", "").replace("_", "").replace(" ", "")
		if name.startsWith("#") {
			let hex = name[1:]
			fail "terminal: '{text}' is not a hex color" unless /^([0-9a-f]{3}|[0-9a-f]{6})$/.test(hex)
			let wide = hex.len() == 6
			let r = parseInt<int>(wide ?? (hex[0:2], hex[0:1] + hex[0:1]), 16)
			let g = parseInt<int>(wide ?? (hex[2:4], hex[1:2] + hex[1:2]), 16)
			let b = parseInt<int>(wide ?? (hex[4:6], hex[2:3] + hex[2:3]), 16)
			return new Color(r, g, b)
		}
		if /^[0-9]{1,3}$/.test(name) {
			let index = parseInt<int>(name)
			fail "terminal: indexed color {index} is outside 0..255" when index > 255
			return new Color(index)
		}
		return new Color(Ansi.BrightBlack) when name := "gray" || "grey"
		let ordinal = paletteNames.indexOf(name)
		fail "terminal: '{text}' is not a color" when ordinal < 0
		return new Color(Ansi.Default) when ordinal == 0
		return new Color(ordinal - 1)
	}
}
