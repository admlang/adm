// What the terminal says it can do, asked of the terminal itself.
partial module std.cli.terminal {
	use (
		std.cli.terminal.keys::*
		std.cli.terminal.native
		std.cli.terminal.sgr::*
		std.os
	)

	// Feature is something a terminal may or may not do; `supports` asks.
	enum Feature {
		// The kitty keyboard protocol: `extendedKeys` and `keyReleases`.
		ExtendedKeys,
		// `synchronizedOutput`.
		SynchronizedOutput,
		// `bracketedPaste`.
		BracketedPaste,
		// `mouse`, in the form `readEvent` reads.
		Mouse,
		// `mouseMoves`.
		MouseMoves,
	}

	// What the terminal answered when asked what it knows; none until it
	// is asked.
	internal let featureReplies ?string[] = none

	// Reports whether the terminal says it knows a feature. The terminal is
	// asked once, the first time, for every feature, and gets a moment to
	// answer; one that does not answer, and a program without a terminal,
	// support nothing. The switches themselves never ask: a terminal
	// ignores the ones it does not know, so asking is for a program that
	// behaves differently without a feature.
	def supports(feature Feature) bool {
		let known = featureReplies
		return featureIn(known, feature) unless known is none
		let asked = askFeatures(featureQuery)
		featureReplies = asked
		return featureIn(asked, feature)
	}

	// What `supports` asks: the keyboard protocol flags and the state of
	// each mode a feature stands for.
	internal const featureQuery = "\u001b[?u\u001b[?2026$p\u001b[?2004$p\u001b[?1006$p\u001b[?1003$p"

	// Writes a query to the terminal, then asks for its device attributes,
	// which every terminal answers: that answer ends the wait. Returns the
	// replies; what was typed meanwhile is kept for the next key read.
	internal def askFeatures(asked string) string[] {
		return [] unless isTTY(os.stdout) && isTTY(os.stdin)
		return [] when native.mode(native.modeRaw, 1) != 0
		defer native.mode(native.modeRaw, 0)
		let query = "{asked}{esc}[c".bytes()
		return [] when native.write(query, query.len()) < 0
		let got byte[] = []
		let chunk byte[] = []
		chunk.len(256)
		for got.len() < 1024 {
			let n = native.read(chunk, chunk.len(), int(queryWait))
			break when n <= 0
			let part = chunk[0:n]
			got.push(...part)
			let (replies, typed, whole) = repliesIn(got)
			continue unless whole
			typedKeys.push(...typed)
			return replies
		}
		let (replies, typed, _) = repliesIn(got)
		typedKeys.push(...typed)
		return replies
	}

	// Whether the replies to `askFeatures` say the terminal knows a
	// feature: any keyboard protocol flags (`CSI ? flags u`), or a mode
	// reported as set, reset or always set (`CSI ? mode ; 1|2|3 $ y`).
	internal def featureIn(replies string[], feature Feature) bool {
		if feature == Feature.ExtendedKeys {
			return replies.filter(reply => reply.endsWith("u")).len() > 0
		}
		let mode = 1003
		mode = 2026 when feature == Feature.SynchronizedOutput
		mode = 2004 when feature == Feature.BracketedPaste
		mode = 1006 when feature == Feature.Mouse
		for let (_, reply) in replies {
			continue unless reply.endsWith("$y") && leadingNumber(reply[3:]) == mode
			let state = subParameter(reply[3:], 1, 0)
			return state >= 1 && state <= 3
		}
		return false
	}
}
