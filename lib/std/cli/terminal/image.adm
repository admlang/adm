// Pictures on the terminal, for the terminals that draw them. In a file of
// its own, so that only a program that draws one links the image codecs.
partial module std.cli.terminal {
	use (
		std.cli.terminal.keys::*
		std.cli.terminal.native
		std.cli.terminal.sgr::*
		std.data.encoding
		std.formats.image
		std.os
		std.services.runtime::(Runtime)
	)

	// ImageProtocol is the way a terminal takes a picture.
	enum ImageProtocol {
		// The terminal draws none, or the program has no terminal.
		None,
		// The kitty graphics protocol (kitty, Ghostty, WezTerm, Konsole).
		Kitty,
		// The inline images of iTerm2 (iTerm2, WezTerm, mintty).
		ITerm,
	}

	// The answer to `imageProtocol`, once asked.
	internal let imageAsked = false
	internal let imageFound = ImageProtocol.None

	// Returns how the terminal takes pictures. It is asked once: a terminal
	// that answers the kitty graphics query takes them that way; one that
	// names itself in the environment as a terminal with inline images
	// (`TERM_PROGRAM` of `iTerm.app`, `WezTerm` or `mintty`, `LC_TERMINAL`
	// of `iTerm2`) takes them the iTerm2 way.
	def imageProtocol() ImageProtocol {
		return imageFound when imageAsked
		imageAsked = true
		return imageFound unless isTTY(os.stdout) && isTTY(os.stdin)
		imageFound = protocolFrom(askFeatures(imageQuery), envText("TERM_PROGRAM"), envText("LC_TERMINAL"))
		return imageFound
	}

	// Draws a picture at the cursor and leaves the cursor at the start of
	// the line under it. columns and rows are the cells it is fitted into,
	// keeping its shape; with one of them 0 the other decides, with both 0
	// the picture takes the cells its pixels cover. Returns false, having
	// drawn nothing, when the terminal takes no pictures (`imageProtocol`),
	// so that the program can say in words what the picture shows.
	//
	// Fails when the picture cannot be encoded or written.
	def drawImage(picture image.Image, columns int = 0, rows int = 0) !bool {
		let how = imageProtocol()
		return false when how == ImageProtocol.None
		let data = try new image.PNG().encode(picture)
		let sequence = how == ImageProtocol.Kitty ?? (kittyImage(data, columns, rows), itermImage(data, columns, rows))
		try os.stdout.write((sequence + "\r\n").bytes())
		return true
	}

	// The kitty graphics query: one pixel, sent to be checked and not shown.
	// A terminal that knows the protocol answers `ESC _ G i=31;OK ESC \`.
	internal const imageQuery = "\u001b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\u001b\\"

	// The protocol the replies to `imageQuery` and the terminal's names in
	// the environment come to.
	internal def protocolFrom(replies string[], program string, lcTerminal string) ImageProtocol {
		for let (_, reply) in replies {
			return ImageProtocol.Kitty when reply.startsWith("\u001b_Gi=31;OK")
		}
		return ImageProtocol.ITerm when (program := "iTerm.app" || "WezTerm" || "mintty") || lcTerminal == "iTerm2"
		return ImageProtocol.None
	}

	// A PNG as the kitty graphics protocol takes it: Base64 in pieces of at
	// most 4096 characters, the first saying what it is and the cells to
	// fit it into, every one but the last that more follows. `q=2` keeps
	// the terminal from answering into the program's input.
	internal def kittyImage(png byte[], columns int, rows int) string {
		let text = encoding.base64encode(png)
		let head = "a=T,f=100,q=2"
		head += ",c={columns}" when columns > 0
		head += ",r={rows}" when rows > 0
		let out = ""
		let at = 0
		for {
			let end = at + 4096 > text.len() ?? (text.len(), at + 4096)
			let more = end < text.len() ?? (1, 0)
			let keys = at == 0 ?? ("{head},m={more}", "m={more}")
			out += "\u001b_G{keys};{text[at:end]}\u001b\\"
			at = end
			break when at >= text.len()
		}
		return out
	}

	// A PNG as iTerm2 takes an inline image: one sequence with its size in
	// bytes, the cells to fit it into and its Base64.
	internal def itermImage(png byte[], columns int, rows int) string {
		let keys = "inline=1;size={png.len()};preserveAspectRatio=1"
		keys += ";width={columns}" when columns > 0
		keys += ";height={rows}" when rows > 0
		return "\u001b]1337;File={keys}:{encoding.base64encode(png)}\u0007"
	}

	internal def envText(name string) string {
		let held = Runtime.getEnv(name)
		return held is none ?? ("", held)
	}
}
