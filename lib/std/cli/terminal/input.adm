partial module std.cli.terminal {
	use (
		std.cli.terminal.keys::*
		std.cli.terminal.native
		std.cli.terminal.sgr::*
		std.os
	)

	// How long the rest of an escape sequence may take to arrive after its
	// first byte before that byte is read as the Escape key.
	internal const escapeWait = 50ms

	// How long a terminal gets to answer a query.
	internal const queryWait = 200ms

	// Read from standard input by `input` and not returned yet.
	internal let typedLines byte[] = []

	// Read from the terminal by `readKey` and not decoded yet.
	internal let typedKeys byte[] = []

	// Writes prompt to standard output and reads one line from standard
	// input, a terminal or not, without its line ending.
	//
	// Fails when the prompt cannot be written, the read fails, or the input
	// has ended with nothing left to return.
	def input(prompt string = "") !string {
		try os.stdout.write(prompt.bytes()) unless prompt == ""
		let chunk byte[] = []
		chunk.len(4096)
		for {
			let at = typedLines.indexOf(byte(0x0a))
			if at >= 0 {
				let line = string(typedLines[0:at])
				typedLines = typedLines[at + 1:].clone()
				return line.trimSuffix("\r")
			}
			let n = try os.stdin.read(chunk)
			if n == 0 {
				fail "terminal: input ended" when typedLines.len() == 0
				let rest = string(typedLines)
				typedLines = []
				return rest
			}
			let got = chunk[0:n]
			typedLines.push(...got)
		}
		fail "terminal: input ended"
	}

	// Writes prompt to the terminal and reads one line from it without
	// showing what is typed. The terminal is the one the user sits at even
	// when standard input and output are pipes, so `tool < data.txt` can
	// still ask.
	//
	// Fails when the program has no terminal or the read fails.
	def password(prompt string = "") !Secret<string> {
		let refused = native.mode(native.modeNoEcho, 1)
		fail "terminal: cannot read a password: {systemError(refused)}" when refused != 0
		defer native.mode(native.modeNoEcho, 0)
		if prompt != "" {
			let text = prompt.bytes()
			let wrote = native.write(text, text.len())
			fail "terminal: cannot write the prompt: {systemError(int32(-wrote - 1))}" when wrote < 0
		}
		let line byte[] = []
		let chunk byte[] = []
		chunk.len(256)
		for {
			let n = native.read(chunk, chunk.len(), -1)
			break when n == -1
			fail "terminal: cannot read a password: {systemError(int32(-n - 1))}" when n < 0
			let got = chunk[0:n]
			let at = got.indexOf(byte(0x0a))
			if at >= 0 {
				let head = got[0:at]
				line.push(...head)
				break
			}
			line.push(...got)
		}
		return string(line).trimSuffix("\r")
	}

	// Waits for a key press and returns it. The terminal is in raw mode for
	// the wait, so the key is not echoed and needs no Enter; inside
	// `raw(true)` it stays raw between calls and no key is echoed in between.
	//
	// Fails when the program has no terminal, the read fails, or the terminal
	// went away.
	def readKey() !Key {
		let key = try nextKey(-1)
		fail "terminal: input ended" when key is none
		return key
	}

	// Waits up to `wait` for a key press; none when no key came in that time.
	// A wait of zero returns a key only when one was already pressed.
	//
	// Fails when the program has no terminal, the read fails, or the terminal
	// went away.
	def readKey(wait duration) !?Key {
		return nextKey(int(wait).clamp(0, int(1000h)))
	}

	// Waits for the next terminal event: a key press, a resize of the
	// terminal window, and, where `bracketedPaste` or `mouse` is on, pasted
	// text or a mouse report. A program that redraws its screen reads events
	// instead of keys, so that it hears of a new size in the same loop. The
	// terminal is in raw mode for the wait, as for `readKey`.
	//
	// Example: Redrawing on resize
	// ```example
	// for {
	//     let event = try terminal.readEvent()
	//     if event.kind == EventKind.Resize {
	//         draw(event.size)
	//         continue
	//     }
	//     break when event.key.code == KeyCode.Escape
	// }
	// ```
	//
	// Fails when the program has no terminal, the read fails, or the terminal
	// went away.
	def readEvent() !Event {
		let event = try nextEvent(-1, true)
		fail "terminal: input ended" when event is none
		return event
	}

	// Waits up to `wait` for a terminal event; none when nothing happened in
	// that time. A wait of zero returns an event only when one is due.
	//
	// Fails when the program has no terminal, the read fails, or the terminal
	// went away.
	def readEvent(wait duration) !?Event {
		return nextEvent(int(wait).clamp(0, int(1000h)), true)
	}

	// The next key, waiting up to timeout nanoseconds (without end when
	// negative).
	internal def nextKey(timeout int) !?Key {
		let event = try nextEvent(timeout, false)
		return none when event is none
		return event.key
	}

	// The next event, waiting up to timeout nanoseconds (without end when
	// negative); resizes are reported only when asked for.
	internal def nextEvent(timeout int, resizes bool) !?Event {
		let refused = native.mode(native.modeRaw, 1)
		fail "terminal: cannot read keys: {systemError(refused)}" when refused != 0
		defer native.mode(native.modeRaw, 0)
		let chunk byte[] = []
		chunk.len(64)
		for {
			if typedKeys.len() > 0 {
				let (used, event) = decodeEvent(typedKeys, typedKeys.len(), false)
				if used > 0 {
					typedKeys = typedKeys[used:].clone()
					// A reader of keys alone lets pastes and the mouse go by.
					continue unless resizes || event.kind == EventKind.Key
					return event
				}
			}
			// With part of a sequence in hand, the rest is either on its way
			// or the part is a key by itself.
			// A paste is as long as it is: its end is waited for.
			let pasting = startsWith(typedKeys, typedKeys.len(), pasteStart)
			let wait = typedKeys.len() > 0 && !pasting ?? (int(escapeWait), timeout)
			let n = resizes ?? (native.readEvent(chunk, chunk.len(), wait), native.read(chunk, chunk.len(), wait))
			if n == native.resized {
				let cells = size()
				return Event{kind: EventKind.Resize} when cells is none
				return Event{kind: EventKind.Resize, size: cells}
			}
			if n == 0 {
				return none when typedKeys.len() == 0
				let (used, event) = decodeEvent(typedKeys, typedKeys.len(), true)
				typedKeys = typedKeys[used:].clone()
				continue unless resizes || event.kind == EventKind.Key
				return event
			}
			fail "terminal: input ended" when n == -1
			fail "terminal: cannot read keys: {systemError(int32(-n - 1))}" when n < 0
			let got = chunk[0:n]
			typedKeys.push(...got)
		}
		fail "terminal: input ended"
	}

	// Asks the terminal for its background color (OSC 11) and reports whether
	// it is light; none when there is no terminal or it does not answer.
	internal def backgroundIsLight() ?bool {
		return none unless isTTY(os.stdout) && isTTY(os.stdin)
		return none when native.mode(native.modeRaw, 1) != 0
		defer native.mode(native.modeRaw, 0)
		let query = "{esc}]11;?{terminator}".bytes()
		return none when native.write(query, query.len()) < 0
		return lightness(queryReply("{esc}]11;", 256))
	}

	// Reads the terminal's answer to a query just written: the operating
	// system command that starts with lead, up to limit bytes, without its
	// terminator. What was typed before and after the answer is kept for
	// the next key read. "" when no answer came in time. The terminal must
	// be in raw mode.
	internal def queryReply(lead string, limit int) string {
		let got byte[] = []
		let chunk byte[] = []
		chunk.len(256)
		let wanted = lead.bytes()
		for got.len() < limit {
			let n = native.read(chunk, chunk.len(), int(queryWait))
			break when n <= 0
			let part = chunk[0:n]
			got.push(...part)
			let (answer, before, after, whole) = cutReply(got, wanted)
			continue unless whole
			typedKeys.push(...before)
			typedKeys.push(...after)
			return answer
		}
		// No answer: everything read was typed.
		typedKeys.push(...got)
		return ""
	}

	// Finds the reply that starts with lead in data and ends at a BEL or a
	// string terminator: the reply with lead and without the terminator,
	// the bytes before it, the bytes after it, and whether it was whole.
	internal def cutReply(data byte[], lead byte[]) (string, byte[], byte[], bool) {
		let nothing byte[] = []
		for let at = 0; at + lead.len() <= data.len(); at++ {
			continue unless startsWith(data[at:], data.len() - at, lead)
			for let end = at + lead.len(); end < data.len(); end++ {
				return (string(data[at:end]), data[0:at].clone(), data[end + 1:].clone(), true) when data[end] == byte(0x07)
				return (string(data[at:end]), data[0:at].clone(), data[end + 2:].clone(), true) when data[end] == byte(0x1b) && end + 1 < data.len() && data[end + 1] == byte(0x5c)
			}
			break
		}
		return ("", nothing, nothing, false)
	}

	// The system's text for an error code of the terminal bindings.
	internal def systemError(code int32) string {
		let text byte[] = []
		text.len(128)
		let n = native.errorText(code, text, text.len())
		return string(text[0:n])
	}
}
