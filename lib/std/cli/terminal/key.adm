partial module std.cli.terminal {
	// KeyCode names a key.
	enum KeyCode {
		// A key that types a character; `Key.text` holds it.
		Char,
		Enter,
		Tab,
		Backspace,
		Escape,
		Up,
		Down,
		Left,
		Right,
		Home,
		End,
		PageUp,
		PageDown,
		Insert,
		Delete,
		F1,
		F2,
		F3,
		F4,
		F5,
		F6,
		F7,
		F8,
		F9,
		F10,
		F11,
		F12,
		// Input the terminal sent that is no known key; `Key.text` holds it
		// as received.
		Unknown,
	}

	// KeyAction says what happened to a key.
	enum KeyAction {
		// The key went down. Every key event is one unless `keyReleases` is
		// on.
		Press,
		// The key is held and the terminal types it again.
		Repeat,
		// The key came up.
		Release,
	}

	// Key is one key press, as `readKey` returns it.
	//
	// A terminal reports Ctrl with a letter as a control character, so
	// Ctrl+C arrives as `Char` with text `c` and `ctrl` set, and it cannot
	// tell Ctrl+I from Tab, Ctrl+M from Enter or Ctrl+H from Backspace: those
	// arrive as `Tab`, `Enter` and `Backspace`.
	struct Key {
		code   KeyCode
		// The character typed, for `KeyCode.Char`; else empty.
		text   string
		ctrl   bool
		alt    bool
		shift  bool
		// Whether the key went down, repeats or came up; always `Press`
		// unless `keyReleases` is on.
		action KeyAction
	}

	// EventKind says what a terminal event is.
	enum EventKind {
		// A key press; `Event.key` holds it.
		Key,
		// The terminal window changed size; `Event.size` holds the new size.
		Resize,
		// Text was pasted, with `bracketedPaste(true)`; `Event.text` holds
		// it.
		Paste,
		// The mouse was used, with `mouse(true)`; `Event.mouse` says how.
		Mouse,
	}

	// MouseButton is the button, or the wheel direction, of a mouse event.
	enum MouseButton {
		// No button: the pointer moved with none held.
		None,
		Left,
		Middle,
		Right,
		WheelUp,
		WheelDown,
		WheelLeft,
		WheelRight,
	}

	// MouseAction says what the mouse did.
	enum MouseAction {
		// A button went down, or the wheel turned a step.
		Press,
		Release,
		// The pointer moved with a button held.
		Move,
	}

	// Mouse is one mouse report: where the pointer is, which button and
	// which keys were held.
	struct Mouse {
		// The cell under the pointer, counted from 0 at the top left, as
		// `moveTo` counts.
		column int
		row    int
		button MouseButton
		action MouseAction
		ctrl   bool
		alt    bool
		shift  bool
	}

	// Event is something the terminal reported, as `readEvent` returns it.
	struct Event {
		kind  EventKind
		// The key pressed, for `EventKind.Key`.
		key   Key
		// The new size, for `EventKind.Resize`; zero when standard output is
		// not the terminal.
		size  Size
		// The text pasted, for `EventKind.Paste`.
		text  string
		// The report, for `EventKind.Mouse`.
		mouse Mouse
	}
}
