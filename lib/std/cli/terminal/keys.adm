// Decodes the bytes a terminal sends for key presses.
internal partial module std.cli.terminal.keys {
	use std.cli.terminal::(Event, EventKind, Key, KeyAction, KeyCode, Mouse, MouseAction, MouseButton)

	// What a terminal sends before and after pasted text in bracketed paste
	// mode.
	const pasteStart = byte[0x1b, 0x5b, 0x32, 0x30, 0x30, 0x7e]
	const pasteEnd = byte[0x1b, 0x5b, 0x32, 0x30, 0x31, 0x7e]

	// Decodes the event at the start of data[0:n]: a paste, a mouse report
	// (`ESC [ < button ; column ; row M`, or `m` for a release) or a key.
	// Returns how many bytes it took and the event; 0 bytes means it is not
	// complete yet. With `complete` set no more bytes are on their way.
	def decodeEvent(data byte[], n int, complete bool) (int, Event) {
		if startsWith(data, n, pasteStart) {
			let from = pasteStart.len()
			for let at = from; at + pasteEnd.len() <= n; at++ {
				continue unless startsWith(data[at:n], n - at, pasteEnd)
				return (at + pasteEnd.len(), Event{kind: EventKind.Paste, text: string(data[from:at])})
			}
			return (0, Event{}) unless complete
			return (n, Event{kind: EventKind.Paste, text: string(data[from:n])})
		}
		if n >= 3 && int(data[0]) == 0x1b && int(data[1]) == 0x5b && int(data[2]) == 0x3c {
			let end = 3
			for end < n && int(data[end]) != 0x4d && int(data[end]) != 0x6d {
				end++
			}
			if end < n {
				let numbers = parameters(string(data[3:end]))
				return (end + 1, Event{kind: EventKind.Mouse, mouse: mouseOf(numbers, int(data[end]) == 0x6d)}) when numbers.len() == 3
			} else if !complete {
				return (0, Event{})
			}
		}
		let (used, key) = decodeKey(data, n, complete)
		return (used, Event{kind: EventKind.Key, key: key})
	}

	// Splits what a terminal sent after a query into its replies
	// (`CSI ? ... final` and `ESC _ ... ESC \`) and the rest, which was typed. The last value says
	// whether the reply to a device attributes request (`CSI ? ... c`),
	// which ends a terminal's answers, is among them.
	def repliesIn(data byte[]) (string[], byte[], bool) {
		let replies string[] = []
		let typed byte[] = []
		let whole = false
		let at = 0
		for at < data.len() {
			// An application command (`ESC _ ... ESC \`), which is how the
			// kitty graphics protocol answers, is a reply whole.
			if at + 1 < data.len() && int(data[at]) == 0x1b && int(data[at + 1]) == 0x5f {
				let end = at + 2
				for end + 1 < data.len() && !(int(data[end]) == 0x1b && int(data[end + 1]) == 0x5c) {
					end++
				}
				break when end + 1 >= data.len()
				replies.push(string(data[at:end + 2]))
				at = end + 2
				continue
			}
			let (used, event) = decodeEvent(data[at:], data.len() - at, true)
			break when used == 0
			let piece = data[at:at + used]
			at += used
			let text = string(piece)
			if event.kind == EventKind.Key && event.key.code == KeyCode.Unknown && text.startsWith("\u001b[?") {
				replies.push(text)
				whole = whole || text.endsWith("c")
			} else {
				typed.push(...piece)
			}
		}
		return (replies, typed, whole)
	}

	def startsWith(data byte[], n int, lead byte[]) bool {
		return false when n < lead.len()
		for let (i, value) in lead {
			return false unless data[i] == value
		}
		return true
	}

	// The mouse report an SGR sequence's three numbers describe: the button
	// code with its modifier and motion bits, the column and the row, both
	// from 1.
	def mouseOf(numbers int[], released bool) Mouse {
		let code = numbers[0]
		let report = Mouse{column: numbers[1] - 1, row: numbers[2] - 1, action: released ?? (MouseAction.Release, MouseAction.Press)}
		report.shift = (code & 4) != 0
		report.alt = (code & 8) != 0
		report.ctrl = (code & 16) != 0
		let which = code & 3
		if (code & 64) != 0 {
			let wheel = [MouseButton.WheelUp, MouseButton.WheelDown, MouseButton.WheelLeft, MouseButton.WheelRight]
			report.button = wheel[which]
			return report
		}
		let buttons = [MouseButton.Left, MouseButton.Middle, MouseButton.Right, MouseButton.None]
		report.button = buttons[which]
		report.action = MouseAction.Move when (code & 32) != 0
		return report
	}

	// The keys `CSI number ~` reports, by number; Unknown where a number
	// names no key.
	const tildeKeys = KeyCode[
		KeyCode.Unknown, KeyCode.Home, KeyCode.Insert, KeyCode.Delete, KeyCode.End, KeyCode.PageUp, KeyCode.PageDown, KeyCode.Home,
		KeyCode.End, KeyCode.Unknown, KeyCode.Unknown, KeyCode.F1, KeyCode.F2, KeyCode.F3, KeyCode.F4, KeyCode.F5, KeyCode.Unknown,
		KeyCode.F6, KeyCode.F7, KeyCode.F8, KeyCode.F9, KeyCode.F10, KeyCode.Unknown, KeyCode.F11, KeyCode.F12
	]

	// Decodes the key at the start of data[0:n]. Returns how many bytes it
	// took and the key; 0 bytes means the key is not complete yet. With
	// `complete` set no more bytes are on their way, so what is there is
	// decoded as it stands: a lone escape byte is the Escape key.
	def decodeKey(data byte[], n int, complete bool) (int, Key) {
		return (0, Key{}) when n == 0
		let first = int(data[0])
		if first == 0x1b {
			return complete ?? ((1, Key{code: KeyCode.Escape}), (0, Key{})) when n == 1
			let second = int(data[1])
			return decodeCsi(data, n, complete) when second == 0x5b
			return decodeSs3(data, n, complete) when second == 0x4f
			// Escape before a key is that key with Alt held.
			let (used, key) = decodeKey(data[1:n], n - 1, complete)
			return (0, Key{}) when used == 0
			key.alt = true
			return (used + 1, key)
		}
		return (1, Key{code: KeyCode.Enter}) when first := 0x0d || 0x0a
		return (1, Key{code: KeyCode.Tab}) when first == 0x09
		return (1, Key{code: KeyCode.Backspace}) when first := 0x7f || 0x08
		return (1, Key{code: KeyCode.Char, text: " ", ctrl: true}) when first == 0
		return (1, Key{code: KeyCode.Char, text: string(byte[byte(first + 0x60)]), ctrl: true}) when first < 0x1b
		return (1, Key{code: KeyCode.Char, text: string(byte[byte(first + 0x40)]), ctrl: true}) when first < 0x20
		let width = utf8Width(first)
		if width > n {
			return (0, Key{}) unless complete
			return (n, Key{code: KeyCode.Unknown, text: string(data[0:n])})
		}
		return (width, Key{code: KeyCode.Char, text: string(data[0:width])})
	}

	// The byte length of the UTF-8 sequence a lead byte starts; 1 for a byte
	// that starts none.
	def utf8Width(lead int) int {
		return 1 when lead < 0xc0
		return 2 when lead < 0xe0
		return 3 when lead < 0xf0
		return 4 when lead < 0xf8
		return 1
	}

	// Decodes `ESC [ parameters final`: arrows, the editing keys, function
	// keys, each with optional modifiers, and keys in the `CSI u` form.
	def decodeCsi(data byte[], n int, complete bool) (int, Key) {
		let end = 2
		for end < n && int(data[end]) >= 0x20 && int(data[end]) < 0x40 {
			end++
		}
		if end >= n {
			return (0, Key{}) unless complete
			return (n, Key{code: KeyCode.Unknown, text: string(data[0:n])})
		}
		let last = int(data[end])
		let used = end + 1
		let body = string(data[2:end])
		let numbers = parameters(body)
		let key = Key{code: KeyCode.Unknown}
		let number = numbers.len() > 0 ?? (numbers[0], 1)
		switch last {
			case 0x41:
				key.code = KeyCode.Up
			case 0x42:
				key.code = KeyCode.Down
			case 0x43:
				key.code = KeyCode.Right
			case 0x44:
				key.code = KeyCode.Left
			case 0x48:
				key.code = KeyCode.Home
			case 0x46:
				key.code = KeyCode.End
			case 0x50:
				key.code = KeyCode.F1
			case 0x51:
				key.code = KeyCode.F2
			case 0x52:
				key.code = KeyCode.F3
			case 0x53:
				key.code = KeyCode.F4
			case 0x5a:
				key.code = KeyCode.Tab
				key.shift = true
			case 0x7e:
				key.code = number < tildeKeys.len() ?? (tildeKeys[number], KeyCode.Unknown)
			case 0x75:
				key = codePointKey(number)
			default:
		}
		// The kitty protocol's event type follows the modifiers after a
		// colon (`1;5:3`): 2 for a repeat, 3 for a release.
		let event = subParameter(body, 1, 1)
		key.action = KeyAction.Repeat when event == 2
		key.action = KeyAction.Release when event == 3
		if key.code == KeyCode.Unknown {
			key.text = string(data[0:used])
			return (used, key)
		}
		if numbers.len() > 1 && numbers[1] > 1 {
			let held = numbers[1] - 1
			key.shift = key.shift || (held & 1) != 0
			key.alt = (held & 2) != 0
			key.ctrl = (held & 4) != 0
		}
		key.text = typedText(body, key) when last == 0x75 && key.code == KeyCode.Char
		return (used, key)
	}

	// The text a `CSI u` key types: the code points the terminal sends as
	// the sequence's third parameter, else the shifted key after the key's
	// code (`97:65`) when Shift is held, else the key itself.
	def typedText(body string, key Key) string {
		let fields = body.split(";")
		if fields.len() > 2 && fields[2] != "" {
			let out = ""
			for let (_, part) in fields[2].split(":") {
				let point = leadingNumber(part)
				out += string(char(point)) when point >= 32 && point <= 0x10ffff
			}
			return out unless out == ""
		}
		let shifted = subParameter(body, 0, 1)
		return string(char(shifted)) when key.shift && shifted >= 32 && shifted <= 0x10ffff
		return key.text
	}

	// The number at place part (from 0) among the colon-separated parts of
	// parameter field (from 0) of a parameter string; 0 when there is none.
	def subParameter(body string, field int, part int) int {
		let fields = body.split(";")
		return 0 when field >= fields.len()
		let parts = fields[field].split(":")
		return 0 when part >= parts.len()
		return leadingNumber(parts[part])
	}

	// The number the digits at the start of text spell; 0 with none.
	def leadingNumber(text string) int {
		let value = 0
		for let (_, ch) in text {
			break unless ch.isDigit()
			value = value * 10 + ch.digitValue()
		}
		return value
	}

	// Decodes `ESC O final`, the form keypad-mode terminals use for arrows,
	// Home, End and F1 to F4.
	def decodeSs3(data byte[], n int, complete bool) (int, Key) {
		if n < 3 {
			return (0, Key{}) unless complete
			// Alt+O.
			return (2, Key{code: KeyCode.Char, text: "O", alt: true})
		}
		switch int(data[2]) {
			case 0x41:
				return (3, Key{code: KeyCode.Up})
			case 0x42:
				return (3, Key{code: KeyCode.Down})
			case 0x43:
				return (3, Key{code: KeyCode.Right})
			case 0x44:
				return (3, Key{code: KeyCode.Left})
			case 0x48:
				return (3, Key{code: KeyCode.Home})
			case 0x46:
				return (3, Key{code: KeyCode.End})
			case 0x50:
				return (3, Key{code: KeyCode.F1})
			case 0x51:
				return (3, Key{code: KeyCode.F2})
			case 0x52:
				return (3, Key{code: KeyCode.F3})
			case 0x53:
				return (3, Key{code: KeyCode.F4})
			default:
		}
		return (3, Key{code: KeyCode.Unknown, text: string(data[0:3])})
	}

	// The key a `CSI u` sequence names by code point.
	def codePointKey(point int) Key {
		return Key{code: KeyCode.Enter} when point == 13
		return Key{code: KeyCode.Tab} when point == 9
		return Key{code: KeyCode.Escape} when point == 27
		return Key{code: KeyCode.Backspace} when point := 127 || 8
		return Key{code: KeyCode.Unknown} when point < 32 || point > 0x10ffff
		return keypadKey(point) when point >= 0xE000 && point <= 0xF8FF
		return Key{code: KeyCode.Char, text: string(char(point))}
	}

	// The key a private-use code point of the kitty protocol names: the
	// keypad's digits, operators and editing keys as the keys they double.
	// Unknown for the keys `KeyCode` has no name for (the lock keys, the
	// media keys, F13 and up, and the modifier keys themselves).
	def keypadKey(point int) Key {
		return Key{code: KeyCode.Char, text: string(char(0x30 + point - 57399))} when point >= 57399 && point <= 57408
		return Key{code: KeyCode.Char, text: [".", "/", "*", "-", "+"][point - 57409]} when point >= 57409 && point <= 57413
		return Key{code: KeyCode.Enter} when point == 57414
		return Key{code: KeyCode.Char, text: "="} when point == 57415
		return Key{code: KeyCode.Char, text: ","} when point == 57416
		let editing = [KeyCode.Left, KeyCode.Right, KeyCode.Up, KeyCode.Down, KeyCode.PageUp, KeyCode.PageDown, KeyCode.Home, KeyCode.End, KeyCode.Insert, KeyCode.Delete]
		return Key{code: editing[point - 57417]} when point >= 57417 && point <= 57426
		return Key{code: KeyCode.Unknown}
	}

	// The numbers of a parameter string (`1;5`). A parameter with no digits
	// reads as 1, the value terminals mean by leaving one out; digits end at
	// the first other character (a sub-parameter after `:`).
	def parameters(text string) int[] {
		let out int[] = []
		return out when text == ""
		for let (_, part) in text.split(";") {
			let value = 0
			let digits = 0
			for let (_, ch) in part {
				break unless ch.isDigit()
				value = value * 10 + ch.digitValue()
				digits++
			}
			out.push(digits == 0 ?? (1, value))
		}
		return out
	}
}
