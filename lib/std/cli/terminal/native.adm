// The runtime side of std.cli.terminal: what escape sequences cannot do.
// The runtime owns every mode changed here and puts the terminal back when
// the process ends, however it ends.
internal partial module std.cli.terminal.native {
	// The modes of `mode`.
	const modeRaw int32 = 0
	const modeNoEcho int32 = 1
	const modeAlternateScreen int32 = 2
	const modeHideCursor int32 = 3
	const modeBracketedPaste int32 = 4
	const modeMouse int32 = 5
	const modeExtendedKeys int32 = 6
	const modeSynchronizedOutput int32 = 7
	const modeMouseMoves int32 = 8
	const modeKeyEvents int32 = 9

	// 1 when the descriptor is a terminal that takes escape sequences.
	@c(symbol = "adm_term_is_tty", ret = "int32_t", params = ["int32_t"])
	def isTerminal(fd int32) int32;

	// Writes the columns and rows of the terminal behind standard output into
	// out[0] and out[1]. 0 when standard output is not a terminal.
	@c(symbol = "adm_term_size", ret = "int32_t", params = ["int32_t*"])
	def windowSize(out int32[]) int32;

	// Enters (on = 1) or leaves (on = 0) a mode; enters are counted. Returns 0
	// or the system error code.
	@c(symbol = "adm_term_mode", ret = "int32_t", params = ["int32_t", "int32_t"])
	def mode(which int32, on int32) int32;

	// Reads up to n bytes the user typed, waiting at most timeout nanoseconds
	// (without end when negative). Returns the count, 0 when the wait ran out,
	// -1 when the input ended, or -(code + 1) for a system error.
	@c(symbol = "adm_term_read", ret = "int64_t", params = ["uint8_t*", "int64_t", "int64_t"])
	def read(buf byte[], n int, timeout int) int;

	// What `readEvent` returns when the terminal window was resized.
	const resized = -1000000

	// `read` that also reports a resize of the terminal window: returns
	// `resized` when one happened since the last call, before any input.
	@c(symbol = "adm_term_read_event", ret = "int64_t", params = ["uint8_t*", "int64_t", "int64_t"])
	def readEvent(buf byte[], n int, timeout int) int;

	// Writes n bytes to the terminal itself, which is where a prompt belongs
	// when standard output is a pipe. Returns the count or -(code + 1).
	@c(symbol = "adm_term_write", ret = "int64_t", params = ["const uint8_t*", "int64_t"])
	def write(buf byte[], n int) int;

	// Copies the system's text for an error code into buf; returns its length.
	@c(symbol = "adm_term_error", ret = "int64_t", params = ["int32_t", "uint8_t*", "int64_t"])
	def errorText(code int32, buf byte[], n int) int;
}
