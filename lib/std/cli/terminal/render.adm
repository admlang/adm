partial module std.cli.terminal {
	use (
		std.cli.terminal.sgr::*
		std.formats.docs
		std.formats.docs::(Block, BlockKind, Document, Inline, InlineKind, PlainText)
		std.os
		std.os::(File)
	)

	// Returns a document laid out for the terminal: the layout of
	// `docs.PlainText` (wrapped paragraphs, lists, boxed tables, quotes), with
	// the styles a terminal has in place of marker characters. Bold, italic,
	// underline and strike are themselves; code, links (clickable where the terminal
	// follows OSC 8), headings and a styled span's role take their look from
	// the theme; a colored span keeps its colors; quote bars, rules and
	// table borders are dimmed.
	//
	// width is the widest line; left at 0 it is the terminal's width, or 80
	// when standard output is not a terminal. On a stream that shows no
	// colors the result is the plain text layout as it is.
	//
	// Example: Show a Markdown file
	// ```example
	// use std.cli.terminal
	// use std.formats.docs
	//
	// let doc = try docs.load("README.md")
	// print(terminal.render(doc))
	// ```
	def render(doc Document, stream File = os.stdout, width int = 0) string {
		let room = width
		if room <= 0 {
			let window = size()
			room = window is none ?? (80, window.columns)
		}
		return rendered(doc, room, colors(stream))
	}

	// The document laid out in room columns for a terminal of the depth.
	internal def rendered(doc Document, room int, depth ColorDepth) string {
		let layout = new PlainText()
		layout.width = room
		layout.marks = new TerminalMarks(depth) unless depth == ColorDepth.None
		return layout.encode(doc)
	}

	// TerminalMarks writes a document's styles as escape sequences.
	internal type TerminalMarks {
		depth ColorDepth

		def new(depth ColorDepth) {
			self.depth = depth
		}

		// The sequences a look opens and closes with.
		def around(look TextStyle) (string, string) {
			let painted = paint("\u0001", look, depth)
			let at = painted.indexOf("\u0001")
			return ("", "") when at < 0
			return (painted[0:at], painted[at + 1:])
		}

		def inline(item Inline) (string, string) {
			match item.kind {
				case InlineKind.Bold:
					return around(new TextStyle(bold = true))
				case InlineKind.Italic:
					return around(new TextStyle(italic = true))
				case InlineKind.Underline:
					return around(new TextStyle(underline = true))
				case InlineKind.Strike:
					return around(new TextStyle(strike = true))
				case InlineKind.Code:
					return around(styleOf("code"))
				case InlineKind.Link:
					let (open, close) = around(styleOf("link"))
					return (open, close) when item.url == ""
					let wrapped = hyperlink("\u0001", item.url)
					let at = wrapped.indexOf("\u0001")
					return (wrapped[0:at] + open, close + wrapped[at + 1:])
				case InlineKind.Styled:
					let look = new TextStyle()
					if item.role != "" {
						let themed = theme().get(item.role)
						look = themed unless themed is none
					}
					let front = item.foreground
					look.foreground = new Color(int(front.red), int(front.green), int(front.blue)) unless front is none
					let back = item.background
					look.background = new Color(int(back.red), int(back.green), int(back.blue)) unless back is none
					return around(look)
				default:
					return ("", "")
			}
		}

		def block(item Block) (string, string) {
			match item.kind {
				case BlockKind.Heading:
					return around(styleOf("heading"))
				case BlockKind.Code:
					return around(styleOf("code"))
				case BlockKind.Quote, BlockKind.Rule, BlockKind.Table:
					return around(styleOf("dim"))
				default:
					return ("", "")
			}
		}
	}
}
