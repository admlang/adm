// Escape-sequence rendering for std.cli.terminal: palette arithmetic, the
// sequences a style opens and closes with, and the color depth of a stream.
internal partial module std.cli.terminal.sgr {
	use std.cli.terminal::(ColorDepth, TextStyle, Color)

	// The kinds of Color.
	const kindDefault = 0
	const kindPalette = 1
	const kindIndexed = 2
	const kindRgb = 3

	// The escape character.
	const esc = "\u001b"

	// The string terminator that ends an operating system command.
	const terminator = "\u001b\\"

	// Palette names in `Ansi` order, lower case, as `parseColor` matches them.
	const paletteNames = string[
		"default", "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
		"brightblack", "brightred", "brightgreen", "brightyellow", "brightblue", "brightmagenta", "brightcyan", "brightwhite"
	]

	// The colors xterm gives the 16 palette entries, as red, green, blue
	// triples: what a color is compared against when a terminal has only the
	// palette.
	const paletteRgb = int[
		0, 0, 0, 205, 0, 0, 0, 205, 0, 205, 205, 0, 0, 0, 238, 205, 0, 205, 0, 205, 205, 229, 229, 229,
		127, 127, 127, 255, 0, 0, 0, 255, 0, 255, 255, 0, 92, 92, 255, 255, 0, 255, 0, 255, 255, 255, 255, 255
	]

	// The six levels of each axis of the 256-color cube.
	const cubeLevels = int[0, 95, 135, 175, 215, 255]

	// The SGR parameter of palette entry index (0..15) over base 30 (text) or
	// 40 (background): 30..37, then 90..97 for the bright half.
	def paletteCode(index int, base int) string {
		return "{base + index}" when index < 8
		return "{base + 60 + index - 8}"
	}

	// The red, green and blue of indexed color index (0..255).
	def indexedRgb(index int) (int, int, int) {
		return (paletteRgb[index * 3], paletteRgb[index * 3 + 1], paletteRgb[index * 3 + 2]) when index < 16
		if index >= 232 {
			let gray = 8 + (index - 232) * 10
			return (gray, gray, gray)
		}
		let cube = index - 16
		return (cubeLevels[cube / 36], cubeLevels[(cube / 6) % 6], cubeLevels[cube % 6])
	}

	// The palette entry (0..15) closest to a color.
	def nearestPalette(red int, green int, blue int) int {
		let best = 0
		let bestDistance = 3 * 255 * 255 + 1
		for let i = 0; i < 16; i++ {
			let d = distance(red, green, blue, paletteRgb[i * 3], paletteRgb[i * 3 + 1], paletteRgb[i * 3 + 2])
			if d < bestDistance {
				bestDistance = d
				best = i
			}
		}
		return best
	}

	// The indexed color (16..255) closest to a color: the nearer of its cube
	// cell and its gray-ramp step.
	def nearestIndexed(red int, green int, blue int) int {
		let r = cubeStep(red)
		let g = cubeStep(green)
		let b = cubeStep(blue)
		let cube = 16 + 36 * r + 6 * g + b
		let step = ((red + green + blue) / 3 - 8 + 5) / 10
		let grayStep = step.clamp(0, 23)
		let gray = 8 + grayStep * 10
		let cubeDistance = distance(red, green, blue, cubeLevels[r], cubeLevels[g], cubeLevels[b])
		let grayDistance = distance(red, green, blue, gray, gray, gray)
		return grayDistance < cubeDistance ?? (232 + grayStep, cube)
	}

	// The cube level (0..5) closest to one color part.
	def cubeStep(value int) int {
		return 0 when value < 48
		return 1 when value < 115
		return (value - 35) / 40
	}

	def distance(r1 int, g1 int, b1 int, r2 int, g2 int, b2 int) int {
		let dr = r1 - r2
		let dg = g1 - g2
		let db = b1 - b2
		return dr * dr + dg * dg + db * db
	}

	// Wraps text in the escape sequences of a style for a terminal of the
	// given depth. The style is closed with the codes that end only what it
	// turned on, and where the text already holds a styled span, the style is
	// turned on again after that span ends: an inner span never ends the outer
	// one.
	def paint(text string, look TextStyle, depth ColorDepth) string {
		return text when depth == ColorDepth.None || text == ""
		let on string[] = []
		let off string[] = []
		on.push("1") when look.bold
		on.push("2") when look.dim
		off.push("22") when look.bold || look.dim
		if look.italic {
			on.push("3")
			off.push("23")
		}
		if look.underline {
			on.push("4")
			off.push("24")
		}
		if look.strike {
			on.push("9")
			off.push("29")
		}
		let foreground = colorCode(look.foreground, depth, false)
		if foreground != "" {
			on.push(foreground)
			off.push("39")
		}
		let background = colorCode(look.background, depth, true)
		if background != "" {
			on.push(background)
			off.push("49")
		}
		return text when on.len() == 0
		let open = "{esc}[{on.join(";")}m"
		let close = "{esc}[{off.join(";")}m"
		return open + text + close unless text.contains(esc)
		return open + reopenAfterSpans(text, open) + close
	}

	// The SGR parameters of an optional color; empty when there is none.
	def colorCode(color ?Color, depth ColorDepth, background bool) string {
		return "" when color is none
		return color.sgr(depth, background)
	}

	// Inserts `open` after every sequence in text that turns attributes off.
	def reopenAfterSpans(text string, open string) string {
		let parts = text.split(esc)
		let out string[] = [parts[0]]
		for let i = 1; i < parts.len(); i++ {
			let part = parts[i]
			out.push(esc)
			let end = part.indexOf("m")
			if part.startsWith("[") && end > 0 && turnsOff(part[1:end]) {
				out.push(part[0:end + 1])
				out.push(open)
				out.push(part[end + 1:])
			} else {
				out.push(part)
			}
		}
		return out.join("")
	}

	// Reports whether SGR parameters only turn attributes off.
	def turnsOff(parameters string) bool {
		for let (_, code) in parameters.split(";") {
			return false unless code := "0" || "22" || "23" || "24" || "29" || "39" || "49"
		}
		return true
	}

	// Wraps text in an OSC 8 hyperlink to target.
	def hyperlink(text string, target string) string {
		return "{esc}]8;;{target}{terminator}{text}{esc}]8;;{terminator}"
	}

	@env("NO_COLOR")
	const envNoColor string

	@env("FORCE_COLOR")
	const envForceColor string

	@env("CLICOLOR_FORCE")
	const envCliColorForce string

	@env("TERM")
	const envTerm string

	@env("COLORTERM")
	const envColorTerm string

	// The color depth of a stream in this process's environment; tty says
	// whether the stream is a terminal.
	def streamDepth(tty bool) ColorDepth {
		let force = envForceColor != "" ?? (envForceColor, envCliColorForce)
		return depthFor(tty, envNoColor, force, envTerm, envColorTerm)
	}

	// The color depth of a stream, from whether it is a terminal and the
	// environment variables that say what the terminal shows:
	//
	// - `NO_COLOR` set to anything: none.
	// - `FORCE_COLOR` or `CLICOLOR_FORCE`: `0` or `false` is none; `1` or
	//   `true` at least the palette, `2` 256 colors, `3` 24-bit, whether or
	//   not the stream is a terminal.
	// - Not a terminal, or `TERM=dumb`: none.
	// - `COLORTERM` of `truecolor` or `24bit`: 24-bit.
	// - `TERM` containing `256color`: 256 colors.
	// - Any other terminal: the palette.
	def depthFor(tty bool, noColor string, force string, term string, colorTerm string) ColorDepth {
		return ColorDepth.None when noColor != ""
		return ColorDepth.None when force := "0" || "false"
		return ColorDepth.TrueColor when force == "3"
		return ColorDepth.Ansi256 when force == "2"
		let forced = force != ""
		return ColorDepth.None unless tty || forced
		return ColorDepth.None when term == "dumb" && !forced
		return ColorDepth.TrueColor when colorTerm := "truecolor" || "24bit"
		return ColorDepth.Ansi256 when term.contains("256color")
		return ColorDepth.Basic
	}

	// Reports whether the background color in a terminal's OSC 11 reply
	// (`rgb:RRRR/GGGG/BBBB`, one to four hex digits a part) is light; none
	// when the reply holds no color.
	def lightness(reply string) ?bool {
		let at = reply.indexOf("rgb:")
		return none when at < 0
		let parts = reply[at + 4:].split("/")
		return none when parts.len() < 3
		let levels int[] = []
		for let i = 0; i < 3; i++ {
			let value = 0
			let digits = 0
			for let (_, ch) in parts[i] {
				break unless ch.isHexDigit() && digits < 4
				value = value * 16 + ch.digitValue(16)
				digits++
			}
			return none when digits == 0
			// Scale to 0..255 whatever the digit count.
			levels.push(value * 255 / ((1 << (4 * digits)) - 1))
		}
		return 2126 * levels[0] + 7152 * levels[1] + 722 * levels[2] > 1275000
	}
}
