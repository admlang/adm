partial module std.cli.terminal {
	use (
		std.cli.terminal.sgr::*
		std.os
		std.os::(File)
	)

	// TextStyle is how a piece of text looks on a terminal: its colors and
	// attributes. It is the data a theme holds for a role; text is styled by
	// the role functions (`failure`, `heading`, ...) and by `color`.
	//
	// Example: A theme entry
	// ```example
	// let theme = terminal.theme()
	// theme.set("heading", new TextStyle(Ansi.Cyan, bold = true))
	// ```
	type TextStyle {
		// Text color; none leaves the terminal's own.
		foreground ?Color
		// Background color; none leaves the terminal's own.
		background ?Color
		bold       bool
		italic     bool
		underline  bool
		// Fainter text.
		dim        bool
		// A line through the text.
		strike     bool

		def new(foreground ?Color = none, background ?Color = none, bold bool = false, italic bool = false, underline bool = false, dim bool = false, strike bool = false) {
			self.foreground = foreground
			self.background = background
			self.bold = bold
			self.italic = italic
			self.underline = underline
			self.dim = dim
			self.strike = strike
		}
	}

	// Returns text in a color, with optional attributes, for output that has
	// no theme role. The text comes back unchanged when the stream it is
	// meant for shows no colors (`colors(stream)`).
	//
	// Example: One-off styling
	// ```example
	// println(terminal.color("42", Ansi.Yellow, bold = true))
	// ```
	def color(text string, foreground Color, background ?Color = none, bold bool = false, italic bool = false, underline bool = false, dim bool = false, stream File = os.stdout) string {
		let depth = colors(stream)
		return text when depth == ColorDepth.None
		return paint(text, new TextStyle(foreground, background, bold, italic, underline, dim), depth)
	}

	// Returns the style function of a theme role: a function that gives text
	// the style the current theme holds for the role, or fallback when the
	// theme does not define it. The theme is read each time the function is
	// called, so `theme(...)` changes what functions made earlier produce.
	// The function styles for stream, and returns text unchanged when that
	// stream shows no colors.
	//
	// Example: An application's own role
	// ```example
	// const added = terminal.role("diffAdded", new TextStyle(Ansi.Green))
	// println(added("+ new line"))
	// ```
	def role(name string, fallback TextStyle, stream File = os.stdout) def (string) string {
		return (text string) => styled(name, fallback, text, stream)
	}

	// Styles text as an error.
	def failure(text string, stream File = os.stdout) string {
		return styled("failure", text, stream)
	}

	// Styles text as a warning.
	def warning(text string, stream File = os.stdout) string {
		return styled("warning", text, stream)
	}

	// Styles text as a success message.
	def success(text string, stream File = os.stdout) string {
		return styled("success", text, stream)
	}

	// Styles text as a neutral notice.
	def info(text string, stream File = os.stdout) string {
		return styled("info", text, stream)
	}

	// Styles text as a heading.
	def heading(text string, stream File = os.stdout) string {
		return styled("heading", text, stream)
	}

	// Styles text as emphasized.
	def emphasis(text string, stream File = os.stdout) string {
		return styled("emphasis", text, stream)
	}

	// Styles text as less important.
	def dim(text string, stream File = os.stdout) string {
		return styled("dim", text, stream)
	}

	// Styles text as a link.
	def link(text string, stream File = os.stdout) string {
		return styled("link", text, stream)
	}

	// Styles text as a link that opens target when clicked, on terminals with
	// hyperlinks (OSC 8); others show the styled text alone.
	def link(text string, target string, stream File = os.stdout) string {
		return text when colors(stream) == ColorDepth.None
		return hyperlink(styled("link", text, stream), target)
	}

	// Styles text as code: a command, a path, a name to type.
	def code(text string, stream File = os.stdout) string {
		return styled("code", text, stream)
	}

	// Styles text as a prompt for input.
	def prompt(text string, stream File = os.stdout) string {
		return styled("prompt", text, stream)
	}

	// Styles text for a standard role.
	internal def styled(role string, text string, stream File) string {
		let depth = colors(stream)
		return text when depth == ColorDepth.None
		return paint(text, styleOf(role), depth)
	}

	// Styles text for a role with its own fallback.
	internal def styled(role string, fallback TextStyle, text string, stream File) string {
		let depth = colors(stream)
		return text when depth == ColorDepth.None
		let themed = theme().get(role)
		return paint(text, fallback, depth) when themed is none
		return paint(text, themed, depth)
	}
}
