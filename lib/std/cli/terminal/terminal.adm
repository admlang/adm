// The terminal a program runs in: what it can show, styled text, key and
// line input, and screen control.
//
// Example: Styled output and a password
// ```example
// use std.cli.terminal
// use std.cli.terminal::(failure, heading)
//
// println("{heading("Deploy")} to production")
// let secret = try terminal.password("Password: ")
// println(failure("wrong password")) when secret.reveal() != expected
// ```
//
// Example: A full-screen program
// ```example
// terminal.alternateScreen(true)
// defer terminal.alternateScreen(false)
// terminal.raw(true)
// defer terminal.raw(false)
//
// terminal.clear()
// terminal.moveTo(0, 0)
// print("press q to quit")
// for {
//     let key = try terminal.readKey()
//     break when key.code == KeyCode.Char && key.text == "q"
// }
// ```
partial module std.cli.terminal {
	use (
		std.cli.terminal.native
		std.cli.terminal.sgr::*
		std.os
		std.os::(File)
	)

	// Size is a terminal's size in character cells.
	struct Size {
		columns int
		rows    int
	}

	// Reports whether a file is a terminal rather than a pipe or a file on
	// disk; false for a closed file.
	def isTTY(stream File = os.stdout) bool {
		let fd = stream.descriptor()
		return false when fd < 0
		return native.isTerminal(int32(fd)) != 0
	}

	// Returns the size of the terminal behind standard output, read anew each
	// call so it follows a resized window; none when standard output is not a
	// terminal.
	def size() ?Size {
		let cells int32[] = [0, 0]
		return none when native.windowSize(cells) == 0
		return Size{columns: int(cells[0]), rows: int(cells[1])}
	}

	// Returns how many colors text written to a file can use.
	// Nothing reports this reliably, so it is worked out from whether the
	// stream is a terminal and from the environment:
	//
	// - `NO_COLOR` set to anything: `None`.
	// - `FORCE_COLOR` or `CLICOLOR_FORCE`: `0` or `false` is `None`; `1` or
	//   `true` at least `Basic`, `2` `Ansi256`, `3` `TrueColor`, whether or
	//   not the stream is a terminal (CI logs).
	// - Not a terminal, or `TERM=dumb`: `None`.
	// - `COLORTERM` of `truecolor` or `24bit`: `TrueColor`.
	// - `TERM` containing `256color`: `Ansi256`.
	// - Any other terminal: `Basic`.
	def colors(stream File = os.stdout) ColorDepth {
		let fd = stream.descriptor()
		return streamDepth(isTTY(stream)) when fd < 0 || fd > 2
		if !depthKnown[fd] {
			depths[fd] = streamDepth(native.isTerminal(int32(fd)) != 0)
			depthKnown[fd] = true
		}
		return depths[fd]
	}

	// Turns raw input on or off. In raw mode keys reach the program one at a
	// time as they are pressed, nothing typed is echoed, and Ctrl+C is a key
	// like any other instead of ending the program; a newline written to the
	// terminal no longer returns to the first column, so write `\r\n`.
	//
	// Calls nest: the terminal leaves raw mode when every `raw(true)` has had
	// its `raw(false)`. A program that ends in raw mode, even by a signal or a
	// panic, has its terminal put back. Does nothing when the program has no
	// terminal.
	def raw(on bool) {
		native.mode(native.modeRaw, toggle(on))
	}

	// Switches to the alternate screen, an empty screen with no scrollback, or
	// back to the screen the program started on with its contents as they
	// were. Calls nest like `raw`, and a program that ends on the alternate
	// screen has its terminal put back. Does nothing when standard output is
	// not a terminal.
	def alternateScreen(on bool) {
		native.mode(native.modeAlternateScreen, toggle(on))
	}

	// Shows or hides the cursor. Each `showCursor(false)` is undone by one
	// `showCursor(true)`, and a program that ends with the cursor hidden has
	// it shown again. Does nothing when standard output is not a terminal.
	def showCursor(on bool) {
		native.mode(native.modeHideCursor, toggle(!on))
	}

	// Asks the terminal to mark pasted text, so that `readEvent` returns a
	// paste whole, as one `EventKind.Paste`, instead of as the keys it would
	// take to type it. Calls nest like `raw`, and a program that ends with
	// it on has its terminal put back. Does nothing when standard output is
	// not a terminal.
	def bracketedPaste(on bool) {
		native.mode(native.modeBracketedPaste, toggle(on))
	}

	// Asks the terminal to report the mouse: `readEvent` then returns
	// `EventKind.Mouse` for presses, releases, the wheel and moves with a
	// button held. While it is on the terminal's own text selection needs
	// Shift held. Calls nest like `raw`, and a program that ends with it on
	// has its terminal put back. Does nothing when standard output is not a
	// terminal.
	def mouse(on bool) {
		native.mode(native.modeMouse, toggle(on))
	}

	// Asks the terminal to report every move of the pointer, with or
	// without a button held, as `EventKind.Mouse` with `MouseAction.Move`;
	// used beside `mouse(true)`. Calls nest like `raw`, and a program that
	// ends with it on has its terminal put back. Does nothing when standard
	// output is not a terminal.
	def mouseMoves(on bool) {
		native.mode(native.modeMouseMoves, toggle(on))
	}

	// Asks the terminal to report keys unambiguously (the kitty keyboard
	// protocol): Escape is told from the start of a sequence without a
	// wait, and Ctrl+I, Ctrl+M and Ctrl+H from Tab, Enter and Backspace. A
	// terminal that does not know the protocol goes on as before. Calls
	// nest like `raw`, and a program that ends with it on has its terminal
	// put back. Does nothing when standard output is not a terminal.
	def extendedKeys(on bool) {
		native.mode(native.modeExtendedKeys, toggle(on))
	}

	// Asks the terminal to report every key as it goes down, repeats and
	// comes up (the kitty keyboard protocol with event types): `Key.action`
	// then says which, where without it every key event is a press. The
	// keys that only modify (Shift, Ctrl) and those `KeyCode` has no name
	// for arrive as `KeyCode.Unknown`. It includes what `extendedKeys`
	// asks for, and the two are turned off in any order. A terminal
	// that does not know the protocol goes on as before: `supports` tells.
	// Calls nest like `raw`, and a program that ends with it on has its
	// terminal put back. Does nothing when standard output is not a
	// terminal.
	def keyReleases(on bool) {
		native.mode(native.modeKeyEvents, toggle(on))
	}

	// Asks the terminal to hold what is drawn until this is turned off
	// again, so a screen redrawn in several writes appears at once. A
	// terminal that does not know the mode draws as it receives. Calls nest
	// like `raw`, and a program that ends with it on has its terminal put
	// back. Does nothing when standard output is not a terminal.
	def synchronizedOutput(on bool) {
		native.mode(native.modeSynchronizedOutput, toggle(on))
	}

	// Moves the cursor to a column and row, both counted from 0 at the top
	// left. Does nothing when standard output is not a terminal.
	def moveTo(column int, row int) {
		control("{esc}[{row + 1};{column + 1}H")
	}

	// Clears the screen and moves the cursor to the top left. Does nothing
	// when standard output is not a terminal.
	def clear() {
		control("{esc}[2J{esc}[H")
	}

	// Clears the line the cursor is on and moves the cursor to its first
	// column. Does nothing when standard output is not a terminal.
	def clearLine() {
		control("{esc}[2K\r")
	}

	// Writes a control sequence to standard output when it is a terminal.
	internal def control(sequence string) {
		return unless isTTY(os.stdout)
		os.stdout.write(sequence.bytes()) onerror recover 0
	}

	internal def toggle(on bool) int32 {
		return on ?? (int32(1), int32(0))
	}

	// The color depth of the three standard streams, worked out once each.
	internal let depths = ColorDepth[ColorDepth.None, ColorDepth.None, ColorDepth.None]
	internal let depthKnown = bool[false, false, false]
}
