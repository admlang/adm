partial module std.cli.terminal {
	use (
		std.cli.terminal.keys::*
		std.cli.pty
		std.cli.terminal.sgr::*
		std.formats.docs
		std.formats.image
		std.formats.docs::(Document, PlainText)
		std.gfx.color
		std.os
		std.testing
	)

	check "Terminal colors" {
		@test()
		def TestColorCodes() {
			let red Color = Ansi.Red
			assert red.sgr(ColorDepth.Basic) == "31"
			assert red.sgr(ColorDepth.Basic, true) == "41"
			assert red.sgr(ColorDepth.TrueColor) == "31"
			assert red.sgr(ColorDepth.None) == ""
			assert new Color(Ansi.BrightBlue).sgr(ColorDepth.Basic) == "94"
			assert new Color(Ansi.BrightBlue).sgr(ColorDepth.Basic, true) == "104"
			assert new Color(Ansi.Default).sgr(ColorDepth.Basic) == "39"
			assert new Color(Ansi.Default).sgr(ColorDepth.Basic, true) == "49"
			assert new Color(214).sgr(ColorDepth.Ansi256) == "38;5;214"
			assert new Color(214).sgr(ColorDepth.TrueColor, true) == "48;5;214"
			assert new Color(9).sgr(ColorDepth.Ansi256) == "91"
			assert new Color(300).sgr(ColorDepth.Ansi256) == "38;5;255"
			assert new Color(255, 135, 0).sgr(ColorDepth.TrueColor) == "38;2;255;135;0"
			assert new Color(999, -4, 0).sgr(ColorDepth.TrueColor) == "38;2;255;0;0"
		}

		@test()
		def TestColorsDegrade() {
			// Cube colors map onto themselves, grays onto the gray ramp.
			assert new Color(255, 135, 0).sgr(ColorDepth.Ansi256) == "38;5;208"
			assert new Color(0, 0, 0).sgr(ColorDepth.Ansi256) == "38;5;16"
			assert new Color(255, 255, 255).sgr(ColorDepth.Ansi256) == "38;5;231"
			assert new Color(128, 128, 128).sgr(ColorDepth.Ansi256) == "38;5;244"
			assert new Color(95, 215, 255).sgr(ColorDepth.Ansi256) == "38;5;81"
			// With only the palette, the nearest of its 16 colors.
			assert new Color(250, 10, 10).sgr(ColorDepth.Basic) == "91"
			assert new Color(200, 0, 0).sgr(ColorDepth.Basic) == "31"
			assert new Color(0, 0, 0).sgr(ColorDepth.Basic, true) == "40"
			assert new Color(196).sgr(ColorDepth.Basic) == "91"
			assert new Color(240).sgr(ColorDepth.Basic) == "90"
			let (r, g, b) = indexedRgb(81)
			assert r == 95 && g == 215 && b == 255
		}

		@test()
		def TestParseColor() !none {
			assert (try parseColor("red")).sgr(ColorDepth.Basic) == "31"
			assert (try parseColor("  Bright-Blue ")).sgr(ColorDepth.Basic) == "94"
			assert (try parseColor("brightBlue")).sgr(ColorDepth.Basic) == "94"
			assert (try parseColor("grey")).sgr(ColorDepth.Basic) == "90"
			assert (try parseColor("default")).sgr(ColorDepth.Basic) == "39"
			assert (try parseColor("214")).sgr(ColorDepth.Ansi256) == "38;5;214"
			assert (try parseColor("#5fd7ff")).sgr(ColorDepth.TrueColor) == "38;2;95;215;255"
			assert (try parseColor("#5DF")).sgr(ColorDepth.TrueColor) == "38;2;85;221;255"
			let bad = string["", "reddish", "#12", "#gggggg", "256", "#1234567"]
			for let (_, text) in bad {
				let failed = false
				parseColor(text) onerror (err error) {
					failed = true
					recover new Color(0)
				}
				assert failed
			}
			return none
		}

		@test()
		def TestColorDepthFromEnvironment() {
			assert depthFor(true, "", "", "xterm", "") == ColorDepth.Basic
			assert depthFor(true, "", "", "xterm-256color", "") == ColorDepth.Ansi256
			assert depthFor(true, "", "", "xterm-256color", "truecolor") == ColorDepth.TrueColor
			assert depthFor(true, "", "", "xterm", "24bit") == ColorDepth.TrueColor
			assert depthFor(true, "", "", "dumb", "") == ColorDepth.None
			assert depthFor(false, "", "", "xterm-256color", "truecolor") == ColorDepth.None
			assert depthFor(true, "1", "", "xterm-256color", "truecolor") == ColorDepth.None
			assert depthFor(true, "1", "3", "xterm-256color", "truecolor") == ColorDepth.None
			assert depthFor(true, "", "0", "xterm-256color", "") == ColorDepth.None
			assert depthFor(false, "", "1", "xterm", "") == ColorDepth.Basic
			assert depthFor(false, "", "true", "dumb", "") == ColorDepth.Basic
			assert depthFor(false, "", "1", "xterm-256color", "") == ColorDepth.Ansi256
			assert depthFor(false, "", "2", "", "") == ColorDepth.Ansi256
			assert depthFor(false, "", "3", "", "") == ColorDepth.TrueColor
			assert ColorDepth.TrueColor.value == 16777216
			assert ColorDepth.None.value == 0
		}
	}

	check "Terminal styles" {
		@test()
		def TestPaint() {
			let e = esc
			assert paint("x", new TextStyle(Ansi.Red, bold = true), ColorDepth.Basic) == "{e}[1;31mx{e}[22;39m"
			assert paint("x", new TextStyle(dim = true), ColorDepth.Basic) == "{e}[2mx{e}[22m"
			let full = new TextStyle(Ansi.Green, Ansi.Black, italic = true, underline = true)
			assert paint("x", full, ColorDepth.Basic) == "{e}[3;4;32;40mx{e}[23;24;39;49m"
			assert paint("x", new TextStyle(new Color(95, 215, 255)), ColorDepth.TrueColor) == "{e}[38;2;95;215;255mx{e}[39m"
			assert paint("x", new TextStyle(strike = true), ColorDepth.Basic) == "{e}[9mx{e}[29m"
			// Nothing to turn on: the text as it is.
			assert paint("x", new TextStyle(), ColorDepth.TrueColor) == "x"
			assert paint("x", new TextStyle(Ansi.Red, bold = true), ColorDepth.None) == "x"
			assert paint("", new TextStyle(Ansi.Red), ColorDepth.Basic) == ""
		}

		@test()
		def TestNestedStylesKeepTheOuterOne() {
			let e = esc
			let inner = paint("b", new TextStyle(Ansi.Blue, bold = true), ColorDepth.Basic)
			let outer = paint("a {inner} c", new TextStyle(Ansi.Red, bold = true), ColorDepth.Basic)
			assert outer == "{e}[1;31ma {e}[1;34mb{e}[22;39m{e}[1;31m c{e}[22;39m"
			// A sequence that only turns things on is left alone.
			assert reopenAfterSpans("{e}[1mx", "{e}[31m") == "{e}[1mx"
			assert turnsOff("22;39") && turnsOff("0") && !turnsOff("1;31") && !turnsOff("22;31")
		}

		@test()
		def TestHyperlink() {
			let e = esc
			assert hyperlink("docs", "https://adm-lang.dev") == "{e}]8;;https://adm-lang.dev{e}\\docs{e}]8;;{e}\\"
		}

		// A test run's output is a pipe, so every styling call gives plain text
		// back unless the environment forces colors.
		@test()
		def TestPlainWhenNotATerminal() {
			return unless colors() == ColorDepth.None && colors(os.stderr) == ColorDepth.None
			assert failure("x") == "x"
			assert warning("x") == "x"
			assert info("x") == "x"
			assert emphasis("x") == "x"
			assert prompt("x") == "x"
			assert code("x") == "x"
			assert heading("x", os.stderr) == "x"
			assert link("docs", "https://adm-lang.dev") == "docs"
			assert color("x", Ansi.Red, bold = true) == "x"
			const added = role("diffAdded", new TextStyle(Ansi.Green))
			assert added("+ line") == "+ line"
			assert "{success("ok")} {dim("2s")}" == "ok 2s"
		}

		@test()
		def TestNotATerminal() {
			return when isTTY()
			assert size() is none
			assert !isTTY(os.stdout)
			// Mode switches and screen control do nothing without a terminal.
			alternateScreen(true)
			alternateScreen(false)
			showCursor(false)
			showCursor(true)
			moveTo(3, 4)
			clear()
			clearLine()
		}
	}

	check "Terminal documents" {
		internal def sample() Document {
			let doc = new Document()
			doc.heading(1, "Title")
			doc.paragraph(docs.text("a "), docs.bold("b"), docs.text(" "), docs.code("c"), docs.text(" "), docs.link("site", "https://a.example"), docs.text(" "), docs.styled("bad", "failure"))
			doc.rule()
			return doc
		}

		@test()
		def TestDocumentWithoutColorsIsPlainText() {
			let layout = new PlainText()
			layout.width = 30
			let doc = sample()
			assert rendered(doc, 30, ColorDepth.None) == layout.encode(doc)
			assert rendered(doc, 30, ColorDepth.None).contains("a *b* c site") && rendered(doc, 30, ColorDepth.None).contains("<https://a.example>")
			assert render(doc, os.stdout, 30) == layout.encode(doc) unless isTTY(os.stdout)
		}

		@test()
		def TestDocumentStyledForATerminal() {
			let e = esc
			let lines = rendered(sample(), 30, ColorDepth.Basic).split("\n")
			let (headOpen, headClose) = (new TerminalMarks(ColorDepth.Basic)).around(styleOf("heading"))
			assert headOpen != "" && lines[0] == headOpen + "Title" + headClose
			assert lines[1] == headOpen + "═════" + headClose
			let body = lines[3]
			assert body.startsWith("a {e}[1mb{e}[22m ")
			assert body.contains(paint("c", styleOf("code"), ColorDepth.Basic))
			assert body.contains(hyperlink(paint("site", styleOf("link"), ColorDepth.Basic), "https://a.example"))
			assert body.endsWith(paint("bad", styleOf("failure"), ColorDepth.Basic))
			assert !body.contains("*b*") && !body.contains("<https")
			let struck = new Document()
			struck.paragraph(docs.strike("old"))
			assert rendered(struck, 30, ColorDepth.Basic) == "{e}[9mold{e}[29m\n"
			assert lines[5] == paint("─".repeat(30), styleOf("dim"), ColorDepth.Basic)
		}

		@test()
		def TestDocumentColorsAreKept() {
			let doc = new Document()
			doc.paragraph(docs.colored("warm", new color.Color("#ff8800")))
			assert rendered(doc, 30, ColorDepth.TrueColor) == paint("warm", new TextStyle(new Color(255, 136, 0)), ColorDepth.TrueColor) + "\n"
		}
	}

	check "Terminal files" {
		// A file on disk is no terminal, whatever the standard streams are.
		@test()
		def TestFileOnDiskIsNotATerminal() !none {
			let path = os.join(try os.appHome(), "terminal-file-test.txt")
			try os.writeFile(path, "x".bytes())
			defer os.remove(path)
			let file = try os.open(path)
			assert file.descriptor() > 2
			assert !isTTY(file)
			assert colors(file) == depthFor(false, envNoColor, envForceColor != "" ?? (envForceColor, envCliColorForce), envTerm, envColorTerm)
			try file.close()
			assert file.descriptor() < 0
			assert !isTTY(file)
			assert os.stdin.descriptor() == 0 && os.stdout.descriptor() == 1 && os.stderr.descriptor() == 2
			return none
		}
	}

	check "Terminal themes" {
		@test()
		def TestDefaultThemeDefinesTheStandardRoles() {
			let standard = string["failure", "warning", "success", "info", "heading", "emphasis", "dim", "link", "code", "prompt"]
			let themes = Theme[defaultTheme(), darkTheme(), lightTheme()]
			for let (_, made) in themes {
				for let (_, name) in standard {
					assert !(made.get(name) is none)
				}
				assert made.roles().len() == standard.len()
			}
		}

		@test()
		def TestThemeSwitchReachesExistingStyles() {
			let before = theme()
			defer theme(before)
			let mine = new Theme()
			mine.set("failure", new TextStyle(Ansi.Magenta))
			theme(mine)
			assert paint("x", styleOf("failure"), ColorDepth.Basic) == "{esc}[35mx{esc}[39m"
			// A role the theme leaves out keeps its default.
			assert paint("x", styleOf("success"), ColorDepth.Basic) == "{esc}[32mx{esc}[39m"
			// An unknown role has no style.
			assert paint("x", styleOf("nonsense"), ColorDepth.Basic) == "x"
			theme(before)
			assert paint("x", styleOf("failure"), ColorDepth.Basic) == "{esc}[1;31mx{esc}[22;39m"
		}

		@test()
		def TestAutoThemeWithoutATerminal() {
			return when isTTY()
			assert autoTheme().roles().len() == defaultTheme().roles().len()
		}

		@test()
		def TestLoadTheme() !none {
			let path = os.join(try os.appHome(), "terminal-theme-test.toml")
			try os.writeFile(path, "[code]\ncolor = \"214\"\n".bytes())
			defer os.remove(path)
			let made = try loadTheme(path)
			let look = made.get("code")
			fail "code is missing" when look is none
			assert paint("x", look, ColorDepth.Ansi256) == "{esc}[38;5;214mx{esc}[39m"
			let missing = false
			loadTheme(path + ".none") onerror (err error) {
				missing = true
				recover new Theme()
			}
			assert missing
			return none
		}

		@test()
		def TestParseTheme() !none {
			let made = try parseTheme("""
[failure]
color = "red"
bold = true

[heading]
color = "#5fd7ff"
underline = true

[diffAdded]
color = "green"
background = "236"
""")
			assert made.roles().len() == 3
			let failed = made.get("failure")
			fail "failure is missing" when failed is none
			assert paint("x", failed, ColorDepth.Basic) == "{esc}[1;31mx{esc}[22;39m"
			let head = made.get("heading")
			fail "heading is missing" when head is none
			assert paint("x", head, ColorDepth.TrueColor) == "{esc}[4;38;2;95;215;255mx{esc}[24;39m"
			let added = made.get("diffAdded")
			fail "diffAdded is missing" when added is none
			assert paint("x", added, ColorDepth.Ansi256) == "{esc}[32;48;5;236mx{esc}[39;49m"
			assert made.get("warning") is none

			let refused = 0
			let broken = string["failure = 3", "[failure]\ncolor = \"reddish\"", "[failure"]
			for let (_, text) in broken {
				parseTheme(text) onerror (err error) {
					refused++
					recover new Theme()
				}
			}
			assert refused == 3
			return none
		}

		@test()
		def TestBackgroundLightness() {
			let light = lightness("{esc}]11;rgb:ffff/ffff/ffff{esc}\\")
			assert !(light is none) && light == true
			let dark = lightness("{esc}]11;rgb:1e1e/1e1e/2e2e\u0007")
			assert !(dark is none) && dark == false
			let short = lightness("{esc}]11;rgb:f/f/f{esc}\\")
			assert !(short is none) && short == true
			assert lightness("") is none
			assert lightness("{esc}]11;rgb:zz/00/00") is none
			assert lightness("{esc}]11;rgb:ffff/ffff") is none
		}
	}

	check "Terminal keys" {
		def press(bytes byte[], complete bool = false) Key {
			let (used, key) = decodeKey(bytes, bytes.len(), complete)
			assert used == bytes.len()
			return key
		}

		def pending(bytes byte[]) bool {
			let (used, _) = decodeKey(bytes, bytes.len(), false)
			return used == 0
		}

		@test()
		def TestPlainKeys() {
			let a = press(byte[0x61])
			assert a.code == KeyCode.Char && a.text == "a" && !a.ctrl && !a.alt && !a.shift
			assert press(byte[0x0d]).code == KeyCode.Enter
			assert press(byte[0x0a]).code == KeyCode.Enter
			assert press(byte[0x09]).code == KeyCode.Tab
			assert press(byte[0x7f]).code == KeyCode.Backspace
			let ctrlC = press(byte[0x03])
			assert ctrlC.code == KeyCode.Char && ctrlC.text == "c" && ctrlC.ctrl
			let ctrlSpace = press(byte[0x00])
			assert ctrlSpace.text == " " && ctrlSpace.ctrl
			let ctrlBackslash = press(byte[0x1c])
			assert ctrlBackslash.text == "\\" && ctrlBackslash.ctrl
		}

		@test()
		def TestUtf8Keys() {
			let e = press("é".bytes())
			assert e.code == KeyCode.Char && e.text == "é"
			let globe = press("🌍".bytes())
			assert globe.code == KeyCode.Char && globe.text == "🌍"
			// Half a character waits for the rest.
			let half = "🌍".bytes()[0:2]
			assert pending(half)
			assert press(half, true).code == KeyCode.Unknown
			// Two keys in one read decode one at a time.
			let two = "ab".bytes()
			let (used, first) = decodeKey(two, two.len(), false)
			assert used == 1 && first.text == "a"
		}

		// The event the bytes decode to, and how many of them it took.
		internal def reported(data byte[], complete bool = false) (int, Event) {
			return decodeEvent(data, data.len(), complete)
		}

		@test()
		def TestPastedText() {
			let whole = byte[] + pasteStart + "two\nlines é".bytes() + pasteEnd + "x".bytes()
			let (used, event) = reported(whole)
			assert used == whole.len() - 1 && event.kind == EventKind.Paste && event.text == "two\nlines é"
			// An unfinished paste waits for its end, however long it is.
			let open = byte[] + pasteStart + "abc".bytes()
			let (waiting, _) = reported(open)
			assert waiting == 0
			let (taken, cut) = reported(open, true)
			assert taken == open.len() && cut.kind == EventKind.Paste && cut.text == "abc"
			let (bareUsed, bare) = reported(byte[] + pasteStart + pasteEnd)
			assert bareUsed == 12 && bare.kind == EventKind.Paste && bare.text == ""
		}

		@test()
		def TestMouseReports() {
			let (used, press) = reported("\u001b[<0;12;5M".bytes())
			assert used == 10 && press.kind == EventKind.Mouse
			assert press.mouse.column == 11 && press.mouse.row == 4
			assert press.mouse.button == MouseButton.Left && press.mouse.action == MouseAction.Press
			let (_, release) = reported("\u001b[<2;1;1m".bytes())
			assert release.mouse.button == MouseButton.Right && release.mouse.action == MouseAction.Release
			assert release.mouse.column == 0 && release.mouse.row == 0
			let (_, drag) = reported("\u001b[<32;3;4M".bytes())
			assert drag.mouse.button == MouseButton.Left && drag.mouse.action == MouseAction.Move
			let (_, wheel) = reported("\u001b[<65;3;4M".bytes())
			assert wheel.mouse.button == MouseButton.WheelDown && wheel.mouse.action == MouseAction.Press
			let (_, held) = reported("\u001b[<21;3;4M".bytes())
			assert held.mouse.button == MouseButton.Middle && held.mouse.ctrl && held.mouse.shift && !held.mouse.alt
			let (unfinished, _) = reported("\u001b[<0;12".bytes())
			assert unfinished == 0
		}

		@test()
		def TestReplyCutFromWhatWasTyped() {
			let lead = "\u001b]52;c;".bytes()
			let data = byte[] + "ab".bytes() + lead + "aGk=".bytes() + byte[0x1b, 0x5c] + "z".bytes()
			let (answer, before, after, whole) = cutReply(data, lead)
			assert whole && answer == "\u001b]52;c;aGk=" && string(before) == "ab" && string(after) == "z"
			let (belAnswer, _, belAfter, belWhole) = cutReply(byte[] + lead + "x".bytes() + byte[0x07], lead)
			assert belWhole && belAnswer == "\u001b]52;c;x" && belAfter.len() == 0
			let (_, _, _, unfinished) = cutReply(byte[] + lead + "aGk".bytes(), lead)
			assert !unfinished
			let (_, _, _, absent) = cutReply("typed".bytes(), lead)
			assert !absent
			let (_, moved) = reported("\u001b[<35;7;2M".bytes())
			assert moved.mouse.button == MouseButton.None && moved.mouse.action == MouseAction.Move && moved.mouse.column == 6
		}

		@test()
		def TestKeysAmongEvents() {
			let (used, event) = reported(byte[0x1b, 0x5b, 0x41, 0x61])
			assert used == 3 && event.kind == EventKind.Key && event.key.code == KeyCode.Up
			// Keys as the kitty keyboard protocol reports them.
			let (_, escape) = reported("\u001b[27u".bytes())
			assert escape.key.code == KeyCode.Escape
			let (_, ctrlI) = reported("\u001b[105;5u".bytes())
			assert ctrlI.key.code == KeyCode.Char && ctrlI.key.text == "i" && ctrlI.key.ctrl
			let (_, shiftEnter) = reported("\u001b[13;2u".bytes())
			assert shiftEnter.key.code == KeyCode.Enter && shiftEnter.key.shift
		}

		@test()
		def TestEscapeSequences() {
			assert press(byte[0x1b, 0x5b, 0x41]).code == KeyCode.Up
			assert press(byte[0x1b, 0x5b, 0x42]).code == KeyCode.Down
			assert press(byte[0x1b, 0x5b, 0x43]).code == KeyCode.Right
			assert press(byte[0x1b, 0x5b, 0x44]).code == KeyCode.Left
			assert press(byte[0x1b, 0x5b, 0x48]).code == KeyCode.Home
			assert press(byte[0x1b, 0x5b, 0x46]).code == KeyCode.End
			assert press("{esc}[3~".bytes()).code == KeyCode.Delete
			assert press("{esc}[2~".bytes()).code == KeyCode.Insert
			assert press("{esc}[5~".bytes()).code == KeyCode.PageUp
			assert press("{esc}[6~".bytes()).code == KeyCode.PageDown
			assert press("{esc}[1~".bytes()).code == KeyCode.Home
			assert press("{esc}[15~".bytes()).code == KeyCode.F5
			assert press("{esc}[17~".bytes()).code == KeyCode.F6
			assert press("{esc}[24~".bytes()).code == KeyCode.F12
			assert press("{esc}OP".bytes()).code == KeyCode.F1
			assert press("{esc}OS".bytes()).code == KeyCode.F4
			assert press("{esc}OA".bytes()).code == KeyCode.Up
			let back = press("{esc}[Z".bytes())
			assert back.code == KeyCode.Tab && back.shift
			let unknown = press("{esc}[99~".bytes())
			assert unknown.code == KeyCode.Unknown && unknown.text == "{esc}[99~"
		}

		@test()
		def TestModifiers() {
			let ctrlUp = press("{esc}[1;5A".bytes())
			assert ctrlUp.code == KeyCode.Up && ctrlUp.ctrl && !ctrlUp.alt && !ctrlUp.shift
			let shiftAltLeft = press("{esc}[1;4D".bytes())
			assert shiftAltLeft.code == KeyCode.Left && shiftAltLeft.shift && shiftAltLeft.alt && !shiftAltLeft.ctrl
			let ctrlDelete = press("{esc}[3;5~".bytes())
			assert ctrlDelete.code == KeyCode.Delete && ctrlDelete.ctrl
			let shiftF1 = press("{esc}[1;2P".bytes())
			assert shiftF1.code == KeyCode.F1 && shiftF1.shift
			let altX = press(byte[0x1b, 0x78])
			assert altX.code == KeyCode.Char && altX.text == "x" && altX.alt
			let altEnter = press(byte[0x1b, 0x0d])
			assert altEnter.code == KeyCode.Enter && altEnter.alt
			let csiU = press("{esc}[97;5u".bytes())
			assert csiU.code == KeyCode.Char && csiU.text == "a" && csiU.ctrl
		}

		@test()
		def TestEscapeAloneOrUnfinished() {
			// A lone escape byte may start a sequence: it waits, then is the key.
			assert pending(byte[0x1b])
			assert press(byte[0x1b], true).code == KeyCode.Escape
			assert pending(byte[0x1b, 0x5b])
			assert pending("{esc}[1;5".bytes())
			assert press("{esc}[1;5".bytes(), true).code == KeyCode.Unknown
			assert pending(byte[0x1b, 0x4f])
			let altO = press(byte[0x1b, 0x4f], true)
			assert altO.code == KeyCode.Char && altO.text == "O" && altO.alt
		}

		@test()
		def TestKeysThatRepeatAndComeUp() {
			// `a` down, held and up, with the text it types.
			let down = press("\u001b[97;1:1;97u".bytes(), false)
			assert down.code == KeyCode.Char && down.text == "a" && down.action == KeyAction.Press
			assert press("\u001b[97;1:2;97u".bytes(), false).action == KeyAction.Repeat
			let up = press("\u001b[97;1:3u".bytes(), false)
			assert up.code == KeyCode.Char && up.text == "a" && up.action == KeyAction.Release && !up.shift
			// Shift+a types `A`: by the text sent, or by the shifted key.
			let typed = press("\u001b[97:65;2;65u".bytes(), false)
			assert typed.text == "A" && typed.shift
			assert press("\u001b[97:65;2u".bytes(), false).text == "A"
			assert press("\u001b[97:65;1u".bytes(), false).text == "a"
			// Ctrl+C stays the letter with Ctrl held.
			let stop = press("\u001b[99;5u".bytes(), false)
			assert stop.code == KeyCode.Char && stop.text == "c" && stop.ctrl && stop.action == KeyAction.Press
			// Arrows and Enter carry the event type too.
			let arrow = press("\u001b[1;1:3A".bytes(), false)
			assert arrow.code == KeyCode.Up && arrow.action == KeyAction.Release && !arrow.shift
			let enter = press("\u001b[13;1:3u".bytes(), false)
			assert enter.code == KeyCode.Enter && enter.action == KeyAction.Release
			// The keypad, and a key with no name: left Shift going down.
			assert press("\u001b[57404u".bytes(), false).text == "5"
			assert press("\u001b[57413u".bytes(), false).text == "+"
			assert press("\u001b[57414u".bytes(), false).code == KeyCode.Enter
			assert press("\u001b[57421u".bytes(), false).code == KeyCode.PageUp
			let shift = press("\u001b[57441;2u".bytes(), false)
			assert shift.code == KeyCode.Unknown && shift.text == "\u001b[57441;2u"
			assert press("\u001b[57441;1:3u".bytes(), false).action == KeyAction.Release
			// A plain key press is a press.
			assert press("a".bytes(), false).action == KeyAction.Press
		}

		@test()
		def TestWhatTheTerminalSaysItKnows() {
			let answer = "x\u001b[?27u\u001b[?2026;2$y\u001b[?2004;1$y\u001b[?1006;0$y\u001b[?1003;4$yy\u001b[?62;4c".bytes()
			let (replies, typed, whole) = repliesIn(answer)
			assert whole && replies.len() == 6 && string(typed) == "xy"
			assert featureIn(replies, Feature.ExtendedKeys)
			assert featureIn(replies, Feature.SynchronizedOutput)
			assert featureIn(replies, Feature.BracketedPaste)
			assert !featureIn(replies, Feature.Mouse)
			assert !featureIn(replies, Feature.MouseMoves)
			// A terminal that answers only what every terminal answers.
			let (plain, _, done) = repliesIn("\u001b[?1;2c".bytes())
			assert done && !featureIn(plain, Feature.ExtendedKeys) && !featureIn(plain, Feature.BracketedPaste)
			// Part of an answer is not the whole of it.
			let (_, _, ended) = repliesIn("\u001b[?27u\u001b[?20".bytes())
			assert !ended
		}
	}

	check "Terminal pictures" {
		@test()
		def TestThePictureAsEachProtocolTakesIt() {
			let small = byte[1, 2, 3]
			assert kittyImage(small, 0, 0) == "\u001b_Ga=T,f=100,q=2,m=0;AQID\u001b\\"
			assert kittyImage(small, 40, 10) == "\u001b_Ga=T,f=100,q=2,c=40,r=10,m=0;AQID\u001b\\"
			// More than 4096 characters of Base64 go in pieces.
			let large byte[] = []
			large.len(7000)
			let pieces = kittyImage(large, 0, 0).split("\u001b\\")
			assert pieces.len() == 4 && pieces[3] == ""
			assert pieces[0].startsWith("\u001b_Ga=T,f=100,q=2,m=1;") && pieces[0].len() == 21 + 4096
			assert pieces[1].startsWith("\u001b_Gm=1;") && pieces[2].startsWith("\u001b_Gm=0;")
			assert itermImage(small, 0, 0) == "\u001b]1337;File=inline=1;size=3;preserveAspectRatio=1:AQID\u0007"
			assert itermImage(small, 40, 0) == "\u001b]1337;File=inline=1;size=3;preserveAspectRatio=1;width=40:AQID\u0007"
		}

		@test()
		def TestWhichProtocolATerminalTakes() {
			let (kitty, typed, whole) = repliesIn("a\u001b_Gi=31;OK\u001b\\b\u001b[?62c".bytes())
			assert whole && kitty.len() == 2 && string(typed) == "ab"
			assert protocolFrom(kitty, "", "") == ImageProtocol.Kitty
			assert protocolFrom(kitty, "WezTerm", "") == ImageProtocol.Kitty
			let (plain, _, _) = repliesIn("\u001b[?62c".bytes())
			assert protocolFrom(plain, "", "") == ImageProtocol.None
			assert protocolFrom(plain, "iTerm.app", "") == ImageProtocol.ITerm
			assert protocolFrom(plain, "", "iTerm2") == ImageProtocol.ITerm
			assert protocolFrom(plain, "xterm", "") == ImageProtocol.None
			// A terminal that refuses the query does not take pictures that way.
			let (refused, _, _) = repliesIn("\u001b_Gi=31;ENOTSUPPORTED\u001b\\\u001b[?62c".bytes())
			assert protocolFrom(refused, "", "") == ImageProtocol.None
		}
	}

	check "Terminal on a pseudo-terminal" {
		@test()
		def TestRawModeNestsAndIsPutBack() !none {
			let screen = try pty.open()
			defer screen.close()
			assert isTTY(os.stdout) && isTTY(os.stdin)
			assert screen.isCooked() && screen.echoes()
			raw(true)
			raw(true)
			assert !screen.isCooked() && !screen.echoes()
			raw(false)
			assert !screen.isCooked()
			raw(false)
			assert screen.isCooked() && screen.echoes()
			return none
		}

		@test()
		def TestSizeAndResize() !none {
			let screen = try pty.open(100, 30)
			defer screen.close()
			let cells = size()
			fail "no size" when cells is none
			assert cells.columns == 100 && cells.rows == 30
			screen.pressWhenRaw("a")
			let first = try readEvent()
			assert first.kind == EventKind.Key && first.key.text == "a"
			screen.resize(60, 20)
			let second = try readEvent(2s)
			fail "no resize" when second is none
			assert second.kind == EventKind.Resize && second.size.columns == 60 && second.size.rows == 20
			return none
		}

		@test()
		def TestKeysAreReadAsTyped() !none {
			let screen = try pty.open()
			defer screen.close()
			screen.pressWhenRaw("a\u001b[A\u0003é\r")
			let letter = try readKey()
			assert letter.code == KeyCode.Char && letter.text == "a"
			assert (try readKey()).code == KeyCode.Up
			let stop = try readKey()
			assert stop.code == KeyCode.Char && stop.text == "c" && stop.ctrl
			assert (try readKey()).text == "é"
			assert (try readKey()).code == KeyCode.Enter
			// Nothing more: a wait runs out, and a lone escape is the key.
			assert (try readKey(20ms)) is none
			screen.pressWhenRaw("\u001b")
			let lone = try readKey(1s)
			fail "no key" when lone is none
			assert lone.code == KeyCode.Escape
			assert screen.isCooked()
			return none
		}

		@test()
		def TestPasteMouseAndTheSwitchesTheyNeed() !none {
			let screen = try pty.open()
			defer screen.close()
			bracketedPaste(true)
			mouse(true)
			screen.pressWhenRaw("\u001b[200~two\nlines\u001b[201~\u001b[<0;5;3M")
			let pasted = try readEvent()
			assert pasted.kind == EventKind.Paste && pasted.text == "two\nlines"
			let click = try readEvent()
			assert click.kind == EventKind.Mouse && click.mouse.column == 4 && click.mouse.row == 2 && click.mouse.button == MouseButton.Left
			mouse(false)
			bracketedPaste(false)
			let drawn = screen.output()
			assert drawn.startsWith("\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1006h")
			assert drawn.endsWith("\u001b[?1006l\u001b[?1002l\u001b[?1000l\u001b[?2004l")
			return none
		}

		@test()
		def TestKeyReleasesAndTheScreenSwitches() !none {
			let screen = try pty.open()
			defer screen.close()
			extendedKeys(true)
			keyReleases(true)
			screen.pressWhenRaw("\u001b[97;1:3u")
			let up = try readKey()
			assert up.text == "a" && up.action == KeyAction.Release
			keyReleases(false)
			extendedKeys(false)
			alternateScreen(true)
			showCursor(false)
			synchronizedOutput(true)
			synchronizedOutput(false)
			showCursor(true)
			alternateScreen(false)
			assert screen.output() == "\u001b[>1u\u001b[>27u\u001b[<u\u001b[<u\u001b[?1049h\u001b[?25l\u001b[?2026h\u001b[?2026l\u001b[?25h\u001b[?1049l"
			return none
		}

		@test()
		def TestAKeyNobodyTypesEndsWithTheTerminal() !none {
			let screen = try pty.open(80, 24, 50ms)
			defer screen.close()
			let message = ""
			readKey() onerror (err error) {
				message = err.message
				recover Key{}
			}
			assert message != ""
			return none
		}

		@test()
		def TestAPictureIsDrawnTheWayTheTerminalAnswers() !none {
			let screen = try pty.open()
			defer screen.close()
			screen.pressWhenRaw("\u001b_Gi=31;OK\u001b\\\u001b[?62;4c")
			assert imageProtocol() == ImageProtocol.Kitty
			assert try drawImage(new image.Image(2, 2), 10, 0)
			let drawn = screen.output()
			assert drawn.startsWith(imageQuery + "\u001b[c")
			assert drawn.contains("\u001b_Ga=T,f=100,q=2,c=10,m=0;iVBORw0KGgo") && drawn.endsWith("\u001b\\\r\r\n")
			assert screen.isCooked()
			return none
		}

		@test()
		def TestLineAndPassword() !none {
			let screen = try pty.open()
			defer screen.close()
			screen.press("Ada\n")
			assert (try input("Name: ")) == "Ada"
			screen.pressWhenHidden("hunter2\n")
			let secret = try password("Password: ")
			assert screen.echoes()
			let drawn = screen.output()
			assert drawn.contains("Name: ") && drawn.contains("Password: ")
			// The name was echoed by the terminal, the password was not.
			assert drawn.contains("Ada") && !drawn.contains("hunter2")
			assert secret.reveal() == "hunter2"
			return none
		}
	}
}
