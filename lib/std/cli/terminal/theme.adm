partial module std.cli.terminal {
	use (
		std.cli.terminal.sgr::*
		std.data.encoding::(TOML, TOMLTable)
		std.os
	)

	// Theme maps role names to text styles. The role functions (`failure`,
	// `heading`, the ones `role` returns) look their role up in the current
	// theme each time they style text, so one `theme(...)` call restyles a
	// whole program, generated help included.
	//
	// The standard roles are `failure`, `warning`, `success`, `info`,
	// `heading`, `emphasis`, `dim`, `link`, `code` and `prompt`. A role a
	// theme does not define keeps its default style.
	//
	// Example: Restyling one role
	// ```example
	// let mine = new Theme()
	// mine.set("failure", new TextStyle(Ansi.Magenta, bold = true))
	// terminal.theme(mine)
	// ```
	type Theme {
		internal styles map<string, TextStyle>

		// A theme that defines no role: every role keeps its default style.
		def new() {
			styles = map<string, TextStyle>{}
		}

		// The style of a role, or none when the theme does not define it.
		def get(role string) ?TextStyle {
			return styles.get(role)
		}

		// Defines or replaces the style of a role.
		def set(role string, look TextStyle) {
			styles[role] = look
		}

		// The roles the theme defines.
		def roles() string[] {
			return styles.keys()
		}
	}

	// The theme the role functions use; none until one is set or asked for.
	internal let currentTheme ?Theme = none

	// Returns the current theme. Until `theme(next)` is called it is
	// `defaultTheme()`.
	def theme() Theme {
		let current = currentTheme
		return current unless current is none
		let made = defaultTheme()
		currentTheme = made
		return made
	}

	// Makes next the current theme. Text styled from now on follows it,
	// including by style functions that already exist; text already styled
	// does not change.
	def theme(next Theme) {
		currentTheme = next
	}

	// The theme programs start with. It uses only the 16 palette colors, which
	// follow the user's own terminal theme, so output fits any terminal.
	def defaultTheme() Theme {
		let made = new Theme()
		made.set("failure", new TextStyle(Ansi.Red, bold = true))
		made.set("warning", new TextStyle(Ansi.Yellow))
		made.set("success", new TextStyle(Ansi.Green))
		made.set("info", new TextStyle(Ansi.Cyan))
		made.set("heading", new TextStyle(bold = true))
		made.set("emphasis", new TextStyle(italic = true))
		made.set("dim", new TextStyle(dim = true))
		made.set("link", new TextStyle(Ansi.Blue, underline = true))
		made.set("code", new TextStyle(Ansi.Magenta))
		made.set("prompt", new TextStyle(Ansi.Cyan, bold = true))
		return made
	}

	// A theme with fixed colors chosen for a dark background.
	def darkTheme() Theme {
		let made = new Theme()
		made.set("failure", new TextStyle(new Color(255, 107, 107), bold = true))
		made.set("warning", new TextStyle(new Color(255, 203, 107)))
		made.set("success", new TextStyle(new Color(152, 216, 122)))
		made.set("info", new TextStyle(new Color(95, 215, 255)))
		made.set("heading", new TextStyle(new Color(255, 255, 255), bold = true))
		made.set("emphasis", new TextStyle(italic = true))
		made.set("dim", new TextStyle(new Color(138, 138, 138)))
		made.set("link", new TextStyle(new Color(130, 170, 255), underline = true))
		made.set("code", new TextStyle(new Color(199, 146, 234)))
		made.set("prompt", new TextStyle(new Color(95, 215, 255), bold = true))
		return made
	}

	// A theme with fixed colors chosen for a light background.
	def lightTheme() Theme {
		let made = new Theme()
		made.set("failure", new TextStyle(new Color(196, 30, 30), bold = true))
		made.set("warning", new TextStyle(new Color(156, 93, 0)))
		made.set("success", new TextStyle(new Color(24, 120, 40)))
		made.set("info", new TextStyle(new Color(0, 110, 150)))
		made.set("heading", new TextStyle(new Color(0, 0, 0), bold = true))
		made.set("emphasis", new TextStyle(italic = true))
		made.set("dim", new TextStyle(new Color(108, 108, 108)))
		made.set("link", new TextStyle(new Color(20, 80, 200), underline = true))
		made.set("code", new TextStyle(new Color(130, 50, 160)))
		made.set("prompt", new TextStyle(new Color(0, 110, 150), bold = true))
		return made
	}

	// The theme that fits the terminal's background: `lightTheme()` on a light
	// background, `darkTheme()` on a dark one, `defaultTheme()` when the
	// terminal does not say (it is asked with OSC 11 and given a fifth of a
	// second to answer) or standard output is not a terminal.
	def autoTheme() Theme {
		let light = backgroundIsLight()
		return defaultTheme() when light is none
		return light ?? (lightTheme(), darkTheme())
	}

	// Reads a theme from TOML text: one table per role, with the keys `color`
	// and `background` (colors as `parseColor` reads them) and `bold`,
	// `italic`, `underline`, `dim`, `strike` (booleans).
	//
	// ```toml
	// [failure]
	// color = "red"
	// bold = true
	//
	// [heading]
	// color = "#5fd7ff"
	// underline = true
	// ```
	//
	// Fails when the text is not TOML, a role is not a table, or a color
	// cannot be read.
	def parseTheme(text string) !Theme {
		let document = new TOMLTable()
		try (new TOML()).decode(text, document)
		let made = new Theme()
		for let (_, role) in document.keys() {
			let entry = document.table(role)
			fail "terminal: theme role '{role}' is not a table" when entry is none
			made.set(role, try themeStyle(entry))
		}
		return made
	}

	// Reads a theme from a TOML file; see `parseTheme` for the format.
	//
	// Fails when the file cannot be read or does not hold a theme.
	def loadTheme(path string) !Theme {
		return parseTheme(string(try os.readFile(path)))
	}

	// The style one theme table describes.
	internal def themeStyle(entry TOMLTable) !TextStyle {
		let made = new TextStyle(bold = entry.bool("bold"), italic = entry.bool("italic"), underline = entry.bool("underline"),
			dim = entry.bool("dim"), strike = entry.bool("strike"))
		made.foreground = try parseColor(entry.string("color")) when entry.has("color")
		made.background = try parseColor(entry.string("background")) when entry.has("background")
		return made
	}

	// The style of a standard role in the current theme, else its default.
	internal def styleOf(role string) TextStyle {
		let themed = theme().get(role)
		return themed unless themed is none
		let standard = standardTheme().get(role)
		return standard unless standard is none
		return new TextStyle()
	}

	// `defaultTheme()`, made once: where a standard role's style comes from
	// when the current theme leaves it out.
	internal let standards ?Theme = none

	internal def standardTheme() Theme {
		let known = standards
		return known unless known is none
		let made = defaultTheme()
		standards = made
		return made
	}
}
