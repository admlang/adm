partial module std.crypto {
	use (
		std.crypto.cipher::(Blowfish)
		std.crypto.hash::(Hash, digest)
	)

	internal const bcryptAlphabet = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

	// bcrypt hashes a password for storage (Provos and Mazieres, 1999) in
	// the modular crypt form `$2b$<cost>$<salt><hash>`, with a fresh
	// random salt. Each step of `cost` doubles the work; 12 takes a
	// fraction of a second. Only the first 72 bytes of the password
	// count. Fails when `cost` is outside 4 to 31 or the random source
	// is unavailable.
	//
	// ```
	// let stored = try crypto.bcrypt("s3cret")
	// assert crypto.bcryptVerify("s3cret", stored)
	// ```
	def bcrypt(password string, cost int = 12) !string {
		expects {
			assert cost >= 4 && cost <= 31 onerror fail "bcrypt: cost must be 4 to 31"
		}
		let salt = try rand(16)
		return bcryptWithSalt(password.bytes(), salt, cost, "2b")
	}

	// bcrypt over a secret password. Fails as `bcrypt(string)` does.
	def bcrypt(password Secret<string>, cost int = 12) !string {
		return try bcrypt(password.reveal(), cost)
	}

	// bcryptVerify reports whether `password` matches a hash `bcrypt`
	// made (`$2a$`, `$2b$` and `$2y$` all read). A malformed hash never
	// matches.
	def bcryptVerify(password string, hashed string) bool {
		let parts = hashed.split("$")
		return false when parts.len() != 4 || parts[0] != ""
		let version = parts[1]
		return false unless version := "2a" || "2b" || "2y"
		return false unless parts[2].len() == 2 && parts[2].isNumeric()
		let cost = parts[2].toInt<int>()
		return false when cost < 4 || cost > 31 || parts[3].len() != 53
		let salt = bcryptDecode(parts[3][:22], 16) onerror recover []
		return false when salt.len() != 16
		let again = bcryptWithSalt(password.bytes(), salt, cost, version)
		return constantTimeEqual(again.bytes(), hashed.bytes())
	}

	// bcryptVerify over a secret password.
	def bcryptVerify(password Secret<string>, hashed string) bool {
		return bcryptVerify(password.reveal(), hashed)
	}

	// bcryptPbkdf derives `length` bytes from a password and salt the way
	// OpenSSH protects private keys (`bcrypt_pbkdf`): PBKDF2's structure
	// with a bcrypt-based function in place of HMAC, its output bytes
	// spread across the blocks. Fails when `rounds` is below 1, `length`
	// is not 1 to 1024 or the salt is empty.
	def bcryptPbkdf(password byte[], salt byte[], rounds int, length int) !byte[] {
		expects {
			assert rounds >= 1 onerror fail "bcrypt_pbkdf: rounds must be at least 1"
			assert length >= 1 && length <= 1024 onerror fail "bcrypt_pbkdf: length must be 1 to 1024"
			assert salt.len() != 0 onerror fail "bcrypt_pbkdf: empty salt"
		}
		let stride = (length + 31) / 32
		let amount = (length + stride - 1) / stride
		let key byte[] = []
		key.len(length)
		let passHash = digest(Hash.SHA512, password)
		let left = length
		for let count = 1; left > 0; count++ {
			let counted = salt.clone()
			counted.push(byte(count >> 24))
			counted.push(byte(count >> 16))
			counted.push(byte(count >> 8))
			counted.push(byte(count))
			let saltHash = digest(Hash.SHA512, counted)
			let tmp = bcryptHash(passHash, saltHash)
			let out = tmp.clone()
			for let i = 1; i < rounds; i++ {
				saltHash = digest(Hash.SHA512, tmp)
				tmp = bcryptHash(passHash, saltHash)
				for let j = 0; j < out.len(); j++ {
					out[j] = out[j] ^ tmp[j]
				}
			}
			amount = left when left < amount
			let i = 0
			for i < amount {
				let dest = i * stride + (count - 1)
				break when dest >= length
				key[dest] = out[i]
				i++
			}
			left -= i
		}
		return key
	}

	// bcryptWithSalt is the bcrypt hash of a password with a given salt
	// and cost, in modular crypt form.
	internal def bcryptWithSalt(password byte[], salt byte[], cost int, version string) string {
		let key = password.clone()
		key.push(byte(0))
		key = key[:72].clone() when key.len() > 72
		let state = new Blowfish()
		state.expandKey(key, salt)
		let rounds = 1 << cost
		for let i = 0; i < rounds; i++ {
			state.expandKey(key, [])
			state.expandKey(salt, [])
		}
		let text = "OrpheanBeholderScryDoubt".bytes()
		let words uint32[] = []
		for let i = 0; i < 6; i++ {
			words.push(beWord(text, i * 4))
		}
		for let i = 0; i < 64; i++ {
			for let j = 0; j < 6; j += 2 {
				(words[j], words[j + 1]) = state.encrypt(words[j], words[j + 1])
			}
		}
		let raw byte[] = []
		for let w in words {
			raw.push(byte(w >> 24))
			raw.push(byte(w >> 16))
			raw.push(byte(w >> 8))
			raw.push(byte(w))
		}
		let costText = cost < 10 ?? ("0{cost}", "{cost}")
		return "${version}${costText}$" + bcryptEncode(salt) + bcryptEncode(raw[:23])
	}

	// bcryptHash is the core function of bcrypt_pbkdf: 32 bytes from the
	// SHA-512 digests of the password and of the counted salt.
	internal def bcryptHash(passHash byte[], saltHash byte[]) byte[] {
		let state = new Blowfish()
		state.expandKey(passHash, saltHash)
		for let i = 0; i < 64; i++ {
			state.expandKey(saltHash, [])
			state.expandKey(passHash, [])
		}
		let text = "OxychromaticBlowfishSwatDynamite".bytes()
		let words uint32[] = []
		for let i = 0; i < 8; i++ {
			words.push(beWord(text, i * 4))
		}
		for let i = 0; i < 64; i++ {
			for let j = 0; j < 8; j += 2 {
				(words[j], words[j + 1]) = state.encrypt(words[j], words[j + 1])
			}
		}
		let out byte[] = []
		for let w in words {
			out.push(byte(w))
			out.push(byte(w >> 8))
			out.push(byte(w >> 16))
			out.push(byte(w >> 24))
		}
		return out
	}

	internal def beWord(data byte[], at int) uint32 {
		return (uint32(data[at]) << 24) | (uint32(data[at + 1]) << 16) | (uint32(data[at + 2]) << 8) | uint32(data[at + 3])
	}

	// bcryptEncode is bcrypt's base64: its own alphabet, no padding.
	internal def bcryptEncode(data byte[]) string {
		let alphabet = bcryptAlphabet.bytes()
		let out byte[] = []
		let i = 0
		for i < data.len() {
			let c1 = int(data[i])
			i++
			out.push(alphabet[c1 >> 2])
			c1 = (c1 & 0x03) << 4
			if i >= data.len() {
				out.push(alphabet[c1])
				break
			}
			let c2 = int(data[i])
			i++
			c1 = c1 | (c2 >> 4)
			out.push(alphabet[c1])
			c1 = (c2 & 0x0f) << 2
			if i >= data.len() {
				out.push(alphabet[c1])
				break
			}
			c2 = int(data[i])
			i++
			c1 = c1 | (c2 >> 6)
			out.push(alphabet[c1])
			out.push(alphabet[c2 & 0x3f])
		}
		return string(out)
	}

	// bcryptDecode reads `count` bytes of bcrypt base64. Fails on a
	// character outside its alphabet.
	internal def bcryptDecode(text string, count int) !byte[] {
		let values int[] = []
		for let c in text.bytes() {
			let v = bcryptAlphabet.indexOf(string([c]))
			fail "bcrypt: bad base64" when v < 0
			values.push(v)
		}
		let out byte[] = []
		let i = 0
		for out.len() < count && i + 1 < values.len() {
			out.push(byte((values[i] << 2) | (values[i + 1] >> 4)))
			break when out.len() == count || i + 2 >= values.len()
			out.push(byte(((values[i + 1] & 0x0f) << 4) | (values[i + 2] >> 2)))
			break when out.len() == count || i + 3 >= values.len()
			out.push(byte(((values[i + 2] & 0x03) << 6) | values[i + 3]))
			i += 4
		}
		fail "bcrypt: short base64" when out.len() < count
		return out
	}
}
