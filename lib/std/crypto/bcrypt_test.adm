partial module std.crypto {
	use (
		std.testing
		std.data.encoding::(hexdecode)
	)

	check "bcrypt" {
		@test()
		def verifiesOpenwallVector() {
			assert bcryptVerify("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")
			assert !bcryptVerify("U*V", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")
			assert !bcryptVerify("U*U", "$2a$05$short")
		}

		@test()
		def hashesAndVerifies() !none {
			let stored = try bcrypt("correct horse", 4)
			assert stored.startsWith("$2b$04$")
			assert stored.len() == 60
			assert bcryptVerify("correct horse", stored)
			assert !bcryptVerify("battery staple", stored)
			return none
		}

		@test()
		def pbkdfMatchesOpenSSH() !none {
			let a = try bcryptPbkdf("password".bytes(), "salt".bytes(), 4, 32)
			assert a.hex() == "5BBF0CC293587F1C3635555C27796598D47E579071BF427E9D8FBE842ABA34D9"
			let b = try bcryptPbkdf(byte[0, 0, 0], byte[1, 2], 1, 45)
			assert b.hex() == "DF701692C65A501CB5CC0F1850D094CB385E1101CBC2BE3FB0DE081133C8306396105240C4EA8A53F183C7EBFE"
			return none
		}

		@test()
		def generatesP521Keys() !none {
			assert isOnCurve(p521, basePoint(p521))
			let key = try generateECDSAKey(p521)
			let digest = hexdecode("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20") onerror recover []
			let (r, s) = try key.sign(digest)
			assert key.publicKey().verify(digest, r, s)
			return none
		}
	}
}
