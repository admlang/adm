partial module std.crypto.cipher {
	internal const camelliaBlockSize = 16

	// SBOX1 of RFC 3713 §2.4.4; SBOX2, SBOX3 and SBOX4 derive from it.
	internal const camelliaSbox1 = byte[
		0x70, 0x82, 0x2c, 0xec, 0xb3, 0x27, 0xc0, 0xe5, 0xe4, 0x85, 0x57, 0x35, 0xea, 0x0c, 0xae, 0x41,
		0x23, 0xef, 0x6b, 0x93, 0x45, 0x19, 0xa5, 0x21, 0xed, 0x0e, 0x4f, 0x4e, 0x1d, 0x65, 0x92, 0xbd,
		0x86, 0xb8, 0xaf, 0x8f, 0x7c, 0xeb, 0x1f, 0xce, 0x3e, 0x30, 0xdc, 0x5f, 0x5e, 0xc5, 0x0b, 0x1a,
		0xa6, 0xe1, 0x39, 0xca, 0xd5, 0x47, 0x5d, 0x3d, 0xd9, 0x01, 0x5a, 0xd6, 0x51, 0x56, 0x6c, 0x4d,
		0x8b, 0x0d, 0x9a, 0x66, 0xfb, 0xcc, 0xb0, 0x2d, 0x74, 0x12, 0x2b, 0x20, 0xf0, 0xb1, 0x84, 0x99,
		0xdf, 0x4c, 0xcb, 0xc2, 0x34, 0x7e, 0x76, 0x05, 0x6d, 0xb7, 0xa9, 0x31, 0xd1, 0x17, 0x04, 0xd7,
		0x14, 0x58, 0x3a, 0x61, 0xde, 0x1b, 0x11, 0x1c, 0x32, 0x0f, 0x9c, 0x16, 0x53, 0x18, 0xf2, 0x22,
		0xfe, 0x44, 0xcf, 0xb2, 0xc3, 0xb5, 0x7a, 0x91, 0x24, 0x08, 0xe8, 0xa8, 0x60, 0xfc, 0x69, 0x50,
		0xaa, 0xd0, 0xa0, 0x7d, 0xa1, 0x89, 0x62, 0x97, 0x54, 0x5b, 0x1e, 0x95, 0xe0, 0xff, 0x64, 0xd2,
		0x10, 0xc4, 0x00, 0x48, 0xa3, 0xf7, 0x75, 0xdb, 0x8a, 0x03, 0xe6, 0xda, 0x09, 0x3f, 0xdd, 0x94,
		0x87, 0x5c, 0x83, 0x02, 0xcd, 0x4a, 0x90, 0x33, 0x73, 0x67, 0xf6, 0xf3, 0x9d, 0x7f, 0xbf, 0xe2,
		0x52, 0x9b, 0xd8, 0x26, 0xc8, 0x37, 0xc6, 0x3b, 0x81, 0x96, 0x6f, 0x4b, 0x13, 0xbe, 0x63, 0x2e,
		0xe9, 0x79, 0xa7, 0x8c, 0x9f, 0x6e, 0xbc, 0x8e, 0x29, 0xf5, 0xf9, 0xb6, 0x2f, 0xfd, 0xb4, 0x59,
		0x78, 0x98, 0x06, 0x6a, 0xe7, 0x46, 0x71, 0xba, 0xd4, 0x25, 0xab, 0x42, 0x88, 0xa2, 0x8d, 0xfa,
		0x72, 0x07, 0xb9, 0x55, 0xf8, 0xee, 0xac, 0x0a, 0x36, 0x49, 0x2a, 0x68, 0x3c, 0x38, 0xf1, 0xa4,
		0x40, 0x28, 0xd3, 0x7b, 0xbb, 0xc9, 0x43, 0xc1, 0x15, 0xe3, 0xad, 0xf4, 0x77, 0xc7, 0x80, 0x9e
	]

	// The key schedule constants Sigma1 to Sigma6 (RFC 3713 §2.2).
	internal const camelliaSigma = uint64[0xA09E667F3BCC908B, 0xB67AE8584CAA73B2, 0xC6EF372FE94F82BE, 0x54FF53A5F1D36F1C, 0x10E527FADE682D1D, 0xB05688C2B3E6C1FD]

	// camelliaSP holds eight tables of 256 entries: entry x of table i is
	// the P-function of byte i of the F input set to S_i(x), the others zero.
	// P is linear, so F is the XOR of one entry per input byte. Filled on
	// first use.
	internal let camelliaSP uint64[]

	internal def camelliaTables() uint64[] {
		if camelliaSP.len() == 0 {
			let tables uint64[]
			tables.len(8 * 256)
			for let x = 0; x < 256; x++ {
				let s1 = uint64(camelliaSbox1[x])
				let s2 = ((s1 << 1) | (s1 >> 7)) & 0xff
				let s3 = ((s1 << 7) | (s1 >> 1)) & 0xff
				let s4 = uint64(camelliaSbox1[((x << 1) | (x >> 7)) & 0xff])
				// The byte positions t1..t8 use SBOX1,2,3,4,2,3,4,1.
				let s = uint64[s1, s2, s3, s4, s2, s3, s4, s1]
				for let i = 0; i < 8; i++ {
					let t uint64[] = uint64[0, 0, 0, 0, 0, 0, 0, 0]
					t[i] = s[i]
					let y1 = t[0] ^ t[2] ^ t[3] ^ t[5] ^ t[6] ^ t[7]
					let y2 = t[0] ^ t[1] ^ t[3] ^ t[4] ^ t[6] ^ t[7]
					let y3 = t[0] ^ t[1] ^ t[2] ^ t[4] ^ t[5] ^ t[7]
					let y4 = t[1] ^ t[2] ^ t[3] ^ t[4] ^ t[5] ^ t[6]
					let y5 = t[0] ^ t[1] ^ t[5] ^ t[6] ^ t[7]
					let y6 = t[1] ^ t[2] ^ t[4] ^ t[6] ^ t[7]
					let y7 = t[2] ^ t[3] ^ t[4] ^ t[5] ^ t[7]
					let y8 = t[0] ^ t[3] ^ t[4] ^ t[5] ^ t[6]
					tables[i * 256 + x] = (y1 << 56) | (y2 << 48) | (y3 << 40) | (y4 << 32) | (y5 << 24) | (y6 << 16) | (y7 << 8) | y8
				}
			}
			camelliaSP = tables
		}
		return camelliaSP
	}

	// camelliaF is the F-function of RFC 3713 §2.4.1.
	@inline()
	internal def camelliaF(sp uint64[], input uint64, key uint64) uint64 {
		let x = input ^ key
		return sp[int(x >> 56)] ^ sp[256 + int((x >> 48) & 0xff)] ^ sp[512 + int((x >> 40) & 0xff)] ^ sp[768 + int((x >> 32) & 0xff)] ^ sp[1024 + int((x >> 24) & 0xff)] ^ sp[1280 + int((x >> 16) & 0xff)] ^ sp[1536 + int((x >> 8) & 0xff)] ^ sp[1792 + int(x & 0xff)]
	}

	@inline()
	internal def camelliaRotl32(x uint64, n uint64) uint64 {
		return ((x << n) | (x >> (32 - n))) & 0xffffffff
	}

	// camelliaFL and camelliaFLInv are the FL- and FLINV-functions (§2.4.2).
	@inline()
	internal def camelliaFL(input uint64, key uint64) uint64 {
		let x1 = input >> 32
		let x2 = input & 0xffffffff
		let k1 = key >> 32
		let k2 = key & 0xffffffff
		let r2 = x2 ^ camelliaRotl32(x1 & k1, 1)
		let r1 = x1 ^ (r2 | k2)
		return (r1 << 32) | r2
	}

	@inline()
	internal def camelliaFLInv(input uint64, key uint64) uint64 {
		let y1 = input >> 32
		let y2 = input & 0xffffffff
		let k1 = key >> 32
		let k2 = key & 0xffffffff
		let r1 = y1 ^ (y2 | k2)
		let r2 = y2 ^ camelliaRotl32(r1 & k1, 1)
		return (r1 << 32) | r2
	}

	// camelliaRotl128 rotates the 128-bit value hi:lo left by n bits and
	// returns the halves.
	internal def camelliaRotl128(hi uint64, lo uint64, n int) (uint64, uint64) {
		let h = hi
		let l = lo
		let r = n
		if r >= 64 {
			let t = h
			h = l
			l = t
			r -= 64
		}
		return (h, l) when r == 0
		let s = uint64(r)
		return ((h << s) | (l >> (64 - s)), (l << s) | (h >> (64 - s)))
	}

	// newCamellia returns the Camellia block cipher (RFC 3713) for a 16, 24
	// or 32-byte key. Fails for any other key length.
	def newCamellia(key byte[]) !Camellia {
		expects {
			assert key.len() == 16 || key.len() == 24 || key.len() == 32 onerror fail "camellia: key must be 16, 24 or 32 bytes"
		}
		return new Camellia(key)
	}

	// Camellia is the block cipher of RFC 3713 with a 128, 192 or 256-bit
	// key: 18 rounds for 128-bit keys, 24 for longer ones. Implements Block.
	// Like AES here, the tables are indexed by secret data.
	type Camellia {
		internal kw  uint64[]
		internal k   uint64[]
		internal ke  uint64[]
		internal dkw uint64[]
		internal dk  uint64[]
		internal dke uint64[]
		internal sp  uint64[]

		// The key must be 16, 24 or 32 bytes; newCamellia checks.
		def new(key byte[]) {
			sp = camelliaTables()
			let klh = camelliaWord(key, 0)
			let kll = camelliaWord(key, 8)
			let krh uint64 = 0
			let krl uint64 = 0
			if key.len() == 24 {
				krh = camelliaWord(key, 16)
				krl = ~krh
			} else if key.len() == 32 {
				krh = camelliaWord(key, 16)
				krl = camelliaWord(key, 24)
			}
			// KA and KB (§2.2).
			let d1 = klh ^ krh
			let d2 = kll ^ krl
			d2 ^= camelliaF(sp, d1, camelliaSigma[0])
			d1 ^= camelliaF(sp, d2, camelliaSigma[1])
			d1 ^= klh
			d2 ^= kll
			d2 ^= camelliaF(sp, d1, camelliaSigma[2])
			d1 ^= camelliaF(sp, d2, camelliaSigma[3])
			let kah = d1
			let kal = d2
			let encKw uint64[] = []
			let encK uint64[] = []
			let encKe uint64[] = []
			if key.len() == 16 {
				camelliaPush(encKw, klh, kll, 0)
				camelliaPush(encK, kah, kal, 0)
				camelliaPush(encK, klh, kll, 15)
				camelliaPush(encK, kah, kal, 15)
				camelliaPush(encKe, kah, kal, 30)
				camelliaPush(encK, klh, kll, 45)
				let (a45, _) = camelliaRotl128(kah, kal, 45)
				encK.push(a45)
				let (_, l60) = camelliaRotl128(klh, kll, 60)
				encK.push(l60)
				camelliaPush(encK, kah, kal, 60)
				camelliaPush(encKe, klh, kll, 77)
				camelliaPush(encK, klh, kll, 94)
				camelliaPush(encK, kah, kal, 94)
				camelliaPush(encK, klh, kll, 111)
				camelliaPush(encKw, kah, kal, 111)
			} else {
				d1 = kah ^ krh
				d2 = kal ^ krl
				d2 ^= camelliaF(sp, d1, camelliaSigma[4])
				d1 ^= camelliaF(sp, d2, camelliaSigma[5])
				let kbh = d1
				let kbl = d2
				camelliaPush(encKw, klh, kll, 0)
				camelliaPush(encK, kbh, kbl, 0)
				camelliaPush(encK, krh, krl, 15)
				camelliaPush(encK, kah, kal, 15)
				camelliaPush(encKe, krh, krl, 30)
				camelliaPush(encK, kbh, kbl, 30)
				camelliaPush(encK, klh, kll, 45)
				camelliaPush(encK, kah, kal, 45)
				camelliaPush(encKe, klh, kll, 60)
				camelliaPush(encK, krh, krl, 60)
				camelliaPush(encK, kbh, kbl, 60)
				camelliaPush(encK, klh, kll, 77)
				camelliaPush(encKe, kah, kal, 77)
				camelliaPush(encK, krh, krl, 94)
				camelliaPush(encK, kah, kal, 94)
				camelliaPush(encK, klh, kll, 111)
				camelliaPush(encKw, kbh, kbl, 111)
			}
			kw = encKw
			k = encK
			ke = encKe
			// Decryption runs the same network with the subkeys reversed
			// (§2.3.3): kw1<->kw3, kw2<->kw4, k(i)<->k(n+1-i), ke reversed.
			dkw = uint64[kw[2], kw[3], kw[0], kw[1]]
			dk = []
			for let i = k.len() - 1; i >= 0; i-- {
				dk.push(k[i])
			}
			dke = []
			for let i = ke.len() - 1; i >= 0; i-- {
				dke.push(ke[i])
			}
		}

		// blockSize is 16 bytes.
		def blockSize() int {
			return camelliaBlockSize
		}

		// encryptBlock encrypts the 16 bytes of src into dst.
		def encryptBlock(dst, src byte[]) {
			camelliaCrypt(sp, dst, src, kw, k, ke)
		}

		// decryptBlock decrypts the 16 bytes of src into dst.
		def decryptBlock(dst, src byte[]) {
			camelliaCrypt(sp, dst, src, dkw, dk, dke)
		}
	}

	@inline()
	internal def camelliaWord(b byte[], at int) uint64 {
		return uint64(b[at]) << 56 | uint64(b[at + 1]) << 48 | uint64(b[at + 2]) << 40 | uint64(b[at + 3]) << 32 | uint64(b[at + 4]) << 24 | uint64(b[at + 5]) << 16 | uint64(b[at + 6]) << 8 | uint64(b[at + 7])
	}

	internal def camelliaPush(out uint64[], hi uint64, lo uint64, n int) {
		let (h, l) = camelliaRotl128(hi, lo, n)
		out.push(h)
		out.push(l)
	}

	// camelliaCrypt runs the Feistel network: six rounds, then FL/FLINV,
	// repeated, with whitening keys on both ends (§2.3.2).
	internal def camelliaCrypt(sp uint64[], dst, src byte[], kw uint64[], k uint64[], ke uint64[]) {
		let d1 = camelliaWord(src, 0) ^ kw[0]
		let d2 = camelliaWord(src, 8) ^ kw[1]
		let r = 0
		for let block = 0; block < k.len() / 6; block++ {
			if block > 0 {
				d1 = camelliaFL(d1, ke[2 * (block - 1)])
				d2 = camelliaFLInv(d2, ke[2 * (block - 1) + 1])
			}
			d2 ^= camelliaF(sp, d1, k[r])
			d1 ^= camelliaF(sp, d2, k[r + 1])
			d2 ^= camelliaF(sp, d1, k[r + 2])
			d1 ^= camelliaF(sp, d2, k[r + 3])
			d2 ^= camelliaF(sp, d1, k[r + 4])
			d1 ^= camelliaF(sp, d2, k[r + 5])
			r += 6
		}
		d2 ^= kw[2]
		d1 ^= kw[3]
		dst[0] = byte(d2 >> 56)
		dst[1] = byte(d2 >> 48)
		dst[2] = byte(d2 >> 40)
		dst[3] = byte(d2 >> 32)
		dst[4] = byte(d2 >> 24)
		dst[5] = byte(d2 >> 16)
		dst[6] = byte(d2 >> 8)
		dst[7] = byte(d2)
		dst[8] = byte(d1 >> 56)
		dst[9] = byte(d1 >> 48)
		dst[10] = byte(d1 >> 40)
		dst[11] = byte(d1 >> 32)
		dst[12] = byte(d1 >> 24)
		dst[13] = byte(d1 >> 16)
		dst[14] = byte(d1 >> 8)
		dst[15] = byte(d1)
	}
}
