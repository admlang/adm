partial module std.crypto.cipher {
	use (
		std.testing
		std.data.encoding::(hexdecode, hexencode)
	)

	check "Camellia" {
		internal def ecb(key, data string, encrypt bool) !string {
			let c = try newCamellia(try hexdecode(key))
			let input = try hexdecode(data)
			let out byte[]
			out.len(input.len())
			let block byte[]
			block.len(16)
			for let at = 0; at < input.len(); at += 16 {
				if encrypt {
					c.encryptBlock(block, input[at:at + 16])
				} else {
					c.decryptBlock(block, input[at:at + 16])
				}
				for let i = 0; i < 16; i++ {
					out[at + i] = block[i]
				}
			}
			return hexencode(out)
		}

		@test()
		def TestCamelliaRfc3713() !none {
			// RFC 3713 Appendix A.
			let plain = "0123456789abcdeffedcba9876543210"
			let cases = [
				("0123456789abcdeffedcba9876543210", "67673138549669730857065648eabe43"),
				("0123456789abcdeffedcba98765432100011223344556677", "b4993401b3e996f84ee5cee7d79b09b9"),
				("0123456789abcdeffedcba987654321000112233445566778899aabbccddeeff", "9acc237dff16d76c20ef7c919e3a7509")
			]
			for let c in cases {
				let (key, cipher) = c
				assert try ecb(key, plain, true) == cipher
				assert try ecb(key, cipher, false) == plain
			}
		}

		@test()
		def TestCamelliaOpenSSL() !none {
			// openssl enc -camellia-{128,192,256}-ecb -nopad on random keys and data.
			let cases = [
				("9fd871d3737ad0895bf454e29e858f41", "4586aea438b18e5e82982ac45e3c02b7611581348ccae357868bd54320b44886d82dc1e8a3147d43ac0b9d2c110970c0800dd7edf6df3a15c5af35d02c90b9a5", "6a084801c9fc9065b8bc152fec2c7f1d005de10be6735686686d5b4787e887772e07584962e68216a7f63aa31650c7fb79c8e45ce3fc1524659a608f2c30a145"),
				("3e90f7d6cbcf8fc928d19e84fd4681692d237332d83002c4", "b2902259722118f8165766e2fc0b6e1ed0024054eb9a3f5032c9e4a6fbcef81d435309a4151d78c971a7d16cfe6ad91c661efced3e328d2870bbef82e09939c4", "f859a8b6af6176f1bfb670affa18ab6969c24d35e21e2fe68340c85fd3f674f8181c57078e06f8e48a298513c9f9b29a19794c0f0cc8d59aeddf215c453ac146"),
				("da263892954390f7ed33c6dfb1b606f4a0de7fc3e7eaf900062bb80fa3369101", "1a900f9b550e4132e6963fa87948ded9f44c4ec1151ae65a179bcb542fc1ddcb2af3471ddaf8cfff943c6affcbb83a1bc4fffa659774a3be81abed0e076145d8", "44af45993b3fc979f6c8f9421b8c2a43b4cf5964b8abe57f3a9e51f3e325935358037b571f66099e349cbdf069f2fe57f886b94891665039f1080a1613d7319d")
			]
			for let c in cases {
				let (key, plain, cipher) = c
				assert try ecb(key, plain, true) == cipher
				assert try ecb(key, cipher, false) == plain
			}
			assert newCamellia(byte[1, 2, 3]) is error
			// CBC and the key wrap take it as any Block.
			let kek = try newCamellia(try hexdecode("000102030405060708090a0b0c0d0e0f"))
			let key = try hexdecode("00112233445566778899aabbccddeeff")
			assert hexencode(try unwrapKey(kek, try wrapKey(kek, key))) == hexencode(key)
		}
	}
}
