partial module std.crypto.cipher {
	// newCBC returns cipher block chaining over `block`, starting from the
	// initialisation vector `iv`, which must be one block long.
	// Fails when `iv` is not one block long.
	def newCBC(block Block, iv byte[]) !CBC {
		expects {
			assert iv.len() == block.blockSize() onerror fail "cbc: the IV must be one block ({block.blockSize()} bytes)"
		}
		return new CBC(block, iv)
	}

	// CBC is cipher block chaining: each block is combined with the previous
	// ciphertext block before it is encrypted. It works on whole blocks;
	// `padPKCS7`/`unpadPKCS7` add and remove the usual padding. Construct
	// through newCBC.
	type CBC {
		internal block Block
		internal iv    byte[]

		def new(block Block, iv byte[]) {
			self.block = block
			self.iv = iv.clone()
		}

		// encrypt returns the ciphertext of `data`, whose length must be a
		// multiple of the block size.
		// Fails when it is not.
		def encrypt(data byte[]) !byte[] {
			let size = block.blockSize()
			fail "cbc: data is not a whole number of blocks" when data.len() % size != 0
			let chain = iv.clone()
			let input byte[]
			input.len(size)
			let out byte[]
			out.len(data.len())
			let encrypted byte[]
			encrypted.len(size)
			for let at = 0; at < data.len(); at += size {
				for let i = 0; i < size; i++ {
					input[i] = data[at + i] ^ chain[i]
				}
				block.encryptBlock(encrypted, input)
				for let i = 0; i < size; i++ {
					out[at + i] = encrypted[i]
					chain[i] = encrypted[i]
				}
			}
			return out
		}

		// decrypt returns the plaintext of `data`, whose length must be a
		// multiple of the block size.
		// Fails when it is not.
		def decrypt(data byte[]) !byte[] {
			let size = block.blockSize()
			fail "cbc: data is not a whole number of blocks" when data.len() % size != 0
			let chain = iv.clone()
			let out byte[]
			out.len(data.len())
			let plain byte[]
			plain.len(size)
			for let at = 0; at < data.len(); at += size {
				block.decryptBlock(plain, data[at:at + size])
				for let i = 0; i < size; i++ {
					out[at + i] = plain[i] ^ chain[i]
					chain[i] = data[at + i]
				}
			}
			return out
		}
	}

	// padPKCS7 appends PKCS #7 padding: 1 to `blockSize` bytes, each holding
	// the padding length, so the result is a whole number of blocks.
	def padPKCS7(data byte[], blockSize int) byte[] {
		let n = blockSize - data.len() % blockSize
		let out = data.clone()
		for let i = 0; i < n; i++ {
			out.push(byte(n))
		}
		return out
	}

	// unpadPKCS7 removes PKCS #7 padding.
	// Fails when the data is empty, not a whole number of blocks, or its
	// padding is not valid.
	def unpadPKCS7(data byte[], blockSize int) !byte[] {
		fail "pkcs7: data is not a whole number of blocks" when data.len() == 0 || data.len() % blockSize != 0
		let n = int(data[data.len() - 1])
		fail "pkcs7: invalid padding" when n < 1 || n > blockSize
		for let i = data.len() - n; i < data.len(); i++ {
			fail "pkcs7: invalid padding" when int(data[i]) != n
		}
		return data[:data.len() - n]
	}
}
