partial module std.crypto.cipher {
	use (
		std.crypto::(constantTimeEqual)
		std.crypto.hash::(Hash, HMAC)
	)

	// newCBCHMAC returns the AES-CBC with HMAC-SHA-2 AEAD of RFC 7518 §5.2:
	// AES-CBC with PKCS #7 padding, then an HMAC over the associated data,
	// the IV and the ciphertext, cut to half its length. The key's length
	// picks the variant: 32 bytes for AES_128_CBC_HMAC_SHA_256, 48 for
	// AES_192_CBC_HMAC_SHA_384, 64 for AES_256_CBC_HMAC_SHA_512; its first
	// half keys the HMAC, its second half AES. The nonce is the 16-byte IV,
	// which must be unpredictable, so draw it at random.
	//
	// ```
	// let aead = try cipher.newCBCHMAC(key32)
	// let sealed = aead.seal(try crypto.rand(16), plaintext, additional)
	// ```
	//
	// Fails when the key is not 32, 48 or 64 bytes.
	def newCBCHMAC(key byte[]) !CBCHMAC {
		expects {
			assert key.len() == 32 || key.len() == 48 || key.len() == 64 onerror fail "cbchmac: key must be 32, 48 or 64 bytes"
		}
		let half = key.len() / 2
		let hash = Hash.SHA256
		hash = Hash.SHA384 when half == 24
		hash = Hash.SHA512 when half == 32
		return new CBCHMAC(try newAES(key[half:key.len()]), key[0:half].clone(), hash)
	}

	// CBCHMAC is AES-CBC with HMAC-SHA-2 (RFC 7518 §5.2). Implements AEAD:
	// seal returns the ciphertext followed by the tag. Construct through
	// newCBCHMAC.
	type CBCHMAC {
		internal block  AES
		internal macKey byte[]
		internal hash   Hash

		def new(block AES, macKey byte[], hash Hash) {
			self.block = block
			self.macKey = macKey
			self.hash = hash
		}

		// nonceSize implements AEAD: the 16-byte IV.
		def nonceSize() int {
			return 16
		}

		// tagSize is the length of the tag seal appends: half the key.
		def tagSize() int {
			return macKey.len()
		}

		// overhead implements AEAD: the most padding adds, plus the tag.
		def overhead() int {
			return 16 + tagSize()
		}

		// seal implements AEAD. The nonce must be 16 bytes.
		def seal(nonce, plaintext, additional byte[]) byte[] {
			let cbc = new CBC(block, nonce)
			let ciphertext = cbc.encrypt(padPKCS7(plaintext, 16)) onerror recover []
			return ciphertext + tag(nonce, ciphertext, additional)
		}

		// open implements AEAD. It checks the tag before it decrypts.
		// Fails when the nonce is not 16 bytes, the input is too short or
		// does not authenticate, or the padding inside it is not valid.
		def open(nonce, ciphertext, additional byte[]) !byte[] {
			let tagLen = tagSize()
			fail "cbchmac: message authentication failed" when nonce.len() != 16 || ciphertext.len() < 16 + tagLen || (ciphertext.len() - tagLen) % 16 != 0
			let body = ciphertext[0:ciphertext.len() - tagLen]
			let expected = tag(nonce, body, additional)
			fail "cbchmac: message authentication failed" unless constantTimeEqual(expected, ciphertext[ciphertext.len() - tagLen:ciphertext.len()])
			let cbc = new CBC(block, nonce)
			return try unpadPKCS7(try cbc.decrypt(body), 16)
		}

		// tag is the HMAC of the associated data, the IV, the ciphertext and
		// the associated data's length in bits as 64 bits big-endian, cut to
		// tagSize bytes.
		internal def tag(nonce, ciphertext, additional byte[]) byte[] {
			let bits = uint64(additional.len()) * 8
			let length byte[]
			length.len(8)
			for let i = 0; i < 8; i++ {
				length[i] = byte((bits >> uint64(56 - 8 * i)) & 0xFF)
			}
			let mac = new HMAC(hash, macKey)
			mac.write(additional)
			mac.write(nonce)
			mac.write(ciphertext)
			return mac.hash(length)[0:tagSize()]
		}
	}
}
