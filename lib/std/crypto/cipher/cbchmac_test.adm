partial module std.crypto.cipher {
	use (
		std.testing
		std.crypto::(rand)
		std.data.encoding::(hexdecode)
	)

	check "CBC-HMAC" {
		@test()
		def TestCBCHMACVectors() !none {
			// RFC 7516 Appendix A.2 (AES_128_CBC_HMAC_SHA_256) and
			// draft-mcgrew-aead-aes-cbc-hmac-sha2-05 §5.4 (AES_256_CBC_HMAC_SHA_512).
			let cases = [
				["04D31FC5549DFCFE0B649DFA3FAA6ACE6B7CD42D6F6B09DBC8B100F08F9C2CCF", "03163C0C2B4368696C6C69636F746865", "4C697665206C6F6E6720616E642070726F737065722E", "65794A68624763694F694A5355304578587A55694C434A6C626D4D694F694A424D54493451304A444C5568544D6A5532496E30", "283953B577218594C6B9F31898E6064B81DF7F13D252B7E6A821D7688F703866F611F4BE045F6203E700739DF2CB64BF"],
				["000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F", "1AF38C2DC2B96FFDD86694092341BC04", "41206369706865722073797374656D206D757374206E6F7420626520726571756972656420746F206265207365637265742C20616E64206974206D7573742062652061626C6520746F2066616C6C20696E746F207468652068616E6473206F662074686520656E656D7920776974686F757420696E636F6E76656E69656E6365", "546865207365636F6E64207072696E6369706C65206F662041756775737465204B6572636B686F666673", ""]
			]
			for let c in cases {
				let aead = try newCBCHMAC(try hexdecode(c[0]))
				let nonce = try hexdecode(c[1])
				let plaintext = try hexdecode(c[2])
				let additional = try hexdecode(c[3])
				let sealed = aead.seal(nonce, plaintext, additional)
				assert sealed.hex() == c[4]
				assert (try aead.open(nonce, sealed, additional)).hex() == plaintext.hex()
				// Any change to the input, the IV or the associated data fails.
				let flipped = sealed.clone()
				flipped[3] ^= 1
				let failures = [
					aead.open(nonce, flipped, additional) onerror recover byte[1],
					aead.open(nonce, sealed[0:sealed.len() - 1], additional) onerror recover byte[1],
					aead.open(nonce, sealed, additional + byte[0]) onerror recover byte[1],
					aead.open(nonce[1:16] + byte[0], sealed, additional) onerror recover byte[1]
				]
				for let f in failures {
					assert f.hex() == "01"
				}
			}
		}

		@test()
		def TestCBCHMACRoundTrip() !none {
			for let size in [32, 48, 64] {
				let aead = try newCBCHMAC(try rand(size))
				assert aead.tagSize() == size / 2 && aead.overhead() == 16 + size / 2
				for let n in [0, 1, 15, 16, 17, 100] {
					let nonce = try rand(16)
					let plaintext = try rand(n + 1)
					plaintext = plaintext[0:n]
					let sealed = aead.seal(nonce, plaintext, "aad".bytes())
					assert sealed.len() == (n / 16 + 1) * 16 + size / 2
					assert (try aead.open(nonce, sealed, "aad".bytes())).hex() == plaintext.hex()
				}
			}
			let bad = newCBCHMAC(byte[1, 2, 3])
			assert bad is error
		}
	}
}
