partial module std.crypto.cipher {
	// newCFB returns cipher feedback mode over `block` with full-block
	// segments (CFB-128 for AES, NIST SP 800-38A §6.3), starting at `iv`.
	// Fails when `iv` is not one block long.
	def newCFB(block Block, iv byte[]) !CFB {
		expects {
			assert iv.len() == block.blockSize() onerror fail "cfb: IV must be one block long"
		}
		return new CFB(block, iv)
	}

	// CFB is a block cipher in cipher feedback mode: any length, the
	// position carried between calls in one direction. Use one CFB value
	// for encrypting and another for decrypting.
	type CFB {
		internal block    Block
		internal register byte[]
		internal stream   byte[]
		internal used     int

		def new(block Block, iv byte[]) {
			self.block = block
			register = iv.clone()
			stream = []
			stream.len(iv.len())
			used = iv.len()
		}

		// Encrypts `data`, returning the ciphertext.
		def encrypt(data byte[]) byte[] {
			let out = data.clone()
			for let i = 0; i < out.len(); i++ {
				refill()
				out[i] = out[i] ^ stream[used]
				register[used] = out[i]
				used++
			}
			return out
		}

		// Decrypts `data`, returning the plaintext.
		def decrypt(data byte[]) byte[] {
			let out = data.clone()
			for let i = 0; i < out.len(); i++ {
				refill()
				register[used] = data[i]
				out[i] = data[i] ^ stream[used]
				used++
			}
			return out
		}

		internal def refill() {
			return when used < stream.len()
			block.encryptBlock(stream, register)
			used = 0
		}
	}
}
