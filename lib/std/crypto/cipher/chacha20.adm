partial module std.crypto.cipher {
	use (
		std.crypto::(constantTimeEqual)
		std.simd
	)

	internal const (
		chachaKeySize    = 32
		chachaNonceSize  = 12
		xchachaNonceSize = 24
	)

	// chacha20 encrypts or decrypts data with the RFC 8439 stream cipher: a
	// 32-byte key, a 12-byte nonce and the initial block counter. Applying
	// it twice with the same parameters restores the input.
	// Fails when the key or nonce has the wrong length.
	def chacha20(key, nonce byte[], counter uint32, data byte[]) !byte[] {
		expects {
			assert key.len() == chachaKeySize onerror fail "chacha20: key must be 32 bytes"
			assert nonce.len() == chachaNonceSize onerror fail "chacha20: nonce must be 12 bytes"
		}
		let out byte[]
		out.len(data.len())
		chachaXor(chachaState(key, nonce, counter), data, 0, out, 0, data.len())
		return out
	}

	internal def chachaState(key, nonce byte[], counter uint32) uint32[] {
		let s uint32[]
		s.len(16)
		s[0] = 0x61707865
		s[1] = 0x3320646e
		s[2] = 0x79622d32
		s[3] = 0x6b206574
		for let i = 0; i < 8; i++ {
			s[4 + i] = readUint32LE(key, i * 4)
		}
		s[12] = counter
		s[13] = readUint32LE(nonce, 0)
		s[14] = readUint32LE(nonce, 4)
		s[15] = readUint32LE(nonce, 8)
		return s
	}

	// xchacha20 encrypts or decrypts data with XChaCha20
	// (draft-irtf-cfrg-xchacha): ChaCha20 under a key derived from the
	// 32-byte key and the first 16 bytes of a 24-byte nonce, which makes
	// nonces drawn at random safe for any number of messages.
	// Fails when the key or nonce has the wrong length.
	def xchacha20(key, nonce byte[], counter uint32, data byte[]) !byte[] {
		expects {
			assert key.len() == chachaKeySize onerror fail "xchacha20: key must be 32 bytes"
			assert nonce.len() == xchachaNonceSize onerror fail "xchacha20: nonce must be 24 bytes"
		}
		return try chacha20(hchacha20(key, nonce), xchachaInner(nonce), counter, data)
	}

	// hchacha20 returns the 32-byte key XChaCha20 runs ChaCha20 under: the
	// first and last rows of the state after the rounds, for a state whose
	// last row is the first 16 bytes of nonce.
	internal def hchacha20(key, nonce byte[]) byte[] {
		let state = chachaState(key, nonce[4:16], readUint32LE(nonce, 0))
		let block = zeros(64)
		chachaBlock(state, block)
		let out = zeros(chachaKeySize)
		// chachaBlock adds the state to the rounds' result; the derived
		// key is the result alone.
		for let i = 0; i < 4; i++ {
			writeUint32LE(out, i * 4, readUint32LE(block, i * 4) - state[i])
			writeUint32LE(out, 16 + i * 4, readUint32LE(block, 48 + i * 4) - state[12 + i])
		}
		return out
	}

	// The 12-byte ChaCha20 nonce of a 24-byte XChaCha20 one: four zero
	// bytes and its last eight.
	internal def xchachaInner(nonce byte[]) byte[] {
		let inner = zeros(chachaNonceSize)
		nonce[16:xchachaNonceSize].copy(inner[4:])
		return inner
	}

	internal const (
		// Bytes one pass of chachaXorWide covers: eight blocks.
		chachaWide     = 512
		// A tail longer than this runs one more wide pass on a padded copy;
		// shorter ones take the block-at-a-time path.
		chachaWideTail = 128
	)

	// Block number of each lane within a wide pass.
	internal const chachaLaneBlocks = uint32[0, 1, 2, 3, 4, 5, 6, 7]

	// chachaXor writes count bytes of src from srcOff, combined with the
	// keystream that starts at the state's block counter, to dst from
	// dstOff, and advances the counter past the blocks it used. src and dst
	// may be the same array at the same offset.
	internal def chachaXor(state uint32[], src byte[], srcOff int, dst byte[], dstOff int, count int) {
		let groups = count / chachaWide
		if groups > 0 {
			chachaXorWide(state, src, srcOff, dst, dstOff, groups)
			state[12] += uint32(groups * 8)
		}
		let done = groups * chachaWide
		let rest = count - done
		if rest > chachaWideTail {
			let padded = zeros(chachaWide)
			for let i = 0; i < rest; i++ {
				padded[i] = src[srcOff + done + i]
			}
			chachaXorWide(state, padded, 0, padded, 0, 1)
			for let i = 0; i < rest; i++ {
				dst[dstOff + done + i] = padded[i]
			}
			state[12] += uint32((rest + 63) / 64)
			return
		}
		let keystream = zeros(64)
		for done < count {
			chachaBlock(state, keystream)
			state[12]++
			let n = count - done
			n = 64 when n > 64
			for let i = 0; i < n; i++ {
				dst[dstOff + done + i] = src[srcOff + done + i] ^ keystream[i]
			}
			done += n
		}
	}

	// chachaXorWide handles groups runs of eight blocks, one block per
	// vector lane: lane j of word w belongs to block counter + j. It leaves
	// the state untouched.
	internal def chachaXorWide(state uint32[], src byte[], srcOff int, dst byte[], dstOff int, groups int) {
		let s0 = simd.splat8<uint32>(state[0])
		let s1 = simd.splat8<uint32>(state[1])
		let s2 = simd.splat8<uint32>(state[2])
		let s3 = simd.splat8<uint32>(state[3])
		let s4 = simd.splat8<uint32>(state[4])
		let s5 = simd.splat8<uint32>(state[5])
		let s6 = simd.splat8<uint32>(state[6])
		let s7 = simd.splat8<uint32>(state[7])
		let s8 = simd.splat8<uint32>(state[8])
		let s9 = simd.splat8<uint32>(state[9])
		let s10 = simd.splat8<uint32>(state[10])
		let s11 = simd.splat8<uint32>(state[11])
		let s13 = simd.splat8<uint32>(state[13])
		let s14 = simd.splat8<uint32>(state[14])
		let s15 = simd.splat8<uint32>(state[15])
		let lanes = simd.load8<uint32>(chachaLaneBlocks, 0)
		for let g = 0; g < groups; g++ {
			let s12 = simd.splat8<uint32>(state[12] + uint32(g * 8)) + lanes
			let x0, x1, x2, x3 = s0, s1, s2, s3
			let x4, x5, x6, x7 = s4, s5, s6, s7
			let x8, x9, x10, x11 = s8, s9, s10, s11
			let x12, x13, x14, x15 = s12, s13, s14, s15
			for let i = 0; i < 10; i++ {
				x0 = x0 + x4
				x12 = (x12 ^ x0) <<< 16
				x8 = x8 + x12
				x4 = (x4 ^ x8) <<< 12
				x0 = x0 + x4
				x12 = (x12 ^ x0) <<< 8
				x8 = x8 + x12
				x4 = (x4 ^ x8) <<< 7
				x1 = x1 + x5
				x13 = (x13 ^ x1) <<< 16
				x9 = x9 + x13
				x5 = (x5 ^ x9) <<< 12
				x1 = x1 + x5
				x13 = (x13 ^ x1) <<< 8
				x9 = x9 + x13
				x5 = (x5 ^ x9) <<< 7
				x2 = x2 + x6
				x14 = (x14 ^ x2) <<< 16
				x10 = x10 + x14
				x6 = (x6 ^ x10) <<< 12
				x2 = x2 + x6
				x14 = (x14 ^ x2) <<< 8
				x10 = x10 + x14
				x6 = (x6 ^ x10) <<< 7
				x3 = x3 + x7
				x15 = (x15 ^ x3) <<< 16
				x11 = x11 + x15
				x7 = (x7 ^ x11) <<< 12
				x3 = x3 + x7
				x15 = (x15 ^ x3) <<< 8
				x11 = x11 + x15
				x7 = (x7 ^ x11) <<< 7
				x0 = x0 + x5
				x15 = (x15 ^ x0) <<< 16
				x10 = x10 + x15
				x5 = (x5 ^ x10) <<< 12
				x0 = x0 + x5
				x15 = (x15 ^ x0) <<< 8
				x10 = x10 + x15
				x5 = (x5 ^ x10) <<< 7
				x1 = x1 + x6
				x12 = (x12 ^ x1) <<< 16
				x11 = x11 + x12
				x6 = (x6 ^ x11) <<< 12
				x1 = x1 + x6
				x12 = (x12 ^ x1) <<< 8
				x11 = x11 + x12
				x6 = (x6 ^ x11) <<< 7
				x2 = x2 + x7
				x13 = (x13 ^ x2) <<< 16
				x8 = x8 + x13
				x7 = (x7 ^ x8) <<< 12
				x2 = x2 + x7
				x13 = (x13 ^ x2) <<< 8
				x8 = x8 + x13
				x7 = (x7 ^ x8) <<< 7
				x3 = x3 + x4
				x14 = (x14 ^ x3) <<< 16
				x9 = x9 + x14
				x4 = (x4 ^ x9) <<< 12
				x3 = x3 + x4
				x14 = (x14 ^ x3) <<< 8
				x9 = x9 + x14
				x4 = (x4 ^ x9) <<< 7
			}
			// Rows are words and lanes blocks; the output wants each block's
			// words side by side, in the machine's little-endian byte order.
			let (a0, a1, a2, a3, a4, a5, a6, a7) = chachaTranspose(x0 + s0, x1 + s1, x2 + s2, x3 + s3, x4 + s4, x5 + s5, x6 + s6, x7 + s7)
			let (b0, b1, b2, b3, b4, b5, b6, b7) = chachaTranspose(x8 + s8, x9 + s9, x10 + s10, x11 + s11, x12 + s12, x13 + s13, x14 + s14, x15 + s15)
			let from = srcOff + g * chachaWide
			let to = dstOff + g * chachaWide
			simd.store32<byte>(dst, to, simd.load32<byte>(src, from) ^ a0.bitcast32<byte>())
			simd.store32<byte>(dst, to + 32, simd.load32<byte>(src, from + 32) ^ b0.bitcast32<byte>())
			simd.store32<byte>(dst, to + 64, simd.load32<byte>(src, from + 64) ^ a1.bitcast32<byte>())
			simd.store32<byte>(dst, to + 96, simd.load32<byte>(src, from + 96) ^ b1.bitcast32<byte>())
			simd.store32<byte>(dst, to + 128, simd.load32<byte>(src, from + 128) ^ a2.bitcast32<byte>())
			simd.store32<byte>(dst, to + 160, simd.load32<byte>(src, from + 160) ^ b2.bitcast32<byte>())
			simd.store32<byte>(dst, to + 192, simd.load32<byte>(src, from + 192) ^ a3.bitcast32<byte>())
			simd.store32<byte>(dst, to + 224, simd.load32<byte>(src, from + 224) ^ b3.bitcast32<byte>())
			simd.store32<byte>(dst, to + 256, simd.load32<byte>(src, from + 256) ^ a4.bitcast32<byte>())
			simd.store32<byte>(dst, to + 288, simd.load32<byte>(src, from + 288) ^ b4.bitcast32<byte>())
			simd.store32<byte>(dst, to + 320, simd.load32<byte>(src, from + 320) ^ a5.bitcast32<byte>())
			simd.store32<byte>(dst, to + 352, simd.load32<byte>(src, from + 352) ^ b5.bitcast32<byte>())
			simd.store32<byte>(dst, to + 384, simd.load32<byte>(src, from + 384) ^ a6.bitcast32<byte>())
			simd.store32<byte>(dst, to + 416, simd.load32<byte>(src, from + 416) ^ b6.bitcast32<byte>())
			simd.store32<byte>(dst, to + 448, simd.load32<byte>(src, from + 448) ^ a7.bitcast32<byte>())
			simd.store32<byte>(dst, to + 480, simd.load32<byte>(src, from + 480) ^ b7.bitcast32<byte>())
		}
	}

	// Transposes the 8x8 matrix whose rows are r0..r7: interleaving row i
	// with row i + 4 three times moves every column into a row.
	internal def chachaTranspose(r0, r1, r2, r3, r4, r5, r6, r7 vec8<uint32>) (vec8<uint32>, vec8<uint32>, vec8<uint32>, vec8<uint32>, vec8<uint32>, vec8<uint32>, vec8<uint32>, vec8<uint32>) {
		let a0, a1 = r0.zipLo(r4), r0.zipHi(r4)
		let a2, a3 = r1.zipLo(r5), r1.zipHi(r5)
		let a4, a5 = r2.zipLo(r6), r2.zipHi(r6)
		let a6, a7 = r3.zipLo(r7), r3.zipHi(r7)
		let b0, b1 = a0.zipLo(a4), a0.zipHi(a4)
		let b2, b3 = a1.zipLo(a5), a1.zipHi(a5)
		let b4, b5 = a2.zipLo(a6), a2.zipHi(a6)
		let b6, b7 = a3.zipLo(a7), a3.zipHi(a7)
		return (b0.zipLo(b4), b0.zipHi(b4), b1.zipLo(b5), b1.zipHi(b5), b2.zipLo(b6), b2.zipHi(b6), b3.zipLo(b7), b3.zipHi(b7))
	}

	// chachaBlock writes the 64-byte keystream block for the state.
	internal def chachaBlock(state uint32[], out byte[]) {
		let x0, x1, x2, x3 = state[0], state[1], state[2], state[3]
		let x4, x5, x6, x7 = state[4], state[5], state[6], state[7]
		let x8, x9, x10, x11 = state[8], state[9], state[10], state[11]
		let x12, x13, x14, x15 = state[12], state[13], state[14], state[15]
		for let i = 0; i < 10; i++ {
			x0 += x4
			x12 = rotl32(x12 ^ x0, 16)
			x8 += x12
			x4 = rotl32(x4 ^ x8, 12)
			x0 += x4
			x12 = rotl32(x12 ^ x0, 8)
			x8 += x12
			x4 = rotl32(x4 ^ x8, 7)
			x1 += x5
			x13 = rotl32(x13 ^ x1, 16)
			x9 += x13
			x5 = rotl32(x5 ^ x9, 12)
			x1 += x5
			x13 = rotl32(x13 ^ x1, 8)
			x9 += x13
			x5 = rotl32(x5 ^ x9, 7)
			x2 += x6
			x14 = rotl32(x14 ^ x2, 16)
			x10 += x14
			x6 = rotl32(x6 ^ x10, 12)
			x2 += x6
			x14 = rotl32(x14 ^ x2, 8)
			x10 += x14
			x6 = rotl32(x6 ^ x10, 7)
			x3 += x7
			x15 = rotl32(x15 ^ x3, 16)
			x11 += x15
			x7 = rotl32(x7 ^ x11, 12)
			x3 += x7
			x15 = rotl32(x15 ^ x3, 8)
			x11 += x15
			x7 = rotl32(x7 ^ x11, 7)
			x0 += x5
			x15 = rotl32(x15 ^ x0, 16)
			x10 += x15
			x5 = rotl32(x5 ^ x10, 12)
			x0 += x5
			x15 = rotl32(x15 ^ x0, 8)
			x10 += x15
			x5 = rotl32(x5 ^ x10, 7)
			x1 += x6
			x12 = rotl32(x12 ^ x1, 16)
			x11 += x12
			x6 = rotl32(x6 ^ x11, 12)
			x1 += x6
			x12 = rotl32(x12 ^ x1, 8)
			x11 += x12
			x6 = rotl32(x6 ^ x11, 7)
			x2 += x7
			x13 = rotl32(x13 ^ x2, 16)
			x8 += x13
			x7 = rotl32(x7 ^ x8, 12)
			x2 += x7
			x13 = rotl32(x13 ^ x2, 8)
			x8 += x13
			x7 = rotl32(x7 ^ x8, 7)
			x3 += x4
			x14 = rotl32(x14 ^ x3, 16)
			x9 += x14
			x4 = rotl32(x4 ^ x9, 12)
			x3 += x4
			x14 = rotl32(x14 ^ x3, 8)
			x9 += x14
			x4 = rotl32(x4 ^ x9, 7)
		}
		writeUint32LE(out, 0, x0 + state[0])
		writeUint32LE(out, 4, x1 + state[1])
		writeUint32LE(out, 8, x2 + state[2])
		writeUint32LE(out, 12, x3 + state[3])
		writeUint32LE(out, 16, x4 + state[4])
		writeUint32LE(out, 20, x5 + state[5])
		writeUint32LE(out, 24, x6 + state[6])
		writeUint32LE(out, 28, x7 + state[7])
		writeUint32LE(out, 32, x8 + state[8])
		writeUint32LE(out, 36, x9 + state[9])
		writeUint32LE(out, 40, x10 + state[10])
		writeUint32LE(out, 44, x11 + state[11])
		writeUint32LE(out, 48, x12 + state[12])
		writeUint32LE(out, 52, x13 + state[13])
		writeUint32LE(out, 56, x14 + state[14])
		writeUint32LE(out, 60, x15 + state[15])
	}

	internal const (
		polyLimb    = 0x3ffffff
		// Messages from this many bytes on take the four-lane path, which
		// first has to raise r to its fourth power.
		polyWideMin = 256
	)

	// Poly1305 is the one-time authenticator of RFC 8439: a 32-byte key
	// (r || s) used for exactly one message, a 16-byte tag. Arithmetic is
	// in 26-bit limbs so no operation depends on the data.
	type Poly1305 {
		internal r0, r1, r2, r3, r4     uint64
		internal h0, h1, h2, h3, h4     uint64
		internal pad0, pad1, pad2, pad3 uint32
		// Fewer than 16 bytes that do not fill a block yet.
		internal pending                byte[]
		// Multipliers of the four-lane path, four lanes a row: limbs 0..4
		// and then five times limbs 1..4, first of r^4 in every lane, then
		// of r^4, r^3, r^2 and r. Empty until that path needs it.
		internal powers                 uint64[]

		// The key must be 32 bytes; poly1305 checks. Longer arrays are read
		// up to byte 32.
		def new(key byte[]) {
			r0 = uint64(readUint32LE(key, 0)) & 0x3ffffff
			r1 = uint64(readUint32LE(key, 3) >> 2) & 0x3ffff03
			r2 = uint64(readUint32LE(key, 6) >> 4) & 0x3ffc0ff
			r3 = uint64(readUint32LE(key, 9) >> 6) & 0x3f03fff
			r4 = uint64(readUint32LE(key, 12) >> 8) & 0x00fffff
			pad0 = readUint32LE(key, 16)
			pad1 = readUint32LE(key, 20)
			pad2 = readUint32LE(key, 24)
			pad3 = readUint32LE(key, 28)
			h0, h1, h2, h3, h4 = 0, 0, 0, 0, 0
			pending = []
			powers = []
		}

		// write feeds message bytes and returns how many.
		def write(data byte[]) int {
			absorb(data, 0, data.len())
			return data.len()
		}

		// sum returns the 16-byte tag over everything written so far.
		def sum() byte[] {
			let hh0, hh1, hh2, hh3, hh4 = h0, h1, h2, h3, h4
			if pending.len() > 0 {
				let last = zeros(16)
				pending.copy(last)
				last[pending.len()] = 1
				absorbBlocks(last, 0, 1, 0)
			}
			let out = finalTag()
			h0, h1, h2, h3, h4 = hh0, hh1, hh2, hh3, hh4
			return out
		}

		// absorb feeds count bytes of data from off.
		internal def absorb(data byte[], off int, count int) {
			if pending.len() > 0 {
				let take = 16 - pending.len()
				take = count when take > count
				pending = pending + data[off:off + take]
				off += take
				count -= take
				return when pending.len() < 16
				absorbBlocks(pending, 0, 1, 1 << 24)
				pending = []
			}
			if count >= polyWideMin {
				raisePowers() when powers.len() == 0
				let groups = count / 64
				absorbWide(data, off, groups)
				off += groups * 64
				count -= groups * 64
			}
			let blocks = count / 16
			absorbBlocks(data, off, blocks, 1 << 24)
			off += blocks * 16
			count -= blocks * 16
			pending = data[off:off + count] when count > 0
		}

		// absorbBlocks takes blocks 16-byte blocks of m from off: h = (h +
		// block) * r for each. hibit is the bit above a whole block, 0 for
		// the padded last one.
		internal def absorbBlocks(m byte[], off int, blocks int, hibit uint64) {
			let s1 = r1 * 5
			let s2 = r2 * 5
			let s3 = r3 * 5
			let s4 = r4 * 5
			let a0, a1, a2, a3, a4 = h0, h1, h2, h3, h4
			let b0, b1, b2, b3, b4 = r0, r1, r2, r3, r4
			for let i = 0; i < blocks; i++ {
				a0 += uint64(readUint32LE(m, off)) & polyLimb
				a1 += uint64(readUint32LE(m, off + 3) >> 2) & polyLimb
				a2 += uint64(readUint32LE(m, off + 6) >> 4) & polyLimb
				a3 += uint64(readUint32LE(m, off + 9) >> 6) & polyLimb
				a4 += uint64(readUint32LE(m, off + 12) >> 8) | hibit
				off += 16

				let d0 = a0 * b0 + a1 * s4 + a2 * s3 + a3 * s2 + a4 * s1
				let d1 = a0 * b1 + a1 * b0 + a2 * s4 + a3 * s3 + a4 * s2
				let d2 = a0 * b2 + a1 * b1 + a2 * b0 + a3 * s4 + a4 * s3
				let d3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + a4 * s4
				let d4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0

				let c = d0 >> 26
				a0 = d0 & polyLimb
				d1 += c
				c = d1 >> 26
				a1 = d1 & polyLimb
				d2 += c
				c = d2 >> 26
				a2 = d2 & polyLimb
				d3 += c
				c = d3 >> 26
				a3 = d3 & polyLimb
				d4 += c
				c = d4 >> 26
				a4 = d4 & polyLimb
				a0 += c * 5
				c = a0 >> 26
				a0 &= polyLimb
				a1 += c
			}
			h0, h1, h2, h3, h4 = a0, a1, a2, a3, a4
		}

		// raisePowers fills powers from r.
		internal def raisePowers() {
			let r = uint64[r0, r1, r2, r3, r4]
			let square = polyMultiply(r, r)
			let cube = polyMultiply(square, r)
			let fourth = polyMultiply(square, square)
			powers.len(72)
			for let k = 0; k < 5; k++ {
				powers[k * 4] = fourth[k]
				powers[k * 4 + 1] = fourth[k]
				powers[k * 4 + 2] = fourth[k]
				powers[k * 4 + 3] = fourth[k]
				powers[36 + k * 4] = fourth[k]
				powers[36 + k * 4 + 1] = cube[k]
				powers[36 + k * 4 + 2] = square[k]
				powers[36 + k * 4 + 3] = r[k]
			}
			for let i = 0; i < 16; i++ {
				powers[20 + i] = powers[4 + i] * 5
				powers[56 + i] = powers[40 + i] * 5
			}
		}

		// absorbWide takes groups runs of four 16-byte blocks of m from
		// off, one block per vector lane. Each lane multiplies by r^4 per
		// run; the last run multiplies lane j by r^(4-j) instead, so the
		// lanes add up to what block-by-block absorbing gives. Needs powers.
		internal def absorbWide(m byte[], off int, groups int) {
			let limb = simd.splat4<uint64>(uint64(polyLimb))
			let low = simd.splat4<uint64>(uint64(0xffffffff))
			let whole = simd.splat4<uint64>(uint64(1) << 24)
			let zero = simd.splat4<uint64>(uint64(0))
			let a0 = zero.withLane(0, h0)
			let a1 = zero.withLane(0, h1)
			let a2 = zero.withLane(0, h2)
			let a3 = zero.withLane(0, h3)
			let a4 = zero.withLane(0, h4)
			for let g = 0; g < groups; g++ {
				// The multipliers are read and masked here, inside the loop:
				// the code generator only emits the 32x32-bit multiply for
				// operands it can see are 32 bits wide in this very block.
				let row = 0
				row = 36 when g == groups - 1
				let p0 = simd.load4<uint64>(powers, row) & low
				let p1 = simd.load4<uint64>(powers, row + 4) & low
				let p2 = simd.load4<uint64>(powers, row + 8) & low
				let p3 = simd.load4<uint64>(powers, row + 12) & low
				let p4 = simd.load4<uint64>(powers, row + 16) & low
				let q1 = simd.load4<uint64>(powers, row + 20) & low
				let q2 = simd.load4<uint64>(powers, row + 24) & low
				let q3 = simd.load4<uint64>(powers, row + 28) & low
				let q4 = simd.load4<uint64>(powers, row + 32) & low
				// Blocks 0,1 and 2,3 as 64-bit halves, regrouped into the
				// four low and the four high halves (little-endian lanes).
				let front = simd.load32<byte>(m, off).bitcast4<uint64>()
				let back = simd.load32<byte>(m, off + 32).bitcast4<uint64>()
				off += 64
				let even = front.zipLo(back)
				let odd = front.zipHi(back)
				let lo = even.zipLo(odd)
				let hi = even.zipHi(odd)
				a0 = (a0 + (lo & limb)) & low
				a1 = (a1 + ((lo >> 26) & limb)) & low
				a2 = (a2 + (((lo >> 52) | (hi << 12)) & limb)) & low
				a3 = (a3 + ((hi >> 14) & limb)) & low
				a4 = (a4 + ((hi >> 40) | whole)) & low
				let d0 = a0 * p0 + a1 * q4 + a2 * q3 + a3 * q2 + a4 * q1
				let d1 = a0 * p1 + a1 * p0 + a2 * q4 + a3 * q3 + a4 * q2
				let d2 = a0 * p2 + a1 * p1 + a2 * p0 + a3 * q4 + a4 * q3
				let d3 = a0 * p3 + a1 * p2 + a2 * p1 + a3 * p0 + a4 * q4
				let d4 = a0 * p4 + a1 * p3 + a2 * p2 + a3 * p1 + a4 * p0

				let c = d0 >> 26
				a0 = d0 & limb
				d1 = d1 + c
				c = d1 >> 26
				a1 = d1 & limb
				d2 = d2 + c
				c = d2 >> 26
				a2 = d2 & limb
				d3 = d3 + c
				c = d3 >> 26
				a3 = d3 & limb
				d4 = d4 + c
				c = d4 >> 26
				a4 = d4 & limb
				a0 = a0 + c + (c << 2)
				c = a0 >> 26
				a0 = a0 & limb
				a1 = a1 + c
			}
			// Four lanes of under 2^27 each: carry once more after adding.
			let t0, t1, t2, t3, t4 = a0.sum(), a1.sum(), a2.sum(), a3.sum(), a4.sum()
			t1 += t0 >> 26
			t2 += t1 >> 26
			t3 += t2 >> 26
			t4 += t3 >> 26
			h0 = (t0 & polyLimb) + (t4 >> 26) * 5
			h1 = t1 & polyLimb
			h2 = t2 & polyLimb
			h3 = t3 & polyLimb
			h4 = t4 & polyLimb
		}

		internal def finalTag() byte[] {
			let c = h1 >> 26
			h1 &= 0x3ffffff
			h2 += c
			c = h2 >> 26
			h2 &= 0x3ffffff
			h3 += c
			c = h3 >> 26
			h3 &= 0x3ffffff
			h4 += c
			c = h4 >> 26
			h4 &= 0x3ffffff
			h0 += c * 5
			c = h0 >> 26
			h0 &= 0x3ffffff
			h1 += c

			// Compute h + -p and keep it when it did not go negative.
			let g0 = h0 + 5
			c = g0 >> 26
			g0 &= 0x3ffffff
			let g1 = h1 + c
			c = g1 >> 26
			g1 &= 0x3ffffff
			let g2 = h2 + c
			c = g2 >> 26
			g2 &= 0x3ffffff
			let g3 = h3 + c
			c = g3 >> 26
			g3 &= 0x3ffffff
			let g4 = h4 + c - (uint64(1) << 26)

			let mask = (g4 >> 63) - 1
			let inv = mask ^ 0xFFFFFFFFFFFFFFFF
			let f0 = (h0 & inv) | (g0 & mask)
			let f1 = (h1 & inv) | (g1 & mask)
			let f2 = (h2 & inv) | (g2 & mask)
			let f3 = (h3 & inv) | (g3 & mask)
			let f4 = (h4 & inv) | (g4 & mask)

			let w0 = (f0 | f1 << 26) & 0xffffffff
			let w1 = ((f1 >> 6) | f2 << 20) & 0xffffffff
			let w2 = ((f2 >> 12) | f3 << 14) & 0xffffffff
			let w3 = ((f3 >> 18) | f4 << 8) & 0xffffffff

			let f = w0 + uint64(pad0)
			w0 = f & 0xffffffff
			f = w1 + uint64(pad1) + (f >> 32)
			w1 = f & 0xffffffff
			f = w2 + uint64(pad2) + (f >> 32)
			w2 = f & 0xffffffff
			f = w3 + uint64(pad3) + (f >> 32)
			w3 = f & 0xffffffff

			let out = zeros(16)
			writeUint32LE(out, 0, uint32(w0))
			writeUint32LE(out, 4, uint32(w1))
			writeUint32LE(out, 8, uint32(w2))
			writeUint32LE(out, 12, uint32(w3))
			return out
		}
	}

	// The product of two numbers of five 26-bit limbs modulo 2^130 - 5,
	// limbs carried back under 2^26 (the second one a little over).
	internal def polyMultiply(a, b uint64[]) uint64[] {
		let s1 = b[1] * 5
		let s2 = b[2] * 5
		let s3 = b[3] * 5
		let s4 = b[4] * 5
		let d0 = a[0] * b[0] + a[1] * s4 + a[2] * s3 + a[3] * s2 + a[4] * s1
		let d1 = a[0] * b[1] + a[1] * b[0] + a[2] * s4 + a[3] * s3 + a[4] * s2
		let d2 = a[0] * b[2] + a[1] * b[1] + a[2] * b[0] + a[3] * s4 + a[4] * s3
		let d3 = a[0] * b[3] + a[1] * b[2] + a[2] * b[1] + a[3] * b[0] + a[4] * s4
		let d4 = a[0] * b[4] + a[1] * b[3] + a[2] * b[2] + a[3] * b[1] + a[4] * b[0]
		d1 += d0 >> 26
		d2 += d1 >> 26
		d3 += d2 >> 26
		d4 += d3 >> 26
		let low = (d0 & polyLimb) + (d4 >> 26) * 5
		return uint64[low & polyLimb, (d1 & polyLimb) + (low >> 26), d2 & polyLimb, d3 & polyLimb, d4 & polyLimb]
	}

	// poly1305 returns the tag of message under a one-time 32-byte key.
	// Fails when the key has the wrong length.
	def poly1305(key, message byte[]) !byte[] {
		expects {
			assert key.len() == 32 onerror fail "poly1305: key must be 32 bytes"
		}
		let mac = new Poly1305(key)
		mac.write(message)
		return mac.sum()
	}

	// newChaCha20Poly1305 returns the AEAD of RFC 8439 for a 32-byte key.
	// Fails for any other key length.
	def newChaCha20Poly1305(key byte[]) !ChaCha20Poly1305 {
		expects {
			assert key.len() == chachaKeySize onerror fail "chacha20poly1305: key must be 32 bytes"
		}
		return new ChaCha20Poly1305(key)
	}

	// ChaCha20Poly1305 is the AEAD construction of RFC 8439: ChaCha20 for
	// confidentiality, Poly1305 under a per-nonce key for the tag. 12-byte
	// nonces, 16-byte tags. Implements AEAD. Construct through
	// newChaCha20Poly1305.
	type ChaCha20Poly1305 {
		internal key byte[]

		def new(key byte[]) {
			self.key = key
		}

		// nonceSize implements AEAD: 12.
		def nonceSize() int {
			return chachaNonceSize
		}

		// overhead implements AEAD: 16.
		def overhead() int {
			return 16
		}

		// seal implements AEAD: ciphertext followed by the tag. The nonce
		// must be 12 bytes and never repeat under this key.
		def seal(nonce, plaintext, additional byte[]) byte[] {
			// The interface has no failure: a nonce of another length gets
			// the tag of an empty message under a zero key, as it always did.
			return tag(zeros(32), [], 0, additional) when nonce.len() != chachaNonceSize
			let count = plaintext.len()
			let out byte[]
			out.len(count + 16)
			let state = chachaState(key, nonce, 0)
			let oneTime = zeros(64)
			chachaBlock(state, oneTime)
			state[12] = 1
			chachaXor(state, plaintext, 0, out, 0, count)
			let sum = tag(oneTime, out, count, additional)
			for let i = 0; i < 16; i++ {
				out[count + i] = sum[i]
			}
			return out
		}

		// open implements AEAD. Fails when the ciphertext is shorter than a
		// tag or the tag does not verify.
		def open(nonce, ciphertext, additional byte[]) !byte[] {
			expects {
				assert nonce.len() == chachaNonceSize onerror fail "chacha20poly1305: wrong nonce length"
				assert ciphertext.len() >= 16 onerror fail "chacha20poly1305: message authentication failed"
			}
			let count = ciphertext.len() - 16
			let state = chachaState(key, nonce, 0)
			let oneTime = zeros(64)
			chachaBlock(state, oneTime)
			let expected = tag(oneTime, ciphertext, count, additional)
			fail "chacha20poly1305: message authentication failed" unless constantTimeEqual(expected, ciphertext[count:])
			let out byte[]
			out.len(count)
			state[12] = 1
			chachaXor(state, ciphertext, 0, out, 0, count)
			return out
		}

		// The tag over the additional data and the first count bytes of
		// ciphertext, under the Poly1305 key in oneTime's first 32 bytes.
		internal def tag(oneTime, ciphertext byte[], count int, additional byte[]) byte[] {
			let mac = new Poly1305(oneTime)
			mac.write(additional)
			mac.write(zeros(16 - additional.len() % 16)) when additional.len() % 16 != 0
			mac.write(ciphertext[:count])
			mac.write(zeros(16 - count % 16)) when count % 16 != 0
			let lengths = zeros(16)
			writeUint64LE(lengths, 0, uint64(additional.len()))
			writeUint64LE(lengths, 8, uint64(count))
			mac.write(lengths)
			return mac.sum()
		}
	}

	// newXChaCha20Poly1305 returns the XChaCha20-Poly1305 AEAD for a
	// 32-byte key. Fails for any other key length.
	def newXChaCha20Poly1305(key byte[]) !XChaCha20Poly1305 {
		expects {
			assert key.len() == chachaKeySize onerror fail "xchacha20poly1305: key must be 32 bytes"
		}
		return new XChaCha20Poly1305(key)
	}

	// XChaCha20Poly1305 is ChaCha20Poly1305 with 24-byte nonces
	// (draft-irtf-cfrg-xchacha): long enough to draw at random for every
	// message under one key. 16-byte tags. Implements AEAD. Construct
	// through newXChaCha20Poly1305.
	type XChaCha20Poly1305 {
		internal key byte[]

		def new(key byte[]) {
			self.key = key
		}

		// nonceSize implements AEAD: 24.
		def nonceSize() int {
			return xchachaNonceSize
		}

		// overhead implements AEAD: 16.
		def overhead() int {
			return 16
		}

		// seal implements AEAD: ciphertext followed by the tag. The nonce
		// must be 24 bytes and never repeat under this key.
		def seal(nonce, plaintext, additional byte[]) byte[] {
			// The interface has no failure: a nonce of another length gets
			// what ChaCha20Poly1305 gives one.
			return new ChaCha20Poly1305(key).seal([], plaintext, additional) when nonce.len() != xchachaNonceSize
			return new ChaCha20Poly1305(hchacha20(key, nonce)).seal(xchachaInner(nonce), plaintext, additional)
		}

		// open implements AEAD. Fails when the ciphertext is shorter than a
		// tag or the tag does not verify.
		def open(nonce, ciphertext, additional byte[]) !byte[] {
			expects {
				assert nonce.len() == xchachaNonceSize onerror fail "xchacha20poly1305: wrong nonce length"
			}
			return try new ChaCha20Poly1305(hchacha20(key, nonce)).open(xchachaInner(nonce), ciphertext, additional)
		}
	}
}
