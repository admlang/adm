partial module std.crypto.cipher {
	// Block is a cipher that transforms one fixed-size block under a key.
	interface Block {
		def blockSize() int
		def encryptBlock(dst, src byte[])
		def decryptBlock(dst, src byte[])
	}

	// AEAD is authenticated encryption with associated data. seal encrypts
	// plaintext and appends a tag over it and the additional data; open
	// checks the tag and decrypts. A nonce must never repeat under one key.
	interface AEAD {
		def nonceSize() int
		def overhead() int
		def seal(nonce, plaintext, additional byte[]) byte[]
		def open(nonce, ciphertext, additional byte[]) !byte[]
	}

	internal def zeros(count int) byte[] {
		let out byte[]
		out.len(count)
		return out
	}

	internal def readUint32BE(b byte[], off int) uint32 {
		return uint32(b[off]) << 24 | uint32(b[off + 1]) << 16 | uint32(b[off + 2]) << 8 | uint32(b[off + 3])
	}

	internal def readUint32LE(b byte[], off int) uint32 {
		return uint32(b[off]) | uint32(b[off + 1]) << 8 | uint32(b[off + 2]) << 16 | uint32(b[off + 3]) << 24
	}

	internal def readUint64BE(b byte[], off int) uint64 {
		return uint64(readUint32BE(b, off)) << 32 | uint64(readUint32BE(b, off + 4))
	}

	internal def writeUint32BE(b byte[], off int, v uint32) {
		b[off] = byte(v >> 24)
		b[off + 1] = byte((v >> 16) & 0xFF)
		b[off + 2] = byte((v >> 8) & 0xFF)
		b[off + 3] = byte(v & 0xFF)
	}

	internal def writeUint32LE(b byte[], off int, v uint32) {
		b[off] = byte(v & 0xFF)
		b[off + 1] = byte((v >> 8) & 0xFF)
		b[off + 2] = byte((v >> 16) & 0xFF)
		b[off + 3] = byte(v >> 24)
	}

	internal def writeUint64BE(b byte[], off int, v uint64) {
		writeUint32BE(b, off, uint32(v >> 32))
		writeUint32BE(b, off + 4, uint32(v & 0xFFFFFFFF))
	}

	internal def writeUint64LE(b byte[], off int, v uint64) {
		writeUint32LE(b, off, uint32(v & 0xFFFFFFFF))
		writeUint32LE(b, off + 4, uint32(v >> 32))
	}

	internal def rotl32(x uint32, n int) uint32 {
		return (x << n) | (x >> (32 - n))
	}
}
