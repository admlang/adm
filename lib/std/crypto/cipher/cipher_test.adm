partial module std.crypto.cipher {
	use (
		std.testing
		std.crypto.hash::(SHA256)
		std.data.encoding::(hexdecode)
	)

	internal def unhex(text string) byte[] {
		return hexdecode(text) onerror recover []
	}

	check "AES" {
		@test()
		def cbcMatchesSp80038a() !none {
			let block = try newAES(unhex("2b7e151628aed2a6abf7158809cf4f3c"))
			let cbc = try newCBC(block, unhex("000102030405060708090a0b0c0d0e0f"))
			let plain = unhex("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51")
			let sealed = try cbc.encrypt(plain)
			assert sealed.equals(unhex("7649abac8119b246cee98e9b12e9197d5086cb9b507219ee95db113a917678b2"))
			assert (try cbc.decrypt(sealed)).equals(plain)
			let refused = false
			cbc.encrypt(plain[:5]) onerror (err error) {
				refused = true
				recover byte[]
			}
			assert refused
		}

		@test()
		def pkcs7PadsAndUnpads() !none {
			let padded = padPKCS7("abc".bytes(), 8)
			assert padded.equals(byte[0x61, 0x62, 0x63, 5, 5, 5, 5, 5])
			assert string(try unpadPKCS7(padded, 8)) == "abc"
			assert padPKCS7(byte[1, 2, 3, 4], 4).len() == 8
			let refused = false
			unpadPKCS7(byte[1, 2, 3, 9], 4) onerror (err error) {
				refused = true
				recover byte[]
			}
			assert refused
		}

		@test()
		def TestAESFIPS197() !none {
			let plain = unhex("00112233445566778899aabbccddeeff")
			let out = zeros(16)
			let back = zeros(16)

			let aes128 = try newAES(unhex("000102030405060708090a0b0c0d0e0f"))
			aes128.encryptBlock(out, plain)
			assert out.hex() == "69C4E0D86A7B0430D8CDB78070B4C55A"
			aes128.decryptBlock(back, out)
			assert back.hex() == "00112233445566778899AABBCCDDEEFF"

			let aes192 = try newAES(unhex("000102030405060708090a0b0c0d0e0f1011121314151617"))
			aes192.encryptBlock(out, plain)
			assert out.hex() == "DDA97CA4864CDFE06EAF70A0EC0D7191"
			aes192.decryptBlock(back, out)
			assert back.hex() == "00112233445566778899AABBCCDDEEFF"

			let aes256 = try newAES(unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"))
			aes256.encryptBlock(out, plain)
			assert out.hex() == "8EA2B7CA516745BFEAFC49904B496089"
			aes256.decryptBlock(back, out)
			assert back.hex() == "00112233445566778899AABBCCDDEEFF"
			assert aes256.blockSize() == 16

			let bad = newAES(zeros(10)) onerror recover aes128
			assert bad.blockSize() == 16
		}
	}

	check "GCM" {
		@test()
		def TestGCMVectors() !none {
			// McGrew and Viega test cases 1, 2, 3, 4 and 14.
			let g0 = try newGCM(try newAES(zeros(16)))
			assert g0.nonceSize() == 12
			assert g0.overhead() == 16
			assert g0.seal(zeros(12), [], []).hex() == "58E2FCCEFA7E3061367F1D57A4E7455A"
			assert g0.seal(zeros(12), zeros(16), []).hex() == "0388DACE60B6A392F328C2B971B2FE78AB6E47D42CEC13BDF53A67B21257BDDF"

			let key = unhex("feffe9928665731c6d6a8f9467308308")
			let nonce = unhex("cafebabefacedbaddecaf888")
			let plain = unhex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255")
			let g = try newGCM(try newAES(key))
			let sealed = g.seal(nonce, plain, [])
			assert sealed.hex() == "42831EC2217774244B7221B784D0D49CE3AA212F2C02A4E035C17E2329ACA12E21D514B25466931C7D8F6A5AAC84AA051BA30B396A0AAC973D58E091473F59854D5C2AF327CD64A62CF35ABD2BA6FAB4"
			assert (try g.open(nonce, sealed, [])).hex() == plain.hex()

			let aad = unhex("feedfacedeadbeeffeedfacedeadbeefabaddad2")
			let sealed4 = g.seal(nonce, plain[0:60], aad)
			assert sealed4.hex() == "42831EC2217774244B7221B784D0D49CE3AA212F2C02A4E035C17E2329ACA12E21D514B25466931C7D8F6A5AAC84AA051BA30B396A0AAC973D58E0915BC94FBC3221A5DB94FAE95AE7121A47"
			assert (try g.open(nonce, sealed4, aad)).hex() == plain[0:60].hex()

			let g256 = try newGCM(try newAES(zeros(32)))
			assert g256.seal(zeros(12), zeros(16), []).hex() == "CEA7403D4D606B6E074EC5D3BAF39D18D0D1C8A799996BF0265B98B5D48AB919"
		}

		@test()
		def TestGCMRejects() !none {
			let g = try newGCM(try newAES(zeros(16)))
			let sealed = g.seal(zeros(12), "hello".bytes(), "aad".bytes())
			sealed[0] ^= 1
			let tampered = g.open(zeros(12), sealed, "aad".bytes()) onerror recover "tampered".bytes()
			assert string(tampered) == "tampered"
			sealed[0] ^= 1
			let wrongAAD = g.open(zeros(12), sealed, "bad".bytes()) onerror recover "tampered".bytes()
			assert string(wrongAAD) == "tampered"
			let short = g.open(zeros(12), zeros(4), []) onerror recover "tampered".bytes()
			assert string(short) == "tampered"
			assert string(try g.open(zeros(12), sealed, "aad".bytes())) == "hello"
		}
	}

	check "ChaCha20" {
		@test()
		def TestChaCha20RFC8439() !none {
			let key = unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
			let nonce = unhex("000000000000004a00000000")
			let plain = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".bytes()
			let cipher = try chacha20(key, nonce, 1, plain)
			assert cipher.hex() == "6E2E359A2568F98041BA0728DD0D6981E97E7AEC1D4360C20A27AFCCFD9FAE0BF91B65C5524733AB8F593DABCD62B3571639D624E65152AB8F530C359F0861D807CA0DBF500D6A6156A38E088A22B65E52BC514D16CCF806818CE91AB77937365AF90BBF74A35BE6B40B8EEDF2785E42874D"
			assert string(try chacha20(key, nonce, 1, cipher)) == string(plain)
		}

		@test()
		def TestPoly1305RFC8439() !none {
			let key = unhex("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
			let tag = try poly1305(key, "Cryptographic Forum Research Group".bytes())
			assert tag.hex() == "A8061DC1305136C6C22B8BAF0C0127A9"

			let mac = new Poly1305(key)
			mac.write("Cryptographic Forum ".bytes())
			mac.write("Research Group".bytes())
			assert mac.sum().hex() == "A8061DC1305136C6C22B8BAF0C0127A9"
			// sum does not consume: a second call agrees.
			assert mac.sum().hex() == "A8061DC1305136C6C22B8BAF0C0127A9"
		}

		@test()
		def TestChaCha20Poly1305RFC8439() !none {
			let key = unhex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
			let nonce = unhex("070000004041424344454647")
			let aad = unhex("50515253c0c1c2c3c4c5c6c7")
			let plain = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".bytes()
			let aead = try newChaCha20Poly1305(key)
			assert aead.nonceSize() == 12
			assert aead.overhead() == 16
			let sealed = aead.seal(nonce, plain, aad)
			assert sealed.hex() == "D31A8D34648E60DB7B86AFBC53EF7EC2A4ADED51296E08FEA9E2B5A736EE62D63DBEA45E8CA9671282FAFB69DA92728B1A71DE0A9E060B2905D6A5B67ECD3B3692DDBD7F2D778B8C9803AEE328091B58FAB324E4FAD675945585808B4831D7BC3FF4DEF08E4B7A9DE576D26586CEC64B61161AE10B594F09E26A7E902ECBD0600691"
			assert string(try aead.open(nonce, sealed, aad)) == string(plain)

			sealed[3] ^= 0x80
			let tampered = aead.open(nonce, sealed, aad) onerror recover "tampered".bytes()
			assert string(tampered) == "tampered"
		}
		// The AEAD example of draft-irtf-cfrg-xchacha-03 (A.3.1), as
		// libsodium seals it too.
		@test()
		def TestXChaCha20Poly1305Draft() !none {
			let key = unhex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
			let nonce = unhex("404142434445464748494a4b4c4d4e4f5051525354555657")
			let aad = unhex("50515253c0c1c2c3c4c5c6c7")
			let plain = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".bytes()
			let aead = try newXChaCha20Poly1305(key)
			assert aead.nonceSize() == 24
			assert aead.overhead() == 16
			let sealed = aead.seal(nonce, plain, aad)
			assert sealed.hex() == "BD6D179D3E83D43B9576579493C0E939572A1700252BFACCBED2902C21396CBB731C7F1B0B4AA6440BF3A82F4EDA7E39AE64C6708C54C216CB96B72E1213B4522F8C9BA40DB5D945B11B69B982C1BB9E3F3FAC2BC369488F76B2383565D3FFF921F9664C97637DA9768812F615C68B13B52EC0875924C1C7987947DEAFD8780ACF49"
			assert string(try aead.open(nonce, sealed, aad)) == string(plain)
			// The sealed bytes are the stream from block 1 on.
			assert sealed[:plain.len()].equals(try xchacha20(key, nonce, 1, plain))
			// The key ChaCha20 runs under, from the draft's section 2.2.1.
			let derived = hchacha20(unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), unhex("000000090000004a0000000031415927"))
			assert derived.hex() == "82413B4227B27BFED30E42508A877D73A0F9E4D58A74A853C12EC41326D3ECDC"

			sealed[3] ^= 0x80
			let tampered = aead.open(nonce, sealed, aad) onerror recover "tampered".bytes()
			assert string(tampered) == "tampered"
			let short = aead.open(nonce[:12], sealed, aad) onerror recover "nonce".bytes()
			assert string(short) == "nonce"
			let badKey = xchacha20(key[:16], nonce, 0, plain) onerror recover "key".bytes()
			assert string(badKey) == "key"
		}
		// Every path by length (block at a time, padded tail, eight blocks
		// and four Poly1305 lanes at once) against OpenSSL's results: the
		// first 8 bytes of SHA-256 over the sealed message and over the
		// raw stream output, and the Poly1305 tag of the plain bytes.
		@test()
		def TestChaCha20Poly1305MatchesOpenSSLByLength() !none {
			let sizes = [0, 1, 63, 64, 65, 128, 129, 255, 256, 257, 511, 512, 513, 640, 1000, 4096, 4097, 9000]
			let seals = ["975BF2C191B9024B", "3D0D0AF0DE7C441C", "885AADB757A5F4A5", "31DF65C6742898E7", "DE0959DA11AB2490", "89F1C8369F759E55", "DA0B1AC909D918B0", "5E82AACF081C6B17", "52ADE3F18BE63F8F", "26393B9A3CDA6C9D", "2AD2BE801DF8A32A", "5EA8FFD73AD32A9D", "277A20BA93B09F5B", "F87826C912D3DF83", "A3FE0BDB48120051", "A76334F3C7C3C778", "45425B708B83BEF7", "1ADD469D36350B18"]
			let tags = ["6D847B39896F5A7D97F1E3B924E2886A", "57BCB21C5C8C39F1485B26813B540E8E", "288855380201D3441BD21A352509C229", "D5C539E5B67DDD35EEBFC8A6F8D6293A", "533DEF220A41E32BB6C43043E8270D41", "F5804B7AFC7E4D4E53E66BC5332908D6", "0C49743CA5CDB6FCC7219F61160F5788", "B5CAAB3BD9EBDF8EBF7C0BFC4F29DDF9", "17042C088E1DA9955F9373119F4BAF3F", "075F5EF0ABBD7EB268A257FE0E4A3D29", "456E49CFE20C42D2542DC313F3DE6F85", "9F1FCF3382097FFD5FB1DACC3418B52D", "9B2D0FBF646C8BE3E4CF8F68E764ADB5", "42B821FF2B3E4DFE3127F66B7F1F8695", "815C286479AA4708C839509BAAE0BA7F", "4A35C23D0DA39094941821B69F74337F", "3D391C3DDACDF228E19A6F5DE170C8C4", "8FDE8C9477197B6D6D7BA8D705C4B828"]
			let streams = ["E3B0C44298FC1C14", "5BAD0D1132AC152C", "C6EFA260DBD6424B", "13C230A07BE7A728", "E6FCCE4D7ABD2B37", "93919D6297B2041F", "37303AB7E089E1C0", "B3914EDCE7E56057", "9990B2335F361117", "A41868DD387AEB43", "C04B42586953577D", "669DD09B8ADFD7C3", "D4882BDFD9C734E9", "987AEF968D0F33B2", "BCEAD6C344E0FA89", "C24525B89DD37547", "5691030DAC1DDDFF", "CAA6193E7A0E1072"]
			let key = chachaPattern(32, 1)
			let nonce = chachaPattern(12, 2)
			let aead = try newChaCha20Poly1305(key)
			for let (i, size) in sizes {
				let plain = chachaPattern(size, size + 7)
				let aad = chachaPattern(size % 37, size)
				let sealed = aead.seal(nonce, plain, aad)
				assert new SHA256().hash(sealed).hex()[:16] == seals[i]
				assert (try aead.open(nonce, sealed, aad)).equals(plain)
				assert (try poly1305(key, plain)).hex() == tags[i]
				assert new SHA256().hash(try chacha20(key, nonce, 7, plain)).hex()[:16] == streams[i]

				// Fed in uneven pieces, the tag is the same.
				let mac = new Poly1305(key)
				let at = 0
				let step = 1
				for at < size {
					let take = step
					take = size - at when take > size - at
					mac.write(plain[at:at + take])
					at += take
					step = step * 3 % 211 + 1
				}
				assert mac.sum().hex() == tags[i]

				if size > 0 {
					sealed[size / 2] ^= 1
					let tampered = aead.open(nonce, sealed, aad) onerror recover "tampered".bytes()
					assert string(tampered) == "tampered"
				}
			}
		}

		// The block counter is 32 bits and wraps, also between the lanes
		// of one wide pass: the stream from counter 2^32 - 3 continues
		// with the stream from counter 0.
		@test()
		def TestChaCha20CounterWraps() !none {
			let key = chachaPattern(32, 3)
			let nonce = chachaPattern(12, 4)
			let plain = chachaPattern(1024, 5)
			let wrapped = try chacha20(key, nonce, 0xFFFFFFFD, plain)
			assert wrapped[:192].equals(try chacha20(key, nonce, 0xFFFFFFFD, plain[:192]))
			assert wrapped[192:].equals(try chacha20(key, nonce, 0, plain[192:]))
		}
	}

	// Repeatable bytes for the length tests; the reference values were
	// produced from the same generator.
	internal def chachaPattern(count, seed int) byte[] {
		let out byte[]
		out.len(count)
		let x = uint32(seed * 2654435761 + 12345)
		for let i = 0; i < count; i++ {
			x = x * 1664525 + 1013904223
			out[i] = byte(x >> 24)
		}
		return out
	}

	check "RC4" {
		@test()
		def knownVectors() !none {
			assert (try rc4("Key".bytes(), "Plaintext".bytes())).equals(unhex("bbf316e8d940af0ad3"))
			assert (try rc4("Wiki".bytes(), "pedia".bytes())).equals(unhex("1021bf0420"))
			let sealed = try rc4("Secret".bytes(), "Attack at dawn".bytes())
			assert sealed.equals(unhex("45a01f645fc35b383552544b9bf5"))
			assert string(try rc4("Secret".bytes(), sealed)) == "Attack at dawn"
			let refused = rc4(byte[], "x".bytes()) onerror recover byte[9]
			assert refused.equals(byte[9])
			return none
		}
	}

	check "Blowfish and CTR" {
		@test()
		def blowfishMatchesSchneierVectors() !none {
			let zero = try newBlowfish(unhex("0000000000000000"))
			let out byte[] = []
			out.len(8)
			zero.encryptBlock(out, unhex("0000000000000000"))
			assert out.equals(unhex("4ef997456198dd78"))
			let key = try newBlowfish(unhex("fedcba9876543210"))
			key.encryptBlock(out, unhex("0123456789abcdef"))
			assert out.equals(unhex("0aceab0fc6a0a28d"))
			let back byte[] = []
			back.len(8)
			key.decryptBlock(back, out)
			assert back.equals(unhex("0123456789abcdef"))
			return none
		}

		@test()
		def ctrMatchesSp80038a() !none {
			let block = try newAES(unhex("2b7e151628aed2a6abf7158809cf4f3c"))
			let iv = unhex("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
			let plain = unhex("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51")
			let want = unhex("874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff")
			let ctr = try newCTR(block, iv)
			assert ctr.encrypt(plain).equals(want)
			// In pieces, across the block boundary and the counter carry.
			let pieces = try newCTR(block, iv)
			let first = pieces.encrypt(plain[:7])
			let rest = pieces.encrypt(plain[7:])
			assert (first + rest).equals(want)
			let again = try newCTR(block, iv)
			assert again.decrypt(want).equals(plain)
			return none
		}
	}

	check "DES and CFB" {
		@test()
		def desMatchesFips() !none {
			let des = try newDES(unhex("133457799bbcdff1"))
			let out byte[] = []
			out.len(8)
			des.encryptBlock(out, unhex("0123456789abcdef"))
			assert out.equals(unhex("85e813540f0ab405"))
			let back byte[] = []
			back.len(8)
			des.decryptBlock(back, out)
			assert back.equals(unhex("0123456789abcdef"))
			// Three equal keys are single DES.
			let triple = try newTripleDES(unhex("133457799bbcdff1133457799bbcdff1133457799bbcdff1"))
			triple.encryptBlock(out, unhex("0123456789abcdef"))
			assert out.equals(unhex("85e813540f0ab405"))
			return none
		}

		@test()
		def cfbMatchesSp80038a() !none {
			let block = try newAES(unhex("2b7e151628aed2a6abf7158809cf4f3c"))
			let iv = unhex("000102030405060708090a0b0c0d0e0f")
			let plain = unhex("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51")
			let want = unhex("3b3fd92eb72dad20333449f8e83cfb4ac8a64537a0b3a93fcde3cdad9f1ce58b")
			let enc = try newCFB(block, iv)
			let first = enc.encrypt(plain[:5])
			assert (first + enc.encrypt(plain[5:])).equals(want)
			let dec = try newCFB(block, iv)
			assert dec.decrypt(want).equals(plain)
			return none
		}

		@test()
		def cmacMatchesRfc4493() !none {
			let block = try newAES(unhex("2b7e151628aed2a6abf7158809cf4f3c"))
			let m = unhex("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
			assert cmac(block, []).equals(unhex("bb1d6929e95937287fa37d129b756746"))
			assert cmac(block, m[:16]).equals(unhex("070a16b46b4d4144f79bdd9dd04a287c"))
			assert cmac(block, m[:40]).equals(unhex("dfa66747de9ae63030ca32611497c827"))
			assert cmac(block, m).equals(unhex("51f0bebf7e3b9d92fc49741779363cfe"))
			let tag = try cmac(unhex("2b7e151628aed2a6abf7158809cf4f3c"), m[:16])
			assert tag.equals(unhex("070a16b46b4d4144f79bdd9dd04a287c"))
			return none
		}
	}
}
