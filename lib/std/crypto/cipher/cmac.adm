partial module std.crypto.cipher {
	// cmac returns the CMAC of `data` under `block` (NIST SP 800-38B,
	// RFC 4493 for AES): a full block-length tag. Works with any block
	// cipher of 8 or 16 bytes.
	//
	// ```
	// let tag = cipher.cmac(try cipher.newAES(key), message)
	// ```
	def cmac(block Block, data byte[]) byte[] {
		let size = block.blockSize()
		let (k1, k2) = cmacSubkeys(block)
		let full = data.len() > 0 && data.len() % size == 0
		let count = full ?? (data.len() / size, data.len() / size + 1)
		let state = zeros(size)
		let tmp = zeros(size)
		for let i = 0; i < count - 1; i++ {
			for let j = 0; j < size; j++ {
				tmp[j] = state[j] ^ data[i * size + j]
			}
			block.encryptBlock(state, tmp)
		}
		// The last block: complete, XORed with K1; or padded with 10*,
		// XORed with K2.
		let start = (count - 1) * size
		for let j = 0; j < size; j++ {
			let at = start + j
			let b byte = 0
			if full {
				b = data[at] ^ k1[j]
			} else {
				let padded byte = at < data.len() ?? (data[at], at == data.len() ?? (byte(0x80), byte(0)))
				b = padded ^ k2[j]
			}
			tmp[j] = state[j] ^ b
		}
		block.encryptBlock(state, tmp)
		return state
	}

	// cmac of `data` under an AES key (16, 24 or 32 bytes). Fails when the
	// key has another length.
	def cmac(key byte[], data byte[]) !byte[] {
		return cmac(try newAES(key), data)
	}

	// The two CMAC subkeys: L = E(0), K1 = L·x, K2 = K1·x in GF(2^n).
	internal def cmacSubkeys(block Block) (byte[], byte[]) {
		let size = block.blockSize()
		let l = zeros(size)
		block.encryptBlock(l, zeros(size))
		let k1 = cmacDouble(l)
		return (k1, cmacDouble(k1))
	}

	// Doubles a block in GF(2^n): shift left one bit, and fold the carry
	// back with the field's constant (0x87 for 128-bit blocks, 0x1B for
	// 64-bit ones).
	internal def cmacDouble(v byte[]) byte[] {
		let out = zeros(v.len())
		let carry = 0
		for let i = v.len() - 1; i >= 0; i-- {
			let b = int(v[i])
			out[i] = byte(((b << 1) | carry) & 0xff)
			carry = b >> 7
		}
		if carry != 0 {
			let last = v.len() - 1
			out[last] = out[last] ^ (v.len() == 16 ?? (byte(0x87), byte(0x1b)))
		}
		return out
	}
}
