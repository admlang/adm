partial module std.crypto.cipher {
	// newCTR returns counter mode over `block` starting at the counter
	// block `iv` (NIST SP 800-38A §6.5): the whole block counts up as one
	// big-endian number. Fails when `iv` is not one block long.
	def newCTR(block Block, iv byte[]) !CTR {
		expects {
			assert iv.len() == block.blockSize() onerror fail "ctr: IV must be one block long"
		}
		return new CTR(block, iv)
	}

	// CTR is a block cipher in counter mode: a keystream XORed into the
	// data, so `encrypt` and `decrypt` are the same operation and any
	// length works. The position carries over between calls, so a stream
	// can be processed in pieces.
	type CTR {
		internal block   Block
		internal counter byte[]
		internal stream  byte[]
		internal used    int

		def new(block Block, iv byte[]) {
			self.block = block
			counter = iv.clone()
			stream = []
			stream.len(iv.len())
			used = iv.len()
		}

		// Returns `data` XORed with the next bytes of the keystream.
		def encrypt(data byte[]) byte[] {
			let out = data.clone()
			apply(out)
			return out
		}

		// Returns `data` XORed with the next bytes of the keystream: the
		// same as `encrypt`.
		def decrypt(data byte[]) byte[] {
			return encrypt(data)
		}

		// XORs the next bytes of the keystream into `data` in place.
		def apply(data byte[]) {
			let size = stream.len()
			for let i = 0; i < data.len(); i++ {
				if used == size {
					block.encryptBlock(stream, counter)
					for let j = size - 1; j >= 0; j-- {
						counter[j] = counter[j] + byte(1)
						break when counter[j] != byte(0)
					}
					used = 0
				}
				data[i] = data[i] ^ stream[used]
				used++
			}
		}
	}
}
