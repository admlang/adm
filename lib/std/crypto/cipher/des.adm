partial module std.crypto.cipher {
	use std.crypto.cipher.des::*

	// newDES returns the DES block cipher (FIPS 46-3) for an 8-byte key.
	// DES is broken: only for protocols that still require it (SNMPv3
	// DES privacy, old files). Fails for another key length.
	def newDES(key byte[]) !DES {
		expects {
			assert key.len() == 8 onerror fail "des: key must be 8 bytes"
		}
		return new DES(key)
	}

	// newTripleDES returns Triple DES in EDE form for a 24-byte key (three
	// DES keys) or a 16-byte one (K1 K2 K1). Fails for another length.
	def newTripleDES(key byte[]) !TripleDES {
		expects {
			assert key.len() == 24 || key.len() == 16 onerror fail "3des: key must be 16 or 24 bytes"
		}
		let third = key.len() == 24 ?? (key[16:24], key[0:8])
		return new TripleDES(new DES(key[0:8]), new DES(key[8:16]), new DES(third))
	}

	// DES is the Data Encryption Standard block cipher. Implements Block.
	type DES {
		internal subkeys uint64[]

		// The key must be 8 bytes; newDES checks. Parity bits are ignored.
		def new(key byte[]) {
			subkeys = desSubkeys(desLoad(key, 0))
		}

		// blockSize implements Block: always 8.
		def blockSize() int {
			return 8
		}

		// encryptBlock implements Block.
		def encryptBlock(dst, src byte[]) {
			desStore(dst, desCrypt(subkeys, desLoad(src, 0), false))
		}

		// decryptBlock implements Block.
		def decryptBlock(dst, src byte[]) {
			desStore(dst, desCrypt(subkeys, desLoad(src, 0), true))
		}
	}

	// TripleDES is DES applied three times, encrypt-decrypt-encrypt.
	// Implements Block.
	type TripleDES {
		internal first  DES
		internal second DES
		internal third  DES

		def new(first DES, second DES, third DES) {
			self.first = first
			self.second = second
			self.third = third
		}

		// blockSize implements Block: always 8.
		def blockSize() int {
			return 8
		}

		// encryptBlock implements Block.
		def encryptBlock(dst, src byte[]) {
			let tmp byte[] = []
			tmp.len(8)
			first.encryptBlock(tmp, src)
			second.decryptBlock(tmp, tmp.clone())
			third.encryptBlock(dst, tmp)
		}

		// decryptBlock implements Block.
		def decryptBlock(dst, src byte[]) {
			let tmp byte[] = []
			tmp.len(8)
			third.decryptBlock(tmp, src)
			second.encryptBlock(tmp, tmp.clone())
			first.decryptBlock(dst, tmp)
		}
	}
}

internal partial module std.crypto.cipher.des {
	use std.crypto.cipher::*

	def desLoad(b byte[], off int) uint64 {
		let v uint64 = 0
		for let i = 0; i < 8; i++ {
			v = (v << uint64(8)) | uint64(b[off + i])
		}
		return v
	}

	def desStore(dst byte[], v uint64) {
		for let i = 0; i < 8; i++ {
			dst[i] = byte(v >> uint64(56 - 8 * i))
		}
	}

	// Picks bits by a 1-based table from a value of `width` bits.
	def desPermute(v uint64, table int[], width int) uint64 {
		let out uint64 = 0
		for let p in table {
			out = (out << uint64(1)) | ((v >> uint64(width - p)) & uint64(1))
		}
		return out
	}

	def desSubkeys(key uint64) uint64[] {
		let k = desPermute(key, desPC1, 64)
		let mask uint64 = 0xfffffff
		let c = k >> uint64(28)
		let d = k & mask
		let out uint64[] = []
		for let s in desShifts {
			c = ((c << uint64(s)) | (c >> uint64(28 - s))) & mask
			d = ((d << uint64(s)) | (d >> uint64(28 - s))) & mask
			out.push(desPermute((c << uint64(28)) | d, desPC2, 56))
		}
		return out
	}

	def desRound(r uint64, k uint64) uint64 {
		let x = desPermute(r, desE, 32) ^ k
		let out uint64 = 0
		for let i = 0; i < 8; i++ {
			let b = int((x >> uint64(42 - 6 * i)) & uint64(63))
			let row = ((b >> 4) & 2) | (b & 1)
			let col = (b >> 1) & 15
			out = (out << uint64(4)) | uint64(desS[i * 64 + row * 16 + col])
		}
		return desPermute(out, desP, 32)
	}

	def desCrypt(subkeys uint64[], block uint64, decrypt bool) uint64 {
		let b = desPermute(block, desIP, 64)
		let l = b >> uint64(32)
		let r = b & uint64(0xffffffff)
		for let i = 0; i < 16; i++ {
			let k = decrypt ?? (subkeys[15 - i], subkeys[i])
			let next = l ^ desRound(r, k)
			l = r
			r = next
		}
		return desPermute((r << uint64(32)) | l, desFP, 64)
	}

	const desIP = int[
		58, 50, 42, 34, 26, 18, 10, 2, 60, 52, 44, 36, 28, 20, 12, 4,
		62, 54, 46, 38, 30, 22, 14, 6, 64, 56, 48, 40, 32, 24, 16, 8,
		57, 49, 41, 33, 25, 17, 9, 1, 59, 51, 43, 35, 27, 19, 11, 3,
		61, 53, 45, 37, 29, 21, 13, 5, 63, 55, 47, 39, 31, 23, 15, 7,
	]

	const desFP = int[
		40, 8, 48, 16, 56, 24, 64, 32, 39, 7, 47, 15, 55, 23, 63, 31,
		38, 6, 46, 14, 54, 22, 62, 30, 37, 5, 45, 13, 53, 21, 61, 29,
		36, 4, 44, 12, 52, 20, 60, 28, 35, 3, 43, 11, 51, 19, 59, 27,
		34, 2, 42, 10, 50, 18, 58, 26, 33, 1, 41, 9, 49, 17, 57, 25,
	]

	const desE = int[
		32, 1, 2, 3, 4, 5, 4, 5, 6, 7, 8, 9, 8, 9, 10, 11,
		12, 13, 12, 13, 14, 15, 16, 17, 16, 17, 18, 19, 20, 21, 20, 21,
		22, 23, 24, 25, 24, 25, 26, 27, 28, 29, 28, 29, 30, 31, 32, 1,
	]

	const desP = int[
		16, 7, 20, 21, 29, 12, 28, 17, 1, 15, 23, 26, 5, 18, 31, 10,
		2, 8, 24, 14, 32, 27, 3, 9, 19, 13, 30, 6, 22, 11, 4, 25,
