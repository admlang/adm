partial module std.crypto.cipher {
	use std.crypto::(constantTimeEqual)

	// newEAX wraps a 16-byte block cipher in EAX (Bellare, Rogaway and
	// Wagner; the EAX of OpenPGP, RFC 9580): CTR encryption and an OMAC
	// over nonce, associated data and ciphertext. The nonce is 16 bytes
	// unless nonceSize says otherwise (any positive length); the tag is 16
	// bytes, or tagSize between 8 and 16.
	// Fails when the block size is not 16, or a size is out of range.
	def newEAX(block Block, nonceSize int = 16, tagSize int = 16) !EAX {
		expects {
			assert block.blockSize() == 16 onerror fail "eax: requires a 128-bit block cipher"
			assert nonceSize > 0 onerror fail "eax: nonce size must be positive"
			assert tagSize >= 8 && tagSize <= 16 onerror fail "eax: tag size must be 8 to 16 bytes"
		}
		return new EAX(block, nonceSize, tagSize)
	}

	// EAX is EAX mode over a 128-bit block cipher. Implements AEAD.
	// Construct through newEAX.
	type EAX {
		internal block    Block
		internal nonceLen int
		internal tagLen   int

		def new(block Block, nonceSize int, tagSize int) {
			self.block = block
			nonceLen = nonceSize
			tagLen = tagSize
		}

		// nonceSize implements AEAD.
		def nonceSize() int {
			return nonceLen
		}

		// overhead implements AEAD: the tag length.
		def overhead() int {
			return tagLen
		}

		// seal implements AEAD: ciphertext followed by the tag. The nonce
		// must be nonceSize bytes and never repeat under this key.
		def seal(nonce, plaintext, additional byte[]) byte[] {
			let n = omac(0, nonce)
			let h = omac(1, additional)
			let body = eaxCounter(block, n, plaintext)
			let c = omac(2, body)
			let out = zeros(body.len() + tagLen)
			for let i = 0; i < body.len(); i++ {
				out[i] = body[i]
			}
			for let j = 0; j < tagLen; j++ {
				out[body.len() + j] = n[j] ^ h[j] ^ c[j]
			}
			return out
		}

		// open implements AEAD. Fails when the ciphertext is shorter than a
		// tag or the tag does not verify; nothing is decrypted then.
		def open(nonce, ciphertext, additional byte[]) !byte[] {
			expects {
				assert nonce.len() == nonceLen onerror fail "eax: wrong nonce length"
				assert ciphertext.len() >= tagLen onerror fail "eax: message authentication failed"
			}
			let size = ciphertext.len() - tagLen
			let body = ciphertext[0:size]
			let n = omac(0, nonce)
			let h = omac(1, additional)
			let c = omac(2, body)
			let tag = zeros(tagLen)
			for let j = 0; j < tagLen; j++ {
				tag[j] = n[j] ^ h[j] ^ c[j]
			}
			fail "eax: message authentication failed" unless constantTimeEqual(tag, ciphertext[size:])
			return eaxCounter(block, n, body)
		}

		// OMAC^t(data): CMAC over a block holding t, then the data.
		internal def omac(t int, data byte[]) byte[] {
			let input = zeros(16 + data.len())
			input[15] = byte(t)
			for let i = 0; i < data.len(); i++ {
				input[16 + i] = data[i]
			}
			return cmac(block, input)
		}
	}

	// CTR mode with the whole 128-bit block as the counter, from start.
	internal def eaxCounter(block Block, start byte[], data byte[]) byte[] {
		let counter = zeros(16)
		for let i = 0; i < 16; i++ {
			counter[i] = start[i]
		}
		let out = zeros(data.len())
		let stream = zeros(16)
		let at = 0
		for at < data.len() {
			block.encryptBlock(stream, counter)
			let take = data.len() - at < 16 ?? (data.len() - at, 16)
			for let j = 0; j < take; j++ {
				out[at + j] = data[at + j] ^ stream[j]
			}
			at += take
			let k = 15
			for k >= 0 {
				counter[k] = counter[k] + byte(1)
				break unless counter[k] == byte(0)
				k--
			}
		}
		return out
	}
}
