partial module std.crypto.cipher {
	use std.crypto::(constantTimeEqual)

	internal const gcmStandardNonceSize = 12

	// newGCM wraps a 16-byte block cipher in Galois/Counter Mode (NIST SP
	// 800-38D). The nonce is 12 bytes unless nonceSize says otherwise; the
	// tag is 16 bytes, or tagSize between 12 and 16.
	// Fails when the block size is not 16, the nonce size is not positive
	// or the tag size is out of range.
	def newGCM(block Block, nonceSize int = 12, tagSize int = 16) !GCM {
		expects {
			assert block.blockSize() == 16 onerror fail "gcm: requires a 128-bit block cipher"
			assert nonceSize > 0 onerror fail "gcm: nonce size must be positive"
			assert tagSize >= 12 && tagSize <= 16 onerror fail "gcm: tag size must be 12 to 16 bytes"
		}
		return new GCM(block, nonceSize, tagSize)
	}

	// GCM is Galois/Counter Mode over a 128-bit block cipher. Implements
	// AEAD. Construct through newGCM.
	type GCM {
		internal block    Block
		internal nonceLen int
		internal tagLen   int
		internal hHi      uint64
		internal hLo      uint64

		def new(block Block, nonceSize int, tagSize int) {
			self.block = block
			nonceLen = nonceSize
			tagLen = tagSize
			let h = zeros(16)
			block.encryptBlock(h, zeros(16))
			hHi = readUint64BE(h, 0)
			hLo = readUint64BE(h, 8)
		}

		// nonceSize implements AEAD.
		def nonceSize() int {
			return nonceLen
		}

		// overhead implements AEAD: the tag length.
		def overhead() int {
			return tagLen
		}

		// seal implements AEAD: ciphertext followed by the tag. The nonce
		// must be nonceSize bytes and never repeat under this key.
		def seal(nonce, plaintext, additional byte[]) byte[] {
			let counter = deriveCounter(nonce)
			let tagMask = zeros(16)
			block.encryptBlock(tagMask, counter)
			gcmIncrement(counter)
			let out = counterCrypt(counter, plaintext)
			let tag = authTag(additional, out, tagMask)
			return out + tag[0:tagLen]
		}

		// open implements AEAD. Fails when the ciphertext is shorter than a
		// tag or the tag does not verify; nothing is decrypted in that case.
		def open(nonce, ciphertext, additional byte[]) !byte[] {
			expects {
				assert nonce.len() == nonceLen onerror fail "gcm: wrong nonce length"
				assert ciphertext.len() >= tagLen onerror fail "gcm: message authentication failed"
			}
			let body = ciphertext[0:ciphertext.len() - tagLen]
			let tag = ciphertext[ciphertext.len() - tagLen:]
			let counter = deriveCounter(nonce)
			let tagMask = zeros(16)
			block.encryptBlock(tagMask, counter)
			gcmIncrement(counter)
			let expected = authTag(additional, body, tagMask)
			fail "gcm: message authentication failed" unless constantTimeEqual(expected[0:tagLen], tag)
			return counterCrypt(counter, body)
		}

		// deriveCounter is J0: the nonce with a 1 counter for the standard
		// size, GHASH of the padded nonce otherwise.
		internal def deriveCounter(nonce byte[]) byte[] {
			let j = zeros(16)
			if nonce.len() == gcmStandardNonceSize {
				nonce.copy(j)
				j[15] = 1
				return j
			}
			let g = new GHash(hHi, hLo)
			g.absorb(nonce)
			let lengths = zeros(16)
			writeUint64BE(lengths, 8, uint64(nonce.len()) * 8)
			g.absorbBlock(lengths, 0)
			g.write(j)
			return j
		}

		internal def counterCrypt(counter byte[], src byte[]) byte[] {
			let out byte[]
			out.len(src.len())
			let keystream = zeros(16)
			let off = 0
			for off < src.len() {
				block.encryptBlock(keystream, counter)
				gcmIncrement(counter)
				let n = src.len() - off
				n = 16 when n > 16
				for let i = 0; i < n; i++ {
					out[off + i] = src[off + i] ^ keystream[i]
				}
				off += n
			}
			return out
		}

		internal def authTag(additional, ciphertext, tagMask byte[]) byte[] {
			let g = new GHash(hHi, hLo)
			g.absorb(additional)
			g.absorb(ciphertext)
			let lengths = zeros(16)
			writeUint64BE(lengths, 0, uint64(additional.len()) * 8)
			writeUint64BE(lengths, 8, uint64(ciphertext.len()) * 8)
			g.absorbBlock(lengths, 0)
			let tag = zeros(16)
			g.write(tag)
			for let i = 0; i < 16; i++ {
				tag[i] ^= tagMask[i]
			}
			return tag
		}
	}

	// gcmIncrement adds one to the low 32 bits of the counter block.
	internal def gcmIncrement(counter byte[]) {
		let v = readUint32BE(counter, 12) + 1
		writeUint32BE(counter, 12, v)
	}

	// GHash is the universal hash of GCM: an accumulator in GF(2^128) with
	// the polynomial x^128 + x^7 + x^2 + x + 1, in the bit order of the spec.
	internal type GHash {
		internal hHi uint64
		internal hLo uint64
		internal yHi uint64
		internal yLo uint64

		def new(hHi, hLo uint64) {
			self.hHi = hHi
			self.hLo = hLo
			yHi = 0
			yLo = 0
		}

		// absorb feeds data, zero padded to whole blocks.
		def absorb(data byte[]) {
			let off = 0
			for off + 16 <= data.len() {
				absorbBlock(data, off)
				off += 16
			}
			if off < data.len() {
				let last = zeros(16)
				(data[off:]).copy(last)
				absorbBlock(last, 0)
			}
		}

		// absorbBlock XORs 16 bytes at off into the accumulator and
		// multiplies by H.
		def absorbBlock(data byte[], off int) {
			yHi ^= readUint64BE(data, off)
			yLo ^= readUint64BE(data, off + 8)
			multiply()
		}

		// write stores the accumulator into 16 bytes.
		def write(out byte[]) {
			writeUint64BE(out, 0, yHi)
			writeUint64BE(out, 8, yLo)
		}

		// multiply sets y = y * H, bit by bit.
		internal def multiply() {
			let zHi uint64 = 0
			let zLo uint64 = 0
			let vHi = hHi
			let vLo = hLo
			for let half = 0; half < 2; half++ {
				let x = half == 0 ?? (yHi, yLo)
				for let i = 63; i >= 0; i-- {
					let mask = uint64(0) - ((x >> i) & 1)
					zHi ^= vHi & mask
					zLo ^= vLo & mask
					let carry = uint64(0) - (vLo & 1)
					vLo = (vLo >> 1) | (vHi << 63)
					vHi = (vHi >> 1) ^ (carry & 0xe100000000000000)
				}
			}
			yHi = zHi
			yLo = zLo
		}
	}
}
