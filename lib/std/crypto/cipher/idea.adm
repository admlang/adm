partial module std.crypto.cipher {
	// newIDEA returns IDEA (Lai and Massey), the 64-bit block cipher of the
	// first OpenPGP messages, with a 16-byte key.
	// Fails on another key length.
	def newIDEA(key byte[]) !IDEA {
		expects {
			assert key.len() == 16 onerror fail "idea: the key is 16 bytes"
		}
		return new IDEA(key)
	}

	// IDEA implements Block. Construct through newIDEA.
	type IDEA {
		// The 52 encryption subkeys and the 52 decryption subkeys.
		internal ek int[]
		internal dk int[]

		def new(key byte[]) {
			ek = int[]
			ek.len(52)
			// The key read as 128 bits, each subkey the next 16; after eight,
			// the key rotates left by 25 bits.
			let words = int[]
			words.len(8)
			for let i = 0; i < 8; i++ {
				words[i] = (int(key[2 * i]) << 8) | int(key[2 * i + 1])
			}
			for let i = 0; i < 52; i++ {
				let block = i / 8
				let at = i % 8
				// Bit offset of this subkey in the key rotated 25 * block bits.
				let bit = (at * 16 + block * 25) % 128
				let w = bit / 16
				let shift = bit % 16
				let hi = words[w]
				let lo = words[(w + 1) % 8]
				ek[i] = shift == 0 ?? (hi, ((hi << shift) | (lo >> (16 - shift))) & 0xFFFF)
			}
			dk = int[]
			dk.len(52)
			// Decryption runs the rounds backwards with inverted subkeys: the
			// multiplications inverted, the additions negated, the middle
			// two additions swapped in every round but the output one.
			dk[0] = ideaInverse(ek[48])
			dk[1] = (65536 - ek[49]) & 0xFFFF
			dk[2] = (65536 - ek[50]) & 0xFFFF
			dk[3] = ideaInverse(ek[51])
			for let r = 1; r < 8; r++ {
				let from = 48 - 6 * r
				let to = 6 * r
				dk[to - 2] = ek[from + 4]
				dk[to - 1] = ek[from + 5]
				dk[to] = ideaInverse(ek[from])
				dk[to + 1] = (65536 - ek[from + 2]) & 0xFFFF
				dk[to + 2] = (65536 - ek[from + 1]) & 0xFFFF
				dk[to + 3] = ideaInverse(ek[from + 3])
			}
			dk[46] = ek[4]
			dk[47] = ek[5]
			dk[48] = ideaInverse(ek[0])
			dk[49] = (65536 - ek[1]) & 0xFFFF
			dk[50] = (65536 - ek[2]) & 0xFFFF
			dk[51] = ideaInverse(ek[3])
		}

		// blockSize implements Block: 8 bytes.
		def blockSize() int {
			return 8
		}

		// encryptBlock implements Block.
		def encryptBlock(dst, src byte[]) {
			ideaCrypt(dst, src, ek)
		}

		// decryptBlock implements Block.
		def decryptBlock(dst, src byte[]) {
			ideaCrypt(dst, src, dk)
		}
	}

	// Eight rounds and the output transformation with the given subkeys.
	internal def ideaCrypt(dst byte[], src byte[], k int[]) {
		let x1 = (int(src[0]) << 8) | int(src[1])
		let x2 = (int(src[2]) << 8) | int(src[3])
		let x3 = (int(src[4]) << 8) | int(src[5])
		let x4 = (int(src[6]) << 8) | int(src[7])
		for let r = 0; r < 8; r++ {
			let at = r * 6
			x1 = ideaMul(x1, k[at])
			x2 = (x2 + k[at + 1]) & 0xFFFF
			x3 = (x3 + k[at + 2]) & 0xFFFF
			x4 = ideaMul(x4, k[at + 3])
			let t0 = ideaMul(x1 ^ x3, k[at + 4])
			let t1 = ideaMul((t0 + (x2 ^ x4)) & 0xFFFF, k[at + 5])
			let t2 = (t0 + t1) & 0xFFFF
			x1 = x1 ^ t1
			x4 = x4 ^ t2
			let swap = x2 ^ t2
			x2 = x3 ^ t1
			x3 = swap
		}
		let y1 = ideaMul(x1, k[48])
		let y2 = (x3 + k[49]) & 0xFFFF
		let y3 = (x2 + k[50]) & 0xFFFF
		let y4 = ideaMul(x4, k[51])
		dst[0] = byte(y1 >> 8)
		dst[1] = byte(y1 & 0xFF)
		dst[2] = byte(y2 >> 8)
		dst[3] = byte(y2 & 0xFF)
		dst[4] = byte(y3 >> 8)
		dst[5] = byte(y3 & 0xFF)
		dst[6] = byte(y4 >> 8)
		dst[7] = byte(y4 & 0xFF)
	}

	// Multiplication modulo 65537, with 0 standing for 65536.
	internal def ideaMul(a int, b int) int {
		let x = a == 0 ?? (65536, a)
		let y = b == 0 ?? (65536, b)
		let r = (x * y) % 65537
		return r == 65536 ?? (0, r)
	}

	// The multiplicative inverse modulo 65537 (0 and 1 are their own).
	internal def ideaInverse(a int) int {
		return a when a <= 1
		// a^(65537 - 2) by squaring.
		let result = 1
		let base = a
		let e = 65535
		for e > 0 {
			result = (result * base) % 65537 when e & 1 == 1
			base = (base * base) % 65537
			e = e >> 1
		}
		return result
	}
}
