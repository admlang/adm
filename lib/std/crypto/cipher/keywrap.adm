partial module std.crypto.cipher {
	use std.crypto::(constantTimeEqual)

	// wrapKey encrypts key material under a key-encryption key with the AES
	// Key Wrap of RFC 3394, or with `padded` the variant of RFC 5649 that
	// takes any length; the result is 8 bytes longer than the key (padded:
	// than the key rounded up to 8 bytes). The wrap is deterministic and
	// authenticates the key, so it needs no nonce.
	//
	// ```
	// let kek = try cipher.newAES(kekBytes)
	// let wrapped = try cipher.wrapKey(kek, contentKey)
	// ```
	//
	// Fails when the block cipher's blocks are not 16 bytes, or the key is
	// shorter than 16 bytes or not a multiple of 8 (padded: empty, or longer
	// than 2^32 - 1 bytes).
	def wrapKey(kek Block, key byte[], padded bool = false) !byte[] {
		expects {
			assert kek.blockSize() == 16 onerror fail "keywrap: needs a 16-byte block cipher"
			assert padded || (key.len() >= 16 && key.len() % 8 == 0) onerror fail "keywrap: key must be at least 16 bytes and a multiple of 8"
			assert !padded || (key.len() > 0 && key.len() <= 0xFFFFFFFF) onerror fail "keywrap: key must be 1 to 2^32 - 1 bytes"
		}
		return keyWrap(kek, keyWrapIV, key) unless padded
		let iv = byte[0xA6, 0x59, 0x59, 0xA6] + uint32Bytes(uint32(key.len()))
		let data = key + zeros((8 - key.len() % 8) % 8)
		if data.len() == 8 {
			// One block: a single AES encryption of the IV and the key.
			let out = zeros(16)
			kek.encryptBlock(out, iv + data)
			return out
		}
		return keyWrap(kek, iv, data)
	}

	// unwrapKey recovers key material wrapped by wrapKey under the same
	// key-encryption key and the same `padded` choice. Fails, with the same
	// message whatever the cause, when the integrity check does not hold (the
	// wrong key, or the input was altered), and when the input has a length
	// no wrap produces.
	def unwrapKey(kek Block, wrapped byte[], padded bool = false) !byte[] {
		expects {
			assert kek.blockSize() == 16 onerror fail "keywrap: needs a 16-byte block cipher"
		}
		fail "keywrap: integrity check failed" when wrapped.len() < 16 || wrapped.len() % 8 != 0
		let iv byte[]
		let data byte[]
		if padded && wrapped.len() == 16 {
			let block = zeros(16)
			kek.decryptBlock(block, wrapped)
			iv = block[0:8]
			data = block[8:16]
		} else {
			fail "keywrap: integrity check failed" when !padded && wrapped.len() < 24
			(iv, data) = keyUnwrap(kek, wrapped)
		}
		if !padded {
			fail "keywrap: integrity check failed" unless constantTimeEqual(iv, keyWrapIV)
			return data
		}
		// RFC 5649 §3: the alternative IV, a length that fits the last
		// block, and zeros after it.
		let length = int(uint32(iv[4]) << 24 | uint32(iv[5]) << 16 | uint32(iv[6]) << 8 | uint32(iv[7]))
		let ok = constantTimeEqual(iv[0:4], byte[0xA6, 0x59, 0x59, 0xA6]) && length > data.len() - 8 && length <= data.len()
		fail "keywrap: integrity check failed" unless ok
		let pad byte = 0
		for let i = length; i < data.len(); i++ {
			pad |= data[i]
		}
		fail "keywrap: integrity check failed" unless pad == 0
		return data[0:length]
	}

	// The default initial value of RFC 3394 §2.2.3.1.
	internal const keyWrapIV = byte[0xA6, 0xA6, 0xA6, 0xA6, 0xA6, 0xA6, 0xA6, 0xA6]

	// keyWrap is the wrapping process W of RFC 3394 §2.2.1 in its indexed
	// form: six passes over the 64-bit blocks, the counter folded into A.
	internal def keyWrap(kek Block, iv, data byte[]) byte[] {
		let n = data.len() / 8
		let a = iv[0:8].clone()
		let r = data.clone()
		let input = zeros(16)
		let output = zeros(16)
		for let j = 0; j < 6; j++ {
			for let i = 0; i < n; i++ {
				for let k = 0; k < 8; k++ {
					input[k] = a[k]
					input[8 + k] = r[i * 8 + k]
				}
				kek.encryptBlock(output, input)
				let t = uint64(n * j + i + 1)
				for let k = 0; k < 8; k++ {
					a[k] = output[k] ^ byte((t >> uint64(56 - 8 * k)) & 0xFF)
					r[i * 8 + k] = output[8 + k]
				}
			}
		}
		return a + r
	}

	// keyUnwrap is the unwrapping process W^-1 of RFC 3394 §2.2.2: the
	// recovered initial value and the data, for the caller to check.
	internal def keyUnwrap(kek Block, wrapped byte[]) (byte[], byte[]) {
		let n = wrapped.len() / 8 - 1
		let a = wrapped[0:8].clone()
		let r = wrapped[8:wrapped.len()].clone()
		let input = zeros(16)
		let output = zeros(16)
		for let j = 5; j >= 0; j-- {
			for let i = n - 1; i >= 0; i-- {
				let t = uint64(n * j + i + 1)
				for let k = 0; k < 8; k++ {
					input[k] = a[k] ^ byte((t >> uint64(56 - 8 * k)) & 0xFF)
					input[8 + k] = r[i * 8 + k]
				}
				kek.decryptBlock(output, input)
				for let k = 0; k < 8; k++ {
					a[k] = output[k]
					r[i * 8 + k] = output[8 + k]
				}
			}
		}
		return (a, r)
	}

	internal def uint32Bytes(v uint32) byte[] {
		return byte[byte(v >> 24), byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF)]
	}
}
