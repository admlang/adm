partial module std.crypto.cipher {
	use (
		std.testing
		std.data.encoding::(hexdecode)
	)

	check "Key wrap" {
		@test()
		def TestKeyWrapRFC3394() !none {
			// RFC 3394 §4.1, §4.2 and §4.5.
			let cases = [
				["000102030405060708090A0B0C0D0E0F", "00112233445566778899AABBCCDDEEFF", "1FA68B0A8112B447AEF34BD8FB5A7B829D3E862371D2CFE5"],
				["000102030405060708090A0B0C0D0E0F1011121314151617", "00112233445566778899AABBCCDDEEFF", "96778B25AE6CA435F92B5B97C050AED2468AB8A17AD84E5D"],
				["000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F", "00112233445566778899AABBCCDDEEFF0001020304050607", "A8F9BC1612C68B3FF6E6F4FBE30E71E4769C8B80A32CB8958CD5D17D6B254DA1"]
			]
			for let c in cases {
				let kek = try newAES(try hexdecode(c[0]))
				let key = try hexdecode(c[1])
				let wrapped = try wrapKey(kek, key)
				assert wrapped.hex() == c[2]
				assert (try unwrapKey(kek, wrapped)).hex() == key.hex()
				// The key passed in is left as it was.
				assert key.hex() == c[1]
			}
		}

		@test()
		def TestKeyWrapRFC5649() !none {
			// RFC 5649 §6: a 20-byte key and a 7-byte key under one KEK.
			let kek = try newAES(try hexdecode("5840df6e29b02af1ab493b705bf16ea1ae8338f4dcc176a8"))
			let twenty = try hexdecode("c37b7e6492584340bed12207808941155068f738")
			let wrapped = try wrapKey(kek, twenty, padded = true)
			assert wrapped.hex() == "138BDEAA9B8FA7FC61F97742E72248EE5AE6AE5360D1AE6A5F54F373FA543B6A"
			assert (try unwrapKey(kek, wrapped, padded = true)).hex() == twenty.hex()
			let seven = try hexdecode("466f7250617369")
			let short = try wrapKey(kek, seven, padded = true)
			assert short.hex() == "AFBEB0F07DFBF5419200F2CCB50BB24F"
			assert (try unwrapKey(kek, short, padded = true)).hex() == seven.hex()
			// Every length from 1 to 40 bytes round-trips.
			for let n = 1; n <= 40; n++ {
				let key byte[]
				key.len(n)
				for let i = 0; i < n; i++ {
					key[i] = byte(i * 7 + n)
				}
				let w = try wrapKey(kek, key, padded = true)
				assert w.len() == (n + 7) / 8 * 8 + 8
				assert (try unwrapKey(kek, w, padded = true)).hex() == key.hex()
			}
		}

		@test()
		def TestKeyWrapRejects() !none {
			let kek = try newAES(try hexdecode("000102030405060708090A0B0C0D0E0F"))
			let wrapped = try hexdecode("1FA68B0A8112B447AEF34BD8FB5A7B829D3E862371D2CFE5")
			let other = try newAES(try hexdecode("0F0E0D0C0B0A09080706050403020100"))
			let tampered = wrapped.clone()
			tampered[10] ^= 1
			let rejected = [
				unwrapKey(other, wrapped) onerror recover [],
				unwrapKey(kek, tampered) onerror recover [],
				unwrapKey(kek, wrapped[0:16]) onerror recover [],
				unwrapKey(kek, wrapped[0:20]) onerror recover [],
				// A plain wrap does not unwrap as a padded one.
				unwrapKey(kek, wrapped, padded = true) onerror recover []
			]
			for let r in rejected {
				assert r.len() == 0
			}
			let badKeys = [
				wrapKey(kek, byte[1, 2, 3, 4, 5, 6, 7, 8]) onerror recover [],
				wrapKey(kek, (try hexdecode("00112233445566778899AABBCCDDEEFF")) + byte[1]) onerror recover [],
				wrapKey(kek, [], padded = true) onerror recover []
			]
			for let b in badKeys {
				assert b.len() == 0
			}
		}
	}
}
