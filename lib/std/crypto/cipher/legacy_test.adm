partial module std.crypto.cipher {
	use std.testing

	// One block each way.
	internal def blockRoundTrip(b Block, plain string, cipher string) bool {
		let out = zeros(b.blockSize())
		b.encryptBlock(out, unhex(plain))
		let back = zeros(b.blockSize())
		b.decryptBlock(back, unhex(cipher))
		return out.hex() == cipher && back.hex() == plain
	}

	check "Legacy block ciphers" {
		// RFC 2144 Appendix B.1: 128-, 80- and 40-bit keys.
		@test()
		def cast5MatchesRFC2144() !none {
			assert blockRoundTrip(try newCAST5(unhex("0123456712345678234567893456789A")), "0123456789ABCDEF", "238B4FE5847E44B2")
			assert blockRoundTrip(try newCAST5(unhex("01234567123456782345")), "0123456789ABCDEF", "EB6A711A2C02271B")
			assert blockRoundTrip(try newCAST5(unhex("0123456712")), "0123456789ABCDEF", "7AC816D16E9B302E")
			assert newCAST5(zeros(4)) is error
			return none
		}

		// The Twofish paper's known answers for each key length.
		@test()
		def twofishMatchesThePaper() !none {
			assert blockRoundTrip(try newTwofish(zeros(16)), "00000000000000000000000000000000", "9F589F5CF6122C32B6BFEC2F2AE8C35A")
			assert blockRoundTrip(try newTwofish(unhex("9F589F5CF6122C32B6BFEC2F2AE8C35A")), "D491DB16E7B1C39E86CB086B789F5419", "019F9809DE1711858FAAC3A3BA20FBC3")
			assert blockRoundTrip(try newTwofish(unhex("0123456789ABCDEFFEDCBA98765432100011223344556677")), "00000000000000000000000000000000", "CFD1D2E5A9BE9CDF501F13B892BD2248")
			assert blockRoundTrip(try newTwofish(unhex("88B2B2706B105E36B446BB6D731A1E88EFA71F788965BD44")), "39DA69D6BA4997D585B6DC073CA341B2", "182B02D81497EA45F9DAACDC29193A65")
			assert blockRoundTrip(try newTwofish(unhex("0123456789ABCDEFFEDCBA987654321000112233445566778899AABBCCDDEEFF")), "00000000000000000000000000000000", "37527BE0052334B89F0CFCCAE87CFA20")
			assert blockRoundTrip(try newTwofish(unhex("D43BB7556EA32E46F2A282B7D45B4E0D57FF739D4DC92C1BD7FC01700CC8216F")), "90AFE91BB288544F2C32DC239B2635E6", "6CB4561C40BF0A9705931CB6D408E7FA")
			assert newTwofish(zeros(20)) is error
			return none
		}

		// The IDEA paper's example.
		@test()
		def ideaMatchesThePaper() !none {
			assert blockRoundTrip(try newIDEA(unhex("00010002000300040005000600070008")), "0000000100020003", "11FBED2B01986DE5")
			let random = try newIDEA(unhex("2BD6459F82C5B300952C49104881FF48"))
			let block = zeros(8)
			random.encryptBlock(block, unhex("0123456789ABCDEF"))
			let back = zeros(8)
			random.decryptBlock(back, block)
			assert back.hex() == "0123456789ABCDEF"
			assert newIDEA(zeros(8)) is error
			return none
		}
	}
}
