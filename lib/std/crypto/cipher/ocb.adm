partial module std.crypto.cipher {
	use (
		std.simd
		std.crypto::(constantTimeEqual)
	)

	// newOCB wraps a 16-byte block cipher in OCB (RFC 7253, the OCB3
	// authenticated encryption OpenPGP uses). The nonce is 15 bytes unless
	// nonceSize says otherwise (1 to 15); the tag is 16 bytes, or tagSize
	// between 8 and 16.
	// Fails when the block size is not 16, or a size is out of range.
	def newOCB(block Block, nonceSize int = 15, tagSize int = 16) !OCB {
		expects {
			assert block.blockSize() == 16 onerror fail "ocb: requires a 128-bit block cipher"
			assert nonceSize >= 1 && nonceSize <= 15 onerror fail "ocb: nonce size must be 1 to 15 bytes"
			assert tagSize >= 8 && tagSize <= 16 onerror fail "ocb: tag size must be 8 to 16 bytes"
		}
		return new OCB(block, nonceSize, tagSize)
	}

	// OCB is OCB3 over a 128-bit block cipher. Implements AEAD. Construct
	// through newOCB.
	type OCB {
		internal block    Block
		internal nonceLen int
		internal tagLen   int
		// L_*, L_$ and L_0, L_1, ... (each doubling the one before), 16
		// bytes each, kept in one array: L_i at (i + 2) * 16.
		internal ls       byte[]

		def new(block Block, nonceSize int, tagSize int) {
			self.block = block
			nonceLen = nonceSize
			tagLen = tagSize
			ls = zeros(16 * 34)
			let star = zeros(16)
			block.encryptBlock(star, zeros(16))
			for let i = 0; i < 16; i++ {
				ls[i] = star[i]
			}
			for let k = 1; k < 34; k++ {
				ocbDouble(ls, k * 16, (k - 1) * 16)
			}
		}

		// nonceSize implements AEAD.
		def nonceSize() int {
			return nonceLen
		}

		// overhead implements AEAD: the tag length.
		def overhead() int {
			return tagLen
		}

		// seal implements AEAD: ciphertext followed by the tag. The nonce
		// must be nonceSize bytes and never repeat under this key.
		def seal(nonce, plaintext, additional byte[]) byte[] {
			let offset = initialOffset(nonce)
			let checksum = zeros(16)
			let n = plaintext.len()
			let out = zeros(n + tagLen)
			let full = n / 16
			let tmp = zeros(16)
			for let i = 1; i <= full; i++ {
				let at = (i - 1) * 16
				ocbXor(offset, 0, offset, 0, ls, (ocbNtz(i) + 2) * 16)
				ocbXor(checksum, 0, checksum, 0, plaintext, at)
				ocbXor(tmp, 0, plaintext, at, offset, 0)
				block.encryptBlock(tmp, tmp)
				ocbXor(out, at, tmp, 0, offset, 0)
			}
			let rest = n - full * 16
			if rest > 0 {
				ocbXor(offset, 0, offset, 0, ls, 0)
				let pad = zeros(16)
				block.encryptBlock(pad, offset)
				for let j = 0; j < rest; j++ {
					let p = plaintext[full * 16 + j]
					out[full * 16 + j] = p ^ pad[j]
					checksum[j] = checksum[j] ^ p
				}
				checksum[rest] = checksum[rest] ^ byte(0x80)
			}
			let tag = finalTag(checksum, offset, additional)
			for let j = 0; j < tagLen; j++ {
				out[n + j] = tag[j]
			}
			return out
		}

		// open implements AEAD. Fails when the ciphertext is shorter than a
		// tag or the tag does not verify; nothing is returned then.
		def open(nonce, ciphertext, additional byte[]) !byte[] {
			expects {
				assert nonce.len() == nonceLen onerror fail "ocb: wrong nonce length"
				assert ciphertext.len() >= tagLen onerror fail "ocb: message authentication failed"
			}
			let n = ciphertext.len() - tagLen
			let offset = initialOffset(nonce)
			let checksum = zeros(16)
			let out = zeros(n)
			let full = n / 16
			let tmp = zeros(16)
			for let i = 1; i <= full; i++ {
				let at = (i - 1) * 16
				ocbXor(offset, 0, offset, 0, ls, (ocbNtz(i) + 2) * 16)
				ocbXor(tmp, 0, ciphertext, at, offset, 0)
				block.decryptBlock(tmp, tmp)
				ocbXor(out, at, tmp, 0, offset, 0)
				ocbXor(checksum, 0, checksum, 0, out, at)
			}
			let rest = n - full * 16
			if rest > 0 {
				ocbXor(offset, 0, offset, 0, ls, 0)
				let pad = zeros(16)
				block.encryptBlock(pad, offset)
				for let j = 0; j < rest; j++ {
					let p = ciphertext[full * 16 + j] ^ pad[j]
					out[full * 16 + j] = p
					checksum[j] = checksum[j] ^ p
				}
				checksum[rest] = checksum[rest] ^ byte(0x80)
			}
			let tag = finalTag(checksum, offset, additional)
			fail "ocb: message authentication failed" unless constantTimeEqual(tag[0:tagLen], ciphertext[n:])
			return out
		}

		// Offset_0 from the nonce: the nonce block (tag length, padding, a
		// 1 bit, the nonce) enciphered without its last six bits, stretched,
		// and shifted left by those six bits.
		internal def initialOffset(nonce byte[]) byte[] {
			let nb = zeros(16)
			for let j = 0; j < nonce.len(); j++ {
				nb[16 - nonce.len() + j] = nonce[j]
			}
			nb[15 - nonce.len()] = nb[15 - nonce.len()] | byte(1)
			nb[0] = nb[0] | byte(((tagLen * 8) % 128) << 1)
			let bottom = int(nb[15]) & 63
			nb[15] = nb[15] & byte(0xC0)
			let ktop = zeros(16)
			block.encryptBlock(ktop, nb)
			let stretch = zeros(25)
			for let j = 0; j < 16; j++ {
				stretch[j] = ktop[j]
			}
			for let j = 0; j < 8; j++ {
				stretch[16 + j] = ktop[j] ^ ktop[j + 1]
			}
			let shift = bottom / 8
			let bits = bottom % 8
			let offset = zeros(16)
			for let j = 0; j < 16; j++ {
				let hi = int(stretch[j + shift])
				let lo = int(stretch[j + shift + 1])
				offset[j] = bits == 0 ?? (byte(hi), byte(((hi << bits) | (lo >> (8 - bits))) & 0xFF))
			}
			return offset
		}

		// ENCIPHER(Checksum xor Offset xor L_$) xor HASH(A).
		internal def finalTag(checksum byte[], offset byte[], additional byte[]) byte[] {
			let tag = zeros(16)
			ocbXor(tag, 0, checksum, 0, offset, 0)
			ocbXor(tag, 0, tag, 0, ls, 16)
			block.encryptBlock(tag, tag)
			let sum = hash(additional)
			ocbXor(tag, 0, tag, 0, sum, 0)
			return tag
		}

		// HASH(K, A): the associated data, offset and enciphered block by
		// block, summed.
		internal def hash(additional byte[]) byte[] {
			let sum = zeros(16)
			let offset = zeros(16)
			let tmp = zeros(16)
			let full = additional.len() / 16
			for let i = 1; i <= full; i++ {
				ocbXor(offset, 0, offset, 0, ls, (ocbNtz(i) + 2) * 16)
				ocbXor(tmp, 0, additional, (i - 1) * 16, offset, 0)
				block.encryptBlock(tmp, tmp)
				ocbXor(sum, 0, sum, 0, tmp, 0)
			}
			let rest = additional.len() - full * 16
			if rest > 0 {
				ocbXor(offset, 0, offset, 0, ls, 0)
				let last = zeros(16)
				for let j = 0; j < rest; j++ {
					last[j] = additional[full * 16 + j]
				}
				last[rest] = byte(0x80)
				ocbXor(tmp, 0, last, 0, offset, 0)
				block.encryptBlock(tmp, tmp)
				ocbXor(sum, 0, sum, 0, tmp, 0)
			}
			return sum
		}
	}

	// The 16 bytes at dst[d:] become a[x:] xor b[y:].
	internal def ocbXor(dst byte[], d int, a byte[], x int, b byte[], y int) {
		simd.store16<byte>(dst, d, simd.load16<byte>(a, x) ^ simd.load16<byte>(b, y))
	}

	// The number of trailing zero bits of i (> 0).
	internal def ocbNtz(i int) int {
		let n = 0
		let v = i
		for v & 1 == 0 {
			v = v >> 1
			n++
		}
		return n
	}

	// Writes double(src) (a left shift in GF(2^128)) at ls[d:].
	internal def ocbDouble(ls byte[], d int, s int) {
		let carry = int(ls[s]) >> 7
		for let j = 0; j < 15; j++ {
			ls[d + j] = byte(((int(ls[s + j]) << 1) | (int(ls[s + j + 1]) >> 7)) & 0xFF)
		}
		ls[d + 15] = byte(((int(ls[s + 15]) << 1) & 0xFF) ^ (carry * 0x87))
	}
}
