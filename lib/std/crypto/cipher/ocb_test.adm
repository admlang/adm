partial module std.crypto.cipher {
	use std.testing

	// RFC 7253 Appendix A: (nonce, associated data, plaintext, ciphertext)
	// under the key 000102...0F, 128-bit tags.
	internal const ocbSamples = [
		("BBAA99887766554433221100", "", "", "785407BFFFC8AD9EDCC5520AC9111EE6"),
		("BBAA99887766554433221101", "0001020304050607", "0001020304050607", "6820B3657B6F615A5725BDA0D3B4EB3A257C9AF1F8F03009"),
		("BBAA99887766554433221102", "0001020304050607", "", "81017F8203F081277152FADE694A0A00"),
		("BBAA99887766554433221103", "", "0001020304050607", "45DD69F8F5AAE72414054CD1F35D82760B2CD00D2F99BFA9"),
		("BBAA99887766554433221104", "000102030405060708090A0B0C0D0E0F", "000102030405060708090A0B0C0D0E0F", "571D535B60B277188BE5147170A9A22C3AD7A4FF3835B8C5701C1CCEC8FC3358"),
		("BBAA99887766554433221105", "000102030405060708090A0B0C0D0E0F", "", "8CF761B6902EF764462AD86498CA6B97"),
		("BBAA99887766554433221106", "", "000102030405060708090A0B0C0D0E0F", "5CE88EC2E0692706A915C00AEB8B2396F40E1C743F52436BDF06D8FA1ECA343D"),
		("BBAA99887766554433221107", "000102030405060708090A0B0C0D0E0F1011121314151617", "000102030405060708090A0B0C0D0E0F1011121314151617", "1CA2207308C87C010756104D8840CE1952F09673A448A122C92C62241051F57356D7F3C90BB0E07F"),
		("BBAA99887766554433221108", "000102030405060708090A0B0C0D0E0F1011121314151617", "", "6DC225A071FC1B9F7C69F93B0F1E10DE"),
		("BBAA99887766554433221109", "", "000102030405060708090A0B0C0D0E0F1011121314151617", "221BD0DE7FA6FE993ECCD769460A0AF2D6CDED0C395B1C3CE725F32494B9F914D85C0B1EB38357FF"),
		("BBAA9988776655443322110A", "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F", "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F", "BD6F6C496201C69296C11EFD138A467ABD3C707924B964DEAFFC40319AF5A48540FBBA186C5553C68AD9F592A79A4240"),
		("BBAA9988776655443322110B", "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F", "", "FE80690BEE8A485D11F32965BC9D2A32"),
		("BBAA9988776655443322110C", "", "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F", "2942BFC773BDA23CABC6ACFD9BFD5835BD300F0973792EF46040C53F1432BCDFB5E1DDE3BC18A5F840B52E653444D5DF"),
		("BBAA9988776655443322110D", "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F2021222324252627", "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F2021222324252627", "D5CA91748410C1751FF8A2F618255B68A0A12E093FF454606E59F9C1D0DDC54B65E8628E568BAD7AED07BA06A4A69483A7035490C5769E60"),
		("BBAA9988776655443322110E", "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F2021222324252627", "", "C5CD9D1850C141E358649994EE701B68"),
		("BBAA9988776655443322110F", "", "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F2021222324252627", "4412923493C57D5DE0D700F753CCE0D1D2D95060122E9F15A5DDBFC5787E50B5CC55EE507BCB084E479AD363AC366B95A98CA5F3000B1479"),
	]

	// RFC 7253's iterated test for one key length and tag length.
	internal def ocbIterated(keyBytes int, tagBytes int) !string {
		let key = zeros(keyBytes)
		key[keyBytes - 1] = byte(tagBytes * 8)
		let ocb = try newOCB(try newAES(key), 12, tagBytes)
		let nonceOf = def (n int) byte[] {
			let b = zeros(12)
			b[10] = byte(n >> 8)
			b[11] = byte(n & 0xFF)
			return b
		}
		let c byte[] = []
		for let i = 0; i < 128; i++ {
			let s = zeros(i)
			c += ocb.seal(nonceOf(3 * i + 1), s, s)
			c += ocb.seal(nonceOf(3 * i + 2), s, [])
			c += ocb.seal(nonceOf(3 * i + 3), [], s)
		}
		return ocb.seal(nonceOf(385), [], c).hex()
	}

	check "OCB" {
		@test()
		def matchesRFC7253() !none {
			let key = unhex("000102030405060708090A0B0C0D0E0F")
			for let sample in ocbSamples {
				let (n, a, p, c) = sample
				let ocb = try newOCB(try newAES(key), 12)
				assert ocb.seal(unhex(n), unhex(p), unhex(a)).hex() == c
				assert (try ocb.open(unhex(n), unhex(c), unhex(a))).hex() == p
			}
			let short = try newOCB(try newAES(unhex("0F0E0D0C0B0A09080706050403020100")), 12, 12)
			let p = unhex("000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F2021222324252627")
			assert short.seal(unhex("BBAA9988776655443322110D"), p, p).hex() == "1792A4E31E0755FB03E31B22116E6C2DDF9EFD6E33D536F1A0124B0A55BAE884ED93481529C76B6AD0C515F4D1CDD4FDAC4F02AA"
			return none
		}

		@test()
		def passesTheIteratedTest() !none {
			assert (try ocbIterated(16, 16)) == "67E944D23256C5E0B6C61FA22FDF1EA2"
			assert (try ocbIterated(24, 16)) == "F673F2C3E7174AAE7BAE986CA9F29E17"
			assert (try ocbIterated(32, 16)) == "D90EB8E9C977C88B79DD793D7FFA161C"
			assert (try ocbIterated(16, 12)) == "77A3D8E73589158D25D01209"
			assert (try ocbIterated(24, 12)) == "05D56EAD2752C86BE6932C5E"
			assert (try ocbIterated(32, 12)) == "5458359AC23B0CBA9E6330DD"
			assert (try ocbIterated(16, 8)) == "192C9B7BD90BA06A"
			assert (try ocbIterated(24, 8)) == "0066BC6E0EF34E24"
			assert (try ocbIterated(32, 8)) == "7D4EA5D445501CBE"
			return none
		}

		@test()
		def refusesTampering() !none {
			let ocb = try newOCB(try newAES(zeros(16)))
			assert ocb.nonceSize() == 15 && ocb.overhead() == 16
			let sealed = ocb.seal(zeros(15), "attack at dawn".bytes(), "hdr".bytes())
			assert string(try ocb.open(zeros(15), sealed, "hdr".bytes())) == "attack at dawn"
			sealed[0] = sealed[0] ^ byte(1)
			assert ocb.open(zeros(15), sealed, "hdr".bytes()) is error
			assert newOCB(try newAES(zeros(16)), 16) is error
			return none
		}
	}

	check "EAX" {
		// RFC 9580's AEAD-EAX session key (A.9) and test vectors of the EAX
		// paper (Bellare, Rogaway, Wagner).
		@test()
		def matchesThePaper() !none {
			let vectors = [
				("3881BAFE985412459B86C36F98CB9A5E", "2FCE331F39DD955CC41E95D870C72139", "69224F919993B3506FA3B59A6A73CFF8", "C3060701", "C5EFC5F41C57FB54E1C226815D7828F5F92C454EB65EBE00AB5986C68E6E7C55"),
				("", "233952DEE4D5ED5F9B9C6D6FF80FF478", "62EC67F9C3A4A407FCB2A8C49031A8B3", "6BFB914FD07EAE6B", "E037830E8389F27B025A2D6527E79D01"),
				("F7FB", "91945D3F4DCBEE0BF45EF52255F095A4", "BECAF043B0A23D843194BA972C66DEBD", "FA3BFD4806EB53FA", "19DD5C4C9331049D0BDAB0277408F67967E5"),
			]
			for let v in vectors {
				let (msg, key, nonce, header, cipher) = v
				let eax = try newEAX(try newAES(unhex(key)))
				assert eax.seal(unhex(nonce), unhex(msg), unhex(header)).hex() == cipher
				assert (try eax.open(unhex(nonce), unhex(cipher), unhex(header))).hex() == msg
			}
			let eax = try newEAX(try newAES(zeros(16)))
			assert eax.nonceSize() == 16 && eax.overhead() == 16
			let sealed = eax.seal(zeros(16), "x".repeat(40).bytes(), [])
			sealed[3] = sealed[3] ^ byte(4)
			assert eax.open(zeros(16), sealed, []) is error
			return none
		}
	}
}
