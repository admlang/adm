partial module std.crypto.cipher {
	// rc4 encrypts or decrypts data with the RC4 stream cipher under a key of
	// 1 to 256 bytes. Applying it twice with the same key restores the input.
	// RC4 is broken; it is here to read formats that still use it, such as
	// older encrypted PDF files. Fails when the key length is out of range.
	def rc4(key byte[], data byte[]) !byte[] {
		expects {
			assert key.len() >= 1 && key.len() <= 256 onerror fail "rc4: key must be 1 to 256 bytes"
		}
		let state byte[]
		state.len(256)
		for let i = 0; i < 256; i++ {
			state[i] = byte(i)
		}
		let j = 0
		for let i = 0; i < 256; i++ {
			j = (j + int(state[i]) + int(key[i % key.len()])) & 0xff
			let t = state[i]
			state[i] = state[j]
			state[j] = t
		}
		let out byte[]
		out.len(data.len())
		let a = 0
		let b = 0
		for let k = 0; k < data.len(); k++ {
			a = (a + 1) & 0xff
			b = (b + int(state[a])) & 0xff
			let t = state[a]
			state[a] = state[b]
			state[b] = t
			out[k] = data[k] ^ state[(int(state[a]) + int(state[b])) & 0xff]
		}
		return out
	}
}
