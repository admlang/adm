partial module std.crypto.cipher {
	// SIV is AES-SIV (RFC 5297): authenticated encryption whose tag is also
	// the IV, so a repeated nonce leaks only that the same message was
	// sent again. The key is two AES keys, one for S2V (CMAC) and one for
	// CTR: 32, 48 or 64 bytes. As an AEAD it is AEAD_AES_SIV_CMAC_256/384/512
	// (the nonce is the last associated data string; RFC 5297 §6). NTS uses
	// it (RFC 8915).
	//
	// ```
	// let siv = try cipher.newSIV(key)                      // 32 bytes
	// let sealed = siv.seal(nonce, plaintext, associated)
	// let back = try siv.open(nonce, sealed, associated)
	// ```
	type SIV {
		internal mac  AES
		internal ctr  AES
		internal half int

		def new(mac AES, ctr AES, half int) {
			self.mac = mac
			self.ctr = ctr
			self.half = half
		}

		// Implements AEAD: any nonce length works; 16 is what RFC 8915 uses.
		def nonceSize() int {
			return 16
		}

		// Implements AEAD: the synthetic IV in front.
		def overhead() int {
			return 16
		}

		// Implements AEAD: `additional`, then the nonce when not empty, as
		// the associated data strings.
		def seal(nonce, plaintext, additional byte[]) byte[] {
			return sealWith(plaintext, nonce.len() == 0 ?? ([additional], [additional, nonce]))
		}

		// Implements AEAD. Fails when the data was changed or is shorter
		// than the tag.
		def open(nonce, ciphertext, additional byte[]) !byte[] {
			return try openWith(ciphertext, nonce.len() == 0 ?? ([additional], [additional, nonce]))
		}

		// The synthetic IV and the ciphertext of `plaintext` under any
		// number of associated data strings (RFC 5297 §2.6).
		def sealWith(plaintext byte[], associated byte[][]) byte[] {
			let v = s2v(associated, plaintext)
			return v + ctrCrypt(v, plaintext)
		}

		// The plaintext of `sealed` under the same associated data. Fails
		// when the data or the associated data was changed.
		def openWith(sealed byte[], associated byte[][]) !byte[] {
			fail "siv: message shorter than the tag" when sealed.len() < 16
			let v = sealed[:16].clone()
			let plain = ctrCrypt(v, sealed[16:])
			fail "siv: message authentication failed" unless constantTimeTagEqual(s2v(associated, plain), v)
			return plain
		}

		// S2V (RFC 5297 §2.4): CMAC chained over the strings, doubling
		// between them.
		internal def s2v(associated byte[][], plaintext byte[]) byte[] {
			let d = cmac(mac, zeros(16))
			for let a in associated {
				d = xorBlock(cmacDouble(d), cmac(mac, a))
			}
			if plaintext.len() >= 16 {
				let t = plaintext.clone()
				let at = t.len() - 16
				for let i = 0; i < 16; i++ {
					t[at + i] = t[at + i] ^ d[i]
				}
				return cmac(mac, t)
			}
			let padded = zeros(16)
			plaintext.copy(padded)
			padded[plaintext.len()] = byte(0x80)
			return cmac(mac, xorBlock(cmacDouble(d), padded))
		}

		// CTR from the IV with bits 63 and 31 cleared (§2.6).
		internal def ctrCrypt(v byte[], data byte[]) byte[] {
			let q = v.clone()
			q[8] = q[8] & byte(0x7f)
			q[12] = q[12] & byte(0x7f)
			// The IV is one block, so the counter always builds.
			return new CTR(ctr, q).encrypt(data)
		}
	}

	// newSIV makes AES-SIV from a 32, 48 or 64-byte key (MAC key first).
	// Fails for another length.
	def newSIV(key byte[]) !SIV {
		fail "siv: key must be 32, 48 or 64 bytes" unless key.len() := 32 || 48 || 64
		let half = key.len() / 2
		return new SIV(try newAES(key[:half]), try newAES(key[half:]), half)
	}

	internal def xorBlock(a byte[], b byte[]) byte[] {
		let out = zeros(a.len())
		for let i = 0; i < a.len(); i++ {
			out[i] = a[i] ^ b[i]
		}
		return out
	}

	internal def constantTimeTagEqual(a byte[], b byte[]) bool {
		return false when a.len() != b.len()
		let diff byte = 0
		for let i = 0; i < a.len(); i++ {
			diff |= a[i] ^ b[i]
		}
		return diff == 0
	}
}
