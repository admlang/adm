partial module std.crypto.cipher {
	use (
		std.data.encoding::(hexdecode)
		std.testing
	)

	check "AES-SIV" {
		@test()
		def matchesRfc5297() !none {
			// A.1: deterministic, one associated data string.
			let a1 = try newSIV(try hexdecode("fffefdfcfbfaf9f8f7f6f5f4f3f2f1f0f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"))
			let ad1 = try hexdecode("101112131415161718191a1b1c1d1e1f2021222324252627")
			let p1 = try hexdecode("112233445566778899aabbccddee")
			let c1 = a1.sealWith(p1, [ad1])
			assert c1.hex() == "85632D07C6E8F37F950ACD320A2ECC9340C02B9690C4DC04DAEF7F6AFE5C"
			assert (try a1.openWith(c1, [ad1])).hex() == p1.hex()
			// A.2: two associated data strings and a nonce.
			let a2 = try newSIV(try hexdecode("7f7e7d7c7b7a79787776757473727170404142434445464748494a4b4c4d4e4f"))
			let ads = [try hexdecode("00112233445566778899aabbccddeeffdeaddadadeaddadaffeeddccbbaa99887766554433221100"), try hexdecode("102030405060708090a0"), try hexdecode("09f911029d74e35bd84156c5635688c0")]
			let p2 = try hexdecode("7468697320697320736f6d6520706c61696e7465787420746f20656e6372797074207573696e67205349562d414553")
			let c2 = a2.sealWith(p2, ads)
			assert c2.hex() == "7BDB6E3B432667EB06F4D14BFF2FBD0FCB900F2FDDBE404326601965C889BF17DBA77CEB094FA663B7A3F748BA8AF829EA64AD544A272E9C485B62A3FD5C0D"
			// As an AEAD, and tampering refused.
			let sealed = a2.seal(ads[2], p2, ads[0])
			assert (try a2.open(ads[2], sealed, ads[0])).hex() == p2.hex()
			sealed[20] = sealed[20] ^ byte(1)
			let refused = false
			a2.open(ads[2], sealed, ads[0]) onerror (err error) {
				refused = true
				recover byte[]
			}
			assert refused
			return none
		}
	}
}
