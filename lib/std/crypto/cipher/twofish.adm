partial module std.crypto.cipher {
	// newTwofish returns Twofish (Schneier et al.), a 128-bit block cipher
	// of OpenPGP, with a 16-, 24- or 32-byte key.
	// Fails on another key length.
	def newTwofish(key byte[]) !Twofish {
		expects {
			assert key.len() := 16 || 24 || 32 onerror fail "twofish: the key is 16, 24 or 32 bytes"
		}
		return new Twofish(key)
	}

	// Twofish implements Block. Construct through newTwofish.
	type Twofish {
		// The key-dependent S-boxes folded with the MDS matrix, four tables of
		// 256 words.
		internal s uint32[]
		// The 40 round subkeys: whitening and the 16 rounds.
		internal k uint32[]

		def new(key byte[]) {
			let words = key.len() / 8
			// S = RS · key, four bytes per 64-bit key word.
			let sv = zeros(16)
			for let i = 0; i < words; i++ {
				for let j = 0; j < 4; j++ {
					let acc = 0
					for let c = 0; c < 8; c++ {
						acc = acc ^ twofishMul(int(key[8 * i + c]), int(twofishRS[j * 8 + c]), 0x14D)
					}
					sv[4 * i + j] = byte(acc)
				}
			}
			k = uint32[]
			k.len(40)
			let tmp = zeros(4)
			for let i = 0; i < 20; i++ {
				for let j = 0; j < 4; j++ {
					tmp[j] = byte(2 * i)
				}
				let a = twofishH(tmp, key, 0)
				for let j = 0; j < 4; j++ {
					tmp[j] = byte(2 * i + 1)
				}
				let b = rotl32(twofishH(tmp, key, 1), 8)
				k[2 * i] = a + b
				k[2 * i + 1] = rotl32(a + b + b, 9)
			}
			s = uint32[]
			s.len(1024)
			// The S-boxes are h() keyed by the S vector, whose words stand in
			// the opposite order to the key's: S0 is the last key word's place.
			let keyed = zeros(8 * words)
			for let m = 0; m < words; m++ {
				for let j = 0; j < 4; j++ {
					keyed[8 * m + j] = sv[4 * (words - 1 - m) + j]
				}
			}
			let input = zeros(4)
			for let i = 0; i < 256; i++ {
				for let j = 0; j < 4; j++ {
					input[j] = byte(i)
				}
				let y = twofishQChain(input, keyed, 0)
				for let col = 0; col < 4; col++ {
					s[col * 256 + i] = twofishMDSColumn(y[col], col)
				}
			}
		}

		// blockSize implements Block: 16 bytes.
		def blockSize() int {
			return 16
		}

		internal def g0(x uint32) uint32 {
			return s[int(x & uint32(255))] ^ s[256 + int((x >> 8) & uint32(255))] ^ s[512 + int((x >> 16) & uint32(255))] ^ s[768 + int(x >> 24)]
		}

		// The second g input is the word rotated left by 8 bits.
		internal def g1(x uint32) uint32 {
			return s[256 + int(x & uint32(255))] ^ s[512 + int((x >> 8) & uint32(255))] ^ s[768 + int((x >> 16) & uint32(255))] ^ s[int(x >> 24)]
		}

		// encryptBlock implements Block.
		def encryptBlock(dst, src byte[]) {
			let a = readUint32LE(src, 0) ^ k[0]
			let b = readUint32LE(src, 4) ^ k[1]
			let c = readUint32LE(src, 8) ^ k[2]
			let d = readUint32LE(src, 12) ^ k[3]
			for let i = 0; i < 8; i++ {
				let base = 8 + i * 4
				let t2 = g1(b)
				let t1 = g0(a) + t2
				c = rotl32(c ^ (t1 + k[base]), 31)
				d = rotl32(d, 1) ^ (t2 + t1 + k[base + 1])
				t2 = g1(d)
				t1 = g0(c) + t2
				a = rotl32(a ^ (t1 + k[base + 2]), 31)
				b = rotl32(b, 1) ^ (t2 + t1 + k[base + 3])
			}
			writeUint32LE(dst, 0, c ^ k[4])
			writeUint32LE(dst, 4, d ^ k[5])
			writeUint32LE(dst, 8, a ^ k[6])
			writeUint32LE(dst, 12, b ^ k[7])
		}

		// decryptBlock implements Block.
		def decryptBlock(dst, src byte[]) {
			let c = readUint32LE(src, 0) ^ k[4]
			let d = readUint32LE(src, 4) ^ k[5]
			let a = readUint32LE(src, 8) ^ k[6]
			let b = readUint32LE(src, 12) ^ k[7]
			for let i = 8; i > 0; i-- {
				let base = 4 + i * 4
				let t2 = g1(d)
				let t1 = g0(c) + t2
				a = rotl32(a, 1) ^ (t1 + k[base + 2])
				b = rotl32(b ^ (t2 + t1 + k[base + 3]), 31)
				t2 = g1(b)
				t1 = g0(a) + t2
				c = rotl32(c, 1) ^ (t1 + k[base])
				d = rotl32(d ^ (t2 + t1 + k[base + 1]), 31)
			}
			writeUint32LE(dst, 0, a ^ k[0])
			writeUint32LE(dst, 4, b ^ k[1])
			writeUint32LE(dst, 8, c ^ k[2])
			writeUint32LE(dst, 12, d ^ k[3])
		}
	}

	// Multiplication in GF(2^8) modulo the polynomial p.
	internal def twofishMul(a int, b int, p int) int {
		let result = 0
		let x = a
		let y = b
		for let i = 0; i < 8; i++ {
			result = result ^ y when x & 1 == 1
			x = x >> 1
			y = y << 1
			y = y ^ p when y & 0x100 != 0
		}
		return result & 0xFF
	}

	// Column col of the MDS matrix times a byte, as a little-endian word.
	internal def twofishMDSColumn(v int, col int) uint32 {
		let m1 = uint32(v)
		let m5b = uint32(twofishMul(v, 0x5B, 0x169))
		let mef = uint32(twofishMul(v, 0xEF, 0x169))
		switch col {
			case 0:
				return m1 | (m5b << 8) | (mef << 16) | (mef << 24)
			case 1:
				return mef | (mef << 8) | (m5b << 16) | (m1 << 24)
			case 2:
				return m5b | (mef << 8) | (m1 << 16) | (mef << 24)
			default:
				return m5b | (m1 << 8) | (mef << 16) | (m5b << 24)
		}
	}

	// h(X, L) of the key schedule: X through the q permutations keyed by
	// the even (offset 0) or odd (offset 1) key words, then the MDS matrix.
	internal def twofishH(input byte[], key byte[], offset int) uint32 {
		let y = twofishQChain(input, key, offset)
		return twofishMDSColumn(y[0], 0) ^ twofishMDSColumn(y[1], 1) ^ twofishMDSColumn(y[2], 2) ^ twofishMDSColumn(y[3], 3)
	}

	// The q permutations of h(), each stage keyed by a key word (the words
	// at 4 * (2m + offset)), before the MDS matrix.
	internal def twofishQChain(input byte[], key byte[], offset int) int[] {
		let y = [int(input[0]), int(input[1]), int(input[2]), int(input[3])]
		let q0 = twofishQ0
		let q1 = twofishQ1
		let words = key.len() / 8
		if words == 4 {
			y[0] = int(q1[y[0]]) ^ int(key[4 * (6 + offset)])
			y[1] = int(q0[y[1]]) ^ int(key[4 * (6 + offset) + 1])
			y[2] = int(q0[y[2]]) ^ int(key[4 * (6 + offset) + 2])
			y[3] = int(q1[y[3]]) ^ int(key[4 * (6 + offset) + 3])
		}
		if words >= 3 {
			y[0] = int(q1[y[0]]) ^ int(key[4 * (4 + offset)])
			y[1] = int(q1[y[1]]) ^ int(key[4 * (4 + offset) + 1])
			y[2] = int(q0[y[2]]) ^ int(key[4 * (4 + offset) + 2])
			y[3] = int(q0[y[3]]) ^ int(key[4 * (4 + offset) + 3])
		}
		y[0] = int(q1[int(q0[int(q0[y[0]]) ^ int(key[4 * (2 + offset)])]) ^ int(key[4 * offset])])
		y[1] = int(q0[int(q0[int(q1[y[1]]) ^ int(key[4 * (2 + offset) + 1])]) ^ int(key[4 * offset + 1])])
		y[2] = int(q1[int(q1[int(q0[y[2]]) ^ int(key[4 * (2 + offset) + 2])]) ^ int(key[4 * offset + 2])])
		y[3] = int(q0[int(q1[int(q1[y[3]]) ^ int(key[4 * (2 + offset) + 3])]) ^ int(key[4 * offset + 3])])
		return y
	}

	// The RS matrix of the key schedule, row by row.
	internal const twofishRS = byte[
		0x01, 0xA4, 0x55, 0x87, 0x5A, 0x58, 0xDB, 0x9E,
		0xA4, 0x56, 0x82, 0xF3, 0x1E, 0xC6, 0x68, 0xE5,
		0x02, 0xA1, 0xFC, 0xC1, 0x47, 0xAE, 0x3D, 0x19,
		0xA4, 0x55, 0x87, 0x5A, 0x58, 0xDB, 0x9E, 0x03,
	]

	// The fixed permutations q0 and q1.
	internal const twofishQ0 = byte[
		0xa9, 0x67, 0xb3, 0xe8, 0x04, 0xfd, 0xa3, 0x76, 0x9a, 0x92, 0x80, 0x78, 0xe4, 0xdd, 0xd1, 0x38,
		0x0d, 0xc6, 0x35, 0x98, 0x18, 0xf7, 0xec, 0x6c, 0x43, 0x75, 0x37, 0x26, 0xfa, 0x13, 0x94, 0x48,
		0xf2, 0xd0, 0x8b, 0x30, 0x84, 0x54, 0xdf, 0x23, 0x19, 0x5b, 0x3d, 0x59, 0xf3, 0xae, 0xa2, 0x82,
		0x63, 0x01, 0x83, 0x2e, 0xd9, 0x51, 0x9b, 0x7c, 0xa6, 0xeb, 0xa5, 0xbe, 0x16, 0x0c, 0xe3, 0x61,
		0xc0, 0x8c, 0x3a, 0xf5, 0x73, 0x2c, 0x25, 0x0b, 0xbb, 0x4e, 0x89, 0x6b, 0x53, 0x6a, 0xb4, 0xf1,
		0xe1, 0xe6, 0xbd, 0x45, 0xe2, 0xf4, 0xb6, 0x66, 0xcc, 0x95, 0x03, 0x56, 0xd4, 0x1c, 0x1e, 0xd7,
		0xfb, 0xc3, 0x8e, 0xb5, 0xe9, 0xcf, 0xbf, 0xba, 0xea, 0x77, 0x39, 0xaf, 0x33, 0xc9, 0x62, 0x71,
		0x81, 0x79, 0x09, 0xad, 0x24, 0xcd, 0xf9, 0xd8, 0xe5, 0xc5, 0xb9, 0x4d, 0x44, 0x08, 0x86, 0xe7,
		0xa1, 0x1d, 0xaa, 0xed, 0x06, 0x70, 0xb2, 0xd2, 0x41, 0x7b, 0xa0, 0x11, 0x31, 0xc2, 0x27, 0x90,
		0x20, 0xf6, 0x60, 0xff, 0x96, 0x5c, 0xb1, 0xab, 0x9e, 0x9c, 0x52, 0x1b, 0x5f, 0x93, 0x0a, 0xef,
		0x91, 0x85, 0x49, 0xee, 0x2d, 0x4f, 0x8f, 0x3b, 0x47, 0x87, 0x6d, 0x46, 0xd6, 0x3e, 0x69, 0x64,
		0x2a, 0xce, 0xcb, 0x2f, 0xfc, 0x97, 0x05, 0x7a, 0xac, 0x7f, 0xd5, 0x1a, 0x4b, 0x0e, 0xa7, 0x5a,
		0x28, 0x14, 0x3f, 0x29, 0x88, 0x3c, 0x4c, 0x02, 0xb8, 0xda, 0xb0, 0x17, 0x55, 0x1f, 0x8a, 0x7d,
		0x57, 0xc7, 0x8d, 0x74, 0xb7, 0xc4, 0x9f, 0x72, 0x7e, 0x15, 0x22, 0x12, 0x58, 0x07, 0x99, 0x34,
		0x6e, 0x50, 0xde, 0x68, 0x65, 0xbc, 0xdb, 0xf8, 0xc8, 0xa8, 0x2b, 0x40, 0xdc, 0xfe, 0x32, 0xa4,
		0xca, 0x10, 0x21, 0xf0, 0xd3, 0x5d, 0x0f, 0x00, 0x6f, 0x9d, 0x36, 0x42, 0x4a, 0x5e, 0xc1, 0xe0,
	]

	internal const twofishQ1 = byte[
		0x75, 0xf3, 0xc6, 0xf4, 0xdb, 0x7b, 0xfb, 0xc8, 0x4a, 0xd3, 0xe6, 0x6b, 0x45, 0x7d, 0xe8, 0x4b,
		0xd6, 0x32, 0xd8, 0xfd, 0x37, 0x71, 0xf1, 0xe1, 0x30, 0x0f, 0xf8, 0x1b, 0x87, 0xfa, 0x06, 0x3f,
		0x5e, 0xba, 0xae, 0x5b, 0x8a, 0x00, 0xbc, 0x9d, 0x6d, 0xc1, 0xb1, 0x0e, 0x80, 0x5d, 0xd2, 0xd5,
		0xa0, 0x84, 0x07, 0x14, 0xb5, 0x90, 0x2c, 0xa3, 0xb2, 0x73, 0x4c, 0x54, 0x92, 0x74, 0x36, 0x51,
		0x38, 0xb0, 0xbd, 0x5a, 0xfc, 0x60, 0x62, 0x96, 0x6c, 0x42, 0xf7, 0x10, 0x7c, 0x28, 0x27, 0x8c,
		0x13, 0x95, 0x9c, 0xc7, 0x24, 0x46, 0x3b, 0x70, 0xca, 0xe3, 0x85, 0xcb, 0x11, 0xd0, 0x93, 0xb8,
		0xa6, 0x83, 0x20, 0xff, 0x9f, 0x77, 0xc3, 0xcc, 0x03, 0x6f, 0x08, 0xbf, 0x40, 0xe7, 0x2b, 0xe2,
		0x79, 0x0c, 0xaa, 0x82, 0x41, 0x3a, 0xea, 0xb9, 0xe4, 0x9a, 0xa4, 0x97, 0x7e, 0xda, 0x7a, 0x17,
		0x66, 0x94, 0xa1, 0x1d, 0x3d, 0xf0, 0xde, 0xb3, 0x0b, 0x72, 0xa7, 0x1c, 0xef, 0xd1, 0x53, 0x3e,
		0x8f, 0x33, 0x26, 0x5f, 0xec, 0x76, 0x2a, 0x49, 0x81, 0x88, 0xee, 0x21, 0xc4, 0x1a, 0xeb, 0xd9,
		0xc5, 0x39, 0x99, 0xcd, 0xad, 0x31, 0x8b, 0x01, 0x18, 0x23, 0xdd, 0x1f, 0x4e, 0x2d, 0xf9, 0x48,
		0x4f, 0xf2, 0x65, 0x8e, 0x78, 0x5c, 0x58, 0x19, 0x8d, 0xe5, 0x98, 0x57, 0x67, 0x7f, 0x05, 0x64,
		0xaf, 0x63, 0xb6, 0xfe, 0xf5, 0xb7, 0x3c, 0xa5, 0xce, 0xe9, 0x68, 0x44, 0xe0, 0x4d, 0x43, 0x69,
		0x29, 0x2e, 0xac, 0x15, 0x59, 0xa8, 0x0a, 0x9e, 0x6e, 0x47, 0xdf, 0x34, 0x35, 0x6a, 0xcf, 0xdc,
		0x22, 0xc9, 0xc0, 0x9b, 0x89, 0xd4, 0xed, 0xab, 0x12, 0xa2, 0x0d, 0x52, 0xbb, 0x02, 0x2f, 0xa9,
		0xd7, 0x61, 0x1e, 0xb4, 0x50, 0x04, 0xf6, 0xc2, 0x16, 0x25, 0x86, 0x56, 0x55, 0x09, 0xbe, 0x91,
	]
}
