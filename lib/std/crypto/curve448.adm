partial module std.crypto {
	use (
		std.crypto.hash::(shake256)
		std.crypto.curve448::*
	)

	// x448 is the Diffie-Hellman function of RFC 7748 over Curve448: the
	// u-coordinate of scalar times point, both 56 bytes little-endian. The
	// scalar is clamped as the RFC requires, so any 56 random bytes are a
	// private key; the public key is x448Base(scalar).
	// Fails when either input is not 56 bytes or the result is all zeros,
	// which means the peer sent a low-order point.
	def x448(scalar, point byte[]) !byte[] {
		expects {
			assert scalar.len() == 56 onerror fail "x448: scalar must be 56 bytes"
			assert point.len() == 56 onerror fail "x448: point must be 56 bytes"
		}
		let k = scalar.clone()
		k[0] &= 252
		k[55] |= 128

		let x1 = f448FromBytes(point)
		let x2 = f448One()
		let z2 = f448Zero()
		let x3 = x1.clone()
		let z3 = f448One()
		let swap uint64 = 0
		for let t = 447; t >= 0; t-- {
			let bit = uint64((k[t / 8] >> (t % 8)) & 1)
			swap ^= bit
			f448Swap(x2, x3, swap)
			f448Swap(z2, z3, swap)
			swap = bit

			let a = f448Add(x2, z2)
			let aa = f448Mul(a, a)
			let b = f448Sub(x2, z2)
			let bb = f448Mul(b, b)
			let e = f448Sub(aa, bb)
			let c = f448Add(x3, z3)
			let d = f448Sub(x3, z3)
			let da = f448Mul(d, a)
			let cb = f448Mul(c, b)
			let sum = f448Add(da, cb)
			x3 = f448Mul(sum, sum)
			let diff = f448Sub(da, cb)
			z3 = f448Mul(x1, f448Mul(diff, diff))
			x2 = f448Mul(aa, bb)
			z2 = f448Mul(e, f448Add(aa, f448MulSmall(e, 39081)))
		}
		f448Swap(x2, x3, swap)
		f448Swap(z2, z3, swap)

		let out = f448ToBytes(f448Mul(x2, f448Invert(z2)))
		let acc byte = 0
		for let (_, v) in out {
			acc |= v
		}
		fail "x448: low order point" when acc == 0
		return out
	}

	// x448Base is the public key for a scalar: x448 with the base point
	// u = 5. Fails when the scalar is not 56 bytes.
	def x448Base(scalar byte[]) !byte[] {
		let base byte[]
		base.len(56)
		base[0] = 5
		return try x448(scalar, base)
	}

	// Ed448PublicKey verifies Ed448 and Ed448ph signatures (RFC 8032 §5.2)
	// over edwards448.
	// X448PublicKey is an X448 key agreement public key: the 56-byte
	// u-coordinate.
	type X448PublicKey {
		bytes byte[]

		def new(bytes byte[]) {
			self.bytes = bytes
		}
	}

	// X448PrivateKey is an X448 key agreement private key.
	type X448PrivateKey {
		scalar byte[]
		public X448PublicKey

		def new(scalar byte[], public X448PublicKey) {
			self.scalar = scalar
			self.public = public
		}

		// sharedSecret is the X448 shared secret with the peer. Fails when
		// the peer's key is a low-order point.
		def sharedSecret(peer X448PublicKey) !byte[] {
			return try x448(scalar, peer.bytes)
		}
	}

	// newX448PrivateKey makes a private key of a 56-byte scalar. Fails when
	// it is not 56 bytes.
	def newX448PrivateKey(scalar byte[]) !X448PrivateKey {
		return new X448PrivateKey(scalar.clone(), new X448PublicKey(try x448Base(scalar)))
	}

	// newX448PublicKey makes a public key of 56 bytes. Fails when it is not
	// 56 bytes.
	def newX448PublicKey(bytes byte[]) !X448PublicKey {
		fail "x448: public key must be 56 bytes" when bytes.len() != 56
		return new X448PublicKey(bytes.clone())
	}

	// generateX448Key draws a private key from the system's random source.
	// Fails when the random source is unavailable.
	def generateX448Key() !X448PrivateKey {
		return try newX448PrivateKey(try rand(56))
	}

	type Ed448PublicKey {
		// The 57-byte encoded point.
		bytes          byte[]
		internal point Ed448Point

		def new(bytes byte[], point Ed448Point) {
			self.bytes = bytes
			self.point = point
		}

		// verify reports whether signature is a valid Ed448 signature by
		// this key over message (RFC 8032 §5.2.7) with the same context
		// string, or with `prehash` an Ed448ph signature over the message's
		// SHAKE256 digest. A signature of the wrong length, an S outside
		// [0, L), an R that does not decode to a curve point, or a context
		// longer than 255 bytes is rejected.
		def verify(message byte[], signature byte[], context byte[] = [], prehash bool = false) bool {
			return false when signature.len() != 114 || context.len() > 255
			let s = scalar448FromBytes(signature[57:114])
			return false when s >= ed448L
			let r = decodeEd448Point(signature[0:57])
			return false when r is none
			let dom = dom4(context, prehash)
			let m = prehash ?? (shake256(message, 64), message)
			let k = scalar448FromBytes(shake256(dom + signature[0:57] + bytes + m, 114)).mod(ed448L)
			// [4][S]B = [4]R + [4][k]A, the check RFC 8032 states.
			let lhs = ed448Times4(ed448ScalarMult(s, ed448BasePoint()))
			let rhs = ed448Times4(ed448Add(r, ed448ScalarMult(k, point)))
			return ed448Same(lhs, rhs)
		}
	}

	// Ed448PrivateKey signs messages deterministically from a 57-byte seed
	// (RFC 8032 §5.2). The curve arithmetic underneath is not constant
	// time, matching the rest of this module.
	type Ed448PrivateKey {
		seed            byte[]
		public          Ed448PublicKey
		internal s      bigint
		internal prefix byte[]

		def new(seed byte[], public Ed448PublicKey, s bigint, prefix byte[]) {
			self.seed = seed
			self.public = public
			self.s = s
			self.prefix = prefix
		}

		// sign returns the deterministic Ed448 signature over message
		// (RFC 8032 §5.2.6), bound to the context string, or with `prehash`
		// the Ed448ph signature over the message's SHAKE256 digest. The
		// signature is 114 bytes. Fails when the context is longer than 255
		// bytes.
		def sign(message byte[], context byte[] = [], prehash bool = false) !byte[] {
			expects {
				assert context.len() <= 255 onerror fail "ed448: context longer than 255 bytes"
			}
			let dom = dom4(context, prehash)
			let m = prehash ?? (shake256(message, 64), message)
			let r = scalar448FromBytes(shake256(dom + prefix + m, 114)).mod(ed448L)
			let rBytes = encodeEd448Point(ed448ScalarMult(r, ed448BasePoint()))
			let k = scalar448FromBytes(shake256(dom + rBytes + public.bytes + m, 114)).mod(ed448L)
			let sOut = (r + k * s).mod(ed448L)
			return rBytes + scalar448ToBytes(sOut)
		}
	}

	// newEd448PrivateKey derives a key pair from a 57-byte seed (RFC 8032
	// §5.2.5): SHAKE256(seed, 114) splits into a clamped scalar and a nonce
	// prefix, and the scalar's public point is the matching public key.
	// Fails when the seed is not 57 bytes.
	def newEd448PrivateKey(seed byte[]) !Ed448PrivateKey {
		expects {
			assert seed.len() == 57 onerror fail "ed448: seed must be 57 bytes"
		}
		let h = shake256(seed, 114)
		let a = h[0:57].clone()
		a[0] &= 252
		a[56] = 0
		a[55] |= 128
		let s = scalar448FromBytes(a)
		let point = ed448ScalarMult(s, ed448BasePoint())
		let public = new Ed448PublicKey(encodeEd448Point(point), point)
		return new Ed448PrivateKey(seed.clone(), public, s, h[57:114].clone())
	}

	// newEd448PublicKey reads a 57-byte encoded point (RFC 8032 §5.2.3).
	// Fails when the length is wrong or the bytes do not decode to a point
	// on the curve.
	def newEd448PublicKey(bytes byte[]) !Ed448PublicKey {
		expects {
			assert bytes.len() == 57 onerror fail "ed448: public key must be 57 bytes"
		}
		let point = decodeEd448Point(bytes)
		fail "ed448: public key does not decode to a curve point" when point is none
		return new Ed448PublicKey(bytes.clone(), point)
	}

	// generateEd448Key draws a fresh seed from the system random source and
	// derives its key pair. Fails when the random source is unavailable.
	def generateEd448Key() !Ed448PrivateKey {
		return try newEd448PrivateKey(try rand(57))
	}
}

internal partial module std.crypto.curve448 {
	use (
		std.crypto::*
		std.crypto.hash::(shake256)
	)

	// Field elements modulo p = 2^448 - 2^224 - 1 are eight 56-bit limbs,
	// little endian, held loosely between operations. Since 2^448 is
	// 2^224 + 1 mod p, a carry out of the top limb folds into limbs 0 and 4.
	const f448Mask uint64 = 0xffffffffffffff

	// ed448L is the order of the base point subgroup (RFC 8032 §5.2).
	let ed448L = bigint(0x3fffffffffffffffffffffffffffffffffffffffffffffffffffffff7cca23e9c44edb49aed63690216cc2728dc58f552378c292ab5844f3)

	// ed448P is the field prime, for the canonical-encoding check.
	let ed448P = bigint(0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffffffffffffffffffffffffffffffffffffffffffffffffffff)

	def f448Zero() uint64[] {
		return uint64[0, 0, 0, 0, 0, 0, 0, 0]
	}

	def f448One() uint64[] {
		return uint64[1, 0, 0, 0, 0, 0, 0, 0]
	}

	// f448FromBytes reads 56 little-endian bytes: limb i is bytes 7i to
	// 7i + 6. A value at or above p is kept and reduces as it is used.
	def f448FromBytes(b byte[]) uint64[] {
		let h = f448Zero()
		for let i = 0; i < 8; i++ {
			let v uint64 = 0
			for let j = 6; j >= 0; j-- {
				v = (v << 8) | uint64(b[7 * i + j])
			}
			h[i] = v
		}
		return h
	}

	// f448ToBytes reduces fully and writes 56 little-endian bytes.
	def f448ToBytes(v uint64[]) byte[] {
		let h = v.clone()
		f448Carry(h)
		f448Carry(h)
		// h is now below 2^448 and so below 2p: subtract p once if that
		// does not borrow.
		let s = f448Zero()
		let borrow uint64 = 0
		for let i = 0; i < 8; i++ {
			let pi = i == 4 ?? (f448Mask - 1, f448Mask)
			let d = h[i] - pi - borrow
			borrow = d >> 63
			s[i] = d & f448Mask
		}
		f448Swap(h, s, 1 - borrow)
		let out byte[]
		out.len(56)
		for let i = 0; i < 8; i++ {
			for let j = 0; j < 7; j++ {
				out[7 * i + j] = byte((h[i] >> uint64(8 * j)) & 0xFF)
			}
		}
		return out
	}

	// f448Carry brings every limb below 2^56 in place; the carry out of the
	// top limb wraps into limbs 0 and 4.
	def f448Carry(h uint64[]) {
		for let i = 0; i < 7; i++ {
			h[i + 1] += h[i] >> 56
			h[i] &= f448Mask
		}
		let c = h[7] >> 56
		h[7] &= f448Mask
		h[0] += c
		h[4] += c
		h[1] += h[0] >> 56
		h[0] &= f448Mask
		h[5] += h[4] >> 56
		h[4] &= f448Mask
	}

	def f448Add(a, b uint64[]) uint64[] {
		let r = uint64[a[0] + b[0], a[1] + b[1], a[2] + b[2], a[3] + b[3], a[4] + b[4], a[5] + b[5], a[6] + b[6], a[7] + b[7]]
		f448Carry(r)
		return r
	}

	// f448Sub adds 2p before subtracting so no limb goes negative.
	def f448Sub(a, b uint64[]) uint64[] {
		let r = uint64[
			(a[0] + 0x1fffffffffffffe) - b[0],
			(a[1] + 0x1fffffffffffffe) - b[1],
			(a[2] + 0x1fffffffffffffe) - b[2],
			(a[3] + 0x1fffffffffffffe) - b[3],
			(a[4] + 0x1fffffffffffffc) - b[4],
			(a[5] + 0x1fffffffffffffe) - b[5],
			(a[6] + 0x1fffffffffffffe) - b[6],
			(a[7] + 0x1fffffffffffffe) - b[7]
		]
		f448Carry(r)
		return r
	}

	// f448Mul is schoolbook multiplication with 128-bit accumulators; the
	// products at 2^448 and above fold back through 2^448 = 2^224 + 1.
	def f448Mul(x, y uint64[]) uint64[] {
		let a0, a1, a2, a3 = uint128(x[0]), uint128(x[1]), uint128(x[2]), uint128(x[3])
		let a4, a5, a6, a7 = uint128(x[4]), uint128(x[5]), uint128(x[6]), uint128(x[7])
		let b0, b1, b2, b3 = uint128(y[0]), uint128(y[1]), uint128(y[2]), uint128(y[3])
		let b4, b5, b6, b7 = uint128(y[4]), uint128(y[5]), uint128(y[6]), uint128(y[7])
		let r0 = a0 * b0
		let r1 = a0 * b1 + a1 * b0
		let r2 = a0 * b2 + a1 * b1 + a2 * b0
		let r3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0
		let r4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0
		let r5 = a0 * b5 + a1 * b4 + a2 * b3 + a3 * b2 + a4 * b1 + a5 * b0
		let r6 = a0 * b6 + a1 * b5 + a2 * b4 + a3 * b3 + a4 * b2 + a5 * b1 + a6 * b0
		let r7 = a0 * b7 + a1 * b6 + a2 * b5 + a3 * b4 + a4 * b3 + a5 * b2 + a6 * b1 + a7 * b0
		let r8 = a1 * b7 + a2 * b6 + a3 * b5 + a4 * b4 + a5 * b3 + a6 * b2 + a7 * b1
		let r9 = a2 * b7 + a3 * b6 + a4 * b5 + a5 * b4 + a6 * b3 + a7 * b2
		let r10 = a3 * b7 + a4 * b6 + a5 * b5 + a6 * b4 + a7 * b3
		let r11 = a4 * b7 + a5 * b6 + a6 * b5 + a7 * b4
		let r12 = a5 * b7 + a6 * b6 + a7 * b5
		let r13 = a6 * b7 + a7 * b6
		let r14 = a7 * b7
		r6 += r14
		r10 += r14
		r5 += r13
		r9 += r13
		r4 += r12
		r8 += r12
		r3 += r11
		r7 += r11
		r2 += r10
		r6 += r10
		r1 += r9
		r5 += r9
		r0 += r8
		r4 += r8
		return f448Reduce128(r0, r1, r2, r3, r4, r5, r6, r7)
	}

	// f448MulSmall multiplies by a constant below 2^32.
	def f448MulSmall(a uint64[], k uint64) uint64[] {
		let m = uint128(k)
		return f448Reduce128(uint128(a[0]) * m, uint128(a[1]) * m, uint128(a[2]) * m, uint128(a[3]) * m, uint128(a[4]) * m, uint128(a[5]) * m, uint128(a[6]) * m, uint128(a[7]) * m)
	}

	def f448Reduce128(r0, r1, r2, r3, r4, r5, r6, r7 uint128) uint64[] {
		let mask = uint128(f448Mask)
		r1 += r0 >> 56
		r0 &= mask
		r2 += r1 >> 56
		r1 &= mask
		r3 += r2 >> 56
		r2 &= mask
		r4 += r3 >> 56
		r3 &= mask
		r5 += r4 >> 56
		r4 &= mask
		r6 += r5 >> 56
		r5 &= mask
		r7 += r6 >> 56
		r6 &= mask
		let c = r7 >> 56
		r7 &= mask
		r0 += c
		r4 += c
		r1 += r0 >> 56
		r0 &= mask
		r5 += r4 >> 56
		r4 &= mask
		return uint64[uint64(r0), uint64(r1), uint64(r2), uint64(r3), uint64(r4), uint64(r5), uint64(r6), uint64(r7)]
	}

	// f448Invert raises to p - 2, whose bits are all set except 1 and 224.
	def f448Invert(a uint64[]) uint64[] {
		let r = f448One()
		for let i = 447; i >= 0; i-- {
			r = f448Mul(r, r)
			r = f448Mul(r, a) when i != 1 && i != 224
		}
		return r
	}

	// f448Sqrt raises to (p + 1) / 4 = 2^446 - 2^222, whose set bits are 222
	// to 445: since p is 3 mod 4, a square's square root.
	def f448Sqrt(a uint64[]) uint64[] {
		let r = f448One()
		for let i = 445; i >= 0; i-- {
			r = f448Mul(r, r)
			r = f448Mul(r, a) when i >= 222
		}
		return r
	}

	// f448Swap exchanges a and b in place when swap is 1, touching both
	// either way.
	def f448Swap(a, b uint64[], swap uint64) {
		let mask = uint64(0) - swap
		for let i = 0; i < 8; i++ {
			let t = mask & (a[i] ^ b[i])
			a[i] ^= t
			b[i] ^= t
		}
	}

	def f448Neg(a uint64[]) uint64[] {
		return f448Sub(f448Zero(), a)
	}

	// f448Equal compares canonical encodings in constant time.
	def f448Equal(a, b uint64[]) bool {
		return constantTimeEqual(f448ToBytes(a), f448ToBytes(b))
	}

	// Ed448Point is a point of edwards448, x^2 + y^2 = 1 - 39081 x^2 y^2, in
	// projective coordinates (x = X/Z, y = Y/Z).
	struct Ed448Point {
		x, y, z uint64[]
	}

	// ed448BasePoint is the generator B of RFC 8032 §5.2.
	def ed448BasePoint() Ed448Point {
		let x = f448FromBytes(byte[
			0x5e, 0xc0, 0x0c, 0xc7, 0x2b, 0xa8, 0x26, 0x26, 0x8e, 0x93, 0x00, 0x8b, 0xe1, 0x80, 0x3b, 0x43,
			0x11, 0x65, 0xb6, 0x2a, 0xf7, 0x1a, 0xae, 0x12, 0x64, 0xa4, 0xd3, 0xa3, 0x24, 0xe3, 0x6d, 0xea,
			0x67, 0x17, 0x0f, 0x47, 0x70, 0x65, 0x14, 0x9e, 0xda, 0x36, 0xbf, 0x22, 0xa6, 0x15, 0x1d, 0x22,
			0xed, 0x0d, 0xed, 0x6b, 0xc6, 0x70, 0x19, 0x4f
		])
		let y = f448FromBytes(byte[
			0x14, 0xfa, 0x30, 0xf2, 0x5b, 0x79, 0x08, 0x98, 0xad, 0xc8, 0xd7, 0x4e, 0x2c, 0x13, 0xbd, 0xfd,
			0xc4, 0x39, 0x7c, 0xe6, 0x1c, 0xff, 0xd3, 0x3a, 0xd7, 0xc2, 0xa0, 0x05, 0x1e, 0x9c, 0x78, 0x87,
			0x40, 0x98, 0xa3, 0x6c, 0x73, 0x73, 0xea, 0x4b, 0x62, 0xc7, 0xc9, 0x56, 0x37, 0x20, 0x76, 0x88,
			0x24, 0xbc, 0xb6, 0x6e, 0x71, 0x46, 0x3f, 0x69
		])
		return Ed448Point{x: x, y: y, z: f448One()}
	}

	def ed448Identity() Ed448Point {
		return Ed448Point{x: f448Zero(), y: f448One(), z: f448One()}
	}

	// ed448Add is the addition of RFC 8032 §5.2.4. The law is complete for
	// this curve (d is not a square), so it doubles and takes the identity
	// like any other point.
	def ed448Add(p, q Ed448Point) Ed448Point {
		let a = f448Mul(p.z, q.z)
		let b = f448Mul(a, a)
		let c = f448Mul(p.x, q.x)
		let d = f448Mul(p.y, q.y)
		// E = d*C*D with d = -39081.
		let e = f448Neg(f448MulSmall(f448Mul(c, d), 39081))
		let f = f448Sub(b, e)
		let g = f448Add(b, e)
		let h = f448Mul(f448Add(p.x, p.y), f448Add(q.x, q.y))
		let x = f448Mul(f448Mul(a, f), f448Sub(f448Sub(h, c), d))
		let y = f448Mul(f448Mul(a, g), f448Sub(d, c))
		return Ed448Point{x: x, y: y, z: f448Mul(f, g)}
	}

	// ed448Double is the doubling of RFC 8032 §5.2.4.
	def ed448Double(p Ed448Point) Ed448Point {
		let s = f448Add(p.x, p.y)
		let b = f448Mul(s, s)
		let c = f448Mul(p.x, p.x)
		let d = f448Mul(p.y, p.y)
		let e = f448Add(c, d)
		let h = f448Mul(p.z, p.z)
		let j = f448Sub(e, f448Add(h, h))
		return Ed448Point{x: f448Mul(f448Sub(b, e), j), y: f448Mul(e, f448Sub(c, d)), z: f448Mul(e, j)}
	}

	def ed448Times4(p Ed448Point) Ed448Point {
		return ed448Double(ed448Double(p))
	}

	// ed448Same reports whether two points are the same, whatever their Z.
	def ed448Same(p, q Ed448Point) bool {
		return f448Equal(f448Mul(p.x, q.z), f448Mul(q.x, p.z)) && f448Equal(f448Mul(p.y, q.z), f448Mul(q.y, p.z))
	}

	// ed448ScalarMult returns k times the point with a fixed 4-bit window:
	// sixteen multiples once, then four doublings and one addition per
	// nibble of k.
	def ed448ScalarMult(k bigint, p Ed448Point) Ed448Point {
		let table Ed448Point[] = [ed448Identity(), p]
		for let i = 2; i < 16; i++ {
			table.push(ed448Add(table[i - 1], p))
		}
		let acc = ed448Identity()
		let top = (k.bitLen() + 3) / 4
		for let w = top - 1; w >= 0; w-- {
			acc = ed448Double(ed448Double(ed448Double(ed448Double(acc))))
			let nibble = 0
			for let b = 3; b >= 0; b-- {
				nibble = nibble * 2 + (k.bit(4 * w + b) ?? (1, 0))
			}
			acc = ed448Add(acc, table[nibble]) when nibble != 0
		}
		return acc
	}

	// encodeEd448Point is the 57-byte form of RFC 8032 §5.2.2: y
	// little-endian over 56 bytes, then a byte holding the sign of x in its
	// top bit.
	def encodeEd448Point(p Ed448Point) byte[] {
		let inverse = f448Invert(p.z)
		let xBytes = f448ToBytes(f448Mul(p.x, inverse))
		return f448ToBytes(f448Mul(p.y, inverse)) + byte[(xBytes[0] & 1) << 7]
	}

	// decodeEd448Point reads the 57-byte form (RFC 8032 §5.2.3): none when
	// the length is wrong, the last byte has bits other than the sign, y
	// is not below p, x has no square root, or x is zero with the sign set.
	def decodeEd448Point(data byte[]) ?Ed448Point {
		return none when data.len() != 57 || (data[56] & 0x7F) != 0
		let signBit = (data[56] >> 7) & 1
		return none when scalar448FromBytes(data[0:56]) >= ed448P
		let y = f448FromBytes(data[0:56])
		let y2 = f448Mul(y, y)
		let u = f448Sub(y2, f448One())
		// d*y^2 - 1 with d = -39081.
		let v = f448Sub(f448Neg(f448MulSmall(y2, 39081)), f448One())
		let x2 = f448Mul(u, f448Invert(v))
		let x = f448Sqrt(x2)
		return none unless f448Equal(f448Mul(x, x), x2)
		let xBytes = f448ToBytes(x)
		let zero = f448Equal(x, f448Zero())
		return none when zero && signBit == 1
		x = f448Neg(x) when (xBytes[0] & 1) != signBit
		return Ed448Point{x: x, y: y, z: f448One()}
	}

	// dom4 is the prefix of RFC 8032 §5.2: "SigEd448", the prehash flag and
	// the context with its length.
	def dom4(context byte[], prehash bool) byte[] {
		return "SigEd448".bytes() + byte[prehash ?? (byte(1), byte(0)), byte(context.len())] + context
	}

	// scalar448FromBytes reads little-endian bytes as an unsigned integer.
	def scalar448FromBytes(b byte[]) bigint {
		return parseBigInt(b.clone().reverse())
	}

	// scalar448ToBytes writes a scalar as 57 little-endian bytes.
	def scalar448ToBytes(v bigint) byte[] {
		let raw = v.bytes()
		let out byte[]
		out.len(57)
		let off = 57 - raw.len()
		for let i = 0; i < raw.len(); i++ {
			out[off + i] = raw[i]
		}
		return out.reverse()
	}
}
