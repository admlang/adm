			]
			for let c in cases {
				let public = try newEd448PublicKey(try hexdecode(c[0]))
				let ok = public.verify(try hexdecode(c[1]), try hexdecode(c[2]))
				assert ok == (c[3] == "1") onerror fail "wycheproof case {c[4]}"
			}
		}

		@test()
		def TestEd448Rejects() !none {
			let key = try generateEd448Key()
			let sig = try key.sign("m".bytes())
			assert key.public.verify("m".bytes(), sig)
			let long byte[]
			long.len(256)
			assert key.sign("m".bytes(), long) is error
			assert !key.public.verify("m".bytes(), sig, long)
			assert newEd448PrivateKey(byte[1, 2]) is error
			assert newEd448PublicKey(sig[0:56]) is error
			// The unused bits of the last byte must be zero.
			let bad = key.public.bytes.clone()
			bad[56] |= 1
			assert newEd448PublicKey(bad) is error
		}
	}
}
