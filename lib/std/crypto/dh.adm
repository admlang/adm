partial module std.crypto {
	// DHParameters are finite-field Diffie-Hellman domain parameters: the
	// prime p, the generator g, and the order q of the subgroup g generates
	// (X9.42 and RFC 2631; none for PKCS #3 parameters, which carry no q).
	struct DHParameters {
		p bigint
		g bigint
		q ?bigint
	}

	// DHPublicKey is a finite-field Diffie-Hellman public key y = g^x mod p.
	type DHPublicKey {
		params DHParameters
		y      bigint

		def new(params DHParameters, y bigint) {
			self.params = params
			self.y = y
		}
	}

	// DHPrivateKey is a finite-field Diffie-Hellman private key.
	type DHPrivateKey {
		params DHParameters
		x      bigint
		public DHPublicKey

		def new(params DHParameters, x bigint, public DHPublicKey) {
			self.params = params
			self.x = x
			self.public = public
		}

		// sharedSecret is ZZ = y^x mod p of the peer's key, as many bytes as
		// p (RFC 2631 §2.1.2). Fails when the peer uses other parameters or
		// its key fails the checks of newDHPublicKey.
		def sharedSecret(peer DHPublicKey) !byte[] {
			expects {
				assert peer.params.p == params.p && peer.params.g == params.g onerror fail "dh: the peer's key uses other parameters"
			}
			try checkDHPublic(params, peer.y)
			let z = peer.y.modPow(x, params.p)
			fail "dh: the shared secret is 1" when z == bigint(1)
			return try z.bytes((params.p.bitLen() + 7) / 8)
		}
	}

	// newDHPublicKey makes a public key of the parameters and y. Fails when
	// y is outside 2 to p - 2, or, with q, when y^q mod p is not 1 (RFC 2631
	// §2.1.5: the key lies outside the subgroup).
	def newDHPublicKey(params DHParameters, y bigint) !DHPublicKey {
		try checkDHPublic(params, y)
		return new DHPublicKey(params, y)
	}

	// newDHPrivateKey makes a private key of the parameters and x. Fails
	// when x is outside 2 to q - 2 (to p - 2 without q).
	def newDHPrivateKey(params DHParameters, x bigint) !DHPrivateKey {
		let q = params.q
		let limit = q is none ?? (params.p, q)
		fail "dh: private value out of range" when x < bigint(2) || x > limit - bigint(2)
		return new DHPrivateKey(params, x, new DHPublicKey(params, params.g.modPow(x, params.p)))
	}

	// generateDHKey draws a private key for the parameters, x uniform in
	// 2 to q - 2 (to p - 2 without q). Fails when the random source is
	// unavailable or the parameters are too small.
	def generateDHKey(params DHParameters) !DHPrivateKey {
		let q = params.q
		let limit = q is none ?? (params.p, q)
		fail "dh: parameters too small" when limit.bitLen() < 8
		let x = parseBigInt(try rand((limit.bitLen() + 7) / 8 + 8)).mod(limit - bigint(3)) + bigint(2)
		return try newDHPrivateKey(params, x)
	}

	internal def checkDHPublic(params DHParameters, y bigint) !none {
		expects {
			assert y >= bigint(2) && y <= params.p - bigint(2) onerror fail "dh: public value out of range"
		}
		let q = params.q
		if !(q is none) {
			fail "dh: public value outside the subgroup" when y.modPow(q, params.p) != bigint(1)
		}
		return none
	}
}
