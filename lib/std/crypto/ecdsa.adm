partial module std.crypto {
	use std.data.encoding::(ASN1Tag, asn1Parse, asn1Sequence, asn1Integer)

	// ECDSAPublicKey verifies ECDSA signatures over one of the NIST curves.
	type ECDSAPublicKey {
		curve curve
		point Point

		def new(curve curve, point Point) {
			self.curve = curve
			self.point = point
		}

		// verify checks the signature (r, s) over a message digest. The
		// digest is truncated to the bit length of the curve order, as
		// FIPS 186-4 specifies, so any hash pairs with any curve.
		def verify(digest byte[], r, s bigint) bool {
			let n = curve.n
			return false when !isOnCurve(curve, point)
			return false when r.sign() <= 0 || s.sign() <= 0 || r >= n || s >= n
			let e = hashToInt(digest, n)
			let w = s.modInverse(n)
			return false when w is none
			let u1 = (e * w).mod(n)
			let u2 = (r * w).mod(n)
			let sum = addPoints(curve, scalarBaseMult(curve, u1), scalarMult(curve, point, u2))
			return false when isInfinity(sum)
			return sum.x.mod(n) == r
		}
	}

	// ECDSAPrivateKey is a private scalar on one of the NIST curves with its
	// public point. The nonce of each signature is drawn from the system
	// random source; the curve arithmetic underneath is not constant time.
	type ECDSAPrivateKey {
		curve curve
		d     bigint
		point Point

		def new(curve curve, d bigint, point Point) {
			self.curve = curve
			self.d = d
			self.point = point
		}

		// publicKey is the matching public key.
		def publicKey() ECDSAPublicKey {
			return new ECDSAPublicKey(curve, point)
		}

		// sign signs a message digest, truncated to the bit length of the
		// curve order as verify expects, and returns (r, s). Fails when the
		// random source is unavailable.
		def sign(digest byte[]) !(bigint, bigint) {
			let n = curve.n
			let e = hashToInt(digest, n)
			let r = bigint(0)
			let s = bigint(0)
			for r.isZero() || s.isZero() {
				let k = parseBigInt(try rand(coordinateSize(curve) + 8)).mod(n - 1) + 1
				let kInv = k.modInverse(n)
				continue when kInv is none
				r = scalarBaseMult(curve, k).x.mod(n)
				continue when r.isZero()
				s = (kInv * (e + r * d)).mod(n)
			}
			return (r, s)
		}

		// signASN1 signs a message digest and returns the DER ECDSA-Sig-Value
		// that X.509 and TLS carry. Fails when the random source is
		// unavailable.
		def signASN1(digest byte[]) !byte[] {
			let (r, s) = try sign(digest)
			return marshalECDSASignature(r, s)
		}
	}

	// marshalECDSASignature writes ECDSA-Sig-Value ::= SEQUENCE { r INTEGER,
	// s INTEGER } as DER.
	def marshalECDSASignature(r, s bigint) byte[] {
		return asn1Sequence([asn1Integer(r), asn1Integer(s)]).encode()
	}

	// parseECDSASignature reads ECDSA-Sig-Value ::= SEQUENCE { r INTEGER,
	// s INTEGER }. Fails when the bytes are not that DER.
	def parseECDSASignature(signature byte[]) !(bigint, bigint) {
		let seq = try asn1Parse(signature)
		fail "ecdsa: signature is not a SEQUENCE of two" unless seq.isTag(ASN1Tag.Sequence) && seq.children.len() == 2
		let r = try (try seq.at(0)).asBigInt()
		let s = try (try seq.at(1)).asBigInt()
		return (r, s)
	}

	// hashToInt reads a digest as an integer and keeps its leftmost
	// bitLen(n) bits.
	internal def hashToInt(digest byte[], n bigint) bigint {
		let orderBits = n.bitLen()
		let orderBytes = (orderBits + 7) / 8
		let d = digest
		d = d[0:orderBytes] when d.len() > orderBytes
		let e = parseBigInt(d)
		let excess = d.len() * 8 - orderBits
		e = e >> excess when excess > 0
		return e
	}
}
