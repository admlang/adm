partial module std.crypto {
	use (
		std.testing
		std.data.encoding::(hexdecode)
		std.crypto.hash::(Hash, digest)
	)

	// Keys and signatures below come from OpenSSL over the message "sample".
	check "ECDSA" {
		@test()
		def TestECDSAVerifyP256() !none {
			let pub = try unmarshalPoint(p256, try hexdecode("0409C77E8830E090C742CFC648D1E29854CF352B94528243158547D66092CCD77D2A891F0A97735CE4E6619F54734B9DC3E20DD7B2D49E28B613E0E0A90470037E"))
			let key = new ECDSAPublicKey(p256, pub)
			let digest = try hexdecode("AF2BDBE1AA9B6EC1E2ADE1D694F41FC71A831D0268E9891562113D8A62ADD1BF")
			let r = try parseBigInt("FDEF7E77EE9A96C949F9A6C7FD88A338FE83DDD129030A5E8D512BD2073B457D", 16)
			let s = try parseBigInt("56BB1322C5EE29CF8109FD41723D56773CDC0EEABA38110746C1132BB6A8CD01", 16)
			assert key.verify(digest, r, s)
			assert !key.verify(digest, s, r)
			digest[0] ^= 1
			assert !key.verify(digest, r, s)
			assert !key.verify(digest, bigint(0), s)
			assert !key.verify(digest, r, p256.n)
		}

		@test()
		def TestECDSAVerifyP384() !none {
			let pub = try unmarshalPoint(p384, try hexdecode("04088FB5D377439EAAFF544E5E95B0207502C7295AB19D3B3217DA4808AD5EDC5A037B6612146ABF514B2C48147A5564F5C5E6D89C2F26C35E740E3AD97835B4033D3DDA10BF444D629432EDE5234C99413D3D6B4568B943355F61DD579E7998B1"))
			let key = new ECDSAPublicKey(p384, pub)
			let digest = try hexdecode("9A9083505BC92276AEC4BE312696EF7BF3BF603F4BBD381196A029F340585312313BCA4A9B5B890EFEE42C77B1EE25FE")
			let r = try parseBigInt("CA2A11F2F6FCF6363179CA416FF9FC808A1E20B2DE0CCD21222726AFE188181E9C7A30B52E110812A74BA06B81FBFFDE", 16)
			let s = try parseBigInt("2972A06D2DA3C87C080DD51CC5D8450EAB817971909A471B78C4F4F64D78864A7B72FF75CB89D62556448222BBAE0F1F", 16)
			assert key.verify(digest, r, s)
			digest[47] ^= 1
			assert !key.verify(digest, r, s)
		}

		@test()
		def TestECDSASign() !none {
			let key = try parseECPrivateKey(der(ecPrivateSEC1PEM))
			let public = key.publicKey()
			let sum = digest(Hash.SHA256, "sample".bytes())
			// OpenSSL's signature with the same key over SHA-256("sample").
			let (r0, s0) = try parseECDSASignature(try hexdecode("3045022100ab6517ce014215e29cc83f4b5b0e7d3dc12bf3cdbeb53e5a75a87db6aedc193902205dfa2e98f6a5750c51295c5b46eafba61147197bf6c07c94e403b19b5101295b"))
			assert public.verify(sum, r0, s0)
			let (r, s) = try key.sign(sum)
			assert r.sign() > 0 && s.sign() > 0 && r < p256.n && s < p256.n
			assert public.verify(sum, r, s)
			assert !public.verify(sum, s, r)
			let (r2, s2) = try key.sign(sum)
			assert r2 != r
			assert public.verify(sum, r2, s2)
			let other = digest(Hash.SHA256, "sample!".bytes())
			assert !public.verify(other, r, s)
		}

		@test()
		def TestECDSASignASN1() !none {
			let key = try parseECPrivateKey(der(ecPrivateSEC1PEM))
			let sum = digest(Hash.SHA384, "sample".bytes())
			let sig = try key.signASN1(sum)
			assert sig[0] == 0x30 && sig.len() >= 70 && sig.len() <= 72
			let (r, s) = try parseECDSASignature(sig)
			assert key.publicKey().verify(sum, r, s)
			assert marshalECDSASignature(r, s).hex() == sig.hex()
			let (badR, badS) = parseECDSASignature(sig[0:sig.len() - 1]) onerror recover (bigint(0), bigint(0))
			assert badR.isZero() && badS.isZero()
			let (seqR, seqS) = parseECDSASignature(byte[2, 1, 5]) onerror recover (bigint(0), bigint(0))
			assert seqR.isZero() && seqS.isZero()
		}
	}
}
