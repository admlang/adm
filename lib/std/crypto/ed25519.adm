partial module std.crypto {
	use std.crypto.hash::(Hash, digest)

	// Ed25519 (RFC 8032) over edwards25519, the twisted Edwards curve
	// birationally equivalent to Curve25519. The field arithmetic (51-bit
	// limbs, uint128 products) comes from x25519.adm; this file adds the
	// group law, point encoding and the signature scheme.

	// edP is the field prime 2^255 - 19.
	internal let edP = bigint(0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffed)

	// edL is the order of the base point subgroup (RFC 8032 §5.1), the
	// modulus signature scalars reduce against.
	internal let edL = bigint(0x1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed)

	// edSqrtExponent is (p+3)/8: since p ≡ 5 (mod 8), a candidate square
	// root of a field element is a raised to this power.
	internal let edSqrtExponent = bigint(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe)

	// edD is the twisted Edwards curve constant d = -121665/121666 mod p
	// (0x52036cee2b6ffe738cc740797779e89800700a4d4141d8ab75eb4dca135978a3),
	// as 51-bit limbs.
	internal def edD() uint64[] {
		return uint64[929955233495203, 466365720129213, 1662059464998953, 2033849074728123, 1442794654840575]
	}

	// edSqrtM1 is a square root of -1 mod p
	// (0x2b8324804fc1df0b2b4d00993dfbd7a72f431806ad2fe478c4ee1b274a0ea0b0),
	// used to find the other candidate root when the first guess is off by
	// a factor of -1.
	internal def edSqrtM1() uint64[] {
		return uint64[1718705420411056, 234908883556509, 2233514472574048, 2117202627021982, 765476049583133]
	}

	// edBaseX, edBaseY are the affine coordinates of the Ed25519 base point
	// B (x = 0x216936d3cd6e53fec0a4e231fdd6dc5c692cc7609525a7b2c9562d608f25d51a,
	// y = 4/5 mod p).
	internal def edBaseX() uint64[] {
		return uint64[1738742601995546, 1146398526822698, 2070867633025821, 562264141797630, 587772402128613]
	}

	internal def edBaseY() uint64[] {
		return uint64[1801439850948184, 1351079888211148, 450359962737049, 900719925474099, 1801439850948198]
	}

	// EdPoint is a point of edwards25519 in extended coordinates (x = X/Z,
	// y = Y/Z, x*y = T/Z), which add without a field inversion.
	internal struct EdPoint {
		x, y, z, t uint64[]
	}

	// edAffine lifts affine coordinates.
	internal def edAffine(x uint64[], y uint64[]) EdPoint {
		return EdPoint{x: x, y: y, z: feOne(), t: feMul(x, y)}
	}

	// edBasePoint is the generator B.
	internal def edBasePoint() EdPoint {
		return edAffine(edBaseX(), edBaseY())
	}

	// edIdentity is the neutral element (0, 1).
	internal def edIdentity() EdPoint {
		return edAffine(feZero(), feOne())
	}

	// edAdd returns p + q on -x^2 + y^2 = 1 + d*x^2*y^2. The law is complete
	// for this curve (d is a non-square, -1 a square), so it doubles a
	// point and takes the identity like any other. Variable time, like the
	// other curves of the module.
	internal def edAdd(p, q EdPoint) EdPoint {
		let a = feMul(feSub(p.y, p.x), feSub(q.y, q.x))
		let b = feMul(feAdd(p.y, p.x), feAdd(q.y, q.x))
		let c = feMul(feMul(p.t, q.t), feAdd(edD(), edD()))
		let zz = feMul(p.z, q.z)
		let d = feAdd(zz, zz)
		let e = feSub(b, a)
		let f = feSub(d, c)
		let g = feAdd(d, c)
		let h = feAdd(b, a)
		return EdPoint{x: feMul(e, f), y: feMul(g, h), z: feMul(f, g), t: feMul(e, h)}
	}

	// edSame reports whether two points are the same, whatever their Z.
	internal def edSame(p, q EdPoint) bool {
		return feEqual(feMul(p.x, q.z), feMul(q.x, p.z)) && feEqual(feMul(p.y, q.z), feMul(q.y, p.z))
	}

	// edScalarMult returns k times the point, by double-and-add over the
	// bits of k.
	internal def edScalarMult(k bigint, p EdPoint) EdPoint {
		let acc = edIdentity()
		for let i = k.bitLen() - 1; i >= 0; i-- {
			acc = edAdd(acc, acc)
			acc = edAdd(acc, p) when k.bit(i)
		}
		return acc
	}

	// fePow raises a field element to a non-negative exponent by
	// square-and-multiply.
	internal def fePow(a uint64[], e bigint) uint64[] {
		let r = feOne()
		for let i = e.bitLen() - 1; i >= 0; i-- {
			r = feMul(r, r)
			r = feMul(r, a) when e.bit(i)
		}
		return r
	}

	internal def feIsZero(a uint64[]) bool {
		return feEqual(a, feZero())
	}

	// encodeEdPoint is the RFC 8032 §5.1.2 compressed form: y little-endian
	// over 32 bytes, with the sign of x folded into the unused top bit.
	internal def encodeEdPoint(p EdPoint) byte[] {
		let inverse = feInvert(p.z)
		let out = feToBytes(feMul(p.y, inverse))
		let xBytes = feToBytes(feMul(p.x, inverse))
		out[31] = (out[31] & 0x7F) | ((xBytes[0] & 1) << 7)
		return out
	}

	// decodeEdPoint reads the compressed form (RFC 8032 §5.1.3): none when
	// the length is wrong, y is not a canonical value below p, x has no
	// square root, or x is zero with the sign bit set.
	internal def decodeEdPoint(data byte[]) ?EdPoint {
		return none when data.len() != 32
		let signBit = (data[31] >> 7) & 1
		let raw = byte[] + data
		raw[31] &= 0x7F
		// reverse() mutates in place, so check the canonical range on a
		// throwaway copy: raw is still needed little-endian below.
		return none when parseBigInt((byte[] + raw).reverse()) >= edP
		let y = feFromBytes(raw)
		let y2 = feMul(y, y)
		let u = feSub(y2, feOne())
		let v = feAdd(feMul(edD(), y2), feOne())
		let x2 = feMul(u, feInvert(v))
		let candidate = fePow(x2, edSqrtExponent)
		let matches = feEqual(feMul(candidate, candidate), x2)
		let matchesNeg = feEqual(feMul(candidate, candidate), feNeg(x2))
		return none unless matches || matchesNeg
		let x = matches ?? (candidate, feMul(candidate, edSqrtM1()))
		return none when feIsZero(x) && signBit == 1
		let xBytes = feToBytes(x)
		x = feNeg(x) when (xBytes[0] & 1) != signBit
		return edAffine(x, y)
	}

	// scalarFromBytes reads little-endian bytes as an unsigned integer.
	// reverse() mutates in place, so this works from a copy: b is often a
	// slice view into a caller's array (a signature's S, say) that must
	// come back unchanged.
	internal def scalarFromBytes(b byte[]) bigint {
		return parseBigInt((byte[] + b).reverse())
	}

	// scalarToBytes writes a scalar as 32 little-endian bytes.
	internal def scalarToBytes(v bigint) byte[] {
		let raw = v.bytes()
		let out byte[]
		out.len(32)
		let off = 32 - raw.len()
		for let i = 0; i < raw.len(); i++ {
			out[off + i] = raw[i]
		}
		return out.reverse()
	}

	// hashScalar is SHA-512(data), read little-endian and reduced mod the
	// base point order: the nonce and challenge derivation RFC 8032 §5.1.6
	// and §5.1.7 share.
	internal def hashScalar(data byte[]) bigint {
		return scalarFromBytes(digest(Hash.SHA512, data)).mod(edL)
	}

	// Ed25519PublicKey verifies Ed25519 signatures (RFC 8032, pure Ed25519:
	// no context string, no prehash).
	type Ed25519PublicKey {
		bytes          byte[]
		internal point EdPoint

		def new(bytes byte[], point EdPoint) {
			self.bytes = bytes
			self.point = point
		}

		// verify reports whether signature is a valid Ed25519 signature by
		// this key over message (RFC 8032 §5.1.7). A signature of the
		// wrong length, an S outside [0, L), or an R that does not decode
		// to a curve point is rejected.
		def verify(message byte[], signature byte[]) bool {
			return false when signature.len() != 64
			let s = scalarFromBytes(signature[32:64])
			return false when s >= edL
			let r = decodeEdPoint(signature[0:32])
			return false when r is none
			let k = hashScalar(signature[0:32] + bytes + message)
			let lhs = edScalarMult(s, edBasePoint())
			let rhs = edAdd(r, edScalarMult(k, point))
			return edSame(lhs, rhs)
		}
	}

	// Ed25519PrivateKey signs messages deterministically from a 32-byte
	// seed (RFC 8032, pure Ed25519). The curve arithmetic underneath is
	// not constant time, matching the rest of this module.
	type Ed25519PrivateKey {
		seed            byte[]
		public          Ed25519PublicKey
		internal s      bigint
		internal prefix byte[]

		def new(seed byte[], public Ed25519PublicKey, s bigint, prefix byte[]) {
			self.seed = seed
			self.public = public
			self.s = s
			self.prefix = prefix
		}

		// sign returns the deterministic Ed25519 signature over message
		// (RFC 8032 §5.1.6). Signing draws no randomness and cannot fail.
		def sign(message byte[]) byte[] {
			let r = hashScalar(prefix + message)
			let rBytes = encodeEdPoint(edScalarMult(r, edBasePoint()))
			let k = hashScalar(rBytes + public.bytes + message)
			let sOut = (r + k * s).mod(edL)
			return rBytes + scalarToBytes(sOut)
		}
	}

	// newEd25519PrivateKey derives a key pair from a 32-byte seed (RFC
	// 8032 §5.1.5): SHA-512(seed) splits into a clamped scalar and a nonce
	// prefix, and the scalar's public point is the matching public key.
	// Fails when the seed is not 32 bytes.
	def newEd25519PrivateKey(seed byte[]) !Ed25519PrivateKey {
		expects {
			assert seed.len() == 32 onerror fail "ed25519: seed must be 32 bytes"
		}
		let h = digest(Hash.SHA512, seed)
		let a = byte[] + h[0:32]
		a[0] &= 248
		a[31] &= 127
		a[31] |= 64
		let s = scalarFromBytes(a)
		let prefix = h[32:64].clone()
		let point = edScalarMult(s, edBasePoint())
		let public = new Ed25519PublicKey(encodeEdPoint(point), point)
		return new Ed25519PrivateKey(seed, public, s, prefix)
	}

	// newEd25519PublicKey reads a 32-byte compressed point (RFC 8032
	// §5.1.3). Fails when the length is wrong or the bytes do not decode
	// to a point on the curve.
	def newEd25519PublicKey(bytes byte[]) !Ed25519PublicKey {
		expects {
			assert bytes.len() == 32 onerror fail "ed25519: public key must be 32 bytes"
		}
		let point = decodeEdPoint(bytes)
		fail "ed25519: public key does not decode to a curve point" when point is none
		return new Ed25519PublicKey(bytes, point)
	}

	// generateEd25519Key draws a fresh seed from the system random source
	// and derives its key pair. Fails when the random source is
	// unavailable.
	def generateEd25519Key() !Ed25519PrivateKey {
		return try newEd25519PrivateKey(try rand(32))
	}
}
