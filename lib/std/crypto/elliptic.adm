partial module std.crypto {
	// curve is the parameters of a short Weierstrass curve y² = x³ + ax + b
	// over the prime field of p: the order n of the base point (gx, gy),
	// the size in bits and the name. a is -3 for the NIST curves and 0 for
	// secp256k1.
	struct curve {
		p, n, a, b, gx, gy bigint
		bitsize            int
		name               string
	}

	// Point is an affine point on a curve; x = y = 0 stands for the point
	// at infinity, which no curve here contains.
	struct Point {
		x, y bigint
	}

	let (
		// p224 is the NIST P-224 curve.
		p224 = curve{
			p:       26959946667150639794667015087019630673557916260026308143510066298881,
			n:       bigint(26959946667150639794667015087019625940457807714424391721682722368061),
			a:       bigint(-3),
			b:       bigint(0xb4050a850c04b3abf54132565044b0b7d7bfd8ba270b39432355ffb4),
			gx:      bigint(0xb70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21),
			gy:      bigint(0xbd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34),
			bitsize: 224,
			name:    "P-224",
		}

		// p256 is the NIST P-256 curve (secp256r1, prime256v1).
		p256 = curve{
			p:       bigint(0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff),
			n:       bigint(0xffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551),
			a:       bigint(-3),
			b:       bigint(0x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b),
			gx:      bigint(0x6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296),
			gy:      bigint(0x4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5),
			bitsize: 256,
			name:    "P-256",
		}

		// p384 is the NIST P-384 curve (secp384r1).
		p384 = curve{
			p:       bigint(0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff),
			n:       bigint(0xffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973),
			a:       bigint(-3),
			b:       bigint(0xb3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef),
			gx:      bigint(0xaa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7),
			gy:      bigint(0x3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f),
			bitsize: 384,
			name:    "P-384",
		}

		// p521 is the NIST P-521 curve (secp521r1).
		p521 = curve{
			p:       bigint(0x1ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff),
			n:       bigint(0x1fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffa51868783bf2f966b7fcc0148f709a5d03bb5c9b8899c47aebb6fb71e91386409),
			a:       bigint(-3),
			b:       bigint(0x051953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef109e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b503f00),
			gx:      bigint(0xc6858e06b70404e9cd9e3ecb662395b4429c648139053fb521f828af606b4d3dbaa14b5e77efe75928fe1dc127a2ffa8de3348b3c1856a429bf97e7e31c2e5bd66),
			gy:      bigint(0x11839296a789a3bc0045c8a5fb42c7d1bd998f54449579b446817afbd17273e662c97ee72995ef42640c550b9013fad0761353c7086a272c24088be94769fd16650),
			bitsize: 521,
			name:    "P-521",
		}
	)

	// The Brainpool curves of RFC 5639 (random primes, a ≠ -3), for
	// OpenPGP and TLS peers that use them.
	let (
		// brainpoolP256r1 is brainpoolP256r1 (RFC 5639).
		brainpoolP256r1 = curve{
			p:       bigint(0xa9fb57dba1eea9bc3e660a909d838d726e3bf623d52620282013481d1f6e5377),
			n:       bigint(0xa9fb57dba1eea9bc3e660a909d838d718c397aa3b561a6f7901e0e82974856a7),
			a:       bigint(0x7d5a0975fc2c3057eef67530417affe7fb8055c126dc5c6ce94a4b44f330b5d9),
			b:       bigint(0x26dc5c6ce94a4b44f330b5d9bbd77cbf958416295cf7e1ce6bccdc18ff8c07b6),
			gx:      bigint(0x8bd2aeb9cb7e57cb2c4b482ffc81b7afb9de27e1e3bd23c23a4453bd9ace3262),
			gy:      bigint(0x547ef835c3dac4fd97f8461a14611dc9c27745132ded8e545c1d54c72f046997),
			bitsize: 256,
			name:    "brainpoolP256r1",
		}

		// brainpoolP384r1 is brainpoolP384r1 (RFC 5639).
		brainpoolP384r1 = curve{
			p:       bigint(0x8cb91e82a3386d280f5d6f7e50e641df152f7109ed5456b412b1da197fb71123acd3a729901d1a71874700133107ec53),
			n:       bigint(0x8cb91e82a3386d280f5d6f7e50e641df152f7109ed5456b31f166e6cac0425a7cf3ab6af6b7fc3103b883202e9046565),
			a:       bigint(0x7bc382c63d8c150c3c72080ace05afa0c2bea28e4fb22787139165efba91f90f8aa5814a503ad4eb04a8c7dd22ce2826),
			b:       bigint(0x04a8c7dd22ce28268b39b55416f0447c2fb77de107dcd2a62e880ea53eeb62d57cb4390295dbc9943ab78696fa504c11),
			gx:      bigint(0x1d1c64f068cf45ffa2a63a81b7c13f6b8847a3e77ef14fe3db7fcafe0cbd10e8e826e03436d646aaef87b2e247d4af1e),
			gy:      bigint(0x8abe1d7520f9c2a45cb1eb8e95cfd55262b70b29feec5864e19c054ff99129280e4646217791811142820341263c5315),
			bitsize: 384,
			name:    "brainpoolP384r1",
		}

		// brainpoolP512r1 is brainpoolP512r1 (RFC 5639).
		brainpoolP512r1 = curve{
			p:       bigint(0xaadd9db8dbe9c48b3fd4e6ae33c9fc07cb308db3b3c9d20ed6639cca703308717d4d9b009bc66842aecda12ae6a380e62881ff2f2d82c68528aa6056583a48f3),
			n:       bigint(0xaadd9db8dbe9c48b3fd4e6ae33c9fc07cb308db3b3c9d20ed6639cca70330870553e5c414ca92619418661197fac10471db1d381085ddaddb58796829ca90069),
			a:       bigint(0x7830a3318b603b89e2327145ac234cc594cbdd8d3df91610a83441caea9863bc2ded5d5aa8253aa10a2ef1c98b9ac8b57f1117a72bf2c7b9e7c1ac4d77fc94ca),
			b:       bigint(0x3df91610a83441caea9863bc2ded5d5aa8253aa10a2ef1c98b9ac8b57f1117a72bf2c7b9e7c1ac4d77fc94cadc083e67984050b75ebae5dd2809bd638016f723),
			gx:      bigint(0x81aee4bdd82ed9645a21322e9c4c6a9385ed9f70b5d916c1b43b62eef4d0098eff3b1f78e2d0d48d50d1687b93b97d5f7c6d5047406a5e688b352209bcb9f822),
			gy:      bigint(0x7dde385d566332ecc0eabfa9cf7822fdf209f70024a57b1aa000c55b881f8111b2dcde494a5f485e5bca4bd88a2763aed1ca2b2fa8f0540678cd1e0f3ad80892),
			bitsize: 512,
			name:    "brainpoolP512r1",
		}
	)

	// secp256k1 is the SEC 2 Koblitz curve y² = x³ + 7 (ES256K in JOSE,
	// RFC 8812).
	let secp256k1 = curve{
		p:       bigint(0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f),
		n:       bigint(0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141),
		a:       bigint(0),
		b:       bigint(7),
		gx:      bigint(0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798),
		gy:      bigint(0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8),
		bitsize: 256,
		name:    "secp256k1",
	}

	// polynomial returns x³ - 3x + b, the right side of a NIST curve.
	def polynomial(x, b bigint) bigint {
		return (x ** 3) - (3 * x) + b
	}

	// infinity is the point at infinity.
	def infinity() Point {
		return Point{x: bigint(0), y: bigint(0)}
	}

	// isInfinity reports whether the point is the point at infinity.
	def isInfinity(pt Point) bool {
		return pt.x.isZero() && pt.y.isZero()
	}

	// basePoint is the curve's generator.
	def basePoint(c curve) Point {
		return Point{x: c.gx, y: c.gy}
	}

	// isOnCurve reports whether the point satisfies the curve equation with
	// both coordinates in range. The point at infinity is not on the curve.
	def isOnCurve(c curve, pt Point) bool {
		return false when isInfinity(pt)
		return false when pt.x.sign() < 0 || pt.y.sign() < 0 || pt.x >= c.p || pt.y >= c.p
		let lhs = (pt.y * pt.y).mod(c.p)
		let rhs = (pt.x ** 3 + c.a * pt.x + c.b).mod(c.p)
		return lhs == rhs
	}

	// addPoints returns p + q in affine coordinates. The arithmetic runs in
	// variable time, which is fine for public data such as signature
	// verification and key agreement with an ephemeral key.
	def addPoints(c curve, p, q Point) Point {
		return q when isInfinity(p)
		return p when isInfinity(q)
		if p.x == q.x {
			return infinity() when (p.y + q.y).mod(c.p).isZero()
			return doublePoint(c, p)
		}
		let inv = (q.x - p.x).mod(c.p).modInverse(c.p)
		return infinity() when inv is none
		let lambda = ((q.y - p.y) * inv).mod(c.p)
		let x3 = (lambda * lambda - p.x - q.x).mod(c.p)
		let y3 = (lambda * (p.x - x3) - p.y).mod(c.p)
		return Point{x: x3, y: y3}
	}

	// doublePoint returns 2p.
	def doublePoint(c curve, p Point) Point {
		return p when isInfinity(p)
		return infinity() when p.y.isZero()
		let inv = (2 * p.y).mod(c.p).modInverse(c.p)
		return infinity() when inv is none
		let lambda = ((3 * p.x * p.x + c.a) * inv).mod(c.p)
		let x3 = (lambda * lambda - 2 * p.x).mod(c.p)
		let y3 = (lambda * (p.x - x3) - p.y).mod(c.p)
		return Point{x: x3, y: y3}
	}

	// scalarMult returns k times the point, by double-and-add over the bits
	// of k. The sum runs in Jacobian coordinates (x = X/Z², y = Y/Z³), so
	// the one field inversion is at the end instead of one per step.
	def scalarMult(c curve, pt Point, k bigint) Point {
		return infinity() when isInfinity(pt)
		let p = c.p
		let nistA = c.a == bigint(-3)
		let (x, y, z) = (bigint(0), bigint(1), bigint(0))
		for let i = k.bitLen() - 1; i >= 0; i-- {
			if !z.isZero() {
				// Doubling (dbl-2001-b), alpha = 3x² + aZ⁴, which factors for a = -3.
				let delta = (z * z).mod(p)
				let gamma = (y * y).mod(p)
				let beta = (x * gamma).mod(p)
				let alpha = nistA ?? ((3 * (x - delta) * (x + delta)).mod(p), (3 * x * x + c.a * delta * delta).mod(p))
				let x3 = (alpha * alpha - 8 * beta).mod(p)
				let z3 = ((y + z) * (y + z) - gamma - delta).mod(p)
				let y3 = (alpha * (4 * beta - x3) - 8 * gamma * gamma).mod(p)
				(x, y, z) = (x3, y3, z3)
			}
			continue unless k.bit(i)
			if z.isZero() {
				(x, y, z) = (pt.x, pt.y, bigint(1))
				continue
			}
			// Adding the affine point (madd-2007-bl).
			let z1z1 = (z * z).mod(p)
			let u2 = (pt.x * z1z1).mod(p)
			let s2 = (pt.y * z * z1z1).mod(p)
			let h = (u2 - x).mod(p)
			let r = (2 * (s2 - y)).mod(p)
			if h.isZero() {
				if !r.isZero() {
					// The opposite point: the sum is the point at infinity.
					(x, y, z) = (bigint(0), bigint(1), bigint(0))
					continue
				}
				// The same point: double it.
				let delta = z1z1
				let gamma = (y * y).mod(p)
				let beta = (x * gamma).mod(p)
				let alpha = nistA ?? ((3 * (x - delta) * (x + delta)).mod(p), (3 * x * x + c.a * delta * delta).mod(p))
				let x3 = (alpha * alpha - 8 * beta).mod(p)
				let z3 = ((y + z) * (y + z) - gamma - delta).mod(p)
				let y3 = (alpha * (4 * beta - x3) - 8 * gamma * gamma).mod(p)
				(x, y, z) = (x3, y3, z3)
				continue
			}
			let hh = (h * h).mod(p)
			let i4 = (4 * hh).mod(p)
			let j = (h * i4).mod(p)
			let v = (x * i4).mod(p)
			let x3 = (r * r - j - 2 * v).mod(p)
			let y3 = (r * (v - x3) - 2 * y * j).mod(p)
			let z3 = ((z + h) * (z + h) - z1z1 - hh).mod(p)
			(x, y, z) = (x3, y3, z3)
		}
		return infinity() when z.isZero()
		let zi = z.modInverse(p)
		return infinity() when zi is none
		let zi2 = (zi * zi).mod(p)
		return Point{x: (x * zi2).mod(p), y: (y * zi2 * zi).mod(p)}
	}

	// scalarBaseMult returns k times the base point.
	def scalarBaseMult(c curve, k bigint) Point {
		return scalarMult(c, basePoint(c), k)
	}

	// coordinateSize is the byte length of one coordinate.
	def coordinateSize(c curve) int {
		return (c.bitsize + 7) / 8
	}

	// marshalPoint is the uncompressed SEC 1 form: 0x04, then x and y as
	// fixed-width big-endian coordinates.
	def marshalPoint(c curve, pt Point) byte[] {
		let size = coordinateSize(c)
		let xb = pt.x.bytes(size) onerror recover []
		let yb = pt.y.bytes(size) onerror recover []
		return byte[4] + xb + yb
	}

	// unmarshalPoint reads the uncompressed SEC 1 form. Fails when the
	// prefix or length is wrong or the point is not on the curve.
	def unmarshalPoint(c curve, data byte[]) !Point {
		expects {
			assert data.len() == 1 + 2 * coordinateSize(c) onerror fail "elliptic: point has the wrong length"
			assert data[0] == 4 onerror fail "elliptic: only uncompressed points are supported"
		}
		let size = coordinateSize(c)
		let pt = Point{x: parseBigInt(data[1:1 + size]), y: parseBigInt(data[1 + size:])}
		fail "elliptic: point is not on the curve" unless isOnCurve(c, pt)
		return pt
	}

	// ecdhKeyPair draws a random private scalar in [1, n) and returns it
	// with its public point. Fails when the random source is unavailable.
	def ecdhKeyPair(c curve) !ECDHKeyPair {
		let size = coordinateSize(c)
		let k = parseBigInt(try rand(size + 8)).mod(c.n - 1) + 1
		return ECDHKeyPair{scalar: k, public: scalarBaseMult(c, k)}
	}

	// ECDHKeyPair is an ephemeral key for elliptic-curve Diffie-Hellman.
	struct ECDHKeyPair {
		scalar bigint
		public Point
	}

	// ecdh returns the shared x-coordinate of scalar times the peer's point
	// as a fixed-width big-endian value, the TLS convention.
	// Fails when the peer's point is not on the curve or the product is the
	// point at infinity.
	def ecdh(c curve, scalar bigint, peer Point) !byte[] {
		expects {
			assert isOnCurve(c, peer) onerror fail "elliptic: peer point is not on the curve"
		}
		let shared = scalarMult(c, peer, scalar)
		fail "elliptic: shared point is at infinity" when isInfinity(shared)
		return try shared.x.bytes(coordinateSize(c))
	}
}
