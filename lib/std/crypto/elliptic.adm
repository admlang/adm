partial module std.crypto {
	// curve is the parameters of a short Weierstrass curve y² = x³ - 3x + b
	// over the prime field of p: the order n of the base point (gx, gy),
	// the size in bits and the name.
	struct curve {
		p, n, b, gx, gy bigint
		bitsize         int
		name            string
	}

	// Point is an affine point on a curve; x = y = 0 stands for the point
	// at infinity, which no curve here contains.
	struct Point {
		x, y bigint
	}

	let (
		// p224 is the NIST P-224 curve.
		p224 = curve{
			p: 26959946667150639794667015087019630673557916260026308143510066298881,
			n: bigint(26959946667150639794667015087019625940457807714424391721682722368061),
			b: bigint(0xb4050a850c04b3abf54132565044b0b7d7bfd8ba270b39432355ffb4),
			gx: bigint(0xb70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21),
			gy: bigint(0xbd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34),
			bitsize: 224,
			name: "P-224",
		}

		// p256 is the NIST P-256 curve (secp256r1, prime256v1).
		p256 = curve{
			p: bigint(0xffffffff00000001000000000000000000000000ffffffffffffffffffffffff),
			n: bigint(0xffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551),
			b: bigint(0x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b),
			gx: bigint(0x6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296),
			gy: bigint(0x4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5),
			bitsize: 256,
			name: "P-256",
		}

		// p384 is the NIST P-384 curve (secp384r1).
		p384 = curve{
			p: bigint(0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff),
			n: bigint(0xffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973),
			b: bigint(0xb3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef),
			gx: bigint(0xaa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7),
			gy: bigint(0x3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f),
			bitsize: 384,
			name: "P-384",
		}
	)

	// polynomial returns x³ - 3x + b.
	def polynomial(x, b bigint) bigint {
		return (x ** 3) - (3 * x) + b
	}

	// infinity is the point at infinity.
	def infinity() Point {
		return Point{x: bigint(0), y: bigint(0)}
	}

	// isInfinity reports whether the point is the point at infinity.
	def isInfinity(pt Point) bool {
		return pt.x.isZero() && pt.y.isZero()
	}

	// basePoint is the curve's generator.
	def basePoint(c curve) Point {
		return Point{x: c.gx, y: c.gy}
	}

	// isOnCurve reports whether the point satisfies the curve equation with
	// both coordinates in range. The point at infinity is not on the curve.
	def isOnCurve(c curve, pt Point) bool {
		return false when isInfinity(pt)
		return false when pt.x.sign() < 0 || pt.y.sign() < 0 || pt.x >= c.p || pt.y >= c.p
		let lhs = (pt.y * pt.y).mod(c.p)
		let rhs = polynomial(pt.x, c.b).mod(c.p)
		return lhs == rhs
	}

	// addPoints returns p + q in affine coordinates. The arithmetic runs in
	// variable time, which is fine for public data such as signature
	// verification and key agreement with an ephemeral key.
	def addPoints(c curve, p, q Point) Point {
		return q when isInfinity(p)
		return p when isInfinity(q)
		if p.x == q.x {
			return infinity() when (p.y + q.y).mod(c.p).isZero()
			return doublePoint(c, p)
		}
		let inv = (q.x - p.x).mod(c.p).modInverse(c.p)
		return infinity() when inv is none
		let lambda = ((q.y - p.y) * inv).mod(c.p)
		let x3 = (lambda * lambda - p.x - q.x).mod(c.p)
		let y3 = (lambda * (p.x - x3) - p.y).mod(c.p)
		return Point{x: x3, y: y3}
	}

	// doublePoint returns 2p.
	def doublePoint(c curve, p Point) Point {
		return p when isInfinity(p)
		return infinity() when p.y.isZero()
		let inv = (2 * p.y).mod(c.p).modInverse(c.p)
		return infinity() when inv is none
		let lambda = ((3 * p.x * p.x - 3) * inv).mod(c.p)
		let x3 = (lambda * lambda - 2 * p.x).mod(c.p)
		let y3 = (lambda * (p.x - x3) - p.y).mod(c.p)
		return Point{x: x3, y: y3}
	}

	// scalarMult returns k times the point, by double-and-add over the bits
	// of k.
	def scalarMult(c curve, pt Point, k bigint) Point {
		let acc = infinity()
		for let i = k.bitLen() - 1; i >= 0; i-- {
			acc = doublePoint(c, acc)
			acc = addPoints(c, acc, pt) when k.bit(i)
		}
		return acc
	}

	// scalarBaseMult returns k times the base point.
	def scalarBaseMult(c curve, k bigint) Point {
		return scalarMult(c, basePoint(c), k)
	}

	// coordinateSize is the byte length of one coordinate.
	def coordinateSize(c curve) int {
		return (c.bitsize + 7) / 8
	}

	// marshalPoint is the uncompressed SEC 1 form: 0x04, then x and y as
	// fixed-width big-endian coordinates.
	def marshalPoint(c curve, pt Point) byte[] {
		let size = coordinateSize(c)
		let xb = pt.x.bytes(size) onerror recover []
		let yb = pt.y.bytes(size) onerror recover []
		return byte[4] + xb + yb
	}

	// unmarshalPoint reads the uncompressed SEC 1 form. Fails when the
	// prefix or length is wrong or the point is not on the curve.
	def unmarshalPoint(c curve, data byte[]) !Point {
		expects {
			assert data.len() == 1 + 2 * coordinateSize(c) onerror fail "elliptic: point has the wrong length"
			assert data[0] == 4 onerror fail "elliptic: only uncompressed points are supported"
		}
		let size = coordinateSize(c)
		let pt = Point{x: parseBigInt(data[1:1 + size]), y: parseBigInt(data[1 + size:])}
		fail "elliptic: point is not on the curve" unless isOnCurve(c, pt)
		return pt
	}

	// ecdhKeyPair draws a random private scalar in [1, n) and returns it
	// with its public point. Fails when the random source is unavailable.
	def ecdhKeyPair(c curve) !ECDHKeyPair {
		let size = coordinateSize(c)
		let k = parseBigInt(try rand(size + 8)).mod(c.n - 1) + 1
		return ECDHKeyPair{scalar: k, public: scalarBaseMult(c, k)}
	}

	// ECDHKeyPair is an ephemeral key for elliptic-curve Diffie-Hellman.
	struct ECDHKeyPair {
		scalar bigint
		public Point
	}

	// ecdh returns the shared x-coordinate of scalar times the peer's point
	// as a fixed-width big-endian value, the TLS convention.
	// Fails when the peer's point is not on the curve or the product is the
	// point at infinity.
	def ecdh(c curve, scalar bigint, peer Point) !byte[] {
		expects {
			assert isOnCurve(c, peer) onerror fail "elliptic: peer point is not on the curve"
		}
		let shared = scalarMult(c, peer, scalar)
		fail "elliptic: shared point is at infinity" when isInfinity(shared)
		return try shared.x.bytes(coordinateSize(c))
	}
}
