partial module std.crypto {
	use std.testing

	check "Elliptic" {
		@test()
		def TestCurveBasePoints() {
			assert isOnCurve(p256, basePoint(p256))
			assert isOnCurve(p384, basePoint(p384))
			assert isOnCurve(p224, basePoint(p224))
			assert !isOnCurve(p256, infinity())
			// The order annihilates the generator.
			assert isInfinity(scalarBaseMult(p256, p256.n))
			assert isInfinity(scalarBaseMult(p384, p384.n))
			// 2G by doubling equals G + G and 2 * G.
			let g = basePoint(p256)
			let twice = doublePoint(p256, g)
			assert isOnCurve(p256, twice)
			assert addPoints(p256, g, g).x == twice.x
			assert scalarBaseMult(p256, bigint(2)).y == twice.y
			assert twice.x.hex() == "7cf27b188d034f7e8a52380304b51ac3c08969e277f21b35a60b48fc47669978"
			assert scalarMult(p256, g, bigint(3)).x == addPoints(p256, twice, g).x
			assert coordinateSize(p256) == 32 && coordinateSize(p384) == 48 && coordinateSize(p224) == 28
			assert polynomial(bigint(2), bigint(1)) == 3
		}

		@test()
		def TestPointMarshal() !none {
			let pt = scalarBaseMult(p256, bigint(12345))
			let enc = marshalPoint(p256, pt)
			assert enc.len() == 65
			assert enc[0] == 4
			let back = try unmarshalPoint(p256, enc)
			assert back.x == pt.x && back.y == pt.y
			enc[10] ^= 1
			let off = unmarshalPoint(p256, enc) onerror recover infinity()
			assert isInfinity(off)
		}

		@test()
		def TestECDH() !none {
			let a = try ecdhKeyPair(p256)
			let b = try ecdhKeyPair(p256)
			assert isOnCurve(p256, a.public) && isOnCurve(p256, b.public)
			let ab = try ecdh(p256, a.scalar, b.public)
			let ba = try ecdh(p256, b.scalar, a.public)
			assert ab.len() == 32
			assert ab.hex() == ba.hex()
		}
	
		// RFC 7027 Appendix A: the Brainpool key pairs and shared secrets.
		@test()
		def TestBrainpoolECDH() !none {
			let vectors = [
				(brainpoolP256r1, "81DB1EE100150FF2EA338D708271BE38300CB54241D79950F77B063039804F1D", "44106E913F92BC02A1705D9953A8414DB95E1AAA49E81D9E85F929A8E3100BE5", "8AB4846F11CACCB73CE49CBDD120F5A900A69FD32C272223F789EF10EB089BDC", "8D2D688C6CF93E1160AD04CC4429117DC2C41825E1E9FCA0ADDD34E6F1B39F7B", "990C57520812BE512641E47034832106BC7D3E8DD0E4C7F1136D7006547CEC6A", "89AFC39D41D3B327814B80940B042590F96556EC91E6AE7939BCE31F3A18BF2B"),
				(brainpoolP384r1, "1E20F5E048A5886F1F157C74E91BDE2B98C8B52D58E5003D57053FC4B0BD65D6F15EB5D1EE1610DF870795143627D042", "68B665DD91C195800650CDD363C625F4E742E8134667B767B1B476793588F885AB698C852D4A6E77A252D6380FCAF068", "55BC91A39C9EC01DEE36017B7D673A931236D2F1F5C83942D049E3FA20607493E0D038FF2FD30C2AB67D15C85F7FAA59", "4D44326F269A597A5B58BBA565DA5556ED7FD9A8A9EB76C25F46DB69D19DC8CE6AD18E404B15738B2086DF37E71D1EB4", "62D692136DE56CBE93BF5FA3188EF58BC8A3A0EC6C1E151A21038A42E9185329B5B275903D192F8D4E1F32FE9CC78C48", "0BD9D3A7EA0B3D519D09D8E48D0785FB744A6B355E6304BC51C229FBBCE239BBADF6403715C35D4FB2A5444F575D4F42"),
				(brainpoolP512r1, "16302FF0DBBB5A8D733DAB7141C1B45ACBC8715939677F6A56850A38BD87BD59B09E80279609FF333EB9D4C061231FB26F92EEB04982A5F1D1764CAD57665422", "0A420517E406AAC0ACDCE90FCD71487718D3B953EFD7FBEC5F7F27E28C6149999397E91E029E06457DB2D3E640668B392C2A7E737A7F0BF04436D11640FD09FD", "72E6882E8DB28AAD36237CD25D580DB23783961C8DC52DFA2EC138AD472A0FCEF3887CF62B623B2A87DE5C588301EA3E5FC269B373B60724F5E82A6AD147FDE7", "9D45F66DE5D67E2E6DB6E93A59CE0BB48106097FF78A081DE781CDB31FCE8CCBAAEA8DD4320C4119F1E9CD437A2EAB3731FA9668AB268D871DEDA55A5473199F", "2FDC313095BCDD5FB3A91636F07A959C8E86B5636A1E930E8396049CB481961D365CC11453A06C719835475B12CB52FC3C383BCE35E27EF194512B71876285FA", "A7927098655F1F9976FA50A9D566865DC530331846381C87256BAF3226244B76D36403C024D7BBF0AA0803EAFF405D3D24F11A9B5C0BEF679FE1454B21C4CD1F"),
			]
			for let vec in vectors {
				let (c, dA, xA, yA, xB, yB, xZ) = vec
				let d = try parseBigInt(dA, 16)
				let qa = scalarBaseMult(c, d)
				assert qa.x == (try parseBigInt(xA, 16)) && qa.y == (try parseBigInt(yA, 16))
				let qb = Point{x: try parseBigInt(xB, 16), y: try parseBigInt(yB, 16)}
				assert isOnCurve(c, qb)
				assert scalarMult(c, qb, d).x == (try parseBigInt(xZ, 16))
				let named = curveByOID(oidOfCurve(c))
				assert !(named is none) && named.name == c.name
			}
			return none
		}
	}
}
