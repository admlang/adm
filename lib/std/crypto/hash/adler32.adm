partial module std.crypto.hash {
	internal const (
		mod  = 65521
		nmax = 5552
		size = 4
	)

	// addler32Update folds p into a running Adler-32 checksum and returns the new
	// value.
	def addler32Update(crc uint32, p byte[]) uint32 {
		let s1, s2 = uint32(crc & 0xffff), uint32(crc >> 16)
		for p.len() > 0 {
			let q byte[]
			if p.len() > nmax {
				p, q = p[:nmax], p[nmax:]
			}
			for p.len() >= 4 {
				s1 += uint32(p[0])
				s2 += s1
				s1 += uint32(p[1])
				s2 += s1
				s1 += uint32(p[2])
				s2 += s1
				s1 += uint32(p[3])
				s2 += s1
				p = p[4:]
			}
			for let (_, x) in p {
				s1 += uint32(x)
				s2 += s1
			}
			s1 %= mod
			s2 %= mod
			p = q
		}
		return uint32(s2 << 16 | s1)
	}

	// Adler32 computes the Adler-32 checksum zlib uses, as a Hasher: write feeds
	// bytes, hash returns the 4-byte big-endian sum.
	type Adler32 {
		checksum uint32 = 1

		def new() {
			reset()
		}

		// write feeds the bytes into the checksum and returns how many.
		def write(buf byte[]) int {
			checksum = addler32Update(checksum, buf)
			return buf.len()
		}

		// hash feeds data, when given, and returns the checksum as 4 big-endian
		// bytes.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			return [byte(checksum >> 24), byte(checksum >> 16), byte(checksum >> 8), byte(checksum)]
		}

		// reset restarts the checksum.
		def reset() {
			checksum = 1
		}
	}

	// adler32 returns the Adler-32 checksum of the bytes.
	def adler32(data byte[]) uint32 {
		let hasher = new Adler32()
		hasher.write(data)
		return uint32(0).fromBytes(hasher.hash())
	}
}
