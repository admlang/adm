partial module std.crypto.hash {
	use std.testing

	check "Adler-32" {
		@test()
		def matches_zlib() {
			// Expected values are Python's zlib.adler32.
			let d byte[]
			d.len(20000)
			for let i = 0; i < d.len(); i++ {
				d[i] = byte((i * 7 + i / 300) & 255)
			}
			assert adler32(d) == uint32(1870718983)
			assert adler32(d[:5553]) == uint32(1539099661)
			let ones byte[]
			ones.len(6000)
			ones[:] = byte(255)
			assert adler32(ones) == uint32(2761382378)
			assert adler32([]) == uint32(1)
			// Fed in pieces that split the 16-byte blocks and the 5552-byte chunks.
			let h = new Adler32()
			h.write(d[:5])
			h.write(d[5:5560])
			h.write(d[5560:])
			assert h.checksum == uint32(1870718983)
		}
	}
}
