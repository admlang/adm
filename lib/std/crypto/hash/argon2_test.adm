partial module std.crypto.hash {
	use (
		std.testing
		std.data.encoding::(hexdecode)
	)

	check "Argon2" {
		// The three vectors of RFC 9106 §5: 32 bytes of 0x01 as the password,
		// 16 of 0x02 as the salt, 8 of 0x03 as the secret, 12 of 0x04 as the
		// associated data; 32 KiB, 3 passes, 4 lanes, a 32-byte tag.
		@test()
		def matchesRfc9106() !none {
			let password = repeated(0x01, 32)
			let salt = repeated(0x02, 16)
			let secret = repeated(0x03, 8)
			let associated = repeated(0x04, 12)
			let d = try argon2(Argon2Kind.Argon2d, password, salt, 32, 3, 4, 32, secret, associated)
			assert d.equals(try hexdecode("512b391b6f1162975371d30919734294f868e3be3984f3c1a13a4db9fabe4acb"))
			let i = try argon2(Argon2Kind.Argon2i, password, salt, 32, 3, 4, 32, secret, associated)
			assert i.equals(try hexdecode("c814d9d1dc7f37aa13f0d77f2494bda1c8de6b016dd388d29952a4c4672b6ce8"))
			let id = try argon2id(password, salt, 32, 3, 4, 32, secret, associated)
			assert id.equals(try hexdecode("0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659"))
		}

		// One lane runs inline; a tag longer than 64 bytes takes H' chained;
		// both against OpenSSL 3.5.
		@test()
		def oneLaneAndLongTagsMatchOpenssl() !none {
			let one = try argon2id("password".bytes(), "somesalt".bytes(), 8, 2, 1, 32)
			assert one.equals(try hexdecode("fdb4ddb6d5887131b66f0b2a3740c077dd05b755845861f6b5a1dde8b1071646"))
			let long = try argon2id("password".bytes(), "somesalt".bytes(), 16, 1, 2, 80)
			assert long.equals(try hexdecode("25c18da1e8f32916bc246b8b79ceb45b300ea9060196b02bbee08b15903e55600d63917bad9bab582abb218785d9d6fca3fb800e6b39c11158cc7e4fee787b6e8ef745b1950095a1420f563461af430f"))
		}

		@test()
		def refusesBadParameters() {
			let short = argon2id("p".bytes(), "salt".bytes(), 8, 1, 1, 32) onerror recover byte[]
			assert short.len() == 0
			let tiny = argon2id("p".bytes(), "somesalt".bytes(), 8, 1, 1, 3) onerror recover byte[]
			assert tiny.len() == 0
			let noPass = argon2id("p".bytes(), "somesalt".bytes(), 8, 0, 1, 32) onerror recover byte[]
			assert noPass.len() == 0
			let starved = argon2id("p".bytes(), "somesalt".bytes(), 8, 1, 2, 32) onerror recover byte[]
			assert starved.len() == 0
		}
	}
}
