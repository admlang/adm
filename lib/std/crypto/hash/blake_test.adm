partial module std.crypto.hash {
	use std.testing

	check "BLAKE2" {
		@test()
		def blake2b512_vectors() {
			let h = new BLAKE2b512()
			assert h.hash().hex() == "786A02F742015903C6C6FD852552D272912F4740E15847618A86E217F71F5419D25E1031AFEE585313896444934EB04B903A685B1448B755D56F701AFE9BE2CE"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "BA80A53F981C4D0D6A2797B69F12F6E94C212F14685AC4B74B12BB6FDBFFA2D17D87C5392AAB792DC252D5DE4533CC9518D38AA8DBF1925AB92386EDD4009923"
		}

		@test()
		def blake2s256_vectors() {
			let h = new BLAKE2s256()
			assert h.hash().hex() == "69217A3079908094E11121D042354A7C1F55B6482CA1A51E1B250DFD1ED0EEF9"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "508C5E8C327C14E2E1A72BA34EEB452F37458B209ED63A294D999B4C86675982"
		}

		// A message that is an exact multiple of the block size is the case the
		// "hold the last block back" rule exists for.
		@test()
		def blake2_block_boundaries() {
			let msg byte[]
			for let i = 0; i < 256; i++ {
				msg.push(byte(i % 251))
			}

			let oneB = new BLAKE2b512()
			let wantB = oneB.hash(msg).hex()
			let manyB = new BLAKE2b512()
			let off = 0
			for off < msg.len() {
				let end = off + 17
				end = msg.len() when end > msg.len()
				manyB.write(msg[off:end])
				off = end
			}
			assert manyB.hash().hex() == wantB

			let oneS = new BLAKE2s256()
			let wantS = oneS.hash(msg).hex()
			let manyS = new BLAKE2s256()
			off = 0
			for off < msg.len() {
				let end = off + 17
				end = msg.len() when end > msg.len()
				manyS.write(msg[off:end])
				off = end
			}
			assert manyS.hash().hex() == wantS
		}
	}
}
