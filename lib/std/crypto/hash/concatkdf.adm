partial module std.crypto.hash {
	// concatKDF derives length bytes from a shared secret with the one-step
	// key derivation of NIST SP 800-56A §5.8.2.1 (Concat KDF), as ECDH-ES in
	// JOSE (RFC 7518 §4.6.2) and CMS use it: the digests of a 32-bit
	// big-endian counter from 1, the secret and otherInfo, joined and cut to
	// length. otherInfo carries the context both parties bind in, such as
	// the algorithm and party identities.
	//
	// ```
	// let key = try hash.concatKDF(hash.Hash.SHA256, sharedSecret, otherInfo, 16)
	// ```
	//
	// Fails when length is negative or would need more than 2^32 - 1
	// digests.
	def concatKDF(algorithm Hash, secret, otherInfo byte[], length int) !byte[] {
		expects {
			assert length >= 0 onerror fail "concatkdf: negative length"
			assert (length + hashSize(algorithm) - 1) / hashSize(algorithm) <= 0xFFFFFFFF onerror fail "concatkdf: length exceeds 2^32 - 1 digests"
		}
		let out byte[]
		let counter uint32 = 1
		for out.len() < length {
			let h = newHasher(algorithm)
			h.write(byte[byte(counter >> 24), byte((counter >> 16) & 0xFF), byte((counter >> 8) & 0xFF), byte(counter & 0xFF)])
			h.write(secret)
			out += h.hash(otherInfo)
			counter++
		}
		return out[0:length]
	}
}
