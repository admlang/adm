partial module std.crypto.hash {
	use (
		std.testing
		std.data.encoding::(hexdecode)
	)

	check "Concat KDF" {
		@test()
		def TestConcatKDFRFC7518() !none {
			// RFC 7518 Appendix C: ECDH-ES between Alice and Bob for A128GCM.
			let z = try hexdecode("9e56d91d817135d372834283bf84269cfb316ea3da806a48f6daa7798cfe90c4")
			let otherInfo = try hexdecode("000000074131323847434d" + "00000005416c696365" + "00000003426f62" + "00000080")
			assert (try concatKDF(Hash.SHA256, z, otherInfo, 16)).hex() == "56AA8DEAF8236D205C2228CD71A7101A"
			// Longer outputs continue the counter; shorter ones are prefixes.
			let long = try concatKDF(Hash.SHA256, z, otherInfo, 80)
			assert long.len() == 80
			assert long[0:16].hex() == "56AA8DEAF8236D205C2228CD71A7101A"
			let first = digest(Hash.SHA256, byte[0, 0, 0, 1] + z + otherInfo)
			let third = digest(Hash.SHA256, byte[0, 0, 0, 3] + z + otherInfo)
			assert long[0:32].hex() == first.hex()
			assert long[64:80].hex() == third[0:16].hex()
			assert (try concatKDF(Hash.SHA512, z, otherInfo, 0)).len() == 0
			let negative = concatKDF(Hash.SHA256, z, otherInfo, -1) onerror recover byte[1]
			assert negative.len() == 1
		}
	}
}
