partial module std.crypto.hash {
	// The standard CRC-8 polynomial (x^8 + x^2 + x + 1), reversed for bitwise iteration.
	const STANDARD = 0xE0

	// MODBUS CRC16 polynomial (0x8005), reversed for bitwise iteration.
	const MODBUS = 0xA001

	// IEEE CRC32 polynomial (reversed).
	const IEEE = 0xEDB88320

	def crc8Update(crc uint8, b byte) uint8 {
		crc = crc ^ uint8(b)
		for let i = 0; i < 8; i++ {
			if (crc & 1) == 1 {
				crc = (crc >> 1) ^ uint8(STANDARD)
			} else {
				crc = crc >> 1
			}
		}
		return crc
	}

	def crc16Update(crc uint16, b byte) uint16 {
		crc = crc ^ uint16(b)
		for let i = 0; i < 8; i++ {
			if (crc & 1) == 1 {
				crc = (crc >> 1) ^ uint16(MODBUS)
			} else {
				crc = crc >> 1
			}
		}
		return crc
	}

	def crc32Update(crc uint32, b byte) uint32 {
		crc = crc ^ uint32(b)
		for let i = 0; i < 8; i++ {
			if (crc & 1) == 1 {
				crc = (crc >> 1) ^ uint32(IEEE)
			} else {
				crc = crc >> 1
			}
		}
		return crc
	}

	type CRC8 {
		// checksum holds the running state of the hash.
		checksum uint8

		def new() {
			checksum = 0x00
		}

		def reset() {
            checksum = 0x00
        }

		def write(buf byte[]) int {
			for let (_, b) in buf {
				checksum = crc8Update(checksum, b)
			}
			return buf.len()
		}

		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}

			return byte[checksum]
		}
	}

	def crc16(data byte[]) uint8 {
        return crc16(0, data)
    }

    def crc16(crc uint8, data byte[]) uint8 {
        let hasher = new CRC8()
        hasher.checksum = crc
        hasher.write(data)
        return uint8(0).fromBytes(hasher.hash())
    }

	type CRC16 {
		// checksum holds the running state of the hash.
		checksum uint16

		def new() {
			// Standard MODBUS initial value.
			checksum = 0xFFFF
		}

		def reset() {
            checksum = 0xFFFF
        }


		def write(buf byte[]) int {
			for let (_, b) in buf {
				checksum = crc16Update(checksum, b)
			}
			return buf.len()
		}

		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}

			// Convert the final checksum to a little-endian byte array.
			return byte[
                byte(checksum & 0xFF),
                byte(checksum >> 8),
			]
		}
	}

	def crc16(data byte[]) uint16 {
	    let hasher = new CRC16()
	    hasher.write(data)
        return uint16(0).fromBytes(hasher.hash())
	}

	type CRC32 {
		// checksum holds the running state of the hash.
		checksum uint32

		def new() {
			checksum = 0xFFFFFFFF
		}

		def reset() {
			checksum = 0xFFFFFFFF
		}

		def write(buf byte[]) int {
			for let (_, b) in buf {
				checksum = crc32Update(checksum, b)
			}
			return buf.len()
		}

		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}

			// Finalize the checksum and convert to a byte array.
			checksum = checksum ^ 0xFFFFFFFF
			return byte[
                byte(checksum >> 24),
                byte(checksum >> 16),
                byte(checksum >> 8),
                byte(checksum),
			]
		}
	}

	def crc32(data byte[]) uint32 {
        let hasher = new CRC32()
        _ = hasher.write(data)
        return uint32(0).fromBytes(hasher.hash())
    }
}
