partial module std.crypto.hash {
	// The standard CRC-8 polynomial (x^8 + x^2 + x + 1), reversed for bitwise iteration.
	const STANDARD = 0xE0

	// MODBUS CRC16 polynomial (0x8005), reversed for bitwise iteration.
	const MODBUS = 0xA001

	// IEEE CRC32 polynomial (reversed).
	const IEEE = 0xEDB88320

	// crc8Update folds one byte into a running CRC-8 and returns the new value.
	def crc8Update(crc uint8, b byte) uint8 {
		crc = crc ^ uint8(b)
		for let i = 0; i < 8; i++ {
			if (crc & 1) == 1 {
				crc = (crc >> 1) ^ uint8(STANDARD)
			} else {
				crc = crc >> 1
			}
		}
		return crc
	}

	// crc16Update folds one byte into a running CRC-16 and returns the new value.
	def crc16Update(crc uint16, b byte) uint16 {
		crc = crc ^ uint16(b)
		for let i = 0; i < 8; i++ {
			if (crc & 1) == 1 {
				crc = (crc >> 1) ^ uint16(MODBUS)
			} else {
				crc = crc >> 1
			}
		}
		return crc
	}

	// crc32Update folds one byte into a running CRC-32 with the IEEE polynomial
	// and returns the new value.
	def crc32Update(crc uint32, b byte) uint32 {
		crc = crc ^ uint32(b)
		for let i = 0; i < 8; i++ {
			if (crc & 1) == 1 {
				crc = (crc >> 1) ^ uint32(IEEE)
			} else {
				crc = crc >> 1
			}
		}
		return crc
	}

	// CRC8 computes an 8-bit cyclic redundancy check, as a Hasher.
	type CRC8 {
		// checksum holds the running state of the hash.
		checksum uint8

		def new() {
			checksum = 0x00
		}

		// reset restarts the check.
		def reset() {
			checksum = 0x00
		}

		// write feeds the bytes into the check and returns how many.
		def write(buf byte[]) int {
			for let (_, b) in buf {
				checksum = crc8Update(checksum, b)
			}
			return buf.len()
		}

		// hash feeds data, when given, and returns the check as bytes.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}

			return byte[checksum]
		}
	}

	// crc16 returns the 8-bit check of the bytes, starting from 0.
	def crc16(data byte[]) uint8 {
		return crc16(0, data)
	}

	// crc16 continues an 8-bit check from crc over the bytes.
	def crc16(crc uint8, data byte[]) uint8 {
		let hasher = new CRC8()
		hasher.checksum = crc
		hasher.write(data)
		return uint8(0).fromBytes(hasher.hash())
	}

	// CRC16 computes a 16-bit cyclic redundancy check, as a Hasher.
	type CRC16 {
		// checksum holds the running state of the hash.
		checksum uint16

		def new() {
			// Standard MODBUS initial value.
			checksum = 0xFFFF
		}

		// reset restarts the check.
		def reset() {
			checksum = 0xFFFF
		}

		// write feeds the bytes into the check and returns how many.
		def write(buf byte[]) int {
			for let (_, b) in buf {
				checksum = crc16Update(checksum, b)
			}
			return buf.len()
		}

		// hash feeds data, when given, and returns the check as 2 bytes.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}

			// Convert the final checksum to a little-endian byte array.
			return byte[
				byte(checksum & 0xFF),
				byte(checksum >> 8),
			]
		}
	}

	// crc16 returns the 16-bit check of the bytes.
	def crc16(data byte[]) uint16 {
		let hasher = new CRC16()
		hasher.write(data)
		return uint16(0).fromBytes(hasher.hash())
	}

	// CRC32 computes the 32-bit cyclic redundancy check with the IEEE polynomial,
	// as a Hasher.
	type CRC32 {
		// checksum holds the running state of the hash.
		checksum uint32

		def new() {
			checksum = 0xFFFFFFFF
		}

		// reset restarts the check.
		def reset() {
			checksum = 0xFFFFFFFF
		}

		// write feeds the bytes into the check and returns how many.
		def write(buf byte[]) int {
			for let (_, b) in buf {
				checksum = crc32Update(checksum, b)
			}
			return buf.len()
		}

		// hash feeds data, when given, and returns the check as 4 bytes.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}

			// Finalize the checksum and convert to a byte array.
			checksum = checksum ^ 0xFFFFFFFF
			return byte[
				byte(checksum >> 24),
				byte(checksum >> 16),
				byte(checksum >> 8),
				byte(checksum),
			]
		}
	}

	// crc32 returns the IEEE CRC-32 of the bytes.
	def crc32(data byte[]) uint32 {
		let hasher = new CRC32()
		_ = hasher.write(data)
		return uint32(0).fromBytes(hasher.hash())
	}
}
