partial module std.crypto.hash {
	use (
		std.testing::*
	)

	// bitwise is the CRC-32C computed a bit at a time.
	internal def bitwise(data byte[]) uint32 {
		let c = uint32(0xFFFFFFFF)
		for let i = 0; i < data.len(); i++ {
			c = c ^ uint32(data[i])
			for let bit = 0; bit < 8; bit++ {
				c = (c & 1) != 0 ?? ((c >> 1) ^ 0x82F63B78, c >> 1)
			}
		}
		return c ^ 0xFFFFFFFF
	}

	check "CRC-32C" {
		// Every length from 0 to 4096 at eight starting offsets agrees
		// with the bit-at-a-time sum, and so does a sum taken in two parts.
		@test()
		def TestCRC32CAgainstBitwise() {
			let data byte[]
			data.len(4096 + 8)
			let seed = uint32(0x9E3779B9)
			for let i = 0; i < data.len(); i++ {
				seed = seed * 1664525 + 1013904223
				data[i] = byte((seed >> 24) & 0xFF)
			}
			for let length = 0; length <= 4096; length += length < 70 ?? (1, 61) {
				for let offset = 0; offset < 8; offset++ {
					let part = data[offset:offset + length]
					let want = bitwise(part)
					assert crc32c(part) == want
					let cut = length / 3
					assert crc32c(part[cut:], crc32c(part[0:cut])) == want
				}
			}
			assert crc32c(data[0:4096]) == bitwise(data[0:4096])
		}

		@benchmark()
		def BenchCRC32C1200() {
			let data byte[]
			data.len(1200)
			let sum = uint32(0)
			for let r = 0; r < 1000; r++ {
				sum = sum ^ crc32c(data)
			}
		}
	}
}
