partial module std.crypto.hash {
	check "CRC" {
		use std.testing

		@test()
		def crc32CheckValue() {
			assert crc32("123456789".bytes()) == 0xCBF43926
			assert crc32([]) == 0
			let h = new CRC32()
			h.write("1234".bytes())
			h.write("56789".bytes())
			assert h.hash().equals(byte[0xCB, 0xF4, 0x39, 0x26])
		}

		@test()
		def crc32SlicesAsBytewise() {
			let data byte[]
			data.len(1000)
			for let i = 0; i < data.len(); i++ {
				data[i] = byte((i * 131 + i / 7) & 0xFF)
			}
			for let n in [0, 1, 7, 8, 9, 15, 16, 17, 63, 64, 1000] {
				let c = uint32(0xFFFFFFFF)
				for let i = 0; i < n; i++ {
					c = crc32Update(c, data[i])
				}
				assert crc32(data[:n]) == c ^ 0xFFFFFFFF
				// Split anywhere, the running check comes out the same.
				let h = new CRC32()
				h.write(data[:n / 3])
				h.write(data[n / 3:n])
				assert h.hash().equals(byte[byte((c ^ 0xFFFFFFFF) >> 24), byte((c ^ 0xFFFFFFFF) >> 16), byte((c ^ 0xFFFFFFFF) >> 8), byte(c ^ 0xFFFFFFFF)])
			}
		}

		@test()
		def crc16CheckValue() {
			assert crc16("123456789".bytes()) == 0x4B37
			assert crc8("abc".bytes()) == crc8(crc8("a".bytes()), "bc".bytes())
		}

		@test()
		def crc64CheckValue() {
			assert crc64("123456789".bytes()) == 0x995DC9BBDF1939FA
			assert crc64([]) == 0
			let h = new CRC64()
			h.write("12345".bytes())
			h.write("6789".bytes())
			assert h.hash().equals(byte[0x99, 0x5D, 0xC9, 0xBB, 0xDF, 0x19, 0x39, 0xFA])
		}
	}
}
