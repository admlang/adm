partial module std.crypto.hash {
	// Hashable is a value that computes its own digest.
	interface Hashable {
		def hash() byte[]
	}

	// Hasher is an incremental digest: write feeds bytes, hash returns the digest
	// (feeding data first when given), reset starts over.
	interface Hasher {
		def write(buf byte[]) int
		def hash(data byte[] = []) byte[]
		def reset()
	}

	// Rotation by a multiple of the width is the identity.
	internal def rotl32(x uint32, n int) uint32 {
		return x when n % 32 == 0
		return (x << (n % 32)) | (x >> (32 - n % 32))
	}

	internal def rotr32(x uint32, n int) uint32 {
		return x when n % 32 == 0
		return (x >> (n % 32)) | (x << (32 - n % 32))
	}

	internal def rotl64(x uint64, n int) uint64 {
		return x when n % 64 == 0
		return (x << (n % 64)) | (x >> (64 - n % 64))
	}

	internal def rotr64(x uint64, n int) uint64 {
		return x when n % 64 == 0
		return (x >> (n % 64)) | (x << (64 - n % 64))
	}

	// Bitwise complement.
	internal def not32(x uint32) uint32 {
		return x ^ 0xFFFFFFFF
	}

	internal def not64(x uint64) uint64 {
		return x ^ 0xFFFFFFFFFFFFFFFF
	}

	internal def copyBytes(src byte[]) byte[] {
		let out byte[]
		out.len(src.len())
		for let i = 0; i < src.len(); i++ {
			out[i] = src[i]
		}
		return out
	}

	internal def copyWords32(src uint32[]) uint32[] {
		let out uint32[]
		out.len(src.len())
		for let i = 0; i < src.len(); i++ {
			out[i] = src[i]
		}
		return out
	}

	internal def copyWords64(src uint64[]) uint64[] {
		let out uint64[]
		out.len(src.len())
		for let i = 0; i < src.len(); i++ {
			out[i] = src[i]
		}
		return out
	}

	// Publishes the first `count` words of a state, most significant byte first.
	internal def words32ToBytes(words uint32[], count int) byte[] {
		let out byte[]
		for let i = 0; i < count; i++ {
			out.push(byte((words[i] >> 24) & 0xFF))
			out.push(byte((words[i] >> 16) & 0xFF))
			out.push(byte((words[i] >> 8) & 0xFF))
			out.push(byte(words[i] & 0xFF))
		}
		return out
	}

	internal def words64ToBytes(words uint64[], count int) byte[] {
		let out byte[]
		for let i = 0; i < count; i++ {
			for let s = 7; s >= 0; s-- {
				out.push(byte((words[i] >> (s * 8)) & 0xFF))
			}
		}
		return out
	}

	// Publishes the first `count` words of a state, least significant byte first
	// (MD4/MD5 and RIPEMD publish little-endian).
	internal def words32ToBytesLE(words uint32[], count int) byte[] {
		let out byte[]
		for let i = 0; i < count; i++ {
			out.push(byte(words[i] & 0xFF))
			out.push(byte((words[i] >> 8) & 0xFF))
			out.push(byte((words[i] >> 16) & 0xFF))
			out.push(byte((words[i] >> 24) & 0xFF))
		}
		return out
	}

	// Merkle-Damgard padding: a 0x80 byte, zeros, then the message length in
	// bits. `tail` is whatever the hasher has buffered short of a full block,
	// and `total` the byte count of the whole message. Returns whole blocks,
	// so a caller finalizes without touching its own state.
	internal def mdPadding64(tail byte[], total uint64, bigEndian = true) byte[][] {
		let block byte[]
		block = block + tail
		block.push(byte(0x80))
		for block.len() % 64 != 56 {
			block.push(byte(0))
		}
		let bits = total * 8
		if bigEndian {
			for let s = 7; s >= 0; s-- {
				block.push(byte((bits >> (s * 8)) & 0xFF))
			}
		} else {
			for let s = 0; s < 8; s++ {
				block.push(byte((bits >> (s * 8)) & 0xFF))
			}
		}
		return chunkBlocks(block, 64)
	}

	// The SHA-512 family pads to a 128-byte block and records the length in 128
	// bits. Messages that long are out of reach here, so the high half is zero.
	internal def mdPadding128(tail byte[], total uint64) byte[][] {
		let block byte[]
		block = block + tail
		block.push(byte(0x80))
		for block.len() % 128 != 112 {
			block.push(byte(0))
		}
		for let i = 0; i < 8; i++ {
			block.push(byte(0))
		}
		let bits = total * 8
		for let s = 7; s >= 0; s-- {
			block.push(byte((bits >> (s * 8)) & 0xFF))
		}
		return chunkBlocks(block, 128)
	}

	internal def chunkBlocks(data byte[], size int) byte[][] {
		let out byte[][]
		let off = 0
		for off + size <= data.len() {
			out.push(data[off:off + size])
			off += size
		}
		return out
	}
}
