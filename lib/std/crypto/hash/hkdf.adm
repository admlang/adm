partial module std.crypto.hash {
	// hkdfExtract is the extract step of RFC 5869: the HMAC of the keying
	// material under the salt. An empty salt means a string of zeros as long
	// as the digest.
	def hkdfExtract(algorithm Hash, salt, keyMaterial byte[]) byte[] {
		let s = salt
		s.len(hashSize(algorithm)) when s.len() == 0
		return hmac(algorithm, s, keyMaterial)
	}

	// hkdfExpand is the expand step of RFC 5869: stretches a pseudorandom key
	// to length bytes, binding the context info into every block.
	// Fails when length exceeds 255 digests.
	def hkdfExpand(algorithm Hash, pseudorandomKey, info byte[], length int) !byte[] {
		expects {
			assert length >= 0 onerror fail "hkdf: negative length"
			assert length <= 255 * hashSize(algorithm) onerror fail "hkdf: length exceeds 255 blocks"
		}
		let out byte[]
		let block byte[]
		let counter byte = 1
		for out.len() < length {
			let mac = new HMAC(algorithm, pseudorandomKey)
			mac.write(block)
			mac.write(info)
			block = mac.hash(byte[counter])
			out = out + block
			counter++
		}
		return out[0:length]
	}

	// hkdf derives length bytes from a secret: extract under salt, then expand
	// with info. Fails when length exceeds 255 digests.
	def hkdf(algorithm Hash, secret, salt, info byte[], length int) !byte[] {
		return try hkdfExpand(algorithm, hkdfExtract(algorithm, salt, secret), info, length)
	}
}
