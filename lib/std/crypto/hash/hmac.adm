partial module std.crypto.hash {
	// Hash names one of the digest algorithms of this module, for the
	// constructions that take a hash as a parameter: HMAC, HKDF, signature
	// schemes, the TLS key schedule. Every Hasher type has a member;
	// checksums (CRC, Adler-32) are not digests and have none.
	enum Hash {
		MD2,
		MD4,
		MD5,
		SHA1,
		SHA224,
		SHA256,
		SHA384,
		SHA512,
		SHA3_224,
		SHA3_256,
		SHA3_384,
		SHA3_512,
		Keccak224,
		Keccak256,
		Keccak384,
		Keccak512,
		BLAKE2b512,
		BLAKE2s256,
		RIPEMD160,
	}

	// newHasher returns a fresh incremental digest for the algorithm.
	def newHasher(algorithm Hash) Hasher {
		match algorithm {
			case Hash.MD2:
				return new MD2()
			case Hash.MD4:
				return new MD4()
			case Hash.MD5:
				return new MD5()
			case Hash.SHA1:
				return new SHA1()
			case Hash.SHA224:
				return new SHA224()
			case Hash.SHA256:
				return new SHA256()
			case Hash.SHA384:
				return new SHA384()
			case Hash.SHA512:
				return new SHA512()
			case Hash.SHA3_224:
				return new SHA3224()
			case Hash.SHA3_256:
				return new SHA3256()
			case Hash.SHA3_384:
				return new SHA3384()
			case Hash.SHA3_512:
				return new SHA3512()
			case Hash.Keccak224:
				return new Keccak224()
			case Hash.Keccak256:
				return new Keccak256()
			case Hash.Keccak384:
				return new Keccak384()
			case Hash.Keccak512:
				return new Keccak512()
			case Hash.BLAKE2b512:
				return new BLAKE2b512()
			case Hash.BLAKE2s256:
				return new BLAKE2s256()
			case Hash.RIPEMD160:
				return new RIPEMD160()
		}
		return new SHA256()
	}

	// hashSize returns the digest length in bytes.
	def hashSize(algorithm Hash) int {
		match algorithm {
			case Hash.MD2, Hash.MD4, Hash.MD5:
				return 16
			case Hash.SHA1, Hash.RIPEMD160:
				return 20
			case Hash.SHA224, Hash.SHA3_224, Hash.Keccak224:
				return 28
			case Hash.SHA256, Hash.SHA3_256, Hash.Keccak256, Hash.BLAKE2s256:
				return 32
			case Hash.SHA384, Hash.SHA3_384, Hash.Keccak384:
				return 48
			case Hash.SHA512, Hash.SHA3_512, Hash.Keccak512, Hash.BLAKE2b512:
				return 64
            default:
                return 32
		}
	}

	// blockSize returns the length in bytes of the block the digest absorbs
	// at a time, which is the width HMAC pads its key to. For the sponge
	// constructions (SHA-3, Keccak) it is the rate.
	def blockSize(algorithm Hash) int {
		match algorithm {
			case Hash.MD2:
				return 16
			case Hash.SHA384, Hash.SHA512, Hash.BLAKE2b512:
				return 128
			case Hash.SHA3_224, Hash.Keccak224:
				return 144
			case Hash.SHA3_256, Hash.Keccak256:
				return 136
			case Hash.SHA3_384, Hash.Keccak384:
				return 104
			case Hash.SHA3_512, Hash.Keccak512:
				return 72
			default:
				return 64
		}
	}

	// digest hashes data in one call.
	def digest(algorithm Hash, data byte[]) byte[] {
		return newHasher(algorithm).hash(data)
	}

	// HMAC is the keyed digest of RFC 2104 over one of the `Hash` algorithms:
	// `H((key ^ opad) || H((key ^ ipad) || message))`. A key longer than the
	// block is hashed first; a shorter one is zero padded. Implements Hasher.
	type HMAC {
		internal algorithm Hash
		internal inner     Hasher
		internal ipad      byte[]
		internal opad      byte[]

		def new(algorithm Hash, key byte[]) {
			self.algorithm = algorithm
			let width = blockSize(algorithm)
			let k = key
			k = digest(algorithm, k) when k.len() > width
			ipad = []
			opad = []
			ipad.len(width)
			opad.len(width)
			for let i = 0; i < width; i++ {
				let kb = i < k.len() ?? (k[i], byte(0))
				ipad[i] = kb ^ 0x36
				opad[i] = kb ^ 0x5c
			}
			inner = newHasher(algorithm)
			inner.write(ipad)
		}

		// write feeds message bytes and returns how many.
		def write(buf byte[]) int {
			return inner.write(buf)
		}

		// hash feeds data, when given, and returns the tag over everything
		// written so far.
		def hash(data byte[] = []) byte[] {
			let outer = newHasher(algorithm)
			outer.write(opad)
			return outer.hash(inner.hash(data))
		}

		// reset drops the message and keeps the key.
		def reset() {
			inner = newHasher(algorithm)
			inner.write(ipad)
		}

		// size is the tag length in bytes.
		def size() int {
			return hashSize(algorithm)
		}
	}

	// hmac returns the HMAC tag of data under key in one call.
	def hmac(algorithm Hash, key, data byte[]) byte[] {
		let mac = new HMAC(algorithm, key)
		return mac.hash(data)
	}
}
