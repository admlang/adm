partial module std.crypto.hash {
	use (
		std.testing
		std.data.encoding::(hexdecode)
	)

	// repeated is count copies of value.
	internal def repeated(value byte, count int) byte[] {
		let out byte[]
		out.len(count)
		return out.fill(value)
	}

	check "HMAC" {
		@test()
		def TestHMACRFC4231() {
			let key = repeated(0x0b, 20)
			let data = "Hi There".bytes()
			assert hmac(Hash.SHA224, key, data).hex() == "896FB1128ABBDF196832107CD49DF33F47B4B1169912BA4F53684B22"
			assert hmac(Hash.SHA256, key, data).hex() == "B0344C61D8DB38535CA8AFCEAF0BF12B881DC200C9833DA726E9376C2E32CFF7"
			assert hmac(Hash.SHA384, key, data).hex() == "AFD03944D84895626B0825F4AB46907F15F9DADBE4101EC682AA034C7CEBC59CFAEA9EA9076EDE7F4AF152E8B2FA9CB6"
			assert hmac(Hash.SHA512, key, data).hex() == "87AA7CDEA5EF619D4FF0B4241A1D6CB02379F4E2CE4EC2787AD0B30545E17CDEDAA833B7D6B8A702038B274EAEA3F4E4BE9D914EEB61F1702E696C203A126854"

			let jefe = hmac(Hash.SHA256, "Jefe".bytes(), "what do ya want for nothing?".bytes())
			assert jefe.hex() == "5BDCC146BF60754E6A042426089575C75A003F089D2739839DEC58B964EC3843"

			// Case 3: repeated key and data bytes.
			let tag3 = hmac(Hash.SHA256, repeated(0xaa, 20), repeated(0xdd, 50))
			assert tag3.hex() == "773EA91E36800E46854DB8EBD09181A72959098B3EF8C122D9635514CED565FE"

			// Case 7: a key longer than the block is hashed first.
			let long = repeated(0xaa, 131)
			let msg = "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".bytes()
			assert hmac(Hash.SHA256, long, msg).hex() == "9B09FFA71B942FCB27635FBCD5B0E944BFDC63644F0713938A7F51535C3A35E2"
		}

		@test()
		def TestHMACRFC2202() {
			assert hmac(Hash.MD5, repeated(0x0b, 16), "Hi There".bytes()).hex() == "9294727A3638BB1C13F48EF8158BFC9D"
			assert hmac(Hash.SHA1, repeated(0x0b, 20), "Hi There".bytes()).hex() == "B617318655057264E28BC0B6FB378C8EF146BE00"
		}

		@test()
		def TestHMACIncremental() {
			let mac = new HMAC(Hash.SHA256, "Jefe".bytes())
			mac.write("what do ya want ".bytes())
			mac.write("for nothing?".bytes())
			assert mac.hash().hex() == "5BDCC146BF60754E6A042426089575C75A003F089D2739839DEC58B964EC3843"
			assert mac.size() == 32
			mac.reset()
			assert mac.hash("what do ya want for nothing?".bytes()).hex() == "5BDCC146BF60754E6A042426089575C75A003F089D2739839DEC58B964EC3843"
		}

		@test()
		def TestHashHelpers() {
			assert hashSize(Hash.SHA384) == 48
			assert blockSize(Hash.SHA512) == 128
			assert blockSize(Hash.SHA256) == 64
			assert blockSize(Hash.SHA3_256) == 136
			assert blockSize(Hash.MD2) == 16
			assert digest(Hash.SHA256, "abc".bytes()).hex() == "BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD"
			// Every member constructs a hasher whose digest length matches hashSize.
			let all = Hash[
				Hash.MD2, Hash.MD4, Hash.MD5, Hash.SHA1, Hash.SHA224, Hash.SHA256, Hash.SHA384, Hash.SHA512,
				Hash.SHA3_224, Hash.SHA3_256, Hash.SHA3_384, Hash.SHA3_512,
				Hash.Keccak224, Hash.Keccak256, Hash.Keccak384, Hash.Keccak512,
				Hash.BLAKE2b512, Hash.BLAKE2s256, Hash.RIPEMD160
			]
			for let (_, h) in all {
				assert newHasher(h).hash("abc".bytes()).len() == hashSize(h)
				assert blockSize(h) >= hashSize(h) / 2
			}
		}

		@test()
		def TestHMACSHA3() {
			// NIST HMAC-SHA3-256 sample: key 00..1f, message "Sample message for keylen<blocklen".
			let key byte[]
			key.len(32)
			for let i = 0; i < 32; i++ {
				key[i] = byte(i)
			}
			let tag = hmac(Hash.SHA3_256, key, "Sample message for keylen<blocklen".bytes())
			assert tag.hex() == "4FE8E202C4F058E8DDDC23D8C34E467343E23555E24FC2F025D598F558F67205"
		}
	}

	check "HKDF" {
		@test()
		def TestHKDFRFC5869() !none {
			let ikm = repeated(0x0b, 22)
			let salt = try hexdecode("000102030405060708090a0b0c")
			let info = try hexdecode("f0f1f2f3f4f5f6f7f8f9")
			let prk = hkdfExtract(Hash.SHA256, salt, ikm)
			assert prk.hex() == "077709362C2E32DF0DDC3F0DC47BBA6390B6C73BB50F9C3122EC844AD7C2B3E5"
			let okm = try hkdfExpand(Hash.SHA256, prk, info, 42)
			assert okm.hex() == "3CB25F25FAACD57A90434F64D0362F2A2D2D0A90CF1A5A4C5DB02D56ECC4C5BF34007208D5B887185865"
			assert (try hkdf(Hash.SHA256, ikm, salt, info, 42)).hex() == okm.hex()

			// Case 3: empty salt and info.
			let prk3 = hkdfExtract(Hash.SHA256, [], ikm)
			assert prk3.hex() == "19EF24A32C717B167F33A91D6F648BDF96596776AFDB6377AC434C1C293CCB04"
			let okm3 = try hkdfExpand(Hash.SHA256, prk3, [], 42)
			assert okm3.hex() == "8DA4E775A563C18F715F802A063C5A31B8A11F5C5EE1879EC3454E5F3C738D2D9D201395FAA4B61A96C8"
		}

		@test()
		def TestHKDFLimits() !none {
			let tooLong = hkdfExpand(Hash.SHA256, repeated(1, 32), [], 255 * 32 + 1) onerror recover byte[9]
			assert tooLong.hex() == "09"
			assert (try hkdfExpand(Hash.SHA256, repeated(1, 32), [], 0)).len() == 0
		}
	}
}
