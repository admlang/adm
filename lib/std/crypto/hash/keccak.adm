partial module std.crypto.hash {
	// Keccak's sponge width is 1600 bits: twenty-five 64-bit lanes. The rate is
	// what a block of input touches; the rest is the capacity the attacker never
	// sees. For a fixed-size digest of n bytes the rate is 200 - 2n.
	internal const keccakLanes = 25
	internal const keccakRounds = 24

	// Original Keccak marks the end of the message with 0x01, SHA-3 with 0x06.
	// That one byte is the whole difference between the two families.
	internal const keccakDomain = 0x01
	internal const sha3Domain = 0x06

	internal const keccakRC = uint64[
		0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000,
		0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
		0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a,
		0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003,
		0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a,
		0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008
	]

	// Rho rotation offsets, laid out as x + 5y.
	internal const keccakRho = int[
		0, 1, 62, 28, 27,
		36, 44, 6, 55, 20,
		3, 10, 43, 25, 39,
		41, 45, 15, 21, 8,
		18, 2, 61, 56, 14
	]

	// The Keccak-f[1600] permutation, in place.
	internal def keccakF1600(a uint64[]) {
		let c uint64[]
		c.len(5)
		let d uint64[]
		d.len(5)
		let b uint64[]
		b.len(keccakLanes)

		for let round = 0; round < keccakRounds; round++ {
			// theta
			for let x = 0; x < 5; x++ {
				c[x] = a[x] ^ a[x + 5] ^ a[x + 10] ^ a[x + 15] ^ a[x + 20]
			}
			for let x = 0; x < 5; x++ {
				d[x] = c[(x + 4) % 5] ^ rotl64(c[(x + 1) % 5], 1)
			}
			for let y = 0; y < 5; y++ {
				for let x = 0; x < 5; x++ {
					a[x + 5 * y] = a[x + 5 * y] ^ d[x]
				}
			}

			// rho and pi
			for let y = 0; y < 5; y++ {
				for let x = 0; x < 5; x++ {
					b[y + 5 * ((2 * x + 3 * y) % 5)] = rotl64(a[x + 5 * y], keccakRho[x + 5 * y])
				}
			}

			// chi
			for let y = 0; y < 5; y++ {
				for let x = 0; x < 5; x++ {
					a[x + 5 * y] = b[x + 5 * y] ^ (not64(b[(x + 1) % 5 + 5 * y]) & b[(x + 2) % 5 + 5 * y])
				}
			}

			// iota
			a[0] = a[0] ^ keccakRC[round]
		}
	}

	// XORs one rate-sized block into the state, little-endian per lane, then
	// permutes. The rate is always a multiple of eight for the fixed digests.
	internal def keccakAbsorbBlock(state uint64[], block byte[], rate int) {
		for let i = 0; i < rate / 8; i++ {
			let j = i * 8
			let lane uint64 = 0
			for let s = 0; s < 8; s++ {
				lane = lane | (uint64(block[j + s]) << (s * 8))
			}
			state[i] = state[i] ^ lane
		}
		keccakF1600(state)
	}

	// Pads, absorbs the remainder and squeezes `outLen` bytes. The state is
	// copied first, so a hasher can be asked for its digest and keep going.
	internal def keccakSqueeze(state uint64[], tail byte[], rate int, domain byte, outLen int) byte[] {
		let st = copyWords64(state)

		let block byte[]
		block = block + tail
		block.push(domain)
		for block.len() % rate != 0 {
			block.push(byte(0))
		}
		block[block.len() - 1] = byte(block[block.len() - 1] | 0x80)
		for let (_, b) in chunkBlocks(block, rate) {
			keccakAbsorbBlock(st, b, rate)
		}

		let out byte[]
		for out.len() < outLen {
			for let i = 0; i < rate / 8; i++ {
				for let s = 0; s < 8; s++ {
					out.push(byte((st[i] >> (s * 8)) & 0xFF))
				}
			}
			if out.len() < outLen {
				keccakF1600(st)
			}
		}
		return out[0:outLen]
	}

	internal def keccakNewState() uint64[] {
		let st uint64[]
		st.len(keccakLanes)
		st[:] = 0
		return st
	}

	// Absorbs whole blocks out of `pending` and returns what is left over.
	internal def keccakWrite(state uint64[], pending byte[], buf byte[], rate int) byte[] {
		let all byte[]
		all = all + pending
		all = all + buf
		let off = 0
		for all.len() - off >= rate {
			keccakAbsorbBlock(state, all[off:off + rate], rate)
			off += rate
		}
		return all[off:]
	}

	// Keccak224 computes the 28-byte Keccak digest with the original padding, as a
	// Hasher.
	type Keccak224 {
		internal state   uint64[]
		internal pending byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = keccakWrite(state, pending, buf, 144)
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			return keccakSqueeze(state, pending, 144, byte(keccakDomain), 28)
		}

		// reset restarts the digest.
		def reset() {
			state = keccakNewState()
			pending = []
		}
	}

	// Keccak256 computes the 32-byte Keccak digest with the original padding, as a
	// Hasher.
	type Keccak256 {
		internal state   uint64[]
		internal pending byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = keccakWrite(state, pending, buf, 136)
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			return keccakSqueeze(state, pending, 136, byte(keccakDomain), 32)
		}

		// reset restarts the digest.
		def reset() {
			state = keccakNewState()
			pending = []
		}
	}

	// Keccak384 computes the 48-byte Keccak digest with the original padding, as a
	// Hasher.
	type Keccak384 {
		internal state   uint64[]
		internal pending byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = keccakWrite(state, pending, buf, 104)
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			return keccakSqueeze(state, pending, 104, byte(keccakDomain), 48)
		}

		// reset restarts the digest.
		def reset() {
			state = keccakNewState()
			pending = []
		}
	}

	// Keccak512 computes the 64-byte Keccak digest with the original padding, as a
	// Hasher.
	type Keccak512 {
		internal state   uint64[]
		internal pending byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = keccakWrite(state, pending, buf, 72)
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			return keccakSqueeze(state, pending, 72, byte(keccakDomain), 64)
		}

		// reset restarts the digest.
		def reset() {
			state = keccakNewState()
			pending = []
		}
	}
}
