partial module std.crypto.hash {
	internal const md2BlockSize = 16
	internal const md4BlockSize = 64
	internal const md5BlockSize = 64

	// RFC 1319's permutation of 0..255, built from the digits of pi.
	internal const md2Pi = byte[
		41, 46, 67, 201, 162, 216, 124, 1, 61, 54, 84, 161, 236, 240, 6, 19,
		98, 167, 5, 243, 192, 199, 115, 140, 152, 147, 43, 217, 188, 76, 130, 202,
		30, 155, 87, 60, 253, 212, 224, 22, 103, 66, 111, 24, 138, 23, 229, 18,
		190, 78, 196, 214, 218, 158, 222, 73, 160, 251, 245, 142, 187, 47, 238, 122,
		169, 104, 121, 145, 21, 178, 7, 63, 148, 194, 16, 137, 11, 34, 95, 33,
		128, 127, 93, 154, 90, 144, 50, 39, 53, 62, 204, 231, 191, 247, 151, 3,
		255, 25, 48, 179, 72, 165, 181, 209, 215, 94, 146, 42, 172, 86, 170, 198,
		79, 184, 56, 210, 150, 164, 125, 182, 118, 252, 107, 226, 156, 116, 4, 241,
		69, 157, 112, 89, 100, 113, 135, 32, 134, 91, 207, 101, 230, 45, 168, 2,
		27, 96, 37, 173, 174, 176, 185, 246, 28, 70, 97, 105, 52, 64, 126, 15,
		85, 71, 163, 35, 221, 81, 175, 58, 195, 92, 249, 206, 186, 197, 234, 38,
		44, 83, 13, 110, 133, 40, 132, 9, 211, 223, 205, 244, 65, 129, 77, 82,
		106, 220, 55, 200, 108, 193, 171, 250, 36, 225, 123, 8, 12, 189, 177, 74,
		120, 136, 149, 139, 227, 99, 232, 109, 233, 203, 213, 254, 59, 0, 29, 57,
		242, 239, 183, 14, 102, 88, 208, 228, 166, 119, 114, 248, 235, 117, 75, 10,
		49, 68, 80, 180, 143, 237, 31, 26, 219, 153, 141, 51, 159, 17, 131, 20
	]

	internal const md5K = uint32[
		0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
		0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
		0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
		0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
		0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
		0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
		0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
		0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
	]

	internal const md5Shift = int[
		7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
		5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
		4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
		6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
	]

	// MD4 visits the message words in a different order each round.
	internal const md4Order2 = int[0, 4, 8, 12, 1, 5, 9, 13, 2, 6, 10, 14, 3, 7, 11, 15]
	internal const md4Order3 = int[0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15]
	internal const md4Shift1 = int[3, 7, 11, 19]
	internal const md4Shift2 = int[3, 5, 9, 13]
	internal const md4Shift3 = int[3, 9, 11, 15]

	// Reads a 64-byte block as sixteen little-endian words, which is how MD4,
	// MD5 and RIPEMD all read their input.
	internal def leWords16(block byte[]) uint32[] {
		let w uint32[]
		w.len(16)
		for let i = 0; i < 16; i++ {
			let j = i * 4
			w[i] = uint32(block[j]) | uint32(block[j + 1]) << 8 | uint32(block[j + 2]) << 16 | uint32(block[j + 3]) << 24
		}
		return w
	}

	// Mixes one 16-byte block into MD2's 48-byte state and running checksum.
	internal def md2Block(x byte[], checksum byte[], block byte[], updateChecksum = true) {
		for let j = 0; j < 16; j++ {
			x[16 + j] = block[j]
			x[32 + j] = byte(x[16 + j] ^ x[j])
		}
		let t = 0
		for let j = 0; j < 18; j++ {
			for let k = 0; k < 48; k++ {
				x[k] = byte(x[k] ^ md2Pi[t])
				t = int(x[k])
			}
			t = (t + j) % 256
		}
		return unless updateChecksum
		let l = int(checksum[15])
		for let j = 0; j < 16; j++ {
			checksum[j] = byte(checksum[j] ^ md2Pi[int(block[j]) ^ l])
			l = int(checksum[j])
		}
	}

	// Mixes one 64-byte block into a four-word MD4 state, in place.
	internal def md4Block(state uint32[], block byte[]) {
		let x = leWords16(block)
		let a, b, c, d = state[0], state[1], state[2], state[3]

		for let i = 0; i < 16; i++ {
			let f = (b & c) | (not32(b) & d)
			let tmp = rotl32(a + f + x[i], md4Shift1[i % 4])
			a = d
			d = c
			c = b
			b = tmp
		}
		for let i = 0; i < 16; i++ {
			let g = (b & c) | (b & d) | (c & d)
			let tmp = rotl32(a + g + x[md4Order2[i]] + 0x5a827999, md4Shift2[i % 4])
			a = d
			d = c
			c = b
			b = tmp
		}
		for let i = 0; i < 16; i++ {
			let h = b ^ c ^ d
			let tmp = rotl32(a + h + x[md4Order3[i]] + 0x6ed9eba1, md4Shift3[i % 4])
			a = d
			d = c
			c = b
			b = tmp
		}

		state[0] += a
		state[1] += b
		state[2] += c
		state[3] += d
	}

	// Mixes one 64-byte block into a four-word MD5 state, in place.
	internal def md5Block(state uint32[], block byte[]) {
		let x = leWords16(block)
		let a, b, c, d = state[0], state[1], state[2], state[3]

		for let i = 0; i < 64; i++ {
			let f uint32 = 0
			let g = 0
			if i < 16 {
				f = (b & c) | (not32(b) & d)
				g = i
			} else if i < 32 {
				f = (d & b) | (not32(d) & c)
				g = (5 * i + 1) % 16
			} else if i < 48 {
				f = b ^ c ^ d
				g = (3 * i + 5) % 16
			} else {
				f = c ^ (b | not32(d))
				g = (7 * i) % 16
			}
			let tmp = d
			d = c
			c = b
			b = b + rotl32(a + f + md5K[i] + x[g], md5Shift[i])
			a = tmp
		}

		state[0] += a
		state[1] += b
		state[2] += c
		state[3] += d
	}

	// MD2 computes the 16-byte MD2 digest, as a Hasher; obsolete, for
	// compatibility only.
	type MD2 {
		internal x        byte[]
		internal checksum byte[]
		internal pending  byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = pending + buf
			let off = 0
			for pending.len() - off >= md2BlockSize {
				md2Block(x, checksum, pending[off:off + md2BlockSize])
				off += md2BlockSize
			}
			pending = pending[off:]
			return buf.len()
		}

		// MD2 pads with N bytes of value N, then digests its own checksum as a
		// final block. Both run on copies so the hasher stays usable.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			let st = copyBytes(x)
			let sum = copyBytes(checksum)
			let padLen = md2BlockSize - (pending.len() % md2BlockSize)
			let block byte[]
			block = block + pending
			for let i = 0; i < padLen; i++ {
				block.push(byte(padLen))
			}
			for let (_, b) in chunkBlocks(block, md2BlockSize) {
				md2Block(st, sum, b)
			}
			md2Block(st, sum, sum, false)
			return st[0:16]
		}

		// reset restarts the digest.
		def reset() {
			x = []
			x.len(48)
			x[:] = 0
			checksum = []
			checksum.len(16)
			checksum[:] = 0
			pending = []
		}
	}

	// MD4 computes the 16-byte MD4 digest, as a Hasher; obsolete, for
	// compatibility only.
	type MD4 {
		internal state   uint32[]
		internal pending byte[]
		internal total   uint64

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			total += uint64(buf.len())
			pending = pending + buf
			let off = 0
			for pending.len() - off >= md4BlockSize {
				md4Block(state, pending[off:off + md4BlockSize])
				off += md4BlockSize
			}
			pending = pending[off:]
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			let st = copyWords32(state)
			for let (_, block) in mdPadding64(pending, total, false) {
				md4Block(st, block)
			}
			return words32ToBytesLE(st, 4)
		}

		// reset restarts the digest.
		def reset() {
			state = uint32[0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
			pending = []
			total = 0
		}
	}

	// MD5 computes the 16-byte MD5 digest, as a Hasher; for checksums, not for
	// security.
	type MD5 {
		internal state   uint32[]
		internal pending byte[]
		internal total   uint64

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			total += uint64(buf.len())
			pending = pending + buf
			let off = 0
			for pending.len() - off >= md5BlockSize {
				md5Block(state, pending[off:off + md5BlockSize])
				off += md5BlockSize
			}
			pending = pending[off:]
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			let st = copyWords32(state)
			for let (_, block) in mdPadding64(pending, total, false) {
				md5Block(st, block)
			}
			return words32ToBytesLE(st, 4)
		}

		// reset restarts the digest.
		def reset() {
			state = uint32[0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
			pending = []
			total = 0
		}
	}
}
