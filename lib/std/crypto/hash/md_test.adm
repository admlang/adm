partial module std.crypto.hash {
	use std.testing

	check "MD" {
		@test()
		def md2_vectors() {
			let h = new MD2()
			assert h.hash().hex() == "8350E5A3E24C153DF2275C9F80692773"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "DA853B0D3F88D99B30283A69E6DED6BB"

			h.reset()
			assert h.hash("message digest".bytes()).hex() == "AB4F496BFB2A530B219FF33031FE06B0"
		}

		@test()
		def md4_vectors() {
			let h = new MD4()
			assert h.hash().hex() == "31D6CFE0D16AE931B73C59D7E0C089C0"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "A448017AAF21D8525FC10AE87AA6729D"

			h.reset()
			assert h.hash("abcdefghijklmnopqrstuvwxyz".bytes()).hex() == "D79E1C308AA5BBCDEEA8ED63DF412DA9"
		}

		@test()
		def md5_vectors() {
			let h = new MD5()
			assert h.hash().hex() == "D41D8CD98F00B204E9800998ECF8427E"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "900150983CD24FB0D6963F7D28E17F72"

			h.reset()
			assert h.hash("message digest".bytes()).hex() == "F96B697D7CB7938D525A2F31AAF161D0"

			h.reset()
			assert h.hash("12345678901234567890123456789012345678901234567890123456789012345678901234567890".bytes()).hex() == "57EDF4A22BE3C955AC49DA2E2107B67A"
		}

		@test()
		def md5_streaming_matches_one_shot() {
			let msg = "The quick brown fox jumps over the lazy dog, twice over, to cross a block boundary.".bytes()

			let one = new MD5()
			let want = one.hash(msg).hex()

			let many = new MD5()
			let off = 0
			for off < msg.len() {
				let end = off + 5
				end = msg.len() when end > msg.len()
				many.write(msg[off:end])
				off = end
			}
			assert many.hash().hex() == want
		}

		@test()
		def md2_streaming_matches_one_shot() {
			let msg = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".bytes()

			let one = new MD2()
			let want = one.hash(msg).hex()

			let many = new MD2()
			let off = 0
			for off < msg.len() {
				let end = off + 5
				end = msg.len() when end > msg.len()
				many.write(msg[off:end])
				off = end
			}
			assert many.hash().hex() == want
		}
	}
}
