partial module std.crypto.hash {
	// MurmurHash, the fast non-cryptographic hashes hash tables and
	// feature hashing use (spaCy hashes its strings with MurmurHash64A and
	// its embedding rows with MurmurHash3). They spread keys, they do not
	// resist an adversary.

	internal const (
		murmurM  = uint64(0xC6A4A7935BD1E995)
		murmurC1 = uint64(0x87C37B91114253D5)
		murmurC2 = uint64(0x4CF5AD432745937F)
	)

	// murmur64a returns MurmurHash64A (MurmurHash2, 64-bit) of the bytes
	// with the seed.
	def murmur64a(data byte[], seed uint64 = 0) uint64 {
		let n = data.len()
		let h = seed ^ (uint64(n) * murmurM)
		let at = 0
		for at + 8 <= n {
			let k = le64(data, at) * murmurM
			k = (k ^ (k >> 47)) * murmurM
			h = (h ^ k) * murmurM
			at += 8
		}
		if at < n {
			for let i = n - 1; i >= at; i-- {
				h = h ^ (uint64(data[i]) << uint64(8 * (i - at)))
			}
			h *= murmurM
		}
		h = (h ^ (h >> 47)) * murmurM
		return h ^ (h >> 47)
	}

	// murmur3 returns the two halves of MurmurHash3 x64 128 of the bytes
	// with the seed: the first 8 bytes of the digest, little-endian, then
	// the last 8.
	def murmur3(data byte[], seed uint32 = 0) (uint64, uint64) {
		let n = data.len()
		let h1 = uint64(seed)
		let h2 = uint64(seed)
		let at = 0
		for at + 16 <= n {
			h1 = h1 ^ murmurK1(le64(data, at))
			h1 = (rotl64(h1, 27) + h2) * uint64(5) + uint64(0x52DCE729)
			h2 = h2 ^ murmurK2(le64(data, at + 8))
			h2 = (rotl64(h2, 31) + h1) * uint64(5) + uint64(0x38495AB5)
			at += 16
		}
		let k1 = uint64(0)
		let k2 = uint64(0)
		for let i = n - 1; i >= at; i-- {
			let b = uint64(data[i])
			if i - at >= 8 {
				k2 = k2 | (b << uint64(8 * (i - at - 8)))
			} else {
				k1 = k1 | (b << uint64(8 * (i - at)))
			}
		}
		h2 = h2 ^ murmurK2(k2) when n - at > 8
		h1 = h1 ^ murmurK1(k1) when n > at
		return murmurFinish(h1, h2, n)
	}

	// murmur3 of the 8 little-endian bytes of `key`: the hash spaCy and
	// thinc give a 64-bit id.
	def murmur3(key uint64, seed uint32 = 0) (uint64, uint64) {
		return murmurFinish(uint64(seed) ^ murmurK1(key), uint64(seed), 8)
	}

	internal def murmurK1(k uint64) uint64 {
		return rotl64(k * murmurC1, 31) * murmurC2
	}

	internal def murmurK2(k uint64) uint64 {
		return rotl64(k * murmurC2, 33) * murmurC1
	}

	internal def murmurFinish(a uint64, b uint64, n int) (uint64, uint64) {
		let h1 = a ^ uint64(n)
		let h2 = b ^ uint64(n)
		h1 += h2
		h2 += h1
		h1 = murmurMix(h1)
		h2 = murmurMix(h2)
		h1 += h2
		h2 += h1
		return (h1, h2)
	}

	internal def murmurMix(x uint64) uint64 {
		let k = (x ^ (x >> 33)) * uint64(0xFF51AFD7ED558CCD)
		k = (k ^ (k >> 33)) * uint64(0xC4CEB9FE1A85EC53)
		return k ^ (k >> 33)
	}
}
