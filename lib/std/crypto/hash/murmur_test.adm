partial module std.crypto.hash {
	check "MurmurHash" {
		use std.testing

		// Seed 1 values are spaCy's string hashes (hash_string).
		@test()
		def TestMurmur64a() {
			assert murmur64a([]) == uint64(0)
			assert murmur64a([], 1) == uint64(0xC6A4A7935BD064DC)
			assert murmur64a("hello".bytes()) == uint64(0x1E68D17C457BF117)
			assert murmur64a("hello".bytes(), 1) == uint64(0x530A1BD8A612EB4E)
			assert murmur64a("Hello, world!".bytes(), 1) == uint64(0x24BDBF447C8B586F)
			assert murmur64a("naïve café".bytes(), 1) == uint64(0x85DEA9D300DD74DC)
			assert murmur64a("abcdefghijklmnopqrstuvwxyz0123456789".bytes(), 1) == uint64(0x65862B86CC6E2900)
		}

		@test()
		def TestMurmur3() {
			let (a, b) = murmur3([])
			assert a == uint64(0) && b == uint64(0)
			let (c, d) = murmur3("hello".bytes())
			assert c == uint64(0xCBD8A7B341BD9B02) && d == uint64(0x5B1E906A48AE1D19)
			let (e, f) = murmur3("hello".bytes(), 42)
			assert e == uint64(0xC4B8B3C960AF6F08) && f == uint64(0x2334B875B0EFBC7A)
			let (g, h) = murmur3("The quick brown fox jumps over the lazy dog".bytes())
			assert g == uint64(0xE34BBC7BBC071B6C) && h == uint64(0x7A433CA9C49A9347)
			let (i, j) = murmur3("abcdefghijklmnopq".bytes(), 7)
			assert i == uint64(0x932AE63F9B9A2550) && j == uint64(0x3A2F597A565E9315)
		}

		// The key form equals the bytes form of its 8 little-endian bytes.
		@test()
		def TestMurmur3Key() {
			for let (_, key) in uint64[0, 1, uint64(0x530A1BD8A612EB4E), uint64(0xFFFFFFFFFFFFFFFF)] {
				let bytes byte[]
				for let i = 0; i < 8; i++ {
					bytes.push(byte((key >> uint64(8 * i)) & uint64(0xFF)))
				}
				for let (_, seed) in uint32[0, 8, 13] {
					let (a, b) = murmur3(key, seed)
					let (c, d) = murmur3(bytes, seed)
					assert a == c && b == d
				}
			}
		}
	}
}
