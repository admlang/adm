partial module std.crypto.hash {
	// pbkdf2 derives `length` bytes from a password (PBKDF2, RFC 8018), with
	// HMAC over `algorithm` as the pseudorandom function and `rounds`
	// iterations.
	def pbkdf2(algorithm Hash, password, salt byte[], rounds int, length int) byte[] {
		let prf = new HMAC(algorithm, password)
		let out byte[] = []
		let block = 1
		let seed = salt.clone()
		seed.len(salt.len() + 4)
		for out.len() < length {
			seed[salt.len()] = byte(block >> 24)
			seed[salt.len() + 1] = byte(block >> 16)
			seed[salt.len() + 2] = byte(block >> 8)
			seed[salt.len() + 3] = byte(block)
			prf.reset()
			let u = prf.hash(seed)
			let t = u.clone()
			for let i = 1; i < rounds; i++ {
				prf.reset()
				u = prf.hash(u)
				for let j = 0; j < t.len(); j++ {
					t[j] = t[j] ^ u[j]
				}
			}
			for let j = 0; j < t.len() && out.len() < length; j++ {
				out.push(t[j])
			}
			block++
		}
		return out
	}
}
