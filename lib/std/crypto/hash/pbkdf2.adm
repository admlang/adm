partial module std.crypto.hash {
	// pbkdf2 derives `length` bytes from a password (PBKDF2, RFC 8018), with
	// HMAC over `algorithm` as the pseudorandom function and `rounds`
	// iterations.
	def pbkdf2(algorithm Hash, password, salt byte[], rounds int, length int) byte[] {
		return pbkdf2SHA256(password, salt, rounds, length) when algorithm == Hash.SHA256
		let prf = new HMAC(algorithm, password)
		let out byte[] = []
		let block = 1
		let seed = salt.clone()
		seed.len(salt.len() + 4)
		for out.len() < length {
			seed[salt.len()] = byte(block >> 24)
			seed[salt.len() + 1] = byte(block >> 16)
			seed[salt.len() + 2] = byte(block >> 8)
			seed[salt.len() + 3] = byte(block)
			prf.reset()
			let u = prf.hash(seed)
			let t = u.clone()
			for let i = 1; i < rounds; i++ {
				prf.reset()
				u = prf.hash(u)
				for let j = 0; j < t.len(); j++ {
					t[j] = t[j] ^ u[j]
				}
			}
			for let j = 0; j < t.len() && out.len() < length; j++ {
				out.push(t[j])
			}
			block++
		}
		return out
	}

	// pbkdf2 over HMAC-SHA-256 with the HMAC's two key blocks hashed once:
	// every round after the first is two compressions of one block.
	internal def pbkdf2SHA256(password, salt byte[], rounds int, length int) byte[] {
		let key = password
		key = digest(Hash.SHA256, key) when key.len() > sha256BlockSize
		let pad byte[] = []
		pad.len(sha256BlockSize)
		let w uint32[]
		for let i = 0; i < pad.len(); i++ {
			pad[i] = (i < key.len() ?? (key[i], byte(0))) ^ 0x36
		}
		let inner = copyWords32(sha256Start)
		sha256Block(inner, pad, 0, w)
		for let i = 0; i < pad.len(); i++ {
			pad[i] = pad[i] ^ 0x36 ^ 0x5c
		}
		let outer = copyWords32(sha256Start)
		sha256Block(outer, pad, 0, w)

		// A 32-byte tag after the key block, padded: 768 bits in all.
		let block byte[] = []
		block.len(sha256BlockSize)
		block[32] = 0x80
		block[62] = 0x03
		let state uint32[] = []
		state.len(8)
		let sum uint32[] = []
		sum.len(8)
		let prf = new HMAC(Hash.SHA256, password)
		let seed = salt.clone()
		seed.len(salt.len() + 4)
		let out byte[] = []
		let index = 1
		for out.len() < length {
			seed[salt.len()] = byte(index >> 24)
			seed[salt.len() + 1] = byte(index >> 16)
			seed[salt.len() + 2] = byte(index >> 8)
			seed[salt.len() + 3] = byte(index)
			prf.reset()
			prf.hash(seed).copy(block)
			for let k = 0; k < 8; k++ {
				sum[k] = uint32(block[k * 4]) << 24 | uint32(block[k * 4 + 1]) << 16 | uint32(block[k * 4 + 2]) << 8 | uint32(block[k * 4 + 3])
			}
			for let i = 1; i < rounds; i++ {
				for let k = 0; k < 8; k++ {
					state[k] = inner[k]
				}
				sha256Block(state, block, 0, w)
				pbkdf2Words(block, state)
				for let k = 0; k < 8; k++ {
					state[k] = outer[k]
				}
				sha256Block(state, block, 0, w)
				pbkdf2Words(block, state)
				for let k = 0; k < 8; k++ {
					sum[k] = sum[k] ^ state[k]
				}
			}
			let tag = words32ToBytes(sum, 8)
			for let j = 0; j < tag.len() && out.len() < length; j++ {
				out.push(tag[j])
			}
			index++
		}
		return out
	}

	// Writes eight state words to the start of a block, big-endian.
	internal def pbkdf2Words(block byte[], words uint32[]) {
		for let k = 0; k < 8; k++ {
			block[k * 4] = byte(words[k] >> 24)
			block[k * 4 + 1] = byte((words[k] >> 16) & 0xFF)
			block[k * 4 + 2] = byte((words[k] >> 8) & 0xFF)
			block[k * 4 + 3] = byte(words[k] & 0xFF)
		}
	}
}
