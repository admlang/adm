partial module std.crypto.hash {
	use std.testing

	check "RIPEMD" {
		@test()
		def ripemd160_vectors() {
			let h = new RIPEMD160()
			assert h.hash().hex() == "9C1185A5C5E9FC54612808977EE8F548B2258D31"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "8EB208F7E05D987A9B044A8E98C6B087F15A0BFC"

			h.reset()
			assert h.hash("message digest".bytes()).hex() == "5D0689EF49D2FAE572B881B123A85FFA21595F36"

			h.reset()
			assert h.hash("abcdefghijklmnopqrstuvwxyz".bytes()).hex() == "F71C27109C692C1B56BBDCEB5B9D2865B3708DBC"
		}

		@test()
		def ripemd160_streaming_matches_one_shot() {
			let msg = "The quick brown fox jumps over the lazy dog, twice over, to cross a block boundary.".bytes()

			let one = new RIPEMD160()
			let want = one.hash(msg).hex()

			let many = new RIPEMD160()
			let off = 0
			for off < msg.len() {
				let end = off + 9
				end = msg.len() when end > msg.len()
				many.write(msg[off:end])
				off = end
			}
			assert many.hash().hex() == want
		}
	}
}
