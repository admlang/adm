partial module std.crypto.hash {
	internal const (
		sha1BlockSize   = 64
		sha256BlockSize = 64
		sha512BlockSize = 128
	)

	internal const sha256K = uint32[
		0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
		0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
		0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
		0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
		0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
		0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
		0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
		0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
	]

	internal const sha512K = uint64[
		0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
		0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
		0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
		0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
		0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
		0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
		0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
		0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
		0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
		0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
		0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
		0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
		0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
		0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
		0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
		0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
		0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
		0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
		0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
		0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
	]

	// Mixes one 64-byte block into a five-word SHA-1 state, in place.
	internal def sha1Block(state uint32[], block byte[]) {
		let w uint32[]
		w.len(80)
		for let i = 0; i < 16; i++ {
			let j = i * 4
			w[i] = uint32(block[j]) << 24 | uint32(block[j + 1]) << 16 | uint32(block[j + 2]) << 8 | uint32(block[j + 3])
		}
		for let i = 16; i < 80; i++ {
			w[i] = rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
		}

		let a, b, c, d, e = state[0], state[1], state[2], state[3], state[4]
		for let i = 0; i < 80; i++ {
			let f uint32 = 0
			let k uint32 = 0
			if i < 20 {
				f = (b & c) | (not32(b) & d)
				k = 0x5a827999
			} else if i < 40 {
				f = b ^ c ^ d
				k = 0x6ed9eba1
			} else if i < 60 {
				f = (b & c) | (b & d) | (c & d)
				k = 0x8f1bbcdc
			} else {
				f = b ^ c ^ d
				k = 0xca62c1d6
			}
			let tmp = rotl32(a, 5) + f + e + k + w[i]
			e = d
			d = c
			c = rotl32(b, 30)
			b = a
			a = tmp
		}

		state[0] += a
		state[1] += b
		state[2] += c
		state[3] += d
		state[4] += e
	}

	// Mixes one 64-byte block into an eight-word SHA-256 state, in place.
	// SHA-224 shares this compression function and differs only in its initial
	// state and how much of the result it publishes.
	internal def sha256Block(state uint32[], block byte[]) {
		let w uint32[]
		w.len(64)
		for let i = 0; i < 16; i++ {
			let j = i * 4
			w[i] = uint32(block[j]) << 24 | uint32(block[j + 1]) << 16 | uint32(block[j + 2]) << 8 | uint32(block[j + 3])
		}
		for let i = 16; i < 64; i++ {
			let s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3)
			let s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10)
			w[i] = w[i - 16] + s0 + w[i - 7] + s1
		}

		let a, b, c, d = state[0], state[1], state[2], state[3]
		let e, f, g, h = state[4], state[5], state[6], state[7]
		for let i = 0; i < 64; i++ {
			let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
			let ch = (e & f) ^ (not32(e) & g)
			let t1 = h + s1 + ch + sha256K[i] + w[i]
			let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
			let maj = (a & b) ^ (a & c) ^ (b & c)
			let t2 = s0 + maj
			h = g
			g = f
			f = e
			e = d + t1
			d = c
			c = b
			b = a
			a = t1 + t2
		}

		state[0] += a
		state[1] += b
		state[2] += c
		state[3] += d
		state[4] += e
		state[5] += f
		state[6] += g
		state[7] += h
	}

	// Mixes one 128-byte block into an eight-word SHA-512 state, in place.
	// SHA-384 shares this compression function.
	internal def sha512Block(state uint64[], block byte[]) {
		let w uint64[]
		w.len(80)
		for let i = 0; i < 16; i++ {
			let j = i * 8
			w[i] = uint64(block[j])<<56 | uint64(block[j+1])<<48 | uint64(block[j+2])<<40 | uint64(block[j+3])<<32 |
				uint64(block[j+4])<<24 | uint64(block[j+5])<<16 | uint64(block[j+6])<<8 | uint64(block[j+7])
		}
		for let i = 16; i < 80; i++ {
			let s0 = rotr64(w[i - 15], 1) ^ rotr64(w[i - 15], 8) ^ (w[i - 15] >> 7)
			let s1 = rotr64(w[i - 2], 19) ^ rotr64(w[i - 2], 61) ^ (w[i - 2] >> 6)
			w[i] = w[i - 16] + s0 + w[i - 7] + s1
		}

		let a, b, c, d = state[0], state[1], state[2], state[3]
		let e, f, g, h = state[4], state[5], state[6], state[7]
		for let i = 0; i < 80; i++ {
			let s1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
			let ch = (e & f) ^ (not64(e) & g)
			let t1 = h + s1 + ch + sha512K[i] + w[i]
			let s0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
			let maj = (a & b) ^ (a & c) ^ (b & c)
			let t2 = s0 + maj
			h = g
			g = f
			f = e
			e = d + t1
			d = c
			c = b
			b = a
			a = t1 + t2
		}

		state[0] += a
		state[1] += b
		state[2] += c
		state[3] += d
		state[4] += e
		state[5] += f
		state[6] += g
		state[7] += h
	}

	// SHA1 computes the 20-byte SHA-1 digest, as a Hasher; for checksums, not
	// for security.
	type SHA1 {
		internal state   uint32[]
		internal pending byte[]
		internal total   uint64

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			total += uint64(buf.len())
			pending = pending + buf
			let off = 0
			for pending.len() - off >= sha1BlockSize {
				sha1Block(state, pending[off:off + sha1BlockSize])
				off += sha1BlockSize
			}
			pending = pending[off:]
			return buf.len()
		}

		// Returns the digest of everything written so far. The hasher is left
		// usable, so a caller may keep writing and ask again.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			let st = copyWords32(state)
			for let (_, block) in mdPadding64(pending, total) {
				sha1Block(st, block)
			}
			return words32ToBytes(st, 5)
		}

		// reset restarts the digest.
		def reset() {
			state = uint32[0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0]
			pending = []
			total = 0
		}
	}

	// SHA224 computes the 28-byte SHA-224 digest, as a Hasher.
	type SHA224 {
		internal state   uint32[]
		internal pending byte[]
		internal total   uint64

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			total += uint64(buf.len())
			pending = pending + buf
			let off = 0
			for pending.len() - off >= sha256BlockSize {
				sha256Block(state, pending[off:off + sha256BlockSize])
				off += sha256BlockSize
			}
			pending = pending[off:]
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			let st = copyWords32(state)
			for let (_, block) in mdPadding64(pending, total) {
				sha256Block(st, block)
			}
			return words32ToBytes(st, 7)
		}

		// reset restarts the digest.
		def reset() {
			state = uint32[0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939, 0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4]
			pending = []
			total = 0
		}
	}

	// SHA256 computes the 32-byte SHA-256 digest, as a Hasher.
	//
	// Example:
	// ```example
	// let digest = new SHA256()
	// digest.write("hello ".bytes())
	// digest.write("world".bytes())
	// println(digest.hash().hex())
	// // or in one call
	// println(new SHA256().hash("hello world".bytes()).hex())
	// ```
	type SHA256 {
		internal state   uint32[]
		internal pending byte[]
		internal total   uint64

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			total += uint64(buf.len())
			pending = pending + buf
			let off = 0
			for pending.len() - off >= sha256BlockSize {
				sha256Block(state, pending[off:off + sha256BlockSize])
				off += sha256BlockSize
			}
			pending = pending[off:]
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			let st = copyWords32(state)
			for let (_, block) in mdPadding64(pending, total) {
				sha256Block(st, block)
			}
			return words32ToBytes(st, 8)
		}

		// reset restarts the digest.
		def reset() {
			state = uint32[0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
			pending = []
			total = 0
		}
	}

	// SHA384 computes the 48-byte SHA-384 digest, as a Hasher.
	type SHA384 {
		internal state   uint64[]
		internal pending byte[]
		internal total   uint64

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			total += uint64(buf.len())
			pending = pending + buf
			let off = 0
			for pending.len() - off >= sha512BlockSize {
				sha512Block(state, pending[off:off + sha512BlockSize])
				off += sha512BlockSize
			}
			pending = pending[off:]
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			let st = copyWords64(state)
			for let (_, block) in mdPadding128(pending, total) {
				sha512Block(st, block)
			}
			return words64ToBytes(st, 6)
		}

		// reset restarts the digest.
		def reset() {
			state = uint64[
				0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
				0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4
			]
			pending = []
			total = 0
		}
	}

	// SHA512 computes the 64-byte SHA-512 digest, as a Hasher.
	type SHA512 {
		internal state   uint64[]
		internal pending byte[]
		internal total   uint64

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			total += uint64(buf.len())
			pending = pending + buf
			let off = 0
			for pending.len() - off >= sha512BlockSize {
				sha512Block(state, pending[off:off + sha512BlockSize])
				off += sha512BlockSize
			}
			pending = pending[off:]
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			if data.len() > 0 {
				write(data)
			}
			let st = copyWords64(state)
			for let (_, block) in mdPadding128(pending, total) {
				sha512Block(st, block)
			}
			return words64ToBytes(st, 8)
		}

		// reset restarts the digest.
		def reset() {
			state = uint64[
				0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
				0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
			]
			pending = []
			total = 0
		}
	}
}
