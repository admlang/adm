partial module std.crypto.hash {
	// SHA-3 is Keccak with one extra domain-separation byte in the padding; the
	// permutation, rates and digest sizes are the same.
	type SHA3224 {
		internal state   uint64[]
		internal pending byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = keccakWrite(state, pending, buf, 144)
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			write(data) when data.len() > 0
			return keccakSqueeze(state, pending, 144, byte(sha3Domain), 28)
		}

		// reset restarts the digest.
		def reset() {
			state = keccakNewState()
			pending = []
		}
	}

	// SHA3256 computes the 32-byte SHA3-256 digest, as a Hasher.
	type SHA3256 {
		internal state   uint64[]
		internal pending byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = keccakWrite(state, pending, buf, 136)
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			write(data) when data.len() > 0
			return keccakSqueeze(state, pending, 136, byte(sha3Domain), 32)
		}

		// reset restarts the digest.
		def reset() {
			state = keccakNewState()
			pending = []
		}
	}

	// SHA3384 computes the 48-byte SHA3-384 digest, as a Hasher.
	type SHA3384 {
		internal state   uint64[]
		internal pending byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = keccakWrite(state, pending, buf, 104)
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			write(data) when data.len() > 0
			return keccakSqueeze(state, pending, 104, byte(sha3Domain), 48)
		}

		// reset restarts the digest.
		def reset() {
			state = keccakNewState()
			pending = []
		}
	}

	// SHA3512 computes the 64-byte SHA3-512 digest, as a Hasher.
	type SHA3512 {
		internal state   uint64[]
		internal pending byte[]

		def new() {
			reset()
		}

		// write feeds the bytes into the digest and returns how many.
		def write(buf byte[]) int {
			return 0 when buf.len() == 0
			pending = keccakWrite(state, pending, buf, 72)
			return buf.len()
		}

		// hash feeds data, when given, and returns the digest of everything written
		// so far.
		def hash(data byte[] = []) byte[] {
			write(data) when data.len() > 0
			return keccakSqueeze(state, pending, 72, byte(sha3Domain), 64)
		}

		// reset restarts the digest.
		def reset() {
			state = keccakNewState()
			pending = []
		}
	}

	// SHAKE's end-of-message marker: the SHA-3 family's, with the two XOF
	// bits (FIPS 202 §6.2).
	internal const shakeDomain = 0x1F

	// A SHAKE sponge: absorbs until the first squeeze, then hands out
	// output a rate-sized block at a time.
	internal type ShakeSponge {
		rate      int
		state     uint64[]
		pending   byte[]
		ready     byte[]
		squeezing bool

		def new(rate int) {
			self.rate = rate
			reset()
		}

		def write(buf byte[]) int {
			return 0 when squeezing || buf.len() == 0
			pending = keccakWrite(state, pending, buf, rate)
			return buf.len()
		}

		def squeeze(n int) byte[] {
			if !squeezing {
				let block = pending.clone()
				block.push(byte(shakeDomain))
				for block.len() % rate != 0 {
					block.push(byte(0))
				}
				block[block.len() - 1] = byte(block[block.len() - 1] | 0x80)
				for let b in chunkBlocks(block, rate) {
					keccakAbsorbBlock(state, b, rate)
				}
				squeezing = true
				ready = laneBytes()
			}
			let out byte[] = []
			for out.len() < n {
				if ready.len() == 0 {
					keccakF1600(state)
					ready = laneBytes()
				}
				let take = n - out.len()
				take = ready.len() when ready.len() < take
				out = out + ready[:take]
				ready = ready[take:]
			}
			return out
		}

		// The rate part of the state as bytes, lanes little-endian.
		def laneBytes() byte[] {
			let out byte[] = []
			out.len(rate)
			for let i = 0; i < rate / 8; i++ {
				for let s = 0; s < 8; s++ {
					out[i * 8 + s] = byte((state[i] >> (s * 8)) & 0xFF)
				}
			}
			return out
		}

		def reset() {
			state = keccakNewState()
			pending = []
			ready = []
			squeezing = false
		}
	}

	// SHAKE128 is the SHA-3 extendable-output function at the 128-bit
	// security level (FIPS 202): write the input, then squeeze out as many
	// bytes as needed, in as many calls as suits.
	//
	// ```
	// let xof = new hash.SHAKE128()
	// xof.write(seed)
	// let first = xof.squeeze(168)
	// let more = xof.squeeze(168)
	// ```
	type SHAKE128 {
		internal sponge ShakeSponge

		def new() {
			sponge = new ShakeSponge(168)
		}

		// write feeds the bytes in and returns how many; once squeezing
		// started it takes nothing and returns 0.
		def write(buf byte[]) int {
			return sponge.write(buf)
		}

		// squeeze returns the next `n` bytes of output.
		def squeeze(n int) byte[] {
			return sponge.squeeze(n)
		}

		// reset starts over with no input.
		def reset() {
			sponge.reset()
		}
	}

	// SHAKE256 is the SHA-3 extendable-output function at the 256-bit
	// security level (FIPS 202); used as SHAKE128 is.
	type SHAKE256 {
		internal sponge ShakeSponge

		def new() {
			sponge = new ShakeSponge(136)
		}

		// write feeds the bytes in and returns how many; once squeezing
		// started it takes nothing and returns 0.
		def write(buf byte[]) int {
			return sponge.write(buf)
		}

		// squeeze returns the next `n` bytes of output.
		def squeeze(n int) byte[] {
			return sponge.squeeze(n)
		}

		// reset starts over with no input.
		def reset() {
			sponge.reset()
		}
	}

	// shake128 returns `size` bytes of SHAKE128 output over `data`.
	def shake128(data byte[], size int) byte[] {
		let x = new SHAKE128()
		x.write(data)
		return x.squeeze(size)
	}

	// shake256 returns `size` bytes of SHAKE256 output over `data`.
	def shake256(data byte[], size int) byte[] {
		let x = new SHAKE256()
		x.write(data)
		return x.squeeze(size)
	}
}
