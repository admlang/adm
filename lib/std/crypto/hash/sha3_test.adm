partial module std.crypto.hash {
	use std.testing

	check "Keccak and SHA-3" {
		@test()
		def keccak_vectors() {
			let k224 = new Keccak224()
			assert k224.hash().hex() == "F71837502BA8E10837BDD8D365ADB85591895602FC552B48B7390ABD"

			let k256 = new Keccak256()
			assert k256.hash().hex() == "C5D2460186F7233C927E7DB2DCC703C0E500B653CA82273B7BFAD8045D85A470"

			k256.reset()
			assert k256.hash("abc".bytes()).hex() == "4E03657AEA45A94FC7D47BA826C8D667C0D1E6E33A64A036EC44F58FA12D6C45"

			let k384 = new Keccak384()
			assert k384.hash().hex() == "2C23146A63A29ACF99E73B88F8C24EAA7DC60AA771780CCC006AFBFA8FE2479B2DD2B21362337441AC12B515911957FF"

			let k512 = new Keccak512()
			assert k512.hash().hex() == "0EAB42DE4C3CEB9235FC91ACFFE746B29C29A8C366B7C60E4E67C466F36A4304C00FA9CAF9D87976BA469BCBE06713B435F091EF2769FB160CDAB33D3670680E"
		}

		@test()
		def sha3_vectors() {
			let h224 = new SHA3224()
			assert h224.hash("abc".bytes()).hex() == "E642824C3F8CF24AD09234EE7D3C766FC9A3A5168D0C94AD73B46FDF"

			let h256 = new SHA3256()
			assert h256.hash().hex() == "A7FFC6F8BF1ED76651C14756A061D662F580FF4DE43B49FA82D80A4B80F8434A"

			h256.reset()
			assert h256.hash("abc".bytes()).hex() == "3A985DA74FE225B2045C172D6BD390BD855F086E3E9D525B46BFE24511431532"

			let h384 = new SHA3384()
			assert h384.hash("abc".bytes()).hex() == "EC01498288516FC926459F58E2C6AD8DF9B473CB0FC08C2596DA7CF0E49BE4B298D88CEA927AC7F539F1EDF228376D25"

			let h512 = new SHA3512()
			assert h512.hash().hex() == "A69F73CCA23A9AC5C8B567DC185A756E97C982164FE25859E0D1DCC1475C80A615B2123AF1F5F94C11E3E9402C3AC558F500199D95B6D3E301758586281DCD26"

			h512.reset()
			assert h512.hash("abc".bytes()).hex() == "B751850B1A57168A5693CD924B6B096E08F621827444F70D884F5D0240D2712E10E116E9192AF3C91A7EC57647E3934057340B4CF408D5A56592F8274EEC53F0"
		}

		// A message longer than the rate exercises the absorb loop and the
		// pending buffer across writes.
		@test()
		def sha3_streaming_matches_one_shot() {
			let msg byte[]
			for let i = 0; i < 300; i++ {
				msg.push(byte(i % 251))
			}

			let one = new SHA3256()
			let want = one.hash(msg).hex()

			let many = new SHA3256()
			let off = 0
			for off < msg.len() {
				let end = off + 13
				end = msg.len() when end > msg.len()
				many.write(msg[off:end])
				off = end
			}
			assert many.hash().hex() == want
		}
	}
}
