partial module std.crypto.hash {
	use std.testing

	check "SHA" {
		@test()
		def sha1_vectors() {
			let h = new SHA1()
			assert h.hash().hex() == "DA39A3EE5E6B4B0D3255BFEF95601890AFD80709"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "A9993E364706816ABA3E25717850C26C9CD0D89D"

			h.reset()
			assert h.hash("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes()).hex() == "84983E441C3BD26EBAAE4AA1F95129E5E54670F1"
		}

		@test()
		def sha224_vectors() {
			let h = new SHA224()
			assert h.hash().hex() == "D14A028C2A3A2BC9476102BB288234C415A2B01F828EA62AC5B3E42F"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "23097D223405D8228642A477BDA255B32AADBCE4BDA0B3F7E36C9DA7"
		}

		@test()
		def sha256_vectors() {
			let h = new SHA256()
			assert h.hash().hex() == "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855"

			h.reset()
			assert h.hash("abc".bytes()).hex() == "BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD"

			h.reset()
			assert h.hash("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes()).hex() == "248D6A61D20638B8E5C026930C3E6039A33CE45964FF2167F6ECEDD419DB06C1"
		}

		@test()
		def sha384_vectors() {
			let h = new SHA384()
			assert h.hash("abc".bytes()).hex() == "CB00753F45A35E8BB5A03D699AC65007272C32AB0EDED1631A8B605A43FF5BED8086072BA1E7CC2358BAECA134C825A7"
		}

		@test()
		def sha512_vectors() {
			let h = new SHA512()
			assert h.hash("abc".bytes()).hex() == "DDAF35A193617ABACC417349AE20413112E6FA4E89A97EA20A9EEEE64B55D39A2192992A274FC1A836BA3C23A3FEEBBD454D4423643CE80E2A9AC94FA54CA49F"
		}

		// Feeding the same message in pieces must land on the same digest, which
		// is what exercises the pending-block buffer and the length counter.
		@test()
		def streaming_matches_one_shot() {
			let msg = "The quick brown fox jumps over the lazy dog, repeatedly, until the buffer wraps a block boundary.".bytes()

			let one = new SHA256()
			let want = one.hash(msg).hex()

			let many = new SHA256()
			let off = 0
			for off < msg.len() {
				let end = off + 7
				end = msg.len() when end > msg.len()
				many.write(msg[off:end])
				off = end
			}
			assert many.hash().hex() == want
		}

		// hash() must not consume the hasher: asking twice gives the same answer,
		// and writing more after asking continues the same message.
		@test()
		def hash_does_not_finalize() {
			let h = new SHA256()
			h.write("ab".bytes())
			let first = h.hash().hex()
			assert h.hash().hex() == first

			h.write("c".bytes())
			assert h.hash().hex() == "BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD"
		}
	}
}
