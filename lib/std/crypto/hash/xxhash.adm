partial module std.crypto.hash {
	// xxHash, the fast non-cryptographic checksums the LZ4 and Zstandard
	// formats use: XXH32 and XXH64. They detect damage, not tampering.

	internal const (
		xx32Prime1 = uint32(0x9E3779B1)
		xx32Prime2 = uint32(0x85EBCA77)
		xx32Prime3 = uint32(0xC2B2AE3D)
		xx32Prime4 = uint32(0x27D4EB2F)
		xx32Prime5 = uint32(0x165667B1)
		xx64Prime1 = uint64(0x9E3779B185EBCA87)
		xx64Prime2 = uint64(0xC2B2AE3D27D4EB4F)
		xx64Prime3 = uint64(0x165667B19E3779F9)
		xx64Prime4 = uint64(0x85EBCA77C2B2AE63)
		xx64Prime5 = uint64(0x27D4EB2F165667C5)
	)

	// xxh32 returns the XXH32 of the bytes with the seed.
	def xxh32(data byte[], seed uint32 = 0) uint32 {
		let h = new XXH32(seed)
		h.write(data)
		return h.sum()
	}

	// xxh64 returns the XXH64 of the bytes with the seed.
	def xxh64(data byte[], seed uint64 = 0) uint64 {
		let h = new XXH64(seed)
		h.write(data)
		return h.sum()
	}

	// XXH32 computes an XXH32 over data given in pieces.
	type XXH32 {
		internal seed  uint32
		internal v1    uint32
		internal v2    uint32
		internal v3    uint32
		internal v4    uint32
		internal total int
		// The bytes of a stripe (16) not yet complete.
		internal rest  byte[]

		def new(seed uint32 = 0) {
			self.seed = seed
			rest = []
			reset()
		}

		// reset starts over with the same seed.
		def reset() {
			v1 = seed + xx32Prime1 + xx32Prime2
			v2 = seed + xx32Prime2
			v3 = seed
			v4 = seed - xx32Prime1
			total = 0
			rest.len(0)
		}

		// write feeds the bytes into the checksum and returns how many.
		def write(buf byte[]) int {
			let n = buf.len()
			total += n
			let at = 0
			if rest.len() > 0 {
				for at < n && rest.len() < 16 {
					rest.push(buf[at])
					at++
				}
				return n when rest.len() < 16
				stripe(rest, 0)
				rest.len(0)
			}
			for at + 16 <= n {
				stripe(buf, at)
				at += 16
			}
			for at < n {
				rest.push(buf[at])
				at++
			}
			return n
		}

		// sum returns the checksum of everything written so far; more may be
		// written after it.
		def sum() uint32 {
			let h = seed + xx32Prime5
			h = rotl32(v1, 1) + rotl32(v2, 7) + rotl32(v3, 12) + rotl32(v4, 18) when total >= 16
			h += uint32(total & 0xFFFFFFFF)
			let at = 0
			let left = rest.len()
			for at + 4 <= left {
				h += le32(rest, at) * xx32Prime3
				h = rotl32(h, 17) * xx32Prime4
				at += 4
			}
			for at < left {
				h += uint32(rest[at]) * xx32Prime5
				h = rotl32(h, 11) * xx32Prime1
				at++
			}
			h = h ^ (h >> 15)
			h *= xx32Prime2
			h = h ^ (h >> 13)
			h *= xx32Prime3
			return h ^ (h >> 16)
		}

		internal def stripe(buf byte[], at int) {
			v1 = rotl32(v1 + le32(buf, at) * xx32Prime2, 13) * xx32Prime1
			v2 = rotl32(v2 + le32(buf, at + 4) * xx32Prime2, 13) * xx32Prime1
			v3 = rotl32(v3 + le32(buf, at + 8) * xx32Prime2, 13) * xx32Prime1
			v4 = rotl32(v4 + le32(buf, at + 12) * xx32Prime2, 13) * xx32Prime1
		}
	}

	// XXH64 computes an XXH64 over data given in pieces.
	type XXH64 {
		internal seed  uint64
		internal v1    uint64
		internal v2    uint64
		internal v3    uint64
		internal v4    uint64
		internal total int
		// The bytes of a stripe (32) not yet complete.
		internal rest  byte[]

		def new(seed uint64 = 0) {
			self.seed = seed
			rest = []
			reset()
		}

		// reset starts over with the same seed.
		def reset() {
			v1 = seed + xx64Prime1 + xx64Prime2
			v2 = seed + xx64Prime2
			v3 = seed
			v4 = seed - xx64Prime1
			total = 0
			rest.len(0)
		}

		// write feeds the bytes into the checksum and returns how many.
		def write(buf byte[]) int {
			let n = buf.len()
			total += n
			let at = 0
			if rest.len() > 0 {
				for at < n && rest.len() < 32 {
					rest.push(buf[at])
					at++
				}
				return n when rest.len() < 32
				stripe(rest, 0)
				rest.len(0)
			}
			for at + 32 <= n {
				stripe(buf, at)
				at += 32
			}
			for at < n {
				rest.push(buf[at])
				at++
			}
			return n
		}

		// sum returns the checksum of everything written so far; more may be
		// written after it.
		def sum() uint64 {
			let h = seed + xx64Prime5
			if total >= 32 {
				h = rotl64(v1, 1) + rotl64(v2, 7) + rotl64(v3, 12) + rotl64(v4, 18)
				h = (h ^ xx64Round(uint64(0), v1)) * xx64Prime1 + xx64Prime4
				h = (h ^ xx64Round(uint64(0), v2)) * xx64Prime1 + xx64Prime4
				h = (h ^ xx64Round(uint64(0), v3)) * xx64Prime1 + xx64Prime4
				h = (h ^ xx64Round(uint64(0), v4)) * xx64Prime1 + xx64Prime4
			}
			h += uint64(total)
			let at = 0
			let left = rest.len()
			for at + 8 <= left {
				h = h ^ xx64Round(uint64(0), le64(rest, at))
				h = rotl64(h, 27) * xx64Prime1 + xx64Prime4
				at += 8
			}
			if at + 4 <= left {
				h = h ^ (uint64(le32(rest, at)) * xx64Prime1)
				h = rotl64(h, 23) * xx64Prime2 + xx64Prime3
				at += 4
			}
			for at < left {
				h = h ^ (uint64(rest[at]) * xx64Prime5)
				h = rotl64(h, 11) * xx64Prime1
				at++
			}
			h = h ^ (h >> 33)
			h *= xx64Prime2
			h = h ^ (h >> 29)
			h *= xx64Prime3
			return h ^ (h >> 32)
		}

		internal def stripe(buf byte[], at int) {
			v1 = xx64Round(v1, le64(buf, at))
			v2 = xx64Round(v2, le64(buf, at + 8))
			v3 = xx64Round(v3, le64(buf, at + 16))
			v4 = xx64Round(v4, le64(buf, at + 24))
		}
	}

	internal def xx64Round(acc uint64, input uint64) uint64 {
		return rotl64(acc + input * xx64Prime2, 31) * xx64Prime1
	}

	internal def le32(buf byte[], at int) uint32 {
		return uint32(buf[at]) | (uint32(buf[at + 1]) << 8) | (uint32(buf[at + 2]) << 16) | (uint32(buf[at + 3]) << 24)
	}

	internal def le64(buf byte[], at int) uint64 {
		return uint64(le32(buf, at)) | (uint64(le32(buf, at + 4)) << 32)
	}
}
