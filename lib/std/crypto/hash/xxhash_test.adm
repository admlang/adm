partial module std.crypto.hash {
	check "xxHash and CRC-32C" {
		use std.testing

		// Published values of the reference implementation.
		@test()
		def TestXXH32() {
			assert xxh32([]) == 0x02CC5D05
			assert xxh32("abc".bytes()) == 0x32D153FF
			assert xxh32("Nobody inspects the spammish repetition".bytes()) == 0xE2293B2F
			assert xxh32("abc".bytes(), 1) != xxh32("abc".bytes())
		}

		@test()
		def TestXXH64() {
			assert xxh64([]) == uint64(0xEF46DB3751D8E999)
			assert xxh64("abc".bytes()) == uint64(0x44BC2CF5AD770999)
			assert xxh64("Nobody inspects the spammish repetition".bytes()) == uint64(0xFBCEA83C8A378BF1)
		}

		// Any split of the input gives the one-shot value.
		@test()
		def TestPiecesAgree() {
			let data byte[] = []
			for let i = 0; i < 1000; i++ {
				data.push(byte((i * 31 + 7) & 0xFF))
			}
			for let (_, cut) in int[0, 1, 3, 15, 16, 17, 31, 32, 33, 100, 999, 1000] {
				let a = new XXH32(5)
				a.write(data[0:cut])
				let early = a.sum()
				a.write(data[cut:])
				assert a.sum() == xxh32(data, 5)
				assert early == xxh32(data[0:cut], 5)
				let b = new XXH64(9)
				b.write(data[0:cut])
				b.write(data[cut:])
				assert b.sum() == xxh64(data, 9)
			}
			let h = new XXH64()
			for let i = 0; i < data.len(); i++ {
				h.write(data[i:i + 1])
			}
			assert h.sum() == xxh64(data)
			h.reset()
			assert h.sum() == xxh64([])
		}

		@test()
		def TestCRC32C() {
			assert crc32c("123456789".bytes()) == 0xE3069283
			assert crc32c([]) == 0
			assert crc32c("56789".bytes(), crc32c("1234".bytes())) == 0xE3069283
			let zeros byte[] = []
			zeros.len(32)
			assert crc32c(zeros) == 0x8A9136AA
		}
	}
}
