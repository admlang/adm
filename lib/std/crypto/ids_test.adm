partial module std.crypto {
	use (
		std.testing
		std.time
	)

	check "ULID" {
		// The specification's timestamp vector: 1469918176385 ms is `01ARYZ6S41`; the
		// largest ULID is `7ZZ…Z`, and anything above it does not fit 128 bits.
		@test()
		def matchesTheSpecification() !none {
			let id = new ULID(time.fromUnixNs(int64(1469918176385) * 1000000))
			assert id.str().startsWith("01ARYZ6S41") && id.str().len() == 26
			assert id.timestamp().unixNs() == int64(1469918176385) * 1000000
			let max = try parseULID("7ZZZZZZZZZZZZZZZZZZZZZZZZZ")
			for let b in max.bytes() {
				assert b == 0xFF
			}
			assert parseULID("80000000000000000000000000") is error
			let lower = try parseULID("01aryz6s41tsv4rrffq69g5fav")
			assert lower.str() == "01ARYZ6S41TSV4RRFFQ69G5FAV"
			assert (try parseULID(lower.bytes())).equals(lower)
		}

		// Wrong length, a letter outside the alphabet (I, L, O, U) and 15 bytes are refused.
		@test()
		def rejectsMalformedInput() {
			for let text in ["", "01ARYZ6S41TSV4RRFFQ69G5FA", "01ARYZ6S41TSV4RRFFQ69G5FAVV", "01ARYZ6S41TSV4RRFFQ69G5FAI", "01ARYZ6S41TSV4RRFFQ69G5FAU", "01ARYZ6S41TSV4RRFFQ69G5FA-"] {
				assert parseULID(text) is error
			}
			let short byte[]
			short.len(15)
			assert parseULID(short) is error
		}

		// Identifiers made one after another sort in that order as text, as bytes and by
		// compare, within one millisecond too, and carry the time they were made at.
		@test()
		def sortsInTheOrderMade() {
			let before = time.wallNs() / 1000000
			let last = new ULID()
			let ms = last.timestamp().unixNs() / 1000000
			assert ms >= before && ms <= time.wallNs() / 1000000
			for let i = 0; i < 2000; i++ {
				let next = new ULID()
				assert next.str() > last.str()
				assert next.compare(last) == 1 && last.compare(next) == -1 && next.compare(next) == 0
				last = next
			}
		}

		// Equal bytes are one map key; the UUID view holds the same bits.
		@test()
		def identifiersAreMapKeys() !none {
			let a = new ULID()
			let again = try parseULID(a.str().lower())
			let seen = map<ULID, int>{}
			seen = seen.set(a, 1)
			seen = seen.set(again, 2)
			assert seen.len() == 1 && a.hash() == again.hash()
			assert a.uuid().bytes().equals(a.bytes())
			let copy = a.bytes()
			copy[0] = copy[0] ^ 0xFF
			assert a.equals(again)
		}
	}

	check "KSUID" {
		// The reference implementation's example: its bytes, its second, its payload; the
		// smallest and largest KSUID, and one past the largest.
		@test()
		def matchesTheReference() !none {
			let id = try parseKSUID("0ujtsYcgvSTl8PAuAdqWYSMnLOv")
			assert id.bytes().hex().lower() == "0669f7efb5a1cd34b5f99d1154fb6853345c9735"
			assert id.timestamp().unixNs() == int64(1507608047) * 1000000000
			assert id.payload().hex().lower() == "b5a1cd34b5f99d1154fb6853345c9735"
			assert id.str() == "0ujtsYcgvSTl8PAuAdqWYSMnLOv"
			assert (try parseKSUID(id.bytes())).equals(id)
			let min = try parseKSUID("000000000000000000000000000")
			assert min.timestamp().unixNs() == int64(1400000000) * 1000000000
			let max = try parseKSUID("aWgEPTl1tmebfsQzFP4bxwgy80V")
			for let b in max.bytes() {
				assert b == 0xFF
			}
			assert parseKSUID("aWgEPTl1tmebfsQzFP4bxwgy80W") is error
			assert parseKSUID("zzzzzzzzzzzzzzzzzzzzzzzzzzz") is error
		}

		@test()
		def rejectsMalformedInput() {
			for let text in ["", "0ujtsYcgvSTl8PAuAdqWYSMnLO", "0ujtsYcgvSTl8PAuAdqWYSMnLOvv", "0ujtsYcgvSTl8PAuAdqWYSMnLO-"] {
				assert parseKSUID(text) is error
			}
			let short byte[]
			short.len(19)
			assert parseKSUID(short) is error
		}

		// A new identifier carries the current second; a later second sorts after an
		// earlier one; equal bytes are one map key.
		@test()
		def ordersBySecond() !none {
			let now = time.wallNs() / 1000000000
			let id = new KSUID()
			let seconds = id.timestamp().unixNs() / 1000000000
			assert seconds >= now && seconds <= time.wallNs() / 1000000000
			let earlier = new KSUID(time.fromUnixNs((now - 10) * 1000000000))
			assert earlier.compare(id) == -1 && earlier.str() < id.str()
			let again = try parseKSUID(id.str())
			let seen = map<KSUID, int>{}
			seen = seen.set(id, 1)
			seen = seen.set(again, 2)
			assert seen.len() == 1 && !new KSUID().equals(id)
		}
	}

	check "NanoID" {
		// 21 characters of the URL-safe alphabet by default; a custom size and alphabet.
		@test()
		def drawsFromTheAlphabet() {
			let id = nanoid()
			assert id.len() == 21
			for let c in id {
				assert nanoidAlphabet.indexOf(string(c)) >= 0
			}
			assert nanoid() != id
			let hex = nanoid(8, "0123456789ABCDEF")
			assert hex.len() == 8
			for let c in hex {
				assert c.isHexDigit()
			}
			let greek = nanoid(5, "αβγ")
			assert greek.len() == 5
		}

		// Over many draws from a 3-symbol alphabet (masked to 4 values, one rejected),
		// each symbol comes up about a third of the time.
		@test()
		def hasNoBias() {
			let counts = map<char, int>{}
			for let c in nanoid(30000, "abc") {
				let n = counts.get(c)
				counts = counts.set(c, n is none ?? (1, n + 1))
			}
			assert counts.len() == 3
			for let (_, n) in counts {
				assert n > 9000 && n < 11000
			}
		}
	}
}
