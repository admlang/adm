partial module std.crypto {
	use std.data.encoding::(ASN1Element, ASN1Tag, OID, asn1Parse, asn1Sequence, asn1OID, asn1Null, asn1BitString, asn1Integer, asn1OctetString, asn1Explicit)

	// PublicKey is any public key of the module: RSA, ECDSA, Ed25519 and
	// Ed448 for signatures, X25519 and X448 for key agreement. Finite-field
	// DH keys stay apart (parseDHPublicKey), since most formats have no
	// form for them.
	type PublicKey = RSAPublicKey | ECDSAPublicKey | Ed25519PublicKey | Ed448PublicKey | X25519PublicKey | X448PublicKey

	// PrivateKey is any private key of the module, as PublicKey.
	type PrivateKey = RSAPrivateKey | ECDSAPrivateKey | Ed25519PrivateKey | Ed448PrivateKey | X25519PrivateKey | X448PrivateKey

	let (
		// oidRSAEncryption is rsaEncryption, the algorithm of an RSA key.
		oidRSAEncryption  = new OID([1, 2, 840, 113549, 1, 1, 1])
		// oidECPublicKey is id-ecPublicKey, the algorithm of an EC key.
		oidECPublicKey    = new OID([1, 2, 840, 10045, 2, 1])
		// oidEd25519 is id-Ed25519.
		oidEd25519        = new OID([1, 3, 101, 112])
		// oidEd448 is id-Ed448.
		oidEd448          = new OID([1, 3, 101, 113])
		// oidX25519 is id-X25519.
		oidX25519         = new OID([1, 3, 101, 110])
		// oidX448 is id-X448.
		oidX448           = new OID([1, 3, 101, 111])
		// oidDHPublicNumber is dhpublicnumber, an X9.42 DH key.
		oidDHPublicNumber = new OID([1, 2, 840, 10046, 2, 1])
		// oidDHKeyAgreement is dhKeyAgreement, a PKCS #3 DH key.
		oidDHKeyAgreement = new OID([1, 2, 840, 113549, 1, 3, 1])
		// oidCurveP224 is secp224r1.
		oidCurveP224      = new OID([1, 3, 132, 0, 33])
		// oidCurveP256 is prime256v1 (secp256r1).
		oidCurveP256      = new OID([1, 2, 840, 10045, 3, 1, 7])
		// oidCurveP384 is secp384r1.
		oidCurveP384      = new OID([1, 3, 132, 0, 34])
		// oidCurveP521 is secp521r1.
		oidCurveP521      = new OID([1, 3, 132, 0, 35])
		// oidCurveSecp256k1 is secp256k1.
		oidCurveSecp256k1 = new OID([1, 3, 132, 0, 10])
	)

	// publicKeyOf is the public half of a private key.
	def publicKeyOf(key PrivateKey) PublicKey {
		match key {
			case RSAPrivateKey:
				return key.publicKey()
			case ECDSAPrivateKey:
				return key.publicKey()
			case Ed25519PrivateKey:
				return key.public
			case Ed448PrivateKey:
				return key.public
			case X25519PrivateKey:
				return key.public
			case X448PrivateKey:
				return key.public
		}
	}

	// curveByOID returns the named curve an OID identifies; none for a
	// curve not implemented here.
	def curveByOID(oid OID) ?curve {
		return p224 when oid.equals(oidCurveP224)
		return p256 when oid.equals(oidCurveP256)
		return p384 when oid.equals(oidCurveP384)
		return p521 when oid.equals(oidCurveP521)
		return secp256k1 when oid.equals(oidCurveSecp256k1)
		return none
	}

	// oidOfCurve returns the OID that names the curve.
	def oidOfCurve(c curve) OID {
		return oidCurveP224 when c.name == "P-224"
		return oidCurveP384 when c.name == "P-384"
		return oidCurveP521 when c.name == "P-521"
		return oidCurveSecp256k1 when c.name == "secp256k1"
		return oidCurveP256
	}

	// parsePKIXPublicKey reads a DER SubjectPublicKeyInfo (the body of a
	// "PUBLIC KEY" PEM block): an RSA, an EC, an Ed25519, Ed448, X25519 or
	// X448 key (RFC 8410).
	// Fails on malformed DER, another algorithm, an unknown curve, or a
	// point off the curve.
	def parsePKIXPublicKey(der byte[]) !PublicKey {
		let spki = asn1Parse(der) onerror fail "x509: SubjectPublicKeyInfo is not DER"
		let algorithm = try spki.at(0)
		let oid = try (try algorithm.at(0)).asOID()
		let key = try (try spki.at(1)).asBitString()
		fail "x509: public key BIT STRING has padding bits" when key.bitLength % 8 != 0
		if oid.equals(oidRSAEncryption) {
			// The parameters must be NULL.
			let params = try algorithm.at(1)
			fail "x509: RSA key has parameters other than NULL" unless params.isTag(ASN1Tag.Null)
			return try parsePKCS1PublicKey(key.bytes)
		}
		if oid.equals(oidEd25519) {
			return newEd25519PublicKey(key.bytes) onerror fail "x509: Ed25519 public key is not a point of the curve"
		}
		if oid.equals(oidEd448) {
			return newEd448PublicKey(key.bytes) onerror fail "x509: Ed448 public key is not a point of the curve"
		}
		return try newX25519PublicKey(key.bytes) when oid.equals(oidX25519)
		return try newX448PublicKey(key.bytes) when oid.equals(oidX448)
		if oid.equals(oidECPublicKey) {
			let namedCurve = try (try algorithm.at(1)).asOID()
			let c = curveByOID(namedCurve)
			fail "x509: unsupported elliptic curve {namedCurve.str()}" when c is none
			let point = unmarshalPoint(c, key.bytes) onerror fail "x509: EC public key is not a point on {c.name}"
			return new ECDSAPublicKey(c, point)
		}
		fail "x509: unsupported public key algorithm {oid.str()}"
	}

	// marshalPKIXPublicKey writes the key as a DER SubjectPublicKeyInfo.
	def marshalPKIXPublicKey(key PublicKey) byte[] {
		if key is RSAPublicKey {
			let rsa RSAPublicKey = key
			let algorithm = asn1Sequence([asn1OID(oidRSAEncryption), asn1Null()])
			return asn1Sequence([algorithm, asn1BitString(marshalPKCS1PublicKey(rsa))]).encode()
		}
		if key is Ed25519PublicKey {
			let ed Ed25519PublicKey = key
			// RFC 8410 §3: no parameters, the key is the 32 bytes themselves.
			return asn1Sequence([asn1Sequence([asn1OID(oidEd25519)]), asn1BitString(ed.bytes)]).encode()
		}
		if key is Ed448PublicKey {
			let ed Ed448PublicKey = key
			return asn1Sequence([asn1Sequence([asn1OID(oidEd448)]), asn1BitString(ed.bytes)]).encode()
		}
		if key is X25519PublicKey {
			let x X25519PublicKey = key
			return asn1Sequence([asn1Sequence([asn1OID(oidX25519)]), asn1BitString(x.bytes)]).encode()
		}
		if key is X448PublicKey {
			let x X448PublicKey = key
			return asn1Sequence([asn1Sequence([asn1OID(oidX448)]), asn1BitString(x.bytes)]).encode()
		}
		let ec ECDSAPublicKey = key
		let algorithm = asn1Sequence([asn1OID(oidECPublicKey), asn1OID(oidOfCurve(ec.curve))])
		return asn1Sequence([algorithm, asn1BitString(marshalPoint(ec.curve, ec.point))]).encode()
	}

	// parsePKCS1PublicKey reads a DER RSAPublicKey (the body of an "RSA
	// PUBLIC KEY" PEM block). Fails on malformed DER, a modulus that is not
	// positive, or an exponent outside 3 to 2^31-1.
	def parsePKCS1PublicKey(der byte[]) !RSAPublicKey {
		let seq = asn1Parse(der) onerror fail "x509: RSA public key is not DER"
		let n = try (try seq.at(0)).asBigInt()
		let e = try (try seq.at(1)).asInt()
		fail "x509: RSA modulus is not positive" when n.sign() <= 0
		fail "x509: RSA public exponent {e} is out of range" when e < 3 || e > 2147483647
		return new RSAPublicKey(n, e)
	}

	// marshalPKCS1PublicKey writes the key as a DER RSAPublicKey.
	def marshalPKCS1PublicKey(key RSAPublicKey) byte[] {
		return asn1Sequence([asn1Integer(key.n), asn1Integer(key.e)]).encode()
	}

	// parsePKCS1PrivateKey reads a DER RSAPrivateKey (the body of an "RSA
	// PRIVATE KEY" PEM block). Fails on malformed DER, a version other than
	// 0 (multi-prime keys are not supported), or a non-positive component.
	def parsePKCS1PrivateKey(der byte[]) !RSAPrivateKey {
		let seq = asn1Parse(der) onerror fail "x509: RSA private key is not DER"
		let version = try (try seq.at(0)).asInt()
		fail "x509: RSA private key version {version} is not supported" when version != 0
		let n = try (try seq.at(1)).asBigInt()
		let e = try (try seq.at(2)).asInt()
		let d = try (try seq.at(3)).asBigInt()
		let p = try (try seq.at(4)).asBigInt()
		let q = try (try seq.at(5)).asBigInt()
		let dp = try (try seq.at(6)).asBigInt()
		let dq = try (try seq.at(7)).asBigInt()
		let qinv = try (try seq.at(8)).asBigInt()
		fail "x509: RSA private key has a non-positive component" when n.sign() <= 0 || d.sign() <= 0 || p.sign() <= 0 || q.sign() <= 0
		fail "x509: RSA public exponent {e} is out of range" when e < 3
		return new RSAPrivateKey(n, e, d, p, q, dp, dq, qinv)
	}

	// parseECPrivateKey reads a DER ECPrivateKey of SEC 1 (the body of an
	// "EC PRIVATE KEY" PEM block). The curve comes from the [0] parameters,
	// or from namedCurve when the key leaves them out, as a PKCS#8 wrapper
	// does. Fails on malformed DER, a version other than 1, an unknown
	// curve, or a scalar outside the curve order.
	def parseECPrivateKey(der byte[], namedCurve ?curve = none) !ECDSAPrivateKey {
		let seq = asn1Parse(der) onerror fail "x509: EC private key is not DER"
		let version = try (try seq.at(0)).asInt()
		fail "x509: EC private key version {version} is not supported" when version != 1
		let scalar = try (try seq.at(1)).asBytes()
		let c = try ecCurveOf(seq.tagged(0), namedCurve)
		fail "x509: EC private key names no curve" when c is none
		let d = parseBigInt(scalar)
		fail "x509: EC private key scalar is out of range" when d.sign() <= 0 || d >= c.n
		let point = scalarBaseMult(c, d)
		fail "x509: EC private key public point does not match the scalar" unless try ecPublicMatches(seq.tagged(1), c, point)
		return new ECDSAPrivateKey(c, d, point)
	}

	// ecCurveOf is the curve the [0] parameters of an ECPrivateKey name,
	// or the fallback when there are none. Fails on an unknown curve.
	internal def ecCurveOf(params ?ASN1Element, fallback ?curve) !?curve {
		return fallback when params is none
		let oid = try (try params.inner()).asOID()
		let c = curveByOID(oid)
		fail "x509: unsupported elliptic curve {oid.str()}" when c is none
		return c
	}

	// ecPublicMatches reports whether the [1] public key of an ECPrivateKey,
	// when present, is the point the scalar gives. Fails when the point is
	// not on the curve.
	internal def ecPublicMatches(tagged ?ASN1Element, c curve, point Point) !bool {
		return true when tagged is none
		let bits = try (try tagged.inner()).asBitString()
		let given = unmarshalPoint(c, bits.bytes) onerror fail "x509: EC private key carries a public point off the curve"
		return given.x == point.x && given.y == point.y
	}

	// parsePKCS8PrivateKey reads a DER PrivateKeyInfo (the body of a
	// "PRIVATE KEY" PEM block, or a OneAsymmetricKey of RFC 5958): an RSA,
	// an EC, an Ed25519, Ed448, X25519 or X448 key (RFC 8410 §7, the seed
	// or scalar in an OCTET STRING). Fails on malformed DER, a version other than 0 or 1,
	// or another algorithm.
	def parsePKCS8PrivateKey(der byte[]) !PrivateKey {
		let info = asn1Parse(der) onerror fail "x509: PKCS#8 private key is not DER"
		let version = try (try info.at(0)).asInt()
		fail "x509: PKCS#8 version {version} is not supported" when version != 0 && version != 1
		let algorithm = try info.at(1)
		let oid = try (try algorithm.at(0)).asOID()
		let key = try (try info.at(2)).asBytes()
		return try parsePKCS1PrivateKey(key) when oid.equals(oidRSAEncryption)
		if oid.equals(oidECPublicKey) {
			let curveOID = try (try algorithm.at(1)).asOID()
			let c = curveByOID(curveOID)
			fail "x509: unsupported elliptic curve {curveOID.str()}" when c is none
			return try parseECPrivateKey(key, c)
		}
		if oid.equals(oidEd25519) || oid.equals(oidEd448) {
			let seed = asn1Parse(key) onerror fail "x509: Edwards private key is not DER"
			let bytes = try seed.asBytes()
			return try newEd25519PrivateKey(bytes) when oid.equals(oidEd25519)
			return try newEd448PrivateKey(bytes)
		}
		if oid.equals(oidX25519) || oid.equals(oidX448) {
			let inner = asn1Parse(key) onerror fail "x509: X25519/X448 private key is not DER"
			let bytes = try inner.asBytes()
			return try newX25519PrivateKey(bytes) when oid.equals(oidX25519)
			return try newX448PrivateKey(bytes)
		}

		fail "x509: unsupported private key algorithm {oid.str()}"
	}

	// marshalPKCS1PrivateKey writes an RSA private key as the DER
	// RSAPrivateKey of RFC 8017 Appendix A.1.2 (version 0).
	def marshalPKCS1PrivateKey(key RSAPrivateKey) byte[] {
		return asn1Sequence([
			asn1Integer(0),
			asn1Integer(key.n),
			asn1Integer(key.e),
			asn1Integer(key.d),
			asn1Integer(key.p),
			asn1Integer(key.q),
			asn1Integer(key.dp),
			asn1Integer(key.dq),
			asn1Integer(key.qinv),
		]).encode()
	}

	// marshalPKCS8PrivateKey writes any private key as the DER PrivateKeyInfo
	// of RFC 5958 (version 0), the form `parsePKCS8PrivateKey` reads back:
	// RSA as PKCS #1 inside, an EC key as the ECPrivateKey of RFC 5915 with
	// its curve named by the algorithm, Edwards and Montgomery keys as their
	// bytes in an OCTET STRING (RFC 8410).
	def marshalPKCS8PrivateKey(key PrivateKey) byte[] {
		match key {
			case RSAPrivateKey:
				let algorithm = asn1Sequence([asn1OID(oidRSAEncryption), asn1Null()])
				return asn1Sequence([asn1Integer(0), algorithm, asn1OctetString(marshalPKCS1PrivateKey(key))]).encode()
			case ECDSAPrivateKey:
				let algorithm = asn1Sequence([asn1OID(oidECPublicKey), asn1OID(oidOfCurve(key.curve))])
				let scalar = key.d.bytes(coordinateSize(key.curve)) onerror recover []
				let inner = asn1Sequence([
					asn1Integer(1),
					asn1OctetString(scalar),
					asn1Explicit(1, asn1BitString(marshalPoint(key.curve, key.point))),
				]).encode()
				return asn1Sequence([asn1Integer(0), algorithm, asn1OctetString(inner)]).encode()
			case Ed25519PrivateKey:
				return marshalPKCS8Bytes(oidEd25519, key.seed)
			case Ed448PrivateKey:
				return marshalPKCS8Bytes(oidEd448, key.seed)
			case X25519PrivateKey:
				return marshalPKCS8Bytes(oidX25519, key.scalar)
			case X448PrivateKey:
				return marshalPKCS8Bytes(oidX448, key.scalar)
		}
	}

	// A PrivateKeyInfo whose key is bytes in an OCTET STRING (RFC 8410 §7).
	internal def marshalPKCS8Bytes(oid OID, bytes byte[]) byte[] {
		let algorithm = asn1Sequence([asn1OID(oid)])
		return asn1Sequence([asn1Integer(0), algorithm, asn1OctetString(asn1OctetString(bytes).encode())]).encode()
	}

	// parseDHPublicKey reads a DER SubjectPublicKeyInfo of an X9.42
	// (dhpublicnumber) or PKCS #3 (dhKeyAgreement) DH key, RFC 3279
	// §2.3.3. Fails on malformed DER, another algorithm, or a key that
	// fails newDHPublicKey.
	def parseDHPublicKey(der byte[]) !DHPublicKey {
		let spki = asn1Parse(der) onerror fail "x509: SubjectPublicKeyInfo is not DER"
		let algorithm = try spki.at(0)
		let oid = try (try algorithm.at(0)).asOID()
		fail "x509: not a DH key" unless oid.equals(oidDHPublicNumber) || oid.equals(oidDHKeyAgreement)
		let key = try (try spki.at(1)).asBitString()
		let params = try dhParametersOf(oid, try algorithm.at(1))
		let y = try (asn1Parse(key.bytes) onerror fail "x509: DH public key is not DER").asBigInt()
		return try newDHPublicKey(params, y)
	}

	// parseDHPrivateKey reads a DER PKCS #8 PrivateKeyInfo of an X9.42 or
	// PKCS #3 DH key (x as an INTEGER). Fails on malformed DER, another
	// algorithm, or x out of range.
	def parseDHPrivateKey(der byte[]) !DHPrivateKey {
		let info = asn1Parse(der) onerror fail "x509: PKCS#8 private key is not DER"
		let algorithm = try info.at(1)
		let oid = try (try algorithm.at(0)).asOID()
		fail "x509: not a DH key" unless oid.equals(oidDHPublicNumber) || oid.equals(oidDHKeyAgreement)
		let params = try dhParametersOf(oid, try algorithm.at(1))
		let x = try (asn1Parse(try (try info.at(2)).asBytes()) onerror fail "x509: DH private key is not DER").asBigInt()
		return try newDHPrivateKey(params, x)
	}

	// dhParametersOf reads X9.42 DomainParameters (p, g, q, then optional
	// j and validation parameters) or a PKCS #3 DHParameter (p, g, then an
	// optional private value length). Fails on malformed DER.
	internal def dhParametersOf(oid OID, params ASN1Element) !DHParameters {
		let p = try (try params.at(0)).asBigInt()
		let g = try (try params.at(1)).asBigInt()
		fail "x509: DH parameters out of range" when p.bitLen() < 8 || g < bigint(2) || g >= p
		return DHParameters{p: p, g: g, q: none} when oid.equals(oidDHKeyAgreement)
		return DHParameters{p: p, g: g, q: try (try params.at(2)).asBigInt()}
	}
}
