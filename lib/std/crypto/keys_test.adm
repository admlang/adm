	// der is the DER body of one PEM block.
	internal def der(pem string) byte[] {
		let block = pemDecode(pem) onerror recover new PEMBlock("", [])
		return block.bytes
	}

	check "Keys" {
		internal def asRSA(key PublicKey) RSAPublicKey {
			if key is RSAPublicKey {
				let rsa RSAPublicKey = key
				return rsa
			}
			return new RSAPublicKey(bigint(0), 0)
		}

		internal def asEC(key PublicKey) ECDSAPublicKey {
			if key is ECDSAPublicKey {
				let ec ECDSAPublicKey = key
				return ec
			}
			return new ECDSAPublicKey(p256, infinity())
		}

		internal def asRSAPrivate(key PrivateKey) RSAPrivateKey {
			if key is RSAPrivateKey {
				let rsa RSAPrivateKey = key
				return rsa
			}
			return new RSAPrivateKey(bigint(0), 0, bigint(0), bigint(0), bigint(0), bigint(0), bigint(0), bigint(0))
		}

		internal def asECPrivate(key PrivateKey) ECDSAPrivateKey {
			if key is ECDSAPrivateKey {
				let ec ECDSAPrivateKey = key
				return ec
			}
			return new ECDSAPrivateKey(p256, bigint(0), infinity())
		}

		@test()
		def TestRSAPublicKeys() !none {
			let key = try parsePKIXPublicKey(der(rsaPublicPEM))
			assert key is RSAPublicKey
			let rsa = asRSA(key)
			assert rsa.e == 65537
			assert rsa.n.bitLen() == 2048
			assert rsa.n.hex().startsWith("b827f6c14174cd72fb76a8")
			assert marshalPKIXPublicKey(rsa).hex() == der(rsaPublicPEM).hex()
			let pkcs1 = try parsePKCS1PublicKey(der(rsaPublicPKCS1PEM))
			assert pkcs1.n == rsa.n && pkcs1.e == rsa.e
			assert marshalPKCS1PublicKey(pkcs1).hex() == der(rsaPublicPKCS1PEM).hex()
		}

		@test()
		def TestRSAPrivateKeys() !none {
			let pkcs1 = try parsePKCS1PrivateKey(der(rsaPrivatePKCS1PEM))
			assert pkcs1.e == 65537
			assert pkcs1.p * pkcs1.q == pkcs1.n
			let de = pkcs1.d * bigint(65537)
			assert de.mod(pkcs1.p - bigint(1)) == bigint(1) && de.mod(pkcs1.q - bigint(1)) == bigint(1)
			assert pkcs1.dp == pkcs1.d.mod(pkcs1.p - bigint(1)) && pkcs1.dq == pkcs1.d.mod(pkcs1.q - bigint(1))
			assert pkcs1.publicKey().n == pkcs1.n
			let pkcs8 = try parsePKCS8PrivateKey(der(rsaPrivatePKCS8PEM))
			assert pkcs8 is RSAPrivateKey
			let rsa = asRSAPrivate(pkcs8)
			assert rsa.d == pkcs1.d && rsa.qinv == pkcs1.qinv
		}

		@test()
		def TestECKeys() !none {
			let public = try parsePKIXPublicKey(der(ecPublicPEM))
			assert public is ECDSAPublicKey
			let ec = asEC(public)
			assert ec.curve.name == "P-256"
			assert marshalPKIXPublicKey(ec).hex() == der(ecPublicPEM).hex()
			let sec1 = try parseECPrivateKey(der(ecPrivateSEC1PEM))
			assert sec1.curve.name == "P-256"
			assert sec1.d.hex().startsWith("6bb8e2a74c6091c7")
			assert sec1.point.x == ec.point.x && sec1.point.y == ec.point.y
			assert sec1.publicKey().point.y == ec.point.y
			let pkcs8 = try parsePKCS8PrivateKey(der(ecPrivatePKCS8PEM))
			assert pkcs8 is ECDSAPrivateKey
			let inner = asECPrivate(pkcs8)
			assert inner.d == sec1.d
			let named = curveByOID(oidOfCurve(p384))
			fail "P-384 by OID" when named is none
			assert named.name == "P-384"
		}

		@test()
		def TestKeyErrors() {
			let garbage = parsePKIXPublicKey(byte[1, 2, 3]) onerror recover new RSAPublicKey(bigint(7), 3)
			assert garbage is RSAPublicKey
			// An RSA SubjectPublicKeyInfo is not a PKCS#1 RSAPublicKey.
			let wrongShape = parsePKCS1PublicKey(der(rsaPublicPEM)) onerror recover new RSAPublicKey(bigint(7), 3)
			assert wrongShape.e == 3
			// A PKCS#8 body is not a PKCS#1 private key.
			let wrongKind = parsePKCS1PrivateKey(der(rsaPrivatePKCS8PEM)) onerror recover new RSAPrivateKey(bigint(1), 3, bigint(1), bigint(1), bigint(1), bigint(1), bigint(1), bigint(1))
			assert wrongKind.e == 3
			// A SEC 1 key without parameters needs a curve.
			let noCurve = parseECPrivateKey(der(ecPrivatePKCS8PEM)) onerror recover new ECDSAPrivateKey(p256, bigint(9), infinity())
			assert noCurve.d == bigint(9)
			assert curveByOID(oidRSAEncryption) is none
		}

		@test()
		def TestEdwardsKeys() !none {
			// OpenSSL `genpkey -algorithm ed448` / `ed25519`: the PKCS#8 key,
			// its SubjectPublicKeyInfo and its signature over "abc".
			let cases = [
				[
					"3047020100300506032b6571043b0439de082092aa71b34ea51647005151846fbe72e0abe9e42ea75d2549d09175a88681a5f42f1e2cfa340646dd10c5515a0d8e6e0aef780c0cc907",
					"3043300506032b6571033a005081f6abede798d5c66e6545999c394f7b6ed049d6be6a24750db93e5914765b25f151c4c0773d1dadecefa0d436460c8a6a847171c773fd00",
					"712b3a1dd271f6769ecd9e6fda49be2ad86019f78562e8d4a8a8f8956548c32361b256c5afc490520a5ef3dbca49351a8f46ee053a4acb22805c2a75f6e711efe664d62621770523bf1f7868c48d9e2ebf2d1c81130cc8ff34d4e959e36628b22c172f28c6e667b9a0c2462edacc41401e00"
				],
				[
					"302e020100300506032b657004220420d7062b962bfceb38c6e8f1996600fe1c235576d0aff35e1a11f2cf74ffb488da",
					"302a300506032b657003210023f4d3397465c43e8ac935c9790ea4aee5051f6c39c7f64662a8c0e9f4b9c76a",
					"62f86b222472157a1ab25934382425c1dd4274b8bf6a19de26314edd83f87c3be442d1cb511bdc6a5cb3b04570cc6f3e01a4e2d00cbbc7969793cd8c964c5e09"
				]
			]
			for let c in cases {
				let private = try parsePKCS8PrivateKey(try hexdecode(c[0]))
				let public = try parsePKIXPublicKey(try hexdecode(c[1]))
				assert marshalPKIXPublicKey(public).hex().lower() == c[1]
				match private {
					case Ed448PrivateKey:
						assert (try private.sign("abc".bytes())).hex().lower() == c[2]
						assert marshalPKIXPublicKey(private.public).hex().lower() == c[1]
					case Ed25519PrivateKey:
						assert private.sign("abc".bytes()).hex().lower() == c[2]
						assert marshalPKIXPublicKey(private.public).hex().lower() == c[1]
					default:
						assert false
				}
			}
		}

		@test()
		def TestSecp256k1() !none {
			// OpenSSL secp256k1 keys: a PKCS#8 key, its SubjectPublicKeyInfo,
			// its signature over SHA-256("abc"), and ECDH with a second key.
			let private = asECPrivate(try parsePKCS8PrivateKey(try hexdecode("308184020100301006072a8648ce3d020106052b8104000a046d306b0201010420a34874b126cca12b420f90405e4c28c359f28008a1ffc2fb4e301ffb92a146b6a144034200043f663750f5a119ed531ebcf3b6b2fe0cca197c892ab9db29df20f656de79279380ad6f46d92649e5fcb065a078413f39ad5125ed29b5f1a2e4375dafd3deaaba")))
			assert private.curve.name == "secp256k1"
			let public = asEC(try parsePKIXPublicKey(try hexdecode("3056301006072a8648ce3d020106052b8104000a034200043f663750f5a119ed531ebcf3b6b2fe0cca197c892ab9db29df20f656de79279380ad6f46d92649e5fcb065a078413f39ad5125ed29b5f1a2e4375dafd3deaaba")))
			assert marshalPKIXPublicKey(public).hex().lower() == "3056301006072a8648ce3d020106052b8104000a034200043f663750f5a119ed531ebcf3b6b2fe0cca197c892ab9db29df20f656de79279380ad6f46d92649e5fcb065a078413f39ad5125ed29b5f1a2e4375dafd3deaaba"
			assert isOnCurve(secp256k1, public.point) && !isOnCurve(p256, public.point)
			let digest = try hexdecode("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
			let (r, s) = try parseECDSASignature(try hexdecode("304402200706e854d4237f8b3619a9ec4d2b3365d7bc7f7a9670ffb1745407abc6c756fc02202b21cacaef024a1dae9ee06b78e08a51e88426fdaf66e2a7daa00fc0e37f49c7"))
			assert public.verify(digest, r, s)
			assert !public.verify(digest, s, r)
			let (r2, s2) = try private.sign(digest)
			assert public.verify(digest, r2, s2)
			let peer = asEC(try parsePKIXPublicKey(try hexdecode("3056301006072a8648ce3d020106052b8104000a03420004045a11111f1b08388776c14db8fa002a6a2248be6ead324dc445b10aeb470f34bca495b4fb057cde75874051f6255b88338170bfa34f081367dfef8b4e04a573")))
			assert (try ecdh(secp256k1, private.d, peer.point)).hex().lower() == "27521c8cb88ff781f29e82c105fe3cd420d5bf0744856794954b8416380a8067"
			let generated = try generateECDSAKey(secp256k1)
			assert isOnCurve(secp256k1, generated.point)
		}

		// Agreement keys from `openssl genpkey` (X25519, X448, DHX with the
		// RFC 5114 2048/224 group, DH with ffdhe2048) and the secrets
		// `openssl pkeyutl -derive` computed between them.
		internal const agreeX25519Private = "MC4CAQAwBQYDK2VuBCIEIHDsiUDHgHy3Gv11DV9qIWm0F849Y0Els90y0eGM1X1Y"
		internal const agreeX25519Peer = "MCowBQYDK2VuAyEAquKloiBtif04bJu2X8cjwmaE9crAjyaw2X5UNH0e6Bk="
		internal const agreeX25519Secret = "712d0e5c082f3d2997ebe36e389aa3ba29577658d219f818b2be291e5225145f"
		internal const agreeX448Private = "MEYCAQAwBQYDK2VvBDoEOHjomGGRi/b5sVpez1nE6hVFUPgpIUuKnHc6ho7b39feKCv9injx6HymV3neyYUiiHI4JYoaCDmm"
		internal const agreeX448Peer = "MEIwBQYDK2VvAzkAyGe8FuHbFMfiEVd62UR9BVyoBY6+RoW4ZJAaf7TeAPQCtgQtYwSGiEuDldQwGKeY+4BXClFLBqw="
		internal const agreeX448Secret = "6641b91d6abe4df0e3993a66b8b15eda1a9578509825547d8b3db80115684b6e7780202526b6bf787cf75387e2b0efff3ccd2f6d900e95c6"
		internal const agreeDHXPrivate = ""
		internal const agreeDHXPeer = ""
		internal const agreeDHXSecret = ""
		internal const agreeDHPrivate = ""
		internal const agreeDHPeer = ""
		internal const agreeDHSecret = ""

		@test()
		def TestAgreementKeys() !none {
			let x25519 = try parsePKCS8PrivateKey(try new Base64().decode(agreeX25519Private))
			let x25519Peer = try parsePKIXPublicKey(try new Base64().decode(agreeX25519Peer))
			match x25519 {
				case X25519PrivateKey:
					match x25519Peer {
						case X25519PublicKey:
							assert hexencode(try x25519.sharedSecret(x25519Peer)) == agreeX25519Secret
						default:
							fail "not an X25519 peer"
					}
				default:
					fail "not an X25519 key"
			}
			assert hexencode(marshalPKIXPublicKey(x25519Peer)) == hexencode(try new Base64().decode(agreeX25519Peer))
			let x448 = try parsePKCS8PrivateKey(try new Base64().decode(agreeX448Private))
			let x448Peer = try parsePKIXPublicKey(try new Base64().decode(agreeX448Peer))
			match x448 {
				case X448PrivateKey:
					match x448Peer {
						case X448PublicKey:
							assert hexencode(try x448.sharedSecret(x448Peer)) == agreeX448Secret
						default:
							fail "not an X448 peer"
					}
				default:
					fail "not an X448 key"
			}
			assert hexencode(marshalPKIXPublicKey(x448Peer)) == hexencode(try new Base64().decode(agreeX448Peer))
			assert publicKeyOf(x448) is X448PublicKey
			// X9.42 keys carry q and are checked against the subgroup; PKCS #3
			// keys do not.
			let dhx = try parseDHPrivateKey(try new Base64().decode(agreeDHXPrivate))
			let dhxPeer = try parseDHPublicKey(try new Base64().decode(agreeDHXPeer))
			assert !(dhx.params.q is none)
			assert hexencode(try dhx.sharedSecret(dhxPeer)) == agreeDHXSecret
			let dh = try parseDHPrivateKey(try new Base64().decode(agreeDHPrivate))
			let dhPeer = try parseDHPublicKey(try new Base64().decode(agreeDHPeer))
			assert dh.params.q is none
			assert hexencode(try dh.sharedSecret(dhPeer)) == agreeDHSecret
			// Mixed parameters, an out-of-range value and a value outside the
			// subgroup are refused.
			assert dh.sharedSecret(dhxPeer) is error
			assert newDHPublicKey(dhx.params, bigint(1)) is error
			let q = dhx.params.q
			fail "no q" when q is none
			let outside = newDHPublicKey(dhx.params, dhx.params.p - bigint(2))
			assert outside is error
			// Generated keys agree with each other.
			let a = try generateDHKey(dhx.params)
			let b = try generateDHKey(dhx.params)
			assert hexencode(try a.sharedSecret(b.public)) == hexencode(try b.sharedSecret(a.public))
			let ga = try generateX25519Key()
			let gb = try generateX448Key()
			assert (try ga.sharedSecret(ga.public)).len() == 32 && gb.public.bytes.len() == 56
		}
	}

	check "PKCS#8 marshal" {
		// Every private key kind marshals to the PrivateKeyInfo its parser
		// reads back with the same public key, and a generated key
		// round-trips the same way.
		@test()
		def privateKeysRoundTrip() !none {
			let keys PrivateKey[] = [
				try generateEd25519Key(),
				try generateX25519Key(),
				try generateECDSAKey(p256),
				try generateECDSAKey(p384),
				try generateRSAKey(1024),
			]
			for let key in keys {
				let der = marshalPKCS8PrivateKey(key)
				let back = try parsePKCS8PrivateKey(der)
				assert marshalPKIXPublicKey(publicKeyOf(back)).equals(marshalPKIXPublicKey(publicKeyOf(key)))
				assert marshalPKCS8PrivateKey(back).equals(der)
			}
		}
	}
}
