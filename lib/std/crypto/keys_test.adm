	internal const ecPublicPEM = "-----BEGIN PUBLIC KEY-----\n" +
		"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEeOUVDuVDK01LyudSGVPPymFrMhOk\n" +
