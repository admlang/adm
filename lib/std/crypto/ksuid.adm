partial module std.crypto {
	use std.time

	// The base62 alphabet a KSUID is written in: digits, upper case, lower case.
	internal const ksuidAlphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".bytes()

	// The Unix second a KSUID's timestamp counts from (2014-05-13T16:53:20Z).
	internal const ksuidEpoch int64 = 1400000000

	// KSUID is a 160-bit identifier that sorts by the second it was made: 32
	// bits of seconds since 2014-05-13T16:53:20Z followed by 128 random bits,
	// written as 27 base62 characters (github.com/segmentio/ksuid). Identifiers
	// made in a later second sort after those made earlier, as text and as
	// bytes; within one second the order is random. Two identifiers of the same
	// bytes are equal, and a KSUID is a map key.
	@portable
	type KSUID {
		internal ksuid byte[]

		// A new identifier for the current second. Fails an assertion on a
		// system without a random source.
		def new() {
			ksuid = ksuidStamp(time.wallNs() / 1000000000)
		}

		// A new identifier for the second of `at`. A time before 2014-05-13T16:53:20Z
		// or 2^32 seconds after it (the year 2150) fails an assertion.
		def new(at time.Time) {
			ksuid = ksuidStamp(at.unixNs() / 1000000000)
		}

		// fromBytes sets the identifier from its 20 bytes. Fails when the length
		// is not 20.
		def fromBytes(b byte[]) !none {
			expects {
				assert b.len() == 20 onerror fail "invalid KSUID length"
			}
			ksuid = b.clone()
			return none
		}

		// fromString sets the identifier from its 27 base62 characters and
		// returns it. Fails when the text holds another character, has another
		// length, or is above `aWgEPTl1tmebfsQzFP4bxwgy80V` (a value past 160 bits).
		def fromString(s string) !KSUID {
			let text = s.bytes()
			assert text.len() == 27 onerror fail "invalid KSUID length"
			// 160 bits as five 32-bit words, most significant first: each
			// character multiplies by 62 and adds its value.
			let words = uint64[0, 0, 0, 0, 0]
			for let c in text {
				let digit = ksuidAlphabet.indexOf(c)
				assert digit >= 0 onerror fail "invalid KSUID character"
				let carry = uint64(digit)
				for let i = 4; i >= 0; i-- {
					let v = words[i] * 62 + carry
					words[i] = v & 0xFFFFFFFF
					carry = v >> 32
				}
				assert carry == 0 onerror fail "KSUID out of range"
			}
			let out = byte[]
			out.len(20)
			for let i = 0; i < 5; i++ {
				out[i * 4] = byte(words[i] >> 24)
				out[i * 4 + 1] = byte((words[i] >> 16) & 0xFF)
				out[i * 4 + 2] = byte((words[i] >> 8) & 0xFF)
				out[i * 4 + 3] = byte(words[i] & 0xFF)
			}
			ksuid = out
			return self
		}

		// The 20 bytes of the identifier, a copy.
		def bytes() byte[] {
			return ksuid.clone()
		}

		// The 16 random bytes after the timestamp, a copy.
		def payload() byte[] {
			return ksuid[4:].clone()
		}

		// The second the identifier was made in.
		def timestamp() time.Time {
			let seconds = (int64(ksuid[0]) << 24) | (int64(ksuid[1]) << 16) | (int64(ksuid[2]) << 8) | int64(ksuid[3])
			return time.fromUnixNs((seconds + ksuidEpoch) * 1000000000)
		}

		// Whether the two identifiers hold the same bytes.
		def equals(other KSUID) bool {
			return ksuid.equals(other.ksuid)
		}

		// -1 when this identifier sorts before other, 1 when after, 0 when equal:
		// the order of the bytes, which is the order of the text.
		def compare(other KSUID) int {
			return orderOfBytes(ksuid, other.ksuid)
		}

		// The hash a map keys the identifier by.
		def hash() uint64 {
			return foldHalves(ksuid)
		}

		// str renders the identifier as 27 base62 characters, padded with `0`.
		def str() string {
			let words = uint64[0, 0, 0, 0, 0]
			for let i = 0; i < 5; i++ {
				words[i] = (uint64(ksuid[i * 4]) << 24) | (uint64(ksuid[i * 4 + 1]) << 16) | (uint64(ksuid[i * 4 + 2]) << 8) | uint64(ksuid[i * 4 + 3])
			}
			let out = byte[]
			out.len(27)
			// Long division of the 160-bit value by 62, one digit per pass,
			// least significant first.
			for let at = 26; at >= 0; at-- {
				let rem uint64 = 0
				for let i = 0; i < 5; i++ {
					let v = (rem << 32) | words[i]
					words[i] = v / 62
					rem = v % 62
				}
				out[at] = ksuidAlphabet[int(rem)]
			}
			return string(out)
		}
	}

	// The 20 bytes of a Unix second and 16 random bytes.
	internal def ksuidStamp(unixSeconds int64) byte[] {
		let seconds = unixSeconds - ksuidEpoch
		assert seconds >= 0 && seconds < (int64(1) << 32)
		let out = byte[]
		out.len(20)
		out[0] = byte((seconds >> 24) & 0xFF)
		out[1] = byte((seconds >> 16) & 0xFF)
		out[2] = byte((seconds >> 8) & 0xFF)
		out[3] = byte(seconds & 0xFF)
		uuidRandom(16).copy(out[4:])
		return out
	}

	// parseKSUID returns the KSUID of 27 base62 characters. Fails when the text
	// is not a KSUID.
	def parseKSUID(text string) !KSUID {
		let id = new KSUID()
		try id.fromString(text)
		return id
	}

	// parseKSUID returns the KSUID of 20 bytes. Fails when the length is not 20.
	def parseKSUID(b byte[]) !KSUID {
		let id = new KSUID()
		try id.fromBytes(b)
		return id
	}
}
