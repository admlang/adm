partial module std.crypto {
	use (
		std.crypto.hash::(SHA3256, SHA3512, SHAKE128, shake256)
		std.crypto.mlkem::*
	)

	// MLKEMLevel is an ML-KEM parameter set (FIPS 203 §8): the security
	// category and key sizes. ML-KEM-768 is what TLS and SSH use.
	enum MLKEMLevel {
		MLKEM512  = 512,
		MLKEM768  = 768,
		MLKEM1024 = 1024,
	}

	// MLKEMPublicKey is an ML-KEM encapsulation key: anyone holding it
	// can make a shared secret only the private key's holder recovers.
	//
	// ```
	// let alice = try crypto.generateMLKEMKey()
	// let (secret, ciphertext) = try alice.publicKey().encapsulate()
	// assert (try alice.decapsulate(ciphertext)).equals(secret)
	// ```
	type MLKEMPublicKey {
		level            MLKEMLevel
		internal encoded byte[]
		internal t       int[][]
		internal rho     byte[]

		def new(level MLKEMLevel, encoded byte[], t int[][], rho byte[]) {
			self.level = level
			self.encoded = encoded
			self.t = t
			self.rho = rho
		}

		// The key as sent on the wire: 800, 1184 or 1568 bytes.
		def bytes() byte[] {
			return encoded
		}

		// A fresh 32-byte shared secret and the ciphertext that carries
		// it to the private key's holder. Fails when the random source
		// does.
		def encapsulate() !(byte[], byte[]) {
			return mlkemEncapsulate(mlkemParams(level), t, rho, encoded, try rand(32))
		}
	}

	// MLKEMPrivateKey is an ML-KEM decapsulation key, kept as the 64-byte
	// seed it grows from (FIPS 203 §7.1).
	type MLKEMPrivateKey {
		level         MLKEMLevel
		internal seed byte[]
		internal s    int[][]
		internal t    int[][]
		internal rho  byte[]
		internal pub  MLKEMPublicKey
		internal hash byte[]

		def new(level MLKEMLevel, seed byte[], s int[][], t int[][], rho byte[], pub MLKEMPublicKey) {
			self.level = level
			self.seed = seed
			self.s = s
			self.t = t
			self.rho = rho
			self.pub = pub
			hash = new SHA3256().hash(pub.bytes())
		}

		// The matching encapsulation key.
		def publicKey() MLKEMPublicKey {
			return pub
		}

		// The 64-byte seed (d then z) the key is rebuilt from with
		// `newMLKEMPrivateKey`. Keep it secret.
		def bytes() byte[] {
			return seed
		}

		// The shared secret a ciphertext from `encapsulate` carries. A
		// ciphertext that was tampered with yields an unrelated secret
		// rather than an error (implicit rejection), so the handshake
		// fails later without telling an attacker why. Fails when the
		// ciphertext has the wrong length.
		def decapsulate(ciphertext byte[]) !byte[] {
			let p = mlkemParams(level)
			fail "ML-KEM ciphertext is {ciphertext.len()} bytes, not {32 * (p.du * p.k + p.dv)}" when ciphertext.len() != 32 * (p.du * p.k + p.dv)
			let m = mlkemDecrypt(p, s, ciphertext)
			let g = new SHA3512().hash(m + hash)
			let rejected = shake256(seed[32:] + ciphertext, 32)
			let again = mlkemEncrypt(p, t, rho, m, g[32:])
			let good = constantTimeEqual(again, ciphertext) ?? (1, 0)
			let out byte[] = []
			out.len(32)
			for let i = 0; i < 32; i++ {
				out[i] = byte(constantTimeSelect(good, uint64(g[i]), uint64(rejected[i])))
			}
			return out
		}
	}

	// generateMLKEMKey makes a fresh ML-KEM key pair. Fails when the
	// random source does.
	def generateMLKEMKey(level MLKEMLevel = MLKEMLevel.MLKEM768) !MLKEMPrivateKey {
		return try newMLKEMPrivateKey(try rand(64), level)
	}

	// newMLKEMPrivateKey rebuilds a key pair from its 64-byte seed (d
	// then z, FIPS 203 Algorithm 16). Fails when the seed is not 64
	// bytes.
	def newMLKEMPrivateKey(seed byte[], level MLKEMLevel = MLKEMLevel.MLKEM768) !MLKEMPrivateKey {
		fail "ML-KEM seed is {seed.len()} bytes, not 64" when seed.len() != 64
		let p = mlkemParams(level)
		let g = new SHA3512().hash(seed[:32] + [byte(p.k)])
		let rho = g[:32].clone()
		let sigma = g[32:]
		let a = mlkemMatrix(p.k, rho)
		let s int[][] = []
		let e int[][] = []
		for let i = 0; i < p.k; i++ {
			s.push(mlkemNTT(mlkemCBD(shake256(sigma + [byte(i)], 64 * p.eta1), p.eta1)))
		}
		for let i = 0; i < p.k; i++ {
			e.push(mlkemNTT(mlkemCBD(shake256(sigma + [byte(p.k + i)], 64 * p.eta1), p.eta1)))
		}
		let t int[][] = []
		let encoded byte[] = []
		for let i = 0; i < p.k; i++ {
			let row = e[i]
			for let j = 0; j < p.k; j++ {
				row = mlkemAdd(row, mlkemMul(a[i][j], s[j]))
			}
			t.push(row)
			encoded = encoded + mlkemEncode(row, 12)
		}
		let pub = new MLKEMPublicKey(level, encoded + rho, t, rho)
		return new MLKEMPrivateKey(level, seed.clone(), s, t, rho, pub)
	}

	// newMLKEMPublicKey reads an encapsulation key; its length says the
	// level. Fails when the length fits no level or a coefficient is not
	// below the modulus (FIPS 203 §7.2).
	def newMLKEMPublicKey(data byte[]) !MLKEMPublicKey {
		let (level, t) = try mlkemParsePublic(data)
		return new MLKEMPublicKey(level, data.clone(), t, data[data.len() - 32:].clone())
	}
}

internal partial module std.crypto.mlkem {
	use (
		std.crypto::*
		std.crypto.hash::(SHA3256, SHA3512, SHAKE128, shake256)
	)

	// Encapsulation to an encoded key with the message fixed (FIPS 203
	// Algorithm 17), for known-answer tests. Fails as newMLKEMPublicKey
	// does.
	def mlkemEncapsulateTo(data byte[], m byte[]) !(byte[], byte[]) {
		let (level, t) = try mlkemParsePublic(data)
		return mlkemEncapsulate(mlkemParams(level), t, data[data.len() - 32:], data, m)
	}

	def mlkemEncapsulate(p MLKEMParams, t int[][], rho byte[], encoded byte[], m byte[]) (byte[], byte[]) {
		let g = new SHA3512().hash(m + new SHA3256().hash(encoded))
		let c = mlkemEncrypt(p, t, rho, m, g[32:])
		return (g[:32].clone(), c)
	}

	// The level of an encoded key and its vector t̂.
	def mlkemParsePublic(data byte[]) !(MLKEMLevel, int[][]) {
		let level = data.len() == 800 ?? (MLKEMLevel.MLKEM512, data.len() == 1568 ?? (MLKEMLevel.MLKEM1024, MLKEMLevel.MLKEM768))
		let p = mlkemParams(level)
		fail "ML-KEM public key is {data.len()} bytes" when data.len() != 384 * p.k + 32
		let t int[][] = []
		for let i = 0; i < p.k; i++ {
			let chunk = data[384 * i:384 * (i + 1)]
			let poly = mlkemDecode(chunk, 12)
			for let c in poly {
				fail "ML-KEM public key coefficient out of range" when c >= mlkemQ
			}
			t.push(poly)
		}
		return (level, t)
	}

	// The modulus of ML-KEM's ring.
	const mlkemQ = 3329

	// 17^BitRev7(i) mod q, the NTT's twiddle factors.
	const mlkemZetas = int[
		1, 1729, 2580, 3289, 2642, 630, 1897, 848, 1062, 1919, 193, 797, 2786, 3260, 569, 1746,
		296, 2447, 1339, 1476, 3046, 56, 2240, 1333, 1426, 2094, 535, 2882, 2393, 2879, 1974, 821,
		289, 331, 3253, 1756, 1197, 2304, 2277, 2055, 650, 1977, 2513, 632, 2865, 33, 1320, 1915,
		2319, 1435, 807, 452, 1438, 2868, 1534, 2402, 2647, 2617, 1481, 648, 2474, 3110, 1227, 910,
		17, 2761, 583, 2649, 1637, 723, 2288, 1100, 1409, 2662, 3281, 233, 756, 2156, 3015, 3050,
		1703, 1651, 2789, 1789, 1847, 952, 1461, 2687, 939, 2308, 2437, 2388, 733, 2337, 268, 641,
		1584, 2298, 2037, 3220, 375, 2549, 2090, 1645, 1063, 319, 2773, 757, 2099, 561, 2466, 2594,
		2804, 1092, 403, 1026, 1143, 2150, 2775, 886, 1722, 1212, 1874, 1029, 2110, 2935, 885, 2154
	]

	// 17^(2 BitRev7(i) + 1) mod q, the moduli of the base-case products.
	const mlkemGammas = int[
		17, 3312, 2761, 568, 583, 2746, 2649, 680, 1637, 1692, 723, 2606, 2288, 1041, 1100, 2229,
		1409, 1920, 2662, 667, 3281, 48, 233, 3096, 756, 2573, 2156, 1173, 3015, 314, 3050, 279,
		1703, 1626, 1651, 1678, 2789, 540, 1789, 1540, 1847, 1482, 952, 2377, 1461, 1868, 2687, 642,
		939, 2390, 2308, 1021, 2437, 892, 2388, 941, 733, 2596, 2337, 992, 268, 3061, 641, 2688,
		1584, 1745, 2298, 1031, 2037, 1292, 3220, 109, 375, 2954, 2549, 780, 2090, 1239, 1645, 1684,
		1063, 2266, 319, 3010, 2773, 556, 757, 2572, 2099, 1230, 561, 2768, 2466, 863, 2594, 735,
		2804, 525, 1092, 2237, 403, 2926, 1026, 2303, 1143, 2186, 2150, 1179, 2775, 554, 886, 2443,
		1722, 1607, 1212, 2117, 1874, 1455, 1029, 2300, 2110, 1219, 2935, 394, 885, 2444, 2154, 1175
	]

	// The sizes of one parameter set: the module rank, the noise of the
	// secret, and the bits each ciphertext coefficient keeps.
	struct MLKEMParams {
		k    int
		eta1 int
		du   int
		dv   int
	}

	def mlkemParams(level MLKEMLevel) MLKEMParams {
		return MLKEMParams{k: 2, eta1: 3, du: 10, dv: 4} when level == MLKEMLevel.MLKEM512
		return MLKEMParams{k: 4, eta1: 2, du: 11, dv: 5} when level == MLKEMLevel.MLKEM1024
		return MLKEMParams{k: 3, eta1: 2, du: 10, dv: 4}
	}

	// The public matrix Â, row i column j sampled from ρ‖j‖i (FIPS 203
	// Algorithm 13).
	def mlkemMatrix(k int, rho byte[]) int[][][] {
		let a int[][][] = []
		for let i = 0; i < k; i++ {
			let row int[][] = []
			for let j = 0; j < k; j++ {
				row.push(mlkemSampleNTT(rho + [byte(j), byte(i)]))
			}
			a.push(row)
		}
		return a
	}

	// A polynomial in NTT form drawn uniformly from SHAKE128 output by
	// rejection (Algorithm 7).
	def mlkemSampleNTT(seed byte[]) int[] {
		let xof = new SHAKE128()
		xof.write(seed)
		let out int[] = []
		for out.len() < 256 {
			let c = xof.squeeze(168)
			for let i = 0; i + 3 <= c.len() && out.len() < 256; i += 3 {
				let d1 = int(c[i]) | (int(c[i + 1]) & 15) << 8
				let d2 = int(c[i + 1]) >> 4 | int(c[i + 2]) << 4
				out.push(d1) when d1 < mlkemQ
				out.push(d2) when d2 < mlkemQ && out.len() < 256
			}
		}
		return out
	}

	// A small polynomial from the centred binomial distribution over
	// 64·eta bytes (Algorithm 8).
	def mlkemCBD(b byte[], eta int) int[] {
		let f int[] = []
		f.len(256)
		for let i = 0; i < 256; i++ {
			let x = 0
			let y = 0
			for let j = 0; j < eta; j++ {
				x += mlkemBit(b, 2 * i * eta + j)
				y += mlkemBit(b, 2 * i * eta + eta + j)
			}
			f[i] = (x - y + mlkemQ) % mlkemQ
		}
		return f
	}

	def mlkemBit(b byte[], i int) int {
		return (int(b[i >> 3]) >> (i & 7)) & 1
	}

	// The number-theoretic transform, into a new array (Algorithm 9).
	def mlkemNTT(input int[]) int[] {
		let f = input.clone()
		let k = 1
		for let len = 128; len >= 2; len /= 2 {
			for let start = 0; start < 256; start += 2 * len {
				let zeta = mlkemZetas[k]
				k++
				for let j = start; j < start + len; j++ {
					let t = zeta * f[j + len] % mlkemQ
					f[j + len] = (f[j] - t + mlkemQ) % mlkemQ
					f[j] = (f[j] + t) % mlkemQ
				}
			}
		}
		return f
	}

	// The inverse transform, into a new array (Algorithm 10).
	def mlkemInvNTT(input int[]) int[] {
		let f = input.clone()
		let k = 127
		for let len = 2; len <= 128; len *= 2 {
			for let start = 0; start < 256; start += 2 * len {
				let zeta = mlkemZetas[k]
				k--
				for let j = start; j < start + len; j++ {
					let t = f[j]
					f[j] = (t + f[j + len]) % mlkemQ
					f[j + len] = zeta * (f[j + len] - t + mlkemQ) % mlkemQ
				}
			}
		}
		for let i = 0; i < 256; i++ {
			f[i] = f[i] * 3303 % mlkemQ
		}
		return f
	}

	// The product of two polynomials in NTT form (Algorithms 11, 12).
	def mlkemMul(f int[], g int[]) int[] {
		let h int[] = []
		h.len(256)
		for let i = 0; i < 128; i++ {
			let a0 = f[2 * i]
			let a1 = f[2 * i + 1]
			let b0 = g[2 * i]
			let b1 = g[2 * i + 1]
			h[2 * i] = (a0 * b0 + a1 * b1 % mlkemQ * mlkemGammas[i]) % mlkemQ
			h[2 * i + 1] = (a0 * b1 + a1 * b0) % mlkemQ
		}
		return h
	}

	def mlkemAdd(f int[], g int[]) int[] {
		let h int[] = []
		h.len(256)
		for let i = 0; i < 256; i++ {
			h[i] = (f[i] + g[i]) % mlkemQ
		}
		return h
	}

	// d bits per coefficient, least significant first (Algorithm 5).
	def mlkemEncode(f int[], d int) byte[] {
		let out byte[] = []
		out.len(32 * d)
		let acc = 0
		let bits = 0
		let pos = 0
		for let c in f {
			acc |= c << bits
			bits += d
			for bits >= 8 {
				out[pos] = byte(acc & 0xff)
				pos++
				acc >>= 8
				bits -= 8
			}
		}
		return out
	}

	// The inverse of mlkemEncode (Algorithm 6); 12-bit values are left
	// as read, for the caller's range check.
	def mlkemDecode(b byte[], d int) int[] {
		let f int[] = []
		f.len(256)
		let acc = 0
		let bits = 0
		let pos = 0
		let mask = (1 << d) - 1
		for let i = 0; i < 256; i++ {
			for bits < d {
				acc |= int(b[pos]) << bits
				pos++
				bits += 8
			}
			f[i] = acc & mask
			acc >>= d
			bits -= d
		}
		return f
	}

	// round(2^d · x / q) mod 2^d, for each coefficient (§4.2.1).
	def mlkemCompress(f int[], d int) int[] {
		let out int[] = []
		out.len(256)
		for let i = 0; i < 256; i++ {
			out[i] = ((f[i] << (d + 1)) + mlkemQ) / (2 * mlkemQ) & ((1 << d) - 1)
		}
		return out
	}

	// round(q · y / 2^d), for each coefficient.
	def mlkemDecompress(f int[], d int) int[] {
		let out int[] = []
		out.len(256)
		for let i = 0; i < 256; i++ {
			out[i] = (mlkemQ * f[i] + (1 << (d - 1))) >> d
		}
		return out
	}

	// K-PKE encryption of the 32-byte message m with randomness r
	// (Algorithm 14).
	def mlkemEncrypt(p MLKEMParams, t int[][], rho byte[], m byte[], r byte[]) byte[] {
		let a = mlkemMatrix(p.k, rho)
		let y int[][] = []
		for let i = 0; i < p.k; i++ {
			y.push(mlkemNTT(mlkemCBD(shake256(r + [byte(i)], 64 * p.eta1), p.eta1)))
		}
		let out byte[] = []
		for let i = 0; i < p.k; i++ {
			let sum = mlkemMul(a[0][i], y[0])
			for let j = 1; j < p.k; j++ {
				sum = mlkemAdd(sum, mlkemMul(a[j][i], y[j]))
			}
			let e1 = mlkemCBD(shake256(r + [byte(p.k + i)], 128), 2)
			let u = mlkemAdd(mlkemInvNTT(sum), e1)
			out = out + mlkemEncode(mlkemCompress(u, p.du), p.du)
		}
		let dot = mlkemMul(t[0], y[0])
		for let j = 1; j < p.k; j++ {
			dot = mlkemAdd(dot, mlkemMul(t[j], y[j]))
		}
		let e2 = mlkemCBD(shake256(r + [byte(2 * p.k)], 128), 2)
		let mu = mlkemDecompress(mlkemDecode(m, 1), 1)
		let v = mlkemAdd(mlkemAdd(mlkemInvNTT(dot), e2), mu)
		return out + mlkemEncode(mlkemCompress(v, p.dv), p.dv)
	}

	// K-PKE decryption (Algorithm 15): the 32-byte message.
	def mlkemDecrypt(p MLKEMParams, s int[][], c byte[]) byte[] {
		let size = 32 * p.du
		let dot int[] = []
		for let i = 0; i < p.k; i++ {
			let u = mlkemDecompress(mlkemDecode(c[size * i:size * (i + 1)], p.du), p.du)
			let term = mlkemMul(s[i], mlkemNTT(u))
			dot = i == 0 ?? (term, mlkemAdd(dot, term))
		}
		let v = mlkemDecompress(mlkemDecode(c[size * p.k:], p.dv), p.dv)
		let back = mlkemInvNTT(dot)
		let w int[] = []
		w.len(256)
		for let i = 0; i < 256; i++ {
			w[i] = (v[i] - back[i] + mlkemQ) % mlkemQ
		}
		return mlkemEncode(mlkemCompress(w, 1), 1)
	}
}
