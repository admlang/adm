partial module std.crypto {
	use (
		std.crypto.hash::(SHA3256)
		std.testing
		std.crypto.mlkem::*
	)

	internal def countingBytes(from int, n int) byte[] {
		let out byte[] = []
		for let i = 0; i < n; i++ {
			out.push(byte(from + i))
		}
		return out
	}

	check "ML-KEM" {
		@test()
		def matchesOpenSSL() !none {
			// OpenSSL 3.5: `genpkey -algorithm ML-KEM-<n> -pkeyopt hexseed:00..3f`,
			// then `pkeyutl -encap -pkeyopt hexikme:64..83`. Hashes are SHA3-256
			// of the encapsulation key and the ciphertext; the last column is
			// the implicit-rejection secret of the ciphertext with its first bit
			// flipped.
			let cases = [
				["512", "82F101FF648063B376E2BB6C5B7455F655A50C2FEADADE150EFA0E0E6F365AEA", "144D39E2EA1F02E0404DC85DCA8EF2B51F1813212AB2AF4D8A1D0362C4C60AE8", "3A607CFF6EAFFF95C45DCFB474ABA90719265620A28C465F3F6FFE39D5DC5F18", "3CD6D191751C337DDC40DC3E2FB9CDC1570DDEA75B5497A6BE8DCCA3CA1D7D7C"],
				["768", "A24E16D8F8F9383A95B77050F4D9FD2F5733EEC1D63EF3C23EBF9918173669A7", "CE221A0989A8597AA562B69A8C235EDC93CCF72FADC91D96785C9A09075E5CD1", "C5A74110C158ACBAF9C01DEB86FA6CC10C14533FEDA54BEC1FDD000D61F07E4E", "BB28C25ED3222C13CE49D65F663F1C9F148565A664747E142F1ABE06F33F4826"],
				["1024", "61349E5C131A7E116A0463861D7D18663C5627C38C7147DDAADFD48ACD7A4535", "77E52D3EDDA7ABCB3B355D5F8816BCD0827B2551C4343433CB05E52209E59EFA", "F64FAB54E0B56CCC058BF30D5D5D9DC2023E266432BF4E8009FBBAF3C8602331", "A1F7F46733B963D1ABFCA9B8C7D198CFDD9A634C795F52DC0DA84A8371ACD325"],
			]
			for let c in cases {
				let level = c[0] == "512" ?? (MLKEMLevel.MLKEM512, c[0] == "1024" ?? (MLKEMLevel.MLKEM1024, MLKEMLevel.MLKEM768))
				let key = try newMLKEMPrivateKey(countingBytes(0, 64), level)
				let pub = key.publicKey()
				fail "{c[0]}: public key hash {new SHA3256().hash(pub.bytes()).hex()}" when new SHA3256().hash(pub.bytes()).hex() != c[1]
				let (secret, ciphertext) = try mlkemEncapsulateTo(pub.bytes(), countingBytes(100, 32))
				fail "{c[0]}: ciphertext hash {new SHA3256().hash(ciphertext).hex()}" when new SHA3256().hash(ciphertext).hex() != c[2]
				assert secret.hex() == c[3]
				assert (try key.decapsulate(ciphertext)).hex() == c[3]
				let bad = ciphertext.clone()
				bad[0] = bad[0] ^ byte(1)
				assert (try key.decapsulate(bad)).hex() == c[4]
				// The encoded public key reads back, and random round trips agree.
				let back = try newMLKEMPublicKey(pub.bytes())
				assert back.level == level
				let (s2, ct2) = try back.encapsulate()
				assert (try key.decapsulate(ct2)).equals(s2)
			}
			return none
		}

		@test()
		def refusesBadInput() !none {
			let key = try generateMLKEMKey()
			let code = ""
			key.decapsulate(byte[1, 2, 3]) onerror (err error) {
				code = "short"
				recover byte[]
			}
			assert code == "short"
			let ek = key.publicKey().bytes().clone()
			// A 12-bit coefficient of 4095 is not below q.
			ek[0] = byte(0xff)
			ek[1] = ek[1] | byte(0x0f)
			let refused = false
			newMLKEMPublicKey(ek) onerror (err error) {
				refused = true
				recover key.publicKey()
			}
			assert refused
			return none
		}
	}
}
