partial module std.crypto {
	// The 64 URL-safe characters a NanoID is made of by default: `A-Z`, `a-z`,
	// `0-9`, `_` and `-`.
	const nanoidAlphabet = "useandom-26T198340PX75pxJACKVERYMINDBUSHWOLF_GQZbfghjklqvwyzrict"

	// nanoid returns a random identifier of `size` characters drawn evenly from
	// `alphabet` (github.com/ai/nanoid): 21 URL-safe characters by default, as
	// unlikely to repeat as a random UUID. Each character comes from the
	// system's random source, with no bias towards any character of a custom
	// alphabet. A size below 1, an alphabet of fewer than 2 or more than 256
	// characters, and a system without a random source fail an assertion.
	//
	// Example:
	// ```example
	// let key = nanoid()                         // "V1StGXR8_Z5jdHi6B-myT"
	// let code = nanoid(8, "0123456789ABCDEF")   // "4F90D13A"
	// ```
	def nanoid(size int = 21, alphabet string = nanoidAlphabet) string {
		let symbols = char[]
		for let c in alphabet {
			symbols.push(c)
		}
		assert size > 0 && symbols.len() >= 2 && symbols.len() <= 256
		// Random bytes masked to the smallest power of two that covers the
		// alphabet; values past its end are drawn again, so every symbol is
		// equally likely. The batch is sized for the expected rejections.
		let mask = 1
		for mask < symbols.len() {
			mask = mask << 1
		}
		mask--
		let step = int(float64(mask) * 1.6 * float64(size) / float64(symbols.len())) + 1
		let out = char[]
		out.cap(size)
		for {
			for let b in uuidRandom(step) {
				let at = int(b) & mask
				if at < symbols.len() {
					out.push(symbols[at])
					return out.join("") when out.len() == size
				}
			}
		}
		return ""
	}
}
