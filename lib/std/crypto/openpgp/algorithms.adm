partial module std.crypto.openpgp {
	use (
		std.crypto
		std.crypto.cipher
		std.crypto.cipher::(Block, AEAD)
		std.crypto.hash
		std.crypto.hash::(Hash)
	)

	// Public key algorithms (RFC 9580 §9.1).
	enum PublicKeyAlgorithm {
		RSA = 1,
		RSAEncryptOnly = 2,
		RSASignOnly = 3,
		Elgamal = 16,
		DSA = 17,
		ECDH = 18,
		ECDSA = 19,
		EdDSALegacy = 22,
		X25519 = 25,
		X448 = 26,
		Ed25519 = 27,
		Ed448 = 28,
	}

	// Symmetric ciphers (§9.3). IDEA, TripleDES and CAST5 are read, never
	// written.
	enum SymmetricAlgorithm {
		Plaintext = 0,
		IDEA = 1,
		TripleDES = 2,
		CAST5 = 3,
		Blowfish = 4,
		AES128 = 7,
		AES192 = 8,
		AES256 = 9,
		Twofish = 10,
		Camellia128 = 11,
		Camellia192 = 12,
		Camellia256 = 13,
	}

	// AEAD modes (§9.6).
	enum AEADAlgorithm {
		EAX = 1,
		OCB = 2,
		GCM = 3,
	}

	// Hash algorithms (§9.5).
	enum HashAlgorithm {
		MD5 = 1,
		SHA1 = 2,
		RIPEMD160 = 3,
		SHA256 = 8,
		SHA384 = 9,
		SHA512 = 10,
		SHA224 = 11,
		SHA3_256 = 12,
		SHA3_512 = 14,
	}

	// Compression algorithms (§9.4).
	enum CompressionAlgorithm {
		Uncompressed = 0,
		ZIP = 1,
		ZLIB = 2,
		BZip2 = 3,
	}

	internal def knownSymmetric(id int) bool {
		return id := 1 || 2 || 3 || 4 || 7 || 8 || 9 || 10 || 11 || 12 || 13
	}

	internal def knownHash(id int) bool {
		return id := 1 || 2 || 3 || 8 || 9 || 10 || 11 || 12 || 14
	}

	// The digest of a hash algorithm ID; none for an unknown one.
	internal def hashOf(id int) ?Hash {
		switch id {
			case 1:
				return Hash.MD5
			case 2:
				return Hash.SHA1
			case 3:
				return Hash.RIPEMD160
			case 8:
				return Hash.SHA256
			case 9:
				return Hash.SHA384
			case 10:
				return Hash.SHA512
			case 11:
				return Hash.SHA224
			case 12:
				return Hash.SHA3_256
			case 14:
				return Hash.SHA3_512
			default:
				return none
		}
	}

	internal def mustHash(id int) !Hash {
		let h = hashOf(id)
		fail pgpError("hash algorithm {id} is not known") when h is none
		return h
	}

	// The salt a version 6 signature with this hash carries (§9.5).
	internal def v6SaltSize(hashID int) !int {
		switch hashID {
			case 8, 11, 12:
				return 16
			case 9:
				return 24
			case 10, 14:
				return 32
			default:
				fail pgpError("hash algorithm {hashID} is not for version 6 signatures")
		}
	}

	// The key size of a cipher in octets.
	internal def keySize(cipherID int) !int {
		switch cipherID {
			case 1, 3, 4, 7, 11:
				return 16
			case 2, 8, 12:
				return 24
			case 9, 10, 13:
				return 32
			default:
				fail pgpError("symmetric algorithm {cipherID} is not known")
		}
	}

	internal def blockSizeOf(cipherID int) !int {
		switch cipherID {
			case 1, 2, 3, 4:
				return 8
			case 7, 8, 9, 10, 11, 12, 13:
				return 16
			default:
				fail pgpError("symmetric algorithm {cipherID} is not known")
		}
	}

	// The block cipher of an algorithm ID under a key.
	internal def blockCipher(cipherID int, key byte[]) !Block {
		switch cipherID {
			case 1:
				return try cipher.newIDEA(key)
			case 2:
				return try cipher.newTripleDES(key)
			case 3:
				return try cipher.newCAST5(key)
			case 4:
				return try cipher.newBlowfish(key)
			case 7, 8, 9:
				return try cipher.newAES(key)
			case 10:
				return try cipher.newTwofish(key)
			case 11, 12, 13:
				return try cipher.newCamellia(key)
			default:
				fail pgpError("symmetric algorithm {cipherID} is not known")
		}
	}

	// The nonce length of an AEAD mode.
	internal def aeadNonceSize(mode int) !int {
		switch mode {
			case 1:
				return 16
			case 2:
				return 15
			case 3:
				return 12
			default:
				fail pgpError("AEAD algorithm {mode} is not known")
		}
	}

	// An AEAD mode over a 16-octet block cipher.
	internal def aeadOf(mode int, cipherID int, key byte[]) !AEAD {
		fail pgpError("AEAD needs a 16-octet block cipher, not algorithm {cipherID}") unless (try blockSizeOf(cipherID)) == 16
		let block = try blockCipher(cipherID, key)
		switch mode {
			case 1:
				return try cipher.newEAX(block)
			case 2:
				return try cipher.newOCB(block)
			case 3:
				return try cipher.newGCM(block)
			default:
				fail pgpError("AEAD algorithm {mode} is not known")
		}
	}

	// What a curve OID names (§9.2): a Weierstrass curve for ECDSA and ECDH,
	// or one of the legacy 25519 forms.
	internal enum CurveForm {
		Weierstrass,
		Ed25519Legacy,
		Curve25519Legacy
	}

	internal struct CurveInfo {
		oid   byte[]
		name  string
		form  CurveForm
		// The field size in octets.
		fsize int
	}

	internal const oidP256 = byte[0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x03, 0x01, 0x07]
	internal const oidP384 = byte[0x2B, 0x81, 0x04, 0x00, 0x22]
	internal const oidP521 = byte[0x2B, 0x81, 0x04, 0x00, 0x23]
	internal const oidEd25519Legacy = byte[0x2B, 0x06, 0x01, 0x04, 0x01, 0xDA, 0x47, 0x0F, 0x01]
	internal const oidCurve25519Legacy = byte[0x2B, 0x06, 0x01, 0x04, 0x01, 0x97, 0x55, 0x01, 0x05, 0x01]

	internal def curveInfo(oid byte[]) !CurveInfo {
		let hex = oid.hex()
		switch hex {
			case "2A8648CE3D030107":
				return CurveInfo{oid: oid, name: "P-256", form: CurveForm.Weierstrass, fsize: 32}
			case "2B81040022":
				return CurveInfo{oid: oid, name: "P-384", form: CurveForm.Weierstrass, fsize: 48}
			case "2B81040023":
				return CurveInfo{oid: oid, name: "P-521", form: CurveForm.Weierstrass, fsize: 66}
			case "2B2403030208010107":
				return CurveInfo{oid: oid, name: "brainpoolP256r1", form: CurveForm.Weierstrass, fsize: 32}
			case "2B240303020801010B":
				return CurveInfo{oid: oid, name: "brainpoolP384r1", form: CurveForm.Weierstrass, fsize: 48}
			case "2B240303020801010D":
				return CurveInfo{oid: oid, name: "brainpoolP512r1", form: CurveForm.Weierstrass, fsize: 64}
			case "2B06010401DA470F01":
				return CurveInfo{oid: oid, name: "Ed25519Legacy", form: CurveForm.Ed25519Legacy, fsize: 32}
			case "2B060104019755010501":
				return CurveInfo{oid: oid, name: "Curve25519Legacy", form: CurveForm.Curve25519Legacy, fsize: 32}
			default:
				fail pgpError("the curve OID {hex} is not known")
		}
	}

	// The Weierstrass curve of a CurveInfo.
	internal def weierstrass(info CurveInfo) !crypto.curve {
		switch info.name {
			case "P-256":
				return crypto.p256
			case "P-384":
				return crypto.p384
			case "P-521":
				return crypto.p521
			case "brainpoolP256r1":
				return crypto.brainpoolP256r1
			case "brainpoolP384r1":
				return crypto.brainpoolP384r1
			case "brainpoolP512r1":
				return crypto.brainpoolP512r1
			default:
				fail pgpError("{info.name} is not a Weierstrass curve")
		}
	}

	// The digest of data under a hash algorithm ID.
	internal def digestOf(hashID int, data byte[]) !byte[] {
		return hash.digest(try mustHash(hashID), data)
	}
}
