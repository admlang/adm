partial module std.crypto.openpgp {
	use std.data.encoding::(base64encode, base64decode)

	// What an armored block holds, by its header line (RFC 9580 §6.2.1).
	enum ArmorKind {
		Message,
		PublicKey,
		PrivateKey,
		Signature
	}

	// One ASCII-armored block: its kind, its armor headers (Comment,
	// Charset, ...) and the binary data.
	struct Armored {
		kind    ArmorKind
		headers (string, string)[] = []
		data    byte[]
	}

	internal def armorLabel(kind ArmorKind) string {
		switch kind {
			case ArmorKind.PublicKey:
				return "PGP PUBLIC KEY BLOCK"
			case ArmorKind.PrivateKey:
				return "PGP PRIVATE KEY BLOCK"
			case ArmorKind.Signature:
				return "PGP SIGNATURE"
			default:
				return "PGP MESSAGE"
		}
	}

	// armor writes binary OpenPGP data as ASCII armor: the header line,
	// the armor headers given (name, value), a blank line, base64 in lines
	// of 64 characters, the tail line. The CRC24 footer is written only
	// when `checksum` asks for it (§6.1 discourages it, and forbids it for
	// version 6 data).
	def armor(kind ArmorKind, data byte[], headers (string, string)[] = [], checksum bool = false) string {
		let label = armorLabel(kind)
		let out = "-----BEGIN " + label + "-----\n"
		for let header in headers {
			let (name, value) = header
			out += name + ": " + value + "\n"
		}
		out += "\n"
		let encoded = base64encode(data)
		let i = 0
		for i < encoded.len() {
			let end = i + 64 < encoded.len() ?? (i + 64, encoded.len())
			out += encoded.slice(i, end) + "\n"
			i = end
		}
		if checksum {
			let crc = crc24(data)
			out += "=" + base64encode([byte((crc >> 16) & 0xFF), byte((crc >> 8) & 0xFF), byte(crc & 0xFF)]) + "\n"
		}
		out += "-----END " + label + "-----\n"
		return out
	}

	// dearmor reads every ASCII-armored block of a text (anything around and
	// between them is skipped). A CRC24 footer is ignored, as §6.1 says,
	// whether right or not.
	// Fails when a block has no tail line, an unknown header line, or
	// base64 that does not decode.
	def dearmor(text string) !Armored[] {
		let out Armored[] = []
		let lines = text.replace("\r\n", "\n", -1).replace("\r", "\n", -1).split("\n")
		let i = 0
		for i < lines.len() {
			let line = lines[i].trimEnd(" \t")
			i++
			continue unless line.startsWith("-----BEGIN PGP ") && line.endsWith("-----")
			let label = line[11:line.len() - 5]
			// A cleartext signed message is read by readCleartext.
			continue when label == "PGP SIGNED MESSAGE"
			let kind = try armorKindOf(label)
			let headers (string, string)[] = []
			for i < lines.len() && lines[i].trim() != "" {
				let header = lines[i]
				i++
				let colon = header.indexOf(": ")
				headers.push((header[0:colon], header[colon + 2:].trimEnd(" \t"))) when colon > 0
			}
			i++
			let body = ""
			let closed = false
			for i < lines.len() {
				let current = lines[i].trim()
				i++
				if current.startsWith("-----END ") {
					fail pgpError("the armor of {label} ends with {current}") unless current == "-----END " + label + "-----"
					closed = true
					break
				}
				continue when current.startsWith("=") && current.len() == 5
				body += current.replace(" ", "", -1).replace("\t", "", -1)
			}
			fail pgpError("the armor of {label} has no tail line") unless closed
			let data = base64decode(body) onerror (err error) {
				fail pgpError("the armor of {label} is not base64: {err.message}")
			}
			out.push(Armored{kind: kind, headers: headers, data: data})
		}
		return out
	}

	internal def armorKindOf(label string) !ArmorKind {
		switch label {
			case "PGP MESSAGE":
				return ArmorKind.Message
			case "PGP PUBLIC KEY BLOCK":
				return ArmorKind.PublicKey
			case "PGP PRIVATE KEY BLOCK":
				return ArmorKind.PrivateKey
			case "PGP SIGNATURE":
				return ArmorKind.Signature
			default:
				fail pgpError("\"BEGIN {label}\" is not an armor header line")
		}
	}

	// The data of armored text, or the bytes themselves when they are not
	// armor (binary OpenPGP data starts with a packet tag, bit 7 set).
	internal def binaryOf(data byte[]) !byte[] {
		return data when data.len() > 0 && int(data[0]) & 0x80 != 0
		let blocks = try dearmor(string(data))
		fail pgpError("the text holds no armored OpenPGP data") when blocks.len() == 0
		let out byte[] = []
		for let block in blocks {
			out += block.data
		}
		return out
	}

	// The CRC24 of the armor footer (§6.1).
	internal def crc24(data byte[]) int {
		let crc = 0xB704CE
		for let b in data {
			crc = crc ^ (int(b) << 16)
			for let i = 0; i < 8; i++ {
				crc = crc << 1
				crc = (crc & 0xFFFFFF) ^ 0x864CFB when crc & 0x1000000 != 0
			}
		}
		return crc & 0xFFFFFF
	}
}
