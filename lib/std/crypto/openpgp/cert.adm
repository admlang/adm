partial module std.crypto.openpgp {
	use (
		std.crypto
		std.time
	)

	// A User ID or User Attribute with its signatures, as read and as found
	// valid.
	internal struct UserRecord {
		data        byte[]
		attribute   bool              = false
		certs       SignaturePacket[] = []
		// The certifications and revocations the primary key made that
		// verify.
		selfCerts   SignaturePacket[] = []
		selfRevokes SignaturePacket[] = []
	}

	// A subkey with its binding and revocation signatures.
	internal struct SubkeyRecord {
		key           KeyPacket
		sigs          SignaturePacket[] = []
		validBindings SignaturePacket[] = []
		validRevokes  SignaturePacket[] = []
	}

	// What a certificate says about one of its keys (`Key.subkeys`).
	struct KeyInfo {
		fingerprint string
		keyID       string
		algorithm   PublicKeyAlgorithm
		created     time.Time
		// When the key stops being valid; none when it does not.
		expires     ?time.Time
		canSign     bool
		canEncrypt  bool
		revoked     bool
	}

	// Why a key, user ID or subkey is revoked (RFC 9580 §5.2.3.31).
	// `NoReason` and `Compromised` revoke it for all time, signatures it
	// made before included; the others only from the revocation on.
	enum RevocationReason {
		NoReason = 0,
		Superseded = 1,
		Compromised = 2,
		Retired = 3,
		UserIDInvalid = 32,
	}

	// An OpenPGP key: a certificate (a transferable public key) or a
	// transferable secret key, with its user IDs and subkeys. Read keys with
	// `readKeys`, make one with `generateKey`.
	type Key {
		internal primary      KeyPacket
		internal sigs         SignaturePacket[] = []
		internal users        UserRecord[]      = []
		internal subs         SubkeyRecord[]    = []
		internal validDirect  SignaturePacket[] = []
		internal validRevokes SignaturePacket[] = []

		def new(primary KeyPacket) {
			self.primary = primary
		}

		// The fingerprint in upper-case hex: 64 digits for a version 6 key,
		// 40 for a version 4 key.
		def fingerprint() string {
			return primary.fingerprint().hex()
		}

		// The 16-digit Key ID in upper-case hex.
		def keyID() string {
			return primary.keyID().hex()
		}

		// The key version: 6, or 4 (3 for keys made before 1998).
		def version() int {
			return primary.version
		}

		// The public key algorithm of the primary key.
		def algorithm() PublicKeyAlgorithm {
			return PublicKeyAlgorithm(primary.algorithm)
		}

		// When the primary key was made.
		def created() time.Time {
			return secondsTime(primary.created)
		}

		// When the key stops being valid; none when it does not expire.
		def expires() ?time.Time {
			let binding = bindingOf(self, nowSeconds())
			return none when binding is none
			let after = binding.keyExpiresAfter()
			return none when after == 0
			return secondsTime(primary.created + after)
		}

		// Whether the key carries secret key material.
		def isSecret() bool {
			return primary.hasSecret
		}

		// Whether a secret part needs `unlock` before it can sign or decrypt.
		def isLocked() bool {
			return true when primary.hasSecret && !primary.unlocked
			for let sub in subs {
				return true when sub.key.hasSecret && !sub.key.unlocked
			}
			return false
		}

		// Whether the key owner revoked the key.
		def isRevoked() bool {
			return revokedAt(validRevokes, nowSeconds())
		}

		// The user IDs that a valid self-signature binds and no revocation
		// withdraws, the primary one first.
		def userIDs() string[] {
			let out string[] = []
			let first = primaryUserID()
			out.push(first) unless first is none
			let now = nowSeconds()
			for let u in users {
				continue when u.attribute || !userValidAt(u, now)
				let text = string(u.data)
				out.push(text) unless !(first is none) && text == first
			}
			return out
		}

		// The user ID the key owner marked primary, else the one with the
		// newest self-signature; none when no user ID is valid.
		def primaryUserID() ?string {
			let u = primaryUserOf(self, nowSeconds())
			return none when u is none
			return string(u.data)
		}

		// The subkeys, as their binding signatures describe them (revoked and
		// expired ones included).
		def subkeys() KeyInfo[] {
			let out KeyInfo[] = []
			let now = nowSeconds()
			for let sub in subs {
				let binding = newestAt(sub.validBindings, now)
				let flags = binding is none ?? (0, binding.keyFlags())
				let after = binding is none ?? (0, binding.keyExpiresAfter())
				out.push(KeyInfo{
					fingerprint: sub.key.fingerprint().hex(),
					keyID:       sub.key.keyID().hex(),
					algorithm:   PublicKeyAlgorithm(sub.key.algorithm),
					created:     secondsTime(sub.key.created),
					expires:     after == 0 ?? (none, secondsTime(sub.key.created + after)),
					canSign:     flags > 0 && flags & 0x02 != 0,
					canEncrypt:  flags > 0 && flags & 0x0C != 0,
					revoked:     binding is none || revokedAt(sub.validRevokes, now),
				})
			}
			return out
		}

		// sign signs data with the key's signing key (a signing subkey, else
		// the primary key): a detached signature, or with `detached` false a
		// signed message that holds the data (one-pass, RFC 9580 §5.4).
		// `text` signs it as UTF-8 text, line endings made CR LF. Armor the
		// result with `armor`.
		// Fails when the key has no usable signing key or it is locked.
		def sign(data byte[], detached bool = true, text bool = false) !byte[] {
			return try detachedSign(data, self, text) when detached
			return try onePassSigned(data, literalPacket(data, text, ""), [self], text)
		}

		// signCleartext signs a text in the cleartext signature framework
		// (§7): the text stays readable, the signature follows it. Trailing
		// spaces and tabs on each line are not signed.
		// Fails when the key has no usable signing key or it is locked.
		def signCleartext(text string) !string {
			return try cleartextSign(text, self)
		}

		// Decrypts the secret parts (primary key and subkeys) with a
		// passphrase so the key can sign and decrypt. Parts stored without
		// protection need none.
		// Fails when the key has no secret part or the passphrase does not
		// unlock one.
		def unlock(passphrase string) !none {
			fail pgpError("the key has no secret part") unless secretPacketsOf(self).len() > 0
			let pass = passphrase.bytes()
			try primary.unlock(pass) when primary.hasSecret
			for let sub in subs {
				try sub.key.unlock(pass) when sub.key.hasSecret
			}
			return none
		}

		// Protects the secret parts with a passphrase (Argon2 and AEAD for a
		// version 6 key; iterated SHA2-256 and AES-256 CFB for version 4) and
		// forgets their plain form; an empty passphrase stores them
		// unprotected. Export with `bytes` or `armored` afterwards.
		// Fails when the key is locked or has no secret part.
		def lock(passphrase string) !none {
			fail pgpError("the key has no secret part") unless secretPacketsOf(self).len() > 0
			fail pgpError("the key is locked: unlock it first") when isLocked()
			let pass = passphrase.bytes()
			for let k in secretPacketsOf(self) {
				try k.protect(pass)
				if pass.len() > 0 {
					k.unlocked = false
					k.secretMPIs = []
					k.secretNative = []
				}
			}
			return none
		}

		// The certificate alone: the key without its secret parts.
		def publicKey() Key {
			let out = new Key(primary.publicOnly())
			out.sigs = sigs
			out.users = users
			out.validDirect = validDirect
			out.validRevokes = validRevokes
			for let sub in subs {
				out.subs.push(SubkeyRecord{key: sub.key.publicOnly(), sigs: sub.sigs, validBindings: sub.validBindings, validRevokes: sub.validRevokes})
			}
			return out
		}

		// The transferable key as packets (§10.1, §10.2): the secret key when
		// there is one, else the certificate.
		def bytes() byte[] {
			let out = primary.hasSecret ?? (primary.secretPacket(), primary.publicPacket())
			for let s in sigs {
				out += s.packet()
			}
			for let u in users {
				out += packetBytes(u.attribute ?? (tagUserAttribute, tagUserID), u.data)
				for let s in u.certs {
					out += s.packet()
				}
			}
			for let sub in subs {
				out += sub.key.hasSecret ?? (sub.key.secretPacket(), sub.key.publicPacket())
				for let s in sub.sigs {
					out += s.packet()
				}
			}
			return out
		}

		// The key in ASCII armor (a PRIVATE KEY BLOCK when it is secret).
		def armored() string {
			return armor(primary.hasSecret ?? (ArmorKind.PrivateKey, ArmorKind.PublicKey), bytes())
		}

		// Adds a user ID with a self-signature.
		// Fails when the key is locked or has no secret primary key.
		def addUserID(userID string, makePrimary bool = false) !none {
			try needSigner(self)
			let u = UserRecord{data: userID.bytes()}
			let sig = try userCertification(self, u, makePrimary, 0)
			u.certs.push(sig)
			users.push(u)
			validateKey(self)
			return none
		}

		// Adds a subkey: for encryption, or with `sign` for signing (then the
		// subkey signs the primary key back, §5.2.3.34). `validity` 0s means
		// it does not expire.
		// Fails when the key is locked or has no secret primary key.
		def addSubkey(algorithm KeyAlgorithm = KeyAlgorithm.Curve25519, sign bool = false, validity duration = 0s, bits int = 3072) !none {
			try needSigner(self)
			let k = try newKeyPacket(algorithm, !sign, primary.version, nowSeconds(), bits, true)
			let sub = SubkeyRecord{key: k}
			sub.sigs.push(try subkeyBinding(self, k, sign, validitySeconds(validity)))
			subs.push(sub)
			validateKey(self)
			return none
		}

		// renew sets how long the key is valid, counted from its creation
		// (0s: for ever), by issuing new self-signatures; publish the key
		// again afterwards.
		// Fails when the key is locked or has no secret primary key.
		def renew(validity duration) !none {
			try needSigner(self)
			let after = validitySeconds(validity)
			sigs.push(try directSignature(self, after)) when primary.version == 6 || validDirect.len() > 0
			let now = nowSeconds()
			let first = primaryUserOf(self, now)
			for let u in users {
				continue unless userValidAt(u, now)
				u.certs.push(try userCertification(self, u, !(first is none) && first.data.hex() == u.data.hex(), after))
			}
			validateKey(self)
			return none
		}

		// Revokes the whole key.
		// Fails when the key is locked or has no secret primary key.
		def revoke(reason RevocationReason = RevocationReason.NoReason, message string = "") !none {
			try needSigner(self)
			let s = try newSignature(primary, sigKeyRevocation, [reasonSubpacket(reason, message)])
			try signParts(primary, s, [keyHashData(primary)])
			sigs.push(s)
			validateKey(self)
			return none
		}

		// Revokes one user ID.
		// Fails when the key has no such user ID, or is locked.
		def revokeUserID(userID string, reason RevocationReason = RevocationReason.UserIDInvalid, message string = "") !none {
			try needSigner(self)
			for let u in users {
				continue unless !u.attribute && string(u.data) == userID
				let s = try newSignature(primary, sigCertRevocation, [reasonSubpacket(reason, message)])
				try signParts(primary, s, [keyHashData(primary), userHashData(s.version, u.data, false)])
				u.certs.push(s)
				validateKey(self)
				return none
			}
			fail pgpError("the key has no user ID \"{userID}\"")
		}

		// Revokes the subkey with this fingerprint (or Key ID).
		// Fails when the key has no such subkey, or is locked.
		def revokeSubkey(id string, reason RevocationReason = RevocationReason.NoReason, message string = "") !none {
			try needSigner(self)
			let want = id.upper().replace(" ", "", -1)
			for let sub in subs {
				continue unless sub.key.fingerprint().hex() == want || sub.key.keyID().hex() == want
				let s = try newSignature(primary, sigSubkeyRevocation, [reasonSubpacket(reason, message)])
				try signParts(primary, s, [keyHashData(primary), keyHashData(sub.key)])
				sub.sigs.push(s)
				validateKey(self)
				return none
			}
			fail pgpError("the key has no subkey {id}")
		}

		// Adds what another copy of the same key holds: signatures, user IDs,
		// subkeys and secret parts this one lacks (a key server's copy carries
		// new certifications and revocations).
		// Fails when the other key has a different fingerprint.
		def merge(other Key) !none {
			fail pgpError("the keys differ: {fingerprint()} and {other.fingerprint()}") unless other.fingerprint() == fingerprint()
			primary = other.primary when !primary.hasSecret && other.primary.hasSecret
			sigs = mergeSignatures(sigs, other.sigs)
			for let theirs in other.users {
				let found = false
				for let mine in users {
					if mine.attribute == theirs.attribute && mine.data.hex() == theirs.data.hex() {
						mine.certs = mergeSignatures(mine.certs, theirs.certs)
						found = true
						break
					}
				}
				users.push(UserRecord{data: theirs.data, attribute: theirs.attribute, certs: theirs.certs}) unless found
			}
			for let theirs in other.subs {
				let found = false
				let fp = theirs.key.fingerprint().hex()
				for let mine in subs {
					if mine.key.fingerprint().hex() == fp {
						mine.sigs = mergeSignatures(mine.sigs, theirs.sigs)
						mine.key = theirs.key when !mine.key.hasSecret && theirs.key.hasSecret
						found = true
						break
					}
				}
				subs.push(SubkeyRecord{key: theirs.key, sigs: theirs.sigs}) unless found
			}
			validateKey(self)
			return none
		}

		// Whether a query names this key: its fingerprint, Key ID (with or
		// without 0x), or a user ID, or the e-mail address in one.
		def matches(query string) bool {
			let q = query.trim()
			let hexQuery = q.upper().replace(" ", "", -1)
			hexQuery = hexQuery.slice(2, hexQuery.len()) when hexQuery.startsWith("0X")
			return true when hexQuery == fingerprint() || hexQuery == keyID()
			for let sub in subs {
				return true when hexQuery == sub.key.fingerprint().hex() || hexQuery == sub.key.keyID().hex()
			}
			let lower = q.lower()
			for let u in users {
				continue when u.attribute
				let text = string(u.data)
				return true when text == q || text.lower().contains("<" + lower + ">") || text.lower() == lower
			}
			return false
		}
	}

	internal def secretPacketsOf(key Key) KeyPacket[] {
		let out KeyPacket[] = []
		out.push(key.primary) when key.primary.hasSecret
		for let sub in key.subs {
			out.push(sub.key) when sub.key.hasSecret
		}
		return out
	}

	internal def needSigner(key Key) !none {
		fail pgpError("the key has no secret primary key") unless key.primary.hasSecret
		fail pgpError("the key is locked: unlock it with its passphrase") unless key.primary.unlocked
		return none
	}

	// Recomputes which self-signatures hold.
	internal def validateKey(key Key) {
		key.validDirect = []
		key.validRevokes = []
		for let s in key.sigs {
			continue unless issuedBy(s, key.primary)
			if s.sigType == sigDirectKey && certProblem(key, s, [keyHashData(key.primary)]) == "" {
				key.validDirect.push(s)
			} else if s.sigType == sigKeyRevocation && certProblem(key, s, [keyHashData(key.primary)]) == "" {
				key.validRevokes.push(s)
			}
		}
		for let u in key.users {
			u.selfCerts = []
			u.selfRevokes = []
			for let s in u.certs {
				continue unless issuedBy(s, key.primary)
				let parts = [keyHashData(key.primary), userHashData(s.version, u.data, u.attribute)]
				if s.sigType >= sigGenericCert && s.sigType <= sigPositiveCert {
					u.selfCerts.push(s) when certProblem(key, s, parts) == ""
				} else if s.sigType == sigCertRevocation {
					u.selfRevokes.push(s) when certProblem(key, s, parts) == ""
				}
			}
		}
		for let sub in key.subs {
			sub.validBindings = []
			sub.validRevokes = []
			for let s in sub.sigs {
				continue unless issuedBy(s, key.primary)
				let parts = [keyHashData(key.primary), keyHashData(sub.key)]
				if s.sigType == sigSubkeyBinding && certProblem(key, s, parts) == "" && backSigned(s, sub.key, parts) {
					sub.validBindings.push(s)
				} else if s.sigType == sigSubkeyRevocation && certProblem(key, s, parts) == "" {
					sub.validRevokes.push(s)
				}
			}
		}
	}

	// Why a self-signature over parts does not hold ("" when it does). Its
	// expiry is left to `newestAt`, which judges it at the time asked.
	internal def certProblem(key Key, s SignaturePacket, parts byte[][]) string {
		return signatureProblem(key.primary, s, parts, false, -1)
	}

	// A signing subkey's binding holds only with the primary key binding
	// signature the subkey made, embedded in it (§5.2.3.34).
	internal def backSigned(binding SignaturePacket, sub KeyPacket, parts byte[][]) bool {
		let flags = binding.keyFlags()
		return true unless flags > 0 && flags & 0x02 != 0
		let back = binding.embedded()
		return false when back is none || back.sigType != sigPrimaryBinding
		return signatureProblem(sub, back, parts, false, -1) == ""
	}

	// The self-signature that binds the primary key at a time: the newest
	// direct key signature, else (version 4) the primary user ID's newest
	// certification.
	internal def bindingOf(key Key, t int) ?SignaturePacket {
		let direct = newestAt(key.validDirect, t)
		return direct unless direct is none
		let u = primaryUserOf(key, t)
		return none when u is none
		return newestAt(u.selfCerts, t)
	}

	internal def primaryUserOf(key Key, t int) ?UserRecord {
		let best ?UserRecord = none
		let bestMarked = false
		let bestTime = -1
		for let u in key.users {
			continue when u.attribute || !userValidAt(u, t)
			let cert = newestAt(u.selfCerts, t)
			continue when cert is none
			let marked = cert.isPrimaryUserID()
			let created = cert.created()
			if best is none || (marked && !bestMarked) || (marked == bestMarked && created > bestTime) {
				best = u
				bestMarked = marked
				bestTime = created
			}
		}
		return best
	}

	internal def userValidAt(u UserRecord, t int) bool {
		let cert = newestAt(u.selfCerts, t)
		return false when cert is none
		for let r in u.selfRevokes {
			return false when r.created() >= cert.created() && r.created() <= t
		}
		return true
	}

	// Whether the primary key can be used at a time: bound, not expired,
	// not revoked.
	internal def primaryValidAt(key Key, t int) bool {
		return false when revokedAt(key.validRevokes, t)
		let binding = bindingOf(key, t)
		// A version 4 key with no user ID and no direct signature binds
		// nothing, but its own signatures still verify.
		return key.primary.version != 6 && key.validDirect.len() == 0 && key.users.len() == 0 when binding is none
		let after = binding.keyExpiresAfter()
		return after == 0 || t < key.primary.created + after
	}

	// The key flags of the primary key (from its binding), or of a
	// subkey; -1 when the signature carries none.
	internal def primaryFlags(key Key, t int) int {
		let binding = bindingOf(key, t)
		return binding is none ?? (-1, binding.keyFlags())
	}

	// The keys (primary and subkeys) usable at a time for an operation:
	// 0x02 signing, 0x0C encryption.
	internal def usableKeys(key Key, t int, want int) KeyPacket[] {
		let out KeyPacket[] = []
		return out unless primaryValidAt(key, t)
		let flags = primaryFlags(key, t)
		let primaryCan = flags > 0 ?? (flags & want != 0, algorithmCan(key.primary.algorithm, want))
		out.push(key.primary) when primaryCan
		for let sub in key.subs {
			continue when revokedAt(sub.validRevokes, t)
			let binding = newestAt(sub.validBindings, t)
			continue when binding is none
			let after = binding.keyExpiresAfter()
			continue when after > 0 && t >= sub.key.created + after
			let subFlags = binding.keyFlags()
			let can = subFlags > 0 ?? (subFlags & want != 0, algorithmCan(sub.key.algorithm, want))
			out.push(sub.key) when can
		}
		return out
	}

	// The key packet with this Key ID or fingerprint.
	internal def packetByID(key Key, id byte[]) ?KeyPacket {
		let hexID = id.hex()
		return key.primary when key.primary.keyID().hex() == hexID || key.primary.fingerprint().hex() == hexID
		for let sub in key.subs {
			return sub.key when sub.key.keyID().hex() == hexID || sub.key.fingerprint().hex() == hexID
		}
		return none
	}

	// The self-signature subpackets every binding of a new key carries.
	internal def preferenceSubpackets() Subpacket[] {
		return [
			Subpacket{kind: spPrefCiphers, body: [byte(9), byte(7)]},
			Subpacket{kind: spPrefAEAD, body: [byte(9), byte(2), byte(7), byte(2)]},
			Subpacket{kind: spPrefHashes, body: [byte(10), byte(8)]},
			Subpacket{kind: spPrefCompression, body: [byte(0)]},
			Subpacket{kind: spFeatures, body: [byte(0x09)]},
		]
	}

	internal def directSignature(key Key, expiresAfter int) !SignaturePacket {
		let hashed = [Subpacket{kind: spKeyFlags, critical: true, body: [byte(0x03)]}]
		hashed += preferenceSubpackets()
		hashed.push(Subpacket{kind: spKeyExpiration, critical: true, body: uint32Bytes(expiresAfter)}) when expiresAfter > 0
		let s = try newSignature(key.primary, sigDirectKey, hashed)
		try signParts(key.primary, s, [keyHashData(key.primary)])
		return s
	}

	internal def userCertification(key Key, u UserRecord, isPrimary bool, expiresAfter int) !SignaturePacket {
		let hashed Subpacket[] = []
		hashed.push(Subpacket{kind: spPrimaryUserID, body: [byte(1)]}) when isPrimary
		if key.primary.version != 6 {
			// Version 4 implementations read the key's flags, preferences
			// and expiry from the user ID binding.
			hashed.push(Subpacket{kind: spKeyFlags, critical: true, body: [byte(0x03)]})
			hashed += preferenceSubpackets()
			hashed.push(Subpacket{kind: spKeyExpiration, critical: true, body: uint32Bytes(expiresAfter)}) when expiresAfter > 0
		}
		let s = try newSignature(key.primary, sigPositiveCert, hashed)
		try signParts(key.primary, s, [keyHashData(key.primary), userHashData(s.version, u.data, u.attribute)])
		return s
	}

	internal def subkeyBinding(key Key, k KeyPacket, sign bool, expiresAfter int) !SignaturePacket {
		let hashed = [Subpacket{kind: spKeyFlags, critical: true, body: [byte(sign ?? (0x02, 0x0C))]}]
		hashed.push(Subpacket{kind: spKeyExpiration, critical: true, body: uint32Bytes(expiresAfter)}) when expiresAfter > 0
		let s = try newSignature(key.primary, sigSubkeyBinding, hashed)
		let parts = [keyHashData(key.primary), keyHashData(k)]
		if sign {
			let back = try newSignature(k, sigPrimaryBinding, [])
			try signParts(k, back, parts)
			s.hashed.push(Subpacket{kind: spEmbedded, critical: true, body: back.body()})
			s.hashedRaw = subpacketsBytes(s.hashed)
		}
		try signParts(key.primary, s, parts)
		return s
	}

	internal def secondsTime(seconds int) time.Time {
		return time.fromUnixNs(int64(seconds) * 1000000000)
	}

	internal def validitySeconds(validity duration) int {
		return int(validity.nanoseconds() / 1000000000)
	}

	// Whether an algorithm can do an operation (0x02 sign, 0x0C encrypt),
	// for keys whose binding carries no flags.
	internal def algorithmCan(algorithm int, want int) bool {
		return algorithm := 1 || 3 || 17 || 19 || 22 || 27 || 28 when want & 0x02 != 0
		return algorithm := 1 || 2 || 16 || 18 || 25 || 26
	}

	// Whether a signature names the key as its issuer, or names none.
	internal def issuedBy(s SignaturePacket, k KeyPacket) bool {
		let fp = s.issuerFingerprint()
		return fp.hex() == k.fingerprint().hex() when fp.len() > 0
		let ids = s.issuerKeyIDs()
		return true when ids.len() == 0
		let own = k.keyID().hex()
		for let id in ids {
			return true when id.hex() == own
		}
		return false
	}

	// The newest signature made at or before a time that has not expired by
	// then.
	internal def newestAt(list SignaturePacket[], t int) ?SignaturePacket {
		let best ?SignaturePacket = none
		let bestTime = -1
		for let s in list {
			let created = s.created()
			continue when created > t
			let after = s.expiresAfter()
			continue when after > 0 && t >= created + after
			if created >= bestTime {
				best = s
				bestTime = created
			}
		}
		return best
	}

	// Whether a revocation in the list applies at a time: a hard one
	// (no reason, or the key compromised) always, a soft one from its
	// creation.
	internal def revokedAt(revocations SignaturePacket[], t int) bool {
		for let r in revocations {
			let reason = r.find(spRevocationReason)
			let code = reason is none || reason.body.len() == 0 ?? (0, int(reason.body[0]))
			return true when code := 0 || 2
			return true when r.created() <= t
		}
		return false
	}

	internal def reasonSubpacket(reason RevocationReason, message string) Subpacket {
		let body byte[] = [byte(reason.value)]
		body += message.bytes()
		return Subpacket{kind: spRevocationReason, body: body}
	}

	internal def mergeSignatures(mine SignaturePacket[], theirs SignaturePacket[]) SignaturePacket[] {
		let out = mine.clone()
		let seen string[] = []
		for let s in mine {
			seen.push(s.body().hex())
		}
		for let s in theirs {
			let key = s.body().hex()
			continue when seen.includes(key)
			seen.push(key)
			out.push(s)
		}
		return out
	}

	// A new signature by a key: creation time, issuer fingerprint (and Key ID
	// for version 4) and the given hashed subpackets, salted for version 6.
	internal def newSignature(signer KeyPacket, sigType int, hashed Subpacket[]) !SignaturePacket {
		let s = new SignaturePacket()
		s.version = signer.version == 6 ?? (6, 4)
		s.sigType = sigType
		s.algorithm = signer.algorithm
		let least = try minimumDigest(signer)
		s.hashID = least > 48 ?? (10, least > 32 ?? (9, 8))
		let fp byte[] = [byte(signer.version)]
		fp += signer.fingerprint()
		s.hashed = [Subpacket{kind: spCreationTime, critical: true, body: uint32Bytes(nowSeconds())}, Subpacket{kind: spIssuerFingerprint, body: fp}]
		s.hashed += hashed
		s.hashedRaw = subpacketsBytes(s.hashed)
		s.unhashed = s.version == 4 ?? ([Subpacket{kind: spIssuerKeyID, body: signer.keyID()}], [])
		s.salt = try crypto.rand(try v6SaltSize(s.hashID)) when s.version == 6
		return s
	}

	// Signs the parts (hashed in order) with an unlocked key.
	internal def signParts(signer KeyPacket, s SignaturePacket, parts byte[][]) !none {
		let h = try s.startHash()
		for let p in parts {
			h.write(p)
		}
		try signDigest(signer, s, s.complete(h))
		return none
	}

	// Why a signature by k over parts does not hold at time `now`; "" when it
	// does. `data` is a document signature (stricter about SHA-1); a
	// negative `now` leaves the expiry unchecked.
	internal def signatureProblem(k KeyPacket, s SignaturePacket, parts byte[][], data bool, now int) string {
		return "a version 6 key makes only version 6 signatures" when (k.version == 6) != (s.version == 6)
		return "an unknown critical subpacket" when s.hasUnknownCritical()
		return "hash algorithm {s.hashID} is not known" unless knownHash(s.hashID)
		return "MD5 and RIPEMD-160 signatures are not accepted" when s.hashID := 1 || 3
		let created = s.created()
		// SHA-1 collisions became practical in 2020 (SHA-1 is a Shambles);
		// self-signatures made before 2023-02-01 are still accepted.
		return "SHA-1 signatures are not accepted" when s.hashID == 2 && (data || created >= 1675209600)
		return "the signature has no creation time" when s.version != 3 && s.find(spCreationTime) is none
		return "the signature predates its key" when created < k.created
		let after = s.expiresAfter()
		return "the signature expired" when now >= 0 && after > 0 && now >= created + after
		let h = s.startHash() onerror (err error) {
			return err.message
		}
		for let p in parts {
			h.write(p)
		}
		let digest = s.complete(h)
		return "the signature does not match" unless s.left16.len() == 2 && s.left16.hex() == digest[0:2].hex()
		let ok = verifyDigest(k, s, digest) onerror (err error) {
			return err.message
		}
		return ok ?? ("", "the signature does not match")
	}

	internal def readableSignature(body byte[]) ?SignaturePacket {
		return parseSignature(body) onerror (err error) {
			return none
		}
	}

	// The transferable keys of a packet sequence (§10.1, §10.2). A key (or
	// subkey) whose key packet cannot be read, such as one of a version
	// RFC 9580 does not define, is skipped with its signatures; the first
	// such problem is the error when no key is left.
	internal def parseKeys(packets Packet[]) !Key[] {
		let out Key[] = []
		let current ?Key = none
		let user ?UserRecord = none
		let sub ?SubkeyRecord = none
		// Skipping the packets of an unreadable key or subkey.
		let skipKey = false
		let skipSub = false
		let firstProblem ?error = none
		for let p in packets {
			switch p.tag {
				case tagPublicKey, tagSecretKey:
					if !(current is none) {
						validateKey(current)
						out.push(current)
					}
					current = none
					user = none
					sub = none
					skipSub = false
					let k = parseKeyPacket(p.tag, p.body) onerror (err error) {
						firstProblem = err when firstProblem is none
						skipKey = true
						continue
					}
					skipKey = false
					current = new Key(k)
				case tagUserID, tagUserAttribute:
					continue when skipKey
					fail pgpError("a user ID comes before any key") when current is none
					let u = UserRecord{data: p.body, attribute: p.tag == tagUserAttribute}
					current.users.push(u)
					user = u
					sub = none
					skipSub = false
				case tagPublicSubkey, tagSecretSubkey:
					continue when skipKey
					fail pgpError("a subkey comes before any key") when current is none
					user = none
					sub = none
					let k = parseKeyPacket(p.tag, p.body) onerror (err error) {
						skipSub = true
						continue
					}
					skipSub = false
					let record = SubkeyRecord{key: k}
					current.subs.push(record)
					sub = record
				case tagSignature:
					continue when skipKey || skipSub
					fail pgpError("a signature comes before any key") when current is none
					// A signature this implementation cannot read is skipped
					// (§5.2.5), as are those of unknown versions.
					let s = readableSignature(p.body)
					continue when s is none
					if !(sub is none) {
						sub.sigs.push(s)
					} else if !(user is none) {
						user.certs.push(s)
					} else {
						current.sigs.push(s)
					}
				case tagMarker, tagPadding, tagTrust:
					continue
				default:
					fail pgpError("packet type {p.tag} does not belong in a key") when p.tag < 40
			}
		}
		if !(current is none) {
			validateKey(current)
			out.push(current)
		}
		fail firstProblem when out.len() == 0 && !(firstProblem is none)
		return out
	}

	// readKeys reads the keys of binary or ASCII-armored data: certificates
	// and secret keys, as many as it holds (a keyring file, a key server
	// reply). Secret keys stored without a passphrase come unlocked.
	// Fails when the data is not OpenPGP keys or a key is malformed.
	def readKeys(data byte[]) !Key[] {
		let keys = try parseKeys(try readPackets(try binaryOf(data)))
		fail pgpError("the data holds no key") when keys.len() == 0
		return keys
	}

	// readKeys reads the keys of armored text. Fails as the binary form does.
	def readKeys(text string) !Key[] {
		return try readKeys(text.bytes())
	}

	// How generateKey makes a key.
	struct KeyOptions {
		algorithm  KeyAlgorithm = KeyAlgorithm.Curve25519
		// 6 (RFC 9580), or 4 for peers that do not read version 6 keys yet.
		version    int          = 6
		// The RSA modulus size; other algorithms ignore it.
		bits       int          = 3072
		// How long the key is valid; 0s for ever.
		validity   duration     = 0s
		// Protects the secret key when not empty; the key stays unlocked.
		passphrase string       = ""
	}

	// generateKey makes a secret key: a primary key that certifies and signs,
	// with an encryption subkey, bound to a user ID ("Name <mail@host>"; an
	// empty one adds none, which version 6 allows).
	// Fails when the options name an unsupported combination (RSA under 2048
	// bits, a version other than 4 or 6) or the random source fails.
	def generateKey(userID string, options KeyOptions = KeyOptions{}) !Key {
		fail pgpError("key version {options.version} cannot be generated: use 6 or 4") unless options.version := 6 || 4
		fail pgpError("RSA keys need at least 2048 bits") when options.algorithm == KeyAlgorithm.RSA && options.bits < 2048
		fail pgpError("a version 4 key needs a user ID") when options.version == 4 && userID == ""
		let created = nowSeconds()
		let k = try newKeyPacket(options.algorithm, encrypt = false, version = options.version, created = created, bits = options.bits, subkey = false)
		let key = new Key(k)
		let after = validitySeconds(options.validity)
		key.sigs.push(try directSignature(key, after)) when options.version == 6
		if userID != "" {
			let u = UserRecord{data: userID.bytes()}
			u.certs.push(try userCertification(key, u, true, after))
			key.users.push(u)
		}
		let enc = try newKeyPacket(options.algorithm, encrypt = true, version = options.version, created = created, bits = options.bits, subkey = true)
		let sub = SubkeyRecord{key: enc}
		sub.sigs.push(try subkeyBinding(key, enc, false, after))
		key.subs.push(sub)
		validateKey(key)
		if options.passphrase != "" {
			let pass = options.passphrase.bytes()
			for let p in secretPacketsOf(key) {
				try p.protect(pass)
			}
		}
		return key
	}
}
