partial module std.crypto.openpgp {
	use (
		std.crypto
		std.crypto.cipher
		std.crypto.hash
		std.crypto.hash::(Hash)
		std.time
	)

	// One key material packet (RFC 9580 §5.5): a primary key or a subkey,
	// public or secret.
	internal type KeyPacket {
		// 6 public key, 14 public subkey, 5 secret key, 7 secret subkey.
		tag          int
		version      int
		// Creation time, seconds since 1970.
		created      int
		// Version 3 only: days the key is valid, 0 for ever.
		v3days       int      = 0
		algorithm    int
		// The algorithm-specific public fields as they are on the wire.
		material     byte[]
		// Parsed public fields: the MPIs (RSA n e; DSA p q g y; Elgamal p g
		// y; the EC point of ECDSA, ECDH and EdDSALegacy), the curve OID,
		// ECDH's KDF hash and wrap cipher, and the native key of X25519,
		// X448, Ed25519 and Ed448.
		mpis         byte[][] = []
		oid          byte[]   = []
		kdfHash      int      = 0
		kdfCipher    int      = 0
		native       byte[]   = []
		// Secret part: whether there is one, its S2K usage octet, the
		// parameters after it (cipher, AEAD mode, S2K, IV) as written, and
		// the protected (or plain) secret data.
		hasSecret    bool     = false
		s2kUsage     int      = 0
		secretParams byte[]   = []
		secretData   byte[]   = []
		// The secret fields once unlocked: MPIs, or the native key.
		unlocked     bool     = false
		secretMPIs   byte[][] = []
		secretNative byte[]   = []

		def new() {}

		// A copy without the secret part.
		def publicOnly() KeyPacket {
			let k = new KeyPacket()
			k.tag = isSubkey() ?? (tagPublicSubkey, tagPublicKey)
			k.version = version
			k.created = created
			k.v3days = v3days
			k.algorithm = algorithm
			k.material = material
			k.mpis = mpis
			k.oid = oid
			k.kdfHash = kdfHash
			k.kdfCipher = kdfCipher
			k.native = native
			return k
		}

		def isSubkey() bool {
			return tag := tagPublicSubkey || tagSecretSubkey
		}

		// The public packet body: the version up to the key material.
		def publicBody() byte[] {
			let out byte[] = [byte(version)]
			out += uint32Bytes(created)
			out += [byte((v3days >> 8) & 0xFF), byte(v3days & 0xFF)] when version <= 3
			out.push(byte(algorithm))
			out += uint32Bytes(material.len()) when version == 6
			out += material
			return out
		}

		// The secret packet body: the public fields, then the S2K usage and
		// the secret data as stored.
		def secretBody() byte[] {
			let out = publicBody()
			out.push(byte(s2kUsage))
			out.push(byte(secretParams.len())) when version == 6 && s2kUsage != 0
			out += secretParams
			out += secretData
			return out
		}

		// The packet as public key (or subkey) material.
		def publicPacket() byte[] {
			return packetBytes(isSubkey() ?? (tagPublicSubkey, tagPublicKey), publicBody())
		}

		def secretPacket() byte[] {
			return packetBytes(isSubkey() ?? (tagSecretSubkey, tagSecretKey), secretBody())
		}

		// The fingerprint (§5.5.4): SHA2-256 of version 6 keys, SHA-1 of
		// version 4 keys, MD5 of the RSA numbers of version 3 keys.
		def fingerprint() byte[] {
			let body = publicBody()
			if version == 6 {
				let input byte[] = [byte(0x9B)]
				input += uint32Bytes(body.len())
				input += body
				return hash.digest(Hash.SHA256, input)
			}
			if version == 4 {
				let input byte[] = [byte(0x99), byte((body.len() >> 8) & 0xFF), byte(body.len() & 0xFF)]
				input += body
				return hash.digest(Hash.SHA1, input)
			}
			let input byte[] = []
			for let m in mpis {
				input += m
			}
			return hash.digest(Hash.MD5, input)
		}

		// The 8-octet Key ID: the first of a version 6 fingerprint, the last
		// of a version 4 one, the low 64 bits of a version 3 modulus.
		def keyID() byte[] {
			return fingerprint()[0:8] when version == 6
			if version == 4 {
				let fp = fingerprint()
				return fp[12:20]
			}
			let n = mpis.len() > 0 ?? (mpis[0], [])
			return n.len() >= 8 ?? (n[n.len() - 8:], n)
		}

		// The additional data and HKDF info of AEAD secret key protection
		// (§5.5.3).
		internal def packetPrefix() byte[] {
			let out byte[] = [byte(0xC0 | (isSubkey() ?? (tagSecretSubkey, tagSecretKey)))]
			out += publicBody()
			return out
		}

		// Decrypts the secret fields with a passphrase. A key whose secret is
		// stored unprotected needs none.
		// Fails when the key has no secret part, the passphrase is wrong (the
		// check or tag does not match), or the material does not parse.
		def unlock(passphrase byte[]) !none {
			fail pgpError("the key has no secret part") unless hasSecret
			return none when unlocked
			let plain = try decryptSecret(passphrase)
			try parseSecret(plain)
			unlocked = true
			return none
		}

		def decryptSecret(passphrase byte[]) !byte[] {
			if s2kUsage == 0 {
				return secretData when version == 6
				fail pgpError("an unprotected secret key ends with its checksum") when secretData.len() < 2
				let body = secretData[0:secretData.len() - 2]
				fail pgpError("the secret key's checksum does not match") unless checksum16(body) == secretData[secretData.len() - 2:].hex()
				return body
			}
			let r = new BodyReader(secretParams)
			if s2kUsage := 253 || 254 || 255 {
				fail pgpError("a version 6 key does not use MalleableCFB") when version == 6 && s2kUsage == 255
				let cipherID = try r.byte1()
				let mode = s2kUsage == 253 ?? (try r.byte1(), 0)
				if version == 6 {
					try r.byte1()
				}
				let s2k = try readS2K(r)
				fail pgpError("Argon2 protects a secret key only with AEAD") when s2k.kind == 4 && s2kUsage != 253
				let size = try keySize(cipherID)
				let key = try deriveKey(s2k, passphrase, size)
				if s2kUsage == 253 {
					let nonce = try r.take(try aeadNonceSize(mode))
					let info byte[] = [byte(0xC0 | (isSubkey() ?? (tagSecretSubkey, tagSecretKey))), byte(version), byte(cipherID), byte(mode)]
					let kek = try hash.hkdf(Hash.SHA256, key, [], info, size)
					let aead = try aeadOf(mode, cipherID, kek)
					return aead.open(nonce, secretData, packetPrefix()) onerror (err error) {
						fail pgpError("the passphrase does not unlock the key")
					}
				}
				let iv = try r.take(try blockSizeOf(cipherID))
				let plain = try cfbDecrypt(cipherID, key, iv, secretData)
				return try checkedSecret(plain, s2kUsage == 254)
			}
			// A cipher ID: the key is the MD5 of the passphrase.
			let cipherID = s2kUsage
			let iv = try r.take(try blockSizeOf(cipherID))
			let key = try deriveKey(S2K{kind: 0, hash: 1}, passphrase, try keySize(cipherID))
			return try checkedSecret(try v3SecretDecrypt(cipherID, key, iv), false) when version <= 3
			return try checkedSecret(try cfbDecrypt(cipherID, key, iv, secretData), false)
		}

		// Version 3 secret keys encrypt only the MPI values, the CFB state
		// resynchronized at each one; the checksum is in the clear.
		internal def v3SecretDecrypt(cipherID int, key byte[], iv byte[]) !byte[] {
			let r = new BodyReader(secretData)
			let out byte[] = []
			let register = iv
			for r.remaining() > 2 {
				let bits = try r.uint16()
				let size = (bits + 7) / 8
				let enc = try r.take(size)
				let mode = try cipher.newCFB(try blockCipher(cipherID, key), register)
				let dec = mode.decrypt(enc)
				out += [byte(bits >> 8), byte(bits & 0xFF)]
				out += dec
				// The next IV is the last block of this ciphertext.
				let blockSize = register.len()
				register = enc[enc.len() - blockSize:] when enc.len() >= blockSize
			}
			out += r.rest()
			return out
		}

		// The secret fields of decrypted data, after its SHA-1 or 2-octet
		// checksum is checked.
		internal def checkedSecret(plain byte[], sha1 bool) !byte[] {
			if sha1 {
				fail pgpError("the passphrase does not unlock the key") when plain.len() < 20
				let body = plain[0:plain.len() - 20]
				fail pgpError("the passphrase does not unlock the key") unless hash.digest(Hash.SHA1, body).hex() == plain[plain.len() - 20:].hex()
				return body
			}
			fail pgpError("the passphrase does not unlock the key") when plain.len() < 2
			let body = plain[0:plain.len() - 2]
			fail pgpError("the passphrase does not unlock the key") unless checksum16(body) == plain[plain.len() - 2:].hex()
			return body
		}

		// Reads the algorithm's secret fields; nothing may follow them.
		def parseSecret(plain byte[]) !none {
			let r = new BodyReader(plain)
			secretMPIs = []
			secretNative = []
			switch algorithm {
				case 1, 2, 3:
					for let i = 0; i < 4; i++ {
						secretMPIs.push(try r.mpi())
					}
				case 16, 17, 18, 19, 22:
					secretMPIs.push(try r.mpi())
				case 25:
					secretNative = try r.take(32)
				case 26:
					secretNative = try r.take(56)
				case 27:
					secretNative = try r.take(32)
				case 28:
					secretNative = try r.take(57)
				default:
					fail pgpError("public key algorithm {algorithm} is not known")
			}
			fail pgpError("the secret key material has octets after its fields") unless r.done()
			return none
		}

		// The secret fields as stored before protection.
		internal def secretPlain() byte[] {
			return secretNative when secretNative.len() > 0
			let out byte[] = []
			for let m in secretMPIs {
				out += mpiBytes(m)
			}
			return out
		}

		// Stores the unlocked secret: protected with a passphrase (AEAD with
		// Argon2 for version 6 keys, CFB with SHA-1 and an iterated S2K for
		// version 4, which most implementations read), or in the clear when
		// the passphrase is empty.
		def protect(passphrase byte[]) !none {
			fail pgpError("the key is locked") unless unlocked
			let plain = secretPlain()
			if passphrase.len() == 0 {
				s2kUsage = 0
				secretParams = []
				secretData = plain
				secretData = plain + unhexBytes(checksum16(plain)) when version != 6
				return none
			}
			let cipherID = 9
			let size = 32
			if version == 6 {
				let s2k = try newS2K(true)
				let key = try deriveKey(s2k, passphrase, size)
				let mode = 2
				let nonce = try crypto.rand(try aeadNonceSize(mode))
				let s2kField = s2kBytes(s2k)
				s2kUsage = 253
				secretParams = [byte(cipherID), byte(mode), byte(s2kField.len())] + s2kField + nonce
				let info byte[] = [byte(0xC0 | (isSubkey() ?? (tagSecretSubkey, tagSecretKey))), byte(version), byte(cipherID), byte(mode)]
				let kek = try hash.hkdf(Hash.SHA256, key, [], info, size)
				let aead = try aeadOf(mode, cipherID, kek)
				secretData = aead.seal(nonce, plain, packetPrefix())
				return none
			}
			let s2k = try newS2K(false)
			let key = try deriveKey(s2k, passphrase, size)
			let iv = try crypto.rand(16)
			s2kUsage = 254
			secretParams = [byte(cipherID)] + s2kBytes(s2k) + iv
			let withHash = plain + hash.digest(Hash.SHA1, plain)
			secretData = try cfbEncrypt(cipherID, key, iv, withHash)
			return none
		}
	}

	// The sum of the octets mod 65536 as 4 hex digits.
	internal def checksum16(data byte[]) string {
		let sum = 0
		for let b in data {
			sum = (sum + int(b)) & 0xFFFF
		}
		return "%04X".format(sum)
	}

	internal def unhexBytes(text string) byte[] {
		let out byte[] = []
		for let i = 0; i + 1 < text.len(); i += 2 {
			out.push(byte(parseInt<int>(text.slice(i, i + 2), 16)))
		}
		return out
	}

	// OpenPGP's CFB (full-block feedback) one way and the other.
	internal def cfbDecrypt(cipherID int, key byte[], iv byte[], data byte[]) !byte[] {
		let mode = try cipher.newCFB(try blockCipher(cipherID, key), iv)
		return mode.decrypt(data)
	}

	internal def cfbEncrypt(cipherID int, key byte[], iv byte[], data byte[]) !byte[] {
		let mode = try cipher.newCFB(try blockCipher(cipherID, key), iv)
		return mode.encrypt(data)
	}

	// A key packet from its tag and body.
	internal def parseKeyPacket(tag int, body byte[]) !KeyPacket {
		let k = new KeyPacket()
		k.tag = tag
		let r = new BodyReader(body)
		k.version = try r.byte1()
		fail pgpError("key packet version {k.version} is not known") unless k.version := 2 || 3 || 4 || 6
		k.created = try r.uint32()
		k.v3days = try r.uint16() when k.version <= 3
		k.algorithm = try r.byte1()
		let materialStart = r.pos
		let declared = -1
		if k.version == 6 {
			declared = try r.uint32()
			materialStart = r.pos
		}
		try readPublicMaterial(k, r)
		k.material = body[materialStart:r.pos]
		fail pgpError("the key material is {k.material.len()} octets, not the {declared} its count says") when declared >= 0 && declared != k.material.len()
		if tag == tagSecretKey || tag == tagSecretSubkey {
			k.hasSecret = true
			k.s2kUsage = try r.byte1()
			if k.s2kUsage == 0 {
				k.secretData = r.rest()
				k.unlocked = false
				// No passphrase: unlock now.
				let plain = try k.decryptSecret([])
				try k.parseSecret(plain)
				k.unlocked = true
				return k
			}
			let paramsStart = r.pos
			if k.version == 6 {
				let count = try r.byte1()
				paramsStart = r.pos
				try r.take(count)
			} else {
				try skipSecretParams(k, r)
			}
			k.secretParams = body[paramsStart:r.pos]
			k.secretData = r.rest()
		}
		return k
	}

	// Moves past the S2K parameters of a version 3 or 4 secret key.
	internal def skipSecretParams(k KeyPacket, r BodyReader) !none {
		let usage = k.s2kUsage
		if usage := 253 || 254 || 255 {
			let cipherID = try r.byte1()
			let mode = usage == 253 ?? (try r.byte1(), 0)
			try readS2K(r)
			if usage == 253 {
				try r.take(try aeadNonceSize(mode))
			} else {
				try r.take(try blockSizeOf(cipherID))
			}
			return none
		}
		try r.take(try blockSizeOf(usage))
		return none
	}

	internal def readPublicMaterial(k KeyPacket, r BodyReader) !none {
		switch k.algorithm {
			case 1, 2, 3:
				k.mpis = [try r.mpi(), try r.mpi()]
			case 16:
				k.mpis = [try r.mpi(), try r.mpi(), try r.mpi()]
			case 17:
				k.mpis = [try r.mpi(), try r.mpi(), try r.mpi(), try r.mpi()]
			case 18, 19, 22:
				let size = try r.byte1()
				fail pgpError("a curve OID length of {size} is reserved") when size := 0 || 0xFF
				k.oid = try r.take(size)
				k.mpis = [try r.mpi()]
				if k.algorithm == 18 {
					let kdfSize = try r.byte1()
					fail pgpError("ECDH KDF parameters of {kdfSize} octets are not known") unless kdfSize == 3
					fail pgpError("ECDH KDF parameters start with 1") unless (try r.byte1()) == 1
					k.kdfHash = try r.byte1()
					k.kdfCipher = try r.byte1()
				}
			case 25:
				k.native = try r.take(32)
			case 26:
				k.native = try r.take(56)
			case 27:
				k.native = try r.take(32)
			case 28:
				k.native = try r.take(57)
			default:
				// An unknown algorithm: a version 6 key says how long its
				// material is; anything else cannot be parsed further.
				fail pgpError("public key algorithm {k.algorithm} is not known") unless k.version == 6
				r.pos = r.data.len()
		}
		return none
	}

	// The public material of a new key from its fields.
	internal def materialOf(k KeyPacket) byte[] {
		let out byte[] = []
		switch k.algorithm {
			case 18, 19, 22:
				out.push(byte(k.oid.len()))
				out += k.oid
				out += mpiBytes(k.mpis[0])
				out += [byte(3), byte(1), byte(k.kdfHash), byte(k.kdfCipher)] when k.algorithm == 18
			case 25, 26, 27, 28:
				out += k.native
			default:
				for let m in k.mpis {
					out += mpiBytes(m)
				}
		}
		return out
	}

	// What kind of key generateKey makes (`KeyOptions.algorithm`).
	enum KeyAlgorithm {
		// Ed25519 for signing, X25519 for encryption (RFC 9580's MUST).
		Curve25519,
		// Ed448 and X448.
		Curve448,
		// NIST P-256 ECDSA and ECDH.
		P256,
		// NIST P-384 ECDSA and ECDH.
		P384,
		// NIST P-521 ECDSA and ECDH.
		P521,
		// RSA (deprecated by RFC 9580, for old peers), of `KeyOptions.bits`.
		RSA
	}

	// A new key packet of a kind, for signing or encrypting.
	internal def newKeyPacket(kind KeyAlgorithm, encrypt bool, version int, created int, bits int, subkey bool) !KeyPacket {
		let k = new KeyPacket()
		k.tag = subkey ?? (tagSecretSubkey, tagSecretKey)
		k.version = version
		k.created = created
		k.hasSecret = true
		k.unlocked = true
		switch kind {
			case KeyAlgorithm.Curve25519:
				if version == 4 {
					// Version 4 keys use the legacy forms, which every
					// version 4 implementation reads (§9.2).
					if encrypt {
						let key = try crypto.generateX25519Key()
						k.algorithm = 18
						k.oid = oidCurve25519Legacy
						k.mpis = [byte[0x40] + key.public.bytes]
						k.secretMPIs = [legacyScalar(key.scalar)]
						k.kdfHash = 8
						k.kdfCipher = 7
					} else {
						let key = try crypto.generateEd25519Key()
						k.algorithm = 22
						k.oid = oidEd25519Legacy
						k.mpis = [byte[0x40] + key.public.bytes]
						k.secretMPIs = [key.seed]
					}
				} else if encrypt {
					let key = try crypto.generateX25519Key()
					k.algorithm = 25
					k.native = key.public.bytes
					k.secretNative = key.scalar
				} else {
					let key = try crypto.generateEd25519Key()
					k.algorithm = 27
					k.native = key.public.bytes
					k.secretNative = key.seed
				}
			case KeyAlgorithm.Curve448:
				if encrypt {
					let key = try crypto.generateX448Key()
					k.algorithm = 26
					k.native = key.public.bytes
					k.secretNative = key.scalar
				} else {
					let key = try crypto.generateEd448Key()
					k.algorithm = 28
					k.native = key.public.bytes
					k.secretNative = key.seed
				}
			case KeyAlgorithm.RSA:
				let key = try crypto.generateRSAKey(bits)
				k.algorithm = 1
				k.mpis = [key.n.bytes(), bigintBytes(bigint(key.e))]
				// RFC 9580 keeps p < q and u = p⁻¹ mod q.
				let p = key.p < key.q ?? (key.p, key.q)
				let q = key.p < key.q ?? (key.q, key.p)
				let u = p.modInverse(q)
				fail pgpError("the RSA primes have no inverse") when u is none
				k.secretMPIs = [key.d.bytes(), p.bytes(), q.bytes(), u.bytes()]
			default:
				let curve = kind == KeyAlgorithm.P256 ?? (crypto.p256, kind == KeyAlgorithm.P384 ?? (crypto.p384, crypto.p521))
				let oid = kind == KeyAlgorithm.P256 ?? (oidP256, kind == KeyAlgorithm.P384 ?? (oidP384, oidP521))
				let key = try crypto.generateECDSAKey(curve)
				k.algorithm = encrypt ?? (18, 19)
				k.oid = oid
				k.mpis = [crypto.marshalPoint(curve, key.point)]
				k.secretMPIs = [key.d.bytes()]
				if encrypt {
					k.kdfHash = kind == KeyAlgorithm.P256 ?? (8, kind == KeyAlgorithm.P384 ?? (9, 10))
					k.kdfCipher = kind == KeyAlgorithm.P256 ?? (7, kind == KeyAlgorithm.P384 ?? (8, 9))
				}
		}
		k.material = materialOf(k)
		try k.protect([])
		return k
	}

	// A Curve25519Legacy secret as its MPI holds it: the clamped native
	// scalar in reverse octet order (§5.5.5.6.1.1).
	internal def legacyScalar(native byte[]) byte[] {
		let clamped = native[0:32].clone()
		clamped[0] = clamped[0] & byte(248)
		clamped[31] = (clamped[31] & byte(127)) | byte(64)
		return clamped.reverse()
	}

	internal def bigintBytes(v bigint) byte[] {
		return v.bytes()
	}

	internal def nowSeconds() int {
		return int(time.wallNs() / 1000000000)
	}
}
