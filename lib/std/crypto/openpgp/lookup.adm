partial module std.crypto.openpgp {
	use (
		std.crypto.hash
		std.crypto.hash::(Hash)
		std.net.http
		std.net.url::(queryEscape, Values)
	)

	// lookupWKD fetches the keys of an e-mail address from its domain's Web
	// Key Directory (draft-koch-openpgp-webkey-service): the advanced method
	// at `openpgpkey.<domain>`, then, when that host cannot be reached, the
	// direct method at the domain itself. Only keys with a user ID holding
	// the address are returned.
	// Fails when the address has no `@`, the directory has no key for it, or
	// what it serves is not OpenPGP keys.
	def lookupWKD(email string) !Key[] {
		let at = email.lastIndexOf("@")
		fail pgpError("\"{email}\" is not an e-mail address") when at <= 0 || at == email.len() - 1
		let local = email[0:at]
		let domain = email[at + 1:].lower()
		let hashed = zbase32(hash.digest(Hash.SHA1, local.lower().bytes()))
		let query = "?l=" + queryEscape(local)
		let advanced = "https://openpgpkey.{domain}/.well-known/openpgpkey/{domain}/hu/{hashed}{query}"
		let direct = "https://{domain}/.well-known/openpgpkey/hu/{hashed}{query}"
		// The direct method is used only when the advanced method's host
		// does not answer (§3.1).
		let res = http.get(advanced) onerror (err error) {
			recover try http.get(direct)
		}
		fail pgpError("the Web Key Directory of {domain} has no key for {email} (HTTP {res.status})") unless res.ok()
		let found = try readKeys(try res.bytes())
		let out Key[] = []
		for let key in found {
			out.push(key) when key.matches(email)
		}
		fail pgpError("the Web Key Directory of {domain} serves no key with the user ID {email}") when out.len() == 0
		return out
	}

	// z-base-32 (the WKD encoding of the hashed local part).
	internal def zbase32(data byte[]) string {
		let alphabet = "ybndrfg8ejkmcpqxot1uwisza345h769"
		let out = ""
		let buffer = 0
		let bits = 0
		for let b in data {
			buffer = (buffer << 8) | int(b)
			bits += 8
			for bits >= 5 {
				bits -= 5
				out += alphabet.slice((buffer >> bits) & 31, ((buffer >> bits) & 31) + 1)
			}
		}
		out += alphabet.slice((buffer << (5 - bits)) & 31, ((buffer << (5 - bits)) & 31) + 1) when bits > 0
		return out
	}

	// An HKP key server (draft-gallagher-openpgp-hkp), such as
	// keys.openpgp.org.
	type KeyServer {
		// The server's base URL: `https://host` (port 443) or
		// `http://host:11371`.
		url string

		def new(url string = "https://keys.openpgp.org") {
			self.url = url.trimEnd("/")
		}

		// get fetches the keys a query finds: a fingerprint (or Key ID),
		// with or without 0x, or an e-mail address.
		// Fails when the server finds no key or cannot be reached.
		def get(query string) !Key[] {
			let q = query.trim().replace(" ", "", -1)
			let isHex = q.len() >= 16 && /^(0[xX])?[0-9A-Fa-f]+$/.test(q)
			let search = isHex && !q.startsWith("0x") && !q.startsWith("0X") ?? ("0x" + q, q)
			let res = try http.get(url + "/pks/lookup?op=get&options=mr&search=" + queryEscape(search))
			fail pgpError("the key server has no key for {query}") when res.status == 404
			fail pgpError("the key server answered HTTP {res.status}") unless res.ok()
			return try readKeys(try res.bytes())
		}

		// upload sends the certificate (never the secret key) to the server.
		// keys.openpgp.org then mails each address for confirmation before it
		// publishes the user IDs.
		// Fails when the server refuses the key or cannot be reached.
		def upload(key Key) !none {
			let form = new Values()
			form.set("keytext", key.publicKey().armored())
			let res = try http.postForm(url + "/pks/add", form)
			fail pgpError("the key server refused the key: HTTP {res.status}") unless res.ok()
			return none
		}
	}
}
