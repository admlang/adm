partial module std.crypto.openpgp {
	// OpenPGP (RFC 9580): version 6 keys, and version 4 keys and messages for
	// peers that do not read version 6 yet. Keys are generated, read and
	// written (binary or armored), locked with a passphrase, given user IDs
	// and subkeys, renewed and revoked; a `Keyring` decrypts and verifies.
	// Messages are encrypted to keys or a passphrase (SEIPD version 2 with
	// AEAD, or version 1 for version 4 peers), signed inline, detached or
	// as cleartext, and compressed. Keys are found by Web Key Directory and
	// on HKP key servers.
	//
	//     let alice = try openpgp.generateKey("Alice <alice@example.org>")
	//     let bob = (try openpgp.lookupWKD("bob@example.org"))[0]
	//     let sealed = try openpgp.encrypt(data, [bob], EncryptOptions{signers: [alice]})
	//     println(openpgp.armor(ArmorKind.Message, sealed))
	//
	//     let ring = new Keyring([alice, bob])
	//     let message = try ring.decrypt(reply)
	//     println(message.verified())
}
