partial module std.crypto.openpgp {
	use (
		std.crypto.hash
		std.crypto.hash::(Hash)
		std.net.http
		std.net.http.httptest
		std.testing
		std.time
	)

	// An HKP server over a keyring, for the KeyServer tests.
	internal type TestKeyServer {
		ring Keyring

		def new() {
			ring = new Keyring()
		}

		// Serve implements http.Handler.
		def serve(ctx http.Context) !none {
			if ctx.path() == "/pks/add" {
				for let key in try readKeys(ctx.formValue("keytext")) {
					ring.add(key)
				}
				return try ctx.text(200, "added")
			}
			let found = ring.find(ctx.query("search", ""))
			return try ctx.text(404, "no key") when ctx.path() != "/pks/lookup" || found.len() == 0
			return try ctx.blob(200, "application/pgp-keys", armor(ArmorKind.PublicKey, new Keyring(found).bytes()).bytes())
		}
	}

	check "OpenPGP keys" {
		@test()
		def readsVersion6Certificate() !none {
			let keys = try readKeys(rfcA3)
			assert keys.len() == 1
			let key = keys[0]
			assert key.fingerprint() == "CB186C4F0609A697E4D52DFA6C722B0C1F1E27C18A56708F6525EC27BAD9ACC9"
			assert key.version() == 6
			assert !key.isSecret()
			assert !key.isRevoked()
			assert key.expires() is none
			let subs = key.subkeys()
			assert subs.len() == 1
			assert subs[0].fingerprint == "12C83F1E706F6308FE151A417743A1F033790E93E9978488D1DB378DA9930885"
			assert subs[0].canEncrypt && !subs[0].revoked
			assert (try readKeys(key.bytes()))[0].fingerprint() == key.fingerprint()
		}

		@test()
		def hashesWKDLocalParts() !none {
			// draft-koch-openpgp-webkey-service §3.1: Joe.Doe@Example.ORG.
			assert zbase32(hash.digest(Hash.SHA1, "joe.doe".bytes())) == "iy9q119eutrkn8s1mk4r39qejnbu3n5q"
		}

		@test()
		def readsVersion4LegacyKey() !none {
			let key = (try readKeys(rfcA1))[0]
			assert key.fingerprint() == "C959BDBAFA32A2F89A153B678CFDE12197965A9A"
			assert key.keyID() == "8CFDE12197965A9A"
		}

		@test()
		def locksAndUnlocksSecretKey() !none {
			let plain = (try readKeys(rfcA4))[0]
			assert plain.isSecret() && !plain.isLocked()
			let key = try generateKey("Alice <alice@example.org>", KeyOptions{passphrase: "secret words"})
			assert !key.isLocked()
			try key.lock("secret words")
			let read = (try readKeys(key.armored()))[0]
			assert read.isSecret() && read.isLocked()
			let wrong = false
			read.unlock("wrong") onerror (err error) {
				wrong = true
				recover none
			}
			assert wrong && read.isLocked()
			try read.unlock("secret words")
			assert !read.isLocked()
			assert read.userIDs().equals(["Alice <alice@example.org>"])
			assert read.fingerprint() == key.fingerprint()
		}

		@test()
		def managesKeys() !none {
			let key = try generateKey("Gus <gus@example.org>")
			assert time.since(key.created()) < 1h
			let primaryID = key.primaryUserID()
			assert !(primaryID is none) && primaryID == "Gus <gus@example.org>"
			assert key.matches("gus@example.org") && key.matches("0x" + key.keyID()) && !key.matches("gus@example.net")
			try key.addSubkey(sign = true)
			let signing = key.subkeys()[1]
			assert signing.canSign && !signing.canEncrypt
			let ring = new Keyring([key.publicKey()])
			let sig = try key.sign("data".bytes())
			let checked = try ring.verify("data".bytes(), sig)
			assert checked[0].valid && checked[0].fingerprint == signing.fingerprint
			try key.revokeSubkey(signing.fingerprint, RevocationReason.Compromised)
			assert key.subkeys()[1].revoked
			try key.renew(7200s)
			assert !(key.expires() is none)
			// A copy with the new signatures merges into the old one.
			ring.add(key.publicKey())
			assert ring.keys.len() == 1 && ring.keys[0].subkeys()[1].revoked && !(ring.keys[0].expires() is none)
			let other = (try readKeys(key.publicKey().bytes()))[0]
			try key.addUserID("Gus <gus@example.net>")
			try other.merge(key.publicKey())
			assert other.userIDs().len() == 2
			let blocks = try dearmor(key.armored())
			assert blocks.len() == 1 && blocks[0].kind == ArmorKind.PrivateKey
			let bad = false
			lookupWKD("not an address") onerror (err error) {
				bad = true
				recover []
			}
			assert bad
		}

		@test()
		def usesHKPKeyServers() !none {
			let handler = new TestKeyServer()
			let ts = try httptest.Server.start(handler)
			let server = new KeyServer(ts.url + "/")
			let key = try generateKey("Ida <ida@example.org>")
			try server.upload(key)
			assert handler.ring.keys.len() == 1 && !handler.ring.keys[0].isSecret()
			assert (try server.get(key.fingerprint()))[0].fingerprint() == key.fingerprint()
			assert (try server.get("ida@example.org"))[0].fingerprint() == key.fingerprint()
			let missing = false
			server.get("ida@example.net") onerror (err error) {
				missing = true
				recover []
			}
			assert missing
			try ts.close()
		}
	}

	check "OpenPGP messages" {
		@test()
		def verifiesRFC9580Signatures() !none {
			let legacy = new Keyring(try readKeys(rfcA1))
			let detached = try legacy.verify("OpenPGP".bytes(), rfcA2)
			assert detached.len() == 1 && detached[0].valid
			assert !(try legacy.verify("OpenPGQ".bytes(), rfcA2))[0].valid
			let ring = new Keyring(try readKeys(rfcA3))
			let clear = try ring.verifyCleartext(rfcA6)
			assert clear.verified()
			assert string(clear.data) == "What we need from the grocery store:\n\n- tofu\n- vegetables\n- noodles\n"
			let inline = try ring.verify(rfcA7.bytes())
			assert inline.verified()
			assert string(inline.data) == "What we need from the grocery store:\n\n- tofu\n- vegetables\n- noodles\n"
			let tampered = rfcA6.replace("tofu", "tofu and cake", 1)
			assert !(try ring.verifyCleartext(tampered)).verified()
		}

		@test()
		def decryptsRFC9580Messages() !none {
			let ring = new Keyring(try readKeys(rfcA4))
			let m = try ring.decrypt(rfcA8)
			assert m.encrypted
			assert string(m.data) == "Hello, world!"
			// A.9 (EAX); A.10 (OCB) and A.11 (GCM) differ only in the mode and
			// cost a 64 MiB iterated S2K each.
			let noKeys = new Keyring()
			assert string((try noKeys.decrypt(rfcA9, "password")).data) == "Hello, world!"
			let sealed = try encrypt("secret".bytes(), "right")
			assert string((try noKeys.decrypt(sealed, "right")).data) == "secret"
			let wrong = false
			noKeys.decrypt(sealed, "wrong") onerror (err error) {
				wrong = true
				recover new Message()
			}
			assert wrong
		}

		@test()
		def roundTripsVersion6() !none {
			let alice = try generateKey("Alice <alice@example.org>")
			let bob = try generateKey("Bob <bob@example.org>", KeyOptions{algorithm: KeyAlgorithm.Curve448})
			let data = "attack at dawn".bytes()
			let sealed = try encrypt(data, [bob.publicKey()], EncryptOptions{signers: [alice], compression: CompressionAlgorithm.ZLIB})
			let ring = new Keyring([bob, alice.publicKey()])
			let m = try ring.decrypt(armor(ArmorKind.Message, sealed))
			assert m.data.hex() == data.hex() && m.encrypted && m.verified()
			assert m.signatures[0].fingerprint == alice.fingerprint()
			let flipped = sealed.clone()
			flipped[flipped.len() - 20] = flipped[flipped.len() - 20] ^ byte(1)
			let modified = false
			ring.decrypt(flipped) onerror (err error) {
				modified = true
				recover new Message()
			}
			assert modified
			let sig = try alice.sign(data)
			assert (try ring.verify(data, sig))[0].valid
			assert !(try ring.verify("attack at dusk".bytes(), sig))[0].valid
			let clear = try alice.signCleartext("- dashes\nFrom here\ntrailing   \n")
			let read = try ring.verifyCleartext(clear)
			assert read.verified() && string(read.data) == "- dashes\nFrom here\ntrailing   \n"
		}

		@test()
		def roundTripsVersion4() !none {
			let carol = try generateKey("Carol <carol@example.org>", KeyOptions{version: 4})
			let dave = try generateKey("Dave <dave@example.org>", KeyOptions{version: 4, algorithm: KeyAlgorithm.P256})
			assert carol.version() == 4 && carol.algorithm() == PublicKeyAlgorithm.EdDSALegacy
			let sealed = try encrypt("hi".bytes(), [carol.publicKey(), dave.publicKey()], EncryptOptions{signers: [dave], text: true, compression: CompressionAlgorithm.ZIP})
			for let key in [carol, dave] {
				let m = try new Keyring([key, dave.publicKey()]).decrypt(sealed)
				assert string(m.data) == "hi" && m.text && m.verified()
			}
			let both = try encrypt("pass".bytes(), [carol], EncryptOptions{passphrase: "pw", compression: CompressionAlgorithm.BZip2})
			assert string((try new Keyring().decrypt(both, "pw")).data) == "pass"
			let inline = try dave.sign("signed".bytes(), false)
			assert (try new Keyring([dave]).verify(inline)).verified()
		}

		@test()
		def honoursRevocationAndExpiry() !none {
			let erin = try generateKey("Erin <erin@example.org>")
			let sig = try erin.sign("x".bytes())
			try erin.revoke(RevocationReason.Compromised)
			assert erin.isRevoked()
			// A compromised key's earlier signatures no longer hold.
			assert !(try new Keyring([erin]).verify("x".bytes(), sig))[0].valid
			let failed = false
			encrypt("x".bytes(), [erin]) onerror (err error) {
				failed = true
				recover []
			}
			assert failed
			let frank = try generateKey("Frank <frank@example.org>", KeyOptions{validity: 3600s})
			assert !(frank.expires() is none)
			try frank.addUserID("Frank <f@example.net>")
			assert frank.userIDs().len() == 2
			try frank.revokeUserID("Frank <f@example.net>")
			assert frank.userIDs().equals(["Frank <frank@example.org>"])
			let copy = (try readKeys(frank.publicKey().armored()))[0]
			assert copy.userIDs().equals(["Frank <frank@example.org>"]) && !copy.isSecret()
		}

		@test()
		def readsGnuPGData() !none {
			let ring = new Keyring(try readKeys(gpgGina + gpgHank))
			assert ring.keys.len() == 2
			let text = "Hello from gpg\nsecond line\n"
			let m = try ring.decrypt(gpgEncrypted)
			assert string(m.data) == text && m.filename == "msg.txt" && m.verified()
			assert m.signatures[0].fingerprint == ring.find("hank@example.org")[0].fingerprint()
			assert (try ring.verifyCleartext(gpgClear)).verified()
			assert (try ring.verify(text.bytes(), gpgDetached))[0].valid
			assert string((try new Keyring().decrypt(gpgSymmetric, "pw")).data) == text
			// Version 4 keys without the SEIPD v2 feature get version 1.
			let hank = ring.find("hank@example.org")[0]
			let sealed = try encrypt("back".bytes(), [hank.publicKey()])
			assert int((try readPackets(sealed))[1].body[0]) == 1
			assert string((try ring.decrypt(sealed)).data) == "back"
		}
	}

	// RFC 9580 Appendix A.
	internal const rfcA1 = "-----BEGIN PGP PUBLIC KEY BLOCK-----\n" +
		"\n" +
		"xjMEU/NfCxYJKwYBBAHaRw8BAQdAPwmJlL3ZFu1AUxl5NOSofIBzOhKA1i+AEJku\n" +
		"Q+47JAY=\n" +
		"-----END PGP PUBLIC KEY BLOCK-----\n"

	internal const rfcA2 = "-----BEGIN PGP SIGNATURE-----\n" +
		"\n" +
		"iF4EABYIAAYFAlX5X5UACgkQjP3hIZeWWpr2IgD/VvkMypjiECY3vZg/2xbBMd/S\n" +
		"ftgr9N3lYG4NdWrtM2YBANCcT6EVJ/A44PV/IgHYLy6iyQMyZfps60iehUuuYbQE\n" +
		"-----END PGP SIGNATURE-----\n"

	internal const rfcA3 = "-----BEGIN PGP PUBLIC KEY BLOCK-----\n" +
		"\n" +
		"xioGY4d/4xsAAAAg+U2nu0jWCmHlZ3BqZYfQMxmZu52JGggkLq2EVD34laPCsQYf\n" +
		"GwoAAABCBYJjh3/jAwsJBwUVCg4IDAIWAAKbAwIeCSIhBssYbE8GCaaX5NUt+mxy\n" +
		"KwwfHifBilZwj2Ul7Ce62azJBScJAgcCAAAAAK0oIBA+LX0ifsDm185Ecds2v8lw\n" +
		"gyU2kCcUmKfvBXbAf6rhRYWzuQOwEn7E/aLwIwRaLsdry0+VcallHhSu4RN6HWaE\n" +
		"QsiPlR4zxP/TP7mhfVEe7XWPxtnMUMtf15OyA51YBM4qBmOHf+MZAAAAIIaTJINn\n" +
		"+eUBXbki+PSAld2nhJh/LVmFsS+60WyvXkQ1wpsGGBsKAAAALAWCY4d/4wKbDCIh\n" +
		"BssYbE8GCaaX5NUt+mxyKwwfHifBilZwj2Ul7Ce62azJAAAAAAQBIKbpGG2dWTX8\n" +
		"j+VjFM21J0hqWlEg+bdiojWnKfA5AQpWUWtnNwDEM0g12vYxoWM8Y81W+bHBw805\n" +
		"I8kWVkXU6vFOi+HWvv/ira7ofJu16NnoUkhclkUrk0mXubZvyl4GBg==\n" +
		"-----END PGP PUBLIC KEY BLOCK-----\n"

	internal const rfcA4 = "-----BEGIN PGP PRIVATE KEY BLOCK-----\n" +
		"\n" +
		"xUsGY4d/4xsAAAAg+U2nu0jWCmHlZ3BqZYfQMxmZu52JGggkLq2EVD34laMAGXKB\n" +
		"exK+cH6NX1hs5hNhIB00TrJmosgv3mg1ditlsLfCsQYfGwoAAABCBYJjh3/jAwsJ\n" +
		"BwUVCg4IDAIWAAKbAwIeCSIhBssYbE8GCaaX5NUt+mxyKwwfHifBilZwj2Ul7Ce6\n" +
		"2azJBScJAgcCAAAAAK0oIBA+LX0ifsDm185Ecds2v8lwgyU2kCcUmKfvBXbAf6rh\n" +
		"RYWzuQOwEn7E/aLwIwRaLsdry0+VcallHhSu4RN6HWaEQsiPlR4zxP/TP7mhfVEe\n" +
		"7XWPxtnMUMtf15OyA51YBMdLBmOHf+MZAAAAIIaTJINn+eUBXbki+PSAld2nhJh/\n" +
		"LVmFsS+60WyvXkQ1AE1gCk95TUR3XFeibg/u/tVY6a//1q0NWC1X+yui3O24wpsG\n" +
		"GBsKAAAALAWCY4d/4wKbDCIhBssYbE8GCaaX5NUt+mxyKwwfHifBilZwj2Ul7Ce6\n" +
		"2azJAAAAAAQBIKbpGG2dWTX8j+VjFM21J0hqWlEg+bdiojWnKfA5AQpWUWtnNwDE\n" +
		"M0g12vYxoWM8Y81W+bHBw805I8kWVkXU6vFOi+HWvv/ira7ofJu16NnoUkhclkUr\n" +
		"k0mXubZvyl4GBg==\n" +
		"-----END PGP PRIVATE KEY BLOCK-----\n"

	internal const rfcA5 = "-----BEGIN PGP PRIVATE KEY BLOCK-----\n" +
		"\n" +
		"xYIGY4d/4xsAAAAg+U2nu0jWCmHlZ3BqZYfQMxmZu52JGggkLq2EVD34laP9JgkC\n" +
		"FARdb9ccngltHraRe25uHuyuAQQVtKipJ0+r5jL4dacGWSAheCWPpITYiyfyIOPS\n" +
		"3gIDyg8f7strd1OB4+LZsUhcIjOMpVHgmiY/IutJkulneoBYwrEGHxsKAAAAQgWC\n" +
		"Y4d/4wMLCQcFFQoOCAwCFgACmwMCHgkiIQbLGGxPBgmml+TVLfpscisMHx4nwYpW\n" +
		"cI9lJewnutmsyQUnCQIHAgAAAACtKCAQPi19In7A5tfORHHbNr/JcIMlNpAnFJin\n" +
		"7wV2wH+q4UWFs7kDsBJ+xP2i8CMEWi7Ha8tPlXGpZR4UruETeh1mhELIj5UeM8T/\n" +
		"0z+5oX1RHu11j8bZzFDLX9eTsgOdWATHggZjh3/jGQAAACCGkySDZ/nlAV25Ivj0\n" +
		"gJXdp4SYfy1ZhbEvutFsr15ENf0mCQIUBA5hhGgp2oaavg6mFUXcFMwBBBUuE8qf\n" +
		"9Ock+xwusd+GAglBr5LVyr/lup3xxQvHXFSjjA2haXfoN6xUGRdDEHI6+uevKjVR\n" +
		"v5oAxgu7eJpaXNjCmwYYGwoAAAAsBYJjh3/jApsMIiEGyxhsTwYJppfk1S36bHIr\n" +
		"DB8eJ8GKVnCPZSXsJ7rZrMkAAAAABAEgpukYbZ1ZNfyP5WMUzbUnSGpaUSD5t2Ki\n" +
		"Nacp8DkBClZRa2c3AMQzSDXa9jGhYzxjzVb5scHDzTkjyRZWRdTq8U6L4da+/+Kt\n" +
		"ruh8m7Xo2ehSSFyWRSuTSZe5tm/KXgYG\n" +
		"-----END PGP PRIVATE KEY BLOCK-----\n"

	internal const rfcA6 = "-----BEGIN PGP SIGNED MESSAGE-----\n" +
		"\n" +
		"What we need from the grocery store:\n" +
		"\n" +
		"- - tofu\n" +
		"- - vegetables\n" +
		"- - noodles\n" +
		"\n" +
		"-----BEGIN PGP SIGNATURE-----\n" +
		"\n" +
		"wpgGARsKAAAAKQWCY5ijYyIhBssYbE8GCaaX5NUt+mxyKwwfHifBilZwj2Ul7Ce6\n" +
		"2azJAAAAAGk2IHZJX1AhiJD39eLuPBgiUU9wUA9VHYblySHkBONKU/usJ9BvuAqo\n" +
		"/FvLFuGWMbKAdA+epq7V4HOtAPlBWmU8QOd6aud+aSunHQaaEJ+iTFjP2OMW0KBr\n" +
		"NK2ay45cX1IVAQ==\n" +
		"-----END PGP SIGNATURE-----\n"

	internal const rfcA7 = "-----BEGIN PGP MESSAGE-----\n" +
		"\n" +
		"xEYGAQobIHZJX1AhiJD39eLuPBgiUU9wUA9VHYblySHkBONKU/usyxhsTwYJppfk\n" +
		"1S36bHIrDB8eJ8GKVnCPZSXsJ7rZrMkBy0p1AAAAAABXaGF0IHdlIG5lZWQgZnJv\n" +
		"bSB0aGUgZ3JvY2VyeSBzdG9yZToKCi0gdG9mdQotIHZlZ2V0YWJsZXMKLSBub29k\n" +
		"bGVzCsKYBgEbCgAAACkFgmOYo2MiIQbLGGxPBgmml+TVLfpscisMHx4nwYpWcI9l\n" +
		"JewnutmsyQAAAABpNiB2SV9QIYiQ9/Xi7jwYIlFPcFAPVR2G5ckh5ATjSlP7rCfQ\n" +
		"b7gKqPxbyxbhljGygHQPnqau1eBzrQD5QVplPEDnemrnfmkrpx0GmhCfokxYz9jj\n" +
		"FtCgazStmsuOXF9SFQE=\n" +
		"-----END PGP MESSAGE-----\n"

	internal const rfcA8 = "-----BEGIN PGP MESSAGE-----\n" +
		"\n" +
		"wV0GIQYSyD8ecG9jCP4VGkF3Q6HwM3kOk+mXhIjR2zeNqZMIhRmHzxjV8bU/gXzO\n" +
		"WgBM85PMiVi93AZfJfhK9QmxfdNnZBjeo1VDeVZheQHgaVf7yopqR6W1FT6NOrfS\n" +
		"aQIHAgZhZBZTW+CwcW1g4FKlbExAf56zaw76/prQoN+bAzxpohup69LA7JW/Vp0l\n" +
		"yZnuSj3hcFj0DfqLTGgr4/u717J+sPWbtQBfgMfG9AOIwwrUBqsFE9zW+f1zdlYo\n" +
		"bhF30A+IitsxxA==\n" +
		"-----END PGP MESSAGE-----\n"

	internal const rfcA9 = "-----BEGIN PGP MESSAGE-----\n" +
		"\n" +
		"w0AGHgcBCwMIpa5XnR/F2Cv/aSJPkZmTs1Bvo7WaanPP+MXvxfQcV/tU4cImgV14\n" +
		"KPX5LEVOtl6+AKtZhsaObnxV0mkCBwEGn/kOOzIZZPOkKRPI3MZhkyUBUifvt+rq\n" +
		"pJ8EwuZ0F11KPSJu1q/LnKmsEiwUcOEcY9TAqyQcapOK1Iv5mlqZuQu6gyXeYQR1\n" +
		"QCWKt5Wala0FHdqW6xVDHf719eIlXKeCYVRuM5o=\n" +
		"-----END PGP MESSAGE-----\n"

	// Made by GnuPG 2.4.9: Gina (Ed25519 with a Curve25519 ECDH subkey,
	// version 4), Hank (RSA 2048 with an RSA encryption subkey); a message
	// encrypted to both and signed by Hank, Gina's cleartext and Hank's
	// detached signatures of "Hello from gpg\nsecond line\n", and that
	// text encrypted with the passphrase "pw".
	internal const gpgGina = "-----BEGIN PGP PRIVATE KEY BLOCK-----\n" +
		"\n" +
		"lFgEatBSBRYJKwYBBAHaRw8BAQdAIL2KjtAKJg4f8OjMhiplMXBwd7mS1hNoyb8a\n" +
		"fr9d7hUAAQDR4XEEhToMgCXESmmLbQ+xollskRpsHD0t0+tqjnbiNw4QtBdHaW5h\n" +
		"IDxnaW5hQGV4YW1wbGUub3JnPoiTBBMWCgA7FiEE1l2SC4zyCmaKI2wplY/corXa\n" +
		"1rwFAmrQUgUCGwMFCwkIBwICIgIGFQoJCAsCBBYCAwECHgcCF4AACgkQlY/corXa\n" +
		"1rznmwD9Fq76MfMclccMDvKYYgg4FkU/lZLhui47uZhZwn7rxfcBAIdeurivn96R\n" +
		"zKh+vm5YXCnGOdi8kVQlBvoajGARZtICnF0EatBSBRIKKwYBBAGXVQEFAQEHQOIc\n" +
		"W0tXnC8/rf1lW6fWjx0NYw9OxL15RUQ7MM+6W692AwEIBwAA/3Hh3Skyw4oF/Zlr\n" +
