partial module std.crypto.openpgp {
	use std.errors

	// OpenPGPError is the payload of data that is not OpenPGP, or that
	// fails a check (a signature, an integrity tag, a passphrase).
	struct OpenPGPError {
		message string
		code    string            = "openpgp"
		cause   ?error
		stack   errors.StackTrace
	}

	internal def pgpError(problem string) OpenPGPError {
		return OpenPGPError{message: "openpgp: " + problem}
	}

	// The Packet Type IDs (RFC 9580 §5).
	internal const tagPKESK = 1
	internal const tagSignature = 2
	internal const tagSKESK = 3
	internal const tagOnePass = 4
	internal const tagSecretKey = 5
	internal const tagPublicKey = 6
	internal const tagSecretSubkey = 7
	internal const tagCompressed = 8
	internal const tagSED = 9
	internal const tagMarker = 10
	internal const tagLiteral = 11
	internal const tagTrust = 12
	internal const tagUserID = 13
	internal const tagPublicSubkey = 14
	internal const tagUserAttribute = 17
	internal const tagSEIPD = 18
	internal const tagPadding = 21

	// One packet: its Type ID and body (partial bodies joined).
	internal struct Packet {
		tag  int
		body byte[]
	}

	// The packets of a byte sequence, in both header formats: the
	// OpenPGP one (1-, 2-, 5-octet and partial body lengths) and the legacy
	// one (an indeterminate length runs to the end).
	internal def readPackets(data byte[]) !Packet[] {
		let out Packet[] = []
		let pos = 0
		let n = data.len()
		for pos < n {
			let first = int(data[pos])
			fail pgpError("octet {pos} does not start a packet") unless first & 0x80 != 0
			pos++
			if first & 0x40 != 0 {
				let tag = first & 0x3F
				let body byte[] = []
				for {
					fail pgpError("a packet header is cut short") when pos >= n
					let l1 = int(data[pos])
					pos++
					let size = 0
					let more = false
					if l1 < 192 {
						size = l1
					} else if l1 < 224 {
						fail pgpError("a packet header is cut short") when pos >= n
						size = ((l1 - 192) << 8) + int(data[pos]) + 192
						pos++
					} else if l1 == 255 {
						fail pgpError("a packet header is cut short") when pos + 4 > n
						size = (int(data[pos]) << 24) | (int(data[pos + 1]) << 16) | (int(data[pos + 2]) << 8) | int(data[pos + 3])
						pos += 4
					} else {
						size = 1 << (l1 & 0x1F)
						more = true
					}
					fail pgpError("a packet runs past the end of the data") when pos + size > n
					body += data[pos:pos + size]
					pos += size
					break unless more
				}
				out.push(Packet{tag: tag, body: body})
				continue
			}
			let tag = (first >> 2) & 0x0F
			let lengthType = first & 3
			let size = 0
			if lengthType == 0 {
				fail pgpError("a packet header is cut short") when pos >= n
				size = int(data[pos])
				pos++
			} else if lengthType == 1 {
				fail pgpError("a packet header is cut short") when pos + 2 > n
				size = (int(data[pos]) << 8) | int(data[pos + 1])
				pos += 2
			} else if lengthType == 2 {
				fail pgpError("a packet header is cut short") when pos + 4 > n
				size = (int(data[pos]) << 24) | (int(data[pos + 1]) << 16) | (int(data[pos + 2]) << 8) | int(data[pos + 3])
				pos += 4
			} else {
				size = n - pos
			}
			fail pgpError("a packet runs past the end of the data") when pos + size > n
			out.push(Packet{tag: tag, body: data[pos:pos + size]})
			pos += size
		}
		return out
	}

	// A packet in the OpenPGP format with the shortest length header.
	internal def packetBytes(tag int, body byte[]) byte[] {
		let out byte[] = [byte(0xC0 | tag)]
		out += lengthBytes(body.len())
		out += body
		return out
	}

	// The OpenPGP format's length octets (1, 2 or 5 of them).
	internal def lengthBytes(size int) byte[] {
		return [byte(size)] when size < 192
		if size < 8384 {
			let v = size - 192
			return [byte((v >> 8) + 192), byte(v & 0xFF)]
		}
		return [byte(255), byte((size >> 24) & 0xFF), byte((size >> 16) & 0xFF), byte((size >> 8) & 0xFF), byte(size & 0xFF)]
	}

	// Reads the fields of a packet body without going past its end.
	internal type BodyReader {
		data byte[]
		pos  int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def remaining() int {
			return data.len() - pos
		}

		def done() bool {
			return pos >= data.len()
		}

		def byte1() !int {
			fail pgpError("a packet is cut short") when pos >= data.len()
			let v = int(data[pos])
			pos++
			return v
		}

		def uint16() !int {
			let hi = try byte1()
			return (hi << 8) | (try byte1())
		}

		def uint32() !int {
			let hi = try uint16()
			return (hi << 16) | (try uint16())
		}

		def take(count int) !byte[] {
			fail pgpError("a packet is cut short") when count < 0 || pos + count > data.len()
			let out = data[pos:pos + count]
			pos += count
			return out
		}

		def rest() byte[] {
			let out = data[pos:]
			pos = data.len()
			return out
		}

		// A multiprecision integer: a bit count and its octets (§3.2).
		def mpi() !byte[] {
			let bits = try uint16()
			return try take((bits + 7) / 8)
		}

		// The 1-, 2- or 5-octet length of a subpacket (§5.2.3.7).
		def subpacketLength() !int {
			let first = try byte1()
			return first when first < 192
			return ((first - 192) << 8) + (try byte1()) + 192 when first < 255
			return try uint32()
		}
	}

	// An MPI of a big-endian magnitude: the bit count, then the octets
	// without leading zeros.
	internal def mpiBytes(value byte[]) byte[] {
		let start = 0
		for start < value.len() && value[start] == byte(0) {
			start++
		}
		let bits = 0
		if start < value.len() {
			let top = int(value[start])
			let width = 0
			for top > 0 {
				width++
				top = top >> 1
			}
			bits = (value.len() - start - 1) * 8 + width
		}
		let out byte[] = [byte(bits >> 8), byte(bits & 0xFF)]
		out += value[start:]
		return out
	}

	internal def uint32Bytes(v int) byte[] {
		return [byte((v >> 24) & 0xFF), byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF)]
	}
}
