partial module std.crypto.openpgp {
	use (
		std.crypto
		std.crypto.hash
	)

	// An S2K specifier (RFC 9580 §3.7.1): how a passphrase becomes a key.
	internal struct S2K {
		// 0 simple, 1 salted, 3 iterated and salted, 4 Argon2.
		kind   int
		hash   int    = 0
		salt   byte[] = []
		// The coded octet count of the iterated kind.
		coded  int    = 0
		passes int    = 0
		lanes  int    = 0
		// The Argon2 memory as an exponent: 2^memory KiB.
		memory int    = 0
	}

	internal def readS2K(r BodyReader) !S2K {
		let kind = try r.byte1()
		switch kind {
			case 0:
				return S2K{kind: 0, hash: try r.byte1()}
			case 1:
				let h = try r.byte1()
				return S2K{kind: 1, hash: h, salt: try r.take(8)}
			case 3:
				let h = try r.byte1()
				let salt = try r.take(8)
				return S2K{kind: 3, hash: h, salt: salt, coded: try r.byte1()}
			case 4:
				let salt = try r.take(16)
				let passes = try r.byte1()
				let lanes = try r.byte1()
				let memory = try r.byte1()
				fail pgpError("an Argon2 S2K needs passes and lanes") when passes == 0 || lanes == 0
				fail pgpError("the Argon2 memory exponent {memory} is out of range") when memory < 3 || memory > 31 || (1 << memory) < 8 * lanes
				return S2K{kind: 4, salt: salt, passes: passes, lanes: lanes, memory: memory}
			default:
				fail pgpError("S2K type {kind} is not known")
		}
	}

	internal def s2kBytes(s S2K) byte[] {
		let out byte[] = [byte(s.kind)]
		if s.kind == 4 {
			out += s.salt
			out += [byte(s.passes), byte(s.lanes), byte(s.memory)]
			return out
		}
		out.push(byte(s.hash))
		out += s.salt when s.kind := 1 || 3
		out.push(byte(s.coded)) when s.kind == 3
		return out
	}

	// A new S2K for protecting data: Argon2 (t=1, p=4, 2 GiB is the first
	// recommendation of RFC 9106; this uses its second, t=3, p=4, 64 MiB,
	// which fits small machines) or, where Argon2 is not allowed, iterated
	// and salted SHA2-256 with a high count.
	internal def newS2K(argon bool) !S2K {
		return S2K{kind: 4, salt: try crypto.rand(16), passes: 3, lanes: 4, memory: 16} when argon
		// 0xFF codes the largest count, 65011712 octets.
		return S2K{kind: 3, hash: 8, salt: try crypto.rand(8), coded: 0xFF}
	}

	// The key of `size` octets a passphrase gives.
	internal def deriveKey(s S2K, passphrase byte[], size int) !byte[] {
		return try hash.argon2id(passphrase, s.salt, 1 << s.memory, s.passes, s.lanes, size) when s.kind == 4
		let algorithm = try mustHash(s.hash)
		let data byte[] = []
		data += s.salt
		data += passphrase
		let total = data.len()
		if s.kind == 3 {
			let count = (16 + (s.coded & 15)) << ((s.coded >> 4) + 6)
			total = count < data.len() ?? (data.len(), count)
		}
		// The data repeated into a chunk, so the count is fed a chunk at a
		// time.
		let chunk byte[] = []
		if data.len() > 0 {
			for chunk.len() < 65536 {
				chunk += data
			}
		}
		let out byte[] = []
		let preload = 0
		for out.len() < size {
			let h = hash.newHasher(algorithm)
			if preload > 0 {
				let zeros byte[] = []
				zeros.len(preload)
				h.write(zeros)
			}
			let left = total
			for left > 0 && chunk.len() > 0 {
				let take = left < chunk.len() ?? (left, chunk.len())
				h.write(chunk[0:take])
				left -= take
			}
			out += h.hash()
			preload++
		}
		return out[0:size]
	}
}
