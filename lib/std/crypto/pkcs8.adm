partial module std.crypto {
	use (
		std.crypto.cipher
		std.crypto.cipher::(Block)
		std.crypto.hash::(Hash, pbkdf2)
		std.data.encoding::(ASN1Element, OID, asn1Parse, asn1Sequence, asn1OID, asn1Null, asn1Integer, asn1OctetString)
	)

	let (
		// PBES2 and PBKDF2 (RFC 8018 Appendix A).
		oidPBES2          = new OID([1, 2, 840, 113549, 1, 5, 13])
		oidPBKDF2         = new OID([1, 2, 840, 113549, 1, 5, 12])
		oidHMACWithSHA1   = new OID([1, 2, 840, 113549, 2, 7])
		oidHMACWithSHA224 = new OID([1, 2, 840, 113549, 2, 8])
		oidHMACWithSHA256 = new OID([1, 2, 840, 113549, 2, 9])
		oidHMACWithSHA384 = new OID([1, 2, 840, 113549, 2, 10])
		oidHMACWithSHA512 = new OID([1, 2, 840, 113549, 2, 11])
		oidAES128CBC      = new OID([2, 16, 840, 1, 101, 3, 4, 1, 2])
		oidAES192CBC      = new OID([2, 16, 840, 1, 101, 3, 4, 1, 22])
		oidAES256CBC      = new OID([2, 16, 840, 1, 101, 3, 4, 1, 42])
		oidDESEDE3CBC     = new OID([1, 2, 840, 113549, 3, 7])
	)

	// parseEncryptedPKCS8PrivateKey reads a DER EncryptedPrivateKeyInfo
	// (the body of an "ENCRYPTED PRIVATE KEY" PEM block, RFC 5958) protected
	// with PBES2 (RFC 8018): PBKDF2 over HMAC-SHA1, -SHA224, -SHA256,
	// -SHA384 or -SHA512, and AES-128/192/256-CBC or DES-EDE3-CBC, which is
	// what `openssl pkcs8 -topk8` writes. The decrypted key is read as
	// parsePKCS8PrivateKey reads one.
	// Fails on malformed DER, another encryption scheme (PBES1, scrypt), or
	// a wrong password (the padding or the key does not check out).
	def parseEncryptedPKCS8PrivateKey(der byte[], password Secret<string>) !PrivateKey {
		let info = asn1Parse(der) onerror fail "x509: encrypted PKCS#8 key is not DER"
		let algorithm = try info.at(0)
		let encrypted = try (try info.at(1)).asBytes()
		let scheme = try (try algorithm.at(0)).asOID()
		fail "x509: encrypted PKCS#8 scheme {scheme.str()} is not supported (PBES2 is)" unless scheme.equals(oidPBES2)
		let params = try algorithm.at(1)
		let kdf = try params.at(0)
		let kdfOID = try (try kdf.at(0)).asOID()
		fail "x509: PBES2 key derivation {kdfOID.str()} is not supported (PBKDF2 is)" unless kdfOID.equals(oidPBKDF2)
		let kdfParams = try kdf.at(1)
		let salt = try (try kdfParams.at(0)).asBytes()
		let rounds = try (try kdfParams.at(1)).asInt()
		fail "x509: PBKDF2 iteration count {rounds} is out of range" when rounds < 1 || rounds > 100000000
		let prf = Hash.SHA1
		let keyLength = 0
		// Optional keyLength (INTEGER), then optional prf (SEQUENCE).
		for let i = 2; i < kdfParams.children.len(); i++ {
			let field = kdfParams.children[i]
			if field.children.len() == 0 {
				keyLength = try field.asInt()
			} else {
				prf = try prfOf(try (try field.at(0)).asOID())
			}
		}
		let encryption = try params.at(1)
		let cipherOID = try (try encryption.at(0)).asOID()
		let iv = try (try encryption.at(1)).asBytes()
		let size = try pbes2KeySize(cipherOID)
		fail "x509: PBKDF2 key length {keyLength} does not fit the cipher" when keyLength != 0 && keyLength != size
		let key = pbkdf2(prf, password.reveal().bytes(), salt, rounds, size)
		let block = try pbes2Block(cipherOID, key)
		let cbc = try cipher.newCBC(block, iv)
		let padded = cbc.decrypt(encrypted) onerror fail "x509: the password does not decrypt the key"
		let plain = cipher.unpadPKCS7(padded, block.blockSize()) onerror fail "x509: the password does not decrypt the key"
		return parsePKCS8PrivateKey(plain) onerror fail "x509: the password does not decrypt the key"
	}

	// marshalEncryptedPKCS8PrivateKey writes a private key as a DER
	// EncryptedPrivateKeyInfo under a password: PBES2 with PBKDF2-HMAC-SHA256
	// (`rounds` iterations, a random 16-byte salt) and AES-256-CBC.
	// Fails when the system has no randomness.
	def marshalEncryptedPKCS8PrivateKey(key PrivateKey, password Secret<string>, rounds int = 600000) !byte[] {
		let plain = marshalPKCS8PrivateKey(key)
		let salt = try rand(16)
		let iv = try rand(16)
		let derived = pbkdf2(Hash.SHA256, password.reveal().bytes(), salt, rounds, 32)
		let cbc = try cipher.newCBC(try cipher.newAES(derived), iv)
		let encrypted = try cbc.encrypt(cipher.padPKCS7(plain, 16))
		let kdf = asn1Sequence([asn1OID(oidPBKDF2), asn1Sequence([asn1OctetString(salt), asn1Integer(rounds), asn1Sequence([asn1OID(oidHMACWithSHA256), asn1Null()])])])
		let encryption = asn1Sequence([asn1OID(oidAES256CBC), asn1OctetString(iv)])
		let algorithm = asn1Sequence([asn1OID(oidPBES2), asn1Sequence([kdf, encryption])])
		return asn1Sequence([algorithm, asn1OctetString(encrypted)]).encode()
	}

	internal def prfOf(oid OID) !Hash {
		return Hash.SHA1 when oid.equals(oidHMACWithSHA1)
		return Hash.SHA224 when oid.equals(oidHMACWithSHA224)
		return Hash.SHA256 when oid.equals(oidHMACWithSHA256)
		return Hash.SHA384 when oid.equals(oidHMACWithSHA384)
		return Hash.SHA512 when oid.equals(oidHMACWithSHA512)
		fail "x509: PBKDF2 pseudo-random function {oid.str()} is not supported"
	}

	internal def pbes2KeySize(oid OID) !int {
		return 16 when oid.equals(oidAES128CBC)
		return 24 when oid.equals(oidAES192CBC) || oid.equals(oidDESEDE3CBC)
		return 32 when oid.equals(oidAES256CBC)
		fail "x509: PBES2 cipher {oid.str()} is not supported"
	}

	internal def pbes2Block(oid OID, key byte[]) !Block {
		return try cipher.newTripleDES(key) when oid.equals(oidDESEDE3CBC)
		return try cipher.newAES(key)
	}
}
