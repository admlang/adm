@os("linux", "darwin", "android", "ios", "wasm")
partial module std.crypto {
	internal let randomSourceRegistered = false

	// Fills buf from /dev/urandom, which gives cryptographic randomness on
	// Linux, macOS and the BSDs, and returns the count read. Fails when the
	// file cannot be opened or read.
	internal def readRandom(buf byte[]) !int {
		use (
			std.os
			std.services.policy::(Policy)
		)

		// It is read for the caller's sake, so a policy that asks about file
		// reads does not ask about it.
		if !randomSourceRegistered {
			randomSourceRegistered = true
			Policy.registerResources("adm.storage.read", ["/dev/urandom"]) onerror recover none
		}
		let f = try os.open("/dev/urandom", "r")
		defer f.close()
		return try f.read(buf)
	}
}
