partial module std.crypto {
	use std.testing

	check "rand" {
		// The system's source gives the bytes asked for, and two draws differ.
		@test()
		def givesTheBytesAskedFor() !none {
			let a = try rand(32)
			let b = try rand(32)
			assert a.len() == 32 && b.len() == 32
			assert a.hex() != b.hex()
			let large = try rand(1 << 20)
			assert large.len() == 1 << 20
			return none
		}

		@test()
		def refusesNoLength() {
			let failed = false
			let nothing byte[]
			rand(0) onerror (err error) {
				failed = true
				recover nothing
			}
			assert failed
		}
	}
}
