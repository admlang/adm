partial module std.crypto {
	// Fills buf from the system's preferred random generator
	// (`BCryptGenRandom`) and returns its length. Fails with the status
	// Windows refused it with.
	internal def readRandom(buf byte[]) !int {
		let status = __winRandom(buf, buf.len())
		fail "crypto: Windows gave no random bytes (status {status})" when status != 0
		return buf.len()
	}

	@c(symbol = "adm_win_random", ret = "int32_t", params = ["uint8_t*", "int64_t"])
	internal def __winRandom(buf byte[], n int) int32;
}
