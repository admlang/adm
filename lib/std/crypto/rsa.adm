partial module std.crypto {
	use std.crypto.hash::(Hash, hashSize, digest)

	// RSAPublicKey verifies RSA signatures: PKCS#1 v1.5 and PSS (RFC 8017).
	type RSAPublicKey {
		n bigint
		e int

		def new(n bigint, e int) {
			self.n = n
			self.e = e
		}

		// size is the modulus length in bytes, the length of a signature.
		def size() int {
			return (n.bitLen() + 7) / 8
		}

		// verifyPKCS1v15 checks a PKCS#1 v1.5 signature over a digest made
		// with the given hash.
		def verifyPKCS1v15(hash Hash, digest, signature byte[]) bool {
			let k = size()
			return false when signature.len() != k
			let expected = pkcs1v15Encode(hash, digest, k) onerror recover []
			return false when expected.len() == 0
			let em = encrypt(signature) onerror recover []
			return false when em.len() != k
			return constantTimeEqual(em, expected)
		}

		// verifyPSS checks a PSS signature over a digest made with the given
		// hash and MGF1 over the same hash. saltLength is the salt the signer
		// used; -1 accepts whatever length the encoding holds.
		def verifyPSS(hash Hash, digest, signature byte[], saltLength int = -1) bool {
			let k = size()
			let hLen = hashSize(hash)
			return false when signature.len() != k || digest.len() != hLen
			let em = encrypt(signature) onerror recover []
			return false when em.len() != k
			let emBits = n.bitLen() - 1
			let emLen = (emBits + 7) / 8
			if emLen < k {
				return false when em[0] != 0
				em = em[1:]
			}
			return false when emLen < hLen + 2
			return false when em[emLen - 1] != 0xbc
			let dbLen = emLen - hLen - 1
			let maskedDB = em[0:dbLen]
			let h = em[dbLen:emLen - 1]
			let topBits = 8 * emLen - emBits
			return false when topBits > 0 && (int(maskedDB[0]) >> (8 - topBits)) != 0
			let dbMask = mgf1(hash, h, dbLen)
			let db byte[]
			db.len(dbLen)
			for let i = 0; i < dbLen; i++ {
				db[i] = maskedDB[i] ^ dbMask[i]
			}
			db[0] &= byte(0xff >> topBits) when topBits > 0
			let sLen = saltLength
			if sLen < 0 {
				// The salt starts after the first 0x01.
				let one = -1
				for let i = 0; i < dbLen; i++ {
					if db[i] != 0 {
						one = i
						break
					}
				}
				return false when one < 0 || db[one] != 1
				sLen = dbLen - one - 1
			}
			return false when emLen < hLen + sLen + 2
			let sep = dbLen - sLen - 1
			for let i = 0; i < sep; i++ {
				return false when db[i] != 0
			}
			return false when db[sep] != 1
			let salt = db[sep + 1:]
			let mPrime = byte[0, 0, 0, 0, 0, 0, 0, 0] + digest + salt
			return constantTimeEqual(digest(hash, mPrime), h)
		}

		// encrypt is the raw public operation m^e mod n as size() bytes.
		// Fails when the input is not smaller than the modulus.
		internal def encrypt(m byte[]) !byte[] {
			let value = parseBigInt(m)
			fail "rsa: value out of range" when value >= n
			return try value.modPow(bigint(e), n).bytes(size())
		}
	}

	// RSAPrivateKey is an RSA private key as PKCS#1 carries it: the modulus,
	// both exponents, the primes and the CRT values. It signs with PKCS#1
	// v1.5 and PSS. The private operation uses the CRT with blinding, but the
	// `bigint` arithmetic underneath is not constant time.
	type RSAPrivateKey {
		n    bigint
		e    int
		d    bigint
		p    bigint
		q    bigint
		dp   bigint
		dq   bigint
		qinv bigint

		def new(n bigint, e int, d, p, q, dp, dq, qinv bigint) {
			self.n = n
			self.e = e
			self.d = d
			self.p = p
			self.q = q
			self.dp = dp
			self.dq = dq
			self.qinv = qinv
		}

		// publicKey is the matching public key.
		def publicKey() RSAPublicKey {
			return new RSAPublicKey(n, e)
		}

		// size is the modulus length in bytes, the length of a signature.
		def size() int {
			return (n.bitLen() + 7) / 8
		}

		// signPKCS1v15 signs a digest made with the given hash as PKCS#1 v1.5
		// (RFC 8017 §8.2); the signature is deterministic. Fails when the hash
		// has no DigestInfo, the digest has the wrong length, the key is too
		// small for it, or the random source for blinding is unavailable.
		def signPKCS1v15(hash Hash, digest byte[]) !byte[] {
			let em = try pkcs1v15Encode(hash, digest, size())
			return try decrypt(em)
		}

		// signPSS signs a digest made with the given hash as PSS (RFC 8017
		// §8.1) with MGF1 over the same hash. saltLength is the salt to draw:
		// -1 uses the hash length, the TLS 1.3 and X.509 convention; 0 uses the
		// longest salt the key allows. Fails when the digest has the wrong
		// length, the key is too small for the salt, or the random source is
		// unavailable.
		def signPSS(hash Hash, digest byte[], saltLength int = -1) !byte[] {
			let k = size()
			let hLen = hashSize(hash)
			fail "rsa: digest has the wrong length for {hash}" when digest.len() != hLen
			let emBits = n.bitLen() - 1
			let emLen = (emBits + 7) / 8
			let sLen = saltLength
			sLen = hLen when sLen < 0
			sLen = emLen - hLen - 2 when sLen == 0
			fail "rsa: key too small for a {sLen}-byte salt" when emLen < hLen + sLen + 2
			let salt byte[]
			salt = try rand(sLen) when sLen > 0
			let mPrime = byte[0, 0, 0, 0, 0, 0, 0, 0] + digest + salt
			let h = digest(hash, mPrime)
			let dbLen = emLen - hLen - 1
			let db byte[]
			db.len(dbLen - sLen - 1)
			db = db + byte[1] + salt
			let dbMask = mgf1(hash, h, dbLen)
			let em byte[]
			em.len(dbLen)
			for let i = 0; i < dbLen; i++ {
				em[i] = db[i] ^ dbMask[i]
			}
			let topBits = 8 * emLen - emBits
			em[0] &= byte(0xff >> topBits) when topBits > 0
			em = em + h + byte[0xbc]
			em = byte[0] + em when emLen < k
			return try decrypt(em)
		}

		// decrypt is the raw private operation c^d mod n as size() bytes,
		// through the CRT when the key carries its primes. The input is
		// blinded with a random factor so the operation's timing does not
		// follow it, and the result is checked against the public operation
		// so a fault cannot leak the key. Fails when the input is not smaller
		// than the modulus or the random source is unavailable.
		internal def decrypt(c byte[]) !byte[] {
			let value = parseBigInt(c)
			fail "rsa: value out of range" when value >= n
			let k = size()
			let r = bigint(1)
			let rInv = bigint(1)
			for {
				r = parseBigInt(try rand(k + 8)).mod(n - 1) + 1
				let inv = r.modInverse(n)
				continue when inv is none
				rInv = inv
				break
			}
			let blinded = (value * r.modPow(bigint(e), n)).mod(n)
			let m bigint
			if p.isZero() || q.isZero() {
				m = blinded.modPow(d, n)
			} else {
				let m1 = blinded.modPow(dp, p)
				let m2 = blinded.modPow(dq, q)
				let h = (qinv * (m1 - m2)).mod(p)
				m = m2 + h * q
			}
			m = (m * rInv).mod(n)
			fail "rsa: private operation failed its check" unless m.modPow(bigint(e), n) == value
			return try m.bytes(k)
		}
	}

	// pkcs1v15Encode is EMSA-PKCS1-v1_5 (RFC 8017 §9.2): 0x00 0x01, at
	// least eight 0xff bytes, 0x00, then the DigestInfo of the hash over the
	// digest, padded to k bytes. Fails when the hash has no DigestInfo, the
	// digest has the wrong length, or k is too small.
	internal def pkcs1v15Encode(hash Hash, digest byte[], k int) !byte[] {
		let prefix = pkcs1DigestInfo(hash)
		fail "rsa: no PKCS#1 DigestInfo for {hash}" when prefix.len() == 0
		fail "rsa: digest has the wrong length for {hash}" when digest.len() != hashSize(hash)
		let tLen = prefix.len() + digest.len()
		fail "rsa: key too small for {hash}" when k < tLen + 11
		let em = byte[0, 1]
		for let i = 0; i < k - tLen - 3; i++ {
			em.push(0xff)
		}
		em.push(0)
		return em + prefix + digest
	}

	// mgf1 is the mask generation function of RFC 8017 B.2.1.
	internal def mgf1(hash Hash, seed byte[], length int) byte[] {
		let out byte[]
		let counter uint32 = 0
		for out.len() < length {
			let c = byte[
				byte(counter >> 24), byte((counter >> 16) & 0xff), byte((counter >> 8) & 0xff), byte(counter & 0xff)
			]
			out = out + digest(hash, seed + c)
			counter++
		}
		return out[0:length]
	}

	// pkcs1DigestInfo is the DER prefix of the DigestInfo for each hash:
	// the AlgorithmIdentifier and the OCTET STRING header before the digest.
	internal def pkcs1DigestInfo(hash Hash) byte[] {
		match hash {
			case Hash.MD5:
				return byte[0x30, 0x20, 0x30, 0x0c, 0x06, 0x08, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x02, 0x05, 0x05, 0x00, 0x04, 0x10]
			case Hash.SHA1:
				return byte[0x30, 0x21, 0x30, 0x09, 0x06, 0x05, 0x2b, 0x0e, 0x03, 0x02, 0x1a, 0x05, 0x00, 0x04, 0x14]
			case Hash.SHA224:
				return byte[0x30, 0x2d, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x04, 0x05, 0x00, 0x04, 0x1c]
			case Hash.SHA256:
				return byte[0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20]
			case Hash.SHA384:
				return byte[0x30, 0x41, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30]
			case Hash.SHA512:
				return byte[0x30, 0x51, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40]
			case Hash.SHA3_224:
				return byte[0x30, 0x2d, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x07, 0x05, 0x00, 0x04, 0x1c]
			case Hash.SHA3_256:
				return byte[0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x08, 0x05, 0x00, 0x04, 0x20]
			case Hash.SHA3_384:
				return byte[0x30, 0x41, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x09, 0x05, 0x00, 0x04, 0x30]
			case Hash.SHA3_512:
				return byte[0x30, 0x51, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x0a, 0x05, 0x00, 0x04, 0x40]
			default:
				// No PKCS#1 DigestInfo is defined for the other digests.
				return []
		}
	}
}
