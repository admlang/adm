partial module std.crypto {
	// generateRSAKey draws a new RSA key with a modulus of exactly `bits`
	// bits. The primes pass Miller-Rabin after trial division, leave the
	// exponent invertible, and lie far enough apart (FIPS 186-5 A.1.3).
	// Fails when `bits` is under 1024 or odd, when the exponent is even or
	// under 3, and when the random source is unavailable.
	def generateRSAKey(bits int = 2048, exponent int = 65537) !RSAPrivateKey {
		expects {
			assert bits >= 1024 onerror fail "rsa: key size must be at least 1024 bits"
			assert bits % 2 == 0 onerror fail "rsa: key size must be a multiple of 2"
			assert exponent >= 3 onerror fail "rsa: exponent must be at least 3"
			assert exponent % 2 != 0 onerror fail "rsa: exponent must be odd"
		}
		let e = bigint(exponent)
		let primeBits = bits / 2
		let rounds = millerRabinRounds(primeBits)
		let minDiffBits = primeBits - 100
		let p = try generateRSAPrime(primeBits, rounds, e)
		let q bigint
		for {
			q = try generateRSAPrime(primeBits, rounds, e)
			continue when q == p
			continue when (p - q).abs().bitLen() <= minDiffBits
			break
		}
		let n = p * q
		let p1 = p - 1
		let q1 = q - 1
		let lambda = (p1 * q1) / p1.gcd(q1)
		let d = e.modInverse(lambda)
		fail "rsa: exponent has no inverse for the generated primes" when d is none
		let qinv = q.modInverse(p)
		fail "rsa: primes are not coprime" when qinv is none
		return new RSAPrivateKey(n, exponent, d, p, q, d.mod(p1), d.mod(q1), qinv)
	}

	// generateRSAPrime draws candidates of exactly `bits` bits, odd and
	// with the top two bits set, until one is a probable prime that leaves
	// the exponent invertible.
	// Fails when the random source is unavailable.
	internal def generateRSAPrime(bits int, rounds int, e bigint) !bigint {
		let byteLen = (bits + 7) / 8
		let excess = byteLen * 8 - bits
		for {
			let b = try rand(byteLen)
			b[0] &= byte(0xff >> excess) when excess > 0
			b[0] |= byte(0xc0 >> excess)
			b[byteLen - 1] |= 1
			let candidate = parseBigInt(b)
			continue when !candidate.isProbablePrime(rounds)
			continue when e.gcd(candidate - 1) != 1
			return candidate
		}
		fail "rsa: unreachable"
	}

	// millerRabinRounds is how many rounds a probable prime of the length
	// takes (FIPS 186-4 table C.2).
	internal def millerRabinRounds(primeBits int) int {
		return 7 when primeBits < 1024
		return 5 when primeBits < 1536
		return 4
	}
}
