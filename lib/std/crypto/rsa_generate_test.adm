partial module std.crypto {
	use (
		std.testing
		std.crypto.hash::(Hash)
		std.data.encoding::(hexdecode)
	)

	// zeroRSAPrivateKey is the fallback for onerror recover in the
	// validation tests below; its zero exponent marks a failed generation.
	internal def zeroRSAPrivateKey() RSAPrivateKey {
		return new RSAPrivateKey(bigint(0), 0, bigint(0), bigint(0), bigint(0), bigint(0), bigint(0), bigint(0))
	}

	check "RSA Key Generation" {
		@test()
		def TestPrimeCandidates() {
			// Carmichael numbers pass Fermat tests to every base coprime to
			// them, so a real Miller-Rabin implementation must still reject
			// them.
			assert !bigint(561).isProbablePrime()
			assert !bigint(41041).isProbablePrime()
			assert !bigint(825265).isProbablePrime()
			let mersenne = (bigint(1) << 127) - 1
			assert mersenne.isProbablePrime()
			// 127 is odd, so 3 divides 2^127+1, a large composite the same
			// size as the Mersenne prime above.
			assert !((bigint(1) << 127) + 1).isProbablePrime()
		}

		@test()
		def TestGenerateRSAKeyValidation() {
			let zero = zeroRSAPrivateKey()
			let tooSmall = generateRSAKey(512) onerror recover zero
			assert tooSmall.e == 0
			let oddBits = generateRSAKey(1025) onerror recover zero
			assert oddBits.e == 0
			let evenExponent = generateRSAKey(1024, 4) onerror recover zero
			assert evenExponent.e == 0
			let smallExponent = generateRSAKey(1024, 1) onerror recover zero
			assert smallExponent.e == 0
		}

		@test()
		def TestGenerateRSAKey1024() !none {
			let key = try generateRSAKey(1024)
			assert key.n.bitLen() == 1024
			assert key.e == 65537
			assert key.p != key.q
			assert key.p.isProbablePrime()
			assert key.q.isProbablePrime()
			let public = key.publicKey()
			let digest = try hexdecode("AF2BDBE1AA9B6EC1E2ADE1D694F41FC71A831D0268E9891562113D8A62ADD1BF")
			let sig1 = try key.signPKCS1v15(Hash.SHA256, digest)
			assert public.verifyPKCS1v15(Hash.SHA256, digest, sig1)
			let sig2 = try key.signPSS(Hash.SHA256, digest)
			assert public.verifyPSS(Hash.SHA256, digest, sig2)
			return none
		}

		@test()
		def TestGenerateRSAKey2048() !none {
			let key = try generateRSAKey(2048, 65537)
			assert key.n.bitLen() == 2048
			assert key.e == 65537
			let public = key.publicKey()
			let digest = try hexdecode("AF2BDBE1AA9B6EC1E2ADE1D694F41FC71A831D0268E9891562113D8A62ADD1BF")
			let sig1 = try key.signPKCS1v15(Hash.SHA256, digest)
			assert public.verifyPKCS1v15(Hash.SHA256, digest, sig1)
			let sig2 = try key.signPSS(Hash.SHA256, digest)
			assert public.verifyPSS(Hash.SHA256, digest, sig2)
			return none
		}
	}
}
