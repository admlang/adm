partial module std.crypto {
	use (
		std.testing
		std.crypto.hash::(Hash)
		std.data.encoding::(hexdecode)
	)

	// A 2048-bit OpenSSL key; both signatures are over SHA-256("sample").
	internal def rsaTestKey() RSAPublicKey {
		let n = parseBigInt("", 16) onerror recover bigint(0)
		return new RSAPublicKey(n, 65537)
	}

	check "RSA" {
		@test()
		def TestRSAVerifyPKCS1v15() !none {
			let key = rsaTestKey()
			assert key.size() == 256
			let digest = try hexdecode("AF2BDBE1AA9B6EC1E2ADE1D694F41FC71A831D0268E9891562113D8A62ADD1BF")
			let sig = try hexdecode("")
			assert key.verifyPKCS1v15(Hash.SHA256, digest, sig)
			assert !key.verifyPKCS1v15(Hash.SHA384, digest, sig)
			assert !key.verifyPKCS1v15(Hash.SHA256, digest, sig[1:])
			sig[100] ^= 1
			assert !key.verifyPKCS1v15(Hash.SHA256, digest, sig)
		}

		@test()
		def TestRSAVerifyPSS() !none {
			let key = rsaTestKey()
			let digest = try hexdecode("AF2BDBE1AA9B6EC1E2ADE1D694F41FC71A831D0268E9891562113D8A62ADD1BF")
			let sig = try hexdecode("")
			assert key.verifyPSS(Hash.SHA256, digest, sig, 32)
			assert key.verifyPSS(Hash.SHA256, digest, sig)
			assert !key.verifyPSS(Hash.SHA256, digest, sig, 20)
			digest[5] ^= 1
			assert !key.verifyPSS(Hash.SHA256, digest, sig)
		}

		@test()
		def TestRSASignPKCS1v15() !none {
			let key = try parsePKCS1PrivateKey(der(rsaPrivatePKCS1PEM))
			let digest = try hexdecode("AF2BDBE1AA9B6EC1E2ADE1D694F41FC71A831D0268E9891562113D8A62ADD1BF")
			let sig = try key.signPKCS1v15(Hash.SHA256, digest)
			// OpenSSL's signature with the same key over SHA-256("sample").
			assert sig.hex() == ""
			assert key.publicKey().verifyPKCS1v15(Hash.SHA256, digest, sig)
			assert !key.publicKey().verifyPKCS1v15(Hash.SHA256, digest[1:] + byte[0], sig)
			let short = key.signPKCS1v15(Hash.SHA256, digest[1:]) onerror recover []
			assert short.len() == 0
			let noInfo = key.signPKCS1v15(Hash.BLAKE2b512, digest) onerror recover []
			assert noInfo.len() == 0
			// A key without CRT values takes the plain exponent path.
			let plain = new RSAPrivateKey(key.n, key.e, key.d, bigint(0), bigint(0), bigint(0), bigint(0), bigint(0))
			assert (try plain.signPKCS1v15(Hash.SHA256, digest)).hex() == sig.hex()
		}

		@test()
		def TestRSASignPSS() !none {
			let key = try parsePKCS1PrivateKey(der(rsaPrivatePKCS1PEM))
			let public = key.publicKey()
			let digest = try hexdecode("AF2BDBE1AA9B6EC1E2ADE1D694F41FC71A831D0268E9891562113D8A62ADD1BF")
			let sig = try key.signPSS(Hash.SHA256, digest)
			assert sig.len() == 256
			assert public.verifyPSS(Hash.SHA256, digest, sig, 32)
			assert public.verifyPSS(Hash.SHA256, digest, sig)
			assert !public.verifyPSS(Hash.SHA256, digest, sig, 20)
			assert !public.verifyPSS(Hash.SHA384, digest + digest[0:16], sig)
			// Two signatures differ by their salt but both verify.
			let again = try key.signPSS(Hash.SHA256, digest)
			assert again.hex() != sig.hex()
			assert public.verifyPSS(Hash.SHA256, digest, again, 32)
			// The longest salt, and no salt at all.
			let longest = try key.signPSS(Hash.SHA256, digest, 0)
			assert public.verifyPSS(Hash.SHA256, digest, longest, 256 - 32 - 2)
			let dry = try key.signPSS(Hash.SHA384, try hexdecode("9A9083505BC92276AEC4BE312696EF7BF3BF603F4BBD381196A029F340585312313BCA4A9B5B890EFEE42C77B1EE25FE"), 48)
			assert public.verifyPSS(Hash.SHA384, try hexdecode("9A9083505BC92276AEC4BE312696EF7BF3BF603F4BBD381196A029F340585312313BCA4A9B5B890EFEE42C77B1EE25FE"), dry, 48)
			let wrongLength = key.signPSS(Hash.SHA256, digest[1:]) onerror recover []
			assert wrongLength.len() == 0
			let tooLong = key.signPSS(Hash.SHA256, digest, 300) onerror recover []
			assert tooLong.len() == 0
		}

		@test()
		def TestRSADecryptOpenSSL() !none {
			// OpenSSL's ciphertexts of "hello oaep" under this key.
			let key = try parsePKCS1PrivateKey(der(rsaPrivatePKCS1PEM))
			let sha1 = try hexdecode("")
			assert string(try key.decrypt(sha1, RSAPadding.OAEP, Hash.SHA1)) == "hello oaep"
			let labelled = try hexdecode("")
			assert string(try key.decrypt(labelled, label = "label".bytes())) == "hello oaep"
			let v15 = try hexdecode("")
			assert string(try key.decrypt(v15, RSAPadding.PKCS1v15)) == "hello oaep"
			// SHA-256 digest with MGF1-SHA1, as XML-Enc 1.0 rsa-oaep-mgf1p writes it.
			let mixed = try hexdecode("")
			assert string(try key.decrypt(mixed, hash = Hash.SHA256, mgfHash = Hash.SHA1)) == "hello oaep"
			assert key.decrypt(mixed, hash = Hash.SHA256) is error
			// The wrong label, hash or padding, a flipped bit and a short input all fail alike.
			let failures = [
				key.decrypt(labelled) onerror recover [],
				key.decrypt(sha1) onerror recover [],
				key.decrypt(v15) onerror recover [],
				key.decrypt(sha1, RSAPadding.PKCS1v15) onerror recover [],
				key.decrypt(labelled[1:], label = "label".bytes()) onerror recover []
			]
			for let f in failures {
				assert f.len() == 0
			}
			labelled[200] ^= 1
			let flipped = key.decrypt(labelled, label = "label".bytes()) onerror recover []
			assert flipped.len() == 0
		}

		@test()
		def TestRSAEncryptRoundTrip() !none {
			let key = try parsePKCS1PrivateKey(der(rsaPrivatePKCS1PEM))
			let public = key.publicKey()
			let message = "attack at dawn".bytes()
			let a = try public.encrypt(message)
			let b = try public.encrypt(message)
			assert a.len() == 256 && a.hex() != b.hex()
			assert string(try key.decrypt(a)) == "attack at dawn"
			let sha512 = try public.encrypt(message, RSAPadding.OAEP, Hash.SHA512, "ctx".bytes())
			assert string(try key.decrypt(sha512, RSAPadding.OAEP, Hash.SHA512, "ctx".bytes())) == "attack at dawn"
			let split = try public.encrypt(message, hash = Hash.SHA384, mgfHash = Hash.SHA1)
			assert string(try key.decrypt(split, hash = Hash.SHA384, mgfHash = Hash.SHA1)) == "attack at dawn"
			let v15 = try public.encrypt(message, RSAPadding.PKCS1v15)
			assert string(try key.decrypt(v15, RSAPadding.PKCS1v15)) == "attack at dawn"
			// Empty messages, and the longest each padding allows.
			assert (try key.decrypt(try public.encrypt([]))).len() == 0
			let longest byte[]
			longest.len(256 - 2 * 32 - 2)
			longest[0] = 7
			assert (try key.decrypt(try public.encrypt(longest))).hex() == longest.hex()
			let over = public.encrypt(longest + byte[1]) onerror recover []
			assert over.len() == 0
			let v15Longest byte[]
			v15Longest.len(256 - 11)
			assert (try key.decrypt(try public.encrypt(v15Longest, RSAPadding.PKCS1v15), RSAPadding.PKCS1v15)).len() == 245
			let v15Over = public.encrypt(v15Longest + byte[0], RSAPadding.PKCS1v15) onerror recover []
			assert v15Over.len() == 0
		}
	}
}
