partial module std.crypto {
	// constantTimeEqual reports whether the two byte strings are equal, taking
	// time that depends only on their lengths, so a comparison of secrets
	// (authentication tags, password digests) leaks nothing through timing.
	// Different lengths compare unequal.
	def constantTimeEqual(a, b byte[]) bool {
		return false when a.len() != b.len()
		let acc byte = 0
		for let i = 0; i < a.len(); i++ {
			acc |= a[i] ^ b[i]
		}
		return acc == 0
	}

	// constantTimeSelect returns x when choice is 1 and y when it is 0,
	// without branching on the choice.
	def constantTimeSelect(choice int, x, y uint64) uint64 {
		let mask = uint64(0) - uint64(choice & 1)
		return (x & mask) | (y & (mask ^ 0xFFFFFFFFFFFFFFFF))
	}
}
