partial module std.crypto {
	use std.testing

	check "Subtle" {
		@test()
		def TestConstantTimeEqual() {
			assert constantTimeEqual([], [])
			assert constantTimeEqual(byte[1, 2, 3], byte[1, 2, 3])
			assert !constantTimeEqual(byte[1, 2, 3], byte[1, 2, 4])
			assert !constantTimeEqual(byte[1, 2, 3], byte[1, 2])
			assert constantTimeSelect(1, 7, 9) == 7
			assert constantTimeSelect(0, 7, 9) == 9
		}
	}
}
