partial module std.crypto {
	use std.time

	// The Crockford base32 alphabet a ULID is written in: digits and upper-case
	// letters without I, L, O and U.
	internal const ulidAlphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"

	// The millisecond the last ULID was made in and its 80 random bits: a ULID
	// made in the same millisecond takes those bits plus one, so identifiers
	// made in one millisecond sort in the order they were made.
	internal let ulidLastMs int64 = -1
	internal let ulidLastRandom byte[]

	// ULID is a 128-bit identifier that sorts by the time it was made: 48 bits
	// of Unix milliseconds followed by 80 random bits, written as 26 characters
	// of Crockford base32 (github.com/ulid/spec). Identifiers made later sort
	// after those made earlier, as text and as bytes; those made in the same
	// millisecond by this program sort in the order they were made. Two
	// identifiers of the same bytes are equal, and a ULID is a map key.
	@portable
	type ULID {
		internal ulid byte[]

		// A new identifier for the current time, after every one this program
		// made before it. Fails an assertion on a system without a random
		// source.
		def new() {
			ulid = ulidNext()
		}

		// A new identifier for the millisecond of `at`, with 80 fresh random
		// bits: no ordering among identifiers made for the same millisecond.
		// A time before 1970 or after the year 10889 fails an assertion.
		def new(at time.Time) {
			let ms = at.unixNs() / 1000000
			assert ms >= 0 && ms < (int64(1) << 48)
			ulid = ulidStamp(ms, uuidRandom(10))
		}

		// fromBytes sets the identifier from its 16 bytes. Fails when the length
		// is not 16.
		def fromBytes(b byte[]) !none {
			expects {
				assert b.len() == 16 onerror fail "invalid ULID length"
			}
			ulid = b[:]
			return none
		}

		// fromString sets the identifier from its 26 characters and returns it.
		// Letters may be in either case. Fails when the text holds another
		// character, has another length, or starts above `7` (a value past 128
		// bits).
		def fromString(s string) !ULID {
			let text = s.bytes()
			assert text.len() == 26 onerror fail "invalid ULID length"
			let out = byte[]
			out.len(16)
			let acc uint32 = 0
			let bits = 0
			let at = 0
			for let i = 0; i < 26; i++ {
				let digit = ulidDigit(text[i])
				assert digit >= 0 onerror fail "invalid ULID character"
				if i == 0 {
					// The first character carries 3 bits: 26 × 5 = 130.
					assert digit < 8 onerror fail "ULID out of range"
					acc = uint32(digit)
					bits = 3
					continue
				}
				acc = (acc << 5) | uint32(digit)
				bits += 5
				if bits >= 8 {
					bits -= 8
					out[at] = byte((acc >> bits) & 0xFF)
					at++
				}
			}
			ulid = out
			return self
		}

		// The 16 bytes of the identifier, a copy.
		def bytes() byte[] {
			return ulid[:]
		}

		// The millisecond the identifier was made in.
		def timestamp() time.Time {
			let ms int64 = 0
			for let i = 0; i < 6; i++ {
				ms = (ms << 8) | int64(ulid[i])
			}
			return time.fromUnixNs(ms * 1000000)
		}

		// The same 128 bits as a UUID, for a column or an API that stores UUIDs.
		// The bits are kept as they are, so the UUID carries no RFC 9562 version.
		def uuid() UUID {
			let out = new UUID()
			out.uuid = ulid[:]
			return out
		}

		// Whether the two identifiers hold the same bytes.
		def equals(other ULID) bool {
			return ulid.equals(other.ulid)
		}

		// -1 when this identifier sorts before other, 1 when after, 0 when equal:
		// the order of the bytes, which is the order of the text and of time.
		def compare(other ULID) int {
			return orderOfBytes(ulid, other.ulid)
		}

		// The hash a map keys the identifier by: its two 64-bit halves folded.
		def hash() uint64 {
			return foldHalves(ulid)
		}

		// str renders the identifier as 26 upper-case Crockford base32 characters.
		def str() string {
			let out = byte[]
			out.len(26)
			let acc uint32 = 0
			let bits = 0
			let at = 25
			for let i = 15; i >= 0; i-- {
				acc = acc | (uint32(ulid[i]) << bits)
				bits += 8
				while bits >= 5 {
					out[at] = ulidAlphabet.bytes()[int(acc & 31)]
					at--
					acc = acc >> 5
					bits -= 5
				}
			}
			out[0] = ulidAlphabet.bytes()[int(acc & 31)]
			return string(out)
		}
	}

	// The next identifier for the current time: a later millisecond takes fresh
	// random bits; the same one (or a clock that went back) takes the last
	// random bits plus one, and an overflow of those moves to the next
	// millisecond.
	internal def ulidNext() byte[] {
		let now = time.wallNs() / 1000000
		if now > ulidLastMs {
			ulidLastMs = now
			ulidLastRandom = uuidRandom(10)
		} else {
			let carried = true
			for let i = 9; i >= 0 && carried; i-- {
				ulidLastRandom[i] = ulidLastRandom[i] + 1
				carried = ulidLastRandom[i] == 0
			}
			if carried {
				ulidLastMs++
				ulidLastRandom = uuidRandom(10)
			}
		}
		return ulidStamp(ulidLastMs, ulidLastRandom)
	}

	// The 16 bytes of a millisecond and 10 random bytes.
	internal def ulidStamp(ms int64, random byte[]) byte[] {
		let out = byte[]
		out.len(16)
		for let i = 0; i < 6; i++ {
			out[i] = byte((ms >> ((5 - i) * 8)) & 0xFF)
		}
		random.copy(out[6:])
		return out
	}

	// The value of a Crockford base32 character in either case; -1 for any
	// other character.
	internal def ulidDigit(c byte) int {
		let upper = c >= 'a' && c <= 'z' ?? (c - 32, c)
		let at = ulidAlphabet.bytes().indexOf(upper)
		return at
	}

	// -1, 0 or 1 as a sorts before, with or after b, byte by byte; the shorter
	// sorts first when one is a prefix of the other.
	internal def orderOfBytes(a byte[], b byte[]) int {
		let n = a.len() < b.len() ?? (a.len(), b.len())
		for let i = 0; i < n; i++ {
			return -1 when a[i] < b[i]
			return 1 when a[i] > b[i]
		}
		return a.len().compare(b.len())
	}

	// The 8-byte big-endian words of an identifier folded together with xor:
	// a map's hash of a fixed-length identifier.
	internal def foldHalves(id byte[]) uint64 {
		let out uint64 = 0
		let word uint64 = 0
		for let i = 0; i < id.len(); i++ {
			word = (word << 8) | uint64(id[i])
			if i % 8 == 7 || i == id.len() - 1 {
				out = out ^ word
				word = 0
			}
		}
		return out
	}

	// parseULID returns the ULID of 26 Crockford base32 characters. Fails when
	// the text is not a ULID.
	def parseULID(text string) !ULID {
		let id = new ULID()
		try id.fromString(text)
		return id
	}

	// parseULID returns the ULID of 16 bytes. Fails when the length is not 16.
	def parseULID(b byte[]) !ULID {
		let id = new ULID()
		try id.fromBytes(b)
		return id
	}
}
