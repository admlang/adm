partial module std.crypto {
	// UUID is a 128-bit universally unique identifier: random (version 4) when
	// made with new, parsed from text or bytes, rendered in the canonical
	// hyphenated form.
	type UUID {
		internal uuid byte[]

		def new() {
			generateV4()
		}

		internal def generateV4() {
			let buf = rand(16) onerror {
				let tmp = byte[]
				tmp.len(16)
				tmp[:] = 0
				recover tmp
			}

			uuid = buf
			uuid[6] = (uuid[6] & 0x0F) | 0x40 // Version 4
			uuid[8] = (uuid[8] & 0x3F) | 0x80 // Variant 10
		}

		// fromBytes sets the identifier from its 16 bytes. Fails when the length is
		// not 16.
		def fromBytes(b byte[]) !none {
			expects {
				assert b.len() == 16 onerror fail "invalid UUID length"
			}
			uuid = b
			return none
		}

		// fromString sets the identifier from its text form, with or without braces
		// or hyphens, and returns it. Fails when the text is not 32 hexadecimal
		// digits.
		def fromString(s string) !UUID {
			let input = s.trim()
			if input.startsWith("\{") && input.endsWith("\}") {
				input = input[1:-1]
			}

			let parts = input.split("-")
			assert parts.len() == 5 onerror fail "invalid UUID format"
			assert parts[0].len() == 8 onerror fail "invalid UUID format"
			assert parts[1].len() == 4 onerror fail "invalid UUID format"
			assert parts[2].len() == 4 onerror fail "invalid UUID format"
			assert parts[3].len() == 4 onerror fail "invalid UUID format"
			assert parts[4].len() == 12 onerror fail "invalid UUID format"

			let hex = parts.join("")
			assert hex.len() == 32 onerror fail "invalid UUID format"

			let out = byte[]
			out.len(16)
			for let i = 0; i < 16; i++ {
				let pair = hex[i * 2:i * 2 + 2]
				out[i] = parseInt<byte>(pair, 16)
			}

			uuid = out
			return self
		}

		// str renders the identifier in the canonical lower-case hyphenated form.
		def str() string {
			let u = uuid
			let text = "{u[:4].hex()}-{u[4:6].hex()}-{u[6:8].hex()}-{u[8:10].hex()}-{u[10:].hex()}"
			return text.lower()
		}
	}

	// parseUUID returns a new UUID parsed from text. Fails when the text is not a
	// UUID.
	def parseUUID(val string) !UUID {
		let uuid = new UUID()
		try uuid.fromString(val)
		return uuid
	}

	// parseUUID returns a new UUID from its 16 bytes. Fails when the length is
	// not 16.
	def parseUUID(val byte[]) !UUID {
		let uuid = new UUID()
		try uuid.fromBytes(val)
		return uuid
	}

	check "UUID" {
		use std.testing

		@benchmark()
		def newUUID() {
			let uuid = new UUID()
			//println("{uuid}")
		}
	}
}
