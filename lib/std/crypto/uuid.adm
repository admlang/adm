partial module std.crypto {
	use (
		std.crypto.hash::(MD5, SHA1)
		std.time
	)

	// The versions of RFC 9562 a UUID is made as. The value is the version
	// number the identifier carries in its 7th byte.
	enum UUIDVersion {
		// Name-based, MD5 of a namespace and a name: the same input gives the
		// same identifier. For compatibility with what already uses it; new
		// name-based identifiers are V5.
		V3 = 3,
		// Random: 122 random bits.
		V4 = 4,
		// Name-based, SHA-1 of a namespace and a name: the same input gives
		// the same identifier.
		V5 = 5,
		// Time-ordered: the Unix time in milliseconds first, so identifiers
		// made later sort after those made earlier (as text and as bytes),
		// then random bits. The choice for database keys.
		V7 = 7,
	}

	// The namespace RFC 9562 defines for a name-based identifier of a fully
	// qualified domain name.
	const uuidNamespaceDNS = uuidOfHex("6ba7b8109dad11d180b400c04fd430c8")
	// The namespace RFC 9562 defines for a name-based identifier of a URL.
	const uuidNamespaceURL = uuidOfHex("6ba7b8119dad11d180b400c04fd430c8")
	// The namespace RFC 9562 defines for a name-based identifier of an ISO OID.
	const uuidNamespaceOID = uuidOfHex("6ba7b8129dad11d180b400c04fd430c8")
	// The namespace RFC 9562 defines for a name-based identifier of an X.500
	// distinguished name.
	const uuidNamespaceX500 = uuidOfHex("6ba7b8149dad11d180b400c04fd430c8")

	// The millisecond the last V7 identifier was made in, and how many were
	// made in it: the 12 bits after the timestamp count up within a
	// millisecond, so identifiers made in one sort in the order they were made.
	internal let uuidV7LastMs int64 = 0
	internal let uuidV7Count int = 0

	// UUID is a 128-bit universally unique identifier (RFC 9562): made random
	// (V4) or time-ordered (V7) with `new UUID(version)`, from a namespace and a
	// name (V5, V3) with `new UUID(namespace, name)`, parsed from text or bytes
	// with `parseUUID`, and rendered in the canonical hyphenated form by `str`.
	// Two identifiers of the same bytes are equal, and a UUID is a map key.
	@portable
	type UUID {
		internal uuid byte[]

		// A new identifier: random (`V4`) or time-ordered (`V7`). `V3` and
		// `V5` need a namespace and a name, so asking for one here fails an
		// assertion; so does a system without a random source.
		def new(version UUIDVersion = UUIDVersion.V4) {
			let generated = version == UUIDVersion.V4 || version == UUIDVersion.V7
			assert generated
			if version == UUIDVersion.V7 {
				generateV7()
			} else {
				generateV4()
			}
		}

		// A name-based identifier: the hash of the namespace's bytes followed
		// by the name's UTF-8 bytes, SHA-1 for `V5` and MD5 for `V3`. The same
		// namespace and name give the same identifier every time, on every
		// machine. Any other version fails an assertion.
		def new(namespace UUID, name string, version UUIDVersion = UUIDVersion.V5) {
			let named = version == UUIDVersion.V5 || version == UUIDVersion.V3
			assert named
			let input = namespace.uuid + name.bytes()
			let digest = version == UUIDVersion.V5 ?? (new SHA1().hash(input), new MD5().hash(input))
			uuid = digest[:16]
			stamp(version)
		}

		internal def generateV4() {
			uuid = uuidRandom(16)
			stamp(UUIDVersion.V4)
		}

		// RFC 9562 §5.7: 48 bits of Unix milliseconds, the version, 12 bits
		// that count the identifiers made in the same millisecond, the
		// variant, and 62 random bits. A clock that went back keeps counting
		// in the last millisecond seen, so the order of making holds.
		internal def generateV7() {
			let now = time.wallNs() / 1000000
			if now > uuidV7LastMs {
				uuidV7LastMs = now
				uuidV7Count = 0
			} else {
				uuidV7Count++
				if uuidV7Count > 0xFFF {
					uuidV7LastMs++
					uuidV7Count = 0
				}
			}
			let ms = uuidV7LastMs
			let count = uuidV7Count
			let buf = uuidRandom(16)
			buf[0] = byte((ms >> 40) & 0xFF)
			buf[1] = byte((ms >> 32) & 0xFF)
			buf[2] = byte((ms >> 24) & 0xFF)
			buf[3] = byte((ms >> 16) & 0xFF)
			buf[4] = byte((ms >> 8) & 0xFF)
			buf[5] = byte(ms & 0xFF)
			buf[6] = byte((count >> 8) & 0x0F)
			buf[7] = byte(count & 0xFF)
			uuid = buf
			stamp(UUIDVersion.V7)
		}

		// Writes the version into the high nibble of byte 6 and the RFC
		// variant (binary 10) into the high bits of byte 8.
		internal def stamp(version UUIDVersion) {
			uuid[6] = (uuid[6] & 0x0F) | byte(version.value << 4)
			uuid[8] = (uuid[8] & 0x3F) | 0x80
		}

		// fromBytes sets the identifier from its 16 bytes. Fails when the length is
		// not 16.
		def fromBytes(b byte[]) !none {
			expects {
				assert b.len() == 16 onerror fail "invalid UUID length"
			}
			uuid = b[:]
			return none
		}

		// fromString sets the identifier from its text form and returns it: 32
		// hexadecimal digits, in either case, hyphenated as 8-4-4-4-12 or not,
		// with or without braces or the `urn:uuid:` prefix. Fails when the text
		// is anything else.
		def fromString(s string) !UUID {
			let input = s.trim()
			input = input[9:] when input.lower().startsWith("urn:uuid:")
			input = input[1:-1] when input.startsWith("\{") && input.endsWith("\}")
			let hex = input
			if input.len() == 36 {
				assert input[8] == '-' && input[13] == '-' && input[18] == '-' && input[23] == '-' onerror fail "invalid UUID format"
				hex = input[:8] + input[9:13] + input[14:18] + input[19:23] + input[24:]
			}
			let parsed = uuidBytesOfHex(hex)
			assert parsed.len() == 16 onerror fail "invalid UUID format"
			uuid = parsed
			return self
		}

		// The 16 bytes of the identifier, a copy.
		def bytes() byte[] {
			return uuid[:]
		}

		// The version carried in the identifier: 1 to 8 for one made by this
		// type or parsed from a conforming one; whatever the high nibble of
		// byte 6 holds otherwise.
		def version() int {
			return int(uuid[6] >> 4)
		}

		// Whether every bit is zero: the nil UUID.
		def isNil() bool {
			for let b in uuid {
				return false when b != 0
			}
			return true
		}

		// The millisecond a time-ordered (V7) identifier was made in; none for
		// any other version.
		def timestamp() ?time.Time {
			return none when version() != 7
			let ms int64 = 0
			for let i = 0; i < 6; i++ {
				ms = (ms << 8) | int64(uuid[i])
			}
			return time.fromUnixNs(ms * 1000000)
		}

		// Whether the two identifiers hold the same bytes.
		def equals(other UUID) bool {
			return uuid.equals(other.uuid)
		}

		// The hash a map keys the identifier by: its two 64-bit halves folded.
		def hash() uint64 {
			let out uint64 = 0
			for let i = 0; i < 8; i++ {
				out = (out << 8) | uint64(uuid[i])
			}
			let low uint64 = 0
			for let i = 8; i < 16; i++ {
				low = (low << 8) | uint64(uuid[i])
			}
			return out ^ low
		}

		// str renders the identifier in the canonical lower-case hyphenated form.
		def str() string {
			let u = uuid
			let text = "{u[:4].hex()}-{u[4:6].hex()}-{u[6:8].hex()}-{u[8:10].hex()}-{u[10:].hex()}"
			return text.lower()
		}
	}

	// Random bytes for an identifier. A system without a random source can make
	// no identifier that is unique, so the program stops there rather than
	// handing out the same bytes twice.
	internal def uuidRandom(length int) byte[] {
		let randomSourceAvailable = true
		let nothing byte[]
		let buf = rand(length) onerror (err error) {
			randomSourceAvailable = false
			recover nothing
		}
		assert randomSourceAvailable
		return buf
	}

	// The 16 bytes of 32 hexadecimal digits, in either case; empty for any
	// other text.
	internal def uuidBytesOfHex(hex string) byte[] {
		let nothing byte[]
		return nothing when hex.len() != 32
		for let c in hex {
			return nothing unless c.isHexDigit()
		}
		let out = byte[]
		out.len(16)
		for let i = 0; i < 16; i++ {
			out[i] = parseInt<byte>(hex[i * 2:i * 2 + 2], 16)
		}
		return out
	}

	// The identifier of 32 hexadecimal digits written in this module: a
	// namespace constant. Anything else fails an assertion.
	internal def uuidOfHex(hex string) UUID {
		let parsed = uuidBytesOfHex(hex)
		assert parsed.len() == 16
		let out = new UUID()
		out.uuid = parsed
		return out
	}

	// parseUUID returns a new UUID parsed from text. Fails when the text is not a
	// UUID.
	def parseUUID(val string) !UUID {
		let uuid = new UUID()
		try uuid.fromString(val)
		return uuid
	}

	// parseUUID returns a new UUID from its 16 bytes. Fails when the length is
	// not 16.
	def parseUUID(val byte[]) !UUID {
		let uuid = new UUID()
		try uuid.fromBytes(val)
		return uuid
	}

	check "UUID" {
		use std.testing

		@benchmark()
		def newUUID() {
			let uuid = new UUID()
		}

		@benchmark()
		def newUUIDV7() {
			let uuid = new UUID(UUIDVersion.V7)
		}
	}
}
