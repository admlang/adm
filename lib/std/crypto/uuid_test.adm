partial module std.crypto {
	use std.testing

	check "UUID" {
		@test()
		def parsesCanonicalForm() !none {
			let u = try parseUUID("123e4567-e89b-12d3-a456-426614174000")
			assert u.str() == "123e4567-e89b-12d3-a456-426614174000"
		}

		@test()
		def bracesAreStripped() !none {
			let plain = try parseUUID("123e4567-e89b-12d3-a456-426614174000")
			let braced = try parseUUID("\{123e4567-e89b-12d3-a456-426614174000\}")
			assert braced.str() == plain.str()
		}

		@test()
		def rejectsMalformedInput() {
			let short = parseUUID("123e4567-e89b-12d3-a456")
			assert short is error
			let halfBraced = parseUUID("\{123e4567-e89b-12d3-a456-426614174000")
			assert halfBraced is error
		}
	}
}
