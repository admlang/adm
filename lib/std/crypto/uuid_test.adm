partial module std.crypto {
	use (
		std.testing
		std.time
	)

	check "UUID" {
		@test()
		def parsesCanonicalForm() !none {
			let u = try parseUUID("123e4567-e89b-12d3-a456-426614174000")
			assert u.str() == "123e4567-e89b-12d3-a456-426614174000"
			assert u.version() == 1
			assert u.bytes().len() == 16 && u.bytes()[0] == 0x12 && u.bytes()[15] == 0x00
		}

		// Upper case, no hyphens, braces and the URN prefix all name the same identifier.
		@test()
		def parsesEveryTextForm() !none {
			let plain = try parseUUID("123e4567-e89b-12d3-a456-426614174000")
			for let text in ["123E4567-E89B-12D3-A456-426614174000", "123e4567e89b12d3a456426614174000", "\{123e4567-e89b-12d3-a456-426614174000\}", "urn:uuid:123e4567-e89b-12d3-a456-426614174000", "  URN:UUID:123E4567E89B12D3A456426614174000 "] {
				let other = try new UUID().fromString(text)
				assert other.equals(plain) && other.str() == plain.str()
			}
			let bytes = try parseUUID(plain.bytes())
			assert bytes.equals(plain)
			let filled = new UUID()
			try filled.fromBytes(plain.bytes())
			assert filled.equals(plain)
		}

		// Wrong length, hyphens in the wrong place, a digit that is not hexadecimal, half
		// a pair of braces and 15 bytes are refused; nothing parses as zeros.
		@test()
		def rejectsMalformedInput() {
			for let text in ["123e4567-e89b-12d3-a456", "123e4567-e89b-12d3-a456-42661417400", "123e4567e89b-12d3-a456-426614174000", "zzzzzzzz-zzzz-zzzz-zzzz-zzzzzzzzzzzz", "123e4567-e89b-12d3-a456-42661417400g", "\{123e4567-e89b-12d3-a456-426614174000", ""] {
				assert parseUUID(text) is error
			}
			let short byte[]
			short.len(15)
			assert parseUUID(short) is error
		}

		// A random identifier carries version 4 and the RFC variant, and two differ.
		@test()
		def randomIdentifiersAreVersion4() {
			let a = new UUID()
			let b = new UUID(UUIDVersion.V4)
			assert a.version() == 4 && b.version() == 4
			assert a.bytes()[8] & 0xC0 == 0x80
			assert !a.equals(b) && a.str() != b.str()
			assert !a.isNil()
			assert a.timestamp() is none
			assert a.str().len() == 36 && a.str().isUUID()
		}

		// A time-ordered identifier carries the millisecond it was made in, and identifiers
		// made one after another sort in that order as text and as bytes, within one
		// millisecond too.
		@test()
		def timeOrderedIdentifiersSort() !none {
			let before = time.wallNs() / 1000000
			let first = new UUID(UUIDVersion.V7)
			let after = time.wallNs() / 1000000
			assert first.version() == 7
			assert first.bytes()[8] & 0xC0 == 0x80
			let stamp = first.timestamp()
			fail "no timestamp on a V7 identifier" when stamp is none
			let ms = stamp.unixNs() / 1000000
			assert ms >= before && ms <= after
			let last = first
			for let i = 0; i < 2000; i++ {
				let next = new UUID(UUIDVersion.V7)
				assert next.str() > last.str()
				assert !next.equals(last)
				last = next
			}
		}

		// Name-based identifiers are RFC 9562's: appendix A.4 (SHA-1) and A.2 (MD5) for
		// "www.example.com" in the DNS namespace; the same input gives the same identifier,
		// another name or another namespace gives another.
		@test()
		def nameBasedIdentifiersAreTheRFCVectors() {
			let v5 = new UUID(uuidNamespaceDNS, "www.example.com")
			assert v5.str() == "2ed6657d-e927-568b-95e1-2665a8aea6a2"
			assert v5.version() == 5
			let v3 = new UUID(uuidNamespaceDNS, "www.example.com", UUIDVersion.V3)
			assert v3.str() == "5df41881-3aed-3515-88a7-2f4a814cf09e"
			assert v3.version() == 3
			assert new UUID(uuidNamespaceDNS, "www.example.com", UUIDVersion.V5).equals(v5)
			assert !new UUID(uuidNamespaceDNS, "www.example.org").equals(v5)
			assert !new UUID(uuidNamespaceURL, "www.example.com").equals(v5)
			assert uuidNamespaceDNS.str() == "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
			assert uuidNamespaceURL.str() == "6ba7b811-9dad-11d1-80b4-00c04fd430c8"
			assert uuidNamespaceOID.str() == "6ba7b812-9dad-11d1-80b4-00c04fd430c8"
			assert uuidNamespaceX500.str() == "6ba7b814-9dad-11d1-80b4-00c04fd430c8"
		}

		// Equal bytes are one map key, whichever object holds them; the nil identifier is
		// told apart.
		@test()
		def identifiersAreMapKeys() !none {
			let counts = map<UUID, int>{}
			let a = try parseUUID("123e4567-e89b-42d3-a456-426614174000")
			let again = try parseUUID("123E4567E89B42D3A456426614174000")
			counts = counts.set(a, 1)
			let seen = counts.get(again)
			assert !(seen is none) && seen == 1
			counts = counts.set(again, 2)
			let total = counts.get(a)
			assert counts.len() == 1 && !(total is none) && total == 2
			assert a.hash() == again.hash()
			let nil = try parseUUID("00000000-0000-0000-0000-000000000000")
			assert nil.isNil() && !a.isNil() && nil.hash() == 0
		}
	}
}
