partial module std.crypto {
	// x25519 is the Diffie-Hellman function of RFC 7748 over Curve25519:
	// the u-coordinate of scalar times point, both 32 bytes little-endian.
	// The scalar is clamped as the RFC requires, so any 32 random bytes are
	// a private key; the public key is x25519Base(scalar).
	// Fails when either input is not 32 bytes or the result is all zeros,
	// which means the peer sent a low-order point.
	def x25519(scalar, point byte[]) !byte[] {
		expects {
			assert scalar.len() == 32 onerror fail "x25519: scalar must be 32 bytes"
			assert point.len() == 32 onerror fail "x25519: point must be 32 bytes"
		}
		let k = byte[] + scalar
		k[0] &= 248
		k[31] &= 127
		k[31] |= 64

		let x1 = feFromBytes(point)
		let x2 = feOne()
		let z2 = feZero()
		let x3 = feFromBytes(point)
		let z3 = feOne()
		let swap uint64 = 0
		for let t = 254; t >= 0; t-- {
			let bit = uint64((k[t / 8] >> (t % 8)) & 1)
			swap ^= bit
			feSwap(x2, x3, swap)
			feSwap(z2, z3, swap)
			swap = bit

			let a = feAdd(x2, z2)
			let aa = feMul(a, a)
			let b = feSub(x2, z2)
			let bb = feMul(b, b)
			let e = feSub(aa, bb)
			let c = feAdd(x3, z3)
			let d = feSub(x3, z3)
			let da = feMul(d, a)
			let cb = feMul(c, b)
			let sum = feAdd(da, cb)
			x3 = feMul(sum, sum)
			let diff = feSub(da, cb)
			z3 = feMul(x1, feMul(diff, diff))
			x2 = feMul(aa, bb)
			z2 = feMul(e, feAdd(aa, feMulSmall(e, 121665)))
		}
		feSwap(x2, x3, swap)
		feSwap(z2, z3, swap)

		let out = feToBytes(feMul(x2, feInvert(z2)))
		let acc byte = 0
		for let (_, v) in out {
			acc |= v
		}
		fail "x25519: low order point" when acc == 0
		return out
	}

	// x25519Base is the public key for a scalar: x25519 with the base point
	// u = 9. Fails when the scalar is not 32 bytes.
	def x25519Base(scalar byte[]) !byte[] {
		let base byte[]
		base.len(32)
		base[0] = 9
		return try x25519(scalar, base)
	}

	// Field elements modulo 2^255 - 19 are five 51-bit limbs, little
	// endian, held loosely: limbs may exceed 51 bits between operations and
	// are brought back by the carry chain after every multiplication.
	internal const feMask51 uint64 = 0x7ffffffffffff

	internal def feZero() uint64[] {
		return uint64[0, 0, 0, 0, 0]
	}

	internal def feOne() uint64[] {
		return uint64[1, 0, 0, 0, 0]
	}

	internal def feLoad64(b byte[], off int) uint64 {
		let v uint64 = 0
		for let i = 7; i >= 0; i-- {
			v = (v << 8) | uint64(b[off + i])
		}
		return v
	}

	internal def feStore64(b byte[], off int, v uint64) {
		for let i = 0; i < 8; i++ {
			b[off + i] = byte((v >> (i * 8)) & 0xFF)
		}
	}

	// feFromBytes reads 32 little-endian bytes; bit 255 is ignored.
	internal def feFromBytes(b byte[]) uint64[] {
		let h = feZero()
		h[0] = feLoad64(b, 0) & feMask51
		h[1] = (feLoad64(b, 6) >> 3) & feMask51
		h[2] = (feLoad64(b, 12) >> 6) & feMask51
		h[3] = (feLoad64(b, 19) >> 1) & feMask51
		h[4] = (feLoad64(b, 24) >> 12) & feMask51
		return h
	}

	// feToBytes reduces fully and writes 32 little-endian bytes.
	internal def feToBytes(v uint64[]) byte[] {
		let h = uint64[v[0], v[1], v[2], v[3], v[4]]
		feCarry(h)
		// Add 19 and see whether the value overflows 2^255: if so it was
		// at least p, and adding 19 then dropping the top bit subtracts p.
		let q = (h[0] + 19) >> 51
		q = (h[1] + q) >> 51
		q = (h[2] + q) >> 51
		q = (h[3] + q) >> 51
		q = (h[4] + q) >> 51
		h[0] += 19 * q
		// Plain carries this time: the bit that reaches 2^255 is the p
		// being subtracted and is dropped, not folded back as 19.
		for let i = 0; i < 4; i++ {
			h[i + 1] += h[i] >> 51
			h[i] &= feMask51
		}
		h[4] &= feMask51

		let out byte[]
		out.len(32)
		feStore64(out, 0, h[0] | (h[1] << 51))
		feStore64(out, 8, (h[1] >> 13) | (h[2] << 38))
		feStore64(out, 16, (h[2] >> 26) | (h[3] << 25))
		feStore64(out, 24, (h[3] >> 39) | (h[4] << 12))
		return out
	}

	// feCarry propagates carries in place; the top carry wraps as 19.
	internal def feCarry(h uint64[]) {
		let c = h[0] >> 51
		h[0] &= feMask51
		h[1] += c
		c = h[1] >> 51
		h[1] &= feMask51
		h[2] += c
		c = h[2] >> 51
		h[2] &= feMask51
		h[3] += c
		c = h[3] >> 51
		h[3] &= feMask51
		h[4] += c
		c = h[4] >> 51
		h[4] &= feMask51
		h[0] += c * 19
	}

	internal def feAdd(a, b uint64[]) uint64[] {
		let r = uint64[a[0] + b[0], a[1] + b[1], a[2] + b[2], a[3] + b[3], a[4] + b[4]]
		feCarry(r)
		return r
	}

	// feSub adds 2p before subtracting so no limb goes negative.
	internal def feSub(a, b uint64[]) uint64[] {
		let r = uint64[
			(a[0] + 0xFFFFFFFFFFFDA) - b[0],
			(a[1] + 0xFFFFFFFFFFFFE) - b[1],
			(a[2] + 0xFFFFFFFFFFFFE) - b[2],
			(a[3] + 0xFFFFFFFFFFFFE) - b[3],
			(a[4] + 0xFFFFFFFFFFFFE) - b[4]
		]
		feCarry(r)
		return r
	}

	// feMul is schoolbook multiplication with 128-bit accumulators; the
	// limbs above 2^255 fold back times 19.
	internal def feMul(a, b uint64[]) uint64[] {
		let a0, a1, a2, a3, a4 = uint128(a[0]), uint128(a[1]), uint128(a[2]), uint128(a[3]), uint128(a[4])
		let b0, b1, b2, b3, b4 = uint128(b[0]), uint128(b[1]), uint128(b[2]), uint128(b[3]), uint128(b[4])
		let a1x, a2x, a3x, a4x = a1 * 19, a2 * 19, a3 * 19, a4 * 19

		let r0 = a0 * b0 + a1x * b4 + a2x * b3 + a3x * b2 + a4x * b1
		let r1 = a0 * b1 + a1 * b0 + a2x * b4 + a3x * b3 + a4x * b2
		let r2 = a0 * b2 + a1 * b1 + a2 * b0 + a3x * b4 + a4x * b3
		let r3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + a4x * b4
		let r4 = a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0
		return feReduce128(r0, r1, r2, r3, r4)
	}

	// feMulSmall multiplies by a constant below 2^32.
	internal def feMulSmall(a uint64[], k uint64) uint64[] {
		let m = uint128(k)
		return feReduce128(uint128(a[0]) * m, uint128(a[1]) * m, uint128(a[2]) * m, uint128(a[3]) * m, uint128(a[4]) * m)
	}

	internal def feReduce128(r0, r1, r2, r3, r4 uint128) uint64[] {
		let mask = uint128(feMask51)
		let c = r0 >> 51
		r0 &= mask
		r1 += c
		c = r1 >> 51
		r1 &= mask
		r2 += c
		c = r2 >> 51
		r2 &= mask
		r3 += c
		c = r3 >> 51
		r3 &= mask
		r4 += c
		c = r4 >> 51
		r4 &= mask
		r0 += c * 19
		c = r0 >> 51
		r0 &= mask
		r1 += c
		return uint64[uint64(r0), uint64(r1), uint64(r2), uint64(r3), uint64(r4)]
	}

	// feInvert raises to p - 2, whose bits are all set except 2 and 4.
	internal def feInvert(a uint64[]) uint64[] {
		let r = feOne()
		for let i = 254; i >= 0; i-- {
			r = feMul(r, r)
			r = feMul(r, a) when i != 2 && i != 4
		}
		return r
	}

	// feSwap exchanges a and b in place when swap is 1, touching both
	// either way.
	internal def feSwap(a, b uint64[], swap uint64) {
		let mask = uint64(0) - swap
		for let i = 0; i < 5; i++ {
			let t = mask & (a[i] ^ b[i])
			a[i] ^= t
			b[i] ^= t
		}
	}

	// feNeg returns -a mod p.
	internal def feNeg(a uint64[]) uint64[] {
		return feSub(feZero(), a)
	}

	// feEqual reports whether two field elements hold the same value,
	// comparing their canonical byte encodings in constant time.
	internal def feEqual(a, b uint64[]) bool {
		return constantTimeEqual(feToBytes(a), feToBytes(b))
	}
}
