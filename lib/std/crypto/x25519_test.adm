partial module std.crypto {
	use (
		std.testing
		std.data.encoding::(hexdecode)
	)

	check "X25519" {
		@test()
		def TestX25519RFC7748Vectors() !none {
			let k1 = try hexdecode("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4")
			let u1 = try hexdecode("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")
			assert (try x25519(k1, u1)).hex() == "C3DA55379DE9C6908E94EA4DF28D084F32ECCF03491C71F754B4075577A28552"

			let k2 = try hexdecode("4b66e9d4d1b4673c5ad22691957d6af5c11b6421e0ea01d42ca4169e7918ba0d")
			let u2 = try hexdecode("e5210f12786811d3f4b7959d0538ae2c31dbe7106fc03c3efc4cd549c715a493")
			assert (try x25519(k2, u2)).hex() == "95CBDE9476E8907D7AADE45CB4B873F88B595A68799FA152E6F8F7647AAC7957"

			// One iteration of the ladder with k = u = 9.
			let nine byte[]
			nine.len(32)
			nine[0] = 9
			assert (try x25519(nine, nine)).hex() == "422C8E7A6227D7BCA1350B3E2BB7279F7897B87BB6854B783C60E80311AE3079"
		}

		@test()
		def TestX25519DiffieHellman() !none {
			let alice = try hexdecode("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
			let bob = try hexdecode("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb")
			let alicePub = try x25519Base(alice)
			let bobPub = try x25519Base(bob)
			assert alicePub.hex() == "8520F0098930A754748B7DDCB43EF75A0DBF3A0D26381AF4EBA4A98EAA9B4E6A"
			assert bobPub.hex() == "DE9EDB7D7B7DC1B4D35B61C2ECE435373F8343C85B78674DADFC7E146F882B4F"
			let shared = try x25519(alice, bobPub)
			assert shared.hex() == "4A5D9D5BA4CE2DE1728E3BF480350F25E07E21C947D19E3376F09B3C1E161742"
			assert (try x25519(bob, alicePub)).hex() == shared.hex()
		}

		@test()
		def TestX25519Rejects() !none {
			let zero byte[]
			zero.len(32)
			let k = try hexdecode("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4")
			let low = x25519(k, zero) onerror recover "low".bytes()
			assert string(low) == "low"
			let short = x25519(k, zero[0:31]) onerror recover "short".bytes()
			assert string(short) == "short"
		}
	}
}
