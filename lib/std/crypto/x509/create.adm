partial module std.crypto.x509 {
	use (
		std.time
		std.time::(Time)
		std.crypto::(PrivateKey, PublicKey, RSAPrivateKey, ECDSAPrivateKey, Ed25519PrivateKey, Ed448PrivateKey, marshalPKIXPublicKey, publicKeyOf, rand)
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(ASN1Element, OID, asn1BitString, asn1Boolean, asn1Explicit, asn1Implicit, asn1Integer, asn1OID, asn1OctetString, asn1Parse, asn1Null, asn1Sequence, asn1Set, asn1Time, asn1UTF8String, asn1PrintableString, asn1IA5String, asn1Constructed, ASN1Class)
	)

	// What createCertificate and createRequest put in what they make. Fields
	// left at their zero value are left out; a serial number of 0 becomes 16
	// random bytes.
	//
	// Example:
	// ```example
	// let template = x509.Template{dnsNames: ["adm.test"], notAfter: time.now() + 2160h}
	// template.subject.commonName = "adm.test"
	// let der = try x509.createCertificate(template, crypto.publicKeyOf(key), none, key)
	// ```
	struct Template {
		subject        Name          = new Name()
		serialNumber   bigint        = 0
		// The validity; notBefore defaults to an hour ago, notAfter to 90
		// days after notBefore.
		notBefore      ?Time         = none
		notAfter       ?Time         = none
		// Subject alternative names. IP addresses are 4 or 16 bytes.
		dnsNames       string[]      = []
		ipAddresses    byte[][]      = []
		emailAddresses string[]      = []
		uris           string[]      = []
		// Basic constraints: a CA, and the longest chain of CAs below it
		// (-1 for no limit).
		isCA           bool          = false
		maxPathLen     int           = -1
		keyUsage       KeyUsage[]    = []
		extKeyUsage    ExtKeyUsage[] = []
		// Further extensions, written after the ones above as given: the
		// ACME identifier of RFC 8737, a TLS feature, a policy.
		extensions     Extension[]   = []
	}

	// createCertificate makes an X.509 v3 certificate (DER) for the public
	// key, signed by signer: by the issuer's key under the issuer's name, or
	// self-signed when issuer is none. It carries the template's subject,
	// validity and extensions, a subject key identifier, and an authority
	// key identifier when an issuer signs. The signature is ECDSA with the
	// hash of the curve's size, RSA PKCS#1 v1.5 with SHA-256, Ed25519 or
	// Ed448. Fails when signer cannot sign (an X25519 or X448 key), when the
	// random source fails, or when signing does.
	def createCertificate(template Template, key PublicKey, issuer ?Certificate, signer PrivateKey) !byte[] {
		let algorithm = try signatureAlgorithmFor(signer)
		let serial = template.serialNumber
		if serial == bigint(0) {
			let random = try rand(16)
			random[0] = random[0] & 0x7F | 0x01
			serial = parseBigInt(random)
		}
		let notBefore = template.notBefore
		let start = notBefore is none ?? (time.now() - 1h, notBefore)
		let notAfter = template.notAfter
		let end = notAfter is none ?? (start + 2160h, notAfter)
		let subject = encodeName(template.subject)
		let issuerName = issuer is none ?? (subject, try asn1Parse(issuer.rawSubject))
		let spki = marshalPKIXPublicKey(key)
		let extensions = try certificateExtensions(template, spki, issuer)
		let items = [asn1Explicit(0, asn1Integer(2)), asn1Integer(serial), algorithm, issuerName, asn1Sequence([asn1Time(start), asn1Time(end)]), subject, try asn1Parse(spki)]
		items.push(asn1Explicit(3, asn1Sequence(extensions))) when extensions.len() > 0
		let body = asn1Sequence(items)
		let signature = try signWith(signer, body.encode())
		return asn1Sequence([body, algorithm, asn1BitString(signature)]).encode()
	}

	// createRequest makes a PKCS#10 certificate signing request (DER) for
	// signer's public key: the template's subject, and its subject
	// alternative names, key usages and extra extensions as an extension
	// request. Fails as createCertificate does.
	def createRequest(template Template, signer PrivateKey) !byte[] {
		let algorithm = try signatureAlgorithmFor(signer)
		let spki = marshalPKIXPublicKey(publicKeyOf(signer))
		let extensions = try requestExtensions(template)
		let attributes ASN1Element[] = []
		// extensionRequest (PKCS#9): a SET holding the Extensions.
		attributes.push(asn1Sequence([asn1OID(new OID([1, 2, 840, 113549, 1, 9, 14])), asn1Set([asn1Sequence(extensions)])])) when extensions.len() > 0
		let info = asn1Sequence([asn1Integer(0), encodeName(template.subject), try asn1Parse(spki), asn1Constructed(ASN1Class.ContextSpecific, 0, attributes)])
		let signature = try signWith(signer, info.encode())
		return asn1Sequence([info, algorithm, asn1BitString(signature)]).encode()
	}

	// The DER of a name: its `names` in order when it has them, else the
	// common fields from the least to the most specific (C, ST, L, O, OU,
	// CN).
	internal def encodeName(n Name) ASN1Element {
		let attributes AttributeTypeValue[] = n.names
		if attributes.len() == 0 {
			for let v in n.country {
				attributes.push(AttributeTypeValue{oid: oidAttributeCountry, value: v})
			}
			for let v in n.province {
				attributes.push(AttributeTypeValue{oid: oidAttributeProvince, value: v})
			}
			for let v in n.locality {
				attributes.push(AttributeTypeValue{oid: oidAttributeLocality, value: v})
			}
			for let v in n.organization {
				attributes.push(AttributeTypeValue{oid: oidAttributeOrganization, value: v})
			}
			for let v in n.organizationalUnit {
				attributes.push(AttributeTypeValue{oid: oidAttributeOrganizationalUnit, value: v})
			}
			attributes.push(AttributeTypeValue{oid: oidAttributeSerialNumber, value: n.serialNumber}) when n.serialNumber != ""
			attributes.push(AttributeTypeValue{oid: oidAttributeCommonName, value: n.commonName}) when n.commonName != ""
		}
		let rdns ASN1Element[] = []
		for let a in attributes {
			// Country and serial number are PrintableString by their
			// definitions; the rest UTF8String (RFC 5280 §4.1.2.6).
			let printable = a.oid.equals(oidAttributeCountry) || a.oid.equals(oidAttributeSerialNumber)
			let value = printable ?? (asn1PrintableString(a.value), asn1UTF8String(a.value))
			rdns.push(asn1Set([asn1Sequence([asn1OID(a.oid), value])]))
		}
		return asn1Sequence(rdns)
	}

	internal def certificateExtensions(template Template, spki byte[], issuer ?Certificate) !ASN1Element[] {
		let out ASN1Element[] = []
		let keyBits = (try asn1Parse(spki)).children[1].content
		let keyId = digest(Hash.SHA1, keyBits[1:])
		out.push(extensionOf(oidExtSubjectKeyId, false, asn1OctetString(keyId)))
		if !(issuer is none) {
			let authority = issuer.subjectKeyId.len() > 0 ?? (issuer.subjectKeyId, digest(Hash.SHA1, (try asn1Parse(issuer.rawSPKI)).children[1].content[1:]))
			out.push(extensionOf(oidExtAuthorityKeyId, false, asn1Sequence([asn1Implicit(0, asn1OctetString(authority))])))
		}
		if template.isCA {
			let constraint ASN1Element[] = [asn1Boolean(true)]
			constraint.push(asn1Integer(template.maxPathLen)) when template.maxPathLen >= 0
			out.push(extensionOf(oidExtBasicConstraints, true, asn1Sequence(constraint)))
		}
		out += try requestExtensions(template)
		return out
	}

	// The extensions a request asks for and a certificate carries: key
	// usage, extended key usage, subject alternative names, the extras.
	internal def requestExtensions(template Template) !ASN1Element[] {
		let out ASN1Element[] = []
		if template.keyUsage.len() > 0 {
			let bits = 0
			for let u in template.keyUsage {
				bits = bits | u.value
			}
			out.push(extensionOf(oidExtKeyUsage, true, asn1BitString(keyUsageBits(bits))))
		}
		if template.extKeyUsage.len() > 0 {
			let purposes ASN1Element[] = []
			for let u in template.extKeyUsage {
				purposes.push(asn1OID(try oidOfExtKeyUsage(u)))
			}
			out.push(extensionOf(oidExtExtendedKeyUsage, false, asn1Sequence(purposes)))
		}
		let names ASN1Element[] = []
		for let v in template.emailAddresses {
			names.push(asn1Implicit(1, asn1IA5String(v)))
		}
		for let v in template.dnsNames {
			names.push(asn1Implicit(2, asn1IA5String(v)))
		}
		for let v in template.uris {
			names.push(asn1Implicit(6, asn1IA5String(v)))
		}
		for let v in template.ipAddresses {
			fail "x509: an IP address is 4 or 16 bytes, not {v.len()}" unless v.len() == 4 || v.len() == 16
			names.push(asn1Implicit(7, asn1OctetString(v)))
		}
		// Critical when the subject is empty (RFC 5280 §4.2.1.6).
		out.push(extensionOf(oidExtSubjectAltName, template.subject.isEmpty() && template.subject.commonName == "", asn1Sequence(names))) when names.len() > 0
		for let e in template.extensions {
			let parts = [asn1OID(e.id)]
			parts.push(asn1Boolean(true)) when e.critical
			parts.push(asn1OctetString(e.value))
			out.push(asn1Sequence(parts))
		}
		return out
	}

	internal def extensionOf(id OID, critical bool, value ASN1Element) ASN1Element {
		let parts = [asn1OID(id)]
		parts.push(asn1Boolean(true)) when critical
		parts.push(asn1OctetString(value.encode()))
		return asn1Sequence(parts)
	}

	// The key usage bits as DER packs them: bit 0 first (most significant
	// bit of the first byte), trailing zero bits left out.
	internal def keyUsageBits(bits int) byte[] {
		let out = byte[0, 0]
		for let i = 0; i < 9; i++ {
			out[i / 8] = out[i / 8] | byte(0x80 >> (i % 8)) when (bits >> i) & 1 == 1
		}
		return out[1] == byte(0) ?? (out[:1], out)
	}

	internal def oidOfExtKeyUsage(u ExtKeyUsage) !OID {
		match u {
			case ExtKeyUsage.Any:
				return new OID([2, 5, 29, 37, 0])
			case ExtKeyUsage.ServerAuth:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 1])
			case ExtKeyUsage.ClientAuth:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 2])
			case ExtKeyUsage.CodeSigning:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 3])
			case ExtKeyUsage.EmailProtection:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 4])
			case ExtKeyUsage.IPSECEndSystem:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 5])
			case ExtKeyUsage.IPSECTunnel:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 6])
			case ExtKeyUsage.IPSECUser:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 7])
			case ExtKeyUsage.TimeStamping:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 8])
			case ExtKeyUsage.OCSPSigning:
				return new OID([1, 3, 6, 1, 5, 5, 7, 3, 9])
			default:
				fail "x509: {u.name} is not written by this module"
		}
	}

	// The AlgorithmIdentifier signWith uses for the key.
	internal def signatureAlgorithmFor(signer PrivateKey) !ASN1Element {
		match signer {
			case RSAPrivateKey:
				return asn1Sequence([asn1OID(oidSignatureSHA256WithRSA), asn1Null()])
			case ECDSAPrivateKey:
				let bits = signer.curve.bitsize
				let oid = bits <= 256 ?? (oidSignatureECDSAWithSHA256, bits <= 384 ?? (oidSignatureECDSAWithSHA384, oidSignatureECDSAWithSHA512))
				return asn1Sequence([asn1OID(oid)])
			case Ed25519PrivateKey:
				return asn1Sequence([asn1OID(oidSignatureEd25519)])
			case Ed448PrivateKey:
				return asn1Sequence([asn1OID(oidSignatureEd448)])
			default:
				fail "x509: an X25519 or X448 key cannot sign"
		}
	}

	internal def signWith(signer PrivateKey, message byte[]) !byte[] {
		match signer {
			case RSAPrivateKey:
				return try signer.signPKCS1v15(Hash.SHA256, digest(Hash.SHA256, message))
			case ECDSAPrivateKey:
				let bits = signer.curve.bitsize
				let hash = bits <= 256 ?? (Hash.SHA256, bits <= 384 ?? (Hash.SHA384, Hash.SHA512))
				return try signer.signASN1(digest(hash, message))
			case Ed25519PrivateKey:
				return signer.sign(message)
			case Ed448PrivateKey:
				return try signer.sign(message)
			default:
				fail "x509: an X25519 or X448 key cannot sign"
		}
	}
}
