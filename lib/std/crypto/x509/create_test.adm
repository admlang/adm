partial module std.crypto.x509 {
	use (
		std.testing
		std.time
		std.crypto::(PrivateKey, generateECDSAKey, generateEd25519Key, generateRSAKey, generateX25519Key, publicKeyOf, p256, p384)
		std.data.encoding::(asn1Parse, OID, asn1OctetString)
	)

	check "Creating certificates" {
		// A CA, a leaf it signs (ECDSA P-384 over an RSA key and over an Ed25519 key)
		// and a self-signed certificate read back with every field, and the leaf
		// verifies against the CA. OpenSSL 3 accepts the same output by hand
		// (`openssl verify`, `openssl req -verify`).
		@test()
		def makesAndVerifiesChains() !none {
			let caKey PrivateKey = try generateECDSAKey(p384)
			let ca = Template{isCA: true, maxPathLen: 0, keyUsage: [KeyUsage.CertSign, KeyUsage.CRLSign]}
			ca.subject.commonName = "ADM Test CA"
			ca.subject.country = ["GB"]
			let caCert = try parseCertificate(try createCertificate(ca, publicKeyOf(caKey), none, caKey))
			assert caCert.isCA && caCert.maxPathLenZero && caCert.subject.str() == "CN=ADM Test CA,C=GB" && caCert.issuer.str() == caCert.subject.str()
			assert caCert.signatureAlgorithm == SignatureAlgorithm.ECDSAWithSHA384 && caCert.keyUsage == KeyUsage.CertSign.value | KeyUsage.CRLSign.value
			let pool = new CertPool()
			pool.addCert(caCert)
			let leaf = Template{dnsNames: ["adm.test", "www.adm.test"], ipAddresses: [byte[127, 0, 0, 1]], emailAddresses: ["ops@adm.test"], uris: ["https://adm.test/"], extKeyUsage: [ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth], keyUsage: [KeyUsage.DigitalSignature, KeyUsage.KeyEncipherment, KeyUsage.DecipherOnly], notBefore: time.now() - 1h, notAfter: time.now() + 24h}
			leaf.subject.commonName = "adm.test"
			let rsa PrivateKey = try generateRSAKey(1024)
			let ed PrivateKey = try generateEd25519Key()
			for let signed in [rsa, ed] {
				let c = try parseCertificate(try createCertificate(leaf, publicKeyOf(signed), caCert, caKey))
				assert c.dnsNames.equals(["adm.test", "www.adm.test"]) && c.ipAddresses[0].equals(byte[127, 0, 0, 1]) && c.emailAddresses[0] == "ops@adm.test" && c.uris[0] == "https://adm.test/"
				assert c.extKeyUsage.equals([ExtKeyUsage.ServerAuth, ExtKeyUsage.ClientAuth]) && c.keyUsage == 1 | 4 | 256
				assert c.authorityKeyId.equals(caCert.subjectKeyId) && c.serialNumber > bigint(0) && !c.isCA
				let chains = try c.verify(VerifyOptions{dnsName: "www.adm.test", roots: pool})
				assert chains.len() == 1
			}
			let edKey PrivateKey = try generateEd25519Key()
			let own = try parseCertificate(try createCertificate(leaf, publicKeyOf(edKey), none, edKey))
			assert own.signatureAlgorithm == SignatureAlgorithm.Ed25519 && own.issuer.str() == "CN=adm.test"
		}

		// A certificate signing request carries the subject, the key and the
		// extensions as an extension request; extra extensions pass as given;
		// a key that cannot sign is refused.
		@test()
		def makesRequests() !none {
			let key PrivateKey = try generateECDSAKey(p256)
			let acmeId = new OID([1, 3, 6, 1, 5, 5, 7, 1, 31])
			let t = Template{dnsNames: ["adm.test"], extensions: [Extension{id: acmeId, critical: true, value: asn1OctetString(byte[1, 2, 3]).encode()}]}
			t.subject.commonName = "adm.test"
			let csr = try asn1Parse(try createRequest(t, key))
			let info = csr.children[0]
			assert try info.children[0].asInt() == 0
			assert (try parseName(info.children[1])).commonName == "adm.test"
			let attribute = info.children[3].children[0]
			assert (try attribute.children[0].asOID()).str() == "1.2.840.113549.1.9.14"
			let extensions = attribute.children[1].children[0].children
			assert extensions.len() == 2 && (try extensions[1].children[0].asOID()).equals(acmeId)
			let own = try parseCertificate(try createCertificate(t, publicKeyOf(key), none, key))
			let found = own.extensions.find(e => e.id.equals(acmeId), 0)
			assert !(found is none) && found.critical
			let agreement = try generateX25519Key()
			let x PrivateKey = agreement
			assert createRequest(t, x) is error
		}
	}
}
