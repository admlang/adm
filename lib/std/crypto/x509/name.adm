partial module std.crypto.x509 {
	use std.data.encoding::(ASN1Element, ASN1Tag, OID)

	// AttributeTypeValue is one attribute of a distinguished name: the type
	// OID and the value as text.
	struct AttributeTypeValue {
		oid   OID
		value string
	}

	// Name is an X.509 distinguished name with the common attributes
	// pulled out. `names` holds every attribute in the order encoded, the
	// standard ones included, so nothing is lost.
	type Name {
		country            string[]
		organization       string[]
		organizationalUnit string[]
		locality           string[]
		province           string[]
		streetAddress      string[]
		postalCode         string[]
		serialNumber       string
		commonName         string
		names              AttributeTypeValue[]

		def new() {}

		// isEmpty reports whether the name has no attributes at all.
		def isEmpty() bool {
			return names.len() == 0
		}

		// str renders the name in the RFC 2253 form, most specific
		// attribute first: `CN=adm.test,OU=Dev,O=ADM Test,C=GB`. Values
		// with special characters are escaped with backslashes.
		def str() string {
			let out = ""
			for let i = names.len() - 1; i >= 0; i-- {
				out += "," when out != ""
				out += attributeName(names[i].oid) + "=" + escapeAttributeValue(names[i].value)
			}
			return out
		}
	}

	let (
		// oidAttributeCountry is the C attribute type.
		oidAttributeCountry            = new OID([2, 5, 4, 6])
		// oidAttributeOrganization is the O attribute type.
		oidAttributeOrganization       = new OID([2, 5, 4, 10])
		// oidAttributeOrganizationalUnit is the OU attribute type.
		oidAttributeOrganizationalUnit = new OID([2, 5, 4, 11])
		// oidAttributeCommonName is the CN attribute type.
		oidAttributeCommonName         = new OID([2, 5, 4, 3])
		// oidAttributeSerialNumber is the serialNumber attribute type.
		oidAttributeSerialNumber       = new OID([2, 5, 4, 5])
		// oidAttributeLocality is the L attribute type.
		oidAttributeLocality           = new OID([2, 5, 4, 7])
		// oidAttributeProvince is the ST attribute type.
		oidAttributeProvince           = new OID([2, 5, 4, 8])
		// oidAttributeStreetAddress is the street attribute type.
		oidAttributeStreetAddress      = new OID([2, 5, 4, 9])
		// oidAttributePostalCode is the postalCode attribute type.
		oidAttributePostalCode         = new OID([2, 5, 4, 17])
		// oidAttributeEmail is the emailAddress (PKCS#9) attribute type.
		oidAttributeEmail              = new OID([1, 2, 840, 113549, 1, 9, 1])
		// oidAttributeDomainComponent is the DC attribute type.
		oidAttributeDomainComponent    = new OID([0, 9, 2342, 19200300, 100, 1, 25])
		// oidAttributeUserId is the UID attribute type.
		oidAttributeUserId             = new OID([0, 9, 2342, 19200300, 100, 1, 1])
	)

	// attributeName is the short name of an attribute type, or its dotted
	// OID when it has none.
	def attributeName(oid OID) string {
		return "C" when oid.equals(oidAttributeCountry)
		return "O" when oid.equals(oidAttributeOrganization)
		return "OU" when oid.equals(oidAttributeOrganizationalUnit)
		return "CN" when oid.equals(oidAttributeCommonName)
		return "SERIALNUMBER" when oid.equals(oidAttributeSerialNumber)
		return "L" when oid.equals(oidAttributeLocality)
		return "ST" when oid.equals(oidAttributeProvince)
		return "STREET" when oid.equals(oidAttributeStreetAddress)
		return "POSTALCODE" when oid.equals(oidAttributePostalCode)
		return "EMAIL" when oid.equals(oidAttributeEmail)
		return "DC" when oid.equals(oidAttributeDomainComponent)
		return "UID" when oid.equals(oidAttributeUserId)
		return oid.str()
	}

	// parseName reads an RDNSequence: SEQUENCE OF SET OF
	// AttributeTypeAndValue. Fails when the structure is not that, or a
	// value is not a string the ASN.1 reader knows.
	def parseName(element ASN1Element) !Name {
		fail malformed("name is not a SEQUENCE") unless element.isTag(ASN1Tag.Sequence)
		let name = new Name()
		for let (_, rdn) in element.children {
			fail malformed("relative distinguished name is not a SET") unless rdn.isTag(ASN1Tag.Set)
			fail malformed("relative distinguished name is empty") when rdn.children.len() == 0
			for let (_, attribute) in rdn.children {
				fail malformed("name attribute is not a SEQUENCE of two") unless attribute.isTag(ASN1Tag.Sequence) && attribute.children.len() == 2
				let oid = try (try attribute.at(0)).asOID()
				let valueElement = try attribute.at(1)
				let failure ?error = none
				let value = valueElement.asString() onerror (err error) {
					failure = err
					recover ""
				}
				fail CertificateError{message: "x509: name attribute {attributeName(oid)}: " + failure.message} unless failure is none
				name.names.push(AttributeTypeValue{oid: oid, value: value})
				switch {
					case oid.equals(oidAttributeCountry):
						name.country.push(value)
					case oid.equals(oidAttributeOrganization):
						name.organization.push(value)
					case oid.equals(oidAttributeOrganizationalUnit):
						name.organizationalUnit.push(value)
					case oid.equals(oidAttributeCommonName):
						name.commonName = value
					case oid.equals(oidAttributeSerialNumber):
						name.serialNumber = value
					case oid.equals(oidAttributeLocality):
						name.locality.push(value)
					case oid.equals(oidAttributeProvince):
						name.province.push(value)
					case oid.equals(oidAttributeStreetAddress):
						name.streetAddress.push(value)
					case oid.equals(oidAttributePostalCode):
						name.postalCode.push(value)
				}
			}
		}
		return name
	}

	// escapeAttributeValue escapes a value for the RFC 2253 rendering:
	// backslash before `,+"\<>;`, a leading `#` or space, and a trailing
	// space.
	internal def escapeAttributeValue(value string) string {
		let out = ""
		let n = value.len()
		for let i = 0; i < n; i++ {
			let c = value[i]
			let special = c == ',' || c == '+' || c == '"' || c == '\\' || c == '<' || c == '>' || c == ';'
			special = true when i == 0 && (c == ' ' || c == '#')
			special = true when i == n - 1 && c == ' '
			out += "\\" when special
			out += value[i:i + 1]
		}
		return out
	}
}
