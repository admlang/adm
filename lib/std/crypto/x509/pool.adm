partial module std.crypto.x509 {
	use (
		std.os
		std.services::(Policy)
		std.crypto::(constantTimeEqual)
		std.data.encoding::(pemDecodeAll)
	)

	// CertPool is a set of certificates: the roots a verifier trusts, or the
	// intermediates it may build through.
	//
	// Example:
	// ```example
	// let roots = new CertPool()
	// roots.appendCertsFromPEM(try os.readText("ca.pem"))
	// let chains = try leaf.verify(VerifyOptions{roots: roots})
	// ```
	type CertPool {
		certs              Certificate[]
		// Indexes into certs by the hex of the raw subject.
		internal bySubject map<string, int[]>

		def new() {}

		// len is the number of certificates in the pool.
		def len() int {
			return certs.len()
		}

		// addCert adds a certificate; one already present is ignored.
		def addCert(cert Certificate) {
			return when contains(cert)
			let key = cert.rawSubject.hex()
			let existing = bySubject.get(key)
			let indexes int[] = []
			indexes = existing unless existing is none
			indexes.push(certs.len())
			bySubject.set(key, indexes)
			certs.push(cert)
		}

		// appendCertsFromPEM adds every "CERTIFICATE" block of the text and
		// reports whether at least one was added; blocks that do not parse
		// are skipped, as a system bundle may carry a few.
		def appendCertsFromPEM(text string) bool {
			let blocks = pemDecodeAll(text) onerror recover []
			let added = false
			for let (_, block) in blocks {
				continue when block.kind != "CERTIFICATE"
				let cert = parseCertificate(block.bytes) onerror recover new Certificate()
				continue when cert.raw.len() == 0
				addCert(cert)
				added = true
			}
			return added
		}

		// contains reports whether the certificate is in the pool.
		def contains(cert Certificate) bool {
			let indexes = bySubject.get(cert.rawSubject.hex())
			return false when indexes is none
			for let (_, index) in indexes {
				return true when certs[index].equals(cert)
			}
			return false
		}

		// findPotentialParents returns the certificates whose subject is the
		// certificate's issuer, those whose subject key identifier matches
		// the certificate's authority key identifier first.
		def findPotentialParents(cert Certificate) Certificate[] {
			let indexes = bySubject.get(cert.rawIssuer.hex())
			return [] when indexes is none
			let matching Certificate[]
			let rest Certificate[]
			for let (_, index) in indexes {
				let candidate = certs[index]
				if cert.authorityKeyId.len() > 0 && candidate.subjectKeyId.len() > 0 && constantTimeEqual(cert.authorityKeyId, candidate.subjectKeyId) {
					matching.push(candidate)
				} else {
					rest.push(candidate)
				}
			}
			return matching + rest
		}
	}

	// systemCertFiles are the bundles a system keeps its trusted roots in,
	// the first that exists being read.
	internal const systemCertFiles = [
		"/etc/ssl/certs/ca-certificates.crt", // Debian, Ubuntu, Alpine
		"/etc/pki/tls/certs/ca-bundle.crt", // Fedora, RHEL
		"/etc/ssl/ca-bundle.pem", // openSUSE
		"/etc/pki/tls/cacert.pem", // OpenELEC
		"/etc/ssl/cert.pem", // macOS, FreeBSD, Alpine
		"/usr/local/share/certs/ca-root-nss.crt", // FreeBSD ports
	]

	internal let systemRoots ?CertPool = none

	// systemCertPool returns the pool of the system's trusted roots, read
	// once from the first bundle in systemCertFiles that exists. Fails when
	// no bundle exists or none holds a certificate.
	def systemCertPool() !CertPool {
		let cached = systemRoots
		return cached unless cached is none
		// Read to verify a peer for the caller, so a policy that asks about file
		// reads does not ask about the bundles.
		Policy.registerResources("adm.storage.read", systemCertFiles) onerror recover none

		let pool = new CertPool()
		for let (_, path) in systemCertFiles {
			let present = os.exists(path) onerror recover false
			continue unless present
			let text = os.readFile(path) onerror recover []
			continue when text.len() == 0
			break when pool.appendCertsFromPEM(string(text))
		}
		fail CertificateError{message: "x509: no system root certificates found", reason: InvalidReason.UnknownAuthority} when pool.len() == 0
		systemRoots = pool
		return pool
	}
}
