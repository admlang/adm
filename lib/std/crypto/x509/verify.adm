partial module std.crypto.x509 {
	use (
		std.time
		std.time::(Time)
		std.crypto::(PublicKey, RSAPublicKey, ECDSAPublicKey, parseECDSASignature)
		std.crypto.hash::(Hash, hashSize, digest)
		std.data.encoding::(ASN1Tag, asn1Parse)
	)

	// VerifyOptions steers Certificate.verify.
	struct VerifyOptions {
		// The host name the leaf must be valid for; empty skips the check.
		dnsName                  string        = ""
		// Certificates that may sit between the leaf and a root.
		intermediates            ?CertPool
		// Trusted roots; none means the system pool.
		roots                    ?CertPool
		// The time validity is checked at; none means now.
		currentTime              ?Time
		// Extended key usages the chain must allow; empty means ServerAuth.
		// ExtKeyUsage.Any accepts every chain.
		keyUsages                ExtKeyUsage[] = []
		// Bound on the work name constraints may take.
		maxConstraintComparisons int           = 250000
	}

	// hashOf is the digest a signature algorithm hashes with; none for an
	// algorithm not supported here.
	def hashOf(algorithm SignatureAlgorithm) ?Hash {
		match algorithm {
			case SignatureAlgorithm.MD5WithRSA:
				return Hash.MD5
			case SignatureAlgorithm.SHA1WithRSA:
				return Hash.SHA1
			case SignatureAlgorithm.ECDSAWithSHA1:
				return Hash.SHA1
			case SignatureAlgorithm.SHA256WithRSA:
				return Hash.SHA256
			case SignatureAlgorithm.ECDSAWithSHA256:
				return Hash.SHA256
			case SignatureAlgorithm.SHA256WithRSAPSS:
				return Hash.SHA256
			case SignatureAlgorithm.SHA384WithRSA:
				return Hash.SHA384
			case SignatureAlgorithm.ECDSAWithSHA384:
				return Hash.SHA384
			case SignatureAlgorithm.SHA384WithRSAPSS:
				return Hash.SHA384
			case SignatureAlgorithm.SHA512WithRSA:
				return Hash.SHA512
			case SignatureAlgorithm.ECDSAWithSHA512:
				return Hash.SHA512
			case SignatureAlgorithm.SHA512WithRSAPSS:
				return Hash.SHA512
			default:
				return none
		}
	}

	// isInsecureAlgorithm reports whether the algorithm is refused for
	// verification: MD5 and SHA-1 signatures.
	def isInsecureAlgorithm(algorithm SignatureAlgorithm) bool {
		return algorithm := SignatureAlgorithm.MD5WithRSA || SignatureAlgorithm.SHA1WithRSA || SignatureAlgorithm.ECDSAWithSHA1
	}

	// isRSAPSS reports whether the algorithm is an RSA-PSS scheme.
	def isRSAPSS(algorithm SignatureAlgorithm) bool {
		return algorithm := SignatureAlgorithm.SHA256WithRSAPSS || SignatureAlgorithm.SHA384WithRSAPSS || SignatureAlgorithm.SHA512WithRSAPSS
	}

	// verifySignature verifies that signature is a valid signature over
	// signed by the public key, under the algorithm. Fails with reason
	// BadSignature when it does not verify, UnsupportedAlgorithm for an
	// algorithm not implemented, insecure (MD5, SHA-1) or not matching the
	// key type.
	def verifySignature(algorithm SignatureAlgorithm, signed, signature byte[], key PublicKey) !none {
		fail CertificateError{message: "x509: cannot verify signature: insecure algorithm {algorithm}", reason: InvalidReason.UnsupportedAlgorithm} when isInsecureAlgorithm(algorithm)
		let hash = hashOf(algorithm)
		fail CertificateError{message: "x509: cannot verify signature: algorithm {algorithm} is not supported", reason: InvalidReason.UnsupportedAlgorithm} when hash is none
		let sum = digest(hash, signed)
		if key is RSAPublicKey {
			let rsa RSAPublicKey = key
			fail CertificateError{message: "x509: signature algorithm {algorithm} does not match an RSA key", reason: InvalidReason.UnsupportedAlgorithm} unless isRSAAlgorithm(algorithm)
			let ok = false
			if isRSAPSS(algorithm) {
				ok = rsa.verifyPSS(hash, sum, signature, hashSize(hash))
			} else {
				ok = rsa.verifyPKCS1v15(hash, sum, signature)
			}
			fail CertificateError{message: "x509: RSA signature verification failed", reason: InvalidReason.BadSignature} unless ok
			return none
		}
		if key is ECDSAPublicKey {
			let ec ECDSAPublicKey = key
			fail CertificateError{message: "x509: signature algorithm {algorithm} does not match an ECDSA key", reason: InvalidReason.UnsupportedAlgorithm} unless isECDSAAlgorithm(algorithm)
			// ECDSA-Sig-Value ::= SEQUENCE { r INTEGER, s INTEGER }
			let (r, s) = parseECDSASignature(signature) onerror fail CertificateError{message: "x509: ECDSA signature is not a DER SEQUENCE of two INTEGERs", reason: InvalidReason.BadSignature}
			fail CertificateError{message: "x509: ECDSA signature verification failed", reason: InvalidReason.BadSignature} unless ec.verify(sum, r, s)
			return none
		}
		fail CertificateError{message: "x509: certificates of an Ed25519 key are not supported", reason: InvalidReason.UnsupportedAlgorithm}
	}

	internal def isRSAAlgorithm(algorithm SignatureAlgorithm) bool {
		return isRSAPSS(algorithm) || (algorithm := SignatureAlgorithm.SHA256WithRSA || SignatureAlgorithm.SHA384WithRSA || SignatureAlgorithm.SHA512WithRSA)
	}

	internal def isECDSAAlgorithm(algorithm SignatureAlgorithm) bool {
		return algorithm := SignatureAlgorithm.ECDSAWithSHA256 || SignatureAlgorithm.ECDSAWithSHA384 || SignatureAlgorithm.ECDSAWithSHA512
	}

	// verifyTime is the options' current time, or now.
	internal def verifyTime(opts VerifyOptions) Time {
		let current = opts.currentTime
		return time.now() when current is none
		return current
	}

	// verifyRoots is the options' roots, or the system pool. Fails when
	// neither is available.
	internal def verifyRoots(opts VerifyOptions) !CertPool {
		let roots = opts.roots
		return try systemCertPool() when roots is none
		return roots
	}

	// verifyIntermediates is the options' intermediates, or an empty pool.
	internal def verifyIntermediates(opts VerifyOptions) CertPool {
		let pool = opts.intermediates
		return new CertPool() when pool is none
		return pool
	}

	// CertKind is the position of a certificate in a chain being built.
	enum CertKind {
		Leaf,
		Intermediate,
		Root
	}

	internal const maxChainDepth = 100

	internal def chainContains(chain Certificate[], cert Certificate) bool {
		for let (_, link) in chain {
			return true when link.equals(cert)
		}
		return false
	}

	// chainAllowsUsage reports whether every certificate of the chain
	// allows one of the usages; a certificate without the extension allows
	// all, and Any allows all.
	internal def chainAllowsUsage(chain Certificate[], usages ExtKeyUsage[]) bool {
		for let (_, cert) in chain {
			continue when cert.extKeyUsage.len() == 0 && cert.unknownExtKeyUsage.len() == 0
			let allowed = false
			for let (_, usage) in cert.extKeyUsage {
				allowed = true when usage == ExtKeyUsage.Any
				for let (_, wanted) in usages {
					allowed = true when usage == wanted
					// Netscape and Microsoft server-gated crypto count as server auth.
					allowed = true when wanted == ExtKeyUsage.ServerAuth && (usage == ExtKeyUsage.NetscapeServerGatedCrypto || usage == ExtKeyUsage.MicrosoftServerGatedCrypto)
				}
			}
			return false unless allowed
		}
		return true
	}

	// matchHostnames reports whether a lower-cased host matches a
	// certificate name: label for label, `*` as the pattern's first label
	// matching any one label.
	def matchHostnames(pattern string, host string) bool {
		let candidate = toLowerASCII(pattern)
		candidate = candidate[:candidate.len() - 1] when candidate.endsWith(".")
		return false when candidate == "" || host == ""
		let patternLabels = candidate.split(".")
		let hostLabels = host.split(".")
		return false when patternLabels.len() != hostLabels.len()
		for let i = 0; i < patternLabels.len(); i++ {
			continue when i == 0 && patternLabels[i] == "*"
			return false when patternLabels[i] != hostLabels[i]
		}
		return true
	}

	// matchDomainConstraint reports whether a domain fits a DNS constraint:
	// a constraint with a leading dot matches subdomains only, one without
	// matches the domain itself and its subdomains.
	def matchDomainConstraint(domain string, constraint string) bool {
		return true when constraint == ""
		let d = toLowerASCII(domain)
		let c = toLowerASCII(constraint)
		d = d[:d.len() - 1] when d.endsWith(".")
		return d.len() > c.len() && d.endsWith(c) when c.startsWith(".")
		return d == c || d.endsWith("." + c)
	}

	// matchEmailConstraint reports whether a mailbox fits an email
	// constraint: a whole mailbox, a domain, or a `.domain` suffix.
	def matchEmailConstraint(email string, constraint string) bool {
		return toLowerASCII(email) == toLowerASCII(constraint) when constraint.contains("@")
		let parts = email.split("@")
		return false when parts.len() < 2
		return matchDomainConstraint(parts[parts.len() - 1], constraint)
	}

	// matchURIConstraint reports whether the host of a URI fits a domain
	// constraint; URIs with an IP address host never match.
	def matchURIConstraint(uri string, constraint string) bool {
		let host = uriHost(uri)
		return false when host == ""
		return false when host.startsWith("[") || !(parseIPText(host) is none)
		return matchDomainConstraint(host, constraint)
	}

	// uriHost is the host of a URI with an authority, without the port.
	internal def uriHost(uri string) string {
		let start = uri.indexOf("//")
		return "" when start < 0
		let rest = uri[start + 2:]
		let end = rest.indexOf("/")
		rest = rest[:end] when end >= 0
		let parts = rest.split("@")
		rest = parts[parts.len() - 1]
		return rest when rest.startsWith("[")
		let colon = rest.indexOf(":")
		rest = rest[:colon] when colon >= 0
		return rest
	}

	// ipInRange reports whether the address lies in the range; lengths
	// must agree (an IPv4 address never fits an IPv6 range).
	def ipInRange(address byte[], range IPNet) bool {
		return false when address.len() != range.ip.len() || range.mask.len() != range.ip.len()
		for let i = 0; i < address.len(); i++ {
			return false when (address[i] & range.mask[i]) != (range.ip[i] & range.mask[i])
		}
		return true
	}

	internal def ipNetText(range IPNet) string {
		return ipText(range.ip) + "/" + ipText(range.mask)
	}

	// toLowerASCII lowers the ASCII letters and leaves other bytes alone,
	// which is what host name comparison needs.
	internal def toLowerASCII(text string) string {
		let bytes = text.bytes()
		for let i = 0; i < bytes.len(); i++ {
			bytes[i] += 32 when bytes[i] >= 0x41 && bytes[i] <= 0x5a
		}
		return string(bytes)
	}

	// parseIPText reads a dotted IPv4 or an IPv6 text into 4 or 16 bytes;
	// none when it is neither.
	def parseIPText(text string) ?byte[] {
		return parseIPv6Text(text) when text.contains(":")
		let parts = text.split(".")
		return none when parts.len() != 4
		let out byte[]
		for let (_, part) in parts {
			return none when part == "" || part.len() > 3 || !part.isNumeric()
			let n = part.toInt<int>()
			return none when n > 255
			out.push(byte(n))
		}
		return out
	}

	internal def parseIPv6Text(text string) ?byte[] {
		let head string[]
		let tail string[]
		let gap = text.indexOf("::")
		if gap < 0 {
			head = text.split(":")
		} else {
			return none when text.indexOf("::", gap + 1) >= 0
			head = text[:gap].split(":") when gap > 0
			tail = text[gap + 2:].split(":") when gap + 2 < text.len()
		}
		let groups int[]
		let headGroups = ipv6Groups(head)
		let tailGroups = ipv6Groups(tail)
		return none when headGroups is none
		return none when tailGroups is none
		let missing = 8 - headGroups.len() - tailGroups.len()
		return none when missing < 0 || (gap < 0 && missing != 0) || (gap >= 0 && missing == 0)
		for let (_, g) in headGroups {
			groups.push(g)
		}
		for let i = 0; i < missing; i++ {
			groups.push(0)
		}
		for let (_, g) in tailGroups {
			groups.push(g)
		}
		let out byte[]
		for let (_, g) in groups {
			out.push(byte(g >> 8))
			out.push(byte(g & 0xff))
		}
		return out
	}

	// ipv6Groups reads hex groups, expanding an embedded dotted IPv4 in
	// the last position into two groups; none on a malformed group.
	internal def ipv6Groups(parts string[]) ?int[] {
		let out int[]
		for let i = 0; i < parts.len(); i++ {
			let part = parts[i]
			if i == parts.len() - 1 && part.contains(".") {
				let v4 = parseIPText(part)
				return none when v4 is none || v4.len() != 4
				out.push(int(v4[0]) << 8 | int(v4[1]))
				out.push(int(v4[2]) << 8 | int(v4[3]))
				continue
			}
			return none when part == "" || part.len() > 4
			let value = 0
			for let (_, c) in part {
				return none unless c.isHexDigit()
				value = value * 16 + c.digitValue(16)
			}
			out.push(value)
		}
		return out
	}

	// ipText renders 4 bytes dotted and 16 bytes as IPv6 with the longest
	// zero run compressed.
	def ipText(address byte[]) string {
		return "{int(address[0])}.{int(address[1])}.{int(address[2])}.{int(address[3])}" when address.len() == 4
		return "?" + address.hex() when address.len() != 16
		let groups int[]
		for let i = 0; i < 16; i += 2 {
			groups.push(int(address[i]) << 8 | int(address[i + 1]))
		}
		// Longest run of zero groups, two or more, gets "::".
		let bestStart = -1
		let bestLen = 0
		for let i = 0; i < 8; i++ {
			continue when groups[i] != 0
			let j = i
			for j < 8 && groups[j] == 0 {
				j++
			}
			if j - i > bestLen && j - i >= 2 {
				bestStart = i
				bestLen = j - i
			}
			i = j
		}
		let out = ""
		for let i = 0; i < 8; i++ {
			if i == bestStart {
				out += "::"
				i += bestLen - 1
				continue
			}
			out += ":" when out != "" && !out.endsWith(":")
			out += groups[i].toRadix(16).lower()
		}
		return out
	}
}
