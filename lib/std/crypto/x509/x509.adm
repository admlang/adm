// std.crypto.x509 parses and verifies X.509 certificates (RFC 5280): the
// fields TLS needs, signature checks with the keys of std.crypto, host name
// matching, and chain building against a pool of roots.

partial module std.crypto.x509 {
	use (
		std.errors
		std.time
		std.time::(Time)
		std.crypto
		std.crypto::(PublicKey, RSAPublicKey, parsePKIXPublicKey, constantTimeEqual, oidRSAEncryption, oidECPublicKey, oidEd25519)
		std.data.encoding
		std.data.encoding::(ASN1Element, ASN1Tag, ASN1Class, OID, asn1Parse, asn1ParseAll, asn1Null, pemDecodeAll)
	)

	// CertificateError is the payload of every failure in this module. The
	// reason says what a caller can act on: an unknown authority, an
	// expired certificate, a host name that does not match.
	struct CertificateError {
		message string
		code    string            = "x509"
		cause   ?error
		stack   errors.StackTrace
		reason  InvalidReason     = InvalidReason.Malformed
		// The certificate the failure is about, when there is one.
		cert    ?Certificate
	}

	// InvalidReason classifies a CertificateError.
	enum InvalidReason {
		// The DER does not parse or breaks the profile.
		Malformed,
		// A certificate signed another but is not a CA.
		NotAuthorizedToSign,
		// The current time is outside the validity period.
		Expired,
		// A name constraint refuses a name of the leaf.
		CANotAuthorizedForThisName,
		// A path length constraint was exceeded.
		TooManyIntermediates,
		// The chain does not allow the requested extended key usage.
		IncompatibleUsage,
		// The host name matches no name of the certificate.
		NameMismatch,
		// A signature does not verify.
		BadSignature,
		// The signature or key algorithm is not supported, or is insecure.
		UnsupportedAlgorithm,
		// No chain leads to a trusted root.
		UnknownAuthority,
		// Chain building gave up on size.
		TooManyConstraints
	}

	// SignatureAlgorithm names the algorithm a certificate is signed with.
	enum SignatureAlgorithm {
		Unknown,
		MD5WithRSA,
		SHA1WithRSA,
		SHA256WithRSA,
		SHA384WithRSA,
		SHA512WithRSA,
		ECDSAWithSHA1,
		ECDSAWithSHA256,
		ECDSAWithSHA384,
		ECDSAWithSHA512,
		SHA256WithRSAPSS,
		SHA384WithRSAPSS,
		SHA512WithRSAPSS,
		Ed25519
	}

	// PublicKeyAlgorithm names the algorithm of a certificate's key.
	enum PublicKeyAlgorithm {
		Unknown,
		RSA,
		ECDSA,
		Ed25519
	}

	// KeyUsage bits, as the key usage extension packs them; a certificate's
	// `keyUsage` is their bitwise or.
	enum KeyUsage {
		DigitalSignature = 1,
		ContentCommitment = 2,
		KeyEncipherment = 4,
		DataEncipherment = 8,
		KeyAgreement = 16,
		CertSign = 32,
		CRLSign = 64,
		EncipherOnly = 128,
		DecipherOnly = 256
	}

	// ExtKeyUsage is a purpose from the extended key usage extension.
	enum ExtKeyUsage {
		Any,
		ServerAuth,
		ClientAuth,
		CodeSigning,
		EmailProtection,
		IPSECEndSystem,
		IPSECTunnel,
		IPSECUser,
		TimeStamping,
		OCSPSigning,
		MicrosoftServerGatedCrypto,
		NetscapeServerGatedCrypto,
		MicrosoftCommercialCodeSigning,
		MicrosoftKernelCodeSigning
	}

	// Extension is one certificate extension as it arrived: the OID, the
	// critical flag and the DER value.
	struct Extension {
		id       OID
		critical bool
		value    byte[]
	}

	// IPNet is an IP range of a name constraint: an address and a mask of
	// the same length, 4 bytes or 16.
	struct IPNet {
		ip   byte[]
		mask byte[]
	}

	// Certificate is a parsed X.509 certificate. The raw fields keep the DER
	// of the parts a verifier compares or hashes; the rest is decoded.
	//
	// Example:
	// ```example
	// let cert = try parseCertificate(block.bytes)
	// try cert.verifyHostname("adm.test")
	// let chains = try cert.verify(VerifyOptions{dnsName: "adm.test", roots: roots})
	// ```
	type Certificate {
		// The whole certificate, the TBSCertificate the signature covers,
		// the subject and issuer names as encoded, and the
		// SubjectPublicKeyInfo.
		raw        byte[]
		rawTBS     byte[]
		rawSubject byte[]
		rawIssuer  byte[]
		rawSPKI    byte[]

		signature          byte[]
		signatureAlgorithm SignatureAlgorithm = SignatureAlgorithm.Unknown
		publicKeyAlgorithm PublicKeyAlgorithm = PublicKeyAlgorithm.Unknown
		// The key, when its algorithm is supported.
		publicKey          ?PublicKey

		version      int
		serialNumber bigint
		issuer       Name
		subject      Name
		notBefore    Time
		notAfter     Time
		keyUsage     int

		// Every extension, in order, and the critical ones this parser
		// does not understand; `verify` refuses a certificate with any.
		extensions                  Extension[]
		unhandledCriticalExtensions OID[]

		extKeyUsage        ExtKeyUsage[]
		unknownExtKeyUsage OID[]

		basicConstraintsValid bool
		isCA                  bool
		// The path length constraint, -1 when there is none; zero is
		// told apart from absent by maxPathLenZero.
		maxPathLen            int  = -1
		maxPathLenZero        bool

		subjectKeyId   byte[]
		authorityKeyId byte[]

		// Authority information access.
		ocspServer            string[]
		issuingCertificateURL string[]

		// Subject alternative names. IP addresses are 4 or 16 bytes.
		dnsNames       string[]
		emailAddresses string[]
		ipAddresses    byte[][]
		uris           string[]

		// Name constraints.
		permittedDNSDomainsCritical bool
		permittedDNSDomains         string[]
		excludedDNSDomains          string[]
		permittedIPRanges           IPNet[]
		excludedIPRanges            IPNet[]
		permittedEmailAddresses     string[]
		excludedEmailAddresses      string[]
		permittedURIDomains         string[]
		excludedURIDomains          string[]

		crlDistributionPoints string[]
		policyIdentifiers     OID[]

		def new() {}

		// equals reports whether both certificates are byte for byte the
		// same.
		def equals(other Certificate) bool {
			return constantTimeEqual(raw, other.raw)
		}

		// hasSANExtension reports whether the certificate carries a subject
		// alternative name extension.
		def hasSANExtension() bool {
			for let (_, ext) in extensions {
				return true when ext.id.equals(oidExtSubjectAltName)
			}
			return false
		}

		// hasNameConstraints reports whether the certificate constrains the
		// names of the certificates it signs.
		def hasNameConstraints() bool {
			return permittedDNSDomains.len() + excludedDNSDomains.len() + permittedIPRanges.len() + excludedIPRanges.len() + permittedEmailAddresses.len() + excludedEmailAddresses.len() + permittedURIDomains.len() + excludedURIDomains.len() > 0
		}

		// signedBy verifies that the parent signed this certificate. Fails with NotAuthorizedToSign when the parent is not
		// a CA or lacks the certSign key usage, UnsupportedAlgorithm when
		// the parent's key algorithm is unknown, BadSignature otherwise.
		def signedBy(parent Certificate) !none {
			// RFC 5280 4.2.1.9: a version 3 CA needs the basic constraints
			// extension; earlier versions are trusted as CAs.
			fail CertificateError{message: "x509: {parent.subject.str()} is not a certificate authority", reason: InvalidReason.NotAuthorizedToSign, cert: parent} when parent.version == 3 && !parent.basicConstraintsValid || (parent.basicConstraintsValid && !parent.isCA)
			fail CertificateError{message: "x509: {parent.subject.str()} may not sign certificates", reason: InvalidReason.NotAuthorizedToSign, cert: parent} when parent.keyUsage != 0 && (parent.keyUsage & int(KeyUsage.CertSign)) == 0
			let key = parent.publicKey
			fail CertificateError{message: "x509: {parent.subject.str()} has an unsupported public key algorithm", reason: InvalidReason.UnsupportedAlgorithm, cert: parent} when key is none
			try verifySignature(signatureAlgorithm, rawTBS, signature, key)
		}

		// checkSignature verifies a signature made with this certificate's
		// key. Fails as verifySignature does, and with UnsupportedAlgorithm
		// when the key algorithm is unknown.
		def checkSignature(algorithm SignatureAlgorithm, signed, signature byte[]) !none {
			let key = publicKey
			fail CertificateError{message: "x509: {subject.str()} has an unsupported public key algorithm", reason: InvalidReason.UnsupportedAlgorithm, cert: self} when key is none
			try verifySignature(algorithm, signed, signature, key)
		}

		// verifyHostname checks that the certificate is valid for the host:
		// an IP address must be among the IP subject alternative names, a
		// name must match a DNS subject alternative name, where `*` as the
		// leftmost label matches one label. Fails with NameMismatch.
		def verifyHostname(host string) !none {
			let candidate = host
			candidate = candidate[1:candidate.len() - 1] when candidate.startsWith("[") && candidate.endsWith("]")
			let ip = parseIPText(candidate)
			if ip is none {
				let lowered = toLowerASCII(candidate)
				lowered = lowered[:lowered.len() - 1] when lowered.endsWith(".")
				for let (_, name) in dnsNames {
					return none when matchHostnames(name, lowered)
				}
			} else {
				for let (_, address) in ipAddresses {
					return none when constantTimeEqual(address, ip)
				}
			}
			let names string[]
			for let (_, name) in dnsNames {
				names.push(name)
			}
			for let (_, address) in ipAddresses {
				names.push(ipText(address))
			}
			fail CertificateError{message: "x509: certificate is not valid for any names, but wanted to match {host}", reason: InvalidReason.NameMismatch, cert: self} when names.len() == 0
			fail CertificateError{message: "x509: certificate is valid for " + names.join(", ") + ", not {host}", reason: InvalidReason.NameMismatch, cert: self}
		}

		// verify builds every chain from this certificate to a root in the
		// options (the system pool by default) through the intermediates,
		// checking signatures, validity at the current time, basic
		// constraints, path lengths, name constraints and the requested
		// extended key usages, and the host name when one is given. Returns
		// the chains, leaf first; fails with the reason of the last chain
		// that could not be completed, UnknownAuthority when none started.
		def verify(opts VerifyOptions) !Certificate[][] {
			fail CertificateError{message: "x509: certificate has an unhandled critical extension {unhandledCriticalExtensions[0].str()}", reason: InvalidReason.Malformed, cert: self} when unhandledCriticalExtensions.len() > 0
			try verifyHostname(opts.dnsName) when opts.dnsName != ""
			let now = verifyTime(opts)
			let roots = try verifyRoots(opts)
			let intermediates = verifyIntermediates(opts)
			let budget = [opts.maxConstraintComparisons]
			try isValid(CertKind.Leaf, [], now, budget)
			let chains Certificate[][]
			if roots.contains(self) {
				chains.push([self])
			} else {
				chains = try buildChains([self], roots, intermediates, now, budget)
			}
			let usages = opts.keyUsages
			usages = [ExtKeyUsage.ServerAuth] when usages.len() == 0
			for let (_, usage) in usages {
				return chains when usage == ExtKeyUsage.Any
			}
			let allowed Certificate[][]
			for let (_, chain) in chains {
				allowed.push(chain) when chainAllowsUsage(chain, usages)
			}
			fail CertificateError{message: "x509: certificate specifies an incompatible key usage", reason: InvalidReason.IncompatibleUsage, cert: self} when allowed.len() == 0
			return allowed
		}

		// isValid checks the certificate as a link of the chain being
		// built: the current time lies in its validity, a CA has the basic
		// constraints for it, its path length allows the intermediates
		// below it, and its name constraints accept every name of the
		// certificates below it.
		internal def isValid(kind CertKind, currentChain Certificate[], now Time, budget int[]) !none {
			fail CertificateError{message: "x509: certificate has expired or is not yet valid: current time {now.str()} is not within " + notBefore.str() + " to " + notAfter.str(), reason: InvalidReason.Expired, cert: self} when now.before(notBefore) || now.after(notAfter)
			if kind == CertKind.Intermediate || kind == CertKind.Root {
				fail CertificateError{message: "x509: {subject.str()} is not a certificate authority", reason: InvalidReason.NotAuthorizedToSign, cert: self} when version == 3 && !basicConstraintsValid || (basicConstraintsValid && !isCA)
			}
			fail CertificateError{message: "x509: too many intermediates for path length constraint of {subject.str()}", reason: InvalidReason.TooManyIntermediates, cert: self} when kind == CertKind.Intermediate && maxPathLen >= 0 && currentChain.len() - 1 > maxPathLen
			return none unless hasNameConstraints()
			// Every certificate below this one must fit the constraints.
			for let (_, child) in currentChain {
				try checkNameConstraints(child, budget)
			}
		}

		// checkNameConstraints checks the names of a certificate below this
		// one against this one's constraints.
		internal def checkNameConstraints(child Certificate, budget int[]) !none {
			for let (_, name) in child.dnsNames {
				try checkConstraint(child, "DNS name", name, permittedDNSDomains, excludedDNSDomains, budget, matchDomainConstraint)
			}
			for let (_, email) in child.emailAddresses {
				try checkConstraint(child, "email address", email, permittedEmailAddresses, excludedEmailAddresses, budget, matchEmailConstraint)
			}
			for let (_, uri) in child.uris {
				try checkConstraint(child, "URI", uri, permittedURIDomains, excludedURIDomains, budget, matchURIConstraint)
			}
			for let (_, address) in child.ipAddresses {
				try checkIPConstraint(child, address, budget)
			}
		}

		internal def checkConstraint(child Certificate, kind string, name string, permitted, excluded string[], budget int[], matcher def (string, string) bool) !none {
			budget[0] -= permitted.len() + excluded.len()
			fail CertificateError{message: "x509: too many constraints to check", reason: InvalidReason.TooManyConstraints, cert: self} when budget[0] < 0
			for let (_, constraint) in excluded {
				fail CertificateError{message: "x509: {kind} \"{name}\" is excluded by constraint \"{constraint}\" of {subject.str()}", reason: InvalidReason.CANotAuthorizedForThisName, cert: child} when matcher(name, constraint)
			}
			return none when permitted.len() == 0
			for let (_, constraint) in permitted {
				return none when matcher(name, constraint)
			}
			fail CertificateError{message: "x509: {kind} \"{name}\" is not permitted by any constraint of {subject.str()}", reason: InvalidReason.CANotAuthorizedForThisName, cert: child}
		}

		internal def checkIPConstraint(child Certificate, address byte[], budget int[]) !none {
			budget[0] -= permittedIPRanges.len() + excludedIPRanges.len()
			fail CertificateError{message: "x509: too many constraints to check", reason: InvalidReason.TooManyConstraints, cert: self} when budget[0] < 0
			for let (_, range) in excludedIPRanges {
				fail CertificateError{message: "x509: IP address {ipText(address)} is excluded by constraint " + ipNetText(range) + " of {subject.str()}", reason: InvalidReason.CANotAuthorizedForThisName, cert: child} when ipInRange(address, range)
			}
			return none when permittedIPRanges.len() == 0
			for let (_, range) in permittedIPRanges {
				return none when ipInRange(address, range)
			}
			fail CertificateError{message: "x509: IP address {ipText(address)} is not permitted by any constraint of {subject.str()}", reason: InvalidReason.CANotAuthorizedForThisName, cert: child}
		}

		// buildChains extends the chain (leaf first, this certificate last)
		// with every candidate parent: roots complete a chain, intermediates
		// recurse. Fails with the last error when no chain completes.
		internal def buildChains(currentChain Certificate[], roots, intermediates CertPool, now Time, budget int[]) !Certificate[][] {
			let chains Certificate[][]
			let lastError ?error = none
			fail CertificateError{message: "x509: chain is too deep", reason: InvalidReason.TooManyIntermediates, cert: self} when currentChain.len() > maxChainDepth
			for let (_, root) in roots.findPotentialParents(self) {
				let ok = considerCandidate(CertKind.Root, root, currentChain, now, budget) onerror (err error) {
					lastError = err
					recover false
				}
				chains.push(currentChain + [root]) when ok
			}
			for let (_, intermediate) in intermediates.findPotentialParents(self) {
				continue when chainContains(currentChain, intermediate)
				let ok = considerCandidate(CertKind.Intermediate, intermediate, currentChain, now, budget) onerror (err error) {
					lastError = err
					recover false
				}
				continue unless ok
				let more = intermediate.buildChains(currentChain + [intermediate], roots, intermediates, now, budget) onerror (err error) {
					lastError = err
					recover []
				}
				for let (_, chain) in more {
					chains.push(chain)
				}
			}
			return chains when chains.len() > 0
			fail lastError unless lastError is none
			fail CertificateError{message: "x509: certificate signed by unknown authority (issuer {issuer.str()})", reason: InvalidReason.UnknownAuthority, cert: self}
		}

		// considerCandidate checks a parent as a link: its signature over
		// this certificate and its validity for the chain so far.
		internal def considerCandidate(kind CertKind, candidate Certificate, currentChain Certificate[], now Time, budget int[]) !bool {
			try signedBy(candidate)
			try candidate.isValid(kind, currentChain, now, budget)
			return true
		}
	}

	let (
		// oidSignatureMD5WithRSA is md5WithRSAEncryption.
		oidSignatureMD5WithRSA      = new OID([1, 2, 840, 113549, 1, 1, 4])
		// oidSignatureSHA1WithRSA is sha1WithRSAEncryption.
		oidSignatureSHA1WithRSA     = new OID([1, 2, 840, 113549, 1, 1, 5])
		// oidSignatureSHA256WithRSA is sha256WithRSAEncryption.
		oidSignatureSHA256WithRSA   = new OID([1, 2, 840, 113549, 1, 1, 11])
		// oidSignatureSHA384WithRSA is sha384WithRSAEncryption.
		oidSignatureSHA384WithRSA   = new OID([1, 2, 840, 113549, 1, 1, 12])
		// oidSignatureSHA512WithRSA is sha512WithRSAEncryption.
		oidSignatureSHA512WithRSA   = new OID([1, 2, 840, 113549, 1, 1, 13])
		// oidSignatureRSAPSS is id-RSASSA-PSS.
		oidSignatureRSAPSS          = new OID([1, 2, 840, 113549, 1, 1, 10])
		// oidSignatureECDSAWithSHA1 is ecdsa-with-SHA1.
		oidSignatureECDSAWithSHA1   = new OID([1, 2, 840, 10045, 4, 1])
		// oidSignatureECDSAWithSHA256 is ecdsa-with-SHA256.
		oidSignatureECDSAWithSHA256 = new OID([1, 2, 840, 10045, 4, 3, 2])
		// oidSignatureECDSAWithSHA384 is ecdsa-with-SHA384.
		oidSignatureECDSAWithSHA384 = new OID([1, 2, 840, 10045, 4, 3, 3])
		// oidSignatureECDSAWithSHA512 is ecdsa-with-SHA512.
		oidSignatureECDSAWithSHA512 = new OID([1, 2, 840, 10045, 4, 3, 4])
		// oidSignatureEd25519 is id-Ed25519.
		oidSignatureEd25519         = new OID([1, 3, 101, 112])
		// oidMGF1 is id-mgf1.
		oidMGF1                     = new OID([1, 2, 840, 113549, 1, 1, 8])
		// oidSHA256 is id-sha256.
		oidSHA256                   = new OID([2, 16, 840, 1, 101, 3, 4, 2, 1])
		// oidSHA384 is id-sha384.
		oidSHA384                   = new OID([2, 16, 840, 1, 101, 3, 4, 2, 2])
		// oidSHA512 is id-sha512.
		oidSHA512                   = new OID([2, 16, 840, 1, 101, 3, 4, 2, 3])

		// oidExtSubjectKeyId is the subject key identifier extension.
		oidExtSubjectKeyId            = new OID([2, 5, 29, 14])
		// oidExtKeyUsage is the key usage extension.
		oidExtKeyUsage                = new OID([2, 5, 29, 15])
		// oidExtSubjectAltName is the subject alternative name extension.
		oidExtSubjectAltName          = new OID([2, 5, 29, 17])
		// oidExtBasicConstraints is the basic constraints extension.
		oidExtBasicConstraints        = new OID([2, 5, 29, 19])
		// oidExtNameConstraints is the name constraints extension.
		oidExtNameConstraints         = new OID([2, 5, 29, 30])
		// oidExtCRLDistributionPoints is the CRL distribution points extension.
		oidExtCRLDistributionPoints   = new OID([2, 5, 29, 31])
		// oidExtCertificatePolicies is the certificate policies extension.
		oidExtCertificatePolicies     = new OID([2, 5, 29, 32])
		// oidExtAuthorityKeyId is the authority key identifier extension.
		oidExtAuthorityKeyId          = new OID([2, 5, 29, 35])
		// oidExtExtendedKeyUsage is the extended key usage extension.
		oidExtExtendedKeyUsage        = new OID([2, 5, 29, 37])
		// oidExtAuthorityInfoAccess is the authority information access extension.
		oidExtAuthorityInfoAccess     = new OID([1, 3, 6, 1, 5, 5, 7, 1, 1])
		// oidAuthorityInfoAccessOCSP is the OCSP access method.
		oidAuthorityInfoAccessOCSP    = new OID([1, 3, 6, 1, 5, 5, 7, 48, 1])
		// oidAuthorityInfoAccessIssuers is the CA issuers access method.
		oidAuthorityInfoAccessIssuers = new OID([1, 3, 6, 1, 5, 5, 7, 48, 2])

		// oidExtKeyUsageAny is anyExtendedKeyUsage.
		oidExtKeyUsageAny                            = new OID([2, 5, 29, 37, 0])
		// oidExtKeyUsageServerAuth is id-kp-serverAuth.
		oidExtKeyUsageServerAuth                     = new OID([1, 3, 6, 1, 5, 5, 7, 3, 1])
		// oidExtKeyUsageClientAuth is id-kp-clientAuth.
		oidExtKeyUsageClientAuth                     = new OID([1, 3, 6, 1, 5, 5, 7, 3, 2])
		// oidExtKeyUsageCodeSigning is id-kp-codeSigning.
		oidExtKeyUsageCodeSigning                    = new OID([1, 3, 6, 1, 5, 5, 7, 3, 3])
		// oidExtKeyUsageEmailProtection is id-kp-emailProtection.
		oidExtKeyUsageEmailProtection                = new OID([1, 3, 6, 1, 5, 5, 7, 3, 4])
		// oidExtKeyUsageIPSECEndSystem is id-kp-ipsecEndSystem.
		oidExtKeyUsageIPSECEndSystem                 = new OID([1, 3, 6, 1, 5, 5, 7, 3, 5])
		// oidExtKeyUsageIPSECTunnel is id-kp-ipsecTunnel.
		oidExtKeyUsageIPSECTunnel                    = new OID([1, 3, 6, 1, 5, 5, 7, 3, 6])
		// oidExtKeyUsageIPSECUser is id-kp-ipsecUser.
		oidExtKeyUsageIPSECUser                      = new OID([1, 3, 6, 1, 5, 5, 7, 3, 7])
		// oidExtKeyUsageTimeStamping is id-kp-timeStamping.
		oidExtKeyUsageTimeStamping                   = new OID([1, 3, 6, 1, 5, 5, 7, 3, 8])
		// oidExtKeyUsageOCSPSigning is id-kp-OCSPSigning.
		oidExtKeyUsageOCSPSigning                    = new OID([1, 3, 6, 1, 5, 5, 7, 3, 9])
		// oidExtKeyUsageMicrosoftServerGatedCrypto is Microsoft server gated crypto.
		oidExtKeyUsageMicrosoftServerGatedCrypto     = new OID([1, 3, 6, 1, 4, 1, 311, 10, 3, 3])
		// oidExtKeyUsageNetscapeServerGatedCrypto is Netscape server gated crypto.
		oidExtKeyUsageNetscapeServerGatedCrypto      = new OID([2, 16, 840, 1, 113730, 4, 1])
		// oidExtKeyUsageMicrosoftCommercialCodeSigning is Microsoft commercial code signing.
		oidExtKeyUsageMicrosoftCommercialCodeSigning = new OID([1, 3, 6, 1, 4, 1, 311, 2, 1, 22])
		// oidExtKeyUsageMicrosoftKernelCodeSigning is Microsoft kernel code signing.
		oidExtKeyUsageMicrosoftKernelCodeSigning     = new OID([1, 3, 6, 1, 4, 1, 311, 61, 1, 1])
	)

	// extKeyUsageFromOID maps an extended key usage OID to the enum; none
	// for one not listed.
	def extKeyUsageFromOID(oid OID) ?ExtKeyUsage {
		return ExtKeyUsage.Any when oid.equals(oidExtKeyUsageAny)
		return ExtKeyUsage.ServerAuth when oid.equals(oidExtKeyUsageServerAuth)
		return ExtKeyUsage.ClientAuth when oid.equals(oidExtKeyUsageClientAuth)
		return ExtKeyUsage.CodeSigning when oid.equals(oidExtKeyUsageCodeSigning)
		return ExtKeyUsage.EmailProtection when oid.equals(oidExtKeyUsageEmailProtection)
		return ExtKeyUsage.IPSECEndSystem when oid.equals(oidExtKeyUsageIPSECEndSystem)
		return ExtKeyUsage.IPSECTunnel when oid.equals(oidExtKeyUsageIPSECTunnel)
		return ExtKeyUsage.IPSECUser when oid.equals(oidExtKeyUsageIPSECUser)
		return ExtKeyUsage.TimeStamping when oid.equals(oidExtKeyUsageTimeStamping)
		return ExtKeyUsage.OCSPSigning when oid.equals(oidExtKeyUsageOCSPSigning)
		return ExtKeyUsage.MicrosoftServerGatedCrypto when oid.equals(oidExtKeyUsageMicrosoftServerGatedCrypto)
		return ExtKeyUsage.NetscapeServerGatedCrypto when oid.equals(oidExtKeyUsageNetscapeServerGatedCrypto)
		return ExtKeyUsage.MicrosoftCommercialCodeSigning when oid.equals(oidExtKeyUsageMicrosoftCommercialCodeSigning)
		return ExtKeyUsage.MicrosoftKernelCodeSigning when oid.equals(oidExtKeyUsageMicrosoftKernelCodeSigning)
		return none
	}

	// signatureAlgorithmFromElement reads an AlgorithmIdentifier. RSA-PSS
	// is recognised only in the profile of RFC 4055 that TLS uses: MGF1
	// over the same hash as the signature and a salt as long as the hash.
	// Fails when the element is not an AlgorithmIdentifier.
	def signatureAlgorithmFromElement(algorithm ASN1Element) !SignatureAlgorithm {
		let oid = try (try algorithm.at(0)).asOID()
		return SignatureAlgorithm.MD5WithRSA when oid.equals(oidSignatureMD5WithRSA)
		return SignatureAlgorithm.SHA1WithRSA when oid.equals(oidSignatureSHA1WithRSA)
		return SignatureAlgorithm.SHA256WithRSA when oid.equals(oidSignatureSHA256WithRSA)
		return SignatureAlgorithm.SHA384WithRSA when oid.equals(oidSignatureSHA384WithRSA)
		return SignatureAlgorithm.SHA512WithRSA when oid.equals(oidSignatureSHA512WithRSA)
		return SignatureAlgorithm.ECDSAWithSHA1 when oid.equals(oidSignatureECDSAWithSHA1)
		return SignatureAlgorithm.ECDSAWithSHA256 when oid.equals(oidSignatureECDSAWithSHA256)
		return SignatureAlgorithm.ECDSAWithSHA384 when oid.equals(oidSignatureECDSAWithSHA384)
		return SignatureAlgorithm.ECDSAWithSHA512 when oid.equals(oidSignatureECDSAWithSHA512)
		return SignatureAlgorithm.Ed25519 when oid.equals(oidSignatureEd25519)
		return SignatureAlgorithm.Unknown unless oid.equals(oidSignatureRSAPSS)
		// RSASSA-PSS-params ::= SEQUENCE { hashAlgorithm [0], maskGenAlgorithm [1],
		// saltLength [2], trailerField [3] }.
		return SignatureAlgorithm.Unknown when algorithm.children.len() < 2
		let params = try algorithm.at(1)
		let hashField = params.tagged(0)
		let maskField = params.tagged(1)
		let saltField = params.tagged(2)
		return SignatureAlgorithm.Unknown when hashField is none
		return SignatureAlgorithm.Unknown when maskField is none
		return SignatureAlgorithm.Unknown when saltField is none
		let hashOID = try (try (try hashField.inner()).at(0)).asOID()
		let mask = try maskField.inner()
		let maskOID = try (try mask.at(0)).asOID()
		return SignatureAlgorithm.Unknown unless maskOID.equals(oidMGF1)
		let maskHashOID = try (try (try mask.at(1)).at(0)).asOID()
		return SignatureAlgorithm.Unknown unless maskHashOID.equals(hashOID)
		let saltLength = try (try saltField.inner()).asInt()
		return SignatureAlgorithm.SHA256WithRSAPSS when hashOID.equals(oidSHA256) && saltLength == 32
		return SignatureAlgorithm.SHA384WithRSAPSS when hashOID.equals(oidSHA384) && saltLength == 48
		return SignatureAlgorithm.SHA512WithRSAPSS when hashOID.equals(oidSHA512) && saltLength == 64
		return SignatureAlgorithm.Unknown
	}

	// parseCertificate reads one DER certificate. Fails, with reason
	// Malformed, when the DER does not parse or breaks the RFC 5280
	// profile (a negative serial number, a version above 3, a repeated
	// extension, an empty subject on a CA, a malformed known extension).
	def parseCertificate(der byte[]) !Certificate {
		let failure ?error = none
		let top = asn1Parse(der) onerror (err error) {
			failure = err
			recover asn1Null()
		}
		fail CertificateError{message: "x509: certificate is not DER: " + failure.message} unless failure is none
		return try parseCertificateElement(top)
	}

	// parseCertificates reads every certificate of a DER concatenation, as
	// a TLS Certificate message or a bundle carries them. Fails like
	// parseCertificate.
	def parseCertificates(der byte[]) !Certificate[] {
		let failure ?error = none
		let elements = asn1ParseAll(der) onerror (err error) {
			failure = err
			recover []
		}
		fail CertificateError{message: "x509: certificates are not DER: " + failure.message} unless failure is none
		let out Certificate[]
		for let (_, element) in elements {
			out.push(try parseCertificateElement(element))
		}
		return out
	}

	// parseCertificatesPEM reads every "CERTIFICATE" block of the text,
	// skipping blocks of other kinds. Fails when a block is malformed PEM
	// or a certificate does not parse.
	def parseCertificatesPEM(text string) !Certificate[] {
		let failure ?error = none
		let blocks = pemDecodeAll(text) onerror (err error) {
			failure = err
			recover []
		}
		fail CertificateError{message: "x509: " + failure.message} unless failure is none
		let out Certificate[]
		for let (_, block) in blocks {
			out.push(try parseCertificate(block.bytes)) when block.kind == "CERTIFICATE"
		}
		return out
	}

	internal def malformed(text string) CertificateError {
		return CertificateError{message: "x509: " + text}
	}

	internal def parseCertificateElement(top ASN1Element) !Certificate {
		fail malformed("certificate is not a SEQUENCE") unless top.isTag(ASN1Tag.Sequence) && top.children.len() == 3
		let cert = new Certificate()
		cert.raw = top.raw
		let tbs = try top.at(0)
		fail malformed("TBSCertificate is not a SEQUENCE") unless tbs.isTag(ASN1Tag.Sequence)
		cert.rawTBS = tbs.raw
		// Outer signature algorithm, and the signature bits.
		cert.signatureAlgorithm = try signatureAlgorithmFromElement(try top.at(1))
		let signature = try (try top.at(2)).asBitString()
		fail malformed("signature BIT STRING has padding bits") when signature.bitLength % 8 != 0
		cert.signature = signature.bytes

		let index = 0
		let first = try tbs.at(0)
		cert.version = 1
		if first.isContext(0) {
			let version = try (try first.inner()).asInt()
			fail malformed("version {version} is out of range") when version < 0 || version > 2
			cert.version = version + 1
			index = 1
		}
		cert.serialNumber = try (try tbs.at(index)).asBigInt()
		fail malformed("serial number is negative") when cert.serialNumber.sign() < 0
		// The inner algorithm must agree with the outer one.
		let innerAlgorithm = try signatureAlgorithmFromElement(try tbs.at(index + 1))
		fail malformed("signature algorithms of the certificate and its TBSCertificate differ") when innerAlgorithm != cert.signatureAlgorithm
		let issuer = try tbs.at(index + 2)
		cert.rawIssuer = issuer.raw
		cert.issuer = try parseName(issuer)
		let validity = try tbs.at(index + 3)
		cert.notBefore = try (try validity.at(0)).asTime()
		cert.notAfter = try (try validity.at(1)).asTime()
		let subject = try tbs.at(index + 4)
		cert.rawSubject = subject.raw
		cert.subject = try parseName(subject)
		let spki = try tbs.at(index + 5)
		cert.rawSPKI = spki.raw
		try parsePublicKey(cert, spki)
		// [1] and [2] unique identifiers are skipped; [3] holds the extensions.
		let extensions = tbs.tagged(3)
		fail malformed("extensions in a version {cert.version} certificate") unless cert.version >= 3 || extensions is none
		try parseExtensions(cert, extensions) unless extensions is none
		return cert
	}

	internal def parsePublicKey(cert Certificate, spki ASN1Element) !none {
		let algorithm = try spki.at(0)
		let oid = try (try algorithm.at(0)).asOID()
		if oid.equals(oidRSAEncryption) {
			cert.publicKeyAlgorithm = PublicKeyAlgorithm.RSA
		} else if oid.equals(oidECPublicKey) {
			cert.publicKeyAlgorithm = PublicKeyAlgorithm.ECDSA
		} else if oid.equals(oidEd25519) {
			cert.publicKeyAlgorithm = PublicKeyAlgorithm.Ed25519
			return none
		} else {
			return none
		}
		let failure ?error = none
		let key = parsePKIXPublicKey(spki.raw) onerror (err error) {
			failure = err
			recover new RSAPublicKey(bigint(0), 0)
		}
		fail CertificateError{message: failure.message} unless failure is none
		cert.publicKey = key
	}

	internal def parseExtensions(cert Certificate, tagged ASN1Element) !none {
		let list = try tagged.inner()
		fail malformed("extensions are not a SEQUENCE") unless list.isTag(ASN1Tag.Sequence)
		for let (_, item) in list.children {
			fail malformed("extension is not a SEQUENCE") unless item.isTag(ASN1Tag.Sequence) && item.children.len() >= 2
			let id = try (try item.at(0)).asOID()
			let critical = false
			let valueIndex = 1
			if (try item.at(1)).isTag(ASN1Tag.Boolean) {
				critical = try (try item.at(1)).asBool()
				valueIndex = 2
			}
			let value = try (try item.at(valueIndex)).asBytes()
			for let (_, seen) in cert.extensions {
				fail malformed("extension {id.str()} appears twice") when seen.id.equals(id)
			}
			cert.extensions.push(Extension{id: id, critical: critical, value: value})
			let handled = try parseExtension(cert, id, critical, value)
			cert.unhandledCriticalExtensions.push(id) when critical && !handled
		}
	}

	// parseExtension decodes one known extension into the certificate and
	// reports whether it was known.
	internal def parseExtension(cert Certificate, id OID, critical bool, value byte[]) !bool {
		let failure ?error = none
		let body = asn1Parse(value) onerror (err error) {
			failure = err
			recover asn1Null()
		}
		fail CertificateError{message: "x509: extension {id.str()}: " + failure.message} unless failure is none
		if id.equals(oidExtKeyUsage) {
			let bits = try body.asBitString()
			let usage = 0
			for let i = 0; i < 9; i++ {
				usage |= 1 << i when bits.at(i) == 1
			}
			cert.keyUsage = usage
			return true
		}
		if id.equals(oidExtBasicConstraints) {
			fail malformed("basic constraints are not a SEQUENCE") unless body.isTag(ASN1Tag.Sequence)
			cert.basicConstraintsValid = true
			cert.isCA = false
			cert.maxPathLen = -1
			let index = 0
			if body.children.len() > 0 && (try body.at(0)).isTag(ASN1Tag.Boolean) {
				cert.isCA = try (try body.at(0)).asBool()
				index = 1
			}
			if body.children.len() > index {
				cert.maxPathLen = try (try body.at(index)).asInt()
				fail malformed("path length constraint is negative") when cert.maxPathLen < 0
				cert.maxPathLenZero = cert.maxPathLen == 0
			}
			return true
		}
		if id.equals(oidExtSubjectAltName) {
			try parseSANs(cert, body)
			fail malformed("subject alternative name is empty") when cert.dnsNames.len() + cert.emailAddresses.len() + cert.ipAddresses.len() + cert.uris.len() == 0 && body.children.len() == 0
			return true
		}
		if id.equals(oidExtNameConstraints) {
			try parseNameConstraints(cert, body, critical)
			return true
		}
		if id.equals(oidExtCRLDistributionPoints) {
			// DistributionPoint ::= SEQUENCE { distributionPoint [0] DistributionPointName OPTIONAL, ... }
			// DistributionPointName ::= CHOICE { fullName [0] GeneralNames, ... }
			for let (_, point) in body.children {
				let name = point.tagged(0)
				continue when name is none
				let full = name.tagged(0)
				continue when full is none
				for let (_, general) in full.children {
					cert.crlDistributionPoints.push(try ia5Of(general)) when general.isContext(6)
				}
			}
			return true
		}
		if id.equals(oidExtAuthorityKeyId) {
			let keyId = body.tagged(0)
			cert.authorityKeyId = keyId.content unless keyId is none
			return true
		}
		if id.equals(oidExtExtendedKeyUsage) {
			for let (_, item) in body.children {
				let usageOID = try item.asOID()
				let usage = extKeyUsageFromOID(usageOID)
				if usage is none {
					cert.unknownExtKeyUsage.push(usageOID)
				} else {
					cert.extKeyUsage.push(usage)
				}
			}
			return true
		}
		if id.equals(oidExtSubjectKeyId) {
			cert.subjectKeyId = try body.asBytes()
			return true
		}
		if id.equals(oidExtCertificatePolicies) {
			for let (_, policy) in body.children {
				cert.policyIdentifiers.push(try (try policy.at(0)).asOID())
			}
			return true
		}
		if id.equals(oidExtAuthorityInfoAccess) {
			for let (_, access) in body.children {
				let method = try (try access.at(0)).asOID()
				let location = try access.at(1)
				continue unless location.isContext(6)
				let url = try ia5Of(location)
				cert.ocspServer.push(url) when method.equals(oidAuthorityInfoAccessOCSP)
				cert.issuingCertificateURL.push(url) when method.equals(oidAuthorityInfoAccessIssuers)
			}
			return true
		}
		return false
	}

	// ia5Of reads the text of an implicitly tagged IA5String GeneralName.
	internal def ia5Of(general ASN1Element) !string {
		for let (_, b) in general.content {
			fail malformed("name holds a byte outside ASCII") when b >= 0x80
		}
		return string(general.content)
	}

	// parseSANs reads GeneralNames: [1] email, [2] DNS, [6] URI, [7] IP.
	internal def parseSANs(cert Certificate, names ASN1Element) !none {
		for let (_, general) in names.children {
			fail malformed("subject alternative name is not context-specific") when general.class != ASN1Class.ContextSpecific
			switch {
				case general.tag == 1:
					let email = try ia5Of(general)
					fail malformed("empty email address in subject alternative name") when email == ""
					cert.emailAddresses.push(email)
				case general.tag == 2:
					let name = try ia5Of(general)
					fail malformed("subject alternative name \"{name}\" is not a valid host name") unless isValidDomainPattern(name)
					cert.dnsNames.push(name)
				case general.tag == 6:
					let uri = try ia5Of(general)
					fail malformed("subject alternative name \"{uri}\" is not a URI") when uri == "" || !uri.contains(":")
					cert.uris.push(uri)
				case general.tag == 7:
					fail malformed("IP address in subject alternative name has {general.content.len()} bytes") unless general.content.len() == 4 || general.content.len() == 16
					cert.ipAddresses.push(general.content)
			}
		}
	}

	// parseNameConstraints reads permitted [0] and excluded [1]
	// GeneralSubtrees.
	internal def parseNameConstraints(cert Certificate, body ASN1Element, critical bool) !none {
		fail malformed("name constraints are not a SEQUENCE") unless body.isTag(ASN1Tag.Sequence)
		fail malformed("name constraints are empty") when body.children.len() == 0
		cert.permittedDNSDomainsCritical = critical
		let permitted = body.tagged(0)
		try parseSubtrees(cert, permitted, true) unless permitted is none
		let excluded = body.tagged(1)
		try parseSubtrees(cert, excluded, false) unless excluded is none
	}

	internal def parseSubtrees(cert Certificate, subtrees ASN1Element, permitted bool) !none {
		for let (_, subtree) in subtrees.children {
			let general = try subtree.at(0)
			fail malformed("name constraint is not context-specific") when general.class != ASN1Class.ContextSpecific
			switch {
				case general.tag == 2:
					let domain = try ia5Of(general)
					let trimmed = domain
					trimmed = trimmed[1:] when trimmed.startsWith(".")
					fail malformed("name constraint \"{domain}\" is not a domain") when trimmed != "" && !isValidDomainPattern(trimmed)
					if permitted {
						cert.permittedDNSDomains.push(domain)
					} else {
						cert.excludedDNSDomains.push(domain)
					}
				case general.tag == 7:
					let bytes = general.content
					fail malformed("IP name constraint has {bytes.len()} bytes") unless bytes.len() == 8 || bytes.len() == 32
					let half = bytes.len() / 2
					let net = IPNet{ip: bytes[0:half], mask: bytes[half:]}
					if permitted {
						cert.permittedIPRanges.push(net)
					} else {
						cert.excludedIPRanges.push(net)
					}
				case general.tag == 1:
					let email = try ia5Of(general)
					if permitted {
						cert.permittedEmailAddresses.push(email)
					} else {
						cert.excludedEmailAddresses.push(email)
					}
				case general.tag == 6:
					let domain = try ia5Of(general)
					fail malformed("URI name constraint \"{domain}\" is not a domain") when domain.contains(":") || domain.contains("/")
					if permitted {
						cert.permittedURIDomains.push(domain)
					} else {
						cert.excludedURIDomains.push(domain)
					}
			}
		}
	}

	// isValidDomainPattern accepts a host name, or one whose leftmost label
	// is `*`: labels of letters, digits and hyphens, dots between them.
	internal def isValidDomainPattern(name string) bool {
		let text = name
		text = text[:text.len() - 1] when text.endsWith(".")
		return false when text == "" || text.len() > 253
		let labels = text.split(".")
		for let i = 0; i < labels.len(); i++ {
			let label = labels[i]
			return false when label == "" || label.len() > 63
			continue when i == 0 && label == "*"
			for let (_, c) in label {
				return false unless c.isAlphanumeric() || c == '-' || c == '_'
			}
		}
		return true
	}
}
