		internal def cert(pem string) Certificate {
			let block = pemDecode(pem) onerror recover new PEMBlock("", [])
			return parseCertificate(block.bytes) onerror recover new Certificate()
		}

		internal def asECKey(key PublicKey) ECDSAPublicKey {
			if key is ECDSAPublicKey {
				let ec ECDSAPublicKey = key
				return ec
			}
			return new ECDSAPublicKey(p256, infinity())
		}

		internal def asEC(key ?PublicKey) ECDSAPublicKey {
			return new ECDSAPublicKey(p256, infinity()) when key is none
			return asECKey(key)
		}

		internal def at(text string) Time {
			return time.parse(text) onerror recover new Time()
		}

		internal def reasonOf(err error) InvalidReason {
			return err.reason when err is CertificateError
			return InvalidReason.Malformed
		}

		// mismatchMessage is the NameMismatch message for a host, "" when
		// the host verifies or fails for another reason.
		internal def mismatchMessage(leaf Certificate, host string) string {
			let message = ""
			leaf.verifyHostname(host) onerror (err error) {
				message = err.message when reasonOf(err) == InvalidReason.NameMismatch
				recover none
			}
			return message
		}

		internal def verifyReason(leaf Certificate, opts VerifyOptions) string {
			let chains = leaf.verify(opts) onerror (err error) {
				recover [[leaf, leaf, leaf, leaf]]
			}
			return "ok" when chains.len() == 1 && chains[0].len() < 4
			let reason = ""
			leaf.verify(opts) onerror (err error) {
				reason = reasonOf(err).str()
				recover []
			}
			return reason
		}

		@test()
		def TestParseLeaf() !none {
			let leaf = cert(leafPEM)
			assert leaf.version == 3
			assert leaf.serialNumber == bigint(3)
			assert leaf.subject.commonName == "adm.test"
			assert leaf.subject.organization[0] == "ADM Test" && leaf.subject.country[0] == "GB"
			assert leaf.subject.str() == "CN=adm.test,ST=England,L=London,OU=Dev,O=ADM Test,C=GB"
			assert leaf.issuer.commonName == "ADM Test Intermediate"
			assert leaf.notBefore.str() == "2026-09-16T17:55:10Z"
			assert leaf.notAfter.str() == "2034-12-03T17:55:10Z"
			assert leaf.signatureAlgorithm == SignatureAlgorithm.ECDSAWithSHA256
			assert leaf.publicKeyAlgorithm == PublicKeyAlgorithm.ECDSA
			assert asEC(leaf.publicKey).curve.name == "P-256"
			assert leaf.keyUsage == int(KeyUsage.DigitalSignature) | int(KeyUsage.KeyEncipherment)
			assert leaf.extKeyUsage.len() == 2 && leaf.extKeyUsage[0] == ExtKeyUsage.ServerAuth && leaf.extKeyUsage[1] == ExtKeyUsage.ClientAuth
			assert leaf.basicConstraintsValid && !leaf.isCA && leaf.maxPathLen == -1
			assert leaf.dnsNames.len() == 2 && leaf.dnsNames[0] == "adm.test" && leaf.dnsNames[1] == "*.adm.test"
			assert leaf.ipAddresses.len() == 2 && ipText(leaf.ipAddresses[0]) == "127.0.0.1" && ipText(leaf.ipAddresses[1]) == "::1"
			assert leaf.emailAddresses.len() == 1 && leaf.emailAddresses[0] == "dev@adm.test"
			assert leaf.uris.len() == 1 && leaf.uris[0] == "https://adm.test/"
			assert leaf.crlDistributionPoints.len() == 1 && leaf.crlDistributionPoints[0] == "http://crl.adm.test/root.crl"
			assert leaf.ocspServer.len() == 1 && leaf.ocspServer[0] == "http://ocsp.adm.test/"
			assert leaf.issuingCertificateURL.len() == 1 && leaf.issuingCertificateURL[0] == "http://ca.adm.test/inter.der"
			assert leaf.policyIdentifiers.len() == 1 && leaf.policyIdentifiers[0].equals("2.5.29.32.0")
			assert leaf.subjectKeyId.hex() == "774B2BEFE4041E0680DBD6D775A6BA22F6519378"
			assert leaf.authorityKeyId.hex() == "E4C8C2BDD23D6AEBD046C721202B85B092D849BD"
			assert leaf.extensions.len() == 9
			assert leaf.unhandledCriticalExtensions.len() == 0
			assert leaf.hasSANExtension() && !leaf.hasNameConstraints()
			assert leaf.rawTBS.len() > 0 && leaf.rawSubject.len() > 0 && leaf.rawIssuer.hex() == cert(intermediatePEM).rawSubject.hex()
		}

		@test()
		def TestParseAuthorities() !none {
			let inter = cert(intermediatePEM)
			assert inter.isCA && inter.maxPathLen == 0 && inter.maxPathLenZero
			assert inter.keyUsage == int(KeyUsage.CertSign) | int(KeyUsage.CRLSign)
			assert inter.signatureAlgorithm == SignatureAlgorithm.ECDSAWithSHA384
			assert asEC(inter.publicKey).curve.name == "P-384"
			assert inter.hasNameConstraints() && inter.permittedDNSDomainsCritical == false
			assert inter.permittedDNSDomains.len() == 2 && inter.permittedDNSDomains[0] == ".adm.test" && inter.permittedDNSDomains[1] == "adm.test"
			assert inter.permittedEmailAddresses.len() == 1 && inter.permittedEmailAddresses[0] == "adm.test"
			assert inter.permittedIPRanges.len() == 2 && ipText(inter.permittedIPRanges[0].ip) == "127.0.0.0" && ipText(inter.permittedIPRanges[0].mask) == "255.0.0.0"
			assert inter.excludedDNSDomains.len() == 0
			let root = cert(rootPEM)
			assert root.serialNumber == bigint(1) && root.isCA && root.maxPathLen == -1 && !root.maxPathLenZero
			assert root.notBefore.str() == "2026-01-01T00:00:00Z" && root.notAfter.str() == "2046-01-01T00:00:00Z"
			assert root.subject.str() == root.issuer.str()
			assert root.rawSubject.hex() == root.rawIssuer.hex()
			let rsa = cert(rsaPEM)
			assert rsa.signatureAlgorithm == SignatureAlgorithm.SHA256WithRSA && rsa.publicKeyAlgorithm == PublicKeyAlgorithm.RSA
			assert rsa.dnsNames.len() == 0 && !rsa.hasSANExtension()
			let pss = cert(rsaPSSPEM)
			assert pss.signatureAlgorithm == SignatureAlgorithm.SHA256WithRSAPSS
			let outer = try (try asn1Parse(pss.raw)).at(1)
			assert (try signatureAlgorithmFromElement(outer)) == SignatureAlgorithm.SHA256WithRSAPSS
		}

		@test()
		def TestSignatures() !none {
			let root = cert(rootPEM)
			let inter = cert(intermediatePEM)
			let leaf = cert(leafPEM)
			try leaf.signedBy(inter)
			try inter.signedBy(root)
			try root.signedBy(root)
			try cert(rsaPEM).signedBy(cert(rsaPEM))
			try cert(rsaPSSPEM).signedBy(cert(rsaPSSPEM))
			let wrongParent = InvalidReason.Malformed
			leaf.signedBy(root) onerror (err error) {
				wrongParent = reasonOf(err)
				recover none
			}
			assert wrongParent == InvalidReason.BadSignature
			// A leaf is not a CA.
			let notCA = InvalidReason.Malformed
			inter.signedBy(leaf) onerror (err error) {
				notCA = reasonOf(err)
				recover none
			}
			assert notCA == InvalidReason.NotAuthorizedToSign
			// Tampered content fails.
			let tampered = leaf.rawTBS.clone()
			tampered[tampered.len() - 1] ^= 1
			let bad = InvalidReason.Malformed
			inter.checkSignature(leaf.signatureAlgorithm, tampered, leaf.signature) onerror (err error) {
				bad = reasonOf(err)
				recover none
			}
			assert bad == InvalidReason.BadSignature
			// SHA-1 is refused before any arithmetic.
			let insecure = InvalidReason.Malformed
			inter.checkSignature(SignatureAlgorithm.ECDSAWithSHA1, leaf.rawTBS, leaf.signature) onerror (err error) {
				insecure = reasonOf(err)
				recover none
			}
			assert insecure == InvalidReason.UnsupportedAlgorithm
			let (r, s) = try parseECDSASignature(leaf.signature)
			let rsaKey = cert(rsaPEM).publicKey
			fail "no RSA key" when rsaKey is none
			try verifySignature(SignatureAlgorithm.SHA256WithRSA, cert(rsaPEM).rawTBS, cert(rsaPEM).signature, rsaKey)
			let mismatch = InvalidReason.Malformed
			verifySignature(SignatureAlgorithm.ECDSAWithSHA256, cert(rsaPEM).rawTBS, cert(rsaPEM).signature, rsaKey) onerror (err error) {
				mismatch = reasonOf(err)
				recover none
			}
			assert mismatch == InvalidReason.UnsupportedAlgorithm
			assert r.sign() > 0 && s.sign() > 0
		}

		@test()
		def TestVerifyHostname() !none {
			let leaf = cert(leafPEM)
			try leaf.verifyHostname("adm.test")
			try leaf.verifyHostname("www.adm.test")
			try leaf.verifyHostname("ADM.Test.")
			try leaf.verifyHostname("127.0.0.1")
			try leaf.verifyHostname("[::1]")
			try leaf.verifyHostname("0:0:0:0:0:0:0:1")
			let cases = ["a.b.adm.test", "adm.tests", "10.0.0.1", "example.com", ""]
			for let (_, host) in cases {
				assert mismatchMessage(leaf, host).contains("adm.test, *.adm.test, 127.0.0.1, ::1")
			}
			let sha256 = hashOf(SignatureAlgorithm.ECDSAWithSHA256)
			fail "no hash" when sha256 is none
			assert hashOf(SignatureAlgorithm.Unknown) is none
			assert isInsecureAlgorithm(SignatureAlgorithm.SHA1WithRSA) && !isInsecureAlgorithm(SignatureAlgorithm.SHA256WithRSA)
			assert isRSAPSS(SignatureAlgorithm.SHA384WithRSAPSS) && !isRSAPSS(SignatureAlgorithm.SHA384WithRSA)
			let noNames = ""
			cert(rsaPEM).verifyHostname("rsa.adm.test") onerror (err error) {
				noNames = err.message
				recover none
			}
			assert noNames == "x509: certificate is not valid for any names, but wanted to match rsa.adm.test"
			assert matchHostnames("*.adm.test", "x.adm.test") && !matchHostnames("*.adm.test", "adm.test") && !matchHostnames("x*.adm.test", "xy.adm.test")
		}

		@test()
		def TestVerifyChains() !none {
			let root = cert(rootPEM)
			let inter = cert(intermediatePEM)
			let leaf = cert(leafPEM)
			let roots = new CertPool()
			roots.addCert(root)
			let intermediates = new CertPool()
			intermediates.addCert(inter)
			let opts = VerifyOptions{roots: roots, intermediates: intermediates, currentTime: at("2027-01-01T00:00:00Z"), dnsName: "www.adm.test"}
			let chains = try leaf.verify(opts)
			assert chains.len() == 1 && chains[0].len() == 3
			assert chains[0][0].equals(leaf) && chains[0][1].equals(inter) && chains[0][2].equals(root)
			// A root verifies to itself.
			let rootChains = try root.verify(VerifyOptions{roots: roots, currentTime: at("2027-01-01T00:00:00Z")})
			assert rootChains.len() == 1 && rootChains[0].len() == 1
			// Client auth is allowed too, any is always allowed, code signing is not.
			assert verifyReason(leaf, VerifyOptions{roots: roots, intermediates: intermediates, currentTime: at("2027-01-01T00:00:00Z"), keyUsages: [ExtKeyUsage.ClientAuth]}) == "ok"
			assert verifyReason(leaf, VerifyOptions{roots: roots, intermediates: intermediates, currentTime: at("2027-01-01T00:00:00Z"), keyUsages: [ExtKeyUsage.Any]}) == "ok"
			assert verifyReason(leaf, VerifyOptions{roots: roots, intermediates: intermediates, currentTime: at("2027-01-01T00:00:00Z"), keyUsages: [ExtKeyUsage.CodeSigning]}) == "IncompatibleUsage"
			// Validity.
			assert verifyReason(leaf, VerifyOptions{roots: roots, intermediates: intermediates, currentTime: at("2026-06-01T00:00:00Z")}) == "Expired"
			assert verifyReason(leaf, VerifyOptions{roots: roots, intermediates: intermediates, currentTime: at("2035-06-01T00:00:00Z")}) == "Expired"
			// Missing links.
			assert verifyReason(leaf, VerifyOptions{roots: roots, currentTime: at("2027-01-01T00:00:00Z")}) == "UnknownAuthority"
			let wrongRoots = new CertPool()
			wrongRoots.addCert(cert(rsaPEM))
			assert verifyReason(leaf, VerifyOptions{roots: wrongRoots, intermediates: intermediates, currentTime: at("2027-01-01T00:00:00Z")}) == "UnknownAuthority"
			// Host name.
			assert verifyReason(leaf, VerifyOptions{roots: roots, intermediates: intermediates, currentTime: at("2027-01-01T00:00:00Z"), dnsName: "other.example"}) == "NameMismatch"
			// Name constraints: other.example is outside the intermediate's permitted domains.
			let other = cert(otherPEM)
			assert verifyReason(other, VerifyOptions{roots: roots, intermediates: intermediates, currentTime: at("2027-01-01T00:00:00Z")}) == "CANotAuthorizedForThisName"
			// The intermediate has pathlen 0, so nothing may sit below it but a leaf: a chain
			// leaf -> inter -> inter would be a loop and is never built.
			let selfSigned = new CertPool()
			selfSigned.addCert(cert(rsaPEM))
			let rsaChains = try cert(rsaPEM).verify(VerifyOptions{roots: selfSigned, currentTime: at("2027-01-01T00:00:00Z"), keyUsages: [ExtKeyUsage.Any]})
			assert rsaChains.len() == 1
		}

		@test()
		def TestPools() !none {
			let pool = new CertPool()
			assert pool.appendCertsFromPEM(rootPEM + "junk between\n" + intermediatePEM)
			assert pool.len() == 2
			assert !pool.appendCertsFromPEM("no certificates here")
			pool.addCert(cert(rootPEM))
			assert pool.len() == 2
			assert pool.contains(cert(rootPEM)) && !pool.contains(cert(leafPEM))
			let parents = pool.findPotentialParents(cert(leafPEM))
			assert parents.len() == 1 && parents[0].subject.commonName == "ADM Test Intermediate"
			assert pool.findPotentialParents(cert(rsaPEM)).len() == 0
			let both = try parseCertificatesPEM(rootPEM + intermediatePEM + leafPEM + rsaPrivateKeyPEM)
			assert both.len() == 3
			let der = try parseCertificates(cert(leafPEM).raw + cert(rootPEM).raw)
			assert der.len() == 2 && der[1].equals(cert(rootPEM))
			// The system pool is whatever this machine has; it only has to load.
			let system = systemCertPool() onerror recover new CertPool()
			assert system.len() >= 0
		}

		@test()
		def TestNamesAndConstraints() !none {
			let subject = try parseName(try asn1Parse(cert(leafPEM).rawSubject))
			assert subject.commonName == "adm.test" && subject.names.len() == 6
			let name = new Name()
			assert name.isEmpty()
			name.names.push(AttributeTypeValue{oid: try parseOID("2.5.4.3"), value: "a,b #x "})
			name.names.push(AttributeTypeValue{oid: try parseOID("1.2.3.4"), value: "v"})
			assert name.str() == "1.2.3.4=v,CN=a\\,b #x\\ "
			assert attributeName(try parseOID("2.5.4.6")) == "C" && attributeName(try parseOID("1.2.3.4")) == "1.2.3.4"
			let serverAuth = extKeyUsageFromOID(try parseOID("1.3.6.1.5.5.7.3.1"))
			fail "serverAuth" when serverAuth is none
			assert serverAuth == ExtKeyUsage.ServerAuth && extKeyUsageFromOID(try parseOID("1.2.3.4")) is none
			assert matchDomainConstraint("www.adm.test", ".adm.test") && !matchDomainConstraint("adm.test", ".adm.test")
			assert matchDomainConstraint("adm.test", "adm.test") && matchDomainConstraint("www.adm.test", "adm.test") && !matchDomainConstraint("notadm.test", "adm.test")
			assert matchEmailConstraint("dev@adm.test", "adm.test") && matchEmailConstraint("dev@adm.test", "dev@adm.test") && !matchEmailConstraint("dev@adm.test", "ops@adm.test")
			assert matchURIConstraint("https://www.adm.test:8443/x", "adm.test") && !matchURIConstraint("https://127.0.0.1/", "adm.test") && !matchURIConstraint("mailto:x", "adm.test")
			let v4 = parseIPText("192.168.1.10")
			fail "v4" when v4 is none
			assert v4.hex() == "C0A8010A" && ipText(v4) == "192.168.1.10"
			let v6 = parseIPText("2001:db8::ff00:42:8329")
			fail "v6" when v6 is none
			assert v6.hex() == "20010DB8000000000000FF0000428329" && ipText(v6) == "2001:db8::ff00:42:8329"
			let mapped = parseIPText("::ffff:192.0.2.1")
			fail "mapped" when mapped is none
			assert mapped.hex() == "00000000000000000000FFFFC0000201"
			assert parseIPText("1.2.3") is none && parseIPText("1::2::3") is none && parseIPText("1.2.3.256") is none && parseIPText("adm.test") is none
			assert ipInRange(v4, IPNet{ip: byte[192, 168, 0, 0], mask: byte[255, 255, 0, 0]})
			assert !ipInRange(v4, IPNet{ip: byte[10, 0, 0, 0], mask: byte[255, 0, 0, 0]})
			assert !ipInRange(v6, IPNet{ip: byte[192, 168, 0, 0], mask: byte[255, 255, 0, 0]})
		}

		@test()
		def TestMalformed() {
			let blank = parseCertificate([]) onerror recover new Certificate()
			assert blank.raw.len() == 0
			let truncated = parseCertificate(cert(leafPEM).raw[0:100]) onerror recover new Certificate()
			assert truncated.raw.len() == 0
			let reason = InvalidReason.Expired
			parseCertificate(byte[0x30, 0x03, 0x02, 0x01, 0x01]) onerror (err error) {
				reason = reasonOf(err)
				recover new Certificate()
			}
			assert reason == InvalidReason.Malformed
		}
	}
}
