partial module std.data.collections {
	// Node of an AVL tree.
	internal type AVLNode<T> {
		value  T
		left   ?AVLNode<T>
		right  ?AVLNode<T>
		height int

		def new(value T) {
			self.value = value
			height = 1
		}
	}

	// AVLTree is a self-balancing binary search tree of distinct values.
	//
	// Every operation is O(log n). Iteration yields values in ascending
	// order.
	type AVLTree<T: Ordered> {
		internal root     ?AVLNode<T>
		internal count    int
		internal snapshot T[]
		internal cur      int

		def new() {}

		// Creates a tree holding values.
		def new(values T[]) {
			for let (_, v) in values {
				insert(v)
			}
		}

		// Returns the number of values.
		def len() int {
			return count
		}

		// Reports whether the tree holds no values.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every value.
		def clear() {
			root = none
			count = 0
		}

		// Adds value. Returns false when it was already present.
		def insert(value T) bool {
			let before = count
			root = insertInto(root, value)
			return count > before
		}

		// Removes value. Returns false when it was absent.
		def remove(value T) bool {
			let before = count
			root = removeFrom(root, value)
			return count < before
		}

		// Reports whether value is present.
		def has(value T) bool {
			let node = root
			for {
				let n = node
				return false when n is none
				return true when n.value == value
				node = value < n.value ?? (n.left, n.right)
			}
			return false
		}

		// Returns the smallest value, or none when empty.
		def min() ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				best = n.value
				node = n.left
			}
			return best
		}

		// Returns the largest value, or none when empty.
		def max() ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				best = n.value
				node = n.right
			}
			return best
		}

		// Returns the largest value not greater than value, or none.
		def floor(value T) ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				if n.value == value {
					return n.value
				} else if n.value < value {
					best = n.value
					node = n.right
				} else {
					node = n.left
				}
			}
			return best
		}

		// Returns the smallest value not less than value, or none.
		def ceiling(value T) ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				if n.value == value {
					return n.value
				} else if n.value > value {
					best = n.value
					node = n.left
				} else {
					node = n.right
				}
			}
			return best
		}

		// Returns the number of edges on the longest root-to-leaf path, or -1
		// for an empty tree.
		def height() int {
			return heightOf(root) - 1
		}

		// Returns the values in ascending order.
		def toArray() T[] {
			let out T[]
			collect(root, out)
			return out
		}

		// Returns the next value in ascending order; none after the largest,
		// which also resets the cursor. The values are captured when
		// iteration starts.
		def iterate() ?T {
			snapshot = toArray() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let v = snapshot[cur]
			cur += 1
			return v
		}

		internal def heightOf(node ?AVLNode<T>) int {
			let n = node
			return 0 when n is none
			return n.height
		}

		internal def update(n AVLNode<T>) {
			n.height = heightOf(n.left).max(heightOf(n.right)) + 1
		}

		internal def balanceOf(n AVLNode<T>) int {
			return heightOf(n.left) - heightOf(n.right)
		}

		internal def rotateRight(n AVLNode<T>) AVLNode<T> {
			let pivot = n.left
			return n when pivot is none
			n.left = pivot.right
			pivot.right = n
			update(n)
			update(pivot)
			return pivot
		}

		internal def rotateLeft(n AVLNode<T>) AVLNode<T> {
			let pivot = n.right
			return n when pivot is none
			n.right = pivot.left
			pivot.left = n
			update(n)
			update(pivot)
			return pivot
		}

		internal def rebalance(n AVLNode<T>) AVLNode<T> {
			update(n)
			let balance = balanceOf(n)
			if balance > 1 {
				let l = n.left
				if !(l is none) {
					n.left = rotateLeft(l) when balanceOf(l) < 0
				}
				return rotateRight(n)
			}
			if balance < -1 {
				let r = n.right
				if !(r is none) {
					n.right = rotateRight(r) when balanceOf(r) > 0
				}
				return rotateLeft(n)
			}
			return n
		}

		internal def insertInto(node ?AVLNode<T>, value T) AVLNode<T> {
			let n = node
			if n is none {
				count += 1
				return new AVLNode<T>(value)
			}
			if value < n.value {
				n.left = insertInto(n.left, value)
			} else if value > n.value {
				n.right = insertInto(n.right, value)
			} else {
				return n
			}
			return rebalance(n)
		}

		internal def removeFrom(node ?AVLNode<T>, value T) ?AVLNode<T> {
			let n = node
			return none when n is none
			if value < n.value {
				n.left = removeFrom(n.left, value)
				return rebalance(n)
			}
			if value > n.value {
				n.right = removeFrom(n.right, value)
				return rebalance(n)
			}
			count -= 1
			let l = n.left
			return n.right when l is none
			let r = n.right
			return l when r is none
			let successor = minOf(r)
			n.value = successor
			count += 1
			n.right = removeFrom(r, successor)
			return rebalance(n)
		}

		internal def minOf(n AVLNode<T>) T {
			let current = n
			for {
				let l = current.left
				return current.value when l is none
				current = l
			}
			return current.value
		}

		internal def collect(node ?AVLNode<T>, out T[]) {
			let n = node
			return when n is none
			collect(n.left, out)
			out.push(n.value)
			collect(n.right, out)
		}
	}
}
