partial module std.data.collections {
	use std.testing

	check "AVLTree" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestBalancedInsert() {
			let t = new AVLTree<int>()
			assert t.isEmpty()
			assert t.height() == -1
			for let i = 1; i <= 1000; i++ {
				assert t.insert(i)
			}
			assert !t.insert(500)
			assert t.len() == 1000
			// A balanced tree of 1000 nodes has height at most 1.44 * log2(1001) ~ 14.
			assert t.height() <= 14
			assert t.has(1)
			assert t.has(1000)
			assert !t.has(1001)
			assert eq(t.min(), 1)
			assert eq(t.max(), 1000)
			assert t.toArray().len() == 1000
		}

		@test()
		def TestRemove() {
			let t = new AVLTree<int>(int[10, 20, 30, 40, 50, 25])
			assert t.height() == 2
			assert t.toArray().equals(int[10, 20, 25, 30, 40, 50])
			assert t.remove(30)
			assert t.remove(10)
			assert !t.remove(10)
			assert t.toArray().equals(int[20, 25, 40, 50])
			assert t.height() == 2
			for let i = 100; i < 200; i++ {
				t.insert(i)
			}
			for let i = 100; i < 200; i++ {
				assert t.remove(i)
			}
			assert t.toArray().equals(int[20, 25, 40, 50])
			assert t.remove(20)
			assert t.remove(25)
			assert t.remove(40)
			assert t.remove(50)
			assert t.isEmpty()
			assert t.height() == -1
		}

		@test()
		def TestFloorCeilingIterate() {
			let t = new AVLTree<string>(string["d", "b", "f", "a", "c"])
			assert eq(t.floor("c"), "c")
			assert eq(t.floor("e"), "d")
			assert t.floor("0") is none
			assert eq(t.ceiling("e"), "f")
			assert t.ceiling("g") is none
			let seen string[]
			for let v in t {
				seen.push(v)
			}
			assert seen.equals(string["a", "b", "c", "d", "f"])
			t.clear()
			assert t.isEmpty()
		}
	}
}
