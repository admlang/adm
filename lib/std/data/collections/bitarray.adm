partial module std.data.collections {
	// BitArray is a fixed-length sequence of bits packed into 64-bit words.
	//
	// Bits are addressed from 0; an index outside the array is ignored by
	// setters and reads as false.
	type BitArray {
		internal words uint64[]
		internal size  int

		// Creates an array of size bits, all clear.
		def new(size int) {
			self.size = size.max(0)
			words.len((self.size + 63) / 64)
		}

		// Returns the number of bits.
		def len() int {
			return size
		}

		// Returns the bit at index; false when out of range.
		def get(index int) bool {
			return false when index < 0 || index >= size
			return words[index >> 6] & (uint64(1) << uint64(index & 63)) != 0
		}

		// Sets the bit at index to value.
		def set(index int, value bool = true) {
			return when index < 0 || index >= size
			let mask = uint64(1) << uint64(index & 63)
			if value {
				words[index >> 6] = words[index >> 6] | mask
			} else {
				words[index >> 6] = words[index >> 6] & ^mask
			}
		}

		// Clears the bit at index.
		def clear(index int) {
			set(index, false)
		}

		// Flips the bit at index and returns its new value.
		def toggle(index int) bool {
			return false when index < 0 || index >= size
			words[index >> 6] = words[index >> 6] ^ (uint64(1) << uint64(index & 63))
			return get(index)
		}

		// Sets every bit to value.
		def fill(value bool) {
			for let i = 0; i < words.len(); i++ {
				words[i] = 0
			}
			return unless value
			for let i = 0; i < size; i++ {
				set(i)
			}
		}

		// Returns the number of set bits.
		def count() int {
			let total = 0
			for let (_, w) in words {
				let x = w
				for x != 0 {
					x = x & (x - 1)
					total += 1
				}
			}
			return total
		}

		// Reports whether at least one bit is set.
		def any() bool {
			for let (_, w) in words {
				return true when w != 0
			}
			return false
		}

		// Reports whether every bit is set.
		def all() bool {
			return count() == size
		}

		// Reports whether both arrays have the same length and bits.
		def equals(other BitArray) bool {
			return false when other.size != size
			return words.equals(other.words)
		}

		// Returns a copy with every bit flipped.
		def invert() BitArray {
			let out = new BitArray(size)
			for let i = 0; i < size; i++ {
				out.set(i,!get(i))
			}
			return out
		}

		// Returns the bitwise and of two arrays. The result has the shorter
		// length.
		infix def & (other BitArray) BitArray {
			let out = new BitArray(size.min(other.size))
			for let i = 0; i < out.words.len(); i++ {
				out.words[i] = words[i] & other.words[i]
			}
			out.trim()
			return out
		}

		// Returns the bitwise or of two arrays. The result has the longer
		// length.
		infix def | (other BitArray) BitArray {
			let out = new BitArray(size.max(other.size))
			for let i = 0; i < out.words.len(); i++ {
				let a = i < words.len() ?? (words[i], uint64(0))
				let b = i < other.words.len() ?? (other.words[i], uint64(0))
				out.words[i] = a | b
			}
			return out
		}

		// Returns the bitwise exclusive or of two arrays. The result has the
		// longer length.
		infix def ^ (other BitArray) BitArray {
			let out = new BitArray(size.max(other.size))
			for let i = 0; i < out.words.len(); i++ {
				let a = i < words.len() ?? (words[i], uint64(0))
				let b = i < other.words.len() ?? (other.words[i], uint64(0))
				out.words[i] = a ^ b
			}
			return out
		}

		// Returns the bits as an array of booleans.
		def toArray() bool[] {
			let out bool[]
			for let i = 0; i < size; i++ {
				out.push(get(i))
			}
			return out
		}

		// Returns the bits as a string of 0 and 1 characters, index 0 first.
		def str() string {
			let out = ""
			for let i = 0; i < size; i++ {
				out += get(i) ?? ("1", "0")
			}
			return out
		}

		// Clears any bits beyond size in the last word.
		internal def trim() {
			return when words.len() == 0
			let used = size & 63
			return when used == 0
			let mask = (uint64(1) << uint64(used)) - 1
			words[words.len() - 1] = words[words.len() - 1] & mask
		}
	}

	// BitSet is a growable set of non-negative integers stored as a bitmap.
	//
	// Membership, insertion and removal are O(1); iteration yields members in
	// ascending order.
	type BitSet {
		internal words uint64[]
		internal count int
		internal cur   int

		// Creates an empty set.
		def new() {}

		// Returns the number of members.
		def len() int {
			return count
		}

		// Reports whether the set has no members.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every member.
		def clear() {
			words.flush()
			count = 0
		}

		// Adds value to the set. Returns false when it was already present or
		// is negative.
		def add(value int) bool {
			return false when value < 0
			let word = value >> 6
			words.len(word + 1) when word >= words.len()
			let mask = uint64(1) << uint64(value & 63)
			return false when words[word] & mask != 0
			words[word] = words[word] | mask
			count += 1
			return true
		}

		// Removes value from the set. Returns false when it was not a member.
		def remove(value int) bool {
			return false unless has(value)
			let word = value >> 6
			words[word] = words[word] & ^(uint64(1) << uint64(value & 63))
			count -= 1
			return true
		}

		// Reports whether value is a member.
		def has(value int) bool {
			return false when value < 0
			let word = value >> 6
			return false when word >= words.len()
			return words[word] & (uint64(1) << uint64(value & 63)) != 0
		}

		// Returns the smallest member, or none when empty.
		def min() ?int {
			for let w = 0; w < words.len(); w++ {
				continue when words[w] == 0
				for let b = 0; b < 64; b++ {
					return w * 64 + b when words[w] & (uint64(1) << uint64(b)) != 0
				}
			}
			return none
		}

		// Returns the largest member, or none when empty.
		def max() ?int {
			for let w = words.len() - 1; w >= 0; w-- {
				continue when words[w] == 0
				for let b = 63; b >= 0; b-- {
					return w * 64 + b when words[w] & (uint64(1) << uint64(b)) != 0
				}
			}
			return none
		}

		// Returns a new set holding the members of both sets.
		def unions(other BitSet) BitSet {
			let out = new BitSet()
			out.words.len(words.len().max(other.words.len()))
			for let i = 0; i < out.words.len(); i++ {
				let a = i < words.len() ?? (words[i], uint64(0))
				let b = i < other.words.len() ?? (other.words[i], uint64(0))
				out.words[i] = a | b
			}
			out.recount()
			return out
		}

		// Returns a new set holding the members common to both sets.
		def intersect(other BitSet) BitSet {
			let out = new BitSet()
			out.words.len(words.len().min(other.words.len()))
			for let i = 0; i < out.words.len(); i++ {
				out.words[i] = words[i] & other.words[i]
			}
			out.recount()
			return out
		}

		// Returns a new set holding the members of this set that are not in
		// other.
		def difference(other BitSet) BitSet {
			let out = new BitSet()
			out.words.len(words.len())
			for let i = 0; i < words.len(); i++ {
				let b = i < other.words.len() ?? (other.words[i], uint64(0))
				out.words[i] = words[i] & ^b
			}
			out.recount()
			return out
		}

		// Reports whether every member of this set is also in other.
		def isSubsetOf(other BitSet) bool {
			return difference(other).count == 0
		}

		// Reports whether both sets have the same members.
		def equals(other BitSet) bool {
			return false when count != other.count
			return isSubsetOf(other)
		}

		// Returns the members in ascending order.
		def toArray() int[] {
			let out int[]
			for let w = 0; w < words.len(); w++ {
				continue when words[w] == 0
				for let b = 0; b < 64; b++ {
					out.push(w * 64 + b) when words[w] & (uint64(1) << uint64(b)) != 0
				}
			}
			return out
		}

		// Returns the next member in ascending order; none after the largest,
		// which also resets the cursor.
		def iterate() ?int {
			let limit = words.len() * 64
			for cur < limit {
				let value = cur
				cur += 1
				return value when has(value)
			}
			cur = 0
			return none
		}

		// Recomputes count after a bulk word update.
		internal def recount() {
			count = 0
			for let (_, w) in words {
				let x = w
				for x != 0 {
					x = x & (x - 1)
					count += 1
				}
			}
		}
	}
}
