partial module std.data.collections {
	use std.testing

	check "BitArray" {
		@test()
		def TestSetGet() {
			let b = new BitArray(70)
			assert b.len() == 70
			assert !b.any()
			b.set(0)
			b.set(69)
			b.set(63)
			b.set(64)
			assert b.get(0)
			assert b.get(63)
			assert b.get(64)
			assert b.get(69)
			assert !b.get(1)
			assert !b.get(70)
			assert !b.get(-1)
			assert b.count() == 4
			assert b.any()
			assert !b.all()

			b.clear(63)
			assert !b.get(63)
			assert b.toggle(1)
			assert !b.toggle(1)
			assert b.count() == 3
			b.set(200)
			assert b.count() == 3
		}

		@test()
		def TestFillAndOps() {
			let a = new BitArray(8)
			let b = new BitArray(8)
			a.fill(true)
			assert a.all()
			assert a.count() == 8
			assert a.str() == "11111111"
			b.set(1)
			b.set(3)
			assert (a & b).str() == "01010000"
			assert (a ^ b).str() == "10101111"
			assert (b | new BitArray(4)).str() == "01010000"
			assert b.invert().str() == "10101111"
			assert b.invert().invert().equals(b)
			assert !a.equals(b)
			assert b.toArray().equals(bool[false, true, false, true, false, false, false, false])
			a.fill(false)
			assert !a.any()
			let small = new BitArray(3)
			small.fill(true)
			assert (small | new BitArray(5)).str() == "11100"
			assert (a & small).len() == 3
		}
	}

	check "BitSet" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestMembership() {
			let s = new BitSet()
			assert s.isEmpty()
			assert s.min() is none
			assert s.max() is none
			assert s.add(3)
			assert s.add(130)
			assert s.add(64)
			assert !s.add(3)
			assert !s.add(-1)
			assert s.len() == 3
			assert s.has(3)
			assert s.has(130)
			assert !s.has(4)
			assert !s.has(1000)
			assert eq(s.min(), 3)
			assert eq(s.max(), 130)
			assert s.toArray().equals(int[3, 64, 130])
			assert s.remove(64)
			assert !s.remove(64)
			assert s.len() == 2
			let seen int[]
			for let v in s {
				seen.push(v)
			}
			assert seen.equals(int[3, 130])
			s.clear()
			assert s.isEmpty()
			assert !s.has(3)
		}

		@test()
		def TestAlgebra() {
			let a = new BitSet()
			let b = new BitSet()
			a.add(1)
			a.add(2)
			a.add(100)
			b.add(2)
			b.add(3)
			assert a.unions(b).toArray().equals(int[1, 2, 3, 100])
			assert a.intersect(b).toArray().equals(int[2])
			assert a.difference(b).toArray().equals(int[1, 100])
			assert b.difference(a).toArray().equals(int[3])
			assert a.intersect(b).isSubsetOf(a)
			assert !a.isSubsetOf(b)
			assert a.unions(b).len() == 4
			let c = new BitSet()
			c.add(2)
			c.add(1)
			c.add(100)
			assert a.equals(c)
			assert !a.equals(b)
		}
	}
}
