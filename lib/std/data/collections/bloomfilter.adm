partial module std.data.collections {
	// BloomFilter is a probabilistic set of strings: mightContain never
	// reports false for an added key, and may report true for a key that
	// was never added.
	//
	// Each key sets hashes bits chosen by double hashing over FNV-1a.
	type BloomFilter {
		internal bits   BitArray
		internal hashes int
		internal count  int

		// Creates a filter of the given number of bits, setting hashes bits
		// per key. Both are clamped to at least one.
		def new(bits int, hashes int = 3) {
			self.bits = new BitArray(bits.max(1))
			self.hashes = hashes.max(1)
		}

		// Returns the number of keys added.
		def len() int {
			return count
		}

		// Returns the number of bits in the filter.
		def size() int {
			return bits.len()
		}

		// Returns the number of bits set per key.
		def hashCount() int {
			return hashes
		}

		// Reports whether no key has been added.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every key.
		def clear() {
			bits.fill(false)
			count = 0
		}

		// Adds key to the filter.
		def add(key string) {
			for let (_, i) in positions(key) {
				bits.set(i)
			}
			count += 1
		}

		// Reports whether key may have been added. False is definite; true
		// may be a false positive.
		def mightContain(key string) bool {
			for let (_, i) in positions(key) {
				return false unless bits.get(i)
			}
			return true
		}

		// Returns the fraction of bits that are set, between 0 and 1.
		def fillRatio() float {
			return float(bits.count()) / float(bits.len())
		}

		// Returns the bit positions key maps to.
		internal def positions(key string) int[] {
			let out int[]
			let h1 = fnv1a(key)
			let h2 = fnv1a(key, uint64(0x9e3779b97f4a7c15)) | uint64(1)
			let m = uint64(bits.len())
			for let i = 0; i < hashes; i++ {
				out.push(int((h1 + uint64(i) * h2) % m))
			}
			return out
		}
	}
}
