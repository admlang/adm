partial module std.data.collections {
	use std.testing

	check "BloomFilter" {
		@test()
		def TestMembership() {
			let f = new BloomFilter(1024, 4)
			assert f.isEmpty()
			assert f.size() == 1024
			assert f.hashCount() == 4
			assert !f.mightContain("apple")
			f.add("apple")
			f.add("banana")
			f.add("cherry")
			assert f.len() == 3
			assert f.mightContain("apple")
			assert f.mightContain("banana")
			assert f.mightContain("cherry")
			assert f.fillRatio() > 0.0
			assert f.fillRatio() < 0.05

			// With 1024 bits and 3 keys, these unrelated keys are almost surely absent.
			let hits = 0
			for let i = 0; i < 100; i++ {
				hits += 1 when f.mightContain("absent-" + i.str())
			}
			assert hits < 5

			f.clear()
			assert f.isEmpty()
			assert !f.mightContain("apple")
			assert f.fillRatio() == 0.0
		}

		@test()
		def TestClamps() {
			let f = new BloomFilter(0, 0)
			assert f.size() == 1
			assert f.hashCount() == 1
			f.add("x")
			assert f.mightContain("x")
			assert f.mightContain("y") // every key maps to the single bit
			assert f.fillRatio() == 1.0
		}
	}
}
