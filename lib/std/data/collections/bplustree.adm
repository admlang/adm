partial module std.data.collections {
	// Node of a B+ tree. Leaves hold values and chain to the next leaf;
	// internal nodes hold separator keys and children.
	internal type BPlusNode<K, V> {
		keys     K[]
		values   V[]
		children BPlusNode<K, V>[]
		leaf     bool
		next     ?BPlusNode<K, V>

		def new(leaf bool) {
			self.leaf = leaf
		}
	}

	// BPlusTree is an ordered key/value map whose values live in linked
	// leaves, which makes in-order iteration and range queries cheap.
	//
	// A node holds at most order-1 keys and splits when it would exceed
	// that. Deletion removes entries and prunes emptied nodes but does not
	// merge underfull nodes, so a tree that has seen many deletions may hold
	// fewer keys per node than a freshly built one. Iteration yields entries
	// in ascending key order.
	type BPlusTree<K: Ordered, V> {
		internal order     int
		internal root      BPlusNode<K, V>
		internal count     int
		// The right sibling produced by the most recent splitNode call.
		internal lastSplit BPlusNode<K, V>
		internal curLeaf   ?BPlusNode<K, V>
		internal curIndex  int
		internal started   bool

		// Creates an empty tree whose nodes hold at most order-1 keys (order
		// is at least 3).
		def new(order int = 32) {
			self.order = order.max(3)
			root = new BPlusNode<K, V>(true)
		}

		// Returns the number of entries.
		def len() int {
			return count
		}

		// Reports whether the tree holds no entries.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every entry.
		def clear() {
			root = new BPlusNode<K, V>(true)
			count = 0
		}

		// Returns the number of levels below the root; 0 when the root is a
		// leaf.
		def height() int {
			let h = 0
			let node = root
			for !node.leaf {
				node = node.children[0]
				h += 1
			}
			return h
		}

		// Associates value with key, replacing any existing value.
		def set(key K, value V) {
			let separator = insertInto(root, key, value)
			return when separator is none
			let old = root
			root = new BPlusNode<K, V>(false)
			root.keys.push(separator)
			root.children.len(2)
			root.children[0] = old
			root.children[1] = lastSplit
		}

		// Returns the value for key, or none when absent.
		def get(key K) ?V {
			let leaf = leafFor(key)
			let i = lowerBound(leaf.keys, key)
			return none when i >= leaf.keys.len() || leaf.keys[i] != key
			return leaf.values[i]
		}

		// Returns the value for key, or fallback when absent.
		def get(key K, fallback V) V {
			let v = get(key)
			return fallback when v is none
			return v
		}

		// Reports whether key is present.
		def has(key K) bool {
			let leaf = leafFor(key)
			let i = lowerBound(leaf.keys, key)
			return i < leaf.keys.len() && leaf.keys[i] == key
		}

		// Removes key. Returns false when it was absent.
		def delete(key K) bool {
			return false unless has(key)
			removeFrom(root, key)
			for !root.leaf && root.children.len() == 1 {
				root = root.children[0]
			}
			if !root.leaf && root.children.len() == 0 {
				root = new BPlusNode<K, V>(true)
			}
			count -= 1
			return true
		}

		// Returns the entry with the smallest key, or none when empty.
		def first() ?Entry<K, V> {
			let leaf = firstLeaf()
			return none when leaf.keys.len() == 0
			return new Entry<K, V>(leaf.keys[0], leaf.values[0])
		}

		// Returns the entry with the largest key, or none when empty.
		def last() ?Entry<K, V> {
			let node = root
			for !node.leaf {
				node = node.children[node.children.len() - 1]
			}
			return none when node.keys.len() == 0
			let i = node.keys.len() - 1
			return new Entry<K, V>(node.keys[i], node.values[i])
		}

		// Returns the entries whose keys lie in [from, to], ascending.
		def range(from K, to K) Entry<K, V>[] {
			let out Entry<K, V>[]
			return out when to < from
			let node ?BPlusNode<K, V> = leafFor(from)
			for {
				let leaf = node
				break when leaf is none
				for let i = 0; i < leaf.keys.len(); i++ {
					continue when leaf.keys[i] < from
					return out when leaf.keys[i] > to
					out.push(new Entry<K, V>(leaf.keys[i], leaf.values[i]))
				}
				node = leaf.next
			}
			return out
		}

		// Returns the keys in ascending order.
		def keys() K[] {
			let out K[]
			for let (_, e) in entries() {
				out.push(e.key)
			}
			return out
		}

		// Returns the values in ascending key order.
		def values() V[] {
			let out V[]
			for let (_, e) in entries() {
				out.push(e.value)
			}
			return out
		}

		// Returns the entries in ascending key order.
		def entries() Entry<K, V>[] {
			let out Entry<K, V>[]
			let node ?BPlusNode<K, V> = firstLeaf()
			for {
				let leaf = node
				break when leaf is none
				for let i = 0; i < leaf.keys.len(); i++ {
					out.push(new Entry<K, V>(leaf.keys[i], leaf.values[i]))
				}
				node = leaf.next
			}
			return out
		}

		// Returns the next entry in key order by walking the leaf chain; none
		// after the last, which also resets the cursor.
		def iterate() ?Entry<K, V> {
			if !started {
				curLeaf = firstLeaf()
				curIndex = 0
				started = true
			}
			for {
				let leaf = curLeaf
				if leaf is none {
					started = false
					return none
				}
				if curIndex < leaf.keys.len() {
					let e = new Entry<K, V>(leaf.keys[curIndex], leaf.values[curIndex])
					curIndex += 1
					return e
				}
				curLeaf = leaf.next
				curIndex = 0
			}
			return none
		}

		internal def lowerBound(keys K[], key K) int {
			let lo = 0
			let hi = keys.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				if keys[mid] < key {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			return lo
		}

		// Returns the child index to follow for key in an internal node.
		internal def childIndex(node BPlusNode<K, V>, key K) int {
			let i = 0
			for i < node.keys.len() && node.keys[i] <= key {
				i += 1
			}
			return i
		}

		internal def leafFor(key K) BPlusNode<K, V> {
			let node = root
			for !node.leaf {
				node = node.children[childIndex(node, key)]
			}
			return node
		}

		internal def firstLeaf() BPlusNode<K, V> {
			let node = root
			for !node.leaf {
				node = node.children[0]
			}
			return node
		}

		// Inserts below node. When node overflows it is split and the separator
		// for the parent is returned, with the new right sibling in lastSplit.
		internal def insertInto(node BPlusNode<K, V>, key K, value V) ?K {
			if node.leaf {
				let i = lowerBound(node.keys, key)
				if i < node.keys.len() && node.keys[i] == key {
					node.values[i] = value
					return none
				}
				insertKeyAt(node.keys, i, key)
				insertValueAt(node.values, i, value)
				count += 1
				return none when node.keys.len() < order
				return splitNode(node)
			}
			let idx = childIndex(node, key)
			let separator = insertInto(node.children[idx], key, value)
			return none when separator is none
			insertKeyAt(node.keys, idx, separator)
			node.children = insertChildAt(node.children, idx + 1, lastSplit)
			return none when node.keys.len() < order
			return splitNode(node)
		}

		// Splits an overflowing node in place: the upper half moves to a new
		// right sibling stored in lastSplit, and the separator key for the
		// parent is returned. A leaf keeps its first key in the sibling; an
		// internal node promotes its middle key.
		internal def splitNode(node BPlusNode<K, V>) K {
			let mid = node.keys.len() / 2
			let right = new BPlusNode<K, V>(node.leaf)
			if node.leaf {
				for let i = mid; i < node.keys.len(); i++ {
					right.keys.push(node.keys[i])
					right.values.push(node.values[i])
				}
				node.keys.len(mid)
				node.values.len(mid)
				right.next = node.next
				node.next = right
				lastSplit = right
				return right.keys[0]
			}
			let separator = node.keys[mid]
			for let i = mid + 1; i < node.keys.len(); i++ {
				right.keys.push(node.keys[i])
			}
			right.children = sliceChildren(node.children, mid + 1, node.children.len())
			node.keys.len(mid)
			node.children = sliceChildren(node.children, 0, mid + 1)
			lastSplit = right
			return separator
		}

		// Removes key below node; the caller guarantees it is present.
		internal def removeFrom(node BPlusNode<K, V>, key K) {
			if node.leaf {
				let i = lowerBound(node.keys, key)
				return when i >= node.keys.len() || node.keys[i] != key
				node.keys.remove(i)
				node.values.remove(i)
				return
			}
			let idx = childIndex(node, key)
			let child = node.children[idx]
			removeFrom(child, key)
			let drained = child.leaf ?? (child.keys.len() == 0, child.children.len() == 0)
			return unless drained
			unlinkLeaf(child) when child.leaf
			node.children.remove(idx)
			if idx > 0 {
				node.keys.remove(idx - 1)
			} else if node.keys.len() > 0 {
				node.keys.remove(0)
			}
		}

		// Detaches an emptied leaf from the leaf chain.
		internal def unlinkLeaf(leaf BPlusNode<K, V>) {
			let node ?BPlusNode<K, V> = firstLeaf()
			for {
				let current = node
				return when current is none
				let next = current.next
				return when next is none
				if next == leaf {
					current.next = leaf.next
					return
				}
				node = next
			}
		}

		// Returns children[from:to] as a fresh, retained array.
		internal def sliceChildren(children BPlusNode<K, V>[], from int, to int) BPlusNode<K, V>[] {
			let out BPlusNode<K, V>[]
			out.len(to - from)
			for let i = from; i < to; i++ {
				out[i - from] = children[i]
			}
			return out
		}

		internal def insertKeyAt(keys K[], index int, key K) {
			keys.push(key)
			for let i = keys.len() - 1; i > index; i-- {
				keys[i] = keys[i - 1]
			}
			keys[index] = key
		}

		internal def insertValueAt(values V[], index int, value V) {
			values.push(value)
			for let i = values.len() - 1; i > index; i-- {
				values[i] = values[i - 1]
			}
			values[index] = value
		}

		// Returns a copy of children with child inserted at index. A fresh
		// array is filled by index assignment so every element is retained.
		internal def insertChildAt(children BPlusNode<K, V>[], index int, child BPlusNode<K, V>) BPlusNode<K, V>[] {
			let out BPlusNode<K, V>[]
			out.len(children.len() + 1)
			for let i = 0; i < index; i++ {
				out[i] = children[i]
			}
			out[index] = child
			for let i = index; i < children.len(); i++ {
				out[i + 1] = children[i]
			}
			return out
		}
	}
}
