partial module std.data.collections {
	use std.testing

	check "BPlusTree" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		def key<K, V>(e ?Entry<K, V>) ?K {
			return none when e is none
			return e.key
		}

		@test()
		def TestSetGet() {
			let t = new BPlusTree<int, string>(4)
			assert t.isEmpty()
			assert t.first() is none
			assert t.get(1) is none
			assert t.height() == 0
			for let i = 1; i <= 100; i++ {
				t.set(i, "v" + i.str())
			}
			t.set(50, "fifty")
			assert t.len() == 100
			assert t.height() >= 2
			assert eq(t.get(50), "fifty")
			assert eq(t.get(1), "v1")
			assert eq(t.get(100), "v100")
			assert t.get(0) is none
			assert t.get(0, "?") == "?"
			assert t.has(99)
			assert !t.has(101)
			assert eq(key(t.first()), 1)
			assert eq(key(t.last()), 100)
			let ks = t.keys()
			assert ks.len() == 100
			for let i = 0; i < 100; i++ {
				assert ks[i] == i + 1
			}
			assert t.values().len() == 100
		}

		@test()
		def TestRangeIterate() {
			let t = new BPlusTree<int, int>(3)
			for let i = 0; i < 50; i++ {
				t.set((i * 17) % 50, i)
			}
			let r = t.range(10, 15)
			assert r.len() == 6
			assert r[0].key == 10
			assert r[5].key == 15
			assert t.range(48, 100).len() == 2
			assert t.range(20, 10).len() == 0
			let seen int[]
			for let e in t {
				seen.push(e.key)
			}
			assert seen.len() == 50
			for let i = 1; i < 50; i++ {
				assert seen[i - 1] < seen[i]
			}
			let again = 0
			for let e in t {
				again += 1
			}
			assert again == 50
		}

		@test()
		def TestDelete() {
			let t = new BPlusTree<int, int>(3)
			for let i = 0; i < 200; i++ {
				t.set(i, i * 2)
			}
			for let i = 0; i < 200; i += 2 {
				assert t.delete(i)
			}
			assert !t.delete(0)
			assert t.len() == 100
			assert !t.has(0)
			assert eq(t.get(1), 2)
			assert eq(t.get(199), 398)
			assert eq(key(t.first()), 1)
			assert eq(key(t.last()), 199)
			let ks = t.keys()
			assert ks.len() == 100
			for let i = 1; i < ks.len(); i++ {
				assert ks[i - 1] < ks[i]
			}
			assert t.range(0, 10).len() == 5
			for let i = 1; i < 200; i += 2 {
				assert t.delete(i)
			}
			assert t.isEmpty()
			assert t.first() is none
			assert t.height() == 0
			t.set(5, 5)
			assert eq(t.get(5), 5)
			t.clear()
			assert t.isEmpty()
		}

		@test()
		def TestStringKeys() {
			let t = new BPlusTree<string, int>()
			t.set("pear", 3)
			t.set("apple", 1)
			t.set("fig", 2)
			assert t.keys().equals(string["apple", "fig", "pear"])
			assert t.range("b", "g").len() == 1
			assert t.delete("fig")
			assert t.keys().equals(string["apple", "pear"])
		}
	}
}
