partial module std.data.collections {
	// Node of a binary search tree.
	internal type BSTNode<T> {
		value T
		left  ?BSTNode<T>
		right ?BSTNode<T>

		def new(value T) {
			self.value = value
		}
	}

	// BinarySearchTree is an unbalanced binary search tree of distinct
	// values.
	//
	// Operations are O(h) where h is the tree height; inserting sorted input
	// degrades it to a list. Iteration yields values in ascending order.
	type BinarySearchTree<T: Ordered> {
		internal root     ?BSTNode<T>
		internal count    int
		internal snapshot T[]
		internal cur      int

		def new() {}

		// Creates a tree holding values, inserted in the order given.
		def new(values T[]) {
			for let (_, v) in values {
				insert(v)
			}
		}

		// Returns the number of values.
		def len() int {
			return count
		}

		// Reports whether the tree holds no values.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every value.
		def clear() {
			root = none
			count = 0
		}

		// Adds value. Returns false when it was already present.
		def insert(value T) bool {
			let before = count
			root = insertInto(root, value)
			return count > before
		}

		// Removes value. Returns false when it was absent.
		def remove(value T) bool {
			let before = count
			root = removeFrom(root, value)
			return count < before
		}

		// Reports whether value is present.
		def has(value T) bool {
			let node = root
			for {
				let n = node
				return false when n is none
				return true when n.value == value
				node = value < n.value ?? (n.left, n.right)
			}
			return false
		}

		// Returns the smallest value, or none when empty.
		def min() ?T {
			let n = minNode(root)
			return none when n is none
			return n.value
		}

		// Returns the largest value, or none when empty.
		def max() ?T {
			let node = root
			let last ?BSTNode<T> = none
			for {
				let n = node
				break when n is none
				last = n
				node = n.right
			}
			let l = last
			return none when l is none
			return l.value
		}

		// Returns the largest value not greater than value, or none.
		def floor(value T) ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				if n.value == value {
					return n.value
				} else if n.value < value {
					best = n.value
					node = n.right
				} else {
					node = n.left
				}
			}
			return best
		}

		// Returns the smallest value not less than value, or none.
		def ceiling(value T) ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				if n.value == value {
					return n.value
				} else if n.value > value {
					best = n.value
					node = n.left
				} else {
					node = n.right
				}
			}
			return best
		}

		// Returns the number of edges on the longest root-to-leaf path, or -1
		// for an empty tree.
		def height() int {
			return heightOf(root)
		}

		// Returns the values in ascending order.
		def toArray() T[] {
			let out T[]
			collect(root, out)
			return out
		}

		// Returns the next value in ascending order; none after the largest,
		// which also resets the cursor. The values are captured when
		// iteration starts.
		def iterate() ?T {
			snapshot = toArray() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let v = snapshot[cur]
			cur += 1
			return v
		}

		internal def insertInto(node ?BSTNode<T>, value T) BSTNode<T> {
			let n = node
			if n is none {
				count += 1
				return new BSTNode<T>(value)
			}
			if value < n.value {
				n.left = insertInto(n.left, value)
			} else if value > n.value {
				n.right = insertInto(n.right, value)
			}
			return n
		}

		internal def removeFrom(node ?BSTNode<T>, value T) ?BSTNode<T> {
			let n = node
			return none when n is none
			if value < n.value {
				n.left = removeFrom(n.left, value)
				return n
			}
			if value > n.value {
				n.right = removeFrom(n.right, value)
				return n
			}
			count -= 1
			let l = n.left
			return n.right when l is none
			let r = n.right
			return l when r is none
			let successor = minNode(r)
			return l when successor is none
			n.value = successor.value
			count += 1
			n.right = removeFrom(r, successor.value)
			return n
		}

		internal def minNode(node ?BSTNode<T>) ?BSTNode<T> {
			let current = node
			for {
				let n = current
				return none when n is none
				let l = n.left
				return n when l is none
				current = l
			}
			return none
		}

		internal def heightOf(node ?BSTNode<T>) int {
			let n = node
			return -1 when n is none
			return heightOf(n.left).max(heightOf(n.right)) + 1
		}

		internal def collect(node ?BSTNode<T>, out T[]) {
			let n = node
			return when n is none
			collect(n.left, out)
			out.push(n.value)
			collect(n.right, out)
		}
	}
}
