partial module std.data.collections {
	use std.testing

	check "BinarySearchTree" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestInsertRemove() {
			let t = new BinarySearchTree<int>()
			assert t.isEmpty()
			assert t.min() is none
			assert t.max() is none
			assert t.height() == -1
			for let (_, v) in int[50, 30, 70, 20, 40, 60, 80] {
				assert t.insert(v)
			}
			assert !t.insert(40)
			assert t.len() == 7
			assert t.height() == 2
			assert t.has(60)
			assert !t.has(65)
			assert eq(t.min(), 20)
			assert eq(t.max(), 80)
			assert t.toArray().equals(int[20, 30, 40, 50, 60, 70, 80])

			assert t.remove(20) // leaf
			assert t.remove(30) // one child
			assert t.remove(50) // two children (root)
			assert !t.remove(50)
			assert t.len() == 4
			assert t.toArray().equals(int[40, 60, 70, 80])
			assert !t.has(50)
			assert eq(t.min(), 40)

			let seen int[]
			for let v in t {
				seen.push(v)
			}
			assert seen.equals(int[40, 60, 70, 80])
			t.clear()
			assert t.isEmpty()
			assert t.height() == -1
		}

		@test()
		def TestFloorCeiling() {
			let t = new BinarySearchTree<string>(string["m", "c", "x", "a", "f"])
			assert eq(t.floor("f"), "f")
			assert eq(t.floor("g"), "f")
			assert eq(t.floor("b"), "a")
			assert t.floor("0") is none
			assert eq(t.ceiling("g"), "m")
			assert eq(t.ceiling("a"), "a")
			assert t.ceiling("z") is none
		}
	}
}
