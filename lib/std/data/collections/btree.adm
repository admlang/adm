partial module std.data.collections {
	// Node of a B-tree: sorted keys with one more child than keys.
	internal type BTreeNode<T> {
		keys     T[]
		children BTreeNode<T>[]
		leaf     bool

		def new(leaf bool) {
			self.leaf = leaf
		}
	}

	// BTree is a balanced multi-way search tree of distinct values.
	//
	// Every node except the root holds between degree-1 and 2*degree-1
	// keys, so the height stays O(log n). Iteration yields values in
	// ascending order.
	type BTree<T: Ordered> {
		internal degree   int
		internal root     BTreeNode<T>
		internal count    int
		internal snapshot T[]
		internal cur      int

		// Creates an empty tree with the given minimum degree (at least 2).
		def new(degree int = 3) {
			self.degree = degree.max(2)
			root = new BTreeNode<T>(true)
		}

		// Returns the number of values.
		def len() int {
			return count
		}

		// Reports whether the tree holds no values.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every value.
		def clear() {
			root = new BTreeNode<T>(true)
			count = 0
		}

		// Returns the number of levels below the root; 0 for a tree whose root
		// is a leaf.
		def height() int {
			let h = 0
			let node = root
			for !node.leaf {
				node = node.children[0]
				h += 1
			}
			return h
		}

		// Reports whether value is present.
		def has(value T) bool {
			let node = root
			for {
				let i = lowerBound(node.keys, value)
				return true when i < node.keys.len() && node.keys[i] == value
				return false when node.leaf
				node = node.children[i]
			}
			return false
		}

		// Adds value. Returns false when it was already present.
		def insert(value T) bool {
			return false when has(value)
			if root.keys.len() == 2 * degree - 1 {
				let old = root
				root = new BTreeNode<T>(false)
				root.children.len(1)
				root.children[0] = old
				splitChild(root, 0)
			}
			insertNonFull(root, value)
			count += 1
			return true
		}

		// Removes value. Returns false when it was absent.
		def remove(value T) bool {
			return false unless has(value)
			removeFrom(root, value)
			if root.keys.len() == 0 && !root.leaf {
				root = root.children[0]
			}
			count -= 1
			return true
		}

		// Returns the smallest value, or none when empty.
		def min() ?T {
			return none when count == 0
			let node = root
			for !node.leaf {
				node = node.children[0]
			}
			return node.keys[0]
		}

		// Returns the largest value, or none when empty.
		def max() ?T {
			return none when count == 0
			let node = root
			for !node.leaf {
				node = node.children[node.children.len() - 1]
			}
			return node.keys[node.keys.len() - 1]
		}

		// Returns the values in ascending order.
		def toArray() T[] {
			let out T[]
			collect(root, out)
			return out
		}

		// Returns the next value in ascending order; none after the largest,
		// which also resets the cursor. The values are captured when
		// iteration starts.
		def iterate() ?T {
			snapshot = toArray() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let v = snapshot[cur]
			cur += 1
			return v
		}

		// Returns the first index in keys whose key is not less than value.
		internal def lowerBound(keys T[], value T) int {
			let lo = 0
			let hi = keys.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				if keys[mid] < value {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			return lo
		}

		// Splits the full child at index of parent around its median key.
		internal def splitChild(parent BTreeNode<T>, index int) {
			let full = parent.children[index]
			let right = new BTreeNode<T>(full.leaf)
			let median = full.keys[degree - 1]

			for let i = degree; i < full.keys.len(); i++ {
				right.keys.push(full.keys[i])
			}
			if !full.leaf {
				right.children = sliceChildren(full.children, degree, full.children.len())
				full.children = sliceChildren(full.children, 0, degree)
			}
			full.keys.len(degree - 1)

			insertAt(parent.keys, index, median)
			parent.children = insertChildAt(parent.children, index + 1, right)
		}

		internal def insertNonFull(node BTreeNode<T>, value T) {
			let current = node
			for {
				let i = lowerBound(current.keys, value)
				if current.leaf {
					insertAt(current.keys, i, value)
					return
				}
				if current.children[i].keys.len() == 2 * degree - 1 {
					splitChild(current, i)
					i += 1 when current.keys[i] < value
				}
				current = current.children[i]
			}
		}

		// Removes value from the subtree at node; the caller guarantees the
		// value is present and that node has at least degree keys unless it is
		// the root.
		internal def removeFrom(node BTreeNode<T>, value T) {
			let i = lowerBound(node.keys, value)
			if i < node.keys.len() && node.keys[i] == value {
				if node.leaf {
					node.keys.remove(i)
					return
				}
				let left = node.children[i]
				let right = node.children[i + 1]
				if left.keys.len() >= degree {
					let pred = maxOf(left)
					node.keys[i] = pred
					removeFrom(left, pred)
				} else if right.keys.len() >= degree {
					let succ = minOf(right)
					node.keys[i] = succ
					removeFrom(right, succ)
				} else {
					mergeChildren(node, i)
					removeFrom(left, value)
				}
				return
			}
			return when node.leaf
			if node.children[i].keys.len() < degree {
				fill(node, i)
				// fill may have merged child i into its left sibling.
				i = lowerBound(node.keys, value)
				if i < node.keys.len() && node.keys[i] == value {
					removeFrom(node, value)
					return
				}
			}
			removeFrom(node.children[i], value)
		}

		// Ensures child index of node has at least degree keys by borrowing
		// from a sibling or merging with one.
		internal def fill(node BTreeNode<T>, index int) {
			if index > 0 && node.children[index - 1].keys.len() >= degree {
				let child = node.children[index]
				let sibling = node.children[index - 1]
				insertAt(child.keys, 0, node.keys[index - 1])
				if !child.leaf {
					let moved = sibling.children[sibling.children.len() - 1]
					child.children = insertChildAt(child.children, 0, moved)
					sibling.children = sliceChildren(sibling.children, 0, sibling.children.len() - 1)
				}
				node.keys[index - 1] = sibling.keys.pop()
				return
			}
			if index < node.children.len() - 1 && node.children[index + 1].keys.len() >= degree {
				let child = node.children[index]
				let sibling = node.children[index + 1]
				child.keys.push(node.keys[index])
				if !child.leaf {
					child.children = insertChildAt(child.children, child.children.len(), sibling.children[0])
					sibling.children = sliceChildren(sibling.children, 1, sibling.children.len())
				}
				node.keys[index] = sibling.keys.shift()
				return
			}
			if index < node.children.len() - 1 {
				mergeChildren(node, index)
			} else {
				mergeChildren(node, index - 1)
			}
		}

		// Merges child index+1 of node into child index around the key
		// between them.
		internal def mergeChildren(node BTreeNode<T>, index int) {
			let left = node.children[index]
			let right = node.children[index + 1]
			left.keys.push(node.keys[index])
			for let (_, k) in right.keys {
				left.keys.push(k)
			}
			let merged BTreeNode<T>[]
			merged.len(left.children.len() + right.children.len())
			for let i = 0; i < left.children.len(); i++ {
				merged[i] = left.children[i]
			}
			for let i = 0; i < right.children.len(); i++ {
				merged[left.children.len() + i] = right.children[i]
			}
			left.children = merged
			node.keys.remove(index)
			node.children = removeChildAt(node.children, index + 1)
		}

		internal def minOf(node BTreeNode<T>) T {
			let current = node
			for !current.leaf {
				current = current.children[0]
			}
			return current.keys[0]
		}

		internal def maxOf(node BTreeNode<T>) T {
			let current = node
			for !current.leaf {
				current = current.children[current.children.len() - 1]
			}
			return current.keys[current.keys.len() - 1]
		}

		internal def insertAt(keys T[], index int, value T) {
			keys.push(value)
			for let i = keys.len() - 1; i > index; i-- {
				keys[i] = keys[i - 1]
			}
			keys[index] = value
		}

		// Returns a copy of children with child inserted at index. A fresh
		// array is filled by index assignment so every element is retained.
		internal def insertChildAt(children BTreeNode<T>[], index int, child BTreeNode<T>) BTreeNode<T>[] {
			let out BTreeNode<T>[]
			out.len(children.len() + 1)
			for let i = 0; i < index; i++ {
				out[i] = children[i]
			}
			out[index] = child
			for let i = index; i < children.len(); i++ {
				out[i + 1] = children[i]
			}
			return out
		}

		// Returns a copy of children without the element at index.
		internal def removeChildAt(children BTreeNode<T>[], index int) BTreeNode<T>[] {
			let out BTreeNode<T>[]
			out.len(children.len() - 1)
			for let i = 0; i < index; i++ {
				out[i] = children[i]
			}
			for let i = index + 1; i < children.len(); i++ {
				out[i - 1] = children[i]
			}
			return out
		}

		// Returns children[from:to] as a fresh, retained array.
		internal def sliceChildren(children BTreeNode<T>[], from int, to int) BTreeNode<T>[] {
			let out BTreeNode<T>[]
			out.len(to - from)
			for let i = from; i < to; i++ {
				out[i - from] = children[i]
			}
			return out
		}

		internal def collect(node BTreeNode<T>, out T[]) {
			for let i = 0; i < node.keys.len(); i++ {
				collect(node.children[i], out) unless node.leaf
				out.push(node.keys[i])
			}
			collect(node.children[node.keys.len()], out) unless node.leaf
		}
	}
}
