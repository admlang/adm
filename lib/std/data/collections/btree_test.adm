partial module std.data.collections {
	use std.testing

	check "BTree" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestInsertSearch() {
			let t = new BTree<int>(2)
			assert t.isEmpty()
			assert t.min() is none
			assert t.height() == 0
			for let i = 1; i <= 100; i++ {
				assert t.insert(i)
			}
			assert !t.insert(50)
			assert t.len() == 100
			assert t.height() >= 3
			assert t.height() <= 7
			assert t.has(1)
			assert t.has(100)
			assert !t.has(101)
			assert eq(t.min(), 1)
			assert eq(t.max(), 100)
			let all = t.toArray()
			assert all.len() == 100
			for let i = 0; i < 100; i++ {
				assert all[i] == i + 1
			}
		}

		@test()
		def TestRemove() {
			let t = new BTree<int>(3)
			for let i = 0; i < 300; i++ {
				t.insert((i * 7919) % 300)
			}
			assert t.len() == 300
			for let i = 0; i < 300; i += 3 {
				assert t.remove(i)
			}
			assert !t.remove(0)
			assert t.len() == 200
			assert !t.has(3)
			assert t.has(4)
			assert eq(t.min(), 1)
			assert eq(t.max(), 299)
			let all = t.toArray()
			assert all.len() == 200
			for let i = 1; i < all.len(); i++ {
				assert all[i - 1] < all[i]
			}
			for let i = 0; i < 300; i++ {
				t.remove(i)
			}
			assert t.isEmpty()
			assert t.height() == 0
			assert t.max() is none
		}

		@test()
		def TestStringsIterate() {
			let t = new BTree<string>()
			for let (_, w) in string["pear", "apple", "fig", "kiwi", "date", "cherry"] {
				t.insert(w)
			}
			let seen string[]
			for let v in t {
				seen.push(v)
			}
			assert seen.equals(string["apple", "cherry", "date", "fig", "kiwi", "pear"])
			t.clear()
			assert t.isEmpty()
		}
	}
}
