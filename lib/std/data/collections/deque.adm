partial module std.data.collections {
	// Deque is a double-ended queue backed by a circular array.
	//
	// Elements can be efficiently inserted or removed from either end.
	// The backing array is treated as storage capacity; `count` represents
	// the number of elements currently contained in the deque.
	//
	// Random access is supported in logical deque order and accepts negative
	// indices, where -1 is the last element.
	type Deque<T> {
		// Circular backing storage.
		internal data  T[]
		// Physical array index of the first logical element.
		internal head  int
		// Number of elements currently stored in the deque.
		internal count int
		// iteration cursor
		internal cur   int

		// Creates an empty deque with the given initial capacity.
		def new(capacity int = 16) {
			data.len(capacity.max(0))
		}

		// Returns the number of elements currently stored in the deque.
		def len() int {
			return count
		}

		// Reports whether the deque contains no elements.
		def isEmpty() bool {
			return count == 0
		}

		// Removes all elements from the deque while retaining its allocated
		// backing storage for reuse.
		def clear() {
			head = 0
			count = 0
		}

		// Inserts a value at the front of the deque.
		def pushFront(value T) {
			ensureSpace()

			if head == 0 {
				head = data.len() - 1
			} else {
				head -= 1
			}

			data[head] = value
			count += 1
		}

		// Inserts a value at the back of the deque.
		def pushBack(value T) {
			ensureSpace()

			let index = physicalIndex(count)
			data[index] = value
			count += 1
		}

		// Removes and returns the first element, or none if the deque is empty.
		def popFront() ?T {
			return none when count == 0

			let value = data[head]

			head += 1
			head = 0 when head == data.len()

			count -= 1
			head = 0 when count == 0

			return value
		}

		// Removes and returns the last element, or none if the deque is empty.
		def popBack() ?T {
			return none when count == 0

			let value = data[physicalIndex(count - 1)]

			count -= 1
			head = 0 when count == 0

			return value
		}

		// Returns the first element without removing it.
		def front() ?T {
			return none when count == 0
			return data[head]
		}

		// Returns the last element without removing it.
		def back() ?T {
			return none when count == 0
			return data[physicalIndex(count - 1)]
		}

		// Returns the element at the given logical index.
		//
		// Negative indices count backwards from the end of the deque, so
		// -1 refers to the last element.
		def at(index int) ?T {
			index += count when index < 0
			return none when index < 0 || index >= count

			return data[physicalIndex(index)]
		}

		// Reports whether the deque contains the given value.
		def contains(value T) bool {
			for let i = 0; i < count; i++ {
				return true when data[physicalIndex(i)] == value
			}

			return false
		}

		// Removes the first occurrence of value.
		//
		// Elements are shifted toward the nearest end so removing an element
		// requires moving at most roughly half of the deque.
		def remove(value T) bool {
			let index = -1

			for let i = 0; i < count; i++ {
				if data[physicalIndex(i)] == value {
					index = i
					break
				}
			}

			return false when index < 0

			if index < count / 2 {
				// Shift the front portion one position toward the back.
				for let i = index; i > 0; i-- {
					data[physicalIndex(i)] = data[physicalIndex(i - 1)]
				}

				head += 1
				head = 0 when head == data.len()
			} else {
				// Shift the back portion one position toward the front.
				for let i = index; i < count - 1; i++ {
					data[physicalIndex(i)] = data[physicalIndex(i + 1)]
				}
			}

			count -= 1
			head = 0 when count == 0

			return true
		}

		// Ensures the deque can hold at least capacity elements without
		// reallocating.
		//
		// Existing elements retain their logical order. The deque is unwrapped
		// into the new backing storage so the first element starts at index 0.
		def reserve(capacity int) {
			return when capacity <= data.len()

			let next T[]
			next.len(capacity)

			for let i = 0; i < count; i++ {
				next[i] = data[physicalIndex(i)]
			}

			data = next
			head = 0
		}

		// Returns the number of elements that can be stored before the deque
		// must grow its backing storage.
		def capacity() int {
			return data.len()
		}

		// Returns the next element in logical deque order.
		//
		// Returns none after the last element and resets the iteration cursor so a
		// subsequent iteration starts again from the front.
		def iterate() ?T {
			if cur >= len() {
				cur = 0
				return none
			}
			let v = at(cur)
			cur += 1
			return v
		}

		// Returns the physical backing-array index corresponding to a logical
		// deque index.
		internal def physicalIndex(index int) int {
			return (head + index) % data.len()
		}

		// Grows the backing storage when no free slot remains.
		internal def ensureSpace() {
			return when count < data.len()

			let capacity = data.len() * 2
			capacity = 1 when capacity == 0

			reserve(capacity)
		}
	}
}
