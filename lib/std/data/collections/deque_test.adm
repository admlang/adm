partial module std.data.collections {
	use std.testing

	check "Deque" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestPushPop() {
			let d = new Deque<int>()
			assert d.isEmpty()
			assert d.len() == 0
			assert d.popFront() is none
			assert d.popBack() is none
			assert d.front() is none
			assert d.back() is none

			d.pushBack(2)
			d.pushBack(3)
			d.pushFront(1)
			assert d.len() == 3
			assert !d.isEmpty()
			assert eq(d.front(), 1)
			assert eq(d.back(), 3)

			assert eq(d.popFront(), 1)
			assert eq(d.popBack(), 3)
			assert eq(d.popFront(), 2)
			assert d.isEmpty()
			assert d.popFront() is none
		}

		@test()
		def TestAt() {
			let d = new Deque<string>(2)
			d.pushBack("b")
			d.pushBack("c")
			d.pushFront("a")
			assert eq(d.at(0), "a")
			assert eq(d.at(1), "b")
			assert eq(d.at(2), "c")
			assert eq(d.at(-1), "c")
			assert eq(d.at(-3), "a")
			assert d.at(3) is none
			assert d.at(-4) is none
		}

		@test()
		def TestGrowthKeepsOrder() {
			let d = new Deque<int>(1)
			for let i = 0; i < 100; i++ {
				if i % 2 == 0 {
					d.pushBack(i)
				} else {
					d.pushFront(i)
				}
			}
			assert d.len() == 100
			assert d.capacity() >= 100
			// Odd values were pushed to the front, descending; evens to the back, ascending.
			assert eq(d.front(), 99)
			assert eq(d.back(), 98)
			assert eq(d.at(49), 1)
			assert eq(d.at(50), 0)
		}

		@test()
		def TestWrapAround() {
			let d = new Deque<int>(4)
			d.pushBack(1)
			d.pushBack(2)
			d.pushBack(3)
			assert eq(d.popFront(), 1)
			assert eq(d.popFront(), 2)
			// Head now sits near the end of storage; these wrap.
			d.pushBack(4)
			d.pushBack(5)
			d.pushBack(6)
			assert d.len() == 4
			assert eq(d.at(0), 3)
			assert eq(d.at(3), 6)
			assert eq(d.popBack(), 6)
			assert eq(d.popFront(), 3)
			assert eq(d.at(0), 4)
			assert eq(d.at(1), 5)
		}

		@test()
		def TestContainsRemove() {
			let d = new Deque<int>(4)
			for let i = 1; i <= 6; i++ {
				d.pushBack(i)
			}
			assert d.contains(4)
			assert !d.contains(7)

			assert d.remove(2) // front half: shifts head
			assert d.len() == 5
			assert eq(d.at(0), 1)
			assert eq(d.at(1), 3)

			assert d.remove(5) // back half: shifts tail
			assert d.len() == 4
			assert eq(d.at(2), 4)
			assert eq(d.at(3), 6)

			assert !d.remove(42)
			assert d.remove(1)
			assert d.remove(3)
			assert d.remove(4)
			assert d.remove(6)
			assert d.isEmpty()
			assert !d.remove(6)
		}

		@test()
		def TestClearReserve() {
			let d = new Deque<int>(2)
			d.pushBack(1)
			d.pushBack(2)
			d.clear()
			assert d.isEmpty()
			assert d.capacity() == 2
			d.pushBack(9)
			assert eq(d.front(), 9)

			d.reserve(32)
			assert d.capacity() == 32
			assert eq(d.front(), 9)
			d.reserve(4)
			assert d.capacity() == 32
		}

		@test()
		def TestIterate() {
			let d = new Deque<int>()
			d.pushBack(1)
			d.pushBack(2)
			d.pushFront(0)
			let seen int[]
			for let v in d {
				seen.push(v)
			}
			assert seen.equals(int[0, 1, 2])
			// The cursor resets, so a second pass sees the same sequence.
			let again int[]
			for let v in d {
				again.push(v)
			}
			assert again.equals(seen)
		}
	}
}
