partial module std.data.collections {
	// Graph is an undirected graph over hashable vertices, stored as
	// adjacency lists.
	//
	// Vertices and each vertex's neighbours keep insertion order, so
	// traversals are deterministic.
	type Graph<T: Serializable> {
		internal order    T[]
		internal adjacent map<T, T[]>
		internal edges    int

		def new() {}

		// Returns the number of vertices.
		def len() int {
			return order.len()
		}

		// Returns the number of edges.
		def edgeCount() int {
			return edges
		}

		// Reports whether the graph has no vertices.
		def isEmpty() bool {
			return order.len() == 0
		}

		// Removes every vertex and edge.
		def clear() {
			order.flush()
			adjacent = map<T, T[]>{}
			edges = 0
		}

		// Adds a vertex. Returns false when it was already present.
		def addVertex(vertex T) bool {
			return false when adjacent.hasKey(vertex)
			adjacent = adjacent.set(vertex, T[])
			order.push(vertex)
			return true
		}

		// Adds an edge between a and b, adding either vertex when missing.
		// Returns false when the edge already existed.
		def addEdge(a T, b T) bool {
			addVertex(a)
			addVertex(b)
			return false when hasEdge(a, b)
			link(a, b)
			link(b, a) unless a == b
			edges += 1
			return true
		}

		// Removes the edge between a and b. Returns false when absent.
		def removeEdge(a T, b T) bool {
			return false unless hasEdge(a, b)
			unlink(a, b)
			unlink(b, a) unless a == b
			edges -= 1
			return true
		}

		// Removes a vertex and every edge touching it. Returns false when
		// absent.
		def removeVertex(vertex T) bool {
			return false unless adjacent.hasKey(vertex)
			for let (_, other) in neighbors(vertex) {
				removeEdge(vertex, other)
			}
			adjacent = adjacent.delete(vertex)
			order.remove(order.indexOf(vertex))
			return true
		}

		// Reports whether vertex is present.
		def hasVertex(vertex T) bool {
			return adjacent.hasKey(vertex)
		}

		// Reports whether an edge joins a and b.
		def hasEdge(a T, b T) bool {
			let list = adjacent.get(a)
			return false when list is none
			return list.includes(b)
		}

		// Returns the vertices adjacent to vertex, in insertion order.
		def neighbors(vertex T) T[] {
			let list = adjacent.get(vertex)
			return T[] when list is none
			return list.clone()
		}

		// Returns the number of edges touching vertex.
		def degree(vertex T) int {
			let list = adjacent.get(vertex)
			return 0 when list is none
			return list.len()
		}

		// Returns the vertices in insertion order.
		def vertices() T[] {
			return order.clone()
		}

		// Returns the vertices reachable from start in breadth-first order.
		def bfs(start T) T[] {
			let out T[]
			return out unless adjacent.hasKey(start)
			let seen = new HashSet<T>()
			let queue = new Queue<T>()
			queue.push(start)
			seen.add(start)
			for {
				let v = queue.pop()
				break when v is none
				out.push(v)
				for let (_, n) in neighbors(v) {
					queue.push(n) when seen.add(n)
				}
			}
			return out
		}

		// Returns the vertices reachable from start in depth-first order.
		def dfs(start T) T[] {
			let out T[]
			return out unless adjacent.hasKey(start)
			let seen = new HashSet<T>()
			visit(start, seen, out)
			return out
		}

		// Reports whether some path joins a and b.
		def hasPath(a T, b T) bool {
			return shortestPath(a, b).len() > 0
		}

		// Returns the vertices along a shortest path from a to b (fewest
		// edges), inclusive; empty when none exists.
		def shortestPath(a T, b T) T[] {
			let out T[]
			return out unless adjacent.hasKey(a) && adjacent.hasKey(b)
			let parent = new HashMap<T, T>()
			let seen = new HashSet<T>()
			let queue = new Queue<T>()
			queue.push(a)
			seen.add(a)
			let found = a == b
			for !found {
				let v = queue.pop()
				break when v is none
				for let (_, n) in neighbors(v) {
					continue unless seen.add(n)
					parent.set(n, v)
					if n == b {
						found = true
						break
					}
					queue.push(n)
				}
			}
			return out unless found
			let cur = b
			out.push(cur)
			for cur != a {
				let p = parent.get(cur)
				break when p is none
				cur = p
				out.push(cur)
			}
			out.reverse()
			return out
		}

		// Reports whether every vertex is reachable from every other.
		def isConnected() bool {
			return true when order.len() == 0
			return bfs(order[0]).len() == order.len()
		}

		internal def link(from T, to T) {
			let list = adjacent.get(from)
			return when list is none
			list.push(to)
			adjacent = adjacent.set(from, list)
		}

		internal def unlink(from T, to T) {
			let list = adjacent.get(from)
			return when list is none
			let i = list.indexOf(to)
			return when i < 0
			list.remove(i)
			adjacent = adjacent.set(from, list)
		}

		internal def visit(vertex T, seen HashSet<T>, out T[]) {
			return unless seen.add(vertex)
			out.push(vertex)
			for let (_, n) in neighbors(vertex) {
				visit(n, seen, out)
			}
		}
	}

	// DirectedGraph is a graph whose edges have a direction.
	//
	// Vertices and each vertex's successors keep insertion order.
	type DirectedGraph<T: Serializable> {
		internal order      T[]
		internal successors map<T, T[]>
		internal edges      int

		def new() {}

		// Returns the number of vertices.
		def len() int {
			return order.len()
		}

		// Returns the number of edges.
		def edgeCount() int {
			return edges
		}

		// Reports whether the graph has no vertices.
		def isEmpty() bool {
			return order.len() == 0
		}

		// Removes every vertex and edge.
		def clear() {
			order.flush()
			successors = map<T, T[]>{}
			edges = 0
		}

		// Adds a vertex. Returns false when it was already present.
		def addVertex(vertex T) bool {
			return false when successors.hasKey(vertex)
			successors = successors.set(vertex, T[])
			order.push(vertex)
			return true
		}

		// Adds an edge from a to b, adding either vertex when missing.
		// Returns false when the edge already existed.
		def addEdge(from T, to T) bool {
			addVertex(from)
			addVertex(to)
			return false when hasEdge(from, to)
			let list = successors.get(from)
			return false when list is none
			list.push(to)
			successors = successors.set(from, list)
			edges += 1
			return true
		}

		// Removes the edge from a to b. Returns false when absent.
		def removeEdge(from T, to T) bool {
			let list = successors.get(from)
			return false when list is none
			let i = list.indexOf(to)
			return false when i < 0
			list.remove(i)
			successors = successors.set(from, list)
			edges -= 1
			return true
		}

		// Removes a vertex and every edge touching it. Returns false when
		// absent.
		def removeVertex(vertex T) bool {
			return false unless successors.hasKey(vertex)
			edges -= outDegree(vertex)
			successors = successors.delete(vertex)
			order.remove(order.indexOf(vertex))
			for let (_, v) in order {
				removeEdge(v, vertex)
			}
			return true
		}

		// Reports whether vertex is present.
		def hasVertex(vertex T) bool {
			return successors.hasKey(vertex)
		}

		// Reports whether an edge runs from a to b.
		def hasEdge(from T, to T) bool {
			let list = successors.get(from)
			return false when list is none
			return list.includes(to)
		}

		// Returns the vertices with an edge from vertex, in insertion order.
		def neighbors(vertex T) T[] {
			let list = successors.get(vertex)
			return T[] when list is none
			return list.clone()
		}

		// Returns the vertices with an edge to vertex, in vertex order.
		def predecessors(vertex T) T[] {
			let out T[]
			for let (_, v) in order {
				out.push(v) when hasEdge(v, vertex)
			}
			return out
		}

		// Returns the number of edges leaving vertex.
		def outDegree(vertex T) int {
			let list = successors.get(vertex)
			return 0 when list is none
			return list.len()
		}

		// Returns the number of edges entering vertex.
		def inDegree(vertex T) int {
			return predecessors(vertex).len()
		}

		// Returns the vertices in insertion order.
		def vertices() T[] {
			return order.clone()
		}

		// Returns the vertices reachable from start in breadth-first order.
		def bfs(start T) T[] {
			let out T[]
			return out unless successors.hasKey(start)
			let seen = new HashSet<T>()
			let queue = new Queue<T>()
			queue.push(start)
			seen.add(start)
			for {
				let v = queue.pop()
				break when v is none
				out.push(v)
				for let (_, n) in neighbors(v) {
					queue.push(n) when seen.add(n)
				}
			}
			return out
		}

		// Returns the vertices reachable from start in depth-first order.
		def dfs(start T) T[] {
			let out T[]
			return out unless successors.hasKey(start)
			let seen = new HashSet<T>()
			visit(start, seen, out)
			return out
		}

		// Reports whether b is reachable from a.
		def hasPath(from T, to T) bool {
			return bfs(from).includes(to)
		}

		// Returns the vertices in an order where every edge points forward,
		// or none when the graph has a cycle.
		def topologicalSort() ?T[] {
			let remaining = new HashMap<T, int>()
			for let (_, v) in order {
				remaining.set(v, inDegree(v))
			}
			let ready = new Queue<T>()
			for let (_, v) in order {
				ready.push(v) when remaining.get(v, 0) == 0
			}
			let out T[]
			for {
				let v = ready.pop()
				break when v is none
				out.push(v)
				for let (_, n) in neighbors(v) {
					let left = remaining.get(n, 0) - 1
					remaining.set(n, left)
					ready.push(n) when left == 0
				}
			}
			return none when out.len() != order.len()
			return out
		}

		// Reports whether the graph contains a cycle.
		def hasCycle() bool {
			return topologicalSort() is none
		}

		internal def visit(vertex T, seen HashSet<T>, out T[]) {
			return unless seen.add(vertex)
			out.push(vertex)
			for let (_, n) in neighbors(vertex) {
				visit(n, seen, out)
			}
		}
	}

	// WeightedEdge is an edge of a WeightedGraph: its far vertex and weight.
	type WeightedEdge<T> {
		to     T
		weight float

		def new(to T, weight float) {
			self.to = to
			self.weight = weight
		}
	}

	// WeightedGraph is a graph whose edges carry a weight, undirected by
	// default.
	//
	// Vertices and each vertex's edges keep insertion order.
	type WeightedGraph<T: Serializable> {
		internal directed bool
		internal order    T[]
		internal adjacent map<T, WeightedEdge<T>[]>
		internal edges    int

		// Creates an empty graph; directed selects one-way edges.
		def new(directed bool = false) {
			self.directed = directed
		}

		// Reports whether edges are one-way.
		def isDirected() bool {
			return directed
		}

		// Returns the number of vertices.
		def len() int {
			return order.len()
		}

		// Returns the number of edges.
		def edgeCount() int {
			return edges
		}

		// Reports whether the graph has no vertices.
		def isEmpty() bool {
			return order.len() == 0
		}

		// Removes every vertex and edge.
		def clear() {
			order.flush()
			adjacent = map<T, WeightedEdge<T>[]>{}
			edges = 0
		}

		// Adds a vertex. Returns false when it was already present.
		def addVertex(vertex T) bool {
			return false when adjacent.hasKey(vertex)
			adjacent = adjacent.set(vertex, WeightedEdge<T>[])
			order.push(vertex)
			return true
		}

		// Adds an edge with the given weight, adding either vertex when
		// missing. An existing edge has its weight replaced. Returns false
		// when the edge already existed.
		def addEdge(from T, to T, weight float) bool {
			addVertex(from)
			addVertex(to)
			let existed = hasEdge(from, to)
			link(from, to, weight)
			link(to, from, weight) unless directed || from == to
			edges += 1 unless existed
			return !existed
		}

		// Removes the edge between a and b. Returns false when absent.
		def removeEdge(from T, to T) bool {
			return false unless hasEdge(from, to)
			unlink(from, to)
			unlink(to, from) unless directed || from == to
			edges -= 1
			return true
		}

		// Removes a vertex and every edge touching it. Returns false when
		// absent.
		def removeVertex(vertex T) bool {
			return false unless adjacent.hasKey(vertex)
			for let (_, e) in edgesFrom(vertex) {
				removeEdge(vertex, e.to)
			}
			for let (_, v) in order {
				removeEdge(v, vertex) when hasEdge(v, vertex)
			}
			adjacent = adjacent.delete(vertex)
			order.remove(order.indexOf(vertex))
			return true
		}

		// Reports whether vertex is present.
		def hasVertex(vertex T) bool {
			return adjacent.hasKey(vertex)
		}

		// Reports whether an edge runs from a to b.
		def hasEdge(from T, to T) bool {
			return !(weight(from, to) is none)
		}

		// Returns the weight of the edge from a to b, or none when absent.
		def weight(from T, to T) ?float {
			let list = adjacent.get(from)
			return none when list is none
			for let (_, e) in list {
				return e.weight when e.to == to
			}
			return none
		}

		// Returns the edges leaving vertex, in insertion order.
		def edgesFrom(vertex T) WeightedEdge<T>[] {
			let list = adjacent.get(vertex)
			return WeightedEdge<T>[] when list is none
			return list.clone()
		}

		// Returns the vertices adjacent to vertex, in insertion order.
		def neighbors(vertex T) T[] {
			let out T[]
			for let (_, e) in edgesFrom(vertex) {
				out.push(e.to)
			}
			return out
		}

		// Returns the vertices in insertion order.
		def vertices() T[] {
			return order.clone()
		}

		// Returns the total weight of the lightest path from a to b, or none
		// when b is unreachable. Weights must not be negative.
		def distance(from T, to T) ?float {
			let dist = new HashMap<T, float>()
			let parent = new HashMap<T, T>()
			return none unless dijkstra(from, to, dist, parent)
			return dist.get(to)
		}

		// Returns the vertices along the lightest path from a to b,
		// inclusive; empty when b is unreachable. Weights must not be
		// negative.
		def shortestPath(from T, to T) T[] {
			let out T[]
			let dist = new HashMap<T, float>()
			let parent = new HashMap<T, T>()
			return out unless dijkstra(from, to, dist, parent)
			let cur = to
			out.push(cur)
			for cur != from {
				let p = parent.get(cur)
				break when p is none
				cur = p
				out.push(cur)
			}
			out.reverse()
			return out
		}

		// Returns the total weight of every edge.
		def totalWeight() float {
			let total = 0.0
			for let (_, v) in order {
				for let (_, e) in edgesFrom(v) {
					total += e.weight
				}
			}
			return directed ?? (total, total / 2.0)
		}

		// Runs Dijkstra from start, filling dist and parent, and reports
		// whether target was reached.
		internal def dijkstra(start T, target T, dist HashMap<T, float>, parent HashMap<T, T>) bool {
			return false unless adjacent.hasKey(start) && adjacent.hasKey(target)
			let done = new HashSet<T>()
			dist.set(start, 0.0)
			for {
				// Pick the unfinished vertex with the smallest tentative distance.
				let best ?T = none
				let bestDist = 0.0
				for let (_, v) in order {
					continue when done.has(v)
					let d = dist.get(v)
					continue when d is none
					if best is none || d < bestDist {
						best = v
						bestDist = d
					}
				}
				let current = best
				return done.has(target) when current is none
				return true when current == target
				done.add(current)
				for let (_, e) in edgesFrom(current) {
					continue when done.has(e.to)
					let candidate = bestDist + e.weight
					let known = dist.get(e.to)
					let improved = true
					improved = candidate < known unless known is none
					if improved {
						dist.set(e.to, candidate)
						parent.set(e.to, current)
					}
				}
			}
			return false
		}

		internal def link(from T, to T, weight float) {
			let list = adjacent.get(from)
			return when list is none
			for let i = 0; i < list.len(); i++ {
				if list[i].to == to {
					list[i].weight = weight
					adjacent = adjacent.set(from, list)
					return
				}
			}
			list.push(new WeightedEdge<T>(to, weight))
			adjacent = adjacent.set(from, list)
		}

		internal def unlink(from T, to T) {
			let list = adjacent.get(from)
			return when list is none
			for let i = 0; i < list.len(); i++ {
				if list[i].to == to {
					list.remove(i)
					adjacent = adjacent.set(from, list)
					return
				}
			}
		}
	}
}
