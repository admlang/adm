partial module std.data.collections {
	use std.testing

	check "Graph" {
		@test()
		def TestEdges() {
			let g = new Graph<string>()
			assert g.isEmpty()
			assert g.addVertex("a")
			assert !g.addVertex("a")
			assert g.addEdge("a", "b")
			assert g.addEdge("b", "c")
			assert g.addEdge("c", "a")
			assert g.addEdge("d", "e")
			assert !g.addEdge("b", "a")
			assert g.len() == 5
			assert g.edgeCount() == 4
			assert g.hasEdge("a", "b")
			assert g.hasEdge("b", "a")
			assert !g.hasEdge("a", "d")
			assert g.degree("a") == 2
			assert g.degree("zzz") == 0
			assert g.neighbors("a").equals(string["b", "c"])
			assert g.vertices().equals(string["a", "b", "c", "d", "e"])
			assert !g.isConnected()
			assert g.addEdge("c", "d")
			assert g.isConnected()

			assert g.removeEdge("c", "d")
			assert !g.removeEdge("c", "d")
			assert g.edgeCount() == 4
			assert g.removeVertex("c")
			assert !g.removeVertex("c")
			assert g.len() == 4
			assert g.edgeCount() == 2
			assert g.neighbors("a").equals(string["b"])
			g.clear()
			assert g.isEmpty()
			assert g.edgeCount() == 0
		}

		@test()
		def TestTraversal() {
			let g = new Graph<int>()
			g.addEdge(1, 2)
			g.addEdge(1, 3)
			g.addEdge(2, 4)
			g.addEdge(3, 4)
			g.addEdge(4, 5)
			g.addVertex(9)
			assert g.bfs(1).equals(int[1, 2, 3, 4, 5])
			assert g.dfs(1).equals(int[1, 2, 4, 3, 5])
			assert g.bfs(42).len() == 0
			assert g.shortestPath(1, 5).equals(int[1, 2, 4, 5])
			assert g.shortestPath(5, 1).equals(int[5, 4, 2, 1])
			assert g.shortestPath(1, 1).equals(int[1])
			assert g.shortestPath(1, 9).len() == 0
			assert g.hasPath(2, 3)
			assert !g.hasPath(1, 9)
			assert !g.hasPath(1, 42)
		}
	}

	check "DirectedGraph" {
		@test()
		def TestEdgesAndOrder() {
			let g = new DirectedGraph<string>()
			assert g.addEdge("shirt", "tie")
			assert g.addEdge("tie", "jacket")
			assert g.addEdge("pants", "shoes")
			assert g.addEdge("pants", "jacket")
			assert g.addEdge("socks", "shoes")
			assert !g.addEdge("shirt", "tie")
			assert g.len() == 6
			assert g.edgeCount() == 5
			assert g.hasEdge("shirt", "tie")
			assert !g.hasEdge("tie", "shirt")
			assert g.outDegree("pants") == 2
			assert g.inDegree("jacket") == 2
			assert g.inDegree("shirt") == 0
			assert g.predecessors("shoes").equals(string["pants", "socks"])
			assert g.neighbors("pants").equals(string["shoes", "jacket"])
			assert g.hasPath("shirt", "jacket")
			assert !g.hasPath("jacket", "shirt")
			assert !g.hasCycle()

			let order = g.topologicalSort()
			assert !(order is none)
			if !(order is none) {
				assert order.len() == 6
				assert order.indexOf("shirt") < order.indexOf("tie")
				assert order.indexOf("tie") < order.indexOf("jacket")
				assert order.indexOf("pants") < order.indexOf("shoes")
				assert order.indexOf("socks") < order.indexOf("shoes")
			}

			assert g.addEdge("jacket", "shirt")
			assert g.hasCycle()
			assert g.topologicalSort() is none
			assert g.removeEdge("jacket", "shirt")
			assert !g.removeEdge("jacket", "shirt")
			assert !g.hasCycle()

			assert g.bfs("pants").equals(string["pants", "shoes", "jacket"])
			assert g.dfs("shirt").equals(string["shirt", "tie", "jacket"])
			assert g.removeVertex("jacket")
			assert g.edgeCount() == 3
			assert g.outDegree("tie") == 0
			assert g.vertices().len() == 5
			g.clear()
			assert g.isEmpty()
		}
	}

	check "WeightedGraph" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestUndirected() {
			let g = new WeightedGraph<string>()
			assert !g.isDirected()
			assert g.addEdge("a", "b", 4.0)
			assert g.addEdge("a", "c", 1.0)
			assert g.addEdge("c", "b", 2.0)
			assert g.addEdge("b", "d", 5.0)
			assert g.addEdge("c", "d", 8.0)
			assert !g.addEdge("b", "a", 3.5)
			assert eq(g.weight("a", "b"), 3.5)
			assert eq(g.weight("b", "a"), 3.5)
			assert g.weight("a", "d") is none
			assert g.len() == 4
			assert g.edgeCount() == 5
			assert g.neighbors("c").equals(string["a", "b", "d"])
			assert g.edgesFrom("a").len() == 2
			assert g.totalWeight() == 19.5

			assert eq(g.distance("a", "d"), 8.0)
			assert g.shortestPath("a", "d").equals(string["a", "c", "b", "d"])
			assert g.shortestPath("d", "a").equals(string["d", "b", "c", "a"])
			assert eq(g.distance("a", "a"), 0.0)
			g.addVertex("z")
			assert g.distance("a", "z") is none
			assert g.shortestPath("a", "z").len() == 0
			assert g.distance("a", "missing") is none

			assert g.removeEdge("c", "b")
			assert eq(g.distance("a", "d"), 8.5)
			assert g.shortestPath("a", "d").equals(string["a", "b", "d"])
			assert g.removeVertex("b")
			assert g.edgeCount() == 2
			assert eq(g.distance("a", "d"), 9.0)
			g.clear()
			assert g.isEmpty()
		}

		@test()
		def TestDirected() {
			let g = new WeightedGraph<int>(true)
			assert g.isDirected()
			g.addEdge(1, 2, 1.0)
			g.addEdge(2, 3, 1.0)
			g.addEdge(1, 3, 5.0)
			assert g.hasEdge(1, 2)
			assert !g.hasEdge(2, 1)
			assert g.totalWeight() == 7.0
			assert eq(g.distance(1, 3), 2.0)
			assert g.shortestPath(1, 3).equals(int[1, 2, 3])
			assert g.distance(3, 1) is none
			assert g.removeVertex(2)
			assert eq(g.distance(1, 3), 5.0)
		}
	}
}
