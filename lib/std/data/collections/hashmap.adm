partial module std.data.collections {
	// Entry is a key/value pair yielded by map iteration.
	type Entry<K, V> {
		key   K
		value V

		def new(key K, value V) {
			self.key = key
			self.value = value
		}
	}

	// HashMap is an unordered key/value map over hashable keys.
	//
	// Iteration yields entries in no particular order.
	type HashMap<K: Serializable, V> {
		internal store    map<K, V>
		internal snapshot Entry<K, V>[]
		internal cur      int

		def new() {}

		// Returns the number of entries.
		def len() int {
			return store.len()
		}

		// Reports whether the map holds no entries.
		def isEmpty() bool {
			return store.len() == 0
		}

		// Removes every entry.
		def clear() {
			store = map<K, V>{}
		}

		// Associates value with key, replacing any existing value.
		def set(key K, value V) {
			store = store.set(key, value)
		}

		// Returns the value for key, or none when absent.
		def get(key K) ?V {
			return store.get(key)
		}

		// Returns the value for key, or fallback when absent.
		def get(key K, fallback V) V {
			let v = store.get(key)
			return fallback when v is none
			return v
		}

		// Reports whether key is present.
		def has(key K) bool {
			return store.hasKey(key)
		}

		// Removes key. Returns false when it was absent.
		def delete(key K) bool {
			return false unless store.hasKey(key)
			store = store.delete(key)
			return true
		}

		// Returns the keys in no particular order.
		def keys() K[] {
			return store.keys()
		}

		// Returns the values in no particular order.
		def values() V[] {
			return store.values()
		}

		// Returns the entries in no particular order.
		def entries() Entry<K, V>[] {
			let out Entry<K, V>[]
			for let (k, v) in store {
				out.push(new Entry<K, V>(k, v))
			}
			return out
		}

		// Returns the next entry; none after the last, which also resets the
		// cursor. The set of entries is captured when iteration starts.
		def iterate() ?Entry<K, V> {
			snapshot = entries() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let e = snapshot[cur]
			cur += 1
			return e
		}
	}
}
