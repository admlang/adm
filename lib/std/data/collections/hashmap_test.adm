partial module std.data.collections {
	use std.testing

	check "HashMap" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestBasics() {
			let m = new HashMap<string, int>()
			assert m.isEmpty()
			assert m.get("a") is none
			assert m.get("a", -1) == -1
			m.set("a", 1)
			m.set("b", 2)
			m.set("a", 3)
			assert m.len() == 2
			assert eq(m.get("a"), 3)
			assert m.get("b", 0) == 2
			assert m.has("b")
			assert !m.has("c")
			assert m.delete("b")
			assert !m.delete("b")
			assert m.len() == 1
			assert m.keys().equals(string["a"])
			assert m.values().equals(int[3])
			m.clear()
			assert m.isEmpty()
			assert !m.has("a")
		}

		@test()
		def TestEntriesAndIterate() {
			let m = new HashMap<int, string>()
			m.set(1, "one")
			m.set(2, "two")
			let total = 0
			for let e in m {
				total += e.key
				assert e.value == "one" || e.value == "two"
			}
			assert total == 3
			let es = m.entries()
			assert es.len() == 2
			let again = 0
			for let e in m {
				again += e.key
			}
			assert again == 3
		}
	}
}
