partial module std.data.collections {
	// Returns the 64-bit FNV-1a hash of key, mixed with seed.
	def fnv1a(key string, seed uint64 = 0) uint64 {
		let h = uint64(14695981039346656037) ^ seed
		for let (_, b) in key.bytes() {
			h = h ^ uint64(b)
			h = h * uint64(1099511628211)
		}
		return h
	}

	// HashTable is a string-keyed hash table using open addressing with
	// linear probing.
	//
	// The table grows when three quarters of its slots are in use.
	// Iteration yields entries in slot order, which is not insertion order.
	type HashTable<V> {
		internal keyList   string[]
		internal valueList V[]
		// 0 = empty, 1 = occupied, 2 = deleted
		internal states    byte[]
		internal count     int
		internal used      int
		internal cur       int

		// Creates a table with room for capacity entries before it grows.
		def new(capacity int = 16) {
			resize(nextCapacity(capacity.max(8)))
		}

		// Returns the number of entries.
		def len() int {
			return count
		}

		// Reports whether the table holds no entries.
		def isEmpty() bool {
			return count == 0
		}

		// Returns the number of slots currently allocated.
		def capacity() int {
			return states.len()
		}

		// Removes every entry while keeping the allocated slots.
		def clear() {
			for let i = 0; i < states.len(); i++ {
				states[i] = 0
			}
			count = 0
			used = 0
		}

		// Associates value with key, replacing any existing value.
		def set(key string, value V) {
			resize(states.len() * 2) when (used + 1) * 4 > states.len() * 3
			let slot = probe(key)
			if states[slot] == 1 {
				valueList[slot] = value
				return
			}
			used += 1 when states[slot] == 0
			keyList[slot] = key
			valueList[slot] = value
			states[slot] = 1
			count += 1
		}

		// Returns the value for key, or none when absent.
		def get(key string) ?V {
			let slot = probe(key)
			return none when states[slot] != 1
			return valueList[slot]
		}

		// Returns the value for key, or fallback when absent.
		def get(key string, fallback V) V {
			let v = get(key)
			return fallback when v is none
			return v
		}

		// Reports whether key is present.
		def has(key string) bool {
			return states[probe(key)] == 1
		}

		// Removes key. Returns false when it was absent.
		def delete(key string) bool {
			let slot = probe(key)
			return false when states[slot] != 1
			states[slot] = 2
			count -= 1
			return true
		}

		// Returns the keys in slot order.
		def keys() string[] {
			let out string[]
			for let i = 0; i < states.len(); i++ {
				out.push(keyList[i]) when states[i] == 1
			}
			return out
		}

		// Returns the values in slot order.
		def values() V[] {
			let out V[]
			for let i = 0; i < states.len(); i++ {
				out.push(valueList[i]) when states[i] == 1
			}
			return out
		}

		// Returns the entries in slot order.
		def entries() Entry<string, V>[] {
			let out Entry<string, V>[]
			for let i = 0; i < states.len(); i++ {
				out.push(new Entry<string, V>(keyList[i], valueList[i])) when states[i] == 1
			}
			return out
		}

		// Returns the next entry in slot order; none after the last, which
		// also resets the cursor.
		def iterate() ?Entry<string, V> {
			for cur < states.len() {
				let slot = cur
				cur += 1
				return new Entry<string, V>(keyList[slot], valueList[slot]) when states[slot] == 1
			}
			cur = 0
			return none
		}

		// Returns the slot holding key, or the first free slot on its probe
		// path. Deleted slots are reused only when the key is absent.
		internal def probe(key string) int {
			let mask = states.len() - 1
			let slot = int(fnv1a(key) & uint64(mask))
			let tombstone = -1
			for {
				let state = states[slot]
				if state == 0 {
					return tombstone when tombstone >= 0
					return slot
				}
				return slot when state == 1 && keyList[slot] == key
				tombstone = slot when state == 2 && tombstone < 0
				slot = (slot + 1) & mask
			}
			return slot
		}

		// Rebuilds the table with the given power-of-two capacity, dropping
		// deleted slots.
		internal def resize(capacity int) {
			let oldKeys = keyList
			let oldValues = valueList
			let oldStates = states

			keyList = string[]
			valueList = V[]
			states = byte[]
			keyList.len(capacity)
			valueList.len(capacity)
			states.len(capacity)
			count = 0
			used = 0

			for let i = 0; i < oldStates.len(); i++ {
				set(oldKeys[i], oldValues[i]) when oldStates[i] == 1
			}
		}

		// Returns the smallest power of two not below n.
		internal def nextCapacity(n int) int {
			let c = 1
			for c < n {
				c *= 2
			}
			return c
		}
	}
}
