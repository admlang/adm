partial module std.data.collections {
	use std.testing

	check "HashTable" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestHash() {
			assert fnv1a("") == uint64(14695981039346656037)
			assert fnv1a("a") != fnv1a("b")
			assert fnv1a("a") == fnv1a("a")
			assert fnv1a("a", 1) != fnv1a("a")
		}

		@test()
		def TestSetGetDelete() {
			let t = new HashTable<int>(4)
			assert t.isEmpty()
			assert t.capacity() == 8
			assert t.get("x") is none
			assert t.get("x", -1) == -1
			t.set("a", 1)
			t.set("b", 2)
			t.set("a", 10)
			assert t.len() == 2
			assert eq(t.get("a"), 10)
			assert t.get("b", 0) == 2
			assert t.has("b")
			assert !t.has("c")
			assert t.delete("a")
			assert !t.delete("a")
			assert t.get("a") is none
			assert t.len() == 1
			t.set("a", 3)
			assert eq(t.get("a"), 3)
			assert t.keys().len() == 2
			assert t.values().len() == 2
			t.clear()
			assert t.isEmpty()
			assert !t.has("b")
		}

		@test()
		def TestGrowth() {
			let t = new HashTable<int>(4)
			for let i = 0; i < 200; i++ {
				t.set("key" + i.str(), i)
			}
			assert t.len() == 200
			assert t.capacity() >= 256
			for let i = 0; i < 200; i++ {
				assert eq(t.get("key" + i.str()), i)
			}
			for let i = 0; i < 200; i += 2 {
				assert t.delete("key" + i.str())
			}
			assert t.len() == 100
			assert !t.has("key0")
			assert eq(t.get("key1"), 1)
			assert eq(t.get("key199"), 199)

			let total = 0
			for let e in t {
				total += e.value
			}
			assert total == 10000
			assert t.entries().len() == 100
		}
	}
}
