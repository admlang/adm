partial module std.data.collections {
	// Heap is a binary heap ordered by a caller-supplied comparison.
	//
	// The element for which less holds against every other element sits at
	// the top. Push and pop are O(log n); peek is O(1). Iteration yields the
	// elements in storage order, which is not sorted order.
	type Heap<T> {
		internal less  def (T, T) bool
		internal items T[]
		internal cur   int

		// Creates an empty heap; less reports whether a must come out before b.
		def new(less def (T, T) bool) {
			self.less = less
		}

		// Creates a heap holding values, ordered by less.
		def new(less def (T, T) bool, values T[]) {
			self.less = less
			items = values.clone()
			for let i = items.len() / 2 - 1; i >= 0; i-- {
				siftDown(i)
			}
		}

		// Returns the number of elements.
		def len() int {
			return items.len()
		}

		// Reports whether the heap holds no elements.
		def isEmpty() bool {
			return items.len() == 0
		}

		// Removes every element.
		def clear() {
			items.flush()
		}

		// Adds a value.
		def push(value T) {
			items.push(value)
			siftUp(items.len() - 1)
		}

		// Removes and returns the top element, or none when empty.
		def pop() ?T {
			return none when items.len() == 0
			let top = items[0]
			let last = items.pop()
			if items.len() > 0 {
				items[0] = last
				siftDown(0)
			}
			return top
		}

		// Returns the top element without removing it, or none when empty.
		def peek() ?T {
			return none when items.len() == 0
			return items[0]
		}

		// Reports whether the heap contains value.
		def contains(value T) bool {
			return items.includes(value)
		}

		// Returns the elements in storage order.
		def toArray() T[] {
			return items.clone()
		}

		// Returns the elements in pop order without changing the heap.
		def sorted() T[] {
			let compare = less
			let copy = new Heap<T>(compare, items)
			let out T[]
			for {
				let v = copy.pop()
				break when v is none
				out.push(v)
			}
			return out
		}

		// Returns the next element in storage order; none after the last,
		// which also resets the cursor.
		def iterate() ?T {
			if cur >= items.len() {
				cur = 0
				return none
			}
			let v = items[cur]
			cur += 1
			return v
		}

		internal def siftUp(index int) {
			for index > 0 {
				let parent = (index - 1) / 2
				return unless less(items[index], items[parent])
				items[index], items[parent] = items[parent], items[index]
				index = parent
			}
		}

		internal def siftDown(index int) {
			let n = items.len()
			for {
				let left = index * 2 + 1
				let right = left + 1
				let best = index
				best = left when left < n && less(items[left], items[best])
				best = right when right < n && less(items[right], items[best])
				return when best == index
				items[index], items[best] = items[best], items[index]
				index = best
			}
		}
	}

	// MinHeap is a heap whose smallest element is on top.
	type MinHeap<T: Ordered> {
		internal heap Heap<T>

		def new() {
			heap = new Heap<T>((a T, b T) => a < b)
		}

		// Creates a min-heap holding values.
		def new(values T[]) {
			heap = new Heap<T>((a T, b T) => a < b, values)
		}

		// Returns the number of elements.
		def len() int {
			return heap.len()
		}

		// Reports whether the heap holds no elements.
		def isEmpty() bool {
			return heap.isEmpty()
		}

		// Removes every element.
		def clear() {
			heap.clear()
		}

		// Adds a value.
		def push(value T) {
			heap.push(value)
		}

		// Removes and returns the smallest element, or none when empty.
		def pop() ?T {
			return heap.pop()
		}

		// Returns the smallest element without removing it, or none when empty.
		def peek() ?T {
			return heap.peek()
		}

		// Reports whether the heap contains value.
		def contains(value T) bool {
			return heap.contains(value)
		}

		// Returns the elements in ascending order without changing the heap.
		def sorted() T[] {
			return heap.sorted()
		}

		// Returns the next element in storage order; none after the last,
		// which also resets the cursor.
		def iterate() ?T {
			return heap.iterate()
		}
	}

	// MaxHeap is a heap whose largest element is on top.
	type MaxHeap<T: Ordered> {
		internal heap Heap<T>

		def new() {
			heap = new Heap<T>((a T, b T) => a > b)
		}

		// Creates a max-heap holding values.
		def new(values T[]) {
			heap = new Heap<T>((a T, b T) => a > b, values)
		}

		// Returns the number of elements.
		def len() int {
			return heap.len()
		}

		// Reports whether the heap holds no elements.
		def isEmpty() bool {
			return heap.isEmpty()
		}

		// Removes every element.
		def clear() {
			heap.clear()
		}

		// Adds a value.
		def push(value T) {
			heap.push(value)
		}

		// Removes and returns the largest element, or none when empty.
		def pop() ?T {
			return heap.pop()
		}

		// Returns the largest element without removing it, or none when empty.
		def peek() ?T {
			return heap.peek()
		}

		// Reports whether the heap contains value.
		def contains(value T) bool {
			return heap.contains(value)
		}

		// Returns the elements in descending order without changing the heap.
		def sorted() T[] {
			return heap.sorted()
		}

		// Returns the next element in storage order; none after the last,
		// which also resets the cursor.
		def iterate() ?T {
			return heap.iterate()
		}
	}

	// A value queued with its priority and arrival order.
	internal type PriorityItem<T> {
		value    T
		priority int
		seq      int

		def new(value T, priority int, seq int) {
			self.value = value
			self.priority = priority
			self.seq = seq
		}
	}

	// PriorityQueue serves the element with the lowest priority value first;
	// elements with equal priority are served in insertion order.
	type PriorityQueue<T> {
		internal heap Heap<PriorityItem<T>>
		internal seq  int

		def new() {
			heap = new Heap<PriorityItem<T>> ((a PriorityItem<T>, b PriorityItem<T>) => a.priority < b.priority || (a.priority == b.priority && a.seq < b.seq))
		}

		// Returns the number of queued elements.
		def len() int {
			return heap.len()
		}

		// Reports whether the queue holds no elements.
		def isEmpty() bool {
			return heap.isEmpty()
		}

		// Removes every element.
		def clear() {
			heap.clear()
		}

		// Queues value with the given priority; lower values are served first.
		def push(value T, priority int) {
			seq += 1
			heap.push(new PriorityItem<T>(value, priority, seq))
		}

		// Removes and returns the highest-priority element, or none when empty.
		def pop() ?T {
			let item = heap.pop()
			return none when item is none
			return item.value
		}

		// Returns the highest-priority element without removing it, or none.
		def peek() ?T {
			let item = heap.peek()
			return none when item is none
			return item.value
		}

		// Returns the priority of the element at the front, or none when empty.
		def peekPriority() ?int {
			let item = heap.peek()
			return none when item is none
			return item.priority
		}

		// Returns the elements in service order without changing the queue.
		def sorted() T[] {
			let out T[]
			for let (_, item) in heap.sorted() {
				out.push(item.value)
			}
			return out
		}
	}
}
