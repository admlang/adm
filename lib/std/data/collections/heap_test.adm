partial module std.data.collections {
	use std.testing

	check "Heap" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestCustomOrder() {
			let h = new Heap<string>((a string, b string) => a.len() < b.len())
			assert h.isEmpty()
			assert h.pop() is none
			assert h.peek() is none
			h.push("ccc")
			h.push("a")
			h.push("bb")
			assert h.len() == 3
			assert eq(h.peek(), "a")
			assert h.contains("bb")
			assert h.sorted().equals(string["a", "bb", "ccc"])
			assert h.len() == 3
			assert eq(h.pop(), "a")
			assert eq(h.pop(), "bb")
			assert eq(h.pop(), "ccc")
			assert h.pop() is none
		}

		@test()
		def TestHeapify() {
			let h = new Heap<int>((a int, b int) => a < b, int[9, 4, 7, 1, 8, 2])
			assert h.len() == 6
			assert h.toArray().len() == 6
			assert eq(h.peek(), 1)
			assert h.sorted().equals(int[1, 2, 4, 7, 8, 9])
			let count = 0
			for let v in h {
				count += 1
			}
			assert count == 6
			h.clear()
			assert h.isEmpty()
		}
	}

	check "MinMaxHeap" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestMinHeap() {
			let h = new MinHeap<int>(int[5, 3, 8])
			h.push(1)
			h.push(4)
			assert h.len() == 5
			assert eq(h.peek(), 1)
			assert h.sorted().equals(int[1, 3, 4, 5, 8])
			assert eq(h.pop(), 1)
			assert eq(h.pop(), 3)
			assert h.contains(8)
			assert !h.contains(3)
			let n = 0
			for let v in h {
				n += 1
			}
			assert n == 3
			h.clear()
			assert h.isEmpty()
			assert h.pop() is none
		}

		@test()
		def TestMaxHeap() {
			let h = new MaxHeap<string>()
			assert h.peek() is none
			h.push("m")
			h.push("z")
			h.push("a")
			assert eq(h.peek(), "z")
			assert h.sorted().equals(string["z", "m", "a"])
			assert eq(h.pop(), "z")
			assert eq(h.pop(), "m")
			assert eq(h.pop(), "a")
			assert h.isEmpty()
			let f = new MaxHeap<float>(float[1.5, 2.5, 0.5])
			assert eq(f.pop(), 2.5)
		}
	}

	check "PriorityQueue" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestOrder() {
			let q = new PriorityQueue<string>()
			assert q.isEmpty()
			assert q.pop() is none
			assert q.peekPriority() is none
			q.push("low", 5)
			q.push("high", 1)
			q.push("mid", 3)
			q.push("high2", 1)
			assert q.len() == 4
			assert eq(q.peek(), "high")
			assert eq(q.peekPriority(), 1)
			assert q.sorted().equals(string["high", "high2", "mid", "low"])
			assert eq(q.pop(), "high")
			assert eq(q.pop(), "high2")
			assert eq(q.pop(), "mid")
			assert eq(q.pop(), "low")
			assert q.pop() is none
			q.push("x", 0)
			q.clear()
			assert q.isEmpty()
		}
	}
}
