partial module std.data.collections {
	// Node of a singly linked list.
	internal type ListNode<T> {
		value T
		next  ?ListNode<T>

		def new(value T) {
			self.value = value
		}
	}

	// LinkedList is a singly linked list with O(1) insertion at both ends
	// and O(1) removal at the front.
	//
	// Iteration yields elements front to back.
	type LinkedList<T> {
		internal head      ?ListNode<T>
		internal tail      ?ListNode<T>
		internal count     int
		internal cur       ?ListNode<T>
		internal iterating bool

		def new() {}

		// Returns the number of elements.
		def len() int {
			return count
		}

		// Reports whether the list holds no elements.
		def isEmpty() bool {
			return count == 0
		}

		// Removes all elements.
		def clear() {
			head = none
			tail = none
			count = 0
		}

		// Inserts a value at the front.
		def pushFront(value T) {
			let node = new ListNode<T>(value)
			node.next = head
			head = node
			tail = node when tail is none
			count += 1
		}

		// Appends a value at the back.
		def pushBack(value T) {
			let node = new ListNode<T>(value)
			let last = tail
			if last is none {
				head = node
			} else {
				last.next = node
			}
			tail = node
			count += 1
		}

		// Removes and returns the first element, or none when empty.
		def popFront() ?T {
			let first = head
			return none when first is none
			head = first.next
			tail = none when head is none
			count -= 1
			return first.value
		}

		// Removes and returns the last element, or none when empty. This walks
		// the list, so it costs O(n).
		def popBack() ?T {
			let last = tail
			return none when last is none
			let prev = previous(last)
			if prev is none {
				head = none
				tail = none
			} else {
				prev.next = none
				tail = prev
			}
			count -= 1
			return last.value
		}

		// Returns the first element without removing it, or none when empty.
		def front() ?T {
			let first = head
			return none when first is none
			return first.value
		}

		// Returns the last element without removing it, or none when empty.
		def back() ?T {
			let last = tail
			return none when last is none
			return last.value
		}

		// Returns the element at the given position, or none when out of range.
		// Negative indices count from the back.
		def at(index int) ?T {
			index += count when index < 0
			return none when index < 0 || index >= count
			let node = nodeAt(index)
			return none when node is none
			return node.value
		}

		// Reports whether the list contains value.
		def contains(value T) bool {
			return indexOf(value) >= 0
		}

		// Returns the position of the first occurrence of value, or -1.
		def indexOf(value T) int {
			let node = head
			let index = 0
			for {
				let n = node
				break when n is none
				return index when n.value == value
				node = n.next
				index += 1
			}
			return -1
		}

		// Inserts a value before the element at index. An index equal to the
		// length appends. Returns false when the index is out of range.
		def insert(index int, value T) bool {
			index += count when index < 0
			return false when index < 0 || index > count
			if index == 0 {
				pushFront(value)
				return true
			}
			if index == count {
				pushBack(value)
				return true
			}
			let prev = nodeAt(index - 1)
			return false when prev is none
			let node = new ListNode<T>(value)
			node.next = prev.next
			prev.next = node
			count += 1
			return true
		}

		// Removes the first occurrence of value. Returns whether one was found.
		def remove(value T) bool {
			let first = head
			return false when first is none
			if first.value == value {
				popFront()
				return true
			}
			let prev = first
			for {
				let n = prev.next
				return false when n is none
				if n.value == value {
					prev.next = n.next
					tail = prev when n.next is none
					count -= 1
					return true
				}
				prev = n
			}
			return false
		}

		// Removes and returns the element at index, or none when out of range.
		def removeAt(index int) ?T {
			index += count when index < 0
			return none when index < 0 || index >= count
			return popFront() when index == 0
			let prev = nodeAt(index - 1)
			return none when prev is none
			let target = prev.next
			return none when target is none
			prev.next = target.next
			tail = prev when target.next is none
			count -= 1
			return target.value
		}

		// Reverses the list in place.
		def reverse() {
			let prev ?ListNode<T> = none
			let node = head
			tail = head
			for {
				let n = node
				break when n is none
				node = n.next
				n.next = prev
				prev = n
			}
			head = prev
		}

		// Returns the elements as a new array, front first.
		def toArray() T[] {
			let out T[]
			let node = head
			for {
				let n = node
				break when n is none
				out.push(n.value)
				node = n.next
			}
			return out
		}

		// Returns the next element front to back; none after the last, which
		// also resets the cursor.
		def iterate() ?T {
			if !iterating {
				cur = head
				iterating = true
			}
			let n = cur
			if n is none {
				iterating = false
				return none
			}
			cur = n.next
			return n.value
		}

		// Returns the node at a valid position.
		internal def nodeAt(index int) ?ListNode<T> {
			let node = head
			for let i = 0; i < index; i++ {
				let n = node
				return none when n is none
				node = n.next
			}
			return node
		}

		// Returns the node before target, or none when target is the head.
		internal def previous(target ListNode<T>) ?ListNode<T> {
			let node = head
			for {
				let n = node
				return none when n is none
				let next = n.next
				return none when next is none
				return n when next == target
				node = next
			}
			return none
		}
	}

	// Node of a doubly linked list. The list owns its nodes front to back
	// through `next`; `prev` is a weak back reference, so unlinking a node
	// or dropping the list frees every node without breaking cycles by hand.
	internal type DoublyLinkedNode<T> {
		value     T
		next      ?DoublyLinkedNode<T>
		weak prev ?DoublyLinkedNode<T>

		def new(value T) {
			self.value = value
		}
	}

	// DoublyLinkedList is a linked list with O(1) insertion and removal at
	// both ends and O(1) removal of an element once it has been found.
	//
	// Iteration yields elements front to back.
	type DoublyLinkedList<T> {
		internal head      ?DoublyLinkedNode<T>
		internal tail      ?DoublyLinkedNode<T>
		internal count     int
		internal cur       ?DoublyLinkedNode<T>
		internal iterating bool

		def new() {}

		// Returns the number of elements.
		def len() int {
			return count
		}

		// Reports whether the list holds no elements.
		def isEmpty() bool {
			return count == 0
		}

		// Removes all elements.
		def clear() {
			head = none
			tail = none
			count = 0
		}

		// Inserts a value at the front.
		def pushFront(value T) {
			let node = new DoublyLinkedNode<T>(value)
			let first = head
			if first is none {
				tail = node
			} else {
				node.next = first
				first.prev = node
			}
			head = node
			count += 1
		}

		// Appends a value at the back.
		def pushBack(value T) {
			let node = new DoublyLinkedNode<T>(value)
			let last = tail
			if last is none {
				head = node
			} else {
				node.prev = last
				last.next = node
			}
			tail = node
			count += 1
		}

		// Removes and returns the first element, or none when empty.
		def popFront() ?T {
			let first = head
			return none when first is none
			unlink(first)
			return first.value
		}

		// Removes and returns the last element, or none when empty.
		def popBack() ?T {
			let last = tail
			return none when last is none
			unlink(last)
			return last.value
		}

		// Returns the first element without removing it, or none when empty.
		def front() ?T {
			let first = head
			return none when first is none
			return first.value
		}

		// Returns the last element without removing it, or none when empty.
		def back() ?T {
			let last = tail
			return none when last is none
			return last.value
		}

		// Returns the element at the given position, or none when out of range.
		// Negative indices count from the back.
		def at(index int) ?T {
			index += count when index < 0
			return none when index < 0 || index >= count
			let node = nodeAt(index)
			return none when node is none
			return node.value
		}

		// Reports whether the list contains value.
		def contains(value T) bool {
			return indexOf(value) >= 0
		}

		// Returns the position of the first occurrence of value, or -1.
		def indexOf(value T) int {
			let node = head
			let index = 0
			for {
				let n = node
				break when n is none
				return index when n.value == value
				node = n.next
				index += 1
			}
			return -1
		}

		// Inserts a value before the element at index. An index equal to the
		// length appends. Returns false when the index is out of range.
		def insert(index int, value T) bool {
			index += count when index < 0
			return false when index < 0 || index > count
			if index == 0 {
				pushFront(value)
				return true
			}
			if index == count {
				pushBack(value)
				return true
			}
			let after = nodeAt(index)
			return false when after is none
			let before = after.prev
			return false when before is none
			let node = new DoublyLinkedNode<T>(value)
			node.prev = before
			node.next = after
			before.next = node
			after.prev = node
			count += 1
			return true
		}

		// Removes the first occurrence of value. Returns whether one was found.
		def remove(value T) bool {
			let node = head
			for {
				let n = node
				return false when n is none
				if n.value == value {
					unlink(n)
					return true
				}
				node = n.next
			}
			return false
		}

		// Removes and returns the element at index, or none when out of range.
		def removeAt(index int) ?T {
			index += count when index < 0
			return none when index < 0 || index >= count
			let node = nodeAt(index)
			return none when node is none
			unlink(node)
			return node.value
		}

		// Reverses the list in place.
		def reverse() {
			let node = head
			head = tail
			tail = node
			for {
				let n = node
				break when n is none
				let next = n.next
				n.next = n.prev
				n.prev = next
				node = next
			}
		}

		// Returns the elements as a new array, front first.
		def toArray() T[] {
			let out T[]
			let node = head
			for {
				let n = node
				break when n is none
				out.push(n.value)
				node = n.next
			}
			return out
		}

		// Returns the next element front to back; none after the last, which
		// also resets the cursor.
		def iterate() ?T {
			if !iterating {
				cur = head
				iterating = true
			}
			let n = cur
			if n is none {
				iterating = false
				return none
			}
			cur = n.next
			return n.value
		}

		// Returns the node at a valid position, walking from the nearer end.
		internal def nodeAt(index int) ?DoublyLinkedNode<T> {
			if index < count / 2 {
				let node = head
				for let i = 0; i < index; i++ {
					let n = node
					return none when n is none
					node = n.next
				}
				return node
			}
			let node = tail
			for let i = count - 1; i > index; i-- {
				let n = node
				return none when n is none
				node = n.prev
			}
			return node
		}

		// Detaches a node that is known to be in the list.
		internal def unlink(node DoublyLinkedNode<T>) {
			let before = node.prev
			let after = node.next
			if before is none {
				head = after
			} else {
				before.next = after
			}
			if after is none {
				tail = before
			} else {
				after.prev = before
			}
			node.next = none
			node.prev = none
			count -= 1
		}
	}
}
