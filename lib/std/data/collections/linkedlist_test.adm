partial module std.data.collections {
	use std.testing

	check "LinkedList" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestEnds() {
			let l = new LinkedList<int>()
			assert l.isEmpty()
			assert l.popFront() is none
			assert l.popBack() is none
			assert l.front() is none
			assert l.back() is none

			l.pushBack(2)
			l.pushFront(1)
			l.pushBack(3)
			assert l.len() == 3
			assert eq(l.front(), 1)
			assert eq(l.back(), 3)
			assert l.toArray().equals(int[1, 2, 3])

			assert eq(l.popBack(), 3)
			assert eq(l.back(), 2)
			assert eq(l.popFront(), 1)
			assert eq(l.popFront(), 2)
			assert l.isEmpty()
			assert l.back() is none
			l.pushBack(9)
			assert eq(l.front(), 9)
		}

		@test()
		def TestIndexing() {
			let l = new LinkedList<string>()
			l.pushBack("a")
			l.pushBack("c")
			assert l.insert(1, "b")
			assert l.insert(3, "d")
			assert l.insert(0, "_")
			assert !l.insert(9, "x")
			assert l.toArray().equals(string["_", "a", "b", "c", "d"])
			assert eq(l.at(2), "b")
			assert eq(l.at(-1), "d")
			assert l.at(5) is none
			assert l.indexOf("c") == 3
			assert l.indexOf("z") == -1
			assert l.contains("a")

			assert eq(l.removeAt(0), "_")
			assert eq(l.removeAt(-1), "d")
			assert eq(l.back(), "c")
			assert l.remove("b")
			assert !l.remove("b")
			assert l.remove("c")
			assert eq(l.back(), "a")
			assert l.toArray().equals(string["a"])
		}

		@test()
		def TestReverseIterate() {
			let l = new LinkedList<int>()
			for let i = 1; i <= 4; i++ {
				l.pushBack(i)
			}
			l.reverse()
			assert l.toArray().equals(int[4, 3, 2, 1])
			assert eq(l.front(), 4)
			assert eq(l.back(), 1)
			l.pushBack(0)
			assert l.toArray().equals(int[4, 3, 2, 1, 0])

			let seen int[]
			for let v in l {
				seen.push(v)
			}
			assert seen.equals(int[4, 3, 2, 1, 0])
			let again int[]
			for let v in l {
				again.push(v)
			}
			assert again.equals(seen)
			l.clear()
			assert l.isEmpty()
			assert l.front() is none
		}
	}

	check "DoublyLinkedList" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestEnds() {
			let l = new DoublyLinkedList<int>()
			assert l.isEmpty()
			assert l.popFront() is none
			assert l.popBack() is none

			l.pushBack(2)
			l.pushFront(1)
			l.pushBack(3)
			assert l.len() == 3
			assert eq(l.front(), 1)
			assert eq(l.back(), 3)
			assert eq(l.popBack(), 3)
			assert eq(l.popFront(), 1)
			assert eq(l.popFront(), 2)
			assert l.isEmpty()
			assert l.back() is none
			l.pushFront(7)
			assert eq(l.back(), 7)
		}

		@test()
		def TestIndexing() {
			let l = new DoublyLinkedList<string>()
			l.pushBack("a")
			l.pushBack("c")
			assert l.insert(1, "b")
			assert l.insert(3, "d")
			assert l.insert(0, "_")
			assert !l.insert(-9, "x")
			assert l.toArray().equals(string["_", "a", "b", "c", "d"])
			assert eq(l.at(1), "a")
			assert eq(l.at(3), "c")
			assert eq(l.at(-2), "c")
			assert l.at(5) is none
			assert l.indexOf("d") == 4
			assert l.contains("b")
			assert !l.contains("z")

			assert eq(l.removeAt(0), "_")
			assert eq(l.removeAt(-1), "d")
			assert eq(l.removeAt(1), "b")
			assert l.toArray().equals(string["a", "c"])
			assert l.remove("a")
			assert eq(l.front(), "c")
			assert l.remove("c")
			assert l.isEmpty()
			assert l.front() is none
			assert l.back() is none
		}

		@test()
		def TestReverseIterate() {
			let l = new DoublyLinkedList<int>()
			for let i = 1; i <= 4; i++ {
				l.pushBack(i)
			}
			l.reverse()
			assert l.toArray().equals(int[4, 3, 2, 1])
			assert eq(l.popBack(), 1)
			assert eq(l.popFront(), 4)
			l.pushBack(0)
			assert l.toArray().equals(int[3, 2, 0])
			assert eq(l.at(-1), 0)

			let seen int[]
			for let v in l {
				seen.push(v)
			}
			assert seen.equals(int[3, 2, 0])
			l.clear()
			assert l.isEmpty()
		}
	}
}
