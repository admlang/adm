partial module std.data.collections {
	// List is a growable, index-addressable sequence backed by an array.
	//
	// Indices accepted by at, set, insert and removeAt may be negative, in
	// which case they count from the end (-1 is the last element).
	type List<T> {
		internal items T[]
		internal cur   int

		// Creates an empty list with room for capacity elements before the
		// backing array grows.
		def new(capacity int = 16) {
			items.cap(capacity.max(0))
		}

		// Creates a list holding a copy of the given elements.
		def new(values T[]) {
			items = values.clone()
		}

		// Returns the number of elements.
		def len() int {
			return items.len()
		}

		// Reports whether the list holds no elements.
		def isEmpty() bool {
			return items.len() == 0
		}

		// Removes all elements.
		def clear() {
			items.flush()
		}

		// Appends the values in order.
		def add(values ...T) {
			for let (_, v) in values {
				items.push(v)
			}
		}

		// Inserts a value before the element at index. An index equal to the
		// length appends. Returns false when the index is out of range.
		def insert(index int, value T) bool {
			index += items.len() when index < 0
			return false when index < 0 || index > items.len()

			items.push(value)
			for let i = items.len() - 1; i > index; i-- {
				items[i] = items[i - 1]
			}
			items[index] = value
			return true
		}

		// Returns the element at index, or none when out of range.
		def at(index int) ?T {
			index += items.len() when index < 0
			return none when index < 0 || index >= items.len()
			return items[index]
		}

		// Returns the first element, or none when the list is empty.
		def first() ?T {
			return items.first()
		}

		// Returns the last element, or none when the list is empty.
		def last() ?T {
			return items.last()
		}

		// Replaces the element at index. Returns false when out of range.
		def set(index int, value T) bool {
			index += items.len() when index < 0
			return false when index < 0 || index >= items.len()
			items[index] = value
			return true
		}

		// Removes and returns the element at index, or none when out of range.
		def removeAt(index int) ?T {
			index += items.len() when index < 0
			return none when index < 0 || index >= items.len()
			let value = items[index]
			items.remove(index)
			return value
		}

		// Removes the first occurrence of value. Returns whether one was found.
		def remove(value T) bool {
			let index = items.indexOf(value)
			return false when index < 0
			items.remove(index)
			return true
		}

		// Returns the index of the first occurrence of value, or -1.
		def indexOf(value T) int {
			return items.indexOf(value)
		}

		// Reports whether the list contains value.
		def contains(value T) bool {
			return items.includes(value)
		}

		// Sorts the list in place; less reports whether a must precede b.
		def sort(less def (a, b T) bool) {
			items.sort(less)
		}

		// Reverses the list in place.
		def reverse() {
			items.reverse()
		}

		// Returns the elements as a new array.
		def toArray() T[] {
			return items.clone()
		}

		// Returns the next element in index order; none after the last, which
		// also resets the cursor.
		def iterate() ?T {
			if cur >= items.len() {
				cur = 0
				return none
			}
			let v = items[cur]
			cur += 1
			return v
		}
	}
}
