partial module std.data.collections {
	use std.testing

	check "List" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestAddInsertRemove() {
			let l = new List<int>()
			assert l.isEmpty()
			assert l.first() is none
			assert l.last() is none

			l.add(1, 3)
			assert l.insert(1, 2)
			assert l.insert(3, 4)
			assert l.insert(0, 0)
			assert !l.insert(9, 9)
			assert l.toArray().equals(int[0, 1, 2, 3, 4])
			assert l.len() == 5
			assert eq(l.first(), 0)
			assert eq(l.last(), 4)

			assert eq(l.removeAt(0), 0)
			assert eq(l.removeAt(-1), 4)
			assert l.removeAt(5) is none
			assert l.toArray().equals(int[1, 2, 3])

			assert l.remove(2)
			assert !l.remove(2)
			assert l.toArray().equals(int[1, 3])
			assert l.indexOf(3) == 1
			assert l.indexOf(7) == -1
			assert l.contains(1)
		}

		@test()
		def TestAtSet() {
			let l = new List<string>(string["a", "b", "c"])
			assert eq(l.at(0), "a")
			assert eq(l.at(-1), "c")
			assert l.at(3) is none
			assert l.set(1, "B")
			assert l.set(-1, "C")
			assert !l.set(3, "x")
			assert l.toArray().equals(string["a", "B", "C"])
		}

		@test()
		def TestSortReverseIterate() {
			let l = new List<int>(int[3, 1, 2])
			l.sort((a int, b int) => a < b)
			assert l.toArray().equals(int[1, 2, 3])
			l.reverse()
			assert l.toArray().equals(int[3, 2, 1])
			let seen int[]
			for let v in l {
				seen.push(v)
			}
			assert seen.equals(int[3, 2, 1])
			l.clear()
			assert l.isEmpty()
		}
	}
}
