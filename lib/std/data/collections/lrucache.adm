partial module std.data.collections {
	// Node of the recency list kept by an LRUCache.
	internal type LRUNode<K, V> {
		key   K
		value V
		prev  ?LRUNode<K, V>
		next  ?LRUNode<K, V>

		def new(key K, value V) {
			self.key = key
			self.value = value
		}
	}

	// LRUCache is a bounded key/value map that evicts the least recently
	// used entry when it is full.
	//
	// get and set count as uses; peek and has do not. Iteration yields keys
	// from most to least recently used.
	type LRUCache<K: Serializable, V> {
		internal limit     int
		internal nodes     map<K, LRUNode<K, V >>
		internal head      ?LRUNode<K, V>
		internal tail      ?LRUNode<K, V>
		internal evictions int
		internal cur       ?LRUNode<K, V>
		internal iterating bool

		// Creates a cache holding at most capacity entries (at least one).
		def new(capacity int) {
			limit = capacity.max(1)
		}

		// Returns the number of entries.
		def len() int {
			return nodes.len()
		}

		// Returns the maximum number of entries.
		def capacity() int {
			return limit
		}

		// Returns how many entries have been evicted to make room.
		def evicted() int {
			return evictions
		}

		// Reports whether the cache holds no entries.
		def isEmpty() bool {
			return nodes.len() == 0
		}

		// Removes every entry.
		def clear() {
			nodes = map<K, LRUNode<K, V >> {}
			head = none
			tail = none
		}

		// Returns the value for key and marks it as most recently used, or
		// none when absent.
		def get(key K) ?V {
			let node = nodes.get(key)
			return none when node is none
			moveToFront(node)
			return node.value
		}

		// Returns the value for key without affecting recency, or none.
		def peek(key K) ?V {
			let node = nodes.get(key)
			return none when node is none
			return node.value
		}

		// Reports whether key is present, without affecting recency.
		def has(key K) bool {
			return nodes.hasKey(key)
		}

		// Stores value under key as the most recently used entry, evicting
		// the least recently used entry when the cache is full.
		def set(key K, value V) {
			let existing = nodes.get(key)
			if !(existing is none) {
				existing.value = value
				moveToFront(existing)
				return
			}
			if nodes.len() >= limit {
				let last = tail
				if !(last is none) {
					unlink(last)
					nodes = nodes.delete(last.key)
					evictions += 1
				}
			}
			let node = new LRUNode<K, V>(key, value)
			nodes = nodes.set(key, node)
			pushFront(node)
		}

		// Removes key. Returns false when it was absent.
		def delete(key K) bool {
			let node = nodes.get(key)
			return false when node is none
			unlink(node)
			nodes = nodes.delete(key)
			return true
		}

		// Returns the keys from most to least recently used.
		def keys() K[] {
			let out K[]
			let node = head
			for {
				let n = node
				break when n is none
				out.push(n.key)
				node = n.next
			}
			return out
		}

		// Returns the least recently used key, or none when empty.
		def oldest() ?K {
			let last = tail
			return none when last is none
			return last.key
		}

		// Returns the most recently used key, or none when empty.
		def newest() ?K {
			let first = head
			return none when first is none
			return first.key
		}

		// Returns the next key from most to least recently used; none after
		// the last, which also resets the cursor.
		def iterate() ?K {
			if !iterating {
				cur = head
				iterating = true
			}
			let n = cur
			if n is none {
				iterating = false
				return none
			}
			cur = n.next
			return n.key
		}

		internal def pushFront(node LRUNode<K, V>) {
			node.prev = none
			node.next = head
			let first = head
			if first is none {
				tail = node
			} else {
				first.prev = node
			}
			head = node
		}

		internal def unlink(node LRUNode<K, V>) {
			let before = node.prev
			let after = node.next
			if before is none {
				head = after
			} else {
				before.next = after
			}
			if after is none {
				tail = before
			} else {
				after.prev = before
			}
			node.prev = none
			node.next = none
		}

		internal def moveToFront(node LRUNode<K, V>) {
			let first = head
			if !(first is none) {
				return when first == node
			}
			unlink(node)
			pushFront(node)
		}
	}
}
