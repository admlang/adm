partial module std.data.collections {
	use std.testing

	check "LRUCache" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestEviction() {
			let c = new LRUCache<string, int>(2)
			assert c.capacity() == 2
			assert c.isEmpty()
			assert c.get("a") is none
			c.set("a", 1)
			c.set("b", 2)
			assert c.len() == 2
			assert c.keys().equals(string["b", "a"])
			assert eq(c.get("a"), 1)
			assert c.keys().equals(string["a", "b"])
			c.set("c", 3)
			assert c.len() == 2
			assert !c.has("b")
			assert c.has("a")
			assert c.evicted() == 1
			assert eq(c.oldest(), "a")
			assert eq(c.newest(), "c")

			assert eq(c.peek("a"), 1)
			assert c.keys().equals(string["c", "a"])
			c.set("a", 10)
			assert c.keys().equals(string["a", "c"])
			assert eq(c.get("a"), 10)
			c.set("d", 4)
			assert !c.has("c")
			assert c.keys().equals(string["d", "a"])

			assert c.delete("a")
			assert !c.delete("a")
			assert c.len() == 1
			assert eq(c.oldest(), "d")
			assert eq(c.newest(), "d")
			let seen string[]
			for let k in c {
				seen.push(k)
			}
			assert seen.equals(string["d"])
			c.clear()
			assert c.isEmpty()
			assert c.oldest() is none
			assert c.newest() is none
		}

		@test()
		def TestMinimumCapacity() {
			let c = new LRUCache<int, string>(0)
			assert c.capacity() == 1
			c.set(1, "one")
			c.set(2, "two")
			assert !c.has(1)
			assert eq(c.get(2), "two")
			assert c.evicted() == 1
		}
	}
}
