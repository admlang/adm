partial module std.data.collections {
	// MultiMap maps each key to any number of values, kept in insertion order.
	type MultiMap<K: Serializable, V> {
		internal store map<K, V[]>
		internal total int

		def new() {}

		// Returns the total number of values across all keys.
		def len() int {
			return total
		}

		// Returns the number of distinct keys.
		def keyCount() int {
			return store.len()
		}

		// Reports whether the map holds no values.
		def isEmpty() bool {
			return total == 0
		}

		// Removes every entry.
		def clear() {
			store = map<K, V[]>{}
			total = 0
		}

		// Adds value under key.
		def add(key K, value V) {
			let cur = store.get(key)
			if cur is none {
				store = store.set(key, V[value])
			} else {
				cur.push(value)
				store = store.set(key, cur)
			}
			total += 1
		}

		// Returns the values under key, in insertion order; empty when absent.
		def get(key K) V[] {
			let cur = store.get(key)
			return V[] when cur is none
			return cur.clone()
		}

		// Returns the number of values under key.
		def count(key K) int {
			let cur = store.get(key)
			return 0 when cur is none
			return cur.len()
		}

		// Reports whether key has at least one value.
		def has(key K) bool {
			return store.hasKey(key)
		}

		// Reports whether value is stored under key.
		def contains(key K, value V) bool {
			let cur = store.get(key)
			return false when cur is none
			return cur.includes(value)
		}

		// Removes the first occurrence of value under key. Returns false when
		// it was absent. A key left without values is dropped.
		def remove(key K, value V) bool {
			let cur = store.get(key)
			return false when cur is none
			let index = cur.indexOf(value)
			return false when index < 0
			cur.remove(index)
			if cur.len() == 0 {
				store = store.delete(key)
			} else {
				store = store.set(key, cur)
			}
			total -= 1
			return true
		}

		// Removes key and all of its values. Returns false when absent.
		def delete(key K) bool {
			let cur = store.get(key)
			return false when cur is none
			total -= cur.len()
			store = store.delete(key)
			return true
		}

		// Returns the distinct keys in no particular order.
		def keys() K[] {
			return store.keys()
		}

		// Returns every value across all keys in no particular key order.
		def values() V[] {
			let out V[]
			for let (_, vals) in store {
				for let (_, v) in vals {
					out.push(v)
				}
			}
			return out
		}
	}
}
