partial module std.data.collections {
	use std.testing

	check "MultiMap" {
		@test()
		def TestAddRemove() {
			let m = new MultiMap<string, int>()
			assert m.isEmpty()
			assert m.get("x").len() == 0
			m.add("a", 1)
			m.add("a", 2)
			m.add("b", 3)
			assert m.len() == 3
			assert m.keyCount() == 2
			assert m.count("a") == 2
			assert m.count("z") == 0
			assert m.get("a").equals(int[1, 2])
			assert m.has("b")
			assert !m.has("z")
			assert m.contains("a", 2)
			assert !m.contains("a", 3)

			assert m.remove("a", 1)
			assert !m.remove("a", 1)
			assert m.get("a").equals(int[2])
			assert m.remove("a", 2)
			assert !m.has("a")
			assert m.len() == 1
			assert m.keys().equals(string["b"])
			assert m.values().equals(int[3])

			m.add("b", 4)
			assert m.delete("b")
			assert !m.delete("b")
			assert m.isEmpty()
			m.add("c", 5)
			m.clear()
			assert m.isEmpty()
			assert m.keyCount() == 0
		}
	}
}
