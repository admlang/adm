partial module std.data.collections {
	// OrderedMap is a key/value map that remembers insertion order.
	//
	// Re-setting an existing key keeps its original position. Iteration,
	// keys, values and entries follow insertion order.
	type OrderedMap<K: Serializable, V> {
		internal order K[]
		internal store map<K, V>
		internal cur   int

		def new() {}

		// Returns the number of entries.
		def len() int {
			return order.len()
		}

		// Reports whether the map holds no entries.
		def isEmpty() bool {
			return order.len() == 0
		}

		// Removes every entry.
		def clear() {
			order.flush()
			store = map<K, V>{}
		}

		// Associates value with key. A new key goes to the end of the order.
		def set(key K, value V) {
			order.push(key) unless store.hasKey(key)
			store = store.set(key, value)
		}

		// Returns the value for key, or none when absent.
		def get(key K) ?V {
			return store.get(key)
		}

		// Returns the value for key, or fallback when absent.
		def get(key K, fallback V) V {
			let v = store.get(key)
			return fallback when v is none
			return v
		}

		// Reports whether key is present.
		def has(key K) bool {
			return store.hasKey(key)
		}

		// Removes key. Returns false when it was absent.
		def delete(key K) bool {
			let index = order.indexOf(key)
			return false when index < 0
			order.remove(index)
			store = store.delete(key)
			return true
		}

		// Returns the oldest entry, or none when empty.
		def first() ?Entry<K, V> {
			return entryAt(0)
		}

		// Returns the newest entry, or none when empty.
		def last() ?Entry<K, V> {
			return entryAt(order.len() - 1)
		}

		// Returns the keys in insertion order.
		def keys() K[] {
			return order.clone()
		}

		// Returns the values in insertion order.
		def values() V[] {
			let out V[]
			for let (_, k) in order {
				let v = store.get(k)
				continue when v is none
				out.push(v)
			}
			return out
		}

		// Returns the entries in insertion order.
		def entries() Entry<K, V>[] {
			let out Entry<K, V>[]
			for let i = 0; i < order.len(); i++ {
				let e = entryAt(i)
				continue when e is none
				out.push(e)
			}
			return out
		}

		// Returns the next entry in insertion order; none after the last,
		// which also resets the cursor.
		def iterate() ?Entry<K, V> {
			if cur >= order.len() {
				cur = 0
				return none
			}
			let e = entryAt(cur)
			cur += 1
			return e
		}

		internal def entryAt(index int) ?Entry<K, V> {
			return none when index < 0 || index >= order.len()
			let k = order[index]
			let v = store.get(k)
			return none when v is none
			return new Entry<K, V>(k, v)
		}
	}
}
