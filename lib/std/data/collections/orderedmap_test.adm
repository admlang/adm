partial module std.data.collections {
	use std.testing

	check "OrderedMap" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestOrder() {
			let m = new OrderedMap<string, int>()
			assert m.isEmpty()
			assert m.first() is none
			assert m.last() is none
			m.set("c", 3)
			m.set("a", 1)
			m.set("b", 2)
			m.set("c", 30)
			assert m.len() == 3
			assert m.keys().equals(string["c", "a", "b"])
			assert m.values().equals(int[30, 1, 2])
			assert eq(m.get("c"), 30)
			assert m.get("z", 0) == 0
			assert m.has("a")

			let first = m.first()
			assert !(first is none)
			assert first.key == "c" unless first is none
			let last = m.last()
			assert last.value == 2 unless last is none

			assert m.delete("a")
			assert !m.delete("a")
			assert m.keys().equals(string["c", "b"])

			let keys string[]
			for let e in m {
				keys.push(e.key)
			}
			assert keys.equals(string["c", "b"])
			assert m.entries().len() == 2
			m.clear()
			assert m.isEmpty()
			assert m.first() is none
		}
	}
}
