partial module std.data.collections {
	// Queue is a first-in, first-out collection backed by a Deque.
	//
	// Iteration yields elements from the front of the queue to the back.
	type Queue<T> {
		internal items Deque<T>

		// Creates an empty queue with the given initial capacity.
		def new(capacity int = 16) {
			items = new Deque<T>(capacity)
		}

		// Returns the number of queued elements.
		def len() int {
			return items.len()
		}

		// Reports whether the queue holds no elements.
		def isEmpty() bool {
			return items.isEmpty()
		}

		// Removes all elements while keeping the allocated storage.
		def clear() {
			items.clear()
		}

		// Adds a value to the back of the queue.
		def push(value T) {
			items.pushBack(value)
		}

		// Removes and returns the front element, or none when the queue is empty.
		def pop() ?T {
			return items.popFront()
		}

		// Returns the front element without removing it, or none when empty.
		def peek() ?T {
			return items.front()
		}

		// Reports whether the queue contains the given value.
		def contains(value T) bool {
			return items.contains(value)
		}

		// Returns the elements as a new array, front first.
		def toArray() T[] {
			let out T[]
			for let i = 0; i < items.len(); i++ {
				let v = items.at(i)
				continue when v is none
				out.push(v)
			}
			return out
		}

		// Returns the next element front to back; none after the last, which
		// also resets the cursor.
		def iterate() ?T {
			return items.iterate()
		}
	}
}
