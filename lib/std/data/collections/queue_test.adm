partial module std.data.collections {
	use std.testing

	check "Queue" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestPushPop() {
			let q = new Queue<int>(2)
			assert q.isEmpty()
			assert q.pop() is none
			assert q.peek() is none

			for let i = 1; i <= 5; i++ {
				q.push(i)
			}
			assert q.len() == 5
			assert eq(q.peek(), 1)
			assert eq(q.pop(), 1)
			assert eq(q.pop(), 2)
			assert q.contains(5)
			assert !q.contains(1)
			assert q.toArray().equals(int[3, 4, 5])

			let seen int[]
			for let v in q {
				seen.push(v)
			}
			assert seen.equals(int[3, 4, 5])

			q.clear()
			assert q.isEmpty()
			assert q.pop() is none
		}
	}
}
