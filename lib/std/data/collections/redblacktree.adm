partial module std.data.collections {
	// Node of a red-black tree.
	internal type RBNode<T> {
		value T
		left  ?RBNode<T>
		right ?RBNode<T>
		red   bool

		def new(value T) {
			self.value = value
			red = true
		}
	}

	// RedBlackTree is a self-balancing binary search tree of distinct values
	// (a left-leaning red-black tree).
	//
	// Every operation is O(log n). Iteration yields values in ascending
	// order.
	type RedBlackTree<T: Ordered> {
		internal root     ?RBNode<T>
		internal count    int
		internal snapshot T[]
		internal cur      int

		def new() {}

		// Creates a tree holding values.
		def new(values T[]) {
			for let (_, v) in values {
				insert(v)
			}
		}

		// Returns the number of values.
		def len() int {
			return count
		}

		// Reports whether the tree holds no values.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every value.
		def clear() {
			root = none
			count = 0
		}

		// Adds value. Returns false when it was already present.
		def insert(value T) bool {
			let before = count
			let r = insertInto(root, value)
			r.red = false
			root = r
			return count > before
		}

		// Removes value. Returns false when it was absent.
		def remove(value T) bool {
			return false unless has(value)
			let r = root
			return false when r is none
			r.red = true unless isRed(r.left) || isRed(r.right)
			root = removeFrom(r, value)
			let nr = root
			nr.red = false unless nr is none
			count -= 1
			return true
		}

		// Reports whether value is present.
		def has(value T) bool {
			let node = root
			for {
				let n = node
				return false when n is none
				return true when n.value == value
				node = value < n.value ?? (n.left, n.right)
			}
			return false
		}

		// Returns the smallest value, or none when empty.
		def min() ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				best = n.value
				node = n.left
			}
			return best
		}

		// Returns the largest value, or none when empty.
		def max() ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				best = n.value
				node = n.right
			}
			return best
		}

		// Returns the largest value not greater than value, or none.
		def floor(value T) ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				if n.value == value {
					return n.value
				} else if n.value < value {
					best = n.value
					node = n.right
				} else {
					node = n.left
				}
			}
			return best
		}

		// Returns the smallest value not less than value, or none.
		def ceiling(value T) ?T {
			let node = root
			let best ?T = none
			for {
				let n = node
				break when n is none
				if n.value == value {
					return n.value
				} else if n.value > value {
					best = n.value
					node = n.left
				} else {
					node = n.right
				}
			}
			return best
		}

		// Returns the number of edges on the longest root-to-leaf path, or -1
		// for an empty tree.
		def height() int {
			return heightOf(root)
		}

		// Returns the values in ascending order.
		def toArray() T[] {
			let out T[]
			collect(root, out)
			return out
		}

		// Returns the next value in ascending order; none after the largest,
		// which also resets the cursor. The values are captured when
		// iteration starts.
		def iterate() ?T {
			snapshot = toArray() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let v = snapshot[cur]
			cur += 1
			return v
		}

		internal def isRed(node ?RBNode<T>) bool {
			let n = node
			return false when n is none
			return n.red
		}

		// Reports whether node exists and has a red left child.
		internal def isRedLeft(node ?RBNode<T>) bool {
			let n = node
			return false when n is none
			return isRed(n.left)
		}

		internal def rotateLeft(n RBNode<T>) RBNode<T> {
			let x = n.right
			return n when x is none
			n.right = x.left
			x.left = n
			x.red = n.red
			n.red = true
			return x
		}

		internal def rotateRight(n RBNode<T>) RBNode<T> {
			let x = n.left
			return n when x is none
			n.left = x.right
			x.right = n
			x.red = n.red
			n.red = true
			return x
		}

		internal def flipColors(n RBNode<T>) {
			n.red = !n.red
			let l = n.left
			l.red = !l.red unless l is none
			let r = n.right
			r.red = !r.red unless r is none
		}

		internal def fixUp(node RBNode<T>) RBNode<T> {
			let n = node
			n = rotateLeft(n) when isRed(n.right) && !isRed(n.left)
			n = rotateRight(n) when isRed(n.left) && isRedLeft(n.left)
			flipColors(n) when isRed(n.left) && isRed(n.right)
			return n
		}

		internal def insertInto(node ?RBNode<T>, value T) RBNode<T> {
			let n = node
			if n is none {
				count += 1
				return new RBNode<T>(value)
			}
			if value < n.value {
				n.left = insertInto(n.left, value)
			} else if value > n.value {
				n.right = insertInto(n.right, value)
			} else {
				return n
			}
			return fixUp(n)
		}

		internal def moveRedLeft(node RBNode<T>) RBNode<T> {
			let n = node
			flipColors(n)
			if isRedLeft(n.right) {
				let r = n.right
				n.right = rotateRight(r) unless r is none
				n = rotateLeft(n)
				flipColors(n)
			}
			return n
		}

		internal def moveRedRight(node RBNode<T>) RBNode<T> {
			let n = node
			flipColors(n)
			if isRedLeft(n.left) {
				n = rotateRight(n)
				flipColors(n)
			}
			return n
		}

		internal def removeMin(node RBNode<T>) ?RBNode<T> {
			let n = node
			let l = n.left
			return none when l is none
			if !isRed(l) && !isRed(l.left) {
				n = moveRedLeft(n)
			}
			let nl = n.left
			n.left = removeMin(nl) unless nl is none
			return fixUp(n)
		}

		internal def minOf(n RBNode<T>) T {
			let current = n
			for {
				let l = current.left
				return current.value when l is none
				current = l
			}
			return current.value
		}

		// Removes value from the subtree at node; the caller guarantees the
		// value is present.
		internal def removeFrom(node RBNode<T>, value T) ?RBNode<T> {
			let n = node
			if value < n.value {
				let l = n.left
				return n when l is none
				if !isRed(l) && !isRed(l.left) {
					n = moveRedLeft(n)
				}
				let nl = n.left
				n.left = removeFrom(nl, value) unless nl is none
			} else {
				if isRed(n.left) {
					n = rotateRight(n)
				}
				if value == n.value && n.right is none {
					return none
				}
				let r = n.right
				return n when r is none
				if !isRed(r) && !isRed(r.left) {
					n = moveRedRight(n)
				}
				let nr = n.right
				if value == n.value {
					if !(nr is none) {
						n.value = minOf(nr)
						n.right = removeMin(nr)
					}
				} else {
					n.right = removeFrom(nr, value) unless nr is none
				}
			}
			return fixUp(n)
		}

		internal def heightOf(node ?RBNode<T>) int {
			let n = node
			return -1 when n is none
			return heightOf(n.left).max(heightOf(n.right)) + 1
		}

		internal def collect(node ?RBNode<T>, out T[]) {
			let n = node
			return when n is none
			collect(n.left, out)
			out.push(n.value)
			collect(n.right, out)
		}
	}
}
