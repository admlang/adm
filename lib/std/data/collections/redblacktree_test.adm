partial module std.data.collections {
	use std.testing

	check "RedBlackTree" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestBalancedInsert() {
			let t = new RedBlackTree<int>()
			assert t.isEmpty()
			assert t.height() == -1
			for let i = 1; i <= 1000; i++ {
				assert t.insert(i)
			}
			assert !t.insert(1)
			assert t.len() == 1000
			// A red-black tree of 1000 nodes has height at most 2 * log2(1001) ~ 20.
			assert t.height() <= 20
			assert t.has(777)
			assert !t.has(0)
			assert eq(t.min(), 1)
			assert eq(t.max(), 1000)
			assert t.toArray().len() == 1000
		}

		@test()
		def TestRemove() {
			let t = new RedBlackTree<int>()
			for let i = 0; i < 200; i++ {
				t.insert((i * 37) % 200)
			}
			assert t.len() == 200
			for let i = 0; i < 200; i += 2 {
				assert t.remove(i)
			}
			assert !t.remove(0)
			assert t.len() == 100
			assert !t.has(0)
			assert t.has(1)
			assert eq(t.min(), 1)
			assert eq(t.max(), 199)
			assert t.height() <= 14
			let all = t.toArray()
			assert all.len() == 100
			assert all[0] == 1
			assert all[99] == 199
			for let i = 1; i < 200; i += 2 {
				assert t.remove(i)
			}
			assert t.isEmpty()
			assert t.min() is none
		}

		@test()
		def TestFloorCeilingIterate() {
			let t = new RedBlackTree<string>(string["d", "b", "f", "a", "c"])
			assert eq(t.floor("c"), "c")
			assert eq(t.floor("e"), "d")
			assert t.floor("0") is none
			assert eq(t.ceiling("e"), "f")
			assert t.ceiling("g") is none
			let seen string[]
			for let v in t {
				seen.push(v)
			}
			assert seen.equals(string["a", "b", "c", "d", "f"])
			t.clear()
			assert t.isEmpty()
		}
	}
}
