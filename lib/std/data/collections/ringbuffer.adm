partial module std.data.collections {
	// RingBuffer is a fixed-capacity circular queue.
	//
	// Pushing onto a full buffer overwrites the oldest element. Iteration and
	// indexing follow insertion order, oldest first.
	type RingBuffer<T> {
		internal data  T[]
		internal head  int
		internal count int
		internal cur   int

		// Creates a buffer holding at most capacity elements. A capacity below
		// one is treated as one.
		def new(capacity int) {
			data.len(capacity.max(1))
		}

		// Returns the number of elements in the buffer.
		def len() int {
			return count
		}

		// Returns the fixed number of elements the buffer can hold.
		def capacity() int {
			return data.len()
		}

		// Reports whether the buffer holds no elements.
		def isEmpty() bool {
			return count == 0
		}

		// Reports whether the next push will overwrite the oldest element.
		def isFull() bool {
			return count == data.len()
		}

		// Removes all elements.
		def clear() {
			head = 0
			count = 0
		}

		// Appends a value. When the buffer is full the oldest element is
		// dropped and returned; otherwise none is returned.
		def push(value T) ?T {
			if count < data.len() {
				data[(head + count) % data.len()] = value
				count += 1
				return none
			}
			let dropped = data[head]
			data[head] = value
			head = (head + 1) % data.len()
			return dropped
		}

		// Removes and returns the oldest element, or none when empty.
		def pop() ?T {
			return none when count == 0
			let value = data[head]
			head = (head + 1) % data.len()
			count -= 1
			head = 0 when count == 0
			return value
		}

		// Returns the oldest element without removing it, or none when empty.
		def peek() ?T {
			return none when count == 0
			return data[head]
		}

		// Returns the most recently pushed element, or none when empty.
		def last() ?T {
			return none when count == 0
			return data[(head + count - 1) % data.len()]
		}

		// Returns the element at the given position in insertion order.
		// Negative indices count from the newest element, so -1 is the last.
		def at(index int) ?T {
			index += count when index < 0
			return none when index < 0 || index >= count
			return data[(head + index) % data.len()]
		}

		// Returns the elements as a new array, oldest first.
		def toArray() T[] {
			let out T[]
			for let i = 0; i < count; i++ {
				out.push(data[(head + i) % data.len()])
			}
			return out
		}

		// Returns the next element oldest to newest; none after the last, which
		// also resets the cursor.
		def iterate() ?T {
			if cur >= count {
				cur = 0
				return none
			}
			let v = data[(head + cur) % data.len()]
			cur += 1
			return v
		}
	}
}
