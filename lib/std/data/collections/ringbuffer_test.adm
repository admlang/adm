partial module std.data.collections {
	use std.testing

	check "RingBuffer" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestOverwrite() {
			let r = new RingBuffer<int>(3)
			assert r.capacity() == 3
			assert r.isEmpty()
			assert !r.isFull()
			assert r.push(1) is none
			assert r.push(2) is none
			assert r.push(3) is none
			assert r.isFull()
			assert eq(r.push(4), 1)
			assert eq(r.push(5), 2)
			assert r.len() == 3
			assert eq(r.peek(), 3)
			assert eq(r.last(), 5)
			assert r.toArray().equals(int[3, 4, 5])
			assert eq(r.at(0), 3)
			assert eq(r.at(-1), 5)
			assert r.at(3) is none
		}

		@test()
		def TestPopAndIterate() {
			let r = new RingBuffer<string>(2)
			r.push("a")
			r.push("b")
			assert eq(r.pop(), "a")
			r.push("c")
			let seen string[]
			for let v in r {
				seen.push(v)
			}
			assert seen.equals(string["b", "c"])
			assert eq(r.pop(), "b")
			assert eq(r.pop(), "c")
			assert r.pop() is none
			assert r.isEmpty()
			r.push("d")
			assert eq(r.peek(), "d")
			r.clear()
			assert r.isEmpty()
			assert r.peek() is none
		}

		@test()
		def TestMinimumCapacity() {
			let r = new RingBuffer<int>(0)
			assert r.capacity() == 1
			r.push(1)
			assert eq(r.push(2), 1)
			assert eq(r.peek(), 2)
		}
	}
}
