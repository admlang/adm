internal partial module std.data.collections.search.algorithms {
	def linearSearch<T>(list T[], value T, less def (a, b T) bool) ?int {
		for let i = 0; i < list.len(); i++ {
			return i when !less(list[i], value) && !less(value, list[i])
		}
		return none
	}

	// Lower-bound binary search, so the first of equal elements is found.
	def binarySearch<T>(list T[], value T, less def (a, b T) bool) ?int {
		let lo = 0
		let hi = list.len()
		for lo < hi {
			let mid = lo + (hi - lo) / 2
			if less(list[mid], value) {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo when lo < list.len() && !less(value, list[lo])
		return none
	}

	def jumpSearch<T>(list T[], value T, less def (a, b T) bool) ?int {
		let n = list.len()
		return none when n == 0
		let step = 1
		for step * step < n {
			step++
		}
		// Skip whole blocks whose last element sorts before value.
		let start = 0
		for start + step < n && less(list[start + step - 1], value) {
			start += step
		}
		let end = start + step
		end = n when end > n
		for let i = start; i < end; i++ {
			continue when less(list[i], value)
			return i when !less(value, list[i])
			return none
		}
		return none
	}

	def interpolationSearch<T: Numeric>(list T[], value T) ?int {
		let lo = 0
		let hi = list.len() - 1
		for lo <= hi && value >= list[lo] && value <= list[hi] {
			let pos = lo
			if list[hi] != list[lo] {
				let span = float64(list[hi]) - float64(list[lo])
				pos = lo + int((float64(value) - float64(list[lo])) / span * float64(hi - lo))
			}
			if list[pos] == value {
				// Back up to the first of equal elements.
				for pos > 0 && list[pos - 1] == value {
					pos--
				}
				return pos
			}
			if list[pos] < value {
				lo = pos + 1
			} else {
				hi = pos - 1
			}
		}
		return none
	}
}
