partial module std.data.collections.search {
	use (
		std.data.collections.sort::(Comparable)
		std.data.collections.search.algorithms::*
	)

	// SearchMethod is the algorithm `search` runs. Every method but Linear
	// requires the list sorted in ascending order (by the same `less` when one
	// is given); on an unsorted list they may miss a value that is there.
	enum SearchMethod {
		// Checks every element in turn: O(n), any order. The default.
		Linear,
		// Halves the sorted range each step: O(log n).
		Binary,
		// Steps through the sorted list in blocks of √n, then scans the block:
		// O(√n).
		Jump,
		// Guesses the position from the value's place between the ends of the
		// sorted range: O(log log n) on evenly spread numbers, O(n) at worst.
		// Numbers only; other element types search with Binary.
		Interpolation
	}

	// Returns the index of the first element equal to value, or none when
	// list holds no such element. Every method but Linear requires list
	// sorted in ascending order.
	//
	// Example:
	// ```example
	// let i = search(names, "fig")
	// let j = search(sortedIds, 42, method = SearchMethod.Binary)
	// ```
	def search<T: Comparable<T>>(list T[], value T, method SearchMethod = SearchMethod.Linear) ?int {
		let less = (a T, b T) => a.compare(b) < 0
		match T {
			case Numeric:
				return interpolationSearch(list, value) when method == SearchMethod.Interpolation
		}
		match method {
			case SearchMethod.Linear:
				return linearSearch(list, value, less)
			case SearchMethod.Jump:
				return jumpSearch(list, value, less)
			default:
				return binarySearch(list, value, less)
		}
	}

	// Returns the index of the first element equivalent to value under less
	// (neither sorts before the other), or none when list holds no such
	// element. Every method but Linear requires list sorted by less;
	// Interpolation needs numbers and searches with Binary here.
	//
	// Example:
	// ```example
	// let i = search(byAge, probe, (a, b Person) => a.age < b.age, method = SearchMethod.Binary)
	// ```
	def search<T>(list T[], value T, less def (a, b T) bool, method SearchMethod = SearchMethod.Linear) ?int {
		match method {
			case SearchMethod.Linear:
				return linearSearch(list, value, less)
			case SearchMethod.Jump:
				return jumpSearch(list, value, less)
			default:
				return binarySearch(list, value, less)
		}
	}
}
