partial module std.data.collections.search {
	use std.testing

	check "search" {
		type Point {
			x int
			y int

			def new(x int, y int) {
				self.x = x
				self.y = y
			}

			def compare(other Point) int {
				let c = x.compare(other.x)
				return c when c != 0
				return y.compare(other.y)
			}
		}

		def methods() SearchMethod[] {
			return SearchMethod[SearchMethod.Linear, SearchMethod.Binary, SearchMethod.Jump, SearchMethod.Interpolation]
		}

		def found(got ?int, want int) bool {
			return false when got is none
			return got == want
		}

		@test()
		def findsTheFirstOfEqualIntegers() {
			let list = int[-5, 0, 2, 2, 2, 7, 9, 9, 40]
			for let (_, m) in methods() {
				assert found(search(list, -5, method = m), 0)
				assert found(search(list, 2, method = m), 2)
				assert found(search(list, 9, method = m), 6)
				assert found(search(list, 40, method = m), 8)
				assert search(list, 3, method = m) is none
				assert search(list, -6, method = m) is none
				assert search(list, 41, method = m) is none
			}
		}

		@test()
		def searchesEmptyAndSingleElementLists() {
			let nothing int[]
			for let (_, m) in methods() {
				assert search(nothing, 1, method = m) is none
				assert found(search(int[4], 4, method = m), 0)
				assert search(int[4], 5, method = m) is none
			}
		}

		@test()
		def searchesLongLists() {
			let list int[]
			for let i = 0; i < 1000; i++ {
				list.push(i * 3)
			}
			for let (_, m) in methods() {
				for let i = 0; i < 1000; i += 37 {
					assert found(search(list, i * 3, method = m), i)
					assert search(list, i * 3 + 1, method = m) is none
				}
			}
		}

		@test()
		def searchesFloatsStringsAndComparables() {
			for let (_, m) in methods() {
				assert found(search(float[0.5, 1.5, 2.5], 1.5, method = m), 1)
				assert found(search(string["apple", "fig", "pear"], "pear", method = m), 2)
				assert search(string["apple", "fig", "pear"], "kiwi", method = m) is none
				let points = Point[new Point(0, 1), new Point(1, 0), new Point(1, 5)]
				assert found(search(points, new Point(1, 5), method = m), 2)
				assert search(points, new Point(1, 1), method = m) is none
			}
		}

		@test()
		def linearSearchesUnsortedLists() {
			assert found(search(int[9, 3, 7, 3], 3), 1)
			assert search(int[9, 3, 7], 4) is none
		}

		@test()
		def searchesWithLess() {
			let byLen = (a string, b string) => a.len() < b.len()
			let list = string["a", "bb", "ccc", "dddd"]
			for let (_, m) in methods() {
				assert found(search(list, "xyz", byLen, method = m), 2)
				assert search(list, "xxxxx", byLen, method = m) is none
			}
		}
	}
}
