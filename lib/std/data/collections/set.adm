partial module std.data.collections {
	// Set is the contract shared by the set collections: a container of
	// distinct values.
	interface Set<T> {
		// Adds value; returns false when it was already present.
		def add(value T) bool
		// Removes value; returns false when it was absent.
		def remove(value T) bool
		// Reports whether value is present.
		def has(value T) bool
		// Returns the number of members.
		def len() int
		// Reports whether the set has no members.
		def isEmpty() bool
		// Removes every member.
		def clear()
		// Returns the members as an array.
		def toArray() T[]
	}

	// HashSet is an unordered set over hashable values.
	//
	// Iteration yields members in no particular order.
	type HashSet<T: Serializable> {
		internal store    map<T, bool>
		internal snapshot T[]
		internal cur      int

		def new() {}

		// Creates a set holding the given values.
		def new(values T[]) {
			for let (_, v) in values {
				add(v)
			}
		}

		// Adds value; returns false when it was already present.
		def add(value T) bool {
			return false when store.hasKey(value)
			store = store.set(value, true)
			return true
		}

		// Removes value; returns false when it was absent.
		def remove(value T) bool {
			return false unless store.hasKey(value)
			store = store.delete(value)
			return true
		}

		// Reports whether value is present.
		def has(value T) bool {
			return store.hasKey(value)
		}

		// Returns the number of members.
		def len() int {
			return store.len()
		}

		// Reports whether the set has no members.
		def isEmpty() bool {
			return store.len() == 0
		}

		// Removes every member.
		def clear() {
			store = map<T, bool>{}
		}

		// Returns a new set holding the members of both sets.
		def unions(other HashSet<T>) HashSet<T> {
			let out = new HashSet<T>(toArray())
			for let (_, v) in other.toArray() {
				out.add(v)
			}
			return out
		}

		// Returns a new set holding the members common to both sets.
		def intersect(other HashSet<T>) HashSet<T> {
			let out = new HashSet<T>()
			for let (_, v) in toArray() {
				out.add(v) when other.has(v)
			}
			return out
		}

		// Returns a new set holding the members of this set not in other.
		def difference(other HashSet<T>) HashSet<T> {
			let out = new HashSet<T>()
			for let (_, v) in toArray() {
				out.add(v) unless other.has(v)
			}
			return out
		}

		// Reports whether every member of this set is also in other.
		def isSubsetOf(other HashSet<T>) bool {
			for let (_, v) in toArray() {
				return false unless other.has(v)
			}
			return true
		}

		// Reports whether both sets have the same members.
		def equals(other HashSet<T>) bool {
			return store.len() == other.len() && isSubsetOf(other)
		}

		// Returns the members in no particular order.
		def toArray() T[] {
			return store.keys()
		}

		// Returns the next member; none after the last, which also resets the
		// cursor. The members are captured when iteration starts.
		def iterate() ?T {
			snapshot = toArray() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let v = snapshot[cur]
			cur += 1
			return v
		}
	}

	// SortedSet is a set kept in ascending order.
	//
	// Membership tests use binary search; insertion and removal are O(n).
	// Iteration yields members in ascending order.
	type SortedSet<T: Ordered> {
		internal items T[]
		internal cur   int

		def new() {}

		// Creates a set holding the given values.
		def new(values T[]) {
			for let (_, v) in values {
				add(v)
			}
		}

		// Adds value; returns false when it was already present.
		def add(value T) bool {
			let pos = search(value)
			return false when pos < items.len() && items[pos] == value
			items.push(value)
			for let i = items.len() - 1; i > pos; i-- {
				items[i] = items[i - 1]
			}
			items[pos] = value
			return true
		}

		// Removes value; returns false when it was absent.
		def remove(value T) bool {
			let pos = search(value)
			return false when pos >= items.len() || items[pos] != value
			items.remove(pos)
			return true
		}

		// Reports whether value is present.
		def has(value T) bool {
			let pos = search(value)
			return pos < items.len() && items[pos] == value
		}

		// Returns the number of members.
		def len() int {
			return items.len()
		}

		// Reports whether the set has no members.
		def isEmpty() bool {
			return items.len() == 0
		}

		// Removes every member.
		def clear() {
			items.flush()
		}

		// Returns the smallest member, or none when empty.
		def first() ?T {
			return items.first()
		}

		// Returns the largest member, or none when empty.
		def last() ?T {
			return items.last()
		}

		// Returns the member at the given ascending position, or none.
		def at(index int) ?T {
			index += items.len() when index < 0
			return none when index < 0 || index >= items.len()
			return items[index]
		}

		// Returns the largest member not greater than value, or none.
		def floor(value T) ?T {
			let pos = search(value)
			return items[pos] when pos < items.len() && items[pos] == value
			return none when pos == 0
			return items[pos - 1]
		}

		// Returns the smallest member not less than value, or none.
		def ceiling(value T) ?T {
			let pos = search(value)
			return none when pos >= items.len()
			return items[pos]
		}

		// Returns a new set holding the members of both sets.
		def unions(other SortedSet<T>) SortedSet<T> {
			let out = new SortedSet<T>(items)
			for let (_, v) in other.items {
				out.add(v)
			}
			return out
		}

		// Returns a new set holding the members common to both sets.
		def intersect(other SortedSet<T>) SortedSet<T> {
			let out = new SortedSet<T>()
			for let (_, v) in items {
				out.add(v) when other.has(v)
			}
			return out
		}

		// Returns a new set holding the members of this set not in other.
		def difference(other SortedSet<T>) SortedSet<T> {
			let out = new SortedSet<T>()
			for let (_, v) in items {
				out.add(v) unless other.has(v)
			}
			return out
		}

		// Reports whether every member of this set is also in other.
		def isSubsetOf(other SortedSet<T>) bool {
			for let (_, v) in items {
				return false unless other.has(v)
			}
			return true
		}

		// Reports whether both sets have the same members.
		def equals(other SortedSet<T>) bool {
			return items.equals(other.items)
		}

		// Returns the members in ascending order.
		def toArray() T[] {
			return items.clone()
		}

		// Returns the next member in ascending order; none after the largest,
		// which also resets the cursor.
		def iterate() ?T {
			if cur >= items.len() {
				cur = 0
				return none
			}
			let v = items[cur]
			cur += 1
			return v
		}

		// Returns the first position whose member is not less than value.
		internal def search(value T) int {
			let lo = 0
			let hi = items.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				if items[mid] < value {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			return lo
		}
	}

	// OrderedSet is a set that remembers insertion order.
	//
	// Re-adding a member keeps its original position. Iteration yields
	// members in insertion order.
	type OrderedSet<T: Serializable> {
		internal order T[]
		internal store map<T, bool>
		internal cur   int

		def new() {}

		// Creates a set holding the given values, in the order given.
		def new(values T[]) {
			for let (_, v) in values {
				add(v)
			}
		}

		// Adds value at the end; returns false when it was already present.
		def add(value T) bool {
			return false when store.hasKey(value)
			store = store.set(value, true)
			order.push(value)
			return true
		}

		// Removes value; returns false when it was absent.
		def remove(value T) bool {
			let index = order.indexOf(value)
			return false when index < 0
			order.remove(index)
			store = store.delete(value)
			return true
		}

		// Reports whether value is present.
		def has(value T) bool {
			return store.hasKey(value)
		}

		// Returns the number of members.
		def len() int {
			return order.len()
		}

		// Reports whether the set has no members.
		def isEmpty() bool {
			return order.len() == 0
		}

		// Removes every member.
		def clear() {
			order.flush()
			store = map<T, bool>{}
		}

		// Returns the oldest member, or none when empty.
		def first() ?T {
			return order.first()
		}

		// Returns the newest member, or none when empty.
		def last() ?T {
			return order.last()
		}

		// Returns the member at the given insertion position, or none.
		def at(index int) ?T {
			index += order.len() when index < 0
			return none when index < 0 || index >= order.len()
			return order[index]
		}

		// Returns a new set holding the members of both sets, this set's
		// members first.
		def unions(other OrderedSet<T>) OrderedSet<T> {
			let out = new OrderedSet<T>(order)
			for let (_, v) in other.order {
				out.add(v)
			}
			return out
		}

		// Returns a new set holding the members common to both sets, in this
		// set's order.
		def intersect(other OrderedSet<T>) OrderedSet<T> {
			let out = new OrderedSet<T>()
			for let (_, v) in order {
				out.add(v) when other.has(v)
			}
			return out
		}

		// Returns a new set holding the members of this set not in other.
		def difference(other OrderedSet<T>) OrderedSet<T> {
			let out = new OrderedSet<T>()
			for let (_, v) in order {
				out.add(v) unless other.has(v)
			}
			return out
		}

		// Reports whether every member of this set is also in other.
		def isSubsetOf(other OrderedSet<T>) bool {
			for let (_, v) in order {
				return false unless other.has(v)
			}
			return true
		}

		// Reports whether both sets have the same members, in any order.
		def equals(other OrderedSet<T>) bool {
			return order.len() == other.len() && isSubsetOf(other)
		}

		// Returns the members in insertion order.
		def toArray() T[] {
			return order.clone()
		}

		// Returns the next member in insertion order; none after the last,
		// which also resets the cursor.
		def iterate() ?T {
			if cur >= order.len() {
				cur = 0
				return none
			}
			let v = order[cur]
			cur += 1
			return v
		}
	}

	// MultiSet is a set that counts how many times each member was added.
	type MultiSet<T: Serializable> {
		internal counts   map<T, int>
		internal total    int
		internal snapshot T[]
		internal cur      int

		def new() {}

		// Creates a multiset holding the given values, repeats included.
		def new(values T[]) {
			for let (_, v) in values {
				add(v)
			}
		}

		// Adds value the given number of times and returns its new count.
		def add(value T, times int = 1) int {
			return count(value) when times <= 0
			let n = count(value) + times
			counts = counts.set(value, n)
			total += times
			return n
		}

		// Removes value the given number of times. Returns false when it was
		// absent. Removing more than the count removes every occurrence.
		def remove(value T, times int = 1) bool {
			let n = count(value)
			return false when n == 0 || times <= 0
			if times >= n {
				counts = counts.delete(value)
				total -= n
			} else {
				counts = counts.set(value, n - times)
				total -= times
			}
			return true
		}

		// Removes every occurrence of value. Returns false when it was absent.
		def removeAll(value T) bool {
			return remove(value, count(value))
		}

		// Returns how many times value is present.
		def count(value T) int {
			let n = counts.get(value)
			return 0 when n is none
			return n
		}

		// Reports whether value is present at least once.
		def has(value T) bool {
			return counts.hasKey(value)
		}

		// Returns the total number of members, repeats included.
		def len() int {
			return total
		}

		// Returns the number of distinct members.
		def distinct() int {
			return counts.len()
		}

		// Reports whether the multiset has no members.
		def isEmpty() bool {
			return total == 0
		}

		// Removes every member.
		def clear() {
			counts = map<T, int>{}
			total = 0
		}

		// Returns the distinct members in no particular order.
		def keys() T[] {
			return counts.keys()
		}

		// Returns the members with repeats, grouped by member, in no
		// particular order.
		def toArray() T[] {
			let out T[]
			for let (k, n) in counts {
				for let i = 0; i < n; i++ {
					out.push(k)
				}
			}
			return out
		}

		// Returns the next member, repeats included; none after the last,
		// which also resets the cursor. The members are captured when
		// iteration starts.
		def iterate() ?T {
			snapshot = toArray() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let v = snapshot[cur]
			cur += 1
			return v
		}
	}

	// DisjointSet tracks a partition of the integers 0..len()-1 into sets
	// that can be merged (union-find with path compression and union by
	// rank).
	type DisjointSet {
		internal parent int[]
		internal rank   int[]
		internal groups int

		// Creates a partition of size elements, each in its own set.
		def new(size int = 0) {
			for let i = 0; i < size; i++ {
				add()
			}
		}

		// Adds a new element in its own set and returns its id.
		def add() int {
			let id = parent.len()
			parent.push(id)
			rank.push(0)
			groups += 1
			return id
		}

		// Returns the number of elements.
		def len() int {
			return parent.len()
		}

		// Returns the number of disjoint sets.
		def count() int {
			return groups
		}

		// Returns the representative of the set containing element, or -1 for
		// an unknown element.
		def find(element int) int {
			return -1 when element < 0 || element >= parent.len()
			let root = element
			for parent[root] != root {
				root = parent[root]
			}
			let node = element
			for parent[node] != root {
				let next = parent[node]
				parent[node] = root
				node = next
			}
			return root
		}

		// Merges the sets containing a and b. Returns false when they were
		// already the same set or either element is unknown.
		def merge(a int, b int) bool {
			let ra = find(a)
			let rb = find(b)
			return false when ra < 0 || rb < 0 || ra == rb
			if rank[ra] < rank[rb] {
				parent[ra] = rb
			} else if rank[ra] > rank[rb] {
				parent[rb] = ra
			} else {
				parent[rb] = ra
				rank[ra] += 1
			}
			groups -= 1
			return true
		}

		// Reports whether a and b are in the same set.
		def connected(a int, b int) bool {
			let ra = find(a)
			return ra >= 0 && ra == find(b)
		}

		// Returns the members of the set containing element, ascending; empty
		// for an unknown element.
		def members(element int) int[] {
			let out int[]
			let root = find(element)
			return out when root < 0
			for let i = 0; i < parent.len(); i++ {
				out.push(i) when find(i) == root
			}
			return out
		}
	}
}
