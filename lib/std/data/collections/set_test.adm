partial module std.data.collections {
	use std.testing

	check "HashSet" {
		@test()
		def TestMembership() {
			let s = new HashSet<string>()
			assert s.isEmpty()
			assert s.add("a")
			assert s.add("b")
			assert !s.add("a")
			assert s.len() == 2
			assert s.has("a")
			assert !s.has("c")
			assert s.remove("a")
			assert !s.remove("a")
			assert s.toArray().equals(string["b"])
			let seen string[]
			for let v in s {
				seen.push(v)
			}
			assert seen.equals(string["b"])
			s.clear()
			assert s.isEmpty()
		}

		@test()
		def TestAlgebra() {
			let a = new HashSet<int>(int[1, 2, 3])
			let b = new HashSet<int>(int[2, 3, 4])
			let u = a.unions(b)
			assert u.len() == 4
			assert u.has(1) && u.has(4)
			let i = a.intersect(b)
			assert i.len() == 2
			assert i.has(2) && i.has(3)
			let d = a.difference(b)
			assert d.len() == 1
			assert d.has(1)
			assert i.isSubsetOf(a)
			assert !a.isSubsetOf(b)
			assert a.equals(new HashSet<int>(int[3, 2, 1]))
			assert !a.equals(b)
		}
	}

	check "SortedSet" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestOrdering() {
			let s = new SortedSet<int>(int[5, 1, 3])
			assert s.add(4)
			assert !s.add(4)
			assert s.toArray().equals(int[1, 3, 4, 5])
			assert s.has(3)
			assert !s.has(2)
			assert eq(s.first(), 1)
			assert eq(s.last(), 5)
			assert eq(s.at(1), 3)
			assert eq(s.at(-1), 5)
			assert s.at(4) is none
			assert eq(s.floor(3), 3)
			assert eq(s.floor(2), 1)
			assert s.floor(0) is none
			assert eq(s.ceiling(2), 3)
			assert s.ceiling(6) is none
			assert s.remove(1)
			assert !s.remove(1)
			assert s.toArray().equals(int[3, 4, 5])
			let seen int[]
			for let v in s {
				seen.push(v)
			}
			assert seen.equals(int[3, 4, 5])
			s.clear()
			assert s.isEmpty()
			assert s.first() is none
		}

		@test()
		def TestAlgebra() {
			let a = new SortedSet<string>(string["b", "a", "c"])
			let b = new SortedSet<string>(string["c", "d"])
			assert a.unions(b).toArray().equals(string["a", "b", "c", "d"])
			assert a.intersect(b).toArray().equals(string["c"])
			assert a.difference(b).toArray().equals(string["a", "b"])
			assert a.intersect(b).isSubsetOf(b)
			assert !b.isSubsetOf(a)
			assert a.equals(new SortedSet<string>(string["c", "b", "a"]))
		}
	}

	check "OrderedSet" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestOrder() {
			let s = new OrderedSet<string>(string["c", "a", "c", "b"])
			assert s.toArray().equals(string["c", "a", "b"])
			assert s.len() == 3
			assert !s.add("a")
			assert eq(s.first(), "c")
			assert eq(s.last(), "b")
			assert eq(s.at(1), "a")
			assert s.at(3) is none
			assert s.remove("a")
			assert !s.remove("a")
			assert s.toArray().equals(string["c", "b"])
			assert s.add("a")
			assert s.toArray().equals(string["c", "b", "a"])
			let seen string[]
			for let v in s {
				seen.push(v)
			}
			assert seen.equals(string["c", "b", "a"])

			let other = new OrderedSet<string>(string["x", "b"])
			assert s.unions(other).toArray().equals(string["c", "b", "a", "x"])
			assert s.intersect(other).toArray().equals(string["b"])
			assert s.difference(other).toArray().equals(string["c", "a"])
			assert other.intersect(s).isSubsetOf(s)
			assert s.equals(new OrderedSet<string>(string["a", "b", "c"]))
			s.clear()
			assert s.isEmpty()
		}
	}

	check "MultiSet" {
		@test()
		def TestCounts() {
			let m = new MultiSet<string>(string["a", "b", "a"])
			assert m.len() == 3
			assert m.distinct() == 2
			assert m.count("a") == 2
			assert m.count("z") == 0
			assert m.add("a") == 3
			assert m.add("c", 2) == 2
			assert m.add("c", 0) == 2
			assert m.len() == 6
			assert m.has("c")
			assert m.remove("a")
			assert m.count("a") == 2
			assert m.remove("a", 5)
			assert !m.has("a")
			assert !m.remove("a")
			assert m.removeAll("c")
			assert m.len() == 1
			assert m.keys().equals(string["b"])
			m.add("b")
			assert m.toArray().equals(string["b", "b"])
			let seen string[]
			for let v in m {
				seen.push(v)
			}
			assert seen.equals(string["b", "b"])
			m.clear()
			assert m.isEmpty()
			assert m.distinct() == 0
		}
	}

	check "DisjointSet" {
		@test()
		def TestUnionFind() {
			let d = new DisjointSet(5)
			assert d.len() == 5
			assert d.count() == 5
			assert d.add() == 5
			assert d.count() == 6
			assert d.merge(0, 1)
			assert d.merge(1, 2)
			assert !d.merge(0, 2)
			assert d.merge(3, 4)
			assert d.count() == 3
			assert d.connected(0, 2)
			assert !d.connected(0, 3)
			assert !d.connected(0, 9)
			assert d.find(9) == -1
			assert d.find(0) == d.find(2)
			assert d.members(2).equals(int[0, 1, 2])
			assert d.members(5).equals(int[5])
			assert d.members(9).len() == 0
			assert d.merge(2, 5)
			assert d.members(5).equals(int[0, 1, 2, 5])
			assert !d.merge(-1, 0)
		}
	}
}
