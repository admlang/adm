internal partial module std.data.collections.sort.algorithms {
	use std.data.collections.sort::(SortMethod)

	// Arrays this short finish with insertion sort inside quicksort.
	const QUICK_CUTOFF = 12

	// Counting sort keeps one counter per value in [min, max]; a wider range
	// than this many counters per element goes to radix sort.
	const COUNTING_SPREAD = 8

	// Runs a comparison sort chosen by method; methods that need numbers are
	// resolved by the caller.
	def sortBy<T>(list T[], less def (a, b T) bool, method SortMethod) T[] {
		return list when list.len() < 2
		match method {
			case SortMethod.Quick:
				quickSort(list, less, 0, list.len() - 1)
			case SortMethod.Heap:
				heapSort(list, less)
			case SortMethod.Shell:
				shellSort(list, less)
			case SortMethod.Insertion:
				insertionSort(list, less, 0, list.len() - 1)
			case SortMethod.BinaryInsertion:
				binaryInsertionSort(list, less)
			case SortMethod.Bubble:
				bubbleSort(list, less)
			default:
				mergeSort(list, less)
		}
		return list
	}

	// Bottom-up merge sort through one scratch copy.
	def mergeSort<T>(list T[], less def (a, b T) bool) {
		let n = list.len()
		let src = list
		let dst = list.clone()
		let swapped = false
		for let width = 1; width < n; width *= 2 {
			for let lo = 0; lo < n; lo += 2 * width {
				let mid = lo + width
				mid = n when mid > n
				let hi = mid + width
				hi = n when hi > n
				let i = lo
				let j = mid
				for let k = lo; k < hi; k++ {
					// Take from the right run only when strictly smaller: stability.
					if i < mid && (j >= hi || !less(src[j], src[i])) {
						dst[k] = src[i]
						i++
					} else {
						dst[k] = src[j]
						j++
					}
				}
			}
			let tmp = src
			src = dst
			dst = tmp
			swapped = !swapped
		}
		if swapped {
			for let k = 0; k < n; k++ {
				list[k] = src[k]
			}
		}
	}

	// Quicksort on list[lo..hi], recursing into the smaller side so the stack
	// stays O(log n).
	def quickSort<T>(list T[], less def (a, b T) bool, lo int, hi int) {
		let l = lo
		let h = hi
		for h - l >= QUICK_CUTOFF {
			let mid = l + (h - l) / 2
			// Median of three into list[mid].
			swapIf(list, less, l, mid)
			swapIf(list, less, mid, h)
			swapIf(list, less, l, mid)
			let pivot = list[mid]
			let i = l
			let j = h
			for i <= j {
				for less(list[i], pivot) {
					i++
				}
				for less(pivot, list[j]) {
					j--
				}
				if i <= j {
					list[i], list[j] = list[j], list[i]
					i++
					j--
				}
			}
			if j - l < h - i {
				quickSort(list, less, l, j)
				l = i
			} else {
				quickSort(list, less, i, h)
				h = j
			}
		}
		insertionSort(list, less, l, h)
	}

	// Swaps list[a] and list[b] when list[b] sorts before list[a].
	def swapIf<T>(list T[], less def (a, b T) bool, a int, b int) {
		if less(list[b], list[a]) {
			list[a], list[b] = list[b], list[a]
		}
	}

	def heapSort<T>(list T[], less def (a, b T) bool) {
		let n = list.len()
		for let i = n / 2 - 1; i >= 0; i-- {
			siftDown(list, less, i, n)
		}
		for let end = n - 1; end > 0; end-- {
			list[0], list[end] = list[end], list[0]
			siftDown(list, less, 0, end)
		}
	}

	// Restores the max-heap below root within list[0..n).
	def siftDown<T>(list T[], less def (a, b T) bool, root int, n int) {
		let r = root
		for {
			let child = 2 * r + 1
			break when child >= n
			child++ when child + 1 < n && less(list[child], list[child + 1])
			break when !less(list[r], list[child])
			list[r], list[child] = list[child], list[r]
			r = child
		}
	}

	def shellSort<T>(list T[], less def (a, b T) bool) {
		let n = list.len()
		// Ciura's gaps, extended by ×2.25 for long arrays.
		let gaps = int[1, 4, 10, 23, 57, 132, 301, 701]
		for gaps[gaps.len() - 1] * 9 / 4 < n {
			gaps.push(gaps[gaps.len() - 1] * 9 / 4)
		}
		for let g = gaps.len() - 1; g >= 0; g-- {
			let gap = gaps[g]
			continue when gap >= n
			for let i = gap; i < n; i++ {
				let v = list[i]
				let j = i
				for j >= gap && less(v, list[j - gap]) {
					list[j] = list[j - gap]
					j -= gap
				}
				list[j] = v
			}
		}
	}

	// Insertion sort on list[lo..hi].
	def insertionSort<T>(list T[], less def (a, b T) bool, lo int, hi int) {
		for let i = lo + 1; i <= hi; i++ {
			let v = list[i]
			let j = i
			for j > lo && less(v, list[j - 1]) {
				list[j] = list[j - 1]
				j--
			}
			list[j] = v
		}
	}

	def binaryInsertionSort<T>(list T[], less def (a, b T) bool) {
		for let i = 1; i < list.len(); i++ {
			let v = list[i]
			// First position whose element sorts after v keeps equal elements
			// in order.
			let lo = 0
			let hi = i
			for lo < hi {
				let mid = lo + (hi - lo) / 2
				if less(v, list[mid]) {
					hi = mid
				} else {
					lo = mid + 1
				}
			}
			for let j = i; j > lo; j-- {
				list[j] = list[j - 1]
			}
			list[lo] = v
		}
	}

	def bubbleSort<T>(list T[], less def (a, b T) bool) {
		let n = list.len()
		for n > 1 {
			// Everything past the last swap is in place.
			let last = 0
			for let i = 1; i < n; i++ {
				if less(list[i], list[i - 1]) {
					list[i], list[i - 1] = list[i - 1], list[i]
					last = i
				}
			}
			n = last
		}
	}

	def countingSort<T: Integer>(list T[]) T[] {
		let n = list.len()
		return list when n < 2
		return radixSort(list) when list[0].bits() > 64
		let lo = list[0]
		let hi = list[0]
		for let (_, v) in list {
			lo = v when v < lo
			hi = v when v > hi
		}
		// Measured on the order-preserving keys so the span cannot overflow.
		let span = orderKey(hi) - orderKey(lo)
		return radixSort(list) when span >= uint64(n * COUNTING_SPREAD + 256)
		let counts int[]
		counts.len(int(span) + 1)
		let base = orderKey(lo)
		for let (_, v) in list {
			counts[int(orderKey(v) - base)] += 1
		}
		let k = 0
		for let i = 0; i < counts.len(); i++ {
			let c = counts[i]
			continue when c == 0
			let v = T(int64((base + uint64(i)) ^ signFlip(lo)))
			for let r = 0; r < c; r++ {
				list[k] = v
				k++
			}
		}
		return list
	}

	def radixSort<T: Integer>(list T[]) T[] {
		let n = list.len()
		return list when n < 2
		if list[0].bits() > 64 {
			mergeSort(list, (a T, b T) => a < b)
			return list
		}
		let bytes = list[0].bits() / 8
		let src = list.clone()
		let dst = list.clone()
		let counts int[]
		counts.len(256)
		for let pass = 0; pass < bytes; pass++ {
			let shift = uint64(pass * 8)
			for let i = 0; i < 256; i++ {
				counts[i] = 0
			}
			for let (_, v) in src {
				counts[int((orderKey(v) >> shift) & 0xff)] += 1
			}
			// A byte every key shares moves nothing.
			continue when counts[int((orderKey(src[0]) >> shift) & 0xff)] == n
			let sum = 0
			for let i = 0; i < 256; i++ {
				let c = counts[i]
				counts[i] = sum
				sum += c
			}
			for let (_, v) in src {
				let b = int((orderKey(v) >> shift) & 0xff)
				dst[counts[b]] = v
				counts[b] += 1
			}
			let tmp = src
			src = dst
			dst = tmp
		}
		for let k = 0; k < n; k++ {
			list[k] = src[k]
		}
		return list
	}

	// Maps an integer of up to 64 bits to a uint64 whose unsigned order is the
	// integer's order: signed values have their sign bit flipped.
	def orderKey<T: Integer>(v T) uint64 {
		return uint64(int64(v)) ^ signFlip(v)
	}

	// The sign bit of a uint64 key when T is signed, else 0.
	def signFlip<T: Integer>(_ T) uint64 {
		return uint64(0) when T(0) - T(1) > T(0)
		return uint64(1) << uint64(63)
	}

	def bucketSort<T: Numeric>(list T[]) T[] {
		let n = list.len()
		return list when n < 2
		let lo = list[0]
		let hi = list[0]
		for let (_, v) in list {
			lo = v when v < lo
			hi = v when v > hi
		}
		// NaN fails every comparison, so lo == hi also covers an all-NaN array.
		if !(lo < hi) {
			mergeSort(list, (a T, b T) => a < b)
			return list
		}
		let buckets T[][]
		for let i = 0; i < n; i++ {
			let bucket T[]
			buckets.push(bucket)
		}
		let width = float64(hi) - float64(lo)
		for let (_, v) in list {
			let b = int((float64(v) - float64(lo)) / width * float64(n - 1))
			b = 0 when b < 0
			b = n - 1 when b >= n
			buckets[b].push(v)
		}
		let k = 0
		for let (_, bucket) in buckets {
			insertionSort(bucket, (a T, b T) => a < b, 0, bucket.len() - 1)
			for let (_, v) in bucket {
				list[k] = v
				k++
			}
		}
		return list
	}
}
