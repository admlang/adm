partial module std.data.collections.sort {
	use std.data.collections.sort.algorithms::*

	// Comparable is a type with a total order. Numbers, `string`, `char`,
	// `duration` and `time.Time` implement it, so arrays of them sort without
	// a compare function; a type of your own implements it by declaring the
	// method.
	//
	// Example:
	// ```example
	// type Version {
	// 	major int
	// 	minor int
	//
	// 	def compare(other Version) int {
	// 		let c = major.compare(other.major)
	// 		return c when c != 0
	// 		return minor.compare(other.minor)
	// 	}
	// }
	//
	// sort(versions)
	// ```
	interface Comparable<T> {
		// Returns -1 when this value sorts before other, 1 when it sorts after
		// other, and 0 when they are equal.
		def compare(other T) int
	}

	// SortMethod is the algorithm `sort` runs. Merge is the default and the
	// only stable choice besides Insertion, BinaryInsertion, Bubble and
	// Counting.
	enum SortMethod {
		// Merge sort: stable, O(n log n), n extra elements of space.
		Merge,
		// Quicksort with a median-of-three pivot: O(n log n) on average, in
		// place, not stable.
		Quick,
		// Heapsort: O(n log n) worst case, in place, not stable.
		Heap,
		// Shellsort with Ciura's gaps: in place, not stable, quick on small
		// and medium arrays.
		Shell,
		// Insertion sort: stable, O(n²), fastest on short or nearly sorted
		// arrays.
		Insertion,
		// Insertion sort that finds each position by binary search: stable,
		// fewer comparisons, the same O(n²) moves.
		BinaryInsertion,
		// Bubble sort: stable, O(n²), stops early on a sorted array.
		Bubble,
		// Counting sort: stable, O(n + range) where range is max - min.
		// Integers only; a range much larger than the array sorts with Radix
		// instead, and other element types sort with Merge.
		Counting,
		// LSD radix sort on bytes: O(n · width), n extra elements of space.
		// Integers up to 64 bits only; other element types sort with Merge.
		Radix,
		// Bucket sort: n buckets over [min, max], each insertion-sorted.
		// O(n) on evenly spread values. Numbers only; other element types
		// sort with Merge.
		Bucket
	}

	// Sorts list in place into ascending order with method, and returns list.
	//
	// Example:
	// ```example
	// sort(names)
	// sort(scores, method = SortMethod.Quick)
	// ```
	def sort<T: Comparable<T>>(list T[], method SortMethod = SortMethod.Merge) T[] {
		match T {
			case Integer:
				return countingSort(list) when method == SortMethod.Counting
				return radixSort(list) when method == SortMethod.Radix
				return bucketSort(list) when method == SortMethod.Bucket
			case Float:
				return bucketSort(list) when method == SortMethod.Bucket
		}
		match method {
			case SortMethod.Counting, SortMethod.Radix, SortMethod.Bucket:
				return sortBy(list, (a T, b T) => a.compare(b) < 0, SortMethod.Merge)
			default:
				return sortBy(list, (a T, b T) => a.compare(b) < 0, method)
		}
	}

	// Sorts list in place with method so that less(a, b) holds for every a
	// placed before b, and returns list. less orders elements that have no
	// natural order, or orders them differently (descending, by a field).
	// Counting, Radix and Bucket need numbers and sort with Merge here.
	//
	// Example:
	// ```example
	// sort(people, (a Person, b Person) => a.age < b.age)
	// sort(scores, (a int, b int) => a > b, method = SortMethod.Heap)
	// ```
	def sort<T>(list T[], less def (a, b T) bool, method SortMethod = SortMethod.Merge) T[] {
		match method {
			case SortMethod.Counting, SortMethod.Radix, SortMethod.Bucket:
				return sortBy(list, less, SortMethod.Merge)
			default:
				return sortBy(list, less, method)
		}
	}
}
