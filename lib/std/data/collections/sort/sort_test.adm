partial module std.data.collections.sort {
	use (
		std.testing
		std.time
	)

	check "sort" {
		type Version {
			major int
			minor int

			def new(major int, minor int) {
				self.major = major
				self.minor = minor
			}

			def compare(other Version) int {
				let c = major.compare(other.major)
				return c when c != 0
				return minor.compare(other.minor)
			}
		}

		// Every method, so each test runs all of them.
		def methods() SortMethod[] {
			return SortMethod[
				SortMethod.Merge,
				SortMethod.Quick,
				SortMethod.Heap,
				SortMethod.Shell,
				SortMethod.Insertion,
				SortMethod.BinaryInsertion,
				SortMethod.Bubble,
				SortMethod.Counting,
				SortMethod.Radix,
				SortMethod.Bucket
			]
		}

		// A scrambled run of n integers in [-n/2, n/2), duplicates included.
		def scrambled(n int) int[] {
			let out int[]
			let x = 12345
			for let i = 0; i < n; i++ {
				x = (x * 1103515245 + 12345) % 2147483648
				out.push(x % n - n / 2)
			}
			return out
		}

		def ascending<T: Comparable<T>>(list T[]) bool {
			for let i = 1; i < list.len(); i++ {
				return false when list[i - 1].compare(list[i]) > 0
			}
			return true
		}

		@test()
		def sortsIntegersWithEveryMethod() {
			for let (_, m) in methods() {
				for let (_, n) in int[0, 1, 2, 3, 13, 100, 1000] {
					let list = scrambled(n)
					sort(list, method = m)
					assert list.len() == n
					assert ascending(list)
				}
			}
		}

		@test()
		def sortsWideRangeIntegers() {
			for let (_, m) in methods() {
				let list = int64[9000000000000000000, -9000000000000000000, 0, -1, 1, 42]
				sort(list, method = m)
				assert list.equals(int64[-9000000000000000000, -1, 0, 1, 42, 9000000000000000000])
			}
		}

		@test()
		def sortsUnsignedAndBytes() {
			for let (_, m) in methods() {
				let list = uint64[18446744073709551615, 0, 7, 3]
				sort(list, method = m)
				assert list.equals(uint64[0, 3, 7, 18446744073709551615])
				let bytes = byte[200, 1, 255, 0, 1]
				sort(bytes, method = m)
				assert bytes.equals(byte[0, 1, 1, 200, 255])
			}
		}

		@test()
		def sortsFloats() {
			for let (_, m) in methods() {
				let list = float[3.5, -1.25, 0.0, 2.0, -1.25, 100.5]
				sort(list, method = m)
				assert list.equals(float[-1.25, -1.25, 0.0, 2.0, 3.5, 100.5])
			}
		}

		@test()
		def sortsStringsCharsDurationsAndTimes() {
			for let (_, m) in methods() {
				let names = string["pear", "apple", "fig", "apple"]
				sort(names, method = m)
				assert names.equals(string["apple", "apple", "fig", "pear"])
				let chars = char['c', 'a', 'b']
				sort(chars, method = m)
				assert chars.equals(char['a', 'b', 'c'])
				let spans = duration[2s, 500ms, 1m]
				sort(spans, method = m)
				assert spans.equals(duration[500ms, 2s, 1m])
				let times = time.Time[new time.Time(3s, 0s), new time.Time(1s, 0s), new time.Time(2s, 0s)]
				sort(times, method = m)
				assert times[0].unixNs() == 1000000000
				assert times[2].unixNs() == 3000000000
			}
		}

		@test()
		def sortsComparableTypes() {
			for let (_, m) in methods() {
				let list = Version[new Version(1, 2), new Version(0, 9), new Version(1, 0)]
				sort(list, method = m)
				assert list[0].major == 0
				assert list[1].minor == 0
				assert list[2].minor == 2
			}
		}

		@test()
		def sortsWithLess() {
			for let (_, m) in methods() {
				let list = scrambled(200)
				sort(list, (a int, b int) => a > b, method = m)
				for let i = 1; i < list.len(); i++ {
					assert list[i - 1] >= list[i]
				}
			}
		}

		@test()
		def stableMethodsKeepEqualElementsInOrder() {
			let stable = SortMethod[SortMethod.Merge, SortMethod.Insertion, SortMethod.BinaryInsertion, SortMethod.Bubble]
			for let (_, m) in stable {
				let list = string["bb", "a", "cc", "b", "aa", "c"]
				sort(list, (a string, b string) => a.len() < b.len(), method = m)
				assert list.equals(string["a", "b", "c", "bb", "cc", "aa"])
			}
		}

		@test()
		def returnsTheSortedList() {
			let list = int[3, 1, 2]
			assert sort(list).equals(int[1, 2, 3])
		}
	}
}
