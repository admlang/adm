partial module std.data.collections {
	// SortedMap is a key/value map kept in ascending key order.
	//
	// Lookups use binary search, so get, has, floor and ceiling are O(log n)
	// while set and delete are O(n).
	type SortedMap<K: Ordered, V> {
		internal keyList   K[]
		internal valueList V[]
		internal cur       int

		def new() {}

		// Returns the number of entries.
		def len() int {
			return keyList.len()
		}

		// Reports whether the map holds no entries.
		def isEmpty() bool {
			return keyList.len() == 0
		}

		// Removes every entry.
		def clear() {
			keyList.flush()
			valueList.flush()
		}

		// Associates value with key, replacing any existing value.
		def set(key K, value V) {
			let pos = search(key)
			if pos < keyList.len() && keyList[pos] == key {
				valueList[pos] = value
				return
			}
			keyList.push(key)
			valueList.push(value)
			for let i = keyList.len() - 1; i > pos; i-- {
				keyList[i] = keyList[i - 1]
				valueList[i] = valueList[i - 1]
			}
			keyList[pos] = key
			valueList[pos] = value
		}

		// Returns the value for key, or none when absent.
		def get(key K) ?V {
			let pos = search(key)
			return none when pos >= keyList.len() || keyList[pos] != key
			return valueList[pos]
		}

		// Returns the value for key, or fallback when absent.
		def get(key K, fallback V) V {
			let v = get(key)
			return fallback when v is none
			return v
		}

		// Reports whether key is present.
		def has(key K) bool {
			let pos = search(key)
			return pos < keyList.len() && keyList[pos] == key
		}

		// Removes key. Returns false when it was absent.
		def delete(key K) bool {
			let pos = search(key)
			return false when pos >= keyList.len() || keyList[pos] != key
			keyList.remove(pos)
			valueList.remove(pos)
			return true
		}

		// Returns the entry with the smallest key, or none when empty.
		def first() ?Entry<K, V> {
			return entryAt(0)
		}

		// Returns the entry with the largest key, or none when empty.
		def last() ?Entry<K, V> {
			return entryAt(keyList.len() - 1)
		}

		// Returns the entry with the largest key not greater than key, or none.
		def floor(key K) ?Entry<K, V> {
			let pos = search(key)
			return entryAt(pos) when pos < keyList.len() && keyList[pos] == key
			return entryAt(pos - 1)
		}

		// Returns the entry with the smallest key not less than key, or none.
		def ceiling(key K) ?Entry<K, V> {
			return entryAt(search(key))
		}

		// Returns the keys in ascending order.
		def keys() K[] {
			return keyList.clone()
		}

		// Returns the values in ascending key order.
		def values() V[] {
			return valueList.clone()
		}

		// Returns the entries in ascending key order.
		def entries() Entry<K, V>[] {
			let out Entry<K, V>[]
			for let i = 0; i < keyList.len(); i++ {
				out.push(new Entry<K, V>(keyList[i], valueList[i]))
			}
			return out
		}

		// Returns the next entry in key order; none after the last, which also
		// resets the cursor.
		def iterate() ?Entry<K, V> {
			if cur >= keyList.len() {
				cur = 0
				return none
			}
			let e = entryAt(cur)
			cur += 1
			return e
		}

		internal def entryAt(index int) ?Entry<K, V> {
			return none when index < 0 || index >= keyList.len()
			return new Entry<K, V>(keyList[index], valueList[index])
		}

		// Returns the first position whose key is not less than key.
		internal def search(key K) int {
			let lo = 0
			let hi = keyList.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				if keyList[mid] < key {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			return lo
		}
	}
}
