partial module std.data.collections {
	use std.testing

	check "SortedMap" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		def key<K, V>(e ?Entry<K, V>) ?K {
			return none when e is none
			return e.key
		}

		@test()
		def TestOrdering() {
			let m = new SortedMap<int, string>()
			assert m.isEmpty()
			assert m.first() is none
			assert m.floor(5) is none
			m.set(5, "five")
			m.set(1, "one")
			m.set(9, "nine")
			m.set(5, "FIVE")
			assert m.len() == 3
			assert m.keys().equals(int[1, 5, 9])
			assert m.values().equals(string["one", "FIVE", "nine"])
			assert eq(m.get(5), "FIVE")
			assert m.get(2) is none
			assert m.get(2, "?") == "?"
			assert m.has(9)
			assert !m.has(0)

			assert eq(key(m.first()), 1)
			assert eq(key(m.last()), 9)
			assert eq(key(m.floor(5)), 5)
			assert eq(key(m.floor(6)), 5)
			assert m.floor(0) is none
			assert eq(key(m.ceiling(6)), 9)
			assert eq(key(m.ceiling(1)), 1)
			assert m.ceiling(10) is none

			assert m.delete(5)
			assert !m.delete(5)
			assert m.keys().equals(int[1, 9])
			let keys int[]
			for let e in m {
				keys.push(e.key)
			}
			assert keys.equals(int[1, 9])
			m.clear()
			assert m.isEmpty()
		}

		@test()
		def TestStringKeys() {
			let m = new SortedMap<string, int>()
			m.set("pear", 3)
			m.set("apple", 1)
			m.set("fig", 2)
			assert m.keys().equals(string["apple", "fig", "pear"])
			assert eq(key(m.floor("grape")), "fig")
			assert eq(key(m.ceiling("grape")), "pear")
			assert m.entries().len() == 3
		}
	}
}
