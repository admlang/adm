partial module std.data.collections {
	// SparseArray is an integer-indexed array that stores only the indices
	// that have been set.
	//
	// Iteration yields entries in ascending index order.
	type SparseArray<T> {
		internal store    map<int, T>
		internal length   int
		internal snapshot Entry<int, T>[]
		internal cur      int

		def new() {}

		// Returns the logical length: one past the highest index ever set,
		// or the length given to resize.
		def len() int {
			return length
		}

		// Returns the number of indices that hold a value.
		def count() int {
			return store.len()
		}

		// Reports whether no index holds a value.
		def isEmpty() bool {
			return store.len() == 0
		}

		// Removes every value and resets the length to zero.
		def clear() {
			store = map<int, T>{}
			length = 0
		}

		// Stores value at index, extending the logical length when needed.
		// Negative indices are ignored.
		def set(index int, value T) {
			return when index < 0
			store = store.set(index, value)
			length = index + 1 when index >= length
		}

		// Returns the value at index, or none when the index holds nothing.
		def get(index int) ?T {
			return store.get(index)
		}

		// Returns the value at index, or fallback when the index holds
		// nothing.
		def get(index int, fallback T) T {
			let v = store.get(index)
			return fallback when v is none
			return v
		}

		// Reports whether index holds a value.
		def has(index int) bool {
			return store.hasKey(index)
		}

		// Removes the value at index. Returns false when it held nothing.
		// The logical length is unchanged.
		def delete(index int) bool {
			return false unless store.hasKey(index)
			store = store.delete(index)
			return true
		}

		// Sets the logical length, dropping values at or beyond it.
		def resize(newLength int) {
			length = newLength.max(0)
			for let (_, i) in store.keys() {
				store = store.delete(i) when i >= length
			}
		}

		// Returns the populated indices in ascending order.
		def indices() int[] {
			let keys = store.keys()
			keys.sort((a int, b int) => a < b)
			return keys
		}

		// Returns the entries in ascending index order.
		def entries() Entry<int, T>[] {
			let out Entry<int, T>[]
			for let (_, i) in indices() {
				let v = store.get(i)
				continue when v is none
				out.push(new Entry<int, T>(i, v))
			}
			return out
		}

		// Returns a dense array of the logical length, with fallback at
		// every index that holds nothing.
		def toArray(fallback T) T[] {
			let out T[]
			for let i = 0; i < length; i++ {
				out.push(get(i, fallback))
			}
			return out
		}

		// Returns the next entry in ascending index order; none after the
		// last, which also resets the cursor. The entries are captured when
		// iteration starts.
		def iterate() ?Entry<int, T> {
			snapshot = entries() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let e = snapshot[cur]
			cur += 1
			return e
		}
	}

	// SparseSet is a set of integers in [0, capacity) with O(1) insertion,
	// removal, membership and clearing, and cache-friendly iteration.
	//
	// Iteration yields members in insertion order (removal moves the last
	// member into the removed slot).
	type SparseSet {
		internal dense  int[]
		internal sparse int[]
		internal cur    int

		// Creates an empty set able to hold values below capacity.
		def new(capacity int) {
			sparse.len(capacity.max(0))
		}

		// Returns the exclusive upper bound on member values.
		def capacity() int {
			return sparse.len()
		}

		// Returns the number of members.
		def len() int {
			return dense.len()
		}

		// Reports whether the set has no members.
		def isEmpty() bool {
			return dense.len() == 0
		}

		// Removes every member.
		def clear() {
			dense.flush()
		}

		// Adds value. Returns false when it was already present or lies
		// outside [0, capacity).
		def add(value int) bool {
			return false when value < 0 || value >= sparse.len()
			return false when has(value)
			sparse[value] = dense.len()
			dense.push(value)
			return true
		}

		// Removes value. Returns false when it was absent.
		def remove(value int) bool {
			return false unless has(value)
			let slot = sparse[value]
			let last = dense.pop()
			if last != value {
				dense[slot] = last
				sparse[last] = slot
			}
			return true
		}

		// Reports whether value is a member.
		def has(value int) bool {
			return false when value < 0 || value >= sparse.len()
			let slot = sparse[value]
			return slot < dense.len() && dense[slot] == value
		}

		// Returns the member at the given position in iteration order, or
		// none.
		def at(index int) ?int {
			return none when index < 0 || index >= dense.len()
			return dense[index]
		}

		// Returns the members in iteration order.
		def toArray() int[] {
			return dense.clone()
		}

		// Returns the next member; none after the last, which also resets
		// the cursor.
		def iterate() ?int {
			if cur >= dense.len() {
				cur = 0
				return none
			}
			let v = dense[cur]
			cur += 1
			return v
		}
	}

	// SparseCell is one populated position of a SparseMatrix.
	type SparseCell<T> {
		row   int
		col   int
		value T

		def new(row int, col int, value T) {
			self.row = row
			self.col = col
			self.value = value
		}
	}

	// SparseMatrix is a fixed-shape matrix that stores only the cells that
	// have been set.
	//
	// Iteration yields cells in row-major order.
	type SparseMatrix<T> {
		internal rowCount int
		internal colCount int
		internal store    map<int, T>
		internal snapshot SparseCell<T>[]
		internal cur      int

		// Creates an empty rows-by-cols matrix.
		def new(rows int, cols int) {
			rowCount = rows.max(0)
			colCount = cols.max(0)
		}

		// Returns the number of rows.
		def rows() int {
			return rowCount
		}

		// Returns the number of columns.
		def cols() int {
			return colCount
		}

		// Returns the number of populated cells.
		def count() int {
			return store.len()
		}

		// Reports whether no cell is populated.
		def isEmpty() bool {
			return store.len() == 0
		}

		// Removes every value.
		def clear() {
			store = map<int, T>{}
		}

		// Stores value at (row, col). Returns false when the position lies
		// outside the matrix.
		def set(row int, col int, value T) bool {
			return false unless inBounds(row, col)
			store = store.set(row * colCount + col, value)
			return true
		}

		// Returns the value at (row, col), or none when the cell is
		// unpopulated or out of bounds.
		def get(row int, col int) ?T {
			return none unless inBounds(row, col)
			return store.get(row * colCount + col)
		}

		// Returns the value at (row, col), or fallback when the cell is
		// unpopulated or out of bounds.
		def get(row int, col int, fallback T) T {
			let v = get(row, col)
			return fallback when v is none
			return v
		}

		// Reports whether (row, col) is populated.
		def has(row int, col int) bool {
			return false unless inBounds(row, col)
			return store.hasKey(row * colCount + col)
		}

		// Removes the value at (row, col). Returns false when it held nothing.
		def delete(row int, col int) bool {
			return false unless has(row, col)
			store = store.delete(row * colCount + col)
			return true
		}

		// Returns the populated cells in row-major order.
		def cells() SparseCell<T>[] {
			let keys = store.keys()
			keys.sort((a int, b int) => a < b)
			let out SparseCell<T>[]
			for let (_, k) in keys {
				let v = store.get(k)
				continue when v is none
				out.push(new SparseCell<T>(k / colCount, k % colCount, v))
			}
			return out
		}

		// Returns the populated cells of one row, in column order.
		def row(index int) SparseCell<T>[] {
			let out SparseCell<T>[]
			for let (_, c) in cells() {
				out.push(c) when c.row == index
			}
			return out
		}

		// Returns the populated cells of one column, in row order.
		def col(index int) SparseCell<T>[] {
			let out SparseCell<T>[]
			for let (_, c) in cells() {
				out.push(c) when c.col == index
			}
			return out
		}

		// Returns a new matrix with rows and columns swapped.
		def transpose() SparseMatrix<T> {
			let out = new SparseMatrix<T>(colCount, rowCount)
			for let (_, c) in cells() {
				out.set(c.col, c.row, c.value)
			}
			return out
		}

		// Returns a dense row-major array of arrays, with fallback in every
		// unpopulated cell.
		def toArray(fallback T) T[][] {
			let out T[][]
			for let r = 0; r < rowCount; r++ {
				let line T[]
				for let c = 0; c < colCount; c++ {
					line.push(get(r, c, fallback))
				}
				out.push(line)
			}
			return out
		}

		// Returns the next populated cell in row-major order; none after the
		// last, which also resets the cursor. The cells are captured when
		// iteration starts.
		def iterate() ?SparseCell<T> {
			snapshot = cells() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let c = snapshot[cur]
			cur += 1
			return c
		}

		internal def inBounds(row int, col int) bool {
			return row >= 0 && row < rowCount && col >= 0 && col < colCount
		}
	}
}
