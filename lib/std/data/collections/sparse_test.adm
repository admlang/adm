partial module std.data.collections {
	use std.testing

	check "SparseArray" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestSetGet() {
			let a = new SparseArray<string>()
			assert a.isEmpty()
			assert a.len() == 0
			a.set(5, "five")
			a.set(2, "two")
			a.set(-1, "neg")
			assert a.len() == 6
			assert a.count() == 2
			assert eq(a.get(5), "five")
			assert a.get(3) is none
			assert a.get(3, "-") == "-"
			assert a.has(2)
			assert !a.has(3)
			assert a.indices().equals(int[2, 5])
			assert a.toArray("").equals(string["", "", "two", "", "", "five"])
			assert a.delete(2)
			assert !a.delete(2)
			assert a.len() == 6
			assert a.count() == 1
			a.set(9, "nine")
			let keys int[]
			for let e in a {
				keys.push(e.key)
			}
			assert keys.equals(int[5, 9])
			a.resize(6)
			assert a.count() == 1
			assert !a.has(9)
			a.resize(20)
			assert a.len() == 20
			a.clear()
			assert a.isEmpty()
			assert a.len() == 0
		}
	}

	check "SparseSet" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestMembership() {
			let s = new SparseSet(10)
			assert s.capacity() == 10
			assert s.isEmpty()
			assert s.add(3)
			assert s.add(7)
			assert s.add(1)
			assert !s.add(3)
			assert !s.add(10)
			assert !s.add(-1)
			assert s.len() == 3
			assert s.has(7)
			assert !s.has(2)
			assert !s.has(99)
			assert s.toArray().equals(int[3, 7, 1])
			assert eq(s.at(0), 3)
			assert s.at(3) is none
			assert s.remove(3)
			assert !s.remove(3)
			assert s.toArray().equals(int[1, 7])
			assert s.has(1)
			assert s.remove(7)
			assert s.toArray().equals(int[1])
			let seen int[]
			s.add(4)
			for let v in s {
				seen.push(v)
			}
			assert seen.equals(int[1, 4])
			s.clear()
			assert s.isEmpty()
			assert !s.has(1)
			assert s.add(1)
		}
	}

	check "SparseMatrix" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestCells() {
			let m = new SparseMatrix<int>(3, 4)
			assert m.rows() == 3
			assert m.cols() == 4
			assert m.isEmpty()
			assert m.set(0, 1, 5)
			assert m.set(2, 3, 7)
			assert m.set(1, 0, 9)
			assert !m.set(3, 0, 1)
			assert !m.set(0, 4, 1)
			assert m.count() == 3
			assert eq(m.get(2, 3), 7)
			assert m.get(1, 1) is none
			assert m.get(1, 1, 0) == 0
			assert m.get(5, 5) is none
			assert m.has(0, 1)
			assert !m.has(0, 0)

			let cells = m.cells()
			assert cells.len() == 3
			assert cells[0].row == 0 && cells[0].col == 1 && cells[0].value == 5
			assert cells[1].row == 1 && cells[1].col == 0
			assert cells[2].row == 2 && cells[2].col == 3
			assert m.row(1).len() == 1
			assert m.row(1)[0].value == 9
			assert m.col(3).len() == 1
			assert m.col(2).len() == 0

			let dense = m.toArray(0)
			assert dense.len() == 3
			assert dense[0].equals(int[0, 5, 0, 0])
			assert dense[1].equals(int[9, 0, 0, 0])
			assert dense[2].equals(int[0, 0, 0, 7])

			let t = m.transpose()
			assert t.rows() == 4
			assert t.cols() == 3
			assert eq(t.get(1, 0), 5)
			assert eq(t.get(3, 2), 7)
			assert eq(t.get(0, 1), 9)

			let seen int[]
			for let c in m {
				seen.push(c.value)
			}
			assert seen.equals(int[5, 9, 7])
			assert m.delete(0, 1)
			assert !m.delete(0, 1)
			assert m.count() == 2
			m.clear()
			assert m.isEmpty()
		}
	}
}
