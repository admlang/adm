partial module std.data.collections {
	// Stack is a last-in, first-out collection backed by an array.
	//
	// Iteration yields elements from the top of the stack down to the bottom.
	type Stack<T> {
		internal items T[]
		internal cur   int

		// Creates an empty stack with room for capacity elements before the
		// backing array grows.
		def new(capacity int = 16) {
			items.cap(capacity.max(0))
		}

		// Returns the number of elements on the stack.
		def len() int {
			return items.len()
		}

		// Reports whether the stack holds no elements.
		def isEmpty() bool {
			return items.len() == 0
		}

		// Removes all elements.
		def clear() {
			items.flush()
		}

		// Pushes a value onto the top of the stack.
		def push(value T) {
			items.push(value)
		}

		// Removes and returns the top element, or none when the stack is empty.
		def pop() ?T {
			return none when items.len() == 0
			return items.pop()
		}

		// Returns the top element without removing it, or none when empty.
		def peek() ?T {
			return none when items.len() == 0
			return items[items.len() - 1]
		}

		// Reports whether the stack contains the given value.
		def contains(value T) bool {
			return items.includes(value)
		}

		// Returns the elements as a new array, bottom first.
		def toArray() T[] {
			return items.clone()
		}

		// Returns the next element from the top down; none after the bottom,
		// which also resets the cursor.
		def iterate() ?T {
			if cur >= items.len() {
				cur = 0
				return none
			}
			let v = items[items.len() - 1 - cur]
			cur += 1
			return v
		}
	}
}
