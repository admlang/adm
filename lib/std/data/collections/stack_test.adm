partial module std.data.collections {
	use std.testing

	check "Stack" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestPushPop() {
			let s = new Stack<int>()
			assert s.isEmpty()
			assert s.pop() is none
			assert s.peek() is none

			s.push(1)
			s.push(2)
			s.push(3)
			assert s.len() == 3
			assert eq(s.peek(), 3)
			assert eq(s.pop(), 3)
			assert eq(s.pop(), 2)
			assert s.len() == 1
			assert s.contains(1)
			assert !s.contains(2)
			assert eq(s.pop(), 1)
			assert s.isEmpty()
			assert s.pop() is none
		}

		@test()
		def TestClearAndArray() {
			let s = new Stack<string>(2)
			s.push("a")
			s.push("b")
			s.push("c")
			assert s.toArray().equals(string["a", "b", "c"])
			let seen string[]
			for let v in s {
				seen.push(v)
			}
			assert seen.equals(string["c", "b", "a"])
			s.clear()
			assert s.isEmpty()
			assert s.peek() is none
		}
	}
}
