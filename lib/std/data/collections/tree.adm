partial module std.data.collections {
	// TreeNode is a node of a general tree: a value and any number of
	// children in insertion order.
	type TreeNode<T> {
		value    T
		children TreeNode<T>[]

		def new(value T) {
			self.value = value
		}

		// Appends a child holding value and returns the new node.
		def add(value T) TreeNode<T> {
			let child = new TreeNode<T>(value)
			children.push(child)
			return child
		}

		// Removes the first direct child holding value. Returns whether one
		// was found.
		def remove(value T) bool {
			for let i = 0; i < children.len(); i++ {
				if children[i].value == value {
					children.remove(i)
					return true
				}
			}
			return false
		}

		// Reports whether the node has no children.
		def isLeaf() bool {
			return children.len() == 0
		}

		// Returns the number of nodes in the subtree rooted here, including
		// this node.
		def size() int {
			let total = 1
			for let (_, c) in children {
				total += c.size()
			}
			return total
		}

		// Returns the number of edges on the longest path down from this node.
		def height() int {
			let deepest = -1
			for let (_, c) in children {
				deepest = deepest.max(c.height())
			}
			return deepest + 1
		}

		// Returns the first node in the subtree holding value, searching
		// depth-first, or none.
		def find(value T) ?TreeNode<T> {
			return self when self.value == value
			for let (_, c) in children {
				let hit = c.find(value)
				return hit unless hit is none
			}
			return none
		}

		// Appends the subtree's values to out in pre-order (node before its
		// children).
		def preorder(out T[]) {
			out.push(value)
			for let (_, c) in children {
				c.preorder(out)
			}
		}

		// Appends the subtree's values to out in post-order (children before
		// the node).
		def postorder(out T[]) {
			for let (_, c) in children {
				c.postorder(out)
			}
			out.push(value)
		}
	}

	// Tree is a general (n-ary) tree of values with an optional root.
	type Tree<T> {
		root ?TreeNode<T>

		// Creates an empty tree.
		def new() {}

		// Creates a tree whose root holds value.
		def new(value T) {
			root = new TreeNode<T>(value)
		}

		// Reports whether the tree has no nodes.
		def isEmpty() bool {
			return root is none
		}

		// Returns the number of nodes.
		def len() int {
			let r = root
			return 0 when r is none
			return r.size()
		}

		// Returns the number of edges on the longest root-to-leaf path, or -1
		// for an empty tree.
		def height() int {
			let r = root
			return -1 when r is none
			return r.height()
		}

		// Removes every node.
		def clear() {
			root = none
		}

		// Returns the first node holding value in depth-first order, or none.
		def find(value T) ?TreeNode<T> {
			let r = root
			return none when r is none
			return r.find(value)
		}

		// Reports whether some node holds value.
		def contains(value T) bool {
			return !(find(value) is none)
		}

		// Returns the values in pre-order.
		def preorder() T[] {
			let out T[]
			let r = root
			return out when r is none
			r.preorder(out)
			return out
		}

		// Returns the values in post-order.
		def postorder() T[] {
			let out T[]
			let r = root
			return out when r is none
			r.postorder(out)
			return out
		}

		// Returns the values level by level, left to right.
		def levelOrder() T[] {
			let out T[]
			let r = root
			return out when r is none
			let queue = new Queue<TreeNode<T >> ()
			queue.push(r)
			for {
				let n = queue.pop()
				break when n is none
				out.push(n.value)
				for let (_, c) in n.children {
					queue.push(c)
				}
			}
			return out
		}
	}

	// BinaryNode is a node of a binary tree.
	type BinaryNode<T> {
		value T
		left  ?BinaryNode<T>
		right ?BinaryNode<T>

		def new(value T) {
			self.value = value
		}

		// Reports whether the node has no children.
		def isLeaf() bool {
			return left is none && right is none
		}

		// Returns the number of nodes in the subtree rooted here.
		def size() int {
			let total = 1
			let l = left
			total += l.size() unless l is none
			let r = right
			total += r.size() unless r is none
			return total
		}

		// Returns the number of edges on the longest path down from this node.
		def height() int {
			let lh = -1
			let rh = -1
			let l = left
			lh = l.height() unless l is none
			let r = right
			rh = r.height() unless r is none
			return lh.max(rh) + 1
		}

		// Appends the subtree's values to out in pre-order.
		def preorder(out T[]) {
			out.push(value)
			let l = left
			l.preorder(out) unless l is none
			let r = right
			r.preorder(out) unless r is none
		}

		// Appends the subtree's values to out in in-order.
		def inorder(out T[]) {
			let l = left
			l.inorder(out) unless l is none
			out.push(value)
			let r = right
			r.inorder(out) unless r is none
		}

		// Appends the subtree's values to out in post-order.
		def postorder(out T[]) {
			let l = left
			l.postorder(out) unless l is none
			let r = right
			r.postorder(out) unless r is none
			out.push(value)
		}
	}

	// BinaryTree is a binary tree filled level by level: insert places each
	// new value in the first free position in level order, so the tree stays
	// complete.
	type BinaryTree<T> {
		root           ?BinaryNode<T>
		internal count int

		def new() {}

		// Creates a tree holding values in level order.
		def new(values T[]) {
			for let (_, v) in values {
				insert(v)
			}
		}

		// Returns the number of nodes.
		def len() int {
			return count
		}

		// Reports whether the tree has no nodes.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every node.
		def clear() {
			root = none
			count = 0
		}

		// Returns the number of edges on the longest root-to-leaf path, or -1
		// for an empty tree.
		def height() int {
			let r = root
			return -1 when r is none
			return r.height()
		}

		// Adds value at the first free position in level order and returns
		// its node.
		def insert(value T) BinaryNode<T> {
			let node = new BinaryNode<T>(value)
			count += 1
			let r = root
			if r is none {
				root = node
				return node
			}
			let queue = new Queue<BinaryNode<T >> ()
			queue.push(r)
			for {
				let n = queue.pop()
				break when n is none
				let l = n.left
				if l is none {
					n.left = node
					return node
				}
				queue.push(l)
				let rt = n.right
				if rt is none {
					n.right = node
					return node
				}
				queue.push(rt)
			}
			return node
		}

		// Returns the first node holding value in level order, or none.
		def find(value T) ?BinaryNode<T> {
			let r = root
			return none when r is none
			let queue = new Queue<BinaryNode<T >> ()
			queue.push(r)
			for {
				let n = queue.pop()
				break when n is none
				return n when n.value == value
				let l = n.left
				queue.push(l) unless l is none
				let rt = n.right
				queue.push(rt) unless rt is none
			}
			return none
		}

		// Reports whether some node holds value.
		def contains(value T) bool {
			return !(find(value) is none)
		}

		// Returns the values in pre-order.
		def preorder() T[] {
			let out T[]
			let r = root
			r.preorder(out) unless r is none
			return out
		}

		// Returns the values in in-order.
		def inorder() T[] {
			let out T[]
			let r = root
			r.inorder(out) unless r is none
			return out
		}

		// Returns the values in post-order.
		def postorder() T[] {
			let out T[]
			let r = root
			r.postorder(out) unless r is none
			return out
		}

		// Returns the values level by level, left to right.
		def levelOrder() T[] {
			let out T[]
			let r = root
			return out when r is none
			let queue = new Queue<BinaryNode<T >> ()
			queue.push(r)
			for {
				let n = queue.pop()
				break when n is none
				out.push(n.value)
				let l = n.left
				queue.push(l) unless l is none
				let rt = n.right
				queue.push(rt) unless rt is none
			}
			return out
		}
	}
}
