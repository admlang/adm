partial module std.data.collections {
	use std.testing

	check "Tree" {
		@test()
		def TestGeneralTree() {
			let t = new Tree<string>()
			assert t.isEmpty()
			assert t.len() == 0
			assert t.height() == -1
			assert t.find("x") is none

			t = new Tree<string>("root")
			let r = t.root
			assert !(r is none)
			if !(r is none) {
				let a = r.add("a")
				let b = r.add("b")
				a.add("a1")
				a.add("a2")
				b.add("b1").add("b1x")
				assert r.size() == 7
				assert a.isLeaf() == false
				assert a.height() == 1
			}
			assert t.len() == 7
			assert t.height() == 3
			assert t.contains("b1x")
			assert !t.contains("zzz")
			assert t.preorder().equals(string["root", "a", "a1", "a2", "b", "b1", "b1x"])
			assert t.postorder().equals(string["a1", "a2", "a", "b1x", "b1", "b", "root"])
			assert t.levelOrder().equals(string["root", "a", "b", "a1", "a2", "b1", "b1x"])

			let found = t.find("b")
			assert !(found is none)
			if !(found is none) {
				assert found.remove("b1")
				assert !found.remove("b1")
				assert found.isLeaf()
			}
			assert t.len() == 5
			t.clear()
			assert t.isEmpty()
		}
	}

	check "BinaryTree" {
		@test()
		def TestLevelInsert() {
			let t = new BinaryTree<int>()
			assert t.isEmpty()
			assert t.height() == -1
			assert t.find(1) is none
			t = new BinaryTree<int>(int[1, 2, 3, 4, 5, 6])
			assert t.len() == 6
			assert t.height() == 2
			assert t.levelOrder().equals(int[1, 2, 3, 4, 5, 6])
			assert t.preorder().equals(int[1, 2, 4, 5, 3, 6])
			assert t.inorder().equals(int[4, 2, 5, 1, 6, 3])
			assert t.postorder().equals(int[4, 5, 2, 6, 3, 1])
			assert t.contains(6)
			assert !t.contains(7)
			let n = t.insert(7)
			assert n.isLeaf()
			assert t.height() == 2
			t.insert(8)
			assert t.height() == 3
			let found = t.find(2)
			assert !(found is none)
			if !(found is none) {
				assert found.size() == 4
				assert found.height() == 2
			}
			let r = t.root
			assert !(r is none)
			t.clear()
			assert t.isEmpty()
			assert t.root is none
		}
	}
}
