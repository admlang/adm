partial module std.data.collections {
	// Node of a Trie: one child per byte.
	internal type TrieNode {
		children map<int, TrieNode>
		terminal bool
		word     string

		def new() {}
	}

	// Trie is a set of strings stored as a prefix tree over their bytes.
	//
	// Membership and prefix tests cost O(len(word)). Iteration yields the
	// words in ascending byte order.
	type Trie {
		internal root     TrieNode
		internal count    int
		internal snapshot string[]
		internal cur      int

		def new() {
			root = new TrieNode()
		}

		// Creates a trie holding words.
		def new(words string[]) {
			root = new TrieNode()
			for let (_, w) in words {
				insert(w)
			}
		}

		// Returns the number of words.
		def len() int {
			return count
		}

		// Reports whether the trie holds no words.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every word.
		def clear() {
			root = new TrieNode()
			count = 0
		}

		// Adds word. Returns false when it was already present.
		def insert(word string) bool {
			let node = root
			for let (_, b) in word.bytes() {
				let key = int(b)
				let child = node.children.get(key)
				if child is none {
					let created = new TrieNode()
					node.children = node.children.set(key, created)
					node = created
				} else {
					node = child
				}
			}
			return false when node.terminal
			node.terminal = true
			node.word = word
			count += 1
			return true
		}

		// Reports whether word is present.
		def has(word string) bool {
			let node = nodeFor(word)
			return false when node is none
			return node.terminal
		}

		// Reports whether at least one word starts with prefix.
		def hasPrefix(prefix string) bool {
			return !(nodeFor(prefix) is none)
		}

		// Removes word, pruning branches no other word uses. Returns false
		// when it was absent.
		def remove(word string) bool {
			return false unless has(word)
			removeFrom(root, word.bytes(), 0)
			count -= 1
			return true
		}

		// Returns every word in ascending byte order.
		def words() string[] {
			return withPrefix("")
		}

		// Returns the words starting with prefix in ascending byte order.
		def withPrefix(prefix string) string[] {
			let out string[]
			let node = nodeFor(prefix)
			return out when node is none
			collect(node, out)
			return out
		}

		// Returns the longest word that is a prefix of text, or none.
		def longestPrefix(text string) ?string {
			let best ?string = none
			let node = root
			best = node.word when node.terminal
			for let (_, b) in text.bytes() {
				let child = node.children.get(int(b))
				break when child is none
				node = child
				best = node.word when node.terminal
			}
			return best
		}

		// Returns the next word in ascending byte order; none after the last,
		// which also resets the cursor. The words are captured when iteration
		// starts.
		def iterate() ?string {
			snapshot = words() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let w = snapshot[cur]
			cur += 1
			return w
		}

		internal def nodeFor(text string) ?TrieNode {
			let node = root
			for let (_, b) in text.bytes() {
				let child = node.children.get(int(b))
				return none when child is none
				node = child
			}
			return node
		}

		// Removes the word spelled by bytes[index:] below node and reports
		// whether node itself became removable.
		internal def removeFrom(node TrieNode, bytes byte[], index int) bool {
			if index == bytes.len() {
				node.terminal = false
				node.word = ""
				return node.children.len() == 0
			}
			let key = int(bytes[index])
			let child = node.children.get(key)
			return false when child is none
			if removeFrom(child, bytes, index + 1) {
				node.children = node.children.delete(key)
			}
			return !node.terminal && node.children.len() == 0
		}

		internal def collect(node TrieNode, out string[]) {
			out.push(node.word) when node.terminal
			let keys = node.children.keys()
			keys.sort((a int, b int) => a < b)
			for let (_, k) in keys {
				let child = node.children.get(k)
				continue when child is none
				collect(child, out)
			}
		}
	}

	// Node of a RadixTree: an edge label shared by every key below it.
	internal type RadixNode<V> {
		label    string
		children RadixNode<V>[]
		hasValue bool
		value    V

		def new(label string) {
			self.label = label
		}
	}

	// RadixTree is a string-keyed map stored as a compressed prefix tree:
	// chains of single-child nodes are merged into one edge, so lookups
	// cost O(len(key)) with far fewer nodes than a Trie.
	//
	// Keys are compared byte by byte. Iteration yields entries in ascending
	// key order.
	type RadixTree<V> {
		internal root     RadixNode<V>
		internal count    int
		internal snapshot Entry<string, V>[]
		internal cur      int

		def new() {
			root = new RadixNode<V>("")
		}

		// Returns the number of entries.
		def len() int {
			return count
		}

		// Reports whether the tree holds no entries.
		def isEmpty() bool {
			return count == 0
		}

		// Removes every entry.
		def clear() {
			root = new RadixNode<V>("")
			count = 0
		}

		// Associates value with key, replacing any existing value.
		def set(key string, value V) {
			let node = root
			let rest = key
			for {
				if rest.len() == 0 {
					count += 1 unless node.hasValue
					node.hasValue = true
					node.value = value
					return
				}
				let idx = childIndex(node, rest)
				if idx < 0 {
					let leaf = new RadixNode<V>(rest)
					leaf.hasValue = true
					leaf.value = value
					insertChild(node, leaf)
					count += 1
					return
				}
				let child = node.children[idx]
				let shared = commonPrefix(child.label, rest)
				if shared < child.label.len() {
					// Split the edge at the shared prefix.
					let middle = new RadixNode<V>(child.label.slice(0, shared))
					child.label = child.label.slice(shared)
					middle.children.push(child)
					node.children[idx] = middle
					child = middle
				}
				rest = rest.slice(shared)
				node = child
			}
		}

		// Returns the value for key, or none when absent.
		def get(key string) ?V {
			let node = nodeFor(key)
			return none when node is none
			return none unless node.hasValue
			return node.value
		}

		// Returns the value for key, or fallback when absent.
		def get(key string, fallback V) V {
			let v = get(key)
			return fallback when v is none
			return v
		}

		// Reports whether key is present.
		def has(key string) bool {
			let node = nodeFor(key)
			return false when node is none
			return node.hasValue
		}

		// Reports whether at least one key starts with prefix.
		def hasPrefix(prefix string) bool {
			return !(prefixNode(prefix) is none)
		}

		// Removes key, merging edges that no longer branch. Returns false
		// when it was absent.
		def delete(key string) bool {
			return false unless has(key)
			deleteFrom(root, key)
			count -= 1
			return true
		}

		// Returns the keys in ascending byte order.
		def keys() string[] {
			let out string[]
			for let (_, e) in entries() {
				out.push(e.key)
			}
			return out
		}

		// Returns the entries in ascending key order.
		def entries() Entry<string, V>[] {
			let out Entry<string, V>[]
			collect(root, "", out)
			return out
		}

		// Returns the keys starting with prefix in ascending byte order.
		def withPrefix(prefix string) string[] {
			let out string[]
			let node = root
			let path = ""
			let rest = prefix
			for rest.len() > 0 {
				let idx = childIndex(node, rest)
				return out when idx < 0
				let child = node.children[idx]
				if child.label.startsWith(rest) {
					rest = ""
				} else {
					return out unless rest.startsWith(child.label)
					rest = rest.slice(child.label.len())
				}
				path += child.label
				node = child
			}
			let found Entry<string, V>[]
			collect(node, path, found)
			for let (_, e) in found {
				out.push(e.key)
			}
			return out
		}

		// Returns the longest stored key that is a prefix of text, or none.
		def longestPrefix(text string) ?string {
			let best ?string = none
			let node = root
			let consumed = ""
			let rest = text
			best = consumed when node.hasValue
			for {
				let idx = childIndex(node, rest)
				break when idx < 0
				let child = node.children[idx]
				break unless rest.startsWith(child.label)
				consumed += child.label
				rest = rest.slice(child.label.len())
				node = child
				best = consumed when node.hasValue
			}
			return best
		}

		// Returns the next entry in key order; none after the last, which
		// also resets the cursor. The entries are captured when iteration
		// starts.
		def iterate() ?Entry<string, V> {
			snapshot = entries() when cur == 0
			if cur >= snapshot.len() {
				cur = 0
				snapshot.flush()
				return none
			}
			let e = snapshot[cur]
			cur += 1
			return e
		}

		// Returns the index of the child whose label starts with the first
		// byte of text, or -1.
		internal def childIndex(node RadixNode<V>, text string) int {
			return -1 when text.len() == 0
			let first = text.bytes()[0]
			for let i = 0; i < node.children.len(); i++ {
				let label = node.children[i].label
				return i when label.len() > 0 && label.bytes()[0] == first
			}
			return -1
		}

		// Returns the number of leading bytes a and b share.
		internal def commonPrefix(a string, b string) int {
			let ab = a.bytes()
			let bb = b.bytes()
			let n = ab.len().min(bb.len())
			let i = 0
			for i < n && ab[i] == bb[i] {
				i += 1
			}
			return i
		}

		// Inserts child keeping children sorted by label.
		internal def insertChild(node RadixNode<V>, child RadixNode<V>) {
			node.children.push(child)
			for let i = node.children.len() - 1; i > 0; i-- {
				break unless child.label < node.children[i - 1].label
				node.children[i] = node.children[i - 1]
				node.children[i - 1] = child
			}
		}

		// Returns the node whose path spells key exactly, or none.
		internal def nodeFor(key string) ?RadixNode<V> {
			let node = root
			let rest = key
			for rest.len() > 0 {
				let idx = childIndex(node, rest)
				return none when idx < 0
				let child = node.children[idx]
				return none unless rest.startsWith(child.label)
				rest = rest.slice(child.label.len())
				node = child
			}
			return node
		}

		// Returns the shallowest node whose path covers prefix, or none.
		internal def prefixNode(prefix string) ?RadixNode<V> {
			let node = root
			let rest = prefix
			for rest.len() > 0 {
				let idx = childIndex(node, rest)
				return none when idx < 0
				let child = node.children[idx]
				if child.label.startsWith(rest) {
					return child
				}
				return none unless rest.startsWith(child.label)
				rest = rest.slice(child.label.len())
				node = child
			}
			return node
		}

		// Deletes key below node; the caller guarantees it is present.
		internal def deleteFrom(node RadixNode<V>, rest string) {
			if rest.len() == 0 {
				node.hasValue = false
				return
			}
			let idx = childIndex(node, rest)
			return when idx < 0
			let child = node.children[idx]
			deleteFrom(child, rest.slice(child.label.len()))
			if !child.hasValue && child.children.len() == 0 {
				node.children.remove(idx)
			} else if !child.hasValue && child.children.len() == 1 {
				let only = child.children[0]
				only.label = child.label + only.label
				node.children[idx] = only
			}
		}

		internal def collect(node RadixNode<V>, path string, out Entry<string, V>[]) {
			out.push(new Entry<string, V>(path, node.value)) when node.hasValue
			for let (_, c) in node.children {
				collect(c, path + c.label, out)
			}
		}
	}
}
