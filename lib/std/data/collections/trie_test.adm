partial module std.data.collections {
	use std.testing

	check "Trie" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestWords() {
			let t = new Trie(string["car", "cart", "cat", "dog"])
			assert t.len() == 4
			assert !t.insert("cat")
			assert t.insert("")
			assert t.len() == 5
			assert t.has("car")
			assert t.has("")
			assert !t.has("ca")
			assert t.hasPrefix("ca")
			assert t.hasPrefix("cart")
			assert !t.hasPrefix("x")
			assert t.words().equals(string["", "car", "cart", "cat", "dog"])
			assert t.withPrefix("car").equals(string["car", "cart"])
			assert t.withPrefix("z").len() == 0
			assert eq(t.longestPrefix("carts"), "cart")
			assert eq(t.longestPrefix("ca"), "")
			let u = new Trie()
			assert u.longestPrefix("x") is none
		}

		@test()
		def TestRemove() {
			let t = new Trie(string["car", "cart", "cat"])
			assert t.remove("cart")
			assert !t.remove("cart")
			assert !t.has("cart")
			assert t.has("car")
			assert !t.hasPrefix("cart")
			assert t.remove("car")
			assert t.hasPrefix("ca")
			assert t.words().equals(string["cat"])
			assert t.remove("cat")
			assert t.isEmpty()
			assert !t.hasPrefix("c")
			t.insert("b")
			t.insert("a")
			let seen string[]
			for let w in t {
				seen.push(w)
			}
			assert seen.equals(string["a", "b"])
			t.clear()
			assert t.isEmpty()
			assert t.words().len() == 0
		}
	}

	check "RadixTree" {
		def eq<T>(got ?T, want T) bool {
			return false when got is none
			return got == want
		}

		@test()
		def TestSetGet() {
			let t = new RadixTree<int>()
			assert t.isEmpty()
			assert t.get("a") is none
			t.set("romane", 1)
			t.set("romanus", 2)
			t.set("romulus", 3)
			t.set("rubens", 4)
			t.set("ruber", 5)
			t.set("rubicon", 6)
			t.set("rubicundus", 7)
			assert t.len() == 7
			t.set("ruber", 50)
			assert t.len() == 7
			assert eq(t.get("ruber"), 50)
			assert eq(t.get("romane"), 1)
			assert eq(t.get("rubicundus"), 7)
			assert t.get("rom") is none
			assert t.get("rom", -1) == -1
			assert t.has("romulus")
			assert !t.has("roman")
			assert t.hasPrefix("rom")
			assert t.hasPrefix("rubic")
			assert !t.hasPrefix("x")
			assert t.keys().equals(string["romane", "romanus", "romulus", "rubens", "ruber", "rubicon", "rubicundus"])
			assert t.withPrefix("rubi").equals(string["rubicon", "rubicundus"])
			assert t.withPrefix("rom").equals(string["romane", "romanus", "romulus"])
			assert t.withPrefix("zzz").len() == 0
			assert eq(t.longestPrefix("rubicundusx"), "rubicundus")
			assert eq(t.longestPrefix("rubensburg"), "rubens")
			assert t.longestPrefix("ru") is none
		}

		@test()
		def TestDeleteMerges() {
			let t = new RadixTree<string>()
			t.set("test", "a")
			t.set("team", "b")
			t.set("toast", "c")
			t.set("", "root")
			assert t.len() == 4
			assert eq(t.get(""), "root")
			assert t.delete("team")
			assert !t.delete("team")
			assert t.has("test")
			assert t.keys().equals(string["", "test", "toast"])
			assert t.delete("test")
			assert t.keys().equals(string["", "toast"])
			assert eq(t.get("toast"), "c")
			assert t.delete("")
			assert t.delete("toast")
			assert t.isEmpty()
			assert !t.hasPrefix("t")

			t.set("ab", "1")
			t.set("abc", "2")
			t.set("abd", "3")
			let seen string[]
			for let e in t {
				seen.push(e.key + "=" + e.value)
			}
			assert seen.equals(string["ab=1", "abc=2", "abd=3"])
			t.clear()
			assert t.isEmpty()
		}
	}
}
