partial module std.data.compress.brotli {
	use (
		std.bytes
		std.testing
	)

	check "Brotli decoder" {
		// Streams below were produced by the reference encoder.
		let text = "The quick brown fox jumps over the lazy dog. In the beginning of the program, the International Organization for Standardization published a standard that describes how information is exchanged between computers. This is the first time that the committee has published such a document, and the reactions were very positive."

		// Deterministic noise: the high bytes of a linear congruential sequence.
		def noise(n int) byte[] {
			let out byte[]
			out.len(n)
			let s = 12345
			for let i = 0; i < n; i++ {
				s = (s * 1103515245 + 12345) & 0x7FFFFFFF
				out[i] = byte((s >> 16) & 0xFF)
			}
			return out
		}

		// Reads a stream through a Reader in `chunk`-sized reads.
		def readAll(data byte[], chunk int) !byte[] {
			let r = new Reader(new bytes.Reader(data))
			let out byte[]
			let buf byte[]
			buf.len(chunk)
			for {
				let n = try r.read(buf)
				break when n == 0
				out = out + buf[0:n]
			}
			return out
		}

		@test()
		def decodesAnEmptyStream() !none {
			let out = try decompress(byte[59])
			assert out.len() == 0 // an empty stream decodes to nothing
		}

		// Quality 11 in text mode leans on static dictionary words and their
		// transforms.
		@test()
		def decodesDictionaryWords() !none {
			let packed = byte[
			27, 66, 1, 0, 28, 9, 54, 46, 114, 187, 6, 79, 84, 73, 84, 160, 131, 35, 29, 208, 149, 170, 78,
			73, 80, 21, 246, 6, 229, 182, 144, 179, 47, 222, 131, 96, 94, 215, 84, 220, 82, 178, 116, 117,
			155, 248, 118, 247, 152, 140, 152, 148, 49, 233, 116, 226, 179, 167, 69, 187, 62, 113, 196,
			226, 133, 134, 85, 191, 137, 45, 12, 146, 99, 53, 53, 129, 38, 173, 17, 74, 143, 152, 183, 140,
			33, 178, 164, 185, 200, 254, 245, 163, 101, 121, 34, 89, 113, 30, 227, 95, 217, 106, 163, 120,
			117, 43, 51, 215, 134, 93, 163, 74, 158, 17, 192, 174, 61, 99, 162, 23, 0, 74, 55, 65, 122, 10
			]
			let out = try decompress(packed)
			assert string(out) == text // dictionary references and transforms rebuild the text
		}

		@test()
		def decodesBackReferences() !none {
			let packed = byte[
			27, 200, 3, 0, 4, 162, 220, 76, 217, 29, 207, 96, 60, 250, 95, 152, 148, 163, 180, 75, 58, 96,
			182, 3, 246, 253, 170, 187, 226, 128, 118, 55, 43, 192, 221, 116, 202, 99, 25, 96, 0, 146, 206,
			109, 132, 100, 33, 248, 31, 129, 230, 80, 249, 175, 2, 230, 91, 108, 210, 126, 51, 235, 195,
			94, 175, 144, 209, 38, 233, 15, 140, 233, 105, 190, 23, 175, 203, 200, 116, 59, 1, 127, 238,
			237, 94, 232, 104, 141, 205, 26, 28, 119, 186, 139, 164, 248, 5, 176, 144, 215, 230, 87, 204,
			237, 77, 242, 203, 141, 61, 83, 143, 129, 86, 100, 96, 47, 37, 94, 49, 109, 86, 50, 171, 118,
			40, 43, 91, 70, 201, 246, 28, 136, 197, 233, 21, 106, 145, 84, 74, 254, 25, 177, 80, 57, 209,
			202, 59, 147, 213, 157, 94, 215, 86, 138, 8, 171, 201, 44, 250, 68, 62, 193, 171, 107, 8, 174,
			102, 70, 161, 231, 116, 73, 66, 147, 244, 18, 244, 110, 209, 7, 210, 100, 12, 35
			]
			let out = try decompress(packed)
			assert string(out) == text + text + text // repeats come back through distances
		}

		// Incompressible input is stored in uncompressed meta-blocks.
		@test()
		def decodesUncompressedMetaBlocks() !none {
			let packed = byte[
			139, 149, 128, 220, 4, 101, 170, 31, 173, 29, 90, 218, 229, 172, 27, 30, 95, 19, 112, 121, 108,
			253, 16, 255, 25, 175, 96, 29, 4, 172, 180, 29, 2, 43, 70, 120, 115, 58, 242, 223, 95, 174,
			183, 8, 89, 209, 238, 57, 16, 203, 72, 149, 181, 204, 137, 41, 17, 255, 6, 182, 98, 46, 223,
			60, 249, 53, 253, 75, 148, 40, 202, 9, 124, 68, 179, 2, 94, 150, 95, 179, 234, 109, 172, 212,
			45, 129, 110, 105, 175, 224, 230, 135, 76, 156, 4, 231, 210, 54, 93, 44, 96, 201, 234, 244,
			121, 246, 134, 160, 235, 147, 38, 228, 98, 18, 213, 13, 203, 179, 119, 21, 106, 106, 58, 104,
			186, 142, 219, 116, 8, 70, 158, 243, 206, 179, 10, 248, 208, 221, 104, 187, 248, 95, 250, 36,
			242, 210, 252, 24, 135, 251, 92, 135, 186, 180, 56, 50, 165, 155, 27, 61, 16, 124, 247, 120,
			214, 127, 226, 109, 248, 17, 145, 41, 126, 147, 149, 203, 18, 197, 87, 206, 90, 241, 212, 22,
			24, 215, 25, 188, 4, 91, 126, 153, 101, 241, 162, 148, 113, 196, 42, 172, 106, 169, 56, 196,
			117, 199, 173, 50, 56, 2, 31, 5, 59, 44, 153, 26, 252, 235, 21, 222, 207, 104, 186, 224, 124,
			188, 214, 30, 151, 27, 154, 11, 157, 190, 151, 99, 211, 146, 252, 175, 223, 162, 140, 151, 35,
			69, 98, 235, 221, 7, 101, 112, 255, 88, 137, 106, 207, 247, 202, 238, 63, 28, 233, 228, 10,
			104, 229, 222, 147, 141, 56, 156, 125, 189, 215, 91, 9, 212, 231, 226, 51, 68, 63, 74, 140,
			196, 161, 144, 214, 184, 184, 220, 97, 95, 209, 142, 40, 190, 89, 14, 170, 80, 27, 3
			]
			let out = try decompress(packed)
			assert out.equals(noise(300)) // raw bytes pass through unchanged
		}

		// A 1 KiB window is smaller than the output, so the ring buffer wraps
		// many times, and small reads drain it piecemeal.
		@test()
		def wrapsASmallWindow() !none {
			let packed = byte[
			161, 216, 70, 1, 32, 135, 114, 21, 168, 57, 72, 29, 216, 209, 89, 40, 123, 22, 74, 235, 5, 152,
			237, 128, 125, 191, 234, 174, 56, 160, 221, 205, 10, 112, 55, 157, 242, 88, 6, 152, 177, 229,
			116, 155, 33, 89, 30, 4, 148, 191, 185, 171, 120, 147, 16, 96, 190, 133, 200, 88, 156, 196, 0,
			2, 78, 6, 74, 2, 157, 25, 7, 56, 17, 197, 254, 129, 49, 165, 69, 164, 166, 64, 52, 38, 26, 130,
			27, 35, 8, 248, 195, 32, 51, 136, 80, 209, 26, 155, 165, 31, 184, 110, 140, 120, 20, 187, 127,
			1, 176, 224, 107, 227, 21, 31, 193, 136, 142, 136, 141, 158, 174, 237, 153, 70, 67, 4, 208,
			138, 208, 176, 151, 140, 87, 140, 37, 71, 162, 56, 32, 225, 36, 160, 172, 64, 142, 3, 37, 59,
			26, 14, 196, 66, 20, 166, 51, 19, 226, 81, 108, 42, 249, 103, 196, 66, 229, 4, 173, 188, 50,
			141, 122, 20, 166, 211, 201, 241, 241, 8, 1, 41, 34, 142, 69, 239, 200, 39, 16, 141, 163, 10,
			130, 203, 153, 145, 232, 57, 36, 161, 88, 4, 137, 40, 54, 5, 152, 248, 110, 209, 79, 44, 122,
			0, 36, 34, 195, 59, 28, 104, 84, 121, 66, 49, 240, 214, 211, 113, 121, 165, 48, 113, 102, 10,
			237, 175, 200, 127, 217, 169, 112, 69, 142, 241, 121, 69, 54, 61, 231, 228, 56, 219, 79, 247,
			195, 38, 151, 120, 2, 78, 223, 217, 136, 236, 187, 54, 44, 28, 148, 232, 136, 254, 231, 90,
			140, 52, 188, 111, 255, 211, 226, 175, 71, 189, 246, 30, 111, 186, 227, 28, 91, 104, 99, 216,
			220, 43, 250, 248, 133, 65, 14, 131, 60, 245, 224, 89, 145, 103, 59, 199, 243, 51, 203, 16,
			253, 240, 221, 87, 95, 82, 190, 21, 118, 191, 174, 211, 124, 18, 41, 118, 41, 184, 63, 151, 36,
			73, 161, 216, 146, 86, 43, 111, 199, 243, 56, 119, 126, 62, 154, 227, 251, 113, 114, 151, 180,
			246, 35, 236, 151, 250, 167, 179, 63, 50, 69, 191, 131, 139, 86, 231, 173, 77, 7, 218, 228, 29,
			68, 210, 191, 39, 95, 101, 61, 162, 255, 16, 173, 209, 201, 172, 107, 216, 23, 219, 244, 59,
			10, 252, 120, 33, 37, 115, 45, 187, 206, 17, 148, 217, 130, 62, 246, 214, 199, 108, 232, 142,
			83, 70, 172, 237, 0
			]
			let unit = text.bytes() + noise(200)
			let want byte[]
			for let i = 0; i < 20; i++ {
				want = want + unit
			}
			assert (try readAll(packed, 7)).equals(want) // small reads see the same bytes
			assert (try decompress(packed, want.len())).equals(want) // a size hint does not change the result
		}

		// One Reader decodes several streams in turn.
		@test()
		def resetsForAnotherStream() !none {
			let packed = byte[11, 1, 128, 97, 98, 99, 3]
			let r = new Reader(new bytes.Reader(byte[]))
			for let round = 0; round < 2; round++ {
				r.reset(new bytes.Reader(packed))
				let buf byte[]
				buf.len(64)
				let n = try r.read(buf)
				assert n == 3 && string(buf[0:n]) == "abc" // the new stream decodes from its start
				assert (try r.read(buf)) == 0 // and ends
			}
			try r.close()
		}

		@test()
		def rejectsCorruptData() !none {
			let packed = byte[
			27, 66, 1, 0, 28, 9, 54, 46, 114, 187, 6, 79, 84, 73, 84, 160, 131, 35, 29, 208, 149, 170, 78,
			73, 80, 21, 246, 6, 229, 182, 144, 179, 47, 222, 131, 96, 94, 215, 84, 220, 82, 178, 116, 117,
			155, 248, 118, 247, 152, 140, 152, 148, 49, 233, 116, 226, 179, 167, 69, 187, 62, 113, 196,
			226, 133, 134, 85, 191, 137, 45, 12, 146, 99, 53, 53, 129, 38, 173, 17, 74, 143, 152, 183, 140,
			33, 178, 164, 185, 200, 254, 245, 163, 101, 121, 34, 89, 113, 30, 227, 95, 217, 106, 163, 120,
			117, 43, 51, 215, 134, 93, 163, 74, 158, 17, 192, 174, 61, 99, 162, 23, 0, 74, 55, 65, 122, 10
			]
			assert decompress(packed[0:packed.len() / 2]) is error // a truncated stream fails
			assert decompress(byte[0xFF, 0xFF, 0xFF, 0xFF]) is error // garbage fails
		}
	}
}
