// Brotli (RFC 7932) decompression.

partial module std.data.compress.brotli {
	use (
		std.io
		std.bytes
		std.data.compress.brotli.decoder::*
	)

	// Reader decompresses a Brotli stream read from an io.Reader.
	//
	// Output is produced as it is read: the decoder keeps only the stream's
	// sliding window, at most 16 MiB and less for streams that declare a
	// smaller one.
	type Reader {
		internal dec      Decoder
		internal consumed int

		def new(r io.Reader) {
			dec = new Decoder(r)
		}

		// reset starts reading a new Brotli stream from r.
		def reset(r io.Reader) {
			dec = new Decoder(r)
			consumed = 0
		}

		// read decompresses into p and returns how many bytes it produced, 0 at the
		// end of the stream. Fails when the stream is corrupt or truncated, or the
		// underlying reader does.
		def read(p byte[]) !int {
			return 0 when p.len() == 0
			if consumed == dec.pos {
				return 0 when dec.done()
				try dec.produce(consumed)
				return 0 when consumed == dec.pos
			}

			let size = dec.window.len()
			let start = consumed & (size - 1)
			let n = dec.pos - consumed
			n = size - start when size - start < n
			n = p.len() when p.len() < n
			dec.window[start:start + n].copy(p)
			consumed += n
			return n
		}

		// close releases the decoder; it does not close the underlying reader. It
		// cannot fail.
		def close() !none {
			return none
		}
	}

	// Decompresses a whole Brotli stream held in memory. `sizeHint` presizes the
	// result when the caller knows the decompressed length.
	// Fails when the data is not a valid Brotli stream.
	def decompress(src byte[], sizeHint int = 0) !byte[] {
		let r = new Reader(new bytes.Reader(src))
		let out byte[]
		out.len(sizeHint > 0 ?? (sizeHint, 4096))
		let off = 0
		for {
			out.len(out.len() * 2) when off == out.len()
			let n = try r.read(out[off:])
			break when n <= 0
			off += n
		}
		out.len(off)
		return out
	}
}
