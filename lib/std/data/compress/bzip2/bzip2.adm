partial module std.data.compress.bzip2 {
	use (
		std.io
		std.data.compress.bzip2.block::*
	)

	// Reader decompresses bzip2 data read from an io.Reader. Concatenated
	// streams are read as one, and every block and stream checksum is
	// verified.
	type Reader {
		internal d BlockDecoder

		def new(r io.Reader) {
			d = new BlockDecoder(r)
		}

		// reset starts reading new bzip2 data from r.
		def reset(r io.Reader) {
			d.reset(r)
		}

		// read decompresses into p and returns how many bytes it produced, 0 at
		// the end. Fails when the data is not bzip2, is corrupt or truncated, a
		// checksum does not match, or the underlying reader fails.
		def read(p byte[]) !int {
			return 0 when p.len() == 0
			return try d.read(p)
		}

		// close releases the decompressor; it does not close the underlying
		// reader. Fails when the data ended inside a stream.
		def close() !none {
			fail "bzip2: stream ended unfinished" when d.started && !d.done && !d.streamDone
			return none
		}
	}

	// Level is the block size the compressor works in, in units of 100 kB:
	// BestSpeed uses 100 kB blocks, BestCompression 900 kB. Any value from 1
	// to 9, `Level(5)`, picks the block size in between.
	enum Level {
		BestSpeed = 1,
		BestCompression = 9,
	}

	// Writer compresses what is written to it into a bzip2 stream on an
	// io.Writer; `close` writes the end of the stream.
	type Writer {
		internal w      io.Writer
		internal e      BlockEncoder
		internal closed bool

		def new(w io.Writer, level Level = Level.BestCompression) {
			self.w = w
			let l = int(level)
			l = 9 when l < 1 || l > 9
			e = new BlockEncoder(l)
		}

		// reset starts a new stream on w at the same level.
		def reset(w io.Writer) {
			self.w = w
			e.reset()
			closed = false
		}

		// write compresses p and returns how many bytes were taken. Fails when
		// the writer is closed or the underlying writer fails.
		def write(p byte[]) !int {
			fail "bzip2: write to a closed writer" when closed
			e.write(p)
			try e.bw.drain(w)
			return p.len()
		}

		// flush ends the current block and writes every whole byte compressed
		// so far to the underlying writer. Fails when it does.
		def flush() !none {
			return none when closed
			e.header()
			e.flush()
			try e.bw.drain(w)
		}

		// close ends the stream and writes its trailer; closing again does
		// nothing. It does not close the underlying writer. Fails when that
		// writer does.
		def close() !none {
			return none when closed
			closed = true
			e.end()
			try e.bw.drain(w)
		}
	}
}
