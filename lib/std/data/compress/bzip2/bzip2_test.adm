partial module std.data.compress.bzip2 {
	check "Bzip2" {
		use (
			std.testing
			std.bytes
		)

		// "hello " twenty times, compressed by the system bzip2.
		def helloStream() byte[] {
			return byte[
			0x42, 0x5a, 0x68, 0x39, 0x31, 0x41, 0x59, 0x26, 0x53, 0x59, 0x67, 0x26, 0xf7, 0x31, 0x00, 0x00,
			0x1d, 0x91, 0x00, 0x40, 0x00, 0x02, 0x44, 0xa0, 0x00, 0x30, 0xcd, 0x00, 0x52, 0xa3, 0x1a, 0x4c,
			0x27, 0xc9, 0x84, 0xd1, 0x38, 0x5d, 0xc9, 0x14, 0xe1, 0x42, 0x41, 0x9c, 0x9b, 0xdc, 0xc4,
			]
		}

		// 1000 'x', "abc" 100 times and every byte value once, compressed by
		// the system bzip2 at level 1.
		def runsStream() byte[] {
			return byte[
			0x42, 0x5a, 0x68, 0x31, 0x31, 0x41, 0x59, 0x26, 0x53, 0x59, 0xf5, 0x57, 0xde, 0x8f, 0x00, 0x00,
			0xd3, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
			0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
			0xff, 0xff, 0xff, 0xb0, 0x00, 0xc9, 0x08, 0x00, 0x00, 0x06, 0x80, 0x02, 0x60, 0x00, 0x04, 0xc0,
			0x02, 0x64, 0xc0, 0x00, 0x00, 0x04, 0x60, 0x13, 0x00, 0x00, 0x00, 0x03, 0x40, 0x00, 0x00, 0x00,
			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x30, 0x00, 0xa5, 0x40, 0x4c, 0x02,
			0x64, 0xc0, 0x4c, 0x09, 0xa6, 0x00, 0x00, 0x26, 0x26, 0x00, 0x98, 0x98, 0x13, 0x4c, 0x00, 0x00,
			0x00, 0x23, 0x00, 0x98, 0x00, 0x26, 0x02, 0x69, 0x80, 0x00, 0x09, 0x80, 0x04, 0xd1, 0x84, 0xc0,
			0x00, 0x00, 0x00, 0x43, 0x4c, 0x11, 0x82, 0x34, 0xc0, 0x00, 0x09, 0x30, 0x00, 0x4c, 0x00, 0x04,
			0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x06, 0x10, 0x60, 0x70,
			0x80, 0x90, 0xa0, 0xb0, 0xc0, 0xd0, 0xe0, 0xf1, 0x01, 0x11, 0x21, 0x31, 0x41, 0x51, 0x61, 0x71,
			0x80, 0x03, 0x23, 0x43, 0x63, 0x83, 0xa3, 0xc3, 0xe4, 0x04, 0x24, 0x44, 0x64, 0x9f, 0x82, 0x52,
			0x62, 0x72, 0x82, 0x92, 0xa2, 0xb2, 0xc2, 0xd2, 0xe2, 0xf3, 0x03, 0x13, 0x23, 0x33, 0x43, 0xb3,
			0xc3, 0xd3, 0xe3, 0xf4, 0x0f, 0x32, 0x0a, 0x12, 0x1f, 0x9d, 0x11, 0x15, 0x19, 0x1d, 0x21, 0x25,
			0x29, 0x2d, 0x33, 0xd0, 0x9a, 0x9c, 0x9f, 0xe9, 0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0xf5, 0x2b,
			0x7a, 0xd5, 0xd6, 0x16, 0x56, 0x96, 0xd7, 0x17, 0x57, 0x97, 0xd8, 0x18, 0x58, 0x98, 0xd8, 0xc2,
			0x10, 0x00, 0x01, 0xd9, 0x65, 0x66, 0x08, 0x02, 0x00, 0x05, 0x9c, 0x20, 0x08, 0x00, 0x11, 0x36,
			0x86, 0x96, 0xa6, 0xb6, 0xc6, 0xd6, 0xe6, 0xf7, 0x07, 0x17, 0x2f, 0x67, 0xb5, 0xcd, 0xd1, 0xd5,
			0xd9, 0xdd, 0xe3, 0xa8, 0x3d, 0xcf, 0x60, 0x00, 0x1e, 0xc4, 0x02, 0x08, 0xf2, 0xf4, 0xf6, 0xf8,
			0xfa, 0xfc, 0xff, 0x01, 0x03, 0x05, 0x07, 0x09, 0x0a, 0x06, 0x1a, 0x1e, 0x22, 0x26, 0x2a, 0x2e,
			0x32, 0x36, 0x3a, 0x3e, 0x42, 0x46, 0x4a, 0x4e, 0x52, 0x56, 0x5a, 0x5e, 0x62, 0x66, 0x6a, 0x6e,
			0x72, 0x76, 0x7a, 0x7e, 0x82, 0x86, 0x8a, 0x8e, 0x92, 0x96, 0x9a, 0x9e, 0xa2, 0xa6, 0xaa, 0xae,
			0xb2, 0xb6, 0xba, 0xbe, 0xc2, 0xc6, 0xca, 0xce, 0xd2, 0xd6, 0xda, 0xde, 0xe2, 0xe6, 0xea, 0xee,
			0xf2, 0xf6, 0xfa, 0xff, 0x03, 0x07, 0x0b, 0x0f, 0x13, 0x17, 0x1b, 0x1f, 0x23, 0x27, 0x2b, 0x2f,
			0x33, 0x37, 0x3b, 0x3f, 0x43, 0x47, 0x4b, 0x4f, 0x53, 0x57, 0x5b, 0x5f, 0x63, 0x67, 0x6b, 0x6f,
			0x73, 0x77, 0x7b, 0x7f, 0x83, 0x87, 0x8b, 0x8f, 0x91, 0xab, 0x94, 0x0f, 0x37, 0x3f, 0x47, 0x4f,
			0x57, 0x5f, 0x67, 0x6f, 0x77, 0x7f, 0x87, 0x8f, 0xff, 0xcb, 0xcf, 0xd3, 0xd7, 0xd8, 0x00, 0x2f,
			0xbc, 0x17, 0xc7, 0xcf, 0xd7, 0xd8, 0xbb, 0x92, 0x29, 0xc2, 0x84, 0x87, 0xaa, 0xbe, 0xf4, 0x78,
			]
		}

		def runsText() byte[] {
			let out byte[] = []
			for let i = 0; i < 1000; i++ {
				out.push(0x78)
			}
			for let i = 0; i < 100; i++ {
				out.push(0x61, 0x62, 0x63)
			}
			for let i = 0; i < 256; i++ {
				out.push(byte(i))
			}
			return out
		}

		def decode(data byte[]) !byte[] {
			let out = new bytes.Buffer()
			try out.readFrom(new Reader(new bytes.Reader(data)))
			return out.bytes()
		}

		def encode(data byte[], level Level) !byte[] {
			let out = new bytes.Buffer()
			let w = new Writer(out, level)
			try w.write(data)
			try w.close()
			return out.bytes()
		}

		def fails(data byte[]) bool {
			let failed = false
			decode(data) onerror (e error) {
				failed = true
				recover []
			}
			return failed
		}

		// Deterministic bytes with some structure, so blocks are neither
		// trivial nor incompressible.
		def sample(size int) byte[] {
			let out byte[] = []
			out.len(size)
			let x = uint32(12345)
			for let i = 0; i < size; i++ {
				x = x * 1103515245 + 12345
				let r = int(x >> 16)
				out[i] = (r % 7 == 0) ?? (byte(r), byte(0x61 + (i / 3) % 20))
			}
			return out
		}

		@test()
		def readsSystemStreams() !none {
			assert string(try decode(helloStream())) == "hello ".repeat(20)
			assert (try decode(runsStream())).equals(runsText())
		}

		@test()
		def readsConcatenatedStreams() !none {
			let both = helloStream() + runsStream() + helloStream()
			let expected = "hello ".repeat(20).bytes() + runsText() + "hello ".repeat(20).bytes()
			assert (try decode(both)).equals(expected)
		}

		@test()
		def rejectsCorruptData() !none {
			let bad = helloStream().clone()
			// A flipped bit in the block CRC.
			bad[14] = bad[14] ^ 0x01
			assert fails(bad)
			let data = helloStream()
			assert fails(data[0:data.len() - 6])
			assert fails("not bzip2 at all".bytes())
		}

		@test()
		def roundTrips() !none {
			for let level in [Level.BestSpeed, Level(5), Level.BestCompression] {
				assert (try decode(try encode([], level))).len() == 0
				assert (try decode(try encode(runsText(), level))).equals(runsText())
				let text = "hello ".repeat(20).bytes()
				assert (try decode(try encode(text, level))).equals(text)
			}
		}

		@test()
		def roundTripsSeveralBlocks() !none {
			let data = sample(250000)
			let packed = try encode(data, Level.BestSpeed)
			assert packed.len() < data.len()
			assert (try decode(packed)).equals(data)
		}

		@test()
		def writesTheLevelInTheHeader() !none {
			let packed = try encode("abc".bytes(), Level.BestSpeed)
			assert string(packed[0:4]) == "BZh1"
			packed = try encode("abc".bytes(), Level.BestCompression)
			assert string(packed[0:4]) == "BZh9"
		}

		@test()
		def flushesAndResets() !none {
			let first = new bytes.Buffer()
			let w = new Writer(first, Level.BestSpeed)
			try w.write("hello ".bytes())
			try w.flush()
			try w.write("world".bytes())
			try w.close()
			assert string(try decode(first.bytes())) == "hello world"
			let second = new bytes.Buffer()
			w.reset(second)
			try w.write("again".bytes())
			try w.close()
			assert string(try decode(second.bytes())) == "again"
			let r = new Reader(new bytes.Reader(first.bytes()))
			let out = new bytes.Buffer()
			try out.readFrom(r)
			r.reset(new bytes.Reader(second.bytes()))
			try out.readFrom(r)
			assert string(out.bytes()) == "hello worldagain"
		}
	}
}
