internal partial module std.data.compress.bzip2.block {
	use std.io

	const tableBits = 10

	// HuffmanTable decodes one bzip2 coding table: codes of up to 10 bits
	// through a direct lookup, longer ones through the canonical limits.
	type HuffmanTable {
		// Entries are symbol << 5 | length; length 0 marks a longer code.
		lookup uint32[]
		limit  int[]
		base   int[]
		perm   int[]
		maxLen int
		minLen int

		def new() {
			lookup.len(1 << tableBits)
			limit.len(maxCodeLen + 2)
			base.len(maxCodeLen + 2)
			perm.len(maxAlphaSize)
		}

		// Builds the table from the code length of each symbol. Fails when a
		// length is outside 1..20.
		def build(lengths int[], alphaSize int) !none {
			minLen = 32
			maxLen = 0
			for let i = 0; i < alphaSize; i++ {
				let l = lengths[i]
				fail "bzip2: invalid code length" when l < 1 || l > maxCodeLen
				maxLen = l when l > maxLen
				minLen = l when l < minLen
			}
			let pp = 0
			for let l = minLen; l <= maxLen; l++ {
				for let s = 0; s < alphaSize; s++ {
					if lengths[s] == l {
						perm[pp] = s
						pp++
					}
				}
			}
			let code = 0
			let index = 0
			for let l = 0; l <= maxCodeLen + 1; l++ {
				limit[l] = -1
				base[l] = 0
			}
			lookup.fill(0)
			let tb = tableBits
			tb = maxLen when maxLen < tb
			for let l = minLen; l <= maxLen; l++ {
				let first = code
				let count = 0
				for let s = 0; s < alphaSize; s++ {
					count++ when lengths[s] == l
				}
				base[l] = first - index
				for let k = 0; k < count; k++ {
					if l <= tb {
						// Every tb-bit value that starts with this code.
						let sym = perm[index + k]
						let start = (first + k) << (tb - l)
						let span = 1 << (tb - l)
						for let j = 0; j < span; j++ {
							lookup[start + j] = uint32(sym << 5 | l)
						}
					}
				}
				index += count
				code = first + count
				limit[l] = code - 1
				code <<= 1
			}
		}

		// Decodes one symbol. Fails on a bit pattern no code matches or when
		// the input ends.
		def decode(br BitReader) !int {
			let tb = tableBits
			tb = maxLen when maxLen < tb
			let v = try br.peek(maxLen)
			let e = lookup[int(v >> uint32(maxLen - tb))]
			if e & 31 != 0 {
				try br.skip(int(e & 31))
				return int(e >> 5)
			}
			for let l = tb + 1; l <= maxLen; l++ {
				let c = int(v >> uint32(maxLen - l))
				if c <= limit[l] {
					try br.skip(l)
					let i = c - base[l]
					fail "bzip2: corrupt huffman code" when i < 0 || i >= maxAlphaSize
					return perm[i]
				}
			}
			fail "bzip2: corrupt huffman code"
		}
	}

	// BlockDecoder turns the compressed blocks of a bzip2 stream back into
	// bytes: it reads one block's Huffman-coded MTF symbols, undoes the
	// Burrows-Wheeler transform, and then streams the run-length-decoded
	// output.
	type BlockDecoder {
		br         BitReader
		blockSize  int
		tt         uint32[]
		tables     HuffmanTable[]
		selectors  byte[]
		lengths    int[]
		seqToUnseq byte[]
		mtf        byte[]
		counts     int[]

		// Output state of the current block.
		tPos        uint32
		remaining   int
		repeat      int
		last        int
		runLen      int
		blockCRC    uint32
		expectedCRC uint32
		streamCRC   uint32
		combinedCRC uint32
		inBlock     bool
		started     bool
		streamDone  bool
		done        bool

		def new(r io.Reader) {
			br = new BitReader(r)
			for let i = 0; i < maxGroups; i++ {
				tables.push(new HuffmanTable())
			}
			selectors.len(32768)
			lengths.len(maxAlphaSize)
			seqToUnseq.len(256)
			mtf.len(256)
			counts.len(257)
			streamDone = true
		}

		def reset(r io.Reader) {
			br.reset(r)
			inBlock = false
			started = false
			streamDone = true
			done = false
			repeat = 0
		}

		// Reads a stream header. Returns false when the input holds no further
		// stream: at its end, or before data that is not a bzip2 stream. With
		// `first` set, anything but a stream header fails instead.
		def startStream(first bool) !bool {
			br.align()
			if !first {
				return false when try br.atEnd()
			}
			let b = br.read(8) onerror (e error) {
				fail e when first
				recover 0
			}
			let z = br.read(8) onerror recover 0
			let h = br.read(8) onerror recover 0
			let lvl = br.read(8) onerror recover 0
			if b != 0x42 || z != 0x5A || h != 0x68 || lvl < 0x31 || lvl > 0x39 {
				fail "bzip2: invalid stream header" when first
				return false
			}
			blockSize = int(lvl - 0x30) * 100000
			tt.len(blockSize) when tt.len() < blockSize
			combinedCRC = 0
			streamDone = false
			return true
		}

		// Reads the next block header and its data. Returns false at the end
		// of the stream, after checking the stream CRC. Fails on corrupt data.
		def nextBlock() !bool {
			let hi = uint64(try br.read(24))
			let lo = uint64(try br.read(24))
			let magic = hi << 24 | lo
			if magic == streamMagic {
				let crc = try br.read(32)
				fail "bzip2: stream CRC mismatch" when crc != combinedCRC
				streamDone = true
				return false
			}
			fail "bzip2: invalid block header" when magic != blockMagic
			expectedCRC = try br.read(32)
			try readBlock()
			return true
		}

		def readBlock() !none {
			fail "bzip2: randomised blocks are not supported" when try br.bit()
			let origPtr = int(try br.read(24))

			// The symbols in use, as a two-level bitmap.
			let inUse16 = int(try br.read(16))
			let nInUse = 0
			for let i = 0; i < 16; i++ {
				continue when inUse16 & (0x8000 >> i) == 0
				let bitsSet = int(try br.read(16))
				for let j = 0; j < 16; j++ {
					if bitsSet & (0x8000 >> j) != 0 {
						seqToUnseq[nInUse] = byte(i * 16 + j)
						nInUse++
					}
				}
			}
			fail "bzip2: block uses no symbols" when nInUse == 0
			let alphaSize = nInUse + 2

			let nGroups = int(try br.read(3))
			fail "bzip2: invalid table count" when nGroups < 2 || nGroups > maxGroups
			let nSelectors = int(try br.read(15))
			fail "bzip2: invalid selector count" when nSelectors < 1

			// Selectors, move-to-front coded in unary.
			let pos byte[] = [0, 1, 2, 3, 4, 5]
			let kept = 0
			for let i = 0; i < nSelectors; i++ {
				let j = 0
				for try br.bit() {
					j++
					fail "bzip2: invalid selector" when j >= nGroups
				}
				let v = pos[j]
				for let k = j; k > 0; k-- {
					pos[k] = pos[k - 1]
				}
				pos[0] = v
				if i < maxSelectors {
					selectors[i] = v
					kept++
				}
			}

			// Code lengths, delta coded.
			for let t = 0; t < nGroups; t++ {
				let curr = int(try br.read(5))
				for let s = 0; s < alphaSize; s++ {
					for {
						fail "bzip2: invalid code length" when curr < 1 || curr > maxCodeLen
						break unless try br.bit()
						if try br.bit() {
							curr--
						} else {
							curr++
						}
					}
					lengths[s] = curr
				}
				try tables[t].build(lengths, alphaSize)
			}

			// The MTF/RLE2 symbols.
			for let i = 0; i < 256; i++ {
				mtf[i] = byte(i)
			}
			counts.fill(0)
			let eob = nInUse + 1
			let n = 0
			let groupLeft = 0
			let sel = 0
			let table = tables[0]
			let runLength = 0
			let runWeight = 1
			let limit = blockSize
			for {
				if groupLeft == 0 {
					fail "bzip2: ran out of selectors" when sel >= kept
					table = tables[int(selectors[sel])]
					sel++
					groupLeft = groupSize
				}
				groupLeft--
				let sym = try table.decode(br)
				if sym <= runB {
					// RUNA adds one weight, RUNB two; the weight doubles.
					runLength += (sym + 1) * runWeight
					runWeight <<= 1
					fail "bzip2: run too long" when runLength > limit
					continue
				}
				if runLength > 0 {
					let uc = seqToUnseq[int(mtf[0])]
					fail "bzip2: block overflow" when n + runLength > limit
					let v = uint32(uc)
					for let k = 0; k < runLength; k++ {
						tt[n + k] = v
					}
					counts[int(uc)] += runLength
					n += runLength
					runLength = 0
					runWeight = 1
				}
				break when sym == eob
				let idx = sym - 1
				let v = mtf[idx]
				for let k = idx; k > 0; k-- {
					mtf[k] = mtf[k - 1]
				}
				mtf[0] = v
				let uc = seqToUnseq[int(v)]
				fail "bzip2: block overflow" when n >= limit
				tt[n] = uint32(uc)
				counts[int(uc)]++
				n++
			}
			fail "bzip2: invalid origin pointer" when origPtr >= n || origPtr < 0

			// Inverse BWT: link every position to its successor.
			let sum = 0
			for let i = 0; i < 256; i++ {
				let c = counts[i]
				counts[i] = sum
				sum += c
			}
			for let i = 0; i < n; i++ {
				let uc = int(tt[i] & 0xFF)
				let at = counts[uc]
				tt[at] = tt[at] | uint32(i << 8)
				counts[uc] = at + 1
			}
			tPos = tt[origPtr] >> 8
			remaining = n
			last = -1
			runLen = 0
			repeat = 0
			blockCRC = 0xFFFFFFFF
			inBlock = true
		}

		// Fills `p` with decoded bytes and returns how many, 0 at the end of
		// the input. Fails on corrupt data or a CRC mismatch.
		def read(p byte[]) !int {
			return 0 when done
			let n = 0
			for n < p.len() {
				if !inBlock {
					if streamDone {
						return n when n > 0
						let first = !started
						started = true
						if !(try startStream(first)) {
							done = true
							return 0
						}
					}
					if !(try nextBlock()) {
						continue
					}
				}
				n = emit(p, n)
				if remaining == 0 && repeat == 0 {
					inBlock = false
					let crc = blockCRC ^ 0xFFFFFFFF
					fail "bzip2: block CRC mismatch" when crc != expectedCRC
					combinedCRC = ((combinedCRC << 1) | (combinedCRC >> 31)) ^ crc
				}
			}
			return n
		}

		// Streams the current block's bytes into p from index n until either
		// runs out, updating the block CRC. Returns the new index.
		def emit(p byte[], start int) int {
			let n = start
			let crc = blockCRC
			let pos = tPos
			let left = remaining
			let lastByte = last
			let run = runLen
			let rep = repeat
			let size = p.len()
			for n < size {
				if rep > 0 {
					let b = byte(lastByte)
					let k = rep
					k = size - n when size - n < k
					for let j = 0; j < k; j++ {
						p[n + j] = b
						crc = (crc << 8) ^ crcTable[int((crc >> 24) ^ uint32(b))]
					}
					n += k
					rep -= k
					continue
				}
				break when left == 0
				pos = tt[int(pos)]
				let ch = int(pos & 0xFF)
				pos >>= 8
				left--
				if run == 4 {
					rep = ch
					run = 0
					continue
				}
				if run == 0 || ch != lastByte {
					lastByte = ch
					run = 1
				} else {
					run++
				}
				p[n] = byte(ch)
				crc = (crc << 8) ^ crcTable[int((crc >> 24) ^ uint32(ch))]
				n++
			}
			blockCRC = crc
			tPos = pos
			remaining = left
			last = lastByte
			runLen = run
			repeat = rep
			return n
		}
	}
}
