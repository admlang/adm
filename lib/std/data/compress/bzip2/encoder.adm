internal partial module std.data.compress.bzip2.block {
	use std.io

	const encoderMaxLen = 17

	// BitWriter collects the most-significant-bit-first bit stream of bzip2
	// in memory; whole bytes are handed to the underlying writer on `drain`.
	type BitWriter {
		out   byte[]
		n     int
		bits  uint64
		count int

		def new() {
			out.len(64 * 1024)
		}

		// Appends the low `width` bits of v, width at most 32.
		def write(v uint32, width int) {
			bits = (bits << uint64(width)) | (uint64(v) & ((uint64(1) << uint64(width)) - 1))
			count += width
			for count >= 8 {
				count -= 8
				out.len(out.len() * 2) when n >= out.len()
				out[n] = byte(bits >> uint64(count))
				n++
			}
		}

		// Pads the last byte with zero bits.
		def pad() {
			write(0, 8 - count) when count > 0
		}

		// Writes the whole bytes collected so far to w. Fails when w does.
		def drain(w io.Writer) !none {
			if n > 0 {
				try w.write(out[0:n])
			}
			n = 0
		}
	}

	// Computes Huffman code lengths of at most maxLen bits for the symbol
	// frequencies, halving the frequencies until the tree is shallow enough.
	def makeCodeLengths(freq int[], alphaSize int, maxLen int) int[] {
		let lengths int[]
		lengths.len(alphaSize)
		let weight int[]
		weight.len(alphaSize)
		for let i = 0; i < alphaSize; i++ {
			weight[i] = freq[i]
			weight[i] = 1 when weight[i] == 0
		}
		let order int[]
		order.len(alphaSize)
		let parent int[]
		parent.len(2 * alphaSize)
		let nodeWeight int[]
		nodeWeight.len(2 * alphaSize)
		for {
			for let i = 0; i < alphaSize; i++ {
				order[i] = i
			}
			order.sort((a, b int) => weight[a] < weight[b] || (weight[a] == weight[b] && a < b))
			// Two queues: sorted leaves, and internal nodes in creation order,
			// which is already sorted by weight.
			for let i = 0; i < alphaSize; i++ {
				nodeWeight[i] = weight[i]
			}
			let leaf = 0
			let inner = alphaSize
			let next = alphaSize
			for next < 2 * alphaSize - 1 {
				let picks int[] = [0, 0]
				for let k = 0; k < 2; k++ {
					if leaf < alphaSize && (inner >= next || nodeWeight[order[leaf]] <= nodeWeight[inner]) {
						picks[k] = order[leaf]
						leaf++
					} else {
						picks[k] = inner
						inner++
					}
				}
				nodeWeight[next] = nodeWeight[picks[0]] + nodeWeight[picks[1]]
				parent[picks[0]] = next
				parent[picks[1]] = next
				next++
			}
			let root = 2 * alphaSize - 2
			let depth int[]
			depth.len(2 * alphaSize)
			depth[root] = 0
			let tooLong = false
			for let i = root - 1; i >= 0; i-- {
				depth[i] = depth[parent[i]] + 1
			}
			for let i = 0; i < alphaSize; i++ {
				lengths[i] = depth[i]
				tooLong = true when depth[i] > maxLen
			}
			break unless tooLong
			for let i = 0; i < alphaSize; i++ {
				weight[i] = 1 + weight[i] / 2
			}
		}
		return lengths
	}

	// Assigns canonical codes to the lengths: by length, then by symbol.
	def assignCodes(lengths int[], alphaSize int) uint32[] {
		let codes uint32[]
		codes.len(alphaSize)
		let minLen = 32
		let maxLen = 0
		for let i = 0; i < alphaSize; i++ {
			minLen = lengths[i] when lengths[i] < minLen
			maxLen = lengths[i] when lengths[i] > maxLen
		}
		let code = uint32(0)
		for let l = minLen; l <= maxLen; l++ {
			for let i = 0; i < alphaSize; i++ {
				if lengths[i] == l {
					codes[i] = code
					code++
				}
			}
			code <<= 1
		}
		return codes
	}

	// Sorts the cyclic rotations of block[0:n] and returns them as start
	// offsets in order: prefix doubling with counting sorts.
	def sortRotations(block byte[], n int) int[] {
		let p int[]
		p.len(n)
		let c int[]
		c.len(n)
		let pn int[]
		pn.len(n)
		let cn int[]
		cn.len(n)
		let cnt int[]
		cnt.len(n + 256)
		cnt.fill(0)
		for let i = 0; i < n; i++ {
			cnt[int(block[i])]++
		}
		for let i = 1; i < 256; i++ {
			cnt[i] += cnt[i - 1]
		}
		for let i = n - 1; i >= 0; i-- {
			let b = int(block[i])
			cnt[b]--
			p[cnt[b]] = i
		}
		let classes = 1
		c[p[0]] = 0
		for let i = 1; i < n; i++ {
			classes++ when block[p[i]] != block[p[i - 1]]
			c[p[i]] = classes - 1
		}
		let h = 1
		for classes < n && h < n {
			for let i = 0; i < n; i++ {
				let v = p[i] - h
				v += n when v < 0
				pn[i] = v
			}
			for let i = 0; i < classes; i++ {
				cnt[i] = 0
			}
			for let i = 0; i < n; i++ {
				cnt[c[pn[i]]]++
			}
			for let i = 1; i < classes; i++ {
				cnt[i] += cnt[i - 1]
			}
			for let i = n - 1; i >= 0; i-- {
				let k = c[pn[i]]
				cnt[k]--
				p[cnt[k]] = pn[i]
			}
			cn[p[0]] = 0
			classes = 1
			for let i = 1; i < n; i++ {
				let a = p[i]
				let b = p[i - 1]
				let a2 = a + h
				a2 -= n when a2 >= n
				let b2 = b + h
				b2 -= n when b2 >= n
				classes++ when c[a] != c[b] || c[a2] != c[b2]
				cn[a] = classes - 1
			}
			let t = c
			c = cn
			cn = t
			h <<= 1
		}
		return p
	}

	// BlockEncoder gathers input into run-length-coded blocks and writes
	// each full block as a compressed bzip2 block.
	type BlockEncoder {
		bw          BitWriter
		level       int
		block       byte[]
		nblock      int
		maxBlock    int
		runByte     int
		runLen      int
		blockCRC    uint32
		combinedCRC uint32
		wroteHeader bool

		def new(level int) {
			self.level = level
			bw = new BitWriter()
			block.len(level * 100000)
			maxBlock = level * 100000 - 19
			blockCRC = 0xFFFFFFFF
		}

		def reset() {
			nblock = 0
			runLen = 0
			blockCRC = 0xFFFFFFFF
			combinedCRC = 0
			wroteHeader = false
			bw.n = 0
			bw.count = 0
			bw.bits = 0
		}

		// Takes the input bytes, compressing every block that fills up into
		// the bit buffer.
		def write(p byte[]) {
			let rb = runByte
			let rl = runLen
			for let i = 0; i < p.len(); i++ {
				let b = int(p[i])
				if rl > 0 && b == rb && rl < 255 {
					rl++
					continue
				}
				addRun(rb, rl) when rl > 0
				rb = b
				rl = 1
			}
			runByte = rb
			runLen = rl
		}

		def addRun(b int, count int) {
			let ch = uint32(b)
			let crc = blockCRC
			for let i = 0; i < count; i++ {
				crc = (crc << 8) ^ crcTable[int((crc >> 24) ^ ch)]
			}
			blockCRC = crc
			let v = byte(b)
			if count < 4 {
				for let i = 0; i < count; i++ {
					block[nblock] = v
					nblock++
				}
			} else {
				block[nblock] = v
				block[nblock + 1] = v
				block[nblock + 2] = v
				block[nblock + 3] = v
				block[nblock + 4] = byte(count - 4)
				nblock += 5
			}
			endBlock() when nblock >= maxBlock
		}

		// Writes the stream header when it has not been written yet.
		def header() {
			return when wroteHeader
			wroteHeader = true
			bw.write(0x425A68, 24)
			bw.write(uint32(0x30 + level), 8)
		}

		// Compresses the pending run and block, if any.
		def flush() {
			if runLen > 0 {
				addRun(runByte, runLen)
				runLen = 0
			}
			endBlock() when nblock > 0
		}

		// Ends the stream: the pending data, the end marker and the combined
		// CRC, padded to a whole byte.
		def end() {
			flush()
			header()
			bw.write(0x177245, 24)
			bw.write(0x385090, 24)
			bw.write(combinedCRC, 32)
			bw.pad()
		}

		def endBlock() {
			header()
			let crc = blockCRC ^ 0xFFFFFFFF
			combinedCRC = ((combinedCRC << 1) | (combinedCRC >> 31)) ^ crc
			compressBlock(crc)
			nblock = 0
			blockCRC = 0xFFFFFFFF
		}

		def compressBlock(crc uint32) {
			let n = nblock
			let order = sortRotations(block, n)

			// Symbols in use and their sequence numbers.
			let inUse bool[]
			inUse.len(256)
			inUse.fill(false)
			for let i = 0; i < n; i++ {
				inUse[int(block[i])] = true
			}
			let unseqToSeq int[]
			unseqToSeq.len(256)
			let nInUse = 0
			for let i = 0; i < 256; i++ {
				if inUse[i] {
					unseqToSeq[i] = nInUse
					nInUse++
				}
			}
			let alphaSize = nInUse + 2
			let eob = nInUse + 1

			// BWT output through MTF and zero-run coding.
			let syms uint16[]
			syms.len(n + 1)
			let nsym = 0
			let freq int[]
			freq.len(maxAlphaSize)
			freq.fill(0)
			let yy byte[]
			yy.len(256)
			for let i = 0; i < nInUse; i++ {
				yy[i] = byte(i)
			}
			let origPtr = 0
			let zPend = 0
			for let i = 0; i < n; i++ {
				let j = order[i] - 1
				if j < 0 {
					j += n
					origPtr = i
				}
				let ll = byte(unseqToSeq[int(block[j])])
				if yy[0] == ll {
					zPend++
					continue
				}
				if zPend > 0 {
					nsym = putRun(syms, nsym, freq, zPend)
					zPend = 0
				}
				let k = 1
				let prev = yy[0]
				yy[0] = ll
				for prev != ll {
					let t = yy[k]
					yy[k] = prev
					prev = t
					k++
				}
				syms[nsym] = uint16(k)
				freq[k]++
				nsym++
			}
			nsym = putRun(syms, nsym, freq, zPend) when zPend > 0
			syms[nsym] = uint16(eob)
			freq[eob]++
			nsym++

			// Coding tables.
			let nGroups = 6
			if nsym < 200 {
				nGroups = 2
			} else if nsym < 600 {
				nGroups = 3
			} else if nsym < 1200 {
				nGroups = 4
			} else if nsym < 2400 {
				nGroups = 5
			}
			let lens int[][]
			for let t = 0; t < nGroups; t++ {
				let row int[]
				row.len(alphaSize)
				lens.push(row)
			}
			let nPart = nGroups
			let remF = nsym
			let gs = 0
			for nPart > 0 {
				let tFreq = remF / nPart
				let ge = gs - 1
				let aFreq = 0
				for aFreq < tFreq && ge < alphaSize - 1 {
					ge++
					aFreq += freq[ge]
				}
				if ge > gs && nPart != nGroups && nPart != 1 && (nGroups - nPart) % 2 == 1 {
					aFreq -= freq[ge]
					ge--
				}
				let row = lens[nPart - 1]
				for let v = 0; v < alphaSize; v++ {
					row[v] = (v >= gs && v <= ge) ?? (0, 15)
				}
				nPart--
				gs = ge + 1
				remF -= aFreq
			}
			let nSelectors = (nsym + groupSize - 1) / groupSize
			let selectors byte[]
			selectors.len(nSelectors)
			let rfreq int[][]
			for let t = 0; t < nGroups; t++ {
				let row int[]
				row.len(alphaSize)
				rfreq.push(row)
			}
			let cost int[]
			cost.len(nGroups)
			for let iter = 0; iter < 4; iter++ {
				for let t = 0; t < nGroups; t++ {
					rfreq[t].fill(0)
				}
				for let s = 0; s < nSelectors; s++ {
					let gStart = s * groupSize
					let gEnd = gStart + groupSize
					gEnd = nsym when gEnd > nsym
					cost.fill(0)
					for let i = gStart; i < gEnd; i++ {
						let sym = int(syms[i])
						for let t = 0; t < nGroups; t++ {
							cost[t] += lens[t][sym]
						}
					}
					let best = 0
					for let t = 1; t < nGroups; t++ {
						best = t when cost[t] < cost[best]
					}
					selectors[s] = byte(best)
					let rf = rfreq[best]
					for let i = gStart; i < gEnd; i++ {
						rf[int(syms[i])]++
					}
				}
				for let t = 0; t < nGroups; t++ {
					lens[t] = makeCodeLengths(rfreq[t], alphaSize, encoderMaxLen)
				}
			}
			let codes uint32[][]
			for let t = 0; t < nGroups; t++ {
				codes.push(assignCodes(lens[t], alphaSize))
			}

			// Block header.
			bw.write(0x314159, 24)
			bw.write(0x265359, 24)
			bw.write(crc, 32)
			bw.write(0, 1)
			bw.write(uint32(origPtr), 24)
			let used16 = 0
			for let i = 0; i < 16; i++ {
				for let j = 0; j < 16; j++ {
					if inUse[i * 16 + j] {
						used16 |= 0x8000 >> i
						break
					}
				}
			}
			bw.write(uint32(used16), 16)
			for let i = 0; i < 16; i++ {
				continue when used16 & (0x8000 >> i) == 0
				let bitsSet = 0
				for let j = 0; j < 16; j++ {
					bitsSet |= 0x8000 >> j when inUse[i * 16 + j]
				}
				bw.write(uint32(bitsSet), 16)
			}
			bw.write(uint32(nGroups), 3)
			bw.write(uint32(nSelectors), 15)
			let pos byte[] = [0, 1, 2, 3, 4, 5]
			for let s = 0; s < nSelectors; s++ {
				let v = selectors[s]
				let j = 0
				for pos[j] != v {
					j++
				}
				for let k = j; k > 0; k-- {
					pos[k] = pos[k - 1]
				}
				pos[0] = v
				for let k = 0; k < j; k++ {
					bw.write(1, 1)
				}
				bw.write(0, 1)
			}
			for let t = 0; t < nGroups; t++ {
				let row = lens[t]
				let curr = row[0]
				bw.write(uint32(curr), 5)
				for let v = 0; v < alphaSize; v++ {
					for curr < row[v] {
						bw.write(2, 2)
						curr++
					}
					for curr > row[v] {
						bw.write(3, 2)
						curr--
					}
					bw.write(0, 1)
				}
			}
			for let s = 0; s < nSelectors; s++ {
				let t = int(selectors[s])
				let row = lens[t]
				let code = codes[t]
				let gStart = s * groupSize
				let gEnd = gStart + groupSize
				gEnd = nsym when gEnd > nsym
				for let i = gStart; i < gEnd; i++ {
					let sym = int(syms[i])
					bw.write(code[sym], row[sym])
				}
			}
		}

		// Appends a run of `count` zeros in bijective base 2 as RUNA/RUNB
		// symbols and returns the new symbol count.
		def putRun(syms uint16[], start int, freq int[], count int) int {
			let n = start
			let z = count - 1
			for {
				let sym = z & 1
				syms[n] = uint16(sym)
				freq[sym]++
				n++
				break when z < 2
				z = (z - 2) / 2
			}
			return n
		}
	}
}
