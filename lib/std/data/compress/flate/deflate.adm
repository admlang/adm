partial module std.data.compress.flate {
	use (
		std.io
		std.math
	)

	// Level is how hard the compressor works: DefaultCompression lets the encoder
	// choose, NoCompression stores the input as is, and 1 (BestSpeed) to 9
	// (BestCompression) trade time for size.
	enum Level {
		DefaultCompression = -1,
		NoCompression = 0,
		BestSpeed = 1
		BestCompression = 9,
		HuffmanOnly = -2
	}

	internal const (
		logWindowSize       = 15
		windowSize          = 1 << logWindowSize
		windowMask          = windowSize - 1
		baseMatchLength     = 3 // The smallest match length per the RFC section 3.2.5
		minMatchLength      = 4 // The smallest match length that the compressor actually emits
		maxMatchLength      = 258 // The largest match length
		baseMatchOffset     = 1 // The smallest match offset
		maxMatchOffset      = 1 << 15 // The largest match offset
		maxFlateBlockTokens = 1 << 14
		maxStoreBlockSize   = 65535
		hashBits            = 17 // After 17 performance degrades
		hashSize            = 1 << hashBits
		hashMask            = (1 << hashBits) - 1
		maxHashOffset       = 1 << 24
		skipNever           = int32(0).MAX()
	)

	internal struct compressionLevel {
		level, good, lazy, nice, chain, fastSkipHashing int
	}

	internal const compressionLevels = compressionLevel[
			compressionLevel{level:0, good:0, lazy:0, nice:0, chain:0, fastSkipHashing:0},
			compressionLevel{level:1, good:0, lazy:0, nice:0, chain:0, fastSkipHashing:0},
			compressionLevel{level:2, good:4, lazy:0, nice:16, chain:8, fastSkipHashing:5},
			compressionLevel{level:3, good:4, lazy:0, nice:32, chain:32, fastSkipHashing:6},
			compressionLevel{level:4, good:4, lazy:4, nice:16, chain:16, fastSkipHashing:skipNever},
			compressionLevel{level:5, good:8, lazy:16, nice:32, chain:32, fastSkipHashing:skipNever},
			compressionLevel{level:6, good:8, lazy:16, nice:128, chain:128, fastSkipHashing:skipNever},
			compressionLevel{level:7, good:8, lazy:32, nice:128, chain:256, fastSkipHashing:skipNever},
			compressionLevel{level:8, good:32, lazy:128, nice:258, chain:1024, fastSkipHashing:skipNever},
			compressionLevel{level:9, good:32, lazy:258, nice:258, chain:4096, fastSkipHashing:skipNever}
		]

	internal type compressor {
		const hashmul = 0x1e35a7bd
		compressionLevel compressionLevel
		w                HuffmanBitWriter

		closed bool

		chainHead  int
		hashHead   uint32[]
		hashPrev   uint32[]
		hashOffset int

		index         int
		window        byte[]
		windowEnd     int
		blockStart    int
		byteAvailable bool

		sync bool

		tokens token[]

		length         int
		offset         int
		maxInsertIndex int
		err            ?error

		hashMatch uint32[]

		bestSpeed deflateFast
		stepper   int
		filler    int

		def new() {
			bestSpeed = new deflateFast()
			hashMatch.len(maxMatchLength - 1)
			hashMatch[:] = 0

			hashHead.len(hashSize)
			hashHead[:] = 0

			hashPrev.len(windowSize)
			hashPrev[:] = 0
		}

		def bulkHash4(b byte[], dst uint32[]) {
			return when b.len() < minMatchLength
			let hb = uint32(b[3]) | uint32(b[2]) << 8 | uint32(b[1]) << 16 | uint32(b[0]) << 24
			dst[0] = (hb * hashmul) >> (32 - hashBits)
			let end = b.len() - minMatchLength + 1
			for let i = 1; i < end; i++ {
				hb = (hb << 8) | uint32(b[i + 3])
				dst[i] = (hb * hashmul) >> (32 - hashBits)
			}
		}

		def matchLen(a, b byte[], max int) int {
			a = a[:max]
			b = b[:a.len()]
			for let (i, av) in a {
				return i unless b[i] == av
			}
			return max
		}

		def fillDeflate(b byte[]) int {
			if index >= 2 * windowSize - (minMatchLength + maxMatchLength) {
				window[windowSize:2 * windowSize].copy(window)
				index -= windowSize
				windowEnd -= windowSize
				if blockStart >= windowSize {
					blockStart -= windowSize
				} else {
					blockStart = math.MAX_INT32
				}
				hashOffset += windowSize
				if hashOffset > maxHashOffset {
					let delta = hashOffset - 1
					hashOffset -= delta
					chainHead -= delta

					for let (i, v) in hashPrev {
						if int(v) > delta {
							hashPrev[i] = uint32(int(v) - delta)
						} else {
							hashPrev[i] = 0
						}
					}
					for let (i, v) in hashHead {
						if int(v) > delta {
							hashHead[i] = uint32(int(v) - delta)
						} else {
							hashHead[i] = 0
						}
					}
				}
			}
			let n = b.copy(window[windowEnd:])
			windowEnd += n
			return n
		}

		def writeBlock(tokens token[], index int) !none {
			if index > 0 {
				let win byte[]
				if blockStart <= index {
					win = window[blockStart:index]
				}
				blockStart = index
				w.writeBlock(tokens, false, win)
				fail w.err unless w.err is none
			}
			return none
		}

		def fillWindow(b byte[]) !none {
			return none when compressionLevel.level < 2
			fail "fillWindow called with stale data" when index != 0 || windowEnd != 0
			b = b[-windowSize:] when b.len() > windowSize
			let n = b.copy(window)
			let loops = (n + 256 - minMatchLength) / 256
			for let j = 0; j < loops; j++ {
				let index = j * 256
				let end = index + 256 + minMatchLength - 1
				end = n when end > n
				let toCheck = window[index:end]
				let dstSize = toCheck.len() - minMatchLength + 1
				continue when dstSize <= 0
				let dst = hashMatch[:dstSize]
				bulkHash4(toCheck, dst)
				for let (i, val) in dst {
					let di = i + index
					let hh = hashHead[val & hashMask]
					hashPrev[di & windowMask] = hh
					hashHead[val & hashMask] = uint32(di + hashOffset)
				}
			}
			windowEnd = n
			index = n
			return none
		}

		def findMatch(pos int, prevHead int, prevLength int, lookahead int) (int, int, bool) {
			let length int
			let offset int
			let ok bool

			let minMatchLook = maxMatchLength
			minMatchLook = lookahead when lookahead < minMatchLook
			let win = window[:pos + minMatchLook]
			let nice = win.len() - pos
			nice = compressionLevel.nice when compressionLevel.nice < nice
			let tries = compressionLevel.chain
			length = prevLength
			tries >>= 2 when length >= compressionLevel.good
			let wEnd = win[pos + length]
			let wPos = win[pos:]
			let minIndex = pos - windowSize
			for let i = prevHead; tries > 0; tries-- {
				if wEnd == win[i + length] {
					let n = matchLen(win[i:], wPos, minMatchLook)
					if n > length && (n > minMatchLength || pos - i <= 4096) {
						length = n
						offset = pos - i
						ok = true
						break when n >= nice
						wEnd = win[pos + n]
					}
				}
				break when i == minIndex
				i = int(hashPrev[i & windowMask]) - hashOffset
				break when i < minIndex || i < 0
			}
			return (length, offset, ok)
		}

		def writeStoredBlock(buf byte[]) !none {
			w.writeStoredHeader(buf.len(), false)
			fail w.err unless w.err is none
			w.writeBytes(buf)
			fail w.err unless w.err is none
			return none
		}

		def encSpeed() {
			if windowEnd < maxStoreBlockSize {
				return unless sync
				if windowEnd < 128 {
					if windowEnd == 0 {
						return
					} else if windowEnd <= 16 {
						writeStoredBlock(window[:windowEnd]) onerror (e error) {
							err = e
							recover none
						}
						self.err = w.err
					} else {
						w.writeBlockHuff(false, window[:windowEnd])
						self.err = w.err
					}
					windowEnd = 0
					bestSpeed.reset()
					return
				}
			}
			tokens = bestSpeed.encode(tokens[:0], window[:windowEnd])
			if tokens.len() > windowEnd - (windowEnd >> 4) {
				w.writeBlockHuff(false, window[:windowEnd])
			} else {
				w.writeBlockDynamic(tokens, false, window[:windowEnd])
			}
			err = w.err
			windowEnd = 0
		}

		def initDeflate() {
			window.len(2 * windowSize)
			hashOffset = 1

			tokens.cap(maxFlateBlockTokens + 1)
			tokens.len(0)
			length = minMatchLength - 1
			offset = 0
			byteAvailable = false
			index = 0
			chainHead = -1
		}

		def deflate() {
			return when windowEnd - index < minMatchLength + maxMatchLength && !sync
			maxInsertIndex = windowEnd - (minMatchLength - 1)

			for {
				if index > windowEnd {
					err = Error{message: "flate: internal error: index > windowEnd"}
					return
				}
				let lookahead = windowEnd - index
				if lookahead < minMatchLength + maxMatchLength {
					if !sync {
						break
					}
					if index > windowEnd {
						err = Error{message: "flate: internal error: index > windowEnd"}
						return
					}
					if lookahead == 0 {
						if byteAvailable {
							tokens = tokens.push(literalToken(uint32(window[index - 1])))
							byteAvailable = false
						}
						if tokens.len() > 0 {
							writeBlock(tokens, index) onerror (e error) {
								err = e
								recover none
							}
							tokens = tokens[:0]
							return unless err is none
						}
						break
					}
				}
				if index < maxInsertIndex {
					let hash = (uint32(window[index + 3]) | uint32(window[index + 2]) << 8 | uint32(window[index + 1]) << 16 | uint32(window[index]) << 24)
					let h = (hash * hashmul) >> (32 - hashBits)
					let hh = hashHead[h & hashMask]
					chainHead = int(hh)
					hashPrev[index & windowMask] = uint32(chainHead)
					hashHead[h & hashMask] = uint32(index + hashOffset)
				}
				let prevLength = length
				let prevOffset = offset
				length = minMatchLength - 1
				offset = 0
				let minIndex = index - windowSize
				let minAllowed = 0
				minAllowed = minIndex when minIndex > 0

				if chainHead - hashOffset >= minAllowed && ((compressionLevel.fastSkipHashing != skipNever && lookahead > minMatchLength - 1) || (compressionLevel.fastSkipHashing == skipNever && lookahead > prevLength && prevLength < compressionLevel.lazy)) {
					let (newLength, newOffset, ok) = findMatch(index, chainHead - hashOffset, minMatchLength - 1, lookahead)
					if ok {
						length = newLength
						offset = newOffset
					}
				}

				if (compressionLevel.fastSkipHashing != skipNever && length >= minMatchLength) || (compressionLevel.fastSkipHashing == skipNever && prevLength >= minMatchLength && length <= prevLength) {
					if compressionLevel.fastSkipHashing != skipNever {
						tokens = tokens.push(matchToken(uint32(length - baseMatchLength), uint32(offset - baseMatchOffset)))
					} else {
						tokens = tokens.push(matchToken(uint32(prevLength - baseMatchLength), uint32(prevOffset - baseMatchOffset)))
					}

					if length <= compressionLevel.fastSkipHashing {
						let newIndex int
						if compressionLevel.fastSkipHashing != skipNever {
							newIndex = index + length
						} else {
							newIndex = index + prevLength - 1
						}
						let idx = index
						for idx++; idx < newIndex; idx++ {
							if idx < maxInsertIndex {
								let hash = (uint32(window[idx + 3]) | uint32(window[idx + 2]) << 8 | uint32(window[idx + 1]) << 16 | uint32(window[idx]) << 24)
								let h = (hash * hashmul) >> (32 - hashBits)
								let hh = hashHead[h & hashMask]
								hashPrev[idx & windowMask] = hh
								hashHead[h & hashMask] = uint32(idx + hashOffset)
							}
						}
						index = idx

						if compressionLevel.fastSkipHashing == skipNever {
							byteAvailable = false
							length = minMatchLength - 1
						}
					} else {
						index += length
					}

					if tokens.len() == maxFlateBlockTokens {
						writeBlock(tokens, index) onerror (e error) {
							err = e
							recover none
						}
						tokens = tokens[:0]
						return unless err is none
					}
				} else {
					if compressionLevel.fastSkipHashing != skipNever || byteAvailable {
						let i = index - 1
						i = index when compressionLevel.fastSkipHashing != skipNever
						tokens = tokens.push(literalToken(uint32(window[i])))
						if tokens.len() == maxFlateBlockTokens {
							writeBlock(tokens, i + 1) onerror (e error) {
								err = e
								recover none
							}
							tokens = tokens[:0]
							return unless err is none
						}
					}
					index++
					byteAvailable = true when compressionLevel.fastSkipHashing == skipNever
				}
			}
		}

		def fillStore(b byte[]) int {
			let n = b.copy(window[windowEnd:])
			windowEnd += n
			return n
		}

		def store() {
			if windowEnd > 0 && (windowEnd == maxStoreBlockSize || sync) {
				writeStoredBlock(window[:windowEnd]) onerror (e error) {
					err = e
					recover none
				}
				self.err = w.err
				windowEnd = 0
			}
		}

		def storeHuff() {
			if windowEnd < window.len() && !sync || windowEnd == 0 {
				return
			}
			w.writeBlockHuff(false, window[:windowEnd])
			self.err = w.err
			windowEnd = 0
		}

		def write(b byte[]) !int {
			fail err unless err is none
			let n = b.len()

			for b.len() > 0 {
				step()
				b = b[fill(b):]
				fail err unless err is none
			}
			return n
		}

		def syncFlush() !none {
			fail err unless err is none
			sync = true
			step()
			if err is none {
				w.writeStoredHeader(0, false)
				w.flush()
				err = w.err
			}
			sync = false
			fail err unless err is none
			return none
		}

		def init(w io.Writer, level int) !none {
			self.w = new HuffmanBitWriter(w)
			switch {
				case level == int(Level.NoCompression):
					window.len(maxStoreBlockSize)
					filler = 1
					stepper = 1
				case level == int(Level.HuffmanOnly):
					window.len(maxStoreBlockSize)
					filler = 1
					stepper = 2
				case level == int(Level.BestSpeed):
					compressionLevel = compressionLevels[level]
					window.len(maxStoreBlockSize)
					tokens.len(maxStoreBlockSize)
					bestSpeed = new deflateFast()
					filler = 1
					stepper = 3
				case level == int(Level.DefaultCompression) || (2 <= level && level <= 9):
					if level == int(Level.DefaultCompression) {
						level = 6
					}
					compressionLevel = compressionLevels[level]
					initDeflate()
					filler = 4
					stepper = 4
				default:
					fail "flate: invalid compression level"
			}
			return none
		}

		def step() {
			switch stepper {
				case 1:
					store()
				case 2:
					storeHuff()
				case 3:
					encSpeed()
				case 4:
					deflate()
			}
		}

		def fill(b byte[]) int {
			return fillDeflate(b) when filler == 4
			return fillStore(b)
		}

		def reset(w io.Writer) {
			self.w.reset(w)
			sync = false
			err = none
			switch compressionLevel.level {
				case int(Level.NoCompression):
					windowEnd = 0
				case int(Level.BestSpeed):
					windowEnd = 0
					tokens = tokens[:0]
					bestSpeed.reset()
				default:
					chainHead = -1
					hashHead[:] = 0
					hashPrev[:] = 0
					hashOffset = 1
					index = 0
					windowEnd = 0
					blockStart = 0
					byteAvailable = false
					tokens = tokens[:0]
					length = minMatchLength - 1
					offset = 0
					maxInsertIndex = 0
			}
		}

		def close() !none {
			return none when closed
			fail err unless err is none
			sync = true
			step()
			fail err unless err is none
			w.writeStoredHeader(0, true)
			err = w.err
			w.flush()
			err = w.err
			fail err unless err is none
			closed = true
			return none
		}
	}

	// Writer compresses what is written to it in the DEFLATE format and passes
	// the result to an io.Writer, optionally primed with a preset dictionary.
	type Writer {
		internal d compressor
		dict       byte[]

		def new(w io.Writer, level int, dictionary ?byte[] = none) {
			d = new compressor()
			d.init(w, level) onerror (e error) {
				d.err = e
				recover none
			}

			if !(dictionary is none) {
				d.fillWindow(dictionary) onerror (e error) {
					d.err = e
					recover none
				}
				dict = dictionary.clone()
			}
		}

		// write compresses b and returns how many input bytes were taken, all of
		// them. Fails when the underlying writer does.
		def write(b byte[]) !int {
			return d.write(b)
		}

		// flush emits the data compressed so far so a reader can decode it, at some
		// cost in size. Fails when the underlying writer does.
		def flush() !none {
			return d.syncFlush()
		}

		// close finishes the stream and writes the final block; the writer is not
		// usable afterwards. Fails when the underlying writer does.
		def close() !none {
			return d.close()
		}

		// reset discards the compressor's state and starts a new stream on w, keeping
		// the level and the dictionary.
		def reset(w io.Writer) {
			d.reset(w)
			if dict.len() > 0 {
				d.fillWindow(dict) onerror (e error) {
					d.err = e
					recover none
				}
			}
		}
	}
}
