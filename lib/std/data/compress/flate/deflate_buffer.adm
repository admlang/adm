partial module std.data.compress.flate {
	use std.bytes

	// The input a task of `deflate` compresses.
	internal const deflatePiece = 1 << 20

	// Compresses `src` into one raw DEFLATE stream, as a `Writer` at `level`
	// closed after writing it would. An input over 2 MiB is compressed 1 MiB
	// a task: each piece is primed with the 32 KiB before it and ends with a
	// sync flush, so the pieces join into one stream that inflates to `src`.
	// The pieces are cut at fixed points, so the output does not depend on
	// timing; it is a little larger than one `Writer`'s, since no match
	// crosses a cut.
	def deflate(src byte[], level Level = Level.DefaultCompression) byte[] {
		return deflateRange(src, 0, src.len(), level) when src.len() <= 2 * deflatePiece
		let tasks (async byte[])[] = []
		for let at = 0; at < src.len(); at += deflatePiece {
			tasks.push(async deflateRange(src, at, (at + deflatePiece).min(src.len()), level))
		}
		let parts byte[][] = []
		let size = 0
		for let t in tasks {
			let part = await t
			size += part.len()
			parts.push(part)
		}
		let out byte[]
		out.len(size)
		let at = 0
		for let part in parts {
			part.copy(out[at:])
			at += part.len()
		}
		return out
	}

	// Compresses `src[from:to]` primed with the window before `from`; the
	// piece that ends `src` closes the stream, any other ends with a sync
	// flush.
	internal def deflateRange(src byte[], from int, to int, level Level) byte[] {
		let buffer = new bytes.Buffer()
		let dictionary = from == 0 ?? (none, src[(from - windowSize).max(0):from])
		let w = new Writer(buffer, int(level), dictionary)
		// Writing to a Buffer cannot fail.
		w.write(src[from:to]) onerror recover 0
		if to == src.len() {
			w.close() onerror recover none
		} else {
			w.flush() onerror recover none
		}
		return buffer.bytes()
	}
}
