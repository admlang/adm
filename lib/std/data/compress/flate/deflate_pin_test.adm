partial module std.data.compress.flate {
	use (
		std.bytes
		std.testing
	)

	// Inputs with long, short and no matches: the sample, noise, words, and
	// noise over a gradient (like image rows).
	internal def pinInputs() byte[][] {
		let noise byte[]
		noise.len(50000)
		let grad byte[]
		grad.len(120000)
		let s = uint32(3)
		for let i = 0; i < grad.len(); i++ {
			s = s * uint32(1664525) + uint32(1013904223)
			noise[i] = byte(s >> 24) when i < noise.len()
			grad[i] = byte(((i % 640) / 3 + int(s >> 30)) & 0xFF)
		}
		let words = new bytes.Buffer()
		let vocab = ["the ", "quick ", "brown ", "fox ", "jumps ", "over ", "lazy ", "dogs ", "and ", "runs "]
		for let i = 0; i < 12000; i++ {
			words.write(vocab[(i * 7 + i / 13) % vocab.len()].bytes()) onerror recover 0
		}
		return [sample(200000), noise, words.bytes(), grad]
	}

	internal def pinDeflate(input byte[], level int) !string {
		let out = new bytes.Buffer()
		let w = new Writer(out, level)
		try w.write(input)
		try w.close()
		let h = uint64(14695981039346656037)
		for let (_, b) in out.bytes() {
			h = (h ^ uint64(b)) * uint64(1099511628211)
		}
		return "{out.bytes().len()}:{h.hex()}"
	}

	check "Deflate output" {
		@test()
		def output_stays_pinned() !none {
			// Pinned when the match search moved to window indices and vectors,
			// which gave the same bytes.
			let want = [
				"186765:C4C56E1374487B08",
				"2730:466095365E748995",
				"2964:CB6437D6A069B07A",
				"1832:4AC428E184C82D8C",
				"1523:8E17EB85A87B19F",
				"1232:87A4E724376AE54A",
				"50010:A5F86C664FAB57D2",
				"50010:A5F86C664FAB57D2",
				"50025:5CB28BD9DE58BEA4",
				"50025:5CB28BD9DE58BEA4",
				"50025:5CB28BD9DE58BEA4",
				"50025:5CB28BD9DE58BEA4",
				"32889:3AE347F5CEF76F6A",
				"763:12C8B4DC164F4C13",
				"687:25676F6796C49662",
				"2435:F7BF585EF4D181EA",
				"352:43A23BEFD011BE33",
				"352:43A23BEFD011BE33",
				"120015:CE9BB6B723BBBC4A",
				"120015:CE9BB6B723BBBC4A",
				"89232:C93F5E9B624CDD",
				"87908:B96DEE4B25F96E04",
				"87659:F478741E6C50E58A",
				"87659:F478741E6C50E58A",
			]
			let k = 0
			for let (_, input) in pinInputs() {
				for let (_, level) in [int(Level.HuffmanOnly), 1, 2, 4, 6, 9] {
					assert (try pinDeflate(input, level)) == want[k]
					k++
				}
			}
			return none
		}
	}
}
