partial module std.data.compress.flate {
	use std.math

	internal const (
		tableBits  = 14
		tableSize  = 1 << tableBits
		tableMask  = tableSize - 1
		tableShift = 32 - tableBits

		inputMargin            = 16 - 1
		minNonLiteralBlockSize = 1 + 1 + inputMargin
		bufferReset            = math.MAX_INT32 - maxStoreBlockSize * 2
	)

	internal struct tableEntry {
		val    uint32
		offset int32
	}

	internal def load32(b byte[], i int32) uint32 {
		return uint32(b[i]) | uint32(b[i + 1]) << 8 | uint32(b[i + 2]) << 16 | uint32(b[i + 3]) << 24
	}

	internal def load64(b byte[], i int32) uint64 {
		return uint64(b[i]) | uint64(b[i + 1]) << 8 | uint64(b[i + 2]) << 16 | uint64(b[i + 3]) << 24 |
			uint64(b[i + 4]) << 32 | uint64(b[i + 5]) << 40 | uint64(b[i + 6]) << 48 | uint64(b[i + 7]) << 56
	}

	internal def hash(u uint32) uint32 {
		return (u * 0x1e35a7bd) >> tableShift
	}

	internal def emitLiteral(dst token[], lit byte[]) token[] {
		for let (_, v) in lit {
			dst = dst.push(literalToken(uint32(v)))
		}
		return dst
	}

	internal type deflateFast {
		table tableEntry[]
		prev  byte[]
		cur   int32

		def new() {
			table.len(tableSize)
			prev.len(0)
			cur = int32(maxStoreBlockSize)
		}

		def encode(dst token[], src byte[]) token[] {
			if cur >= bufferReset {
				shiftOffsets()
			}

			if src.len() < minNonLiteralBlockSize {
				cur += int32(maxStoreBlockSize)
				prev.len(0)
				return emitLiteral(dst, src)
			}

			let sLimit = int32(src.len() - inputMargin)
			let nextEmit int32 = 0
			let s int32 = 0
			let cv = load32(src, s)
			let nextHash = hash(cv)

			let emitRemainder = false
			for {
				let skip int32 = 32
				let nextS = s
				let candidate tableEntry
				for {
					s = nextS
					let bytesBetween = skip >> 5
					nextS = s + bytesBetween
					skip += bytesBetween
					if nextS > sLimit {
						emitRemainder = true
						break
					}
					candidate = table[int(nextHash & uint32(tableMask))]
					let now = load32(src, nextS)
					table[int(nextHash & uint32(tableMask))] = tableEntry{offset: s + cur, val: cv}
					nextHash = hash(now)

					let offset = s - (candidate.offset - cur)
					if offset > maxMatchOffset || cv != candidate.val {
						cv = now
						continue
					}
					break
				}
				break when emitRemainder

				dst = emitLiteral(dst, src[int(nextEmit):int(s)])

				for {
					s += 4
					let t = candidate.offset - cur + 4
					let l = matchLen(s, t, src)
					dst = dst.push(matchToken(uint32(l + 4 - baseMatchLength), uint32(s - t - baseMatchOffset)))
					s += l
					nextEmit = s
					if s >= sLimit {
						emitRemainder = true
						break
					}

					let x = load64(src, s - 1)
					let prevHash = hash(uint32(x))
					table[int(prevHash & uint32(tableMask))] = tableEntry{offset: cur + s - 1, val: uint32(x)}
					x >>= 8
					let currHash = hash(uint32(x))
					candidate = table[int(currHash & uint32(tableMask))]
					table[int(currHash & uint32(tableMask))] = tableEntry{offset: cur + s, val: uint32(x)}

					let offset = s - (candidate.offset - cur)
					if offset > maxMatchOffset || uint32(x) != candidate.val {
						cv = uint32(x >> 8)
						nextHash = hash(cv)
						s++
						break
					}
				}
				break when emitRemainder
			}

			if int(nextEmit) < src.len() {
				dst = emitLiteral(dst, src[int(nextEmit):])
			}
			cur += int32(src.len())
			prev.len(src.len())
			src.copy(prev)
			return dst
		}

		def matchLen(s int32, t int32, src byte[]) int32 {
			let s1 = int(s) + maxMatchLength - 4
			s1 = src.len() when s1 > src.len()

			if t >= 0 {
				let a = src[int(s):s1]
				let b = src[int(t):]
				b = b[:a.len()]
				for let (i, _) in a {
					return int32(i) when a[i] != b[i]
				}
				return int32(a.len())
			}

			let tp = int32(prev.len()) + t
			return 0 when tp < 0

			let a = src[int(s):s1]
			let b = prev[int(tp):]
			b = b[:a.len()] when b.len() > a.len()
			a = a[:b.len()]
			for let (i, _) in b {
				return int32(i) when a[i] != b[i]
			}

			let n = int32(b.len())
			return n when int(s + n) == s1

			a = src[int(s + n):s1]
			b = src[:a.len()]
			for let (i, _) in a {
				return int32(i) + n when a[i] != b[i]
			}
			return int32(a.len()) + n
		}

		def reset() {
			prev.len(0)
			cur += int32(maxMatchOffset)
			if cur >= bufferReset {
				shiftOffsets()
			}
		}

		def shiftOffsets() {
			if prev.len() == 0 {
				table.len(tableSize)
				for let (i, _) in table {
					table[i] = tableEntry{}
				}
				cur = int32(maxMatchOffset + 1)
				return
			}

			for let (i, _) in table {
				let v = table[i].offset - cur + int32(maxMatchOffset + 1)
				v = 0 when v < 0
				table[i].offset = v
			}
			cur = int32(maxMatchOffset + 1)
		}
	}
}
