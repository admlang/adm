partial module std.data.compress.flate {
	internal type dictDecoder {
		hist  byte[]
		wrPos int
		rdPos int
		full  bool

		def init(size int, dict byte[]) {
			hist.len(0)
			if hist.cap() < size {
				hist.cap(size)
			}
			hist.len(size)

			if dict.len() > hist.len() {
				dict = dict[dict.len() - hist.len():]
			}
			wrPos = dict.copy(hist)
			if wrPos == hist.len() {
				wrPos = 0
				full = true
			}
			rdPos = wrPos
		}

		def histSize() int {
			return hist.len() when full
			return wrPos
		}

		def availRead() int {
			return wrPos - rdPos
		}

		def availWrite() int {
			return hist.len() - wrPos
		}

		def writeSlice() byte[] {
			return hist[wrPos:]
		}

		def writeMark(cnt int) {
			wrPos += cnt
		}

		def writeByte(c byte) {
			hist[wrPos] = c
			wrPos++
		}

		def writeCopy(dist int, length int) int {
			let dstBase = wrPos
			let dstPos = dstBase
			let srcPos = dstPos - dist
			let endPos = dstPos + length
			endPos = hist.len() when endPos > hist.len()

			if srcPos < 0 {
				srcPos += hist.len()
				dstPos += hist[srcPos:].copy(hist[dstPos:endPos])
				srcPos = 0
			}

			for dstPos < endPos {
				dstPos += hist[srcPos:dstPos].copy(hist[dstPos:endPos])
			}

			wrPos = dstPos
			return dstPos - dstBase
		}

		def tryWriteCopy(dist int, length int) int {
			let dstPos = wrPos
			let endPos = dstPos + length
			return 0 when dstPos < dist || endPos > hist.len()
			let dstBase = dstPos
			let srcPos = dstPos - dist

			for dstPos < endPos {
				dstPos += hist[srcPos:dstPos].copy(hist[dstPos:endPos])
			}

			wrPos = dstPos
			return dstPos - dstBase
		}

		def readFlush() byte[] {
			let toRead = hist[rdPos:wrPos]
			rdPos = wrPos
			if wrPos == hist.len() {
				wrPos = 0
				rdPos = 0
				full = true
			}
			return toRead
		}
	}
}
