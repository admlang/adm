partial module std.data.compress.flate {
	use std.simd

	internal type dictDecoder {
		hist  byte[]
		wrPos int
		rdPos int
		full  bool

		def init(size int, dict byte[]) {
			hist.len(0)
			if hist.cap() < size {
				hist.cap(size)
			}
			hist.len(size)

			if dict.len() > hist.len() {
				dict = dict[dict.len() - hist.len():]
			}
			wrPos = dict.copy(hist)
			if wrPos == hist.len() {
				wrPos = 0
				full = true
			}
			rdPos = wrPos
		}

		def histSize() int {
			return hist.len() when full
			return wrPos
		}

		def availRead() int {
			return wrPos - rdPos
		}

		def availWrite() int {
			return hist.len() - wrPos
		}

		def writeSlice() byte[] {
			return hist[wrPos:]
		}

		def writeMark(cnt int) {
			wrPos += cnt
		}

		def writeByte(c byte) {
			hist[wrPos] = c
			wrPos++
		}

		def writeCopy(dist int, length int) int {
			let dstBase = wrPos
			let dstPos = dstBase
			let srcPos = dstPos - dist
			let endPos = dstPos + length
			endPos = hist.len() when endPos > hist.len()

			if srcPos < 0 {
				// The start of the match is at the end of the window.
				srcPos += hist.len()
				for srcPos < hist.len() && dstPos < endPos {
					hist[dstPos] = hist[srcPos]
					srcPos++
					dstPos++
				}
				srcPos = 0
			}
			copyForward(srcPos, dstPos, endPos)

			wrPos = endPos
			return endPos - dstBase
		}

		// Copies the window from srcPos to dstPos up to endPos front to back,
		// so a source that overlaps the destination repeats: 16 bytes a
		// vector when they are at least that far apart.
		def copyForward(srcPos int, dstPos int, endPos int) {
			let h = hist
			let s = srcPos
			let d = dstPos
			if d - s >= 16 {
				for d + 16 <= endPos {
					simd.store16<byte>(h, d, simd.load16<byte>(h, s))
					s += 16
					d += 16
				}
			}
			for d < endPos {
				h[d] = h[s]
				s++
				d++
			}
		}

		def tryWriteCopy(dist int, length int) int {
			let dstPos = wrPos
			let endPos = dstPos + length
			return 0 when dstPos < dist || endPos > hist.len()
			copyForward(dstPos - dist, dstPos, endPos)
			wrPos = endPos
			return length
		}

		def readFlush() byte[] {
			let toRead = hist[rdPos:wrPos]
			rdPos = wrPos
			if wrPos == hist.len() {
				wrPos = 0
				rdPos = 0
				full = true
			}
			return toRead
		}
	}
}
