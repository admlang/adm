partial module std.data.compress.flate {
	use (
		std.bytes
		std.testing
	)

	// Sink collects what a Writer produces.
	internal type Sink {
		data byte[]

		def new() {}

		def write(chunk byte[]) !int {
			data = data + chunk
			return chunk.len()
		}
	}

	// sample is n bytes that compress, with a period DEFLATE can match and
	// a counter that keeps it from collapsing to one run.
	internal def sample(n int) byte[] {
		let out byte[]
		out.len(n)
		for let i = 0; i < n; i++ {
			out[i] = byte((i % 37) * 5 + (i / 997) % 7)
		}
		return out
	}

	// inflateAll decompresses a whole stream, with a dictionary when given.
	internal def inflateAll(data byte[], dict byte[] = []) !byte[] {
		let r = new Reader(new bytes.Reader(data), dict)
		let out byte[]
		let buf byte[]
		buf.len(8192)
		for {
			let n = try r.read(buf)
			break when n == 0
			out = out + buf[0:n]
		}
		return out
	}

	// inflateWithin decompresses a whole stream through a window of
	// 2^bits bytes, so a match reaching farther back fails as corrupt.
	internal def inflateWithin(data byte[], bits int) !byte[] {
		buildFixedHuffmanDecoder()
		let r = new decompressor(new bytes.Reader(data), [])
		r.dict.init(1 << bits, [])
		let out byte[]
		let buf byte[]
		buf.len(8192)
		for {
			let n = r.read(buf) onerror (e error) {
				fail e unless e.message == "EOF"
				recover 0
			}
			break when n == 0
			out = out + buf[0:n]
		}
		return out
	}

	// echoed is `n` bytes with no repeats in them, followed by the same
	// bytes again: the only matches reach back n bytes.
	internal def echoed(n int) byte[] {
		let out byte[]
		out.len(2 * n)
		let state = 12345
		for let i = 0; i < n; i++ {
			state = (state * 1103515245 + 12345) % 2147483648
			out[i] = byte((state >> 16) & 0xff)
			out[n + i] = out[i]
		}
		return out
	}

	check "Flate" {
		@test()
		def keepsMatchesWithinTheWindow() !none {
			// Matches 600 bytes back fit no 512-byte window.
			let data = echoed(600)
			for let level in [int(Level.BestSpeed), int(Level.DefaultCompression), int(Level.BestCompression)] {
				let narrow = new Sink()
				let limited = new Writer(narrow, level, none, 9)
				try limited.write(data)
				try limited.close()
				let back = try inflateWithin(narrow.data, 9)
				fail "level {level}: {narrow.data.len()} bytes inflate to {back.len()} through a 512-byte window" when back.hex() != data.hex()

				let wide = new Sink()
				let free = new Writer(wide, level)
				try free.write(data)
				try free.close()
				assert wide.data.len() < narrow.data.len()
				let refused = false
				inflateWithin(wide.data, 9) onerror (err error) {
					refused = true
					recover []
				}
				assert refused
				assert (try inflateWithin(wide.data, 15)).hex() == data.hex()
			}
			return none
		}

		@test()
		def roundTripsEverySizeAndLevel() !none {
			// 65537 and up is more than the window takes in one go: the block
			// that spans the slide has no stored form to fall back on.
			for let (_, level) in [int(Level.HuffmanOnly), int(Level.DefaultCompression), 0, 1, 2, 6, 9] {
				for let (_, size) in [0, 1, 16, 127, 128, 65535, 65536, 65537, 74000, 200000] {
					let input = sample(size)
					let sink = new Sink()
					let w = new Writer(sink, level)
					try w.write(input)
					try w.close()
					let output = try inflateAll(sink.data)
					fail "level {level} size {size}: {sink.data.len()} bytes inflate to {output.len()}" when output.len() != size || output.hex() != input.hex()
					fail "level {level} size {size}: grew to {sink.data.len()}" when level > 0 && size >= 1024 && sink.data.len() >= size / 2
				}
			}
			return none
		}

		@test()
		def flushesKeepTheHistory() !none {
			// Every flush leaves a decodable prefix, and above level 1 a repeat
			// of an earlier write costs a few bytes.
			let piece = sample(300)
			for let (_, level) in [1, 6] {
				let sink = new Sink()
				let w = new Writer(sink, level)
				let sizes int[] = []
				let before = 0
				for let i = 0; i < 3; i++ {
					try w.write(piece)
					try w.flush()
					sizes.push(sink.data.len() - before)
					before = sink.data.len()
				}
				try w.write(sample(70000))
				try w.close()
				let output = try inflateAll(sink.data)
				assert output.len() == 900 + 70000
				assert output[0:300].hex() == piece.hex() && output[600:900].hex() == piece.hex()
				fail "level {level}: flush sizes {sizes[0]}, {sizes[1]}, {sizes[2]}" when level > 1 && sizes[1] * 4 > sizes[0]
			}
			return none
		}

		@test()
		def presetDictionaries() !none {
			let dict = sample(2000)
			let input = sample(2500)
			let sink = new Sink()
			let w = new Writer(sink, 6, dict)
			try w.write(input)
			try w.close()
			let plain = new Sink()
			let bare = new Writer(plain, 6)
			try bare.write(input)
			try bare.close()
			assert sink.data.len() < plain.data.len()
			assert (try inflateAll(sink.data, dict)).hex() == input.hex()
			// Reset starts a new stream with the same dictionary.
			let again = new Sink()
			w.reset(again)
			try w.write(input)
			try w.close()
			let redone = try inflateAll(again.data, dict)
			fail "after reset: {again.data.len()} bytes against {sink.data.len()}, inflate to {redone.len()}, equal {redone.hex() == input.hex()}" when again.data.hex() != sink.data.hex()
			return none
		}

		@test()
		def refusesCorruptStreams() !none {
			for let (_, bad) in [byte[0x07], byte[0x00, 0x05, 0x00, 0x00, 0x00], byte[0xff, 0xff, 0xff, 0xff]] {
				let outcome = "inflated"
				inflateAll(bad) onerror (err error) {
					outcome = "refused"
					recover []
				}
				fail "{bad.hex()} was accepted" when outcome != "refused"
			}
			return none
		}
	}
}
