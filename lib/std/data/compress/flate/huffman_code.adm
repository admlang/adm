partial module std.data.compress.flate {
	use std.math

	internal const maxBitsLimit = 16

	// A code and its bit length, as `code | len << 16`: a value, so tables of
	// them are plain arrays rebuilt per block without allocating.
	internal type hcode = uint32

	internal def hcodeOf(code uint16, len uint16) hcode {
		return uint32(code) | uint32(len) << 16
	}

	internal def hcodeLen(c hcode) uint32 {
		return c >> 16
	}

	// A literal and its frequency as one sort key, `freq << 16 | literal`:
	// ascending keys order by frequency, then literal.
	internal def literalNode(literal int, freq int32) int64 {
		return int64(freq) << 16 | int64(literal)
	}

	internal def nodeLiteral(node int64) int {
		return int(node & 0xFFFF)
	}

	internal def nodeFreq(node int64) int32 {
		return int32(node >> 16)
	}

	internal type huffmanEncoder {
		codes        hcode[]
		bitCount     int32[]
		// Scratch reused by every `generate`: the nodes (with a sentinel
		// after them), each level's state and its leaf counts (a row of
		// maxBitsLimit + 1 per level).
		nodes        int64[]
		levelOf      int32[]
		lastFreq     int32[]
		nextCharFreq int32[]
		nextPairFreq int32[]
		needed       int32[]
		leafCounts   int32[]

		def new(size int) {
			bitCount.len(maxBitsLimit + 1)
			bitCount.fill(0)
			codes.len(size)
			codes.fill(0)
			levelOf.len(maxBitsLimit + 1)
			lastFreq.len(maxBitsLimit + 1)
			nextCharFreq.len(maxBitsLimit + 1)
			nextPairFreq.len(maxBitsLimit + 1)
			needed.len(maxBitsLimit + 1)
			leafCounts.len((maxBitsLimit + 1) * (maxBitsLimit + 1))
		}

		def bitLength(freq int32[]) int {
			let total int
			for let (i, f) in freq {
				total += int(f) * int(hcodeLen(codes[i])) unless f == 0
			}
			return total
		}

		def clone() huffmanEncoder {
			let h = new huffmanEncoder(codes.len())
			codes.copy(h.codes)
			return h
		}

		// The number of literals given each bit length (index 1 up to
		// maxBits) for the `n` nodes sorted by frequency, with the sentinel
		// at `nodes[n]`.
		def bitCounts(n int32, maxBits int32) !int32[] {
			expects {
				assert maxBits < maxBitsLimit onerror fail "flate: maxBits too large"
			}
			let list = nodes
			let levelOf = self.levelOf
			let lastFreq = self.lastFreq
			let nextCharFreq = self.nextCharFreq
			let nextPairFreq = self.nextPairFreq
			let needed = self.needed
			let leafCounts = self.leafCounts
			let row = maxBitsLimit + 1

			maxBits = n - 1 when maxBits > n - 1

			levelOf.fill(0)
			lastFreq.fill(0)
			nextCharFreq.fill(0)
			nextPairFreq.fill(0)
			needed.fill(0)
			leafCounts.fill(0)

			for let level int32 = 1; level <= maxBits; level++ {
				let l = int(level)
				levelOf[l] = level
				lastFreq[l] = nodeFreq(list[1])
				nextCharFreq[l] = nodeFreq(list[2])
				nextPairFreq[l] = nodeFreq(list[0]) + nodeFreq(list[1])
				leafCounts[l * row + l] = 2
				if level == 1 {
					nextPairFreq[l] = math.MAX_INT32
				}
			}

			needed[int(maxBits)] = 2 * n - 4
			let level = int(maxBits)
			for {
				let nextPair = nextPairFreq[level]
				let nextChar = nextCharFreq[level]
				if nextPair == math.MAX_INT32 && nextChar == math.MAX_INT32 {
					needed[level] = 0
					nextPairFreq[level + 1] = math.MAX_INT32
					level++
					continue
				}

				let prevFreq = lastFreq[level]
				if nextChar < nextPair {
					let nn = leafCounts[level * row + level] + 1
					lastFreq[level] = nextChar
					leafCounts[level * row + level] = nn
					nextCharFreq[level] = nodeFreq(list[int(nn)])
				} else {
					lastFreq[level] = nextPair
					// Take the leaf counts from the level below, except that
					// counts[level] stays as it is.
					for let k = 0; k < level; k++ {
						leafCounts[level * row + k] = leafCounts[(level - 1) * row + k]
					}
					needed[level - 1] = 2
				}

				needed[level]--
				if needed[level] == 0 {
					if levelOf[level] == maxBits {
						break
					}
					nextPairFreq[level + 1] = prevFreq + lastFreq[level]
					level++
				} else {
					for needed[level - 1] > 0 {
						level--
					}
				}
			}

			let top = int(maxBits) * row
			if leafCounts[top + int(maxBits)] != n {
				fail "flate: internal error"
			}
			let bc = bitCount[:maxBits + 1]
			let bits = 1
			for let lvl = int(maxBits); lvl > 0; lvl-- {
				bc[bits] = leafCounts[top + lvl] - leafCounts[top + lvl - 1]
				bits++
			}
			return bc
		}

		// Assigns codes to the first `count` nodes (sorted by frequency):
		// the least frequent get the longest codes, each length's literals
		// in literal order.
		def assignEncodingAndSize(bitCount int32[], count int) {
			let code uint16 = 0
			let end = count
			for let (n, bits) in bitCount {
				code <<= 1
				continue when n == 0 || bits == 0
				let start = end - int(bits)
				let chunk = nodes[start:end].sort((a, b) => (a & 0xFFFF) < (b & 0xFFFF))
				for let node in chunk {
					codes[nodeLiteral(node)] = hcodeOf(reverseBits(code, byte(n)), uint16(n))
					code++
				}
				end = start
			}
		}

		def generate(freq int32[], maxBits int32) !none {
			nodes.len(freq.len() + 1)
			let count = 0
			for let (i, f) in freq {
				if f != 0 {
					nodes[count] = literalNode(i, f)
					count++
				} else {
					codes[i] = codes[i] & 0xFFFF
				}
			}

			if count <= 2 {
				for let i = 0; i < count; i++ {
					codes[nodeLiteral(nodes[i])] = hcodeOf(uint16(i), 1)
				}
				return none
			}

			nodes.len(count)
			nodes.sort((a, b) => a < b)
			// The sentinel: a node no frequency reaches.
			nodes.push(literalNode(0xFFFF, math.MAX_INT32))

			let counts = try bitCounts(int32(count), maxBits)
			assignEncodingAndSize(counts, count)
		}
	}

	// Generates a HuffmanCode corresponding to the fixed literal table.
	internal def generateFixedLiteralEncoding() huffmanEncoder {
		let h = new huffmanEncoder(maxNumLit)
		for let ch uint16 = 0; ch < maxNumLit; ch++ {
			let bits, size uint16
			switch {
				case ch < 144:
					bits = ch + 48
					size = 8
				case ch < 256:
					bits = ch + 400 - 144
					size = 9
				case ch < 280:
					bits = ch - 256
					size = 7
				default:
					bits = ch + 192 - 280
					size = 8
			}
			h.codes[int(ch)] = hcodeOf(reverseBits(bits, byte(size)), size)
		}
		return h
	}

	internal def generateFixedOffsetEncoding() huffmanEncoder {
		let h = new huffmanEncoder(30)
		for let (i, _) in h.codes {
			h.codes[i] = hcodeOf(reverseBits(uint16(i), 5), 5)
		}
		return h
	}

	internal let fixedLiteralEncodingCache ?huffmanEncoder = none
	internal let fixedOffsetEncodingCache ?huffmanEncoder = none

	// The fixed encodings, built once and shared: callers only read them.
	internal def fixedLiteralEncoding() huffmanEncoder {
		if fixedLiteralEncodingCache is none {
			let built = generateFixedLiteralEncoding()
			fixedLiteralEncodingCache = built
			return built
		}
		return fixedLiteralEncodingCache
	}

	internal def fixedOffsetEncoding() huffmanEncoder {
		if fixedOffsetEncodingCache is none {
			let built = generateFixedOffsetEncoding()
			fixedOffsetEncodingCache = built
			return built
		}
		return fixedOffsetEncodingCache
	}
}
