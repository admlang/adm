partial module std.data.compress.flate {
	use std.math

	internal const maxBitsLimit = 16

	internal struct hcode {
		code, len uint16
	}

	internal struct literalNode {
		literal uint16
		freq    int32
	}

	internal struct levelInfo {
		level        int32
		lastFreq     int32
		nextCharFreq int32
		nextPairFreq int32
		needed       int32
	}

	internal def maxNode() literalNode {
		return literalNode{literal: uint16(0).MAX(), freq: math.MAX_INT32}
	}

	internal def sortByLiteral(nodes literalNode[]) literalNode[] {
		return nodes.sort((a, b literalNode) => a.literal < b.literal)
	}

	internal def sortByFreq(nodes literalNode[]) literalNode[] {
		return nodes.sort(def (a, b literalNode) bool {
			if a.freq == b.freq {
				return a.literal < b.literal
			}
			return a.freq < b.freq
		})
	}

	internal type huffmanEncoder {
		codes     hcode[]
		freqcache literalNode[]
		bitCount  int32[]

		def new(size int) {
			bitCount.len(maxBitsLimit + 1)
			bitCount.fill(0)
			codes.len(size)
			for let i = 0; i < size; i++ {
				codes[i] = hcode{}
			}
			freqcache = []
		}

		def bitLength(freq int32[]) int {
			let total int
			for let (i, f) in freq {
				total += int(f) * int(codes[i].len) unless f == 0
			}
			return total
		}

		def clone() huffmanEncoder {
			let h = new huffmanEncoder(codes.len())
			codes.copy(h.codes)
			return h
		}

		def bitCounts(list literalNode[], maxBits int32) !int32[] {
			expects {
				assert maxBits < maxBitsLimit onerror fail "flate: maxBits too large"
			}

			let n = int32(list.len())
			let withSentinel literalNode[]
			withSentinel.len(int(n + 1))
			list.copy(withSentinel[:int(n)])
			withSentinel[int(n)] = maxNode()
			list = withSentinel

			maxBits = n - 1 when maxBits > n - 1

			let levels levelInfo[]
			levels.len(maxBitsLimit + 1)
			for let i = 0; i < int(maxBitsLimit) + 1; i++ {
				levels[i] = levelInfo{}
			}

			let leafCounts int32[][]
			leafCounts.len(maxBitsLimit + 1)
			for let i = 0; i < int(maxBitsLimit) + 1; i++ {
				let row int32[]
				row.len(maxBitsLimit + 1)
				row.fill(0)
				leafCounts[i] = row
			}

			for let level int32 = 1; level <= maxBits; level++ {
				levels[int(level)] = levelInfo{
					level: level,
					lastFreq: list[1].freq,
					nextCharFreq: list[2].freq,
					nextPairFreq: list[0].freq + list[1].freq,
				}
				leafCounts[int(level)][int(level)] = 2
				if level == 1 {
					levels[int(level)].nextPairFreq = math.MAX_INT32
				}
			}

			levels[int(maxBits)].needed = 2 * n - 4
			let level = int(maxBits)
			for {
				let nextPair = levels[level].nextPairFreq
				let nextChar = levels[level].nextCharFreq
				if nextPair == math.MAX_INT32 && nextChar == math.MAX_INT32 {
					levels[level].needed = 0
					levels[level + 1].nextPairFreq = math.MAX_INT32
					level++
					continue
				}

				let prevFreq = levels[level].lastFreq
				if nextChar < nextPair {
					let nn = leafCounts[level][level] + 1
					levels[level].lastFreq = nextChar
					leafCounts[level][level] = nn
					levels[level].nextCharFreq = list[int(nn)].freq
				} else {
					levels[level].lastFreq = nextPair
					// Take the leaf counts from the level below, except that
					// counts[level] stays as it is. `copy` reads from the
					// receiver, so the lower level is the receiver here.
					leafCounts[level - 1][:level].copy(leafCounts[level][:level])
					levels[level - 1].needed = 2
				}

				levels[level].needed--
				if levels[level].needed == 0 {
					if levels[level].level == maxBits {
						break
					}
					levels[level + 1].nextPairFreq = prevFreq + levels[level].lastFreq
					level++
				} else {
					for levels[level - 1].needed > 0 {
						level--
					}
				}
			}

			let leaf = leafCounts[int(maxBits)][int(maxBits)]
			if leaf != n {
				fail "flate: internal error"
			}
			let bc = bitCount[:maxBits + 1]
			let bits = 1
			let counts = leafCounts[int(maxBits)]
			for let lvl = maxBits; lvl > 0; lvl-- {
				bc[bits] = counts[int(lvl)] - counts[int(lvl - 1)]
				bits++
			}
			return bc
		}

		def assignEncodingAndSize(bitCount int32[], list literalNode[]) {
			let code uint16 = 0
			for let (n, bits) in bitCount {
				code <<= 1
				continue when n == 0 || bits == 0
				let start = list.len() - int(bits)
				let chunk = sortByLiteral(list[start:])
				for let (_, node) in chunk {
					codes[int(node.literal)] = hcode{code: reverseBits(code, byte(n)), len: uint16(n)}
					code++
				}
				list = list[:start]
			}
		}

		def generate(freq int32[], maxBits int32) !none {
			let list literalNode[] = []
			list.len(freq.len() + 1)
			let count = 0
			for let (i, f) in freq {
				if f != 0 {
					list[count] = literalNode{literal: uint16(i), freq: f}
					count++
				} else {
					codes[i].len = 0
				}
			}

			list = list[:count]
			if count <= 2 {
				for let (i, node) in list {
					codes[int(node.literal)] = hcode{code: uint16(i), len: 1}
				}
				return none
			}

			list = sortByFreq(list)

			let counts = try bitCounts(list, maxBits)
			assignEncodingAndSize(counts, list[:count])
		}
	}

	// Generates a HuffmanCode corresponding to the fixed literal table.
	internal def generateFixedLiteralEncoding() huffmanEncoder {
		let h = new huffmanEncoder(maxNumLit)
		for let ch uint16 = 0; ch < maxNumLit; ch++ {
			let bits, size uint16
			switch {
				case ch < 144:
					bits = ch + 48
					size = 8
				case ch < 256:
					bits = ch + 400 - 144
					size = 9
				case ch < 280:
					bits = ch - 256
					size = 7
				default:
					bits = ch + 192 - 280
					size = 8
			}
			h.codes[int(ch)] = hcode{code: reverseBits(bits, byte(size)), len: size}
		}
		return h
	}

	internal def generateFixedOffsetEncoding() huffmanEncoder {
		let h = new huffmanEncoder(30)
		for let (i, _) in h.codes {
			h.codes[i] = hcode{code: reverseBits(uint16(i), 5), len: 5}
		}
		return h
	}

	internal let fixedLiteralEncodingCache ?huffmanEncoder = none
	internal let fixedOffsetEncodingCache ?huffmanEncoder = none

	internal def fixedLiteralEncoding() huffmanEncoder {
		if fixedLiteralEncodingCache is none {
			let built = generateFixedLiteralEncoding()
			fixedLiteralEncodingCache = built
			return built.clone()
		}
		let enc = fixedLiteralEncodingCache
		return enc.clone()
	}

	internal def fixedOffsetEncoding() huffmanEncoder {
		if fixedOffsetEncodingCache is none {
			let built = generateFixedOffsetEncoding()
			fixedOffsetEncodingCache = built
			return built.clone()
		}
		let enc = fixedOffsetEncodingCache
		return enc.clone()
	}
}
