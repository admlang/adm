partial module std.data.compress.flate {
	use (
		std.io
	)

	internal const (
		maxCodeLen = 16
		maxNumLit  = 286
		maxNumDist = 30
		numCodes   = 19
	)

	internal const (
		huffmanChunkBits  = 9
		huffmanNumChunks  = 1 << huffmanChunkBits
		huffmanCountMask  = 15
		huffmanValueShift = 4
	)

	internal type huffmanDecoder {
		min      int
		chunks   uint32[]
		links    uint32[][]
		linkMask uint32

		def new() {
			chunks.len(huffmanNumChunks)
			chunks.fill(0)
			links.len(0)
			linkMask = 0
			min = 0
		}

		def reset() {
			min = 0
			chunks.fill(0)
			links.len(0)
			linkMask = 0
		}

		def init(lengths int[]) bool {
			if min != 0 {
				reset()
			}

			let count int[]
			count.len(maxCodeLen)
			count.fill(0)
			let minLen = 0
			let maxLen = 0
			for let (_, n) in lengths {
				continue when n == 0
				minLen = n when minLen == 0 || n < minLen
				maxLen = n when n > maxLen
				count[n] = count[n] + 1
			}

			if maxLen == 0 {
				return true
			}

			let code = 0
			let nextcode int[]
			nextcode.len(maxCodeLen)
			nextcode.fill(0)
			for let i = minLen; i <= maxLen; i++ {
				code <<= 1
				nextcode[i] = code
				code += count[i]
			}

			if code != (1 << uint(maxLen)) && !(code == 1 && maxLen == 1) {
				return false
			}

			min = minLen
			if maxLen > huffmanChunkBits {
				let numLinks = 1 << (uint(maxLen) - huffmanChunkBits)
				linkMask = uint32(numLinks - 1)

				let link = nextcode[huffmanChunkBits + 1] >> 1
				links.len(huffmanNumChunks - link)
				for let j = uint(link); j < huffmanNumChunks; j++ {
					let reverse = int(reverse16(uint16(j)))
					reverse >>= uint(16 - huffmanChunkBits)
					let off = j - uint(link)
					chunks[reverse] = uint32(int(off) << huffmanValueShift | (huffmanChunkBits + 1))
					// Indexing yields a value, not a slot: size the row here and
					// store it back, as the code below already does.
					let row uint32[]
					row.len(numLinks)
					row.fill(0)
					links[int(off)] = row
				}
			}

			for let (i, n) in lengths {
				continue when n == 0
				let codeVal = nextcode[n]
				nextcode[n] = nextcode[n] + 1
				let chunk = uint32((i << huffmanValueShift) | n)
				let reverse = int(reverse16(uint16(codeVal)))
				reverse >>= uint(16 - n)
				if n <= huffmanChunkBits {
					for let off = reverse; off < chunks.len(); off += 1 << uint(n) {
						chunks[off] = chunk
					}
				} else {
					let j = reverse & (huffmanNumChunks - 1)
					let value = chunks[j] >> huffmanValueShift
					let linktab = links[int(value)]
					reverse >>= huffmanChunkBits
					for let off = reverse; off < linktab.len(); off += 1 << uint(n - huffmanChunkBits) {
						linktab[off] = chunk
					}
					links[int(value)] = linktab
				}
			}

			return true
		}

		def clone() huffmanDecoder {
			let h = new huffmanDecoder()
			h.min = min
			h.linkMask = linkMask
			chunks.copy(h.chunks)
			h.links.len(links.len())
			for let i = 0; i < links.len(); i++ {
				let row = links[i]
				let dstRow uint32[]
				dstRow.len(row.len())
				row.copy(dstRow)
				h.links[i] = dstRow
			}
			return h
		}
	}

	internal let fixedHuffmanDecoderCache ?huffmanDecoder = none

	internal def buildFixedHuffmanDecoder() huffmanDecoder {
		if fixedHuffmanDecoderCache is none {
			let h = new huffmanDecoder()
			let bits int[]
			bits.len(288)
			bits.fill(0)
			for let i = 0; i < 144; i++ {
				bits[i] = 8
			}
			for let i = 144; i < 256; i++ {
				bits[i] = 9
			}
			for let i = 256; i < 280; i++ {
				bits[i] = 7
			}
			for let i = 280; i < 288; i++ {
				bits[i] = 8
			}
			h.init(bits)
			fixedHuffmanDecoderCache = h
			return h.clone()
		}
		let dec = fixedHuffmanDecoderCache
		return dec.clone()
	}

	internal const codeOrder = int[16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]

	internal const (
		stepNextBlock    = 0
		stepHuffmanBlock = 1
		stepCopyData     = 2
	)

	internal const (
		stateInit = 0
		stateDict = 1
	)

	internal type decompressor {
		r       io.Reader
		roffset int64

		b  uint32
		nb uint

		h1 huffmanDecoder
		h2 huffmanDecoder

		bits     int[]
		codebits int[]

		dict dictDecoder

		buf     byte[]
		byteBuf byte[]
		bytePos int
		byteLen int

		stepper   int
		stepState int
		final     bool
		err       ?error
		toRead    byte[]
		copyLen   int
		copyDist  int
		useFixed  bool

		def new(r io.Reader, dict byte[]) {
			reset(r, dict)
		}

		def reset(r io.Reader, dict byte[]) {
			self.r = r
			roffset = int64(0)
			b = 0
			nb = 0
			err = none
			h1.new()
			h2.new()
			toRead.len(0)
			copyLen = 0
			copyDist = 0
			final = false
			stepper = stepNextBlock
			stepState = stateInit
			useFixed = false

			if bits.len() == 0 {
				bits.len(maxNumLit + maxNumDist)
			}
			if codebits.len() == 0 {
				codebits.len(numCodes)
			}
			if buf.len() == 0 {
				buf.len(4)
			}
			if byteBuf.len() == 0 {
				byteBuf.len(4096)
			}
			bytePos = 0
			byteLen = 0

			self.dict.init(maxMatchOffset, dict)
		}

		def read(b byte[]) !int {
			for {
				if toRead.len() > 0 {
					let n = toRead.copy(b)
					toRead = toRead[n:]
					if toRead.len() == 0 && !(err is none) {
						if (err is error) {
							if err.message == "EOF" {
								return n
							}
							fail err
						}
					}
					return n
				}
				if !(err is none) {
					fail err
				}
				//fail err unless err is none
				step()
				if !(err is none) && toRead.len() == 0 {
					toRead = dict.readFlush()
				}
			}
			return -1
		}

		def close() !none {
			fail err unless err is none
			return none
		}

		def step() {
			switch stepper {
				case stepNextBlock:
					nextBlock()
				case stepHuffmanBlock:
					huffmanBlock()
				case stepCopyData:
					copyData()
			}
		}

		def nextBlock() {
			for nb < 3 {
				moreBits()
				return unless err is none
			}
			final = (b & 1) == 1
			b >>= 1
			let typ = b & 3
			b >>= 2
			nb -= 3
			switch typ {
				case 0:
					dataBlock()
				case 1:
					useFixed = true
					huffmanBlock()
				case 2:
					readHuffman()
					return unless err is none
					useFixed = false
					huffmanBlock()
				default:
					err = Error{message: "flate: corrupt input"}
			}
		}

		def readHuffman() {
			for nb < 14 {
				moreBits()
				return unless err is none
			}
			let nlit = int(b & 0x1F) + 257
			if nlit > maxNumLit {
				err = Error{message: "flate: corrupt input"}
				return
			}
			b >>= 5
			let ndist = int(b & 0x1F) + 1
			if ndist > maxNumDist {
				err = Error{message: "flate: corrupt input"}
				return
			}
			b >>= 5
			let nclen = int(b & 0xF) + 4
			b >>= 4
			nb -= 14

			for let i = 0; i < nclen; i++ {
				for nb < 3 {
					moreBits()
					return unless err is none
				}
				codebits[codeOrder[i]] = int(b & 0x7)
				b >>= 3
				nb -= 3
			}
			for let i = nclen; i < codeOrder.len(); i++ {
				codebits[codeOrder[i]] = 0
			}

			if !h1.init(codebits) {
				err = Error{message: "flate: corrupt input"}
				return
			}

			let i = 0
			let n = nlit + ndist
			for i < n {
				let x = huffSym(h1) onerror (e error) {
					err = e
					recover -1
				}
				return unless err is none
				if x < 16 {
					bits[i] = x
					i++
					continue
				}
				let rep int
				let nbExtra uint
				let bval int
				switch x {
					case 16:
						rep = 3
						nbExtra = 2
						if i == 0 {
							err = Error{message: "flate: corrupt input"}
							return
						}
						bval = bits[i - 1]
					case 17:
						rep = 3
						nbExtra = 3
						bval = 0
					case 18:
						rep = 11
						nbExtra = 7
						bval = 0
					default:
						err = Error{message: "flate: internal error"}
						return
				}

				for nb < nbExtra {
					moreBits()
					return unless err is none
				}
				rep += int(b & uint32((1 << nbExtra) - 1))
				b >>= nbExtra
				nb -= nbExtra
				if i + rep > n {
					err = Error{message: "flate: corrupt input"}
					return
				}
				for let j = 0; j < rep; j++ {
					bits[i] = bval
					i++
				}
			}

			if !h1.init(bits[:nlit]) || !h2.init(bits[nlit:nlit + ndist]) {
				err = Error{message: "flate: corrupt input"}
				return
			}

			let eob = bits[endBlockMarker]
			if h1.min < eob {
				h1.min = eob
			}
		}

		def huffmanBlock() {
			for {
				if stepState == stateDict {
					let cnt = dict.tryWriteCopy(copyDist, copyLen)
					cnt = dict.writeCopy(copyDist, copyLen) when cnt == 0
					copyLen -= cnt
					if dict.availWrite() == 0 || copyLen > 0 {
						toRead = dict.readFlush()
						stepper = stepHuffmanBlock
						stepState = stateDict
						return
					}
					stepState = stateInit
					continue
				}

				let v = huffSym(useFixed ?? (buildFixedHuffmanDecoder(), h1)) onerror (e error) {
					err = e
					recover -1
				}
				return unless err is none
				if v < 256 {
					dict.writeByte(byte(v))
					if dict.availWrite() == 0 {
						toRead = dict.readFlush()
						stepper = stepHuffmanBlock
						stepState = stateInit
						return
					}
					continue
				}
				if v == endBlockMarker {
					finishBlock()
					return
				}

				let n uint
				let length int
				switch {
					case v < 265:
						length = v - (257 - 3)
						n = 0
					case v < 269:
						length = v * 2 - (265 * 2 - 11)
						n = 1
					case v < 273:
						length = v * 4 - (269 * 4 - 19)
						n = 2
					case v < 277:
						length = v * 8 - (273 * 8 - 35)
						n = 3
					case v < 281:
						length = v * 16 - (277 * 16 - 67)
						n = 4
					case v < 285:
						length = v * 32 - (281 * 32 - 131)
						n = 5
					case v < maxNumLit:
						length = 258
						n = 0
					default:
						err = Error{message: "flate: corrupt input"}
						return
				}

				if n > 0 {
					for nb < n {
						moreBits()
						return unless err is none
					}
					length += int(b & uint32((1 << n) - 1))
					b >>= n
					nb -= n
				}

				let dist int
				if useFixed {
					for nb < 5 {
						moreBits()
						return unless err is none
					}
					dist = int(reverse8(byte((b & 0x1F) << 3)))
					b >>= 5
					nb -= 5
				} else {
					dist = huffSym(h2) onerror (e error) {
						err = e;
						recover -1
					}
					return unless err is none
				}

				switch {
					case dist < 4:
						dist++
					case dist < maxNumDist:
						let nbExtra = uint(dist - 2) >> 1
						let extra = (dist & 1) << nbExtra
						for nb < nbExtra {
							moreBits()
							return unless err is none
						}
						extra |= int(b & uint32((1 << nbExtra) - 1))
						b >>= nbExtra
						nb -= nbExtra
						dist = (1 << (nbExtra + 1)) + 1 + extra
					default:
						err = Error{message: "flate: corrupt input"}
						return
				}

				if dist > dict.histSize() {
					err = Error{message: "flate: corrupt input"}
					return
				}

				copyLen = length
				copyDist = dist
				stepState = stateDict
			}
		}

		def dataBlock() {
			nb = 0
			b = 0

			let nr = readFull(buf) onerror (e error) {
				err = e
				recover -1
			}
			return unless err is none
			roffset += int64(nr)
			let n = int(buf[0]) | int(buf[1]) << 8
			let nn = int(buf[2]) | int(buf[3]) << 8

			if uint16(nn) != uint16(^n) {
				err = Error{message: "flate: corrupt input"}
				return
			}

			if n == 0 {
				toRead = dict.readFlush()
				finishBlock()
				return
			}

			copyLen = n
			copyData()
		}

		def copyData() {
			let out = dict.writeSlice()
			out = out[:copyLen] when out.len() > copyLen
			let cnt = readFull(out) onerror (e error) {
				err = e
				recover -1
			}
			return unless err is none
			roffset += int64(cnt)
			copyLen -= cnt
			dict.writeMark(cnt)

			if dict.availWrite() == 0 || copyLen > 0 {
				toRead = dict.readFlush()
				stepper = stepCopyData
				return
			}
			finishBlock()
		}

		def finishBlock() {
			if final {
				if dict.availRead() > 0 {
					toRead = dict.readFlush()
				}
				err = Error{message: "EOF"}
			}
			stepper = stepNextBlock
		}

		def readByte() !byte {
			if bytePos >= byteLen {
				let n = r.read(byteBuf[:1]) onerror (e error) {
					fail e
				}
				fail Error{message: "EOF"} when n == 0
				bytePos = 0
				byteLen = n
			}
			let c = byteBuf[bytePos]
			bytePos++
			return c
		}

		def readFull(out byte[]) !int {
			let total = 0
			for total < out.len() || !(err is none) {
				if bytePos >= byteLen {
					let need = out.len() - total
					let toRead = byteBuf.len()
					toRead = need when need < toRead
					let n = r.read(byteBuf[:toRead]) onerror (e error) {
						fail e
					}
					fail Error{message: "EOF"} when n == 0
					bytePos = 0
					byteLen = n
				}
				let remaining = byteLen - bytePos
				let need = out.len() - total
				let toCopy = need
				toCopy = remaining when remaining < toCopy
				let src = byteBuf[bytePos:bytePos + toCopy]
				let dst = out[total:total + toCopy]
				src.copy(dst)
				bytePos += toCopy
				total += toCopy
			}
			return total
		}

		def noEOF(e error) {
			if e.message == "EOF" {
				err = Error{message: "unexpected EOF"}
				return
			}
			err = e
		}

		def moreBits() {
			let out bool
			let c = readByte() onerror (e error) {
				noEOF(e)
				recover -1
			}
			return unless err is none

			roffset++
			b |= uint32(c) << nb
			nb += 8
		}

		def huffSym(h huffmanDecoder) !int {
			let n = uint(h.min)
			let nbLocal = nb
			let bLocal = b
			for {
				for nbLocal < n {
					let c = readByte() onerror (e error) {
						b = bLocal
						nb = nbLocal
						fail e
					}
					roffset++
					bLocal |= uint32(c) << (nbLocal & 31)
					nbLocal += 8
				}
				let chunk = h.chunks[int(bLocal & uint32(huffmanNumChunks - 1))]
				n = uint(chunk & huffmanCountMask)
				if n > huffmanChunkBits {
					chunk = h.links[int(chunk >> huffmanValueShift)][int((bLocal >> huffmanChunkBits) & h.linkMask)]
					n = uint(chunk & huffmanCountMask)
				}
				if n <= nbLocal {
					if n == 0 {
						b = bLocal
						nb = nbLocal
						let er = Error{message: "flate: corrupt input"}
						err = er
						fail er
					}
					b = bLocal >> (n & 31)
					nb = nbLocal - n
					return int(chunk >> huffmanValueShift)
				}
			}
			return -1
		}
	}

	type Reader {
		internal d decompressor

		def new (r io.Reader, dict byte[] = []) {
			buildFixedHuffmanDecoder()
			d = new decompressor(r, dict)
		}

		def read(b byte[]) !int {
			return try d.read(b)
		}

		def readByte() !byte {
			return try d.readByte()
		}

		def reset(r io.Reader, dict byte[] = []) {
			d.reset(r, dict)
		}

		def close() !none {
			return try d.close()
		}
	}
}
