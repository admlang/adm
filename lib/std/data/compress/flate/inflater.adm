partial module std.data.compress.flate {
	// Inflater decompresses a DEFLATE stream that arrives in pieces, as a
	// connection that compresses its messages with a flush after each
	// sends it (SSH's `zlib`, MCCP): `feed` takes the next piece and
	// returns what it completes. The pieces may split the stream anywhere,
	// even inside a Huffman code.
	//
	// ```
	// let inflater = new flate.Inflater()
	// for let packet in packets {
	// 	handle(try inflater.feed(packet))
	// }
	// ```
	type Inflater {
		internal d decompressor

		// A decompressor primed with the preset dictionary the stream was
		// compressed with, when there is one.
		def new(dict byte[] = []) {
			buildFixedHuffmanDecoder()
			d = new decompressor(new noInput(), dict)
			d.pushed = true
		}

		// feed decodes `data` and returns every byte of output it
		// completes; after the final block, nothing. Fails when the stream
		// is corrupt.
		def feed(data byte[]) !byte[] {
			return try d.feed(data)
		}

		// Whether the final block has been decoded.
		def finished() bool {
			let e = d.err
			return !(e is none) && e.message == "EOF"
		}

		// The input after the final block, such as a container's
		// checksum; empty before it.
		def unused() byte[] {
			return finished() ?? (d.unused(), byte[])
		}
	}

	// The reader of a decompressor that is fed instead: it never reads.
	internal type noInput {
		def new() {}

		def read(p byte[]) !int {
			return 0
		}
	}
}
