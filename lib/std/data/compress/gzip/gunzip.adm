partial module std.data.compress.gzip {
	use (
		std.data.compress.flate
		std.io
		std.bytes
		std.time
		std.crypto.hash
	)

	// Reader decompresses gzip data read from an io.Reader: the header is
	// available after the first read, and with multistream set, concatenated
	// members are read as one stream.
	type Reader {
		header      Header
		multistream bool

		internal r            io.Reader
		internal br           bytes.BinaryReader
		internal decompressor flate.Reader
		internal size         uint32
		internal crc32        hash.CRC32
		internal hdrRead      bool

		def new(r io.Reader) {
			self.r = r

			crc32 = new hash.CRC32()
			br = new bytes.BinaryReader(r, hasher = crc32)
			decompressor = new flate.Reader(br)
		}

		// reset starts reading a new gzip stream from r.
		def reset(r io.Reader) {
			self.r = r

			hdrRead = false
			crc32.reset()
			br.reset(r, crc32)
			decompressor.reset(br)
			size = 0
		}

		internal def readHeader() !Header {
			br.reset(r, crc32)
			crc32.reset()

			let id1 = try br.readByte()
			let id2 = try br.readByte()
			let method = try br.readByte()

			fail "gzip: invalid header" when id1 != gzipID1 || id2 != gzipID2 || method != gzipDeflate

			let flag = try br.readByte()
			if let mtime = try br.read<uint32>(); mtime > 0 {
				header.modTime = time.fromUnixNs(mtime * 1000)
			}
			try br.readByte() // XFL byte
			header.os = try br.readByte()

			if flag & flagExtra != 0 {
				let l = try br.read<uint16>()
				header.extra = try br.read(int(l)) when l > 0
			}
			header.name = try br.readString() when flag & flagName != 0
			header.comment = try br.readString() when flag & flagComment != 0

			if flag & flagHdrCrc != 0 {
				let hcrc = try br.read<uint16>()
				fail "gzip: invalid header CRC" when hcrc != uint16(crc32.checksum)
			}

			crc32.reset()
			br.reset(r)
			decompressor.reset(br)
			hdrRead = true
			return header
		}

		// read decompresses into p and returns how many bytes it produced, 0 at the
		// end. Fails when the header or the data is corrupt, the checksum does not
		// match, or the underlying reader does.
		def read(p byte[]) !int {
			if !hdrRead {
				try readHeader()
			}
			let eof = false
			let n = decompressor.read(p) onerror (e error) {
				if e.message == "EOF" {
					eof = true
					recover 0
				}
				fail e
			}
			if n > 0 {
				size += uint32(n)
				crc32.write(p[:n])
				return n
			}
			if eof {
				let digest = try br.read<uint32>()
				let storeSize = try br.read<uint32>()
				let checksum = crc32.checksum ^ 0xFFFFFFFF
				fail "gzip: invalid data stream checksum" when digest != checksum || storeSize != size

				if !multistream {
					fail Error{message: "EOF"}
				}

				crc32.reset()
				size = 0
				hdrRead = false
				try readHeader()
				return read(p)
			}
			return n
		}

		// close releases the decompressor; it does not close the underlying reader.
		// Fails when the stream ended unfinished.
		def close() !none {
			return try decompressor.close()
		}
	}
}
