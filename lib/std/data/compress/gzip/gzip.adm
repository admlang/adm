partial module std.data.compress.gzip {
	use (
		std.data.compress.flate
		std.io
		std.bytes
		std.time
		std.crypto.hash
	)

	internal const (
		gzipID1     = 0x1f
		gzipID2     = 0x8b
		gzipDeflate = 8
		flagText    = 1 << 0
		flagHdrCrc  = 1 << 1
		flagExtra   = 1 << 2
		flagName    = 1 << 3
		flagComment = 1 << 4
	)

	// Level is how hard the compressor works: NoCompression stores the input as
	// is, BestSpeed is fastest, BestCompression smallest, and DefaultCompression
	// lets the encoder choose.
	enum Level {
		NoCompression = 0,
		BestSpeed = 1,
		BestCompression = 9,
		DefaultCompression = -1,
		HuffmanOnly = -2,
	}

	// Header is the gzip member header: the comment, extra field, modification
	// time, name and operating system it records.
	struct Header {
		comment string
		extra   byte[]
		modTime time.Time
		name    string
		os      byte
	}

	// Writer compresses what is written to it into a gzip member on an
	// io.Writer, writing the header first and the trailer on close.
	type Writer {
		header               Header
		internal w           io.Writer
		internal level       Level
		internal wroteHeader bool
		internal closed      bool
		internal buf         byte[]
		internal compressor  flate.Writer
		internal size        uint32
		internal err         ?error       = none
		internal crc32       hash.CRC32

		def new(w io.Writer, lvl Level = Level.DefaultCompression) {
			crc32 = new hash.CRC32()
			lvl = Level.DefaultCompression when (lvl < Level.HuffmanOnly || lvl > Level.BestCompression)
			init(w, lvl)
		}

		internal def init(w io.Writer, lvl Level) {
			crc32.reset()
			buf.len(10)
			buf[:] = 0

			header = Header{
				os: 0xFF,
				extra: byte[],
			}
			self.w = w
			level = lvl
			compressor = new flate.Writer(w, int(lvl))
		}

		// reset starts a new gzip member on w at the same level.
		def reset(w io.Writer) {
			init(w, level)
		}

		internal def writeBytes(b byte[]) !none {
			fail "gzip.Write: Extra data is too large" when b.len() > 0xFFFF
			uint16(b.len()).bytes().copy(buf)
			try w.write(buf[:2])
			try w.write(b)
		}

		internal def writeString(s string) !none {
			let needconv = false
			for let (_, v) in s {
				fail "gzip.Write: non-Latin-1 header string" when int(v) == 0 || int(v) > 0xFF
				needconv = true when int(v) > 0x7F
			}
			if needconv {
				let b byte[]
				b.cap(s.len())
				for let (i, v) in s {
					b += byte(v)
				}
				try w.write(b)
			} else {
				try w.write(s.bytes())
			}
			buf[0] = 0
			try w.write(buf[:1])
			return none
		}

		// write compresses p, writing the header first when needed, and returns how
		// many bytes were taken. Fails when the writer is closed, a previous write
		// failed, or the underlying writer does.
		def write(p byte[]) !int {
			fail err unless err is none
			let n int
			if !wroteHeader {
				wroteHeader = true
				buf[0] = gzipID1
				buf[1] = gzipID2
				buf[2] = gzipDeflate
				if header.extra.len() != 0 {
					buf[3] |= 0x04
				}
				if header.name != "" {
					buf[3] |= 0x08
				}
				if header.comment != "" {
					buf[3] |= 0x10
				}
				if header.modTime.after(time.fromUnixNs(0)) {
					(header.modTime.unixNs() / 1000).bytes().copy(buf[4:8])
				}
				if level == Level.BestCompression {
					buf[8] = 2
				} else if level == Level.BestSpeed {
					buf[8] = 4
				}
				buf[9] = header.os
				try w.write(buf[:10])
				if header.extra.len() > 0 {
					try writeBytes(header.extra)
				}
				if header.name != "" {
					try writeString(header.name)
				}
				if header.comment != "" {
					try writeString(header.comment)
				}
			}
			size += uint32(p.len())
			crc32.write(p)
			n = try compressor.write(p)
			return n
		}

		// flush pushes the data compressed so far to the underlying writer; a closed
		// writer is left as is. Fails when a previous write failed or the underlying
		// writer does.
		def flush() !none {
			fail err unless err is none
			return none when closed
			if !wroteHeader {
				try write([])
			}
			try compressor.flush()
			return none
		}

		// close finishes the member and writes the trailer with the checksum and
		// length; closing again does nothing. Fails when a previous write failed or
		// the underlying writer does.
		def close() !none {
			fail err unless err is none
			return none when closed
			closed = true
			if !wroteHeader {
				try write([])
			}
			try compressor.close()

			crc32.hash().reverse().copy(buf[:4])
			size.bytes().copy(buf[4:8])
			try w.write(buf[:8])
		}
	}

	check "GZip" {
		use std.testing

		@test()
		def testWriter() !none {
			let buf = new bytes.Buffer()
			let w = new Writer(buf)
			let n = w.write(byte[]("Hello, World!")) onerror (err error) {
				println("write error: {err}")
				fail err
			}
			assert n == 13
			try w.close()

			let compressed = buf.bytes()
			compressed += byte[0, 0, 0, 0, 0, 0, 0, 0, 0]

			let r = new Reader(new bytes.Reader(compressed))
			let decoded = new bytes.Buffer()
			n = try decoded.readFrom(r)
			assert string(decoded.bytes()) == "Hello, World!"
		}
	}
}
