partial module std.data.compress.lz4 {
	use (
		std.bytes
		std.data.encoding::(hexdecode)
		std.testing
	)

	// A buffer of the length with runs, repeats and noise in it.
	internal def sample(length int, seed int) byte[] {
		let out byte[] = []
		let state = uint32(seed * 2654435761 + 1)
		for out.len() < length {
			state = state * uint32(1664525) + uint32(1013904223)
			let pick = int((state >> 24) & uint32(0xFF))
			let run = int((state >> 8) & uint32(0x3F)) + 1
			if pick < 90 {
				for let i = 0; i < run && out.len() < length; i++ {
					out.push(byte(pick))
				}
			} else if pick < 170 && out.len() > 100 {
				let back = out.len() - 1 - int((state >> 12) & uint32(0x3F))
				for let i = 0; i < run * 3 && out.len() < length; i++ {
					out.push(out[back + i])
				}
			} else {
				for let i = 0; i < run && out.len() < length; i++ {
					state = state * uint32(1664525) + uint32(1013904223)
					out.push(byte((state >> 16) & uint32(0xFF)))
				}
			}
		}
		return out
	}

	check "LZ4" {
		// Frames and blocks written by the reference implementation.
		@test()
		def TestReadsReferenceData() !none {
			let phrase = "hello hello hello hello, LZ4! "
			let text = (phrase + phrase + phrase).bytes()
			let plain = try hexdecode("04224d1868405a00000000000000ec1f0000006d68656c6c6f2006006e2c204c5a342118000212000f1e000d504c5a34212000000000")
			assert (try decompress(plain)).equals(text)
			let checked = try hexdecode("04224d187c405a000000000000009a1f0000006d68656c6c6f2006006e2c204c5a342118000212000f1e000d504c5a342120946c8b57000000002c2f1b91")
			assert (try decompress(checked, 90)).equals(text)
			let linked = try hexdecode("04224d184040c02000008054686520666972737420626c6f636b206e616d65732061207068726173652e20200000000f20000df00b416e6420746865207365636f6e6420726570656174732069742e00000000")
			assert string(try decompress(linked)) == "The first block names a phrase. The first block names a phrase. And the second repeats it."
			let legacy = try hexdecode("02214c181f0000006d68656c6c6f2006006e2c204c5a342118000212000f1e000d504c5a342120")
			assert (try decompress(legacy)).equals(text)
			let block = try hexdecode("6d68656c6c6f2006006e2c204c5a342118000212000f1e000d504c5a342120")
			assert (try decompressBlock(block, 90)).equals(text)
			assert decompressBlock(block, 89) is error

			// Two frames with a skippable frame between them read as one stream.
			let several byte[] = []
			several.push(...plain)
			several.push(byte(0x51), byte(0x2A), byte(0x4D), byte(0x18), byte(3), byte(0), byte(0), byte(0), byte(1), byte(2), byte(3))
			several.push(...legacy)
			let both = try decompress(several)
			assert both.len() == 180 && both[90:].equals(text) && both[0:90].equals(text)
			return none
		}

		@test()
		def TestRoundTrips() !none {
			for let (_, length) in int[0, 1, 4, 12, 13, 14, 64, 1000, 65535, 65536, 65537, 300000] {
				let data = sample(length, length + 3)
				let packed = compress(data)
				let back = try decompress(packed)
				fail "a frame of {length} bytes came back different" unless back.equals(data)
				let block = compressBlock(data)
				let unpacked = try decompressBlock(block, length)
				fail "a block of {length} bytes came back different" unless unpacked.equals(data)
			}
			let flat byte[] = []
			flat.len(200000)
			assert compress(flat).len() < 1200
			assert (try decompress(compress(flat))).equals(flat)
			return none
		}

		// A block's matches may reach into the dictionary given with it.
		@test()
		def TestDictionary() !none {
			let dict = "dictionary words: hello LZ4 ".bytes()
			let tail = "hello LZ4 hello".bytes()
			// One sequence: no literals, then a match of 9 bytes 10 back
			// ("hello LZ4"), then the literals " hello".
			let block byte[] = [0x05, 0x0A, 0x00, 0x60, 0x20, 0x68, 0x65, 0x6C, 0x6C, 0x6F]
			assert string(try decompressBlock(block, 100, dict)) == string(tail)
			assert decompressBlock(block, 100) is error
			return none
		}

		@test()
		def TestStreams() !none {
			let data = sample(9000000, 11)
			let sink = new bytes.Buffer()
			let writer = new Writer(sink)
			let at = 0
			let step = 1
			for at < data.len() {
				let end = (at + step).min(data.len())
				try writer.write(data[at:end])
				at = end
				step = step * 7 + 3
				step = 5000000 when step > 5000000
			}
			try writer.close()
			assert writer.write(data[0:1]) is error && writer.close() is error

			let reader = new Reader(new bytes.Reader(sink.bytes()))
			let back byte[] = []
			let chunk byte[] = []
			chunk.len(70001)
			for {
				let n = try reader.read(chunk)
				break when n == 0
				back.push(...chunk[0:n])
			}
			assert back.len() == data.len() && back.equals(data)
			assert (try reader.read(chunk)) == 0

			// A frame opened with a size must get that many bytes.
			let sized = new Writer(new bytes.Buffer(), 10)
			try sized.write("12345".bytes())
			assert sized.close() is error
			return none
		}

		@test()
		def TestRefusesDamagedData() !none {
			let good = compress(sample(5000, 2))
			assert decompress("not a frame at all".bytes()) is error
			assert decompress(good[0:good.len() - 3].clone()) is error
			assert decompress(good[0:9].clone()) is error
			for let (_, at) in int[4, 6, 20, good.len() - 2] {
				let bent = good.clone()
				bent[at] = bent[at] ^ byte(0x40)
				assert decompress(bent) is error
			}
			// A match that reaches before the start of the data.
			assert decompressBlock(byte[0x10, 0x41, 0x05, 0x00], 100) is error
			// Literals that run past the block.
			assert decompressBlock(byte[0xF0, 0xFF], 100) is error
			return none
		}
	}
}
