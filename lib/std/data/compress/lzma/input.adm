internal partial module std.data.compress.lzma.core {
	use std.io

	// Input is a buffered byte source shared by a container parser and the
	// decoders inside it, so neither loses bytes the other read ahead. A read
	// past the end yields zero bytes and sets `overrun`, which callers check
	// once per symbol instead of on every byte.
	type Input {
		r       io.Reader
		buf     byte[]
		pos     int
		end     int
		// Bytes consumed before buf[0].
		base    int64
		eof     bool
		// Reads only what `ensure` asks for, never ahead, so the bytes after
		// the data stay in the underlying reader.
		exact   bool
		overrun bool
		err     ?error    = none

		def new(r io.Reader) {
			self.r = r
			buf.len(64 * 1024)
		}

		// An input over bytes already in memory.
		def new(data byte[]) {
			buf = data
			end = data.len()
			eof = true
		}

		def reset(r io.Reader) {
			self.r = r
			buf.len(64 * 1024) when buf.len() < 64 * 1024
			pos = 0
			end = 0
			base = 0
			eof = false
			overrun = false
			err = none
		}

		// Bytes consumed so far.
		def offset() int64 {
			return base + int64(pos)
		}

		// Refills the buffer; false at the end of the input or on a read
		// error, which is kept in `err`.
		def refill() bool {
			return false when eof || exact
			base += int64(end)
			pos = 0
			end = 0
			let n = r.read(buf) onerror (e error) {
				err = e
				recover 0
			}
			if n <= 0 {
				eof = true
				return false
			}
			end = n
			return true
		}

		// The next byte, 0 with `overrun` set past the end.
		def next() byte {
			if pos >= end {
				if !refill() {
					overrun = true
					return 0
				}
			}
			let b = buf[pos]
			pos++
			return b
		}

		// Whether no byte is left. Fails when the underlying reader does.
		def atEnd() !bool {
			if pos >= end {
				refill()
				fail err unless err is none
			}
			return pos >= end
		}

		// The next byte. Fails at the end of the input or when the reader does.
		def readByte() !byte {
			let b = next()
			try verify()
			return b
		}

		// Fills dst completely. Fails at the end of the input or when the
		// reader does.
		def readFull(dst byte[]) !none {
			let n = 0
			for n < dst.len() {
				if pos >= end && exact {
					let k = try r.read(dst[n:])
					fail "unexpected end of data" when k <= 0
					base += int64(k)
					n += k
					continue
				}
				if pos >= end && !refill() {
					fail err unless err is none
					fail "unexpected end of data"
				}
				let k = (buf[pos:end]).copy(dst[n:])
				pos += k
				n += k
			}
		}

		// Copies up to dst.len() bytes and returns how many, 0 at the end.
		// Fails when the reader does.
		def read(dst byte[]) !int {
			if pos >= end && !refill() {
				fail err unless err is none
				return 0
			}
			let k = (buf[pos:end]).copy(dst)
			pos += k
			return k
		}

		// Skips n bytes. Fails at the end of the input or when the reader
		// does.
		def skip(n int64) !none {
			let left = n
			for left > 0 {
				if pos >= end && !refill() {
					fail err unless err is none
					fail "unexpected end of data"
				}
				let k = int64(end - pos)
				k = left when left < k
				pos += int(k)
				left -= k
			}
		}

		// Makes n bytes available without reading further ahead. Fails when
		// the input ends first or the reader fails.
		def ensure(n int) !none {
			return none when end - pos >= n
			let have = end - pos
			if pos > 0 {
				(buf[pos:end]).copy(buf[0:have])
				base += int64(pos)
				pos = 0
				end = have
			}
			buf.len(n) when buf.len() < n
			for end < n {
				let k = try r.read(buf[end:n])
				fail "unexpected end of data" when k <= 0
				end += k
			}
		}

		// Fails when a read went past the end or the reader failed.
		def verify() !none {
			fail err unless err is none
			fail "unexpected end of data" when overrun
		}
	}
}
