partial module std.data.compress.lzma {
	use (
		std.io
		std.data.compress.lzma.core::*
	)

	// Reader decompresses LZMA data read from an io.Reader: a .lzma file
	// (the "alone" format, a 13-byte header with the coder properties,
	// dictionary size and uncompressed size, then the data), or raw LZMA data
	// whose properties are stored elsewhere, as 7z stores them.
	type Reader {
		internal input   Input
		internal stream  LzmaStream
		internal raw     bool
		internal props   byte[]
		internal size    int64
		internal started bool

		// A reader of a .lzma file.
		def new(r io.Reader) {
			input = new Input(r)
			stream = new LzmaStream(input)
		}

		// A reader of raw LZMA data: `properties` is the 5-byte coder
		// properties (the lc/lp/pb byte, then the dictionary size, little
		// endian) and `size` the uncompressed size, -1 when the data ends with
		// an end marker instead.
		def new(r io.Reader, properties byte[], size int64 = -1) {
			input = new Input(r)
			stream = new LzmaStream(input)
			raw = true
			props = properties
			self.size = size
		}

		// reset starts reading new data of the same kind from r.
		def reset(r io.Reader) {
			input.reset(r)
			started = false
		}

		// read decompresses into p and returns how many bytes it produced, 0 at
		// the end. Fails when the header or properties are invalid, the data is
		// corrupt or truncated, or the underlying reader fails.
		def read(p byte[]) !int {
			return 0 when p.len() == 0
			if !started {
				let header byte[] = props
				let length = size
				if !raw {
					header = []
					header.len(13)
					try input.readFull(header)
					length = int64(uint64(0).fromBytes(header[5:13]))
				}
				fail "lzma: invalid properties" when header.len() < 5
				let dictSize = int(uint32(0).fromBytes(header[1:5]))
				fail "lzma: invalid header" when length < -1
				try stream.start(int(header[0]), dictSize, length)
				started = true
			}
			return try stream.read(p)
		}

		// close releases the decompressor; it does not close the underlying
		// reader. It never fails.
		def close() !none {
			return none
		}
	}

	// Reader2 decompresses LZMA2 data, as the xz and 7z formats store it,
	// read from an io.Reader. It reads no further than the end of the LZMA2
	// data, so a container can go on reading what follows.
	type Reader2 {
		internal input  Input
		internal stream Lzma2Stream
		internal props  byte[]
		internal size   int64

		// A reader of LZMA2 data: `properties` is the 1-byte LZMA2 properties
		// that encode the dictionary size; `size` is the uncompressed size when
		// known, which only bounds the dictionary allocation.
		def new(r io.Reader, properties byte[], size int64 = -1) {
			input = new Input(r)
			props = properties
			self.size = size
			stream = new Lzma2Stream(input, dictSize(), size)
		}

		// reset starts reading new LZMA2 data with the same properties from r.
		def reset(r io.Reader) {
			input.reset(r)
			stream = new Lzma2Stream(input, dictSize(), size)
		}

		internal def dictSize() int {
			let bits = 40
			bits = int(props[0] & 0x3F) when props.len() == 1
			return 0xFFFFFFFF when bits >= 40
			return (2 | (bits & 1)) << (bits / 2 + 11)
		}

		// read decompresses into p and returns how many bytes it produced, 0 at
		// the end. Fails when the properties are invalid, the data is corrupt
		// or truncated, or the underlying reader fails.
		def read(p byte[]) !int {
			return 0 when p.len() == 0
			fail "lzma2: invalid properties" when props.len() != 1 || props[0] > 40
			return try stream.read(p)
		}

		// close releases the decompressor; it does not close the underlying
		// reader. It never fails.
		def close() !none {
			return none
		}
	}

	// Level is how hard the compressor works, from BestSpeed (1) to
	// BestCompression (9); `Level(n)` picks any level in between. Higher
	// levels use a larger dictionary (1 MiB at 1, 8 MiB at 6, 16 MiB at 9)
	// and search further for matches.
	enum Level {
		BestSpeed = 1,
		DefaultCompression = 6,
		BestCompression = 9,
	}

	// Writer compresses what is written to it into a .lzma file on an
	// io.Writer. The header records the size as unknown and `close` ends the
	// data with an end marker.
	type Writer {
		internal w      io.Writer
		internal level  Level
		internal e      LzmaAloneEncoder
		internal closed bool

		def new(w io.Writer, level Level = Level.DefaultCompression) {
			self.w = w
			self.level = level
			e = new LzmaAloneEncoder(w, preset(int(level)))
		}

		// reset starts a new .lzma file on w at the same level.
		def reset(w io.Writer) {
			self.w = w
			e = new LzmaAloneEncoder(w, preset(int(level)))
			closed = false
		}

		// write compresses p and returns how many bytes were taken. Fails when
		// the writer is closed or the underlying writer fails.
		def write(p byte[]) !int {
			fail "lzma: write to a closed writer" when closed
			try e.write(p)
			return p.len()
		}

		// flush compresses everything written so far and writes the finished
		// bytes to the underlying writer. Fails when it does.
		def flush() !none {
			return none when closed
			try e.header()
			e.enc.encode(e.enc.end, 1 << 16)
			try e.drain()
		}

		// close ends the data and writes the rest; closing again does nothing.
		// It does not close the underlying writer. Fails when that writer does.
		def close() !none {
			return none when closed
			closed = true
			try e.close()
		}
	}

	// Writer2 compresses what is written to it into LZMA2 data, as the xz and
	// 7z formats store it, on an io.Writer.
	type Writer2 {
		internal w      io.Writer
		internal level  Level
		internal e      Lzma2Encoder
		internal closed bool

		def new(w io.Writer, level Level = Level.DefaultCompression) {
			self.w = w
			self.level = level
			e = new Lzma2Encoder(w, preset(int(level)))
		}

		// properties returns the 1-byte LZMA2 properties (the dictionary size)
		// a reader of this data needs.
		def properties() byte[] {
			return byte[e.propsByte()]
		}

		// reset starts new LZMA2 data on w at the same level.
		def reset(w io.Writer) {
			self.w = w
			e = new Lzma2Encoder(w, preset(int(level)))
			closed = false
		}

		// write compresses p and returns how many bytes were taken. Fails when
		// the writer is closed or the underlying writer fails.
		def write(p byte[]) !int {
			fail "lzma2: write to a closed writer" when closed
			try e.write(p)
			return p.len()
		}

		// flush ends the current chunk so everything written so far reaches the
		// underlying writer. Fails when it does.
		def flush() !none {
			return none when closed
			try e.flush()
		}

		// close writes the rest and the end marker; closing again does nothing.
		// It does not close the underlying writer. Fails when that writer does.
		def close() !none {
			return none when closed
			closed = true
			try e.close()
		}
	}
}
