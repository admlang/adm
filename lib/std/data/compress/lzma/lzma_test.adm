partial module std.data.compress.lzma {
	check "LZMA" {
		use (
			std.testing
			std.bytes
			std.io
		)

		// "hello " twenty times as a .lzma file written by the system xz, with
		// an unknown size and an end marker.
		def helloFile() byte[] {
			return byte[
			0x5d, 0x00, 0x00, 0x80, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00, 0x34, 0x19,
			0x49, 0xee, 0x8d, 0xe9, 0x5a, 0x55, 0x76, 0x2e, 0x2b, 0xff, 0xff, 0xfb, 0xc5, 0x40, 0x00,
			]
		}

		// The same text as raw LZMA2 with a 64 KiB dictionary.
		def helloLzma2() byte[] {
			return byte[
			0xe0, 0x00, 0x77, 0x00, 0x0c, 0x5d, 0x00, 0x34, 0x19, 0x49, 0xee, 0x8d, 0xe9, 0x5a, 0x55, 0x6d,
			0x2f, 0x00, 0x00, 0x00,
			]
		}

		def hello() string {
			return "hello ".repeat(20)
		}

		def drain(r io.Reader) !byte[] {
			let out = new bytes.Buffer()
			try out.readFrom(r)
			return out.bytes()
		}

		def fails(r io.Reader) bool {
			let failed = false
			drain(r) onerror (e error) {
				failed = true
				recover []
			}
			return failed
		}

		@test()
		def readsLzmaFiles() !none {
			assert string(try drain(new Reader(new bytes.Reader(helloFile())))) == hello()
		}

		@test()
		def readsRawLzma() !none {
			let file = helloFile()
			let props = file[0:5]
			let data = file[13:]
			assert string(try drain(new Reader(new bytes.Reader(data), props))) == hello()
			assert string(try drain(new Reader(new bytes.Reader(data), props, 120))) == hello()
			assert string(try drain(new Reader(new bytes.Reader(data), props, 50))) == hello()[0:50]
		}

		@test()
		def readsLzma2() !none {
			assert string(try drain(new Reader2(new bytes.Reader(helloLzma2()), byte[8]))) == hello()
		}

		@test()
		def readsInSmallPieces() !none {
			let r = new Reader(new bytes.Reader(helloFile()))
			let out byte[] = []
			let buf byte[] = []
			buf.len(7)
			for {
				let n = try r.read(buf)
				break when n == 0
				out = out + buf[0:n]
			}
			assert string(out) == hello()
		}

		@test()
		def stopsAtTheEndOfLzma2Data() !none {
			let src = new bytes.Reader(helloLzma2() + "tail".bytes())
			assert string(try drain(new Reader2(src, byte[8]))) == hello()
			assert string(try drain(src)) == "tail"
		}

		@test()
		def rejectsCorruptData() !none {
			let file = helloFile()
			assert fails(new Reader(new bytes.Reader(file[0:file.len() - 4])))
			let bad = file.clone()
			bad[0] = 0xFF
			assert fails(new Reader(new bytes.Reader(bad)))
			let lz2 = helloLzma2()
			assert fails(new Reader2(new bytes.Reader(lz2[0:lz2.len() - 3]), byte[8]))
			assert fails(new Reader2(new bytes.Reader(lz2), byte[41]))
		}

		// Deterministic bytes: text-like runs with random bytes mixed in, or
		// only random bytes.
		def sample(size int, noise bool) byte[] {
			let out byte[] = []
			out.len(size)
			let x = uint32(2463534242)
			for let i = 0; i < size; i++ {
				x ^= x << 13
				x ^= x >> 17
				x ^= x << 5
				out[i] = (noise || x % 5 == 0) ?? (byte(x >> 8), byte(0x61 + (i / 7) % 13))
			}
			return out
		}

		def packLzma(data byte[], level Level) !byte[] {
			let out = new bytes.Buffer()
			let w = new Writer(out, level)
			try w.write(data)
			try w.close()
			return out.bytes()
		}

		def packLzma2(data byte[], level Level) !(byte[], byte[]) {
			let out = new bytes.Buffer()
			let w = new Writer2(out, level)
			try w.write(data)
			try w.close()
			return (out.bytes(), w.properties())
		}

		@test()
		def roundTripsLzmaFiles() !none {
			for let level in [Level.BestSpeed, Level.DefaultCompression, Level.BestCompression] {
				for let data in [byte[], hello().bytes(), sample(70000, false)] {
					let packed = try packLzma(data, level)
					assert (try drain(new Reader(new bytes.Reader(packed)))).equals(data)
				}
			}
		}

		@test()
		def roundTripsLzma2() !none {
			for let data in [byte[], hello().bytes(), sample(300000, false), sample(200000, true)] {
				let (packed, props) = try packLzma2(data, Level.BestSpeed)
				assert (try drain(new Reader2(new bytes.Reader(packed), props))).equals(data)
			}
			let text = sample(100000, false)
			let (packed, props) = try packLzma2(text, Level.DefaultCompression)
			assert packed.len() < text.len() / 2
			assert (try drain(new Reader2(new bytes.Reader(packed), props))).equals(text)
			// Incompressible input is stored rather than expanded.
			let noise = sample(100000, true)
			let (stored, _) = try packLzma2(noise, Level.BestSpeed)
			assert stored.len() < noise.len() + 100
		}

		@test()
		def flushesAndResets() !none {
			let first = new bytes.Buffer()
			let w = new Writer(first, Level.BestSpeed)
			try w.write("hello ".bytes())
			try w.flush()
			try w.write("world".bytes())
			try w.close()
			let second = new bytes.Buffer()
			w.reset(second)
			try w.write("again".bytes())
			try w.close()
			let r = new Reader(new bytes.Reader(first.bytes()))
			assert string(try drain(r)) == "hello world"
			r.reset(new bytes.Reader(second.bytes()))
			assert string(try drain(r)) == "again"

			let one = new bytes.Buffer()
			let w2 = new Writer2(one, Level.BestSpeed)
			try w2.write("hello ".bytes())
			try w2.flush()
			try w2.write("world".bytes())
			try w2.close()
			let two = new bytes.Buffer()
			w2.reset(two)
			try w2.write("again".bytes())
			try w2.close()
			let r2 = new Reader2(new bytes.Reader(one.bytes()), w2.properties())
			assert string(try drain(r2)) == "hello world"
			r2.reset(new bytes.Reader(two.bytes()))
			assert string(try drain(r2)) == "again"
		}
	}
}
