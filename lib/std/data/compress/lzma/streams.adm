internal partial module std.data.compress.lzma.core {
	// LzmaStream reads raw LZMA data: the payload of a .lzma file after its
	// header, or an LZMA coder in 7z. With a known size it stops there;
	// otherwise it needs the end marker.
	type LzmaStream {
		dec  LzmaDecoder
		size int64
		done bool

		// A stream on the input; `start` sets it up.
		def new(input Input) {
			dec = new LzmaDecoder(input)
		}

		// Sets the coder up for `size` bytes, -1 when unknown. Fails on
		// invalid properties or a corrupt range coder header.
		def start(props int, dictSize int, size int64) !none {
			self.size = size
			done = false
			try dec.useProps(props)
			dec.allocDict(dictSize, size)
			dec.resetState()
			if size == 0 {
				done = true
				return none
			}
			try dec.rcInit()
		}

		// Implements std.io.Reader. Fails on corrupt or truncated data.
		def read(p byte[]) !int {
			let n = 0
			for {
				n = dec.flush(p, n)
				break when n == p.len() || done
				let budget = int64(-1)
				if size >= 0 {
					budget = size - dec.total
					if budget == 0 {
						done = true
						break
					}
				}
				try dec.decode(dec.limitFor(p.len() - n), budget, true)
				if dec.sawMarker {
					fail "lzma: end marker before the declared size" when size >= 0 && dec.total != size
					done = true
				}
			}
			return n
		}
	}

	// Lzma2Stream reads LZMA2 data: a sequence of LZMA and stored chunks
	// ending with a zero control byte.
	type Lzma2Stream {
		dec        LzmaDecoder
		input      Input
		chunkLeft  int
		chunkEnd   int64
		compressed bool
		needDict   bool
		needProps  bool
		done       bool

		def new(input Input, dictSize int, sizeHint int64 = -1) {
			self.input = input
			input.exact = true
			dec = new LzmaDecoder(input)
			dec.allocDict(dictSize, sizeHint)
			needDict = true
			needProps = true
		}

		// Implements std.io.Reader. Fails on corrupt or truncated data.
		def read(p byte[]) !int {
			let n = 0
			for {
				n = dec.flush(p, n)
				break when n == p.len() || done
				if chunkLeft == 0 {
					try nextChunk()
					continue
				}
				let limit = dec.limitFor(p.len() - n)
				if compressed {
					let before = dec.total
					try dec.decode(limit, int64(chunkLeft), false)
					chunkLeft -= int(dec.total - before)
					if chunkLeft == 0 {
						fail "lzma2: compressed size mismatch" when input.offset() != chunkEnd || !dec.rcFinished()
					}
				} else {
					chunkLeft -= try dec.copyStored(limit, chunkLeft)
				}
			}
			return n
		}

		def nextChunk() !none {
			try input.ensure(1)
			let ctrl = int(try input.readByte())
			if ctrl == 0 {
				done = true
				return none
			}
			if ctrl == 1 || ctrl >= 0xE0 {
				dec.resetDict()
				needDict = false
			} else {
				fail "lzma2: missing dictionary reset" when needDict
			}
			if ctrl >= 0x80 {
				try input.ensure((ctrl >= 0xC0) ?? (5, 4))
				let unpacked = ((ctrl & 0x1F) << 16) + (int(try input.readByte()) << 8) + int(try input.readByte()) + 1
				let packed = (int(try input.readByte()) << 8) + int(try input.readByte()) + 1
				let mode = (ctrl >> 5) & 3
				if mode >= 2 {
					let props = int(try input.readByte())
					try dec.useProps(props)
					fail "lzma2: invalid properties" when dec.lc + dec.lp > 4
					needProps = false
				} else {
					fail "lzma2: missing properties" when needProps
				}
				dec.resetState() when mode >= 1
				try input.ensure(packed)
				chunkEnd = input.offset() + int64(packed)
				try dec.rcInit()
				chunkLeft = unpacked
				compressed = true
				return none
			}
			fail "lzma2: invalid control byte" when ctrl > 2
			try input.ensure(2)
			chunkLeft = (int(try input.readByte()) << 8) + int(try input.readByte()) + 1
			compressed = false
		}
	}
}
