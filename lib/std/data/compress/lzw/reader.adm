// Portions adapted from Go's compress/lzw package (BSD-style license).
partial module std.data.compress.lzw {
	use std.io

	enum Order {
		LSB,
		MSB,
	}

	internal const (
		maxWidth           = 12
		decoderInvalidCode = 0xFFFF
		flushBuffer        = 1 << maxWidth
	)

	type Reader {
		internal r io.Reader

		internal bits  uint32
		internal nBits uint
		internal width uint
		internal order Order
		internal litWidth int

		internal err ?error = none

		internal clear    uint16
		internal eof      uint16
		internal hi       uint16
		internal overflow uint16
		internal last     uint16

		internal suffix byte[]
		internal prefix uint16[]
		internal output byte[]
		internal o int
		internal toRead byte[]

		internal byteBuf byte[]
		internal bytePos int
		internal byteLen int

		def new(r io.Reader, order Order, litWidth int = 8) {
			reset(r, order, litWidth)
		}

		def reset(r io.Reader, order Order, litWidth int = 8) {
			self.r = r
			self.order = order
			self.litWidth = litWidth
			bits = 0
			nBits = 0
			width = 0
			err = none
			clear = 0
			eof = 0
			hi = 0
			overflow = 0
			last = decoderInvalidCode

			if suffix.len() == 0 {
				suffix.len(1 << maxWidth)
			}
			if prefix.len() == 0 {
				prefix.len(1 << maxWidth)
			}
			if output.len() == 0 {
				output.len(2 * (1 << maxWidth))
			}
			o = 0
			toRead.len(0)

			if byteBuf.len() == 0 {
				byteBuf.len(4096)
			}
			bytePos = 0
			byteLen = 0

			if order != Order.LSB && order != Order.MSB {
				err = Error{message: "lzw: unknown order"}
				return
			}
			if litWidth < 2 || litWidth > 8 {
				err = Error{message: "lzw: litWidth out of range"}
				return
			}

			width = uint(1 + litWidth)
			clear = uint16(1) << uint(litWidth)
			eof = clear + 1
			hi = eof
			overflow = uint16(1) << width
			last = decoderInvalidCode
		}

		def read(b byte[]) !int {
			for {
				if toRead.len() > 0 {
					let n = toRead.copy(b)
					toRead = toRead[n:]
					return n
				}
				fail err unless err is none
				decode()
			}
			return 0
		}

		def close() !none {
			err = Error{message: "lzw: reader/writer is closed"}
			return none
		}

		internal def readByte() !byte {
			if bytePos >= byteLen {
				let n = r.read(byteBuf) onerror (e error) {
					fail e
				}
				fail Error{message: "EOF"} when n == 0
				bytePos = 0
				byteLen = n
			}
			let c = byteBuf[bytePos]
			bytePos += 1
			return c
		}

		internal def readCode() !uint16 {
			if order == Order.LSB {
				for nBits < width {
					let x = try readByte()
					bits |= uint32(x) << nBits
					nBits += 8
				}
				let mask = (uint32(1) << width) - 1
				let code = uint16(bits & mask)
				bits >>= width
				nBits -= width
				return code
			}

			for nBits < width {
				let x = try readByte()
				bits |= uint32(x) << (24 - nBits)
				nBits += 8
			}
			let code = uint16(bits >> (32 - width))
			bits <<= width
			nBits -= width
			return code
		}

		internal def decode() {
			for {
				let code uint16
				code = readCode() onerror (e error) {
					if e.message == "EOF" {
						err = Error{message: "unexpected EOF"}
						recover decoderInvalidCode
					}
					err = e
					recover decoderInvalidCode
				}
				return unless err is none

				switch {
					case code < clear:
						output[o] = byte(code)
						o += 1
						if last != decoderInvalidCode {
							suffix[int(hi)] = byte(code)
							prefix[int(hi)] = last
						}
					case code == clear:
						width = uint(1 + litWidth)
						hi = eof
						overflow = uint16(1) << width
						last = decoderInvalidCode
						continue
					case code == eof:
						err = Error{message: "EOF"}
						break
					case code <= hi:
						let c = code
						let i = output.len() - 1
						if code == hi && last != decoderInvalidCode {
							c = last
							for c >= clear {
								c = prefix[int(c)]
							}
							output[i] = byte(c)
							i -= 1
							c = last
						}
						for c >= clear {
							output[i] = suffix[int(c)]
							i -= 1
							c = prefix[int(c)]
						}
						output[i] = byte(c)
						o += output[i:].copy(output[o:])
						if last != decoderInvalidCode {
							suffix[int(hi)] = byte(c)
							prefix[int(hi)] = last
						}
					default:
						err = Error{message: "lzw: invalid code"}
						break
				}

				if !(err is none) {
					break
				}
				last = code
				hi += 1
				if hi >= overflow {
					if hi > overflow {
						err = Error{message: "lzw: internal error"}
						break
					}
					if width == uint(maxWidth) {
						last = decoderInvalidCode
						hi -= 1
					} else {
						width += 1
						overflow = uint16(1) << width
					}
				}
				if o >= flushBuffer {
					break
				}
			}
			toRead = output[:o]
			o = 0
		}
	}
}
