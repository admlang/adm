partial module std.data.compress.lzw {
	use (
		std.bytes
		std.data.encoding
		std.testing
	)

	check "LZW reader" {
		// MSB-first codes that grow one code early, as PDF writes them: the
		// numbers `i * i * 7919 % 100003` for i below 400, space separated.
		let earlyNumbers = "gAwEA3HIxHIgGYxGw3G0DGIyG4xEAyhYwiQ5gg3GQgHA1GA3HEcHAwGUbG0jiQ0GI0GUXGI4gggGo4GMaEA0GAznMIHEQjY1" +
			"GUfg80jQ0icaGFGHEdGQ1EA2GsniUzhdOqsfEA5lo3G8Iik9jg5kkhG0PGEHGlaGUhGs6jsDiEjjkJgQ1HNSicnmFZHMJkQx" +
			"GcTGdtwI1nEFm44ow2iEvm8fvYzGg2HNGGmXGcHG4wkkbGMrnFPHGUtE1vsIj9NhGGHNOqIxnda1k3Gg4nQgh+Vg93sW7itG" +
			"h4zyU3Gcjp0Fz9Gw1NkPCGWhtYwG0C4sRslAlcDw1WGsRruZosT1uU1dNn8LG+ByuAjY09MU3A2wchh9r3F9hsv2s/GGjhoc" +
			"rEpanoSGinBonTQuq9KZJyy6Bq4tqJrOjCOM4sAao8kibu66aZBkwaGhu9yxNwnS7KeiLyBmiLspKHEKOeGrHJUjCuhuoERI" +
			"my7pLDFbNIsvYbJO4SBr6mqBvkhsZII/LTIkmDGRsrQcpC0aRq62AYxkm6+hmhsDqi7StqegzAKey73I4taDNwzb4IrHIZhk" +
			"1ssMmkDcJLFaJqi4bDNG3cAJYp7+o8hEbru1CXuo0cNMY0aNzm7qZKW06dSE4CewWragpu2AYKchiHpCiD+v+4q3oZGTNLSx" +
			"EXp0iSDMuhqoQPSCNQitKHqyxVdK5B05ILGzMvsnVfIRAqQoLKj1PlA74ratimxzNFQJbSUMM25SPRegac10wDNsSiiDs+zj" +
			"Axe7sqszATKw+hqgoSg7GOewKgs4jb8Q02ycq6pa6KylSQsnLyuwBLTFq4hkPXdDy2sW0dwhslTEwKwKH08rMtQFP7P121M9" +
			"uksiCU+vLuyw/uCpW4qsoY5774k10bqwz6gqUj9BSEz6rPehrFRWpyaqbeS7MU1DDOAs9BO8+jZPbFKjN67KPVZPa1Tal96p" +
			"YsD3Jaoa7Mqx7puA2CgZYySLsqqE2pY5T6qVE8hOFAyGMm2iCZikCNv8rCEoplKGLImik0GuLRTmgStJW6iXtUmDBqmmFdQK" +
			"5DEsrkSe3qwiZLc4DK3ChWwQBQ8SqhL7hbBSlwo84qJIg+SBKC7zxYkn8duPDMlNBSEVoU3HGPpkzmwxISHINSCKQjF7W1An" +
			"StLg6V+r0gSaqAsicSOimzw22KOx422Jski0bQwv05KWgTpoWrKPNavjW1G6Uwu6g3bvJhOirL78yI0jdfNqVkzhByokqVgX" +
			"d/6VCNKmPkWg6pqCMIhfCYEhKQmYtqTojwlZMUPlnMCdM7aJTbN6Tmh0hZWoOkwZcR1LzFiQJ6Zy2UnROjPEkRIWV3pNSQEC" +
			"QKWtvSj2nEZImmt6aXiyoSMHDotZXCOEPUEYMy7tS5EFMGbtYrFjpElNoRZfCcjQkzhiQgrTg4prONqUAgRDC+lOJaS8pxNH" +
			"XEyKQe1F7xColRSqZw/p9y1mBREZktBbVCpyMAQcyRDElJyL8TBhyhiFkbS8/8jpk42kJSOXc6ZXWhJyIcWc5pQUAI9PoWVo" +
			"BFjbmSNrHxOxRlimcT2xKAC4ysnFLOiU/TFJWKBMMU9ZpgS0kfh0QwwZT14LJJKTE4pg41P2JGy5FJ2XBM4RMTdEUs0Dv/K4" +
			"qIp53VnGbIMf8pJeyKFlj4R0uTAywE6M6eJDJtCaIhLsuEkprWvEgXkZeXJM06FPSmskw0SkVq5fWZJWZYkvKTgGgMvpAiOm" +
			"AKMSUmsfCPK4RWScicIXWuRPaWliZXELI6ILQo0aESTofIkklNKIixAxICA="

		internal def readAll(r Reader) byte[] {
			let out = new bytes.Buffer()
			let chunk byte[]
			chunk.len(512)
			for {
				let n = r.read(chunk) onerror recover 0
				break when n <= 0
				out.write(chunk[:n]) onerror recover 0
			}
			return out.bytes()
		}

		@test()
		def earlyChange() !none {
			let numbers = string[]
			for let i = 0; i < 400; i++ {
				numbers.push("{i * i * 7919 % 100003}")
			}
			let data = try encoding.base64decode(earlyNumbers)
			let early = new Reader(new bytes.Buffer(data), Order.MSB, 8, true)
			assert string(readAll(early)) == numbers.join(" ")
			// Read without early change, the codes go wrong once the table grows.
			let late = new Reader(new bytes.Buffer(data), Order.MSB, 8)
			assert string(readAll(late)) != numbers.join(" ")
			return none
		}
	}
}
