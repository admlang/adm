// Portions adapted from Go's compress/lzw package (BSD-style license).

partial module std.data.compress.lzw {
	use (
		std.io
		std.bytes
	)

	internal const (
		maxCode      = (1 << maxWidth) - 1
		invalidCode  = 0xFFFFFFFF
		tableSize    = 4 * (1 << maxWidth)
		tableMask    = tableSize - 1
		invalidEntry = 0
	)

	internal type byteWriter {
		w   io.Writer
		buf byte[]
		n   int

		def new(w io.Writer) {
			self.w = w
			buf.len(4096)
			n = 0
		}

		def reset(w io.Writer) {
			self.w = w
			n = 0
		}

		def writeByte(b byte) !none {
			buf[n] = b
			n += 1
			if n == buf.len() {
				try flush()
			}
			return none
		}

		def flush() !none {
			if n == 0 {
				return none
			}
			let written = try w.write(buf[:n])
			fail "lzw: short write" when written != n
			n = 0
			return none
		}
	}

	// Writer compresses what is written to it as an LZW stream on an io.Writer,
	// in the given bit order and literal width.
	type Writer {
		internal w         byteWriter
		internal order     Order
		internal litWidth  uint
		internal width     uint
		internal nBits     uint
		internal bits      uint32
		internal hi        uint32
		internal overflow  uint32
		internal savedCode uint32
		internal err       ?error     = none
		internal table     uint32[]

		def new(w io.Writer, order Order, litWidth int = 8) {
			reset(w, order, litWidth)
		}

		// reset starts a new stream on w with the given bit order and literal width
		// (2 to 8 bits).
		def reset(w io.Writer, order Order, litWidth int = 8) {
			self.order = order
			err = none
			bits = 0
			nBits = 0
			width = 0
			hi = 0
			overflow = 0
			savedCode = invalidCode

			if table.len() == 0 {
				table.len(tableSize)
			}
			table[:] = 0

			if order != Order.LSB && order != Order.MSB {
				err = Error{message: "lzw: unknown order"}
				return
			}
			if litWidth < 2 || litWidth > 8 {
				err = Error{message: "lzw: litWidth out of range"}
				return
			}

			if self.w.buf.len() == 0 {
				self.w = new byteWriter(w)
			} else {
				self.w.reset(w)
			}

			litWidth = uint(litWidth)
			self.litWidth = litWidth
			width = 1 + litWidth
			hi = (1 << litWidth) + 1
			overflow = 1 << (litWidth + 1)
		}

		// write compresses p and returns how many bytes were taken. Fails when the
		// writer is closed, a byte exceeds the literal width, or the underlying
		// writer does.
		def write(p byte[]) !int {
			fail err unless err is none
			return 0 when p.len() == 0
			let maxLit = int((1 << litWidth) - 1)
			if maxLit != 0xFF {
				for let (_, x) in p {
					fail "lzw: input byte too large for the litWidth" when int(x) > maxLit
				}
			}

			let n = p.len()
			let code = savedCode
			if code == invalidCode {
				let clear = uint32(1) << litWidth
				try writeCode(clear)
				code = uint32(p[0])
				p = p[1:]
			}
			for let (_, x) in p {
				let literal = uint32(x)
				let key = (code << 8) | literal
				let hash = (key >> 12 ^ key) & tableMask
				let h = hash
				let hit = false
				for table[h] != invalidEntry {
					let t = table[h]
					if key == (t >> 12) {
						code = t & maxCode
						hit = true
						break
					}
					h = (h + 1) & tableMask
				}
				if hit {
					continue
				}

				try writeCode(code)
				code = literal
				let outOfCodes = try incHi()
				if outOfCodes {
					continue
				}

				for {
					if table[hash] == invalidEntry {
						table[hash] = (key << 12) | hi
						break
					}
					hash = (hash + 1) & tableMask
				}
			}

			savedCode = code
			return n
		}

		// close writes the end code and flushes; closing again does nothing. Fails
		// when a previous write failed or the underlying writer does.
		def close() !none {
			if !(err is none) {
				return none when err.message == "lzw: reader/writer is closed"
				fail err
			}

			err = Error{message: "lzw: reader/writer is closed"}
			if savedCode != invalidCode {
				try writeCode(savedCode)
				_ = try incHi()
			} else {
				let clear = uint32(1) << litWidth
				try writeCode(clear)
			}
			let eof = (uint32(1) << litWidth) + 1
			try writeCode(eof)
			if nBits > 0 {
				if order == Order.MSB {
					bits >>= 24
				}
				try w.writeByte(byte(bits))
			}
			return try w.flush()
		}

		internal def writeCode(c uint32) !none {
			if order == Order.LSB {
				bits |= c << nBits
				nBits += width
				for nBits >= 8 {
					try w.writeByte(byte(bits))
					bits >>= 8
					nBits -= 8
				}
				return none
			}

			bits |= c << (32 - width - nBits)
			nBits += width
			for nBits >= 8 {
				try w.writeByte(byte(bits >> 24))
				bits <<= 8
				nBits -= 8
			}
			return none
		}

		internal def incHi() !bool {
			hi += 1
			if hi == overflow {
				width += 1
				overflow <<= 1
			}
			if hi == maxCode {
				let clear = uint32(1) << litWidth
				try writeCode(clear)
				width = litWidth + 1
				hi = clear + 1
				overflow = clear << 1
				table[:] = 0
				return true
			}
			return false
		}
	}

	check "LZW" {
		use std.testing

		@test()
		def testRoundTrip() !none {
			let buf = new bytes.Buffer()
			let w = new Writer(buf, Order.LSB, 8)
			_ = try w.write(byte[]("hello lzw"))
			try w.close()
			let r = new Reader(new bytes.Reader(buf.bytes()), Order.LSB, 8)
			let decoded = new bytes.Buffer()
			_ = try decoded.readFrom(r)
			assert string(decoded.bytes()) == "hello lzw"
		}
	}
}
