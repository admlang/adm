partial module std.data.compress.ppm {
	use (
		std.io
		std.data.compress.ppm.model::*
	)

	// Flavor is the range coder a PPMd variant H stream is coded with.
	enum Flavor {
		// 7-Zip's coder, as the 7z PPMd method writes it.
		SevenZip,
		// Subbotin's carryless coder, as RAR 3.x writes its PPM blocks.
		Rar
	}

	// ByteSource is where a Decoder reads its coded bytes from.
	interface ByteSource {
		// The next byte, or 0 once the input is exhausted.
		def nextByte() int
	}

	// Decoder decodes PPMd variant H (PPMd7) symbols from a ByteSource. A
	// format that interleaves PPM data with other coding, as RAR does, keeps
	// one Decoder: `reset` starts a fresh model, `startCoder` restarts the
	// range coder over the model already built.
	type Decoder {
		internal model Model

		def new(source ByteSource, flavor Flavor = Flavor.SevenZip) {
			model = new Model(() => source.nextByte(), flavor == Flavor.Rar)
		}

		// reset allocates `memory` bytes for the model and starts it afresh
		// with the maximum context `order` (2 to 64).
		def reset(order int, memory int) {
			model.start(order, memory)
		}

		// Whether `reset` has set up a model.
		def ready() bool {
			return model.ready()
		}

		// startCoder reads the range coder's first bytes and reports whether
		// they are valid.
		def startCoder() bool {
			return model.startCoder()
		}

		// decode returns the next byte, -1 at the stream's end mark, or -2
		// when the data is corrupt.
		def decode() int {
			return model.decode()
		}
	}

	// Reader decompresses a 7z PPMd stream: PPMd variant H with 7-Zip's
	// range coder.
	type Reader {
		internal source  ReaderSource
		internal decoder Decoder
		internal left    int64
		internal started bool
		internal order   int
		internal memory  int

		// A reader of the raw stream: `properties` is the 5-byte coder
		// properties 7z stores (the model order, then the memory size, little
		// endian) and `size` the uncompressed size, -1 to read to the end
		// mark.
		def new(r io.Reader, properties byte[], size int64 = -1) {
			source = new ReaderSource(r)
			decoder = new Decoder(source)
			left = size
			if properties.len() >= 5 {
				order = int(properties[0])
				memory = int(properties[1]) | (int(properties[2]) << 8) | (int(properties[3]) << 16) | (int(properties[4]) << 24)
			}
		}

		// read decompresses into p and returns how many bytes it produced, 0 at
		// the end. Fails when the properties are invalid, the data is corrupt
		// or ends early, or the underlying reader fails.
		def read(p byte[]) !int {
			return 0 when p.len() == 0 || left == 0
			if !started {
				fail "ppm: invalid properties" when order < 2 || order > 64 || memory < (1 << 11) || memory > 0xFFFFFFFF - 36
				decoder.reset(order, memory)
				fail "ppm: corrupt stream" unless decoder.startCoder()
				started = true
			}
			let n = 0
			for n < p.len() && left != 0 {
				let sym = decoder.decode()
				if sym < 0 {
					fail "ppm: corrupt stream" when sym != -1 || left > 0
					left = 0
					break
				}
				p[n] = byte(sym)
				n++
				left -= 1 when left > 0
			}
			fail source.failure when n == 0 && !source.failure.isEmpty()
			fail "ppm: stream ended early" when n == 0 && source.ended
			return n
		}
	}
}
