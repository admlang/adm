partial module std.data.compress.ppm {
	use (
		std.testing
		std.bytes
		std.io
	)

	// The packed stream of a 7z PPMd entry (order 6, 16 MB of model memory)
	// holding 40 lines of "line N: the quick brown fox jumps over the lazy
	// dog".
	internal def ppmSample() byte[] {
		return byte[
			0x00, 0x6b, 0xfb, 0x71, 0xc6, 0x4f, 0x7f, 0x50, 0x7d, 0xf5, 0x47, 0xc3, 0x19, 0x01, 0x02, 0x96,
			0x6b, 0x07, 0x88, 0x8d, 0x73, 0xcb, 0xa1, 0x78, 0x3a, 0x6f, 0x8b, 0x14, 0x68, 0x93, 0x5a, 0xa3,
			0x95, 0xec, 0x91, 0xdb, 0x3c, 0x25, 0xf1, 0x72, 0xfe, 0xd8, 0x5d, 0x77, 0x0a, 0xe0, 0x67, 0x11,
			0x73, 0x05, 0x17, 0x9e, 0x3a, 0xb9, 0x12, 0x02, 0xf4, 0xd2, 0x8a, 0xe0, 0x2b, 0xe5, 0x1d, 0x9d,
			0x99, 0x6e, 0xad, 0x83, 0xfe, 0x93, 0xcf, 0x52, 0x95, 0xb4, 0xc1, 0x76, 0x49, 0x51, 0xa0, 0x63,
			0xe4, 0x08, 0x1a, 0x54, 0x10, 0x56, 0x1d, 0xdd, 0xa8, 0x32, 0x18, 0x60, 0x44, 0xdf, 0x29, 0xac,
			0x1e, 0x55, 0xec, 0x3c, 0xb0, 0xbf, 0x7b, 0x76, 0xf5, 0x6a, 0x7f, 0xf3, 0xca, 0x18, 0xf0, 0x02,
			0xd0, 0x2d, 0x45, 0x23, 0x3a, 0x7e, 0xd9, 0x2f, 0xd8, 0x00, 0x7a, 0x9c, 0xa2, 0x00,
		]
	}

	// Feeds a Decoder from a byte array.
	internal type SampleSource {
		data byte[]
		at   int

		def new(data byte[]) {
			self.data = data
		}

		def nextByte() int {
			return 0 when at >= data.len()
			let b = int(data[at])
			at++
			return b
		}
	}

	check "PPMd" {
		def expected() string {
			let lines string[] = []
			for let i = 0; i < 40; i++ {
				lines.push("line {i}: the quick brown fox jumps over the lazy dog\n")
			}
			return lines.join("")
		}

		def props() byte[] {
			return byte[6, 0, 0, 0, 1]
		}

		@test()
		def decodes_a_7z_stream() !none {
			let r = new Reader(new bytes.Reader(ppmSample()), props(), 2110)
			assert string(try readAll(r)) == expected()
		}

		@test()
		def decodes_in_small_reads() !none {
			let r = new Reader(new bytes.Reader(ppmSample()), props(), 2110)
			let out byte[] = []
			let buf byte[] = []
			buf.len(7)
			for {
				let n = try r.read(buf)
				break when n == 0
				out = out + buf[0:n]
			}
			assert string(out) == expected()
		}

		@test()
		def decoder_symbol_by_symbol() {
			let d = new Decoder(new SampleSource(ppmSample()))
			assert !d.ready()
			d.reset(6, 1 << 24)
			assert d.ready()
			assert d.startCoder()
			let out byte[] = []
			for let i = 0; i < 2110; i++ {
				let sym = d.decode()
				assert sym >= 0
				out.push(byte(sym))
			}
			assert string(out) == expected()
		}

		@test()
		def refuses_bad_properties() {
			let r = new Reader(new bytes.Reader(ppmSample()), byte[1, 0, 0, 0, 1], 2110)
			let failure = ""
			let _ = readAll(r) onerror (err error) {
				failure = err.message
				recover []
			}
			assert failure.contains("invalid properties")
		}

		def readAll(r Reader) !byte[] {
			let out byte[] = []
			let buf byte[] = []
			buf.len(4096)
			for {
				let n = try r.read(buf)
				break when n == 0
				out = out + buf[0:n]
			}
			return out
		}
	}
}
