// Snappy: the block format most protocols and file formats embed, and the
// framing format of `.sz` streams.
//
// ```
// use std.data.compress.snappy
//
// let packed = snappy.compress(data)
// let back = try snappy.decompress(packed)
// ```
partial module std.data.compress.snappy {
	use (
		std.crypto.hash::(crc32c)
		std.io
		std.mem
	)

	// Compresses the bytes into one Snappy block, which starts with the
	// length of the data.
	def compress(src byte[]) byte[] {
		let out byte[] = []
		out.cap(src.len() / 2 + 32)
		let n = src.len()
		for n >= 128 {
			out.push(byte((n & 0x7F) | 0x80))
			n = n >> 7
		}
		out.push(byte(n))
		// The matcher works on pieces of 64 KiB, as the reference does.
		for let at = 0; at < src.len(); at += 65536 {
			encodePiece(src, at, (at + 65536).min(src.len()), out)
		}
		return out
	}

	// The length a Snappy block decompresses to, read from its start.
	// Fails when the block does not start with a valid length.
	def decompressedLength(src byte[]) !int {
		let (length, used) = try preamble(src)
		return length
	}

	// Decompresses one Snappy block.
	// Fails when the block is damaged: a length that is not valid, an
	// element that runs past the block, a copy that reaches before the
	// start of the data, or data that is not as long as the block says.
	def decompress(src byte[]) !byte[] {
		let (length, used) = try preamble(src)
		let out byte[] = []
		out.len(length)
		let pos = used
		let o = 0
		let to = src.len()
		for pos < to {
			let tag = int(src[pos])
			pos++
			let kind = tag & 3
			if kind == 0 {
				let count = tag >> 2
				if count >= 60 {
					let extra = count - 59
					fail "snappy: a literal length runs past the block" when pos + extra > to
					count = 0
					for let i = 0; i < extra; i++ {
						count |= int(src[pos + i]) << (8 * i)
					}
					pos += extra
				}
				count++
				fail "snappy: a literal runs past the block" when count < 1 || pos + count > to
				fail "snappy: the block holds more than its length says" when o + count > length
				if count >= 32 {
					mem.copyN(out[o:], src[pos:], count)
				} else {
					for let i = 0; i < count; i++ {
						out[o + i] = src[pos + i]
					}
				}
				pos += count
				o += count
				continue
			}
			let count = 0
			let offset = 0
			if kind == 1 {
				fail "snappy: a copy runs past the block" when pos >= to
				count = 4 + ((tag >> 2) & 7)
				offset = ((tag >> 5) << 8) | int(src[pos])
				pos++
			} else if kind == 2 {
				fail "snappy: a copy runs past the block" when pos + 2 > to
				count = 1 + (tag >> 2)
				offset = int(src[pos]) | (int(src[pos + 1]) << 8)
				pos += 2
			} else {
				fail "snappy: a copy runs past the block" when pos + 4 > to
				count = 1 + (tag >> 2)
				offset = int(src[pos]) | (int(src[pos + 1]) << 8) | (int(src[pos + 2]) << 16) | (int(src[pos + 3]) << 24)
				pos += 4
			}
			fail "snappy: a copy reaches before the start of the data" when offset <= 0 || offset > o
			fail "snappy: the block holds more than its length says" when o + count > length
			let back = o - offset
			if count >= 32 && offset >= count {
				mem.copyN(out[o:], out[back:], count)
			} else {
				// A copy that overlaps its own output repeats a pattern,
				// so it goes byte by byte.
				for let i = 0; i < count; i++ {
					out[o + i] = out[back + i]
				}
			}
			o += count
		}
		fail "snappy: the block holds {o} bytes, its length says {length}" when o != length
		return out
	}

	// Reader decompresses a stream in the Snappy framing format (`.sz`)
	// from another reader as it is read.
	type Reader {
		internal source  io.Reader
		internal chunk   byte[]
		internal served  int
		internal started bool
		internal ended   bool

		def new(source io.Reader) {
			self.source = source
			chunk = []
			served = 0
			started = false
			ended = false
		}

		// read implements std.io.Reader: decompressed bytes, 0 at the end of
		// the stream.
		// Fails when the source does, when the stream does not start with
		// the Snappy stream identifier, on a chunk type that must be
		// understood and is not, and on a chunk that is too large, does not
		// decompress or does not match its checksum.
		def read(p byte[]) !int {
			for served == chunk.len() {
				return 0 when ended
				try nextChunk()
			}
			let n = (chunk.len() - served).min(p.len())
			mem.copyN(p, chunk[served:served + n], n)
			served += n
			return n
		}

		internal def nextChunk() !none {
			let head byte[] = []
			head.len(4)
			let got = try readSome(head)
			if got == 0 {
				// A stream of nothing has no identifier either.
				ended = true
				return none
			}
			fail "snappy: unexpected end of data in a chunk header" when got != 4
			let kind = int(head[0])
			let size = int(head[1]) | (int(head[2]) << 8) | (int(head[3]) << 16)
			fail "snappy: the stream does not start with the stream identifier" when !started && kind != 0xFF
			let body byte[] = []
			body.len(size)
			fail "snappy: unexpected end of data in a chunk" when (try readSome(body)) != size
			if kind == 0xFF {
				fail "snappy: not a Snappy stream" when string(body) != "sNaPpY"
				started = true
				return none
			}
			if kind := 0x00 || 0x01 {
				fail "snappy: a data chunk is too short for its checksum" when size < 4
				let sum = uint32(body[0]) | (uint32(body[1]) << 8) | (uint32(body[2]) << 16) | (uint32(body[3]) << 24)
				let data = body[4:].clone()
				if kind == 0x00 {
					fail "snappy: a chunk decompresses to more than 65536 bytes" when (try decompressedLength(data)) > 65536
					data = try decompress(data)
				}
				fail "snappy: a chunk holds more than 65536 bytes" when data.len() > 65536
				fail "snappy: a chunk's checksum does not match" when maskedChecksum(data) != sum
				chunk = data
				served = 0
				return none
			}
			// 0x02 to 0x7F must be understood; 0x80 to 0xFE (padding
			// included) are skipped.
			fail "snappy: chunk type {kind} is not supported" when kind < 0x80
			return none
		}

		// Fills `p` from the source; less than its length only at the end.
		internal def readSome(p byte[]) !int {
			let total = 0
			for total < p.len() {
				let n = try source.read(p[total:])
				break when n == 0
				total += n
			}
			return total
		}
	}

	// Writer compresses what is written to it into a stream in the Snappy
	// framing format on another writer. `close` writes what is pending.
	type Writer {
		internal sink    io.Writer
		internal pending byte[]
		internal started bool
		internal closed  bool

		def new(sink io.Writer) {
			self.sink = sink
			pending = []
			started = false
			closed = false
		}

		// write implements std.io.Writer: the bytes go out in chunks of
		// 64 KiB.
		// Fails when the stream is closed or the sink fails.
		def write(p byte[]) !int {
			fail "snappy: the stream is closed" when closed
			let held = pending.len()
			pending.len(held + p.len())
			mem.copyN(pending[held:], p, p.len()) when p.len() > 0
			let at = 0
			for pending.len() - at >= 65536 {
				try chunk(pending[at:at + 65536])
				at += 65536
			}
			pending = pending[at:].clone() when at > 0
			return p.len()
		}

		// flush writes the bytes held back for a full chunk.
		// Fails when the stream is closed or the sink fails.
		def flush() !none {
			fail "snappy: the stream is closed" when closed
			try chunk(pending) when pending.len() > 0
			pending = []
			return none
		}

		// close writes what is pending and ends the stream. It does not
		// close the sink.
		// Fails when the stream is closed already or the sink fails.
		def close() !none {
			try flush()
			try identifier() unless started
			closed = true
			return none
		}

		internal def identifier() !none {
			started = true
			try sink.write(byte[0xFF, 0x06, 0x00, 0x00, 0x73, 0x4E, 0x61, 0x50, 0x70, 0x59])
			return none
		}

		// Writes one chunk: compressed, or as it is when that is not smaller.
		internal def chunk(data byte[]) !none {
			try identifier() unless started
			let packed = compress(data)
			let stored = packed.len() >= data.len()
			let body = stored ?? (data, packed)
			let size = body.len() + 4
			let sum = maskedChecksum(data)
			try sink.write(byte[
				byte(stored ?? (1, 0)),
				byte(size & 0xFF),
				byte((size >> 8) & 0xFF),
				byte((size >> 16) & 0xFF),
				byte(sum & 0xFF),
				byte((sum >> 8) & 0xFF),
				byte((sum >> 16) & 0xFF),
				byte((sum >> 24) & 0xFF),
			])
			try sink.write(body)
			return none
		}
	}

	// The checksum a framed chunk carries: the CRC-32C of its data, rotated
	// and offset so that a checksum of data holding checksums stays strong.
	internal def maskedChecksum(data byte[]) uint32 {
		let c = crc32c(data)
		return ((c >> 15) | (c << 17)) + 0xA282EAD8
	}

	// The length a block starts with and the number of bytes it takes.
	internal def preamble(src byte[]) !(int, int) {
		let length = 0
		let shift = 0
		for let i = 0; i < src.len() && i < 5; i++ {
			let b = int(src[i])
			length |= (b & 0x7F) << shift
			if b & 0x80 == 0 {
				fail "snappy: the block's length does not fit 32 bits" when length > 0xFFFFFFFF
				return (length, i + 1)
			}
			shift += 7
		}
		fail "snappy: the block does not start with a valid length"
	}

	internal def le32At(p byte[], at int) uint32 {
		return uint32(p[at]) | (uint32(p[at + 1]) << 8) | (uint32(p[at + 2]) << 16) | (uint32(p[at + 3]) << 24)
	}

	// Compresses `src[from:to]` (at most 64 KiB) as elements appended to
	// `out`: a hash table of the last position of each 4-byte sequence finds
	// the copies.
	internal def encodePiece(src byte[], from int, to int, out byte[]) {
		let anchor = from
		if to - from >= 16 {
			let table int[] = []
			table.len(16384)
			table.fill(-1)
			let limit = to - 4
			let pos = from
			let misses = 0
			for pos <= limit {
				let word = le32At(src, pos)
				let slot = int(((word * 0x1E35A7BD) >> 18) & 0x3FFF)
				let found = table[slot]
				table[slot] = pos
				if found < 0 || le32At(src, found) != word {
					misses++
					pos += 1 + (misses >> 5)
					continue
				}
				misses = 0
				let length = 4
				for pos + length < to && src[found + length] == src[pos + length] {
					length++
				}
				emitLiteral(src, anchor, pos - anchor, out)
				emitCopy(pos - found, length, out)
				pos += length
				anchor = pos
			}
		}
		emitLiteral(src, anchor, to - anchor, out)
	}

	internal def emitLiteral(src byte[], at int, count int, out byte[]) {
		return when count == 0
		let n = count - 1
		if n < 60 {
			out.push(byte(n << 2))
		} else if n < 256 {
			out.push(byte(60 << 2), byte(n))
		} else if n < 65536 {
			out.push(byte(61 << 2), byte(n & 0xFF), byte(n >> 8))
		} else {
			out.push(byte(62 << 2), byte(n & 0xFF), byte((n >> 8) & 0xFF), byte(n >> 16))
		}
		if count >= 32 {
			let start = out.len()
			out.len(start + count)
			mem.copyN(out[start:], src[at:], count)
			return
		}
		for let i = 0; i < count; i++ {
			out.push(src[at + i])
		}
	}

	// Appends copies for a match of `length` bytes `offset` back (below
	// 65536): pieces of at most 64, the short form where it fits.
	internal def emitCopy(offset int, length int, out byte[]) {
		let left = length
		for left >= 68 {
			out.push(byte((63 << 2) | 2), byte(offset & 0xFF), byte(offset >> 8))
			left -= 64
		}
		if left > 64 {
			out.push(byte((59 << 2) | 2), byte(offset & 0xFF), byte(offset >> 8))
			left -= 60
		}
		if left >= 12 || offset >= 2048 {
			out.push(byte(((left - 1) << 2) | 2), byte(offset & 0xFF), byte(offset >> 8))
			return
		}
		out.push(byte(((offset >> 8) << 5) | ((left - 4) << 2) | 1), byte(offset & 0xFF))
	}
}
