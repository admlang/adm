partial module std.data.compress.snappy {
	use (
		std.bytes
		std.data.encoding::(hexdecode)
		std.testing
	)

	// A buffer of the length with runs, repeats and noise in it.
	internal def sample(length int, seed int) byte[] {
		let out byte[] = []
		let state = uint32(seed * 2654435761 + 1)
		for out.len() < length {
			state = state * uint32(1664525) + uint32(1013904223)
			let pick = int((state >> 24) & uint32(0xFF))
			let run = int((state >> 8) & uint32(0x3F)) + 1
			if pick < 90 {
				for let i = 0; i < run && out.len() < length; i++ {
					out.push(byte(pick))
				}
			} else if pick < 170 && out.len() > 100 {
				let back = out.len() - 1 - int((state >> 12) & uint32(0x3F))
				for let i = 0; i < run * 3 && out.len() < length; i++ {
					out.push(out[back + i])
				}
			} else {
				for let i = 0; i < run && out.len() < length; i++ {
					state = state * uint32(1664525) + uint32(1013904223)
					out.push(byte((state >> 16) & uint32(0xFF)))
				}
			}
		}
		return out
	}

	internal def readAll(source bytes.Reader) !byte[] {
		let reader = new Reader(source)
		let out byte[] = []
		let chunk byte[] = []
		chunk.len(7001)
		for {
			let n = try reader.read(chunk)
			break when n == 0
			out.push(...chunk[0:n])
		}
		return out
	}

	check "Snappy" {
		// A block and two streams written by the reference implementation.
		@test()
		def TestReadsReferenceData() !none {
			let phrase = "hello hello hello hello, Snappy! "
			let text = (phrase + phrase + phrase).bytes()
			let block = try hexdecode("631468656c6c6f20420600202c20536e6170707921461b000912aa2100")
			assert (try decompressedLength(block)) == 99
			assert (try decompress(block)).equals(text)
			let framed = try hexdecode("ff060000734e6150705900210000a90fe535631468656c6c6f20420600202c20536e6170707921461b000912aa2100")
			assert (try readAll(new bytes.Reader(framed))).equals(text)
			let stored = try hexdecode("ff060000734e61507059012c000075118983000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f2021222324252627")
			let counted = try readAll(new bytes.Reader(stored))
			assert counted.len() == 40 && counted[39] == byte(39)

			// A padding chunk and a skippable one between data are passed over.
			let padded byte[] = []
			padded.push(...framed)
			padded.push(byte(0xFE), byte(2), byte(0), byte(0), byte(0), byte(0), byte(0x80), byte(1), byte(0), byte(0), byte(9))
			padded.push(...stored[10:])
			assert (try readAll(new bytes.Reader(padded))).len() == 139
			assert (try readAll(new bytes.Reader(byte[]))).len() == 0
			return none
		}

		@test()
		def TestRoundTrips() !none {
			for let (_, length) in int[0, 1, 3, 15, 16, 17, 60, 61, 300, 70000, 65536, 65537, 400000] {
				let data = sample(length, length + 5)
				let back = try decompress(compress(data))
				fail "a block of {length} bytes came back different" unless back.equals(data)
			}
			let flat byte[] = []
			flat.len(200000)
			assert compress(flat).len() < 10000
			assert (try decompress(compress(flat))).equals(flat)
			return none
		}

		@test()
		def TestStreams() !none {
			let data = sample(700000, 4)
			let sink = new bytes.Buffer()
			let writer = new Writer(sink)
			let at = 0
			let step = 1
			for at < data.len() {
				let end = (at + step).min(data.len())
				try writer.write(data[at:end])
				at = end
				step = step * 5 + 1
				step = 150000 when step > 150000
				try writer.flush() when step == 31
			}
			try writer.close()
			assert writer.write(data[0:1]) is error && writer.close() is error
			let back = try readAll(new bytes.Reader(sink.bytes()))
			assert back.len() == data.len() && back.equals(data)

			let nothing = new bytes.Buffer()
			try new Writer(nothing).close()
			assert nothing.bytes().len() == 10
			assert (try readAll(new bytes.Reader(nothing.bytes()))).len() == 0
			return none
		}

		@test()
		def TestRefusesDamagedData() !none {
			let good = compress(sample(5000, 2))
			assert decompress(good[0:good.len() - 2].clone()) is error
			assert decompress(byte[]) is error
			assert decompress(byte[0x80, 0x80, 0x80, 0x80, 0x80, 0x01]) is error
			// A copy that reaches before the start of the data.
			assert decompress(byte[0x08, 0x00, 0x61, 0x15, 0x09]) is error
			// More data than the length says, and less.
			assert decompress(byte[0x01, 0x04, 0x61, 0x62]) is error
			assert decompress(byte[0x05, 0x04, 0x61, 0x62]) is error

			let sink = new bytes.Buffer()
			let writer = new Writer(sink)
			try writer.write(sample(3000, 8))
			try writer.close()
			let stream = sink.bytes()
			let bent = stream.clone()
			bent[bent.len() - 1] = bent[bent.len() - 1] ^ byte(1)
			assert readAll(new bytes.Reader(bent)) is error
			assert readAll(new bytes.Reader(stream[10:].clone())) is error
			assert readAll(new bytes.Reader(stream[0:stream.len() - 5].clone())) is error
			let unknown = stream.clone()
			unknown[10] = byte(0x02)
			assert readAll(new bytes.Reader(unknown)) is error
			return none
		}
	}
}
