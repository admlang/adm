internal partial module std.data.compress.xz.container {
	// The little-endian uint32 at b[at:at+4].
	def le32(b byte[], at int) uint32 {
		return uint32(b[at]) | uint32(b[at + 1]) << 8 | uint32(b[at + 2]) << 16 | uint32(b[at + 3]) << 24
	}

	// The low n bytes of v, least significant first.
	def le(v uint64, n int) byte[] {
		let out byte[] = []
		out.len(n)
		for let i = 0; i < n; i++ {
			out[i] = byte(v >> uint64(8 * i))
		}
		return out
	}

	// Reads the variable-length number at b[at:] and returns it with the
	// offset after it. Fails when it runs past b or takes more than 9 bytes.
	def varint(b byte[], at int) !(int64, int) {
		let v = int64(0)
		for let i = 0; i < 9; i++ {
			fail "xz: invalid number" when at + i >= b.len()
			let c = b[at + i]
			v |= int64(c & 0x7F) << (7 * i)
			if c & 0x80 == 0 {
				fail "xz: invalid number" when c == 0 && i > 0
				return (v, at + i + 1)
			}
		}
		fail "xz: invalid number"
	}

	// The size in bytes of the check value with the given ID.
	def checkSize(id int) int {
		return 0 when id == 0
		return 4 << ((id - 1) / 3)
	}

	// The dictionary size an LZMA2 properties byte encodes. Fails when it is
	// out of range.
	def lzma2DictSize(props byte) !int {
		let bits = int(props & 0x3F)
		fail "lzma2: invalid dictionary size" when bits > 40
		return 0xFFFFFFFF when bits == 40
		return (2 | (bits & 1)) << (bits / 2 + 11)
	}
}
