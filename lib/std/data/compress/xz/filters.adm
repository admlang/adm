internal std partial module std.data.compress.xz.filters {
	use std.io

	const x86MaskBit = uint32[0, 1, 2, 2, 3, 3, 3, 3]

	// DeltaReader undoes the delta filter, which stores every byte as its
	// difference from the byte `distance` (1 to 256) positions before it.
	type DeltaReader {
		internal r        io.Reader
		internal distance int
		internal history  byte[]
		internal pos      int

		def new(r io.Reader, distance int) {
			self.r = r
			self.distance = distance
			history.len(256)
			history.fill(0)
		}

		// Implements std.io.Reader. Fails when the underlying reader does.
		def read(p byte[]) !int {
			let n = try r.read(p)
			let d = distance
			let h = history
			let at = pos
			for let i = 0; i < n; i++ {
				let b = p[i] + h[(at - d) & 0xFF]
				p[i] = b
				h[at & 0xFF] = b
				at++
			}
			pos = at & 0xFF
			return n
		}
	}

	// X86Reader undoes the x86 branch filter (BCJ), which turns the relative
	// targets of CALL and JMP instructions into absolute ones so they
	// compress better. `start` is the offset the filtered data starts at.
	type X86Reader {
		internal r        io.Reader
		internal buf      byte[]
		// buf[head:ready] is filtered and waiting to be read, buf[ready:tail]
		// still needs more bytes behind it before it can be filtered.
		internal head     int
		internal ready    int
		internal tail     int
		internal nowPos   uint32
		internal prevMask uint32
		internal prevPos  uint32
		internal eof      bool

		def new(r io.Reader, start uint32 = 0) {
			self.r = r
			buf.len(64 * 1024)
			nowPos = start
			prevPos = uint32(0) - 5
		}

		// Implements std.io.Reader. Fails when the underlying reader does.
		def read(p byte[]) !int {
			return 0 when p.len() == 0
			for head == ready {
				return 0 when eof && ready == tail
				if eof {
					ready = tail
					break
				}
				// Keep the unfiltered tail and read more behind it.
				let left = tail - ready
				(buf[ready:tail]).copy(buf[0:left])
				head = 0
				ready = 0
				tail = left
				let n = try r.read(buf[tail:])
				if n <= 0 {
					eof = true
					continue
				}
				tail += n
				let done = filter(buf[0:tail])
				ready = done
			}
			let k = (buf[head:ready]).copy(p)
			head += k
			return k
		}

		// Filters the complete instructions in b and returns how many bytes
		// are final.
		internal def filter(b byte[]) int {
			let size = b.len()
			return 0 when size < 5
			let mask = prevMask
			let prev = prevPos
			let now = nowPos
			prev = now - 5 when now - prev > 5
			let limit = size - 5
			let i = 0
			for i <= limit {
				let op = b[i]
				if op != 0xE8 && op != 0xE9 {
					i++
					continue
				}
				let offset = now + uint32(i) - prev
				prev = now + uint32(i)
				if offset > 5 {
					mask = 0
				} else {
					for let k = uint32(0); k < offset; k++ {
						mask &= 0x77
						mask <<= 1
					}
				}
				let hi = b[i + 4]
				if (hi == 0 || hi == 0xFF) && allowed(mask >> 1) && (mask >> 1) < 0x10 {
					let src = uint32(hi) << 24 | uint32(b[i + 3]) << 16 | uint32(b[i + 2]) << 8 | uint32(b[i + 1])
					let dest = uint32(0)
					for {
						dest = src - (now + uint32(i) + 5)
						break when mask == 0
						let bitNum = maskBit(mask >> 1)
						let t = byte(dest >> (24 - bitNum * 8))
						break unless t := 0 || 0xFF
						src = dest ^ ((uint32(1) << (32 - bitNum * 8)) - 1)
					}
					b[i + 4] = ((dest >> 24) & 1 == 1) ?? (byte(0xFF), byte(0))
					b[i + 3] = byte(dest >> 16)
					b[i + 2] = byte(dest >> 8)
					b[i + 1] = byte(dest)
					i += 5
					mask = 0
				} else {
					i++
					mask |= 1
					mask |= 0x10 when hi := 0 || 0xFF
				}
			}
			prevMask = mask
			prevPos = prev
			nowPos = now + uint32(i)
			return i
		}

		internal def allowed(m uint32) bool {
			let v = m & 7
			return v == 0 || v == 1 || v == 2 || v == 4
		}

		internal def maskBit(m uint32) uint32 {
			return x86MaskBit[int(m)]
		}
	}
}
