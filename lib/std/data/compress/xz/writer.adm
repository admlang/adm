partial module std.data.compress.xz {
	use (
		std.io
		std.crypto.hash
		std.data.compress.lzma
		std.data.compress.xz.container::*
	)

	// Level is how hard the compressor works, from BestSpeed (1) to
	// BestCompression (9); `Level(n)` picks any level in between.
	enum Level {
		BestSpeed = 1,
		DefaultCompression = 6,
		BestCompression = 9,
	}

	// Writer compresses what is written to it into an .xz stream on an
	// io.Writer: one LZMA2 block with a CRC64 check, then the index and
	// footer, which `close` writes.
	type Writer {
		internal w       io.Writer
		internal level   Level
		internal counter CountingWriter
		internal lz      lzma.Writer2
		internal crc64   hash.CRC64
		internal size    int64
		internal started bool
		internal inBlock bool
		internal closed  bool

		def new(w io.Writer, level Level = Level.DefaultCompression) {
			self.w = w
			self.level = level
			counter = new CountingWriter(w)
			lz = new lzma.Writer2(counter, lzma.Level(int(level)))
			crc64 = new hash.CRC64()
		}

		// reset starts a new stream on w at the same level.
		def reset(w io.Writer) {
			self.w = w
			counter = new CountingWriter(w)
			lz = new lzma.Writer2(counter, lzma.Level(int(level)))
			crc64.reset()
			size = 0
			started = false
			inBlock = false
			closed = false
		}

		internal def streamHeader() !none {
			return none when started
			started = true
			let flags = byte[0x00, 0x04]
			let h = byte[0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00] + flags + le(uint64(hash.crc32(flags)), 4)
			try w.write(h)
		}

		internal def blockHeader() !none {
			return none when inBlock
			inBlock = true
			let h = byte[0x02, 0x00, 0x21, 0x01] + lz.properties() + byte[0, 0, 0]
			try w.write(h + le(uint64(hash.crc32(h)), 4))
			counter.n = 0
		}

		// write compresses p and returns how many bytes were taken. Fails when
		// the writer is closed or the underlying writer fails.
		def write(p byte[]) !int {
			fail "xz: write to a closed writer" when closed
			return 0 when p.len() == 0
			try streamHeader()
			try blockHeader()
			crc64.write(p)
			size += int64(p.len())
			try lz.write(p)
			return p.len()
		}

		// flush ends the current LZMA2 chunk so everything written so far
		// reaches the underlying writer. Fails when it does.
		def flush() !none {
			return none when closed || !inBlock
			try lz.flush()
		}

		// close ends the block and writes the index and stream footer; closing
		// again does nothing. It does not close the underlying writer. Fails
		// when that writer does.
		def close() !none {
			return none when closed
			closed = true
			try streamHeader()
			let index byte[] = [0x00]
			if inBlock {
				try lz.close()
				let packed = counter.n
				let pad = int((4 - packed % 4) % 4)
				let tail byte[] = []
				tail.len(pad)
				tail.fill(0)
				try w.write(tail + le(crc64.checksum ^ 0xFFFFFFFFFFFFFFFF, 8))
				index = index + number(1) + number(12 + packed + 8) + number(size)
			} else {
				index = index + number(0)
			}
			for index.len() % 4 != 0 {
				index.push(0)
			}
			index = index + le(uint64(hash.crc32(index)), 4)
			let back = le(uint64(index.len() / 4 - 1), 4) + byte[0x00, 0x04]
			try w.write(index + le(uint64(hash.crc32(back)), 4) + back + byte[0x59, 0x5A])
		}

		internal def number(v int64) byte[] {
			let out byte[] = []
			let x = uint64(v)
			for x >= 0x80 {
				out.push(byte(x & 0x7F) | 0x80)
				x >>= 7
			}
			out.push(byte(x))
			return out
		}
	}

	// CountingWriter passes writes through and counts the bytes.
	internal type CountingWriter {
		w io.Writer
		n int64

		def new(w io.Writer) {
			self.w = w
		}

		// Implements std.io.Writer. Fails when the underlying writer does.
		def write(p byte[]) !int {
			let k = try w.write(p)
			n += int64(k)
			return k
		}
	}
}
