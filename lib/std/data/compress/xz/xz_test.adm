partial module std.data.compress.xz {
	check "XZ" {
		use (
			std.testing
			std.bytes
			std.io
		)

		// "hello " twenty times, written by the system xz with its default
		// CRC64 check.
		def helloCrc64() byte[] {
			return byte[
			0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x04, 0xe6, 0xd6, 0xb4, 0x46, 0x04, 0xc0, 0x14, 0x78,
			0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x72, 0x29, 0xb5, 0x4b,
			0xe0, 0x00, 0x77, 0x00, 0x0c, 0x5d, 0x00, 0x34, 0x19, 0x49, 0xee, 0x8d, 0xe9, 0x5a, 0x55, 0x6d,
			0x2f, 0x00, 0x00, 0x00, 0x06, 0xea, 0xbd, 0x8e, 0x88, 0x67, 0x76, 0x6b, 0x00, 0x01, 0x30, 0x78,
			0xd6, 0x7a, 0x1e, 0xa1, 0x1f, 0xb6, 0xf3, 0x7d, 0x01, 0x00, 0x00, 0x00, 0x00, 0x04, 0x59, 0x5a,
			]
		}

		// The same text with a SHA-256 check.
		def helloSha256() byte[] {
			return byte[
			0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x0a, 0xe1, 0xfb, 0x0c, 0xa1, 0x04, 0xc0, 0x14, 0x78,
			0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x72, 0x29, 0xb5, 0x4b,
			0xe0, 0x00, 0x77, 0x00, 0x0c, 0x5d, 0x00, 0x34, 0x19, 0x49, 0xee, 0x8d, 0xe9, 0x5a, 0x55, 0x6d,
			0x2f, 0x00, 0x00, 0x00, 0x79, 0xac, 0x00, 0xbf, 0x56, 0x02, 0x60, 0xc0, 0x75, 0x62, 0xd5, 0xa7,
			0x75, 0x57, 0xff, 0xc0, 0x21, 0x58, 0xaa, 0x5d, 0x59, 0x82, 0x59, 0xe7, 0xc3, 0x05, 0xd9, 0xdd,
			0x82, 0x90, 0x78, 0xf8, 0x00, 0x01, 0x48, 0x78, 0x28, 0x89, 0xf8, 0x46, 0x18, 0x9b, 0x4b, 0x9a,
			0x01, 0x00, 0x00, 0x00, 0x00, 0x0a, 0x59, 0x5a,
			]
		}

		// The same text with a CRC32 check.
		def helloCrc32() byte[] {
			return byte[
			0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x01, 0x69, 0x22, 0xde, 0x36, 0x04, 0xc0, 0x14, 0x78,
			0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x72, 0x29, 0xb5, 0x4b,
			0xe0, 0x00, 0x77, 0x00, 0x0c, 0x5d, 0x00, 0x34, 0x19, 0x49, 0xee, 0x8d, 0xe9, 0x5a, 0x55, 0x6d,
			0x2f, 0x00, 0x00, 0x00, 0x2f, 0xfa, 0xf8, 0x48, 0x00, 0x01, 0x2c, 0x78, 0x8b, 0x27, 0x69, 0x47,
			0x90, 0x42, 0x99, 0x0d, 0x01, 0x00, 0x00, 0x00, 0x00, 0x01, 0x59, 0x5a,
			]
		}

		// The same text in 64-byte blocks, whose headers record their sizes.
		def helloBlocks() byte[] {
			return byte[
			0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x04, 0xe6, 0xd6, 0xb4, 0x46, 0x02, 0xc0, 0x14, 0x40,
			0x21, 0x01, 0x16, 0x00, 0xe0, 0x48, 0x7a, 0x2e, 0xe0, 0x00, 0x3f, 0x00, 0x0c, 0x5d, 0x00, 0x34,
			0x19, 0x49, 0xee, 0x8d, 0xe9, 0x58, 0x6c, 0x69, 0x2f, 0x00, 0x00, 0x00, 0xd9, 0xce, 0x28, 0xa5,
			0x80, 0x41, 0xbf, 0xe3, 0x02, 0xc0, 0x14, 0x38, 0x21, 0x01, 0x16, 0x00, 0xee, 0xe3, 0xd8, 0xe7,
			0xe0, 0x00, 0x37, 0x00, 0x0c, 0x5d, 0x00, 0x37, 0x88, 0x09, 0x06, 0x94, 0x22, 0xfe, 0xc0, 0xad,
			0x53, 0x00, 0x00, 0x00, 0x32, 0x4a, 0x3c, 0xcc, 0xf4, 0xe8, 0xa1, 0xc7, 0x00, 0x02, 0x28, 0x40,
			0x28, 0x38, 0x00, 0x00, 0xab, 0x22, 0x4f, 0x0e, 0xb1, 0xc4, 0x67, 0xfb, 0x02, 0x00, 0x00, 0x00,
			0x00, 0x04, 0x59, 0x5a,
			]
		}

		// `code()` through the x86, delta (distance 16) and LZMA2 filters.
		def codeFiltered() byte[] {
			return byte[
			0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x04, 0xe6, 0xd6, 0xb4, 0x46, 0x04, 0xc2, 0x20, 0x80,
			0x08, 0x04, 0x00, 0x03, 0x01, 0x0f, 0x21, 0x01, 0x0c, 0x00, 0x00, 0x00, 0x1f, 0x69, 0x82, 0x77,
			0xe0, 0x03, 0xff, 0x00, 0x18, 0x5d, 0x00, 0x2a, 0x92, 0x0d, 0xa4, 0xe4, 0xbe, 0x54, 0x0e, 0xe6,
			0x50, 0x43, 0xbd, 0xb4, 0xb7, 0xac, 0x0a, 0x09, 0x0b, 0xf8, 0xad, 0x67, 0x09, 0x15, 0x00, 0x00,
			0x43, 0x56, 0xe8, 0xc7, 0xff, 0x4d, 0xa0, 0xc1, 0x00, 0x01, 0x3c, 0x80, 0x08, 0x00, 0x00, 0x00,
			0x76, 0x8b, 0xbf, 0xc4, 0xb1, 0xc4, 0x67, 0xfb, 0x02, 0x00, 0x00, 0x00, 0x00, 0x04, 0x59, 0x5a,
			]
		}

		// 64 fake x86 routines, each with a CALL whose target the x86 filter
		// rewrites.
		def code() byte[] {
			let out byte[] = []
			for let i = 0; i < 64; i++ {
				let target = uint32(0x1000 - i * 16)
				out.push(0x55, 0x48, 0x89, 0xE5, 0xE8)
				out.push(byte(target), byte(target >> 8), byte(target >> 16), byte(target >> 24))
				out.push(0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90)
			}
			return out
		}

		def hello() string {
			return "hello ".repeat(20)
		}

		def decode(data byte[]) !byte[] {
			let out = new bytes.Buffer()
			try out.readFrom(new Reader(new bytes.Reader(data)))
			return out.bytes()
		}

		def fails(data byte[]) bool {
			let failed = false
			decode(data) onerror (e error) {
				failed = true
				recover []
			}
			return failed
		}

		@test()
		def readsEveryCheckType() !none {
			assert string(try decode(helloCrc64())) == hello()
			assert string(try decode(helloSha256())) == hello()
			assert string(try decode(helloCrc32())) == hello()
		}

		@test()
		def readsSeveralBlocks() !none {
			assert string(try decode(helloBlocks())) == hello()
		}

		@test()
		def readsFilterChains() !none {
			assert (try decode(codeFiltered())).equals(code())
		}

		@test()
		def readsConcatenatedStreamsAndPadding() !none {
			let padded = helloCrc64() + byte[0, 0, 0, 0] + helloSha256()
			assert string(try decode(padded)) == hello() + hello()
		}

		@test()
		def rejectsCorruptData() !none {
			for let data in [helloCrc64(), helloSha256(), helloCrc32()] {
				// The last byte of the check value, just before the index.
				let bad = data.clone()
				let at = data.len() - 12 - 12 - 1
				bad[at] = bad[at] ^ 0x01
				assert fails(bad)
				assert fails(data[0:data.len() - 1])
			}
			assert fails(helloCrc64() + byte[0, 0])
			assert fails("plain text".bytes())
		}

		def encode(data byte[], level Level) !byte[] {
			let out = new bytes.Buffer()
			let w = new Writer(out, level)
			try w.write(data)
			try w.close()
			return out.bytes()
		}

		@test()
		def roundTrips() !none {
			let text = hello().repeat(50).bytes()
			for let level in [Level.BestSpeed, Level.DefaultCompression, Level.BestCompression] {
				let packed = try encode(text, level)
				assert packed.len() < text.len() / 4
				assert (try decode(packed)).equals(text)
			}
			assert (try decode(try encode([], Level.BestSpeed))).len() == 0
			assert (try decode(try encode(code(), Level.BestSpeed))).equals(code())
		}

		@test()
		def flushesAndResets() !none {
			let first = new bytes.Buffer()
			let w = new Writer(first, Level.BestSpeed)
			try w.write("hello ".bytes())
			try w.flush()
			try w.write("world".bytes())
			try w.close()
			let second = new bytes.Buffer()
			w.reset(second)
			try w.write("again".bytes())
			try w.close()
			let r = new Reader(new bytes.Reader(first.bytes()))
			let out = new bytes.Buffer()
			try out.readFrom(r)
			r.reset(new bytes.Reader(second.bytes()))
			try out.readFrom(r)
			assert string(out.bytes()) == "hello worldagain"
		}
	}
}
