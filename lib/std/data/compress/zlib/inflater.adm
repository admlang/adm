partial module std.data.compress.zlib {
	use (
		std.data.compress.flate
		std.bytes
		std.crypto.hash
	)

	// Inflater decompresses a zlib stream that arrives in pieces, as a
	// connection that compresses its messages with a flush after each
	// sends it (SSH's `zlib`, MCCP): `feed` takes the next piece and
	// returns what it completes (see `flate.Inflater`). The Adler-32
	// trailer is checked when the stream ends.
	type Inflater {
		internal inner  flate.Inflater
		internal head   byte[]        = []
		internal dict   byte[]
		internal digest hash.Adler32
		internal done   bool          = false

		// A decompressor with the preset dictionary the stream may name.
		def new(dict byte[] = []) {
			self.dict = dict
			inner = new flate.Inflater()
			digest = new hash.Adler32()
		}

		// feed decodes `data` and returns every byte of output it
		// completes; after the trailer, nothing. Fails when the header,
		// data or checksum is wrong, or the stream names a dictionary this
		// decompressor was not given.
		def feed(data byte[]) !byte[] {
			return [] when done
			let rest = data
			if head.len() < 2 || (head[1] & 0x20) != 0 && head.len() < 6 {
				let want = head.len() < 2 ?? (2, 6)
				let take = want - head.len()
				take = rest.len() when rest.len() < take
				head = head + rest[:take]
				rest = rest[take:]
				return [] when head.len() < want
				if want == 2 {
					let header = (uint16(head[0]) << 8) | uint16(head[1])
					fail "zlib: invalid header" when (head[0] & 0x0F) != zlibDeflate || (head[0] >> 4) > zlibMaxWindow || int(header) % 31 != 0
					if (head[1] & 0x20) != 0 {
						return try feed(rest)
					}
				} else {
					let checksum = uint32(0).fromBytes(head[2:6], bytes.Endian.Big)
					fail "zlib: invalid dictionary" when checksum != hash.adler32(dict)
				}
				inner = new flate.Inflater(dict) when dict.len() > 0
			}
			let out = try inner.feed(rest)
			digest.write(out)
			if inner.finished() {
				let trailer = inner.unused()
				if trailer.len() >= 4 {
					done = true
					fail "zlib: invalid checksum" when uint32(0).fromBytes(trailer[:4], bytes.Endian.Big) != digest.checksum
				}
			}
			return out
		}

		// Whether the stream and its trailer have been read.
		def finished() bool {
			return done
		}
	}
}
