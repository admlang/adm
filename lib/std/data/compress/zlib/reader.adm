partial module std.data.compress.zlib {
	use (
		std.data.compress.flate
		std.io
		std.bytes
		std.time
		std.crypto.hash
	)

	type Reader {
		internal r            io.Reader
		internal decompressor flate.Reader
		internal digest       hash.Adler32
		internal dict         byte[]
		internal scratch      byte[]
		internal hdrRead      bool
		internal finished     bool

		def new(r io.Reader, dict byte[] = []) {
			reset(r, dict)
		}

		def reset(r io.Reader, dict byte[] = []) {
			self.r = r
			self.dict = dict
			digest = new hash.Adler32()
			scratch.len(4)
			hdrRead = false
			finished = false
		}

		def read(p byte[]) !int {
			fail Error{message: "EOF"} when finished
			if !hdrRead {
				try readHeader()
			}

			let eof = false
			let n = decompressor.read(p) onerror (e error) {
				if e.message == "EOF" {
					eof = true
					recover 0
				}
				fail e
			}
			if n > 0 {
				digest.write(p[:n])
				return n
			}
			if eof {
				try readTrailer()
				finished = true
				fail Error{message: "EOF"}
			}
			return n
		}

		def close() !none {
			return try decompressor.close()
		}

		internal def readHeader() !none {
			try readFull(scratch[:2])
			let cmf = scratch[0]
			let flg = scratch[1]
			let header = (uint16(cmf) << 8) | uint16(flg)
			if (cmf & 0x0F) != zlibDeflate || (cmf >> 4) > zlibMaxWindow || (int(header) % 31) != 0 {
				fail "zlib: invalid header"
			}

			let hasDict = (flg & 0x20) != 0
			if hasDict {
				try readFull(scratch[:4])
				let checksum = uint32(0).fromBytes(scratch[:4], bytes.Endian.Big)
				fail "zlib: invalid dictionary" when checksum != hash.adler32(dict)
				decompressor = new flate.Reader(r, dict)
			} else {
				decompressor = new flate.Reader(r)
			}

			digest.reset()
			hdrRead = true
		}

		internal def readTrailer() !none {
			try readFull(scratch[:4])
			let checksum = uint32(0).fromBytes(scratch[:4], bytes.Endian.Big)
			fail "zlib: invalid checksum" when checksum != digest.checksum
		}

		internal def readFull(out byte[]) !int {
			let total = 0
			for total < out.len() {
				let n = r.read(out[total:]) onerror (e error) {
					fail e
				}
				fail "zlib: unexpected EOF" when n == 0
				total += n
			}
			return total
		}
	}

	// Decompresses a whole zlib stream held in memory. `sizeHint` presizes the
	// result when the caller knows the decompressed length.
	def decompress(src byte[], sizeHint int = 0) !byte[] {
		let buf = new bytes.Buffer(src)
		let zr = new Reader(buf)

		let out byte[]
		if sizeHint > 0 {
			out.len(sizeHint)
			out[:] = 0
		}

		let chunk byte[]
		chunk.len(65536)
		let off = 0
		for {
			// The stream ends with an error rather than a zero read.
			let n = zr.read(chunk) onerror recover 0
			break when n <= 0
			for let i = 0; i < n; i++ {
				if off < out.len() {
					out[off] = chunk[i]
				} else {
					out.push(chunk[i])
				}
				off++
			}
		}
		out.len(off) when off < out.len()
		return out
	}
}
