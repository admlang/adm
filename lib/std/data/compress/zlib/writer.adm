// Portions adapted from Go's compress/zlib package (BSD-style license).
partial module std.data.compress.zlib {
	use (
		std.data.compress.flate
		std.io
		std.crypto.hash
		std.bytes
	)

	internal const (
		zlibDeflate   = 8
		zlibMaxWindow = 7
	)

	enum Level {
		DefaultCompression = -1,
		NoCompression = 0,
		BestSpeed = 1,
		BestCompression = 9,
		HuffmanOnly = -2,
	}

	type Writer {
		internal w           io.Writer
		internal level       Level
		internal dict        byte[]
		internal compressor  flate.Writer
		internal digest      hash.Adler32
		internal err         ?error = none
		internal wroteHeader bool
		internal closed      bool
		internal buf         byte[]

		def new(w io.Writer, lvl Level = Level.DefaultCompression, dict byte[] = []) {
			lvl = Level.DefaultCompression when lvl < Level.HuffmanOnly || lvl > Level.BestCompression
			init(w, lvl, dict)
		}

		internal def init(w io.Writer, lvl Level, dict byte[]) {
			self.w = w
			level = lvl
			self.dict = dict
			err = none
			closed = false
			wroteHeader = false
			buf.len(4)
			digest = new hash.Adler32()
			if dict.len() > 0 {
				compressor = new flate.Writer(w, int(level), dict)
			} else {
				compressor = new flate.Writer(w, int(level))
			}
		}

		def reset(w io.Writer) {
			self.w = w
			compressor.reset(w)
			digest.reset()
			err = none
			closed = false
			wroteHeader = false
			buf[:] = 0
		}

		def write(p byte[]) !int {
			fail err unless err is none
			fail "zlib: writer is closed" when closed
			if !wroteHeader {
				try writeHeader()
			}
			return 0 when p.len() == 0
			digest.write(p)
			return try compressor.write(p)
		}

		def flush() !none {
			fail err unless err is none
			return none when closed
			if !wroteHeader {
				try writeHeader()
			}
			return try compressor.flush()
		}

		def close() !none {
			fail err unless err is none
			return none when closed
			closed = true
			if !wroteHeader {
				try writeHeader()
			}
			try compressor.close()
			digest.checksum.bytes(bytes.Endian.Big).copy(buf[:4])
			try w.write(buf[:4])
			return none
		}

		internal def writeHeader() !none {
			wroteHeader = true
			let flg byte = 0
			let lvl = int(level)
			switch {
				case lvl == int(Level.HuffmanOnly) || lvl == int(Level.NoCompression) || lvl == int(Level.BestSpeed):
					flg = byte(0 << 6)
				case lvl == int(Level.DefaultCompression) || lvl == 6:
					flg = byte(2 << 6)
				case 2 <= lvl && lvl <= 5:
					flg = byte(1 << 6)
				case 7 <= lvl && lvl <= 9:
					flg = byte(3 << 6)
				default:
					flg = byte(2 << 6)
			}
			if dict.len() > 0 {
				flg |= 1 << 5
			}
			let cmf = byte(0x78)
			let header = (uint16(cmf) << 8) | uint16(flg)
			flg += byte(31 - (int(header) % 31))
			buf[0] = cmf
			buf[1] = flg
			try w.write(buf[:2])
			if dict.len() > 0 {
				hash.adler32(dict).bytes(bytes.Endian.Big).copy(buf[:4])
				try w.write(buf[:4])
			}
			return none
		}
	}

	check "Zlib" {
		use std.testing
		use std.bytes

		@test()
		def testRoundTrip() !none {
			let buf = new bytes.Buffer()
			let w = new Writer(buf)
			_ = try w.write(byte[]("Hello, Zlib!"))
			try w.close()

			let r = new Reader(new bytes.Reader(buf.bytes()))
			let decoded = new bytes.Buffer()
			_ = try decoded.readFrom(r)
			assert string(decoded.bytes()) == "Hello, Zlib!"
		}
	}
}
