partial module std.data.compress.zlib {
	use (
		std.bytes
		std.testing
	)

	check "Zlib" {
		@test()
		def inflatesInPlace() !none {
			let input byte[]
			input.len(70000)
			for let i = 0; i < input.len(); i++ {
				input[i] = byte((i % 41) * 3 + (i / 1013) % 5)
			}
			let buffer = new bytes.Buffer()
			let w = new Writer(buffer, Level(6))
			try w.write(input)
			try w.close()
			let stream = buffer.bytes()
			let framed = byte[1, 2] + stream + byte[9, 9]
			let (out, used) = try inflate(framed, 2, input.len())
			assert out.hex() == input.hex() && used == stream.len()
			assert (try decompress(stream)).hex() == input.hex()
			let bad = stream.clone()
			bad[bad.len() - 1] = bad[bad.len() - 1] ^ 1
			let refused = false
			decompress(bad) onerror (err error) {
				refused = err.message == "zlib: invalid checksum"
				recover byte[]
			}
			assert refused
			return none
		}
	}
}
