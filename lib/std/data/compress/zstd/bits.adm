partial module std.data.compress.zstd {
	// Reads bits forwards, least significant first: the form of the FSE
	// table descriptions.
	internal type ForwardBits {
		data  byte[]
		// The next bit, counted from the start of `data`.
		at    int
		// The first bit past the readable data.
		limit int

		def new(data byte[], from int, to int) {
			self.data = data
			at = from * 8
			limit = to * 8
		}

		// The next `count` bits (at most 24). Fails past the end.
		def read(count int) !int {
			expects {
				assert at + count <= limit onerror fail "zstd: a table description runs past its data"
			}
			let index = at >> 3
			let word = int(data[index])
			word |= int(data[index + 1]) << 8 when index + 1 < data.len()
			word |= int(data[index + 2]) << 16 when index + 2 < data.len()
			word |= int(data[index + 3]) << 24 when index + 3 < data.len()
			let value = (word >> (at & 7)) & ((1 << count) - 1)
			at += count
			return value
		}

		// The index of the first byte no bit was read from.
		def byteAfter() int {
			return (at + 7) >> 3
		}
	}

	// Reads bits backwards from the end of a stream: the form of the Huffman
	// and sequence bitstreams. The last byte's highest set bit marks where
	// the data ends. Reading past the start gives zero bits and leaves
	// `offset` negative, which is how the decoders see the end.
	internal type BackwardBits {
		data   byte[]
		// The index of the stream's first byte.
		start  int
		// The bits not read yet, counted from the stream's first bit.
		offset int

		// A reader of the stream `data[from:to]`. `offset` is -1 when the
		// stream is empty or its last byte is zero, which no valid stream is.
		def new(data byte[], from int, to int) {
			self.data = data
			start = from
			offset = -1
			if to > from && data[to - 1] != byte(0) {
				let last = int(data[to - 1])
				let top = 7
				for (last >> top) & 1 == 0 {
					top--
				}
				offset = (to - from - 1) * 8 + top
			}
		}

		// The next `count` bits (at most 32), the first one read being the
		// most significant.
		def read(count int) int {
			offset -= count
			return 0 when count == 0
			let from = offset
			let width = count
			let shift = 0
			if from < 0 {
				// Bits before the start read as zero.
				shift = -from
				width = count - shift
				return 0 when width <= 0
				from = 0
			}
			let index = start + (from >> 3)
			let word = uint64(0)
			let end = data.len()
			if index + 8 <= end {
				word = uint64(data[index]) | (uint64(data[index + 1]) << 8) | (uint64(data[index + 2]) << 16) | (uint64(data[index + 3]) << 24) | (uint64(data[index + 4]) << 32) | (uint64(data[index + 5]) << 40)
			} else {
				for let i = 0; i < 6 && index + i < end; i++ {
					word |= uint64(data[index + i]) << uint64(8 * i)
				}
			}
			let value = int((word >> uint64(from & 7)) & ((uint64(1) << uint64(width)) - uint64(1)))
			return value << shift
		}
	}

	// The index of the highest set bit of a positive number.
	internal def highBit(value int) int {
		let at = 0
		let rest = value
		for rest > 1 {
			rest = rest >> 1
			at++
		}
		return at
	}
}
