partial module std.data.compress.zstd {
	// Writes bits forwards, least significant first. The Huffman and
	// sequence streams are written this way and read from their end, so
	// what is written last is read first.
	internal type BitWriter {
		out   byte[]
		// Bits not yet in `out`, the oldest lowest.
		hold  uint64
		count int

		def new(out byte[]) {
			self.out = out
			hold = uint64(0)
			count = 0
		}

		// Appends the low `width` bits of `value` (at most 32).
		def add(value int, width int) {
			hold |= (uint64(value) & ((uint64(1) << uint64(width)) - uint64(1))) << uint64(count)
			count += width
			for count >= 8 {
				out.push(byte(hold & uint64(0xFF)))
				hold = hold >> uint64(8)
				count -= 8
			}
		}

		// Ends a stream that is read from its end: a set bit marks where
		// the data stops, zeros fill the byte.
		def close() {
			add(1, 1)
			align()
		}

		// Fills the last byte with zeros.
		def align() {
			if count > 0 {
				out.push(byte(hold & uint64(0xFF)))
				hold = uint64(0)
				count = 0
			}
		}
	}

	// An FSE encoding table for normalized counts: the state to move to
	// after a symbol, and per symbol how many bits a state gives up first.
	internal type FseEncoder {
		accuracy  int
		states    int[]
		deltaBits int[]
		deltaFind int[]
		// The table of one symbol (the RLE mode): its states take no bits.
		one       bool

		def new() {
			accuracy = 0
			states = []
			deltaBits = []
			deltaFind = []
			one = false
		}

		// Makes the table of one symbol.
		def single() {
			one = true
			accuracy = 0
		}

		// Builds the table from normalized counts (-1 for a symbol of
		// probability "less than one"), spread as the decoder spreads them.
		def build(counts int[], accuracy int) {
			one = false
			self.accuracy = accuracy
			let size = 1 << accuracy
			let spread int[] = []
			spread.len(size)
			let high = size
			for let (s, count) in counts {
				if count == -1 {
					high--
					spread[high] = s
				}
			}
			let step = (size >> 1) + (size >> 3) + 3
			let mask = size - 1
			let pos = 0
			for let (s, count) in counts {
				for let i = 0; i < count; i++ {
					spread[pos] = s
					pos = (pos + step) & mask
					for pos >= high {
						pos = (pos + step) & mask
					}
				}
			}
			let cumulative int[] = []
			cumulative.len(counts.len() + 1)
			cumulative[0] = 0
			for let (s, count) in counts {
				cumulative[s + 1] = cumulative[s] + (count == -1 ?? (1, count))
			}
			states.len(size)
			let next = cumulative.clone()
			for let u = 0; u < size; u++ {
				let s = spread[u]
				states[next[s]] = size + u
				next[s]++
			}
			deltaBits.len(counts.len())
			deltaFind.len(counts.len())
			let total = 0
			for let (s, count) in counts {
				if count == 0 {
					deltaBits[s] = ((accuracy + 1) << 16) - size
					deltaFind[s] = 0
				} else if count == 1 || count == -1 {
					deltaBits[s] = (accuracy << 16) - size
					deltaFind[s] = total - 1
					total++
				} else {
					let maxOut = accuracy - highBit(count - 1)
					deltaBits[s] = (maxOut << 16) - (count << maxOut)
					deltaFind[s] = total - count
					total += count
				}
			}
		}

		// The state a stream starts in when `symbol` is the last one its
		// reader will decode.
		def first(symbol int) int {
			return 0 when one
			let width = (deltaBits[symbol] + 32768) >> 16
			let value = (width << 16) - deltaBits[symbol]
			return states[(value >> width) + deltaFind[symbol]]
		}

		// Writes the bits `state` gives up for `symbol` and returns the
		// state after it.
		def encode(writer BitWriter, state int, symbol int) int {
			return 0 when one
			let width = (state + deltaBits[symbol]) >> 16
			writer.add(state, width)
			return states[(state >> width) + deltaFind[symbol]]
		}

		// Writes a final state.
		def flush(writer BitWriter, state int) {
			return when one
			writer.add(state, accuracy)
		}
	}

	// Normalizes how often each symbol occurs to counts that add up to
	// `1 << accuracy`, every symbol that occurs keeping at least one.
	internal def normalizeCounts(occurs int[], total int, accuracy int) int[] {
		let size = 1 << accuracy
		let counts int[] = []
		counts.len(occurs.len())
		let sum = 0
		let largest = 0
		for let (s, n) in occurs {
			let share = 0
			if n > 0 {
				share = (n * size + total / 2) / total
				share = 1 when share < 1
			}
			counts[s] = share
			sum += share
			largest = s when share > counts[largest]
		}
		// Rounding leaves a difference: the most frequent symbols absorb it.
		for sum != size {
			let pick = 0
			for let (s, c) in counts {
				pick = s when c > counts[pick]
			}
			if sum < size {
				counts[pick] += size - sum
				sum = size
			} else {
				let cut = (sum - size).min(counts[pick] - 1)
				counts[pick] -= cut
				sum -= cut
			}
		}
		return counts
	}

	// The smallest accuracy that can hold the symbols, at least `least` and
	// at most `most`, following how many symbols were counted.
	internal def chooseAccuracy(occurs int[], total int, least int, most int) int {
		let present = 0
		for let (_, n) in occurs {
			present++ when n > 0
		}
		let wanted = highBit(total.max(2) - 1) - 1
		let needed = highBit(present.max(2) - 1) + 1
		return wanted.max(needed).max(least).min(most)
	}

	// Writes an FSE table description: the form `readFseCounts` reads.
	internal def writeFseCounts(out byte[], counts int[], accuracy int) {
		let writer = new BitWriter(out)
		writer.add(accuracy - 5, 4)
		let remaining = 1 << accuracy
		let s = 0
		for remaining > 0 && s < counts.len() {
			let count = counts[s]
			s++
			let value = count + 1
			let width = highBit(remaining + 1) + 1
			let lower = (1 << (width - 1)) - 1
			let threshold = (1 << width) - 1 - (remaining + 1)
			if value < threshold {
				writer.add(value, width - 1)
			} else if value <= lower {
				writer.add(value, width)
			} else {
				writer.add(value + threshold, width)
			}
			remaining -= count
			if count == 0 {
				// Count the zeros that follow this one, three at a time.
				let zeros = 0
				for s < counts.len() && counts[s] == 0 {
					zeros++
					s++
				}
				for zeros >= 3 {
					writer.add(3, 2)
					zeros -= 3
				}
				writer.add(zeros, 2)
			}
		}
		writer.align()
	}

	// Huffman code lengths of at most 11 bits for the symbols that occur,
	// 0 for the others. The code is complete: nothing is left unused.
	internal def huffmanLengths(occurs int[]) int[] {
		let lengths int[] = []
		lengths.len(occurs.len())
		lengths.fill(0)
		// Leaves and merged nodes in one list: weight and parent.
		let weight int[] = []
		let parent int[] = []
		let alive int[] = []
		for let (s, n) in occurs {
			if n > 0 {
				alive.push(weight.len())
				weight.push(n)
				parent.push(-1)
			}
		}
		let leaves = weight.len()
		let symbols int[] = []
		for let (s, n) in occurs {
			symbols.push(s) when n > 0
		}
		for alive.len() > 1 {
			// The two lightest nodes become one.
			let a = 0
			for let i = 1; i < alive.len(); i++ {
				a = i when weight[alive[i]] < weight[alive[a]]
			}
			let first = alive[a]
			alive.remove(a)
			let b = 0
			for let i = 1; i < alive.len(); i++ {
				b = i when weight[alive[i]] < weight[alive[b]]
			}
			let second = alive[b]
			alive.remove(b)
			let merged = weight.len()
			weight.push(weight[first] + weight[second])
			parent.push(-1)
			parent[first] = merged
			parent[second] = merged
			alive.push(merged)
		}
		for let i = 0; i < leaves; i++ {
			let depth = 0
			let at = i
			for parent[at] >= 0 {
				at = parent[at]
				depth++
			}
			lengths[symbols[i]] = depth.min(11)
		}
		// Shortening the codes above 11 bits overfills the code space:
		// lengthen the longest codes below 11 until it fits, then give back
		// what is left over to the codes of 11.
		let space = 0
		for let (_, s) in symbols {
			space += 1 << (11 - lengths[s])
		}
		for space > 2048 {
			let pick = -1
			for let (_, s) in symbols {
				pick = s when lengths[s] < 11 && (pick < 0 || lengths[s] > lengths[pick])
			}
			space -= 1 << (11 - lengths[pick] - 1)
			lengths[pick]++
		}
		for space < 2048 {
			let pick = -1
			for let (_, s) in symbols {
				let gain = 1 << (11 - lengths[s])
				pick = s when lengths[s] > 1 && gain <= 2048 - space && (pick < 0 || lengths[s] > lengths[pick])
			}
			space += 1 << (11 - lengths[pick])
			lengths[pick]--
		}
		return lengths
	}

	// The code of each symbol for the lengths, as the decoder's table lays
	// them out: longer codes take the lower values, symbols in order within
	// a length. Also returns the longest length.
	internal def huffmanCodes(lengths int[]) (int[], int) {
		let longest = 0
		for let (_, l) in lengths {
			longest = l when l > longest
		}
		let codes int[] = []
		codes.len(lengths.len())
		let next = 0
		for let length = longest; length >= 1; length-- {
			for let (s, l) in lengths {
				continue when l != length
				codes[s] = next >> (longest - length)
				next += 1 << (longest - length)
			}
		}
		return (codes, longest)
	}

	// Appends a Huffman tree description for the lengths to `out`: the
	// weights of every symbol but the last one that occurs, FSE-compressed
	// when that is smaller or when there are more than 128 of them. False
	// when the weights have no description (more than 128 of them that FSE
	// cannot compress).
	internal def writeHuffmanTable(out byte[], lengths int[], longest int) bool {
		let last = 0
		for let (s, l) in lengths {
			last = s when l > 0
		}
		let weights int[] = []
		for let s = 0; s < last; s++ {
			weights.push(lengths[s] > 0 ?? (longest + 1 - lengths[s], 0))
		}
		let packed byte[] = []
		let usable = compressWeights(packed, weights)
		if usable && packed.len() < 128 && (packed.len() < (weights.len() + 1) / 2 || weights.len() > 128) {
			out.push(byte(packed.len()))
			out.push(...packed)
			return true
		}
		return false when weights.len() > 128
		out.push(byte(127 + weights.len()))
		for let i = 0; i < weights.len(); i += 2 {
			let low = i + 1 < weights.len() ?? (weights[i + 1], 0)
			out.push(byte((weights[i] << 4) | low))
		}
		return true
	}

	// Compresses Huffman weights with FSE, two states taking the weights in
	// turn. False when they cannot be: fewer than two weights, or all alike.
	internal def compressWeights(out byte[], weights int[]) bool {
		let n = weights.len()
		return false when n < 2
		let occurs int[] = []
		occurs.len(13)
		occurs.fill(0)
		for let (_, w) in weights {
			occurs[w]++
		}
		let most = 0
		for let (_, c) in occurs {
			most = c when c > most
		}
		return false when most == n || most == 1
		let accuracy = chooseAccuracy(occurs, n, 5, 6)
		let counts = normalizeCounts(occurs, n, accuracy)
		writeFseCounts(out, counts, accuracy)
		let table = new FseEncoder()
		table.build(counts, accuracy)
		let writer = new BitWriter(out)
		let at = n
		let one = 0
		let two = 0
		if n & 1 == 1 {
			one = table.first(weights[at - 1])
			two = table.first(weights[at - 2])
			one = table.encode(writer, one, weights[at - 3]) when at >= 3
			at -= 3
		} else {
			two = table.first(weights[at - 1])
			one = table.first(weights[at - 2])
			at -= 2
		}
		for at > 0 {
			two = table.encode(writer, two, weights[at - 1])
			one = table.encode(writer, one, weights[at - 2])
			at -= 2
		}
		table.flush(writer, two)
		table.flush(writer, one)
		writer.close()
		return true
	}

	// Appends the Huffman stream of `data[from:to]` to `out`: the symbols
	// from the last to the first, so the reader meets them in order.
	internal def writeHuffmanStream(out byte[], data byte[], from int, to int, codes int[], lengths int[]) {
		let writer = new BitWriter(out)
		for let i = to - 1; i >= from; i-- {
			let s = int(data[i])
			writer.add(codes[s], lengths[s])
		}
		writer.close()
	}
}
