partial module std.data.compress.zstd {
	// An FSE decoding table: per state, the symbol it gives, the number of
	// bits to read for the next state and the base those bits are added to.
	internal type FseTable {
		accuracy int
		symbols  int[]
		bits     int[]
		base     int[]

		def new() {
			accuracy = 0
			symbols = []
			bits = []
			base = []
		}

		// Builds the table from normalized counts (-1 for a symbol of
		// probability "less than one").
		// Fails when the counts do not fill the table.
		def build(counts int[], accuracy int) !none {
			self.accuracy = accuracy
			let size = 1 << accuracy
			symbols.len(size)
			bits.len(size)
			base.len(size)
			let next int[] = []
			next.len(counts.len())
			let high = size
			for let (s, count) in counts {
				if count == -1 {
					high--
					fail "zstd: an FSE table has too many symbols" when high < 0
					symbols[high] = s
					next[s] = 1
				}
			}
			let step = (size >> 1) + (size >> 3) + 3
			let mask = size - 1
			let pos = 0
			for let (s, count) in counts {
				continue when count <= 0
				next[s] = count
				for let i = 0; i < count; i++ {
					symbols[pos] = s
					pos = (pos + step) & mask
					for pos >= high {
						pos = (pos + step) & mask
					}
				}
			}
			fail "zstd: an FSE table's counts do not fill it" when pos != 0
			for let i = 0; i < size; i++ {
				let s = symbols[i]
				let state = next[s]
				next[s] = state + 1
				bits[i] = accuracy - highBit(state)
				base[i] = (state << bits[i]) - size
			}
			return none
		}

		// Takes a copy of another table.
		def copyFrom(other FseTable) {
			accuracy = other.accuracy
			symbols = other.symbols.clone()
			bits = other.bits.clone()
			base = other.base.clone()
		}

		// Makes the table of one symbol that takes no bits (the RLE mode).
		def single(symbol int) {
			accuracy = 0
			symbols = [symbol]
			bits = [0]
			base = [0]
		}
	}

	// Reads an FSE table description: the accuracy and the normalized count
	// of each symbol. Returns the counts and leaves `source` after them.
	// Fails when the accuracy is above `maxAccuracy`, there are more symbols
	// than `maxSymbols`, or the counts do not add up.
	internal def readFseCounts(source ForwardBits, maxAccuracy int, maxSymbols int) !(int[], int) {
		let accuracy = (try source.read(4)) + 5
		fail "zstd: an FSE table's accuracy of {accuracy} is above {maxAccuracy}" when accuracy > maxAccuracy
		let remaining = 1 << accuracy
		let counts int[] = []
		for remaining > 0 && counts.len() < maxSymbols {
			let width = highBit(remaining + 1) + 1
			let value = try source.read(width)
			let lower = (1 << (width - 1)) - 1
			let threshold = (1 << width) - 1 - (remaining + 1)
			if value & lower < threshold {
				source.at--
				value = value & lower
			} else if value > lower {
				value -= threshold
			}
			let count = value - 1
			remaining -= count < 0 ?? (-count, count)
			counts.push(count)
			if count == 0 {
				let repeat = try source.read(2)
				for {
					for let i = 0; i < repeat && counts.len() < maxSymbols; i++ {
						counts.push(0)
					}
					break when repeat != 3
					repeat = try source.read(2)
				}
			}
		}
		fail "zstd: an FSE table's counts do not add up" when remaining != 0
		return (counts, accuracy)
	}
}
