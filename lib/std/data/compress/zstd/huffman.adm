partial module std.data.compress.zstd {
	// A Huffman decoding table: indexed by the next `maxBits` bits, it gives
	// the symbol and the number of bits its code takes.
	internal type HuffmanTable {
		maxBits int
		symbols byte[]
		bits    byte[]

		def new() {
			maxBits = 0
			symbols = []
			bits = []
		}

		// Builds the table from the weights of the symbols, the last one
		// (which the format leaves out) included.
		// Fails when the weights are not those of a complete code.
		def build(weights int[]) !none {
			let sum = 0
			for let (_, w) in weights {
				sum += 1 << (w - 1) when w > 0
			}
			fail "zstd: a Huffman table has no symbols" when sum == 0
			maxBits = highBit(sum)
			fail "zstd: a Huffman table's weights are not a complete code" when 1 << maxBits != sum
			fail "zstd: a Huffman code of {maxBits} bits is longer than 11" when maxBits > 11
			let size = 1 << maxBits
			symbols.len(size)
			bits.len(size)
			// Codes of one length share a rank; the longest codes come first.
			let count int[] = []
			count.len(maxBits + 2)
			count.fill(0)
			for let (_, w) in weights {
				count[maxBits + 1 - w]++ when w > 0
			}
			let rank int[] = []
			rank.len(maxBits + 2)
			rank[maxBits] = 0
			for let length = maxBits; length >= 1; length-- {
				rank[length - 1] = rank[length] + count[length] * (1 << (maxBits - length))
				for let i = rank[length]; i < rank[length - 1]; i++ {
					bits[i] = byte(length)
				}
			}
			fail "zstd: a Huffman table's weights are not a complete code" when rank[0] != size
			for let (s, w) in weights {
				continue when w == 0
				let length = maxBits + 1 - w
				let span = 1 << (maxBits - length)
				let code = rank[length]
				for let i = 0; i < span; i++ {
					symbols[code + i] = byte(s)
				}
				rank[length] = code + span
			}
			return none
		}

		// Takes a copy of another table.
		def copyFrom(other HuffmanTable) {
			maxBits = other.maxBits
			symbols = other.symbols.clone()
			bits = other.bits.clone()
		}

		// Decodes the stream `data[from:to]` into `out[at:at + count]`.
		// Fails when the stream does not hold exactly that many symbols.
		def decode(data byte[], from int, to int, out byte[], at int, count int) !none {
			let source = new BackwardBits(data, from, to)
			fail "zstd: a Huffman stream is empty" when source.offset < 0
			let mask = (1 << maxBits) - 1
			let state = source.read(maxBits)
			let done = 0
			for source.offset > -maxBits {
				fail "zstd: a Huffman stream holds more symbols than its size" when done >= count
				out[at + done] = symbols[state]
				done++
				let width = int(bits[state])
				state = ((state << width) | source.read(width)) & mask
			}
			fail "zstd: a Huffman stream does not end where its data does" when source.offset != -maxBits || done != count
			return none
		}
	}

	// Reads a Huffman tree description at `data[from:]` into `table` and
	// returns the index after it.
	// Fails when the description runs past `to` or is not valid.
	internal def readHuffmanTable(data byte[], from int, to int, table HuffmanTable) !int {
		expects {
			assert from < to onerror fail "zstd: a Huffman table description is missing"
		}
		let head = int(data[from])
		let weights int[] = []
		let after = from + 1
		if head >= 128 {
			// Weights written directly, four bits each.
			let count = head - 127
			let size = (count + 1) / 2
			fail "zstd: a Huffman table description runs past its block" when after + size > to
			for let i = 0; i < count; i++ {
				let pair = int(data[after + i / 2])
				weights.push(i % 2 == 0 ?? (pair >> 4, pair & 15))
			}
			after += size
		} else {
			// Weights compressed with FSE: two states read one stream in turn.
			fail "zstd: a Huffman table description runs past its block" when after + head > to
			let forward = new ForwardBits(data, after, after + head)
			let (counts, accuracy) = try readFseCounts(forward, 6, 256)
			let fse = new FseTable()
			try fse.build(counts, accuracy)
			let source = new BackwardBits(data, forward.byteAfter(), after + head)
			fail "zstd: the weights of a Huffman table are missing" when source.offset < 0
			let first = source.read(accuracy)
			let second = source.read(accuracy)
			for {
				fail "zstd: a Huffman table has too many weights" when weights.len() > 254
				weights.push(fse.symbols[first])
				first = fse.base[first] + source.read(fse.bits[first])
				if source.offset < 0 {
					weights.push(fse.symbols[second])
					break
				}
				weights.push(fse.symbols[second])
				second = fse.base[second] + source.read(fse.bits[second])
				if source.offset < 0 {
					weights.push(fse.symbols[first])
					break
				}
			}
			after += head
		}
		// The last weight is what completes the code.
		let sum = 0
		for let (_, w) in weights {
			fail "zstd: a Huffman weight of {w} is above 11" when w > 11
			sum += 1 << (w - 1) when w > 0
		}
		fail "zstd: a Huffman table has no weights" when sum == 0
		let whole = 1 << (highBit(sum) + 1)
		let left = whole - sum
		fail "zstd: a Huffman table's weights cannot be completed" when left & (left - 1) != 0
		weights.push(highBit(left) + 1)
		fail "zstd: a Huffman table has more than 256 symbols" when weights.len() > 256
		try table.build(weights)
		return after
	}
}
