partial module std.data.compress.zstd {
	use (
		std.bytes
		std.data.encoding::(hexdecode)
		std.testing
	)

	check "Zstandard reading" {
		// Frames written by the reference implementation.
		@test()
		def TestReadsReferenceFrames() !none {
			// One block of raw literals and sequences, with a checksum.
			let phrase = "hello hello hello hello, Zstandard! "
			let small = try hexdecode("28b52ffd246cfd00009068656c6c6f202c205a7374616e646172642104001e15010c20282f652e4586711307")
			assert string(try decompress(small)) == phrase + phrase + phrase

			// One block of a repeated byte.
			let zeros = try decompress(try hexdecode("28b52ffd602c004d00001000000100272ac002"))
			assert zeros.len() == 300 && zeros[0] == byte(0) && zeros[299] == byte(0)

			// 3611 bytes of words at level 19: Huffman literals in four
			// streams with FSE-coded weights, and FSE tables for the sequences.
			let text = try decompress(try hexdecode(string[
				"28b52ffd641b0df52400065a3912b0a70d40ddd28f4cc46944cc3c49f2c85844350034003200e7a3917a02cfda3a0c5353b9",
				"4b77828c21242b785a5661285e4aa568c5e9e5903411d0b2d2512169a504148794fc163fea097a10c9c79b3b8fca7a17e7e8",
				"96651a098c94329cfa103247029e77d37aafba57e2579ee7010c83155bb3008ec8f8447ae249b49a48390bae7bd072a81c27",
				"b0e65d54e66804a4d5efe493f2dcd3fc03188253dfa9f8d82a80334fda7d17bbdf735a38c734b4b96d7e337453a7e5d13fbe",
				"fffdccc2e4d2a3593fbbf7673b1e8e87a42f70b35e6646378e513101c7bc49aba379cc75f7712cdd312d8224a8325d592449",
				"419261332210080887469579d60712c04045b3698b017feeb615a53f768af29458956c3e8b20b320998e18a355cd47182917",
				"0ba2a912946c88c8f9ac8ae9a082eb2f4937e6f2e1b1450acc047dea529baa52bc740245b519ee3fc1b8e9650408ca0ed8e2",
				"2557d4f00c8705b1874358676d0c15e46ed5df855a861c5a2bb9d58fb9844a670a1e81ac5607211389014ce50707094353b0",
				"aadb9bba80636303eb6bce95f7c9d37c99f9e839551693c657d9ae133e77258195cfd614dea656b4fbee983b2ad8bf19b851",
				"3413188035c19d855a10b2f49428ed86e6171a70962c16e2a3d9320d8da54636999970c5c1d2383f6a6a9a3a798692cd9cbd",
				"a472c92441bf71c72c41bbd952232ec9849a45eb1949e9b4b8a8da8a5994c268a68b3a278d748fdfb7c894664b5ced8d2f1a",
				"74e9f3ed40c05693c4eb6c97f75ad053132ccccecadd752d1026107f6d58105e9bf959695d4bf001e403d66333d603ca503f",
				"78075076df3f34e08db18026568a8238e62e365c48f21f2a498544d90f28600dd62e12f6425b5d1333c8b04401f1e638f5d0",
				"6a7289ba59c18d01c64c05db3a9bcdcb92fd5a606077a47100187df0a688b03f8f75732e0838c9099c849c4efd96bf04d1c9",
				"68c6787954fce5c5746f374efd3759092fa06f74b11f1878cb6a706c80d3a6b2e07c2b12601be29633b537f73a04330515be",
				"9e0ee67d2fbdd579b3d366a0a420da67283fa441b1ef6af42a50cfe44162e9374f8f392a0f256a88fd6760df8e0b2a9d8d5d",
				"0078cea3c0a5eb559ee2b5c52917b88ef4d7e89f3be4abcb18940b7fbc407c79da6097dca4ad5813188d65b7295e4cfbd997",
				"51171606310923e74e20f6625e9687994e793e4113f1a116b4006200a3f04260cb4e6c69067af5b317fd057c341402770323",
				"06fdef6e0108e3305f8672383eae4d15b5e1d0ca4b9dd1a182ddb24ee6da284412b5eaa07b0753fc3e2fcb17deaf089c4a98",
				"2cb88e9c394cf815d076e1919eda451601594856c91adbbe7cfaf40675db76e00d1747fd0f617d0e52a60c565809e4698bf1",
				"099d70710dc98b7194d4ee880acc9274f16f1df434276a5e2f4dfd0e1b52e186ca948baa872a1616c42f1382c266a7a0c397",
				"9cb6045ee240abd7438782b23612f586f88cd20f2458db927c01598282a905604d06978ac05cf811c63c00657f39c7ecd53b",
				"906647073e32f909e6ccf706825dbb9170a2ce5bc9d1204aa32ea776ef03a0dedd79e45b0bb2d037be5d3296a5eb00f45fb9",
				"7d8fa6e75472ae0a01db2822a4c3a79d880113074c258706230634b3fa368bd6bcf24e491bac8552f110f01aa600",
			].join("")), 3611)
			assert text.len() == 3611
			assert string(text[0:24]) == "they can you they one ha" && string(text[3611 - 12:]) == "o all it are"
			return none
		}

		@test()
		def TestFramesInARow() !none {
			let small = try hexdecode("28b52ffd246cfd00009068656c6c6f202c205a7374616e646172642104001e15010c20282f652e4586711307")
			let zeros = try hexdecode("28b52ffd602c004d00001000000100272ac002")
			let all byte[] = []
			all.push(...small)
			all.push(byte(0x53), byte(0x2A), byte(0x4D), byte(0x18), byte(2), byte(0), byte(0), byte(0), byte(7), byte(7))
			all.push(...zeros)
			all.push(...small)
			let out = try decompress(all)
			assert out.len() == 108 + 300 + 108

			// The same through a Reader, a few bytes at a time.
			let reader = new Reader(new bytes.Reader(all))
			let back byte[] = []
			let chunk byte[] = []
			chunk.len(7)
			for {
				let n = try reader.read(chunk)
				break when n == 0
				back.push(...chunk[0:n])
			}
			assert back.equals(out)
			assert (try decompress(byte[])).len() == 0
			return none
		}

		@test()
		def TestRefusesDamagedData() !none {
			let small = try hexdecode("28b52ffd246cfd00009068656c6c6f202c205a7374616e646172642104001e15010c20282f652e4586711307")
			assert decompress("certainly not zstd".bytes()) is error
			assert decompress(small[0:small.len() - 1].clone()) is error
			assert decompress(small[0:10].clone()) is error
			assert decompress(small[0:5].clone()) is error
			// A bit flipped past the frame header's first byte (whose bit 4
			// is unused) is noticed: by the decoder or by the checksum.
			for let at = 5; at < small.len(); at++ {
				let bent = small.clone()
				bent[at] = bent[at] ^ byte(0x10)
				assert decompress(bent) is error
			}
			// A window above the limit a Reader was given.
			let reader = new Reader(new bytes.Reader(try hexdecode("28b52ffd0458010000")))
			reader.maxWindow = 1024
			let chunk byte[] = []
			chunk.len(16)
			assert reader.read(chunk) is error
			return none
		}
	}
}
