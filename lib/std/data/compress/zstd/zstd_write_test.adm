partial module std.data.compress.zstd {
	use (
		std.bytes
		std.testing
	)

	// A buffer of the length in one of four shapes: 0 runs, repeats and
	// noise; 1 words over a small alphabet; 2 mostly high bytes; 3 noise.
	internal def shaped(length int, seed int, shape int) byte[] {
		let out byte[] = []
		let state = uint32(seed * 2654435761 + 12345)
		for out.len() < length {
			state = state * uint32(1664525) + uint32(1013904223)
			let pick = int((state >> 24) & uint32(0xFF))
			let run = int((state >> 8) & uint32(0x3F)) + 1
			if shape == 1 {
				out.push(byte(97 + pick % 9))
				out.push(byte(32)) when pick > 200
			} else if shape == 2 {
				out.push(byte(130 + pick % 120))
			} else if shape == 3 {
				out.push(byte(pick))
			} else if pick < 90 {
				for let i = 0; i < run && out.len() < length; i++ {
					out.push(byte(pick))
				}
			} else if pick < 170 && out.len() > 100 {
				let back = out.len() - 1 - int((state >> 12) & uint32(0x3F))
				for let i = 0; i < run * 3 && out.len() < length; i++ {
					out.push(out[back + i])
				}
			} else {
				for let i = 0; i < run && out.len() < length; i++ {
					state = state * uint32(1664525) + uint32(1013904223)
					out.push(byte((state >> 16) & uint32(0xFF)))
				}
			}
		}
		out.len(length)
		return out
	}

	check "Zstandard writing" {
		@test()
		def TestRoundTrips() !none {
			for let shape = 0; shape < 4; shape++ {
				for let (_, length) in int[0, 1, 2, 15, 16, 17, 33, 255, 256, 257, 1023, 1024, 5000, 131071, 131072, 131073, 300000] {
					let data = shaped(length, length + shape, shape)
					let packed = compress(data)
					assert packed[0] == byte(0x28) && packed[1] == byte(0xB5) && packed[2] == byte(0x2F) && packed[3] == byte(0xFD)
					let back = try decompress(packed, length)
					fail "{length} bytes of shape {shape} came back different" unless back.equals(data)
				}
			}
			return none
		}

		@test()
		def TestCompresses() !none {
			let flat byte[] = []
			flat.len(1000000)
			assert compress(flat).len() < 100
			let words = shaped(200000, 5, 1)
			assert compress(words).len() < words.len() / 2
			let high = shaped(200000, 6, 2)
			assert compress(high).len() < high.len()
			let noise = shaped(100000, 7, 3)
			assert compress(noise).len() < noise.len() + 64
			// A phrase far back is found again.
			let far byte[] = []
			far.push(...shaped(3000, 8, 3))
			far.push(...shaped(2000000, 9, 1))
			far.push(...far[0:3000].clone())
			let packed = compress(far)
			assert (try decompress(packed)).equals(far)
			assert packed.len() < compress(far[0:2003000].clone()).len() + 100
			return none
		}

		@test()
		def TestStreams() !none {
			let data = shaped(3000000, 21, 0)
			let sink = new bytes.Buffer()
			let writer = new Writer(sink)
			let at = 0
			let step = 1
			for at < data.len() {
				let end = (at + step).min(data.len())
				try writer.write(data[at:end])
				at = end
				step = step * 5 + 3
				step = 700000 when step > 700000
			}
			try writer.close()
			assert writer.write(data[0:1]) is error && writer.close() is error

			let reader = new Reader(new bytes.Reader(sink.bytes()))
			let back byte[] = []
			let chunk byte[] = []
			chunk.len(50021)
			for {
				let n = try reader.read(chunk)
				break when n == 0
				back.push(...chunk[0:n])
			}
			assert back.len() == data.len() && back.equals(data)

			let nothing = new bytes.Buffer()
			try new Writer(nothing).close()
			assert (try decompress(nothing.bytes())).len() == 0
			return none
		}
	}
}
