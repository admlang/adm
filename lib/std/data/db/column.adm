partial module std.data.db {
	use (
		std.reflection
		std.data.db.mapping::*
	)

	// Stored is the form a field's value takes in its column when that is
	// not the database's own type for it.
	enum Stored {
		// The database's type for the field's type; the driver converts.
		Auto,
		// Text: a `time.Time` as RFC 3339, a `math.Decimal` or number in
		// decimal digits, a `bool` as "true"/"false", an enum by member name.
		Text,
		// An integer: a `time.Time` as Unix seconds, a `duration` as
		// nanoseconds, a `bool` as 0/1, an enum by its value.
		Integer,
		// A float: a `time.Time` as Unix seconds with a fraction, a
		// `duration` as seconds.
		Float,
		// Raw bytes: a `string` as its UTF-8, a `bigint` big-endian.
		Bytes,
		// JSON text, for a struct or type field, encoded and decoded with
		// the field type's `@json` annotations.
		JSON,
	}

	// column says how a field is kept in a database row, where that differs
	// from the field's own name and type:
	//
	//     struct User {
	//         id int
	//         @column("email_address")
	//         email string
	//         @column(stored = Stored.Text)
	//         created time.Time
	//         @column(ignore = true)
	//         session ?Session
	//     }
	//
	// `name` is the column's name, the field's own when empty. `stored` is
	// the form the value has in the column; reading converts it back to the
	// field's type and fails with ErrorKind.Type when it does not parse.
	// `ignore` leaves the field out of both directions.
	meta def column(ctx reflection.FieldMetaContext, name string = "", stored Stored = Stored.Auto, ignore bool = false) {}

	// column says how a property is kept in a database row. Takes the same
	// options as the field form above.
	meta def column(ctx reflection.PropertyMetaContext, name string = "", stored Stored = Stored.Auto, ignore bool = false) {}

	// read builds a T from the current row: each column goes to the field
	// that names it (its `@column` name, else its own, in any letter case),
	// converted as the field's `stored` form says. Columns without a field
	// are skipped, and fields without a column keep their default. T is a
	// struct or a type with a constructor that takes no arguments.
	// Fails with a DbError of ErrorKind.Type when a column does not convert
	// to its field's type, or is NULL for a field that is not optional.
	def read<T>(rows Rows) !T {
		let out = new T()
		try read(rows, out)
		return out
	}

	// read fills an existing object's fields from the current row, as the
	// generic form does.
	// Fails with a DbError of ErrorKind.Type as the generic form does.
	def read(rows Rows, target any) !none {
		let plan = new Plan(rows.columns(), target)
		return plan.fill(rows, target)
	}

	// readAll reads every remaining row into a new T and closes the rows.
	// Fails with a DbError when reading a row fails or a column does not
	// convert, as `read` does; the rows are closed then too.
	def readAll<T>(rows Rows) !T[] {
		defer rows.close()
		let out T[]
		return out unless try rows.next()

		let first = new T()
		let plan = new Plan(rows.columns(), first)
		try plan.fill(rows, first)
		out.push(first)
		for try rows.next() {
			let item = new T()
			try plan.fill(rows, item)
			out.push(item)
		}
		return out
	}

	// values returns an object's fields as statement arguments by column
	// name, each in its `stored` form, ready for the `named` overloads:
	//
	//     try conn.exec("INSERT INTO users (id, email_address) VALUES (:id, :email_address)", db.values(user))
	//
	// Fields marked `ignore` are left out. An empty optional field is `none`.
	def values(row any) map<string, any> {
		let out = new map<string, any>()
		for let (_, f) in reflection.fields(row) {
			continue when f.attr(columnAttr, "ignore") == "true"
			out.set(columnOf(f), storedValue(f))
		}
		return out
	}
}
