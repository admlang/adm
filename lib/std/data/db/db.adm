partial module std.data.db {
	use (
		std.reflection
		std.net.url
		std.data.db.registry::*
	)

	// driver marks a type as the database driver for the URL schemes listed:
	//
	//     @driver("sqlite")
	//     type SQLite { ... }
	//
	//     @driver("postgres", "postgresql")
	//     type Postgres { ... }
	//
	// `connect` finds the drivers linked into the program through this
	// annotation and builds the one that lists the URL's scheme. The type
	// needs a constructor without arguments. Schemes are compared in lower
	// case, without "://".
	meta def driver<Driver>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, schemes ...string) {}

	// Placeholder is the way a database writes a bound parameter in SQL text.
	enum Placeholder {
		// `?` for each parameter, in order (SQLite, MySQL).
		Question,
		// `$1`, `$2`, ... numbered from one (PostgreSQL).
		Dollar,
		// `:name`, bound by name.
		Named,
	}

	// Driver opens connections to one kind of database. A driver library
	// declares one type implementing it, marked with `@driver(scheme)`.
	interface Driver {
		// placeholder returns the parameter style of the driver's SQL, the
		// one `sql def` text is rewritten to.
		def placeholder() Placeholder

		// connect opens one connection to the database the URL names. The
		// driver reads what it needs from the URL: host, port, user and
		// password, the database name or file path, and its own options from
		// the query.
		// Fails with a DbError when the URL lacks a part the driver needs,
		// the database cannot be reached, or it refuses the credentials.
		def connect(target url.URL) !Connection
	}

	// Queryable runs SQL. A Connection runs each statement by itself; a
	// Transaction runs it inside the transaction.
	//
	// Arguments bind to the statement's placeholders: `args` in order to
	// positional ones (`?`, `$1`), `named` by key to named ones (`:email`).
	// The forms taking both let one call serve any driver: each driver reads
	// the one its placeholder style needs and ignores the other. A bound value
	// is `none`, a `bool`, any integer or float, a `string`, a `byte[]`, a
	// `time.Time`, `time.Date`, `time.TimeOfDay` or `time.DateTime`, a
	// `math.Decimal` or a `bigint`; a driver fails with
	// ErrorKind.Type on a value it cannot send.
	interface Queryable {
		// placeholder returns the parameter style of the SQL this runs, the
		// driver's own.
		def placeholder() Placeholder

		// exec runs a statement that returns no rows and reports what it
		// changed.
		// Fails with a DbError when the database rejects the statement or the
		// connection is lost.
		def exec(statement string, args ...any) !Result

		// exec runs a statement with its arguments given by name and, for
		// drivers that bind by position, in order.
		// Fails with a DbError as the positional form does, and when a named
		// placeholder has no entry in `named`.
		def exec(statement string, named map<string, any>, args ...any) !Result

		// query runs a statement and returns its rows, positioned before the
		// first one. Close the rows when done; until then the connection is
		// busy with them.
		// Fails with a DbError when the database rejects the statement or the
		// connection is lost.
		def query(statement string, args ...any) !Rows

		// query runs a statement with its arguments given by name and, for
		// drivers that bind by position, in order.
		// Fails with a DbError as the positional form does, and when a named
		// placeholder has no entry in `named`.
		def query(statement string, named map<string, any>, args ...any) !Rows

		// prepare compiles a statement once so it can run many times with
		// different arguments.
		// Fails with a DbError when the database rejects the statement or the
		// connection is lost.
		def prepare(statement string) !Statement
	}

	// Connection is one open session with a database. It serves one task at a
	// time; share work between tasks through a pool of connections.
	interface Connection {
		Queryable

		// beginTx starts a transaction on this connection. Until it is
		// committed or rolled back, run statements through the transaction,
		// not the connection.
		// Fails with a DbError when a transaction is already open on the
		// connection, the database does not support the isolation level, or
		// the connection is lost.
		def beginTx(isolation Isolation = Isolation.Default, readOnly bool = false) !Transaction

		// ping checks that the database still answers.
		// Fails with a DbError when it does not.
		def ping() !none

		// close ends the session and releases what the driver holds for it.
		// An open transaction is rolled back. Closing twice is allowed.
		// Fails with a DbError when the database reports a failure while
		// closing.
		def close() !none
	}

	// Isolation is how much a transaction sees of the changes other
	// transactions make while it runs.
	enum Isolation {
		// The database's own default.
		Default,
		ReadUncommitted,
		ReadCommitted,
		RepeatableRead,
		Serializable,
	}

	// Transaction is a unit of work that is committed whole or not at all.
	// It ends at the first `commitTx` or `rollbackTx`; statements run through it
	// afterwards fail with ErrorKind.Closed.
	interface Transaction {
		Queryable

		// commitTx makes the transaction's changes permanent.
		// Fails with a DbError when the database refuses (a deferred
		// constraint, a serialization conflict) or the connection is lost;
		// the changes are then not applied.
		def commitTx() !none

		// rollbackTx discards the transaction's changes. Rolling back a
		// transaction that already ended does nothing.
		// Fails with a DbError when the connection is lost.
		def rollbackTx() !none
	}

	// Statement is SQL the database has compiled, ready to run with
	// arguments. It belongs to the connection or transaction that prepared
	// it.
	interface Statement {
		// exec runs the statement with the arguments and reports what it
		// changed.
		// Fails with a DbError when the argument count differs from the
		// statement's placeholders, the database rejects the run, or the
		// connection is lost.
		def exec(args ...any) !Result

		// exec runs the statement with its arguments given by name and, for
		// drivers that bind by position, in order.
		// Fails with a DbError as the positional form does, and when a named
		// placeholder has no entry in `named`.
		def exec(named map<string, any>, args ...any) !Result

		// query runs the statement with the arguments and returns its rows,
		// positioned before the first one.
		// Fails with a DbError when the argument count differs from the
		// statement's placeholders, the database rejects the run, or the
		// connection is lost.
		def query(args ...any) !Rows

		// query runs the statement with its arguments given by name and, for
		// drivers that bind by position, in order.
		// Fails with a DbError as the positional form does, and when a named
		// placeholder has no entry in `named`.
		def query(named map<string, any>, args ...any) !Rows

		// close releases the compiled statement. Closing twice is allowed.
		// Fails with a DbError when the database reports a failure while
		// closing.
		def close() !none
	}

	// Result is what a statement without rows changed.
	struct Result {
		// Rows inserted, updated or deleted.
		affected     int
		// Key the database generated for the last inserted row, 0 when the
		// statement inserted none or the database does not report it.
		lastInsertId int
	}

	// Column describes one column of a result.
	struct Column {
		// The column's name or alias in the result.
		name     string
		// The type as the database names it ("INTEGER", "varchar", "timestamptz"),
		// "" when it does not say.
		typeName string
		// False when the database guarantees the column holds no NULL.
		nullable bool
	}

	// Rows is the result of a query, read one row at a time:
	//
	//     let rows = try conn.query("SELECT id, name FROM users WHERE age > ?", 18)
	//     defer rows.close()
	//     for try rows.next() {
	//         let id = try rows.int(0)
	//         let name = try rows.string(1)
	//     }
	//
	// The typed readers take a column index from zero and read the current
	// row. Each converts what the database sent when that loses nothing (an
	// integer column read as float, any column read as string) and fails with
	// ErrorKind.Type otherwise, when the column is NULL, when the index is
	// out of range, or when no row is current.
	interface Rows {
		// columns returns the result's columns in order.
		def columns() Column[]

		// next moves to the next row and returns false after the last one,
		// which also closes the rows.
		// Fails with a DbError when reading the row fails or the connection
		// is lost.
		def next() !bool

		// isNull reports whether the column is NULL in the current row.
		def isNull(column int) bool

		def bool(column int) !bool
		def int(column int) !int
		def float(column int) !float
		def string(column int) !string
		def bytes(column int) !byte[]

		// value returns the column in the type nearest to the database's:
		// `none` for NULL, else a `bool`, `int`, `float`, `string`, `byte[]`,
		// `time.Time`, `math.Decimal` or `bigint`.
		// Fails with a DbError when the index is out of range or no row is
		// current.
		def value(column int) !any

		// close stops reading and frees the connection for the next
		// statement. Closing twice is allowed.
		// Fails with a DbError when the database reports a failure while
		// closing.
		def close() !none
	}

	// connect opens a connection to the database a URL names, with the driver
	// registered for the URL's scheme:
	//
	//     let conn = try db.connect("sqlite:///var/data/app.db")
	//     let conn = try db.connect("postgres://app:secret@db.internal:5432/shop")
	//
	// Fails with a DbError: ErrorKind.NoDriver when the program links no
	// driver for the scheme ("no driver for 'postgres'"), else whatever the driver's `connect` reports. Fails with a UrlError when the
	// text is not a URL.
	def connect(target string) !Connection {
		return connect(try url.parse(target))
	}

	// connect opens a connection to the database a parsed URL names.
	// Fails with a DbError as the text form does.
	def connect(target url.URL) !Connection {
		let found = registry.find(target.scheme)
		fail errorOf(ErrorKind.NoDriver, "no driver for '{target.scheme}'") when found is none
		return found.connect(target)
	}

	// drivers returns the schemes that have a driver in this program, sorted.
	def drivers() string[] {
		return registry.schemes()
	}
}
