partial module std.data.db {
	use (
		std.testing
		std.time
		std.net.url
		std.reflection
	)

	// A driver over rows held in memory: `query` returns the rows its
	// connection was given, whatever the statement.
	@driver("fake", "fakedb")
	type FakeDriver {
		def new() {}

		def placeholder() Placeholder {
			return Placeholder.Named
		}

		def connect(target url.URL) !Connection {
			fail errorOf(ErrorKind.Connection, "no such host") when target.host == "down"
			fakeTally.opened++
			return new FakeConnection()
		}
	}

	// Counts what the fake driver was asked to do, across tests.
	type FakeTally {
		atomic opened int
		atomic closed int

		def new() {}
	}

	let fakeTally = new FakeTally()

	type FakeConnection {
		columns Column[]
		data    any[][]
		// The last statement and arguments received.
		last    string
		named   map<string, any>
		args    any[]
		marks   Placeholder      = Placeholder.Named

		def new() {
			named = new map<string, any>()
		}

		def placeholder() Placeholder {
			return marks
		}

		def exec(statement string, args ...any) !Result {
			fail errorOf(ErrorKind.Connection, "the connection dropped") when statement == "BREAK"
			fail errorOf(ErrorKind.Syntax, "not a statement") when statement == "WRONG"
			last = statement
			self.args = args
			return Result{affected: args.len(), lastInsertId: 0}
		}

		def exec(statement string, named map<string, any>, args ...any) !Result {
			last = statement
			self.named = named
			self.args = args
			return Result{affected: named.len(), lastInsertId: 0}
		}

		def query(statement string, args ...any) !Rows {
			last = statement
			self.args = args
			return new FakeRows(columns, data)
		}

		def query(statement string, named map<string, any>, args ...any) !Rows {
			last = statement
			self.named = named
			self.args = args
			return new FakeRows(columns, data)
		}

		def prepare(statement string) !Statement {
			fail errorOf(ErrorKind.Other, "not prepared")
		}

		def beginTx(isolation Isolation = Isolation.Default, readOnly bool = false) !Transaction {
			fail errorOf(ErrorKind.Other, "no transactions")
		}

		def ping() !none {
			return none
		}

		def close() !none {
			fakeTally.closed++
			return none
		}
	}

	type FakeRows {
		internal cols Column[]
		internal data any[][]
		internal at   int      = -1

		def new(cols Column[], data any[][]) {
			self.cols = cols
			self.data = data
		}

		def columns() Column[] {
			return cols
		}

		def next() !bool {
			at++
			return at < data.len()
		}

		def isNull(column int) bool {
			return data[at][column] is none
		}

		def bool(column int) !bool {
			let v = data[at][column]
			match v {
				case bool:
					return v
				case int:
					return v != 0
				default:
					fail errorOf(ErrorKind.Type, "not a bool")
			}
		}

		def int(column int) !int {
			let v = data[at][column]
			match v {
				case int:
					return v
				default:
					fail errorOf(ErrorKind.Type, "not an int")
			}
		}

		def float(column int) !float {
			let v = data[at][column]
			match v {
				case float:
					return v
				case int:
					return float(v)
				default:
					fail errorOf(ErrorKind.Type, "not a float")
			}
		}

		def string(column int) !string {
			let v = data[at][column]
			match v {
				case string:
					return v
				default:
					fail errorOf(ErrorKind.Type, "not a string")
			}
		}

		def bytes(column int) !byte[] {
			let v = data[at][column]
			match v {
				case byte[]:
					return v
				default:
					fail errorOf(ErrorKind.Type, "not bytes")
			}
		}

		def value(column int) !any {
			return data[at][column]
		}

		def close() !none {
			return none
		}
	}

	enum Role {
		Guest,
		Admin,
	}

	struct Address {
		city string
		zip  string
	}

	struct Account {
		id int
		@column("email_address")
		email string
		active bool
		score float
		nickname ?string
		@column(stored = Stored.Text)
		created time.Time
		@column(stored = Stored.Integer)
		seen time.Time
		@column(stored = Stored.Text)
		role Role
		@column(stored = Stored.JSON)
		address Address
		avatar byte[]
		@column(ignore = true)
		session string
	}

	def accountColumns() Column[] {
		let out Column[]
		for let name in ["id", "email_address", "active", "score", "nickname", "created", "seen", "role", "address", "avatar", "session", "extra"] {
			out.push(Column{name: name, typeName: "", nullable: true})
		}
		return out
	}

	def accountRow(id int, nickname any) any[] {
		let avatar byte[] = [1, 2, 3]
		let row any[]
		row.push(id)
		row.push("user{id}@example.com")
		row.push(1)
		row.push(2.5)
		row.push(nickname)
		row.push("2026-10-06T12:30:00Z")
		row.push(1000)
		row.push("Admin")
		row.push("\{\"city\":\"Cluj\",\"zip\":\"400000\"\}")
		row.push(avatar)
		row.push("from the database")
		row.push("no field for this")
		return row
	}

	def orEmpty(v ?string) string {
		return "" when v is none
		return v
	}

	def text(v any) string {
		return reflection.scalarText(v)
	}

	check "Drivers" {
		@test()
		def TestDriversListsEverySchemeSorted() !none {
			let all = drivers()
			assert all.includes("fake")
			assert all.includes("fakedb")
			assert all.indexOf("fake") < all.indexOf("fakedb")
		}

		@test()
		def TestConnectPicksTheDriverByScheme() !none {
			let a = try connect("fake://host/main")
			try a.ping()
			let b = try connect("FAKEDB://host/main")
			try b.close()
		}

		@test()
		def TestConnectWithoutDriverFails() !none {
			let failed = false
			connect("nosuchdb://host/main") onerror (err error) {
				assert err is DbError
				if err is DbError {
					assert err.kind == ErrorKind.NoDriver
					assert err.code == "ENODRIVER"
				}
				assert err.message == "no driver for 'nosuchdb'"
				failed = true
				recover new FakeConnection()
			}
			assert failed
		}

		@test()
		def TestConnectReportsTheDriversFailure() !none {
			let kind = ErrorKind.Other
			connect("fake://down/main") onerror (err error) {
				kind = err.kind when err is DbError
				recover new FakeConnection()
			}
			assert kind == ErrorKind.Connection
		}
	}

	check "Rows to objects" {
		@test()
		def TestReadFillsFieldsByColumn() !none {
			let conn = new FakeConnection()
			conn.columns = accountColumns()
			conn.data.push(accountRow(7, "seven"))
			let rows = try conn.query("SELECT * FROM accounts")
			assert try rows.next()
			let a = try read<Account>(rows)
			assert a.id == 7
			assert a.email == "user7@example.com"
			assert a.active
			assert a.score == 2.5
			assert orEmpty(a.nickname) == "seven"
			assert a.created.str() == "2026-10-06T12:30:00Z"
			assert a.seen.str() == "1970-01-01T00:16:40Z"
			assert a.role == Role.Admin
			assert a.address.city == "Cluj"
			assert a.address.zip == "400000"
			assert a.avatar.hex() == "010203"
			assert a.session == ""
		}

		@test()
		def TestReadAllAndNulls() !none {
			let conn = new FakeConnection()
			conn.columns = accountColumns()
			conn.data.push(accountRow(1, none))
			conn.data.push(accountRow(2, "two"))
			let all = try readAll<Account>(try conn.query("SELECT * FROM accounts"))
			assert all.len() == 2
			assert all[0].nickname is none
			assert orEmpty(all[1].nickname) == "two"
			assert all[1].id == 2
		}

		@test()
		def TestNullIntoPlainFieldFails() !none {
			let conn = new FakeConnection()
			conn.columns = accountColumns()
			let row = accountRow(1, none)
			row[1] = none
			conn.data.push(row)
			let rows = try conn.query("SELECT * FROM accounts")
			assert try rows.next()
			let kind = ErrorKind.Other
			read<Account>(rows) onerror (err error) {
				kind = err.kind when err is DbError
				recover new Account()
			}
			assert kind == ErrorKind.Type
		}

		@test()
		def TestValuesGivesStoredForms() !none {
			let rowsConn = new FakeConnection()
			rowsConn.columns = accountColumns()
			rowsConn.data.push(accountRow(7, "seven"))
			let rows = try rowsConn.query("SELECT * FROM accounts")
			assert try rows.next()
			let a = try read<Account>(rows)

			let v = values(a)
			assert v.hasKey("email_address")
			assert !v.hasKey("email")
			assert !v.hasKey("session")
			assert text(v["email_address"]) == "user7@example.com"
			assert text(v["created"]) == "2026-10-06T12:30:00Z"
			assert text(v["role"]) == "Admin"
			assert text(v["address"]) == "\{\"city\":\"Cluj\",\"zip\":\"400000\"\}"
			assert text(v["seen"]) == "1000"
			assert text(v["id"]) == "7"

			let conn = new FakeConnection()
			let res = try conn.exec("INSERT INTO accounts VALUES (:id, :email_address)", v)
			assert res.affected == v.len()
		}
	}

	def oneColumn(name string, v any) FakeConnection {
		let conn = new FakeConnection()
		conn.columns.push(Column{name: name, typeName: "", nullable: true})
		let row any[]
		row.push(v)
		conn.data.push(row)
		return conn
	}

	check "sql def entry points" {
		@test()
		def TestStatementTextFollowsTheDriversStyle() !none {
			let conn = new FakeConnection()
			let segments = ["  SELECT * FROM t WHERE a = ", " AND b > ", ";\n"]
			let names = ["a", "user.b"]
			let values any[]
			values.push("x")
			values.push(5)

			conn.marks = Placeholder.Question
			try sqlExec(conn, segments, names, values)
			assert conn.last == "SELECT * FROM t WHERE a = ? AND b > ?"
			assert conn.args.len() == 2
			assert conn.named.len() == 0

			conn.marks = Placeholder.Dollar
			try sqlExec(conn, segments, names, values)
			assert conn.last == "SELECT * FROM t WHERE a = $1 AND b > $2"

			conn.marks = Placeholder.Named
			try sqlExec(conn, segments, names, values)
			assert conn.last == "SELECT * FROM t WHERE a = :a AND b > :p2"
			assert text(conn.named["a"]) == "x"
			assert text(conn.named["p2"]) == "5"

			let noValues any[]
			try sqlExec(conn, ["DELETE FROM t"], string[], noValues)
			assert conn.last == "DELETE FROM t"
		}

		@test()
		def TestRowObjects() !none {
			let conn = new FakeConnection()
			conn.columns = accountColumns()
			conn.data.push(accountRow(1, none))
			conn.data.push(accountRow(2, "two"))
			let none0 any[]

			let one = try sqlOne<Account>(conn, ["SELECT 1"], string[], none0)
			assert one.id == 1
			let maybe = try sqlOptional<Account>(conn, ["SELECT 1"], string[], none0)
			fail "expected a row" when maybe is none
			assert maybe.email == "user1@example.com"
			let all = try sqlAll<Account>(conn, ["SELECT 1"], string[], none0)
			assert all.len() == 2
			assert all[1].id == 2

			let empty0 = new FakeConnection()
			empty0.columns = accountColumns()
			let missing = try sqlOptional<Account>(empty0, ["SELECT 1"], string[], none0)
			assert missing is none
			let kind = ErrorKind.Other
			sqlOne<Account>(empty0, ["SELECT 1"], string[], none0) onerror (err error) {
				kind = err.kind when err is DbError
				recover new Account()
			}
			assert kind == ErrorKind.NoRows
		}

		@test()
		def TestCellsAndNamedScalars() !none {
			let none0 any[]
			let conn = new FakeConnection()
			conn.columns = accountColumns()
			conn.data.push(accountRow(9, none))

			let row = try sqlRow(conn, ["SELECT 1"], string[], none0)
			assert try sqlCell<int>(row, 0) == 9
			assert try sqlCell<string>(row, 1) == "user9@example.com"
			assert try sqlCell<bool>(row, 2)
			assert try sqlCell<float>(row, 3) == 2.5
			assert try sqlCell<float>(row, 0) == 9.0
			let avatar = try sqlCell<byte[]>(row, 9)
			assert avatar.hex() == "010203"
			let created = try sqlCell<time.Time>(row, 5)
			assert created.str() == "2026-10-06T12:30:00Z"
			let nick = try sqlOptionalCell<string>(row, 4)
			assert nick is none
			let id = try sqlOptionalCell<int>(row, 0)
			fail "expected a value" when id is none
			assert id == 9

			let kind = ErrorKind.Other
			sqlCell<int>(row, 1) onerror (err error) {
				kind = err.kind when err is DbError
				recover 0
			}
			assert kind == ErrorKind.Type

			let rows = try sqlRows(conn, ["SELECT 1"], string[], none0)
			assert rows.len() == 1
			assert rows[0].len() == 12
			let noRow = try sqlOptionalRow(new FakeConnection(), ["SELECT 1"], string[], none0)
			assert noRow is none

			let when0 = try sqlOne<time.Time>(oneColumn("t", "2026-10-06T12:30:00Z"), ["SELECT 1"], string[], none0)
			assert when0.str() == "2026-10-06T12:30:00Z"
			let big = try sqlOne<bigint>(oneColumn("n", "123456789012345678901234567890"), ["SELECT 1"], string[], none0)
			assert big.toRadix(10) == "123456789012345678901234567890"
			let times = try sqlAll<time.Time>(oneColumn("t", 1000), ["SELECT 1"], string[], none0)
			assert times.len() == 1
			assert times[0].str() == "1970-01-01T00:16:40Z"
			let nothing = try sqlOptional<time.Time>(oneColumn("t", none), ["SELECT 1"], string[], none0)
			assert nothing is none
		}
	}
}
