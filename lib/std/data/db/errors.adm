partial module std.data.db {
	use std.errors

	// ErrorKind names why a database operation failed, in terms every driver
	// can report.
	enum ErrorKind {
		// No driver for the URL's scheme is linked into the program.
		NoDriver = "ENODRIVER",
		// The database could not be reached, or the connection dropped.
		Connection = "ECONNECTION",
		// The database refused the credentials or the user's rights.
		Denied = "EDENIED",
		// The SQL text does not parse, or names something that does not exist.
		Syntax = "ESYNTAX",
		// A constraint rejected the change: unique, foreign key, not null, check.
		Constraint = "ECONSTRAINT",
		// The database is locked or the transaction conflicted with another;
		// running it again can succeed.
		Conflict = "ECONFLICT",
		// The operation did not finish within its time limit.
		TimedOut = "ETIMEDOUT",
		// The connection, transaction, statement or rows were already closed.
		Closed = "ECLOSED",
		// A bound value or a column cannot be converted to the type asked for,
		// or the argument count differs from the placeholders.
		Type = "ETYPE",
		// A query that must return a row returned none.
		NoRows = "ENOROWS",
		// Any other failure; the message says which.
		Other = "EDB",
	}

	// DbError is the payload every database failure carries. `code` repeats
	// `kind.value`; a handler that narrows with `err is DbError` reads `kind`
	// and what the database itself reported.
	struct DbError {
		message  string
		code     string
		cause    ?error
		stack    errors.StackTrace
		kind     ErrorKind
		// The five-character SQLSTATE, "" when the database has none (SQLite).
		sqlState string
		// The database's own error number (SQLite result code, MySQL errno),
		// 0 when it has none.
		native   int
	}

	// errorOf builds the DbError a driver fails with. `sqlState` and `native`
	// carry what the database itself reported, when it reported any.
	def errorOf(kind ErrorKind, message string, sqlState string = "", native int = 0) DbError {
		return DbError{message: message, code: kind.value, kind: kind, sqlState: sqlState, native: native}
	}
}
