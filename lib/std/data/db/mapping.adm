internal partial module std.data.db.mapping {
	use (
		std.reflection
		std.reflection::(Field, FieldKind)
		std.time
		std.math
		std.data.encoding
		std.data.db::*
	)

	const columnAttr = "std.data.db.column"

	// The column a field is kept in.
	def columnOf(f Field) string {
		let name = f.attr(columnAttr, "name")
		return name == "" ?? (f.name, name)
	}

	// The stored form a field's annotation asks for.
	def storedOf(f Field) Stored {
		let text = f.attr(columnAttr, "stored")
		return Stored.Text when text.endsWith("Text")
		return Stored.Integer when text.endsWith("Integer")
		return Stored.Float when text.endsWith("Float")
		return Stored.Bytes when text.endsWith("Bytes")
		return Stored.JSON when text.endsWith("JSON")
		return Stored.Auto
	}

	// Slot is where one result column goes: the field's index, -1 when no
	// field takes the column.
	struct Slot {
		field    int
		kind     FieldKind
		optional bool
		stored   Stored
		typeName string
		name     string
	}

	// Plan maps a result's columns onto the fields of one type, worked out
	// once and applied to every row.
	type Plan {
		internal slots Slot[]

		def new(columns Column[], target any) {
			let fields = reflection.fields(target)
			let byName = new map<string, int>()
			for let (i, f) in fields {
				continue when f.attr(columnAttr, "ignore") == "true"
				byName.set(columnOf(f).lower(), i)
			}
			for let (_, col) in columns {
				let at = byName.get(col.name.lower())
				if at is none {
					slots.push(Slot{field: -1, kind: FieldKind.Other, optional: false, stored: Stored.Auto, typeName: "", name: col.name})
					continue
				}
				let f = fields[at]
				let optional = f.kind == FieldKind.Optional
				let typeName = f.typeName
				typeName = typeName.slice(1) when optional && typeName.startsWith("?")
				slots.push(Slot{field: at, kind: optional ?? (f.elemKind, f.kind), optional: optional, stored: storedOf(f), typeName: typeName, name: col.name})
			}
		}

		// fill stores the current row in the target's fields.
		// Fails with a DbError of ErrorKind.Type when a column does not
		// convert, or is NULL for a field that is not optional.
		def fill(rows Rows, target any) !none {
			for let (i, slot) in slots {
				continue when slot.field < 0
				let f = new Field(target, slot.field)
				if rows.isNull(i) {
					fail errorOf(ErrorKind.Type, "column '{slot.name}' is NULL and field `{f.name}` is not optional") unless slot.optional
					f.setNone()
					continue
				}
				try store(rows, i, slot, f)
			}
			return none
		}
	}

	def mismatch(slot Slot, f Field) DbError {
		return errorOf(ErrorKind.Type, "column '{slot.name}' does not convert to field `{f.name}` ({f.typeName})")
	}

	// Stores one column of the current row in a field.
	def store(rows Rows, i int, slot Slot, f Field) !none {
		let ok = false
		match slot.kind {
			case FieldKind.Bool:
				if slot.stored == Stored.Text {
					let text = (try rows.string(i)).lower()
					fail mismatch(slot, f) unless text := "true" || "false" || "t" || "f" || "1" || "0"
					ok = f.setBool(text := "true" || "t" || "1")
				} else {
					ok = f.setBool(try rows.bool(i))
				}
			case FieldKind.Int:
				ok = f.setInt(try rows.int(i))
			case FieldKind.Uint:
				ok = f.setUint(uint(try rows.int(i)))
			case FieldKind.Float:
				ok = f.setFloat(try rows.float(i))
			case FieldKind.String:
				ok = f.setString(try rows.string(i))
			case FieldKind.Enum:
				ok = try storeEnum(rows, i, f)
			case FieldKind.Array:
				fail mismatch(slot, f) unless slot.typeName := "byte[]" || "uint8[]"
				let b = try rows.bytes(i)
				f.setLen(b.len())
				for let (n, x) in b {
					f.at(n).setUint(uint(x))
				}
				ok = true
			case FieldKind.Struct:
				ok = try storeObject(rows, i, slot, f)
			default:
				ok = f.set(try rows.value(i))
		}
		fail mismatch(slot, f) unless ok
		return none
	}

	// Stores an enum: by member name from text, else by value.
	def storeEnum(rows Rows, i int, f Field) !bool {
		let v = try rows.value(i)
		match v {
			case string:
				let desc = f.descriptor
				return false when desc is none
				for let (_, m) in reflection.members(desc) {
					continue unless m.node.name == v
					return f.setInt(reflection.scalarText(m.value).toInt<int>())
				}
				return false
			case int:
				return f.setInt(v)
			default:
				return false
		}
	}

	// Stores a time, decimal, big integer or JSON object.
	def storeObject(rows Rows, i int, slot Slot, f Field) !bool {
		if slot.stored == Stored.JSON {
			let nested = f.ensureValue()
			return false when nested is none
			let codec = new encoding.JSON()
			codec.decode(try rows.string(i), nested) onerror (err error) {
				fail errorOf(ErrorKind.Type, "column '{slot.name}' is not the JSON of field `{f.name}`: {err.message}")
			}
			return true
		}
		let v = try rows.value(i)
		let converted = namedValue(slot.typeName, v) onerror fail mismatch(slot, f)
		return false when converted is none
		return f.set(converted)
	}

	// Reports whether a type is read from one column, not from a row.
	def isNamedScalar(typeName string) bool {
		return typeName := "std.time.Time" || "time.Time" || "std.time.Date" || "time.Date" || "std.time.TimeOfDay" || "time.TimeOfDay" || "std.time.DateTime" || "time.DateTime" || "std.math.Decimal" || "math.Decimal" || "builtin.bigint" || "bigint"
	}

	// A column value as the named type: a time, date, decimal or big
	// integer from the database's own value, from text or from a number.
	// The value unchanged for any other type; none when its type does not
	// convert. Fails when text does not parse as the type.
	def namedValue(typeName string, v any) !?any {
		match typeName {
			case "std.time.Time", "time.Time", "Time":
				match v {
					case time.Time:
						return v
					case string:
						return try time.parse(v)
					case int:
						return time.fromUnixNs(int64(v) * int64(1000000000))
					case float:
						return time.fromUnixNs(int64(v * 1000000000.0))
					default:
						return none
				}
			case "std.time.Date", "time.Date", "Date":
				match v {
					case time.Date:
						return v
					case string:
						return try time.parseDate(v)
					default:
						return none
				}
			case "std.time.TimeOfDay", "time.TimeOfDay", "TimeOfDay":
				match v {
					case time.TimeOfDay:
						return v
					case string:
						return try time.parseTimeOfDay(v)
					default:
						return none
				}
			case "std.time.DateTime", "time.DateTime", "DateTime":
				match v {
					case time.DateTime:
						return v
					case string:
						return try time.parseDateTime(v)
					default:
						return none
				}
			case "std.math.Decimal", "math.Decimal", "Decimal":
				match v {
					case math.Decimal:
						return v
					case string:
						return try math.parseDecimal(v)
					case int:
						return new math.Decimal(v)
					case float:
						return new math.Decimal(v)
					default:
						return none
				}
			case "builtin.bigint", "bigint":
				match v {
					case bigint:
						return v
					case string:
						return try parseBigInt(v)
					case int:
						return bigint(v)
					case byte[]:
						return parseBigInt(v)
					default:
						return none
				}
			default:
				return v
		}
	}

	// The value of a field in its stored form, none for an empty optional.
	def storedValue(f Field) any {
		let stored = storedOf(f)
		let kind = f.kind
		if kind == FieldKind.Optional {
			let held = f.value()
			return none when held is none
			return storedForm(held, stored)
		}
		match kind {
			case FieldKind.Bool:
				return storedForm(f.asBool(), stored)
			case FieldKind.Int:
				return storedForm(f.asInt(), stored)
			case FieldKind.Uint:
				return storedForm(int(f.asUint()), stored)
			case FieldKind.Float:
				return storedForm(f.asFloat(), stored)
			case FieldKind.String:
				return storedForm(f.asString(), stored)
			case FieldKind.Enum:
				return f.asInt() unless stored == Stored.Text
				let desc = f.descriptor
				return f.asInt() when desc is none
				let text = f.asInt().str()
				for let (_, m) in reflection.members(desc) {
					return m.node.name when reflection.scalarText(m.value) == text
				}
				return f.asInt()
			case FieldKind.Array:
				let b byte[]
				let n = f.len()
				b.len(n)
				for let i = 0; i < n; i++ {
					b[i] = byte(f.at(i).asUint())
				}
				return b
			default:
				let held = f.value()
				return none when held is none
				return storedForm(held, stored)
		}
	}

	// A value converted to the stored form asked for; unchanged when the form
	// does not apply to its type.
	def storedForm(v any, stored Stored) any {
		return v when stored == Stored.Auto
		return string(new encoding.JSON().encode(v)) when stored == Stored.JSON
		match v {
			case bool:
				return (v ?? ("true", "false")) when stored == Stored.Text
				return (v ?? (1, 0)) when stored == Stored.Integer
				return v
			case int:
				return v.str() when stored == Stored.Text
				return float(v) when stored == Stored.Float
				return v
			case float:
				return v.str() when stored == Stored.Text
				return v
			case string:
				return v.bytes() when stored == Stored.Bytes
				return v
			case time.Time:
				return v.str() when stored == Stored.Text
				return int(v.unixNs() / int64(1000000000)) when stored == Stored.Integer
				return float(v.unixNs()) / 1000000000.0 when stored == Stored.Float
				return v
			case time.Date:
				return v.str() when stored == Stored.Text
				return v
			case time.TimeOfDay:
				return v.str() when stored == Stored.Text
				return v
			case time.DateTime:
				return v.str() when stored == Stored.Text
				return v
			case math.Decimal:
				return v.str() when stored == Stored.Text
				return v
			case bigint:
				return v.toRadix(10) when stored == Stored.Text
				return v.bytes() when stored == Stored.Bytes
				return v
			default:
				return v
		}
	}
}
