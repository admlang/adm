partial module std.data.db {
	// positional rewrites a statement written with `:name` placeholders for
	// a database that binds by position, and returns the new text with the
	// arguments in the order it asks for them:
	//
	//     let (text, args) = try db.positional("UPDATE t SET a = :a WHERE id = :id", db.values(row), db.Placeholder.Dollar)
	//     // "UPDATE t SET a = $1 WHERE id = $2"
	//
	// With Placeholder.Question every occurrence becomes `?` and adds its
	// value; with Placeholder.Dollar a name used twice keeps one number.
	// Names inside quoted text, quoted identifiers and comments are left
	// alone, as are `::` casts and, for Placeholder.Dollar, dollar-quoted
	// text. `backslashes` says that `\` escapes the next character inside
	// quotes, and that `#` starts a comment (MySQL).
	// Fails with a DbError of ErrorKind.Type when the text names an argument
	// `named` does not hold.
	def positional(statement string, named map<string, any>, marks Placeholder, backslashes bool = false) !(string, any[]) {
		let (text, names) = placeholders(statement, marks, backslashes)
		let args any[]
		for let (_, name) in names {
			fail errorOf(ErrorKind.Type, "no argument named '{name}'") unless named.hasKey(name)
			args.push(named[name])
		}
		return (text, args)
	}

	// placeholders rewrites a statement's `:name` placeholders as
	// `positional` does and returns the new text with the names in the order
	// their arguments are bound: a driver that prepares a statement once
	// keeps the names and picks the values at each run.
	def placeholders(statement string, marks Placeholder, backslashes bool = false) (string, string[]) {
		let src = statement.bytes()
		let n = src.len()
		let out byte[]
		let names string[]
		let numbers = new map<string, int>()
		let i = 0
		for i < n {
			let c = int(src[i])
			// Quoted text and identifiers.
			if c := 39 || 34 || 96 {
				let end = quotedEnd(src, i, backslashes && c != 96)
				out.push(...src[i:end])
				i = end
				continue
			}
			// Comments.
			if c == 45 && i + 1 < n && int(src[i + 1]) == 45 {
				let end = lineEnd(src, i)
				out.push(...src[i:end])
				i = end
				continue
			}
			if backslashes && c == 35 {
				let end = lineEnd(src, i)
				out.push(...src[i:end])
				i = end
				continue
			}
			if c == 47 && i + 1 < n && int(src[i + 1]) == 42 {
				let end = blockEnd(src, i)
				out.push(...src[i:end])
				i = end
				continue
			}
			// Dollar-quoted text.
			if c == 36 && marks == Placeholder.Dollar {
				let end = dollarEnd(src, i)
				if end > i {
					out.push(...src[i:end])
					i = end
					continue
				}
			}
			if c != 58 {
				out.push(src[i])
				i++
				continue
			}
			// `::` is a cast.
			if i + 1 < n && int(src[i + 1]) == 58 {
				out.push(src[i], src[i + 1])
				i += 2
				continue
			}
			let end = i + 1
			for end < n && isNameByte(int(src[end]), end == i + 1) {
				end++
			}
			if end == i + 1 {
				out.push(src[i])
				i++
				continue
			}
			let name = string(src[i + 1:end])
			if marks == Placeholder.Dollar {
				let number = numbers.get(name)
				if number is none {
					names.push(name)
					numbers.set(name, names.len())
					out.push(..."${names.len()}".bytes())
				} else {
					out.push(..."${number}".bytes())
				}
			} else {
				names.push(name)
				out.push(byte(63))
			}
			i = end
		}
		return (string(out), names)
	}

	// The offset after the quoted run that starts at `at`; a doubled quote
	// stays inside it.
	internal def quotedEnd(src byte[], at int, backslashes bool) int {
		let quote = int(src[at])
		let n = src.len()
		let i = at + 1
		for i < n {
			let c = int(src[i])
			if backslashes && c == 92 {
				i += 2
				continue
			}
			if c == quote {
				if i + 1 < n && int(src[i + 1]) == quote {
					i += 2
					continue
				}
				return i + 1
			}
			i++
		}
		return n
	}

	// The offset of the line break that ends a comment starting at `at`.
	internal def lineEnd(src byte[], at int) int {
		let i = at
		for i < src.len() && int(src[i]) != 10 {
			i++
		}
		return i
	}

	// The offset after the block comment that starts at `at`; comments nest.
	internal def blockEnd(src byte[], at int) int {
		let n = src.len()
		let depth = 0
		let i = at
		for i < n {
			if i + 1 < n && int(src[i]) == 47 && int(src[i + 1]) == 42 {
				depth++
				i += 2
				continue
			}
			if i + 1 < n && int(src[i]) == 42 && int(src[i + 1]) == 47 {
				depth--
				i += 2
				return i when depth == 0
				continue
			}
			i++
		}
		return n
	}

	// The offset after the dollar-quoted text that starts at `at`
	// (`$$...$$`, `$tag$...$tag$`); `at` itself when no such text starts
	// there.
	internal def dollarEnd(src byte[], at int) int {
		let n = src.len()
		let close = at + 1
		for close < n && isNameByte(int(src[close]), close == at + 1) {
			close++
		}
		return at when close >= n || int(src[close]) != 36
		let tag = string(src[at:close + 1])
		let found = string(src[close + 1:n]).indexOf(tag)
		return n when found < 0
		return close + 1 + found + tag.len()
	}

	// Reports whether a byte may be part of a placeholder name; a digit may
	// not start one.
	internal def isNameByte(c int, first bool) bool {
		return true when (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
		return !first && c >= 48 && c <= 57
	}
}
