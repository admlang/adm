partial module std.data.db {
	use (
		std.testing
		std.reflection
	)

	check "Named to positional" {
		@test()
		def TestPositionalRewritesNames() !none {
			let named = new map<string, any>()
			named.set("id", 7)
			named.set("name", "Ana")

			let (q, qa) = try positional("UPDATE t SET name = :name, alias = :name WHERE id = :id", named, Placeholder.Question)
			assert q == "UPDATE t SET name = ?, alias = ? WHERE id = ?"
			assert qa.len() == 3
			assert reflection.scalarText(qa[2]) == "7"

			let (d, da) = try positional("UPDATE t SET name = :name, alias = :name WHERE id = :id", named, Placeholder.Dollar)
			assert d == "UPDATE t SET name = $1, alias = $1 WHERE id = $2"
			assert da.len() == 2
			assert reflection.scalarText(da[0]) == "Ana"
			assert reflection.scalarText(da[1]) == "7"

			let (text, names) = placeholders("SELECT :b, :a, :b", Placeholder.Question)
			assert text == "SELECT ?, ?, ?"
			assert names.join(",") == "b,a,b"
		}

		@test()
		def TestPositionalLeavesQuotedTextAndCasts() !none {
			let named = new map<string, any>()
			named.set("id", 7)
			let source = "SELECT ':id', \":id\", '''' || :id::text, $q$ :id $q$, 10:30 -- :id\n/* :id /* :id */ */ FROM t WHERE a = :id"
			let (d, da) = try positional(source, named, Placeholder.Dollar)
			assert d == "SELECT ':id', \":id\", '''' || $1::text, $q$ :id $q$, 10:30 -- :id\n/* :id /* :id */ */ FROM t WHERE a = $1"
			assert da.len() == 1

			let (m, ma) = try positional("SELECT 'it\\'s :id', `:id` FROM t WHERE a = :id # :id", named, Placeholder.Question, true)
			assert m == "SELECT 'it\\'s :id', `:id` FROM t WHERE a = ? # :id"
			assert ma.len() == 1

			let kind = ErrorKind.Other
			let noArgs any[]
			positional("SELECT :missing", named, Placeholder.Question) onerror (err error) {
				kind = err.kind when err is DbError
				recover ("", noArgs)
			}
			assert kind == ErrorKind.Type
		}
	}
}
