partial module std.data.db {
	use (
		std.testing
		std.time
	)

	def runAfter(p Pool, wait duration, statement string) !Result {
		time.sleep(wait)
		return p.exec(statement)
	}

	check "Pool" {
		@test()
		def TestStatementsShareConnections() !none {
			let p = try pool("fake://host/main", 4)
			assert p.limit() == 4
			assert p.placeholder() == Placeholder.Named
			let before = fakeTally.opened
			for let i = 0; i < 10; i++ {
				try p.exec("UPDATE t SET a = 1")
			}
			try p.ping()
			assert fakeTally.opened == before + 1
			assert p.idleCount() == 1

			// Rows hold their connection until they end or are closed.
			let a = try p.query("SELECT 1")
			let b = try p.query("SELECT 1")
			assert fakeTally.opened == before + 2
			assert p.idleCount() == 0
			assert !(try a.next())
			assert p.idleCount() == 1
			try b.close()
			try b.close()
			assert p.idleCount() == 2

			// A caller may hold a connection itself and hand it back.
			let own = try p.borrow()
			assert p.idleCount() == 1
			try own.ping()
			p.giveBack(own, false)
			assert p.idleCount() == 2

			let closedBefore = fakeTally.closed
			try p.close()
			assert fakeTally.closed == closedBefore + 2
			let kind = ErrorKind.Other
			p.exec("UPDATE t SET a = 1") onerror (err error) {
				kind = err.kind when err is DbError
				recover Result{affected: 0, lastInsertId: 0}
			}
			assert kind == ErrorKind.Closed
		}

		@test()
		def TestBorrowersWaitAtTheLimit() !none {
			let p = try pool("fake://host/main", 1)
			let held = try p.query("SELECT 1")
			let started = time.now()
			let waiting = async runAfter(p, 0s, "UPDATE t SET a = 1")
			time.sleep(200ms)
			try held.close()
			try await waiting
			assert time.since(started) >= 200ms
			assert p.idleCount() == 1
			try p.close()
		}

		@test()
		def TestBrokenConnectionsAreNotReused() !none {
			let p = try pool("fake://host/main", 2)
			let before = fakeTally.opened
			let closedBefore = fakeTally.closed
			try p.exec("UPDATE t SET a = 1")

			let kind = ErrorKind.Other
			p.exec("BREAK") onerror (err error) {
				kind = err.kind when err is DbError
				recover Result{affected: 0, lastInsertId: 0}
			}
			assert kind == ErrorKind.Connection
			assert p.idleCount() == 0
			assert fakeTally.closed == closedBefore + 1

			// A statement the database rejects leaves the connection usable.
			try p.exec("UPDATE t SET a = 1")
			p.exec("WRONG") onerror recover Result{affected: 0, lastInsertId: 0}
			assert p.idleCount() == 1
			assert fakeTally.opened == before + 2

			// An idle connection past its check is pinged, then lent.
			p.idleCheck = 0s
			try p.exec("UPDATE t SET a = 1")
			assert fakeTally.opened == before + 2
			try p.close()
		}

		@test()
		def TestUnknownSchemeAndBadUrl() !none {
			let fallback = try pool("fake://host/main")
			let kind = ErrorKind.Other
			pool("nosuchdb://host/main") onerror (err error) {
				kind = err.kind when err is DbError
				recover fallback
			}
			assert kind == ErrorKind.NoDriver
			assert fallback.limit() == 8
		}
	}
}
