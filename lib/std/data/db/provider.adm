partial module std.data.db {
	use std.data.db.providing::*

	// provide registers where `sql def` functions without a connection of
	// their own find one: a function from a connection's name, none for
	// the default, to the connection. The Database service registers itself
	// when it starts and withdraws, with `provide(none)`, when it stops.
	def provide(source ?def (name ?string) !Queryable) {
		held.put(source)
	}

	// sqlDefault returns the default connection, for a `sql def` that is
	// neither a method of a type with a `@connection` property nor
	// annotated `@db("name")`.
	// Fails with a DbError of ErrorKind.Other when nothing provides
	// connections, else as the provider does.
	def sqlDefault() !Queryable {
		let source = held.get()
		fail errorOf(ErrorKind.Other, "no database connection for this sql def: start the Database service and add a connection, or give the type a @connection property") when source is none
		return source(none)
	}

	// sqlNamed returns the connection a `sql def` annotated `@db("name")`
	// asks for.
	// Fails with a DbError of ErrorKind.Other when nothing provides
	// connections, else as the provider does.
	def sqlNamed(name string) !Queryable {
		let source = held.get()
		fail errorOf(ErrorKind.Other, "no database connection named '{name}' for this sql def: start the Database service and add it, or give the type a @connection property") when source is none
		return source(name)
	}
}

internal partial module std.data.db.providing {
	use std.data.db::*

	// Holder keeps the registered provider under a lock.
	type Holder {
		internal source ?def (name ?string) !Queryable = none

		def new() {}

		atomic def put(source ?def (name ?string) !Queryable) {
			self.source = source
		}

		atomic def get() ?def (name ?string) !Queryable {
			return source
		}
	}

	let held = new Holder()
}
