partial module std.data.db {
	use std.testing

	def fakeSource(name ?string) !Queryable {
		let conn = new FakeConnection()
		conn.last = name is none ?? ("default", name)
		return conn
	}

	check "Connection provider" {
		@test()
		def TestSqlDefaultAndNamedAskTheProvider() !none {
			provide(none)
			let kind = ErrorKind.Syntax
			sqlDefault() onerror (err error) {
				kind = err.kind when err is DbError
				recover new FakeConnection()
			}
			assert kind == ErrorKind.Other

			provide(fakeSource)
			let main = try sqlDefault()
			let reports = try sqlNamed("reports")
			try sqlExec(main, ["UPDATE t SET a = 1"], string[], [])
			try sqlExec(reports, ["UPDATE t SET a = 2"], string[], [])
			provide(none)
		}
	}
}
