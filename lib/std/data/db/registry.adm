internal partial module std.data.db.registry {
	use (
		std.reflection
		std.data.db::*
	)

	// Registry is the drivers linked into the program, found through the
	// `driver` annotation on first use, by URL scheme.
	type Registry {
		internal byScheme map<string, reflection.TypeDescriptor>
		internal loaded   bool

		def new() {
			byScheme = new map<string, reflection.TypeDescriptor>()
		}

		internal atomic def discover() {
			return when loaded
			loaded = true
			for let (_, hit) in reflection.attrs(driver) {
				let t = reflection.asType(hit.node)
				continue when t is none

				// A variadic annotation argument arrives as one entry per
				// value: "#0", "#1", ... by position, the first also under
				// the parameter's name.
				for let (key, scheme) in hit.attr.arguments {
					continue unless key == "schemes" || key.startsWith("#")
					let name = reflection.scalarText(scheme).lower()
					continue when name.len() == 0
					byScheme.set(name, t)
				}
			}
		}

		// find returns a new instance of the driver registered for the
		// scheme, none when the program links none.
		def find(scheme string) ?Driver {
			discover()
			let t = byScheme.get(scheme.lower())
			return none when t is none

			let made = reflection.instantiate(t)
			return none unless made is Driver
			return made
		}

		// schemes returns every registered scheme, sorted.
		def schemes() string[] {
			discover()
			return byScheme.keys().sort((a, b) => a < b)
		}
	}

	let registry = new Registry()
}
