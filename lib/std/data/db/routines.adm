partial module std.data.db {
	use (
		std.reflection
		std.data.db.mapping::*
		std.data.db.pooling::*
		std.data.db.routines::*
		std.data.db.sqlcall::*
	)

	// routine marks a `sql def` whose body is a stored routine (first word
	// BEGIN or DECLARE, last word END). The compiler adds it to such a
	// function, with `body` the routine's text and `connection` the
	// Database service connection the migrations install it on (absent for
	// the default one). A program writes it to create the routine under
	// another name than the function's, or in a schema of its own:
	//
	//     @db.routine(name = "top_users", schema = "reports")
	//     sql def topUsers(n int) !User[] {
	//         BEGIN
	//             RETURN QUERY SELECT * FROM users ORDER BY score DESC LIMIT n;
	//         END
	//     }
	//
	// The routine is then `reports.top_users`, created and called by that
	// name. `name` and `schema` are plain identifiers; without `schema` it
	// goes in the connection's current schema (PostgreSQL) or database
	// (MySQL). The compiler fills in `body` and `connection`.
	meta def routine(ctx reflection.DiscoveryMetaContext<reflection.FunctionMetaContext>, body string = "", connection string = "", name string = "", schema string = "") {}

	// routine marks a `sql def` method holding a stored routine, as the
	// function form above.
	meta def routine(ctx reflection.DiscoveryMetaContext<reflection.MethodMetaContext>, body string = "", connection string = "", name string = "", schema string = "") {}

	// RoutineKind is how a stored routine is declared and called, chosen by
	// the `sql def` result.
	enum RoutineKind {
		// `!none`: a procedure, run with `CALL name(...)`.
		Procedure,
		// A primitive, a time, date, decimal or big integer, optional or
		// not: a function returning that value, run with `SELECT name(...)`.
		Function,
		// Rows (`!T[]`, `!T`, `!?T` of a declared type, a tuple): a function
		// returning a table on PostgreSQL, a procedure whose `SELECT`
		// returns them on MySQL.
		Rows,
	}

	// RoutineValue is a parameter, result or result column of a stored
	// routine: its name and its type as ADM declares it (`int`, `?string`,
	// `std.time.Time`). A driver writes the database's type for it.
	struct RoutineValue {
		name     string
		typeName string
	}

	// Routine is a stored routine a `sql def` declares, as the migrations
	// install it.
	struct Routine {
		// The name the routine is created under: the function's, or the
		// `name` of its `routine` annotation.
		name       string
		// The schema (MySQL: the database) it is created in, "" for the
		// connection's current one.
		schema     string
		kind       RoutineKind
		parameters RoutineValue[]
		// The value a Function returns; empty for the other kinds.
		result     RoutineValue
		// The columns a Rows routine returns, by the names the result's
		// fields are read from (`@column`), or `c1`, `c2`... for a tuple.
		columns    RoutineValue[]
		// The body as written, without a closing `;`.
		body       string
		// A digest of everything above, kept with the routine in the
		// database: a routine whose digest is there already is not created
		// again.
		hash       string
		// The Database service connection it is installed on; none for the
		// default one.
		connection ?string
	}

	// Dialect is what a driver adds to its connections for the statements
	// that differ between databases: calling and installing stored
	// routines, and the lock that keeps two instances of a program from
	// migrating one database at once. A driver type implements it beside
	// Driver; std finds it through the pool a statement runs on
	// (`dialectOf`).
	interface Dialect {
		// routineCall returns the statement that calls a routine with
		// `args` arguments, as text around the arguments' places (one more
		// part than there are arguments), as `sql def` text is written.
		// Fails with a DbError of ErrorKind.Other when the database has no
		// stored routines.
		def routineCall(kind RoutineKind, name string, args int) !string[]

		// installRoutine creates the routine on the connection, or replaces
		// the one of that name, unless the database holds it with the same
		// hash already. Returns whether it created it.
		// Fails with a DbError when the database has no stored routines, a
		// type has no database type, or the database rejects the routine.
		def installRoutine(conn Connection, routine Routine) !bool

		// lockMigrations takes the lock that migrating the database holds,
		// waiting while another session holds it; `key` names the program.
		// Fails with a DbError when the connection is lost.
		def lockMigrations(conn Connection, key string) !none

		// unlockMigrations releases the lock lockMigrations took.
		// Fails with a DbError when the connection is lost.
		def unlockMigrations(conn Connection, key string) !none

		// backslashEscapes reports whether `\` escapes the next character
		// in quoted text, and `#` starts a comment (MySQL), for splitting a
		// script into statements.
		def backslashEscapes() bool
	}

	// dialectOf returns the Dialect of the driver a statement on q runs
	// through: the pool's driver for a Pool or a transaction it lent, else
	// q itself when it implements Dialect; none when nothing does.
	def dialectOf(q Queryable) ?Dialect {
		let held any = q
		if held is Pool {
			let driver any = held.driver
			return driver when driver is Dialect
			return none
		}
		if held is PooledTransaction {
			let driver any = held.pool.driver
			return driver when driver is Dialect
			return none
		}
		return held when held is Dialect
		return none
	}

	// sqlScript runs a `sql def` that holds several statements, one by one
	// in order, each with the placeholders that fall in it bound; on the
	// transaction of a `transaction` block when it runs in one. The text is
	// split where a `;` ends a statement outside quotes, comments and
	// `BEGIN ... END` (a trigger's body), as the driver quotes text.
	// Fails with a DbError as `Queryable.exec` does, whose message starts
	// with the statement that failed ("statement 4 of 9: ...").
	def sqlScript(q Queryable, segments string[], names string[], values any[]) !none {
		let dialect = dialectOf(q)
		let backslashes = false
		backslashes = dialect.backslashEscapes() unless dialect is none
		let statements = splitScript(segments, backslashes)
		let at = 0
		for let (i, statement) in statements {
			let count = statement.len() - 1
			let these = names[at:at + count]
			let bound = values[at:at + count]
			at += count
			sqlExec(q, statement, these, bound) onerror (err error) {
				fail scriptError(err, i + 1, statements.len())
			}
		}
		return none
	}

	// sqlRoutineCall returns the statement that calls a stored routine, as
	// text around its arguments, in the form q's driver writes it.
	// Fails with a DbError of ErrorKind.Other when q's driver has no
	// Dialect or its database has no stored routines.
	def sqlRoutineCall(q Queryable, name string, args int, kind RoutineKind) !string[] {
		let dialect = dialectOf(q)
		fail errorOf(ErrorKind.Other, "{name} is a stored routine, and the driver this connection runs through does not say how to call one (it implements no db.Dialect)") when dialect is none
		return dialect.routineCall(kind, name, args)
	}

	// routineKindOf returns the kind of routine a `sql def` reading a T
	// calls: a Function for a time, date, decimal or big integer, a
	// Procedure for a `Result`, else Rows.
	def routineKindOf<T>() RoutineKind {
		let zero T
		return routineKindNamed(reflection.typeName(zero))
	}

	// routines returns the stored routines the program declares, from the
	// `routine` annotation the compiler gives each.
	// Fails with a DbError of ErrorKind.Type when a routine's result has
	// no fields to name its columns, and of ErrorKind.Other when a function
	// that is not a `sql def` stored routine carries `routine`.
	def routines() !Routine[] {
		let out Routine[]
		for let (_, hit) in reflection.attrs(routine) {
			out.push(try routineOf(hit))
		}
		return out
	}

	// lockMigrations lends a connection of the pool for migrating its
	// database and takes the migration lock on it (Dialect), waiting while
	// another instance of the program migrates. Give it back with
	// `unlockMigrations`. A driver without a Dialect takes no lock.
	// Fails with a DbError when no connection can be opened or the lock
	// cannot be taken.
	def lockMigrations(pool Pool, key string) !Connection {
		let conn = try pool.borrow()
		let dialect = dialectOf(pool)
		if !(dialect is none) {
			dialect.lockMigrations(conn, key) onerror (err error) {
				pool.giveBack(conn, isBroken(err))
				fail err
			}
		}
		return conn
	}

	// unlockMigrations releases the lock lockMigrations took and gives the
	// connection back to the pool.
	// Fails with a DbError when the lock cannot be released; the
	// connection is closed then.
	def unlockMigrations(pool Pool, conn Connection, key string) !none {
		let dialect = dialectOf(pool)
		if !(dialect is none) {
			dialect.unlockMigrations(conn, key) onerror (err error) {
				pool.giveBack(conn, true)
				fail err
			}
		}
		pool.giveBack(conn, false)
		return none
	}

	// installRoutine creates a routine on the pool's database through its
	// driver's Dialect, unless it is there with the same hash. Returns
	// whether it created it.
	// Fails with a DbError of ErrorKind.Other when the driver has no
	// Dialect, else as `Dialect.installRoutine` does.
	def installRoutine(pool Pool, conn Connection, routine Routine) !bool {
		let dialect = dialectOf(pool)
		fail errorOf(ErrorKind.Other, "stored routine {routine.name}: the driver of {pool} does not say how to install one (it implements no db.Dialect)") when dialect is none
		return dialect.installRoutine(conn, routine)
	}

	// readVersion returns the version a program's migrations brought the
	// database to, from the table `table` (`schema.table` as the database
	// names it), none when the table holds no row for the program. The
	// table is created when missing: one row per program, its name and
	// version as text.
	// Fails with a DbError when the table cannot be created or read.
	def readVersion(q Queryable, table string, program string) !?string {
		let marks = q.placeholder()
		try q.exec("CREATE TABLE IF NOT EXISTS {table} (application varchar(200) PRIMARY KEY, version varchar(100) NOT NULL)")
		let rows = try q.query(statementText(["SELECT version FROM {table} WHERE application = ", ""], ["application"], marks), namedValues(marks, ["application"], [program]), program)
		defer rows.close()
		return none unless try rows.next()
		return try rows.string(0)
	}

	// writeVersion records the version a program's migrations brought the
	// database to in the table readVersion reads.
	// Fails with a DbError when the table cannot be written.
	def writeVersion(q Queryable, table string, program string, version string) !none {
		let marks = q.placeholder()
		let names = ["version", "application"]
		let values any[] = [version, program]
		let changed = try q.exec(statementText(["UPDATE {table} SET version = ", " WHERE application = ", ""], names, marks), namedValues(marks, names, values), ...values)
		return none when changed.affected > 0
		let inserted = ["application", "version"]
		let row any[] = [program, version]
		try q.exec(statementText(["INSERT INTO {table} (application, version) VALUES (", ", ", ")"], inserted, marks), namedValues(marks, inserted, row), ...row)
		return none
	}
}

internal partial module std.data.db.routines {
	use (
		std.reflection
		std.reflection::(TypeKind)
		std.crypto.hash::(SHA256)
		std.data.db::*
		std.data.db.mapping::*
		std.data.db.scanning::*
	)

	// The kind of routine read as the named type: a Function for a value
	// read from one column, a Procedure for a statement's outcome, else
	// Rows.
	def routineKindNamed(typeName string) RoutineKind {
		return RoutineKind.Procedure when typeName == "std.data.db.Result"
		return RoutineKind.Function when isNamedScalar(typeName)
		return RoutineKind.Rows
	}

	// The Routine one `routine` annotation describes.
	def routineOf(hit reflection.AttrHit) !Routine {
		let routine = Routine{
			name:       hit.node.name,
			schema:     argText(hit, "schema"),
			body:       argText(hit, "body"),
			connection: none,
		}
		fail errorOf(ErrorKind.Other, "{hit.node.qualifiedName} carries @routine but is not a sql def whose body is a stored routine (BEGIN ... END)") when routine.body == ""
		let renamed = argText(hit, "name")
		routine.name = renamed unless renamed == ""
		let connection = hit.attr.arguments.valueOf("connection")
		routine.connection = string(connection) unless connection is none
		let fn = reflection.asFunction(hit.node)
		if !(fn is none) {
			for let (_, param) in fn.signature.parameters {
				continue when param.node.name == "self"
				routine.parameters.push(RoutineValue{name: param.node.name, typeName: spelled(param.paramType)})
			}
			try describeResult(routine, fn.signature.result)
		}
		routine.hash = digest(routine)
		return routine
	}

	// Sets the kind of routine, and its result or columns, from the
	// `sql def` result.
	def describeResult(routine Routine, result reflection.TypeDescriptor) !none {
		let name = plainName(result)
		if name == "none" {
			routine.kind = RoutineKind.Procedure
			return none
		}
		if result.kind == TypeKind.Tuple {
			routine.kind = RoutineKind.Rows
			for let (i, elem) in result.elements {
				routine.columns.push(RoutineValue{name: "c{i + 1}", typeName: spelled(elem)})
			}
			return none
		}
		let elem = result.element
		if result.kind == TypeKind.Array && name != "byte[]" && !(elem is none) {
			routine.kind = RoutineKind.Rows
			if elem.kind == TypeKind.Tuple {
				for let (i, part) in elem.elements {
					routine.columns.push(RoutineValue{name: "c{i + 1}", typeName: spelled(part)})
				}
				return none
			}
			if isPrimitive(elem) || isNamedScalar(plainName(elem)) {
				routine.columns.push(RoutineValue{name: "c1", typeName: spelled(elem)})
				return none
			}
			return describeColumns(routine, elem)
		}
		if isPrimitive(result) {
			routine.kind = RoutineKind.Function
			routine.result = RoutineValue{name: "", typeName: spelled(result)}
			return none
		}
		routine.kind = routineKindNamed(name)
		if routine.kind == RoutineKind.Function {
			routine.result = RoutineValue{name: "", typeName: spelled(result)}
			return none
		}
		return none when routine.kind == RoutineKind.Procedure
		return describeColumns(routine, result)
	}

	// The columns of a Rows routine whose rows are read as the type: its
	// fields, by the column each is read from.
	def describeColumns(routine Routine, row reflection.TypeDescriptor) !none {
		let zero = reflection.instantiate(row)
		fail errorOf(ErrorKind.Type, "stored routine {routine.name} returns {row.typeName}, which has no fields to name its columns") when zero is none
		for let (_, f) in reflection.fields(zero) {
			routine.columns.push(RoutineValue{name: columnOf(f), typeName: f.typeName})
		}
		fail errorOf(ErrorKind.Type, "stored routine {routine.name} returns {row.typeName}, which has no fields to name its columns") when routine.columns.len() == 0
		return none
	}

	// A type as ADM writes it, `?` included.
	def spelled(t reflection.TypeDescriptor) string {
		return t.optional ?? ("?" + plainName(t), plainName(t))
	}

	// The type's name, a built-in one without its `builtin.` module.
	def plainName(t reflection.TypeDescriptor) string {
		return t.typeName.trimPrefix("builtin.")
	}

	// Reports whether the type is a number, `string`, `bool` or `byte[]`.
	def isPrimitive(t reflection.TypeDescriptor) bool {
		return true when t.kind == TypeKind.Primitive
		return plainName(t) := "int" || "int8" || "int16" || "int32" || "int64" || "uint" || "uint8" || "uint16" || "uint32" || "uint64" || "byte" || "float" || "float16" || "float32" || "float64" || "string" || "bool" || "byte[]"
	}

	// An annotation argument as text.
	def argText(hit reflection.AttrHit, name string) string {
		let v = hit.attr.arguments.valueOf(name)
		return "" when v is none
		return string(v)
	}

	// The digest a routine is kept under: SHA-256 of its declaration, in
	// hex.
	def digest(routine Routine) string {
		let parts string[]
		parts.push(routine.schema, routine.name, routine.kind.name, routine.result.typeName)
		for let (_, p) in routine.parameters {
			parts.push(p.name + " " + p.typeName)
		}
		parts.push("|")
		for let (_, c) in routine.columns {
			parts.push(c.name + " " + c.typeName)
		}
		parts.push("|", routine.body)
		return new SHA256().hash(parts.join("\n").bytes()).hex()
	}

	// A failure of a script's statement, with the statement's place in the
	// script.
	def scriptError(err error, index int, count int) error {
		let message = "statement {index} of {count}: {err.message}"
		return DbError{message: message, code: err.code, cause: err, kind: err.kind, sqlState: err.sqlState, native: err.native} when err is DbError
		return errorOf(ErrorKind.Other, message)
	}

	// The statements of a script, each as text around its placeholders
	// (one more part than placeholders), in order. A statement ends at a
	// `;` outside quoted text, comments, dollar quoting and
	// `BEGIN ... END` / `CASE ... END`; statements holding nothing are
	// dropped. `backslashes` reads quoted text and comments as MySQL does.
	def splitScript(segments string[], backslashes bool) string[][] {
		// One byte stands in for each placeholder while the text is read.
		let text = segments.join("\u0001")
		let src = text.bytes()
		let n = src.len()
		let out string[][]
		let start = 0
		let depth = 0
		let words = 0
		// The word before, upper case, and whether it was BEGIN or END
		// waiting for the next word.
		let pending = ""
		let i = 0
		for i < n {
			let c = int(src[i])
			if c := 39 || 34 || 96 {
				i = quotedEnd(src, i, backslashes && c != 96)
				continue
			}
			if c == 45 && i + 1 < n && int(src[i + 1]) == 45 {
				i = lineEnd(src, i)
				continue
			}
			if backslashes && c == 35 {
				i = lineEnd(src, i)
				continue
			}
			if c == 47 && i + 1 < n && int(src[i + 1]) == 42 {
				i = blockEnd(src, i)
				continue
			}
			if c == 36 {
				let end = dollarEnd(src, i)
				i = end > i ?? (end, i + 1)
				continue
			}
			if c == 59 {
				depth = settle(pending, "", depth)
				pending = ""
				if depth == 0 {
					out.push(string(src[start:i]).split("\u0001")) when words > 0
					start = i + 1
					words = 0
				}
				i++
				continue
			}
			if !isNameByte(c, true) {
				i++
				continue
			}
			let end = i + 1
			for end < n && isNameByte(int(src[end]), false) {
				end++
			}
			let word = string(src[i:end]).upper()
			words++
			i = end
			if pending != "" {
				depth = settle(pending, word, depth)
				pending = ""
				// END IF, END LOOP...: the word closes the construct.
				continue when word := "IF" || "LOOP" || "WHILE" || "REPEAT" || "FOR" || "CASE"
			}
			if word := "BEGIN" || "END" {
				pending = word
			} else if word == "CASE" {
				depth++
			}
		}
		depth = settle(pending, "", depth)
		out.push(string(src[start:n]).split("\u0001")) when words > 0
		return out
	}

	// The block depth after BEGIN or END (`word`) followed by `next` ("" at
	// a `;` or the end): a BEGIN that starts a transaction and an END IF,
	// END LOOP... change nothing.
	def settle(word string, next string, depth int) int {
		if word == "BEGIN" {
			return depth when next := "" || "TRANSACTION" || "WORK" || "TRAN" || "DEFERRED" || "IMMEDIATE" || "EXCLUSIVE" || "ISOLATION" || "READ"
			return depth + 1
		}
		if word == "END" {
			return depth when next := "IF" || "LOOP" || "WHILE" || "REPEAT" || "FOR"
			return depth > 0 ?? (depth - 1, 0)
		}
		return depth
	}
}
