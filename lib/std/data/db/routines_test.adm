partial module std.data.db {
	use (
		std.testing
		std.time
		std.data.db.routines::*
	)

	struct Ranked {
		id int
		@column("full_name")
		name string
		score ?float
	}

	// A stored routine: its body is installed in the database, the call
	// runs it.
	sql def topRanked(n int, since time.Time) !Ranked[] {
		BEGIN
			RETURN QUERY SELECT id, full_name, score FROM ranked WHERE created >= since LIMIT n;
		END
	}

	sql def rankedCount() !?int {
		BEGIN
			RETURN (SELECT count(*) FROM ranked);
		END
	}

	@routine(name = "ranked_total", schema = "reports")
	sql def rankedTotal() !int {
		BEGIN
			RETURN (SELECT sum(score) FROM ranked);
		END
	}

	check "sql def scripts and routines" {
		@test()
		def TestScriptSplitsOutsideQuotesCommentsAndBlocks() !none {
			let script = splitScript([
				"CREATE TABLE a (t text DEFAULT 'x;y');\n-- note; here\nCREATE TRIGGER t AFTER INSERT ON a BEGIN\n\tUPDATE b SET n = CASE WHEN 1 THEN 2 END;\n\tINSERT INTO c VALUES (",
				");\nEND;\n/* x; /* y; */ z; */ INSERT INTO d VALUES (",
				", $$a;b$$);\n",
			], false)
			assert script.len() == 3
			assert script[0].len() == 1
			assert script[0][0].trim() == "CREATE TABLE a (t text DEFAULT 'x;y')"
			assert script[1].len() == 2
			assert script[1][0].trim().startsWith("-- note; here\nCREATE TRIGGER t AFTER INSERT ON a BEGIN")
			assert script[1][1] == ");\nEND"
			assert script[2].len() == 2
			assert script[2][1] == ", $$a;b$$)"
		}

		@test()
		def TestScriptSplitsAsMySQLQuotes() !none {
			let text = ["INSERT INTO a VALUES ('it\\'s; one'); # a; comment\nDELETE FROM a"]
			let mysql = splitScript(text, true)
			assert mysql.len() == 2
			assert mysql[1][0].trim().endsWith("comment\nDELETE FROM a")
			// Without backslash escapes the quote ends at `\'` and the `;`
			// after it ends the statement.
			assert splitScript(text, false)[0][0] == "INSERT INTO a VALUES ('it\\'s"
		}

		@test()
		def TestScriptKeepsProcedureBlocksWhole() !none {
			let script = splitScript(["CREATE PROCEDURE p() BEGIN IF 1 THEN SELECT 1; END IF; LOOP LEAVE; END LOOP; END; CALL p()"], true)
			assert script.len() == 2
			assert script[1][0].trim() == "CALL p()"
			// A BEGIN that starts a transaction opens no block.
			assert splitScript(["BEGIN; DELETE FROM a; COMMIT"], false).len() == 3
		}

		@test()
		def TestRoutineKinds() !none {
			assert routineKindOf<time.Time>() == RoutineKind.Function
			assert routineKindOf<Result>() == RoutineKind.Procedure
			assert routineKindOf<Ranked>() == RoutineKind.Rows
		}

		@test()
		def TestRoutinesDescribeTheirSignature() !none {
			let found = try routines()
			let top ?Routine = none
			let count ?Routine = none
			for let (_, r) in found {
				top = r when r.name == "topRanked"
				count = r when r.name == "rankedCount"
			}
			fail "topRanked is not described" when top is none
			fail "rankedCount is not described" when count is none

			assert top.kind == RoutineKind.Rows
			assert top.connection is none
			assert top.body.startsWith("BEGIN\n\tRETURN QUERY SELECT")
			assert top.body.endsWith("END")
			assert top.parameters.len() == 2
			assert top.parameters[0].name == "n"
			assert top.parameters[0].typeName == "int"
			assert top.parameters[1].typeName.endsWith("time.Time")
			assert top.columns.len() == 3
			assert top.columns[1].name == "full_name"
			assert top.columns[2].typeName == "?float"
			assert top.hash.len() == 64

			assert count.kind == RoutineKind.Function
			assert count.result.typeName == "?int"
			assert count.parameters.len() == 0
			assert count.hash != top.hash
			assert count.schema == ""

			let total ?Routine = none
			for let (_, r) in found {
				total = r when r.name == "ranked_total"
			}
			fail "rankedTotal is not described under its own name" when total is none
			assert total.schema == "reports"
			assert total.body.startsWith("BEGIN")
		}

		@test()
		def TestScriptRunsEachStatement() !none {
			let conn = new FakeConnection()
			try sqlScript(conn, ["DELETE FROM a WHERE id = ", "; DELETE FROM b WHERE id = ", ";"], ["first", "second"], [1, 2])
			assert conn.last == "DELETE FROM b WHERE id = :second"
			assert "{conn.named["second"]}" == "2"
			// A connection that is not a pool and no Dialect has none.
			assert dialectOf(conn) is none
		}

		@test()
		def TestRoutineCallNeedsADialect() !none {
			let conn = new FakeConnection()
			let message = ""
			topRanked(3, time.now()) onerror (err error) {
				message = err.message
				recover []
			}
			assert message.contains("no database connection")
			sqlRoutineCall(conn, "topRanked", 2, RoutineKind.Rows) onerror (err error) {
				message = err.message
				recover []
			}
			assert message.contains("implements no db.Dialect")
		}
	}
}
