partial module std.data.db {
	use (
		std.reflection
		std.reflection::(FieldKind)
		std.data.db.mapping::*
		std.data.db.sqlcall::*
	)

	// connection marks the property a type's `sql def` methods run on:
	//
	//     type Users {
	//         @connection()
	//         conn db.Queryable
	//
	//         sql def find(email string) !?User {
	//             SELECT * FROM users WHERE email = {email}
	//         }
	//     }
	//
	// The property holds a Connection, or a Transaction to run the methods
	// inside it. One property per type may carry it.
	meta def connection(ctx reflection.FieldMetaContext) {}

	// connection marks a property declared with accessors, as the field form
	// above.
	meta def connection(ctx reflection.PropertyMetaContext) {}

	// sqlschema checks the `sql def` statements of a type against a
	// database schema when the program is built:
	//
	//     @db.sqlschema("schema.sql")
	//     type Users {
	//         @db.connection()
	//         conn db.Queryable
	//
	//         sql def find(email string) !?User {
	//             SELECT * FROM users WHERE email = {email}
	//         }
	//     }
	//
	// The file, relative to the source file, holds the schema's DDL
	// (`CREATE TABLE`, `ALTER TABLE`, `CREATE VIEW`, `DROP TABLE`; other
	// statements are skipped), as a `pg_dump --schema-only` or `mysqldump
	// --no-data` writes it. The build fails on a table or column the
	// schema does not have, a placeholder whose value does not fit the
	// column it is compared with or stored in, and a result whose columns
	// do not read as the declared type; a field of a row type whose column
	// the query does not return is a warning. A statement the checker does
	// not read is left alone, and so is a stored routine's body.
	meta def sqlschema(ctx reflection.TypeMetaContext, file string) {}

	// sqlschema checks one `sql def` function against a database schema,
	// as the type form above.
	meta def sqlschema(ctx reflection.FunctionMetaContext, file string) {}

	// sqlschema checks one `sql def` method against a database schema, as
	// the type form above.
	meta def sqlschema(ctx reflection.MethodMetaContext, file string) {}

	// The functions below are what a `sql def` compiles to. `segments` is the
	// statement's text around its placeholders (one more than `names`),
	// `names` the placeholders as written and `values` their arguments, in
	// order. The text is rewritten to the driver's placeholder style and the
	// values are bound, never pasted into it.

	// sqlBound returns what a `sql def` on q runs on. Outside a `transaction`
	// block that is q. Inside one, with q a Connection, it is the block's
	// transaction on q: begun by the first call in the block, reused by the
	// later ones (nested blocks included), committed when the block's body is
	// done and rolled back when it fails. A Transaction the program began
	// itself is returned as it is.
	// Fails with a DbError when the transaction cannot begin, as
	// `Connection.beginTx` does, and inside a block when q is neither a
	// Connection nor a Transaction.
	def sqlBound(q Queryable) !Queryable {
		let joined = __tx_participant(q)
		if joined is Transaction {
			return joined
		}
		try joinBlock(q)
		let begun = __tx_participant(q)
		if begun is Transaction {
			return begun
		}
		return q
	}

	// sqlExec runs a statement that returns no rows.
	// Fails with a DbError as `Queryable.exec` does.
	def sqlExec(q Queryable, segments string[], names string[], values any[]) !Result {
		let marks = q.placeholder()
		return q.exec(statementText(segments, names, marks), namedValues(marks, names, values), ...values)
	}

	// sqlOne runs a query and reads its first row as a T: a struct or type
	// filled as `read` does, or a time, date, decimal or big integer taken
	// from the first column. With T a `Result` it runs the statement with
	// `exec` and returns what it changed.
	// Fails with a DbError: ErrorKind.NoRows when the query returns no row,
	// ErrorKind.Type when the row does not convert, else as `Queryable.query`
	// does.
	def sqlOne<T>(q Queryable, segments string[], names string[], values any[]) !T {
		let zero T
		if reflection.typeName(zero) == "std.data.db.Result" {
			let outcome any = try sqlExec(q, segments, names, values)
			match outcome {
				case T:
					return outcome
				default:
					fail errorOf(ErrorKind.Type, "the statement's outcome is not a {reflection.typeName(zero)}")
			}
		}
		let rows = try sqlQuery(q, segments, names, values)
		defer rows.close()
		fail errorOf(ErrorKind.NoRows, "the query returned no rows") unless try rows.next()
		return try rowAs<T>(rows)
	}

	// sqlOptional runs a query and reads its first row as a T, none when it
	// returns no row.
	// Fails with a DbError of ErrorKind.Type when the row does not convert,
	// else as `Queryable.query` does.
	def sqlOptional<T>(q Queryable, segments string[], names string[], values any[]) !?T {
		let rows = try sqlQuery(q, segments, names, values)
		defer rows.close()
		return none unless try rows.next()
		let zero T
		return none when isNamedScalar(reflection.typeName(zero)) && rows.isNull(0)
		return try rowAs<T>(rows)
	}

	// sqlAll runs a query and reads every row as a T.
	// Fails with a DbError of ErrorKind.Type when a row does not convert,
	// else as `Queryable.query` does.
	def sqlAll<T>(q Queryable, segments string[], names string[], values any[]) !T[] {
		let rows = try sqlQuery(q, segments, names, values)
		let zero T
		return readAll<T>(rows) unless isNamedScalar(reflection.typeName(zero))

		defer rows.close()
		let out T[]
		for try rows.next() {
			out.push(try rowAs<T>(rows))
		}
		return out
	}

	// sqlRow runs a query and returns the values of its first row, each as
	// `Rows.value` gives it.
	// Fails with a DbError: ErrorKind.NoRows when the query returns no row,
	// else as `Queryable.query` does.
	def sqlRow(q Queryable, segments string[], names string[], values any[]) !any[] {
		let rows = try sqlQuery(q, segments, names, values)
		defer rows.close()
		fail errorOf(ErrorKind.NoRows, "the query returned no rows") unless try rows.next()
		return rowValues(rows)
	}

	// sqlOptionalRow runs a query and returns the values of its first row,
	// none when it returns no row.
	// Fails with a DbError as `Queryable.query` does.
	def sqlOptionalRow(q Queryable, segments string[], names string[], values any[]) !?any[] {
		let rows = try sqlQuery(q, segments, names, values)
		defer rows.close()
		return none unless try rows.next()
		return try rowValues(rows)
	}

	// sqlRows runs a query and returns the values of every row.
	// Fails with a DbError as `Queryable.query` does.
	def sqlRows(q Queryable, segments string[], names string[], values any[]) !any[][] {
		let rows = try sqlQuery(q, segments, names, values)
		defer rows.close()
		let out any[][]
		for try rows.next() {
			out.push(try rowValues(rows))
		}
		return out
	}

	// sqlCell converts one value of a row to T: `int`, `float`, `bool`,
	// `string`, `byte[]`, or a time, date, decimal or big integer. An
	// integer converts to `float` and to `bool` (zero is false).
	// Fails with a DbError of ErrorKind.Type when the row has no such
	// column, the value is NULL, or it does not convert.
	def sqlCell<T>(row any[], index int) !T {
		fail errorOf(ErrorKind.Type, "the result has no column {index}") when index < 0 || index >= row.len()
		let v = row[index]
		fail errorOf(ErrorKind.Type, "column {index} is NULL") when v is none

		let zero T
		let wanted = reflection.typeName(zero)
		let converted = cellValue(reflection.kindOf(zero), wanted, v) onerror fail errorOf(ErrorKind.Type, "column {index} does not convert to {wanted}")
		match converted {
			case T:
				return converted
			default:
				fail errorOf(ErrorKind.Type, "column {index} ({reflection.typeName(v)}) does not convert to {wanted}")
		}
	}

	// sqlOptionalCell converts one value of a row to T as `sqlCell` does,
	// none when it is NULL.
	// Fails with a DbError of ErrorKind.Type when the row has no such column
	// or the value does not convert.
	def sqlOptionalCell<T>(row any[], index int) !?T {
		fail errorOf(ErrorKind.Type, "the result has no column {index}") when index < 0 || index >= row.len()
		return none when row[index] is none
		return try sqlCell<T>(row, index)
	}

	// Reads the current row as a T: a named scalar from the first column,
	// else an object by column names.
	internal def rowAs<T>(rows Rows) !T {
		let zero T
		return read<T>(rows) unless isNamedScalar(reflection.typeName(zero))

		let row any[]
		row.push(try rows.value(0))
		return sqlCell<T>(row, 0)
	}

	// isolate sets how the running `transaction` block opens the database
	// transactions it begins from here on: their isolation level, and
	// whether they only read. Transactions the block already began keep
	// theirs. Inside a nested block it sets the outermost one, which begins
	// the transactions of both.
	//
	// ```
	// transaction {
	//     try db.isolate(db.Isolation.Serializable)
	//     try accounts.move(from, to, amount)
	// }
	// ```
	//
	// Fails with a DbError of ErrorKind.Other outside a `transaction` block.
	def isolate(level Isolation = Isolation.Default, readOnly bool = false) !none {
		fail errorOf(ErrorKind.Other, "db.isolate sets how a transaction block opens its transactions; it was called outside one") unless __tx_running()
		__tx_keep(blockModeKey, BlockMode{level: level, readOnly: readOnly})
		return none
	}
}

internal partial module std.data.db.sqlcall {
	use (
		std.reflection
		std.reflection::(FieldKind)
		std.data.db::*
		std.data.db.mapping::*
	)

	// The statement in the driver's placeholder style: the segments joined
	// by `?`, `$1`... or `:name`..., without surrounding space or a closing
	// semicolon.
	def statementText(segments string[], names string[], marks Placeholder) string {
		let parts string[]
		for let (i, segment) in segments {
			parts.push(segment)
			continue when i == segments.len() - 1
			match marks {
				case Placeholder.Question:
					parts.push("?")
				case Placeholder.Dollar:
					parts.push("${i + 1}")
				case Placeholder.Named:
					parts.push(":" + bindName(names, i))
			}
		}
		let text = parts.join("").trim()
		for text.endsWith(";") {
			text = text.slice(0, text.len() - 1).trim()
		}
		return text
	}

	// The name placeholder `i` is bound under: the one written in the
	// `sql def` when it is a plain word (`email`), else `p` and its number
	// (`user.id` becomes `p2`).
	def bindName(names string[], i int) string {
		return "p{i + 1}" when i >= names.len()
		return names[i] when /^[A-Za-z_][A-Za-z0-9_]*$/.test(names[i])
		return "p{i + 1}"
	}

	// The arguments by placeholder name for a driver that binds by name,
	// empty for the others.
	def namedValues(marks Placeholder, names string[], values any[]) map<string, any> {
		let named = new map<string, any>()
		return named when marks != Placeholder.Named
		for let (i, v) in values {
			named.set(bindName(names, i), v)
		}
		return named
	}

	// How the running block opens its transactions (isolate).
	struct BlockMode {
		level    Isolation
		readOnly bool
	}

	// The key the block keeps its BlockMode under: an object of its own, so
	// no connection can be the same key.
	type BlockModeKey {
		def new() {}
	}

	let blockModeKey = new BlockModeKey()

	// Inside a `transaction` block, begins a transaction on q when q is a
	// Connection and joins it to the block under q. A `begin` part runs when
	// its function is entered, and only inside a block, which is why this
	// is a function of its own.
	// Fails with a DbError of ErrorKind.Other when q is neither a Connection
	// nor a Transaction: nothing could begin a transaction on it, and the
	// query would run outside the block's.
	def joinBlock(q Queryable) !none {
		begin {
			// Through `any`: one interface is not matched against another.
			let held any = q
			if held is Connection {
				let mode = __tx_participant(blockModeKey)
				if mode is BlockMode {
					__tx_participate(q, try held.beginTx(mode.level, mode.readOnly))
				} else {
					__tx_participate(q, try held.beginTx())
				}
			} else if !(held is Transaction) {
				fail errorOf(ErrorKind.Other, "a sql def inside a transaction block runs on a Connection or a Transaction; {reflection.typeName(held)} is neither, so it cannot join the block's transaction")
			}
		}
		return none
	}

	// Runs a `sql def` query.
	def sqlQuery(q Queryable, segments string[], names string[], values any[]) !Rows {
		let marks = q.placeholder()
		return q.query(statementText(segments, names, marks), namedValues(marks, names, values), ...values)
	}

	// The current row's values, boxed.
	def rowValues(rows Rows) !any[] {
		let out any[]
		let n = rows.columns().len()
		for let i = 0; i < n; i++ {
			out.push(try rows.value(i))
		}
		return out
	}

	// A value converted towards the kind and type asked for; unchanged when
	// no conversion applies. Fails when text does not parse as the type.
	def cellValue(kind FieldKind, typeName string, v any) !any {
		match kind {
			case FieldKind.Float:
				match v {
					case int:
						return float(v)
					default:
						return v
				}
			case FieldKind.Bool:
				match v {
					case int:
						return v != 0
					default:
						return v
				}
			case FieldKind.Int, FieldKind.String, FieldKind.Array:
				return v
			default:
				let converted = try namedValue(typeName, v)
				return v when converted is none
				return converted
		}
	}
}
