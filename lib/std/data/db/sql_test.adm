partial module std.data.db {
	use std.testing

	// AccountStore is what a program writes: a type holding its connection
	// and `sql def` methods that run on it.
	type AccountStore {
		@connection()
		conn Queryable

		def new(conn Queryable) {
			self.conn = conn
		}

		sql def rename(id int, nickname string) !none {
			UPDATE accounts SET nickname = {nickname} WHERE id = {id};
		}

		sql def remove(id int) !Result {
			DELETE FROM accounts WHERE id = {id}
		}

		sql def find(id int) !Account {
			SELECT * FROM accounts WHERE id = {id}
		}

		sql def lookup(email string) !?Account {
			SELECT * FROM accounts WHERE email_address = {email}
		}

		sql def everyone() !Account[] {
			SELECT * FROM accounts
		}

		sql def count() !int {
			SELECT count(*) FROM accounts
		}

		sql def nickname(id int) !?string {
			SELECT nickname FROM accounts WHERE id = {id}
		}

		sql def level(id int) !int32 {
			SELECT level FROM accounts WHERE id = {id}
		}

		sql def maybeLevel(id int) !?uint8 {
			SELECT level FROM accounts WHERE id = {id}
		}

		sql def idAndEmail(id int) !(int, string) {
			SELECT id, email_address FROM accounts WHERE id = {id}
		}

		sql def maybeIdAndNickname(id int) !?(int, ?string) {
			SELECT id, nickname FROM accounts WHERE id = {id}
		}

		sql def ids() !int[] {
			SELECT id FROM accounts
		}

		sql def pairs() !(int, string)[] {
			SELECT id, email_address FROM accounts
		}
	}

	check "sql def" {
		@test()
		def TestStatementBindsItsArguments() !none {
			let conn = new FakeConnection()
			conn.marks = Placeholder.Question
			let store = new AccountStore(conn)
			try store.rename(7, "seven")
			assert conn.last == "UPDATE accounts SET nickname = ? WHERE id = ?"
			assert conn.args.len() == 2
			assert "{conn.args[0]}" == "seven"
			assert "{conn.args[1]}" == "7"

			try store.remove(7)
			assert conn.last == "DELETE FROM accounts WHERE id = ?"

			// The fake reports the number of named values it was handed.
			let named = new FakeConnection()
			let outcome = try new AccountStore(named).remove(7)
			assert outcome.affected == 1
		}

		@test()
		def TestRowObjects() !none {
			let conn = new FakeConnection()
			conn.columns = accountColumns()
			conn.data.push(accountRow(7, "seven"))
			conn.data.push(accountRow(8, none))
			let store = new AccountStore(conn)

			let one = try store.find(7)
			assert one.id == 7
			assert one.email == "user7@example.com"

			let found = try store.lookup("user7@example.com")
			if found is Account {
				assert found.id == 7
			} else {
				fail "no account"
			}

			let all = try store.everyone()
			assert all.len() == 2
			assert all[1].id == 8

			conn.data = []
			assert (try store.lookup("nobody@example.com")) is none
			assert (try store.everyone()).len() == 0
			let failed = false
			store.find(1) onerror (err error) {
				failed = true
				recover Account{}
			}
			assert failed
		}

		@test()
		def TestPrimitives() !none {
			let store = new AccountStore(oneColumn("n", 42))
			assert (try store.count()) == 42
			let level = try store.level(1)
			assert level == 42
			let maybe = try store.maybeLevel(1)
			if maybe is uint8 {
				assert maybe == 42
			} else {
				fail "no level"
			}
			let ids = try store.ids()
			assert ids.len() == 1
			assert ids[0] == 42

			let named = new AccountStore(oneColumn("nickname", "seven"))
			let nickname = try named.nickname(7)
			if nickname is string {
				assert nickname == "seven"
			} else {
				fail "no nickname"
			}

			let null = new AccountStore(oneColumn("nickname", none))
			assert (try null.nickname(7)) is none
			assert (try null.maybeLevel(7)) is none

			let blank = new FakeConnection()
			let nobody = new AccountStore(blank)
			assert (try nobody.nickname(7)) is none
			assert (try nobody.ids()).len() == 0
		}

		@test()
		def TestTuples() !none {
			let conn = new FakeConnection()
			conn.columns.push(Column{name: "id", typeName: "", nullable: true})
			conn.columns.push(Column{name: "text", typeName: "", nullable: true})
			let first any[]
			first.push(7)
			first.push("seven@example.com")
			conn.data.push(first)
			let second any[]
			second.push(8)
			second.push(none)
			conn.data.push(second)
			let store = new AccountStore(conn)

			let (id, email) = try store.idAndEmail(7)
			assert id == 7
			assert email == "seven@example.com"

			let maybe = try store.maybeIdAndNickname(7)
			assert !(maybe is none)

			conn.data = []
			conn.data.push(first)
			let pairs = try store.pairs()
			assert pairs.len() == 1
			let (pairId, pairEmail) = pairs[0]
			assert pairId == 7
			assert pairEmail == "seven@example.com"

			conn.data = []
			assert (try store.maybeIdAndNickname(7)) is none
		}
	}
}
