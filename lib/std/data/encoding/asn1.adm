partial module std.data.encoding {
	use (
		std.time
		std.time::(Time)
	)

	// ASN1Class is the class of a DER tag: the two top bits of the
	// identifier byte.
	enum ASN1Class {
		Universal = 0,
		Application = 1,
		ContextSpecific = 2,
		Private = 3
	}

	// ASN1Tag names the universal tag numbers the readers understand.
	enum ASN1Tag {
		Boolean = 1,
		Integer = 2,
		BitString = 3,
		OctetString = 4,
		Null = 5,
		ObjectIdentifier = 6,
		Enumerated = 10,
		UTF8String = 12,
		Sequence = 16,
		Set = 17,
		NumericString = 18,
		PrintableString = 19,
		T61String = 20,
		IA5String = 22,
		UTCTime = 23,
		GeneralizedTime = 24,
		BMPString = 30
	}

	// OID is an ASN.1 OBJECT IDENTIFIER: the arcs of the tree path, such as
	// 1.2.840.113549.1.1.11 for sha256WithRSAEncryption.
	type OID {
		arcs int[]

		def new(arcs int[]) {
			self.arcs = arcs
		}

		// str renders the arcs joined with dots.
		def str() string {
			let out = ""
			for let i = 0; i < arcs.len(); i++ {
				out += "." when i > 0
				out += arcs[i].str()
			}
			return out
		}

		// equals reports whether both identifiers name the same arcs.
		def equals(other OID) bool {
			return false when arcs.len() != other.arcs.len()
			for let i = 0; i < arcs.len(); i++ {
				return false when arcs[i] != other.arcs[i]
			}
			return true
		}

		// equals reports whether the identifier is the dotted text.
		def equals(text string) bool {
			return str() == text
		}
	}

	// parseOID reads dotted text such as "1.2.840.10045.2.1". Fails when the
	// text has fewer than two arcs, an arc that is not a number, or a first
	// arc above 2.
	def parseOID(text string) !OID {
		let parts = text.split(".")
		fail "asn1: object identifier needs at least two arcs" when parts.len() < 2
		let arcs int[]
		for let (_, p) in parts {
			fail "asn1: invalid object identifier arc \"{p}\"" when p == "" || !p.isNumeric()
			arcs.push(p.toInt<int>())
		}
		fail "asn1: first arc of an object identifier is 0, 1 or 2" when arcs[0] > 2
		fail "asn1: second arc of an object identifier is below 40 under arcs 0 and 1" when arcs[0] < 2 && arcs[1] > 39
		return new OID(arcs)
	}

	// BitString is an ASN.1 BIT STRING: the bits packed from the top of each
	// byte, with the count of bits that are meaningful.
	type BitString {
		bytes     byte[]
		bitLength int

		def new(bytes byte[], bitLength int) {
			self.bytes = bytes
			self.bitLength = bitLength
		}

		// at returns bit i, counting from the first bit of the first byte;
		// 0 outside the string.
		def at(i int) int {
			return 0 when i < 0 || i >= bitLength
			return (int(bytes[i / 8]) >> (7 - i % 8)) & 1
		}

		// rightAlign returns the bits shifted so the last bit lands on the
		// lowest bit of the last byte, the form a flags field is read in.
		def rightAlign() byte[] {
			let shift = 8 - bitLength % 8
			return bytes when shift == 8 || bytes.len() == 0
			let out byte[]
			out.len(bytes.len())
			out[0] = bytes[0] >> shift
			for let i = 1; i < bytes.len(); i++ {
				out[i] = byte(int(bytes[i - 1]) << (8 - shift)) | bytes[i] >> shift
			}
			return out
		}
	}

	// ASN1Element is one DER value: its tag, its content bytes, and, when
	// constructed, the elements inside it. `raw` is the whole encoding,
	// header and content, so a signed structure can be verified over the
	// bytes it arrived in.
	//
	// Example:
	// ```example
	// let seq = try asn1Parse(der)
	// let version = try (try seq.at(0)).asInt()
	// let ext = seq.tagged(3) // the optional [3] EXPLICIT extensions
	// ```
	type ASN1Element {
		class       ASN1Class
		tag         int
		constructed bool
		content     byte[]
		raw         byte[]
		children    ASN1Element[]

		// new builds an element from its parts and encodes it; constructed
		// elements get their children from asn1Sequence and friends.
		def new(class ASN1Class, tag int, constructed bool, content byte[]) {
			self.class = class
			self.tag = tag
			self.constructed = constructed
			self.content = content
			self.raw = asn1Header(class, tag, constructed, content.len()) + content
		}

		// isTag reports whether the element is the universal tag.
		def isTag(tag ASN1Tag) bool {
			return class == ASN1Class.Universal && self.tag == int(tag)
		}

		// isContext reports whether the element is context-specific [number].
		def isContext(number int) bool {
			return class == ASN1Class.ContextSpecific && tag == number
		}

		// encode returns the DER encoding, header and content.
		def encode() byte[] {
			return raw
		}

		// describe names the element for error messages: "SEQUENCE", "[0]",
		// "INTEGER", "APPLICATION 3".
		def describe() string {
			match class {
				case ASN1Class.Universal:
					return asn1TagName(tag)
				case ASN1Class.ContextSpecific:
					return "[{tag}]"
				case ASN1Class.Application:
					return "APPLICATION {tag}"
				default:
					return "PRIVATE {tag}"
			}
		}

		// at returns the child at the index. Fails when the element is not
		// constructed or has fewer children.
		def at(index int) !ASN1Element {
			fail "asn1: {describe()} is not constructed" unless constructed
			fail "asn1: {describe()} has {children.len()} elements, index {index} asked" when index < 0 || index >= children.len()
			return children[index]
		}

		// tagged returns the first child with the context-specific tag
		// [number], the way an OPTIONAL tagged field is found; none when
		// there is no such child.
		def tagged(number int) ?ASN1Element {
			for let (_, child) in children {
				return child when child.isContext(number)
			}
			return none
		}

		// inner returns the single element an EXPLICIT tag wraps. Fails
		// unless the element is constructed around exactly one element.
		def inner() !ASN1Element {
			fail "asn1: {describe()} wraps {children.len()} elements, one expected" when !constructed || children.len() != 1
			return children[0]
		}

		// parse reads the content as DER, the way an OCTET STRING that
		// carries an encoded structure (an X.509 extension) is opened. Fails
		// like asn1Parse.
		def parse() !ASN1Element {
			return try asn1Parse(content)
		}

		// asBool reads a BOOLEAN. Fails on another tag or a value other
		// than 0x00 and 0xFF, the two DER allows.
		def asBool() !bool {
			try expectTag(ASN1Tag.Boolean)
			fail "asn1: BOOLEAN has {content.len()} bytes" when content.len() != 1
			return false when content[0] == 0
			return true when content[0] == 0xff
			fail "asn1: BOOLEAN value {int(content[0])} is not DER"
		}

		// asInt reads an INTEGER or ENUMERATED that fits 64 bits. Fails on
		// another tag, a non-minimal encoding or a wider value.
		def asInt() !int {
			fail "asn1: {describe()} is not an INTEGER" unless isTag(ASN1Tag.Integer) || isTag(ASN1Tag.Enumerated)
			try checkInteger()
			fail "asn1: INTEGER of {content.len()} bytes does not fit an int" when content.len() > 8
			let value int64 = 0
			value = -1 when content[0] >= 0x80
			for let (_, b) in content {
				value = (value << 8) | int64(b)
			}
			return int(value)
		}

		// asBigInt reads an INTEGER of any size, negative values in two's
		// complement. Fails on another tag or a non-minimal encoding.
		def asBigInt() !bigint {
			try expectTag(ASN1Tag.Integer)
			try checkInteger()
			let value = parseBigInt(content)
			value = value - (bigint(1) << (8 * content.len())) when content[0] >= 0x80
			return value
		}

		// asBytes reads an OCTET STRING. Fails on another tag.
		def asBytes() !byte[] {
			try expectTag(ASN1Tag.OctetString)
			return content
		}

		// asBitString reads a BIT STRING. Fails when the padding count is out
		// of range or the padding bits are set, which DER forbids.
		def asBitString() !BitString {
			try expectTag(ASN1Tag.BitString)
			fail "asn1: BIT STRING is empty" when content.len() == 0
			let pad = int(content[0])
			fail "asn1: BIT STRING pads {pad} bits" when pad > 7 || (content.len() == 1 && pad != 0)
			let bits = content[1:]
			fail "asn1: BIT STRING padding bits are set" when pad > 0 && (int(bits[bits.len() - 1]) & ((1 << pad) - 1)) != 0
			return new BitString(bits, bits.len() * 8 - pad)
		}

		// asOID reads an OBJECT IDENTIFIER. Fails on another tag or a
		// malformed arc.
		def asOID() !OID {
			try expectTag(ASN1Tag.ObjectIdentifier)
			fail "asn1: OBJECT IDENTIFIER is empty" when content.len() == 0
			let arcs int[]
			let offset = 0
			let first = true
			for offset < content.len() {
				let (value, next) = try asn1ReadBase128(content, offset)
				offset = next
				if first {
					first = false
					if value < 40 {
						arcs.push(0)
						arcs.push(value)
					} else if value < 80 {
						arcs.push(1)
						arcs.push(value - 40)
					} else {
						arcs.push(2)
						arcs.push(value - 80)
					}
				} else {
					arcs.push(value)
				}
			}
			return new OID(arcs)
		}

		// asString reads a character string: UTF8String, PrintableString,
		// IA5String, NumericString, T61String (read as Latin-1) or BMPString
		// (UTF-16BE). Fails on another tag or a byte outside the tag's
		// character set.
		def asString() !string {
			fail "asn1: {describe()} is not a string" when class != ASN1Class.Universal
			switch {
				case tag == int(ASN1Tag.UTF8String):
					let text = string(content)
					fail "asn1: UTF8String is not valid UTF-8" unless text.isUTF8()
					return text
				case tag == int(ASN1Tag.PrintableString):
					for let (_, b) in content {
						fail "asn1: PrintableString holds byte {int(b)}" unless asn1IsPrintable(b)
					}
					return string(content)
				case tag == int(ASN1Tag.IA5String):
					for let (_, b) in content {
						fail "asn1: IA5String holds byte {int(b)}" when b >= 0x80
					}
					return string(content)
				case tag == int(ASN1Tag.NumericString):
					for let (_, b) in content {
						fail "asn1: NumericString holds byte {int(b)}" unless b == 0x20 || (b >= 0x30 && b <= 0x39)
					}
					return string(content)
				case tag == int(ASN1Tag.T61String):
					return asn1Latin1(content)
				case tag == int(ASN1Tag.BMPString):
					return try asn1BMP(content)
				default:
					fail "asn1: {describe()} is not a string"
			}
		}

		// asTime reads a UTCTime (two-digit year, 1950 to 2049) or a
		// GeneralizedTime, with a Z or a numeric zone offset. Fails on another
		// tag or malformed text.
		def asTime() !Time {
			fail "asn1: {describe()} is not a time" when class != ASN1Class.Universal
			let text = string(content)
			if tag == int(ASN1Tag.UTCTime) {
				fail "asn1: UTCTime \"{text}\" is malformed" when text.len() < 11
				let yy = try asn1Digits(text, 0, 2)
				let year = (yy < 50) ?? (2000 + yy, 1900 + yy)
				return try asn1Time(year.str().padStart(4, "0") + text[2:])
			}
			fail "asn1: {describe()} is not a time" when tag != int(ASN1Tag.GeneralizedTime)
			fail "asn1: GeneralizedTime \"{text}\" is malformed" when text.len() < 15
			return try asn1Time(text)
		}

		internal def expectTag(tag ASN1Tag) !none {
			expects {
				assert isTag(tag) onerror fail "asn1: {describe()} is not {asn1TagName(int(tag))}"
			}
		}

		internal def checkInteger() !none {
			fail "asn1: INTEGER is empty" when content.len() == 0
			fail "asn1: INTEGER is not minimal" when content.len() > 1 && ((content[0] == 0 && content[1] < 0x80) || (content[0] == 0xff && content[1] >= 0x80))
		}
	}

	// asn1Parse reads exactly one DER element from the bytes. Fails on a
	// malformed encoding, an indefinite length, a non-minimal length, or
	// trailing bytes.
	def asn1Parse(input byte[]) !ASN1Element {
		let (element, next) = try asn1ReadElement(input, 0)
		fail "asn1: {input.len() - next} trailing bytes after {element.describe()}" when next != input.len()
		return element
	}

	// asn1ParseAll reads every DER element the bytes hold, one after
	// another; an empty input gives an empty array. Fails on a malformed
	// element like asn1Parse.
	def asn1ParseAll(input byte[]) !ASN1Element[] {
		let out ASN1Element[]
		let offset = 0
		for offset < input.len() {
			let (element, next) = try asn1ReadElement(input, offset)
			out.push(element)
			offset = next
		}
		return out
	}

	// asn1Sequence builds a SEQUENCE of the elements, in order.
	def asn1Sequence(items ASN1Element[]) ASN1Element {
		return asn1Constructed(ASN1Class.Universal, int(ASN1Tag.Sequence), items)
	}

	// asn1Set builds a SET OF the elements, sorted by their encodings as
	// DER requires.
	def asn1Set(items ASN1Element[]) ASN1Element {
		let sorted = items.clone()
		sorted.sort((a, b ASN1Element) => asn1CompareBytes(a.raw, b.raw) < 0)
		return asn1Constructed(ASN1Class.Universal, int(ASN1Tag.Set), sorted)
	}

	// asn1Explicit wraps the element in a context-specific [number] EXPLICIT
	// tag.
	def asn1Explicit(number int, inner ASN1Element) ASN1Element {
		return asn1Constructed(ASN1Class.ContextSpecific, number, [inner])
	}

	// asn1Implicit retags the element as context-specific [number] IMPLICIT,
	// keeping its content and its children.
	def asn1Implicit(number int, inner ASN1Element) ASN1Element {
		let out = new ASN1Element(ASN1Class.ContextSpecific, number, inner.constructed, inner.content)
		out.children = inner.children
		return out
	}

	// asn1Constructed builds a constructed element of the class and tag
	// around the children.
	def asn1Constructed(class ASN1Class, tag int, children ASN1Element[]) ASN1Element {
		let content byte[]
		for let (_, child) in children {
			content = content + child.raw
		}
		let out = new ASN1Element(class, tag, true, content)
		out.children = children
		return out
	}

	// asn1Boolean builds a BOOLEAN.
	def asn1Boolean(value bool) ASN1Element {
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.Boolean), false, byte[value ?? (0xff, 0)])
	}

	// asn1Integer builds an INTEGER.
	def asn1Integer(value int) ASN1Element {
		return asn1Integer(bigint(value))
	}

	// asn1Integer builds an INTEGER of any size, negative values in two's
	// complement.
	def asn1Integer(value bigint) ASN1Element {
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.Integer), false, asn1IntegerBytes(value))
	}

	// asn1Enumerated builds an ENUMERATED.
	def asn1Enumerated(value int) ASN1Element {
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.Enumerated), false, asn1IntegerBytes(bigint(value)))
	}

	// asn1Null builds a NULL.
	def asn1Null() ASN1Element {
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.Null), false, [])
	}

	// asn1OctetString builds an OCTET STRING.
	def asn1OctetString(bytes byte[]) ASN1Element {
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.OctetString), false, bytes)
	}

	// asn1BitString builds a BIT STRING of whole bytes, no padding.
	def asn1BitString(bytes byte[]) ASN1Element {
		return asn1BitString(new BitString(bytes, bytes.len() * 8))
	}

	// asn1BitString builds a BIT STRING, clearing the padding bits.
	def asn1BitString(bits BitString) ASN1Element {
		let pad = (8 - bits.bitLength % 8) % 8
		let content = byte[byte(pad)] + bits.bytes[0:(bits.bitLength + 7) / 8]
		content[content.len() - 1] &= byte(0xff << pad) when pad > 0
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.BitString), false, content)
	}

	// asn1OID builds an OBJECT IDENTIFIER.
	def asn1OID(oid OID) ASN1Element {
		let content byte[]
		content = asn1WriteBase128(content, oid.arcs[0] * 40 + oid.arcs[1])
		for let i = 2; i < oid.arcs.len(); i++ {
			content = asn1WriteBase128(content, oid.arcs[i])
		}
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.ObjectIdentifier), false, content)
	}

	// asn1String builds a character string of the given tag: UTF8String,
	// PrintableString, IA5String, NumericString, T61String or BMPString.
	def asn1String(tag ASN1Tag, text string) ASN1Element {
		let content = text.bytes()
		content = asn1BMPBytes(text) when tag == ASN1Tag.BMPString
		return new ASN1Element(ASN1Class.Universal, int(tag), false, content)
	}

	// asn1UTF8String builds a UTF8String.
	def asn1UTF8String(text string) ASN1Element {
		return asn1String(ASN1Tag.UTF8String, text)
	}

	// asn1PrintableString builds a PrintableString.
	def asn1PrintableString(text string) ASN1Element {
		return asn1String(ASN1Tag.PrintableString, text)
	}

	// asn1IA5String builds an IA5String.
	def asn1IA5String(text string) ASN1Element {
		return asn1String(ASN1Tag.IA5String, text)
	}

	// asn1UTCTime builds a UTCTime, `YYMMDDHHMMSSZ`, for a year from 1950
	// to 2049.
	def asn1UTCTime(t Time) ASN1Element {
		let text = asn1TimeDigits(t, t.year() % 100, 2)
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.UTCTime), false, text.bytes())
	}

	// asn1GeneralizedTime builds a GeneralizedTime, `YYYYMMDDHHMMSSZ`.
	def asn1GeneralizedTime(t Time) ASN1Element {
		let text = asn1TimeDigits(t, t.year(), 4)
		return new ASN1Element(ASN1Class.Universal, int(ASN1Tag.GeneralizedTime), false, text.bytes())
	}

	// asn1Time builds the time as X.509 wants it: UTCTime through 2049,
	// GeneralizedTime after.
	def asn1Time(t Time) ASN1Element {
		let year = t.year()
		return asn1UTCTime(t) when year >= 1950 && year < 2050
		return asn1GeneralizedTime(t)
	}

	// asn1ReadElement reads the element at the offset and returns it with
	// the offset after it.
	internal def asn1ReadElement(input byte[], start int) !(ASN1Element, int) {
		expects {
			assert start < input.len() onerror fail "asn1: truncated element"
		}
		let offset = start
		let identifier = int(input[offset])
		offset++
		let class = ASN1Class(identifier >> 6)
		let constructed = (identifier & 0x20) != 0
		let tag = identifier & 0x1f
		if tag == 0x1f {
			let (value, next) = try asn1ReadBase128(input, offset)
			fail "asn1: high tag number {value} below 31 is not DER" when value < 31
			tag = value
			offset = next
		}
		fail "asn1: truncated length" when offset >= input.len()
		let length = int(input[offset])
		offset++
		if length >= 0x80 {
			let count = length & 0x7f
			fail "asn1: indefinite length is not DER" when count == 0
			fail "asn1: length of {count} bytes is too long" when count > 4
			fail "asn1: truncated length" when offset + count > input.len()
			length = 0
			for let i = 0; i < count; i++ {
				length = (length << 8) | int(input[offset + i])
			}
			offset += count
			fail "asn1: length is not minimal" when length < 0x80 || (count > 1 && input[offset - count] == 0)
		}
		fail "asn1: {asn1TagName(tag)} of {length} bytes runs past the input" when offset + length > input.len()
		let element = new ASN1Element(class, tag, constructed, input[offset:offset + length])
		element.raw = input[start:offset + length]
		element.children = try asn1ParseAll(element.content) when constructed
		return (element, offset + length)
	}

	internal def asn1ReadBase128(input byte[], start int) !(int, int) {
		let value = 0
		let offset = start
		for offset < input.len() {
			let b = int(input[offset])
			fail "asn1: base-128 number has a leading 0x80" when offset == start && b == 0x80
			fail "asn1: base-128 number is too large" when value > (1 << 55)
			value = (value << 7) | (b & 0x7f)
			offset++
			return (value, offset) when b < 0x80
		}
		fail "asn1: truncated base-128 number"
	}

	internal def asn1WriteBase128(out byte[], value int) byte[] {
		let count = 1
		for let v = value >> 7; v > 0; v = v >> 7 {
			count++
		}
		for let i = count - 1; i >= 0; i-- {
			let b = byte((value >> (7 * i)) & 0x7f)
			b |= 0x80 when i > 0
			out.push(b)
		}
		return out
	}

	// asn1Header encodes the identifier and the length of an element.
	internal def asn1Header(class ASN1Class, tag int, constructed bool, length int) byte[] {
		let out byte[]
		let leading = byte(int(class) << 6)
		leading |= 0x20 when constructed
		if tag < 31 {
			out.push(leading | byte(tag))
		} else {
			out.push(leading | 0x1f)
			out = asn1WriteBase128(out, tag)
		}
		if length < 0x80 {
			out.push(byte(length))
		} else {
			let count = 0
			for let l = length; l > 0; l = l >> 8 {
				count++
			}
			out.push(byte(0x80 | count))
			for let i = count - 1; i >= 0; i-- {
				out.push(byte((length >> (8 * i)) & 0xff))
			}
		}
		return out
	}

	// asn1IntegerBytes is the shortest two's-complement encoding of the value.
	internal def asn1IntegerBytes(value bigint) byte[] {
		if value.sign() >= 0 {
			let mag = value.bytes()
			return byte[0] when mag.len() == 0
			return byte[0] + mag when mag[0] >= 0x80
			return mag
		}
		let size = value.not().bitLen() / 8 + 1
		let wrapped = (bigint(1) << (8 * size)) + value
		return wrapped.bytes(size) onerror recover []
	}

	internal def asn1CompareBytes(a, b byte[]) int {
		let n = a.len()
		n = b.len() when b.len() < n
		for let i = 0; i < n; i++ {
			return -1 when a[i] < b[i]
			return 1 when a[i] > b[i]
		}
		return -1 when a.len() < b.len()
		return 1 when a.len() > b.len()
		return 0
	}

	internal def asn1IsPrintable(b byte) bool {
		return true when (b >= 0x61 && b <= 0x7a) || (b >= 0x41 && b <= 0x5a) || (b >= 0x30 && b <= 0x39)
		// space ' ( ) + , - . / : = ?
		return true when b := 0x20 || 0x27 || 0x28 || 0x29 || 0x2b || 0x2c || 0x2d || 0x2e || 0x2f || 0x3a || 0x3d || 0x3f
		// * is accepted, as Go does, since wildcard names carry it.
		return b == 0x2a
	}

	// asn1Latin1 reads bytes as ISO 8859-1, one code point per byte.
	internal def asn1Latin1(input byte[]) string {
		let out byte[]
		for let (_, b) in input {
			out = asn1PushUTF8(out, int(b))
		}
		return string(out)
	}

	// asn1BMP reads UTF-16BE, surrogate pairs included.
	internal def asn1BMP(input byte[]) !string {
		expects {
			assert input.len() % 2 == 0 onerror fail "asn1: BMPString has an odd byte count"
		}
		let out byte[]
		for let i = 0; i < input.len(); i += 2 {
			let unit = int(input[i]) << 8 | int(input[i + 1])
			if unit >= 0xd800 && unit < 0xdc00 {
				fail "asn1: BMPString has an unpaired surrogate" when i + 4 > input.len()
				let low = int(input[i + 2]) << 8 | int(input[i + 3])
				fail "asn1: BMPString has an unpaired surrogate" when low < 0xdc00 || low >= 0xe000
				unit = 0x10000 + ((unit - 0xd800) << 10) + (low - 0xdc00)
				i += 2
			} else if unit >= 0xdc00 && unit < 0xe000 {
				fail "asn1: BMPString has an unpaired surrogate"
			}
			out = asn1PushUTF8(out, unit)
		}
		return string(out)
	}

	// asn1BMPBytes encodes text as UTF-16BE.
	internal def asn1BMPBytes(text string) byte[] {
		let out byte[]
		for let (_, c) in text {
			let cp = int(c)
			if cp >= 0x10000 {
				let v = cp - 0x10000
				let high = 0xd800 + (v >> 10)
				let low = 0xdc00 + (v & 0x3ff)
				out.push(byte(high >> 8))
				out.push(byte(high & 0xff))
				out.push(byte(low >> 8))
				out.push(byte(low & 0xff))
			} else {
				out.push(byte(cp >> 8))
				out.push(byte(cp & 0xff))
			}
		}
		return out
	}

	internal def asn1PushUTF8(out byte[], cp int) byte[] {
		if cp < 0x80 {
			out.push(byte(cp))
		} else if cp < 0x800 {
			out.push(byte(0xc0 | (cp >> 6)))
			out.push(byte(0x80 | (cp & 0x3f)))
		} else if cp < 0x10000 {
			out.push(byte(0xe0 | (cp >> 12)))
			out.push(byte(0x80 | ((cp >> 6) & 0x3f)))
			out.push(byte(0x80 | (cp & 0x3f)))
		} else {
			out.push(byte(0xf0 | (cp >> 18)))
			out.push(byte(0x80 | ((cp >> 12) & 0x3f)))
			out.push(byte(0x80 | ((cp >> 6) & 0x3f)))
			out.push(byte(0x80 | (cp & 0x3f)))
		}
		return out
	}

	// asn1Digits reads text[from:to] as a decimal number.
	internal def asn1Digits(text string, from int, to int) !int {
		expects {
			assert to <= text.len() onerror fail "asn1: time \"{text}\" is truncated"
		}
		let value = 0
		for let i = from; i < to; i++ {
			let c = text[i]
			fail "asn1: time \"{text}\" holds a non-digit" unless c >= '0' && c <= '9'
			value = value * 10 + int(c) - 48
		}
		return value
	}

	// asn1Time reads `YYYYMMDDHHMM[SS][.fff](Z|+hhmm|-hhmm)`.
	internal def asn1Time(text string) !Time {
		let year = try asn1Digits(text, 0, 4)
		let month = try asn1Digits(text, 4, 6)
		let day = try asn1Digits(text, 6, 8)
		let hour = try asn1Digits(text, 8, 10)
		let minute = try asn1Digits(text, 10, 12)
		let i = 12
		let second = 0
		if i + 2 <= text.len() && text[i] >= '0' && text[i] <= '9' {
			second = try asn1Digits(text, i, i + 2)
			i += 2
		}
		let fraction = ""
		if i < text.len() && text[i] == '.' {
			i++
			let start = i
			for i < text.len() && text[i] >= '0' && text[i] <= '9' {
				i++
			}
			fraction = "." + text[start:i]
			fail "asn1: time \"{text}\" has an empty fraction" when fraction == "."
		}
		fail "asn1: time \"{text}\" has no zone" when i >= text.len()
		let zone = "Z"
		if text[i] == 'Z' {
			i++
		} else {
			fail "asn1: time \"{text}\" has an invalid zone" unless (text[i] == '+' || text[i] == '-') && i + 5 <= text.len()
			zone = text[i:i + 3] + ":" + text[i + 3:i + 5]
			i += 5
		}
		fail "asn1: time \"{text}\" has trailing characters" when i != text.len()
		let rfc = year.str().padStart(4, "0") + "-" + month.str().padStart(2, "0") + "-" + day.str().padStart(2, "0") + "T" + hour.str().padStart(2, "0") + ":" + minute.str().padStart(2, "0") + ":" + second.str().padStart(2, "0") + fraction + zone
		return time.parse(rfc) onerror fail "asn1: time \"{text}\" is out of range"
	}

	// asn1TimeDigits renders the time as `[YY]YYMMDDHHMMSSZ`, in UTC.
	internal def asn1TimeDigits(t Time, year int, yearDigits int) string {
		return year.str().padStart(yearDigits, "0") + t.month().str().padStart(2, "0") + t.day().str().padStart(2, "0") + t.hour().str().padStart(2, "0") + t.minute().str().padStart(2, "0") + t.second().str().padStart(2, "0") + "Z"
	}

	internal def asn1TagName(tag int) string {
		switch {
			case tag == int(ASN1Tag.Boolean):
				return "BOOLEAN"
			case tag == int(ASN1Tag.Integer):
				return "INTEGER"
			case tag == int(ASN1Tag.BitString):
				return "BIT STRING"
			case tag == int(ASN1Tag.OctetString):
				return "OCTET STRING"
			case tag == int(ASN1Tag.Null):
				return "NULL"
			case tag == int(ASN1Tag.ObjectIdentifier):
				return "OBJECT IDENTIFIER"
			case tag == int(ASN1Tag.Enumerated):
				return "ENUMERATED"
			case tag == int(ASN1Tag.UTF8String):
				return "UTF8String"
			case tag == int(ASN1Tag.Sequence):
				return "SEQUENCE"
			case tag == int(ASN1Tag.Set):
				return "SET"
			case tag == int(ASN1Tag.NumericString):
				return "NumericString"
			case tag == int(ASN1Tag.PrintableString):
				return "PrintableString"
			case tag == int(ASN1Tag.T61String):
				return "T61String"
			case tag == int(ASN1Tag.IA5String):
				return "IA5String"
			case tag == int(ASN1Tag.UTCTime):
				return "UTCTime"
			case tag == int(ASN1Tag.GeneralizedTime):
				return "GeneralizedTime"
			case tag == int(ASN1Tag.BMPString):
				return "BMPString"
			default:
				return "UNIVERSAL {tag}"
		}
	}
}
