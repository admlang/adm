partial module std.data.encoding {
	use (
		std.testing
		std.time
	)

	check "ASN1" {
		internal def testCertificatePEM() string {
			return "-----BEGIN CERTIFICATE-----\n" +
				"MIIBhzCCAS2gAwIBAgIEEjSrzTAKBggqhkjOPQQDAjAhMREwDwYDVQQDDAhhZG0u\n" +
				"dGVzdDEMMAoGA1UECgwDQURNMB4XDTI2MDkxNjE3MDgwMVoXDTI3MDkxNjE3MDgw\n" +
				"MVowITERMA8GA1UEAwwIYWRtLnRlc3QxDDAKBgNVBAoMA0FETTBZMBMGByqGSM49\n" +
				"AgEGCCqGSM49AwEHA0IABLqfiCFn9TD7jcRc/TBAbhNQb5XgUg2H0ACFVbNiF004\n" +
				"X/mMEAjevseS9tumN+ukvOysp5+622B2HSRI1QgcaVmjUzBRMB0GA1UdDgQWBBQT\n" +
				"eM+gb9YkjL4IMphpejfRMxgbaTAfBgNVHSMEGDAWgBQTeM+gb9YkjL4IMphpejfR\n" +
				"MxgbaTAPBgNVHRMBAf8EBTADAQH/MAoGCCqGSM49BAMCA0gAMEUCIHnbhkAnM1p0\n" +
				"zR6dgnVT6K9obzQ44mh8vh4h4sMfCyJaAiEAllaJEVUKJ8e8kR7T/I3udKFgFRIY\n" +
				"6mLNYJoZPe7+fuY=\n" +
				"-----END CERTIFICATE-----\n"
		}

		internal def der(hex string) byte[] {
			return hexdecode(hex) onerror recover []
		}

		internal def parseOrNull(hex string) ASN1Element {
			return asn1Parse(der(hex)) onerror recover asn1Null()
		}

		@test()
		def TestParseSequence() !none {
			let seq = try asn1Parse(der("3005020105 0500".replace(" ", "")))
			assert seq.isTag(ASN1Tag.Sequence)
			assert seq.constructed
			assert seq.children.len() == 2
			assert (try (try seq.at(0)).asInt()) == 5
			assert (try seq.at(1)).isTag(ASN1Tag.Null)
			assert seq.describe() == "SEQUENCE"
			assert seq.raw.hex() == "30050201050500"
			assert seq.content.hex() == "0201050500"
			// Rebuilt from parts it encodes the same.
			assert asn1Sequence([asn1Integer(5), asn1Null()]).encode().hex() == "30050201050500"
		}

		@test()
		def TestIntegers() !none {
			assert (try parseOrNull("020100").asInt()) == 0
			assert (try parseOrNull("02017f").asInt()) == 127
			assert (try parseOrNull("02020080").asInt()) == 128
			assert (try parseOrNull("020180").asInt()) == -128
			assert (try parseOrNull("0202ff7f").asInt()) == -129
			assert (try parseOrNull("0201ff").asInt()) == -1
			assert asn1Integer(0).encode().hex() == "020100"
			assert asn1Integer(127).encode().hex() == "02017F"
			assert asn1Integer(128).encode().hex() == "02020080"
			assert asn1Integer(-128).encode().hex() == "020180"
			assert asn1Integer(-129).encode().hex() == "0202FF7F"
			assert asn1Integer(-1).encode().hex() == "0201FF"
			assert asn1Integer(256).encode().hex() == "02020100"
			// Nine bytes: too wide for asInt, fine for asBigInt.
			let wide = try asn1Parse(der("020900ffffffffffffffff"))
			let tooWide = wide.asInt() onerror recover -7
			assert tooWide == -7
			let big = try wide.asBigInt()
			assert big == (bigint(1) << 64) - bigint(1)
			assert asn1Integer(big).encode().hex() == "020900FFFFFFFFFFFFFFFF"
			assert (try parseOrNull("0202ff7f").asBigInt()) == bigint(-129)
			assert (try parseOrNull("0a0103").asInt()) == 3
			assert asn1Enumerated(3).encode().hex() == "0A0103"
		}

		@test()
		def TestIntegerRejectsNonMinimal() !none {
			let padded = parseOrNull("0202007f").asInt() onerror recover -2
			assert padded == -2
			let negativePadded = parseOrNull("0202ff80").asInt() onerror recover -2
			assert negativePadded == -2
			let emptyInt = parseOrNull("0200").asInt() onerror recover -2
			assert emptyInt == -2
		}

		@test()
		def TestBooleans() !none {
			assert try parseOrNull("0101ff").asBool()
			assert !(try parseOrNull("010100").asBool())
			let loose = parseOrNull("010101").asBool() onerror recover true
			assert loose
			assert asn1Boolean(true).encode().hex() == "0101FF"
			assert asn1Boolean(false).encode().hex() == "010100"
			// The wrong tag is refused with the tag name.
			let notBool = parseOrNull("020100").asBool() onerror (err error) {
				assert err.message.contains("INTEGER is not BOOLEAN")
				recover true
			}
			assert notBool
		}

		@test()
		def TestObjectIdentifiers() !none {
			let sha256RSA = try parseOrNull("06092a864886f70d01010b").asOID()
			assert sha256RSA.str() == "1.2.840.113549.1.1.11"
			assert sha256RSA.equals("1.2.840.113549.1.1.11")
			let ecKey = try parseOID("1.2.840.10045.2.1")
			assert asn1OID(ecKey).encode().hex() == "06072A8648CE3D0201"
			assert asn1OID(try parseOID("2.5.4.3")).encode().hex() == "0603550403"
			assert (try parseOrNull("0603550403").asOID()).equals(try parseOID("2.5.4.3"))
			assert !ecKey.equals(sha256RSA)
			// Arc 2 with a large second arc: 2.999.3 encodes 88 37 03.
			assert asn1OID(try parseOID("2.999.3")).encode().hex() == "0603883703"
			assert (try parseOrNull("0603883703").asOID()).str() == "2.999.3"
			let short = parseOID("1") onerror recover new OID([9])
			assert short.arcs[0] == 9
			let bad = parseOID("1.x") onerror recover new OID([9])
			assert bad.arcs[0] == 9
			let leadingZero = parseOrNull("0602802a").asOID() onerror recover new OID([9])
			assert leadingZero.arcs[0] == 9
		}

		@test()
		def TestBitStrings() !none {
			let bits = try parseOrNull("030206c0").asBitString()
			assert bits.bitLength == 2
			assert bits.at(0) == 1
			assert bits.at(1) == 1
			assert bits.at(2) == 0
			assert bits.rightAlign().hex() == "03"
			assert asn1BitString(bits).encode().hex() == "030206C0"
			assert asn1BitString(byte[0x04, 0xaa]).encode().hex() == "03030004AA"
			let whole = try parseOrNull("03030004aa").asBitString()
			assert whole.bitLength == 16
			assert whole.bytes.hex() == "04AA"
			// Padding bits that are set are not DER.
			let dirty = parseOrNull("030206c1").asBitString() onerror recover new BitString([], -1)
			assert dirty.bitLength == -1
			// The encoder clears them.
			assert asn1BitString(new BitString(byte[0xc1], 2)).encode().hex() == "030206C0"
		}

		@test()
		def TestStrings() !none {
			assert (try parseOrNull("0c0568656c6c6f").asString()) == "hello"
			assert (try parseOrNull("130568656c6c6f").asString()) == "hello"
			assert (try parseOrNull("160568656c6c6f").asString()) == "hello"
			assert (try parseOrNull("1e0400680069").asString()) == "hi"
			assert (try parseOrNull("1e04d83dde00").asString()) == "😀"
			assert (try parseOrNull("1401e9").asString()) == "é"
			assert asn1UTF8String("hello").encode().hex() == "0C0568656C6C6F"
			assert asn1PrintableString("hello").encode().hex() == "130568656C6C6F"
			assert asn1IA5String("hello").encode().hex() == "160568656C6C6F"
			assert asn1String(ASN1Tag.BMPString, "😀").encode().hex() == "1E04D83DDE00"
			assert asn1String(ASN1Tag.BMPString, "hi").encode().hex() == "1E0400680069"
			// Character set violations.
			let at = parseOrNull("130140").asString() onerror recover "bad"
			assert at == "bad"
			let high = parseOrNull("1601e9").asString() onerror recover "bad"
			assert high == "bad"
			let odd = parseOrNull("1e0100").asString() onerror recover "bad"
			assert odd == "bad"
			let notString = parseOrNull("020100").asString() onerror recover "bad"
			assert notString == "bad"
		}

		@test()
		def TestTimes() !none {
			let utc = try parseOrNull("170d3233303931363132303030305a").asTime()
			assert utc.str() == "2023-09-16T12:00:00Z"
			assert (try parseOrNull("170d3439303130313030303030305a").asTime()).str() == "2049-01-01T00:00:00Z"
			assert (try parseOrNull("170d3530303130313030303030305a").asTime()).str() == "1950-01-01T00:00:00Z"
			let general = try parseOrNull("180f32303530303130313030303030305a").asTime()
			assert general.str() == "2050-01-01T00:00:00Z"
			// A zone offset is applied.
			let offset = try parseOrNull("17113233303931363132303030302b30313030").asTime()
			assert offset.str() == "2023-09-16T11:00:00Z"
			// Seconds may be left out of a UTCTime.
			assert (try parseOrNull("170b323330393136313230305a").asTime()).str() == "2023-09-16T12:00:00Z"
			// Encoding picks the tag by year.
			assert asn1Time(utc).encode().hex() == "170D3233303931363132303030305A"
			assert asn1Time(general).encode().hex() == "180F32303530303130313030303030305A"
			assert asn1UTCTime(try time.parse("1999-12-31T23:59:59Z")).encode().hex() == "170D3939313233313233353935395A"
			assert asn1GeneralizedTime(utc).encode().hex() == "180F32303233303931363132303030305A"
			let noZone = parseOrNull("170c323330393136313230303030").asTime() onerror recover new Time()
			assert noZone.unixNs() == 0
			let badMonth = parseOrNull("170d3233313331363132303030305a").asTime() onerror recover new Time()
			assert badMonth.unixNs() == 0
		}

		@test()
		def TestTagging() !none {
			let explicit = asn1Explicit(3, asn1Integer(2))
			assert explicit.encode().hex() == "A303020102"
			assert explicit.describe() == "[3]"
			let implicit = asn1Implicit(0, asn1OctetString(byte[1, 2]))
			assert implicit.encode().hex() == "80020102"
			let seq = try asn1Parse(asn1Sequence([asn1Integer(1), implicit, explicit]).encode())
			assert seq.tagged(1) is none
			let found = seq.tagged(3)
			fail "[3] not found" when found is none
			assert (try (try found.inner()).asInt()) == 2
			let zero = seq.tagged(0)
			fail "[0] not found" when zero is none
			assert zero.content.hex() == "0102"
			let notWrapped = (try seq.at(0)).inner() onerror recover asn1Null()
			assert notWrapped.isTag(ASN1Tag.Null)
			let outOfRange = seq.at(3) onerror recover asn1Null()
			assert outOfRange.isTag(ASN1Tag.Null)
			// An OCTET STRING carrying DER opens with parse().
			let wrapped = asn1OctetString(asn1Boolean(true).encode())
			assert try (try wrapped.parse()).asBool()
		}

		@test()
		def TestLengthsAndHighTags() !none {
			let long byte[]
			long.len(200)
			long.fill(0xab)
			let element = asn1OctetString(long)
			assert element.raw[0:3].hex() == "0481C8"
			assert (try (try asn1Parse(element.encode())).asBytes()).len() == 200
			let longer byte[]
			longer.len(300)
			assert asn1OctetString(longer).raw[0:4].hex() == "0482012C"
			assert (try asn1Parse(asn1OctetString(longer).encode())).content.len() == 300
			let high = new ASN1Element(ASN1Class.ContextSpecific, 31, false, [])
			assert high.encode().hex() == "9F1F00"
			let back = try asn1Parse(high.encode())
			assert back.tag == 31 && back.isContext(31)
			let app = asn1Constructed(ASN1Class.Application, 200, [])
			assert app.encode().hex() == "7F814800"
			assert (try asn1Parse(app.encode())).describe() == "APPLICATION 200"
		}

		@test()
		def TestParseRejectsMalformed() !none {
			let cases = [
				"048105aabbccddee", // non-minimal length
				"3080020105000000", // indefinite length
				"0403aabb", // content runs past the input
				"30", // truncated length
				"", // nothing
				"0201050500", // trailing bytes
				"1f1e00", // high tag form for a tag below 31
			]
			for let (_, hex) in cases {
				let parsed = asn1Parse(der(hex)) onerror recover asn1Null()
				assert parsed.isTag(ASN1Tag.Null)
			}
			let trailing = asn1Parse(der("0201050500")) onerror (err error) {
				assert err.message == "asn1: 2 trailing bytes after INTEGER"
				recover asn1Null()
			}
			assert trailing.isTag(ASN1Tag.Null)
			let all = try asn1ParseAll(der("0201050500"))
			assert all.len() == 2
			assert (try asn1ParseAll([])).len() == 0
		}

		@test()
		def TestSetSortsByEncoding() {
			let set = asn1Set([asn1Integer(2), asn1OctetString([]), asn1Integer(1)])
			assert set.encode().hex() == "310802010102010204 00".replace(" ", "")
		}

		@test()
		def TestSubjectPublicKeyInfo() !none {
			let pem = "-----BEGIN PUBLIC KEY-----\n" +
				"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEup+IIWf1MPuNxFz9MEBuE1BvleBS\n" +
				"DYfQAIVVs2IXTThf+YwQCN6+x5L226Y366S87Kynn7rbYHYdJEjVCBxpWQ==\n" +
				"-----END PUBLIC KEY-----\n"
			let block = try pemDecode(pem)
			let spki = try asn1Parse(block.bytes)
			let algorithm = try spki.at(0)
			assert (try (try algorithm.at(0)).asOID()).equals("1.2.840.10045.2.1")
			assert (try (try algorithm.at(1)).asOID()).equals("1.2.840.10045.3.1.7")
			let key = try (try spki.at(1)).asBitString()
			assert key.bitLength == 520
			assert key.bytes[0] == 0x04
			assert spki.encode().hex() == block.bytes.hex()
		}

		@test()
		def TestCertificate() !none {
			let block = try pemDecode(testCertificatePEM())
			assert block.kind == "CERTIFICATE"
			let cert = try asn1Parse(block.bytes)
			let tbs = try cert.at(0)
			let version = try (try (try tbs.at(0)).inner()).asInt()
			assert version == 2
			assert (try (try tbs.at(1)).asBigInt()).hex() == "1234abcd"
			let signatureAlgorithm = try (try (try tbs.at(2)).at(0)).asOID()
			assert signatureAlgorithm.equals("1.2.840.10045.4.3.2")
			// Issuer: SET OF AttributeTypeAndValue, CN then O.
			let issuer = try tbs.at(3)
			let cn = try (try (try issuer.at(0)).at(0)).at(1)
			assert (try cn.asString()) == "adm.test"
			assert cn.isTag(ASN1Tag.UTF8String)
			let validity = try tbs.at(4)
			assert (try (try validity.at(0)).asTime()).str() == "2026-09-16T17:08:01Z"
			assert (try (try validity.at(1)).asTime()).str() == "2027-09-16T17:08:01Z"
			// Extensions ride in [3] EXPLICIT; basicConstraints is critical.
			let tagged = tbs.tagged(3)
			fail "no extensions" when tagged is none
			let extensions = try tagged.inner()
			assert extensions.children.len() == 3
			let basic = try extensions.at(2)
			assert (try (try basic.at(0)).asOID()).equals("2.5.29.19")
			assert try (try basic.at(1)).asBool()
			let constraints = try (try basic.at(2)).parse()
			assert try (try constraints.at(0)).asBool()
			// The signature is a BIT STRING around a DER SEQUENCE of r and s.
			let signature = try (try cert.at(2)).asBitString()
			let rs = try asn1Parse(signature.bytes)
			assert (try (try rs.at(0)).asBigInt()).sign() > 0
			assert (try (try rs.at(1)).asBigInt()).sign() > 0
			assert tbs.raw.len() > 0 && cert.raw.hex() == block.bytes.hex()
		}
	}
}
