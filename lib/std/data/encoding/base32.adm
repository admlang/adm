partial module std.data.encoding {
	// Base32 encodes and decodes the alphabet of RFC 4648 §6 (`A`-`Z`, `2`-`7`),
	// with padding unless padded is turned off. With hex set it uses the
	// extended hex alphabet of §7 instead (`0`-`9`, `A`-`V`), which keeps the
	// sort order of the bytes and is what DNS NSEC3 names carry. Decoding
	// takes either case.
	//
	// Example:
	// ```example
	// let codec = new Base32()
	// let text = codec.encode("hi there".bytes()) // "NBUSA5DIMVZGK==="
	// let back = try codec.decode(text)
	// println(string(back)) // hi there
	// ```
	type Base32 {
		internal const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
		internal const hexAlphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUV"
		// Toggle padding when encoding.
		padded bool = true
		// Encode and decode with the extended hex alphabet.
		hex    bool = false

		// encode renders the bytes as Base32 text, padded with = to a multiple
		// of 8 characters when padded is set.
		def encode(input byte[]) string {
			let alpha = byte[](hex ?? (hexAlphabet, alphabet))
			let output byte[]
			let buffer = 0
			let bits = 0
			for let i = 0; i < input.len(); i++ {
				buffer = (buffer << 8 | int(input[i]) & 0xff) & 0xffff
				bits += 8
				for bits >= 5 {
					bits -= 5
					output.push(alpha[buffer >> bits & 0x1f])
				}
			}
			output.push(alpha[buffer << (5 - bits) & 0x1f]) when bits > 0
			for padded && output.len() % 8 != 0 {
				output.push(byte(61))
			}
			return string(output)
		}

		// decode turns Base32 text back into bytes, padded or not. Fails when
		// the text holds a character outside the alphabet.
		def decode(input string) !byte[] {
			let output byte[]
			let buffer = 0
			let bits = 0
			for let (_, b) in input.bytes() {
				let c = int(b)
				break when c == 61
				let value = valueOf(c)
				fail "invalid character in Base32 string" when value < 0
				buffer = (buffer << 5 | value) & 0xffff
				bits += 5
				if bits >= 8 {
					bits -= 8
					output.push(byte(buffer >> bits & 0xff))
				}
			}
			return output
		}

		// valueOf is the five bits the character stands for, -1 when it is
		// outside the alphabet.
		internal def valueOf(char int) int {
			// Lower case reads as upper case.
			let c = char >= 0x61 && char <= 0x7a ?? (char - 0x20, char)
			if hex {
				return c - 0x30 when c >= 0x30 && c <= 0x39
				return c - 0x41 + 10 when c >= 0x41 && c <= 0x56
				return -1
			}
			return c - 0x41 when c >= 0x41 && c <= 0x5a
			return c - 0x32 + 26 when c >= 0x32 && c <= 0x37
			return -1
		}
	}
}
