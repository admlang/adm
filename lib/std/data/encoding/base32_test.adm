partial module std.data.encoding {
	use std.testing

	check "Base32" {
		@test()
		def rfc4648_vectors() {
			let codec = new Base32()
			assert codec.encode("".bytes()) == ""
			assert codec.encode("f".bytes()) == "MY======"
			assert codec.encode("fo".bytes()) == "MZXQ===="
			assert codec.encode("foo".bytes()) == "MZXW6==="
			assert codec.encode("foob".bytes()) == "MZXW6YQ="
			assert codec.encode("fooba".bytes()) == "MZXW6YTB"
			assert codec.encode("foobar".bytes()) == "MZXW6YTBOI======"
		}

		@test()
		def hex_alphabet_vectors() {
			let codec = new Base32()
			codec.hex = true
			assert codec.encode("f".bytes()) == "CO======"
			assert codec.encode("foob".bytes()) == "CPNMUOG="
			assert codec.encode("foobar".bytes()) == "CPNMUOJ1E8======"
			codec.padded = false
			assert codec.encode("foobar".bytes()) == "CPNMUOJ1E8"
		}

		@test()
		def decodes_either_case_padded_or_not() {
			let codec = new Base32()
			let padded = codec.decode("MZXW6YTBOI======") onerror recover byte[0]
			assert string(padded) == "foobar"
			let lower = codec.decode("mzxw6ytboi") onerror recover byte[0]
			assert string(lower) == "foobar"
			codec.hex = true
			let hexed = codec.decode("cpnmuoj1e8") onerror recover byte[0]
			assert string(hexed) == "foobar"
		}

		@test()
		def round_trips_binary() {
			let codec = new Base32()
			codec.hex = true
			let src byte[]
			for let i = 0; i < 1000; i++ {
				src.push(byte((i * 37 + 11) % 256))
			}
			let back = codec.decode(codec.encode(src)) onerror recover byte[0]
			assert back.len() == src.len()
			for let (i, b) in src {
				assert back[i] == b
			}
		}

		@test()
		def refuses_a_character_outside_the_alphabet() {
			let failed = false
			let codec = new Base32()
			codec.decode("MZXW1") onerror (err error) {
				failed = true
				recover byte[0]
			}
			assert failed
			// W is outside the hex alphabet.
			codec.hex = true
			failed = false
			codec.decode("CPNW") onerror (err error) {
				failed = true
				recover byte[0]
			}
			assert failed
		}
	}
}
