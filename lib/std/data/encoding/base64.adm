partial module std.data.encoding {
	internal let base64Encoder = new Base64()

	// base64encode encodes bytes with the standard, padded Base64 alphabet.
	def base64encode(input byte[]) string {
		return base64Encoder.encode(input)
	}

	// base64decode decodes standard Base64 text. Fails when the text holds a
	// character outside the alphabet or ends in the middle of a group.
	def base64decode(input string) !byte[] {
		return base64Encoder.decode(input)
	}

	// Base64 encodes and decodes the standard alphabet of RFC 4648, with padding
	// unless padded is turned off.
	//
	// Example:
	// ```example
	// let codec = new Base64()
	// let text = codec.encode("hi there".bytes()) // "aGkgdGhlcmU="
	// let back = try codec.decode(text)
	// println(string(back)) // hi there
	// ```
	type Base64 {
		// Standard base64 encoding, as defined in RFC 4648.
		internal const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
		// Toggle padding when encoding.
		padded bool = true

		// encode renders the bytes as Base64 text, padded with = when padded is set.
		def encode(input byte[]) string {
			let alpha = byte[](alphabet)
			let output byte[]

			for let i = 0; i < input.len(); i += 3 {
				let chunk = 0
				let chunkSize = 0

				for let j = 0; j < 3; j++ {
					if i + j < input.len() {
						// Ensure the shift happens on an int, not on byte (byte shifts truncate).
						chunk |= (int(input[i + j]) & 0xFF) << (16 - 8 * j)
						chunkSize++
					}
				}

				for let j = 0; j < 4; j++ {
					if j <= chunkSize {
						let index = (chunk >> (18 - 6 * j)) & 0x3F
						output.push(alpha[index])
					} else if padded {
						output.push(byte(61))
					}
				}
			}

			return string(output)
		}

		// decode turns Base64 text back into bytes, padded or not. Fails when the
		// text holds a character outside the alphabet or ends in the middle of a
		// group.
		def decode(input string) !byte[] {
			let (
				output              byte[]
				buffer, bits, index        = 0
			)

			output.len(input.len() * 3 / 4)

			for let (_, ch) in input {
				if ch == '=' {
					break
				}

				let value = alphabet.indexOf(string(ch))
				if value == -1 {
					fail "invalid character in Base64 string"
				}

				buffer = (buffer << 6) | value
				bits += 6

				if bits >= 8 {
					bits -= 8
					output[index] = byte((buffer >> bits) & 0xFF)
					index++
				}
			}

			return output.slice(0, index)
		}
	}
}
