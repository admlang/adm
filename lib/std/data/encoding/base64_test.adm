partial module std.data.encoding {
	use std.testing

	check "Base64" {
		@test()
		def rfc4648_vectors() {
			assert base64encode("".bytes()) == ""
			assert base64encode("f".bytes()) == "Zg=="
			assert base64encode("fo".bytes()) == "Zm8="
			assert base64encode("foo".bytes()) == "Zm9v"
			assert base64encode("foob".bytes()) == "Zm9vYg=="
			assert base64encode("fooba".bytes()) == "Zm9vYmE="
			assert base64encode("foobar".bytes()) == "Zm9vYmFy"
		}

		@test()
		def covers_the_whole_alphabet() {
			let all byte[]
			for let i = 0; i < 256; i++ {
				all.push(byte(i))
			}
			let encoded = base64encode(all)
			assert encoded.len() == 344
			assert encoded.startsWith("AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8g")
			assert encoded.endsWith("8PHy8/T19vf4+fr7/P3+/w==")
		}

		@test()
		def round_trips_binary() {
			let src byte[]
			for let i = 0; i < 1000; i++ {
				src.push(byte((i * 37 + 11) % 256))
			}
			let back = base64decode(base64encode(src)) onerror recover byte[0]
			assert back.len() == src.len()
			for let (i, b) in src {
				assert back[i] == b
			}
		}

		@test()
		def decodes_the_vectors() {
			let foobar = base64decode("Zm9vYmFy") onerror recover byte[0]
			assert foobar.hex() == "666F6F626172"

			let fooba = base64decode("Zm9vYmE=") onerror recover byte[0]
			assert fooba.hex() == "666F6F6261"

			let f = base64decode("Zg==") onerror recover byte[0]
			assert f.hex() == "66"
		}

		@test()
		def speaks_the_url_safe_alphabet() {
			let codec = Base64{urlSafe: true, padded: false}
			let src = [byte(0), byte(4), byte(0), byte(0), byte(0xFF), byte(0xFF), byte(0xFB)]
			assert codec.encode(src) == "AAQAAP__-w"
			assert base64encode(src) == "AAQAAP//+w=="
			let back = codec.decode("AAQAAP__-w") onerror recover byte[0]
			assert back.hex() == "00040000FFFFFB"
			// Each alphabet refuses the other's two characters.
			let mixed = false
			codec.decode("AAQAAP//") onerror {
				mixed = true
				recover byte[0]
			}
			assert mixed
			mixed = false
			base64decode("AAQAAP__") onerror {
				mixed = true
				recover byte[0]
			}
			assert mixed
		}
	}
}
