partial module std.data.encoding {
	// Base83 writes numbers and bytes in the 83-character alphabet of
	// BlurHash (`0`-`9`, `A`-`Z`, `a`-`z`, then `#$%*+,-.:;=?@[]^_{|}~`),
	// most significant digit first.
	//
	// BlurHash itself only packs integers into fixed-width digit groups:
	// `encode(value, length)` and `decodeInt`. Bytes are encoded in groups
	// of seven, each as nine digits; a last group of 1, 2, 3, 4, 5 or 6
	// bytes takes 2, 3, 4, 6, 7 or 8 digits. That byte form is this
	// module's own, not a published standard.
	//
	// Example:
	// ```example
	// let codec = new Base83()
	// let text = codec.encode(3429, 2) // "fQ"
	// let value = try codec.decodeInt(text) // 3429
	// let back = try codec.decode(codec.encode("hello".bytes()))
	// ```
	type Base83 {
		internal const alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz#$%*+,-.:;=?@[]^_{|}~"
		// Digits taken by a group of 0 to 7 bytes.
		internal const groupDigits = int[0, 2, 3, 4, 6, 7, 8, 9]

		// encode renders `value` as exactly `length` digits, most significant
		// first. Digits above `length` are dropped, so `value` should be
		// below 83 to the power `length`; a negative value is taken as 0.
		def encode(value int, length int) string {
			let output byte[]
			appendDigits(output, value.max(0), length)
			return string(output)
		}

		// encode renders the bytes as Base83 text: nine digits per seven
		// bytes, fewer for the last group.
		def encode(input byte[]) string {
			let output byte[]
			for let at = 0; at < input.len(); at += 7 {
				let count = (input.len() - at).min(7)
				let value = 0
				for let i = 0; i < count; i++ {
					value = value << 8 | int(input[at + i])
				}
				appendDigits(output, value, groupDigits[count])
			}
			return string(output)
		}

		// decodeInt reads the whole text as one number. Fails when the text
		// is empty, longer than nine digits (which could overflow), or holds
		// a character outside the alphabet.
		def decodeInt(input string) !int {
			let digits = input.bytes()
			fail "empty Base83 number" when digits.len() == 0
			fail "Base83 number longer than nine digits" when digits.len() > 9
			return try readDigits(digits, 0, digits.len())
		}

		// decode turns Base83 text back into bytes. Fails when the text holds
		// a character outside the alphabet, ends in a group of 1 or 5 digits,
		// or a group's value does not fit its bytes.
		def decode(input string) !byte[] {
			let digits = input.bytes()
			let output byte[]
			for let at = 0; at < digits.len(); at += 9 {
				let length = (digits.len() - at).min(9)
				let count = groupDigits.indexOf(length)
				fail "invalid Base83 length" when count <= 0
				let value = try readDigits(digits, at, length)
				fail "Base83 group out of range" when count < 7 && value >> (8 * count) != 0
				for let i = count - 1; i >= 0; i-- {
					output.push(byte(value >> (8 * i) & 0xff))
				}
			}
			return output
		}

		internal def appendDigits(output byte[], value int, length int) {
			let alpha = alphabet.bytes()
			let divisor = 1
			for let i = 1; i < length; i++ {
				divisor *= 83
			}
			for let i = 0; i < length; i++ {
				output.push(alpha[(value / divisor) % 83])
				divisor /= 83
			}
		}

		internal def readDigits(digits byte[], at int, length int) !int {
			let value = 0
			for let i = at; i < at + length; i++ {
				let d = valueOf(int(digits[i]))
				fail "invalid character in Base83 string" when d < 0
				value = value * 83 + d
			}
			return value
		}

		// valueOf is the digit the character stands for, -1 when it is
		// outside the alphabet.
		internal def valueOf(c int) int {
			return c - 0x30 when c >= 0x30 && c <= 0x39
			return c - 0x41 + 10 when c >= 0x41 && c <= 0x5a
			return c - 0x61 + 36 when c >= 0x61 && c <= 0x7a
			return -1 when c < 0 || c > 0x7e
			return alphabet.bytes().indexOf(byte(c))
		}
	}
}
