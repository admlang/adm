partial module std.data.encoding {
	use std.testing

	check "Base83" {
		@test()
		def numbers_in_fixed_width_digits() {
			let codec = new Base83()
			assert codec.encode(3429, 2) == "fQ"
			assert codec.encode(16777215, 4) == "TSUA"
			assert codec.encode(0, 1) == "0"
			assert codec.encode(82, 1) == "~"
			assert (codec.decodeInt("TSUA") onerror recover -1) == 16777215
			assert (codec.decodeInt("") onerror recover -1) == -1
			assert (codec.decodeInt("0000000000") onerror recover -1) == -1
			assert (codec.decodeInt("a b") onerror recover -1) == -1
		}

		@test()
		def bytes_in_groups_of_seven() {
			let codec = new Base83()
			assert codec.encode("".bytes()) == ""
			assert codec.encode("hello".bytes()) == "1U--}$6"
			assert codec.encode("hello, world".bytes()) == "D3=gX^:[r1lI=Pjy"
			assert codec.encode(byte[0, 0, 255]) == "0036"
			assert codec.encode(byte[255, 255, 255, 255, 255, 255, 255]) == "V~Y+vAaDG"
		}

		@test()
		def bytes_round_trip() {
			let codec = new Base83()
			let data byte[]
			for let n = 0; n <= 30; n++ {
				let back = codec.decode(codec.encode(data)) onerror recover byte[0]
				assert back.len() == n
				for let i = 0; i < n; i++ {
					assert back[i] == data[i]
				}
				data.push(byte((n * 97 + 13) % 256))
			}
		}

		@test()
		def decode_rejects_bad_text() {
			let codec = new Base83()
			// A last group of 1 or 5 digits, a group above its bytes, a
			// character outside the alphabet.
			for let (_, text) in ["1", "12345", "~~", "a\"b"] {
				let got = codec.decode(text) onerror recover byte[7, 7, 7]
				assert got.len() == 3 && got[0] == byte(7)
			}
		}
	}
}
