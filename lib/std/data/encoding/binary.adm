partial module std.data.encoding {
	use std.io

	// Binary serializes/deserializes objects in binary format
	type Binary {
		// encode renders obj in the binary format. Not implemented yet.
		def encode(obj any) byte[] {}

		// decode fills target from binary data. Not implemented yet.
		// It cannot fail yet.
		def decode(input byte[], target any) !none {}

		// encode writes obj in the binary format to the writer. Not implemented yet.
		// It cannot fail yet.
		def encode(writer io.Writer, obj any) !none {}

		// decode fills target from binary data read from the reader. Not implemented
		// yet.
		// It cannot fail yet.
		def decode(reader io.Reader, target any) !none {}
	}
}
