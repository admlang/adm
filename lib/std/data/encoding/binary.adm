partial module std.data.encoding {
	use (
		std.io
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext)
	)

	// Qualified name of the `@binary` meta function, used to look up field options.
	internal const binaryAttr = "std.data.encoding.binary"

	// The five header bytes every stream opens with.
	internal const binMagic = "ADMB"
	internal const binVersion = 1

	// How many objects deep a value may nest. A value that refers back to
	// itself has no depth at which it stops, so this is what stands between a
	// cycle and an exhausted stack.
	internal const binMaxDepth = 64

	// Tag of a value whose type wrote its own bytes. It follows the ValueKind
	// tags, which are the enum's own ordinals.
	internal const binTagCustom = 11

	// Description kind of a field declared `any`, whose concrete kind is only
	// known from the value's own tag.
	internal const binKindAny = 11

	// Bit set in a field description when the field was declared optional.
	internal const binOptionalBit = 16

	// What a type description describes.
	internal const binFormStruct = 0
	internal const binFormEnum = 1
	internal const binFormCustom = 2

	// A type that writes itself: Binary calls these instead of walking its fields.
	interface BinaryEncoder {
		def encodeBinary() byte[]
	}

	// A type that reads itself: Binary calls these instead of filling its fields.
	interface BinaryDecoder {
		def decodeBinary(data byte[]) !none
	}

	// What a stream carries, without the type it was written from.
	enum ValueKind {
		None,
		Bool,
		Int,
		Uint,
		Float,
		String,
		Bytes,
		Array,
		Map,
		Struct,
		Enum
	}

	// Encodes values in a compact, self-describing binary stream.
	//
	//     let b = new Binary()
	//     let data = b.encode(user)
	//     try b.decode(data, other)
	//
	// Per-field behaviour comes from `@binary` annotations:
	//
	//     @binary(id: 7)          pin the field's number, so it survives reordering
	//     @binary(name: "user")   rename the field in the stream's description
	//     @binary(ignore: true)   leave the field out
	//
	// A type implementing BinaryEncoder or BinaryDecoder is used instead of
	// reflection. A reader without the types reads the stream with `inspect`.
	//
	// ## Wire format
	//
	// A stream opens with `"ADMB"` and one version byte, `0x01`, and then
	// carries one tagged value per encode. Every integer on the wire is an
	// unsigned LEB128 varint; a signed one is zigzagged first (`0, -1, 1, -2`
	// become `0, 1, 2, 3`). A length-prefixed run of bytes is a varint length
	// and that many bytes; a string is its UTF-8 bytes that way.
	//
	// Each value is one tag byte and a payload. The tags are the ValueKind
	// ordinals:
	//
	//     0x00 None     nothing
	//     0x01 Bool     one byte, 0 or 1
	//     0x02 Int      zigzag varint
	//     0x03 Uint     varint
	//     0x04 Float    8 bytes, IEEE 754 binary64, least significant first
	//     0x05 String   length-prefixed UTF-8
	//     0x06 Bytes    length-prefixed bytes
	//     0x07 Array    varint count, then that many tagged values
	//     0x08 Map      varint count, then that many (string key, tagged value)
	//     0x09 Struct   type reference, then the fields, then varint 0
	//     0x0A Enum     type reference, then the member's zigzag ordinal
	//     0x0B          type reference, then the bytes a BinaryEncoder wrote
	//
	// A type reference is a varint: 0 means a description follows and takes
	// the next type id, and any other value is a type already described in
	// this stream, ids running from 1 in description order. A description is
	// one byte for what it describes (0 an object, 1 an enum, 2 a type that
	// writes its own bytes), then the qualified type name; an object's
	// description goes on with a varint field count and, per field, a varint
	// `id * 32 + optional * 16 + kind` and the field's name. `kind` is the
	// ValueKind the field's declared type maps to, or 11 for a field declared
	// `any`.
	//
	// An object's body is `(varint field id, value)` pairs ended by field id
	// 0. Ids are the 1-based declaration order unless `@binary(id: N)` pins
	// one. A field the reader's type does not have is skipped, and a field the
	// stream does not carry keeps its zero value, so a type can grow fields
	// and old streams still read.
	//
	// ## What the format cannot carry today
	//
	// `std.reflection` reaches neither optional fields nor `any` fields, so an
	// optional field travels as None and an `any` field is read back only
	// through `inspect`. An enum travels as its type name and ordinal, since
	// the member names are not reflectable. A map whose keys are not strings
	// encodes empty and refuses to decode.
	type Binary {
		// encode renders obj as a one-value stream: the header, then obj.
		def encode(obj any) byte[] {
			let w = new BinOut()
			w.start()
			binWriteValue(w, obj, 0)
			return w.buf
		}

		// decode fills target with the stream's first value. Fails when the
		// bytes are not a binary stream, the version is not 1, the stream ends
		// mid-value, or a value does not fit its field.
		def decode(input byte[], target any) !none {
			let r = new BinIn(input)
			try r.start()
			let node = try binReadNode(r, 0)
			return try binBind(node, target)
		}

		// encode writes obj as a one-value stream to the writer. Fails when
		// the writer does.
		def encode(writer io.Writer, obj any) !none {
			let enc = new Encoder(writer)
			return try enc.encode(obj)
		}

		// decode fills target with the first value the reader yields. Fails
		// when the reader does, the bytes are not a binary stream, or a value
		// does not fit its field.
		def decode(reader io.Reader, target any) !none {
			let dec = new Decoder(reader)
			return try dec.decode(target)
		}

		// The stream's values as dynamic trees, for a reader without the types.
		// Fails on a malformed stream.
		def inspect(input byte[]) !Value[] {
			let r = new BinIn(input)
			try r.start()
			let out Value[] = []
			for r.more() {
				out.push(new Value(try binReadNode(r, 0)))
			}
			return out
		}
	}

	// Writes many values to one stream; each type is described once, the first
	// time it is sent.
	type Encoder {
		internal sink io.Writer
		internal w    BinOut

		def new(writer io.Writer) {
			sink = writer
			w = new BinOut()
		}

		// encode writes obj to the stream, describing its type the first time
		// the stream carries it. Fails when the writer does.
		def encode(obj any) !none {
			w.reset()
			w.start()
			binWriteValue(w, obj, 0)
			try sink.write(w.buf)
			return none
		}
	}

	// Reads values back from a stream an Encoder wrote.
	type Decoder {
		internal r BinIn

		def new(reader io.Reader) {
			r = new BinIn(reader)
		}

		// Fills target with the next value. Fails at the end of the stream, on
		// a malformed stream, or when a value does not fit the target.
		def decode(target any) !none {
			try r.start()
			fail "binary: the stream holds no more values" unless r.more()
			let node = try binReadNode(r, 0)
			return try binBind(node, target)
		}

		// The next value as a dynamic tree, none at the end of the stream.
		// Fails on a malformed stream.
		def next() !?Value {
			try r.start()
			return none unless r.more()
			return new Value(try binReadNode(r, 0))
		}
	}

	// One value of a decoded stream, and the children it holds.
	//
	// `keys`, `ids`, `kinds` and `opts` run alongside `vals`: an object uses
	// all of them, a map only `keys`.
	internal type BinNode {
		kind  int       = 0
		name  string    = ""
		b     bool      = false
		i     int       = 0
		u     uint      = 0
		f     float     = 0.0
		s     string    = ""
		raw   byte[]    = []
		items BinNode[] = []
		keys  string[]  = []
		ids   int[]     = []
		kinds int[]     = []
		opts  bool[]    = []
		vals  BinNode[] = []
	}

	// One value a stream carried, read without the type it was written from.
	//
	//     for let (_, v) in try new Binary().inspect(data) {
	//         println(v.str())
	//     }
	type Value {
		internal node BinNode

		// What the stream said this value is.
		kind ValueKind {
			def get() ValueKind {
				return ValueKind(node.kind)
			}
		}

		// The type's qualified name for Struct, Enum and a value that wrote
		// its own bytes; empty otherwise.
		typeName string {
			def get() string {
				return node.name
			}
		}

		// Wraps one decoded node. The codecs build these; a reader gets them
		// from `Binary.inspect` or `Decoder.next`.
		def new(n BinNode) {
			node = n
		}

		// The value as a bool. False for anything but a Bool, a non-zero
		// number or a non-empty string.
		def asBool() bool {
			match ValueKind(node.kind) {
				case ValueKind.Bool:
					return node.b
				case ValueKind.Int, ValueKind.Enum:
					return node.i != 0
				case ValueKind.Uint:
					return node.u != 0
				case ValueKind.String:
					return node.s != ""
				default:
					return false
			}
		}

		// The value as a signed integer; 0 for anything that is not a number,
		// a bool or an enum member.
		def asInt() int {
			return binNodeInt(node)
		}

		// The value as an unsigned integer; 0 for anything that is not a
		// number, a bool or an enum member.
		def asUint() uint {
			return binNodeUint(node)
		}

		// The value as a float; 0.0 for anything that is not a number or a bool.
		def asFloat() float {
			return binNodeFloat(node)
		}

		// The value as text: a string as it stands, a number or bool as it
		// reads, and "" for a container.
		def asString() string {
			return binNodeText(node)
		}

		// The value's bytes: what a Bytes value carries, the UTF-8 of a
		// String, and empty otherwise.
		def asBytes() byte[] {
			return binNodeBytes(node)
		}

		// An Array's elements, in order; empty for anything else.
		def elements() Value[] {
			let out Value[] = []
			return out unless node.kind == int(ValueKind.Array)
			for let (_, item) in node.items {
				out.push(new Value(item))
			}
			return out
		}

		// A Map's entries, keys as written; empty for anything else.
		def entries() (string, Value)[] {
			let out (string, Value)[] = []
			return out unless node.kind == int(ValueKind.Map)
			for let (i, key) in node.keys {
				out.push((key, new Value(node.vals[i])))
			}
			return out
		}

		// A Struct's fields, name and value, in the order the stream carried
		// them; empty for anything else.
		def fields() (string, Value)[] {
			let out (string, Value)[] = []
			return out unless node.kind == int(ValueKind.Struct)
			for let (i, key) in node.keys {
				out.push((key, new Value(node.vals[i])))
			}
			return out
		}

		// The named field of a Struct or the named entry of a Map; none when
		// there is no such name.
		def field(name string) ?Value {
			let container = node.kind == int(ValueKind.Struct) || node.kind == int(ValueKind.Map)
			return none unless container
			for let (i, key) in node.keys {
				return new Value(node.vals[i]) when key == name
			}
			return none
		}

		// A readable dump of the value and everything under it: `none`, a
		// number, a quoted string, `0x…` bytes, `[…]`, `{"k": v}`, and
		// `Type{field: v}` or `Type(3)` for an object and an enum member.
		def str() string {
			match ValueKind(node.kind) {
				case ValueKind.None:
					return "none"
				case ValueKind.Bool:
					return node.b ?? ("true", "false")
				case ValueKind.Int:
					return node.i.str()
				case ValueKind.Uint:
					return node.u.str()
				case ValueKind.Float:
					return node.f.str()
				case ValueKind.String:
					return quote(node.s)
				case ValueKind.Bytes:
					return node.name == "" ?? ("0x" + node.raw.hex(), node.name + "(0x" + node.raw.hex() + ")")
				case ValueKind.Array:
					let out = "["
					for let (i, item) in node.items {
						out += ", " when i > 0
						out += (new Value(item)).str()
					}
					return out + "]"
				case ValueKind.Map:
					let out = "\u007B"
					for let (i, key) in node.keys {
						out += ", " when i > 0
						out += quote(key) + ": " + (new Value(node.vals[i])).str()
					}
					return out + "\u007D"
				case ValueKind.Struct:
					let out = node.name + "\u007B"
					for let (i, key) in node.keys {
						out += ", " when i > 0
						out += key + ": " + (new Value(node.vals[i])).str()
					}
					return out + "\u007D"
				default:
					return node.name + "(" + node.i.str() + ")"
			}
		}
	}

	// One field of a type, as a stream's description records it.
	internal struct BinField {
		id       int
		name     string
		kind     int
		optional bool
	}

	// One type, as a stream describes it.
	internal struct BinDesc {
		name   string
		form   int
		fields BinField[]
	}

	// Builds one stream: the header, then one tagged value per encode.
	internal type BinOut {
		buf     byte[]           = []
		ids     map<string, int>
		started bool             = false

		def new() {
			ids = map<string, int>{}
		}

		// Drops what was written, keeping the header and the types the stream
		// has already described.
		def reset() {
			buf = byte[]
		}

		// Writes the stream header, once.
		def start() {
			return when started
			started = true
			putRaw(binMagic.bytes())
			putByte(binVersion)
		}

		def putByte(v int) {
			buf.push(byte(v & 0xFF))
		}

		def putRaw(data byte[]) {
			buf = buf + data
		}

		// Writes an unsigned LEB128 varint: seven bits per byte, low group
		// first, the top bit set on every byte but the last.
		def putUint(v uint) {
			let rest = v
			for {
				let group = int(rest & 0x7F)
				rest = rest >> 7
				if rest == 0 {
					putByte(group)
					return
				}
				putByte(group | 0x80)
			}
		}

		// Writes a signed integer, zigzagged so small magnitudes stay short.
		def putSint(v int) {
			putUint(binZigzag(v))
		}

		def putBytes(data byte[]) {
			putUint(uint(data.len()))
			putRaw(data)
		}

		def putText(text string) {
			putBytes(text.bytes())
		}

		// Writes a float as IEEE 754 binary64, least significant byte first.
		def putFloat(v float) {
			let bits = binFloatBits(v)
			for let i = 0; i < 8; i++ {
				putByte(int((bits >> (i * 8)) & 0xFF))
			}
		}

		// Writes a reference to a type: its id when the stream has described
		// it already, otherwise 0 and the description, which takes the next id.
		def putType(d BinDesc) {
			let known = ids.get(d.name)
			if known is none {
				ids[d.name] = ids.len() + 1
			} else {
				putUint(uint(known))
				return
			}
			putUint(0)
			putByte(d.form)
			putText(d.name)
			return unless d.form == binFormStruct
			putUint(uint(d.fields.len()))
			for let (_, f) in d.fields {
				putUint(uint((f.id * 32) + (f.optional ?? (binOptionalBit, 0)) + f.kind))
				putText(f.name)
			}
		}
	}

	// A reader that is always at its end, so a stream over bytes needs no
	// separate case.
	internal type BinNullReader {
		// read implements std.io.Reader and always reports the end of the
		// stream. It cannot fail; the error type comes from io.Reader.
		def read(buf byte[]) !int {
			return 0
		}
	}

	// Reads one stream: the header, the types it describes, and its values.
	internal type BinIn {
		src   byte[]    = []
		pos   int       = 0
		from  io.Reader
		live  bool      = false
		begun bool      = false
		descs BinDesc[] = []

		def new(data byte[]) {
			src = data
			live = false
			from = new BinNullReader()
		}

		def new(reader io.Reader) {
			from = reader
			live = true
		}

		// Reads and checks the stream header, once. Fails when the bytes do
		// not open a binary stream or the version is not the one this codec
		// writes.
		def start() !none {
			return none when begun
			let head = readRaw(4) onerror recover byte[]
			fail "binary: not a binary stream" when head.len() != 4 || string(head) != binMagic
			let version = try readByte()
			fail "binary: stream version {version} is not {binVersion}" unless version == binVersion
			begun = true
			return none
		}

		// Reports whether another value follows, pulling from a live reader to
		// find out.
		def more() bool {
			return true when pos < src.len()
			return false unless live
			return fill() > 0
		}

		// Appends the next chunk a live reader yields and returns how many
		// bytes it added.
		internal def fill() int {
			let chunk byte[]
			chunk.len(4096)
			let got = from.read(chunk) onerror recover 0
			return 0 when got <= 0
			src = src + chunk.slice(0, got)
			return got
		}

		// Makes sure n more bytes are buffered. Fails at the end of the stream.
		def want(n int) !none {
			for src.len() - pos < n {
				fail "binary: the stream ends mid-value" unless live
				fail "binary: the stream ends mid-value" when fill() == 0
			}
			return none
		}

		def readByte() !int {
			try want(1)
			let out = int(src[pos])
			pos = pos + 1
			return out
		}

		def readRaw(n int) !byte[] {
			expects {
				assert n >= 0 onerror fail "binary: a length of {n} is not a length"
			}
			try want(n)
			let out = src.slice(pos, n)
			pos = pos + n
			return out
		}

		// Reads an unsigned LEB128 varint. Fails when it runs past ten bytes,
		// which no 64-bit value needs.
		def readUint() !uint {
			let out uint = 0
			let shift = 0
			for {
				fail "binary: a varint runs past ten bytes" when shift > 63
				let group = try readByte()
				out = out | (uint(group & 0x7F) << shift)
				return out when group < 0x80
				shift = shift + 7
			}
			fail "binary: a varint runs past ten bytes"
		}

		// Reads a zigzagged signed integer. Fails the same way readUint does.
		def readSint() !int {
			return binUnzigzag(try readUint())
		}

		def readBytes() !byte[] {
			let n = try readUint()
			return try readRaw(int(n))
		}

		def readText() !string {
			return string(try readBytes())
		}

		// Reads a float from its IEEE 754 binary64 bytes. Fails at the end of
		// the stream.
		def readFloat() !float {
			let raw = try readRaw(8)
			let bits uint = 0
			for let i = 0; i < 8; i++ {
				bits = bits | (uint(raw[i]) << (i * 8))
			}
			return binFloatFromBits(bits)
		}

		// Reads a reference to a type, taking in the description when the
		// stream carries one here. Fails on a description this codec does not
		// know or a reference to a type the stream never described.
		def readType() !BinDesc {
			let ref = int(try readUint())
			if ref > 0 {
				fail "binary: the stream refers to type {ref}, which it never described" when ref > descs.len()
				return descs[ref - 1]
			}

			let form = try readByte()
			fail "binary: a type description says {form}, which this codec does not know" when form < binFormStruct || form > binFormCustom
			let d = BinDesc{name: try readText(), form: form, fields: []}
			if form == binFormStruct {
				let count = int(try readUint())
				fail "binary: a type description claims {count} fields" when count < 0 || count > 4096
				for let i = 0; i < count; i++ {
					let packed = int(try readUint())
					d.fields.push(BinField{
						id: packed / 32,
						name: try readText(),
						kind: packed & 0x0F,
						optional: (packed & binOptionalBit) != 0
					})
				}
			}
			descs.push(d)
			return d
		}
	}

	// Maps a signed value onto an unsigned one that keeps small magnitudes
	// short: 0, -1, 1, -2 become 0, 1, 2, 3.
	internal def binZigzag(v int) uint {
		return uint(v) * 2 when v >= 0
		return (uint(-(v + 1)) * 2) + 1
	}

	// The signed value binZigzag made this from.
	internal def binUnzigzag(v uint) int {
		return int(v >> 1) when (v & 1) == 0
		return -int((v - 1) >> 1) - 1
	}

	// 2 to the 52nd, the width of a binary64 significand.
	internal const binMantissaScale = 4503599627370496.0

	// The largest finite binary64.
	internal const binMaxFinite = 1.7976931348623157e308

	// Reports whether v is not a number, the one value that is not equal to
	// itself.
	internal def binIsNaN(v float) bool {
		let same = v
		return same != v
	}

	// The IEEE 754 binary64 bits of v.
	internal def binFloatBits(v float) uint {
		return 0x7FF8000000000000 when binIsNaN(v)
		let sign uint = 0
		let m = v
		if m < 0.0 {
			sign = 1
			m = -m
		}
		return sign << 63 when m == 0.0
		return (sign << 63) | 0x7FF0000000000000 when m > binMaxFinite

		let e = 0
		for m >= 2.0 {
			m = m / 2.0
			e = e + 1
		}
		for m < 1.0 && e > -1022 {
			m = m * 2.0
			e = e - 1
		}
		// Below the smallest normal there is no implicit leading one and the
		// exponent stays pinned, so the significand carries the rest.
		return (sign << 63) | uint(m * binMantissaScale) when m < 1.0
		return (sign << 63) | (uint(e + 1023) << 52) | uint((m - 1.0) * binMantissaScale)
	}

	// The float whose IEEE 754 binary64 bits are `bits`.
	internal def binFloatFromBits(bits uint) float {
		let biased = int((bits >> 52) & 0x7FF)
		let mant = bits & 0xFFFFFFFFFFFFF
		let negative = (bits >> 63) != 0
		if biased == 2047 {
			let huge = binInfinity()
			return huge - huge when mant != 0
			return negative ?? (-huge, huge)
		}
		let frac = float(mant) / binMantissaScale
		let out = binScale(biased == 0 ?? (frac, 1.0 + frac), biased == 0 ?? (-1022, biased - 1023))
		return negative ?? (-out, out)
	}

	// m scaled by two to the e, by halving or doubling so no bit is lost.
	internal def binScale(m float, e int) float {
		let out = m
		let left = e
		for left > 0 {
			out = out * 2.0
			left = left - 1
		}
		for left < 0 {
			out = out / 2.0
			left = left + 1
		}
		return out
	}

	// Positive infinity, overflowed at run time so no literal has to spell it.
	internal def binInfinity() float {
		let out = binMaxFinite
		for let i = 0; i < 4; i++ {
			out = out * 10.0
		}
		return out
	}

	// The wire id of a field: `@binary(id: N)` when it names one, otherwise
	// the field's 1-based place in the declaration.
	internal def binFieldId(f Field, position int) int {
		let text = f.attr(binaryAttr, "id")
		return position when text == ""
		let id = parseInt<int>(text)
		return position when id <= 0
		return id
	}

	// The name a field travels under: `@binary(name: "x")` when it names one,
	// otherwise the declared name.
	internal def binFieldName(f Field) string {
		let explicit = f.attr(binaryAttr, "name")
		return explicit when explicit != ""
		return f.name
	}

	// Reports whether `@binary(ignore: true)` leaves the field out.
	internal def binIgnored(f Field) bool {
		return f.attr(binaryAttr, "ignore") == "true"
	}

	// Reports whether a field is a `byte[]`, which travels as Bytes rather
	// than as an array of numbers.
	internal def binIsByteArray(f Field) bool {
		return f.elemKind == FieldKind.Uint && f.typeName == "byte[]"
	}

	// What a description records a field as, so a reader without the type can
	// name and skip it.
	internal def binWireKind(f Field) int {
		match f.kind {
			case FieldKind.Bool:
				return int(ValueKind.Bool)
			case FieldKind.Int:
				return int(ValueKind.Int)
			case FieldKind.Uint:
				return int(ValueKind.Uint)
			case FieldKind.Float:
				return int(ValueKind.Float)
			case FieldKind.String:
				return int(ValueKind.String)
			case FieldKind.Array:
				return binIsByteArray(f) ?? (int(ValueKind.Bytes), int(ValueKind.Array))
			case FieldKind.Map:
				return int(ValueKind.Map)
			case FieldKind.Struct:
				return int(ValueKind.Struct)
			case FieldKind.Iface:
				return binKindAny
			case FieldKind.Optional:
				return binKindOfTypeName(f.typeName.trimPrefix("?"))
			default:
				return int(ValueKind.Enum)
		}
	}

	// The kind a declared type name maps to, for the types an optional can
	// wrap; anything else reads as `any`.
	internal def binKindOfTypeName(name string) int {
		match name {
			case "bool":
				return int(ValueKind.Bool)
			case "int", "int8", "int16", "int32", "int64":
				return int(ValueKind.Int)
			case "uint", "uint8", "uint16", "uint32", "uint64", "byte":
				return int(ValueKind.Uint)
			case "float", "float32", "float64":
				return int(ValueKind.Float)
			case "string":
				return int(ValueKind.String)
			case "byte[]":
				return int(ValueKind.Bytes)
			default:
				return binKindAny
		}
	}

	// The name of a wire kind, for error messages.
	internal def binKindName(kind int) string {
		return "a value written by its own type" when kind == binTagCustom
		match ValueKind(kind) {
			case ValueKind.None:
				return "none"
			case ValueKind.Bool:
				return "a bool"
			case ValueKind.Int:
				return "an integer"
			case ValueKind.Uint:
				return "a whole number"
			case ValueKind.Float:
				return "a float"
			case ValueKind.String:
				return "a string"
			case ValueKind.Bytes:
				return "bytes"
			case ValueKind.Array:
				return "an array"
			case ValueKind.Map:
				return "a map"
			case ValueKind.Struct:
				return "an object"
			default:
				return "an enum member"
		}
	}

	// Writes any value: a BinaryEncoder through its own bytes, an object
	// through its fields, and a scalar, array or map through the runtime's
	// view of the box.
	internal def binWriteValue(w BinOut, obj any, depth int) {
		match obj {
			case BinaryEncoder:
				w.putByte(binTagCustom)
				w.putType(BinDesc{name: reflection.typeName(obj), form: binFormCustom, fields: []})
				w.putBytes(obj.encodeBinary())
				return
			default:
		}

		if depth >= binMaxDepth {
			w.putByte(int(ValueKind.None))
			return
		}

		match reflection.kindOf(obj) {
			case FieldKind.Bool:
				w.putByte(int(ValueKind.Bool))
				w.putByte(reflection.scalarText(obj) == "true" ?? (1, 0))
			case FieldKind.Int:
				w.putByte(int(ValueKind.Int))
				w.putSint(parseInt<int>(reflection.scalarText(obj)))
			case FieldKind.Uint:
				w.putByte(int(ValueKind.Uint))
				w.putUint(parseInt<uint>(reflection.scalarText(obj)))
			case FieldKind.Float:
				w.putByte(int(ValueKind.Float))
				w.putFloat(parseFloat<float>(reflection.scalarText(obj)))
			case FieldKind.String:
				w.putByte(int(ValueKind.String))
				w.putText(reflection.scalarText(obj))
			case FieldKind.Array:
				binWriteBoxedArray(w, obj, depth)
			case FieldKind.Map:
				binWriteBoxedMap(w, obj, depth)
			case FieldKind.Struct:
				binWriteStruct(w, obj, depth)
			default:
				w.putByte(int(ValueKind.None))
		}
	}

	// Writes an array carried as `any`: a `byte[]` as Bytes, anything else as
	// an array of tagged values.
	internal def binWriteBoxedArray(w BinOut, obj any, depth int) {
		let items = reflection.elements(obj)
		if reflection.typeName(obj) == "byte[]" {
			let data byte[]
			data.len(items.len())
			for let (i, e) in items {
				data[i] = byte(parseInt<uint>(reflection.scalarText(e)))
			}
			w.putByte(int(ValueKind.Bytes))
			w.putBytes(data)
			return
		}
		w.putByte(int(ValueKind.Array))
		w.putUint(uint(items.len()))
		for let (_, e) in items {
			binWriteValue(w, e, depth + 1)
		}
	}

	// Writes a string-keyed map carried as `any`. A map reflection cannot
	// reach by string key writes as empty.
	internal def binWriteBoxedMap(w BinOut, obj any, depth int) {
		let keys = reflection.keysOf(obj)
		w.putByte(int(ValueKind.Map))
		w.putUint(uint(keys.len()))
		for let (_, key) in keys {
			w.putText(key)
			let e = reflection.entryOf(obj, key)
			if e is none {
				w.putByte(int(ValueKind.None))
			} else {
				binWriteValue(w, e, depth + 1)
			}
		}
	}

	// Writes an object: its description the first time the stream carries the
	// type, then `(field id, value)` pairs ended by field id 0.
	internal def binWriteStruct(w BinOut, obj any, depth int) {
		let all = reflection.fields(obj)
		let d = BinDesc{name: reflection.typeName(obj), form: binFormStruct, fields: []}
		let sent Field[] = []
		let numbers int[] = []
		for let (i, f) in all {
			continue when binIgnored(f)
			let id = binFieldId(f, i + 1)
			d.fields.push(BinField{
				id: id,
				name: binFieldName(f),
				kind: binWireKind(f),
				optional: f.kind == FieldKind.Optional
			})
			sent.push(f)
			numbers.push(id)
		}

		w.putByte(int(ValueKind.Struct))
		w.putType(d)
		for let (i, f) in sent {
			w.putUint(uint(numbers[i]))
			binWriteField(w, f, depth)
		}
		w.putUint(0)
	}

	// Writes one field's value.
	internal def binWriteField(w BinOut, f Field, depth int) {
		if depth >= binMaxDepth {
			w.putByte(int(ValueKind.None))
			return
		}
		match f.kind {
			case FieldKind.Bool:
				w.putByte(int(ValueKind.Bool))
				w.putByte(f.asBool() ?? (1, 0))
			case FieldKind.Int:
				w.putByte(int(ValueKind.Int))
				w.putSint(f.asInt())
			case FieldKind.Uint:
				w.putByte(int(ValueKind.Uint))
				w.putUint(f.asUint())
			case FieldKind.Float:
				w.putByte(int(ValueKind.Float))
				w.putFloat(f.asFloat())
			case FieldKind.String:
				w.putByte(int(ValueKind.String))
				w.putText(f.asString())
			case FieldKind.Array:
				binWriteArray(w, f, depth)
			case FieldKind.Map:
				binWriteMap(w, f, depth)
			case FieldKind.Struct, FieldKind.Iface:
				let nested = f.value()
				if nested is none {
					w.putByte(int(ValueKind.None))
				} else {
					binWriteValue(w, nested, depth + 1)
				}
			case FieldKind.Optional:
				// std.reflection reaches neither the flag nor the value of an
				// optional field, so the stream says the field is absent.
				w.putByte(int(ValueKind.None))
			default:
				w.putByte(int(ValueKind.Enum))
				w.putType(BinDesc{name: f.typeName, form: binFormEnum, fields: []})
				w.putSint(f.asInt())
		}
	}

	// Writes an array field: a `byte[]` as Bytes, anything else as an array of
	// tagged values.
	internal def binWriteArray(w BinOut, f Field, depth int) {
		let n = f.len()
		if binIsByteArray(f) {
			let data byte[]
			data.len(n)
			for let i = 0; i < n; i++ {
				data[i] = byte(f.at(i).asUint())
			}
			w.putByte(int(ValueKind.Bytes))
			w.putBytes(data)
			return
		}
		w.putByte(int(ValueKind.Array))
		w.putUint(uint(n))
		for let i = 0; i < n; i++ {
			binWriteElem(w, f.at(i), f.elemKind, depth)
		}
	}

	// Writes a `map<string, V>` field, entries in insertion order. A map
	// reflection cannot reach by string key writes as empty.
	internal def binWriteMap(w BinOut, f Field, depth int) {
		let keys = f.keys()
		w.putByte(int(ValueKind.Map))
		w.putUint(uint(keys.len()))
		for let (_, key) in keys {
			w.putText(key)
			binWriteElem(w, f.entry(key), f.elemKind, depth)
		}
	}

	// Writes one element of an array field or one entry of a map field: a
	// scalar by its kind, anything else through its boxed value.
	internal def binWriteElem(w BinOut, e Field, kind FieldKind, depth int) {
		match kind {
			case FieldKind.Bool:
				w.putByte(int(ValueKind.Bool))
				w.putByte(e.asBool() ?? (1, 0))
			case FieldKind.Int:
				w.putByte(int(ValueKind.Int))
				w.putSint(e.asInt())
			case FieldKind.Uint:
				w.putByte(int(ValueKind.Uint))
				w.putUint(e.asUint())
			case FieldKind.Float:
				w.putByte(int(ValueKind.Float))
				w.putFloat(e.asFloat())
			case FieldKind.String:
				w.putByte(int(ValueKind.String))
				w.putText(e.asString())
			default:
				let nested = e.value()
				if nested is none {
					w.putByte(int(ValueKind.None))
				} else {
					binWriteValue(w, nested, depth + 1)
				}
		}
	}

	// Reads one tagged value and everything under it. Fails on a tag this
	// codec does not know, a stream that ends mid-value, or nesting past
	// binMaxDepth.
	internal def binReadNode(r BinIn, depth int) !BinNode {
		expects {
			assert depth < binMaxDepth onerror fail "binary: the stream nests deeper than {binMaxDepth} values"
		}
		let tag = try r.readByte()
		let out = new BinNode()

		if tag == binTagCustom {
			let d = try r.readType()
			out.kind = int(ValueKind.Bytes)
			out.name = d.name
			out.raw = try r.readBytes()
			return out
		}

		fail "binary: tag {tag} is not a value this codec knows" when tag < 0 || tag > int(ValueKind.Enum)
		out.kind = tag
		match ValueKind(tag) {
			case ValueKind.None:
			case ValueKind.Bool:
				out.b = (try r.readByte()) != 0
			case ValueKind.Int:
				out.i = try r.readSint()
			case ValueKind.Uint:
				out.u = try r.readUint()
			case ValueKind.Float:
				out.f = try r.readFloat()
			case ValueKind.String:
				out.s = try r.readText()
			case ValueKind.Bytes:
				out.raw = try r.readBytes()
			case ValueKind.Array:
				let count = int(try r.readUint())
				fail "binary: an array claims {count} elements" when count < 0
				for let i = 0; i < count; i++ {
					out.items.push(try binReadNode(r, depth + 1))
				}
			case ValueKind.Map:
				let count = int(try r.readUint())
				fail "binary: a map claims {count} entries" when count < 0
				for let i = 0; i < count; i++ {
					out.keys.push(try r.readText())
					out.vals.push(try binReadNode(r, depth + 1))
				}
			case ValueKind.Struct:
				let d = try r.readType()
				fail "binary: {d.name} is not an object" unless d.form == binFormStruct
				out.name = d.name
				for {
					let id = int(try r.readUint())
					break when id == 0
					let child = try binReadNode(r, depth + 1)
					let at = binDescIndexOf(d, id)
					out.ids.push(id)
					out.keys.push(at < 0 ?? ("field{id}", d.fields[at].name))
					out.kinds.push(at < 0 ?? (child.kind, d.fields[at].kind))
					out.opts.push(at < 0 ?? (false, d.fields[at].optional))
					out.vals.push(child)
				}
			default:
				let d = try r.readType()
				fail "binary: {d.name} is not an enum" unless d.form == binFormEnum
				out.name = d.name
				out.i = try r.readSint()
		}
		return out
	}

	// Where a description records the field with this id, or -1.
	internal def binDescIndexOf(d BinDesc, id int) int {
		for let (i, f) in d.fields {
			return i when f.id == id
		}
		return -1
	}

	// Where a decoded object carries the field with this id, or -1.
	internal def binNodeIndexOf(n BinNode, id int) int {
		for let (i, got) in n.ids {
			return i when got == id
		}
		return -1
	}

	internal def binNodeInt(n BinNode) int {
		match ValueKind(n.kind) {
			case ValueKind.Int, ValueKind.Enum:
				return n.i
			case ValueKind.Uint:
				return int(n.u)
			case ValueKind.Float:
				return int(n.f)
			case ValueKind.Bool:
				return n.b ?? (1, 0)
			default:
				return 0
		}
	}

	internal def binNodeUint(n BinNode) uint {
		match ValueKind(n.kind) {
			case ValueKind.Uint:
				return n.u
			case ValueKind.Int, ValueKind.Enum:
				return uint(n.i)
			case ValueKind.Float:
				return uint(n.f)
			case ValueKind.Bool:
				return n.b ?? (1, 0)
			default:
				return 0
		}
	}

	internal def binNodeFloat(n BinNode) float {
		match ValueKind(n.kind) {
			case ValueKind.Float:
				return n.f
			case ValueKind.Int, ValueKind.Enum:
				return float(n.i)
			case ValueKind.Uint:
				return float(n.u)
			case ValueKind.Bool:
				return n.b ?? (1.0, 0.0)
			default:
				return 0.0
		}
	}

	internal def binNodeText(n BinNode) string {
		match ValueKind(n.kind) {
			case ValueKind.String:
				return n.s
			case ValueKind.Bytes:
				return string(n.raw)
			case ValueKind.Bool:
				return n.b ?? ("true", "false")
			case ValueKind.Int, ValueKind.Enum:
				return n.i.str()
			case ValueKind.Uint:
				return n.u.str()
			case ValueKind.Float:
				return n.f.str()
			default:
				return ""
		}
	}

	internal def binNodeBytes(n BinNode) byte[] {
		return n.raw when n.kind == int(ValueKind.Bytes)
		return n.s.bytes() when n.kind == int(ValueKind.String)
		return byte[]
	}

	// Fills target from a decoded value: a BinaryDecoder from the bytes its
	// encoder wrote, anything else field by field, matching on wire ids. A
	// field the target does not have is skipped, and a field the stream does
	// not carry keeps its zero value. Fails when the value is not an object,
	// or when one of its fields does not fit.
	internal def binBind(n BinNode, target any) !none {
		match target {
			case BinaryDecoder:
				fail "binary: {reflection.typeName(target)} reads itself from bytes, but the stream holds {binKindName(n.kind)}" unless n.kind == int(ValueKind.Bytes)
				return try target.decodeBinary(n.raw)
			default:
		}

		fail "binary: cannot read {binKindName(n.kind)} into {reflection.typeName(target)}" unless n.kind == int(ValueKind.Struct)
		for let (i, f) in reflection.fields(target) {
			continue when binIgnored(f)
			let at = binNodeIndexOf(n, binFieldId(f, i + 1))
			continue when at < 0
			try binBindField(n.vals[at], f)
		}
		return none
	}

	// Stores one decoded value in one field.
	internal def binBindField(n BinNode, f Field) !none {
		return none when n.kind == int(ValueKind.None)
		match f.kind {
			case FieldKind.Array:
				return try binBindArray(n, f)
			case FieldKind.Map:
				return try binBindMap(n, f)
			case FieldKind.Struct:
				let nested = f.ensureValue()
				fail "binary: cannot read an object into `{f.name}`" when nested is none
				return try binBind(n, nested)
			case FieldKind.Iface:
				// std.reflection has no way to store into a field declared
				// `any`; `Binary.inspect` is how to see what the stream carried.
				return none
			case FieldKind.Optional:
				// std.reflection has no way to store into an optional field.
				return none
			default:
				binSetScalar(f, f.kind, n)
				return none
		}
	}

	// Stores a decoded scalar in a field, an array element or a map entry.
	// A kind with no scalar of its own takes the value's integer, which is
	// what an enum member's ordinal is.
	internal def binSetScalar(f Field, kind FieldKind, n BinNode) {
		match kind {
			case FieldKind.Bool:
				f.setBool(binNodeInt(n) != 0)
			case FieldKind.Uint:
				f.setUint(binNodeUint(n))
			case FieldKind.Float:
				f.setFloat(binNodeFloat(n))
			case FieldKind.String:
				f.setString(binNodeText(n))
			default:
				f.setInt(binNodeInt(n))
		}
	}

	// Fills an array field. Fails when the stream holds something else, or
	// when the field is an array of objects the target has not already sized:
	// std.reflection can size an array of scalars and no other.
	internal def binBindArray(n BinNode, f Field) !none {
		if binIsByteArray(f) {
			let data = binNodeBytes(n)
			fail "binary: cannot size `{f.name}`" unless f.setLen(data.len())
			for let (i, one) in data {
				f.at(i).setUint(uint(one))
			}
			return none
		}

		fail "binary: cannot read {binKindName(n.kind)} into the array `{f.name}`" unless n.kind == int(ValueKind.Array)
		let want = n.items.len()
		let kind = f.elemKind
		let scalar = kind == FieldKind.Bool || kind == FieldKind.Int || kind == FieldKind.Uint || kind == FieldKind.Float || kind == FieldKind.String
		if scalar {
			fail "binary: cannot size `{f.name}`" unless f.setLen(want)
			for let i = 0; i < want; i++ {
				binSetScalar(f.at(i), kind, n.items[i])
			}
			return none
		}

		if f.len() != want {
			fail "binary: `{f.name}` holds {f.len()} of the {want} values the stream carries, and std.reflection cannot resize an array of objects: size the field before decoding" unless f.setLen(want)
		}
		for let i = 0; i < want; i++ {
			let e = f.at(i).value()
			fail "binary: `{f.name}[{i}]` has no value to fill" when e is none
			try binBind(n.items[i], e)
		}
		return none
	}

	// Fills a `map<string, V>` field, replacing what it held. Fails when the
	// stream holds something else, or when the map is not keyed by string.
	internal def binBindMap(n BinNode, f Field) !none {
		expects {
			assert n.kind == int(ValueKind.Map) onerror fail "binary: cannot read {binKindName(n.kind)} into the map `{f.name}`"
			assert f.typeName.startsWith("map<string") onerror fail "binary: map keys must be strings, and `{f.name}` is {f.typeName}"
		}
		f.clear()
		let kind = f.elemKind
		for let (i, key) in n.keys {
			let child = n.vals[i]
			let entry = f.entry(key)
			if kind == FieldKind.Struct {
				let nested = entry.ensureValue()
				fail "binary: cannot read an object into `{f.name}[{key}]`" when nested is none
				try binBind(child, nested)
			} else {
				binSetScalar(entry, kind, child)
			}
		}
		return none
	}

	// Controls how a field is laid out by Layout and carried by Binary.
	//
	// id pins the field's number in Binary streams (declaration order by default); name renames
	// it there. ignore leaves the field out of both. size fixes the width in bytes of a byte[] or
	// string field in a Layout, zero-padded; count fixes the element count of an array field;
	// pad inserts that many zero bytes before the field.
	meta def binary(ctx FieldMetaContext, id int = 0, name string = "", ignore bool = false, size int = 0, count int = 0, pad int = 0) {
		// read by the codecs through reflection
	}
}
