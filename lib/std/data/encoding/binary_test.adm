partial module std.data.encoding {
	use (
		std.testing
		std.bytes
	)

	// Fixtures. Each exercises one part of the wire format, so a failure names
	// the feature rather than "Binary is broken".
	//
	// All `internal`: a fixture that is exported becomes part of
	// std.data.encoding's public API.

	internal struct BinScalars {
		flag  bool
		n     int
		small int32
		big   uint64
		ratio float
		half  float32
		text  string
		blob  byte[]
	}

	internal struct BinPoint {
		x int
		y int
	}

	internal struct BinNested {
		name string
		at   BinPoint
	}

	internal struct BinList {
		tags  string[]
		nums  int[]
		spots BinPoint[]
	}

	internal struct BinMaps {
		counts map<string, int>
		spots  map<string, BinPoint>
	}

	internal enum BinColor {
		Red,
		Green,
		Blue
	}

	internal struct BinEnumHolder {
		shade BinColor
	}

	internal struct BinOptional {
		note ?string
		n    ?int
	}

	// Two views of the same wire shape: the same ids in a different
	// declaration order.
	internal struct BinOrderA {
		@binary(id: 1)
		first string
		@binary(id: 2)
		second int
	}

	internal struct BinOrderB {
		@binary(id: 2)
		second int
		@binary(id: 1)
		first string
	}

	// The same type before and after it grew a field.
	internal struct BinGrownSmall {
		a int
		b string
	}

	internal struct BinGrownBig {
		a int
		b string
		c int
	}

	internal struct BinIgnores {
		@binary(ignore: true)
		secret string
		kept int
	}

	internal struct BinRenamed {
		@binary(name: "identifier")
		id int
	}

	internal struct BinThree {
		a int
		b int
		c int
	}

	// A type that writes itself: four bytes, most significant first.
	internal type BinStamp {
		value int = 0

		def new(v int = 0) {
			value = v
		}

		// encodeBinary implements BinaryEncoder.
		def encodeBinary() byte[] {
			let out byte[]
			out.len(4)
			for let i = 0; i < 4; i++ {
				out[i] = byte((value >> ((3 - i) * 8)) & 0xFF)
			}
			return out
		}

		// decodeBinary implements BinaryDecoder. Fails on anything but four bytes.
		def decodeBinary(data byte[]) !none {
			expects {
				assert data.len() == 4 onerror fail "stamp: expected four bytes, found {data.len()}"
			}
			value = 0
			for let (_, one) in data {
				value = (value << 8) | int(one)
			}
			return none
		}
	}

	internal struct BinStamped {
		label string
		mark  BinStamp
	}

	// Reports whether decoding these bytes into a fresh point refuses them
	// with a message this codec wrote.
	internal def binRefuses(data byte[]) bool {
		let codec = new Binary()
		let failed = false
		codec.decode(data, BinPoint{}) onerror (err error) {
			failed = err.message.startsWith("binary: ")
			recover none
		}
		return failed
	}

	check "Binary" {
		@test()
		def TestScalarRoundTrip() !none {
			let codec = new Binary()
			let src = BinScalars{
				flag: true,
				n: -1234567,
				small: -2147483648,
				big: 18446744073709551615,
				ratio: -3.25,
				half: 1.5,
				text: "",
				blob: byte[0, 255, 16]
			}
			let out = BinScalars{}
			try codec.decode(codec.encode(src), out)

			assert out.flag
			assert out.n == -1234567
			assert out.small == -2147483648
			assert out.big == 18446744073709551615
			assert out.ratio == -3.25
			assert out.half == 1.5
			assert out.text == ""
			assert out.blob.len() == 3 && out.blob[1] == 255
		}

		@test()
		def TestFloatBits() !none {
			// The float path goes through the IEEE 754 bits, so check the
			// values that exercise every part of them.
			for let one in [0.0, 1.0, -1.0, 0.5, -0.5, 3.141592653589793, 1.0e-300, 1.0e300, 2.2250738585072014e-308] {
				assert binFloatFromBits(binFloatBits(one)) == one
			}
			assert binFloatBits(0.0) == 0
			assert binFloatBits(1.0) == 4607182418800017408
			assert binFloatBits(-2.0) == 13835058055282163712
		}

		@test()
		def TestNestedStructs() !none {
			let codec = new Binary()
			let out = BinNested{}
			try codec.decode(codec.encode(BinNested{name: "origin", at: BinPoint{x: 4, y: -5}}), out)
			assert out.name == "origin"
			assert out.at.x == 4 && out.at.y == -5
		}

		@test()
		def TestArrays() !none {
			let codec = new Binary()
			let src = BinList{
				tags: ["a", "b"],
				nums: [1, -2, 3],
				spots: [BinPoint{x: 1, y: 2}, BinPoint{x: 3, y: 4}]
			}
			// std.reflection can size an array of scalars and no other, so a
			// target that takes objects back carries as many as the stream does.
			let out = BinList{spots: [BinPoint{}, BinPoint{}]}
			try codec.decode(codec.encode(src), out)

			assert out.tags.len() == 2 && out.tags[1] == "b"
			assert out.nums.len() == 3 && out.nums[1] == -2
			assert out.spots.len() == 2
			assert out.spots[0].x == 1 && out.spots[1].y == 4
		}

		@test()
		def TestMaps() !none {
			let codec = new Binary()
			let src = BinMaps{counts: map<string, int>{}, spots: map<string, BinPoint>{}}
			src.counts["one"] = 1
			src.counts["two"] = 2
			src.spots["home"] = BinPoint{x: 7, y: 8}

			let out = BinMaps{counts: map<string, int>{}, spots: map<string, BinPoint>{}}
			try codec.decode(codec.encode(src), out)

			assert out.counts.len() == 2
			assert out.counts.hasKey("one") && out.counts.hasKey("two")
			let one = out.counts.get("one")
			if one is none {
				assert false
			} else {
				assert one == 1
			}
			assert out.spots.len() == 1
			let home = out.spots.get("home")
			if home is none {
				assert false
			} else {
				assert home.x == 7 && home.y == 8
			}
		}

		@test()
		def TestEnums() !none {
			let codec = new Binary()
			let data = codec.encode(BinEnumHolder{shade: BinColor.Blue})
			let out = BinEnumHolder{}
			try codec.decode(data, out)
			assert out.shade == BinColor.Blue

			// An enum travels as its type name and its member's ordinal:
			// std.reflection does not reach the member names.
			let v = (try codec.inspect(data))[0]
			let shade = v.field("shade")
			if shade is none {
				assert false
			} else {
				assert shade.kind == ValueKind.Enum
				assert shade.typeName == "BinColor"
				assert shade.asInt() == 2
			}
		}

		@test()
		def TestOptionalsTravelAsAbsent() !none {
			// std.reflection reaches neither the flag nor the value of an
			// optional field, so one travels as absent whether or not it holds
			// a value, and decoding leaves the target's own field alone.
			let codec = new Binary()
			let v = (try codec.inspect(codec.encode(BinOptional{note: "hi", n: 4})))[0]
			assert v.fields().len() == 2
			let note = v.field("note")
			if note is none {
				assert false
			} else {
				assert note.kind == ValueKind.None
			}
		}

		@test()
		def TestPinnedIdsSurviveReordering() !none {
			let codec = new Binary()
			let data = codec.encode(BinOrderA{first: "one", second: 2})
			let out = BinOrderB{}
			try codec.decode(data, out)
			assert out.first == "one"
			assert out.second == 2
		}

		@test()
		def TestGrownType() !none {
			let codec = new Binary()

			// The reader has a field the stream does not carry: it keeps its
			// zero value.
			let grown = BinGrownBig{}
			try codec.decode(codec.encode(BinGrownSmall{a: 1, b: "b"}), grown)
			assert grown.a == 1 && grown.b == "b" && grown.c == 0

			// The stream carries a field the reader does not have: it is
			// skipped, because its own tag says how long it is.
			let old = BinGrownSmall{}
			try codec.decode(codec.encode(BinGrownBig{a: 5, b: "five", c: 6}), old)
			assert old.a == 5 && old.b == "five"
		}

		@test()
		def TestIgnoreAndRename() !none {
			let codec = new Binary()
			let data = codec.encode(BinIgnores{secret: "shh", kept: 3})
			let v = (try codec.inspect(data))[0]
			assert v.fields().len() == 1
			let (name, _) = v.fields()[0]
			assert name == "kept"

			let out = BinIgnores{secret: "kept as is"}
			try codec.decode(data, out)
			assert out.kept == 3 && out.secret == "kept as is"

			let renamed = (try codec.inspect(codec.encode(BinRenamed{id: 8})))[0]
			let (label, value) = renamed.fields()[0]
			assert label == "identifier"
			assert value.asInt() == 8
		}

		@test()
		def TestSelfWritingTypes() !none {
			let codec = new Binary()

			let mark = new BinStamp()
			try codec.decode(codec.encode(new BinStamp(305419896)), mark)
			assert mark.value == 305419896

			let out = BinStamped{mark: new BinStamp()}
			try codec.decode(codec.encode(BinStamped{label: "tag", mark: new BinStamp(66051)}), out)
			assert out.label == "tag"
			assert out.mark.value == 66051

			// A self-writing value travels as bytes under its type name.
			let v = (try codec.inspect(codec.encode(new BinStamp(1))))[0]
			assert v.kind == ValueKind.Bytes
			assert v.typeName == "std.data.encoding.BinStamp"
			assert v.asBytes().len() == 4
		}

		@test()
		def TestStreamOfValues() !none {
			let sink = new bytes.Buffer()
			let enc = new Encoder(sink)
			try enc.encode(BinPoint{x: 1, y: 2})
			try enc.encode(BinPoint{x: 3, y: 4})
			try enc.encode(BinPoint{x: 5, y: 6})

			let dec = new Decoder(new bytes.Buffer(sink.bytes()))
			let first = BinPoint{}
			try dec.decode(first)
			assert first.x == 1 && first.y == 2

			let second = try dec.next()
			if second is none {
				assert false
			} else {
				assert second.asString() == ""
				assert second.kind == ValueKind.Struct
				let x = second.field("x")
				if x is none {
					assert false
				} else {
					assert x.asInt() == 3
				}
			}

			let third = try dec.next()
			assert !(third is none)

			let past = try dec.next()
			assert past is none

			// The header and the description are written once, so the values
			// after the first cost only their own bytes.
			let whole = sink.bytes().len()
			let codec = new Binary()
			let alone = codec.encode(BinPoint{x: 1, y: 2}).len()
			assert whole < alone + 24
		}

		@test()
		def TestInspect() !none {
			let codec = new Binary()
			let data = codec.encode(BinNested{name: "n", at: BinPoint{x: 4, y: 5}})
			let values = try codec.inspect(data)
			assert values.len() == 1

			let v = values[0]
			assert v.kind == ValueKind.Struct
			assert v.typeName == "std.data.encoding.BinNested"

			let all = v.fields()
			assert all.len() == 2
			let (first, text) = all[0]
			assert first == "name" && text.asString() == "n"

			let at = v.field("at")
			if at is none {
				assert false
			} else {
				assert at.typeName == "std.data.encoding.BinPoint"
				let y = at.field("y")
				if y is none {
					assert false
				} else {
					assert y.asInt() == 5
				}
			}
			assert v.field("missing") is none
		}

		@test()
		def TestValueAccessors() !none {
			let codec = new Binary()
			let v = (try codec.inspect(codec.encode(BinScalars{flag: true, big: 9, ratio: 2.5})))[0]

			let flag = v.field("flag")
			if flag is none {
				assert false
			} else {
				assert flag.asBool()
			}
			let big = v.field("big")
			if big is none {
				assert false
			} else {
				assert big.asUint() == 9
			}
			let ratio = v.field("ratio")
			if ratio is none {
				assert false
			} else {
				assert ratio.asFloat() == 2.5
			}

			let list = (try codec.inspect(codec.encode(BinList{tags: ["a", "b"], nums: [4], spots: []})))[0]
			let nums = list.field("nums")
			if nums is none {
				assert false
			} else {
				assert nums.elements().len() == 1
				assert nums.elements()[0].asInt() == 4
				assert nums.entries().len() == 0
			}

			let maps = BinMaps{counts: map<string, int>{}, spots: map<string, BinPoint>{}}
			maps.counts["k"] = 5
			let seen = (try codec.inspect(codec.encode(maps)))[0]
			let counts = seen.field("counts")
			if counts is none {
				assert false
			} else {
				assert counts.kind == ValueKind.Map
				let all = counts.entries()
				assert all.len() == 1
				let (key, value) = all[0]
				assert key == "k" && value.asInt() == 5
				assert counts.elements().len() == 0
			}
		}

		@test()
		def TestValueStr() !none {
			let codec = new Binary()
			let open = "\u007B"
			let close = "\u007D"

			let point = (try codec.inspect(codec.encode(BinPoint{x: 4, y: -5})))[0]
			assert point.str() == "std.data.encoding.BinPoint" + open + "x: 4, y: -5" + close

			let list = (try codec.inspect(codec.encode(BinList{tags: ["a", "b"], nums: [1], spots: []})))[0]
			let expected = "std.data.encoding.BinList" + open + "tags: [\"a\", \"b\"], nums: [1], spots: []" + close
			assert list.str() == expected

			let stamp = (try codec.inspect(codec.encode(new BinStamp(1))))[0]
			assert stamp.str() == "std.data.encoding.BinStamp(0x00000001)"

			let shade = (try codec.inspect(codec.encode(BinEnumHolder{shade: BinColor.Green})))[0]
			assert shade.str() == "std.data.encoding.BinEnumHolder" + open + "shade: BinColor(1)" + close
		}

		@test()
		def TestRefusesBadStreams() !none {
			let codec = new Binary()
			let good = codec.encode(BinPoint{x: 1, y: 2})

			assert binRefuses(good.slice(0, good.len() - 2))
			assert binRefuses(byte[])
			assert binRefuses(byte[65, 68, 77, 88] + good.slice(4, good.len() - 4))
			assert binRefuses(good.slice(0, 4) + byte[2] + good.slice(5, good.len() - 5))

			let back = BinPoint{}
			try codec.decode(good, back)
			assert back.x == 1 && back.y == 2
		}

		@test()
		def TestCompactness() !none {
			// Header, type description and body. The qualified type name is
			// most of the description, so measure the rest against it.
			let codec = new Binary()
			let data = codec.encode(BinThree{a: 1, b: 2, c: 3})
			let name = "std.data.encoding.BinThree"
			let nameCost = name.len() + 1
			assert data.len() - nameCost < 40
			assert data.len() < 64
		}
	}
}
