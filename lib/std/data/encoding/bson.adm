partial module std.data.encoding {
	use (
		std.io
		std.time
		std.crypto::(UUID, parseUUID)
		std.reflection::(FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.data.encoding.bson::*
	)

	// What one BSON value is. The value of each kind is its element type
	// byte on the wire.
	enum BSONKind {
		// A 64-bit binary floating-point number.
		Double = 0x01,
		// UTF-8 text, which may hold U+0000.
		String = 0x02,
		// Named values, in the order they were read or added.
		Document = 0x03,
		Array = 0x04,
		// Bytes with a subtype (0 generic, 4 UUID, 9 vector, 0x80 and up
		// user-defined).
		Binary = 0x05,
		// Deprecated.
		Undefined = 0x06,
		ObjectId = 0x07,
		Bool = 0x08,
		// Milliseconds since the Unix epoch, UTC.
		DateTime = 0x09,
		Null = 0x0A,
		// A pattern and its options.
		Regex = 0x0B,
		// Deprecated: a namespace and an ObjectId.
		DBPointer = 0x0C,
		// JavaScript code.
		JavaScript = 0x0D,
		// Deprecated: text kept apart from strings.
		Symbol = 0x0E,
		// JavaScript code and a document of the variables it sees.
		JavaScriptWithScope = 0x0F,
		Int32 = 0x10,
		// MongoDB's internal replication timestamp: seconds and an increment.
		Timestamp = 0x11,
		Int64 = 0x12,
		Decimal128 = 0x13,
		// Sorts before every other value.
		MinKey = 0xFF,
		// Sorts after every other value.
		MaxKey = 0x7F,
	}

	// The element type of a vector held in a Binary of subtype 9 (BSON binary
	// vector specification). The value is the dtype byte.
	enum BSONVectorType {
		// Signed bytes.
		Int8 = 0x03,
		// 32-bit floats, little-endian.
		Float32 = 0x27,
		// Single bits, eight to a byte, most significant first.
		PackedBit = 0x10,
	}

	// The two forms of MongoDB Extended JSON v2.
	enum ExtendedJSON {
		// Every number in a type wrapper (`{"$numberInt": "1"}`): reads back
		// as the same BSON, byte for byte.
		Canonical,
		// Numbers as JSON numbers and dates as ISO-8601 text where they fit:
		// easier to read, loses the difference between int32, int64 and
		// double.
		Relaxed,
	}

	// One BSON value, read from data or built to encode.
	//
	//     let doc = new BSONValue(BSONKind.Document)
	//     doc.set("_id", new BSONValue(new ObjectId()))
	//     doc.set("name", new BSONValue("Ada"))
	//     let data = try new BSON().encode(doc)
	//
	//     let back = try new BSON().parse(data)
	//     let name = try back.get("name").asString()
	type BSONValue {
		internal k     BSONKind    = BSONKind.Null
		// Int32, Int64, DateTime (milliseconds) and Bool (0 or 1).
		internal n     int64
		// Timestamp: seconds in the high 32 bits, the increment in the low.
		internal ts    uint64
		internal f     float
		// Binary subtype.
		internal sub   int
		// The bytes of String, JavaScript, Symbol and the code of
		// JavaScriptWithScope; the data of Binary; Regex's pattern;
		// DBPointer's namespace; ObjectId's 12 bytes; Decimal128's 16.
		internal raw   byte[]
		// Regex's options, sorted; DBPointer's ObjectId.
		internal extra byte[]
		internal keys  string[]
		// Document values, Array elements, JavaScriptWithScope's scope.
		internal vals  BSONValue[]

		// What the value is.
		kind BSONKind {
			def get() BSONKind {
				return k
			}
		}

		// The subtype of a Binary, 0 otherwise.
		subtype int {
			def get() int {
				return k == BSONKind.Binary ?? (sub, 0)
			}
		}

		// What a Binary of subtype 9 holds a vector of; none for anything
		// else, or for a dtype this specification does not know.
		vectorType ?BSONVectorType {
			def get() ?BSONVectorType {
				return none when k != BSONKind.Binary || sub != 9 || raw.len() < 2
				match int(raw[0]) {
					case 0x03:
						return BSONVectorType.Int8
					case 0x27:
						return BSONVectorType.Float32
					case 0x10:
						return BSONVectorType.PackedBit
					default:
						return none
				}
			}
		}

		// null.
		def new() {}

		// The empty or zero value of a kind: an empty Document, Array, String,
		// JavaScript, Symbol or Binary; false; 0 for the numbers and
		// DateTime; the zero ObjectId; an empty Regex; JavaScriptWithScope of
		// no code and an empty scope; DBPointer of an empty namespace and the
		// zero ObjectId; Null, Undefined, MinKey or MaxKey.
		def new(kind BSONKind) {
			k = kind
			match kind {
				case BSONKind.ObjectId:
					raw.len(12)
				case BSONKind.DBPointer:
					extra.len(12)
				case BSONKind.Decimal128:
					raw = new Decimal128().bytes()
				case BSONKind.JavaScriptWithScope:
					vals.push(new BSONValue(BSONKind.Document))
				default:
			}
		}

		// An Int32 when the integer fits 32 bits, else an Int64.
		def new(v int) {
			k = v >= -2147483648 && v <= 2147483647 ?? (BSONKind.Int32, BSONKind.Int64)
			n = int64(v)
		}

		// An Int32.
		def new(v int32) {
			k = BSONKind.Int32
			n = int64(v)
		}

		// An Int64.
		def new(v int64) {
			k = BSONKind.Int64
			n = v
		}

		// A value of kind Int32, Int64 or DateTime (milliseconds since the
		// epoch) from its number. Another kind, or a number outside Int32,
		// fails an assertion.
		def new(kind BSONKind, value int64) {
			let fits = kind == BSONKind.Int64 || kind == BSONKind.DateTime || (kind == BSONKind.Int32 && value >= -2147483648 && value <= 2147483647)
			assert fits
			k = kind
			n = value
		}

		// A Double.
		def new(v float) {
			k = BSONKind.Double
			f = v
		}

		def new(v bool) {
			k = BSONKind.Bool
			n = v ?? (int64(1), int64(0))
		}

		// A String.
		def new(v string) {
			k = BSONKind.String
			raw = v.bytes()
		}

		// A String, JavaScript or Symbol of the text, or a Regex of the
		// pattern and options (options are kept sorted, as BSON wants them).
		// Another kind fails an assertion.
		def new(kind BSONKind, text string, options string = "") {
			let textual = kind == BSONKind.String || kind == BSONKind.JavaScript || kind == BSONKind.Symbol || kind == BSONKind.Regex
			assert textual
			k = kind
			raw = text.bytes()
			extra = bsonSortedOptions(options.bytes()) when kind == BSONKind.Regex
		}

		// A Binary of subtype 0.
		def new(v byte[]) {
			k = BSONKind.Binary
			raw = v
		}

		// A Binary of the subtype (0 to 255).
		def new(data byte[], subtype int) {
			k = BSONKind.Binary
			raw = data
			sub = subtype & 0xFF
		}

		// A Binary of subtype 4 holding the UUID's 16 bytes.
		def new(v UUID) {
			k = BSONKind.Binary
			raw = v.bytes()
			sub = 4
		}

		// A Binary vector of 32-bit floats (subtype 9, dtype FLOAT32).
		def new(vector float32[]) {
			k = BSONKind.Binary
			sub = 9
			raw.cap(2 + vector.len() * 4)
			raw.push(byte(0x27), byte(0))
			for let x in vector {
				let bits = __bitcast_u32_from_f32(x)
				raw.push(byte(bits & 0xFF), byte((bits >> 8) & 0xFF), byte((bits >> 16) & 0xFF), byte(bits >> 24))
			}
		}

		// A Binary vector of signed bytes (subtype 9, dtype INT8).
		def new(vector int8[]) {
			k = BSONKind.Binary
			sub = 9
			raw.cap(2 + vector.len())
			raw.push(byte(0x03), byte(0))
			for let x in vector {
				raw.push(byte(x))
			}
		}

		// A Binary vector of bits (subtype 9, dtype PACKED_BIT), eight to a
		// byte with the first bit most significant; the unused low bits of the
		// last byte are zero and counted as its padding.
		def new(bits bool[]) {
			k = BSONKind.Binary
			sub = 9
			let size = (bits.len() + 7) / 8
			raw.len(2 + size)
			raw[0] = byte(0x10)
			raw[1] = byte(size * 8 - bits.len())
			for let (i, bit) in bits {
				raw[2 + i / 8] = raw[2 + i / 8] | byte(0x80 >> (i % 8)) when bit
			}
		}

		// A DateTime of the instant, to the millisecond (rounded down).
		def new(t time.Time) {
			k = BSONKind.DateTime
			let ns = t.unixNs()
			n = ns / 1000000
			n-- when ns % 1000000 < 0
		}

		def new(v ObjectId) {
			k = BSONKind.ObjectId
			raw = v.bytes()
		}

		def new(v Decimal128) {
			k = BSONKind.Decimal128
			raw = v.bytes()
		}

		// An Array of the values.
		def new(v BSONValue[]) {
			k = BSONKind.Array
			vals = v
		}

		// JavaScript code with a scope. A scope that is not a Document fails an
		// assertion.
		def new(code string, scope BSONValue) {
			let isDocument = scope.k == BSONKind.Document
			assert isDocument
			k = BSONKind.JavaScriptWithScope
			raw = code.bytes()
			vals.push(scope)
		}

		// A DBPointer to the namespace and id.
		def new(namespace string, id ObjectId) {
			k = BSONKind.DBPointer
			raw = namespace.bytes()
			extra = id.bytes()
		}

		// A Timestamp of the seconds and increment.
		def new(seconds uint32, increment uint32) {
			k = BSONKind.Timestamp
			ts = (uint64(seconds) << 32) | uint64(increment)
		}

		// The integer of an Int32 or Int64. Fails for anything else.
		def asInt() !int {
			fail "bson: {bsonDescribe(self)} is not an integer" unless k == BSONKind.Int32 || k == BSONKind.Int64
			return int(n)
		}

		// The number of a Double, or of an Int32 or Int64 that a float holds
		// exactly. Fails for anything else.
		def asFloat() !float {
			return f when k == BSONKind.Double
			let exact = (k == BSONKind.Int32 || k == BSONKind.Int64) && n >= -9007199254740992 && n <= 9007199254740992
			fail "bson: {bsonDescribe(self)} is not a number a float holds" unless exact
			return float(n)
		}

		// The truth value of a Bool. Fails for anything else.
		def asBool() !bool {
			fail "bson: {bsonDescribe(self)} is not a bool" when k != BSONKind.Bool
			return n == 1
		}

		// The text of a String, JavaScript, JavaScriptWithScope or Symbol.
		// Fails for anything else, and for text holding U+0000, which a string
		// cannot carry (asBytes reads it).
		def asString() !string {
			let textual = k == BSONKind.String || k == BSONKind.JavaScript || k == BSONKind.JavaScriptWithScope || k == BSONKind.Symbol
			fail "bson: {bsonDescribe(self)} is not text" unless textual
			fail "bson: the text holds U+0000" when raw.indexOf(byte(0)) >= 0
			return string(raw)
		}

		// The data of a Binary, or the UTF-8 bytes of a String, JavaScript,
		// JavaScriptWithScope or Symbol. Fails for anything else.
		def asBytes() !byte[] {
			let carries = k == BSONKind.Binary || k == BSONKind.String || k == BSONKind.JavaScript || k == BSONKind.JavaScriptWithScope || k == BSONKind.Symbol
			fail "bson: {bsonDescribe(self)} has no bytes" unless carries
			return raw
		}

		// The milliseconds since the epoch of a DateTime, over its whole
		// 64-bit range. Fails for anything else.
		def asDateTime() !int64 {
			fail "bson: {bsonDescribe(self)} is not a datetime" when k != BSONKind.DateTime
			return n
		}

		// The instant of a DateTime. Fails for anything else, and for a
		// datetime outside what time.Time holds (about 1677 to 2262).
		def asTime() !time.Time {
			let ms = try asDateTime()
			fail "bson: datetime {ms} ms lies outside the range of time.Time" when ms < -9223372036854 || ms > 9223372036854
			return time.fromUnixNs(ms * 1000000)
		}

		// The ObjectId of an ObjectId. Fails for anything else.
		def asObjectId() !ObjectId {
			fail "bson: {bsonDescribe(self)} is not an ObjectId" when k != BSONKind.ObjectId
			return try parseObjectId(raw)
		}

		// The number of a Decimal128. Fails for anything else.
		def asDecimal128() !Decimal128 {
			fail "bson: {bsonDescribe(self)} is not a Decimal128" when k != BSONKind.Decimal128
			return try parseDecimal128(raw)
		}

		// The UUID of a Binary of subtype 4. Fails for anything else.
		def asUUID() !UUID {
			fail "bson: {bsonDescribe(self)} is not a UUID" unless k == BSONKind.Binary && sub == 4 && raw.len() == 16
			return try parseUUID(raw)
		}

		// The seconds and increment of a Timestamp. Fails for anything else.
		def asTimestamp() !(uint32, uint32) {
			fail "bson: {bsonDescribe(self)} is not a timestamp" when k != BSONKind.Timestamp
			return (uint32(ts >> 32), uint32(ts & 0xFFFFFFFF))
		}

		// The pattern and options of a Regex. Fails for anything else.
		def asRegex() !(string, string) {
			fail "bson: {bsonDescribe(self)} is not a regular expression" when k != BSONKind.Regex
			return (string(raw), string(extra))
		}

		// The namespace and id of a DBPointer. Fails for anything else.
		def asDBPointer() !(string, ObjectId) {
			fail "bson: {bsonDescribe(self)} is not a DBPointer" when k != BSONKind.DBPointer
			fail "bson: the namespace holds U+0000" when raw.indexOf(byte(0)) >= 0
			return (string(raw), try parseObjectId(extra))
		}

		// The scope of JavaScriptWithScope; null for anything else.
		def scope() BSONValue {
			return vals[0] when k == BSONKind.JavaScriptWithScope
			return new BSONValue()
		}

		// The floats of a FLOAT32 vector. Fails for anything else, and for
		// data that is not whole floats or has padding.
		def asFloat32Vector() !float32[] {
			try bsonCheckVector(self, BSONVectorType.Float32)
			let out float32[] = []
			out.cap((raw.len() - 2) / 4)
			for let i = 2; i < raw.len(); i += 4 {
				let bits = uint32(raw[i]) | (uint32(raw[i + 1]) << 8) | (uint32(raw[i + 2]) << 16) | (uint32(raw[i + 3]) << 24)
				out.push(__bitcast_f32_from_u32(bits))
			}
			return out
		}

		// The signed bytes of an INT8 vector. Fails for anything else, and for
		// a vector with padding.
		def asInt8Vector() !int8[] {
			try bsonCheckVector(self, BSONVectorType.Int8)
			let out int8[] = []
			out.cap(raw.len() - 2)
			for let i = 2; i < raw.len(); i++ {
				out.push(int8(raw[i]))
			}
			return out
		}

		// The bits of a PACKED_BIT vector, the padding bits of the last byte
		// left out. Fails for anything else, and for padding above 7 or on an
		// empty vector.
		def asBitVector() !bool[] {
			try bsonCheckVector(self, BSONVectorType.PackedBit)
			let count = (raw.len() - 2) * 8 - int(raw[1])
			let out bool[] = []
			out.cap(count)
			for let i = 0; i < count; i++ {
				out.push((raw[2 + i / 8] & byte(0x80 >> (i % 8))) != byte(0))
			}
			return out
		}

		// The elements of an Array; empty for anything else.
		def elements() BSONValue[] {
			return vals when k == BSONKind.Array
			return []
		}

		// The names of a Document, in order; empty for anything else.
		def names() string[] {
			return keys when k == BSONKind.Document
			return []
		}

		// The entries of a Document, in order; empty for anything else.
		def entries() (string, BSONValue)[] {
			let out (string, BSONValue)[] = []
			return out when k != BSONKind.Document
			for let (i, key) in keys {
				out.push((key, vals[i]))
			}
			return out
		}

		// The number of entries of a Document, elements of an Array or bytes
		// of a String, Binary, JavaScript or Symbol; 0 for anything else.
		def len() int {
			match k {
				case BSONKind.Document, BSONKind.Array:
					return vals.len()
				case BSONKind.String, BSONKind.Binary, BSONKind.JavaScript, BSONKind.Symbol:
					return raw.len()
				default:
					return 0
			}
		}

		// The element of an Array at index; null when out of range or not an
		// array.
		def at(index int) BSONValue {
			return new BSONValue() when k != BSONKind.Array || index < 0 || index >= vals.len()
			return vals[index]
		}

		// The first entry of a Document under name; null when absent or not a
		// document (has tells the two apart).
		def get(name string) BSONValue {
			let i = indexOf(name)
			return new BSONValue() when i < 0
			return vals[i]
		}

		// Reports whether a Document has an entry under name.
		def has(name string) bool {
			return indexOf(name) >= 0
		}

		// The position of the first entry under name; -1 when absent or not a
		// document.
		def indexOf(name string) int {
			return -1 when k != BSONKind.Document
			return keys.indexOf(name)
		}

		// Sets the entry under name in a Document, replacing the first entry
		// of that name in place or adding one at the end, and returns the
		// document. Does nothing to a value that is not a document.
		def set(name string, value BSONValue) BSONValue {
			return self when k != BSONKind.Document
			let i = keys.indexOf(name)
			if i >= 0 {
				vals[i] = value
			} else {
				keys.push(name)
				vals.push(value)
			}
			return self
		}

		// Removes the entries under name from a Document and returns it.
		def remove(name string) BSONValue {
			return self when k != BSONKind.Document
			for let i = keys.len() - 1; i >= 0; i-- {
				if keys[i] == name {
					keys.remove(i)
					vals.remove(i)
				}
			}
			return self
		}

		// Appends an element to an Array and returns it. Does nothing to a
		// value that is not an array.
		def push(item BSONValue) BSONValue {
			vals.push(item) when k == BSONKind.Array
			return self
		}

		// Reports whether two values are the same BSON: equal kinds and
		// contents, document entries in the same order. NaN equals NaN; an
		// Int32 and an Int64 of one number differ.
		def equals(other BSONValue) bool {
			return false when k != other.k
			match k {
				case BSONKind.Double:
					return (f != f && other.f != other.f) || __bitcast_u64_from_f64(float64(f)) == __bitcast_u64_from_f64(float64(other.f))
				case BSONKind.Int32, BSONKind.Int64, BSONKind.DateTime, BSONKind.Bool:
					return n == other.n
				case BSONKind.Timestamp:
					return ts == other.ts
				case BSONKind.Binary:
					return sub == other.sub && raw.equals(other.raw)
				case BSONKind.Document, BSONKind.Array, BSONKind.JavaScriptWithScope:
					return false when vals.len() != other.vals.len() || !raw.equals(other.raw)
					for let (i, v) in vals {
						return false when !v.equals(other.vals[i])
						return false when k == BSONKind.Document && keys[i] != other.keys[i]
					}
					return true
				default:
					return raw.equals(other.raw) && extra.equals(other.extra)
			}
		}

		// The value as Extended JSON in the given form.
		def json(form ExtendedJSON = ExtendedJSON.Relaxed) string {
			let out byte[]
			bsonWriteJSON(out, self, form == ExtendedJSON.Canonical)
			return string(out)
		}

		// The value as relaxed Extended JSON.
		def str() string {
			return json(ExtendedJSON.Relaxed)
		}
	}

	// Qualified name of the `@bson` meta function, used to look up field
	// options.
	internal const bsonAttr = "std.data.encoding.bson"

	// BSON encodes and decodes BSON (https://bsonspec.org, version 1.1) and
	// MongoDB Extended JSON v2.
	//
	//     let codec = new BSON()
	//     let data = try codec.encode(user)
	//     try codec.decode(data, user)
	//
	//     let doc = try codec.parse(data)              // a BSONValue tree
	//     println(doc.json(ExtendedJSON.Canonical))
	//     let back = try codec.parseJSON(text)
	//
	// `encode` takes a document: an object (its fields), a `map<string, V>` or
	// a BSONValue Document. Inside it an int becomes an Int32 when it fits
	// and an Int64 otherwise (`int64` fields are always Int64, `int32` and
	// smaller always Int32), a float a Double, `byte[]` a Binary, a UUID a
	// Binary of subtype 4, a `time.Time` a DateTime (to the millisecond), a
	// `duration` an Int64 of nanoseconds, a `std.math.Decimal` a Decimal128,
	// an enum member its value, none null, and ObjectId, Decimal128 and
	// BSONValue themselves. Anything nested deeper than maxDepth is written
	// as null.
	//
	// Per-field behaviour comes from `@bson` annotations:
	//
	//     @bson("_id")             encode under this name instead of the field name
	//     @bson(omitempty = true)  leave the field out when it holds its zero value
	//     @bson(ignore = true)     never encode or decode the field
	//
	// The decoder checks every length against the bytes around it, the
	// terminating zero bytes, UTF-8 text, booleans of 0 or 1 and the old
	// Binary subtype 2's inner length, and refuses unknown element types and
	// nesting deeper than maxDepth. Array keys are not checked.
	type BSON {
		// How deep documents and arrays may nest before decoding fails, and
		// how deep encode walks objects before writing null. MongoDB itself
		// allows 100.
		maxDepth int = 100

		// encode renders a document as BSON. Fails when obj is not a document
		// (an object, a `map<string, V>` or a BSONValue Document), or holds an
		// integer outside the Int64 range or a Decimal a Decimal128 cannot
		// hold exactly.
		def encode(obj any) !byte[] {
			let out byte[]
			try bsonEncodeDocument(self, out, obj, 0)
			return out
		}

		// encode writes a document as BSON to the writer. Fails when encode
		// does or the writer does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(try encode(obj))
			return none
		}

		// Reads the one document the bytes hold. Fails when they are not
		// exactly one well-formed document.
		def parse(input byte[]) !BSONValue {
			let (doc, end) = try bsonReadDocument(input, 0, input.len(), 0, maxDepth, false)
			fail "bson: {input.len() - end} bytes of trailing data" when end < input.len()
			return doc
		}

		// decode binds the one document the bytes hold onto target: entries
		// onto an object's fields by `@bson` name or field name, documents
		// and arrays onto nested objects, `map<string, V>` and array fields,
		// a DateTime onto a `time.Time`, a Binary onto `byte[]` (or a UUID
		// for subtype 4). Unknown names are skipped; null leaves a field at
		// its zero value. A BSONValue target takes the document as a tree.
		// Fails when the bytes do not parse or a value does not fit its
		// field.
		def decode(input byte[], target any) !none {
			let doc = try parse(input)
			return try bsonBind(doc, target, 0, maxDepth)
		}

		// bind fills target from a document already parsed, as `decode` does
		// from bytes. Fails when a value does not fit its field.
		def bind(doc BSONValue, target any) !none {
			return try bsonBind(doc, target, 0, maxDepth)
		}

		// decode reads one document from the reader and binds it onto
		// target. Fails when the reader does or the data does not decode.
		def decode(reader io.Reader, target any) !none {
			let r = new BSONReader(reader)
			r.maxDepth = maxDepth
			let doc = try r.next()
			return try bsonBind(doc, target, 0, maxDepth)
		}

		// Reads one value of Extended JSON v2, canonical or relaxed, and the
		// legacy forms the specification still accepts (`{"$binary": "…",
		// "$type": "00"}`, `{"$regex": "…", "$options": "…"}`). An object
		// whose keys are a type wrapper's becomes that type; one that names a
		// wrapper key with keys or values the wrapper does not allow fails.
		// Fails on malformed JSON.
		def parseJSON(text string) !BSONValue {
			return try bsonReadJSON(text.bytes(), maxDepth)
		}
	}

	// Reads BSON documents one after another, from bytes or from a stream: a
	// `mongodump` file, or a connection carrying one document after another.
	//
	//     let r = new BSONReader(file)
	//     for try r.more() {
	//         let doc = try r.next()
	//     }
	type BSONReader {
		internal data byte[]
		internal i    int        = 0
		// Bytes dropped from the front of data, so pos counts from the start.
		internal base int        = 0
		internal src  ?io.Reader

		// How deep documents and arrays may nest before next fails.
		maxDepth int = 100

		// Offset of the next document from the start of the data or stream.
		pos int {
			def get() int {
				return base + i
			}
		}

		// Reads from the bytes.
		def new(data byte[]) {
			self.data = data
		}

		// Reads from the reader, buffering what it yields.
		def new(reader io.Reader) {
			src = reader
		}

		// Reports whether another document follows, reading from the stream
		// when the buffer is empty. Fails when the reader does.
		def more() !bool {
			return true when i < data.len()
			return try fill(1)
		}

		// Reads the next document and moves past it. Fails when the data ends
		// inside a document, the document is malformed or the reader fails.
		def next() !BSONValue {
			fail "bson: document at offset {pos} is truncated" unless try fill(4)
			let size = int(bsonInt32(data, i))
			fail "bson: document size {size} at offset {pos} is invalid" when size < 5
			fail "bson: document at offset {pos} is truncated" unless try fill(size)
			let (doc, end) = try bsonReadDocument(data, i, i + size, 0, maxDepth, false)
			i = end
			return doc
		}

		// Makes sure n bytes are buffered past i, reading from the stream as
		// needed. Reports false when the bytes or the stream end first.
		internal def fill(n int) !bool {
			return true when data.len() - i >= n
			let reader = src
			return false when reader is none
			if i > 0 {
				data = data.slice(i, data.len() - i).clone()
				base += i
				i = 0
			}
			let chunk byte[]
			chunk.len(n - data.len() > 65536 ?? (n - data.len(), 65536))
			for data.len() < n {
				let got = try reader.read(chunk)
				return false when got <= 0
				data += chunk.slice(0, got)
			}
			return true
		}
	}

	// Controls how a field is encoded to and decoded from BSON.
	//
	//     name       document key to use instead of the field name
	//     omitempty  leave the field out when it holds its zero value
	//     ignore     never encode or decode the field
	//
	//     struct User {
	//         @bson("_id")
	//         id ObjectId
	//     }
	meta def bson(ctx FieldMetaContext, name string = "", omitempty bool = false, ignore bool = false) {
		let store MetadataStore = ctx.ctx.storage
		bsonRecord(store, name, omitempty, ignore)
	}

	// Controls how a property is encoded to and decoded from BSON. Takes the
	// same options as the field form above.
	meta def bson(ctx PropertyMetaContext, name string = "", omitempty bool = false, ignore bool = false) {
		let store MetadataStore = ctx.ctx.storage
		bsonRecord(store, name, omitempty, ignore)
	}

	// Checks that a value is a vector of the dtype with valid padding and
	// whole elements.
	internal def bsonCheckVector(v BSONValue, want BSONVectorType) !none {
		expects {
			assert v.k == BSONKind.Binary && v.sub == 9 && v.raw.len() >= 2 onerror fail "bson: {bsonDescribe(v)} is not a vector"
			assert int(v.raw[0]) == want.value onerror fail "bson: the vector holds dtype 0x{v.raw[:1].hex().lower()}, not {want.name}"
		}
		let padding = int(v.raw[1])
		if want == BSONVectorType.PackedBit {
			fail "bson: vector padding {padding} is above 7" when padding > 7
			fail "bson: an empty vector has padding {padding}" when padding > 0 && v.raw.len() == 2
		} else {
			fail "bson: a {want.name} vector has padding {padding}" when padding != 0
		}
		fail "bson: FLOAT32 vector data is not whole floats" when want == BSONVectorType.Float32 && (v.raw.len() - 2) % 4 != 0
		return none
	}

	// The kind of a value in words, for error messages.
	internal def bsonDescribe(v BSONValue) string {
		let name = v.k.name
		return "an {name}" when name.startsWith("I") || name.startsWith("O") || name.startsWith("A") || name.startsWith("U")
		return "a {name}"
	}
}
