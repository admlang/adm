partial module std.data.encoding {
	use (
		std.time
		std.math::(Decimal)
		std.crypto::(parseUUID)
		std.data.encoding.json::(JSONCursor, quote)
		std.data.encoding.bson::*
	)

	// Writes a value as Extended JSON, canonical or relaxed.
	internal def bsonWriteJSON(out byte[], v BSONValue, canonical bool) {
		match v.k {
			case BSONKind.Document:
				out.push(byte(123))
				for let (i, key) in v.keys {
					out.push(byte(44)) when i > 0
					out.push(...quote(key).bytes())
					out.push(byte(58))
					bsonWriteJSON(out, v.vals[i], canonical)
				}
				out.push(byte(125))
			case BSONKind.Array:
				out.push(byte(91))
				for let (i, item) in v.vals {
					out.push(byte(44)) when i > 0
					bsonWriteJSON(out, item, canonical)
				}
				out.push(byte(93))
			case BSONKind.Double:
				let text = bsonDoubleText(v.f)
				let finite = v.f == v.f && v.f - v.f == 0.0
				if canonical || !finite {
					bsonJSONWrap(out, "$numberDouble", quote(text))
				} else {
					out.push(...text.bytes())
				}
			case BSONKind.String:
				out.push(...quote(v.raw).bytes())
			case BSONKind.Binary:
				let body = "\{\"base64\":" + quote(base64encode(v.raw)) + ",\"subType\":\"" + byte[byte(v.sub)].hex().lower() + "\"\}"
				bsonJSONWrap(out, "$binary", body)
			case BSONKind.Undefined:
				bsonJSONWrap(out, "$undefined", "true")
			case BSONKind.ObjectId:
				bsonJSONWrap(out, "$oid", quote(v.raw.hex().lower()))
			case BSONKind.Bool:
				out.push(...(v.n == 1 ?? ("true", "false")).bytes())
			case BSONKind.DateTime:
				if !canonical && v.n >= 0 && v.n <= 253402300799999 {
					bsonJSONWrap(out, "$date", quote(bsonISODate(v.n)))
				} else {
					bsonJSONWrap(out, "$date", "\{\"$numberLong\":\"" + v.n.str() + "\"\}")
				}
			case BSONKind.Regex:
				bsonJSONWrap(out, "$regularExpression", "\{\"pattern\":" + quote(v.raw) + ",\"options\":" + quote(v.extra) + "\}")
			case BSONKind.DBPointer:
				bsonJSONWrap(out, "$dbPointer", "\{\"$ref\":" + quote(v.raw) + ",\"$id\":\{\"$oid\":\"" + v.extra.hex().lower() + "\"\}\}")
			case BSONKind.JavaScript:
				bsonJSONWrap(out, "$code", quote(v.raw))
			case BSONKind.Symbol:
				bsonJSONWrap(out, "$symbol", quote(v.raw))
			case BSONKind.JavaScriptWithScope:
				out.push(...("\{\"$code\":" + quote(v.raw) + ",\"$scope\":").bytes())
				bsonWriteJSON(out, v.vals[0], canonical)
				out.push(byte(125))
			case BSONKind.Int32:
				if canonical {
					bsonJSONWrap(out, "$numberInt", "\"" + v.n.str() + "\"")
				} else {
					out.push(...v.n.str().bytes())
				}
			case BSONKind.Int64:
				if canonical {
					bsonJSONWrap(out, "$numberLong", "\"" + v.n.str() + "\"")
				} else {
					out.push(...v.n.str().bytes())
				}
			case BSONKind.Timestamp:
				bsonJSONWrap(out, "$timestamp", "\{\"t\":" + (v.ts >> 32).str() + ",\"i\":" + (v.ts & 0xFFFFFFFF).str() + "\}")
			case BSONKind.Decimal128:
				let d = parseDecimal128(v.raw) onerror recover new Decimal128()
				bsonJSONWrap(out, "$numberDecimal", quote(d.str()))
			case BSONKind.MinKey:
				bsonJSONWrap(out, "$minKey", "1")
			case BSONKind.MaxKey:
				bsonJSONWrap(out, "$maxKey", "1")
			default:
				out.push(...("null").bytes())
		}
	}

	// Writes `{"name":body}`.
	internal def bsonJSONWrap(out byte[], name string, body string) {
		out.push(...("\{\"" + name + "\":" + body + "\}").bytes())
	}

	// A double as Extended JSON writes it: the shortest digits that read back
	// as the same double, in plain notation when the point falls within 16
	// digits of the start and in scientific notation otherwise ("1.0",
	// "-0.0", "1.2345678921232E+18", "5.0E-324"), or "Infinity", "-Infinity",
	// "NaN".
	internal def bsonDoubleText(f float) string {
		return "NaN" when f != f
		return "Infinity" when f > 1.7976931348623157e308
		return "-Infinity" when f < -1.7976931348623157e308
		let negative = __bitcast_u64_from_f64(float64(f)) >> 63 == 1
		let sign = negative ?? ("-", "")
		return sign + "0.0" when f == 0.0
		let shortest = new Decimal(f)
		let digits = shortest.coefficient().abs().toRadix(10)
		let point = digits.len() + shortest.exponent()
		if point > -4 && point <= 16 {
			return sign + "0." + "0".repeat(-point) + digits when point <= 0
			return sign + digits + "0".repeat(point - digits.len()) + ".0" when point >= digits.len()
			return sign + digits[:point] + "." + digits[point:]
		}
		let exponent = point - 1
		let mantissaText = digits.len() > 1 ?? (digits[:1] + "." + digits[1:], digits + ".0")
		return sign + mantissaText + "E" + (exponent >= 0 ?? ("+", "")) + exponent.str()
	}

	// An instant from 1970 to 9999 in milliseconds as ISO-8601 in UTC, the
	// milliseconds left out when zero: `2012-12-24T12:15:30.501Z`.
	internal def bsonISODate(ms int64) string {
		let days = ms / 86400000
		let inDay = int(ms % 86400000)
		let date = time.fromEpochDay(days)
		let text = "{bsonPad(date.year, 4)}-{bsonPad(date.month, 2)}-{bsonPad(date.day, 2)}T{bsonPad(inDay / 3600000, 2)}:{bsonPad(inDay / 60000 % 60, 2)}:{bsonPad(inDay / 1000 % 60, 2)}"
		text += "." + bsonPad(inDay % 1000, 3) when inDay % 1000 != 0
		return text + "Z"
	}

	internal def bsonPad(n int, width int) string {
		let text = n.str()
		return "0".repeat(width - text.len()) + text when text.len() < width
		return text
	}

	// The milliseconds of an ISO-8601 date and time with a zone:
	// `YYYY-MM-DDTHH:MM:SS`, optional fractional seconds (milliseconds kept,
	// finer digits dropped), then `Z` or an offset `±HH:MM` or `±HHMM`.
	internal def bsonParseISODate(text string) !int64 {
		let b = text.bytes()
		fail "bson: \"{text}\" is not an ISO-8601 date and time" when b.len() < 20 || b[4] != byte(45) || b[7] != byte(45) || (b[10] != byte(84) && b[10] != byte(116)) || b[13] != byte(58) || b[16] != byte(58)
		let year = try bsonDigits(b, 0, 4, text)
		let month = try bsonDigits(b, 5, 2, text)
		let day = try bsonDigits(b, 8, 2, text)
		let hour = try bsonDigits(b, 11, 2, text)
		let minute = try bsonDigits(b, 14, 2, text)
		let second = try bsonDigits(b, 17, 2, text)
		fail "bson: \"{text}\" has a field out of range" when month < 1 || month > 12 || day < 1 || day > time.daysInMonth(year, month) || hour > 23 || minute > 59 || second > 59
		let i = 19
		let ms = 0
		if i < b.len() && b[i] == byte(46) {
			i++
			let start = i
			for i < b.len() && b[i] >= byte(48) && b[i] <= byte(57) {
				ms = ms * 10 + int(b[i] - byte(48)) when i - start < 3
				i++
			}
			fail "bson: \"{text}\" has no digits after the point" when i == start
			let kept = i - start < 3 ?? (i - start, 3)
			for let k = kept; k < 3; k++ {
				ms *= 10
			}
		}
		fail "bson: \"{text}\" has no zone" when i >= b.len()
		let offset = 0
		if b[i] == byte(90) || b[i] == byte(122) {
			i++
		} else {
			fail "bson: \"{text}\" has no zone" unless b[i] == byte(43) || b[i] == byte(45)
			let east = b[i] == byte(43)
			i++
			let hours = try bsonDigits(b, i, 2, text)
			i += 2
			i++ when i < b.len() && b[i] == byte(58)
			let minutes = try bsonDigits(b, i, 2, text)
			i += 2
			offset = (hours * 60 + minutes) * 60000
			offset = -offset when !east
		}
		fail "bson: \"{text}\" has text after the zone" when i != b.len()
		let days = new time.Date(year, month, day).epochDay()
		return days * 86400000 + int64(((hour * 60 + minute) * 60 + second) * 1000 + ms - offset)
	}

	internal def bsonDigits(b byte[], at int, count int, text string) !int {
		expects {
			assert at + count <= b.len() onerror fail "bson: \"{text}\" is not an ISO-8601 date and time"
		}
		let v = 0
		for let i = at; i < at + count; i++ {
			fail "bson: \"{text}\" is not an ISO-8601 date and time" unless b[i] >= byte(48) && b[i] <= byte(57)
			v = v * 10 + int(b[i] - byte(48))
		}
		return v
	}

	// Reads one Extended JSON value from the whole text.
	internal def bsonReadJSON(text byte[], maxDepth int) !BSONValue {
		let cur = new JSONCursor(text)
		let node = try bsonJSONNode(cur, 0, maxDepth)
		cur.skipSpace()
		fail "bson: text after the JSON value at offset {cur.pos}" unless cur.done()
		return try bsonOfNode(node, 0, maxDepth)
	}

	// The value a JSON node stands for: a type wrapper becomes its type, any
	// other object a Document.
	internal def bsonOfNode(node BSONJSONNode, depth int, maxDepth int) !BSONValue {
		match node.kind {
			case 1:
				return new BSONValue(node.flag)
			case 2:
				return try bsonNumberOf(node.text)
			case 3:
				let v = new BSONValue(BSONKind.String)
				v.raw = node.raw
				return v
			case 4:
				let v = new BSONValue(BSONKind.Array)
				for let item in node.items {
					v.vals.push(try bsonOfNode(item, depth + 1, maxDepth))
				}
				return v
			case 5:
				let wrapped = try bsonWrapper(node, depth, maxDepth)
				return wrapped unless wrapped is none
				let v = new BSONValue(BSONKind.Document)
				for let (i, name) in node.names {
					fail "bson: name \"{name.hex()}\" holds U+0000" when name.indexOf(byte(0)) >= 0
					v.keys.push(string(name))
					v.vals.push(try bsonOfNode(node.items[i], depth + 1, maxDepth))
				}
				return v
			default:
				return new BSONValue()
		}
	}

	// A JSON number in relaxed form: an integer as Int32 when it fits, else
	// Int64 when it fits, else Double; anything with a point or an exponent
	// as Double.
	internal def bsonNumberOf(text string) !BSONValue {
		let integral = text.indexOf(".") < 0 && text.indexOf("e") < 0 && text.indexOf("E") < 0
		if integral {
			let n = try parseBigInt(text)
			return new BSONValue(BSONKind.Int32, int64(n)) when n >= bigint(-2147483648) && n <= bigint(2147483647)
			return new BSONValue(BSONKind.Int64, int64(n)) when n >= -(bigint(1) << 63) && n < bigint(1) << 63
		}
		return new BSONValue(parseFloat<float>(text))
	}

	// The type a wrapper object stands for; none when the object is a plain
	// document. Fails when it names a wrapper key with keys or values that
	// wrapper does not allow.
	internal def bsonWrapper(node BSONJSONNode, depth int, maxDepth int) !?BSONValue {
		let names = node.nameTexts()
		if names.len() == 2 {
			// The legacy forms, told apart from the query operators of the
			// same names by their string values.
			if node.has("$regex") && node.has("$options") && node.at("$regex").kind == 3 && node.at("$options").kind == 3 {
				let pattern = node.at("$regex").raw
				let options = node.at("$options").raw
				fail "bson: a regular expression holds U+0000" when pattern.indexOf(byte(0)) >= 0 || options.indexOf(byte(0)) >= 0
				let v = new BSONValue(BSONKind.Regex)
				v.raw = pattern
				v.extra = bsonSortedOptions(options)
				return v
			}
			return try bsonBinaryOf(node.at("$binary"), node.at("$type")) when node.has("$binary") && node.has("$type") && node.at("$binary").kind == 3 && node.at("$type").kind == 3
			if node.has("$code") && node.has("$scope") {
				let code = node.at("$code")
				fail "bson: $code is not a string" when code.kind != 3
				let scope = try bsonOfNode(node.at("$scope"), depth + 1, maxDepth)
				fail "bson: $scope is not a document" when scope.k != BSONKind.Document
				let v = new BSONValue(BSONKind.JavaScriptWithScope)
				v.raw = code.raw
				v.vals[0] = scope
				return v
			}
		}
		let wrapper = ""
		for let name in names {
			if bsonWrapperKeys.includes(name) {
				wrapper = name
				break
			}
		}
		return none when wrapper == ""
		fail "bson: {wrapper} takes no other keys" when names.len() != 1
		let x = node.items[0]
		match wrapper {
			case "$oid":
				fail "bson: $oid is not a string" when x.kind != 3
				let v = new BSONValue(BSONKind.ObjectId)
				v.raw = objectIdOfHex(string(x.raw))
				fail "bson: $oid is not 24 hexadecimal digits" when v.raw.len() != 12
				return v
			case "$symbol", "$code":
				fail "bson: {wrapper} is not a string" when x.kind != 3
				let v = new BSONValue(wrapper == "$code" ?? (BSONKind.JavaScript, BSONKind.Symbol))
				v.raw = x.raw
				return v
			case "$numberInt":
				fail "bson: $numberInt is not a string" when x.kind != 3
				return new BSONValue(BSONKind.Int32, try bsonStrictInteger(string(x.raw), -(bigint(1) << 31), (bigint(1) << 31) - bigint(1)))
			case "$numberLong":
				fail "bson: $numberLong is not a string" when x.kind != 3
				return new BSONValue(BSONKind.Int64, try bsonStrictInteger(string(x.raw), -(bigint(1) << 63), (bigint(1) << 63) - bigint(1)))
			case "$numberDouble":
				fail "bson: $numberDouble is not a string" when x.kind != 3
				return new BSONValue(try bsonDoubleOf(string(x.raw)))
			case "$numberDecimal":
				fail "bson: $numberDecimal is not a string" when x.kind != 3
				return new BSONValue(try parseDecimal128(string(x.raw)))
			case "$binary":
				fail "bson: $binary is not an object" when x.kind != 5
				fail "bson: $binary takes base64 and subType" unless x.nameTexts().len() == 2 && x.has("base64") && x.has("subType")
				return try bsonBinaryOf(x.at("base64"), x.at("subType"))
			case "$uuid":
				fail "bson: $uuid is not a string" when x.kind != 3
				let text = string(x.raw)
				fail "bson: $uuid \"{text}\" is not a hyphenated UUID" when text.len() != 36
				let id = parseUUID(text) onerror (err error) {
					fail "bson: $uuid \"{text}\" is not a hyphenated UUID"
				}
				return new BSONValue(id)
			case "$timestamp":
				fail "bson: $timestamp is not an object" when x.kind != 5
				fail "bson: $timestamp takes t and i" unless x.nameTexts().len() == 2 && x.has("t") && x.has("i")
				let t = try bsonUint32Of(x.at("t"), "t")
				let i = try bsonUint32Of(x.at("i"), "i")
				return new BSONValue(t, i)
			case "$regularExpression":
				fail "bson: $regularExpression is not an object" when x.kind != 5
				fail "bson: $regularExpression takes pattern and options" unless x.nameTexts().len() == 2 && x.has("pattern") && x.has("options")
				let pattern = x.at("pattern")
				let options = x.at("options")
				fail "bson: pattern and options are strings" unless pattern.kind == 3 && options.kind == 3
				fail "bson: a regular expression holds U+0000" when pattern.raw.indexOf(byte(0)) >= 0 || options.raw.indexOf(byte(0)) >= 0
				let v = new BSONValue(BSONKind.Regex)
				v.raw = pattern.raw
				v.extra = bsonSortedOptions(options.raw)
				return v
			case "$dbPointer":
				fail "bson: $dbPointer is not an object" when x.kind != 5
				fail "bson: $dbPointer takes $ref and $id" unless x.nameTexts().len() == 2 && x.has("$ref") && x.has("$id")
				let ref = x.at("$ref")
				fail "bson: $ref is not a string" when ref.kind != 3
				let id = try bsonOfNode(x.at("$id"), depth + 1, maxDepth)
				fail "bson: $id of a $dbPointer is not an ObjectId" when id.k != BSONKind.ObjectId
				let v = new BSONValue(BSONKind.DBPointer)
				v.raw = ref.raw
				v.extra = id.raw
				return v
			case "$date":
				return new BSONValue(BSONKind.DateTime, try bsonParseISODate(string(x.raw))) when x.kind == 3
				fail "bson: $date is not a string or {\"$numberLong\": …}" unless x.kind == 5 && x.nameTexts().len() == 1 && x.has("$numberLong") && x.at("$numberLong").kind == 3
				return new BSONValue(BSONKind.DateTime, try bsonStrictInteger(string(x.at("$numberLong").raw), -(bigint(1) << 63), (bigint(1) << 63) - bigint(1)))
			case "$minKey", "$maxKey":
				fail "bson: {wrapper} is not 1" unless x.kind == 2 && x.text == "1"
				return new BSONValue(wrapper == "$minKey" ?? (BSONKind.MinKey, BSONKind.MaxKey))
			default:
				fail "bson: $undefined is not true" unless x.kind == 1 && x.flag
				return new BSONValue(BSONKind.Undefined)
		}
	}

	// The keys that make an object a type wrapper.
	internal const bsonWrapperKeys = ["$oid", "$symbol", "$numberInt", "$numberLong", "$numberDouble", "$numberDecimal", "$binary", "$code", "$timestamp", "$regularExpression", "$dbPointer", "$date", "$minKey", "$maxKey", "$undefined", "$uuid"]

	// A Binary of base64 text and a subtype of one or two hexadecimal digits.
	internal def bsonBinaryOf(data BSONJSONNode, subtype BSONJSONNode) !BSONValue {
		expects {
			assert data.kind == 3 onerror fail "bson: binary data is not a string"
			assert subtype.kind == 3 onerror fail "bson: a binary subtype is not a string"
		}
		let hex = string(subtype.raw)
		fail "bson: binary subtype \"{hex}\" is not one or two hexadecimal digits" unless hex.len() >= 1 && hex.len() <= 2
		for let c in hex {
			fail "bson: binary subtype \"{hex}\" is not one or two hexadecimal digits" unless c.isHexDigit()
		}
		let bytes = try base64decode(string(data.raw))
		return new BSONValue(bytes, parseInt<int>(hex, 16))
	}

	// An integer of a JSON number from 0 to 2^32 - 1.
	internal def bsonUint32Of(node BSONJSONNode, name string) !uint32 {
		expects {
			assert node.kind == 2 onerror fail "bson: $timestamp {name} is not a number"
		}
		let v = try bsonStrictInteger(node.text, bigint(0), bigint(0xFFFFFFFF))
		return uint32(v)
	}

	// An optional `-` and decimal digits, within the bounds.
	internal def bsonStrictInteger(text string, min bigint, max bigint) !int64 {
		let digits = text.startsWith("-") ?? (text[1:], text)
		fail "bson: \"{text}\" is not an integer" when digits == ""
		for let c in digits {
			fail "bson: \"{text}\" is not an integer" unless c.isDigit()
		}
		let n = try parseBigInt(text)
		fail "bson: {text} is out of range" when n < min || n > max
		return int64(n)
	}

	// A $numberDouble string: a decimal number or Infinity, -Infinity, NaN.
	internal def bsonDoubleOf(text string) !float {
		return 0.0 / 0.0 when text == "NaN"
		return 1.0 / 0.0 when text == "Infinity"
		return -1.0 / 0.0 when text == "-Infinity"
		let b = text.bytes()
		let i = 0
		i++ when b.len() > 0 && b[0] == byte(45)
		let digits = 0
		let point = false
		for i < b.len() {
			if b[i] >= byte(48) && b[i] <= byte(57) {
				digits++
			} else if b[i] == byte(46) && !point {
				point = true
			} else {
				break
			}
			i++
		}
		fail "bson: \"{text}\" is not a double" when digits == 0
		if i < b.len() && (b[i] == byte(101) || b[i] == byte(69)) {
			i++
			i++ when i < b.len() && (b[i] == byte(43) || b[i] == byte(45))
			let start = i
			for i < b.len() && b[i] >= byte(48) && b[i] <= byte(57) {
				i++
			}
			fail "bson: \"{text}\" is not a double" when i == start
		}
		fail "bson: \"{text}\" is not a double" when i != b.len()
		return parseFloat<float>(text)
	}

	// Reads one JSON value into a node that keeps what Extended JSON needs:
	// number text as written, string bytes (U+0000 included), names in order.
	internal def bsonJSONNode(cur JSONCursor, depth int, maxDepth int) !BSONJSONNode {
		expects {
			assert depth < maxDepth onerror fail "bson: JSON nests deeper than {maxDepth} levels"
		}
		cur.skipSpace()
		let node = new BSONJSONNode()
		let ch = cur.peek()
		if ch == '"' {
			node.kind = 3
			node.raw = try cur.parseStringBytes()
			return node
		}
		if ch := '{' || '[' {
			let object = ch == '{'
			node.kind = object ?? (5, 4)
			cur.bump()
			cur.skipSpace()
			let close = object ?? ('}', ']')
			if cur.peek() == close {
				cur.bump()
				return node
			}
			for {
				if object {
					cur.skipSpace()
					fail "bson: expected a name at offset {cur.pos}" unless cur.peek() == '"'
					node.names.push(try cur.parseStringBytes())
					cur.skipSpace()
					fail "bson: expected ':' at offset {cur.pos}" unless cur.peek() == ':'
					cur.bump()
				}
				node.items.push(try bsonJSONNode(cur, depth + 1, maxDepth))
				cur.skipSpace()
				if cur.peek() == ',' {
					cur.bump()
					continue
				}
				fail "bson: expected ',' or '{close}' at offset {cur.pos}" unless cur.peek() == close
				cur.bump()
				return node
			}
		}
		if ch := 't' || 'f' {
			node.kind = 1
			node.flag = ch == 't'
			try cur.literal(node.flag ?? ("true", "false"))
			return node
		}
		if ch == 'n' {
			try cur.literal("null")
			return node
		}
		node.kind = 2
		node.text = try cur.numberText()
		return node
	}
}

internal partial module std.data.encoding.bson {
	// One JSON value as Extended JSON reads it.
	type BSONJSONNode {
		// 0 null, 1 bool, 2 number, 3 string, 4 array, 5 object.
		kind  int            = 0
		flag  bool
		// A number as written.
		text  string
		// A string's UTF-8 bytes.
		raw   byte[]
		// An object's names, in order.
		names byte[][]
		// An array's elements or an object's values.
		items BSONJSONNode[]

		// The object's names as text, for matching wrapper keys.
		def nameTexts() string[] {
			let out string[] = []
			for let name in names {
				out.push(string(name))
			}
			return out
		}

		// Whether the object has the name.
		def has(name string) bool {
			let want = name.bytes()
			for let have in names {
				return true when have.equals(want)
			}
			return false
		}

		// The value under the name; a null node when absent.
		def at(name string) BSONJSONNode {
			let want = name.bytes()
			for let (i, have) in names {
				return items[i] when have.equals(want)
			}
			return new BSONJSONNode()
		}
	}
}
