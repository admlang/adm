partial module std.data.encoding {
	use (
		std.testing
		std.time
		std.crypto::(UUID, parseUUID)
		std.math::(Decimal, parseDecimal)
	)

	enum BSONColour {
		Red,
		Green,
	}

	struct BSONAddress {
		city string
		zip  string
	}

	struct BSONCustomer {
		@bson("_id")
		id ObjectId

		name   string
		visits int
		total  int64
		small  int32
		ratio  float
		active bool
		since  time.Time
		key    byte[]
		ref    UUID
		price  Decimal
		colour BSONColour
		wait   duration
		home   BSONAddress
		scores int[]
		tags   map<string, int>
		nick   ?string
		extra  any
		raw    BSONValue

		@bson(omitempty = true)
		note string

		@bson(ignore = true)
		secret string
	}

	// Hands out one byte per read, so the reader has to refill inside a
	// document.
	type BSONTrickle {
		internal data byte[]
		internal at   int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def read(buf byte[]) !int {
			return 0 when at >= data.len() || buf.len() == 0
			buf[0] = data[at]
			at++
			return 1
		}
	}

	def bsx(text string) byte[] {
		return hexdecode(text) onerror recover byte[]
	}

	check "BSON" {
		// The two examples of bsonspec.org, byte for byte both ways.
		@test()
		def matchesTheSpecificationExamples() !none {
			let codec = new BSON()
			let hello = try codec.parse(bsx("160000000268656c6c6f0006000000776f726c640000"))
			assert try hello.get("hello").asString() == "world"
			assert (try codec.encode(hello)).hex().lower() == "160000000268656c6c6f0006000000776f726c640000"
			let data = bsx("310000000442534f4e002600000002300008000000617765736f6d65000131003333333333331440103200c20700000000")
			let doc = try codec.parse(data)
			let list = doc.get("BSON")
			assert list.kind == BSONKind.Array && list.len() == 3
			assert try list.at(0).asString() == "awesome"
			assert try list.at(1).asFloat() == 5.05
			assert list.at(2).kind == BSONKind.Int32 && try list.at(2).asInt() == 1986
			assert (try codec.encode(doc)).equals(data)
			let built = new BSONValue(BSONKind.Document)
			built.set("BSON", new BSONValue([new BSONValue("awesome"), new BSONValue(5.05), new BSONValue(1986)]))
			assert (try codec.encode(built)).equals(data)
			assert doc.json() == "\{\"BSON\":[\"awesome\",5.05,1986]\}"
		}

		// An ObjectId never set has no bytes: its field is left out, an array
		// holds null for it, and a parsed document binds back onto a
		// BSONValue as itself.
		@test()
		def leavesOutUnsetObjectIds() !none {
			let codec = new BSON()
			let address = BSONAddress{city: "Oslo", zip: "0150"}
			let customer = BSONCustomer{name: "Ana", home: address}
			let doc = try codec.parse(try codec.encode(customer))
			assert !doc.has("_id") && (try doc.get("name").asString()) == "Ana"
			let ids = [new ObjectId(), ObjectId{}]
			let holder = map<string, ObjectId[]>{"ids": ids}
			let list = (try codec.parse(try codec.encode(holder))).get("ids")
			assert list.at(0).kind == BSONKind.ObjectId && list.at(1).kind == BSONKind.Null
			let tree = new BSONValue()
			try codec.bind(doc, tree)
			assert tree.equals(doc)
		}

		// Every kind survives bytes and both JSON forms, and the canonical text is
		// the one Extended JSON v2 defines.
		@test()
		def everyKindRoundTrips() !none {
			let codec = new BSON()
			let id = try parseObjectId("507f1f77bcf86cd799439011")
			let scope = new BSONValue(BSONKind.Document).set("x", new BSONValue(1))
			let doc = new BSONValue(BSONKind.Document)
			doc.set("d", new BSONValue(-0.0))
			doc.set("s", new BSONValue("é\"\n"))
			doc.set("o", new BSONValue(BSONKind.Document).set("a", new BSONValue(true)))
			doc.set("a", new BSONValue([new BSONValue(1), new BSONValue(BSONKind.Null)]))
			doc.set("b", new BSONValue(byte[0xFF, 0xFF], 0x80))
			doc.set("u", new BSONValue(BSONKind.Undefined))
			doc.set("id", new BSONValue(id))
			doc.set("t", new BSONValue(BSONKind.DateTime, int64(1356351330501)))
			doc.set("r", new BSONValue(BSONKind.Regex, "^a/b", "mi"))
			doc.set("p", new BSONValue("db.c", id))
			doc.set("js", new BSONValue(BSONKind.JavaScript, "f()"))
			doc.set("sym", new BSONValue(BSONKind.Symbol, "s"))
			doc.set("jss", new BSONValue("g()", scope))
			doc.set("i", new BSONValue(int32(-7)))
			doc.set("ts", new BSONValue(uint32(4000000000), uint32(1)))
			doc.set("l", new BSONValue(int64(5)))
			doc.set("m", new BSONValue(try parseDecimal128("1.50")))
			doc.set("min", new BSONValue(BSONKind.MinKey))
			doc.set("max", new BSONValue(BSONKind.MaxKey))
			let canonical = "\{\"d\":\{\"$numberDouble\":\"-0.0\"\},\"s\":\"é\\\"\\n\",\"o\":\{\"a\":true\},\"a\":[\{\"$numberInt\":\"1\"\},null],\"b\":\{\"$binary\":\{\"base64\":\"//8=\",\"subType\":\"80\"\}\},\"u\":\{\"$undefined\":true\},\"id\":\{\"$oid\":\"507f1f77bcf86cd799439011\"\},\"t\":\{\"$date\":\{\"$numberLong\":\"1356351330501\"\}\},\"r\":\{\"$regularExpression\":\{\"pattern\":\"^a/b\",\"options\":\"im\"\}\},\"p\":\{\"$dbPointer\":\{\"$ref\":\"db.c\",\"$id\":\{\"$oid\":\"507f1f77bcf86cd799439011\"\}\}\},\"js\":\{\"$code\":\"f()\"\},\"sym\":\{\"$symbol\":\"s\"\},\"jss\":\{\"$code\":\"g()\",\"$scope\":\{\"x\":\{\"$numberInt\":\"1\"\}\}\},\"i\":\{\"$numberInt\":\"-7\"\},\"ts\":\{\"$timestamp\":\{\"t\":4000000000,\"i\":1\}\},\"l\":\{\"$numberLong\":\"5\"\},\"m\":\{\"$numberDecimal\":\"1.50\"\},\"min\":\{\"$minKey\":1\},\"max\":\{\"$maxKey\":1\}\}"
			assert doc.json(ExtendedJSON.Canonical) == canonical
			let back = try codec.parse(try codec.encode(doc))
			assert back.equals(doc)
			assert (try codec.parseJSON(canonical)).equals(doc)
			assert (try codec.parseJSON(doc.json())).json() == doc.json()
			let relaxed = doc.json()
			assert relaxed.contains("\"d\":-0.0") && relaxed.contains("\"t\":\{\"$date\":\"2012-12-24T12:15:30.501Z\"\}") && relaxed.contains("\"i\":-7") && relaxed.contains("\"l\":5")
			let (pattern, options) = try back.get("r").asRegex()
			assert pattern == "^a/b" && options == "im"
			let (seconds, increment) = try back.get("ts").asTimestamp()
			assert seconds == uint32(4000000000) && increment == uint32(1)
			let (namespace, target) = try back.get("p").asDBPointer()
			assert namespace == "db.c" && target.equals(id)
			assert try back.get("jss").scope().get("x").asInt() == 1
			assert back.get("b").subtype == 0x80
			assert back.names().len() == 19 && back.entries()[3].0 == "a"
			assert (try back.get("id").asObjectId()).equals(id) && (try back.get("m").asDecimal128()).str() == "1.50"
			assert back.get("m").asObjectId() is error && back.get("id").asDecimal128() is error
		}

		// Relaxed numbers: integers by size, doubles always with a point or an
		// exponent; non-finite doubles and dates outside 1970 to 9999 stay wrapped.
		@test()
		def writesRelaxedNumbersAndDates() !none {
			let doc = new BSONValue(BSONKind.Document)
			doc.set("a", new BSONValue(1.0))
			doc.set("b", new BSONValue(1e16))
			doc.set("c", new BSONValue(1.2345678921232e18))
			doc.set("d", new BSONValue(0.0001))
			doc.set("e", new BSONValue(0.00001))
			doc.set("f", new BSONValue(5e-324))
			doc.set("g", new BSONValue(1.0 / 0.0))
			doc.set("h", new BSONValue(5000000000))
			doc.set("i", new BSONValue(BSONKind.DateTime, int64(-1)))
			doc.set("j", new BSONValue(BSONKind.DateTime, int64(0)))
			assert doc.json() == "\{\"a\":1.0,\"b\":1.0E+16,\"c\":1.2345678921232E+18,\"d\":0.0001,\"e\":1.0E-5,\"f\":5.0E-324,\"g\":\{\"$numberDouble\":\"Infinity\"\},\"h\":5000000000,\"i\":\{\"$date\":\{\"$numberLong\":\"-1\"\}\},\"j\":\{\"$date\":\"1970-01-01T00:00:00Z\"\}\}"
			let read = try new BSON().parseJSON(doc.json())
			assert read.get("h").kind == BSONKind.Int64 && read.get("a").kind == BSONKind.Double
			assert try read.get("b").asFloat() == 1e16 && try read.get("f").asFloat() == 5e-324
			let small = try new BSON().parseJSON("\{\"n\":7,\"m\":-2147483649,\"x\":1e400\}")
			assert small.get("n").kind == BSONKind.Int32 && small.get("m").kind == BSONKind.Int64
			let zoned = try new BSON().parseJSON("\{\"$date\":\"2012-12-24T14:15:30.5019+02:00\"\}")
			assert try zoned.asDateTime() == int64(1356351330501)
		}

		// Wrapper objects with a missing, extra or mistyped key fail; the legacy forms
		// read; query operators that share a name ($regex, $type) stay documents.
		@test()
		def readsExtendedJSONStrictly() !none {
			let codec = new BSON()
			for let text in ["\{\"a\":\{\"$numberInt\":42\}\}", "\{\"a\":\{\"$numberInt\":\"42\",\"b\":1\}\}", "\{\"a\":\{\"$numberInt\":\"2147483648\"\}\}", "\{\"a\":\{\"$oid\":\"zz\"\}\}", "\{\"a\":\{\"$binary\":\{\"base64\":\"//8=\"\}\}\}", "\{\"a\":\{\"$timestamp\":\{\"t\":\"1\",\"i\":1\}\}\}", "\{\"a\":\{\"$date\":42\}\}", "\{\"a\":\{\"$minKey\":0\}\}", "\{\"a\\u0000\":1\}", "\{\"a\":\{\"$regularExpression\":\{\"pattern\":\"a\\u0000\",\"options\":\"\"\}\}\}", "\{\"a\":\{\"$uuid\":\"73ffd26444b34c6990e8e7d1dfc035d4\"\}\}", "\{\"a\":1", "\{\"a\":1\} x"] {
				assert codec.parseJSON(text) is error
			}
			let legacy = try codec.parseJSON("\{\"b\":\{\"$binary\":\"//8=\",\"$type\":\"5\"\},\"r\":\{\"$regex\":\"x\",\"$options\":\"si\"\},\"u\":\{\"$uuid\":\"73ffd264-44b3-4c69-90e8-e7d1dfc035d4\"\}\}")
			assert legacy.get("b").subtype == 5 && (try legacy.get("b").asBytes()).hex().lower() == "ffff"
			assert legacy.get("r").json() == "\{\"$regularExpression\":\{\"pattern\":\"x\",\"options\":\"is\"\}\}"
			assert (try legacy.get("u").asUUID()).str() == "73ffd264-44b3-4c69-90e8-e7d1dfc035d4"
			let query = try codec.parseJSON("\{\"$regex\":\{\"$regularExpression\":\{\"pattern\":\"p\",\"options\":\"\"\}\},\"$options\":\"ix\",\"t\":\{\"$type\":\"string\"\}\}")
			assert query.kind == BSONKind.Document && query.get("$regex").kind == BSONKind.Regex && query.get("t").kind == BSONKind.Document
			let nul = try codec.parseJSON("\"a\\u0000b\"")
			assert (try nul.asBytes()).hex() == "610062" && nul.asString() is error
		}

		// Damaged bytes fail instead of reading past their bounds.
		@test()
		def refusesMalformedBytes() !none {
			let codec = new BSON()
			for let text in ["", "0500000001", "0400000000", "05000000ff", "1600000002", "0d000000086100020000", "0c0000000261000000000000", "0d000000026100ffffffff0000", "0e00000002610002000000ff0000", "0d000000206100010000000000", "1300000005780006000000020300000000ff00", "050000000000", "0c000000106100010000000000"] {
				assert codec.parse(bsx(text)) is error
			}
			let deep = new BSONValue(BSONKind.Document)
			for let i = 0; i < 120; i++ {
				deep = new BSONValue(BSONKind.Document).set("x", deep)
			}
			let data = try codec.encode(deep)
			assert codec.parse(data) is error
			let wide = new BSON()
			wide.maxDepth = 200
			assert !(wide.parse(data) is error)
		}

		// The old Binary subtype 2 carries its length twice; it reads and writes that
		// way, and a wrong inner length fails.
		@test()
		def keepsTheOldBinaryForm() !none {
			let codec = new BSON()
			let data = bsx("13000000057800060000000202000000ffff00")
			let doc = try codec.parse(data)
			assert doc.get("x").subtype == 2 && (try doc.get("x").asBytes()).hex().lower() == "ffff"
			assert (try codec.encode(doc)).equals(data)
			assert codec.parse(bsx("13000000057800060000000203000000ffff00")) is error
		}

		// Objects encode field by field: ints by size, int64 and int32 by
		// declaration, the special types as their BSON kinds, @bson names,
		// omitempty and ignore; decode restores every field.
		@test()
		def bindsObjects() !none {
			let codec = new BSON()
			let c = new BSONCustomer()
			c.id = try parseObjectId("507f1f77bcf86cd799439011")
			c.name = "Ada"
			c.visits = 3
			c.total = int64(4)
			c.small = int32(5)
			c.ratio = 0.25
			c.active = true
			c.since = time.fromUnixNs(int64(1356351330501) * 1000000)
			c.key = byte[1, 2]
			c.ref = try parseUUID("73ffd264-44b3-4c69-90e8-e7d1dfc035d4")
			c.price = try parseDecimal("19.99")
			c.colour = BSONColour.Green
			c.wait = 2s
			c.home = {city: "Cluj", zip: "400000"}
			c.scores = [1, 2, 3]
			c.tags = map<string, int>{"a": 1}
			c.extra = map<string, any>{"k": "v"}
			c.raw = new BSONValue(BSONKind.MinKey)
			c.secret = "x"
			let data = try codec.encode(c)
			let doc = try codec.parse(data)
			assert doc.names().indexOf("note") < 0 && doc.names().indexOf("secret") < 0 && doc.names()[0] == "_id"
			assert doc.get("_id").kind == BSONKind.ObjectId && doc.get("visits").kind == BSONKind.Int32
			assert doc.get("total").kind == BSONKind.Int64 && doc.get("small").kind == BSONKind.Int32
			assert doc.get("since").kind == BSONKind.DateTime && doc.get("key").kind == BSONKind.Binary
			assert doc.get("ref").subtype == 4 && doc.get("price").json() == "\{\"$numberDecimal\":\"19.99\"\}"
			assert try doc.get("colour").asInt() == 1 && try doc.get("wait").asInt() == 2000000000
			assert doc.get("nick").kind == BSONKind.Null && doc.get("raw").kind == BSONKind.MinKey
			let out = new BSONCustomer()
			try codec.decode(data, out)
			assert out.id.equals(c.id) && out.name == "Ada" && out.visits == 3 && out.total == int64(4) && out.small == int32(5)
			assert out.ratio == 0.25 && out.active && out.since.unixNs() == c.since.unixNs() && out.key.equals(c.key)
			assert out.ref.equals(c.ref) && out.price.str() == "19.99" && out.colour == BSONColour.Green && out.wait == 2s
			assert out.home.city == "Cluj" && out.scores.equals([1, 2, 3]) && out.tags["a"] == 1 && out.nick is none
			assert out.raw.kind == BSONKind.MinKey && out.secret == ""
			let extra = out.extra
			assert extra is map<string, any>
			assert codec.encode(byte[1]) is error && codec.encode(new BSONValue(1)) is error
		}

		// A reader takes documents one after another, from bytes and from a stream
		// that yields one byte at a time.
		@test()
		def readsDocumentStreams() !none {
			let one = bsx("160000000268656c6c6f0006000000776f726c640000")
			let both = one + one
			for let r in [new BSONReader(both), new BSONReader(new BSONTrickle(both))] {
				let count = 0
				for try r.more() {
					let doc = try r.next()
					assert try doc.get("hello").asString() == "world"
					count++
				}
				assert count == 2 && r.pos == 44
			}
			let cut = new BSONReader(new BSONTrickle(one[:10]))
			assert cut.next() is error
		}

		// Vectors of floats, signed bytes and bits, with the padding rules of the
		// binary vector specification.
		@test()
		def holdsVectors() !none {
			let floats = new BSONValue(float32[127.0, -7.5])
			let vt = floats.vectorType
			assert !(vt is none) && vt == BSONVectorType.Float32
			assert (try floats.asBytes()).hex().lower() == "27000000fe420000f0c0"
			assert (try floats.asFloat32Vector()).equals(float32[127.0, -7.5])
			let bytes = new BSONValue(int8[127, -1])
			assert (try bytes.asBytes()).hex().lower() == "03007fff" && (try bytes.asInt8Vector()).equals(int8[127, -1])
			let bits = new BSONValue([false, true, true, true, true, true, true, true, false, false, false, false, true])
			assert (try bits.asBytes()).hex().lower() == "10037f08"
			assert (try bits.asBitVector()).len() == 13 && (try bits.asBitVector())[12]
			assert new BSONValue(bsx("270300000000"), 9).asFloat32Vector() is error
			assert new BSONValue(bsx("2700000000"), 9).asFloat32Vector() is error
			assert new BSONValue(bsx("1001"), 9).asBitVector() is error
			assert new BSONValue(bsx("100801"), 9).asBitVector() is error
			assert new BSONValue(bsx("03017f"), 9).asInt8Vector() is error
			assert floats.asInt8Vector() is error && new BSONValue(byte[1]).vectorType is none
		}
	}

	check "ObjectId" {
		@test()
		def parsesAndOrders() !none {
			let id = try parseObjectId("507F1F77BCF86CD799439011")
			assert id.str() == "507f1f77bcf86cd799439011"
			assert id.timestamp().unixNs() == int64(1350508407) * 1000000000
			assert (try parseObjectId(id.bytes())).equals(id)
			for let text in ["", "507f1f77bcf86cd79943901", "507f1f77bcf86cd79943901g"] {
				assert parseObjectId(text) is error
			}
			let a = new ObjectId()
			let b = new ObjectId()
			assert !a.equals(b) && a.bytes()[4:9].equals(b.bytes()[4:9])
			let seconds = a.timestamp().unixNs() / 1000000000
			assert seconds <= time.wallNs() / 1000000000 && seconds >= time.wallNs() / 1000000000 - 2
			assert id.compare(a) == -1 && a.compare(id) == 1 && id.compare(id) == 0
			let seen = map<ObjectId, int>{}
			seen = seen.set(id, 1)
			seen = seen.set(try parseObjectId(id.str()), 2)
			assert seen.len() == 1
		}
	}

	check "Decimal128" {
		// The text forms of the BSON specification: plain while the exponent is at
		// most 0 and the adjusted exponent at least -6, else scientific.
		@test()
		def writesTheSpecificationForms() !none {
			for let pair in [("1.50", "1.50"), ("-0.0", "-0.0"), ("0", "0"), ("1000", "1000"), ("1E+3", "1E+3"), ("0.000001", "0.000001"), ("0.0000001", "1E-7"), ("-12.3E-10", "-1.23E-9"), (".5", "0.5"), ("1.", "1"), ("inf", "Infinity"), ("-Infinity", "-Infinity"), ("NaN", "NaN"), ("9999999999999999999999999999999999E+6111", "9.999999999999999999999999999999999E+6144"), ("1E+6112", "1.0E+6112"), ("1000000000000000000000000000000000000", "1.000000000000000000000000000000000E+36"), ("0E-7000", "0E-6176")] {
				assert (try parseDecimal128(pair.0)).str() == pair.1
			}
			for let text in ["", "1.e", "-", "1e", "1.2.3", "1E+6145", "12345678901234567890123456789012345", "1E-6177", " 1", "Infinit"] {
				assert parseDecimal128(text) is error
			}
		}

		// Sixteen bytes low first; the exact Decimal of a finite value.
		@test()
		def convertsBytesAndDecimals() !none {
			let one = new Decimal128(1)
			assert one.bytes().hex().lower() == "01000000000000000000000000004030"
			assert (try parseDecimal128(one.bytes())).equals(one) && one.str() == "1"
			assert new Decimal128(-9223372036854775807 - 1).str() == "-9223372036854775808"
			assert new Decimal128().str() == "0"
			let price = try parseDecimal128("19.990")
			assert (try price.toDecimal()).str() == "19.990"
			assert (try parseDecimal128("NaN")).isNaN() && !price.isNaN()
			assert (try parseDecimal128("NaN")).toDecimal() is error && (try parseDecimal128("Inf")).isInfinite()
			assert !price.equals(try parseDecimal128("19.99")) && (try parseDecimal128("-0")).isNegative()
		}
	}
}
