partial module std.data.encoding {
	use (
		std.time
		std.crypto
		std.math::(Decimal)
	)

	// The 5 random bytes every ObjectId of this process carries, and the
	// counter of its last 3 bytes, starting at a random value.
	internal let objectIdProcess byte[]
	internal let objectIdCounter uint32 = 0

	// ObjectId is the 12-byte identifier MongoDB gives documents (`_id`): 4
	// bytes of Unix seconds, 5 random bytes fixed for the process and a 3-byte
	// counter, all big-endian, written as 24 hexadecimal digits. Identifiers
	// made in a later second sort after those made earlier; two of the same
	// bytes are equal, and an ObjectId is a map key.
	@portable
	type ObjectId {
		internal id byte[]

		// A new identifier for the current second. Fails an assertion on a
		// system without a random source.
		def new() {
			id = objectIdNext()
		}

		// fromBytes sets the identifier from its 12 bytes. Fails when the
		// length is not 12.
		def fromBytes(b byte[]) !none {
			expects {
				assert b.len() == 12 onerror fail "bson: an ObjectId is 12 bytes, not {b.len()}"
			}
			id = b.clone()
			return none
		}

		// fromString sets the identifier from 24 hexadecimal digits in either
		// case and returns it. Fails on any other text.
		def fromString(s string) !ObjectId {
			let parsed = objectIdOfHex(s)
			fail "bson: \"{s}\" is not 24 hexadecimal digits" when parsed.len() != 12
			id = parsed
			return self
		}

		// The 12 bytes of the identifier, a copy.
		def bytes() byte[] {
			return id.clone()
		}

		// The second the identifier was made in.
		def timestamp() time.Time {
			let seconds = (int64(id[0]) << 24) | (int64(id[1]) << 16) | (int64(id[2]) << 8) | int64(id[3])
			return time.fromUnixNs(seconds * 1000000000)
		}

		// Whether the two identifiers hold the same bytes.
		def equals(other ObjectId) bool {
			return id.equals(other.id)
		}

		// -1 when this identifier sorts before other, 1 when after, 0 when
		// equal: byte order, which is MongoDB's order.
		def compare(other ObjectId) int {
			let theirs = other.id
			for let i = 0; i < 12; i++ {
				return -1 when id[i] < theirs[i]
				return 1 when id[i] > theirs[i]
			}
			return 0
		}

		// The hash a map keys the identifier by.
		def hash() uint64 {
			let out uint64 = 0
			for let b in id {
				out = (out << 5) ^ (out >> 59) ^ uint64(b)
			}
			return out
		}

		// str renders the identifier as 24 lower-case hexadecimal digits.
		def str() string {
			return id.hex().lower()
		}
	}

	// The next identifier's bytes: the current second, the process bytes and
	// the counter, which wraps at 2^24.
	internal atomic def objectIdNext() byte[] {
		if objectIdProcess.len() == 0 {
			objectIdProcess = bsonRandom(5)
			let start = bsonRandom(3)
			objectIdCounter = (uint32(start[0]) << 16) | (uint32(start[1]) << 8) | uint32(start[2])
		}
		objectIdCounter = (objectIdCounter + 1) & 0xFFFFFF
		let seconds = time.wallNs() / 1000000000
		let out = byte[]
		out.len(12)
		out[0] = byte((seconds >> 24) & 0xFF)
		out[1] = byte((seconds >> 16) & 0xFF)
		out[2] = byte((seconds >> 8) & 0xFF)
		out[3] = byte(seconds & 0xFF)
		objectIdProcess.copy(out[4:9])
		out[9] = byte((objectIdCounter >> 16) & 0xFF)
		out[10] = byte((objectIdCounter >> 8) & 0xFF)
		out[11] = byte(objectIdCounter & 0xFF)
		return out
	}

	// Random bytes for an identifier; a system without a random source makes
	// none that are unique, so it fails an assertion.
	internal def bsonRandom(n int) byte[] {
		let ok = true
		let nothing byte[]
		let b = crypto.rand(n) onerror (err error) {
			ok = false
			recover nothing
		}
		assert ok
		return b
	}

	// The 12 bytes of 24 hexadecimal digits; empty for any other text.
	internal def objectIdOfHex(s string) byte[] {
		let nothing byte[]
		return nothing when s.len() != 24
		for let c in s {
			return nothing unless c.isHexDigit()
		}
		let out = byte[]
		out.len(12)
		for let i = 0; i < 12; i++ {
			out[i] = parseInt<byte>(s[i * 2:i * 2 + 2], 16)
		}
		return out
	}

	// parseObjectId returns the ObjectId of 24 hexadecimal digits. Fails on
	// any other text.
	def parseObjectId(text string) !ObjectId {
		let id = new ObjectId()
		try id.fromString(text)
		return id
	}

	// parseObjectId returns the ObjectId of 12 bytes. Fails when the length is
	// not 12.
	def parseObjectId(b byte[]) !ObjectId {
		let id = new ObjectId()
		try id.fromBytes(b)
		return id
	}

	// The exponent bias of a Decimal128 and the range of its exponent.
	internal const decimal128Bias = 6176
	internal const decimal128MinExp = -6176
	internal const decimal128MaxExp = 6111

	// Decimal128 is a 128-bit decimal floating-point number (IEEE 754-2008,
	// binary integer decimal encoding), as BSON stores it: up to 34 significant
	// digits, an exponent from -6176 to 6111, a sign, and the infinities and
	// NaN. It keeps the digits it was given, so "1.50" stays "1.50".
	// `parseDecimal128` reads text and `str` writes it as the BSON
	// specification does; `toDecimal` gives the exact `std.math.Decimal`.
	//
	//     let price = try parseDecimal128("19.99")
	//     let exact = try price.toDecimal()
	@portable
	type Decimal128 {
		// The high 64 bits: sign, combination field, exponent and the top of
		// the coefficient.
		internal hi uint64 = 0x3040000000000000
		// The low 64 bits of the coefficient.
		internal lo uint64

		// Zero.
		def new() {}

		// The integer, exactly.
		def new(value int) {
			let negative = value < 0
			lo = negative ?? (uint64(-(value + 1)) + 1, uint64(value))
			hi = negative ?? (uint64(1) << 63 | 0x3040000000000000, 0x3040000000000000)
		}

		// fromBytes sets the number from its 16 bytes, low bits first (BSON's
		// order). Fails when the length is not 16.
		def fromBytes(b byte[]) !none {
			expects {
				assert b.len() == 16 onerror fail "bson: a Decimal128 is 16 bytes, not {b.len()}"
			}
			lo = 0
			hi = 0
			for let i = 7; i >= 0; i-- {
				lo = (lo << 8) | uint64(b[i])
				hi = (hi << 8) | uint64(b[i + 8])
			}
			return none
		}

		// The 16 bytes of the number, low bits first.
		def bytes() byte[] {
			let out = byte[]
			out.len(16)
			for let i = 0; i < 8; i++ {
				out[i] = byte((lo >> (i * 8)) & 0xFF)
				out[i + 8] = byte((hi >> (i * 8)) & 0xFF)
			}
			return out
		}

		// Whether the value is NaN.
		def isNaN() bool {
			return (hi >> 58) & 0x1F == 0x1F
		}

		// Whether the value is positive or negative infinity.
		def isInfinite() bool {
			return (hi >> 58) & 0x1F == 0x1E
		}

		// Whether the sign bit is set: true for negative numbers, -0 and
		// -Infinity.
		def isNegative() bool {
			return hi >> 63 == 1
		}

		// The exact value as a `std.math.Decimal`, coefficient and exponent as
		// stored. Fails for NaN and the infinities.
		def toDecimal() !Decimal {
			fail "bson: NaN has no decimal value" when isNaN()
			fail "bson: an infinity has no decimal value" when isInfinite()
			let (coefficient, exponent) = decimal128Fields(hi, lo)
			let c = bigint(uint64(coefficient >> 64)) * (bigint(1) << 64) + bigint(uint64(coefficient & 0xFFFFFFFFFFFFFFFF))
			return new Decimal(isNegative() ?? (bigint(0) - c, c), exponent)
		}

		// Whether the two hold the same bits: 1.0 and 1.00 differ, as they do
		// in BSON.
		def equals(other Decimal128) bool {
			return hi == other.hi && lo == other.lo
		}

		// The hash a map keys the number by: its bits.
		def hash() uint64 {
			return hi ^ (lo * 0x9E3779B97F4A7C15)
		}

		// str writes the number as the BSON specification does: plain
		// notation when the exponent is at most 0 and the adjusted exponent at
		// least -6 ("1.50", "-0.000001"), else scientific ("1.5E+3", "1E-7");
		// "Infinity", "-Infinity" and "NaN".
		def str() string {
			return decimal128Text(hi, lo)
		}
	}

	// parseDecimal128 reads a decimal number: an optional sign, digits with an
	// optional "." and exponent ("19.99", "-1E+3", ".5"), or "Infinity",
	// "Inf" or "NaN" in any case. A value with more than 34 significant
	// digits is shortened only by dropping trailing zeros, and an exponent out
	// of range is brought in only by adding or dropping zeros, so the result
	// is always exact. Fails on other text, and on a value Decimal128 cannot
	// hold exactly.
	def parseDecimal128(text string) !Decimal128 {
		let (hi, lo) = try decimal128Parse(text)
		let out = new Decimal128()
		out.hi = hi
		out.lo = lo
		return out
	}

	// parseDecimal128 returns the Decimal128 of 16 bytes, low bits first.
	// Fails when the length is not 16.
	def parseDecimal128(b byte[]) !Decimal128 {
		let out = new Decimal128()
		try out.fromBytes(b)
		return out
	}

	// The coefficient and unbiased exponent of a finite value. A coefficient
	// past 10^34 - 1, or one in the form whose implied bits put it there,
	// reads as zero, as the standard says.
	internal def decimal128Fields(hi uint64, lo uint64) (uint128, int) {
		return (uint128(0), int((hi >> 47) & 0x3FFF) - decimal128Bias) when (hi >> 61) & 3 == 3
		let c = (uint128(hi & 0x1FFFFFFFFFFFF) << 64) | uint128(lo)
		let max = decimal128Pow10(34) - uint128(1)
		return (c > max ?? (uint128(0), c), int((hi >> 49) & 0x3FFF) - decimal128Bias)
	}

	internal def decimal128Pow10(n int) uint128 {
		let out = uint128(1)
		for let i = 0; i < n; i++ {
			out = out * uint128(10)
		}
		return out
	}

	internal def decimal128Text(hi uint64, lo uint64) string {
		let sign = hi >> 63 == 1 ?? ("-", "")
		let combination = (hi >> 58) & 0x1F
		return "NaN" when combination == 0x1F
		return sign + "Infinity" when combination == 0x1E
		let (coefficient, e) = decimal128Fields(hi, lo)
		let digits = coefficient.str()
		let adjusted = e + digits.len() - 1
		if e <= 0 && adjusted >= -6 {
			return sign + digits when e == 0
			let point = digits.len() + e
			return sign + digits[:point] + "." + digits[point:] when point > 0
			return sign + "0." + "0".repeat(-point) + digits
		}
		let mantissa = digits.len() > 1 ?? (digits[:1] + "." + digits[1:], digits)
		return sign + mantissa + "E" + (adjusted >= 0 ?? ("+", "")) + adjusted.str()
	}

	// The bits of the decimal number text writes; see parseDecimal128.
	internal def decimal128Parse(text string) !(uint64, uint64) {
		let b = text.bytes()
		let i = 0
		let negative = false
		if b.len() > 0 && (b[0] == byte(43) || b[0] == byte(45)) {
			negative = b[0] == byte(45)
			i = 1
		}
		let sign = negative ?? (uint64(1) << 63, uint64(0))
		let word = string(b[i:]).lower()
		return (sign | 0x7800000000000000, uint64(0)) when word := "inf" || "infinity"
		return (uint64(0x7C00000000000000), uint64(0)) when word == "nan"
		// The significant digits, leading zeros left out, and how many of all
		// digits came after the point.
		let digits byte[]
		let seen = false
		let point = false
		let fraction = 0
		for i < b.len() {
			let c = b[i]
			if c >= byte(48) && c <= byte(57) {
				seen = true
				fraction++ when point
				digits.push(c) when digits.len() > 0 || c != byte(48)
			} else if c == byte(46) && !point {
				point = true
			} else {
				break
			}
			i++
		}
		fail "bson: \"{text}\" is not a decimal number" unless seen
		let exponent = 0
		if i < b.len() && (b[i] == byte(101) || b[i] == byte(69)) {
			i++
			let expNegative = false
			if i < b.len() && (b[i] == byte(43) || b[i] == byte(45)) {
				expNegative = b[i] == byte(45)
				i++
			}
			let start = i
			for i < b.len() && b[i] >= byte(48) && b[i] <= byte(57) {
				// Past any exponent a Decimal128 can reach: kept large, the
				// range checks below refuse it.
				exponent = exponent * 10 + int(b[i] - byte(48)) when exponent < 100000000
				i++
			}
			fail "bson: \"{text}\" has no exponent digits" when i == start
			exponent = -exponent when expNegative
		}
		fail "bson: \"{text}\" is not a decimal number" when i != b.len()
		exponent -= fraction
		if digits.len() == 0 {
			exponent = decimal128MinExp when exponent < decimal128MinExp
			exponent = decimal128MaxExp when exponent > decimal128MaxExp
			return (sign | (uint64(exponent + decimal128Bias) << 49), uint64(0))
		}
		for digits.len() > 34 && digits[-1] == byte(48) {
			digits.pop()
			exponent++
		}
		fail "bson: \"{text}\" has more than 34 significant digits" when digits.len() > 34
		for exponent > decimal128MaxExp && digits.len() < 34 {
			digits.push(byte(48))
			exponent--
		}
		fail "bson: \"{text}\" is too large for a Decimal128" when exponent > decimal128MaxExp
		for exponent < decimal128MinExp && digits[-1] == byte(48) {
			digits.pop()
			exponent++
		}
		fail "bson: \"{text}\" is too small for a Decimal128 to hold exactly" when exponent < decimal128MinExp
		let coefficient = uint128(0)
		for let d in digits {
			coefficient = coefficient * uint128(10) + uint128(d - byte(48))
		}
		let hi = sign | (uint64(exponent + decimal128Bias) << 49) | uint64(coefficient >> 64)
		return (hi, uint64(coefficient & 0xFFFFFFFFFFFFFFFF))
	}
}
