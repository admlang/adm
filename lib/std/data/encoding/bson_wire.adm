partial module std.data.encoding {
	use (
		std.time
		std.reflection
		std.reflection::(Field, FieldKind)
		std.crypto::(UUID)
		std.math::(Decimal)
		std.data.encoding.json::(fieldFlag, fieldIsEmpty)
		std.data.encoding.cbor::(validUTF8)
		std.data.encoding.bson::*
	)

	// Reads the document (or array) starting at `at`, which must end by
	// `limit`; returns it and the offset after it.
	internal def bsonReadDocument(data byte[], at int, limit int, depth int, maxDepth int, isArray bool) !(BSONValue, int) {
		expects {
			assert depth <= maxDepth onerror fail "bson: input nests deeper than {maxDepth} levels"
		}
		fail "bson: document at offset {at} is truncated" when limit - at < 5
		let size = int(bsonInt32(data, at))
		fail "bson: document size {size} at offset {at} does not fit the {limit - at} bytes there" when size < 5 || size > limit - at
		let end = at + size - 1
		fail "bson: document at offset {at} does not end in a zero byte" when data[end] != byte(0)
		let doc = new BSONValue(isArray ?? (BSONKind.Array, BSONKind.Document))
		let i = at + 4
		for i < end {
			let kindByte = int(data[i])
			i++
			let nul = i
			for nul < end && data[nul] != byte(0) {
				nul++
			}
			fail "bson: name at offset {i} runs past its document" when nul >= end
			let name = data[i:nul]
			fail "bson: name at offset {i} is not UTF-8" unless validUTF8(name)
			let (item, next) = try bsonReadElement(data, kindByte, nul + 1, end, depth, maxDepth)
			doc.keys.push(string(name)) unless isArray
			doc.vals.push(item)
			i = next
		}
		fail "bson: an element overruns the document at offset {at}" when i != end
		return (doc, at + size)
	}

	// Reads the payload of one element of the given type byte at i, which must
	// end by `end`; returns it and the offset after it.
	internal def bsonReadElement(data byte[], kindByte int, i int, end int, depth int, maxDepth int) !(BSONValue, int) {
		let v = new BSONValue()
		let room = end - i
		match kindByte {
			case 0x01:
				fail "bson: double at offset {i} is truncated" when room < 8
				v.k = BSONKind.Double
				v.f = float(__bitcast_f64_from_u64(bsonUint64(data, i)))
				return (v, i + 8)
			case 0x02, 0x0D, 0x0E:
				let (text, next) = try bsonReadString(data, i, end)
				v.k = kindByte == 0x02 ?? (BSONKind.String, kindByte == 0x0D ?? (BSONKind.JavaScript, BSONKind.Symbol))
				v.raw = text
				return (v, next)
			case 0x03, 0x04:
				return try bsonReadDocument(data, i, end, depth + 1, maxDepth, kindByte == 0x04)
			case 0x05:
				fail "bson: binary at offset {i} is truncated" when room < 5
				let n = int(bsonInt32(data, i))
				fail "bson: binary length {n} at offset {i} does not fit" when n < 0 || n > room - 5
				v.k = BSONKind.Binary
				v.sub = int(data[i + 4])
				let body = data[i + 5:i + 5 + n]
				if v.sub == 2 {
					fail "bson: old binary at offset {i} has no inner length" when n < 4
					fail "bson: old binary at offset {i} has an inner length that is not {n - 4}" when int(bsonInt32(body, 0)) != n - 4
					body = body[4:]
				}
				v.raw = body.clone()
				return (v, i + 5 + n)
			case 0x06:
				v.k = BSONKind.Undefined
				return (v, i)
			case 0x07:
				fail "bson: ObjectId at offset {i} is truncated" when room < 12
				v.k = BSONKind.ObjectId
				v.raw = data[i:i + 12].clone()
				return (v, i + 12)
			case 0x08:
				fail "bson: bool at offset {i} is truncated" when room < 1
				fail "bson: bool at offset {i} is {data[i]}, not 0 or 1" when data[i] > byte(1)
				v.k = BSONKind.Bool
				v.n = int64(data[i])
				return (v, i + 1)
			case 0x09, 0x12:
				fail "bson: 64-bit value at offset {i} is truncated" when room < 8
				v.k = kindByte == 0x09 ?? (BSONKind.DateTime, BSONKind.Int64)
				v.n = int64(bsonUint64(data, i))
				return (v, i + 8)
			case 0x0A:
				return (v, i)
			case 0x0B:
				let (pattern, afterPattern) = try bsonReadCString(data, i, end)
				let (options, next) = try bsonReadCString(data, afterPattern, end)
				v.k = BSONKind.Regex
				v.raw = pattern
				v.extra = bsonSortedOptions(options)
				return (v, next)
			case 0x0C:
				let (namespace, next) = try bsonReadString(data, i, end)
				fail "bson: DBPointer at offset {i} is truncated" when end - next < 12
				v.k = BSONKind.DBPointer
				v.raw = namespace
				v.extra = data[next:next + 12].clone()
				return (v, next + 12)
			case 0x0F:
				fail "bson: code with scope at offset {i} is truncated" when room < 14
				let total = int(bsonInt32(data, i))
				fail "bson: code with scope length {total} at offset {i} does not fit" when total < 14 || total > room
				let (code, afterCode) = try bsonReadString(data, i + 4, i + total)
				let (scope, next) = try bsonReadDocument(data, afterCode, i + total, depth + 1, maxDepth, false)
				fail "bson: code with scope at offset {i} is {total} bytes but holds {next - i}" when next != i + total
				v.k = BSONKind.JavaScriptWithScope
				v.raw = code
				v.vals.push(scope)
				return (v, next)
			case 0x10:
				fail "bson: int32 at offset {i} is truncated" when room < 4
				v.k = BSONKind.Int32
				v.n = int64(bsonInt32(data, i))
				return (v, i + 4)
			case 0x11:
				fail "bson: timestamp at offset {i} is truncated" when room < 8
				v.k = BSONKind.Timestamp
				v.ts = bsonUint64(data, i)
				return (v, i + 8)
			case 0x13:
				fail "bson: decimal128 at offset {i} is truncated" when room < 16
				v.k = BSONKind.Decimal128
				v.raw = data[i:i + 16].clone()
				return (v, i + 16)
			case 0x7F, 0xFF:
				v.k = kindByte == 0x7F ?? (BSONKind.MaxKey, BSONKind.MinKey)
				return (v, i)
			default:
				fail "bson: unknown element type 0x{data[i - 1:i].hex().lower()} before offset {i}"
		}
	}

	// Writes one value tree as an element payload and returns its type byte.
	internal def bsonWriteValue(out byte[], v BSONValue) int {
		match v.k {
			case BSONKind.Double:
				bsonPutUint64(out, __bitcast_u64_from_f64(float64(v.f)))
			case BSONKind.String, BSONKind.JavaScript, BSONKind.Symbol:
				bsonPutString(out, v.raw)
			case BSONKind.Document, BSONKind.Array:
				bsonWriteDocument(out, v)
			case BSONKind.Binary:
				if v.sub == 2 {
					bsonPutInt32(out, v.raw.len() + 4)
					out.push(byte(2))
					bsonPutInt32(out, v.raw.len())
				} else {
					bsonPutInt32(out, v.raw.len())
					out.push(byte(v.sub))
				}
				out.push(...v.raw)
			case BSONKind.ObjectId, BSONKind.Decimal128:
				out.push(...v.raw)
			case BSONKind.Bool:
				out.push(byte(v.n))
			case BSONKind.DateTime, BSONKind.Int64:
				bsonPutUint64(out, uint64(v.n))
			case BSONKind.Int32:
				bsonPutInt32(out, int(v.n))
			case BSONKind.Timestamp:
				bsonPutUint64(out, v.ts)
			case BSONKind.Regex:
				bsonPutCString(out, v.raw)
				bsonPutCString(out, v.extra)
			case BSONKind.DBPointer:
				bsonPutString(out, v.raw)
				out.push(...v.extra)
			case BSONKind.JavaScriptWithScope:
				let start = out.len()
				bsonPutInt32(out, 0)
				bsonPutString(out, v.raw)
				bsonWriteDocument(out, v.vals[0])
				bsonPatchInt32(out, start, out.len() - start)
			default:
		}
		return v.k.value
	}

	// Writes a Document or Array value tree as a document.
	internal def bsonWriteDocument(out byte[], v BSONValue) {
		let start = out.len()
		bsonPutInt32(out, 0)
		for let (i, item) in v.vals {
			let at = out.len()
			out.push(byte(0))
			if v.k == BSONKind.Array {
				out.push(...i.str().bytes())
				out.push(byte(0))
			} else {
				bsonPutCString(out, v.keys[i].bytes())
			}
			out[at] = byte(bsonWriteValue(out, item))
		}
		out.push(byte(0))
		bsonPatchInt32(out, start, out.len() - start)
	}

	// Writes obj as the top-level document.
	internal def bsonEncodeDocument(c BSON, out byte[], obj any, depth int) !none {
		match obj {
			case BSONValue:
				fail "bson: {bsonDescribe(obj)} is not a document" when obj.k != BSONKind.Document
				bsonWriteDocument(out, obj)
				return none
			default:
		}
		let isDocument = reflection.kindOf(obj) == FieldKind.Map || reflection.fields(obj).len() > 0
		fail "bson: only a document (an object, a map or a BSONValue Document) encodes as BSON" unless isDocument
		try bsonWriteAny(c, out, obj, depth)
		return none
	}

	// Writes any value the codec accepts as an element payload and returns
	// its type byte.
	internal def bsonWriteAny(c BSON, out byte[], obj any, depth int) !int {
		match obj {
			case BSONValue:
				return bsonWriteValue(out, obj)
			case byte[]:
				return bsonWriteValue(out, new BSONValue(obj))
			case time.Time:
				return bsonWriteValue(out, new BSONValue(obj))
			case ObjectId:
				// One never set is null inside an array or a map.
				return BSONKind.Null.value when obj.id.len() != 12
				out.push(...obj.bytes())
				return BSONKind.ObjectId.value
			case Decimal128:
				out.push(...obj.bytes())
				return BSONKind.Decimal128.value
			case UUID:
				return bsonWriteValue(out, new BSONValue(obj))
			case Decimal:
				return try bsonWriteDecimal(out, obj)
			case float32:
				bsonPutUint64(out, __bitcast_u64_from_f64(float64(obj)))
				return BSONKind.Double.value
			case duration:
				bsonPutUint64(out, uint64(int64(obj)))
				return BSONKind.Int64.value
			case int64:
				bsonPutUint64(out, uint64(obj))
				return BSONKind.Int64.value
			case bigint:
				return try bsonWriteInteger(out, obj)
			default:
		}
		return BSONKind.Null.value when obj is none || depth >= c.maxDepth
		match reflection.kindOf(obj) {
			case FieldKind.String:
				bsonPutString(out, reflection.scalarText(obj).bytes())
				return BSONKind.String.value
			case FieldKind.Bool:
				out.push(byte(reflection.scalarText(obj) == "true" ?? (1, 0)))
				return BSONKind.Bool.value
			case FieldKind.Int, FieldKind.Uint, FieldKind.Enum:
				return try bsonWriteInteger(out, try parseBigInt(reflection.scalarText(obj)))
			case FieldKind.Float:
				bsonPutUint64(out, __bitcast_u64_from_f64(parseFloat<float64>(reflection.scalarText(obj))))
				return BSONKind.Double.value
			case FieldKind.Array:
				let start = out.len()
				bsonPutInt32(out, 0)
				for let (i, e) in reflection.elements(obj) {
					let at = out.len()
					out.push(byte(0))
					bsonPutCString(out, i.str().bytes())
					out[at] = byte(try bsonWriteAny(c, out, e, depth + 1))
				}
				out.push(byte(0))
				bsonPatchInt32(out, start, out.len() - start)
				return BSONKind.Array.value
			case FieldKind.Map:
				let start = out.len()
				bsonPutInt32(out, 0)
				for let key in reflection.keysOf(obj) {
					let at = out.len()
					out.push(byte(0))
					bsonPutCString(out, key.bytes())
					let e = reflection.entryOf(obj, key)
					out[at] = byte(e is none ?? (BSONKind.Null.value, try bsonWriteAny(c, out, e, depth + 1)))
				}
				out.push(byte(0))
				bsonPatchInt32(out, start, out.len() - start)
				return BSONKind.Document.value
			default:
				let fields = reflection.fields(obj)
				return BSONKind.Null.value when fields.len() == 0
				try bsonWriteObject(c, out, fields, depth)
				return BSONKind.Document.value
		}
	}

	// Writes an object as a document of its fields.
	internal def bsonWriteObject(c BSON, out byte[], fields Field[], depth int) !none {
		let start = out.len()
		bsonPutInt32(out, 0)
		for let (_, f) in fields {
			continue when fieldFlag(f, bsonAttr, "ignore")
			continue when fieldFlag(f, bsonAttr, "omitempty") && fieldIsEmpty(f)
			// An ObjectId never set has no value: the field is left out (a
			// database then gives the document one).
			continue when bsonUnsetObjectId(f)
			let at = out.len()
			out.push(byte(0))
			bsonPutCString(out, bsonFieldName(f).bytes())
			out[at] = byte(try bsonWriteField(c, out, f, f.kind, depth))
		}
		out.push(byte(0))
		bsonPatchInt32(out, start, out.len() - start)
		return none
	}

	internal def bsonUnsetObjectId(f Field) bool {
		return false unless bsonBareType(f.typeName) == "std.data.encoding.ObjectId"
		let v = f.value()
		return v is ObjectId && v.id.len() != 12
	}

	// Writes one field, array element or map value of the given kind and
	// returns its type byte.
	internal def bsonWriteField(c BSON, out byte[], f Field, kind FieldKind, depth int) !int {
		let typeName = f.typeName
		match kind {
			case FieldKind.String:
				bsonPutString(out, f.asString().bytes())
				return BSONKind.String.value
			case FieldKind.Bool:
				out.push(byte(f.asBool() ?? (1, 0)))
				return BSONKind.Bool.value
			case FieldKind.Int, FieldKind.Enum:
				let v = f.asInt()
				if bsonIsWide(typeName) || v < -2147483648 || v > 2147483647 {
					bsonPutUint64(out, uint64(int64(v)))
					return BSONKind.Int64.value
				}
				bsonPutInt32(out, v)
				return BSONKind.Int32.value
			case FieldKind.Uint:
				return try bsonWriteInteger(out, bigint(f.asUint()))
			case FieldKind.Float:
				bsonPutUint64(out, __bitcast_u64_from_f64(float64(f.asFloat())))
				return BSONKind.Double.value
			case FieldKind.Array:
				let n = f.len()
				if typeName := "byte[]" || "uint8[]" {
					let b byte[]
					b.cap(n)
					for let i = 0; i < n; i++ {
						b.push(byte(f.at(i).asUint()))
					}
					return bsonWriteValue(out, new BSONValue(b))
				}
				let start = out.len()
				bsonPutInt32(out, 0)
				for let i = 0; i < n; i++ {
					let at = out.len()
					out.push(byte(0))
					bsonPutCString(out, i.str().bytes())
					out[at] = byte(try bsonWriteField(c, out, f.at(i), f.elemKind, depth))
				}
				out.push(byte(0))
				bsonPatchInt32(out, start, out.len() - start)
				return BSONKind.Array.value
			case FieldKind.Map:
				let start = out.len()
				bsonPutInt32(out, 0)
				for let key in f.keys() {
					let at = out.len()
					out.push(byte(0))
					bsonPutCString(out, key.bytes())
					out[at] = byte(try bsonWriteField(c, out, f.entry(key), f.elemKind, depth))
				}
				out.push(byte(0))
				bsonPatchInt32(out, start, out.len() - start)
				return BSONKind.Document.value
			default:
				if typeName == "duration" {
					bsonPutUint64(out, uint64(int64(f.asInt())))
					return BSONKind.Int64.value
				}
				let nested = f.value()
				return BSONKind.Null.value when nested is none
				return try bsonWriteAny(c, out, nested, depth + 1)
		}
	}

	// Writes an integer as an Int32 when it fits, else an Int64. Fails outside
	// the Int64 range, which BSON has no integer for.
	internal def bsonWriteInteger(out byte[], v bigint) !int {
		if v >= bigint(-2147483648) && v <= bigint(2147483647) {
			bsonPutInt32(out, int(v))
			return BSONKind.Int32.value
		}
		fail "bson: integer {v.toRadix(10)} is outside the Int64 range" when v < -(bigint(1) << 63) || v >= bigint(1) << 63
		bsonPutUint64(out, uint64(int64(v)))
		return BSONKind.Int64.value
	}

	// Writes a Decimal as a Decimal128. Fails when it has no exact Decimal128.
	internal def bsonWriteDecimal(out byte[], d Decimal) !int {
		let coefficient = d.coefficient()
		let text = coefficient.toRadix(10) + "E" + d.exponent().str()
		let value = parseDecimal128(text) onerror (err error) {
			fail "bson: {d.str()} has no exact Decimal128: {err.message}"
		}
		out.push(...value.bytes())
		return BSONKind.Decimal128.value
	}

	// The document name of a field: its `@bson` name or its declared name.
	internal def bsonFieldName(f Field) string {
		let name = f.attr(bsonAttr, "name")
		return name == "" ?? (f.name, name)
	}

	// Binds a Document onto an object's fields.
	internal def bsonBind(doc BSONValue, target any, depth int, maxDepth int) !none {
		expects {
			assert depth < maxDepth onerror fail "bson: input nests deeper than {maxDepth} objects"
		}
		if target is BSONValue {
			// A BSONValue target takes the tree itself.
			let tree BSONValue = target
			tree.k = doc.k
			tree.n = doc.n
			tree.ts = doc.ts
			tree.f = doc.f
			tree.sub = doc.sub
			tree.raw = doc.raw
			tree.extra = doc.extra
			tree.keys = doc.keys
			tree.vals = doc.vals
			return none
		}
		return none when doc.k == BSONKind.Null
		fail "bson: cannot read {bsonDescribe(doc)} into an object" when doc.k != BSONKind.Document
		let fields = reflection.fields(target)
		for let (i, key) in doc.keys {
			let f = bsonFieldFor(fields, key)
			continue when f is none
			try bsonBindField(doc.vals[i], f, depth, maxDepth)
		}
		return none
	}

	// The field a name binds to: the `@bson` name or the declared name
	// exactly, else case-insensitively.
	internal def bsonFieldFor(fields Field[], key string) ?Field {
		for let (_, f) in fields {
			continue when fieldFlag(f, bsonAttr, "ignore")
			return f when bsonFieldName(f) == key
		}
		let lowered = key.lower()
		for let (_, f) in fields {
			continue when fieldFlag(f, bsonAttr, "ignore")
			return f when bsonFieldName(f).lower() == lowered
		}
		return none
	}

	// Stores one value in a field.
	internal def bsonBindField(v BSONValue, f Field, depth int, maxDepth int) !none {
		if v.k == BSONKind.Null || v.k == BSONKind.Undefined {
			f.setNone() when f.kind == FieldKind.Optional
			return none
		}
		match f.kind {
			case FieldKind.Array:
				if f.typeName := "byte[]" || "uint8[]" {
					let b = try v.asBytes()
					fail "bson: cannot read {bsonDescribe(v)} into `{f.name}`" when v.k != BSONKind.Binary
					fail "bson: cannot resize `{f.name}`" when !f.setLen(b.len())
					for let (i, x) in b {
						f.at(i).setUint(uint(x))
					}
					return none
				}
				fail "bson: cannot read {bsonDescribe(v)} into `{f.name}`" when v.k != BSONKind.Array
				fail "bson: cannot resize `{f.name}`" when !f.setLen(v.vals.len())
				for let (i, e) in v.vals {
					try bsonBindScalar(e, f.at(i), f.elemKind, depth, maxDepth)
				}
				return none
			case FieldKind.Map:
				fail "bson: cannot read {bsonDescribe(v)} into `{f.name}`" when v.k != BSONKind.Document
				f.clear()
				for let (i, key) in v.keys {
					let item = v.vals[i]
					continue when item.k == BSONKind.Null && f.elemKind != FieldKind.Iface
					try bsonBindScalar(item, f.entry(key), f.elemKind, depth, maxDepth)
				}
				return none
			case FieldKind.Optional:
				return try bsonBindScalar(v, f, f.elemKind, depth, maxDepth)
			default:
				return try bsonBindScalar(v, f, f.kind, depth, maxDepth)
		}
	}

	// Stores a scalar or nested value in a field, array element or map entry.
	internal def bsonBindScalar(v BSONValue, f Field, kind FieldKind, depth int, maxDepth int) !none {
		let typeName = bsonBareType(f.typeName)
		match kind {
			case FieldKind.String:
				f.setString(try v.asString())
			case FieldKind.Bool:
				f.setBool(try v.asBool())
			case FieldKind.Int, FieldKind.Enum:
				f.setInt(try v.asInt())
			case FieldKind.Uint:
				let n = try v.asInt()
				fail "bson: cannot store {n} in `{f.name}`" when n < 0
				f.setUint(uint(n))
			case FieldKind.Float:
				f.setFloat(try v.asFloat())
			case FieldKind.Iface:
				fail "bson: cannot store {bsonDescribe(v)} in `{f.name}`" unless f.set(try bsonToAny(v, depth, maxDepth))
			default:
				let special = try bsonSpecial(v, typeName, f.name)
				if !(special is none) {
					fail "bson: cannot store {bsonDescribe(v)} in `{f.name}`" unless f.set(special)
					return none
				}
				fail "bson: cannot store {bsonDescribe(v)} in `{f.name}`" when kind != FieldKind.Struct
				let nested = f.ensureValue()
				fail "bson: cannot store {bsonDescribe(v)} in `{f.name}`" when nested is none
				try bsonBind(v, nested, depth + 1, maxDepth)
		}
		return none
	}

	// The value of a type the codec reads itself (time.Time, ObjectId,
	// Decimal128, UUID, Decimal, BSONValue, duration) for a field of that type
	// name; none for any other type. Fails when the value does not convert.
	internal def bsonSpecial(v BSONValue, typeName string, field string) !?any {
		match typeName {
			case "std.data.encoding.BSONValue":
				return v
			case "std.time.Time":
				return try v.asTime()
			case "std.data.encoding.ObjectId":
				return try v.asObjectId()
			case "std.data.encoding.Decimal128":
				return try v.asDecimal128()
			case "std.crypto.UUID":
				return try v.asUUID()
			case "std.math.Decimal":
				return new Decimal(try v.asInt()) when v.k == BSONKind.Int32 || v.k == BSONKind.Int64
				return try (try v.asDecimal128()).toDecimal()
			case "duration":
				return duration(try v.asInt())
			default:
				return none
		}
	}

	// A value as the plain data `JSON.parse` builds: null as none, a Document
	// as `map<string, any>`, an Array as `any[]`, Int32 and Int64 as int,
	// Double as float, text as string, a DateTime in range as `time.Time`, a
	// Binary as `byte[]` (subtype 4 as a UUID), ObjectId and Decimal128 as
	// themselves, anything else as its BSONValue.
	internal def bsonToAny(v BSONValue, depth int, maxDepth int) !any {
		expects {
			assert depth < maxDepth onerror fail "bson: input nests deeper than {maxDepth} levels"
		}
		match v.k {
			case BSONKind.Null, BSONKind.Undefined:
				return none
			case BSONKind.Bool:
				return v.n == 1
			case BSONKind.Int32, BSONKind.Int64:
				return int(v.n)
			case BSONKind.Double:
				return v.f
			case BSONKind.String, BSONKind.Symbol:
				return try v.asString()
			case BSONKind.Binary:
				return try v.asUUID() when v.sub == 4 && v.raw.len() == 16
				return v.raw
			case BSONKind.ObjectId:
				return try v.asObjectId()
			case BSONKind.Decimal128:
				return try v.asDecimal128()
			case BSONKind.DateTime:
				return try v.asTime() when v.n >= -9223372036854 && v.n <= 9223372036854
				return v
			case BSONKind.Array:
				let out any[] = []
				for let item in v.vals {
					out.push(try bsonToAny(item, depth + 1, maxDepth))
				}
				return out
			case BSONKind.Document:
				let out = map<string, any>{}
				for let (i, key) in v.keys {
					out[key] = try bsonToAny(v.vals[i], depth + 1, maxDepth)
				}
				return out
			default:
				return v
		}
	}
}

internal partial module std.data.encoding.bson {
	use (
		std.reflection::(MetadataStore)
		std.data.encoding.json::(recordFlag)
		std.data.encoding.cbor::(validUTF8)
	)

	def bsonRecord(store MetadataStore, name string, omitempty bool, ignore bool) {
		let prefix = "encoder.bson."
		if name == "" {
			store.delete(prefix + "name")
		} else {
			store.save(prefix + "name", name)
		}
		recordFlag(store, prefix + "omitempty", omitempty)
		recordFlag(store, prefix + "ignore", ignore)
	}

	// The little-endian signed 32-bit integer at `at`.
	def bsonInt32(data byte[], at int) int32 {
		return int32(uint32(data[at]) | (uint32(data[at + 1]) << 8) | (uint32(data[at + 2]) << 16) | (uint32(data[at + 3]) << 24))
	}

	// The little-endian 64-bit integer at `at`.
	def bsonUint64(data byte[], at int) uint64 {
		let v uint64 = 0
		for let i = 7; i >= 0; i-- {
			v = (v << 8) | uint64(data[at + i])
		}
		return v
	}

	def bsonPutInt32(out byte[], v int) {
		let u = uint32(int32(v))
		out.push(byte(u & 0xFF), byte((u >> 8) & 0xFF), byte((u >> 16) & 0xFF), byte(u >> 24))
	}

	def bsonPatchInt32(out byte[], at int, v int) {
		let u = uint32(int32(v))
		out[at] = byte(u & 0xFF)
		out[at + 1] = byte((u >> 8) & 0xFF)
		out[at + 2] = byte((u >> 16) & 0xFF)
		out[at + 3] = byte(u >> 24)
	}

	def bsonPutUint64(out byte[], v uint64) {
		for let i = 0; i < 8; i++ {
			out.push(byte((v >> (i * 8)) & 0xFF))
		}
	}

	// A string: its length with the terminator, the bytes, a zero byte.
	def bsonPutString(out byte[], b byte[]) {
		bsonPutInt32(out, b.len() + 1)
		out.push(...b)
		out.push(byte(0))
	}

	// A name or regex part: the bytes and a zero byte. They come from strings
	// or were checked when read, so they hold no zero byte of their own.
	def bsonPutCString(out byte[], b byte[]) {
		out.push(...b)
		out.push(byte(0))
	}

	// Reads a string at i ending by `end`: returns its bytes (a copy) and the
	// offset after it. Fails on a bad length, a missing terminator or bytes
	// that are not UTF-8.
	def bsonReadString(data byte[], i int, end int) !(byte[], int) {
		expects {
			assert end - i >= 5 onerror fail "bson: string at offset {i} is truncated"
		}
		let n = int(bsonInt32(data, i))
		fail "bson: string length {n} at offset {i} does not fit" when n < 1 || n > end - i - 4
		fail "bson: string at offset {i} does not end in a zero byte" when data[i + 4 + n - 1] != byte(0)
		let text = data[i + 4:i + 3 + n]
		fail "bson: string at offset {i} is not UTF-8" unless validUTF8(text)
		return (text.clone(), i + 4 + n)
	}

	// Reads a zero-terminated name or regex part at i ending by `end`.
	def bsonReadCString(data byte[], i int, end int) !(byte[], int) {
		let nul = i
		for nul < end && data[nul] != byte(0) {
			nul++
		}
		fail "bson: text at offset {i} runs past its document" when nul >= end
		let text = data[i:nul]
		fail "bson: text at offset {i} is not UTF-8" unless validUTF8(text)
		return (text.clone(), nul + 1)
	}

	// Regex options in the alphabetical order BSON requires.
	def bsonSortedOptions(options byte[]) byte[] {
		let out = options.clone()
		out.sort((a byte, b byte) => a < b)
		return out
	}

	// Reports whether an integer field is always an Int64: `int64`, `uint32`
	// and wider, or an array or map of them.
	def bsonIsWide(typeName string) bool {
		let t = bsonBareType(typeName)
		return t := "int64" || "uint32" || "uint64"
	}

	// A type name without an optional's `?` or an array's `[]`, and the value
	// type of a map.
	def bsonBareType(typeName string) string {
		let t = typeName
		t = t[1:] when t.startsWith("?")
		if t.startsWith("map<") {
			let comma = t.indexOf(", ")
			t = t[comma + 2:-1] when comma > 0
		}
		for t.endsWith("[]") {
			t = t[:-2]
		}
		t = t[1:] when t.startsWith("?")
		return t
	}
}
