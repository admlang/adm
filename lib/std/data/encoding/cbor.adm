partial module std.data.encoding {
	use (
		std.io
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.data.encoding.json::(fieldFlag, fieldIsEmpty, recordFlag, quote)
		std.data.encoding.cbor::*
	)

	// What one CBOR data item is (RFC 8949 §3).
	enum CBORKind {
		// An integer, major type 0 or 1: -2^64 to 2^64 - 1.
		Int,
		// A byte string, major type 2.
		Bytes,
		// A UTF-8 text string, major type 3.
		Text,
		// An array of items, major type 4.
		Array,
		// A map of item pairs, major type 5.
		Map,
		// A tag number and the item it tags, major type 6.
		Tag,
		Bool,
		Null,
		Undefined,
		// A simple value other than false, true, null and undefined.
		Simple,
		// A floating-point number of any width.
		Float
	}

	// How the encoder orders the keys of a map.
	enum CBORKeyOrder {
		// The order the entries were added in.
		AsWritten,
		// By the bytes of each encoded key: RFC 8949 §4.2.1, core
		// deterministic encoding.
		Bytewise,
		// Shorter encoded keys first, equal lengths by their bytes:
		// RFC 8949 §4.2.3, the canonical form CTAP2 and COSE require.
		LengthFirst
	}

	// One CBOR data item, read from a document or built to encode one.
	//
	//     let key = new CBORValue(CBORKind.Map)
	//     key.set(1, new CBORValue(2))
	//     key.set(-1, new CBORValue(1))
	//     let data = new CBOR().encode(key)
	//
	//     let item = try new CBOR().parse(data)
	//     let curve = try item.get(-1).asInt()
	type CBORValue {
		internal k     CBORKind    = CBORKind.Null
		internal neg   bool
		internal n     uint64
		internal f     float
		internal raw   byte[]
		internal items CBORValue[]
		internal vals  CBORValue[]

		// What the item is.
		kind CBORKind {
			def get() CBORKind {
				return k
			}
		}

		// The tag number of a Tag item, 0 otherwise.
		tag uint64 {
			def get() uint64 {
				return k == CBORKind.Tag ?? (n, uint64(0))
			}
		}

		// The value of a Simple item (0 to 255, excluding 20 to 31), 0
		// otherwise.
		simple int {
			def get() int {
				return k == CBORKind.Simple ?? (int(n), 0)
			}
		}

		// null.
		def new() {}

		// An empty item of a kind with no content: an empty Array, Map, Bytes
		// or Text, false, null or undefined. Other kinds read as null.
		def new(kind CBORKind) {
			match kind {
				case CBORKind.Array, CBORKind.Map, CBORKind.Bytes, CBORKind.Text, CBORKind.Bool, CBORKind.Undefined:
					k = kind
				default:
					k = CBORKind.Null
			}
		}

		// An integer.
		def new(v int) {
			k = CBORKind.Int
			if v < 0 {
				neg = true
				n = uint64(-1 - v)
			} else {
				n = uint64(v)
			}
		}

		// A non-negative integer up to 2^64 - 1.
		def new(v uint64) {
			k = CBORKind.Int
			n = v
		}

		// An integer of any size: a plain integer from -2^64 to 2^64 - 1, a
		// bignum (tag 2 or 3, RFC 8949 §3.4.3) beyond.
		def new(v bigint) {
			let limit = bigint(1) << 64
			if v >= bigint(0) && v < limit {
				k = CBORKind.Int
				n = uint64(v)
				return
			}
			if v < bigint(0) && -bigint(1) - v < limit {
				k = CBORKind.Int
				neg = true
				n = uint64(-bigint(1) - v)
				return
			}
			k = CBORKind.Tag
			let magnitude = v >= bigint(0) ?? (v, -bigint(1) - v)
			n = v >= bigint(0) ?? (uint64(2), uint64(3))
			items.push(new CBORValue(magnitude.bytes()))
		}

		// A floating-point number, encoded in the shortest width that holds it
		// exactly.
		def new(v float) {
			k = CBORKind.Float
			f = v
		}

		def new(v bool) {
			k = CBORKind.Bool
			n = v ?? (uint64(1), uint64(0))
		}

		// A text string.
		def new(v string) {
			k = CBORKind.Text
			raw = v.bytes()
		}

		// A byte string.
		def new(v byte[]) {
			k = CBORKind.Bytes
			raw = v
		}

		// An array of the items.
		def new(v CBORValue[]) {
			k = CBORKind.Array
			items = v
		}

		// The item tagged with a tag number (RFC 8949 §3.4).
		def new(tagNumber uint64, content CBORValue) {
			k = CBORKind.Tag
			n = tagNumber
			items.push(content)
		}

		// The integer, or fails when the item is not an integer or lies
		// outside the int range.
		def asInt() !int {
			fail "cbor: {cborDescribe(self)} is not an integer" when k != CBORKind.Int
			fail "cbor: integer does not fit an int" when n > uint64(0x7FFFFFFFFFFFFFFF)
			return neg ?? (-1 - int(n), int(n))
		}

		// The non-negative integer, or fails when the item is not one.
		def asUint() !uint64 {
			fail "cbor: {cborDescribe(self)} is not a non-negative integer" when k != CBORKind.Int || neg
			return n
		}

		// The integer at any size: a plain integer or a bignum (tag 2 or 3).
		// Fails for anything else.
		def asBigint() !bigint {
			return neg ?? (-bigint(1) - bigint(n), bigint(n)) when k == CBORKind.Int
			if k == CBORKind.Tag && (n == uint64(2) || n == uint64(3)) && items[0].k == CBORKind.Bytes {
				let magnitude = parseBigInt(items[0].raw)
				return n == uint64(2) ?? (magnitude, -bigint(1) - magnitude)
			}
			fail "cbor: {cborDescribe(self)} is not an integer"
		}

		// The number of a Float item, or of an Int item that a float holds
		// exactly. Fails for anything else.
		def asFloat() !float {
			return f when k == CBORKind.Float
			return neg ?? (-1.0 - float(n), float(n)) when k == CBORKind.Int && n <= uint64(9007199254740992)
			fail "cbor: {cborDescribe(self)} is not a number"
		}

		// The truth value, or fails when the item is not a bool.
		def asBool() !bool {
			fail "cbor: {cborDescribe(self)} is not a bool" when k != CBORKind.Bool
			return n == uint64(1)
		}

		// The text of a Text item. Fails for anything else, and for text
		// holding U+0000, which a string cannot carry.
		def asString() !string {
			fail "cbor: {cborDescribe(self)} is not text" when k != CBORKind.Text
			fail "cbor: text holds U+0000" when raw.indexOf(byte(0)) >= 0
			return string(raw)
		}

		// The bytes of a Bytes item, or the UTF-8 of a Text item. Fails for
		// anything else.
		def asBytes() !byte[] {
			fail "cbor: {cborDescribe(self)} is not a byte string" when k != CBORKind.Bytes && k != CBORKind.Text
			return raw
		}

		// The elements of an Array; empty for anything else.
		def elements() CBORValue[] {
			return items when k == CBORKind.Array
			return []
		}

		// The entries of a Map, in order; empty for anything else.
		def entries() (CBORValue, CBORValue)[] {
			let out (CBORValue, CBORValue)[] = []
			return out when k != CBORKind.Map
			for let (i, key) in items {
				out.push((key, vals[i]))
			}
			return out
		}

		// The item a Tag wraps; null for anything else.
		def content() CBORValue {
			return items[0] when k == CBORKind.Tag
			return new CBORValue()
		}

		// The number of elements of an Array, entries of a Map or bytes of a
		// Bytes or Text item; 0 for anything else.
		def len() int {
			match k {
				case CBORKind.Array, CBORKind.Map:
					return items.len()
				case CBORKind.Bytes, CBORKind.Text:
					return raw.len()
				default:
					return 0
			}
		}

		// The element of an Array at index; a null item when out of range or
		// not an array.
		def at(index int) CBORValue {
			return new CBORValue() when k != CBORKind.Array || index < 0 || index >= items.len()
			return items[index]
		}

		// The Map entry under key; a null item when absent or not a map (has
		// tells the two apart).
		def get(key CBORValue) CBORValue {
			let i = indexOf(key)
			return new CBORValue() when i < 0
			return vals[i]
		}

		// The Map entry under an integer key; a null item when absent or not a
		// map.
		def get(key int) CBORValue {
			let i = indexOf(key)
			return new CBORValue() when i < 0
			return vals[i]
		}

		// The Map entry under a text key; a null item when absent or not a map.
		def get(key string) CBORValue {
			let i = indexOf(key)
			return new CBORValue() when i < 0
			return vals[i]
		}

		// Reports whether a Map holds an entry under key.
		def has(key CBORValue) bool {
			return indexOf(key) >= 0
		}

		// Reports whether a Map holds an entry under key.
		def has(key int) bool {
			return indexOf(key) >= 0
		}

		// Reports whether a Map holds an entry under key.
		def has(key string) bool {
			return indexOf(key) >= 0
		}

		// The position of key among a Map's entries; -1 when absent or not a
		// map.
		def indexOf(key CBORValue) int {
			return -1 when k != CBORKind.Map
			for let (i, have) in items {
				return i when have.equals(key)
			}
			return -1
		}

		// The position of an integer key; -1 when absent or not a map.
		def indexOf(key int) int {
			return -1 when k != CBORKind.Map
			let isNeg = key < 0
			let mag = isNeg ?? (uint64(-1 - key), uint64(key))
			for let (i, have) in items {
				return i when have.k == CBORKind.Int && have.neg == isNeg && have.n == mag
			}
			return -1
		}

		// The position of a text key; -1 when absent or not a map.
		def indexOf(key string) int {
			return -1 when k != CBORKind.Map
			let want = key.bytes()
			for let (i, have) in items {
				return i when have.k == CBORKind.Text && have.raw.equals(want)
			}
			return -1
		}

		// Sets the entry under key in a Map, replacing an equal key in place
		// or adding it at the end, and returns the map. Does nothing to an
		// item that is not a map.
		def set(key CBORValue, value CBORValue) CBORValue {
			return self when k != CBORKind.Map
			for let (i, have) in items {
				if have.equals(key) {
					vals[i] = value
					return self
				}
			}
			items.push(key)
			vals.push(value)
			return self
		}

		// Sets the entry under an integer key; see set(CBORValue, CBORValue).
		def set(key int, value CBORValue) CBORValue {
			return set(new CBORValue(key), value)
		}

		// Sets the entry under a text key; see set(CBORValue, CBORValue).
		def set(key string, value CBORValue) CBORValue {
			return set(new CBORValue(key), value)
		}

		// Removes the entry under key from a Map and returns the map.
		def remove(key CBORValue) CBORValue {
			return self when k != CBORKind.Map
			for let (i, have) in items {
				if have.equals(key) {
					items.remove(i)
					vals.remove(i)
					break
				}
			}
			return self
		}

		// Appends an element to an Array and returns the array. Does nothing
		// to an item that is not an array.
		def push(item CBORValue) CBORValue {
			items.push(item) when k == CBORKind.Array
			return self
		}

		// Reports whether two items are the same data model value: equal
		// kinds and contents, map entries in the same order. A float and an
		// integer are never equal, and NaN equals NaN.
		def equals(other CBORValue) bool {
			return false when k != other.k
			match k {
				case CBORKind.Int:
					return neg == other.neg && n == other.n
				case CBORKind.Bytes, CBORKind.Text:
					return raw.equals(other.raw)
				case CBORKind.Bool, CBORKind.Simple:
					return n == other.n
				case CBORKind.Float:
					return (f != f && other.f != other.f) || f == other.f
				case CBORKind.Tag:
					return n == other.n && items[0].equals(other.items[0])
				case CBORKind.Array, CBORKind.Map:
					return false when items.len() != other.items.len()
					for let (i, item) in items {
						return false when !item.equals(other.items[i])
						return false when k == CBORKind.Map && !vals[i].equals(other.vals[i])
					}
					return true
				default:
					return true
			}
		}

		// The item in diagnostic notation (RFC 8949 §8): `1`, `-1`, `1.5`,
		// `"text"`, `h'0102'`, `[1, 2]`, `{1: "a"}`, `0("…")`, `simple(16)`,
		// `true`, `null`, `undefined`, `NaN`, `Infinity`.
		def str() string {
			match k {
				case CBORKind.Int:
					return neg ?? ((-bigint(1) - bigint(n)).toRadix(10), n.str())
				case CBORKind.Bytes:
					return "h'" + raw.hex().lower() + "'"
				case CBORKind.Text:
					return quote(string(raw))
				case CBORKind.Array:
					let out = "["
					for let (i, item) in items {
						out += ", " when i > 0
						out += item.str()
					}
					return out + "]"
				case CBORKind.Map:
					let out = "\{"
					for let (i, key) in items {
						out += ", " when i > 0
						out += key.str() + ": " + vals[i].str()
					}
					return out + "\}"
				case CBORKind.Tag:
					return n.str() + "(" + items[0].str() + ")"
				case CBORKind.Bool:
					return n == uint64(1) ?? ("true", "false")
				case CBORKind.Undefined:
					return "undefined"
				case CBORKind.Simple:
					return "simple({n})"
				case CBORKind.Float:
					return "NaN" when f != f
					return "Infinity" when f > 1.7976931348623157e308
					return "-Infinity" when f < -1.7976931348623157e308
					let text = f.str()
					return text when text.contains(".") || text.contains("e")
					return text + ".0"
				default:
					return "null"
			}
		}
	}

	// Qualified name of the `@cbor` meta function, used to look up field options.
	internal const cborAttr = "std.data.encoding.cbor"

	// Encodes and decodes CBOR, the Concise Binary Object Representation of
	// RFC 8949.
	//
	//     let c = new CBOR()
	//     let data = c.encode(user)
	//     try c.decode(data, user)
	//
	//     let item = try c.parse(data)   // a CBORValue tree
	//
	// `encode` takes a CBORValue, a scalar, an array, a `map<string, V>` or
	// an object. An object becomes a map of its fields, `byte[]` a byte
	// string and an enum member its value. Integers, lengths and floats are
	// always written in their preferred (shortest) form with definite
	// lengths; `keyOrder` decides whether map keys are sorted as well, which
	// makes the output deterministic.
	//
	// Per-field behaviour comes from `@cbor` annotations:
	//
	//     @cbor("user_id")         encode under this text key instead of the field name
	//     @cbor(key = 3)           encode under this integer key (COSE and CTAP maps)
	//     @cbor(omitempty = true)  leave the field out when it holds its zero value
	//     @cbor(ignore = true)     never encode or decode the field
	//
	// The decoder accepts every well-formed item, indefinite lengths
	// included, and refuses invalid ones: text that is not UTF-8 and maps
	// with duplicate keys.
	type CBOR {
		// Map key order on encode.
		keyOrder CBORKeyOrder = CBORKeyOrder.AsWritten

		// How deep arrays, maps and tags may nest before decoding fails, and
		// how deep encode walks objects before writing null.
		maxDepth int = 128

		// encode renders obj as one CBOR item.
		def encode(obj any) byte[] {
			let out byte[]
			cborEncodeAny(self, out, obj, 0)
			return out
		}

		// encode writes obj as one CBOR item to the writer. Fails when the
		// writer does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// Reads the one item the bytes hold. Fails when they are not exactly
		// one well-formed, valid item.
		def parse(input byte[]) !CBORValue {
			let r = new CBORReader(input)
			r.maxDepth = maxDepth
			let item = try r.next()
			fail "cbor: {input.len() - r.pos} bytes of trailing data" when r.more()
			return item
		}

		// Reads a CBOR sequence (RFC 8742): items back to back. Fails when
		// any of them is not well formed or valid.
		def parseSequence(input byte[]) !CBORValue[] {
			let r = new CBORReader(input)
			r.maxDepth = maxDepth
			let out CBORValue[] = []
			for r.more() {
				out.push(try r.next())
			}
			return out
		}

		// Binds the one item the bytes hold onto target: a map onto an
		// object's fields by `@cbor` key or field name, arrays and maps onto
		// array and `map<string, V>` fields. Unknown keys are skipped; null
		// leaves a field at its zero value. Fails when the bytes do not
		// parse or a value does not fit its field.
		def decode(input byte[], target any) !none {
			let item = try parse(input)
			return try cborBind(item, target, 0, maxDepth)
		}

		// decode reads everything the reader yields and binds it onto target.
		// Fails when the reader does or the data does not decode.
		def decode(reader io.Reader, target any) !none {
			let chunk byte[]
			chunk.len(4096)
			let all byte[]
			for {
				let n = try reader.read(chunk)
				break when n <= 0
				all += chunk.slice(0, n)
			}
			return try decode(all, target)
		}

		// The canonical encoding of one item, with its map keys sorted by
		// the given order.
		internal def sortedEncoding(item CBORValue) byte[] {
			let out byte[]
			cborEncodeValue(keyOrder, out, item)
			return out
		}
	}

	// Reads CBOR items one after another from bytes, for items that sit
	// inside other data (a WebAuthn credential public key inside
	// authenticator data, say) or for a sequence read lazily.
	//
	//     let r = new CBORReader(data)
	//     let key = try r.next()
	//     let rest = data[r.pos:]
	type CBORReader {
		internal data byte[]

		// Offset of the next item.
		pos int = 0

		// How deep arrays, maps and tags may nest before next fails.
		maxDepth int = 128

		def new(data byte[]) {
			self.data = data
		}

		// Reports whether bytes are left to read.
		def more() bool {
			return pos < data.len()
		}

		// Reads the next item and moves past it. Fails when the bytes end
		// mid-item or the item is not well formed or valid; pos is then
		// unspecified.
		def next() !CBORValue {
			return try cborRead(self, 0)
		}
	}

	// Controls how a field is encoded to and decoded from CBOR.
	//
	//     name       text key to use instead of the field name
	//     key        integer key to use instead of a text key
	//     omitempty  leave the field out when it holds its zero value
	//     ignore     never encode or decode the field
	//
	//     struct CoseKey {
	//         @cbor(key = 1)
	//         kty int
	//         @cbor(key = -1)
	//         crv int
	//     }
	meta def cbor(ctx FieldMetaContext, name string = "", key int = 0, omitempty bool = false, ignore bool = false) {
		let store MetadataStore = ctx.ctx.storage
		cborRecord(store, name, key, omitempty, ignore)
	}

	// Controls how a property is encoded to and decoded from CBOR. Takes the
	// same options as the field form above.
	meta def cbor(ctx PropertyMetaContext, name string = "", key int = 0, omitempty bool = false, ignore bool = false) {
		let store MetadataStore = ctx.ctx.storage
		cborRecord(store, name, key, omitempty, ignore)
	}

	// Writes one item tree.
	internal def cborEncodeValue(order CBORKeyOrder, out byte[], v CBORValue) {
		match v.k {
			case CBORKind.Int:
				cborHead(out, v.neg ?? (1, 0), v.n)
			case CBORKind.Bytes:
				cborHead(out, 2, uint64(v.raw.len()))
				out.push(...v.raw)
			case CBORKind.Text:
				cborHead(out, 3, uint64(v.raw.len()))
				out.push(...v.raw)
			case CBORKind.Array:
				cborHead(out, 4, uint64(v.items.len()))
				for let (_, item) in v.items {
					cborEncodeValue(order, out, item)
				}
			case CBORKind.Map:
				cborHead(out, 5, uint64(v.items.len()))
				if order == CBORKeyOrder.AsWritten {
					for let (i, key) in v.items {
						cborEncodeValue(order, out, key)
						cborEncodeValue(order, out, v.vals[i])
					}
				} else {
					let keys byte[][] = []
					for let (_, key) in v.items {
						let kb byte[]
						cborEncodeValue(order, kb, key)
						keys.push(kb)
					}
					for let (_, i) in cborKeyOrder(keys, order) {
						out.push(...keys[i])
						cborEncodeValue(order, out, v.vals[i])
					}
				}
			case CBORKind.Tag:
				cborHead(out, 6, v.n)
				cborEncodeValue(order, out, v.items[0])
			case CBORKind.Bool:
				out.push(byte(v.n == uint64(1) ?? (0xF5, 0xF4)))
			case CBORKind.Undefined:
				out.push(byte(0xF7))
			case CBORKind.Simple:
				cborHead(out, 7, v.n)
			case CBORKind.Float:
				cborFloat(out, v.f)
			default:
				out.push(byte(0xF6))
		}
	}

	// Writes any value the codec accepts.
	internal def cborEncodeAny(c CBOR, out byte[], obj any, depth int) {
		match obj {
			case CBORValue:
				cborEncodeValue(c.keyOrder, out, obj)
				return
			case byte[]:
				cborHead(out, 2, uint64(obj.len()))
				out.push(...obj)
				return
			case bigint:
				cborEncodeValue(c.keyOrder, out, new CBORValue(obj))
				return
			default:
		}
		if depth >= c.maxDepth {
			out.push(byte(0xF6))
			return
		}
		let kind = reflection.kindOf(obj)
		match kind {
			case FieldKind.String:
				let b = reflection.scalarText(obj).bytes()
				cborHead(out, 3, uint64(b.len()))
				out.push(...b)
			case FieldKind.Bool:
				out.push(byte(reflection.scalarText(obj) == "true" ?? (0xF5, 0xF4)))
			case FieldKind.Int, FieldKind.Uint, FieldKind.Enum:
				cborEncodeValue(c.keyOrder, out, new CBORValue(parseBigInt(reflection.scalarText(obj)) onerror recover bigint(0)))
			case FieldKind.Float:
				cborFloat(out, parseFloat<float>(reflection.scalarText(obj)))
			case FieldKind.Array:
				let elems = reflection.elements(obj)
				cborHead(out, 4, uint64(elems.len()))
				for let e in elems {
					cborEncodeAny(c, out, e, depth + 1)
				}
			case FieldKind.Map:
				let keys CBORValue[] = []
				let parts byte[][] = []
				for let key in reflection.keysOf(obj) {
					keys.push(new CBORValue(key))
					let part byte[]
					let e = reflection.entryOf(obj, key)
					if e is none {
						part.push(byte(0xF6))
					} else {
						cborEncodeAny(c, part, e, depth + 1)
					}
					parts.push(part)
				}
				cborWriteMap(c, out, keys, parts)
			default:
				if reflection.fields(obj).len() == 0 {
					out.push(byte(0xF6))
					return
				}
				cborEncodeObject(c, out, obj, depth)
		}
	}

	// Writes an object as a map of its fields.
	internal def cborEncodeObject(c CBOR, out byte[], obj any, depth int) {
		let keys CBORValue[] = []
		let parts byte[][] = []
		for let (_, f) in reflection.fields(obj) {
			continue when fieldFlag(f, cborAttr, "ignore")
			continue when fieldFlag(f, cborAttr, "omitempty") && fieldIsEmpty(f)
			keys.push(cborFieldKey(f))
			let part byte[]
			cborEncodeField(c, part, f, depth)
			parts.push(part)
		}
		cborWriteMap(c, out, keys, parts)
	}

	// Writes a map whose values are already encoded, keys in the codec's order.
	internal def cborWriteMap(c CBOR, out byte[], keys CBORValue[], parts byte[][]) {
		cborHead(out, 5, uint64(keys.len()))
		let encodedKeys byte[][] = []
		for let (_, key) in keys {
			let kb byte[]
			cborEncodeValue(c.keyOrder, kb, key)
			encodedKeys.push(kb)
		}
		if c.keyOrder == CBORKeyOrder.AsWritten {
			for let (i, kb) in encodedKeys {
				out.push(...kb)
				out.push(...parts[i])
			}
			return
		}
		for let (_, i) in cborKeyOrder(encodedKeys, c.keyOrder) {
			out.push(...encodedKeys[i])
			out.push(...parts[i])
		}
	}

	// The map key of a field: its `@cbor(key = …)` integer, its `@cbor` name,
	// or its declared name.
	internal def cborFieldKey(f Field) CBORValue {
		let key = f.attr(cborAttr, "key")
		return new CBORValue(parseInt<int>(key)) when key != ""
		let name = f.attr(cborAttr, "name")
		return new CBORValue(name == "" ?? (f.name, name))
	}

	// Writes one field's value.
	internal def cborEncodeField(c CBOR, out byte[], f Field, depth int) {
		match f.kind {
			case FieldKind.String:
				let b = f.asString().bytes()
				cborHead(out, 3, uint64(b.len()))
				out.push(...b)
			case FieldKind.Bool:
				out.push(byte(f.asBool() ?? (0xF5, 0xF4)))
			case FieldKind.Int, FieldKind.Enum:
				cborEncodeValue(c.keyOrder, out, new CBORValue(f.asInt()))
			case FieldKind.Uint:
				cborHead(out, 0, uint64(f.asUint()))
			case FieldKind.Float:
				cborFloat(out, f.asFloat())
			case FieldKind.Array:
				let n = f.len()
				if f.typeName := "byte[]" || "uint8[]" {
					cborHead(out, 2, uint64(n))
					for let i = 0; i < n; i++ {
						out.push(byte(f.at(i).asUint()))
					}
					return
				}
				cborHead(out, 4, uint64(n))
				for let i = 0; i < n; i++ {
					cborEncodeElement(c, out, f.at(i), f.elemKind, depth)
				}
			case FieldKind.Map:
				let keys CBORValue[] = []
				let parts byte[][] = []
				for let key in f.keys() {
					keys.push(new CBORValue(key))
					let part byte[]
					cborEncodeElement(c, part, f.entry(key), f.elemKind, depth)
					parts.push(part)
				}
				cborWriteMap(c, out, keys, parts)
			default:
				let nested = f.value()
				if nested is none {
					out.push(byte(0xF6))
				} else {
					cborEncodeAny(c, out, nested, depth + 1)
				}
		}
	}

	// Writes one element of an array field or one value of a map field.
	internal def cborEncodeElement(c CBOR, out byte[], e Field, kind FieldKind, depth int) {
		match kind {
			case FieldKind.String:
				let b = e.asString().bytes()
				cborHead(out, 3, uint64(b.len()))
				out.push(...b)
			case FieldKind.Bool:
				out.push(byte(e.asBool() ?? (0xF5, 0xF4)))
			case FieldKind.Int, FieldKind.Enum:
				cborEncodeValue(c.keyOrder, out, new CBORValue(e.asInt()))
			case FieldKind.Uint:
				cborHead(out, 0, uint64(e.asUint()))
			case FieldKind.Float:
				cborFloat(out, e.asFloat())
			default:
				let nested = e.value()
				if nested is none {
					out.push(byte(0xF6))
				} else {
					cborEncodeAny(c, out, nested, depth + 1)
				}
		}
	}

	// Reads the argument of a head whose additional information is ai, or
	// fails when the bytes end first or ai is reserved.
	internal def cborArg(r CBORReader, ai int) !uint64 {
		return uint64(ai) when ai < 24
		fail "cbor: reserved additional information {ai} at offset {r.pos - 1}" when ai > 27
		let size = 1 << (ai - 24)
		fail "cbor: data ends inside a head at offset {r.pos}" when r.pos + size > r.data.len()
		let v uint64 = 0
		for let i = 0; i < size; i++ {
			v = (v << 8) | uint64(r.data[r.pos + i])
		}
		r.pos += size
		return v
	}

	// Reads one item.
	internal def cborRead(r CBORReader, depth int) !CBORValue {
		expects {
			assert depth <= r.maxDepth onerror fail "cbor: input nests deeper than {r.maxDepth} levels"
			assert r.pos < r.data.len() onerror fail "cbor: data ends where an item was expected"
		}
		let start = r.pos
		let ib = int(r.data[r.pos])
		r.pos++
		let major = ib >> 5
		let ai = ib & 0x1F
		let v = new CBORValue()

		if ai == 31 {
			match major {
				case 2, 3:
					v.k = major == 2 ?? (CBORKind.Bytes, CBORKind.Text)
					for {
						fail "cbor: indefinite string at offset {start} has no break" when r.pos >= r.data.len()
						if int(r.data[r.pos]) == 0xFF {
							r.pos++
							break
						}
						let chunkHead = int(r.data[r.pos])
						fail "cbor: indefinite string at offset {start} holds a chunk of another type" when chunkHead >> 5 != major || (chunkHead & 0x1F) == 31
						let chunk = try cborRead(r, depth + 1)
						v.raw.push(...chunk.raw)
					}
					fail "cbor: text at offset {start} is not UTF-8" when major == 3 && !validUTF8(v.raw)
					return v
				case 4:
					v.k = CBORKind.Array
					for {
						fail "cbor: indefinite array at offset {start} has no break" when r.pos >= r.data.len()
						if int(r.data[r.pos]) == 0xFF {
							r.pos++
							break
						}
						v.items.push(try cborRead(r, depth + 1))
					}
					return v
				case 5:
					v.k = CBORKind.Map
					let seen map<string, bool>{}
					for {
						fail "cbor: indefinite map at offset {start} has no break" when r.pos >= r.data.len()
						if int(r.data[r.pos]) == 0xFF {
							r.pos++
							break
						}
						try cborReadEntry(r, v, seen, depth)
					}
					return v
				case 7:
					fail "cbor: unexpected break at offset {start}"
				default:
					fail "cbor: major type {major} cannot have an indefinite length (offset {start})"
			}
		}

		if major == 7 {
			if ai == 25 {
				let h = try cborArg(r, ai)
				v.k = CBORKind.Float
				v.f = fromHalf(int(h))
				return v
			}
			if ai == 26 {
				let b = try cborArg(r, ai)
				v.k = CBORKind.Float
				v.f = float(__bitcast_f32_from_u32(uint32(b)))
				return v
			}
			if ai == 27 {
				let b = try cborArg(r, ai)
				v.k = CBORKind.Float
				v.f = float(__bitcast_f64_from_u64(b))
				return v
			}
			let sv = try cborArg(r, ai)
			fail "cbor: two-byte simple value {sv} below 32 at offset {start}" when ai == 24 && sv < uint64(32)
			match int(sv) {
				case 20, 21:
					v.k = CBORKind.Bool
					v.n = sv == uint64(21) ?? (uint64(1), uint64(0))
				case 22:
					v.k = CBORKind.Null
				case 23:
					v.k = CBORKind.Undefined
				default:
					v.k = CBORKind.Simple
					v.n = sv
			}
			return v
		}

		let arg = try cborArg(r, ai)
		let left = uint64(r.data.len() - r.pos)
		match major {
			case 0, 1:
				v.k = CBORKind.Int
				v.neg = major == 1
				v.n = arg
			case 2, 3:
				fail "cbor: string at offset {start} runs past the end" when arg > left
				v.k = major == 2 ?? (CBORKind.Bytes, CBORKind.Text)
				let n = int(arg)
				v.raw = r.data.slice(r.pos, n).clone()
				r.pos += n
				fail "cbor: text at offset {start} is not UTF-8" when major == 3 && !validUTF8(v.raw)
			case 4:
				fail "cbor: array at offset {start} claims more items than bytes remain" when arg > left
				v.k = CBORKind.Array
				v.items.cap(int(arg))
				for let i = 0; i < int(arg); i++ {
					v.items.push(try cborRead(r, depth + 1))
				}
			case 5:
				fail "cbor: map at offset {start} claims more entries than bytes remain" when arg > left / uint64(2)
				v.k = CBORKind.Map
				let seen map<string, bool>{}
				for let i = 0; i < int(arg); i++ {
					try cborReadEntry(r, v, seen, depth)
				}
			default:
				v.k = CBORKind.Tag
				v.n = arg
				v.items.push(try cborRead(r, depth + 1))
		}
		return v
	}

	// Reads one key and value into a map, failing on a duplicate key.
	internal def cborReadEntry(r CBORReader, m CBORValue, seen map<string, bool>, depth int) !none {
		let at = r.pos
		let key = try cborRead(r, depth + 1)
		let kb byte[]
		cborEncodeValue(CBORKeyOrder.AsWritten, kb, key)
		let id = kb.hex()
		fail "cbor: duplicate map key {key.str()} at offset {at}" when seen.hasKey(id)
		seen[id] = true
		m.items.push(key)
		m.vals.push(try cborRead(r, depth + 1))
		return none
	}

	// Binds an item onto an object's fields.
	internal def cborBind(item CBORValue, target any, depth int, maxDepth int) !none {
		expects {
			assert depth < maxDepth onerror fail "cbor: input nests deeper than {maxDepth} objects"
		}
		return none when item.k == CBORKind.Null || item.k == CBORKind.Undefined
		fail "cbor: cannot read {cborDescribe(item)} into an object" when item.k != CBORKind.Map
		let fields = reflection.fields(target)
		for let (i, key) in item.items {
			let f = cborFieldFor(fields, key)
			continue when f is none
			try cborBindField(item.vals[i], f, depth, maxDepth)
		}
		return none
	}

	// The field a map key names: an `@cbor(key = …)` integer key, else the
	// `@cbor` name or the declared name exactly, else case-insensitively.
	internal def cborFieldFor(fields Field[], key CBORValue) ?Field {
		for let (_, f) in fields {
			continue when fieldFlag(f, cborAttr, "ignore")
			return f when cborFieldKey(f).equals(key)
		}
		return none when key.k != CBORKind.Text
		let lowered = string(key.raw).lower()
		for let (_, f) in fields {
			continue when fieldFlag(f, cborAttr, "ignore") || f.attr(cborAttr, "key") != ""
			let name = f.attr(cborAttr, "name")
			return f when (name == "" ?? (f.name, name)).lower() == lowered
		}
		return none
	}

	// Stores one item in a field.
	internal def cborBindField(v CBORValue, f Field, depth int, maxDepth int) !none {
		return none when v.k == CBORKind.Null || v.k == CBORKind.Undefined
		match f.kind {
			case FieldKind.Array:
				if f.typeName := "byte[]" || "uint8[]" {
					let b = try v.asBytes()
					f.setLen(b.len())
					for let (i, x) in b {
						f.at(i).setUint(uint(x))
					}
					return none
				}
				fail "cbor: cannot read {cborDescribe(v)} into `{f.name}`" when v.k != CBORKind.Array
				f.setLen(v.items.len())
				for let (i, e) in v.items {
					try cborBindScalar(e, f.at(i), f.elemKind, depth, maxDepth)
				}
				return none
			case FieldKind.Map:
				fail "cbor: cannot read {cborDescribe(v)} into `{f.name}`" when v.k != CBORKind.Map
				f.clear()
				for let (i, key) in v.items {
					let name = try key.asString()
					continue when v.vals[i].k == CBORKind.Null
					try cborBindScalar(v.vals[i], f.entry(name), f.elemKind, depth, maxDepth)
				}
				return none
			default:
				return try cborBindScalar(v, f, f.kind, depth, maxDepth)
		}
	}

	// Stores a scalar or nested object in a field, array element or map entry.
	internal def cborBindScalar(v CBORValue, f Field, kind FieldKind, depth int, maxDepth int) !none {
		match kind {
			case FieldKind.String:
				f.setString(try v.asString())
			case FieldKind.Bool:
				f.setBool(try v.asBool())
			case FieldKind.Int, FieldKind.Enum:
				f.setInt(try v.asInt())
			case FieldKind.Uint:
				f.setUint(uint(try v.asUint()))
			case FieldKind.Float:
				f.setFloat(try v.asFloat())
			case FieldKind.Struct:
				let nested = f.ensureValue()
				fail "cbor: cannot read a map into `{f.name}`" when nested is none
				try cborBind(v, nested, depth + 1, maxDepth)
			default:
				fail "cbor: cannot store {cborDescribe(v)} in `{f.name}`"
		}
		return none
	}

	// The kind of an item in words, for error messages.
	internal def cborDescribe(v CBORValue) string {
		return "a {v.k.name.lower()} item"
	}
}

internal partial module std.data.encoding.cbor {
	use (
		std.reflection
		std.reflection::(Field, FieldKind, MetadataStore)
		std.data.encoding::*
		std.data.encoding.json::(fieldFlag, fieldIsEmpty, recordFlag)
	)

	def cborRecord(store MetadataStore, name string, key int, omitempty bool, ignore bool) {
		let prefix = "encoder.cbor."
		if name == "" {
			store.delete(prefix + "name")
		} else {
			store.save(prefix + "name", name)
		}
		store.save(prefix + "key", key.str())
		recordFlag(store, prefix + "omitempty", omitempty)
		recordFlag(store, prefix + "ignore", ignore)
	}

	// Writes a major type and argument in the shortest head (RFC 8949 §3).
	def cborHead(out byte[], major int, arg uint64) {
		let mt = major << 5
		if arg < uint64(24) {
			out.push(byte(mt | int(arg)))
		} else if arg <= uint64(0xFF) {
			out.push(byte(mt | 24), byte(arg))
		} else if arg <= uint64(0xFFFF) {
			out.push(byte(mt | 25), byte(arg >> 8), byte(arg & uint64(0xFF)))
		} else if arg <= uint64(0xFFFFFFFF) {
			out.push(byte(mt | 26))
			for let s = 24; s >= 0; s -= 8 {
				out.push(byte((arg >> s) & uint64(0xFF)))
			}
		} else {
			out.push(byte(mt | 27))
			for let s = 56; s >= 0; s -= 8 {
				out.push(byte((arg >> s) & uint64(0xFF)))
			}
		}
	}

	// The IEEE 754 half-precision bits of v when a half holds v exactly,
	// -1 otherwise.
	def halfBits(v float) int {
		let bits = __bitcast_u64_from_f64(float64(v))
		let sign = int(bits >> 63) << 15
		let exp = int((bits >> 52) & uint64(0x7FF))
		let mant = bits & uint64(0xFFFFFFFFFFFFF)
		if exp == 0x7FF {
			return -1 when mant != uint64(0)
			return sign | 0x7C00
		}
		return mant == uint64(0) ?? (sign, -1) when exp == 0
		let e = exp - 1023
		if e >= -14 && e <= 15 {
			return -1 when (mant & uint64(0x3FFFFFFFFFF)) != uint64(0)
			return sign | ((e + 15) << 10) | int(mant >> 42)
		}
		if e >= -24 && e < -14 {
			// A subnormal half: the value is m * 2^-24 with m below 1024.
			let shift = 42 + (-14 - e)
			let full = mant | uint64(0x10000000000000)
			return -1 when (full & ((uint64(1) << shift) - uint64(1))) != uint64(0)
			return sign | int(full >> shift)
		}
		return -1
	}

	// The value of half-precision bits (RFC 8949 Appendix D).
	def fromHalf(h int) float {
		let exp = (h >> 10) & 0x1F
		let mant = h & 0x3FF
		let val float
		if exp == 0 {
			val = float(mant) * 0x1p-24
		} else if exp != 31 {
			val = float(mant + 1024) * float(1 << exp) * 0x1p-25
		} else if mant == 0 {
			val = float(__bitcast_f64_from_u64(uint64(0x7FF0000000000000)))
		} else {
			val = float(__bitcast_f64_from_u64(uint64(0x7FF8000000000000)))
		}
		return (h & 0x8000) != 0 ?? (-val, val)
	}

	// Writes a float in the shortest of half, single and double that holds
	// it exactly; NaN is always the half 0x7E00.
	def cborFloat(out byte[], v float) {
		if v != v {
			out.push(byte(0xF9), byte(0x7E), byte(0x00))
			return
		}
		let h = halfBits(v)
		if h >= 0 {
			out.push(byte(0xF9), byte(h >> 8), byte(h & 0xFF))
			return
		}
		let single = float32(v)
		if float(single) == v {
			let b = __bitcast_u32_from_f32(single)
			out.push(byte(0xFA), byte(b >> 24), byte((b >> 16) & 0xFF), byte((b >> 8) & 0xFF), byte(b & 0xFF))
			return
		}
		let b = __bitcast_u64_from_f64(float64(v))
		out.push(byte(0xFB))
		for let s = 56; s >= 0; s -= 8 {
			out.push(byte((b >> s) & uint64(0xFF)))
		}
	}

	// Reports whether bytes are well-formed UTF-8: shortest forms only, no
	// surrogates, nothing above U+10FFFF.
	def validUTF8(b byte[]) bool {
		let i = 0
		let n = b.len()
		for i < n {
			let c = int(b[i])
			if c < 0x80 {
				i++
				continue
			}
			let need = 0
			let lo = 0x80
			let hi = 0xBF
			if c >= 0xC2 && c <= 0xDF {
				need = 1
			} else if c >= 0xE0 && c <= 0xEF {
				need = 2
				lo = c == 0xE0 ?? (0xA0, 0x80)
				hi = c == 0xED ?? (0x9F, 0xBF)
			} else if c >= 0xF0 && c <= 0xF4 {
				need = 3
				lo = c == 0xF0 ?? (0x90, 0x80)
				hi = c == 0xF4 ?? (0x8F, 0xBF)
			} else {
				return false
			}
			return false when i + need >= n
			let first = int(b[i + 1])
			return false when first < lo || first > hi
			for let j = 2; j <= need; j++ {
				let cont = int(b[i + j])
				return false when cont < 0x80 || cont > 0xBF
			}
			i += need + 1
		}
		return true
	}

	// The indexes of encoded keys in the given order.
	def cborKeyOrder(keys byte[][], order CBORKeyOrder) int[] {
		let idx int[] = []
		for let i = 0; i < keys.len(); i++ {
			idx.push(i)
		}
		let lengthFirst = order == CBORKeyOrder.LengthFirst
		return idx.sort((a int, b int) => cborKeyLess(keys[a], keys[b], lengthFirst))
	}

	// Reports whether encoded key a sorts before b.
	def cborKeyLess(a byte[], b byte[], lengthFirst bool) bool {
		return a.len() < b.len() when lengthFirst && a.len() != b.len()
		let n = a.len() < b.len() ?? (a.len(), b.len())
		for let i = 0; i < n; i++ {
			return a[i] < b[i] when a[i] != b[i]
		}
		return a.len() < b.len()
	}
}
