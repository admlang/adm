partial module std.data.encoding.codepages {
	// A single-byte character set: each byte stands for one character.
	enum CodePage {
		// IBM PC / MS-DOS, the default for zip entry names without the UTF-8
		// flag and for OEM bitmap fonts. Bytes below 0x80 are ASCII.
		CP437,
		// Windows Western European. Bytes 0x80 to 0x9F hold typographic
		// characters (curly quotes, dashes, the euro sign); the five it
		// leaves undefined stand for the C1 control of the same value, as
		// browsers read them.
		Windows1252,
		// ISO 8859-1: every byte is the code point of the same value.
		Latin1
	}

	// The code page an IANA charset name (as MIME and HTTP write it) stands
	// for, matched without regard to case: `iso-8859-1`/`latin1`,
	// `windows-1252`/`cp1252`, `ibm437`/`cp437`. None for any other name.
	def forCharset(name string) ?CodePage {
		let key = name.trim().lower()
		return CodePage.Latin1 when key := "iso-8859-1" || "iso8859-1" || "iso_8859-1" || "latin1" || "latin-1" || "l1"
		return CodePage.Windows1252 when key := "windows-1252" || "cp1252" || "x-cp1252"
		return CodePage.CP437 when key := "ibm437" || "cp437" || "437"
		return none
	}

	// Decodes bytes in the code page into a string.
	def decode(data byte[], page CodePage) string {
		let out byte[]
		out.cap(data.len() + data.len() / 2)
		for let i = 0; i < data.len(); i++ {
			let b = data[i]
			if b < 0x80 {
				out.push(b)
			} else {
				out.append(decode(b, page))
			}
		}
		return string(out)
	}

	// The character one byte stands for in the code page.
	def decode(b byte, page CodePage) char {
		let v = int(b)
		return char(v) when v < 0x80
		match page {
			case CodePage.CP437:
				return char(cp437High[v - 0x80])
			case CodePage.Windows1252:
				return char(v < 0xA0 ?? (windows1252C1[v - 0x80], v))
			case CodePage.Latin1:
				return char(v)
		}
	}

	// The byte that stands for the character in the code page, none when the
	// code page has no byte for it.
	def encode(c char, page CodePage) ?byte {
		let cp = int(c)
		return byte(cp) when cp < 0x80
		match page {
			case CodePage.CP437:
				let b = cp437Bytes.get(cp)
				return none when b is none
				return byte(b)
			case CodePage.Windows1252:
				let b = windows1252Bytes.get(cp)
				return byte(b) unless b is none
				return byte(cp) when cp >= 0xA0 && cp <= 0xFF
				return none
			case CodePage.Latin1:
				return byte(cp) when cp <= 0xFF
				return none
		}
	}

	// Encodes the string in the code page. A character the code page has no
	// byte for becomes `replacement`; without one, the encoding fails.
	// Fails when a character cannot be encoded and no replacement is given.
	def encode(text string, page CodePage, replacement ?byte = none) !byte[] {
		let out byte[]
		for let (_, c) in text {
			let b = encode(c, page)
			if b is none {
				fail "codepages: {page} has no byte for U+" + int(c).hex() when replacement is none
				out.push(replacement)
			} else {
				out.push(b)
			}
		}
		return out
	}

	// Code points of CP437 bytes 0x80 to 0xFF.
	internal let cp437High = int[
		0x00C7, 0x00FC, 0x00E9, 0x00E2, 0x00E4, 0x00E0, 0x00E5, 0x00E7, 0x00EA, 0x00EB, 0x00E8, 0x00EF, 0x00EE, 0x00EC, 0x00C4, 0x00C5,
		0x00C9, 0x00E6, 0x00C6, 0x00F4, 0x00F6, 0x00F2, 0x00FB, 0x00F9, 0x00FF, 0x00D6, 0x00DC, 0x00A2, 0x00A3, 0x00A5, 0x20A7, 0x0192,
		0x00E1, 0x00ED, 0x00F3, 0x00FA, 0x00F1, 0x00D1, 0x00AA, 0x00BA, 0x00BF, 0x2310, 0x00AC, 0x00BD, 0x00BC, 0x00A1, 0x00AB, 0x00BB,
		0x2591, 0x2592, 0x2593, 0x2502, 0x2524, 0x2561, 0x2562, 0x2556, 0x2555, 0x2563, 0x2551, 0x2557, 0x255D, 0x255C, 0x255B, 0x2510,
		0x2514, 0x2534, 0x252C, 0x251C, 0x2500, 0x253C, 0x255E, 0x255F, 0x255A, 0x2554, 0x2569, 0x2566, 0x2560, 0x2550, 0x256C, 0x2567,
		0x2568, 0x2564, 0x2565, 0x2559, 0x2558, 0x2552, 0x2553, 0x256B, 0x256A, 0x2518, 0x250C, 0x2588, 0x2584, 0x258C, 0x2590, 0x2580,
		0x03B1, 0x00DF, 0x0393, 0x03C0, 0x03A3, 0x03C3, 0x00B5, 0x03C4, 0x03A6, 0x0398, 0x03A9, 0x03B4, 0x221E, 0x03C6, 0x03B5, 0x2229,
		0x2261, 0x00B1, 0x2265, 0x2264, 0x2320, 0x2321, 0x00F7, 0x2248, 0x00B0, 0x2219, 0x00B7, 0x221A, 0x207F, 0x00B2, 0x25A0, 0x00A0,
	]

	// Code points of Windows-1252 bytes 0x80 to 0x9F.
	internal let windows1252C1 = int[
		0x20ac, 0x81, 0x201a, 0x192, 0x201e, 0x2026, 0x2020, 0x2021, 0x2c6, 0x2030, 0x160, 0x2039, 0x152, 0x8d, 0x17d, 0x8f,
		0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014, 0x2dc, 0x2122, 0x161, 0x203a, 0x153, 0x9d, 0x17e, 0x178
	]

	internal let cp437Bytes = reverse(cp437High)
	internal let windows1252Bytes = reverse(windows1252C1)

	// Byte for each code point of a table that starts at 0x80.
	internal def reverse(table int[]) map<int, int> {
		let m = new map<int, int>()
		for let (i, cp) in table {
			m.set(cp, 0x80 + i)
		}
		return m
	}
}
