partial module std.data.encoding.codepages {
	check "Code pages" {
		use std.testing

		@test()
		def decodesEachCodePage() !none {
			let raw = byte[0x63, 0x61, 0x66, 0x82, 0x80, 0xE9]
			assert decode(raw, CodePage.CP437) == "caféÇΘ"
			assert decode(raw, CodePage.Windows1252) == "caf‚€é"
			assert decode(raw, CodePage.Latin1) == "caf\u0082\u0080é"
			assert decode(byte(0x81), CodePage.Windows1252) == '\u0081'
		}

		@test()
		def encodesAndRoundTrips() !none {
			for let (_, page) in [CodePage.CP437, CodePage.Windows1252, CodePage.Latin1] {
				let all byte[]
				for let i = 0x20; i < 0x100; i++ {
					all.push(byte(i))
				}
				assert (try encode(decode(all, page), page)).equals(all)
			}
			let euro = encode('€', CodePage.Windows1252)
			fail "no byte for the euro sign" when euro is none
			assert euro == byte(0x80)
			assert encode('€', CodePage.Latin1) is none
		}

		@test()
		def encodeFailsOrReplaces() !none {
			let failed = false
			encode("a中", CodePage.CP437) onerror (err error) {
				failed = true
				recover byte[]
			}
			assert failed
			assert (try encode("a中", CodePage.CP437, replacement = byte(0x3F))).equals(byte[0x61, 0x3F])
		}

		@test()
		def findsPageByCharset() !none {
			let latin = forCharset("ISO-8859-1")
			let windows = forCharset(" windows-1252 ")
			let dos = forCharset("cp437")
			fail "a known charset has no page" when latin is none || windows is none || dos is none
			assert latin == CodePage.Latin1 && windows == CodePage.Windows1252 && dos == CodePage.CP437
			assert forCharset("utf-8") is none
			return none
		}

		@test()
		def decodesMacCodePages() !none {
			assert decode(byte[0x80, 0xDA, 0xDB], CodePage.MacTurkish) == "ÄĞğ"
			assert decode(byte[0x41, 0x80], CodePage.MacRoman) == "AÄ"
			assert decode(byte[0x80, 0xDF], CodePage.MacCyrillic) == "Ая"
			assert decode(byte(0xA1), CodePage.MacGreek) == 'Γ'
			// One Hebrew byte stands for a letter with its point.
			assert decode(byte[0x81], CodePage.MacHebrew) == "\u05F2\u05B7"
			assert decode(byte(0xFF), CodePage.MacThai) == '\uFFFD' // undefined
			let mac = forCharset("macintosh")
			fail "macintosh has no page" when mac is none
			assert mac == CodePage.MacRoman
		}

		@test()
		def encodesMacCodePages() !none {
			assert (try encode("Ğ", CodePage.MacTurkish)).equals(byte[0xDA])
			assert encode('Ğ', CodePage.MacRoman) is none
			// Every byte that stands for one character comes back to itself,
			// unless an earlier byte has the same character.
			for let (_, page) in [CodePage.MacRoman, CodePage.MacCentralEurope, CodePage.MacCroatian, CodePage.MacIcelandic, CodePage.MacRomanian, CodePage.MacTurkish, CodePage.MacCeltic, CodePage.MacGaelic, CodePage.MacGreek, CodePage.MacCyrillic] {
				for let i = 0x80; i < 0x100; i++ {
					let b = encode(decode(byte(i), page), page)
					fail "{page} byte {i} does not round-trip" when b is none
					assert b == byte(i)
				}
			}
		}

		@test()
		def decodesTheWhatwgPages() !none {
			let ru = forCharset("windows-1251")
			fail "no windows-1251" when ru is none
			assert decode(byte[0xCF, 0xF0, 0xE8, 0xE2, 0xE5, 0xF2], ru) == "Привет" // Cyrillic Windows
			let koi = forCharset("KOI8-R")
			fail "no koi8-r" when koi is none
			assert decode(byte[0xF0, 0xD2, 0xC9], koi) == "При" // the same letters in KOI8-R
			let tr = forCharset("iso-8859-9")
			assert tr is CodePage && tr == CodePage.Windows1254 // WHATWG reads ISO 8859-9 as Windows-1254
			let polish = try encode("Żółw", CodePage.ISO8859_2)
			assert "{polish}" == "[175, 243, 179, 119]" // and encodes back
			let latin = forCharset("latin1")
			assert latin is CodePage && latin == CodePage.Latin1 // labels it already had keep their page
		}
	}
}
