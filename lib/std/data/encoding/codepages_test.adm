partial module std.data.encoding.codepages {
	check "Code pages" {
		use std.testing

		@test()
		def decodesEachCodePage() !none {
			let raw = byte[0x63, 0x61, 0x66, 0x82, 0x80, 0xE9]
			assert decode(raw, CodePage.CP437) == "caféÇΘ"
			assert decode(raw, CodePage.Windows1252) == "caf‚€é"
			assert decode(raw, CodePage.Latin1) == "caf\u0082\u0080é"
			assert decode(byte(0x81), CodePage.Windows1252) == '\u0081'
		}

		@test()
		def encodesAndRoundTrips() !none {
			for let (_, page) in [CodePage.CP437, CodePage.Windows1252, CodePage.Latin1] {
				let all byte[]
				for let i = 0x20; i < 0x100; i++ {
					all.push(byte(i))
				}
				assert (try encode(decode(all, page), page)).equals(all)
			}
			let euro = encode('€', CodePage.Windows1252)
			fail "no byte for the euro sign" when euro is none
			assert euro == byte(0x80)
			assert encode('€', CodePage.Latin1) is none
		}

		@test()
		def encodeFailsOrReplaces() !none {
			let failed = false
			encode("a中", CodePage.CP437) onerror (err error) {
				failed = true
				recover byte[]
			}
			assert failed
			assert (try encode("a中", CodePage.CP437, replacement = byte(0x3F))).equals(byte[0x61, 0x3F])
		}

		@test()
		def findsPageByCharset() !none {
			let latin = forCharset("ISO-8859-1")
			let windows = forCharset(" windows-1252 ")
			let dos = forCharset("cp437")
			fail "a known charset has no page" when latin is none || windows is none || dos is none
			assert latin == CodePage.Latin1 && windows == CodePage.Windows1252 && dos == CodePage.CP437
			assert forCharset("utf-8") is none
			return none
		}
	}
}
