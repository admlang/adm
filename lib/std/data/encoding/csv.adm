partial module std.data.encoding {
	// CSV reads and writes comma-separated values (RFC 4180): rows of text
	// fields, a field in double quotes when it holds the separator, a quote
	// or a line break, a quote inside doubled.
	//
	// ```
	// let rows = try new CSV().decode("name,email\r\nAda,ada@example.com\r\n")
	// println(rows[1][0]) // "Ada"
	// let text = new CSV(";").encode([["a;b", "c"]]) // "\"a;b\";c\r\n"
	// ```
	type CSV {
		// The field separator: "," (RFC 4180), ";" as spreadsheets in many
		// locales write it, or "\t".
		separator string = ","

		def new() {}

		def new(separator string) {
			self.separator = separator
		}

		// decode reads the rows of `input`: CRLF or LF line ends, quoted
		// fields that span lines, a UTF-8 byte order mark ignored. A last
		// line without a line end is a row; an empty line is a row of one
		// empty field.
		// Fails when a quoted field is never closed or text follows its
		// closing quote.
		def decode(input string) !string[][] {
			let rows string[][]
			let b = input.trimPrefix("﻿").bytes()
			let sep = separator.bytes()
			fail "csv: the separator must be one byte" unless sep.len() == 1
			let s = sep[0]
			let n = b.len()
			let row string[] = []
			let i = 0
			for i < n {
				let field byte[] = []
				if b[i] == byte('"') {
					i++
					let closed = false
					for i < n {
						if b[i] == byte('"') {
							if i + 1 < n && b[i + 1] == byte('"') {
								field.push(byte('"'))
								i += 2
								continue
							}
							i++
							closed = true
							break
						}
						field.push(b[i])
						i++
					}
					fail "csv: a quoted field is not closed" unless closed
					fail "csv: text after a closing quote at byte {i}" unless i >= n || b[i] == s || b[i] == byte('\r') || b[i] == byte('\n')
				} else {
					for i < n && b[i] != s && b[i] != byte('\r') && b[i] != byte('\n') {
						field.push(b[i])
						i++
					}
				}
				row.push(string(field))
				if i < n && b[i] == s {
					i++
					// A separator at the end of the text ends one empty field.
					row.push("") when i >= n
					continue
				}
				if i < n && b[i] == byte('\r') {
					i++
				}
				if i < n && b[i] == byte('\n') {
					i++
				}
				rows.push(row)
				row = []
			}
			rows.push(row) when row.len() > 0
			return rows
		}

		// encode writes rows, each field quoted when it needs to be, every
		// row ended with CRLF.
		def encode(rows string[][]) string {
			let out = ""
			for let row in rows {
				out += row.mapElem<string>(f => quoteField(f)).join(separator) + "\r\n"
			}
			return out
		}

		// A field as written: in quotes, inner quotes doubled, when it holds
		// the separator, a quote, a line break, or space at either end.
		internal def quoteField(field string) string {
			let needs = field.contains(separator) || field.contains("\"") || field.contains("\n") || field.contains("\r") || (field != "" && (field.startsWith(" ") || field.endsWith(" ")))
			return field unless needs
			return "\"" + field.replace("\"", "\"\"") + "\""
		}
	}
}
