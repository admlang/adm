partial module std.data.encoding {
	use (
		std.io
		std.reflection
		std.reflection::(Field, FieldKind)
		std.simd
		std.data.encoding.json::(encodedKey, fieldFlag, isJsonNumber, scalarText)
	)

	// CSV reads and writes comma-separated values (RFC 4180): rows of text
	// fields, a field in double quotes when it holds the separator, a quote
	// or a line break, a quote inside doubled.
	//
	// ```
	// let rows = try new CSV().decode("name,email\r\nAda,ada@example.com\r\n")
	// println(rows[1][0]) // "Ada"
	// let text = new CSV(";").encode([["a;b", "c"]]) // "\"a;b\";c\r\n"
	// ```
	//
	// With a header row, rows bind to objects by column name:
	//
	// ```
	// struct User {
	//     name string
	//     @csv(name = "e-mail")
	//     email string
	//     age ?int
	// }
	// let users = try new CSV().decodeRecords<User>("name,e-mail,age\r\nAda,ada@example.com,36\r\n")
	// ```
	//
	// CSVReader and CSVWriter do the same a row at a time over a stream.
	type CSV {
		// The field separator: "," (RFC 4180), ";" as spreadsheets in many
		// locales write it, or "\t".
		separator string = ","

		def new() {}

		def new(separator string) {
			self.separator = separator
		}

		// decode reads the rows of `input`: CRLF or LF line ends, quoted
		// fields that span lines, a UTF-8 byte order mark ignored. A last
		// line without a line end is a row; an empty line is a row of one
		// empty field.
		// Fails when a quoted field is never closed or text follows its
		// closing quote.
		def decode(input string) !string[][] {
			let rows string[][]
			let reader = new CSVReader(input.bytes(), separator)
			for try reader.more() {
				rows.push(try reader.next())
			}
			return rows
		}

		// decodeRecords reads rows into objects: the first row names the columns,
		// each later row fills a new T, a column going to the field of that
		// name (or `@csv(name)`), by exact name first, then ignoring case.
		// Columns without a field and fields without a column are left
		// alone; empty lines are skipped. T is a struct or a type with a
		// constructor that takes no arguments; bool, integer, float, string
		// and enum (as its number) fields are filled, and optionals of
		// those, which an empty cell leaves `none`.
		// Fails as the untyped form does, and when a cell does not convert
		// to its field's type; the error names the row and the column.
		def decodeRecords<T>(input string) !T[] {
			let out T[]
			let reader = new CSVReader(input.bytes(), separator)
			for try reader.more() {
				let item = new T()
				out.push(item) when try reader.next(item)
			}
			return out
		}

		// encode writes rows, each field quoted when it needs to be, every
		// row ended with CRLF.
		def encode(rows string[][]) string {
			let out byte[] = []
			let sep = separator.bytes()
			for let row in rows {
				csvAppendRow(out, row, sep)
			}
			return string(out)
		}

		// encodeRecords writes a header row with the column of each field, then a
		// row per object. The columns are those `decodeRecords` fills, in
		// declaration order; fields marked `@csv(ignore = true)` and fields
		// of other types are left out. No objects give an empty text.
		def encodeRecords<T>(records T[]) string {
			let out byte[] = []
			let sep = separator.bytes()
			for let (i, record) in records {
				csvAppendRow(out, csvColumns(record), sep) when i == 0
				csvAppendRow(out, csvCells(record), sep)
			}
			return string(out)
		}

		// detect picks the separator of `sample` (the start of a file is
		// enough) among ",", ";", tab and "|": the one that splits the most
		// of its first rows into the same number of fields, more than one.
		// It sets `separator` to the choice and returns it; a sample none
		// of them splits keeps the current separator.
		def detect(sample string) string {
			let data = sample.bytes()
			let best = separator
			let bestRows = 0
			let bestWidth = 0
			for let (_, candidate) in [",", ";", "\t", "|"] {
				let (rows, width) = csvConsistency(data, candidate)
				if rows > bestRows || (rows == bestRows && width > bestWidth) {
					best = candidate
					bestRows = rows
					bestWidth = width
				}
			}
			separator = best
			return best
		}
	}

	// Sets how a field binds to a CSV column.
	//
	//     name    column name to use instead of the field name
	//     ignore  leave the field out of both directions
	meta def csv(ctx reflection.FieldMetaContext, name string = "", ignore bool = false) {}

	// Sets how a property binds to a CSV column, as on a field.
	meta def csv(ctx reflection.PropertyMetaContext, name string = "", ignore bool = false) {}

	// Qualified name of the `@csv` meta function, used to look up options.
	internal const csvAttr = "std.data.encoding.csv"

	// CSVReader reads CSV a row at a time from bytes or a stream, holding
	// only the rows not yet read.
	//
	// ```
	// let reader = new CSVReader(file)
	// for try reader.more() {
	//     let row = try reader.next()
	// }
	// ```
	//
	// With a header row, `next(target)` fills an object by column name:
	//
	// ```
	// let reader = new CSVReader(file, ";")
	// for try reader.more() {
	//     let user = new User()
	//     continue unless try reader.next(user)
	// }
	// ```
	type CSVReader {
		internal data  byte[]
		internal i     int        = 0
		internal src   ?io.Reader
		internal sep   string
		internal begun bool       = false
		// The separator as its byte, set when reading begins.
		internal mark  byte       = byte(0)

		// Column names, once the header row is read.
		internal names    string[]
		internal named    bool     = false
		// Per column, the index of the field it fills in `reflection.fields`
		// of the bound type, -1 for none.
		internal plan     int[]
		internal planType string   = ""

		// Rows read so far, the header included.
		row int = 0

		// Reads from the bytes.
		def new(data byte[], separator string = ",") {
			self.data = data
			sep = separator
		}

		// Reads from the reader, buffering what it yields.
		def new(reader io.Reader, separator string = ",") {
			src = reader
			sep = separator
		}

		// Reports whether another row follows, reading from the stream when
		// the buffer is empty.
		// Fails when the reader does or the separator is not one byte.
		def more() !bool {
			try csvBegin(self) unless begun
			return true when i < data.len()
			return try csvFill(self)
		}

		// Reads the next row as its fields. An empty line is a row of one
		// empty field.
		// Fails when no row is left, a quoted field is never closed, text
		// follows a closing quote, or the reader fails.
		def next() !string[] {
			fail "csv: no row is left" unless try more()
			let fields string[] = []
			for {
				let end = try csvRow(self, fields)
				if end >= 0 {
					i = end
					row++
					return fields
				}
				// The row runs past the buffer: read on and scan it again.
				let _ = try csvFill(self)
				fields = []
			}
		}

		// header reads the first row as the column names (space around a
		// name dropped) and returns them; later calls return the same names.
		// `next(target)` calls it when it has not been called.
		// Fails when the input is empty or the row does not parse.
		def header() !string[] {
			return names when named
			fail "csv: the input has no header row" unless try more()
			let cells = try next()
			names = cells.mapElem<string>(c => c.trim())
			named = true
			return names
		}

		// Reads the next row into target's fields by column name, as
		// `CSV.decodeRecords` does, taking the header row first when it has not
		// been read. Returns false, with target untouched, when only empty
		// lines were left.
		// Fails as `next()` does, and when a cell does not convert to its
		// field's type.
		def next(target any) !bool {
			if !named {
				let _ = try header()
			}
			for try more() {
				let cells = try next()
				continue when cells.len() == 1 && cells[0] == ""
				let kind = reflection.typeName(target)
				if kind != planType {
					plan = csvPlan(names, target)
					planType = kind
				}
				let fields = reflection.fields(target)
				for let c = 0; c < cells.len() && c < plan.len(); c++ {
					continue when plan[c] < 0
					try csvSetCell(fields[plan[c]], cells[c], row, names[c])
				}
				return true
			}
			return false
		}
	}

	// CSVWriter writes CSV a row at a time to a stream, one `write` to the
	// stream per row.
	//
	// ```
	// let writer = new CSVWriter(file)
	// try writer.write(["name", "email"])
	// try writer.write(["Ada", "ada@example.com"])
	// ```
	type CSVWriter {
		internal out    io.Writer
		internal sep    byte[]
		internal headed bool      = false

		// Rows written so far, the header included.
		row int = 0

		def new(writer io.Writer, separator string = ",") {
			out = writer
			sep = separator.bytes()
		}

		// Writes a row, each field quoted when it needs to be, ended with
		// CRLF.
		// Fails when the writer does.
		def write(fields string[]) !none {
			let line byte[] = []
			csvAppendRow(line, fields, sep)
			let _ = try out.write(line)
			row++
			return none
		}

		// Writes an object as a row of its fields, as `CSV.encodeRecords` does;
		// the first call writes the header row before it.
		// Fails when the writer does.
		def writeRecord(record any) !none {
			if !headed {
				try write(csvColumns(record))
				headed = true
			}
			return write(csvCells(record))
		}
	}

	// Checks the separator and drops a byte order mark, once per reader.
	internal def csvBegin(r CSVReader) !none {
		let s = r.sep.bytes()
		fail "csv: the separator must be one byte" unless s.len() == 1
		fail "csv: the separator cannot be a quote or a line break" when s[0] == byte('"') || s[0] == byte('\r') || s[0] == byte('\n')
		r.mark = s[0]
		r.begun = true
		// The mark is three bytes; a stream may yield fewer per read.
		for r.data.len() < 3 {
			break unless try csvFill(r)
		}
		if r.data.len() >= 3 && r.data[0] == byte(0xEF) && r.data[1] == byte(0xBB) && r.data[2] == byte(0xBF) {
			r.i = 3
		}
		return none
	}

	// Reads more of the stream behind the unread bytes, at least as much as
	// is buffered so that a row scanned again costs no more than it did to
	// read. Reports false when the stream has ended.
	internal def csvFill(r CSVReader) !bool {
		let src = r.src
		return false when src is none
		if r.i > 0 {
			r.data = r.data.slice(r.i, r.data.len() - r.i).clone()
			r.i = 0
		}
		let chunk byte[]
		chunk.len(r.data.len() > 65536 ?? (r.data.len(), 65536))
		let got = try src.read(chunk)
		if got <= 0 {
			r.src = none
			return false
		}
		r.data += chunk.slice(0, got)
		return true
	}

	// Index of the first byte at or after `from` equal to a, b or c, else
	// the length of data.
	internal def csvFind(data byte[], from int, a byte, b byte, c byte) int {
		let n = data.len()
		let i = from
		// Most fields are a few bytes: look at those before setting up vectors.
		let near = from + 8 < n ?? (from + 8, n)
		for i < near {
			return i when data[i] == a || data[i] == b || data[i] == c
			i++
		}
		if i + 32 <= n {
			let va = simd.splat32<byte>(a)
			let vb = simd.splat32<byte>(b)
			let vc = simd.splat32<byte>(c)
			for i + 32 <= n {
				let v = simd.load32<byte>(data, i)
				let hit = simd.eq(v, va).bits() | simd.eq(v, vb).bits() | simd.eq(v, vc).bits()
				return i + hit.trailingZeros() when hit != uint64(0)
				i += 32
			}
		}
		for i < n {
			return i when data[i] == a || data[i] == b || data[i] == c
			i++
		}
		return n
	}

	// Scans the row at the reader's position into `fields` and returns the
	// position after it, or -1 when the row may continue in bytes the
	// stream has not yielded yet (`fields` is then partial).
	internal def csvRow(r CSVReader, fields string[]) !int {
		let b = r.data
		let n = b.len()
		let open = !(r.src is none)
		let s = r.mark
		let quote = byte('"')
		let i = r.i
		for {
			if i >= n {
				return -1 when open
				// Only a separator leads here: it ends one empty field.
				fields.push("")
				return n
			}
			if b[i] == quote {
				i++
				let start = i
				let text byte[] = []
				let closed = false
				for !closed {
					let j = csvFind(b, i, quote, quote, quote)
					if j >= n {
						return -1 when open
						fail "csv: a quoted field is not closed in row {r.row + 1}"
					}
					if j + 1 >= n {
						return -1 when open
						closed = true
					} else if b[j + 1] != quote {
						closed = true
					}
					if closed && start == i {
						// No doubled quote inside: the field is one run of bytes.
						fields.push(string(b.slice(start, j - start)))
						i = j + 1
					} else if closed {
						text += b.slice(i, j - i)
						fields.push(string(text))
						i = j + 1
					} else {
						text += b.slice(i, j - i + 1)
						i = j + 2
						start = -1
					}
				}
				fail "csv: text after a closing quote in row {r.row + 1}" unless i >= n || b[i] == s || b[i] == byte('\r') || b[i] == byte('\n')
			} else {
				let j = csvFind(b, i, s, byte('\r'), byte('\n'))
				return -1 when j >= n && open
				fields.push(string(b.slice(i, j - i)))
				i = j
			}
			return n when i >= n
			if b[i] == s {
				i++
				continue
			}
			if b[i] == byte('\r') {
				return -1 when i + 1 >= n && open
				i++
			}
			i++ when i < n && b[i] == byte('\n')
			return i
		}
	}

	// Appends a row to out: fields joined by the separator, ended with CRLF.
	internal def csvAppendRow(out byte[], fields string[], sep byte[]) {
		for let (k, field) in fields {
			out.push(...sep) when k > 0
			let b = field.bytes()
			let n = b.len()
			let needs = n > 0 && (b[0] == byte(' ') || b[n - 1] == byte(' '))
			let quotes = 0
			for let (_, c) in b {
				if c == byte('"') {
					quotes++
				} else if c == byte('\n') || c == byte('\r') || (sep.len() == 1 && c == sep[0]) {
					needs = true
				}
			}
			needs = true when quotes > 0 || (sep.len() > 1 && field.contains(string(sep)))
			if !needs {
				out.push(...b)
				continue
			}
			out.push(byte('"'))
			if quotes == 0 {
				out.push(...b)
			} else {
				for let (_, c) in b {
					out.push(c)
					out.push(c) when c == byte('"')
				}
			}
			out.push(byte('"'))
		}
		out.push(byte('\r'))
		out.push(byte('\n'))
	}

	// The kind a cell of the field holds, FieldKind.Other when the field
	// has no column: an optional counts as what it holds.
	internal def csvCellKind(f Field) FieldKind {
		return FieldKind.Other when fieldFlag(f, csvAttr, "ignore")
		let kind = f.kind == FieldKind.Optional ?? (f.elemKind, f.kind)
		return kind when kind := FieldKind.Bool || FieldKind.Int || FieldKind.Uint || FieldKind.Float || FieldKind.String || FieldKind.Enum
		return FieldKind.Other
	}

	// The header row of an object's type.
	internal def csvColumns(record any) string[] {
		let out string[] = []
		for let (_, f) in reflection.fields(record) {
			continue when csvCellKind(f) == FieldKind.Other
			out.push(encodedKey(f, csvAttr, CaseStyle.AsIs))
		}
		return out
	}

	// An object's row: one cell per column of `csvColumns`.
	internal def csvCells(record any) string[] {
		let out string[] = []
		for let (_, f) in reflection.fields(record) {
			let kind = csvCellKind(f)
			continue when kind == FieldKind.Other
			if f.kind == FieldKind.Optional && f.value() is none {
				out.push("")
			} else if kind == FieldKind.Enum {
				out.push(f.asInt().str())
			} else {
				out.push(scalarText(f, kind))
			}
		}
		return out
	}

	// Per column name, the index of the field of target it fills, -1 for
	// none: the field whose column name is equal, else equal ignoring case.
	internal def csvPlan(names string[], target any) int[] {
		let fields = reflection.fields(target)
		let keys string[] = []
		for let (_, f) in fields {
			keys.push(csvCellKind(f) == FieldKind.Other ?? ("", encodedKey(f, csvAttr, CaseStyle.AsIs)))
		}
		let plan int[] = []
		for let (_, name) in names {
			let at = -1
			for let (k, key) in keys {
				if key == name && key != "" {
					at = k
					break
				}
			}
			if at < 0 && name != "" {
				let lowered = name.lower()
				for let (k, key) in keys {
					if key != "" && (key.lower() == lowered || fields[k].name.lower() == lowered) {
						at = k
						break
					}
				}
			}
			plan.push(at)
		}
		return plan
	}

	// Stores a cell in a field, converted to the field's type.
	internal def csvSetCell(f Field, cell string, row int, column string) !none {
		let kind = csvCellKind(f)
		if kind == FieldKind.String {
			f.setString(cell)
			return none
		}
		let text = cell.trim()
		if text == "" {
			// An empty cell is no value: none for an optional, else the
			// field keeps what it holds.
			f.setNone() when f.kind == FieldKind.Optional
			return none
		}
		match kind {
			case FieldKind.Bool:
				match text.lower() {
					case "true", "yes", "on", "y", "1":
						f.setBool(true)
					case "false", "no", "off", "n", "0":
						f.setBool(false)
					default:
						fail "csv: row {row}, column `{column}`: `{text}` is not a bool"
				}
			case FieldKind.Int, FieldKind.Uint, FieldKind.Enum:
				fail "csv: row {row}, column `{column}`: `{text}` is not an integer" unless csvIsInteger(text, kind != FieldKind.Uint)
				if kind == FieldKind.Uint {
					f.setUint(parseInt<uint>(text))
				} else {
					f.setInt(parseInt<int>(text))
				}
			case FieldKind.Float:
				fail "csv: row {row}, column `{column}`: `{text}` is not a number" unless isJsonNumber(text.trimPrefix("+")) || csvIsSpecialFloat(text)
				f.setFloat(parseFloat<float>(text))
			default:
		}
		return none
	}

	// Reports whether text is decimal digits after an optional sign.
	internal def csvIsInteger(text string, signed bool) bool {
		let b = text.bytes()
		let i = 0
		i++ when b.len() > 0 && (b[0] == byte('+') || (signed && b[0] == byte('-')))
		return false when i >= b.len()
		for i < b.len() {
			return false unless b[i] >= byte('0') && b[i] <= byte('9')
			i++
		}
		return true
	}

	internal def csvIsSpecialFloat(text string) bool {
		return text.lower().trimPrefix("+").trimPrefix("-") := "inf" || "infinity" || "nan"
	}

	// How well a separator splits the first rows of data: how many of up to
	// 32 rows have the most common field count, and that count. (0, 0) when
	// the rows do not parse or the count is one.
	internal def csvConsistency(data byte[], separator string) (int, int) {
		let reader = new CSVReader(data, separator)
		let counts = map<int, int>{}
		for let k = 0; k < 32; k++ {
			let has = reader.more() onerror recover false
			break unless has
			let cells = reader.next() onerror (err error) {
				return (0, 0)
			}
			continue when cells.len() == 1 && cells[0] == ""
			let seen = counts.get(cells.len())
			counts[cells.len()] = seen is none ?? (1, seen + 1)
		}
		let rows = 0
		let width = 0
		for let (w, c) in counts {
			if c > rows || (c == rows && w > width) {
				rows = c
				width = w
			}
		}
		return (0, 0) when width <= 1
		return (rows, width)
	}
}
