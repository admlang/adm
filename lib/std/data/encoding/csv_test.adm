partial module std.data.encoding {
	use std.testing

	internal enum CsvPlan {
		Free,
		Paid,
	}

	internal struct CsvUser {
		name string
		@csv(name = "e-mail")
		email string
		age ?int
		score float
		active bool
		plan CsvPlan
		visits uint
		@csv(ignore = true)
		secret string
		tags string[]
	}

	// Yields its bytes a few at a time, as a slow stream does.
	internal type CsvTrickle {
		data byte[]
		pos  int    = 0
		step int

		def new(text string, step int) {
			data = text.bytes()
			self.step = step
		}

		def read(buf byte[]) !int {
			let n = data.len() - pos
			n = step when n > step
			n = buf.len() when n > buf.len()
			for let k = 0; k < n; k++ {
				buf[k] = data[pos + k]
			}
			pos += n
			return n
		}
	}

	internal type CsvSink {
		data   byte[]
		writes int    = 0

		def new() {}

		def write(buf byte[]) !int {
			data += buf
			writes++
			return buf.len()
		}
	}

	check "CSV" {
		@test()
		def TestCSVDecode() !none {
			let rows = try new CSV().decode("﻿name,note,n\r\nAda,\"likes \"\"maths\"\", logic\",1\nBob,\"two\r\nlines\",\n,,\nlast,row")
			assert rows.len() == 5
			assert rows[0].join("|") == "name|note|n"
			assert rows[1][1] == "likes \"maths\", logic" && rows[1][2] == "1"
			assert rows[2][1] == "two\r\nlines" && rows[2].len() == 3 && rows[2][2] == ""
			assert rows[3].len() == 3 && rows[3][0] == ""
			assert rows[4].join("|") == "last|row"
			let semi = try new CSV(";").decode("a;b\r\n")
			assert semi[0].len() == 2 && semi[0][1] == "b"
			assert (try new CSV().decode("x,")).len() == 1 && (try new CSV().decode("x,"))[0].len() == 2
			let failed = false
			new CSV().decode("\"open") onerror (err error) {
				failed = true
				recover string[][]
			}
			assert failed
			failed = false
			new CSV().decode("\"a\"b,c") onerror (err error) {
				failed = true
				recover string[][]
			}
			assert failed
		}

		@test()
		def TestCSVEncode() !none {
			let rows string[][]
			rows.push(["plain", "a,b", "say \"hi\"", "two\nlines", " pad"])
			rows.push(["", "x"])
			let text = new CSV().encode(rows)
			assert text == "plain,\"a,b\",\"say \"\"hi\"\"\",\"two\nlines\",\" pad\"\r\n,x\r\n"
			let back = try new CSV().decode(text)
			assert back.len() == 2 && back[0][2] == "say \"hi\"" && back[0][3] == "two\nlines" && back[1][0] == ""
			assert new CSV(";").encode([["a;b", "c,d"]]) == "\"a;b\";c,d\r\n"
		}

		@test()
		def TestCSVReaderStreams() !none {
			let long = "x".repeat(300)
			let text = "\uFEFFname,note\r\nAda,\"likes \"\"maths\"\", logic\"\r\nBob,\"two\r\nlines\"\n,\n\"{long}\",{long}\nlast,"
			let want = try new CSV().decode(text)
			assert want.len() == 6 && want[4][0] == long && want[4][1] == long && want[5].len() == 2
			// Every split of the stream gives the rows the whole text gives.
			for let (_, step) in [1, 2, 3, 7, 64, 100000] {
				let reader = new CSVReader(new CsvTrickle(text, step))
				let at = 0
				for try reader.more() {
					let row = try reader.next()
					assert row.len() == want[at].len()
					assert row.join("|") == want[at].join("|")
					at++
				}
				assert at == want.len() && reader.row == at
			}
			let failed = false
			new CSVReader(new CsvTrickle("a,\"open", 2)).next() onerror (err error) {
				failed = err.message.contains("not closed in row 1")
				recover string[]
			}
			assert failed
			failed = false
			new CSVReader("a,b".bytes(), "::").more() onerror (err error) {
				failed = true
				recover false
			}
			assert failed
		}

		@test()
		def TestCSVRecords() !none {
			let text = "Name, E-Mail ,age,score,active,plan,visits,secret,unknown\r\n" + "Ada,ada@example.com,36,9.5,yes,1,7,hidden,x\r\n" + "\r\n" + "Bob,\"b,ob@example.com\",,-1e2,0,0,+12,hidden,\r\n"
			let users = try new CSV().decodeRecords<CsvUser>(text)
			assert users.len() == 2
			let age = users[0].age
			fail "the age was not read" when age is none
			assert users[0].name == "Ada" && users[0].email == "ada@example.com" && age == 36
			assert users[0].score == 9.5 && users[0].active && users[0].plan == CsvPlan.Paid && users[0].visits == uint(7)
			assert users[0].secret == ""
			assert users[1].email == "b,ob@example.com" && users[1].age is none && users[1].score == -100.0
			assert !users[1].active && users[1].plan == CsvPlan.Free && users[1].visits == uint(12)

			let out = new CSV().encodeRecords<CsvUser>(users)
			assert out == "name,e-mail,age,score,active,plan,visits\r\n" + "Ada,ada@example.com,36,9.5,true,1,7\r\n" + "Bob,\"b,ob@example.com\",,-100,false,0,12\r\n"
			let back = try new CSV().decodeRecords<CsvUser>(out)
			assert back.len() == 2 && back[1].email == users[1].email && back[1].age is none
			let again = back[0].age
			fail "the age was not read back" when again is none
			assert again == 36

			let message = ""
			new CSV().decodeRecords<CsvUser>("name,age\nAda,old\n") onerror (err error) {
				message = err.message
				recover CsvUser[]
			}
			assert message == "csv: row 2, column `age`: `old` is not an integer"
			message = ""
			new CSV().decodeRecords<CsvUser>("name,visits\nAda,-3\n") onerror (err error) {
				message = err.message
				recover CsvUser[]
			}
			assert message.contains("column `visits`")
			assert (try new CSV().decodeRecords<CsvUser>("")).len() == 0
		}

		@test()
		def TestCSVReaderRecordsAndWriter() !none {
			let reader = new CSVReader(new CsvTrickle("name;age\nAda;36\n\nBob;\n\n", 3), ";")
			assert (try reader.header()).join("|") == "name|age"
			let seen string[] = []
			for try reader.more() {
				let user = new CsvUser()
				continue unless try reader.next(user)
				seen.push(user.name + (user.age is none ?? ("-", "+")))
			}
			assert seen.join(",") == "Ada+,Bob-"

			let sink = new CsvSink()
			let writer = new CSVWriter(sink, ";")
			try writer.write(["a;b", "c"])
			assert string(sink.data) == "\"a;b\";c\r\n" && sink.writes == 1 && writer.row == 1

			sink = new CsvSink()
			writer = new CSVWriter(sink)
			let ada = new CsvUser()
			ada.name = "Ada"
			ada.age = 36
			try writer.writeRecord(ada)
			try writer.writeRecord(new CsvUser())
			assert string(sink.data) == "name,e-mail,age,score,active,plan,visits\r\nAda,,36,0,false,0,0\r\n,,,0,false,0,0\r\n"
			assert writer.row == 3
		}

		@test()
		def TestCSVDetect() {
			let csv = new CSV()
			assert csv.detect("a;b;c\n1,5;2;3\n4;5;6\n") == ";" && csv.separator == ";"
			assert new CSV().detect("a\tb\n1\t2\n") == "\t"
			assert new CSV().detect("name|note\n\"x,y\"|z\n") == "|"
			assert new CSV().detect("a,b\n\"1;2;3\",4\n") == ","
			assert new CSV(";").detect("plain\ntext\n") == ";"
		}
	}
}
