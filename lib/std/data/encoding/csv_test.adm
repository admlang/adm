partial module std.data.encoding {
	use std.testing

	check "CSV" {
		@test()
		def TestCSVDecode() !none {
			let rows = try new CSV().decode("﻿name,note,n\r\nAda,\"likes \"\"maths\"\", logic\",1\nBob,\"two\r\nlines\",\n,,\nlast,row")
			assert rows.len() == 5
			assert rows[0].join("|") == "name|note|n"
			assert rows[1][1] == "likes \"maths\", logic" && rows[1][2] == "1"
			assert rows[2][1] == "two\r\nlines" && rows[2].len() == 3 && rows[2][2] == ""
			assert rows[3].len() == 3 && rows[3][0] == ""
			assert rows[4].join("|") == "last|row"
			let semi = try new CSV(";").decode("a;b\r\n")
			assert semi[0].len() == 2 && semi[0][1] == "b"
			assert (try new CSV().decode("x,")).len() == 1 && (try new CSV().decode("x,"))[0].len() == 2
			let failed = false
			new CSV().decode("\"open") onerror (err error) {
				failed = true
				recover string[][]
			}
			assert failed
			failed = false
			new CSV().decode("\"a\"b,c") onerror (err error) {
				failed = true
				recover string[][]
			}
			assert failed
		}

		@test()
		def TestCSVEncode() !none {
			let rows string[][]
			rows.push(["plain", "a,b", "say \"hi\"", "two\nlines", " pad"])
			rows.push(["", "x"])
			let text = new CSV().encode(rows)
			assert text == "plain,\"a,b\",\"say \"\"hi\"\"\",\"two\nlines\",\" pad\"\r\n,x\r\n"
			let back = try new CSV().decode(text)
			assert back.len() == 2 && back[0][2] == "say \"hi\"" && back[0][3] == "two\nlines" && back[1][0] == ""
			assert new CSV(";").encode([["a;b", "c,d"]]) == "\"a;b\";c,d\r\n"
		}
	}
}
