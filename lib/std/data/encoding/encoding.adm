partial module std.data.encoding {
	use std.io

	interface Serializable {
		def bytes() byte[]
	}

	// implement data encoding schemes
	// base32, base64, binary, hex, json, xml, yaml, toml
	interface ByteEncoder {
		def encode(obj any) byte[]
	}

	interface ByteDecoder {
		def decode(input byte[], target any) !none
	}

	interface StringEncoder {
		def encode(input byte[]) string
	}

	interface StringDecoder {
		def decode(input string) !byte[]
	}

	interface StreamEncoder {
		def encode(writer io.Writer, obj any) !none
	}

	interface StreamDecoder {
		def decode(reader io.Reader, target any) !none
	}

	interface TextEncoder {
		def encode() string
	}

	interface TextDecoder {
		def decode(val string) !none
	}
}
