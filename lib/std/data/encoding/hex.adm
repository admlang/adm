partial module std.data.encoding {
	// hexencode returns the bytes as lower-case hexadecimal, two digits per byte.
	// The prelude's `byte[].hex()` is the upper-case form.
	def hexencode(input byte[]) string {
		const digits = "0123456789abcdef"
		let out byte[]
		for let (_, b) in input {
			out.push(digits.bytes()[int(b) >> 4])
			out.push(digits.bytes()[int(b) & 0x0F])
		}
		return string(out)
	}

	// hexdecode parses hexadecimal text, either case, into bytes.
	// Fails when the text has an odd number of digits or a character that is
	// not a hexadecimal digit.
	def hexdecode(input string) !byte[] {
		expects {
			assert input.bytes().len() % 2 == 0 onerror fail "hex: odd number of digits"
		}
		let src = input.bytes()
		let out byte[]
		out.len(src.len() / 2)
		for let i = 0; i < out.len(); i++ {
			let hi = try hexNibble(src[i * 2])
			let lo = try hexNibble(src[i * 2 + 1])
			out[i] = byte(hi << 4 | lo)
		}
		return out
	}

	internal def hexNibble(c byte) !int {
		let v = int(c)
		return v - 48 when v >= 48 && v <= 57
		return v - 55 when v >= 65 && v <= 70
		return v - 87 when v >= 97 && v <= 102
		fail "hex: invalid character"
	}
}
