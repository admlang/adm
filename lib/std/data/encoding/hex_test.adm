partial module std.data.encoding {
	use std.testing

	check "Hex" {
		@test()
		def TestHexRoundTrip() !none {
			assert hexencode([]) == ""
			assert hexencode(byte[0, 15, 16, 255]) == "000f10ff"
			assert (try hexdecode("000F10ff")).hex() == "000F10FF"
			assert (try hexdecode("")).len() == 0
			assert hexencode(try hexdecode("deadBEEF")) == "deadbeef"
		}

		@test()
		def long_text_takes_the_vector_path() !none {
			let src byte[]
			for let i = 0; i < 100; i++ {
				src.push(byte((i * 131 + 7) % 256))
			}
			let text = hexencode(src)
			assert text.startsWith("078a0d901396199c") && text.len() == 200
			assert (try hexdecode(text.upper())).hex() == text.upper()
			let bad = hexdecode(text[:90] + "x" + text[91:]) onerror recover byte[3]
			assert bad.hex() == "03"
		}

		@test()
		def TestHexErrors() {
			let odd = hexdecode("abc") onerror recover byte[1]
			assert odd.hex() == "01"
			let bad = hexdecode("zz") onerror recover byte[2]
			assert bad.hex() == "02"
		}
	}
}
