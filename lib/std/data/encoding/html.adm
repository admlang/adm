partial module std.data.encoding {
	// Returns `text` with HTML-sensitive characters escaped.
	//
	// Ampersands, angle brackets, quotes, and apostrophes are encoded.
	def htmlEncode(text string) string {
		let result = ""
		for let (_, ch) in text {
			if ch == '&' {
				result += "&amp;"
			} else if ch == '<' {
				result += "&lt;"
			} else if ch == '>' {
				result += "&gt;"
			} else if ch == '"' {
				result += "&quot;"
			} else if ch == '\'' {
				result += "&#39;"
			} else {
				result += string(ch)
			}
		}
		return result
	}

	// Decodes one supported HTML character reference.
	internal def decodeHTMLEntity(entity string) ?string {
		return "&" when entity == "amp"
		return "<" when entity == "lt"
		return ">" when entity == "gt"
		return "\"" when entity == "quot"
		return "'" when entity == "apos" || entity == "#39"

		return none unless entity.startsWith("#")

		let base = 10
		let digits = entity[1:]
		if digits.startsWith("x") || digits.startsWith("X") {
			base = 16
			digits = digits[1:]
		}
		return none when digits == ""

		for let (_, digit) in digits {
			let decimal = digit >= '0' && digit <= '9'
			let lowerHex = digit >= 'a' && digit <= 'f'
			let upperHex = digit >= 'A' && digit <= 'F'
			return none unless decimal || (base == 16 && (lowerHex || upperHex))
		}

		let code = digits.toInt<int>(base)
		return none when code <= 0 || code > 0x10FFFF
		return none when code >= 0xD800 && code <= 0xDFFF
		return string(char(code))
	}

	// Returns `text` with supported HTML character references decoded.
	//
	// The five named references and decimal or hexadecimal numeric references
	// are supported. Unknown and malformed references are preserved.
	def htmlDecode(text string) string {
		let result = ""
		let i = 0

		for i < text.len() {
			if text[i] != '&' {
				result += string(text[i])
				i++
				continue
			}

			let end = -1
			for let j = i + 1; j < text.len(); j++ {
				if text[j] == ';' {
					end = j
					break
				}
			}

			if end == -1 {
				result += "&"
				i++
				continue
			}

			let decoded = decodeHTMLEntity(text[i + 1:end])
			if decoded is none {
				result += text[i:end + 1]
			} else {
				result += decoded
			}
			i = end + 1
		}
		return result
	}
}
