partial module std.data.encoding {
	use (
		std.data.encoding.entities::*
		std.data.encoding.codepages
	)

	// Returns `text` with HTML-sensitive characters escaped.
	//
	// Ampersands, angle brackets, quotes, and apostrophes are encoded.
	def htmlEncode(text string) string {
		let src = text.bytes()
		let out byte[] = []
		let start = 0
		for let i = 0; i < src.len(); i++ {
			let c = int(src[i])
			let entity = ""
			if c == 0x26 {
				entity = "&amp;"
			} else if c == 0x3C {
				entity = "&lt;"
			} else if c == 0x3E {
				entity = "&gt;"
			} else if c == 0x22 {
				entity = "&quot;"
			} else if c == 0x27 {
				entity = "&#39;"
			}
			continue when entity == ""
			out.push(...src[start:i])
			out.push(...entity.bytes())
			start = i + 1
		}
		return text when start == 0
		out.push(...src[start:])
		return string(out)
	}

	// Decodes the character reference between `&` and `;`: a named reference
	// of HTML or a decimal or hexadecimal numeric one. None when it is neither.
	internal def decodeHTMLEntity(entity string) ?string {
		return "&" when entity == "amp"
		return "<" when entity == "lt"
		return ">" when entity == "gt"
		return "\"" when entity == "quot"
		return "'" when entity := "apos" || "#39"

		return named(entity) unless entity.startsWith("#")

		let base = 10
		let digits = entity[1:]
		if digits.startsWith("x") || digits.startsWith("X") {
			base = 16
			digits = digits[1:]
		}
		return none when digits == ""

		for let (_, digit) in digits {
			let decimal = digit >= '0' && digit <= '9'
			let lowerHex = digit >= 'a' && digit <= 'f'
			let upperHex = digit >= 'A' && digit <= 'F'
			return none unless decimal || (base == 16 && (lowerHex || upperHex))
		}

		let code = digits.toInt<int>(base)
		return none when code <= 0 || code > 0x10FFFF
		return none when code >= 0xD800 && code <= 0xDFFF
		return string(char(code))
	}

	// Returns `text` with its HTML character references decoded, the way a
	// browser reads them.
	//
	// Every named reference of HTML is decoded (`&copy;`, `&nbsp;`), and the
	// legacy ones that may drop the semicolon are decoded without it too
	// (`&copy 2026`). Decimal and hexadecimal numeric references are decoded,
	// the semicolon optional; 0x80 to 0x9f stand for the Windows-1252
	// characters there, and a reference to nothing a string can hold decodes
	// as U+FFFD. With `attribute`, text is read as an attribute value is: a
	// legacy reference without its semicolon followed by a letter, a digit or
	// `=` stays as written (`?a=1&copy=2`). Unknown references are preserved.
	def htmlDecode(text string, attribute bool = false) string {
		let raw = text.bytes()
		let amp = raw.indexOf(byte('&'))
		return text when amp < 0

		let out byte[] = []
		out.push(...raw[:amp])
		let i = amp
		let n = raw.len()
		for i < n {
			if int(raw[i]) != 0x26 {
				let next = raw[i:].indexOf(byte('&'))
				let end = next < 0 ?? (n, i + next)
				out.push(...raw[i:end])
				i = end
				continue
			}
			let (decoded, used) = htmlReference(raw, i, attribute)
			if used == 0 {
				out.push(raw[i])
				i++
				continue
			}
			out.push(...decoded.bytes())
			i += used
		}
		return string(out)
	}

	// htmlReference decodes the reference at the `&` at `at`, returning its
	// characters and how many bytes it took, 0 when there is none there.
	internal def htmlReference(raw byte[], at int, attribute bool) (string, int) {
		let n = raw.len()
		let i = at + 1
		return ("", 0) when i >= n
		if int(raw[i]) == 0x23 {
			i++
			let hex = i < n && (int(raw[i]) == 0x78 || int(raw[i]) == 0x58)
			i++ when hex
			let start = i
			let code = 0
			for i < n {
				let d = int(raw[i])
				let digit = -1
				if d >= 0x30 && d <= 0x39 {
					digit = d - 0x30
				} else if hex && d >= 0x61 && d <= 0x66 {
					digit = d - 0x61 + 10
				} else if hex && d >= 0x41 && d <= 0x46 {
					digit = d - 0x41 + 10
				}
				break when digit < 0
				code = code * (hex ?? (16, 10)) + digit when code <= 0x10FFFF
				i++
			}
			return ("", 0) when i == start
			i++ when i < n && int(raw[i]) == 0x3B
			if code == 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) {
				code = 0xFFFD
			} else if code >= 0x80 && code <= 0x9F {
				// Numeric references in this range stand for Windows-1252.
				code = int(codepages.decode(byte(code), codepages.CodePage.Windows1252))
			}
			return (string(char(code)), i - at)
		}

		let start = i
		for i < n && i - start < 32 {
			let d = int(raw[i])
			break unless (d >= 0x61 && d <= 0x7A) || (d >= 0x41 && d <= 0x5A) || (d >= 0x30 && d <= 0x39)
			i++
		}
		return ("", 0) when i == start
		if i < n && int(raw[i]) == 0x3B {
			let found = decodeHTMLEntity(string(raw[start:i]))
			return (found, i + 1 - at) unless found is none
		}
		for let end = i; end > start; end-- {
			let prefix = string(raw[start:end])
			continue unless isLegacy(prefix)
			if attribute && end < n {
				let d = int(raw[end])
				return ("", 0) when (d >= 0x61 && d <= 0x7A) || (d >= 0x41 && d <= 0x5A) || (d >= 0x30 && d <= 0x39) || d == 0x3D
			}
			let found = decodeHTMLEntity(prefix)
			return (found, end - at) unless found is none
		}
		return ("", 0)
	}
}
