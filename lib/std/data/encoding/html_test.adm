partial module std.data.encoding {
	use std.testing

	check "HTML encoding" {
		@test()
		def encode() {
			assert htmlEncode("") == ""
			assert htmlEncode("plain text") == "plain text"
			assert htmlEncode("<div class=\"x\">Tom & Jerry's</div>") == "&lt;div class=&quot;x&quot;&gt;Tom &amp; Jerry&#39;s&lt;/div&gt;"
			assert htmlEncode("&amp;") == "&amp;amp;"
			assert htmlEncode("déjà 😀") == "déjà 😀"
		}

		@test()
		def decode() {
			assert htmlDecode("") == ""
			assert htmlDecode("plain text") == "plain text"
			assert htmlDecode("&lt;div class=&quot;x&quot;&gt;Tom &amp; Jerry&#39;s&lt;/div&gt;") == "<div class=\"x\">Tom & Jerry's</div>"
			assert htmlDecode("&lt;&gt;&amp;&quot;&apos;&#39;") == "<>&\"''"
			assert htmlDecode("&#65; &#x41; &#X1F600;") == "A A 😀"
			assert htmlDecode("&copy; &amp &#xZZ; &#; &#x110000;") == "&copy; &amp &#xZZ; &#; &#x110000;"
		}
	}
}
