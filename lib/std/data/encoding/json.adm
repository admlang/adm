partial module std.data.encoding {
	use (
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.io
		std.data.encoding.json::*
	)

	// JSONEncoder is a value that produces its own JSON, which the JSON codec
	// uses instead of reflecting over its fields.
	interface JSONEncoder {
		def json() byte[]
	}

	// JSONDecoder is a value that reads itself from JSON, which the JSON codec
	// uses instead of filling its fields.
	interface JSONDecoder {
		def json(data byte[]) !none
	}

	// Naming convention applied to field names when encoding.
	//
	// Decoding is unaffected: keys are matched case-insensitively.
	enum CaseStyle {
		// The declared field name, unchanged.
		AsIs,
		Camel,
		Snake,
		Kebab,
		Pascal,
		Lower,
		Upper
	}

	// Encodes and decodes JSON objects of scalars, arrays, string-keyed maps
	// and nested objects.
	//
	//     let j = new JSON()
	//     let text = string(j.encode(user))
	//     try j.decode(text, user)
	//
	// Per-field behaviour comes from `@json` annotations:
	//
	//     @json("user_id")        encode under this key instead of the field name
	//     @json(omitempty: true)  leave the field out when it holds its zero value
	//     @json(ignore: true)     never encode or decode the field
	//     @json(asString: true)   quote the value, keeping large integers exact
	//     @json(nullable: true)   encode as null rather than being omitted
	//
	// A type implementing JSONEncoder or JSONDecoder is used instead of
	// reflection.
	type JSON {
		indent       bool   = false
		indentString string = "\t"

		// Key naming for fields with no explicit `@json("name")`.
		caseStyle CaseStyle = CaseStyle.AsIs

		// How many objects deep to encode before writing null instead of
		// descending further. Values that refer back to themselves have no
		// depth at which they stop, and encode returns bytes rather than an
		// error, so this is what stands between a cycle and an exhausted
		// stack. Raise it for data that is legitimately deeper.
		maxDepth int = 64

		// encode renders obj as JSON bytes, following the @json field annotations and
		// the codec's case style; a JSONEncoder value renders itself. With
		// `indent`, objects and arrays are laid out one member per line,
		// nested by `indentString`.
		def encode(obj any) byte[] {
			let text = encodeValue(obj, 0)
			text = indentJSON(text, indentString) when indent
			return text.bytes()
		}

		// encode writes obj as JSON to the writer. Fails when the writer does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// Reports whether the text is one complete JSON document (RFC 8259):
		// a single value — object, array, string, number, `true`, `false` or
		// `null` — with nothing but whitespace around it. Nothing is built.
		def isValid(input string) bool {
			let cur = new JSONCursor(input)
			cur.skipSpace()
			let ok = cur.validateValue(0) onerror recover false
			return false unless ok
			cur.skipSpace()
			return cur.done()
		}

		// parse reads a JSON document into plain values: an object as a
		// `map<string, any>` with its keys in document order (a repeated key
		// keeps its last value), an array as `any[]`, a string, a number as
		// `int` when it has no fraction or exponent and fits, else `float`,
		// `true`/`false` as `bool`, and null as `none`.
		//
		// ```
		// let doc = try new JSON().parse("\{\"sub\": \"alice\", \"aud\": [\"a\", \"b\"]\}")
		// ```
		//
		// Fails when the text is not one valid JSON document (RFC 8259) or
		// nests deeper than maxDepth.
		def parse(input byte[]) !any {
			let cur = new JSONCursor(input)
			let value = try cur.parseValue(0, maxDepth)
			cur.skipSpace()
			fail "json: trailing data at offset {cur.pos}" when !cur.done()
			return value
		}

		// parse reads a JSON document from text into plain values, the same
		// way as from bytes. Fails when the text is not one valid JSON
		// document or nests deeper than maxDepth.
		def parse(input string) !any {
			return try parse(input.bytes())
		}

		// Binds a document onto target, setting the fields it names.
		//
		// Keys match the encoded name exactly first, then case-insensitively
		// against the encoded and declared names. Unknown keys are ignored, and
		// null leaves a field at its zero value. A `map<string, any>` target
		// is replaced by the document's object and an `any[]` target by its
		// array, holding the values `parse` builds.
		// Fails when the text is not valid JSON, a value does not fit its field, or nesting exceeds maxDepth.
		def decode(input byte[], target any) !none {
			match target {
				case JSONDecoder:
					return try target.json(input)
				case map<string, any>:
					let doc = try parse(input)
					match doc {
						case none:
							return none
						case map<string, any>:
							for let key in target.keys() {
								target.delete(key)
							}
							for let key in doc.keys() {
								target.set(key, doc[key])
							}
							return none
						default:
							fail "json: expected an object"
					}
				case any[]:
					let doc = try parse(input)
					match doc {
						case none:
							return none
						case any[]:
							target.len(0)
							for let e in doc {
								target.push(e)
							}
							return none
						default:
							fail "json: expected an array"
					}
				default:
			}

			let cur = new JSONCursor(input)
			cur.skipSpace()
			try bindValue(cur, target, 0)
			cur.skipSpace()
			fail "json: trailing data at offset {cur.pos}" when !cur.done()
			return none
		}

		// decode fills target from JSON text, the same way as from bytes. Fails when
		// the text is not valid JSON, a value does not fit its field, or nesting
		// exceeds maxDepth.
		def decode(input string, target any) !none {
			return try decode(input.bytes(), target)
		}

		// decode reads everything the reader yields and fills target from it as JSON.
		// Fails when the reader does or the text does not decode.
		def decode(reader io.Reader, target any) !none {
			let chunk byte[]
			chunk.len(4096)
			let all byte[]
			for {
				let n = try reader.read(chunk)
				if n <= 0 {
					break
				}
				all += chunk.slice(0, n)
			}
			return try decode(all, target)
		}

		// Binds one value onto target, which must be an object.
		internal def bindValue(cur JSONCursor, target any, depth int) !none {
			fail "json: input nests deeper than {maxDepth} objects" when depth >= maxDepth
			cur.skipSpace()
			if cur.peek() == 'n' {
				try cur.literal("null")
				return none
			}
			fail "json: expected an object at offset {cur.pos}" when cur.peek() != '{'
			cur.bump()

			cur.skipSpace()
			if cur.peek() == '}' {
				cur.bump()
				return none
			}

			for {
				cur.skipSpace()
				let key = try cur.parseString()
				cur.skipSpace()
				fail "json: expected ':' after key {key}" when cur.peek() != ':'
				cur.bump()
				cur.skipSpace()

				let f = fieldForKey(target, key, jsonAttr, caseStyle)
				if f is none {
					// Unknown key: consume its value and carry on.
					try cur.skipValue()
				} else {
					try bindField(cur, f, depth)
				}

				cur.skipSpace()
				if cur.peek() == ',' {
					cur.bump()
					continue
				}
				fail "json: expected ',' or '}' at offset {cur.pos}" when cur.peek() != '\u007D'
				cur.bump()
				break
			}
			return none
		}

		// Reads one value and stores it in the given field.
		internal def bindField(cur JSONCursor, f Field, depth int) !none {
			if cur.peek() == 'n' {
				try cur.literal("null")
				return none
			}

			let kind = f.kind
			if kind == FieldKind.Array {
				return try bindArray(cur, f, depth)
			}
			if kind == FieldKind.Map {
				return try bindMap(cur, f, depth)
			}
			if kind == FieldKind.Struct {
				let nested = f.ensureValue()
				fail "json: cannot read an object into `{f.name}`" when nested is none
				return try bindValue(cur, nested, depth + 1)
			}
			try bindScalar(cur, f, kind)
			return none
		}

		// Reads an object into a `map<string, V>` field, replacing what the
		// map held. V is a scalar or an object; a null entry is left out.
		internal def bindMap(cur JSONCursor, f Field, depth int) !none {
			fail "json: cannot read an object into `{f.name}`: map keys must be strings and values scalars or objects" when f.elemKind == FieldKind.Other || f.elemKind == FieldKind.Array || f.elemKind == FieldKind.Map
			fail "json: expected an object at offset {cur.pos}" when cur.peek() != '{'
			cur.bump()
			f.clear()

			cur.skipSpace()
			if cur.peek() == '}' {
				cur.bump()
				return none
			}

			let kind = f.elemKind
			for {
				cur.skipSpace()
				let key = try cur.parseString()
				cur.skipSpace()
				fail "json: expected ':' after key {key}" when cur.peek() != ':'
				cur.bump()
				cur.skipSpace()

				let entry = f.entry(key)
				if cur.peek() == 'n' {
					try cur.literal("null")
				} else if kind == FieldKind.Struct {
					let nested = entry.ensureValue()
					fail "json: cannot read an object into `{f.name}[{key}]`" when nested is none
					try bindValue(cur, nested, depth + 1)
				} else {
					try bindScalar(cur, entry, kind)
				}

				cur.skipSpace()
				if cur.peek() == ',' {
					cur.bump()
					continue
				}
				fail "json: expected ',' or '}' at offset {cur.pos}" when cur.peek() != '\u007D'
				cur.bump()
				break
			}
			return none
		}

		// Reads one scalar into a field of its kind. A number or bool arrives
		// bare, or quoted when the field has asString; a value of another
		// JSON type, a fraction or an out-of-range value for an integer
		// field fails.
		internal def bindScalar(cur JSONCursor, f Field, kind FieldKind) !none {
			let at = cur.pos
			if kind == FieldKind.String {
				f.setString(cur.parseString() onerror fail "json: expected a string for `{f.name}` at offset {at}")
				return none
			}
			let quoted = cur.peek() == '"'
			fail "json: expected {kindName(kind)} for `{f.name}` at offset {at}, found a string" when quoted && !flag(f, "asString")
			if kind == FieldKind.Bool {
				let text = quoted ?? (try cur.parseString(), cur.bareWord() onerror fail "json: expected a bool for `{f.name}` at offset {at}")
				fail "json: expected a bool for `{f.name}` at offset {at}" unless text == "true" || text == "false"
				f.setBool(text == "true")
				return none
			}
			fail "json: cannot decode into `{f.name}`" unless kind := FieldKind.Int || FieldKind.Uint || FieldKind.Float
			let text = quoted ?? (try cur.parseString(), try cur.parseNumberText())
			fail "json: expected {kindName(kind)} for `{f.name}` at offset {at}" unless isJsonNumber(text)
			if kind == FieldKind.Float {
				f.setFloat(parseFloat<float>(text))
				return none
			}
			fail "json: `{f.name}` needs an integer, found {text}" unless isJsonInteger(text)
			if kind == FieldKind.Uint {
				fail "json: {text} does not fit `{f.name}`" unless !text.startsWith("-") && integerFits(text, "18446744073709551615")
				f.setUint(parseInt<uint>(text))
				return none
			}
			let fits = text.startsWith("-") ?? (integerFits(text[1:], "9223372036854775808"), integerFits(text, "9223372036854775807"))
			fail "json: {text} does not fit `{f.name}`" unless fits
			f.setInt(parseInt<int>(text))
			return none
		}

		internal def bindArray(cur JSONCursor, f Field, depth int) !none {
			fail "json: expected an array at offset {cur.pos}" when cur.peek() != '['
			cur.bump()
			cur.skipSpace()

			// Two passes: count, size the array, then fill. Growing per element
			// would reallocate on every value.
			let start = cur.pos
			let count = 0
			if cur.peek() != ']' {
				for {
					try cur.skipValue()
					count++
					cur.skipSpace()
					if cur.peek() == ',' {
						cur.bump()
						cur.skipSpace()
						continue
					}
					break
				}
			}
			fail "json: expected ']' at offset {cur.pos}" when cur.peek() != ']'
			cur.bump()

			f.setLen(count)
			let kind = f.elemKind
			let after = cur.pos
			cur.pos = start
			cur.skipSpace()
			for let i = 0; i < count; i++ {
				let element = f.at(i)
				if cur.peek() == 'n' {
					try cur.literal("null")
				} else if kind == FieldKind.Struct {
					let nested = element.ensureValue()
					fail "json: cannot read an object into `{f.name}[{i}]`" when nested is none
					try bindValue(cur, nested, depth + 1)
				} else {
					try bindScalar(cur, element, kind)
				}
				cur.skipSpace()
				if cur.peek() == ',' {
					cur.bump()
					cur.skipSpace()
				}
			}
			cur.pos = after
			return none
		}

		// Returns the JSON key for a field.
		internal def keyFor(f Field) string {
			return encodedKey(f, jsonAttr, caseStyle)
		}

		// Reads a boolean option from a field's `@json` annotation.
		internal def flag(f Field, key string) bool {
			return fieldFlag(f, jsonAttr, key)
		}

		// Renders one field's value. asString wraps numbers and bools in quotes.
		internal def encodeField(f Field, depth int) string {
			let kind = f.kind

			if kind == FieldKind.Array {
				return encodeArray(f, depth)
			}
			if kind == FieldKind.Map {
				return encodeMap(f, depth)
			}
			if kind == FieldKind.Struct || kind == FieldKind.Iface {
				let nested = f.value()
				if nested is none {
					return "null"
				}
				return encodeValue(nested, depth + 1)
			}
			if kind == FieldKind.String {
				return quote(f.asString())
			}

			let raw = scalarText(f, kind)
			if raw == "" {
				return "null"
			}
			return flag(f, "asString") ?? (quote(raw), raw)
		}

		// Renders an array field: scalar elements by kind, and elements that
		// are objects, arrays, maps or `any` through their boxed value.
		internal def encodeArray(f Field, depth int) string {
			let kind = f.elemKind
			let out = "["
			let n = f.len()
			for let i = 0; i < n; i++ {
				if i > 0 {
					out += ","
				}
				let e = f.at(i)
				if kind == FieldKind.String {
					out += quote(e.asString())
				} else if kind == FieldKind.Bool || kind == FieldKind.Int || kind == FieldKind.Uint || kind == FieldKind.Float {
					let raw = scalarText(e, kind)
					out += raw == "" ?? ("null", raw)
				} else {
					let nested = e.value()
					out += nested is none ?? ("null", encodeValue(nested, depth + 1))
				}
			}
			out += "]"
			return out
		}

		// Renders a `map<string, V>` field as an object, entries in insertion
		// order: scalar values by kind, the rest through their boxed value.
		internal def encodeMap(f Field, depth int) string {
			let kind = f.elemKind
			let out = "\u007B"
			let first = true
			for let key in f.keys() {
				if !first {
					out += ","
				}
				first = false
				out += quote(key)
				out += ":"
				let e = f.entry(key)
				if kind == FieldKind.String {
					out += quote(e.asString())
				} else if kind == FieldKind.Bool || kind == FieldKind.Int || kind == FieldKind.Uint || kind == FieldKind.Float {
					let raw = scalarText(e, kind)
					out += raw == "" ?? ("null", raw)
				} else {
					let nested = e.value()
					out += nested is none ?? ("null", encodeValue(nested, depth + 1))
				}
			}
			out += "\u007D"
			return out
		}

		// Renders any value: a `JSONEncoder` through its own `json`, an
		// object through its fields, and a bare scalar, string, array or map
		// (what `encode` receives for `codec.encode(list)` or a
		// `map<string, any>` entry) through the runtime's view of the box.
		internal def encodeValue(obj any, depth int) string {
			match obj {
				case JSONEncoder:
					return string(obj.json())
				default:
			}

			if depth >= maxDepth {
				return "null"
			}

			let kind = reflection.kindOf(obj)
			if kind == FieldKind.String {
				return quote(reflection.scalarText(obj))
			}
			if kind == FieldKind.Bool || kind == FieldKind.Int || kind == FieldKind.Uint || kind == FieldKind.Float {
				let raw = reflection.scalarText(obj)
				return raw == "" ?? ("null", raw)
			}
			if kind == FieldKind.Array {
				let out = "["
				let first = true
				for let e in reflection.elements(obj) {
					if !first {
						out += ","
					}
					first = false
					out += e is none ?? ("null", encodeValue(e, depth + 1))
				}
				out += "]"
				return out
			}
			if kind == FieldKind.Map {
				let out = "\u007B"
				let first = true
				for let key in reflection.keysOf(obj) {
					if !first {
						out += ","
					}
					first = false
					out += quote(key)
					out += ":"
					let e = reflection.entryOf(obj, key)
					out += e is none ?? ("null", encodeValue(e, depth + 1))
				}
				out += "\u007D"
				return out
			}

			let all = reflection.fields(obj)
			if all.len() == 0 {
				return "null"
			}

			let out = "\u007B"
			let first = true
			for let (_, f) in all {
				if flag(f, "ignore") {
					continue
				}
				if flag(f, "omitempty") && fieldIsEmpty(f) {
					continue
				}
				if !first {
					out += ","
				}
				first = false
				out += quote(keyFor(f))
				out += ":"
				out += encodeField(f, depth)
			}
			out += "\u007D"
			return out
		}
	}

	// Annotation handling shared by the reflection-driven codecs. Each helper
	// takes the qualified meta function name, so JSON and YAML resolve options
	// the same way.

	// Controls how a field is encoded to and decoded from JSON.
	//
	//     name       key to use instead of the field name
	//     omitempty  leave the field out when it holds its zero value
	//     ignore     never encode or decode the field
	//     asString   quote the value, keeping large integers exact
	//     nullable   encode as null rather than being omitted
	//
	//     struct User {
	//         @json("user_id")
	//         id int
	//         @json(omitempty: true)
	//         nickname string
	//     }
	meta def json(ctx FieldMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "json", name, omitempty, ignore, asString, nullable)
	}

	// Controls how a property is encoded to and decoded from JSON. Takes the
	// same options as the field form above.
	meta def json(ctx PropertyMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "json", name, omitempty, ignore, asString, nullable)
	}
}

internal partial module std.data.encoding.json {
	use (
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.io
		std.data.encoding::*
	)

	// Qualified name of the `@json` meta function, used to look up field options.
	const jsonAttr = "std.data.encoding.json"

	// indentJSON lays compact JSON out one member per line, nested by unit,
	// leaving string contents untouched. Empty objects and arrays stay on
	// one line.
	def indentJSON(text string, unit string) string {
		let out = ""
		let depth = 0
		let inString = false
		let escaped = false
		for let i = 0; i < text.len(); i++ {
			let ch = text[i]
			if inString {
				out += string(ch)
				if escaped {
					escaped = false
				} else if ch == '\\' {
					escaped = true
				} else if ch == '"' {
					inString = false
				}
				continue
			}
			match ch {
				case '"':
					inString = true
					out += "\""
				case '{', '[':
					let closer = ch == '{' ?? ('}', ']')
					if i + 1 < text.len() && text[i + 1] == closer {
						out += string(ch) + string(closer)
						i++
						continue
					}
					depth++
					out += string(ch) + "\n" + unit.repeat(depth)
				case '}', ']':
					depth--
					out += "\n" + unit.repeat(depth) + string(ch)
				case ',':
					out += ",\n" + unit.repeat(depth)
				case ':':
					out += ": "
				default:
					out += string(ch)
			}
		}
		return out
	}

	// Applies a naming convention to a field name.
	def applyCaseStyle(name string, casing CaseStyle) string {
		match casing {
			case CaseStyle.Camel:
				return name.camelCase()
			case CaseStyle.Snake:
				return name.snakeCase()
			case CaseStyle.Kebab:
				return name.kebabCase()
			case CaseStyle.Pascal:
				return name.camelCase().capitalize()
			case CaseStyle.Lower:
				return name.lower()
			case CaseStyle.Upper:
				return name.upper()
			default:
				return name
		}
	}

	// Returns the encoded key for a field: an explicit name if annotated,
	// otherwise the declared name with casing applied.
	def encodedKey(f Field, annotation string, casing CaseStyle) string {
		let explicit = f.attr(annotation, "name")
		if explicit != "" {
			return explicit
		}
		return applyCaseStyle(f.name, casing)
	}

	// Reads a boolean option from a field annotation.
	def fieldFlag(f Field, annotation string, key string) bool {
		return f.attr(annotation, key) == "true"
	}

	// Reports whether a field holds its zero value: empty string, zero, false,
	// or an empty array or map.
	def fieldIsEmpty(f Field) bool {
		match f.kind {
			case FieldKind.String:
				return f.asString() == ""
			case FieldKind.Bool:
				return !f.asBool()
			case FieldKind.Int:
				return f.asInt() == 0
			case FieldKind.Uint:
				return f.asUint() == 0
			case FieldKind.Float:
				return f.asFloat() == 0.0
			case FieldKind.Enum:
				// The first member, whatever its declared value.
				return f.asInt() == 0
			case FieldKind.Array, FieldKind.Map:
				return f.len() == 0
			case FieldKind.Struct:
				// A nested object has no zero value to recognise: its own
				// fields decide what it encodes to, and omitempty on each of
				// them is how to leave parts of it out.
				return false
			default:
				return false
		}
	}

	// Returns the field matching key, or none.
	//
	// Tries the encoded name exactly, then the encoded and declared names
	// case-insensitively.
	def fieldForKey(value any, key string, annotation string, casing CaseStyle) ?Field {
		let all = reflection.fields(value)

		for let (_, f) in all {
			if fieldFlag(f, annotation, "ignore") {
				continue
			}
			if encodedKey(f, annotation, casing) == key {
				return f
			}
		}

		let lowered = key.lower()
		for let (_, f) in all {
			if fieldFlag(f, annotation, "ignore") {
				continue
			}
			if encodedKey(f, annotation, casing).lower() == lowered {
				return f
			}
			if f.name.lower() == lowered {
				return f
			}
		}
		return none
	}

	// Returns a scalar's value as unquoted, unescaped text. Works on a field or
	// on one element of an array field.
	def scalarText(f Field, kind FieldKind) string {
		match kind {
			case FieldKind.String:
				return f.asString()
			case FieldKind.Bool:
				return f.asBool() ?? ("true", "false")
			case FieldKind.Int:
				return f.asInt().str()
			case FieldKind.Uint:
				return f.asUint().str()
			case FieldKind.Float:
				return f.asFloat().str()
			default:
				return ""
		}
	}

	// Stores unquoted text, converted to the given kind.
	def setScalarText(f Field, kind FieldKind, text string) {
		match kind {
			case FieldKind.String:
				f.setString(text)
			case FieldKind.Bool:
				f.setBool(isTruthyScalar(text))
			case FieldKind.Int:
				f.setInt(parseInt<int>(text))
			case FieldKind.Uint:
				f.setUint(uint(parseInt<int>(text)))
			case FieldKind.Float:
				f.setFloat(parseFloat<float>(text))
			default:
		}
	}

	// kindName names a scalar kind in decode errors.
	def kindName(kind FieldKind) string {
		match kind {
			case FieldKind.Bool:
				return "a bool"
			case FieldKind.Int, FieldKind.Uint:
				return "an integer"
			default:
				return "a number"
		}
	}

	// isJsonNumber reports whether text is a number of the RFC 8259 grammar:
	// -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
	def isJsonNumber(text string) bool {
		let b = text.bytes()
		let i = 0
		i++ when i < b.len() && b[i] == byte(45)
		return false when i >= b.len()
		if b[i] == byte(48) {
			i++
		} else {
			return false unless b[i] >= byte(49) && b[i] <= byte(57)
			for i < b.len() && b[i] >= byte(48) && b[i] <= byte(57) {
				i++
			}
		}
		if i < b.len() && b[i] == byte(46) {
			i++
			let start = i
			for i < b.len() && b[i] >= byte(48) && b[i] <= byte(57) {
				i++
			}
			return false when i == start
		}
		if i < b.len() && (b[i] == byte(101) || b[i] == byte(69)) {
			i++
			i++ when i < b.len() && (b[i] == byte(43) || b[i] == byte(45))
			let start = i
			for i < b.len() && b[i] >= byte(48) && b[i] <= byte(57) {
				i++
			}
			return false when i == start
		}
		return i == b.len()
	}

	// isJsonInteger reports whether a JSON number has no fraction or
	// exponent.
	def isJsonInteger(text string) bool {
		return !text.contains(".") && !text.contains("e") && !text.contains("E")
	}

	// integerFits reports whether unsigned decimal digits are at most limit.
	def integerFits(digits string, limit string) bool {
		return digits.len() < limit.len() || (digits.len() == limit.len() && digits <= limit)
	}

	// Reports whether text spells true. Accepts the YAML 1.1 spellings.
	def isTruthyScalar(text string) bool {
		match text.lower() {
			case "true", "yes", "on", "y", "1":
				return true
			default:
				return false
		}
	}

	// Records a codec's field options into the metadata store. Options left at
	// their defaults are removed rather than stored, so absent reads as default.
	def recordCodecOptions(store MetadataStore, format string, name string, omitempty bool, ignore bool, asString bool, nullable bool) {
		let prefix = "encoder." + format + "."

		if name == "" {
			store.delete(prefix + "name")
		} else {
			store.save(prefix + "name", name)
		}

		recordFlag(store, prefix + "omitempty", omitempty)
		recordFlag(store, prefix + "ignore", ignore)
		recordFlag(store, prefix + "asstring", asString)
		recordFlag(store, prefix + "nullable", nullable)
	}

	def recordFlag(store MetadataStore, key string, on bool) {
		if on {
			store.save(key, "1")
		} else {
			store.delete(key)
		}
	}

	// Reports whether ch may appear in a JSON number, exponents included.
	def isNumberChar(ch char) bool {
		return (ch >= '0' && ch <= '9') || ch == '.' || ch == 'e' || ch == 'E' || ch == '+' || ch == '-'
	}

	// A position in a JSON document, read as UTF-8 bytes; `pos` is a byte
	// offset.
	//
	// It holds the parse state for one document, so two concurrent decodes
	// cannot tread on each other.
	type JSONCursor {
		src byte[]
		pos int    = 0

		def new(text string) {
			self.src = text.bytes()
			self.pos = 0
		}

		def new(data byte[]) {
			self.src = data
			self.pos = 0
		}

		def done() bool {
			return pos >= src.len()
		}

		// Returns the byte at the cursor as a char, or NUL at end of input.
		// Bytes of a multi-byte UTF-8 sequence come back as U+0080..U+00FF,
		// which match no JSON punctuation.
		def peek() char {
			if done() {
				return char(0)
			}
			return char(src[pos])
		}

		def bump() {
			pos = pos + 1
		}

		def skipSpace() {
			for !done() {
				match peek() {
					case ' ', '\t', '\n', '\r':
						bump()
					default:
						return
				}
			}
		}

		// Reads a bare word of letters (true, false, null, or a mistake) for
		// the caller to check. Fails when there is none.
		def bareWord() !string {
			let start = pos
			for pos < src.len() && ((src[pos] >= byte(97) && src[pos] <= byte(122)) || (src[pos] >= byte(65) && src[pos] <= byte(90))) {
				pos++
			}
			fail "json: expected a value at offset {start}" when pos == start
			return string(src[start:pos])
		}

		// Consumes an expected bare word such as true, false or null.
		def literal(word string) !none {
			for let (i, ch) in word {
				fail "json: expected {word} at offset {pos}" when pos + i >= src.len() || src[pos + i] != byte(ch)
			}
			pos = pos + word.len()
			return none
		}

		// Reads a quoted string, resolving escapes including \uXXXX and
		// UTF-16 surrogate pairs; an unpaired surrogate becomes U+FFFD. Fails
		// on an unterminated string, an unknown or truncated escape, or a
		// control character that is not escaped.
		def parseString() !string {
			fail "json: expected a string at offset {pos}" when peek() != '"'
			bump()
			let start = pos
			// The common case, no escapes: one slice of the input.
			for pos < src.len() && src[pos] != byte(34) && src[pos] != byte(92) && src[pos] >= byte(32) {
				pos++
			}
			fail "json: unterminated string at offset {start}" when pos >= src.len()
			if src[pos] == byte(34) {
				pos++
				return string(src[start:pos - 1])
			}
			let out = src[start:pos]
			for pos < src.len() {
				let b = src[pos]
				if b == byte(34) {
					pos++
					return string(out)
				}
				fail "json: control character in a string at offset {pos}" when b < byte(32)
				if b != byte(92) {
					let run = pos
					for pos < src.len() && src[pos] != byte(34) && src[pos] != byte(92) && src[pos] >= byte(32) {
						pos++
					}
					out += src[run:pos]
					continue
				}
				pos++
				fail "json: unterminated escape at offset {pos}" when pos >= src.len()
				let esc = src[pos]
				pos++
				match int(esc) {
					case 34, 92, 47:
						out.push(esc)
					case 98:
						out.push(byte(8))
					case 102:
						out.push(byte(12))
					case 110:
						out.push(byte(10))
					case 114:
						out.push(byte(13))
					case 116:
						out.push(byte(9))
					case 117:
						let unit = try hexUnit()
						if unit >= 0xD800 && unit <= 0xDBFF && pos + 1 < src.len() && src[pos] == byte(92) && src[pos + 1] == byte(117) {
							let back = pos
							pos += 2
							let low = try hexUnit()
							if low >= 0xDC00 && low <= 0xDFFF {
								unit = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
							} else {
								pos = back
							}
						}
						unit = 0xFFFD when unit >= 0xD800 && unit <= 0xDFFF
						out += string(char(unit)).bytes()
					default:
						fail "json: unknown escape \\{char(esc)} at offset {pos - 1}"
				}
			}
			fail "json: unterminated string at offset {start}"
		}

		// Reads the four hex digits of a \u escape as a UTF-16 code unit.
		internal def hexUnit() !int {
			fail "json: truncated \\u escape at offset {pos}" when pos + 4 > src.len()
			let v = 0
			for let i = 0; i < 4; i++ {
				let c = int(src[pos + i])
				let d = -1
				d = c - 48 when c >= 48 && c <= 57
				d = c - 87 when c >= 97 && c <= 102
				d = c - 55 when c >= 65 && c <= 70
				fail "json: bad \\u escape at offset {pos}" when d < 0
				v = (v << 4) | d
			}
			pos += 4
			return v
		}

		// Returns a number's raw text. Left unparsed so the caller can convert
		// at the target field's width without losing precision.
		def parseNumberText() !string {
			// asString numbers arrive quoted.
			if peek() == '"' {
				return try parseString()
			}

			let start = pos
			if peek() == '-' || peek() == '+' {
				bump()
			}
			// Not `break` inside a `match`: that leaves the match, not the
			// loop, and the scan never terminates.
			for !done() && isNumberChar(peek()) {
				bump()
			}
			fail "json: expected a number at offset {start}" when pos == start
			return string(src[start:pos])
		}

		// Reads one value as the plain data `JSON.parse` describes, checking
		// the RFC 8259 grammar as it goes. Fails on malformed input or nesting
		// of maxDepth levels or more.
		def parseValue(depth int, maxDepth int) !any {
			fail "json: input nests deeper than {maxDepth} levels" when depth >= maxDepth
			skipSpace()
			let ch = peek()
			if ch == '"' {
				return try parseString()
			}
			if ch == '{' {
				bump()
				let out map<string, any>
				skipSpace()
				if peek() == '}' {
					bump()
					return out
				}
				for {
					skipSpace()
					fail "json: expected a key at offset {pos}" unless peek() == '"'
					let key = try parseString()
					skipSpace()
					fail "json: expected ':' at offset {pos}" unless peek() == ':'
					bump()
					out.set(key, try parseValue(depth + 1, maxDepth))
					skipSpace()
					if peek() == ',' {
						bump()
						continue
					}
					fail "json: expected ',' or '}' at offset {pos}" unless peek() == '}'
					bump()
					return out
				}
			}
			if ch == '[' {
				bump()
				let out any[] = []
				skipSpace()
				if peek() == ']' {
					bump()
					return out
				}
				for {
					out.push(try parseValue(depth + 1, maxDepth))
					skipSpace()
					if peek() == ',' {
						bump()
						continue
					}
					fail "json: expected ',' or ']' at offset {pos}" unless peek() == ']'
					bump()
					return out
				}
			}
			if ch == 't' {
				try literal("true")
				return true
			}
			if ch == 'f' {
				try literal("false")
				return false
			}
			if ch == 'n' {
				try literal("null")
				return none
			}
			let start = pos
			try validateNumber()
			let text = string(src[start:pos])
			let integral = true
			for let i = start; i < pos; i++ {
				let b = src[i]
				integral = false when b == byte(46) || b == byte(101) || b == byte(69)
			}
			// 18 digits always fit an int64.
			return parseInt<int>(text) when integral && pos - start <= 18
			return parseFloat<float>(text)
		}

		// Checks one value against the RFC 8259 grammar without building it:
		// separators, keys, literals, string escapes and number shape are all
		// enforced, unlike `skipValue`, which only balances brackets.
		def validateValue(depth int) !bool {
			fail "json: nesting deeper than 512 at offset {pos}" when depth > 512
			skipSpace()
			let ch = peek()
			if ch == '"' {
				let _ = try parseString()
				return true
			}
			if ch == '{' {
				bump()
				skipSpace()
				if peek() == '}' {
					bump()
					return true
				}
				for {
					skipSpace()
					fail "json: expected a key at offset {pos}" unless peek() == '"'
					let _ = try parseString()
					skipSpace()
					fail "json: expected ':' at offset {pos}" unless peek() == ':'
					bump()
					let _ = try validateValue(depth + 1)
					skipSpace()
					if peek() == ',' {
						bump()
						continue
					}
					fail "json: expected ',' or '}' at offset {pos}" unless peek() == '}'
					bump()
					return true
				}
			}
			if ch == '[' {
				bump()
				skipSpace()
				if peek() == ']' {
					bump()
					return true
				}
				for {
					let _ = try validateValue(depth + 1)
					skipSpace()
					if peek() == ',' {
						bump()
						continue
					}
					fail "json: expected ',' or ']' at offset {pos}" unless peek() == ']'
					bump()
					return true
				}
			}
			if ch == 't' {
				try literal("true")
				return true
			}
			if ch == 'f' {
				try literal("false")
				return true
			}
			if ch == 'n' {
				try literal("null")
				return true
			}
			return try validateNumber()
		}

		// `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?`
		internal def validateNumber() !bool {
			let start = pos
			bump() when peek() == '-'
			if peek() == '0' {
				bump()
			} else {
				fail "json: expected a value at offset {start}" unless peek().isDigit()
				for peek().isDigit() {
					bump()
				}
			}
			if peek() == '.' {
				bump()
				fail "json: expected digits after '.' at offset {pos}" unless peek().isDigit()
				for peek().isDigit() {
					bump()
				}
			}
			if peek() == 'e' || peek() == 'E' {
				bump()
				bump() when peek() == '+' || peek() == '-'
				fail "json: expected exponent digits at offset {pos}" unless peek().isDigit()
				for peek().isDigit() {
					bump()
				}
			}
			return true
		}

		// Consumes and discards one value of any shape.
		def skipValue() !none {
			skipSpace()
			match peek() {
				case '"':
					let _ = try parseString()
					return none
				case '{', '[':
					let open = peek()
					let close = open == '{' ?? ('}', ']')
					bump()
					let depth = 1
					for depth > 0 {
						fail "json: unterminated container at offset {pos}" when done()
						let ch = peek()
						if ch == '"' {
							let _ = try parseString()
							continue
						}
						if ch == open {
							depth = depth + 1
						} else if ch == close {
							depth = depth - 1
						}
						bump()
					}
					return none
				case 't':
					return try literal("true")
				case 'f':
					return try literal("false")
				case 'n':
					return try literal("null")
				default:
					let _ = try parseNumberText()
					return none
			}
		}
	}

	// Quotes and escapes a string per RFC 8259.
	def quote(val string) string {
		let out = "\""
		for let (_, ch) in val {
			match ch {
				case '"':
					out += "\\\""
				case '\\':
					out += "\\\\"
				case '\n':
					out += "\\n"
				case '\r':
					out += "\\r"
				case '\t':
					out += "\\t"
				case '\u0008':
					out += "\\b"
				case '\u000C':
					out += "\\f"
				default:
					if int(ch) < 0x20 {
						out += "\\u00" + hexDigits[int(ch) >> 4] + hexDigits[int(ch) & 15]
					} else {
						out += ch
					}
			}
		}
		out += "\""
		return out
	}

	const hexDigits = "0123456789abcdef"
}
