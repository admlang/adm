partial module std.data.encoding {
	use (
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.io
	)

	interface JSONEncoder {
		def json() byte[]
	}

	interface JSONDecoder {
		def json(data byte[]) !none
	}

	// Naming convention applied to field names when encoding.
	//
	// Decoding is unaffected: keys are matched case-insensitively.
	enum CaseStyle {
		// The declared field name, unchanged.
		AsIs,
		Camel,
		Snake,
		Kebab,
		Pascal,
		Lower,
		Upper
	}

	// Qualified name of the `@json` meta function, used to look up field options.
	internal const jsonAttr = "std.data.encoding.json"

	// Encodes and decodes JSON objects of scalars, arrays and nested objects.
	//
	//     let j = new JSON()
	//     let text = string(j.encode(user))
	//     try j.decode(text, user)
	//
	// Per-field behaviour comes from `@json` annotations:
	//
	//     @json("user_id")        encode under this key instead of the field name
	//     @json(omitempty: true)  leave the field out when it holds its zero value
	//     @json(ignore: true)     never encode or decode the field
	//     @json(asString: true)   quote the value, keeping large integers exact
	//     @json(nullable: true)   encode as null rather than being omitted
	//
	// A type implementing JSONEncoder or JSONDecoder is used instead of
	// reflection.
	type JSON {
		indent       bool   = false
		indentString string = "\t"

		// Key naming for fields with no explicit `@json("name")`.
		caseStyle CaseStyle = CaseStyle.AsIs

		// How many objects deep to encode before writing null instead of
		// descending further. Values that refer back to themselves have no
		// depth at which they stop, and encode returns bytes rather than an
		// error, so this is what stands between a cycle and an exhausted
		// stack. Raise it for data that is legitimately deeper.
		maxDepth int = 64

		def encode(obj any) byte[] {
			return encodeValue(obj, 0).bytes()
		}

		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// Reports whether the text is one complete JSON document (RFC 8259):
		// a single value — object, array, string, number, `true`, `false` or
		// `null` — with nothing but whitespace around it. Nothing is built.
		def isValid(input string) bool {
			let cur = new JSONCursor(input)
			cur.skipSpace()
			let ok = cur.validateValue(0) onerror recover false
			return false unless ok
			cur.skipSpace()
			return cur.done()
		}

		// Binds a document onto target, setting the fields it names.
		//
		// Keys match the encoded name exactly first, then case-insensitively
		// against the encoded and declared names. Unknown keys are ignored, and
		// null leaves a field at its zero value.
		def decode(input byte[], target any) !none {
			return try decode(string(input), target)
		}

		def decode(input string, target any) !none {
			match target {
				case JSONDecoder:
					return try target.json(input.bytes())
				default:
			}

			let cur = new JSONCursor(input)
			cur.skipSpace()
			try bindValue(cur, target, 0)
			cur.skipSpace()
			fail "json: trailing data at offset {cur.pos}" when !cur.done()
			return none
		}

		def decode(reader io.Reader, target any) !none {
			let chunk byte[]
			chunk.len(4096)
			let all byte[]
			for {
				let n = try reader.read(chunk)
				if n <= 0 {
					break
				}
				all += chunk.slice(0, n)
			}
			return try decode(string(all), target)
		}

		// Binds one value onto target, which must be an object.
		internal def bindValue(cur JSONCursor, target any, depth int) !none {
			fail "json: input nests deeper than {maxDepth} objects" when depth >= maxDepth
			cur.skipSpace()
			if cur.peek() == 'n' {
				try cur.literal("null")
				return none
			}
			fail "json: expected an object at offset {cur.pos}" when cur.peek() != '{'
			cur.bump()

			cur.skipSpace()
			if cur.peek() == '}' {
				cur.bump()
				return none
			}

			for {
				cur.skipSpace()
				let key = try cur.parseString()
				cur.skipSpace()
				fail "json: expected ':' after key {key}" when cur.peek() != ':'
				cur.bump()
				cur.skipSpace()

				let f = fieldForKey(target, key, jsonAttr, caseStyle)
				if f is none {
					// Unknown key: consume its value and carry on.
					try cur.skipValue()
				} else {
					try bindField(cur, f, depth)
				}

				cur.skipSpace()
				if cur.peek() == ',' {
					cur.bump()
					continue
				}
				fail "json: expected ',' or '}' at offset {cur.pos}" when cur.peek() != '\u007D'
				cur.bump()
				break
			}
			return none
		}

		// Reads one value and stores it in the given field.
		internal def bindField(cur JSONCursor, f Field, depth int) !none {
			if cur.peek() == 'n' {
				try cur.literal("null")
				return none
			}

			let kind = f.kind
			if kind == FieldKind.Array {
				return try bindArray(cur, f)
			}
			if kind == FieldKind.Struct {
				let nested = f.ensureValue()
				fail "json: cannot read an object into `{f.name}`" when nested is none
				return try bindValue(cur, nested, depth + 1)
			}
			try bindScalar(cur, f, kind)
			return none
		}

		internal def bindScalar(cur JSONCursor, f Field, kind FieldKind) !none {
			if kind == FieldKind.String {
				f.setString(try cur.parseString())
				return none
			}

			if kind == FieldKind.Bool {
				// Accept both quoted and bare, since asString writes quoted.
				if cur.peek() == '"' {
					f.setBool(isTruthyScalar(try cur.parseString()))
					return none
				}
				if cur.peek() == 't' {
					try cur.literal("true")
					f.setBool(true)
					return none
				}
				try cur.literal("false")
				f.setBool(false)
				return none
			}

			setScalarText(f, kind, try cur.parseNumberText())
			return none
		}

		internal def bindArray(cur JSONCursor, f Field) !none {
			fail "json: expected an array at offset {cur.pos}" when cur.peek() != '['
			cur.bump()
			cur.skipSpace()

			// Two passes: count, size the array, then fill. Growing per element
			// would reallocate on every value.
			let start = cur.pos
			let count = 0
			if cur.peek() != ']' {
				for {
					try cur.skipValue()
					count++
					cur.skipSpace()
					if cur.peek() == ',' {
						cur.bump()
						cur.skipSpace()
						continue
					}
					break
				}
			}
			fail "json: expected ']' at offset {cur.pos}" when cur.peek() != ']'
			cur.bump()

			f.setLen(count)
			let kind = f.elemKind
			let after = cur.pos
			cur.pos = start
			cur.skipSpace()
			for let i = 0; i < count; i++ {
				try bindScalar(cur, f.at(i), kind)
				cur.skipSpace()
				if cur.peek() == ',' {
					cur.bump()
					cur.skipSpace()
				}
			}
			cur.pos = after
			return none
		}

		// Returns the JSON key for a field.
		internal def keyFor(f Field) string {
			return encodedKey(f, jsonAttr, caseStyle)
		}

		// Reads a boolean option from a field's `@json` annotation.
		internal def flag(f Field, key string) bool {
			return fieldFlag(f, jsonAttr, key)
		}

		// Renders one field's value. asString wraps numbers and bools in quotes.
		internal def encodeField(f Field, depth int) string {
			let kind = f.kind

			if kind == FieldKind.Array {
				return encodeArray(f)
			}
			if kind == FieldKind.Struct {
				let nested = f.value()
				if nested is none {
					return "null"
				}
				return encodeValue(nested, depth + 1)
			}
			if kind == FieldKind.String {
				return quote(f.asString())
			}

			let raw = scalarText(f, kind)
			if raw == "" {
				return "null"
			}
			return flag(f, "asString") ?? (quote(raw), raw)
		}

		internal def encodeArray(f Field) string {
			let kind = f.elemKind
			let out = "["
			let n = f.len()
			for let i = 0; i < n; i++ {
				if i > 0 {
					out += ","
				}
				let e = f.at(i)
				if kind == FieldKind.String {
					out += quote(e.asString())
				} else {
					let raw = scalarText(e, kind)
					out += raw == "" ?? ("null", raw)
				}
			}
			out += "]"
			return out
		}

		internal def encodeValue(obj any, depth int) string {
			match obj {
				case JSONEncoder:
					return string(obj.json())
				default:
			}

			if depth >= maxDepth {
				return "null"
			}

			let all = reflection.fields(obj)
			if all.len() == 0 {
				return "null"
			}

			let out = "\u007B"
			let first = true
			for let (_, f) in all {
				if flag(f, "ignore") {
					continue
				}
				if flag(f, "omitempty") && fieldIsEmpty(f) {
					continue
				}
				if !first {
					out += ","
				}
				first = false
				out += quote(keyFor(f))
				out += ":"
				out += encodeField(f, depth)
			}
			out += "\u007D"
			return out
		}
	}

	// Annotation handling shared by the reflection-driven codecs. Each helper
	// takes the qualified meta function name, so JSON and YAML resolve options
	// the same way.

	// Applies a naming convention to a field name.
	internal def applyCaseStyle(name string, casing CaseStyle) string {
		match casing {
			case CaseStyle.Camel:
				return name.camelCase()
			case CaseStyle.Snake:
				return name.snakeCase()
			case CaseStyle.Kebab:
				return name.kebabCase()
			case CaseStyle.Pascal:
				return name.camelCase().capitalize()
			case CaseStyle.Lower:
				return name.lower()
			case CaseStyle.Upper:
				return name.upper()
			default:
				return name
		}
	}

	// Returns the encoded key for a field: an explicit name if annotated,
	// otherwise the declared name with casing applied.
	internal def encodedKey(f Field, annotation string, casing CaseStyle) string {
		let explicit = f.attr(annotation, "name")
		if explicit != "" {
			return explicit
		}
		return applyCaseStyle(f.name, casing)
	}

	// Reads a boolean option from a field annotation.
	internal def fieldFlag(f Field, annotation string, key string) bool {
		return f.attr(annotation, key) == "true"
	}

	// Reports whether a field holds its zero value: empty string, zero, false,
	// or an empty array.
	internal def fieldIsEmpty(f Field) bool {
		match f.kind {
			case FieldKind.String:
				return f.asString() == ""
			case FieldKind.Bool:
				return !f.asBool()
			case FieldKind.Int:
				return f.asInt() == 0
			case FieldKind.Uint:
				return f.asUint() == 0
			case FieldKind.Float:
				return f.asFloat() == 0.0
			case FieldKind.Array:
				return f.len() == 0
			case FieldKind.Struct:
				// A nested object has no zero value to recognise: its own
				// fields decide what it encodes to, and omitempty on each of
				// them is how to leave parts of it out.
				return false
			default:
				return false
		}
	}

	// Returns the field matching key, or none.
	//
	// Tries the encoded name exactly, then the encoded and declared names
	// case-insensitively.
	internal def fieldForKey(value any, key string, annotation string, casing CaseStyle) ?Field {
		let all = reflection.fields(value)

		for let (_, f) in all {
			if fieldFlag(f, annotation, "ignore") {
				continue
			}
			if encodedKey(f, annotation, casing) == key {
				return f
			}
		}

		let lowered = key.lower()
		for let (_, f) in all {
			if fieldFlag(f, annotation, "ignore") {
				continue
			}
			if encodedKey(f, annotation, casing).lower() == lowered {
				return f
			}
			if f.name.lower() == lowered {
				return f
			}
		}
		return none
	}

	// Returns a scalar's value as unquoted, unescaped text. Works on a field or
	// on one element of an array field.
	internal def scalarText(f Field, kind FieldKind) string {
		match kind {
			case FieldKind.String:
				return f.asString()
			case FieldKind.Bool:
				return f.asBool() ?? ("true", "false")
			case FieldKind.Int:
				return f.asInt().str()
			case FieldKind.Uint:
				return f.asUint().str()
			case FieldKind.Float:
				return f.asFloat().str()
			default:
				return ""
		}
	}

	// Stores unquoted text, converted to the given kind.
	internal def setScalarText(f Field, kind FieldKind, text string) {
		match kind {
			case FieldKind.String:
				f.setString(text)
			case FieldKind.Bool:
				f.setBool(isTruthyScalar(text))
			case FieldKind.Int:
				f.setInt(parseInt<int>(text))
			case FieldKind.Uint:
				f.setUint(uint(parseInt<int>(text)))
			case FieldKind.Float:
				f.setFloat(parseFloat<float>(text))
			default:
		}
	}

	// Reports whether text spells true. Accepts the YAML 1.1 spellings.
	internal def isTruthyScalar(text string) bool {
		match text.lower() {
			case "true", "yes", "on", "y", "1":
				return true
			default:
				return false
		}
	}

	// Records a codec's field options into the metadata store. Options left at
	// their defaults are removed rather than stored, so absent reads as default.
	internal def recordCodecOptions(store MetadataStore, format string, name string, omitempty bool, ignore bool, asString bool, nullable bool) {
		let prefix = "encoder." + format + "."

		if name == "" {
			store.delete(prefix + "name")
		} else {
			store.save(prefix + "name", name)
		}

		recordFlag(store, prefix + "omitempty", omitempty)
		recordFlag(store, prefix + "ignore", ignore)
		recordFlag(store, prefix + "asstring", asString)
		recordFlag(store, prefix + "nullable", nullable)
	}

	internal def recordFlag(store MetadataStore, key string, on bool) {
		if on {
			store.save(key, "1")
		} else {
			store.delete(key)
		}
	}

	// Reports whether ch may appear in a JSON number, exponents included.
	internal def isNumberChar(ch char) bool {
		return (ch >= '0' && ch <= '9') || ch == '.' || ch == 'e' || ch == 'E' || ch == '+' || ch == '-'
	}

	// A position in a JSON document.
	//
	// It holds the parse state for one document, so two concurrent decodes
	// cannot tread on each other.
	// It is also the seam a SIMD tokenizer would replace -- the parser above
	// only ever asks it for the next value, never for a character.
	internal type JSONCursor {
		src string
		pos int    = 0

		def new(text string) {
			self.src = text
			self.pos = 0
		}

		def done() bool {
			return pos >= src.len()
		}

		// Returns the character at the cursor, or NUL at end of input.
		def peek() char {
			if done() {
				return char(0)
			}
			return src[pos]
		}

		def bump() {
			pos = pos + 1
		}

		def skipSpace() {
			for !done() {
				match peek() {
					case ' ', '\t', '\n', '\r':
						bump()
					default:
						return
				}
			}
		}

		// Consumes an expected bare word such as true, false or null.
		def literal(word string) !none {
			for let (i, ch) in word {
				fail "json: expected {word} at offset {pos}" when pos + i >= src.len() || src[pos + i] != ch
			}
			pos = pos + word.len()
			return none
		}

		// Reads a quoted string, resolving escapes including \uXXXX.
		def parseString() !string {
			fail "json: expected a string at offset {pos}" when peek() != '"'
			bump()

			let out = ""
			for !done() {
				let ch = peek()
				if ch == '"' {
					bump()
					return out
				}
				if ch != '\\' {
					out += ch
					bump()
					continue
				}

				bump()
				fail "json: unterminated escape at offset {pos}" when done()
				let esc = peek()
				bump()
				match esc {
					case '"':
						out += '"'
					case '\\':
						out += '\\'
					case '/':
						out += '/'
					case 'b':
						out += '\u0008'
					case 'f':
						out += '\u000C'
					case 'n':
						out += '\n'
					case 'r':
						out += '\r'
					case 't':
						out += '\t'
					case 'u':
						fail "json: truncated \\u escape at offset {pos}" when pos + 4 > src.len()
						let hex = src.slice(pos, pos + 4)
						pos = pos + 4
						out += string(char(parseInt<int>(hex, 16)))
					default:
						fail "json: unknown escape \\{esc} at offset {pos}"
				}
			}
			fail "json: unterminated string at offset {pos}"
		}

		// Returns a number's raw text. Left unparsed so the caller can convert
		// at the target field's width without losing precision.
		def parseNumberText() !string {
			// asString numbers arrive quoted.
			if peek() == '"' {
				return try parseString()
			}

			let start = pos
			if peek() == '-' || peek() == '+' {
				bump()
			}
			// Not `break` inside a `match`: that leaves the match, not the
			// loop, and the scan never terminates.
			for !done() && isNumberChar(peek()) {
				bump()
			}
			fail "json: expected a number at offset {start}" when pos == start
			return src.slice(start, pos)
		}

		// Checks one value against the RFC 8259 grammar without building it:
		// separators, keys, literals, string escapes and number shape are all
		// enforced, unlike `skipValue`, which only balances brackets.
		def validateValue(depth int) !bool {
			fail "json: nesting deeper than 512 at offset {pos}" when depth > 512
			skipSpace()
			let ch = peek()
			if ch == '"' {
				let _ = try parseString()
				return true
			}
			if ch == '{' {
				bump()
				skipSpace()
				if peek() == '}' {
					bump()
					return true
				}
				for {
					skipSpace()
					fail "json: expected a key at offset {pos}" unless peek() == '"'
					let _ = try parseString()
					skipSpace()
					fail "json: expected ':' at offset {pos}" unless peek() == ':'
					bump()
					let _ = try validateValue(depth + 1)
					skipSpace()
					if peek() == ',' {
						bump()
						continue
					}
					fail "json: expected ',' or '}' at offset {pos}" unless peek() == '}'
					bump()
					return true
				}
			}
			if ch == '[' {
				bump()
				skipSpace()
				if peek() == ']' {
					bump()
					return true
				}
				for {
					let _ = try validateValue(depth + 1)
					skipSpace()
					if peek() == ',' {
						bump()
						continue
					}
					fail "json: expected ',' or ']' at offset {pos}" unless peek() == ']'
					bump()
					return true
				}
			}
			if ch == 't' {
				try literal("true")
				return true
			}
			if ch == 'f' {
				try literal("false")
				return true
			}
			if ch == 'n' {
				try literal("null")
				return true
			}
			return try validateNumber()
		}

		// `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?`
		internal def validateNumber() !bool {
			let start = pos
			bump() when peek() == '-'
			if peek() == '0' {
				bump()
			} else {
				fail "json: expected a value at offset {start}" unless isDigitChar(peek())
				for isDigitChar(peek()) {
					bump()
				}
			}
			if peek() == '.' {
				bump()
				fail "json: expected digits after '.' at offset {pos}" unless isDigitChar(peek())
				for isDigitChar(peek()) {
					bump()
				}
			}
			if peek() == 'e' || peek() == 'E' {
				bump()
				bump() when peek() == '+' || peek() == '-'
				fail "json: expected exponent digits at offset {pos}" unless isDigitChar(peek())
				for isDigitChar(peek()) {
					bump()
				}
			}
			return true
		}

		internal def isDigitChar(ch char) bool {
			return ch >= '0' && ch <= '9'
		}

		// Consumes and discards one value of any shape.
		def skipValue() !none {
			skipSpace()
			match peek() {
				case '"':
					let _ = try parseString()
					return none
				case '{', '[':
					let open = peek()
					let close = open == '{' ?? ('}', ']')
					bump()
					let depth = 1
					for depth > 0 {
						fail "json: unterminated container at offset {pos}" when done()
						let ch = peek()
						if ch == '"' {
							let _ = try parseString()
							continue
						}
						if ch == open {
							depth = depth + 1
						} else if ch == close {
							depth = depth - 1
						}
						bump()
					}
					return none
				case 't':
					return try literal("true")
				case 'f':
					return try literal("false")
				case 'n':
					return try literal("null")
				default:
					let _ = try parseNumberText()
					return none
			}
		}
	}

	// Quotes and escapes a string per RFC 8259.
	internal def quote(val string) string {
		let out = "\""
		for let (_, ch) in val {
			match ch {
				case '"':
					out += "\\\""
				case '\\':
					out += "\\\\"
				case '\n':
					out += "\\n"
				case '\r':
					out += "\\r"
				case '\t':
					out += "\\t"
				default:
					out += ch
			}
		}
		out += "\""
		return out
	}

	// Controls how a field is encoded to and decoded from JSON.
	//
	//     name       key to use instead of the field name
	//     omitempty  leave the field out when it holds its zero value
	//     ignore     never encode or decode the field
	//     asString   quote the value, keeping large integers exact
	//     nullable   encode as null rather than being omitted
	//
	//     struct User {
	//         @json("user_id")
	//         id int
	//         @json(omitempty: true)
	//         nickname string
	//     }
	meta def json(ctx FieldMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "json", name, omitempty, ignore, asString, nullable)
	}

	// Controls how a property is encoded to and decoded from JSON. Takes the
	// same options as the field form above.
	meta def json(ctx PropertyMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "json", name, omitempty, ignore, asString, nullable)
	}
}
