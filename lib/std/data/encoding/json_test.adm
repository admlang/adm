partial module std.data.encoding {
	use std.testing

	// Fixtures. Each exercises one part of the annotation surface, so a failure
	// names the option rather than "JSON is broken".
	//
	// All `internal`: a test fixture that is exported becomes part of
	// std.data.encoding's public API, and `adm doc --module` listed every one
	// of these alongside JSON itself before they were marked.

	internal struct JSONPlain {
		id     int
		name   string
		active bool
	}

	// A struct with an `any` field, a map of `any`, an array of objects and
	// a nested array, for the encoder's boxed-value paths.
	internal struct JSONAnyHolder {
		note  any
		extra map<string, any>
		items JSONPlain[]
		grid  int[][]
	}

	internal def a2(id int) JSONPlain {
		return JSONPlain{id: id, name: "n", active: false}
	}

	internal struct JSONRenamed {
		@json("TEST")
		xyz int
		@json("nick")
		name string
	}

	internal struct JSONOmitted {
		@json(ignore: true)
		secret string
		kept int
	}

	internal struct JSONOmitEmpty {
		@json(omitempty: true)
		name string
		@json(omitempty: true)
		count int
		@json(omitempty: true)
		flag bool
		always int
	}

	internal struct JSONAsString {
		@json(asString: true)
		bigId int
		@json(asString: true)
		ratio float
		@json(asString: true)
		flag bool
		plain int
	}

	internal struct JSONCased {
		userName  string
		accountID int
		isActive  bool
	}

	internal struct JSONNumbers {
		i int
		u uint
		f float
	}

	internal struct JSONEscapes {
		text string
	}

	internal struct JSONAddress {
		@json("city_name")
		city string
		zip int
	}

	internal struct JSONNested {
		name string
		@json("home")
		addr JSONAddress
	}

	internal struct JSONDeep {
		inner JSONNested
	}

	// Declared with `type`, not `struct`, and carrying a method: what the codec
	// descends into is anything with fields, however it was declared.
	internal type JSONTypeAddress {
		city string

		def label() string {
			return city
		}
	}

	internal type JSONTypeHolder {
		addr JSONTypeAddress
		home JSONAddress
	}

	internal struct JSONArrays {
		nums  int[]
		tags  string[]
		flags bool[]
		fs    float[]
	}

	// Narrow element types: an int16[] strides two bytes per element, not the
	// eight an int[] does.
	internal struct JSONNarrowArrays {
		small   int16[]
		bytes   uint8[]
		singles float32[]
	}

	// Implements both JSON interfaces, so the codec must use them and never
	// look at the fields.
	internal type JSONSelfEncoded {
		seen    string
		ignored int

		def json() byte[] {
			return "{\"custom\":true}".bytes()
		}

		def json(data byte[]) !none {
			seen = string(data)
			return none
		}
	}

	internal struct JSONMaps {
		counts map<string, int>
		labels map<string, string>
		@json(omitempty: true)
		extra map<string, float>
	}

	internal struct JSONMapOfObjects {
		places map<string, JSONAddress>
	}

	check "JSON encoding" {
		@test()
		def encodesBareValues() {
			// `encode` receives `any`: a scalar, a string, an array or a map
			// with no struct around it renders as itself, not as null.
			let codec = new JSON()
			assert string(codec.encode("x\"y")) == "\"x\\\"y\""
			assert string(codec.encode(42)) == "42"
			assert string(codec.encode(int32(7))) == "7"
			assert string(codec.encode(1.5)) == "1.5"
			assert string(codec.encode(true)) == "true"
			assert string(codec.encode(["a", "b"])) == "[\"a\",\"b\"]"
			assert string(codec.encode([1, 2, 3])) == "[1,2,3]"
			let mixed any[] = ["a", 1, true]
			assert string(codec.encode(mixed)) == "[\"a\",1,true]"
			assert string(codec.encode(map<string, int>{"a": 1, "b": 2})) == "\u007B\"a\":1,\"b\":2\u007D"
			let body = map<string, any>{"error": "bad input", "status": 422}
			assert string(codec.encode(body)) == "\u007B\"error\":\"bad input\",\"status\":422\u007D"
		}

		@test()
		def encodesObjectsInsideContainers() {
			let codec = new JSON()
			let a = JSONPlain{id: 1, name: "a", active: true}
			let b = JSONPlain{id: 2, name: "b", active: false}
			let list = [a, b]
			assert string(codec.encode(list)) == "[\u007B\"id\":1,\"name\":\"a\",\"active\":true\u007D,\u007B\"id\":2,\"name\":\"b\",\"active\":false\u007D]"
			let byName = map<string, JSONPlain>{"first": a}
			assert string(codec.encode(byName)) == "\u007B\"first\":\u007B\"id\":1,\"name\":\"a\",\"active\":true\u007D\u007D"
			let nested any[] = [a, ["x"], map<string, any>{"k":1}]
			assert string(codec.encode(nested)) == "[\u007B\"id\":1,\"name\":\"a\",\"active\":true\u007D,[\"x\"],\u007B\"k\":1\u007D]"
		}

		@test()
		def encodesAnyFieldsAndNestedArrays() {
			let codec = new JSON()
			let v = JSONAnyHolder{note: "hello", extra: map<string, any>{"ok": true, "n": 2}, items: [a2(1), a2(2)], grid: [[1, 2], [3]]}
			assert string(codec.encode(v)) == "\u007B\"note\":\"hello\",\"extra\":\u007B\"ok\":true,\"n\":2\u007D,\"items\":[\u007B\"id\":1,\"name\":\"n\",\"active\":false\u007D,\u007B\"id\":2,\"name\":\"n\",\"active\":false\u007D],\"grid\":[[1,2],[3]]\u007D"
		}

		@test()
		def encodesMaps() {
			let enc = new JSON()
			let v = JSONMaps{counts: map<string, int>{"a": 1, "b": 2}, labels: map<string, string>{"x": "y \"q\""}}
			let got = string(enc.encode(v))
			// Entries keep insertion order; the empty omitempty map is left out.
			assert got == "{\"counts\":{\"a\":1,\"b\":2},\"labels\":{\"x\":\"y \\\"q\\\"\"}}"
		}

		@test()
		def encodesIndented() {
			let enc = new JSON()
			enc.indent = true
			enc.indentString = "  "
			let got = string(enc.encode(JSONNested{name: "a\u007Bb\u007D", addr: JSONAddress{city: "Oslo", zip: 1}}))
			assert got == "{\n  \"name\": \"a\u007Bb\u007D\",\n  \"home\": {\n    \"city_name\": \"Oslo\",\n    \"zip\": 1\n  }\n}"
			assert string(enc.encode(JSONMaps{})) == "{\n  \"counts\": {},\n  \"labels\": {}\n}"
		}

		@test()
		def encodesEmptyMap() {
			let enc = new JSON()
			let got = string(enc.encode(JSONMaps{}))
			assert got == "{\"counts\":{},\"labels\":{}}"
		}

		@test()
		def decodesMaps() {
			let enc = new JSON()
			let v = JSONMaps{}
			assert !(enc.decode("{\"counts\":{\"a\":1,\"b\":2},\"labels\":{\"x\":\"y\"},\"extra\":{\"r\":0.5}}", v) is error)
			assert v.counts.len() == 2
			assert v.counts["a"] == 1
			assert v.counts["b"] == 2
			assert v.labels["x"] == "y"
			assert v.extra["r"] == 0.5
		}

		@test()
		def decodeReplacesMapEntriesAndSkipsNull() {
			let enc = new JSON()
			let v = JSONMaps{counts: map<string, int>{"old": 9}}
			assert !(enc.decode("{\"counts\":{\"a\":null,\"b\":3}}", v) is error)
			assert v.counts.len() == 1
			assert !v.counts.hasKey("old")
			assert !v.counts.hasKey("a")
			assert v.counts["b"] == 3
		}

		@test()
		def encodesMapOfObjects() {
			let enc = new JSON()
			let v = JSONMapOfObjects{places: map<string, JSONAddress>{"home": JSONAddress{city: "Oslo", zip: 1234}}}
			let got = string(enc.encode(v))
			assert got == "{\"places\":{\"home\":{\"city_name\":\"Oslo\",\"zip\":1234}}}"
		}

		@test()
		def decodesMapOfObjects() {
			let enc = new JSON()
			let v = JSONMapOfObjects{}
			assert !(enc.decode("{\"places\":{\"home\":{\"city_name\":\"Oslo\",\"zip\":1234},\"work\":{\"zip\":5}}}", v) is error)
			assert v.places.len() == 2
			assert v.places["home"].city == "Oslo"
			assert v.places["home"].zip == 1234
			assert v.places["work"].zip == 5
		}

		@test()
		def mapRoundTrips() {
			let enc = new JSON()
			let v = JSONMaps{counts: map<string, int>{"n": 7}, labels: map<string, string>{"k": "v"}, extra: map<string, float>{"f": 1.5}}
			let back = JSONMaps{}
			assert !(enc.decode(enc.encode(v), back) is error)
			assert back.counts["n"] == 7
			assert back.labels["k"] == "v"
			assert back.extra["f"] == 1.5
		}

		@test()
		def encodesPlainFields() {
			let enc = new JSON()
			let got = string(enc.encode(JSONPlain{id: 7, name: "ada", active: true}))
			assert got == "{\"id\":7,\"name\":\"ada\",\"active\":true}"
		}

		@test()
		def renamesWithExplicitName() {
			let enc = new JSON()
			let got = string(enc.encode(JSONRenamed{xyz: 1, name: "bob"}))
			assert got == "{\"TEST\":1,\"nick\":\"bob\"}"
		}

		@test()
		def ignoreDropsTheField() {
			let enc = new JSON()
			let got = string(enc.encode(JSONOmitted{secret: "hunter2", kept: 5}))
			assert got == "{\"kept\":5}"
			// The value must not leak under any key.
			assert !got.contains("hunter2")
		}

		@test()
		def omitEmptyDropsZeroValues() {
			let enc = new JSON()
			let blank = string(enc.encode(JSONOmitEmpty{name: "", count: 0, flag: false, always: 0}))
			assert blank == "{\"always\":0}"

			// Non-zero values survive, and `always` has no omitempty so it
			// stays either way -- that is what makes this a test of the
			// annotation rather than of the value.
			let full = string(enc.encode(JSONOmitEmpty{name: "x", count: 2, flag: true, always: 9}))
			assert full == "{\"name\":\"x\",\"count\":2,\"flag\":true,\"always\":9}"
		}

		@test()
		def asStringQuotesScalars() {
			let enc = new JSON()
			let got = string(enc.encode(JSONAsString{bigId: 9007199254740993, ratio: 1.5, flag: true, plain: 3}))
			// 2^53+1 is the point: it cannot round-trip through a JavaScript
			// number, so it has to leave as a string.
			assert got.contains("\"bigId\":\"9007199254740993\"")
			assert got.contains("\"flag\":\"true\"")
			// A field without the annotation is untouched.
			assert got.contains("\"plain\":3")
		}

		@test()
		def caseStyleRenamesUnannotatedFields() {
			let asIs = new JSON()
			assert string(asIs.encode(JSONCased{userName: "a", accountID: 1, isActive: true})).contains("\"userName\":")

			let snake = new JSON(caseStyle: CaseStyle.Snake)
			let s = string(snake.encode(JSONCased{userName: "a", accountID: 1, isActive: true}))
			assert s.contains("\"user_name\":")
			assert s.contains("\"is_active\":")

			let kebab = new JSON(caseStyle: CaseStyle.Kebab)
			assert string(kebab.encode(JSONCased{userName: "a", accountID: 1, isActive: true})).contains("\"user-name\":")

			let upper = new JSON(caseStyle: CaseStyle.Upper)
			assert string(upper.encode(JSONCased{userName: "a", accountID: 1, isActive: true})).contains("\"USERNAME\":")
		}

		@test()
		def explicitNameBeatsCaseStyle() {
			// An explicit @json name is a decision; a case style is a default.
			let snake = new JSON(caseStyle: CaseStyle.Snake)
			let got = string(snake.encode(JSONRenamed{xyz: 1, name: "bob"}))
			assert got.contains("\"TEST\":")
			assert !got.contains("\"xyz\":")
		}

		@test()
		def encodesNumericWidths() {
			let enc = new JSON()
			let got = string(enc.encode(JSONNumbers{i: -42, u: 42, f: 1.5}))
			assert got.contains("\"i\":-42")
			assert got.contains("\"u\":42")
			assert got.contains("\"f\":1.5")
		}

		@test()
		def escapesStringsPerRFC8259() {
			let enc = new JSON()
			let got = string(enc.encode(JSONEscapes{text: "a\"b\\c\nd\te"}))
			assert got.contains("\\\"")
			assert got.contains("\\\\")
			assert got.contains("\\n")
			assert got.contains("\\t")
		}

		@test()
		def decodesPlainFields() {
			let enc = new JSON()
			let p = JSONPlain{}
			assert !(enc.decode("{\"id\":7,\"name\":\"ada\",\"active\":true}", p) is error)
			assert p.id == 7
			assert p.name == "ada"
			assert p.active
		}

		@test()
		def decodeMatchesTheEncodedName() {
			let enc = new JSON()
			let r = JSONRenamed{}
			assert !(enc.decode("{\"TEST\":5,\"nick\":\"bob\"}", r) is error)
			assert r.xyz == 5
			assert r.name == "bob"
		}

		@test()
		def decodeMatchesKeysCaseInsensitively() {
			// A producer using a different convention must still bind, which is
			// why caseStyle is an encode-only choice.
			let enc = new JSON()
			let c = JSONCased{}
			assert !(enc.decode("{\"USERNAME\":\"x\",\"accountid\":3,\"IsActive\":true}", c) is error)
			assert c.userName == "x"
			assert c.accountID == 3
			assert c.isActive
		}

		@test()
		def decodeSkipsUnknownKeys() {
			// Adding a field to a producer must not break a consumer, and the
			// skipped value must not desynchronise the parse -- hence the
			// nested object and array either side of a real field.
			let enc = new JSON()
			let p = JSONPlain{}
			assert !(enc.decode("{\"extra\":{\"a\":[1,2,{\"b\":\"}\"}]},\"id\":9,\"more\":[true,null],\"name\":\"z\"}", p) is error)
			assert p.id == 9
			assert p.name == "z"
		}

		@test()
		def decodeAcceptsQuotedNumbers() {
			// What `asString` writes, decode has to read back.
			let enc = new JSON()
			let a = JSONAsString{}
			assert !(enc.decode("{\"bigId\":\"9007199254740993\",\"ratio\":\"1.5\",\"flag\":\"true\",\"plain\":3}", a) is error)
			assert a.bigId == 9007199254740993
			assert a.flag
			assert a.plain == 3
		}

		@test()
		def decodeResolvesStringEscapes() {
			let enc = new JSON()
			let e = JSONEscapes{}
			assert !(enc.decode("{\"text\":\"a\\\"b\\\\c\\nd\\te\\u0041\"}", e) is error)
			assert e.text.contains("\"")
			assert e.text.contains("\n")
			assert e.text.contains("\t")
			assert e.text.contains("A")
		}

		@test()
		def decodeLeavesFieldsAbsentFromTheDocument() {
			let enc = new JSON()
			let p = JSONPlain{id: 1, name: "keep", active: true}
			assert !(enc.decode("{\"id\":2}", p) is error)
			assert p.id == 2
			// Untouched by the document, so untouched by the decode.
			assert p.name == "keep"
			assert p.active
		}

		@test()
		def decodeTreatsNullAsAbsent() {
			let enc = new JSON()
			let p = JSONPlain{id: 4, name: "keep", active: true}
			assert !(enc.decode("{\"name\":null,\"id\":5}", p) is error)
			assert p.id == 5
			assert p.name == "keep"
		}

		@test()
		def roundTripsThroughEncodeAndDecode() {
			let enc = new JSON()
			let src = JSONPlain{id: 123, name: "round trip", active: true}
			let dst = JSONPlain{}
			assert !(enc.decode(string(enc.encode(src)), dst) is error)
			assert dst.id == src.id
			assert dst.name == src.name
			assert dst.active == src.active
		}

		@test()
		def rejectsMalformedDocuments() {
			let enc = new JSON()
			let p = JSONPlain{}
			assert enc.decode("{\"id\":1", p) is error
			assert enc.decode("{\"id\" 1}", p) is error
			assert enc.decode("[1,2]", p) is error
			assert enc.decode("{\"id\":1}trailing", p) is error
		}

		@test()
		def decoderInterfaceBypassesReflection() {
			let enc = new JSON()
			let v = JSONSelfEncoded{ignored: 7}
			// Not valid JSON: it reaches the interface, so the parser never
			// sees it.
			assert !(enc.decode("!!! whatever", v) is error)
			assert v.seen == "!!! whatever"
			assert v.ignored == 7
		}

		@test()
		def encodesArrays() {
			let enc = new JSON()
			let got = string(enc.encode(JSONArrays{nums: [1, 2, 3], tags: ["x", "y"], flags: [true, false], fs: [1.5]}))
			assert got == "{\"nums\":[1,2,3],\"tags\":[\"x\",\"y\"],\"flags\":[true,false],\"fs\":[1.5]}"
		}

		@test()
		def encodesEmptyArrays() {
			let enc = new JSON()
			let got = string(enc.encode(JSONArrays{}))
			assert got == "{\"nums\":[],\"tags\":[],\"flags\":[],\"fs\":[]}"
		}

		@test()
		def decodesArrays() {
			let enc = new JSON()
			let v = JSONArrays{}
			assert !(enc.decode("{\"nums\":[1,2,3],\"tags\":[\"x\",\"y\"],\"flags\":[true,false],\"fs\":[1.5,2.5]}", v) is error)
			assert v.nums.len() == 3
			assert v.nums[0] == 1 && v.nums[1] == 2 && v.nums[2] == 3
			assert v.tags.len() == 2
			assert v.tags[0] == "x" && v.tags[1] == "y"
			assert v.flags.len() == 2
			assert v.flags[0] && !v.flags[1]
			assert v.fs.len() == 2
			assert v.fs[1] == 2.5
		}

		@test()
		def decodesEmptyArray() {
			let enc = new JSON()
			let v = JSONArrays{nums: [9, 9]}
			assert !(enc.decode("{\"nums\":[]}", v) is error)
			assert v.nums.len() == 0
		}

		@test()
		def decodesArraysOfNarrowElements() {
			let enc = new JSON()
			let v = JSONNarrowArrays{}
			assert !(enc.decode("{\"small\":[-300,300],\"bytes\":[7,255],\"singles\":[1.5,2.5]}", v) is error)
			// Values past the first catch a wrong element stride, which the
			// first element alone would hide.
			assert v.small[0] == int16(-300) && v.small[1] == int16(300)
			assert v.bytes[0] == uint8(7) && v.bytes[1] == uint8(255)
			assert v.singles[0] == float32(1.5) && v.singles[1] == float32(2.5)
		}

		@test()
		def roundTripsArrays() {
			let enc = new JSON()
			let src = JSONArrays{nums: [4, 5], tags: ["a", "b", "c"], flags: [false, true], fs: [0.25]}
			let dst = JSONArrays{}
			assert !(enc.decode(string(enc.encode(src)), dst) is error)
			assert dst.nums.len() == 2 && dst.nums[1] == 5
			assert dst.tags.len() == 3 && dst.tags[2] == "c"
			assert dst.flags.len() == 2 && dst.flags[1]
			assert dst.fs.len() == 1 && dst.fs[0] == 0.25
		}

		@test()
		def encodesNestedObject() {
			let enc = new JSON()
			let got = string(enc.encode(JSONNested{name: "ann", addr: JSONAddress{city: "Oslo", zip: 1234}}))
			// Annotations apply at every level, not only the outermost.
			assert got == "{\"name\":\"ann\",\"home\":{\"city_name\":\"Oslo\",\"zip\":1234}}"
		}

		@test()
		def decodesNestedObject() {
			let enc = new JSON()
			let v = JSONNested{}
			assert !(enc.decode("{\"name\":\"ann\",\"home\":{\"city_name\":\"Oslo\",\"zip\":1234}}", v) is error)
			assert v.name == "ann"
			assert v.addr.city == "Oslo"
			assert v.addr.zip == 1234
		}

		@test()
		def decodesNestedObjectBeforeItsSiblings() {
			// The nested value has to leave the cursor where the outer object
			// resumes, or the key after it is misread.
			let enc = new JSON()
			let v = JSONNested{}
			assert !(enc.decode("{\"home\":{\"zip\":9},\"name\":\"z\"}", v) is error)
			assert v.addr.zip == 9
			assert v.name == "z"
		}

		@test()
		def decodeSkipsUnknownKeysInsideNestedObjects() {
			let enc = new JSON()
			let v = JSONNested{}
			assert !(enc.decode("{\"home\":{\"other\":{\"deep\":1},\"zip\":3}}", v) is error)
			assert v.addr.zip == 3
		}

		@test()
		def roundTripsTwoLevelsOfNesting() {
			let enc = new JSON()
			let src = JSONDeep{inner: JSONNested{name: "n", addr: JSONAddress{city: "Rome", zip: 7}}}
			let dst = JSONDeep{}
			assert !(enc.decode(string(enc.encode(src)), dst) is error)
			assert dst.inner.name == "n"
			assert dst.inner.addr.city == "Rome"
			assert dst.inner.addr.zip == 7
		}

		@test()
		def decodeRefusesInputNestedDeeperThanMaxDepth() {
			let enc = new JSON(maxDepth: 2)
			assert enc.decode("{\"inner\":{\"home\":{\"zip\":1}}}", JSONDeep{}) is error
		}

		@test()
		def decodeRefusesAnObjectInAScalarField() {
			let enc = new JSON()
			assert enc.decode("{\"name\":{\"x\":1}}", JSONNested{}) is error
		}

		@test()
		def descendsIntoFieldsDeclaredWithType() {
			let enc = new JSON()
			let src = JSONTypeHolder{addr: JSONTypeAddress{city: "Oslo"}, home: JSONAddress{city: "Rome", zip: 7}}
			assert string(enc.encode(src)) == "{\"addr\":{\"city\":\"Oslo\"},\"home\":{\"city_name\":\"Rome\",\"zip\":7}}"

			let dst = JSONTypeHolder{}
			assert !(enc.decode(string(enc.encode(src)), dst) is error)
			assert dst.addr.city == "Oslo"
			assert dst.home.city == "Rome"
			assert dst.home.zip == 7
			// The decoded value is a working instance, not a bag of fields.
			assert dst.addr.label() == "Oslo"
		}

		@test()
		def selfEncodingTypeBypassesReflection() {
			let enc = new JSON()
			let got = string(enc.encode(JSONSelfEncoded{ignored: 99}))
			assert got == "{\"custom\":true}"
			// If reflection had run, the field would be here.
			assert !got.contains("ignored")
		}

		@test()
		def isValidChecksTheGrammar() {
			let codec = new JSON()
			assert codec.isValid("\{\"a\": [1, 2.5e3, true, null, \"x\\n\"]}")
			assert codec.isValid("  42 ")
			assert codec.isValid("\"text\"")
			assert codec.isValid("[]")
			assert !codec.isValid("")
			assert !codec.isValid("\{\"a\": 1,}")
			assert !codec.isValid("[1 2]")
			assert !codec.isValid("\{a: 1}")
			assert !codec.isValid("01")
			assert !codec.isValid("1.")
			assert !codec.isValid("+1")
			assert !codec.isValid("tru")
			assert !codec.isValid("\{\"a\": 1} x")
			assert !codec.isValid("\"unterminated")
		}
	}
}
