partial module std.data.encoding.jsonschema {
	use std.text.unicode

	// JSON Schema patterns are ECMA-262 regular expressions with Unicode
	// semantics; this validator runs them on ADM's RE2 engine. ecmaToRE2
	// reads ECMA-262 syntax (as `new RegExp(p, "u")` does) and writes the RE2
	// pattern that means the same: `\s` and `\S` with ECMA's whitespace,
	// `.` without the line terminators, `\cX`, `\u{…}` and surrogate pairs,
	// `[]` and `[^]`, `(?<name>`, long property names (`\p{Letter}`).

	// The translation of an ECMA-262 pattern: the RE2 pattern, and whether it
	// uses what RE2 cannot run (lookaround, backreferences).
	internal struct EcmaPattern {
		re2        string
		backtracks bool
	}

	// ECMA-262 WhiteSpace and LineTerminator (\s), as RE2 class content.
	internal const ecmaSpaces = "\\t\\n\\x\{0B\}\\f\\r \\x\{A0\}\\x\{1680\}\\x\{2000\}-\\x\{200A\}\\x\{2028\}\\x\{2029\}\\x\{202F\}\\x\{205F\}\\x\{3000\}\\x\{FEFF\}"
	// The complement of ecmaSpaces over all code points.
	internal const ecmaNonSpaces = "\\x\{0\}-\\x\{8\}\\x\{E\}-\\x\{1F\}\\x\{21\}-\\x\{9F\}\\x\{A1\}-\\x\{167F\}\\x\{1681\}-\\x\{1FFF\}\\x\{200B\}-\\x\{2027\}\\x\{202A\}-\\x\{202E\}\\x\{2030\}-\\x\{205E\}\\x\{2060\}-\\x\{2FFF\}\\x\{3001\}-\\x\{FEFE\}\\x\{FF00\}-\\x\{10FFFF\}"

	// General_Category long names (and the aliases ECMA accepts) as RE2's
	// short ones.
	internal const ecmaCategories = map<string, string>{
		"Letter":      "L", "Cased_Letter": "LC", "Uppercase_Letter": "Lu", "Lowercase_Letter": "Ll", "Titlecase_Letter": "Lt", "Modifier_Letter": "Lm", "Other_Letter": "Lo",
		"Mark":        "M", "Combining_Mark": "M", "Nonspacing_Mark": "Mn", "Spacing_Mark": "Mc", "Enclosing_Mark": "Me",
		"Number":      "N", "Decimal_Number": "Nd", "digit": "Nd", "Letter_Number": "Nl", "Other_Number": "No",
		"Punctuation": "P", "punct": "P", "Connector_Punctuation": "Pc", "Dash_Punctuation": "Pd", "Open_Punctuation": "Ps", "Close_Punctuation": "Pe", "Initial_Punctuation": "Pi", "Final_Punctuation": "Pf", "Other_Punctuation": "Po",
		"Symbol":      "S", "Math_Symbol": "Sm", "Currency_Symbol": "Sc", "Modifier_Symbol": "Sk", "Other_Symbol": "So",
		"Separator":   "Z", "Space_Separator": "Zs", "Line_Separator": "Zl", "Paragraph_Separator": "Zp",
		"Other":       "C", "Control": "Cc", "cntrl": "Cc", "Format": "Cf", "Surrogate": "Cs", "Private_Use": "Co", "Unassigned": "Cn",
	}

	// Reads an ECMA-262 pattern (Unicode mode). Fails with a SchemaError
	// (Invalid) on syntax ECMA-262 does not allow.
	internal def ecmaToRE2(pattern string) !EcmaPattern {
		let cps = unicode.codePoints(pattern).mapElem(c => int(c))
		let out byte[] = []
		let backtracks = false
		let i = 0
		let depth = 0
		// Whether the last atom can take a quantifier.
		let atom = false
		let groupNames string[] = []
		for i < cps.len() {
			let c = cps[i]
			if c == 0x5C {
				let (text, size, kind) = try ecmaEscape(cps, i, false)
				out += text.bytes()
				backtracks = true when kind == 2
				atom = kind != 3
				i += size
				continue
			}
			if c == 0x5B {
				let (text, size) = try ecmaClass(cps, i)
				out += text.bytes()
				atom = true
				i += size
				continue
			}
			if c == 0x28 {
				let rest = ecmaSlice(cps, i + 1, i + 4)
				depth++
				atom = false
				if rest.startsWith("?:") {
					out += "(?:".bytes()
					i += 3
				} else if rest.startsWith("?=") || rest.startsWith("?!") {
					backtracks = true
					out += "(?:".bytes()
					i += 3
				} else if rest.startsWith("?<=") || rest.startsWith("?<!") {
					backtracks = true
					out += "(?:".bytes()
					i += 4
				} else if rest.startsWith("?<") {
					let close = i + 3
					for close < cps.len() && cps[close] != 0x3E {
						close++
					}
					fail ecmaError(pattern, "an unterminated group name") when close >= cps.len()
					let name = ecmaSlice(cps, i + 3, close)
					fail ecmaError(pattern, "\"{name}\" is not a group name") unless /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name)
					fail ecmaError(pattern, "the group name \"{name}\" is used twice") when groupNames.includes(name)
					groupNames.push(name)
					out += ("(?P<" + name.replace("$", "_d_", -1) + ">").bytes()
					i = close + 1
				} else if rest.startsWith("?") {
					// ES2025 modifiers `(?ims-ims:…)`; a global `(?i)` is not ECMA.
					let close = i + 2
					for close < cps.len() && cps[close] != 0x3A && cps[close] != 0x29 {
						close++
					}
					fail ecmaError(pattern, "an unterminated group") when close >= cps.len()
					fail ecmaError(pattern, "an inline flag group is not ECMA-262") unless cps[close] == 0x3A
					let flags = ecmaSlice(cps, i + 2, close)
					fail ecmaError(pattern, "\"(?{flags}:\" is not a modifier group") unless /^[ims]*(-[ims]+)?$/.test(flags) && flags != ""
					out += "(?{flags}:".bytes()
					i = close + 1
				} else {
					out.push(0x28)
					i++
				}
				continue
			}
			if c == 0x29 {
				fail ecmaError(pattern, "an unmatched )") when depth == 0
				depth--
				out.push(0x29)
				atom = true
				i++
				continue
			}
			if c := 0x2A || 0x2B || 0x3F || 0x7B {
				let (size, text) = try ecmaQuantifier(cps, i, pattern)
				fail ecmaError(pattern, "a quantifier with nothing to repeat") unless atom
				out += text.bytes()
				i += size
				if i < cps.len() && cps[i] == 0x3F {
					out.push(0x3F)
					i++
				}
				atom = false
				continue
			}
			if c := 0x7D || 0x5D {
				fail ecmaError(pattern, "a lone {string(char(c))}")
			}
			if c == 0x2E {
				out += "[^\\n\\r\\x\{2028\}\\x\{2029\}]".bytes()
				atom = true
				i++
				continue
			}
			if c := 0x5E || 0x24 || 0x7C {
				out.push(byte(c))
				atom = false
				i++
				continue
			}
			out += string(char(c)).bytes()
			atom = true
			i++
		}
		fail ecmaError(pattern, "an unterminated group") when depth > 0
		return EcmaPattern{re2: string(out), backtracks: backtracks}
	}

	// A quantifier at i: its length and its RE2 text.
	internal def ecmaQuantifier(cps int[], i int, pattern string) !(int, string) {
		let c = cps[i]
		return (1, string(char(c))) unless c == 0x7B
		let close = i + 1
		for close < cps.len() && cps[close] != 0x7D {
			close++
		}
		fail ecmaError(pattern, "a lone \{") when close >= cps.len()
		let body = ecmaSlice(cps, i + 1, close)
		fail ecmaError(pattern, "\"\{{body}\}\" is not a quantifier") unless /^[0-9]+(,[0-9]*)?$/.test(body)
		let parts = body.split(",")
		let low = parseInt<int>(parts[0])
		if parts.len() > 1 && parts[1] != "" {
			fail ecmaError(pattern, "the quantifier \{{body}\} is out of order") when parseInt<int>(parts[1]) < low
		}
		return (close - i + 1, "\{" + body + "\}")
	}

	// An escape at i: its RE2 text, its length and its kind (0 a character
	// or class, 1 an assertion, 2 a backreference, 3 not an atom).
	internal def ecmaEscape(cps int[], i int, inClass bool) !(string, int, int) {
		let pattern = ecmaSlice(cps, 0, cps.len())
		fail ecmaError(pattern, "a trailing backslash") when i + 1 >= cps.len()
		let c = cps[i + 1]
		switch c {
			case 0x64, 0x44, 0x77, 0x57:
				return ("\\" + string(char(c)), 2, 0)
			case 0x73:
				return (inClass ?? (ecmaSpaces, "[" + ecmaSpaces + "]"), 2, 0)
			case 0x53:
				return (inClass ?? (ecmaNonSpaces, "[" + ecmaNonSpaces + "]"), 2, 0)
			case 0x62, 0x42:
				return ("\\x\{8\}", 2, 0) when inClass && c == 0x62
				fail ecmaError(pattern, "\\B in a class") when inClass
				return ("\\" + string(char(c)), 2, 1)
			case 0x74:
				return ("\\t", 2, 0)
			case 0x6E:
				return ("\\n", 2, 0)
			case 0x76:
				return ("\\x\{0B\}", 2, 0)
			case 0x66:
				return ("\\f", 2, 0)
			case 0x72:
				return ("\\r", 2, 0)
			case 0x30:
				fail ecmaError(pattern, "\\0 followed by a digit") when i + 2 < cps.len() && cps[i + 2] >= 0x30 && cps[i + 2] <= 0x39
				return ("\\x\{0\}", 2, 0)
			case 0x63:
				fail ecmaError(pattern, "\\c without a letter") unless i + 2 < cps.len() && ((cps[i + 2] >= 0x41 && cps[i + 2] <= 0x5A) || (cps[i + 2] >= 0x61 && cps[i + 2] <= 0x7A))
				return ("\\x\{" + "%X".format(cps[i + 2] % 32) + "\}", 3, 0)
			case 0x78:
				let hex = ecmaSlice(cps, i + 2, i + 4)
				fail ecmaError(pattern, "\\x without two hex digits") unless /^[0-9A-Fa-f]{2}$/.test(hex)
				return ("\\x\{" + hex + "\}", 4, 0)
			case 0x75:
				if i + 2 < cps.len() && cps[i + 2] == 0x7B {
					let close = i + 3
					for close < cps.len() && cps[close] != 0x7D {
						close++
					}
					let hex = ecmaSlice(cps, i + 3, close)
					fail ecmaError(pattern, "\\u\{…\} without hex digits") unless close < cps.len() && /^[0-9A-Fa-f]+$/.test(hex) && parseInt<int>(hex, 16) <= 0x10FFFF
					return ("\\x\{" + hex + "\}", close - i + 1, 0)
				}
				let hex = ecmaSlice(cps, i + 2, i + 6)
				fail ecmaError(pattern, "\\u without four hex digits") unless /^[0-9A-Fa-f]{4}$/.test(hex)
				let unit = parseInt<int>(hex, 16)
				if unit >= 0xD800 && unit <= 0xDBFF && i + 11 < cps.len() + 0 && ecmaSlice(cps, i + 6, i + 8) == "\\u" {
					let low = ecmaSlice(cps, i + 8, i + 12)
					if /^[0-9A-Fa-f]{4}$/.test(low) {
						let lowUnit = parseInt<int>(low, 16)
						if lowUnit >= 0xDC00 && lowUnit <= 0xDFFF {
							let cp = 0x10000 + ((unit - 0xD800) << 10) + (lowUnit - 0xDC00)
							return ("\\x\{" + "%X".format(cp) + "\}", 12, 0)
						}
					}
				}
				return ("\\x\{" + hex + "\}", 6, 0)
			case 0x70, 0x50:
				fail ecmaError(pattern, "\\p without a property") unless i + 2 < cps.len() && cps[i + 2] == 0x7B
				let close = i + 3
				for close < cps.len() && cps[close] != 0x7D {
					close++
				}
				fail ecmaError(pattern, "an unterminated \\p\{") when close >= cps.len()
				let name = ecmaSlice(cps, i + 3, close)
				let re2 = try ecmaProperty(name, pattern)
				return ("\\" + string(char(c)) + "\{" + re2 + "\}", close - i + 1, 0)
			case 0x6B:
				fail ecmaError(pattern, "\\k without a group name") unless i + 2 < cps.len() && cps[i + 2] == 0x3C
				let close = i + 3
				for close < cps.len() && cps[close] != 0x3E {
					close++
				}
				fail ecmaError(pattern, "an unterminated \\k<") when close >= cps.len()
				return ("(?:)", close - i + 1, 2)
			default:
				if c >= 0x31 && c <= 0x39 {
					fail ecmaError(pattern, "a backreference in a class") when inClass
					let end = i + 1
					for end < cps.len() && cps[end] >= 0x30 && cps[end] <= 0x39 {
						end++
					}
					return ("(?:)", end - i, 2)
				}
				// Unicode mode allows only syntax characters, `/` and (in a
				// class) `-` to be escaped.
				let syntax = "^$\\.*+?()[]\{\}|/"
				return ("\\" + string(char(c)), 2, 0) when syntax.contains(string(char(c))) || (inClass && c == 0x2D)
				fail ecmaError(pattern, "\\{string(char(c))} is not an escape of ECMA-262")
		}
	}

	// A Unicode property of \p{…}: a General_Category (long or short
	// name, `General_Category=`/`gc=` prefix allowed) or a script
	// (`Script=`/`sc=`/`Script_Extensions=`/`scx=`).
	internal def ecmaProperty(name string, pattern string) !string {
		let eq = name.indexOf("=")
		if eq >= 0 {
			let key = name[0:eq]
			let value = name[eq + 1:]
			if key := "General_Category" || "gc" {
				return try ecmaProperty(value, pattern)
			}
			fail ecmaError(pattern, "\\p\{{name}\} is not a property RE2 knows") unless key := "Script" || "sc" || "Script_Extensions" || "scx"
			fail ecmaError(pattern, "\\p\{{name}\} names no script") unless /^[A-Za-z_]+$/.test(value)
			return value
		}
		let mapped = ecmaCategories.get(name)
		return mapped unless mapped is none
		return name when /^(L|LC|Lu|Ll|Lt|Lm|Lo|M|Mn|Mc|Me|N|Nd|Nl|No|P|Pc|Pd|Ps|Pe|Pi|Pf|Po|S|Sm|Sc|Sk|So|Z|Zs|Zl|Zp|C|Cc|Cf|Cs|Co|Cn)$/.test(name)
		return "Any" when name == "Any"
		fail ecmaError(pattern, "\\p\{{name}\} is not a property this validator knows")
	}

	// A class at i: its RE2 text and its length.
	internal def ecmaClass(cps int[], i int) !(string, int) {
		let pattern = ecmaSlice(cps, 0, cps.len())
		let j = i + 1
		let negated = j < cps.len() && cps[j] == 0x5E
		j++ when negated
		let items byte[] = []
		// The previous item's code point, for ranges; -1 after a class
		// escape.
		let prev = -1
		let pendingRange = false
		let bare = true
		for j < cps.len() && cps[j] != 0x5D {
			bare = false
			let c = cps[j]
			let cp = -1
			let text = ""
			if c == 0x5C {
				let (escaped, size, _) = try ecmaEscape(cps, j, true)
				text = escaped
				cp = ecmaCodePoint(cps, j, size)
				j += size
			} else {
				cp = c
				text = (c := 0x5B || 0x5E || 0x2D) ?? ("\\" + string(char(c)), string(char(c)))
				text = string(char(c)) when c == 0x2D && !pendingRange && (j + 1 >= cps.len() || cps[j + 1] == 0x5D || prev < 0)
				j++
			}
			if pendingRange {
				fail ecmaError(pattern, "a range with a class escape") when cp < 0 || prev < 0
				fail ecmaError(pattern, "the range is out of order") when cp < prev
				pendingRange = false
				items += text.bytes()
				prev = -1
				continue
			}
			if c == 0x2D && prev >= 0 && j < cps.len() && cps[j] != 0x5D {
				items += "-".bytes()
				pendingRange = true
				continue
			}
			items += text.bytes()
			prev = cp
		}
		fail ecmaError(pattern, "an unterminated class") when j >= cps.len()
		let size = j - i + 1
		return (negated ?? ("[\\x\{0\}-\\x\{10FFFF\}]", "[^\\x\{0\}-\\x\{10FFFF\}]"), size) when bare
		return ((negated ?? ("[^", "[")) + string(items) + "]", size)
	}

	// The code point an escape of `size` at i stands for, -1 for a class
	// escape (\d, \s, \p…).
	internal def ecmaCodePoint(cps int[], i int, size int) int {
		let c = cps[i + 1]
		return -1 when c := 0x64 || 0x44 || 0x77 || 0x57 || 0x73 || 0x53 || 0x70 || 0x50
		switch c {
			case 0x74:
				return 9
			case 0x6E:
				return 10
			case 0x76:
				return 11
			case 0x66:
				return 12
			case 0x72:
				return 13
			case 0x30:
				return 0
			case 0x62:
				return 8
			case 0x63:
				return cps[i + 2] % 32
			case 0x78:
				return parseInt<int>(ecmaSlice(cps, i + 2, i + 4), 16)
			case 0x75:
				return parseInt<int>(ecmaSlice(cps, i + 3, i + size - 1), 16) when cps[i + 2] == 0x7B
				let unit = parseInt<int>(ecmaSlice(cps, i + 2, i + 6), 16)
				return size == 12 ?? (0x10000 + ((unit - 0xD800) << 10) + (parseInt<int>(ecmaSlice(cps, i + 8, i + 12), 16) - 0xDC00), unit)
			default:
				return c
		}
	}

	internal def ecmaSlice(cps int[], from int, to int) string {
		let out byte[] = []
		let end = to < cps.len() ?? (to, cps.len())
		for let k = from; k < end; k++ {
			out += string(char(cps[k])).bytes()
		}
		return string(out)
	}

	internal def ecmaError(pattern string, problem string) SchemaError {
		return invalidSchema("", "\"{pattern}\" is not an ECMA-262 regular expression: {problem}")
	}

	// Whether text is a regular expression of ECMA-262 (the `regex`
	// format): its syntax, including lookaround and backreferences.
	internal def isEcmaRegex(text string) bool {
		let translated = ecmaToRE2(text) onerror recover EcmaPattern{re2: "(", backtracks: false}
		return new regex(translated.re2, "").valid()
	}
}
