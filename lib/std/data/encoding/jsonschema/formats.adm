partial module std.data.encoding.jsonschema {
	use (
		std.text.unicode
		std.text.idna
		std.text.idna::(IDNAOptions)
	)

	// Why a string is not of a format, "" when it is or the format is one
	// this validator does not know (JSON Schema 2020-12 §7.3; values that
	// are not strings always pass). The integer widths of the OpenAPI
	// Format Registry, `int32` and `int64`, apply to numbers instead.
	internal def formatProblem(format string, instance any, draft Draft) string {
		if format := "int32" || "int64" {
			return integerWidthProblem(format, instance)
		}
		if instance is byte[] {
			return formatProblem(format, string(instance), draft) when instance.indexOf(byte(0)) < 0
			return bytesFormatProblem(format, instance, draft)
		}
		return "" unless instance is string
		let fits = true
		match format {
			case "date-time":
				fits = isDateTime(instance)
			case "date":
				fits = isDate(instance)
			case "time":
				fits = isTime(instance)
			case "duration":
				fits = durationPattern.test(instance)
			case "email":
				fits = isEmail(instance, false)
			case "idn-email":
				fits = isEmail(instance, true)
			case "hostname":
				// Before draft 7 a host name is RFC 1123 only, with no
				// A-label checks.
				fits = draft.value <= Draft.Draft6.value ?? (isLDHName(instance), isHostname(instance))
			case "idn-hostname":
				fits = isIdnHostname(instance)
			case "ipv4":
				fits = isIPv4(instance)
			case "ipv6":
				fits = isIPv6(instance)
			case "uri":
				fits = isURI(instance, iri = false, reference = false)
			case "uri-reference":
				fits = isURI(instance, iri = false, reference = true)
			case "iri":
				fits = isURI(instance, iri = true, reference = false)
			case "iri-reference":
				fits = isURI(instance, iri = true, reference = true)
			case "uuid":
				fits = uuidPattern.test(instance)
			case "uri-template":
				fits = isURITemplate(instance)
			case "json-pointer":
				fits = isJSONPointer(instance)
			case "relative-json-pointer":
				fits = isRelativeJSONPointer(instance)
			case "regex":
				fits = isEcmaRegex(instance)
			default:
				return ""
		}
		return fits ?? ("", "{describe(instance)} is not a valid {format}")
	}

	// The format check of UTF-8 text holding U+0000, which a string
	// cannot carry. JSON Pointers and ECMA-262 patterns take it as an
	// ordinary character, and U+0001 falls in the same class at every place
	// of their grammars (unescaped pointer text; a pattern character, an
	// identity escape, a `\c` operand), so the text is checked with it in
	// U+0000's place. Every other format this validator knows excludes
	// control characters.
	internal def bytesFormatProblem(format string, instance byte[], draft Draft) string {
		if format := "json-pointer" || "relative-json-pointer" || "regex" {
			let stand = instance.mapElem(b => int(b) == 0 ?? (byte(1), b))
			return formatProblem(format, string(stand), draft) == "" ?? ("", "{describe(instance)} is not a valid {format}")
		}
		return "" unless knownFormats.includes(format)
		return "{describe(instance)} is not a valid {format}"
	}

	internal const knownFormats = ["date-time", "date", "time", "duration", "email", "idn-email", "hostname", "idn-hostname", "ipv4", "ipv6", "uri", "uri-reference", "iri", "iri-reference", "uuid", "uri-template"]

	internal const durationPattern = /^P(?:(?:[0-9]+Y(?:[0-9]+M(?:[0-9]+D)?)?|[0-9]+M(?:[0-9]+D)?|[0-9]+D)(?:T(?:[0-9]+H(?:[0-9]+M(?:[0-9]+S)?)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S))?|T(?:[0-9]+H(?:[0-9]+M(?:[0-9]+S)?)?|[0-9]+M(?:[0-9]+S)?|[0-9]+S)|[0-9]+W)$/
	internal const uuidPattern = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/
	internal const datePattern = /^([0-9]{4})-([0-9]{2})-([0-9]{2})$/
	internal const timePattern = /^([0-9]{2}):([0-9]{2}):([0-9]{2})(\.[0-9]+)?([Zz]|([+-])([0-9]{2}):([0-9]{2}))$/

	// RFC 3339 full-date: a real day of a real month.
	internal def isDate(text string) bool {
		let m = datePattern.find(text, 0)
		return false when m is none
		let year = parseInt<int>(m.groups[0])
		let month = parseInt<int>(m.groups[1])
		let day = parseInt<int>(m.groups[2])
		return false unless month >= 1 && month <= 12 && day >= 1
		let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
		let days = [31, leap ?? (29, 28), 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
		return day <= days[month - 1]
	}

	// RFC 3339 full-time with its offset; a leap second only at 23:59 UTC.
	internal def isTime(text string) bool {
		let m = timePattern.find(text, 0)
		return false when m is none
		let hour = parseInt<int>(m.groups[0])
		let minute = parseInt<int>(m.groups[1])
		let second = parseInt<int>(m.groups[2])
		return false unless hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59 && second >= 0 && second <= 60
		let offsetHours = 0
		let offsetMinutes = 0
		if m.groups[5] != "" {
			offsetHours = parseInt<int>(m.groups[6])
			offsetMinutes = parseInt<int>(m.groups[7])
			return false unless offsetHours <= 23 && offsetMinutes <= 59
			if m.groups[5] == "-" {
				offsetHours = -offsetHours
				offsetMinutes = -offsetMinutes
			}
		}
		if second == 60 {
			let utc = ((hour * 60 + minute - offsetHours * 60 - offsetMinutes) % 1440 + 1440) % 1440
			return utc == 23 * 60 + 59
		}
		return true
	}

	internal def isDateTime(text string) bool {
		let at = text.indexOf("T")
		at = text.indexOf("t") when at < 0
		return false when at < 0
		return isDate(text[0:at]) && isTime(text[at + 1:])
	}

	// RFC 5321 Mailbox (RFC 6531 with idn): a dot-string or quoted local
	// part of at most 64 octets, `@`, and a host name or an address
	// literal.
	internal def isEmail(text string, idn bool) bool {
		let b = text.bytes()
		let at = -1
		if b.len() > 0 && b[0] == 34 {
			// A quoted local part: up to its closing quote.
			let i = 1
			let closed = false
			for i < b.len() {
				let c = b[i]
				if c == 92 {
					return false when i + 1 >= b.len()
					let next = b[i + 1]
					return false unless (next >= 32 && next <= 126) || (idn && next >= 0x80)
					i += 2
					continue
				}
				if c == 34 {
					closed = true
					break
				}
				return false unless (c >= 32 && c <= 126 && c != 92) || (idn && (c >= 0x80 || c < 32))
				i++
			}
			return false unless closed && i + 1 < b.len() && b[i + 1] == 64
			at = i + 1
		} else {
			for let (i, c) in b {
				if c == 64 {
					at = i
					break
				}
			}
			return false when at <= 0
			let local = string(b[0:at])
			return false when local.startsWith(".") || local.endsWith(".") || local.contains("..")
			for let c in local.bytes() {
				continue when idn && c >= 0x80
				return false unless isAText(c) || c == 46
			}
		}
		return false when at > 64
		let domain = string(b[at + 1:])
		return false when domain == ""
		if domain.startsWith("[") && domain.endsWith("]") {
			let literal = domain[1:domain.len() - 1]
			return isIPv6(literal[5:]) when literal.lower().startsWith("ipv6:")
			return isIPv4(literal)
		}
		return idn ?? (isIdnHostname(domain), isHostname(domain))
	}

	internal def isAText(c byte) bool {
		return (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) || (c >= 0x30 && c <= 0x39) || "!#$%&'*+-/=?^_`\{|\}~".bytes().includes(c)
	}

	// An RFC 1123 host name: letters, digits and hyphens in labels of 1 to
	// 63 octets, 253 in all; an `xn--` label must be a valid A-label.
	internal def isHostname(text string) bool {
		return false when text == "" || text.len() > 253
		for let label in text.split(".") {
			return false when label == "" || label.len() > 63
			return false when label.startsWith("-") || label.endsWith("-")
			for let c in label.bytes() {
				return false unless (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) || (c >= 0x30 && c <= 0x39) || c == 0x2D
			}
			if label.len() >= 4 && label[2:4] == "--" {
				return false unless label.lower().startsWith("xn--")
				let u = idna.toUnicode(label, IDNAOptions{strict: true}) onerror recover ""
				return false when u == ""
				let back = idna.toASCII(u, IDNAOptions{strict: true}) onerror recover ""
				return false unless back == label.lower()
			}
		}
		return true
	}

	// An RFC 1123 host name: labels of letters, digits and hyphens.
	internal def isLDHName(text string) bool {
		return false when text == "" || text.len() > 253
		for let label in text.split(".") {
			return false when label == "" || label.len() > 63 || label.startsWith("-") || label.endsWith("-")
			for let c in label.bytes() {
				return false unless (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) || (c >= 0x30 && c <= 0x39) || c == 0x2D
			}
		}
		return true
	}

	// An internationalized host name: what IDNA2008 registration accepts
	// after UTS #46 mapping.
	internal def isIdnHostname(text string) bool {
		return false when text == "" || text.endsWith(".") || text.endsWith("。")
		let ascii = idna.toASCII(text, IDNAOptions{strict: true}) onerror recover ""
		return ascii != ""
	}

	internal def isIPv4(text string) bool {
		let parts = text.split(".")
		return false when parts.len() != 4
		for let p in parts {
			return false when p == "" || p.len() > 3 || (p.len() > 1 && p.startsWith("0"))
			for let c in p.bytes() {
				return false unless c >= 0x30 && c <= 0x39
			}
			let n = parseInt<int>(p)
			return false when n > 255
		}
		return true
	}

	internal def isIPv6(text string) bool {
		return false when text == "" || text.contains(":::")
		let halves = text.split("::")
		return false when halves.len() > 2
		let groups = 0
		let sides = halves.len() == 2 ?? (halves, [text])
		for let (side, half) in sides {
			continue when half == ""
			let parts = half.split(":")
			for let (i, p) in parts {
				let lastOfAll = side == sides.len() - 1 && i == parts.len() - 1
				if lastOfAll && p.contains(".") {
					return false unless isIPv4(p)
					groups += 2
					continue
				}
				return false when p == "" || p.len() > 4
				for let c in p.bytes() {
					return false unless (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66)
				}
				groups++
			}
		}
		return halves.len() == 2 ?? (groups <= 7, groups == 8)
	}

	// RFC 3986 URI (and RFC 3987 IRI): scheme, authority, path, query and
	// fragment each of its characters; a reference may leave the scheme
	// out.
	internal def isURI(text string, iri bool, reference bool) bool {
		let rest = text
		let colon = rest.indexOf(":")
		let firstDelimiter = firstOf(rest, "/?#")
		let hasScheme = colon > 0 && colon < firstDelimiter
		if hasScheme {
			let scheme = rest[0:colon]
			return false unless /^[A-Za-z][A-Za-z0-9+.-]*$/.test(scheme)
			rest = rest[colon + 1:]
		} else {
			return false unless reference
			// A relative reference's first segment has no colon.
			let slash = firstOf(rest, "/?#")
			return false when rest.indexOf(":") >= 0 && rest.indexOf(":") < slash
		}
		let fragment = ""
		let hash = rest.indexOf("#")
		if hash >= 0 {
			fragment = rest[hash + 1:]
			rest = rest[0:hash]
			return false unless uriChars(fragment, iri, "/?:@", false)
		}
		let query = rest.indexOf("?")
		if query >= 0 {
			return false unless uriChars(rest[query + 1:], iri, "/?:@", true)
			rest = rest[0:query]
		}
		if rest.startsWith("//") {
			let end = firstOf(rest[2:], "/")
			let authority = rest[2:2 + end]
			rest = rest[2 + end:]
			return false unless isAuthority(authority, iri)
		}
		return uriChars(rest, iri, "/:@", false)
	}

	// The index of the first of the delimiters in text, its length when
	// there is none.
	internal def firstOf(text string, delimiters string) int {
		let first = text.len()
		for let (_, d) in delimiters {
			let at = text.indexOf(string(d))
			first = at when at >= 0 && at < first
		}
		return first
	}

	internal def isAuthority(authority string, iri bool) bool {
		let host = authority
		let at = -1
		for let (i, c) in authority.bytes() {
			at = i when c == 0x40
		}
		if at >= 0 {
			return false unless uriChars(authority[0:at], iri, ":", false)
			host = authority[at + 1:]
		}
		if host.startsWith("[") {
			let close = host.indexOf("]")
			return false when close < 0
			let literal = host[1:close]
			let after = host[close + 1:]
			return false unless after == "" || (after.startsWith(":") && /^[0-9]*$/.test(after[1:]))
			return isIPv6(literal) || /^[vV][0-9A-Fa-f]+\.[A-Za-z0-9._~!$&'()*+,;=:-]+$/.test(literal)
		}
		let colon = host.indexOf(":")
		if colon >= 0 {
			return false unless /^[0-9]*$/.test(host[colon + 1:])
			host = host[0:colon]
		}
		return uriChars(host, iri, "", false)
	}

	// Whether every character of text is allowed: unreserved, sub-delims,
	// the extra ones given, `%` with two hex digits; for an IRI also
	// ucschar, and iprivate in a query.
	internal def uriChars(text string, iri bool, extra string, query bool) bool {
		let b = text.bytes()
		let i = 0
		for i < b.len() {
			let c = b[i]
			if c == 0x25 {
				return false unless i + 2 < b.len() && isHexByte(b[i + 1]) && isHexByte(b[i + 2])
				i += 3
				continue
			}
			if c < 0x80 {
				let ok = (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) || (c >= 0x30 && c <= 0x39) || "-._~!$&'()*+,;=".bytes().includes(c) || extra.bytes().includes(c)
				return false unless ok
				i++
				continue
			}
			return false unless iri
			let n = utf8Width(c)
			return false when n == 0 || i + n > b.len()
			let cp = int(unicode.codePoints(string(b[i:i + n]))[0])
			return false unless isUCSChar(cp) || (query && isIPrivate(cp))
			i += n
		}
		return true
	}

	internal def isHexByte(c byte) bool {
		return (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66)
	}

	internal def utf8Width(lead byte) int {
		return 2 when lead >= 0xC2 && lead <= 0xDF
		return 3 when lead >= 0xE0 && lead <= 0xEF
		return 4 when lead >= 0xF0 && lead <= 0xF4
		return 0
	}

	// RFC 3987 ucschar.
	internal def isUCSChar(cp int) bool {
		return true when (cp >= 0xA0 && cp <= 0xD7FF) || (cp >= 0xF900 && cp <= 0xFDCF) || (cp >= 0xFDF0 && cp <= 0xFFEF)
		return false when cp < 0x10000 || cp > 0xEFFFD
		return (cp & 0xFFFF) <= 0xFFFD
	}

	// RFC 3987 iprivate.
	internal def isIPrivate(cp int) bool {
		return (cp >= 0xE000 && cp <= 0xF8FF) || (cp >= 0xF0000 && cp <= 0xFFFFD) || (cp >= 0x100000 && cp <= 0x10FFFD)
	}

	// RFC 6570 URI Template: literals and `{operator varspec, ...}`
	// expressions with names, `:max-length` (1–9999) or `*`.
	internal def isURITemplate(text string) bool {
		let b = text.bytes()
		let i = 0
		for i < b.len() {
			let c = b[i]
			if c == 0x7B {
				let close = i + 1
				for close < b.len() && b[close] != 0x7D {
					close++
				}
				return false when close >= b.len()
				return false unless isExpression(string(b[i + 1:close]))
				i = close + 1
				continue
			}
			return false when c == 0x7D
			if c == 0x25 {
				return false unless i + 2 < b.len() && isHexByte(b[i + 1]) && isHexByte(b[i + 2])
				i += 3
				continue
			}
			if c >= 0x80 {
				let n = utf8Width(c)
				return false when n == 0 || i + n > b.len()
				let cp = int(unicode.codePoints(string(b[i:i + n]))[0])
				return false unless isUCSChar(cp) || isIPrivate(cp)
				i += n
				continue
			}
			// Literal characters: any but CTL, SP, DQUOTE, %, <, >, \, ^, `, {, |, }.
			return false when c <= 0x20 || c == 0x7F || "\"<>\\^`|".bytes().includes(c)
			i++
		}
		return true
	}

	internal def isExpression(body string) bool {
		let text = body
		return false when text == ""
		if "+#./;?&=,!@|".contains(text[0:1]) {
			return false when "=,!@|".contains(text[0:1])
			text = text[1:]
		}
		for let spec in text.split(",") {
			return false unless /^(?:[A-Za-z0-9_]|%[0-9A-Fa-f]{2})(?:\.?(?:[A-Za-z0-9_]|%[0-9A-Fa-f]{2}))*(?::[1-9][0-9]{0,3}|\*)?$/.test(spec)
		}
		return true
	}

	// RFC 6901 JSON Pointer.
	internal def isJSONPointer(text string) bool {
		return /^(?:\/(?:[^~\/]|~[01])*)*$/.test(text)
	}

	// Relative JSON Pointer: a non-negative integer, then `#` or a JSON
	// Pointer.
	internal def isRelativeJSONPointer(text string) bool {
		let m = /^(0|[1-9][0-9]*)(.*)$/.find(text, 0)
		return false when m is none || text.contains("\n")
		let rest = m.groups[1]
		return rest == "#" || isJSONPointer(rest)
	}

	// Why a number does not fit a signed integer of 32 or 64 bits, ""
	// when it does or is not a number.
	internal def integerWidthProblem(format string, instance any) string {
		if instance is int {
			return "" unless format == "int32"
			return instance >= -2147483648 && instance <= 2147483647 ?? ("", "{instance} does not fit int32")
		}
		return "" unless instance is float
		return "{instance} is not an integer" unless instance == float(int(instance)) || instance * 0.0 != 0.0
		let limit = format == "int32" ?? (2147483648.0, 9223372036854775808.0)
		return instance >= -limit && instance < limit ?? ("", "{instance} does not fit {format}")
	}
}
