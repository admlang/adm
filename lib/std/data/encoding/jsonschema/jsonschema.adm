// JSON Schema (draft 2020-12) of ADM types and functions, and calls of
// functions with JSON arguments: what a program needs to offer its functions
// to a caller that speaks JSON (a language model's tool call, an MCP client,
// an RPC).
//
// ```
// let add = new jsonschema.Callable(fn)
// add.inputSchema()                       // {"type": "object", "properties": {"a": …, "b": …}, "required": ["a"]}
// let sum = try add.call({"a": 2, "b": 3})
// ```
partial module std.data.encoding.jsonschema {
	use (
		std.errors
		std.reflection
		std.reflection::(TypeDescriptor, TypeKind, FunctionDescriptor, FieldKind)
		std.data.encoding::(JSON, CaseStyle, JSONEncoder, JSONDecoder)
		std.data.encoding.json::(encodedKey, fieldFlag)
	)

	// Why a JSON value does not fit a type, or a call its function.
	enum SchemaErrorKind {
		// A required argument or value is absent.
		Missing,
		// The value has another JSON type than the ADM type takes, or is out
		// of its range.
		Mismatch,
		// A string that names no member of the enum.
		UnknownChoice,
		// The ADM type has no JSON form a value can be built from.
		Unsupported,
		// The schema compile was given is not one it can validate with.
		Invalid
	}

	// The error `valueOf` and `Callable.call` fail with when the JSON does not
	// fit. `path` names the argument or member at fault (`p.tags[2]`).
	struct SchemaError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    SchemaErrorKind
		path    string
	}

	// The JSON Schema of the type t describes.
	//
	//     string, char            {"type": "string"}
	//     bool                    {"type": "boolean"}
	//     integers                {"type": "integer"}, unsigned ones with "minimum": 0
	//     floats                  {"type": "number"}
	//     enum                    {"type": "string", "enum": [member names]}; inside a struct
	//                             {"type": "integer", "oneOf": [{"const": 0, "title": "Name"}, ...]},
	//                             the number the JSON codec reads and writes
	//     T[]                     {"type": "array", "items": schema of T}
	//     map<string, V>          {"type": "object", "additionalProperties": schema of V}
	//     tuple                   {"type": "array", "prefixItems": [...]}
	//     struct, type            {"type": "object", "properties": ..., "required": [...]}
	//     any, union, interface   {} (any value)
	//
	// A struct's properties are named as the JSON codec names them (`@json`
	// `name`, `ignore`); a field is required unless its type is optional, and
	// its doc comment is the property's description. A type that implements
	// `JSONEncoder` or `JSONDecoder` is `{}`. `?T` has the schema of T.
	def schemaOf(t TypeDescriptor) map<string, any> {
		return schemaAt(t, 0, false)
	}

	// A JSON value (as `JSON.parse` builds it) as a value of the type t
	// describes, boxed as `any`: what `reflection.invoke` takes as an
	// argument. A number given as text and a whole float are taken for an
	// integer, as callers that are language models send them. none is
	// returned for a null where t is optional.
	//
	// Fails with a SchemaError when the value does not fit.
	def valueOf(value any, t TypeDescriptor) !any {
		return try convert(value, t, "")
	}

	// One parameter of a Callable.
	struct Parameter {
		name        string
		// The text of the parameter's `@param name` doc tag.
		description string
		// False when the parameter has a default or an optional type.
		required    bool
		// The parameter's declared type.
		kind        TypeDescriptor
		// The JSON Schema of the parameter, with its description.
		schema      map<string, any>
	}

	// A function or a method described for callers that send JSON: its name,
	// its doc comment, its parameters as JSON Schema, and `call`, which runs
	// it with a JSON object of arguments.
	type Callable {
		// The function's declared name.
		name        string
		// The function's doc comment, without its tags.
		description string
		// The parameters a caller gives, in declaration order.
		parameters  Parameter[]
		// The declared result type.
		result      TypeDescriptor

		internal fn       FunctionDescriptor
		internal receiver any
		internal leading  int

		// Describes fn, an annotated function or method. A method runs on
		// receiver. The first `leading` parameters are not the caller's: they
		// are left out of `parameters` and given to `call` by the program.
		def new(fn FunctionDescriptor, receiver any = none, leading int = 0) {
			self.fn = fn
			self.receiver = receiver
			self.leading = leading
			name = fn.node.name
			description = fn.node.doc
			result = fn.signature.result
			for let (i, p) in fn.signature.parameters {
				continue when i < leading
				let schema = schemaOf(p.paramType)
				schema.set("description", p.node.doc) when p.node.doc.len() > 0
				parameters.push(Parameter{
					name:        p.node.name,
					description: p.node.doc,
					required:    p.defaultLiteral.len() == 0 && !p.paramType.optional,
					kind:        p.paramType,
					schema:      schema,
				})
			}
		}

		// The JSON Schema of the arguments object `call` takes.
		def inputSchema() map<string, any> {
			let properties = new map<string, any>()
			let required any[] = []
			for let (_, p) in parameters {
				properties.set(p.name, p.schema)
				required.push(p.name) when p.required
			}
			let out = map<string, any>{"type": "object", "properties": properties}
			out.set("required", required) when required.len() > 0
			return out
		}

		// The JSON Schema of the result when it is an object (a struct, a
		// type or a string-keyed map); none for every other result.
		def outputSchema() ?map<string, any> {
			return none unless result.kind := TypeKind.Struct || TypeKind.Datatype || TypeKind.Map
			return schemaOf(result)
		}

		// Runs the function. arguments is a JSON object as `JSON.parse`
		// builds it (none for no arguments); members that name no parameter
		// are ignored, and a parameter left out takes its default. leading
		// holds the values of the parameters `new` left out.
		//
		// Returns what the function returns. Fails with a SchemaError when an
		// argument is missing or does not fit its parameter, and with the
		// function's own error when it fails.
		def call(arguments any = none, leading any[] = []) !any {
			let args any[] = leading.clone()
			let declared = fn.signature.parameters
			for let (i, p) in declared {
				continue when i < self.leading
				let given = reflection.entryOf(arguments, p.node.name)
				if given is none {
					let made = reflection.defaultOf(fn, i, args)
					if made is none {
						fail schemaError(SchemaErrorKind.Missing, p.node.name, "is required") when p.defaultLiteral.len() == 0 && !p.paramType.optional
						args.push(none)
					} else {
						args.push(made)
					}
					continue
				}
				args.push(try convert(given, p.paramType, p.node.name))
			}
			let out = reflection.invoke(fn, receiver, args)
			fail out when out is error
			return out
		}
	}

	internal const maxSchemaDepth = 16

	// inStruct is set under a struct, where values have the form the JSON codec
	// reads and writes: an enum is its number.
	internal def schemaAt(t TypeDescriptor, depth int, inStruct bool) map<string, any> {
		let out = new map<string, any>()
		return out when depth > maxSchemaDepth
		match t.kind {
			case TypeKind.Primitive, TypeKind.Alias:
				let name = primitiveName(t)
				if name == "bool" {
					out.set("type", "boolean")
				} else if isSigned(name) {
					out.set("type", "integer")
				} else if isUnsigned(name) {
					out.set("type", "integer")
					out.set("minimum", 0)
				} else if isFloat(name) {
					out.set("type", "number")
				} else if name := "string" || "char" {
					out.set("type", "string")
				}
			case TypeKind.Enum:
				let choices any[] = []
				for let (_, m) in reflection.members(t) {
					if inStruct {
						choices.push(map<string, any>{"const": parseInt<int>(reflection.scalarText(m.value)), "title": m.node.name})
					} else {
						choices.push(m.node.name)
					}
				}
				out.set("type", inStruct ?? ("integer", "string"))
				out.set(inStruct ?? ("oneOf", "enum"), choices)
			case TypeKind.Array:
				out.set("type", "array")
				let element = t.element
				out.set("items", schemaAt(element, depth + 1, inStruct)) unless element is none
			case TypeKind.Map:
				out.set("type", "object")
				let element = t.element
				out.set("additionalProperties", schemaAt(element, depth + 1, inStruct)) unless element is none
			case TypeKind.Tuple:
				let items any[] = []
				for let (_, e) in t.elements {
					items.push(schemaAt(e, depth + 1, inStruct))
				}
				out.set("type", "array")
				out.set("prefixItems", items)
			case TypeKind.Struct, TypeKind.Datatype:
				out.set("type", "object")
				let sample = reflection.instantiate(t)
				return out when sample is none
				// A type with its own JSON form is whatever that form is.
				return new map<string, any>() when ownForm(sample)
				let properties = new map<string, any>()
				let required any[] = []
				for let (_, f) in reflection.fields(sample) {
					continue when fieldFlag(f, jsonAnnotation, "ignore")
					let key = encodedKey(f, jsonAnnotation, CaseStyle.AsIs)
					let described = f.descriptor
					let schema = described is none ?? (new map<string, any>(), schemaAt(described, depth + 1, true))
					schema.set("description", f.doc) when f.doc.len() > 0
					properties.set(key, schema)
					required.push(key) unless f.kind == FieldKind.Optional
				}
				out.set("properties", properties)
				out.set("required", required) when required.len() > 0
			default:
		}
		return out
	}

	// Whether a value reads or writes its own JSON.
	internal def ownForm(value any) bool {
		match value {
			case JSONEncoder, JSONDecoder:
				return true
			default:
				return false
		}
	}

	internal const jsonAnnotation = "std.data.encoding.json"

	internal def convert(value any, t TypeDescriptor, path string) !any {
		if value is none {
			return none when t.optional
			fail schemaError(SchemaErrorKind.Missing, path, "is null")
		}
		match t.kind {
			case TypeKind.Primitive, TypeKind.Alias:
				return try scalar(value, primitiveName(t), path)
			case TypeKind.Enum:
				let chosen = reflection.kindOf(value) == FieldKind.String ?? (reflection.scalarText(value), "")
				let members = reflection.members(t)
				let found = members.find(m => m.node.name == chosen)
				if found is none {
					let names string[] = []
					for let (_, m) in members {
						names.push(m.node.name)
					}
					fail schemaError(SchemaErrorKind.UnknownChoice, path, "is one of {names.join(", ")}, not \"{chosen}\"")
				}
				return found.value
			case TypeKind.Array:
				let element = t.element
				fail schemaError(SchemaErrorKind.Unsupported, path, "has an array type without an element type") when element is none
				fail schemaError(SchemaErrorKind.Mismatch, path, "is not an array") unless reflection.kindOf(value) == FieldKind.Array
				let items any[] = []
				for let (i, item) in reflection.elements(value) {
					items.push(try convert(item, element, "{path}[{i}]"))
				}
				let made = reflection.arrayOf(element, items)
				fail schemaError(SchemaErrorKind.Unsupported, path, "has an element type ({element.typeName}) an array cannot be built of") when made is none
				return made
			case TypeKind.Map:
				let element = t.element
				fail schemaError(SchemaErrorKind.Unsupported, path, "has a map type without a value type") when element is none
				fail schemaError(SchemaErrorKind.Mismatch, path, "is not an object") unless reflection.kindOf(value) == FieldKind.Map
				let keys = reflection.keysOf(value)
				let items any[] = []
				for let (_, key) in keys {
					let found = reflection.entryOf(value, key)
					let entry any = found is none ?? (none, found)
					items.push(try convert(entry, element, "{path}.{key}"))
				}
				let made = reflection.mapOf(element, keys, items)
				fail schemaError(SchemaErrorKind.Unsupported, path, "has a value type ({element.typeName}) a map cannot be built of") when made is none
				return made
			case TypeKind.Struct, TypeKind.Datatype:
				fail schemaError(SchemaErrorKind.Mismatch, path, "is not an object") unless reflection.kindOf(value) == FieldKind.Map
				let target = reflection.instantiate(t)
				fail schemaError(SchemaErrorKind.Unsupported, path, "has a type ({t.typeName}) that cannot be created") when target is none
				let json = new JSON()
				json.decode(json.encode(value), target) onerror (err error) {
					fail schemaError(SchemaErrorKind.Mismatch, path, err.message)
				}
				return target
			default:
				return value
		}
	}

	// A JSON scalar as the primitive named name.
	internal def scalar(value any, name string, path string) !any {
		let kind = reflection.kindOf(value)
		let text = reflection.scalarText(value)
		if name := "string" || "char" {
			fail schemaError(SchemaErrorKind.Mismatch, path, "is not a string") unless kind == FieldKind.String
			return text
		}
		if name == "bool" {
			return text == "true" when kind == FieldKind.Bool || (kind == FieldKind.String && (text := "true" || "false"))
			fail schemaError(SchemaErrorKind.Mismatch, path, "is not a boolean")
		}
		fail schemaError(SchemaErrorKind.Mismatch, path, "is not a number") unless (kind := FieldKind.Int || FieldKind.Uint || FieldKind.Float || FieldKind.String) && /^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/.test(text)
		if isFloat(name) {
			let number = parseFloat<float>(text)
			return float32(number) when name == "float32"
			return number
		}
		return value unless isSigned(name) || isUnsigned(name)
		let whole = text
		if !/^[+-]?[0-9]+$/.test(text) {
			let number = parseFloat<float>(text)
			fail schemaError(SchemaErrorKind.Mismatch, path, "is not a whole number") unless number == float(int(number))
			whole = "{int(number)}"
		}
		fail schemaError(SchemaErrorKind.Mismatch, path, "is negative") when isUnsigned(name) && whole.startsWith("-")
		// The box holds the parameter's own width, as `reflection.invoke` reads it.
		match name {
			case "int8":
				return try sized<int8>(whole, path)
			case "int16":
				return try sized<int16>(whole, path)
			case "int32":
				return try sized<int32>(whole, path)
			case "int64":
				return try sized<int64>(whole, path)
			case "uint":
				return try sized<uint>(whole, path)
			case "uint8":
				return try sized<uint8>(whole, path)
			case "byte":
				return try sized<byte>(whole, path)
			case "uint16":
				return try sized<uint16>(whole, path)
			case "uint32":
				return try sized<uint32>(whole, path)
			case "uint64":
				return try sized<uint64>(whole, path)
			default:
				return try sized<int>(whole, path)
		}
	}

	// The integer a run of digits spells, as T; fails when T cannot hold it.
	internal def sized<T: Integer>(digits string, path string) !T {
		let made = parseInt<T>(digits)
		fail schemaError(SchemaErrorKind.Mismatch, path, "is out of range") unless "{made}" == digits.trimPrefix("+")
		return made
	}

	// The name of a primitive type without its module (`builtin.string` is
	// `string`); an alias of the program's own keeps its name and matches none.
	internal def primitiveName(t TypeDescriptor) string {
		return t.typeName.trimPrefix("builtin.")
	}

	internal def isSigned(name string) bool {
		return name := "int" || "int8" || "int16" || "int32" || "int64"
	}

	internal def isUnsigned(name string) bool {
		return name := "uint" || "uint8" || "uint16" || "uint32" || "uint64" || "byte"
	}

	internal def isFloat(name string) bool {
		return name := "float" || "float32" || "float64"
	}

	internal def schemaError(kind SchemaErrorKind, path string, problem string) SchemaError {
		let subject = path == "" ?? ("the value", path)
		return SchemaError{message: "{subject} {problem}", code: kind.name, kind: kind, path: path}
	}
}
