partial module std.data.encoding.jsonschema {
	use (
		std.testing
		std.reflection
		std.reflection::(DiscoveryMetaContext, FunctionMetaContext, MethodMetaContext, FunctionDescriptor)
		std.data.encoding::(JSON, json)
	)

	// Marks the functions and methods the suite describes.
	internal meta def described(ctx DiscoveryMetaContext<FunctionMetaContext>) {}

	internal meta def described(ctx DiscoveryMetaContext<MethodMetaContext>) {}

	internal enum Shade {
		Light,
		Dark
	}

	internal struct Corner {
		// Distance from the left edge.
		x int
		y int = 5
		label ?string
		@json(name = "tint")
		shade Shade
		@json(ignore = true)
		cache string
	}

	// Adds two numbers.
	// @param a the first number
	// @param b the second number
	@described()
	internal def schemaAdd(a int, b int = 10) int {
		return a + b
	}

	// Takes one of everything.
	@described()
	internal def schemaEverything(text string, on bool, small uint8, wide int64, ratio float32, shade Shade, names string[], counts map<string, int>, corner Corner, note ?string, extra any) string {
		let said = note is none ?? ("-", note)
		return "{text} {on} {small} {wide} {ratio} {shade} {names.join("|")} {counts.len()} {corner.x},{corner.y},{corner.shade} {said} {reflection.kindOf(extra)}"
	}

	// Fails on demand.
	@described()
	internal def schemaRefuses(reason string) !Corner {
		fail reason when reason != ""
		return Corner{x: 1, shade: Shade.Dark}
	}

	// Greets with a prefix the program supplies.
	@described()
	internal def schemaLeading(prefix string, name string) string {
		return prefix + name
	}

	internal type Scaler {
		factor int = 3

		// Scales a number.
		@described()
		def scale(by float) float {
			return by * float(factor)
		}
	}

	internal def describedFunction(name string) !FunctionDescriptor {
		for let (_, hit) in reflection.attrs(described) {
			let fn = reflection.asFunction(hit.node)
			continue when fn is none
			return fn when fn.node.name == name
		}
		fail "no @described function named {name}"
	}

	internal def jsonText(value any) string {
		return string(new JSON().encode(value))
	}

	internal def arguments(text string) !any {
		return try new JSON().parse(text)
	}

	check "JSON Schema" {
		@test()
		def TestInputSchema() !none {
			let add = new Callable(try describedFunction("schemaAdd"))
			assert add.name == "schemaAdd" && add.description == "Adds two numbers."
			assert add.parameters.len() == 2 && add.parameters[0].required && !add.parameters[1].required
			assert jsonText(add.inputSchema()) == "\{\"type\":\"object\",\"properties\":\{\"a\":\{\"type\":\"integer\",\"description\":\"the first number\"\},\"b\":\{\"type\":\"integer\",\"description\":\"the second number\"\}\},\"required\":[\"a\"]\}"
			assert add.outputSchema() is none
			return none
		}

		@test()
		def TestEveryKind() !none {
			let all = new Callable(try describedFunction("schemaEverything"))
			let properties = all.inputSchema()["properties"]
			let want = map<string, string>{
				"text":   "\{\"type\":\"string\"\}",
				"on":     "\{\"type\":\"boolean\"\}",
				"small":  "\{\"type\":\"integer\",\"minimum\":0\}",
				"wide":   "\{\"type\":\"integer\"\}",
				"ratio":  "\{\"type\":\"number\"\}",
				"shade":  "\{\"type\":\"string\",\"enum\":[\"Light\",\"Dark\"]\}",
				"names":  "\{\"type\":\"array\",\"items\":\{\"type\":\"string\"\}\}",
				"counts": "\{\"type\":\"object\",\"additionalProperties\":\{\"type\":\"integer\"\}\}",
				"note":   "\{\"type\":\"string\"\}",
				"extra":  "\{\}",
			}
			for let (name, schema) in want {
				let found = reflection.entryOf(properties, name)
				fail "no property {name}" when found is none
				fail "{name}: {jsonText(found)}" unless jsonText(found) == schema
			}
			let corner = reflection.entryOf(properties, "corner")
			fail "no property corner" when corner is none
			assert jsonText(corner) == "\{\"type\":\"object\",\"properties\":\{\"x\":\{\"type\":\"integer\"\},\"y\":\{\"type\":\"integer\"\},\"label\":\{\"type\":\"string\"\},\"tint\":\{\"type\":\"integer\",\"oneOf\":[\{\"const\":0,\"title\":\"Light\"\},\{\"const\":1,\"title\":\"Dark\"\}]\}\},\"required\":[\"x\",\"y\",\"tint\"]\}"
			// An optional parameter is not required.
			let required = jsonText(all.inputSchema()["required"])
			assert !required.contains("\"note\"") && required.contains("\"corner\"")
			return none
		}

		@test()
		def TestCall() !none {
			let add = new Callable(try describedFunction("schemaAdd"))
			assert "{try add.call(try arguments("\{\"a\": 2, \"b\": 40\}"))}" == "42"
			// A parameter left out takes its default; numbers given as text or as whole floats are taken.
			assert "{try add.call(try arguments("\{\"a\": \"2\"\}"))}" == "12"
			assert "{try add.call(try arguments("\{\"a\": 2.0, \"b\": 1, \"unknown\": true\}"))}" == "3"
			let all = new Callable(try describedFunction("schemaEverything"))
			let text = try all.call(try arguments("\{\"text\": \"t\", \"on\": true, \"small\": 200, \"wide\": 5000000000, \"ratio\": 0.5, \"shade\": \"Dark\", \"names\": [\"a\", \"b\"], \"counts\": \{\"a\": 7\}, \"corner\": \{\"x\": 4, \"tint\": 1\}, \"extra\": [1]\}"))
			assert "{text}" == "t true 200 5000000000 0.500000 Dark a|b 1 4,5,Dark - Array"
			return none
		}

		@test()
		def TestCallFailures() !none {
			let add = new Callable(try describedFunction("schemaAdd"))
			let kinds string[] = []
			for let (_, text) in ["\{\}", "\{\"a\": \"two\"\}", "\{\"a\": 1.5\}", "\{\"a\": null\}"] {
				add.call(try arguments(text)) onerror (err error) {
					kinds.push("{err.kind.name} {err.path}") when err is SchemaError
					recover none
				}
			}
			assert kinds.join(", ") == "Missing a, Mismatch a, Mismatch a, Missing a"
			let all = new Callable(try describedFunction("schemaEverything"))
			let message = ""
			all.call(try arguments("\{\"text\": \"t\", \"on\": true, \"small\": -1, \"wide\": 1, \"ratio\": 1, \"shade\": \"Grey\", \"names\": [], \"counts\": \{\}, \"corner\": \{\}, \"extra\": 1\}")) onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "small is negative"
			all.call(try arguments("\{\"text\": \"t\", \"on\": true, \"small\": 256, \"wide\": 1, \"ratio\": 1, \"shade\": \"Grey\", \"names\": [], \"counts\": \{\}, \"corner\": \{\}, \"extra\": 1\}")) onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "small is out of range"
			all.call(try arguments("\{\"text\": \"t\", \"on\": true, \"small\": 1, \"wide\": 1, \"ratio\": 1, \"shade\": \"Grey\", \"names\": [], \"counts\": \{\}, \"corner\": \{\}, \"extra\": 1\}")) onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "shade is one of Light, Dark, not \"Grey\""
			all.call(try arguments("\{\"text\": \"t\", \"on\": true, \"small\": 1, \"wide\": 1, \"ratio\": 1, \"shade\": \"Dark\", \"names\": [\"a\", 2], \"counts\": \{\}, \"corner\": \{\}, \"extra\": 1\}")) onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "names[1] is not a string"
			return none
		}

		@test()
		def TestResultAndFailure() !none {
			let refuses = new Callable(try describedFunction("schemaRefuses"))
			let schema = refuses.outputSchema()
			fail "no output schema" when schema is none
			assert jsonText(schema).startsWith("\{\"type\":\"object\",\"properties\":\{\"x\"")
			let made = try refuses.call(try arguments("\{\"reason\": \"\"\}"))
			assert jsonText(made).contains("\"tint\":1")
			let message = ""
			refuses.call(try arguments("\{\"reason\": \"not today\"\}")) onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "not today"
			return none
		}

		@test()
		def TestMethodAndLeading() !none {
			let scale = new Callable(try describedFunction("scale"), new Scaler())
			assert "{try scale.call(try arguments("\{\"by\": 2.5\}"))}" == "7.5"
			let greet = new Callable(try describedFunction("schemaLeading"), none, 1)
			assert greet.parameters.len() == 1 && greet.parameters[0].name == "name"
			assert "{try greet.call(try arguments("\{\"name\": \"Ada\"\}"), ["Dr "])}" == "Dr Ada"
			return none
		}

		@test()
		def TestValueOf() !none {
			let all = try describedFunction("schemaEverything")
			let names = try valueOf(try arguments("[\"x\", \"y\"]"), all.signature.parameters[6].paramType)
			assert jsonText(names) == "[\"x\",\"y\"]"
			assert jsonText(schemaOf(all.signature.parameters[6].paramType)) == "\{\"type\":\"array\",\"items\":\{\"type\":\"string\"\}\}"
			assert (try valueOf(none, all.signature.parameters[9].paramType)) is none
			try testing.expectError(valueOf(none, all.signature.parameters[0].paramType))
			return none
		}
	}
}
