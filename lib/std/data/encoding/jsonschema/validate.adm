partial module std.data.encoding.jsonschema {
	use (
		std.net.url
		std.math::(Decimal)
		std.data.encoding::(JSON, base64decode)
		std.data.encoding.json::(quote)
	)

	// What validating an instance found wrong: where in the instance (a
	// JSON Pointer, "" for the whole value), the keyword that failed (its
	// path through the schema, `$ref`s included, and its absolute URI), and
	// why.
	struct ValidationError {
		instanceLocation        string
		keywordLocation         string
		absoluteKeywordLocation string
		message                 string
	}

	// How compile reads a schema.
	struct CompileOptions {
		// Schemas the schema refers to by URI: a `$ref` to
		// `https://example.com/a.json` finds the schema under that key, and
		// any `$id` inside these schemas counts too. The draft 2020-12
		// meta-schemas are always known.
		resources map<string, any> = map<string, any>{}
		// Whether `format` asserts (a value of the wrong form fails) rather
		// than only annotating, as 2020-12 has it by default.
		formats   bool             = false
		// Whether a draft 7 schema's `contentEncoding` and `contentMediaType`
		// assert (base64 that does not decode, or an `application/json`
		// document that does not parse, fails), which draft 7 lets a
		// validator do. 2019-09 and later only annotate them.
		content   bool             = false
		// The URI of the schema when it has no `$id` of its own.
		baseURI   string           = "urn:adm:jsonschema:root"
		// The draft a schema without `$schema` follows.
		draft     Draft            = Draft.Draft2020
	}

	// The JSON Schema drafts compile reads: a schema's `$schema` names its
	// own, else it follows the schema that holds it, else the option.
	enum Draft {
		Draft4,
		Draft6,
		Draft7,
		Draft2019,
		Draft2020,
	}

	// A JSON Schema ready to validate instances: drafts 2020-12 (every
	// keyword of the core, applicator, unevaluated, validation, format and
	// content vocabularies, `$dynamicRef`), 2019-09 (`$recursiveRef`), 7, 6
	// and 4, each resource read as its `$schema` says; `$ref` and anchors
	// across embedded and given resources, and a custom meta-schema's
	// `$vocabulary`. Instances are values as `JSON.parse` builds them.
	type Validator {
		internal registry Registry
		internal root     SchemaNode

		internal def new(registry Registry, root SchemaNode) {
			self.registry = registry
			self.root = root
		}

		// The errors of an instance, in the order the keywords met them;
		// empty when it is valid. The instance is a value as JSON.parse
		// makes it; a `byte[]` is a JSON string as its UTF-8 bytes, which,
		// unlike a `string`, can hold U+0000.
		def validate(instance any) ValidationError[] {
			let run = new Evaluation(registry)
			let result = evaluate(run, root, instance, "", "", [])
			return result.errors
		}

		// Whether an instance is valid.
		def valid(instance any) bool {
			return validate(instance).len() == 0
		}

		// The validator of the schema a reference names, resolved against
		// this schema's base URI (`#/$defs/item`, `other.json#/x`), sharing
		// its documents: a schema inside a document that is not a schema at
		// its root (an OpenAPI description) is validated through it.
		// Fails with a SchemaError (Invalid) when the reference names
		// nothing, or the schema there holds a `$ref` that names nothing or
		// a `pattern` the engine does not read.
		def at(reference string) !Validator {
			let uri = try resolveURI(root.base, reference)
			let target = try registry.node(uri)
			let home = registry.resources.get(target.resource)
			let draft = home is none ?? (registry.draft, home.draft)
			// The schema there was not reached from the document's root:
			// its anchors, `$id`s, patterns and references are read now.
			registry.references = []
			try registry.index(target.value, target.base, target.resource, target.location[target.location.indexOf("#") + 1:], true, draft)
			try registry.settle()
			return new Validator(registry, target)
		}
	}

	// compile reads a schema (a JSON object or boolean as `JSON.parse`
	// builds it) for validation. Fails with a SchemaError (Invalid) when it
	// is not a schema, a `$ref` names nothing the schema or the resources
	// hold, a `pattern` is not a regular expression the engine reads, or its
	// meta-schema requires a vocabulary this validator does not know.
	def compile(schema any, options CompileOptions = CompileOptions{}) !Validator {
		let registry = new Registry(options.formats, options.draft)
		registry.content = options.content
		try registry.addMetaSchemas()
		for let (uri, resource) in options.resources {
			try registry.add(resource, uri)
		}
		// Only the schema's own references must lead somewhere: a resource
		// may hold others it never reaches.
		registry.references = []
		let rootURI = try registry.add(schema, options.baseURI)
		try registry.settle()
		let root = try registry.node(rootURI + "#")
		return new Validator(registry, root)
	}

	// The draft 2020-12 meta-schema and its vocabularies' meta-schemas
	// (BSD-3-Clause, `metaschema/LICENSE`), known to every registry.
	@embed("metaschema/schema.json")
	internal const metaSchemaText byte[]
	@embed("metaschema/meta_core.json")
	internal const metaCoreText byte[]
	@embed("metaschema/meta_applicator.json")
	internal const metaApplicatorText byte[]
	@embed("metaschema/meta_unevaluated.json")
	internal const metaUnevaluatedText byte[]
	@embed("metaschema/meta_validation.json")
	internal const metaValidationText byte[]
	@embed("metaschema/meta_meta-data.json")
	internal const metaMetaDataText byte[]
	@embed("metaschema/meta_format-annotation.json")
	internal const metaFormatAnnotationText byte[]
	@embed("metaschema/meta_format-assertion.json")
	internal const metaFormatAssertionText byte[]
	@embed("metaschema/meta_content.json")
	internal const metaContentText byte[]
	@embed("metaschema/2019-09_schema.json")
	internal const meta2019Text byte[]
	@embed("metaschema/2019-09_meta_core.json")
	internal const meta2019CoreText byte[]
	@embed("metaschema/2019-09_meta_applicator.json")
	internal const meta2019ApplicatorText byte[]
	@embed("metaschema/2019-09_meta_validation.json")
	internal const meta2019ValidationText byte[]
	@embed("metaschema/2019-09_meta_meta-data.json")
	internal const meta2019MetaDataText byte[]
	@embed("metaschema/2019-09_meta_format.json")
	internal const meta2019FormatText byte[]
	@embed("metaschema/2019-09_meta_content.json")
	internal const meta2019ContentText byte[]
	@embed("metaschema/draft-07.json")
	internal const draft7Text byte[]
	@embed("metaschema/draft-06.json")
	internal const draft6Text byte[]
	@embed("metaschema/draft-04.json")
	internal const draft4Text byte[]

	internal def metaSchemas() map<string, byte[]> {
		let prefix = "https://json-schema.org/draft/2020-12/"
		return map<string, byte[]>{
			prefix + "schema":                                       metaSchemaText,
			prefix + "meta/core":                                    metaCoreText,
			prefix + "meta/applicator":                              metaApplicatorText,
			prefix + "meta/unevaluated":                             metaUnevaluatedText,
			prefix + "meta/validation":                              metaValidationText,
			prefix + "meta/meta-data":                               metaMetaDataText,
			prefix + "meta/format-annotation":                       metaFormatAnnotationText,
			prefix + "meta/format-assertion":                        metaFormatAssertionText,
			prefix + "meta/content":                                 metaContentText,
			"https://json-schema.org/draft/2019-09/schema":          meta2019Text,
			"https://json-schema.org/draft/2019-09/meta/core":       meta2019CoreText,
			"https://json-schema.org/draft/2019-09/meta/applicator": meta2019ApplicatorText,
			"https://json-schema.org/draft/2019-09/meta/validation": meta2019ValidationText,
			"https://json-schema.org/draft/2019-09/meta/meta-data":  meta2019MetaDataText,
			"https://json-schema.org/draft/2019-09/meta/format":     meta2019FormatText,
			"https://json-schema.org/draft/2019-09/meta/content":    meta2019ContentText,
			"http://json-schema.org/draft-07/schema":                draft7Text,
			"http://json-schema.org/draft-06/schema":                draft6Text,
			"http://json-schema.org/draft-04/schema":                draft4Text,
		}
	}

	internal const draft2020 = "https://json-schema.org/draft/2020-12/schema"
	internal const vocabCore = "https://json-schema.org/draft/2020-12/vocab/core"
	internal const vocabApplicator = "https://json-schema.org/draft/2020-12/vocab/applicator"
	internal const vocabUnevaluated = "https://json-schema.org/draft/2020-12/vocab/unevaluated"
	internal const vocabValidation = "https://json-schema.org/draft/2020-12/vocab/validation"
	internal const vocabMetaData = "https://json-schema.org/draft/2020-12/vocab/meta-data"
	internal const vocabFormatAnnotation = "https://json-schema.org/draft/2020-12/vocab/format-annotation"
	internal const vocabFormatAssertion = "https://json-schema.org/draft/2020-12/vocab/format-assertion"
	internal const vocabContent = "https://json-schema.org/draft/2020-12/vocab/content"

	internal const knownVocabularies = [vocabCore, vocabApplicator, vocabUnevaluated, vocabValidation, vocabMetaData, vocabFormatAnnotation, vocabFormatAssertion, vocabContent, "https://json-schema.org/draft/2019-09/vocab/core", "https://json-schema.org/draft/2019-09/vocab/applicator", "https://json-schema.org/draft/2019-09/vocab/validation", "https://json-schema.org/draft/2019-09/vocab/meta-data", "https://json-schema.org/draft/2019-09/vocab/format", "https://json-schema.org/draft/2019-09/vocab/content"]

	// The draft a `$schema` URI names; none for one this validator does not
	// know by name.
	internal def draftNamed(uri string) ?Draft {
		let bare = stripFragment(uri)
		return Draft.Draft2020 when bare == draft2020
		return Draft.Draft2019 when bare == "https://json-schema.org/draft/2019-09/schema"
		return Draft.Draft7 when bare == "http://json-schema.org/draft-07/schema"
		return Draft.Draft6 when bare == "http://json-schema.org/draft-06/schema"
		return Draft.Draft4 when bare == "http://json-schema.org/draft-04/schema"
		return none
	}

	// The keywords whose value is a schema, a map of schemas, or an array
	// of schemas: what makes a position in a document a schema position.
	internal const schemaKeywords = ["additionalProperties", "additionalItems", "items", "contains", "not", "if", "then", "else", "propertyNames", "unevaluatedItems", "unevaluatedProperties", "contentSchema"]
	internal const schemaMapKeywords = ["properties", "patternProperties", "$defs", "definitions", "dependentSchemas", "dependencies"]
	internal const schemaArrayKeywords = ["allOf", "anyOf", "oneOf", "prefixItems"]

	// One schema of the registry: its value (a map or a boolean), where it
	// is, the base URI its references resolve against, the resource it
	// belongs to, and what its resource's meta-schema switches on.
	internal type SchemaNode {
		value    any
		location string
		base     string
		resource string
		vocab    Vocabularies

		def new(value any, location string, base string, resource string, vocab Vocabularies) {
			self.value = value
			self.location = location
			self.base = base
			self.resource = resource
			self.vocab = vocab
		}
	}

	// The vocabularies a meta-schema switches on.
	internal struct Vocabularies {
		draft       Draft = Draft.Draft2020
		applicator  bool  = true
		unevaluated bool  = true
		validation  bool  = true
		formats     bool  = false
		content     bool  = true
	}

	// One schema resource: its root value, URI, the meta-schema's
	// vocabularies and its anchors.
	internal type Resource {
		uri             string
		value           any
		draft           Draft
		vocab           Vocabularies
		anchors         map<string, string>
		dynamicAnchors  map<string, string>
		// 2019-09: the root has `"$recursiveAnchor": true`.
		recursiveAnchor bool                = false

		def new(uri string, value any, draft Draft) {
			self.uri = uri
			self.value = value
			self.draft = draft
			anchors = map<string, string>{}
			dynamicAnchors = map<string, string>{}
		}
	}

	// The schemas compile knows, by URI: every resource (documents and the
	// `$id`s inside them) with its anchors, and the nodes built so far.
	internal type Registry {
		resources  map<string, Resource>
		documents  map<string, any>
		nodes      map<string, SchemaNode>
		patterns   map<string, regex>
		formats    bool
		draft      Draft
		pending    string[]                = []
		content    bool                    = false
		// The `$ref`s and `$dynamicRef`s of the schema compiled, resolved,
		// which settle checks once every document is in.
		references string[]                = []

		def new(formats bool, draft Draft) {
			resources = map<string, Resource>{}
			documents = map<string, any>{}
			nodes = map<string, SchemaNode>{}
			patterns = map<string, regex>{}
			self.formats = formats
			self.draft = draft
		}

		// The draft of a schema: its `$schema` (a meta-schema this registry
		// holds counts as the draft it follows), else the one inherited.
		def draftOf(value map<string, any>, inherited Draft) Draft {
			let named = stringAt(value, "$schema")
			return inherited when named == ""
			let known = draftNamed(named)
			return known unless known is none
			let metaFound = documents.get(stripFragment(named))
			return inherited when metaFound is none
			let metaValue = metaFound
			return inherited unless metaValue is map<string, any>
			let own = stringAt(metaValue, "$schema")
			return inherited when own == "" || stripFragment(own) == stripFragment(named)
			let base = draftNamed(own)
			return base is none ?? (inherited, base)
		}

		def addMetaSchemas() !none {
			for let (uri, text) in metaSchemas() {
				try add(try JSON.parse(text), uri)
			}
			return none
		}

		// Adds a schema document under a URI (its `$id` wins); returns the
		// URI it is known by.
		def add(schema any, uri string) !string {
			fail invalidSchema("", "a schema is an object or a boolean") unless schema is bool || schema is map<string, any>
			let base = stripFragment(uri)
			let docDraft = schema is map<string, any> ?? (draftOf(schema, self.draft), self.draft)
			let own = schema is map<string, any> ?? (idOf(schema, docDraft), "")
			let documentURI = own == "" ?? (base, stripFragment(try resolveURI(base, own)))
			documents[documentURI] = schema
			documents[base] = schema unless documents.hasKey(base)
			if schema is bool && !resources.hasKey(documentURI) {
				resources[documentURI] = new Resource(documentURI, schema, docDraft)
				pending.push(documentURI)
			}
			try index(schema, documentURI, documentURI, "", true, docDraft)
			let r = resources.get(documentURI)
			resources[base] = r unless r is none || resources.hasKey(base)
			return documentURI
		}

		// Walks a document's schema positions, recording resources ($id),
		// anchors and dynamic anchors.
		def index(value any, base string, resource string, pointer string, isSchema bool, inherited Draft) !none {
			return none when value is any[]
			return none unless value is map<string, any>
			let ownBase = base
			let ownResource = resource
			let schemaDraft = inherited
			if isSchema {
				schemaDraft = draftOf(value, inherited)
				let id = idOf(value, schemaDraft)
				// Before 2019-09 an id of only a fragment names an anchor.
				let fragmentAnchor = ""
				if id.startsWith("#") {
					fragmentAnchor = id[1:]
					id = ""
				}
				if id != "" {
					ownBase = try resolveURI(base, id)
					ownResource = stripFragment(ownBase)
				}
				if !resources.hasKey(ownResource) {
					resources[ownResource] = new Resource(ownResource, value, schemaDraft)
					pending.push(ownResource)
				}
				let r = resources[ownResource]
				let location = ownResource == resource && id == "" ?? (pointer, "")
				r.anchors[fragmentAnchor] = ownResource + "#" + location when fragmentAnchor != ""
				if location == "" {
					let recursive = value.hasKey("$recursiveAnchor") ?? (value["$recursiveAnchor"], noneValue())
					r.recursiveAnchor = recursive is bool && recursive
				}
				let anchor = stringAt(value, "$anchor")
				if anchor != "" {
					fail invalidSchema(pointer, "\"{anchor}\" is not an anchor name") unless isAnchorName(anchor)
					r.anchors[anchor] = ownResource + "#" + location
				}
				let dynamic = stringAt(value, "$dynamicAnchor")
				if dynamic != "" {
					fail invalidSchema(pointer, "\"{dynamic}\" is not an anchor name") unless isAnchorName(dynamic)
					r.anchors[dynamic] = ownResource + "#" + location unless r.anchors.hasKey(dynamic)
					r.dynamicAnchors[dynamic] = ownResource + "#" + location
				}
				for let keyword in ["$ref", "$dynamicRef"] {
					let ref = stringAt(value, keyword)
					references.push(try resolveURI(ownBase, ref)) unless ref == ""
				}
				let pattern = stringAt(value, "pattern")
				try self.pattern(pattern) unless pattern == ""
				let patternKeys = value.hasKey("patternProperties") ?? (value["patternProperties"], noneValue())
				if patternKeys is map<string, any> {
					for let (key, _) in patternKeys {
						try self.pattern(key)
					}
				}
				let inner = ownResource == resource ?? (pointer, "")
				for let (k, v) in value {
					let here = inner + "/" + escapePointer(k)
					if schemaKeywords.includes(k) {
						try index(v, ownBase, ownResource, here, true, schemaDraft)
					} else if schemaMapKeywords.includes(k) {
						if v is map<string, any> {
							for let (name, sub) in v {
								try index(sub, ownBase, ownResource, here + "/" + escapePointer(name), true, schemaDraft)
							}
						}
					} else if schemaArrayKeywords.includes(k) {
						if v is any[] {
							for let (i, sub) in v {
								try index(sub, ownBase, ownResource, "{here}/{i}", true, schemaDraft)
							}
						}
					} else if k == "items" && v is any[] {
						for let (i, sub) in v {
							try index(sub, ownBase, ownResource, "{here}/{i}", true, schemaDraft)
						}
					}
				}
			}
			return none
		}

		// Sets each resource's vocabularies from its meta-schema and checks
		// that every reference leads somewhere, once every document is in.
		def settle() !none {
			for let uri in pending {
				let r = resources.get(uri)
				continue when r is none
				r.vocab = try vocabularyOf(r.value)
				r.vocab.draft = r.draft
			}
			pending = []
			for let reference in references {
				try node(reference)
			}
			references = []
			return none
		}

		def vocabularyOf(value any) !Vocabularies {
			let out = Vocabularies{formats: formats}
			return out unless value is map<string, any>
			let metaURI = stringAt(value, "$schema")
			return out when metaURI == "" || !(draftNamed(metaURI) is none)
			let found = documents.get(stripFragment(metaURI))
			return out when found is none
			let metaDoc = found
			return out unless metaDoc is map<string, any>
			let listed = metaDoc.hasKey("$vocabulary") ?? (metaDoc["$vocabulary"], noneValue())
			return out unless listed is map<string, any>
			for let (vocab, required) in listed {
				fail invalidSchema("", "the meta-schema {metaURI} requires the unknown vocabulary {vocab}") when required is bool && required && !knownVocabularies.includes(vocab)
			}
			let named = def (suffix string) bool {
				for let (vocab, _) in listed {
					return true when vocab.endsWith("/vocab/" + suffix)
				}
				return false
			}
			out.applicator = named("applicator")
			// 2019-09 has unevaluated in its applicator vocabulary.
			out.unevaluated = named("unevaluated") || listed.hasKey("https://json-schema.org/draft/2019-09/vocab/applicator")
			out.validation = named("validation")
			out.content = named("content")
			out.formats = formats || named("format-assertion")
			return out
		}

		// The schema at an absolute URI with a fragment: a JSON Pointer
		// (`#/$defs/a`), an anchor (`#name`) or the resource itself (`#`).
		def node(reference string) !SchemaNode {
			let known = nodes.get(reference)
			return known unless known is none
			let hash = reference.indexOf("#")
			let resourceURI = hash < 0 ?? (reference, reference[0:hash])
			let fragment = hash < 0 ?? ("", reference[hash + 1:])
			let r = resources.get(resourceURI)
			if r is none {
				let doc = documents.get(resourceURI)
				fail invalidSchema("", "nothing is known as {resourceURI}") when doc is none
				let registered = try add(doc, resourceURI)
				try settle()
				let home = resources.get(registered)
				fail invalidSchema("", "nothing is known as {resourceURI}") when home is none
				// The URI the document was given under names its resource too.
				resources[resourceURI] = home
				return try node(reference)
			}
			if fragment != "" && !fragment.startsWith("/") {
				let anchored = r.anchors.get(fragment)
				fail invalidSchema("", "{resourceURI} has no anchor \"{fragment}\"") when anchored is none
				let made = try node(anchored)
				nodes[reference] = made
				return made
			}
			let (value, base, resource, relative) = try walk(r, fragment)
			let home = resources.get(resource)
			let made = new SchemaNode(value, resource + "#" + relative, base, resource, home is none ?? (r.vocab, home.vocab))
			nodes[reference] = made
			return made
		}

		// Follows a JSON Pointer from a resource's root: the value there,
		// the base URI in force, the resource it is in (an `$id` on the way
		// at a schema position starts a new one) and the pointer from that
		// resource's root.
		def walk(r Resource, pointer string) !(any, string, string, string) {
			let value = r.value
			let base = r.uri
			let resource = r.uri
			let relative = ""
			let walkDraft = r.draft
			return (value, base, resource, relative) when pointer == ""
			// What the current value is: a schema, a map of schemas, an array
			// of schemas, or something else.
			let state = 0
			for let raw in pointer[1:].split("/") {
				let segment = unescapePointer(raw)
				if value is map<string, any> {
					fail invalidSchema("", "{r.uri}#{pointer} does not exist") unless value.hasKey(segment)
					value = value[segment]
				} else if value is any[] {
					let index = /^(0|[1-9][0-9]*)$/.test(segment) ?? (parseInt<int>(segment), -1)
					fail invalidSchema("", "{r.uri}#{pointer} does not exist") unless index >= 0 && index < value.len()
					value = value[index]
				} else {
					fail invalidSchema("", "{r.uri}#{pointer} does not exist")
				}
				relative += "/" + raw
				if state == 0 {
					state = schemaKeywords.includes(segment) ?? (0, schemaMapKeywords.includes(segment) ?? (1, schemaArrayKeywords.includes(segment) ?? (2, 3)))
					// `items` as an array (before 2020-12) holds schemas.
					state = 2 when state == 0 && value is any[]
				} else if state == 1 || state == 2 {
					state = 0
				}
				if state == 0 && value is map<string, any> {
					walkDraft = draftOf(value, walkDraft)
					let id = idOf(value, walkDraft)
					if id != "" && !id.startsWith("#") {
						base = try resolveURI(base, id)
						resource = stripFragment(base)
						relative = ""
					}
				}
			}
			return (value, base, resource, relative)
		}

		def pattern(text string) !regex {
			let known = patterns.get(text)
			return known unless known is none
			let translated = try ecmaToRE2(text)
			fail invalidSchema("", "\"{text}\" uses lookaround or a backreference, which this validator's RE2 engine does not run") when translated.backtracks
			let compiled = new regex(translated.re2, "")
			fail invalidSchema("", "\"{text}\" is not a regular expression this validator reads") unless compiled.valid()
			patterns[text] = compiled
			return compiled
		}
	}

	// What evaluating one schema gave: whether the instance is valid, the
	// errors, and the annotations the unevaluated keywords read: the
	// properties evaluated, and how far into an array items were (all of
	// them, a prefix, the indexes `contains` matched).
	internal type Outcome {
		valid         bool              = true
		errors        ValidationError[] = []
		properties    string[]          = []
		allProperties bool              = false
		itemsPrefix   int               = 0
		allItems      bool              = false
		containsItems int[]             = []

		def new() {}

		def refuse(instanceLocation string, keywordLocation string, absolute string, message string) {
			valid = false
			errors.push(ValidationError{instanceLocation: instanceLocation, keywordLocation: keywordLocation, absoluteKeywordLocation: absolute, message: message})
		}

		// Takes the result of a subschema applied to a child of the instance
		// in: its errors only, since its annotations are about the child.
		def mergeChild(other Outcome) {
			if !other.valid {
				valid = false
				errors += other.errors
			}
		}

		// Takes another schema's result in: its errors when it failed, its
		// annotations when it passed.
		def merge(other Outcome) {
			if !other.valid {
				valid = false
				errors += other.errors
				return
			}
			mergeAnnotations(other)
		}

		def mergeAnnotations(other Outcome) {
			for let p in other.properties {
				properties.push(p) unless properties.includes(p)
			}
			allProperties = allProperties || other.allProperties
			itemsPrefix = other.itemsPrefix when other.itemsPrefix > itemsPrefix
			allItems = allItems || other.allItems
			for let i in other.containsItems {
				containsItems.push(i) unless containsItems.includes(i)
			}
		}

		def evaluatedProperty(name string) bool {
			return allProperties || properties.includes(name)
		}

		def evaluatedItem(index int) bool {
			return allItems || index < itemsPrefix || containsItems.includes(index)
		}
	}

	// One validation run: the registry and the depth reached, so a schema
	// that recurses without consuming the instance stops.
	internal type Evaluation {
		registry Registry
		depth    int      = 0

		def new(registry Registry) {
			self.registry = registry
		}
	}

	internal const maxEvaluationDepth = 512

	// Evaluates an instance against a schema node. kloc is the keyword path
	// so far, scope the resources entered, outermost first (for
	// `$dynamicRef`).
	internal def evaluate(run Evaluation, node SchemaNode, instance any, iloc string, kloc string, scope string[]) Outcome {
		let out = new Outcome()
		let schema = node.value
		if schema is bool {
			out.refuse(iloc, kloc, node.location, "false schema does not allow {describe(instance)}") unless schema
			return out
		}
		return out unless schema is map<string, any>
		if run.depth >= maxEvaluationDepth {
			out.refuse(iloc, kloc, node.location, "the schema recurses without end")
			return out
		}
		run.depth++
		keywords(run, node, schema, instance, iloc, kloc, scope, out)
		run.depth--
		return out
	}

	// The keywords of an object schema, in the order their annotations
	// need: references, applicators, validation, format, unevaluated.
	internal def keywords(run Evaluation, node SchemaNode, schema map<string, any>, instance any, iloc string, kloc string, scope string[], out Outcome) {
		let inScope = scope.len() > 0 && scope[scope.len() - 1] == node.resource ?? (scope, scope + [node.resource])
		let vocab = node.vocab
		let abs = node.location
		// References first: their annotations count like the schema's own.
		if schema.hasKey("$ref") {
			let ref = schema["$ref"]
			if ref is string {
				let why = ""
				let resolved = resolveURI(node.base, ref) onerror (err error) {
					why = err.message
					recover ref
				}
				let target = run.registry.node(resolved) onerror (err error) {
					why = err.message
					recover node
				}
				if why != "" {
					out.refuse(iloc, kloc + "/$ref", abs + "/$ref", "the reference {ref} names nothing: {why}")
				} else {
					out.merge(evaluate(run, target, instance, iloc, kloc + "/$ref", inScope))
				}
			}
			// Before 2019-09 a `$ref` stands for the whole schema.
			return when vocab.draft.value <= Draft.Draft7.value
		}
		if vocab.draft == Draft.Draft2019 && schema.hasKey("$recursiveRef") {
			let ref = schema["$recursiveRef"]
			if ref is string {
				let target = recursiveTarget(run, node, ref, inScope)
				if target is none {
					out.refuse(iloc, kloc + "/$recursiveRef", abs + "/$recursiveRef", "the reference {ref} names nothing")
				} else {
					out.merge(evaluate(run, target, instance, iloc, kloc + "/$recursiveRef", inScope))
				}
			}
		}
		if vocab.draft == Draft.Draft2020 && schema.hasKey("$dynamicRef") {
			let ref = schema["$dynamicRef"]
			if ref is string {
				let target = dynamicTarget(run, node, ref, inScope)
				if target is none {
					out.refuse(iloc, kloc + "/$dynamicRef", abs + "/$dynamicRef", "the reference {ref} names nothing")
				} else {
					out.merge(evaluate(run, target, instance, iloc, kloc + "/$dynamicRef", inScope))
				}
			}
		}
		applicators(run, node, schema, instance, iloc, kloc, inScope, out) when vocab.applicator
		validations(run, node, schema, instance, iloc, kloc, out) when vocab.validation
		if vocab.formats && schema.hasKey("format") {
			let format = schema["format"]
			if format is string {
				let problem = formatProblem(format, instance, vocab.draft)
				out.refuse(iloc, kloc + "/format", abs + "/format", problem) unless problem == ""
			}
		}
		if run.registry.content && vocab.draft == Draft.Draft7 && (instance is string || instance is byte[]) {
			let problem = contentProblem(schema, instance)
			out.refuse(iloc, kloc + "/contentMediaType", abs + "/contentMediaType", problem) unless problem == ""
		}
		unevaluated(run, node, schema, instance, iloc, kloc, inScope, out) when vocab.unevaluated && vocab.draft.value >= Draft.Draft2019.value
	}

	// Where a 2019-09 `$recursiveRef` leads: the schema it resolves to,
	// unless that schema has `"$recursiveAnchor": true`, in which case the
	// outermost resource of the dynamic scope that has one too.
	internal def recursiveTarget(run Evaluation, node SchemaNode, ref string, scope string[]) ?SchemaNode {
		let resolved = resolveURI(node.base, ref) onerror recover ref
		let initial = nodeOrNone(run.registry, resolved)
		return none when initial is none
		let home = run.registry.resources.get(initial.resource)
		return initial when home is none || !home.recursiveAnchor || !initial.location.endsWith("#")
		for let uri in scope {
			let r = run.registry.resources.get(uri)
			continue when r is none || !r.recursiveAnchor
			let outer = nodeOrNone(run.registry, uri + "#")
			return outer is none ?? (initial, outer)
		}
		return initial
	}

	// The node a reference names, none when it names nothing.
	internal def nodeOrNone(registry Registry, reference string) ?SchemaNode {
		let found = registry.node(reference) onerror (err error) {
			return none
		}
		return found
	}

	// Where a `$dynamicRef` leads: the schema it resolves to, unless that
	// schema has a `$dynamicAnchor` of the fragment's name, in which case
	// the outermost resource of the dynamic scope with such an anchor.
	internal def dynamicTarget(run Evaluation, node SchemaNode, ref string, scope string[]) ?SchemaNode {
		let resolved = resolveURI(node.base, ref) onerror recover ref
		let initial = nodeOrNone(run.registry, resolved)
		return none when initial is none
		let hash = resolved.indexOf("#")
		let name = hash < 0 ?? ("", resolved[hash + 1:])
		return initial when name == "" || name.startsWith("/")
		let home = run.registry.resources.get(initial.resource)
		return initial when home is none || !home.dynamicAnchors.hasKey(name)
		for let uri in scope {
			let r = run.registry.resources.get(uri)
			continue when r is none
			let anchored = r.dynamicAnchors.get(name)
			continue when anchored is none
			let dynamic = nodeOrNone(run.registry, anchored)
			return dynamic is none ?? (initial, dynamic)
		}
		return initial
	}

	// The applicator vocabulary: in-place (allOf, anyOf, oneOf, not, if,
	// dependentSchemas) and child applicators (items, properties, …).
	internal def applicators(run Evaluation, node SchemaNode, schema map<string, any>, instance any, iloc string, kloc string, scope string[], out Outcome) {
		let abs = node.location
		let sub = def (keyword string) ?SchemaNode {
			return childNode(run, node, keyword)
		}
		if schema.hasKey("allOf") {
			let list = schema["allOf"]
			if list is any[] {
				for let i = 0; i < list.len(); i++ {
					let child = childNode(run, node, "allOf/{i}")
					continue when child is none
					out.merge(evaluate(run, child, instance, iloc, "{kloc}/allOf/{i}", scope))
				}
			}
		}
		if schema.hasKey("anyOf") {
			let list = schema["anyOf"]
			if list is any[] {
				let passed = false
				let failures ValidationError[] = []
				for let i = 0; i < list.len(); i++ {
					let child = childNode(run, node, "anyOf/{i}")
					continue when child is none
					let r = evaluate(run, child, instance, iloc, "{kloc}/anyOf/{i}", scope)
					if r.valid {
						passed = true
						out.mergeAnnotations(r)
					} else {
						failures += r.errors
					}
				}
				if !passed {
					out.refuse(iloc, kloc + "/anyOf", abs + "/anyOf", "{describe(instance)} matches none of the schemas of anyOf")
					out.errors += failures
				}
			}
		}
		if schema.hasKey("oneOf") {
			let list = schema["oneOf"]
			if list is any[] {
				let matched int[] = []
				let failures ValidationError[] = []
				let passing Outcome[] = []
				for let i = 0; i < list.len(); i++ {
					let child = childNode(run, node, "oneOf/{i}")
					continue when child is none
					let r = evaluate(run, child, instance, iloc, "{kloc}/oneOf/{i}", scope)
					if r.valid {
						matched.push(i)
						passing.push(r)
					} else {
						failures += r.errors
					}
				}
				if matched.len() == 1 {
					out.mergeAnnotations(passing[0])
				} else if matched.len() == 0 {
					out.refuse(iloc, kloc + "/oneOf", abs + "/oneOf", "{describe(instance)} matches none of the schemas of oneOf")
					out.errors += failures
				} else {
					let which = matched.mapElem(i => "{i}").join(", ")
					out.refuse(iloc, kloc + "/oneOf", abs + "/oneOf", "{describe(instance)} matches more than one schema of oneOf ({which})")
				}
			}
		}
		if schema.hasKey("not") {
			let child = sub("not")
			if !(child is none) {
				let r = evaluate(run, child, instance, iloc, kloc + "/not", scope)
				out.refuse(iloc, kloc + "/not", abs + "/not", "{describe(instance)} matches the schema of not") when r.valid
			}
		}
		if node.vocab.draft.value >= Draft.Draft7.value && schema.hasKey("if") {
			let condition = sub("if")
			if !(condition is none) {
				let r = evaluate(run, condition, instance, iloc, kloc + "/if", scope)
				if r.valid {
					out.mergeAnnotations(r)
					let then = sub("then")
					out.merge(evaluate(run, then, instance, iloc, kloc + "/then", scope)) unless then is none
				} else {
					let otherwise = sub("else")
					out.merge(evaluate(run, otherwise, instance, iloc, kloc + "/else", scope)) unless otherwise is none
				}
			}
		}
		objectApplicators(run, node, schema, instance, iloc, kloc, scope, out) when instance is map<string, any>
		arrayApplicators(run, node, schema, instance, iloc, kloc, scope, out) when instance is any[]
	}

	internal def objectApplicators(run Evaluation, node SchemaNode, schema map<string, any>, instance map<string, any>, iloc string, kloc string, scope string[], out Outcome) {
		let abs = node.location
		let matchedProperties string[] = []
		if schema.hasKey("properties") {
			let props = schema["properties"]
			if props is map<string, any> {
				for let (name, _) in props {
					continue unless instance.hasKey(name)
					let child = childNode(run, node, "properties/" + escapePointer(name))
					continue when child is none
					let r = evaluate(run, child, instance[name], iloc + "/" + escapePointer(name), kloc + "/properties/" + escapePointer(name), scope)
					out.mergeChild(r)
					matchedProperties.push(name)
					out.properties.push(name) unless out.properties.includes(name)
				}
			}
		}
		if schema.hasKey("patternProperties") {
			let patterns = schema["patternProperties"]
			if patterns is map<string, any> {
				for let (pattern, _) in patterns {
					let re = run.registry.pattern(pattern) onerror recover new regex("(?!)", "")
					let child = childNode(run, node, "patternProperties/" + escapePointer(pattern))
					continue when child is none
					for let (name, value) in instance {
						continue unless re.test(name)
						out.mergeChild(evaluate(run, child, value, iloc + "/" + escapePointer(name), kloc + "/patternProperties/" + escapePointer(pattern), scope))
						matchedProperties.push(name) unless matchedProperties.includes(name)
						out.properties.push(name) unless out.properties.includes(name)
					}
				}
			}
		}
		if schema.hasKey("additionalProperties") {
			let child = childNode(run, node, "additionalProperties")
			if !(child is none) {
				for let (name, value) in instance {
					continue when matchedProperties.includes(name)
					let r = evaluate(run, child, value, iloc + "/" + escapePointer(name), kloc + "/additionalProperties", scope)
					if !r.valid && child.value is bool {
						out.refuse(iloc + "/" + escapePointer(name), kloc + "/additionalProperties", abs + "/additionalProperties", "the property \"{name}\" is not allowed")
					} else {
						out.mergeChild(r)
					}
					out.properties.push(name) unless out.properties.includes(name)
				}
			}
		}
		if schema.hasKey("dependencies") {
			// The draft 7 form: an array is dependentRequired, a schema
			// dependentSchemas.
			let deps = schema["dependencies"]
			if deps is map<string, any> {
				for let (name, dep) in deps {
					continue unless instance.hasKey(name)
					if dep is any[] {
						for let other in dep {
							out.refuse(iloc, kloc + "/dependencies", abs + "/dependencies", "the property \"{other}\" is required when \"{name}\" is present") when other is string && !instance.hasKey(other)
						}
						continue
					}
					let child = childNode(run, node, "dependencies/" + escapePointer(name))
					continue when child is none
					out.merge(evaluate(run, child, instance, iloc, kloc + "/dependencies/" + escapePointer(name), scope))
				}
			}
		}
		if node.vocab.draft.value >= Draft.Draft2019.value && schema.hasKey("dependentSchemas") {
			let deps = schema["dependentSchemas"]
			if deps is map<string, any> {
				for let (name, _) in deps {
					continue unless instance.hasKey(name)
					let child = childNode(run, node, "dependentSchemas/" + escapePointer(name))
					continue when child is none
					out.merge(evaluate(run, child, instance, iloc, kloc + "/dependentSchemas/" + escapePointer(name), scope))
				}
			}
		}
		if node.vocab.draft.value >= Draft.Draft6.value && schema.hasKey("propertyNames") {
			let child = childNode(run, node, "propertyNames")
			if !(child is none) {
				for let (name, _) in instance {
					let r = evaluate(run, child, name, iloc + "/" + escapePointer(name), kloc + "/propertyNames", scope)
					if !r.valid {
						out.refuse(iloc, kloc + "/propertyNames", abs + "/propertyNames", "the property name \"{name}\" is not allowed")
						out.errors += r.errors
					}
				}
			}
		}
	}

	internal def arrayApplicators(run Evaluation, node SchemaNode, schema map<string, any>, instance any[], iloc string, kloc string, scope string[], out Outcome) {
		let abs = node.location
		let prefix = 0
		let draft = node.vocab.draft
		let tuple = schema.hasKey("items") ?? (schema["items"], noneValue())
		if draft.value <= Draft.Draft2019.value && tuple is any[] {
			// Before 2020-12: `items` as an array is the tuple form, and
			// `additionalItems` takes the items after it.
			for let i = 0; i < tuple.len() && i < instance.len(); i++ {
				let child = childNode(run, node, "items/{i}")
				continue when child is none
				out.mergeChild(evaluate(run, child, instance[i], "{iloc}/{i}", "{kloc}/items/{i}", scope))
			}
			prefix = tuple.len() < instance.len() ?? (tuple.len(), instance.len())
			out.itemsPrefix = prefix when prefix > out.itemsPrefix
			if schema.hasKey("additionalItems") {
				let rest = childNode(run, node, "additionalItems")
				if !(rest is none) {
					for let i = prefix; i < instance.len(); i++ {
						let r = evaluate(run, rest, instance[i], "{iloc}/{i}", kloc + "/additionalItems", scope)
						if !r.valid && rest.value is bool {
							out.refuse("{iloc}/{i}", kloc + "/additionalItems", abs + "/additionalItems", "the array allows {tuple.len()} items, it has {instance.len()}")
						} else {
							out.mergeChild(r)
						}
					}
					out.allItems = true
				}
			}
		}
		if draft == Draft.Draft2020 && schema.hasKey("prefixItems") {
			let list = schema["prefixItems"]
			if list is any[] {
				for let i = 0; i < list.len() && i < instance.len(); i++ {
					let child = childNode(run, node, "prefixItems/{i}")
					continue when child is none
					out.mergeChild(evaluate(run, child, instance[i], "{iloc}/{i}", "{kloc}/prefixItems/{i}", scope))
				}
				prefix = list.len() < instance.len() ?? (list.len(), instance.len())
				out.itemsPrefix = prefix when prefix > out.itemsPrefix
			}
		}
		if schema.hasKey("items") && !(tuple is any[]) {
			let child = childNode(run, node, "items")
			if !(child is none) {
				for let i = prefix; i < instance.len(); i++ {
					let r = evaluate(run, child, instance[i], "{iloc}/{i}", kloc + "/items", scope)
					if !r.valid && child.value is bool {
						out.refuse("{iloc}/{i}", kloc + "/items", abs + "/items", "the array allows {prefix} items, it has {instance.len()}")
					} else {
						out.mergeChild(r)
					}
				}
				out.allItems = true
			}
		}
		if draft.value >= Draft.Draft6.value && schema.hasKey("contains") {
			let child = childNode(run, node, "contains")
			if !(child is none) {
				let matched int[] = []
				for let (i, item) in instance {
					let r = evaluate(run, child, item, "{iloc}/{i}", kloc + "/contains", scope)
					if r.valid {
						matched.push(i)
						out.mergeAnnotations(r)
					}
				}
				for let i in matched {
					out.containsItems.push(i) unless out.containsItems.includes(i)
				}
				let counted = draft.value >= Draft.Draft2019.value
				let least = counted && schema.hasKey("minContains") && isInteger(schema["minContains"]) ?? (int(numberOf(schema["minContains"])), 1)
				let most = counted && schema.hasKey("maxContains") && isInteger(schema["maxContains"]) ?? (int(numberOf(schema["maxContains"])), -1)
				out.refuse(iloc, kloc + "/contains", abs + "/contains", least == 1 ?? ("no item matches the schema of contains", "{matched.len()} items match the schema of contains, fewer than minContains {least}")) when matched.len() < least
				out.refuse(iloc, kloc + "/maxContains", abs + "/maxContains", "{matched.len()} items match the schema of contains, more than maxContains {most}") when most >= 0 && matched.len() > most && node.vocab.validation
			}
		}
	}

	// The unevaluated vocabulary: the properties and items no other keyword
	// of this schema or its in-place subschemas evaluated.
	internal def unevaluated(run Evaluation, node SchemaNode, schema map<string, any>, instance any, iloc string, kloc string, scope string[], out Outcome) {
		let abs = node.location
		if instance is map<string, any> && schema.hasKey("unevaluatedProperties") {
			let child = childNode(run, node, "unevaluatedProperties")
			if !(child is none) {
				for let (name, value) in instance {
					continue when out.evaluatedProperty(name)
					let r = evaluate(run, child, value, iloc + "/" + escapePointer(name), kloc + "/unevaluatedProperties", scope)
					if !r.valid {
						if child.value is bool {
							out.refuse(iloc + "/" + escapePointer(name), kloc + "/unevaluatedProperties", abs + "/unevaluatedProperties", "the property \"{name}\" is not allowed")
						} else {
							out.mergeChild(r)
						}
					}
				}
				out.allProperties = true
			}
		}
		if instance is any[] && schema.hasKey("unevaluatedItems") {
			let child = childNode(run, node, "unevaluatedItems")
			if !(child is none) {
				for let (i, item) in instance {
					continue when out.evaluatedItem(i)
					let r = evaluate(run, child, item, "{iloc}/{i}", kloc + "/unevaluatedItems", scope)
					if !r.valid {
						if child.value is bool {
							out.refuse("{iloc}/{i}", kloc + "/unevaluatedItems", abs + "/unevaluatedItems", "the item {i} is not allowed")
						} else {
							out.mergeChild(r)
						}
					}
				}
				out.allItems = true
			}
		}
	}

	// The subschema at a path under a node (`properties/a`, `allOf/0`).
	internal def childNode(run Evaluation, node SchemaNode, path string) ?SchemaNode {
		let hash = node.location.indexOf("#")
		let resource = node.location[0:hash]
		let pointer = node.location[hash + 1:]
		return nodeOrNone(run.registry, resource + "#" + pointer + "/" + path)
	}

	// The validation vocabulary.
	internal def validations(run Evaluation, node SchemaNode, schema map<string, any>, instance any, iloc string, kloc string, out Outcome) {
		let abs = node.location
		if schema.hasKey("type") {
			let allowed = schema["type"]
			let names string[] = []
			if allowed is string {
				names = [allowed]
			} else if allowed is any[] {
				for let t in allowed {
					names.push(t) when t is string
				}
			}
			let fits = false
			for let t in names {
				// Draft 4 does not count 1.0 as an integer. JSON gives a float
				// for an integer only beyond the int64 range, so a float within
				// it was written with a fraction or an exponent.
				fits = true when isOfType(instance, t) && !(t == "integer" && node.vocab.draft == Draft.Draft4 && instance is float && instance.abs() < 9223372036854775808.0)
			}
			out.refuse(iloc, kloc + "/type", abs + "/type", "{describe(instance)} is not of type {names.join(" or ")}") unless fits
		}
		if schema.hasKey("enum") {
			let values = schema["enum"]
			if values is any[] {
				let found = false
				for let v in values {
					found = true when jsonEqual(v, instance)
				}
				out.refuse(iloc, kloc + "/enum", abs + "/enum", "{describe(instance)} is not one of the values of enum") unless found
			}
		}
		if node.vocab.draft.value >= Draft.Draft6.value && schema.hasKey("const") {
			out.refuse(iloc, kloc + "/const", abs + "/const", "{describe(instance)} is not the constant {describe(schema["const"])}") unless jsonEqual(schema["const"], instance)
		}
		if isNumber(instance) {
			let draft4 = node.vocab.draft == Draft.Draft4
			let x = numberOf(instance)
			for let keyword in ["multipleOf", "maximum", "exclusiveMaximum", "minimum", "exclusiveMinimum"] {
				continue unless schema.hasKey(keyword) && isNumber(schema[keyword])
				continue when draft4 && (keyword == "exclusiveMaximum" || keyword == "exclusiveMinimum")
				let limit = numberOf(schema[keyword])
				let at = kloc + "/" + keyword
				match keyword {
					case "multipleOf":
						out.refuse(iloc, at, abs + "/multipleOf", "{describe(instance)} is not a multiple of {describe(schema[keyword])}") unless isMultipleOf(instance, schema[keyword])
					case "maximum":
						// Draft 4: a boolean exclusiveMaximum makes maximum exclusive.
						let exclusive = draft4Flag(node, schema, "exclusiveMaximum")
						out.refuse(iloc, at, abs + "/maximum", "{describe(instance)} is more than {describe(schema[keyword])}") when x > limit
						out.refuse(iloc, at, abs + "/maximum", "{describe(instance)} is not less than {describe(schema[keyword])}") when exclusive && x == limit
					case "exclusiveMaximum":
						out.refuse(iloc, at, abs + "/exclusiveMaximum", "{describe(instance)} is not less than {describe(schema[keyword])}") when x >= limit
					case "minimum":
						let exclusive = draft4Flag(node, schema, "exclusiveMinimum")
						out.refuse(iloc, at, abs + "/minimum", "{describe(instance)} is less than {describe(schema[keyword])}") when x < limit
						out.refuse(iloc, at, abs + "/minimum", "{describe(instance)} is not more than {describe(schema[keyword])}") when exclusive && x == limit
					default:
						out.refuse(iloc, at, abs + "/exclusiveMinimum", "{describe(instance)} is not more than {describe(schema[keyword])}") when x <= limit
				}
			}
		}
		if instance is string || instance is byte[] {
			let length = textLength(instance)
			if schema.hasKey("maxLength") && isInteger(schema["maxLength"]) {
				let most = int(numberOf(schema["maxLength"]))
				out.refuse(iloc, kloc + "/maxLength", abs + "/maxLength", "the text is {length} characters, more than {most}") when length > most
			}
			if schema.hasKey("minLength") && isInteger(schema["minLength"]) {
				let least = int(numberOf(schema["minLength"]))
				out.refuse(iloc, kloc + "/minLength", abs + "/minLength", "the text is {length} characters, fewer than {least}") when length < least
			}
			if schema.hasKey("pattern") {
				let pattern = schema["pattern"]
				if pattern is string {
					let re = run.registry.pattern(pattern) onerror recover new regex("(?!)", "")
					let matched = instance is byte[] ?? (re.test(instance), re.test(string(instance)))
					out.refuse(iloc, kloc + "/pattern", abs + "/pattern", "{describe(instance)} does not match the pattern {pattern}") unless matched
				}
			}
		}
		if instance is any[] {
			if schema.hasKey("maxItems") && isInteger(schema["maxItems"]) {
				let most = int(numberOf(schema["maxItems"]))
				out.refuse(iloc, kloc + "/maxItems", abs + "/maxItems", "the array has {instance.len()} items, more than {most}") when instance.len() > most
			}
			if schema.hasKey("minItems") && isInteger(schema["minItems"]) {
				let least = int(numberOf(schema["minItems"]))
				out.refuse(iloc, kloc + "/minItems", abs + "/minItems", "the array has {instance.len()} items, fewer than {least}") when instance.len() < least
			}
			let unique = schema.hasKey("uniqueItems") ?? (schema["uniqueItems"], noneValue())
			if unique is bool && unique {
				let seen = map<string, int>{}
				for let (i, item) in instance {
					let key = canonical(item)
					if seen.hasKey(key) {
						out.refuse(iloc, kloc + "/uniqueItems", abs + "/uniqueItems", "the items {seen[key]} and {i} are equal")
						break
					}
					seen[key] = i
				}
			}
		}
		if instance is map<string, any> {
			if schema.hasKey("maxProperties") && isInteger(schema["maxProperties"]) {
				let most = int(numberOf(schema["maxProperties"]))
				out.refuse(iloc, kloc + "/maxProperties", abs + "/maxProperties", "the object has {instance.len()} properties, more than {most}") when instance.len() > most
			}
			if schema.hasKey("minProperties") && isInteger(schema["minProperties"]) {
				let least = int(numberOf(schema["minProperties"]))
				out.refuse(iloc, kloc + "/minProperties", abs + "/minProperties", "the object has {instance.len()} properties, fewer than {least}") when instance.len() < least
			}
			let required = schema.hasKey("required") ?? (schema["required"], noneValue())
			if required is any[] {
				for let name in required {
					out.refuse(iloc, kloc + "/required", abs + "/required", "the property \"{name}\" is required") when name is string && !instance.hasKey(name)
				}
			}
			let dependent = node.vocab.draft.value >= Draft.Draft2019.value && schema.hasKey("dependentRequired") ?? (schema["dependentRequired"], noneValue())
			if dependent is map<string, any> {
				for let (name, names) in dependent {
					continue unless instance.hasKey(name) && names is any[]
					for let other in names {
						out.refuse(iloc, kloc + "/dependentRequired", abs + "/dependentRequired", "the property \"{other}\" is required when \"{name}\" is present") when other is string && !instance.hasKey(other)
					}
				}
			}
		}
	}

	// Whether a draft 4 schema sets a boolean modifier keyword.
	internal def draft4Flag(node SchemaNode, schema map<string, any>, keyword string) bool {
		return false unless node.vocab.draft == Draft.Draft4 && schema.hasKey(keyword)
		let v = schema[keyword]
		return v is bool && v
	}

	internal def isNumber(value any) bool {
		return value is int || value is float
	}

	internal def numberOf(value any) float {
		return value when value is float
		return float(value) when value is int
		return 0.0
	}

	internal def isInteger(value any) bool {
		return true when value is int
		return value is float && value == value.floor() && value - value == 0.0
	}

	internal def isOfType(instance any, t string) bool {
		match t {
			case "null":
				return instance is none
			case "boolean":
				return instance is bool
			case "object":
				return instance is map<string, any>
			case "array":
				return instance is any[]
			case "string":
				return instance is string || instance is byte[]
			case "number":
				return isNumber(instance)
			case "integer":
				return isInteger(instance)
			default:
				return false
		}
	}

	// Whether x is an integer multiple of m, exactly: both as the shortest
	// decimals that read back as them, so 0.0075 is a multiple of 0.0001.
	internal def isMultipleOf(x any, m any) bool {
		return m != 0 && x % m == 0 when x is int && m is int
		let fx = numberOf(x)
		let fm = numberOf(m)
		return false when fm == 0.0 || fx != fx || fm != fm
		return false when fx - fx != 0.0
		let dx = new Decimal(fx)
		let dm = new Decimal(fm)
		return true when dx.isZero()
		let ex = dx.exponent()
		let em = dm.exponent()
		let low = ex < em ?? (ex, em)
		let cx = dx.coefficient() * pow10(ex - low)
		let cm = dm.coefficient() * pow10(em - low)
		return cx % cm == bigint(0)
	}

	internal def pow10(n int) bigint {
		let out = bigint(1)
		for let i = 0; i < n; i++ {
			out = out * bigint(10)
		}
		return out
	}

	// Equality of JSON values: numbers by value (1 and 1.0 are equal),
	// objects by their members in any order.
	internal def jsonEqual(a any, b any) bool {
		return canonical(a) == canonical(b)
	}

	// A JSON value as text that is equal for equal values: numbers in their
	// shortest form, object members sorted.
	internal def canonical(value any) string {
		return "null" when value is none
		return value ?? ("true", "false") when value is bool
		return "n" + "{value}" when value is int
		if value is float {
			return "n{int(value)}" when value == value.floor() && value.abs() < 9007199254740992.0
			return "n" + new Decimal(value).str()
		}
		// A string and the same text as bytes are one key.
		return "s" + quote(value) when value is string
		return "s" + quote(value) when value is byte[]
		return "[" + value.mapElem(v => canonical(v)).join(",") + "]" when value is any[]
		if value is map<string, any> {
			let entries string[] = []
			for let (k, v) in value {
				entries.push(string(JSON.encode(k)) + ":" + canonical(v))
			}
			// JSON-encoded keys hold no raw `"`, so sorting the entries
			// sorts by key.
			entries.sort((a string, b string) => a < b)
			return "\{" + entries.join(",") + "\}"
		}
		return "?{value}"
	}

	// The length of a JSON string in characters (code points), for a
	// string or its UTF-8 bytes.
	internal def textLength(text any) int {
		return text.len() when text is string
		let count = 0
		if text is byte[] {
			for let b in text {
				count++ when int(b) & 0xC0 != 0x80
			}
		}
		return count
	}

	// A value as a message shows it: JSON, cut short.
	internal def describe(value any) string {
		let text = value is byte[] ?? (quote(value), string(JSON.encode(value)))
		return text.len() > 60 ?? (text[0:57] + "...", text)
	}

	internal def noneValue() any {
		return none
	}

	internal def stringAt(value map<string, any>, key string) string {
		return "" unless value.hasKey(key)
		let v = value[key]
		return v is string ?? (v, "")
	}

	// A schema's id (`$id`, `id` in draft 4), "" when it has none (or a
	// non-string one); before 2019-09 a `$ref` beside it hides it.
	internal def idOf(value map<string, any>, draft Draft) string {
		return "" when draft.value <= Draft.Draft7.value && value.hasKey("$ref")
		return stringAt(value, draft == Draft.Draft4 ?? ("id", "$id"))
	}

	internal def isAnchorName(name string) bool {
		return /^[A-Za-z_][-A-Za-z0-9._]*$/.test(name)
	}

	// A reference resolved against a base URI, as text with its fragment
	// ("" fragment kept as `#`-less).
	internal def resolveURI(base string, ref string) !string {
		let b = try url.parse(base)
		let r = try url.parse(ref)
		let resolved = b.resolve(r)
		let fragment = resolved.fragment
		resolved.fragment = ""
		let text = stripFragment(resolved.str())
		return ref.contains("#") || fragment != "" ?? (text + "#" + fragment, text)
	}

	internal def stripFragment(uri string) string {
		let hash = uri.indexOf("#")
		return hash < 0 ?? (uri, uri[0:hash])
	}

	internal def escapePointer(segment string) string {
		return segment.replace("~", "~0", -1).replace("/", "~1", -1)
	}

	internal def unescapePointer(segment string) string {
		return segment.replace("~1", "/", -1).replace("~0", "~", -1)
	}

	internal def invalidSchema(at string, problem string) SchemaError {
		let place = at == "" ?? ("", " at {at}")
		return SchemaError{message: "invalid schema{place}: {problem}", code: SchemaErrorKind.Invalid.name, kind: SchemaErrorKind.Invalid, path: at}
	}

	// Why a string fails draft 7's content keywords: base64 that does not
	// decode, or an `application/json` document that does not parse; ""
	// when it passes. Other encodings and media types are not checked.
	internal def contentProblem(schema map<string, any>, instance any) string {
		let encoding = stringAt(schema, "contentEncoding")
		let media = stringAt(schema, "contentMediaType")
		if instance is byte[] {
			// Text holding U+0000 is neither base64 nor JSON (which takes a
			// control character only escaped); other bytes read as the
			// string they are.
			if instance.indexOf(byte(0)) >= 0 {
				return "the string is not base64" when encoding.lower() == "base64"
				return "the content is not a JSON document" when media.lower() == "application/json" || media.lower().startsWith("application/json;")
				return ""
			}
			return contentProblem(schema, string(instance))
		}
		return "" unless instance is string
		let data = instance.bytes()
		if encoding.lower() == "base64" {
			let failed = false
			data = base64decode(instance) onerror {
				failed = true
				recover byte[]
			}
			return "the string is not base64" when failed
		}
		if media.lower() == "application/json" || media.lower().startsWith("application/json;") {
			let bad = false
			JSON.parse(string(data)) onerror {
				bad = true
				recover none
			}
			return "the content is not a JSON document" when bad
		}
		return ""
	}
}
