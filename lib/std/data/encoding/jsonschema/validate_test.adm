partial module std.data.encoding.jsonschema {
	use (
		std.testing
		std.data.encoding::(JSON)
	)

	// Compiles schema text with the options given.
	internal def compiled(text string, options CompileOptions = CompileOptions{}) !Validator {
		return try compile(try JSON.parse(text), options)
	}

	// Whether the validator accepts the instance text.
	internal def accepts(v Validator, text string) bool {
		let instance = JSON.parse(text) onerror recover none
		return v.valid(instance)
	}

	// A tree whose nodes an extending schema can replace through
	// `$dynamicRef`.
	internal const treeSchema = "\{\"$id\": \"https://example.com/tree\", \"$dynamicAnchor\": \"node\", \"type\": \"object\", \"properties\": \{\"data\": true, \"children\": \{\"type\": \"array\", \"items\": \{\"$dynamicRef\": \"#node\"\}\}\}\}"

	check "JSON Schema validation" {
		// The 2020-12 assertions, with each error's instance and keyword
		// locations.
		@test()
		def reportsWhereItFails() !none {
			let v = try compiled("\{\"type\": \"object\", \"required\": [\"name\"], \"properties\": \{\"name\": \{\"type\": \"string\", \"minLength\": 2\}, \"tags\": \{\"type\": \"array\", \"items\": \{\"enum\": [\"a\", \"b\"]\}, \"uniqueItems\": true\}\}\}")
			assert accepts(v, "\{\"name\": \"ok\", \"tags\": [\"a\", \"b\"]\}")
			assert !accepts(v, "\{\"tags\": []\}")
			assert !accepts(v, "\{\"name\": \"ok\", \"tags\": [\"a\", \"a\"]\}")
			let errors = v.validate(try JSON.parse("\{\"name\": \"x\", \"tags\": [\"c\"]\}"))
			let places = errors.mapElem(e => e.instanceLocation + " " + e.keywordLocation).join(",")
			assert places.contains("/name /properties/name/minLength")
			assert places.contains("/tags/0 /properties/tags/items/enum")
			return none
		}

		// References: `$defs` by pointer and anchor, a resource given in
		// the options, `$dynamicRef` resolving through the dynamic scope, and
		// unevaluatedProperties seeing what the applicators evaluated.
		@test()
		def followsReferences() !none {
			let tree = try compiled(treeSchema)
			assert accepts(tree, "\{\"children\": [\{\"children\": []\}]\}")
			assert !accepts(tree, "\{\"children\": [1]\}")
			let strict = try compiled("\{\"$id\": \"https://example.com/strict\", \"$dynamicAnchor\": \"node\", \"$ref\": \"tree\", \"unevaluatedProperties\": false\}", CompileOptions{resources: map<string, any>{"https://example.com/tree": try JSON.parse(treeSchema)}})
			assert accepts(strict, "\{\"children\": [\{\"data\": 1\}]\}")
			assert !accepts(strict, "\{\"children\": [\{\"other\": 1\}]\}")
			let anchored = try compiled("\{\"$defs\": \{\"n\": \{\"$anchor\": \"num\", \"type\": \"number\"\}\}, \"properties\": \{\"a\": \{\"$ref\": \"#/$defs/n\"\}, \"b\": \{\"$ref\": \"#num\"\}\}\}")
			assert accepts(anchored, "\{\"a\": 1, \"b\": 2.5\}")
			assert !accepts(anchored, "\{\"b\": \"x\"\}")
			assert compiled("\{\"$ref\": \"https://example.com/missing\"\}") is error
			return none
		}

		// Older drafts keep their own rules: draft 4's boolean
		// exclusiveMaximum, draft 7's `$ref` that hides its siblings,
		// 2019-09's `$recursiveRef`.
		@test()
		def readsOlderDrafts() !none {
			let four = try compiled("\{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"maximum\": 3, \"exclusiveMaximum\": true\}")
			assert accepts(four, "2") && !accepts(four, "3")
			let seven = try compiled("\{\"definitions\": \{\"s\": \{\"type\": \"string\"\}\}, \"$ref\": \"#/definitions/s\", \"maxLength\": 1\}", CompileOptions{draft: Draft.Draft7})
			assert accepts(seven, "\"long\"")
			let latest = try compiled("\{\"$defs\": \{\"s\": \{\"type\": \"string\"\}\}, \"$ref\": \"#/$defs/s\", \"maxLength\": 1\}")
			assert !accepts(latest, "\"long\"")
			let recursive = try compiled("\{\"$schema\": \"https://json-schema.org/draft/2019-09/schema\", \"$recursiveAnchor\": true, \"type\": [\"object\", \"integer\"], \"additionalProperties\": \{\"$recursiveRef\": \"#\"\}\}")
			assert accepts(recursive, "\{\"a\": \{\"b\": 1\}\}") && !accepts(recursive, "\{\"a\": \{\"b\": \"x\"\}\}")
			return none
		}

		// `format` annotates unless asked to assert; the `regex` format and
		// `pattern` read ECMA-262 syntax.
		@test()
		def assertsFormatsWhenAsked() !none {
			let loose = try compiled("\{\"format\": \"email\"\}")
			assert accepts(loose, "\"nope\"")
			let strict = try compiled("\{\"format\": \"email\"\}", CompileOptions{formats: true})
			assert accepts(strict, "\"a@example.com\"") && !accepts(strict, "\"nope\"")
			let regexFormat = try compiled("\{\"format\": \"regex\"\}", CompileOptions{formats: true})
			assert accepts(regexFormat, "\"(?<=a)b\\\\k<x>(?<x>c)\"")
			assert !accepts(regexFormat, "\"\\\\a\"") && !accepts(regexFormat, "\"(?i)x\"") && !accepts(regexFormat, "\"(?P<n>x)\"")
			let host = try compiled("\{\"format\": \"idn-hostname\"\}", CompileOptions{formats: true})
			assert accepts(host, "\"bücher.example\"") && !accepts(host, "\"a·b.example\"")
			return none
		}

		// ECMA-262 patterns: `\s` holds U+3000, `.` stops at U+2028, `\cJ`,
		// long property names, `[^]`; lookaround is refused at compile.
		@test()
		def translatesEcmaPatterns() !none {
			assert accepts(try compiled("\{\"pattern\": \"^\\\\s$\"\}"), "\"\u3000\"")
			assert !accepts(try compiled("\{\"pattern\": \"^.$\"\}"), "\"\u2028\"")
			assert accepts(try compiled("\{\"pattern\": \"^\\\\cJ$\"\}"), "\"\\n\"")
			let letters = try compiled("\{\"pattern\": \"^\\\\p\{Letter\}+$\"\}")
			assert accepts(letters, "\"Ωmega\"") && !accepts(letters, "\"a1\"")
			assert accepts(try compiled("\{\"pattern\": \"^[^]$\"\}"), "\"\\n\"")
			assert !accepts(try compiled("\{\"pattern\": \"[]\"\}"), "\"a\"")
			assert compiled("\{\"pattern\": \"a(?=b)\"\}") is error
			assert compiled("\{\"pattern\": \"\\\\a\"\}") is error
			return none
		}

		// Draft 7 content keywords assert only when asked.
		@test()
		def assertsDraft7ContentWhenAsked() !none {
			let text = "\{\"$schema\": \"http://json-schema.org/draft-07/schema#\", \"contentEncoding\": \"base64\", \"contentMediaType\": \"application/json\"\}"
			assert accepts(try compiled(text), "\"%\"")
			let strict = try compiled(text, CompileOptions{content: true})
			assert accepts(strict, "\"eyJhIjoxfQ==\"")
			assert !accepts(strict, "\"%\"") && !accepts(strict, "\"ezp9\"")
			return none
		}

		// at reaches a schema inside a document that is not one at its root,
		// with its references; formats include int32 and int64.
		@test()
		def reachesSchemasInsideDocuments() !none {
			let doc = try JSON.parse("\{\"components\": \{\"Pet\": \{\"type\": \"object\", \"properties\": \{\"age\": \{\"$ref\": \"#/components/Age\"\}\}\}, \"Age\": \{\"type\": \"integer\", \"format\": \"int32\"\}, \"Bad\": \{\"$ref\": \"#/nowhere\"\}\}\}")
			let root = try compile(true, CompileOptions{resources: map<string, any>{"urn:doc": doc}, formats: true})
			let pet = try root.at("urn:doc#/components/Pet")
			assert pet.valid(try JSON.parse("\{\"age\": 3\}"))
			assert !pet.valid(try JSON.parse("\{\"age\": 3000000000\}"))
			assert !pet.valid(try JSON.parse("\{\"age\": 1.5\}"))
			assert root.at("urn:doc#/components/Bad") is error
			assert root.at("urn:doc#/missing") is error
			return none
		}

		// A schema that is not one fails to compile.
		@test()
		def refusesBadSchemas() !none {
			assert compiled("3") is error
			assert compiled("\{\"$anchor\": \"1bad\"\}") is error
			assert compiled("\{\"type\": \"string\"\}") is Validator
			assert accepts(try compiled("true"), "1") && !accepts(try compiled("false"), "1")
			return none
		}

		// A string holding U+0000 given as its UTF-8 bytes: told apart from
		// the text without it, counted, matched and format-checked with it.
		@test()
		def readsStringsAsBytes() !none {
			let nul byte[] = [byte(0)]
			let withNul = "a".bytes() + nul
			let constant = try compile(map<string, any>{"const": withNul})
			assert constant.valid(withNul) && !constant.valid("a") && !constant.valid("a".bytes())
			let plain = try compiled("\{\"enum\": [\"a\"]\}")
			assert plain.valid("a".bytes()) && !plain.valid(withNul)
			let typed = try compiled("\{\"type\": \"string\", \"minLength\": 2, \"pattern\": \"^a\\\\u0000$\"\}")
			assert typed.valid(withNul) && !typed.valid("a".bytes())
			let date = try compiled("\{\"format\": \"date\"\}", CompileOptions{formats: true})
			assert date.valid("1963-06-19".bytes()) && !date.valid("1963-06-19".bytes() + nul)
			let pointer = try compiled("\{\"format\": \"json-pointer\"\}", CompileOptions{formats: true})
			assert pointer.valid("/a".bytes() + nul) && !pointer.valid("a".bytes() + nul)
			return none
		}
	}
}
