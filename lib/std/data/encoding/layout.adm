partial module std.data.encoding {
	use (
		std.reflection
		std.reflection::(Field, FieldKind)
		std.bytes::(Endian)
		std.io
	)

	// Qualified name of the `@binary` meta function, used to look up the field
	// options a Layout reads.
	internal const layoutAttr = "std.data.encoding.binary"

	// Reads and writes values in a fixed byte layout: every field at its declared width, in
	// declaration order, the way a file header, a network packet or a driver request is laid out.
	//
	// Integers take their width (`int8` 1 … `int64` 8; `int`/`uint` 8), `bool` one byte, `float32`
	// 4 and `float64` 8 (IEEE 754), `char` 4. A nested struct or type is laid inline. A `byte[]` or
	// `string` field needs `@binary(size = N)` and is zero-padded to N; an array of fixed-size
	// elements needs `@binary(count = N)`. `@binary(pad = N)` puts N zero bytes before a field,
	// `@binary(ignore)` leaves it out. Optionals, maps, `any` and variable-size fields without a
	// size are refused. With aligned, every field starts at a multiple of its natural alignment
	// and the record is padded to its largest alignment, as a C compiler lays a struct out.
	//
	//     struct Header {
	//         @binary(size = 4)
	//         magic   string
	//         version uint16
	//         flags   uint16
	//     }
	//
	//     let l = new Layout(Endian.Big)
	//     let raw = try l.encode(header)
	//     try l.decode(raw, header)
	type Layout {
		endian  Endian = Endian.Little
		aligned bool   = false

		def new(endian Endian = Endian.Little, aligned bool = false) {
			self.endian = endian
			self.aligned = aligned
		}

		// Bytes the value's layout takes. Fails when a field has no fixed size.
		def size(value any) !int {
			return try measure(value)
		}

		// The value laid out. Fails when a field has no fixed size or a byte[]/string is longer
		// than its size.
		def encode(value any) !byte[] {
			let total = try measure(value)
			let out byte[]
			out.len(total)
			try write(out, 0, value)
			return out
		}

		// Fills target from input. Fails when input is shorter than the layout or a field has no
		// fixed size.
		//
		// decode implements std.data.encoding.ByteDecoder.
		def decode(input byte[], target any) !none {
			let total = try measure(target)
			fail "layout: input is {input.len()} bytes, the layout takes {total}" when input.len() < total
			try read(input, 0, target)
			return none
		}

		// Writes the value's layout to the writer. Fails when a field has no fixed size, a
		// byte[]/string is longer than its size, or the writer does.
		//
		// encode implements std.data.encoding.StreamEncoder.
		def encode(writer io.Writer, value any) !none {
			let raw = try encode(value)
			try writer.write(raw)
			return none
		}

		// Fills target from what the reader yields. Fails when the reader ends before the layout
		// is full, the reader itself fails, or a field has no fixed size.
		//
		// decode implements std.data.encoding.StreamDecoder.
		def decode(reader io.Reader, target any) !none {
			let total = try measure(target)
			let chunk byte[]
			chunk.len(total)
			let all byte[] = []
			for all.len() < total {
				let got = try reader.read(chunk)
				fail "layout: the reader ended after {all.len()} of {total} bytes" when got <= 0
				all += chunk.slice(0, got)
			}
			return try decode(all.slice(0, total), target)
		}

		// Bytes a value takes: a record through its fields, a scalar at its own width.
		// Fails when a field has no fixed size.
		internal def measure(value any) !int {
			let kind = reflection.kindOf(value)
			if kind == FieldKind.Struct {
				let (total, _) = try measureRecord(value)
				return total
			}
			let name = reflection.typeName(value)
			let width = fixedWidth(name)
			fail "layout: {name} has no fixed size" when width == 0
			return width
		}

		// How many bytes a record takes and what it is aligned to. Fails when a field has no
		// fixed size.
		internal def measureRecord(value any) !(int, int) {
			let offset = 0
			let worst = 1
			for let (_, f) in reflection.fields(value) {
				continue when fieldFlag(f, layoutAttr, "ignore")
				offset += intAttr(f, "pad")
				let width = try fieldWidth(f)
				if aligned {
					let a = try fieldAlign(f)
					worst = a when a > worst
					offset = alignUp(offset, a)
				}
				offset += width
			}
			offset = alignUp(offset, worst) when aligned
			return (offset, worst)
		}

		// Lays a value out into buf starting at base. Fails when a field has no fixed size or is
		// longer than the width it was given.
		internal def write(buf byte[], base int, value any) !none {
			let kind = reflection.kindOf(value)
			if kind != FieldKind.Struct {
				let name = reflection.typeName(value)
				let width = fixedWidth(name)
				fail "layout: {name} has no fixed size" when width == 0
				putBits(buf, base, width, try boxedBits(value, name, kind, width), endian)
				return none
			}

			let offset = base
			for let (_, f) in reflection.fields(value) {
				continue when fieldFlag(f, layoutAttr, "ignore")
				offset += intAttr(f, "pad")
				let width = try fieldWidth(f)
				offset = alignUp(offset - base, try fieldAlign(f)) + base when aligned
				try writeField(buf, offset, f, width)
				offset += width
			}
			return none
		}

		// Reads a value out of buf starting at base. Fails when a field has no fixed size.
		internal def read(buf byte[], base int, target any) !none {
			expects {
				assert reflection.kindOf(target) == FieldKind.Struct onerror fail "layout: cannot read into a {reflection.typeName(target)}, which has no fields"
			}

			let offset = base
			for let (_, f) in reflection.fields(target) {
				continue when fieldFlag(f, layoutAttr, "ignore")
				offset += intAttr(f, "pad")
				let width = try fieldWidth(f)
				offset = alignUp(offset - base, try fieldAlign(f)) + base when aligned
				try readField(buf, offset, f, width)
				offset += width
			}
			return none
		}

		// Writes one field at the offset. Fails when it has no fixed size or holds more than its
		// width.
		internal def writeField(buf byte[], offset int, f Field, width int) !none {
			let kind = f.kind
			if kind == FieldKind.String {
				let raw = f.asString().bytes()
				fail "layout: `{f.name}` is {raw.len()} bytes, its @binary(size) is {width}" when raw.len() > width
				for let (i, b) in raw {
					buf[offset + i] = b
				}
				return none
			}
			return try writeArray(buf, offset, f) when kind == FieldKind.Array
			if kind == FieldKind.Struct {
				let nested = f.ensureValue()
				fail "layout: `{f.name}` holds no value" when nested is none
				return try write(buf, offset, nested)
			}
			putBits(buf, offset, width, try scalarBits(f, f.typeName, kind, width), endian)
			return none
		}

		// Writes the elements of an array field, leaving the rest of its width zero. Fails when
		// the array holds more elements than the layout reserves.
		internal def writeArray(buf byte[], offset int, f Field) !none {
			let (count, unit) = try arrayShape(f)
			let held = f.len()
			fail "layout: `{f.name}` holds {held} elements, its layout takes {count}" when held > count
			let name = elementTypeName(f.typeName)
			let kind = f.elemKind
			for let i = 0; i < held; i++ {
				putBits(buf, offset + i * unit, unit, try scalarBits(f.at(i), name, kind, unit), endian)
			}
			return none
		}

		// Reads one field from the offset. Fails when it has no fixed size.
		internal def readField(buf byte[], offset int, f Field, width int) !none {
			let kind = f.kind
			if kind == FieldKind.String {
				f.setString(string(buf.slice(offset, unpaddedLength(buf, offset, width))))
				return none
			}
			return try readArray(buf, offset, f) when kind == FieldKind.Array
			if kind == FieldKind.Struct {
				let nested = f.ensureValue()
				fail "layout: `{f.name}` holds no value" when nested is none
				return try read(buf, offset, nested)
			}
			try setBits(f, f.typeName, kind, width, getBits(buf, offset, width, endian))
			return none
		}

		// Fills an array field with every element the layout reserves. Fails when the element
		// type has no fixed size or the array cannot be resized.
		internal def readArray(buf byte[], offset int, f Field) !none {
			let (count, unit) = try arrayShape(f)
			fail "layout: `{f.name}` cannot be resized to {count} elements" unless f.setLen(count)
			let name = elementTypeName(f.typeName)
			let kind = f.elemKind
			for let i = 0; i < count; i++ {
				try setBits(f.at(i), name, kind, unit, getBits(buf, offset + i * unit, unit, endian))
			}
			return none
		}

		// Bytes one field takes. Fails when it has no fixed size.
		internal def fieldWidth(f Field) !int {
			let kind = f.kind
			if kind == FieldKind.String {
				let sized = intAttr(f, "size")
				fail "layout: string field `{f.name}` needs @binary(size = N)" when sized <= 0
				return sized
			}
			if kind == FieldKind.Array {
				let (count, unit) = try arrayShape(f)
				return count * unit
			}
			if kind == FieldKind.Struct {
				let nested = f.ensureValue()
				fail "layout: `{f.name}` holds no value" when nested is none
				let (total, _) = try measureRecord(nested)
				return total
			}
			let name = f.typeName
			let width = fixedWidth(name)
			fail "layout: field `{f.name}` of type {name} has no fixed size" when width == 0
			return width
		}

		// What a field starts at a multiple of when the layout is aligned: its own width for a
		// scalar, its element width for an array, its widest member for a record, one byte for
		// text. Fails when the field has no fixed size.
		internal def fieldAlign(f Field) !int {
			let kind = f.kind
			return 1 when kind == FieldKind.String
			if kind == FieldKind.Array {
				let (_, unit) = try arrayShape(f)
				return unit
			}
			if kind == FieldKind.Struct {
				let nested = f.ensureValue()
				fail "layout: `{f.name}` holds no value" when nested is none
				let (_, worst) = try measureRecord(nested)
				return worst
			}
			return try fieldWidth(f)
		}

		// How many elements an array field holds and how wide each one is. Fails when the count
		// is missing or the element type has no fixed size.
		internal def arrayShape(f Field) !(int, int) {
			let name = elementTypeName(f.typeName)
			let unit = fixedWidth(name)
			fail "layout: elements of `{f.name}` are {name}, which has no fixed size" when unit == 0

			let sized = intAttr(f, "size")
			if sized > 0 {
				fail "layout: @binary(size) on `{f.name}` applies to byte[] and string; use count" when unit != 1
				return (sized, unit)
			}

			let count = intAttr(f, "count")
			fail "layout: array field `{f.name}` needs @binary(count = N)" when count <= 0
			return (count, unit)
		}

		// The raw bits of a field or of one array element. Fails when the type is not one the
		// layout lays out.
		internal def scalarBits(f Field, name string, kind FieldKind, width int) !uint {
			return f.asBool() ?? (uint(1), uint(0)) when name == "bool"
			return uint(__bitcast_u32_from_f32(float32(f.asFloat()))) when name == "float32"
			return uint(__bitcast_u64_from_f64(float64(f.asFloat()))) when name := "float64" || "float"
			fail "layout: {name} is not laid out; use float32 or float64" when kind == FieldKind.Float
			return maskBits(f.asUint(), width) when kind == FieldKind.Uint
			return maskBits(uint(f.asInt()), width)
		}

		// Stores raw bits in a field or in one array element. Fails when the type is not one the
		// layout lays out.
		internal def setBits(f Field, name string, kind FieldKind, width int, bits uint) !none {
			if name == "bool" {
				f.setBool(bits != 0)
				return none
			}
			if name == "float32" {
				f.setFloat(float(__bitcast_f32_from_u32(uint32(bits))))
				return none
			}
			if name := "float64" || "float" {
				f.setFloat(float(__bitcast_f64_from_u64(uint64(bits))))
				return none
			}
			fail "layout: {name} is not laid out; use float32 or float64" when kind == FieldKind.Float
			if kind == FieldKind.Uint {
				f.setUint(bits)
				return none
			}
			f.setInt(signExtend(bits, width))
			return none
		}

		// The raw bits of a scalar handed to encode on its own rather than as a field. Fails
		// when the value is not a number, a bool or a character.
		internal def boxedBits(value any, name string, kind FieldKind, width int) !uint {
			let text = reflection.scalarText(value)
			fail "layout: a {name} value cannot be laid out on its own" when text == ""
			return text == "true" ?? (uint(1), uint(0)) when name == "bool"
			return uint(__bitcast_u32_from_f32(parseFloat<float32>(text))) when name == "float32"
			return uint(__bitcast_u64_from_f64(parseFloat<float64>(text))) when name := "float64" || "float"
			fail "layout: {name} is not laid out; use float32 or float64" when kind == FieldKind.Float
			return maskBits(uint(parseInt<uint64>(text)), width) when kind == FieldKind.Uint
			return maskBits(uint(parseInt<int64>(text)), width)
		}
	}

	// Bytes a type of that name takes in a layout, or 0 when it has no fixed width.
	internal def fixedWidth(name string) int {
		match name {
			case "bool", "int8", "uint8", "byte":
				return 1
			case "int16", "uint16":
				return 2
			case "int32", "uint32", "char", "float32":
				return 4
			case "int64", "uint64", "int", "uint", "float64", "float":
				return 8
			default:
				return 0
		}
	}

	// The element type of an array type name: "uint32" for "uint32[]".
	internal def elementTypeName(name string) string {
		return name.slice(0, name.len() - 2) when name.endsWith("[]")
		return name
	}

	// An integer option of a field's `@binary` annotation; 0 when absent.
	internal def intAttr(f Field, key string) int {
		let text = f.attr(layoutAttr, key)
		return 0 when text == ""
		return parseInt<int>(text)
	}

	// The next offset at or after off that is a multiple of unit.
	internal def alignUp(off int, unit int) int {
		return off when unit <= 1
		let rem = off % unit
		return off when rem == 0
		return off + unit - rem
	}

	// The low width bytes of bits.
	internal def maskBits(bits uint, width int) uint {
		return bits when width >= 8
		return bits & ((uint(1) << (width * 8)) - 1)
	}

	// The signed value of width bytes of bits.
	internal def signExtend(bits uint, width int) int {
		return int(bits) when width >= 8
		let top = uint(1) << (width * 8 - 1)
		return int(bits) when (bits & top) == 0
		return int(bits) - int(top << 1)
	}

	// Writes width bytes of bits at the offset, in the given byte order.
	internal def putBits(buf byte[], offset int, width int, bits uint, endian Endian) {
		for let i = 0; i < width; i++ {
			let shift = endian == Endian.Big ?? ((width - 1 - i) * 8, i * 8)
			buf[offset + i] = byte((bits >> shift) & 0xFF)
		}
	}

	// The width bytes at the offset, read in the given byte order.
	internal def getBits(buf byte[], offset int, width int, endian Endian) uint {
		let out uint = 0
		for let i = 0; i < width; i++ {
			let shift = endian == Endian.Big ?? ((width - 1 - i) * 8, i * 8)
			out = out | (uint(buf[offset + i]) << shift)
		}
		return out
	}

	// How much of a zero-padded text field is text: everything up to the first zero byte, or its
	// full width.
	internal def unpaddedLength(buf byte[], offset int, width int) int {
		for let i = 0; i < width; i++ {
			return i when buf[offset + i] == 0
		}
		return width
	}

	// The LEB128 varint of value: seven bits per byte, low group first, the high bit set on
	// every byte but the last.
	//
	//     putUvarint(300)   // [0xAC, 0x02]
	def putUvarint(value uint) byte[] {
		let out byte[] = []
		let rest = value
		for {
			let group = byte(rest & 0x7F)
			rest = rest >> 7
			if rest == 0 {
				out.push(group)
				break
			}
			out.push(group | 0x80)
		}
		return out
	}

	// The value at the start of input and how many bytes it took. Fails on a truncated or
	// overlong varint.
	def uvarint(input byte[]) !(uint, int) {
		let out uint = 0
		let shift = 0
		for let (i, group) in input {
			fail "varint: more than 64 bits of value at byte {i}" when i == 9 && group > 1
			out = out | (uint(group & 0x7F) << shift)
			return (out, i + 1) when (group & 0x80) == 0
			shift += 7
		}
		fail "varint: the value ends after {input.len()} bytes with its continuation bit set"
	}

	// The LEB128 varint of a signed value, zigzagged so that small negatives stay short.
	//
	//     putVarint(-1)   // [0x01]
	def putVarint(value int) byte[] {
		return putUvarint(zigzag(value))
	}

	// The signed value at the start of input and how many bytes it took. Fails on a truncated or
	// overlong varint.
	def varint(input byte[]) !(int, int) {
		let (bits, used) = try uvarint(input)
		return (unzigzag(bits), used)
	}

	// The zigzag form of a signed value: non-negatives doubled, negatives doubled and made odd,
	// so that -1 takes one byte rather than ten.
	internal def zigzag(value int) uint {
		return uint(value) * 2 when value >= 0
		return uint(-(value + 1)) * 2 + 1
	}

	// The signed value behind a zigzag form.
	internal def unzigzag(bits uint) int {
		return int(bits >> 1) when (bits & 1) == 0
		return -int(bits >> 1) - 1
	}
}
