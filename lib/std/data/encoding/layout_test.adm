partial module std.data.encoding {
	use (
		std.testing
		std.bytes
		std.bytes::(Endian)
	)

	// Fixtures. Each one exercises one part of the layout surface, so a failure names the
	// feature rather than "Layout is broken". All `internal`: an exported fixture would become
	// part of std.data.encoding's API.

	// Every integer width the layout lays out, signed and unsigned.
	internal struct LayoutInts {
		i8  int8
		u8  uint8
		i16 int16
		u16 uint16
		i32 int32
		u32 uint32
		i64 int64
		u64 uint64
		i   int
		u   uint
	}

	internal struct LayoutFloats {
		f32 float32
		f64 float64
	}

	internal struct LayoutFlags {
		on  bool
		off bool
	}

	internal struct LayoutPoint {
		x int16
		y int16
	}

	internal struct LayoutNested {
		tag    uint8
		origin LayoutPoint
		end    LayoutPoint
	}

	internal struct LayoutText {
		@binary(size = 8)
		name string
		@binary(size = 4)
		raw byte[]
	}

	internal struct LayoutCounted {
		@binary(count = 3)
		values uint16[]
		@binary(count = 2)
		deltas int32[]
	}

	internal struct LayoutPadded {
		flag uint8
		@binary(pad = 3)
		code uint32
	}

	internal struct LayoutSkipped {
		kept uint16
		@binary(ignore: true)
		note string
		also uint16
	}

	// The classic C alignment case: a byte, a word and a half word.
	internal struct LayoutAligned {
		a uint8
		b uint32
		c uint16
	}

	internal struct LayoutOpen {
		name string
	}

	// v4l2_capability, as `std/devices/v4l2.adm` documents it: 104 bytes, card at 16,
	// capabilities at 84, device_caps at 88.
	internal struct V4L2Capability {
		@binary(size = 16)
		driver string
		@binary(size = 32)
		card string
		@binary(size = 32)
		busInfo string
		version uint32
		capabilities uint32
		deviceCaps uint32
		@binary(count = 3)
		reserved uint32[]
	}

	// v4l2_requestbuffers: 20 bytes, count at 0, type at 4, memory at 8.
	internal struct V4L2RequestBuffers {
		count uint32
		kind uint32
		memory uint32
		capabilities uint32
		flags uint8
		@binary(size = 3)
		reserved byte[]
	}

	// Reports whether the value lays out, so a test can assert that it does not.
	internal def laysOut(codec Layout, value any) !bool {
		let _ = try codec.encode(value)
		return true
	}

	// Reports whether the input fills the target, so a test can assert that it does not.
	internal def fills(codec Layout, input byte[], target any) !bool {
		try codec.decode(input, target)
		return true
	}

	// How many bytes the varint at the start of input takes.
	internal def uvarintUsed(input byte[]) !int {
		let (_, used) = try uvarint(input)
		return used
	}

	check "Layout" {
		@test()
		def TestLayoutIntegerWidths() !none {
			let little = new Layout(Endian.Little)
			assert (try little.size(LayoutInts{})) == 46

			let src = LayoutInts{
				i8: -2, u8: 250, i16: -300, u16: 65000, i32: -70000, u32: 4000000000,
				i64: -5000000000, u64: 18446744073709551615, i: -1, u: 12345678901234567890,
			}

			for let (_, endian) in [Endian.Little, Endian.Big] {
				let codec = new Layout(endian)
				let raw = try codec.encode(src)
				assert raw.len() == 46
				let back = LayoutInts{}
				try codec.decode(raw, back)
				assert back.i8 == -2
				assert back.u8 == 250
				assert back.i16 == -300
				assert back.u16 == 65000
				assert back.i32 == -70000
				assert back.u32 == 4000000000
				assert back.i64 == -5000000000
				assert back.u64 == 18446744073709551615
				assert back.i == -1
				assert back.u == 12345678901234567890
			}

			// Byte order is the only difference between the two.
			let one = LayoutInts{u32: 0x12345678}
			let beRaw = try (new Layout(Endian.Big)).encode(one)
			let leRaw = try little.encode(one)
			// u32 sits at 10: after int8, uint8, int16, uint16 and int32. `slice` on an array
			// takes a start and a count, unlike `slice` on a string, which takes two offsets.
			assert beRaw.slice(10, 4).hex() == "12345678"
			assert leRaw.slice(10, 4).hex() == "78563412"
		}

		@test()
		def TestLayoutScalarValue() !none {
			let codec = new Layout(Endian.Big)
			assert (try codec.size(uint32(5))) == 4
			assert (try codec.encode(uint32(5))).hex() == "00000005"
			assert (try codec.encode(int8(-1))).hex() == "FF"
			assert (try codec.encode(true)).hex() == "01"
			assert (try codec.encode(float32(1.5))).hex() == "3FC00000"
		}

		@test()
		def TestLayoutFloats() !none {
			let codec = new Layout(Endian.Little)
			assert (try codec.size(LayoutFloats{})) == 12

			let raw = try codec.encode(LayoutFloats{f32: 1.5, f64: -2.5})
			// IEEE 754: 1.5 is 0x3FC00000, -2.5 is 0xC004000000000000.
			assert raw.slice(0, 4).hex() == "0000C03F"
			assert raw.slice(4, 8).hex() == "00000000000004C0"

			let back = LayoutFloats{}
			try codec.decode(raw, back)
			assert back.f32 == 1.5
			assert back.f64 == -2.5
		}

		@test()
		def TestLayoutBools() !none {
			let codec = new Layout()
			let raw = try codec.encode(LayoutFlags{on: true, off: false})
			assert raw.hex() == "0100"
			let back = LayoutFlags{on: false, off: true}
			try codec.decode(raw, back)
			assert back.on
			assert !back.off
		}

		@test()
		def TestLayoutNested() !none {
			let codec = new Layout(Endian.Big)
			let src = LayoutNested{tag: 7}
			src.origin.x = 1
			src.origin.y = -1
			src.end.x = 258
			src.end.y = 3

			assert (try codec.size(src)) == 9
			let raw = try codec.encode(src)
			assert raw.hex() == "070001FFFF01020003"

			let back = LayoutNested{}
			try codec.decode(raw, back)
			assert back.tag == 7
			assert back.origin.x == 1
			assert back.origin.y == -1
			assert back.end.x == 258
			assert back.end.y == 3
		}

		@test()
		def TestLayoutFixedText() !none {
			let codec = new Layout()
			assert (try codec.size(LayoutText{})) == 12

			let raw = try codec.encode(LayoutText{name: "cam", raw: byte[1, 2]})
			assert raw.hex() == "63616D000000000001020000"

			let back = LayoutText{}
			try codec.decode(raw, back)
			assert back.name == "cam"
			assert back.raw.len() == 4
			assert back.raw.hex() == "01020000"

			// Exactly its width still fits, and one byte more does not.
			assert try laysOut(codec, LayoutText{name: "12345678"})
			let longName = laysOut(codec, LayoutText{name: "123456789"}) onerror recover false
			assert !longName
			let longBytes = laysOut(codec, LayoutText{raw: byte[1, 2, 3, 4, 5]}) onerror recover false
			assert !longBytes
		}

		@test()
		def TestLayoutCountedArrays() !none {
			let codec = new Layout(Endian.Big)
			assert (try codec.size(LayoutCounted{})) == 14

			let raw = try codec.encode(LayoutCounted{values: uint16[1, 2, 3], deltas: int32[-1, 2]})
			assert raw.hex() == "000100020003FFFFFFFF00000002"

			let back = LayoutCounted{}
			try codec.decode(raw, back)
			assert back.values.len() == 3
			assert back.values[2] == 3
			assert back.deltas.len() == 2
			assert back.deltas[0] == -1
			assert back.deltas[1] == 2

			// A short array is zero-filled; a long one does not fit.
			let short = try codec.encode(LayoutCounted{values: uint16[9]})
			assert short.slice(0, 6).hex() == "000900000000"
			let tooMany = laysOut(codec, LayoutCounted{values: uint16[1, 2, 3, 4]}) onerror recover false
			assert !tooMany
		}

		@test()
		def TestLayoutPadAndIgnore() !none {
			let codec = new Layout(Endian.Big)

			assert (try codec.size(LayoutPadded{})) == 8
			let padded = try codec.encode(LayoutPadded{flag: 0xAB, code: 0x01020304})
			assert padded.hex() == "AB00000001020304"
			let backPadded = LayoutPadded{}
			try codec.decode(padded, backPadded)
			assert backPadded.flag == 0xAB
			assert backPadded.code == 0x01020304

			assert (try codec.size(LayoutSkipped{})) == 4
			let skipped = try codec.encode(LayoutSkipped{kept: 1, note: "left out", also: 2})
			assert skipped.hex() == "00010002"
			let backSkipped = LayoutSkipped{note: "kept as it was"}
			try codec.decode(skipped, backSkipped)
			assert backSkipped.kept == 1
			assert backSkipped.also == 2
			assert backSkipped.note == "kept as it was"
		}

		@test()
		def TestLayoutAligned() !none {
			let packed = new Layout(Endian.Little)
			let aligned = new Layout(Endian.Little, true)
			let src = LayoutAligned{a: 0x11, b: 0x22334455, c: 0x6677}

			assert (try packed.size(src)) == 7
			assert (try aligned.size(src)) == 12

			// a at 0, b at 4, c at 8, the record rounded up to 12 -- as a C compiler lays it out.
			let raw = try aligned.encode(src)
			assert raw.len() == 12
			assert raw.hex() == "110000005544332277660000"

			let back = LayoutAligned{}
			try aligned.decode(raw, back)
			assert back.a == 0x11
			assert back.b == 0x22334455
			assert back.c == 0x6677
		}

		@test()
		def TestLayoutRefusals() !none {
			let codec = new Layout()

			// A string with no @binary(size) has no fixed width.
			let open = laysOut(codec, LayoutOpen{name: "x"}) onerror recover false
			assert !open

			// Input shorter than the layout.
			let raw = try codec.encode(LayoutNested{tag: 1})
			let short = fills(codec, raw.slice(0, 8), LayoutNested{}) onerror recover false
			assert !short
			assert try fills(codec, raw, LayoutNested{})
		}

		@test()
		def TestLayoutInterfaces() !none {
			// Layout carries the module's byte and stream interfaces. `encode(any) !byte[]`
			// fails, so ByteEncoder, which cannot, is not among them.
			let byteDecoder ByteDecoder = new Layout()
			let flags = LayoutFlags{}
			try byteDecoder.decode(byte[1, 0], flags)
			assert flags.on
			assert !flags.off

			let streamEncoder StreamEncoder = new Layout()
			let sink = new bytes.Buffer()
			try streamEncoder.encode(sink, LayoutPoint{x: 1, y: -1})

			let streamDecoder StreamDecoder = new Layout()
			let source = new bytes.Buffer(sink.bytes())
			let point = LayoutPoint{}
			try streamDecoder.decode(source, point)
			assert point.x == 1
			assert point.y == -1
		}

		@test()
		def TestUvarint() !none {
			assert putUvarint(0).hex() == "00"
			assert putUvarint(1).hex() == "01"
			assert putUvarint(127).hex() == "7F"
			assert putUvarint(128).hex() == "8001"
			assert putUvarint(300).hex() == "AC02"
			// 2^63 takes all ten bytes.
			assert putUvarint(uint(1) << 63).hex() == "808080808080808080" + "01"

			for let (_, value) in [uint(0), uint(1), uint(127), uint(128), uint(300), uint(1) << 63, uint(18446744073709551615)] {
				let raw = putUvarint(value)
				let (back, used) = try uvarint(raw)
				assert back == value
				assert used == raw.len()
			}

			// Trailing bytes are left alone.
			let (first, used) = try uvarint(byte[0xAC, 0x02, 0x7F])
			assert first == 300
			assert used == 2
		}

		@test()
		def TestUvarintRefusals() {
			// A varint that fails reads as taking no bytes at all.
			// A continuation bit with nothing after it.
			let truncated = uvarintUsed(byte[0x80]) onerror recover 0
			assert truncated == 0
			let noInput = uvarintUsed(byte[]) onerror recover 0
			assert noInput == 0
			// More than 64 bits of value.
			let overlong = uvarintUsed(byte[0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x02]) onerror recover 0
			assert overlong == 0
		}

		@test()
		def TestVarint() !none {
			// Zigzag: -1 takes one byte, 1 takes two units of it.
			assert putVarint(-1).hex() == "01"
			assert putVarint(1).hex() == "02"
			assert putVarint(0).hex() == "00"
			assert putVarint(-2).hex() == "03"
			assert putVarint(63).hex() == "7E"
			assert putVarint(-64).hex() == "7F"

			for let (_, value) in [0, 1, -1, 63, -64, 300, -300, 9223372036854775807, -9223372036854775808] {
				let raw = putVarint(value)
				let (back, used) = try varint(raw)
				assert back == value
				assert used == raw.len()
			}
		}

		// The acceptance test: the hand-written V4L2 structures of std/devices/v4l2.adm, laid
		// out by Layout instead, checked against the offsets documented there.
		@test()
		def TestLayoutV4L2Capability() !none {
			let codec = new Layout(Endian.Little)
			assert (try codec.size(V4L2Capability{})) == 104

			let src = V4L2Capability{
				driver:       "uvcvideo",
				card:         "Integrated Camera",
				busInfo:      "usb-0000:00:14.0-8",
				version:      0x00050F00,
				capabilities: 0x84200001,
				deviceCaps:   0x04200001,
			}
			let raw = try codec.encode(src)
			assert raw.len() == 104

			// driver 0, card 16, bus_info 48, version 80, capabilities 84, device_caps 88.
			assert string(raw.slice(0, 8)) == "uvcvideo"
			assert raw.slice(8, 8).hex() == "0000000000000000"
			assert string(raw.slice(16, 17)) == "Integrated Camera"
			assert string(raw.slice(48, 18)) == "usb-0000:00:14.0-8"
			assert getBits(raw, 80, 4, Endian.Little) == 0x00050F00
			assert getBits(raw, 84, 4, Endian.Little) == 0x84200001
			assert getBits(raw, 88, 4, Endian.Little) == 0x04200001
			assert raw.slice(92, 12).hex() == "000000000000000000000000"

			let back = V4L2Capability{}
			try codec.decode(raw, back)
			assert back.driver == "uvcvideo"
			assert back.card == "Integrated Camera"
			assert back.busInfo == "usb-0000:00:14.0-8"
			assert back.version == 0x00050F00
			assert back.capabilities == 0x84200001
			assert back.deviceCaps == 0x04200001
			assert back.reserved.len() == 3
		}

		@test()
		def TestLayoutV4L2RequestBuffers() !none {
			let codec = new Layout(Endian.Little)
			assert (try codec.size(V4L2RequestBuffers{})) == 20

			// What encodeRequestBuffers writes: four buffers, capture type, mapped memory.
			let raw = try codec.encode(V4L2RequestBuffers{count: 4, kind: 1, memory: 1})
			assert raw.len() == 20
			assert getBits(raw, 0, 4, Endian.Little) == 4
			assert getBits(raw, 4, 4, Endian.Little) == 1
			assert getBits(raw, 8, 4, Endian.Little) == 1
			assert raw.slice(12, 8).hex() == "0000000000000000"

			// What the driver answers with: fewer buffers than were asked for.
			let answer = try codec.encode(V4L2RequestBuffers{count: 2, kind: 1, memory: 1})
			let back = V4L2RequestBuffers{}
			try codec.decode(answer, back)
			assert back.count == 2
			assert back.kind == 1
			assert back.memory == 1
			assert back.reserved.len() == 3
		}
	}
}
