partial module std.data.encoding {
	use (
		std.io
	)

	// MsgPack is the MessagePack codec. Not implemented yet.
	type MsgPack {
		// encode renders obj as MessagePack. Not implemented yet: returns no bytes.
		def encode(obj any) byte[] {
			return []
		}

		// encode writes obj as MessagePack to the writer. Not implemented yet.
		// It cannot fail yet.
		def encode(writer io.Writer, obj any) !none {}

		// decode fills target from MessagePack data. Not implemented yet.
		// It cannot fail yet.
		def decode(input byte[], target any) !none {
			return none
		}

		// decode fills target from MessagePack read from the reader. Not implemented
		// yet.
		// It cannot fail yet.
		def decode(reader io.Reader, target any) !none {}
	}
}
