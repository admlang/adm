partial module std.data.encoding {
	use (
		std.io
		std.time
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.data.encoding.json::(fieldFlag, fieldIsEmpty, recordFlag, quote)
		std.data.encoding.cbor::(validUTF8)
		std.data.encoding.msgpack::*
	)

	// What one MessagePack object is (the type system of the MessagePack
	// specification).
	enum MsgPackKind {
		Nil,
		Bool,
		// An integer from -2^63 to 2^64 - 1.
		Int,
		// A float32 or float64.
		Float,
		// A str: UTF-8 text, kept as the bytes it arrived as.
		Str,
		// A bin: a byte array.
		Bin,
		Array,
		// Key and value pairs, in the order they were read or added.
		Map,
		// An extension: a type number (-128 to 127) and its data. Type -1 is
		// the timestamp extension.
		Ext
	}

	// One MessagePack object, read from data or built to encode.
	//
	//     let m = new MsgPackValue(MsgPackKind.Map)
	//     m.set("id", new MsgPackValue(7))
	//     m.set("at", new MsgPackValue(time.now()))
	//     let data = new MsgPack().encode(m)
	//
	//     let item = try new MsgPack().parse(data)
	//     let id = try item.get("id").asInt()
	type MsgPackValue {
		internal k     MsgPackKind    = MsgPackKind.Nil
		// An Int is -1 - n when neg is set, n otherwise.
		internal neg   bool
		internal n     uint64
		internal f     float
		// A Float that is a float32 on the wire.
		internal f32   bool
		internal ext   int
		internal raw   byte[]
		internal items MsgPackValue[]
		internal vals  MsgPackValue[]

		// What the object is.
		kind MsgPackKind {
			def get() MsgPackKind {
				return k
			}
		}

		// The type number of an Ext object, 0 otherwise.
		extType int {
			def get() int {
				return k == MsgPackKind.Ext ?? (ext, 0)
			}
		}

		// nil.
		def new() {}

		// An empty object of a kind with no content: an empty Array, Map, Str
		// or Bin, or false. Other kinds read as nil.
		def new(kind MsgPackKind) {
			match kind {
				case MsgPackKind.Array, MsgPackKind.Map, MsgPackKind.Str, MsgPackKind.Bin, MsgPackKind.Bool:
					k = kind
				default:
					k = MsgPackKind.Nil
			}
		}

		// An integer.
		def new(v int) {
			k = MsgPackKind.Int
			if v < 0 {
				neg = true
				n = uint64(-1 - v)
			} else {
				n = uint64(v)
			}
		}

		// A non-negative integer up to 2^64 - 1.
		def new(v uint64) {
			k = MsgPackKind.Int
			n = v
		}

		// A float64.
		def new(v float) {
			k = MsgPackKind.Float
			f = v
		}

		// A float32.
		def new(v float32) {
			k = MsgPackKind.Float
			f = float(v)
			f32 = true
		}

		def new(v bool) {
			k = MsgPackKind.Bool
			n = v ?? (uint64(1), uint64(0))
		}

		// A str.
		def new(v string) {
			k = MsgPackKind.Str
			raw = v.bytes()
		}

		// A bin.
		def new(v byte[]) {
			k = MsgPackKind.Bin
			raw = v
		}

		// An array of the objects.
		def new(v MsgPackValue[]) {
			k = MsgPackKind.Array
			items = v
		}

		// An extension object. The type number is taken modulo 256 as a
		// signed byte.
		def new(extType int, data byte[]) {
			k = MsgPackKind.Ext
			ext = int(int8(extType))
			raw = data
		}

		// A timestamp (extension type -1) for the instant, in the smallest of
		// the three timestamp formats that holds it.
		def new(t time.Time) {
			let ns = t.unixNs()
			let sec = ns / 1000000000
			let nsec = ns % 1000000000
			if nsec < 0 {
				sec--
				nsec += 1000000000
			}
			k = MsgPackKind.Ext
			ext = -1
			raw = mpTimestampBytes(sec, int(nsec))
		}

		// The integer, or fails when the object is not an integer or lies
		// outside the int range.
		def asInt() !int {
			fail "msgpack: {mpDescribe(self)} is not an integer" when k != MsgPackKind.Int
			fail "msgpack: integer does not fit an int" when n > uint64(0x7FFFFFFFFFFFFFFF)
			return neg ?? (-1 - int(n), int(n))
		}

		// The non-negative integer, or fails when the object is not one.
		def asUint() !uint64 {
			fail "msgpack: {mpDescribe(self)} is not a non-negative integer" when k != MsgPackKind.Int || neg
			return n
		}

		// The number of a Float, or of an Int that a float holds exactly.
		// Fails for anything else.
		def asFloat() !float {
			return f when k == MsgPackKind.Float
			return neg ?? (-1.0 - float(n), float(n)) when k == MsgPackKind.Int && n <= uint64(9007199254740992)
			fail "msgpack: {mpDescribe(self)} is not a number"
		}

		// The truth value, or fails when the object is not a bool.
		def asBool() !bool {
			fail "msgpack: {mpDescribe(self)} is not a bool" when k != MsgPackKind.Bool
			return n == uint64(1)
		}

		// The text of a Str. Fails for anything else, for bytes that are not
		// UTF-8, and for text holding U+0000, which a string cannot carry.
		def asString() !string {
			fail "msgpack: {mpDescribe(self)} is not a str" when k != MsgPackKind.Str
			fail "msgpack: str is not UTF-8" when !validUTF8(raw)
			fail "msgpack: str holds U+0000" when raw.indexOf(byte(0)) >= 0
			return string(raw)
		}

		// The bytes of a Bin, the raw bytes of a Str or the data of an Ext.
		// Fails for anything else.
		def asBytes() !byte[] {
			fail "msgpack: {mpDescribe(self)} has no bytes" when k != MsgPackKind.Bin && k != MsgPackKind.Str && k != MsgPackKind.Ext
			return raw
		}

		// The timestamp an Ext of type -1 holds, as seconds since the Unix
		// epoch and nanoseconds (0 to 999999999), over the whole range the
		// 96-bit form allows. Fails for anything else and for a malformed
		// timestamp.
		def asTimestamp() !(int64, int) {
			fail "msgpack: {mpDescribe(self)} is not a timestamp" when k != MsgPackKind.Ext || ext != -1
			return try mpTimestamp(raw)
		}

		// The instant a timestamp holds. Fails for anything else, and for a
		// timestamp outside what time.Time holds (about 1677 to 2262).
		def asTime() !time.Time {
			let (sec, nsec) = try asTimestamp()
			let ns = bigint(sec) * bigint(1000000000) + bigint(nsec)
			fail "msgpack: timestamp {sec}s lies outside the range of time.Time" when ns < -(bigint(1) << 63) || ns >= bigint(1) << 63
			return time.fromUnixNs(int64(ns))
		}

		// The elements of an Array; empty for anything else.
		def elements() MsgPackValue[] {
			return items when k == MsgPackKind.Array
			return []
		}

		// The entries of a Map, in order; empty for anything else.
		def entries() (MsgPackValue, MsgPackValue)[] {
			let out (MsgPackValue, MsgPackValue)[] = []
			return out when k != MsgPackKind.Map
			for let (i, key) in items {
				out.push((key, vals[i]))
			}
			return out
		}

		// The number of elements of an Array, entries of a Map or bytes of a
		// Str, Bin or Ext; 0 for anything else.
		def len() int {
			match k {
				case MsgPackKind.Array, MsgPackKind.Map:
					return items.len()
				case MsgPackKind.Str, MsgPackKind.Bin, MsgPackKind.Ext:
					return raw.len()
				default:
					return 0
			}
		}

		// The element of an Array at index; nil when out of range or not an
		// array.
		def at(index int) MsgPackValue {
			return new MsgPackValue() when k != MsgPackKind.Array || index < 0 || index >= items.len()
			return items[index]
		}

		// The Map entry under key; nil when absent or not a map (has tells
		// the two apart).
		def get(key MsgPackValue) MsgPackValue {
			let i = indexOf(key)
			return new MsgPackValue() when i < 0
			return vals[i]
		}

		// The Map entry under an integer key; nil when absent or not a map.
		def get(key int) MsgPackValue {
			let i = indexOf(key)
			return new MsgPackValue() when i < 0
			return vals[i]
		}

		// The Map entry under a str key; nil when absent or not a map.
		def get(key string) MsgPackValue {
			let i = indexOf(key)
			return new MsgPackValue() when i < 0
			return vals[i]
		}

		// Reports whether a Map holds an entry under key.
		def has(key MsgPackValue) bool {
			return indexOf(key) >= 0
		}

		// Reports whether a Map holds an entry under key.
		def has(key int) bool {
			return indexOf(key) >= 0
		}

		// Reports whether a Map holds an entry under key.
		def has(key string) bool {
			return indexOf(key) >= 0
		}

		// The position of key among a Map's entries; -1 when absent or not a
		// map.
		def indexOf(key MsgPackValue) int {
			return -1 when k != MsgPackKind.Map
			for let (i, have) in items {
				return i when have.equals(key)
			}
			return -1
		}

		// The position of an integer key; -1 when absent or not a map.
		def indexOf(key int) int {
			return -1 when k != MsgPackKind.Map
			let isNeg = key < 0
			let mag = isNeg ?? (uint64(-1 - key), uint64(key))
			for let (i, have) in items {
				return i when have.k == MsgPackKind.Int && have.neg == isNeg && have.n == mag
			}
			return -1
		}

		// The position of a str key; -1 when absent or not a map.
		def indexOf(key string) int {
			return -1 when k != MsgPackKind.Map
			let want = key.bytes()
			for let (i, have) in items {
				return i when have.k == MsgPackKind.Str && have.raw.equals(want)
			}
			return -1
		}

		// Sets the entry under key in a Map, replacing an equal key in place
		// or adding it at the end, and returns the map. Does nothing to an
		// object that is not a map.
		def set(key MsgPackValue, value MsgPackValue) MsgPackValue {
			return self when k != MsgPackKind.Map
			for let (i, have) in items {
				if have.equals(key) {
					vals[i] = value
					return self
				}
			}
			items.push(key)
			vals.push(value)
			return self
		}

		// Sets the entry under an integer key; see set(MsgPackValue, MsgPackValue).
		def set(key int, value MsgPackValue) MsgPackValue {
			return set(new MsgPackValue(key), value)
		}

		// Sets the entry under a str key; see set(MsgPackValue, MsgPackValue).
		def set(key string, value MsgPackValue) MsgPackValue {
			return set(new MsgPackValue(key), value)
		}

		// Removes the entry under key from a Map and returns the map.
		def remove(key MsgPackValue) MsgPackValue {
			return self when k != MsgPackKind.Map
			for let (i, have) in items {
				if have.equals(key) {
					items.remove(i)
					vals.remove(i)
					break
				}
			}
			return self
		}

		// Appends an element to an Array and returns the array. Does nothing
		// to an object that is not an array.
		def push(item MsgPackValue) MsgPackValue {
			items.push(item) when k == MsgPackKind.Array
			return self
		}

		// Reports whether two objects hold the same value: equal kinds and
		// contents, map entries in the same order. A float and an integer are
		// never equal, float32 and float64 compare by value, and NaN equals
		// NaN.
		def equals(other MsgPackValue) bool {
			return false when k != other.k
			match k {
				case MsgPackKind.Int:
					return neg == other.neg && n == other.n
				case MsgPackKind.Str, MsgPackKind.Bin:
					return raw.equals(other.raw)
				case MsgPackKind.Ext:
					return ext == other.ext && raw.equals(other.raw)
				case MsgPackKind.Bool:
					return n == other.n
				case MsgPackKind.Float:
					return (f != f && other.f != other.f) || f == other.f
				case MsgPackKind.Array, MsgPackKind.Map:
					return false when items.len() != other.items.len()
					for let (i, item) in items {
						return false when !item.equals(other.items[i])
						return false when k == MsgPackKind.Map && !vals[i].equals(other.vals[i])
					}
					return true
				default:
					return true
			}
		}

		// The object as text: `nil`, `true`, `1`, `-1`, `1.5`, `"text"`,
		// `h'0102'` for a bin, `[1, 2]`, `{"a": 1}`, `ext(1, h'ff')`, `NaN`,
		// `Infinity`.
		def str() string {
			match k {
				case MsgPackKind.Int:
					return neg ?? ((-bigint(1) - bigint(n)).toRadix(10), n.str())
				case MsgPackKind.Bin:
					return "h'" + raw.hex().lower() + "'"
				case MsgPackKind.Str:
					return quote(string(raw)) when validUTF8(raw) && raw.indexOf(byte(0)) < 0
					return "s'" + raw.hex().lower() + "'"
				case MsgPackKind.Ext:
					return "ext({ext}, h'" + raw.hex().lower() + "')"
				case MsgPackKind.Array:
					let out = "["
					for let (i, item) in items {
						out += ", " when i > 0
						out += item.str()
					}
					return out + "]"
				case MsgPackKind.Map:
					let out = "\{"
					for let (i, key) in items {
						out += ", " when i > 0
						out += key.str() + ": " + vals[i].str()
					}
					return out + "\}"
				case MsgPackKind.Bool:
					return n == uint64(1) ?? ("true", "false")
				case MsgPackKind.Float:
					return "NaN" when f != f
					return "Infinity" when f > 1.7976931348623157e308
					return "-Infinity" when f < -1.7976931348623157e308
					let text = f.str()
					return text when text.contains(".") || text.contains("e")
					return text + ".0"
				default:
					return "nil"
			}
		}
	}

	// Qualified name of the `@msgpack` meta function, used to look up field
	// options.
	internal const msgpackAttr = "std.data.encoding.msgpack"

	// MsgPack encodes and decodes MessagePack
	// (https://github.com/msgpack/msgpack/blob/master/spec.md).
	//
	//     let mp = new MsgPack()
	//     let data = mp.encode(user)
	//     try mp.decode(data, user)
	//
	//     let item = try mp.parse(data)   // a MsgPackValue tree
	//
	// `encode` takes a MsgPackValue, a scalar, an array, a `map<string, V>`
	// or an object. An object becomes a map from field names to values,
	// `byte[]` a bin, an enum member its value, a `time.Time` a timestamp
	// (extension type -1), `float32` a float32 and `float` a float64.
	// Integers and lengths always take their smallest format. A bigint
	// outside -2^63 to 2^64 - 1 has no MessagePack form and is written as
	// nil, as is anything nested deeper than maxDepth.
	//
	// Per-field behaviour comes from `@msgpack` annotations:
	//
	//     @msgpack("user_id")         encode under this key instead of the field name
	//     @msgpack(omitempty = true)  leave the field out when it holds its zero value
	//     @msgpack(ignore = true)     never encode or decode the field
	//
	// The decoder accepts every format of the specification and refuses the
	// never-used byte 0xc1, lengths that run past the data, maps with
	// duplicate keys and nesting deeper than maxDepth. A str is kept as its
	// bytes; reading it as a string checks it is UTF-8.
	type MsgPack {
		// How deep arrays and maps may nest before decoding fails, and how
		// deep encode walks objects before writing nil.
		maxDepth int = 128

		// encode renders obj as MessagePack.
		def encode(obj any) byte[] {
			let out byte[]
			mpEncodeAny(self, out, obj, 0)
			return out
		}

		// encode writes obj as MessagePack to the writer. Fails when the
		// writer does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// Reads the one object the bytes hold. Fails when they are not
		// exactly one well-formed object.
		def parse(input byte[]) !MsgPackValue {
			let r = new MsgPackReader(input)
			r.maxDepth = maxDepth
			let item = try r.next()
			fail "msgpack: {input.len() - r.pos} bytes of trailing data" when r.pos < input.len()
			return item
		}

		// decode binds the one object the bytes hold onto target: a map onto
		// an object's fields by `@msgpack` name or field name, arrays and maps
		// onto array and `map<string, V>` fields, a timestamp onto a
		// `time.Time`. Unknown keys are skipped; nil leaves a field at its
		// zero value. Fails when the bytes do not parse or a value does not
		// fit its field.
		def decode(input byte[], target any) !none {
			let item = try parse(input)
			return try mpBind(item, target, 0, maxDepth)
		}

		// decode reads everything the reader yields and binds the one object
		// it holds onto target. Fails when the reader does or the data does
		// not decode.
		def decode(reader io.Reader, target any) !none {
			let chunk byte[]
			chunk.len(4096)
			let all byte[]
			for {
				let n = try reader.read(chunk)
				break when n <= 0
				all += chunk.slice(0, n)
			}
			return try decode(all, target)
		}
	}

	// Reads MessagePack objects one after another, from bytes or from a
	// stream: objects that sit inside other data, or a connection carrying
	// one object after another (MessagePack-RPC).
	//
	//     let r = new MsgPackReader(conn)
	//     for try r.more() {
	//         let message = try r.next()
	//     }
	type MsgPackReader {
		internal data byte[]
		internal i    int        = 0
		// Bytes dropped from the front of data, so pos counts from the start.
		internal base int        = 0
		internal src  ?io.Reader

		// How deep arrays and maps may nest before next fails.
		maxDepth int = 128

		// Offset of the next object from the start of the data or stream.
		pos int {
			def get() int {
				return base + i
			}
		}

		// Reads from the bytes.
		def new(data byte[]) {
			self.data = data
		}

		// Reads from the reader, buffering what it yields.
		def new(reader io.Reader) {
			src = reader
		}

		// Reports whether another object follows, reading from the stream
		// when the buffer is empty. Fails when the reader does.
		def more() !bool {
			return true when i < data.len()
			return false when src is none
			return try mpFill(self, 1)
		}

		// Reads the next object and moves past it. Fails when the data ends
		// mid-object, the object is malformed or the reader fails; pos is
		// then unspecified.
		def next() !MsgPackValue {
			return try mpRead(self, 0)
		}
	}

	// Controls how a field is encoded to and decoded from MessagePack.
	//
	//     name       map key to use instead of the field name
	//     omitempty  leave the field out when it holds its zero value
	//     ignore     never encode or decode the field
	//
	//     struct User {
	//         @msgpack("user_id")
	//         id int
	//     }
	meta def msgpack(ctx FieldMetaContext, name string = "", omitempty bool = false, ignore bool = false) {
		let store MetadataStore = ctx.ctx.storage
		mpRecord(store, name, omitempty, ignore)
	}

	// Controls how a property is encoded to and decoded from MessagePack.
	// Takes the same options as the field form above.
	meta def msgpack(ctx PropertyMetaContext, name string = "", omitempty bool = false, ignore bool = false) {
		let store MetadataStore = ctx.ctx.storage
		mpRecord(store, name, omitempty, ignore)
	}

	// Writes one object tree.
	internal def mpEncodeValue(out byte[], v MsgPackValue) {
		match v.k {
			case MsgPackKind.Int:
				mpInt(out, v.neg, v.n)
			case MsgPackKind.Float:
				if v.f32 {
					mpFloat32(out, float32(v.f))
				} else {
					mpFloat64(out, v.f)
				}
			case MsgPackKind.Bool:
				out.push(byte(v.n == uint64(1) ?? (0xC3, 0xC2)))
			case MsgPackKind.Str:
				mpStr(out, v.raw)
			case MsgPackKind.Bin:
				mpBin(out, v.raw)
			case MsgPackKind.Ext:
				mpExt(out, v.ext, v.raw)
			case MsgPackKind.Array:
				mpArrayHead(out, v.items.len())
				for let (_, item) in v.items {
					mpEncodeValue(out, item)
				}
			case MsgPackKind.Map:
				mpMapHead(out, v.items.len())
				for let (i, key) in v.items {
					mpEncodeValue(out, key)
					mpEncodeValue(out, v.vals[i])
				}
			default:
				out.push(byte(0xC0))
		}
	}

	// Writes any value the codec accepts.
	internal def mpEncodeAny(c MsgPack, out byte[], obj any, depth int) {
		match obj {
			case MsgPackValue:
				mpEncodeValue(out, obj)
				return
			case byte[]:
				mpBin(out, obj)
				return
			case time.Time:
				mpEncodeValue(out, new MsgPackValue(obj))
				return
			case float32:
				mpFloat32(out, obj)
				return
			case duration:
				mpSignedInt(out, int(obj))
				return
			case bigint:
				mpBigint(out, obj)
				return
			default:
		}
		if depth >= c.maxDepth {
			out.push(byte(0xC0))
			return
		}
		match reflection.kindOf(obj) {
			case FieldKind.String:
				mpStr(out, reflection.scalarText(obj).bytes())
			case FieldKind.Bool:
				out.push(byte(reflection.scalarText(obj) == "true" ?? (0xC3, 0xC2)))
			case FieldKind.Int, FieldKind.Uint, FieldKind.Enum:
				mpBigint(out, parseBigInt(reflection.scalarText(obj)) onerror recover bigint(0))
			case FieldKind.Float:
				mpFloat64(out, parseFloat<float>(reflection.scalarText(obj)))
			case FieldKind.Array:
				let elems = reflection.elements(obj)
				mpArrayHead(out, elems.len())
				for let e in elems {
					mpEncodeAny(c, out, e, depth + 1)
				}
			case FieldKind.Map:
				let keys = reflection.keysOf(obj)
				mpMapHead(out, keys.len())
				for let key in keys {
					mpStr(out, key.bytes())
					let e = reflection.entryOf(obj, key)
					if e is none {
						out.push(byte(0xC0))
					} else {
						mpEncodeAny(c, out, e, depth + 1)
					}
				}
			default:
				let fields = reflection.fields(obj)
				if fields.len() == 0 {
					out.push(byte(0xC0))
					return
				}
				mpEncodeObject(c, out, fields, depth)
		}
	}

	// Writes an object as a map of its fields.
	internal def mpEncodeObject(c MsgPack, out byte[], fields Field[], depth int) {
		let kept Field[] = []
		for let (_, f) in fields {
			continue when fieldFlag(f, msgpackAttr, "ignore")
			continue when fieldFlag(f, msgpackAttr, "omitempty") && fieldIsEmpty(f)
			kept.push(f)
		}
		mpMapHead(out, kept.len())
		for let (_, f) in kept {
			mpStr(out, mpFieldName(f).bytes())
			mpEncodeField(c, out, f, f.kind, depth)
		}
	}

	// The map key of a field: its `@msgpack` name or its declared name.
	internal def mpFieldName(f Field) string {
		let name = f.attr(msgpackAttr, "name")
		return name == "" ?? (f.name, name)
	}

	// Writes one field, array element or map value of the given kind.
	internal def mpEncodeField(c MsgPack, out byte[], f Field, kind FieldKind, depth int) {
		if kind != FieldKind.Array && kind != FieldKind.Map && mpIsDuration(f.typeName) {
			mpSignedInt(out, f.asInt())
			return
		}
		match kind {
			case FieldKind.String:
				mpStr(out, f.asString().bytes())
			case FieldKind.Bool:
				out.push(byte(f.asBool() ?? (0xC3, 0xC2)))
			case FieldKind.Int, FieldKind.Enum:
				mpSignedInt(out, f.asInt())
			case FieldKind.Uint:
				mpInt(out, false, uint64(f.asUint()))
			case FieldKind.Float:
				let wide = f.typeName
				if wide == "float32" || mpElemIsFloat32(wide) {
					mpFloat32(out, float32(f.asFloat()))
				} else {
					mpFloat64(out, f.asFloat())
				}
			case FieldKind.Array:
				let n = f.len()
				if f.typeName := "byte[]" || "uint8[]" {
					let b byte[]
					b.cap(n)
					for let i = 0; i < n; i++ {
						b.push(byte(f.at(i).asUint()))
					}
					mpBin(out, b)
					return
				}
				mpArrayHead(out, n)
				for let i = 0; i < n; i++ {
					mpEncodeField(c, out, f.at(i), f.elemKind, depth)
				}
			case FieldKind.Map:
				let keys = f.keys()
				mpMapHead(out, keys.len())
				for let key in keys {
					mpStr(out, key.bytes())
					mpEncodeField(c, out, f.entry(key), f.elemKind, depth)
				}
			default:
				let nested = f.value()
				if nested is none {
					out.push(byte(0xC0))
				} else {
					mpEncodeAny(c, out, nested, depth + 1)
				}
		}
	}

	// Makes sure n bytes are buffered past r.i, reading from the stream as
	// needed. Reports false when a byte source or the stream ends first.
	internal def mpFill(r MsgPackReader, n int) !bool {
		return true when r.data.len() - r.i >= n
		let src = r.src
		return false when src is none
		if r.i > 0 {
			r.data = r.data.slice(r.i, r.data.len() - r.i).clone()
			r.base += r.i
			r.i = 0
		}
		let chunk byte[]
		chunk.len(n - r.data.len() > 4096 ?? (n - r.data.len(), 4096))
		for r.data.len() < n {
			let got = try src.read(chunk)
			return false when got <= 0
			r.data += chunk.slice(0, got)
		}
		return true
	}

	// Moves past n bytes and returns them, or fails when the data ends first.
	internal def mpTake(r MsgPackReader, n int) !byte[] {
		expects {
			assert try mpFill(r, n) onerror fail "msgpack: data ends inside an object at offset {r.pos}"
		}
		let b = r.data.slice(r.i, n).clone()
		r.i += n
		return b
	}

	// Reads a size-byte big-endian unsigned integer.
	internal def mpUint(r MsgPackReader, size int) !uint64 {
		expects {
			assert try mpFill(r, size) onerror fail "msgpack: data ends inside an object at offset {r.pos}"
		}
		let v uint64 = 0
		for let j = 0; j < size; j++ {
			v = (v << 8) | uint64(r.data[r.i + j])
		}
		r.i += size
		return v
	}

	// Reads a length that must still fit in the data when it comes from bytes,
	// each unit taking at least unitBytes.
	internal def mpLength(r MsgPackReader, size int, unitBytes int, start int) !int {
		let n = try mpUint(r, size)
		if r.src is none {
			fail "msgpack: length {n} at offset {start} runs past the end of the data" when n * uint64(unitBytes) > uint64(r.data.len() - r.i)
		}
		return int(n)
	}

	// Reads one object.
	internal def mpRead(r MsgPackReader, depth int) !MsgPackValue {
		expects {
			assert depth <= r.maxDepth onerror fail "msgpack: input nests deeper than {r.maxDepth} levels"
		}
		let start = r.pos
		let b = int(try mpUint(r, 1))
		let v = new MsgPackValue()
		if b <= 0x7F {
			v.k = MsgPackKind.Int
			v.n = uint64(b)
			return v
		}
		if b >= 0xE0 {
			v.k = MsgPackKind.Int
			v.neg = true
			v.n = uint64(0xFF - b)
			return v
		}
		if b <= 0x8F {
			try mpReadMap(r, v, b & 0x0F, depth)
			return v
		}
		if b <= 0x9F {
			try mpReadArray(r, v, b & 0x0F, depth)
			return v
		}
		if b <= 0xBF {
			v.k = MsgPackKind.Str
			v.raw = try mpTake(r, b & 0x1F)
			return v
		}
		match b {
			case 0xC0:
				return v
			case 0xC1:
				fail "msgpack: byte 0xc1 at offset {start} is never used"
			case 0xC2, 0xC3:
				v.k = MsgPackKind.Bool
				v.n = uint64(b - 0xC2)
			case 0xC4, 0xC5, 0xC6:
				v.k = MsgPackKind.Bin
				v.raw = try mpTake(r, try mpLength(r, 1 << (b - 0xC4), 1, start))
			case 0xC7, 0xC8, 0xC9:
				let n = try mpLength(r, 1 << (b - 0xC7), 1, start)
				v.k = MsgPackKind.Ext
				v.ext = int(int8(try mpUint(r, 1)))
				v.raw = try mpTake(r, n)
			case 0xCA:
				v.k = MsgPackKind.Float
				v.f32 = true
				v.f = float(__bitcast_f32_from_u32(uint32(try mpUint(r, 4))))
			case 0xCB:
				v.k = MsgPackKind.Float
				v.f = float(__bitcast_f64_from_u64(try mpUint(r, 8)))
			case 0xCC, 0xCD, 0xCE, 0xCF:
				v.k = MsgPackKind.Int
				v.n = try mpUint(r, 1 << (b - 0xCC))
			case 0xD0, 0xD1, 0xD2, 0xD3:
				let size = 1 << (b - 0xD0)
				let bits = try mpUint(r, size)
				let sign = uint64(1) << (size * 8 - 1)
				v.k = MsgPackKind.Int
				if (bits & sign) != uint64(0) {
					v.neg = true
					let mask = size == 8 ?? (~uint64(0), (uint64(1) << (size * 8)) - uint64(1))
					v.n = ~bits & mask
				} else {
					v.n = bits
				}
			case 0xD4, 0xD5, 0xD6, 0xD7, 0xD8:
				v.k = MsgPackKind.Ext
				v.ext = int(int8(try mpUint(r, 1)))
				v.raw = try mpTake(r, 1 << (b - 0xD4))
			case 0xD9, 0xDA, 0xDB:
				v.k = MsgPackKind.Str
				v.raw = try mpTake(r, try mpLength(r, 1 << (b - 0xD9), 1, start))
			case 0xDC, 0xDD:
				try mpReadArray(r, v, try mpLength(r, b == 0xDC ?? (2, 4), 1, start), depth)
			default:
				try mpReadMap(r, v, try mpLength(r, b == 0xDE ?? (2, 4), 2, start), depth)
		}
		if v.k == MsgPackKind.Ext && v.ext == -1 {
			try mpTimestamp(v.raw)
		}
		return v
	}

	internal def mpReadArray(r MsgPackReader, v MsgPackValue, n int, depth int) !none {
		v.k = MsgPackKind.Array
		v.items.cap(n < 4096 ?? (n, 4096))
		for let j = 0; j < n; j++ {
			v.items.push(try mpRead(r, depth + 1))
		}
		return none
	}

	// Reads n map entries into v, failing on a duplicate key.
	internal def mpReadMap(r MsgPackReader, v MsgPackValue, n int, depth int) !none {
		v.k = MsgPackKind.Map
		let seen map<string, bool>{}
		for let j = 0; j < n; j++ {
			let at = r.pos
			let key = try mpRead(r, depth + 1)
			let kb byte[]
			mpEncodeValue(kb, key)
			let id = kb.hex()
			fail "msgpack: duplicate map key {key.str()} at offset {at}" when seen.hasKey(id)
			seen[id] = true
			v.items.push(key)
			v.vals.push(try mpRead(r, depth + 1))
		}
		return none
	}

	// Binds a map onto an object's fields.
	internal def mpBind(item MsgPackValue, target any, depth int, maxDepth int) !none {
		expects {
			assert depth < maxDepth onerror fail "msgpack: input nests deeper than {maxDepth} objects"
		}
		return none when item.k == MsgPackKind.Nil
		fail "msgpack: cannot read {mpDescribe(item)} into an object" when item.k != MsgPackKind.Map
		let fields = reflection.fields(target)
		for let (i, key) in item.items {
			continue when key.k != MsgPackKind.Str
			let f = mpFieldFor(fields, key.raw)
			continue when f is none
			try mpBindField(item.vals[i], f, depth, maxDepth)
		}
		return none
	}

	// The field a str key names: the `@msgpack` name or the declared name
	// exactly, else case-insensitively.
	internal def mpFieldFor(fields Field[], key byte[]) ?Field {
		for let (_, f) in fields {
			continue when fieldFlag(f, msgpackAttr, "ignore")
			return f when mpFieldName(f).bytes().equals(key)
		}
		return none when !validUTF8(key)
		let lowered = string(key).lower()
		for let (_, f) in fields {
			continue when fieldFlag(f, msgpackAttr, "ignore")
			return f when mpFieldName(f).lower() == lowered
		}
		return none
	}

	// Stores one object in a field.
	internal def mpBindField(v MsgPackValue, f Field, depth int, maxDepth int) !none {
		if v.k == MsgPackKind.Nil {
			f.setNone() when f.kind == FieldKind.Optional
			return none
		}
		match f.kind {
			case FieldKind.Array:
				if f.typeName := "byte[]" || "uint8[]" {
					let b = try v.asBytes()
					fail "msgpack: cannot read {mpDescribe(v)} into `{f.name}`" when v.k == MsgPackKind.Ext
					fail "msgpack: cannot resize `{f.name}`" when !f.setLen(b.len())
					for let (i, x) in b {
						f.at(i).setUint(uint(x))
					}
					return none
				}
				fail "msgpack: cannot read {mpDescribe(v)} into `{f.name}`" when v.k != MsgPackKind.Array
				fail "msgpack: cannot resize `{f.name}`" when !f.setLen(v.items.len())
				for let (i, e) in v.items {
					try mpBindScalar(e, f.at(i), f.elemKind, depth, maxDepth)
				}
				return none
			case FieldKind.Map:
				fail "msgpack: cannot read {mpDescribe(v)} into `{f.name}`" when v.k != MsgPackKind.Map
				f.clear()
				for let (i, key) in v.items {
					let name = try key.asString()
					continue when v.vals[i].k == MsgPackKind.Nil && f.elemKind != FieldKind.Iface
					try mpBindScalar(v.vals[i], f.entry(name), f.elemKind, depth, maxDepth)
				}
				return none
			case FieldKind.Optional:
				return try mpBindScalar(v, f, f.elemKind, depth, maxDepth)
			default:
				return try mpBindScalar(v, f, f.kind, depth, maxDepth)
		}
	}

	// Stores a scalar or nested object in a field, array element or map
	// entry.
	internal def mpBindScalar(v MsgPackValue, f Field, kind FieldKind, depth int, maxDepth int) !none {
		if kind != FieldKind.Array && kind != FieldKind.Map && mpIsDuration(f.typeName) {
			f.setInt(try v.asInt())
			return none
		}
		match kind {
			case FieldKind.String:
				f.setString(try v.asString())
			case FieldKind.Bool:
				f.setBool(try v.asBool())
			case FieldKind.Int, FieldKind.Enum:
				f.setInt(try v.asInt())
			case FieldKind.Uint:
				f.setUint(uint(try v.asUint()))
			case FieldKind.Float:
				f.setFloat(try v.asFloat())
			case FieldKind.Struct:
				if mpIsTime(f.typeName) {
					let t = v.asTime() onerror (err error) {
						fail "msgpack: cannot store {mpDescribe(v)} in `{f.name}`: {err.message}"
					}
					fail "msgpack: cannot store a timestamp in `{f.name}`" unless f.set(t)
					return none
				}
				let nested = f.ensureValue()
				fail "msgpack: cannot store {mpDescribe(v)} in `{f.name}`" when nested is none
				try mpBind(v, nested, depth + 1, maxDepth)
			case FieldKind.Iface:
				fail "msgpack: cannot store {mpDescribe(v)} in `{f.name}`" unless f.set(try mpToAny(v, depth, maxDepth))
			default:
				fail "msgpack: cannot store {mpDescribe(v)} in `{f.name}`"
		}
		return none
	}

	// A MessagePack object as the plain values `JSON.parse` builds: nil as
	// none, a map with str keys as `map<string, any>`, an array as `any[]`,
	// a str as `string`, a bin as `byte[]`, a timestamp as `time.Time`, any
	// other extension as its MsgPackValue. Fails on a map key that is not a
	// str and on a str that is not UTF-8.
	internal def mpToAny(v MsgPackValue, depth int, maxDepth int) !any {
		expects {
			assert depth < maxDepth onerror fail "msgpack: input nests deeper than {maxDepth} levels"
		}
		match v.k {
			case MsgPackKind.Nil:
				return none
			case MsgPackKind.Bool:
				return v.n == uint64(1)
			case MsgPackKind.Int:
				return v.n when !v.neg && v.n > uint64(0x7FFFFFFFFFFFFFFF)
				return try v.asInt()
			case MsgPackKind.Float:
				return v.f
			case MsgPackKind.Str:
				return try v.asString()
			case MsgPackKind.Bin:
				return v.raw
			case MsgPackKind.Array:
				let out any[] = []
				for let (_, item) in v.items {
					out.push(try mpToAny(item, depth + 1, maxDepth))
				}
				return out
			case MsgPackKind.Map:
				let out = map<string, any>{}
				for let (i, key) in v.items {
					fail "msgpack: map key {key.str()} is not a str" when key.k != MsgPackKind.Str
					out[try key.asString()] = try mpToAny(v.vals[i], depth + 1, maxDepth)
				}
				return out
			default:
				return try v.asTime() when v.ext == -1
				return v
		}
	}

	// The kind of an object in words, for error messages.
	internal def mpDescribe(v MsgPackValue) string {
		return "a timestamp" when v.k == MsgPackKind.Ext && v.ext == -1
		return "an {v.k.name.lower()} object" when v.k == MsgPackKind.Int || v.k == MsgPackKind.Array || v.k == MsgPackKind.Ext
		return "a {v.k.name.lower()} object"
	}
}

internal partial module std.data.encoding.msgpack {
	use (
		std.io
		std.time
		std.reflection
		std.reflection::(Field, FieldKind, MetadataStore)
		std.data.encoding::*
		std.data.encoding.json::(fieldFlag, fieldIsEmpty, recordFlag)
		std.data.encoding.cbor::(validUTF8)
	)

	def mpRecord(store MetadataStore, name string, omitempty bool, ignore bool) {
		let prefix = "encoder.msgpack."
		if name == "" {
			store.delete(prefix + "name")
		} else {
			store.save(prefix + "name", name)
		}
		recordFlag(store, prefix + "omitempty", omitempty)
		recordFlag(store, prefix + "ignore", ignore)
	}

	// Appends the low size bytes of v, most significant first.
	def mpBE(out byte[], v uint64, size int) {
		for let s = (size - 1) * 8; s >= 0; s -= 8 {
			out.push(byte((v >> s) & uint64(0xFF)))
		}
	}

	// Writes an integer, -1 - n when neg, in its smallest format.
	def mpInt(out byte[], neg bool, n uint64) {
		if !neg {
			if n < uint64(0x80) {
				out.push(byte(n))
			} else if n <= uint64(0xFF) {
				out.push(byte(0xCC), byte(n))
			} else if n <= uint64(0xFFFF) {
				out.push(byte(0xCD))
				mpBE(out, n, 2)
			} else if n <= uint64(0xFFFFFFFF) {
				out.push(byte(0xCE))
				mpBE(out, n, 4)
			} else {
				out.push(byte(0xCF))
				mpBE(out, n, 8)
			}
			return
		}
		// The two's complement of -1 - n is the complement of n.
		let bits = ~n
		if n < uint64(32) {
			out.push(byte(bits & uint64(0xFF)))
		} else if n < uint64(0x80) {
			out.push(byte(0xD0), byte(bits & uint64(0xFF)))
		} else if n < uint64(0x8000) {
			out.push(byte(0xD1))
			mpBE(out, bits, 2)
		} else if n < uint64(0x80000000) {
			out.push(byte(0xD2))
			mpBE(out, bits, 4)
		} else {
			out.push(byte(0xD3))
			mpBE(out, bits, 8)
		}
	}

	// Writes an integer of any size; nil outside -2^63 to 2^64 - 1, which
	// MessagePack cannot hold.
	def mpBigint(out byte[], v bigint) {
		if v >= bigint(0) && v < bigint(1) << 64 {
			mpInt(out, false, uint64(v))
		} else if v < bigint(0) && v >= -(bigint(1) << 63) {
			mpInt(out, true, uint64(-bigint(1) - v))
		} else {
			out.push(byte(0xC0))
		}
	}

	def mpSignedInt(out byte[], v int) {
		if v < 0 {
			mpInt(out, true, uint64(-1 - v))
		} else {
			mpInt(out, false, uint64(v))
		}
	}

	// Writes a length head: fix when the length fits fixMax, else the 8-, 16-
	// or 32-bit form starting at op8 (op8 < 0 when the type has no 8-bit
	// form).
	def mpHead(out byte[], length int, fix int, fixMax int, op8 int, op16 int) {
		if length <= fixMax {
			out.push(byte(fix | length))
		} else if op8 >= 0 && length <= 0xFF {
			out.push(byte(op8), byte(length))
		} else if length <= 0xFFFF {
			out.push(byte(op16))
			mpBE(out, uint64(length), 2)
		} else {
			out.push(byte(op16 + 1))
			mpBE(out, uint64(length), 4)
		}
	}

	def mpStr(out byte[], b byte[]) {
		mpHead(out, b.len(), 0xA0, 31, 0xD9, 0xDA)
		out.push(...b)
	}

	def mpBin(out byte[], b byte[]) {
		if b.len() <= 0xFF {
			out.push(byte(0xC4), byte(b.len()))
		} else if b.len() <= 0xFFFF {
			out.push(byte(0xC5))
			mpBE(out, uint64(b.len()), 2)
		} else {
			out.push(byte(0xC6))
			mpBE(out, uint64(b.len()), 4)
		}
		out.push(...b)
	}

	def mpArrayHead(out byte[], n int) {
		mpHead(out, n, 0x90, 15, -1, 0xDC)
	}

	def mpMapHead(out byte[], n int) {
		mpHead(out, n, 0x80, 15, -1, 0xDE)
	}

	def mpExt(out byte[], extType int, data byte[]) {
		let n = data.len()
		match n {
			case 1:
				out.push(byte(0xD4))
			case 2:
				out.push(byte(0xD5))
			case 4:
				out.push(byte(0xD6))
			case 8:
				out.push(byte(0xD7))
			case 16:
				out.push(byte(0xD8))
			default:
				if n <= 0xFF {
					out.push(byte(0xC7), byte(n))
				} else if n <= 0xFFFF {
					out.push(byte(0xC8))
					mpBE(out, uint64(n), 2)
				} else {
					out.push(byte(0xC9))
					mpBE(out, uint64(n), 4)
				}
		}
		out.push(byte(extType & 0xFF))
		out.push(...data)
	}

	def mpFloat64(out byte[], v float) {
		out.push(byte(0xCB))
		mpBE(out, __bitcast_u64_from_f64(float64(v)), 8)
	}

	def mpFloat32(out byte[], v float32) {
		out.push(byte(0xCA))
		mpBE(out, uint64(__bitcast_u32_from_f32(v)), 4)
	}

	// The timestamp extension data for seconds and nanoseconds in the
	// smallest of the 32-, 64- and 96-bit forms.
	def mpTimestampBytes(sec int64, nsec int) byte[] {
		let out byte[]
		if sec >= int64(0) && sec < int64(0x400000000) {
			if nsec == 0 && sec <= int64(0xFFFFFFFF) {
				mpBE(out, uint64(sec), 4)
			} else {
				mpBE(out, (uint64(nsec) << 34) | uint64(sec), 8)
			}
			return out
		}
		mpBE(out, uint64(nsec), 4)
		mpBE(out, uint64(sec), 8)
		return out
	}

	// Reads timestamp extension data as seconds and nanoseconds.
	def mpTimestamp(b byte[]) !(int64, int) {
		let v uint64 = 0
		match b.len() {
			case 4:
				for let (_, x) in b {
					v = (v << 8) | uint64(x)
				}
				return (int64(v), 0)
			case 8:
				for let (_, x) in b {
					v = (v << 8) | uint64(x)
				}
				let nsec = int(v >> 34)
				fail "msgpack: timestamp nanoseconds {nsec} exceed 999999999" when nsec > 999999999
				return (int64(v & uint64(0x3FFFFFFFF)), nsec)
			case 12:
				let nsec = 0
				for let j = 0; j < 4; j++ {
					nsec = (nsec << 8) | int(b[j])
				}
				for let j = 4; j < 12; j++ {
					v = (v << 8) | uint64(b[j])
				}
				fail "msgpack: timestamp nanoseconds {nsec} exceed 999999999" when nsec > 999999999
				return (int64(v), nsec)
			default:
				fail "msgpack: a timestamp holds 4, 8 or 12 bytes, not {b.len()}"
		}
	}

	// Reports whether a field, array element or map value holds a duration,
	// which reflection classifies as Other but reads and writes as an int.
	def mpIsDuration(typeName string) bool {
		return typeName == "duration" || typeName.endsWith("duration[]") || typeName.endsWith(" duration>")
	}

	// Reports whether a field, optional or element type name is time.Time.
	def mpIsTime(typeName string) bool {
		return (typeName := "std.time.Time" || "?std.time.Time" || "std.time.Time[]" || "?std.time.Time[]") || typeName.endsWith(" std.time.Time>")
	}

	// Reports whether an array or map field holds float32 elements.
	def mpElemIsFloat32(typeName string) bool {
		return typeName.endsWith("float32[]") || typeName.endsWith(" float32>")
	}
}
