partial module std.data.encoding {
	use (
		std.testing
		std.time
		std.io
	)

	enum MsgPackColour {
		Red,
		Green,
		Blue
	}

	struct MsgPackInner {
		x     int
		label string
	}

	struct MsgPackUser {
		name string

		@msgpack("years")
		age int

		@msgpack(omitempty = true)
		nick string

		tags   string[]
		score  float
		active bool
		key    byte[]
		ratio  float32

		@msgpack(ignore = true)
		note string
	}

	struct MsgPackRecord {
		id      uint64
		delta   int32
		colour  MsgPackColour
		inner   MsgPackInner
		counts  map<string, int>
		samples float32[]
		at      time.Time
	}

	struct MsgPackHolder {
		items    MsgPackInner[]
		count    ?int
		label    ?string
		sub      ?MsgPackInner
		seen     ?time.Time
		anything any
		list     any[]
		bag      map<string, any>
	}

	// Hands out one byte per read, so a reader has to refill mid-object.
	type MsgPackTrickle {
		internal data byte[]
		internal at   int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def read(buf byte[]) !int {
			return 0 when at >= data.len() || buf.len() == 0
			buf[0] = data[at]
			at++
			return 1
		}
	}

	def mpx(text string) byte[] {
		return hexdecode(text) onerror recover byte[]
	}

	// Parses hex, checks the text form, and checks that encoding the tree
	// gives the same bytes back.
	def mpRoundTrip(hex string, text string) bool {
		let data = mpx(hex)
		let mp = new MsgPack()
		let item = mp.parse(data) onerror (err error) {
			println("parse {hex}: {err.message}")
			recover new MsgPackValue(MsgPackKind.Bool)
		}
		let ok = item.str() == text && mp.encode(item).equals(data)
		println("{hex}: got {item.str()} / {hexencode(mp.encode(item))}") when !ok
		return ok
	}

	// Parses hex and checks the text form only (input not in smallest form).
	def mpReads(hex string, text string) bool {
		let item = new MsgPack().parse(mpx(hex)) onerror (err error) {
			println("parse {hex}: {err.message}")
			recover new MsgPackValue(MsgPackKind.Bool)
		}
		println("{hex}: got {item.str()}") when item.str() != text
		return item.str() == text
	}

	// Reports whether parsing hex fails.
	def mpRejects(hex string) bool {
		let failed = false
		new MsgPack().parse(mpx(hex)) onerror (err error) {
			failed = true
			recover new MsgPackValue()
		}
		println("{hex}: accepted") when !failed
		return failed
	}

	def mpEncodes(v any, hex string) bool {
		let got = new MsgPack().encode(v)
		println("want {hex}, got {hexencode(got)}") when !got.equals(mpx(hex))
		return got.equals(mpx(hex))
	}

	check "MsgPack" {
		@test()
		def TestIntegers() !none {
			assert mpRoundTrip("00", "0")
			assert mpRoundTrip("7f", "127")
			assert mpRoundTrip("cc80", "128")
			assert mpRoundTrip("ccff", "255")
			assert mpRoundTrip("cd0100", "256")
			assert mpRoundTrip("cdffff", "65535")
			assert mpRoundTrip("ce00010000", "65536")
			assert mpRoundTrip("ceffffffff", "4294967295")
			assert mpRoundTrip("cf0000000100000000", "4294967296")
			assert mpRoundTrip("cfffffffffffffffff", "18446744073709551615")
			assert mpRoundTrip("ff", "-1")
			assert mpRoundTrip("e0", "-32")
			assert mpRoundTrip("d0df", "-33")
			assert mpRoundTrip("d080", "-128")
			assert mpRoundTrip("d1ff7f", "-129")
			assert mpRoundTrip("d18000", "-32768")
			assert mpRoundTrip("d2ffff7fff", "-32769")
			assert mpRoundTrip("d280000000", "-2147483648")
			assert mpRoundTrip("d3ffffffff7fffffff", "-2147483649")
			assert mpRoundTrip("d38000000000000000", "-9223372036854775808")
			assert mpReads("cc05", "5")
			assert mpReads("d005", "5")
			assert mpReads("d10005", "5")
			assert mpReads("d3ffffffffffffffff", "-1")
			assert mpReads("d07f", "127")
			assert mpEncodes(-9223372036854775807 - 1, "d38000000000000000")
			assert mpEncodes(uint64(0xFFFFFFFFFFFFFFFF), "cfffffffffffffffff")
			assert mpEncodes(bigint(1) << 64, "c0")
			let mp = new MsgPack()
			assert (try (try mp.parse(mpx("d1ff7f"))).asInt()) == -129
			assert (try (try mp.parse(mpx("cfffffffffffffffff"))).asUint()) == uint64(0xFFFFFFFFFFFFFFFF)
			let tooBig = (try mp.parse(mpx("cfffffffffffffffff"))).asInt() onerror recover 7
			assert tooBig == 7
			return none
		}

		@test()
		def TestFloats() !none {
			assert mpRoundTrip("ca3fc00000", "1.5")
			assert mpRoundTrip("cb3ff8000000000000", "1.5")
			assert mpRoundTrip("cbc010666666666666", "-4.1")
			assert mpRoundTrip("cb7ff0000000000000", "Infinity")
			assert mpReads("ca7fc00000", "NaN")
			assert mpEncodes(1.5, "cb3ff8000000000000")
			assert mpEncodes(float32(0.25), "ca3e800000")
			assert mpEncodes(new MsgPackValue(float32(0.25)), "ca3e800000")
			assert (try (try new MsgPack().parse(mpx("ca3e800000"))).asFloat()) == 0.25
			assert (try (try new MsgPack().parse(mpx("05"))).asFloat()) == 5.0
			return none
		}

		@test()
		def TestScalars() !none {
			assert mpRoundTrip("c0", "nil")
			assert mpRoundTrip("c2", "false")
			assert mpRoundTrip("c3", "true")
			assert try (try new MsgPack().parse(mpx("c3"))).asBool()
			return none
		}

		@test()
		def TestStringsAndBinary() !none {
			assert mpRoundTrip("a0", "\"\"")
			assert mpRoundTrip("a161", "\"a\"")
			assert mpRoundTrip("a3e6b0b4", "\"水\"")
			assert mpRoundTrip("c400", "h''")
			assert mpRoundTrip("c4020102", "h'0102'")
			let s31 = "x".repeat(31)
			let s32 = "x".repeat(32)
			let s256 = "x".repeat(256)
			let s65536 = "x".repeat(65536)
			let mp = new MsgPack()
			assert mp.encode(s31)[0] == byte(0xBF)
			assert mp.encode(s32).slice(0, 2).equals(mpx("d920"))
			assert mp.encode(s256).slice(0, 3).equals(mpx("da0100"))
			assert mp.encode(s65536).slice(0, 5).equals(mpx("db00010000"))
			assert mp.encode(s256.bytes()).slice(0, 3).equals(mpx("c50100"))
			assert mp.encode(s65536.bytes()).slice(0, 5).equals(mpx("c600010000"))
			assert (try (try mp.parse(mp.encode(s65536))).asString()) == s65536
			assert (try (try mp.parse(mpx("d90161"))).asString()) == "a"
			assert (try (try mp.parse(mpx("c50001ff"))).asBytes()).equals(mpx("ff"))
			// A str is kept as bytes; only reading it as text checks UTF-8.
			let bad = try mp.parse(mpx("a1ff"))
			assert bad.str() == "s'ff'"
			let text = bad.asString() onerror recover "rejected"
			assert text == "rejected"
			return none
		}

		@test()
		def TestContainers() !none {
			assert mpRoundTrip("90", "[]")
			assert mpRoundTrip("93010203", "[1, 2, 3]")
			assert mpRoundTrip("9301920203920405", "[1, [2, 3], [4, 5]]")
			assert mpRoundTrip("80", "\{\}")
			assert mpRoundTrip("82a16101a1629202c0", "\{\"a\": 1, \"b\": [2, nil]\}")
			assert mpRoundTrip("8101a178", "\{1: \"x\"\}")
			assert mpReads("dc0000", "[]")
			assert mpReads("dd0000000101", "[1]")
			assert mpReads("de0001a16101", "\{\"a\": 1\}")
			let sixteen MsgPackValue[] = []
			for let i = 0; i < 16; i++ {
				sixteen.push(new MsgPackValue(i))
			}
			assert new MsgPack().encode(new MsgPackValue(sixteen)).slice(0, 3).equals(mpx("dc0010"))
			let m = new MsgPackValue(MsgPackKind.Map)
			for let i = 0; i < 16; i++ {
				m.set(i.str(), new MsgPackValue(i))
			}
			assert new MsgPack().encode(m).slice(0, 5).equals(mpx("de0010a130"))
			return none
		}

		@test()
		def TestExtensions() !none {
			assert mpRoundTrip("d401ff", "ext(1, h'ff')")
			assert mpRoundTrip("d5020102", "ext(2, h'0102')")
			assert mpRoundTrip("d87f" + "00".repeat(16), "ext(127, h'" + "00".repeat(16) + "')")
			assert mpRoundTrip("c70305aabbcc", "ext(5, h'aabbcc')")
			assert mpRoundTrip("c70080", "ext(-128, h'')")
			let e = try new MsgPack().parse(mpx("c70305aabbcc"))
			assert e.kind == MsgPackKind.Ext && e.extType == 5
			assert (try e.asBytes()).equals(mpx("aabbcc"))
			return none
		}

		@test()
		def TestTimestamps() !none {
			assert mpRoundTrip("d6ff00000001", "ext(-1, h'00000001')")
			assert mpRoundTrip("d7ff7735940000000001", "ext(-1, h'7735940000000001')")
			assert mpRoundTrip("c70cff00000000ffffffffffffffff", "ext(-1, h'00000000ffffffffffffffff')")
			let mp = new MsgPack()
			let (sec, nsec) = try (try mp.parse(mpx("d7ff7735940000000001"))).asTimestamp()
			assert sec == int64(1) && nsec == 500000000
			let (bigSec, _) = try (try mp.parse(mpx("c70cff000000000000000400000000"))).asTimestamp()
			assert bigSec == int64(17179869184)
			assert mpEncodes(time.fromUnixNs(1500000000), "d7ff7735940000000001")
			assert mpEncodes(time.fromUnixNs(1000000000), "d6ff00000001")
			assert mpEncodes(time.fromUnixNs(-1000000000), "c70cff00000000ffffffffffffffff")
			assert mpEncodes(time.fromUnixNs(-1), "c70cff3b9ac9ffffffffffffffffff")
			assert mpEncodes(time.fromUnixNs(4294967296000000000), "d7ff0000000100000000")
			let t = try (try mp.parse(mpx("c70cff3b9ac9ffffffffffffffffff"))).asTime()
			assert t.unixNs() == int64(-1)
			let far = (try mp.parse(mpx("c70cff000000000000000400000000"))).asTime() onerror recover time.fromUnixNs(7)
			assert far.unixNs() == int64(7)
			return none
		}

		@test()
		def TestRejects() !none {
			assert mpRejects("")
			assert mpRejects("c1")
			assert mpRejects("cd01")
			assert mpRejects("a261")
			assert mpRejects("c40201")
			assert mpRejects("dcffff")
			assert mpRejects("deffff01")
			assert mpRejects("9201")
			assert mpRejects("82a16101a16102")
			assert mpRejects("0000")
			assert mpRejects("d5ff0000")
			assert mpRejects("d7ffffffffff00000000")
			assert mpRejects("c70cff3b9aca00ffffffffffffffff")
			assert mpRejects("91".repeat(200) + "00")
			let shallow = new MsgPack()
			shallow.maxDepth = 2
			let failed = false
			shallow.parse(mpx("91919100")) onerror (err error) {
				failed = true
				recover new MsgPackValue()
			}
			assert failed
			return none
		}

		@test()
		def TestValueTree() !none {
			let m = new MsgPackValue(MsgPackKind.Map)
			m.set("id", new MsgPackValue(7))
			m.set(3, new MsgPackValue("three"))
			m.set("id", new MsgPackValue(8))
			assert m.len() == 2
			assert (try m.get("id").asInt()) == 8
			assert (try m.get(3).asString()) == "three"
			assert m.has("id") && !m.has("nope") && m.get("nope").kind == MsgPackKind.Nil
			assert m.indexOf("id") == 0 && m.indexOf(3) == 1 && m.indexOf(new MsgPackValue(3)) == 1
			assert m.indexOf("nope") == -1
			let pairs = m.entries()
			assert pairs.len() == 2
			let (lastKey, lastValue) = pairs[1]
			assert lastKey.str() == "3" && lastValue.str() == "\"three\""
			assert m.elements().len() == 0
			m.remove(new MsgPackValue("id"))
			assert !m.has("id")
			let a = new MsgPackValue(MsgPackKind.Array)
			a.push(new MsgPackValue(true)).push(new MsgPackValue())
			assert a.str() == "[true, nil]"
			assert a.at(5).kind == MsgPackKind.Nil
			let copy = try new MsgPack().parse(new MsgPack().encode(m))
			assert copy.equals(m)
			assert new MsgPackValue(float32(1.5)).equals(new MsgPackValue(1.5))
			assert !new MsgPackValue(1).equals(new MsgPackValue(1.0))
			return none
		}

		@test()
		def TestEncodeObject() !none {
			let u = new MsgPackUser()
			u.name = "ann"
			u.age = 30
			u.tags = ["a", "b"]
			u.score = 1.5
			u.active = true
			u.key = [byte(1), byte(2)]
			u.ratio = float32(0.25)
			u.note = "secret"
			assert mpEncodes(u, "87a46e616d65a3616e6ea579656172731ea47461677392a161a162a573636f7265cb3ff8000000000000a6616374697665c3a36b6579c4020102a5726174696fca3e800000")
			return none
		}

		@test()
		def TestDecodeObject() !none {
			let src = new MsgPackUser()
			src.name = "ann"
			src.age = 30
			src.nick = "a"
			src.tags = ["a", "b"]
			src.score = 1.5
			src.active = true
			src.key = [byte(1), byte(2)]
			src.ratio = float32(0.25)
			src.note = "secret"
			let mp = new MsgPack()
			let dst = new MsgPackUser()
			try mp.decode(mp.encode(src), dst)
			assert dst.name == "ann" && dst.age == 30 && dst.nick == "a"
			assert dst.tags.len() == 2 && dst.tags[1] == "b"
			assert dst.score == 1.5 && dst.active && dst.ratio == float32(0.25)
			assert dst.key.equals([byte(1), byte(2)])
			assert dst.note == ""

			let r = new MsgPackRecord()
			r.id = uint64(0xFFFFFFFFFFFFFFFF)
			r.delta = int32(-5)
			r.colour = MsgPackColour.Blue
			r.inner.x = 9
			r.inner.label = "in"
			r.counts["a"] = 1
			r.counts["b"] = -2
			r.samples = [float32(0.5), float32(-2)]
			r.at = time.fromUnixNs(1500000000)
			let data = mp.encode(r)
			let back = new MsgPackRecord()
			try mp.decode(data, back)
			assert back.id == uint64(0xFFFFFFFFFFFFFFFF)
			assert back.delta == int32(-5)
			assert back.colour == MsgPackColour.Blue
			assert back.inner.x == 9 && back.inner.label == "in"
			assert back.counts["b"] == -2 && back.counts.len() == 2
			assert back.samples.len() == 2 && back.samples[1] == float32(-2)
			assert back.at.unixNs() == int64(1500000000)
			let tree = try mp.parse(data)
			assert tree.get("samples").at(0).str() == "0.5"
			assert tree.get("at").extType == -1

			// Keys match case-insensitively, unknown keys are skipped, nil
			// leaves a field alone.
			let loose = new MsgPackUser()
			loose.score = 2.0
			try mp.decode(mpx("83a44e414d45a178a7756e6b6e6f776e01a573636f7265c0"), loose)
			assert loose.name == "x" && loose.score == 2.0
			let wrong = new MsgPackUser()
			let failed = false
			mp.decode(mpx("81a46e616d6501"), wrong) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			return none
		}

		@test()
		def TestDecodeObjectsOptionalsAny() !none {
			let src = new MsgPackHolder()
			let one = new MsgPackInner()
			one.x = 1
			one.label = "a"
			let two = new MsgPackInner()
			two.x = 2
			src.items = [one, two]
			src.count = 0
			src.label = "l"
			let inner = new MsgPackInner()
			inner.x = 9
			src.sub = inner
			src.seen = time.fromUnixNs(1500000000)
			src.anything = "free"
			src.list = [1, "two", 3.5]
			src.bag["k"] = true
			let mp = new MsgPack()
			let data = mp.encode(src)
			let dst = new MsgPackHolder()
			dst.label = "stale"
			try mp.decode(data, dst)
			assert dst.items.len() == 2 && dst.items[1].x == 2 && dst.items[0].label == "a"
			let count = dst.count
			assert !(count is none) && count == 0
			let label = dst.label
			assert !(label is none) && label == "l"
			let sub = dst.sub
			assert !(sub is none) && sub.x == 9
			let seen = dst.seen
			assert !(seen is none) && seen.unixNs() == int64(1500000000)
			assert string(new JSON().encode(dst.anything)) == "\"free\""
			assert string(new JSON().encode(dst.list)) == "[1,\"two\",3.5]"
			assert string(new JSON().encode(dst.bag)) == "\{\"k\":true\}"
			// nil clears an optional that holds a value.
			try mp.decode(mpx("81a56c6162656cc0"), dst)
			assert dst.label is none
			return none
		}

		@test()
		def TestReaderStream() !none {
			let mp = new MsgPack()
			let data = mp.encode("first") + mp.encode([1, 2, 3]) + mp.encode(time.fromUnixNs(1500000000))
			let r = new MsgPackReader(new MsgPackTrickle(data))
			let got MsgPackValue[] = []
			for try r.more() {
				got.push(try r.next())
			}
			assert got.len() == 3
			assert (try got[0].asString()) == "first"
			assert got[1].str() == "[1, 2, 3]"
			assert (try got[2].asTime()).unixNs() == int64(1500000000)
			assert r.pos == data.len()

			let cut = new MsgPackReader(new MsgPackTrickle(mpx("92a3616263")))
			let failed = false
			cut.next() onerror (err error) {
				failed = true
				recover new MsgPackValue()
			}
			assert failed

			let fromBytes = new MsgPackReader(mpx("0102"))
			assert (try (try fromBytes.next()).asInt()) == 1
			assert fromBytes.pos == 1
			assert try fromBytes.more()
			return none
		}
	}
}
