partial module std.data.encoding {
	// PEMBlock is one PEM block (RFC 7468): the label after BEGIN and END,
	// the optional headers before the body, and the decoded body.
	//
	// Example:
	// ```example
	// let block = try pemDecode(text)
	// if block.kind == "CERTIFICATE" {
	//     let cert = try asn1Parse(block.bytes)
	// }
	// ```
	type PEMBlock {
		kind    string
		headers map<string, string>
		bytes   byte[]

		def new(kind string, bytes byte[]) {
			self.kind = kind
			self.bytes = bytes
		}

		// encode renders the block: the BEGIN line, headers with a blank
		// line after them, the body in 64-column Base64, the END line.
		def encode() string {
			let out = "-----BEGIN " + kind + "-----\n"
			if headers.len() > 0 {
				// Proc-Type goes first, as RFC 1421 requires.
				let procType = headers.get("Proc-Type")
				out += "Proc-Type: " + procType + "\n" unless procType is none
				for let (key, value) in headers {
					out += key + ": " + value + "\n" unless key == "Proc-Type"
				}
				out += "\n"
			}
			let body = base64encode(bytes)
			for let i = 0; i < body.len(); i += 64 {
				let end = i + 64
				end = body.len() when end > body.len()
				out += body[i:end] + "\n"
			}
			return out + "-----END " + kind + "-----\n"
		}
	}

	// pemDecode returns the first PEM block in the text, skipping anything
	// before it. Fails when the text has no block, or the first block is
	// malformed: no END line, an END label that differs from the BEGIN
	// label, or a body that is not Base64.
	def pemDecode(input string) !PEMBlock {
		let lines = input.lines()
		let (block, _) = try pemReadBlock(lines, 0)
		fail "pem: no PEM block found" when block is none
		return block
	}

	// pemDecodeAll returns every PEM block in the text, in order, skipping
	// the text between them; an empty array when there is none. Fails on a
	// malformed block like pemDecode.
	def pemDecodeAll(input string) !PEMBlock[] {
		let out PEMBlock[]
		let lines = input.lines()
		let line = 0
		for line < lines.len() {
			let (block, next) = try pemReadBlock(lines, line)
			break when block is none
			out.push(block)
			line = next
		}
		return out
	}

	// pemEncode renders the block as PEM text.
	def pemEncode(block PEMBlock) string {
		return block.encode()
	}

	// pemReadBlock finds the next BEGIN line at or after the line index and
	// reads the block; none, with the line count, when there is no BEGIN.
	internal def pemReadBlock(lines string[], from int) !(?PEMBlock, int) {
		let i = from
		for i < lines.len() && !pemIsBegin(lines[i]) {
			i++
		}
		return (none, lines.len()) when i >= lines.len()
		let kind = lines[i].trim().trimPrefix("-----BEGIN ").trimSuffix("-----")
		i++
		let block = new PEMBlock(kind, [])
		// Headers: "Key: Value" lines, ended by a blank line.
		if i < lines.len() && lines[i].contains(":") {
			for i < lines.len() && lines[i].trim() != "" {
				let sep = lines[i].indexOf(":")
				fail "pem: malformed header \"{lines[i]}\" in {kind}" when sep < 0
				block.headers.set(lines[i][:sep].trim(), lines[i][sep + 1:].trim())
				i++
			}
			i++
		}
		let body = ""
		let closed = false
		for i < lines.len() {
			let text = lines[i].trim()
			i++
			if text.startsWith("-----END ") {
				let endKind = text.trimPrefix("-----END ").trimSuffix("-----")
				fail "pem: END {endKind} closes BEGIN {kind}" when endKind != kind
				closed = true
				break
			}
			body += text
		}
		fail "pem: BEGIN {kind} has no END line" unless closed
		block.bytes = base64decode(body) onerror fail "pem: body of {kind} is not Base64"
		return (block, i)
	}

	internal def pemIsBegin(line string) bool {
		let text = line.trim()
		return text.startsWith("-----BEGIN ") && text.endsWith("-----")
	}
}
