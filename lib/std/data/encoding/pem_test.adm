partial module std.data.encoding {
	use std.testing

	check "PEM" {
		internal def header(block PEMBlock, key string) string {
			let value = block.headers.get(key)
			return "" when value is none
			return value
		}

		internal const publicKeyPEM = "-----BEGIN PUBLIC KEY-----\n" +
			"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEup+IIWf1MPuNxFz9MEBuE1BvleBS\n" +
			"DYfQAIVVs2IXTThf+YwQCN6+x5L226Y366S87Kynn7rbYHYdJEjVCBxpWQ==\n" +
			"-----END PUBLIC KEY-----\n"

		@test()
		def TestDecodeAndEncodeRoundTrip() !none {
			let block = try pemDecode(publicKeyPEM)
			assert block.kind == "PUBLIC KEY"
			assert block.headers.len() == 0
			assert block.bytes.len() == 91
			assert block.bytes[0] == 0x30
			assert block.encode() == publicKeyPEM
			assert pemEncode(block) == publicKeyPEM
		}

		@test()
		def TestHeaders() !none {
			let text = "-----BEGIN RSA PRIVATE KEY-----\n" +
				"DEK-Info: AES-128-CBC,0123456789ABCDEF\n" +
				"Proc-Type: 4,ENCRYPTED\n" +
				"\n" +
				"AQID\n" +
				"-----END RSA PRIVATE KEY-----\n"
			let block = try pemDecode(text)
			assert block.kind == "RSA PRIVATE KEY"
			assert block.headers.len() == 2
			assert header(block, "Proc-Type") == "4,ENCRYPTED"
			assert header(block, "DEK-Info") == "AES-128-CBC,0123456789ABCDEF"
			assert block.bytes.hex() == "010203"
			// Proc-Type is written first, then a blank line before the body.
			let expected = "-----BEGIN RSA PRIVATE KEY-----\n" +
				"Proc-Type: 4,ENCRYPTED\n" +
				"DEK-Info: AES-128-CBC,0123456789ABCDEF\n" +
				"\n" +
				"AQID\n" +
				"-----END RSA PRIVATE KEY-----\n"
			assert block.encode() == expected
		}

		@test()
		def TestDecodeAllSkipsText() !none {
			let text = "subject=CN=adm.test\n" +
				"-----BEGIN CERTIFICATE-----\n" +
				"AQID\n" +
				"-----END CERTIFICATE-----\n" +
				"some words between blocks\n\n" +
				"   -----BEGIN CERTIFICATE-----\r\n" +
				"BAUG\r\n" +
				"-----END CERTIFICATE-----\r\n" +
				"trailing text\n"
			let blocks = try pemDecodeAll(text)
			assert blocks.len() == 2
			assert blocks[0].bytes.hex() == "010203"
			assert blocks[1].bytes.hex() == "040506"
			assert (try pemDecode(text)).bytes.hex() == "010203"
			assert (try pemDecodeAll("no blocks here")).len() == 0
			let bare = try pemDecode("-----BEGIN X-----\n-----END X-----\n")
			assert bare.kind == "X" && bare.bytes.len() == 0
			assert bare.encode() == "-----BEGIN X-----\n-----END X-----\n"
		}

		@test()
		def TestLongBodyWraps() !none {
			let data byte[]
			data.len(100)
			for let i = 0; i < 100; i++ {
				data[i] = byte(i)
			}
			let block = new PEMBlock("DATA", data)
			let text = block.encode()
			let lines = text.lines()
			assert lines.len() == 5
			assert lines[1].len() == 64
			assert lines[2].len() == 64
			assert lines[3].len() == 8
			assert (try pemDecode(text)).bytes.hex() == data.hex()
		}

		@test()
		def TestErrors() {
			let messages string[]
			let cases = [
				"nothing here",
				"-----BEGIN A-----\nAQID\n-----END B-----\n",
				"-----BEGIN A-----\nAQID\n",
				"-----BEGIN A-----\n*not base64*\n-----END A-----\n",
			]
			for let (_, text) in cases {
				pemDecode(text) onerror (err error) {
					messages.push(err.message)
					recover new PEMBlock("", [])
				}
			}
			assert messages.len() == 4
			assert messages[0] == "pem: no PEM block found"
			assert messages[1] == "pem: END B closes BEGIN A"
			assert messages[2] == "pem: BEGIN A has no END line"
			assert messages[3] == "pem: body of A is not Base64"
		}
	}
}
