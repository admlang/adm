partial module std.data.encoding {
	use (
		std.io
		std.time
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext)
		std.data.encoding.json::(fieldFlag, quote)
		std.data.encoding.cbor::(validUTF8)
		std.data.encoding.layout::(zigzag, unzigzag)
		std.data.encoding.protobuf::*
	)

	// How a field's value is laid out on the wire. The member values are the
	// wire type numbers.
	enum ProtoWireType {
		// int32, int64, uint32, uint64, sint32, sint64, bool, enum.
		Varint = 0,
		// fixed64, sfixed64, double.
		I64 = 1,
		// string, bytes, embedded messages, packed repeated fields.
		Len = 2,
		// The start of a proto2 group (deprecated).
		StartGroup = 3,
		// The end of a proto2 group (deprecated).
		EndGroup = 4,
		// fixed32, sfixed32, float.
		I32 = 5
	}

	// How an integer field is encoded.
	enum ProtoEncoding {
		// A varint: int32, int64, uint32, uint64. Negative values take ten
		// bytes.
		Varint,
		// A zigzag varint: sint32, sint64. Small negatives stay short.
		ZigZag,
		// Little-endian, four or eight bytes by the integer's width: fixed32,
		// fixed64, sfixed32, sfixed64.
		Fixed
	}

	// Writes Protocol Buffers fields one at a time, for messages built by
	// hand or by generated code. Every write emits the field, zero values
	// included.
	//
	//     let w = new ProtoWriter()
	//     w.write(1, 150)
	//     w.write(2, "testing")
	//     let inner = new ProtoWriter()
	//     inner.write(1, -1, ProtoEncoding.ZigZag)
	//     w.write(3, inner)
	//     let data = w.bytes()
	type ProtoWriter {
		internal out byte[]

		// The bytes written so far.
		def bytes() byte[] {
			return out
		}

		// How many bytes have been written.
		def len() int {
			return out.len()
		}

		// An int64 (Varint), sint64 (ZigZag) or sfixed64 (Fixed) field.
		def write(field int, v int, encoding ProtoEncoding = ProtoEncoding.Varint) {
			pbWriteInt64(out, field, v, encoding)
		}

		// An int32 (Varint), sint32 (ZigZag) or sfixed32 (Fixed) field. A
		// negative int32 takes ten bytes as a varint, as the specification
		// requires.
		def write(field int, v int32, encoding ProtoEncoding = ProtoEncoding.Varint) {
			pbWriteInt32(out, field, v, encoding)
		}

		// A uint64 (Varint) or fixed64 (Fixed) field.
		def write(field int, v uint64, encoding ProtoEncoding = ProtoEncoding.Varint) {
			pbWriteUint64(out, field, v, encoding)
		}

		// A uint32 (Varint) or fixed32 (Fixed) field.
		def write(field int, v uint32, encoding ProtoEncoding = ProtoEncoding.Varint) {
			pbWriteUint32(out, field, v, encoding)
		}

		// A bool field.
		def write(field int, v bool) {
			pbTag(out, field, 0)
			out.push(byte(v ?? (1, 0)))
		}

		// A float field.
		def write(field int, v float32) {
			pbTag(out, field, 5)
			pbLE(out, uint64(__bitcast_u32_from_f32(v)), 4)
		}

		// A double field.
		def write(field int, v float) {
			pbTag(out, field, 1)
			pbLE(out, __bitcast_u64_from_f64(float64(v)), 8)
		}

		// A string field.
		def write(field int, v string) {
			pbWriteLen(out, field, v.bytes())
		}

		// A bytes field.
		def write(field int, v byte[]) {
			pbWriteLen(out, field, v)
		}

		// An embedded message field holding what message has written.
		def write(field int, message ProtoWriter) {
			pbWriteLen(out, field, message.out)
		}

		// A proto2 group field holding what group has written.
		def writeGroup(field int, group ProtoWriter) {
			pbTag(out, field, 3)
			out.push(...group.out)
			pbTag(out, field, 4)
		}

		// A packed repeated int64, sint64 or sfixed64 field.
		def writePacked(field int, values int[], encoding ProtoEncoding = ProtoEncoding.Varint) {
			let body byte[]
			for let (_, v) in values {
				pbInt64Value(body, v, encoding)
			}
			pbWriteLen(out, field, body)
		}

		// A packed repeated int32, sint32 or sfixed32 field.
		def writePacked(field int, values int32[], encoding ProtoEncoding = ProtoEncoding.Varint) {
			let body byte[]
			for let (_, v) in values {
				pbInt32Value(body, v, encoding)
			}
			pbWriteLen(out, field, body)
		}

		// A packed repeated uint64 or fixed64 field.
		def writePacked(field int, values uint64[], encoding ProtoEncoding = ProtoEncoding.Varint) {
			let body byte[]
			for let (_, v) in values {
				pbUintValue(body, v, encoding, 8)
			}
			pbWriteLen(out, field, body)
		}

		// A packed repeated uint32 or fixed32 field.
		def writePacked(field int, values uint32[], encoding ProtoEncoding = ProtoEncoding.Varint) {
			let body byte[]
			for let (_, v) in values {
				pbUintValue(body, uint64(v), encoding, 4)
			}
			pbWriteLen(out, field, body)
		}

		// A packed repeated bool field.
		def writePacked(field int, values bool[]) {
			let body byte[]
			body.cap(values.len())
			for let (_, v) in values {
				body.push(byte(v ?? (1, 0)))
			}
			pbWriteLen(out, field, body)
		}

		// A packed repeated float field.
		def writePacked(field int, values float32[]) {
			let body byte[]
			body.cap(values.len() * 4)
			for let (_, v) in values {
				pbLE(body, uint64(__bitcast_u32_from_f32(v)), 4)
			}
			pbWriteLen(out, field, body)
		}

		// A packed repeated double field.
		def writePacked(field int, values float[]) {
			let body byte[]
			body.cap(values.len() * 8)
			for let (_, v) in values {
				pbLE(body, __bitcast_u64_from_f64(float64(v)), 8)
			}
			pbWriteLen(out, field, body)
		}

		// Appends whole encoded fields as they are, such as the unknown
		// fields a decoder kept or ProtoField.raw().
		def writeRaw(fields byte[]) {
			out.push(...fields)
		}
	}

	// One field read from a Protocol Buffers message: its number, its wire
	// type and its value, which the as* methods read as a given field type.
	// A Len value refers to the message it was read from without copying.
	type ProtoField {
		internal num      int
		internal wt       ProtoWireType = ProtoWireType.Varint
		// The value of a Varint, I64 or I32 field.
		internal bits     uint64
		// The bytes the field was read from, and the value's place in them:
		// the payload of a Len field or the body of a group.
		internal src      byte[]
		internal at       int
		internal n        int
		// Where the whole field, tag included, starts and ends in src.
		internal recStart int
		internal recEnd   int
		// Set on what ProtoMessage.get returns for a field the message does
		// not hold: every accessor then reads the field type's default.
		internal absent   bool

		// The field number.
		number int {
			def get() int {
				return num
			}
		}

		// The wire type.
		wireType ProtoWireType {
			def get() ProtoWireType {
				return wt
			}
		}

		// The value as an int64 (Varint), sint64 (ZigZag) or sfixed64
		// (Fixed); a Fixed I32 field reads as an sfixed32. Fails when the
		// wire type does not match the encoding.
		def asInt(encoding ProtoEncoding = ProtoEncoding.Varint) !int {
			match encoding {
				case ProtoEncoding.Fixed:
					return int(int32(uint32(bits))) when wt == ProtoWireType.I32
					try pbExpect(self, ProtoWireType.I64, "sfixed64")
					return int(bits)
				case ProtoEncoding.ZigZag:
					try pbExpect(self, ProtoWireType.Varint, "sint64")
					return unzigzag(uint(bits))
				default:
					try pbExpect(self, ProtoWireType.Varint, "int64")
					return int(bits)
			}
		}

		// The value as an int32 (Varint), sint32 (ZigZag) or sfixed32
		// (Fixed). A varint keeps its low 32 bits, as the specification
		// says a parser must. Fails when the wire type does not match.
		def asInt32(encoding ProtoEncoding = ProtoEncoding.Varint) !int32 {
			match encoding {
				case ProtoEncoding.Fixed:
					try pbExpect(self, ProtoWireType.I32, "sfixed32")
					return int32(uint32(bits))
				case ProtoEncoding.ZigZag:
					try pbExpect(self, ProtoWireType.Varint, "sint32")
					return int32(unzigzag(uint(bits & uint64(0xFFFFFFFF))))
				default:
					try pbExpect(self, ProtoWireType.Varint, "int32")
					return int32(uint32(bits & uint64(0xFFFFFFFF)))
			}
		}

		// The value as a uint64 (Varint) or fixed64 (Fixed); a Fixed I32
		// field reads as a fixed32. Fails when the wire type does not match.
		def asUint(encoding ProtoEncoding = ProtoEncoding.Varint) !uint64 {
			if encoding == ProtoEncoding.Fixed {
				return bits when wt == ProtoWireType.I32
				try pbExpect(self, ProtoWireType.I64, "fixed64")
				return bits
			}
			try pbExpect(self, ProtoWireType.Varint, "uint64")
			return bits
		}

		// The value as a uint32 (Varint, low 32 bits) or fixed32 (Fixed).
		// Fails when the wire type does not match.
		def asUint32(encoding ProtoEncoding = ProtoEncoding.Varint) !uint32 {
			if encoding == ProtoEncoding.Fixed {
				try pbExpect(self, ProtoWireType.I32, "fixed32")
			} else {
				try pbExpect(self, ProtoWireType.Varint, "uint32")
			}
			return uint32(bits & uint64(0xFFFFFFFF))
		}

		// The value as a bool: any non-zero varint is true. Fails unless the
		// field is a varint.
		def asBool() !bool {
			try pbExpect(self, ProtoWireType.Varint, "bool")
			return bits != uint64(0)
		}

		// The value as a float. Fails unless the field is a 32-bit value.
		def asFloat32() !float32 {
			try pbExpect(self, ProtoWireType.I32, "float")
			return __bitcast_f32_from_u32(uint32(bits))
		}

		// The value as a double. Fails unless the field is a 64-bit value.
		def asFloat() !float {
			try pbExpect(self, ProtoWireType.I64, "double")
			return float(__bitcast_f64_from_u64(bits))
		}

		// The value as a string. Fails unless it is a Len field holding
		// UTF-8 without U+0000.
		def asString() !string {
			try pbExpect(self, ProtoWireType.Len, "string")
			let b = src.slice(at, n)
			fail "protobuf: field {num} is not UTF-8" when !validUTF8(b)
			fail "protobuf: field {num} holds U+0000" when b.indexOf(byte(0)) >= 0
			return string(b)
		}

		// The value as bytes (a copy). Fails unless it is a Len field.
		def asBytes() !byte[] {
			try pbExpect(self, ProtoWireType.Len, "bytes")
			return src.slice(at, n).clone()
		}

		// The value as an embedded message (a Len field) or a group. Fails
		// when the bytes are not a well-formed message.
		def asMessage(maxDepth int = 100) !ProtoMessage {
			return new ProtoMessage() when absent
			fail "protobuf: field {num} is {pbWireName(wt)}, not a message" when wt != ProtoWireType.Len && wt != ProtoWireType.StartGroup
			return try pbParse(src, at, at + n, maxDepth)
		}

		// A packed repeated int64, sint64 or sfixed64 field (a Len field), or
		// a single unpacked element. Fails
		// when the wire type does not match or a packed element is malformed.
		def asInts(encoding ProtoEncoding = ProtoEncoding.Varint) !int[] {
			let out int[] = []
			return out when absent
			if wt != ProtoWireType.Len {
				out.push(try asInt(encoding))
				return out
			}
			let end = at + n
			let i = at
			for i < end {
				let (v, next) = try pbPackedNext(src, i, end, encoding, 8, num)
				i = next
				match encoding {
					case ProtoEncoding.ZigZag:
						out.push(unzigzag(uint(v)))
					default:
						out.push(int(v))
				}
			}
			return out
		}

		// A packed repeated int32, sint32 or sfixed32 field, or a single
		// unpacked element. Fails
		// when the wire type does not match or a packed element is malformed.
		def asInt32s(encoding ProtoEncoding = ProtoEncoding.Varint) !int32[] {
			let out int32[] = []
			return out when absent
			if wt != ProtoWireType.Len {
				out.push(try asInt32(encoding))
				return out
			}
			let end = at + n
			let i = at
			for i < end {
				let (v, next) = try pbPackedNext(src, i, end, encoding, 4, num)
				i = next
				let low = v & uint64(0xFFFFFFFF)
				out.push(encoding == ProtoEncoding.ZigZag ?? (int32(unzigzag(uint(low))), int32(uint32(low))))
			}
			return out
		}

		// A packed repeated uint64 or fixed64 field, or a single unpacked
		// element. Fails
		// when the wire type does not match or a packed element is malformed.
		def asUints(encoding ProtoEncoding = ProtoEncoding.Varint) !uint64[] {
			let out uint64[] = []
			return out when absent
			if wt != ProtoWireType.Len {
				out.push(try asUint(encoding))
				return out
			}
			let end = at + n
			let i = at
			for i < end {
				let (v, next) = try pbPackedNext(src, i, end, encoding, 8, num)
				i = next
				out.push(v)
			}
			return out
		}

		// A packed repeated uint32 or fixed32 field, or a single unpacked
		// element. Fails
		// when the wire type does not match or a packed element is malformed.
		def asUint32s(encoding ProtoEncoding = ProtoEncoding.Varint) !uint32[] {
			let out uint32[] = []
			return out when absent
			if wt != ProtoWireType.Len {
				out.push(try asUint32(encoding))
				return out
			}
			let end = at + n
			let i = at
			for i < end {
				let (v, next) = try pbPackedNext(src, i, end, encoding, 4, num)
				i = next
				out.push(uint32(v & uint64(0xFFFFFFFF)))
			}
			return out
		}

		// A packed repeated bool field, or a single unpacked element. Fails
		// when the wire type does not match or a packed element is malformed.
		def asBools() !bool[] {
			let out bool[] = []
			return out when absent
			if wt != ProtoWireType.Len {
				out.push(try asBool())
				return out
			}
			let end = at + n
			let i = at
			for i < end {
				let (v, next) = try pbPackedNext(src, i, end, ProtoEncoding.Varint, 8, num)
				i = next
				out.push(v != uint64(0))
			}
			return out
		}

		// A packed repeated float field, or a single unpacked element. Fails
		// when the wire type does not match or a packed element is malformed.
		def asFloat32s() !float32[] {
			let out float32[] = []
			return out when absent
			if wt != ProtoWireType.Len {
				out.push(try asFloat32())
				return out
			}
			fail "protobuf: packed floats in field {num} are not a whole number of 4-byte values" when n % 4 != 0
			out.cap(n / 4)
			for let i = at; i < at + n; i += 4 {
				out.push(__bitcast_f32_from_u32(uint32(pbReadLE(src, i, 4))))
			}
			return out
		}

		// A packed repeated double field, or a single unpacked element. Fails
		// when the wire type does not match or a packed element is malformed.
		def asFloats() !float[] {
			let out float[] = []
			return out when absent
			if wt != ProtoWireType.Len {
				out.push(try asFloat())
				return out
			}
			fail "protobuf: packed doubles in field {num} are not a whole number of 8-byte values" when n % 8 != 0
			out.cap(n / 8)
			for let i = at; i < at + n; i += 8 {
				out.push(float(__bitcast_f64_from_u64(pbReadLE(src, i, 8))))
			}
			return out
		}

		// The whole field as it was encoded, tag included: what
		// ProtoWriter.writeRaw takes to pass it on unchanged.
		def raw() byte[] {
			return src.slice(recStart, recEnd - recStart).clone()
		}
	}

	// The fields of a message read without a schema, in wire order, as
	// `protoc --decode_raw` shows them.
	//
	//     let m = try new Protobuf().parse(data)
	//     let id = try m.get(1).asInt()
	//     for let f in m.all(4) { … }
	type ProtoMessage {
		internal items ProtoField[]

		// Every field, in the order read; a repeated field appears once per
		// occurrence.
		fields ProtoField[] {
			def get() ProtoField[] {
				return items
			}
		}

		// The last occurrence of a field, which is the one a singular field
		// takes. A field the message does not hold reads as its type's
		// default (0, false, "", no bytes, an empty message or list), as
		// proto3 defines; has tells the two apart.
		def get(number int) ProtoField {
			for let i = items.len() - 1; i >= 0; i-- {
				return items[i] when items[i].number == number
			}
			return pbAbsent(number)
		}

		// Every occurrence of a field, in order.
		def all(number int) ProtoField[] {
			let out ProtoField[] = []
			for let (_, f) in items {
				out.push(f) when f.number == number
			}
			return out
		}

		// Reports whether the message holds the field.
		def has(number int) bool {
			for let (_, f) in items {
				return true when f.number == number
			}
			return false
		}

		// The message in the text form of `protoc --decode_raw`: one line per
		// field, a Len field shown as a nested message when it parses as one,
		// else as a string when it is UTF-8, else as escaped bytes.
		def str() string {
			return pbDescribe(self, "")
		}
	}

	// Reads the fields of a message one at a time.
	//
	//     let r = new ProtoReader(data)
	//     for r.more() {
	//         let f = try r.next()
	//         match f.number { … }
	//     }
	type ProtoReader {
		internal data byte[]
		internal stop int
		internal i    int    = 0

		// How deep groups may nest before next fails.
		maxDepth int = 100

		// Offset of the next field.
		pos int {
			def get() int {
				return i
			}
		}

		def new(data byte[]) {
			self.data = data
			stop = data.len()
		}

		// Reports whether another field follows.
		def more() bool {
			return i < stop
		}

		// Reads the next field and moves past it. Fails on a truncated field,
		// field number 0, wire types 6 and 7, an overlong varint, an end group
		// without a start, or groups nested deeper than maxDepth.
		def next() !ProtoField {
			return try pbNext(self, 0)
		}
	}

	// Qualified name of the `@protoField` meta function, used to look up field
	// options.
	internal const protobufAttr = "std.data.encoding.protoField"

	// Encodes and decodes Protocol Buffers (https://protobuf.dev/programming-guides/encoding/)
	// from annotated ADM types, and reads messages without a schema.
	//
	//     struct Person {
	//         @protoField(1)
	//         name string
	//         @protoField(2)
	//         id int32
	//         @protoField(3, encoding = ProtoEncoding.ZigZag)
	//         delta int
	//         @protoField(4)
	//         phones Phone[]
	//     }
	//
	//     let pb = new Protobuf()
	//     let data = pb.encode(person)
	//     try pb.decode(data, person)
	//     let m = try pb.parse(data)   // a ProtoMessage, no schema needed
	//
	// Field numbers come from `@protoField(field = N)`; a field without one
	// takes its declaration position, counting from 1. Types map as proto3
	// does: `int`/`int64` int64, `int32` int32, `uint`/`uint64` uint64,
	// `uint32` uint32 (smaller widths widen), `bool`, enum members by value,
	// `float32` float, `float` double, `string`, `byte[]` bytes, struct and
	// type embedded messages, `?T` optional, `T[]` repeated (scalars packed unless
	// `packed = false`), `map<string, V>` maps, `time.Time` the
	// google.protobuf.Timestamp message and `duration` google.protobuf.Duration.
	//
	// Encoding follows proto3 implicit presence: a scalar at its zero value,
	// an empty string, bytes, array or map, and a nested object whose
	// message would be empty are not written. A `?T` field has explicit
	// presence (proto3 `optional`): written whenever set, zero included;
	// `?T` fields sharing a `oneof` name form a oneof, and decoding one of
	// them clears the others (set at most one before encoding). Fields are written in declaration order. A field numbered
	// outside 1 to 536870911 or in the reserved 19000 to 19999 is skipped,
	// as is anything nested deeper than maxDepth (encode cannot fail).
	//
	// Decoding takes fields in any order: the last occurrence of a scalar
	// wins, occurrences of a message merge, repeated fields accept packed
	// and unpacked elements, unknown fields and groups are skipped, or kept
	// in a `@protoField(unknown = true)` byte[] field and written back by
	// encode. It fails when the wire type does not suit the field.
	type Protobuf {
		// How deep messages may nest, both ways.
		maxDepth int = 100

		// encode renders obj as a message.
		def encode(obj any) byte[] {
			let w = new ProtoWriter()
			pbEncodeObject(self, w, obj, 0)
			return w.bytes()
		}

		// encode writes obj as a message to the writer. Fails when the writer
		// does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// Reads a message without a schema. Fails when the bytes are not a
		// well-formed message.
		def parse(input byte[]) !ProtoMessage {
			return try pbParse(input, 0, input.len(), maxDepth)
		}

		// decode binds a message onto target's fields by field number.
		// Fails when the bytes are malformed or a wire type does not suit its
		// field.
		def decode(input byte[], target any) !none {
			return try pbBind(input, 0, input.len(), target, 0, maxDepth)
		}

		// decode reads everything the reader yields and binds it onto target.
		// Fails when the reader does or the data does not decode.
		def decode(reader io.Reader, target any) !none {
			let chunk byte[]
			chunk.len(4096)
			let all byte[]
			for {
				let n = try reader.read(chunk)
				break when n <= 0
				all += chunk.slice(0, n)
			}
			return try decode(all, target)
		}
	}

	// Controls how a field is encoded to and decoded from Protocol Buffers.
	//
	//     field     the field number (default: the declaration position)
	//     encoding  for integers: Varint (int32/int64/uint32/uint64), ZigZag
	//               (sint32/sint64) or Fixed (fixed32/fixed64/sfixed32/sfixed64)
	//     packed    false writes a repeated scalar field one element per tag
	//     oneof     on `?T` fields: the members of one oneof; decoding one clears the others
	//     unknown   on a byte[] field: keep unknown fields here and write them back
	//     ignore    never encode or decode the field
	//
	//     struct Point {
	//         @protoField(1, encoding = ProtoEncoding.ZigZag)
	//         x int32
	//     }
	meta def protoField(ctx FieldMetaContext, field int = 0, encoding ProtoEncoding = ProtoEncoding.Varint, packed bool = true, oneof string = "", unknown bool = false, ignore bool = false) {}

	// Controls how a property is encoded to and decoded from Protocol
	// Buffers. Takes the same options as the field form above.
	meta def protoField(ctx PropertyMetaContext, field int = 0, encoding ProtoEncoding = ProtoEncoding.Varint, packed bool = true, oneof string = "", unknown bool = false, ignore bool = false) {}

	// A field a message does not hold.
	internal def pbAbsent(number int) ProtoField {
		let f = new ProtoField()
		f.num = number
		f.absent = true
		return f
	}

	// Fails unless the field has the wire type a field type needs; an absent
	// field suits every type.
	internal def pbExpect(f ProtoField, want ProtoWireType, typeName string) !none {
		return none when f.absent
		fail "protobuf: field {f.num} is {pbWireName(f.wt)}, not {typeName}" when f.wt != want
		return none
	}

	// Reads one field at r.i, depth counting enclosing groups.
	internal def pbNext(r ProtoReader, depth int) !ProtoField {
		let f = new ProtoField()
		f.src = r.data
		f.recStart = r.i
		let (tag, afterTag) = try pbVarint(r.data, r.i, r.stop)
		r.i = afterTag
		let wire = int(tag & uint64(7))
		fail "protobuf: field number 0 at offset {f.recStart}" when tag >> 3 == uint64(0)
		fail "protobuf: field number {tag >> 3} at offset {f.recStart} exceeds 536870911" when tag >> 3 > uint64(536870911)
		f.num = int(tag >> 3)
		match wire {
			case 0:
				f.wt = ProtoWireType.Varint
				let (v, next) = try pbVarint(r.data, r.i, r.stop)
				f.bits = v
				r.i = next
			case 1:
				f.wt = ProtoWireType.I64
				fail "protobuf: field {f.num} at offset {f.recStart} runs past the end" when r.i + 8 > r.stop
				f.bits = pbReadLE(r.data, r.i, 8)
				r.i += 8
			case 2:
				f.wt = ProtoWireType.Len
				let (size, next) = try pbVarint(r.data, r.i, r.stop)
				fail "protobuf: field {f.num} at offset {f.recStart} runs past the end" when size > uint64(r.stop - next)
				f.at = next
				f.n = int(size)
				r.i = next + f.n
			case 3:
				f.wt = ProtoWireType.StartGroup
				fail "protobuf: groups nest deeper than {r.maxDepth} levels" when depth >= r.maxDepth
				f.at = r.i
				for {
					fail "protobuf: group {f.num} at offset {f.recStart} has no end" when r.i >= r.stop
					let inner = try pbNext(r, depth + 1)
					if inner.wt == ProtoWireType.EndGroup {
						fail "protobuf: group {f.num} at offset {f.recStart} ends with group {inner.num}" when inner.num != f.num
						f.n = inner.recStart - f.at
						break
					}
				}
			case 4:
				f.wt = ProtoWireType.EndGroup
				fail "protobuf: end of group {f.num} at offset {f.recStart} without a start" when depth == 0
			case 5:
				f.wt = ProtoWireType.I32
				fail "protobuf: field {f.num} at offset {f.recStart} runs past the end" when r.i + 4 > r.stop
				f.bits = pbReadLE(r.data, r.i, 4)
				r.i += 4
			default:
				fail "protobuf: invalid wire type {wire} at offset {f.recStart}"
		}
		f.recEnd = r.i
		return f
	}

	// Reads the fields between start and stop of data.
	internal def pbParse(data byte[], start int, stop int, maxDepth int) !ProtoMessage {
		let r = new ProtoReader(data)
		r.i = start
		r.stop = stop
		r.maxDepth = maxDepth
		let m = new ProtoMessage()
		for r.more() {
			m.items.push(try r.next())
		}
		return m
	}

	// Appends the decode_raw text of a message.
	internal def pbDescribe(m ProtoMessage, indent string) string {
		let out = ""
		for let (_, f) in m.items {
			match f.wt {
				case ProtoWireType.Varint:
					out += "{indent}{f.num}: {f.bits}\n"
				case ProtoWireType.I64:
					out += "{indent}{f.num}: 0x{pbHex(f.bits, 16)}\n"
				case ProtoWireType.I32:
					out += "{indent}{f.num}: 0x{pbHex(f.bits, 8)}\n"
				default:
					let nested = f.asMessage(16) onerror recover new ProtoMessage()
					if f.wt == ProtoWireType.StartGroup || (f.n > 0 && nested.items.len() > 0 && pbParses(f)) {
						out += "{indent}{f.num} \{\n"
						out += pbDescribe(nested, indent + "  ")
						out += "{indent}\}\n"
					} else {
						let b = f.src.slice(f.at, f.n)
						if validUTF8(b) && b.indexOf(byte(0)) < 0 {
							out += "{indent}{f.num}: {quote(string(b))}\n"
						} else {
							out += "{indent}{f.num}: h'{b.hex().lower()}'\n"
						}
					}
			}
		}
		return out
	}

	// Reports whether a Len field's payload is a well-formed message.
	internal def pbParses(f ProtoField) bool {
		let ok = true
		pbParse(f.src, f.at, f.at + f.n, 16) onerror (err error) {
			ok = false
			recover new ProtoMessage()
		}
		return ok
	}

	// Writes an object's fields.
	internal def pbEncodeObject(c Protobuf, w ProtoWriter, obj any, depth int) {
		match obj {
			case time.Time:
				pbEncodeTimestamp(w, obj)
				return
			default:
		}
		let fields = reflection.fields(obj)
		for let (i, f) in fields {
			continue when fieldFlag(f, protobufAttr, "ignore")
			if fieldFlag(f, protobufAttr, "unknown") {
				w.writeRaw(pbFieldBytes(f))
				continue
			}
			let number = pbFieldNumber(f, i)
			continue when !pbValidNumber(number)
			pbEncodeField(c, w, f, number, depth)
		}
	}

	// The field number of the field at declaration position i.
	internal def pbFieldNumber(f Field, i int) int {
		let given = f.attr(protobufAttr, "field")
		return i + 1 when given == ""
		return parseInt<int>(given)
	}

	// The encoding an integer field asks for.
	internal def pbFieldEncoding(f Field) ProtoEncoding {
		match f.attr(protobufAttr, "encoding") {
			case "ZigZag":
				return ProtoEncoding.ZigZag
			case "Fixed":
				return ProtoEncoding.Fixed
			default:
				return ProtoEncoding.Varint
		}
	}

	// Writes one field, leaving it out at its zero value.
	internal def pbEncodeField(c Protobuf, w ProtoWriter, f Field, number int, depth int) {
		let enc = pbFieldEncoding(f)
		if f.typeName == "duration" {
			let ns = f.asInt()
			pbWriteDuration(w, number, ns) when ns != 0
			return
		}
		match f.kind {
			case FieldKind.Array:
				let n = f.len()
				return when n == 0
				if f.typeName := "byte[]" || "uint8[]" {
					w.write(number, pbFieldBytes(f))
					return
				}
				let packed = f.attr(protobufAttr, "packed") != "false"
				if packed && pbPackable(f.elemKind) {
					let body byte[]
					for let i = 0; i < n; i++ {
						pbScalarValue(body, f.at(i), f.elemKind, pbElemTypeName(f.typeName), enc)
					}
					pbWriteLen(w.out, number, body)
					return
				}
				for let i = 0; i < n; i++ {
					pbEncodeElement(c, w, f.at(i), f.elemKind, pbElemTypeName(f.typeName), number, enc, depth)
				}
			case FieldKind.Map:
				for let key in f.keys() {
					let entry = new ProtoWriter()
					entry.write(1, key)
					pbEncodeElement(c, entry, f.entry(key), f.elemKind, pbMapValueTypeName(f.typeName), 2, enc, depth)
					w.write(number, entry)
				}
			case FieldKind.String:
				let s = f.asString()
				w.write(number, s) when s != ""
			case FieldKind.Optional:
				// Explicit presence: written whenever set, zero included.
				return when f.value() is none
				pbEncodeElement(c, w, f, f.elemKind, pbInnerTypeName(f.typeName), number, enc, depth)
			case FieldKind.Bool, FieldKind.Int, FieldKind.Uint, FieldKind.Float, FieldKind.Enum:
				return when pbIsDefault(f)
				pbEncodeElement(c, w, f, f.kind, f.typeName, number, enc, depth)
			default:
				// A struct field always holds a value, so one whose message
				// would be empty counts as unset.
				let sub = new ProtoWriter()
				pbEncodeElement(c, sub, f, f.kind, f.typeName, number, enc, depth)
				w.writeRaw(sub.bytes()) when !pbEmptyLen(sub.bytes())
		}
	}

	// Writes one value with its tag: a singular field, a repeated element or
	// a map value. Scalars are written even at zero.
	internal def pbEncodeElement(c Protobuf, w ProtoWriter, f Field, kind FieldKind, typeName string, number int, enc ProtoEncoding, depth int) {
		if typeName == "duration" {
			pbWriteDuration(w, number, f.asInt())
			return
		}
		match kind {
			case FieldKind.String:
				w.write(number, f.asString())
			case FieldKind.Bool:
				w.write(number, f.asBool())
			case FieldKind.Float:
				if typeName == "float32" {
					w.write(number, float32(f.asFloat()))
				} else {
					w.write(number, f.asFloat())
				}
			case FieldKind.Int, FieldKind.Enum:
				if pbIs32(typeName) {
					w.write(number, int32(f.asInt()), enc)
				} else {
					w.write(number, f.asInt(), enc)
				}
			case FieldKind.Uint:
				if pbIs32(typeName) {
					w.write(number, uint32(f.asUint()), enc)
				} else {
					w.write(number, uint64(f.asUint()), enc)
				}
			default:
				return when depth >= c.maxDepth
				let nested = f.value()
				return when nested is none
				match nested {
					case byte[]:
						w.write(number, nested)
						return
					default:
				}
				let sub = new ProtoWriter()
				pbEncodeObject(c, sub, nested, depth + 1)
				w.write(number, sub)
		}
	}

	// Writes a scalar's value without a tag, for a packed field.
	internal def pbScalarValue(body byte[], f Field, kind FieldKind, typeName string, enc ProtoEncoding) {
		match kind {
			case FieldKind.Bool:
				body.push(byte(f.asBool() ?? (1, 0)))
			case FieldKind.Float:
				if typeName == "float32" {
					pbLE(body, uint64(__bitcast_u32_from_f32(float32(f.asFloat()))), 4)
				} else {
					pbLE(body, __bitcast_u64_from_f64(float64(f.asFloat())), 8)
				}
			case FieldKind.Uint:
				pbUintValue(body, uint64(f.asUint()), enc, pbIs32(typeName) ?? (4, 8))
			default:
				if pbIs32(typeName) {
					pbInt32Value(body, int32(f.asInt()), enc)
				} else {
					pbInt64Value(body, f.asInt(), enc)
				}
		}
	}

	// The bytes of a byte[] field.
	internal def pbFieldBytes(f Field) byte[] {
		let n = f.len()
		let b byte[]
		b.cap(n)
		for let i = 0; i < n; i++ {
			b.push(byte(f.at(i).asUint()))
		}
		return b
	}

	// Writes a time.Time as a google.protobuf.Timestamp: seconds (1) and
	// nanos (2), nanos never negative.
	internal def pbEncodeTimestamp(w ProtoWriter, t time.Time) {
		let ns = t.unixNs()
		let sec = ns / int64(1000000000)
		let nsec = ns % int64(1000000000)
		if nsec < int64(0) {
			sec--
			nsec += int64(1000000000)
		}
		w.write(1, int(sec)) when sec != int64(0)
		w.write(2, int32(nsec)) when nsec != int64(0)
	}

	// Writes a duration as a google.protobuf.Duration: seconds (1) and
	// nanos (2), both with the sign of the duration.
	internal def pbWriteDuration(w ProtoWriter, number int, ns int) {
		let d = new ProtoWriter()
		let sec = ns / 1000000000
		let nsec = ns % 1000000000
		d.write(1, sec) when sec != 0
		d.write(2, int32(nsec)) when nsec != 0
		w.write(number, d)
	}

	// Binds the message between start and stop of data onto target.
	internal def pbBind(data byte[], start int, stop int, target any, depth int, maxDepth int) !none {
		expects {
			assert depth < maxDepth onerror fail "protobuf: messages nest deeper than {maxDepth} levels"
		}
		let fields = reflection.fields(target)
		let numbers int[] = []
		let unknownAt = -1
		for let (i, f) in fields {
			if fieldFlag(f, protobufAttr, "ignore") {
				numbers.push(0)
				continue
			}
			if fieldFlag(f, protobufAttr, "unknown") {
				unknownAt = i
				numbers.push(0)
				continue
			}
			numbers.push(pbFieldNumber(f, i))
		}
		let unknown byte[]
		let r = new ProtoReader(data)
		r.i = start
		r.stop = stop
		r.maxDepth = maxDepth
		for r.more() {
			let pf = try r.next()
			let idx = numbers.indexOf(pf.num)
			if idx < 0 {
				unknown.push(...pf.src.slice(pf.recStart, pf.recEnd - pf.recStart)) when unknownAt >= 0
				continue
			}
			try pbBindField(pf, fields[idx], depth, maxDepth)
			let group = fields[idx].attr(protobufAttr, "oneof")
			if group != "" {
				for let (j, other) in fields {
					other.setNone() when j != idx && other.attr(protobufAttr, "oneof") == group
				}
			}
		}
		if unknownAt >= 0 && unknown.len() > 0 {
			let f = fields[unknownAt]
			let have = f.len()
			fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + unknown.len())
			for let (i, x) in unknown {
				f.at(have + i).setUint(uint(x))
			}
		}
		return none
	}

	// Stores one field read from the wire.
	internal def pbBindField(pf ProtoField, f Field, depth int, maxDepth int) !none {
		let enc = pbFieldEncoding(f)
		match f.kind {
			case FieldKind.Array:
				if f.typeName := "byte[]" || "uint8[]" {
					let b = try pf.asBytes()
					fail "protobuf: cannot resize `{f.name}`" when !f.setLen(b.len())
					for let (i, x) in b {
						f.at(i).setUint(uint(x))
					}
					return none
				}
				let elemType = pbElemTypeName(f.typeName)
				return try pbBindPacked(pf, f, elemType, enc) when pbPackable(f.elemKind) && pf.wt == ProtoWireType.Len
				let have = f.len()
				fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + 1)
				return try pbBindValue(pf, f.at(have), f.elemKind, elemType, enc, f.name, depth, maxDepth)
			case FieldKind.Map:
				fail "protobuf: map field `{f.name}` needs a Len field, got {pbWireName(pf.wt)}" when pf.wt != ProtoWireType.Len
				let entry = try pf.asMessage(maxDepth)
				let slot = f.entry(try entry.get(1).asString())
				return try pbBindZero(slot, f.elemKind, f.name) unless entry.has(2)
				return try pbBindValue(entry.get(2), slot, f.elemKind, pbMapValueTypeName(f.typeName), enc, f.name, depth, maxDepth)
			default:
				return try pbBindValue(pf, f, f.kind, f.typeName, enc, f.name, depth, maxDepth)
		}
	}

	// Stores one value in a field, array element or map entry.
	internal def pbBindValue(pf ProtoField, f Field, kind FieldKind, typeName string, enc ProtoEncoding, name string, depth int, maxDepth int) !none {
		return try pbBindValue(pf, f, f.elemKind, pbInnerTypeName(typeName), enc, name, depth, maxDepth) when kind == FieldKind.Optional
		if typeName == "duration" {
			f.setInt(try pbReadDuration(pf, maxDepth))
			return none
		}
		match kind {
			case FieldKind.String:
				f.setString(try pf.asString())
			case FieldKind.Bool:
				f.setBool(try pf.asBool())
			case FieldKind.Float:
				if typeName == "float32" {
					f.setFloat(float(try pf.asFloat32()))
				} else {
					f.setFloat(try pf.asFloat())
				}
			case FieldKind.Int, FieldKind.Enum:
				if pbIs32(typeName) {
					f.setInt(int(try pf.asInt32(enc)))
				} else {
					f.setInt(try pf.asInt(enc))
				}
			case FieldKind.Uint:
				if pbIs32(typeName) {
					f.setUint(uint(try pf.asUint32(enc)))
				} else {
					f.setUint(uint(try pf.asUint(enc)))
				}
			case FieldKind.Struct:
				fail "protobuf: field `{name}` is a message, got {pbWireName(pf.wt)}" when pf.wt != ProtoWireType.Len
				if typeName == "std.time.Time" {
					let m = try pf.asMessage(maxDepth)
					fail "protobuf: cannot store a Timestamp in `{name}`" unless f.set(try pbTimestampOf(m))
					return none
				}
				let nested = f.ensureValue()
				fail "protobuf: cannot store a message in `{name}`" when nested is none
				try pbBind(pf.src, pf.at, pf.at + pf.n, nested, depth + 1, maxDepth)
			default:
				fail "protobuf: cannot store {pbWireName(pf.wt)} field {pf.num} in `{name}`"
		}
		return none
	}

	// Stores the zero value of a map entry whose value was left out.
	internal def pbBindZero(slot Field, kind FieldKind, name string) !none {
		match kind {
			case FieldKind.String:
				slot.setString("")
			case FieldKind.Bool:
				slot.setBool(false)
			case FieldKind.Int, FieldKind.Enum:
				slot.setInt(0)
			case FieldKind.Uint:
				slot.setUint(0)
			case FieldKind.Float:
				slot.setFloat(0.0)
			default:
				fail "protobuf: cannot store an empty message in `{name}`" when slot.ensureValue() is none
		}
		return none
	}

	// Appends the elements of a packed field to an array field.
	internal def pbBindPacked(pf ProtoField, f Field, elemType string, enc ProtoEncoding) !none {
		let have = f.len()
		match f.elemKind {
			case FieldKind.Bool:
				let vals = try pf.asBools()
				fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + vals.len())
				for let (i, v) in vals {
					f.at(have + i).setBool(v)
				}
			case FieldKind.Float:
				if elemType == "float32" {
					let vals = try pf.asFloat32s()
					fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + vals.len())
					for let (i, v) in vals {
						f.at(have + i).setFloat(float(v))
					}
				} else {
					let vals = try pf.asFloats()
					fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + vals.len())
					for let (i, v) in vals {
						f.at(have + i).setFloat(v)
					}
				}
			case FieldKind.Uint:
				if pbIs32(elemType) {
					let vals = try pf.asUint32s(enc)
					fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + vals.len())
					for let (i, v) in vals {
						f.at(have + i).setUint(uint(v))
					}
				} else {
					let vals = try pf.asUints(enc)
					fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + vals.len())
					for let (i, v) in vals {
						f.at(have + i).setUint(uint(v))
					}
				}
			default:
				if pbIs32(elemType) {
					let vals = try pf.asInt32s(enc)
					fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + vals.len())
					for let (i, v) in vals {
						f.at(have + i).setInt(int(v))
					}
				} else {
					let vals = try pf.asInts(enc)
					fail "protobuf: cannot resize `{f.name}`" when !f.setLen(have + vals.len())
					for let (i, v) in vals {
						f.at(have + i).setInt(v)
					}
				}
		}
		return none
	}

	// The time.Time a google.protobuf.Timestamp holds. Fails when nanos lie
	// outside 0 to 999999999 or the instant outside what time.Time holds.
	internal def pbTimestampOf(m ProtoMessage) !time.Time {
		let sec = try m.get(1).asInt()
		let nsec = int(try m.get(2).asInt32())
		fail "protobuf: Timestamp nanos {nsec} lie outside 0 to 999999999" when nsec < 0 || nsec > 999999999
		let total = bigint(sec) * bigint(1000000000) + bigint(nsec)
		fail "protobuf: Timestamp {sec}s lies outside the range of time.Time" when total < -(bigint(1) << 63) || total >= bigint(1) << 63
		return time.fromUnixNs(int64(total))
	}

	// Reads a google.protobuf.Duration as nanoseconds.
	internal def pbReadDuration(pf ProtoField, maxDepth int) !int {
		let m = try pf.asMessage(maxDepth)
		let sec = try m.get(1).asInt()
		let nsec = int(try m.get(2).asInt32())
		fail "protobuf: Duration nanos {nsec} lie outside -999999999 to 999999999" when nsec < -999999999 || nsec > 999999999
		fail "protobuf: Duration seconds and nanos have different signs" when (sec > 0 && nsec < 0) || (sec < 0 && nsec > 0)
		let total = bigint(sec) * bigint(1000000000) + bigint(nsec)
		fail "protobuf: Duration {sec}s lies outside the range of duration" when total < -(bigint(1) << 63) || total >= bigint(1) << 63
		return int(total)
	}
}

internal partial module std.data.encoding.protobuf {
	use (
		std.reflection::(FieldKind, Field)
		std.data.encoding::*
		std.data.encoding.layout::(zigzag, unzigzag)
	)

	def pbVarintOut(out byte[], v uint64) {
		let rest = v
		for rest >= uint64(0x80) {
			out.push(byte((rest & uint64(0x7F)) | uint64(0x80)))
			rest = rest >> 7
		}
		out.push(byte(rest))
	}

	// Reads a varint at i, before stop; returns the value and the offset
	// after it. Fails on a truncated varint or one longer than ten bytes or
	// 64 bits.
	def pbVarint(data byte[], i int, stop int) !(uint64, int) {
		let v uint64 = 0
		let shift = 0
		let j = i
		for {
			fail "protobuf: data ends inside a varint at offset {i}" when j >= stop
			let b = uint64(data[j])
			j++
			fail "protobuf: varint at offset {i} is longer than 64 bits" when shift == 63 && b > uint64(1)
			v = v | ((b & uint64(0x7F)) << shift)
			return (v, j) when b < uint64(0x80)
			shift += 7
		}
	}

	def pbTag(out byte[], field int, wire int) {
		pbVarintOut(out, (uint64(field) << 3) | uint64(wire))
	}

	def pbLE(out byte[], v uint64, size int) {
		for let s = 0; s < size * 8; s += 8 {
			out.push(byte((v >> s) & uint64(0xFF)))
		}
	}

	def pbReadLE(data byte[], i int, size int) uint64 {
		let v uint64 = 0
		for let j = size - 1; j >= 0; j-- {
			v = (v << 8) | uint64(data[i + j])
		}
		return v
	}

	def pbWriteLen(out byte[], field int, payload byte[]) {
		pbTag(out, field, 2)
		pbVarintOut(out, uint64(payload.len()))
		out.push(...payload)
	}

	def pbInt64Value(out byte[], v int, encoding ProtoEncoding) {
		match encoding {
			case ProtoEncoding.ZigZag:
				pbVarintOut(out, uint64(zigzag(v)))
			case ProtoEncoding.Fixed:
				pbLE(out, uint64(v), 8)
			default:
				pbVarintOut(out, uint64(v))
		}
	}

	def pbInt32Value(out byte[], v int32, encoding ProtoEncoding) {
		match encoding {
			case ProtoEncoding.ZigZag:
				pbVarintOut(out, uint64(zigzag(int(v))))
			case ProtoEncoding.Fixed:
				pbLE(out, uint64(uint32(v)), 4)
			default:
				// A negative int32 is sign-extended to 64 bits.
				pbVarintOut(out, uint64(int(v)))
		}
	}

	def pbUintValue(out byte[], v uint64, encoding ProtoEncoding, size int) {
		if encoding == ProtoEncoding.Fixed {
			pbLE(out, v, size)
		} else {
			pbVarintOut(out, v)
		}
	}

	// The wire type number an integer of the encoding and width takes.
	def pbIntWire(encoding ProtoEncoding, size int) int {
		return encoding != ProtoEncoding.Fixed ?? (0, size == 4 ?? (5, 1))
	}

	def pbWriteInt64(out byte[], field int, v int, encoding ProtoEncoding) {
		pbTag(out, field, pbIntWire(encoding, 8))
		pbInt64Value(out, v, encoding)
	}

	def pbWriteInt32(out byte[], field int, v int32, encoding ProtoEncoding) {
		pbTag(out, field, pbIntWire(encoding, 4))
		pbInt32Value(out, v, encoding)
	}

	def pbWriteUint64(out byte[], field int, v uint64, encoding ProtoEncoding) {
		pbTag(out, field, pbIntWire(encoding, 8))
		pbUintValue(out, v, encoding, 8)
	}

	def pbWriteUint32(out byte[], field int, v uint32, encoding ProtoEncoding) {
		pbTag(out, field, pbIntWire(encoding, 4))
		pbUintValue(out, uint64(v), encoding, 4)
	}

	// Reads one element of a packed field at i: a varint, or size bytes when
	// Fixed.
	def pbPackedNext(data byte[], i int, end int, encoding ProtoEncoding, size int, field int) !(uint64, int) {
		return try pbVarint(data, i, end) when encoding != ProtoEncoding.Fixed
		fail "protobuf: packed field {field} is not a whole number of {size}-byte values" when i + size > end
		return (pbReadLE(data, i, size), i + size)
	}

	def pbWireName(wt ProtoWireType) string {
		match wt {
			case ProtoWireType.Varint:
				return "a varint"
			case ProtoWireType.I64:
				return "a 64-bit value"
			case ProtoWireType.Len:
				return "a length-delimited value"
			case ProtoWireType.I32:
				return "a 32-bit value"
			default:
				return "a group"
		}
	}

	def pbHex(v uint64, digits int) string {
		let out = ""
		for let s = (digits - 1) * 4; s >= 0; s -= 4 {
			out += "0123456789abcdef"[int((v >> s) & uint64(0xF))]
		}
		return out
	}

	// Reports whether the number is a valid field number outside the range
	// reserved for the protobuf implementation.
	def pbValidNumber(n int) bool {
		return n >= 1 && n <= 536870911 && (n < 19000 || n > 19999)
	}

	// Reports whether a repeated field of this element kind can be packed.
	def pbPackable(kind FieldKind) bool {
		return kind := FieldKind.Bool || FieldKind.Int || FieldKind.Uint || FieldKind.Float || FieldKind.Enum
	}

	// Reports whether an integer type is 32 bits or narrower on the wire.
	def pbIs32(typeName string) bool {
		return typeName := "int32" || "int16" || "int8" || "uint32" || "uint16" || "uint8"
	}

	// The element type of an array type name: "int32" for "int32[]".
	def pbElemTypeName(typeName string) string {
		return typeName.endsWith("[]") ?? (typeName.slice(0, typeName.len() - 2), typeName)
	}

	// The value type of a map type name: "int32" for "map<string, int32>".
	def pbMapValueTypeName(typeName string) string {
		let comma = typeName.indexOf(", ")
		return typeName when comma < 0 || !typeName.endsWith(">")
		return typeName.slice(comma + 2, typeName.len() - comma - 3)
	}

	// Reports whether encoded bytes are one Len field with an empty payload.
	def pbEmptyLen(b byte[]) bool {
		let (_, after) = pbVarint(b, 0, b.len()) onerror recover (uint64(0), 0)
		return after > 0 && after == b.len() - 1 && b[after] == byte(0)
	}

	// The type a `?T` name holds: "int32" for "?int32".
	def pbInnerTypeName(typeName string) string {
		return typeName.startsWith("?") ?? (typeName.slice(1), typeName)
	}

	// Reports whether a scalar field holds its proto3 default, which implicit
	// presence leaves off the wire: false, 0, the enum member valued 0, or a
	// float whose bits are zero (-0.0 is written).
	def pbIsDefault(f Field) bool {
		match f.kind {
			case FieldKind.Bool:
				return !f.asBool()
			case FieldKind.Int, FieldKind.Enum:
				return f.asInt() == 0
			case FieldKind.Uint:
				return f.asUint() == 0
			case FieldKind.Float:
				return __bitcast_u64_from_f64(float64(f.asFloat())) == uint64(0)
			default:
				return false
		}
	}
}
