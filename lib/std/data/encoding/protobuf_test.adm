partial module std.data.encoding {
	use (
		std.testing
		std.time
	)

	enum PbColour {
		Red,
		Green,
		Blue
	}

	struct PbPhone {
		@protoField(1)
		number string

		@protoField(2)
		kind int32
	}

	struct PbPerson {
		@protoField(1)
		name string

		@protoField(2)
		id int32

		@protoField(4)
		emails string[]

		@protoField(5)
		blob byte[]

		@protoField(6)
		active bool

		@protoField(7)
		score float

		@protoField(8)
		ratio float32

		@protoField(9)
		big uint64

		@protoField(11)
		nums int32[]

		@protoField(13)
		counts map<string, int32>

		@protoField(14)
		main PbPhone

		@protoField(15)
		at time.Time

		@protoField(16)
		wait duration

		@protoField(17)
		colour PbColour

		@protoField(18)
		small uint32

		@protoField(20)
		neg int32

		@protoField(22)
		fs float32[]

		@protoField(ignore = true)
		note string
	}

	// Field numbers from declaration order, unknown fields kept.
	struct PbKeeper {
		first  string
		second int

		@protoField(unknown = true)
		rest byte[]
	}

	struct PbUnpacked {
		@protoField(1, packed = false)
		nums int[]
	}

	struct PbPhoneBook {
		@protoField(21)
		phones PbPhone[]
	}

	// The Wire message of the reference .proto: every integer encoding.
	struct PbWire {
		@protoField(1, encoding = ProtoEncoding.ZigZag)
		s64 int

		@protoField(2, encoding = ProtoEncoding.ZigZag)
		s32 int32

		@protoField(3, encoding = ProtoEncoding.Fixed)
		f32 uint32

		@protoField(4, encoding = ProtoEncoding.Fixed)
		f64 uint64

		@protoField(5, encoding = ProtoEncoding.Fixed)
		sf32 int32

		@protoField(6, encoding = ProtoEncoding.Fixed)
		sf64 int

		@protoField(7, encoding = ProtoEncoding.ZigZag)
		zs int32[]

		@protoField(8, encoding = ProtoEncoding.Fixed)
		fx uint64[]

		@protoField(9)
		bs bool[]

		@protoField(10)
		ds float[]

		@protoField(11)
		us uint64[]
	}

	// Optional fields and a oneof.
	struct PbOpt {
		@protoField(1)
		a ?int32

		@protoField(2)
		b ?string

		@protoField(3, oneof = "pick")
		name ?string

		@protoField(4, oneof = "pick")
		num ?int32

		@protoField(5)
		d ?float
	}

	// The Person message of the reference .proto, serialized by the Python
	// protobuf runtime with deterministic output.
	const pbPersonHex = "0a03616e6e109601220361407822036240792a020102300139000000000000f83f450000803e48ffffffffffffffffff015a0d01ffffffffffffffffff01ac026a050a0161100172070a0335353510027a0808011080cab5ee0182011608ffffffffffffffffff01108cfcffffffffffffff01880102900107a001feffffffffffffffff01b201080000003f000000c0"

	def pbx(text string) byte[] {
		return hexdecode(text) onerror recover byte[]
	}

	def pbSample() PbPerson {
		let p = new PbPerson()
		p.name = "ann"
		p.id = int32(150)
		p.emails = ["a@x", "b@y"]
		p.blob = [byte(1), byte(2)]
		p.active = true
		p.score = 1.5
		p.ratio = float32(0.25)
		p.big = uint64(0xFFFFFFFFFFFFFFFF)
		p.nums = [int32(1), int32(-1), int32(300)]
		p.counts["a"] = int32(1)
		p.main.number = "555"
		p.main.kind = int32(2)
		p.at = time.fromUnixNs(1500000000)
		p.wait = -1000000500ns
		p.colour = PbColour.Blue
		p.small = uint32(7)
		p.neg = int32(-2)
		p.fs = [float32(0.5), float32(-2)]
		p.note = "not on the wire"
		return p
	}

	def pbRejects(hex string) bool {
		let failed = false
		new Protobuf().parse(pbx(hex)) onerror (err error) {
			failed = true
			recover new ProtoMessage()
		}
		println("{hex}: accepted") when !failed
		return failed
	}

	check "Protobuf" {
		@test()
		def TestWriterMatchesReference() !none {
			let w = new ProtoWriter()
			w.write(1, -1, ProtoEncoding.ZigZag)
			w.write(2, int32(-64), ProtoEncoding.ZigZag)
			w.write(3, uint32(7), ProtoEncoding.Fixed)
			w.write(4, uint64(1) << 63, ProtoEncoding.Fixed)
			w.write(5, int32(-2), ProtoEncoding.Fixed)
			w.write(6, -3, ProtoEncoding.Fixed)
			w.writePacked(7, [int32(0), int32(-1), int32(1)], ProtoEncoding.ZigZag)
			w.writePacked(8, [uint64(1), uint64(2)], ProtoEncoding.Fixed)
			w.writePacked(9, [true, false])
			w.writePacked(10, [1.5])
			w.writePacked(11, [uint64(300)])
			assert hexencode(w.bytes()).lower() == "0801107f1d070000002100000000000000802dfeffffff31fdffffffffffffff3a030001024210010000000000000002000000000000004a0201005208000000000000f83f5a02ac02"
			return none
		}

		@test()
		def TestWriterScalars() !none {
			let w = new ProtoWriter()
			w.write(1, 150)
			assert hexencode(w.bytes()).lower() == "089601"
			let neg = new ProtoWriter()
			neg.write(1, int32(-1))
			assert hexencode(neg.bytes()).lower() == "08ffffffffffffffffff01"
			let packed = new ProtoWriter()
			packed.writePacked(4, [3, 270, 86942])
			assert hexencode(packed.bytes()).lower() == "2206038e029ea705"
			let more = new ProtoWriter()
			more.writePacked(1, [-1], ProtoEncoding.Fixed)
			more.writePacked(2, [int32(-1)])
			more.writePacked(3, [uint32(1)], ProtoEncoding.Fixed)
			more.writePacked(4, [float32(1)])
			assert hexencode(more.bytes()).lower() == "0a08ffffffffffffffff120affffffffffffffffff011a04010000002204" + "0000803f"
			let g = new ProtoWriter()
			let body = new ProtoWriter()
			body.write(2, "x")
			g.writeGroup(5, body)
			assert hexencode(g.bytes()).lower() == "2b1201782c"
			assert g.len() == 5
			return none
		}

		@test()
		def TestReaderMatchesReference() !none {
			let m = try new Protobuf().parse(pbx("0801107f1d070000002100000000000000802dfeffffff31fdffffffffffffff3a030001024210010000000000000002000000000000004a0201005208000000000000f83f5a02ac02"))
			assert (try m.get(1).asInt(ProtoEncoding.ZigZag)) == -1
			assert (try m.get(2).asInt32(ProtoEncoding.ZigZag)) == int32(-64)
			assert (try m.get(3).asUint32(ProtoEncoding.Fixed)) == uint32(7)
			assert (try m.get(4).asUint(ProtoEncoding.Fixed)) == uint64(1) << 63
			assert (try m.get(5).asInt32(ProtoEncoding.Fixed)) == int32(-2)
			assert (try m.get(5).asInt(ProtoEncoding.Fixed)) == -2
			assert (try m.get(6).asInt(ProtoEncoding.Fixed)) == -3
			let zs = try m.get(7).asInt32s(ProtoEncoding.ZigZag)
			assert zs.len() == 3 && zs[1] == int32(-1) && zs[2] == int32(1)
			let fx = try m.get(8).asUints(ProtoEncoding.Fixed)
			assert fx.len() == 2 && fx[1] == uint64(2)
			let bs = try m.get(9).asBools()
			assert bs.len() == 2 && bs[0] && !bs[1]
			assert (try m.get(10).asFloats())[0] == 1.5
			assert (try m.get(11).asUints())[0] == uint64(300)
			let w32 = new ProtoWriter()
			w32.writePacked(1, [uint32(5), uint32(70000)])
			w32.writePacked(2, [float32(0.5), float32(-1)])
			w32.write(1, uint32(9))
			let m32 = try new Protobuf().parse(w32.bytes())
			let us = try m32.get(1).asUint32s()
			assert us.len() == 1 && us[0] == uint32(9)
			let both = m32.all(1)
			assert both.len() == 2 && (try both[0].asUint32s()).len() == 2 && (try both[0].asUint32s())[1] == uint32(70000)
			let fl = try m32.get(2).asFloat32s()
			assert fl.len() == 2 && fl[1] == float32(-1)
			assert m.has(11) && !m.has(12)
			assert (try m.get(12).asInt()) == 0 && (try m.get(12).asString()) == "" && (try m.get(12).asInts()).len() == 0
			assert (try m.get(12).asMessage()).fields.len() == 0 && (try m.get(12).asFloat32()) == float32(0)
			assert m.fields.len() == 11
			let wrongType = m.get(1).asFloat() onerror recover 9.0
			assert wrongType == 9.0
			return none
		}

		@test()
		def TestReaderFields() !none {
			let r = new ProtoReader(pbx("089601120774657374696e67"))
			let first = try r.next()
			assert first.number == 1 && first.wireType == ProtoWireType.Varint
			assert (try first.asInt()) == 150 && (try first.asUint()) == uint64(150)
			assert try first.asBool()
			assert r.pos == 3 && r.more()
			let second = try r.next()
			assert (try second.asString()) == "testing"
			assert (try second.asBytes()).equals("testing".bytes())
			assert hexencode(second.raw()).lower() == "120774657374696e67"
			assert !r.more()
			let copy = new ProtoWriter()
			copy.writeRaw(first.raw())
			copy.writeRaw(second.raw())
			assert hexencode(copy.bytes()).lower() == "089601120774657374696e67"
			// A varint keeps its low 32 bits for int32, uint32 and bool.
			let wide = try (try new Protobuf().parse(pbx("08ffffffffffffffffff01"))).get(1).asInt32()
			assert wide == int32(-1)
			let low = try (try new Protobuf().parse(pbx("088180808010"))).get(1).asUint32()
			assert low == uint32(1)
			let unpacked = try (try new Protobuf().parse(pbx("0803"))).get(1).asInts()
			assert unpacked.len() == 1 && unpacked[0] == 3
			return none
		}

		@test()
		def TestGroups() !none {
			let m = try new Protobuf().parse(pbx("2b1201782c0801"))
			let g = m.get(5)
			assert g.wireType == ProtoWireType.StartGroup
			assert (try (try g.asMessage()).get(2).asString()) == "x"
			assert (try m.get(1).asInt()) == 1
			let nested = try new Protobuf().parse(pbx("0b130801140c"))
			assert nested.fields.len() == 1
			return none
		}

		@test()
		def TestRejects() !none {
			assert pbRejects("08")
			assert pbRejects("0880")
			assert pbRejects("00")
			assert pbRejects("0f")
			assert pbRejects("0e")
			assert pbRejects("0a05616263")
			assert pbRejects("11010203")
			assert pbRejects("0d0102")
			assert pbRejects("0c")
			assert pbRejects("0b0801")
			assert pbRejects("0b14")
			assert pbRejects("08ffffffffffffffffff02")
			assert pbRejects("08ffffffffffffffffffff01")
			assert pbRejects("f8ffffff7f00")
			let deep = new Protobuf()
			deep.maxDepth = 2
			let failed = false
			deep.parse(pbx("0b0b0b0c0c0c")) onerror (err error) {
				failed = true
				recover new ProtoMessage()
			}
			assert failed
			let bad = try new Protobuf().parse(pbx("0a01ff"))
			let text = bad.get(1).asString() onerror recover "rejected"
			assert text == "rejected"
			return none
		}

		@test()
		def TestText() !none {
			let m = try new Protobuf().parse(pbx("0a03616e6e10960139000000000000f83f450000803e72070a033535351002"))
			assert m.str() == "1: \"ann\"\n2: 150\n7: 0x3ff8000000000000\n8: 0x3e800000\n14 \{\n  1: \"555\"\n  2: 2\n\}\n"
			let bin = try new Protobuf().parse(pbx("0a02ff00"))
			assert bin.str() == "1: h'ff00'\n"
			return none
		}

		@test()
		def TestEncodeMatchesReference() !none {
			let got = new Protobuf().encode(pbSample())
			println("got {hexencode(got).lower()}") when !got.equals(pbx(pbPersonHex))
			assert got.equals(pbx(pbPersonHex))
			let blank = new Protobuf().encode(new PbPerson())
			println("empty person encodes as {hexencode(blank).lower()}") when blank.len() > 0
			assert blank.len() == 0
			return none
		}

		@test()
		def TestDecodeReference() !none {
			let p = new PbPerson()
			try new Protobuf().decode(pbx(pbPersonHex), p)
			assert p.name == "ann" && p.id == int32(150)
			assert p.emails.len() == 2 && p.emails[1] == "b@y"
			assert p.blob.equals([byte(1), byte(2)])
			assert p.active && p.score == 1.5 && p.ratio == float32(0.25)
			assert p.big == uint64(0xFFFFFFFFFFFFFFFF)
			assert p.nums.len() == 3 && p.nums[1] == int32(-1) && p.nums[2] == int32(300)
			assert p.counts.len() == 1 && p.counts["a"] == int32(1)
			assert p.main.number == "555" && p.main.kind == int32(2)
			assert p.at.unixNs() == int64(1500000000)
			assert p.wait == -1000000500ns
			assert p.colour == PbColour.Blue
			assert p.small == uint32(7) && p.neg == int32(-2)
			assert p.fs.len() == 2 && p.fs[1] == float32(-2)
			assert p.note == ""
			return none
		}

		@test()
		def TestDecodeMerges() !none {
			// Scalars: last one wins. Messages: occurrences merge. Repeated:
			// packed and unpacked runs append.
			let p = new PbPerson()
			try new Protobuf().decode(pbx("1001100272030a01615a02010272021002" + "5803"), p)
			assert p.id == int32(2)
			assert p.main.number == "a" && p.main.kind == int32(2)
			assert p.nums.len() == 3 && p.nums[2] == int32(3)
			let wrong = new PbPerson()
			let failed = false
			new Protobuf().decode(pbx("0a0161" + "0d00000000"), wrong) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			return none
		}

		@test()
		def TestPositionalNumbersAndUnknown() !none {
			let k = new PbKeeper()
			k.first = "a"
			k.second = 5
			assert hexencode(new Protobuf().encode(k)).lower() == "0a01611005"
			let back = new PbKeeper()
			try new Protobuf().decode(pbx("0a0161100518072a0178"), back)
			assert back.first == "a" && back.second == 5
			assert hexencode(back.rest).lower() == "18072a0178"
			assert hexencode(new Protobuf().encode(back)).lower() == "0a0161100518072a0178"
			let u = new PbUnpacked()
			u.nums = [1, 2]
			assert hexencode(new Protobuf().encode(u)).lower() == "08010802"
			return none
		}

		@test()
		def TestEncodingAnnotations() !none {
			let w = new PbWire()
			w.s64 = -1
			w.s32 = int32(-64)
			w.f32 = uint32(7)
			w.f64 = uint64(1) << 63
			w.sf32 = int32(-2)
			w.sf64 = -3
			w.zs = [int32(0), int32(-1), int32(1)]
			w.fx = [uint64(1), uint64(2)]
			w.bs = [true, false]
			w.ds = [1.5]
			w.us = [uint64(300)]
			let hex = "0801107f1d070000002100000000000000802dfeffffff31fdffffffffffffff3a030001024210010000000000000002000000000000004a0201005208000000000000f83f5a02ac02"
			let got = new Protobuf().encode(w)
			println("got {hexencode(got).lower()}") when hexencode(got).lower() != hex
			assert hexencode(got).lower() == hex
			let back = new PbWire()
			try new Protobuf().decode(pbx(hex), back)
			assert back.s64 == -1 && back.s32 == int32(-64) && back.f32 == uint32(7) && back.f64 == uint64(1) << 63
			assert back.sf32 == int32(-2) && back.sf64 == -3
			assert back.zs.len() == 3 && back.zs[1] == int32(-1) && back.fx[1] == uint64(2)
			assert back.bs.len() == 2 && back.bs[0] && back.ds[0] == 1.5 && back.us[0] == uint64(300)
			return none
		}

		@test()
		def TestOptionalAndOneof() !none {
			let pb = new Protobuf()
			let zeros = new PbOpt()
			zeros.a = int32(0)
			zeros.b = ""
			zeros.d = 0.0
			assert hexencode(pb.encode(zeros)).lower() == "08001200290000000000000000"
			assert pb.encode(new PbOpt()).len() == 0
			let num = new PbOpt()
			num.num = int32(0)
			assert hexencode(pb.encode(num)).lower() == "2000"
			let back = new PbOpt()
			try pb.decode(pbx("08001200290000000000000000"), back)
			assert !(back.a is none) && !(back.b is none) && !(back.d is none) && back.name is none
			// The later oneof member wins and clears the earlier one.
			let both = new PbOpt()
			try pb.decode(pbx("1a0178" + "2005"), both)
			assert both.name is none && !(both.num is none)
			let n = both.num
			assert !(n is none) && n == int32(5)
			return none
		}

		@test()
		def TestDecodeRepeatedMessages() !none {
			let book = new PbPhoneBook()
			try new Protobuf().decode(pbx("aa01030a0131aa01050a01321003"), book)
			assert book.phones.len() == 2
			assert book.phones[0].number == "1" && book.phones[1].number == "2" && book.phones[1].kind == int32(3)
			return none
		}

		@test()
		def TestEncodeRepeatedMessages() !none {
			let book = new PbPhoneBook()
			let a = new PbPhone()
			a.number = "1"
			let b = new PbPhone()
			b.number = "2"
			b.kind = int32(3)
			book.phones = [a, b]
			assert hexencode(new Protobuf().encode(book)).lower() == "aa01030a0131aa01050a01321003"
			return none
		}
	}
}
