// Option interpretation and FileDescriptorProto encoding for ProtoSchema,
// plus the well-known .proto files protoc ships (proto/google/protobuf,
// BSD-3 licensed, proto/LICENSE).
internal partial module std.data.encoding.protoschema {
	use (
		std.data.encoding::*
		std.data.encoding.protobuf::(pbVarintOut, pbLE, pbTag)
		std.data.encoding.layout::(zigzag)
	)

	@embed("proto/google/protobuf/descriptor.proto")
	const descriptorProto byte[]

	@embed("proto/google/protobuf/any.proto")
	const anyProto byte[]

	@embed("proto/google/protobuf/api.proto")
	const apiProto byte[]

	@embed("proto/google/protobuf/duration.proto")
	const durationProto byte[]

	@embed("proto/google/protobuf/empty.proto")
	const emptyProto byte[]

	@embed("proto/google/protobuf/field_mask.proto")
	const fieldMaskProto byte[]

	@embed("proto/google/protobuf/source_context.proto")
	const sourceContextProto byte[]

	@embed("proto/google/protobuf/struct.proto")
	const structProto byte[]

	@embed("proto/google/protobuf/timestamp.proto")
	const timestampProto byte[]

	@embed("proto/google/protobuf/type.proto")
	const typeProto byte[]

	@embed("proto/google/protobuf/wrappers.proto")
	const wrappersProto byte[]

	// The source of a well-known .proto file every schema can import; none
	// for other names.
	def builtinProto(name string) ?string {
		match name {
			case "google/protobuf/descriptor.proto":
				return string(descriptorProto)
			case "google/protobuf/any.proto":
				return string(anyProto)
			case "google/protobuf/api.proto":
				return string(apiProto)
			case "google/protobuf/duration.proto":
				return string(durationProto)
			case "google/protobuf/empty.proto":
				return string(emptyProto)
			case "google/protobuf/field_mask.proto":
				return string(fieldMaskProto)
			case "google/protobuf/source_context.proto":
				return string(sourceContextProto)
			case "google/protobuf/struct.proto":
				return string(structProto)
			case "google/protobuf/timestamp.proto":
				return string(timestampProto)
			case "google/protobuf/type.proto":
				return string(typeProto)
			case "google/protobuf/wrappers.proto":
				return string(wrappersProto)
			default:
				return none
		}
	}

	// One option value set on an options message: the field and either its
	// encoded scalar or the index of a nested message among the node's
	// children.
	struct OptEntry {
		field ProtoFieldDef
		raw   byte[]
		child int           = -1
	}

	// An options message being built from option statements.
	type OptNode {
		msg      ProtoMessageDef
		entries  OptEntry[]
		children OptNode[]

		def new(msg ProtoMessageDef) {
			self.msg = msg
		}

		// The nested message of a singular message field, created on first
		// use so that `a.b = 1` and `a.c = 2` land in one message.
		def child(field ProtoFieldDef, types ProtoSchema) !OptNode {
			for let e in entries {
				return children[e.child] when e.field.number == field.number && e.child >= 0
			}
			return try addChild(field, types)
		}

		// A new nested message for a field, for a repeated message field.
		def addChild(field ProtoFieldDef, types ProtoSchema) !OptNode {
			let m = types.message(field.typeName)
			fail "option type {field.typeName} is not defined" when m is none
			let c = new OptNode(m)
			entries.push(OptEntry{field: field, child: children.len()})
			children.push(c)
			return c
		}

		def has(field ProtoFieldDef) bool {
			for let e in entries {
				return true when e.field.number == field.number
			}
			return false
		}
	}

	// What option interpretation needs: the schema whose files define the
	// options messages (descriptor.proto) and the extensions visible from
	// the file being resolved.
	struct OptContext {
		types      ProtoSchema
		table      map<string, string>
		extensions ProtoFieldDef[]
		file       string
	}

	// The extensions a file can see, its own included.
	def visibleExtensions(schema ProtoSchema, f ProtoFile) ProtoFieldDef[] {
		let out ProtoFieldDef[] = []
		collectExtensions(out, f.extensions, f.messages)
		let seen string[] = []
		for let dep in f.imports {
			let d = schema.file(dep)
			addImportedExtensions(schema, out, d, seen) unless d is none
		}
		return out
	}

	def addImportedExtensions(schema ProtoSchema, out ProtoFieldDef[], f ProtoFile, seen string[]) {
		return when seen.indexOf(f.name) >= 0
		seen.push(f.name)
		collectExtensions(out, f.extensions, f.messages)
		for let i in f.publicImports {
			let d = schema.file(f.imports[i])
			addImportedExtensions(schema, out, d, seen) unless d is none
		}
	}

	def collectExtensions(out ProtoFieldDef[], list ProtoFieldDef[], messages ProtoMessageDef[]) {
		for let x in list {
			out.push(x)
		}
		for let m in messages {
			collectExtensions(out, m.extensions, m.messages)
		}
	}

	// Interprets option statements against an options message
	// (`google.protobuf.FieldOptions`) and returns its encoding. Fails on an
	// unknown option, a value that does not fit, or a field set twice.
	def interpretOptions(ctx OptContext, options ProtoOption[], messageName string, scope string, line int) !byte[] {
		return [] when options.len() == 0
		let m = ctx.types.message(messageName)
		fail "{ctx.file}:{line}: {messageName} is not defined; options need google/protobuf/descriptor.proto" when m is none
		let root = new OptNode(m)
		for let o in options {
			try setOption(ctx, root, o, scope, line)
		}
		return encodeNode(root)
	}

	def setOption(ctx OptContext, root OptNode, o ProtoOption, scope string, line int) !none {
		let parts = splitOptionName(o.name)
		let node = root
		for let (i, part) in parts {
			let field = findOptionField(ctx, node.msg, part, scope)
			fail "{ctx.file}:{line}: option \"{o.name}\" is unknown: {node.msg.fullName} has no field {part}" when field is none
			if i < parts.len() - 1 {
				fail "{ctx.file}:{line}: option \"{o.name}\": {part} is not a message" unless field.fieldType := ProtoType.Message || ProtoType.Group
				fail "{ctx.file}:{line}: option \"{o.name}\": {part} is repeated" when field.label == ProtoLabel.Repeated
				node = try node.child(field, ctx.types)
				continue
			}
			setValue(ctx, node, field, o.value, scope) onerror (err error) {
				fail "{ctx.file}:{line}: option \"{o.name}\": {err.message}"
			}
		}
		return none
	}

	// Splits an option name at the dots outside parentheses.
	def splitOptionName(name string) string[] {
		let out string[] = []
		let cur = ""
		let depth = 0
		for let c in name {
			if c == '(' {
				depth++
			} else if c == ')' {
				depth--
			}
			if c == '.' && depth == 0 {
				out.push(cur)
				cur = ""
				continue
			}
			cur += string(c)
		}
		out.push(cur)
		return out
	}

	// The field a name part names in an options message: a plain field, or
	// an extension `(name)` resolved from scope.
	def findOptionField(ctx OptContext, m ProtoMessageDef, part string, scope string) ?ProtoFieldDef {
		if part.startsWith("(") || part.startsWith("[") {
			let name = part.slice(1, part.len() - 1)
			let full = resolveExtension(ctx, scope, name)
			return none when full == ""
			for let x in ctx.extensions {
				return x when x.fullName == full && x.extendee == "." + m.fullName
			}
			return none
		}
		for let f in m.fields {
			return f when f.name == part
		}
		// Text format names a group field by its type name.
		for let f in m.fields {
			return f when f.fieldType == ProtoType.Group && lastPart(f.typeName) == part
		}
		return none
	}

	def resolveExtension(ctx OptContext, scope string, name string) string {
		if name.startsWith(".") {
			for let x in ctx.extensions {
				return x.fullName when x.fullName == name.slice(1)
			}
			return ""
		}
		let s = scope
		for {
			let full = s == "" ?? (name, s + "." + name)
			for let x in ctx.extensions {
				return full when x.fullName == full
			}
			break when s == ""
			let parts = s.split(".")
			parts.len(parts.len() - 1)
			s = parts.join(".")
		}
		return ""
	}

	// Sets one field of an options node from a constant.
	def setValue(ctx OptContext, node OptNode, field ProtoFieldDef, v ProtoValue, scope string) !none {
		if v.kind == ProtoValueKind.List {
			fail "a list for non-repeated {field.name}" unless field.label == ProtoLabel.Repeated
			for let item in v.items {
				try setValue(ctx, node, field, item, scope)
			}
			return none
		}
		let repeated = field.label == ProtoLabel.Repeated
		if field.fieldType := ProtoType.Message || ProtoType.Group {
			fail "{field.name} needs a message value \{ … \}" unless v.kind == ProtoValueKind.Message
			let target = new OptNode(node.msg)
			if repeated {
				target = try node.addChild(field, ctx.types)
			} else {
				target = try node.child(field, ctx.types)
			}
			for let (i, name) in v.names {
				let sub = findOptionField(ctx, target.msg, name, scope)
				fail "{target.msg.fullName} has no field {name}" when sub is none
				try setValue(ctx, target, sub, v.values[i], scope)
			}
			return none
		}
		fail "{field.name} is already set" when !repeated && node.has(field)
		node.entries.push(OptEntry{field: field, raw: try encodeScalar(ctx, field, v)})
		return none
	}

	// The encoding of a scalar value for a field, without its tag.
	def encodeScalar(ctx OptContext, field ProtoFieldDef, v ProtoValue) !byte[] {
		let out byte[]
		match field.fieldType {
			case ProtoType.String, ProtoType.Bytes:
				fail "{field.name} needs a string" unless v.kind == ProtoValueKind.String
				pbVarintOut(out, uint64(v.bytes.len()))
				out.push(...v.bytes)
			case ProtoType.Bool:
				fail "{field.name} needs true or false" unless v.text := "true" || "false"
				out.push(byte(v.text == "true" ?? (1, 0)))
			case ProtoType.Double, ProtoType.Float:
				let x = try floatOf(v, field.name)
				if field.fieldType == ProtoType.Float {
					pbLE(out, uint64(__bitcast_u32_from_f32(float32(x))), 4)
				} else {
					pbLE(out, __bitcast_u64_from_f64(float64(x)), 8)
				}
			case ProtoType.Enum:
				fail "{field.name} needs an enum value name" unless v.kind == ProtoValueKind.Identifier
				let e = ctx.types.enumType(field.typeName)
				fail "{field.typeName} is not defined" when e is none
				let found = false
				for let value in e.values {
					if value.name == v.text {
						pbVarintOut(out, uint64(value.number))
						found = true
						break
					}
				}
				fail "{v.text} is not a value of {e.name}" unless found
			default:
				fail "{field.name} needs an integer" unless v.kind == ProtoValueKind.Int
				let neg = v.text.startsWith("-")
				let mag = try parseIntText(v.text.trimPrefix("-").trimPrefix("+"))
				let n = neg ?? (-mag, mag)
				try checkRange(field, n)
				match field.fieldType {
					case ProtoType.Sint32, ProtoType.Sint64:
						pbVarintOut(out, uint64(zigzag(int(n))))
					case ProtoType.Fixed32, ProtoType.Sfixed32:
						pbLE(out, uint64(n < bigint(0) ?? (n + (bigint(1) << 32), n)), 4)
					case ProtoType.Fixed64, ProtoType.Sfixed64:
						pbLE(out, uint64(n < bigint(0) ?? (n + (bigint(1) << 64), n)), 8)
					default:
						pbVarintOut(out, uint64(n < bigint(0) ?? (n + (bigint(1) << 64), n)))
				}
		}
		return out
	}

	def checkRange(field ProtoFieldDef, n bigint) !none {
		let lo = bigint(0)
		let hi = bigint(0)
		match field.fieldType {
			case ProtoType.Int32, ProtoType.Sint32, ProtoType.Sfixed32:
				lo = -(bigint(1) << 31)
				hi = (bigint(1) << 31) - bigint(1)
			case ProtoType.Uint32, ProtoType.Fixed32:
				hi = (bigint(1) << 32) - bigint(1)
			case ProtoType.Uint64, ProtoType.Fixed64:
				hi = (bigint(1) << 64) - bigint(1)
			default:
				lo = -(bigint(1) << 63)
				hi = (bigint(1) << 63) - bigint(1)
		}
		fail "{n} is out of range for {field.name}" when n < lo || n > hi
		return none
	}

	def floatOf(v ProtoValue, name string) !float {
		let text = v.text.trimPrefix("+")
		match text {
			case "inf":
				return 1.0 / 0.0
			case "-inf":
				return -1.0 / 0.0
			case "nan", "-nan":
				return 0.0 / 0.0
			default:
		}
		fail "{name} needs a number" unless v.kind := ProtoValueKind.Int || ProtoValueKind.Float
		if v.kind == ProtoValueKind.Int {
			let neg = text.startsWith("-")
			let mag = try parseIntText(text.trimPrefix("-"))
			return neg ?? (-float(mag), float(mag))
		}
		return parseFloat<float>(text)
	}

	// The bytes of an options node: its entries by field number, each with
	// its tag, a nested message length-delimited (or as a group).
	def encodeNode(node OptNode) byte[] {
		let order int[] = []
		for let i = 0; i < node.entries.len(); i++ {
			order.push(i)
		}
		let entries = node.entries
		order = order.sort((a int, b int) => entries[a].field.number < entries[b].field.number || (entries[a].field.number == entries[b].field.number && a < b))
		let out byte[]
		for let i in order {
			let e = entries[i]
			// protoc keeps source-retention options out of descriptors.
			continue when sourceRetained(e.field)
			if e.child >= 0 {
				let body = encodeNode(node.children[e.child])
				if e.field.fieldType == ProtoType.Group {
					pbTag(out, e.field.number, 3)
					out.push(...body)
					pbTag(out, e.field.number, 4)
				} else {
					pbTag(out, e.field.number, 2)
					pbVarintOut(out, uint64(body.len()))
					out.push(...body)
				}
				continue
			}
			pbTag(out, e.field.number, wireTypeOf(e.field.fieldType))
			out.push(...e.raw)
		}
		return out
	}

	// Reports whether an option field is declared `retention =
	// RETENTION_SOURCE`.
	def sourceRetained(f ProtoFieldDef) bool {
		for let o in f.options {
			return true when o.name == "retention" && o.value.text == "RETENTION_SOURCE"
		}
		return false
	}

	def wireTypeOf(t ProtoType) int {
		match t {
			case ProtoType.Double, ProtoType.Fixed64, ProtoType.Sfixed64:
				return 1
			case ProtoType.Float, ProtoType.Fixed32, ProtoType.Sfixed32:
				return 5
			case ProtoType.String, ProtoType.Bytes, ProtoType.Message:
				return 2
			default:
				return 0
		}
	}

	// Interprets the options of every definition in a file.
	def interpretFile(ctx OptContext, f ProtoFile) !none {
		f.optionBytes = try interpretOptions(ctx, f.options, "google.protobuf.FileOptions", f.package, 1)
		for let m in f.messages {
			try interpretMessage(ctx, m)
		}
		for let x in f.extensions {
			x.optionBytes = try interpretOptions(ctx, x.options, "google.protobuf.FieldOptions", f.package, x.line)
		}
		for let e in f.enums {
			try interpretEnum(ctx, e, f.package)
		}
		for let s in f.services {
			s.optionBytes = try interpretOptions(ctx, s.options, "google.protobuf.ServiceOptions", f.package, s.line)
			for let md in s.methods {
				md.optionBytes = try interpretOptions(ctx, md.options, "google.protobuf.MethodOptions", f.package, md.line)
			}
		}
		return none
	}

	def interpretMessage(ctx OptContext, m ProtoMessageDef) !none {
		m.optionBytes = try interpretOptions(ctx, m.options, "google.protobuf.MessageOptions", m.fullName, m.line)
		for let fd in m.fields {
			fd.optionBytes = try interpretOptions(ctx, fd.options, "google.protobuf.FieldOptions", m.fullName, fd.line)
		}
		for let x in m.extensions {
			x.optionBytes = try interpretOptions(ctx, x.options, "google.protobuf.FieldOptions", m.fullName, x.line)
		}
		for let o in m.oneofs {
			o.optionBytes = try interpretOptions(ctx, o.options, "google.protobuf.OneofOptions", m.fullName, m.line)
		}
		for let r in m.extensionRanges {
			r.optionBytes = try interpretOptions(ctx, r.options, "google.protobuf.ExtensionRangeOptions", m.fullName, m.line)
		}
		for let n in m.messages {
			try interpretMessage(ctx, n)
		}
		for let e in m.enums {
			try interpretEnum(ctx, e, m.fullName)
		}
		return none
	}

	def interpretEnum(ctx OptContext, e ProtoEnumDef, scope string) !none {
		e.optionBytes = try interpretOptions(ctx, e.options, "google.protobuf.EnumOptions", scope, e.line)
		for let v in e.values {
			v.optionBytes = try interpretOptions(ctx, v.options, "google.protobuf.EnumValueOptions", scope, e.line)
		}
		return none
	}

	// protoc's default json_name: underscores dropped, the letter after one
	// upper-cased.
	def jsonNameOf(name string) string {
		let out = ""
		let upper = false
		for let c in name {
			if c == '_' {
				upper = true
				continue
			}
			out += upper ?? (string(c).upper(), string(c))
			upper = false
		}
		return out
	}

	// The default_value protoc records for a field of its resolved type.
	def formatDefault(fd ProtoFieldDef) !string {
		let v = fd.defaultRaw
		match fd.fieldType {
			case ProtoType.String:
				fail "default for {fd.name} must be a string" unless v.kind == ProtoValueKind.String
				return string(v.bytes)
			case ProtoType.Bytes:
				fail "default for {fd.name} must be a string" unless v.kind == ProtoValueKind.String
				return cEscape(v.bytes)
			case ProtoType.Double:
				return formatDouble(try floatOf(v, fd.name))
			case ProtoType.Float:
				return formatFloat(try floatOf(v, fd.name))
			case ProtoType.Bool:
				fail "default for {fd.name} must be true or false" unless v.text := "true" || "false"
				return v.text
			case ProtoType.Enum, ProtoType.Message, ProtoType.Group:
				fail "default for {fd.name} must be an enum value name" unless v.kind == ProtoValueKind.Identifier
				return v.text
			default:
				fail "default for {fd.name} must be an integer" unless v.kind == ProtoValueKind.Int
				let neg = v.text.startsWith("-")
				let mag = try parseIntText(v.text.trimPrefix("-").trimPrefix("+"))
				let n = neg ?? (-mag, mag)
				try checkRange(fd, n)
				return n.toRadix(10)
		}
	}

	// protoc's SimpleDtoa: %.15g, or %.17g when that does not round-trip.
	def formatDouble(x float) string {
		return "nan" when x != x
		return x > 0.0 ?? ("inf", "-inf") when x * 0.0 != 0.0
		let short = "%.15g".format(x)
		return short when parseFloat<float>(short) == x
		return "%.17g".format(x)
	}

	// protoc's SimpleFtoa: %.6g, or %.9g when that does not round-trip as a
	// float.
	def formatFloat(x float) string {
		return "nan" when x != x
		return x > 0.0 ?? ("inf", "-inf") when x * 0.0 != 0.0
		let f = float32(x)
		let short = "%.6g".format(float(f))
		return short when float32(parseFloat<float>(short)) == f
		return "%.9g".format(float(f))
	}

	// C escaping as protoc writes bytes defaults: \n \r \t \" \' \\ and
	// octal for the rest outside printable ASCII.
	def cEscape(b byte[]) string {
		let out = ""
		for let x in b {
			match int(x) {
				case 0x0A:
					out += "\\n"
				case 0x0D:
					out += "\\r"
				case 0x09:
					out += "\\t"
				case 0x22:
					out += "\\\""
				case 0x27:
					out += "\\'"
				case 0x5C:
					out += "\\\\"
				default:
					if x < byte(0x20) || x >= byte(0x7F) {
						out += "\\" + "%03o".format(int(x))
					} else {
						out += string([x])
					}
			}
		}
		return out
	}

	// The Edition enum value of an edition name.
	def editionNumber(edition string) int {
		match edition {
			case "2023":
				return 1000
			case "2024":
				return 1001
			case "proto2":
				return 998
			case "proto3":
				return 999
			default:
				return 0
		}
	}

	// FileDescriptorProto.
	def encodeFile(f ProtoFile) byte[] {
		let w = new ProtoWriter()
		w.write(1, f.name)
		w.write(2, f.package) when f.package != ""
		for let dep in f.imports {
			w.write(3, dep)
		}
		for let m in f.messages {
			w.write(4, encodeMessage(m))
		}
		for let e in f.enums {
			w.write(5, encodeEnum(e))
		}
		for let s in f.services {
			w.write(6, encodeService(s))
		}
		for let x in f.extensions {
			w.write(7, encodeField(x))
		}
		w.write(8, f.optionBytes) when f.optionBytes.len() > 0
		for let i in f.publicImports {
			w.write(10, int32(i))
		}
		for let i in f.weakImports {
			w.write(11, int32(i))
		}
		w.write(12, f.syntax) when f.syntax != "proto2"
		w.write(14, editionNumber(f.edition)) when f.syntax == "editions"
		return w.bytes()
	}

	// DescriptorProto.
	def encodeMessage(m ProtoMessageDef) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, m.name)
		for let fd in m.fields {
			w.write(2, encodeField(fd))
		}
		for let n in m.messages {
			w.write(3, encodeMessage(n))
		}
		for let e in m.enums {
			w.write(4, encodeEnum(e))
		}
		for let r in m.extensionRanges {
			let rw = new ProtoWriter()
			rw.write(1, int32(r.start))
			rw.write(2, int32(r.end + 1))
			rw.write(3, r.optionBytes) when r.optionBytes.len() > 0
			w.write(5, rw)
		}
		for let x in m.extensions {
			w.write(6, encodeField(x))
		}
		w.write(7, m.optionBytes) when m.optionBytes.len() > 0
		for let o in m.oneofs {
			let ow = new ProtoWriter()
			ow.write(1, o.name)
			ow.write(2, o.optionBytes) when o.optionBytes.len() > 0
			w.write(8, ow)
		}
		for let r in m.reservedRanges {
			let rw = new ProtoWriter()
			rw.write(1, int32(r.start))
			rw.write(2, int32(r.end + 1))
			w.write(9, rw)
		}
		for let name in m.reservedNames {
			w.write(10, name)
		}
		return w
	}

	// FieldDescriptorProto.
	def encodeField(fd ProtoFieldDef) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, fd.name)
		w.write(2, fd.extendee) when fd.extendee != ""
		w.write(3, int32(fd.number))
		w.write(4, int32(fd.label.value))
		w.write(5, int32(fd.fieldType.value))
		w.write(6, fd.typeName) when fd.fieldType := ProtoType.Message || ProtoType.Enum || ProtoType.Group
		w.write(7, fd.defaultValue) when fd.hasDefault
		w.write(8, fd.optionBytes) when fd.optionBytes.len() > 0
		w.write(9, int32(fd.oneofIndex)) when fd.oneofIndex >= 0
		w.write(10, fd.hasJsonName ?? (fd.jsonName, jsonNameOf(fd.name)))
		w.write(17, true) when fd.proto3Optional
		return w
	}

	// EnumDescriptorProto.
	def encodeEnum(e ProtoEnumDef) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, e.name)
		for let v in e.values {
			let vw = new ProtoWriter()
			vw.write(1, v.name)
			vw.write(2, int32(v.number))
			vw.write(3, v.optionBytes) when v.optionBytes.len() > 0
			w.write(2, vw)
		}
		w.write(3, e.optionBytes) when e.optionBytes.len() > 0
		for let r in e.reservedRanges {
			let rw = new ProtoWriter()
			rw.write(1, int32(r.start))
			rw.write(2, int32(r.end))
			w.write(4, rw)
		}
		for let name in e.reservedNames {
			w.write(5, name)
		}
		return w
	}

	// ServiceDescriptorProto.
	def encodeService(s ProtoServiceDef) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, s.name)
		for let m in s.methods {
			let mw = new ProtoWriter()
			mw.write(1, m.name)
			mw.write(2, m.inputType)
			mw.write(3, m.outputType)
			mw.write(4, m.optionBytes) when m.optionBytes.len() > 0
			mw.write(5, true) when m.clientStreaming
			mw.write(6, true) when m.serverStreaming
			w.write(2, mw)
		}
		w.write(3, s.optionBytes) when s.optionBytes.len() > 0
		return w
	}
}
