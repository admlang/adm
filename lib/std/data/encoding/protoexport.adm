// ProtoSchema.add: ADM types written out as .proto messages and enums.
internal partial module std.data.encoding.protoschema {
	use (
		std.reflection
		std.reflection::(Field, FieldKind, TypeDescriptor, EnumMember)
		std.data.encoding::*
		std.data.encoding.json::(fieldFlag)
	)

	// The annotation the codec reads field numbers and encodings from.
	const protoFieldAttr = "std.data.encoding.protoField"

	// Collects messages and enums exported from ADM types, in the order they
	// were added, and renders them as one proto3 file.
	type Exporter {
		package      string
		imports      string[]
		messageNames string[]
		messageTypes string[]
		messageTexts string[]
		enumNames    string[]
		enumTypes    string[]
		enumTexts    string[]

		def new(package string) {
			self.package = package
		}

		// The file the exported definitions go in.
		def fileName() string {
			return package == "" ?? ("schema.proto", package.replace(".", "/") + ".proto")
		}

		// The full name of an exported definition.
		def qualified(name string) string {
			return package == "" ?? (name, package + "." + name)
		}

		def text() string {
			let out = "syntax = \"proto3\";\n"
			out += "\npackage {package};\n" when package != ""
			if imports.len() > 0 {
				out += "\n"
				for let dep in imports {
					out += "import \"{dep}\";\n"
				}
			}
			for let t in messageTexts {
				out += "\n" + t
			}
			for let t in enumTexts {
				out += "\n" + t
			}
			return out
		}

		def addImport(name string) {
			imports.push(name) when imports.indexOf(name) < 0
		}

		// Exports the message for a value's type and everything its fields
		// use; returns the message name. A type already exported is not
		// walked again.
		def addMessage(value any) !string {
			let typeName = reflection.typeName(value)
			let name = lastPart(typeName)
			let at = messageNames.indexOf(name)
			if at >= 0 {
				fail "protobuf: {typeName} and {messageTypes[at]} would both be message {name}" when messageTypes[at] != typeName
				return name
			}
			fail "protobuf: {typeName} would clash with enum {name}" when enumNames.indexOf(name) >= 0
			// Reserve the slot first: a message may refer to itself.
			let slot = messageNames.len()
			messageNames.push(name)
			messageTypes.push(typeName)
			messageTexts.push("")
			let lines string[] = []
			let oneofNames string[] = []
			let oneofLines string[][] = []
			for let (i, f) in reflection.fields(value) {
				continue when fieldFlag(f, protoFieldAttr, "ignore") || fieldFlag(f, protoFieldAttr, "unknown")
				let given = f.attr(protoFieldAttr, "field")
				let number = given == "" ?? (i + 1, parseInt<int>(given))
				let line = try fieldLine(f, number)
				let group = f.attr(protoFieldAttr, "oneof")
				if group != "" {
					fail "protobuf: oneof member {typeName}.{f.name} must be optional (?T)" unless f.kind == FieldKind.Optional
					let k = oneofNames.indexOf(group)
					if k < 0 {
						oneofNames.push(group)
						oneofLines.push([])
						k = oneofNames.len() - 1
					}
					oneofLines[k].push(line.trimPrefix("optional "))
					continue
				}
				lines.push(line)
			}
			let out = "message {name} \{\n"
			for let line in lines {
				out += "  {line}\n"
			}
			for let (k, group) in oneofNames {
				out += "  oneof {snakeName(group)} \{\n"
				for let line in oneofLines[k] {
					out += "    {line}\n"
				}
				out += "  \}\n"
			}
			messageTexts[slot] = out + "\}\n"
			return name
		}

		// One field declaration, without indentation.
		def fieldLine(f Field, number int) !string {
			let name = snakeName(f.name)
			let enc = f.attr(protoFieldAttr, "encoding")
			match f.kind {
				case FieldKind.Optional:
					let inner = f.typeName.trimPrefix("?")
					fail "protobuf: {f.name}: optional arrays and maps have no proto3 form" when inner.endsWith("[]") || inner.startsWith("map<")
					return "optional {try typeText(f, f.elemKind, inner, f.elemDescriptor, enc)} {name} = {number};"
				case FieldKind.Array:
					return "bytes {name} = {number};" when f.typeName := "byte[]" || "uint8[]"
					let elem = f.typeName.trimSuffix("[]")
					fail "protobuf: {f.name}: arrays of arrays have no proto3 form" when elem.endsWith("[]")
					let packed = f.attr(protoFieldAttr, "packed") == "false" ?? (" [packed = false]", "")
					return "repeated {try typeText(f, f.elemKind, elem, f.elemDescriptor, enc)} {name} = {number}{packed};"
				case FieldKind.Map:
					fail "protobuf: {f.name}: only map<string, V> can be exported" unless f.typeName.startsWith("map<string, ")
					let valueType = f.typeName.slice(12, f.typeName.len() - 13)
					fail "protobuf: {f.name}: map values cannot be arrays or maps" when valueType.endsWith("[]") || valueType.startsWith("map<")
					return "map<string, {try typeText(f, f.elemKind, valueType, f.elemDescriptor, enc)}> {name} = {number};"
				default:
					return "{try typeText(f, f.kind, f.typeName, f.descriptor, enc)} {name} = {number};"
			}
		}

		// The proto type of one value: a scalar, an exported enum or message,
		// or a well-known type.
		def typeText(f Field, kind FieldKind, typeName string, descriptor ?TypeDescriptor, enc string) !string {
			if typeName == "duration" {
				addImport("google/protobuf/duration.proto")
				return "google.protobuf.Duration"
			}
			if typeName == "std.time.Time" {
				addImport("google/protobuf/timestamp.proto")
				return "google.protobuf.Timestamp"
			}
			match kind {
				case FieldKind.String:
					return "string"
				case FieldKind.Bool:
					return "bool"
				case FieldKind.Float:
					return typeName == "float32" ?? ("float", "double")
				case FieldKind.Int:
					let narrow = typeName := "int32" || "int16" || "int8"
					match enc {
						case "ZigZag":
							return narrow ?? ("sint32", "sint64")
						case "Fixed":
							return narrow ?? ("sfixed32", "sfixed64")
						default:
							return narrow ?? ("int32", "int64")
					}
				case FieldKind.Uint:
					let narrow = typeName := "uint32" || "uint16" || "uint8"
					return narrow ?? ("fixed32", "fixed64") when enc == "Fixed"
					return narrow ?? ("uint32", "uint64")
				case FieldKind.Enum:
					fail "protobuf: {f.name}: no descriptor for enum {typeName}" when descriptor is none
					return try addEnum(descriptor, typeName)
				case FieldKind.Struct:
					fail "protobuf: {f.name}: no descriptor for {typeName}" when descriptor is none
					let zero = reflection.instantiate(descriptor)
					fail "protobuf: {f.name}: cannot make a {typeName} to walk" when zero is none
					return try addMessage(zero)
				default:
					fail "protobuf: {f.name}: a {typeName} has no Protocol Buffers form"
			}
		}

		// Exports an enum: values named ENUM_MEMBER in UPPER_SNAKE_CASE,
		// numbered by member value. Returns the enum name.
		def addEnum(descriptor TypeDescriptor, typeName string) !string {
			let name = lastPart(typeName)
			let at = enumNames.indexOf(name)
			if at >= 0 {
				fail "protobuf: {typeName} and {enumTypes[at]} would both be enum {name}" when enumTypes[at] != typeName
				return name
			}
			fail "protobuf: {typeName} would clash with message {name}" when messageNames.indexOf(name) >= 0
			let members = reflection.members(descriptor)
			fail "protobuf: enum {typeName} has no members" when members.len() == 0
			let prefix = upperSnake(name)
			let out = "enum {name} \{\n"
			for let (i, mem) in members {
				let number = enumNumber(mem, i)
				fail "protobuf: the first member of {typeName} must have value 0 (proto3), not {number}" when i == 0 && number != 0
				out += "  {prefix}_{upperSnake(mem.node.name)} = {number};\n"
			}
			enumNames.push(name)
			enumTypes.push(typeName)
			enumTexts.push(out + "\}\n")
			return name
		}
	}

	// The number a member encodes as: its integer value, or its position for
	// a string-valued enum.
	def enumNumber(mem EnumMember, index int) int {
		let text = reflection.scalarText(mem.value)
		return index when text == "" || !isIntegerText(text)
		return parseInt<int>(text)
	}

	def isIntegerText(text string) bool {
		let digits = text.trimPrefix("-")
		return false when digits == ""
		for let c in digits {
			return false when c < '0' || c > '9'
		}
		return true
	}

	// camelCase as snake_case: `userId` → `user_id`, `HTTPServer` →
	// `http_server`.
	def snakeName(name string) string {
		let chars char[] = []
		for let c in name {
			chars.push(c)
		}
		let out = ""
		for let (i, c) in chars {
			let upper = c >= 'A' && c <= 'Z'
			if upper && i > 0 {
				let prev = chars[i - 1]
				let prevLower = (prev >= 'a' && prev <= 'z') || (prev >= '0' && prev <= '9')
				let nextLower = i + 1 < chars.len() && chars[i + 1] >= 'a' && chars[i + 1] <= 'z'
				let prevUpper = prev >= 'A' && prev <= 'Z'
				out += "_" when prevLower || (prevUpper && nextLower)
			}
			out += upper ?? (string(c).lower(), string(c))
		}
		return out
	}

	def upperSnake(name string) string {
		return snakeName(name).upper()
	}
}
