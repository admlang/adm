internal partial module std.data.encoding.protoschema {
	use (
		std.os
		std.data.encoding::*
	)

	// The largest field number.
	const maxFieldNumber = 536870911

	// Parses .proto source: one token of look-ahead over a Lexer.
	type Parser {
		lx   Lexer
		tok  Tok
		file ProtoFile

		def new(name string, text string) {
			self.lx = new Lexer(name, text)
			self.file = new ProtoFile()
			self.file.name = name
		}

		def raise(message string) !none {
			fail "{lx.file}:{tok.line}:{tok.col}: {message}"
		}

		// The position of the current token, as a message prefix.
		def here() string {
			return "{lx.file}:{tok.line}:{tok.col}: "
		}

		def advance() !none {
			tok = try lx.next()
			return none
		}

		def isSym(s string) bool {
			return tok.kind == TokKind.Symbol && tok.text == s
		}

		def isWord(w string) bool {
			return tok.kind == TokKind.Ident && tok.text == w
		}

		def expectSym(s string) !none {
			try raise("expected \"{s}\", found {describeTok(tok)}") unless isSym(s)
			return try advance()
		}

		def acceptSym(s string) !bool {
			return false unless isSym(s)
			try advance()
			return true
		}

		def ident() !string {
			try raise("expected a name, found {describeTok(tok)}") unless tok.kind == TokKind.Ident
			let name = tok.text
			try advance()
			return name
		}

		// ident { "." ident }
		def fullIdent() !string {
			let out = try ident()
			for isSym(".") {
				try advance()
				out += "." + (try ident())
			}
			return out
		}

		// [ "." ] fullIdent
		def typeRef() !string {
			let lead = ""
			if isSym(".") {
				try advance()
				lead = "."
			}
			return lead + (try fullIdent())
		}

		def stringLit() !byte[] {
			try raise("expected a string, found {describeTok(tok)}") unless tok.kind == TokKind.String
			let out = tok.bytes
			try advance()
			// Adjacent strings join.
			for tok.kind == TokKind.String {
				out = out + tok.bytes
				try advance()
			}
			return out
		}

		// An integer, optionally signed: decimal, hex or octal.
		def intLit() !bigint {
			let neg = false
			if isSym("-") || isSym("+") {
				neg = isSym("-")
				try advance()
			}
			try raise("expected an integer, found {describeTok(tok)}") unless tok.kind == TokKind.Int
			let v = try parseIntText(tok.text)
			try advance()
			return neg ?? (-v, v)
		}

		def parse() !ProtoFile {
			try advance()
			let first = true
			for tok.kind != TokKind.End {
				if try acceptSym(";") {
					continue
				}
				if isWord("syntax") || isWord("edition") {
					try raise("syntax must be the first statement") unless first
					let isEdition = isWord("edition")
					try advance()
					try expectSym("=")
					let value = string(try stringLit())
					try expectSym(";")
					if isEdition {
						file.syntax = "editions"
						file.edition = value
					} else {
						try raise("unknown syntax \"{value}\"") unless value := "proto2" || "proto3"
						file.syntax = value
					}
					first = false
					continue
				}
				first = false
				if isWord("package") {
					try raise("more than one package statement") unless file.package == ""
					try advance()
					file.package = try fullIdent()
					try expectSym(";")
				} else if isWord("import") {
					try advance()
					let kind = ""
					if isWord("public") || isWord("weak") {
						kind = tok.text
						try advance()
					}
					let path = string(try stringLit())
					try expectSym(";")
					file.publicImports.push(file.imports.len()) when kind == "public"
					file.weakImports.push(file.imports.len()) when kind == "weak"
					file.imports.push(path)
				} else if isWord("option") {
					file.options.push(try option())
					try expectSym(";")
				} else if isWord("message") {
					file.messages.push(try message(file.package))
				} else if isWord("enum") {
					file.enums.push(try enumDef(file.package))
				} else if isWord("service") {
					file.services.push(try serviceDef())
				} else if isWord("extend") {
					try extend(file.extensions, file.messages, file.package)
				} else {
					try raise("expected a top-level statement, found {describeTok(tok)}")
				}
			}
			return file
		}

		// option name = constant (after "option").
		def option() !ProtoOption {
			try advance() when isWord("option")
			let name = try optionName()
			try expectSym("=")
			let value = try constant()
			return ProtoOption{name: name, value: value}
		}

		// ( ident | "(" ["."] fullIdent ")" ) { "." ( ident | "(" fullIdent ")" ) }
		def optionName() !string {
			let out = try optionNamePart()
			for isSym(".") {
				try advance()
				out += "." + (try optionNamePart())
			}
			return out
		}

		def optionNamePart() !string {
			if try acceptSym("(") {
				let inner = try typeRef()
				try expectSym(")")
				return "(" + inner + ")"
			}
			return try ident()
		}

		// [ options ] after a field or value: "[" opt { "," opt } "]".
		def fieldOptions() !ProtoOption[] {
			let out ProtoOption[] = []
			return out unless try acceptSym("[")
			for {
				let name = try optionName()
				try expectSym("=")
				out.push(ProtoOption{name: name, value: try constant()})
				break unless try acceptSym(",")
			}
			try expectSym("]")
			return out
		}

		// fullIdent | [-+] intLit | [-+] floatLit | strLit | boolLit | "\{" text format "\}"
		def constant() !ProtoValue {
			let v = new ProtoValue()
			return try textMessage("\}") when isSym("\{")
			if tok.kind == TokKind.String {
				v.kind = ProtoValueKind.String
				v.bytes = try stringLit()
				return v
			}
			let sign = ""
			if isSym("-") || isSym("+") {
				sign = tok.text
				try advance()
			}
			match tok.kind {
				case TokKind.Int:
					v.kind = ProtoValueKind.Int
				case TokKind.Float:
					v.kind = ProtoValueKind.Float
				case TokKind.Ident:
					if sign != "" {
						try raise("expected a number after \"{sign}\", found {tok.text}") unless tok.text := "inf" || "nan"
						v.kind = ProtoValueKind.Float
					} else {
						v.kind = (tok.text := "true" || "false") ?? (ProtoValueKind.Bool, ProtoValueKind.Identifier)
					}
				default:
					try raise("expected a constant, found {describeTok(tok)}")
			}
			if tok.kind == TokKind.Ident && sign == "" {
				v.text = try fullIdent()
				return v
			}
			v.text = sign + tok.text
			try advance()
			return v
		}

		// A text-format message after its opening brace, up to close.
		def textMessage(close string) !ProtoValue {
			try advance()
			let v = new ProtoValue()
			v.kind = ProtoValueKind.Message
			for !isSym(close) {
				try raise("unterminated message value") when tok.kind == TokKind.End
				let name = ""
				if try acceptSym("[") {
					let inner = try typeRef()
					// A type URL: domain/path/Type.
					for isSym("/") {
						try advance()
						inner += "/" + (try typeRef())
					}
					try expectSym("]")
					name = "[" + inner + "]"
				} else {
					name = try ident()
				}
				let colon = try acceptSym(":")
				if isSym("\{") || isSym("<") {
					v.names.push(name)
					v.values.push(try textMessage(isSym("\{") ?? ("\}", ">")))
				} else {
					try raise("expected \":\" after {name}") unless colon
					v.names.push(name)
					v.values.push(try textValue())
				}
				try acceptSym(",") unless try acceptSym(";")
			}
			try advance()
			return v
		}

		def textValue() !ProtoValue {
			if isSym("[") {
				try advance()
				let list = new ProtoValue()
				list.kind = ProtoValueKind.List
				for !isSym("]") {
					if isSym("\{") || isSym("<") {
						list.items.push(try textMessage(isSym("\{") ?? ("\}", ">")))
					} else {
						list.items.push(try textValue())
					}
					break unless try acceptSym(",")
				}
				try expectSym("]")
				return list
			}
			return try constant()
		}

		// message Name { body }
		def message(scope string) !ProtoMessageDef {
			let line = tok.line
			try advance()
			let m = new ProtoMessageDef()
			m.line = line
			m.name = try ident()
			m.fullName = qualify(scope, m.name)
			try expectSym("\{")
			try messageBody(m)
			return m
		}

		// The statements of a message up to and including its closing brace.
		def messageBody(m ProtoMessageDef) !none {
			for !isSym("\}") {
				try raise("unterminated message {m.name}") when tok.kind == TokKind.End
				if try acceptSym(";") {
					continue
				}
				if isWord("option") {
					m.options.push(try option())
					try expectSym(";")
				} else if isWord("message") {
					m.messages.push(try message(m.fullName))
				} else if isWord("enum") {
					m.enums.push(try enumDef(m.fullName))
				} else if isWord("extend") {
					try extend(m.extensions, m.messages, m.fullName)
				} else if isWord("extensions") {
					try advance()
					let ranges = try rangeList(maxFieldNumber)
					let opts = try fieldOptions()
					for let r in ranges {
						m.extensionRanges.push(ProtoRange{start: r.start, end: r.end, options: opts})
					}
					try expectSym(";")
				} else if isWord("reserved") {
					try advance()
					try reserved(m.reservedRanges, m.reservedNames, maxFieldNumber)
				} else if isWord("oneof") {
					try oneof(m)
				} else if isWord("map") {
					m.fields.push(try mapField(m))
				} else {
					m.fields.push(try field(m.messages, m.fullName, true))
				}
			}
			try advance()
			return none
		}

		// [label] type name = number [options] ;  or  [label] group Name = number { body }
		def field(nested ProtoMessageDef[], scope string, allowLabel bool) !ProtoFieldDef {
			let f = new ProtoFieldDef()
			f.line = tok.line
			if allowLabel && (isWord("optional") || isWord("required") || isWord("repeated")) {
				f.labeled = true
				match tok.text {
					case "required":
						f.label = ProtoLabel.Required
					case "repeated":
						f.label = ProtoLabel.Repeated
					default:
						f.label = ProtoLabel.Optional
				}
				try advance()
			}
			if isWord("group") {
				try advance()
				let line = tok.line
				let groupName = try ident()
				try expectSym("=")
				f.number = try fieldNumber()
				f.options = try fieldOptions()
				try takeSpecialOptions(f)
				let g = new ProtoMessageDef()
				g.line = line
				g.name = groupName
				g.fullName = qualify(scope, groupName)
				try expectSym("\{")
				try messageBody(g)
				nested.push(g)
				f.name = groupName.lower()
				f.fieldType = ProtoType.Group
				f.typeName = groupName
				return f
			}
			let typeText = try typeRef()
			let scalar = scalarType(typeText)
			if scalar is none {
				f.typeName = typeText
			} else {
				f.fieldType = scalar
			}
			f.name = try ident()
			try expectSym("=")
			f.number = try fieldNumber()
			f.options = try fieldOptions()
			try takeSpecialOptions(f)
			try expectSym(";")
			return f
		}

		def fieldNumber() !int {
			let n = try intLit()
			try raise("field number {n} is outside 1 to {maxFieldNumber}") when n < bigint(1) || n > bigint(maxFieldNumber)
			return int(n)
		}

		// Moves `default` and `json_name` out of the option list into their
		// own descriptor fields, as protoc does.
		def takeSpecialOptions(f ProtoFieldDef) !none {
			let rest ProtoOption[] = []
			for let o in f.options {
				if o.name == "default" {
					f.hasDefault = true
					f.defaultRaw = o.value
					f.defaultValue = defaultText(o.value)
				} else if o.name == "json_name" {
					try raise("json_name must be a string") unless o.value.kind == ProtoValueKind.String
					f.hasJsonName = true
					f.jsonName = string(o.value.bytes)
				} else {
					rest.push(o)
				}
			}
			f.options = rest
			return none
		}

		// map<Key, Value> name = number [options] ;
		def mapField(m ProtoMessageDef) !ProtoFieldDef {
			let line = tok.line
			try advance()
			try expectSym("<")
			let keyText = try typeRef()
			let key = scalarType(keyText)
			fail "{here()}map key type {keyText} is not an integer, bool or string type" when key is none
			fail "{here()}map key type {keyText} is not an integer, bool or string type" when (key := ProtoType.Double || ProtoType.Float || ProtoType.Bytes)
			try expectSym(",")
			let valueText = try typeRef()
			try expectSym(">")
			let f = new ProtoFieldDef()
			f.line = line
			f.isMap = true
			f.name = try ident()
			try expectSym("=")
			f.number = try fieldNumber()
			f.options = try fieldOptions()
			try takeSpecialOptions(f)
			try expectSym(";")
			let entry = new ProtoMessageDef()
			entry.line = line
			entry.name = camelName(f.name) + "Entry"
			entry.fullName = qualify(m.fullName, entry.name)
			entry.mapEntry = true
			let k = new ProtoFieldDef()
			k.name = "key"
			k.number = 1
			k.fieldType = key
			let v = new ProtoFieldDef()
			v.name = "value"
			v.number = 2
			let valueScalar = scalarType(valueText)
			if valueScalar is none {
				v.typeName = valueText
			} else {
				v.fieldType = valueScalar
			}
			entry.fields.push(k)
			entry.fields.push(v)
			let on = new ProtoValue()
			on.kind = ProtoValueKind.Bool
			on.text = "true"
			entry.options.push(ProtoOption{name: "map_entry", value: on})
			m.messages.push(entry)
			f.label = ProtoLabel.Repeated
			f.labeled = true
			f.fieldType = ProtoType.Message
			f.typeName = entry.name
			return f
		}

		// oneof name { option | field | group }
		def oneof(m ProtoMessageDef) !none {
			try advance()
			let o = ProtoOneofDef{name: try ident()}
			let index = m.oneofs.len()
			m.oneofs.push(o)
			try expectSym("\{")
			for !isSym("\}") {
				try raise("unterminated oneof {o.name}") when tok.kind == TokKind.End
				if try acceptSym(";") {
					continue
				}
				if isWord("option") {
					m.oneofs[index].options.push(try option())
					try expectSym(";")
					continue
				}
				let f = try field(m.messages, m.fullName, false)
				f.oneofIndex = index
				m.fields.push(f)
			}
			try advance()
			return none
		}

		// extend Type { fields }
		def extend(into ProtoFieldDef[], nested ProtoMessageDef[], scope string) !none {
			try advance()
			let target = try typeRef()
			try expectSym("\{")
			for !isSym("\}") {
				try raise("unterminated extend {target}") when tok.kind == TokKind.End
				if try acceptSym(";") {
					continue
				}
				let f = try field(nested, scope, true)
				f.extendee = target
				f.fullName = qualify(scope, f.name)
				into.push(f)
			}
			try advance()
			return none
		}

		// ranges ( "," ranges )* ";"  or  names ; for reserved.
		def reserved(ranges ProtoRange[], names string[], max int) !none {
			if tok.kind == TokKind.String || tok.kind == TokKind.Ident {
				for {
					if tok.kind == TokKind.String {
						names.push(string(try stringLit()))
					} else {
						names.push(try ident())
					}
					break unless try acceptSym(",")
				}
			} else {
				for let r in try rangeList(max) {
					ranges.push(r)
				}
			}
			try expectSym(";")
			return none
		}

		def rangeList(max int) !ProtoRange[] {
			let out ProtoRange[] = []
			for {
				let start = try intLit()
				let end = start
				if isWord("to") {
					try advance()
					if isWord("max") {
						try advance()
						end = bigint(max)
					} else {
						end = try intLit()
					}
				}
				try raise("range {start} to {end} is empty") when end < start
				out.push(ProtoRange{start: int(start), end: int(end)})
				break unless try acceptSym(",")
			}
			return out
		}

		// enum Name { values }
		def enumDef(scope string) !ProtoEnumDef {
			let line = tok.line
			try advance()
			let e = new ProtoEnumDef()
			e.line = line
			e.name = try ident()
			e.fullName = qualify(scope, e.name)
			try expectSym("\{")
			for !isSym("\}") {
				try raise("unterminated enum {e.name}") when tok.kind == TokKind.End
				if try acceptSym(";") {
					continue
				}
				if isWord("option") {
					e.options.push(try option())
					try expectSym(";")
				} else if isWord("reserved") {
					try advance()
					try reserved(e.reservedRanges, e.reservedNames, 2147483647)
				} else {
					let name = try ident()
					try expectSym("=")
					let n = try intLit()
					try raise("enum value {n} is outside the int32 range") when n < -(bigint(1) << 31) || n >= bigint(1) << 31
					let opts = try fieldOptions()
					try expectSym(";")
					e.values.push(ProtoEnumValueDef{name: name, number: int(n), options: opts})
				}
			}
			try advance()
			return e
		}

		// service Name { rpc ... }
		def serviceDef() !ProtoServiceDef {
			let line = tok.line
			try advance()
			let s = new ProtoServiceDef()
			s.line = line
			s.name = try ident()
			s.fullName = qualify(file.package, s.name)
			try expectSym("\{")
			for !isSym("\}") {
				try raise("unterminated service {s.name}") when tok.kind == TokKind.End
				if try acceptSym(";") {
					continue
				}
				if isWord("option") {
					s.options.push(try option())
					try expectSym(";")
					continue
				}
				try raise("expected rpc, found {describeTok(tok)}") unless isWord("rpc")
				let m = new ProtoMethodDef()
				m.line = tok.line
				try advance()
				m.name = try ident()
				try expectSym("(")
				if isWord("stream") {
					try advance()
					m.clientStreaming = true
				}
				m.inputType = try typeRef()
				try expectSym(")")
				try raise("expected returns, found {describeTok(tok)}") unless isWord("returns")
				try advance()
				try expectSym("(")
				if isWord("stream") {
					try advance()
					m.serverStreaming = true
				}
				m.outputType = try typeRef()
				try expectSym(")")
				if try acceptSym("\{") {
					for !isSym("\}") {
						try raise("unterminated rpc {m.name}") when tok.kind == TokKind.End
						if try acceptSym(";") {
							continue
						}
						m.options.push(try option())
						try expectSym(";")
					}
					try advance()
				} else {
					try expectSym(";")
				}
				s.methods.push(m)
			}
			try advance()
			return s
		}
	}

	def describeTok(t Tok) string {
		match t.kind {
			case TokKind.End:
				return "the end of the file"
			case TokKind.String:
				return "a string"
			default:
				return "\"{t.text}\""
		}
	}

	def qualify(scope string, name string) string {
		return scope == "" ?? (name, scope + "." + name)
	}

	// The type a scalar type name stands for; none for a message or enum
	// name.
	def scalarType(name string) ?ProtoType {
		match name {
			case "double":
				return ProtoType.Double
			case "float":
				return ProtoType.Float
			case "int64":
				return ProtoType.Int64
			case "uint64":
				return ProtoType.Uint64
			case "int32":
				return ProtoType.Int32
			case "fixed64":
				return ProtoType.Fixed64
			case "fixed32":
				return ProtoType.Fixed32
			case "bool":
				return ProtoType.Bool
			case "string":
				return ProtoType.String
			case "bytes":
				return ProtoType.Bytes
			case "uint32":
				return ProtoType.Uint32
			case "sfixed32":
				return ProtoType.Sfixed32
			case "sfixed64":
				return ProtoType.Sfixed64
			case "sint32":
				return ProtoType.Sint32
			case "sint64":
				return ProtoType.Sint64
			default:
				return none
		}
	}

	// The name protoc gives a map field's entry message: `my_field` →
	// `MyField`.
	def camelName(name string) string {
		let out = ""
		let upper = true
		for let c in name {
			if c == '_' {
				upper = true
				continue
			}
			out += upper ?? (string(c).upper(), string(c))
			upper = false
		}
		return out
	}

	// A decimal, hex (0x) or octal (leading 0) integer literal.
	def parseIntText(text string) !bigint {
		return try parseBigInt(text.slice(2), 16) when text.startsWith("0x") || text.startsWith("0X")
		return try parseBigInt(text.slice(1), 8) when text.len() > 1 && text.startsWith("0")
		return try parseBigInt(text)
	}

	// The default_value text protoc records for a default option: strings
	// unescaped, numbers in decimal, identifiers as written.
	def defaultText(v ProtoValue) string {
		match v.kind {
			case ProtoValueKind.String:
				return string(v.bytes)
			case ProtoValueKind.Int:
				let neg = v.text.startsWith("-")
				let digits = v.text.trimPrefix("-").trimPrefix("+")
				let n = parseIntText(digits) onerror recover bigint(0)
				return (neg ?? (-n, n)).toRadix(10)
			default:
				return v.text.trimPrefix("+")
		}
	}

	// The last dot-separated part of a name.
	def lastPart(name string) string {
		let parts = name.split(".")
		return parts[parts.len() - 1]
	}

	// A constant in .proto syntax.
	def protoValueText(v ProtoValue) string {
		match v.kind {
			case ProtoValueKind.String:
				return quoteProto(v.bytes)
			case ProtoValueKind.Message:
				let out = "\{"
				for let (i, name) in v.names {
					let value = v.values[i]
					if value.kind == ProtoValueKind.Message {
						out += " {name} " + protoValueText(value)
					} else {
						out += " {name}: " + protoValueText(value)
					}
				}
				return out + " \}"
			case ProtoValueKind.List:
				let parts string[] = []
				for let item in v.items {
					parts.push(protoValueText(item))
				}
				return "[" + parts.join(", ") + "]"
			default:
				return v.text
		}
	}

	// A string literal: printable ASCII as it is, the rest escaped.
	def quoteProto(b byte[]) string {
		let out byte[] = [byte(0x22)]
		for let x in b {
			match int(x) {
				case 0x0A:
					out = out + "\\n".bytes()
				case 0x0D:
					out = out + "\\r".bytes()
				case 0x09:
					out = out + "\\t".bytes()
				case 0x22:
					out = out + "\\\"".bytes()
				case 0x27:
					out = out + "\\'".bytes()
				case 0x5C:
					out = out + "\\\\".bytes()
				default:
					if x < byte(0x20) || x == byte(0x7F) {
						out = out + ("\\x" + [x].hex().lower()).bytes()
					} else {
						out.push(x)
					}
			}
		}
		out.push(byte(0x22))
		return string(out)
	}

	def optionsText(opts ProtoOption[], indent string) string {
		let out = ""
		for let o in opts {
			out += "{indent}option {o.name} = {protoValueText(o.value)};\n"
		}
		return out
	}

	// The bracketed options of a field, `default` and `json_name` included.
	def fieldOptionsText(f ProtoFieldDef) string {
		let parts string[] = []
		if f.hasDefault {
			// A bytes default is stored C-escaped already, which is .proto string
			// syntax as it is.
			if f.fieldType == ProtoType.Bytes {
				parts.push("default = \"" + f.defaultValue + "\"")
			} else if f.fieldType == ProtoType.String {
				parts.push("default = " + quoteProto(f.defaultValue.bytes()))
			} else {
				parts.push("default = " + f.defaultValue)
			}
		}
		parts.push("json_name = " + quoteProto(f.jsonName.bytes())) when f.hasJsonName
		for let o in f.options {
			parts.push("{o.name} = {protoValueText(o.value)}")
		}
		return parts.len() == 0 ?? ("", " [" + parts.join(", ") + "]")
	}

	def typeText(f ProtoFieldDef) string {
		return f.typeName when f.fieldType := ProtoType.Message || ProtoType.Enum || ProtoType.Group
		return f.fieldType.name.lower()
	}

	def labelText(f ProtoFieldDef, syntax string, inOneof bool) string {
		return "" when inOneof
		return "repeated " when f.label == ProtoLabel.Repeated
		return "required " when f.label == ProtoLabel.Required
		return "optional " when syntax == "proto2"
		return f.labeled ?? ("optional ", "")
	}

	def rangesText(ranges ProtoRange[], max int) string {
		let parts string[] = []
		for let r in ranges {
			if r.start == r.end {
				parts.push(r.start.str())
			} else {
				parts.push("{r.start} to " + (r.end == max ?? ("max", r.end.str())))
			}
		}
		return parts.join(", ")
	}

	def fieldText(f ProtoFieldDef, m ?ProtoMessageDef, syntax string, indent string, inOneof bool) string {
		if f.isMap && !(m is none) {
			let entry = findMessage(m.messages, entryName(m, f))
			return "{indent}map<{typeText(entry.fields[0])}, {typeText(entry.fields[1])}> {f.name} = {f.number}{fieldOptionsText(f)};\n" when !(entry is none) && entry.fields.len() == 2
		}
		if f.fieldType == ProtoType.Group && !(m is none) {
			let group = findMessage(m.messages, qualify(m.fullName, lastPart(f.typeName)))
			return "{indent}{labelText(f, syntax, inOneof)}group {group.name} = {f.number}{fieldOptionsText(f)} \{\n" + messageBodyText(group, syntax, indent + "  ") + "{indent}\}\n" unless (group is none)
		}
		return "{indent}{labelText(f, syntax, inOneof)}{typeText(f)} {f.name} = {f.number}{fieldOptionsText(f)};\n"
	}

	def entryName(m ProtoMessageDef, f ProtoFieldDef) string {
		return qualify(m.fullName, lastPart(f.typeName))
	}

	def messageText(m ProtoMessageDef, syntax string, indent string) string {
		return "{indent}message {m.name} \{\n" + messageBodyText(m, syntax, indent + "  ") + "{indent}\}\n"
	}

	def messageBodyText(m ProtoMessageDef, syntax string, indent string) string {
		let out = optionsText(m.options, indent)
		let groupNames string[] = []
		for let f in m.fields {
			groupNames.push(lastPart(f.typeName)) when f.fieldType == ProtoType.Group || f.isMap
		}
		let doneOneofs int[] = []
		for let f in m.fields {
			let o = f.oneofIndex
			if o >= 0 && !f.proto3Optional {
				continue when doneOneofs.indexOf(o) >= 0
				doneOneofs.push(o)
				out += "{indent}oneof {m.oneofs[o].name} \{\n" + optionsText(m.oneofs[o].options, indent + "  ")
				for let g in m.fields {
					out += fieldText(g, m, syntax, indent + "  ", true) when g.oneofIndex == o
				}
				out += "{indent}\}\n"
				continue
			}
			out += fieldText(f, m, syntax, indent, false)
		}
		for let n in m.messages {
			continue when n.mapEntry || groupNames.indexOf(n.name) >= 0
			out += messageText(n, syntax, indent)
		}
		for let e in m.enums {
			out += enumText(e, indent)
		}
		out += extensionsText(m.extensions, syntax, indent)
		for let r in m.extensionRanges {
			let opts = r.options.len() == 0 ?? ("", " [" + optionListText(r.options) + "]")
			out += "{indent}extensions {rangesText([r], maxFieldNumber)}{opts};\n"
		}
		out += "{indent}reserved {rangesText(m.reservedRanges, maxFieldNumber)};\n" when m.reservedRanges.len() > 0
		out += "{indent}reserved {reservedNamesText(m.reservedNames, syntax)};\n" when m.reservedNames.len() > 0
		return out
	}

	def optionListText(opts ProtoOption[]) string {
		let parts string[] = []
		for let o in opts {
			parts.push("{o.name} = {protoValueText(o.value)}")
		}
		return parts.join(", ")
	}

	def reservedNamesText(names string[], syntax string) string {
		let parts string[] = []
		for let n in names {
			parts.push(syntax == "editions" ?? (n, quoteProto(n.bytes())))
		}
		return parts.join(", ")
	}

	def extensionsText(list ProtoFieldDef[], syntax string, indent string) string {
		let out = ""
		let done string[] = []
		for let f in list {
			continue when done.indexOf(f.extendee) >= 0
			done.push(f.extendee)
			out += "{indent}extend {f.extendee} \{\n"
			for let g in list {
				out += fieldText(g, none, syntax, indent + "  ", false) when g.extendee == f.extendee
			}
			out += "{indent}\}\n"
		}
		return out
	}

	def enumText(e ProtoEnumDef, indent string) string {
		let out = "{indent}enum {e.name} \{\n" + optionsText(e.options, indent + "  ")
		for let v in e.values {
			let opts = v.options.len() == 0 ?? ("", " [" + optionListText(v.options) + "]")
			out += "{indent}  {v.name} = {v.number}{opts};\n"
		}
		out += "{indent}  reserved {rangesText(e.reservedRanges, 2147483647)};\n" when e.reservedRanges.len() > 0
		out += "{indent}  reserved {reservedNamesText(e.reservedNames, "proto3")};\n" when e.reservedNames.len() > 0
		return out + "{indent}\}\n"
	}

	def serviceText(s ProtoServiceDef) string {
		let out = "service {s.name} \{\n" + optionsText(s.options, "  ")
		for let m in s.methods {
			let input = (m.clientStreaming ?? ("stream ", "")) + m.inputType
			let output = (m.serverStreaming ?? ("stream ", "")) + m.outputType
			if m.options.len() == 0 {
				out += "  rpc {m.name}({input}) returns ({output});\n"
			} else {
				out += "  rpc {m.name}({input}) returns ({output}) \{\n" + optionsText(m.options, "    ") + "  \}\n"
			}
		}
		return out + "\}\n"
	}

	def protoFileText(f ProtoFile) string {
		let parts string[] = []
		if f.syntax == "editions" {
			parts.push("edition = {quoteProto(f.edition.bytes())};\n")
		} else {
			parts.push("syntax = {quoteProto(f.syntax.bytes())};\n")
		}
		parts.push("package {f.package};\n") when f.package != ""
		if f.imports.len() > 0 {
			let block = ""
			for let (i, path) in f.imports {
				let kind = f.publicImports.indexOf(i) >= 0 ?? ("public ", f.weakImports.indexOf(i) >= 0 ?? ("weak ", ""))
				block += "import {kind}{quoteProto(path.bytes())};\n"
			}
			parts.push(block)
		}
		parts.push(optionsText(f.options, "")) when f.options.len() > 0
		for let m in f.messages {
			parts.push(messageText(m, f.syntax, ""))
		}
		for let e in f.enums {
			parts.push(enumText(e, ""))
		}
		for let s in f.services {
			parts.push(serviceText(s))
		}
		parts.push(extensionsText(f.extensions, f.syntax, "")) when f.extensions.len() > 0
		return parts.join("\n")
	}

	// Reads a .proto file from the first import path that has it.
	def readProtoFile(paths string[], name string) !string {
		let reasons string[] = []
		for let dir in paths {
			let path = (dir == "" || dir == ".") ?? (name, dir.trimSuffix("/") + "/" + name)
			let failed = false
			let data = os.readFile(path) onerror (err error) {
				failed = true
				reasons.push("{path}: {err.message}")
				recover byte[]
			}
			return string(data) unless failed
		}
		fail "{name}: not found in the import paths ({reasons.join("; ")})"
	}

	// The definitions a file can see: its own, its imports', and what those
	// import publicly; full names without the leading dot, mapped to their
	// kind ("package", "message", "enum", "service").
	def visibleSymbols(schema ProtoSchema, f ProtoFile) !map<string, string> {
		let table = map<string, string>{}
		try addFileSymbols(table, f, true)
		let seen string[] = []
		for let dep in f.imports {
			let d = schema.file(dep)
			fail "{f.name}: import \"{dep}\" was not found or had errors" when d is none
			try addImported(schema, table, d, seen)
		}
		return table
	}

	def addImported(schema ProtoSchema, table map<string, string>, f ProtoFile, seen string[]) !none {
		return none when seen.indexOf(f.name) >= 0
		seen.push(f.name)
		try addFileSymbols(table, f, false)
		for let i in f.publicImports {
			let d = schema.file(f.imports[i])
			try addImported(schema, table, d, seen) unless d is none
		}
		return none
	}

	def addFileSymbols(table map<string, string>, f ProtoFile, own bool) !none {
		if f.package != "" {
			let parts = f.package.split(".")
			let prefix = ""
			for let p in parts {
				prefix = prefix == "" ?? (p, prefix + "." + p)
				table[prefix] = "package" unless table.hasKey(prefix)
			}
		}
		for let m in f.messages {
			try addMessageSymbols(table, m, f.name, own)
		}
		for let e in f.enums {
			try addSymbol(table, e.fullName, "enum", f.name, e.line, own)
		}
		for let sv in f.services {
			try addSymbol(table, sv.fullName, "service", f.name, sv.line, own)
		}
		return none
	}

	def addMessageSymbols(table map<string, string>, m ProtoMessageDef, file string, own bool) !none {
		try addSymbol(table, m.fullName, "message", file, m.line, own)
		for let n in m.messages {
			try addMessageSymbols(table, n, file, own)
		}
		for let e in m.enums {
			try addSymbol(table, e.fullName, "enum", file, e.line, own)
		}
		return none
	}

	def addSymbol(table map<string, string>, name string, kind string, file string, line int, own bool) !none {
		if table.hasKey(name) {
			fail "{file}:{line}: \"{name}\" is already defined" when own
			return none
		}
		table[name] = kind
		return none
	}

	// The kind a symbol table records for a name; "" when absent.
	def kindOf(table map<string, string>, name string) string {
		return "" unless table.hasKey(name)
		return table[name]
	}

	// Resolves a type name used in scope the way protoc does: a leading dot
	// is absolute; otherwise the first part is looked up from the innermost
	// scope outwards, and the rest from where it was found.
	def resolveName(table map<string, string>, scope string, name string) ?string {
		return (table.hasKey(name.slice(1)) ?? (name.slice(1), "")) when name.startsWith(".")
		let first = name.split(".")[0]
		let s = scope
		for {
			let candidate = s == "" ?? (first, s + "." + first)
			if table.hasKey(candidate) {
				let full = s == "" ?? (name, s + "." + name)
				return full when table.hasKey(full) && table[full] != "package"
			}
			break when s == ""
			let parts = s.split(".")
			parts.len(parts.len() - 1)
			s = parts.join(".")
		}
		return none
	}

	// Resolves every type name in a file, synthesizes proto3 optional
	// oneofs, and checks what protoc checks.
	def resolveFile(schema ProtoSchema, f ProtoFile, types ProtoSchema) !none {
		let table = try visibleSymbols(schema, f)
		for let m in f.messages {
			try resolveMessage(table, f, m)
		}
		for let x in f.extensions {
			try resolveField(table, f, x, f.package, true)
		}
		for let e in f.enums {
			try checkEnum(f, e)
		}
		for let sv in f.services {
			for let md in sv.methods {
				let input = resolveName(table, f.package, md.inputType)
				fail "{f.name}:{md.line}: \"{md.inputType}\" is not defined" when input is none || input == ""
				fail "{f.name}:{md.line}: \"{md.inputType}\" is not a message type" unless kindOf(table, input) == "message"
				let output = resolveName(table, f.package, md.outputType)
				fail "{f.name}:{md.line}: \"{md.outputType}\" is not defined" when output is none || output == ""
				fail "{f.name}:{md.line}: \"{md.outputType}\" is not a message type" unless kindOf(table, output) == "message"
				md.inputType = "." + input
				md.outputType = "." + output
			}
		}
		// Extensions defined in this very file count for its own options;
		// when the file is descriptor.proto itself, its own messages are the
		// options types.
		let typesFor = types
		if f.name == "google/protobuf/descriptor.proto" || !(f.message("google.protobuf.FileOptions") is none) {
			let own = new ProtoSchema()
			for let have in schema.files {
				own.files.push(have)
			}
			own.files.push(f)
			typesFor = own
		} else if !(types.file("google/protobuf/descriptor.proto") is none) && schema.file("google/protobuf/descriptor.proto") is none {
			let both = new ProtoSchema()
			for let have in types.files {
				both.files.push(have)
			}
			for let have in schema.files {
				both.files.push(have)
			}
			both.files.push(f)
			typesFor = both
		} else {
			let own = new ProtoSchema()
			for let have in schema.files {
				own.files.push(have)
			}
			own.files.push(f)
			typesFor = own
		}
		let ctx = OptContext{types: typesFor, table: table, extensions: visibleExtensions(schema, f), file: f.name}
		try interpretFile(ctx, f)
		return none
	}

	def resolveField(table map<string, string>, f ProtoFile, fd ProtoFieldDef, scope string, extension bool) !none {
		if fd.typeName != "" {
			let full = resolveName(table, scope, fd.typeName)
			fail "{f.name}:{fd.line}: \"{fd.typeName}\" is not defined" when full is none || full == ""
			let kind = kindOf(table, full)
			fail "{f.name}:{fd.line}: \"{fd.typeName}\" is not a type" unless kind := "message" || "enum"
			fd.typeName = "." + full
			fd.fieldType = kind == "enum" ?? (ProtoType.Enum, ProtoType.Message) when fd.fieldType != ProtoType.Group
		}
		if fd.hasDefault {
			fd.defaultValue = formatDefault(fd) onerror (err error) {
				fail "{f.name}:{fd.line}: {err.message}"
			}
		}
		if extension {
			let target = resolveName(table, scope, fd.extendee)
			fail "{f.name}:{fd.line}: \"{fd.extendee}\" is not defined" when target is none || target == ""
			fail "{f.name}:{fd.line}: \"{fd.extendee}\" is not a message type" unless kindOf(table, target) == "message"
			fd.extendee = "." + target
		}
		fail "{f.name}:{fd.line}: field numbers 19000 to 19999 are reserved for the protocol buffer library implementation" when fd.number >= 19000 && fd.number <= 19999
		if f.syntax == "proto3" {
			fail "{f.name}:{fd.line}: required fields are not allowed in proto3" when fd.label == ProtoLabel.Required
			fail "{f.name}:{fd.line}: explicit default values are not allowed in proto3" when fd.hasDefault
			fail "{f.name}:{fd.line}: groups are not supported in proto3" when fd.fieldType == ProtoType.Group
		}
		if f.syntax == "editions" {
			fail "{f.name}:{fd.line}: labels other than repeated are not allowed in editions" when fd.labeled && fd.label != ProtoLabel.Repeated && !fd.isMap
		}
		return none
	}

	def resolveMessage(table map<string, string>, f ProtoFile, m ProtoMessageDef) !none {
		let numbers int[] = []
		let names string[] = []
		for let fd in m.fields {
			try resolveField(table, f, fd, m.fullName, false)
			fail "{f.name}:{fd.line}: field number {fd.number} is already used in {m.name}" when numbers.indexOf(fd.number) >= 0
			fail "{f.name}:{fd.line}: field \"{fd.name}\" is already defined in {m.name}" when names.indexOf(fd.name) >= 0
			numbers.push(fd.number)
			names.push(fd.name)
			for let r in m.reservedRanges {
				fail "{f.name}:{fd.line}: field {fd.name} uses reserved number {fd.number}" when fd.number >= r.start && fd.number <= r.end
			}
			fail "{f.name}:{fd.line}: field name \"{fd.name}\" is reserved" when m.reservedNames.indexOf(fd.name) >= 0
			for let r in m.extensionRanges {
				fail "{f.name}:{fd.line}: field {fd.name} uses number {fd.number} of an extension range" when fd.number >= r.start && fd.number <= r.end
			}
		}
		fail "{f.name}:{m.line}: extension ranges are not allowed in proto3" when f.syntax == "proto3" && m.extensionRanges.len() > 0
		// proto3 `optional`: a synthetic oneof per field, after the real ones.
		if f.syntax == "proto3" {
			for let fd in m.fields {
				if fd.labeled && fd.label == ProtoLabel.Optional && fd.oneofIndex < 0 {
					fd.proto3Optional = true
					let oneofName = "_" + fd.name
					for oneofTaken(m, oneofName) {
						oneofName = "X" + oneofName
					}
					fd.oneofIndex = m.oneofs.len()
					m.oneofs.push(ProtoOneofDef{name: oneofName})
				}
			}
		}
		for let x in m.extensions {
			try resolveField(table, f, x, m.fullName, true)
		}
		for let n in m.messages {
			try resolveMessage(table, f, n)
		}
		for let e in m.enums {
			try checkEnum(f, e)
		}
		return none
	}

	def oneofTaken(m ProtoMessageDef, name string) bool {
		for let o in m.oneofs {
			return true when o.name == name
		}
		for let fd in m.fields {
			return true when fd.name == name
		}
		return false
	}

	def checkEnum(f ProtoFile, e ProtoEnumDef) !none {
		expects {
			assert e.values.len() != 0 onerror fail "{f.name}:{e.line}: enum {e.name} must have at least one value"
			assert f.syntax != "proto3" || e.values[0].number == 0 onerror fail "{f.name}:{e.line}: the first value of enum {e.name} must be zero in proto3"
		}
		let aliases = false
		for let o in e.options {
			aliases = true when o.name == "allow_alias" && o.value.text == "true"
		}
		let numbers int[] = []
		let names string[] = []
		for let v in e.values {
			fail "{f.name}:{e.line}: \"{v.name}\" is already defined in {e.name}" when names.indexOf(v.name) >= 0
			fail "{f.name}:{e.line}: {v.name} reuses value {v.number} in {e.name}; set allow_alias to allow it" when !aliases && numbers.indexOf(v.number) >= 0
			names.push(v.name)
			numbers.push(v.number)
			for let r in e.reservedRanges {
				fail "{f.name}:{e.line}: {v.name} uses reserved value {v.number}" when v.number >= r.start && v.number <= r.end
			}
		}
		return none
	}
}
