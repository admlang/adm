partial module std.data.encoding {
	use (
		std.data.encoding.protoschema::*
	)

	// The scalar and composite types a field can have; the member values are
	// FieldDescriptorProto.Type's.
	enum ProtoType {
		Double = 1,
		Float = 2,
		Int64 = 3,
		Uint64 = 4,
		Int32 = 5,
		Fixed64 = 6,
		Fixed32 = 7,
		Bool = 8,
		String = 9,
		Group = 10,
		Message = 11,
		Bytes = 12,
		Uint32 = 13,
		Enum = 14,
		Sfixed32 = 15,
		Sfixed64 = 16,
		Sint32 = 17,
		Sint64 = 18
	}

	// A field's cardinality; the member values are FieldDescriptorProto.Label's.
	enum ProtoLabel {
		Optional = 1,
		Required = 2,
		Repeated = 3
	}

	// What a constant in an option is.
	enum ProtoValueKind {
		// A bare name: an enum value, `inf`, `nan` or a full identifier.
		Identifier,
		Int,
		Float,
		String,
		Bool,
		// A text-format message: `{ name: value ... }`.
		Message,
		// A text-format list: `[a, b]`, only inside a message value.
		List
	}

	// A constant as written in an option or a default: its kind and value.
	type ProtoValue {
		kind   ProtoValueKind = ProtoValueKind.Identifier
		// The identifier, or the number as written (sign included).
		text   string
		// A string's bytes after escapes are resolved.
		bytes  byte[]
		// The entries of a Message, in order: names are field names,
		// `[extension.name]` or `[type.url/Name]` as written.
		names  string[]
		values ProtoValue[]
		// The elements of a List.
		items  ProtoValue[]

		// The constant in .proto syntax.
		def str() string {
			return protoValueText(self)
		}
	}

	// One option: its name as written (`java_package`, `(my.ext).field`) and
	// its value.
	struct ProtoOption {
		name  string
		value ProtoValue
	}

	// A range of numbers, `start` to `end` inclusive.
	struct ProtoRange {
		start       int
		end         int
		options     ProtoOption[]
		// The options as the serialized ExtensionRangeOptions protoc records;
		// set when the schema resolves the file.
		optionBytes byte[]
	}

	// A field of a message, an extension, or a map entry's key or value.
	type ProtoFieldDef {
		name           string
		number         int
		// Set for `optional`, `required` and `repeated`; Optional for a
		// field written without a label.
		label          ProtoLabel    = ProtoLabel.Optional
		// Whether a label was written (proto3 `optional` is explicit
		// presence).
		labeled        bool
		fieldType      ProtoType     = ProtoType.Message
		// The type as written for a message, enum or group field
		// (`Foo`, `.pkg.Foo`); after resolution, the full name with a
		// leading dot.
		typeName       string
		// For an extension: the extended message as written, then resolved.
		extendee       string
		// The `default` option, as protoc records it, and as written.
		defaultValue   string
		hasDefault     bool
		defaultRaw     ProtoValue
		// For an extension: its full name, scope and name.
		fullName       string
		// The `json_name` option when given.
		jsonName       string
		hasJsonName    bool
		// Index into the message's oneofs, -1 for none.
		oneofIndex     int           = -1
		// Whether this is a proto3 `optional` field (synthetic oneof).
		proto3Optional bool
		// The other options.
		options        ProtoOption[]
		// For a map field: the key and value types. The field's type is the
		// generated `<Name>Entry` message.
		isMap          bool
		line           int
		// The options as the serialized FieldOptions protoc records; set when
		// the schema resolves the file.
		optionBytes    byte[]
	}

	// A oneof of a message.
	struct ProtoOneofDef {
		name        string
		options     ProtoOption[]
		optionBytes byte[]
	}

	// A message type.
	type ProtoMessageDef {
		name            string
		// The full name: package, enclosing messages and name, dot-separated.
		fullName        string
		fields          ProtoFieldDef[]
		messages        ProtoMessageDef[]
		enums           ProtoEnumDef[]
		extensions      ProtoFieldDef[]
		oneofs          ProtoOneofDef[]
		extensionRanges ProtoRange[]
		reservedRanges  ProtoRange[]
		reservedNames   string[]
		options         ProtoOption[]
		// A generated map entry message.
		mapEntry        bool
		line            int
		optionBytes     byte[]

		// The field with the name; none when absent.
		def field(name string) ?ProtoFieldDef {
			for let f in fields {
				return f when f.name == name
			}
			return none
		}

		// The field with the number; none when absent.
		def field(number int) ?ProtoFieldDef {
			for let f in fields {
				return f when f.number == number
			}
			return none
		}
	}

	// One value of an enum.
	struct ProtoEnumValueDef {
		name        string
		number      int
		options     ProtoOption[]
		optionBytes byte[]
	}

	// An enum type.
	type ProtoEnumDef {
		name           string
		fullName       string
		values         ProtoEnumValueDef[]
		reservedRanges ProtoRange[]
		reservedNames  string[]
		options        ProtoOption[]
		line           int
		optionBytes    byte[]
	}

	// An rpc of a service.
	type ProtoMethodDef {
		name            string
		// The request and response types as written, then resolved to full
		// names with a leading dot.
		inputType       string
		outputType      string
		clientStreaming bool
		serverStreaming bool
		options         ProtoOption[]
		line            int
		optionBytes     byte[]
	}

	// A service.
	type ProtoServiceDef {
		name        string
		fullName    string
		methods     ProtoMethodDef[]
		options     ProtoOption[]
		line        int
		optionBytes byte[]

		// The method with the name; none when absent.
		def method(name string) ?ProtoMethodDef {
			for let m in methods {
				return m when m.name == name
			}
			return none
		}
	}

	// One .proto file: what protoc's FileDescriptorProto holds.
	type ProtoFile {
		// The file's name as imports refer to it (`google/protobuf/any.proto`).
		name          string
		package       string
		// "proto2", "proto3" or "editions".
		syntax        string            = "proto2"
		// The edition of an editions file ("2023"); "" otherwise.
		edition       string
		imports       string[]
		// Indexes into imports of `import public` and `import weak`.
		publicImports int[]
		weakImports   int[]
		messages      ProtoMessageDef[]
		enums         ProtoEnumDef[]
		services      ProtoServiceDef[]
		extensions    ProtoFieldDef[]
		options       ProtoOption[]
		// The options as the serialized FileOptions protoc records; every
		// definition carries its own the same way. Set when the schema
		// resolves the file.
		optionBytes   byte[]

		// The message with the full name (no leading dot); none when absent.
		def message(fullName string) ?ProtoMessageDef {
			return findMessage(messages, fullName.trimPrefix("."))
		}

		// The enum with the full name; none when absent.
		def enumType(fullName string) ?ProtoEnumDef {
			return findEnum(messages, enums, fullName.trimPrefix("."))
		}

		// The service with the full name; none when absent.
		def serviceType(fullName string) ?ProtoServiceDef {
			let want = fullName.trimPrefix(".")
			for let s in services {
				return s when s.fullName == want
			}
			return none
		}

		// The file in .proto syntax, laid out the way protoc users write it.
		def str() string {
			return protoFileText(self)
		}

		// The file as a serialized google.protobuf.FileDescriptorProto, as
		// protoc writes it (without source info).
		def descriptor() byte[] {
			return encodeFile(self)
		}
	}

	// A set of .proto files with their imports resolved, as protoc compiles
	// them: parse or load files, look up their definitions, and render them
	// back as .proto text or as a FileDescriptorSet.
	//
	//     let schema = new ProtoSchema()
	//     schema.importPaths = ["protos"]
	//     let file = try schema.load("echo.proto")
	//     let msg = file.message("echo.Msg")
	type ProtoSchema {
		// The files, each after the files it imports.
		files       ProtoFile[]
		// Where load looks for a file and its imports, in order. The
		// well-known files (`google/protobuf/*.proto`) are built in.
		importPaths string[]    = ["."]

		internal optionTypes ?ProtoSchema = none
		internal exporter    ?Exporter    = none

		// An empty schema.
		def new() {}

		// An empty schema whose exported types (add) go in the package, in a
		// file named after it (`echo.v1` → `echo/v1.proto`).
		def new(package string) {
			exporter = new Exporter(package)
		}

		// Adds the message for an ADM type, and the messages and enums its
		// fields use, to the file add builds, and returns it. No instance is
		// constructed: a zero value is walked. Fields take their
		// `@protoField(N)` number or their declaration position, names
		// become snake_case, types map as the Protobuf codec encodes them
		// (`?T` optional, `T[]` repeated, `map<string, V>`, `time.Time` and
		// `duration` the well-known Timestamp and Duration, enums by member
		// value with the enum name as prefix). Fails for a field type
		// Protocol Buffers cannot hold (`any`, maps with other keys, nested
		// arrays), an enum whose first value is not 0, or two ADM types with
		// the same name.
		def add<T>() !ProtoMessageDef {
			let v T
			exporter = new Exporter("") when exporter is none
			let ex = exporter
			fail "protobuf: no exporter" when ex is none
			let name = try ex.addMessage(v)
			try refreshExport(ex)
			let m = message(ex.qualified(name))
			fail "protobuf: exported message {name} is missing" when m is none
			return m
		}

		// The .proto text of the file add builds; "" before the first add.
		def str() string {
			let ex = exporter
			return "" when ex is none
			let f = file(ex.fileName())
			return f is none ?? ("", f.str())
		}

		// Rebuilds the exported file from what add collected and replaces it
		// in the schema.
		internal def refreshExport(ex Exporter) !none {
			let name = ex.fileName()
			for let dep in ex.imports {
				if file(dep) is none {
					let source = builtinProto(dep)
					try parse(dep, source) unless source is none
				}
			}
			let kept ProtoFile[] = []
			for let f in files {
				kept.push(f) unless f.name == name
			}
			files = kept
			let text = ex.text()
			parse(name, text) onerror (err error) {
				fail "protobuf: exported file does not parse ({err.message}):\n{text}"
			}
			return none
		}

		// Parses a file and adds it. Its imports must already be in the set.
		// Fails on a syntax error, an import that is missing, a type name
		// that does not resolve, or a definition protoc rejects (duplicate
		// names or numbers, numbers in reserved ranges, proto3 rules); the
		// message starts with `name:line:column:`.
		def parse(name string, text string) !ProtoFile {
			fail "{name}: already in the schema" unless file(name) is none
			let f = try new Parser(name, text).parse()
			for let dep in f.imports {
				if file(dep) is none {
					let builtin = builtinProto(dep)
					try parse(dep, builtin) unless builtin is none
				}
			}
			// descriptor.proto defines the options messages itself.
			let types = self
			types = try optionSchema() unless f.name == "google/protobuf/descriptor.proto"
			try resolveFile(self, f, types)
			files.push(f)
			return f
		}

		// Reads a file from the import paths, loading the files it imports
		// first, and adds it. Fails when a file cannot be found or read, or
		// as parse does.
		def load(name string) !ProtoFile {
			let have = file(name)
			return have unless have is none
			let builtin = builtinProto(name)
			let text = ""
			if builtin is none {
				text = try readProtoFile(importPaths, name)
			} else {
				text = readProtoFile(importPaths, name) onerror recover builtin
			}
			let f = try new Parser(name, text).parse()
			for let dep in f.imports {
				try load(dep) when file(dep) is none
			}
			// descriptor.proto defines the options messages itself.
			let types = self
			types = try optionSchema() unless f.name == "google/protobuf/descriptor.proto"
			try resolveFile(self, f, types)
			files.push(f)
			return f
		}

		// Every file as a serialized google.protobuf.FileDescriptorSet, each
		// file after its imports, as `protoc --descriptor_set_out
		// --include_imports` writes it.
		def descriptor() byte[] {
			let w = new ProtoWriter()
			for let f in files {
				w.write(1, f.descriptor())
			}
			return w.bytes()
		}

		// The schema defining the options messages: this one when it holds
		// descriptor.proto, else the built-in copy, parsed once.
		internal def optionSchema() !ProtoSchema {
			return self when !(file("google/protobuf/descriptor.proto") is none)
			let have = optionTypes
			return have unless have is none
			let s = new ProtoSchema()
			let source = builtinProto("google/protobuf/descriptor.proto")
			try s.parse("google/protobuf/descriptor.proto", source) unless source is none
			optionTypes = s
			return s
		}

		// The file with the name; none when it is not in the set.
		def file(name string) ?ProtoFile {
			for let f in files {
				return f when f.name == name
			}
			return none
		}

		// The message with the full name, in any file; none when absent.
		def message(fullName string) ?ProtoMessageDef {
			for let f in files {
				let m = f.message(fullName)
				return m unless m is none
			}
			return none
		}

		// The enum with the full name, in any file; none when absent.
		def enumType(fullName string) ?ProtoEnumDef {
			for let f in files {
				let e = f.enumType(fullName)
				return e unless e is none
			}
			return none
		}

		// The service with the full name, in any file; none when absent.
		def serviceType(fullName string) ?ProtoServiceDef {
			for let f in files {
				let s = f.serviceType(fullName)
				return s unless s is none
			}
			return none
		}
	}
}

internal partial module std.data.encoding.protoschema {
	use (
		std.data.encoding::*
	)

	// A token of the .proto language.
	enum TokKind {
		Ident,
		Int,
		Float,
		String,
		Symbol,
		End
	}

	struct Tok {
		kind  TokKind
		text  string
		bytes byte[]
		line  int
		col   int
	}

	// Splits .proto source into tokens; comments and whitespace are skipped.
	type Lexer {
		src  byte[]
		i    int    = 0
		line int    = 1
		col  int    = 1
		file string

		def new(file string, text string) {
			self.file = file
			self.src = text.bytes()
		}

		def raise(line int, col int, message string) !none {
			fail "{file}:{line}:{col}: {message}"
		}

		def peekByte(k int) int {
			return -1 when i + k >= src.len()
			return int(src[i + k])
		}

		def advance() {
			if src[i] == byte(0x0A) {
				line++
				col = 1
			} else {
				col++
			}
			i++
		}

		def skipSpace() !none {
			for i < src.len() {
				let c = peekByte(0)
				if c := 0x20 || 0x09 || 0x0A || 0x0D || 0x0B || 0x0C {
					advance()
					continue
				}
				if c == 0x2F && peekByte(1) == 0x2F {
					for i < src.len() && peekByte(0) != 0x0A {
						advance()
					}
					continue
				}
				if c == 0x2F && peekByte(1) == 0x2A {
					let l = line
					let cl = col
					advance()
					advance()
					for {
						try raise(l, cl, "unterminated comment") when i >= src.len()
						if peekByte(0) == 0x2A && peekByte(1) == 0x2F {
							advance()
							advance()
							break
						}
						advance()
					}
					continue
				}
				break
			}
			return none
		}

		def next() !Tok {
			try skipSpace()
			let l = line
			let cl = col
			return Tok{kind: TokKind.End, line: l, col: cl} when i >= src.len()
			let c = peekByte(0)
			if isLetter(c) {
				let start = i
				for i < src.len() && (isLetter(peekByte(0)) || isDigit(peekByte(0))) {
					advance()
				}
				return Tok{kind: TokKind.Ident, text: string(src.slice(start, i - start)), line: l, col: cl}
			}
			return try number(l, cl) when isDigit(c) || (c == 0x2E && isDigit(peekByte(1)))
			if c := 0x22 || 0x27 {
				return try stringLit(l, cl)
			}
			advance()
			return Tok{kind: TokKind.Symbol, text: string([byte(c)]), line: l, col: cl}
		}

		def number(l int, cl int) !Tok {
			let start = i
			let isFloat = false
			if peekByte(0) == 0x30 && (peekByte(1) == 0x78 || peekByte(1) == 0x58) {
				advance()
				advance()
				try raise(l, cl, "hex literal without digits") unless isHex(peekByte(0))
				for isHex(peekByte(0)) {
					advance()
				}
			} else {
				for isDigit(peekByte(0)) {
					advance()
				}
				if peekByte(0) == 0x2E {
					isFloat = true
					advance()
					for isDigit(peekByte(0)) {
						advance()
					}
				}
				if peekByte(0) == 0x65 || peekByte(0) == 0x45 {
					isFloat = true
					advance()
					advance() when peekByte(0) == 0x2B || peekByte(0) == 0x2D
					try raise(l, cl, "exponent without digits") unless isDigit(peekByte(0))
					for isDigit(peekByte(0)) {
						advance()
					}
				}
			}
			try raise(l, cl, "number runs into a name") when isLetter(peekByte(0))
			let text = string(src.slice(start, i - start))
			return Tok{kind: isFloat ?? (TokKind.Float, TokKind.Int), text: text, line: l, col: cl}
		}

		def stringLit(l int, cl int) !Tok {
			let quote = peekByte(0)
			advance()
			let out byte[]
			for {
				try raise(l, cl, "unterminated string") when i >= src.len() || peekByte(0) == 0x0A
				let c = peekByte(0)
				if c == quote {
					advance()
					break
				}
				if c != 0x5C {
					out.push(byte(c))
					advance()
					continue
				}
				advance()
				let e = peekByte(0)
				try raise(l, cl, "unterminated string") when e < 0
				advance()
				match e {
					case 0x61:
						out.push(byte(7))
					case 0x62:
						out.push(byte(8))
					case 0x66:
						out.push(byte(12))
					case 0x6E:
						out.push(byte(10))
					case 0x72:
						out.push(byte(13))
					case 0x74:
						out.push(byte(9))
					case 0x76:
						out.push(byte(11))
					case 0x5C, 0x27, 0x22, 0x3F:
						out.push(byte(e))
					case 0x78, 0x58:
						let v = 0
						let n = 0
						for n < 2 && isHex(peekByte(0)) {
							v = v * 16 + hexDigit(peekByte(0))
							advance()
							n++
						}
						try raise(l, cl, "\\x without hex digits") when n == 0
						out.push(byte(v))
					case 0x75, 0x55:
						let count = e == 0x75 ?? (4, 8)
						let v = 0
						for let k = 0; k < count; k++ {
							try raise(l, cl, "\\u needs {count} hex digits") unless isHex(peekByte(0))
							v = v * 16 + hexDigit(peekByte(0))
							advance()
						}
						try raise(l, cl, "\\u escape is not a Unicode scalar value") when v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF)
						out = out.append(char(v))
					default:
						if e >= 0x30 && e <= 0x37 {
							let v = e - 0x30
							let n = 1
							for n < 3 && peekByte(0) >= 0x30 && peekByte(0) <= 0x37 {
								v = v * 8 + peekByte(0) - 0x30
								advance()
								n++
							}
							try raise(l, cl, "octal escape above \\377") when v > 255
							out.push(byte(v))
						} else {
							try raise(l, cl, "unknown escape \\{string([byte(e)])}")
						}
				}
			}
			return Tok{kind: TokKind.String, bytes: out, line: l, col: cl}
		}
	}

	def isLetter(c int) bool {
		return (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) || c == 0x5F
	}

	def isDigit(c int) bool {
		return c >= 0x30 && c <= 0x39
	}

	def isHex(c int) bool {
		return isDigit(c) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66)
	}

	def hexDigit(c int) int {
		return c - 0x30 when isDigit(c)
		return c - 0x41 + 10 when c <= 0x46
		return c - 0x61 + 10
	}

	def findMessage(list ProtoMessageDef[], fullName string) ?ProtoMessageDef {
		for let m in list {
			return m when m.fullName == fullName
			if fullName.startsWith(m.fullName + ".") {
				let inner = findMessage(m.messages, fullName)
				return inner unless inner is none
			}
		}
		return none
	}

	def findEnum(messages ProtoMessageDef[], enums ProtoEnumDef[], fullName string) ?ProtoEnumDef {
		for let e in enums {
			return e when e.fullName == fullName
		}
		for let m in messages {
			if fullName.startsWith(m.fullName + ".") {
				let inner = findEnum(m.messages, m.enums, fullName)
				return inner unless inner is none
			}
		}
		return none
	}
}
