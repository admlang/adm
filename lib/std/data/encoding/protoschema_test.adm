partial module std.data.encoding {
	use (
		std.testing
		std.time
	)

	struct PsAddress {
		street  string
		zipCode int32
	}

	struct PsPerson {
		name      string
		id        int32
		userId    uint64
		ratio     float32
		score     float
		active    bool
		avatar    byte[]
		home      PsAddress
		addresses PsAddress[]
		tags      string[]
		labels    map<string, PsAddress>
		nickname  ?string
		born      time.Time
		wait      duration

		@protoField(20, encoding = ProtoEncoding.ZigZag)
		delta int

		@protoField(21, encoding = ProtoEncoding.Fixed)
		hash uint32

		@protoField(22, packed = false)
		raw int32[]

		@protoField(23, oneof = "contact")
		email ?string

		@protoField(24, oneof = "contact")
		phone ?string

		@protoField(ignore = true)
		cache string
	}

	enum PsColour {
		Red,
		Green = 5,
		Blue
	}

	struct PsPaint {
		colour PsColour
		mix    PsColour[]
	}

	struct PsBad {
		thing any
	}

	// Test .proto files and the FileDescriptorSet protoc 35.1 writes for each
	// (`protoc --descriptor_set_out`, no imports, no source info).
	@embed("proto/testdata/t.proto")
	const psT byte[]

	@embed("proto/testdata/t.pb")
	const psTPb byte[]

	@embed("proto/testdata/opt.proto")
	const psOpt byte[]

	@embed("proto/testdata/opt.pb")
	const psOptPb byte[]

	@embed("proto/testdata/echo.proto")
	const psEcho byte[]

	@embed("proto/testdata/echo.pb")
	const psEchoPb byte[]

	@embed("proto/testdata/rich.proto")
	const psRich byte[]

	@embed("proto/testdata/rich.pb")
	const psRichPb byte[]

	@embed("proto/testdata/ed.proto")
	const psEd byte[]

	@embed("proto/testdata/ed.pb")
	const psEdPb byte[]

	// descriptor.proto, type.proto, struct.proto and cpp_features.proto.
	@embed("proto/testdata/wkt.pb")
	const psWktPb byte[]

	// A FileDescriptorSet holding the files' descriptors.
	def psSet(files ProtoFile[]) byte[] {
		let w = new ProtoWriter()
		for let f in files {
			w.write(1, f.descriptor())
		}
		return w.bytes()
	}

	// Parses a file into a fresh schema and compares its descriptor with
	// protoc's.
	def psMatches(name string, source byte[], reference byte[]) bool {
		let schema = new ProtoSchema()
		let f = schema.parse(name, string(source)) onerror (err error) {
			println("{name}: {err.message}")
			return false
		}
		let got = psSet([f])
		println("{name}: {got.len()} bytes, protoc {reference.len()}") unless got.equals(reference)
		return got.equals(reference)
	}

	// Reports whether parsing the source fails with a message containing
	// want.
	def psRejects(source string, want string) bool {
		let message = ""
		new ProtoSchema().parse("x.proto", source) onerror (err error) {
			message = err.message
			recover new ProtoFile()
		}
		println("wanted \"{want}\", got \"{message}\"") unless message.contains(want)
		return message.contains(want)
	}

	def psMessage(schema ProtoSchema, name string) !ProtoMessageDef {
		let m = schema.message(name)
		fail "no message {name}" when m is none
		return m
	}

	def psField(m ProtoMessageDef, name string) !ProtoFieldDef {
		let f = m.field(name)
		fail "no field {name}" when f is none
		return f
	}

	check "ProtoSchema" {
		@test()
		def TestDescriptorsMatchProtoc() !none {
			assert psMatches("t.proto", psT, psTPb)
			assert psMatches("opt.proto", psOpt, psOptPb)
			assert psMatches("echo.proto", psEcho, psEchoPb)
			assert psMatches("rich.proto", psRich, psRichPb)
			assert psMatches("ed.proto", psEd, psEdPb)
			return none
		}

		@test()
		def TestWellKnownFiles() !none {
			let schema = new ProtoSchema()
			let files ProtoFile[] = []
			for let name in ["google/protobuf/descriptor.proto", "google/protobuf/type.proto", "google/protobuf/struct.proto"] {
				files.push(try schema.load(name))
			}
			let any = schema.file("google/protobuf/any.proto")
			assert !(any is none)
			// cpp_features.proto is not built in; parse it from the
			// descriptor set's own source of truth: the reference bytes cover
			// the other three exactly.
			let reference = try new Protobuf().parse(psWktPb)
			let all = reference.all(1)
			for let (i, f) in files {
				let want = try all[i].asBytes()
				println("{f.name}: {f.descriptor().len()} vs {want.len()}") unless f.descriptor().equals(want)
				assert f.descriptor().equals(want)
			}
			return none
		}

		@test()
		def TestTextRoundTrip() !none {
			let names = ["t.proto", "opt.proto", "echo.proto", "rich.proto", "ed.proto"]
			let sources = [psT, psOpt, psEcho, psRich, psEd]
			for let (i, name) in names {
				let first = try new ProtoSchema().parse(name, string(sources[i]))
				let text = first.str()
				let second = new ProtoSchema().parse(name, text) onerror (err error) {
					println("{name} reparse: {err.message}\n{text}")
					return none
				}
				println("{name} round trip differs:\n{text}") unless second.descriptor().equals(first.descriptor())
				assert second.descriptor().equals(first.descriptor())
			}
			return none
		}

		@test()
		def TestLookups() !none {
			let schema = new ProtoSchema()
			let f = try schema.parse("rich.proto", string(psRich))
			let thing = try psMessage(schema, "rich.Thing")
			let id = try psField(thing, "id")
			assert id.number == 1 && id.label == ProtoLabel.Required && id.fieldType == ProtoType.Int32
			let kids = thing.field(8)
			assert !(kids is none)
			let k = try psField(thing, "kids")
			assert k.isMap && k.typeName == ".rich.Thing.KidsEntry"
			assert (try psField(thing, "color")).fieldType == ProtoType.Enum && (try psField(thing, "color")).defaultValue == "BLUE"
			assert (try psField(thing, "raw")).defaultValue == "\\001\\377"
			assert (try psField(thing, "f")).defaultValue == "1e+10"
			assert !(schema.enumType(".rich.Thing.Color") is none)
			let svc = schema.serviceType("rich.Svc")
			fail "no service" when svc is none
			let m = svc.method("Do")
			fail "no method" when m is none
			assert m.serverStreaming && !m.clientStreaming && m.inputType == ".rich.Thing"
			assert f.extensions.len() == 4 && f.extensions[0].extendee == ".google.protobuf.FieldOptions"
			assert !(schema.file("google/protobuf/descriptor.proto") is none)
			return none
		}

		@test()
		def TestExportTypes() !none {
			let schema = new ProtoSchema("demo.v1")
			let m = try schema.add<PsPerson>()
			assert m.fullName == "demo.v1.PsPerson"
			let want = "syntax = \"proto3\";\n\npackage demo.v1;\n\nimport \"google/protobuf/timestamp.proto\";\nimport \"google/protobuf/duration.proto\";\n\nmessage PsPerson \{\n  string name = 1;\n  int32 id = 2;\n  uint64 user_id = 3;\n  float ratio = 4;\n  double score = 5;\n  bool active = 6;\n  bytes avatar = 7;\n  .demo.v1.PsAddress home = 8;\n  repeated .demo.v1.PsAddress addresses = 9;\n  repeated string tags = 10;\n  map<string, .demo.v1.PsAddress> labels = 11;\n  optional string nickname = 12;\n  .google.protobuf.Timestamp born = 13;\n  .google.protobuf.Duration wait = 14;\n  sint64 delta = 20;\n  fixed32 hash = 21;\n  repeated int32 raw = 22 [packed = false];\n  oneof contact \{\n    string email = 23;\n    string phone = 24;\n  \}\n\}\n\nmessage PsAddress \{\n  string street = 1;\n  int32 zip_code = 2;\n\}\n"
			let got = schema.str()
			println(got) unless got == want
			assert got == want
			assert !(schema.file("demo/v1.proto") is none)
			// Adding again, or a type already pulled in, changes nothing.
			try schema.add<PsAddress>()
			try schema.add<PsPerson>()
			assert schema.str() == want
			// The codec's bytes for a value decode by the exported schema's
			// numbers and types.
			let p = new PsPerson()
			p.name = "ann"
			p.home.zipCode = int32(1234)
			p.delta = -2
			p.hash = uint32(7)
			p.phone = "555"
			let wire = try new Protobuf().parse(new Protobuf().encode(p))
			let person = try psMessage(schema, "demo.v1.PsPerson")
			assert (try wire.get((try psField(person, "name")).number).asString()) == "ann"
			assert (try wire.get((try psField(person, "delta")).number).asInt(ProtoEncoding.ZigZag)) == -2
			assert (try wire.get((try psField(person, "hash")).number).asUint32(ProtoEncoding.Fixed)) == uint32(7)
			assert (try wire.get((try psField(person, "phone")).number).asString()) == "555"
			let home = try wire.get((try psField(person, "home")).number).asMessage()
			let address = try psMessage(schema, "demo.v1.PsAddress")
			assert (try home.get((try psField(address, "zip_code")).number).asInt32()) == int32(1234)
			return none
		}

		@test()
		def TestExportEnums() !none {
			let schema = new ProtoSchema("paint")
			try schema.add<PsPaint>()
			let want = "syntax = \"proto3\";\n\npackage paint;\n\nmessage PsPaint \{\n  .paint.PsColour colour = 1;\n  repeated .paint.PsColour mix = 2;\n\}\n\nenum PsColour \{\n  PS_COLOUR_RED = 0;\n  PS_COLOUR_GREEN = 5;\n  PS_COLOUR_BLUE = 6;\n\}\n"
			println(schema.str()) unless schema.str() == want
			assert schema.str() == want
			return none
		}

		@test()
		def TestExportRefusals() !none {
			let message = ""
			new ProtoSchema().add<PsBad>() onerror (err error) {
				message = err.message
				recover new ProtoMessageDef()
			}
			assert message.contains("has no Protocol Buffers form")
			return none
		}

		@test()
		def TestRejects() !none {
			assert psRejects("syntax = \"proto4\";", "x.proto:1:")
			assert psRejects("syntax = \"proto3\";\nmessage M \{ int32 a = 1 \}", "x.proto:2:25: expected \";\"")
			assert psRejects("message M \{ Missing a = 1; \}", "\"Missing\" is not defined")
			assert psRejects("message M \{ optional int32 a = 1; optional int32 b = 1; \}", "field number 1 is already used")
			assert psRejects("message M \{ optional int32 a = 1; optional int32 a = 2; \}", "field \"a\" is already defined")
			assert psRejects("message M \{ reserved 2 to 4; optional int32 a = 3; \}", "reserved number 3")
			assert psRejects("message M \{ reserved \"a\"; optional int32 a = 1; \}", "field name \"a\" is reserved")
			assert psRejects("syntax = \"proto3\";\nmessage M \{ required int32 a = 1; \}", "required fields are not allowed in proto3")
			assert psRejects("syntax = \"proto3\";\nenum E \{ A = 1; \}", "must be zero in proto3")
			assert psRejects("message M \{ optional int32 a = 1 [bogus = true]; \}", "option \"bogus\" is unknown")
			assert psRejects("message M \{ optional int32 a = 1 [deprecated = 3]; \}", "needs true or false")
			assert psRejects("message M \{ map<float, int32> m = 1; \}", "map key type float")
			assert psRejects("message M \{ optional int32 a = 19000; \}", "reserved for the protocol buffer library")
			assert psRejects("message M \{ optional int32 a = 536870912; \}", "outside 1 to 536870911")
			assert psRejects("message M \{\} message M \{\}", "\"M\" is already defined")
			assert psRejects("enum E \{ A = 0; B = 0; \}", "set allow_alias")
			assert psRejects("message M \{ optional int32 a = 1 [default = \"x\"]; \}", "must be an integer")
			assert psRejects("import \"nope.proto\";", "import \"nope.proto\" was not found")
			assert psRejects("message M \{ optional string s = 1 [default = \"\\q\"]; \}", "unknown escape")
			return none
		}
	}
}
