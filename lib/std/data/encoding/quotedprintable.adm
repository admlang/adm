partial module std.data.encoding {
	// quotedPrintableEncode renders bytes as quoted-printable text (RFC 2045
	// section 6.7): printable ASCII passes through, every other byte becomes
	// `=XX`, lines are soft-wrapped at 76 columns with `=`, and trailing
	// spaces on a line are encoded so they survive transport.
	def quotedPrintableEncode(input byte[]) string {
		return quotedPrintableCodec.encode(input)
	}

	// quotedPrintableDecode reads quoted-printable text back to bytes. Fails
	// when an `=` is not followed by two hex digits or a soft line break.
	def quotedPrintableDecode(input string) !byte[] {
		return quotedPrintableCodec.decode(input)
	}

	internal let quotedPrintableCodec = new QuotedPrintable()

	// QuotedPrintable encodes and decodes the quoted-printable transfer
	// encoding used by mail bodies and headers.
	//
	// Example:
	// ```example
	// let codec = new QuotedPrintable()
	// let text = codec.encode("héllo = world".bytes())  // "h=C3=A9llo =3D world"
	// let back = try codec.decode(text)
	// println(string(back))  // héllo = world
	// ```
	type QuotedPrintable {
		// Column at which a line is soft-wrapped; 76 is the RFC maximum.
		lineLength int = 76

		def new() {}

		// encode renders the bytes; CR LF and LF line endings in the input
		// stay hard line breaks, everything else that is not printable
		// ASCII becomes `=XX` with upper-case hex.
		def encode(input byte[]) string {
			let out byte[] = []
			let line byte[] = []
			let i = 0
			for i < input.len() {
				let b = input[i]
				let next = i + 1 < input.len() ?? (int(input[i + 1]), -1)
				if b == 0x0D && next == 0x0A {
					flushHard(out, line)
					line = []
					i += 2
					continue
				}
				if b == 0x0A {
					flushHard(out, line)
					line = []
					i++
					continue
				}
				let chunk byte[] = []
				let atLineEnd = next < 0 || next == 0x0A || (next == 0x0D && i + 2 < input.len() && input[i + 2] == 0x0A)
				if (b == 0x20 || b == 0x09) && !atLineEnd {
					chunk = [b]
				} else if b >= 0x21 && b <= 0x7E && b != 0x3D {
					chunk = [b]
				} else {
					chunk = escaped(b)
				}
				if line.len() + chunk.len() > lineLength - 1 {
					for let c in line {
						out.push(c)
					}
					out.push(0x3D)
					out.push(0x0D)
					out.push(0x0A)
					line = []
				}
				for let c in chunk {
					line.push(c)
				}
				i++
			}
			for let c in line {
				out.push(c)
			}
			return string(out)
		}

		// flushHard writes a finished line followed by CR LF.
		internal def flushHard(out byte[], line byte[]) {
			for let c in line {
				out.push(c)
			}
			out.push(0x0D)
			out.push(0x0A)
		}

		// escaped renders a byte as `=XX`.
		internal def escaped(b byte) byte[] {
			let digits = "0123456789ABCDEF".bytes()
			return [0x3D, digits[int(b) / 16], digits[int(b) % 16]]
		}

		// decode reads the text back: `=XX` sequences, soft breaks (`=` at
		// the end of a line) and hard breaks. Whitespace before a line end
		// is dropped, as the RFC requires. Fails on a bad escape.
		def decode(text string) !byte[] {
			let input = text.bytes()
			let out byte[] = []
			let pending byte[] = []
			let i = 0
			for i < input.len() {
				let b = input[i]
				if b == 0x3D {
					if i + 1 < input.len() && input[i + 1] == 0x0A {
						pending = []
						i += 2
						continue
					}
					if i + 2 < input.len() && input[i + 1] == 0x0D && input[i + 2] == 0x0A {
						pending = []
						i += 3
						continue
					}
					fail "quotedprintable: bad escape at offset {i}" when i + 2 >= input.len() || !char(input[i + 1]).isHexDigit() || !char(input[i + 2]).isHexDigit()
					for let c in pending {
						out.push(c)
					}
					pending = []
					out.push(byte(char(input[i + 1]).digitValue(16) * 16 + char(input[i + 2]).digitValue(16)))
					i += 3
					continue
				}
				if b == 0x0A || (b == 0x0D && i + 1 < input.len() && input[i + 1] == 0x0A) {
					pending = []
					out.push(0x0A)
					i += b == 0x0D ?? (2, 1)
					continue
				}
				if b == 0x20 || b == 0x09 {
					pending.push(b)
					i++
					continue
				}
				for let c in pending {
					out.push(c)
				}
				pending = []
				out.push(b)
				i++
			}
			return out
		}
	}

	// encodeWord renders text as an RFC 2047 encoded word for a mail header
	// (`=?utf-8?Q?caf=C3=A9?=`). `Q` encoding is used unless the text is
	// mostly non-ASCII, then `B` (base64); `base64` forces `B`. Plain ASCII
	// without special characters is returned unchanged. Words longer than
	// 75 characters are split into several, as the RFC requires.
	//
	// Example:
	// ```example
	// println(encoding.encodeWord("café"))          // =?utf-8?q?caf=C3=A9?=
	// println(encoding.encodeWord("plain"))         // plain
	// println(encoding.encodeWord("日本", "utf-8", true))  // =?utf-8?b?5pel5pys?=
	// ```
	def encodeWord(text string, charset string = "utf-8", base64 bool = false) string {
		return text unless wordNeedsEncoding(text)
		let raw = text.bytes()
		let nonASCII = 0
		for let b in raw {
			nonASCII++ when b >= 0x80
		}
		let useB = base64 || nonASCII * 2 > raw.len()
		let cs = charset.lower()
		let overhead = cs.len() + 7
		let room = 75 - overhead
		let words string[] = []
		if useB {
			let chunk byte[] = []
			for let i = 0; i < text.len(); i++ {
				let piece = string(text[i]).bytes()
				if chunk.len() > 0 && (chunk.len() + piece.len() + 2) / 3 * 4 > room {
					words.push("=?" + cs + "?b?" + base64encode(chunk) + "?=")
					chunk = []
				}
				for let b in piece {
					chunk.push(b)
				}
			}
			words.push("=?" + cs + "?b?" + base64encode(chunk) + "?=") when chunk.len() > 0
			return words.join(" ")
		}
		let payload = ""
		for let i = 0; i < text.len(); i++ {
			let piece = qEncode(string(text[i]).bytes())
			if payload != "" && payload.len() + piece.len() > room {
				words.push("=?" + cs + "?q?" + payload + "?=")
				payload = ""
			}
			payload += piece
		}
		words.push("=?" + cs + "?q?" + payload + "?=") when payload != ""
		return words.join(" ")
	}

	// wordNeedsEncoding reports text a header cannot carry as-is: a byte
	// outside printable ASCII, or the `=?` and `?=` markers themselves.
	internal def wordNeedsEncoding(text string) bool {
		for let b in text.bytes() {
			return true when b < 0x20 || b > 0x7E
		}
		return text.contains("=?") || text.contains("?=")
	}

	// qEncode renders bytes in the RFC 2047 `Q` form: space as `_`, the
	// specials `=`, `?` and `_` and everything non-printable as `=XX`.
	internal def qEncode(raw byte[]) string {
		let out = ""
		let digits = "0123456789ABCDEF"
		for let b in raw {
			if b == 0x20 {
				out += "_"
				continue
			}
			if b >= 0x21 && b <= 0x7E && b != 0x3D && b != 0x3F && b != 0x5F {
				out += string(char(b))
				continue
			}
			out += "=" + string(digits[int(b) / 16]) + string(digits[int(b) % 16])
		}
		return out
	}

	// decodeWords decodes every RFC 2047 encoded word in a header value and
	// returns the plain text; text outside the words passes through, and
	// whitespace between two adjacent encoded words is dropped. Charsets
	// `utf-8`, `us-ascii` and `iso-8859-1` are decoded; another charset
	// fails. A malformed word fails too.
	//
	// Example:
	// ```example
	// println(try encoding.decodeWords("=?utf-8?q?caf=C3=A9?= au lait"))  // café au lait
	// ```
	def decodeWords(header string) !string {
		let out = ""
		let between = ""
		let afterWord = false
		let i = 0
		for i < header.len() {
			let start = header.indexOf("=?", i)
			if start < 0 {
				out += between + header[i:]
				break
			}
			let end = header.indexOf("?=", start + 2)
			fail "quotedprintable: unterminated encoded word" when end < 0
			let gap = header[i:start]
			// Whitespace between two encoded words is not part of the text.
			if !(afterWord && gap.trim() == "") {
				between += gap
			}
			out += between
			between = ""
			out += try decodeWord(header[start + 2:end])
			afterWord = true
			i = end + 2
		}
		return out
	}

	// decodeWord reads `charset?enc?payload`, the inside of an encoded word.
	internal def decodeWord(body string) !string {
		let parts = body.split("?")
		fail "quotedprintable: malformed encoded word" when parts.len() != 3
		let charset = parts[0].lower()
		let enc = parts[1].lower()
		let payload = parts[2]
		let raw byte[] = []
		if enc == "q" {
			raw = try quotedPrintableCodec.decode(payload.replace("_", " "))
		} else if enc == "b" {
			raw = try base64decode(payload)
		} else {
			fail "quotedprintable: unknown encoding '{parts[1]}' in encoded word"
		}
		let cs = charset
		let langMark = cs.indexOf("*")
		cs = cs[:langMark] when langMark >= 0
		return string(raw) when cs := "utf-8" || "utf8" || "us-ascii" || "ascii"
		if cs := "iso-8859-1" || "latin1" || "latin-1" {
			let text = ""
			for let b in raw {
				text += string(char(b))
			}
			return text
		}
		fail "quotedprintable: unsupported charset '{charset}' in encoded word"
	}
}
