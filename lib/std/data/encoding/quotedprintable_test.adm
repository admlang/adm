partial module std.data.encoding {
	use std.testing

	check "QuotedPrintable" {
		@test()
		def encodesAndDecodesRoundTrip() !none {
			let codec = new QuotedPrintable()
			let text = codec.encode("héllo = world".bytes())
			assert text == "h=C3=A9llo =3D world"
			assert string(try codec.decode(text)) == "héllo = world"
			assert quotedPrintableEncode("plain".bytes()) == "plain"
			assert string(try quotedPrintableDecode("plain")) == "plain"
			return none
		}

		@test()
		def wrapsLongLinesSoftly() !none {
			let codec = new QuotedPrintable()
			let long = "a".repeat(100)
			let text = codec.encode(long.bytes())
			for let line in text.split("\r\n") {
				assert line.len() <= 76
			}
			assert text.contains("=\r\n")
			assert string(try codec.decode(text)) == long
			return none
		}

		@test()
		def protectsTrailingWhitespaceAndLineEnds() !none {
			let codec = new QuotedPrintable()
			assert codec.encode("a \nb\t\r\nc".bytes()) == "a=20\r\nb=09\r\nc"
			assert string(try codec.decode("a=20\r\nb=09\r\nc")) == "a \nb\t\nc"
			// Whitespace before a line end was added by transport and is dropped.
			assert string(try codec.decode("a   \r\nb")) == "a\nb"
			assert string(try codec.decode("lower=3d=3D")) == "lower=="
			return none
		}

		@test()
		def rejectsBadEscapes() !none {
			let codec = new QuotedPrintable()
			assert codec.decode("=ZZ") is error
			assert codec.decode("abc=") is error
			assert codec.decode("abc=4") is error
			return none
		}
	}

	check "Encoded words" {
		@test()
		def encodesWordsForHeaders() !none {
			assert encodeWord("plain ascii") == "plain ascii"
			assert encodeWord("café") == "=?utf-8?q?caf=C3=A9?="
			assert encodeWord("a=?b") == "=?utf-8?q?a=3D=3Fb?="
			assert encodeWord("日本") == "=?utf-8?b?5pel5pys?="
			assert encodeWord("café", "utf-8", true) == "=?utf-8?b?Y2Fmw6k=?="
			let long = encodeWord("é".repeat(40))
			let words = long.split(" ")
			assert words.len() > 1
			for let w in words {
				assert w.len() <= 75
				assert w.startsWith("=?utf-8?")
				assert w.endsWith("?=")
			}
			assert try decodeWords(long) == "é".repeat(40)
			return none
		}

		@test()
		def decodesWordsInHeaders() !none {
			assert try decodeWords("=?utf-8?q?caf=C3=A9?= au lait") == "café au lait"
			assert try decodeWords("=?UTF-8?B?5pel5pys?= x") == "日本 x"
			assert try decodeWords("=?utf-8?q?a?=  =?utf-8?q?b?=") == "ab"
			assert try decodeWords("=?iso-8859-1?q?caf=E9?=") == "café"
			assert try decodeWords("=?utf-8*en?q?hi_there?=") == "hi there"
			assert try decodeWords("no words here") == "no words here"
			assert decodeWords("=?utf-8?q?open") is error
			assert decodeWords("=?utf-8?x?abc?=") is error
			assert decodeWords("=?koi8-r?q?abc?=") is error
			return none
		}
	}
}
