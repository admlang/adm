partial module std.data.encoding.shiftjis {
	// Shift JIS (JIS X 0208): ASCII in single bytes 0x00 to 0x7F, half-width
	// katakana in 0xA1 to 0xDF, and the kanji, kana and symbols of JIS X 0208
	// in two bytes, lead 0x81 to 0x9F or 0xE0 to 0xEF.
	use std.data.encoding.shiftjis.table::*

	internal let reverse ?map<int, int> = none

	// The Shift JIS code of a character: the byte value for a single-byte
	// character, lead << 8 | trail for a double-byte one. None when Shift JIS
	// has no code for it.
	def encode(c char) ?int {
		let cp = int(c)
		return cp when cp < 0x80
		return cp - 0xff61 + 0xa1 when cp >= 0xff61 && cp <= 0xff9f
		return reverseMap().get(cp)
	}

	// The double-byte codes by code point, built on first use.
	internal def reverseMap() map<int, int> {
		let cached = reverse
		return cached unless cached is none
		let m = map<int, int>{}
		for let (k, v) in doubleByte {
			continue when v == 0 || m.hasKey(v)
			let lead = k / 188
			let trail = k % 188
			let t = trail < 63 ?? (0x40 + trail, 0x80 + trail - 63)
			let l = lead < 31 ?? (0x81 + lead, 0xe0 + lead - 31)
			m[v] = (l << 8) | t
		}
		reverse = m
		return m
	}

	// Encodes text in Shift JIS. A character with no code becomes
	// replacement; without one, the encoding fails.
	// Fails when a character cannot be encoded and no replacement is given.
	def encode(text string, replacement ?byte = none) !byte[] {
		let out byte[]
		for let ch in text {
			let code = encode(ch)
			if code is none {
				fail "shiftjis: no code for U+" + int(ch).hex() when replacement is none
				out.push(replacement)
				continue
			}
			let v = code
			if v > 0xff {
				out.push(byte(v >> 8))
			}
			out.push(byte(v & 0xff))
		}
		return out
	}

	// Decodes Shift JIS bytes. A byte sequence with no character becomes
	// U+FFFD.
	def decode(data byte[]) string {
		let out = ""
		let i = 0
		for i < data.len() {
			let b = int(data[i])
			if b < 0x80 {
				out += string(char(b))
				i++
				continue
			}
			if b >= 0xa1 && b <= 0xdf {
				out += string(char(0xff61 + b - 0xa1))
				i++
				continue
			}
			let lead = -1
			switch {
				case b >= 0x81 && b <= 0x9f: lead = b - 0x81
				case b >= 0xe0 && b <= 0xef: lead = b - 0xe0 + 31
			}
			if lead < 0 || i + 1 >= data.len() {
				out += "�"
				i++
				continue
			}
			let t = int(data[i + 1])
			let trail = -1
			switch {
				case t >= 0x40 && t <= 0x7e: trail = t - 0x40
				case t >= 0x80 && t <= 0xfc: trail = t - 0x80 + 63
			}
			let cp = trail < 0 ?? (0, doubleByte[lead * 188 + trail])
			out += cp == 0 ?? ("�", string(char(cp)))
			i += 2
		}
		return out
	}
}
