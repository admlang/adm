partial module std.data.encoding.shiftjis {
	use std.testing

	check "ShiftJis" {
		@test()
		def TestRoundTrip() !none {
			let text = "ABC 点茗 ｱｲ ＱＲ"
			let bytes = try encode(text)
			assert decode(bytes) == text
			let dian = encode('点')
			fail "no code for 点" when dian is none
			assert dian == 0x935f
			let ming = encode('茗')
			fail "no code for 茗" when ming is none
			assert ming == 0xe4aa
			assert decode(byte[0x93, 0x5f, 0xe4, 0xaa]) == "点茗"
			assert decode(byte[0x81]) == "�"
			let failed = false
			encode("€") onerror (err error) {
				failed = true
				recover byte[]
			}
			assert failed
		}
	}
}
