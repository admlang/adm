partial module std.data.encoding {
	use (
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.io
	)

	// Qualified name of the `@toml` meta function, used to look up field options.
	internal const tomlAttr = "std.data.encoding.toml"

	// Produces a type's own TOML instead of the codec reflecting over it.
	interface TOMLEncoder {
		def toml() byte[]
	}

	// Reads a type's own TOML instead of the codec binding fields.
	interface TOMLDecoder {
		def toml(data byte[]) !none
	}

	// A TOML array: strings, integers, floats, booleans, tables or arrays, in
	// order. `TOMLTable.set` wraps a typed array into one; `TOMLTable.items`
	// hands the elements back.
	type TOMLArray {
		items any[]

		def new(items any[] = []) {
			self.items = items
		}

		// How many elements the array holds.
		def len() int {
			return items.len()
		}

		// Appends an element.
		def push(value any) {
			items.push(value)
		}
	}

	// A TOML table: keys in the order they were set, each holding a string,
	// int, float, bool, another table, or a `TOMLArray` of those. Dates
	// and times stay as their text. `TOML.decode` fills one, `TOML.encode`
	// renders one, and code that keeps a document rather than a struct edits
	// it through `set`, `get`, `table` and `remove`.
	//
	//Example:
	//```example
	//     let doc = new TOMLTable()
	//     try (new TOML()).decode(text, doc)
	//     let server = doc.table("server")
	//     if !(server is none) {
	//         let port = server.get("port")
	//     }
	//     doc.tableAt(["adm", "storage", "read"]).set("path", ["/tmp/**"])
	//     let out = string((new TOML()).encode(doc))
	//```
	type TOMLTable {
		internal order  string[]
		internal values map<string, any>

		def new() {
			order = []
			values = map<string, any>{}
		}

		// The keys in the order they were set.
		def keys() string[] {
			return order
		}

		// Whether the key is set.
		def has(key string) bool {
			return values.hasKey(key)
		}

		// The value under the key, or none.
		def get(key string) ?any {
			return none unless values.hasKey(key)
			return values[key]
		}

		// Sets the key; a new key goes last in the order. An array of strings,
		// integers, floats or booleans is kept as an `any[]`.
		def set(key string, value any) {
			order.push(key) unless values.hasKey(key)
			values[key] = normalized(value)
		}

		// An array of any element type as a TOMLArray; anything else as it is.
		internal def normalized(value any) any {
			match value {
				case TOMLArray:
					return value
				case any[]:
					let items any[] = value
					return new TOMLArray(items)
				case string[]:
					let texts string[] = value
					let out = new TOMLArray()
					for let item in texts {
						out.push(item)
					}
					return out
				case int[]:
					let numbers int[] = value
					let out = new TOMLArray()
					for let item in numbers {
						out.push(item)
					}
					return out
				case float[]:
					let numbers float[] = value
					let out = new TOMLArray()
					for let item in numbers {
						out.push(item)
					}
					return out
				case bool[]:
					let flags bool[] = value
					let out = new TOMLArray()
					for let item in flags {
						out.push(item)
					}
					return out
				case TOMLTable[]:
					let tables TOMLTable[] = value
					let out = new TOMLArray()
					for let item in tables {
						out.push(item)
					}
					return out
				default:
					return value
			}
		}

		// Drops the key and its value; the other keys keep their order.
		def remove(key string) {
			return unless values.hasKey(key)
			values.delete(key)
			let kept string[]
			for let k in order {
				kept.push(k) unless k == key
			}
			order = kept
		}

		// The sub-table under the key, or none when the key is absent or not a table.
		def table(key string) ?TOMLTable {
			return none unless values.hasKey(key)
			let v = values[key]
			match v {
				case TOMLTable:
					return v
				default:
					return none
			}
		}

		// The table at the path, creating the tables along it.
		def tableAt(path string[]) TOMLTable {
			let current = self
			for let key in path {
				let next = current.table(key)
				if next is none {
					let made = new TOMLTable()
					current.set(key, made)
					current = made
				} else {
					let existing TOMLTable = next
					current = existing
				}
			}
			return current
		}

		// The string under the key, or the fallback when absent or not a string.
		def string(key string, fallback string = "") string {
			return fallback unless values.hasKey(key)
			let v = values[key]
			match v {
				case string:
					return v
				default:
					return fallback
			}
		}

		// The integer under the key, or the fallback when absent or not an integer.
		def int(key string, fallback int = 0) int {
			return fallback unless values.hasKey(key)
			let v = values[key]
			match v {
				case int:
					return v
				default:
					return fallback
			}
		}

		// The float under the key (an integer counts), or the fallback.
		def float(key string, fallback float = 0.0) float {
			return fallback unless values.hasKey(key)
			let v = values[key]
			match v {
				case float:
					return v
				case int:
					let n int = v
					return float(n)
				default:
					return fallback
			}
		}

		// The boolean under the key, or the fallback when absent or not a boolean.
		def bool(key string, fallback bool = false) bool {
			return fallback unless values.hasKey(key)
			let v = values[key]
			match v {
				case bool:
					return v
				default:
					return fallback
			}
		}

		// The array's elements under the key; empty when absent or not an array.
		def items(key string) any[] {
			let out any[]
			return out unless values.hasKey(key)
			let v = values[key]
			match v {
				case TOMLArray:
					let list TOMLArray = v
					return list.items
				default:
					return out
			}
		}

		// The strings of the array under the key; other elements are skipped.
		def strings(key string) string[] {
			let out string[]
			for let item in items(key) {
				match item {
					case string:
						out.push(item)
					default:
				}
			}
			return out
		}

		// The tables of the array under the key (`[[key]]`); other elements are skipped.
		def tables(key string) TOMLTable[] {
			let out TOMLTable[]
			for let item in items(key) {
				match item {
					case TOMLTable:
						out.push(item)
					default:
				}
			}
			return out
		}

		// Whether the value under the key is a table.
		def isTable(key string) bool {
			return !(table(key) is none)
		}
	}

	// Encodes and decodes TOML (v1.0): tables, arrays of tables, dotted and
	// quoted keys, basic and literal strings (single and multi-line), integers
	// in every base, floats, booleans, arrays, inline tables and comments.
	// Dates and times are kept as text.
	//
	// Example:
	// ```example
	//     let t = new TOML()
	//     let text = string(t.encode(cfg))
	//     try t.decode(text, cfg)
	// ```
	//
	// A struct binds field by field like JSON and YAML: `@toml("name")`,
	// `@toml(omitempty: true)`, `@toml(ignore: true)`, nested structs as tables,
	// arrays of scalars. A `TOMLTable` target takes the whole document.
	type TOML {
		// Key naming for fields with no explicit `@toml("name")`.
		caseStyle CaseStyle = CaseStyle.AsIs

		// How many tables deep to go before stopping, in both directions.
		maxDepth int = 64

		// Writes a sub-table that holds only values as dotted keys in its
		// parent's block (`path.allow = [...]`) instead of under its own
		// `[parent.path]` header. Both read back the same.
		dottedKeys bool = false

		// Renders obj as TOML: a TOMLTable as it is, a TOMLEncoder through
		// itself, anything else field by field.
		def encode(obj any) byte[] {
			match obj {
				case TOMLEncoder:
					return obj.toml()
				case TOMLTable:
					return encodeTable(obj, [], 0).bytes()
				default:
			}
			return encodeTable(tableOf(obj, 0), [], 0).bytes()
		}

		// Writes obj as TOML to the writer. Fails when the writer does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// Fills target from TOML: a TOMLTable takes the document, a TOMLDecoder
		// reads it itself, anything else is bound field by field. Unknown keys
		// are ignored.
		//
		// Fails when the text is not TOML, or a value does not fit its field.
		def decode(input byte[], target any) !none {
			return try decode(string(input), target)
		}

		// Fills target from TOML text, the same way as from bytes.
		//
		// Fails when the text is not TOML, or a value does not fit its field.
		def decode(input string, target any) !none {
			match target {
				case TOMLDecoder:
					return try target.toml(input.bytes())
				case TOMLTable:
					let doc TOMLTable = target
					try parseInto(input, doc)
					return none
				default:
			}
			let doc = new TOMLTable()
			try parseInto(input, doc)
			try bindTable(doc, target, 0)
			return none
		}

		// Reads everything the reader yields and fills target from it as TOML.
		//
		// Fails when the reader does or the text does not decode.
		def decode(reader io.Reader, target any) !none {
			let chunk byte[]
			chunk.len(4096)
			let all byte[]
			for {
				let n = try reader.read(chunk)
				break when n <= 0
				all += chunk.slice(0, n)
			}
			return try decode(string(all), target)
		}

		// --- reading -------------------------------------------------------------

		// Parses the document into the table.
		//
		// Fails with the line of the first thing that is not TOML.
		internal def parseInto(text string, root TOMLTable) !none {
			let cur = new TOMLCursor(text)
			let current = root
			for {
				cur.skipBlank()
				break when cur.done()
				if cur.peek() == '[' {
					cur.bump()
					let arrayOfTables = cur.peek() == '['
					cur.bump() when arrayOfTables
					cur.skipSpaces()
					let path = try cur.readKey()
					cur.skipSpaces()
					fail "toml: line {cur.line}: expected `]` after the table name" unless cur.peek() == ']'
					cur.bump()
					if arrayOfTables {
						fail "toml: line {cur.line}: expected `]]` after the array table name" unless cur.peek() == ']'
						cur.bump()
					}
					try cur.endOfLine()
					current = try openTable(root, path, arrayOfTables, cur.line)
					continue
				}
				let path = try cur.readKey()
				cur.skipSpaces()
				fail "toml: line {cur.line}: expected `=` after the key" unless cur.peek() == '='
				cur.bump()
				cur.skipSpaces()
				let value = try cur.readValue(0, maxDepth)
				try cur.endOfLine()
				let target = current.tableAt(path[0:path.len() - 1])
				let last = path[path.len() - 1]
				fail "toml: line {cur.line}: key `{last}` is set twice" when target.has(last)
				target.set(last, value)
			}
			return none
		}

		// The table a `[a.b]` or `[[a.b]]` header names, made along the way;
		// an array-of-tables header appends a new table to the array.
		//
		// Fails when the path runs through a value that is not a table.
		internal def openTable(root TOMLTable, path string[], arrayOfTables bool, line int) !TOMLTable {
			let current = root
			for let (i, key) in path {
				let last = i == path.len() - 1
				if last && arrayOfTables {
					let existing = current.get(key)
					let list = new TOMLArray()
					if !(existing is none) {
						match existing {
							case TOMLArray:
								list = existing
							default:
								fail "toml: line {line}: `{key}` is not an array of tables"
						}
					}
					let made = new TOMLTable()
					list.push(made)
					current.set(key, list)
					return made
				}
				let existing = current.get(key)
				if existing is none {
					let made = new TOMLTable()
					current.set(key, made)
					current = made
					continue
				}
				match existing {
					case TOMLTable:
						let table TOMLTable = existing
						current = table
					case TOMLArray:
						// a path through an array of tables means its last element
						let list TOMLArray = existing
						let items = list.items
						fail "toml: line {line}: `{key}` is an empty array" when items.len() == 0
						let tail = items[items.len() - 1]
						match tail {
							case TOMLTable:
								let table TOMLTable = tail
								current = table
							default:
								fail "toml: line {line}: `{key}` is not a table"
						}
					default:
						fail "toml: line {line}: `{key}` is a value, not a table"
				}
			}
			return current
		}

		// --- writing -------------------------------------------------------------

		// Renders a table: its scalar and array values first, then each
		// sub-table under a `[path]` header and each array of tables under
		// `[[path]]` headers.
		internal def encodeTable(table TOMLTable, path string[], depth int) string {
			return encodeBody(table, path, depth, true)
		}

		// The table's lines; `header` says whether to write its own `[path]`
		// line (an array-of-tables element already has its `[[path]]`).
		internal def encodeBody(table TOMLTable, path string[], depth int, header bool = false) string {
			let out = ""
			let nested string[]
			let direct = false
			for let key in table.keys() {
				let value = table.get(key)
				continue when value is none
				let v any = value
				match v {
					case TOMLTable:
						if dottedKeys && isLeafTable(v) {
							let leaf TOMLTable = v
							for let inner in leaf.keys() {
								let innerValue = leaf.get(inner)
								continue when innerValue is none
								let iv any = innerValue
								out += tomlKey(key) + "." + tomlKey(inner) + " = " + encodeInline(iv) + "\n"
								direct = true
							}
							continue
						}
						nested.push(key)
						continue
					case TOMLArray:
						if isArrayOfTables(v) {
							nested.push(key)
							continue
						}
					default:
				}
				out += tomlKey(key) + " = " + encodeInline(v) + "\n"
				direct = true
			}
			// a table with nothing of its own is implied by its sub-tables' headers
			out = "[" + tomlPath(path) + "]\n" + out when header && path.len() > 0 && (direct || nested.len() == 0)
			return out when depth + 1 >= maxDepth
			for let key in nested {
				let value = table.get(key)
				continue when value is none
				let v any = value
				let sub = path + [key]
				match v {
					case TOMLTable:
						let child TOMLTable = v
						let text = encodeTable(child, sub, depth + 1)
						out += "\n" when out.len() > 0 && text.len() > 0
						out += text
					case TOMLArray:
						let list TOMLArray = v
						for let item in list.items {
							match item {
								case TOMLTable:
									let child TOMLTable = item
									out += "\n" when out.len() > 0
									out += "[[" + tomlPath(sub) + "]]\n"
									out += encodeBody(child, sub, depth + 1)
								default:
							}
						}
					default:
				}
			}
			return out
		}

		// A value on one line: scalar, array, or an inline table.
		internal def encodeInline(value any) string {
			match value {
				case string:
					let text string = value
					return tomlString(text)
				case bool:
					let b bool = value
					return b ?? ("true", "false")
				case int:
					let n int = value
					return n.str()
				case float:
					let f float = value
					return f.str()
				case TOMLTable:
					let table TOMLTable = value
					let parts string[]
					for let key in table.keys() {
						let inner = table.get(key)
						continue when inner is none
						let v any = inner
						parts.push(tomlKey(key) + " = " + encodeInline(v))
					}
					return "\{ " + parts.join(", ") + " }"
				case TOMLArray:
					let list TOMLArray = value
					let parts string[]
					for let item in list.items {
						parts.push(encodeInline(item))
					}
					return "[" + parts.join(", ") + "]"
				default:
					return tomlString("{value}")
			}
		}

		// --- struct binding --------------------------------------------------

		// Fills the struct's fields from the table: scalars, arrays of scalars,
		// nested structs from sub-tables. Unknown keys are ignored.
		//
		// Fails when a value does not fit its field.
		internal def bindTable(table TOMLTable, target any, depth int) !none {
			expects {
				assert depth < maxDepth onerror "toml: input nests deeper than {maxDepth} tables"
			}
			for let key in table.keys() {
				let f = fieldForKey(target, key, tomlAttr, caseStyle)
				continue when f is none
				let value = table.get(key)
				continue when value is none
				let v any = value
				match v {
					case TOMLTable:
						fail "toml: cannot read the table `{key}` into a scalar" when f.kind != FieldKind.Struct
						let nested = f.ensureValue()
						fail "toml: cannot read the table `{key}` into `{key}`" when nested is none
						let child TOMLTable = v
						try bindTable(child, nested, depth + 1)
					case TOMLArray:
						fail "toml: cannot read the array `{key}` into a scalar" when f.kind != FieldKind.Array
						let list TOMLArray = v
						let items = list.items
						f.setLen(items.len())
						let kind = f.elemKind
						for let (i, item) in items {
							setScalarText(f.at(i), kind, scalarOf(item))
						}
					default:
						fail "toml: cannot read `{key}` into a table" when f.kind == FieldKind.Struct
						fail "toml: cannot read `{key}` into an array" when f.kind == FieldKind.Array
						setScalarText(f, f.kind, scalarOf(v))
				}
			}
			return none
		}

		// The table for a struct's fields, following the `@toml` options.
		internal def tableOf(obj any, depth int) TOMLTable {
			let table = new TOMLTable()
			return table when depth >= maxDepth
			for let (_, f) in reflection.fields(obj) {
				continue when fieldFlag(f, tomlAttr, "ignore")
				continue when fieldFlag(f, tomlAttr, "omitempty") && fieldIsEmpty(f)
				let key = encodedKey(f, tomlAttr, caseStyle)
				if f.kind == FieldKind.Struct {
					let nested = f.value()
					continue when nested is none
					table.set(key, tableOf(nested, depth + 1))
					continue
				}
				if f.kind == FieldKind.Array {
					let list = new TOMLArray()
					let kind = f.elemKind
					let n = f.len()
					for let i = 0; i < n; i++ {
						pushScalar(list, f.at(i), kind)
					}
					table.set(key, list)
					continue
				}
				let one = new TOMLArray()
				pushScalar(one, f, f.kind)
				table.set(key, one.items[0])
			}
			return table
		}

		// Appends the field's value as the TOML value it encodes to.
		internal def pushScalar(list TOMLArray, f Field, kind FieldKind) {
			let text = scalarText(f, kind)
			if fieldFlag(f, tomlAttr, "asString") {
				list.push(text)
				return
			}
			if kind == FieldKind.Bool {
				let b bool = text == "true"
				list.push(b)
				return
			}
			if kind == FieldKind.Int || kind == FieldKind.Uint {
				let n int = parseInt<int>(text)
				list.push(n)
				return
			}
			if kind == FieldKind.Float {
				let x float = parseFloat<float>(text)
				list.push(x)
				return
			}
			list.push(text)
		}

		// A TOML value as the text setScalarText reads.
		internal def scalarOf(value any) string {
			match value {
				case string:
					let text string = value
					return text
				case bool:
					let b bool = value
					return b ?? ("true", "false")
				case int:
					let n int = value
					return n.str()
				case float:
					let x float = value
					return x.str()
				default:
					return "{value}"
			}
		}
	}

	// Whether the table holds values only: no sub-table, no array of tables.
	internal def isLeafTable(value any) bool {
		match value {
			case TOMLTable:
				let table TOMLTable = value
				return false when table.keys().len() == 0
				for let key in table.keys() {
					let inner = table.get(key)
					continue when inner is none
					let iv any = inner
					match iv {
						case TOMLTable:
							return false
						default:
					}
					return false when isArrayOfTables(iv)
				}
				return true
			default:
				return false
		}
	}

	// Whether every element is a table, so the array is written as `[[x]]` headers.
	internal def isArrayOfTables(value any) bool {
		match value {
			case TOMLArray:
				let list TOMLArray = value
				let items = list.items
				return false when items.len() == 0
				for let item in items {
					match item {
						case TOMLTable:
						default:
							return false
					}
				}
				return true
			default:
				return false
		}
	}

	// A key as TOML writes it: bare when it is letters, digits, `-` and `_`, else quoted.
	internal def tomlKey(key string) string {
		return tomlString(key) when key.len() == 0
		for let c in key {
			let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_'
			return tomlString(key) unless ok
		}
		return key
	}

	// A table header path: each segment a key, joined with dots.
	internal def tomlPath(path string[]) string {
		let parts string[]
		for let key in path {
			parts.push(tomlKey(key))
		}
		return parts.join(".")
	}

	// A basic string with its escapes.
	internal def tomlString(text string) string {
		let out = "\""
		for let c in text {
			if c == '"' {
				out += "\\\""
			} else if c == '\\' {
				out += "\\\\"
			} else if c == '\n' {
				out += "\\n"
			} else if c == '\r' {
				out += "\\r"
			} else if c == '\t' {
				out += "\\t"
			} else if int(c) < 0x20 || int(c) == 0x7F {
				out += "\\u" + int(c).hex(4)
			} else {
				out += string(c)
			}
		}
		return out + "\""
	}

	// Walks TOML text: keys, values, comments, with the line for errors.
	internal type TOMLCursor {
		src  string
		pos  int    = 0
		line int    = 1

		def new(text string) {
			self.src = text
		}

		def done() bool {
			return pos >= src.len()
		}

		// The character at the cursor, or NUL at the end.
		def peek() char {
			return char(0) when done()
			return src[pos]
		}

		def peekAt(offset int) char {
			return char(0) when pos + offset >= src.len()
			return src[pos + offset]
		}

		def bump() {
			line++ when !done() && src[pos] == '\n'
			pos++
		}

		// Skips spaces and tabs.
		def skipSpaces() {
			for !done() && (peek() == ' ' || peek() == '\t') {
				bump()
			}
		}

		// Skips whitespace, newlines and comments.
		def skipBlank() {
			for !done() {
				let c = peek()
				if c := ' ' || '\t' || '\n' || '\r' {
					bump()
				} else if c == '#' {
					skipComment()
				} else {
					return
				}
			}
		}

		def skipComment() {
			for !done() && peek() != '\n' {
				bump()
			}
		}

		// Expects nothing but a comment before the end of the line.
		//
		// Fails when something else follows.
		def endOfLine() !none {
			skipSpaces()
			skipComment() when peek() == '#'
			return none when done()
			bump() when peek() == '\r'
			fail "toml: line {line}: unexpected `{string(peek())}` after the value" unless peek() == '\n'
			bump()
			return none
		}

		// A dotted key: bare or quoted segments separated by dots.
		//
		// Fails when a segment is missing or a quoted one is unterminated.
		def readKey() !string[] {
			let path string[]
			for {
				skipSpaces()
				let c = peek()
				if c == '"' {
					path.push(try readBasicString())
				} else if c == '\'' {
					path.push(try readLiteralString())
				} else {
					let start = pos
					for !done() && isBareKeyChar(peek()) {
						bump()
					}
					fail "toml: line {line}: expected a key" when pos == start
					path.push(src[start:pos])
				}
				skipSpaces()
				if peek() == '.' {
					bump()
					continue
				}
				return path
			}
			return path
		}

		def isBareKeyChar(c char) bool {
			return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_'
		}

		// One value: string, number, boolean, date-time text, array or inline table.
		//
		// Fails when nothing valid starts here.
		def readValue(depth int, maxDepth int) !any {
			expects {
				assert depth < maxDepth onerror "toml: line {line}: input nests deeper than {maxDepth} levels"
			}
			let c = peek()
			return try readBasicString() when c == '"'
			return try readLiteralString() when c == '\''
			return try readArray(depth, maxDepth) when c == '['
			return try readInlineTable(depth, maxDepth) when c == '{'
			if c := 't' || 'f' {
				let word = readWord()
				return true when word == "true"
				return false when word == "false"
				fail "toml: line {line}: unknown value `{word}`"
			}
			return try readNumberOrDate()
		}

		def readWord() string {
			let start = pos
			for !done() && ((peek() >= 'a' && peek() <= 'z') || (peek() >= 'A' && peek() <= 'Z')) {
				bump()
			}
			return src[start:pos]
		}

		// A basic string, or a multi-line one when it opens with `"""`.
		//
		// Fails on an unterminated string or a bad escape.
		def readBasicString() !string {
			bump()
			if peek() == '"' && peekAt(1) == '"' {
				bump()
				bump()
				return try readMultilineBasic()
			}
			let out = ""
			for {
				fail "toml: line {line}: unterminated string" when done() || peek() == '\n'
				let c = peek()
				bump()
				return out when c == '"'
				if c == '\\' {
					out += try readEscape()
					continue
				}
				out += string(c)
			}
			return out
		}

		def readMultilineBasic() !string {
			// a newline right after the opening quotes is trimmed
			bump() when peek() == '\r'
			bump() when peek() == '\n'
			let out = ""
			for {
				fail "toml: line {line}: unterminated multi-line string" when done()
				if peek() == '"' && peekAt(1) == '"' && peekAt(2) == '"' {
					bump()
					bump()
					bump()
					// up to two more quotes belong to the content
					for peek() == '"' {
						out += "\""
						bump()
					}
					return out
				}
				let c = peek()
				bump()
				if c == '\\' {
					// a backslash before the line end joins lines, skipping whitespace
					if peek() == '\n' || peek() == '\r' || peek() == ' ' || peek() == '\t' {
						for !done() && (peek() == '\n' || peek() == '\r' || peek() == ' ' || peek() == '\t') {
							bump()
						}
						continue
					}
					out += try readEscape()
					continue
				}
				out += string(c)
			}
			return out
		}

		// The character an escape after a backslash stands for.
		//
		// Fails on an escape TOML does not define.
		def readEscape() !string {
			let c = peek()
			bump()
			return "\n" when c == 'n'
			return "\t" when c == 't'
			return "\r" when c == 'r'
			return "\"" when c == '"'
			return "\\" when c == '\\'
			return "\b" when c == 'b'
			return "\f" when c == 'f'
			if c := 'u' || 'U' {
				let digits = c == 'u' ?? (4, 8)
				let start = pos
				for let i = 0; i < digits; i++ {
					fail "toml: line {line}: bad unicode escape" unless isHexDigit(peek())
					bump()
				}
				return string(char(parseInt<int>(src[start:pos], 16)))
			}
			fail "toml: line {line}: unknown escape `\\{string(c)}`"
		}

		def isHexDigit(c char) bool {
			return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
		}

		// A literal string, or a multi-line one when it opens with `'''`.
		//
		// Fails when unterminated.
		def readLiteralString() !string {
			bump()
			if peek() == '\'' && peekAt(1) == '\'' {
				bump()
				bump()
				bump() when peek() == '\r'
				bump() when peek() == '\n'
				let start = pos
				for {
					fail "toml: line {line}: unterminated multi-line literal string" when done()
					if peek() == '\'' && peekAt(1) == '\'' && peekAt(2) == '\'' {
						let text = src[start:pos]
						bump()
						bump()
						bump()
						for peek() == '\'' {
							text += "'"
							bump()
						}
						return text
					}
					bump()
				}
			}
			let start = pos
			for {
				fail "toml: line {line}: unterminated literal string" when done() || peek() == '\n'
				if peek() == '\'' {
					let text = src[start:pos]
					bump()
					return text
				}
				bump()
			}
			return ""
		}

		// An array, possibly across lines with comments and a trailing comma.
		//
		// Fails when an element or the closing bracket is missing.
		def readArray(depth int, maxDepth int) !any {
			bump()
			let items = new TOMLArray()
			for {
				skipBlank()
				fail "toml: line {line}: unterminated array" when done()
				if peek() == ']' {
					bump()
					return items
				}
				items.push(try readValue(depth + 1, maxDepth))
				skipBlank()
				if peek() == ',' {
					bump()
					continue
				}
				fail "toml: line {line}: expected `,` or `]` in the array" unless peek() == ']'
			}
			return items
		}

		// An inline table `{ a = 1, b = "x" }`, on one line.
		//
		// Fails when a pair or the closing brace is missing.
		def readInlineTable(depth int, maxDepth int) !any {
			bump()
			let table = new TOMLTable()
			skipSpaces()
			if peek() == '}' {
				bump()
				return table
			}
			for {
				skipSpaces()
				let path = try readKey()
				skipSpaces()
				fail "toml: line {line}: expected `=` in the inline table" unless peek() == '='
				bump()
				skipSpaces()
				let value = try readValue(depth + 1, maxDepth)
				let target = table.tableAt(path[0:path.len() - 1])
				target.set(path[path.len() - 1], value)
				skipSpaces()
				if peek() == ',' {
					bump()
					continue
				}
				fail "toml: line {line}: expected `,` or `}` in the inline table" unless peek() == '}'
				bump()
				return table
			}
			return table
		}

		// A number, or a date-time kept as text.
		//
		// Fails when the text is neither.
		def readNumberOrDate() !any {
			let start = pos
			for !done() {
				let c = peek()
				let part = isHexDigit(c) || c == '+' || c == '-' || c == '_' || c == '.' || c == ':' || c == 'T' || c == 'Z' || c == 'x' || c == 'o' || c == 'i' || c == 'n'
				// a date's time part may follow after one space: 1979-05-27 07:32:00
				part = true when c == ' ' && pos - start == 10 && src[start + 4] == '-' && peekAt(1) >= '0' && peekAt(1) <= '9'
				break unless part
				bump()
			}
			let text = src[start:pos]
			fail "toml: line {line}: expected a value" when text.len() == 0
			return text when text.len() >= 8 && text[4] == '-' && isHexDigit(text[0])
			return text when text.len() >= 5 && text[2] == ':'
			let plain = text.replace("_", "")
			return 1.0 / 0.0 when plain := "inf" || "+inf"
			return -1.0 / 0.0 when plain == "-inf"
			return 0.0 / 0.0 when plain := "nan" || "+nan" || "-nan"
			let digits = plain
			digits = plain[1:] when plain.startsWith("+") || plain.startsWith("-")
			if digits.startsWith("0x") || digits.startsWith("0o") || digits.startsWith("0b") {
				let base = digits.startsWith("0x") ?? (16, digits.startsWith("0o") ?? (8, 2))
				fail "toml: line {line}: `{text}` is not a number" unless allDigits(digits[2:], base)
				return parseInt<int>(plain)
			}
			return parseInt<int>(plain) when allDigits(digits, 10)
			fail "toml: line {line}: `{text}` is not a number" unless isFloatText(digits)
			return parseFloat<float>(plain)
		}

		def allDigits(text string, base int) bool {
			return false when text.len() == 0
			for let c in text {
				let d = -1
				d = int(c) - int('0') when c >= '0' && c <= '9'
				d = int(c) - int('a') + 10 when c >= 'a' && c <= 'f'
				d = int(c) - int('A') + 10 when c >= 'A' && c <= 'F'
				return false when d < 0 || d >= base
			}
			return true
		}

		// Digits with one `.` and/or an exponent: 3.14, 1e10, 6.02e-23.
		def isFloatText(text string) bool {
			let mantissa = text
			let exponent = ""
			let e = text.indexOf("e")
			e = text.indexOf("E") when e < 0
			if e >= 0 {
				mantissa = text[0:e]
				exponent = text[e + 1:]
				exponent = exponent[1:] when exponent.startsWith("+") || exponent.startsWith("-")
				return false unless allDigits(exponent, 10)
			}
			let dot = mantissa.indexOf(".")
			return allDigits(mantissa, 10) when dot < 0
			return allDigits(mantissa[0:dot], 10) && allDigits(mantissa[dot + 1:], 10)
		}
	}

	// Controls how a field is encoded to and decoded from TOML.
	//
	//     struct Server {
	//         @toml("host_name")
	//         host string
	//         @toml(omitempty: true)
	//         note string
	//     }
	meta def toml(ctx FieldMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "toml", name, omitempty, ignore, asString, nullable)
	}

	// Controls how a property is encoded to and decoded from TOML. Takes the
	// same options as the field form above.
	meta def toml(ctx PropertyMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "toml", name, omitempty, ignore, asString, nullable)
	}
}
