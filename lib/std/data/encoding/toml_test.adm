partial module std.data.encoding {
	use std.testing

	struct TOMLServer {
		host string
		port int
		tls  bool
		tags string[]
	}

	struct TOMLConfig {
		title string
		server TOMLServer
		@toml("max_open")
		maxOpen int
		@toml(omitempty: true)
		note string
	}

	check "TOML" {
		@test()
		def decodesTablesKeysAndValues() !none {
			let text = "# comment\ntitle = \"Example\" # trailing\nnumbers = [1, 2, 3,]\nfloat = 6.02e-23\nhex = 0xff\nbig = 1_000\nflag = true\nwhen = 1979-05-27T07:32:00Z\ndotted.key = 'lit\"eral'\ninline = \{ a = 1, b.c = \"d\" }\nmulti = \"\"\"\nline one\nline two\"\"\"\n\n[\"OpenGLWindowApp\".adm.storage.read]\npath.allow = [\"/a\", \"/b\"]\n\n[[items]]\nname = \"x\"\n[[items]]\nname = \"y\"\n"
			let doc = new TOMLTable()
			try (new TOML()).decode(text, doc)
			assert doc.string("title") == "Example"
			assert doc.items("numbers").len() == 3
			assert doc.int("hex") == 255
			assert doc.int("big") == 1000
			assert doc.float("float") < 0.000001
			assert doc.bool("flag")
			assert doc.string("when") == "1979-05-27T07:32:00Z"
			assert doc.tableAt(["dotted"]).string("key") == "lit\"eral"
			assert doc.tableAt(["inline", "b"]).string("c") == "d"
			assert doc.tableAt(["inline"]).int("a") == 1
			assert doc.string("multi") == "line one\nline two"
			let read = doc.tableAt(["OpenGLWindowApp", "adm", "storage", "read"])
			assert read.tableAt(["path"]).strings("allow").join(",") == "/a,/b"
			let items = doc.tables("items")
			assert items.len() == 2
			assert items[1].string("name") == "y"
			assert doc.string("missing", "none") == "none"
			assert doc.table("missing") is none
			assert doc.keys()[0] == "title"
			return none
		}

		@test()
		def rejectsBrokenInput() {
			let codec = new TOML()
			for let bad in ["a = ", "a = \"open", "[table\n", "a = 1\na = 2\n", "a = 1 b = 2\n", "a = [1, 2\n", "x = tru\n"] {
				let failed = false
				codec.decode(bad, new TOMLTable()) onerror (err error) {
					failed = err.message.startsWith("toml: line ")
					recover none
				}
				assert failed
			}
		}

		@test()
		def encodesADocumentRoundTrip() !none {
			let doc = new TOMLTable()
			doc.set("title", "Ex \"quoted\"")
			doc.set("count", 3)
			doc.set("ratio", 0.5)
			doc.set("on", false)
			doc.set("list", ["a", "b"])
			let read = doc.tableAt(["OpenGL App", "adm", "storage", "read"])
			read.tableAt(["path"]).set("allow", ["/a"])
			read.set("maxOpen", 20)
			let first = new TOMLTable()
			first.set("name", "x")
			let second = new TOMLTable()
			second.set("name", "y")
			doc.set("rows", [first, second])
			let text = string((new TOML()).encode(doc))
			assert text.startsWith("title = \"Ex \\\"quoted\\\"\"\ncount = 3\nratio = 0.5\non = false\nlist = [\"a\", \"b\"]\n")
			assert text.contains("\n[\"OpenGL App\".adm.storage.read]\nmaxOpen = 20\n\n[\"OpenGL App\".adm.storage.read.path]\nallow = [\"/a\"]\n")
			assert text.contains("[[rows]]\nname = \"x\"\n\n[[rows]]\nname = \"y\"\n")
			let again = new TOMLTable()
			try (new TOML()).decode(text, again)
			assert string((new TOML()).encode(again)) == text
			return none
		}

		@test()
		def dottedKeysWriteLeafTablesInline() !none {
			let doc = new TOMLTable()
			let read = doc.tableAt(["App", "adm", "storage", "read"])
			read.tableAt(["path"]).set("allow", ["/a"])
			read.set("maxOpen", 20)
			let codec = new TOML()
			codec.dottedKeys = true
			let text = string(codec.encode(doc))
			assert text == "[App.adm.storage.read]\npath.allow = [\"/a\"]\nmaxOpen = 20\n"
			let again = new TOMLTable()
			try codec.decode(text, again)
			assert again.tableAt(["App", "adm", "storage", "read", "path"]).strings("allow").join(",") == "/a"
			assert string((new TOML()).encode(again)) == "[App.adm.storage.read]\nmaxOpen = 20\n\n[App.adm.storage.read.path]\nallow = [\"/a\"]\n"
			return none
		}

		@test()
		def removeAndSetKeepOrder() {
			let doc = new TOMLTable()
			doc.set("a", 1)
			doc.set("b", 2)
			doc.set("c", 3)
			doc.remove("b")
			doc.set("a", 10)
			doc.set("d", 4)
			assert doc.keys().join(",") == "a,c,d"
			assert !doc.has("b")
			assert doc.isTable("a") == false
			assert doc.get("b") is none
			assert !(doc.get("a") is none)
			let list = new TOMLArray()
			list.push("x")
			list.push(2)
			doc.set("list", list)
			assert doc.items("list").len() == 2 && list.len() == 2
			assert doc.strings("list").join(",") == "x"
		}

		@test()
		def bindsAStruct() !none {
			let cfg = TOMLConfig{}
			try (new TOML()).decode("title = \"T\"\nmax_open = 7\n[server]\nhost = \"h\"\nport = 8080\ntls = true\ntags = [\"a\", \"b\"]\n", cfg)
			assert cfg.title == "T"
			assert cfg.maxOpen == 7
			assert cfg.server.host == "h"
			assert cfg.server.port == 8080
			assert cfg.server.tls
			assert cfg.server.tags.join(",") == "a,b"
			let text = string((new TOML()).encode(cfg))
			assert text == "title = \"T\"\nmax_open = 7\n\n[server]\nhost = \"h\"\nport = 8080\ntls = true\ntags = [\"a\", \"b\"]\n"
			return none
		}

		// What TOML 1.0 forbids fails, and what it allows beside it does not.
		def fails(text string) bool {
			new TOML().decode(text, new TOMLTable()) onerror {
				return true
			}
			return false
		}

		@test()
		def tablesAreDefinedOnce() {
			for let text in ["[a]\n[a]\n", "[a.b]\n[a]\n[a]\n", "[[a]]\n[a]\n", "[a]\n[[a]]\n", "a = \{b = 1}\na.c = 2\n", "a = \{b = 1}\n[a.c]\n", "a = \{b = 1}\n[a]\n", "a.b = 1\n[a]\n", "a = [1]\n[[a]]\n", "a = [\{b = 1}]\n[[a]]\n", "a = [\{b = 1}]\n[a.c]\n", "a = 1\n[a.b]\n", "[a.b]\n[a]\nb.c = 1\n", "[x]\na.b = 1\n[x.a]\n", "a = \{b = 1, b = 2}\n", "a = \{b.c = 1, b = 2}\n", "a = \{b = \{c = 1}, b.d = 2}\n", "a.b = 1\na = 2\n", "a = 1\na = 2\n"] {
				assert fails(text)
			}
			for let text in ["[a.b]\n[a]\n", "[a]\n[a.b]\n", "[[a]]\n[[a]]\n", "[[a]]\n[a.b]\n[[a]]\n[a.b]\n", "[x]\na.b = 1\n[x.a.c]\n", "a.b = 1\na.c = 2\n", "[a.b.c]\n[a]\nb.x = 1\n", "a = \{b.c = 1, b.d = 2}\n", "[[a.b]]\n[a]\n"] {
				assert !fails(text)
			}
		}

		@test()
		def numbersAreStrict() !none {
			for let word in ["0123", "+0123", "00", "1__0", "_1", "1_", "1_.5", "1._5", "1.", ".5", "1e", "1e_5", "1e5_", "+0x1", "-0b1", "0x", "0x_1", "0xG", "0o8", "0b2", "9223372036854775808", "-9223372036854775809", "0x8000000000000000", "1.2.3", "infx", "Inf", "NaN", "1-2"] {
				assert fails("a = {word}\n")
			}
			let doc = new TOMLTable()
			try new TOML().decode("a = 1_000\nb = -0\nc = 0xDEAD_beef\nd = 0o17\ne = 0b11\nf = 1_0.5_0e+1_0\ng = 9223372036854775807\nh = -9223372036854775808\ni = +1\nj = 0.5\nk = 1e3\n", doc)
			assert doc.int("a") == 1000 && doc.int("b") == 0 && doc.int("c") == 0xDEADBEEF && doc.int("d") == 15 && doc.int("e") == 3
			assert doc.float("f") == 10.5e10 && doc.int("g") == 9223372036854775807 && doc.int("h") == -9223372036854775807 - 1 && doc.int("i") == 1
			assert doc.float("j") == 0.5 && doc.float("k") == 1000.0
		}

		@test()
		def datesAreReal() !none {
			for let word in ["1979-13-99", "1979-00-10", "1979-02-30", "1900-02-29", "1979-05-00", "1979-05-27T25:00:00", "1979-05-27T07:60:00", "1979-05-27T07:00:61", "1979-05-27T07:00", "1979-05-27T07:00:00+25:00", "1979-05-27T07:00:00+01", "1979-05-27T07:00:00.", "25:00:00", "07:00", "1979-5-27"] {
				assert fails("a = {word}\n")
			}
			let doc = new TOMLTable()
			try new TOML().decode("a = 1979-05-27\nb = 2000-02-29\nc = 1979-05-27T07:32:00Z\nd = 1979-05-27 07:32:00.5-07:00\ne = 07:32:00\nf = 1979-05-27t07:32:00z\ng = 2016-12-31T23:59:60Z\n", doc)
			assert doc.string("a") == "1979-05-27" && doc.string("b") == "2000-02-29" && doc.string("d") == "1979-05-27 07:32:00.5-07:00" && doc.string("e") == "07:32:00"
			assert doc.string("f") == "1979-05-27t07:32:00z" && doc.string("g") == "2016-12-31T23:59:60Z"
		}

		def failsOnBytes(raw byte[]) bool {
			new TOML().decode(raw, new TOMLTable()) onerror {
				return true
			}
			return false
		}

		@test()
		def documentsAreUTF8() {
			assert failsOnBytes(byte[97, 61, 49, 0])
			assert failsOnBytes(byte[97, 61, 34, 0xFF, 34, 10])
			assert !failsOnBytes("a = 1\n".bytes())
		}

		@test()
		def stringsAndCommentsHoldNoControlCharacters() {
			let control = string(char(1))
			for let text in ["a = \"x{control}\"\n", "a = 'x{control}'\n", "a = \"\"\"x{control}\"\"\"\n", "a = '''x{control}'''\n", "# c{control}\n", "a = 1 # c{control}\n", "a = [\n# c{control}\n1]\n"] {
				assert fails(text)
			}
			assert fails("a = \"\\uD800\"\n") && fails("a = \"\\U00110000\"\n")
			assert fails("a = \"\"\"x\"\"\"\"\"\"\n") && fails("a = '''x''''''\n")
			assert fails("a = \"\"\"x\\ y\"\"\"\n")
			assert !fails("a = \"\"\"x\"\"\"\"\"\n") && !fails("a = '''x'''''\n")
			assert !fails("a = \"\"\"x\\  \n  y\"\"\"\n") && !fails("a = \"x\ty\" # c\td\r\nb = 1\r\n")
		}
	}
}
