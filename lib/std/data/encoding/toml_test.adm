partial module std.data.encoding {
	use std.testing

	struct TOMLServer {
		host string
		port int
		tls  bool
		tags string[]
	}

	struct TOMLConfig {
		title string
		server TOMLServer
		@toml("max_open")
		maxOpen int
		@toml(omitempty: true)
		note string
	}

	check "TOML" {
		@test()
		def decodesTablesKeysAndValues() !none {
			let text = "# comment\ntitle = \"Example\" # trailing\nnumbers = [1, 2, 3,]\nfloat = 6.02e-23\nhex = 0xff\nbig = 1_000\nflag = true\nwhen = 1979-05-27T07:32:00Z\ndotted.key = 'lit\"eral'\ninline = \{ a = 1, b.c = \"d\" }\nmulti = \"\"\"\nline one\nline two\"\"\"\n\n[\"OpenGLWindowApp\".adm.storage.read]\npath.allow = [\"/a\", \"/b\"]\n\n[[items]]\nname = \"x\"\n[[items]]\nname = \"y\"\n"
			let doc = new TOMLTable()
			try (new TOML()).decode(text, doc)
			assert doc.string("title") == "Example"
			assert doc.items("numbers").len() == 3
			assert doc.int("hex") == 255
			assert doc.int("big") == 1000
			assert doc.float("float") < 0.000001
			assert doc.bool("flag")
			assert doc.string("when") == "1979-05-27T07:32:00Z"
			assert doc.tableAt(["dotted"]).string("key") == "lit\"eral"
			assert doc.tableAt(["inline", "b"]).string("c") == "d"
			assert doc.tableAt(["inline"]).int("a") == 1
			assert doc.string("multi") == "line one\nline two"
			let read = doc.tableAt(["OpenGLWindowApp", "adm", "storage", "read"])
			assert read.tableAt(["path"]).strings("allow").join(",") == "/a,/b"
			let items = doc.tables("items")
			assert items.len() == 2
			assert items[1].string("name") == "y"
			assert doc.string("missing", "none") == "none"
			assert doc.table("missing") is none
			assert doc.keys()[0] == "title"
			return none
		}

		@test()
		def rejectsBrokenInput() {
			let codec = new TOML()
			for let bad in ["a = ", "a = \"open", "[table\n", "a = 1\na = 2\n", "a = 1 b = 2\n", "a = [1, 2\n", "x = tru\n"] {
				let failed = false
				codec.decode(bad, new TOMLTable()) onerror (err error) {
					failed = err.message.startsWith("toml: line ")
					recover none
				}
				assert failed
			}
		}

		@test()
		def encodesADocumentRoundTrip() !none {
			let doc = new TOMLTable()
			doc.set("title", "Ex \"quoted\"")
			doc.set("count", 3)
			doc.set("ratio", 0.5)
			doc.set("on", false)
			doc.set("list", ["a", "b"])
			let read = doc.tableAt(["OpenGL App", "adm", "storage", "read"])
			read.tableAt(["path"]).set("allow", ["/a"])
			read.set("maxOpen", 20)
			let first = new TOMLTable()
			first.set("name", "x")
			let second = new TOMLTable()
			second.set("name", "y")
			doc.set("rows", [first, second])
			let text = string((new TOML()).encode(doc))
			assert text.startsWith("title = \"Ex \\\"quoted\\\"\"\ncount = 3\nratio = 0.5\non = false\nlist = [\"a\", \"b\"]\n")
			assert text.contains("\n[\"OpenGL App\".adm.storage.read]\nmaxOpen = 20\n\n[\"OpenGL App\".adm.storage.read.path]\nallow = [\"/a\"]\n")
			assert text.contains("[[rows]]\nname = \"x\"\n\n[[rows]]\nname = \"y\"\n")
			let again = new TOMLTable()
			try (new TOML()).decode(text, again)
			assert string((new TOML()).encode(again)) == text
			return none
		}

		@test()
		def dottedKeysWriteLeafTablesInline() !none {
			let doc = new TOMLTable()
			let read = doc.tableAt(["App", "adm", "storage", "read"])
			read.tableAt(["path"]).set("allow", ["/a"])
			read.set("maxOpen", 20)
			let codec = new TOML()
			codec.dottedKeys = true
			let text = string(codec.encode(doc))
			assert text == "[App.adm.storage.read]\npath.allow = [\"/a\"]\nmaxOpen = 20\n"
			let again = new TOMLTable()
			try codec.decode(text, again)
			assert again.tableAt(["App", "adm", "storage", "read", "path"]).strings("allow").join(",") == "/a"
			assert string((new TOML()).encode(again)) == "[App.adm.storage.read]\nmaxOpen = 20\n\n[App.adm.storage.read.path]\nallow = [\"/a\"]\n"
			return none
		}

		@test()
		def removeAndSetKeepOrder() {
			let doc = new TOMLTable()
			doc.set("a", 1)
			doc.set("b", 2)
			doc.set("c", 3)
			doc.remove("b")
			doc.set("a", 10)
			doc.set("d", 4)
			assert doc.keys().join(",") == "a,c,d"
			assert !doc.has("b")
			assert doc.isTable("a") == false
			assert doc.get("b") is none
			assert !(doc.get("a") is none)
			let list = new TOMLArray()
			list.push("x")
			list.push(2)
			doc.set("list", list)
			assert doc.items("list").len() == 2 && list.len() == 2
			assert doc.strings("list").join(",") == "x"
		}

		@test()
		def bindsAStruct() !none {
			let cfg = TOMLConfig{}
			try (new TOML()).decode("title = \"T\"\nmax_open = 7\n[server]\nhost = \"h\"\nport = 8080\ntls = true\ntags = [\"a\", \"b\"]\n", cfg)
			assert cfg.title == "T"
			assert cfg.maxOpen == 7
			assert cfg.server.host == "h"
			assert cfg.server.port == 8080
			assert cfg.server.tls
			assert cfg.server.tags.join(",") == "a,b"
			let text = string((new TOML()).encode(cfg))
			assert text == "title = \"T\"\nmax_open = 7\n\n[server]\nhost = \"h\"\nport = 8080\ntls = true\ntags = [\"a\", \"b\"]\n"
			return none
		}
	}
}
