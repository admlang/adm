partial module std.data.encoding {
	use (
		std.bytes
		std.data.encoding.json::*
		std.reflection
		std.reflection::(Field, FieldKind)
		std.io
	)

	// XMLEncoder is a value that produces its own XML.
	interface XMLEncoder {
		def xml() byte[]
	}

	// XMLDecoder is a value that reads itself from XML.
	interface XMLDecoder {
		def xml(data byte[]) !none
	}

	// XML is the XML codec: `encode` and `decode` map objects to and from
	// elements, `parse` gives the document as a tree of XMLNode, and isValid
	// checks well-formedness.
	//
	//     @xml(name = "book")
	//     struct Book {
	//         @xml(attribute = true)
	//         id      int
	//         title   string
	//         @xml(name = "author")
	//         authors string[]
	//     }
	//
	//     <book id="7"><title>Dune</title><author>Frank</author><author>Brian</author></book>
	type XML {
		indent       bool   = false
		indentString string = "\t"
		// Accept a document type declaration. False refuses any DOCTYPE, which
		// also rules out entity expansion: the setting for untrusted input
		// such as SAML messages.
		allowDoctype bool   = true
		// Keep comments and processing instructions inside the root element
		// as XMLNodeKind.Comment and ProcessingInstruction nodes.
		keepComments bool   = false
		// How deep objects may nest when encoding and decoding.
		maxDepth     int    = 64

		// encode renders obj as an XML document: one element named after the
		// object's type (or its `@xml(name)`), holding its fields.
		//
		//     a scalar field        <name>text</name>, or name="text" on the
		//                           element with @xml(attribute = true)
		//     an object field       a child element holding its own fields
		//     an array field        one child element per item, each named
		//                           after the field
		//     a map<string, V>      a child element holding one element per key
		//
		// `@xml` on a field sets its `name`, leaves it out when empty
		// (`omitempty`) or always (`ignore`). A none object field is left out,
		// an enum is written as its number, and objects nested deeper than
		// `maxDepth` are left out. With `indent` the elements go on lines of
		// their own.
		//
		// An object that is an XMLEncoder writes itself instead.
		def encode(obj any) byte[] {
			match obj {
				case XMLEncoder:
					return obj.xml()
				default:
			}
			let root = xmlElementOf(obj, xmlTypeName(obj), 0, maxDepth)
			let writer = new XMLWriter()
			writer.declaration()
			if indent {
				xmlWriteIndented(writer, root, "", indentString)
				writer.raw("\n")
			} else {
				writer.node(root)
			}
			return writer.bytes()
		}

		// encode writes obj as XML to the writer, as `encode(obj)` renders it.
		// Fails when the writer does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// Reports whether the text is well-formed XML at the level of tags: an
		// optional prolog, comments and CDATA sections, then one root element
		// whose start and end tags nest properly, with attribute values
		// quoted. Entities and namespaces are not checked.
		def isValid(input string) bool {
			let p = new XMLSyntax(input)
			return p.document()
		}

		// parse reads an XML document and returns its root element. Namespace
		// prefixes are resolved, the five predefined entities and character
		// references are decoded (named HTML entities too, which some XHTML
		// relies on), CDATA sections become text, and comments, processing
		// instructions and the document type declaration are skipped (see
		// allowDoctype and keepComments).
		// Fails when the document is not well-formed: no root element, an
		// unclosed or mismatched tag, an unquoted attribute value, or content
		// after the root element; and on a DOCTYPE when allowDoctype is false.
		def parse(data byte[]) !XMLNode {
			let parser = new XMLParser(data)
			parser.noDoctype = !allowDoctype
			parser.keepComments = keepComments
			return parser.document()
		}

		// parse reads an XML document from the text. Fails as parse(byte[])
		// does.
		def parse(text string) !XMLNode {
			return parse(text.bytes())
		}

		// parse reads an XML document from the reader. Fails when the reader
		// does, or as parse(byte[]) does.
		def parse(reader io.Reader) !XMLNode {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return parse(source.bytes())
		}

		// decode fills target from an XML document laid out as `encode`
		// writes one: the root element's attributes and child elements go to
		// the fields they name (by `@xml(name)`, else the field's name, then
		// without regard to case). The root's own name is not checked,
		// elements and attributes no field names are skipped, and namespaces
		// are ignored (local names are compared).
		// Fails when the document is not well-formed (see `parse`), an
		// element with child elements meets a scalar field, or objects nest
		// deeper than `maxDepth`.
		//
		// A target that is an XMLDecoder reads the document itself instead.
		def decode(input byte[], target any) !none {
			match target {
				case XMLDecoder:
					return try target.xml(input)
				default:
			}
			let root = try parse(input)
			return xmlBind(root, target, 0, maxDepth)
		}

		// decode fills target from XML read from the reader, as
		// `decode(byte[], target)` does. Fails when the reader does too.
		def decode(reader io.Reader, target any) !none {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes(), target)
		}
	}

	// xml sets how a field is encoded: the element or attribute name, omitempty
	// to skip it when empty, attribute to write it as an attribute, ignore to
	// leave it out.
	meta def xml(ctx reflection.FieldMetaContext, name string = "", omitempty bool = false, attribute bool = false, ignore bool = false) {}

	// xml sets how a property is encoded: the element or attribute name,
	// omitempty to skip it when empty, attribute to write it as an attribute,
	// ignore to leave it out.
	meta def xml(ctx reflection.PropertyMetaContext, name string = "", omitempty bool = false, attribute bool = false, ignore bool = false) {}

	// xml sets the element name a type is encoded as, or ignore to leave it out.
	meta def xml(ctx reflection.TypeMetaContext, name string = "", ignore bool = false) {}

	// Qualified name of the `@xml` meta function, used to look up options.
	internal const xmlAttr = "std.data.encoding.xml"

	// The element name of an object: its type's `@xml(name)`, else the type's
	// own name without its module.
	internal def xmlTypeName(obj any) string {
		let full = reflection.typeName(obj)
		for let (_, hit) in reflection.attrs(xml) {
			continue unless hit.node.qualifiedName == full
			let named = hit.attr.arguments.valueOf("name")
			continue when named is none
			let text = string(named).trim()
			text = text[1:text.len() - 1] when text.len() >= 2 && text.startsWith("\"") && text.endsWith("\"")
			return text unless text == ""
		}
		let parts = full.split(".")
		return parts[parts.len() - 1]
	}

	// Writes an element with each child element on a line of its own, one
	// `unit` deeper than its parent. An element holding text is written whole.
	internal def xmlWriteIndented(writer XMLWriter, n XMLNode, pad string, unit string) {
		if n.kind != XMLNodeKind.Element || n.elements().len() == 0 {
			writer.node(n)
			return
		}
		writer.start(n.name)
		for let (_, attr) in n.attributes {
			writer.attribute(attr.name, attr.value)
		}
		for let (_, child) in n.children {
			continue unless child.kind == XMLNodeKind.Element
			writer.raw("\n" + pad + unit)
			xmlWriteIndented(writer, child, pad + unit, unit)
		}
		writer.raw("\n" + pad)
		writer.end()
	}

	// An object as an element of the given name.
	internal def xmlElementOf(obj any, name string, depth int, maxDepth int) XMLNode {
		let node = new XMLNode(name)
		for let (_, f) in reflection.fields(obj) {
			continue when fieldFlag(f, xmlAttr, "ignore")
			continue when fieldFlag(f, xmlAttr, "omitempty") && fieldIsEmpty(f)
			let key = encodedKey(f, xmlAttr, CaseStyle.AsIs)
			let kind = f.kind
			if kind == FieldKind.Array {
				let itemKind = f.elemKind
				for let i = 0; i < f.len(); i++ {
					xmlAddValue(node, key, f.at(i), itemKind, depth, maxDepth)
				}
				continue
			}
			if kind == FieldKind.Map {
				let valueKind = f.elemKind
				let holder = new XMLNode(key)
				for let (_, k) in f.keys() {
					xmlAddValue(holder, k, f.entry(k), valueKind, depth, maxDepth)
				}
				node.add(holder)
				continue
			}
			if fieldFlag(f, xmlAttr, "attribute") {
				let held = kind == FieldKind.Optional ?? (f.elemKind, kind)
				if xmlIsScalar(held) {
					node.set(key, xmlScalarText(f, held)) unless kind == FieldKind.Optional && f.value() is none
					continue
				}
			}
			xmlAddValue(node, key, f, kind, depth, maxDepth)
		}
		return node
	}

	// Adds one value under the name: a scalar as text, an object as its
	// fields. A none object, a kind XML has no form for and an object past
	// the depth limit add nothing.
	internal def xmlAddValue(parent XMLNode, name string, f Field, kind FieldKind, depth int, maxDepth int) {
		if kind == FieldKind.Optional {
			return when f.value() is none
			kind = f.elemKind
		}
		if xmlIsScalar(kind) {
			let child = new XMLNode(name)
			child.add(xmlScalarText(f, kind))
			parent.add(child)
			return
		}
		return unless kind == FieldKind.Struct || kind == FieldKind.Iface
		let nested = f.value()
		return when nested is none || depth + 1 >= maxDepth
		parent.add(xmlElementOf(nested, name, depth + 1, maxDepth))
	}

	internal def xmlIsScalar(kind FieldKind) bool {
		return kind := FieldKind.Bool || FieldKind.Int || FieldKind.Uint || FieldKind.Float || FieldKind.String || FieldKind.Enum
	}

	internal def xmlScalarText(f Field, kind FieldKind) string {
		return f.asInt().str() when kind == FieldKind.Enum
		return scalarText(f, kind)
	}

	internal def xmlSetScalar(f Field, kind FieldKind, text string) {
		if kind == FieldKind.Enum {
			f.setInt(parseInt<int>(text.trim()))
			return
		}
		setScalarText(f, kind, kind == FieldKind.String ?? (text, text.trim()))
	}

	// Fills target's fields from an element's attributes and child elements.
	internal def xmlBind(node XMLNode, target any, depth int, maxDepth int) !none {
		expects {
			assert depth < maxDepth onerror fail "xml: input nests deeper than {maxDepth} objects"
		}
		for let (_, a) in node.attributes {
			let f = fieldForKey(target, a.localName, xmlAttr, CaseStyle.AsIs)
			continue when f is none
			let held = f.kind == FieldKind.Optional ?? (f.elemKind, f.kind)
			xmlSetScalar(f, held, a.value) when xmlIsScalar(held)
		}
		// How many items each array field has taken so far.
		let filled = map<string, int>{}
		for let (_, child) in node.children {
			continue unless child.kind == XMLNodeKind.Element
			let f = fieldForKey(target, child.localName, xmlAttr, CaseStyle.AsIs)
			continue when f is none
			let kind = f.kind
			if kind == FieldKind.Array {
				let at = filled.get(f.name)
				let index = 0
				index = at unless at is none
				filled[f.name] = index + 1
				f.setLen(index + 1)
				try xmlBindValue(child, f.at(index), f.elemKind, depth, maxDepth)
				continue
			}
			if kind == FieldKind.Map {
				f.clear()
				for let (_, item) in child.children {
					continue unless item.kind == XMLNodeKind.Element
					try xmlBindValue(item, f.entry(item.localName), f.elemKind, depth, maxDepth)
				}
				continue
			}
			try xmlBindValue(child, f, kind, depth, maxDepth)
		}
		return none
	}

	// Reads one element into a field, an array item or a map entry.
	internal def xmlBindValue(node XMLNode, f Field, kind FieldKind, depth int, maxDepth int) !none {
		kind = f.elemKind when kind == FieldKind.Optional
		if xmlIsScalar(kind) {
			fail "xml: <{node.name}> holds elements where `{f.name}` takes a value" when node.elements().len() > 0
			xmlSetScalar(f, kind, node.text())
			return none
		}
		return none unless kind == FieldKind.Struct || kind == FieldKind.Iface
		let nested = f.ensureValue()
		return none when nested is none
		return xmlBind(node, nested, depth + 1, maxDepth)
	}

	// A minimal XML well-formedness recogniser (tags only).
	internal type XMLSyntax {
		text string
		pos  int

		def new(text string) {
			self.text = text
			self.pos = 0
		}

		// A space past the end: no value, number or name starts with one, so
		// every caller that reads past the end stops.
		def peek() char {
			return ' ' when pos >= text.len()
			return text[pos]
		}

		def startsWith(prefix string) bool {
			return pos + prefix.len() <= text.len() && text[pos:pos + prefix.len()] == prefix
		}

		def skipSpace() {
			for pos < text.len() && (text[pos] == ' ' || text[pos] == '\t' || text[pos] == '\n' || text[pos] == '\r') {
				pos += 1
			}
		}

		// Skips `<?...?>`, `<!--...-->`, `<![CDATA[...]]>` and `<!DOCTYPE ...>`;
		// reports whether one was consumed, false (without moving) when the
		// text there is not one, and sets `bad` when one is unterminated.
		def skipMisc() bool {
			for let (_, pair) in [("<?", "?>"), ("<!--", "-->"), ("<![CDATA[", "]]>")] {
				let (open, close) = pair
				if startsWith(open) {
					let end = text.indexOf(close, pos + open.len())
					if end < 0 {
						bad = true
						return false
					}
					pos = end + close.len()
					return true
				}
			}
			if startsWith("<!") {
				let end = text.indexOf(">", pos)
				if end < 0 {
					bad = true
					return false
				}
				pos = end + 1
				return true
			}
			return false
		}

		bad bool

		def document() bool {
			skipSpace()
			for skipMisc() {
				skipSpace()
			}
			return false when bad
			return false unless peek() == '<' && element()
			skipSpace()
			for skipMisc() {
				skipSpace()
			}
			return !bad && pos >= text.len()
		}

		def nameChar(c char, first bool) bool {
			return true when (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == ':' || c > char(127)
			return !first && ((c >= '0' && c <= '9') || c == '-' || c == '.')
		}

		def name() string {
			let start = pos
			return "" unless pos < text.len() && nameChar(text[pos], true)
			pos += 1
			for pos < text.len() && nameChar(text[pos], false) {
				pos += 1
			}
			return text[start:pos]
		}

		// Parses `<name attr="v" ...>` content `</name>` or `<name .../>`.
		def element() bool {
			return false unless peek() == '<'
			pos += 1
			let tag = name()
			return false when tag == ""
			for {
				skipSpace()
				if startsWith("/>") {
					pos += 2
					return true
				}
				if peek() == '>' {
					pos += 1
					break
				}
				return false when name() == ""
				skipSpace()
				return false unless peek() == '='
				pos += 1
				skipSpace()
				let quote = peek()
				return false unless quote := '"' || '\''
				let end = pos + 1
				for end < text.len() && text[end] != quote {
					end += 1
				}
				return false when end >= text.len()
				pos = end + 1
			}
			for {
				return false when pos >= text.len()
				if startsWith("</") {
					pos += 2
					return false unless name() == tag
					skipSpace()
					return false unless peek() == '>'
					pos += 1
					return true
				}
				if peek() == '<' {
					if skipMisc() {
						continue
					}
					return false when bad
					return false unless element()
					continue
				}
				pos += 1
			}
			return false
		}
	}
}
