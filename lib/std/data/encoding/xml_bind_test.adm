partial module std.data.encoding {
	use std.testing

	internal struct XmlAuthor {
		name string
		@xml(attribute = true)
		born int
	}

	internal enum XmlBinding {
		Paper,
		Hard,
	}

	@xml(name = "book")
	internal struct XmlBook {
		@xml(attribute = true)
		id int
		title string
		@xml(name = "author")
		authors XmlAuthor[]
		@xml(name = "tag")
		tags string[]
		price float
		inPrint bool
		binding XmlBinding
		prices map<string, float>
		editor ?XmlAuthor
		@xml(omitempty = true)
		note string
		@xml(ignore = true)
		internal shelf string
	}

	internal struct XmlPlain {
		name string
	}

	check "XML objects" {
		def sampleBook() XmlBook {
			return XmlBook{
				id:      7,
				title:   "Fish & <chips>",
				authors: [XmlAuthor{name:"Frank", born:1920}, XmlAuthor{name:"Brian", born:1947}],
				tags:    ["sci-fi", "classic"],
				price:   9.5,
				inPrint: true,
				binding: XmlBinding.Hard,
				prices:  {"eur": 9.5, "usd": 11.0},
				editor:  none,
				note:    "",
				shelf:   "A3",
			}
		}

		@test()
		def TestEncode() {
			let text = string(new XML().encode(sampleBook()))
			let want = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + "<book id=\"7\"><title>Fish &amp; &lt;chips&gt;</title>" + "<author born=\"1920\"><name>Frank</name></author><author born=\"1947\"><name>Brian</name></author>" + "<tag>sci-fi</tag><tag>classic</tag><price>9.5</price><inPrint>true</inPrint><binding>1</binding>" + "<prices><eur>9.5</eur><usd>11</usd></prices></book>"
			assert text == want
			assert string(new XML().encode(XmlPlain{name: "x"})).endsWith("<XmlPlain><name>x</name></XmlPlain>")
		}

		@test()
		def TestEncodeIndented() {
			let codec = new XML()
			codec.indent = true
			codec.indentString = "  "
			let text = string(codec.encode(XmlBook{id: 1, title: "T", authors: [XmlAuthor{name:"A", born:2}], tags: [], prices: {}, editor: none}))
			let want = string[
				"<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
				"<book id=\"1\">",
				"  <title>T</title>",
				"  <author born=\"2\">",
				"    <name>A</name>",
				"  </author>",
				"  <price>0</price>",
				"  <inPrint>false</inPrint>",
				"  <binding>0</binding>",
				"  <prices/>",
				"</book>",
				"",
			]
			assert text == want.join("\n")
		}

		@test()
		def TestRoundTrip() !none {
			let codec = new XML()
			let book = sampleBook()
			book.editor = XmlAuthor{name: "Ed", born: 1960}
			let back = XmlBook{shelf: "kept"}
			try codec.decode(codec.encode(book), back)
			assert back.id == 7 && back.title == "Fish & <chips>"
			assert back.authors.len() == 2 && back.authors[1].name == "Brian" && back.authors[1].born == 1947
			assert back.tags.join(",") == "sci-fi,classic"
			assert back.price == 9.5 && back.inPrint && back.binding == XmlBinding.Hard
			assert back.prices.len() == 2 && back.prices["usd"] == 11.0
			let editor = back.editor
			fail "the editor was not read" when editor is none
			assert editor.name == "Ed" && editor.born == 1960
			assert back.shelf == "kept" && back.note == ""
			return none
		}

		@test()
		def TestDecodeForeignDocuments() !none {
			let codec = new XML()
			let text = "<?xml version=\"1.0\"?>\n<!-- a catalogue entry -->\n<b:Book xmlns:b=\"urn:books\" ID=\"12\" lang=\"en\">\n  <b:title>  Spaces kept  </b:title>\n  <unknown><deep/></unknown>\n  <b:tag>one</b:tag>\n  <b:price> 4.25 </b:price>\n  <b:tag><![CDATA[two & three]]></b:tag>\n  <b:inPrint>true</b:inPrint>\n</b:Book>"
			let book = XmlBook{}
			try codec.decode(text.bytes(), book)
			assert book.id == 12 && book.title == "  Spaces kept  "
			assert book.tags.len() == 2 && book.tags[1] == "two & three"
			assert book.price == 4.25 && book.inPrint && book.authors.len() == 0

			assert codec.decode("<book><title><b>bold</b></title></book>".bytes(), XmlBook{}) is error
			assert codec.decode("<book><title>open".bytes(), XmlBook{}) is error
			return none
		}
	}
}
