partial module std.data.encoding {
	use std.data.encoding.c14n::*

	// C14N is an XML canonicalization method: Canonical XML 1.0 and 1.1,
	// and Exclusive XML Canonicalization 1.0, each with or without comments.
	enum C14N {
		Inclusive10,
		Inclusive10Comments,
		Inclusive11,
		Inclusive11Comments,
		Exclusive,
		ExclusiveComments,
	}

	// canonicalize returns the canonical form of an element and everything
	// below it, as XML-DSig signs and digests it: UTF-8, attributes sorted,
	// namespace declarations reduced, empty elements written as start and
	// end tags, characters escaped one way. With `within`, the element is a
	// subset of that document: it takes the namespace context of its
	// ancestors there (and, for the inclusive methods, their `xml:lang`,
	// `xml:space` and, for 1.0, `xml:base`; 1.1 joins `xml:base` values).
	// inclusivePrefixes are the prefixes the exclusive methods treat
	// inclusively ("#default" for the default namespace). Comments and
	// processing instructions appear only when the tree kept them (the
	// codec's keepComments) and the method includes comments.
	//
	// ```
	// let bytes = encoding.canonicalize(assertion, C14N.Exclusive, within = document)
	// ```
	def canonicalize(node XMLNode, method C14N = C14N.Exclusive, inclusivePrefixes string[] = [], within ?XMLNode = none) byte[] {
		return canonicalBytes(node, method, inclusivePrefixes, within, def (n XMLNode) bool {
			return false
		})
	}
}

internal partial module std.data.encoding.c14n {
	use (
		std.data.encoding::*
		std.net.url
	)

	// canonicalBytes canonicalizes a node, leaving out every element skip
	// accepts (the enveloped-signature transform uses it).
	def canonicalBytes(node XMLNode, method C14N, inclusivePrefixes string[], within ?XMLNode, skip def (XMLNode) bool) byte[] {
		let exclusive = method := C14N.Exclusive || C14N.ExclusiveComments
		let comments = method := C14N.Inclusive10Comments || C14N.Inclusive11Comments || C14N.ExclusiveComments
		let v11 = method := C14N.Inclusive11 || C14N.Inclusive11Comments
		let ancestors XMLNode[] = []
		if !(within is none) {
			let path XMLNode[] = []
			if findPath(within, node, path) {
				ancestors = path
			}
		}
		// The namespace context and xml:* attributes of the ancestors.
		let inScope map<string, string>
		let inherited map<string, XMLAttribute>
		let bases string[] = []
		for let a in ancestors {
			for let attr in a.attributes {
				if isNamespaceDeclaration(attr) {
					inScope.set(declaredPrefix(attr), attr.value)
				} else if attr.namespace == xmlNamespace {
					if attr.localName == "base" {
						bases.push(attr.value)
					} else if attr.localName != "id" || !v11 {
						inherited.set(attr.localName, attr)
					}
				}
			}
		}
		let w = new CanonicalWriter()
		w.exclusive = exclusive
		w.comments = comments
		w.v11 = v11
		w.inclusive = inclusivePrefixes
		w.skip = skip
		let apexExtras XMLAttribute[] = []
		if !exclusive {
			for let name in ["lang", "space"] {
				let attr = inherited.get(name)
				apexExtras.push(attr) unless attr is none || !(node.attribute(name, xmlNamespace) is none)
			}
			if bases.len() > 0 && node.attribute("base", xmlNamespace) is none {
				let base = v11 ?? (joinBases(bases), bases[bases.len() - 1])
				apexExtras.push(XMLAttribute{name: "xml:base", prefix: "xml", localName: "base", namespace: xmlNamespace, value: base}) when base != ""
			}
		}
		w.element(node, inScope, new map<string, string>(), apexExtras)
		return w.out
	}

	// findPath fills path with the ancestors of target below root (root
	// first) and reports whether target is in the tree.
	def findPath(root XMLNode, target XMLNode, path XMLNode[]) bool {
		return true when sameNode(root, target)
		for let child in root.children {
			continue unless child.kind == XMLNodeKind.Element
			path.push(root)
			return true when findPath(child, target, path)
			path.pop()
		}
		return false
	}

	// sameNode reports whether two values are the same node of a tree: `==`
	// on reference objects compares identity.
	def sameNode(a XMLNode, b XMLNode) bool {
		return a == b
	}

	// The namespace of the `xml` prefix.
	const xmlNamespace = "http://www.w3.org/XML/1998/namespace"

	def isNamespaceDeclaration(attr XMLAttribute) bool {
		return attr.name == "xmlns" || attr.prefix == "xmlns"
	}

	// declaredPrefix is the prefix a namespace declaration binds; "" for the
	// default namespace.
	def declaredPrefix(attr XMLAttribute) string {
		return attr.name == "xmlns" ?? ("", attr.localName)
	}

	// joinBases resolves the ancestors' xml:base values, outermost first,
	// into one reference (Canonical XML 1.1 §2.4).
	def joinBases(bases string[]) string {
		let current = ""
		for let b in bases {
			if current == "" {
				current = b
				continue
			}
			let base = url.parse(current) onerror recover new url.URL()
			let ref = url.parse(b) onerror recover new url.URL()
			current = base.isAbs() ?? (base.resolve(ref).str(), joinRelative(current, b))
		}
		return current
	}

	// joinRelative joins two relative references: the second replaces the
	// first's last segment unless it is absolute-path or absolute.
	def joinRelative(base string, ref string) string {
		return ref when ref.startsWith("/") || ref.contains("://")
		let slash = -1
		for let (i, ch) in base {
			slash = i when ch == '/'
		}
		return slash < 0 ?? (ref, base[0:slash + 1] + ref)
	}

	// CanonicalWriter writes canonical XML.
	type CanonicalWriter {
		out       byte[]   = []
		exclusive bool     = false
		comments  bool     = false
		v11       bool     = false
		inclusive string[] = []
		skip      def (XMLNode) bool

		def new() {
			skip = def (n XMLNode) bool {
				return false
			}
		}

		// element writes one element. inScope is the namespace context of
		// its parent; rendered what the nearest output ancestor declared.
		def element(n XMLNode, parentScope map<string, string>, parentRendered map<string, string>, extras XMLAttribute[]) {
			return when skip(n)
			let scope = parentScope.clone()
			for let attr in n.attributes {
				scope.set(declaredPrefix(attr), attr.value) when isNamespaceDeclaration(attr)
			}
			let rendered = parentRendered.clone()
			let decls string[] = []
			let prefixes string[] = []
			if exclusive {
				let used string[] = [n.prefix]
				for let attr in n.attributes {
					used.push(attr.prefix) when !isNamespaceDeclaration(attr) && attr.prefix != "" && attr.prefix != "xml" && !(attr.prefix in used)
				}
				for let p in inclusive {
					let key = p == "#default" ?? ("", p)
					used.push(key) when scope.hasKey(key) && !(key in used)
				}
				prefixes = used
			} else {
				prefixes = scope.keys()
				prefixes.push("") unless "" in prefixes
			}
			prefixes.sort((a, b string) => a < b)
			for let p in prefixes {
				continue when p == "xml"
				let declared = scope.get(p)
				let uri = declared is none ?? ("", declared)
				let shown = rendered.get(p)
				let before = shown is none ?? ("", shown)
				if p == "" {
					// xmlns="" undoes a default namespace an output ancestor set.
					continue when uri == before
					continue when uri == "" && shown is none
				} else {
					continue when uri == "" || (!(shown is none) && before == uri)
				}
				rendered.set(p, uri)
				decls.push(p == "" ?? ("xmlns=\"" + escapeAttribute(uri) + "\"", "xmlns:" + p + "=\"" + escapeAttribute(uri) + "\""))
			}
			let attrs XMLAttribute[] = []
			for let attr in n.attributes {
				attrs.push(attr) unless isNamespaceDeclaration(attr)
			}
			for let attr in extras {
				attrs.push(attr)
			}
			attrs.sort((a, b XMLAttribute) => a.namespace < b.namespace || (a.namespace == b.namespace && a.localName < b.localName))
			put("<" + n.name)
			for let d in decls {
				put(" " + d)
			}
			for let attr in attrs {
				put(" " + attr.name + "=\"" + escapeAttribute(attr.value) + "\"")
			}
			put(">")
			for let child in n.children {
				match child.kind {
					case XMLNodeKind.Element:
						element(child, scope, rendered, [])
					case XMLNodeKind.Text:
						put(escapeText(child.content))
					case XMLNodeKind.Comment:
						put("<!--" + child.content + "-->") when comments
					default:
						put("<?" + child.name + (child.content == "" ?? ("", " " + child.content)) + "?>")
				}
			}
			put("</" + n.name + ">")
		}

		def put(text string) {
			out += text.bytes()
		}
	}

	// escapeText escapes character data as Canonical XML §2.3 says.
	def escapeText(text string) string {
		return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\r", "&#xD;")
	}

	// escapeAttribute escapes an attribute value as Canonical XML §2.3 says.
	def escapeAttribute(text string) string {
		return text.replace("&", "&amp;").replace("<", "&lt;").replace("\"", "&quot;").replace("\t", "&#x9;").replace("\n", "&#xA;").replace("\r", "&#xD;")
	}
}
