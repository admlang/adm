partial module std.data.encoding {
	use std.testing

	check "Canonical XML" {
		internal const c14nDoc_namespaces = "<doc>\n   <e1   />\n   <e2   ></e2>\n   <e3    name = \"elem3\"   id=\"elem3\"    />\n   <e4    name=\"elem4\"   id=\"elem4\"    ></e4>\n   <e5 a:attr=\"out\" b:attr=\"sorted\" attr2=\"all\" attr=\"I'm\"\n       xmlns:b=\"http://www.ietf.org\"\n       xmlns:a=\"http://www.w3.org\"\n       xmlns=\"http://example.org\"/>\n   <e6 xmlns=\"\" xmlns:a=\"http://www.w3.org\">\n       <e7 xmlns=\"http://www.ietf.org\">\n           <e8 xmlns=\"\" xmlns:a=\"http://www.w3.org\">\n               <e9 xmlns=\"\" xmlns:a=\"http://www.ietf.org\"/>\n           </e8>\n       </e7>\n   </e6>\n</doc>"
		internal const c14nOut_namespaces_incl10 = "<doc>\n   <e1></e1>\n   <e2></e2>\n   <e3 id=\"elem3\" name=\"elem3\"></e3>\n   <e4 id=\"elem4\" name=\"elem4\"></e4>\n   <e5 xmlns=\"http://example.org\" xmlns:a=\"http://www.w3.org\" xmlns:b=\"http://www.ietf.org\" attr=\"I'm\" attr2=\"all\" b:attr=\"sorted\" a:attr=\"out\"></e5>\n   <e6 xmlns:a=\"http://www.w3.org\">\n       <e7 xmlns=\"http://www.ietf.org\">\n           <e8 xmlns=\"\">\n               <e9 xmlns:a=\"http://www.ietf.org\"></e9>\n           </e8>\n       </e7>\n   </e6>\n</doc>"
		internal const c14nOut_namespaces_incl11 = "<doc>\n   <e1></e1>\n   <e2></e2>\n   <e3 id=\"elem3\" name=\"elem3\"></e3>\n   <e4 id=\"elem4\" name=\"elem4\"></e4>\n   <e5 xmlns=\"http://example.org\" xmlns:a=\"http://www.w3.org\" xmlns:b=\"http://www.ietf.org\" attr=\"I'm\" attr2=\"all\" b:attr=\"sorted\" a:attr=\"out\"></e5>\n   <e6 xmlns:a=\"http://www.w3.org\">\n       <e7 xmlns=\"http://www.ietf.org\">\n           <e8 xmlns=\"\">\n               <e9 xmlns:a=\"http://www.ietf.org\"></e9>\n           </e8>\n       </e7>\n   </e6>\n</doc>"
		internal const c14nOut_namespaces_excl = "<doc>\n   <e1></e1>\n   <e2></e2>\n   <e3 id=\"elem3\" name=\"elem3\"></e3>\n   <e4 id=\"elem4\" name=\"elem4\"></e4>\n   <e5 xmlns=\"http://example.org\" xmlns:a=\"http://www.w3.org\" xmlns:b=\"http://www.ietf.org\" attr=\"I'm\" attr2=\"all\" b:attr=\"sorted\" a:attr=\"out\"></e5>\n   <e6>\n       <e7 xmlns=\"http://www.ietf.org\">\n           <e8 xmlns=\"\">\n               <e9></e9>\n           </e8>\n       </e7>\n   </e6>\n</doc>"
		internal const c14nDoc_whitespace = "<doc>\n   <clean>   </clean>\n   <dirty>   A   B   </dirty>\n   <mixed>\n      A\n      <clean>   </clean>\n      B\n      <dirty>   A   B   </dirty>\n      C\n   </mixed>\n</doc>"
		internal const c14nOut_whitespace_incl10 = "<doc>\n   <clean>   </clean>\n   <dirty>   A   B   </dirty>\n   <mixed>\n      A\n      <clean>   </clean>\n      B\n      <dirty>   A   B   </dirty>\n      C\n   </mixed>\n</doc>"
		internal const c14nOut_whitespace_incl11 = "<doc>\n   <clean>   </clean>\n   <dirty>   A   B   </dirty>\n   <mixed>\n      A\n      <clean>   </clean>\n      B\n      <dirty>   A   B   </dirty>\n      C\n   </mixed>\n</doc>"
		internal const c14nOut_whitespace_excl = "<doc>\n   <clean>   </clean>\n   <dirty>   A   B   </dirty>\n   <mixed>\n      A\n      <clean>   </clean>\n      B\n      <dirty>   A   B   </dirty>\n      C\n   </mixed>\n</doc>"
		internal const c14nDoc_characters = "<doc>\n   <text>First line&#x0d;&#10;Second line</text>\n   <value>&#x32;</value>\n   <compute><![CDATA[value>\"0\" && value<\"10\" ?\"valid\":\"error\"]]></compute>\n   <compute expr='value>\"0\" &amp;&amp; value&lt;\"10\" ?\"valid\":\"error\"'>valid</compute>\n   <norm attr=' &apos;   &#x20;&#13;&#xa;&#9;   &apos; '/>\n   <quote q=\"a&quot;b\" />\n</doc>"
		internal const c14nOut_characters_incl10 = "<doc>\n   <text>First line&#xD;\nSecond line</text>\n   <value>2</value>\n   <compute>value&gt;\"0\" &amp;&amp; value&lt;\"10\" ?\"valid\":\"error\"</compute>\n   <compute expr=\"value>&quot;0&quot; &amp;&amp; value&lt;&quot;10&quot; ?&quot;valid&quot;:&quot;error&quot;\">valid</compute>\n   <norm attr=\" '    &#xD;&#xA;&#x9;   ' \"></norm>\n   <quote q=\"a&quot;b\"></quote>\n</doc>"
		internal const c14nOut_characters_incl11 = "<doc>\n   <text>First line&#xD;\nSecond line</text>\n   <value>2</value>\n   <compute>value&gt;\"0\" &amp;&amp; value&lt;\"10\" ?\"valid\":\"error\"</compute>\n   <compute expr=\"value>&quot;0&quot; &amp;&amp; value&lt;&quot;10&quot; ?&quot;valid&quot;:&quot;error&quot;\">valid</compute>\n   <norm attr=\" '    &#xD;&#xA;&#x9;   ' \"></norm>\n   <quote q=\"a&quot;b\"></quote>\n</doc>"
		internal const c14nOut_characters_excl = "<doc>\n   <text>First line&#xD;\nSecond line</text>\n   <value>2</value>\n   <compute>value&gt;\"0\" &amp;&amp; value&lt;\"10\" ?\"valid\":\"error\"</compute>\n   <compute expr=\"value>&quot;0&quot; &amp;&amp; value&lt;&quot;10&quot; ?&quot;valid&quot;:&quot;error&quot;\">valid</compute>\n   <norm attr=\" '    &#xD;&#xA;&#x9;   ' \"></norm>\n   <quote q=\"a&quot;b\"></quote>\n</doc>"
		internal const c14nDoc_exclusive = "<n0:local xmlns:n0=\"foo:bar\" xmlns:n3=\"ftp://example.org\" xmlns=\"urn:default\"><n1:elem2 xmlns:n1=\"http://example.net\" xml:lang=\"en\"><n3:stuff xmlns:n3=\"ftp://example.org\"/><plain a=\"1\"/><n1:x xmlns=\"\">t</n1:x></n1:elem2></n0:local>"
		internal const c14nOut_exclusive_incl10 = "<n0:local xmlns=\"urn:default\" xmlns:n0=\"foo:bar\" xmlns:n3=\"ftp://example.org\"><n1:elem2 xmlns:n1=\"http://example.net\" xml:lang=\"en\"><n3:stuff></n3:stuff><plain a=\"1\"></plain><n1:x xmlns=\"\">t</n1:x></n1:elem2></n0:local>"
		internal const c14nOut_exclusive_incl11 = "<n0:local xmlns=\"urn:default\" xmlns:n0=\"foo:bar\" xmlns:n3=\"ftp://example.org\"><n1:elem2 xmlns:n1=\"http://example.net\" xml:lang=\"en\"><n3:stuff></n3:stuff><plain a=\"1\"></plain><n1:x xmlns=\"\">t</n1:x></n1:elem2></n0:local>"
		internal const c14nOut_exclusive_excl = "<n0:local xmlns:n0=\"foo:bar\"><n1:elem2 xmlns:n1=\"http://example.net\" xml:lang=\"en\"><n3:stuff xmlns:n3=\"ftp://example.org\"></n3:stuff><plain xmlns=\"urn:default\" a=\"1\"></plain><n1:x>t</n1:x></n1:elem2></n0:local>"
		internal const c14nDoc_comments = "<root xmlns:p=\"urn:p\"><!-- a comment --><p:x>1</p:x><?target some data?><y/><!--two--></root>"
		internal const c14nOut_comments_incl10 = "<root xmlns:p=\"urn:p\"><!-- a comment --><p:x>1</p:x><?target some data?><y></y><!--two--></root>"
		internal const c14nOut_comments_incl11 = "<root xmlns:p=\"urn:p\"><!-- a comment --><p:x>1</p:x><?target some data?><y></y><!--two--></root>"
		internal const c14nOut_comments_excl = "<root><!-- a comment --><p:x xmlns:p=\"urn:p\">1</p:x><?target some data?><y></y><!--two--></root>"
		internal const c14nDoc_lang = "<root xml:lang=\"fr\" xml:space=\"preserve\"><a xmlns:z=\"urn:z\"><b z:k=\"v\">text</b></a></root>"
		internal const c14nOut_lang_incl10 = "<root xml:lang=\"fr\" xml:space=\"preserve\"><a xmlns:z=\"urn:z\"><b z:k=\"v\">text</b></a></root>"
		internal const c14nOut_lang_incl11 = "<root xml:lang=\"fr\" xml:space=\"preserve\"><a xmlns:z=\"urn:z\"><b z:k=\"v\">text</b></a></root>"
		internal const c14nOut_lang_excl = "<root xml:lang=\"fr\" xml:space=\"preserve\"><a><b xmlns:z=\"urn:z\" z:k=\"v\">text</b></a></root>"

		internal def withoutComments(text string) string {
			let out = ""
			let rest = text
			for {
				let at = rest.indexOf("<!--")
				if at < 0 {
					out += rest
					break
				}
				out += rest[0:at]
				rest = rest[rest.indexOf("-->") + 3:]
			}
			return out
		}

		@test()
		def TestCanonicalizeAgainstLibxml2() !none {
			// Expected forms from xmllint --c14n, --c14n11 and --exc-c14n
			// (libxml2), which include comments.
			let codec = new XML()
			codec.keepComments = true
			let cases = [
				[c14nDoc_namespaces, c14nOut_namespaces_incl10, c14nOut_namespaces_incl11, c14nOut_namespaces_excl],
				[c14nDoc_whitespace, c14nOut_whitespace_incl10, c14nOut_whitespace_incl11, c14nOut_whitespace_excl],
				[c14nDoc_characters, c14nOut_characters_incl10, c14nOut_characters_incl11, c14nOut_characters_excl],
				[c14nDoc_exclusive, c14nOut_exclusive_incl10, c14nOut_exclusive_incl11, c14nOut_exclusive_excl],
				[c14nDoc_comments, c14nOut_comments_incl10, c14nOut_comments_incl11, c14nOut_comments_excl],
				[c14nDoc_lang, c14nOut_lang_incl10, c14nOut_lang_incl11, c14nOut_lang_excl]
			]
			for let c in cases {
				let root = try codec.parse(c[0])
				assert string(canonicalize(root, C14N.Inclusive10Comments)) == c[1]
				assert string(canonicalize(root, C14N.Inclusive11Comments)) == c[2]
				assert string(canonicalize(root, C14N.ExclusiveComments)) == c[3]
				assert string(canonicalize(root, C14N.Inclusive10)) == withoutComments(c[1])
				assert string(canonicalize(root, C14N.Exclusive)) == withoutComments(c[3])
				// A tree parsed without comments canonicalizes the same as the
				// comment-free methods.
				// (It drops processing instructions too.)
				let plain = try new XML().parse(c[0])
				assert string(canonicalize(plain, C14N.ExclusiveComments)) == withoutComments(c[3]).replace("<?target some data?>", "")
			}
		}

		@test()
		def TestCanonicalizeSubtree() !none {
			// A subset takes its ancestors' namespace context: inclusively all of
			// it, exclusively only what the subtree uses.
			let root = try new XML().parse(c14nDoc_exclusive)
			let elem2 = root.children[0]
			let inclusive = string(canonicalize(elem2, C14N.Inclusive10, within = root))
			assert inclusive == "<n1:elem2 xmlns=\"urn:default\" xmlns:n0=\"foo:bar\" xmlns:n1=\"http://example.net\" xmlns:n3=\"ftp://example.org\" xml:lang=\"en\"><n3:stuff></n3:stuff><plain a=\"1\"></plain><n1:x xmlns=\"\">t</n1:x></n1:elem2>"
			let exclusive = string(canonicalize(elem2, C14N.Exclusive, within = root))
			assert exclusive == "<n1:elem2 xmlns:n1=\"http://example.net\" xml:lang=\"en\"><n3:stuff xmlns:n3=\"ftp://example.org\"></n3:stuff><plain xmlns=\"urn:default\" a=\"1\"></plain><n1:x>t</n1:x></n1:elem2>"
			// InclusiveNamespaces: n0 is declared although nothing uses it.
			let listed = string(canonicalize(elem2, C14N.Exclusive, ["n0"], root))
			assert listed.startsWith("<n1:elem2 xmlns:n0=\"foo:bar\" xmlns:n1=\"http://example.net\" xml:lang=\"en\">")
			// Without the document, the subtree stands alone.
			let alone = string(canonicalize(elem2, C14N.Inclusive10))
			assert alone.startsWith("<n1:elem2 xmlns:n1=\"http://example.net\" xml:lang=\"en\">")
			// xml:lang and xml:space are inherited by the inclusive methods only.
			let lang = try new XML().parse(c14nDoc_lang)
			let b = lang.children[0].children[0]
			assert string(canonicalize(b, C14N.Inclusive10, within = lang)) == "<b xmlns:z=\"urn:z\" xml:lang=\"fr\" xml:space=\"preserve\" z:k=\"v\">text</b>"
			assert string(canonicalize(b, C14N.Exclusive, within = lang)) == "<b xmlns:z=\"urn:z\" z:k=\"v\">text</b>"
		}

		@test()
		def TestParserOptions() !none {
			let strict = new XML()
			strict.allowDoctype = false
			assert strict.parse("<!DOCTYPE a [<!ENTITY x \"y\">]><a>&x;</a>") is error
			assert !(strict.parse("<a/>") is error)
			let keeping = new XML()
			keeping.keepComments = true
			let doc = try keeping.parse("<a><!--c--><?pi\tdata here?>t</a>")
			assert doc.children.len() == 3
			assert doc.children[0].kind == XMLNodeKind.Comment && doc.children[0].content == "c"
			assert doc.children[1].kind == XMLNodeKind.ProcessingInstruction && doc.children[1].name == "pi" && doc.children[1].content == "data here"
			assert doc.text() == "t"
			assert doc.str() == "<a><!--c--><?pi data here?>t</a>"
		}
	}
}
