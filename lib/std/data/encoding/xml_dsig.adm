partial module std.data.encoding {
	use (
		std.crypto::(PublicKey, PrivateKey, RSAPublicKey, RSAPrivateKey, ECDSAPublicKey, ECDSAPrivateKey, Ed25519PublicKey, Ed25519PrivateKey, Ed448PublicKey, Ed448PrivateKey, coordinateSize, constantTimeEqual)
		std.crypto.hash::(Hash, digest, hmac, hashSize)
		std.errors
		std.data.encoding.c14n::*
		std.data.encoding.dsig::*
	)

	// The XML-DSig namespace.
	const xmlDsigNamespace = "http://www.w3.org/2000/09/xmldsig#"

	// SignatureMethod is an XML-DSig signature algorithm; its value is the
	// algorithm URI.
	enum SignatureMethod {
		// RSASSA-PKCS1-v1_5. SHA-1 verifies only, and only with allowSha1.
		RsaSha1 = "http://www.w3.org/2000/09/xmldsig#rsa-sha1",
		RsaSha256 = "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256",
		RsaSha384 = "http://www.w3.org/2001/04/xmldsig-more#rsa-sha384",
		RsaSha512 = "http://www.w3.org/2001/04/xmldsig-more#rsa-sha512",
		// RSASSA-PSS with MGF1 and a salt as long as the digest (RFC 6931).
		RsaPssSha256 = "http://www.w3.org/2007/05/xmldsig-more#sha256-rsa-MGF1",
		RsaPssSha384 = "http://www.w3.org/2007/05/xmldsig-more#sha384-rsa-MGF1",
		RsaPssSha512 = "http://www.w3.org/2007/05/xmldsig-more#sha512-rsa-MGF1",
		// ECDSA, the value r || s (RFC 6931 §3.3).
		EcdsaSha1 = "http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha1",
		EcdsaSha256 = "http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha256",
		EcdsaSha384 = "http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha384",
		EcdsaSha512 = "http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha512",
		// EdDSA (RFC 9231).
		Ed25519 = "http://www.w3.org/2021/04/xmldsig-more#eddsa-ed25519",
		Ed448 = "http://www.w3.org/2021/04/xmldsig-more#eddsa-ed448",
		HmacSha1 = "http://www.w3.org/2000/09/xmldsig#hmac-sha1",
		HmacSha224 = "http://www.w3.org/2001/04/xmldsig-more#hmac-sha224",
		HmacSha256 = "http://www.w3.org/2001/04/xmldsig-more#hmac-sha256",
		HmacSha384 = "http://www.w3.org/2001/04/xmldsig-more#hmac-sha384",
		HmacSha512 = "http://www.w3.org/2001/04/xmldsig-more#hmac-sha512",
	}

	// DigestMethod is an XML-DSig digest algorithm; its value is the URI.
	enum DigestMethod {
		// Verification only, and only with allowSha1.
		Sha1 = "http://www.w3.org/2000/09/xmldsig#sha1",
		Sha224 = "http://www.w3.org/2001/04/xmldsig-more#sha224",
		Sha256 = "http://www.w3.org/2001/04/xmlenc#sha256",
		Sha384 = "http://www.w3.org/2001/04/xmldsig-more#sha384",
		Sha512 = "http://www.w3.org/2001/04/xmlenc#sha512",
		Sha3_224 = "http://www.w3.org/2007/05/xmldsig-more#sha3-224",
		Sha3_256 = "http://www.w3.org/2007/05/xmldsig-more#sha3-256",
		Sha3_384 = "http://www.w3.org/2007/05/xmldsig-more#sha3-384",
		Sha3_512 = "http://www.w3.org/2007/05/xmldsig-more#sha3-512",
		Ripemd160 = "http://www.w3.org/2001/04/xmlenc#ripemd160",
	}

	// XMLSignatureErrorKind says why an XML signature operation failed.
	enum XMLSignatureErrorKind {
		// The Signature element is not well formed.
		Malformed,
		// An algorithm, transform or reference form that is not implemented
		// (XPath, XSLT, xpointer) or not allowed (SHA-1 without allowSha1).
		Unsupported,
		// A reference resolves to no element or to more than one.
		BadReference,
		// A reference's digest does not match.
		BadDigest,
		// No given key verifies the signature.
		BadSignature,
		// The key cannot be used with the signature method.
		KeyMismatch,
	}

	// XMLSignatureError is the payload of XML-DSig failures.
	struct XMLSignatureError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    XMLSignatureErrorKind
	}

	// XMLReference is one Reference of a signature: what it points at, how
	// it is transformed, and the digest it must have.
	struct XMLReference {
		uri               string
		// The transform URIs, in order.
		transforms        string[]
		// The InclusiveNamespaces PrefixList of an exclusive canonicalization
		// transform.
		inclusivePrefixes string[]
		digestMethod      DigestMethod
		digestValue       byte[]
	}

	// XMLSignature is a parsed `ds:Signature` (XML-DSig 1.1). KeyInfo is
	// reported, never trusted: verify takes the keys to check with.
	type XMLSignature {
		element           XMLNode
		signedInfo        XMLNode
		canonicalization  C14N
		inclusivePrefixes string[]
		method            SignatureMethod
		references        XMLReference[]  = []
		value             byte[]          = []
		// HMACOutputLength in bits, when the signature truncates its HMAC.
		hmacOutputLength  ?int
		keyName           ?string
		// X509Data certificates, DER, as KeyInfo carries them.
		certificates      byte[][]        = []

		def new(element XMLNode, signedInfo XMLNode, canonicalization C14N, method SignatureMethod) {
			self.element = element
			self.signedInfo = signedInfo
			self.canonicalization = canonicalization
			self.method = method
		}

		// verify checks the signature against the document it belongs to:
		// SignedInfo signed by one of keys with the signature method, then
		// every reference resolved (one element with that ID among
		// idAttributes, or the document for URI ""), transformed and
		// digested. Returns the referenced elements, in reference order:
		// act only on these, never on a fresh lookup in the document. Fails
		// with Unsupported (SHA-1 without allowSha1, XPath or XSLT
		// transforms, xpointer references), BadSignature, KeyMismatch,
		// BadReference or BadDigest.
		def verify(document XMLNode, keys PublicKey[], allowSha1 bool = false, idAttributes string[] = ["ID", "Id", "id"]) !XMLNode[] {
			try checkAlgorithms(self, allowSha1)
			let data = canonicalBytes(signedInfo, canonicalization, inclusivePrefixes, document, n => false)
			let matched = false
			let fitting = false
			for let key in keys {
				let fits = keyFits(method, key)
				continue unless fits
				fitting = true
				if verifyValue(method, key, data, value) {
					matched = true
					break
				}
			}
			fail dsigError(XMLSignatureErrorKind.KeyMismatch, "no key fits {method.value}") unless fitting || keys.len() == 0
			fail dsigError(XMLSignatureErrorKind.BadSignature, "the signature does not verify") unless matched
			return try checkReferences(self, document, idAttributes)
		}

		// verify checks an HMAC signature with a shared secret; see the key
		// overload. HMACOutputLength must be at least 80 bits and half the
		// digest (the CVE-2009-0217 rule). Fails as the key overload does.
		def verify(document XMLNode, secret byte[], allowSha1 bool = false, idAttributes string[] = ["ID", "Id", "id"]) !XMLNode[] {
			try checkAlgorithms(self, allowSha1)
			fail dsigError(XMLSignatureErrorKind.KeyMismatch, "{method.value} is not an HMAC method") unless isHmacMethod(method)
			let data = canonicalBytes(signedInfo, canonicalization, inclusivePrefixes, document, n => false)
			let full = hmac(methodHash(method), secret, data)
			let bits = hmacOutputLength
			let length = bits is none ?? (full.len(), bits / 8)
			if !(bits is none) {
				fail dsigError(XMLSignatureErrorKind.BadSignature, "HMACOutputLength {bits} is too short") when bits < 80 || bits < full.len() * 4 || bits % 8 != 0 || bits > full.len() * 8
			}
			fail dsigError(XMLSignatureErrorKind.BadSignature, "the signature does not verify") unless value.len() == length && constantTimeEqual(full[0:length], value)
			return try checkReferences(self, document, idAttributes)
		}
	}

	// parseXMLSignature reads a `ds:Signature` element. Fails with
	// Malformed for a missing or misplaced part, Unsupported for an
	// unknown algorithm.
	def parseXMLSignature(element XMLNode) !XMLSignature {
		fail dsigError(XMLSignatureErrorKind.Malformed, "not a ds:Signature") unless element.localName == "Signature" && element.namespace == xmlDsigNamespace
		let signedInfo = element.child("SignedInfo", xmlDsigNamespace)
		fail dsigError(XMLSignatureErrorKind.Malformed, "no SignedInfo") when signedInfo is none
		let c14nElement = signedInfo.child("CanonicalizationMethod", xmlDsigNamespace)
		fail dsigError(XMLSignatureErrorKind.Malformed, "no CanonicalizationMethod") when c14nElement is none
		let c14nUri = c14nElement.attribute("Algorithm")
		let c14n = c14nOf(c14nUri is none ?? ("", c14nUri))
		fail dsigError(XMLSignatureErrorKind.Unsupported, "unsupported canonicalization {c14nUri is none ?? ("", c14nUri)}") when c14n is none
		let methodElement = signedInfo.child("SignatureMethod", xmlDsigNamespace)
		fail dsigError(XMLSignatureErrorKind.Malformed, "no SignatureMethod") when methodElement is none
		let methodUri = methodElement.attribute("Algorithm")
		let method = signatureMethodOf(methodUri is none ?? ("", methodUri))
		fail dsigError(XMLSignatureErrorKind.Unsupported, "unsupported signature method {methodUri is none ?? ("", methodUri)}") when method is none
		let sig = new XMLSignature(element, signedInfo, c14n, method)
		sig.inclusivePrefixes = inclusivePrefixesOf(c14nElement)
		let outputLength = methodElement.child("HMACOutputLength", xmlDsigNamespace)
		if !(outputLength is none) {
			let digits = outputLength.text().trim()
			fail dsigError(XMLSignatureErrorKind.Malformed, "HMACOutputLength is not a number") unless /^[0-9]+$/.test(digits)
			sig.hmacOutputLength = parseInt<int>(digits)
		}
		for let ref in signedInfo.elements("Reference", xmlDsigNamespace) {
			sig.references.push(try referenceOf(ref))
		}
		fail dsigError(XMLSignatureErrorKind.Malformed, "SignedInfo has no Reference") when sig.references.len() == 0
		let valueElement = element.child("SignatureValue", xmlDsigNamespace)
		fail dsigError(XMLSignatureErrorKind.Malformed, "no SignatureValue") when valueElement is none
		sig.value = try decodeBase64Text(valueElement.text(), "SignatureValue")
		let keyInfo = element.child("KeyInfo", xmlDsigNamespace)
		if !(keyInfo is none) {
			let name = keyInfo.child("KeyName", xmlDsigNamespace)
			sig.keyName = name.text().trim() unless name is none
			for let data in keyInfo.elements("X509Data", xmlDsigNamespace) {
				for let cert in data.elements("X509Certificate", xmlDsigNamespace) {
					sig.certificates.push(try decodeBase64Text(cert.text(), "X509Certificate"))
				}
			}
		}
		return sig
	}

	// signXML signs an element in place with an enveloped signature
	// (XML-DSig §6.6.4): a Reference to its ID (the idAttribute value it
	// must have), the enveloped-signature and exclusive canonicalization
	// transforms, exclusive canonicalization of SignedInfo, and KeyInfo
	// with the certificate when one is given. The Signature goes after the
	// first child element named `after` (SAML puts it after Issuer), else
	// last. `document` is the tree the element is in, for its namespace
	// context. Returns the Signature element. Fails with BadReference when
	// the element has no ID, Malformed when `after` names no child element,
	// KeyMismatch when the key does not fit the method, Unsupported for
	// SHA-1.
	def signXML(element XMLNode, key PrivateKey, method SignatureMethod = SignatureMethod.RsaSha256, digestMethod DigestMethod = DigestMethod.Sha256, certificate ?byte[] = none, idAttribute string = "ID", after string = "", document ?XMLNode = none) !XMLNode {
		fail dsigError(XMLSignatureErrorKind.Unsupported, "SHA-1 is not used for new signatures") when (method := SignatureMethod.RsaSha1 || SignatureMethod.EcdsaSha1 || SignatureMethod.HmacSha1) || digestMethod == DigestMethod.Sha1
		fail dsigError(XMLSignatureErrorKind.KeyMismatch, "the key does not fit {method.value}") unless privateKeyFits(method, key)
		let signature = try prepareSignature(element, method, digestMethod, idAttribute, after, document)
		let root = document is none ?? (element, document)
		let signedInfo = signature.child("SignedInfo", xmlDsigNamespace)
		let data = canonicalBytes(signedInfo is none ?? (signature, signedInfo), C14N.Exclusive, [], root, n => false)
		let raw = try signValue(method, key, data)
		try finishSignature(signature, raw, certificate)
		return signature
	}

	// signXML signs an element with an HMAC over a shared secret; see the
	// key overload. Fails as it does.
	def signXML(element XMLNode, secret byte[], method SignatureMethod = SignatureMethod.HmacSha256, digestMethod DigestMethod = DigestMethod.Sha256, idAttribute string = "ID", after string = "", document ?XMLNode = none) !XMLNode {
		fail dsigError(XMLSignatureErrorKind.KeyMismatch, "{method.value} is not an HMAC method") unless isHmacMethod(method)
		fail dsigError(XMLSignatureErrorKind.Unsupported, "SHA-1 is not used for new signatures") when method == SignatureMethod.HmacSha1 || digestMethod == DigestMethod.Sha1
		let signature = try prepareSignature(element, method, digestMethod, idAttribute, after, document)
		let root = document is none ?? (element, document)
		let signedInfo = signature.child("SignedInfo", xmlDsigNamespace)
		let data = canonicalBytes(signedInfo is none ?? (signature, signedInfo), C14N.Exclusive, [], root, n => false)
		try finishSignature(signature, hmac(methodHash(method), secret, data), none)
		return signature
	}
}

internal partial module std.data.encoding.dsig {
	use (
		std.crypto::(PublicKey, PrivateKey, RSAPublicKey, RSAPrivateKey, ECDSAPublicKey, ECDSAPrivateKey, Ed25519PublicKey, Ed25519PrivateKey, Ed448PublicKey, Ed448PrivateKey, coordinateSize, constantTimeEqual)
		std.crypto.hash::(Hash, digest, hashSize)
		std.data.encoding::*
		std.data.encoding.c14n::*
	)

	const excC14nNamespace = "http://www.w3.org/2001/10/xml-exc-c14n#"
	const envelopedTransform = "http://www.w3.org/2000/09/xmldsig#enveloped-signature"
	const base64Transform = "http://www.w3.org/2000/09/xmldsig#base64"

	def dsigError(kind XMLSignatureErrorKind, text string) error {
		return XMLSignatureError{message: "xmldsig: " + text, code: kind.name, kind: kind}
	}

	// c14nOf is the canonicalization a URI names.
	def c14nOf(uri string) ?C14N {
		match uri {
			case "http://www.w3.org/TR/2001/REC-xml-c14n-20010315":
				return C14N.Inclusive10
			case "http://www.w3.org/TR/2001/REC-xml-c14n-20010315#WithComments":
				return C14N.Inclusive10Comments
			case "http://www.w3.org/2006/12/xml-c14n11":
				return C14N.Inclusive11
			case "http://www.w3.org/2006/12/xml-c14n11#WithComments":
				return C14N.Inclusive11Comments
			case "http://www.w3.org/2001/10/xml-exc-c14n#":
				return C14N.Exclusive
			case "http://www.w3.org/2001/10/xml-exc-c14n#WithComments":
				return C14N.ExclusiveComments
			default:
				return none
		}
	}

	// withoutComments is the same method without comments, as a
	// same-document reference node-set is (XML-DSig §4.4.3.3).
	def withoutComments(m C14N) C14N {
		match m {
			case C14N.Inclusive10Comments:
				return C14N.Inclusive10
			case C14N.Inclusive11Comments:
				return C14N.Inclusive11
			case C14N.ExclusiveComments:
				return C14N.Exclusive
			default:
				return m
		}
	}

	def signatureMethodOf(uri string) ?SignatureMethod {
		for let (i, v) in SignatureMethod.values() {
			return SignatureMethod(i) when v == uri
		}
		return none
	}

	def digestMethodOf(uri string) ?DigestMethod {
		for let (i, v) in DigestMethod.values() {
			return DigestMethod(i) when v == uri
		}
		return none
	}

	def inclusivePrefixesOf(e XMLNode) string[] {
		let list = e.child("InclusiveNamespaces", excC14nNamespace)
		return [] when list is none
		let prefixes = list.attribute("PrefixList")
		return prefixes is none ?? ([], prefixes.split(" ").filter(p => p != ""))
	}

	def referenceOf(ref XMLNode) !XMLReference {
		let uri = ref.attribute("URI")
		let transforms string[] = []
		let prefixes string[] = []
		let list = ref.child("Transforms", xmlDsigNamespace)
		if !(list is none) {
			for let t in list.elements("Transform", xmlDsigNamespace) {
				let alg = t.attribute("Algorithm")
				fail dsigError(XMLSignatureErrorKind.Malformed, "a Transform has no Algorithm") when alg is none
				transforms.push(alg)
				let more = inclusivePrefixesOf(t)
				prefixes = more when more.len() > 0
			}
		}
		let methodElement = ref.child("DigestMethod", xmlDsigNamespace)
		fail dsigError(XMLSignatureErrorKind.Malformed, "a Reference has no DigestMethod") when methodElement is none
		let methodUri = methodElement.attribute("Algorithm")
		let method = digestMethodOf(methodUri is none ?? ("", methodUri))
		fail dsigError(XMLSignatureErrorKind.Unsupported, "unsupported digest {methodUri is none ?? ("", methodUri)}") when method is none
		let valueElement = ref.child("DigestValue", xmlDsigNamespace)
		fail dsigError(XMLSignatureErrorKind.Malformed, "a Reference has no DigestValue") when valueElement is none
		return XMLReference{uri: uri is none ?? ("", uri), transforms: transforms, inclusivePrefixes: prefixes, digestMethod: method, digestValue: try decodeBase64Text(valueElement.text(), "DigestValue")}
	}

	def decodeBase64Text(text string, what string) !byte[] {
		let compact = text.replace(" ", "").replace("\n", "").replace("\r", "").replace("\t", "")
		return new Base64().decode(compact) onerror fail dsigError(XMLSignatureErrorKind.Malformed, "{what} is not base64")
	}

	def isSha1(method SignatureMethod) bool {
		return method := SignatureMethod.RsaSha1 || SignatureMethod.EcdsaSha1 || SignatureMethod.HmacSha1
	}

	def isHmacMethod(method SignatureMethod) bool {
		return method := SignatureMethod.HmacSha1 || SignatureMethod.HmacSha224 || SignatureMethod.HmacSha256 || SignatureMethod.HmacSha384 || SignatureMethod.HmacSha512
	}

	def checkAlgorithms(sig XMLSignature, allowSha1 bool) !none {
		fail dsigError(XMLSignatureErrorKind.Unsupported, "SHA-1 signatures are not allowed") when isSha1(sig.method) && !allowSha1
		for let r in sig.references {
			fail dsigError(XMLSignatureErrorKind.Unsupported, "SHA-1 digests are not allowed") when r.digestMethod == DigestMethod.Sha1 && !allowSha1
			// Transforms are checked before any cryptography, so an XPath or
			// XSLT transform is refused as Unsupported however the rest looks.
			for let t in r.transforms {
				fail dsigError(XMLSignatureErrorKind.Unsupported, "unsupported transform {t}") unless t == envelopedTransform || t == base64Transform || !(c14nOf(t) is none)
			}
		}
		return none
	}

	def methodHash(method SignatureMethod) Hash {
		match method {
			case SignatureMethod.RsaSha1, SignatureMethod.EcdsaSha1, SignatureMethod.HmacSha1:
				return Hash.SHA1
			case SignatureMethod.HmacSha224:
				return Hash.SHA224
			case SignatureMethod.RsaSha384, SignatureMethod.RsaPssSha384, SignatureMethod.EcdsaSha384, SignatureMethod.HmacSha384:
				return Hash.SHA384
			case SignatureMethod.RsaSha512, SignatureMethod.RsaPssSha512, SignatureMethod.EcdsaSha512, SignatureMethod.HmacSha512:
				return Hash.SHA512
			default:
				return Hash.SHA256
		}
	}

	def digestHash(method DigestMethod) Hash {
		match method {
			case DigestMethod.Sha1:
				return Hash.SHA1
			case DigestMethod.Sha224:
				return Hash.SHA224
			case DigestMethod.Sha384:
				return Hash.SHA384
			case DigestMethod.Sha512:
				return Hash.SHA512
			case DigestMethod.Sha3_224:
				return Hash.SHA3_224
			case DigestMethod.Sha3_256:
				return Hash.SHA3_256
			case DigestMethod.Sha3_384:
				return Hash.SHA3_384
			case DigestMethod.Sha3_512:
				return Hash.SHA3_512
			case DigestMethod.Ripemd160:
				return Hash.RIPEMD160
			default:
				return Hash.SHA256
		}
	}

	def isRsaMethod(m SignatureMethod) bool {
		return m := SignatureMethod.RsaSha1 || SignatureMethod.RsaSha256 || SignatureMethod.RsaSha384 || SignatureMethod.RsaSha512 || SignatureMethod.RsaPssSha256 || SignatureMethod.RsaPssSha384 || SignatureMethod.RsaPssSha512
	}

	def isPssMethod(m SignatureMethod) bool {
		return m := SignatureMethod.RsaPssSha256 || SignatureMethod.RsaPssSha384 || SignatureMethod.RsaPssSha512
	}

	def isEcdsaMethod(m SignatureMethod) bool {
		return m := SignatureMethod.EcdsaSha1 || SignatureMethod.EcdsaSha256 || SignatureMethod.EcdsaSha384 || SignatureMethod.EcdsaSha512
	}

	def keyFits(m SignatureMethod, key PublicKey) bool {
		match key {
			case RSAPublicKey:
				return isRsaMethod(m)
			case ECDSAPublicKey:
				return isEcdsaMethod(m)
			case Ed25519PublicKey:
				return m == SignatureMethod.Ed25519
			case Ed448PublicKey:
				return m == SignatureMethod.Ed448
			default:
				return false
		}
	}

	def privateKeyFits(m SignatureMethod, key PrivateKey) bool {
		match key {
			case RSAPrivateKey:
				return isRsaMethod(m)
			case ECDSAPrivateKey:
				return isEcdsaMethod(m)
			case Ed25519PrivateKey:
				return m == SignatureMethod.Ed25519
			case Ed448PrivateKey:
				return m == SignatureMethod.Ed448
			default:
				return false
		}
	}

	def verifyValue(m SignatureMethod, key PublicKey, data byte[], value byte[]) bool {
		let h = methodHash(m)
		match key {
			case RSAPublicKey:
				return key.verifyPSS(h, digest(h, data), value, hashSize(h)) when isPssMethod(m)
				return key.verifyPKCS1v15(h, digest(h, data), value)
			case ECDSAPublicKey:
				let size = coordinateSize(key.curve)
				return false unless value.len() == 2 * size
				return key.verify(digest(h, data), parseBigInt(value[0:size]), parseBigInt(value[size:2 * size]))
			case Ed25519PublicKey:
				return key.verify(data, value)
			case Ed448PublicKey:
				return key.verify(data, value)
			default:
				return false
		}
	}

	def signValue(m SignatureMethod, key PrivateKey, data byte[]) !byte[] {
		let h = methodHash(m)
		match key {
			case RSAPrivateKey:
				return try key.signPSS(h, digest(h, data)) when isPssMethod(m)
				return try key.signPKCS1v15(h, digest(h, data))
			case ECDSAPrivateKey:
				let (r, s) = try key.sign(digest(h, data))
				let size = coordinateSize(key.curve)
				return (try r.bytes(size)) + (try s.bytes(size))
			case Ed25519PrivateKey:
				return key.sign(data)
			case Ed448PrivateKey:
				return try key.sign(data)
			default:
				fail dsigError(XMLSignatureErrorKind.KeyMismatch, "unsupported key")
		}
	}

	// checkReferences resolves, transforms and digests every reference and
	// returns what they point at.
	def checkReferences(sig XMLSignature, document XMLNode, idAttributes string[]) !XMLNode[] {
		let out XMLNode[] = []
		for let r in sig.references {
			let target = try resolveReference(r.uri, document, idAttributes)
			let data = try transformed(sig, r, target, document)
			fail dsigError(XMLSignatureErrorKind.BadDigest, "the digest of {r.uri} does not match") unless constantTimeEqual(digest(digestHash(r.digestMethod), data), r.digestValue)
			out.push(target)
		}
		return out
	}

	// resolveReference finds what a same-document URI names: the document
	// for "", the one element whose ID attribute is the fragment for
	// "#id". Fails with Unsupported for other URIs and BadReference when
	// the ID names no element or several.
	def resolveReference(uri string, document XMLNode, idAttributes string[]) !XMLNode {
		return document when uri == ""
		fail dsigError(XMLSignatureErrorKind.Unsupported, "only same-document references are supported") unless uri.startsWith("#")
		let id = uri[1:]
		fail dsigError(XMLSignatureErrorKind.Unsupported, "xpointer references are not supported") when id.startsWith("xpointer(")
		let found XMLNode[] = []
		collectById(document, id, idAttributes, found)
		fail dsigError(XMLSignatureErrorKind.BadReference, "no element has ID {id}") when found.len() == 0
		fail dsigError(XMLSignatureErrorKind.BadReference, "several elements have ID {id}") when found.len() > 1
		return found[0]
	}

	def collectById(node XMLNode, id string, idAttributes string[], found XMLNode[]) {
		return unless node.kind == XMLNodeKind.Element
		for let name in idAttributes {
			let v = node.attribute(name)
			if !(v is none) && v == id {
				found.push(node)
				break
			}
		}
		for let child in node.children {
			collectById(child, id, idAttributes, found)
		}
	}

	// transformed applies a reference's transforms (XML-DSig §6.6):
	// enveloped-signature drops the Signature, a canonicalization produces
	// the octets, base64 decodes text; without a canonicalization the node
	// set is serialized with Canonical XML 1.0. Fails with Unsupported for
	// XPath, XPath Filter 2.0 and XSLT.
	def transformed(sig XMLSignature, r XMLReference, target XMLNode, document XMLNode) !byte[] {
		let enveloped = false
		let method ?C14N = none
		let base64 = false
		for let t in r.transforms {
			if t == envelopedTransform {
				enveloped = true
				continue
			}
			if t == base64Transform {
				base64 = true
				continue
			}
			let c = c14nOf(t)
			fail dsigError(XMLSignatureErrorKind.Unsupported, "unsupported transform {t}") when c is none
			method = c
		}
		return try decodeBase64Text(target.text(), "a base64 transform's input") when base64
		let signatureElement = sig.element
		let skip = def (n XMLNode) bool {
			return enveloped && n == signatureElement
		}
		let chosen = method is none ?? (C14N.Inclusive10, method)
		return canonicalBytes(target, withoutComments(chosen), r.inclusivePrefixes, document, skip)
	}

	// prepareSignature builds the Signature element with its SignedInfo
	// and Reference digest, and inserts it into the element.
	def prepareSignature(element XMLNode, method SignatureMethod, digestMethod DigestMethod, idAttribute string, after string, document ?XMLNode) !XMLNode {
		let id = element.attribute(idAttribute)
		fail dsigError(XMLSignatureErrorKind.BadReference, "the element has no {idAttribute} attribute") when id is none
		let position = element.children.len()
		if after != "" {
			position = -1
			for let (i, child) in element.children {
				if child.kind == XMLNodeKind.Element && child.localName == after {
					position = i + 1
					break
				}
			}
			fail dsigError(XMLSignatureErrorKind.Malformed, "the element has no {after} child to put the signature after") when position < 0
		}
		let root = document is none ?? (element, document)
		let digestValue = digest(digestHash(digestMethod), canonicalBytes(element, C14N.Exclusive, [], root, n => false))
		let sig = new XMLNode("ds:Signature", xmlDsigNamespace)
		sig.set("xmlns:ds", xmlDsigNamespace)
		let signedInfo = sig.add(new XMLNode("ds:SignedInfo", xmlDsigNamespace))
		signedInfo.add(new XMLNode("ds:CanonicalizationMethod", xmlDsigNamespace)).set("Algorithm", "http://www.w3.org/2001/10/xml-exc-c14n#")
		signedInfo.add(new XMLNode("ds:SignatureMethod", xmlDsigNamespace)).set("Algorithm", method.value)
		let ref = signedInfo.add(new XMLNode("ds:Reference", xmlDsigNamespace))
		ref.set("URI", "#" + id)
		let transforms = ref.add(new XMLNode("ds:Transforms", xmlDsigNamespace))
		transforms.add(new XMLNode("ds:Transform", xmlDsigNamespace)).set("Algorithm", envelopedTransform)
		transforms.add(new XMLNode("ds:Transform", xmlDsigNamespace)).set("Algorithm", "http://www.w3.org/2001/10/xml-exc-c14n#")
		ref.add(new XMLNode("ds:DigestMethod", xmlDsigNamespace)).set("Algorithm", digestMethod.value)
		ref.add(new XMLNode("ds:DigestValue", xmlDsigNamespace)).add(new Base64().encode(digestValue))
		let children XMLNode[] = []
		for let (i, child) in element.children {
			children.push(sig) when i == position
			children.push(child)
		}
		children.push(sig) when position == element.children.len()
		element.children = children
		return sig
	}

	// finishSignature adds the SignatureValue and KeyInfo.
	def finishSignature(sig XMLNode, raw byte[], certificate ?byte[]) !none {
		sig.add(new XMLNode("ds:SignatureValue", xmlDsigNamespace)).add(new Base64().encode(raw))
		if !(certificate is none) {
			let keyInfo = sig.add(new XMLNode("ds:KeyInfo", xmlDsigNamespace))
			let data = keyInfo.add(new XMLNode("ds:X509Data", xmlDsigNamespace))
			data.add(new XMLNode("ds:X509Certificate", xmlDsigNamespace)).add(new Base64().encode(certificate))
		}
		return none
	}
}
