		internal const dsigCert_ed448 = "-----BEGIN CERTIFICATE-----\nMIIBgjCCAQKgAwIBAgIUYvrTWfjywSrBix+y04l7hzFQz18wBQYDK2VxMBAxDjAM\nBgNVBAMMBWVkNDQ4MCAXDTI2MTAwMzEwMzUxNloYDzIxMjYwOTA5MTAzNTE2WjAQ\nMQ4wDAYDVQQDDAVlZDQ0ODBDMAUGAytlcQM6AHc44cvVN3/e6vRXU09DIP1/sYgy\nOpylvBTYfFw4qNC4GZ8WZk6JDhc0E1ZyN9AnKaWrsUZ68SrqgKNTMFEwHQYDVR0O\nBBYEFKc9I0DwOdpTHfWSmZhf6GOprqpMMB8GA1UdIwQYMBaAFKc9I0DwOdpTHfWS\nmZhf6GOprqpMMA8GA1UdEwEB/wQFMAMBAf8wBQYDK2VxA3MAXI02yCpTpSxK4btm\nJsU2V3IYfY52abni8FWhPupxOr9HQx383CDpx5uNYqGQ9f9EakhPBgoaPxuAh2Sd\nWtb5Yk/YbgVCKiLwQ4g5z3B3UxWtIOPt9xiGFkGZOB8xpgsrvymaK63WmbHzHBMD\ncaSsYQIA\n-----END CERTIFICATE-----\n"
		internal const dsigHmacKey = "secret-hmac-key-0123456789abcdef"

		internal def certKey(pem string) !PublicKey {
			let certs = try x509.parseCertificatesPEM(pem)
			let key = certs[0].publicKey
			fail "no key" when key is none
			return key
		}

		internal def privateKey(pem string) !PrivateKey {
			let block = try pemDecode(pem)
			return try crypto.parsePKCS8PrivateKey(block.bytes)
		}

		internal def failsWith(kind XMLSignatureErrorKind, run def () !XMLNode[]) bool {
			let matched = false
			run() onerror (err error) {
				matched = err.kind == kind when err is XMLSignatureError
				recover []
			}
			return matched
		}

		internal def strictXML() XML {
			let codec = new XML()
			codec.allowDoctype = false
			return codec
		}

		@test()
		def TestVerifyXmlsec1() !none {
			let rsa = try certKey(dsigCert_rsa)
			let ec = try certKey(dsigCert_ec)
			let ed = try certKey(dsigCert_ed)
			let ed448 = try certKey(dsigCert_ed448)
			for let pair in [(dsigSigned1, rsa), (dsigSigned2, ec), (dsigSigned3, rsa), (dsigSigned5, rsa), (dsigSigned6, ed), (dsigSigned7, ed448), (dsigSigned8, rsa)] {
				let (text, key) = pair
				let doc = try strictXML().parse(text)
				let sigElement = doc.descendants("Signature", xmlDsigNamespace)[0]
				let sig = try parseXMLSignature(sigElement)
				assert sig.certificates.len() == 1
				let signed = try sig.verify(doc, [key])
				assert signed.len() == 1
				assert signed[0].localName == "a" || signed[0].localName == "root"
			}
			// Exclusive c14n with the RSA key: the reference is element a.
			let doc1 = try strictXML().parse(dsigSigned1)
			let sig1 = try parseXMLSignature(doc1.descendants("Signature", xmlDsigNamespace)[0])
			let covered = try sig1.verify(doc1, [rsa])
			let id = covered[0].attribute("ID")
			assert !(id is none) && id == "x1"
			// The wrong key, and a key of the wrong type, are refused.
			assert failsWith(XMLSignatureErrorKind.KeyMismatch, def () !XMLNode[] {
				return try sig1.verify(doc1, [ec])
			})
			assert failsWith(XMLSignatureErrorKind.KeyMismatch, def () !XMLNode[] {
				return try sig1.verify(doc1, [try certKey(dsigCert_ed)])
			})
			let otherRsa = try certKey(dsigCert_rsa2)
			assert failsWith(XMLSignatureErrorKind.BadSignature, def () !XMLNode[] {
				return try sig1.verify(doc1, [otherRsa])
			})
			assert (try sig1.verify(doc1, [ec, otherRsa, rsa])).len() == 1
			// HMAC.
			let doc4 = try strictXML().parse(dsigSigned4)
			let sig4 = try parseXMLSignature(doc4.descendants("Signature", xmlDsigNamespace)[0])
			assert (try sig4.verify(doc4, dsigHmacKey.bytes())).len() == 1
			assert failsWith(XMLSignatureErrorKind.BadSignature, def () !XMLNode[] {
				return try sig4.verify(doc4, "wrong".bytes())
			})
		}

		@test()
		def TestVerifyRefusals() !none {
			let rsa = try certKey(dsigCert_rsa)
			// Changed content breaks the digest.
			let changed = try strictXML().parse(dsigSigned1.replace("text &amp; more", "text &amp; less"))
			let sigChanged = try parseXMLSignature(changed.descendants("Signature", xmlDsigNamespace)[0])
			assert failsWith(XMLSignatureErrorKind.BadDigest, def () !XMLNode[] {
				return try sigChanged.verify(changed, [rsa])
			})
			// A changed SignatureValue breaks the signature.
			let doc = try strictXML().parse(dsigSigned1)
			let sigElement = doc.descendants("Signature", xmlDsigNamespace)[0]
			let sig = try parseXMLSignature(sigElement)
			sig.value[10] ^= 1
			assert failsWith(XMLSignatureErrorKind.BadSignature, def () !XMLNode[] {
				return try sig.verify(doc, [rsa])
			})
			// Signature wrapping: a second element with the same ID makes the
			// reference ambiguous.
			let wrapped = try strictXML().parse(dsigSigned1.replace("<z ID=\"x2\">", "<z ID=\"x1\">"))
			let sigWrapped = try parseXMLSignature(wrapped.descendants("Signature", xmlDsigNamespace)[0])
			assert failsWith(XMLSignatureErrorKind.BadReference, def () !XMLNode[] {
				return try sigWrapped.verify(wrapped, [rsa])
			})
			// SHA-1 needs allowSha1, and DOCTYPEs are refused by the strict parser.
			let sha1 = dsigSigned1.replace("http://www.w3.org/2001/04/xmlenc#sha256", "http://www.w3.org/2000/09/xmldsig#sha1")
			let docSha1 = try strictXML().parse(sha1)
			let sigSha1 = try parseXMLSignature(docSha1.descendants("Signature", xmlDsigNamespace)[0])
			assert failsWith(XMLSignatureErrorKind.Unsupported, def () !XMLNode[] {
				return try sigSha1.verify(docSha1, [rsa])
			})
			assert strictXML().parse("<!DOCTYPE a><a/>") is error
			// XPath transforms are refused.
			let xpath = dsigSigned1.replace("http://www.w3.org/2000/09/xmldsig#enveloped-signature", "http://www.w3.org/TR/1999/REC-xpath-19991116")
			let docXpath = try strictXML().parse(xpath)
			let sigXpath = try parseXMLSignature(docXpath.descendants("Signature", xmlDsigNamespace)[0])
			assert failsWith(XMLSignatureErrorKind.Unsupported, def () !XMLNode[] {
				return try sigXpath.verify(docXpath, [rsa])
			})
		}

		@test()
		def TestSignRoundTrips() !none {
			let cases = [
				(dsigKey_rsa, dsigCert_rsa, SignatureMethod.RsaSha256),
				(dsigKey_rsa, dsigCert_rsa, SignatureMethod.RsaPssSha384),
				(dsigKey_ec, dsigCert_ec, SignatureMethod.EcdsaSha256),
				(dsigKey_ed, dsigCert_ed, SignatureMethod.Ed25519)
			]
			for let c in cases {
				let (keyPem, certPem, method) = c
				let doc = try strictXML().parse("<r xmlns=\"urn:r\"><Issuer>me</Issuer><a ID=\"s1\" xmlns:x=\"urn:x\"><x:b>v</x:b></a></r>")
				let a = doc.children[1]
				let cert = (try pemDecode(certPem)).bytes
				let signature = try signXML(a, try privateKey(keyPem), method, DigestMethod.Sha512, cert, after = "b", document = doc)
				assert a.children[1] == signature
				// Serialize and parse again: the signature survives the round trip.
				let text = doc.str()
				let again = try strictXML().parse(text)
				let sig = try parseXMLSignature(again.descendants("Signature", xmlDsigNamespace)[0])
				assert sig.certificates.len() == 1 && sig.method == method
				assert (try sig.verify(again, [try certKey(certPem)])).len() == 1
			}
			// `after` must name a child; the element is left as it was.
			let plain = try strictXML().parse("<a ID=\"p\"><b/></a>")
			let missing = signXML(plain, "k".bytes(), after = "Issuer") onerror (err error) {
				assert err is XMLSignatureError && err.kind == XMLSignatureErrorKind.Malformed
				recover plain
			}
			assert missing == plain && plain.children.len() == 1
			// Ed448 over a whole document, and HMAC; the wrong secret fails.
			let ed448 = try crypto.generateEd448Key()
			let doc = try strictXML().parse("<a ID=\"k\"><b/></a>")
			let edSig = try signXML(doc, ed448, SignatureMethod.Ed448)
			let parsedEd = try parseXMLSignature(edSig)
			let pub PublicKey = ed448.public
			assert (try parsedEd.verify(doc, [pub])).len() == 1
			let hdoc = try strictXML().parse("<a ID=\"h\"><b/></a>")
			let hSig = try signXML(hdoc, "k".bytes(), SignatureMethod.HmacSha512)
			let parsedH = try parseXMLSignature(hSig)
			assert (try parsedH.verify(hdoc, "k".bytes())).len() == 1
			assert failsWith(XMLSignatureErrorKind.BadSignature, def () !XMLNode[] {
				return try parsedH.verify(hdoc, "j".bytes())
			})
		}
	}
}
