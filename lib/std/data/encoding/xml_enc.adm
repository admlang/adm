partial module std.data.encoding {
	use (
		std.crypto::(PublicKey, PrivateKey, DHPublicKey, DHPrivateKey)
		std.errors
		std.data.encoding.xenc::*
	)

	// The XML Encryption 1.0 namespace.
	const xmlEncNamespace = "http://www.w3.org/2001/04/xmlenc#"
	// The XML Encryption 1.1 namespace.
	const xmlEnc11Namespace = "http://www.w3.org/2009/xmlenc11#"

	// DataEncryption is an XML-Enc block encryption algorithm; its value is
	// the algorithm URI.
	enum DataEncryption {
		// CBC modes: the IV leads the cipher text; padding is checked only
		// for its length byte, as XML-Enc pads with arbitrary bytes.
		TripleDesCbc = "http://www.w3.org/2001/04/xmlenc#tripledes-cbc",
		Aes128Cbc = "http://www.w3.org/2001/04/xmlenc#aes128-cbc",
		Aes192Cbc = "http://www.w3.org/2001/04/xmlenc#aes192-cbc",
		Aes256Cbc = "http://www.w3.org/2001/04/xmlenc#aes256-cbc",
		// Camellia-CBC (RFC 4051 §2.3.5).
		Camellia128Cbc = "http://www.w3.org/2001/04/xmldsig-more#camellia128-cbc",
		Camellia192Cbc = "http://www.w3.org/2001/04/xmldsig-more#camellia192-cbc",
		Camellia256Cbc = "http://www.w3.org/2001/04/xmldsig-more#camellia256-cbc",
		// GCM: a 96-bit IV first, the 128-bit tag last.
		Aes128Gcm = "http://www.w3.org/2009/xmlenc11#aes128-gcm",
		Aes192Gcm = "http://www.w3.org/2009/xmlenc11#aes192-gcm",
		Aes256Gcm = "http://www.w3.org/2009/xmlenc11#aes256-gcm",
		// RFC 9231 §2.6.7: the nonce and counter are EncryptionMethod
		// children; no integrity.
		ChaCha20 = "http://www.w3.org/2021/04/xmldsig-more#chacha20",
		// RFC 9231 §2.6.8: the nonce and AAD are EncryptionMethod children,
		// the tag follows the cipher text.
		ChaCha20Poly1305 = "http://www.w3.org/2021/04/xmldsig-more#chacha20poly1305",
	}

	// KeyTransport is an XML-Enc key transport algorithm.
	enum KeyTransport {
		// RSAES-PKCS1-v1_5: decrypting needs XMLKeys.allowRsa15.
		Rsa15 = "http://www.w3.org/2001/04/xmlenc#rsa-1_5",
		// RSA-OAEP with MGF1-SHA1 and a DigestMethod (SHA-1 when absent).
		RsaOaepMgf1p = "http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p",
		// RSA-OAEP with a DigestMethod and an MGF (both SHA-1 when absent).
		RsaOaep = "http://www.w3.org/2009/xmlenc11#rsa-oaep",
	}

	// KeyWrap is an XML-Enc symmetric key wrap algorithm.
	enum KeyWrap {
		// RFC 3217.
		TripleDesKw = "http://www.w3.org/2001/04/xmlenc#kw-tripledes",
		// RFC 3394.
		Aes128Kw = "http://www.w3.org/2001/04/xmlenc#kw-aes128",
		Aes192Kw = "http://www.w3.org/2001/04/xmlenc#kw-aes192",
		Aes256Kw = "http://www.w3.org/2001/04/xmlenc#kw-aes256",
		// RFC 5649, for keys of any length.
		Aes128KwPad = "http://www.w3.org/2009/xmlenc11#kw-aes-128-pad",
		Aes192KwPad = "http://www.w3.org/2009/xmlenc11#kw-aes-192-pad",
		Aes256KwPad = "http://www.w3.org/2009/xmlenc11#kw-aes-256-pad",
		// Camellia key wrap (RFC 3657, RFC 4051 §2.3.6).
		Camellia128Kw = "http://www.w3.org/2001/04/xmldsig-more#kw-camellia128",
		Camellia192Kw = "http://www.w3.org/2001/04/xmldsig-more#kw-camellia192",
		Camellia256Kw = "http://www.w3.org/2001/04/xmldsig-more#kw-camellia256",
	}

	// KeyAgreement is an XML-Enc key agreement algorithm.
	enum KeyAgreement {
		// Elliptic-curve Diffie-Hellman, ephemeral-static.
		EcdhEs = "http://www.w3.org/2009/xmlenc11#ECDH-ES",
		// RFC 9231 §2.7.1.
		X25519 = "http://www.w3.org/2021/04/xmldsig-more#x25519",
		X448 = "http://www.w3.org/2021/04/xmldsig-more#x448",
		// Finite-field Diffie-Hellman, ephemeral-static, with a
		// KeyDerivationMethod.
		DhEs = "http://www.w3.org/2009/xmlenc11#dh-es",
		// Finite-field Diffie-Hellman of XML-Enc 1.0 §5.5, with its own key
		// derivation over KA-Nonce.
		Dh = "http://www.w3.org/2001/04/xmlenc#dh",
	}

	// KeyDerivation is an XML-Enc key derivation algorithm.
	enum KeyDerivation {
		// NIST SP 800-56A Concat KDF (XML-Enc 1.1 §5.4.1).
		ConcatKdf = "http://www.w3.org/2009/xmlenc11#ConcatKDF",
		// PBKDF2 (XML-Enc 1.1 §5.4.2).
		Pbkdf2 = "http://www.w3.org/2009/xmlenc11#pbkdf2",
		// HKDF (RFC 9231 §2.8.1).
		Hkdf = "http://www.w3.org/2021/04/xmldsig-more#hkdf",
	}

	// XMLEncryptionErrorKind says why an XML encryption operation failed.
	enum XMLEncryptionErrorKind {
		// The EncryptedData or EncryptedKey is not well formed.
		Malformed,
		// An algorithm or form that is not implemented (MD5 digests,
		// external CipherReference) or not allowed (RSA 1.5 without
		// allowRsa15, CBC without allowCbc).
		Unsupported,
		// None of the given keys fits.
		NoKey,
		// Decryption failed. Every failure after the keys were found reports
		// this kind with the same message, so a peer learns nothing from it.
		DecryptionFailed,
		// The key cannot be used with the algorithm.
		KeyMismatch,
	}

	// XMLEncryptionError is the payload of XML-Enc failures.
	struct XMLEncryptionError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    XMLEncryptionErrorKind
	}

	// XMLKeys are the keys decryptXML may use. A document says which key it
	// wants by KeyName, by an EncryptedKey, an AgreementMethod or a
	// DerivedKey; each is matched against these.
	struct XMLKeys {
		// Private keys for key transport (RSA) and key agreement (ECDSA,
		// X25519, X448); each is tried where its type fits.
		privateKeys   PrivateKey[]             = []
		// Finite-field DH private keys for dh-es and dh.
		dhKeys        DHPrivateKey[]           = []
		// Symmetric keys (data keys, key-encryption keys) and passwords or
		// master keys of a DerivedKey, by KeyName or MasterKeyName.
		named         map<string, byte[]>
		// The symmetric key used where the document names none.
		secret        byte[]                   = []
		// Static originator public keys by KeyName, for an AgreementMethod
		// whose OriginatorKeyInfo names its key instead of carrying it.
		originators   map<string, PublicKey>
		// Finite-field DH originator keys by KeyName.
		dhOriginators map<string, DHPublicKey>
		// Accept RSA PKCS#1 v1.5 key transport. Off by default: even with
		// the random-key countermeasure (a failed decryption yields a random
		// key, so the data decryption fails alike), timing can leak a
		// Bleichenbacher oracle.
		allowRsa15    bool                     = false
		// Accept CBC data encryption, which has no integrity: an attacker
		// who sees whether a changed cipher text decrypts to well-formed XML
		// can recover the plain text. Turn off when the peer supports GCM.
		allowCbc      bool                     = true
		// The largest PBKDF2 iteration count accepted, so a document cannot
		// make the receiver spin.
		maxIterations int                      = 10000000
	}

	// XMLRecipient is one recipient of encryptXML: a public key (RSA for
	// key transport; ECDSA, X25519 or X448 for key agreement), a DH public
	// key, a key-encryption key, or a password.
	struct XMLRecipient {
		key         ?PublicKey
		dh          ?DHPublicKey
		// A key-encryption key, wrapped with XMLEncryption.wrap.
		kek         byte[]          = []
		// A password: PBKDF2 derives the key-encryption key.
		password    ?Secret<string>
		// The KeyName of a kek, the MasterKeyName of a password, and the
		// EncryptedKey's Recipient attribute.
		name        string          = ""
		// A DER certificate put in the EncryptedKey's KeyInfo.
		certificate ?byte[]
	}

	// XMLEncryption chooses the algorithms of encryptXML.
	struct XMLEncryption {
		data       DataEncryption = DataEncryption.Aes256Gcm
		transport  KeyTransport   = KeyTransport.RsaOaep
		// The OAEP digest; RsaOaepMgf1p always masks with MGF1-SHA1.
		oaepDigest DigestMethod   = DigestMethod.Sha256
		// The MGF1 digest of RsaOaep.
		mgfDigest  DigestMethod   = DigestMethod.Sha256
		// How a key agreement's derived key, a kek or a password key wraps
		// the data key.
		wrap       KeyWrap        = KeyWrap.Aes256Kw
		// How a key agreement derives the wrapping key.
		derivation KeyDerivation  = KeyDerivation.ConcatKdf
		// The digest of Concat KDF, and the HMAC of HKDF and PBKDF2.
		kdfDigest  DigestMethod   = DigestMethod.Sha256
		// PBKDF2 iterations for a password recipient.
		iterations int            = 600000
		// Encrypt the element's content instead of the element.
		content    bool           = false
		// The EncryptedData's Id, and its MimeType.
		id         string         = ""
		mimeType   string         = ""
		// The AAD of ChaCha20Poly1305.
		aad        string         = ""
	}

	// decryptXML decrypts an xenc:EncryptedData of an element or of element
	// content with a private key and returns the nodes it held, parsed in
	// the namespace context of the EncryptedData. With the document it
	// sits in, the EncryptedData is replaced by them, EncryptedKeys
	// elsewhere in the document are found (by ReferenceList or as
	// siblings, as SAML places them), and RetrievalMethod references
	// resolve. Fails with Malformed, Unsupported, NoKey when no key fits,
	// and DecryptionFailed whatever else went wrong.
	def decryptXML(encrypted XMLNode, key PrivateKey, document ?XMLNode = none) !XMLNode[] {
		return try decryptXML(encrypted, XMLKeys{privateKeys: [key]}, document)
	}

	// decryptXML decrypts with a symmetric key: the data key, or the
	// key-encryption key of an EncryptedKey. Fails as the key overload.
	def decryptXML(encrypted XMLNode, secret byte[], document ?XMLNode = none) !XMLNode[] {
		return try decryptXML(encrypted, XMLKeys{secret: secret}, document)
	}

	// decryptXML decrypts with any of the keys. Fails as the key overload.
	def decryptXML(encrypted XMLNode, keys XMLKeys, document ?XMLNode = none) !XMLNode[] {
		let plain = try decryptXMLData(encrypted, keys, document)
		let kind = encrypted.attribute("Type")
		let isElement = !(kind is none) && kind == xmlEncNamespace + "Element"
		let isContent = !(kind is none) && kind == xmlEncNamespace + "Content"
		fail xencError(XMLEncryptionErrorKind.Unsupported, "the EncryptedData holds no XML; use decryptXMLData") unless isElement || isContent
		let nodes = try parseInContext(plain, encrypted, document)
		if isElement {
			let elements = nodes.filter(n => n.kind == XMLNodeKind.Element)
			fail xencError(XMLEncryptionErrorKind.DecryptionFailed, "decryption failed") unless elements.len() == 1 && nodes.len() == elements.len() + textNodes(nodes)
		}
		if !(document is none) {
			try replaceNode(document, encrypted, nodes)
		}
		return nodes
	}

	// decryptXMLData decrypts an xenc:EncryptedData and returns the plain
	// octets whatever its Type. Fails as decryptXML.
	def decryptXMLData(encrypted XMLNode, keys XMLKeys, document ?XMLNode = none) !byte[] {
		return try decryptData(encrypted, keys, document)
	}

	// encryptXML encrypts an element (or, with method.content, its content)
	// in place for a public key and returns the xenc:EncryptedData that took
	// its place: RSA keys transport a fresh data key, ECDSA, X25519 and
	// X448 keys agree on a key that wraps it. The element is serialized
	// with its in-scope namespace declarations, so it parses alike wherever
	// it is decrypted; `document` is the tree it is in. Fails with
	// KeyMismatch for a key that cannot encrypt (Ed25519, Ed448).
	def encryptXML(target XMLNode, recipient PublicKey, method XMLEncryption = XMLEncryption{}, document ?XMLNode = none) !XMLNode {
		return try encryptXML(target, [XMLRecipient{key:recipient}], method, document)
	}

	// encryptXML encrypts with a symmetric data key directly, with no
	// EncryptedKey. Fails with KeyMismatch when the key does not have the
	// algorithm's length.
	def encryptXML(target XMLNode, secret byte[], method XMLEncryption = XMLEncryption{}, document ?XMLNode = none) !XMLNode {
		let encrypted = try sealNode(target, secret, [], method, document)
		return encrypted
	}

	// encryptXML encrypts for several recipients: one data key, an
	// EncryptedKey for each. Fails as the key overload, and with
	// KeyMismatch for a recipient that carries no key.
	def encryptXML(target XMLNode, recipients XMLRecipient[], method XMLEncryption = XMLEncryption{}, document ?XMLNode = none) !XMLNode {
		let dataKey = try randomKey(dataKeySize(method.data))
		return try sealNode(target, dataKey, recipients, method, document)
	}

	// encryptXMLData encrypts octets for the recipients and returns a
	// detached xenc:EncryptedData (MimeType from the method). Fails as
	// encryptXML.
	def encryptXMLData(data byte[], recipients XMLRecipient[], method XMLEncryption = XMLEncryption{}) !XMLNode {
		let dataKey = try randomKey(dataKeySize(method.data))
		return try sealData(data, dataKey, recipients, method, "")
	}
}

internal partial module std.data.encoding.xenc {
	use (
		std.crypto
		std.crypto::(PublicKey, PrivateKey, RSAPublicKey, RSAPrivateKey, RSAPadding, ECDSAPublicKey, ECDSAPrivateKey, X25519PublicKey, X25519PrivateKey, X448PublicKey, X448PrivateKey, DHPublicKey, DHPrivateKey, DHParameters, constantTimeEqual, curveByOID, unmarshalPoint, marshalPoint, marshalPKIXPublicKey, parsePKIXPublicKey, ecdh, ecdhKeyPair, oidOfCurve, rand)
		std.crypto.cipher
		std.crypto.hash::(Hash, digest, hashSize, concatKDF, hkdf, pbkdf2)
		std.data.encoding::*
		std.data.encoding.c14n::*
		std.data.encoding.dsig::*
	)

	const dsig11Namespace = "http://www.w3.org/2009/xmldsig11#"
	const dsigMoreNamespace = "http://www.w3.org/2021/04/xmldsig-more#"
	const encryptedKeyType = "http://www.w3.org/2001/04/xmlenc#EncryptedKey"
	const derivedKeyType = "http://www.w3.org/2009/xmlenc11#DerivedKey"
	const elementType = "http://www.w3.org/2001/04/xmlenc#Element"
	const contentType = "http://www.w3.org/2001/04/xmlenc#Content"
	// RFC 3217 §3.2: the IV of the second CBC pass of the 3DES key wrap.
	const tripleDesWrapIV = byte[0x4a, 0xdd, 0xa2, 0x2c, 0x79, 0xe8, 0x21, 0x05]

	def xencError(kind XMLEncryptionErrorKind, text string) error {
		return XMLEncryptionError{message: "xmlenc: " + text, code: kind.name, kind: kind}
	}

	def failed() error {
		return xencError(XMLEncryptionErrorKind.DecryptionFailed, "decryption failed")
	}

	def randomKey(size int) !byte[] {
		return try rand(size)
	}

	def textNodes(nodes XMLNode[]) int {
		let n = 0
		for let node in nodes {
			n += 1 when node.kind == XMLNodeKind.Text && node.content.trim() == ""
		}
		return n
	}

	// --- algorithms ---

	def dataEncryptionOf(uri string) ?DataEncryption {
		for let (i, v) in DataEncryption.values() {
			return DataEncryption(i) when v == uri
		}
		return none
	}

	def keyTransportOf(uri string) ?KeyTransport {
		for let (i, v) in KeyTransport.values() {
			return KeyTransport(i) when v == uri
		}
		return none
	}

	def keyWrapOf(uri string) ?KeyWrap {
		for let (i, v) in KeyWrap.values() {
			return KeyWrap(i) when v == uri
		}
		return none
	}

	def keyAgreementOf(uri string) ?KeyAgreement {
		for let (i, v) in KeyAgreement.values() {
			return KeyAgreement(i) when v == uri
		}
		return none
	}

	def keyDerivationOf(uri string) ?KeyDerivation {
		for let (i, v) in KeyDerivation.values() {
			return KeyDerivation(i) when v == uri
		}
		return none
	}

	def dataKeySize(alg DataEncryption) int {
		match alg {
			case DataEncryption.TripleDesCbc, DataEncryption.Aes192Cbc, DataEncryption.Aes192Gcm, DataEncryption.Camellia192Cbc:
				return 24
			case DataEncryption.Aes128Cbc, DataEncryption.Aes128Gcm, DataEncryption.Camellia128Cbc:
				return 16
			default:
				return 32
		}
	}

	// wrapKeySize is the length of a key-encryption key; 0 for the padded
	// AES wraps' callers to read from the algorithm.
	def wrapKeySize(alg KeyWrap) int {
		match alg {
			case KeyWrap.Aes128Kw, KeyWrap.Aes128KwPad, KeyWrap.Camellia128Kw:
				return 16
			case KeyWrap.TripleDesKw, KeyWrap.Aes192Kw, KeyWrap.Aes192KwPad, KeyWrap.Camellia192Kw:
				return 24
			default:
				return 32
		}
	}

	def isCbc(alg DataEncryption) bool {
		return alg := DataEncryption.TripleDesCbc || DataEncryption.Aes128Cbc || DataEncryption.Aes192Cbc || DataEncryption.Aes256Cbc || DataEncryption.Camellia128Cbc || DataEncryption.Camellia192Cbc || DataEncryption.Camellia256Cbc
	}

	def isPaddedWrap(alg KeyWrap) bool {
		return alg := KeyWrap.Aes128KwPad || KeyWrap.Aes192KwPad || KeyWrap.Aes256KwPad
	}

	// keySizeFor is the key length the algorithm a URI names takes, for a
	// derived or agreed key; 0 for an unknown algorithm.
	def keySizeFor(uri string) int {
		let data = dataEncryptionOf(uri)
		return dataKeySize(data) unless data is none
		let wrap = keyWrapOf(uri)
		return wrapKeySize(wrap) unless wrap is none
		return 0
	}

	// digestOf is the hash a DigestMethod URI names. MD5 is refused.
	def digestOf(uri string) !Hash {
		let method = digestMethodOf(uri)
		fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported digest {uri}") when method is none
		return digestHash(method)
	}

	// prfOf is the hash of an HMAC PRF URI.
	def prfOf(uri string) !Hash {
		let method = signatureMethodOf(uri)
		fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported PRF {uri}") unless !(method is none) && isHmacMethod(method)
		return methodHash(method)
	}

	def mgfOf(uri string) !Hash {
		match uri {
			case "http://www.w3.org/2009/xmlenc11#mgf1sha1":
				return Hash.SHA1
			case "http://www.w3.org/2009/xmlenc11#mgf1sha224":
				return Hash.SHA224
			case "http://www.w3.org/2009/xmlenc11#mgf1sha256":
				return Hash.SHA256
			case "http://www.w3.org/2009/xmlenc11#mgf1sha384":
				return Hash.SHA384
			case "http://www.w3.org/2009/xmlenc11#mgf1sha512":
				return Hash.SHA512
			default:
				fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported MGF {uri}")
		}
	}

	def mgfUri(method DigestMethod) !string {
		match method {
			case DigestMethod.Sha1:
				return "http://www.w3.org/2009/xmlenc11#mgf1sha1"
			case DigestMethod.Sha224:
				return "http://www.w3.org/2009/xmlenc11#mgf1sha224"
			case DigestMethod.Sha256:
				return "http://www.w3.org/2009/xmlenc11#mgf1sha256"
			case DigestMethod.Sha384:
				return "http://www.w3.org/2009/xmlenc11#mgf1sha384"
			case DigestMethod.Sha512:
				return "http://www.w3.org/2009/xmlenc11#mgf1sha512"
			default:
				fail xencError(XMLEncryptionErrorKind.Unsupported, "no MGF1 URI for {method.value}")
		}
	}

	def hmacUri(method DigestMethod) !string {
		match method {
			case DigestMethod.Sha1:
				return SignatureMethod.HmacSha1.value
			case DigestMethod.Sha224:
				return SignatureMethod.HmacSha224.value
			case DigestMethod.Sha256:
				return SignatureMethod.HmacSha256.value
			case DigestMethod.Sha384:
				return SignatureMethod.HmacSha384.value
			case DigestMethod.Sha512:
				return SignatureMethod.HmacSha512.value
			default:
				fail xencError(XMLEncryptionErrorKind.Unsupported, "no HMAC for {method.value}")
		}
	}

	def algorithmOf(e XMLNode) string {
		let method = e.child("EncryptionMethod", xmlEncNamespace)
		return "" when method is none
		let uri = method.attribute("Algorithm")
		return uri is none ?? ("", uri)
	}

	def hexBytes(text string, what string) !byte[] {
		return hexdecode(text.trim()) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "{what} is not hex")
	}

	def base64Bytes(text string, what string) !byte[] {
		let compact = text.replace(" ", "").replace("\n", "").replace("\r", "").replace("\t", "")
		return new Base64().decode(compact) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "{what} is not base64")
	}

	def intText(text string, what string) !int {
		let digits = text.trim()
		fail xencError(XMLEncryptionErrorKind.Malformed, "{what} is not a number") when digits == "" || digits.len() > 9
		for let c in digits {
			fail xencError(XMLEncryptionErrorKind.Malformed, "{what} is not a number") unless c >= '0' && c <= '9'
		}
		return parseInt<int>(digits)
	}

	// --- symmetric primitives ---

	def blockOf(alg DataEncryption, key byte[]) !cipher.Block {
		return try cipher.newTripleDES(key) when alg == DataEncryption.TripleDesCbc
		return try cipher.newCamellia(key) when alg := DataEncryption.Camellia128Cbc || DataEncryption.Camellia192Cbc || DataEncryption.Camellia256Cbc
		return try cipher.newAES(key)
	}

	// openData decrypts cipher data. Every failure is DecryptionFailed with
	// the same message.
	def openData(alg DataEncryption, method XMLNode, key byte[], data byte[], keys XMLKeys) !byte[] {
		fail xencError(XMLEncryptionErrorKind.Unsupported, "CBC data encryption is not allowed") when isCbc(alg) && !keys.allowCbc
		fail failed() when key.len() != dataKeySize(alg)
		if isCbc(alg) {
			let block = blockOf(alg, key) onerror fail failed()
			let size = block.blockSize()
			fail failed() when data.len() < 2 * size || data.len() % size != 0
			let cbc = cipher.newCBC(block, data[0:size]) onerror fail failed()
			let plain = cbc.decrypt(data[size:]) onerror fail failed()
			// XML-Enc §5.2: the last octet counts the padding, whose other
			// octets are arbitrary.
			let pad = int(plain[plain.len() - 1])
			fail failed() when pad < 1 || pad > size
			return plain[0:plain.len() - pad]
		}
		if alg := DataEncryption.Aes128Gcm || DataEncryption.Aes192Gcm || DataEncryption.Aes256Gcm {
			fail failed() when data.len() < 28
			let gcm = cipher.newGCM(cipher.newAES(key) onerror fail failed()) onerror fail failed()
			return gcm.open(data[0:12], data[12:], []) onerror fail failed()
		}
		let nonceElement = method.child("Nonce", dsigMoreNamespace)
		fail xencError(XMLEncryptionErrorKind.Malformed, "ChaCha20 needs a Nonce") when nonceElement is none
		let body = data
		let nonce = try hexBytes(nonceElement.text(), "Nonce")
		fail xencError(XMLEncryptionErrorKind.Malformed, "the Nonce is not 12 bytes") when nonce.len() != 12
		if alg == DataEncryption.ChaCha20 {
			// The Counter's four bytes are the little-endian block counter
			// that precedes the nonce in RFC 8439's state (xmlsec, OpenSSL).
			let counterElement = method.child("Counter", dsigMoreNamespace)
			let counterBytes = counterElement is none ?? (byte[0, 0, 0, 0], try hexBytes(counterElement.text(), "Counter"))
			fail xencError(XMLEncryptionErrorKind.Malformed, "the Counter is not 4 bytes") when counterBytes.len() != 4
			let counter = uint32(counterBytes[3]) << 24 | uint32(counterBytes[2]) << 16 | uint32(counterBytes[1]) << 8 | uint32(counterBytes[0])
			return cipher.chacha20(key, nonce, counter, body) onerror fail failed()
		}
		let aadElement = method.child("AAD", dsigMoreNamespace)
		let aad = aadElement is none ?? (byte[], aadElement.text().bytes())
		let aead = cipher.newChaCha20Poly1305(key) onerror fail failed()
		return aead.open(nonce, body, aad) onerror fail failed()
	}

	// sealBytes encrypts plain text; ChaCha20 modes add their Nonce (and
	// AAD) to the method element.
	def sealBytes(alg DataEncryption, method XMLNode, key byte[], plain byte[], aad string) !byte[] {
		fail xencError(XMLEncryptionErrorKind.KeyMismatch, "the key is not {dataKeySize(alg)} bytes") when key.len() != dataKeySize(alg)
		if isCbc(alg) {
			let block = try blockOf(alg, key)
			let size = block.blockSize()
			let iv = try rand(size)
			let pad = size - plain.len() % size
			let padding = try rand(pad - 1)
			let padded = plain + padding + byte[byte(pad)]
			return iv + try (try cipher.newCBC(block, iv)).encrypt(padded)
		}
		if alg := DataEncryption.Aes128Gcm || DataEncryption.Aes192Gcm || DataEncryption.Aes256Gcm {
			let iv = try rand(12)
			let gcm = try cipher.newGCM(try cipher.newAES(key))
			return iv + gcm.seal(iv, plain, [])
		}
		let nonce = try rand(12)
		method.add(new XMLNode("dsig-more:Nonce", dsigMoreNamespace)).set("xmlns:dsig-more", dsigMoreNamespace).add(hexencode(nonce))
		if alg == DataEncryption.ChaCha20 {
			method.add(new XMLNode("dsig-more:Counter", dsigMoreNamespace)).set("xmlns:dsig-more", dsigMoreNamespace).add("00000000")
			return try cipher.chacha20(key, nonce, uint32(0), plain)
		}
		method.add(new XMLNode("dsig-more:AAD", dsigMoreNamespace)).set("xmlns:dsig-more", dsigMoreNamespace).add(aad) when aad != ""
		let aead = try cipher.newChaCha20Poly1305(key)
		return aead.seal(nonce, plain, aad.bytes())
	}

	def wrapWith(alg KeyWrap, kek byte[], key byte[]) !byte[] {
		fail xencError(XMLEncryptionErrorKind.KeyMismatch, "the key-encryption key is not {wrapKeySize(alg)} bytes") when kek.len() != wrapKeySize(alg)
		return try tripleDesWrap(kek, key) when alg == KeyWrap.TripleDesKw
		return try cipher.wrapKey(try wrapBlock(alg, kek), key, isPaddedWrap(alg))
	}

	def unwrapWith(alg KeyWrap, kek byte[], wrapped byte[]) !byte[] {
		fail failed() when kek.len() != wrapKeySize(alg)
		if alg == KeyWrap.TripleDesKw {
			return tripleDesUnwrap(kek, wrapped) onerror fail failed()
		}
		return cipher.unwrapKey(wrapBlock(alg, kek) onerror fail failed(), wrapped, isPaddedWrap(alg)) onerror fail failed()
	}

	// wrapBlock is the block cipher of an RFC 3394 style key wrap.
	def wrapBlock(alg KeyWrap, kek byte[]) !cipher.Block {
		return try cipher.newCamellia(kek) when alg := KeyWrap.Camellia128Kw || KeyWrap.Camellia192Kw || KeyWrap.Camellia256Kw
		return try cipher.newAES(kek)
	}

	// tripleDesWrap is the CMS Triple-DES key wrap of RFC 3217 §3.
	def tripleDesWrap(kek byte[], key byte[]) !byte[] {
		let icv = digest(Hash.SHA1, key)[0:8]
		let iv = try rand(8)
		let block = try cipher.newTripleDES(kek)
		let temp1 = try (try cipher.newCBC(block, iv)).encrypt(key + icv)
		let temp3 = reversed(iv + temp1)
		return try (try cipher.newCBC(block, tripleDesWrapIV)).encrypt(temp3)
	}

	def tripleDesUnwrap(kek byte[], wrapped byte[]) !byte[] {
		fail failed() when wrapped.len() < 24 || wrapped.len() % 8 != 0
		let block = try cipher.newTripleDES(kek)
		let temp3 = try (try cipher.newCBC(block, tripleDesWrapIV)).decrypt(wrapped)
		let temp2 = reversed(temp3)
		let wkcks = try (try cipher.newCBC(block, temp2[0:8])).decrypt(temp2[8:])
		let key = wkcks[0:wkcks.len() - 8]
		fail failed() unless constantTimeEqual(digest(Hash.SHA1, key)[0:8], wkcks[wkcks.len() - 8:])
		return key
	}

	def reversed(data byte[]) byte[] {
		let out byte[]
		out.len(data.len())
		for let i = 0; i < data.len(); i++ {
			out[i] = data[data.len() - 1 - i]
		}
		return out
	}

	// tripleDesParity sets the odd parity bit of each byte of a 3DES key.
	def tripleDesParity(key byte[]) byte[] {
		let out = key.clone()
		for let i = 0; i < out.len(); i++ {
			let b = int(out[i]) & 0xfe
			let ones = 0
			for let bit = 1; bit < 8; bit++ {
				ones += (b >> bit) & 1
			}
			out[i] = byte(b | (ones % 2 == 0 ?? (1, 0)))
		}
		return out
	}

	// --- cipher data ---

	def cipherBytes(e XMLNode, document ?XMLNode) !byte[] {
		let data = e.child("CipherData", xmlEncNamespace)
		fail xencError(XMLEncryptionErrorKind.Malformed, "no CipherData") when data is none
		let value = data.child("CipherValue", xmlEncNamespace)
		return try base64Bytes(value.text(), "CipherValue") unless value is none
		let ref = data.child("CipherReference", xmlEncNamespace)
		fail xencError(XMLEncryptionErrorKind.Malformed, "CipherData holds neither CipherValue nor CipherReference") when ref is none
		let uri = ref.attribute("URI")
		fail xencError(XMLEncryptionErrorKind.Unsupported, "only same-document CipherReferences are resolved") unless !(uri is none) && uri.startsWith("#") && !(document is none)
		let target = elementById(document, uri[1:])
		fail xencError(XMLEncryptionErrorKind.Malformed, "the CipherReference {uri} resolves to no single element") when target is none
		// A same-document reference yields the element's text; the only
		// transform that makes octets of it is base64.
		let transforms = ref.child("Transforms", xmlEncNamespace)
		let decodes = false
		if !(transforms is none) {
			for let t in transforms.elements("Transform", xmlDsigNamespace) {
				let alg = t.attribute("Algorithm")
				fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported CipherReference transform") unless !(alg is none) && alg == "http://www.w3.org/2000/09/xmldsig#base64"
				decodes = true
			}
		}
		return decodes ?? (try base64Bytes(target.text(), "the referenced cipher text"), target.text().bytes())
	}

	// elementById is the single element whose Id, ID or id attribute is the
	// value; none when there is none or more than one.
	def elementById(root XMLNode, id string) ?XMLNode {
		let found XMLNode[] = []
		collectById(root, id, found)
		return found.len() == 1 ?? (found[0], none)
	}

	def collectById(node XMLNode, id string, found XMLNode[]) {
		return when node.kind != XMLNodeKind.Element
		for let name in ["Id", "ID", "id"] {
			let v = node.attribute(name)
			if !(v is none) && v == id {
				found.push(node)
				break
			}
		}
		for let child in node.children {
			collectById(child, id, found)
		}
	}

	// --- decryption ---

	def decryptData(encrypted XMLNode, keys XMLKeys, document ?XMLNode) !byte[] {
		fail xencError(XMLEncryptionErrorKind.Malformed, "not an xenc:EncryptedData") unless encrypted.localName == "EncryptedData" && encrypted.namespace == xmlEncNamespace
		let uri = algorithmOf(encrypted)
		let alg = dataEncryptionOf(uri)
		fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported data encryption {uri}") when alg is none
		fail xencError(XMLEncryptionErrorKind.Unsupported, "CBC data encryption is not allowed") when isCbc(alg) && !keys.allowCbc
		let method = encrypted.child("EncryptionMethod", xmlEncNamespace)
		let data = try cipherBytes(encrypted, document)
		let candidates = try keysFor(encrypted, keys, document, dataKeySize(alg), uri)
		if candidates.len() == 0 {
			fail xencError(XMLEncryptionErrorKind.NoKey, "no key fits the EncryptedData") unless rsa15Failed(encrypted, keys, document)
			// RSA 1.5 (XML-Enc 1.1 §5.5.1): a key that would not decrypt is
			// replaced by a random one, so the data decryption runs and fails
			// the way a wrong key does. Kept apart from the real candidates:
			// a random key can pass a CBC padding check.
			let decoy = try rand(dataKeySize(alg))
			let _ = openData(alg, method is none ?? (encrypted, method), decoy, data, keys) onerror (err error) {
				recover byte[]
			}
			fail failed()
		}
		for let key in candidates {
			let plain = openData(alg, method is none ?? (encrypted, method), key, data, keys) onerror (err error) {
				continue
			}
			return plain
		}
		fail failed()
	}

	// keysFor lists the keys a KeyInfo (or, for an EncryptedData, the
	// document around it) yields for an algorithm taking `size` bytes.
	def keysFor(e XMLNode, keys XMLKeys, document ?XMLNode, size int, algorithm string) !byte[][] {
		let out byte[][] = []
		let named = false
		let info = e.child("KeyInfo", xmlDsigNamespace)
		if !(info is none) {
			for let child in info.children {
				continue unless child.kind == XMLNodeKind.Element
				named = true
				try keysFromInfo(child, keys, document, size, algorithm, out)
			}
		}
		if e.localName == "EncryptedData" && !(document is none) {
			let id = e.attribute("Id")
			for let ek in document.descendants("EncryptedKey", xmlEncNamespace) {
				let listed = !(id is none) && referencesData(ek, id)
				let sibling = isSiblingKey(document, e, ek)
				if listed || (sibling && !hasReferenceList(ek)) {
					named = true
					try collectKey(try decryptKey(ek, keys, document, size), out)
				}
			}
		}
		out.push(keys.secret) when !named && keys.secret.len() > 0
		return out
	}

	// rsa15Failed reports whether an RSA 1.5 EncryptedKey of the data
	// could have been opened with one of the keys and was not.
	def rsa15Failed(encrypted XMLNode, keys XMLKeys, document ?XMLNode) bool {
		return false unless keys.allowRsa15 && !(keys.privateKeys.find(k => k is RSAPrivateKey) is none)
		let found XMLNode[] = []
		let info = encrypted.child("KeyInfo", xmlDsigNamespace)
		found = info.elements("EncryptedKey", xmlEncNamespace) unless (info is none)
		if !(document is none) {
			for let ek in document.descendants("EncryptedKey", xmlEncNamespace) {
				found.push(ek)
			}
		}
		return !(found.find(ek => algorithmOf(ek) == KeyTransport.Rsa15.value) is none)
	}

	def collectKey(key ?byte[], out byte[][]) !none {
		out.push(key) unless key is none
		return none
	}

	def keysFromInfo(child XMLNode, keys XMLKeys, document ?XMLNode, size int, algorithm string, out byte[][]) !none {
		let ns = child.namespace
		return try collectKey(try decryptKey(child, keys, document, size), out) when child.localName == "EncryptedKey" && ns == xmlEncNamespace
		return try collectKey(try agree(child, keys, size, algorithm), out) when child.localName == "AgreementMethod" && ns == xmlEncNamespace
		return try collectKey(try deriveNamed(child, keys, size), out) when child.localName == "DerivedKey" && ns == xmlEnc11Namespace
		if child.localName == "KeyName" && ns == xmlDsigNamespace {
			let key = keys.named.get(child.text().trim())
			if !(key is none) {
				out.push(key)
			} else if keys.secret.len() > 0 {
				out.push(keys.secret)
			}
			return none
		}
		if child.localName == "RetrievalMethod" && ns == xmlDsigNamespace {
			let kind = child.attribute("Type")
			let uri = child.attribute("URI")
			return none when kind is none || uri is none || document is none
			return none unless uri.startsWith("#")
			let target = elementById(document, uri[1:])
			fail xencError(XMLEncryptionErrorKind.Malformed, "the RetrievalMethod {uri} resolves to no single element") when target is none
			return try collectKey(try decryptKey(target, keys, document, size), out) when kind == encryptedKeyType
			return try collectKey(try deriveNamed(target, keys, size), out) when kind == derivedKeyType
		}
		return none
	}

	def referencesData(ek XMLNode, id string) bool {
		let list = ek.child("ReferenceList", xmlEncNamespace)
		return false when list is none
		for let ref in list.elements("DataReference", xmlEncNamespace) {
			let uri = ref.attribute("URI")
			return true when !(uri is none) && uri == "#" + id
		}
		return false
	}

	def hasReferenceList(ek XMLNode) bool {
		return !(ek.child("ReferenceList", xmlEncNamespace) is none)
	}

	def isSiblingKey(document XMLNode, data XMLNode, ek XMLNode) bool {
		let path XMLNode[] = []
		return false unless findPath(document, data, path)
		return false when path.len() == 0
		let parent = path[path.len() - 1]
		for let child in parent.children {
			return true when child == ek
		}
		return false
	}

	// decryptKey decrypts an EncryptedKey into a key of `size` bytes; none
	// when none of the keys fits it.
	def decryptKey(ek XMLNode, keys XMLKeys, document ?XMLNode, size int) !?byte[] {
		let uri = algorithmOf(ek)
		let wrapped = try cipherBytes(ek, document)
		let transport = keyTransportOf(uri)
		return try transportKey(ek, transport, wrapped, keys, size) unless (transport is none)
		let wrap = keyWrapOf(uri)
		if wrap is none {
			// A block encryption algorithm may encrypt a key too (XML-Enc
			// §5.2): the key is its plain text.
			let block = dataEncryptionOf(uri)
			fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported key encryption {uri}") when block is none
			let method = ek.child("EncryptionMethod", xmlEncNamespace)
			for let kek in try keysFor(ek, keys, document, dataKeySize(block), uri) {
				let key = openData(block, method is none ?? (ek, method), kek, wrapped, keys) onerror (err error) {
					continue
				}
				continue when size > 0 && key.len() != size
				return key
			}
			return none
		}
		let keks = try keysFor(ek, keys, document, wrapKeySize(wrap), uri)
		for let kek in keks {
			let key = unwrapWith(wrap, kek, wrapped) onerror (err error) {
				continue
			}
			return key
		}
		return none
	}

	def transportKey(ek XMLNode, transport KeyTransport, wrapped byte[], keys XMLKeys, size int) !?byte[] {
		fail xencError(XMLEncryptionErrorKind.Unsupported, "RSA 1.5 key transport is not allowed") when transport == KeyTransport.Rsa15 && !keys.allowRsa15
		let method = ek.child("EncryptionMethod", xmlEncNamespace)
		let hash = Hash.SHA1
		let mgf = Hash.SHA1
		let label byte[] = []
		if !(method is none) {
			let digestElement = method.child("DigestMethod", xmlDsigNamespace)
			if !(digestElement is none) {
				let d = digestElement.attribute("Algorithm")
				hash = try digestOf(d is none ?? ("", d))
			}
			let mgfElement = method.child("MGF", xmlEnc11Namespace)
			// rsa-oaep-mgf1p fixes MGF1-SHA1; an explicit MGF there (xmlsec
			// writes one) is honoured, since it states what was used.
			if transport != KeyTransport.Rsa15 && !(mgfElement is none) {
				let m = mgfElement.attribute("Algorithm")
				mgf = try mgfOf(m is none ?? ("", m))
			}
			let params = method.child("OAEPparams", xmlEncNamespace)
			label = try base64Bytes(params.text(), "OAEPparams") unless params is none
		}
		for let key in keys.privateKeys {
			match key {
				case RSAPrivateKey:
					let padding = transport == KeyTransport.Rsa15 ?? (RSAPadding.PKCS1v15, RSAPadding.OAEP)
					let plain = key.decrypt(wrapped, padding, hash, label, mgf) onerror (err error) {
						continue
					}
					// A key of the wrong length is a failed decryption too.
					continue when size > 0 && plain.len() != size
					return plain
				default:
			}
		}
		return none
	}

	// --- key agreement ---

	// agree derives a key of `size` bytes from an AgreementMethod; none when
	// no private key fits it.
	def agree(am XMLNode, keys XMLKeys, size int, algorithm string) !?byte[] {
		let uri = am.attribute("Algorithm")
		let alg = keyAgreementOf(uri is none ?? ("", uri))
		fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported key agreement {uri is none ?? ("", uri)}") when alg is none
		fail xencError(XMLEncryptionErrorKind.Malformed, "the key size is unknown") when size <= 0
		let originator = am.child("OriginatorKeyInfo", xmlEncNamespace)
		fail xencError(XMLEncryptionErrorKind.Malformed, "an AgreementMethod needs OriginatorKeyInfo") when originator is none
		let z = try sharedSecret(alg, originator, keys)
		return none when z is none
		return try legacyDhKey(am, z, algorithm, size) when alg == KeyAgreement.Dh
		let method = am.child("KeyDerivationMethod", xmlEnc11Namespace)
		fail xencError(XMLEncryptionErrorKind.Malformed, "an AgreementMethod needs a KeyDerivationMethod") when method is none
		return try deriveKey(method, z, size, keys)
	}

	// sharedSecret is the agreed secret with the first private key that
	// fits the originator's key; none when none fits.
	def sharedSecret(alg KeyAgreement, originator XMLNode, keys XMLKeys) !?byte[] {
		if alg := KeyAgreement.DhEs || KeyAgreement.Dh {
			let peer = try dhOriginatorKey(originator, keys)
			for let key in keys.dhKeys {
				continue unless key.params.p == peer.params.p && key.params.g == peer.params.g
				return key.sharedSecret(peer) onerror fail failed()
			}
			return none
		}
		let peer = try originatorKey(originator, keys)
		for let key in keys.privateKeys {
			match key {
				case ECDSAPrivateKey:
					continue unless alg == KeyAgreement.EcdhEs
					match peer {
						case ECDSAPublicKey:
							continue unless peer.curve.name == key.curve.name
							return ecdh(key.curve, key.d, peer.point) onerror fail failed()
						default:
					}
				case X25519PrivateKey:
					continue unless alg == KeyAgreement.X25519
					match peer {
						case X25519PublicKey:
							return key.sharedSecret(peer) onerror fail failed()
						default:
					}
				case X448PrivateKey:
					continue unless alg == KeyAgreement.X448
					match peer {
						case X448PublicKey:
							return key.sharedSecret(peer) onerror fail failed()
						default:
					}
				default:
			}
		}
		return none
	}

	// originatorKey reads the originator's public key: dsig11:ECKeyValue,
	// dsig11:DEREncodedKeyValue (any SubjectPublicKeyInfo), or a KeyName
	// of XMLKeys.originators.
	def originatorKey(info XMLNode, keys XMLKeys) !PublicKey {
		let value = info.child("KeyValue", xmlDsigNamespace)
		if !(value is none) {
			let ec = value.child("ECKeyValue", dsig11Namespace)
			return try ecKeyValue(ec) unless ec is none
		}
		let der = info.child("DEREncodedKeyValue", dsig11Namespace)
		if !(der is none) {
			return parsePKIXPublicKey(try base64Bytes(der.text(), "DEREncodedKeyValue")) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "DEREncodedKeyValue is not a public key")
		}
		let spki = try certificateKey(info)
		if !(spki is none) {
			return parsePKIXPublicKey(spki) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "the certificate's key is not a public key")
		}
		let name = info.child("KeyName", xmlDsigNamespace)
		if !(name is none) {
			let key = keys.originators.get(name.text().trim())
			return key unless key is none
		}
		fail xencError(XMLEncryptionErrorKind.NoKey, "the originator's key is not given or known")
	}

	def ecKeyValue(ec XMLNode) !PublicKey {
		let named = ec.child("NamedCurve", dsig11Namespace)
		fail xencError(XMLEncryptionErrorKind.Unsupported, "ECKeyValue without a NamedCurve") when named is none
		let uri = named.attribute("URI")
		fail xencError(XMLEncryptionErrorKind.Malformed, "NamedCurve has no urn:oid URI") unless !(uri is none) && uri.startsWith("urn:oid:")
		let parts int[] = []
		for let part in uri[8:].split(".") {
			parts.push(try intText(part, "the curve OID"))
		}
		let c = curveByOID(new OID(parts))
		fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported curve {uri}") when c is none
		let point = ec.child("PublicKey", dsig11Namespace)
		fail xencError(XMLEncryptionErrorKind.Malformed, "ECKeyValue has no PublicKey") when point is none
		let p = unmarshalPoint(c, try base64Bytes(point.text(), "the EC public key")) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "the EC public key is not on {c.name}")
		return new ECDSAPublicKey(c, p)
	}

	def dhOriginatorKey(info XMLNode, keys XMLKeys) !DHPublicKey {
		let value = info.child("KeyValue", xmlDsigNamespace)
		if !(value is none) {
			let dh = value.child("DHKeyValue", xmlEncNamespace)
			if !(dh is none) {
				let p = try bigField(dh, "P")
				let g = try bigField(dh, "Generator")
				let y = try bigField(dh, "Public")
				let qElement = dh.child("Q", xmlEncNamespace)
				let q ?bigint = qElement is none ?? (none, parseBigInt(try base64Bytes(qElement.text(), "Q")))
				return crypto.newDHPublicKey(DHParameters{p: p, g: g, q: q}, y) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "the DH public key is invalid")
			}
		}
		let der = info.child("DEREncodedKeyValue", dsig11Namespace)
		if !(der is none) {
			return crypto.parseDHPublicKey(try base64Bytes(der.text(), "DEREncodedKeyValue")) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "DEREncodedKeyValue is not a DH key")
		}
		let spki = try certificateKey(info)
		if !(spki is none) {
			return crypto.parseDHPublicKey(spki) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "the certificate's key is not a DH key")
		}
		let name = info.child("KeyName", xmlDsigNamespace)
		if !(name is none) {
			let key = keys.dhOriginators.get(name.text().trim())
			return key unless key is none
		}
		fail xencError(XMLEncryptionErrorKind.NoKey, "the originator's DH key is not given or known")
	}

	// certificateKey is the SubjectPublicKeyInfo of the first
	// X509Certificate of a KeyInfo; none without one. The certificate is a
	// key carrier here: who issued it is the caller's question.
	def certificateKey(info XMLNode) !?byte[] {
		let data = info.child("X509Data", xmlDsigNamespace)
		return none when data is none
		let cert = data.child("X509Certificate", xmlDsigNamespace)
		return none when cert is none
		let der = try base64Bytes(cert.text(), "X509Certificate")
		let parsed = asn1Parse(der) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "X509Certificate is not DER")
		let tbs = parsed.at(0) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "X509Certificate has no TBSCertificate")
		// version [0] is optional; then serial, signature, issuer, validity,
		// subject, subjectPublicKeyInfo.
		let first = tbs.at(0) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "the TBSCertificate is empty")
		let offset = first.constructed && first.class == ASN1Class.ContextSpecific ?? (1, 0)
		let spki = tbs.at(offset + 5) onerror fail xencError(XMLEncryptionErrorKind.Malformed, "the certificate has no SubjectPublicKeyInfo")
		return spki.raw
	}

	def bigField(e XMLNode, name string) !bigint {
		let field = e.child(name, xmlEncNamespace)
		fail xencError(XMLEncryptionErrorKind.Malformed, "DHKeyValue has no {name}") when field is none
		return parseBigInt(try base64Bytes(field.text(), name))
	}

	// deriveKey applies a KeyDerivationMethod to a secret.
	def deriveKey(method XMLNode, secret byte[], size int, keys XMLKeys) !byte[] {
		let uri = method.attribute("Algorithm")
		let alg = keyDerivationOf(uri is none ?? ("", uri))
		fail xencError(XMLEncryptionErrorKind.Unsupported, "unsupported key derivation {uri is none ?? ("", uri)}") when alg is none
		match alg {
			case KeyDerivation.ConcatKdf:
				let params = method.child("ConcatKDFParams", xmlEnc11Namespace)
				fail xencError(XMLEncryptionErrorKind.Malformed, "ConcatKDF needs ConcatKDFParams") when params is none
				let digestElement = params.child("DigestMethod", xmlDsigNamespace)
				fail xencError(XMLEncryptionErrorKind.Malformed, "ConcatKDFParams needs a DigestMethod") when digestElement is none
				let d = digestElement.attribute("Algorithm")
				let hash = try digestOf(d is none ?? ("", d))
				let info = try kdfField(params, "AlgorithmID") + try kdfField(params, "PartyUInfo") + try kdfField(params, "PartyVInfo") + try kdfField(params, "SuppPubInfo") + try kdfField(params, "SuppPrivInfo")
				return concatKDF(hash, secret, info, size) onerror fail failed()
			case KeyDerivation.Pbkdf2:
				let params = method.child("PBKDF2-params", xmlEnc11Namespace)
				fail xencError(XMLEncryptionErrorKind.Malformed, "pbkdf2 needs PBKDF2-params") when params is none
				let saltElement = params.child("Salt", xmlEnc11Namespace)
				let specified = saltElement is none ?? (none, saltElement.child("Specified", xmlEnc11Namespace))
				fail xencError(XMLEncryptionErrorKind.Unsupported, "PBKDF2 needs a Specified salt") when specified is none
				let salt = try base64Bytes(specified.text(), "Salt")
				let countElement = params.child("IterationCount", xmlEnc11Namespace)
				fail xencError(XMLEncryptionErrorKind.Malformed, "PBKDF2-params needs IterationCount") when countElement is none
				let count = try intText(countElement.text(), "IterationCount")
				fail xencError(XMLEncryptionErrorKind.Unsupported, "PBKDF2 iteration count {count} is out of range") when count < 1 || count > keys.maxIterations
				let lengthElement = params.child("KeyLength", xmlEnc11Namespace)
				let length = lengthElement is none ?? (size, try intText(lengthElement.text(), "KeyLength"))
				fail failed() when length != size
				let prfElement = params.child("PRF", xmlEnc11Namespace)
				fail xencError(XMLEncryptionErrorKind.Malformed, "PBKDF2-params needs a PRF") when prfElement is none
				let p = prfElement.attribute("Algorithm")
				return pbkdf2(try prfOf(p is none ?? ("", p)), secret, salt, count, size)
			case KeyDerivation.Hkdf:
				let params = method.child("HKDFParams", dsigMoreNamespace)
				fail xencError(XMLEncryptionErrorKind.Malformed, "hkdf needs HKDFParams") when params is none
				let prfElement = params.child("PRF", dsigMoreNamespace)
				fail xencError(XMLEncryptionErrorKind.Malformed, "HKDFParams needs a PRF") when prfElement is none
				let p = prfElement.attribute("Algorithm")
				let hash = try prfOf(p is none ?? ("", p))
				let saltElement = params.child("Salt", dsigMoreNamespace)
				let salt = saltElement is none ?? (byte[], try base64Bytes(saltElement.text(), "Salt"))
				let infoElement = params.child("Info", dsigMoreNamespace)
				let info = infoElement is none ?? (byte[], try base64Bytes(infoElement.text(), "Info"))
				let lengthElement = params.child("KeyLength", dsigMoreNamespace)
				let length = lengthElement is none ?? (size, try intText(lengthElement.text(), "KeyLength"))
				fail failed() when length != size
				return hkdf(hash, secret, salt, info, size) onerror fail failed()
		}
	}

	// kdfField is a ConcatKDFParams attribute: hex whose first octet counts
	// the padding bits, which must be zero; empty when absent.
	def kdfField(params XMLNode, name string) !byte[] {
		let value = params.attribute(name)
		return byte[] when value is none || value == ""
		let bytes = try hexBytes(value, name)
		fail xencError(XMLEncryptionErrorKind.Unsupported, "{name} has padding bits") unless bytes.len() > 0 && bytes[0] == byte(0)
		return bytes[1:]
	}

	// deriveNamed derives a key from a DerivedKey and the master key its
	// MasterKeyName names.
	def deriveNamed(dk XMLNode, keys XMLKeys, size int) !?byte[] {
		let method = dk.child("KeyDerivationMethod", xmlEnc11Namespace)
		fail xencError(XMLEncryptionErrorKind.Malformed, "a DerivedKey needs a KeyDerivationMethod") when method is none
		let nameElement = dk.child("MasterKeyName", xmlEnc11Namespace)
		let master = keys.secret
		if !(nameElement is none) {
			let found = keys.named.get(nameElement.text().trim())
			master = found unless found is none
		}
		return none when master.len() == 0
		return try deriveKey(method, master, size, keys)
	}

	// legacyDhKey is the key derivation of XML-Enc 1.0 §5.5.1:
	// KM(i) = Digest(ZZ || i as two upper-case hex digits || algorithm URI
	// || KA-Nonce || key size in bits as decimal), concatenated.
	def legacyDhKey(am XMLNode, z byte[], algorithm string, size int) !byte[] {
		let digestElement = am.child("DigestMethod", xmlDsigNamespace)
		let d = digestElement is none ?? (none, digestElement.attribute("Algorithm"))
		let hash = d is none ?? (Hash.SHA1, try digestOf(d))
		let nonceElement = am.child("KA-Nonce", xmlEncNamespace)
		let nonce = nonceElement is none ?? (byte[], try base64Bytes(nonceElement.text(), "KA-Nonce"))
		let out byte[] = []
		let counter = 1
		for out.len() < size {
			let counterText = "%02X".format(counter)
			out = out + digest(hash, z + counterText.bytes() + algorithm.bytes() + nonce + "{size * 8}".bytes())
			counter++
		}
		return out[0:size]
	}

	// --- parsing in context and replacing ---

	// parseInContext parses decrypted octets with the namespace
	// declarations in scope at the EncryptedData.
	def parseInContext(plain byte[], encrypted XMLNode, document ?XMLNode) !XMLNode[] {
		let scope map<string, string>
		let chain XMLNode[] = []
		if !(document is none) {
			let path XMLNode[] = []
			chain = path when findPath(document, encrypted, path)
		}
		for let a in chain {
			for let attr in a.attributes {
				scope.set(declaredPrefix(attr), attr.value) when isNamespaceDeclaration(attr)
			}
		}
		let wrapper = "<xenc-context"
		for let (prefix, uri) in scope {
			wrapper += (prefix == "" ?? (" xmlns", " xmlns:" + prefix)) + "=\"" + escapeAttribute(uri) + "\""
		}
		wrapper += ">"
		let codec = new XML()
		codec.allowDoctype = false
		codec.keepComments = true
		let root = codec.parse(wrapper.bytes() + plain + "</xenc-context>".bytes()) onerror fail failed()
		return root.children
	}

	// replaceNode puts nodes in the place of target in the tree. The root
	// itself takes the fields of the single element replacing it.
	def replaceNode(document XMLNode, target XMLNode, nodes XMLNode[]) !none {
		let path XMLNode[] = []
		fail xencError(XMLEncryptionErrorKind.Malformed, "the EncryptedData is not in the document") unless findPath(document, target, path)
		if path.len() == 0 {
			let elements = nodes.filter(n => n.kind == XMLNodeKind.Element)
			fail xencError(XMLEncryptionErrorKind.Malformed, "only an element can replace the root") unless elements.len() == 1
			let e = elements[0]
			document.kind = e.kind
			document.name = e.name
			document.prefix = e.prefix
			document.localName = e.localName
			document.namespace = e.namespace
			document.attributes = e.attributes
			document.children = e.children
			return none
		}
		let parent = path[path.len() - 1]
		let children XMLNode[] = []
		for let child in parent.children {
			if child == target {
				for let n in nodes {
					children.push(n)
				}
			} else {
				children.push(child)
			}
		}
		parent.children = children
		return none
	}

	// --- encryption ---

	// serialize writes an element, or an element's content, as octets that
	// parse alike anywhere: Canonical XML with comments brings the in-scope
	// namespace declarations along, prefixes used only in attribute values
	// (xsi:type) included.
	def serialize(target XMLNode, content bool, document ?XMLNode) byte[] {
		return canonicalize(target, C14N.Inclusive10Comments, [], document) unless content
		let out byte[] = []
		for let child in target.children {
			match child.kind {
				case XMLNodeKind.Element:
					out = out + canonicalize(child, C14N.Inclusive10Comments, [], document is none ?? (target, document))
				case XMLNodeKind.Text:
					out = out + escapeText(child.content).bytes()
				case XMLNodeKind.Comment:
					out = out + "<!--{child.content}-->".bytes()
				default:
					out = out + "<?{child.name} {child.content}?>".bytes()
			}
		}
		return out
	}

	def sealNode(target XMLNode, dataKey byte[], recipients XMLRecipient[], method XMLEncryption, document ?XMLNode) !XMLNode {
		let plain = serialize(target, method.content, document)
		let encrypted = try sealData(plain, dataKey, recipients, method, method.content ?? (contentType, elementType))
		if method.content {
			target.children = [encrypted]
			return encrypted
		}
		if !(document is none) {
			try replaceNode(document, target, [encrypted])
			// The root was replaced in place: it is the EncryptedData now.
			return document when document.localName == "EncryptedData" && document.namespace == xmlEncNamespace && encrypted.children.len() == document.children.len()
		}
		return encrypted
	}

	def sealData(plain byte[], dataKey byte[], recipients XMLRecipient[], method XMLEncryption, kind string) !XMLNode {
		let key = method.data == DataEncryption.TripleDesCbc ?? (tripleDesParity(dataKey), dataKey)
		let encrypted = new XMLNode("xenc:EncryptedData", xmlEncNamespace)
		encrypted.set("xmlns:xenc", xmlEncNamespace)
		encrypted.set("Id", method.id) when method.id != ""
		encrypted.set("Type", kind) when kind != ""
		encrypted.set("MimeType", method.mimeType) when method.mimeType != ""
		let em = encrypted.add(new XMLNode("xenc:EncryptionMethod", xmlEncNamespace))
		em.set("Algorithm", method.data.value)
		if recipients.len() > 0 {
			let info = encrypted.add(new XMLNode("ds:KeyInfo", xmlDsigNamespace))
			info.set("xmlns:ds", xmlDsigNamespace)
			for let r in recipients {
				info.add(try encryptedKeyFor(r, key, method))
			}
		}
		let sealed = try sealBytes(method.data, em, key, plain, method.aad)
		let data = encrypted.add(new XMLNode("xenc:CipherData", xmlEncNamespace))
		data.add(new XMLNode("xenc:CipherValue", xmlEncNamespace)).add(new Base64().encode(sealed))
		return encrypted
	}

	def encryptedKeyFor(r XMLRecipient, dataKey byte[], method XMLEncryption) !XMLNode {
		// Self-contained declarations: SAML moves an EncryptedKey out beside
		// its EncryptedData.
		let ek = new XMLNode("xenc:EncryptedKey", xmlEncNamespace)
		ek.set("xmlns:xenc", xmlEncNamespace)
		ek.set("Recipient", r.name) when r.name != ""
		let em = ek.add(new XMLNode("xenc:EncryptionMethod", xmlEncNamespace))
		let info = new XMLNode("ds:KeyInfo", xmlDsigNamespace)
		info.set("xmlns:ds", xmlDsigNamespace)
		let wrapped byte[] = []
		let rsaKey ?RSAPublicKey = none
		let key = r.key
		if !(key is none) {
			match key {
				case RSAPublicKey:
					rsaKey = key
				default:
			}
		}
		if !(rsaKey is none) {
			let rsa RSAPublicKey = rsaKey
			em.set("Algorithm", method.transport.value)
			match method.transport {
				case KeyTransport.Rsa15:
					wrapped = try rsa.encrypt(dataKey, RSAPadding.PKCS1v15)
				case KeyTransport.RsaOaepMgf1p:
					em.add(new XMLNode("ds:DigestMethod", xmlDsigNamespace)).set("xmlns:ds", xmlDsigNamespace).set("Algorithm", method.oaepDigest.value)
					wrapped = try rsa.encrypt(dataKey, RSAPadding.OAEP, digestHash(method.oaepDigest), [], Hash.SHA1)
				case KeyTransport.RsaOaep:
					em.add(new XMLNode("ds:DigestMethod", xmlDsigNamespace)).set("xmlns:ds", xmlDsigNamespace).set("Algorithm", method.oaepDigest.value)
					em.add(new XMLNode("xenc11:MGF", xmlEnc11Namespace)).set("xmlns:xenc11", xmlEnc11Namespace).set("Algorithm", try mgfUri(method.mgfDigest))
					wrapped = try rsa.encrypt(dataKey, RSAPadding.OAEP, digestHash(method.oaepDigest), [], digestHash(method.mgfDigest))
			}
		} else {
			em.set("Algorithm", method.wrap.value)
			let kek = try kekFor(r, info, method)
			wrapped = try wrapWith(method.wrap, kek, dataKey)
		}
		info.add(new XMLNode("ds:KeyName", xmlDsigNamespace)).add(r.name) when r.name != "" && r.kek.len() > 0
		let cert = r.certificate
		if !(cert is none) {
			let data = info.add(new XMLNode("ds:X509Data", xmlDsigNamespace))
			data.add(new XMLNode("ds:X509Certificate", xmlDsigNamespace)).add(new Base64().encode(cert))
		}
		ek.add(info) when info.children.len() > 0
		let data = ek.add(new XMLNode("xenc:CipherData", xmlEncNamespace))
		data.add(new XMLNode("xenc:CipherValue", xmlEncNamespace)).add(new Base64().encode(wrapped))
		return ek
	}

	// kekFor makes the key-encryption key of a recipient, adding to the
	// EncryptedKey's KeyInfo what the receiver needs to make it again.
	def kekFor(r XMLRecipient, info XMLNode, method XMLEncryption) !byte[] {
		let size = wrapKeySize(method.wrap)
		return r.kek when r.kek.len() > 0
		let password = r.password
		if !(password is none) {
			let dk = info.add(new XMLNode("xenc11:DerivedKey", xmlEnc11Namespace))
			dk.set("xmlns:xenc11", xmlEnc11Namespace)
			let (kdm, key) = try pbkdf2Method(password.reveal().bytes(), size, method)
			dk.add(kdm)
			dk.add(new XMLNode("xenc11:MasterKeyName", xmlEnc11Namespace)).add(r.name) when r.name != ""
			return key
		}
		let dh = r.dh
		if !(dh is none) {
			let ephemeral = try crypto.generateDHKey(dh.params)
			let z = try ephemeral.sharedSecret(dh)
			let am = info.add(new XMLNode("xenc:AgreementMethod", xmlEncNamespace))
			am.set("Algorithm", KeyAgreement.DhEs.value)
			let (kdm, key) = try derivationMethod(z, size, method)
			am.add(kdm)
			let value = am.add(new XMLNode("xenc:OriginatorKeyInfo", xmlEncNamespace)).add(new XMLNode("ds:KeyValue", xmlDsigNamespace))
			value.add(dhKeyValue(ephemeral.public))
			let recipientInfo = am.add(new XMLNode("xenc:RecipientKeyInfo", xmlEncNamespace))
			recipientInfo.add(new XMLNode("ds:KeyName", xmlDsigNamespace)).add(r.name) when r.name != ""
			recipientInfo.add(new XMLNode("ds:KeyValue", xmlDsigNamespace)).add(dhKeyValue(dh))
			return key
		}
		let key = r.key
		fail xencError(XMLEncryptionErrorKind.KeyMismatch, "the recipient carries no key") when key is none
		let am = new XMLNode("xenc:AgreementMethod", xmlEncNamespace)
		let originator = new XMLNode("xenc:OriginatorKeyInfo", xmlEncNamespace)
		let z byte[] = []
		match key {
			case ECDSAPublicKey:
				am.set("Algorithm", KeyAgreement.EcdhEs.value)
				let pair = try ecdhKeyPair(key.curve)
				z = try ecdh(key.curve, pair.scalar, key.point)
				originator.add(new XMLNode("ds:KeyValue", xmlDsigNamespace)).add(ecKeyValueOf(new ECDSAPublicKey(key.curve, pair.public)))
			case X25519PublicKey:
				am.set("Algorithm", KeyAgreement.X25519.value)
				let ephemeral = try crypto.generateX25519Key()
				z = try ephemeral.sharedSecret(key)
				originator.add(derKeyValue(ephemeral.public))
			case X448PublicKey:
				am.set("Algorithm", KeyAgreement.X448.value)
				let ephemeral = try crypto.generateX448Key()
				z = try ephemeral.sharedSecret(key)
				originator.add(derKeyValue(ephemeral.public))
			default:
				fail xencError(XMLEncryptionErrorKind.KeyMismatch, "the key cannot encrypt")
		}
		let (kdm, derived) = try derivationMethod(z, size, method)
		am.add(kdm)
		am.add(originator)
		// The recipient's own key, so a receiver holding several knows which
		// one to use (xmlsec looks for it).
		let recipientInfo = am.add(new XMLNode("xenc:RecipientKeyInfo", xmlEncNamespace))
		recipientInfo.add(new XMLNode("ds:KeyName", xmlDsigNamespace)).add(r.name) when r.name != ""
		recipientInfo.add(publicKeyValue(key))
		info.add(am)
		return derived
	}

	def dhKeyValue(key DHPublicKey) XMLNode {
		let dv = new XMLNode("xenc:DHKeyValue", xmlEncNamespace)
		dv.add(new XMLNode("xenc:P", xmlEncNamespace)).add(new Base64().encode(key.params.p.bytes()))
		let q = key.params.q
		dv.add(new XMLNode("xenc:Q", xmlEncNamespace)).add(new Base64().encode(q.bytes())) unless q is none
		dv.add(new XMLNode("xenc:Generator", xmlEncNamespace)).add(new Base64().encode(key.params.g.bytes()))
		dv.add(new XMLNode("xenc:Public", xmlEncNamespace)).add(new Base64().encode(key.y.bytes()))
		return dv
	}

	// publicKeyValue writes a public key as ds:KeyValue/dsig11:ECKeyValue
	// for EC keys, dsig11:DEREncodedKeyValue for the rest.
	def publicKeyValue(key PublicKey) XMLNode {
		match key {
			case ECDSAPublicKey:
				let value = new XMLNode("ds:KeyValue", xmlDsigNamespace)
				value.add(ecKeyValueOf(key))
				return value
			default:
				return derKeyValue(key)
		}
	}

	def ecKeyValueOf(key ECDSAPublicKey) XMLNode {
		let ec = new XMLNode("dsig11:ECKeyValue", dsig11Namespace)
		ec.set("xmlns:dsig11", dsig11Namespace)
		ec.add(new XMLNode("dsig11:NamedCurve", dsig11Namespace)).set("URI", "urn:oid:" + oidOfCurve(key.curve).str())
		ec.add(new XMLNode("dsig11:PublicKey", dsig11Namespace)).add(new Base64().encode(marshalPoint(key.curve, key.point)))
		return ec
	}

	def derKeyValue(key PublicKey) XMLNode {
		let e = new XMLNode("dsig11:DEREncodedKeyValue", dsig11Namespace)
		e.set("xmlns:dsig11", dsig11Namespace)
		e.add(new Base64().encode(marshalPKIXPublicKey(key)))
		return e
	}

	// derivationMethod derives the wrapping key of a key agreement and
	// writes the KeyDerivationMethod that does it again.
	def derivationMethod(z byte[], size int, method XMLEncryption) !(XMLNode, byte[]) {
		let kdm = new XMLNode("xenc11:KeyDerivationMethod", xmlEnc11Namespace)
		kdm.set("xmlns:xenc11", xmlEnc11Namespace)
		kdm.set("Algorithm", method.derivation.value)
		match method.derivation {
			case KeyDerivation.ConcatKdf:
				let params = kdm.add(new XMLNode("xenc11:ConcatKDFParams", xmlEnc11Namespace))
				let algorithmId = method.wrap.value.bytes()
				params.set("AlgorithmID", "00" + hexencode(algorithmId))
				params.set("PartyUInfo", "")
				params.set("PartyVInfo", "")
				params.add(new XMLNode("ds:DigestMethod", xmlDsigNamespace)).set("xmlns:ds", xmlDsigNamespace).set("Algorithm", method.kdfDigest.value)
				return (kdm, try concatKDF(digestHash(method.kdfDigest), z, algorithmId, size))
			case KeyDerivation.Hkdf:
				let params = kdm.add(new XMLNode("dsig-more:HKDFParams", dsigMoreNamespace))
				params.set("xmlns:dsig-more", dsigMoreNamespace)
				params.add(new XMLNode("dsig-more:PRF", dsigMoreNamespace)).set("Algorithm", try hmacUri(method.kdfDigest))
				let salt = try rand(hashSize(digestHash(method.kdfDigest)))
				params.add(new XMLNode("dsig-more:Salt", dsigMoreNamespace)).add(new Base64().encode(salt))
				params.add(new XMLNode("dsig-more:KeyLength", dsigMoreNamespace)).add("{size}")
				return (kdm, try hkdf(digestHash(method.kdfDigest), z, salt, [], size))
			case KeyDerivation.Pbkdf2:
				return try pbkdf2Method(z, size, method)
		}
	}

	def pbkdf2Method(secret byte[], size int, method XMLEncryption) !(XMLNode, byte[]) {
		let kdm = new XMLNode("xenc11:KeyDerivationMethod", xmlEnc11Namespace)
		kdm.set("xmlns:xenc11", xmlEnc11Namespace)
		kdm.set("Algorithm", KeyDerivation.Pbkdf2.value)
		let params = kdm.add(new XMLNode("xenc11:PBKDF2-params", xmlEnc11Namespace))
		let salt = try rand(16)
		params.add(new XMLNode("xenc11:Salt", xmlEnc11Namespace)).add(new XMLNode("xenc11:Specified", xmlEnc11Namespace)).add(new Base64().encode(salt))
		params.add(new XMLNode("xenc11:IterationCount", xmlEnc11Namespace)).add("{method.iterations}")
		params.add(new XMLNode("xenc11:KeyLength", xmlEnc11Namespace)).add("{size}")
		params.add(new XMLNode("xenc11:PRF", xmlEnc11Namespace)).set("Algorithm", try hmacUri(method.kdfDigest))
		return (kdm, pbkdf2(digestHash(method.kdfDigest), secret, salt, method.iterations, size))
	}
}
