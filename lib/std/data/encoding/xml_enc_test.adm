		internal const camelliaXml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<EncryptedData xmlns=\"http://www.w3.org/2001/04/xmlenc#\" MimeType=\"text/plain\">\n  <EncryptionMethod Algorithm=\"http://www.w3.org/2001/04/xmldsig-more#camellia128-cbc\"/>\n  <KeyInfo xmlns=\"http://www.w3.org/2000/09/xmldsig#\">\n     <EncryptedKey xmlns=\"http://www.w3.org/2001/04/xmlenc#\">\n       <EncryptionMethod Algorithm=\"http://www.w3.org/2001/04/xmldsig-more#camellia256-cbc\"/>\n       <KeyInfo xmlns=\"http://www.w3.org/2000/09/xmldsig#\">\n          <KeyName>test-camellia256</KeyName>\n       </KeyInfo>\n       <CipherData>\n          <CipherValue>GRKrBecFYLF90jF5GK3ibe3J4NPg+zVOVclR4REzZQIEft+FtaH+OZHjpfyuWZHS</CipherValue>\n       </CipherData>\n     </EncryptedKey>\n  </KeyInfo>   \n  <CipherData>\n     <CipherValue>yQZ9WKLGaLORz1HJaNRb+CXcFh7PPjOkZJHgXBJ2GlIyoFyoLDp/1xPRlIFdxgxU\npANNXOaW2AkYf7KxjMJRpA==</CipherValue>\n  </CipherData>\n</EncryptedData>\n"
		internal const camelliaData = "Q2FtZWxsaWEgMTI4IHdpdGggS1cgQ2FtZWxsaWEgMjU2IHRlc3Q="
		internal const camellia128Key = "d177f2dc44be15bbff39f5ae4072af3c"
		internal const camellia192Key = "964f43c80d3bc4bfe6e397d46fbcdb2e8cb773484b870f34"
		internal const camellia256Key = "7e908f40b08c642c3d5a2a47f2493527be42a988160616c90cc14f8944b48731"

		internal def der(text string) !byte[] {
			return try new Base64().decode(text)
		}

		internal def privateKey(text string) !PrivateKey {
			return try crypto.parsePKCS8PrivateKey(try der(text))
		}

		internal def strictXML() XML {
			let codec = new XML()
			codec.allowDoctype = false
			return codec
		}

		internal def firstEncrypted(doc XMLNode) XMLNode {
			return doc.localName == "EncryptedData" ?? (doc, doc.descendants("EncryptedData", xmlEncNamespace)[0])
		}

		// decrypts reports whether the vector decrypts to its data: the same
		// document canonically for element and content encryption, the same
		// octets otherwise.
		internal def decrypts(xml string, data string, keys XMLKeys) !bool {
			let doc = try new XML().parse(xml)
			let e = firstEncrypted(doc)
			let expected = try der(data)
			let kind = e.attribute("Type")
			return hexencode(try decryptXMLData(e, keys, doc)) == hexencode(expected) when kind is none || !(kind == xmlEncNamespace + "Element" || kind == xmlEncNamespace + "Content")
			try decryptXML(e, keys, doc)
			let want = try new XML().parse(expected)
			return string(canonicalize(doc, C14N.Inclusive10)) == string(canonicalize(want, C14N.Inclusive10))
		}

		internal def kindOf(xml string, keys XMLKeys) !?XMLEncryptionErrorKind {
			let doc = try new XML().parse(xml)
			let kind ?XMLEncryptionErrorKind = none
			decryptXMLData(firstEncrypted(doc), keys, doc) onerror (err error) {
				kind = err.kind when err is XMLEncryptionError
				recover byte[]
			}
			return kind
		}

		internal def named(name string, hex string) !XMLKeys {
			let keys = XMLKeys{}
			keys.named.set(name, try hexdecode(hex))
			return keys
		}

		@test()
		def TestDecryptKeyTransport() !none {
			assert try decrypts(w3cRsaOaepXml, w3cRsaOaepData, XMLKeys{privateKeys: [try privateKey(rsa2048W3c)]})
			assert try decrypts(w3cRsaOaep11Xml, w3cRsaOaep11Data, XMLKeys{privateKeys: [try privateKey(rsa3072W3c)]})
			// RSA 1.5 only with allowRsa15.
			let rsa = try privateKey(merlinRsa)
			let refused = try kindOf(merlinRsa15Xml, XMLKeys{privateKeys: [rsa]})
			assert !(refused is none) && refused == XMLEncryptionErrorKind.Unsupported
			assert try decrypts(merlinRsa15Xml, merlinRsa15Data, XMLKeys{privateKeys: [rsa], allowRsa15: true})
			// A key that does not fit: the RSA 1.5 path still runs the data
			// decryption and fails as a wrong key would.
			let other = try kindOf(merlinRsa15Xml, XMLKeys{privateKeys: [try privateKey(rsa2048W3c)], allowRsa15: true})
			assert !(other is none) && other == XMLEncryptionErrorKind.DecryptionFailed
			// MD5 is refused.
			let md5 = try kindOf(oaepMd5Xml, XMLKeys{privateKeys: [try privateKey(rsa4096)]})
			assert !(md5 is none) && md5 == XMLEncryptionErrorKind.Unsupported
		}

		@test()
		def TestDecryptAgreement() !none {
			assert try decrypts(w3cEcdhXml, w3cEcdhData, XMLKeys{privateKeys: [try privateKey(ecW3c)]})
			let dh = try crypto.parseDHPrivateKey(try der(dhW3c))
			assert try decrypts(w3cDhEsXml, w3cDhEsData, XMLKeys{dhKeys: [dh]})
			// XML-Enc 1.0 dh with KA-Nonce, the originator's key in a certificate.
			let phaos = try crypto.parseDHPrivateKey(try der(phaosDhKey))
			assert try decrypts(phaosDhXml, phaosDhData, XMLKeys{dhKeys: [phaos]})
			// Static originators named in OriginatorKeyInfo.
			let x = XMLKeys{privateKeys: [try privateKey(x25519Key)]}
			x.originators.set("originator-key-name", try crypto.parsePKIXPublicKey(try der(x25519Originator)))
			assert try decrypts(x25519Xml, x25519Data, x)
			let x4 = XMLKeys{privateKeys: [try privateKey(x448Key)]}
			x4.originators.set("originator-key-name", try crypto.parsePKIXPublicKey(try der(x448Originator)))
			assert try decrypts(x448HkdfXml, x448HkdfData, x4)
			let ec = XMLKeys{privateKeys: [try privateKey(ecKey)]}
			ec.originators.set("originator-key-name", try crypto.parsePKIXPublicKey(try der(ecOriginator)))
			assert try decrypts(ecdhPbkdf2Xml, ecdhPbkdf2Data, ec)
			// Without the originator's key there is nothing to agree with.
			let missing = try kindOf(x25519Xml, XMLKeys{privateKeys: [try privateKey(x25519Key)]})
			assert !(missing is none) && missing == XMLEncryptionErrorKind.NoKey
		}

		@test()
		def TestDecryptSymmetric() !none {
			assert try decrypts(w3cGcmXml, w3cGcmData, XMLKeys{secret: try hexdecode(w3cGcmKey)})
			assert try decrypts(merlin3desKwXml, merlin3desKwData, try named("bob", merlinBob))
			assert try decrypts(merlinRetrievedXml, merlinRetrievedData, try named("jed", merlinJed))
			assert try decrypts(merlinContentXml, merlinContentData, try named("bob", merlinBob))
			assert try decrypts(chacha20Xml, chacha20Data, try named("test-chacha20", testChacha20))
			assert try decrypts(chacha20AadXml, chacha20AadData, try named("test-chacha20poly1305", testChacha20Poly1305))
			// A key encrypted with a block cipher (aes192-cbc), not a key wrap.
			let block = try named("test-aes192", testAes192)
			block.named.set("test-des", try hexdecode(testDes))
			assert try decrypts(blockKeyEncXml, blockKeyEncData, block)
			let camellia = try named("test-camellia256", camellia256Key)
			camellia.named.set("test-camellia128", try hexdecode(camellia128Key))
			assert try decrypts(camelliaXml, camelliaData, camellia)
			assert try decrypts(hkdfDerivedXml, hkdfDerivedData, try named("hkdf-ikm", hkdfIkm))
			assert try decrypts(pbkdf2DerivedXml, pbkdf2DerivedData, try named("pbkdf2-ikm", pbkdf2Password))
			// PBKDF2 past maxIterations is refused before it runs.
			let capped = try named("pbkdf2-ikm", pbkdf2Password)
			capped.maxIterations = 10
			let spun = try kindOf(pbkdf2DerivedXml, capped)
			assert !(spun is none) && spun == XMLEncryptionErrorKind.Unsupported
			// CBC only with allowCbc; XPath CipherReference transforms are refused.
			let noCbc = try named("bob", merlinBob)
			noCbc.allowCbc = false
			let cbc = try kindOf(merlinContentXml, noCbc)
			assert !(cbc is none) && cbc == XMLEncryptionErrorKind.Unsupported
			let xpath = try kindOf(merlinXPathRefXml, try named("job", merlinJob))
			assert !(xpath is none) && xpath == XMLEncryptionErrorKind.Unsupported
			// A changed GCM cipher text and a wrong key both fail alike.
			let changed = w3cGcmXml.replace("CipherValue>", "CipherValue>AAAA")
			let tampered = try kindOf(changed, XMLKeys{secret: try hexdecode(w3cGcmKey)})
			assert !(tampered is none) && (tampered == XMLEncryptionErrorKind.DecryptionFailed || tampered == XMLEncryptionErrorKind.Malformed)
			let wrong = try kindOf(w3cGcmXml, XMLKeys{secret: try hexdecode("00112233445566778899aabbccddeeff")})
			assert !(wrong is none) && wrong == XMLEncryptionErrorKind.DecryptionFailed
		}

		internal const sample = "<root xmlns=\"urn:r\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xs=\"http://www.w3.org/2001/XMLSchema\"><head>h</head><card ID=\"c1\"><number xsi:type=\"xs:string\">4019 2445</number><!-- note --><exp>04/02</exp></card><tail/></root>"

		internal def roundTrip(recipients XMLRecipient[], method XMLEncryption, keys XMLKeys) !bool {
			let doc = try strictXML().parse(sample)
			let encrypted = try encryptXML(doc.children[1], recipients, method, doc)
			// Through text and back, as a receiver gets it.
			let again = try strictXML().parse(doc.str())
			let found = again.descendants("EncryptedData", xmlEncNamespace)
			fail "no EncryptedData" when found.len() != 1 || encrypted.localName != "EncryptedData"
			try decryptXML(found[0], keys, again)
			let want = try strictXML().parse(sample)
			return string(canonicalize(again, C14N.Inclusive10Comments)) == string(canonicalize(want, C14N.Inclusive10Comments))
		}

		@test()
		def TestRoundTrips() !none {
			let rsa = try crypto.generateRSAKey(2048)
			let rsaPublic = crypto.publicKeyOf(rsa)
			let rsaKeys = XMLKeys{privateKeys: [rsa], allowRsa15: true}
			assert try roundTrip([XMLRecipient{key:rsaPublic}], XMLEncryption{}, rsaKeys)
			assert try roundTrip([XMLRecipient{key:rsaPublic}], XMLEncryption{transport: KeyTransport.RsaOaepMgf1p, oaepDigest: DigestMethod.Sha1, data: DataEncryption.Aes128Cbc}, rsaKeys)
			assert try roundTrip([XMLRecipient{key:rsaPublic}], XMLEncryption{transport: KeyTransport.Rsa15, data: DataEncryption.TripleDesCbc}, rsaKeys)
			assert try roundTrip([XMLRecipient{key:rsaPublic}], XMLEncryption{content: true, data: DataEncryption.Aes192Gcm}, rsaKeys)
			let ec = try crypto.generateECDSAKey(crypto.p384)
			assert try roundTrip([XMLRecipient{key:crypto.publicKeyOf(ec)}], XMLEncryption{data: DataEncryption.Aes192Gcm, wrap: KeyWrap.Aes192Kw, derivation: KeyDerivation.Hkdf, kdfDigest: DigestMethod.Sha384}, XMLKeys{privateKeys: [ec]})
			assert try roundTrip([XMLRecipient{key:crypto.publicKeyOf(ec)}], XMLEncryption{derivation: KeyDerivation.Pbkdf2, iterations: 1000}, XMLKeys{privateKeys: [ec]})
			let x = try crypto.generateX25519Key()
			assert try roundTrip([XMLRecipient{key:x.public}], XMLEncryption{data: DataEncryption.ChaCha20Poly1305, aad: "fox"}, XMLKeys{privateKeys: [x]})
			let x4 = try crypto.generateX448Key()
			assert try roundTrip([XMLRecipient{key:x4.public}], XMLEncryption{data: DataEncryption.ChaCha20}, XMLKeys{privateKeys: [x4]})
			let dhParams = (try crypto.parseDHPrivateKey(try der(dhW3c))).params
			let dh = try crypto.generateDHKey(dhParams)
			assert try roundTrip([XMLRecipient{dh:dh.public}], XMLEncryption{data: DataEncryption.Aes128Gcm, wrap: KeyWrap.Aes128Kw}, XMLKeys{dhKeys: [dh]})
			let kek = try hexdecode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
			let kekKeys = XMLKeys{}
			kekKeys.named.set("k", kek)
			assert try roundTrip([XMLRecipient{kek:kek, name:"k"}], XMLEncryption{}, kekKeys)
			let pad = XMLKeys{}
			pad.named.set("p", kek[0:16])
			assert try roundTrip([XMLRecipient{kek:kek[0:16], name:"p"}], XMLEncryption{wrap: KeyWrap.Aes128KwPad, data: DataEncryption.Aes128Gcm}, pad)
			let des = try hexdecode("0123456789abcdeffedcba98765432100123456789abcdef")
			let desKeys = XMLKeys{}
			desKeys.named.set("d", des)
			assert try roundTrip([XMLRecipient{kek:des, name:"d"}], XMLEncryption{wrap: KeyWrap.TripleDesKw, data: DataEncryption.TripleDesCbc}, desKeys)
			let cam = XMLKeys{}
			cam.named.set("c", kek[0:24])
			assert try roundTrip([XMLRecipient{kek:kek[0:24], name:"c"}], XMLEncryption{wrap: KeyWrap.Camellia192Kw, data: DataEncryption.Camellia128Cbc}, cam)
			let pw = XMLKeys{}
			pw.named.set("pw", "correct horse".bytes())
			assert try roundTrip([XMLRecipient{password:"correct horse", name:"pw"}], XMLEncryption{iterations: 2000}, pw)
			// Two recipients: either key opens it.
			assert try roundTrip([XMLRecipient{key:x.public}, XMLRecipient{key:rsaPublic}], XMLEncryption{}, rsaKeys)
			assert try roundTrip([XMLRecipient{key:x.public}, XMLRecipient{key:rsaPublic}], XMLEncryption{}, XMLKeys{privateKeys: [x]})
			// Ed25519 cannot encrypt.
			let ed = try crypto.generateEd25519Key()
			let doc = try strictXML().parse(sample)
			let refused = encryptXML(doc.children[1], crypto.publicKeyOf(ed), XMLEncryption{}, doc) onerror (err error) {
				assert err is XMLEncryptionError && err.kind == XMLEncryptionErrorKind.KeyMismatch
				recover doc
			}
			assert refused == doc
		}

		@test()
		def TestPlacement() !none {
			let key = try hexdecode("000102030405060708090a0b0c0d0e0f")
			// The root itself: the document becomes the EncryptedData.
			let doc = try strictXML().parse(sample)
			let encrypted = try encryptXML(doc, key, XMLEncryption{data: DataEncryption.Aes128Gcm}, doc)
			assert doc.localName == "EncryptedData" && encrypted.localName == "EncryptedData"
			let back = try decryptXML(doc, key, doc)
			assert back.len() == 1 && doc.localName == "root"
			// Octets with a MimeType.
			let data = try encryptXMLData("hello".bytes(), [XMLRecipient{kek:key, name:"k"}], XMLEncryption{wrap: KeyWrap.Aes128Kw, mimeType: "text/plain"})
			let keys = XMLKeys{}
			keys.named.set("k", key)
			assert string(try decryptXMLData(data, keys)) == "hello"
			let mime = data.attribute("MimeType")
			assert !(mime is none) && mime == "text/plain"
			assert decryptXML(data, keys) is error
			// SAML puts the EncryptedKey beside the EncryptedData.
			let saml = try strictXML().parse("<EncryptedAssertion xmlns=\"urn:oasis:names:tc:SAML:2.0:assertion\"><Assertion ID=\"a\"><Subject>alice</Subject></Assertion></EncryptedAssertion>")
			let rsa = try crypto.generateRSAKey(2048)
			let sealed = try encryptXML(saml.children[0], [XMLRecipient{key:crypto.publicKeyOf(rsa)}], XMLEncryption{}, saml)
			let info = sealed.child("KeyInfo", xmlDsigNamespace)
			fail "no KeyInfo" when info is none
			let ek = info.children[0]
			sealed.children = sealed.children.filter(c => c.localName != "KeyInfo")
			saml.children.push(ek)
			let text = saml.str()
			let parsed = try strictXML().parse(text)
			let nodes = try decryptXML(parsed.children[0], rsa, parsed)
			assert nodes.len() == 1 && nodes[0].localName == "Assertion" && parsed.children[0].localName == "Assertion"
		}
	}
}
