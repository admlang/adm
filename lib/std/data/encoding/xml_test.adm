partial module std.data.encoding {
	check "XML" {
		use std.testing

		@test()
		def isValidChecksTagStructure() {
			let codec = new XML()
			assert codec.isValid("<a/>")
			assert codec.isValid("<?xml version=\"1.0\"?><!-- c --><root a=\"1\"><b>text</b><c/></root>")
			assert codec.isValid("<r><![CDATA[<not a tag>]]></r>")
			assert !codec.isValid("")
			assert !codec.isValid("text")
			assert !codec.isValid("<a>")
			assert !codec.isValid("<a></b>")
			assert !codec.isValid("<a><b></a></b>")
			assert !codec.isValid("<a b=1/>")
			assert !codec.isValid("<a/><b/>")
		}
	}
}
