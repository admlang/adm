partial module std.data.encoding {
	use (
		std.bytes
		std.errors
	)

	// Namespace URI of the `xml` prefix, bound in every document.
	internal const xmlNamespaceURI = "http://www.w3.org/XML/1998/namespace"

	// Namespace URI of `xmlns` declarations.
	internal const xmlnsNamespaceURI = "http://www.w3.org/2000/xmlns/"

	// XMLNodeKind names what an XMLNode is.
	enum XMLNodeKind {
		// An element. Uses `name`, `prefix`, `localName`, `namespace`,
		// `attributes` and `children`.
		Element,
		// Character data, CDATA sections included. Uses `content`.
		Text,
	}

	// XMLAttribute is one attribute of an element.
	struct XMLAttribute {
		// Name as written, prefix included: "w:val".
		name      string
		// Prefix of the name, empty when it has none.
		prefix    string
		// Name without the prefix: "val".
		localName string
		// Namespace URI the prefix is bound to. An attribute without a prefix is
		// in no namespace, so this is empty for it.
		namespace string
		// Value with references decoded.
		value     string
	}

	// XMLNode is one node of an XML tree: an element with its attributes and
	// children, or a run of text, as `kind` says. `XML.parse` returns the root
	// element of a document; comments, processing instructions and the
	// document type declaration are not kept.
	//
	// Example: Read a value
	// ```example
	// use std.data.encoding::(XML)
	//
	// let root = try new XML().parse("<a xmlns='urn:x'><b id='1'>hi</b></a>")
	// let b = root.child("b", "urn:x")
	// println(b.attribute("id"), b.text())
	// ```
	type XMLNode {
		kind       XMLNodeKind
		// Element name as written, prefix included: "w:p".
		name       string
		// Prefix of the name, empty when it has none.
		prefix     string
		// Name without the prefix: "p".
		localName  string
		// Namespace URI the element is in, empty when none is declared.
		namespace  string
		attributes XMLAttribute[]
		// Characters of a Text node.
		content    string
		children   XMLNode[]

		// new returns an element with the name as written ("w:p" or "p") in the
		// namespace, with no attributes or children.
		def new(name string, namespace string = "") {
			kind = XMLNodeKind.Element
			self.name = name
			self.namespace = namespace
			let colon = name.indexOf(":")
			if colon > 0 {
				prefix = name[:colon]
				localName = name[colon + 1:]
			} else {
				localName = name
			}
			attributes = XMLAttribute[]
			children = XMLNode[]
		}

		// child returns the first child element with the local name, in the
		// namespace when one is given, in any namespace otherwise. None when
		// there is no such child.
		def child(localName string, namespace string = "") ?XMLNode {
			for let (_, node) in children {
				return node when node.matches(localName, namespace)
			}
			return none
		}

		// elements returns the child elements with the local name, in the
		// namespace when one is given; every child element when the name is
		// empty.
		def elements(localName string = "", namespace string = "") XMLNode[] {
			let out = XMLNode[]
			for let (_, node) in children {
				out.push(node) when node.matches(localName, namespace)
			}
			return out
		}

		// descendants returns every element below this one with the local name,
		// in the namespace when one is given, in document order.
		def descendants(localName string, namespace string = "") XMLNode[] {
			let out = XMLNode[]
			walk(def (node XMLNode) bool {
				out.push(node) when node.matches(localName, namespace)
				return true
			})
			return out
		}

		// attribute returns the value of an attribute, none when the element
		// has no such attribute. Without a namespace the name is compared with
		// the name as written ("w:val", or "id" for an attribute that has no
		// prefix); with one, the local name and the namespace are compared.
		def attribute(name string, namespace string = "") ?string {
			for let (_, attr) in attributes {
				if namespace == "" {
					return attr.value when attr.name == name
				} else if attr.localName == name && attr.namespace == namespace {
					return attr.value
				}
			}
			return none
		}

		// text returns the characters of the node and of every node below it,
		// in document order.
		def text() string {
			return content when kind == XMLNodeKind.Text
			return children[0].text() when children.len() == 1
			let out = new bytes.Buffer()
			collectText(out)
			return string(out.bytes())
		}

		internal def collectText(out bytes.Buffer) {
			if kind == XMLNodeKind.Text {
				out.writeString(content) onerror recover 0
				return
			}
			for let (_, node) in children {
				node.collectText(out)
			}
		}

		// set gives the element an attribute, replacing the value of one with
		// the same name as written, and returns the element. The namespace is
		// recorded for lookups; the declaration of its prefix is an attribute
		// of its own (`xmlns:w`).
		def set(name string, value string, namespace string = "") XMLNode {
			for let (i, attr) in attributes {
				if attr.name == name {
					attributes[i] = XMLAttribute{...attr, value: value}
					return self
				}
			}
			let colon = name.indexOf(":")
			let head = colon > 0 ?? (name[:colon], "")
			let tail = colon > 0 ?? (name[colon + 1:], name)
			attributes.push(XMLAttribute{name: name, prefix: head, localName: tail, namespace: namespace, value: value})
			return self
		}

		// add appends the node to the children and returns it.
		def add(node XMLNode) XMLNode {
			children.push(node)
			return node
		}

		// add appends a Text node holding the characters, joining it to a Text
		// node the children end with.
		def add(content string) {
			let count = children.len()
			if count > 0 && children[count - 1].kind == XMLNodeKind.Text {
				children[count - 1].content += content
				return
			}
			let node = new XMLNode("")
			node.kind = XMLNodeKind.Text
			node.content = content
			children.push(node)
		}

		// walk visits every element below this one in document order, parents
		// before children, until visit returns false.
		def walk(visit def (XMLNode) bool) {
			walkNodes(self, visit)
		}

		// str returns the node as XML markup, without a declaration.
		def str() string {
			let writer = new XMLWriter()
			writer.node(self)
			return writer.str()
		}

		internal def matches(localName string, namespace string) bool {
			return false unless kind == XMLNodeKind.Element
			return false unless localName == "" || self.localName == localName
			return namespace == "" || self.namespace == namespace
		}
	}

	internal def walkNodes(node XMLNode, visit def (XMLNode) bool) bool {
		for let (_, child) in node.children {
			continue unless child.kind == XMLNodeKind.Element
			return false unless visit(child)
			return false unless walkNodes(child, visit)
		}
		return true
	}

	// XMLWriter writes XML markup in document order: start tags, attributes,
	// text and end tags, escaping what needs it. An element with no content is
	// written as an empty-element tag (`<a/>`).
	//
	// Example: Write a document
	// ```example
	// use std.data.encoding::(XMLWriter)
	//
	// let w = new XMLWriter()
	// w.declaration()
	// w.start("note")
	// w.attribute("lang", "en")
	// w.text("Fish & chips")
	// w.end()
	// println(w.str())
	// ```
	type XMLWriter {
		internal out   byte[]
		internal open  string[]
		// A start tag has been written up to its attributes; `>` is still due.
		internal inTag bool

		def new() {
			out = byte[]
			open = string[]
		}

		// declaration writes the XML declaration, version 1.0 in UTF-8, marked
		// standalone when asked.
		def declaration(standalone bool = false) {
			let tail = standalone ?? (" standalone=\"yes\"", "")
			put("<?xml version=\"1.0\" encoding=\"UTF-8\"{tail}?>\n")
		}

		// start opens an element. Attributes follow with `attribute`, until
		// content or `end`.
		def start(name string) {
			closeTag()
			out.push(byte('<'))
			put(name)
			open.push(name)
			inTag = true
		}

		// attribute adds an attribute to the element just started. It is left
		// out when the start tag is already closed by content.
		def attribute(name string, value string) {
			return unless inTag
			out.push(byte(' '))
			put(name)
			out.push(byte('='), byte('"'))
			escape(value, true)
			out.push(byte('"'))
		}

		// text writes character data, escaping `&`, `<` and `>`. Characters
		// XML does not allow are left out.
		def text(content string) {
			closeTag()
			escape(content, false)
		}

		// raw writes the markup as it is.
		def raw(markup string) {
			closeTag()
			put(markup)
		}

		// end closes the innermost open element. Nothing happens when none is
		// open.
		def end() {
			return when open.len() == 0
			let name = open.pop()
			if inTag {
				out.push(byte('/'), byte('>'))
				inTag = false
				return
			}
			out.push(byte('<'), byte('/'))
			put(name)
			out.push(byte('>'))
		}

		// element writes an element holding only text: `<name>text</name>`.
		def element(name string, content string) {
			start(name)
			text(content) unless content == ""
			end()
		}

		// node writes the node and everything below it.
		def node(n XMLNode) {
			if n.kind == XMLNodeKind.Text {
				text(n.content)
				return
			}
			start(n.name)
			for let (_, attr) in n.attributes {
				attribute(attr.name, attr.value)
			}
			for let (_, child) in n.children {
				node(child)
			}
			end()
		}

		// bytes returns the markup written so far, closing the elements still
		// open.
		def bytes() byte[] {
			for open.len() > 0 {
				end()
			}
			return out
		}

		// str returns the markup written so far as text, closing the elements
		// still open.
		def str() string {
			return string(bytes())
		}

		internal def closeTag() {
			return unless inTag
			out.push(byte('>'))
			inTag = false
		}

		internal def put(s string) {
			out.push(...s.bytes())
		}

		// escape writes the text with the characters markup would misread as
		// references; in an attribute, quotes and the white space attribute
		// normalization would fold as well.
		internal def escape(s string, attr bool) {
			let src = s.bytes()
			let start = 0
			for let i = 0; i < src.len(); i++ {
				let c = int(src[i])
				let entity = ""
				if c == 0x26 {
					entity = "&amp;"
				} else if c == 0x3C {
					entity = "&lt;"
				} else if c == 0x3E {
					entity = "&gt;"
				} else if c < 0x20 {
					if attr && c == 0x09 {
						entity = "&#9;"
					} else if attr && c == 0x0A {
						entity = "&#10;"
					} else if c == 0x0D {
						entity = "&#13;"
					} else if c != 0x09 && c != 0x0A {
						entity = " "
					}
				} else if attr && c == 0x22 {
					entity = "&quot;"
				}
				continue when entity == ""
				out.push(...src[start:i])
				put(entity) unless entity == " "
				start = i + 1
			}
			out.push(...src[start:])
		}
	}

	// XMLParser builds an XMLNode tree from the bytes of a document.
	internal type XMLParser {
		data     byte[]
		pos      int
		// Prefix and URI of each namespace declaration in scope, innermost
		// last.
		prefixes string[]
		uris     string[]

		def new(data byte[]) {
			self.data = data
			prefixes = string["xml"]
			uris = string[xmlNamespaceURI]
		}

		def document() !XMLNode {
			pos = 3 when data.len() >= 3 && int(data[0]) == 0xEF && int(data[1]) == 0xBB && int(data[2]) == 0xBF
			let stack = XMLNode[]
			// Namespace declarations each open element pushed.
			let scopes = int[]
			let n = data.len()
			for pos < n {
				let c = char(data[pos])
				if c != '<' {
					let start = pos
					let at = data[pos:].indexOf(byte('<'))
					pos = at < 0 ?? (n, pos + at)
					if stack.len() > 0 {
						stack[stack.len() - 1].add(decodeText(data[start:pos], false))
					} else {
						try outsideText(start)
					}
					continue
				}
				if startsWith("<!--") {
					try skipPast("-->", "comment")
				} else if startsWith("<![CDATA[") {
					let start = pos + 9
					try skipPast("]]>", "CDATA section")
					fail failure(start, "CDATA section outside the root element") when stack.len() == 0
					stack[stack.len() - 1].add(string(data[start:pos - 3]))
				} else if startsWith("<?") {
					try skipPast("?>", "processing instruction")
				} else if startsWith("<!") {
					try skipDoctype()
				} else if startsWith("</") {
					let at = pos
					pos += 2
					let name = readName()
					skipSpace()
					fail failure(at, "malformed end tag") unless pos < n && char(data[pos]) == '>'
					pos++
					fail failure(at, "end tag </{name}> without a start tag") when stack.len() == 0
					let top = stack.pop()
					fail failure(at, "end tag </{name}> does not match <{top.name}>") unless top.name == name
					let count = scopes.pop()
					prefixes.len(prefixes.len() - count)
					uris.len(uris.len() - count)
					if stack.len() == 0 {
						try trailing()
						return top
					}
				} else {
					let (element, selfClosing, declared) = try startTag()
					stack[stack.len() - 1].add(element) when stack.len() > 0
					if selfClosing {
						prefixes.len(prefixes.len() - declared)
						uris.len(uris.len() - declared)
						if stack.len() == 0 {
							try trailing()
							return element
						}
					} else {
						stack.push(element)
						scopes.push(declared)
					}
				}
			}
			fail failure(n, "element <{stack[stack.len() - 1].name}> is not closed") when stack.len() > 0
			fail failure(n, "no root element")
		}

		// trailing checks that only white space, comments and processing
		// instructions follow the root element.
		def trailing() !none {
			let n = data.len()
			for pos < n {
				let c = char(data[pos])
				if c := ' ' || '\t' || '\n' || '\r' {
					pos++
				} else if startsWith("<!--") {
					try skipPast("-->", "comment")
				} else if startsWith("<?") {
					try skipPast("?>", "processing instruction")
				} else {
					fail failure(pos, "content after the root element")
				}
			}
		}

		def outsideText(start int) !none {
			for let i = start; i < pos; i++ {
				let c = char(data[i])
				fail failure(i, "text outside the root element") unless c := ' ' || '\t' || '\n' || '\r'
			}
		}

		// startTag reads `<name attr="value" ...>` or `.../>`, returning the
		// element, whether it was empty and how many namespace declarations it
		// pushed.
		def startTag() !(XMLNode, bool, int) {
			let at = pos
			pos++
			let name = readName()
			fail failure(at, "malformed start tag") when name == ""
			let element = new XMLNode(name)
			let declared = 0
			let n = data.len()
			let selfClosing = false
			for {
				let before = pos
				skipSpace()
				fail failure(at, "start tag <{name}> is not closed") when pos >= n
				let c = char(data[pos])
				if c == '>' {
					pos++
					break
				}
				if c == '/' {
					fail failure(pos, "malformed empty-element tag <{name}/>") unless pos + 1 < n && char(data[pos + 1]) == '>'
					pos += 2
					selfClosing = true
					break
				}
				fail failure(pos, "attributes of <{name}> need white space between them") when before == pos
				let attrAt = pos
				let attrName = readName()
				fail failure(attrAt, "malformed attribute in <{name}>") when attrName == ""
				skipSpace()
				fail failure(attrAt, "attribute {attrName} has no value") unless pos < n && char(data[pos]) == '='
				pos++
				skipSpace()
				fail failure(attrAt, "value of attribute {attrName} is not quoted") unless pos < n && (char(data[pos]) == '"' || char(data[pos]) == '\'')
				let quote = data[pos]
				pos++
				let start = pos
				let end = data[pos:].indexOf(quote)
				fail failure(attrAt, "value of attribute {attrName} is not closed") when end < 0
				pos += end + 1
				let value = decodeText(data[start:start + end], true)
				element.attributes.push(XMLAttribute{name: attrName, value: value})
				if attrName == "xmlns" {
					prefixes.push("")
					uris.push(value)
					declared++
				} else if attrName.startsWith("xmlns:") {
					prefixes.push(attrName[6:])
					uris.push(value)
					declared++
				}
			}

			element.namespace = resolve(element.prefix, true)
			for let (i, attr) in element.attributes {
				let colon = attr.name.indexOf(":")
				let resolved = XMLAttribute{...attr, localName: attr.name}
				if colon > 0 {
					let prefix = attr.name[:colon]
					let uri = prefix == "xmlns" ?? (xmlnsNamespaceURI, resolve(prefix, false))
					resolved = XMLAttribute{...attr, prefix: prefix, localName: attr.name[colon + 1:], namespace: uri}
				} else if attr.name == "xmlns" {
					resolved = XMLAttribute{...resolved, namespace: xmlnsNamespaceURI}
				}
				element.attributes[i] = resolved
			}
			return (element, selfClosing, declared)
		}

		// resolve returns the URI the prefix is bound to; an selfClosing prefix of an
		// element takes the default namespace, of an attribute none. An unbound
		// prefix resolves to the selfClosing string.
		def resolve(prefix string, element bool) string {
			return "" when prefix == "" && !element
			for let i = prefixes.len() - 1; i >= 0; i-- {
				return uris[i] when prefixes[i] == prefix
			}
			return ""
		}

		def readName() string {
			let start = pos
			let n = data.len()
			for pos < n {
				let c = int(data[pos])
				let ok = (c >= 0x61 && c <= 0x7A) || (c >= 0x41 && c <= 0x5A) || c == 0x5F || c == 0x3A || c >= 0x80
				ok = ok || (pos > start && ((c >= 0x30 && c <= 0x39) || c == 0x2D || c == 0x2E))
				break unless ok
				pos++
			}
			return string(data[start:pos])
		}

		def skipSpace() {
			let n = data.len()
			for pos < n {
				let c = char(data[pos])
				break unless c := ' ' || '\t' || '\n' || '\r'
				pos++
			}
		}

		def startsWith(prefix string) bool {
			let p = prefix.bytes()
			return false when pos + p.len() > data.len()
			for let i = 0; i < p.len(); i++ {
				return false unless data[pos + i] == p[i]
			}
			return true
		}

		// skipPast moves past the next occurrence of the terminator, failing
		// when there is none.
		def skipPast(terminator string, what string) !none {
			let t = terminator.bytes()
			let at = pos
			let n = data.len()
			let i = pos + 1
			for i + t.len() <= n {
				let next = data[i:].indexOf(t[0])
				break when next < 0
				i += next
				let hit = i + t.len() <= n
				for let k = 1; hit && k < t.len(); k++ {
					hit = data[i + k] == t[k]
				}
				if hit {
					pos = i + t.len()
					return none
				}
				i++
			}
			fail failure(at, "{what} is not closed")
		}

		// skipDoctype moves past `<!DOCTYPE ...>`, internal subset included.
		def skipDoctype() !none {
			let at = pos
			let n = data.len()
			let depth = 0
			let quote = 0
			pos += 2
			for pos < n {
				let c = int(data[pos])
				pos++
				if quote != 0 {
					quote = 0 when c == quote
				} else if c == 0x22 || c == 0x27 {
					quote = c
				} else if c == 0x5B {
					depth++
				} else if c == 0x5D {
					depth--
				} else if c == 0x3E && depth <= 0 {
					return none
				}
			}
			fail failure(at, "document type declaration is not closed")
		}

		// decodeText returns the characters with references decoded and line
		// ends normalized; in an attribute value, white space characters
		// become spaces.
		def decodeText(raw byte[], attr bool) string {
			let simple = true
			for let i = 0; i < raw.len(); i++ {
				let c = int(raw[i])
				if c == 0x26 || c == 0x0D || (attr && (c == 0x09 || c == 0x0A)) {
					simple = false
					break
				}
			}
			return string(raw) when simple

			let out = byte[]
			let i = 0
			let n = raw.len()
			for i < n {
				let c = int(raw[i])
				if c == 0x0D {
					out.push(attr ?? (byte(' '), byte('\n')))
					i++
					i++ when i < n && int(raw[i]) == 0x0A
					continue
				}
				if attr && (c == 0x09 || c == 0x0A) {
					out.push(byte(' '))
					i++
					continue
				}
				if c != 0x26 {
					out.push(raw[i])
					i++
					continue
				}
				let end = i + 1
				for end < n && end - i < 40 && int(raw[end]) != 0x3B && int(raw[end]) != 0x26 {
					end++
				}
				let decoded ?string = none
				decoded = decodeXMLReference(string(raw[i + 1:end])) when end < n && int(raw[end]) == 0x3B
				if decoded is none {
					out.push(raw[i])
					i++
					continue
				}
				out.push(...decoded.bytes())
				i = end + 1
			}
			return string(out)
		}

		def failure(at int, message string) XMLError {
			let line = 1
			let limit = at < data.len() ?? (at, data.len())
			for let i = 0; i < limit; i++ {
				line++ when int(data[i]) == 0x0A
			}
			return XMLError{message: "xml: line {line}: {message}", line: line}
		}
	}

	// XMLError is the payload of a document `XML.parse` rejects.
	struct XMLError {
		message string
		code    string            = "xml"
		cause   ?error
		stack   errors.StackTrace
		// Line of the document the error was found on, counted from 1.
		line    int
	}

	// decodeXMLReference decodes the reference between `&` and `;`: one of the
	// five XML entities, a character reference, or a named HTML entity. None
	// when it is none of those.
	internal def decodeXMLReference(entity string) ?string {
		return decodeHTMLEntity(entity)
	}
}
