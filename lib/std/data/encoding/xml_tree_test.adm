partial module std.data.encoding {
	check "XML tree" {
		use std.testing

		// value returns the attribute value, or "<none>".
		def value(found ?string) string {
			return found is none ?? ("<none>", found)
		}

		// value returns the text of the element, or "<none>".
		def value(found ?XMLNode) string {
			return found is none ?? ("<none>", found.text())
		}

		@test()
		def TestParseElements() !none {
			let xml = new XML()
			let root = try xml.parse("<?xml version=\"1.0\"?>\n<!-- c --><root a=\"1\" b='two'><item>one</item><item/><other>x</other></root>\n")
			assert root.name == "root"
			assert value(root.attribute("a")) == "1"
			assert value(root.attribute("b")) == "two"
			assert root.attribute("c") is none
			assert root.elements().len() == 3
			assert root.elements("item").len() == 2
			assert value(root.child("other")) == "x"
			assert root.child("missing") is none
			assert root.text() == "onex"
		}

		@test()
		def TestParseNamespaces() !none {
			let source = "<w:document xmlns:w=\"urn:w\" xmlns=\"urn:d\"><w:p w:val=\"on\" plain=\"p\"><x/></w:p><w:p xmlns:w=\"urn:other\"/></w:document>"
			let root = try new XML().parse(source)
			assert root.prefix == "w"
			assert root.localName == "document"
			assert root.namespace == "urn:w"
			let first = root.child("p", "urn:w")
			fail "no p" when first is none
			assert value(first.attribute("w:val")) == "on"
			assert value(first.attribute("val", "urn:w")) == "on"
			assert value(first.attribute("plain")) == "p"
			assert first.attributes[1].namespace == ""
			let x = first.child("x")
			fail "no x" when x is none
			assert x.namespace == "urn:d"
			assert root.elements("p", "urn:w").len() == 1
			assert root.elements("p", "urn:other").len() == 1
			assert root.elements("p").len() == 2
			assert value(root.attribute("w", "http://www.w3.org/2000/xmlns/")) == "urn:w"
		}

		@test()
		def TestParseText() !none {
			let root = try new XML().parse("<t a=\"x&amp;y&#10;z\tq\">A &lt;b&gt; &#65;&#x42; &quot;&apos; &nbsp;<![CDATA[<raw> & ]]>\r\nend &unknown; & tail</t>")
			assert value(root.attribute("a")) == "x&y\nz q"
			assert root.text() == "A <b> AB \"'  <raw> & \nend &unknown; & tail"
			assert root.children.len() == 1
		}

		@test()
		def TestParseDoctypeAndWhitespace() !none {
			let root = try new XML().parse("<!DOCTYPE html [ <!ENTITY x \"]>\"> ]>\n<html>\n  <body> <p>a</p> </body>\n</html>\n<!-- after -->")
			assert root.name == "html"
			let body = root.child("body")
			fail "no body" when body is none
			assert body.children.len() == 3
			assert body.children[0].kind == XMLNodeKind.Text
			assert body.children[0].content == " "
			assert body.descendants("p").len() == 1
		}

		@test()
		def TestParseBOM() !none {
			let data = byte[0xEF, 0xBB, 0xBF] + "<a>é</a>".bytes()
			let root = try new XML().parse(data)
			assert root.text() == "é"
		}

		@test()
		def TestParseErrors() {
			let xml = new XML()
			let bad = string["", "text", "<a>", "<a></b>", "<a><b></a></b>", "<a b=1/>", "<a/><b/>", "<a b=\"1\"c=\"2\"/>", "<a><!-- open</a>", "x<a/>", "<a/>x", "<a b></a>"]
			for let (_, source) in bad {
				let failed = false
				xml.parse(source) onerror (err error) {
					failed = true
					recover new XMLNode("")
				}
				assert failed
			}

			let line = 0
			xml.parse("<a>\n<b>\n</c></a>") onerror (err error) {
				line = err.line when err is XMLError
				recover new XMLNode("")
			}
			assert line == 3
		}

		@test()
		def TestWalkAndDescendants() !none {
			let root = try new XML().parse("<a><b><c/></b><c><c/></c></a>")
			let names = string[]
			root.walk(def (node XMLNode) bool {
				names.push(node.name)
				return true
			})
			assert names.join(",") == "b,c,c,c"
			assert root.descendants("c").len() == 3
		}

		@test()
		def TestWriter() {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("w:doc")
			w.attribute("xmlns:w", "urn:w")
			w.attribute("q", "a\"b<c>&\n\t")
			w.start("w:empty")
			w.end()
			w.element("t", "Fish & <chips>\u0001")
			w.raw("<!--r-->")
			w.start("open")
			w.text("x")
			assert w.str() == "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<w:doc xmlns:w=\"urn:w\" q=\"a&quot;b&lt;c&gt;&amp;&#10;&#9;\"><w:empty/><t>Fish &amp; &lt;chips&gt;</t><!--r--><open>x</open></w:doc>"
		}

		@test()
		def TestBuildAndRoundTrip() !none {
			let root = new XMLNode("r:root", "urn:r")
			root.set("xmlns:r", "urn:r")
			root.set("id", "1").set("id", "2")
			let item = root.add(new XMLNode("r:item", "urn:r"))
			item.add("one & ")
			item.add("two")
			root.add(new XMLNode("empty"))
			assert value(root.attribute("id")) == "2"
			assert item.children.len() == 1
			let markup = root.str()
			assert markup == "<r:root xmlns:r=\"urn:r\" id=\"2\"><r:item>one &amp; two</r:item><empty/></r:root>"

			let back = try new XML().parse(markup)
			assert value(back.child("item", "urn:r")) == "one & two"
			assert back.str() == markup
		}
	}
}
