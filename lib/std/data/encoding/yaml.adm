partial module std.data.encoding {
	use (
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.io
	)

	// Qualified name of the `@yaml` meta function, used to look up field options.
	internal const yamlAttr = "std.data.encoding.yaml"

	// Encodes and decodes a YAML block mapping of scalar values.
	//
	//     let y = new YAML()
	//     let text = string(y.encode(cfg))
	//     try y.decode(text, cfg)
	//
	// Per-field behaviour comes from `@yaml` annotations:
	//
	//     @yaml("host_name")      encode under this key instead of the field name
	//     @yaml(omitempty: true)  leave the field out when it holds its zero value
	//     @yaml(ignore: true)     never encode or decode the field
	//     @yaml(asString: true)   always quote the value
	//     @yaml(nullable: true)   encode as null rather than being omitted
	//
	// Strings are quoted only when leaving them bare would change their type on
	// the way back in, such as the country code "NO" reading as false.
	//
	// Sequences are supported in flow style, `[a, b, c]`, on one line. Nested
	// mappings are written and read as indented blocks:
	//
	//     host_name: h
	//     address:
	//       city: Oslo
	//
	// Unsupported: anchors and aliases, multiple documents, explicit tags,
	// block scalars and block sequences. Decoding these returns an error
	// naming the construct.
	type YAML {
		// Key naming for fields with no explicit `@yaml("name")`.
		caseStyle CaseStyle = CaseStyle.AsIs

		// How many mappings deep to encode before writing null instead of
		// descending further. Values that refer back to themselves have no
		// depth at which they stop, and encode returns bytes rather than an
		// error, so this is what stands between a cycle and an exhausted
		// stack. Raise it for data that is legitimately deeper. Decoding
		// refuses input nested deeper than this.
		maxDepth int = 64

		// encode renders obj as YAML, following the @yaml field annotations and the
		// codec's case style; a YAMLEncoder value renders itself.
		def encode(obj any) byte[] {
			return encodeValue(obj, "", 0).bytes()
		}

		// encode writes obj as YAML to the writer. Fails when the writer does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// decode fills target from YAML bytes. Fails when the text is outside the
		// YAML subset the codec reads, a value does not fit its field, or nesting
		// exceeds maxDepth.
		def decode(input byte[], target any) !none {
			return try decode(string(input), target)
		}

		// decode fills target from YAML text, the same way as from bytes. Fails when
		// the text is outside the YAML subset the codec reads, a value does not fit
		// its field, or nesting exceeds maxDepth.
		def decode(input string, target any) !none {
			match target {
				case YAMLDecoder:
					return try target.yaml(input.bytes())
				default:
			}

			let lines = try scanLines(input)
			if lines.len() == 0 {
				return none
			}
			let _ = try bindMapping(lines, 0, lines[0].indent, target, 0)
			return none
		}

		// Reads the entries at one indentation level into target, and returns
		// the index of the first line that belongs to an outer level.
		internal def bindMapping(lines YAMLLine[], from int, indent int, target any, depth int) !int {
			fail "yaml: input nests deeper than {maxDepth} mappings" when depth >= maxDepth

			let pos = from
			for pos < lines.len() {
				let l = lines[pos]
				if l.indent < indent {
					break
				}
				fail "yaml: unexpected indentation on line {l.lineNo + 1}" when l.indent > indent

				pos++
				let f = fieldForKey(target, l.key, yamlAttr, caseStyle)

				// A key with nothing after the colon opens a nested mapping,
				// which is the lines indented under it.
				if l.rest == "" {
					let inner = pos
					if inner >= lines.len() || lines[inner].indent <= indent {
						fail "yaml: `{l.key}` on line {l.lineNo + 1} opens a mapping with nothing under it"
					}
					if f is none {
						pos = skipBlock(lines, inner, indent)
						continue
					}
					fail "yaml: cannot read a mapping into `{l.key}` on line {l.lineNo + 1}" when f.kind != FieldKind.Struct
					let nested = f.ensureValue()
					fail "yaml: cannot read a mapping into `{l.key}` on line {l.lineNo + 1}" when nested is none
					pos = try bindMapping(lines, inner, lines[inner].indent, nested, depth + 1)
					continue
				}

				// Unknown keys are ignored.
				if f is none {
					continue
				}
				// null and ~ leave the field at its zero value.
				if l.rest == "null" || l.rest == "~" {
					continue
				}

				if f.kind == FieldKind.Array {
					try bindFlowSequence(f, l.rest, l.lineNo)
				} else {
					fail "yaml: cannot read a sequence into `{l.key}` on line {l.lineNo + 1}" when l.rest.startsWith("[")
					setScalarText(f, f.kind, unquoteScalar(l.rest))
				}
			}
			return pos
		}

		// Index of the first line at or above the given indentation, used to
		// step over the block belonging to a key nothing maps to.
		internal def skipBlock(lines YAMLLine[], from int, indent int) int {
			let pos = from
			for pos < lines.len() && lines[pos].indent > indent {
				pos++
			}
			return pos
		}

		// decode reads everything the reader yields and fills target from it as YAML.
		// Fails when the reader does or the text does not decode.
		def decode(reader io.Reader, target any) !none {
			let chunk byte[]
			chunk.len(4096)
			let all byte[]
			for {
				let n = try reader.read(chunk)
				if n <= 0 {
					break
				}
				all += chunk.slice(0, n)
			}
			return try decode(string(all), target)
		}

		internal def encodeValue(obj any, indent string, depth int) string {
			match obj {
				case YAMLEncoder:
					return string(obj.yaml())
				default:
			}

			let out = ""
			for let (_, f) in reflection.fields(obj) {
				if fieldFlag(f, yamlAttr, "ignore") {
					continue
				}
				if fieldFlag(f, yamlAttr, "omitempty") && fieldIsEmpty(f) {
					continue
				}

				let key = encodedKey(f, yamlAttr, caseStyle)
				if f.kind == FieldKind.Struct {
					let nested = f.value()
					if nested is none {
						out += indent + key + ": null\n"
						continue
					}
					if depth + 1 >= maxDepth {
						out += indent + key + ": null\n"
						continue
					}
					// A mapping goes under its key, indented by two spaces.
					out += indent + key + ":\n"
					out += encodeValue(nested, indent + "  ", depth + 1)
					continue
				}

				out += indent + key + ": "
				if f.kind == FieldKind.Array {
					out += encodeSequence(f)
				} else {
					out += encodeScalar(f, f.kind)
				}
				out += "\n"
			}
			return out
		}

		// Sequences are written in flow style, which keeps a value on one line
		// and needs no indentation tracking.
		internal def encodeSequence(f Field) string {
			let kind = f.elemKind
			let out = "["
			let n = f.len()
			for let i = 0; i < n; i++ {
				if i > 0 {
					out += ", "
				}
				out += encodeScalar(f.at(i), kind)
			}
			out += "]"
			return out
		}

		internal def encodeScalar(f Field, kind FieldKind) string {
			let text = scalarText(f, kind)

			if fieldFlag(f, yamlAttr, "asString") {
				return quoteYAML(text)
			}
			if kind == FieldKind.String {
				return needsQuoting(text) ?? (quoteYAML(text), text)
			}
			return text
		}

		// Reads a flow sequence, `[a, b, c]`, into an array field.
		internal def bindFlowSequence(f Field, text string, lineNo int) !none {
			fail "yaml: expected a flow sequence on line {lineNo + 1}" when !text.startsWith("[") || !text.endsWith("]")

			let inner = text.slice(1, text.len() - 1).trim()
			if inner == "" {
				f.setLen(0)
				return none
			}

			let parts = splitFlow(inner)
			f.setLen(parts.len())
			let kind = f.elemKind
			for let (i, part) in parts {
				setScalarText(f.at(i), kind, unquoteScalar(part.trim()))
			}
			return none
		}
	}

	// Produces a type's own YAML. Implement this when reflection over the
	// fields would not give the right document; YAML.encode uses it instead of
	// reflecting.
	interface YAMLEncoder {
		// Returns the encoded form of this value.
		def yaml() byte[]
	}

	// Parses a type's own YAML. Implement this to control decoding; YAML.decode
	// hands over the whole document instead of binding fields itself.
	interface YAMLDecoder {
		// Populates this value from data. Returns an error if data is invalid.
		def yaml(data byte[]) !none
	}

	// One `key: value` line, with the indentation that places it in the
	// document and the source line number for error messages.
	internal struct YAMLLine {
		indent int
		key    string
		rest   string
		lineNo int
	}

	// Splits a document into its mapping entries, dropping blank and comment
	// lines and refusing the constructs this parser does not read. Doing it in
	// one pass up front is what lets the binder look ahead to decide whether a
	// key opens a nested mapping.
	internal def scanLines(input string) !YAMLLine[] {
		let out = YAMLLine[]
		for let (lineNo, raw) in input.lines() {
			let line = stripComment(raw)
			if line.trim() == "" {
				continue
			}

			fail "yaml: multiple documents are not supported (line {lineNo + 1})" when line.trim() == "---"
			fail "yaml: block sequences are not supported (line {lineNo + 1})" when line.trim().startsWith("- ")
			fail "yaml: tabs cannot indent YAML (line {lineNo + 1})" when line.startsWith("\t")

			let indent = 0
			for let (_, ch) in line {
				if ch != ' ' {
					break
				}
				indent++
			}

			let body = line.trim()
			let colon = body.indexOf(":")
			fail "yaml: expected `key: value` on line {lineNo + 1}" when colon < 0

			let key = body.slice(0, colon).trim()
			let rest = body.slice(colon + 1, body.len()).trim()

			fail "yaml: anchors and aliases are not supported (line {lineNo + 1})" when rest.startsWith("&") || rest.startsWith("*")
			fail "yaml: explicit tags are not supported (line {lineNo + 1})" when rest.startsWith("!")
			fail "yaml: block scalars are not supported (line {lineNo + 1})" when rest == "|" || rest == ">"
			fail "yaml: flow mappings are not supported (line {lineNo + 1})" when rest.startsWith("\u007B")

			out.push(YAMLLine{indent: indent, key: key, rest: rest, lineNo: lineNo})
		}
		return out
	}

	// Splits a flow sequence body on commas, ignoring commas inside quotes.
	internal def splitFlow(text string) string[] {
		let out = string[]
		let current = ""
		let inQuote = false
		let quoteCh = ' '
		for let (_, ch) in text {
			if inQuote {
				current += ch
				if ch == quoteCh {
					inQuote = false
				}
				continue
			}
			if ch == '"' || ch == '\'' {
				inQuote = true
				quoteCh = ch
				current += ch
				continue
			}
			if ch == ',' {
				out.push(current)
				current = ""
				continue
			}
			current += ch
		}
		out.push(current)
		return out
	}

	// Reports whether text must be quoted to survive a round trip.
	//
	// True for the boolean and null spellings (`yes`, `no`, `on`, `off`, `~`,
	// ...), anything numeric, the empty string, text with surrounding spaces,
	// and text containing YAML syntax characters. Emitting these bare would
	// decode as a different type: the country code "NO" reads back as false.
	internal def needsQuoting(text string) bool {
		if text == "" {
			return true
		}
		match text.lower() {
			case "true", "false", "yes", "no", "on", "off", "y", "n", "null", "~":
				return true
			default:
		}
		if text != text.trim() {
			return true
		}
		if looksNumeric(text) {
			return true
		}
		for let (_, ch) in text {
			match ch {
				case ':', '#', '-', '?', ',', '[', ']', '{', '}', '&', '*', '!', '|', '>', '\'', '"', '%', '@', '`', '\n', '\t':
					return true
				default:
			}
		}
		return false
	}

	internal def looksNumeric(text string) bool {
		let seenDigit = false
		for let (i, ch) in text {
			if ch >= '0' && ch <= '9' {
				seenDigit = true
				continue
			}
			match ch {
				case '.', '+', '-', 'e', 'E', '_':
					continue
				default:
					return false
			}
		}
		return seenDigit
	}

	// Quotes text using double-quoted style, whose escapes match JSON's.
	internal def quoteYAML(text string) string {
		return quote(text)
	}

	// Removes a trailing comment. A `#` inside a quoted scalar is kept.
	internal def stripComment(line string) string {
		let inQuote = false
		let quoteCh = ' '
		for let (i, ch) in line {
			if inQuote {
				if ch == quoteCh {
					inQuote = false
				}
				continue
			}
			if ch == '"' || ch == '\'' {
				inQuote = true
				quoteCh = ch
				continue
			}
			if ch == '#' {
				return line.slice(0, i)
			}
		}
		return line
	}

	// Removes surrounding quotes from a scalar and resolves its escapes.
	// Double-quoted scalars use JSON escapes; single-quoted ones only use ''
	// for a literal quote.
	internal def unquoteScalar(text string) string {
		if text.len() < 2 {
			return text
		}
		if text.startsWith("\"") && text.endsWith("\"") {
			let inner = text.slice(1, text.len() - 1)
			let out = ""
			let escaped = false
			for let (_, ch) in inner {
				if escaped {
					match ch {
						case 'n':
							out += "\n"
						case 't':
							out += "\t"
						case 'r':
							out += "\r"
						case '"':
							out += "\""
						case '\\':
							out += "\\"
						default:
							out += ch
					}
					escaped = false
					continue
				}
				if ch == '\\' {
					escaped = true
					continue
				}
				out += ch
			}
			return out
		}
		if text.startsWith("'") && text.endsWith("'") {
			return text.slice(1, text.len() - 1).replace("''", "'")
		}
		return text
	}

	// Controls how a field is encoded to and decoded from YAML.
	//
	//     name       key to use instead of the field name
	//     omitempty  leave the field out when it holds its zero value
	//     ignore     never encode or decode the field
	//     asString   always quote the value, keeping large integers exact
	//     nullable   encode as null rather than being omitted
	//
	//     struct Config {
	//         @yaml("host_name")
	//         host string
	//         @yaml(omitempty: true)
	//         note string
	//     }
	meta def yaml(ctx FieldMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "yaml", name, omitempty, ignore, asString, nullable)
	}

	// Controls how a property is encoded to and decoded from YAML. Takes the
	// same options as the field form above.
	meta def yaml(ctx PropertyMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "yaml", name, omitempty, ignore, asString, nullable)
	}
}
