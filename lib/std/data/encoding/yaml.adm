partial module std.data.encoding {
	use (
		std.data.encoding.json::*
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext, PropertyMetaContext, MetadataStore)
		std.io
	)

	// Qualified name of the `@yaml` meta function, used to look up field options.
	internal const yamlAttr = "std.data.encoding.yaml"

	// Reads and writes YAML 1.2 (YAML 1.2.2, the core schema).
	//
	//     let y = new YAML()
	//     let doc = try y.parse(text)       // map<string, any>, any[], scalars
	//     let text = string(y.encode(cfg))
	//     try y.decode(text, cfg)
	//
	// `parse` and `decode` read all of YAML: block and flow collections,
	// every scalar style, anchors and aliases, tags, directives and several
	// documents (`parseAll`). Plain scalars resolve by the core schema
	// (null, bool, int in decimal, octal `0o` and hex `0x`, float with `.inf`
	// and `.nan`); a tag (`!!str`, `!!int`, ...) decides instead. Input may
	// be UTF-8, UTF-16 or UTF-32. Errors are `YAMLError`s with the line and
	// column.
	//
	// Per-field behaviour comes from `@yaml` annotations:
	//
	//     @yaml("host_name")      encode under this key instead of the field name
	//     @yaml(omitempty: true)  leave the field out when it holds its zero value
	//     @yaml(ignore: true)     never encode or decode the field
	//     @yaml(asString: true)   always quote the value
	//     @yaml(nullable: true)   encode as null rather than being omitted
	//
	// Strings are quoted only when leaving them bare would change their type on
	// the way back in, such as the country code "NO" reading as false in
	// YAML 1.1, and written as literal block scalars when they hold line
	// breaks. Sequences of scalars are written in flow style, `[a, b, c]`;
	// sequences of objects and nested collections in block style.
	type YAML {
		// Key naming for fields with no explicit `@yaml("name")`.
		caseStyle CaseStyle = CaseStyle.AsIs

		// How many collections deep to encode before writing null instead of
		// descending further. Values that refer back to themselves have no
		// depth at which they stop, and encode returns bytes rather than an
		// error, so this is what stands between a cycle and an exhausted
		// stack. Raise it for data that is legitimately deeper. Parsing and
		// decoding refuse input nested deeper than this.
		maxDepth int = 64

		// encode renders obj as YAML, following the @yaml field annotations and the
		// codec's case style; a YAMLEncoder value renders itself. Maps
		// (`map<string, V>`), arrays and scalars render as such.
		def encode(obj any) byte[] {
			return encodeDocument(obj).bytes()
		}

		// encode writes obj as YAML to the writer. Fails when the writer does.
		def encode(writer io.Writer, obj any) !none {
			try writer.write(encode(obj))
			return none
		}

		// parse reads the first document of a YAML stream into plain values:
		// mappings as `map<string, any>` (keys as text), sequences as
		// `any[]`, scalars as `none`, `bool`, `int`, `float` or `string`. An
		// alias is the value its anchor names, the same object for a
		// collection. An empty stream is `none`.
		//
		// ```
		// let doc = try new YAML().parse("openapi: 3.2.0\npaths: \{\}\n")
		// ```
		//
		// Fails with a `YAMLError` when the text is not YAML, a mapping key
		// is a collection or comes twice, or nesting exceeds maxDepth.
		def parse(input byte[]) !any {
			let docs = try parseAll(input)
			return docs.len() == 0 ?? (none, docs[0])
		}

		// parse reads the first document of YAML text into plain values, as
		// from bytes. Fails as the bytes form does.
		def parse(input string) !any {
			return try parse(input.bytes())
		}

		// parseAll reads every document of a YAML stream into plain values,
		// as parse reads one. Fails as parse does.
		def parseAll(input byte[]) !any[] {
			return try yamlValues(input, maxDepth)
		}

		// parseAll reads every document of YAML text, as from bytes. Fails as
		// parse does.
		def parseAll(input string) !any[] {
			return try parseAll(input.bytes())
		}

		internal def documents(input byte[]) !YAMLNode[] {
			return try yamlDocuments(input, maxDepth)
		}

		// decode fills target from the first document of YAML bytes. Keys
		// match the encoded name exactly first, then case-insensitively
		// against the encoded and declared names; unknown keys are ignored
		// and null leaves a field at its zero value. A `map<string, any>`
		// target takes the document's mapping and an `any[]` target its
		// sequence, as parse builds them. Fails when the text is not YAML, a
		// value does not fit its field, or nesting exceeds maxDepth.
		def decode(input byte[], target any) !none {
			match target {
				case YAMLDecoder:
					return try target.yaml(input)
				case map<string, any>:
					let doc = try parse(input)
					return none when doc is none
					fail "yaml: expected a mapping" unless doc is map<string, any>
					for let key in target.keys() {
						target.delete(key)
					}
					for let (key, value) in doc {
						target.set(key, value)
					}
					return none
				case any[]:
					let doc = try parse(input)
					return none when doc is none
					fail "yaml: expected a sequence" unless doc is any[]
					target.len(0)
					for let e in doc {
						target.push(e)
					}
					return none
				default:
			}
			let docs = try documents(input)
			return none when docs.len() == 0
			try bindObject(docs[0], target, 0)
			return none
		}

		// decode fills target from YAML text, the same way as from bytes. Fails
		// when the text is not YAML, a value does not fit its field, or nesting
		// exceeds maxDepth.
		def decode(input string, target any) !none {
			return try decode(input.bytes(), target)
		}

		// decode reads everything the reader yields and fills target from it as YAML.
		// Fails when the reader does or the text does not decode.
		def decode(reader io.Reader, target any) !none {
			let chunk byte[]
			chunk.len(4096)
			let all byte[]
			for {
				let n = try reader.read(chunk)
				if n <= 0 {
					break
				}
				all += chunk.slice(0, n)
			}
			return try decode(all, target)
		}

		// Binds a mapping onto an object's fields.
		internal def bindObject(node YAMLNode, target any, depth int) !none {
			return none when node.isNull()
			fail yamlError(yamlPlace(node), "expected a mapping, found {node.describe()}") unless node.kind == YAMLNodeKind.Mapping
			for let i = 0; i + 1 < node.items.len(); i += 2 {
				let key = node.items[i]
				fail yamlError(yamlPlace(key), "a key of an object's mapping is a scalar") unless key.kind == YAMLNodeKind.Scalar
				let f = fieldForKey(target, key.text, yamlAttr, caseStyle)
				continue when f is none
				try bindField(node.items[i + 1], f, depth)
			}
			return none
		}

		// Stores one node in a field: by the field's kind, with nested objects,
		// arrays and maps; an `any` field takes the plain value.
		internal def bindField(node YAMLNode, f Field, depth int) !none {
			return none when node.isNull()
			let kind = f.kind
			if kind == FieldKind.Optional {
				kind = f.elemKind
				if kind == FieldKind.Array || kind == FieldKind.Map {
					fail yamlError(yamlPlace(node), "cannot decode into `{f.name}`") unless f.set(try yamlPlain(node))
					return none
				}
			}
			switch kind {
				case FieldKind.Array:
					return try bindArray(node, f, depth)
				case FieldKind.Map:
					return try bindMap(node, f, depth)
				case FieldKind.Struct:
					fail yamlError(yamlPlace(node), "cannot read {node.describe()} into `{f.name}`") unless node.kind == YAMLNodeKind.Mapping
					let nested = f.ensureValue()
					fail yamlError(yamlPlace(node), "cannot read a mapping into `{f.name}`") when nested is none
					return try bindObject(node, nested, depth + 1)
				case FieldKind.Iface:
					fail yamlError(yamlPlace(node), "cannot decode into `{f.name}`") unless f.set(try yamlPlain(node))
					return none
				default:
					return try bindScalar(node, f, kind)
			}
		}

		internal def bindArray(node YAMLNode, f Field, depth int) !none {
			fail yamlError(yamlPlace(node), "cannot read {node.describe()} into `{f.name}`, a sequence") unless node.kind == YAMLNodeKind.Sequence
			let kind = f.elemKind
			fail yamlError(yamlPlace(node), "cannot read a sequence into `{f.name}`: its elements are neither scalars, objects nor `any`") when kind := FieldKind.Other || FieldKind.Array || FieldKind.Map
			f.setLen(node.items.len())
			for let (i, item) in node.items {
				continue when item.isNull()
				let element = f.at(i)
				if kind == FieldKind.Struct {
					fail yamlError(yamlPlace(item), "cannot read {item.describe()} into `{f.name}[{i}]`") unless item.kind == YAMLNodeKind.Mapping
					let nested = element.ensureValue()
					fail yamlError(yamlPlace(item), "cannot read a mapping into `{f.name}[{i}]`") when nested is none
					try bindObject(item, nested, depth + 1)
				} else if kind == FieldKind.Iface {
					fail yamlError(yamlPlace(item), "cannot decode into `{f.name}[{i}]`") unless element.set(try yamlPlain(item))
				} else {
					try bindScalar(item, element, kind)
				}
			}
			return none
		}

		// Reads a mapping into a `map<string, V>` field, replacing what the map
		// held. V is a scalar, an object, an array or `any`; a null entry is
		// left out.
		internal def bindMap(node YAMLNode, f Field, depth int) !none {
			let kind = f.elemKind
			fail yamlError(yamlPlace(node), "cannot read a mapping into `{f.name}`: map keys must be strings and values scalars, objects, arrays or `any`") when kind := FieldKind.Other || FieldKind.Map
			fail yamlError(yamlPlace(node), "cannot read {node.describe()} into `{f.name}`, a map") unless node.kind == YAMLNodeKind.Mapping
			f.clear()
			for let i = 0; i + 1 < node.items.len(); i += 2 {
				let key = node.items[i]
				let value = node.items[i + 1]
				fail yamlError(yamlPlace(key), "a key of `{f.name}` is a scalar") unless key.kind == YAMLNodeKind.Scalar
				continue when value.isNull()
				let entry = f.entry(key.text)
				if kind == FieldKind.Struct {
					fail yamlError(yamlPlace(value), "cannot read {value.describe()} into `{f.name}[{key.text}]`") unless value.kind == YAMLNodeKind.Mapping
					let nested = entry.ensureValue()
					fail yamlError(yamlPlace(value), "cannot read a mapping into `{f.name}[{key.text}]`") when nested is none
					try bindObject(value, nested, depth + 1)
				} else if kind == FieldKind.Iface {
					fail yamlError(yamlPlace(value), "cannot decode into `{f.name}[{key.text}]`") unless entry.set(try yamlPlain(value))
				} else if kind == FieldKind.Array {
					try bindArray(value, entry, depth + 1)
				} else {
					try bindScalar(value, entry, kind)
				}
			}
			return none
		}

		// Stores a scalar in a field of a scalar kind. A bool takes YAML
		// 1.1's spellings too (yes, no, on, off, y, n); a number must read as
		// one, quoted or not.
		internal def bindScalar(node YAMLNode, f Field, kind FieldKind) !none {
			fail yamlError(yamlPlace(node), "cannot read {node.describe()} into `{f.name}`") unless node.kind == YAMLNodeKind.Scalar
			let text = node.text
			switch kind {
				case FieldKind.String:
					f.setString(text)
				case FieldKind.Bool:
					fail yamlError(yamlPlace(node), "expected a bool for `{f.name}`, found \"{text}\"") unless text.lower() := "true" || "false" || "yes" || "no" || "on" || "off" || "y" || "n"
					f.setBool(isTruthyScalar(text))
				case FieldKind.Float:
					let value = yamlCoreValue(text)
					if value is int {
						f.setFloat(float(value))
					} else {
						fail yamlError(yamlPlace(node), "expected a number for `{f.name}`, found \"{text}\"") unless value is float
						f.setFloat(value)
					}
				case FieldKind.Int, FieldKind.Enum:
					let value = yamlCoreValue(text)
					fail yamlError(yamlPlace(node), "expected an integer for `{f.name}`, found \"{text}\"") unless value is int
					f.setInt(value)
				case FieldKind.Uint:
					let value = yamlCoreValue(text)
					fail yamlError(yamlPlace(node), "expected an integer for `{f.name}`, found \"{text}\"") unless value is int && value >= 0
					f.setUint(uint(value))
				default:
					fail yamlError(yamlPlace(node), "cannot decode into `{f.name}`")
			}
			return none
		}

		// A whole document: a collection as block lines, a scalar on its own.
		internal def encodeDocument(obj any) string {
			match obj {
				case YAMLEncoder:
					return string(obj.yaml())
				default:
			}
			let kind = reflection.kindOf(obj)
			if kind := FieldKind.Array || FieldKind.Map || FieldKind.Struct || FieldKind.Other {
				let lines = encodeBlock(obj, "", 0)
				return lines != "" ?? (lines, emptyCollection(obj) + "\n")
			}
			return encodeScalarValue(obj, "", false) + "\n"
		}

		// "[]" for an empty sequence, "\{\}" for an empty mapping or object.
		internal def emptyCollection(obj any) string {
			return reflection.kindOf(obj) == FieldKind.Array ?? ("[]", "{}")
		}

		// Whether a value is written as block lines under its key or dash: a
		// non-empty mapping or object, or a sequence holding a collection.
		internal def isBlock(obj any) bool {
			match obj {
				case YAMLEncoder:
					return true
				default:
			}
			let kind = reflection.kindOf(obj)
			if kind == FieldKind.Array {
				for let e in reflection.elements(obj) {
					return true unless e is none || isScalarValue(e)
				}
				return false
			}
			return reflection.keysOf(obj).len() > 0 when kind == FieldKind.Map
			return (kind := FieldKind.Struct || FieldKind.Other) && reflection.fields(obj).len() > 0
		}

		internal def isScalarValue(obj any) bool {
			let kind = reflection.kindOf(obj)
			return kind := FieldKind.String || FieldKind.Bool || FieldKind.Int || FieldKind.Uint || FieldKind.Float || FieldKind.Enum
		}

		// The lines of a collection, each starting with indent.
		internal def encodeBlock(obj any, indent string, depth int) string {
			match obj {
				case YAMLEncoder:
					let own = string(obj.yaml()).trimEnd("\n")
					return own.split("\n").mapElem(line => indent + line).join("\n") + "\n"
				default:
			}
			let kind = reflection.kindOf(obj)
			if kind == FieldKind.Array {
				let out = ""
				for let e in reflection.elements(obj) {
					out += encodeItem(e, indent, depth)
				}
				return out
			}
			if kind == FieldKind.Map {
				let out = ""
				for let key in reflection.keysOf(obj) {
					out += encodeEntry(key, reflection.entryOf(obj, key), indent, depth)
				}
				return out
			}
			let out = ""
			for let (_, f) in reflection.fields(obj) {
				continue when fieldFlag(f, yamlAttr, "ignore")
				continue when fieldFlag(f, yamlAttr, "omitempty") && fieldIsEmpty(f)
				out += encodeField(f, indent, depth)
			}
			return out
		}

		// One `- item`: a collection's first line goes after the dash.
		internal def encodeItem(value ?any, indent string, depth int) string {
			return indent + "- null\n" when value is none
			if isBlock(value) && depth + 1 < maxDepth {
				let lines = encodeBlock(value, indent + "  ", depth + 1)
				return indent + "- " + lines[indent.len() + 2:]
			}
			return indent + "- " + encodeInline(value, indent + "  ") + "\n"
		}

		// One `key: value` entry of a mapping.
		internal def encodeEntry(key string, value ?any, indent string, depth int) string {
			let name = needsQuoting(key) ?? (quoteYAML(key), key)
			return indent + name + ": null\n" when value is none
			if isBlock(value) {
				return indent + name + ": null\n" when depth + 1 >= maxDepth
				return indent + name + ":\n" + encodeBlock(value, indent + "  ", depth + 1)
			}
			return indent + name + ": " + encodeInline(value, indent + "  ") + "\n"
		}

		// A value on the line of its key or dash: a scalar, an empty
		// collection, a flow sequence of scalars, or a block scalar header
		// whose lines follow at indent.
		internal def encodeInline(value any, indent string) string {
			let kind = reflection.kindOf(value)
			if kind == FieldKind.Array {
				let parts string[] = []
				for let e in reflection.elements(value) {
					parts.push(e is none ?? ("null", encodeScalarValue(e, "", false)))
				}
				return "[" + parts.join(", ") + "]"
			}
			if kind := FieldKind.Map || FieldKind.Struct || FieldKind.Other {
				return emptyCollection(value)
			}
			return encodeScalarValue(value, indent, true)
		}

		// A scalar value. A string with line breaks becomes a literal block
		// scalar at indent when `block` allows it.
		internal def encodeScalarValue(value any, indent string, block bool) string {
			let kind = reflection.kindOf(value)
			if kind == FieldKind.String {
				let text = reflection.scalarText(value)
				if block {
					let literal = yamlLiteral(text, indent)
					return literal unless literal == ""
				}
				return needsQuoting(text) ?? (quoteYAML(text), text)
			}
			return yamlFloat(reflection.scalarText(value)) when kind == FieldKind.Float
			let raw = reflection.scalarText(value)
			return raw == "" ?? ("null", raw)
		}

		// One field of an object, by its kind and annotations.
		internal def encodeField(f Field, indent string, depth int) string {
			let key = encodedKey(f, yamlAttr, caseStyle)
			let name = needsQuoting(key) ?? (quoteYAML(key), key)
			let kind = f.kind
			if kind == FieldKind.Array {
				let elemKind = f.elemKind
				if elemKind := FieldKind.String || FieldKind.Bool || FieldKind.Int || FieldKind.Uint || FieldKind.Float {
					return indent + name + ": " + encodeSequence(f) + "\n"
				}
				return indent + name + ": []\n" when f.len() == 0
				return indent + name + ": null\n" when depth + 1 >= maxDepth
				let out = indent + name + ":\n"
				for let i = 0; i < f.len(); i++ {
					out += encodeItem(f.at(i).value(), indent + "  ", depth + 1)
				}
				return out
			}
			return encodeMap(f, name, indent, depth) when kind == FieldKind.Map
			if kind := FieldKind.Struct || FieldKind.Iface || FieldKind.Optional {
				let nested = f.value()
				return indent + name + ": null\n" when nested is none
				if kind == FieldKind.Optional && fieldFlag(f, yamlAttr, "asString") && (f.elemKind := FieldKind.Bool || FieldKind.Int || FieldKind.Uint || FieldKind.Float || FieldKind.Enum) {
					return indent + name + ": " + quoteYAML(reflection.scalarText(nested)) + "\n"
				}
				return encodeEntry(key, nested, indent, depth)
			}
			if kind == FieldKind.Enum {
				let raw = f.asInt().str()
				return indent + name + ": " + (fieldFlag(f, yamlAttr, "asString") ?? (quoteYAML(raw), raw)) + "\n"
			}
			return indent + name + ": " + encodeScalarValue(f.asString(), indent + "  ", true) + "\n" when kind == FieldKind.String && !fieldFlag(f, yamlAttr, "asString")
			return indent + name + ": " + encodeScalar(f, kind) + "\n"
		}

		// Writes a `map<string, V>` field as a block mapping under its key,
		// entries in insertion order; an empty map is the flow form `{}`.
		internal def encodeMap(f Field, name string, indent string, depth int) string {
			let kind = f.elemKind
			return indent + name + ": null\n" when kind == FieldKind.Other || kind == FieldKind.Array || kind == FieldKind.Map
			return indent + name + ": {}\n" when f.len() == 0
			return indent + name + ": null\n" when depth + 1 >= maxDepth
			let out = indent + name + ":\n"
			let inner = indent + "  "
			for let k in f.keys() {
				let e = f.entry(k)
				if kind := FieldKind.Struct || FieldKind.Iface {
					out += encodeEntry(k, e.value(), inner, depth + 1)
					continue
				}
				let entryName = needsQuoting(k) ?? (quoteYAML(k), k)
				out += inner + entryName + ": " + encodeScalar(e, kind) + "\n"
			}
			return out
		}

		// Sequences of scalars are written in flow style, which keeps a value
		// on one line.
		internal def encodeSequence(f Field) string {
			let kind = f.elemKind
			let parts string[] = []
			for let i = 0; i < f.len(); i++ {
				parts.push(encodeScalar(f.at(i), kind))
			}
			return "[" + parts.join(", ") + "]"
		}

		internal def encodeScalar(f Field, kind FieldKind) string {
			let text = scalarText(f, kind)
			return quoteYAML(text) when fieldFlag(f, yamlAttr, "asString")
			return needsQuoting(text) ?? (quoteYAML(text), text) when kind == FieldKind.String
			return kind == FieldKind.Float ?? (yamlFloat(text), text)
		}
	}

	// A float's text as YAML reads it back as a float: `.inf`, `-.inf`,
	// `.nan`, and a point or exponent on a whole number.
	internal def yamlFloat(text string) string {
		switch text.lower() {
			case "inf", "+inf", "infinity":
				return ".inf"
			case "-inf", "-infinity":
				return "-.inf"
			case "nan", "-nan":
				return ".nan"
			default:
		}
		return text when text.contains(".") || text.contains("e") || text.contains("E")
		return text + ".0"
	}

	// A string as a literal block scalar (`|`, `|-` or `|+` by its final
	// line breaks) with its lines at indent, or "" when it holds no line
	// break or cannot be written so: a carriage return or other control
	// character, or a first line that starts with a space.
	internal def yamlLiteral(text string, indent string) string {
		return "" unless text.contains("\n")
		for let b in text.bytes() {
			let c = int(b)
			return "" when (c < 0x20 && c != 0x0A && c != 0x09) || c == 0x7F
		}
		let body = text.trimEnd("\n")
		let breaks = text.len() - body.len()
		return "" when body == "" || body.startsWith(" ") || body.startsWith("\t")
		for let line in body.split("\n") {
			// A line of only blanks would read back shorter.
			return "" when line != "" && line.trim() == ""
		}
		let header = breaks == 0 ?? ("|-", breaks == 1 ?? ("|", "|+"))
		let out = header
		for let line in body.split("\n") {
			out += "\n" + (line == "" ?? ("", indent + line))
		}
		for let i = 1; i < breaks; i++ {
			out += "\n"
		}
		return out
	}

	// Produces a type's own YAML. Implement this when reflection over the
	// fields would not give the right document; YAML.encode uses it instead of
	// reflecting.
	interface YAMLEncoder {
		// Returns the encoded form of this value.
		def yaml() byte[]
	}

	// Parses a type's own YAML. Implement this to control decoding; YAML.decode
	// hands over the whole document instead of binding fields itself.
	interface YAMLDecoder {
		// Populates this value from data. Returns an error if data is invalid.
		def yaml(data byte[]) !none
	}

	// Reports whether text must be quoted to survive a round trip.
	//
	// True for the boolean and null spellings of YAML 1.1 and 1.2 (`yes`,
	// `no`, `on`, `off`, `~`, ...), anything numeric, the empty string, text
	// with surrounding spaces, text that starts with an indicator, holds a
	// comment or mapping indicator (`#`, `:`), a flow indicator (it may sit
	// in a flow sequence), or a character that is not printable as is.
	// Emitting these bare would decode as a different type or not at all:
	// the country code "NO" reads back as false.
	internal def needsQuoting(text string) bool {
		return true when text == ""
		match text.lower() {
			case "true", "false", "yes", "no", "on", "off", "y", "n", "null", "~":
				return true
			default:
		}
		return true when text != text.trim()
		return true when looksNumeric(text)
		match text[0] {
			case '-', '?', '&', '*', '!', '|', '>', '\'', '"', '%', '@', '`':
				return true
			default:
		}
		for let (_, ch) in text {
			match ch {
				case ':', '#', ',', '[', ']', '{', '}', '\n', '\t':
					return true
				default:
			}
			let c = int(ch)
			return true when c < 0x20 || c == 0x7F || (c >= 0x80 && c <= 0x9F) || c == 0xFEFF
		}
		return false
	}

	internal def looksNumeric(text string) bool {
		let seenDigit = false
		for let (_, ch) in text {
			if ch >= '0' && ch <= '9' {
				seenDigit = true
				continue
			}
			match ch {
				case '.', '+', '-', 'e', 'E', '_':
					continue
				default:
					return false
			}
		}
		return seenDigit
	}

	// Quotes text in double-quoted style: JSON's escapes, and YAML's for
	// the characters YAML does not allow bare (DEL, C1 controls, U+FEFF).
	internal def quoteYAML(text string) string {
		let quoted = quote(text)
		let plain = true
		for let (_, ch) in quoted {
			let c = int(ch)
			plain = false when c == 0x7F || (c >= 0x80 && c <= 0x9F) || c == 0xFEFF
		}
		return quoted when plain
		let out = ""
		for let (_, ch) in quoted {
			let c = int(ch)
			if c == 0x7F || (c >= 0x80 && c <= 0x9F) || c == 0xFEFF {
				out += c <= 0xFF ?? ("\\x" + "%02X".format(c), "\\u" + "%04X".format(c))
			} else {
				out += string(ch)
			}
		}
		return out
	}

	// Controls how a field is encoded to and decoded from YAML.
	//
	//     name       key to use instead of the field name
	//     omitempty  leave the field out when it holds its zero value
	//     ignore     never encode or decode the field
	//     asString   always quote the value, keeping large integers exact
	//     nullable   encode as null rather than being omitted
	//
	//     struct Config {
	//         @yaml("host_name")
	//         host string
	//         @yaml(omitempty: true)
	//         note string
	//     }
	meta def yaml(ctx FieldMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "yaml", name, omitempty, ignore, asString, nullable)
	}

	// Controls how a property is encoded to and decoded from YAML. Takes the
	// same options as the field form above.
	meta def yaml(ctx PropertyMetaContext, name string = "", omitempty bool = false, ignore bool = false, asString bool = false, nullable bool = false) {
		let store MetadataStore = ctx.ctx.storage
		recordCodecOptions(store, "yaml", name, omitempty, ignore, asString, nullable)
	}
}
