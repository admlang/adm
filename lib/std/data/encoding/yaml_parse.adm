partial module std.data.encoding {
	use (
		std.data.encoding.json::(integerFits)
		std.simd
	)

	// The events of a YAML stream (YAML 1.2.2 §3.1.2, the serialization
	// tree as a sequence), made from the scanner's tokens.
	internal enum YAMLEventKind {
		StreamStart,
		StreamEnd,
		DocumentStart,
		DocumentEnd,
		SequenceStart,
		SequenceEnd,
		MappingStart,
		MappingEnd,
		Scalar,
		Alias
	}

	internal struct YAMLEvent {
		kind     YAMLEventKind
		line     int             = 0
		column   int             = 0
		anchor   string          = ""
		// The resolved tag, "" when the node has none.
		tag      string          = ""
		value    string          = ""
		style    YAMLScalarStyle = YAMLScalarStyle.Plain
		// A flow collection, or a document's explicit `---` or `...`.
		flow     bool            = false
		explicit bool            = false
	}

	// Turns tokens into events: libyaml's grammar, written as recursive
	// descent, with YAML 1.2's rules for documents, directives and empty
	// keys.
	internal type YAMLParser {
		scanner  YAMLScanner
		// Where events go: kept in events, or handed to a composer.
		events   YAMLEvent[]         = []
		sink     ?YAMLEventSink
		handles  map<string, string>
		maxDepth int

		def new(src byte[], maxDepth int) {
			scanner = new YAMLScanner(src)
			handles = map<string, string>{}
			self.maxDepth = maxDepth
		}

		def emit(event YAMLEvent) !none {
			let composer = sink
			if composer is none {
				events.push(event)
			} else {
				try composer.add(event)
			}
			return none
		}

		def kindAt() !YAMLTokenKind {
			return (try scanner.peek()).kind
		}

		def parseStream() !none {
			let first = try scanner.next()
			try emit(YAMLEvent{kind: YAMLEventKind.StreamStart, line: first.line, column: first.column})
			// At the start of the stream or after `...`: a bare document or
			// directives may come.
			let afterSuffix = true
			for {
				let token = try scanner.peek()
				if token.kind == YAMLTokenKind.StreamEnd {
					try scanner.next()
					try emit(YAMLEvent{kind: YAMLEventKind.StreamEnd, line: token.line, column: token.column})
					return none
				}
				if token.kind == YAMLTokenKind.DocumentEnd {
					try scanner.next()
					afterSuffix = true
					continue
				}
				handles = map<string, string>{"!": "!", "!!": "tag:yaml.org,2002:"}
				let declared map<string, bool> = map<string, bool>{}
				let version = false
				let directives = false
				for token.kind := YAMLTokenKind.VersionDirective || YAMLTokenKind.TagDirective {
					fail yamlError(yamlPlace(token), "a directive must follow \"...\" when a document comes before it") unless afterSuffix
					if token.kind == YAMLTokenKind.VersionDirective {
						fail yamlError(yamlPlace(token), "a document has one %YAML directive") when version
						fail yamlError(yamlPlace(token), "this parser reads YAML 1.x, not {token.major}.{token.minor}") unless token.major == 1
						version = true
					} else {
						fail yamlError(yamlPlace(token), "the tag handle {token.value} is declared twice") when declared.hasKey(token.value)
						declared[token.value] = true
						handles[token.value] = token.suffix
					}
					directives = true
					try scanner.next()
					token = try scanner.peek()
				}
				let explicit = token.kind == YAMLTokenKind.DocumentStart
				if explicit {
					try scanner.next()
				} else {
					fail yamlError(yamlPlace(token), "directives must be followed by \"---\"") when directives
					fail yamlError(yamlPlace(token), "a document after one that did not end with \"...\" starts with \"---\"") unless afterSuffix
				}
				try emit(YAMLEvent{kind: YAMLEventKind.DocumentStart, line: token.line, column: token.column, explicit: explicit})
				let content = try scanner.peek()
				if explicit && (content.kind := YAMLTokenKind.VersionDirective || YAMLTokenKind.TagDirective || YAMLTokenKind.DocumentStart || YAMLTokenKind.DocumentEnd || YAMLTokenKind.StreamEnd) {
					try emptyScalar(yamlPlace(content), "", "")
				} else {
					try parseNode(block = true, indentless = false, depth = 0)
				}
				let end = try scanner.peek()
				if end.kind == YAMLTokenKind.DocumentEnd {
					try scanner.next()
					try emit(YAMLEvent{kind: YAMLEventKind.DocumentEnd, line: end.line, column: end.column, explicit: true})
					afterSuffix = true
				} else if end.kind := YAMLTokenKind.DocumentStart || YAMLTokenKind.StreamEnd {
					try emit(YAMLEvent{kind: YAMLEventKind.DocumentEnd, line: end.line, column: end.column})
					afterSuffix = false
				} else {
					fail yamlError(yamlPlace(end), "a document has one root node; this content follows it")
				}
			}
		}

		def emptyScalar(mark YAMLMark, anchor string, tag string) !none {
			return try emit(YAMLEvent{kind: YAMLEventKind.Scalar, line: mark.line, column: mark.column, anchor: anchor, tag: tag})
		}

		def resolveTag(token YAMLToken) !string {
			return token.suffix when token.value == ""
			let prefix = handles.get(token.value)
			fail yamlError(yamlPlace(token), "the tag handle {token.value} is not declared") when prefix is none
			return prefix + token.suffix
		}

		// One node: an alias, or properties (anchor and tag, in either
		// order) and content. `indentless` allows a sequence of `- ` entries
		// at the indentation of the mapping key it is the value of.
		def parseNode(block bool, indentless bool, depth int) !none {
			let token = try scanner.peek()
			fail yamlError(yamlPlace(token), "the document nests deeper than {maxDepth} levels") when depth >= maxDepth
			if token.kind == YAMLTokenKind.Alias {
				try scanner.next()
				try emit(YAMLEvent{kind: YAMLEventKind.Alias, line: token.line, column: token.column, value: token.value})
				return none
			}
			let start = yamlPlace(token)
			let anchor = ""
			let tag = ""
			let tagged = false
			for let round = 0; round < 2; round++ {
				if token.kind == YAMLTokenKind.Anchor && anchor == "" {
					anchor = token.value
					try scanner.next()
					token = try scanner.peek()
				} else if token.kind == YAMLTokenKind.Tag && !tagged {
					tag = try resolveTag(token)
					tagged = true
					try scanner.next()
					token = try scanner.peek()
				}
			}
			fail yamlError(yamlPlace(token), "a node has one anchor") when token.kind == YAMLTokenKind.Anchor
			fail yamlError(yamlPlace(token), "a node has one tag") when token.kind == YAMLTokenKind.Tag
			fail yamlError(yamlPlace(token), "an alias cannot have an anchor or a tag") when token.kind == YAMLTokenKind.Alias
			let propertied = anchor != "" || tagged
			if indentless && token.kind == YAMLTokenKind.BlockEntry {
				try emit(YAMLEvent{kind: YAMLEventKind.SequenceStart, line: start.line, column: start.column, anchor: anchor, tag: tag})
				return try parseIndentlessSequence(depth)
			}
			switch token.kind {
				case YAMLTokenKind.Scalar:
					try scanner.next()
					try emit(YAMLEvent{kind: YAMLEventKind.Scalar, line: start.line, column: start.column, anchor: anchor, tag: tag, value: token.value, style: token.style})
					return none
				case YAMLTokenKind.FlowSequenceStart:
					try emit(YAMLEvent{kind: YAMLEventKind.SequenceStart, line: start.line, column: start.column, anchor: anchor, tag: tag, flow: true})
					return try parseFlowSequence(depth)
				case YAMLTokenKind.FlowMappingStart:
					try emit(YAMLEvent{kind: YAMLEventKind.MappingStart, line: start.line, column: start.column, anchor: anchor, tag: tag, flow: true})
					return try parseFlowMapping(depth)
				case YAMLTokenKind.BlockSequenceStart:
					if block {
						try emit(YAMLEvent{kind: YAMLEventKind.SequenceStart, line: start.line, column: start.column, anchor: anchor, tag: tag})
						return try parseBlockSequence(depth)
					}
				case YAMLTokenKind.BlockMappingStart:
					if block {
						try emit(YAMLEvent{kind: YAMLEventKind.MappingStart, line: start.line, column: start.column, anchor: anchor, tag: tag})
						return try parseBlockMapping(depth)
					}
				default:
			}
			if propertied {
				try emptyScalar(start, anchor, tag)
				return none
			}
			fail yamlError(yamlPlace(token), "expected a node, found {yamlTokenName(token.kind)}")
		}

		def parseBlockSequence(depth int) !none {
			try scanner.next()
			for {
				let token = try scanner.next()
				if token.kind == YAMLTokenKind.BlockEnd {
					try emit(YAMLEvent{kind: YAMLEventKind.SequenceEnd, line: token.line, column: token.column})
					return none
				}
				fail yamlError(yamlPlace(token), "expected a \"- \" entry, found {yamlTokenName(token.kind)}") unless token.kind == YAMLTokenKind.BlockEntry
				let after = try scanner.peek()
				if after.kind := YAMLTokenKind.BlockEntry || YAMLTokenKind.BlockEnd {
					try emptyScalar(yamlPlace(after), "", "")
				} else {
					try parseNode(block = true, indentless = false, depth = depth + 1)
				}
			}
		}

		def parseIndentlessSequence(depth int) !none {
			for {
				let token = try scanner.peek()
				if token.kind != YAMLTokenKind.BlockEntry {
					try emit(YAMLEvent{kind: YAMLEventKind.SequenceEnd, line: token.line, column: token.column})
					return none
				}
				try scanner.next()
				let after = try scanner.peek()
				if after.kind := YAMLTokenKind.BlockEntry || YAMLTokenKind.Key || YAMLTokenKind.Value || YAMLTokenKind.BlockEnd {
					try emptyScalar(yamlPlace(after), "", "")
				} else {
					try parseNode(block = true, indentless = false, depth = depth + 1)
				}
			}
		}

		def parseBlockMapping(depth int) !none {
			try scanner.next()
			for {
				let token = try scanner.peek()
				if token.kind == YAMLTokenKind.BlockEnd {
					try scanner.next()
					try emit(YAMLEvent{kind: YAMLEventKind.MappingEnd, line: token.line, column: token.column})
					return none
				}
				if token.kind == YAMLTokenKind.Key {
					try scanner.next()
					let after = try scanner.peek()
					if after.kind := YAMLTokenKind.Key || YAMLTokenKind.Value || YAMLTokenKind.BlockEnd {
						try emptyScalar(yamlPlace(after), "", "")
					} else {
						try parseNode(block = true, indentless = true, depth = depth + 1)
					}
				} else if token.kind == YAMLTokenKind.Value {
					try emptyScalar(yamlPlace(token), "", "")
				} else {
					fail yamlError(yamlPlace(token), "expected a mapping key, found {yamlTokenName(token.kind)}")
				}
				let value = try scanner.peek()
				if value.kind == YAMLTokenKind.Value {
					try scanner.next()
					let after = try scanner.peek()
					if after.kind := YAMLTokenKind.Key || YAMLTokenKind.Value || YAMLTokenKind.BlockEnd {
						try emptyScalar(yamlPlace(after), "", "")
					} else {
						try parseNode(block = true, indentless = true, depth = depth + 1)
					}
				} else {
					try emptyScalar(yamlPlace(value), "", "")
				}
			}
		}

		// The value after a flow key: `: node`, `:` alone, or nothing.
		def parseFlowValue(closing YAMLTokenKind, depth int) !none {
			let value = try scanner.peek()
			if value.kind == YAMLTokenKind.Value {
				try scanner.next()
				let after = try scanner.peek()
				if after.kind == YAMLTokenKind.FlowEntry || after.kind == closing {
					try emptyScalar(yamlPlace(after), "", "")
				} else {
					try parseNode(block = false, indentless = false, depth = depth + 1)
				}
			} else {
				try emptyScalar(yamlPlace(value), "", "")
			}
			return none
		}

		def parseFlowSequence(depth int) !none {
			try scanner.next()
			let first = true
			for {
				let token = try scanner.peek()
				if token.kind == YAMLTokenKind.FlowSequenceEnd {
					try scanner.next()
					try emit(YAMLEvent{kind: YAMLEventKind.SequenceEnd, line: token.line, column: token.column})
					return none
				}
				if !first {
					fail yamlError(yamlPlace(token), "expected \",\" or \"]\", found {yamlTokenName(token.kind)}") unless token.kind == YAMLTokenKind.FlowEntry
					try scanner.next()
					token = try scanner.peek()
					continue when token.kind == YAMLTokenKind.FlowSequenceEnd
				}
				first = false
				// A single pair: `? a : b`, `a: b`, or `: b`.
				if token.kind := YAMLTokenKind.Key || YAMLTokenKind.Value {
					try emit(YAMLEvent{kind: YAMLEventKind.MappingStart, line: token.line, column: token.column, flow: true})
					if token.kind == YAMLTokenKind.Key {
						try scanner.next()
						let after = try scanner.peek()
						if after.kind := YAMLTokenKind.Value || YAMLTokenKind.FlowEntry || YAMLTokenKind.FlowSequenceEnd {
							try emptyScalar(yamlPlace(after), "", "")
						} else {
							try parseNode(block = false, indentless = false, depth = depth + 1)
						}
					} else {
						try emptyScalar(yamlPlace(token), "", "")
					}
					try parseFlowValue(YAMLTokenKind.FlowSequenceEnd, depth)
					try emit(YAMLEvent{kind: YAMLEventKind.MappingEnd, line: token.line, column: token.column})
					continue
				}
				try parseNode(block = false, indentless = false, depth = depth + 1)
			}
		}

		def parseFlowMapping(depth int) !none {
			try scanner.next()
			let first = true
			for {
				let token = try scanner.peek()
				if token.kind == YAMLTokenKind.FlowMappingEnd {
					try scanner.next()
					try emit(YAMLEvent{kind: YAMLEventKind.MappingEnd, line: token.line, column: token.column})
					return none
				}
				if !first {
					fail yamlError(yamlPlace(token), "expected \",\" or \"\}\", found {yamlTokenName(token.kind)}") unless token.kind == YAMLTokenKind.FlowEntry
					try scanner.next()
					token = try scanner.peek()
					continue when token.kind == YAMLTokenKind.FlowMappingEnd
				}
				first = false
				if token.kind == YAMLTokenKind.Key {
					try scanner.next()
					let after = try scanner.peek()
					if after.kind := YAMLTokenKind.Value || YAMLTokenKind.FlowEntry || YAMLTokenKind.FlowMappingEnd {
						try emptyScalar(yamlPlace(after), "", "")
					} else {
						try parseNode(block = false, indentless = false, depth = depth + 1)
					}
					try parseFlowValue(YAMLTokenKind.FlowMappingEnd, depth)
				} else if token.kind == YAMLTokenKind.Value {
					try emptyScalar(yamlPlace(token), "", "")
					try parseFlowValue(YAMLTokenKind.FlowMappingEnd, depth)
				} else {
					try parseNode(block = false, indentless = false, depth = depth + 1)
					try emptyScalar(yamlPlace(token), "", "")
				}
			}
		}
	}

	internal def yamlTokenName(kind YAMLTokenKind) string {
		switch kind {
			case YAMLTokenKind.StreamEnd:
				return "the end of the input"
			case YAMLTokenKind.DocumentStart:
				return "\"---\""
			case YAMLTokenKind.DocumentEnd:
				return "\"...\""
			case YAMLTokenKind.BlockEnd:
				return "the end of a block"
			case YAMLTokenKind.FlowSequenceStart:
				return "\"[\""
			case YAMLTokenKind.FlowSequenceEnd:
				return "\"]\""
			case YAMLTokenKind.FlowMappingStart:
				return "\"\{\""
			case YAMLTokenKind.FlowMappingEnd:
				return "\"\}\""
			case YAMLTokenKind.BlockEntry:
				return "\"-\""
			case YAMLTokenKind.FlowEntry:
				return "\",\""
			case YAMLTokenKind.Key:
				return "\"?\""
			case YAMLTokenKind.Value:
				return "\":\""
			case YAMLTokenKind.BlockSequenceStart, YAMLTokenKind.BlockMappingStart:
				return "an indented block"
			case YAMLTokenKind.Scalar:
				return "a scalar"
			case YAMLTokenKind.Alias:
				return "an alias"
			default:
				return "a directive"
		}
	}

	// The events of a stream, one per line, in the notation of the YAML
	// test suite (`+MAP {} &a <tag>`, `=VAL :text`, `=ALI *a`).
	internal def yamlEventText(event YAMLEvent) string {
		let props = (event.anchor != "" ?? (" &" + event.anchor, "")) + (event.tag != "" ?? (" <" + event.tag + ">", ""))
		switch event.kind {
			case YAMLEventKind.StreamStart:
				return "+STR"
			case YAMLEventKind.StreamEnd:
				return "-STR"
			case YAMLEventKind.DocumentStart:
				return event.explicit ?? ("+DOC ---", "+DOC")
			case YAMLEventKind.DocumentEnd:
				return event.explicit ?? ("-DOC ...", "-DOC")
			case YAMLEventKind.SequenceStart:
				return "+SEQ" + (event.flow ?? (" []", "")) + props
			case YAMLEventKind.SequenceEnd:
				return "-SEQ"
			case YAMLEventKind.MappingStart:
				return "+MAP" + (event.flow ?? (" \{\}", "")) + props
			case YAMLEventKind.MappingEnd:
				return "-MAP"
			case YAMLEventKind.Alias:
				return "=ALI *" + event.value
			default:
		}
		let indicator = ":"
		switch event.style {
			case YAMLScalarStyle.SingleQuoted:
				indicator = "'"
			case YAMLScalarStyle.DoubleQuoted:
				indicator = "\""
			case YAMLScalarStyle.Literal:
				indicator = "|"
			case YAMLScalarStyle.Folded:
				indicator = ">"
			default:
		}
		let out byte[] = []
		for let b in event.value.bytes() {
			switch int(b) {
				case 0x5C:
					out += "\\\\".bytes()
				case 0x0A:
					out += "\\n".bytes()
				case 0x09:
					out += "\\t".bytes()
				case 0x08:
					out += "\\b".bytes()
				case 0x0D:
					out += "\\r".bytes()
				default:
					out.push(b)
			}
		}
		return "=VAL" + props + " " + indicator + string(out)
	}

	// The events of a whole stream. Fails on the first error, with its line
	// and column.
	internal def yamlEvents(src byte[], maxDepth int) !YAMLEvent[] {
		let parser = new YAMLParser(try yamlUTF8(src), maxDepth)
		try parser.parseStream()
		return parser.events
	}

	// The plain values of every document of a stream, built while it is
	// parsed. Fails on the first error, with its line and column.
	internal def yamlValues(src byte[], maxDepth int) !any[] {
		let parser = new YAMLParser(try yamlUTF8(src), maxDepth)
		let composer = new YAMLValueComposer()
		parser.sink = composer
		try parser.parseStream()
		return composer.documents
	}

	// The node graph of every document of a stream, composed while it is
	// parsed. Fails on the first error, with its line and column.
	internal def yamlDocuments(src byte[], maxDepth int) !YAMLNode[] {
		let parser = new YAMLParser(try yamlUTF8(src), maxDepth)
		let composer = new YAMLComposer()
		parser.sink = composer
		try parser.parseStream()
		return composer.documents
	}

	// The input as UTF-8: a UTF-16 or UTF-32 stream (by its byte order mark,
	// or the zero bytes of its first character, YAML 1.2.2 §5.2) is
	// converted. Characters YAML does not allow (C0 and C1 controls but tab,
	// line feed, carriage return and NEL, surrogates, U+FFFE, U+FFFF) and
	// ill-formed UTF-8 fail.
	internal def yamlUTF8(src byte[]) !byte[] {
		let n = src.len()
		let utf32be = n >= 4 && src[0] == byte(0) && src[1] == byte(0) && ((src[2] == byte(0xFE) && src[3] == byte(0xFF)) || src[2] == byte(0))
		let utf32le = n >= 4 && src[2] == byte(0) && src[3] == byte(0) && ((src[0] == byte(0xFF) && src[1] == byte(0xFE)) || src[1] == byte(0))
		let utf16be = !utf32be && n >= 2 && ((src[0] == byte(0xFE) && src[1] == byte(0xFF)) || src[0] == byte(0))
		let utf16le = !utf32le && n >= 2 && ((src[0] == byte(0xFF) && src[1] == byte(0xFE)) || src[1] == byte(0))
		let text = src
		if utf32be || utf32le || utf16be || utf16le {
			let width = utf32be || utf32le ?? (4, 2)
			fail YAMLError{message: "yaml: the input is cut inside a character", line: 1, column: 1} unless n % width == 0
			let out byte[] = []
			let i = 0
			for i < n {
				let unit = 0
				if width == 4 {
					unit = utf32be ?? ((int(src[i]) << 24) | (int(src[i + 1]) << 16) | (int(src[i + 2]) << 8) | int(src[i + 3]), (int(src[i + 3]) << 24) | (int(src[i + 2]) << 16) | (int(src[i + 1]) << 8) | int(src[i]))
					i += 4
				} else {
					unit = utf16be ?? ((int(src[i]) << 8) | int(src[i + 1]), (int(src[i + 1]) << 8) | int(src[i]))
					i += 2
					if unit >= 0xD800 && unit <= 0xDBFF && i + 1 < n {
						let low = utf16be ?? ((int(src[i]) << 8) | int(src[i + 1]), (int(src[i + 1]) << 8) | int(src[i]))
						if low >= 0xDC00 && low <= 0xDFFF {
							unit = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
							i += 2
						}
					}
				}
				fail YAMLError{message: "yaml: the input holds U+{"%X".format(unit)}, which is not a character", line: 1, column: 1} when (unit >= 0xD800 && unit <= 0xDFFF) || unit > 0x10FFFF
				// U+0000 cannot reach a string; the printable check refuses it.
				if unit == 0 {
					out.push(byte(0))
				} else {
					out += string(char(unit)).bytes()
				}
			}
			text = out
		}
		try yamlCheckPrintable(text)
		return text
	}

	// Checks the whole input at once: runs of 32 printable ASCII bytes (and
	// tab, line feed, carriage return) pass a vector at a time; the rest is
	// decoded as UTF-8. The line and column of a problem are counted only
	// when there is one.
	internal def yamlCheckPrintable(text byte[]) !none {
		let n = text.len()
		let low = simd.splat32<byte>(byte(0x20))
		let high = simd.splat32<byte>(byte(0x7E))
		let tab = simd.splat32<byte>(byte(9))
		let lf = simd.splat32<byte>(byte(10))
		let cr = simd.splat32<byte>(byte(13))
		let i = 0
		for i < n {
			for i + 32 <= n {
				let v = simd.load32<byte>(text, i)
				let ok = (v.ge(low) & v.le(high)) | v.eq(tab) | v.eq(lf) | v.eq(cr)
				break unless ok.all()
				i += 32
			}
			break when i >= n
			let b = int(text[i])
			if b < 0x80 {
				fail yamlPlaceError(text, i, "the character U+{"%04X".format(b)} is not allowed in YAML") when (b < 0x20 && b != 0x09 && b != 0x0A && b != 0x0D) || b == 0x7F
				i++
				continue
			}
			let size = b >= 0xF0 ?? (4, b >= 0xE0 ?? (3, b >= 0xC0 ?? (2, 0)))
			fail yamlPlaceError(text, i, "the input is not UTF-8") when size == 0 || i + size > n || b > 0xF4
			let cp = size == 2 ?? (b & 0x1F, size == 3 ?? (b & 0x0F, b & 0x07))
			for let k = 1; k < size; k++ {
				let c = int(text[i + k])
				fail yamlPlaceError(text, i, "the input is not UTF-8") unless c >= 0x80 && c < 0xC0
				cp = (cp << 6) | (c & 0x3F)
			}
			let shortest = size == 2 ?? (cp >= 0x80, size == 3 ?? (cp >= 0x800, cp >= 0x10000 && cp <= 0x10FFFF))
			fail yamlPlaceError(text, i, "the input is not UTF-8") unless shortest
			let printable = cp == 0x85 || (cp >= 0xA0 && cp <= 0xD7FF) || (cp >= 0xE000 && cp <= 0xFFFD) || cp >= 0x10000
			fail yamlPlaceError(text, i, "the character U+{"%04X".format(cp)} is not allowed in YAML") unless printable
			i += size
		}
		return none
	}

	// The error for the byte at offset i, with its line and column.
	internal def yamlPlaceError(text byte[], i int, problem string) YAMLError {
		let line = 0
		let lineStart = 0
		for let k = 0; k < i; k++ {
			if text[k] == byte(10) {
				line++
				lineStart = k + 1
			}
		}
		return yamlError(YAMLMark{pos: i, line: line, column: utf8Count(text, lineStart, i)}, problem)
	}

	internal enum YAMLNodeKind {
		Scalar,
		Sequence,
		Mapping
	}

	// A node of the representation graph: an alias is the node its anchor
	// names, the same object.
	internal type YAMLNode {
		kind   YAMLNodeKind
		line   int             = 0
		column int             = 0
		tag    string          = ""
		text   string          = ""
		style  YAMLScalarStyle = YAMLScalarStyle.Plain
		// A sequence's items; a mapping's keys and values, one after the
		// other.
		items  YAMLNode[]      = []
		// The plain value once built, shared by every alias of the node.
		plain  any             = none
		built  bool            = false

		def new(kind YAMLNodeKind, start YAMLMark) {
			self.kind = kind
			line = start.line
			column = start.column
		}

		// A null: an untagged plain scalar the core schema reads as null, or
		// one tagged `!!null`.
		def isNull() bool {
			return false unless kind == YAMLNodeKind.Scalar
			return true when tag == "tag:yaml.org,2002:null"
			return tag == "" && self.style == YAMLScalarStyle.Plain && (text := "" || "~" || "null" || "Null" || "NULL")
		}

		def describe() string {
			switch kind {
				case YAMLNodeKind.Sequence:
					return "a sequence"
				case YAMLNodeKind.Mapping:
					return "a mapping"
				default:
					return "a scalar"
			}
		}
	}

	// Takes the events of a stream as the parser makes them.
	internal interface YAMLEventSink {
		def add(event YAMLEvent) !none
	}

	// Builds plain values from events, as they come: what `YAML.parse`
	// returns, without the node graph `decode` needs.
	internal type YAMLValueComposer {
		anchors   map<string, any>
		open      map<string, bool>
		// The collections being built, innermost last, with their anchors
		// and, for a mapping, the key waiting for its value.
		stack     any[]             = []
		anchorsOf string[]          = []
		keys      string[]          = []
		keyed     bool[]            = []
		documents any[]             = []

		def new() {
			anchors = map<string, any>{}
			open = map<string, bool>{}
		}

		def add(event YAMLEvent) !none {
			switch event.kind {
				case YAMLEventKind.StreamStart, YAMLEventKind.StreamEnd, YAMLEventKind.DocumentEnd:
					return none
				case YAMLEventKind.DocumentStart:
					anchors = map<string, any>{}
					return none
				case YAMLEventKind.SequenceEnd, YAMLEventKind.MappingEnd:
					stack.pop()
					keys.pop()
					keyed.pop()
					let anchor = anchorsOf.pop()
					open.delete(anchor) when anchor != ""
					return none
				case YAMLEventKind.Alias:
					fail yamlError(yamlPlace(event), "the alias *{event.value} names no anchor before it") unless anchors.hasKey(event.value)
					fail yamlError(yamlPlace(event), "the alias *{event.value} is inside the node its anchor names") when open.hasKey(event.value)
					return try put(anchors[event.value], event)
				case YAMLEventKind.Scalar:
					let value = try yamlScalarOf(event.value, event.tag, event.style, yamlPlace(event))
					anchors[event.anchor] = value when event.anchor != ""
					return try put(value, event)
				default:
			}
			let sequence = event.kind == YAMLEventKind.SequenceStart
			fail yamlError(yamlPlace(event), "the tag {event.tag} cannot be on a {sequence ?? ("sequence", "mapping")}") when yamlScalarTag(event.tag)
			let container any = none
			if sequence {
				let items any[] = []
				container = items
			} else {
				let entries map<string, any> = map<string, any>{}
				container = entries
			}
			if event.anchor != "" {
				anchors[event.anchor] = container
				open[event.anchor] = true
			}
			try put(container, event)
			stack.push(container)
			anchorsOf.push(event.anchor)
			keys.push("")
			keyed.push(false)
			return none
		}

		// Adds a value to the collection being built, or as a document.
		def put(value any, event YAMLEvent) !none {
			if stack.len() == 0 {
				documents.push(value)
				return none
			}
			let top = stack.len() - 1
			let parent = stack[top]
			if parent is any[] {
				parent.push(value)
				return none
			}
			if parent is map<string, any> {
				if !keyed[top] {
					let name = try yamlKeyText(value, yamlPlace(event))
					fail yamlError(yamlPlace(event), "the key \"{name}\" is in this mapping twice") when parent.hasKey(name)
					keys[top] = name
					keyed[top] = true
				} else {
					parent[keys[top]] = value
					keyed[top] = false
				}
			}
			return none
		}
	}

	// Builds the node graph of each document from events, as they come.
	internal type YAMLComposer {
		anchors   map<string, YAMLNode>
		// Anchors whose node is still being built: an alias to one would
		// make the node contain itself.
		open      map<string, bool>
		// The collections being built, innermost last, and their anchors.
		stack     YAMLNode[]            = []
		anchorsOf string[]              = []
		documents YAMLNode[]            = []

		def new() {
			anchors = map<string, YAMLNode>{}
			open = map<string, bool>{}
		}

		def add(event YAMLEvent) !none {
			switch event.kind {
				case YAMLEventKind.StreamStart, YAMLEventKind.StreamEnd, YAMLEventKind.DocumentEnd:
					return none
				case YAMLEventKind.DocumentStart:
					anchors = map<string, YAMLNode>{}
					return none
				case YAMLEventKind.SequenceEnd, YAMLEventKind.MappingEnd:
					stack.pop()
					let anchor = anchorsOf.pop()
					open.delete(anchor) when anchor != ""
					return none
				case YAMLEventKind.Alias:
					let target = anchors.get(event.value)
					fail yamlError(yamlPlace(event), "the alias *{event.value} names no anchor before it") when target is none
					fail yamlError(yamlPlace(event), "the alias *{event.value} is inside the node its anchor names") when open.hasKey(event.value)
					attach(target)
					return none
				default:
			}
			let kind = event.kind == YAMLEventKind.Scalar ?? (YAMLNodeKind.Scalar, event.kind == YAMLEventKind.SequenceStart ?? (YAMLNodeKind.Sequence, YAMLNodeKind.Mapping))
			let node = new YAMLNode(kind, yamlPlace(event))
			node.tag = event.tag
			node.text = event.value
			node.style = event.style
			anchors[event.anchor] = node when event.anchor != ""
			attach(node)
			return none when kind == YAMLNodeKind.Scalar
			fail yamlError(yamlPlace(event), "the tag {event.tag} cannot be on {node.describe()}") when yamlScalarTag(event.tag)
			open[event.anchor] = true when event.anchor != ""
			stack.push(node)
			anchorsOf.push(event.anchor)
			return none
		}

		def attach(node YAMLNode) {
			if stack.len() == 0 {
				documents.push(node)
			} else {
				stack[stack.len() - 1].items.push(node)
			}
		}
	}

	// A node as plain values: mappings as `map<string, any>`, sequences as
	// `any[]`, scalars by the core schema or their tag. Keys are held as
	// text; two keys with the same text fail.
	internal def yamlPlain(node YAMLNode) !any {
		return node.plain when node.built
		if node.kind == YAMLNodeKind.Scalar {
			node.plain = try yamlScalarValue(node)
			node.built = true
			return node.plain
		}
		if node.kind == YAMLNodeKind.Sequence {
			let items any[] = []
			node.plain = items
			node.built = true
			for let item in node.items {
				items.push(try yamlPlain(item))
			}
			return items
		}
		let entries map<string, any> = map<string, any>{}
		node.plain = entries
		node.built = true
		for let i = 0; i + 1 < node.items.len(); i += 2 {
			let key = node.items[i]
			let name = try yamlKeyText(try yamlPlain(key), yamlPlace(key))
			fail yamlError(yamlPlace(key), "the key \"{name}\" is in this mapping twice") when entries.hasKey(name)
			entries[name] = try yamlPlain(node.items[i + 1])
		}
		return entries
	}

	// Whether a tag is one of the core schema's scalar tags.
	internal def yamlScalarTag(tag string) bool {
		return tag := "tag:yaml.org,2002:str" || "tag:yaml.org,2002:int" || "tag:yaml.org,2002:float" || "tag:yaml.org,2002:bool" || "tag:yaml.org,2002:null"
	}

	// A mapping key as the string a `map<string, any>` holds it under.
	internal def yamlKeyText(key ?any, mark YAMLMark) !string {
		return key when key is string
		return "null" when key is none
		return key ?? ("true", "false") when key is bool
		return "{key}" when key is int
		return yamlFloatText(key) when key is float
		fail yamlError(mark, "a mapping key must be a scalar to be read into a map<string, any>")
	}

	internal def yamlFloatText(value float) string {
		return ".nan" when value != value
		return value > 0.0 ?? (".inf", "-.inf") when value * 0.0 != 0.0
		return "{value}"
	}

	// A scalar's value: by its tag when it has one, else by the core schema
	// when plain, else a string.
	internal def yamlScalarValue(node YAMLNode) !any {
		return try yamlScalarOf(node.text, node.tag, node.style, yamlPlace(node))
	}

	internal def yamlScalarOf(text string, tag string, scalarStyle YAMLScalarStyle, mark YAMLMark) !any {
		return scalarStyle == YAMLScalarStyle.Plain ?? (yamlCoreValue(text), text) when tag == ""
		switch tag {
			case "tag:yaml.org,2002:null":
				fail yamlError(mark, "\"{text}\" is not a null") unless text := "" || "~" || "null" || "Null" || "NULL"
				return none
			case "tag:yaml.org,2002:bool":
				let value = yamlCoreValue(text)
				fail yamlError(mark, "\"{text}\" is not a bool") unless value is bool
				return value
			case "tag:yaml.org,2002:int":
				let value = yamlCoreValue(text)
				fail yamlError(mark, "\"{text}\" is not an int") unless value is int
				return value
			case "tag:yaml.org,2002:float":
				let value = yamlCoreValue(text)
				return float(value) when value is int
				fail yamlError(mark, "\"{text}\" is not a float") unless value is float
				return value
			case "tag:yaml.org,2002:seq", "tag:yaml.org,2002:map":
				fail yamlError(mark, "the tag {tag} cannot be on a scalar")
			default:
				return text
		}
	}

	// The core schema of YAML 1.2.2 §10.3: null, bool, int (decimal, 0o,
	// 0x), float (with .inf and .nan); anything else is a string. An int
	// past 64 bits is a float, as `JSON.parse` reads it.
	internal def yamlCoreValue(text string) any {
		let n = text.len()
		return none when n == 0
		let first = text[0]
		if n <= 5 {
			switch text {
				case "~", "null", "Null", "NULL":
					return none
				case "true", "True", "TRUE":
					return true
				case "false", "False", "FALSE":
					return false
				case ".inf", ".Inf", ".INF", "+.inf", "+.Inf", "+.INF":
					return 1.0 / 0.0
				case "-.inf", "-.Inf", "-.INF":
					return -1.0 / 0.0
				case ".nan", ".NaN", ".NAN":
					return 0.0 / 0.0
				default:
			}
		}
		return text unless (first >= '0' && first <= '9') || (first := '-' || '+' || '.')
		if /^[-+]?[0-9]+$/.test(text) {
			let digits = text.trimStart("+-")
			let negative = first == '-'
			let fits = negative ?? (integerFits(digits, "9223372036854775808"), integerFits(digits, "9223372036854775807"))
			return fits ?? (parseInt<int>(text.trimStart("+")), parseFloat<float>(text))
		}
		return text[2:].trimStart("0").len() <= 21 ?? (parseInt<int>(text[2:], 8), yamlRadixFloat(text[2:], 8)) when /^0o[0-7]+$/.test(text)
		if /^0x[0-9a-fA-F]+$/.test(text) {
			let digits = text[2:].trimStart("0")
			return digits.len() < 16 || (digits.len() == 16 && digits[0] <= '7') ?? (parseInt<int>(text[2:], 16), yamlRadixFloat(text[2:], 16))
		}
		return parseFloat<float>(text) when /^[-+]?(\.[0-9]+|[0-9]+(\.[0-9]*)?)([eE][-+]?[0-9]+)?$/.test(text)
		return text
	}

	internal def yamlRadixFloat(digits string, radix int) float {
		let value = 0.0
		for let d in digits.bytes() {
			let c = int(d)
			let digit = c <= 57 ?? (c - 48, c >= 97 ?? (c - 87, c - 55))
			value = value * float(radix) + float(digit)
		}
		return value
	}
}
