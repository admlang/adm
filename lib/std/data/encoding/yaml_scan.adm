partial module std.data.encoding {
	use std.errors

	// YAMLError is the payload of a document `YAML.parse` or `YAML.decode`
	// rejects.
	struct YAMLError {
		message string
		code    string            = "yaml"
		cause   ?error
		stack   errors.StackTrace
		// Where the problem was found, both counted from 1.
		line    int
		column  int
	}

	// The code points of src[from:to], counted by their first bytes.
	internal def utf8Count(src byte[], from int, to int) int {
		let count = 0
		for let i = from; i < to; i++ {
			count++ when (int(src[i]) & 0xC0) != 0x80
		}
		return count
	}

	// `,` `[` `]` `{` `}`.
	internal def yamlFlowIndicator(b int) bool {
		return b == 44 || b == 91 || b == 93 || b == 123 || b == 125
	}

	// Where a token, an event or a node starts.
	internal def yamlPlace(token YAMLToken) YAMLMark {
		return YAMLMark{line: token.line, column: token.column}
	}

	internal def yamlPlace(event YAMLEvent) YAMLMark {
		return YAMLMark{line: event.line, column: event.column}
	}

	internal def yamlPlace(node YAMLNode) YAMLMark {
		return YAMLMark{line: node.line, column: node.column}
	}

	internal def yamlError(mark YAMLMark, problem string) YAMLError {
		return YAMLError{message: "yaml: line {mark.line + 1}, column {mark.column + 1}: {problem}", line: mark.line + 1, column: mark.column + 1}
	}

	// The tokens of YAML 1.2.2, as a scanner in the shape of libyaml's makes
	// them: indentation becomes BlockSequenceStart/BlockMappingStart and
	// BlockEnd, and a Key token is put in front of an implicit key once its
	// `:` is seen.
	internal enum YAMLTokenKind {
		StreamStart,
		StreamEnd,
		VersionDirective,
		TagDirective,
		DocumentStart,
		DocumentEnd,
		BlockSequenceStart,
		BlockMappingStart,
		BlockEnd,
		FlowSequenceStart,
		FlowSequenceEnd,
		FlowMappingStart,
		FlowMappingEnd,
		BlockEntry,
		FlowEntry,
		Key,
		Value,
		Alias,
		Anchor,
		Tag,
		Scalar
	}

	internal enum YAMLScalarStyle {
		Plain,
		SingleQuoted,
		DoubleQuoted,
		Literal,
		Folded
	}

	// A place in the input: byte offset, line and column (code points),
	// both from 0.
	internal struct YAMLMark {
		pos    int = 0
		line   int = 0
		column int = 0
	}

	internal struct YAMLToken {
		kind   YAMLTokenKind
		// Where the token starts, from 0.
		line   int             = 0
		column int             = 0
		// The scalar, the anchor or alias name, the tag handle or the
		// directive's handle.
		value  string          = ""
		// The tag suffix, or a %TAG directive's prefix.
		suffix string          = ""
		style  YAMLScalarStyle = YAMLScalarStyle.Plain
		major  int             = 0
		minor  int             = 0
	}

	internal type YAMLScanner {
		src              byte[]
		pos              int           = 0
		line             int           = 0
		column           int           = 0
		tokens           YAMLToken[]   = []
		// The next token handed out, counted from the start of the stream;
		// tokens before it are done with. `tokens` holds those from `base`
		// on, dropped in batches as the parser moves on.
		head             int           = 0
		base             int           = 0
		streamStarted    bool          = false
		streamEnded      bool          = false
		flowLevel        int           = 0
		indent           int           = -1
		indents          int[]         = []
		simpleKeyAllowed bool          = false
		// Where an implicit key may have begun (libyaml's simple keys), one
		// slot per flow level and one for block context, as columns of
		// plain values: whether one is possible, required, the number of
		// its first token, where it starts, and whether the slot is a flow
		// mapping's (whose keys may span lines).
		keyPossible      bool[]        = []
		keyRequired      bool[]        = []
		keyToken         int[]         = []
		keyPos           int[]         = []
		keyLine          int[]         = []
		keyColumn        int[]         = []
		keyFlowMapping   bool[]        = []
		// How many slots hold a possible key.
		possibleKeys     int           = 0
		// Inside a document, where `%` at the start of a line is content,
		// not a directive.
		documentOpen     bool          = false
		// Where the last quoted scalar or flow collection ended: a `:` right
		// there is a value indicator even in flow context without a space.
		adjacentEnd      int           = -1
		lastKind         YAMLTokenKind = YAMLTokenKind.StreamStart
		// The last token was a quoted scalar or a flow collection: in flow
		// context a `:` after it is a value indicator even without a space
		// (YAML 1.2.2 production 155).
		lastJSONLike     bool          = false

		def new(src byte[]) {
			self.src = src
		}

		def mark() YAMLMark {
			return YAMLMark{pos: pos, line: line, column: column}
		}

		// The character at offset k from the current one, '\0' past the end.
		// Bytes past ASCII come back as themselves: only ASCII matters for
		// the indicators.
		def at(k int) char {
			let i = pos + k
			return char(0) when i >= src.len()
			return char(src[i])
		}

		def done() bool {
			return pos >= src.len()
		}

		def isBreakAt(k int) bool {
			let c = at(k)
			return c == '\n' || c == '\r'
		}

		def isBlankAt(k int) bool {
			let c = at(k)
			return c == ' ' || c == '\t'
		}

		// A blank, a line break or the end.
		def isBlankzAt(k int) bool {
			return pos + k >= src.len() || isBlankAt(k) || isBreakAt(k)
		}

		def isFlowIndicatorAt(k int) bool {
			return at(k) := ',' || '[' || ']' || '{' || '}'
		}

		// Moves one character (a whole UTF-8 sequence) forward on the line.
		def skip() {
			let b = int(src[pos])
			let size = b < 0x80 ?? (1, b >= 0xF0 ?? (4, b >= 0xE0 ?? (3, 2)))
			pos += size
			pos = src.len() when pos > src.len()
			column++
		}

		// Moves past a line break (CRLF counts as one).
		def skipBreak() {
			if at(0) == '\r' && at(1) == '\n' {
				pos += 2
			} else {
				pos++
			}
			line++
			column = 0
		}

		// Appends the current character's bytes to out and moves past it.
		def copy(out byte[]) {
			let start = pos
			skip()
			for let i = start; i < pos; i++ {
				out.push(src[i])
			}
		}

		// Reads a line break as "\n".
		def readBreak(out byte[]) {
			skipBreak()
			out.push(byte(10))
		}

		def peek() !YAMLToken {
			try fetchMoreTokens()
			return tokens[head - base]
		}

		def next() !YAMLToken {
			let token = try peek()
			head++
			// No simple key can point before head (fetchMoreTokens holds
			// tokens back until their key is settled), so those are done.
			if head - base >= 1024 {
				let rest YAMLToken[] = []
				for let i = head - base; i < tokens.len(); i++ {
					rest.push(tokens[i])
				}
				tokens = rest
				base = head
			}
			return token
		}

		def fetchMoreTokens() !none {
			for {
				let need = head >= base + tokens.len()
				if !need && possibleKeys > 0 {
					try staleSimpleKeys()
					for let i = 0; i < keyPossible.len(); i++ {
						if keyPossible[i] && keyToken[i] == head {
							need = true
							break
						}
					}
				}
				return none unless need
				try fetchNextToken()
			}
		}

		def fetchNextToken() !none {
			if !streamStarted {
				fetchStreamStart()
				return none
			}
			fail yamlError(mark(), "nothing follows the end of the stream") when streamEnded
			try scanToNextToken()
			try staleSimpleKeys()
			unrollIndent(column)
			if done() {
				try fetchStreamEnd()
				return none
			}
			let c = at(0)
			return try fetchDirective() when column == 0 && c == '%' && !documentOpen
			return try fetchDocumentIndicator(YAMLTokenKind.DocumentStart) when column == 0 && isDocumentMarker('-')
			return try fetchDocumentIndicator(YAMLTokenKind.DocumentEnd) when column == 0 && isDocumentMarker('.')
			try checkSeparated()
			switch c {
				case '[':
					return try fetchFlowCollectionStart(YAMLTokenKind.FlowSequenceStart)
				case '{':
					return try fetchFlowCollectionStart(YAMLTokenKind.FlowMappingStart)
				case ']':
					return try fetchFlowCollectionEnd(YAMLTokenKind.FlowSequenceEnd)
				case '}':
					return try fetchFlowCollectionEnd(YAMLTokenKind.FlowMappingEnd)
				case ',':
					return try fetchFlowEntry()
				default:
			}
			return try fetchBlockEntry() when c == '-' && isBlankzAt(1)
			return try fetchKey() when c == '?' && (isBlankzAt(1) || (flowLevel > 0 && isFlowIndicatorAt(1)))
			return try fetchValue() when c == ':' && (isBlankzAt(1) || (flowLevel > 0 && (isFlowIndicatorAt(1) || lastJSONLike)))
			switch c {
				case '*':
					return try fetchAnchor(YAMLTokenKind.Alias)
				case '&':
					return try fetchAnchor(YAMLTokenKind.Anchor)
				case '!':
					return try fetchTag()
				case '|':
					return try fetchBlockScalar(true) when flowLevel == 0
				case '>':
					return try fetchBlockScalar(false) when flowLevel == 0
				case '\'':
					return try fetchFlowScalar(true)
				case '"':
					return try fetchFlowScalar(false)
				default:
			}
			return try fetchPlainScalar() when canStartPlain()
			fail yamlError(mark(), "a tab cannot be used for indentation") when c == '\t'
			fail yamlError(mark(), "\"{string(c)}\" cannot start any token")
		}

		// `---` or `...` (by its character) at the start of a line, followed by
		// a blank, a line break or the end.
		def isDocumentMarker(c char) bool {
			return column == 0 && at(0) == c && at(1) == c && at(2) == c && isBlankzAt(3)
		}

		// A plain scalar may start here (YAML 1.2.2 production 126).
		def canStartPlain() bool {
			let c = at(0)
			if c := '-' || '?' || ':' {
				return !isBlankzAt(1) && (flowLevel == 0 || !isFlowIndicatorAt(1))
			}
			return !(isBlankzAt(0) || (c := ',' || '[' || ']' || '{' || '}' || '#' || '&' || '*' || '!' || '|' || '>' || '\'' || '"' || '%' || '@' || '`'))
		}

		// A quoted scalar or a flow collection must be followed by a space, a
		// line break or an indicator that may follow it; `"a"b` is not two
		// tokens.
		def checkSeparated() !none {
			return none unless pos == adjacentEnd
			let c = at(0)
			return none when c := ':' || ',' || ']' || '}'
			fail yamlError(mark(), "\"{string(c)}\" must be separated from the node before it by a space")
		}

		def push(token YAMLToken) {
			tokens.push(token)
			lastKind = token.kind
			let quoted = token.kind == YAMLTokenKind.Scalar && (token.style == YAMLScalarStyle.SingleQuoted || token.style == YAMLScalarStyle.DoubleQuoted)
			lastJSONLike = quoted || token.kind == YAMLTokenKind.FlowSequenceEnd || token.kind == YAMLTokenKind.FlowMappingEnd
			documentOpen = true unless token.kind := YAMLTokenKind.StreamStart || YAMLTokenKind.StreamEnd || YAMLTokenKind.VersionDirective || YAMLTokenKind.TagDirective || YAMLTokenKind.DocumentEnd
		}

		// Puts a token in front of the queued token `number`.
		def insert(token YAMLToken, number int) {
			tokens.push(token)
			let at = number - base
			for let i = tokens.len() - 1; i > at; i-- {
				tokens[i] = tokens[i - 1]
			}
			tokens[at] = token
		}

		// Skips separation, comments and line breaks up to the next token.
		def scanToNextToken() !none {
			for {
				pos += 3 when pos == 0 && at(0) == char(0xEF) && at(1) == char(0xBB) && at(2) == char(0xBF)
				// A tab separates tokens, but cannot indent: at the start of a
				// line, before the line is indented past the current block, it
				// is left for the token fetch to refuse, unless nothing follows
				// it on the line.
				let n = src.len()
				for {
					for pos < n && src[pos] == byte(32) {
						pos++
						column++
					}
					break unless pos < n && src[pos] == byte(9) && (!inIndentation() || column > indent || tabOnlyLine())
					pos++
					column++
				}
				fail yamlError(mark(), "a line of a flow collection must be indented deeper than its block") when flowLevel > 0 && column <= indent && inIndentation() && !done() && !isBreakAt(0) && at(0) != '#'
				if at(0) == '#' {
					fail yamlError(mark(), "a comment must be separated from the node before it by a space") when pos > 0 && !isBlankAt(-1) && !isBreakAt(-1)
					skipToLineEnd()
				}
				return none unless isBreakAt(0)
				skipBreak()
				simpleKeyAllowed = true when flowLevel == 0
			}
		}

		// Moves to the line break (or the end) that ends the current line.
		def skipToLineEnd() {
			let n = src.len()
			let from = pos
			for pos < n && src[pos] != byte(10) && src[pos] != byte(13) {
				pos++
			}
			column += utf8Count(src, from, pos)
		}

		// Whether only blanks come before the current character on its line.
		def inIndentation() bool {
			let k = pos - 1
			for k >= 0 && (src[k] == byte(32) || src[k] == byte(9)) {
				k--
			}
			return k < 0 || src[k] == byte(10) || src[k] == byte(13)
		}

		// Whether only blanks, and maybe a comment, follow on this line.
		def tabOnlyLine() bool {
			let k = 0
			for isBlankAt(k) {
				k++
			}
			return isBreakAt(k) || pos + k >= src.len() || at(k) == '#'
		}

		def staleSimpleKeys() !none {
			// In a flow mapping an implicit key may span lines (YAML 1.2.2
			// §7.4.2); in a flow sequence and in block context it may not.
			return none when possibleKeys == 0
			for let i = 0; i < keyPossible.len(); i++ {
				if keyPossible[i] && ((!keyFlowMapping[i] && keyLine[i] < line) || keyPos[i] + 1024 < pos) {
					fail yamlError(mark(), "an implicit key must be on one line and at most 1024 characters, with its \":\"") when keyRequired[i]
					keyPossible[i] = false
					possibleKeys--
				}
			}
			return none
		}

		def saveSimpleKey() !none {
			let required = flowLevel == 0 && indent == column
			if simpleKeyAllowed {
				try removeSimpleKey()
				let top = keyPossible.len() - 1
				keyPossible[top] = true
				possibleKeys++
				keyRequired[top] = required
				keyToken[top] = base + tokens.len()
				keyPos[top] = pos
				keyLine[top] = line
				keyColumn[top] = column
			}
			return none
		}

		def removeSimpleKey() !none {
			let top = keyPossible.len() - 1
			return none unless keyPossible[top]
			fail yamlError(YAMLMark{line: keyLine[top], column: keyColumn[top]}, "did not find the \":\" of this implicit key") when keyRequired[top]
			keyPossible[top] = false
			possibleKeys--
			return none
		}

		def pushKeySlot(mapping bool) {
			keyPossible.push(false)
			keyRequired.push(false)
			keyToken.push(0)
			keyPos.push(0)
			keyLine.push(0)
			keyColumn.push(0)
			keyFlowMapping.push(mapping)
		}

		def increaseFlowLevel(mapping bool) {
			pushKeySlot(mapping)
			flowLevel++
		}

		def decreaseFlowLevel() {
			if flowLevel > 0 {
				flowLevel--
				possibleKeys-- when keyPossible[keyPossible.len() - 1]
				keyPossible.pop()
				keyRequired.pop()
				keyToken.pop()
				keyPos.pop()
				keyLine.pop()
				keyColumn.pop()
				keyFlowMapping.pop()
			}
		}

		// Opens a block collection when column is deeper than the current
		// indentation, its start token at `number` (-1: at the end).
		def rollIndent(at int, number int, kind YAMLTokenKind, place YAMLMark) !none {
			return none when flowLevel > 0
			if indent < at {
				let k = place.pos - 1
				for k >= 0 && src[k] != byte(10) && src[k] != byte(13) {
					fail yamlError(place, "a tab cannot be used for indentation") when src[k] == byte(9)
					k--
				}
				indents.push(indent)
				indent = at
				let token = YAMLToken{kind: kind, line: place.line, column: place.column}
				if number < 0 {
					push(token)
				} else {
					insert(token, number)
				}
			}
			return none
		}

		// Closes the block collections deeper than column.
		def unrollIndent(at int) {
			return when flowLevel > 0
			for indent > at {
				push(YAMLToken{kind: YAMLTokenKind.BlockEnd, line: line, column: column})
				indent = indents.pop()
			}
		}

		def fetchStreamStart() {
			streamStarted = true
			indent = -1
			simpleKeyAllowed = true
			pushKeySlot(false)
			push(YAMLToken{kind: YAMLTokenKind.StreamStart, line: line, column: column})
		}

		def fetchStreamEnd() !none {
			if column != 0 {
				column = 0
				line++
			}
			unrollIndent(-1)
			try removeSimpleKey()
			simpleKeyAllowed = false
			streamEnded = true
			push(YAMLToken{kind: YAMLTokenKind.StreamEnd, line: line, column: column})
			return none
		}

		def fetchDocumentIndicator(kind YAMLTokenKind) !none {
			unrollIndent(-1)
			try removeSimpleKey()
			simpleKeyAllowed = false
			let start = mark()
			skip()
			skip()
			skip()
			push(YAMLToken{kind: kind, line: start.line, column: start.column})
			documentOpen = kind == YAMLTokenKind.DocumentStart
			if kind == YAMLTokenKind.DocumentEnd {
				for isBlankAt(0) {
					skip()
				}
				fail yamlError(mark(), "only a comment may follow \"...\" on its line") unless done() || isBreakAt(0) || at(0) == '#'
			}
			return none
		}

		def fetchFlowCollectionStart(kind YAMLTokenKind) !none {
			try saveSimpleKey()
			increaseFlowLevel(kind == YAMLTokenKind.FlowMappingStart)
			simpleKeyAllowed = true
			let start = mark()
			skip()
			push(YAMLToken{kind: kind, line: start.line, column: start.column})
			return none
		}

		def fetchFlowCollectionEnd(kind YAMLTokenKind) !none {
			try removeSimpleKey()
			decreaseFlowLevel()
			simpleKeyAllowed = false
			let start = mark()
			skip()
			push(YAMLToken{kind: kind, line: start.line, column: start.column})
			adjacentEnd = pos
			return none
		}

		def fetchFlowEntry() !none {
			try removeSimpleKey()
			simpleKeyAllowed = true
			let start = mark()
			skip()
			push(YAMLToken{kind: YAMLTokenKind.FlowEntry, line: start.line, column: start.column})
			return none
		}

		def fetchBlockEntry() !none {
			fail yamlError(mark(), "a \"- \" sequence entry cannot be in a flow collection") when flowLevel > 0
			fail yamlError(mark(), "a sequence entry is not allowed here") unless simpleKeyAllowed
			try rollIndent(column, -1, YAMLTokenKind.BlockSequenceStart, mark())
			try removeSimpleKey()
			simpleKeyAllowed = true
			let start = mark()
			skip()
			push(YAMLToken{kind: YAMLTokenKind.BlockEntry, line: start.line, column: start.column})
			return none
		}

		def fetchKey() !none {
			if flowLevel == 0 {
				fail yamlError(mark(), "a mapping key is not allowed here") unless simpleKeyAllowed
				try rollIndent(column, -1, YAMLTokenKind.BlockMappingStart, mark())
			}
			try removeSimpleKey()
			simpleKeyAllowed = flowLevel == 0
			let start = mark()
			skip()
			push(YAMLToken{kind: YAMLTokenKind.Key, line: start.line, column: start.column})
			return none
		}

		def fetchValue() !none {
			let top = keyPossible.len() - 1
			if keyPossible[top] {
				insert(YAMLToken{kind: YAMLTokenKind.Key, line: keyLine[top], column: keyColumn[top]}, keyToken[top])
				try rollIndent(keyColumn[top], keyToken[top], YAMLTokenKind.BlockMappingStart, YAMLMark{pos: keyPos[top], line: keyLine[top], column: keyColumn[top]})
				keyPossible[top] = false
				possibleKeys--
				simpleKeyAllowed = false
			} else {
				if flowLevel == 0 {
					fail yamlError(mark(), "a mapping value is not allowed here") unless simpleKeyAllowed
					try rollIndent(column, -1, YAMLTokenKind.BlockMappingStart, mark())
				}
				simpleKeyAllowed = flowLevel == 0
			}
			let start = mark()
			skip()
			push(YAMLToken{kind: YAMLTokenKind.Value, line: start.line, column: start.column})
			return none
		}

		def fetchAnchor(kind YAMLTokenKind) !none {
			try saveSimpleKey()
			simpleKeyAllowed = false
			let start = mark()
			skip()
			let name byte[] = []
			// ns-anchor-char: any non-space character but the flow indicators.
			for !isBlankzAt(0) && !isFlowIndicatorAt(0) {
				copy(name)
			}
			fail yamlError(start, "an {kind == YAMLTokenKind.Alias ?? ("alias", "anchor")} needs a name") when name.len() == 0
			push(YAMLToken{kind: kind, line: start.line, column: start.column, value: string(name)})
			return none
		}

		def fetchTag() !none {
			try saveSimpleKey()
			simpleKeyAllowed = false
			let start = mark()
			let handle = ""
			let suffix = ""
			if at(1) == '<' {
				skip()
				skip()
				suffix = try scanTagURI(true)
				fail yamlError(start, "a verbatim tag needs a closing \">\"") unless at(0) == '>'
				skip()
				fail yamlError(start, "a verbatim tag needs a URI") when suffix == ""
			} else {
				let first = try scanTagHandle(false, start)
				if first.len() > 1 && first.endsWith("!") {
					handle = first
					suffix = try scanTagURI(false)
				} else {
					suffix = try scanTagURI(false)
					handle = "!"
					suffix = first[1:] + suffix
					if suffix == "" {
						handle = ""
						suffix = "!"
					}
				}
			}
			fail yamlError(mark(), "a tag must be followed by a space or a line break") unless isBlankzAt(0) || (flowLevel > 0 && at(0) == ',')
			push(YAMLToken{kind: YAMLTokenKind.Tag, line: start.line, column: start.column, value: handle, suffix: suffix})
			return none
		}

		// `!`, `!!` or `!name!` (when `directive`, the handle must be
		// complete), or `!` and the word that follows it.
		def scanTagHandle(directive bool, start YAMLMark) !string {
			fail yamlError(start, "a tag handle starts with \"!\"") unless at(0) == '!'
			let out byte[] = []
			copy(out)
			for isWordAt(0) {
				copy(out)
			}
			if at(0) == '!' {
				copy(out)
			} else if directive && out.len() > 1 {
				fail yamlError(start, "a tag handle ends with \"!\"")
			}
			return string(out)
		}

		def isWordAt(k int) bool {
			let c = at(k)
			return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-'
		}

		// The characters of a tag's URI with %-escapes decoded. In a shorthand
		// suffix `!` and the flow indicators are not allowed.
		def scanTagURI(verbatim bool) !string {
			let out byte[] = []
			for {
				let c = at(0)
				if c == '%' {
					let hex = string([src[pos + 1 < src.len() ?? (pos + 1, pos)], src[pos + 2 < src.len() ?? (pos + 2, pos)]])
					fail yamlError(mark(), "\"%\" in a tag starts a %-escape of two hex digits") unless pos + 2 < src.len() && /^[0-9A-Fa-f]{2}$/.test(hex)
					out.push(byte(parseInt<int>(hex, 16)))
					skip()
					skip()
					skip()
					continue
				}
				let uriChar = isWordAt(0) || (c := '#' || ';' || '/' || '?' || ':' || '@' || '&' || '=' || '+' || '$' || '_' || '.' || '~' || '*' || '\'' || '(' || ')')
				let extra = verbatim ?? (c := ',' || '[' || ']' || '!', false)
				break unless uriChar || extra
				copy(out)
			}
			return string(out)
		}

		def fetchDirective() !none {
			unrollIndent(-1)
			try removeSimpleKey()
			simpleKeyAllowed = false
			let start = mark()
			skip()
			let name byte[] = []
			for !isBlankzAt(0) {
				copy(name)
			}
			let directive = string(name)
			fail yamlError(start, "a directive needs a name") when directive == ""
			if directive == "YAML" {
				try skipBlanks(true, start)
				let major = try scanVersionNumber(start)
				fail yamlError(mark(), "a %YAML version is two numbers separated by \".\"") unless at(0) == '.'
				skip()
				let minor = try scanVersionNumber(start)
				push(YAMLToken{kind: YAMLTokenKind.VersionDirective, line: start.line, column: start.column, major: major, minor: minor})
			} else if directive == "TAG" {
				try skipBlanks(true, start)
				let handle = try scanTagHandle(true, start)
				try skipBlanks(true, start)
				let prefix = try scanTagURI(true)
				fail yamlError(start, "a %TAG directive needs a prefix") when prefix == ""
				fail yamlError(start, "a %TAG prefix starts with \"!\" or a URI character") when prefix.startsWith(",") || prefix.startsWith("[") || prefix.startsWith("]")
				push(YAMLToken{kind: YAMLTokenKind.TagDirective, line: start.line, column: start.column, value: handle, suffix: prefix})
			} else {
				// A reserved directive is ignored (YAML 1.2.2 §6.8).
				for !done() && !isBreakAt(0) && !(at(0) == '#' && isBlankAt(-1)) {
					skip()
				}
			}
			try skipBlanks(false, start)
			if at(0) == '#' {
				fail yamlError(mark(), "a comment must be separated from the directive by a space") unless isBlankAt(-1)
				for !done() && !isBreakAt(0) {
					skip()
				}
			}
			fail yamlError(mark(), "a directive ends its line") unless done() || isBreakAt(0)
			return none
		}

		def skipBlanks(required bool, start YAMLMark) !none {
			fail yamlError(start, "a directive's parts are separated by spaces") when required && !isBlankAt(0)
			for isBlankAt(0) {
				skip()
			}
			return none
		}

		def scanVersionNumber(start YAMLMark) !int {
			let value = 0
			let digits = 0
			for at(0) >= '0' && at(0) <= '9' {
				value = value * 10 + (int(at(0)) - 48)
				digits++
				fail yamlError(start, "a %YAML version number is too long") when digits > 9
				skip()
			}
			fail yamlError(start, "a %YAML version is two numbers separated by \".\"") when digits == 0
			return value
		}

		def fetchBlockScalar(literal bool) !none {
			try removeSimpleKey()
			simpleKeyAllowed = true
			let start = mark()
			skip()
			// Chomping: -1 strip, 0 clip, 1 keep. increment: an explicit
			// indentation indicator.
			let chomping = 0
			let increment = 0
			for let round = 0; round < 2; round++ {
				let c = at(0)
				if (c == '+' || c == '-') && chomping == 0 {
					chomping = c == '+' ?? (1, -1)
					skip()
				} else if c >= '1' && c <= '9' && increment == 0 {
					increment = int(c) - 48
					skip()
				} else if c == '0' {
					fail yamlError(mark(), "a block scalar's indentation indicator is 1 to 9")
				}
			}
			let afterHeader = pos
			for isBlankAt(0) {
				skip()
			}
			if at(0) == '#' {
				fail yamlError(mark(), "a comment must be separated from the block scalar header by a space") when pos == afterHeader
				for !done() && !isBreakAt(0) {
					skip()
				}
			}
			fail yamlError(mark(), "a block scalar header ends its line") unless done() || isBreakAt(0)
			skipBreak() unless done()
			let parentIndent = indent
			let blockIndent = increment > 0 ?? (parentIndent >= 0 ?? (parentIndent + increment, increment), 0)
			let out byte[] = []
			let leadingBreak byte[] = []
			let trailingBreaks byte[] = []
			blockIndent = try scanBlockScalarBreaks(blockIndent, parentIndent, trailingBreaks, start)
			let leadingBlank = false
			let trailingBlank = false
			for column == blockIndent && !done() && !isDocumentMarker('-') && !isDocumentMarker('.') {
				trailingBlank = isBlankAt(0)
				if !literal && leadingBreak.len() > 0 && leadingBreak[0] == byte(10) && !leadingBlank && !trailingBlank {
					out.push(byte(32)) when trailingBreaks.len() == 0
				} else {
					out += leadingBreak
				}
				leadingBreak = []
				out += trailingBreaks
				trailingBreaks = []
				leadingBlank = isBlankAt(0)
				let lineFrom = pos
				skipToLineEnd()
				out += src[lineFrom:pos]
				if done() {
					// The end of the input ends the last line.
					leadingBreak = [byte(10)]
					break
				}
				readBreak(leadingBreak)
				blockIndent = try scanBlockScalarBreaks(blockIndent, parentIndent, trailingBreaks, start)
			}
			out += leadingBreak when chomping != -1
			out += trailingBreaks when chomping == 1
			push(YAMLToken{kind: YAMLTokenKind.Scalar, line: start.line, column: start.column, value: string(out), style: literal ?? (YAMLScalarStyle.Literal, YAMLScalarStyle.Folded)})
			return none
		}

		// Reads the empty lines of a block scalar into breaks and returns the
		// content indentation, found from the first non-empty line when not
		// given (0).
		def scanBlockScalarBreaks(given int, parentIndent int, breaks byte[], start YAMLMark) !int {
			let blockIndent = given
			// The most spaces on an empty line, and on any line.
			let maxEmpty = 0
			let maxIndent = 0
			for {
				let lineStart = column
				for (blockIndent == 0 || column < blockIndent) && at(0) == ' ' {
					skip()
				}
				maxIndent = column when column > maxIndent
				// A tab cannot indent: past the parent's indentation, before the
				// content's is known, it is the first content character.
				if (blockIndent == 0 || column < blockIndent) && at(0) == '\t' {
					break when blockIndent == 0 && column > parentIndent
					fail yamlError(mark(), "a tab cannot be used for indentation")
				}
				// A last line of spaces without a line break counts as one.
				if done() && lineStart == 0 && column > 0 {
					breaks.push(byte(10))
					break
				}
				break unless isBreakAt(0)
				maxEmpty = column when column > maxEmpty
				readBreak(breaks)
			}
			if blockIndent == 0 {
				// A leading empty line with more spaces than the first content
				// line is an error (YAML 1.2.2 §8.1.1.1).
				fail yamlError(start, "a leading empty line of a block scalar has more spaces than its first line") when !done() && column > parentIndent && maxEmpty > column
				blockIndent = maxIndent
				blockIndent = parentIndent + 1 when blockIndent < parentIndent + 1
				blockIndent = 1 when blockIndent < 1 && parentIndent >= 0
			}
			return blockIndent
		}

		def fetchFlowScalar(single bool) !none {
			try saveSimpleKey()
			simpleKeyAllowed = false
			let start = mark()
			let quote = at(0)
			skip()
			// Most quoted scalars hold no escape and no line break: their
			// value is the text between the quotes.
			let length = src.len()
			let closing = byte(single ?? (39, 34))
			let k = pos
			for k < length && src[k] != closing && (single || src[k] != byte(92)) && src[k] != byte(10) && src[k] != byte(13) {
				k++
			}
			// A single quote doubled is an escaped one: left to the full scan.
			if k < length && src[k] == closing && (!single || k + 1 >= length || src[k + 1] != closing) {
				let from = pos
				column += utf8Count(src, pos, k)
				pos = k
				skip()
				adjacentEnd = pos
				push(YAMLToken{kind: YAMLTokenKind.Scalar, line: start.line, column: start.column, value: string(src[from:k]), style: single ?? (YAMLScalarStyle.SingleQuoted, YAMLScalarStyle.DoubleQuoted)})
				return none
			}
			let out byte[] = []
			let whitespaces byte[] = []
			let leadingBreak byte[] = []
			let trailingBreaks byte[] = []
			for {
				fail yamlError(mark(), "a document marker cannot be inside a quoted scalar") when isDocumentMarker('-') || isDocumentMarker('.')
				fail yamlError(start, "this quoted scalar is not closed") when done()
				let leadingBlanks = false
				for !isBlankzAt(0) {
					let c = at(0)
					if single && c == '\'' && at(1) == '\'' {
						out.push(byte(39))
						skip()
						skip()
					} else if c == quote {
						break
					} else if !single && c == '\\' && isBreakAt(1) {
						skip()
						skipBreak()
						leadingBlanks = true
						break
					} else if !single && c == '\\' {
						try scanEscape(out)
					} else {
						// A run of ordinary characters, appended at once.
						let run = pos
						let n = src.len()
						let stop = single ?? (39, 34)
						for pos < n {
							let b = int(src[pos])
							break when b == 32 || b == 9 || b == 10 || b == 13 || b == stop || (b == 92 && !single)
							column++ when (b & 0xC0) != 0x80
							pos++
						}
						out += src[run:pos]
					}
				}
				break when at(0) == quote
				for isBlankAt(0) || isBreakAt(0) {
					if isBlankAt(0) {
						whitespaces.push(src[pos]) unless leadingBlanks
						skip()
					} else {
						if !leadingBlanks {
							whitespaces = []
							readBreak(leadingBreak)
							leadingBlanks = true
						} else {
							readBreak(trailingBreaks)
						}
						// A continuation line in block context is indented
						// deeper than the enclosing block.
						try checkContinuationIndent()
					}
				}
				if leadingBlanks {
					if leadingBreak.len() > 0 && leadingBreak[0] == byte(10) {
						if trailingBreaks.len() == 0 {
							out.push(byte(32))
						} else {
							out += trailingBreaks
						}
					} else {
						out += leadingBreak
						out += trailingBreaks
					}
					leadingBreak = []
					trailingBreaks = []
				} else {
					out += whitespaces
					whitespaces = []
				}
			}
			skip()
			adjacentEnd = pos
			push(YAMLToken{kind: YAMLTokenKind.Scalar, line: start.line, column: start.column, value: string(out), style: single ?? (YAMLScalarStyle.SingleQuoted, YAMLScalarStyle.DoubleQuoted)})
			return none
		}

		// After a line break in a multi-line flow scalar: the next line's
		// content must be indented deeper than the block it is in.
		def checkContinuationIndent() !none {
			let k = 0
			for at(k) == ' ' {
				k++
			}
			return none when isBreakAt(k) || pos + k >= src.len()
			fail yamlError(mark(), "a continuation line must be indented deeper than its block") when k <= indent
			return none
		}

		// One escape of a double-quoted scalar (YAML 1.2.2 §5.7).
		def scanEscape(out byte[]) !none {
			let start = mark()
			skip()
			let c = at(0)
			let simple = ""
			let width = 0
			switch c {
				case '0':
					simple = ""
				case 'a':
					simple = "\u0007"
				case 'b':
					simple = "\u0008"
				case 't', '\t':
					simple = "\t"
				case 'n':
					simple = "\n"
				case 'v':
					simple = "\u000B"
				case 'f':
					simple = "\u000C"
				case 'r':
					simple = "\r"
				case 'e':
					simple = "\u001B"
				case ' ':
					simple = " "
				case '"':
					simple = "\""
				case '/':
					simple = "/"
				case '\\':
					simple = "\\"
				case 'N':
					simple = "\u0085"
				case '_':
					simple = "\u00A0"
				case 'L':
					simple = "\u2028"
				case 'P':
					simple = "\u2029"
				case 'x':
					width = 2
				case 'u':
					width = 4
				case 'U':
					width = 8
				default:
					fail yamlError(start, "\"\\{string(c)}\" is not an escape")
			}
			skip()
			if width == 0 {
				if c == '0' {
					out.push(byte(0))
				} else {
					for let b in simple.bytes() {
						out.push(b)
					}
				}
				return none
			}
			let value = 0
			for let i = 0; i < width; i++ {
				let d = at(0)
				let digit = d >= '0' && d <= '9' ?? (int(d) - 48, d >= 'a' && d <= 'f' ?? (int(d) - 87, d >= 'A' && d <= 'F' ?? (int(d) - 55, -1)))
				fail yamlError(start, "\"\\{string(c)}\" takes {width} hex digits") when digit < 0
				value = value * 16 + digit
				skip()
			}
			fail yamlError(start, "\"\\{string(c)}\" names U+{"%X".format(value)}, which is not a character") when (value >= 0xD800 && value <= 0xDFFF) || value > 0x10FFFF
			if value == 0 {
				out.push(byte(0))
			} else {
				for let b in string(char(value)).bytes() {
					out.push(b)
				}
			}
			return none
		}

		def fetchPlainScalar() !none {
			try saveSimpleKey()
			simpleKeyAllowed = false
			let startLine = line
			let startColumn = column
			let n = src.len()
			let flow = flowLevel > 0
			let minIndent = indent + 1
			// The value is the first run of the input until a later run joins
			// it, which needs `out`. Between runs: the blanks on the run's
			// line [blankFrom, blankTo), and how many line breaks follow.
			let firstFrom = -1
			let firstTo = -1
			let joined = false
			let out byte[]
			let blankFrom = 0
			let blankTo = 0
			let breaks = 0
			for {
				break when isDocumentMarker('-') || isDocumentMarker('.')
				break when pos < n && src[pos] == byte(35)
				let run = -1
				for pos < n {
					let b = int(src[pos])
					break when b := 32 || 9 || 10 || 13
					if b == 58 {
						let after = pos + 1 < n ?? (int(src[pos + 1]), 32)
						break when after == 32 || after == 9 || after == 10 || after == 13 || (flow && yamlFlowIndicator(after))
					}
					break when flow && yamlFlowIndicator(b)
					run = pos when run < 0
					pos++
					column++ when (b & 0xC0) != 0x80
				}
				if run >= 0 {
					if firstFrom < 0 {
						firstFrom = run
						firstTo = pos
					} else {
						if !joined {
							out = []
							out += src[firstFrom:firstTo]
							joined = true
						}
						// Folding: one line break is a space, more are all but
						// one of them; blanks on one line stay.
						if breaks == 0 {
							out += src[blankFrom:blankTo]
						} else if breaks == 1 {
							out.push(byte(32))
						} else {
							for let i = 1; i < breaks; i++ {
								out.push(byte(10))
							}
						}
						out += src[run:pos]
					}
					breaks = 0
				}
				break unless pos < n && (src[pos] == byte(32) || src[pos] == byte(9) || src[pos] == byte(10) || src[pos] == byte(13))
				blankFrom = pos
				blankTo = pos
				for pos < n {
					let b = int(src[pos])
					if b := 32 || 9 {
						fail yamlError(mark(), "a tab cannot be used for indentation") when breaks > 0 && b == 9 && column < minIndent && !flow && !tabOnlyLine()
						pos++
						column++
						blankTo = pos when breaks == 0
					} else if b == 10 || b == 13 {
						skipBreak()
						breaks++
					} else {
						break
					}
				}
				break when !flow && column < minIndent
				fail yamlError(mark(), "a line of a flow collection must be indented deeper than its block") when flow && column <= indent && !done() && !isBreakAt(0)
			}
			simpleKeyAllowed = true when breaks > 0
			let value = joined ?? (string(out), firstFrom < 0 ?? ("", string(src[firstFrom:firstTo])))
			push(YAMLToken{kind: YAMLTokenKind.Scalar, line: startLine, column: startColumn, value: value})
			return none
		}
	}
}
