partial module std.data.encoding {
	use std.testing

	// The yaml-test-suite (data-2022-01-17, MIT, `testdata/yaml-test-suite.LICENSE`):
	// each case's input, its events, its JSON when it has one, and whether
	// it is an error.
	@embed("testdata/yaml-test-suite.json")
	internal const yamlSuite byte[]

	// What a suite case gives that it should not: "" when it agrees.
	internal def yamlSuiteMismatch(c map<string, any>) string {
		let input = c["yaml"]
		let expectError = c["error"]
		let events = c["events"]
		return "no input" unless (input is string)
		let got = yamlEvents(input.bytes(), 64) onerror (err error) {
			return "" when expectError is bool && expectError
			return "fails: {err.message}"
		}
		return "parses, but is an error" when expectError is bool && expectError
		let text = got.mapElem(e => yamlEventText(e)).join("\n") + "\n"
		return "events differ:\n{text}--- want\n{events}" when events is string && text != events
		let docs = c.hasKey("json") ?? (c["json"], none)
		if docs is any[] {
			let composer = new YAMLComposer()
			for let e in got {
				composer.add(e) onerror (err error) {
					return "composes: {err.message}"
				}
			}
			let nodes = composer.documents
			let values any[] = []
			for let n in nodes {
				values.push(yamlPlain(n) onerror (err error) {
					return "composes: {err.message}"
				})
			}
			let have = values.mapElem(v => yamlCanonical(v)).join("\n")
			let want = docs.mapElem(v => yamlCanonical(v)).join("\n")
			return "values differ: {have} want {want}" unless have == want
		}
		return ""
	}

	// A value as JSON text with its keys sorted, so key order does not
	// count; integral floats print as integers, as JSON does not tell them
	// apart.
	internal def yamlCanonical(value any) string {
		if value is map<string, any> {
			let entries string[] = []
			for let (k, v) in value {
				entries.push(string(new JSON().encode(k)) + ":" + yamlCanonical(v))
			}
			entries.sort((a string, b string) => a < b)
			return "\{" + entries.join(",") + "\}"
		}
		return "[" + value.mapElem(v => yamlCanonical(v)).join(",") + "]" when value is any[]
		return "{int(value)}" when value is float && value == float(int(value))
		return string(new JSON().encode(value))
	}

	check "YAML test suite" {
		// Every case of the yaml-test-suite: the same events, the same JSON,
		// and an error where the case is one.
		@test()
		def matchesTheSuite() !none {
			let parsed = try new JSON().parse(yamlSuite)
			let cases any[] = parsed is any[] ?? (parsed, [])
			assert cases.len() > 0
			let failures string[] = []
			for let c in cases {
				continue unless c is map<string, any>
				let problem = yamlSuiteMismatch(c)
				failures.push("{c["id"]} {c["name"]}: {problem}") unless problem == ""
			}
			for let f in failures {
				println(f)
			}
			println("yaml-test-suite: {cases.len() - failures.len()} of {cases.len()}")
			assert failures.len() == 0
			return none
		}
	}
}
