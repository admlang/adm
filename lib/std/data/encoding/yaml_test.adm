partial module std.data.encoding {
	use std.testing

	internal struct YCfg {
		@yaml("host_name")
		host string
		port int
		@yaml(omitempty: true)
		note string
		debug bool
	}

	internal struct YScalars {
		country string
		version string
		blank   string
		spaced  string
		hash    string
	}

	internal struct YNums {
		i int
		u uint
		f float
	}

	internal struct YAddress {
		@yaml("city_name")
		city string
		zip int
	}

	internal struct YNested {
		name string
		@yaml("home")
		addr YAddress
	}

	internal struct YDeep {
		inner YNested
	}

	// Declared with `type`, not `struct`, and carrying a method: what the codec
	// descends into is anything with fields, however it was declared.
	internal type YTypeAddress {
		city string

		def label() string {
			return city
		}
	}

	internal type YTypeHolder {
		addr YTypeAddress
		home YAddress
	}

	internal struct YSeqs {
		nums  int[]
		tags  string[]
		flags bool[]
	}

	// Narrow element types: an int16[] strides two bytes per element, not the
	// eight an int[] does.
	internal struct YNarrowSeqs {
		small int16[]
		bytes uint8[]
	}

	// Implements both YAML interfaces, so the codec must use them and never
	// look at the fields.
	internal type YSelfCoded {
		seen    string
		ignored int

		def yaml() byte[] {
			return "custom: true\n".bytes()
		}

		def yaml(data byte[]) !none {
			seen = string(data)
			return none
		}
	}

	internal struct YMaps {
		counts map<string, int>
		labels map<string, string>
	}

	internal struct YMapOfObjects {
		name   string
		places map<string, YAddress>
	}

	internal struct YMapOfArrays {
		groups map<string, string[]>
	}

	check "YAML encoding" {
		@test()
		def encodesMaps() {
			let y = new YAML()
			let v = YMaps{counts: map<string, int>{"a": 1, "b": 2}, labels: map<string, string>{"x": "yes"}}
			// Entries keep insertion order; a scalar that would read back as
			// another type is quoted, as it is for a field.
			assert string(y.encode(v)) == "counts:\n  a: 1\n  b: 2\nlabels:\n  x: \"yes\"\n"
		}

		@test()
		def encodesEmptyMapInFlowForm() {
			let y = new YAML()
			assert string(y.encode(YMaps{})) == "counts: {}\nlabels: {}\n"
		}

		@test()
		def decodesMaps() {
			let y = new YAML()
			let v = YMaps{counts: map<string, int>{"old": 9}}
			assert !(y.decode("counts:\n  a: 1\n  b: 2\n  c: ~\nlabels:\n  x: \"yes\"\n", v) is error)
			assert v.counts.len() == 2
			assert !v.counts.hasKey("old")
			assert v.counts["a"] == 1
			assert v.counts["b"] == 2
			assert v.labels["x"] == "yes"
		}

		@test()
		def decodesEmptyMap() {
			let y = new YAML()
			let v = YMaps{counts: map<string, int>{"old": 9}}
			assert !(y.decode("counts: {}\nlabels: {}\n", v) is error)
			assert v.counts.len() == 0
		}

		@test()
		def encodesMapOfObjects() {
			let y = new YAML()
			let v = YMapOfObjects{name: "trip", places: map<string, YAddress>{"home": YAddress{city: "Oslo", zip: 1234}}}
			assert string(y.encode(v)) == "name: trip\nplaces:\n  home:\n    city_name: Oslo\n    zip: 1234\n"
		}

		@test()
		def decodesMapOfObjects() {
			let y = new YAML()
			let v = YMapOfObjects{}
			assert !(y.decode("name: trip\nplaces:\n  home:\n    city_name: Oslo\n    zip: 1234\n  work:\n    zip: 5\n", v) is error)
			assert v.name == "trip"
			assert v.places.len() == 2
			assert v.places["home"].city == "Oslo"
			assert v.places["work"].zip == 5
		}

		@test()
		def decodesMapOfArrays() {
			let y = new YAML()
			let v = YMapOfArrays{}
			assert !(y.decode("groups:\n  admins: [ann, bo]\n  none: []\n", v) is error)
			assert v.groups.len() == 2 && v.groups["admins"].join("+") == "ann+bo" && v.groups["none"].len() == 0
		}

		@test()
		def refusesScalarForMapOfObjects() {
			let y = new YAML()
			let v = YMapOfObjects{}
			assert y.decode("places:\n  home: 3\n", v) is error
		}

		@test()
		def encodesBlockMapping() {
			let y = new YAML()
			let got = string(y.encode(YCfg{host: "h", port: 80, note: "n", debug: true}))
			// "n" is quoted: bare, YAML 1.1 reads it as false.
			assert got == "host_name: h\nport: 80\nnote: \"n\"\ndebug: true\n"
		}

		@test()
		def omitEmptyDropsZeroValues() {
			let y = new YAML()
			let got = string(y.encode(YCfg{host: "h", port: 0, note: "", debug: false}))
			assert !got.contains("note:")
			// Only `note` is annotated, so the other zero values stay.
			assert got.contains("port: 0")
			assert got.contains("debug: false")
		}

		@test()
		def quotesScalarsThatWouldChangeType() {
			// The country code NO reads back as false unless quoted.
			let y = new YAML()
			let got = string(y.encode(YScalars{country: "NO", version: "1.0", blank: "", spaced: " x ", hash: "a#b"}))
			assert got.contains("country: \"NO\"")
			assert got.contains("version: \"1.0\"")
			assert got.contains("blank: \"\"")
			assert got.contains("spaced: \" x \"")
			assert got.contains("hash: \"a#b\"")
		}

		@test()
		def leavesOrdinaryStringsBare() {
			let y = new YAML()
			let got = string(y.encode(YScalars{country: "Norway", version: "beta", blank: "x", spaced: "y", hash: "z"}))
			assert got.contains("country: Norway")
			assert !got.contains("\"Norway\"")
		}

		@test()
		def caseStyleRenamesUnannotatedFields() {
			let y = new YAML(caseStyle: CaseStyle.Snake)
			let got = string(y.encode(YCfg{host: "h", port: 80, note: "n", debug: true}))
			// The explicit name wins over the case style.
			assert got.contains("host_name: h")
			assert got.contains("port: 80")
		}

		@test()
		def decodesBlockMapping() {
			let y = new YAML()
			let c = YCfg{}
			assert !(y.decode("host_name: h\nport: 80\nnote: n\ndebug: true\n", c) is error)
			assert c.host == "h"
			assert c.port == 80
			assert c.note == "n"
			assert c.debug
		}

		@test()
		def decodeAcceptsYAMLBooleanSpellings() {
			let y = new YAML()
			let a = YCfg{}
			assert !(y.decode("debug: yes\n", a) is error)
			assert a.debug

			let b = YCfg{}
			assert !(y.decode("debug: on\n", b) is error)
			assert b.debug

			let c = YCfg{debug: true}
			assert !(y.decode("debug: no\n", c) is error)
			assert !c.debug
		}

		@test()
		def decodeIgnoresCommentsAndBlankLines() {
			let y = new YAML()
			let c = YCfg{}
			assert !(y.decode("# leading\n\nhost_name: h   # trailing\n\nport: 80\n", c) is error)
			assert c.host == "h"
			assert c.port == 80
		}

		@test()
		def decodeKeepsHashInsideQuotes() {
			let y = new YAML()
			let s = YScalars{}
			assert !(y.decode("hash: \"a#b\"\n", s) is error)
			assert s.hash == "a#b"
		}

		@test()
		def decodeSkipsUnknownKeys() {
			let y = new YAML()
			let c = YCfg{}
			assert !(y.decode("unknown: 1\nhost_name: h\nother: two\n", c) is error)
			assert c.host == "h"
		}

		@test()
		def decodeTreatsNullAndTildeAsAbsent() {
			let y = new YAML()
			let c = YCfg{host: "keep"}
			assert !(y.decode("host_name: null\n", c) is error)
			assert c.host == "keep"

			let d = YCfg{host: "keep"}
			assert !(y.decode("host_name: ~\n", d) is error)
			assert d.host == "keep"
		}

		@test()
		def decodeMatchesKeysCaseInsensitively() {
			let y = new YAML()
			let n = YNums{}
			assert !(y.decode("I: -1\nU: 2\nF: 1.5\n", n) is error)
			assert n.i == -1
			assert n.u == 2
		}

		@test()
		def decodesAllOfYAML() !none {
			let y = new YAML()
			let c = YCfg{}
			try y.decode("%YAML 1.2\n---\nhost_name: &h !!str \"h\\x41\"\nnote: >-\n  folded\n  text\nport: 0x50\n...\n", c)
			assert c.host == "hA" && c.note == "folded text" && c.port == 80
			let o = YMapOfObjects{}
			try y.decode("\{name: trip, places: \{home: &a \{city_name: Oslo\}, again: *a\}\}", o)
			assert o.places["again"].city == "Oslo"
			return none
		}

		@test()
		def refusesValuesOfTheWrongShape() {
			let y = new YAML()
			let c = YCfg{}
			assert y.decode("- one\n- two\n", c) is error
			// host_name is a string, not a sequence.
			assert y.decode("host_name: [1, 2]\n", c) is error
			assert y.decode("no_colon_here\n", c) is error
			assert y.decode("port: eighty\n", c) is error
			assert y.decode("debug: maybe\n", c) is error
			assert y.decode("host_name: *missing\n", c) is error
		}

		@test()
		def encoderInterfaceBypassesReflection() {
			let y = new YAML()
			let got = string(y.encode(YSelfCoded{ignored: 99}))
			assert got == "custom: true\n"
			// Had reflection run, the fields would appear.
			assert !got.contains("ignored")
			assert !got.contains("seen")
		}

		@test()
		def decoderInterfaceBypassesReflection() {
			let y = new YAML()
			let v = YSelfCoded{ignored: 7}
			// Not a valid block mapping: it reaches the interface, so the
			// parser never sees it.
			assert !(y.decode("!!! whatever", v) is error)
			assert v.seen == "!!! whatever"
			assert v.ignored == 7
		}

		@test()
		def encodesSequencesInFlowStyle() {
			let y = new YAML()
			let got = string(y.encode(YSeqs{nums: [1, 2], tags: ["x", "y"], flags: [true]}))
			// "y" is quoted: bare, YAML 1.1 reads it as true.
			assert got == "nums: [1, 2]\ntags: [x, \"y\"]\nflags: [true]\n"
		}

		@test()
		def encodesEmptySequences() {
			let y = new YAML()
			let got = string(y.encode(YSeqs{}))
			assert got == "nums: []\ntags: []\nflags: []\n"
		}

		@test()
		def decodesFlowSequences() {
			let y = new YAML()
			let v = YSeqs{}
			assert !(y.decode("nums: [1, 2, 3]\ntags: [\"x\", y]\nflags: [yes, no]\n", v) is error)
			assert v.nums.len() == 3 && v.nums[2] == 3
			assert v.tags.len() == 2 && v.tags[0] == "x" && v.tags[1] == "y"
			assert v.flags.len() == 2 && v.flags[0] && !v.flags[1]
		}

		// A typed array takes a top-level sequence: objects and scalars.
		@test()
		def decodesTopLevelSequence() {
			let y = new YAML()
			let places YAddress[]
			assert !(y.decode("- city_name: Oslo\n  zip: 1234\n- zip: 5\n", places) is error)
			assert places.len() == 2 && places[0].city == "Oslo" && places[0].zip == 1234 && places[1].zip == 5
			let words string[] = ["old"]
			assert !(y.decode("[x, y]\n", words) is error)
			assert words.len() == 2 && words[0] == "x" && words[1] == "y"
			// A mapping where a sequence goes fails; an empty document leaves the array alone.
			assert y.decode("zip: 1\n", places) is error
			assert !(y.decode("", words) is error)
			assert words.len() == 2
		}

		@test()
		def decodesEmptySequence() {
			let y = new YAML()
			let v = YSeqs{nums: [9, 9]}
			assert !(y.decode("nums: []\n", v) is error)
			assert v.nums.len() == 0
		}

		@test()
		def decodeKeepsCommasInsideQuotedItems() {
			let y = new YAML()
			let v = YSeqs{}
			assert !(y.decode("tags: [\"a,b\", c]\n", v) is error)
			assert v.tags.len() == 2
			assert v.tags[0] == "a,b"
			assert v.tags[1] == "c"
		}

		@test()
		def decodesSequencesOfNarrowElements() {
			let y = new YAML()
			let v = YNarrowSeqs{}
			assert !(y.decode("small: [-300, 300]\nbytes: [7, 255]\n", v) is error)
			// Values past the first catch a wrong element stride, which the
			// first element alone would hide.
			assert v.small[0] == int16(-300) && v.small[1] == int16(300)
			assert v.bytes[0] == uint8(7) && v.bytes[1] == uint8(255)
		}

		@test()
		def roundTripsSequences() {
			let y = new YAML()
			let src = YSeqs{nums: [4, 5], tags: ["a", "b"], flags: [false, true]}
			let dst = YSeqs{}
			assert !(y.decode(string(y.encode(src)), dst) is error)
			assert dst.nums.len() == 2 && dst.nums[1] == 5
			assert dst.tags.len() == 2 && dst.tags[1] == "b"
			assert dst.flags.len() == 2 && dst.flags[1]
		}

		@test()
		def encodesNestedMapping() {
			let y = new YAML()
			let got = string(y.encode(YNested{name: "ann", addr: YAddress{city: "Oslo", zip: 1234}}))
			// Annotations apply at every level, not only the outermost.
			assert got == "name: ann\nhome:\n  city_name: Oslo\n  zip: 1234\n"
		}

		@test()
		def decodesNestedMapping() {
			let y = new YAML()
			let v = YNested{}
			assert !(y.decode("name: ann\nhome:\n  city_name: Oslo\n  zip: 1234\n", v) is error)
			assert v.name == "ann"
			assert v.addr.city == "Oslo"
			assert v.addr.zip == 1234
		}

		@test()
		def decodeResumesTheOuterMappingAfterANestedOne() {
			// The block has to end where the indentation drops, or the key
			// after it is read as part of the nested mapping.
			let y = new YAML()
			let v = YNested{}
			assert !(y.decode("home:\n  zip: 9\nname: z\n", v) is error)
			assert v.addr.zip == 9
			assert v.name == "z"
		}

		@test()
		def decodeSkipsAnUnknownKeysBlock() {
			let y = new YAML()
			let v = YNested{}
			assert !(y.decode("unknown:\n  a: 1\n  b: 2\nname: kept\n", v) is error)
			assert v.name == "kept"
		}

		@test()
		def roundTripsTwoLevelsOfNesting() {
			let y = new YAML()
			let src = YDeep{inner: YNested{name: "n", addr: YAddress{city: "Rome", zip: 7}}}
			let dst = YDeep{}
			assert !(y.decode(string(y.encode(src)), dst) is error)
			assert dst.inner.name == "n"
			assert dst.inner.addr.city == "Rome"
			assert dst.inner.addr.zip == 7
		}

		@test()
		def decodeRefusesMisalignedIndentation() {
			let y = new YAML()
			assert y.decode("name: a\n  oops: 1\n", YNested{}) is error
		}

		@test()
		def decodeReadsAKeyWithNothingAsNull() !none {
			let y = new YAML()
			let v = YNested{}
			try y.decode("home:\nname: a\n", v)
			assert v.name == "a" && v.addr.zip == 0
			return none
		}

		@test()
		def decodeRefusesAMappingInAScalarField() {
			let y = new YAML()
			assert y.decode("name:\n  x: 1\n", YNested{}) is error
		}

		@test()
		def decodeRefusesInputNestedDeeperThanMaxDepth() {
			let y = new YAML(maxDepth: 2)
			assert y.decode("inner:\n  home:\n    zip: 1\n", YDeep{}) is error
		}

		@test()
		def decodeRefusesTabIndentation() {
			let y = new YAML()
			assert y.decode("home:\n\tzip: 1\n", YNested{}) is error
		}

		@test()
		def descendsIntoFieldsDeclaredWithType() {
			let y = new YAML()
			let src = YTypeHolder{addr: YTypeAddress{city: "Oslo"}, home: YAddress{city: "Rome", zip: 7}}
			assert string(y.encode(src)) == "addr:\n  city: Oslo\nhome:\n  city_name: Rome\n  zip: 7\n"

			let dst = YTypeHolder{}
			assert !(y.decode(string(y.encode(src)), dst) is error)
			assert dst.addr.city == "Oslo"
			assert dst.home.city == "Rome"
			assert dst.home.zip == 7
			// The decoded value is a working instance, not a bag of fields.
			assert dst.addr.label() == "Oslo"
		}

		@test()
		def roundTripsThroughEncodeAndDecode() !none {
			let y = new YAML()
			let src = YScalars{country: "NO", version: "1.0", blank: "", spaced: " x ", hash: "a#b"}
			let dst = YScalars{}
			assert !(y.decode(string(y.encode(src)), dst) is error)
			assert dst.country == "NO"
			assert dst.version == "1.0"
			assert dst.spaced == " x "
			assert dst.hash == "a#b"
			return none
		}
	}

	internal struct YTeam {
		name    string
		members YAddress[]
		extra   any
		limit   ?int
	}

	check "YAML documents" {
		// Plain scalars resolve by the core schema; quotes and tags decide
		// otherwise.
		@test()
		def parsesByTheCoreSchema() !none {
			let doc = try new YAML().parse("a: 1\nb: 1.5\nc: true\nd: ~\ne: 0o17\nf: -.inf\ng: '1'\nh: !!float 2\ni: yes\nj: 0x1F\n")
			assert doc is map<string, any>
			if doc is map<string, any> {
				assert doc["a"] is int && doc["b"] is float && doc["c"] is bool && doc["d"] is none
				let e = doc["e"]
				assert e is int && e == 15
				let j = doc["j"]
				assert j is int && j == 31
				let f = doc["f"]
				assert f is float && f < 0.0 && f * 0.0 != 0.0
				assert doc["g"] is string && doc["h"] is float && doc["i"] is string
			}
			return none
		}

		// An alias is the anchored collection itself; every document of a
		// stream is read by parseAll; an empty stream is none.
		@test()
		def readsAliasesAndDocuments() !none {
			let y = new YAML()
			let doc = try y.parse("base: &b [1, 2]\ncopy: *b\n")
			if doc is map<string, any> {
				let base = doc["base"]
				let copy = doc["copy"]
				assert base is any[] && copy is any[]
				if base is any[] && copy is any[] {
					base.push(3)
					assert copy.len() == 3
				}
			}
			let docs = try y.parseAll("--- 1\n--- two\n...\n--- [3]\n")
			assert docs.len() == 3 && docs[1] is string
			assert (try y.parse("# only a comment\n")) is none
			assert y.parse("a: &x [*x]\n") is error
			assert y.parse("a: 1\na: 2\n") is error
			return none
		}

		// Errors say where: line and column from 1.
		@test()
		def reportsWhereItFails() {
			let y = new YAML()
			let line = 0
			let column = 0
			y.parse("a: 1\nb: [2, 3\n") onerror (err error) {
				if err is YAMLError {
					line = err.line
					column = err.column
				}
				recover none
			}
			assert line == 3 && column == 1
			assert y.parse("a:\n\t- 1\n") is error
			assert y.parse("a: \"open\n") is error
		}

		// Plain trees encode in block style, scalar lists in flow style,
		// strings with line breaks as literal block scalars, and read back
		// equal.
		@test()
		def encodesPlainTrees() !none {
			let y = new YAML()
			let doc = map<string, any>{
				"openapi": "3.2.0",
				"info":    map<string, any>{"title": "Pets", "description": "Line one\nLine two\n"},
				"tags":    [map<string, any>{"name": "a", "x-order": 1}, map<string, any>{"name": "b"}],
				"list":    [1, "two", none, true, 2.5],
				"empty":   map<string, any>{},
				"nested":  [[1, 2], [map<string, any>{"k": "v"}]],
			}
			let text = string(y.encode(doc))
			assert text.contains("openapi: \"3.2.0\"\n")
			assert text.contains("  description: |\n    Line one\n    Line two\n")
			assert text.contains("tags:\n  - name: a\n    x-order: 1\n  - name: b\n")
			assert text.contains("list: [1, two, null, true, 2.5]\n")
			assert text.contains("empty: \{\}\n")
			let back = try y.parse(text)
			assert yamlCanonical(back) == yamlCanonical(doc)
			return none
		}

		// Sequences of objects, `any` fields and optionals decode and
		// encode.
		@test()
		def bindsSequencesOfObjects() !none {
			let y = new YAML()
			let team = YTeam{}
			try y.decode("name: t\nmembers:\n  - city_name: Oslo\n    zip: 1\n  - \{city_name: Rome\}\nextra: \{a: [1]\}\nlimit: 5\n", team)
			assert team.members.len() == 2 && team.members[1].city == "Rome"
			let extra = team.extra
			assert extra is map<string, any>
			let limit = team.limit
			assert !(limit is none) && limit == 5
			let text = string(y.encode(team))
			assert text.contains("members:\n  - city_name: Oslo\n    zip: 1\n  - city_name: Rome\n")
			let again = YTeam{}
			try y.decode(text, again)
			let againLimit = again.limit
			assert again.members.len() == 2 && again.members[0].zip == 1 && !(againLimit is none) && againLimit == 5
			return none
		}
	}
}
