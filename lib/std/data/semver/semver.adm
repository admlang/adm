partial module std.data.semver {
	// A semantic version as defined by semver.org 2.0.0: `major.minor.patch`,
	// optional dot-separated prerelease identifiers after `-` and optional build
	// metadata after `+`.
	//
	//     1.2.3-rc.2+linux.x86_64
	//     major      1
	//     minor      2
	//     patch      3
	//     prerelease ["rc", "2"]
	//     build      ["linux", "x86_64"]
	//
	// Instances come from `parse`. Comparison follows semver precedence: the
	// numeric parts, then the prerelease identifiers (a version without a
	// prerelease ranks above one with), and build metadata never counts.
	type Semver {
		// The text the version was parsed from, trimmed; set by `parse` and
		// meant to be read only. `canonical()` gives the normalised form.
		version string

		internal majorPart      uint
		internal minorPart      uint
		internal patchPart      uint
		internal prereleasePart string[]
		internal buildPart      string[]

		// The major version; incremented for incompatible API changes.
		major uint {
			def get() uint {
				return majorPart
			}
		}

		// The minor version; incremented for backwards-compatible additions.
		minor uint {
			def get() uint {
				return minorPart
			}
		}

		// The patch version; incremented for backwards-compatible fixes.
		patch uint {
			def get() uint {
				return patchPart
			}
		}

		// The prerelease identifiers, `["rc", "2"]` for `1.2.3-rc.2`; empty for
		// a release version.
		prerelease string[] {
			def get() string[] {
				return prereleasePart
			}
		}

		// The build metadata identifiers, `["linux", "x86_64"]` for
		// `1.2.3+linux.x86_64`; empty when there is none. Build metadata is
		// ignored by every comparison.
		build string[] {
			def get() string[] {
				return buildPart
			}
		}

		// Reports whether this version is in `range`.
		//
		// A range is one or more comparator sets separated by `||`; the version
		// satisfies the range when it satisfies every comparator of at least one
		// set. A set is whitespace-separated comparators:
		//
		//     1.2.3            exactly that version
		//     >=1.2.3 <2.0.0   an operator (`<`, `<=`, `>`, `>=`, `=`) and a
		//                      version; a space after the operator is allowed
		//     ~1.2.3           >=1.2.3 <1.3.0 (patch-level changes)
		//     ^1.2.3           >=1.2.3 <2.0.0 (no change to the leftmost
		//                      non-zero part, so ^0.2.3 is <0.3.0)
		//     1.2.x 1.2.* 1.2  >=1.2.0 <1.3.0; 1 and 1.x mean >=1.0.0 <2.0.0
		//     1.2.3 - 2.3.4    >=1.2.3 <=2.3.4
		//     *                any version
		//
		// A prerelease version only satisfies a set when one of its comparators
		// names the same major.minor.patch with a prerelease, so `>=1.0.0` does
		// not admit `2.0.0-beta` but `>=2.0.0-alpha` does. A range that cannot
		// be parsed is satisfied by nothing.
		def satisfies(range string) bool {
			let sets = parseRange(range) onerror recover ComparatorSet[]
			return false when sets.len() == 0
			for let set in sets {
				return true when set.matches(self)
			}
			return false
		}

		// Reports whether both versions have the same precedence; build
		// metadata is ignored, so `1.2.3+a == 1.2.3+b`.
		infix def == (other Semver) bool {
			return compare(self, other) == 0
		}

		// Reports whether this version has the same precedence as `other`;
		// false when `other` does not parse.
		infix def == (other string) bool {
			let parsed = parse(other)
			return false when parsed is error
			return compare(self, parsed) == 0
		}

		// Reports whether this version precedes `other`.
		infix def < (other Semver) bool {
			let order = compare(self, other)
			return 0 > order
		}

		// Reports whether this version precedes `other`; false when `other`
		// does not parse.
		infix def < (other string) bool {
			let parsed = parse(other)
			return false when parsed is error
			let order = compare(self, parsed)
			return 0 > order
		}

		// Reports whether this version follows `other`.
		infix def > (other Semver) bool {
			return compare(self, other) > 0
		}

		// Reports whether this version follows `other`; false when `other` does
		// not parse.
		infix def > (other string) bool {
			let parsed = parse(other)
			return false when parsed is error
			return compare(self, parsed) > 0
		}

		// Reports whether this version follows or equals `other`.
		infix def >= (other Semver) bool {
			return compare(self, other) >= 0
		}

		// Reports whether this version follows or equals `other`; false when
		// `other` does not parse.
		infix def >= (other string) bool {
			let parsed = parse(other)
			return false when parsed is error
			return compare(self, parsed) >= 0
		}

		// Reports whether this version precedes or equals `other`.
		infix def <= (other Semver) bool {
			let order = compare(self, other)
			return order <= 0
		}

		// Reports whether this version precedes or equals `other`; false when
		// `other` does not parse.
		infix def <= (other string) bool {
			let parsed = parse(other)
			return false when parsed is error
			let order = compare(self, parsed)
			return order <= 0
		}

		// Returns the text the version was parsed from, so `v2.1` stays `v2.1`.
		def str() string {
			return version
		}

		// Returns the normalised form `major.minor.patch[-prerelease][+build]`,
		// so `v2.1` becomes `2.1.0`.
		def canonical() string {
			let text = "{majorPart}.{minorPart}.{patchPart}"
			text += "-" + prereleasePart.join(".") when prereleasePart.len() > 0
			text += "+" + buildPart.join(".") when buildPart.len() > 0
			return text
		}
	}

	// Parses a version such as `2`, `2.0`, `2.1.0`, `v2.1.0` or
	// `2.1.0-beta.1+build.5`. Surrounding whitespace and a leading `v` or `V`
	// are accepted; a missing minor or patch part reads as 0.
	//
	// Fails when a numeric part is empty, non-numeric or has a leading zero,
	// when there are more than three numeric parts, or when a prerelease or
	// build identifier is empty or contains a character other than
	// `0-9A-Za-z-_` (a numeric prerelease identifier may not have a leading
	// zero either). `_` goes beyond semver.org, which allows only `-`, so that
	// tags such as `x86_64` pass.
	def parse(version string) !Semver {
		let text = version.trim()
		let core = text
		core = core.slice(1) when core.startsWith("v") || core.startsWith("V")

		let build = string[]
		let plus = core.indexOf("+")
		if plus >= 0 {
			build = try parseIdentifiers(core.slice(plus + 1), false)
			core = core.slice(0, plus)
		}

		let prerelease = string[]
		let dash = core.indexOf("-")
		if dash >= 0 {
			prerelease = try parseIdentifiers(core.slice(dash + 1), true)
			core = core.slice(0, dash)
		}

		let numbers = try parseNumbers(core)
		return Semver{
			version:        text,
			majorPart:      numbers[0],
			minorPart:      numbers[1],
			patchPart:      numbers[2],
			prereleasePart: prerelease,
			buildPart:      build,
		}
	}

	// Returns the major part of `version`, or 0 when it does not parse.
	def major(version string) uint {
		let parsed = parse(version)
		return 0 when parsed is error
		return parsed.major
	}

	// Returns the minor part of `version`, or 0 when it does not parse.
	def minor(version string) uint {
		let parsed = parse(version)
		return 0 when parsed is error
		return parsed.minor
	}

	// Returns the patch part of `version`, or 0 when it does not parse.
	def patch(version string) uint {
		let parsed = parse(version)
		return 0 when parsed is error
		return parsed.patch
	}

	// Returns the prerelease identifiers of `version`, empty when there are
	// none or the version does not parse.
	def prerelease(version string) string[] {
		let parsed = parse(version)
		return string[] when parsed is error
		return parsed.prerelease
	}

	// Returns the build metadata identifiers of `version`, empty when there
	// are none or the version does not parse.
	def build(version string) string[] {
		let parsed = parse(version)
		return string[] when parsed is error
		return parsed.build
	}

	// Compares two versions by precedence: -1 when `a` precedes `b`, 0 when
	// they rank the same, 1 when `a` follows `b`. Build metadata is ignored.
	def compare(a Semver, b Semver) int {
		return -1 when a.major < b.major
		return 1 when a.major > b.major
		return -1 when a.minor < b.minor
		return 1 when a.minor > b.minor
		return -1 when a.patch < b.patch
		return 1 when a.patch > b.patch
		return comparePrerelease(a.prerelease, b.prerelease)
	}

	// Orders prerelease identifier lists: a release (no identifiers) follows
	// any prerelease; numeric identifiers precede alphanumeric ones and compare
	// numerically; alphanumeric ones compare as ASCII; a shorter list that is
	// a prefix of the other precedes it.
	internal def comparePrerelease(a string[], b string[]) int {
		return 0 when a.len() == 0 && b.len() == 0
		return 1 when a.len() == 0
		return -1 when b.len() == 0
		let count = a.len()
		count = b.len() when b.len() < count
		for let i in 0..count {
			let left = a[i]
			let right = b[i]
			continue when left == right
			let leftNumeric = isDigits(left)
			let rightNumeric = isDigits(right)
			if leftNumeric && rightNumeric {
				let l = left.toInt<uint64>()
				let r = right.toInt<uint64>()
				return -1 when l < r
				return 1 when l > r
				continue
			}
			return -1 when leftNumeric
			return 1 when rightNumeric
			let order = left.compare(right)
			return -1 when order < 0
			return 1 when order > 0
		}
		return -1 when a.len() < b.len()
		return 1 when a.len() > b.len()
		return 0
	}

	// Parses the numeric `major[.minor[.patch]]` core into three parts, missing
	// parts reading as 0.
	internal def parseNumbers(core string) !uint[] {
		fail "semver: empty version" when core.len() == 0
		let parts = core.split(".")
		fail "semver: too many numeric parts in \"{core}\"" when parts.len() > 3
		let numbers = uint[0, 0, 0]
		for let (i, part) in parts {
			fail "semver: empty numeric part in \"{core}\"" when part.len() == 0
			fail "semver: non-numeric part \"{part}\"" unless isDigits(part)
			fail "semver: leading zero in \"{part}\"" when part.len() > 1 && part.startsWith("0")
			numbers[i] = part.toInt<uint>()
		}
		return numbers
	}

	// Splits dot-separated prerelease or build identifiers, checking that each
	// is non-empty and made of `0-9A-Za-z-_`; for a prerelease, a numeric
	// identifier may not have a leading zero.
	internal def parseIdentifiers(text string, isPrerelease bool) !string[] {
		let kind = "build"
		kind = "prerelease" when isPrerelease
		fail "semver: empty {kind} identifiers" when text.len() == 0
		let identifiers = text.split(".")
		for let identifier in identifiers {
			fail "semver: empty {kind} identifier in \"{text}\"" when identifier.len() == 0
			fail "semver: invalid {kind} identifier \"{identifier}\"" unless isIdentifier(identifier)
			if isPrerelease && identifier.len() > 1 && identifier.startsWith("0") && isDigits(identifier) {
				fail "semver: leading zero in prerelease identifier \"{identifier}\""
			}
		}
		return identifiers
	}

	// Reports whether `text` is non-empty and made only of ASCII digits.
	internal def isDigits(text string) bool {
		return false when text.len() == 0
		for let ch in text {
			return false unless ch >= '0' && ch <= '9'
		}
		return true
	}

	// Reports whether `text` is made only of `0-9A-Za-z-_`.
	internal def isIdentifier(text string) bool {
		for let ch in text {
			let ok = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '-' || ch == '_'
			return false unless ok
		}
		return true
	}

	// One `operator version` clause of a range. `op` is `<`, `<=`, `>`, `>=`
	// or `=`.
	internal struct Comparator {
		op      string
		version Semver
	}

	// The comparators of one `||` branch of a range; all must hold.
	internal type ComparatorSet {
		comparators Comparator[]

		def matches(candidate Semver) bool {
			return false when comparators.len() == 0
			for let comparator in comparators {
				let order = compare(candidate, comparator.version)
				let ok = order == 0
				if comparator.op == "<" {
					ok = order < 0
				} else if comparator.op == "<=" {
					ok = order <= 0
				} else if comparator.op == ">" {
					ok = order > 0
				} else if comparator.op == ">=" {
					ok = order >= 0
				}
				return false unless ok
			}
			return true when candidate.prerelease.len() == 0
			// A prerelease is only admitted by a comparator that opts into
			// prereleases of that very release.
			for let comparator in comparators {
				let v = comparator.version
				let sameRelease = v.major == candidate.major && v.minor == candidate.minor && v.patch == candidate.patch
				return true when sameRelease && v.prerelease.len() > 0
			}
			return false
		}
	}

	// A version in a range, where the minor and patch parts may be missing or
	// wildcards (`x`, `X`, `*`).
	internal struct Partial {
		major      uint
		minor      uint
		patch      uint
		hasMajor   bool
		hasMinor   bool
		hasPatch   bool
		prerelease string[]
	}

	// Parses a range (see `Semver.satisfies`) into its `||` branches.
	// Fails on an operator without a version, an unknown operator or a version
	// that does not parse.
	internal def parseRange(range string) !ComparatorSet[] {
		let sets = ComparatorSet[]
		for let branch in range.split("||") {
			let tokens = splitTokens(branch)
			let comparators = Comparator[]
			if tokens.len() == 0 {
				comparators.push(...try expandComparator("", "*"))
				let anySet = new ComparatorSet()
				anySet.comparators = comparators
				sets.push(anySet)
				continue
			}
			let i = 0
			for {
				break when i >= tokens.len()
				let token = tokens[i]
				if i + 2 < tokens.len() && tokens[i + 1] == "-" {
					comparators.push(...try expandHyphen(token, tokens[i + 2]))
					i += 3
					continue
				}
				let op = operatorPrefix(token)
				let rest = token.slice(op.len())
				if rest.len() == 0 {
					fail "semver: operator \"{op}\" without a version in \"{range}\"" when i + 1 >= tokens.len()
					rest = tokens[i + 1]
					i += 1
				}
				comparators.push(...try expandComparator(op, rest))
				i += 1
			}
			let set = new ComparatorSet()
			set.comparators = comparators
			sets.push(set)
		}
		return sets
	}

	// Splits a range branch on whitespace.
	internal def splitTokens(branch string) string[] {
		let tokens = string[]
		for let token in branch.replace("\t", " ").replace("\n", " ").split(" ") {
			tokens.push(token) when token.len() > 0
		}
		return tokens
	}

	// Returns the operator a comparator token starts with, empty when none.
	internal def operatorPrefix(token string) string {
		for let op in [">=", "<=", ">", "<", "=", "~", "^"] {
			return op when token.startsWith(op)
		}
		return ""
	}

	// Parses a range version, accepting a leading `v` or `=` and `x`/`X`/`*`
	// wildcards for the parts after the major.
	internal def parsePartial(text string) !Partial {
		let core = text
		core = core.slice(1) when core.startsWith("v") || core.startsWith("V") || core.startsWith("=")
		let plus = core.indexOf("+")
		core = core.slice(0, plus) when plus >= 0
		let prerelease = string[]
		let dash = core.indexOf("-")
		if dash >= 0 {
			prerelease = try parseIdentifiers(core.slice(dash + 1), true)
			core = core.slice(0, dash)
		}
		let spec = Partial{prerelease: prerelease}
		return spec when core.len() == 0 || isWildcard(core)
		let parts = core.split(".")
		fail "semver: too many numeric parts in \"{text}\"" when parts.len() > 3
		for let (i, part) in parts {
			break when isWildcard(part)
			fail "semver: non-numeric part \"{part}\" in \"{text}\"" unless isDigits(part)
			let number = part.toInt<uint>()
			if i == 0 {
				spec.major = number
				spec.hasMajor = true
			} else if i == 1 {
				spec.minor = number
				spec.hasMinor = true
			} else {
				spec.patch = number
				spec.hasPatch = true
			}
		}
		return spec
	}

	// Reports whether a range part is a wildcard (`x`, `X` or `*`).
	internal def isWildcard(part string) bool {
		return part == "x" || part == "X" || part == "*"
	}

	// Builds a release version from three numbers.
	internal def release(major uint, minor uint, patch uint) Semver {
		return Semver{
			version:        "{major}.{minor}.{patch}",
			majorPart:      major,
			minorPart:      minor,
			patchPart:      patch,
			prereleasePart: string[],
			buildPart:      string[],
		}
	}

	// Builds the version a spec names exactly, keeping its prerelease.
	internal def exact(spec Partial) Semver {
		let v = release(spec.major, spec.minor, spec.patch)
		return Semver{
			version:        v.version,
			majorPart:      spec.major,
			minorPart:      spec.minor,
			patchPart:      spec.patch,
			prereleasePart: spec.prerelease,
			buildPart:      string[],
		}
	}

	// Expands one comparator into `>=`/`<`/`<=`/`>`/`=` clauses on full
	// versions, filling in missing parts as described by `Semver.satisfies`.
	internal def expandComparator(op string, text string) !Comparator[] {
		let spec = try parsePartial(text)
		let out = Comparator[]
		if !spec.hasMajor {
			out.push(Comparator{op: ">=", version: release(0, 0, 0)})
			return out
		}
		let lower = release(spec.major, spec.minor, spec.patch)
		if op == "~" {
			out.push(Comparator{op: ">=", version: exact(spec)})
			if spec.hasMinor {
				out.push(Comparator{op: "<", version: release(spec.major, spec.minor + 1, 0)})
			} else {
				out.push(Comparator{op: "<", version: release(spec.major + 1, 0, 0)})
			}
		} else if op == "^" {
			out.push(Comparator{op: ">=", version: exact(spec)})
			if spec.major > 0 || !spec.hasMinor {
				out.push(Comparator{op: "<", version: release(spec.major + 1, 0, 0)})
			} else if spec.minor > 0 || !spec.hasPatch {
				out.push(Comparator{op: "<", version: release(0, spec.minor + 1, 0)})
			} else {
				out.push(Comparator{op: "<", version: release(0, 0, spec.patch + 1)})
			}
		} else if op == ">" {
			if spec.hasPatch {
				out.push(Comparator{op: ">", version: exact(spec)})
			} else if spec.hasMinor {
				out.push(Comparator{op: ">=", version: release(spec.major, spec.minor + 1, 0)})
			} else {
				out.push(Comparator{op: ">=", version: release(spec.major + 1, 0, 0)})
			}
		} else if op == "<=" {
			if spec.hasPatch {
				out.push(Comparator{op: "<=", version: exact(spec)})
			} else if spec.hasMinor {
				out.push(Comparator{op: "<", version: release(spec.major, spec.minor + 1, 0)})
			} else {
				out.push(Comparator{op: "<", version: release(spec.major + 1, 0, 0)})
			}
		} else if op == ">=" {
			out.push(Comparator{op: ">=", version: exact(spec)})
		} else if op == "<" {
			out.push(Comparator{op: "<", version: exact(spec)})
		} else if spec.hasPatch {
			out.push(Comparator{op: "=", version: exact(spec)})
		} else if spec.hasMinor {
			out.push(Comparator{op: ">=", version: lower})
			out.push(Comparator{op: "<", version: release(spec.major, spec.minor + 1, 0)})
		} else {
			out.push(Comparator{op: ">=", version: lower})
			out.push(Comparator{op: "<", version: release(spec.major + 1, 0, 0)})
		}
		return out
	}

	// Expands `low - high` into `>=low` and an upper bound; a spec upper
	// bound excludes the next minor or major (`1.2.3 - 2.3` is `<2.4.0`).
	internal def expandHyphen(low string, high string) !Comparator[] {
		let out = try expandComparator(">=", low)
		let upper = try parsePartial(high)
		if !upper.hasMajor {
			return out
		}
		if upper.hasPatch {
			out.push(Comparator{op: "<=", version: exact(upper)})
		} else if upper.hasMinor {
			out.push(Comparator{op: "<", version: release(upper.major, upper.minor + 1, 0)})
		} else {
			out.push(Comparator{op: "<", version: release(upper.major + 1, 0, 0)})
		}
		return out
	}
}
