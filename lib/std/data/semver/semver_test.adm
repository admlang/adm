partial module std.data.semver {
	use std.testing

	check "Semver parse" {
		@test()
		def parsesEveryPart() !none {
			let v = try parse("1.2.3-rc.2+linux.x86_64")
			assert v.major == 1
			assert v.minor == 2
			assert v.patch == 3
			assert v.prerelease.len() == 2
			assert v.prerelease[0] == "rc"
			assert v.prerelease[1] == "2"
			assert v.build.len() == 2
			assert v.build[0] == "linux"
			assert v.build[1] == "x86_64"
			assert v.str() == "1.2.3-rc.2+linux.x86_64"
			assert v.canonical() == "1.2.3-rc.2+linux.x86_64"
		}

		@test()
		def fillsMissingParts() !none {
			let one = try parse("2")
			assert one.major == 2
			assert one.minor == 0
			assert one.patch == 0
			assert one.canonical() == "2.0.0"

			let two = try parse("2.1")
			assert two.minor == 1
			assert two.canonical() == "2.1.0"

			let prefixed = try parse(" v2.1.0-beta.1 ")
			assert prefixed.str() == "v2.1.0-beta.1"
			assert prefixed.canonical() == "2.1.0-beta.1"
			assert prefixed.prerelease[1] == "1"
		}

		@test()
		def keepsBuildAndPrereleaseApart() !none {
			let v = try parse("1.0.0+build.4")
			assert v.prerelease.len() == 0
			assert v.build.len() == 2
			assert v.canonical() == "1.0.0+build.4"

			let dashed = try parse("1.0.0-alpha-2+sha-abc")
			assert dashed.prerelease[0] == "alpha-2"
			assert dashed.build[0] == "sha-abc"
		}

		@test()
		def rejectsMalformedVersions() {
			assert parse("") is error
			assert parse("1.2.3.4") is error
			assert parse("1..3") is error
			assert parse("01.2.3") is error
			assert parse("1.a.3") is error
			assert parse("1.2.3-") is error
			assert parse("1.2.3-rc..1") is error
			assert parse("1.2.3-01") is error
			assert parse("1.2.3-rc/1") is error
			assert parse("1.2.3-rc.é") is error
			assert parse("1.2.3+") is error
			assert parse("1.2.3+a b") is error
		}

		@test()
		def freeFunctionsReadParts() {
			assert major("3.4.5-rc.1+7") == 3
			assert minor("3.4.5-rc.1+7") == 4
			assert patch("3.4.5-rc.1+7") == 5
			assert prerelease("3.4.5-rc.1+7").len() == 2
			assert prerelease("3.4.5-rc.1+7")[0] == "rc"
			assert build("3.4.5-rc.1+7")[0] == "7"
			assert major("nope") == 0
			assert prerelease("nope").len() == 0
			assert build("3.4.5").len() == 0
		}
	}

	check "Semver compare" {
		// Reports whether `low` precedes `high` under every operator.
		def ordered(low string, high string) !bool {
			let a = try parse(low)
			let b = try parse(high)
			return false unless a < b
			return false unless b > a
			return false unless a <= b
			return false unless b >= a
			return false when a == b
			return false when a > b
			return false when b < a
			return compare(a, b) == -1 && compare(b, a) == 1
		}

		@test()
		def numericPrecedence() !none {
			assert try ordered("1.0.0", "2.0.0")
			assert try ordered("2.0.0", "2.1.0")
			assert try ordered("2.1.0", "2.1.1")
			assert try ordered("1.9.9", "1.10.0")
		}

		@test()
		def prereleasePrecedence() !none {
			// The chain from semver.org 2.0.0 §11.
			assert try ordered("1.0.0-alpha", "1.0.0-alpha.1")
			assert try ordered("1.0.0-alpha.1", "1.0.0-alpha.beta")
			assert try ordered("1.0.0-alpha.beta", "1.0.0-beta")
			assert try ordered("1.0.0-beta", "1.0.0-beta.2")
			assert try ordered("1.0.0-beta.2", "1.0.0-beta.11")
			assert try ordered("1.0.0-beta.11", "1.0.0-rc.1")
			assert try ordered("1.0.0-rc.1", "1.0.0")
		}

		@test()
		def buildMetadataIsIgnored() !none {
			let a = try parse("1.2.3+linux")
			let b = try parse("1.2.3+windows")
			assert a == b
			assert a <= b
			assert a >= b
			assert !(a < b)
			assert compare(a, b) == 0
		}

		@test()
		def comparesAgainstStrings() !none {
			let v = try parse("1.4.0")
			assert v == "1.4"
			assert v == "v1.4.0+meta"
			assert v > "1.3.9"
			assert v >= "1.4.0"
			assert v < "1.4.1-alpha"
			assert v <= "2"
			assert !(v == "bogus")
			assert !(v < "bogus")
			assert !(v >= "bogus")
		}
	}

	check "Semver satisfies" {
		def ok(version string, range string) bool {
			let v = parse(version)
			return false when v is error
			return v.satisfies(range)
		}

		@test()
		def exactAndOperators() {
			assert ok("1.2.3", "1.2.3")
			assert ok("1.2.3", "=1.2.3")
			assert ok("1.2.3", "v1.2.3")
			assert !ok("1.2.4", "1.2.3")
			assert ok("1.2.3", ">= 1.2.3")
			assert ok("1.2.3", ">=1.2.3")
			assert !ok("1.2.2", ">= 1.2.3")
			assert ok("1.4.5", ">= 1.2 <= 1.4.5")
			assert !ok("1.4.6", ">= 1.2 <= 1.4.5")
			assert ok("1.3.0", "> 1.2 < 1.4")
			assert !ok("1.2.9", "> 1.2")
			assert ok("1.9.9", "<2")
			assert !ok("2.0.0", "<2")
		}

		@test()
		def tildeRanges() {
			assert ok("1.2.3", "~1.2.3")
			assert ok("1.2.9", "~1.2.3")
			assert !ok("1.3.0", "~1.2.3")
			assert !ok("1.2.2", "~1.2.3")
			assert ok("1.5.0", "~1")
			assert !ok("2.0.0", "~1")
			assert ok("0.2.5", "~0.2")
			assert !ok("0.3.0", "~0.2")
		}

		@test()
		def caretRanges() {
			assert ok("1.2.3", "^1.2.3")
			assert ok("1.9.0", "^1.2.3")
			assert !ok("2.0.0", "^1.2.3")
			assert !ok("1.2.2", "^1.2.3")
			assert ok("0.2.9", "^0.2.3")
			assert !ok("0.3.0", "^0.2.3")
			assert ok("0.0.3", "^0.0.3")
			assert !ok("0.0.4", "^0.0.3")
			assert ok("0.5.0", "^0.x")
			assert !ok("1.0.0", "^0.x")
			assert ok("1.7.0", "^1")
		}

		@test()
		def wildcardsAndPartials() {
			assert ok("1.2.9", "1.2.x")
			assert ok("1.2.9", "1.2.*")
			assert ok("1.2.9", "1.2")
			assert !ok("1.3.0", "1.2.x")
			assert ok("1.9.9", "1.x")
			assert ok("1.9.9", "1")
			assert !ok("2.0.0", "1.x")
			assert ok("7.7.7", "*")
			assert ok("7.7.7", "")
			assert ok("7.7.7", "x")
		}

		@test()
		def hyphenAndOrRanges() {
			assert ok("1.2.3", "1.2.3 - 2.3.4")
			assert ok("2.3.4", "1.2.3 - 2.3.4")
			assert !ok("2.3.5", "1.2.3 - 2.3.4")
			assert ok("2.3.9", "1.2.3 - 2.3")
			assert !ok("2.4.0", "1.2.3 - 2.3")
			assert ok("1.5.0", "^1.2.3 || ^2.0.0")
			assert ok("2.1.0", "^1.2.3 || ^2.0.0")
			assert !ok("3.0.0", "^1.2.3 || ^2.0.0")
			assert ok("0.9.0", "<1.0.0 || >=2.0.0")
		}

		@test()
		def prereleasesNeedAnOptIn() {
			assert !ok("2.0.0-beta", ">=1.0.0")
			assert !ok("2.0.0-beta", "^1.0.0 || ^2.0.0")
			assert ok("2.0.0-beta", ">=2.0.0-alpha")
			assert ok("2.0.0-beta.2", "~2.0.0-beta.1")
			assert !ok("2.0.0-alpha", ">=2.0.0-beta")
			assert ok("2.0.0", ">=2.0.0-alpha")
		}

		@test()
		def badRangesMatchNothing() {
			assert !ok("1.2.3", ">=")
			assert !ok("1.2.3", "banana")
			assert !ok("1.2.3", ">= 1.2.a")
		}
	}
}
