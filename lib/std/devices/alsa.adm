internal partial module std.devices.alsa {
	use (
		std.formats.audio::(Converter)
		std.services.storage::(Storage)
		std.services.devices::(Device, Devices)
		std.math
		std.time
		std.devices::*
		std.devices.samples::*
		std.devices.structs::*
	)

	// ALSA, the kernel's sound interface on Linux, spoken directly on a
	// `/dev/snd/pcm*` node: no sound server and no C library.
	//
	// Configuration goes through `Storage.control` with the structures below
	// laid out by hand, as `v4l2.adm` does for video. Samples then travel with
	// plain `Storage.write` and `Storage.read` on the node, which the kernel
	// accepts for interleaved access, after `Storage.wait` says there is room or
	// data, so no transfer ever blocks.
	//
	// **These numbers describe 64-bit Linux**, from `<sound/asound.h>`. A request
	// number embeds the size of the structure it carries, so another architecture
	// adds its own table beside this one rather than editing these.

	// --- snd_pcm_hw_params: what the device can do and what it will do (608 bytes)
	//
	//     flags           0     4 bytes
	//     masks           4     3 masks of 32 bytes: access, format, subformat
	//     mres          100     reserved masks
	//     intervals     260     12 intervals of 12 bytes, sample bits .. tick time
	//     ires          404     reserved intervals
	//     rmask         512     which parameters to refine
	//     cmask         516     which parameters the kernel changed
	//     info          520
	//     msbits        524
	//     rate_num      528
	//     rate_den      532
	//     fifo_size     536
	//
	// A mask is 256 bits, one per value. An interval is `min`, `max` and a flag
	// word (open min, open max, integer, empty).
	const HW_PARAMS_SIZE = 608
	const HW_MASKS = 4
	const HW_MASK_SIZE = 32
	const HW_MASK_COUNT = 3
	const HW_INTERVALS = 260
	const HW_INTERVAL_SIZE = 12
	const HW_INTERVAL_COUNT = 12
	const HW_RMASK = 512
	const HW_CMASK = 516
	const HW_INFO = 520

	// Parameter numbers: masks first, then intervals from 8.
	const PARAM_ACCESS = 0
	const PARAM_FORMAT = 1
	const PARAM_CHANNELS = 10
	const PARAM_RATE = 11
	const PARAM_PERIOD_TIME = 12
	const PARAM_PERIOD_SIZE = 13
	const PARAM_BUFFER_TIME = 16
	const PARAM_BUFFER_SIZE = 17
	const PARAM_FIRST_INTERVAL = 8

	// Interleaved frames moved with read and write.
	const ACCESS_RW_INTERLEAVED = 3

	// The sample layouts this module converts to and from.
	const FORMAT_S16_LE = 2
	const FORMAT_S24_LE = 6
	const FORMAT_S32_LE = 10
	const FORMAT_FLOAT_LE = 14
	const FORMAT_S24_3LE = 32

	// --- snd_pcm_sw_params: when to wake and when to start (136 bytes) ----------
	//
	//     tstamp_mode        0
	//     period_step        4
	//     sleep_min          8
	//     avail_min         16    8 bytes from here on
	//     xfer_align        24
	//     start_threshold   32
	//     stop_threshold    40
	//     silence_threshold 48
	//     silence_size      56
	//     boundary          64    the kernel's own, written back
	const SW_PARAMS_SIZE = 136
	const SW_PERIOD_STEP = 4
	const SW_AVAIL_MIN = 16
	const SW_START_THRESHOLD = 32
	const SW_STOP_THRESHOLD = 40

	// --- snd_pcm_status: where the stream is (152 bytes) ------------------------
	//
	//     state      0
	//     delay     56    frames queued and not yet heard, 8 bytes
	//     avail     64    frames that can be written or read now, 8 bytes
	const STATUS_SIZE = 152
	const STATUS_STATE = 0
	const STATUS_DELAY = 56
	const STATUS_AVAIL = 64

	// Stream states.
	const STATE_PREPARED = 2
	const STATE_RUNNING = 3
	const STATE_XRUN = 4
	const STATE_DRAINING = 5

	// Request numbers: 'A' requests, the direction and size in the high bits.
	const PCM_HW_REFINE = 0xC2604110
	const PCM_HW_PARAMS = 0xC2604111
	const PCM_SW_PARAMS = 0xC0884113
	const PCM_STATUS = 0x80984120
	const PCM_PREPARE = 0x4140
	const PCM_START = 0x4142
	const PCM_DROP = 0x4143

	// The period the device wakes the program at, and the most sound queued
	// ahead, in microseconds: short enough to stop promptly, long enough to
	// ride out a busy moment without running dry.
	const PERIOD_MIN_US = 10000
	const PERIOD_MAX_US = 50000
	const BUFFER_MIN_US = 40000
	const BUFFER_MAX_US = 200000

	// What a PCM stream settled on.
	struct PcmLayout {
		// One of the FORMAT_ constants.
		format       int
		channels     int
		rate         int
		// Frames the device moves per wake-up.
		periodFrames int
		// Frames the device can hold queued.
		bufferFrames int
	}

	// Where a PCM stream is.
	struct PcmStatus {
		// One of the STATE_ constants.
		state int
		// Frames queued and not yet heard (playback) or recorded and not yet read.
		delay int
		// Frames that can be written or read now.
		avail int
	}

	// --- the structures ---------------------------------------------------------

	// A parameter block that allows everything, for the device to narrow.
	def anyParams() byte[] {
		let params = zeroed(HW_PARAMS_SIZE)
		for let m = 0; m < HW_MASK_COUNT; m++ {
			for let w = 0; w < HW_MASK_SIZE / 4; w++ {
				putU32(params, HW_MASKS + m * HW_MASK_SIZE + w * 4, 0xFFFFFFFF)
			}
		}
		for let i = 0; i < HW_INTERVAL_COUNT; i++ {
			let at = HW_INTERVALS + i * HW_INTERVAL_SIZE
			putU32(params, at, 0)
			putU32(params, at + 4, 0xFFFFFFFF)
		}
		putU32(params, HW_RMASK, 0xFFFFFFFF)
		putU32(params, HW_INFO, 0xFFFFFFFF)
		return params
	}

	// Whether the mask parameter allows the value.
	def maskHas(params byte[], param int, value int) bool {
		let word = u32(params, HW_MASKS + param * HW_MASK_SIZE + (value / 32) * 4)
		return (word & (1 << (value % 32))) != 0
	}

	// Narrows the mask parameter to the one value.
	def maskOnly(params byte[], param int, value int) {
		let at = HW_MASKS + param * HW_MASK_SIZE
		for let w = 0; w < HW_MASK_SIZE / 4; w++ {
			putU32(params, at + w * 4, 0)
		}
		putU32(params, at + (value / 32) * 4, 1 << (value % 32))
	}

	// The lowest value the mask parameter allows, -1 when it allows none.
	def maskFirst(params byte[], param int) int {
		for let value = 0; value < HW_MASK_SIZE * 8; value++ {
			return value when maskHas(params, param, value)
		}
		return -1
	}

	// The interval parameter's bounds.
	def intervalMin(params byte[], param int) int {
		return u32(params, HW_INTERVALS + (param - PARAM_FIRST_INTERVAL) * HW_INTERVAL_SIZE)
	}

	def intervalMax(params byte[], param int) int {
		return u32(params, HW_INTERVALS + (param - PARAM_FIRST_INTERVAL) * HW_INTERVAL_SIZE + 4)
	}

	// Narrows the interval parameter to min..max, both included.
	def intervalSet(params byte[], param int, min int, max int) {
		let at = HW_INTERVALS + (param - PARAM_FIRST_INTERVAL) * HW_INTERVAL_SIZE
		putU32(params, at, min)
		putU32(params, at + 4, max)
		putU32(params, at + 8, 0)
	}

	// --- the conversation -------------------------------------------------------

	// Narrows the parameters to what the device can do with them, in place.
	//
	// Fails when the device can do nothing within them.
	def refine(fd int, params byte[]) !byte[] {
		putU32(params, HW_RMASK, 0xFFFFFFFF)
		putU32(params, HW_CMASK, 0)
		try Storage.control(fd, PCM_HW_REFINE, params)
		return params
	}

	// The parameters with one more narrowing applied, or none when the device
	// cannot do it.
	def tryRefine(fd int, params byte[], narrow def (params byte[])) ?byte[] {
		let copy = params.clone()
		narrow(copy)
		let refined = refine(fd, copy) onerror (err error) {
			return none
		}
		return refined
	}

	// Settles the stream on the layout closest to the one asked for, installs it
	// and prepares the stream. The device's own format is taken as it comes,
	// preferring the widest one this module converts; channels and rate are the
	// ones asked for when the device supports them, else the nearest it does.
	//
	// Fails when the device supports none of the formats or refuses the setup,
	// as it does while another program holds it.
	def configurePcm(fd int, playback bool, rate int, channels int) !PcmLayout {
		let params = try refine(fd, anyParams())
		let ok = tryRefine(fd, params, p => maskOnly(p, PARAM_ACCESS, ACCESS_RW_INTERLEAVED))
		fail "devices: the sound device cannot move interleaved frames" when ok is none
		params = ok

		let format = -1
		for let (_, candidate) in [FORMAT_S32_LE, FORMAT_FLOAT_LE, FORMAT_S24_3LE, FORMAT_S24_LE, FORMAT_S16_LE] {
			if maskHas(params, PARAM_FORMAT, candidate) {
				format = candidate
				break
			}
		}
		fail "devices: the sound device supports none of the 16, 24 and 32-bit sample formats" when format < 0
		params = try refine(fd, narrowed(params, p => maskOnly(p, PARAM_FORMAT, format)))

		params = try settle(fd, params, PARAM_CHANNELS, [channels, 2, 1])
		params = try settle(fd, params, PARAM_RATE, [rate, 48000, 44100, 96000])

		// Timing is a wish: a device that cannot meet it keeps its own.
		let timed = tryRefine(fd, params, limitTiming)
		params = timed unless timed is none

		putU32(params, HW_RMASK, 0xFFFFFFFF)
		putU32(params, HW_CMASK, 0)
		try Storage.control(fd, PCM_HW_PARAMS, params)
		let layout = PcmLayout{
			format:       maskFirst(params, PARAM_FORMAT),
			channels:     intervalMin(params, PARAM_CHANNELS),
			rate:         intervalMin(params, PARAM_RATE),
			periodFrames: intervalMin(params, PARAM_PERIOD_SIZE),
			bufferFrames: intervalMin(params, PARAM_BUFFER_SIZE),
		}

		// Playback starts once the buffer is within a period of full, so the first
		// period is not already running dry. Not full itself: a writer waits for
		// room for a whole period, and with less than that left the buffer would
		// never fill. Recording starts at once.
		let sw = zeroed(SW_PARAMS_SIZE)
		putU32(sw, SW_PERIOD_STEP, 1)
		putU64(sw, SW_AVAIL_MIN, int64(layout.periodFrames))
		let fillStart = layout.bufferFrames - layout.periodFrames
		putU64(sw, SW_START_THRESHOLD, int64(playback ?? (fillStart > 0 ?? (fillStart, 1), 1)))
		putU64(sw, SW_STOP_THRESHOLD, int64(layout.bufferFrames))
		try Storage.control(fd, PCM_SW_PARAMS, sw)
		try pcmRequest(fd, PCM_PREPARE)
		return layout
	}

	// Narrows the period and buffer times to the ones this module wants.
	def limitTiming(params byte[]) {
		intervalSet(params, PARAM_PERIOD_TIME, PERIOD_MIN_US, PERIOD_MAX_US)
		intervalSet(params, PARAM_BUFFER_TIME, BUFFER_MIN_US, BUFFER_MAX_US)
	}

	// A copy of the parameters with the narrowing applied.
	def narrowed(params byte[], narrow def (params byte[])) byte[] {
		let copy = params.clone()
		narrow(copy)
		return copy
	}

	// Fixes the interval parameter to the first of the wanted values the device
	// takes, else to the lowest value it takes.
	//
	// Fails when the device takes none.
	def settle(fd int, params byte[], param int, wanted int[]) !byte[] {
		for let (_, value) in wanted {
			continue when value <= 0
			let got = tryRefine(fd, params, p => intervalSet(p, param, value, value))
			return got when !(got is none)
		}
		let lowest = intervalMin(params, param)
		return refine(fd, narrowed(params, p => intervalSet(p, param, lowest, lowest)))
	}

	// Where the stream is.
	//
	// Fails when the device errors.
	def pcmStatus(fd int) !PcmStatus {
		let buf = zeroed(STATUS_SIZE)
		try Storage.control(fd, PCM_STATUS, buf)
		return PcmStatus{
			state: u32(buf, STATUS_STATE),
			delay: int(u64(buf, STATUS_DELAY)),
			avail: int(u64(buf, STATUS_AVAIL)),
		}
	}

	// Sends a request that carries no structure: prepare, start, drop.
	//
	// Fails when the device refuses it.
	def pcmRequest(fd int, request int) !none {
		try Storage.control(fd, request, [])
		return none
	}

	// Bytes one sample takes in the format.
	def formatBytes(format int) int {
		return 2 when format == FORMAT_S16_LE
		return 3 when format == FORMAT_S24_3LE
		return 4
	}

	// A speaker played straight through an ALSA node.
	type AlsaPlayback {
		internal fd        int
		internal layout    PcmLayout
		// From the speaker's rate and channels to the device's.
		internal converter Converter
		// The stream's own volume and mute, applied to the samples: the
		// hardware has one volume for everyone.
		internal level     float     = 1.0
		internal silenced  bool      = false

		def new(fd int, layout PcmLayout, sampleRate int, channels int) {
			self.fd = fd
			self.layout = layout
			converter = new Converter(sampleRate, channels, layout.rate, layout.channels)
		}

		// Converts the frames and writes them a period at a time, each once the
		// device has room for it, so no write blocks.
		//
		// Fails when the device stops taking sound or errors.
		def write(samples float32[]) !none {
			return writeConverted(converter.convert(samples))
		}

		// The stream's own volume, 1.0 full. Does not fail.
		def volume() !float {
			return level
		}

		// Sets the stream's own volume. Does not fail.
		def volume(level float) !none {
			self.level = level
			return none
		}

		// Whether the stream itself is muted. Does not fail.
		def muted() !bool {
			return silenced
		}

		// Mutes or unmutes the stream itself. Does not fail.
		def mute(on bool) !none {
			silenced = on
			return none
		}

		// A node stays where it is: always none.
		def moved() ?Device {
			return none
		}

		// Writes frames already in the device's rate and channels.
		//
		// Fails when the device stops taking sound or errors.
		internal def writeConverted(samples float32[]) !none {
			let data = encodeSamples(samples, layout.format, silenced ?? (float32(0.0), volumeGain(level)))
			let chunk = layout.periodFrames * formatBytes(layout.format) * layout.channels
			let at = 0
			for at < data.len() {
				let room = try Storage.wait(fd, DEVICE_TIMEOUT, true)
				fail "devices: the speaker stopped taking sound" unless room
				let end = at + chunk > data.len() ?? (data.len(), at + chunk)
				let written = Storage.write(fd, data[at:end]) onerror (err error) {
					// Running dry stops the stream; prepared again, it takes more.
					try recoverUnderrun(err)
					recover 0
				}
				at += written
			}
			return none
		}

		// Waits for the queue to play out by looking at the stream now and then,
		// rather than blocking in the driver's own drain.
		//
		// Fails when the device errors.
		def drain() !none {
			let tail = converter.flush()
			try writeConverted(tail) when tail.len() > 0
			let status = try pcmStatus(fd)
			// Sound shorter than the start threshold never started.
			if status.state == STATE_PREPARED && status.delay > 0 {
				try pcmRequest(fd, PCM_START)
			}
			for {
				status = try pcmStatus(fd)
				break unless (status.state == STATE_RUNNING || status.state == STATE_DRAINING) && status.delay > 0
				let left = status.delay * 1000 / layout.rate
				time.sleep(duration((left < DRAIN_POLL_MS ?? (left + 1, DRAIN_POLL_MS)) * 1000000))
			}
			// Played out, the stream stopped as it ran dry; ready it for more.
			if status.state == STATE_XRUN || status.state == STATE_RUNNING {
				try pcmRequest(fd, PCM_DROP)
				try pcmRequest(fd, PCM_PREPARE)
			}
			return none
		}

		// Drops what is queued and closes the node.
		def close() {
			pcmRequest(fd, PCM_DROP) onerror recover none
			Devices.close(fd) onerror recover none
		}

		// Prepares the stream again when a write failed because it ran dry.
		//
		// Fails with the write's own error when the stream did not run dry.
		internal def recoverUnderrun(err error) !none {
			let status = try pcmStatus(fd)
			fail err unless status.state == STATE_XRUN
			return pcmRequest(fd, PCM_PREPARE)
		}
	}

	// A microphone recorded straight from an ALSA node.
	type AlsaCapture {
		internal fd        int
		internal layout    PcmLayout
		// From the device's rate and channels to the microphone's.
		internal converter Converter
		// The stream's own volume and mute, applied to the samples.
		internal level     float     = 1.0
		internal silenced  bool      = false

		def new(fd int, layout PcmLayout, sampleRate int, channels int) {
			self.fd = fd
			self.layout = layout
			converter = new Converter(layout.rate, layout.channels, sampleRate, channels)
		}

		// Reads one period once the device has it, converted.
		//
		// Fails when the device delivers nothing in time or errors.
		def read() !float32[] {
			let ready = try Storage.wait(fd, DEVICE_TIMEOUT)
			fail "devices: the microphone delivered no sound in time" unless ready
			let frameBytes = layout.channels * formatBytes(layout.format)
			let data byte[]
			data.len(layout.periodFrames * frameBytes)
			let got = Storage.read(fd, data) onerror (err error) {
				// Not read in time, the stream overran and stopped; started again, it records on.
				try recoverOverrun(err)
				recover 0
			}
			return converter.convert(decodeSamples(data[0:got - got % frameBytes], layout.format, silenced ?? (float32(0.0), volumeGain(level))))
		}

		// The stream's own volume, 1.0 full. Does not fail.
		def volume() !float {
			return level
		}

		// Sets the stream's own volume. Does not fail.
		def volume(level float) !none {
			self.level = level
			return none
		}

		// Whether the stream itself is muted. Does not fail.
		def muted() !bool {
			return silenced
		}

		// Mutes or unmutes the stream itself. Does not fail.
		def mute(on bool) !none {
			silenced = on
			return none
		}

		// A node stays where it is: always none.
		def moved() ?Device {
			return none
		}

		// Stops recording and closes the node.
		def close() {
			pcmRequest(fd, PCM_DROP) onerror recover none
			Devices.close(fd) onerror recover none
		}

		// Restarts the stream when a read failed because it overran.
		//
		// Fails with the read's own error when the stream did not overrun.
		internal def recoverOverrun(err error) !none {
			let status = try pcmStatus(fd)
			fail err unless status.state == STATE_XRUN
			try pcmRequest(fd, PCM_PREPARE)
			return pcmRequest(fd, PCM_START)
		}
	}

	// Sets up an open ALSA node for playback or recording and returns the
	// layout it settled on; a recording starts at once. The caller keeps the
	// descriptor, and closes it when this fails.
	//
	// Fails when the node refuses the setup.
	def openAlsa(fd int, playback bool, sampleRate int, channels int) !PcmLayout {
		let layout = try configurePcm(fd, playback, sampleRate, channels)
		try pcmRequest(fd, PCM_START) unless playback
		return layout
	}

	// --- the mixer: a card's control node, /dev/snd/controlC<card> --------------
	//
	// A card's volume and mute live in its mixer elements, each with a number
	// (`numid`) and a name ("Master Playback Volume", "Mic Capture Switch").
	// An element is described with ELEM_INFO and read and written with
	// ELEM_READ and ELEM_WRITE, its value an integer per channel; a volume's
	// scale in decibels comes with TLV_READ.
	//
	//     snd_ctl_elem_id (64): numid 0, iface 4, device 8, subdevice 12, name 16 (44), index 60
	//     snd_ctl_elem_list (80): count 12; the element ids need a pointer and
	//         are not asked for: elements are found by number instead
	//     snd_ctl_elem_info (272): id 0, type 64, access 68, count 72,
	//         integer min 80, max 88 (8 bytes each)
	//     snd_ctl_elem_value (1224): id 0, values from 72, 8 bytes each
	//     snd_ctl_tlv (8 + data): numid 0, length 4, data 8
	//     snd_ctl_event (72): type 0, mask 4, then the element's id
	const CTL_ELEM_LIST = 0xC0505510
	const CTL_ELEM_INFO = 0xC1105511
	const CTL_ELEM_READ = 0xC4C85512
	const CTL_ELEM_WRITE = 0xC4C85513
	const CTL_TLV_READ = 0xC008551A
	const CTL_SUBSCRIBE_EVENTS = 0xC0045516
	const CTL_ELEM_LIST_SIZE = 80
	const CTL_ELEM_INFO_SIZE = 272
	const CTL_ELEM_VALUE_SIZE = 1224
	const CTL_EVENT_SIZE = 72
	const CTL_ID_NAME = 16
	const CTL_ID_NAME_SIZE = 44
	const CTL_ID_INDEX = 60
	const CTL_INFO_TYPE = 64
	const CTL_INFO_ACCESS = 68
	const CTL_INFO_COUNT = 72
	const CTL_INFO_MIN = 80
	const CTL_INFO_MAX = 88
	const CTL_VALUES = 72
	// The decibel description read with TLV_READ; a volume's is far shorter.
	const CTL_TLV_ROOM = 512

	const CTL_IFACE_MIXER = 2
	const CTL_TYPE_BOOLEAN = 1
	const CTL_TYPE_INTEGER = 2
	const CTL_ACCESS_WRITE = 0x2
	const CTL_ACCESS_TLV_READ = 0x10

	// Decibel descriptions (sound/tlv.h), values in hundredths of a dB.
	const TLV_CONTAINER = 0
	const TLV_DB_SCALE = 1
	const TLV_DB_LINEAR = 2
	const TLV_DB_RANGE = 3
	const TLV_DB_MINMAX = 4
	const TLV_DB_MINMAX_MUTE = 5
	// A decibel scale's flag that its lowest value is silence.
	const TLV_DB_SCALE_MUTE = 0x10000
	// The lowest a decibel scale reads: silence.
	const DB_SILENT = -9999999

	// One mixer element.
	struct MixerElement {
		numid  int
		name   string
		index  int
		// CTL_TYPE_BOOLEAN or CTL_TYPE_INTEGER (others are left out).
		kind   int
		// Values, one per channel.
		count  int
		min    int
		max    int
		access int
	}

	// The integer and boolean mixer elements of the card's control node.
	//
	// Fails when the node refuses the listing or an element's description.
	def mixerElements(fd int) !MixerElement[] {
		let list = zeroed(CTL_ELEM_LIST_SIZE)
		try Storage.control(fd, CTL_ELEM_LIST, list)
		let count = u32(list, 12)
		let out MixerElement[]
		let found = 0
		// Numbers run from 1 and are almost always dense; a gap is passed over.
		for let numid = 1; found < count && numid <= count + MIXER_GAPS; numid++ {
			let info = zeroed(CTL_ELEM_INFO_SIZE)
			putU32(info, 0, numid)
			// A number with no element answers ENOENT.
			let _ = Storage.control(fd, CTL_ELEM_INFO, info) onerror (err error) {
				continue when err.code == "ENOENT"
				fail err
			}
			found += 1
			let kind = u32(info, CTL_INFO_TYPE)
			continue unless u32(info, 4) == CTL_IFACE_MIXER && (kind := CTL_TYPE_BOOLEAN || CTL_TYPE_INTEGER)
			out.push(MixerElement{
				numid:  numid,
				name:   cString(info, CTL_ID_NAME, CTL_ID_NAME_SIZE),
				index:  u32(info, CTL_ID_INDEX),
				kind:   kind,
				count:  u32(info, CTL_INFO_COUNT),
				min:    int(u64(info, CTL_INFO_MIN)),
				max:    int(u64(info, CTL_INFO_MAX)),
				access: u32(info, CTL_INFO_ACCESS),
			})
		}
		return out
	}

	// How many numbers past the element count the scan looks for elements.
	const MIXER_GAPS = 256

	// The zero-ended string at the offset, at most size bytes.
	def cString(buf byte[], offset int, size int) string {
		let end = offset
		for end < offset + size && buf[end] != byte(0) {
			end += 1
		}
		return string(buf[offset:end])
	}

	// The volume and mute elements of a card for its outputs or its inputs:
	// the first of the usual names ("Master", "PCM", "Speaker", "Headphone"
	// for playback; "Capture", "Mic", "Headset" for capture) the card has,
	// else its first such element. The switch is the one of the same name,
	// none when the card has none.
	def soundControls(elements MixerElement[], playback bool) (?MixerElement, ?MixerElement) {
		let suffix = playback ?? ("Playback Volume", "Capture Volume")
		let switchSuffix = playback ?? ("Playback Switch", "Capture Switch")
		let preferred = playback ?? (["Master", "PCM", "Speaker", "Headphone", "Front"], ["Capture", "Mic", "Headset", "Front Mic", "Internal Mic", "Line"])
		let volumes MixerElement[]
		for let (_, element) in elements {
			volumes.push(element) when element.kind == CTL_TYPE_INTEGER && element.index == 0 && element.name.endsWith(suffix)
		}
		let chosen ?MixerElement = none
		for let (_, name) in preferred {
			for let (_, element) in volumes {
				if mixerPrefix(element.name, suffix) == name {
					chosen = element
					break
				}
			}
			break unless chosen is none
		}
		chosen = volumes[0] when chosen is none && volumes.len() > 0
		let prefix = ""
		if chosen is none {
			// A card with a switch and no volume can still be muted.
			for let (_, name) in preferred {
				prefix = name
				break
			}
		} else {
			let volume MixerElement = chosen
			prefix = mixerPrefix(volume.name, suffix)
		}
		let toggle ?MixerElement = none
		for let (_, element) in elements {
			if element.kind == CTL_TYPE_BOOLEAN && element.index == 0 && element.name.endsWith(switchSuffix) && mixerPrefix(element.name, switchSuffix) == prefix {
				toggle = element
				break
			}
		}
		return (chosen, toggle)
	}

	// The element's name without the suffix: "Master" for "Master Playback
	// Volume", "" for "Capture Volume".
	def mixerPrefix(name string, suffix string) string {
		return name[0:name.len() - suffix.len()].trim()
	}

	// The element's values, one per channel.
	//
	// Fails when the node refuses.
	def mixerRead(fd int, element MixerElement) !int[] {
		let value = zeroed(CTL_ELEM_VALUE_SIZE)
		putU32(value, 0, element.numid)
		try Storage.control(fd, CTL_ELEM_READ, value)
		let out int[]
		for let c = 0; c < element.count; c++ {
			out.push(int(u64(value, CTL_VALUES + c * 8)))
		}
		return out
	}

	// Sets every channel of the element to the value.
	//
	// Fails when the node refuses.
	def mixerWrite(fd int, element MixerElement, setting int) !none {
		let value = zeroed(CTL_ELEM_VALUE_SIZE)
		putU32(value, 0, element.numid)
		for let c = 0; c < element.count; c++ {
			putU64(value, CTL_VALUES + c * 8, int64(setting))
		}
		try Storage.control(fd, CTL_ELEM_WRITE, value)
		return none
	}

	// A volume element's scale: decibels (in hundredths) for each value, or
	// none when the card gives none.
	type DecibelScale {
		internal min int
		internal max int
		// The description, as 32-bit words.
		internal tlv int[]

		def new(min int, max int, tlv int[]) {
			self.min = min
			self.max = max
			self.tlv = tlv
		}

		// The decibels of a value, DB_SILENT for silence.
		def decibels(value int) int {
			return describe(tlv, 0, tlv.len(), min, max, value)
		}

		// The loudest the element goes, in decibels.
		def loudest() int {
			return decibels(max)
		}

		// The highest value whose decibels do not go past the wanted ones, the
		// lowest when all do. Decibels never fall as the value rises.
		def value(wanted int) int {
			let low = min
			let high = max
			for low < high {
				let middle = low + (high - low + 1) / 2
				if decibels(middle) <= wanted {
					low = middle
				} else {
					high = middle - 1
				}
			}
			return low
		}

		// Reads the description at `at` (`length` words) for a value in
		// min..max.
		internal def describe(words int[], at int, length int, min int, max int, value int) int {
			let end = at + length
			for at + 2 <= end {
				let kind = words[at]
				let size = words[at + 1] / 4
				let data = at + 2
				return describe(words, data, size, min, max, value) when kind == TLV_CONTAINER
				if kind == TLV_DB_SCALE && size >= 2 {
					let start = signed(words[data])
					let step = words[data + 1] & 0xFFFF
					return DB_SILENT when value == min && (words[data + 1] & TLV_DB_SCALE_MUTE) != 0
					return start + (value - min) * step
				}
				if (kind := TLV_DB_MINMAX || TLV_DB_MINMAX_MUTE) && size >= 2 {
					let low = signed(words[data])
					let high = signed(words[data + 1])
					return DB_SILENT when value == min && kind == TLV_DB_MINMAX_MUTE
					return low when max <= min
					return low + (high - low) * (value - min) / (max - min)
				}
				if kind == TLV_DB_LINEAR && size >= 2 {
					// The values run linear in amplitude between the two levels.
					let low = 10.0 ** (float(signed(words[data])) / 2000.0)
					let high = 10.0 ** (float(signed(words[data + 1])) / 2000.0)
					return DB_SILENT when value == min && signed(words[data]) <= DB_SILENT
					let share = max <= min ?? (0.0, float(value - min) / float(max - min))
					let amplitude = low + (high - low) * share
					return amplitude <= 0.0 ?? (DB_SILENT, int(2000.0 * math.log10(amplitude)))
				}
				if kind == TLV_DB_RANGE {
					// Ranges of values, each with its own description.
					let r = data
					for r + 4 <= data + size {
						let first = words[r]
						let last = words[r + 1]
						let inner = words[r + 3] / 4
						return describe(words, r + 2, inner + 2, first, last, value) when value >= first && value <= last
						r += 4 + inner
					}
					return DB_SILENT
				}
				at = data + size
			}
			return DB_SILENT
		}

		// A 32-bit word read as signed.
		internal def signed(word int) int {
			return word >= 0x80000000 ?? (word - 0x100000000, word)
		}
	}

	// The element's decibel scale, none when it has none.
	def decibelScale(fd int, element MixerElement) ?DecibelScale {
		return none when (element.access & CTL_ACCESS_TLV_READ) == 0
		let buf = zeroed(8 + CTL_TLV_ROOM)
		putU32(buf, 0, element.numid)
		putU32(buf, 4, CTL_TLV_ROOM)
		Storage.control(fd, CTL_TLV_READ, buf) onerror (err error) {
			return none
		}
		let words int[]
		// The header the kernel wrote back holds the description's own length.
		let length = 8 + u32(buf, 12)
		for let at = 8; at + 4 <= 8 + length && at + 4 <= buf.len(); at += 4 {
			words.push(u32(buf, at))
		}
		return new DecibelScale(element.min, element.max, words)
	}

	// The level (1.0 full, on the sound server's scale) of a volume element's
	// value. With decibels, the level's cube is the amplitude, full being 0 dB
	// or the element's loudest when that is lower; without, the value is the
	// share of the range.
	def mixerLevel(scale ?DecibelScale, element MixerElement, value int) float {
		if scale is none {
			return 0.0 when element.max <= element.min
			return float(value - element.min) / float(element.max - element.min)
		}
		let db DecibelScale = scale
		let decibels = db.decibels(value)
		return 0.0 when decibels <= DB_SILENT
		let full = db.loudest() < 0 ?? (db.loudest(), 0)
		return 10.0 ** (float(decibels - full) / 6000.0)
	}

	// The value of a volume element for a level, as mixerLevel reads it.
	def mixerValue(scale ?DecibelScale, element MixerElement, level float) int {
		if scale is none {
			let value = element.min + int(level * float(element.max - element.min) + 0.5)
			return value > element.max ?? (element.max, value)
		}
		let db DecibelScale = scale
		return element.min when level <= 0.0
		let full = db.loudest() < 0 ?? (db.loudest(), 0)
		return db.value(full + int(6000.0 * math.log10(level)))
	}

	// A card's volume and mute for its outputs or its inputs, on its open
	// control node.
	type SoundMixer {
		internal fd     int
		// The endpoint it was opened for, which errors name.
		internal id     string
		internal gain   ?MixerElement
		internal toggle ?MixerElement
		internal scale  ?DecibelScale

		def new(fd int, id string, gain ?MixerElement, toggle ?MixerElement, scale ?DecibelScale) {
			self.fd = fd
			self.id = id
			self.gain = gain
			self.toggle = toggle
			self.scale = scale
		}

		// The volume, the loudest channel's.
		//
		// Fails when the card has no volume for the endpoint or does not answer.
		def volume() !float {
			let element = try volumeElement()
			let loudest = element.min
			for let (_, value) in try mixerRead(fd, element) {
				loudest = value when value > loudest
			}
			return mixerLevel(scale, element, loudest)
		}

		// Sets every channel to the level.
		//
		// Fails when the card has no volume for the endpoint or refuses.
		def volume(level float) !none {
			let element = try volumeElement()
			return mixerWrite(fd, element, mixerValue(scale, element, level))
		}

		// Whether the switch is off; without a switch, never.
		//
		// Fails when the card does not answer.
		def muted() !bool {
			return false when toggle is none
			let element MixerElement = toggle
			for let (_, value) in try mixerRead(fd, element) {
				return false when value != 0
			}
			return true
		}

		// Turns the switch off, or on again.
		//
		// Fails when the card has no switch for the endpoint or refuses.
		def mute(on bool) !none {
			fail "devices: the sound card of {id} has no switch to mute it with" when toggle is none
			let element MixerElement = toggle
			return mixerWrite(fd, element, on ?? (0, 1))
		}

		// Closes the control node.
		def close() {
			Devices.close(fd) onerror recover none
		}

		// The volume element.
		//
		// Fails when the card has none for the endpoint.
		internal def volumeElement() !MixerElement {
			fail "devices: the sound card of {id} has no volume for it" when gain is none
			let element MixerElement = gain
			return element
		}
	}

	// The mixer of a card's open control node for its outputs or inputs; the
	// caller keeps the descriptor, which the mixer closes.
	//
	// Fails when the node refuses to list its elements.
	def soundMixer(fd int, id string, playback bool) !SoundMixer {
		let (gain, toggle) = soundControls(try mixerElements(fd), playback)
		let scale ?DecibelScale = none
		if !(gain is none) {
			let element MixerElement = gain
			scale = decibelScale(fd, element)
		}
		return new SoundMixer(fd, id, gain, toggle, scale)
	}

	// Asks the control node to report changes to its elements: each read of
	// it then returns events of CTL_EVENT_SIZE bytes.
	//
	// Fails when the node refuses.
	def mixerSubscribe(fd int) !none {
		let on = zeroed(4)
		putU32(on, 0, 1)
		try Storage.control(fd, CTL_SUBSCRIBE_EVENTS, on)
		return none
	}

	// How long a device may take to make room or deliver sound before it counts as gone.
	const DEVICE_TIMEOUT = 2s
	// The longest nap between looks at a draining speaker, in milliseconds.
	const DRAIN_POLL_MS = 20
}
