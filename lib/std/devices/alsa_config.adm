internal partial module std.devices.alsa {
	use (
		std.services.storage::(Storage)
	)

	// ALSA's configuration: which card and device the name `default` plays to
	// and records from when no sound server stands in between.
	//
	// alsa-lib reads `alsa.conf` (`$ALSA_CONFIG_PATH`, else in its data
	// directory, `$ALSA_CONFIG_DIR` or `/usr/share/alsa`), then the files its
	// `@hooks` name: `/etc/alsa/conf.d`, `/etc/asound.conf`, `~/.asoundrc`,
	// `$XDG_CONFIG_HOME/alsa/asoundrc`, later ones overriding earlier. The
	// syntax is a tree of `key value` pairs, `{ }` compounds and `[ ]`
	// arrays; a dotted key (`defaults.pcm.card 1`) names a path, and a key's
	// first character sets how it meets one already there: `!` replaces it,
	// `?` keeps it, `-` changes it only when it exists, otherwise it merges.
	// `<file>` includes a file, `<confdir:pcm/default.conf>` one of the data
	// directory. A compound holding `@func` is a function: `getenv`,
	// `igetenv`, `concat`, `refer` and `datadir` are evaluated, any other
	// reads as unknown and its `default` is taken where it has one. A PCM
	// with `@args` takes arguments (`hw:1,0`, `hw:CARD=Generic,DEV=0`) that
	// `$NAME` refers to.
	//
	// `pcm.default` is then followed through its slaves (`plug`, `dmix`,
	// `asym` by direction, a named PCM, a `hw:` string) to the `hw` PCM it
	// rests on. One that rests on a sound server or anything other than a
	// card (`pulse`, `pipewire`, `jack`, `null`, `file`) cannot be used
	// without the server, and the card of `defaults.pcm.card` (with
	// `ALSA_PCM_CARD` and `ALSA_CARD` before it) is taken instead, as the
	// stock definition does.

	// A node of the configuration tree: a leaf holds a string, a compound
	// or an array its children in order.
	type AlsaNode {
		key      string
		value    ?string    = none
		children AlsaNode[]
		array    bool       = false

		def new(key string) {
			self.key = key
		}

		// The child with the key, none when there is none.
		def child(key string) ?AlsaNode {
			for let (_, node) in children {
				return node when node.key == key
			}
			return none
		}

		// The node the dotted path names below this one, none when any part
		// is missing.
		def find(path string) ?AlsaNode {
			let node = self
			for let (_, part) in path.split(".") {
				let next = node.child(part)
				return none when next is none
				node = next
			}
			return node
		}

		// Whether this is a compound or an array rather than a leaf.
		def isCompound() bool {
			return value is none
		}

		// Removes the child with the key.
		def remove(key string) {
			children = children.filter(node => node.key != key)
		}
	}

	// How a key meets one of the same name already there.
	enum AlsaMerge {
		// Merge into it, or create it (no prefix, or `+`).
		Create,
		// Merge into it only when it exists (`-`).
		Existing,
		// Leave it as it is (`?`).
		Keep,
		// Replace it (`!`).
		Replace,
	}

	// Reads configuration text into a tree, one file after another.
	type AlsaConfigReader {
		// The data directory `<confdir:...>` includes are found in.
		internal dataDir string
		internal text    string            = ""
		internal at      int               = 0
		// Files read so far, so an include cycle ends.
		internal seen    map<string, bool>

		def new(dataDir string) {
			self.dataDir = dataDir
		}

		// Reads the file into the node; a file that cannot be read adds
		// nothing, as alsa-lib's hooks with `errors false` do.
		def load(path string, into AlsaNode) {
			return when seen.hasKey(path)
			seen[path] = true
			// A file that is not there or cannot be read adds nothing.
			let data = Storage.readFile(path) onerror (err error) {
				return
			}
			read(string(data), into)
		}

		// Reads configuration text into the node.
		def read(source string, into AlsaNode) {
			let savedText = text
			let savedAt = at
			text = source
			at = 0
			statements(into, false)
			text = savedText
			at = savedAt
		}

		// Reads `key value` statements into the node until the text or the
		// enclosing compound ends.
		internal def statements(into AlsaNode, nested bool) {
			for {
				skipSpace()
				return when at >= text.len()
				let c = text[at]
				if c := '}' || ']' {
					at += 1 when nested
					return when nested
					// A stray closing bracket at the top is passed over.
					at += 1
					continue
				}
				if c := ',' || ';' {
					at += 1
					continue
				}
				if c == '<' {
					include(into)
					continue
				}
				let key = word()
				if key == "" {
					// Something no statement starts with: skip it.
					at += 1
					continue
				}
				skipSpace()
				if at < text.len() && text[at] == '=' {
					at += 1
					skipSpace()
				}
				assign(into, key)
			}
		}

		// Reads the value of the key and puts it in place along the key's path.
		internal def assign(into AlsaNode, key string) {
			let parts = key.split(".")
			let parent = into
			for let (i, raw) in parts {
				let (name, mode) = modeOf(raw)
				let last = i == parts.len() - 1
				let existing = parent.child(name)
				if mode == AlsaMerge.Replace && !(existing is none) {
					parent.remove(name)
					existing = none
				}
				let target AlsaNode = new AlsaNode(name)
				let attached = true
				if existing is none {
					attached = mode != AlsaMerge.Existing
				} else {
					target = existing
					attached = mode != AlsaMerge.Keep
				}
				if !last {
					if !attached {
						// The rest of the statement goes nowhere.
						value(new AlsaNode(name))
						return
					}
					if existing is none {
						parent.children.push(target)
					} else if !target.isCompound() {
						target.value = none
					}
					parent = target
					continue
				}
				if !attached {
					value(new AlsaNode(name))
					return
				}
				parent.children.push(target) when existing is none
				value(target)
			}
		}

		// Reads a value into the node: a compound, an array or a leaf.
		internal def value(node AlsaNode) {
			skipSpace()
			return when at >= text.len()
			let c = text[at]
			if c == '{' {
				at += 1
				node.value = none
				node.array = false
				statements(node, true)
				return
			}
			if c == '[' {
				at += 1
				node.value = none
				node.array = true
				node.children = AlsaNode[]
				let index = 0
				for {
					skipSpace()
					break when at >= text.len()
					if text[at] == ']' {
						at += 1
						break
					}
					if text[at] := ',' || ';' {
						at += 1
						continue
					}
					let element = new AlsaNode("{index}")
					node.children.push(element)
					value(element)
					index += 1
				}
				return
			}
			node.children = AlsaNode[]
			node.value = word()
		}

		// `<file>`: reads the file into the node.
		internal def include(into AlsaNode) {
			at += 1
			let start = at
			for at < text.len() && text[at] != '>' {
				at += 1
			}
			let name = text[start:at]
			at += 1 when at < text.len()
			let path = name.startsWith("confdir:") ?? (dataDir + "/" + name[8:], name)
			load(expandHome(path), into)
		}

		// A key or a value: a quoted string, or a run of characters up to a
		// space or a bracket.
		internal def word() string {
			return "" when at >= text.len()
			let quote = text[at]
			if quote := '"' || '\'' {
				at += 1
				let out = ""
				for at < text.len() && text[at] != quote {
					let c = text[at]
					if c == '\\' && at + 1 < text.len() {
						at += 1
						let e = text[at]
						out += e == 'n' ?? ("\n", e == 't' ?? ("\t", "{e}"))
					} else {
						out += "{c}"
					}
					at += 1
				}
				at += 1 when at < text.len()
				return out
			}
			let start = at
			for at < text.len() && !isBreak(text[at]) {
				at += 1
			}
			return text[start:at]
		}

		// Whether the character ends an unquoted word.
		internal def isBreak(c char) bool {
			return c.isSpace() || (c := '{' || '}' || '[' || ']' || ',' || ';' || '=' || '#' || '"' || '\'')
		}

		// Passes over spaces and `#` comments.
		internal def skipSpace() {
			for at < text.len() {
				let c = text[at]
				if c.isSpace() {
					at += 1
				} else if c == '#' {
					for at < text.len() && text[at] != '\n' {
						at += 1
					}
				} else {
					return
				}
			}
		}
	}

	// A key without its merge prefix, and the merge it asks for.
	def modeOf(raw string) (string, AlsaMerge) {
		return (raw, AlsaMerge.Create) when raw == ""
		let c = raw[0]
		return (raw[1:], AlsaMerge.Replace) when c == '!'
		return (raw[1:], AlsaMerge.Keep) when c == '?'
		return (raw[1:], AlsaMerge.Existing) when c == '-'
		return (raw[1:], AlsaMerge.Create) when c == '+'
		return (raw, AlsaMerge.Create)
	}

	// The path with a leading `~` as the home directory.
	def expandHome(path string) string {
		return path unless path.startsWith("~")
		let home = __env_get("HOME")
		return path when home is none
		let dir string = home
		return dir + path[1:]
	}

	// The configuration as alsa-lib reads it: `alsa.conf`, then the files
	// its top-level and `cards` hooks load.
	def alsaConfig() AlsaNode {
		let dir = __env_get("ALSA_CONFIG_DIR")
		let dataDir = dir is none ?? ("/usr/share/alsa", string(dir))
		let path = __env_get("ALSA_CONFIG_PATH")
		let root = new AlsaNode("")
		let reader = new AlsaConfigReader(dataDir)
		reader.load(path is none ?? (dataDir + "/alsa.conf", string(path)), root)
		runHooks(root, root, reader, dataDir)
		let cards = root.child("cards")
		runHooks(root, cards, reader, dataDir) unless cards is none
		return root
	}

	// Loads the files a compound's `@hooks` name (`func load`) into it, and
	// drops the hooks. Hooks of another kind (`load_for_all_cards`, which
	// reads card-specific definitions) are left out.
	def runHooks(root AlsaNode, node AlsaNode, reader AlsaConfigReader, dataDir string) {
		let hooks = node.child("@hooks")
		return when hooks is none
		let list AlsaNode = hooks
		node.remove("@hooks")
		for let (_, hook) in list.children {
			let kind = leafOf(root, hook.child("func"), map<string, string>{}, dataDir)
			continue unless kind == "load"
			let files = hook.child("files")
			continue when files is none
			let names AlsaNode = files
			for let (_, file) in names.children {
				let named = leafOf(root, file, map<string, string>{}, dataDir)
				for let (_, choice) in named.split("|||") {
					let path = expandHome(choice)
					// A name that is not there is passed over, as alsa-lib's
					// hooks with `errors false` do.
					let info = Storage.stat(path) onerror (err error) {
						continue
					}
					if info.isDir {
						let entries = Storage.readDir(path) onerror (err error) {
							break
						}
						let confs string[]
						for let (_, entry) in entries {
							confs.push(entry.path) when entry.path.endsWith(".conf") && !entry.info.isDir
						}
						confs.sort((a, b) => a < b)
						for let (_, conf) in confs {
							reader.load(conf, node)
						}
						break
					}
					reader.load(path, node)
					break
				}
			}
		}
	}

	// The string a node stands for: a leaf's value with `$NAME` arguments
	// put in, or what a function compound evaluates to; "" for anything else.
	def leafOf(root AlsaNode, node ?AlsaNode, args map<string, string>, dataDir string) string {
		let evaluated = evaluate(root, node, args, dataDir)
		return "" when evaluated is none
		let found AlsaNode = evaluated
		let value = found.value
		return "" when value is none
		let text string = value
		return substitute(text, args)
	}

	// A leaf `$NAME` as the argument's value.
	def substitute(text string, args map<string, string>) string {
		return text unless text.startsWith("$")
		let value = args.get(text[1:])
		return value is none ?? ("", string(value))
	}

	// The node itself, or for a function compound the node it evaluates to;
	// none when the function is unknown and gives no default.
	def evaluate(root AlsaNode, node ?AlsaNode, args map<string, string>, dataDir string) ?AlsaNode {
		return none when node is none
		let given AlsaNode = node
		let fn = given.child("@func")
		return given when fn is none
		let name = leafOf(root, fn, args, dataDir)
		if name := "getenv" || "igetenv" {
			let vars = given.child("vars")
			if !(vars is none) {
				let list AlsaNode = vars
				for let (_, v) in list.children {
					let found = __env_get(leafOf(root, v, args, dataDir))
					if !(found is none) {
						let text string = found
						return leaf(text) when text != ""
					}
				}
			}
			return evaluate(root, given.child("default"), args, dataDir)
		}
		if name == "concat" {
			let strings = given.child("strings")
			return none when strings is none
			let list AlsaNode = strings
			let out = ""
			for let (_, part) in list.children {
				out += leafOf(root, part, args, dataDir)
			}
			return leaf(out)
		}
		if name == "refer" {
			let path = leafOf(root, given.child("name"), args, dataDir)
			let target = path == "" ?? (none, root.find(path))
			return evaluate(root, target, args, dataDir) unless target is none
			return evaluate(root, given.child("default"), args, dataDir)
		}
		return leaf(dataDir) when name == "datadir"
		// card_inum, private_string and the like need the card's own
		// configuration; their default stands in.
		return evaluate(root, given.child("default"), args, dataDir)
	}

	// A leaf holding the text.
	def leaf(text string) AlsaNode {
		let node = new AlsaNode("")
		node.value = text
		return node
	}

	// Where a PCM name rests on a card: the card as the configuration names
	// it (an index or an id such as "Generic") and the device, -1 when the
	// configuration leaves the device open.
	struct AlsaTarget {
		card   string
		device int
	}

	// Where `default` rests for playback or recording, none when the
	// configuration names no card at all.
	def alsaDefault(root AlsaNode, playback bool) ?AlsaTarget {
		let dir = __env_get("ALSA_CONFIG_DIR")
		let dataDir = dir is none ?? ("/usr/share/alsa", string(dir))
		let found = pcmTarget(root, leaf("default"), map<string, string>{}, playback, dataDir, 0)
		return found unless found is none
		// The stock definition: the default card, its default device.
		let stock = pcmTarget(root, leaf("hw"), map<string, string>{}, playback, dataDir, 0)
		return stock
	}

	// A device number, -1 when the text is not one.
	def parseDevice(text string) int {
		for let (_, c) in text {
			return -1 unless c.isDigit()
		}
		return text.toInt<int>(10)
	}

	// How deep PCM definitions may refer to each other before the chain
	// counts as a loop.
	const ALSA_DEPTH = 32

	// Where the PCM a node defines rests: a string names a PCM (`hw:1,0`,
	// `dmixed`, a config path), a compound is a definition with a `type`.
	def pcmTarget(root AlsaNode, node AlsaNode, args map<string, string>, playback bool, dataDir string, depth int) ?AlsaTarget {
		return none when depth > ALSA_DEPTH
		let evaluated = evaluate(root, node, args, dataDir)
		return none when evaluated is none
		let given AlsaNode = evaluated
		let value = given.value
		if !(value is none) {
			let text string = value
			return namedPcm(root, substitute(text, args), playback, dataDir, depth + 1)
		}
		// The arguments were bound where the PCM was named.
		let bound = args
		let kind = leafOf(root, given.child("type"), bound, dataDir)
		if kind == "hw" {
			let card = leafOf(root, given.child("card"), bound, dataDir)
			return none when card == ""
			let device = leafOf(root, given.child("device"), bound, dataDir)
			return AlsaTarget{card: card, device: device == "" ?? (-1, parseDevice(device))}
		}
		if kind == "asym" {
			let side = given.find(playback ?? ("playback.pcm", "capture.pcm"))
			return none when side is none
			return pcmTarget(root, side, bound, playback, dataDir, depth + 1)
		}
		if kind == "multi" {
			let slaves = given.child("slaves")
			return none when slaves is none
			let list AlsaNode = slaves
			for let (_, slave) in list.children {
				let pcm = slave.child("pcm")
				return pcmTarget(root, pcm, bound, playback, dataDir, depth + 1) unless pcm is none
			}
			return none
		}
		// Plugins that pass the sound on to one slave.
		let slave = given.child("slave")
		return none when slave is none
		let next AlsaNode = slave
		let pcm = next.isCompound() ?? (next.child("pcm"), slave)
		return none when pcm is none
		return pcmTarget(root, pcm, bound, playback, dataDir, depth + 1)
	}

	// A PCM by name with arguments (`hw:1,0`, `plughw:CARD=Generic`,
	// `default`): its definition under `pcm`, or a config path the name
	// spells (`cards.pcm.default`).
	def namedPcm(root AlsaNode, text string, playback bool, dataDir string, depth int) ?AlsaTarget {
		let colon = text.indexOf(":")
		let name = colon < 0 ?? (text, text[0:colon])
		let positional string[]
		let keyed = map<string, string>{}
		if colon >= 0 {
			for let (_, part) in text[colon + 1:].split(",") {
				let eq = part.indexOf("=")
				if eq < 0 {
					positional.push(part)
				} else {
					keyed[part[0:eq]] = part[eq + 1:]
				}
			}
		}
		let definition = root.find("pcm." + name)
		definition = root.find(name) when definition is none
		return none when definition is none
		let found AlsaNode = definition
		let value = found.value
		if !(value is none) {
			// An alias: `pcm.default cards.pcm.default`.
			let alias string = value
			return namedPcm(root, alias, playback, dataDir, depth + 1)
		}
		let bound = bindArgs(root, found, map<string, string>{}, keyed, positional, dataDir)
		return pcmTarget(root, found, bound, playback, dataDir, depth + 1)
	}

	// The arguments a definition with `@args` takes: by name, by position,
	// else each one's `@args.NAME.default`; the outer ones when it has none.
	def bindArgs(root AlsaNode, definition AlsaNode, outer map<string, string>, keyed map<string, string>, positional string[], dataDir string) map<string, string> {
		let names = definition.child("@args")
		return outer when names is none
		let list AlsaNode = names
		let out = map<string, string>{}
		// `@args [CARD DEV]` lists the names; `@args.CARD {...}` beside them
		// lands in the same node and is not one.
		let i = -1
		for let (_, name) in list.children {
			continue when name.isCompound() || !name.key.isNumeric()
			i += 1
			let arg = leafOf(root, name, outer, dataDir)
			let given = keyed.get(arg)
			if !(given is none) {
				out[arg] = given
			} else if i < positional.len() && positional[i] != "" {
				out[arg] = positional[i]
			} else {
				out[arg] = leafOf(root, definition.find("@args." + arg + ".default"), outer, dataDir)
			}
		}
		return out
	}
}
