internal partial module std.devices.samples {
	use (
		std.bytes::(Endian)
		std.simd
		std.services.devices::(Device)
		std.devices::*
		std.devices.alsa::*
	)

	// The samples as bytes in the device format, one of the FORMAT_ constants,
	// each scaled by `gain` first. Values outside -1.0..1.0 are clipped.
	def encodeSamples(samples float32[], format int, gain float32 = 1.0) byte[] {
		let out byte[]
		out.len(samples.len() * formatBytes(format))
		encodeInto(samples, format, gain, out, 0)
		return out
	}

	// Encodes the samples as encodeSamples does into `out` from byte `at`,
	// which has room for them: a shared memory block the sound server reads.
	def encodeInto(samples float32[], format int, gain float32, out byte[], at int) {
		let width = formatBytes(format)
		let count = samples.len()
		let low = simd.splat8<float32>(float32(-1.0))
		let high = simd.splat8<float32>(float32(1.0))
		let scale = simd.splat8<float32>(gain)
		let i = 0
		if format == FORMAT_FLOAT_LE {
			for; i + 8 <= count; i += 8 {
				let v = simd.clamp(simd.load8<float32>(samples, i) * scale, low, high)
				simd.store32<byte>(out, at + i * 4, v.bitcast32<byte>())
			}
		} else if format == FORMAT_S16_LE {
			let full = simd.splat8<float32>(float32(32767.0))
			for; i + 8 <= count; i += 8 {
				let v = simd.clamp(simd.load8<float32>(samples, i) * scale, low, high) * full
				simd.store16<byte>(out, at + i * 2, v.convert<int32>().convert<int16>().bitcast16<byte>())
			}
		} else if format == FORMAT_S24_LE {
			// The low three bytes of four, the top one the sign: an int32 as it is.
			let full = simd.splat8<float32>(float32(8388607.0))
			for; i + 8 <= count; i += 8 {
				let v = simd.clamp(simd.load8<float32>(samples, i) * scale, low, high) * full
				simd.store32<byte>(out, at + i * 4, v.convert<int32>().bitcast32<byte>())
			}
		} else if format == FORMAT_S24_3LE {
			// Each int32 loses its top byte; a vector writes 32 bytes of which
			// the next one overwrites the last 8, so it stops 8 bytes early.
			let full = simd.splat8<float32>(float32(8388607.0))
			let packed = simd.load32<byte>(PACK_S24_3LE, 0)
			for; i + 8 <= count && at + i * 3 + 32 <= out.len(); i += 8 {
				let v = simd.clamp(simd.load8<float32>(samples, i) * scale, low, high) * full
				simd.store32<byte>(out, at + i * 3, v.convert<int32>().bitcast32<byte>().shuffle(packed))
			}
		} else if format == FORMAT_S32_LE {
			// float32 cannot hold 2147483647; the product is formed in float64.
			let full = simd.splat8<float64>(float64(2147483647.0))
			for; i + 8 <= count; i += 8 {
				let v = simd.clamp(simd.load8<float32>(samples, i) * scale, low, high).convert<float64>() * full
				simd.store32<byte>(out, at + i * 4, v.convert<int32>().bitcast32<byte>())
			}
		}
		for; i < count; i++ {
			let to = at + i * width
			let s = samples[i] * gain
			if s > 1.0 {
				s = 1.0
			} else if s < -1.0 {
				s = -1.0
			}
			if format == FORMAT_FLOAT_LE {
				let raw = s.bytes(Endian.Little)
				for let k = 0; k < 4; k++ {
					out[to + k] = raw[k]
				}
				continue
			}
			let value = int64(float64(s) * 32767.0)
			if format == FORMAT_S24_LE || format == FORMAT_S24_3LE {
				value = int64(float64(s) * 8388607.0)
			} else if format == FORMAT_S32_LE {
				value = int64(float64(s) * 2147483647.0)
			}
			for let k = 0; k < width; k++ {
				out[to + k] = byte((value >> int64(8 * k)) & 0xFF)
			}
			// 24 bits in a 32-bit slot: the top byte carries the sign.
			out[to + 3] = value < 0 ?? (byte(0xFF), byte(0)) when format == FORMAT_S24_LE
		}
	}

	// The samples in bytes of the device format, one of the FORMAT_ constants,
	// each scaled by `gain`. A trailing partial sample is ignored.
	def decodeSamples(data byte[], format int, gain float32 = 1.0) float32[] {
		let width = formatBytes(format)
		let count = data.len() / width
		let out float32[]
		out.len(count)
		let i = 0
		if format == FORMAT_FLOAT_LE {
			let scale = simd.splat8<float32>(gain)
			for; i + 8 <= count; i += 8 {
				simd.store8<float32>(out, i, simd.load32<byte>(data, i * 4).bitcast8<float32>() * scale)
			}
		} else if format == FORMAT_S16_LE {
			let unit = simd.splat8<float32>(gain / float32(32768.0))
			for; i + 8 <= count; i += 8 {
				let v = simd.load16<byte>(data, i * 2).bitcast8<int16>().convert<int32>()
				simd.store8<float32>(out, i, v.convert<float32>() * unit)
			}
		} else if format == FORMAT_S24_LE || format == FORMAT_S24_3LE {
			// The sample sits in the low three bytes; shifting it to the top
			// and back sign-extends it, whatever the fourth byte holds.
			let unit = simd.splat8<float32>(gain / float32(8388608.0))
			let spread = simd.load32<byte>(SPREAD_S24_3LE, 0)
			let packed = format == FORMAT_S24_3LE
			for; i + 8 <= count && (!packed || i * 3 + 32 <= data.len()); i += 8 {
				let bytes = packed ?? (simd.load32<byte>(data, i * 3).shuffle(spread), simd.load32<byte>(data, i * 4))
				let v = (bytes.bitcast8<int32>() << 8) >> 8
				simd.store8<float32>(out, i, v.convert<float32>() * unit)
			}
		} else if format == FORMAT_S32_LE {
			let unit = simd.splat8<float64>(float64(gain) / 2147483648.0)
			for; i + 8 <= count; i += 8 {
				let v = simd.load32<byte>(data, i * 4).bitcast8<int32>().convert<float64>() * unit
				simd.store8<float32>(out, i, v.convert<float32>())
			}
		}
		for; i < count; i++ {
			let at = i * width
			if format == FORMAT_FLOAT_LE {
				out[i] = float32(0.0).fromBytes(data[at:at + 4], Endian.Little) * gain
				continue
			}
			// S24_LE keeps its sample in the low three bytes of four.
			let bytes = format == FORMAT_S24_LE ?? (3, width)
			let value int64 = 0
			for let k = 0; k < bytes; k++ {
				value = value | (int64(data[at + k]) << int64(8 * k))
			}
			let top int64 = int64(1) << int64(8 * bytes - 1)
			value -= top * 2 when value >= top
			out[i] = float32(float64(value) / float64(top) * float64(gain))
		}
		return out
	}

	// The factor a stream's samples are scaled by for a volume on the
	// desktop mixer's scale (1.0 full): its cube, as the sound server
	// scales them, so a level sounds the same through either.
	def volumeGain(level float) float32 {
		return float32(level * level * level)
	}

	// Byte lanes taking eight little-endian int32s to eight packed 24-bit
	// samples; the last eight lanes are don't-cares.
	internal const PACK_S24_3LE = byte[0, 1, 2, 4, 5, 6, 8, 9, 10, 12, 13, 14, 16, 17, 18, 20, 21, 22, 24, 25, 26, 28, 29, 30, 0, 0, 0, 0, 0, 0, 0, 0]
	// Byte lanes taking eight packed 24-bit samples to the low three bytes of
	// eight int32s; the top byte of each is shifted out.
	internal const SPREAD_S24_3LE = byte[0, 1, 2, 2, 3, 4, 5, 5, 6, 7, 8, 8, 9, 10, 11, 11, 12, 13, 14, 14, 15, 16, 17, 17, 18, 19, 20, 20, 21, 22, 23, 23]

	// Where a speaker's sound goes: straight to the hardware, or to a sound
	// server. Samples arrive at the speaker's own rate and channel count.
	interface PlaybackBackend {
		// Queues the frames, waiting while there is no room.
		def write(samples float32[]) !none
		// Returns once everything queued has been heard.
		def drain() !none
		// The stream's own volume, 1.0 full.
		def volume() !float
		// Sets the stream's own volume.
		def volume(level float) !none
		// Whether the stream itself is muted.
		def muted() !bool
		// Mutes or unmutes the stream itself.
		def mute(on bool) !none
		// The device the sound goes to now when that changed since the last
		// call, else none.
		def moved() ?Device
		// Stops at once and lets the device go.
		def close()
	}

	// Where a microphone's sound comes from, at the microphone's own rate and
	// channel count.
	interface CaptureBackend {
		// The next whole frames recorded, waiting for some.
		def read() !float32[]
		// The stream's own volume, 1.0 full.
		def volume() !float
		// Sets the stream's own volume.
		def volume(level float) !none
		// Whether the stream itself is muted.
		def muted() !bool
		// Mutes or unmutes the stream itself.
		def mute(on bool) !none
		// The device the sound comes from now when that changed since the
		// last call, else none.
		def moved() ?Device
		// Stops recording and lets the device go.
		def close()
	}
}
