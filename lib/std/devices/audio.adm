partial module std.devices {
	use (
		std.bytes::(Endian)
	)

	// The samples as bytes in the device format, one of the FORMAT_ constants.
	// Values outside -1.0..1.0 are clipped.
	internal def encodeSamples(samples float32[], format int) byte[] {
		let width = formatBytes(format)
		let out byte[]
		out.len(samples.len() * width)
		for let i = 0; i < samples.len(); i++ {
			let at = i * width
			let s = samples[i]
			if s > 1.0 {
				s = 1.0
			} else if s < -1.0 {
				s = -1.0
			}
			if format == FORMAT_FLOAT_LE {
				let raw = s.bytes(Endian.Little)
				for let k = 0; k < 4; k++ {
					out[at + k] = raw[k]
				}
				continue
			}
			let value = int64(float64(s) * 32767.0)
			if format == FORMAT_S24_LE || format == FORMAT_S24_3LE {
				value = int64(float64(s) * 8388607.0)
			} else if format == FORMAT_S32_LE {
				value = int64(float64(s) * 2147483647.0)
			}
			for let k = 0; k < width; k++ {
				out[at + k] = byte((value >> int64(8 * k)) & 0xFF)
			}
			// 24 bits in a 32-bit slot: the top byte carries the sign.
			out[at + 3] = value < 0 ?? (byte(0xFF), byte(0)) when format == FORMAT_S24_LE
		}
		return out
	}

	// The samples in bytes of the device format, one of the FORMAT_ constants.
	// A trailing partial sample is ignored.
	internal def decodeSamples(data byte[], format int) float32[] {
		let width = formatBytes(format)
		let count = data.len() / width
		let out float32[]
		out.len(count)
		for let i = 0; i < count; i++ {
			let at = i * width
			if format == FORMAT_FLOAT_LE {
				out[i] = float32(0.0).fromBytes(data[at:at + 4], Endian.Little)
				continue
			}
			// S24_LE keeps its sample in the low three bytes of four.
			let bytes = format == FORMAT_S24_LE ?? (3, width)
			let value int64 = 0
			for let k = 0; k < bytes; k++ {
				value = value | (int64(data[at + k]) << int64(8 * k))
			}
			let top int64 = int64(1) << int64(8 * bytes - 1)
			value -= top * 2 when value >= top
			out[i] = float32(float64(value) / float64(top))
		}
		return out
	}
	// Where a speaker's sound goes: straight to the hardware, or to a sound
	// server. Samples arrive at the speaker's own rate and channel count.
	internal interface PlaybackBackend {
		// Queues the frames, waiting while there is no room.
		def write(samples float32[]) !none
		// Returns once everything queued has been heard.
		def drain() !none
		// Stops at once and lets the device go.
		def close()
	}

	// Where a microphone's sound comes from, at the microphone's own rate and
	// channel count.
	internal interface CaptureBackend {
		// The next whole frames recorded, waiting for some.
		def read() !float32[]
		// Stops recording and lets the device go.
		def close()
	}
}
