partial module std.devices {
	use (
		std.bytes::(Endian)
		std.math
		std.os
		std.services.devices::(Device, DeviceKind)
		std.testing
		std.time
		std.devices.alsa::*
		std.devices.v4l2::*
		std.devices.pulse::*
		std.devices.samples::*
		std.devices.structs::*
	)

	check "ALSA structures" {
		// A block that allows everything has every access and format bit set and
		// every interval open from 0 to the top.
		@test()
		def TestAnyParamsAllowsEverything() {
			let params = anyParams()
			assert params.len() == HW_PARAMS_SIZE
			assert maskHas(params, PARAM_ACCESS, ACCESS_RW_INTERLEAVED)
			assert maskHas(params, PARAM_FORMAT, FORMAT_S24_3LE)
			assert intervalMin(params, PARAM_RATE) == 0
			assert intervalMax(params, PARAM_RATE) == 0xFFFFFFFF
			assert u32(params, HW_RMASK) == 0xFFFFFFFF
		}

		// Narrowing a mask leaves the one value; narrowing an interval sets both ends.
		@test()
		def TestNarrowing() {
			let params = anyParams()
			maskOnly(params, PARAM_FORMAT, FORMAT_S24_3LE)
			assert maskHas(params, PARAM_FORMAT, FORMAT_S24_3LE)
			assert !maskHas(params, PARAM_FORMAT, FORMAT_S16_LE)
			assert maskFirst(params, PARAM_FORMAT) == FORMAT_S24_3LE
			// The access mask next door is untouched.
			assert maskHas(params, PARAM_ACCESS, ACCESS_RW_INTERLEAVED)

			intervalSet(params, PARAM_CHANNELS, 2, 2)
			assert intervalMin(params, PARAM_CHANNELS) == 2
			assert intervalMax(params, PARAM_CHANNELS) == 2
			assert intervalMin(params, PARAM_RATE) == 0
		}

		// A 64-bit field splits into two little-endian words.
		@test()
		def TestU64RoundTrip() {
			let buf = zeroed(16)
			putU64(buf, 8, int64(0x123456789A))
			assert u64(buf, 8) == int64(0x123456789A)
			assert u32(buf, 8) == 0x3456789A
			assert u32(buf, 12) == 0x12
		}

		// The decibel descriptions cards give: a scale with a step, a min-max
		// range with silence at the bottom, and ranges of either.
		@test()
		def TestDecibelScales() {
			// -64.00 dB in steps of 0.75 dB over 0..87 (the HDA "Master"), mute at 0.
			let step = new DecibelScale(0, 87, [TLV_DB_SCALE, 8, -6400 + 0x100000000, 75 | TLV_DB_SCALE_MUTE])
			assert step.decibels(0) == DB_SILENT && step.decibels(1) == -6325 && step.decibels(87) == 125
			assert step.value(-3325) == 41 && step.value(-3326) == 40 && step.value(10000) == 87
			let minmax = new DecibelScale(0, 100, [TLV_DB_MINMAX_MUTE, 8, -5000 + 0x100000000, 0])
			assert minmax.decibels(0) == DB_SILENT && minmax.decibels(50) == -2500 && minmax.loudest() == 0
			let ranged = new DecibelScale(0, 20, [TLV_DB_RANGE, 40, 0, 9, TLV_DB_SCALE, 8, -3000 + 0x100000000, 100, 10, 20, TLV_DB_SCALE, 8, -2000 + 0x100000000, 200])
			assert ranged.decibels(9) == -2100 && ranged.decibels(10) == -2000 && ranged.decibels(20) == 0
			let wrapped = new DecibelScale(0, 87, [TLV_CONTAINER, 16, TLV_DB_SCALE, 8, -6400 + 0x100000000, 75])
			assert wrapped.decibels(87) == 125
		}

		// A level's cube is the amplitude, full at 0 dB, the same in both
		// directions; without decibels a level is the share of the range.
		@test()
		def TestMixerLevels() {
			let element = MixerElement{numid: 1, name: "Master Playback Volume", index: 0, kind: CTL_TYPE_INTEGER, count: 2, min: 0, max: 87, access: 0}
			let scale ?DecibelScale = new DecibelScale(0, 87, [TLV_DB_SCALE, 8, -6400 + 0x100000000, 75])
			let half = mixerValue(scale, element, 0.5)
			let back = mixerLevel(scale, element, half)
			assert back <= 0.5 && back > 0.47
			assert mixerValue(scale, element, 0.0) == 0
			// Full is 0 dB; this scale passes it between two values and takes the lower.
			let full = mixerLevel(scale, element, mixerValue(scale, element, 1.0))
			assert full > 0.99 && full <= 1.0
			let plain ?DecibelScale = none
			assert mixerValue(plain, element, 0.5) == 44 && mixerLevel(plain, element, 87) == 1.0
		}

		// The usual names win over the first volume, and the switch is the
		// one of the same name.
		@test()
		def TestSoundControlChoice() {
			let elements = [
				MixerElement{numid: 1, name: "Front Mic Capture Volume", index: 0, kind: CTL_TYPE_INTEGER, count: 1, min: 0, max: 31, access: 0},
				MixerElement{numid: 2, name: "Speaker Playback Volume", index: 0, kind: CTL_TYPE_INTEGER, count: 2, min: 0, max: 87, access: 0},
				MixerElement{numid: 3, name: "Speaker Playback Switch", index: 0, kind: CTL_TYPE_BOOLEAN, count: 2, min: 0, max: 1, access: 0},
				MixerElement{numid: 4, name: "Master Playback Volume", index: 0, kind: CTL_TYPE_INTEGER, count: 2, min: 0, max: 87, access: 0},
				MixerElement{numid: 5, name: "Capture Switch", index: 0, kind: CTL_TYPE_BOOLEAN, count: 1, min: 0, max: 1, access: 0},
			]
			let (volume, toggle) = soundControls(elements, true)
			assert numid(volume) == 4
			// Master has no switch of its own here; Speaker's is not its.
			assert toggle is none
			let (speaker, speakerToggle) = soundControls(elements.filter(e => e.numid != 4), true)
			assert numid(speaker) == 2 && numid(speakerToggle) == 3
			let (input, inputToggle) = soundControls(elements, false)
			assert numid(input) == 1
			assert inputToggle is none
		}

		// The element's number, -1 for none.
		internal def numid(element ?MixerElement) int {
			return -1 when element is none
			let found MixerElement = element
			return found.numid
		}

		@test()
		def TestFormatBytes() {
			assert formatBytes(FORMAT_S16_LE) == 2
			assert formatBytes(FORMAT_S24_3LE) == 3
			assert formatBytes(FORMAT_S24_LE) == 4
			assert formatBytes(FORMAT_S32_LE) == 4
			assert formatBytes(FORMAT_FLOAT_LE) == 4
		}
	}

	check "Sample conversion" {
		// Every device format carries a sample there and back within its
		// resolution, and clips what lies outside -1.0..1.0.
		@test()
		def TestEncodeDecodeRoundTrip() {
			let samples float32[] = [0.0, 0.5, -0.5, 0.999, -1.0]
			for let (_, format) in [FORMAT_S16_LE, FORMAT_S24_3LE, FORMAT_S24_LE, FORMAT_S32_LE, FORMAT_FLOAT_LE] {
				let data = encodeSamples(samples, format)
				assert data.len() == samples.len() * formatBytes(format)
				let back = decodeSamples(data, format)
				assert back.len() == samples.len()
				for let (i, sample) in samples {
					let diff = back[i] - sample
					assert diff < 0.001 && diff > -0.001
				}
			}
			let clipped = decodeSamples(encodeSamples([2.0, -3.0], FORMAT_S16_LE), FORMAT_S16_LE)
			assert clipped[0] > 0.999
			assert clipped[1] < -0.999
		}

		// Long runs go through vectors and the rest one sample at a time; both
		// give the same bytes and samples as converting each sample alone.
		@test()
		def TestVectorsMatchOneAtATime() {
			let samples float32[]
			for let i = 0; i < 37; i++ {
				samples.push(float32(i - 18) / 16.0)
			}
			for let (_, format) in [FORMAT_S16_LE, FORMAT_S24_3LE, FORMAT_S24_LE, FORMAT_S32_LE, FORMAT_FLOAT_LE] {
				let width = formatBytes(format)
				let data = encodeSamples(samples, format, 0.75)
				let back = decodeSamples(data, format)
				for let (i, sample) in samples {
					let one = encodeSamples([sample], format, 0.75)
					for let k = 0; k < width; k++ {
						assert data[i * width + k] == one[k]
					}
					assert back[i] == decodeSamples(one, format)[0]
				}
			}
		}

		// The gain scales before clipping.
		@test()
		def TestGainScalesThenClips() {
			let samples float32[]
			samples.len(16)
			samples.fill(float32(0.8))
			let back = decodeSamples(encodeSamples(samples, FORMAT_FLOAT_LE, 0.5), FORMAT_FLOAT_LE)
			assert back[0] == float32(0.4) && back[15] == float32(0.4)
			back = decodeSamples(encodeSamples(samples, FORMAT_FLOAT_LE, 2.0), FORMAT_FLOAT_LE)
			assert back[0] == float32(1.0) && back[15] == float32(1.0)
		}

		// A negative 16-bit sample is two's complement, low byte first.
		@test()
		def TestS16Layout() {
			let data = encodeSamples([-1.0], FORMAT_S16_LE)
			assert int(data[0]) == 0x01
			assert int(data[1]) == 0x80
		}

		// A trailing partial sample is dropped.
		@test()
		def TestDecodeIgnoresPartialSample() {
			assert decodeSamples([0x00, 0x40, 0x00], FORMAT_S16_LE).len() == 1
		}
	}

	check "ALSA configuration" {
		// The stock definitions of alsa.conf: `default` is an alias to the
		// card's default, which with no card-specific one is the plug of `hw`
		// on `defaults.pcm.card`.
		internal def stock(extra string) AlsaNode {
			let root = new AlsaNode("")
			let reader = new AlsaConfigReader("/nowhere")
			reader.read(STOCK_ALSA, root)
			reader.read(extra, root)
			let cards = new AlsaNode("cards")
			root.children.push(cards)
			reader.read(STOCK_CARD_DEFAULT, cards)
			return root
		}

		internal def target(root AlsaNode, playback bool = true) AlsaTarget {
			let found = alsaDefault(root, playback)
			assert !(found is none)
			return AlsaTarget{card: "", device: -2} when found is none
			let t AlsaTarget = found
			return t
		}

		@test()
		def TestStockDefaultIsTheDefaultCard() {
			let t = target(stock(""))
			assert t.card == "0" && t.device == -1
			let moved = target(stock(`defaults.pcm.card 2
defaults.pcm.device 1`))
			assert moved.card == "2"
		}

		// `!` replaces the stock alias with a definition of the user's own.
		@test()
		def TestOverridingDefault() {
			let plain = target(stock(`pcm.!default {
	type hw
	card 1
	device 3
}`))
			assert plain.card == "1" && plain.device == 3
			let named = target(stock(`pcm.!default "plughw:Generic,2"`))
			assert named.card == "Generic" && named.device == 2
			let keyed = target(stock(`pcm.!default { type plug; slave.pcm "hw:CARD=USB,DEV=1" }`))
			assert keyed.card == "USB" && keyed.device == 1
		}

		// A chain of plugins ends on its hardware; asym picks by direction.
		@test()
		def TestFollowingSlaves() {
			let config = `pcm.!default { type asym playback.pcm "mixed" capture.pcm "snooped" }
pcm.mixed {
	type dmix
	ipc_key 1024
	slave { pcm "hw:1,0" rate 48000 }
}
pcm.snooped { type dsnoop, slave.pcm 'hw:2' }`
			let out = target(stock(config), true)
			assert out.card == "1" && out.device == 0
			let input = target(stock(config), false)
			assert input.card == "2" && input.device == 0
		}

		// A default resting on a sound server falls back to the default card.
		@test()
		def TestServerDefaultFallsBack() {
			let t = target(stock(`pcm.!default { type pipewire playback_node "-1" }
defaults.pcm.card 3`))
			assert t.card == "3"
		}

		// `?` keeps a value already set, a plain key merges into a compound,
		// `-` changes only what exists.
		@test()
		def TestMergeModes() {
			let root = new AlsaNode("")
			let reader = new AlsaConfigReader("/nowhere")
			reader.read(`a.b 1
a { c 2 }
?a.b 3
# a comment
a.d 'quoted value'`, root)
			let a = root.child("a")
			assert !(a is none)
			return when a is none
			let node AlsaNode = a
			assert node.children.len() == 3
			assert leafOf(root, root.find("a.b"), map<string, string>{}, "") == "1"
			assert leafOf(root, root.find("a.d"), map<string, string>{}, "") == "quoted value"
			reader.read(`-a.e 4
-x.y 5`, root)
			assert !(root.find("a.e") is none)
			assert root.find("x") is none
		}
	}

	check "Sound server protocol" {
		// Every value the client writes reads back through the reader, in order.
		@test()
		def TestTagsRoundTrip() !none {
			let properties map<string, string>
			properties["media.name"] = "tone"
			let tags = new PulseTags()
			tags.u32(7).u32(PULSE_NO_INDEX).u8(3).flag(true).flag(false)
			tags.text("sink").text("").arbitrary([1, 2, 3])
			tags.sampleSpec(44100, 2).channelMap(2).fullVolume(2).properties(properties)

			let reader = new PulseReader(tags.bytes)
			assert try reader.u32() == 7
			assert try reader.u32() == -1
			assert try reader.u8() == 3
			try reader.skip(2)
			assert try reader.text() == "sink"
			assert try reader.text() == ""
			// arbitrary, sample spec, channel map, volume
			try reader.skip(4)
			let back = try reader.properties()
			assert property(back, "media.name") == "tone"
			assert !reader.more()
			return none
		}

		// A 32-bit word is big-endian behind its tag byte.
		@test()
		def TestTagLayout() {
			let tags = new PulseTags()
			tags.u32(0x01020304)
			assert tags.bytes.len() == 5
			assert int(tags.bytes[0]) == TAG_U32
			assert int(tags.bytes[1]) == 0x01
			assert int(tags.bytes[4]) == 0x04
		}

		// Reading past the end, or the wrong type, fails instead of guessing.
		@test()
		def TestReaderRefusesBadData() {
			let short = new PulseReader([byte(TAG_U32), 0, 0])
			let failed = false
			short.u32() onerror (err error) {
				failed = true
				recover 0
			}
			assert failed

			let wrong = new PulseReader([byte(TAG_TRUE)])
			failed = false
			wrong.text() onerror (err error) {
				failed = true
				recover ""
			}
			assert failed
		}

		@test()
		def TestChannelPositions() {
			let mono = channelPositions(1)
			assert mono.len() == 1 && mono[0] == POSITION_MONO
			let stereo = channelPositions(2)
			assert stereo.len() == 2 && stereo[0] == POSITION_FRONT_LEFT && stereo[1] == POSITION_FRONT_RIGHT
			assert channelPositions(6).len() == 6
			assert channelPositions(12).len() == 8
		}

		// A sink's properties fill in the device: its ALSA node, bus and USB ids.
		@test()
		def TestServerDevice() {
			let properties map<string, string>
			properties["alsa.card"] = "4"
			properties["alsa.device"] = "0"
			properties["device.bus"] = "usb"
			properties["device.vendor.id"] = "0x0bda"
			properties["device.product.id"] = "4014"
			let speaker = pulseDevice(DeviceKind.Speaker, "alsa_output.usb", "USB Audio Speakers", properties, true)
			assert speaker.id == "pulse:alsa_output.usb"
			assert speaker.name == "USB Audio Speakers"
			assert speaker.node == "/dev/snd/pcmC4D0p"
			assert speaker.bus == "usb"
			assert speaker.vendorId == 0x0bda
			assert speaker.productId == 0x4014
			assert speaker.isDefault

			let nothing map<string, string>
			let bluetooth = pulseDevice(DeviceKind.Microphone, "bluez_input", "", nothing, false)
			assert bluetooth.name == "bluez_input"
			assert bluetooth.node == ""
			assert !bluetooth.isDefault
		}
	}

	check "Sound server notices" {
		// A connection to a server this test plays itself, over a Unix socket
		// in the temporary directory, and that server's end.
		internal def serverPair() !(PulseConnection, int) {
			let path = os.join(os.tempDir(), "adm-pulse-{time.now().unixNs()}.sock")
			let listener = try __net_socket(1, 1)
			try __net_bind(listener, path)
			try __net_listen(listener, 1)
			let client = try __net_socket(1, 1)
			try __net_connect(client, path, 2s)
			let server = try __net_accept(listener)
			try __net_close(listener)
			try os.remove(path)
			return (new PulseConnection(client), server)
		}

		// What the server sends unasked lands where the streams look for it,
		// in one catch-up that does not wait.
		// The client speaks to a server only on Linux (pulseSocketPath), and
		// only there does the test's Unix socket come and go freely.
		@os("linux")
		@test()
		def TestUnaskedPacketsAreNoted() !none {
			let (connection, fd) = try serverPair()
			defer connection.close()
			let server = new PulseConnection(fd)
			defer server.close()
			let request = new PulseTags()
			request.u32(PULSE_REQUEST).u32(PULSE_NO_INDEX).u32(0).u32(4096)
			let moved = new PulseTags()
			moved.u32(PULSE_PLAYBACK_STREAM_MOVED).u32(PULSE_NO_INDEX).u32(0).u32(3).text("second").flag(false)
			let event = new PulseTags()
			event.u32(PULSE_SUBSCRIBE_EVENT).u32(PULSE_NO_INDEX).u32(EVENT_CHANGE | EVENT_SINK).u32(5)
			for let (_, packet) in [request, moved, event] {
				try server.send(PULSE_CONTROL, packet.bytes)
			}
			try server.send(0, [1, 2, 3, 4])
			// Let the last packet arrive before looking without waiting.
			let first = try connection.receive()
			assert first is none
			time.sleep(20ms)
			try connection.catchUp()
			assert connection.requested == 4096
			assert connection.movedTo == "second"
			assert connection.events.len() == 1
			let (kind, index) = connection.events[0]
			assert kind == EVENT_CHANGE | EVENT_SINK && index == 5
			assert connection.received.len() == 4
			assert !connection.killed
			let killed = new PulseTags()
			killed.u32(PULSE_PLAYBACK_STREAM_KILLED).u32(PULSE_NO_INDEX).u32(0)
			try server.send(PULSE_CONTROL, killed.bytes)
			let _ = try connection.receive()
			assert connection.killed
			return none
		}

		// A block of a memfd pool the server registered is copied out of the
		// pool and handed back; a block of this side's the server lets go of
		// is noted; the ring buffer of a channel not taken up is not audio.
		@os("linux")
		@test()
		def TestSharedBlocks() !none {
			let (connection, fd) = try serverPair()
			defer connection.close()
			let server = new PulseConnection(fd)
			defer server.close()
			let pool = try __fs_memory_file("adm-test-pool")
			defer __fs_close(pool)
			try __fs_ftruncate(pool, int64(4096))
			let handle = try __mem_map(pool, 0, 4096, 1)
			defer __mem_unmap(handle)
			try __mem_map_write(handle, 100, [1, 2, 3, 4, 5, 6, 7, 8])
			let register = new PulseTags()
			register.u32(42)
			try server.sendWithDescriptor(PULSE_REGISTER_MEMFD_SHMID, register, pool)
			try sendBlockOf(server, 0, 7, 42, 100, 8)
			let _ = try connection.receive()
			let _ = try connection.receive()
			assert connection.received.len() == 8 && int(connection.received[0]) == 1 && int(connection.received[7]) == 8
			// The server's end hears the block let go of.
			let (head, passed) = try server.readHead(2s)
			assert passed < 0
			assert int(uint32(0).fromBytes(head[16:20], Endian.Big)) == FLAG_SHMRELEASE
			assert int(uint32(0).fromBytes(head[8:12], Endian.Big)) == 7

			try server.release(11)
			let _ = try connection.receive()
			assert connection.released.len() == 1 && connection.released[0] == 11

			let ring = new PulseTags()
			ring.u32(PULSE_ENABLE_SRBCHANNEL).u32(12345)
			try server.send(PULSE_CONTROL, ring.bytes)
			try sendBlockOf(server, 0, 8, 42, 0, 64)
			let _ = try connection.receive()
			let _ = try connection.receive()
			assert connection.received.len() == 8
			return none
		}

		// A sink record reads into its device, volume and mute; a source
		// mirroring a sink is marked.
		@test()
		def TestRecordReadsVolumeAndMute() !none {
			let properties map<string, string>
			properties["device.bus"] = "usb"
			for let (_, kind) in [DeviceKind.Speaker, DeviceKind.Microphone] {
				let tags = new PulseTags()
				tags.u32(7).text("out").text("Out").sampleSpec(48000, 2).channelMap(2).u32(PULSE_NO_INDEX)
				tags.bytes.push(byte(TAG_CVOLUME), byte(2))
				tags.raw(0x8000)
				tags.raw(0x4000)
				tags.flag(true).u32(kind == DeviceKind.Speaker ?? (9, 2)).text("out.monitor")
				usec(tags)
				tags.text("driver").u32(0).properties(properties)
				usec(tags)
				tags.bytes.push(byte(TAG_VOLUME))
				tags.raw(PULSE_VOLUME_NORM)
				tags.u32(0).u32(65537).u32(PULSE_NO_INDEX).u32(0).text("").u8(0)
				let endpoint = try pulseRecord(new PulseReader(tags.bytes), kind, "out")
				assert endpoint.index == 7 && endpoint.device.id == "pulse:out" && endpoint.device.isDefault
				assert endpoint.volume == 0.5 && endpoint.muted
				assert endpoint.device.bus == "usb"
				assert endpoint.monitor == (kind == DeviceKind.Microphone)
			}
			return none
		}

		// A level is the server's volume over full, rounded, and clipped to
		// what it takes.
		@test()
		def TestVolumeScale() !none {
			assert pulseVolume(1.0) == PULSE_VOLUME_NORM
			assert pulseVolume(0.5) == 0x8000
			assert pulseVolume(-1.0) == 0
			assert pulseVolume(1e12) == PULSE_VOLUME_MAX
			let tags = new PulseTags()
			tags.volume(0.25)
			let back = new PulseReader(tags.bytes)
			assert try back.volume() == 0.25
			return none
		}

		// Only the volume, mute and description make a change; the default
		// is reported apart, and marking it moves the mark.
		@test()
		def TestChangeBookkeeping() {
			let a = SoundChange{kind: SoundChangeKind.Added, device: Device{id: "pulse:a", kind: DeviceKind.Speaker, name: "A"}, volume: 1.0, muted: false}
			assert !changed(a, SoundChange{...a, device: Device{...a.device, isDefault: true}})
			assert changed(a, SoundChange{...a, volume: 0.5})
			assert changed(a, SoundChange{...a, muted: true})
			assert changed(a, SoundChange{...a, device: Device{...a.device, name: "B"}})
			let known = map<string, SoundChange>{}
			known["sink:1"] = a
			known["sink:2"] = SoundChange{...a, device: Device{...a.device, id: "pulse:b", isDefault: true}}
			known["source:1"] = SoundChange{...a, device: Device{...a.device, id: "pulse:m", kind: DeviceKind.Microphone, isDefault: true}}
			let picked = markDefault(known, DeviceKind.Speaker, "pulse:a")
			assert !(picked is none)
			assert known["sink:1"].device.isDefault && !known["sink:2"].device.isDefault
			assert known["source:1"].device.isDefault
			assert markDefault(known, DeviceKind.Speaker, "pulse:gone") is none
		}

		// Only sound uevents wake the card watch.
		@test()
		def TestSoundUevents() {
			assert soundEvent(uevent(["add@/devices/sound/card5", "ACTION=add", "SUBSYSTEM=sound"]))
			assert !soundEvent(uevent(["add@/devices/usb1", "ACTION=add", "SUBSYSTEM=usb"]))
			assert !soundEvent(byte[])
		}

		// A uevent as the kernel sends it: each field ended by a zero byte.
		internal def uevent(fields string[]) byte[] {
			let out byte[]
			for let (_, field) in fields {
				for let (_, b) in field.bytes() {
					out.push(b)
				}
				out.push(byte(0))
			}
			return out
		}
	}

	// Sends a block reference on the channel as a server does: block, pool,
	// offset and length.
	internal def sendBlockOf(server PulseConnection, channel int, block int, pool int, offset int, length int) !none {
		let packet = new PulseTags()
		packet.raw(SHM_INFO_SIZE)
		packet.raw(channel)
		packet.raw(0)
		packet.raw(0)
		packet.raw(FLAG_SHMDATA | FLAG_SHMDATA_MEMFD_BLOCK)
		packet.raw(block)
		packet.raw(pool)
		packet.raw(offset)
		packet.raw(length)
		return server.writeAll(packet.bytes)
	}

	// A microsecond count, which the tags written here never need but the
	// server's records hold.
	internal def usec(tags PulseTags) {
		tags.bytes.push(byte(TAG_USEC))
		for let k = 0; k < 8; k++ {
			tags.bytes.push(byte(0))
		}
	}

	check "Speakers and microphones" {
		// Exactly one speaker and one microphone are the default, and the
		// default functions name them.
		@test()
		def TestOneDefaultEach() !none {
			let outputs = try speakers()
			if outputs.len() > 0 {
				let marked = outputs.filter(d => d.isDefault)
				assert marked.len() == 1
				assert (try defaultSpeaker()).id == marked[0].id
			}
			let inputs = try microphones()
			if inputs.len() > 0 {
				let marked = inputs.filter(d => d.isDefault)
				assert marked.len() == 1
				assert (try defaultMicrophone()).id == marked[0].id
			}
			return none
		}

		// An empty id opens the default speaker.
		@test()
		def TestEmptyIdOpensTheDefault() !none {
			let outputs = try speakers()
			return none when outputs.len() == 0
			let busy = false
			let speaker = openSpeaker() onerror (err error) {
				fail err unless "{err}".contains("busy")
				busy = true
				recover closedSpeaker()
			}
			return none when busy
			defer speaker.close()
			assert speaker.device.id == (try defaultSpeaker()).id
			return none
		}

		// Opening, writing silence, draining and closing. A machine without a
		// speaker, or one whose sound server holds it, skips.
		@test()
		def TestSpeakerPlaysSilence() !none {
			let found = try speakers()
			return none when found.len() == 0
			let busy = false
			let speaker = openSpeaker(found[0].id, 44100, 1) onerror (err error) {
				fail err unless "{err}".contains("busy")
				busy = true
				recover closedSpeaker()
			}
			return none when busy
			assert speaker.isOpen()
			assert speaker.sampleRate() == 44100
			assert speaker.channels() == 1
			let silence float32[]
			silence.len(4410)
			assert try speaker.write(silence) == 4410
			try speaker.drain()
			speaker.close()
			assert !speaker.isOpen()
			speaker.close()

			let refused = speaker.write(silence) onerror (err error) {
				assert "{err}".contains("closed")
				recover -1
			}
			assert refused == -1
			return none
		}

		// A speaker's own volume and mute change only its own sound: what is
		// set reads back, and a closed speaker refuses both.
		@test()
		def TestSpeakerOwnVolume() !none {
			let found = try speakers()
			return none when found.len() == 0
			let busy = false
			let speaker = openSpeaker() onerror (err error) {
				fail err unless "{err}".contains("busy")
				busy = true
				recover closedSpeaker()
			}
			return none when busy
			try speaker.volume(0.25)
			assert math.approx(try speaker.volume(), 0.25, 0.001)
			try speaker.mute()
			assert try speaker.muted()
			try speaker.unmute()
			assert !(try speaker.muted())
			let _ = speaker.volume(-0.5) onerror (err error) {
				assert "{err}".contains("0.0 or more")
				recover none
			}
			speaker.close()
			let _ = speaker.mute() onerror (err error) {
				assert "{err}".contains("closed")
				recover none
			}
			return none
		}

		// The default speaker's and microphone's volumes read on the same
		// scale as a stream's; a device that is neither is refused.
		@test()
		def TestDeviceVolumeReads() !none {
			let outputs = try speakers()
			if outputs.len() > 0 {
				let speaker = try defaultSpeaker()
				assert try volume(speaker) >= 0.0
				let _ = try muted(speaker)
			}
			let other = Device{id: "usb:9-9", kind: DeviceKind.Usb}
			let failed = false
			volume(other, 0.5) onerror (err error) {
				assert "{err}".contains("not a speaker or microphone")
				failed = true
				recover none
			}
			assert failed
			failed = false
			mute(other) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			failed = false
			unmute(other) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			return none
		}

		// Samples that are not whole frames are refused.
		@test()
		def TestSpeakerRefusesPartialFrames() !none {
			let found = try speakers()
			return none when found.len() == 0
			let busy = false
			let speaker = openSpeaker(found[0].id) onerror (err error) {
				fail err unless "{err}".contains("busy")
				busy = true
				recover closedSpeaker()
			}
			return none when busy
			defer speaker.close()
			let written = speaker.write([0.0, 0.0, 0.0]) onerror (err error) {
				assert "{err}".contains("whole frames")
				recover -1
			}
			assert written == -1
			return none
		}

		// A microphone reads frames at the rate asked for, cannot seek, and reads
		// nothing once closed.
		@test()
		def TestMicrophoneRecords() !none {
			let found = try microphones()
			return none when found.len() == 0
			let busy = false
			let microphone = openMicrophone(found[0].id, 16000, 1) onerror (err error) {
				fail err unless "{err}".contains("busy")
				busy = true
				recover closedMicrophone()
			}
			return none when busy
			let info = microphone.info()
			assert int(info.sampleRate) == 16000
			assert int(info.channels) == 1
			assert !info.seekable

			let clip = try microphone.record(100ms)
			assert clip.samples.len() == 1600
			assert int(clip.info.frames) == 1600

			let refused = false
			microphone.seek(uint64(0)) onerror (err error) {
				refused = true
				recover none
			}
			assert refused

			try microphone.close()
			assert !microphone.isOpen()
			let buf float32[]
			buf.len(16)
			assert try microphone.read(buf) == 0
			try microphone.close()
			return none
		}

		// A speaker id is not a microphone, and a microphone id is not a speaker.
		@test()
		def TestOpeningTheWrongKindFails() !none {
			let outputs = try speakers()
			return none when outputs.len() == 0
			let refused = false
			openMicrophone(outputs[0].id) onerror (err error) {
				assert "{err}".contains("is not a microphone")
				refused = true
				recover closedMicrophone()
			}
			assert refused
			return none
		}
	}

	// A speaker that was never opened, to stand in for one that could not be.
	internal def closedSpeaker() Speaker {
		return new Speaker(Device{}, none, 48000, 1)
	}

	// A microphone that was never opened, to stand in for one that could not be.
	internal def closedMicrophone() Microphone {
		return new Microphone(Device{}, none, 48000, 1)
	}

	// alsa.conf's own definitions the tests rely on, as it writes them.
	internal const STOCK_ALSA = `defaults.pcm.card 0
defaults.pcm.device 0
pcm.hw {
	@args [ CARD DEV SUBDEV ]
	@args.CARD {
		type string
		default {
			@func getenv
			vars [ ALSA_TEST_NO_SUCH_CARD ]
			default { @func refer name defaults.pcm.card }
		}
	}
	@args.DEV {
		type integer
		default {
			@func igetenv
			vars [ ALSA_TEST_NO_SUCH_DEVICE ]
			default { @func refer name defaults.pcm.device }
		}
	}
	@args.SUBDEV { type integer default -1 }
	type hw
	card $CARD
	device $DEV
	subdevice $SUBDEV
}
pcm.plughw {
	@args [ CARD DEV ]
	@args.CARD { type string }
	@args.DEV { type integer default 0 }
	type plug
	slave.pcm {
		type hw
		card $CARD
		device $DEV
	}
}
pcm.default cards.pcm.default`

	// pcm/default.conf, which cards/aliases.conf reads into `cards`.
	internal const STOCK_CARD_DEFAULT = `pcm.!default {
	@args [ CARD ]
	@args.CARD {
		type string
		default {
			@func getenv
			vars [ ALSA_TEST_NO_SUCH_CARD ]
			default { @func refer name defaults.pcm.card }
		}
	}
	type empty
	slave.pcm {
		@func refer
		name { @func concat strings [ "cards." { @func card_inum card $CARD } ".pcm.default:CARD=" $CARD ] }
		default { type plug slave.pcm { type hw card $CARD } }
	}
}`
}
