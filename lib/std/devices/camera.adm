// Capturing from the machine's cameras.
//
// The devices themselves are listed by the `Devices` service; this module drives
// the ones a program can read from, over the kernel's video interface on Linux:
// `cameras()` names them, `openCamera(id)` starts one streaming,
// `Camera.frame()` waits for the next picture, and `toImage(frame)` makes an
// RGBA image of it. A camera lists the formats, sizes and rates it delivers
// (`modes`), and its controls (`controls`, `control`): brightness, exposure,
// focus, white balance and the like.
//
// Example: a snapshot from the first camera
// ```example
// use std.devices
//
// let cam = try devices.openCamera(try devices.cameras()[0].id, 1280, 720)
// defer cam.close()
// let shot = try cam.frame()
// println("{shot.width}x{shot.height}, {shot.data.len()} bytes")
// ```

partial module std.devices {
	use (
		std.formats.image
		std.formats.video
		std.services.storage::(Storage)
		std.services.devices::(Device, DeviceKind, Devices)
		std.devices.v4l2::*
	)

	// How a camera hands frames over.
	enum PixelFormat {
		// Each frame is a complete JPEG.
		Mjpeg,
		// Packed 4:2:2, two bytes a pixel: Y, U, Y, V.
		Yuyv,
		// Packed 4:2:2 in the other order: U, Y, V, Y.
		Uyvy,
		// 4:2:0 as a luma plane, then one plane of interleaved U and V.
		Nv12,
		// 4:2:0 as three planes: luma, then U, then V, each chroma plane at
		// half the width and height.
		Yuv420,
		// Luma only, one byte a pixel, as infrared cameras deliver.
		Grey,
	}

	// One captured frame.
	struct Frame {
		width    int
		height   int
		format   PixelFormat
		// The frame's bytes: a whole JPEG file for Mjpeg, the planes for the
		// others.
		data     byte[]
		// Frames captured so far on this camera, 1 for the first.
		sequence int
		// Bytes from one row of the first plane to the next, which a driver
		// may pad past the pixels; 0 for Mjpeg, or for rows without padding.
		stride   int         = 0
	}

	// One way a camera can deliver frames: a format at a size, and the rates
	// it runs at there.
	struct CameraMode {
		format PixelFormat
		width  int
		height int
		// Frames a second, fastest first.
		rates  float[]
	}

	// What a control's value means.
	enum ControlKind {
		// A number from `minimum` to `maximum` in `step`s.
		Integer,
		// Off (0) or on (1).
		Boolean,
		// One of `choices`, by value.
		Menu,
		// Setting any value performs an action once (a focus trigger, a reset).
		Button,
		// A set of flags, one bit each.
		Bitmask,
	}

	// One control of a camera, as `Camera.controls` reports it.
	struct CameraControl {
		// The driver's name for it: "Brightness", "Exposure Time, Absolute".
		name     string
		kind     ControlKind
		minimum  int
		maximum  int
		step     int
		// The value the driver starts with.
		initial  int
		// The value now; 0 for a button.
		value    int
		// A menu control's choices by value; empty for the other kinds.
		choices  map<int, string>
		// The value can be read but not set.
		readOnly bool
		// Another control's setting makes this one have no effect for now, as
		// automatic exposure does to the exposure time.
		inactive bool
	}

	// An open camera. openCamera returns one; close it when done, or let it go —
	// dispose closes it.
	type Camera {
		// The device the frames come from.
		device Device
		width  int
		height int
		format PixelFormat
		// Frames a second the camera is set to; 0 when the driver does not say.
		rate   float

		// The device's descriptor, -1 once closed.
		internal fd        int                      = -1
		// How many buffers to ask the driver for each time streaming starts.
		internal wanted    int                      = 4
		// One mapping handle per buffer the driver granted, in buffer order.
		internal buffers   int[]
		// Bytes between rows of the first plane, as the driver set it.
		internal stride    int                      = 0
		// Whether the device is filling those buffers.
		internal streaming bool                     = false
		// Frames handed out so far, which is what a frame's sequence reports.
		internal delivered int                      = 0
		// The driver's controls by lower-case name, read when first needed.
		internal known     map<string, ControlInfo> = map<string, ControlInfo>{}
		internal listed    bool                     = false

		// Cameras come from `openCamera`, which negotiates the frame layout
		// before there is anything to construct.
		internal def new(device Device, fd int, layout Format, wanted int) {
			self.device = device
			self.fd = fd
			self.wanted = wanted
			adopt(layout)
		}

		// The formats, sizes and rates this camera can deliver, in the
		// driver's order. A camera that takes any size in a range lists the
		// smallest and the largest. Formats this module cannot hand over (H.264
		// from the camera, Bayer) are left out.
		//
		// Fails when the camera is closed.
		def modes() !CameraMode[] {
			fail "devices: camera {device.id} is closed" when fd < 0
			let out CameraMode[]
			for let (_, code) in enumFormats(fd) {
				let named = pixelFormatOf(code)
				continue when named is none
				let offered PixelFormat = named
				for let (_, size) in enumSizes(fd, code) {
					out.push(CameraMode{format: offered, width: size.width, height: size.height, rates: size.rates})
				}
			}
			return out
		}

		// The camera's controls with their current values.
		//
		// Fails when the camera is closed.
		def controls() !CameraControl[] {
			fail "devices: camera {device.id} is closed" when fd < 0
			let out CameraControl[]
			for let (_, info) in queryControls(fd) {
				let value = 0
				if info.kind != CTRL_TYPE_BUTTON && (info.flags & CTRL_FLAG_WRITE_ONLY) == 0 {
					value = getControl(fd, info.id) onerror recover info.initial
				}
				out.push(CameraControl{
					name:     info.name,
					kind:     controlKind(info.kind),
					minimum:  info.minimum,
					maximum:  info.maximum,
					step:     info.step,
					initial:  info.initial,
					value:    value,
					choices:  info.choices,
					readOnly: (info.flags & CTRL_FLAG_READ_ONLY) != 0,
					inactive: (info.flags & CTRL_FLAG_INACTIVE) != 0,
				})
			}
			return out
		}

		// The value of the control with that name, compared without regard
		// to case.
		//
		// Fails when the camera is closed, has no such control, or the
		// control cannot be read.
		def control(name string) !int {
			let info = try controlNamed(name)
			return getControl(fd, info.id)
		}

		// Sets the control with that name and returns the value the camera
		// kept, which it rounds to the control's step.
		//
		// Fails when the camera is closed, has no such control, the value is
		// outside the control's range, or the control is read-only.
		def control(name string, value int) !int {
			let info = try controlNamed(name)
			fail "devices: {device.id}'s {info.name} is read-only" when (info.flags & CTRL_FLAG_READ_ONLY) != 0
			fail "devices: {device.id}'s {info.name} takes {info.minimum} to {info.maximum}, not {value}" when info.kind != CTRL_TYPE_BUTTON && info.kind != CTRL_TYPE_BITMASK && (value < info.minimum || value > info.maximum)
			return setControl(fd, info.id, value)
		}

		// Changes the size, rate or format, stopping the stream while the
		// driver settles on the new layout and starting it again when it ran.
		// A 0 or none keeps that part as it is; a size or rate the camera
		// does not have becomes the nearest it has.
		//
		// Fails when the camera is closed, does not offer the format, or
		// refuses the layout.
		def configure(width int = 0, height int = 0, rate float = 0.0, format ?PixelFormat = none) !none {
			fail "devices: camera {device.id} is closed" when fd < 0
			let running = streaming
			try stop()
			try freeBuffers(fd)
			let wantFormat = format is none ?? (self.format, format)
			let layout = try negotiate(fd, width > 0 ?? (width, self.width), height > 0 ?? (height, self.height), wantFormat)
			adopt(layout)
			self.rate = try setRate(fd, rate) when rate > 0.0
			try start() when running
			return none
		}

		// Stops the stream and gives the driver's buffers back; `start` begins
		// it again. Frames queued when it stops are dropped. Nothing happens
		// when the camera is not streaming.
		//
		// Fails when the camera is closed or the driver refuses.
		def stop() !none {
			fail "devices: camera {device.id} is closed" when fd < 0
			return none unless streaming
			streaming = false
			try streamOff(fd)
			releaseMappings(buffers)
			buffers = []
			try freeBuffers(fd)
			return none
		}

		// Starts the stream again after `stop` or `configure`. Nothing happens
		// when the camera is streaming.
		//
		// Fails when the camera is closed, the driver grants too few buffers,
		// or it refuses to stream.
		def start() !none {
			fail "devices: camera {device.id} is closed" when fd < 0
			return none when streaming
			let granted = try requestBuffers(fd, wanted)
			fail "devices: {device.id} granted {granted} capture buffers, too few to stream" when granted < 2
			let mapped = try mapBuffers(fd, granted)
			streamOn(fd) onerror (err error) {
				releaseMappings(mapped)
				freeBuffers(fd) onerror recover none
				fail err
			}
			buffers = mapped
			streaming = true
			return none
		}

		// Whether the camera is delivering frames.
		def isStreaming() bool {
			return streaming
		}

		// Captures and drops frameCount frames, the time a sensor takes to settle
		// its exposure and white balance after streaming starts.
		//
		// Fails when frameCount is negative, the camera is closed or stopped, or the driver errors.
		def warmup(frameCount int = 15) !none {
			expects {
				assert frameCount >= 0 onerror fail "devices: cannot warm up with {frameCount} frames"
			}
			for let i = 0; i < frameCount; i++ {
				try frame()
			}
			return none
		}

		// Waits up to timeout for the next frame and returns it.
		//
		// Fails when the camera is closed or stopped, no frame arrives in
		// time, or the driver errors.
		def frame(timeout duration = 5s) !Frame {
			fail "devices: camera {device.id} is closed" when fd < 0
			fail "devices: camera {device.id} is stopped" unless streaming
			let ready = try Storage.wait(fd, timeout)
			fail "devices: camera {device.id} delivered no frame in time" unless ready
			let info = try dequeueBuffer(fd)
			let data = bufferBytes(info) onerror recover []
			// The buffer goes back to the driver whatever the read above did:
			// dropping it would starve the queue one frame at a time.
			try queueBuffer(fd, info.index)
			fail "devices: camera {device.id} delivered an empty frame" when data.len() == 0
			delivered += 1
			return Frame{
				width:    width,
				height:   height,
				format:   format,
				data:     data,
				sequence: delivered,
				stride:   format == PixelFormat.Mjpeg ?? (0, stride),
			}
		}

		// Stops streaming and releases the device. Safe to call twice.
		def close() {
			return when fd < 0
			if streaming {
				streamOff(fd) onerror recover none
				streaming = false
			}
			releaseMappings(buffers)
			buffers = []
			Devices.close(fd) onerror recover none
			fd = -1
		}

		// Whether the camera is still open.
		def isOpen() bool {
			return fd >= 0
		}

		// Closing on dispose, so a camera nobody holds any more frees the device.
		def dispose() {
			close()
		}

		// Takes the layout the driver settled on as this camera's.
		internal def adopt(layout Format) {
			width = layout.width
			height = layout.height
			let named = pixelFormatOf(layout.pixelFormat)
			format = PixelFormat.Mjpeg
			format = named unless named is none
			stride = layout.bytesPerLine
			rate = currentRate(fd)
		}

		// The control with that name, compared without regard to case.
		//
		// Fails when the camera is closed or has no such control.
		internal def controlNamed(name string) !ControlInfo {
			fail "devices: camera {device.id} is closed" when fd < 0
			if !listed {
				for let (_, info) in queryControls(fd) {
					known[info.name.lower()] = info
				}
				listed = true
			}
			let key = name.lower()
			fail "devices: camera {device.id} has no control named {name}" unless known.hasKey(key)
			return known[key]
		}

		// The frame in a buffer the driver has filled, copied out of the mapping.
		//
		// Fails when the buffer is not one of this camera's or its mapping cannot
		// be read.
		internal def bufferBytes(info BufferInfo) !byte[] {
			expects {
				assert info.index >= 0 && info.index < buffers.len() onerror fail "devices: camera {device.id} named buffer {info.index}, which is not mapped"
			}
			let handle = buffers[info.index]
			// A frame never fills more than the buffer holds, whatever the driver
			// reports.
			let mapped = Storage.mmapLength(handle)
			let length = (mapped > 0 && info.bytesUsed > mapped) ?? (mapped, info.bytesUsed)
			return Storage.mmapRead(handle, 0, length)
		}
	}

	// The cameras the machine has.
	//
	// Fails when the policy denies listing the devices.
	def cameras() !Device[] {
		return Devices.list(DeviceKind.Camera)
	}

	// Opens the camera behind the device id for capture. A width, height or
	// rate of 0 keeps the camera's current one, and a size or rate it does not
	// have becomes the nearest it has. Without a format the camera delivers
	// MJPEG when it offers it (full rate at large sizes), else YUYV, NV12,
	// YUV 4:2:0, UYVY or grey, the first it offers. `buffers` is how many
	// frames the driver may hold ready: more absorb a slow reader, fewer
	// keep latency and memory down.
	//
	// Fails when the policy denies the camera (the `camera` permission, and
	// its `device` rules for this id), there is no such camera, it cannot be
	// opened (another program holds it), it does not offer the format, or
	// buffers is below 2.
	@requires("adm.devices.camera")
	def openCamera(id string, width int = 0, height int = 0, rate float = 0.0, format ?PixelFormat = none, buffers int = 4) !Camera {
		expects {
			assert buffers >= 2 onerror fail "devices: a camera streams with 2 buffers or more, not {buffers}"
		}
		try admitDevice("adm.devices.camera", id)
		let (device, fd) = try openKind(id, DeviceKind.Camera, "camera")
		let camera = startCapture(device, fd, width, height, rate, format, buffers) onerror (err error) {
			// Nothing was handed back, so the descriptor is this call's to close.
			Devices.close(fd) onerror recover none
			fail err
		}
		return camera
	}

	// The frame as an RGBA image: a JPEG frame decoded, the others converted
	// from YUV by BT.601 (studio range; grey frames are full range).
	//
	// Fails when a JPEG frame is damaged or the data is shorter than the
	// frame's size.
	def toImage(frame Frame) !image.Image {
		return new image.JPEG().decode(frame.data) when frame.format == PixelFormat.Mjpeg
		return video.toImage(try toVideoFrame(frame))
	}

	// The frame as YUV planes, for video encoders and `video.draw`. A JPEG
	// frame is decoded; the planes of the others are split out of the frame's
	// bytes.
	//
	// Fails when a JPEG frame is damaged or the data is shorter than the
	// frame's size.
	def toVideoFrame(frame Frame) !video.VideoFrame {
		let w = frame.width
		let h = frame.height
		match frame.format {
			case PixelFormat.Mjpeg:
				let pictures = try new video.MJPEG().decode(video.Packet{track: 0, data: frame.data, pts: 0s, dts: 0s, length: 0s, keyframe: true})
				fail "devices: frame {frame.sequence} holds no picture" when pictures.len() == 0
				return pictures[0]
			case PixelFormat.Yuyv, PixelFormat.Uyvy:
				let stride = frame.stride > 0 ?? (frame.stride, 2 * w)
				fail "devices: frame {frame.sequence} has {frame.data.len()} bytes, a {w}x{h} frame has {stride * h}" when frame.data.len() < stride * (h - 1) + 2 * w
				return video.fromPacked(frame.data, w, h, frame.format == PixelFormat.Yuyv ?? (video.PackedLayout.Yuyv, video.PackedLayout.Uyvy), stride)
			case PixelFormat.Nv12:
				let stride = frame.stride > 0 ?? (frame.stride, w)
				let need = stride * (h + (h + 1) / 2)
				fail "devices: frame {frame.sequence} has {frame.data.len()} bytes, a {w}x{h} frame has {need}" when frame.data.len() < need
				return video.fromSemiPlanar(frame.data, w, h, stride)
			case PixelFormat.Yuv420:
				let stride = frame.stride > 0 ?? (frame.stride, w)
				let cs = stride / 2
				let ch = (h + 1) / 2
				let lumaBytes = stride * h
				let need = lumaBytes + 2 * cs * ch
				fail "devices: frame {frame.sequence} has {frame.data.len()} bytes, a {w}x{h} frame has {need}" when frame.data.len() < need
				return video.VideoFrame{width: uint32(w), height: uint32(h), y: frame.data.slice(0, lumaBytes), u: frame.data.slice(lumaBytes, cs * ch), v: frame.data.slice(lumaBytes + cs * ch, cs * ch), yStride: stride, uvStride: cs, time: 0s, length: 0s, keyframe: true, matrix: 601, chroma: video.ChromaLayout.Yuv420}
			case PixelFormat.Grey:
				let stride = frame.stride > 0 ?? (frame.stride, w)
				fail "devices: frame {frame.sequence} has {frame.data.len()} bytes, a {w}x{h} frame has {stride * h}" when frame.data.len() < stride * h
				return video.VideoFrame{width: uint32(w), height: uint32(h), y: frame.data, u: byte[], v: byte[], yStride: stride, uvStride: 0, time: 0s, length: 0s, keyframe: true, matrix: 601, chroma: video.ChromaLayout.Mono, fullRange: true}
		}
		fail "devices: frame {frame.sequence} is in no format this module reads"
	}

	// Negotiates the frame layout on an open device, maps its buffers and starts
	// it streaming.
	//
	// Fails when the device does not capture video, does not offer the
	// format, or refuses to stream.
	internal def startCapture(device Device, fd int, width int, height int, rate float, format ?PixelFormat, buffers int) !Camera {
		let capability = try queryCapabilities(fd)
		let caps = nodeCapabilities(capability)
		fail "devices: {device.id} does not capture video" when (caps & CAP_VIDEO_CAPTURE) == 0
		fail "devices: {device.id} cannot stream" when (caps & CAP_STREAMING) == 0

		let current = try currentFormat(fd)
		let layout = try negotiate(fd, width > 0 ?? (width, current.width), height > 0 ?? (height, current.height), format)
		let camera = new Camera(device, fd, layout, buffers)
		camera.rate = try setRate(fd, rate) when rate > 0.0
		try camera.start()
		return camera
	}

	// Asks the device for a format at that size and returns the layout it
	// settled on. Without a format it takes the first of MJPEG, YUYV, NV12,
	// YUV 4:2:0, UYVY and grey that the device offers. A device substitutes
	// a size it supports rather than refusing, so what came back is the
	// answer.
	//
	// Fails when the device offers none of the formats (or not the one
	// asked for), or refuses the request, as it does while another program
	// holds it.
	internal def negotiate(fd int, width int, height int, format ?PixelFormat) !Format {
		let offered = enumFormats(fd)
		let order = preferredFormats(format)
		for let (_, wanted) in order {
			let code = offeredCode(offered, wanted)
			continue when code == 0
			// A refusal is never about the format (the device offers it); it
			// is the device being busy, held by another program.
			let got = setFormat(fd, Format{width: width, height: height, pixelFormat: code}) onerror (err error) {
				fail "devices: the camera is in use by another program" when "{err}".contains("busy")
				fail err
			}
			return got when isFormat(got.pixelFormat, wanted)
		}
		fail "devices: the camera does not offer {order[0]}" unless format is none
		fail "devices: the camera offers none of MJPEG, YUYV, NV12, YUV 4:2:0, UYVY and grey"
	}

	// The formats to ask for, in order: the one named, else every format
	// this module reads, MJPEG first.
	internal def preferredFormats(format ?PixelFormat) PixelFormat[] {
		return [PixelFormat.Mjpeg, PixelFormat.Yuyv, PixelFormat.Nv12, PixelFormat.Yuv420, PixelFormat.Uyvy, PixelFormat.Grey] when format is none
		let only PixelFormat = format
		return [only]
	}

	// The four character code under which the device offers that format, 0
	// when it does not. A device lists MJPEG frames as "MJPG" or "JPEG".
	internal def offeredCode(offered int[], format PixelFormat) int {
		for let (_, code) in offered {
			return code when isFormat(code, format)
		}
		return 0
	}

	// Whether a four character code names that format.
	internal def isFormat(code int, format PixelFormat) bool {
		let named = pixelFormatOf(code)
		return false when named is none
		let known PixelFormat = named
		return known == format
	}

	// The format a four character code names, none for one this module does
	// not read.
	internal def pixelFormatOf(code int) ?PixelFormat {
		return PixelFormat.Mjpeg when code := PIX_FMT_MJPEG || PIX_FMT_JPEG
		return PixelFormat.Yuyv when code == PIX_FMT_YUYV
		return PixelFormat.Uyvy when code == PIX_FMT_UYVY
		return PixelFormat.Nv12 when code == PIX_FMT_NV12
		return PixelFormat.Yuv420 when code == PIX_FMT_YUV420
		return PixelFormat.Grey when code == PIX_FMT_GREY
		return none
	}

	// The kind a V4L2 control type is; an integer menu is a menu whose
	// choices are numbers.
	internal def controlKind(kind int) ControlKind {
		return ControlKind.Boolean when kind == CTRL_TYPE_BOOLEAN
		return ControlKind.Menu when kind := CTRL_TYPE_MENU || CTRL_TYPE_INTEGER_MENU
		return ControlKind.Button when kind == CTRL_TYPE_BUTTON
		return ControlKind.Bitmask when kind == CTRL_TYPE_BITMASK
		return ControlKind.Integer
	}
}
