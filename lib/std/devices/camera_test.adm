partial module std.devices {
	use (
		std.formats.video
		std.testing
		std.services.devices::(Device, DeviceKind)
		std.services.policy::(Policy, PolicyDenied)
		std.devices.v4l2::*
		std.devices.structs::*
	)

	check "V4L2 structures" {
		// A 32-bit field goes in little-endian and comes back out unchanged, and
		// a field that is not there reads as 0 rather than failing.
		@test()
		def TestU32RoundTrip() {
			let buf = zeroed(12)
			putU32(buf, 0, 1280)
			putU32(buf, 4, PIX_FMT_MJPEG)
			putU32(buf, 8, 0xFFFFFFFF)

			assert int(buf[0]) == 0x00
			assert int(buf[1]) == 0x05
			assert int(buf[2]) == 0x00
			assert int(buf[3]) == 0x00
			assert u32(buf, 0) == 1280
			assert u32(buf, 4) == PIX_FMT_MJPEG
			assert u32(buf, 8) == 0xFFFFFFFF

			// Past the end, and before the start.
			assert u32(buf, 12) == 0
			assert u32(buf, 9) == 0
			assert u32(buf, -1) == 0
			// Writing past the end leaves the buffer alone.
			putU32(buf, 10, 7)
			assert u32(buf, 8) == 0xFFFFFFFF
		}

		// A fixed-width name field ends at its first zero byte.
		@test()
		def TestFixedText() {
			let buf = zeroed(16)
			let name = "MX Brio".bytes()
			for let (i, c) in name {
				buf[4 + i] = c
			}
			assert fixedText(buf, 4, 8) == "MX Brio"
			// The whole field, padding included.
			assert fixedText(buf, 4, 12) == "MX Brio"
			// A field of nothing but padding.
			assert fixedText(buf, 0, 4) == ""
			// A field that runs off the end.
			assert fixedText(buf, 12, 8) == ""
		}

		// A v4l2_capability the driver filled in reads back, and the node's own
		// capabilities win when the driver says it reports them.
		@test()
		def TestCapabilityCodec() {
			let buf = zeroed(CAPABILITY_SIZE)
			assert buf.len() == 104
			let card = "MX Brio".bytes()
			for let (i, c) in card {
				buf[CAPABILITY_CARD + i] = c
			}
			putU32(buf, CAPABILITY_CAPABILITIES, CAP_VIDEO_CAPTURE | CAP_STREAMING | CAP_DEVICE_CAPS)
			putU32(buf, CAPABILITY_DEVICE_CAPS, CAP_STREAMING)

			let capability = decodeCapability(buf)
			assert capability.card == "MX Brio"
			assert (capability.capabilities & CAP_VIDEO_CAPTURE) != 0
			assert capability.deviceCaps == CAP_STREAMING
			// The node reports its own, so those are the ones that count: this is
			// the metadata node of a camera whose driver also captures video.
			assert nodeCapabilities(capability) == CAP_STREAMING
			assert (nodeCapabilities(capability) & CAP_VIDEO_CAPTURE) == 0

			// Without the flag, the driver's capabilities are all there is.
			let plain = zeroed(CAPABILITY_SIZE)
			putU32(plain, CAPABILITY_CAPABILITIES, CAP_VIDEO_CAPTURE | CAP_STREAMING)
			assert nodeCapabilities(decodeCapability(plain)) == CAP_VIDEO_CAPTURE | CAP_STREAMING
		}

		// A v4l2_format asks on the capture queue, spells the pixel format as its
		// four character code, and reads back as it went in.
		@test()
		def TestFormatCodec() {
			let buf = encodeFormat(Format{width: 1280, height: 720, pixelFormat: PIX_FMT_MJPEG})
			assert buf.len() == 208
			assert u32(buf, FORMAT_TYPE) == BUF_TYPE_VIDEO_CAPTURE
			assert u32(buf, FORMAT_FIELD) == FIELD_ANY
			// "MJPG", the code the kernel names the format with.
			assert int(buf[FORMAT_PIXELFORMAT]) == 0x4D
			assert int(buf[FORMAT_PIXELFORMAT + 1]) == 0x4A
			assert int(buf[FORMAT_PIXELFORMAT + 2]) == 0x50
			assert int(buf[FORMAT_PIXELFORMAT + 3]) == 0x47

			let format = decodeFormat(buf)
			assert format.width == 1280
			assert format.height == 720
			assert format.pixelFormat == PIX_FMT_MJPEG
			assert format.sizeImage == 0

			// The driver answering with a layout of its own, YUYV at another size.
			let answer = encodeFormat(Format{width: 640, height: 480, pixelFormat: PIX_FMT_YUYV, sizeImage: 614400})
			let substituted = decodeFormat(answer)
			assert substituted.width == 640
			assert substituted.height == 480
			assert substituted.pixelFormat == PIX_FMT_YUYV
			assert substituted.sizeImage == 614400
		}

		// A v4l2_requestbuffers asks for mapped capture buffers, and the count
		// that comes back is the one the driver granted.
		@test()
		def TestRequestBuffersCodec() {
			let buf = encodeRequestBuffers(4)
			assert buf.len() == 20
			assert u32(buf, REQUESTBUFFERS_COUNT) == 4
			assert u32(buf, REQUESTBUFFERS_TYPE) == BUF_TYPE_VIDEO_CAPTURE
			assert u32(buf, REQUESTBUFFERS_MEMORY) == MEMORY_MMAP
			assert decodeRequestBuffers(buf) == 4

			// The driver granting fewer than were asked for.
			let answer = encodeRequestBuffers(2)
			assert decodeRequestBuffers(answer) == 2
		}

		// A v4l2_buffer names one buffer of the capture queue, and the one the
		// driver hands back says where it is and how much of it the frame fills.
		@test()
		def TestBufferCodec() {
			let buf = encodeBuffer(2)
			assert buf.len() == 88
			assert u32(buf, BUFFER_INDEX) == 2
			assert u32(buf, BUFFER_TYPE) == BUF_TYPE_VIDEO_CAPTURE
			assert u32(buf, BUFFER_MEMORY) == MEMORY_MMAP
			assert u32(buf, BUFFER_BYTESUSED) == 0

			// What a driver answers QUERYBUF and DQBUF with.
			putU32(buf, BUFFER_BYTESUSED, 45123)
			putU32(buf, BUFFER_OFFSET, 0x00300000)
			putU32(buf, BUFFER_LENGTH, 1843200)
			putU32(buf, BUFFER_SEQUENCE, 41)
			let info = decodeBuffer(buf)
			assert info.index == 2
			assert info.bytesUsed == 45123
			assert info.offset == 0x00300000
			assert info.length == 1843200
			assert info.sequence == 41
		}

		// STREAMON and STREAMOFF carry the buffer type and nothing else.
		@test()
		def TestBufferTypeCodec() {
			let buf = encodeBufferType()
			assert buf.len() == 4
			assert int(buf[0]) == BUF_TYPE_VIDEO_CAPTURE
			assert int(buf[1]) == 0
			assert int(buf[2]) == 0
			assert int(buf[3]) == 0
		}
	}

	// The first camera opened, none when the machine has none or another
	// program holds it (a browser tab, a video call).
	//
	// Fails when opening fails for another reason.
	internal def firstCamera() !?Camera {
		let found = cameras() onerror recover []
		return none when found.len() == 0
		let busy = false
		let cam = openCamera(found[0].id) onerror (err error) {
			fail err unless inUse(err)
			busy = true
			recover new Camera(Device{}, -1, Format{}, 4)
		}
		return none when busy
		return cam
	}

	// Whether opening failed because another program holds the camera.
	internal def inUse(err error) bool {
		return "{err}".contains("in use by another program")
	}

	check "Capture" {
		// Opens the machine's first camera, takes three frames and checks that the
		// camera is dead once closed. A machine with no camera skips rather than
		// fails.
		@test()
		def TestCapturesFramesAndCloses() !none {
			let opened = try firstCamera()
			return testing.skip("no camera, or another program holds it") when opened is none
			let cam Camera = opened
			assert cam.isOpen()
			assert cam.width > 0
			assert cam.height > 0
			assert cam.device.kind == DeviceKind.Camera

			for let i = 1; i <= 3; i++ {
				let shot = try cam.frame()
				assert shot.data.len() > 0
				assert shot.sequence == i
				assert shot.width == cam.width
				assert shot.height == cam.height
				assert shot.format == cam.format
				// An MJPEG frame is a whole JPEG file, so it starts with the start
				// of image marker and ends with the end of image marker.
				if shot.format == PixelFormat.Mjpeg {
					let n = shot.data.len()
					assert n > 4
					assert int(shot.data[0]) == 0xFF
					assert int(shot.data[1]) == 0xD8
					assert int(shot.data[n - 2]) == 0xFF
					assert int(shot.data[n - 1]) == 0xD9
				}
			}

			cam.close()
			assert !cam.isOpen()
			// Closing twice does nothing.
			cam.close()

			// A closed camera delivers no more frames.
			let failed = false
			cam.frame() onerror (err error) {
				failed = true
				recover Frame{}
			}
			assert failed
			return none
		}

		// Warming up drops exactly the frames asked for, so the next frame's
		// sequence counts them; a negative count is refused.
		@test()
		def TestWarmupDropsTheFramesAskedFor() !none {
			let opened = try firstCamera()
			return testing.skip("no camera, or another program holds it") when opened is none
			let cam Camera = opened
			defer cam.close()
			try cam.warmup(3)
			assert (try cam.frame()).sequence == 4
			try cam.warmup(0)
			assert (try cam.frame()).sequence == 5

			let refused = false
			cam.warmup(-1) onerror (err error) {
				refused = true
				recover none
			}
			assert refused
			return none
		}

		// A device id nothing answers to fails rather than handing back a camera
		// that cannot capture.
		@test()
		def TestOpeningSomethingElseFails() !none {
			let missing = false
			openCamera("video:no-such-camera") onerror (err error) {
				missing = true
				recover new Camera(Device{}, -1, Format{}, 4)
			}
			assert missing
			let few = false
			openCamera("video:no-such-camera", buffers = 1) onerror (err error) {
				few = true
				recover new Camera(Device{}, -1, Format{}, 4)
			}
			assert few
			return none
		}

		// Opening a camera takes the `camera` permission alone, and its
		// `device` rules decide on the id.
		@test()
		def TestCameraPolicy() !none {
			let found = cameras() onerror recover []
			return testing.skip("no camera") when found.len() == 0
			let id = found[0].id
			try Policy.configure("[adm.devices.list]\n\"*\".deny = [\"*\"]\n")
			let busy = false
			let cam = openCamera(id) onerror (err error) {
				Policy.configure("") onerror recover none
				fail err unless inUse(err)
				busy = true
				recover new Camera(Device{}, -1, Format{}, 4)
			}
			return testing.skip("another program holds the camera") when busy
			assert cam.device.id == id
			cam.close()
			try Policy.configure("[adm.devices.camera]\ndevice.deny = [\"{id}\"]\n")
			let denied = false
			openCamera(id) onerror (err error) {
				denied = err is PolicyDenied
				recover new Camera(Device{}, -1, Format{}, 4)
			}
			try Policy.configure("")
			assert denied
			return none
		}

		// The camera lists what it delivers and its controls, and a control
		// set to another value reads back as the camera kept it.
		@test()
		def TestModesAndControls() !none {
			let opened = try firstCamera()
			return testing.skip("no camera, or another program holds it") when opened is none
			let cam Camera = opened
			defer cam.close()

			let modes = try cam.modes()
			assert modes.len() > 0
			assert modes.filter((m) => m.format == cam.format).len() > 0
			for let (_, mode) in modes {
				assert mode.width > 0 && mode.height > 0
				for let (_, rate) in mode.rates {
					assert rate > 0.0
				}
			}
			assert cam.rate > 0.0

			let controls = try cam.controls()
			for let (_, c) in controls {
				assert c.name != ""
				assert c.minimum <= c.maximum unless c.kind := ControlKind.Button || ControlKind.Bitmask
				assert c.choices.len() > 0 when c.kind == ControlKind.Menu
			}
			let adjustable = controls.filter((c) => c.kind == ControlKind.Integer && !c.readOnly && !c.inactive && c.maximum > c.minimum)
			return none when adjustable.len() == 0
			let pick = adjustable[0]
			let before = try cam.control(pick.name)
			let other = before == pick.minimum ?? (pick.maximum, pick.minimum)
			let kept = try cam.control(pick.name.upper(), other)
			assert kept == other
			assert (try cam.control(pick.name)) == other
			try cam.control(pick.name, before)
			assert (try cam.control(pick.name)) == before

			let refused = false
			cam.control(pick.name, pick.maximum + 1) onerror (err error) {
				refused = true
				recover 0
			}
			assert refused
			let unknown = false
			cam.control("no such control") onerror (err error) {
				unknown = true
				recover 0
			}
			assert unknown
			return none
		}

		// Stopping ends the frames until the camera starts again, and every
		// format the camera offers comes out as an image of the frame's size.
		@test()
		def TestEveryFormatBecomesAnImage() !none {
			let opened = try firstCamera()
			return testing.skip("no camera, or another program holds it") when opened is none
			let cam Camera = opened
			defer cam.close()

			try cam.stop()
			assert !cam.isStreaming()
			let stopped = false
			cam.frame() onerror (err error) {
				stopped = true
				recover Frame{}
			}
			assert stopped
			try cam.start()
			assert (try cam.frame()).data.len() > 0

			let done PixelFormat[]
			for let (_, mode) in try cam.modes() {
				continue when done.includes(mode.format)
				done.push(mode.format)
				// The smallest size of the format keeps the conversion quick.
				let size = mode
				for let (_, m) in try cam.modes() {
					size = m when m.format == mode.format && m.width * m.height < size.width * size.height
				}
				try cam.configure(size.width, size.height, format = mode.format)
				assert cam.isStreaming() && cam.format == mode.format
				let shot = try cam.frame()
				assert shot.format == mode.format && shot.width == cam.width && shot.height == cam.height
				let picture = try toImage(shot)
				assert int(picture.size().width) == shot.width && int(picture.size().height) == shot.height
				let planes = try toVideoFrame(shot)
				assert int(planes.width) == shot.width && int(planes.height) == shot.height
			}
			return none
		}
	}

	check "Frame conversion" {
		// A test pattern of `w` x `h` with rows `stride` bytes apart in one
		// of the raw formats, and the planes it holds.
		@test()
		def TestRawFramesSplitIntoPlanes() !none {
			let w = 20
			let h = 6
			let stride = 24
			let data byte[]
			data.len(stride * h * 2)
			for let i = 0; i < data.len(); i++ {
				data[i] = byte((i * 13 + 5) & 255)
			}
			let i420 = try toVideoFrame(Frame{width: w, height: h, format: PixelFormat.Yuv420, data: data, sequence: 1, stride: stride})
			assert i420.yStride == stride && i420.uvStride == stride / 2 && i420.chroma == video.ChromaLayout.Yuv420
			assert i420.y[0] == data[0] && i420.u[0] == data[stride * h] && i420.v[0] == data[stride * h + stride / 2 * (h / 2)]
			let grey = try toVideoFrame(Frame{width: w, height: h, format: PixelFormat.Grey, data: data, sequence: 1})
			assert grey.chroma == video.ChromaLayout.Mono && grey.fullRange && grey.yStride == w
			let nv12 = try toVideoFrame(Frame{width: w, height: h, format: PixelFormat.Nv12, data: data, sequence: 1, stride: stride})
			assert nv12.y[w] == data[stride] && nv12.u[1] == data[stride * h + 2] && nv12.v[1] == data[stride * h + 3]
			let yuyv = try toVideoFrame(Frame{width: w, height: h, format: PixelFormat.Yuyv, data: data, sequence: 1, stride: 2 * w + 8})
			assert yuyv.y[w] == data[2 * w + 8] && yuyv.u[0] == data[1] && yuyv.v[0] == data[3]
			let uyvy = try toVideoFrame(Frame{width: w, height: h, format: PixelFormat.Uyvy, data: data, sequence: 1})
			assert uyvy.y[0] == data[1] && uyvy.u[0] == data[0]
			let picture = try toImage(Frame{width: w, height: h, format: PixelFormat.Grey, data: data, sequence: 1})
			assert picture.raw()[0] == data[0] && picture.raw()[3] == byte(255)
			return none
		}

		// A frame shorter than its size says is refused, not read past its end.
		@test()
		def TestShortFramesFail() !none {
			for let (_, format) in [PixelFormat.Yuyv, PixelFormat.Uyvy, PixelFormat.Nv12, PixelFormat.Yuv420, PixelFormat.Grey, PixelFormat.Mjpeg] {
				let failed = false
				toVideoFrame(Frame{width: 64, height: 48, format: format, data: byte[1, 2, 3], sequence: 1}) onerror (err error) {
					failed = true
					recover video.VideoFrame{width: 0, height: 0, y: [], u: [], v: [], yStride: 0, uvStride: 0, time: 0s, length: 0s, keyframe: false, matrix: 601}
				}
				assert failed onerror fail "{format} took a 3-byte frame"
			}
			return none
		}

		// The driver's numbers: signed fields and frame intervals.
		@test()
		def TestDriverNumbers() {
			let buf byte[] = [0xFF, 0xFF, 0xFF, 0xFF, 5, 0, 0, 0]
			assert s32(buf, 0) == -1 && s32(buf, 4) == 5 && u32(buf, 0) == 0xFFFFFFFF
			assert framesPerSecond(1, 30) == 30.0 && framesPerSecond(1001, 30000) > 29.9 && framesPerSecond(0, 30) == 0.0
			assert isFormat(PIX_FMT_JPEG, PixelFormat.Mjpeg) && isFormat(PIX_FMT_NV12, PixelFormat.Nv12) && !isFormat(0x34363248, PixelFormat.Mjpeg)
			assert controlKind(CTRL_TYPE_INTEGER_MENU) == ControlKind.Menu && controlKind(CTRL_TYPE_INTEGER) == ControlKind.Integer
		}
	}
}
