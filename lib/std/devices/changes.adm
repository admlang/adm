// Following the speakers and microphones as they change.
//
// `soundChanges()` yields one `SoundChange` each time a speaker or microphone
// appears or goes away, its volume or mute changes, or the desktop picks
// another default. The devices already there when it starts are not
// reported; `speakers()` and `microphones()` list them. Breaking out of the
// loop, or dropping the iterator, stops following; a task cancelled while it
// waits stops too.
//
// Example: show the volume of the default speaker as it changes
// ```example
// use std.devices
//
// for let change in try devices.soundChanges() {
// 	let seen = try change
// 	if seen.device.isDefault && seen.device.kind == DeviceKind.Speaker {
// 		println("{seen.device.name}: {seen.volume}{seen.muted ?? (" (muted)", "")}")
// 	}
// }
// ```

partial module std.devices {
	use (
		std.services.devices::(Device, DeviceKind, Devices)
		std.services.storage::(Storage)
		std.time
		std.devices.alsa::*
		std.devices.pulse::*
		std.devices.structs::*
	)

	// What happened to a speaker or microphone.
	enum SoundChangeKind {
		// It appeared: plugged in, or made by the sound server.
		Added,
		// It went away; the change holds it as it was last seen.
		Removed,
		// Its volume, mute or description changed.
		Changed,
		// The desktop now plays to it, or records from it, by default.
		Default,
	}

	// One change `soundChanges` reports.
	struct SoundChange {
		kind   SoundChangeKind
		// The speaker or microphone as it is after the change.
		device Device
		// Its volume, 1.0 full, and whether it is muted, after the change.
		volume float
		muted  bool
	}

	// The changes to the speakers and microphones, one at a time as they
	// happen: through the desktop's sound server when it runs, which reports
	// them as they are made; else from the kernel's device events and the
	// sound cards' mixers.
	//
	// Fails when the policy denies listing the devices. The sequence fails,
	// and ends, when the sound server goes away.
	@requires("adm.devices.list")
	def soundChanges() !Iterator<!SoundChange> {
		return followSound()
	}

	// The sequence soundChanges hands out.
	internal def followSound() Iterator<!SoundChange> {
		let server = pulseConnection("adm")
		if server is none {
			for let change in cardChanges() {
				yield change
			}
			return
		}
		let connection PulseConnection = server
		defer connection.close()
		let known = map<string, SoundChange>{}
		for let (_, kind) in [DeviceKind.Speaker, DeviceKind.Microphone] {
			for let (_, endpoint) in try pulseEndpoints(connection, kind) {
				continue when endpoint.monitor
				known[endpointKey(kind, endpoint.index)] = changeOf(SoundChangeKind.Added, endpoint)
			}
		}
		let (sink, source) = try pulseDefaults(connection)
		let defaultSink = sink
		let defaultSource = source
		let mask = new PulseTags()
		mask.u32(SUBSCRIBE_SINK | SUBSCRIBE_SOURCE | SUBSCRIBE_SERVER)
		try connection.command(PULSE_SUBSCRIBE, mask)
		for {
			for connection.events.len() == 0 {
				// Waits for as long as nothing changes.
				let _ = try connection.receive(-1s)
			}
			let (event, index) = connection.events.shift()
			let facility = event & EVENT_FACILITY
			if facility == EVENT_SERVER {
				let (nowSink, nowSource) = try pulseDefaults(connection)
				if nowSink != defaultSink {
					defaultSink = nowSink
					let picked = markDefault(known, DeviceKind.Speaker, "pulse:" + nowSink)
					yield picked unless picked is none
				}
				if nowSource != defaultSource {
					defaultSource = nowSource
					let picked = markDefault(known, DeviceKind.Microphone, "pulse:" + nowSource)
					yield picked unless picked is none
				}
				continue
			}
			continue unless facility := EVENT_SINK || EVENT_SOURCE
			let kind = facility == EVENT_SINK ?? (DeviceKind.Speaker, DeviceKind.Microphone)
			let key = endpointKey(kind, index)
			if (event & EVENT_TYPE) == EVENT_REMOVE {
				let gone = known.get(key)
				continue when gone is none
				let last SoundChange = gone
				known.delete(key)
				yield SoundChange{...last, kind: SoundChangeKind.Removed}
				continue
			}
			// Gone again before it could be described: its removal follows.
			let endpoint = pulseEndpointAt(connection, kind, index) onerror (err error) {
				continue
			}
			continue when endpoint.monitor
			let now = changeOf(SoundChangeKind.Changed, endpoint)
			let before = known.get(key)
			known[key] = now
			if before is none {
				yield SoundChange{...now, kind: SoundChangeKind.Added}
				continue
			}
			let last SoundChange = before
			yield now when changed(last, now)
		}
	}

	// The key a sink (speaker) or source (microphone) is known by: the two
	// have separate indexes.
	internal def endpointKey(kind DeviceKind, index int) string {
		return "{kind == DeviceKind.Speaker ?? ("sink", "source")}:{index}"
	}

	// A change of the kind carrying the endpoint as it is.
	internal def changeOf(kind SoundChangeKind, endpoint PulseEndpoint) SoundChange {
		return SoundChange{kind: kind, device: endpoint.device, volume: endpoint.volume, muted: endpoint.muted}
	}

	// Whether something a change reports differs: the volume, the mute, or
	// what describes the device. Which one is the default is a change of its
	// own.
	internal def changed(before SoundChange, now SoundChange) bool {
		let a = before.device
		let b = now.device
		return before.volume != now.volume || before.muted != now.muted || a.name != b.name || a.node != b.node || a.vendor != b.vendor || a.product != b.product || a.serial != b.serial || a.bus != b.bus
	}

	// Marks the device with the id the default of its kind among those known
	// and returns the change that says so, none when it is not known.
	internal def markDefault(known map<string, SoundChange>, kind DeviceKind, id string) ?SoundChange {
		let picked ?SoundChange = none
		for let (key, entry) in known {
			continue unless entry.device.kind == kind
			let isNew = entry.device.id == id
			let device = Device{...entry.device, isDefault: isNew}
			let now = SoundChange{...entry, device: device}
			known[key] = now
			picked = SoundChange{...now, kind: SoundChangeKind.Default} when isNew
		}
		return picked
	}

	// --- without a sound server: the cards ---------------------------------------

	// The changes to the sound cards' endpoints: after each burst of the
	// kernel's sound device events and each change on a card's mixer, the
	// endpoints are listed again and what differs is reported.
	internal def cardChanges() Iterator<!SoundChange> {
		let wake = new channel<none>(1)
		let watch = new SoundWatch(wake)
		defer watch.stop()
		let events = __net_netlink(SOUND_UEVENTS, SOUND_UEVENT_GROUP) onerror recover -1
		watch.uevents(events) when events >= 0
		try watch.followCards()
		let known = try cardState(watch)
		for {
			let _ = <-wake
			// A plug is a burst of events; the nodes are named meanwhile.
			time.sleep(SOUND_SETTLE)
			try watch.followCards()
			let now = try cardState(watch)
			for let (id, entry) in now {
				let before = known.get(id)
				if before is none {
					yield SoundChange{...entry, kind: SoundChangeKind.Added}
					continue
				}
				let last SoundChange = before
				if entry.device.isDefault && !last.device.isDefault {
					yield SoundChange{...entry, kind: SoundChangeKind.Default}
				}
				yield SoundChange{...entry, kind: SoundChangeKind.Changed} when changed(last, entry)
			}
			for let (id, entry) in known {
				yield SoundChange{...entry, kind: SoundChangeKind.Removed} unless now.hasKey(id)
			}
			known = now
		}
	}

	// The card endpoints with their volumes, by id, the configured defaults
	// marked.
	//
	// Fails when the policy denies listing the devices.
	internal def cardState(watch SoundWatch) !map<string, SoundChange> {
		let out = map<string, SoundChange>{}
		for let (_, kind) in [DeviceKind.Speaker, DeviceKind.Microphone] {
			let endpoints = try Devices.list(kind)
			let chosen = endpoints.len() == 0 ?? (-1, try alsaDefaultEndpoint(endpoints, kind == DeviceKind.Speaker))
			for let (i, endpoint) in endpoints {
				let device = Device{...endpoint, isDefault: i == chosen}
				let (volume, muted) = watch.levels(device)
				out[device.id] = SoundChange{kind: SoundChangeKind.Changed, device: device, volume: volume, muted: muted}
			}
		}
		return out
	}

	// The tasks that wait on the kernel's sound events and the cards' mixers,
	// each waking the reader of `cardChanges` through one channel.
	internal type SoundWatch {
		internal wake    channel<none>
		internal running bool             = true
		// The control node of each card followed, by card number.
		internal cards   map<string, int>

		def new(wake channel<none>) {
			self.wake = wake
		}

		// Starts the task reading the kernel's device events off the socket,
		// which it closes when it ends.
		def uevents(fd int) {
			async readUevents(fd)
		}

		// Opens the control node of every card not followed yet and starts
		// its task; a card that went away has its task end on its own.
		//
		// Fails when the policy denies listing the devices.
		def followCards() !none {
			let present = map<string, bool>{}
			for let (_, card) in try Devices.list(DeviceKind.Audio) {
				let number = card.id[10:]
				present[number] = true
				continue when cards.hasKey(number)
				// A card whose node cannot be opened is listed without volumes.
				let fd = Devices.open(card.id) onerror (err error) {
					continue
				}
				mixerSubscribe(fd) onerror (err error) {
					Devices.close(fd) onerror recover none
					continue
				}
				cards[number] = fd
				async readMixer(number, fd)
			}
			for let (number, fd) in cards.clone() {
				cards.delete(number) unless present.hasKey(number)
			}
			return none
		}

		// The volume and mute of a card endpoint on its card's mixer: full and
		// not muted when the card has no control for it.
		def levels(device Device) (float, bool) {
			let number = device.id[10:].split("D")[0]
			let fd = cards.get(number)
			return (1.0, false) when fd is none
			let control int = fd
			let mixer = soundMixer(control, device.id, device.kind == DeviceKind.Speaker) onerror (err error) {
				return (1.0, false)
			}
			let volume = mixer.volume() onerror recover 1.0
			let muted = mixer.muted() onerror recover false
			return (volume, muted)
		}

		// Stops every task; each closes its own descriptor as it leaves.
		def stop() {
			markStopped()
		}

		atomic def markStopped() {
			running = false
		}

		atomic def isRunning() bool {
			return running
		}

		// Reads device events until stopped or the socket fails, waking the
		// reader for each one about sound.
		internal def readUevents(fd int) {
			let buf byte[]
			buf.len(SOUND_UEVENT_MAX)
			for isRunning() {
				let n = __net_read(fd, buf, SOUND_POLL) onerror (err error) {
					recover err.code == "ETIMEDOUT" ?? (-2, -1)
				}
				continue when n == -2
				break when n <= 0
				if soundEvent(buf.slice(0, n)) {
					let _ = wake.offer(none)
				}
			}
			__net_close(fd) onerror recover none
		}

		// Reads a card's mixer events until stopped or the card goes away,
		// waking the reader for each.
		internal def readMixer(number string, fd int) {
			let buf = zeroed(CTL_EVENT_SIZE * 16)
			for isRunning() {
				let ready = Storage.wait(fd, SOUND_POLL) onerror (err error) {
					break
				}
				continue unless ready
				let n = Storage.read(fd, buf) onerror (err error) {
					break
				}
				break when n <= 0
				let _ = wake.offer(none)
			}
			Devices.close(fd) onerror recover none
			forget(number, fd)
		}

		// Drops the card's node once its task has closed it.
		internal atomic def forget(number string, fd int) {
			let held = cards.get(number)
			cards.delete(number) when !(held is none) && held == fd
		}
	}

	// Whether a kernel uevent is about the sound subsystem.
	internal def soundEvent(message byte[]) bool {
		return ueventSubsystem(message) == "sound"
	}

	// The subsystem a kernel uevent (`KEY=value` fields, each ended by a
	// zero byte) is about, "" when it names none.
	internal def ueventSubsystem(message byte[]) string {
		let start = 0
		for let i = 0; i <= message.len(); i++ {
			continue unless i == message.len() || message[i] == 0
			let field = string(message.slice(start, i - start))
			start = i + 1
			return field[10:] when field.startsWith("SUBSYSTEM=")
		}
		return ""
	}

	// linux/netlink.h: the kernel's device events and their multicast group.
	internal const SOUND_UEVENTS = 15
	internal const SOUND_UEVENT_GROUP = 1
	// The largest uevent the kernel sends.
	internal const SOUND_UEVENT_MAX = 2048
	// How long the tasks wait before looking whether they were stopped.
	internal const SOUND_POLL = 500ms
	// How long after the first event of a burst the endpoints are listed.
	internal const SOUND_SETTLE = 100ms
}
