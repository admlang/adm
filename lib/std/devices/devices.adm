// Opening a device and checking it against the policy, for every kind this
// package drives.
partial module std.devices {
	use (
		std.services.devices::(Device, DeviceKind, Devices)
		std.services.policy::(Policy)
	)

	// Opens the device behind the id and returns it with its descriptor,
	// which the caller then owns. Holding the descriptor is what shows the
	// device, so this needs no `list` permission.
	//
	// Fails when there is no such device, it has no node or cannot be opened,
	// or it is not of the kind; nothing stays open then.
	internal def openKind(id string, kind DeviceKind, what string) !(Device, int) {
		let fd = try Devices.open(id)
		let found = Devices.opened(fd)
		if found is none {
			Devices.close(fd) onerror recover none
			fail "devices: no device with the id {id}"
		}
		let device Device = found
		if device.kind != kind {
			Devices.close(fd) onerror recover none
			fail "devices: {id} is not a {what}"
		}
		return (device, fd)
	}

	// Fails with PolicyDenied unless the policy lets the calling packages use
	// the device under the permission (`adm.devices.camera`,
	// `adm.devices.microphone`), by the permission's `device` rules.
	internal def admitDevice(permission string, id string) !none {
		return Policy.validate(permission, "std.services.devices.DeviceSpec", id)
	}
}
