internal partial module std.devices.evdev {
	use (
		std.services.storage::(Storage)
		std.devices.structs::*
	)

	// The Linux input interface (linux/input.h): events are read from the
	// node as `input_event` structures, everything else goes through
	// ioctls. The sizes and request numbers are 64-bit Linux's.

	// --- input_event (24 bytes) -------------------------------------------------
	//
	//     time   0   16 bytes   seconds and microseconds, 8 bytes each
	//     type  16    2 bytes
	//     code  18    2 bytes
	//     value 20    4 bytes, signed
	const EVENT_SIZE = 24
	const EVENT_SECONDS = 0
	const EVENT_MICROSECONDS = 8
	const EVENT_TYPE = 16
	const EVENT_CODE = 18
	const EVENT_VALUE = 20

	// --- input_absinfo (24 bytes): value, minimum, maximum, fuzz, flat,
	// resolution, each 4 bytes signed --------------------------------------------
	const ABSINFO_SIZE = 24

	// --- ff_effect (48 bytes) ---------------------------------------------------
	//
	//     type       0   2 bytes
	//     id         2   2 bytes, signed: -1 asks the driver for a new slot
	//     direction  4   2 bytes
	//     trigger    6   button, interval: 2 bytes each
	//     replay    10   length, delay in ms: 2 bytes each
	//     u         16   for FF_RUMBLE: strong_magnitude, then the other motor's, 2 bytes each
	const EFFECT_SIZE = 48
	const EFFECT_TYPE = 0
	const EFFECT_ID = 2
	const EFFECT_LENGTH = 10
	const EFFECT_HEAVY = 16
	const EFFECT_LIGHT = 18

	// Event types (EV_*).
	const EV_SYN = 0x00
	const EV_KEY = 0x01
	const EV_REL = 0x02
	const EV_ABS = 0x03
	const EV_MSC = 0x04
	const EV_SW = 0x05
	const EV_LED = 0x11
	const EV_SND = 0x12
	const EV_REP = 0x14
	const EV_FF = 0x15
	const EV_PWR = 0x16
	const EV_MAX = 0x1f

	// Synchronisation codes: the end of a report, and events lost because
	// the reader fell behind.
	const SYN_REPORT = 0
	const SYN_DROPPED = 3

	// The highest code of each kind, for the bitmaps the driver fills.
	const KEY_MAX = 0x2ff
	const REL_MAX = 0x0f
	const ABS_MAX = 0x3f

	// The force-feedback effect this module plays.
	const FF_RUMBLE = 0x50

	// Request numbers: _IOR('E', 0x06, len) EVIOCGNAME, _IOR('E', 0x18, len)
	// EVIOCGKEY, _IOR('E', 0x20 + ev, len) EVIOCGBIT, _IOR('E', 0x40 + abs,
	// input_absinfo) EVIOCGABS, _IOW('E', 0x80, ff_effect) EVIOCSFF,
	// _IOW('E', 0x81, int) EVIOCRMFF, _IOR('E', 0x84, int) EVIOCGEFFECTS,
	// _IOW('E', 0x90, int) EVIOCGRAB, _IOW('E', 0xa0, int) EVIOCSCLOCKID.
	const EVIOCGKEY_BASE = 0x80004518
	const EVIOCGBIT_BASE = 0x80004520
	const EVIOCGABS_BASE = 0x80184540
	const EVIOCSFF = 0x40304580
	const EVIOCRMFF = 0x40044581
	const EVIOCGEFFECTS = 0x80044584
	const EVIOCGRAB = 0x40044590
	const EVIOCSCLOCKID = 0x400445A0
	// CLOCK_MONOTONIC: event times on the clock `time.monoNs` reads.
	const CLOCK_MONOTONIC = 1

	// _IOR('E', 0x02, struct input_id): bus, vendor, product and version,
	// 16 bits each.
	const EVIOCGID = 0x80084502
	const INPUT_ID_SIZE = 8

	// The EVIOCGBIT request for a bitmap of `bytes` bytes of the event type.
	def bitsRequest(eventType int, bytes int) int {
		return EVIOCGBIT_BASE | (bytes << 16) | eventType
	}

	// The EVIOCGKEY request for a key-state bitmap of `bytes` bytes.
	def keyStateRequest(bytes int) int {
		return EVIOCGKEY_BASE | (bytes << 16)
	}

	// The bytes of a bitmap holding codes 0 to max.
	def bitmapBytes(max int) int {
		return max / 8 + 1
	}

	// The codes set in a bitmap the driver filled, lowest first.
	def setBits(bitmap byte[]) int[] {
		let out int[]
		for let i = 0; i < bitmap.len(); i++ {
			let b = int(bitmap[i])
			continue when b == 0
			for let bit = 0; bit < 8; bit++ {
				out.push(i * 8 + bit) when (b & (1 << bit)) != 0
			}
		}
		return out
	}

	// The codes of the event type the device reports (EVIOCGBIT).
	//
	// Fails when the device refuses the request.
	def supported(fd int, eventType int, max int) !int[] {
		let bitmap = zeroed(bitmapBytes(max))
		try Storage.control(fd, bitsRequest(eventType, bitmap.len()), bitmap)
		return setBits(bitmap)
	}

	// One event as it comes off the node.
	struct RawEvent {
		seconds      int
		microseconds int
		kind         int
		code         int
		value        int
	}

	// The event at `offset` of what a read returned.
	def decodeEvent(buf byte[], offset int) RawEvent {
		return RawEvent{
			seconds:      int(u64(buf, offset + EVENT_SECONDS)),
			microseconds: int(u64(buf, offset + EVENT_MICROSECONDS)),
			kind:         u16(buf, offset + EVENT_TYPE),
			code:         u16(buf, offset + EVENT_CODE),
			value:        s32(buf, offset + EVENT_VALUE),
		}
	}

	// An input_event to write to the node: an output event (a LED, a
	// force-feedback effect to play).
	def encodeEvent(kind int, code int, value int) byte[] {
		let buf = zeroed(EVENT_SIZE)
		putU16(buf, EVENT_TYPE, kind)
		putU16(buf, EVENT_CODE, code)
		putU32(buf, EVENT_VALUE, value & 0xFFFFFFFF)
		return buf
	}

	// An FF_RUMBLE effect in slot `id` (-1 for a new one) of the two motors'
	// strengths (0 to 0xFFFF; the heavy one is the low-frequency, strong
	// motor, the kernel's strong_magnitude) for `ms` milliseconds.
	def encodeRumble(id int, heavy int, light int, ms int) byte[] {
		let buf = zeroed(EFFECT_SIZE)
		putU16(buf, EFFECT_TYPE, FF_RUMBLE)
		putU16(buf, EFFECT_ID, id & 0xFFFF)
		putU16(buf, EFFECT_LENGTH, ms)
		putU16(buf, EFFECT_HEAVY, heavy)
		putU16(buf, EFFECT_LIGHT, light)
		return buf
	}

	// The effect slot the driver gave an uploaded effect.
	def effectId(buf byte[]) int {
		let id = u16(buf, EFFECT_ID)
		return id >= 0x8000 ?? (id - 0x10000, id)
	}
}
