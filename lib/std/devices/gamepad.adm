// Game pads by the names every game uses: the face buttons A, B, X and Y,
// shoulders, triggers from 0 to 1, two sticks with a dead zone, the D-pad,
// Back, Start and Guide, the stick clicks and rumble, whatever the pad
// calls them. A pad's own buttons and axes are matched to those names by a
// mapping in the SDL game controller database's form, or by the layout the
// Linux kernel gives game pads.
//
// Example: jump on A, walk with the left stick
// ```example
// use std.devices
//
// let pad = try devices.openGamepad()
// defer pad.close()
// for {
//     for let (_, change) in try pad.read(1s) {
//         println("jump") when change.control == devices.GamepadControl.A && change.value == 1.0
//     }
//     let now = pad.state()
//     println("walking {now.leftX}, {now.leftY}")
// }
// ```
partial module std.devices {
	use (
		std.services.devices::(Device, DeviceKind)
		std.services.storage::(Storage)
		std.crypto.hash::(crc16Update)
		std.math::(sqrt)
		std.devices.evdev::*
		std.devices.structs::*
	)

	// A button or axis of a game pad, by where it sits on a pad laid out as
	// an Xbox controller is: A at the bottom of the four face buttons, B on
	// the right, X on the left, Y at the top (on a PlayStation pad cross,
	// circle, square and triangle).
	enum GamepadControl {
		A,
		B,
		X,
		Y,
		LeftShoulder,
		RightShoulder,
		// The analog triggers, 0 released to 1 pulled all the way.
		LeftTrigger,
		RightTrigger,
		Back,
		Start,
		// The button with the maker's logo.
		Guide,
		// The sticks pushed in.
		LeftStick,
		RightStick,
		DpadUp,
		DpadDown,
		DpadLeft,
		DpadRight,
		// The sticks, -1 to 1: X left to right, Y up to down.
		LeftX,
		LeftY,
		RightX,
		RightY,
		// The paddles under the pad: upper right, upper left, lower right,
		// lower left.
		Paddle1,
		Paddle2,
		Paddle3,
		Paddle4,
		// A pad's extra buttons: Share, Capture, the microphone button.
		Misc1,
		Misc2,
		Misc3,
		Misc4,
		Misc5,
		Misc6,
		// A touch pad pressed as a button.
		Touchpad,
	}

	// A game pad at one moment. Buttons are true while held; the triggers
	// run from 0 to 1, the sticks from -1 to 1 (X left to right, Y up to
	// down), 0 within the dead zone.
	struct GamepadState {
		a             bool  = false
		b             bool  = false
		x             bool  = false
		y             bool  = false
		leftShoulder  bool  = false
		rightShoulder bool  = false
		leftTrigger   float = 0.0
		rightTrigger  float = 0.0
		back          bool  = false
		start         bool  = false
		guide         bool  = false
		leftStick     bool  = false
		rightStick    bool  = false
		dpadUp        bool  = false
		dpadDown      bool  = false
		dpadLeft      bool  = false
		dpadRight     bool  = false
		leftX         float = 0.0
		leftY         float = 0.0
		rightX        float = 0.0
		rightY        float = 0.0
		paddle1       bool  = false
		paddle2       bool  = false
		paddle3       bool  = false
		paddle4       bool  = false
		misc1         bool  = false
		misc2         bool  = false
		misc3         bool  = false
		misc4         bool  = false
		misc5         bool  = false
		misc6         bool  = false
		touchpad      bool  = false
	}

	// A control that changed: its new value, 1 or 0 for a button.
	struct GamepadEvent {
		// When the pad reported it, on the clock `time.monoNs` reads.
		time    duration
		control GamepadControl
		value   float
	}

	// Which of a pad's own buttons, axes and hats make each control, in the
	// form of a line of the SDL game controller database
	// (`gamecontrollerdb.txt`): the pad's GUID, its name, then
	// `a:b0,b:b1,...,leftx:a0,lefty:a1,dpup:h0.1,...`.
	type GamepadMapping {
		// The 32 hexadecimal digits that name the pad: its bus, a check of
		// its name, its USB vendor, product and version.
		guid string
		// The pad's name.
		name string
		// The check of the pad's name (`crc:` in the line) the mapping is
		// for alone, -1 when it is for every pad with the GUID.
		crc  int    = -1

		internal bindings GamepadBinding[]

		internal def new(guid string, name string, bindings GamepadBinding[]) {
			self.guid = guid
			self.name = name
			self.bindings = bindings
		}

		// The mapping as a database line, with `platform:Linux`.
		def str() string {
			let out = "{guid},{name},"
			for let (_, b) in bindings {
				out += bindingText(b) + ","
			}
			out += "crc:{"%04x".format(crc)}," when crc >= 0
			return out + "platform:Linux,"
		}
	}

	// The mappings in a database's text, one a line: those for Linux and
	// those that name no platform. Blank lines and `#` comments are passed
	// over.
	//
	// Keys that name no control (hints, SDK ranges, controls of a later
	// SDL) are passed over, as SDL passes them over.
	//
	// Fails on a line that is no mapping: no GUID of 32 hexadecimal digits,
	// no name, or a binding that names no button, axis or hat of the pad.
	def parseGamepadMappings(text string) !GamepadMapping[] {
		let out GamepadMapping[]
		for let (n, raw) in text.split("\n") {
			let line = raw.trim()
			continue when line == "" || line.startsWith("#")
			let mapping = parseMapping(line) onerror (err error) {
				fail "devices: line {n + 1} of the game pad mappings: {err.message}"
			}
			out.push(mapping) unless mapping is none
		}
		return out
	}

	// One database line as a mapping, none for another platform's.
	//
	// Fails as parseGamepadMappings does.
	internal def parseMapping(line string) !?GamepadMapping {
		let fields = line.split(",")
		fail "a mapping is a GUID, a name and bindings: {line}" when fields.len() < 3
		let guid = fields[0].trim().lower()
		// SDL's mapping for every XInput pad, which only Windows has.
		return none when guid == "xinput"
		fail "a GUID is 32 hexadecimal digits, not {fields[0]}" unless guid.len() == 32 && isHex(guid)
		let name = fields[1].trim()
		fail "the mapping of {guid} has no name" when name == ""
		let bindings GamepadBinding[]
		let crc = -1
		for let i = 2; i < fields.len(); i++ {
			let item = fields[i].trim()
			continue when item == ""
			let colon = item.indexOf(":")
			fail "{item} is no binding" when colon <= 0
			let key = item[0:colon]
			let value = item[colon + 1:]
			if key == "platform" {
				return none unless value == "Linux"
				continue
			}
			if key == "crc" {
				fail "crc:{value} is no 16-bit check" unless value.len() == 4 && isHex(value)
				crc = value.toInt<int>(16)
				continue
			}
			// The database's other keys (hints, SDK ranges) and controls
			// SDL added after these, which SDL too passes over.
			let named = key.startsWith("+") || key.startsWith("-") ?? (key[1:], key)
			continue when controlNamed(named) is none
			bindings.push(try parseBinding(key, value))
		}
		let mapping = new GamepadMapping(guid, name, bindings)
		mapping.crc = crc
		return mapping
	}

	// The game pads: input devices with game pad buttons or controller axes.
	//
	// Fails when the policy denies listing the devices.
	def gamepads() !Device[] {
		return inputDevices(DeviceKind.Gamepad)
	}

	// Opens a game pad: the one with the id from gamepads, or the first
	// when the id is empty (which takes the `list` permission too). Its
	// mapping is the first of `mappings` for its GUID, else of the
	// `SDL_GAMECONTROLLERCONFIG` environment variable's, else the layout
	// the kernel gives game pads (BTN_SOUTH for A, ABS_X for the left
	// stick, ABS_Z or BTN_TL2 for the left trigger, the first hat or the
	// D-pad buttons).
	//
	// Fails when the policy denies reading input devices (the `input`
	// permission, and its `device` rules for this id), there is no such
	// device or no game pad, it cannot be opened, or it has no game pad
	// buttons and no mapping names it.
	@requires("adm.devices.input")
	def openGamepad(id string = "", mappings GamepadMapping[] = []) !Gamepad {
		let target = id
		if target == "" {
			let found = try gamepads()
			fail "devices: no game pad is connected" when found.len() == 0
			target = found[0].id
		}
		let input = try openInput(target)
		let info = padInfo(input) onerror (err error) {
			input.close()
			fail err
		}
		let candidates = mappings.clone()
		let env = __env_get("SDL_GAMECONTROLLERCONFIG")
		if !(env is none) {
			let text string = env
			for let (_, m) in parseGamepadMappings(text) onerror recover [] {
				candidates.push(m)
			}
		}
		return gamepadOn(input, info, candidates) onerror (err error) {
			input.close()
			fail err
		}
	}

	// An open game pad. openGamepad returns one; close it when done, or let
	// it go: dispose closes it.
	type Gamepad {
		// The input device the pad is.
		device   Device
		// The pad's GUID, as the SDL game controller database names pads.
		guid     string
		// The mapping in use: one given or found for the GUID, or the
		// kernel's layout.
		mapping  GamepadMapping
		// How far a stick moves before it counts, as a share of its travel;
		// within it the stick reads 0, and beyond it the travel left is
		// stretched to run from 0 to 1. The driver's own dead zone when it
		// names a larger one.
		deadZone float          = 0.1

		internal input   InputDevice
		// The raw controls in SDL's order: buttons held, axes from -1 to 1,
		// hats as bit masks (1 up, 2 right, 4 down, 8 left).
		internal buttons map<int, bool>
		internal axes    map<int, float>
		internal hats    map<int, int>
		internal layout  PadLayout
		internal now     GamepadState

		internal def new(input InputDevice, guid string, mapping GamepadMapping, layout PadLayout) {
			self.input = input
			self.device = input.device
			self.guid = guid
			self.mapping = mapping
			self.layout = layout
			buttons = map<int, bool>{}
			axes = map<int, float>{}
			hats = map<int, int>{}
			now = GamepadState{}
		}

		// The controls that changed in the pad's next report, waiting up to
		// timeout for it; empty when none came in time or the report moved
		// nothing past the dead zone.
		//
		// Fails when the pad is closed or gone.
		def read(timeout duration) !GamepadEvent[] {
			let report = try input.read(timeout)
			let at = 0s
			for let (_, e) in report {
				at = e.time
				takeRaw(self, e)
			}
			return changes(self, at)
		}

		// The pad as the reports read so far left it.
		def state() GamepadState {
			return now
		}

		// Whether a button is held, or an axis is past half its travel, as
		// the reports read so far left it.
		def pressed(control GamepadControl) bool {
			return value(control).abs() >= 0.5
		}

		// A control's value as the reports read so far left it: 1 or 0 for a
		// button, 0 to 1 for a trigger, -1 to 1 for a stick axis.
		def value(control GamepadControl) float {
			return controlValue(now, control)
		}

		// Shakes the pad, as InputDevice.rumble does.
		//
		// Fails when the pad is closed, has no rumble motors, or the
		// strengths are outside 0 to 1.
		def rumble(heavy float, light float, length duration) !none {
			return input.rumble(heavy, light, length)
		}

		// Stops the rumble playing.
		//
		// Fails when the pad is closed.
		def stopRumble() !none {
			return input.stopRumble()
		}

		// Releases the pad; a closed pad stays closed.
		def close() {
			input.close()
		}

		// Whether the pad is open.
		def isOpen() bool {
			return input.isOpen()
		}

		// Closing on dispose, so a pad nobody holds any more is released.
		def dispose() {
			close()
		}
	}

	// What a pad has, as the mappings see it.
	internal struct PadInfo {
		bus     int
		vendor  int
		product int
		version int
		name    string
		keys    int[]
		axes    Axis[]
	}

	// A pad's raw controls in SDL's numbering for Linux: buttons from
	// BTN_JOYSTICK up to the last key, then the keys below it; hats are the
	// pairs ABS_HAT0X/Y to ABS_HAT3X/Y that look digital, numbered in that
	// order; axes are the other absolute axes in code order.
	internal struct PadLayout {
		buttonOf map<int, int>
		axisOf   map<int, int>
		// Each absolute axis code's range, hats' too.
		ranges   map<int, Axis>
		// The hat number of each digital hat's axis codes.
		hatOf    map<int, int>
		// The pair (0 to 3) of each digital hat, by hat number.
		pairOf   map<int, int>
	}

	// One binding of a mapping: a control, made from a button, an axis (or
	// one half of it, perhaps turned around) or a hat direction, perhaps
	// into one half of an axis.
	internal struct GamepadBinding {
		control    GamepadControl
		// 0 the whole control; 1 or -1 its positive or negative half.
		outputHalf int            = 0
		// 'b', 'a' or 'h'.
		source     char
		index      int
		inputHalf  int            = 0
		invert     bool           = false
		// The hat direction's bit.
		mask       int            = 0
	}

	// What the pad tells about itself: EVIOCGID, its name, keys and axes.
	//
	// Fails when the pad refuses a request.
	internal def padInfo(input InputDevice) !PadInfo {
		let id = zeroed(INPUT_ID_SIZE)
		try Storage.control(input.fd, EVIOCGID, id)
		return PadInfo{
			bus:     u16(id, 0),
			vendor:  u16(id, 2),
			product: u16(id, 4),
			version: u16(id, 6),
			name:    input.device.name,
			keys:    try input.keys(),
			axes:    try input.axes(),
		}
	}

	// A Gamepad over an open input device, with the first mapping for its
	// GUID, else the kernel's layout; the state starts as the device is.
	//
	// Fails when the device has no game pad buttons and no mapping names it.
	internal def gamepadOn(input InputDevice, info PadInfo, mappings GamepadMapping[]) !Gamepad {
		let guid = gamepadGuid(info.bus, info.vendor, info.product, info.version, info.name)
		let layout = padLayout(info)
		let picked = pickMapping(guid, mappings)
		let chosen GamepadMapping = new GamepadMapping(guid, info.name, [])
		if picked is none {
			fail "devices: {input.device.id} ({info.name}) has no game pad buttons; give openGamepad a mapping for its GUID {guid}" unless info.keys.includes(BTN_SOUTH)
			chosen = kernelMapping(guid, info, layout)
		} else {
			let found GamepadMapping = picked
			chosen = found
		}
		let pad = new Gamepad(input, guid, chosen, layout)
		for let (_, axis) in info.axes {
			let span = axis.maximum - axis.minimum
			if span > 0 && (axis.code := ABS_X || ABS_Y || ABS_RX || ABS_RY) {
				pad.deadZone = pad.deadZone.max(float(axis.flat) * 2.0 / float(span))
			}
			takeRaw(pad, InputEvent{time: 0s, kind: InputKind.Absolute, code: axis.code, value: axis.value})
		}
		for let (_, code) in input.pressed() onerror recover [] {
			takeRaw(pad, InputEvent{time: 0s, kind: InputKind.Key, code: code, value: 1})
		}
		let _ = changes(pad, 0s)
		return pad
	}

	// SDL's GUID of a pad on Linux: bus, the CRC-16 of the name (the
	// reflected 0xA001 polynomial from 0), vendor, 0, product, 0, version,
	// 0, each 16 bits little-endian, as 32 hexadecimal digits. A pad
	// without a vendor puts the first 11 bytes of its name after the check
	// instead.
	internal def gamepadGuid(bus int, vendor int, product int, version int, name string) string {
		let crc uint16 = 0
		for let (_, b) in name.bytes() {
			crc = crc16Update(crc, b)
		}
		let raw = zeroed(16)
		putU16(raw, 0, bus)
		putU16(raw, 2, int(crc))
		if vendor != 0 {
			putU16(raw, 4, vendor)
			putU16(raw, 8, product)
			putU16(raw, 12, version)
		} else {
			let text = name.bytes()
			for let i = 0; i < text.len() && i < 11; i++ {
				raw[4 + i] = text[i]
			}
		}
		return raw.hex().lower()
	}

	// The mapping SDL picks for a GUID. GUIDs are compared without their
	// check of the name: a mapping whose `crc` matches the pad's wins, one
	// whose `crc` differs is passed over, else the first for the GUID;
	// failing all, the same again without the version.
	internal def pickMapping(guid string, mappings GamepadMapping[]) ?GamepadMapping {
		return none unless guid.len() == 32
		let crc = guid[6:8].toInt<int>(16) << 8 | guid[4:6].toInt<int>(16)
		for let pass = 0; pass < 2; pass++ {
			let best ?GamepadMapping = none
			for let (_, m) in mappings {
				continue unless m.guid.len() == 32 && guidKey(m.guid, pass) == guidKey(guid, pass)
				if m.crc >= 0 {
					return m when m.crc == crc
					continue
				}
				best = m when best is none
			}
			return best unless best is none
		}
		return none
	}

	// A GUID for matching: its check of the name (digits 4 to 7) zeroed,
	// and in the second pass its version (digits 24 to 27) too.
	internal def guidKey(guid string, pass int) string {
		let key = guid[0:4] + "0000" + guid[8:]
		return key when pass == 0
		return key[0:24] + "0000" + key[28:]
	}

	// SDL's numbering of a pad's raw controls.
	internal def padLayout(info PadInfo) PadLayout {
		let layout = PadLayout{buttonOf: map<int, int>{}, axisOf: map<int, int>{}, ranges: map<int, Axis>{}, hatOf: map<int, int>{}, pairOf: map<int, int>{}}
		let n = 0
		for let (_, code) in info.keys {
			if code >= BTN_JOYSTICK {
				layout.buttonOf[code] = n
				n++
			}
		}
		for let (_, code) in info.keys {
			if code < BTN_JOYSTICK {
				layout.buttonOf[code] = n
				n++
			}
		}
		for let (_, axis) in info.axes {
			layout.ranges[axis.code] = axis
		}
		let hats = 0
		for let x = ABS_HAT0X; x <= ABS_HAT3Y; x += 2 {
			continue unless digitalHat(layout.ranges.get(x), layout.ranges.get(x + 1))
			layout.hatOf[x] = hats
			layout.hatOf[x + 1] = hats
			layout.pairOf[hats] = (x - ABS_HAT0X) / 2
			hats++
		}
		let a = 0
		for let code = 0; code < ABS_MAX; code++ {
			continue unless layout.ranges.hasKey(code) && !layout.hatOf.hasKey(code)
			layout.axisOf[code] = a
			a++
		}
		return layout
	}

	// Whether a hat pair is digital, as SDL guesses it: at least one axis,
	// and both that are there run -1 to 1, or both report no fuzz, flat or
	// resolution.
	internal def digitalHat(x ?Axis, y ?Axis) bool {
		return false when x is none && y is none
		let narrow = true
		let plain = true
		for let (_, one) in [x, y] {
			continue when one is none
			let a Axis = one
			narrow = false unless a.minimum == -1 && a.maximum == 1
			plain = false unless a.fuzz == 0 && a.flat == 0 && a.resolution == 0
		}
		return narrow || plain
	}

	// The digital hat with a pair number (0 for ABS_HAT0X/Y), -1 for none.
	internal def hatOfPair(layout PadLayout, pair int) int {
		let code = ABS_HAT0X + pair * 2
		return layout.hatOf.hasKey(code) ?? (layout.hatOf[code], -1)
	}

	// The mapping SDL makes for a pad that follows the kernel's layout
	// (Documentation/input/gamepad.rst), as LINUX_JoystickGetGamepadMapping
	// does, plus the kernel's grip buttons as paddles: X and Y are BTN_X
	// and BTN_Y, positionally BTN_WEST and BTN_NORTH on Sony's pads; the
	// shoulders BTN_TL/BTN_TR, else hat 1; the triggers ABS_HAT2Y/X,
	// ABS_BRAKE/GAS or ABS_Z/RZ, else hat 2, else BTN_TL2/TR2; the D-pad
	// BTN_DPAD_*, else hat 0 or its axes; the right stick RX/RY, else Z/RZ.
	internal def kernelMapping(guid string, info PadInfo, layout PadLayout) GamepadMapping {
		let out GamepadBinding[]
		bindButton(out, layout, GamepadControl.A, BTN_SOUTH)
		bindButton(out, layout, GamepadControl.B, BTN_EAST)
		if info.vendor == VENDOR_SONY {
			bindButton(out, layout, GamepadControl.X, BTN_WEST)
			bindButton(out, layout, GamepadControl.Y, BTN_NORTH)
		} else {
			bindButton(out, layout, GamepadControl.X, BTN_NORTH)
			bindButton(out, layout, GamepadControl.Y, BTN_WEST)
		}
		bindButton(out, layout, GamepadControl.Back, BTN_SELECT)
		bindButton(out, layout, GamepadControl.Start, BTN_START)
		bindButton(out, layout, GamepadControl.LeftStick, BTN_THUMBL)
		bindButton(out, layout, GamepadControl.RightStick, BTN_THUMBR)
		bindButton(out, layout, GamepadControl.Guide, BTN_MODE)

		let leftShoulder = bindButton(out, layout, GamepadControl.LeftShoulder, BTN_TL)
		let rightShoulder = bindButton(out, layout, GamepadControl.RightShoulder, BTN_TR)
		let hat1 = hatOfPair(layout, 1)
		if !(leftShoulder && rightShoulder) && hat1 >= 0 {
			removeBindings(out, [GamepadControl.LeftShoulder, GamepadControl.RightShoulder])
			out.push(GamepadBinding{control: GamepadControl.LeftShoulder, source: 'h', index: hat1, mask: HAT_DOWN})
			out.push(GamepadBinding{control: GamepadControl.RightShoulder, source: 'h', index: hat1, mask: HAT_RIGHT})
		} else {
			bindAxis(out, layout, GamepadControl.LeftShoulder, ABS_HAT1Y) unless leftShoulder
			bindAxis(out, layout, GamepadControl.RightShoulder, ABS_HAT1X) unless rightShoulder
		}

		let leftTrigger = bindAxis(out, layout, GamepadControl.LeftTrigger, ABS_HAT2Y) || bindAxis(out, layout, GamepadControl.LeftTrigger, ABS_BRAKE) || bindAxis(out, layout, GamepadControl.LeftTrigger, ABS_Z)
		let rightTrigger = bindAxis(out, layout, GamepadControl.RightTrigger, ABS_HAT2X) || bindAxis(out, layout, GamepadControl.RightTrigger, ABS_GAS) || bindAxis(out, layout, GamepadControl.RightTrigger, ABS_RZ)
		let hat2 = hatOfPair(layout, 2)
		if !(leftTrigger && rightTrigger) && hat2 >= 0 {
			removeBindings(out, [GamepadControl.LeftTrigger, GamepadControl.RightTrigger])
			out.push(GamepadBinding{control: GamepadControl.LeftTrigger, source: 'h', index: hat2, mask: HAT_DOWN})
			out.push(GamepadBinding{control: GamepadControl.RightTrigger, source: 'h', index: hat2, mask: HAT_RIGHT})
		} else {
			bindButton(out, layout, GamepadControl.LeftTrigger, BTN_TL2) unless leftTrigger
			bindButton(out, layout, GamepadControl.RightTrigger, BTN_TR2) unless rightTrigger
		}

		let up = bindButton(out, layout, GamepadControl.DpadUp, BTN_DPAD_UP)
		let down = bindButton(out, layout, GamepadControl.DpadDown, BTN_DPAD_DOWN)
		let left = bindButton(out, layout, GamepadControl.DpadLeft, BTN_DPAD_LEFT)
		let right = bindButton(out, layout, GamepadControl.DpadRight, BTN_DPAD_RIGHT)
		if !(up && down && left && right) {
			let hat0 = hatOfPair(layout, 0)
			let dpad = [GamepadControl.DpadUp, GamepadControl.DpadDown, GamepadControl.DpadLeft, GamepadControl.DpadRight]
			let hatX = layout.axisOf.get(ABS_HAT0X)
			let hatY = layout.axisOf.get(ABS_HAT0Y)
			if hat0 >= 0 {
				removeBindings(out, dpad)
				out.push(GamepadBinding{control: GamepadControl.DpadUp, source: 'h', index: hat0, mask: HAT_UP})
				out.push(GamepadBinding{control: GamepadControl.DpadDown, source: 'h', index: hat0, mask: HAT_DOWN})
				out.push(GamepadBinding{control: GamepadControl.DpadLeft, source: 'h', index: hat0, mask: HAT_LEFT})
				out.push(GamepadBinding{control: GamepadControl.DpadRight, source: 'h', index: hat0, mask: HAT_RIGHT})
			} else if !(hatX is none) && !(hatY is none) {
				removeBindings(out, dpad)
				let x int = hatX
				let y int = hatY
				out.push(GamepadBinding{control: GamepadControl.DpadUp, source: 'a', index: y, inputHalf: -1})
				out.push(GamepadBinding{control: GamepadControl.DpadDown, source: 'a', index: y, inputHalf: 1})
				out.push(GamepadBinding{control: GamepadControl.DpadLeft, source: 'a', index: x, inputHalf: -1})
				out.push(GamepadBinding{control: GamepadControl.DpadRight, source: 'a', index: x, inputHalf: 1})
			}
		}

		if layout.axisOf.hasKey(ABS_X) && layout.axisOf.hasKey(ABS_Y) {
			bindAxis(out, layout, GamepadControl.LeftX, ABS_X)
			bindAxis(out, layout, GamepadControl.LeftY, ABS_Y)
		}
		if layout.axisOf.hasKey(ABS_RX) && layout.axisOf.hasKey(ABS_RY) {
			bindAxis(out, layout, GamepadControl.RightX, ABS_RX)
			bindAxis(out, layout, GamepadControl.RightY, ABS_RY)
		} else if layout.axisOf.hasKey(ABS_Z) && layout.axisOf.hasKey(ABS_RZ) {
			bindAxis(out, layout, GamepadControl.RightX, ABS_Z)
			bindAxis(out, layout, GamepadControl.RightY, ABS_RZ)
		}

		if info.vendor == VENDOR_MICROSOFT {
			// The Xbox Elite pads' paddles and the Series pads' Share button.
			let happy = [BTN_TRIGGER_HAPPY5, BTN_TRIGGER_HAPPY6, BTN_TRIGGER_HAPPY7, BTN_TRIGGER_HAPPY8]
			if happy.filter((code) => layout.buttonOf.hasKey(code)).len() == 4 {
				bindButton(out, layout, GamepadControl.Paddle1, BTN_TRIGGER_HAPPY5)
				bindButton(out, layout, GamepadControl.Paddle2, BTN_TRIGGER_HAPPY7)
				bindButton(out, layout, GamepadControl.Paddle3, BTN_TRIGGER_HAPPY6)
				bindButton(out, layout, GamepadControl.Paddle4, BTN_TRIGGER_HAPPY8)
			}
			bindButton(out, layout, GamepadControl.Misc1, KEY_RECORD)
		}
		if out.filter((b) => b.control == GamepadControl.Paddle1).len() == 0 {
			// The grip buttons the kernel's layout gives paddles since 6.x.
			bindButton(out, layout, GamepadControl.Paddle1, BTN_GRIPR)
			bindButton(out, layout, GamepadControl.Paddle2, BTN_GRIPL)
			bindButton(out, layout, GamepadControl.Paddle3, BTN_GRIPR2)
			bindButton(out, layout, GamepadControl.Paddle4, BTN_GRIPL2)
		}
		return new GamepadMapping(guid, info.name, out)
	}

	// Drops the bindings of the controls.
	internal def removeBindings(out GamepadBinding[], controls GamepadControl[]) {
		let kept = out.filter((b) => !controls.includes(b.control))
		out.len(0)
		out.push(...kept)
	}

	// Binds a control to the pad's button with that code; false when the
	// pad has none.
	internal def bindButton(out GamepadBinding[], layout PadLayout, control GamepadControl, code int) bool {
		return false unless layout.buttonOf.hasKey(code)
		out.push(GamepadBinding{control: control, source: 'b', index: layout.buttonOf[code]})
		return true
	}

	// Binds a control to the pad's axis with that code; false when the pad
	// has none (or it is a digital hat's).
	internal def bindAxis(out GamepadBinding[], layout PadLayout, control GamepadControl, code int) bool {
		return false unless layout.axisOf.hasKey(code)
		out.push(GamepadBinding{control: control, source: 'a', index: layout.axisOf[code]})
		return true
	}

	// Takes one raw event into the pad's raw controls.
	internal def takeRaw(pad Gamepad, e InputEvent) {
		if e.kind == InputKind.Key {
			pad.buttons[pad.layout.buttonOf[e.code]] = e.value != 0 when pad.layout.buttonOf.hasKey(e.code)
			return
		}
		return unless e.kind == InputKind.Absolute
		if pad.layout.hatOf.hasKey(e.code) {
			let hat = pad.layout.hatOf[e.code]
			let held = pad.hats.get(hat)
			let bits = 0
			if !(held is none) {
				let had int = held
				bits = had
			}
			// A direction counts past a third of its half, as SDL reads hats.
			let range = pad.layout.ranges.get(e.code)
			let low = -1
			let high = 1
			if !(range is none) {
				let r Axis = range
				low = r.minimum
				high = r.maximum
			}
			let side = 0
			if e.value < 0 && (e.value <= low || e.value * 3 < low) {
				side = -1
			} else if e.value > 0 && (e.value >= high || e.value * 3 > high) {
				side = 1
			}
			// Even codes are a hat's X, odd ones its Y.
			if (e.code - ABS_HAT0X) % 2 == 0 {
				bits &= ~(HAT_LEFT | HAT_RIGHT)
				bits |= side < 0 ?? (HAT_LEFT, side > 0 ?? (HAT_RIGHT, 0))
			} else {
				bits &= ~(HAT_UP | HAT_DOWN)
				bits |= side < 0 ?? (HAT_UP, side > 0 ?? (HAT_DOWN, 0))
			}
			pad.hats[hat] = bits
			return
		}
		return unless pad.layout.axisOf.hasKey(e.code)
		pad.axes[pad.layout.axisOf[e.code]] = normalised(e.value, pad.layout.ranges[e.code])
	}

	// An axis value from -1 to 1. A range around 0 keeps 0 at 0 and takes
	// each side to its own end (a stick's -32768 to 32767 has no middle);
	// another range, as a trigger's 0 to 255, runs from end to end.
	internal def normalised(value int, range Axis) float {
		let low = range.minimum
		let high = range.maximum
		return 0.0 when high <= low
		if low < 0 && high > 0 {
			let v = value < 0 ?? (-(float(value) / float(low)), float(value) / float(high))
			return v.max(-1.0).min(1.0)
		}
		return (float(value - low) * 2.0 / float(high - low) - 1.0).max(-1.0).min(1.0)
	}

	// Works the controls out again from the raw ones and returns those that
	// changed, stamped `at`.
	internal def changes(pad Gamepad, at duration) GamepadEvent[] {
		let values = map<GamepadControl, float>{}
		for let (_, b) in pad.mapping.bindings {
			let v = bindingValue(pad, b)
			let had = values.get(b.control)
			if had is none {
				values[b.control] = v
			} else {
				let before float = had
				// Two bindings of one control (a D-pad on a hat and on buttons): the stronger counts.
				values[b.control] = v.abs() > before.abs() ?? (v, before)
			}
		}
		let next = GamepadState{}
		for let (control, v) in values {
			putControl(next, control, v)
		}
		let (lx, ly) = deadZoned(next.leftX, next.leftY, pad.deadZone)
		let (rx, ry) = deadZoned(next.rightX, next.rightY, pad.deadZone)
		next.leftX = lx
		next.leftY = ly
		next.rightX = rx
		next.rightY = ry
		let out GamepadEvent[]
		for let (_, control) in ALL_CONTROLS {
			let v = controlValue(next, control)
			out.push(GamepadEvent{time: at, control: control, value: v}) unless v == controlValue(pad.now, control)
		}
		pad.now = next
		return out
	}

	// What one binding makes of the raw controls, in the control's range.
	internal def bindingValue(pad Gamepad, b GamepadBinding) float {
		let v = 0.0
		let full = false
		if b.source == 'b' {
			let held = pad.buttons.get(b.index)
			if !(held is none) {
				let down bool = held
				v = down ?? (1.0, 0.0)
			}
		} else if b.source == 'h' {
			let held = pad.hats.get(b.index)
			if !(held is none) {
				let bits int = held
				v = (bits & b.mask) != 0 ?? (1.0, 0.0)
			}
		} else {
			let raw = pad.axes.get(b.index)
			let a = 0.0
			if !(raw is none) {
				let got float = raw
				a = got
			}
			a = -a when b.invert
			if b.inputHalf == 0 {
				v = a
				full = true
			} else {
				v = (b.inputHalf > 0 ?? (a, -a)).max(0.0)
			}
		}
		return (full ?? ((v + 1.0) / 2.0, v)) >= 0.5 ?? (1.0, 0.0) when isButton(b.control)
		if b.control := GamepadControl.LeftTrigger || GamepadControl.RightTrigger {
			return full ?? ((v + 1.0) / 2.0, v)
		}
		return b.outputHalf < 0 ?? (-v, b.outputHalf > 0 ?? (v, full ?? (v, v * 2.0 - 1.0)))
	}

	// A stick's two axes with the dead zone applied around its centre: 0
	// within it, the travel beyond it stretched to reach 1.
	internal def deadZoned(x float, y float, zone float) (float, float) {
		let length = sqrt(x * x + y * y)
		return (0.0, 0.0) when length <= zone || zone >= 1.0
		let scale = ((length.min(1.0) - zone) / (1.0 - zone)) / length
		return ((x * scale).max(-1.0).min(1.0), (y * scale).max(-1.0).min(1.0))
	}

	// Whether a control is a button.
	internal def isButton(control GamepadControl) bool {
		return !(control := GamepadControl.LeftTrigger || GamepadControl.RightTrigger || GamepadControl.LeftX || GamepadControl.LeftY || GamepadControl.RightX || GamepadControl.RightY)
	}

	// A control's value in a state.
	internal def controlValue(s GamepadState, control GamepadControl) float {
		let on = (held bool) => held ?? (1.0, 0.0)
		match control {
			case GamepadControl.A:
				return on(s.a)
			case GamepadControl.B:
				return on(s.b)
			case GamepadControl.X:
				return on(s.x)
			case GamepadControl.Y:
				return on(s.y)
			case GamepadControl.LeftShoulder:
				return on(s.leftShoulder)
			case GamepadControl.RightShoulder:
				return on(s.rightShoulder)
			case GamepadControl.LeftTrigger:
				return s.leftTrigger
			case GamepadControl.RightTrigger:
				return s.rightTrigger
			case GamepadControl.Back:
				return on(s.back)
			case GamepadControl.Start:
				return on(s.start)
			case GamepadControl.Guide:
				return on(s.guide)
			case GamepadControl.LeftStick:
				return on(s.leftStick)
			case GamepadControl.RightStick:
				return on(s.rightStick)
			case GamepadControl.DpadUp:
				return on(s.dpadUp)
			case GamepadControl.DpadDown:
				return on(s.dpadDown)
			case GamepadControl.DpadLeft:
				return on(s.dpadLeft)
			case GamepadControl.DpadRight:
				return on(s.dpadRight)
			case GamepadControl.LeftX:
				return s.leftX
			case GamepadControl.LeftY:
				return s.leftY
			case GamepadControl.RightX:
				return s.rightX
			case GamepadControl.RightY:
				return s.rightY
			case GamepadControl.Paddle1:
				return on(s.paddle1)
			case GamepadControl.Paddle2:
				return on(s.paddle2)
			case GamepadControl.Paddle3:
				return on(s.paddle3)
			case GamepadControl.Paddle4:
				return on(s.paddle4)
			case GamepadControl.Misc1:
				return on(s.misc1)
			case GamepadControl.Misc2:
				return on(s.misc2)
			case GamepadControl.Misc3:
				return on(s.misc3)
			case GamepadControl.Misc4:
				return on(s.misc4)
			case GamepadControl.Misc5:
				return on(s.misc5)
			case GamepadControl.Misc6:
				return on(s.misc6)
			case GamepadControl.Touchpad:
				return on(s.touchpad)
		}
		return 0.0
	}

	// Sets one control of a state.
	internal def putControl(out GamepadState, control GamepadControl, v float) {
		let held = v >= 0.5
		match control {
			case GamepadControl.A:
				out.a = held
			case GamepadControl.B:
				out.b = held
			case GamepadControl.X:
				out.x = held
			case GamepadControl.Y:
				out.y = held
			case GamepadControl.LeftShoulder:
				out.leftShoulder = held
			case GamepadControl.RightShoulder:
				out.rightShoulder = held
			case GamepadControl.LeftTrigger:
				out.leftTrigger = v.max(0.0).min(1.0)
			case GamepadControl.RightTrigger:
				out.rightTrigger = v.max(0.0).min(1.0)
			case GamepadControl.Back:
				out.back = held
			case GamepadControl.Start:
				out.start = held
			case GamepadControl.Guide:
				out.guide = held
			case GamepadControl.LeftStick:
				out.leftStick = held
			case GamepadControl.RightStick:
				out.rightStick = held
			case GamepadControl.DpadUp:
				out.dpadUp = held
			case GamepadControl.DpadDown:
				out.dpadDown = held
			case GamepadControl.DpadLeft:
				out.dpadLeft = held
			case GamepadControl.DpadRight:
				out.dpadRight = held
			case GamepadControl.LeftX:
				out.leftX = v
			case GamepadControl.LeftY:
				out.leftY = v
			case GamepadControl.RightX:
				out.rightX = v
			case GamepadControl.RightY:
				out.rightY = v
			case GamepadControl.Paddle1:
				out.paddle1 = held
			case GamepadControl.Paddle2:
				out.paddle2 = held
			case GamepadControl.Paddle3:
				out.paddle3 = held
			case GamepadControl.Paddle4:
				out.paddle4 = held
			case GamepadControl.Misc1:
				out.misc1 = held
			case GamepadControl.Misc2:
				out.misc2 = held
			case GamepadControl.Misc3:
				out.misc3 = held
			case GamepadControl.Misc4:
				out.misc4 = held
			case GamepadControl.Misc5:
				out.misc5 = held
			case GamepadControl.Misc6:
				out.misc6 = held
			case GamepadControl.Touchpad:
				out.touchpad = held
		}
	}

	// A database binding: the control's key (`a`, `-leftx`) and its source
	// (`b0`, `a2`, `+a2`, `a2~`, `h0.4`).
	//
	// Fails when either names nothing.
	internal def parseBinding(key string, value string) !GamepadBinding {
		let name = key
		let outputHalf = 0
		if name.startsWith("+") || name.startsWith("-") {
			outputHalf = name.startsWith("+") ?? (1, -1)
			name = name[1:]
		}
		let control = controlNamed(name)
		fail "{key} names no game pad control" when control is none
		let c GamepadControl = control
		let source = value
		let inputHalf = 0
		if source.startsWith("+") || source.startsWith("-") {
			inputHalf = source.startsWith("+") ?? (1, -1)
			source = source[1:]
		}
		let invert = source.endsWith("~")
		source = source[0:source.len() - 1] when invert
		fail "{key}:{value} names no button, axis or hat" when source.len() < 2
		let kind = source[0]
		let rest = source[1:]
		if kind == 'h' {
			let parts = rest.split(".")
			fail "{key}:{value} names no hat direction" unless parts.len() == 2 && isDigits(parts[0]) && isDigits(parts[1])
			return GamepadBinding{control: c, outputHalf: outputHalf, source: 'h', index: parts[0].toInt<int>(), mask: parts[1].toInt<int>()}
		}
		fail "{key}:{value} names no button, axis or hat" unless (kind := 'a' || 'b') && isDigits(rest)
		return GamepadBinding{control: c, outputHalf: outputHalf, source: kind, index: rest.toInt<int>(), inputHalf: inputHalf, invert: invert}
	}

	// A binding as the database writes it.
	internal def bindingText(b GamepadBinding) string {
		let key = (b.outputHalf > 0 ?? ("+", b.outputHalf < 0 ?? ("-", ""))) + controlName(b.control)
		return "{key}:h{b.index}.{b.mask}" when b.source == 'h'
		let half = b.inputHalf > 0 ?? ("+", b.inputHalf < 0 ?? ("-", ""))
		return "{key}:{half}{b.source}{b.index}{b.invert ?? ("~", "")}"
	}

	// The control a database key names, none for another key.
	internal def controlNamed(name string) ?GamepadControl {
		for let (_, c) in ALL_CONTROLS {
			return c when controlName(c) == name
		}
		return none
	}

	// The database's key for a control.
	internal def controlName(control GamepadControl) string {
		match control {
			case GamepadControl.A:
				return "a"
			case GamepadControl.B:
				return "b"
			case GamepadControl.X:
				return "x"
			case GamepadControl.Y:
				return "y"
			case GamepadControl.LeftShoulder:
				return "leftshoulder"
			case GamepadControl.RightShoulder:
				return "rightshoulder"
			case GamepadControl.LeftTrigger:
				return "lefttrigger"
			case GamepadControl.RightTrigger:
				return "righttrigger"
			case GamepadControl.Back:
				return "back"
			case GamepadControl.Start:
				return "start"
			case GamepadControl.Guide:
				return "guide"
			case GamepadControl.LeftStick:
				return "leftstick"
			case GamepadControl.RightStick:
				return "rightstick"
			case GamepadControl.DpadUp:
				return "dpup"
			case GamepadControl.DpadDown:
				return "dpdown"
			case GamepadControl.DpadLeft:
				return "dpleft"
			case GamepadControl.DpadRight:
				return "dpright"
			case GamepadControl.LeftX:
				return "leftx"
			case GamepadControl.LeftY:
				return "lefty"
			case GamepadControl.RightX:
				return "rightx"
			case GamepadControl.RightY:
				return "righty"
			case GamepadControl.Paddle1:
				return "paddle1"
			case GamepadControl.Paddle2:
				return "paddle2"
			case GamepadControl.Paddle3:
				return "paddle3"
			case GamepadControl.Paddle4:
				return "paddle4"
			case GamepadControl.Misc1:
				return "misc1"
			case GamepadControl.Misc2:
				return "misc2"
			case GamepadControl.Misc3:
				return "misc3"
			case GamepadControl.Misc4:
				return "misc4"
			case GamepadControl.Misc5:
				return "misc5"
			case GamepadControl.Misc6:
				return "misc6"
			case GamepadControl.Touchpad:
				return "touchpad"
		}
		return ""
	}

	// Every control, in the order changes are reported.
	internal const ALL_CONTROLS = [GamepadControl.A, GamepadControl.B, GamepadControl.X, GamepadControl.Y, GamepadControl.LeftShoulder, GamepadControl.RightShoulder, GamepadControl.LeftTrigger, GamepadControl.RightTrigger, GamepadControl.Back, GamepadControl.Start, GamepadControl.Guide, GamepadControl.LeftStick, GamepadControl.RightStick, GamepadControl.DpadUp, GamepadControl.DpadDown, GamepadControl.DpadLeft, GamepadControl.DpadRight, GamepadControl.LeftX, GamepadControl.LeftY, GamepadControl.RightX, GamepadControl.RightY, GamepadControl.Paddle1, GamepadControl.Paddle2, GamepadControl.Paddle3, GamepadControl.Paddle4, GamepadControl.Misc1, GamepadControl.Misc2, GamepadControl.Misc3, GamepadControl.Misc4, GamepadControl.Misc5, GamepadControl.Misc6, GamepadControl.Touchpad]

	// A hat's direction bits, as SDL numbers them.
	internal const HAT_UP = 1
	internal const HAT_RIGHT = 2
	internal const HAT_DOWN = 4
	internal const HAT_LEFT = 8

	// linux/input-event-codes.h: the game pad codes the kernel's layout uses.
	internal const BTN_JOYSTICK = 0x120
	internal const BTN_SOUTH = 0x130
	internal const BTN_EAST = 0x131
	internal const BTN_NORTH = 0x133
	internal const BTN_WEST = 0x134
	internal const BTN_TL = 0x136
	internal const BTN_TR = 0x137
	internal const BTN_TL2 = 0x138
	internal const BTN_TR2 = 0x139
	internal const BTN_SELECT = 0x13A
	internal const BTN_START = 0x13B
	internal const BTN_MODE = 0x13C
	internal const BTN_THUMBL = 0x13D
	internal const BTN_THUMBR = 0x13E
	internal const BTN_DPAD_UP = 0x220
	internal const BTN_DPAD_DOWN = 0x221
	internal const BTN_DPAD_LEFT = 0x222
	internal const BTN_DPAD_RIGHT = 0x223
	internal const BTN_GRIPL = 0x224
	internal const BTN_GRIPR = 0x225
	internal const BTN_GRIPL2 = 0x226
	internal const BTN_GRIPR2 = 0x227
	internal const BTN_TRIGGER_HAPPY5 = 0x2C4
	internal const BTN_TRIGGER_HAPPY6 = 0x2C5
	internal const BTN_TRIGGER_HAPPY7 = 0x2C6
	internal const BTN_TRIGGER_HAPPY8 = 0x2C7
	internal const KEY_RECORD = 167
	internal const ABS_X = 0x00
	internal const ABS_Y = 0x01
	internal const ABS_Z = 0x02
	internal const ABS_RX = 0x03
	internal const ABS_RY = 0x04
	internal const ABS_RZ = 0x05
	internal const ABS_HAT0X = 0x10
	internal const ABS_HAT0Y = 0x11
	internal const ABS_HAT1X = 0x12
	internal const ABS_HAT1Y = 0x13
	internal const ABS_HAT2X = 0x14
	internal const ABS_HAT2Y = 0x15
	internal const ABS_HAT3Y = 0x17
	internal const ABS_GAS = 0x09
	internal const ABS_BRAKE = 0x0A
	// USB vendors whose pads SDL lays out apart.
	internal const VENDOR_SONY = 0x054C
	internal const VENDOR_MICROSOFT = 0x045E
}
