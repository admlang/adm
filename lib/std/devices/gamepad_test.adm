partial module std.devices {
	use (
		std.testing
		std.time
		std.services.devices::(Device, DeviceKind)
		std.devices.evdev::*
	)

	// Lines of the SDL game controller database (gamecontrollerdb.txt, as
	// published), for pads on Linux.
	internal const DB_XBOX360 = "030000005e0400008e02000014010000,Xbox 360 Controller,a:b0,b:b1,back:b6,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,guide:b8,leftshoulder:b4,leftstick:b9,lefttrigger:a2,leftx:a0,lefty:a1,rightshoulder:b5,rightstick:b10,righttrigger:a5,rightx:a3,righty:a4,start:b7,x:b2,y:b3,platform:Linux,"
	internal const DB_PS4 = "030000004c050000cc09000011810000,PS4 Controller,a:b0,b:b1,back:b8,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,guide:b10,leftshoulder:b4,leftstick:b11,lefttrigger:a2,leftx:a0,lefty:a1,rightshoulder:b5,rightstick:b12,righttrigger:a5,rightx:a3,righty:a4,start:b9,x:b3,y:b2,platform:Linux,"
	internal const DB_FIGHTSTICK = "03000000ad1b000003f5000033050000,Hori Fightstick VX,+leftx:h0.2,+lefty:h0.4,-leftx:h0.8,-lefty:h0.1,a:b0,b:b1,back:b8,guide:b10,leftshoulder:b4,lefttrigger:b6,rightshoulder:b5,righttrigger:b7,start:b9,x:b2,y:b3,platform:Linux,"
	internal const DB_GAMECUBE = "03000000260900008888000000010000,Cyber Gadget GameCube Controller,a:b0,b:b1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,lefttrigger:a4,leftx:a0,lefty:a1,rightshoulder:b6,righttrigger:a5,rightx:a2,righty:a3~,start:b7,x:b2,y:b3,platform:Linux,"
	internal const DB_WINDOWS = "03000000300f00000a01000000000000,3 In 1 Conversion Box,a:b2,b:b1,back:b9,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,leftshoulder:b6,leftstick:b10,lefttrigger:b4,leftx:a0,lefty:a1,rightshoulder:b7,rightstick:b11,righttrigger:b5,rightx:a3,righty:a2,start:b8,x:b3,y:b0,platform:Windows,"

	// A stick axis as the drivers give them: -32768 to 32767, centred.
	internal def stickAxis(code int) Axis {
		return Axis{code: code, value: 0, minimum: -32768, maximum: 32767, fuzz: 16, flat: 128, resolution: 0}
	}

	// An axis from 0 to max, at rest at 0: a trigger.
	internal def triggerAxis(code int, max int) Axis {
		return Axis{code: code, value: 0, minimum: 0, maximum: max, fuzz: 0, flat: 0, resolution: 0}
	}

	// A hat axis from -1 to 1.
	internal def hatAxis(code int) Axis {
		return Axis{code: code, value: 0, minimum: -1, maximum: 1, fuzz: 0, flat: 0, resolution: 0}
	}

	// An Xbox 360 pad as the xpad driver presents it.
	internal def xbox360() PadInfo {
		return PadInfo{
			bus:     3,
			vendor:  0x045E,
			product: 0x028E,
			version: 0x0114,
			name:    "Microsoft X-Box 360 pad",
			keys:    [0x130, 0x131, 0x133, 0x134, 0x136, 0x137, 0x13A, 0x13B, 0x13C, 0x13D, 0x13E],
			axes:    [stickAxis(ABS_X), stickAxis(ABS_Y), triggerAxis(ABS_Z, 255), stickAxis(ABS_RX), stickAxis(ABS_RY), triggerAxis(ABS_RZ, 255), hatAxis(ABS_HAT0X), hatAxis(ABS_HAT0Y)],
		}
	}

	// A DualShock 4 as hid-sony presented it: digital trigger buttons too.
	internal def dualShock4() PadInfo {
		return PadInfo{
			bus:     3,
			vendor:  0x054C,
			product: 0x09CC,
			version: 0x8111,
			name:    "Sony Interactive Entertainment Wireless Controller",
			keys:    [0x130, 0x131, 0x133, 0x134, 0x136, 0x137, 0x138, 0x139, 0x13A, 0x13B, 0x13C, 0x13D, 0x13E],
			axes:    [stickAxis(ABS_X), stickAxis(ABS_Y), triggerAxis(ABS_Z, 255), stickAxis(ABS_RX), stickAxis(ABS_RY), triggerAxis(ABS_RZ, 255), hatAxis(ABS_HAT0X), hatAxis(ABS_HAT0Y)],
		}
	}

	// A mapping's bindings as database text, in name order, to compare two
	// mappings whatever order they list them in.
	internal def bindingSet(m GamepadMapping) string[] {
		let out string[]
		for let (_, b) in m.bindings {
			out.push(bindingText(b))
		}
		return out.sort((x, y) => x < y)
	}

	// The bindings of a database line, in name order.
	internal def lineSet(line string) !string[] {
		let found = try parseGamepadMappings(line)
		fail "no mapping in {line}" when found.len() != 1
		return bindingSet(found[0])
	}

	// A game pad over recorded events from a node with the pad's
	// capabilities.
	internal def recordedPad(info PadInfo, data byte[], mappings GamepadMapping[] = []) !Gamepad {
		let input = try recordedInput(data)
		return gamepadOn(input, info, mappings)
	}

	// The value of a control among events, none when it did not change.
	internal def changed(events GamepadEvent[], control GamepadControl) ?float {
		for let (_, e) in events {
			return e.value when e.control == control
		}
		return none
	}

	// The name of the mapping a GUID picks, "" for none.
	internal def pickedName(guid string, mappings GamepadMapping[]) string {
		let found = pickMapping(guid, mappings)
		return "" when found is none
		let m GamepadMapping = found
		return m.name
	}

	// Whether two numbers agree to within a thousandth.
	internal def about(v ?float, want float) bool {
		return false when v is none
		let got float = v
		return (got - want).abs() < 0.001
	}

	check "Game pads" {
		// SDL's GUIDs: bus, the name's CRC-16, vendor, product, version, or
		// the name itself for a pad without a vendor.
		@test()
		def TestGuids() {
			assert gamepadGuid(3, 0x045E, 0x028E, 0x0114, "Microsoft X-Box 360 pad") == "030081b85e0400008e02000014010000"
			// The CRC-16 (reflected 0xA001, from 0) of the standard check string is 0xBB3D.
			assert gamepadGuid(3, 0x1234, 1, 2, "123456789")[4:8] == "3dbb"
			let named = gamepadGuid(5, 0, 0, 0, "Long Name Over Eleven")
			assert named[8:30] == "Long Name O".bytes().hex().lower() && named[30:32] == "00"
			assert guidKey("030081b85e0400008e02000014010000", 0) == "030000005e0400008e02000014010000"
			assert guidKey("030081b85e0400008e02000014010000", 1) == "030000005e0400008e02000000000000"
		}

		// A database's text: comments and other platforms passed over, every
		// binding form taken and written back as it was.
		@test()
		def TestParseDatabase() !none {
			let text = "# Game Controller DB for SDL\n\n{DB_XBOX360}\n{DB_WINDOWS}\n{DB_FIGHTSTICK}\r\n{DB_GAMECUBE}\n"
			let found = try parseGamepadMappings(text)
			assert found.len() == 3
			assert found[0].guid == "030000005e0400008e02000014010000" && found[0].name == "Xbox 360 Controller" && found[0].crc == -1
			assert found[0].str() == DB_XBOX360
			assert found[1].str() == DB_FIGHTSTICK && found[2].str() == DB_GAMECUBE
			let withCrc = try parseGamepadMappings("030000005e0400008e02000014010000,Pad,a:b0,crc:b881,hint:!SDL_GAMECONTROLLER_USE_BUTTON_LABELS:=1,platform:Linux,")
			assert withCrc[0].crc == 0xB881 && withCrc[0].bindings.len() == 1
			// SDL's XInput mapping and keys of a later SDL are passed over.
			let later = try parseGamepadMappings("xinput,XInput Controller,a:b0,platform:Linux,\n030000005e0400008e02000014010000,Pad,a:b0,misc6:b9,jump:b1,platform:Linux,")
			assert later.len() == 1 && later[0].bindings.len() == 2
			let refused = 0
			for let (_, bad) in ["xyz,Pad,a:b0", "030000005e0400008e02000014010000,,a:b0", "030000005e0400008e02000014010000,Pad,a:q1", "030000005e0400008e02000014010000,Pad,dpup:h0", "030000005e0400008e02000014010000,Pad,a", "030000005e0400008e02000014010000,Pad,crc:12"] {
				parseGamepadMappings(bad) onerror (err error) {
					refused++
					recover []
				}
			}
			assert refused == 6
			return none
		}

		// The mapping made from the kernel's layout is the one the database
		// has for the same pads: the Xbox 360 pad's X on BTN_X, the
		// DualShock 4's on BTN_WEST, its trigger buttons numbered in.
		@test()
		def TestKernelLayoutMatchesTheDatabase() !none {
			let xbox = xbox360()
			let xboxLayout = padLayout(xbox)
			assert bindingSet(kernelMapping("", xbox, xboxLayout)).equals(try lineSet(DB_XBOX360))
			let ds4 = dualShock4()
			assert bindingSet(kernelMapping("", ds4, padLayout(ds4))).equals(try lineSet(DB_PS4))
			// The hats are not axes; the axes run in code order.
			assert xboxLayout.axisOf.len() == 6 && xboxLayout.axisOf[ABS_RZ] == 5 && xboxLayout.hatOf[ABS_HAT0Y] == 0
			return none
		}

		// Reports become changes of the named controls: A, a trigger, the
		// D-pad on a hat, a stick pushed fully and back within its dead zone.
		@os("linux")
		@test()
		def TestXboxPadReports() !none {
			let data = rawEvents(3, [[EV_KEY, 0x130, 1], [EV_ABS, ABS_X, 32767], [EV_ABS, ABS_RZ, 255], [EV_ABS, ABS_HAT0Y, -1], [EV_SYN, SYN_REPORT, 0], [EV_KEY, 0x130, 0], [EV_ABS, ABS_X, 1200], [EV_ABS, ABS_RZ, 0], [EV_ABS, ABS_HAT0Y, 0], [EV_SYN, SYN_REPORT, 0]])
			let pad = try recordedPad(xbox360(), data)
			defer pad.close()
			assert pad.guid == "030081b85e0400008e02000014010000"
			assert about(pad.deadZone, 0.1)
			let first = try pad.read(1s)
			assert about(changed(first, GamepadControl.A), 1.0) && about(changed(first, GamepadControl.RightTrigger), 1.0)
			assert about(changed(first, GamepadControl.DpadUp), 1.0) && about(changed(first, GamepadControl.LeftX), 1.0)
			assert changed(first, GamepadControl.B) is none && first.len() == 4
			assert first[0].time == 3s + 250us
			let now = pad.state()
			assert now.a && now.dpadUp && !now.dpadDown && about(now.rightTrigger, 1.0) && about(now.leftX, 1.0) && about(now.leftY, 0.0)
			assert pad.pressed(GamepadControl.A) && about(pad.value(GamepadControl.LeftX), 1.0)
			let second = try pad.read(1s)
			assert about(changed(second, GamepadControl.A), 0.0) && about(changed(second, GamepadControl.LeftX), 0.0)
			assert !pad.state().a && !pad.state().dpadUp && about(pad.state().rightTrigger, 0.0)
			return none
		}

		// A mapping for the pad's GUID wins over the kernel's layout.
		@os("linux")
		@test()
		def TestMappingOverridesTheLayout() !none {
			let swapped = try parseGamepadMappings("030000005e0400008e02000014010000,Swapped,a:b1,b:b0,leftx:a3,platform:Linux,")
			let pad = try recordedPad(xbox360(), rawEvents(1, [[EV_KEY, 0x130, 1], [EV_ABS, ABS_RX, -32768], [EV_SYN, SYN_REPORT, 0]]), swapped)
			defer pad.close()
			assert pad.mapping.name == "Swapped"
			let events = try pad.read(1s)
			assert about(changed(events, GamepadControl.B), 1.0) && changed(events, GamepadControl.A) is none
			assert about(changed(events, GamepadControl.LeftX), -1.0)
			return none
		}

		// Which mapping a GUID picks: the check of the name in a mapping's
		// `crc` decides between two for one GUID, a mapping for another
		// version answers last.
		@test()
		def TestPickingAMapping() !none {
			let device = "030081b85e0400008e02000014010000"
			let all = try parseGamepadMappings("030000005e0400008e02000000000000,Any version,a:b0,platform:Linux,\n030000005e0400008e02000014010000,Other name,a:b0,crc:1234,platform:Linux,\n030000005e0400008e02000014010000,Plain,a:b0,platform:Linux,\n030000005e0400008e02000014010000,This name,a:b0,crc:b881,platform:Linux,")
			assert pickedName(device, all) == "This name"
			assert pickedName(device, [all[0], all[1], all[2]]) == "Plain"
			assert pickedName(device, [all[0], all[1]]) == "Any version"
			assert pickedName(device, [all[1]]) == ""
			assert pickMapping(device, []) is none
			return none
		}

		// Hats: a pair from -1 to 1 or without fuzz is digital, another is a
		// pair of axes (the kernel layout's analog triggers on ABS_HAT2Y and
		// ABS_HAT2X); a hat direction counts past a third of its half; a
		// mapping drives a stick's halves from a hat.
		@os("linux")
		@test()
		def TestHatsAndHalves() !none {
			let info = PadInfo{
				bus:     3,
				vendor:  0x28DE,
				product: 0x1102,
				version: 0x0111,
				name:    "Steam Controller",
				keys:    [0x130, 0x131, 0x133, 0x134, 0x136, 0x137],
				axes:    [stickAxis(ABS_X), stickAxis(ABS_Y), Axis{code: ABS_HAT0X, value: 0, minimum: -128, maximum: 127, fuzz: 0, flat: 0, resolution: 0}, hatAxis(ABS_HAT0Y), Axis{code: ABS_HAT2X, value: 0, minimum: 0, maximum: 255, fuzz: 2, flat: 0, resolution: 0}, Axis{code: ABS_HAT2Y, value: 0, minimum: 0, maximum: 255, fuzz: 2, flat: 0, resolution: 0}],
			}
			let layout = padLayout(info)
			assert layout.hatOf.hasKey(ABS_HAT0X) && !layout.hatOf.hasKey(ABS_HAT2X)
			assert layout.axisOf[ABS_HAT2X] == 2 && layout.axisOf[ABS_HAT2Y] == 3
			let auto = bindingSet(kernelMapping("", info, layout))
			assert auto.includes("lefttrigger:a3") && auto.includes("righttrigger:a2") && auto.includes("dpleft:h0.8")
			let pad = try recordedPad(info, rawEvents(1, [[EV_ABS, ABS_HAT0X, -40], [EV_ABS, ABS_HAT2Y, 255], [EV_SYN, SYN_REPORT, 0], [EV_ABS, ABS_HAT0X, -50], [EV_SYN, SYN_REPORT, 0]]))
			defer pad.close()
			let first = try pad.read(1s)
			// -40 is within a third of -128: no direction yet.
			assert changed(first, GamepadControl.DpadLeft) is none && about(changed(first, GamepadControl.LeftTrigger), 1.0)
			let second = try pad.read(1s)
			assert about(changed(second, GamepadControl.DpadLeft), 1.0)

			let stick = try parseGamepadMappings(DB_FIGHTSTICK)
			let fight = PadInfo{bus: 3, vendor: 0x1BAD, product: 0xF503, version: 0x0533, name: "Hori Fightstick VX", keys: [0x130, 0x131, 0x133, 0x134], axes: [hatAxis(ABS_HAT0X), hatAxis(ABS_HAT0Y)]}
			let hori = try recordedPad(fight, rawEvents(1, [[EV_ABS, ABS_HAT0X, -1], [EV_ABS, ABS_HAT0Y, 1], [EV_SYN, SYN_REPORT, 0]]), stick)
			defer hori.close()
			let moved = try hori.read(1s)
			assert about(changed(moved, GamepadControl.LeftX), -0.707) && about(changed(moved, GamepadControl.LeftY), 0.707) onerror fail "the stick read {hori.state().leftX}, {hori.state().leftY}"
			return none
		}

		// Axis values: a range around 0 keeps its centre at 0, each side
		// reaching its end; another runs end to end. The dead zone: nothing
		// inside it, the rest stretched to reach 1.
		@test()
		def TestAxisValues() {
			let stick = stickAxis(ABS_X)
			assert normalised(0, stick) == 0.0 && normalised(32767, stick) == 1.0 && normalised(-32768, stick) == -1.0
			assert about(normalised(16384, stick), 0.5)
			let trigger = triggerAxis(ABS_Z, 255)
			assert normalised(0, trigger) == -1.0 && normalised(255, trigger) == 1.0 && normalised(300, trigger) == 1.0
			assert normalised(5, Axis{code: 0, value: 0, minimum: 3, maximum: 3, fuzz: 0, flat: 0, resolution: 0}) == 0.0
			let (x, y) = deadZoned(0.05, 0.05, 0.1)
			assert x == 0.0 && y == 0.0
			let (fx, _) = deadZoned(1.0, 0.0, 0.1)
			assert about(fx, 1.0)
			let (hx, _) = deadZoned(0.55, 0.0, 0.1)
			assert about(hx, 0.5)
			let (ox, oy) = deadZoned(-1.0, 1.0, 0.1)
			assert about(ox, -0.707) && about(oy, 0.707)
		}

		// A pad without game pad buttons opens only with a mapping, and the
		// failure names the GUID to write one for.
		@os("linux")
		@test()
		def TestJoystickNeedsAMapping() !none {
			let joystick = PadInfo{bus: 3, vendor: 0x0079, product: 0x0006, version: 0x0110, name: "DragonRise Inc.   Generic   USB  Joystick  ", keys: [0x120, 0x121, 0x122, 0x123], axes: [stickAxis(ABS_X), stickAxis(ABS_Y)]}
			let message = ""
			recordedPad(joystick, []) onerror (err error) {
				message = err.message
				recover new Gamepad(new InputDevice(Device{}, -1), "", new GamepadMapping("", "", []), PadLayout{buttonOf: map<int, int>{}, axisOf: map<int, int>{}, ranges: map<int, Axis>{}, hatOf: map<int, int>{}, pairOf: map<int, int>{}})
			}
			assert message.contains(gamepadGuid(3, 0x0079, 0x0006, 0x0110, joystick.name))
			let mapped = try recordedPad(joystick, rawEvents(1, [[EV_KEY, 0x122, 1], [EV_SYN, SYN_REPORT, 0]]), try parseGamepadMappings("03000000790000000600000010010000,DragonRise,a:b2,b:b1,x:b3,y:b0,leftx:a0,lefty:a1,platform:Linux,"))
			defer mapped.close()
			assert about(changed(try mapped.read(1s), GamepadControl.A), 1.0)
			let refused = false
			openGamepad("input:no-such-node") onerror (err error) {
				refused = true
				recover new Gamepad(new InputDevice(Device{}, -1), "", new GamepadMapping("", "", []), PadLayout{buttonOf: map<int, int>{}, axisOf: map<int, int>{}, ranges: map<int, Axis>{}, hatOf: map<int, int>{}, pairOf: map<int, int>{}})
			}
			assert refused
			for let (_, d) in gamepads() onerror recover [] {
				assert d.kind == DeviceKind.Gamepad
			}
			return none
		}

		// The virtual pad of the input suite as a game pad: its GUID, the
		// kernel layout's A and sticks, rumble.
		@test()
		def TestVirtualPadAsGamepad() !none {
			let made = try virtualPad()
			return testing.skip("this user may not open /dev/uinput to make a virtual game pad") when made is none
			let pad VirtualPad = made
			let opened = openPad(pad) onerror (err error) {
				pad.remove()
				fail err
			}
			opened.close()
			let gamepad = openGamepad(pad.id()) onerror (err error) {
				pad.remove()
				fail err
			}
			try pad.send([[EV_KEY, 0x130, 1], [EV_ABS, ABS_RX, -32768]])
			let events = try gamepad.read(1s)
			try gamepad.rumble(0.5, 0.5, 50ms)
			try gamepad.stopRumble()
			let guid = gamepad.guid
			let state = gamepad.state()
			gamepad.close()
			pad.remove()
			assert guid == gamepadGuid(3, 0x045E, 0x028E, 1, "ADM test pad")
			assert about(changed(events, GamepadControl.A), 1.0) && state.a && about(state.rightX, -1.0)
			return none
		}
	}
}
