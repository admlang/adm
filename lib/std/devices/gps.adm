// GPS and the other satellite navigation systems: where this machine is,
// how fast it moves, the time, and the satellites a receiver hears.
// `openGps` reads a receiver on a serial port (NMEA 0183) or the gpsd
// daemon when it runs.
//
// Example: the next fix of the default receiver
// ```example
// use std.devices
//
// let gps = try devices.openGps()
// defer gps.close()
// let fix = try gps.fix()
// let position = fix.position
// if !(position is none) {
//     let at geo.Coordinate = position
//     println("{at.latitude}, {at.longitude} with {fix.satellitesUsed} satellites")
// }
// ```
partial module std.devices {
	use (
		std.math.geo::(Coordinate)
		std.time
		std.services.devices::(Device, DeviceKind)
		std.services.devices.sysfs::(scanDevices)
		std.data.encoding::(JSON)
	)

	// A satellite navigation system.
	enum GnssSystem {
		// The United States' NAVSTAR GPS.
		Gps,
		// Russia's GLONASS.
		Glonass,
		// The European Union's Galileo.
		Galileo,
		// China's BeiDou.
		Beidou,
		// Japan's QZSS, which augments GPS over Asia and Oceania.
		Qzss,
		// India's NavIC (IRNSS).
		Navic,
		// The augmentation satellites that broadcast corrections: WAAS,
		// EGNOS, MSAS, GAGAN.
		Sbas,
	}

	// How a position was found.
	enum FixQuality {
		// There is no position.
		None,
		// From the satellites alone.
		Gps,
		// Corrected by a differential station or SBAS.
		Differential,
		// The precise (military P-code) service.
		Pps,
		// Real-time kinematic with the carrier's whole cycles resolved: a
		// centimetre.
		RtkFixed,
		// Real-time kinematic not yet resolved: a decimetre.
		RtkFloat,
		// Dead reckoning from the last fix and the motion since.
		Estimated,
		// Entered by hand (a surveyed antenna).
		Manual,
		// From a simulator.
		Simulation,
	}

	// How many dimensions a position has.
	enum FixMode {
		// No position.
		None,
		// Latitude and longitude, the altitude assumed.
		TwoD,
		// Latitude, longitude and altitude.
		ThreeD,
	}

	// A satellite a receiver hears.
	struct Satellite {
		system    GnssSystem
		// The number the receiver gives it (NMEA's numbering: 1 to 32 for
		// GPS, 65 to 96 for GLONASS before NMEA 4.10, each system's own
		// number after).
		prn       int
		// Degrees above the horizon, 0 to 90, and clockwise from true north;
		// none while the receiver does not know where it is.
		elevation ?int       = none
		azimuth   ?int       = none
		// The signal's strength over the noise, in dB-Hz; none when the
		// satellite is not tracked.
		snr       ?int       = none
		// Whether the position was computed from it.
		used      bool       = false
	}

	// What a receiver knows at one moment. A field it did not report is
	// none.
	struct GpsFix {
		// The moment the fix is for, in UTC.
		time                ?time.Time  = none
		// Where the receiver is; the coordinate's altitude is metres above
		// the WGS84 ellipsoid when the receiver says it. None without a fix.
		position            ?Coordinate = none
		// Metres above mean sea level (the geoid).
		altitude            ?float      = none
		// Metres the geoid lies above the ellipsoid here.
		geoidSeparation     ?float      = none
		// Metres a second over the ground.
		speed               ?float      = none
		// Degrees clockwise from true north the receiver moves towards.
		course              ?float      = none
		// Metres a second up (gpsd only).
		climb               ?float      = none
		// Degrees a compass points away from true north here, east positive.
		magneticVariation   ?float      = none
		quality             FixQuality  = FixQuality.None
		mode                FixMode     = FixMode.None
		satellitesUsed      int         = 0
		satellitesInView    int         = 0
		// Dilutions of precision: how much the satellites' geometry
		// multiplies the ranging error; 1 is excellent, over 5 poor.
		pdop                ?float      = none
		hdop                ?float      = none
		vdop                ?float      = none
		// The satellites in view, with those used marked.
		satellites          Satellite[] = []
		// Seconds since the last differential correction, and the station
		// that sent it.
		differentialAge     ?float      = none
		differentialStation ?int        = none
	}

	// An open GPS receiver: a receiver on a serial port, whose NMEA
	// sentences are decoded here, or gpsd, which reads the receivers and
	// reports their fixes. `openGps` returns one; close it when done, or let
	// it go: dispose closes it.
	type Gps {
		// The receiver: a serial port's device, or one gpsd serves (`gpsd`
		// for all of them, `gpsd:/dev/ttyACM0` for one).
		device Device

		// The receiver's serial port, none through gpsd.
		internal port      ?SerialPort    = none
		// The connection to gpsd, -1 without one.
		internal socket    int            = -1
		internal lines     NmeaLines
		internal text      byte[]
		internal decoder   NmeaDecoder
		// What gpsd's last SKY report said: satellites, DOPs, counts.
		internal sky       GpsFix
		// Fixes and sentences read and not yet handed out, oldest first.
		internal fixes     GpsFix[]
		internal sentences NmeaSentence[]
		// The last fix handed out.
		internal latest    GpsFix
		internal open      bool           = true

		internal def new(device Device) {
			self.device = device
			lines = new NmeaLines()
			decoder = new NmeaDecoder()
			sky = GpsFix{}
			latest = GpsFix{}
		}

		// The next fix: the receiver's next measurement (once a second for
		// most), waiting up to timeout. A receiver without a fix still
		// reports, with `position` none and `mode` None.
		//
		// Fails with the code `ETIMEDOUT` when the receiver reported nothing
		// in time, and when it is closed or gone (unplugged, gpsd stopped).
		def fix(timeout duration = 5s) !GpsFix {
			let started = time.monoNs()
			for {
				if fixes.len() > 0 {
					latest = fixes.shift()
					return latest
				}
				let left = timeout - duration(time.monoNs() - started)
				fail Error{message: "devices: {device.id} reported no fix in {timeout}", code: "ETIMEDOUT"} when left <= 0s
				let wait = left < QUIET ?? (left, QUIET)
				if !(try pump(self, wait)) && wait == QUIET {
					// The receiver went quiet in an epoch: it is over.
					let rest = decoder.flush()
					if !(rest is none) {
						let done GpsFix = rest
						fixes.push(done)
					}
				}
			}
			fail "unreachable"
		}

		// The next NMEA sentence the receiver sent, every kind (a maker's
		// own too), waiting up to timeout; none when none came in time.
		// Through gpsd these are the sentences gpsd passes on, which it
		// makes up for a receiver that speaks a binary protocol. Reading
		// sentences does not lose fixes, nor fixes sentences.
		//
		// Fails when the receiver is closed or gone.
		def sentence(timeout duration = 5s) !?NmeaSentence {
			let started = time.monoNs()
			for {
				return sentences.shift() when sentences.len() > 0
				let left = timeout - duration(time.monoNs() - started)
				return none when left <= 0s
				let _ = try pump(self, left)
			}
			return none
		}

		// The last fix `fix` handed out; an empty one before the first.
		def last() GpsFix {
			return latest
		}

		// Closes the receiver; a closed one stays closed.
		def close() {
			return unless open
			open = false
			if !(port is none) {
				let held SerialPort = port
				held.close() onerror recover none
			}
			if socket >= 0 {
				__net_close(socket) onerror recover none
				socket = -1
			}
		}

		// Whether the receiver is open.
		def isOpen() bool {
			return open
		}

		// Closing on dispose, so a receiver nobody holds any more is released.
		def dispose() {
			close()
		}
	}

	// Reads once, waiting up to timeout, and queues the gps.sentences and
	// gps.fixes the bytes complete; false when nothing came.
	//
	// Fails when the receiver is closed or gone.
	internal def pump(gps Gps, timeout duration) !bool {
		expects {
			assert gps.open onerror fail "devices: {gps.device.id} is closed"
		}
		let held = gps.port
		if !(held is none) {
			let serial SerialPort = held
			let got = try serial.read(timeout)
			return false when got.len() == 0
			gps.lines.push(got)
			for {
				let line = gps.lines.next()
				break when line is none
				let text string = line
				takeSentence(gps, text, true)
			}
			return true
		}
		let buf byte[]
		buf.len(GPSD_READ)
		let n = __net_read(gps.socket, buf, timeout) onerror (err error) {
			fail err unless err.code == "ETIMEDOUT"
			recover -1
		}
		return false when n < 0
		fail "devices: gpsd closed the connection" when n == 0
		gps.text.push(...buf.slice(0, n))
		let start = 0
		for let i = 0; i < gps.text.len(); i++ {
			continue unless gps.text[i] == byte(10)
			let line = string(gps.text.slice(start, i - start)).trim()
			start = i + 1
			if line.startsWith("\{") {
				takeReport(gps, line)
			} else if line.startsWith("$") || line.startsWith("!") {
				takeSentence(gps, line, false)
			}
		}
		gps.text = gps.text[start:].clone()
		fail "devices: gpsd sent a line longer than {GPSD_LONGEST} bytes" when gps.text.len() > GPSD_LONGEST
		return true
	}

	// Queues a sentence and, when the fixes are decoded here, the fix it
	// completes. A line that is no sentence is passed over.
	internal def takeSentence(gps Gps, line string, decode bool) {
		let parsed = true
		let s = parseNmea(line) onerror (err error) {
			parsed = false
			recover new NmeaSentence("", "", [])
		}
		return unless parsed
		gps.sentences.shift() when gps.sentences.len() >= KEEP_SENTENCES
		gps.sentences.push(s)
		return unless decode
		let done = gps.decoder.add(s)
		if !(done is none) {
			let fix GpsFix = done
			queueFix(gps, fix)
		}
	}

	// Takes one of gpsd's JSON reports: a TPV is a fix, with the
	// satellites and DOPs the last SKY gave; a SKY updates those.
	internal def takeReport(gps Gps, line string) {
		let parsed = new JSON().parse(line) onerror recover none
		let report = anyMap(parsed)
		match anyText(report.get("class")) {
			case "TPV":
				queueFix(gps, tpvFix(report, gps.sky))
			case "SKY":
				gps.sky = skyFix(report, gps.sky)
		}
	}

	internal def queueFix(gps Gps, fix GpsFix) {
		gps.fixes.shift() when gps.fixes.len() >= KEEP_FIXES
		gps.fixes.push(fix)
	}

	// The GPS receivers: serial ports whose USB ids are a GPS maker's, and
	// when gpsd runs, the receivers it reads (`gpsd:/dev/ttyACM0`). Any
	// other serial port a receiver hangs on opens by its id as well.
	//
	// Listing them takes the `location` permission, as opening one does,
	// and not `list`.
	//
	// Fails when the policy denies knowing the location.
	@requires("adm.devices.location")
	def gpsDevices() !Device[] {
		let out = gpsReceivers()
		for let (_, d) in gpsdDevices(GPSD_ADDRESS) {
			out.push(d)
		}
		return out
	}

	// Opens a GPS receiver. The id is one from gpsDevices or serialPorts,
	// `gpsd` for every receiver gpsd reads, or empty for the default: gpsd
	// when it runs, else the first receiver listed. A receiver on a serial
	// port is read at `baud`, or at 0 at the first of 9600, 4800, 38400,
	// 115200, 57600, 19200 and 230400 it sends sentences at; one gpsd holds
	// is read through gpsd.
	//
	// Reading a receiver takes the `location` permission alone, whichever
	// receiver it is and whether it hangs on a serial port: the policy asks
	// whether the program may know where this computer is, as a browser or
	// a phone does.
	//
	// Fails when the policy denies knowing the location, there is no
	// receiver, the port cannot be opened, or nothing on it speaks NMEA.
	@requires("adm.devices.location")
	def openGps(id string = "", baud int = 0) !Gps {
		return openGpsAt(id, baud, GPSD_ADDRESS)
	}

	// openGps with gpsd looked for at an address.
	//
	// Fails as openGps does.
	internal def openGpsAt(id string, baud int, gpsd string) !Gps {
		if id == "" {
			let socket = __net_dial_stream(gpsd, GPSD_CONNECT) onerror recover -1
			return gpsdReceiver(socket, "gpsd", "") when socket >= 0
			let found = gpsReceivers()
			fail "devices: no GPS receiver is connected" when found.len() == 0
			return openGpsAt(found[0].id, baud, gpsd)
		}
		if id == "gpsd" || id.startsWith("gpsd:") {
			let path = id == "gpsd" ?? ("", id[5:])
			let socket = __net_dial_stream(gpsd, GPSD_CONNECT) onerror (err error) {
				fail Error{message: "devices: gpsd does not run (nothing answers at {gpsd})", code: err.code, cause: err}
			}
			return gpsdReceiver(socket, id, path)
		}
		fail "devices: {id} is not a GPS receiver or serial port" unless id.startsWith("serial:")
		let port = openPort(id, baud > 0 ?? (baud, GPS_RATES[0]), 8, Parity.None, 1, FlowControl.None) onerror (err error) {
			fail err unless err.code == "EBUSY"
			// gpsd holds the receivers it reads: read this one through it.
			let path = "/dev/" + id[7:]
			for let (_, d) in gpsdDevices(gpsd) {
				if d.id == "gpsd:" + path {
					let socket = __net_dial_stream(gpsd, GPSD_CONNECT) onerror recover -1
					if socket >= 0 {
						let watching = true
						let via = gpsdReceiver(socket, d.id, path) onerror (watchErr error) {
							watching = false
							recover new Gps(d)
						}
						return via when watching
					}
				}
			}
			fail err
		}
		let receiver = new Gps(port.device)
		receiver.port = port
		if baud <= 0 {
			findRate(receiver, port) onerror (err error) {
				receiver.close()
				fail err
			}
		}
		return receiver
	}

	// The GPS receivers on serial ports, listed without the `list`
	// permission: knowing the location is the one permission GPS takes.
	internal def gpsReceivers() Device[] {
		let out Device[]
		for let (_, d) in scanDevices() {
			out.push(d) when d.kind == DeviceKind.Gps
		}
		return out
	}

	// Tries the usual rates until the receiver's bytes hold a sentence
	// whose checksum is right; what came at that rate stays to be decoded.
	//
	// Fails when no rate gives one.
	internal def findRate(receiver Gps, port SerialPort) !none {
		for let (i, rate) in GPS_RATES {
			if i > 0 {
				try port.configure(baud = rate)
				try port.discard()
			}
			let started = time.monoNs()
			for duration(time.monoNs() - started) < RATE_PROBE {
				let _ = try pump(receiver, RATE_SLICE)
				return none when receiver.sentences.len() > 0
			}
		}
		fail "devices: {port.device.id} sends no NMEA sentences at any of {GPS_RATES} baud"
	}

	// A Gps reading gpsd's reports on a connection, of one device's path or
	// of all; the connection is closed when gpsd does not answer.
	//
	// Fails when gpsd does not greet or will not watch.
	internal def gpsdReceiver(socket int, id string, path string) !Gps {
		let receiver = new Gps(Device{id: id, kind: DeviceKind.Gps, name: path == "" ?? ("gpsd", "gpsd: " + path), vendorId: 0, productId: 0, vendor: "", product: "", serial: "", node: "", bus: "gpsd"})
		receiver.socket = socket
		let watch = path == "" ?? ("", ",\"device\":\"{path}\"")
		__net_write(socket, "?WATCH=\{\"enable\":true,\"json\":true,\"nmea\":true{watch}};\n".bytes(), GPSD_CONNECT) onerror (err error) {
			receiver.close()
			fail Error{message: "devices: gpsd would not take the watch request: {err.message}", code: err.code, cause: err}
		}
		return receiver
	}

	// The receivers gpsd reads, as devices (`gpsd:<path>`); empty when gpsd
	// does not run or does not answer within a second.
	internal def gpsdDevices(address string) Device[] {
		let out Device[]
		let socket = __net_dial_stream(address, GPSD_CONNECT) onerror recover -1
		return out when socket < 0
		defer closeSocket(socket)
		__net_write(socket, "?DEVICES;\n".bytes(), GPSD_CONNECT) onerror recover 0
		let pending byte[]
		let buf byte[]
		buf.len(GPSD_READ)
		let started = time.monoNs()
		for duration(time.monoNs() - started) < GPSD_CONNECT {
			let n = __net_read(socket, buf, GPSD_CONNECT) onerror recover 0
			return out when n <= 0
			pending.push(...buf.slice(0, n))
			let start = 0
			for let i = 0; i < pending.len(); i++ {
				continue unless pending[i] == byte(10)
				let line = string(pending.slice(start, i - start))
				start = i + 1
				let parsed = new JSON().parse(line) onerror recover none
				let report = anyMap(parsed)
				continue unless anyText(report.get("class")) == "DEVICES"
				for let (_, entry) in anyList(report.get("devices")) {
					let d = anyMap(entry)
					let path = anyText(d.get("path"))
					continue when path == ""
					let driver = anyText(d.get("driver"))
					let subtype = anyText(d.get("subtype"))
					out.push(Device{
						id:        "gpsd:" + path,
						kind:      DeviceKind.Gps,
						name:      driver == "" ?? (path, driver),
						vendorId:  0,
						productId: 0,
						vendor:    driver,
						product:   subtype,
						serial:    "",
						node:      "",
						bus:       "gpsd",
					})
				}
				return out
			}
			pending = pending[start:].clone()
		}
		return out
	}

	// A fix from gpsd's TPV report, with the satellites and DOPs of the
	// last SKY report.
	internal def tpvFix(report map<string, any>, sky GpsFix) GpsFix {
		let fix = GpsFix{}
		let mode = anyNumber(report.get("mode"))
		let m = 0
		if !(mode is none) {
			let v float = mode
			m = int(v)
		}
		fix.mode = m == 3 ?? (FixMode.ThreeD, m == 2 ?? (FixMode.TwoD, FixMode.None))
		let stamp = anyText(report.get("time"))
		if stamp != "" {
			let parsed = true
			let at = time.parse(stamp) onerror (err error) {
				parsed = false
				recover new time.Time()
			}
			fix.time = at when parsed
		}
		let lat = anyNumber(report.get("lat"))
		let lon = anyNumber(report.get("lon"))
		if m >= 2 && !(lat is none) && !(lon is none) {
			let la float = lat
			let lo float = lon
			let at = new Coordinate(la, lo)
			at.altitude = anyNumber(report.get("altHAE"))
			fix.position = at
		}
		fix.altitude = anyNumber(report.get("altMSL"))
		fix.altitude = anyNumber(report.get("alt")) when fix.altitude is none
		fix.geoidSeparation = anyNumber(report.get("geoidSep"))
		fix.speed = anyNumber(report.get("speed"))
		fix.course = anyNumber(report.get("track"))
		fix.climb = anyNumber(report.get("climb"))
		fix.magneticVariation = anyNumber(report.get("magvar"))
		fix.differentialAge = anyNumber(report.get("dgpsAge"))
		let station = anyNumber(report.get("dgpsSta"))
		if !(station is none) {
			let v float = station
			fix.differentialStation = int(v)
		}
		fix.quality = FixQuality.None
		if m >= 2 {
			let status = anyNumber(report.get("status"))
			let st = 1
			if !(status is none) {
				let v float = status
				st = int(v)
			}
			fix.quality = gpsdQuality(st)
		}
		fix.satellites = sky.satellites
		fix.satellitesInView = sky.satellitesInView
		fix.satellitesUsed = sky.satellitesUsed
		fix.pdop = sky.pdop
		fix.hdop = sky.hdop
		fix.vdop = sky.vdop
		return fix
	}

	// The satellites, counts and DOPs of gpsd's SKY report; a field the
	// report leaves out keeps what the last one said, as gpsd sends some
	// only now and then. With the satellite list the counts are the
	// list's, one a satellite.
	internal def skyFix(report map<string, any>, before GpsFix) GpsFix {
		let out = before
		let list = report.get("satellites")
		if !(list is none) {
			let satellites Satellite[]
			for let (_, entry) in anyList(list) {
				let sat = anyMap(entry)
				let gnss = anyNumber(sat.get("gnssid"))
				let prn = anyNumber(sat.get("PRN"))
				let svid = anyNumber(sat.get("svid"))
				continue when prn is none && svid is none
				let number = 0
				let system = GnssSystem.Gps
				if !(gnss is none) && !(svid is none) {
					let g float = gnss
					let v float = svid
					system = gpsdSystem(int(g))
					number = int(v)
				} else {
					// gpsd's own numbering, which follows NMEA's ranges.
					let v = 0.0
					let given = prn is none ?? (svid, prn)
					if !(given is none) {
						let n float = given
						v = n
					}
					number = int(v)
					system = systemOfTalker("GN", number)
				}
				let snr = anyNumber(sat.get("ss"))
				let strength ?int = none
				if !(snr is none) {
					let v float = snr
					strength = int(v) when v > 0.0
				}
				let one = Satellite{
					system:    system,
					prn:       number,
					elevation: wholeOf(anyNumber(sat.get("el"))),
					azimuth:   wholeOf(anyNumber(sat.get("az"))),
					snr:       strength,
					used:      anyBool(sat.get("used")),
				}
				// gpsd lists a satellite once a signal (L1, L5, E5a):
				// one satellite, the strongest signal, used when any is.
				let same = -1
				for let (i, s) in satellites {
					if s.system == system && s.prn == number {
						same = i
						break
					}
				}
				if same < 0 {
					satellites.push(one)
					continue
				}
				let had = satellites[same]
				one.snr = had.snr when strongerSnr(had, one)
				one.used = one.used || had.used
				satellites[same] = one
			}
			out.satellites = satellites
			out.satellitesInView = satellites.len()
			out.satellitesUsed = satellites.filter((s) => s.used).len()
		} else {
			// Counts gpsd sends without the list, of signals as it counts them.
			let seen = anyNumber(report.get("nSat"))
			if !(seen is none) {
				let v float = seen
				out.satellitesInView = int(v)
			}
			let used = anyNumber(report.get("uSat"))
			if !(used is none) {
				let v float = used
				out.satellitesUsed = int(v)
			}
		}
		let pdop = anyNumber(report.get("pdop"))
		out.pdop = pdop unless pdop is none
		let hdop = anyNumber(report.get("hdop"))
		out.hdop = hdop unless hdop is none
		let vdop = anyNumber(report.get("vdop"))
		out.vdop = vdop unless vdop is none
		return out
	}

	// gpsd's TPV status as a FixQuality: 1 a plain fix, 2 differential, 3
	// RTK fixed, 4 RTK float, 5 and 6 dead reckoning, 7 surveyed, 8
	// simulated, 9 P(Y) code.
	internal def gpsdQuality(status int) FixQuality {
		match status {
			case 2:
				return FixQuality.Differential
			case 3:
				return FixQuality.RtkFixed
			case 4:
				return FixQuality.RtkFloat
			case 5, 6:
				return FixQuality.Estimated
			case 7:
				return FixQuality.Manual
			case 8:
				return FixQuality.Simulation
			case 9:
				return FixQuality.Pps
		}
		return FixQuality.Gps
	}

	// gpsd's (and u-blox's) gnssid as a GnssSystem: 0 GPS, 1 SBAS, 2
	// Galileo, 3 BeiDou, 5 QZSS, 6 GLONASS, 7 NavIC.
	internal def gpsdSystem(id int) GnssSystem {
		match id {
			case 1:
				return GnssSystem.Sbas
			case 2:
				return GnssSystem.Galileo
			case 3:
				return GnssSystem.Beidou
			case 5:
				return GnssSystem.Qzss
			case 6:
				return GnssSystem.Glonass
			case 7:
				return GnssSystem.Navic
		}
		return GnssSystem.Gps
	}

	// Closes a socket, quietly.
	internal def closeSocket(fd int) {
		__net_close(fd) onerror recover none
	}

	// A JSON object (or D-Bus dictionary) as a map; empty for anything else.
	internal def anyMap(v ?any) map<string, any> {
		let nothing map<string, any> = {}
		match v {
			case map<string, any>:
				return v
			default:
				return nothing
		}
	}

	// A JSON or D-Bus array; empty for anything else.
	internal def anyList(v ?any) any[] {
		let nothing any[] = []
		match v {
			case any[]:
				return v
			default:
				return nothing
		}
	}

	// A string; "" for anything else.
	internal def anyText(v ?any) string {
		match v {
			case string:
				return v
			default:
				return ""
		}
	}

	// A number; none for anything else.
	internal def anyNumber(v ?any) ?float {
		match v {
			case int:
				return float(v)
			case float:
				return v
			default:
				return none
		}
	}

	// A boolean; false for anything else.
	internal def anyBool(v ?any) bool {
		match v {
			case bool:
				return v
			default:
				return false
		}
	}

	// A number without its fraction, none for none.
	internal def wholeOf(v ?float) ?int {
		return none when v is none
		let f float = v
		return int(f)
	}

	// Where gpsd listens.
	internal const GPSD_ADDRESS = "127.0.0.1:2947"
	internal const GPSD_CONNECT = 1s
	internal const GPSD_READ = 8192
	internal const GPSD_LONGEST = 65536
	// The rates a receiver is looked for at, the commonest first.
	internal const GPS_RATES = [9600, 4800, 38400, 115200, 57600, 19200, 230400]
	// How long a rate is listened at: longer than a receiver's quietest
	// second.
	internal const RATE_PROBE = 1500ms
	internal const RATE_SLICE = 250ms
	// How long a receiver stays quiet before the epoch it was in is over.
	internal const QUIET = 250ms
	// The fixes and sentences kept for a reader that does not take them.
	internal const KEEP_FIXES = 16
	internal const KEEP_SENTENCES = 256
}
