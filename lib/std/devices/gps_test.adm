partial module std.devices {
	use (
		std.testing
		std.math.geo::(Coordinate)
		std.time
		std.services.devices::(Device, DeviceKind)
		std.services.policy::(Policy, PolicyDenied)
	)

	// A gpsd the suite plays: on a local port it takes connections one
	// after another, reads each one's request and answers it with the lines
	// scripted for it.
	internal type FakeGpsd {
		internal listener int
		internal scripts  string[][]
		// The request each connection sent.
		internal asked    string[]
		internal done     channel<none>

		internal def new(listener int, scripts string[][]) {
			self.listener = listener
			self.scripts = scripts
			done = new channel<none>(1)
		}

		// Where it listens, `127.0.0.1:port`.
		def address() string {
			return __net_local_addr(listener) onerror recover ""
		}

		// Serves the scripts, one a connection.
		def serve() {
			for let (_, script) in scripts {
				let fd = __net_accept(listener) onerror recover -1
				break when fd < 0
				let request byte[]
				let buf byte[]
				buf.len(512)
				for request.indexOf(byte(10)) < 0 {
					let n = __net_read(fd, buf, 2s) onerror recover 0
					break when n <= 0
					request.push(...buf.slice(0, n))
				}
				note(string(request).trim())
				for let (_, line) in script {
					__net_write(fd, (line + "\r\n").bytes(), 2s) onerror recover 0
				}
				// Leave the connection open until the client has read it all.
				let _ = __net_read(fd, buf, 300ms) onerror recover 0
				__net_close(fd) onerror recover none
			}
			done <- none
		}

		atomic def note(request string) {
			asked.push(request)
		}

		atomic def requests() string[] {
			return asked.clone()
		}

		// Waits for the scripts to be served and stops listening.
		def stop() {
			let _ = <-done
			__net_close(listener) onerror recover none
		}
	}

	// Starts a fake gpsd on a free local port.
	//
	// Fails when no local port can be had.
	internal def fakeGpsd(scripts string[][]) !FakeGpsd {
		let listener = try __net_socket(2, 1)
		try __net_bind(listener, "127.0.0.1:0")
		try __net_listen(listener, 4)
		let server = new FakeGpsd(listener, scripts)
		async server.serve()
		return server
	}

	// What gpsd 3.25 sends a client that watches a u-blox receiver: its
	// greeting, the devices, the watch, a SKY, a TPV, the NMEA it passes on
	// and a TPV of the next second.
	internal const GPSD_SESSION = [
		"\{\"class\":\"VERSION\",\"release\":\"3.25\",\"rev\":\"3.25\",\"proto_major\":3,\"proto_minor\":15}",
		"\{\"class\":\"DEVICES\",\"devices\":[\{\"class\":\"DEVICE\",\"path\":\"/dev/ttyACM0\",\"driver\":\"u-blox\",\"subtype\":\"SW ROM CORE 3.01 (107888),HW 00080000\",\"activated\":\"2026-10-22T10:00:00.000Z\",\"flags\":1,\"native\":1,\"bps\":9600,\"parity\":\"N\",\"stopbits\":1,\"cycle\":1.00,\"mincycle\":0.25}]}",
		"\{\"class\":\"WATCH\",\"enable\":true,\"json\":true,\"nmea\":true,\"raw\":0,\"scaled\":false,\"timing\":false,\"split24\":false,\"pps\":false}",
		"\{\"class\":\"SKY\",\"device\":\"/dev/ttyACM0\",\"time\":\"2026-10-22T10:00:01.000Z\",\"xdop\":0.54,\"ydop\":0.77,\"vdop\":1.20,\"tdop\":0.85,\"hdop\":0.94,\"gdop\":1.73,\"pdop\":1.52,\"nSat\":4,\"uSat\":3,\"satellites\":[\{\"PRN\":5,\"el\":31.0,\"az\":86.0,\"ss\":45.0,\"used\":true,\"gnssid\":0,\"svid\":5,\"health\":1},\{\"PRN\":5,\"el\":31.0,\"az\":86.0,\"ss\":48.0,\"used\":false,\"gnssid\":0,\"svid\":5,\"sigid\":7,\"health\":1},\{\"PRN\":66,\"el\":40.0,\"az\":210.0,\"ss\":38.0,\"used\":true,\"gnssid\":6,\"svid\":2,\"sigid\":0,\"freqid\":11,\"health\":1},\{\"PRN\":301,\"el\":12.0,\"az\":330.0,\"ss\":0.0,\"used\":false,\"gnssid\":2,\"svid\":1,\"health\":1}]}",
		"\{\"class\":\"TPV\",\"device\":\"/dev/ttyACM0\",\"status\":2,\"mode\":3,\"time\":\"2026-10-22T10:00:01.000Z\",\"leapseconds\":18,\"ept\":0.005,\"lat\":52.520008000,\"lon\":13.404954000,\"altHAE\":80.500,\"altMSL\":41.200,\"alt\":41.200,\"epx\":2.1,\"epy\":2.9,\"epv\":4.8,\"track\":45.0000,\"magtrack\":49.1000,\"magvar\":4.1,\"speed\":1.250,\"climb\":-0.050,\"eps\":0.20,\"epc\":9.60,\"geoidSep\":39.300,\"eph\":3.6,\"sep\":6.0}",
		"$GNGLL,5231.20048,N,01324.29724,E,100001.00,A,D*77",
		"\{\"class\":\"TPV\",\"device\":\"/dev/ttyACM0\",\"mode\":1,\"time\":\"2026-10-22T10:00:02.000Z\"}",
	]

	check "GPS receivers" {
		// A receiver on a serial port (a pseudo-terminal plays it): the
		// fixes of its epochs as they end, its sentences beside them, a lost
		// fix, and silence failing the wait.
		@os("linux")
		@test()
		def TestReceiverOnASerialPort() !none {
			let (port, pty) = try pseudoPort()
			defer releaseFar(pty)
			let gps = new Gps(port.device)
			gps.port = port
			defer gps.close()
			let first = UBLOX_EPOCH_1.join("\r\n") + "\r\n"
			let second = UBLOX_EPOCH_2.join("\r\n") + "\r\n"
			// The first epoch is known to be over when the second starts.
			try __fs_write(pty.far, (first + second).bytes())
			let one = try gps.fix(2s)
			let position = one.position
			fail "no position" when position is none
			let at Coordinate = position
			assert near(at.latitude, 47.0 + 17.11437 / 60.0) && one.satellitesUsed == 12 && one.mode == FixMode.ThreeD
			// The second ends on its last sentence, with no third to wait for.
			let two = try gps.fix(2s)
			assert near(two.altitude, 499.8)
			assert near(gps.last().altitude, 499.8)
			// Every sentence is there to read as well, in order.
			let s = try gps.sentence(1s)
			fail "no sentence" when s is none
			let rmc NmeaSentence = s
			assert rmc.talker == "GN" && rmc.kind == "RMC" && rmc.field(0) == "083559.00"
			let count = 1
			for {
				let next = try gps.sentence(10ms)
				break when next is none
				count++
			}
			assert count == UBLOX_EPOCH_1.len() + UBLOX_EPOCH_2.len()
			try __fs_write(pty.far, (UBLOX_EPOCH_3.join("\r\n") + "\r\n").bytes())
			let lost = try gps.fix(2s)
			assert lost.position is none && lost.mode == FixMode.None
			let code = ""
			gps.fix(300ms) onerror (err error) {
				code = err.code
				recover GpsFix{}
			}
			assert code == "ETIMEDOUT"
			gps.close()
			assert !gps.isOpen()
			let closed = false
			gps.fix(10ms) onerror (err error) {
				closed = err.message.contains("closed")
				recover GpsFix{}
			}
			assert closed
			return none
		}

		// A receiver that leaves the last epoch unfinished and goes quiet
		// still hands it out; a receiver found by its rate starts at the
		// first rate that carries sentences.
		@os("linux")
		@test()
		def TestQuietReceiverAndRate() !none {
			let (port, pty) = try pseudoPort()
			defer releaseFar(pty)
			let gps = new Gps(port.device)
			gps.port = port
			defer gps.close()
			try __fs_write(pty.far, (string(byte[0, 0]) + "garbage\r\n" + CLASSIC_SENTENCES[0] + "\r\n").bytes())
			try findRate(gps, port)
			assert port.baud == 9600
			let fix = try gps.fix(2s)
			assert near(fix.altitude, 545.4) && fix.quality == FixQuality.Gps
			return none
		}

		// Through gpsd: the watch asked for, the devices it lists, a TPV
		// with the last SKY's satellites, the NMEA it passes on, a TPV
		// without a fix.
		@test()
		def TestGpsdReports() !none {
			let server = try fakeGpsd([GPSD_SESSION, GPSD_SESSION.slice(0, 2)])
			let address = server.address()
			let gps = try openGpsAt("gpsd:/dev/ttyACM0", 0, address)
			assert gps.device.id == "gpsd:/dev/ttyACM0" && gps.device.bus == "gpsd"
			let fix = try gps.fix(2s)
			let position = fix.position
			fail "no position" when position is none
			let at Coordinate = position
			assert near(at.latitude, 52.520008) && near(at.longitude, 13.404954) && near(at.altitude, 80.5)
			assert near(fix.altitude, 41.2) && near(fix.geoidSeparation, 39.3) && near(fix.speed, 1.25) && near(fix.course, 45.0)
			assert near(fix.climb, -0.05) && near(fix.magneticVariation, 4.1)
			assert fix.quality == FixQuality.Differential && fix.mode == FixMode.ThreeD
			let stamp = fix.time
			fail "no time" when stamp is none
			let t time.Time = stamp
			assert t.str() == "2026-10-22T10:00:01Z"
			assert fix.satellitesInView == 3 && fix.satellitesUsed == 2 && near(fix.hdop, 0.94) && near(fix.pdop, 1.52)
			let glonass = satelliteOf(fix, GnssSystem.Glonass, 2)
			fail "GLONASS 2 missing" when glonass is none
			let g Satellite = glonass
			assert g.used && holds(g.elevation, 40) && holds(g.snr, 38)
			// GPS 5's two signals are one satellite, used, at its stronger signal.
			let five = satelliteOf(fix, GnssSystem.Gps, 5)
			fail "GPS 5 missing" when five is none
			let f Satellite = five
			assert f.used && holds(f.snr, 48)
			let galileo = satelliteOf(fix, GnssSystem.Galileo, 1)
			fail "Galileo 1 missing" when galileo is none
			let e Satellite = galileo
			assert !e.used && e.snr is none
			let sentence = try gps.sentence(1s)
			fail "no sentence" when sentence is none
			let gll NmeaSentence = sentence
			assert gll.kind == "GLL"
			let lost = try gps.fix(2s)
			assert lost.position is none && lost.mode == FixMode.None && lost.quality == FixQuality.None
			gps.close()
			let listed = gpsdDevices(address)
			server.stop()
			assert listed.len() == 1 && listed[0].id == "gpsd:/dev/ttyACM0" && listed[0].kind == DeviceKind.Gps
			assert listed[0].vendor == "u-blox" && listed[0].product.startsWith("SW ROM CORE")
			let asked = server.requests()
			assert asked.len() == 2
			assert asked[0] == "?WATCH=\{\"enable\":true,\"json\":true,\"nmea\":true,\"device\":\"/dev/ttyACM0\"};"
			assert asked[1] == "?DEVICES;"
			return none
		}

		// Ids that name no receiver, and gpsd not running, are refused;
		// nothing listens at a closed port.
		@test()
		def TestOpenGpsRefuses() !none {
			let refused = 0
			openGps("video:video0") onerror (err error) {
				refused++
				recover new Gps(Device{})
			}
			openGpsAt("gpsd", 0, "127.0.0.1:1") onerror (err error) {
				refused += 1 when err.message.contains("gpsd does not run")
				recover new Gps(Device{})
			}
			assert refused == 2
			assert gpsdDevices("127.0.0.1:1").len() == 0
			// Location is one permission: denied, no receiver opens, whichever it is.
			try Policy.configure("[adm.devices.location]\n\"*\".deny = [\"*\"]\n")
			let denials = 0
			for let (_, id) in ["", "gpsd", "serial:ttyACM0"] {
				openGps(id) onerror (err error) {
					denials += 1 when err is PolicyDenied
					recover new Gps(Device{})
				}
			}
			try Policy.configure("")
			assert denials == 3
			for let (_, d) in gpsDevices() onerror recover [] {
				assert d.kind == DeviceKind.Gps
			}
			assert gpsdQuality(3) == FixQuality.RtkFixed && gpsdSystem(6) == GnssSystem.Glonass
			return none
		}
	}
}
