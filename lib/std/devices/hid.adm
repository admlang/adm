// Raw HID devices: keyboards' and mice's vendor interfaces, game controllers,
// security keys, LED and display controllers, anything that speaks reports.
//
// `hidDevices()` names them (with the usage page of each one's report
// descriptor), `openHid(id)` opens one, and a `HidDevice` sends output
// reports, waits for input reports and exchanges feature reports. Report
// contents are the device's own business: callers lay them out from the
// device's report descriptor or its documentation.
//
// Example: the next input report of the first game pad
// ```example
// use std.devices
//
// let pads = try devices.hidDevices(0x01)
// let pad = try devices.openHid(pads[0].id)
// defer pad.close()
// let report = try pad.read(1s)
// ```
partial module std.devices {
	use (
		std.services.storage::(Storage)
		std.services.devices::(Device, DeviceKind, Devices)
		std.devices.hidraw::*
		std.devices.structs::*
	)

	// The raw HID devices, one per hidraw node. Fails when the policy denies
	// listing devices.
	def hidDevices() !Device[] {
		let out Device[] = []
		for let (_, d) in try Devices.list(DeviceKind.Hid) {
			out.push(d) when d.id.startsWith("hidraw:")
		}
		return out
	}

	// The raw HID devices whose first top-level collection is on a usage
	// page: 0x01 generic desktop (mice, keyboards, game pads), 0x0C consumer
	// controls, 0xF1D0 FIDO security keys, 0xFF00 to 0xFFFF vendor defined.
	// Fails when the policy denies listing devices.
	def hidDevices(usagePage int) !Device[] {
		let out Device[] = []
		for let (_, d) in try hidDevices() {
			out.push(d) when d.usagePage == usagePage
		}
		return out
	}

	// An open raw HID device. openHid returns one; close it when done, or let
	// it go: dispose closes it.
	type HidDevice {
		// The device the reports come from.
		device Device

		// The device's descriptor, -1 once closed.
		internal fd int = -1

		def new(device Device, fd int) {
			self.device = device
			self.fd = fd
		}

		// Sends an output report. For a device with numbered reports pass its
		// report id; 0 for one without. Fails when the device is closed or
		// refuses the report.
		def write(report byte[], reportId int = 0) !none {
			fail "devices: {device.id} is closed" when fd < 0
			let out byte[] = [byte(reportId)]
			out.push(...report)
			try Storage.write(fd, out)
			return none
		}

		// The next input report, waiting up to timeout; none when none
		// arrives. A device with numbered reports puts the report id first.
		// Fails when the device is closed or the read fails, as it does
		// when the device is unplugged.
		def read(timeout duration) !?byte[] {
			fail "devices: {device.id} is closed" when fd < 0
			let ready = try Storage.wait(fd, timeout)
			return none when !ready
			let buf byte[]
			buf.len(MAX_REPORT)
			let n = try Storage.read(fd, buf)
			return buf.slice(0, n).clone()
		}

		// Reads a feature report: the report id first, then the report, length
		// bytes in all (HIDIOCGFEATURE). Fails when the device is closed or
		// has no such feature report.
		def feature(reportId int, length int) !byte[] {
			fail "devices: {device.id} is closed" when fd < 0
			fail "devices: a feature report is 1 to {MAX_REPORT} bytes" when length < 1 || length > MAX_REPORT
			let buf byte[]
			buf.len(length)
			buf[0] = byte(reportId)
			return try Storage.control(fd, getFeatureRequest(length), buf)
		}

		// Sends a feature report (HIDIOCSFEATURE). Fails when the device is
		// closed or refuses it.
		def feature(reportId int, report byte[]) !none {
			fail "devices: {device.id} is closed" when fd < 0
			let buf byte[] = [byte(reportId)]
			buf.push(...report)
			fail "devices: a feature report is at most {MAX_REPORT} bytes" when buf.len() > MAX_REPORT
			try Storage.control(fd, setFeatureRequest(buf.len()), buf)
			return none
		}

		// The report descriptor, which says what every report holds (HID 1.11
		// §6.2.2). Fails when the device is closed or the driver will not
		// hand it over.
		def descriptor() !byte[] {
			fail "devices: {device.id} is closed" when fd < 0
			let size = u32(try Storage.control(fd, HIDIOCGRDESCSIZE, byte[0, 0, 0, 0]), 0)
			let buf byte[]
			buf.len(4 + MAX_DESCRIPTOR)
			putU32(buf, 0, size)
			let out = try Storage.control(fd, HIDIOCGRDESC, buf)
			return out.slice(4, size).clone()
		}

		// Closes the device; a closed device stays closed.
		def close() {
			return when fd < 0
			Devices.close(fd) onerror recover none
			fd = -1
		}

		// Whether the device is open.
		def isOpen() bool {
			return fd >= 0
		}

		// Closing on dispose, so a device nobody holds any more is released.
		def dispose() {
			close()
		}
	}

	// Opens the raw HID device behind an id from hidDevices. Fails when there
	// is no such device, it is not a raw HID device, or it cannot be opened
	// (on Linux the user needs read and write access to its hidraw node,
	// which udev grants to security keys and game pads for the desktop
	// user).
	def openHid(id string) !HidDevice {
		let found = try Devices.get(id)
		fail "devices: no device with the id {id}" when found is none
		let device Device = found
		fail "devices: {id} is not a raw HID device" when device.kind != DeviceKind.Hid || !id.startsWith("hidraw:")
		return new HidDevice(device, try Devices.open(id))
	}
}

internal partial module std.devices.hidraw {
	use std.devices::*

	// The Linux hidraw interface (linux/hidraw.h): reports are read and
	// written on the node, everything else goes through ioctls.

	// The largest report a read takes and a feature report may have; HID
	// reports are far smaller, high-speed USB caps them at 1024 bytes.
	const MAX_REPORT = 4096

	// HID_MAX_DESCRIPTOR_SIZE.
	const MAX_DESCRIPTOR = 4096

	// _IOR('H', 0x01, int): the report descriptor's size.
	const HIDIOCGRDESCSIZE = 0x80044801

	// _IOR('H', 0x02, struct hidraw_report_descriptor): its bytes, after a
	// u32 size.
	const HIDIOCGRDESC = 0x90044802

	// _IOC(_IOC_WRITE|_IOC_READ, 'H', 0x07, len): HIDIOCGFEATURE(len).
	def getFeatureRequest(length int) int {
		return 0xC0004807 | (length << 16)
	}

	// _IOC(_IOC_WRITE|_IOC_READ, 'H', 0x06, len): HIDIOCSFEATURE(len).
	def setFeatureRequest(length int) int {
		return 0xC0004806 | (length << 16)
	}
}
