partial module std.devices {
	use (
		std.testing
		std.services.devices::(Device)
		std.devices.hidraw::*
	)

	check "HID" {
		@test()
		def TestHidListing() !none {
			// Whatever this machine has: only hidraw nodes, and the usage page
			// filter keeps a subset.
			let all = try hidDevices()
			for let (_, d) in all {
				assert d.id.startsWith("hidraw:") && d.node.startsWith("/dev/hidraw")
			}
			let fido = try hidDevices(0xF1D0)
			assert fido.len() <= all.len()
			for let (_, d) in fido {
				assert d.usagePage == 0xF1D0
			}
			return none
		}

		@test()
		def TestHidRequests() {
			// The hidraw ioctl numbers of linux/hidraw.h.
			assert getFeatureRequest(65) == 0xC0414807
			assert setFeatureRequest(9) == 0xC0094806
			assert HIDIOCGRDESCSIZE == 0x80044801 && HIDIOCGRDESC == 0x90044802
		}

		@test()
		def TestOpenHidRefuses() !none {
			let missing = true
			openHid("hidraw:nothing") onerror (err error) {
				missing = false
				recover new HidDevice(Device{}, -1)
			}
			assert !missing
			let closed = new HidDevice(Device{id: "hidraw:x"}, -1)
			assert !closed.isOpen()
			let failed = false
			closed.write(byte[1]) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			let getFailed = false
			closed.feature(1, 8) onerror (err error) {
				getFailed = true
				recover byte[]
			}
			let setFailed = false
			closed.feature(1, byte[1, 2]) onerror (err error) {
				setFailed = true
				recover none
			}
			assert getFailed && setFailed
			closed.close()
			return none
		}

		@test()
		def TestHidDescriptorAndRead() !none {
			// Every HID device this user may open: its descriptor through the
			// driver matches the usage page the listing read, and a short read
			// returns or times out.
			for let (_, d) in try hidDevices() {
				let opened = true
				let dev = openHid(d.id) onerror (err error) {
					// No access to this node (most are root-only).
					opened = false
					recover new HidDevice(d, -1)
				}
				continue when !opened
				let desc = try dev.descriptor()
				assert desc.len() > 0
				if d.usagePage == 0xF1D0 {
					assert desc.slice(0, 3).equals(byte[0x06, 0xD0, 0xF1])
				}
				try dev.read(10ms)
				dev.close()
				assert !dev.isOpen()
			}
			return none
		}
	}
}
