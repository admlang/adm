partial module std.devices {
	use (
		std.testing
		std.time
		std.services.storage::(Storage)
		std.services.devices::(Device, DeviceKind)
		std.devices.evdev::*
		std.devices.structs::*
	)

	// An input node's bytes: one input_event per (type, code, value), each
	// stamped `seconds` and 250 µs.
	internal def rawEvents(seconds int, events int[][]) byte[] {
		let out byte[]
		for let (_, e) in events {
			let one = encodeEvent(e[0], e[1], e[2])
			putU64(one, EVENT_SECONDS, int64(seconds))
			putU64(one, EVENT_MICROSECONDS, int64(250))
			out.push(...one)
		}
		return out
	}

	// An input device reading the bytes from a memory file in place of a node.
	internal def recordedInput(data byte[]) !InputDevice {
		let fd = try Storage.memoryFile("input-events")
		try Storage.write(fd, data)
		try Storage.seek(fd, int64(0), 0)
		return new InputDevice(Device{id: "input:recorded", kind: DeviceKind.Gamepad, name: "recorded"}, fd)
	}

	// A game pad the kernel's uinput makes for the suite: two sticks, the
	// face and shoulder buttons, two rumble motors. It answers the kernel's
	// force-feedback uploads as a driver would, on its own task, and counts
	// the rumbles played. None when this user may not open /dev/uinput.
	internal type VirtualPad {
		internal fd      int           = -1
		// The pad's event node, `input:eventN`.
		internal node    string        = ""
		internal running bool          = true
		internal played  int           = 0
		internal stopped int           = 0
		internal served  channel<none>

		internal def new(fd int, node string) {
			self.fd = fd
			self.node = node
			served = new channel<none>(1)
		}

		def id() string {
			return node
		}

		// Sends events and the report that ends them.
		def send(events int[][]) !none {
			for let (_, e) in events {
				try __fs_write(fd, encodeEvent(e[0], e[1], e[2]))
			}
			try __fs_write(fd, encodeEvent(EV_SYN, SYN_REPORT, 0))
			return none
		}

		// Answers uploads and erases and counts the plays until stopped.
		// The intrinsics are called directly: a rumble's upload holds the
		// Storage service until this answers it.
		def serve() {
			let buf byte[]
			buf.len(16 * EVENT_SIZE)
			for isRunning() {
				let ready = __fs_wait(fd, 50ms, false) onerror recover false
				continue unless ready
				let n = __fs_read(fd, buf) onerror recover 0
				for let at = 0; at + EVENT_SIZE <= n; at += EVENT_SIZE {
					let e = decodeEvent(buf, at)
					if e.kind == EV_UINPUT && e.code == UI_FF_UPLOAD {
						let upload = zeroed(UPLOAD_SIZE)
						putU32(upload, 0, e.value)
						__fs_ioctl(fd, UI_BEGIN_FF_UPLOAD, upload) onerror recover 0
						putU32(upload, 4, 0)
						__fs_ioctl(fd, UI_END_FF_UPLOAD, upload) onerror recover 0
					} else if e.kind == EV_UINPUT && e.code == UI_FF_ERASE {
						let erase = zeroed(ERASE_SIZE)
						putU32(erase, 0, e.value)
						__fs_ioctl(fd, UI_BEGIN_FF_ERASE, erase) onerror recover 0
						putU32(erase, 4, 0)
						__fs_ioctl(fd, UI_END_FF_ERASE, erase) onerror recover 0
					} else if e.kind == EV_FF {
						count(e.value)
					}
				}
			}
			served <- none
		}

		atomic def isRunning() bool {
			return running
		}

		atomic def count(value int) {
			played += 1 when value > 0
			stopped += 1 when value == 0
		}

		atomic def plays() (int, int) {
			return (played, stopped)
		}

		// Stops answering and removes the pad.
		def remove() {
			stopAnswering()
			let _ = <-served
			__fs_ioctl_value(fd, UI_DEV_DESTROY, 0) onerror recover 0
			__fs_close(fd) onerror recover none
		}

		atomic def stopAnswering() {
			running = false
		}
	}

	// Makes a virtual game pad and starts answering it, or none when this
	// user may not open /dev/uinput.
	//
	// Fails when the kernel refuses the pad.
	internal def virtualPad() !?VirtualPad {
		let fd = __fs_open("/dev/uinput", "r+") onerror recover -1
		return none when fd < 0
		for let (_, kind) in [EV_KEY, EV_ABS, EV_FF] {
			try __fs_ioctl_value(fd, UI_SET_EVBIT, kind)
		}
		for let code = BTN_SOUTH; code <= BTN_THUMBR; code++ {
			try __fs_ioctl_value(fd, UI_SET_KEYBIT, code)
		}
		for let (_, axisCode) in [0, 1, 3, 4] {
			try __fs_ioctl_value(fd, UI_SET_ABSBIT, axisCode)
			let setup = zeroed(ABS_SETUP_SIZE)
			putU16(setup, 0, axisCode)
			putU32(setup, 8, -32768 & 0xFFFFFFFF)
			putU32(setup, 12, 32767)
			// No fuzz: the kernel would hold back moves smaller than it.
			putU32(setup, 16, 0)
			putU32(setup, 20, 128)
			try __fs_ioctl(fd, UI_ABS_SETUP, setup)
		}
		try __fs_ioctl_value(fd, UI_SET_FFBIT, FF_RUMBLE)
		let setup = zeroed(DEV_SETUP_SIZE)
		putU16(setup, 0, 0x03)
		putU16(setup, 2, 0x045e)
		putU16(setup, 4, 0x028e)
		putU16(setup, 6, 1)
		let name = "ADM test pad".bytes()
		name.copy(setup.slice(8, 80))
		putU32(setup, 88, 4)
		try __fs_ioctl(fd, UI_DEV_SETUP, setup)
		try __fs_ioctl_value(fd, UI_DEV_CREATE, 0)
		let sysname = zeroed(64)
		try __fs_ioctl(fd, UI_GET_SYSNAME, sysname)
		let input = string(sysname).trim()
		let node = ""
		// udev names the node and grants it to the desktop user (a game pad
		// is tagged uaccess) a moment after the kernel makes it.
		for let tries = 0; tries < 100 && node == ""; tries++ {
			for let (_, entry) in __fs_read_dir("/sys/devices/virtual/input/" + input) onerror recover [] {
				node = "input:" + entry when entry.startsWith("event")
			}
			time.sleep(20ms) when node == ""
		}
		fail "devices: uinput made {input} without an event node" when node == ""
		let pad = new VirtualPad(fd, node)
		async pad.serve()
		return pad
	}

	// linux/uinput.h on 64-bit Linux, as clang computes them.
	internal const UI_SET_EVBIT = 0x40045564
	internal const UI_SET_KEYBIT = 0x40045565
	internal const UI_SET_ABSBIT = 0x40045567
	internal const UI_SET_FFBIT = 0x4004556B
	internal const UI_DEV_CREATE = 0x5501
	internal const UI_DEV_DESTROY = 0x5502
	internal const UI_DEV_SETUP = 0x405C5503
	internal const UI_ABS_SETUP = 0x401C5504
	internal const UI_GET_SYSNAME = 0x8040552C
	internal const UI_BEGIN_FF_UPLOAD = 0xC06855C8
	internal const UI_END_FF_UPLOAD = 0x406855C9
	internal const UI_BEGIN_FF_ERASE = 0xC00C55CA
	internal const UI_END_FF_ERASE = 0x400C55CB
	internal const DEV_SETUP_SIZE = 92
	internal const ABS_SETUP_SIZE = 28
	internal const UPLOAD_SIZE = 104
	internal const ERASE_SIZE = 12
	internal const EV_UINPUT = 0x101
	internal const UI_FF_UPLOAD = 1
	internal const UI_FF_ERASE = 2

	// Opens the pad's node once udev has granted it, trying for two seconds.
	//
	// Fails when it never opens.
	internal def openPad(pad VirtualPad) !InputDevice {
		let last = ""
		for let tries = 0; tries < 100; tries++ {
			let failed = false
			let device = openInput(pad.id()) onerror (err error) {
				failed = true
				last = err.message
				recover new InputDevice(Device{}, -1)
			}
			return device unless failed
			time.sleep(20ms)
		}
		fail "devices: the virtual pad {pad.id()} never opened: {last}"
	}

	check "Input events" {
		// The request numbers and layouts are linux/input.h's on 64-bit Linux,
		// as clang computes them from the header.
		@test()
		def TestEvdevRequests() {
			assert bitsRequest(0, 4) == 0x80044520
			assert bitsRequest(EV_KEY, 96) == 0x80604521
			assert keyStateRequest(96) == 0x80604518
			assert EVIOCGABS_BASE == 0x80184540 && EVIOCGRAB == 0x40044590 && EVIOCSFF == 0x40304580
			assert EVIOCRMFF == 0x40044581 && EVIOCGEFFECTS == 0x80044584 && EVIOCSCLOCKID == 0x400445A0
			assert bitmapBytes(KEY_MAX) == 96 && bitmapBytes(ABS_MAX) == 8
			assert EVENT_SIZE == 24 && ABSINFO_SIZE == 24 && EFFECT_SIZE == 48
		}

		// Bitmaps, events and rumble effects lay out as the kernel reads them.
		@test()
		def TestEvdevStructures() {
			assert setBits(byte[0x05, 0, 0x80]).equals([0, 2, 23])
			assert setBits(byte[0, 0]).len() == 0
			let event = encodeEvent(EV_ABS, 1, -300)
			let back = decodeEvent(event, 0)
			assert back.kind == EV_ABS && back.code == 1 && back.value == -300
			let effect = encodeRumble(-1, 0xFFFF, 0x8000, 250)
			assert u16(effect, EFFECT_TYPE) == FF_RUMBLE && effectId(effect) == -1
			assert u16(effect, EFFECT_LENGTH) == 250 && u16(effect, EFFECT_HEAVY) == 0xFFFF && u16(effect, EFFECT_LIGHT) == 0x8000
			assert effectId(encodeRumble(3, 0, 0, 0)) == 3
		}

		// Events come out a report at a time, kinds and times as the kernel
		// wrote them, and the end of the node fails the read.
		// A memory file stands in for the node, and only Linux has them.
		@os("linux")
		@test()
		def TestReportsComeOutWhole() !none {
			let data = rawEvents(12, [[EV_ABS, 0, 128], [EV_ABS, 1, -5], [EV_SYN, SYN_REPORT, 0], [EV_KEY, 304, 1], [EV_MSC, 4, 9001], [EV_SYN, SYN_REPORT, 0]])
			let pad = try recordedInput(data)
			let first = try pad.read(1s)
			assert first.len() == 2
			assert first[0].kind == InputKind.Absolute && first[0].code == 0 && first[0].value == 128
			assert first[1].value == -5
			assert first[0].time == 12s + 250us
			let second = try pad.read(1s)
			assert second.len() == 2 && second[0].kind == InputKind.Key && second[0].code == 304 && second[0].value == 1
			assert second[1].kind == InputKind.Misc
			let ended = false
			pad.read(10ms) onerror (err error) {
				ended = true
				recover []
			}
			assert ended
			pad.close()
			assert !pad.isOpen()
			let closed = false
			pad.read(10ms) onerror (err error) {
				closed = true
				recover []
			}
			assert closed
			return none
		}

		// A report cut across two reads waits for its end, and events of a
		// type no event carries are left out.
		// A memory file stands in for the node, and only Linux has them.
		@os("linux")
		@test()
		def TestReportAcrossReads() !none {
			let data = rawEvents(1, [[EV_REL, 0, 3], [0x1e, 0, 1], [EV_REL, 1, -2], [EV_SYN, SYN_REPORT, 0]])
			let pad = try recordedInput(data)
			let report = try pad.read(1s)
			assert report.len() == 2 && report[0].kind == InputKind.Relative && report[1].value == -2
			pad.close()
			return none
		}

		// The listing filter and the refusals of openInput.
		@test()
		def TestOpenInputRefuses() !none {
			let all = inputDevices() onerror recover []
			for let (_, d) in all {
				assert d.id.startsWith("input:")
			}
			let pads = inputDevices(DeviceKind.Gamepad) onerror recover []
			for let (_, d) in pads {
				assert d.kind == DeviceKind.Gamepad
			}
			let refused = false
			openInput("video:video0") onerror (err error) {
				refused = true
				recover new InputDevice(Device{}, -1)
			}
			assert refused
			let missing = false
			openInput("input:no-such-node") onerror (err error) {
				missing = true
				recover new InputDevice(Device{}, -1)
			}
			assert missing
			assert inputKindOf(EV_SYN) is none
			let ff = inputKindOf(EV_FF)
			fail "EV_FF has no kind" when ff is none
			let kind InputKind = ff
			assert kind == InputKind.ForceFeedback
			return none
		}

		// A virtual game pad: listed as a game pad, its buttons and axes
		// described, reports read whole, pressed keys seen, a grab taken
		// and given back, a rumble uploaded, played and stopped.
		@test()
		def TestVirtualGamepad() !none {
			let made = try virtualPad()
			return testing.skip("this user may not open /dev/uinput to make a virtual game pad") when made is none
			let pad VirtualPad = made
			let device = openPad(pad) onerror (err error) {
				pad.remove()
				fail err
			}
			let found = (try inputDevices(DeviceKind.Gamepad)).filter((d) => d.id == pad.id())
			let listed = found.len() == 1 && found[0].name == "ADM test pad" && found[0].vendorId == 0x045e
			let keys = try device.keys()
			let axes = try device.axes()
			let kinds = try device.kinds()
			try pad.send([[EV_ABS, 0, 1200], [EV_ABS, 1, -800], [EV_KEY, BTN_SOUTH, 1]])
			let report = try device.read(1s)
			let down = try device.pressed()
			try device.grab()
			try device.release()
			try device.rumble(1.0, 0.25, 300ms)
			try device.rumble(0.5, 0.5, 100ms)
			try device.stopRumble()
			time.sleep(100ms)
			let (played, stopped) = pad.plays()
			device.close()
			pad.remove()

			assert listed
			assert keys.includes(BTN_SOUTH) && keys.includes(BTN_THUMBR)
			assert axes.len() == 4 && axes[0].minimum == -32768 && axes[0].maximum == 32767 && axes[0].flat == 128
			assert kinds.includes(InputKind.Key) && kinds.includes(InputKind.Absolute) && kinds.includes(InputKind.ForceFeedback)
			assert report.len() == 3 && report[0].kind == InputKind.Absolute && report[0].value == 1200 && report[2].code == BTN_SOUTH
			assert down.equals([BTN_SOUTH])
			assert played == 2 && stopped == 1 onerror fail "the pad saw {played} plays and {stopped} stops"
			return none
		}

		// Events the reader fell behind on are dropped by the kernel; the
		// next report tells what changed meanwhile, here a button let go
		// during the flood.
		@test()
		def TestDroppedEventsResynchronise() !none {
			let made = try virtualPad()
			return testing.skip("this user may not open /dev/uinput to make a virtual game pad") when made is none
			let pad VirtualPad = made
			let device = openPad(pad) onerror (err error) {
				pad.remove()
				fail err
			}
			try pad.send([[EV_KEY, BTN_SOUTH, 1]])
			let pressed = try device.read(1s)
			try pad.send([[EV_KEY, BTN_SOUTH, 0]])
			// Far more reports than the node's buffer holds.
			for let i = 0; i < 2000; i++ {
				try pad.send([[EV_ABS, 0, i]])
			}
			let released = false
			let lastX = -1
			let moves = 0
			for let reads = 0; reads < 5000; reads++ {
				let report = try device.read(100ms)
				break when report.len() == 0
				for let (_, e) in report {
					released = true when e.kind == InputKind.Key && e.code == BTN_SOUTH && e.value == 0
					if e.kind == InputKind.Absolute && e.code == 0 {
						lastX = e.value
						moves += 1
					}
				}
			}
			device.close()
			pad.remove()
			assert pressed.len() == 1 && pressed[0].value == 1
			assert released onerror fail "the button's release was lost with the dropped events"
			assert lastX == 1999 onerror fail "the last move read was {lastX}, of {moves} moves"
			assert moves < 2000 onerror fail "the kernel dropped nothing: {moves} moves arrived"
			return none
		}

		// On every input node this user can open: its capabilities read
		// back, and a short read finds no report or a whole one.
		@test()
		def TestOpenNodesDescribeThemselves() !none {
			for let (_, d) in inputDevices() onerror recover [] {
				let refused = false
				let open = openInput(d.id) onerror (err error) {
					refused = true
					recover new InputDevice(Device{}, -1)
				}
				continue when refused
				let kinds = try open.kinds()
				if kinds.includes(InputKind.Key) {
					assert (try open.keys()).len() > 0
					try open.pressed()
				}
				if kinds.includes(InputKind.Absolute) {
					for let (_, a) in try open.axes() {
						assert a.minimum <= a.maximum
					}
				}
				try open.read(10ms)
				open.close()
			}
			return none
		}
	}
}
