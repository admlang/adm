// Recording sound from the machine's microphones.
//
// `microphones()` names the inputs and `openMicrophone(id)` starts one
// recording. A `Microphone` is an `AudioStream`, so whatever reads decoded
// audio reads it too: a codec encodes it to a file, a `Speaker` plays it back.
// Samples are `float32` in -1.0..1.0 with channels interleaved.
//
// Example: five seconds from the default microphone
// ```example
// use std.devices
//
// let mic = try devices.openMicrophone()
// defer mic.close()
// let clip = try mic.record(5s)
// println("{clip.info.frames} frames at {clip.info.sampleRate} Hz")
// ```

partial module std.devices {
	use (
		std.formats.audio::(Audio, AudioInfo, SampleFormat)
		std.services.devices::(Device, DeviceKind, Devices)
		std.devices.pulse::*
		std.devices.alsa::*
		std.devices.samples::*
	)

	// An open microphone, recording from the moment openMicrophone returns it.
	// Close it when done, or let it go — dispose closes it.
	type Microphone {
		// The input the sound comes from. A microphone opened on the default
		// follows the desktop's default, and the sound server moves any
		// microphone whose input goes away; this names the input after the last
		// read.
		device     Device
		// Frames per second the microphone yields, the one openMicrophone asked
		// for; samples are resampled when the device itself runs at another rate.
		sampleRate int
		// Samples per frame the microphone yields, interleaved.
		channels   int

		// Where the sound comes from; none once closed.
		internal backend   ?CaptureBackend
		// Samples recorded and not yet handed out.
		internal pending   float32[]
		// Frames handed out so far.
		internal handedOut uint64

		// Microphones come from `openMicrophone`, which sets the device up first.
		internal def new(device Device, backend ?CaptureBackend, sampleRate int, channels int) {
			self.device = device
			self.backend = backend
			self.sampleRate = sampleRate
			self.channels = channels
		}

		// The stream's description: `sampleRate`, `channels`, `Float32`, no
		// length and not seekable.
		def info() AudioInfo {
			return AudioInfo{
				sampleRate: uint32(sampleRate),
				channels:   uint16(channels),
				bitDepth:   uint16(32),
				format:     SampleFormat.Float32,
				frames:     uint64(0),
				length:     0s,
				codec:      "pcm",
				bitrate:    uint32(0),
				seekable:   false,
			}
		}

		// Waits for recorded frames, fills `buf` with as many as are ready and
		// returns the frame count. Returns 0 only once the microphone is closed.
		//
		// Fails when `buf` does not hold a whole number of frames or the device
		// errors, as when it is unplugged.
		def read(buf float32[]) !int {
			expects {
				assert buf.len() % channels == 0 onerror fail "devices: a buffer of {buf.len()} samples does not hold whole frames of {channels} channels"
			}
			return 0 when backend is none || buf.len() == 0
			let input CaptureBackend = backend
			for pending.len() < channels {
				for let (_, sample) in try input.read() {
					pending.push(sample)
				}
				try follow(input)
			}
			let count = pending.len() < buf.len() ?? (pending.len(), buf.len())
			count -= count % channels
			for let i = 0; i < count; i++ {
				buf[i] = pending[i]
			}
			pending = pending[count:]
			handedOut += uint64(count / channels)
			return count / channels
		}

		// A microphone cannot seek.
		//
		// Always fails.
		def seek(frame uint64) !none {
			fail "devices: microphone {device.id} cannot seek"
		}

		// A microphone cannot seek.
		//
		// Always fails.
		def seek(time duration) !none {
			fail "devices: microphone {device.id} cannot seek"
		}

		// A microphone cannot seek.
		//
		// Always fails.
		def skip(offset duration) !none {
			fail "devices: microphone {device.id} cannot seek"
		}

		// Frames handed out since the microphone opened.
		def position() uint64 {
			return handedOut
		}

		// Records for the length and returns what was heard.
		//
		// Fails when the microphone is closed or the device errors.
		def record(length duration) !Audio {
			fail "devices: microphone {device.id} is closed" when backend is none
			let wanted = int(int64(length) * int64(sampleRate) / 1000000000)
			let samples float32[]
			let buf float32[]
			buf.len(RECORD_CHUNK_FRAMES * channels)
			for samples.len() < wanted * channels {
				let frames = try read(buf)
				fail "devices: microphone {device.id} closed while recording" when frames == 0
				let take = samples.len() + frames * channels > wanted * channels ?? (wanted * channels - samples.len(), frames * channels)
				for let i = 0; i < take; i++ {
					samples.push(buf[i])
				}
			}
			let info = info()
			info.frames = uint64(wanted)
			info.length = length
			return Audio{info: info, samples: samples}
		}

		// The microphone's own volume, from 0.0 silent to 1.0 full, on the scale
		// of the desktop's mixer, which shows it as this program's slider. The
		// input's volume, which every program recording there shares, is
		// `devices.volume(microphone.device)`.
		//
		// Fails when the microphone is closed or the sound server does not answer.
		def volume() !float {
			let input = try opened()
			return input.volume()
		}

		// Sets the microphone's own volume, 1.0 being full; above it amplifies,
		// and loud sound clips.
		//
		// Fails when the level is negative, the microphone is closed, or the
		// sound server refuses.
		def volume(level float) !none {
			expects {
				assert level >= 0.0 onerror fail "devices: a volume is 0.0 or more, not {level}"
			}
			let input = try opened()
			return input.volume(level)
		}

		// Whether the microphone itself is muted: it then reads silence.
		//
		// Fails when the microphone is closed or the sound server does not answer.
		def muted() !bool {
			let input = try opened()
			return input.muted()
		}

		// Makes the microphone read silence, keeping its volume for `unmute`.
		//
		// Fails when the microphone is closed or the sound server refuses.
		def mute() !none {
			let input = try opened()
			return input.mute(true)
		}

		// Lets the microphone hear again at its volume.
		//
		// Fails when the microphone is closed or the sound server refuses.
		def unmute() !none {
			let input = try opened()
			return input.mute(false)
		}

		// Stops recording and releases the device. Safe to call twice.
		//
		// Does not fail today; the result is `io.Closer`'s.
		def close() !none {
			return none when backend is none
			let input CaptureBackend = backend
			backend = none
			pending = []
			input.close()
			return none
		}

		// Whether the microphone is still open.
		def isOpen() bool {
			return !(backend is none)
		}

		// Closing on dispose, so a microphone nobody holds any more frees the device.
		def dispose() {
			close() onerror recover none
		}

		// Takes note of the input the backend moved to, which the policy must
		// allow as it allowed the first.
		//
		// Fails, closing the microphone, when the policy denies the new input.
		internal def follow(input CaptureBackend) !none {
			let moved = input.moved()
			return none when moved is none
			let now Device = moved
			admitDevice("adm.devices.microphone", now.id) onerror (err error) {
				close() onerror recover none
				fail err
			}
			device = now
			return none
		}

		// The backend while the microphone is open.
		//
		// Fails when the microphone is closed.
		internal def opened() !CaptureBackend {
			fail "devices: microphone {device.id} is closed" when backend is none
			let input CaptureBackend = backend
			return input
		}
	}

	// Frames read per pass while recording a length.
	internal const RECORD_CHUNK_FRAMES = 4096

	// The microphones the machine has. Through the desktop's sound server when
	// it runs, which marks the one it uses and leaves out the inputs that only
	// mirror an output; else the sound cards' inputs, the one ALSA's configured
	// `default` records from marked (the first when it names none of them).
	//
	// Fails when the policy denies listing the devices.
	@requires("adm.devices.list")
	def microphones() !Device[] {
		return soundDevices(DeviceKind.Microphone)
	}

	// The microphone the desktop records from, as `microphones()` lists it.
	//
	// Fails when the policy denies listing the devices or the machine has no microphone.
	@requires("adm.devices.list")
	def defaultMicrophone() !Device {
		return defaultSound(DeviceKind.Microphone, "microphone")
	}

	// Opens the microphone behind the device id and starts recording; an empty id
	// opens `defaultMicrophone()` and, through a sound server, follows the
	// desktop's default when it picks another. The device may run at another
	// rate or channel count than asked, and the microphone converts.
	//
	// Fails when the policy denies the microphone (the `microphone`
	// permission, and its `device` rules for the microphone opened), there is
	// no such microphone, or it cannot be opened, as while another program
	// holds it. Without a sound server an empty id needs the `list`
	// permission too, to find the first input.
	@requires("adm.devices.microphone")
	def openMicrophone(id string = "", sampleRate int = 48000, channels int = 1) !Microphone {
		expects {
			assert sampleRate > 0 onerror fail "devices: a microphone needs a sample rate above 0, not {sampleRate}"
			assert channels > 0 onerror fail "devices: a microphone needs at least one channel, not {channels}"
		}
		if id == "" || id.startsWith("pulse:") {
			let server = pulseConnection("adm")
			if !(server is none) {
				let connection PulseConnection = server
				let microphone = openServerMicrophone(connection, id, sampleRate, channels) onerror (err error) {
					connection.close()
					fail err
				}
				return microphone
			}
			fail "devices: no sound server to record from {id} through" when id != ""
		}
		let card = try soundId(id, DeviceKind.Microphone, "microphone")
		try admitDevice("adm.devices.microphone", card)
		let (device, fd) = openKind(card, DeviceKind.Microphone, "microphone") onerror (err error) {
			let (connection, route) = try serverInstead(card, DeviceKind.Microphone, err)
			let microphone = openServerMicrophone(connection, route, sampleRate, channels) onerror (failed error) {
				connection.close()
				fail failed
			}
			return microphone
		}
		let layout = openAlsa(fd, false, sampleRate, channels) onerror (err error) {
			Devices.close(fd) onerror recover none
			fail err
		}
		return new Microphone(device, new AlsaCapture(fd, layout, sampleRate, channels), sampleRate, channels)
	}

	// A microphone recording through the sound server from the source behind the
	// id, its default when the id is empty.
	//
	// Fails when the server has no such source or refuses the stream.
	internal def openServerMicrophone(connection PulseConnection, id string, sampleRate int, channels int) !Microphone {
		if id == "" {
			let capture = try pulseCapture(connection, "", sampleRate, channels)
			let recording = pulseEndpoint(connection, DeviceKind.Microphone, capture.source) onerror (err error) {
				capture.close()
				fail err
			}
			admitDevice("adm.devices.microphone", recording.device.id) onerror (err error) {
				capture.close()
				fail err
			}
			return new Microphone(recording.device, capture, sampleRate, channels)
		}
		let device = try pulsePick(connection, DeviceKind.Microphone, id, "microphone")
		try admitDevice("adm.devices.microphone", device.id)
		let capture = try pulseCapture(connection, device.id[6:], sampleRate, channels)
		return new Microphone(device, capture, sampleRate, channels)
	}
}
