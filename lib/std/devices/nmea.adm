// NMEA 0183, the sentences GPS receivers talk in: `$GPGGA,...*47`, one a
// line. `parseNmea` takes one apart and checks its checksum; a `Gps` turns a
// receiver's sentences into fixes.
//
// Example: the talker, kind and fields of a sentence
// ```example
// use std.devices
//
// let s = try devices.parseNmea("$GPGLL,4916.45,N,12311.12,W,225444,A,*1D")
// println("{s.talker} {s.kind} {s.fields[0]}")   // GP GLL 4916.45
// ```
partial module std.devices {
	use (
		std.math.geo::(Coordinate)
		std.time
	)

	// One NMEA 0183 sentence: who sent it, what kind it is and its fields.
	type NmeaSentence {
		// The talker: `GP` GPS, `GL` GLONASS, `GA` Galileo, `GB` BeiDou,
		// `GQ` QZSS, `GI` NavIC, `GN` several systems at once; `P` for a
		// maker's own (proprietary) sentence.
		talker string
		// The sentence's kind (`GGA`, `RMC`); for a proprietary sentence the
		// rest of its address, maker code first (`UBX`, `GRME`).
		kind   string
		// The fields after the address, empty where the sender left one
		// empty.
		fields string[]

		def new(talker string, kind string, fields string[]) {
			self.talker = talker
			self.kind = kind
			self.fields = fields
		}

		// The field at index, "" past the last.
		def field(index int) string {
			return index >= 0 && index < fields.len() ?? (fields[index], "")
		}

		// The sentence as a receiver sends it, with its checksum and without
		// the line ending: `$GPGLL,4916.45,N,12311.12,W,225444,A,*1D`.
		def str() string {
			let body = talker + kind
			for let (_, f) in fields {
				body += "," + f
			}
			return "${body}*{"%02X".format(nmeaChecksum(body))}"
		}
	}

	// Takes one sentence apart: `$` (or `!` for an encapsulated one), the
	// address, comma-separated fields and `*` with the checksum, which is
	// checked when present. A line ending, surrounding blanks and an NMEA
	// 4 tag block (`\s:sat1,c:1577096365*5D\`) before it are passed over.
	//
	// Fails when the line is no sentence (no `$` or `!`, an address shorter
	// than three characters, characters outside printable ASCII) or its
	// checksum is wrong.
	def parseNmea(line string) !NmeaSentence {
		let text = line.trim()
		if text.startsWith("\\") {
			let close = text[1:].indexOf("\\")
			fail "devices: an NMEA tag block that does not end: {line}" when close < 0
			text = text[close + 2:]
		}
		fail "devices: not an NMEA sentence: {line}" unless text.startsWith("$") || text.startsWith("!")
		let raw = text.bytes()
		for let (_, b) in raw {
			fail "devices: an NMEA sentence holds only printable ASCII: {line}" when b < byte(0x20) || b > byte(0x7E)
		}
		let star = text.lastIndexOf("*")
		let body = text[1:]
		if star >= 0 {
			body = text[1:star]
			let given = text[star + 1:]
			fail "devices: an NMEA checksum is two hexadecimal digits, not {given}: {line}" unless given.len() == 2 && isHex(given)
			let want = nmeaChecksum(body)
			fail "devices: NMEA checksum {given} should be {"%02X".format(want)}: {line}" unless given.toInt<int>(16) == want
		}
		let parts = body.split(",")
		let address = parts[0]
		fail "devices: an NMEA address has at least three characters: {line}" when address.len() < 3
		let fields = parts.len() > 1 ?? (parts[1:], string[])
		return new NmeaSentence("P", address[1:], fields) when address.startsWith("P")
		return new NmeaSentence(address[0:2], address[2:], fields)
	}

	// The XOR of the characters between `$` and `*`.
	internal def nmeaChecksum(body string) int {
		let sum = 0
		for let (_, b) in body.bytes() {
			sum ^= int(b)
		}
		return sum
	}

	// Whether text is hexadecimal digits.
	internal def isHex(text string) bool {
		for let (_, c) in text {
			return false unless c.isDigit() || (c := 'a' || 'b' || 'c' || 'd' || 'e' || 'f' || 'A' || 'B' || 'C' || 'D' || 'E' || 'F')
		}
		return true
	}

	// Lines out of a receiver's bytes: each starts at `$` or `!` and ends at
	// a CR or LF. A line cut short by another byte is passed on as it is
	// and fails to parse. What comes between (a binary protocol the receiver also
	// speaks, line noise at the wrong speed) is dropped, as is a "line"
	// longer than any sentence.
	internal type NmeaLines {
		internal pending byte[]

		def new() {}

		// Adds bytes read from the receiver.
		def push(data byte[]) {
			pending.push(...data)
		}

		// The next whole line, none until one has come.
		def next() ?string {
			for {
				let start = -1
				for let (i, b) in pending {
					if b == byte(0x24) || b == byte(0x21) {
						start = i
						break
					}
				}
				if start < 0 {
					pending = []
					return none
				}
				// A line ends at CR or LF, and gives way to the next `$` or to
				// a byte no sentence holds (a binary message's `$`).
				let end = -1
				for let i = start + 1; i < pending.len(); i++ {
					let b = pending[i]
					if b == byte(13) || b == byte(10) || b == byte(0x24) || b < byte(0x20) || b > byte(0x7E) {
						end = i
						break
					}
				}
				if end < 0 {
					pending = pending[start:].clone()
					pending = [] when pending.len() > NMEA_LONGEST
					return none
				}
				let line = pending.slice(start, end - start).clone()
				pending = pending[end:].clone()
				continue when line.len() > NMEA_LONGEST
				return string(line)
			}
			return none
		}
	}

	// The longest line taken for a sentence: NMEA's 82 characters, with room
	// for receivers that send longer ones and a tag block.
	internal const NMEA_LONGEST = 160

	// Turns sentences into fixes, one a measurement epoch (the burst a
	// receiver sends each second or so). An epoch ends when a sentence
	// carries another time than the epoch's, or a kind that was already in
	// it comes again (GSA and GSV come several times an epoch); after the
	// first epoch the kind that ended it is known, and that sentence then
	// ends the epoch at once, so a fix goes out without waiting for the
	// next one. `flush` hands out an epoch the receiver went quiet in.
	internal type NmeaDecoder {
		// The fix the epoch in progress is building.
		internal fix         GpsFix
		// The time of day the epoch's sentences carry, "" before one did.
		internal stamp       string                   = ""
		// The talker and kind of every sentence in the epoch.
		internal seen        map<string, bool>        = map<string, bool>{}
		// The epoch's first sentence's talker and kind.
		internal first       string                   = ""
		// The talker and kind that ended the epochs so far, "" until one did.
		internal ender       string                   = ""
		internal last        string                   = ""
		// Whether the epoch holds anything not handed out yet.
		internal dirty       bool                     = false
		// The last date a sentence named; year 0 before one did.
		internal year        int                      = 0
		internal month       int                      = 0
		internal day         int                      = 0
		// The satellites in view, per talker and signal, as their last
		// complete run of GSV sentences listed them, and the runs being read.
		internal inView      map<string, Satellite[]> = map<string, Satellite[]>{}
		internal reading     map<string, Satellite[]> = map<string, Satellite[]>{}
		internal viewCounts  map<string, int>         = map<string, int>{}
		// The satellites the epoch's GSA sentences name as used, by system and number.
		internal used        map<string, bool>        = map<string, bool>{}
		internal sawGsa      bool                     = false
		internal sawGga      bool                     = false
		internal usedCount   int                      = 0
		// The quality a mode indicator (RMC, GLL, VTG, GNS) gives, for an epoch without GGA.
		internal modeQuality FixQuality               = FixQuality.None

		def new() {
			fix = GpsFix{}
		}

		// Takes the next sentence; returns the fix of an epoch it ended,
		// none when the epoch goes on. Sentences of kinds a fix does not
		// use, and those whose fields are not what their kind has, change
		// nothing.
		def add(sentence NmeaSentence) ?GpsFix {
			let key = sentence.talker + sentence.kind
			let time = timeField(sentence)
			let repeats = !(sentence.kind := "GSA" || "GSV" || "TXT") && seen.hasKey(key)
			let out ?GpsFix = none
			if dirty && (repeats || (time != "" && stamp != "" && time != stamp)) {
				ender = last
				out = complete()
			}
			stamp = time when time != ""
			first = key when first == ""
			seen[key] = true
			last = key
			dirty = true when apply(sentence)
			out = complete() when out is none && dirty && key == ender && key != first
			return out
		}

		// The epoch in progress, none when it holds nothing new.
		def flush() ?GpsFix {
			return none unless dirty
			return complete()
		}

		// Hands out the epoch's fix and starts the next epoch.
		internal def complete() GpsFix {
			let out = fix
			out.time = epochTime()
			let satellites Satellite[]
			let ids = map<string, int>{}
			for let (_, run) in inView {
				for let (_, sat) in run {
					let id = "{sat.system}:{sat.prn}"
					// A copy: the run keeps its own for the next epoch.
					let s = Satellite{...sat}
					s.used = used.hasKey(id)
					if ids.hasKey(id) {
						// Another signal of the same satellite: the stronger one counts.
						let at = ids[id]
						let had = satellites[at]
						s.snr = had.snr when strongerSnr(had, s)
						s.elevation = had.elevation when s.elevation is none
						s.azimuth = had.azimuth when s.azimuth is none
						satellites[at] = s
					} else {
						ids[id] = satellites.len()
						satellites.push(s)
					}
				}
			}
			out.satellites = satellites
			let stated = 0
			for let (_, n) in viewCounts {
				stated += n
			}
			out.satellitesInView = satellites.len() > 0 ?? (satellites.len(), stated)
			out.satellitesUsed = out.satellitesUsed.max(used.len())
			out.quality = modeQuality unless sawGga
			if !sawGsa {
				out.mode = FixMode.None
				out.mode = out.altitude is none ?? (FixMode.TwoD, FixMode.ThreeD) unless (out.position is none)
			}
			fix = GpsFix{}
			fix.satellitesInView = out.satellitesInView
			seen = map<string, bool>{}
			used = map<string, bool>{}
			first = ""
			dirty = false
			sawGsa = false
			sawGga = false
			modeQuality = FixQuality.None
			return out
		}

		// The epoch's instant: the last date a sentence named with the
		// epoch's time of day; none before both are known.
		internal def epochTime() ?time.Time {
			return none when stamp == "" || year == 0
			let parts = timeOfDay(stamp)
			return none when parts is none
			let clock (int, int, int, int) = parts
			let (h, m, s, ns) = clock
			return new time.DateTime(year, month, day, h, m, s, ns).toTime()
		}

		// Applies one sentence to the fix; false when it changed nothing.
		internal def apply(sentence NmeaSentence) bool {
			match sentence.kind {
				case "GGA":
					return gga(sentence)
				case "RMC":
					return rmc(sentence)
				case "GSA":
					return gsa(sentence)
				case "GSV":
					return gsv(sentence)
				case "VTG":
					return vtg(sentence)
				case "GLL":
					return gll(sentence)
				case "ZDA":
					return zda(sentence)
				case "GNS":
					return gns(sentence)
			}
			return false
		}

		// GGA: time, position, fix quality, satellites used, HDOP, altitude
		// above mean sea level, geoid separation, the differential
		// correction's age and station.
		internal def gga(s NmeaSentence) bool {
			return false when s.fields.len() < 9
			let quality = whole(s.field(5))
			let q = 0
			if !(quality is none) {
				let n int = quality
				q = n
			}
			fix.quality = fixQualityOf(q)
			sawGga = true
			let count = whole(s.field(6))
			if !(count is none) {
				let n int = count
				fix.satellitesUsed = n
			}
			fix.hdop = number(s.field(7))
			fix.altitude = q > 0 ?? (number(s.field(8)), none)
			fix.geoidSeparation = number(s.field(10))
			fix.differentialAge = number(s.field(12))
			fix.differentialStation = whole(s.field(13))
			setPosition(q > 0, s.field(1), s.field(2), s.field(3), s.field(4))
			return true
		}

		// RMC: time, validity, position, speed in knots, course, date,
		// magnetic variation, and from NMEA 2.3 the mode indicator.
		internal def rmc(s NmeaSentence) bool {
			return false when s.fields.len() < 9
			let mode = s.field(11)
			let valid = s.field(1) == "A" && mode != "N"
			noteDate(s.field(8))
			setPosition(valid, s.field(2), s.field(3), s.field(4), s.field(5))
			setMotion(valid, number(s.field(6)), KNOT, number(s.field(7)))
			let variation = number(s.field(9))
			fix.magneticVariation = none
			if !(variation is none) {
				let v float = variation
				fix.magneticVariation = s.field(10) == "W" ?? (-v, v)
			}
			noteMode(valid, mode)
			return true
		}

		// GSA: 2D or 3D, the satellites used (up to 12 a sentence; several
		// sentences an epoch, one a system, when the talker is GN), PDOP,
		// HDOP, VDOP, and from NMEA 4.11 the system.
		internal def gsa(s NmeaSentence) bool {
			return false when s.fields.len() < 17
			let mode = s.field(1)
			fix.mode = mode == "3" ?? (FixMode.ThreeD, mode == "2" ?? (FixMode.TwoD, FixMode.None))
			sawGsa = true
			let system = systemOfId(s.field(17))
			for let i = 2; i <= 13; i++ {
				let number = whole(s.field(i))
				continue when number is none
				let prn int = number
				let sys = systemOfTalker(s.talker, prn)
				if !(system is none) {
					let named GnssSystem = system
					sys = named
				}
				used["{sys}:{prn}"] = true
			}
			fix.pdop = number(s.field(14))
			fix.hdop = number(s.field(15))
			fix.vdop = number(s.field(16))
			return true
		}

		// GSV: the satellites in view, four a sentence over a run of
		// sentences: number, elevation, azimuth, signal to noise; from NMEA
		// 4.10 the run's signal follows the last satellite.
		internal def gsv(s NmeaSentence) bool {
			return false when s.fields.len() < 3
			let totalField = whole(s.field(0))
			let indexField = whole(s.field(1))
			return false when totalField is none || indexField is none
			let total int = totalField
			let index int = indexField
			let rest = s.fields.len() - 3
			let signal = rest % 4 == 1 ?? (s.fields[s.fields.len() - 1], "")
			let key = s.talker + "/" + signal
			reading[key] = [] when index == 1
			let run = reading.get(key)
			return false when run is none
			let got Satellite[] = run
			for let at = 3; at + 3 < s.fields.len(); at += 4 {
				let number = whole(s.field(at))
				continue when number is none
				let prn int = number
				got.push(Satellite{
					system:    systemOfTalker(s.talker, prn),
					prn:       prn,
					elevation: whole(s.field(at + 1)),
					azimuth:   whole(s.field(at + 2)),
					snr:       whole(s.field(at + 3)),
					used:      false,
				})
			}
			reading[key] = got
			let count = whole(s.field(2))
			viewCounts[key] = 0
			if !(count is none) {
				let n int = count
				viewCounts[key] = n
			}
			if index == total {
				inView[key] = got
				reading.delete(key)
			}
			return true
		}

		// VTG: course and speed; the NMEA 2.3 form carries a mode indicator,
		// the form before it (without the T, M, N and K units) does not.
		internal def vtg(s NmeaSentence) bool {
			return false when s.fields.len() < 4
			if s.field(1) == "T" {
				let mode = s.field(8)
				let valid = mode != "N"
				let kmh = number(s.field(6))
				if kmh is none {
					setMotion(valid, number(s.field(4)), KNOT, number(s.field(0)))
				} else {
					setMotion(valid, kmh, KMH, number(s.field(0)))
				}
				noteMode(valid, mode)
				return true
			}
			setMotion(true, number(s.field(2)), KNOT, number(s.field(0)))
			return true
		}

		// GLL: position, time, validity, and from NMEA 2.3 the mode indicator.
		internal def gll(s NmeaSentence) bool {
			return false when s.fields.len() < 4
			let mode = s.field(6)
			let status = s.field(5)
			let valid = (status == "A" || status == "") && mode != "N"
			setPosition(valid, s.field(0), s.field(1), s.field(2), s.field(3))
			noteMode(valid, mode)
			return true
		}

		// ZDA: time and the whole date, the year in four digits.
		internal def zda(s NmeaSentence) bool {
			return false when s.fields.len() < 4
			let d = whole(s.field(1))
			let m = whole(s.field(2))
			let y = whole(s.field(3))
			return false when d is none || m is none || y is none
			let dd int = d
			let mm int = m
			let yyyy int = y
			year = yyyy
			month = mm
			day = dd
			return true
		}

		// GNS: time, position, a mode character per system, satellites
		// used, HDOP, altitude, geoid separation, differential age and
		// station.
		internal def gns(s NmeaSentence) bool {
			return false when s.fields.len() < 10
			let modes = s.field(5)
			let valid = false
			let best = ""
			for let (_, c) in modes {
				if c != 'N' {
					valid = true
					best = "{c}" when best == ""
				}
			}
			setPosition(valid, s.field(1), s.field(2), s.field(3), s.field(4))
			let count = whole(s.field(6))
			if !(count is none) {
				let n int = count
				fix.satellitesUsed = n
			}
			fix.hdop = number(s.field(7))
			fix.altitude = valid ?? (number(s.field(8)), none)
			fix.geoidSeparation = number(s.field(9))
			fix.differentialAge = number(s.field(10))
			noteMode(valid, best)
			return true
		}

		// Sets the position from NMEA's ddmm.mmmm and dddmm.mmmm with their
		// hemispheres, none when the sentence says it is not valid or leaves
		// it out. The altitude above the ellipsoid is filled in when the
		// fix is finished.
		internal def setPosition(valid bool, lat string, ns string, lon string, ew string) {
			if !valid {
				fix.position = none
				return
			}
			let latitude = degrees(lat, ns)
			let longitude = degrees(lon, ew)
			return when latitude is none || longitude is none
			let la float = latitude
			let lo float = longitude
			let at = new Coordinate(la, lo)
			let height = fix.altitude
			let geoid = fix.geoidSeparation
			if !(height is none) && !(geoid is none) {
				let msl float = height
				let separation float = geoid
				at.altitude = msl + separation
			}
			fix.position = at
		}

		// Sets the speed, in metres a second from the unit given, and the
		// course.
		internal def setMotion(valid bool, speed ?float, unit float, course ?float) {
			if !valid {
				fix.speed = none
				fix.course = none
				return
			}
			fix.speed = none
			if !(speed is none) {
				let v float = speed
				fix.speed = v * unit
			}
			fix.course = course
		}

		// Notes the quality a mode indicator gives, for an epoch without GGA.
		internal def noteMode(valid bool, mode string) {
			if !valid {
				modeQuality = FixQuality.None
				return
			}
			let q = qualityOfMode(mode)
			modeQuality = q when q != FixQuality.None || modeQuality == FixQuality.None
			modeQuality = FixQuality.Gps when modeQuality == FixQuality.None && mode == ""
		}

		// Sets the date from RMC's ddmmyy, the century taken as the 21st for
		// years below 80.
		internal def noteDate(text string) {
			return unless text.len() == 6 && isDigits(text)
			day = text[0:2].toInt<int>()
			month = text[2:4].toInt<int>()
			let yy = text[4:6].toInt<int>()
			year = yy < 80 ?? (2000 + yy, 1900 + yy)
		}
	}

	// Whether the satellite a holds a stronger signal than b.
	internal def strongerSnr(a Satellite, b Satellite) bool {
		let first = a.snr
		let second = b.snr
		return false when first is none
		return true when second is none
		let x int = first
		let y int = second
		return x > y
	}

	// The time of day a sentence carries, "" for kinds without one or an
	// empty field.
	internal def timeField(s NmeaSentence) string {
		match s.kind {
			case "GGA", "RMC", "ZDA", "GNS":
				return s.field(0)
			case "GLL":
				return s.field(4)
		}
		return ""
	}

	// NMEA's hhmmss or hhmmss.sss as hours, minutes, seconds and
	// nanoseconds; none when it is not one.
	internal def timeOfDay(text string) ?(int, int, int, int) {
		return none when text.len() < 6 || !isDigits(text[0:6])
		let h = text[0:2].toInt<int>()
		let m = text[2:4].toInt<int>()
		let s = text[4:6].toInt<int>()
		return none when h > 23 || m > 59 || s > 60
		let ns = 0
		if text.len() > 6 {
			return none unless text[6] == '.' && (text.len() == 7 || isDigits(text[7:]))
			let digits = text[7:]
			for let i = 0; i < 9; i++ {
				ns = ns * 10 + (i < digits.len() ?? (int(digits[i]) - int('0'), 0))
			}
		}
		return (h, m, s, ns)
	}

	// Degrees from NMEA's (d)ddmm.mmmm and its hemisphere letter, negative
	// south and west; none when either is missing or malformed.
	internal def degrees(text string, hemisphere string) ?float {
		let v = number(text)
		return none when v is none || !(hemisphere := "N" || "S" || "E" || "W")
		let raw float = v
		let whole = float(int(raw / 100.0))
		let value = whole + (raw - whole * 100.0) / 60.0
		return (hemisphere := "S" || "W") ?? (-value, value)
	}

	// The number a field holds: digits with at most one point and an
	// optional sign; none for an empty or malformed field.
	internal def number(text string) ?float {
		return none when text == ""
		let digits = 0
		let points = 0
		for let (i, c) in text {
			if c.isDigit() {
				digits++
			} else if c == '.' {
				points++
			} else if !(i == 0 && (c == '-' || c == '+')) {
				return none
			}
		}
		return none when digits == 0 || points > 1
		return parseFloat<float>(text)
	}

	// The whole number a field holds, none for an empty or malformed
	// field; a fraction is dropped.
	internal def whole(text string) ?int {
		let v = number(text)
		return none when v is none
		let f float = v
		return int(f)
	}

	// Whether text is all ASCII digits.
	internal def isDigits(text string) bool {
		for let (_, c) in text {
			return false unless c.isDigit()
		}
		return text.len() > 0
	}

	// GGA's fix quality number as a FixQuality.
	internal def fixQualityOf(q int) FixQuality {
		match q {
			case 1:
				return FixQuality.Gps
			case 2:
				return FixQuality.Differential
			case 3:
				return FixQuality.Pps
			case 4:
				return FixQuality.RtkFixed
			case 5:
				return FixQuality.RtkFloat
			case 6:
				return FixQuality.Estimated
			case 7:
				return FixQuality.Manual
			case 8:
				return FixQuality.Simulation
		}
		return FixQuality.None
	}

	// The quality an NMEA 2.3 mode indicator gives (A autonomous, D
	// differential, E estimated, F RTK float, M manual, P precise, R RTK
	// fixed, S simulator); None for N and anything else.
	internal def qualityOfMode(mode string) FixQuality {
		match mode {
			case "A":
				return FixQuality.Gps
			case "D":
				return FixQuality.Differential
			case "E":
				return FixQuality.Estimated
			case "F":
				return FixQuality.RtkFloat
			case "M":
				return FixQuality.Manual
			case "P":
				return FixQuality.Pps
			case "R":
				return FixQuality.RtkFixed
			case "S":
				return FixQuality.Simulation
		}
		return FixQuality.None
	}

	// The system a talker names, and for GP and GN talkers the one a
	// satellite's number falls in, as receivers number them in NMEA before
	// 4.10: 1-32 GPS, 33-64 and 120-158 SBAS, 65-96 GLONASS, 193-202 QZSS,
	// 201-237 and 401-437 BeiDou, 301-336 Galileo.
	internal def systemOfTalker(talker string, prn int) GnssSystem {
		match talker {
			case "GL":
				return GnssSystem.Glonass
			case "GA":
				return GnssSystem.Galileo
			case "GB", "BD":
				return GnssSystem.Beidou
			case "GQ", "QZ":
				return GnssSystem.Qzss
			case "GI":
				return GnssSystem.Navic
		}
		return GnssSystem.Sbas when prn >= 33 && prn <= 64 || prn >= 120 && prn <= 158
		return GnssSystem.Glonass when prn >= 65 && prn <= 96
		return GnssSystem.Qzss when prn >= 193 && prn <= 200
		return GnssSystem.Beidou when prn >= 201 && prn <= 237 || prn >= 401 && prn <= 437
		return GnssSystem.Galileo when prn >= 301 && prn <= 336
		return GnssSystem.Gps
	}

	// The system an NMEA 4.11 system id names (1 GPS, 2 GLONASS, 3 Galileo,
	// 4 BeiDou, 5 QZSS, 6 NavIC); none when the field is empty or unknown.
	internal def systemOfId(id string) ?GnssSystem {
		match id {
			case "1":
				return GnssSystem.Gps
			case "2":
				return GnssSystem.Glonass
			case "3":
				return GnssSystem.Galileo
			case "4":
				return GnssSystem.Beidou
			case "5":
				return GnssSystem.Qzss
			case "6":
				return GnssSystem.Navic
		}
		return none
	}

	// Metres a second in a knot and in a kilometre an hour.
	internal const KNOT = 0.514444444444444
	internal const KMH = 0.277777777777778
}
