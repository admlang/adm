partial module std.devices {
	use (
		std.testing
		std.math.geo::(Coordinate)
		std.time
	)

	// Sentences from the NMEA 0183 standard's own examples, with the
	// checksums printed there.
	internal const CLASSIC_SENTENCES = [
		"$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47",
		"$GPRMC,123519,A,4807.038,N,01131.000,E,022.4,084.4,230394,003.1,W*6A",
		"$GPGSA,A,3,04,05,,09,12,,,24,,,,,2.5,1.3,2.1*39",
		"$GPGSV,2,1,08,01,40,083,46,02,17,308,41,12,07,344,39,14,22,228,45*75",
		"$GPVTG,054.7,T,034.4,M,005.5,N,010.2,K*48",
		"$GPGLL,4916.45,N,12311.12,W,225444,A,*1D",
		"$GPZDA,201530.00,04,07,2002,00,00*60",
	]

	// A u-blox M8's epochs in NMEA 4.11 (GN talker, a GSA a system with its
	// system id, GSV runs per signal: L1 and L5 of GPS, L1 of GLONASS):
	// two with a 3D fix, then one after the fix was lost.
	internal const UBLOX_EPOCH_1 = [
		"$GNRMC,083559.00,A,4717.11437,N,00833.91522,E,0.004,77.52,091202,,,A,V*33",
		"$GNVTG,77.52,T,,M,0.004,N,0.008,K,A*18",
		"$GNGGA,083559.00,4717.11437,N,00833.91522,E,1,12,1.01,499.6,M,48.0,M,,*4D",
		"$GNGSA,A,3,23,29,07,08,09,18,26,28,,,,,1.94,1.18,1.54,1*0E",
		"$GNGSA,A,3,65,67,80,81,,,,,,,,,1.94,1.18,1.54,2*05",
		"$GPGSV,3,1,10,23,38,230,44,29,71,156,47,07,29,116,41,08,09,081,36,1*62",
		"$GPGSV,3,2,10,09,61,301,48,18,12,040,33,26,43,192,45,28,22,318,39,1*68",
		"$GPGSV,3,3,10,02,05,355,,30,03,123,,1*61",
		"$GPGSV,1,1,03,23,38,230,40,29,71,156,49,07,29,116,,7*56",
		"$GLGSV,1,1,04,65,24,050,38,67,52,305,42,80,33,120,40,81,15,250,35,1*72",
		"$GNGLL,4717.11437,N,00833.91522,E,083559.00,A,A*75",
		"$GNZDA,083559.00,09,12,2002,00,00*70"
	]

	internal const UBLOX_EPOCH_2 = [
		"$GNRMC,083600.00,A,4717.11445,N,00833.91530,E,0.004,77.52,091202,,,A,V*3A",
		"$GNVTG,77.52,T,,M,0.004,N,0.008,K,A*18",
		"$GNGGA,083600.00,4717.11445,N,00833.91530,E,1,12,1.01,499.8,M,48.0,M,,*4A",
		"$GNGSA,A,3,23,29,07,08,09,18,26,28,,,,,1.94,1.18,1.54,1*0E",
		"$GNGSA,A,3,65,67,80,81,,,,,,,,,1.94,1.18,1.54,2*05",
		"$GPGSV,3,1,10,23,38,230,44,29,71,156,47,07,29,116,41,08,09,081,36,1*62",
		"$GPGSV,3,2,10,09,61,301,48,18,12,040,33,26,43,192,45,28,22,318,39,1*68",
		"$GPGSV,3,3,10,02,05,355,,30,03,123,,1*61",
		"$GPGSV,1,1,03,23,38,230,40,29,71,156,49,07,29,116,,7*56",
		"$GLGSV,1,1,04,65,24,050,38,67,52,305,42,80,33,120,40,81,15,250,35,1*72",
		"$GNGLL,4717.11445,N,00833.91530,E,083600.00,A,A*7C",
		"$GNZDA,083600.00,09,12,2002,00,00*7F"
	]

	internal const UBLOX_EPOCH_3 = [
		"$GNRMC,083601.00,V,,,,,,,091202,,,N,V*1D",
		"$GNVTG,,,,,,,,,N*2E",
		"$GNGGA,083601.00,,,,,0,00,99.99,,,,,,*74",
		"$GNGSA,A,1,,,,,,,,,,,,,99.99,99.99,99.99,1*33",
		"$GPGSV,3,1,10,23,38,230,44,29,71,156,47,07,29,116,41,08,09,081,36,1*62",
		"$GPGSV,3,2,10,09,61,301,48,18,12,040,33,26,43,192,45,28,22,318,39,1*68",
		"$GPGSV,3,3,10,02,05,355,,30,03,123,,1*61",
		"$GPGSV,1,1,03,23,38,230,40,29,71,156,49,07,29,116,,7*56",
		"$GLGSV,1,1,04,65,24,050,38,67,52,305,42,80,33,120,40,81,15,250,35,1*72",
		"$GNGLL,,,,,083601.00,V,N*58",
		"$GNZDA,083601.00,09,12,2002,00,00*7E"
	]

	// Every sentence of the epochs given, decoded in order; the fixes they
	// completed, and the one a quiet receiver leaves when `flush` is true.
	internal def decodeAll(epochs string[][], flush bool = false) !GpsFix[] {
		let decoder = new NmeaDecoder()
		let fixes GpsFix[]
		for let (_, epoch) in epochs {
			for let (_, line) in epoch {
				let done = decoder.add(try parseNmea(line))
				if !(done is none) {
					let fix GpsFix = done
					fixes.push(fix)
				}
			}
		}
		if flush {
			let rest = decoder.flush()
			if !(rest is none) {
				let fix GpsFix = rest
				fixes.push(fix)
			}
		}
		return fixes
	}

	// Whether two numbers agree to within a millionth.
	internal def near(a ?float, b float, within float = 0.000001) bool {
		return false when a is none
		let v float = a
		return (v - b).abs() <= within
	}

	// Whether an optional number is the one wanted.
	internal def holds(value ?int, want int) bool {
		return false when value is none
		let v int = value
		return v == want
	}

	// Whether an optional line is the one wanted.
	internal def reads(value ?string, want string) bool {
		return false when value is none
		let v string = value
		return v == want
	}

	// The time of day a stamp holds, all -1 when none.
	internal def clock(text string) (int, int, int, int) {
		let parts = timeOfDay(text)
		return (-1, -1, -1, -1) when parts is none
		let got (int, int, int, int) = parts
		return got
	}

	// The satellite of a system with a number in a fix.
	internal def satelliteOf(fix GpsFix, system GnssSystem, prn int) ?Satellite {
		for let (_, s) in fix.satellites {
			return s when s.system == system && s.prn == prn
		}
		return none
	}

	check "NMEA 0183" {
		// The standard's own sentences parse with their checksums and are
		// written back the same.
		@test()
		def TestKnownSentences() !none {
			for let (_, line) in CLASSIC_SENTENCES {
				let s = try parseNmea(line)
				assert s.talker == "GP"
				assert s.str() == line
			}
			let gga = try parseNmea(CLASSIC_SENTENCES[0] + "\r\n")
			assert gga.kind == "GGA" && gga.fields.len() == 14 && gga.field(1) == "4807.038" && gga.field(13) == "" && gga.field(99) == ""
			let gll = try parseNmea(CLASSIC_SENTENCES[5])
			assert gll.kind == "GLL" && gll.fields[6] == ""
			return none
		}

		// Checksums are checked; a sentence without one, a tag block before
		// one, a maker's own and an encapsulated one are taken.
		@test()
		def TestSentenceForms() !none {
			let refused = 0
			for let (_, bad) in ["$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*48", "$GPGLL,4916.45*1G", "$GPGLL,4916.45*1", "GPGGA,123519", "$GP,1,2", string(byte[0x24, 0x47, 0x50, 0x47, 0x47, 0x41, 0x2C, 0x07]), "\\s:sat1,c:1577096365*5D"] {
				parseNmea(bad) onerror (err error) {
					refused++
					recover new NmeaSentence("", "", [])
				}
			}
			assert refused == 7
			let bare = try parseNmea("$GPGLL,4916.45,N,12311.12,W,225444,A")
			assert bare.kind == "GLL" && bare.fields.len() == 6
			let tagged = try parseNmea("\\s:sat1,c:1577096365*5D\\$GPZDA,201530.00,04,07,2002,00,00*60")
			assert tagged.kind == "ZDA" && tagged.field(3) == "2002"
			let ubx = try parseNmea("$PUBX,00,081350.00,4717.113210,N,00833.915187,E,546.589,G3,2.1,2.0,0.007,77.52,0.007,,0.92,1.19,0.77,9,0,0*5F")
			assert ubx.talker == "P" && ubx.kind == "UBX" && ubx.field(0) == "00"
			assert ubx.str().startsWith("$PUBX,00,")
			let ais = try parseNmea("!AIVDM,1,1,,A,13aEOK?P00PD2wVMdLDRhgvL289?,0*26")
			assert ais.talker == "AI" && ais.kind == "VDM"
			return none
		}

		// The standard's example epoch: position, altitudes, motion, date,
		// quality, DOPs and the satellites, handed out when the next epoch
		// starts or the receiver goes quiet.
		@test()
		def TestClassicEpoch() !none {
			let epoch = [CLASSIC_SENTENCES[0], CLASSIC_SENTENCES[1], CLASSIC_SENTENCES[2], CLASSIC_SENTENCES[3], "$GPGSV,2,2,08,15,20,091,40,22,11,147,38,24,45,276,44,25,02,012,*70", CLASSIC_SENTENCES[4]]
			let fixes = try decodeAll([epoch], flush = true)
			assert fixes.len() == 1
			let fix = fixes[0]
			let position = fix.position
			fail "no position" when position is none
			let at Coordinate = position
			assert near(at.latitude, 48.0 + 7.038 / 60.0) && near(at.longitude, 11.0 + 31.0 / 60.0)
			assert near(at.altitude, 545.4 + 46.9) && near(fix.altitude, 545.4) && near(fix.geoidSeparation, 46.9)
			// VTG's kilometres an hour come last and win over RMC's knots.
			assert near(fix.speed, 10.2 / 3.6, 0.0001) && near(fix.course, 54.7) && near(fix.magneticVariation, -3.1)
			let stamp = fix.time
			fail "no time" when stamp is none
			let t time.Time = stamp
			assert t.str() == "1994-03-23T12:35:19Z"
			assert fix.quality == FixQuality.Gps && fix.mode == FixMode.ThreeD
			assert fix.satellitesUsed == 8 && fix.satellitesInView == 8
			assert near(fix.pdop, 2.5) && near(fix.hdop, 1.3) && near(fix.vdop, 2.1)
			let sat = satelliteOf(fix, GnssSystem.Gps, 12)
			fail "satellite 12 missing" when sat is none
			let twelve Satellite = sat
			assert twelve.used && holds(twelve.elevation, 7) && holds(twelve.azimuth, 344) && holds(twelve.snr, 39)
			let s25 = satelliteOf(fix, GnssSystem.Gps, 25)
			fail "satellite 25 missing" when s25 is none
			let quiet Satellite = s25
			assert !quiet.used && quiet.snr is none
			return none
		}

		// A multi-system receiver: systems from the GSA system ids and the
		// talkers, a satellite's two signals as one, the epoch's end learnt
		// from the first, so the second fix needs no third epoch to come out.
		@test()
		def TestMultiSystemEpochs() !none {
			let fixes = try decodeAll([UBLOX_EPOCH_1, UBLOX_EPOCH_2])
			assert fixes.len() == 2
			let first = fixes[0]
			let position = first.position
			fail "no position" when position is none
			let at Coordinate = position
			assert near(at.latitude, 47.0 + 17.11437 / 60.0) && near(at.longitude, 8.0 + 33.91522 / 60.0) && near(at.altitude, 547.6)
			let stamp = first.time
			fail "no time" when stamp is none
			let t time.Time = stamp
			assert t.str() == "2002-12-09T08:35:59Z"
			assert first.satellitesUsed == 12 && first.satellitesInView == 14 && first.mode == FixMode.ThreeD
			assert near(first.speed, 0.008 / 3.6, 0.00001) && near(first.course, 77.52)
			let used = first.satellites.filter((s) => s.used)
			assert used.len() == 12
			assert used.filter((s) => s.system == GnssSystem.Glonass).len() == 4
			let s29 = satelliteOf(first, GnssSystem.Gps, 29)
			fail "satellite 29 missing" when s29 is none
			let strong Satellite = s29
			assert holds(strong.snr, 49) && strong.used
			let s07 = satelliteOf(first, GnssSystem.Gps, 7)
			fail "satellite 7 missing" when s07 is none
			let seven Satellite = s07
			assert holds(seven.snr, 41)
			let s81 = satelliteOf(first, GnssSystem.Glonass, 81)
			fail "satellite 81 missing" when s81 is none
			let glonass Satellite = s81
			assert glonass.used && holds(glonass.elevation, 15) && holds(glonass.azimuth, 250)
			let second = fixes[1]
			let later = second.time
			fail "no time" when later is none
			let t2 time.Time = later
			assert t2.str() == "2002-12-09T08:36:00Z" && near(second.altitude, 499.8)
			return none
		}

		// A lost fix has no position, motion or altitude; the satellites
		// still in view stay, none of them used.
		@test()
		def TestLostFix() !none {
			let fixes = try decodeAll([UBLOX_EPOCH_1, UBLOX_EPOCH_3])
			assert fixes.len() == 2
			let lost = fixes[1]
			assert lost.position is none && lost.speed is none && lost.course is none && lost.altitude is none
			assert lost.quality == FixQuality.None && lost.mode == FixMode.None
			assert lost.satellitesUsed == 0 && lost.satellitesInView == 14
			assert lost.satellites.filter((s) => s.used).len() == 0
			assert !(lost.time is none)
			return none
		}

		// Without GGA and GSA the quality comes from the mode indicator and
		// the dimensions from the altitude being there; epochs end on a kind
		// coming again when the receiver sends no time.
		@test()
		def TestEpochsWithoutTimes() !none {
			let epoch = ["$GPRMC,,A,4807.038,N,01131.000,E,1.0,90.0,230394,,,D*40", "$GPVTG,054.7,034.4,005.5,010.2*54"]
			let fixes = try decodeAll([epoch, epoch], flush = true)
			assert fixes.len() == 2
			assert fixes[0].quality == FixQuality.Differential && fixes[0].mode == FixMode.TwoD
			assert fixes[0].time is none
			// The form before NMEA 2.3: true course, magnetic, knots, km/h.
			assert near(fixes[0].speed, 5.5 * KNOT) && near(fixes[0].course, 54.7)
			return none
		}

		// Lines come out of the bytes a receiver sends, across reads, with
		// the binary messages and noise between them left behind.
		@test()
		def TestLinesFromBytes() {
			let lines = new NmeaLines()
			// A UBX message whose payload holds a `$`, then the sentence.
			lines.push(byte[0xB5, 0x62, 0x01, 0x07, 0x24, 0x00, 0x24, 0x47])
			lines.push("PGLL,4916.45,N,12311.12,W,225444,A,*1D\r".bytes())
			lines.push("\n$GPZDA,201530.00,04,".bytes())
			assert reads(lines.next(), "$")
			assert reads(lines.next(), "$GPGLL,4916.45,N,12311.12,W,225444,A,*1D")
			assert lines.next() is none
			lines.push("07,2002,00,00*60\r\n".bytes())
			assert reads(lines.next(), "$GPZDA,201530.00,04,07,2002,00,00*60")
			let noise byte[]
			noise.push(0x24)
			for let i = 0; i < 300; i++ {
				noise.push(byte(0x41))
			}
			lines.push(noise)
			assert lines.next() is none
			lines.push("\r\n$GPVTG,054.7,T,034.4,M,005.5,N,010.2,K*48\n".bytes())
			assert reads(lines.next(), "$GPVTG,054.7,T,034.4,M,005.5,N,010.2,K*48")
			assert lines.next() is none
		}

		// Field values: coordinates, times, numbers and the systems behind
		// satellite numbers.
		@test()
		def TestFieldValues() !none {
			assert near(degrees("4807.038", "S"), -(48.0 + 7.038 / 60.0)) && near(degrees("00833.91522", "W"), -(8.0 + 33.91522 / 60.0))
			assert degrees("4807.038", "X") is none && degrees("", "N") is none
			let (h, m, sec, ns) = clock("123519")
			assert h == 12 && m == 35 && sec == 19 && ns == 0
			let (h2, m2, sec2, ns2) = clock("083559.25")
			assert h2 == 8 && m2 == 35 && sec2 == 59 && ns2 == 250000000
			assert timeOfDay("246000") is none && timeOfDay("12:35") is none && timeOfDay("123519.x") is none
			assert number("") is none && number("1.2.3") is none && number("-") is none && number("12a") is none
			assert near(number("-3.25"), -3.25) && holds(whole("08"), 8)
			assert systemOfTalker("GP", 5) == GnssSystem.Gps && systemOfTalker("GN", 70) == GnssSystem.Glonass
			assert systemOfTalker("GN", 135) == GnssSystem.Sbas && systemOfTalker("GN", 305) == GnssSystem.Galileo
			assert systemOfTalker("GN", 210) == GnssSystem.Beidou && systemOfTalker("GA", 5) == GnssSystem.Galileo
			let beidou = systemOfId("4")
			assert systemOfId("") is none
			fail "system 4 unknown" when beidou is none
			let b GnssSystem = beidou
			assert b == GnssSystem.Beidou
			assert fixQualityOf(4) == FixQuality.RtkFixed && qualityOfMode("F") == FixQuality.RtkFloat
			return none
		}
	}
}
