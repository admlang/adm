// Batteries, AC adapters and UPSs: how charged, charging or not, how long
// until empty or full, how worn. `powerSources()` lists them as they are,
// `powerChanges()` follows them as they change.
//
// Example: the machine's battery
// ```example
// use std.devices
//
// for let (_, source) in try devices.powerSources() {
//     continue unless source.kind == devices.PowerKind.Battery && source.peripheral == ""
//     let charge = source.charge
//     if !(charge is none) {
//         let share float = charge
//         println("{source.name}: {"%.0f".format(share * 100.0)}% {source.state}")
//     }
// }
// ```
partial module std.devices {
	use (
		std.time
	)

	// What a power source is.
	enum PowerKind {
		// A battery: the machine's own, or a peripheral's (a mouse, a
		// headset, a game pad).
		Battery,
		// An AC adapter or another supply from the mains.
		Mains,
		// An uninterruptible power supply: a battery that takes over when
		// the mains fails.
		Ups,
		// A USB port or charger the machine draws power from.
		Usb,
		// A wireless charger.
		Wireless,
	}

	// Whether a battery is charging.
	enum ChargeState {
		Unknown,
		Charging,
		Discharging,
		// On the mains without charging: held below full to spare the
		// battery, or waiting.
		NotCharging,
		Full,
		Empty,
	}

	// What a battery reports about its condition.
	enum BatteryHealth {
		Unknown,
		Good,
		Overheat,
		Dead,
		OverVoltage,
		OverCurrent,
		// A failure the battery does not name.
		Failure,
		Cold,
		Cool,
		Warm,
		Hot,
		// The charger's watchdog or safety timer ran out.
		TimerExpired,
		CalibrationRequired,
		// The supply has no battery in it.
		NoBattery,
		// The battery should be replaced (a UPS says so).
		Replace,
	}

	// A battery, adapter or UPS as it is at one moment. A value the source
	// does not report is none.
	struct PowerSource {
		// `power:BAT0`, `power:hidpp_battery_0`, `power:ups:hidraw3`: stable
		// while the source stays connected.
		id               string
		kind             PowerKind
		name             string
		vendor           string        = ""
		model            string        = ""
		serial           string        = ""
		// What the source powers when it is not this machine: `mouse`,
		// `keyboard`, `headset`, `gaming-input`, `device` when the kind is
		// not known; empty for the machine's own.
		peripheral       string        = ""
		present          bool          = true
		// For an adapter, USB port or UPS: whether it supplies power now
		// (for a UPS, whether the mains is there).
		online           bool          = false
		state            ChargeState   = ChargeState.Unknown
		// How full, 0 to 1.
		charge           ?float        = none
		// Watt-hours now, at full, and at full when new.
		energy           ?float        = none
		energyFull       ?float        = none
		energyFullDesign ?float        = none
		// Watts going in or out.
		power            ?float        = none
		voltage          ?float        = none
		timeToEmpty      ?duration     = none
		timeToFull       ?duration     = none
		health           BatteryHealth = BatteryHealth.Unknown
		// What the battery holds at full against when it was new, 0 to 1.
		capacity         ?float        = none
		cycles           ?int          = none
		// Degrees Celsius.
		temperature      ?float        = none
		// `Li-ion`, `Li-poly`, `LiFePO4`, `lead acid`, `NiMH`, `NiCd`;
		// empty when not reported.
		technology       string        = ""
		// For a UPS: the share of its rating the load draws, 0 to 1.
		load             ?float        = none
	}

	// What happened to a power source.
	enum PowerChangeKind {
		// It appeared: plugged in, or paired.
		Added,
		// It went away; the change holds it as it was last seen.
		Removed,
		// Its state, charge, times, health or supply changed.
		Changed,
	}

	// One change `powerChanges` reports.
	struct PowerChange {
		kind   PowerChangeKind
		source PowerSource
	}

	// The batteries, adapters and UPSs: from UPower when it runs (which
	// knows peripherals' batteries and USB UPSs too), else from the
	// kernel's power supplies and the UPSs on raw HID.
	//
	// Fails when the policy denies listing the devices, or UPower answers
	// with an error.
	@requires("adm.devices.list")
	def powerSources() !PowerSource[] {
		let listed = try upowerList()
		if !(listed is none) {
			let sources PowerSource[] = listed
			return sources
		}
		let out = sysfsPowerSources(POWER_SUPPLY_ROOT)
		out.push(...upsSources())
		return out
	}

	// The changes to the power sources, one at a time as they happen:
	// UPower's own notices when it runs; else the kernel's power supply
	// events, the UPSs' reports, and a look every 30 seconds for what no
	// event announces. The sources already there when it starts are not
	// reported; `powerSources()` lists them. Breaking out of the loop, or
	// dropping the iterator, stops following.
	//
	// Fails when the policy denies listing the devices. The sequence fails,
	// and ends, when UPower goes away.
	@requires("adm.devices.list")
	def powerChanges() !Iterator<!PowerChange> {
		return followPower()
	}

	// The sequence powerChanges hands out: UPower's when it runs, else the
	// kernel's and the UPSs'.
	internal def followPower() Iterator<!PowerChange> {
		let upower = upowerFollow()
		if !(upower is none) {
			let changes Iterator<!PowerChange> = upower
			for let change in changes {
				yield change
			}
			return
		}
		for let change in localPowerChanges(POWER_SUPPLY_ROOT, POWER_POLL) {
			yield change
		}
	}

	// The changes of the kernel's power supplies and the UPSs, seen by
	// listing them again on each power supply uevent, each input report a
	// UPS sends, and every `poll` (a battery's charge moves without events
	// on many machines).
	internal def localPowerChanges(root string, poll duration) Iterator<!PowerChange> {
		let wake = new channel<none>(1)
		let watch = new PowerWatch(wake)
		defer watch.stop()
		let events = __net_netlink(POWER_UEVENTS, POWER_UEVENT_GROUP) onerror recover -1
		watch.uevents(events) when events >= 0
		watch.followUps()
		let known = localPowerState(root)
		for {
			let tick = time.sleepChan(poll)
			select {
				case wake:
					// A supply's events come in a burst.
					time.sleep(POWER_SETTLE)
				case tick:
				// time for a look
			}
			watch.followUps()
			let now = localPowerState(root)
			for let (_, change) in powerDifferences(known, now) {
				yield change
			}
			known = now
		}
	}

	// The kernel's supplies and the UPSs, by id.
	internal def localPowerState(root string) map<string, PowerSource> {
		let out = map<string, PowerSource>{}
		for let (_, source) in sysfsPowerSources(root) {
			out[source.id] = source
		}
		for let (_, source) in upsSources() {
			out[source.id] = source
		}
		return out
	}

	// What changed from one look to the next: sources added, changed, then
	// removed.
	internal def powerDifferences(before map<string, PowerSource>, now map<string, PowerSource>) PowerChange[] {
		let out PowerChange[]
		for let (id, source) in now {
			let last = before.get(id)
			if last is none {
				out.push(PowerChange{kind: PowerChangeKind.Added, source: source})
				continue
			}
			let was PowerSource = last
			out.push(PowerChange{kind: PowerChangeKind.Changed, source: source}) when powerChanged(was, source)
		}
		for let (id, source) in before {
			out.push(PowerChange{kind: PowerChangeKind.Removed, source: source}) unless now.hasKey(id)
		}
		return out
	}

	// The tasks that wake the reader of localPowerChanges: one on the
	// kernel's power supply events, one on each UPS's input reports.
	internal type PowerWatch {
		internal wake    channel<none>
		internal running bool              = true
		// The UPSs followed, by raw HID id.
		internal upses   map<string, bool>

		def new(wake channel<none>) {
			self.wake = wake
			upses = map<string, bool>{}
		}

		// Starts the task reading the kernel's device events off the socket,
		// which it closes when it ends.
		def uevents(fd int) {
			async readUevents(fd)
		}

		// Starts a task on each UPS this user may open that none follows
		// yet; a UPS that went away has its task end on its own.
		def followUps() {
			for let (_, d) in hidDevices() onerror recover [] {
				continue unless d.usagePage := 0x84 || 0x85
				continue when following(d.id)
				let hid = openHid(d.id) onerror (err error) {
					continue
				}
				follow(d.id)
				async readUps(d.id, hid)
			}
		}

		def stop() {
			markStopped()
		}

		atomic def markStopped() {
			running = false
		}

		atomic def isRunning() bool {
			return running
		}

		internal atomic def following(id string) bool {
			return upses.hasKey(id)
		}

		internal atomic def follow(id string) {
			upses[id] = true
		}

		internal atomic def forget(id string) {
			upses.delete(id)
		}

		// Reads device events until stopped or the socket fails, waking the
		// reader for each one about a power supply.
		internal def readUevents(fd int) {
			let buf byte[]
			buf.len(SOUND_UEVENT_MAX)
			for isRunning() {
				let n = __net_read(fd, buf, SOUND_POLL) onerror (err error) {
					recover err.code == "ETIMEDOUT" ?? (-2, -1)
				}
				continue when n == -2
				break when n <= 0
				if ueventSubsystem(buf.slice(0, n)) == "power_supply" {
					let _ = wake.offer(none)
				}
			}
			__net_close(fd) onerror recover none
		}

		// Reads a UPS's input reports (it sends one when its state changes)
		// until stopped or it goes away, waking the reader for each.
		internal def readUps(id string, hid HidDevice) {
			for isRunning() {
				let report = hid.read(SOUND_POLL) onerror (err error) {
					break
				}
				if !(report is none) {
					let _ = wake.offer(none)
				}
			}
			hid.close()
			forget(id)
		}
	}

	// Whether two looks at a source differ in what a change reports: its
	// state, charge, times, health, supply or presence.
	internal def powerChanged(a PowerSource, b PowerSource) bool {
		return a.state != b.state || a.online != b.online || a.present != b.present || a.health != b.health || !same(a.charge, b.charge) || !same(a.timeToEmpty, b.timeToEmpty) || !same(a.timeToFull, b.timeToFull) || !same(a.capacity, b.capacity) || !same(a.load, b.load)
	}

	// Whether two optional values are both none or equal.
	internal def same<T>(a ?T, b ?T) bool {
		return b is none when a is none
		return false when b is none
		let x T = a
		let y T = b
		return x == y
	}

	// The power supplies under a sysfs class folder, one per entry, from
	// each one's `uevent` (every POWER_SUPPLY_ property in one read).
	internal def sysfsPowerSources(root string) PowerSource[] {
		let out PowerSource[]
		let names = (__fs_read_dir(root) onerror recover[]).sort((a, b) => a < b)
		for let (_, name) in names {
			let raw = __fs_read_all("{root}/{name}/uevent") onerror recover byte[]
			continue when raw.len() == 0
			let source = sysfsSource(name, ueventProperties(string(raw)))
			out.push(source) unless source is none
		}
		return out
	}

	// The POWER_SUPPLY_ properties of a uevent, without the prefix.
	internal def ueventProperties(text string) map<string, string> {
		let out = map<string, string>{}
		for let (_, line) in text.split("\n") {
			let eq = line.indexOf("=")
			continue when eq <= 0
			let key = line[0:eq]
			continue unless key.startsWith("POWER_SUPPLY_")
			out[key[13:]] = line[eq + 1:].trim()
		}
		return out
	}

	// A power source from a supply's properties; none for a type it does
	// not describe.
	internal def sysfsSource(name string, p map<string, string>) ?PowerSource {
		let found = powerKindOf(text(p, "TYPE"))
		return none when found is none
		let k PowerKind = found
		let model = text(p, "MODEL_NAME")
		let source = PowerSource{
			id:         "power:" + name,
			kind:       k,
			name:       model != "" ?? (model, name),
			vendor:     text(p, "MANUFACTURER"),
			model:      model,
			serial:     text(p, "SERIAL_NUMBER"),
			peripheral: text(p, "SCOPE") == "Device" ?? (peripheralOf(name), ""),
			present:    text(p, "PRESENT") != "0",
			state:      chargeStateOf(text(p, "STATUS")),
			health:     healthOf(text(p, "HEALTH")),
			technology: text(p, "TECHNOLOGY") == "Unknown" ?? ("", text(p, "TECHNOLOGY")),
		}
		let online = number(text(p, "ONLINE"))
		if !(online is none) {
			let v float = online
			source.online = v > 0.0
		}
		// Energy in µWh; a battery that counts charge in µAh is converted at its voltage.
		let microvolts = number(text(p, "VOLTAGE_NOW"))
		source.voltage = scaled(microvolts, 0.000001)
		// Charge (µAh) is turned into energy at the design voltage, else the
		// present one, as UPower does, so the three stay comparable.
		let designVolts = scaled(number(text(p, "VOLTAGE_MIN_DESIGN")), 0.000001)
		let volts = designVolts is none ?? (source.voltage, designVolts)
		source.energy = energyOf(p, "ENERGY_NOW", "CHARGE_NOW", volts)
		source.energyFull = energyOf(p, "ENERGY_FULL", "CHARGE_FULL", volts)
		source.energyFullDesign = energyOf(p, "ENERGY_FULL_DESIGN", "CHARGE_FULL_DESIGN", volts)
		let watts = scaled(number(text(p, "POWER_NOW")), 0.000001)
		if watts is none {
			let amps = scaled(number(text(p, "CURRENT_NOW")), 0.000001)
			let present = source.voltage
			if !(amps is none) && !(present is none) {
				let a float = amps
				let v float = present
				watts = (a * v).abs()
			}
		}
		source.power = watts
		source.charge = share(source.energy, source.energyFull)
		source.charge = share(number(text(p, "CHARGE_NOW")), number(text(p, "CHARGE_FULL"))) when source.charge is none
		if source.charge is none {
			let percent = number(text(p, "CAPACITY"))
			source.charge = scaled(percent, 0.01)
		}
		source.capacity = share(source.energyFull, source.energyFullDesign)
		source.capacity = share(number(text(p, "CHARGE_FULL")), number(text(p, "CHARGE_FULL_DESIGN"))) when source.capacity is none
		source.timeToEmpty = seconds(number(text(p, "TIME_TO_EMPTY_NOW")))
		source.timeToFull = seconds(number(text(p, "TIME_TO_FULL_NOW")))
		estimateTimes(source)
		let cycles = number(text(p, "CYCLE_COUNT"))
		if !(cycles is none) {
			let c float = cycles
			source.cycles = int(c) when c >= 0.0
		}
		source.temperature = scaled(number(text(p, "TEMP")), 0.1)
		return source
	}

	// The time to empty or full from the energy and the power when the
	// supply does not say, as UPower works it out.
	internal def estimateTimes(source PowerSource) {
		let rate = source.power
		return when rate is none
		let watts float = rate
		return when watts <= 0.0
		let now = source.energy
		if source.state == ChargeState.Discharging && source.timeToEmpty is none && !(now is none) {
			let wh float = now
			source.timeToEmpty = duration(int64(wh / watts * 3600.0 * 1000000000.0))
		}
		let full = source.energyFull
		if source.state == ChargeState.Charging && source.timeToFull is none && !(now is none) && !(full is none) {
			let wh float = now
			let top float = full
			source.timeToFull = duration(int64((top - wh).max(0.0) / watts * 3600.0 * 1000000000.0)) when top > wh
		}
	}

	// Watt-hours from a supply's µWh property, else its µAh one at volts.
	internal def energyOf(p map<string, string>, energyKey string, chargeKey string, volts ?float) ?float {
		let energy = scaled(number(text(p, energyKey)), 0.000001)
		return energy unless energy is none
		let charge = scaled(number(text(p, chargeKey)), 0.000001)
		return none when charge is none || volts is none
		let ah float = charge
		let v float = volts
		return ah * v
	}

	// A property, "" when it is not there.
	internal def text(p map<string, string>, key string) string {
		let v = p.get(key)
		return "" when v is none
		let found string = v
		return found
	}

	// A value times a factor, none for none.
	internal def scaled(v ?float, factor float) ?float {
		return none when v is none
		let f float = v
		return f * factor
	}

	// One value as a share of another, none when either is missing or the
	// second is not positive.
	internal def share(part ?float, whole ?float) ?float {
		return none when part is none || whole is none
		let p float = part
		let w float = whole
		return none when w <= 0.0
		return (p / w).max(0.0).min(1.0)
	}

	// Whole seconds as a duration, none for none or 0 (which supplies and
	// UPower give for "not known").
	internal def seconds(v ?float) ?duration {
		return none when v is none
		let s float = v
		return none when s <= 0.0
		return duration(int64(s)) * 1s
	}

	// The kind a sysfs TYPE names, none for another.
	internal def powerKindOf(name string) ?PowerKind {
		match name {
			case "Battery":
				return PowerKind.Battery
			case "Mains":
				return PowerKind.Mains
			case "UPS":
				return PowerKind.Ups
			case "USB":
				return PowerKind.Usb
			case "Wireless":
				return PowerKind.Wireless
		}
		return none
	}

	// What a peripheral's supply powers, from the names the kernel's
	// drivers give them (`hid-<address>-battery`, `hidpp_battery_0`,
	// `ps-controller-battery-<address>`, `nintendo_switch_controller_battery_<address>`).
	internal def peripheralOf(name string) string {
		return "gaming-input" when name.contains("controller") || name.startsWith("sony_controller") || name.startsWith("xpadneo")
		return "headset" when name.contains("headset")
		return "device"
	}

	// The state a sysfs STATUS names.
	internal def chargeStateOf(status string) ChargeState {
		match status {
			case "Charging":
				return ChargeState.Charging
			case "Discharging":
				return ChargeState.Discharging
			case "Not charging":
				return ChargeState.NotCharging
			case "Full":
				return ChargeState.Full
		}
		return ChargeState.Unknown
	}

	// The health a sysfs HEALTH names.
	internal def healthOf(health string) BatteryHealth {
		match health {
			case "Good":
				return BatteryHealth.Good
			case "Overheat":
				return BatteryHealth.Overheat
			case "Dead":
				return BatteryHealth.Dead
			case "Over voltage":
				return BatteryHealth.OverVoltage
			case "Over current":
				return BatteryHealth.OverCurrent
			case "Unspecified failure":
				return BatteryHealth.Failure
			case "Cold":
				return BatteryHealth.Cold
			case "Cool":
				return BatteryHealth.Cool
			case "Warm":
				return BatteryHealth.Warm
			case "Hot":
				return BatteryHealth.Hot
			case "Watchdog timer expire", "Safety timer expire":
				return BatteryHealth.TimerExpired
			case "Calibration required":
				return BatteryHealth.CalibrationRequired
			case "No battery":
				return BatteryHealth.NoBattery
		}
		return BatteryHealth.Unknown
	}

	// Where the kernel lists its power supplies.
	internal const POWER_SUPPLY_ROOT = "/sys/class/power_supply"
	// linux/netlink.h: the kernel's device events and their multicast group.
	internal const POWER_UEVENTS = 15
	internal const POWER_UEVENT_GROUP = 1
	// How often the supplies are looked at without an event.
	internal const POWER_POLL = 30s
	// How long after the first event of a burst the supplies are read.
	internal const POWER_SETTLE = 100ms
}
