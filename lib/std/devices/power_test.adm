partial module std.devices {
	use (
		std.testing
		std.os
		std.time
		std.services.devices::(Device, DeviceKind)
		std.devices.structs::*
	)

	// A laptop's battery as the kernel's ACPI battery driver writes its
	// uevent (energy in µWh), discharging.
	internal const LAPTOP_BATTERY = "POWER_SUPPLY_NAME=BAT0\nPOWER_SUPPLY_TYPE=Battery\nPOWER_SUPPLY_STATUS=Discharging\nPOWER_SUPPLY_PRESENT=1\nPOWER_SUPPLY_TECHNOLOGY=Li-poly\nPOWER_SUPPLY_CYCLE_COUNT=187\nPOWER_SUPPLY_VOLTAGE_MIN_DESIGN=15440000\nPOWER_SUPPLY_VOLTAGE_NOW=16252000\nPOWER_SUPPLY_POWER_NOW=7640000\nPOWER_SUPPLY_ENERGY_FULL_DESIGN=57000000\nPOWER_SUPPLY_ENERGY_FULL=48770000\nPOWER_SUPPLY_ENERGY_NOW=36580000\nPOWER_SUPPLY_CAPACITY=75\nPOWER_SUPPLY_CAPACITY_LEVEL=Normal\nPOWER_SUPPLY_MODEL_NAME=5B10W13930\nPOWER_SUPPLY_MANUFACTURER=SMP\nPOWER_SUPPLY_SERIAL_NUMBER= 1234\n"

	// A battery that counts charge (µAh) and current, charging, with a
	// health and a temperature.
	internal const CHARGE_BATTERY = "POWER_SUPPLY_NAME=BAT1\nPOWER_SUPPLY_TYPE=Battery\nPOWER_SUPPLY_STATUS=Charging\nPOWER_SUPPLY_PRESENT=1\nPOWER_SUPPLY_TECHNOLOGY=Li-ion\nPOWER_SUPPLY_VOLTAGE_MIN_DESIGN=11100000\nPOWER_SUPPLY_VOLTAGE_NOW=12000000\nPOWER_SUPPLY_CURRENT_NOW=1500000\nPOWER_SUPPLY_CHARGE_FULL_DESIGN=4000000\nPOWER_SUPPLY_CHARGE_FULL=3600000\nPOWER_SUPPLY_CHARGE_NOW=1800000\nPOWER_SUPPLY_HEALTH=Good\nPOWER_SUPPLY_TEMP=312\nPOWER_SUPPLY_TIME_TO_FULL_NOW=4200\n"

	internal const AC_ADAPTER = "POWER_SUPPLY_NAME=AC\nPOWER_SUPPLY_TYPE=Mains\nPOWER_SUPPLY_ONLINE=1\n"

	// A Bluetooth mouse's battery as hid-input reports it.
	internal const MOUSE_BATTERY = "POWER_SUPPLY_NAME=hid-dc:2c:26:01:02:03-battery\nPOWER_SUPPLY_TYPE=Battery\nPOWER_SUPPLY_PRESENT=1\nPOWER_SUPPLY_ONLINE=1\nPOWER_SUPPLY_CAPACITY=40\nPOWER_SUPPLY_SCOPE=Device\nPOWER_SUPPLY_STATUS=Discharging\nPOWER_SUPPLY_MODEL_NAME=MX Anywhere 3\n"

	// A folder standing in for /sys/class/power_supply, with a uevent per
	// supply given.
	internal def fakeSupplies(supplies map<string, string>) !string {
		let root = os.join(os.tempDir(), "adm-power-{time.now().unixNs()}")
		try os.mkdir(root, true)
		for let (name, uevent) in supplies {
			try writeSupply(root, name, uevent)
		}
		return root
	}

	// Removes the fake supplies' folder.
	internal def dropSupplies(root string) {
		os.remove(root, true) onerror recover none
	}

	internal def writeSupply(root string, name string, uevent string) !none {
		try os.mkdir(os.join(root, name), true)
		try os.writeFile(os.join(os.join(root, name), "uevent"), uevent.bytes())
		return none
	}

	// The source with the id among those listed.
	internal def sourceNamed(all PowerSource[], id string) !PowerSource {
		for let (_, s) in all {
			return s when s.id == id
		}
		fail "no source {id}"
	}

	// Whether an optional number is within a thousandth of another.
	internal def close(v ?float, want float) bool {
		return false when v is none
		let got float = v
		return (got - want).abs() < 0.001
	}

	// The Back-UPS CS 500's report descriptor and the feature reports it
	// answered, from the log of NUT's usbhid-ups driver for it
	// (networkupstools.org/ddl/APC/Back-UPS_CS_500.html).
	internal const BACK_UPS_DESCRIPTOR = ""

	internal const BACK_UPS_REPORTS = ["0101", "0202", "0304", "0403", "0501", "06000008", "07e330", "08b004", "094e05", "0a03", "0b02", "0c640000140a", "0d640000", "0e640000", "0f320000", "10010000", "110a0000", "12010000", "1301", "140000", "3500", "1c040307", "4000"]

	// Hexadecimal digits, spaces allowed, as bytes.
	internal def unhex(text string) byte[] {
		let digits = text.replace(" ", "")
		let out byte[]
		for let i = 0; i + 1 < digits.len(); i += 2 {
			out.push(byte(digits[i:i + 2].toInt<int>(16)))
		}
		return out
	}

	// A UPS answering feature reports from a table, as a hidraw node would.
	internal type RecordedUps {
		internal reports map<int, byte[]>
		// The lengths asked for, by report id.
		internal asked   map<int, int>

		def new(reports string[]) {
			self.reports = map<int, byte[]>{}
			self.asked = map<int, int>{}
			for let (_, r) in reports {
				let raw = unhex(r)
				self.reports[int(raw[0])] = raw
			}
		}

		// The report, at most length bytes; fails for one the UPS lacks.
		def feature(reportId int, length int) !byte[] {
			asked[reportId] = length
			let found = reports.get(reportId)
			fail Error{message: "no such report", code: "EPIPE"} when found is none
			let raw byte[] = found
			return raw.slice(0, raw.len().min(length)).clone()
		}
	}

	// The fields of a report and kind, by usage.
	internal def fieldOf(fields HidField[], kind int, page int, usage int) !HidField {
		for let (_, f) in fields {
			return f when f.kind == kind && f.page == page && f.usage == usage
		}
		fail "no field {page}:{usage}"
	}

	check "Power" {
		// The kernel's supplies: energy and charge batteries worked out to
		// watt-hours, charge, wear and times; an adapter; a mouse's battery
		// as a peripheral; a supply of no kind left out.
		@os("linux")
		@test()
		def TestKernelSupplies() !none {
			let root = try fakeSupplies(map<string, string>{"AC": AC_ADAPTER, "BAT0": LAPTOP_BATTERY, "BAT1": CHARGE_BATTERY, "hid-dc:2c:26:01:02:03-battery": MOUSE_BATTERY, "odd": "POWER_SUPPLY_NAME=odd\nPOWER_SUPPLY_TYPE=Strange\n"})
			defer dropSupplies(root)
			let all = sysfsPowerSources(root)
			assert all.len() == 4
			let ac = try sourceNamed(all, "power:AC")
			assert ac.kind == PowerKind.Mains && ac.online && ac.charge is none
			let bat = try sourceNamed(all, "power:BAT0")
			assert bat.kind == PowerKind.Battery && bat.state == ChargeState.Discharging && bat.peripheral == ""
			assert bat.name == "5B10W13930" && bat.vendor == "SMP" && bat.serial == "1234" && bat.technology == "Li-poly"
			assert close(bat.energy, 36.58) && close(bat.energyFull, 48.77) && close(bat.energyFullDesign, 57.0)
			assert close(bat.charge, 36.58 / 48.77) && close(bat.capacity, 48.77 / 57.0) && close(bat.power, 7.64) && close(bat.voltage, 16.252)
			let toEmpty = bat.timeToEmpty
			fail "no time to empty" when toEmpty is none
			let left duration = toEmpty
			let secs = int(left / 1s)
			assert secs >= 17234 && secs <= 17238 onerror fail "time to empty {left}"
			assert same(bat.cycles, 187) && bat.health == BatteryHealth.Unknown
			let charging = try sourceNamed(all, "power:BAT1")
			assert charging.state == ChargeState.Charging && charging.health == BatteryHealth.Good
			// µAh at the design voltage, 11.1 V.
			assert close(charging.energyFull, 3.6 * 11.1) && close(charging.energy, 1.8 * 11.1) && close(charging.charge, 0.5)
			assert close(charging.power, 18.0) && close(charging.temperature, 31.2) && close(charging.capacity, 0.9)
			assert same(charging.timeToFull, 4200s)
			let mouse = try sourceNamed(all, "power:hid-dc:2c:26:01:02:03-battery")
			assert mouse.peripheral == "device" && close(mouse.charge, 0.4) && mouse.name == "MX Anywhere 3"
			return none
		}

		// Following the kernel's supplies: a change, a supply added, one
		// removed, in that order, each seen by the next look.
		@os("linux")
		@test()
		def TestKernelSupplyChanges() !none {
			let root = try fakeSupplies(map<string, string>{"AC": AC_ADAPTER, "BAT0": LAPTOP_BATTERY})
			defer dropSupplies(root)
			async changeSupplies(root)
			let seen PowerChange[]
			for let change in localPowerChanges(root, 40ms) {
				seen.push(try change)
				break when seen.len() == 3
			}
			assert seen[0].kind == PowerChangeKind.Changed && seen[0].source.id == "power:BAT0" && seen[0].source.state == ChargeState.Charging
			assert seen[1].kind == PowerChangeKind.Added && seen[1].source.id == "power:BAT1"
			assert seen[2].kind == PowerChangeKind.Removed && seen[2].source.id == "power:AC" && seen[2].source.online
			return none
		}

		// The Back-UPS CS 500's descriptor laid out as NUT lays it out, and
		// the UPS its feature reports describe.
		@test()
		def TestBackUps() !none {
			let fields = try parseHidDescriptor(unhex(BACK_UPS_DESCRIPTOR))
			let remaining = try fieldOf(fields, HID_FEATURE, PAGE_BATTERY, REMAINING_CAPACITY)
			assert remaining.reportId == 0x0C && remaining.bitOffset == 0 && remaining.size == 24
			assert remaining.path.equals([0x840004, 0x840024])
			let runtime = try fieldOf(fields, HID_FEATURE, PAGE_BATTERY, RUN_TIME_TO_EMPTY)
			assert runtime.reportId == 0x0C && runtime.bitOffset == 24 && runtime.size == 16 && runtime.unit == 0x1001
			let discharging = try fieldOf(fields, HID_INPUT, PAGE_BATTERY, DISCHARGING)
			assert discharging.reportId == 0x06 && discharging.bitOffset == 8 && discharging.size == 8
			let voltage = try fieldOf(fields, HID_FEATURE, PAGE_POWER, VOLTAGE)
			assert voltage.reportId == 0x09 && voltage.unitExponent == 5 && voltage.unit == 0x00F0D121 && voltage.logicalMax == 0xFFFE
			let shutdown = try fieldOf(fields, HID_INPUT, PAGE_POWER, 0x69)
			assert shutdown.reportId == 0x14 && shutdown.bitOffset == 8
			let vendor = try fieldOf(fields, HID_FEATURE, 0xFF86, 0x7C)
			assert vendor.reportId == 0x40 && vendor.path.equals([0x840004, 0xFF860005])

			let link = new RecordedUps(BACK_UPS_REPORTS)
			let device = Device{id: "hidraw:hidraw3", kind: DeviceKind.Hid, name: "American Power Conversion Back-UPS 500 FW:6.5.I USB FW:c1", vendor: "American Power Conversion", product: "Back-UPS 500 FW:6.5.I USB FW:c1", serial: "BB0100009999"}
			let ups = upsSource(device, fields, link)
			assert ups.id == "power:ups:hidraw3" && ups.kind == PowerKind.Ups && ups.vendor == "American Power Conversion"
			assert close(ups.charge, 1.0) && same(ups.timeToEmpty, 2580s) && close(ups.voltage, 13.58) onerror fail "voltage {ups.voltage}"
			assert ups.online && ups.state == ChargeState.Full && ups.health == BatteryHealth.Good
			// Percent mode (CapacityMode 2, read raw though the descriptor leaves
			// the volts unit and exponent of report 0x08 in force): no wear
			// from capacities that are percentages.
			assert ups.capacity is none
			// Each report asked for at its length with the id: 0x0C carries 24 + 16 bits.
			assert link.asked[0x0C] == 6 && link.asked[0x09] == 3
			return none
		}

		// Descriptor items: Push and Pop, usage ranges, extended usages, a
		// signed range, a maximum written short, both forms of unit
		// exponent, a long item; values sign-extended.
		@test()
		def TestHidDescriptorItems() !none {
			let d = unhex("0501 a100 0930 0931 7508 9502 1580 257f 8102 a4 0509 1901 2903 7501 9503 1500 2501 8102 b4 0938 2502 9501 8102 0b38000c00 1500 25ff 550e 8102 fe0201aabb 5582 9101 c0")
			let fields = try parseHidDescriptor(d)
			assert fields.len() == 8
			// Two 16-bit signed axes; three buttons (a range) of one bit after Push.
			assert fields[0].usage == 0x30 && fields[0].page == 1 && fields[0].size == 8 && fields[0].logicalMin == -128 && fields[0].logicalMax == 127
			assert fields[1].usage == 0x31 && fields[1].bitOffset == 8
			assert fields[2].page == 9 && fields[2].usage == 1 && fields[4].usage == 3 && fields[4].size == 1 && fields[4].bitOffset == 18
			// After Pop the page is 1 again and the size 8 (Pop restored 16, then 7508).
			assert fields[5].page == 1 && fields[5].usage == 0x38 && fields[5].logicalMax == 2 && fields[5].bitOffset == 19
			// An extended usage brings its own page; a maximum of FF over a minimum of 0 reads 255; exponent 0xE is -2.
			assert fields[6].page == 0x0C && fields[6].usage == 0x38 && fields[6].logicalMin == 0 && fields[6].logicalMax == 255 && fields[6].unitExponent == -2
			assert fields[7].kind == HID_OUTPUT && fields[7].unitExponent == -126 && fields[7].bitOffset == 0
			let report = byte[0xFE, 0x05]
			let x = hidValue(report, HidField{kind: HID_INPUT, reportId: 0, bitOffset: 0, size: 8, page: 1, usage: 0x30, logicalMin: -128, logicalMax: 127, unitExponent: 0, unit: 0, flags: 2, path: []})
			assert same(x, -2)
			let y = hidValue(byte[9, 0xFE, 0x05], HidField{kind: HID_INPUT, reportId: 9, bitOffset: 0, size: 16, page: 1, usage: 0x31, logicalMin: 0, logicalMax: 65535, unitExponent: 0, unit: 0, flags: 2, path: []})
			assert same(y, 0x05FE)
			assert hidValue(byte[9], HidField{kind: HID_INPUT, reportId: 9, bitOffset: 0, size: 8, page: 1, usage: 1, logicalMin: 0, logicalMax: 1, unitExponent: 0, unit: 0, flags: 2, path: []}) is none
			assert siExponent(0x00F0D121) == -7 && siExponent(0x1001) == 0 && siExponent(0) == 0
			let refused = 0
			for let (_, bad) in ["b4", "0501 09", "fe05"] {
				parseHidDescriptor(unhex(bad)) onerror (err error) {
					refused++
					recover []
				}
			}
			assert refused == 3
			return none
		}

		// What counts as a change.
		@test()
		def TestPowerDifferences() {
			let a = PowerSource{id: "power:BAT0", kind: PowerKind.Battery, name: "BAT0", charge: 0.5, power: 7.0}
			let b = PowerSource{...a, power: 9.0}
			let c = PowerSource{...a, charge: 0.49}
			assert !powerChanged(a, b) && powerChanged(a, c)
			assert powerChanged(a, PowerSource{...a, timeToEmpty: 3600s}) && powerChanged(a, PowerSource{...a, state: ChargeState.Charging})
			let changes = powerDifferences(map<string, PowerSource>{"power:BAT0": a, "power:AC": PowerSource{id: "power:AC", kind: PowerKind.Mains, name: "AC"}}, map<string, PowerSource>{"power:BAT0": c, "power:BAT1": a})
			assert changes.len() == 3 && changes[0].kind == PowerChangeKind.Changed && changes[1].kind == PowerChangeKind.Added && changes[2].kind == PowerChangeKind.Removed
		}

		// On this machine: whatever UPower or the kernel lists reads back,
		// and following the changes starts.
		@test()
		def TestPowerSourcesHere() !none {
			let changes = try powerChanges()
			assert !(changes is none)
			for let (_, s) in try powerSources() {
				assert s.id.startsWith("power:")
				let charge = s.charge
				if !(charge is none) {
					let c float = charge
					assert c >= 0.0 && c <= 1.0
				}
			}
			return none
		}
	}

	// Changes the fake supplies one step at a time: the battery starts
	// charging, a second battery comes, the adapter goes.
	internal def changeSupplies(root string) {
		time.sleep(120ms)
		writeSupply(root, "BAT0", LAPTOP_BATTERY.replace("Discharging", "Charging")) onerror recover none
		time.sleep(120ms)
		writeSupply(root, "BAT1", CHARGE_BATTERY) onerror recover none
		time.sleep(120ms)
		os.remove(os.join(root, "AC"), true) onerror recover none
	}
}
