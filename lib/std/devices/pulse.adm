internal partial module std.devices.pulse {
	use (
		std.bytes::(Endian)
		std.services.devices::(Device, DeviceKind)
		std.devices::*
		std.devices.alsa::*
		std.devices.samples::*
	)

	// PulseAudio's native protocol, spoken to the desktop's sound server over its
	// Unix socket. PipeWire serves the same socket, so this reaches either.
	//
	// The server is what knows which output and input the desktop uses, owns
	// Bluetooth and virtual devices, and shares a device between programs; a
	// program playing through it never finds a device busy. The sound goes to
	// it as float32 at the program's own rate and channel count, and it converts.
	//
	// A packet is a 20-byte header (length, channel, two offset words, flags,
	// big-endian) and a payload. Commands and their replies travel on the control
	// channel as tag structures: every value is one type byte then the value,
	// big-endian. Audio travels on the channel of its stream as raw samples.

	// The protocol version asked for. Newer servers answer with the smaller of
	// theirs and this, and the record layouts below are those of version 32.
	const PULSE_VERSION = 32
	const PULSE_HEADER_SIZE = 20
	// The channel of commands and replies, and the index meaning "none".
	const PULSE_CONTROL = 0xFFFFFFFF
	const PULSE_NO_INDEX = 0xFFFFFFFF
	const PULSE_COOKIE_SIZE = 256
	// The most audio sent in one packet.
	const PULSE_MAX_PACKET = 65536
	// How long the server may take to answer or ask for more before it counts as gone.
	const PULSE_TIMEOUT = 5s

	// Commands.
	const PULSE_ERROR = 0
	const PULSE_REPLY = 2
	const PULSE_CREATE_PLAYBACK_STREAM = 3
	const PULSE_DELETE_PLAYBACK_STREAM = 4
	const PULSE_CREATE_RECORD_STREAM = 5
	const PULSE_DELETE_RECORD_STREAM = 6
	const PULSE_AUTH = 8
	const PULSE_SET_CLIENT_NAME = 9
	const PULSE_DRAIN_PLAYBACK_STREAM = 12
	const PULSE_GET_SERVER_INFO = 20
	const PULSE_GET_SINK_INFO = 21
	const PULSE_GET_SINK_INFO_LIST = 22
	const PULSE_GET_SOURCE_INFO = 23
	const PULSE_GET_SOURCE_INFO_LIST = 24
	const PULSE_GET_SINK_INPUT_INFO = 29
	const PULSE_GET_SOURCE_OUTPUT_INFO = 31
	const PULSE_SUBSCRIBE = 35
	const PULSE_SET_SINK_VOLUME = 36
	const PULSE_SET_SINK_INPUT_VOLUME = 37
	const PULSE_SET_SOURCE_VOLUME = 38
	const PULSE_SET_SINK_MUTE = 39
	const PULSE_SET_SOURCE_MUTE = 40
	const PULSE_SET_SINK_INPUT_MUTE = 69
	const PULSE_SET_SOURCE_OUTPUT_VOLUME = 98
	const PULSE_SET_SOURCE_OUTPUT_MUTE = 99

	// The server handing over its ring-buffer channel (tagged), taking it
	// back, and either side registering a memfd pool its blocks live in.
	const PULSE_ENABLE_SRBCHANNEL = 101
	const PULSE_DISABLE_SRBCHANNEL = 102
	const PULSE_REGISTER_MEMFD_SHMID = 103

	// Shared memory. AUTH's version word carries in its top bits whether a
	// side can reference blocks of shared memory instead of copying audio
	// down the socket, and whether its pools are memfds. A packet whose
	// flags word has SHMDATA carries no audio but where it lies: block id,
	// pool id, offset and length, four big-endian words. The side that
	// imported a block sends SHMRELEASE (no payload, the block id in the
	// first offset word) once it is done with it; SHMREVOKE takes one back.
	const PROTOCOL_SHM = 0x80000000
	const PROTOCOL_MEMFD = 0x40000000
	const FLAG_SHMDATA = 0x80000000
	const FLAG_SHMRELEASE = 0x40000000
	const FLAG_SHMREVOKE = 0xC0000000
	const FLAG_SHMDATA_MEMFD_BLOCK = 0x20000000
	const SHM_INFO_SIZE = 16
	// This side's pool: slots of a block each, so a slot is written again
	// only once the server has let go of the block in it.
	const POOL_SLOTS = 16
	const POOL_SLOT_BYTES = 65536
	// The pool id this side registers; ids are per connection.
	const POOL_ID = 1

	// What the server sends unasked, with no tag: a playback stream asked for
	// more bytes, a stream ended or moved to another device, a subscribed
	// change.
	const PULSE_REQUEST = 61
	const PULSE_PLAYBACK_STREAM_KILLED = 64
	const PULSE_RECORD_STREAM_KILLED = 65
	const PULSE_SUBSCRIBE_EVENT = 66
	const PULSE_PLAYBACK_STREAM_MOVED = 78
	const PULSE_RECORD_STREAM_MOVED = 79

	// What a subscription asks to hear about: sinks, sources and the server
	// (whose change is a new default).
	const SUBSCRIBE_SINK = 0x0001
	const SUBSCRIBE_SOURCE = 0x0002
	const SUBSCRIBE_SERVER = 0x0080
	// A subscription event is a facility in the low four bits and a type in
	// the next two.
	const EVENT_FACILITY = 0x000F
	const EVENT_SINK = 0
	const EVENT_SOURCE = 1
	const EVENT_SERVER = 7
	const EVENT_TYPE = 0x0030
	const EVENT_NEW = 0x0000
	const EVENT_CHANGE = 0x0010
	const EVENT_REMOVE = 0x0020

	// Tag bytes.
	const TAG_U32 = 0x4C
	const TAG_U8 = 0x42
	const TAG_U64 = 0x52
	const TAG_S64 = 0x72
	const TAG_USEC = 0x55
	const TAG_STRING = 0x74
	const TAG_NULL = 0x4E
	const TAG_ARBITRARY = 0x78
	const TAG_TRUE = 0x31
	const TAG_FALSE = 0x30
	const TAG_SAMPLE_SPEC = 0x61
	const TAG_CHANNEL_MAP = 0x6D
	const TAG_CVOLUME = 0x76
	const TAG_VOLUME = 0x56
	const TAG_TIMEVAL = 0x54
	const TAG_PROPLIST = 0x50
	const TAG_FORMAT_INFO = 0x66

	// Samples as float32, little-endian; full volume, and the loudest the
	// server takes.
	const PULSE_FLOAT32LE = 5
	const PULSE_VOLUME_NORM = 0x10000
	const PULSE_VOLUME_MAX = 0x7FFFFFFF
	// How much a playback stream keeps queued, and how much a record stream
	// hands over at a time, in milliseconds.
	const PULSE_TARGET_MS = 100
	const PULSE_FRAGMENT_MS = 20

	// Channel positions: mono, then front left, front right, front center, rear
	// center, rear left, rear right, LFE, and side left and right.
	const POSITION_MONO = 0
	const POSITION_FRONT_LEFT = 1
	const POSITION_FRONT_RIGHT = 2
	const POSITION_FRONT_CENTER = 3
	const POSITION_REAR_CENTER = 4
	const POSITION_REAR_LEFT = 5
	const POSITION_REAR_RIGHT = 6
	const POSITION_LFE = 7
	const POSITION_SIDE_LEFT = 10
	const POSITION_SIDE_RIGHT = 11

	// --- tag structures ---------------------------------------------------------

	// A command being written, one tagged value after another.
	type PulseTags {
		bytes byte[]

		def u32(value int) PulseTags {
			bytes.push(byte(TAG_U32))
			raw(value)
			return self
		}

		def u8(value int) PulseTags {
			bytes.push(byte(TAG_U8), byte(value & 0xFF))
			return self
		}

		def flag(value bool) PulseTags {
			bytes.push(byte(value ?? (TAG_TRUE, TAG_FALSE)))
			return self
		}

		// A string, or the null string when it is empty.
		def text(value string) PulseTags {
			if value == "" {
				bytes.push(byte(TAG_NULL))
				return self
			}
			bytes.push(byte(TAG_STRING))
			for let (_, b) in value.bytes() {
				bytes.push(b)
			}
			bytes.push(byte(0))
			return self
		}

		def arbitrary(data byte[]) PulseTags {
			bytes.push(byte(TAG_ARBITRARY))
			raw(data.len())
			for let (_, b) in data {
				bytes.push(b)
			}
			return self
		}

		// Float32 samples at the rate and channel count.
		def sampleSpec(rate int, channels int) PulseTags {
			bytes.push(byte(TAG_SAMPLE_SPEC), byte(PULSE_FLOAT32LE), byte(channels))
			raw(rate)
			return self
		}

		// The usual speaker positions for the channel count.
		def channelMap(channels int) PulseTags {
			let positions = channelPositions(channels)
			bytes.push(byte(TAG_CHANNEL_MAP), byte(positions.len()))
			for let (_, position) in positions {
				bytes.push(byte(position))
			}
			return self
		}

		// Full volume on every channel.
		def fullVolume(channels int) PulseTags {
			bytes.push(byte(TAG_CVOLUME), byte(channels))
			for let c = 0; c < channels; c++ {
				raw(PULSE_VOLUME_NORM)
			}
			return self
		}

		// One volume for every channel: the server scales each channel so the
		// loudest is at the level, keeping the balance between them, where 1.0
		// is full volume as the desktop's mixer shows it.
		def volume(level float) PulseTags {
			bytes.push(byte(TAG_CVOLUME), byte(1))
			raw(pulseVolume(level))
			return self
		}

		// String properties, each stored with its terminating zero.
		def properties(values map<string, string>) PulseTags {
			bytes.push(byte(TAG_PROPLIST))
			for let (key, value) in values {
				let data = value.bytes()
				data.push(byte(0))
				text(key)
				u32(data.len())
				arbitrary(data)
			}
			bytes.push(byte(TAG_NULL))
			return self
		}

		// A 32-bit big-endian word with no tag.
		def raw(value int) {
			for let (_, b) in uint32(value).bytes(Endian.Big) {
				bytes.push(b)
			}
		}
	}

	// A reply being read, one tagged value after another.
	type PulseReader {
		data        byte[]
		internal at int    = 0

		def new(data byte[]) {
			self.data = data
		}

		// Whether values are left.
		def more() bool {
			return at < data.len()
		}

		// A 32-bit value; PULSE_NO_INDEX reads as -1, as every value past the
		// largest int would not fit.
		//
		// Fails when the next value is not one.
		def u32() !int {
			try expect(TAG_U32)
			return word()
		}

		// An 8-bit value.
		//
		// Fails when the next value is not one.
		def u8() !int {
			try expect(TAG_U8)
			try need(1)
			at += 1
			return int(data[at - 1])
		}

		// A boolean.
		//
		// Fails when the next value is not one.
		def flag() !bool {
			try need(1)
			let kind = int(data[at])
			fail "devices: the sound server sent type {kind} where a boolean belongs" unless kind := TAG_TRUE || TAG_FALSE
			at += 1
			return kind == TAG_TRUE
		}

		// A volume per channel, read as the loudest of them on the scale where
		// 1.0 is full volume.
		//
		// Fails when the next value is not one.
		def volume() !float {
			try expect(TAG_CVOLUME)
			try need(1)
			let channels = int(data[at])
			at += 1
			let loudest = 0
			for let c = 0; c < channels; c++ {
				let level = try word()
				loudest = level when level > loudest
			}
			return float(loudest) / float(PULSE_VOLUME_NORM)
		}

		// A string; the null string reads as "".
		//
		// Fails when the next value is not a string.
		def text() !string {
			try need(1)
			let kind = int(data[at])
			if kind == TAG_NULL {
				at += 1
				return ""
			}
			try expect(TAG_STRING)
			let start = at
			for at < data.len() && data[at] != byte(0) {
				at += 1
			}
			try need(1)
			at += 1
			return string(data[start:at - 1])
		}

		// A property list, each value up to its terminating zero.
		//
		// Fails when the next value is not one.
		def properties() !map<string, string> {
			try expect(TAG_PROPLIST)
			let out map<string, string>
			for {
				let key = try text()
				break when key == ""
				let length = try u32()
				try expect(TAG_ARBITRARY)
				let size = try word()
				try need(size)
				let value = data[at:at + size]
				at += size
				let end = length > 0 && length <= value.len() && value[length - 1] == byte(0) ?? (length - 1, value.len())
				out[key] = string(value[0:end])
			}
			return out
		}

		// Passes over the next count values, whatever they are.
		//
		// Fails when the reply ends first or holds a type this reader does not know.
		def skip(count int = 1) !none {
			for let n = 0; n < count; n++ {
				try need(1)
				let kind = int(data[at])
				at += 1
				if kind := TAG_U32 || TAG_VOLUME {
					at += 4
				} else if kind == TAG_U8 {
					at += 1
				} else if kind := TAG_U64 || TAG_S64 || TAG_USEC || TAG_TIMEVAL {
					at += 8
				} else if kind == TAG_STRING {
					for at < data.len() && data[at] != byte(0) {
						at += 1
					}
					at += 1
				} else if kind == TAG_ARBITRARY {
					let size = try word()
					at += size
				} else if kind == TAG_SAMPLE_SPEC {
					at += 6
				} else if kind := TAG_CHANNEL_MAP || TAG_CVOLUME {
					try need(1)
					let entries = int(data[at])
					at += 1 + (kind == TAG_CVOLUME ?? (4 * entries, entries))
				} else if kind == TAG_PROPLIST {
					at -= 1
					try properties()
				} else if kind == TAG_FORMAT_INFO {
					try skip(2)
				} else {
					fail "devices: the sound server sent a value of unknown type {kind}" unless kind := TAG_TRUE || TAG_FALSE || TAG_NULL
				}
				try need(0)
			}
			return none
		}

		// A big-endian 32-bit word with no tag.
		internal def word() !int {
			try need(4)
			at += 4
			let value = uint32(0).fromBytes(data[at - 4:at], Endian.Big)
			return -1 when value == uint32(PULSE_NO_INDEX)
			return int(value)
		}

		internal def expect(kind int) !none {
			try need(1)
			fail "devices: the sound server sent type {int(data[at])} where {kind} belongs" when int(data[at]) != kind
			at += 1
			return none
		}

		internal def need(count int) !none {
			expects {
				assert at + count <= data.len() onerror fail "devices: the sound server's reply ended early"
			}
			return none
		}
	}

	// The speaker positions of a stream with that many channels.
	def channelPositions(channels int) int[] {
		match channels {
			case 1:
				return [POSITION_MONO]
			case 2:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT]
			case 3:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER]
			case 4:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_REAR_LEFT, POSITION_REAR_RIGHT]
			case 5:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER, POSITION_REAR_LEFT, POSITION_REAR_RIGHT]
			case 6:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER, POSITION_LFE, POSITION_REAR_LEFT, POSITION_REAR_RIGHT]
			case 7:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER, POSITION_LFE, POSITION_REAR_CENTER, POSITION_SIDE_LEFT, POSITION_SIDE_RIGHT]
			default:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER, POSITION_LFE, POSITION_REAR_LEFT, POSITION_REAR_RIGHT, POSITION_SIDE_LEFT, POSITION_SIDE_RIGHT]
		}
	}

	// --- the connection ---------------------------------------------------------

	// A connection to the sound server, carrying at most one stream.
	type PulseConnection {
		internal fd          int           = -1
		internal nextTag     int           = 0
		// Bytes the server asked the playback stream for and has not had yet.
		requested            int           = 0
		// Audio the record stream delivered and nobody has taken yet.
		received             byte[]
		// Whether the server ended the stream, as when its device went away
		// with nowhere to move it.
		killed               bool          = false
		// The device the server moved the stream to, "" until it does and
		// again once the stream has taken note.
		movedTo              string        = ""
		// Subscribed changes not yet handed out: the event (facility and
		// type) and the index of what changed.
		events               (int, int)[]
		// Whether blocks of shared memory may stand in for audio, and whether
		// the server's pools are memfds, as AUTH settled it.
		shm                  bool          = false
		memfd                bool          = false
		// The server's pools mapped here, by pool id: the memfds it registered
		// and the POSIX segments opened by name.
		internal segments    map<int, int>
		// The server handed over its ring-buffer channel, which this client
		// does not take up: the next block on channel 0 is the ring itself.
		internal ringPending bool          = false
		// Blocks of this side's pool the server has let go of since the pool
		// last looked.
		released             int[]

		def new(fd int) {
			self.fd = fd
		}

		// Closes the socket and unmaps the server's pools. Safe to call twice.
		def close() {
			for let (_, handle) in segments {
				__mem_unmap(handle) onerror recover none
			}
			segments = map<int, int>{}
			return when fd < 0
			__net_close(fd) onerror recover none
			fd = -1
		}

		// Sends a command and returns the reader over its reply, keeping what
		// else arrives meanwhile: requests for playback and recorded audio.
		//
		// Fails when the connection breaks or the server refuses the command.
		def command(code int, body PulseTags, credentials bool = false) !PulseReader {
			nextTag += 1
			let tag = nextTag
			let head = new PulseTags()
			head.u32(code).u32(tag)
			for let (_, b) in body.bytes {
				head.bytes.push(b)
			}
			try send(PULSE_CONTROL, head.bytes, credentials)
			for {
				let reply = try receive()
				continue when reply is none
				let reader PulseReader = reply
				let kind = try reader.u32()
				let answered = try reader.u32()
				continue when answered != tag
				return reader when kind == PULSE_REPLY
				let refused = kind == PULSE_ERROR ?? (try reader.u32(), -1)
				fail "devices: the sound server refused the request (error {refused})"
			}
		}

		// Reads one packet and returns a reply for the caller. What the server
		// sends unasked is taken note of here and returns none: a request for
		// playback goes to `requested`, audio to `received`, the stream's end to
		// `killed`, its move to `movedTo`, a subscribed change to `events`.
		//
		// Fails when the connection breaks or the server says nothing in time.
		def receive(timeout duration = PULSE_TIMEOUT) !?PulseReader {
			let (head, passed) = try readHead(timeout)
			let packet = handle(head, passed) onerror (err error) {
				closeDescriptor(passed)
				fail err
			}
			closeDescriptor(passed)
			return packet
		}

		// Reads the rest of the packet whose header is `head`, `passed` the
		// descriptor that came with it (-1 for none), which the caller closes.
		//
		// Fails when the connection breaks or the packet is not one the
		// protocol allows.
		internal def handle(head byte[], passed int) !?PulseReader {
			let length = int(uint32(0).fromBytes(head[0:4], Endian.Big))
			let channel = uint32(0).fromBytes(head[4:8], Endian.Big)
			let flags = int(uint32(0).fromBytes(head[16:20], Endian.Big))
			if flags := FLAG_SHMRELEASE || FLAG_SHMREVOKE {
				// A block of ours let go of, or one of the server's taken back;
				// what it imported here was copied out at once.
				released.push(int(uint32(0).fromBytes(head[8:12], Endian.Big))) when flags == FLAG_SHMRELEASE
				return none
			}
			let payload = try readExactly(length, PULSE_TIMEOUT)
			if channel != uint32(PULSE_CONTROL) {
				if (flags & FLAG_SHMDATA) != 0 {
					try importBlock(int(channel), payload, (flags & FLAG_SHMDATA_MEMFD_BLOCK) != 0)
					return none
				}
				for let (_, b) in payload {
					received.push(b)
				}
				return none
			}
			let reader = new PulseReader(payload)
			let kind = try reader.u32()
			let tag = try reader.u32()
			if kind == PULSE_REGISTER_MEMFD_SHMID {
				let id = try reader.u32()
				fail "devices: the sound server registered a pool without its memfd" when passed < 0
				// Mapped, the pool outlives its descriptor.
				segments[id] = try __mem_map(passed, 0, 0, 0)
				return none
			}
			if kind := PULSE_ENABLE_SRBCHANNEL || PULSE_DISABLE_SRBCHANNEL {
				ringPending = kind == PULSE_ENABLE_SRBCHANNEL
				return none
			}
			return new PulseReader(payload) unless tag == -1
			if kind == PULSE_REQUEST {
				try reader.skip()
				requested += try reader.u32()
			} else if kind := PULSE_PLAYBACK_STREAM_KILLED || PULSE_RECORD_STREAM_KILLED {
				killed = true
			} else if kind := PULSE_PLAYBACK_STREAM_MOVED || PULSE_RECORD_STREAM_MOVED {
				// stream, device index, then its name
				try reader.skip(2)
				movedTo = try reader.text()
			} else if kind == PULSE_SUBSCRIBE_EVENT {
				let event = try reader.u32()
				events.push((event, try reader.u32()))
			}
			return none
		}

		// Copies the audio of a block of the server's pool into `received`
		// and lets the server have the block back. The ring buffer of a
		// channel this client did not take up is only let go of.
		//
		// Fails when the reference is cut short, names a pool the server never
		// registered, or leaves it.
		internal def importBlock(channel int, info byte[], memfdBlock bool) !none {
			expects {
				assert info.len() == SHM_INFO_SIZE onerror fail "devices: the sound server sent a block reference of {info.len()} bytes"
			}
			let block = int(uint32(0).fromBytes(info[0:4], Endian.Big))
			let pool = int(uint32(0).fromBytes(info[4:8], Endian.Big))
			let offset = int(uint32(0).fromBytes(info[8:12], Endian.Big))
			let length = int(uint32(0).fromBytes(info[12:16], Endian.Big))
			if ringPending && channel == 0 {
				ringPending = false
				return release(block)
			}
			let handle = try segment(pool, memfdBlock)
			let data = try __mem_map_read(handle, offset, length)
			for let (_, b) in data {
				received.push(b)
			}
			return release(block)
		}

		// The mapping of one of the server's pools: a memfd it registered, or a
		// POSIX segment (`/dev/shm/pulse-shm-<id>`), opened the first time.
		//
		// Fails when a memfd pool was never registered or the segment cannot
		// be opened.
		internal def segment(pool int, memfdBlock bool) !int {
			let known = segments.get(pool)
			if !(known is none) {
				let handle int = known
				return handle
			}
			fail "devices: the sound server referenced memfd pool {pool} without registering it" when memfdBlock
			let named = try __fs_open("/dev/shm/pulse-shm-{pool}", "r")
			let handle = __mem_map(named, 0, 0, 0) onerror (err error) {
				__fs_close(named) onerror recover none
				fail err
			}
			__fs_close(named) onerror recover none
			segments[pool] = handle
			return handle
		}

		// Tells the server this side is done with one of its blocks.
		//
		// Fails when the connection breaks.
		def release(block int) !none {
			let head = new PulseTags()
			head.raw(0)
			head.raw(PULSE_CONTROL)
			head.raw(block)
			head.raw(0)
			head.raw(FLAG_SHMRELEASE)
			return writeAll(head.bytes)
		}

		// Sends a block of this side's pool on the stream channel: where it
		// lies instead of the audio in it.
		//
		// Fails when the connection breaks.
		def sendBlock(channel int, block int, offset int, length int) !none {
			let packet = new PulseTags()
			packet.raw(SHM_INFO_SIZE)
			packet.raw(channel)
			packet.raw(0)
			packet.raw(0)
			packet.raw(FLAG_SHMDATA | FLAG_SHMDATA_MEMFD_BLOCK)
			packet.raw(block)
			packet.raw(POOL_ID)
			packet.raw(offset)
			packet.raw(length)
			return writeAll(packet.bytes)
		}

		// Sends a command with a descriptor attached, which the server takes
		// a copy of; the caller keeps its own.
		//
		// Fails when the connection breaks.
		def sendWithDescriptor(code int, body PulseTags, descriptor int) !none {
			let packet = new PulseTags()
			let head = new PulseTags()
			head.u32(code).u32(PULSE_NO_INDEX)
			for let (_, b) in body.bytes {
				head.bytes.push(b)
			}
			packet.raw(head.bytes.len())
			packet.raw(PULSE_CONTROL)
			packet.raw(0)
			packet.raw(0)
			packet.raw(0)
			for let (_, b) in head.bytes {
				packet.bytes.push(b)
			}
			try __net_write_fd(fd, packet.bytes, descriptor, PULSE_TIMEOUT)
			return none
		}

		// Takes note of what the server sent unasked and nobody has read yet,
		// without waiting for more: a stream reads only as far as it needs, and
		// a move or its end would otherwise wait in the socket.
		//
		// Fails when the connection breaks.
		def catchUp() !none {
			for try __fs_wait(fd, 0s, false) {
				let _ = try receive()
			}
			return none
		}

		// Sends one packet on the channel.
		//
		// Fails when the connection breaks.
		// With `credentials`, the packet carries who this process is, which a
		// server reads to allow shared memory.
		def send(channel int, payload byte[], credentials bool = false) !none {
			let packet = new PulseTags()
			packet.raw(payload.len())
			packet.raw(channel)
			packet.raw(0)
			packet.raw(0)
			packet.raw(0)
			for let (_, b) in payload {
				packet.bytes.push(b)
			}
			if credentials {
				try __net_write_credentials(fd, packet.bytes, PULSE_TIMEOUT)
				return none
			}
			return writeAll(packet.bytes)
		}

		def writeAll(data byte[]) !none {
			let sent = 0
			for sent < data.len() {
				sent += try __net_write(fd, data[sent:], PULSE_TIMEOUT)
			}
			return none
		}

		// Reads a packet's header and the descriptor that came with it, -1 for
		// none: a descriptor travels with the first bytes of its packet.
		//
		// Fails when the connection breaks or the server says nothing in time.
		def readHead(timeout duration) !(byte[], int) {
			let out byte[]
			let chunk byte[]
			let passed = -1
			for out.len() < PULSE_HEADER_SIZE {
				chunk.len(PULSE_HEADER_SIZE - out.len())
				let (n, descriptor) = __net_read_fd(fd, chunk, out.len() == 0 ?? (timeout, PULSE_TIMEOUT)) onerror (err error) {
					closeDescriptor(passed)
					fail err
				}
				if descriptor >= 0 {
					closeDescriptor(passed)
					passed = descriptor
				}
				if n <= 0 {
					closeDescriptor(passed)
					fail "devices: the sound server closed the connection"
				}
				for let i = 0; i < n; i++ {
					out.push(chunk[i])
				}
			}
			return (out, passed)
		}

		internal def readExactly(count int, timeout duration) !byte[] {
			let out byte[]
			let chunk byte[]
			for out.len() < count {
				chunk.len(count - out.len())
				// Once a packet has begun, the rest of it follows at once.
				let n = try __net_read(fd, chunk, out.len() == 0 ?? (timeout, PULSE_TIMEOUT))
				fail "devices: the sound server closed the connection" when n <= 0
				for let i = 0; i < n; i++ {
					out.push(chunk[i])
				}
			}
			return out
		}
	}

	// A connection to the desktop's sound server, introduced under the name, or
	// none when there is no server to reach.
	def pulseConnection(name string) ?PulseConnection {
		let connection = pulseConnect(name) onerror (err error) {
			return none
		}
		return connection
	}

	// Connects to the desktop's sound server and introduces the program.
	//
	// Fails when there is no server, or it refuses the program or speaks an
	// older protocol.
	def pulseConnect(name string) !PulseConnection {
		let path = pulseSocketPath()
		fail "devices: no sound server socket is known on this system" when path == ""
		let fd = try __net_socket(1, 1)
		__net_connect(fd, path, PULSE_TIMEOUT) onerror (err error) {
			__net_close(fd) onerror recover none
			fail "devices: no sound server at {path}: {err.message}"
		}
		let connection = new PulseConnection(fd)
		pulseHandshake(connection, name) onerror (err error) {
			connection.close()
			fail err
		}
		return connection
	}

	// Authenticates with the cookie and names the client.
	//
	// Fails when the server refuses either or speaks an older protocol.
	def pulseHandshake(connection PulseConnection, name string) !none {
		let auth = new PulseTags()
		auth.u32(PULSE_VERSION | pulseSharing()).arbitrary(pulseCookie())
		// The server shares memory only with a client it knows runs as its own
		// user, from credentials sent with this packet.
		let reply = try connection.command(PULSE_AUTH, auth, true)
		let answer = try reply.u32()
		let version = answer & 0xFFFF
		connection.shm = (answer & PROTOCOL_SHM) != 0
		connection.memfd = (answer & PROTOCOL_MEMFD) != 0
		fail "devices: the sound server speaks protocol {version}, older than {PULSE_VERSION}" when version < PULSE_VERSION
		let client = new PulseTags()
		let properties map<string, string>
		properties["application.name"] = name
		client.properties(properties)
		try connection.command(PULSE_SET_CLIENT_NAME, client)
		return none
	}

	// Closes a descriptor that came with a packet, if one did. Nothing more
	// can be done about one that does not close.
	def closeDescriptor(fd int) {
		return when fd < 0
		__fs_close(fd) onerror recover none
	}

	// What this side can share: shared memory and memfd pools where the
	// system has memfds, nothing elsewhere.
	@os("linux")
	def pulseSharing() int {
		return PROTOCOL_SHM | PROTOCOL_MEMFD
	}

	// No memfds here: audio goes down the socket.
	@os("darwin", "windows", "android", "ios", "wasm")
	def pulseSharing() int {
		return 0
	}

	// Where the server listens: `PULSE_SERVER` when it names a Unix socket, else
	// `pulse/native` in the user's runtime directory.
	@os("linux")
	def pulseSocketPath() string {
		let server = __env_get("PULSE_SERVER")
		if !(server is none) {
			let named string = server
			return named[5:] when named.startsWith("unix:")
		}
		let runtime = __env_get("XDG_RUNTIME_DIR")
		return "" when runtime is none
		let dir string = runtime
		return dir + "/pulse/native"
	}

	// No PulseAudio server here.
	@os("darwin", "windows", "android", "ios", "wasm")
	def pulseSocketPath() string {
		return ""
	}

	// The cookie the server authenticates with: `PULSE_COOKIE`, else the user's
	// `~/.config/pulse/cookie`, else zeros, which PipeWire accepts.
	def pulseCookie() byte[] {
		let path = ""
		let named = __env_get("PULSE_COOKIE")
		let home = __env_get("HOME")
		if !(named is none) {
			path = named
		} else if !(home is none) {
			let dir string = home
			path = dir + "/.config/pulse/cookie"
		}
		let cookie byte[]
		cookie.len(PULSE_COOKIE_SIZE)
		return cookie when path == ""
		let fd = __fs_open(path, "r") onerror recover -1
		return cookie when fd < 0
		__fs_read(fd, cookie) onerror recover 0
		__fs_close(fd) onerror recover none
		return cookie
	}

	// --- devices ----------------------------------------------------------------

	// A sink or source as the server describes it.
	struct PulseEndpoint {
		device  Device
		// The server's index of it, which subscription events name.
		index   int
		// The loudest channel's volume, 1.0 full.
		volume  float
		muted   bool
		// Whether it is a source that only mirrors a sink (`… .monitor`).
		monitor bool
	}

	// The names of the server's default sink and source.
	//
	// Fails when the server does not answer.
	def pulseDefaults(connection PulseConnection) !(string, string) {
		let info = try connection.command(PULSE_GET_SERVER_INFO, new PulseTags())
		// package name and version, user, host, sample spec
		try info.skip(5)
		let sink = try info.text()
		return (sink, try info.text())
	}

	// The server's outputs (Speaker) or inputs (Microphone), the default
	// marked, monitor sources included.
	//
	// Fails when the server does not answer.
	def pulseEndpoints(connection PulseConnection, kind DeviceKind) !PulseEndpoint[] {
		let (sink, source) = try pulseDefaults(connection)
		let speakers = kind == DeviceKind.Speaker
		let list = try connection.command(speakers ?? (PULSE_GET_SINK_INFO_LIST, PULSE_GET_SOURCE_INFO_LIST), new PulseTags())
		let out PulseEndpoint[]
		for list.more() {
			out.push(try pulseRecord(list, kind, speakers ?? (sink, source)))
		}
		return out
	}

	// The sink or source with the name.
	//
	// Fails when the server has none by that name or does not answer.
	def pulseEndpoint(connection PulseConnection, kind DeviceKind, name string) !PulseEndpoint {
		let (sink, source) = try pulseDefaults(connection)
		let speakers = kind == DeviceKind.Speaker
		let body = new PulseTags()
		body.u32(PULSE_NO_INDEX).text(name)
		let reply = try connection.command(speakers ?? (PULSE_GET_SINK_INFO, PULSE_GET_SOURCE_INFO), body)
		return pulseRecord(reply, kind, speakers ?? (sink, source))
	}

	// The sink or source with the index, as subscription events name it.
	//
	// Fails when the server has none with that index or does not answer.
	def pulseEndpointAt(connection PulseConnection, kind DeviceKind, index int) !PulseEndpoint {
		let (sink, source) = try pulseDefaults(connection)
		let speakers = kind == DeviceKind.Speaker
		let body = new PulseTags()
		body.u32(index).text("")
		let reply = try connection.command(speakers ?? (PULSE_GET_SINK_INFO, PULSE_GET_SOURCE_INFO), body)
		return pulseRecord(reply, kind, speakers ?? (sink, source))
	}

	// Reads one sink or source record (the two share their layout), marked
	// default when its name is `defaultName`.
	//
	// Fails when the record is cut short or holds values of other types.
	def pulseRecord(list PulseReader, kind DeviceKind, defaultName string) !PulseEndpoint {
		let index = try list.u32()
		let name = try list.text()
		let description = try list.text()
		// sample spec, channel map, owner module
		try list.skip(3)
		let volume = try list.volume()
		let muted = try list.flag()
		let monitorOf = try list.u32()
		// monitor name, latency, driver, flags
		try list.skip(4)
		let properties = try list.properties()
		// configured latency, base volume, state, volume steps, card
		try list.skip(5)
		let ports = try list.u32()
		// each port: name, description, priority, availability
		try list.skip(ports * 4)
		// active port
		try list.skip()
		let formats = try list.u8()
		try list.skip(formats)
		return PulseEndpoint{
			device:  pulseDevice(kind, name, description, properties, name == defaultName),
			index:   index,
			volume:  volume,
			muted:   muted,
			monitor: kind == DeviceKind.Microphone && monitorOf != -1,
		}
	}

	// The server's outputs (Speaker) or inputs (Microphone), the default marked.
	// Inputs that only mirror an output (`… .monitor`) are left out.
	//
	// Fails when the server does not answer.
	def pulseDevices(connection PulseConnection, kind DeviceKind) !Device[] {
		let out Device[]
		for let (_, endpoint) in try pulseEndpoints(connection, kind) {
			out.push(endpoint.device) unless endpoint.monitor
		}
		return out
	}

	// Sets the volume of the sink or source with the name, keeping the
	// balance between its channels.
	//
	// Fails when the server has no such device or refuses.
	def pulseSetVolume(connection PulseConnection, kind DeviceKind, name string, level float) !none {
		let body = new PulseTags()
		body.u32(PULSE_NO_INDEX).text(name).volume(level)
		try connection.command(kind == DeviceKind.Speaker ?? (PULSE_SET_SINK_VOLUME, PULSE_SET_SOURCE_VOLUME), body)
		return none
	}

	// Mutes or unmutes the sink or source with the name.
	//
	// Fails when the server has no such device or refuses.
	def pulseSetMute(connection PulseConnection, kind DeviceKind, name string, on bool) !none {
		let body = new PulseTags()
		body.u32(PULSE_NO_INDEX).text(name).flag(on)
		try connection.command(kind == DeviceKind.Speaker ?? (PULSE_SET_SINK_MUTE, PULSE_SET_SOURCE_MUTE), body)
		return none
	}

	// The server's volume value for a level, 1.0 being full volume.
	def pulseVolume(level float) int {
		let value = level * float(PULSE_VOLUME_NORM)
		return 0 when value <= 0.0
		return PULSE_VOLUME_MAX when value >= float(PULSE_VOLUME_MAX)
		return int(value + 0.5)
	}

	// The device a sink or source describes, with its hardware details where
	// the server knows them.
	def pulseDevice(kind DeviceKind, name string, description string, properties map<string, string>, isDefault bool) Device {
		let card = property(properties, "alsa.card")
		let pcm = property(properties, "alsa.device")
		let node = (card == "" || pcm == "") ?? ("", "/dev/snd/pcmC{card}D{pcm}{kind == DeviceKind.Speaker ?? ("p", "c")}")
		return Device{
			id:        "pulse:" + name,
			kind:      kind,
			name:      description == "" ?? (name, description),
			vendorId:  hexNumber(property(properties, "device.vendor.id")),
			productId: hexNumber(property(properties, "device.product.id")),
			vendor:    property(properties, "device.vendor.name"),
			product:   property(properties, "device.product.name"),
			serial:    property(properties, "device.serial"),
			node:      node,
			bus:       property(properties, "device.bus"),
			isDefault: isDefault,
		}
	}

	// The property's value, "" when the server did not give it.
	def property(properties map<string, string>, key string) string {
		let value = properties.get(key)
		return "" when value is none
		let text string = value
		return text
	}

	// The number a hexadecimal id spells ("0x046d", "046d"); 0 when it is empty.
	def hexNumber(text string) int {
		let digits = text.startsWith("0x") ?? (text[2:], text)
		return 0 when digits == ""
		return digits.toInt<int>(16)
	}

	// --- streams ----------------------------------------------------------------

	// This side's shared memory: a memfd the server maps once, in slots the
	// playback stream encodes into. A slot is written again only once the
	// server has let go of the block in it, and every block gets a new id:
	// the server keeps what it imported by id.
	type PulsePool {
		internal handle    int
		internal pages     byte[]
		// The block in each slot, 0 while the slot is free.
		internal blocks    int[]
		internal nextBlock int    = 1

		def new(handle int, pages byte[]) {
			self.handle = handle
			self.pages = pages
			blocks.len(POOL_SLOTS)
		}

		// A free slot after taking note of the blocks the server released,
		// -1 while every one is in use.
		def free(released int[]) int {
			for let (_, block) in released {
				let slot = blocks.indexOf(block)
				blocks[slot] = 0 when slot >= 0
			}
			released.len(0)
			return blocks.indexOf(0)
		}

		// Gives the slot a new block and returns its id.
		def fill(slot int) int {
			let block = nextBlock
			nextBlock += 1
			blocks[slot] = block
			return block
		}

		// Unmaps the pool; the server keeps its own mapping while it needs it.
		def close() {
			__mem_unmap(handle) onerror recover none
		}
	}

	// A pool registered with the server, or none when the connection shares
	// no memfd pools. Setting one up only spares copying the audio: when the
	// system refuses the memfd or its mapping, audio goes down the socket, as
	// the protocol allows any time.
	def pulsePool(connection PulseConnection) ?PulsePool {
		return none unless connection.shm && connection.memfd
		let size = POOL_SLOTS * POOL_SLOT_BYTES
		let fd = __fs_memory_file("adm-pulse") onerror (err error) {
			return none
		}
		let pool = sharedPool(connection, fd, size) onerror (err error) {
			__fs_close(fd) onerror recover none
			return none
		}
		__fs_close(fd) onerror recover none
		return pool
	}

	// Sizes and maps the memfd and registers it with the server; the caller
	// closes the descriptor.
	//
	// Fails when the system or the connection refuses.
	def sharedPool(connection PulseConnection, fd int, size int) !PulsePool {
		try __fs_ftruncate(fd, int64(size))
		let handle = try __mem_map(fd, 0, size, 1)
		let pages = __mem_map_view(handle, 0, size) onerror (err error) {
			__mem_unmap(handle) onerror recover none
			fail err
		}
		let body = new PulseTags()
		body.u32(POOL_ID)
		connection.sendWithDescriptor(PULSE_REGISTER_MEMFD_SHMID, body, fd) onerror (err error) {
			__mem_unmap(handle) onerror recover none
			fail err
		}
		return new PulsePool(handle, pages)
	}

	// Sound playing through the server, float32 at the speaker's own layout.
	type PulsePlayback {
		internal connection PulseConnection
		internal channel    int
		internal frameBytes int
		// The server's index of the stream (its sink input).
		internal index      int
		// The sink it plays to now.
		sink                string
		// Shared memory the audio goes through, none when it goes down the
		// socket.
		internal pool       ?PulsePool

		def new(connection PulseConnection, channel int, frameBytes int, index int, sink string) {
			self.connection = connection
			self.channel = channel
			self.frameBytes = frameBytes
			self.index = index
			self.sink = sink
			pool = pulsePool(connection)
		}

		// Sends the frames as the server asks for them: through shared memory
		// when the connection has a pool, else down the socket.
		//
		// Fails when the connection breaks or the server ended the stream.
		def write(samples float32[]) !none {
			let current = pool
			if !(current is none) {
				let shared PulsePool = current
				return writeShared(shared, samples)
			}
			let data = encodeSamples(samples, FORMAT_FLOAT_LE)
			let at = 0
			for at < data.len() {
				for connection.requested < frameBytes {
					try alive()
					let _ = try connection.receive()
				}
				let left = data.len() - at
				let size = connection.requested < left ?? (connection.requested, left)
				size = size < PULSE_MAX_PACKET ?? (size, PULSE_MAX_PACKET)
				size -= size % frameBytes
				try connection.send(channel, data[at:at + size])
				connection.requested -= size
				at += size
			}
			try connection.catchUp()
			return alive()
		}

		// Encodes the frames into free slots of the pool and sends where they
		// lie, as the server asks for them.
		//
		// Fails when the connection breaks or the server ended the stream.
		internal def writeShared(shared PulsePool, samples float32[]) !none {
			let at = 0
			for at < samples.len() {
				for connection.requested < frameBytes {
					try alive()
					let _ = try connection.receive()
				}
				let left = (samples.len() - at) * 4
				let size = connection.requested < left ?? (connection.requested, left)
				size = size < POOL_SLOT_BYTES ?? (size, POOL_SLOT_BYTES)
				size -= size % frameBytes
				let slot = shared.free(connection.released)
				for slot < 0 {
					// Every block is still the server's; it lets go as it plays.
					try alive()
					let _ = try connection.receive()
					slot = shared.free(connection.released)
				}
				let offset = slot * POOL_SLOT_BYTES
				encodeInto(samples[at:at + size / 4], FORMAT_FLOAT_LE, 1.0, shared.pages, offset)
				try connection.sendBlock(channel, shared.fill(slot), offset, size)
				connection.requested -= size
				at += size / 4
			}
			try connection.catchUp()
			return alive()
		}

		// Returns once the server has played everything sent.
		//
		// Fails when the connection breaks or the server ended the stream.
		def drain() !none {
			try alive()
			let body = new PulseTags()
			body.u32(channel)
			try connection.command(PULSE_DRAIN_PLAYBACK_STREAM, body)
			return none
		}

		// The stream's own volume, 1.0 full.
		//
		// Fails when the connection breaks.
		def volume() !float {
			let body = new PulseTags()
			body.u32(index)
			let info = try connection.command(PULSE_GET_SINK_INPUT_INFO, body)
			// index, name, owner module, client, sink, sample spec, channel map
			try info.skip(7)
			return info.volume()
		}

		// Sets the stream's own volume.
		//
		// Fails when the connection breaks or the server refuses.
		def volume(level float) !none {
			let body = new PulseTags()
			body.u32(index).volume(level)
			try connection.command(PULSE_SET_SINK_INPUT_VOLUME, body)
			return none
		}

		// Whether the stream itself is muted.
		//
		// Fails when the connection breaks.
		def muted() !bool {
			let body = new PulseTags()
			body.u32(index)
			let info = try connection.command(PULSE_GET_SINK_INPUT_INFO, body)
			// index, name, owner module, client, sink, sample spec, channel map,
			// volume, latency, sink latency, resampler, driver
			try info.skip(12)
			return info.flag()
		}

		// Mutes or unmutes the stream itself.
		//
		// Fails when the connection breaks or the server refuses.
		def mute(on bool) !none {
			let body = new PulseTags()
			body.u32(index).flag(on)
			try connection.command(PULSE_SET_SINK_INPUT_MUTE, body)
			return none
		}

		// The speaker the server moved the stream to since the last call, none
		// when it stayed. It moves one opened on the default when the desktop
		// picks another, and any one whose device goes away.
		def moved() ?Device {
			return none when connection.movedTo == ""
			sink = connection.movedTo
			return pulseMoved(connection, DeviceKind.Speaker)
		}

		// Ends the stream at once and hangs up.
		def close() {
			let body = new PulseTags()
			body.u32(channel)
			connection.command(PULSE_DELETE_PLAYBACK_STREAM, body) onerror recover new PulseReader([])
			connection.close()
			let current = pool
			if !(current is none) {
				let shared PulsePool = current
				shared.close()
				pool = none
			}
		}

		// Fails when the server ended the stream.
		internal def alive() !none {
			fail "devices: the sound server ended the stream to {sink}" when connection.killed
			return none
		}
	}

	// Opens a playback stream on the sink, the server's default when the name is
	// empty, taking float32 at the rate and channel count. A stream opened on
	// the default follows it when the desktop picks another.
	//
	// Fails when the server refuses the stream.
	def pulsePlayback(connection PulseConnection, sink string, rate int, channels int) !PulsePlayback {
		let frameBytes = 4 * channels
		let body = new PulseTags()
		body.sampleSpec(rate, channels).channelMap(channels)
		body.u32(PULSE_NO_INDEX).text(sink)
		// max length, not corked, target length, prebuffer, minimum request, sync group
		body.u32(PULSE_NO_INDEX).flag(false).u32(rate * PULSE_TARGET_MS / 1000 * frameBytes)
		body.u32(PULSE_NO_INDEX).u32(PULSE_NO_INDEX).u32(0)
		body.fullVolume(channels)
		// no remap, no remix, fix format, fix rate, fix channels, no move, variable rate
		for let n = 0; n < 7; n++ {
			body.flag(false)
		}
		// muted, adjust latency
		body.flag(false).flag(false)
		body.properties(streamProperties("playback"))
		// volume set, early requests, muted set, keep auto-suspend, fail on
		// suspend, relative volume, passthrough; no formats
		for let n = 0; n < 7; n++ {
			body.flag(false)
		}
		body.u8(0)
		let reply = try connection.command(PULSE_CREATE_PLAYBACK_STREAM, body)
		let channel = try reply.u32()
		let index = try reply.u32()
		connection.requested += try reply.u32()
		// buffer: max length, target length, prebuffer, minimum request; sample
		// spec, channel map, sink index
		try reply.skip(7)
		let playing = try reply.text()
		return new PulsePlayback(connection, channel, frameBytes, index, playing)
	}

	// Sound recording through the server, float32 at the microphone's own layout.
	type PulseCapture {
		internal connection PulseConnection
		internal channel    int
		internal frameBytes int
		// The server's index of the stream (its source output).
		internal index      int
		// The source it records from now.
		source              string

		def new(connection PulseConnection, channel int, frameBytes int, index int, source string) {
			self.connection = connection
			self.channel = channel
			self.frameBytes = frameBytes
			self.index = index
			self.source = source
		}

		// The next whole frames the server delivered, waiting for some.
		//
		// Fails when the connection breaks, the server ended the stream, or
		// nothing arrives in time.
		def read() !float32[] {
			for connection.received.len() < frameBytes {
				fail "devices: the sound server ended the stream from {source}" when connection.killed
				let _ = try connection.receive()
			}
			try connection.catchUp()
			let whole = connection.received.len() - connection.received.len() % frameBytes
			let samples = decodeSamples(connection.received[0:whole], FORMAT_FLOAT_LE)
			connection.received = connection.received[whole:]
			return samples
		}

		// The stream's own volume, 1.0 full.
		//
		// Fails when the connection breaks.
		def volume() !float {
			let body = new PulseTags()
			body.u32(index)
			let info = try connection.command(PULSE_GET_SOURCE_OUTPUT_INFO, body)
			// index, name, owner module, client, source, sample spec, channel
			// map, latency, source latency, resampler, driver, properties, corked
			try info.skip(13)
			return info.volume()
		}

		// Sets the stream's own volume.
		//
		// Fails when the connection breaks or the server refuses.
		def volume(level float) !none {
			let body = new PulseTags()
			body.u32(index).volume(level)
			try connection.command(PULSE_SET_SOURCE_OUTPUT_VOLUME, body)
			return none
		}

		// Whether the stream itself is muted.
		//
		// Fails when the connection breaks.
		def muted() !bool {
			let body = new PulseTags()
			body.u32(index)
			let info = try connection.command(PULSE_GET_SOURCE_OUTPUT_INFO, body)
			// as for the volume, then the volume
			try info.skip(14)
			return info.flag()
		}

		// Mutes or unmutes the stream itself.
		//
		// Fails when the connection breaks or the server refuses.
		def mute(on bool) !none {
			let body = new PulseTags()
			body.u32(index).flag(on)
			try connection.command(PULSE_SET_SOURCE_OUTPUT_MUTE, body)
			return none
		}

		// The microphone the server moved the stream to since the last call,
		// none when it stayed.
		def moved() ?Device {
			return none when connection.movedTo == ""
			source = connection.movedTo
			return pulseMoved(connection, DeviceKind.Microphone)
		}

		// Ends the stream and hangs up.
		def close() {
			let body = new PulseTags()
			body.u32(channel)
			connection.command(PULSE_DELETE_RECORD_STREAM, body) onerror recover new PulseReader([])
			connection.close()
		}
	}

	// Opens a record stream on the source, the server's default when the name is
	// empty, yielding float32 at the rate and channel count. A stream opened on
	// the default follows it when the desktop picks another.
	//
	// Fails when the server refuses the stream.
	def pulseCapture(connection PulseConnection, source string, rate int, channels int) !PulseCapture {
		let frameBytes = 4 * channels
		let body = new PulseTags()
		body.sampleSpec(rate, channels).channelMap(channels)
		body.u32(PULSE_NO_INDEX).text(source)
		// max length, not corked, fragment size
		body.u32(PULSE_NO_INDEX).flag(false).u32(rate * PULSE_FRAGMENT_MS / 1000 * frameBytes)
		// no remap, no remix, fix format, fix rate, fix channels, no move,
		// variable rate, peak detect, adjust latency
		for let n = 0; n < 9; n++ {
			body.flag(false)
		}
		body.properties(streamProperties("recording"))
		// not tied to a sink input; early requests, keep auto-suspend, fail on suspend
		body.u32(PULSE_NO_INDEX).flag(false).flag(false).flag(false)
		// no formats; volume, muted, volume set, muted set, relative volume, passthrough
		body.u8(0).fullVolume(channels)
		for let n = 0; n < 5; n++ {
			body.flag(false)
		}
		let reply = try connection.command(PULSE_CREATE_RECORD_STREAM, body)
		let channel = try reply.u32()
		let index = try reply.u32()
		// buffer: max length, fragment size; sample spec, channel map, source index
		try reply.skip(5)
		let recording = try reply.text()
		return new PulseCapture(connection, channel, frameBytes, index, recording)
	}

	// The device a stream on the connection moved to since it last looked,
	// none when it stayed. A device the server cannot describe any more (gone
	// again at once, or the connection broke) is known by its name alone.
	def pulseMoved(connection PulseConnection, kind DeviceKind) ?Device {
		return none when connection.movedTo == ""
		let name = connection.movedTo
		connection.movedTo = ""
		let endpoint = pulseEndpoint(connection, kind, name) onerror (err error) {
			return Device{id: "pulse:" + name, kind: kind, name: name}
		}
		return endpoint.device
	}

	// What a stream tells the server about itself.
	def streamProperties(media string) map<string, string> {
		let properties map<string, string>
		properties["media.name"] = media
		return properties
	}
}
