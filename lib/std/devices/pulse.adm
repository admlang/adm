partial module std.devices {
	use (
		std.bytes::(Endian)
		std.services::(Device, DeviceKind)
	)

	// PulseAudio's native protocol, spoken to the desktop's sound server over its
	// Unix socket. PipeWire serves the same socket, so this reaches either.
	//
	// The server is what knows which output and input the desktop uses, owns
	// Bluetooth and virtual devices, and shares a device between programs; a
	// program playing through it never finds a device busy. The sound goes to
	// it as float32 at the program's own rate and channel count, and it converts.
	//
	// A packet is a 20-byte header (length, channel, two offset words, flags,
	// big-endian) and a payload. Commands and their replies travel on the control
	// channel as tag structures: every value is one type byte then the value,
	// big-endian. Audio travels on the channel of its stream as raw samples.

	// The protocol version asked for. Newer servers answer with the smaller of
	// theirs and this, and the record layouts below are those of version 32.
	internal const PULSE_VERSION = 32
	internal const PULSE_HEADER_SIZE = 20
	// The channel of commands and replies, and the index meaning "none".
	internal const PULSE_CONTROL = 0xFFFFFFFF
	internal const PULSE_NO_INDEX = 0xFFFFFFFF
	internal const PULSE_COOKIE_SIZE = 256
	// The most audio sent in one packet.
	internal const PULSE_MAX_PACKET = 65536
	// How long the server may take to answer or ask for more before it counts as gone.
	internal const PULSE_TIMEOUT = 5s

	// Commands.
	internal const PULSE_ERROR = 0
	internal const PULSE_REPLY = 2
	internal const PULSE_CREATE_PLAYBACK_STREAM = 3
	internal const PULSE_DELETE_PLAYBACK_STREAM = 4
	internal const PULSE_CREATE_RECORD_STREAM = 5
	internal const PULSE_DELETE_RECORD_STREAM = 6
	internal const PULSE_AUTH = 8
	internal const PULSE_SET_CLIENT_NAME = 9
	internal const PULSE_DRAIN_PLAYBACK_STREAM = 12
	internal const PULSE_GET_SERVER_INFO = 20
	internal const PULSE_GET_SINK_INFO_LIST = 22
	internal const PULSE_GET_SOURCE_INFO_LIST = 24
	// The server asking a playback stream for more bytes.
	internal const PULSE_REQUEST = 61

	// Tag bytes.
	internal const TAG_U32 = 0x4C
	internal const TAG_U8 = 0x42
	internal const TAG_U64 = 0x52
	internal const TAG_S64 = 0x72
	internal const TAG_USEC = 0x55
	internal const TAG_STRING = 0x74
	internal const TAG_NULL = 0x4E
	internal const TAG_ARBITRARY = 0x78
	internal const TAG_TRUE = 0x31
	internal const TAG_FALSE = 0x30
	internal const TAG_SAMPLE_SPEC = 0x61
	internal const TAG_CHANNEL_MAP = 0x6D
	internal const TAG_CVOLUME = 0x76
	internal const TAG_VOLUME = 0x56
	internal const TAG_TIMEVAL = 0x54
	internal const TAG_PROPLIST = 0x50
	internal const TAG_FORMAT_INFO = 0x66

	// Samples as float32, little-endian; full volume.
	internal const PULSE_FLOAT32LE = 5
	internal const PULSE_VOLUME_NORM = 0x10000
	// How much a playback stream keeps queued, and how much a record stream
	// hands over at a time, in milliseconds.
	internal const PULSE_TARGET_MS = 100
	internal const PULSE_FRAGMENT_MS = 20

	// Channel positions: mono, then front left, front right, front center, rear
	// center, rear left, rear right, LFE, and side left and right.
	internal const POSITION_MONO = 0
	internal const POSITION_FRONT_LEFT = 1
	internal const POSITION_FRONT_RIGHT = 2
	internal const POSITION_FRONT_CENTER = 3
	internal const POSITION_REAR_CENTER = 4
	internal const POSITION_REAR_LEFT = 5
	internal const POSITION_REAR_RIGHT = 6
	internal const POSITION_LFE = 7
	internal const POSITION_SIDE_LEFT = 10
	internal const POSITION_SIDE_RIGHT = 11

	// --- tag structures ---------------------------------------------------------

	// A command being written, one tagged value after another.
	internal type PulseTags {
		bytes byte[]

		def u32(value int) PulseTags {
			bytes.push(byte(TAG_U32))
			raw(value)
			return self
		}

		def u8(value int) PulseTags {
			bytes.push(byte(TAG_U8), byte(value & 0xFF))
			return self
		}

		def flag(value bool) PulseTags {
			bytes.push(byte(value ?? (TAG_TRUE, TAG_FALSE)))
			return self
		}

		// A string, or the null string when it is empty.
		def text(value string) PulseTags {
			if value == "" {
				bytes.push(byte(TAG_NULL))
				return self
			}
			bytes.push(byte(TAG_STRING))
			for let (_, b) in value.bytes() {
				bytes.push(b)
			}
			bytes.push(byte(0))
			return self
		}

		def arbitrary(data byte[]) PulseTags {
			bytes.push(byte(TAG_ARBITRARY))
			raw(data.len())
			for let (_, b) in data {
				bytes.push(b)
			}
			return self
		}

		// Float32 samples at the rate and channel count.
		def sampleSpec(rate int, channels int) PulseTags {
			bytes.push(byte(TAG_SAMPLE_SPEC), byte(PULSE_FLOAT32LE), byte(channels))
			raw(rate)
			return self
		}

		// The usual speaker positions for the channel count.
		def channelMap(channels int) PulseTags {
			let positions = channelPositions(channels)
			bytes.push(byte(TAG_CHANNEL_MAP), byte(positions.len()))
			for let (_, position) in positions {
				bytes.push(byte(position))
			}
			return self
		}

		// Full volume on every channel.
		def fullVolume(channels int) PulseTags {
			bytes.push(byte(TAG_CVOLUME), byte(channels))
			for let c = 0; c < channels; c++ {
				raw(PULSE_VOLUME_NORM)
			}
			return self
		}

		// String properties, each stored with its terminating zero.
		def properties(values map<string, string>) PulseTags {
			bytes.push(byte(TAG_PROPLIST))
			for let (key, value) in values {
				let data = value.bytes()
				data.push(byte(0))
				text(key)
				u32(data.len())
				arbitrary(data)
			}
			bytes.push(byte(TAG_NULL))
			return self
		}

		// A 32-bit big-endian word with no tag.
		def raw(value int) {
			for let (_, b) in uint32(value).bytes(Endian.Big) {
				bytes.push(b)
			}
		}
	}

	// A reply being read, one tagged value after another.
	internal type PulseReader {
		data        byte[]
		internal at int    = 0

		def new(data byte[]) {
			self.data = data
		}

		// Whether values are left.
		def more() bool {
			return at < data.len()
		}

		// A 32-bit value; PULSE_NO_INDEX reads as -1, as every value past the
		// largest int would not fit.
		//
		// Fails when the next value is not one.
		def u32() !int {
			try expect(TAG_U32)
			return word()
		}

		// An 8-bit value.
		//
		// Fails when the next value is not one.
		def u8() !int {
			try expect(TAG_U8)
			try need(1)
			at += 1
			return int(data[at - 1])
		}

		// A string; the null string reads as "".
		//
		// Fails when the next value is not a string.
		def text() !string {
			try need(1)
			let kind = int(data[at])
			if kind == TAG_NULL {
				at += 1
				return ""
			}
			try expect(TAG_STRING)
			let start = at
			for at < data.len() && data[at] != byte(0) {
				at += 1
			}
			try need(1)
			at += 1
			return string(data[start:at - 1])
		}

		// A property list, each value up to its terminating zero.
		//
		// Fails when the next value is not one.
		def properties() !map<string, string> {
			try expect(TAG_PROPLIST)
			let out map<string, string>
			for {
				let key = try text()
				break when key == ""
				let length = try u32()
				try expect(TAG_ARBITRARY)
				let size = try word()
				try need(size)
				let value = data[at:at + size]
				at += size
				let end = length > 0 && length <= value.len() && value[length - 1] == byte(0) ?? (length - 1, value.len())
				out[key] = string(value[0:end])
			}
			return out
		}

		// Passes over the next count values, whatever they are.
		//
		// Fails when the reply ends first or holds a type this reader does not know.
		def skip(count int = 1) !none {
			for let n = 0; n < count; n++ {
				try need(1)
				let kind = int(data[at])
				at += 1
				if kind := TAG_U32 || TAG_VOLUME {
					at += 4
				} else if kind == TAG_U8 {
					at += 1
				} else if kind := TAG_U64 || TAG_S64 || TAG_USEC || TAG_TIMEVAL {
					at += 8
				} else if kind == TAG_STRING {
					for at < data.len() && data[at] != byte(0) {
						at += 1
					}
					at += 1
				} else if kind == TAG_ARBITRARY {
					let size = try word()
					at += size
				} else if kind == TAG_SAMPLE_SPEC {
					at += 6
				} else if kind := TAG_CHANNEL_MAP || TAG_CVOLUME {
					try need(1)
					let entries = int(data[at])
					at += 1 + (kind == TAG_CVOLUME ?? (4 * entries, entries))
				} else if kind == TAG_PROPLIST {
					at -= 1
					try properties()
				} else if kind == TAG_FORMAT_INFO {
					try skip(2)
				} else {
					fail "devices: the sound server sent a value of unknown type {kind}" unless kind := TAG_TRUE || TAG_FALSE || TAG_NULL
				}
				try need(0)
			}
			return none
		}

		// A big-endian 32-bit word with no tag.
		internal def word() !int {
			try need(4)
			at += 4
			let value = uint32(0).fromBytes(data[at - 4:at], Endian.Big)
			return -1 when value == uint32(PULSE_NO_INDEX)
			return int(value)
		}

		internal def expect(kind int) !none {
			try need(1)
			fail "devices: the sound server sent type {int(data[at])} where {kind} belongs" when int(data[at]) != kind
			at += 1
			return none
		}

		internal def need(count int) !none {
			expects {
				assert at + count <= data.len() onerror fail "devices: the sound server's reply ended early"
			}
			return none
		}
	}

	// The speaker positions of a stream with that many channels.
	internal def channelPositions(channels int) int[] {
		match channels {
			case 1:
				return [POSITION_MONO]
			case 2:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT]
			case 3:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER]
			case 4:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_REAR_LEFT, POSITION_REAR_RIGHT]
			case 5:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER, POSITION_REAR_LEFT, POSITION_REAR_RIGHT]
			case 6:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER, POSITION_LFE, POSITION_REAR_LEFT, POSITION_REAR_RIGHT]
			case 7:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER, POSITION_LFE, POSITION_REAR_CENTER, POSITION_SIDE_LEFT, POSITION_SIDE_RIGHT]
			default:
				return [POSITION_FRONT_LEFT, POSITION_FRONT_RIGHT, POSITION_FRONT_CENTER, POSITION_LFE, POSITION_REAR_LEFT, POSITION_REAR_RIGHT, POSITION_SIDE_LEFT, POSITION_SIDE_RIGHT]
		}
	}

	// --- the connection ---------------------------------------------------------

	// A connection to the sound server, carrying at most one stream.
	internal type PulseConnection {
		internal fd      int    = -1
		internal nextTag int    = 0
		// Bytes the server asked the playback stream for and has not had yet.
		requested        int    = 0
		// Audio the record stream delivered and nobody has taken yet.
		received         byte[]

		def new(fd int) {
			self.fd = fd
		}

		// Closes the socket. Safe to call twice.
		def close() {
			return when fd < 0
			__net_close(fd) onerror recover none
			fd = -1
		}

		// Sends a command and returns the reader over its reply, keeping what
		// else arrives meanwhile: requests for playback and recorded audio.
		//
		// Fails when the connection breaks or the server refuses the command.
		def command(code int, body PulseTags) !PulseReader {
			nextTag += 1
			let tag = nextTag
			let head = new PulseTags()
			head.u32(code).u32(tag)
			for let (_, b) in body.bytes {
				head.bytes.push(b)
			}
			try send(PULSE_CONTROL, head.bytes)
			for {
				let reply = try receive()
				continue when reply is none
				let reader PulseReader = reply
				let kind = try reader.u32()
				let answered = try reader.u32()
				continue when answered != tag
				return reader when kind == PULSE_REPLY
				let refused = kind == PULSE_ERROR ?? (try reader.u32(), -1)
				fail "devices: the sound server refused the request (error {refused})"
			}
		}

		// Reads one packet: a request goes to `requested`, audio to `received`,
		// and anything else on the control channel comes back for the caller.
		//
		// Fails when the connection breaks or the server says nothing in time.
		def receive() !?PulseReader {
			let head = try readExactly(PULSE_HEADER_SIZE)
			let length = int(uint32(0).fromBytes(head[0:4], Endian.Big))
			let channel = uint32(0).fromBytes(head[4:8], Endian.Big)
			let payload = try readExactly(length)
			if channel != uint32(PULSE_CONTROL) {
				for let (_, b) in payload {
					received.push(b)
				}
				return none
			}
			let reader = new PulseReader(payload)
			let kind = try reader.u32()
			if kind == PULSE_REQUEST {
				try reader.skip(2)
				requested += try reader.u32()
				return none
			}
			return new PulseReader(payload)
		}

		// Sends one packet on the channel.
		//
		// Fails when the connection breaks.
		def send(channel int, payload byte[]) !none {
			let packet = new PulseTags()
			packet.raw(payload.len())
			packet.raw(channel)
			packet.raw(0)
			packet.raw(0)
			packet.raw(0)
			for let (_, b) in payload {
				packet.bytes.push(b)
			}
			let sent = 0
			for sent < packet.bytes.len() {
				sent += try __net_write(fd, packet.bytes[sent:], PULSE_TIMEOUT)
			}
			return none
		}

		internal def readExactly(count int) !byte[] {
			let out byte[]
			let chunk byte[]
			for out.len() < count {
				chunk.len(count - out.len())
				let n = try __net_read(fd, chunk, PULSE_TIMEOUT)
				fail "devices: the sound server closed the connection" when n <= 0
				for let i = 0; i < n; i++ {
					out.push(chunk[i])
				}
			}
			return out
		}
	}

	// A connection to the desktop's sound server, introduced under the name, or
	// none when there is no server to reach.
	internal def pulseConnection(name string) ?PulseConnection {
		let connection = pulseConnect(name) onerror (err error) {
			return none
		}
		return connection
	}

	// Connects to the desktop's sound server and introduces the program.
	//
	// Fails when there is no server, or it refuses the program or speaks an
	// older protocol.
	internal def pulseConnect(name string) !PulseConnection {
		let path = pulseSocketPath()
		fail "devices: no sound server socket is known on this system" when path == ""
		let fd = try __net_socket(1, 1)
		__net_connect(fd, path, PULSE_TIMEOUT) onerror (err error) {
			__net_close(fd) onerror recover none
			fail "devices: no sound server at {path}: {err.message}"
		}
		let connection = new PulseConnection(fd)
		pulseHandshake(connection, name) onerror (err error) {
			connection.close()
			fail err
		}
		return connection
	}

	// Authenticates with the cookie and names the client.
	//
	// Fails when the server refuses either or speaks an older protocol.
	internal def pulseHandshake(connection PulseConnection, name string) !none {
		let auth = new PulseTags()
		auth.u32(PULSE_VERSION).arbitrary(pulseCookie())
		let reply = try connection.command(PULSE_AUTH, auth)
		let version = (try reply.u32()) & 0xFFFF
		fail "devices: the sound server speaks protocol {version}, older than {PULSE_VERSION}" when version < PULSE_VERSION
		let client = new PulseTags()
		let properties map<string, string>
		properties["application.name"] = name
		client.properties(properties)
		try connection.command(PULSE_SET_CLIENT_NAME, client)
		return none
	}

	// Where the server listens: `PULSE_SERVER` when it names a Unix socket, else
	// `pulse/native` in the user's runtime directory.
	@os("linux")
	internal def pulseSocketPath() string {
		let server = __env_get("PULSE_SERVER")
		if !(server is none) {
			let named string = server
			return named[5:] when named.startsWith("unix:")
		}
		let runtime = __env_get("XDG_RUNTIME_DIR")
		return "" when runtime is none
		let dir string = runtime
		return dir + "/pulse/native"
	}

	@os("darwin")
	internal def pulseSocketPath() string {
		return ""
	}

	@os("windows")
	internal def pulseSocketPath() string {
		return ""
	}

	// The cookie the server authenticates with: `PULSE_COOKIE`, else the user's
	// `~/.config/pulse/cookie`, else zeros, which PipeWire accepts.
	internal def pulseCookie() byte[] {
		let path = ""
		let named = __env_get("PULSE_COOKIE")
		let home = __env_get("HOME")
		if !(named is none) {
			path = named
		} else if !(home is none) {
			let dir string = home
			path = dir + "/.config/pulse/cookie"
		}
		let cookie byte[]
		cookie.len(PULSE_COOKIE_SIZE)
		return cookie when path == ""
		let fd = __fs_open(path, "r") onerror recover -1
		return cookie when fd < 0
		__fs_read(fd, cookie) onerror recover 0
		__fs_close(fd) onerror recover none
		return cookie
	}

	// --- devices ----------------------------------------------------------------

	// The server's outputs (Speaker) or inputs (Microphone), the default marked.
	// Inputs that only mirror an output (`… .monitor`) are left out.
	//
	// Fails when the server does not answer.
	internal def pulseDevices(connection PulseConnection, kind DeviceKind) !Device[] {
		let info = try connection.command(PULSE_GET_SERVER_INFO, new PulseTags())
		try info.skip(5)
		let defaultSink = try info.text()
		let defaultSource = try info.text()
		let speakers = kind == DeviceKind.Speaker
		let wanted = speakers ?? (defaultSink, defaultSource)
		let list = try connection.command(speakers ?? (PULSE_GET_SINK_INFO_LIST, PULSE_GET_SOURCE_INFO_LIST), new PulseTags())
		let out Device[]
		for list.more() {
			try list.skip()
			let name = try list.text()
			let description = try list.text()
			// sample spec, channel map, owner module, volume, mute
			try list.skip(5)
			let monitorOf = try list.u32()
			// monitor name, latency, driver, flags
			try list.skip(4)
			let properties = try list.properties()
			// configured latency, base volume, state, volume steps, card
			try list.skip(5)
			let ports = try list.u32()
			// each port: name, description, priority, availability
			try list.skip(ports * 4)
			// active port
			try list.skip()
			let formats = try list.u8()
			try list.skip(formats)
			continue when !speakers && monitorOf != -1
			out.push(pulseDevice(kind, name, description, properties, name == wanted))
		}
		return out
	}

	// The device a sink or source describes, with its hardware details where
	// the server knows them.
	internal def pulseDevice(kind DeviceKind, name string, description string, properties map<string, string>, isDefault bool) Device {
		let card = property(properties, "alsa.card")
		let pcm = property(properties, "alsa.device")
		let node = (card == "" || pcm == "") ?? ("", "/dev/snd/pcmC{card}D{pcm}{kind == DeviceKind.Speaker ?? ("p", "c")}")
		return Device{
			id:        "pulse:" + name,
			kind:      kind,
			name:      description == "" ?? (name, description),
			vendorId:  hexNumber(property(properties, "device.vendor.id")),
			productId: hexNumber(property(properties, "device.product.id")),
			vendor:    property(properties, "device.vendor.name"),
			product:   property(properties, "device.product.name"),
			serial:    property(properties, "device.serial"),
			node:      node,
			bus:       property(properties, "device.bus"),
			isDefault: isDefault,
		}
	}

	// The property's value, "" when the server did not give it.
	internal def property(properties map<string, string>, key string) string {
		let value = properties.get(key)
		return "" when value is none
		let text string = value
		return text
	}

	// The number a hexadecimal id spells ("0x046d", "046d"); 0 when it is empty.
	internal def hexNumber(text string) int {
		let digits = text.startsWith("0x") ?? (text[2:], text)
		return 0 when digits == ""
		return digits.toInt<int>(16)
	}

	// --- streams ----------------------------------------------------------------

	// Sound playing through the server, float32 at the speaker's own layout.
	internal type PulsePlayback {
		internal connection PulseConnection
		internal channel    int
		internal frameBytes int

		def new(connection PulseConnection, channel int, frameBytes int) {
			self.connection = connection
			self.channel = channel
			self.frameBytes = frameBytes
		}

		// Sends the frames as the server asks for them.
		//
		// Fails when the connection breaks.
		def write(samples float32[]) !none {
			let data = encodeSamples(samples, FORMAT_FLOAT_LE)
			let at = 0
			for at < data.len() {
				for connection.requested < frameBytes {
					let other = try connection.receive()
				}
				let left = data.len() - at
				let size = connection.requested < left ?? (connection.requested, left)
				size = size < PULSE_MAX_PACKET ?? (size, PULSE_MAX_PACKET)
				size -= size % frameBytes
				try connection.send(channel, data[at:at + size])
				connection.requested -= size
				at += size
			}
			return none
		}

		// Returns once the server has played everything sent.
		//
		// Fails when the connection breaks.
		def drain() !none {
			let body = new PulseTags()
			body.u32(channel)
			try connection.command(PULSE_DRAIN_PLAYBACK_STREAM, body)
			return none
		}

		// Ends the stream at once and hangs up.
		def close() {
			let body = new PulseTags()
			body.u32(channel)
			connection.command(PULSE_DELETE_PLAYBACK_STREAM, body) onerror recover new PulseReader([])
			connection.close()
		}
	}

	// Opens a playback stream on the sink, the server's default when the name is
	// empty, taking float32 at the rate and channel count.
	//
	// Fails when the server refuses the stream.
	internal def pulsePlayback(connection PulseConnection, sink string, rate int, channels int) !PulsePlayback {
		let frameBytes = 4 * channels
		let body = new PulseTags()
		body.sampleSpec(rate, channels).channelMap(channels)
		body.u32(PULSE_NO_INDEX).text(sink)
		// max length, not corked, target length, prebuffer, minimum request, sync group
		body.u32(PULSE_NO_INDEX).flag(false).u32(rate * PULSE_TARGET_MS / 1000 * frameBytes)
		body.u32(PULSE_NO_INDEX).u32(PULSE_NO_INDEX).u32(0)
		body.fullVolume(channels)
		// no remap, no remix, fix format, fix rate, fix channels, no move, variable rate
		for let n = 0; n < 7; n++ {
			body.flag(false)
		}
		// muted, adjust latency
		body.flag(false).flag(false)
		body.properties(streamProperties("playback"))
		// volume set, early requests, muted set, keep auto-suspend, fail on
		// suspend, relative volume, passthrough; no formats
		for let n = 0; n < 7; n++ {
			body.flag(false)
		}
		body.u8(0)
		let reply = try connection.command(PULSE_CREATE_PLAYBACK_STREAM, body)
		let channel = try reply.u32()
		// sink input
		try reply.skip()
		connection.requested += try reply.u32()
		return new PulsePlayback(connection, channel, frameBytes)
	}

	// Sound recording through the server, float32 at the microphone's own layout.
	internal type PulseCapture {
		internal connection PulseConnection
		internal channel    int
		internal frameBytes int

		def new(connection PulseConnection, channel int, frameBytes int) {
			self.connection = connection
			self.channel = channel
			self.frameBytes = frameBytes
		}

		// The next whole frames the server delivered, waiting for some.
		//
		// Fails when the connection breaks or nothing arrives in time.
		def read() !float32[] {
			for connection.received.len() < frameBytes {
				let other = try connection.receive()
			}
			let whole = connection.received.len() - connection.received.len() % frameBytes
			let samples = decodeSamples(connection.received[0:whole], FORMAT_FLOAT_LE)
			connection.received = connection.received[whole:]
			return samples
		}

		// Ends the stream and hangs up.
		def close() {
			let body = new PulseTags()
			body.u32(channel)
			connection.command(PULSE_DELETE_RECORD_STREAM, body) onerror recover new PulseReader([])
			connection.close()
		}
	}

	// Opens a record stream on the source, the server's default when the name is
	// empty, yielding float32 at the rate and channel count.
	//
	// Fails when the server refuses the stream.
	internal def pulseCapture(connection PulseConnection, source string, rate int, channels int) !PulseCapture {
		let frameBytes = 4 * channels
		let body = new PulseTags()
		body.sampleSpec(rate, channels).channelMap(channels)
		body.u32(PULSE_NO_INDEX).text(source)
		// max length, not corked, fragment size
		body.u32(PULSE_NO_INDEX).flag(false).u32(rate * PULSE_FRAGMENT_MS / 1000 * frameBytes)
		// no remap, no remix, fix format, fix rate, fix channels, no move,
		// variable rate, peak detect, adjust latency
		for let n = 0; n < 9; n++ {
			body.flag(false)
		}
		body.properties(streamProperties("recording"))
		// not tied to a sink input; early requests, keep auto-suspend, fail on suspend
		body.u32(PULSE_NO_INDEX).flag(false).flag(false).flag(false)
		// no formats; volume, muted, volume set, muted set, relative volume, passthrough
		body.u8(0).fullVolume(channels)
		for let n = 0; n < 5; n++ {
			body.flag(false)
		}
		let reply = try connection.command(PULSE_CREATE_RECORD_STREAM, body)
		let channel = try reply.u32()
		return new PulseCapture(connection, channel, frameBytes)
	}

	// What a stream tells the server about itself.
	internal def streamProperties(media string) map<string, string> {
		let properties map<string, string>
		properties["media.name"] = media
		return properties
	}
}
