partial module std.devices {
	use (
		std.testing
		std.services.storage::(Storage)
		std.services.devices::(Device, DeviceKind)
		std.services.policy::(Policy, PolicyDenied)
		std.devices.termios::*
		std.devices.structs::*
	)

	// A pseudo-terminal's two ends: the far end the suite plays the device
	// on, and the near end a SerialPort drives as it drives a port.
	internal struct PseudoTerminal {
		far  int
		near int
		// The near end's path, /dev/pts/N.
		path string
	}

	// Opens a pseudo-terminal.
	//
	// Fails when the system has none.
	internal def pseudoTerminal() !PseudoTerminal {
		let far = try __fs_open("/dev/ptmx", "r+")
		try __fs_ioctl(far, PTY_UNLOCK, zeroed(4))
		let number = zeroed(4)
		try __fs_ioctl(far, PTY_NUMBER, number)
		let near = try __fs_ioctl_value(far, PTY_PEER, PTY_PEER_FLAGS)
		return PseudoTerminal{far: far, near: near, path: "/dev/pts/{u32(number, 0)}"}
	}

	// Closes the far end of a pseudo-terminal.
	internal def releaseFar(pty PseudoTerminal) {
		__fs_close(pty.far) onerror recover none
	}

	// Everything the far end has to read, waiting up to timeout for each
	// part, until `count` bytes came.
	//
	// Fails when the far end cannot be read.
	internal def readFar(pty PseudoTerminal, count int, timeout duration = 1s) !byte[] {
		let out byte[]
		let buf byte[]
		buf.len(4096)
		for out.len() < count {
			break unless try __fs_wait(pty.far, timeout, false)
			let n = try __fs_read(pty.far, buf)
			break when n <= 0
			out.push(...buf.slice(0, n))
		}
		return out
	}

	// A SerialPort on the near end of a new pseudo-terminal.
	//
	// Fails when the system has no pseudo-terminals.
	internal def pseudoPort(baud int = 9600) !(SerialPort, PseudoTerminal) {
		let pty = try pseudoTerminal()
		let port = try portOn(Device{id: "serial:pty", kind: DeviceKind.Serial, name: "pseudo-terminal", node: pty.path}, pty.near, baud, 8, Parity.None, 1, FlowControl.None)
		return (port, pty)
	}

	// _IOW('T', 0x31, int), _IOR('T', 0x30, unsigned int), _IO('T', 0x41).
	internal const PTY_UNLOCK = 0x40045431
	internal const PTY_NUMBER = 0x80045430
	internal const PTY_PEER = 0x5441
	// O_RDWR | O_NOCTTY.
	internal const PTY_PEER_FLAGS = 0x102

	check "Serial ports" {
		// The request numbers and layout are asm-generic/termbits.h's and
		// asm/ioctls.h's, as clang computes them.
		@test()
		def TestTermiosLayout() {
			assert TERMIOS2_SIZE == 44 && C_CC == 17 && C_ISPEED == 36 && C_OSPEED == 40
			assert TCGETS2 == 0x802C542A && TCSETS2 == 0x402C542B
			assert TIOCEXCL == 0x540C && TIOCMGET == 0x5415 && TIOCOUTQ == 0x5411 && FIONBIO == 0x5421
		}

		// Raw mode clears every translation and sets the framing and speed
		// asked for; the framing reads back from the flags.
		@test()
		def TestRawSettings() {
			let t = zeroed(TERMIOS2_SIZE)
			// What a terminal starts with: canonical, echoing, CR to NL, NL to CRNL, 38400 baud.
			putU32(t, C_IFLAG, ICRNL | IXON | BRKINT)
			putU32(t, C_OFLAG, OPOST | 0x04)
			putU32(t, C_CFLAG, 0x0F | 0x30 | CREAD | HUPCL)
			putU32(t, C_LFLAG, ISIG | ICANON | ECHO | IEXTEN)
			t[C_CC + VMIN] = byte(1)
			rawSettings(t, 250000, 8, Parity.None, 1, FlowControl.None)
			assert u32(t, C_IFLAG) == 0
			assert (u32(t, C_OFLAG) & OPOST) == 0
			assert u32(t, C_LFLAG) == 0
			let c = u32(t, C_CFLAG)
			assert (c & CBAUD) == BOTHER && ((c >> IBSHIFT) & CBAUD) == BOTHER
			assert (c & CREAD) != 0 && (c & CLOCAL) != 0 && (c & HUPCL) == 0
			assert u32(t, C_ISPEED) == 250000 && u32(t, C_OSPEED) == 250000
			assert int(t[C_CC + VMIN]) == 0 && int(t[C_CC + VTIME]) == 0
			assert dataBitsOf(c) == 8 && parityOf(c) == Parity.None && flowOf(u32(t, C_IFLAG), c) == FlowControl.None

			rawSettings(t, 4800, 7, Parity.Even, 2, FlowControl.Hardware)
			c = u32(t, C_CFLAG)
			assert dataBitsOf(c) == 7 && parityOf(c) == Parity.Even && (c & CSTOPB) != 0
			assert flowOf(u32(t, C_IFLAG), c) == FlowControl.Hardware
			assert (u32(t, C_IFLAG) & INPCK) != 0
			rawSettings(t, 1200, 5, Parity.Odd, 1, FlowControl.Software)
			c = u32(t, C_CFLAG)
			assert dataBitsOf(c) == 5 && parityOf(c) == Parity.Odd && (c & CSTOPB) == 0 && (c & CRTSCTS) == 0
			assert flowOf(u32(t, C_IFLAG), c) == FlowControl.Software
			rawSettings(t, 9600, 6, Parity.Mark, 1, FlowControl.None)
			assert parityOf(u32(t, C_CFLAG)) == Parity.Mark && dataBitsOf(u32(t, C_CFLAG)) == 6
			rawSettings(t, 9600, 8, Parity.Space, 1, FlowControl.None)
			assert parityOf(u32(t, C_CFLAG)) == Parity.Space
			assert (u32(t, C_IFLAG) & (IXON | IXOFF)) == 0
		}

		// Bytes pass both ways untranslated, at the speed asked (any rate),
		// a read waits only as long as it is told, and the port is this
		// program's alone.
		@os("linux")
		@test()
		def TestPortOverAPseudoTerminal() !none {
			let (port, pty) = try pseudoPort(250000)
			defer port.dispose()
			defer releaseFar(pty)
			assert port.baud == 250000 && port.dataBits == 8 && port.parity == Parity.None && port.stopBits == 1
			assert port.isOpen()

			// CR, NL, ^C and XOFF reach the program as they are.
			let sent = byte[0x24, 0x0D, 0x0A, 0x03, 0x13, 0x7F, 0xFF]
			try __fs_write(pty.far, sent)
			let got = try port.read(1s)
			assert got.equals(sent)

			// Every byte value goes out as it is, a newline without a CR before it.
			let all byte[]
			for let i = 0; i < 256; i++ {
				all.push(byte(i))
			}
			assert (try port.write(all)) == 256
			assert (try readFar(pty, 256)).equals(all)
			try port.drain()

			// Nothing waiting: the timed read fails as a stream's does, the plain one is empty.
			let code = ""
			let buf byte[]
			buf.len(16)
			port.read(buf, 30ms) onerror (err error) {
				code = err.code
				recover 0
			}
			assert code == "ETIMEDOUT"
			assert (try port.read(30ms)).len() == 0

			// The fields are what the driver kept: a pseudo-terminal keeps the
			// speed and stop bits but always carries 8 bits without parity.
			try port.configure(baud = 4800, dataBits = 7, parity = Parity.Even, stopBits = 2)
			assert port.baud == 4800 && port.stopBits == 2
			assert port.dataBits == 8 && port.parity == Parity.None
			try port.configure(flow = FlowControl.Hardware)
			assert port.flow == FlowControl.Hardware && port.baud == 4800 && port.stopBits == 2

			// What arrived before a discard is gone.
			try __fs_write(pty.far, "stale".bytes())
			assert try Storage.wait(pty.near, 1s)
			try port.discard()
			assert (try port.read(30ms)).len() == 0

			// A pseudo-terminal takes a break as a request it has nothing to do
			// for, and has no modem lines: those calls fail rather than pretend.
			try port.sendBreak(10ms)
			let unsupported = 0
			port.lines() onerror (err error) {
				unsupported++
				recover ModemLines{}
			}
			port.dtr(false) onerror (err error) {
				unsupported++
				recover none
			}
			assert unsupported == 2 onerror fail "{unsupported} of lines and dtr failed on a pseudo-terminal"

			// A second open of the port is refused while it is held.
			let busy = ""
			__fs_open(pty.path, "r+") onerror (err error) {
				busy = err.code
				recover -1
			}
			assert busy == "EBUSY"

			// Closing puts the terminal's own settings back, without the
			// hang-up that would drop DTR.
			try port.close()
			let again = try __fs_open(pty.path, "r+")
			let t = zeroed(TERMIOS2_SIZE)
			try __fs_ioctl(again, TCGETS2, t)
			try __fs_close(again)
			assert (u32(t, C_LFLAG) & ICANON) != 0 && (u32(t, C_IFLAG) & ICRNL) != 0
			assert (u32(t, C_CFLAG) & HUPCL) == 0
			return none
		}

		// A port whose other end went away fails its reads; a closed port
		// fails every call and closes again quietly.
		@os("linux")
		@test()
		def TestGoneAndClosedPorts() !none {
			let (port, pty) = try pseudoPort()
			try __fs_close(pty.far)
			let gone = false
			port.read(1s) onerror (err error) {
				gone = true
				recover []
			}
			assert gone
			try port.close()
			try port.close()
			assert !port.isOpen()
			let closed = 0
			port.read(10ms) onerror (err error) {
				closed += 1 when err.message.contains("closed")
				recover []
			}
			port.write("x".bytes()) onerror (err error) {
				closed += 1 when err.message.contains("closed")
				recover 0
			}
			port.configure(baud = 1200) onerror (err error) {
				closed += 1 when err.message.contains("closed")
				recover none
			}
			assert closed == 3
			return none
		}

		// Settings out of range are refused before the driver sees them.
		@os("linux")
		@test()
		def TestBadSettingsRefused() !none {
			let (port, pty) = try pseudoPort()
			defer port.dispose()
			defer releaseFar(pty)
			let refused = 0
			port.configure(dataBits = 9) onerror (err error) {
				refused += 1 when err.message.contains("data bits")
				recover none
			}
			port.configure(stopBits = 3) onerror (err error) {
				refused += 1 when err.message.contains("stop bits")
				recover none
			}
			port.configure(baud = -5) onerror (err error) {
				refused += 1 when err.message.contains("baud")
				recover none
			}
			assert refused == 3
			assert port.baud == 9600 && port.dataBits == 8
			return none
		}

		// Ports list as serial or GPS devices; a wrong id, a missing port and
		// a denied one are refused.
		@test()
		def TestOpenSerialRefuses() !none {
			for let (_, d) in serialPorts() onerror recover [] {
				assert d.id.startsWith("serial:") && d.node.startsWith("/dev/")
				assert d.kind := DeviceKind.Serial || DeviceKind.Gps
			}
			let refused = 0
			openSerial("video:video0") onerror (err error) {
				refused++
				recover new SerialPort(Device{}, -1)
			}
			openSerial("serial:no-such-port") onerror (err error) {
				refused++
				recover new SerialPort(Device{}, -1)
			}
			try Policy.configure("[adm.devices.serial]\ndevice.deny = [\"serial:*\"]\n")
			let denied = false
			openSerial("serial:ttyUSB0") onerror (err error) {
				denied = err is PolicyDenied
				recover new SerialPort(Device{}, -1)
			}
			try Policy.configure("")
			assert refused == 2 && denied
			return none
		}
	}
}
