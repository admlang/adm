// Playing sound through the machine's speakers.
//
// `speakers()` names the outputs, `openSpeaker(id)` opens one, and `play` sends
// it anything that yields samples: a decoded file, a `Microphone`, a generated
// tone. Samples are `float32` in -1.0..1.0 with channels interleaved, as
// `AudioStream` yields them; the speaker converts them to what the hardware
// takes and resamples when the device runs at another rate.
//
// Example: a second of A4 through the default speaker
// ```example
// use std.devices
//
// let speaker = try devices.openSpeaker()
// defer speaker.close()
// let rate = speaker.sampleRate()
// let tone float32[]
// for i in 0..rate {
// 	let sample = float32(0.2 * math.sin(2.0 * math.Pi * 440.0 * float(i) / float(rate)))
// 	tone.push(sample)
// 	tone.push(sample)
// }
// try speaker.write(tone)
// try speaker.drain()
// ```

partial module std.devices {
	use (
		std.formats.audio
		std.formats.audio::(Audio, AudioStream, Converter)
		std.services.devices::(Device, DeviceKind, Devices)
		std.devices.pulse::*
		std.devices.alsa::*
		std.devices.samples::*
	)

	// An open speaker. openSpeaker returns one; close it when done, or let it go —
	// dispose closes it.
	type Speaker {
		// The output the sound goes to.
		device                Device
		internal rate         int
		internal channelCount int

		// Where the sound goes; none once closed.
		internal backend ?PlaybackBackend

		// Speakers come from `openSpeaker`, which sets the device up first.
		internal def new(device Device, backend ?PlaybackBackend, sampleRate int, channels int) {
			self.device = device
			self.backend = backend
			rate = sampleRate
			channelCount = channels
		}

		// Frames per second the speaker takes, the one openSpeaker asked for;
		// samples are resampled when the device itself runs at another rate.
		def sampleRate() int {
			return rate
		}

		// Samples per frame the speaker takes, interleaved.
		def channels() int {
			return channelCount
		}

		// Plays the stream to its end and returns once the last frame has been
		// heard. A stream at another rate or channel count is converted.
		//
		// Fails when the speaker is closed, the stream fails to read, or the
		// device errors.
		def play(stream AudioStream) !none {
			let info = stream.info()
			let from = new Converter(int(info.sampleRate), int(info.channels), rate, channelCount)
			let buf float32[]
			buf.len(PLAY_CHUNK_FRAMES * int(info.channels))
			for {
				let frames = try stream.read(buf)
				break when frames == 0
				try write(from.convert(buf[0:frames * int(info.channels)]))
			}
			try write(from.flush())
			return drain()
		}

		// Plays decoded audio to its end.
		//
		// Fails when the speaker is closed or the device errors.
		def play(audio Audio) !none {
			let from = new Converter(int(audio.info.sampleRate), int(audio.info.channels), rate, channelCount)
			let step = PLAY_CHUNK_FRAMES * int(audio.info.channels)
			for let at = 0; at < audio.samples.len(); at += step {
				let end = at + step > audio.samples.len() ?? (audio.samples.len(), at + step)
				try write(from.convert(audio.samples[at:end]))
			}
			try write(from.flush())
			return drain()
		}

		// Opens the audio file at the path, plays it to its end and closes it.
		//
		// Fails when the file cannot be read or decoded, the speaker is closed,
		// or the device errors.
		def play(path string) !none {
			let stream = try audio.open(path)
			play(stream) onerror (err error) {
				stream.close() onerror recover none
				fail err
			}
			return stream.close()
		}

		// Queues interleaved frames at the speaker's own rate and channel count,
		// waiting while the device's buffer is full, and returns the frames
		// queued. Returns before they are heard; `drain` waits for that.
		//
		// Fails when the speaker is closed, the samples are not a whole number of
		// frames, or the device errors.
		def write(samples float32[]) !int {
			expects {
				assert samples.len() % channelCount == 0 onerror fail "devices: {samples.len()} samples are not whole frames of {channelCount} channels"
			}
			let output = try opened()
			try output.write(samples)
			return samples.len() / channelCount
		}

		// Waits until every queued frame has been heard.
		//
		// Fails when the speaker is closed or the device errors.
		def drain() !none {
			let output = try opened()
			return output.drain()
		}

		// Stops at once, dropping what is still queued, and releases the device.
		// Safe to call twice.
		def close() {
			return when backend is none
			let output PlaybackBackend = backend
			backend = none
			output.close()
		}

		// Whether the speaker is still open.
		def isOpen() bool {
			return !(backend is none)
		}

		// Closing on dispose, so a speaker nobody holds any more frees the device.
		def dispose() {
			close()
		}

		// The backend while the speaker is open.
		//
		// Fails when the speaker is closed.
		internal def opened() !PlaybackBackend {
			fail "devices: speaker {device.id} is closed" when backend is none
			let output PlaybackBackend = backend
			return output
		}
	}

	// Frames read from a stream per write while playing it.
	internal const PLAY_CHUNK_FRAMES = 4096

	// The speakers the machine has. Through the desktop's sound server when it
	// runs, which lists every output it can play to, Bluetooth and virtual ones
	// included, and marks the one it uses; else the sound cards' outputs, analog
	// before HDMI and DisplayPort, the first marked default.
	//
	// Fails when the policy denies listing the devices.
	@requires("adm.devices.list")
	def speakers() !Device[] {
		return soundDevices(DeviceKind.Speaker)
	}

	// The speaker the desktop plays sound through, as `speakers()` lists it.
	//
	// Fails when the policy denies listing the devices or the machine has no speaker.
	@requires("adm.devices.list")
	def defaultSpeaker() !Device {
		return defaultSound(DeviceKind.Speaker, "speaker")
	}

	// Opens the speaker behind the device id; an empty id opens `defaultSpeaker()`.
	// The device may run at another rate or channel count than
	// asked, and the speaker converts.
	//
	// Fails when there is no such speaker or it cannot be opened, as while
	// another program holds it.
	def openSpeaker(id string = "", sampleRate int = 48000, channels int = 2) !Speaker {
		expects {
			assert sampleRate > 0 onerror fail "devices: a speaker needs a sample rate above 0, not {sampleRate}"
			assert channels > 0 onerror fail "devices: a speaker needs at least one channel, not {channels}"
		}
		if id == "" || id.startsWith("pulse:") {
			let server = pulseConnection("adm")
			if !(server is none) {
				let connection PulseConnection = server
				let speaker = openServerSpeaker(connection, id, sampleRate, channels) onerror (err error) {
					connection.close()
					fail err
				}
				return speaker
			}
			fail "devices: no sound server to play to {id} through" when id != ""
		}
		let device = try soundDevice(id, DeviceKind.Speaker, "speaker")
		let (fd, layout) = try openAlsa(device, true, sampleRate, channels)
		return new Speaker(device, new AlsaPlayback(fd, layout, sampleRate, channels), sampleRate, channels)
	}

	// A speaker playing through the sound server to the sink behind the id, its
	// default when the id is empty.
	//
	// Fails when the server has no such sink or refuses the stream.
	internal def openServerSpeaker(connection PulseConnection, id string, sampleRate int, channels int) !Speaker {
		let device = try pulsePick(connection, DeviceKind.Speaker, id, "speaker")
		let playback = try pulsePlayback(connection, device.id[6:], sampleRate, channels)
		return new Speaker(device, playback, sampleRate, channels)
	}

	// The speakers or microphones: the sound server's when it runs, else the
	// sound cards', the first marked default.
	//
	// Fails when the policy denies listing the devices or the server does not answer.
	internal def soundDevices(kind DeviceKind) !Device[] {
		let server = pulseConnection("adm")
		if !(server is none) {
			let connection PulseConnection = server
			let listed = pulseDevices(connection, kind) onerror (err error) {
				connection.close()
				fail err
			}
			connection.close()
			return listed
		}
		let cards = try Devices.list(kind)
		cards[0].isDefault = true when cards.len() > 0
		return cards
	}

	// The default of the kind, as soundDevices lists it.
	//
	// Fails when the machine has none of the kind.
	internal def defaultSound(kind DeviceKind, what string) !Device {
		let all = try soundDevices(kind)
		for let (_, device) in all {
			return device when device.isDefault
		}
		fail "devices: this machine has no {what}" when all.len() == 0
		return all[0]
	}

	// The server's device behind the id, or its default when the id is empty.
	//
	// Fails when the server has no such device, or none of the kind at all.
	internal def pulsePick(connection PulseConnection, kind DeviceKind, id string, what string) !Device {
		let all = try pulseDevices(connection, kind)
		for let (_, device) in all {
			return device when (id == "" && device.isDefault) || device.id == id
		}
		fail "devices: {id} is not a {what} the sound server knows" when id != ""
		fail "devices: the sound server has no {what}" when all.len() == 0
		return all[0]
	}

	// The sound card output or input behind the id, or the first of its kind
	// when the id is empty.
	//
	// Fails when the policy denies listing the devices, there is no such device,
	// or it is of another kind.
	internal def soundDevice(id string, kind DeviceKind, what string) !Device {
		if id == "" {
			let all = try Devices.list(kind)
			fail "devices: this machine has no {what}" when all.len() == 0
			return all[0]
		}
		let found = try Devices.get(id)
		fail "devices: no device with the id {id}" when found is none
		let device Device = found
		fail "devices: {id} is not a {what}" when device.kind != kind
		return device
	}
}
