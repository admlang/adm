// Playing sound through the machine's speakers.
//
// `speakers()` names the outputs, `openSpeaker(id)` opens one, and `play` sends
// it anything that yields samples: a decoded file, a `Microphone`, a generated
// tone. Samples are `float32` in -1.0..1.0 with channels interleaved, as
// `AudioStream` yields them; the speaker converts them to what the hardware
// takes and resamples when the device runs at another rate.
//
// Example: a second of A4 through the default speaker
// ```example
// use std.devices
//
// let speaker = try devices.openSpeaker()
// defer speaker.close()
// let rate = speaker.sampleRate()
// let tone float32[]
// for i in 0..rate {
// 	let sample = float32(0.2 * math.sin(2.0 * math.Pi * 440.0 * float(i) / float(rate)))
// 	tone.push(sample)
// 	tone.push(sample)
// }
// try speaker.write(tone)
// try speaker.drain()
// ```

partial module std.devices {
	use (
		std.formats.audio
		std.formats.audio::(Audio, AudioStream, Converter)
		std.os
		std.services.devices::(Device, DeviceKind, Devices)
		std.services.storage::(Storage)
		std.devices.pulse::*
		std.devices.alsa::*
		std.devices.samples::*
	)

	// An open speaker. openSpeaker returns one; close it when done, or let it go —
	// dispose closes it.
	type Speaker {
		// The output the sound goes to. A speaker opened on the default follows
		// the desktop's default, and the sound server moves any speaker whose
		// output goes away; this names the output after the last write or drain.
		device                Device
		internal rate         int
		internal channelCount int

		// Where the sound goes; none once closed.
		internal backend ?PlaybackBackend

		// Speakers come from `openSpeaker`, which sets the device up first.
		internal def new(device Device, backend ?PlaybackBackend, sampleRate int, channels int) {
			self.device = device
			self.backend = backend
			rate = sampleRate
			channelCount = channels
		}

		// Frames per second the speaker takes, the one openSpeaker asked for;
		// samples are resampled when the device itself runs at another rate.
		def sampleRate() int {
			return rate
		}

		// Samples per frame the speaker takes, interleaved.
		def channels() int {
			return channelCount
		}

		// Plays the stream to its end and returns once the last frame has been
		// heard. A stream at another rate or channel count is converted.
		//
		// Fails when the speaker is closed, the stream fails to read, or the
		// device errors.
		def play(stream AudioStream) !none {
			let info = stream.info()
			let from = new Converter(int(info.sampleRate), int(info.channels), rate, channelCount)
			let buf float32[]
			buf.len(PLAY_CHUNK_FRAMES * int(info.channels))
			for {
				let frames = try stream.read(buf)
				break when frames == 0
				try write(from.convert(buf[0:frames * int(info.channels)]))
			}
			try write(from.flush())
			return drain()
		}

		// Plays decoded audio to its end.
		//
		// Fails when the speaker is closed or the device errors.
		def play(audio Audio) !none {
			let from = new Converter(int(audio.info.sampleRate), int(audio.info.channels), rate, channelCount)
			let step = PLAY_CHUNK_FRAMES * int(audio.info.channels)
			for let at = 0; at < audio.samples.len(); at += step {
				let end = at + step > audio.samples.len() ?? (audio.samples.len(), at + step)
				try write(from.convert(audio.samples[at:end]))
			}
			try write(from.flush())
			return drain()
		}

		// Opens the audio file at the path, plays it to its end and closes it.
		//
		// Fails when the file cannot be read or decoded, the speaker is closed,
		// or the device errors.
		def play(path string) !none {
			let stream = try audio.open(path)
			play(stream) onerror (err error) {
				stream.close() onerror recover none
				fail err
			}
			return stream.close()
		}

		// Queues interleaved frames at the speaker's own rate and channel count,
		// waiting while the device's buffer is full, and returns the frames
		// queued. Returns before they are heard; `drain` waits for that.
		//
		// Fails when the speaker is closed, the samples are not a whole number of
		// frames, or the device errors.
		def write(samples float32[]) !int {
			expects {
				assert samples.len() % channelCount == 0 onerror fail "devices: {samples.len()} samples are not whole frames of {channelCount} channels"
			}
			let output = try opened()
			try output.write(samples)
			follow(output)
			return samples.len() / channelCount
		}

		// Waits until every queued frame has been heard.
		//
		// Fails when the speaker is closed or the device errors.
		def drain() !none {
			let output = try opened()
			try output.drain()
			follow(output)
			return none
		}

		// The speaker's own volume, from 0.0 silent to 1.0 full, on the scale of
		// the desktop's mixer, which shows it as this program's slider. The
		// output's volume, which every program playing there shares, is
		// `devices.volume(speaker.device)`.
		//
		// Fails when the speaker is closed or the sound server does not answer.
		def volume() !float {
			let output = try opened()
			return output.volume()
		}

		// Sets the speaker's own volume, 1.0 being full; above it amplifies, and
		// loud sound clips.
		//
		// Fails when the level is negative, the speaker is closed, or the sound
		// server refuses.
		def volume(level float) !none {
			expects {
				assert level >= 0.0 onerror fail "devices: a volume is 0.0 or more, not {level}"
			}
			let output = try opened()
			return output.volume(level)
		}

		// Whether the speaker itself is muted, whatever its volume.
		//
		// Fails when the speaker is closed or the sound server does not answer.
		def muted() !bool {
			let output = try opened()
			return output.muted()
		}

		// Silences the speaker, keeping its volume for `unmute`.
		//
		// Fails when the speaker is closed or the sound server refuses.
		def mute() !none {
			let output = try opened()
			return output.mute(true)
		}

		// Lets the speaker be heard again at its volume.
		//
		// Fails when the speaker is closed or the sound server refuses.
		def unmute() !none {
			let output = try opened()
			return output.mute(false)
		}

		// Stops at once, dropping what is still queued, and releases the device.
		// Safe to call twice.
		def close() {
			return when backend is none
			let output PlaybackBackend = backend
			backend = none
			output.close()
		}

		// Whether the speaker is still open.
		def isOpen() bool {
			return !(backend is none)
		}

		// Closing on dispose, so a speaker nobody holds any more frees the device.
		def dispose() {
			close()
		}

		// Takes note of the output the backend moved to.
		internal def follow(output PlaybackBackend) {
			let moved = output.moved()
			device = moved unless moved is none
		}

		// The backend while the speaker is open.
		//
		// Fails when the speaker is closed.
		internal def opened() !PlaybackBackend {
			fail "devices: speaker {device.id} is closed" when backend is none
			let output PlaybackBackend = backend
			return output
		}
	}

	// Frames read from a stream per write while playing it.
	internal const PLAY_CHUNK_FRAMES = 4096

	// The speakers the machine has. Through the desktop's sound server when it
	// runs, which lists every output it can play to, Bluetooth and virtual ones
	// included, and marks the one it uses; else the sound cards' outputs, analog
	// before HDMI and DisplayPort, the one ALSA's configured `default` plays to
	// marked (the first when it names none of them).
	//
	// Fails when the policy denies listing the devices.
	@requires("adm.devices.list")
	def speakers() !Device[] {
		return soundDevices(DeviceKind.Speaker)
	}

	// The speaker the desktop plays sound through, as `speakers()` lists it.
	//
	// Fails when the policy denies listing the devices or the machine has no speaker.
	@requires("adm.devices.list")
	def defaultSpeaker() !Device {
		return defaultSound(DeviceKind.Speaker, "speaker")
	}

	// Opens the speaker behind the device id; an empty id opens `defaultSpeaker()`
	// and, through a sound server, follows the desktop's default when it picks
	// another. The device may run at another rate or channel count than
	// asked, and the speaker converts.
	//
	// Fails when there is no such speaker or it cannot be opened, as while
	// another program holds it.
	def openSpeaker(id string = "", sampleRate int = 48000, channels int = 2) !Speaker {
		expects {
			assert sampleRate > 0 onerror fail "devices: a speaker needs a sample rate above 0, not {sampleRate}"
			assert channels > 0 onerror fail "devices: a speaker needs at least one channel, not {channels}"
		}
		if id == "" || id.startsWith("pulse:") {
			let server = pulseConnection("adm")
			if !(server is none) {
				let connection PulseConnection = server
				let speaker = openServerSpeaker(connection, id, sampleRate, channels) onerror (err error) {
					connection.close()
					fail err
				}
				return speaker
			}
			fail "devices: no sound server to play to {id} through" when id != ""
		}
		let card = try soundId(id, DeviceKind.Speaker, "speaker")
		let (device, fd) = openKind(card, DeviceKind.Speaker, "speaker") onerror (err error) {
			let (connection, route) = try serverInstead(card, DeviceKind.Speaker, err)
			let speaker = openServerSpeaker(connection, route, sampleRate, channels) onerror (failed error) {
				connection.close()
				fail failed
			}
			return speaker
		}
		let layout = openAlsa(fd, true, sampleRate, channels) onerror (err error) {
			Devices.close(fd) onerror recover none
			fail err
		}
		return new Speaker(device, new AlsaPlayback(fd, layout, sampleRate, channels), sampleRate, channels)
	}

	// A speaker playing through the sound server to the sink behind the id, or
	// to its default, following it, when the id is empty.
	//
	// Fails when the server has no such sink or refuses the stream.
	internal def openServerSpeaker(connection PulseConnection, id string, sampleRate int, channels int) !Speaker {
		if id == "" {
			let playback = try pulsePlayback(connection, "", sampleRate, channels)
			let playing = pulseEndpoint(connection, DeviceKind.Speaker, playback.sink) onerror (err error) {
				playback.close()
				fail err
			}
			return new Speaker(playing.device, playback, sampleRate, channels)
		}
		let device = try pulsePick(connection, DeviceKind.Speaker, id, "speaker")
		let playback = try pulsePlayback(connection, device.id[6:], sampleRate, channels)
		return new Speaker(device, playback, sampleRate, channels)
	}

	// The speakers or microphones: the sound server's when it runs, else the
	// sound cards', the one ALSA's configured `default` uses marked.
	//
	// Fails when the policy denies listing the devices or the server does not answer.
	internal def soundDevices(kind DeviceKind) !Device[] {
		let server = pulseConnection("adm")
		if !(server is none) {
			let connection PulseConnection = server
			let listed = pulseDevices(connection, kind) onerror (err error) {
				connection.close()
				fail err
			}
			connection.close()
			return listed
		}
		let cards = try Devices.list(kind)
		return cards when cards.len() == 0
		cards[try alsaDefaultEndpoint(cards, kind == DeviceKind.Speaker)].isDefault = true
		return cards
	}

	// Which of the card endpoints ALSA's configured `default` plays to or
	// records from: the one of its card and device, else the first of its
	// card, else the first of all.
	//
	// Fails when the policy denies listing the devices.
	internal def alsaDefaultEndpoint(endpoints Device[], playback bool) !int {
		let found = alsaDefault(alsaConfig(), playback)
		return 0 when found is none
		let target AlsaTarget = found
		let card = target.card
		if !card.isNumeric() {
			// A card id ("Generic"), which a card's listing names it by.
			card = ""
			for let (_, sound) in try Devices.list(DeviceKind.Audio) {
				if sound.name == target.card {
					card = sound.id[10:]
					break
				}
			}
			return 0 when card == ""
		}
		let prefix = "sound:pcmC{card}D"
		let exact = "{prefix}{target.device}{playback ?? ("p", "c")}"
		let first = -1
		for let (i, endpoint) in endpoints {
			return i when endpoint.id == exact
			first = i when first < 0 && endpoint.id.startsWith(prefix)
		}
		return first < 0 ?? (0, first)
	}

	// The default of the kind, as soundDevices lists it.
	//
	// Fails when the machine has none of the kind.
	internal def defaultSound(kind DeviceKind, what string) !Device {
		let all = try soundDevices(kind)
		for let (_, device) in all {
			return device when device.isDefault
		}
		fail "devices: this machine has no {what}" when all.len() == 0
		return all[0]
	}

	// The server's device behind the id, or its default when the id is empty.
	//
	// Fails when the server has no such device, or none of the kind at all.
	internal def pulsePick(connection PulseConnection, kind DeviceKind, id string, what string) !Device {
		let all = try pulseDevices(connection, kind)
		for let (_, device) in all {
			return device when (id == "" && device.isDefault) || device.id == id
		}
		fail "devices: {id} is not a {what} the sound server knows" when id != ""
		fail "devices: the sound server has no {what}" when all.len() == 0
		return all[0]
	}

	// When the open of a card endpoint failed because another program holds
	// it: a connection to the sound server and the id of its own device on
	// the same hardware, so the sound goes there instead of waiting for the
	// card to be let go.
	//
	// Fails with the open's own error when it is not EBUSY or nothing holds
	// the endpoint, and names the program that does when no sound server runs
	// or it has no device on that endpoint.
	internal def serverInstead(card string, kind DeviceKind, err error) !(PulseConnection, string) {
		fail err unless err.code == "EBUSY"
		let holder = soundHolder(card)
		fail err when holder == ""
		let busy = "devices: {card} is busy: {holder} holds it"
		let server = pulseConnection("adm")
		fail busy when server is none
		let connection PulseConnection = server
		let node = "/dev/snd/" + card[6:]
		let listed = pulseDevices(connection, kind) onerror (failed error) {
			connection.close()
			fail busy
		}
		for let (_, device) in listed {
			return (connection, device.id) when device.node == node
		}
		connection.close()
		fail "{busy}, and the sound server has no {kind == DeviceKind.Speaker ?? ("output", "input")} on it"
	}

	// The program holding a card endpoint (`sound:pcmC4D0p`), "name (pid
	// n)", or "" when no stream is open on it: the kernel lists the owner of
	// each open substream under /proc/asound.
	internal def soundHolder(card string) string {
		let name = card[6:]
		return "" unless name.startsWith("pcmC") && name.len() > 6
		let numbers = name[4:name.len() - 1].split("D")
		return "" unless numbers.len() == 2
		let dir = "/proc/asound/card{numbers[0]}/pcm{numbers[1]}{name[name.len() - 1]}"
		let entries = Storage.readDir(dir) onerror recover os.DirEntry[]
		for let (_, entry) in entries {
			continue unless entry.info.isDir
			let status = Storage.readFile(entry.path + "/status") onerror recover byte[]
			for let (_, line) in string(status).split("\n") {
				continue unless line.startsWith("owner_pid")
				let pid = line[line.indexOf(":") + 1:].trim()
				let comm = Storage.readFile("/proc/{pid}/comm") onerror recover byte[]
				let program = string(comm).trim()
				return program == "" ?? ("process {pid}", "{program} (pid {pid})")
			}
		}
		return ""
	}

	// The id itself, or for an empty id the sound card output or input of
	// the kind ALSA's configured `default` names, which takes the `list`
	// permission to find.
	//
	// Fails when the id is empty and the policy denies listing the devices
	// or the machine has none of the kind.
	internal def soundId(id string, kind DeviceKind, what string) !string {
		return id when id != ""
		let all = try Devices.list(kind)
		fail "devices: this machine has no {what}" when all.len() == 0
		return all[try alsaDefaultEndpoint(all, kind == DeviceKind.Speaker)].id
	}
}
