// The C structures the Linux device drivers take (V4L2, ALSA), laid out by
// hand in byte buffers: little-endian fields at fixed offsets.
internal partial module std.devices.structs {
	// A buffer of `size` zero bytes, which is how every request to the driver
	// starts: the fields not set are the ones the driver fills in.
	def zeroed(size int) byte[] {
		let buf byte[]
		buf.len(size)
		return buf
	}

	// The 32-bit value at the offset. Reads 0 past the end of the buffer rather
	// than failing, so a short answer from the driver reads as an empty field.
	def u32(buf byte[], offset int) int {
		return 0 when offset < 0 || offset + 4 > buf.len()
		return int(buf[offset]) | int(buf[offset + 1]) << 8 | int(buf[offset + 2]) << 16 | int(buf[offset + 3]) << 24
	}

	// Writes the 32-bit value at the offset. Writes nothing past the end of the
	// buffer.
	def putU32(buf byte[], offset int, value int) {
		return when offset < 0 || offset + 4 > buf.len()
		buf[offset] = byte(value & 0xFF)
		buf[offset + 1] = byte((value >> 8) & 0xFF)
		buf[offset + 2] = byte((value >> 16) & 0xFF)
		buf[offset + 3] = byte((value >> 24) & 0xFF)
	}
}
