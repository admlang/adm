// UPower, the desktop's power daemon, over the system bus: the power
// sources it knows (the kernel's, peripherals' batteries over Bluetooth and
// Logitech's receivers, USB UPSs) and its notices of their changes.
// D-Bus is Linux's, so this is too; elsewhere `upower_other.adm` says UPower
// does not run.
@os("linux")
partial module std.devices {
	use (
		std.proto::(DBusConnection, DBusMessage, DBusReader, DBusWriter, DBUS_ERROR, DBUS_SIGNAL, dbusConnect, dbusErrorMessage, dbusSystemBusAddress)
		std.time
	)

	// A connection to UPower for its listing and its sources' properties.
	internal type UPowerBus {
		internal calls   DBusConnection
		// Where the bus listens, for the connection that takes the notices.
		internal address string

		internal def new(calls DBusConnection, address string) {
			self.calls = calls
			self.address = address
		}

		// Every source UPower lists.
		//
		// Fails when UPower answers with an error.
		def sources() !PowerSource[] {
			let out PowerSource[]
			for let (_, path) in try devicePaths() {
				let props = properties(path) onerror (err error) {
					// Gone between the listing and the question.
					continue
				}
				out.push(upowerSource(path, props))
			}
			return out
		}

		// The object paths of UPower's devices.
		//
		// Fails when UPower answers with an error.
		def devicePaths() !string[] {
			let reply = try calls.callSync(UPOWER, UPOWER_PATH, UPOWER, "EnumerateDevices", "", [])
			fail "devices: UPower: {dbusErrorMessage(reply)}" when reply.kind == DBUS_ERROR
			let r = new DBusReader(reply.body)
			let out string[]
			let end = r.beginArray("o")
			for r.pos < end && !r.failed {
				out.push(r.readString())
			}
			return out
		}

		// A device's properties.
		//
		// Fails when UPower answers with an error, as it does for a device
		// that went away.
		def properties(path string) !map<string, any> {
			let w = new DBusWriter()
			w.putString(UPOWER_DEVICE)
			let reply = try calls.callSync(UPOWER, path, "org.freedesktop.DBus.Properties", "GetAll", "s", w.bytes())
			fail "devices: UPower: {dbusErrorMessage(reply)}" when reply.kind == DBUS_ERROR
			return dbusDictionary(new DBusReader(reply.body))
		}

		def close() {
			calls.close()
		}
	}

	// The sources UPower lists, none when UPower does not run.
	//
	// Fails when UPower answers with an error.
	internal def upowerList() !?PowerSource[] {
		let bus = upowerConnect()
		return none when bus is none
		let connection UPowerBus = bus
		defer connection.close()
		return connection.sources()
	}

	// UPower's changes, none when UPower does not run.
	internal def upowerFollow() ?Iterator<!PowerChange> {
		let bus = upowerConnect()
		return none when bus is none
		let connection UPowerBus = bus
		return upowerChanges(connection)
	}

	// A connection to UPower when the system bus has one; none when there
	// is no system bus or UPower does not run.
	internal def upowerConnect() ?UPowerBus {
		return upowerAt(dbusSystemBusAddress())
	}

	// A connection to UPower on the bus at an address, none when there is
	// no bus there or UPower does not run on it.
	internal def upowerAt(address string) ?UPowerBus {
		let reached = true
		let connection = dbusConnect(address) onerror (err error) {
			reached = false
			recover new DBusConnection(-1)
		}
		return none unless reached
		let w = new DBusWriter()
		w.putString(UPOWER)
		let reply = connection.callSync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner", "s", w.bytes()) onerror recover DBusMessage{kind: DBUS_ERROR}
		if reply.kind == DBUS_ERROR || !(new DBusReader(reply.body).readBool()) {
			connection.close()
			return none
		}
		return new UPowerBus(connection, address)
	}

	// The changes UPower announces, from its devices as they are now: a
	// second connection takes the notices (DeviceAdded, DeviceRemoved, and
	// PropertiesChanged, which carries the new values), the first asks for
	// a new device's properties.
	//
	// Fails when the notices cannot be asked for; the sequence fails, and
	// ends, when UPower or the bus goes away.
	internal def upowerChanges(bus UPowerBus) Iterator<!PowerChange> {
		defer bus.close()
		let signals = try dbusConnect(bus.address)
		defer signals.close()
		try signals.subscribe(UPOWER, "DeviceAdded", UPOWER)
		try signals.subscribe(UPOWER, "DeviceRemoved", UPOWER)
		try signals.subscribe("org.freedesktop.DBus.Properties", "PropertiesChanged", UPOWER)
		try signals.subscribe("org.freedesktop.DBus", "NameOwnerChanged", "org.freedesktop.DBus")
		let props = map<string, map<string, any>>{}
		let known = map<string, PowerSource>{}
		for let (_, path) in try bus.devicePaths() {
			let found = bus.properties(path) onerror (err error) {
				continue
			}
			props[path] = found
			known[path] = upowerSource(path, found)
		}
		for {
			let message = signals.readMessage(UPOWER_WAIT) onerror (err error) {
				fail err unless err.code == "ETIMEDOUT"
				recover DBusMessage{kind: 0}
			}
			continue unless message.kind == DBUS_SIGNAL
			let r = new DBusReader(message.body)
			match message.member {
				case "NameOwnerChanged":
					let name = r.readString()
					let _ = r.readString()
					let owner = r.readString()
					fail "devices: UPower stopped" when name == UPOWER && owner == ""
				case "DeviceAdded":
					let path = r.readString()
					let found = bus.properties(path) onerror (err error) {
						continue
					}
					props[path] = found
					let source = upowerSource(path, found)
					known[path] = source
					yield PowerChange{kind: PowerChangeKind.Added, source: source}
				case "DeviceRemoved":
					let path = r.readString()
					let last = known.get(path)
					continue when last is none
					let gone PowerSource = last
					known.delete(path)
					props.delete(path)
					yield PowerChange{kind: PowerChangeKind.Removed, source: gone}
				case "PropertiesChanged":
					continue unless r.readString() == UPOWER_DEVICE
					let held = props.get(message.path)
					continue when held is none
					let current map<string, any> = held
					for let (key, value) in dbusDictionary(r) {
						current[key] = value
					}
					let now = upowerSource(message.path, current)
					let before = known.get(message.path)
					known[message.path] = now
					if !(before is none) {
						let last PowerSource = before
						yield PowerChange{kind: PowerChangeKind.Changed, source: now} when powerChanged(last, now)
					}
			}
		}
	}

	// A source from UPower's properties of a device. The health, which
	// UPower does not report, comes from the kernel's supply of the same
	// name when there is one.
	internal def upowerSource(path string, p map<string, any>) PowerSource {
		let native = anyText(p.get("NativePath"))
		let kind = anyWhole(p.get("Type"))
		let leaf = path.split("/")
		let model = anyText(p.get("Model"))
		let source = PowerSource{
			id:         "power:" + (native != "" ?? (native, leaf[leaf.len() - 1])),
			kind:       kind == 1 ?? (PowerKind.Mains, kind == 3 ?? (PowerKind.Ups, PowerKind.Battery)),
			name:       model != "" ?? (model, native),
			vendor:     anyText(p.get("Vendor")),
			model:      model,
			serial:     anyText(p.get("Serial")),
			present:    p.hasKey("IsPresent") ?? (anyBool(p.get("IsPresent")), true),
			online:     anyBool(p.get("Online")),
			state:      upowerState(anyWhole(p.get("State"))),
			technology: upowerTechnology(anyWhole(p.get("Technology"))),
		}
		// A source that powers this machine, or the machine's own kinds, has no peripheral.
		let own = anyBool(p.get("PowerSupply")) || (kind := 1 || 2 || 3)
		source.peripheral = own ?? ("", upowerKindName(kind))
		// UPower gives 0 for what it does not know.
		source.charge = positive(scaled(anyNumber(p.get("Percentage")), 0.01))
		source.energy = positive(anyNumber(p.get("Energy")))
		source.energyFull = positive(anyNumber(p.get("EnergyFull")))
		source.energyFullDesign = positive(anyNumber(p.get("EnergyFullDesign")))
		source.power = positive(anyNumber(p.get("EnergyRate")))
		source.voltage = positive(anyNumber(p.get("Voltage")))
		source.timeToEmpty = seconds(anyNumber(p.get("TimeToEmpty")))
		source.timeToFull = seconds(anyNumber(p.get("TimeToFull")))
		source.capacity = positive(scaled(anyNumber(p.get("Capacity")), 0.01))
		source.temperature = positive(anyNumber(p.get("Temperature")))
		let cycles = anyWhole(p.get("ChargeCycles"))
		source.cycles = cycles when cycles > 0
		source.charge = none when source.kind == PowerKind.Mains
		if native != "" && !native.contains("/") {
			let raw = __fs_read_all("{POWER_SUPPLY_ROOT}/{native}/uevent") onerror recover byte[]
			let health = text(ueventProperties(string(raw)), "HEALTH")
			source.health = healthOf(health)
		}
		return source
	}

	// The values of a D-Bus `a{sv}` as plain values: numbers (`d` as a
	// float, the integer types as an int), booleans, strings and object
	// paths; values of other types are passed over.
	internal def dbusDictionary(r DBusReader) map<string, any> {
		let out = map<string, any>{}
		let end = r.beginArray("\{sv}")
		for r.pos < end && !r.failed {
			r.align(8)
			let key = r.readString()
			let signature = r.readVariant()
			match signature {
				case "d":
					out[key] = r.readDouble()
				case "x":
					out[key] = int(int64(r.readUint64()))
				case "t":
					out[key] = int(r.readUint64())
				case "u":
					out[key] = int(r.readUint32())
				case "i":
					out[key] = int(r.readInt32())
				case "b":
					out[key] = r.readBool()
				case "s", "o":
					out[key] = r.readString()
				case "y":
					out[key] = int(r.readByte())
				default:
					r.skip(signature)
			}
		}
		return out
	}

	// A whole number among plain values, 0 for anything else.
	internal def anyWhole(v ?any) int {
		let n = anyNumber(v)
		return 0 when n is none
		let f float = n
		return int(f)
	}

	// A value above 0, none for none or anything else.
	internal def positive(v ?float) ?float {
		return none when v is none
		let f float = v
		return none when f <= 0.0
		return f
	}

	// UPower's State.
	internal def upowerState(state int) ChargeState {
		match state {
			case 1:
				return ChargeState.Charging
			case 2:
				return ChargeState.Discharging
			case 3:
				return ChargeState.Empty
			case 4:
				return ChargeState.Full
			case 5, 6:
				return ChargeState.NotCharging
		}
		return ChargeState.Unknown
	}

	// UPower's Technology.
	internal def upowerTechnology(technology int) string {
		match technology {
			case 1:
				return "Li-ion"
			case 2:
				return "Li-poly"
			case 3:
				return "LiFePO4"
			case 4:
				return "lead acid"
			case 5:
				return "NiCd"
			case 6:
				return "NiMH"
		}
		return ""
	}

	// UPower's name for the kind of device a battery powers (UpDeviceKind
	// from 4).
	internal def upowerKindName(kind int) string {
		let names = ["monitor", "mouse", "keyboard", "pda", "phone", "media-player", "tablet", "computer", "gaming-input", "pen", "touchpad", "modem", "network", "headset", "speakers", "headphones", "video", "other-audio", "remote-control", "printer", "scanner", "camera", "wearable", "toy", "bluetooth-generic"]
		return kind >= 4 && kind - 4 < names.len() ?? (names[kind - 4], "device")
	}

	internal const UPOWER = "org.freedesktop.UPower"
	internal const UPOWER_PATH = "/org/freedesktop/UPower"
	internal const UPOWER_DEVICE = "org.freedesktop.UPower.Device"
	// How long a wait for a notice lasts before it starts again.
	internal const UPOWER_WAIT = 60s
}
