// UPower is a Linux desktop's: elsewhere it never runs, and the power
// sources come from the platform's own interfaces.
@os("darwin", "windows", "wasm")
partial module std.devices {
	// None: UPower does not run here. Does not fail.
	internal def upowerList() !?PowerSource[] {
		return none
	}

	// None: UPower does not run here.
	internal def upowerFollow() ?Iterator<!PowerChange> {
		return none
	}
}
