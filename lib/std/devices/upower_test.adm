@os("linux")
partial module std.devices {
	use (
		std.testing
		std.proto::(DBusReader, DBusWriter)
		std.devices.structs::*
	)

	// One `{sv}` entry of a dictionary: the key, the value's signature and
	// its bytes, aligned as D-Bus aligns them.
	internal def dictEntry(w DBusWriter, key string, signature string, value byte[], align int) {
		w.pad(8)
		w.putString(key)
		w.putSignature(signature)
		w.pad(align)
		w.putRaw(value)
	}

	// A D-Bus string's bytes.
	internal def dbusText(s string) byte[] {
		let t = new DBusWriter()
		t.putString(s)
		return t.bytes()
	}

	// A 32-bit value's bytes.
	internal def dbusU32(v int) byte[] {
		let b = zeroed(4)
		putU32(b, 0, v)
		return b
	}

	// A double's bytes.
	internal def dbusF64(v float) byte[] {
		let b = zeroed(8)
		putU64(b, 0, int64(__bitcast_u64_from_f64(v)))
		return b
	}

	// The `a\{sv}` UPower answers GetAll with, for a Bluetooth mouse's battery.
	internal def mouseProperties() byte[] {
		let w = new DBusWriter()
		w.putUint32(0)
		w.pad(8)
		dictEntry(w, "NativePath", "s", dbusText("/org/bluez/hci0/dev_DC_2C_26_01_02_03"), 4)
		dictEntry(w, "Vendor", "s", dbusText("Logitech"), 4)
		dictEntry(w, "Model", "s", dbusText("MX Anywhere 3"), 4)
		dictEntry(w, "Type", "u", dbusU32(5), 4)
		dictEntry(w, "PowerSupply", "b", dbusU32(0), 4)
		dictEntry(w, "State", "u", dbusU32(2), 4)
		dictEntry(w, "Percentage", "d", dbusF64(40.0), 8)
		dictEntry(w, "TimeToEmpty", "x", dbusF64(0.0), 8)
		dictEntry(w, "IsPresent", "b", dbusU32(1), 4)
		dictEntry(w, "ChargeCycles", "i", dbusU32(-1 & 0xFFFFFFFF), 4)
		// An empty array of doubles: its length, then the padding to its elements.
		w.pad(8)
		w.putString("Luminosity")
		w.putSignature("ad")
		w.pad(4)
		w.putUint32(0)
		w.pad(8)
		let out = w.bytes()
		putU32(out, 0, out.len() - 8)
		return out
	}

	check "UPower" {
		// UPower's properties of a mouse's battery: the dictionary read, the
		// mouse as the peripheral, UPower's unknowns (0, -1) as none, a value
		// of a type not read passed over.
		@test()
		def TestUPowerProperties() !none {
			let props = dbusDictionary(new DBusReader(mouseProperties()))
			assert props.len() == 10 && !props.hasKey("Luminosity")
			let mouse = upowerSource("/org/freedesktop/UPower/devices/mouse_dev_DC_2C_26_01_02_03", props)
			assert mouse.id == "power:/org/bluez/hci0/dev_DC_2C_26_01_02_03" && mouse.kind == PowerKind.Battery
			assert mouse.peripheral == "mouse" && mouse.name == "MX Anywhere 3" && mouse.vendor == "Logitech"
			assert mouse.state == ChargeState.Discharging && close(mouse.charge, 0.4) && mouse.present
			assert mouse.timeToEmpty is none && mouse.cycles is none && mouse.health == BatteryHealth.Unknown
			assert upowerState(5) == ChargeState.NotCharging && upowerTechnology(3) == "LiFePO4" && upowerKindName(12) == "gaming-input"
			return none
		}
	}
}
