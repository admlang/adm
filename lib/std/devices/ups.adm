// UPSs on raw HID: the USB HID Power Device class (usage pages 0x84 Power
// Device and 0x85 Battery System), read through their feature reports as
// the report descriptor lays them out.
partial module std.devices {
	use (
		std.services.devices::(Device)
		std.devices.structs::*
	)

	// One value a HID report carries, as the report descriptor lays it out.
	internal struct HidField {
		// HID_INPUT, HID_OUTPUT or HID_FEATURE.
		kind         int
		reportId     int
		// Where the value starts, in bits after the report id.
		bitOffset    int
		size         int
		// The usage page and usage of the value.
		page         int
		usage        int
		logicalMin   int
		logicalMax   int
		// The power of ten the value is scaled by, and its unit (HID 1.11
		// §6.2.2.7).
		unitExponent int
		unit         int
		// The main item's flags: bit 0 constant, bit 1 variable.
		flags        int
		// The usages (page << 16 | usage) of the collections it is in,
		// outermost first.
		path         int[]
	}

	// The values a HID report descriptor lays out (HID 1.11 §6.2.2): every
	// element of every Input, Output and Feature item with its report,
	// place, usage, range, unit and collections. Usages are taken in order,
	// the last repeating for the elements left; a usage range counts as its
	// usages; an extended usage (four bytes) carries its own page. Global
	// items, Push and Pop included, carry over from one main item to the
	// next; local items do not. A logical maximum written as a negative
	// number below the minimum (a device that meant 255 and wrote 0xFF) is
	// read unsigned.
	//
	// Fails when an item runs past the end, or a Pop has no Push.
	internal def parseHidDescriptor(d byte[]) !HidField[] {
		let out HidField[]
		let g = HidGlobals{}
		let stack HidGlobals[]
		let usages int[]
		let usageMin = -1
		let path int[]
		let offsets = map<int, int>{}
		let i = 0
		for i < d.len() {
			let prefix = int(d[i])
			if prefix == 0xFE {
				// A long item: its size, its tag, its data; none is defined.
				fail "devices: a HID long item runs past the descriptor" when i + 2 >= d.len()
				i += 3 + int(d[i + 1])
				continue
			}
			let size = prefix & 0x03
			size = 4 when size == 3
			fail "devices: a HID item at {i} runs past the descriptor" when i + 1 + size > d.len()
			let raw = 0
			for let b = 0; b < size; b++ {
				raw |= int(d[i + 1 + b]) << (8 * b)
			}
			let signed = size == 0 ?? (0, raw >= (1 << (8 * size - 1)) ?? (raw - (1 << (8 * size)), raw))
			let tag = prefix & 0xFC
			i += 1 + size
			match tag {
				// Main items.
				case 0x80, 0x90, 0xB0:
					let key = tag << 8 | g.reportId
					let had = offsets.get(key)
					let at = 0
					if !(had is none) {
						let n int = had
						at = n
					}
					let all = expandUsages(usages, usageMin)
					let max = g.logicalMax
					max = g.logicalMax & ((1 << (8 * g.maxSize)) - 1) when max < g.logicalMin && g.maxSize > 0
					for let e = 0; e < g.reportCount; e++ {
						let u = all.len() == 0 ?? (0, all[e.min(all.len() - 1)])
						out.push(HidField{kind: tag, reportId: g.reportId, bitOffset: at, size: g.reportSize, page: u >> 16, usage: u & 0xFFFF, logicalMin: g.logicalMin, logicalMax: max, unitExponent: g.unitExponent, unit: g.unit, flags: raw, path: path.clone()})
						at += g.reportSize
					}
					offsets[key] = at
					usages = []
					usageMin = -1
				case 0xA0:
					let all = expandUsages(usages, usageMin)
					path.push(all.len() == 0 ?? (0, all[0]))
					usages = []
					usageMin = -1
				case 0xC0:
					path.pop() when path.len() > 0
				// Global items.
				case 0x04:
					g.page = raw
				case 0x14:
					g.logicalMin = signed
				case 0x24:
					g.logicalMax = signed
					g.maxSize = size
				case 0x54:
					g.unitExponent = unitExponentOf(raw, size)
				case 0x64:
					g.unit = raw
				case 0x74:
					g.reportSize = raw
				case 0x84:
					g.reportId = raw
				case 0x94:
					g.reportCount = raw
				case 0xA4:
					// Structs are shared: the stack keeps a copy.
					stack.push(HidGlobals{...g})
				case 0xB4:
					fail "devices: a HID Pop without a Push" when stack.len() == 0
					g = stack.pop()
				// Local items.
				case 0x08:
					usages.push(size == 4 ?? (raw, g.page << 16 | raw))
				case 0x18:
					usageMin = size == 4 ?? (raw, g.page << 16 | raw)
				case 0x28:
					if usageMin >= 0 {
						let last = size == 4 ?? (raw, g.page << 16 | raw)
						for let u = usageMin; u <= last && u - usageMin < MAX_USAGE_RANGE; u++ {
							usages.push(u)
						}
						usageMin = -1
					}
			}
		}
		return out
	}

	// The global items in force.
	internal struct HidGlobals {
		page         int = 0
		logicalMin   int = 0
		logicalMax   int = 0
		// The bytes the logical maximum was written in.
		maxSize      int = 0
		unitExponent int = 0
		unit         int = 0
		reportSize   int = 0
		reportId     int = 0
		reportCount  int = 0
	}

	// The usages of a main item with their pages; a usage minimum without
	// its maximum counts as one usage.
	internal def expandUsages(usages int[], usageMin int) int[] {
		let out = usages.clone()
		out.push(usageMin) when usageMin >= 0
		return out
	}

	// A Unit Exponent item's power of ten: the specification's four-bit
	// two's complement (0xE is -2), or a whole signed byte (0xFE), as
	// devices write either.
	internal def unitExponentOf(raw int, size int) int {
		return raw - 16 when raw >= 8 && raw <= 15
		return raw - 256 when size == 1 && raw >= 0x80
		return raw
	}

	// A field's value in a report (the report id first when the report has
	// one): its bits, sign-extended when its logical range is signed; none
	// when the report is too short.
	internal def hidValue(report byte[], field HidField) ?int {
		let start = (field.reportId == 0 ?? (0, 8)) + field.bitOffset
		return none when field.size <= 0 || field.size > 32 || start + field.size > report.len() * 8
		let v = 0
		for let b = 0; b < field.size; b++ {
			let bit = start + b
			v |= ((int(report[bit / 8]) >> (bit % 8)) & 1) << b
		}
		v -= 1 << field.size when field.logicalMin < 0 && (v & (1 << (field.size - 1))) != 0
		return v
	}

	// What a UPS link answers: a feature report by id, at most length bytes
	// with the id first. HidDevice is one.
	internal interface UpsLink {
		def feature(reportId int, length int) !byte[]
	}

	// The UPSs among the raw HID devices this user may open: those whose
	// first collection is on the Power Device or Battery System page.
	internal def upsSources() PowerSource[] {
		let out PowerSource[]
		let all = hidDevices() onerror recover []
		for let (_, d) in all {
			continue unless d.usagePage := 0x84 || 0x85
			let hid = openHid(d.id) onerror (err error) {
				continue
			}
			let descriptor = hid.descriptor() onerror recover byte[]
			let fields = parseHidDescriptor(descriptor) onerror recover []
			out.push(upsSource(d, fields, hid))
			hid.close()
		}
		return out
	}

	// A UPS as its feature reports describe it.
	internal def upsSource(device Device, fields HidField[], link UpsLink) PowerSource {
		let reports = map<int, byte[]>{}
		let lengths = map<int, int>{}
		for let (_, f) in fields {
			continue unless f.kind == HID_FEATURE
			let end = (f.bitOffset + f.size + 7) / 8 + 1
			let had = lengths.get(f.reportId)
			let longest = 0
			if !(had is none) {
				let n int = had
				longest = n
			}
			lengths[f.reportId] = longest.max(end)
		}
		for let (id, length) in lengths {
			let got = link.feature(id, length) onerror (err error) {
				continue
			}
			reports[id] = got
		}
		let source = PowerSource{
			id:     "power:ups:" + device.id[7:],
			kind:   PowerKind.Ups,
			name:   device.name,
			vendor: device.vendor,
			model:  device.product,
			serial: device.serial,
		}
		// The capacity mode: 0 mAh, 1 mWh, 2 percent, 3 a flag.
		let percent = holdsValue(upsValue(fields, reports, PAGE_BATTERY, CAPACITY_MODE, true), 2.0)
		let remaining = upsValue(fields, reports, PAGE_BATTERY, REMAINING_CAPACITY)
		let full = upsValue(fields, reports, PAGE_BATTERY, FULL_CHARGE_CAPACITY)
		if percent {
			source.charge = scaled(remaining, 0.01)
		} else {
			source.charge = share(remaining, full)
		}
		let charge = source.charge
		if !(charge is none) {
			let c float = charge
			source.charge = c.max(0.0).min(1.0)
		}
		source.capacity = share(full, upsValue(fields, reports, PAGE_BATTERY, DESIGN_CAPACITY)) unless percent
		source.timeToEmpty = seconds(upsValue(fields, reports, PAGE_BATTERY, RUN_TIME_TO_EMPTY))
		source.voltage = upsValue(fields, reports, PAGE_POWER, VOLTAGE)
		let load = upsValue(fields, reports, PAGE_POWER, PERCENT_LOAD, true)
		source.load = scaled(load, 0.01)
		let cycles = upsValue(fields, reports, PAGE_BATTERY, CYCLE_COUNT, true)
		if !(cycles is none) {
			let c float = cycles
			source.cycles = int(c)
		}
		let ac = upsValue(fields, reports, PAGE_BATTERY, AC_PRESENT, true)
		let charging = flag(upsValue(fields, reports, PAGE_BATTERY, CHARGING, true))
		let discharging = flag(upsValue(fields, reports, PAGE_BATTERY, DISCHARGING, true))
		source.online = ac is none ?? (!discharging, flag(ac))
		source.state = charging ?? (ChargeState.Charging, discharging ?? (ChargeState.Discharging, ChargeState.Unknown))
		if source.state == ChargeState.Unknown && source.online {
			let atFull = flag(upsValue(fields, reports, PAGE_BATTERY, FULLY_CHARGED, true))
			let top = holdsValue(source.charge, 1.0)
			source.state = atFull || top ?? (ChargeState.Full, ChargeState.NotCharging)
		}
		source.health = BatteryHealth.Good
		source.health = BatteryHealth.Overheat when flag(upsValue(fields, reports, PAGE_POWER, OVER_TEMPERATURE, true))
		source.health = BatteryHealth.Failure when flag(upsValue(fields, reports, PAGE_POWER, INTERNAL_FAILURE, true))
		source.health = BatteryHealth.Replace when flag(upsValue(fields, reports, PAGE_BATTERY, NEED_REPLACEMENT, true))
		return source
	}

	// A usage's value among the reports read: the one in the Power Summary
	// collection when there is one, else the Battery collection's, else the
	// first. A quantity is scaled by its unit exponent and unit; a `raw`
	// one (a mode, a flag, a count, a percentage) is its logical value, as
	// descriptors often leave another field's unit in force over them.
	internal def upsValue(fields HidField[], reports map<int, byte[]>, page int, usage int, raw bool = false) ?float {
		let best ?HidField = none
		let rank = 99
		for let (_, f) in fields {
			continue unless f.kind == HID_FEATURE && f.page == page && f.usage == usage && reports.hasKey(f.reportId)
			let r = f.path.includes(POWER_SUMMARY) ?? (0, f.path.includes(BATTERY) ?? (1, 2))
			if r < rank {
				best = f
				rank = r
			}
		}
		return none when best is none
		let field HidField = best
		let report = reports.get(field.reportId)
		return none when report is none
		let bytes byte[] = report
		let found = hidValue(bytes, field)
		return none when found is none
		let v int = found
		return float(v) when raw
		return float(v) * 10.0 ** float(field.unitExponent + siExponent(field.unit))
	}

	// The power of ten that takes a value in a HID unit to SI units: HID's
	// SI linear system (§6.2.2.7) counts lengths in centimetres and masses in
	// grams, so a volt (kg m² s⁻³ A⁻¹) is 10⁷ of its units and a value with
	// unit exponent 7 is in volts. 0 for another system or no unit.
	internal def siExponent(unit int) int {
		return 0 unless (unit & 0xF) == 1
		let length = nibble(unit >> 4)
		let mass = nibble(unit >> 8)
		return -2 * length - 3 * mass
	}

	// A unit's four-bit signed exponent.
	internal def nibble(v int) int {
		let n = v & 0xF
		return n >= 8 ?? (n - 16, n)
	}

	// Whether a value is there and is the one given.
	internal def holdsValue(v ?float, want float) bool {
		return false when v is none
		let f float = v
		return f == want
	}

	// Whether a status value is set; false when it is not there.
	internal def flag(v ?float) bool {
		return false when v is none
		let f float = v
		return f != 0.0
	}

	// HID main item tags.
	internal const HID_INPUT = 0x80
	internal const HID_OUTPUT = 0x90
	internal const HID_FEATURE = 0xB0
	// The most usages a usage range expands to.
	internal const MAX_USAGE_RANGE = 1024

	// The usage pages and usages read (USB HID Usage Tables, Power Device
	// 0x84 and Battery System 0x85).
	internal const PAGE_POWER = 0x84
	internal const PAGE_BATTERY = 0x85
	internal const POWER_SUMMARY = 0x840024
	internal const BATTERY = 0x840012
	internal const VOLTAGE = 0x30
	internal const PERCENT_LOAD = 0x35
	internal const INTERNAL_FAILURE = 0x62
	internal const OVER_TEMPERATURE = 0x67
	internal const CAPACITY_MODE = 0x2C
	internal const CHARGING = 0x44
	internal const DISCHARGING = 0x45
	internal const FULLY_CHARGED = 0x46
	internal const NEED_REPLACEMENT = 0x4B
	internal const REMAINING_CAPACITY = 0x66
	internal const FULL_CHARGE_CAPACITY = 0x67
	internal const RUN_TIME_TO_EMPTY = 0x68
	internal const CYCLE_COUNT = 0x6B
	internal const DESIGN_CAPACITY = 0x83
	internal const AC_PRESENT = 0xD0
}
