internal partial module std.devices.v4l2 {
	use (
		std.services.storage::(MapAccess, Storage)
		std.devices::*
		std.devices.structs::*
	)

	// Video for Linux 2, the kernel interface every webcam on Linux speaks.
	//
	// The driver is driven entirely through `Storage.control`, which carries one
	// structure in and the driver's answer back out, so each structure below is
	// laid out by hand in a `byte[]`: a field is read with `u32` and written with
	// `putU32` at the offset its constant names.
	//
	// **These numbers describe 64-bit Linux.** The sizes are the ones the kernel
	// headers give on a 64-bit machine, and a request number embeds the size of
	// the structure it carries, so both change with the architecture. Another
	// architecture adds its own table beside this one rather than editing these.

	// --- v4l2_capability: what the device can do (104 bytes) --------------------
	//
	//     driver        0   16 bytes   name of the kernel module
	//     card         16   32 bytes   name of the device
	//     bus_info     48   32 bytes   where it hangs
	//     version      80    4 bytes
	//     capabilities 84    4 bytes   what the driver as a whole offers
	//     device_caps  88    4 bytes   what this node offers, when the flag says so
	const CAPABILITY_SIZE = 104
	const CAPABILITY_CARD = 16
	const CAPABILITY_CARD_LENGTH = 32
	const CAPABILITY_CAPABILITIES = 84
	const CAPABILITY_DEVICE_CAPS = 88

	// The capability bits this module reads: the node delivers images, it can
	// stream them, and its own `device_caps` is the field to believe.
	const CAP_VIDEO_CAPTURE = 0x00000001
	const CAP_STREAMING = 0x04000000
	const CAP_DEVICE_CAPS = 0x80000000

	// --- v4l2_format: the frame layout (208 bytes) ------------------------------
	//
	// `fmt` is a union of one layout per buffer type, starting at 8; the capture
	// member is `fmt.pix` (`v4l2_pix_format`, 48 bytes), so its fields are given
	// here as offsets from the start of the whole structure.
	//
	//     type          0    4 bytes   buffer type
	//     fmt.pix.width         8
	//     fmt.pix.height       12
	//     fmt.pix.pixelformat  16      four character codes, little-endian
	//     fmt.pix.field        20
	//     fmt.pix.bytesperline 24      bytes from one row of the first plane to the next
	//     fmt.pix.sizeimage    28      how large a frame can get
	const FORMAT_SIZE = 208
	const FORMAT_TYPE = 0
	const FORMAT_WIDTH = 8
	const FORMAT_HEIGHT = 12
	const FORMAT_PIXELFORMAT = 16
	const FORMAT_FIELD = 20
	const FORMAT_BYTESPERLINE = 24
	const FORMAT_SIZEIMAGE = 28

	// --- v4l2_requestbuffers: ask for buffers (20 bytes) ------------------------
	//
	//     count         0    4 bytes   asked for going in, granted coming back
	//     type          4    4 bytes
	//     memory        8    4 bytes
	//     capabilities 12    4 bytes
	//     flags        16    1 byte, then 3 reserved
	const REQUESTBUFFERS_SIZE = 20
	const REQUESTBUFFERS_COUNT = 0
	const REQUESTBUFFERS_TYPE = 4
	const REQUESTBUFFERS_MEMORY = 8

	// --- v4l2_buffer: one buffer in the queue (88 bytes) ------------------------
	//
	//     index         0    4 bytes
	//     type          4    4 bytes
	//     bytesused     8    4 bytes   how much of the buffer the frame fills
	//     flags        12    4 bytes
	//     field        16    4 bytes
	//     timestamp    24   16 bytes   seconds and microseconds, 8 bytes each
	//     timecode     40   16 bytes
	//     sequence     56    4 bytes   the driver's own frame counter
	//     memory       60    4 bytes
	//     m.offset     64    4 bytes   union member: where to map the buffer from
	//     length       72    4 bytes   how large the buffer is
	const BUFFER_SIZE = 88
	const BUFFER_INDEX = 0
	const BUFFER_TYPE = 4
	const BUFFER_BYTESUSED = 8
	const BUFFER_SEQUENCE = 56
	const BUFFER_MEMORY = 60
	const BUFFER_OFFSET = 64
	const BUFFER_LENGTH = 72

	// The buffer type a webcam captures on, and the memory model this module
	// uses: the driver's own buffers, mapped into the process.
	const BUF_TYPE_VIDEO_CAPTURE = 1
	const MEMORY_MMAP = 1
	// Let the driver pick how the lines are interlaced; a webcam has one field.
	const FIELD_ANY = 0

	// The pixel formats this module understands, as the four character codes the
	// kernel spells them with, read little-endian: "MJPG" (and "JPEG", which some
	// drivers name the same frames by), "YUYV", "UYVY", "NV12", "YU12" (planar
	// 4:2:0) and "GREY".
	const PIX_FMT_MJPEG = 0x47504A4D
	const PIX_FMT_JPEG = 0x4745504A
	const PIX_FMT_YUYV = 0x56595559
	const PIX_FMT_UYVY = 0x59565955
	const PIX_FMT_NV12 = 0x3231564E
	const PIX_FMT_YUV420 = 0x32315559
	const PIX_FMT_GREY = 0x59455247

	// --- v4l2_fmtdesc: one pixel format the device offers (64 bytes) ------------
	//
	//     index         0    4 bytes   which one, from 0
	//     type          4    4 bytes
	//     flags         8    4 bytes
	//     description  12   32 bytes
	//     pixelformat  44    4 bytes
	const FMTDESC_SIZE = 64
	const FMTDESC_INDEX = 0
	const FMTDESC_TYPE = 4
	const FMTDESC_PIXELFORMAT = 44

	// --- v4l2_frmsizeenum: one frame size of a format (44 bytes) ----------------
	//
	//     index         0    4 bytes
	//     pixel_format  4    4 bytes
	//     type          8    4 bytes   discrete, continuous or stepwise
	//     discrete     12    width, height
	//     stepwise     12    min_width, max_width, step_width, min_height, max_height, step_height
	const FRMSIZE_SIZE = 44
	const FRMSIZE_INDEX = 0
	const FRMSIZE_PIXELFORMAT = 4
	const FRMSIZE_TYPE = 8
	const FRMSIZE_WIDTH = 12
	const FRMSIZE_HEIGHT = 16
	const FRMSIZE_MIN_WIDTH = 12
	const FRMSIZE_MAX_WIDTH = 16
	const FRMSIZE_MIN_HEIGHT = 24
	const FRMSIZE_MAX_HEIGHT = 28

	// --- v4l2_frmivalenum: one frame interval of a size (52 bytes) --------------
	//
	//     index         0    4 bytes
	//     pixel_format  4    4 bytes
	//     width         8    4 bytes
	//     height       12    4 bytes
	//     type         16    4 bytes   discrete, continuous or stepwise
	//     discrete     20    numerator, denominator: seconds a frame
	//     stepwise     20    min, then max at 28, then step at 36, each a fraction
	const FRMIVAL_SIZE = 52
	const FRMIVAL_INDEX = 0
	const FRMIVAL_PIXELFORMAT = 4
	const FRMIVAL_WIDTH = 8
	const FRMIVAL_HEIGHT = 12
	const FRMIVAL_TYPE = 16
	const FRMIVAL_NUMERATOR = 20
	const FRMIVAL_DENOMINATOR = 24
	const FRMIVAL_MAX_NUMERATOR = 28
	const FRMIVAL_MAX_DENOMINATOR = 32

	// The kinds of v4l2_frmsizeenum and v4l2_frmivalenum answer: a list, a
	// range of any value, a range in steps.
	const FRMTYPE_DISCRETE = 1

	// --- v4l2_streamparm: the capture's frame interval (204 bytes) --------------
	//
	//     type                      0   4 bytes
	//     parm.capture.capability   4   4 bytes   CAP_TIMEPERFRAME when the interval can be set
	//     parm.capture.capturemode  8   4 bytes
	//     parm.capture.timeperframe 12  numerator, denominator: seconds a frame
	const STREAMPARM_SIZE = 204
	const STREAMPARM_TYPE = 0
	const STREAMPARM_CAPABILITY = 4
	const STREAMPARM_NUMERATOR = 12
	const STREAMPARM_DENOMINATOR = 16
	const CAP_TIMEPERFRAME = 0x1000

	// --- v4l2_queryctrl: one control of the device (68 bytes) -------------------
	//
	//     id             0   4 bytes   with CTRL_FLAG_NEXT_CTRL: the one after it
	//     type           4   4 bytes
	//     name           8  32 bytes
	//     minimum       40   4 bytes, signed
	//     maximum       44   4 bytes, signed
	//     step          48   4 bytes, signed
	//     default_value 52   4 bytes, signed
	//     flags         56   4 bytes
	const QUERYCTRL_SIZE = 68
	const QUERYCTRL_ID = 0
	const QUERYCTRL_TYPE = 4
	const QUERYCTRL_NAME = 8
	const QUERYCTRL_NAME_LENGTH = 32
	const QUERYCTRL_MINIMUM = 40
	const QUERYCTRL_MAXIMUM = 44
	const QUERYCTRL_STEP = 48
	const QUERYCTRL_DEFAULT = 52
	const QUERYCTRL_FLAGS = 56

	// Control types (enum v4l2_ctrl_type) and flags.
	const CTRL_TYPE_INTEGER = 1
	const CTRL_TYPE_BOOLEAN = 2
	const CTRL_TYPE_MENU = 3
	const CTRL_TYPE_BUTTON = 4
	const CTRL_TYPE_BITMASK = 8
	const CTRL_TYPE_INTEGER_MENU = 9
	const CTRL_FLAG_DISABLED = 0x0001
	const CTRL_FLAG_GRABBED = 0x0002
	const CTRL_FLAG_READ_ONLY = 0x0004
	const CTRL_FLAG_INACTIVE = 0x0010
	const CTRL_FLAG_WRITE_ONLY = 0x0040
	const CTRL_FLAG_NEXT_CTRL = 0x80000000

	// --- v4l2_querymenu: one choice of a menu control (44 bytes, packed) --------
	//
	//     id     0   4 bytes
	//     index  4   4 bytes
	//     name   8  32 bytes, or for an integer menu the value, 8 bytes signed
	const QUERYMENU_SIZE = 44
	const QUERYMENU_ID = 0
	const QUERYMENU_INDEX = 4
	const QUERYMENU_NAME = 8
	const QUERYMENU_NAME_LENGTH = 32

	// --- v4l2_control: a control's value (8 bytes) ------------------------------
	//
	//     id     0   4 bytes
	//     value  4   4 bytes, signed
	const CONTROL_SIZE = 8
	const CONTROL_ID = 0
	const CONTROL_VALUE = 4

	// --- request numbers --------------------------------------------------------
	//
	// A request number encodes the direction, the structure's size and the
	// driver's own command number, so these belong to the structures above and to
	// 64-bit Linux. The kernel calls them `_IOR`, `_IOW` and `_IOWR` numbers; they
	// are 32-bit unsigned values, held here in an `int`.
	const VIDIOC_QUERYCAP = 0x80685600
	const VIDIOC_G_FMT = 0xC0D05604
	const VIDIOC_S_FMT = 0xC0D05605
	const VIDIOC_REQBUFS = 0xC0145608
	const VIDIOC_QUERYBUF = 0xC0585609
	const VIDIOC_QBUF = 0xC058560F
	const VIDIOC_DQBUF = 0xC0585611
	const VIDIOC_STREAMON = 0x40045612
	const VIDIOC_STREAMOFF = 0x40045613
	const VIDIOC_ENUM_FMT = 0xC0405602
	const VIDIOC_G_PARM = 0xC0CC5615
	const VIDIOC_S_PARM = 0xC0CC5616
	const VIDIOC_G_CTRL = 0xC008561B
	const VIDIOC_S_CTRL = 0xC008561C
	const VIDIOC_QUERYCTRL = 0xC0445624
	const VIDIOC_QUERYMENU = 0xC02C5625
	const VIDIOC_ENUM_FRAMESIZES = 0xC02C564A
	const VIDIOC_ENUM_FRAMEINTERVALS = 0xC034564B

	// --- structure codecs -------------------------------------------------------

	// What a device reports about itself.
	struct Capability {
		// Name of the device, as the driver spells it.
		card         string
		// What the driver as a whole offers.
		capabilities int
		// What this node offers; only meaningful when `capabilities` has CAP_DEVICE_CAPS.
		deviceCaps   int
	}

	// The frame layout: the size and pixel format of what the device delivers.
	struct Format {
		width        int
		height       int
		// The four character code of the pixel format, one of the PIX_FMT_ constants.
		pixelFormat  int
		// Bytes from one row of the first plane to the next; 0 for a compressed format.
		bytesPerLine int
		// The largest a frame gets, as the driver sizes its buffers.
		sizeImage    int
	}

	// One buffer of the driver's queue.
	struct BufferInfo {
		index     int
		// How much of the buffer the frame fills; 0 before the buffer is dequeued.
		bytesUsed int
		// Where the buffer is mapped from, its offset in the device.
		offset    int
		// How large the buffer is.
		length    int
		// The driver's own frame counter.
		sequence  int
	}

	// The text of a fixed-width character field, which the driver pads with zero
	// bytes.
	def fixedText(buf byte[], offset int, length int) string {
		return "" when offset < 0 || offset + length > buf.len()
		let end = offset
		for let i = offset; i < offset + length; i++ {
			break when buf[i] == 0
			end = i + 1
		}
		return string(buf[offset:end])
	}

	// Reads a v4l2_capability the driver answered with.
	def decodeCapability(buf byte[]) Capability {
		return Capability{
			card:         fixedText(buf, CAPABILITY_CARD, CAPABILITY_CARD_LENGTH),
			capabilities: u32(buf, CAPABILITY_CAPABILITIES),
			deviceCaps:   u32(buf, CAPABILITY_DEVICE_CAPS),
		}
	}

	// What this node offers: its own capabilities when the driver reports them
	// separately, otherwise the driver's.
	def nodeCapabilities(cap Capability) int {
		return cap.deviceCaps when (cap.capabilities & CAP_DEVICE_CAPS) != 0
		return cap.capabilities
	}

	// Lays out a v4l2_format asking for that frame layout on the capture queue.
	def encodeFormat(format Format) byte[] {
		let buf = zeroed(FORMAT_SIZE)
		putU32(buf, FORMAT_TYPE, BUF_TYPE_VIDEO_CAPTURE)
		putU32(buf, FORMAT_WIDTH, format.width)
		putU32(buf, FORMAT_HEIGHT, format.height)
		putU32(buf, FORMAT_PIXELFORMAT, format.pixelFormat)
		putU32(buf, FORMAT_FIELD, FIELD_ANY)
		putU32(buf, FORMAT_SIZEIMAGE, format.sizeImage)
		return buf
	}

	// Reads the frame layout out of a v4l2_format the driver answered with.
	def decodeFormat(buf byte[]) Format {
		return Format{
			width:        u32(buf, FORMAT_WIDTH),
			height:       u32(buf, FORMAT_HEIGHT),
			pixelFormat:  u32(buf, FORMAT_PIXELFORMAT),
			bytesPerLine: u32(buf, FORMAT_BYTESPERLINE),
			sizeImage:    u32(buf, FORMAT_SIZEIMAGE),
		}
	}

	// Lays out a v4l2_requestbuffers asking for `count` mapped capture buffers.
	def encodeRequestBuffers(count int) byte[] {
		let buf = zeroed(REQUESTBUFFERS_SIZE)
		putU32(buf, REQUESTBUFFERS_COUNT, count)
		putU32(buf, REQUESTBUFFERS_TYPE, BUF_TYPE_VIDEO_CAPTURE)
		putU32(buf, REQUESTBUFFERS_MEMORY, MEMORY_MMAP)
		return buf
	}

	// How many buffers the driver granted, which can be fewer than were asked for.
	def decodeRequestBuffers(buf byte[]) int {
		return u32(buf, REQUESTBUFFERS_COUNT)
	}

	// Lays out a v4l2_buffer naming one buffer of the capture queue.
	def encodeBuffer(index int) byte[] {
		let buf = zeroed(BUFFER_SIZE)
		putU32(buf, BUFFER_INDEX, index)
		putU32(buf, BUFFER_TYPE, BUF_TYPE_VIDEO_CAPTURE)
		putU32(buf, BUFFER_MEMORY, MEMORY_MMAP)
		return buf
	}

	// Reads a v4l2_buffer the driver answered with.
	def decodeBuffer(buf byte[]) BufferInfo {
		return BufferInfo{
			index:     u32(buf, BUFFER_INDEX),
			bytesUsed: u32(buf, BUFFER_BYTESUSED),
			offset:    u32(buf, BUFFER_OFFSET),
			length:    u32(buf, BUFFER_LENGTH),
			sequence:  u32(buf, BUFFER_SEQUENCE),
		}
	}

	// The four bytes STREAMON and STREAMOFF take: the buffer type to start or
	// stop.
	def encodeBufferType() byte[] {
		let buf = zeroed(4)
		putU32(buf, 0, BUF_TYPE_VIDEO_CAPTURE)
		return buf
	}

	// --- the driver conversation ------------------------------------------------

	// What the device behind the descriptor reports about itself.
	//
	// Fails when the descriptor is not a video device.
	def queryCapabilities(fd int) !Capability {
		let answer = zeroed(CAPABILITY_SIZE)
		try Storage.control(fd, VIDIOC_QUERYCAP, answer)
		return decodeCapability(answer)
	}

	// The frame layout the device is set to right now, which is the only way to
	// learn the size it defaults to.
	//
	// Fails when the device refuses to report it.
	def currentFormat(fd int) !Format {
		let answer = encodeFormat(Format{})
		try Storage.control(fd, VIDIOC_G_FMT, answer)
		return decodeFormat(answer)
	}

	// Asks the device for that frame layout and returns the one it settled on.
	// A device substitutes a layout it supports instead of refusing, so the
	// answer is what came back, never what went in.
	//
	// Fails when the device refuses the request.
	def setFormat(fd int, want Format) !Format {
		let answer = encodeFormat(want)
		try Storage.control(fd, VIDIOC_S_FMT, answer)
		return decodeFormat(answer)
	}

	// Asks the device for `count` mapped buffers and returns how many it granted.
	//
	// Fails when the device does not stream from its own buffers.
	def requestBuffers(fd int, count int) !int {
		let answer = encodeRequestBuffers(count)
		try Storage.control(fd, VIDIOC_REQBUFS, answer)
		return decodeRequestBuffers(answer)
	}

	// Where one of the granted buffers lives and how large it is.
	//
	// Fails when there is no buffer with that index.
	def queryBuffer(fd int, index int) !BufferInfo {
		let answer = encodeBuffer(index)
		try Storage.control(fd, VIDIOC_QUERYBUF, answer)
		return decodeBuffer(answer)
	}

	// Hands a buffer back to the device to be filled.
	//
	// Fails when the device refuses it.
	def queueBuffer(fd int, index int) !none {
		try Storage.control(fd, VIDIOC_QBUF, encodeBuffer(index))
		return none
	}

	// Takes the buffer the device has filled out of the queue.
	//
	// Fails when no buffer is ready or the device errored.
	def dequeueBuffer(fd int) !BufferInfo {
		let request = zeroed(BUFFER_SIZE)
		putU32(request, BUFFER_TYPE, BUF_TYPE_VIDEO_CAPTURE)
		putU32(request, BUFFER_MEMORY, MEMORY_MMAP)
		try Storage.control(fd, VIDIOC_DQBUF, request)
		return decodeBuffer(request)
	}

	// Starts the device filling the queued buffers.
	//
	// Fails when the device refuses to stream.
	def streamOn(fd int) !none {
		try Storage.control(fd, VIDIOC_STREAMON, encodeBufferType())
		return none
	}

	// Stops the device and drops whatever is still queued.
	//
	// Fails when the device refuses.
	def streamOff(fd int) !none {
		try Storage.control(fd, VIDIOC_STREAMOFF, encodeBufferType())
		return none
	}

	// Maps every granted buffer into the process and queues it, and returns the
	// mapping handles in buffer order.
	//
	// Fails when a buffer cannot be located, mapped or queued; the mappings made
	// so far are released before the failure is reported.
	def mapBuffers(fd int, count int) !int[] {
		let handles int[]
		for let i = 0; i < count; i++ {
			let handle = mapOneBuffer(fd, i) onerror (err error) {
				releaseMappings(handles)
				fail err
			}
			handles.push(handle)
		}
		return handles
	}

	// Locates, maps and queues one buffer, and returns its mapping handle.
	//
	// Fails when the buffer cannot be located, mapped or queued.
	def mapOneBuffer(fd int, index int) !int {
		let info = try queryBuffer(fd, index)
		let handle = try Storage.mmap(fd, info.offset, info.length, MapAccess.ReadWrite)
		try queueBuffer(fd, index)
		return handle
	}

	// Releases mappings, ignoring the ones already gone. Used while unwinding a
	// failed open and when a camera closes.
	def releaseMappings(handles int[]) {
		for let (_, handle) in handles {
			Storage.munmap(handle) onerror recover none
		}
	}

	// Gives the driver's buffers back, which it requires before the frame
	// layout changes; the mappings must be gone first.
	//
	// Fails when the device refuses.
	def freeBuffers(fd int) !none {
		try Storage.control(fd, VIDIOC_REQBUFS, encodeRequestBuffers(0))
		return none
	}

	// --- what the device offers ---------------------------------------------------

	// One frame size a format comes in, with the frame rates it runs at.
	struct SizeRates {
		width  int
		height int
		// Frames a second, fastest first.
		rates  float[]
	}

	// The four character codes of the capture formats the device offers, in
	// the driver's order.
	def enumFormats(fd int) int[] {
		let out int[]
		for let index = 0; index < ENUM_LIMIT; index++ {
			let buf = zeroed(FMTDESC_SIZE)
			putU32(buf, FMTDESC_INDEX, index)
			putU32(buf, FMTDESC_TYPE, BUF_TYPE_VIDEO_CAPTURE)
			// The driver answers EINVAL past the last one.
			let failed = false
			Storage.control(fd, VIDIOC_ENUM_FMT, buf) onerror (err error) {
				failed = true
				recover 0
			}
			break when failed
			out.push(u32(buf, FMTDESC_PIXELFORMAT))
		}
		return out
	}

	// The frame sizes of a format with their rates. A device that takes any
	// size in a range (continuous or stepwise) reports the smallest and the
	// largest.
	def enumSizes(fd int, pixelFormat int) SizeRates[] {
		let out SizeRates[]
		for let index = 0; index < ENUM_LIMIT; index++ {
			let buf = zeroed(FRMSIZE_SIZE)
			putU32(buf, FRMSIZE_INDEX, index)
			putU32(buf, FRMSIZE_PIXELFORMAT, pixelFormat)
			let failed = false
			Storage.control(fd, VIDIOC_ENUM_FRAMESIZES, buf) onerror (err error) {
				failed = true
				recover 0
			}
			break when failed
			if u32(buf, FRMSIZE_TYPE) == FRMTYPE_DISCRETE {
				let w = u32(buf, FRMSIZE_WIDTH)
				let h = u32(buf, FRMSIZE_HEIGHT)
				out.push(SizeRates{width: w, height: h, rates: enumRates(fd, pixelFormat, w, h)})
				continue
			}
			// A range is one answer, at index 0.
			let minW = u32(buf, FRMSIZE_MIN_WIDTH)
			let minH = u32(buf, FRMSIZE_MIN_HEIGHT)
			let maxW = u32(buf, FRMSIZE_MAX_WIDTH)
			let maxH = u32(buf, FRMSIZE_MAX_HEIGHT)
			out.push(SizeRates{width: minW, height: minH, rates: enumRates(fd, pixelFormat, minW, minH)})
			out.push(SizeRates{width: maxW, height: maxH, rates: enumRates(fd, pixelFormat, maxW, maxH)}) unless maxW == minW && maxH == minH
			break
		}
		return out
	}

	// The frame rates a format runs at at one size, fastest first; for a range
	// the fastest and the slowest.
	def enumRates(fd int, pixelFormat int, width int, height int) float[] {
		let out float[]
		for let index = 0; index < ENUM_LIMIT; index++ {
			let buf = zeroed(FRMIVAL_SIZE)
			putU32(buf, FRMIVAL_INDEX, index)
			putU32(buf, FRMIVAL_PIXELFORMAT, pixelFormat)
			putU32(buf, FRMIVAL_WIDTH, width)
			putU32(buf, FRMIVAL_HEIGHT, height)
			let failed = false
			Storage.control(fd, VIDIOC_ENUM_FRAMEINTERVALS, buf) onerror (err error) {
				failed = true
				recover 0
			}
			break when failed
			let rate = framesPerSecond(u32(buf, FRMIVAL_NUMERATOR), u32(buf, FRMIVAL_DENOMINATOR))
			out.push(rate) when rate > 0.0
			if u32(buf, FRMIVAL_TYPE) != FRMTYPE_DISCRETE {
				// The range's other end: the longest interval, the slowest rate.
				let slowest = framesPerSecond(u32(buf, FRMIVAL_MAX_NUMERATOR), u32(buf, FRMIVAL_MAX_DENOMINATOR))
				out.push(slowest) when slowest > 0.0 && slowest != rate
				break
			}
		}
		return out.sort((a, b) => a > b)
	}

	// The rate a frame interval of numerator/denominator seconds gives; 0 for
	// an interval the driver left empty.
	def framesPerSecond(numerator int, denominator int) float {
		return 0.0 when numerator <= 0 || denominator <= 0
		return float(denominator) / float(numerator)
	}

	// How many answers an enumeration takes at most: a guard against a driver
	// that never says it is done.
	const ENUM_LIMIT = 256

	// --- the frame rate -------------------------------------------------------------

	// The capture's frame rate, frames a second; 0 when the driver does not
	// report one.
	def currentRate(fd int) float {
		let buf = zeroed(STREAMPARM_SIZE)
		putU32(buf, STREAMPARM_TYPE, BUF_TYPE_VIDEO_CAPTURE)
		Storage.control(fd, VIDIOC_G_PARM, buf) onerror recover 0
		return framesPerSecond(u32(buf, STREAMPARM_NUMERATOR), u32(buf, STREAMPARM_DENOMINATOR))
	}

	// Asks for a frame rate and returns the one the driver settled on, which
	// is the nearest it runs at the current size and format.
	//
	// Fails when the device's rate cannot be set, or it refuses.
	def setRate(fd int, rate float) !float {
		let buf = zeroed(STREAMPARM_SIZE)
		putU32(buf, STREAMPARM_TYPE, BUF_TYPE_VIDEO_CAPTURE)
		try Storage.control(fd, VIDIOC_G_PARM, buf)
		fail "devices: the camera's frame rate cannot be set" when (u32(buf, STREAMPARM_CAPABILITY) & CAP_TIMEPERFRAME) == 0
		// The interval as a fraction of a second, to a thousandth of a frame.
		putU32(buf, STREAMPARM_NUMERATOR, 1000)
		putU32(buf, STREAMPARM_DENOMINATOR, int(rate * 1000.0 + 0.5))
		try Storage.control(fd, VIDIOC_S_PARM, buf)
		return framesPerSecond(u32(buf, STREAMPARM_NUMERATOR), u32(buf, STREAMPARM_DENOMINATOR))
	}

	// --- controls ---------------------------------------------------------------------

	// A control as the driver describes it.
	struct ControlInfo {
		id      int
		kind    int
		name    string
		minimum int
		maximum int
		step    int
		initial int
		flags   int
		// The names of a menu control's choices by value; empty otherwise.
		choices map<int, string>
	}

	// The controls the device has whose values a program reads and writes
	// as 32-bit numbers: integers, switches, menus, buttons and bit masks.
	// Disabled controls and the class headings are left out, and so are
	// 64-bit, string and compound controls, which only the extended control
	// requests carry.
	def queryControls(fd int) ControlInfo[] {
		let out ControlInfo[]
		let id = 0
		for let count = 0; count < CONTROL_LIMIT; count++ {
			let buf = zeroed(QUERYCTRL_SIZE)
			putU32(buf, QUERYCTRL_ID, id | CTRL_FLAG_NEXT_CTRL)
			let failed = false
			Storage.control(fd, VIDIOC_QUERYCTRL, buf) onerror (err error) {
				failed = true
				recover 0
			}
			break when failed
			id = u32(buf, QUERYCTRL_ID)
			let kind = u32(buf, QUERYCTRL_TYPE)
			let flags = u32(buf, QUERYCTRL_FLAGS)
			continue when (flags & CTRL_FLAG_DISABLED) != 0
			continue unless kind := CTRL_TYPE_INTEGER || CTRL_TYPE_BOOLEAN || CTRL_TYPE_MENU || CTRL_TYPE_BUTTON || CTRL_TYPE_BITMASK || CTRL_TYPE_INTEGER_MENU
			let info = ControlInfo{
				id:      id,
				kind:    kind,
				name:    fixedText(buf, QUERYCTRL_NAME, QUERYCTRL_NAME_LENGTH),
				minimum: s32(buf, QUERYCTRL_MINIMUM),
				maximum: s32(buf, QUERYCTRL_MAXIMUM),
				step:    s32(buf, QUERYCTRL_STEP),
				initial: s32(buf, QUERYCTRL_DEFAULT),
				flags:   flags,
				choices: map<int, string>{},
			}
			info.choices = queryMenu(fd, id, info.minimum, info.maximum, kind == CTRL_TYPE_INTEGER_MENU) when kind := CTRL_TYPE_MENU || CTRL_TYPE_INTEGER_MENU
			out.push(info)
		}
		return out
	}

	// The choices of a menu control by value; an index the driver skips is
	// not a choice. An integer menu's choices are named by their numbers.
	def queryMenu(fd int, id int, minimum int, maximum int, numbers bool) map<int, string> {
		let out = map<int, string>{}
		for let index = minimum.max(0); index <= maximum && index - minimum < CONTROL_LIMIT; index++ {
			let buf = zeroed(QUERYMENU_SIZE)
			putU32(buf, QUERYMENU_ID, id)
			putU32(buf, QUERYMENU_INDEX, index)
			let failed = false
			Storage.control(fd, VIDIOC_QUERYMENU, buf) onerror (err error) {
				failed = true
				recover 0
			}
			continue when failed
			if numbers {
				let low = u32(buf, QUERYMENU_NAME)
				let high = s32(buf, QUERYMENU_NAME + 4)
				out[index] = "{(high << 32) | low}"
			} else {
				out[index] = fixedText(buf, QUERYMENU_NAME, QUERYMENU_NAME_LENGTH)
			}
		}
		return out
	}

	// How many controls and menu choices are read at most.
	const CONTROL_LIMIT = 1024

	// A control's value.
	//
	// Fails when the device has no such control or it cannot be read.
	def getControl(fd int, id int) !int {
		let buf = zeroed(CONTROL_SIZE)
		putU32(buf, CONTROL_ID, id)
		try Storage.control(fd, VIDIOC_G_CTRL, buf)
		return s32(buf, CONTROL_VALUE)
	}

	// Sets a control and returns the value the driver kept, which it may
	// have rounded to the control's step.
	//
	// Fails when the device has no such control, the value is outside its
	// range, or the control is read-only or held by another program.
	def setControl(fd int, id int, value int) !int {
		let buf = zeroed(CONTROL_SIZE)
		putU32(buf, CONTROL_ID, id)
		putU32(buf, CONTROL_VALUE, value & 0xFFFFFFFF)
		try Storage.control(fd, VIDIOC_S_CTRL, buf)
		return s32(buf, CONTROL_VALUE)
	}
}
