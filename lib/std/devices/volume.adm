// The volume of the machine's speakers and microphones.
//
// `volume(device)` reads how loud an output plays (or an input records) for
// every program using it, from 0.0 silent to 1.0 full, on the scale of the
// desktop's mixer, and `volume(device, level)` sets it; `mute` and `unmute`
// silence it and bring it back at the same volume. A program's own sound has
// its own volume besides, `Speaker.volume()`.
//
// Through the desktop's sound server for its speakers and microphones (ids
// `pulse:…`); for a sound card's own endpoint (`sound:pcm…`), on the card's
// mixer, whose volume and switch for the card's outputs or inputs are those
// the desktop's mixers show first ("Master", "PCM", "Speaker"; "Capture",
// "Mic").
//
// Example: turn the default speaker down to half
// ```example
// use std.devices
//
// let speaker = try devices.defaultSpeaker()
// try devices.volume(speaker, 0.5)
// println("now at {try devices.volume(speaker)}")
// ```

partial module std.devices {
	use (
		std.services.devices::(Device, DeviceKind, Devices)
		std.devices.alsa::*
		std.devices.pulse::*
	)

	// How loud the speaker plays or the microphone records for every program
	// using it, from 0.0 silent to 1.0 full; above 1.0 the sound server
	// amplifies. Muting leaves the volume as it was.
	//
	// Fails when the policy denies listing the devices, the device is not a
	// speaker or microphone, the sound server or card does not answer, or the
	// card has no volume for it.
	@requires("adm.devices.list")
	def volume(device Device) !float {
		if device.id.startsWith("pulse:") {
			let connection = try serverFor(device)
			defer connection.close()
			let endpoint = try pulseEndpoint(connection, device.kind, device.id[6:])
			return endpoint.volume
		}
		let mixer = try openMixer(device)
		defer mixer.close()
		return mixer.volume()
	}

	// Sets how loud the speaker plays or the microphone records for every
	// program using it, keeping the balance between its channels (on a card,
	// every channel takes the level). 1.0 is full volume; a card goes no
	// higher than its loudest.
	//
	// Fails when the level is negative, the policy denies changing the volume
	// (the `volume` permission and its `device` rules), the device is not a
	// speaker or microphone, the sound server or card refuses, or the card has
	// no volume for it.
	@requires("adm.devices.volume")
	def volume(device Device, level float) !none {
		expects {
			assert level >= 0.0 onerror fail "devices: a volume is 0.0 or more, not {level}"
		}
		try admitDevice("adm.devices.volume", device.id)
		if device.id.startsWith("pulse:") {
			let connection = try serverFor(device)
			defer connection.close()
			return pulseSetVolume(connection, device.kind, device.id[6:], level)
		}
		let mixer = try openMixer(device)
		defer mixer.close()
		return mixer.volume(level)
	}

	// Whether the speaker or microphone is muted for every program using it.
	//
	// Fails when the policy denies listing the devices, the device is not a
	// speaker or microphone, or the sound server or card does not answer. A
	// card endpoint with no switch reads as not muted.
	@requires("adm.devices.list")
	def muted(device Device) !bool {
		if device.id.startsWith("pulse:") {
			let connection = try serverFor(device)
			defer connection.close()
			let endpoint = try pulseEndpoint(connection, device.kind, device.id[6:])
			return endpoint.muted
		}
		let mixer = try openMixer(device)
		defer mixer.close()
		return mixer.muted()
	}

	// Silences the speaker or microphone for every program using it, keeping
	// its volume for `unmute`.
	//
	// Fails when the policy denies changing the volume, the device is not a
	// speaker or microphone, the sound server or card refuses, or the card has
	// no switch for it.
	@requires("adm.devices.volume")
	def mute(device Device) !none {
		return setMuted(device, true)
	}

	// Lets the speaker or microphone be heard again at its volume.
	//
	// Fails when the policy denies changing the volume, the device is not a
	// speaker or microphone, the sound server or card refuses, or the card has
	// no switch for it.
	@requires("adm.devices.volume")
	def unmute(device Device) !none {
		return setMuted(device, false)
	}

	// Mutes or unmutes the device, which the policy must allow.
	//
	// Fails as mute and unmute do.
	internal def setMuted(device Device, on bool) !none {
		try admitDevice("adm.devices.volume", device.id)
		if device.id.startsWith("pulse:") {
			let connection = try serverFor(device)
			defer connection.close()
			return pulseSetMute(connection, device.kind, device.id[6:], on)
		}
		let mixer = try openMixer(device)
		defer mixer.close()
		return mixer.mute(on)
	}

	// A connection to the sound server that lists the device.
	//
	// Fails when the device is not a speaker or microphone or no server runs.
	internal def serverFor(device Device) !PulseConnection {
		try soundKind(device)
		let server = pulseConnection("adm")
		fail "devices: no sound server to reach {device.id} through" when server is none
		let connection PulseConnection = server
		return connection
	}

	// Fails unless the device is a speaker or microphone.
	internal def soundKind(device Device) !none {
		expects {
			assert device.kind := DeviceKind.Speaker || DeviceKind.Microphone onerror fail "devices: {device.id} is not a speaker or microphone"
		}
		return none
	}

	// The mixer of the card behind a card endpoint (`sound:pcmC4D0p`), for
	// its outputs or its inputs.
	//
	// Fails when the device is not a card endpoint or the card's control node
	// cannot be opened.
	internal def openMixer(device Device) !SoundMixer {
		try soundKind(device)
		fail "devices: {device.id} is not a speaker or microphone of a sound card" unless device.id.startsWith("sound:pcmC")
		let card = device.id[10:].split("D")[0]
		let (_, fd) = try openKind("sound:card" + card, DeviceKind.Audio, "sound card")
		let mixer = soundMixer(fd, device.id, device.kind == DeviceKind.Speaker) onerror (err error) {
			Devices.close(fd) onerror recover none
			fail err
		}
		return mixer
	}
}
