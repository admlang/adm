partial module std.errors {
	// Location is where a stack frame was executing: the source file and the
	// 1-based line and column in it.
	struct Location {
		file   string
		line   int
		column int
	}

	// StackFrame is one call on an error's stack: the fully qualified name of the
	// function or method, and where in it the error passed through, when the build
	// keeps locations.
	struct StackFrame {
		name     string // fully qualified: Module.Type.method or module.fn
		location Location // optional if disabled in release builds
	}

	// StackTrace is the calls that were active when an error was created, as the
	// runtime recorded them.
	struct StackTrace {
		frames StackFrame[]
	}

	// printStackTrace writes an error's stack to standard output, one frame per
	// line with its file, line and column when the frame has a location.
	def printStackTrace(e error) {
		println("Stack trace:")
		for let (_, frame) in e.stack.frames {
			let loc = frame.location
			if loc is Location {
				let l Location = loc
				println("{frame.name} ({l.file}:{l.line}:{l.column})")
			} else {
				println("{frame.name}")
			}
		}
	}
}
