partial module std.formats.ai {
	use (
		std.reflection
		std.formats
		std.io
		std.os
		std.bytes
		std.formats.ai.store::*
		std.formats.ai.grids::*
	)

	// The element type of a stored tensor, numbered as GGUF (ggml) numbers
	// them. Quantized types store blocks of `blockSize(kind)` elements in
	// `blockBytes(kind)` bytes.
	enum TensorType {
		F32 = 0,
		F16 = 1,
		Q4_0 = 2,
		Q4_1 = 3,
		Q5_0 = 6,
		Q5_1 = 7,
		Q8_0 = 8,
		Q8_1 = 9,
		Q2_K = 10,
		Q3_K = 11,
		Q4_K = 12,
		Q5_K = 13,
		Q6_K = 14,
		Q8_K = 15,
		IQ2_XXS = 16,
		IQ2_XS = 17,
		IQ3_XXS = 18,
		IQ1_S = 19,
		IQ4_NL = 20,
		IQ3_S = 21,
		IQ2_S = 22,
		IQ4_XS = 23,
		I8 = 24,
		I16 = 25,
		I32 = 26,
		I64 = 27,
		F64 = 28,
		IQ1_M = 29,
		BF16 = 30,
		TQ1_0 = 34,
		TQ2_0 = 35,
		MXFP4 = 39,
		NVFP4 = 40,
		Q1_0 = 41,
		Q2_0 = 42,
	}

	// Elements per block; 1 for the plain types.
	def blockSize(kind TensorType) int {
		match kind {
			case TensorType.F32, TensorType.F16, TensorType.BF16, TensorType.F64, TensorType.I8, TensorType.I16, TensorType.I32, TensorType.I64:
				return 1
			case TensorType.Q4_0, TensorType.Q4_1, TensorType.Q5_0, TensorType.Q5_1, TensorType.Q8_0, TensorType.Q8_1, TensorType.IQ4_NL, TensorType.MXFP4:
				return 32
			case TensorType.NVFP4, TensorType.Q2_0:
				return 64
			case TensorType.Q1_0:
				return 128
			default:
				return 256
		}
	}

	// Bytes per block.
	def blockBytes(kind TensorType) int {
		match kind {
			case TensorType.F32, TensorType.I32:
				return 4
			case TensorType.F16, TensorType.BF16, TensorType.I16:
				return 2
			case TensorType.F64, TensorType.I64:
				return 8
			case TensorType.I8:
				return 1
			case TensorType.Q4_0:
				return 18
			case TensorType.Q4_1:
				return 20
			case TensorType.Q5_0:
				return 22
			case TensorType.Q5_1:
				return 24
			case TensorType.Q8_0:
				return 34
			case TensorType.Q8_1:
				return 36
			case TensorType.Q2_K:
				return 84
			case TensorType.Q3_K:
				return 110
			case TensorType.Q4_K:
				return 144
			case TensorType.Q5_K:
				return 176
			case TensorType.Q6_K:
				return 210
			case TensorType.Q8_K:
				return 292
			case TensorType.IQ2_XXS:
				return 66
			case TensorType.IQ2_XS:
				return 74
			case TensorType.IQ3_XXS:
				return 98
			case TensorType.IQ1_S:
				return 50
			case TensorType.IQ4_NL:
				return 18
			case TensorType.IQ3_S:
				return 110
			case TensorType.IQ2_S:
				return 82
			case TensorType.IQ4_XS:
				return 136
			case TensorType.IQ1_M:
				return 56
			case TensorType.TQ1_0:
				return 54
			case TensorType.TQ2_0:
				return 66
			case TensorType.MXFP4:
				return 17
			case TensorType.NVFP4:
				return 36
			case TensorType.Q1_0, TensorType.Q2_0:
				return 18
		}
	}

	// The first `count` values stored in `data` as `kind`, as float32:
	// plain types converted, quantized blocks expanded. `count` is a whole
	// number of blocks; `data` holds at least their bytes.
	def dequantize(kind TensorType, data byte[], count int) float32[] {
		return expand(kind, data, count)
	}

	// The values the indices of a table-quantized type select: 8 per grid
	// entry for IQ1_S, IQ1_M, IQ2_XXS, IQ2_XS and IQ2_S, 4 per entry for
	// IQ3_XXS and IQ3_S, and one per 4-bit index for IQ4_NL and IQ4_XS and
	// for MXFP4 and NVFP4 (doubled, as ggml keeps them). Empty for the other
	// types. The array is shared and read-only.
	def grid(kind TensorType) float32[] {
		match kind {
			case TensorType.IQ2_XXS:
				return iq2xxsGrid
			case TensorType.IQ2_XS:
				return iq2xsGrid
			case TensorType.IQ2_S:
				return iq2sGrid
			case TensorType.IQ3_XXS:
				return iq3xxsGrid
			case TensorType.IQ3_S:
				return iq3sGrid
			case TensorType.IQ1_S, TensorType.IQ1_M:
				return iq1sGrid
			case TensorType.IQ4_NL, TensorType.IQ4_XS:
				return iq4Values
			case TensorType.MXFP4, TensorType.NVFP4:
				return fp4Values
			default:
				return noValues
		}
	}

	// Whether the values are stored in quantized blocks.
	def isQuantized(kind TensorType) bool {
		return blockSize(kind) > 1
	}

	// One tensor in a model file: its name, type, shape and where its bytes are.
	struct TensorInfo {
		name     string
		kind     TensorType
		// Dimensions, innermost first as GGUF stores them (shape[0] is the row length).
		shape    int[]
		// Byte offset inside the file's data section.
		offset   int
		// Element count (product of shape).
		count    int
		// Size of the stored data in bytes.
		byteSize int
	}

	// A metadata value. GGUF values are typed; arrays hold one type.
	type MetaValue = int | uint | float | bool | string | MetaArray

	// A GGUF metadata array.
	type MetaArray {
		internal values MetaValue[]

		def new(values MetaValue[]) {
			self.values = values
		}

		// Number of elements.
		def len() int {
			return values.len()
		}

		// The element at `i`.
		def get(i int) MetaValue {
			return values[i]
		}

		// The elements as strings; empty when the array holds another type.
		def getStrings() string[] {
			let out string[]
			for let (_, v) in values {
				return string[] unless v is string
				out.push(v)
			}
			return out
		}

		// The elements as integers (unsigned ones converted); empty when the
		// array holds another type.
		def getInts() int[] {
			let out int[]
			for let (_, v) in values {
				if v is int {
					out.push(v)
				} else if v is uint {
					out.push(int(v))
				} else {
					return int[]
				}
			}
			return out
		}

		// The elements as floats; empty when the array holds another type.
		def getFloats() float[] {
			let out float[]
			for let (_, v) in values {
				return float[] unless v is float
				out.push(v)
			}
			return out
		}
	}

	// What a model file holds without its tensor bytes.
	struct ModelInfo {
		metadata map<string, MetaValue>
		tensors  TensorInfo[]
	}

	// A model file: metadata plus a directory of tensors. Loaded from a
	// path, tensor bytes are read on demand from the open file.
	type ModelFile {
		// Metadata by key, e.g. "general.architecture", "llama.block_count".
		metadata map<string, MetaValue>
		tensors  TensorInfo[]

		// Where tensor bytes come from and the GGUF types of scalar metadata.
		internal store TensorStore
		internal index map<string, int>

		def new(info ModelInfo, store TensorStore) {
			metadata = info.metadata
			tensors = info.tensors
			self.store = store
			index = new map<string, int>()
			for let (i, t) in tensors {
				index.set(t.name, i)
			}
		}

		// The tensor called `name`.
		def tensor(name string) ?TensorInfo {
			let i = index.get(name)
			return none when i is none
			return tensors[i]
		}

		// Typed metadata lookups; `none` when the key is missing or holds another type.
		def getString(key string) ?string {
			let v = metadata.get(key)
			return v when v is string
			return none
		}

		// An integer value; unsigned values are converted.
		def getInt(key string) ?int {
			let v = metadata.get(key)
			return v when v is int
			return int(v) when v is uint
			return none
		}

		// A float value.
		def getFloat(key string) ?float {
			let v = metadata.get(key)
			return v when v is float
			return none
		}

		// A string array; empty when the key is missing or holds another type.
		def getStrings(key string) string[] {
			let v = metadata.get(key)
			return v.getStrings() when v is MetaArray
			return string[]
		}

		// The tensor's stored bytes (quantized blocks as they are).
		// Fails when the tensor is missing or the read fails.
		def read(name string) !byte[] {
			let t = tensor(name)
			fail "ai: no tensor named {name}" when t is none
			return store.readAt(t.offset, t.byteSize)
		}

		// The tensor as float32 (plain types converted, quantized ones dequantized).
		// Fails when the tensor is missing or the read fails.
		def readFloats(name string) !float32[] {
			let t = tensor(name)
			fail "ai: no tensor named {name}" when t is none
			let data = try store.readAt(t.offset, t.byteSize)
			return expand(t.kind, data, t.count)
		}

		// Writes the file with the codec its extension names.
		// Fails when no codec has that extension, or the write fails.
		def save(path string) !none {
			let codec = codecRegistry.matchExt(os.extension(path))
			fail "ai: no model codec writes {path}" when codec is none
			let f = try os.open(path, "w")
			defer f.close()
			return codec.encode(self, f)
		}

		// Writes the file in the format of `ext` (".gguf", ".safetensors").
		// Fails when no codec has that extension, or the writer fails.
		def write(writer io.Writer, ext string) !none {
			let codec = codecRegistry.matchExt(ext)
			fail "ai: no model codec for {ext}" when codec is none
			return codec.encode(self, writer)
		}

		// Closes the file a path load keeps open; safe to call twice.
		def close() {
			store.close()
		}
	}

	// ModelDecoder reads a model file from a reader. A file loaded from a
	// path stays open and tensor bytes are read on demand; from a reader or
	// bytes, the tensors are kept in memory.
	interface ModelDecoder {
		// Fails when the data is not this format, is corrupt, or the reader fails.
		def decode(reader io.Reader) !ModelFile
		// Metadata and the tensor directory only, without tensor bytes.
		// Fails like `decode`.
		def info(reader io.Reader) !ModelInfo
	}

	// ModelEncoder writes a model file to a writer.
	interface ModelEncoder {
		// Fails with the writer's error, or when a tensor type is not
		// supported by the format.
		def encode(file ModelFile, writer io.Writer) !none
	}

	// ModelCodec is what a model format registers.
	type ModelCodec = ModelDecoder & ModelEncoder & formats.FileFormat

	// codec registers a type as the model codec of the named format.
	meta def codec<ModelCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	// Load finds the codec that recognises the file and decodes it. The file
	// stays open until the model file is closed.
	// Fails when the file cannot be read, no codec recognises it, or decoding does.
	def load(path string) !ModelFile {
		let f = try os.open(path)
		let (dec, _) = codecRegistry.probe(f) onerror (err error) {
			f.close() onerror recover none
			return err
		}
		let rewound = f.seek(int64(0)) onerror recover int64(-1)
		if rewound < 0 {
			f.close() onerror recover none
			fail "ai: cannot rewind " + path
		}
		return dec.decode(f) onerror (err error) {
			f.close() onerror recover none
			return err
		}
	}

	// Load finds the codec that recognises the data and decodes it.
	// Fails when no codec recognises the data, or decoding does.
	def load(data byte[]) !ModelFile {
		let (dec, _) = try codecRegistry.probe(data)
		return dec.decode(new bytes.Reader(data))
	}

	// Fails when no codec recognises the data, or decoding does.
	def load(reader io.Reader) !ModelFile {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.decode(r)
	}

	// Info reads the metadata and tensor directory without the tensor bytes.
	// Fails when the file cannot be read, no codec recognises it, or decoding does.
	def info(path string) !ModelInfo {
		let f = try os.open(path)
		defer f.close()
		let (dec, r) = try codecRegistry.probe(f)
		return dec.info(r)
	}

	// Fails when no codec recognises the data, or decoding does.
	def info(data byte[]) !ModelInfo {
		let (dec, r) = try codecRegistry.probe(data)
		return dec.info(r)
	}

	// Fails when no codec recognises the data, or decoding does.
	def info(reader io.Reader) !ModelInfo {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.info(r)
	}
}
