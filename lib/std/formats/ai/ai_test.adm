partial module std.formats.ai {
	use (
		std.testing
		std.bytes
		std.os
	)

	check "Model files" {
		// Appends `v` as `n` little-endian bytes.
		internal def put(out byte[], v int, n int) {
			for let k = 0; k < n; k++ {
				out.push(byte((v >> (k * 8)) & 0xFF))
			}
		}

		internal def putString(out byte[], s string) {
			put(out, s.len(), 8)
			out.push(...s.bytes())
		}

		internal def intOr(v ?int) int {
			return -1 when v is none
			return v
		}

		internal def textOr(v ?string) string {
			return "" when v is none
			return v
		}

		internal def floatOr(v ?float) float {
			return -1.0 when v is none
			return v
		}

		internal def pad(out byte[], to int) {
			for out.len() < to {
				out.push(byte(0))
			}
		}

		// A GGUF v3 file: five metadata keys, a 2×32 Q8_0 tensor "w" whose
		// rows hold (k - 16) × 0.5 and all -0.5, and an F32 vector "n".
		internal def sample() byte[] {
			let out byte[]
			put(out, 0x46554747, 4)
			put(out, 3, 4)
			put(out, 2, 8)
			put(out, 5, 8)
			putString(out, "general.architecture")
			put(out, 8, 4)
			putString(out, "llama")
			putString(out, "llama.block_count")
			put(out, 4, 4)
			put(out, 2, 4)
			putString(out, "general.alignment")
			put(out, 4, 4)
			put(out, 32, 4)
			putString(out, "llama.rope.freq_base")
			put(out, 6, 4)
			put(out, 0x461C4000, 4)
			putString(out, "tokenizer.ggml.tokens")
			put(out, 9, 4)
			put(out, 8, 4)
			put(out, 2, 8)
			putString(out, "a")
			putString(out, "b")

			putString(out, "w")
			put(out, 2, 4)
			put(out, 32, 8)
			put(out, 2, 8)
			put(out, 8, 4)
			put(out, 0, 8)
			putString(out, "n")
			put(out, 1, 4)
			put(out, 4, 8)
			put(out, 0, 4)
			put(out, 96, 8)
			pad(out, (out.len() + 31) / 32 * 32)

			let data = out.len()
			put(out, 0x3800, 2)
			for let k = 0; k < 32; k++ {
				put(out, k - 16, 1)
			}
			put(out, 0x3800, 2)
			for let k = 0; k < 32; k++ {
				put(out, -1, 1)
			}
			pad(out, data + 96)
			for let (_, bits) in int[0x3F800000, 0x40000000, 0xC0400000, 0x3F000000] {
				put(out, bits, 4)
			}
			return out
		}

		@test()
		def TestTensorTypeBlocks() !none {
			assert blockSize(TensorType.Q8_0) == 32 && blockBytes(TensorType.Q8_0) == 34
			assert blockSize(TensorType.Q4_K) == 256 && blockBytes(TensorType.Q4_K) == 144
			assert blockSize(TensorType.F16) == 1 && blockBytes(TensorType.F16) == 2
			assert isQuantized(TensorType.Q6_K) && !isQuantized(TensorType.BF16)
			return none
		}

		@test()
		def TestNewerTypeBlocks() !none {
			assert blockSize(TensorType.NVFP4) == 64 && blockBytes(TensorType.NVFP4) == 36
			assert blockSize(TensorType.Q1_0) == 128 && blockBytes(TensorType.Q1_0) == 18
			assert blockSize(TensorType.Q2_0) == 64 && blockBytes(TensorType.Q2_0) == 18
			assert isQuantized(TensorType.Q1_0) && TensorType.Q2_0.value == 42
			return none
		}

		@test()
		def TestGrids() !none {
			let g = grid(TensorType.IQ2_XXS)
			assert g.len() == 256 * 8 && g[0] == 8 && g[7] == 8
			assert grid(TensorType.IQ2_XS).len() == 512 * 8 && grid(TensorType.IQ2_S).len() == 1024 * 8
			assert grid(TensorType.IQ3_XXS).len() == 256 * 4 && grid(TensorType.IQ3_S).len() == 512 * 4
			let one = grid(TensorType.IQ1_M)
			assert one.len() == 2048 * 8 && one[0] == -1
			assert grid(TensorType.IQ4_XS)[0] == -127 && grid(TensorType.IQ4_NL)[15] == 113
			assert grid(TensorType.MXFP4)[7] == 12 && grid(TensorType.NVFP4)[15] == -12
			assert grid(TensorType.Q8_0).len() == 0
			return none
		}

		@test()
		def TestDequantizeSmallTypes() !none {
			// Q2_0 with d = 1: bytes 0b11100100 give -1, 0, 1, 2 in order.
			let q2 byte[]
			put(q2, 0x3C00, 2)
			for let k = 0; k < 16; k++ {
				q2.push(byte(0xE4))
			}
			let v = dequantize(TensorType.Q2_0, q2, 64)
			assert v.len() == 64 && v[0] == -1 && v[1] == 0 && v[2] == 1 && v[3] == 2 && v[63] == 2
			// Q1_0 with d = 0.5: byte 0x01 sets only its first element.
			let q1 byte[]
			put(q1, 0x3800, 2)
			for let k = 0; k < 16; k++ {
				q1.push(byte(1))
			}
			let w = dequantize(TensorType.Q1_0, q1, 128)
			assert w[0] == 0.5 && w[1] == -0.5 && w[8] == 0.5 && w[127] == -0.5
			// IQ4_NL with d = 1: nibbles 0 and 15 give the table's ends.
			let nl byte[]
			put(nl, 0x3C00, 2)
			for let k = 0; k < 16; k++ {
				nl.push(byte(0xF0))
			}
			let x = dequantize(TensorType.IQ4_NL, nl, 32)
			assert x[0] == -127 && x[16] == 113
			// MXFP4 with exponent byte 128 (2, halved to 1): index 7 is 12.
			let mx byte[]
			mx.push(byte(128))
			for let k = 0; k < 16; k++ {
				mx.push(byte(0x97))
			}
			let y = dequantize(TensorType.MXFP4, mx, 32)
			assert y[0] == 12 && y[16] == -1
			return none
		}

		@test()
		def TestGgufMetadata() !none {
			let file = try load(sample())
			assert textOr(file.getString("general.architecture")) == "llama"
			assert intOr(file.getInt("llama.block_count")) == 2
			assert floatOr(file.getFloat("llama.rope.freq_base")) == 10000.0
			assert file.getString("llama.block_count") is none
			assert file.getInt("missing") is none
			let names = file.getStrings("tokenizer.ggml.tokens")
			assert names.len() == 2 && names[0] == "a" && names[1] == "b"
			let tokens = file.metadata.get("tokenizer.ggml.tokens")
			assert tokens is MetaArray
			if tokens is MetaArray {
				let second = tokens.get(1)
				assert tokens.len() == 2 && second is string && second == "b"
				assert tokens.getInts().len() == 0 && tokens.getFloats().len() == 0
			}
			return none
		}

		@test()
		def TestGgufTensors() !none {
			let file = try load(sample())
			assert file.tensors.len() == 2
			let w = file.tensor("w")
			assert !(w is none)
			if !(w is none) {
				assert w.kind == TensorType.Q8_0 && w.shape.len() == 2 && w.shape[0] == 32 && w.shape[1] == 2 && w.count == 64 && w.byteSize == 68
			}
			assert file.tensor("x") is none
			assert (try file.read("w")).len() == 68
			let values = try file.readFloats("w")
			assert values[0] == float32(-8) && values[31] == float32(7.5) && values[32] == float32(-0.5)
			assert (try file.readFloats("n")).equals(float32[1, 2, -3, 0.5])
			return testing.expectError(file.readFloats("x"))
		}

		@test()
		def TestGgufInfo() !none {
			let head = try info(sample())
			assert head.tensors.len() == 2 && head.tensors[1].name == "n"
			assert head.metadata.len() == 5
			return none
		}

		@test()
		def TestGgufRoundTrip() !none {
			let file = try load(sample())
			let out = new bytes.Buffer()
			try file.write(out, ".gguf")
			let again = try load(out.bytes())
			assert intOr(again.getInt("llama.block_count")) == 2
			assert again.getStrings("tokenizer.ggml.tokens").equals(string["a", "b"])
			assert (try again.readFloats("w")).equals(try file.readFloats("w"))
			assert (try again.readFloats("n")).equals(float32[1, 2, -3, 0.5])
			return none
		}

		@test()
		def TestNotGguf() !none {
			return testing.expectError(load("not a model".bytes()))
		}

		@test()
		def TestGgufSave() !none {
			let file = try load(sample())
			let path = os.join(try os.appHome(), "saved.gguf")
			try file.save(path)
			let again = try load(path)
			assert again.tensors.len() == 2
			assert (try again.readFloats("n")).equals(float32[1, 2, -3, 0.5])
			again.close()
			return none
		}

		// A safetensors file as the reference library writes it: an F32 2×2
		// "w" [0.5, 1, 2, -1] and an F16 "h" [1, -2], metadata {"format": "pt"},
		// header padded with spaces.
		internal def safetensorsSample() byte[] {
			let header = "\{\"__metadata__\":\{\"format\":\"pt\"},\"h\":\{\"dtype\":\"F16\",\"shape\":[2],\"data_offsets\":[16,20]},\"w\":\{\"dtype\":\"F32\",\"shape\":[2,2],\"data_offsets\":[0,16]}}"
			let text = header.bytes()
			for text.len() % 8 != 0 {
				text.push(byte(0x20))
			}
			let out byte[]
			put(out, text.len(), 8)
			out.push(...text)
			for let (_, bits) in int[0x3F000000, 0x3F800000, 0x40000000, 0xBF800000] {
				put(out, bits, 4)
			}
			put(out, 0x3C00, 2)
			put(out, 0xC000, 2)
			return out
		}

		@test()
		def TestSafetensorsRead() !none {
			let file = try load(safetensorsSample())
			assert textOr(file.getString("format")) == "pt"
			let w = file.tensor("w")
			assert w is TensorInfo && w.kind == TensorType.F32 && w.shape.len() == 2 && w.count == 4 && w.byteSize == 16
			assert (try file.readFloats("w")).equals(float32[0.5, 1, 2, -1])
			assert (try file.readFloats("h")).equals(float32[1, -2])
			assert file.tensors[0].name == "w" && file.tensors[1].name == "h"
			let info = try info(safetensorsSample())
			assert info.tensors.len() == 2 && info.metadata.len() == 1
			return none
		}

		@test()
		def TestSafetensorsWrite() !none {
			let file = try load(safetensorsSample())
			let out = new bytes.Buffer()
			try file.write(out, ".safetensors")
			let again = try load(out.bytes())
			assert textOr(again.getString("format")) == "pt"
			assert (try again.readFloats("w")).equals(float32[0.5, 1, 2, -1])
			assert (try again.readFloats("h")).equals(float32[1, -2])
			let gguf = new bytes.Buffer()
			try file.write(gguf, ".gguf")
			assert (try (try load(gguf.bytes())).readFloats("h")).equals(float32[1, -2])
			let quantized = try load(sample())
			return testing.expectError(quantized.write(new bytes.Buffer(), ".safetensors"))
		}

		@test()
		def TestSignatures() !none {
			assert new Gguf().matchSignature(new bytes.Reader(sample()))
			assert !new Gguf().matchSignature(new bytes.Reader(safetensorsSample()))
			assert new Safetensors().matchSignature(new bytes.Reader(safetensorsSample()))
			assert !new Safetensors().matchSignature(new bytes.Reader(sample()))
			assert !new Safetensors().matchSignature(new bytes.Reader("not a model".bytes()))
			return none
		}

		@test()
		def TestSafetensorsRefusesUnknownDtype() !none {
			let text = "\{\"x\":\{\"dtype\":\"F8_E4M3\",\"shape\":[1],\"data_offsets\":[0,1]}}".bytes()
			let out byte[]
			put(out, text.len(), 8)
			out.push(...text)
			out.push(byte(0))
			return testing.expectError(load(out))
		}
	}
}
