internal partial module std.formats.ai.store {
	use (
		std.formats.ai::*
		std.formats.ai.grids::*
	)

	// Offsets below are within one block; element e of block b lands at
	// out[b * blockSize + e]. Each function expands `count / blockSize`
	// whole blocks.

	// Q2_K (256 elements, 84 bytes): 16 scale bytes (low nibble scale, high
	// nibble minimum, per 16 elements), 64 bytes of 2-bit values, then
	// the halves d and dmin. Element h·128 + s·32 + l is bits 2s of byte
	// h·32 + l.
	def expandQ2K(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 84
			let d = half(data, at + 80)
			let dmin = half(data, at + 82)
			for let e = 0; e < 256; e++ {
				let sc = int(data[at + e / 16])
				let q = (int(data[at + 16 + (e / 128) * 32 + e % 32]) >> (2 * ((e / 32) % 4))) & 3
				out[b * 256 + e] = d * float32(sc & 15) * float32(q) - dmin * float32(sc >> 4)
			}
		}
	}

	// Q3_K (256 elements, 110 bytes): 32 bytes of high bits, 64 bytes of
	// low 2-bit values laid out as Q2_K's, 12 bytes of packed 6-bit signed
	// scales (per 16 elements), then the half d. Element e takes bit e/32
	// of high byte e%32; a clear bit subtracts 4.
	def expandQ3K(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 110
			let d = half(data, at + 108)
			for let e = 0; e < 256; e++ {
				let low = (int(data[at + 32 + (e / 128) * 32 + e % 32]) >> (2 * ((e / 32) % 4))) & 3
				let high = (int(data[at + e % 32]) >> (e / 32)) & 1
				out[b * 256 + e] = d * float32(scaleQ3K(data, at + 96, e / 16)) * float32((low | (high << 2)) - 4)
			}
		}
	}

	// The signed 6-bit scale `i` (0–15) of a Q3_K block, packed in the 12
	// bytes at `at`: low nibbles in the first 8 bytes (i and i+8 share a
	// byte), 2-bit high parts in the last 4.
	def scaleQ3K(data byte[], at int, i int) int {
		let low = (int(data[at + i % 8]) >> (4 * (i / 8))) & 15
		let high = (int(data[at + 8 + i % 4]) >> (2 * (i / 4))) & 3
		return (low | (high << 4)) - 32
	}

	// Q1_0 (128 elements, 18 bytes): the half d, then one bit per element
	// (element j is bit j%8 of byte j/8): set is +d, clear −d.
	def expandQ1(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 128; b++ {
			let at = b * 18
			let d = half(data, at)
			for let j = 0; j < 128; j++ {
				out[b * 128 + j] = (int(data[at + 2 + j / 8]) >> (j % 8)) & 1 == 1 ?? (d, -d)
			}
		}
	}

	// Q2_0 (64 elements, 18 bytes): the half d, then 2 bits per element
	// (element j is bits 2(j%4) of byte j/4), stored plus 1.
	def expandQ2(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 64; b++ {
			let at = b * 18
			let d = half(data, at)
			for let j = 0; j < 64; j++ {
				out[b * 64 + j] = d * float32(((int(data[at + 2 + j / 4]) >> (2 * (j % 4))) & 3) - 1)
			}
		}
	}

	// Q8_K (256 elements, 292 bytes): a float32 scale, 256 signed bytes and
	// 16 int16 block sums (not needed to expand).
	def expandQ8K(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 292
			let d = __bitcast_f32_from_u32(uint32(le(data, at, 4)))
			for let e = 0; e < 256; e++ {
				out[b * 256 + e] = d * float32(int8(data[at + 4 + e]))
			}
		}
	}

	// TQ1_0 (256 elements, 54 bytes): ternary values five to a byte in 48
	// bytes, four to a byte in the next 4, then the half d. A byte times
	// 3^k (mod 256), times 3, shifted right by 8, is its k-th trit.
	def expandTQ1(data byte[], count int, out float32[]) {
		let powers = int[1, 3, 9, 27, 81]
		for let b = 0; b < count / 256; b++ {
			let at = b * 54
			let d = half(data, at + 52)
			for let e = 0; e < 256; e++ {
				let byteAt = 48 + (e - 240) % 4
				let k = (e - 240) / 4
				if e < 160 {
					byteAt = e % 32
					k = e / 32
				} else if e < 240 {
					byteAt = 32 + (e - 160) % 16
					k = (e - 160) / 16
				}
				let v = (int(data[at + byteAt]) * powers[k]) & 255
				out[b * 256 + e] = d * float32(((v * 3) >> 8) - 1)
			}
		}
	}

	// TQ2_0 (256 elements, 66 bytes): 2-bit values (stored plus 1) laid out
	// as Q2_K's, then the half d.
	def expandTQ2(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 66
			let d = half(data, at + 64)
			for let e = 0; e < 256; e++ {
				let q = (int(data[at + (e / 128) * 32 + e % 32]) >> (2 * ((e / 32) % 4))) & 3
				out[b * 256 + e] = d * float32(q - 1)
			}
		}
	}

	// IQ4_NL (32 elements, 18 bytes): the half d, then 4-bit indices into
	// the IQ4 values laid out as Q4_0's.
	def expandIQ4NL(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 32; b++ {
			let at = b * 18
			let d = half(data, at)
			for let j = 0; j < 16; j++ {
				let q = int(data[at + 2 + j])
				out[b * 32 + j] = d * iq4Values[q & 15]
				out[b * 32 + j + 16] = d * iq4Values[q >> 4]
			}
		}
	}

	// IQ4_XS (256 elements, 136 bytes): the half d, the 2-bit high parts of
	// the eight 6-bit signed scales (16 bits), their low nibbles (4 bytes),
	// then per 32 elements 16 bytes laid out as IQ4_NL's.
	def expandIQ4XS(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 136
			let d = half(data, at)
			let high = le(data, at + 2, 2)
			for let s = 0; s < 8; s++ {
				let low = (int(data[at + 4 + s / 2]) >> (4 * (s % 2))) & 15
				let dl = d * float32((low | (((high >> (2 * s)) & 3) << 4)) - 32)
				for let j = 0; j < 16; j++ {
					let q = int(data[at + 8 + s * 16 + j])
					out[b * 256 + s * 32 + j] = dl * iq4Values[q & 15]
					out[b * 256 + s * 32 + j + 16] = dl * iq4Values[q >> 4]
				}
			}
		}
	}

	// MXFP4 (32 elements, 17 bytes): an E8M0 exponent, then 4-bit E2M1
	// indices laid out as Q4_0's.
	def expandMXFP4(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 32; b++ {
			let at = b * 17
			let d = e8m0Half(int(data[at]))
			for let j = 0; j < 16; j++ {
				let q = int(data[at + 1 + j])
				out[b * 32 + j] = d * fp4Values[q & 15]
				out[b * 32 + j + 16] = d * fp4Values[q >> 4]
			}
		}
	}

	// NVFP4 (64 elements, 36 bytes): four unsigned E4M3 scales, one per 16
	// elements, then per 16 elements 8 bytes: low nibbles first, then high.
	def expandNVFP4(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 64; b++ {
			let at = b * 36
			for let s = 0; s < 4; s++ {
				let d = ue4m3Half(int(data[at + s]))
				for let j = 0; j < 8; j++ {
					let q = int(data[at + 4 + s * 8 + j])
					out[b * 64 + s * 16 + j] = d * fp4Values[q & 15]
					out[b * 64 + s * 16 + j + 8] = d * fp4Values[q >> 4]
				}
			}
		}
	}

	// Half of the power of two an E8M0 byte encodes (the E2M1 values are
	// kept doubled).
	def e8m0Half(e int) float32 {
		let bits = e < 2 ?? (0x00200000 << e, (e - 1) << 23)
		return __bitcast_f32_from_u32(uint32(bits))
	}

	// Half of an unsigned E4M3 value (bias 7); 0x7F, its NaN, reads as 0.
	def ue4m3Half(x int) float32 {
		if x := 0 || 0x7F {
			return float32(0)
		}
		let exponent = (x >> 3) & 15
		let mantissa = float32(x & 7)
		let v = exponent == 0 ?? (mantissa * float32(0.001953125), (float32(1) + mantissa / float32(8)) * pow2(exponent - 7))
		return v * float32(0.5)
	}

	def pow2(n int) float32 {
		return __bitcast_f32_from_u32(uint32((n + 127) << 23))
	}

	// The sign byte ggml stores as a 7-bit index: bit 7 makes the count of
	// set bits even.
	def ksign(i int) int {
		let p = i ^ (i >> 4)
		p = p ^ (p >> 2)
		p = p ^ (p >> 1)
		return i | ((p & 1) << 7)
	}

	// Writes grid entry `index` (`width` values) times `scale`, negated
	// where `signs` has a bit set, at out[at].
	def putEntry(out float32[], at int, table float32[], index int, width int, scale float32, signs int) {
		for let k = 0; k < width; k++ {
			let v = scale * table[index * width + k]
			out[at + k] = (signs >> k) & 1 == 1 ?? (-v, v)
		}
	}

	// IQ2_XXS (256 elements, 66 bytes): the half d, then per 32 elements
	// two 32-bit words: four grid indices, then four 7-bit sign indices and
	// a 4-bit scale on top.
	def expandIQ2XXS(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 66
			let d = half(data, at)
			for let g = 0; g < 8; g++ {
				let aux = le(data, at + 2 + g * 8 + 4, 4)
				let db = d * (float32(0.5) + float32(aux >> 28)) * float32(0.25)
				for let j = 0; j < 4; j++ {
					putEntry(out, b * 256 + g * 32 + j * 8, iq2xxsGrid, int(data[at + 2 + g * 8 + j]), 8, db, ksign((aux >> (7 * j)) & 127))
				}
			}
		}
	}

	// IQ2_XS (256 elements, 74 bytes): the half d, 32 16-bit words (9-bit
	// grid index, 7-bit sign index), then 4-bit scales, one per 16 elements.
	def expandIQ2XS(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 74
			let d = half(data, at)
			for let i = 0; i < 32; i++ {
				let v = le(data, at + 2 + i * 2, 2)
				let sc = (int(data[at + 66 + i / 4]) >> (4 * ((i / 2) % 2))) & 15
				putEntry(out, b * 256 + i * 8, iq2xsGrid, v & 511, 8, d * (float32(0.5) + float32(sc)) * float32(0.25), ksign(v >> 9))
			}
		}
	}

	// IQ2_S (256 elements, 82 bytes): the half d, 32 low bytes of the grid
	// indices, 32 sign bytes, 8 bytes of 2-bit high index parts, then 4-bit
	// scales, one per 16 elements.
	def expandIQ2S(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 82
			let d = half(data, at)
			for let i = 0; i < 32; i++ {
				let index = int(data[at + 2 + i]) | (((int(data[at + 66 + i / 4]) >> (2 * (i % 4))) & 3) << 8)
				let sc = (int(data[at + 74 + i / 4]) >> (4 * ((i / 2) % 2))) & 15
				putEntry(out, b * 256 + i * 8, iq2sGrid, index, 8, d * (float32(0.5) + float32(sc)) * float32(0.25), int(data[at + 34 + i]))
			}
		}
	}

	// IQ3_XXS (256 elements, 98 bytes): the half d, 64 grid indices (four
	// values each), then per 32 elements a 32-bit word of four 7-bit sign
	// indices and a 4-bit scale on top.
	def expandIQ3XXS(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 98
			let d = half(data, at)
			for let g = 0; g < 8; g++ {
				let aux = le(data, at + 66 + g * 4, 4)
				let db = d * (float32(0.5) + float32(aux >> 28)) * float32(0.5)
				for let j = 0; j < 4; j++ {
					let signs = ksign((aux >> (7 * j)) & 127)
					let e = b * 256 + g * 32 + j * 8
					putEntry(out, e, iq3xxsGrid, int(data[at + 2 + g * 8 + j * 2]), 4, db, signs)
					putEntry(out, e + 4, iq3xxsGrid, int(data[at + 2 + g * 8 + j * 2 + 1]), 4, db, signs >> 4)
				}
			}
		}
	}

	// IQ3_S (256 elements, 110 bytes): the half d, 64 low bytes of the grid
	// indices (four values each), 8 bytes of their ninth bits, 32 sign
	// bytes, then 4-bit scales, one per 32 elements.
	def expandIQ3S(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 110
			let d = half(data, at)
			for let i = 0; i < 64; i++ {
				let index = int(data[at + 2 + i]) | (((int(data[at + 66 + i / 8]) >> (i % 8)) & 1) << 8)
				let sc = (int(data[at + 106 + i / 16]) >> (4 * ((i / 8) % 2))) & 15
				let signs = int(data[at + 74 + i / 2]) >> (4 * (i % 2))
				putEntry(out, b * 256 + i * 4, iq3sGrid, index, 4, d * float32(1 + 2 * sc), signs)
			}
		}
	}

	// IQ1_S (256 elements, 50 bytes): the half d, 32 low bytes of the grid
	// indices (values -1, 0, 1), then per 32 elements a 16-bit word: four
	// 3-bit high index parts, a 3-bit scale and the sign of the shift.
	def expandIQ1S(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 50
			let d = half(data, at)
			for let g = 0; g < 8; g++ {
				let qh = le(data, at + 34 + g * 2, 2)
				let dl = d * float32(2 * ((qh >> 12) & 7) + 1)
				let delta = qh & 0x8000 == 0 ?? (float32(0.125), float32(-0.125))
				for let j = 0; j < 4; j++ {
					let index = int(data[at + 2 + g * 4 + j]) | (((qh >> (3 * j)) & 7) << 8)
					for let k = 0; k < 8; k++ {
						out[b * 256 + g * 32 + j * 8 + k] = dl * (iq1sGrid[index * 8 + k] + delta)
					}
				}
			}
		}
	}

	// IQ1_M (256 elements, 56 bytes): 32 low bytes of the grid indices, 16
	// bytes of nibbles (3-bit high index part and the sign of the shift, per
	// 8 elements), then four 16-bit words: 3-bit scales (per 16 elements)
	// with the half d spread over their top nibbles.
	def expandIQ1M(data byte[], count int, out float32[]) {
		for let b = 0; b < count / 256; b++ {
			let at = b * 56
			let d = iq1mScale(data, at + 48)
			for let i = 0; i < 32; i++ {
				let nibble = (int(data[at + 32 + i / 2]) >> (4 * (i % 2))) & 15
				let index = int(data[at + i]) | ((nibble & 7) << 8)
				let s = (le(data, at + 48 + (i / 8) * 2, 2) >> (3 * ((i / 2) % 4))) & 7
				let dl = d * float32(2 * s + 1)
				let delta = nibble & 8 == 0 ?? (float32(0.125), float32(-0.125))
				for let k = 0; k < 8; k++ {
					out[b * 256 + i * 8 + k] = dl * (iq1sGrid[index * 8 + k] + delta)
				}
			}
		}
	}

	// The half an IQ1_M block keeps in the top nibbles of its four scale
	// words at `at`.
	def iq1mScale(data byte[], at int) float32 {
		let bits = (le(data, at, 2) >> 12) | ((le(data, at + 2, 2) >> 8) & 0xF0) | ((le(data, at + 4, 2) >> 4) & 0xF00) | (le(data, at + 6, 2) & 0xF000)
		return halfToFloat(bits)
	}
}
