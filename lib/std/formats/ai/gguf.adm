partial module std.formats.ai {
	use (
		std.io
		std.formats.video.media.source
		std.formats.ai.store::*
		std.formats.ai.gguf::*
	)

	// GGUF, the llama.cpp model file (versions 2 and 3): typed metadata, a
	// tensor directory, then aligned tensor data.
	@codec("GGUF")
	type Gguf {
		extension string[] {
			def get() string[] {
				return string[".gguf"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["application/x-gguf"]
			}
		}

		// matchSignature implements SignatureMatcher: the "GGUF" magic.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(4)
			let n = r.read(head) onerror recover 0
			return n == 4 && string(head) == "GGUF"
		}

		// decode implements ModelDecoder. A file or byte reader is read in
		// place; any other reader is read into memory first.
		// Fails when the data is not GGUF, is corrupt, or the reader fails.
		def decode(reader io.Reader) !ModelFile {
			let src = try source.randomSource(reader)
			let (info, dataStart) = try readHeader(src)
			return new ModelFile(info, new TensorStore(src.reader, dataStart))
		}

		// info implements ModelDecoder: the header only.
		// Fails when the data is not GGUF, is corrupt, or the reader fails.
		def info(reader io.Reader) !ModelInfo {
			let (info, _) = try readHeader(new source.Source(reader))
			return info
		}

		// encode implements ModelEncoder: GGUF version 3, tensors in
		// directory order at the file's alignment. Integer metadata is written
		// as uint32 when it fits (as llama.cpp stores counts and ids), else
		// int32 or int64; floats as float32.
		// Fails when a tensor cannot be read, or the writer fails.
		def encode(file ModelFile, writer io.Writer) !none {
			return writeFile(file, writer)
		}
	}
}

internal partial module std.formats.ai.gguf {
	use (
		std.io
		std.bytes
		std.formats.video.media.source
		std.formats.ai::*
		std.formats.ai.store::*
	)

	const magic = 0x46554747
	const defaultAlignment = 32

	// The header's metadata and tensor directory, and the file offset where
	// the tensor data starts.
	// Fails when the data is not GGUF version 2 or 3, or is corrupt.
	def readHeader(src source.Source) !(ModelInfo, int) {
		expects {
			assert (try src.le(4)) == magic onerror fail "gguf: not a GGUF file"
		}
		let version = try src.le(4)
		fail "gguf: version {version} is not supported (2 and 3 are)" unless version := 2 || 3
		let tensorCount = try src.le(8)
		let kvCount = try src.le(8)
		fail "gguf: corrupt header counts" when tensorCount < 0 || kvCount < 0

		let metadata = new map<string, MetaValue>()
		for let i = 0; i < kvCount; i++ {
			let key = try readString(src)
			let kind = try src.le(4)
			metadata.set(key, try readValue(src, kind))
		}

		let tensors TensorInfo[]
		for let i = 0; i < tensorCount; i++ {
			let name = try readString(src)
			let dims = try src.le(4)
			fail "gguf: tensor {name} has {dims} dimensions" when dims < 1 || dims > 4
			let shape int[]
			let count = 1
			for let d = 0; d < dims; d++ {
				let n = try src.le(8)
				shape.push(n)
				count *= n
			}
			let id = try src.le(4)
			let kind = tensorType(id)
			fail "gguf: tensor {name} has unknown type {id}" when kind is none
			let offset = try src.le(8)
			let block = blockSize(kind)
			fail "gguf: tensor {name} row of {shape[0]} is not whole {kind.name} blocks" when shape[0] % block != 0
			tensors.push(TensorInfo{
				name:     name,
				kind:     kind,
				shape:    shape,
				offset:   offset,
				count:    count,
				byteSize: count / block * blockBytes(kind),
			})
		}

		let alignment = alignmentOf(metadata)
		let dataStart = align(src.position(), alignment)
		return (ModelInfo{metadata: metadata, tensors: tensors}, dataStart)
	}

	// The alignment the file declares, 32 when it does not.
	def alignmentOf(metadata map<string, MetaValue>) int {
		let v = metadata.get("general.alignment")
		return v when v is int && v > 0
		return defaultAlignment
	}

	// The tensor type numbered `id`, `none` for an unknown number.
	def tensorType(id int) ?TensorType {
		for let (_, t) in TensorType.values() {
			return TensorType(t) when t == id
		}
		return none
	}

	// Fails when the data ends early.
	def readString(src source.Source) !string {
		let n = try src.le(8)
		fail "gguf: corrupt string length {n}" when n < 0
		return string(try src.read(n))
	}

	// One value of GGUF type `kind`.
	// Fails when the type is unknown or the data ends early.
	def readValue(src source.Source, kind int) !MetaValue {
		expects {
			assert kind >= 0 && kind <= GgufValue.Float64.value onerror fail "gguf: unknown value type {kind}"
		}
		match GgufValue(kind) {
			case GgufValue.Uint8:
				return try src.le(1)
			case GgufValue.Int8:
				return signed(try src.le(1), 8)
			case GgufValue.Uint16:
				return try src.le(2)
			case GgufValue.Int16:
				return signed(try src.le(2), 16)
			case GgufValue.Uint32:
				return try src.le(4)
			case GgufValue.Int32:
				return signed(try src.le(4), 32)
			case GgufValue.Float32:
				return float(__bitcast_f32_from_u32(uint32(try src.le(4))))
			case GgufValue.Bool:
				return (try src.le(1)) != 0
			case GgufValue.String:
				return try readString(src)
			case GgufValue.Array:
				let element = try src.le(4)
				let n = try src.le(8)
				fail "gguf: corrupt array length {n}" when n < 0
				let values MetaValue[]
				for let i = 0; i < n; i++ {
					values.push(try readValue(src, element))
				}
				return new MetaArray(values)
			case GgufValue.Uint64:
				return uint(try src.le(8))
			case GgufValue.Int64:
				return try src.le(8)
			case GgufValue.Float64:
				return float(__bitcast_f64_from_u64(uint64(try src.le(8))))
		}
		fail "gguf: unknown value type {kind}"
	}

	// The `bits`-wide two's complement value of `v`.
	def signed(v int, bits int) int {
		let top = 1 << (bits - 1)
		return v >= top ?? (v - (top << 1), v)
	}

	// Writes `file` as GGUF version 3.
	// Fails when a tensor cannot be read, or the writer fails.
	def writeFile(file ModelFile, writer io.Writer) !none {
		let alignment = alignmentOf(file.metadata)
		let head = new bytes.Buffer()
		try putInt(head, magic, 4)
		try putInt(head, 3, 4)
		try putInt(head, file.tensors.len(), 8)
		try putInt(head, file.metadata.len(), 8)
		for let (key, value) in file.metadata {
			try putString(head, key)
			try putValue(head, value, true)
		}
		let offset = 0
		for let (_, t) in file.tensors {
			try putString(head, t.name)
			try putInt(head, t.shape.len(), 4)
			for let (_, n) in t.shape {
				try putInt(head, n, 8)
			}
			try putInt(head, t.kind.value, 4)
			try putInt(head, offset, 8)
			offset = align(offset + t.byteSize, alignment)
		}
		try pad(head, align(head.len(), alignment) - head.len())
		try writeAll(writer, head.bytes())

		for let (_, t) in file.tensors {
			let data = try file.read(t.name)
			try writeAll(writer, data)
			let tail = new bytes.Buffer()
			try pad(tail, align(t.byteSize, alignment) - t.byteSize)
			try writeAll(writer, tail.bytes())
		}
		return none
	}

	// Writes the value with its type tag when `tagged`, bare inside an array.
	// Fails when the buffer does.
	def putValue(out bytes.Buffer, value MetaValue, tagged bool) !none {
		if value is int {
			let kind = intType(value)
			try putInt(out, kind.value, 4) when tagged
			return putInt(out, value, intWidth(kind))
		}
		if value is uint {
			try putInt(out, GgufValue.Uint64.value, 4) when tagged
			return putInt(out, int(value), 8)
		}
		if value is float {
			try putInt(out, GgufValue.Float32.value, 4) when tagged
			return putInt(out, int(__bitcast_u32_from_f32(float32(value))), 4)
		}
		if value is bool {
			try putInt(out, GgufValue.Bool.value, 4) when tagged
			return putInt(out, value ?? (1, 0), 1)
		}
		if value is string {
			try putInt(out, GgufValue.String.value, 4) when tagged
			return putString(out, value)
		}
		fail "gguf: unknown metadata value" unless value is MetaArray
		let list = value
		try putInt(out, GgufValue.Array.value, 4) when tagged
		try putInt(out, elementType(list).value, 4)
		try putInt(out, list.len(), 8)
		let kind = elementType(list)
		for let i = 0; i < list.len(); i++ {
			let v = list.get(i)
			if v is int {
				try putInt(out, v, intWidth(kind))
			} else {
				try putValue(out, v, false)
			}
		}
		return none
	}

	// The GGUF type an integer is written as.
	def intType(v int) GgufValue {
		return GgufValue.Uint32 when v >= 0 && v < 0x1 0000 0000
		return GgufValue.Int32 when v >= -0x8000 0000 && v < 0x8000 0000
		return v >= 0 ?? (GgufValue.Uint64, GgufValue.Int64)
	}

	// Bytes an integer type takes.
	def intWidth(kind GgufValue) int {
		return (kind == GgufValue.Uint32 || kind == GgufValue.Int32) ?? (4, 8)
	}

	// The GGUF type of an array's elements: integers take the widest type
	// any element needs.
	def elementType(list MetaArray) GgufValue {
		return GgufValue.Uint32 when list.len() == 0
		let first = list.get(0)
		return GgufValue.Uint64 when first is uint
		return GgufValue.Float32 when first is float
		return GgufValue.Bool when first is bool
		return GgufValue.String when first is string
		return GgufValue.Array when first is MetaArray
		let signed = false
		let wide = false
		for let i = 0; i < list.len(); i++ {
			let v = list.get(i)
			continue unless v is int
			signed = signed || v < 0
			wide = wide || intWidth(intType(v)) == 8
		}
		return signed ?? (wide ?? (GgufValue.Int64, GgufValue.Int32), wide ?? (GgufValue.Uint64, GgufValue.Uint32))
	}

	// Fails when the buffer does.
	def putString(out bytes.Buffer, s string) !none {
		let b = s.bytes()
		try putInt(out, b.len(), 8)
		try out.write(b)
		return none
	}
}
