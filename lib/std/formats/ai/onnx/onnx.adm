partial module std.formats.ai.onnx {
	use (
		std.os
		std.services.storage::(MapAccess)
		std.data.encoding::(ProtoReader, ProtoField, ProtoWriter, ProtoWireType)
	)

	// The element type of a tensor, numbered as ONNX's TensorProto.DataType.
	enum ElementType {
		Undefined = 0,
		Float = 1,
		Uint8 = 2,
		Int8 = 3,
		Uint16 = 4,
		Int16 = 5,
		Int32 = 6,
		Int64 = 7,
		String = 8,
		Bool = 9,
		Float16 = 10,
		Double = 11,
		Uint32 = 12,
		Uint64 = 13,
		Complex64 = 14,
		Complex128 = 15,
		BFloat16 = 16,
		Float8E4M3FN = 17,
		Float8E4M3FNUZ = 18,
		Float8E5M2 = 19,
		Float8E5M2FNUZ = 20,
		Uint4 = 21,
		Int4 = 22,
		Float4E2M1 = 23,
		Float8E8M0 = 24,
		Uint2 = 25,
		Int2 = 26,
		Float6E2M3 = 27,
		Float6E3M2 = 28,
	}

	// Bits one element of `t` takes in raw data; 0 for String and
	// Undefined.
	def elementBits(t ElementType) int {
		match t {
			case ElementType.Float, ElementType.Int32, ElementType.Uint32:
				return 32
			case ElementType.Int64, ElementType.Uint64, ElementType.Double, ElementType.Complex64:
				return 64
			case ElementType.Complex128:
				return 128
			case ElementType.Int16, ElementType.Uint16, ElementType.Float16, ElementType.BFloat16:
				return 16
			case ElementType.Uint4, ElementType.Int4, ElementType.Float4E2M1:
				return 4
			case ElementType.Uint2, ElementType.Int2:
				return 2
			case ElementType.Float6E2M3, ElementType.Float6E3M2:
				return 6
			case ElementType.String, ElementType.Undefined:
				return 0
			default:
				return 8
		}
	}

	// Whether `t` holds floating-point values (complex ones included).
	def isFloat(t ElementType) bool {
		return t := ElementType.Float || ElementType.Double || ElementType.Float16 || ElementType.BFloat16 || ElementType.Complex64 || ElementType.Complex128 || ElementType.Float8E4M3FN || ElementType.Float8E4M3FNUZ || ElementType.Float8E5M2 || ElementType.Float8E5M2FNUZ || ElementType.Float8E8M0 || ElementType.Float4E2M1 || ElementType.Float6E2M3 || ElementType.Float6E3M2
	}

	// The kind of an attribute's value, numbered as AttributeProto.AttributeType.
	enum AttributeKind {
		Undefined = 0,
		Float = 1,
		Int = 2,
		String = 3,
		Tensor = 4,
		Graph = 5,
		Floats = 6,
		Ints = 7,
		Strings = 8,
		Tensors = 9,
		Graphs = 10,
		SparseTensor = 11,
		SparseTensors = 12,
		TypeProto = 13,
		TypeProtos = 14,
	}

	// What a value of a graph is.
	enum ValueKind {
		Undefined,
		Tensor,
		Sequence,
		Map,
		Optional,
		SparseTensor,
		Opaque,
	}

	// One dimension of a shape: a size, or a name for a size known only
	// when the model runs (`value` -1); both left out for an unknown one.
	struct Dimension {
		value      int    = -1
		name       string
		denotation string
	}

	// The type of a graph's value: a tensor or sparse tensor of `element`
	// values (with a `shape` when `ranked`), a sequence or optional of
	// `inner`, a map from `key` to `inner`, or an opaque type.
	type ValueType {
		kind       ValueKind
		element    ElementType
		ranked     bool
		shape      Dimension[]
		inner      ?ValueType
		key        ElementType
		denotation string
		// Opaque types' domain and name.
		domain     string
		name       string
	}

	// A named value of a graph: an input, an output, or an intermediate
	// value with a declared type.
	struct ValueInfo {
		name      string
		valueType ValueType
		doc       string
		metadata  map<string, string>
	}

	// A tensor stored in the model: an initializer, a constant or an
	// attribute's value. `data` holds its elements as ONNX's raw data
	// does, little-endian, sub-byte types packed from the low bits; for a
	// file `load` mapped (or its external data files) it is the file's own
	// pages, without a copy. String tensors hold their elements in
	// `strings` instead.
	type TensorData {
		name     string
		element  ElementType
		dims     int[]
		data     byte[]
		strings  byte[][]
		doc      string
		metadata map<string, string>
		// Where external data came from (TensorProto.external_data), empty
		// for data in the model.
		external map<string, string>

		def new() {
			metadata = new map<string, string>()
			external = new map<string, string>()
		}

		// The number of elements: the product of `dims` (1 for a scalar).
		def count() int {
			let n = 1
			for let (_, d) in dims {
				n *= d
			}
			return n
		}

		// The elements as float32: floating-point types converted (Double
		// rounded; Complex64 and Complex128 as real, imaginary pairs),
		// integer and Bool types as their values.
		// Fails for String tensors or data shorter than the elements.
		def floats() !float32[] {
			let n = count()
			let out float32[]
			out.len(n * ((element := ElementType.Complex64 || ElementType.Complex128) ?? (2, 1)))
			match element {
				case ElementType.Float, ElementType.Complex64:
					try need(out.len() * 4)
					for let i = 0; i < out.len(); i++ {
						let a = 4 * i
						out[i] = __bitcast_f32_from_u32(uint32(data[a]) | (uint32(data[a + 1]) << 8) | (uint32(data[a + 2]) << 16) | (uint32(data[a + 3]) << 24))
					}
				case ElementType.Double, ElementType.Complex128:
					try need(out.len() * 8)
					for let i = 0; i < out.len(); i++ {
						out[i] = float32(__bitcast_f64_from_u64(uint64(le(data, 8 * i, 8))))
					}
				case ElementType.Float16:
					try need(n * 2)
					for let i = 0; i < n; i++ {
						out[i] = halfValue(le(data, 2 * i, 2))
					}
				case ElementType.BFloat16:
					try need(n * 2)
					for let i = 0; i < n; i++ {
						out[i] = __bitcast_f32_from_u32(uint32(le(data, 2 * i, 2) << 16))
					}
				case ElementType.Float8E4M3FN, ElementType.Float8E4M3FNUZ, ElementType.Float8E5M2, ElementType.Float8E5M2FNUZ, ElementType.Float8E8M0, ElementType.Float4E2M1, ElementType.Float6E2M3, ElementType.Float6E3M2:
					let codes = try packedCodes()
					for let i = 0; i < n; i++ {
						out[i] = minifloat(element, codes[i])
					}
				case ElementType.String, ElementType.Undefined:
					fail "onnx: tensor {name} holds {element.name} values, not numbers"
				default:
					let values = try ints()
					for let i = 0; i < n; i++ {
						out[i] = float32(values[i])
					}
			}
			return out
		}

		// The elements as float (float64): Double exactly, other types as
		// `floats` reads them.
		// Fails like `floats`.
		def doubles() !float[] {
			let out float[]
			if element := ElementType.Double || ElementType.Complex128 {
				out.len(count() * (element == ElementType.Complex128 ?? (2, 1)))
				try need(out.len() * 8)
				for let i = 0; i < out.len(); i++ {
					out[i] = float(__bitcast_f64_from_u64(uint64(le(data, 8 * i, 8))))
				}
				return out
			}
			for let (_, v) in try floats() {
				out.push(float(v))
			}
			return out
		}

		// The elements as int: the integer types and Bool (0 or 1) as their
		// values (Uint64 above the int range wraps), floating-point types
		// truncated toward zero.
		// Fails for String tensors or data shorter than the elements.
		def ints() !int[] {
			let n = count()
			let out int[]
			out.len(n)
			match element {
				case ElementType.Int64, ElementType.Uint64:
					try need(n * 8)
					for let i = 0; i < n; i++ {
						out[i] = le(data, 8 * i, 8)
					}
				case ElementType.Int32:
					try need(n * 4)
					for let i = 0; i < n; i++ {
						out[i] = int(int32(uint32(le(data, 4 * i, 4))))
					}
				case ElementType.Uint32:
					try need(n * 4)
					for let i = 0; i < n; i++ {
						out[i] = le(data, 4 * i, 4)
					}
				case ElementType.Int16:
					try need(n * 2)
					for let i = 0; i < n; i++ {
						out[i] = int(int16(uint16(le(data, 2 * i, 2))))
					}
				case ElementType.Uint16:
					try need(n * 2)
					for let i = 0; i < n; i++ {
						out[i] = le(data, 2 * i, 2)
					}
				case ElementType.Int8:
					try need(n)
					for let i = 0; i < n; i++ {
						out[i] = int(int8(data[i]))
					}
				case ElementType.Uint8, ElementType.Bool:
					try need(n)
					for let i = 0; i < n; i++ {
						out[i] = int(data[i])
					}
				case ElementType.Int4, ElementType.Uint4, ElementType.Int2, ElementType.Uint2:
					let codes = try packedCodes()
					let bits = elementBits(element)
					let signed = element := ElementType.Int4 || ElementType.Int2
					for let i = 0; i < n; i++ {
						let v = codes[i]
						out[i] = signed && v >= 1 << (bits - 1) ?? (v - (1 << bits), v)
					}
				case ElementType.String, ElementType.Undefined:
					fail "onnx: tensor {name} holds {element.name} values, not numbers"
				default:
					let values = try floats()
					for let i = 0; i < n; i++ {
						out[i] = int(values[i])
					}
			}
			return out
		}

		// The elements of a String tensor as text.
		def texts() string[] {
			let out string[]
			for let (_, s) in strings {
				out.push(string(s))
			}
			return out
		}

		// Fails unless `data` holds at least `bytes` bytes.
		internal def need(bytes int) !none {
			fail "onnx: tensor {name} holds {data.len()} bytes, its {count()} {element.name} elements need {bytes}" when data.len() < bytes
			return none
		}

		// The codes of a type narrower than a byte (or a byte wide, for the
		// 8-bit floats), one per element, unpacked as ONNX packs them.
		internal def packedCodes() !int[] {
			let n = count()
			let bits = elementBits(element)
			try need((n * bits + 7) / 8)
			let out int[]
			out.len(n)
			if bits == 8 {
				for let i = 0; i < n; i++ {
					out[i] = int(data[i])
				}
			} else if bits == 6 {
				// Four codes in three bytes, from the low bits up.
				for let i = 0; i < n; i++ {
					let bit = 6 * i
					let word = int(data[bit / 8]) | (bit / 8 + 1 < data.len() ?? (int(data[bit / 8 + 1]) << 8, 0))
					out[i] = (word >> (bit % 8)) & 63
				}
			} else {
				let per = 8 / bits
				let mask = (1 << bits) - 1
				for let i = 0; i < n; i++ {
					out[i] = (int(data[i / per]) >> (bits * (i % per))) & mask
				}
			}
			return out
		}
	}

	// A sparse tensor: its non-zero `values`, their `indices` (a list of
	// linear indices, or one row of coordinates per value) and the shape
	// of the dense tensor.
	struct SparseTensorData {
		values  TensorData
		indices TensorData
		dims    int[]
	}

	// A node's attribute: its value in the field `kind` names. In a
	// function, `ref` names the function attribute it takes its value from.
	type Attribute {
		name          string
		kind          AttributeKind
		ref           string
		doc           string
		f             float32
		i             int
		s             byte[]
		t             ?TensorData
		g             ?Graph
		sparse        ?SparseTensorData
		typeValue     ?ValueType
		floats        float32[]
		ints          int[]
		strings       byte[][]
		tensors       TensorData[]
		graphs        Graph[]
		sparseTensors SparseTensorData[]
		types         ValueType[]

		// `s` as text.
		def text() string {
			return string(s)
		}
	}

	// One operator of a graph: `op` of `domain` (empty for the default
	// ai.onnx), reading the values named by `inputs` and writing those
	// named by `outputs`; an empty name is an optional input or output
	// left out.
	type Node {
		name       string
		op         string
		domain     string
		overload   string
		inputs     string[]
		outputs    string[]
		attributes Attribute[]
		doc        string
		metadata   map<string, string>

		def new() {
			metadata = new map<string, string>()
		}

		// The attribute called `name`, if the node has one.
		def attribute(name string) ?Attribute {
			for let (_, a) in attributes {
				return a when a.name == name
			}
			return none
		}
	}

	// A computation graph: nodes in an order where every value is written
	// before it is read, the initializers (constant tensors, which may
	// also be inputs given a default), and the declared inputs, outputs
	// and intermediate value types.
	type Graph {
		name               string
		nodes              Node[]
		initializers       TensorData[]
		sparseInitializers SparseTensorData[]
		inputs             ValueInfo[]
		outputs            ValueInfo[]
		values             ValueInfo[]
		doc                string
		metadata           map<string, string>

		def new() {
			metadata = new map<string, string>()
		}

		// The initializer called `name`, if there is one.
		def initializer(name string) ?TensorData {
			for let (_, t) in initializers {
				return t when t.name == name
			}
			return none
		}
	}

	// An operator set a model or function uses: a domain (empty for
	// ai.onnx) and its version.
	struct OpsetId {
		domain  string
		version int
	}

	// A function the model defines: an operator of `domain` called
	// `name`, whose body the nodes are, on the formal `inputs` and
	// `outputs`; `attributes` are its attribute names, `defaults` those
	// given a value.
	type Function {
		name       string
		domain     string
		overload   string
		inputs     string[]
		outputs    string[]
		attributes string[]
		defaults   Attribute[]
		nodes      Node[]
		opsets     OpsetId[]
		values     ValueInfo[]
		doc        string
		metadata   map<string, string>

		def new() {
			metadata = new map<string, string>()
		}
	}

	// An ONNX model: the graph, the operator sets it uses, the functions
	// it defines and its metadata. Loaded from a path, its tensors are the
	// file's own pages (and those of its external data files), mapped and
	// read as they are touched, so a model larger than memory loads.
	type OnnxModel {
		irVersion       int
		producerName    string
		producerVersion string
		domain          string
		modelVersion    int
		doc             string
		opsets          OpsetId[]
		metadata        map<string, string>
		graph           Graph
		functions       Function[]
		internal maps   map<string, os.Mapping>
		internal dir    string

		def new() {
			metadata = new map<string, string>()
			graph = new Graph()
			maps = new map<string, os.Mapping>()
		}

		// The version of operator set `domain` (empty for ai.onnx) the
		// model imports, 0 when it imports none.
		def opset(domain string = "") int {
			for let (_, o) in opsets {
				return o.version when o.domain == domain || (domain == "" && o.domain == "ai.onnx")
			}
			return 0
		}

		// The model as ONNX bytes (a ModelProto), every tensor's data in
		// it: external data is written inline.
		def encode() byte[] {
			return writeModel(self).bytes()
		}

		// Writes the model to `path` (see `encode`).
		// Fails when the file cannot be written.
		def save(path string) !none {
			return os.writeFile(path, encode())
		}

		// Releases the mappings of the file and its external data; the
		// tensors read so far keep their pages.
		def close() {
			for let (_, m) in maps {
				m.close()
			}
			maps = new map<string, os.Mapping>()
		}
	}

	// Reads the ONNX model at `path`, its tensors left in the file's pages
	// (see OnnxModel); external data files are found beside it.
	// Fails when the file cannot be read or mapped, is not a well-formed
	// ModelProto, or names external data that cannot be read.
	def load(path string) !OnnxModel {
		let mapping = try os.mapFile(path, MapAccess.Copy)
		let data = mapping.pages(0, mapping.length()) onerror (err error) {
			mapping.close()
			return err
		}
		let model = new OnnxModel()
		model.dir = os.dir(path)
		model.maps.set("", mapping)
		readModel(model, data) onerror (err error) {
			model.close()
			return err
		}
		return model
	}

	// Reads an ONNX model from `data`; external data files are found in
	// `dir`. Its tensors are views of `data`.
	// Fails when `data` is not a well-formed ModelProto, or names external
	// data that cannot be read.
	def decode(data byte[], dir string = "") !OnnxModel {
		let model = new OnnxModel()
		model.dir = dir
		readModel(model, data) onerror (err error) {
			model.close()
			return err
		}
		return model
	}

	// Reads a serialized TensorProto (as ONNX's test data stores inputs and
	// outputs); its data is a view of `data`.
	// Fails when `data` is not a well-formed TensorProto, or names
	// external data (which a tensor read alone cannot find).
	def decodeTensor(data byte[]) !TensorData {
		let t = try readTensor(new OnnxModel(), data)
		return t
	}

	// The fields of a ModelProto in `data` into `model`.
	internal def readModel(model OnnxModel, data byte[]) !none {
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					model.irVersion = try f.asInt()
				case 2:
					model.producerName = try f.asString()
				case 3:
					model.producerVersion = try f.asString()
				case 4:
					model.domain = try f.asString()
				case 5:
					model.modelVersion = try f.asInt()
				case 6:
					model.doc = try f.asString()
				case 7:
					model.graph = try readGraph(model, try f.payload())
				case 8:
					model.opsets.push(try readOpset(try f.payload()))
				case 14:
					try readEntry(try f.payload(), model.metadata)
				case 25:
					model.functions.push(try readFunction(model, try f.payload()))
				default:
			}
		}
		return none
	}

	internal def readOpset(data byte[]) !OpsetId {
		let id = OpsetId{}
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					id.domain = try f.asString()
				case 2:
					id.version = try f.asInt()
				default:
			}
		}
		return id
	}

	// A StringStringEntryProto into `into`.
	internal def readEntry(data byte[], into map<string, string>) !none {
		let (key, value) = ("", "")
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					key = try f.asString()
				case 2:
					value = try f.asString()
				default:
			}
		}
		into.set(key, value)
		return none
	}

	internal def readGraph(model OnnxModel, data byte[]) !Graph {
		let g = new Graph()
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					g.nodes.push(try readNode(model, try f.payload()))
				case 2:
					g.name = try f.asString()
				case 5:
					g.initializers.push(try readTensor(model, try f.payload()))
				case 15:
					g.sparseInitializers.push(try readSparse(model, try f.payload()))
				case 10:
					g.doc = try f.asString()
				case 11:
					g.inputs.push(try readValueInfo(try f.payload()))
				case 12:
					g.outputs.push(try readValueInfo(try f.payload()))
				case 13:
					g.values.push(try readValueInfo(try f.payload()))
				case 16:
					try readEntry(try f.payload(), g.metadata)
				default:
			}
		}
		return g
	}

	internal def readNode(model OnnxModel, data byte[]) !Node {
		let n = new Node()
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					n.inputs.push(try f.asString())
				case 2:
					n.outputs.push(try f.asString())
				case 3:
					n.name = try f.asString()
				case 4:
					n.op = try f.asString()
				case 5:
					n.attributes.push(try readAttribute(model, try f.payload()))
				case 6:
					n.doc = try f.asString()
				case 7:
					n.domain = try f.asString()
				case 8:
					n.overload = try f.asString()
				case 9:
					try readEntry(try f.payload(), n.metadata)
				default:
			}
		}
		return n
	}

	internal def readAttribute(model OnnxModel, data byte[]) !Attribute {
		let a = new Attribute()
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					a.name = try f.asString()
				case 21:
					a.ref = try f.asString()
				case 13:
					a.doc = try f.asString()
				case 20:
					a.kind = AttributeKind(int(try f.asInt()))
				case 2:
					a.f = try f.asFloat32()
				case 3:
					a.i = try f.asInt()
				case 4:
					a.s = try f.asBytes()
				case 5:
					a.t = try readTensor(model, try f.payload())
				case 6:
					a.g = try readGraph(model, try f.payload())
				case 22:
					a.sparse = try readSparse(model, try f.payload())
				case 14:
					a.typeValue = try readType(try f.payload())
				case 7:
					a.floats.push(...(try f.asFloat32s()))
				case 8:
					a.ints.push(...(try f.asInts()))
				case 9:
					a.strings.push(try f.asBytes())
				case 10:
					a.tensors.push(try readTensor(model, try f.payload()))
				case 11:
					a.graphs.push(try readGraph(model, try f.payload()))
				case 23:
					a.sparseTensors.push(try readSparse(model, try f.payload()))
				case 15:
					a.types.push(try readType(try f.payload()))
				default:
			}
		}
		return a
	}

	internal def readFunction(model OnnxModel, data byte[]) !Function {
		let fn = new Function()
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					fn.name = try f.asString()
				case 4:
					fn.inputs.push(try f.asString())
				case 5:
					fn.outputs.push(try f.asString())
				case 6:
					fn.attributes.push(try f.asString())
				case 11:
					fn.defaults.push(try readAttribute(model, try f.payload()))
				case 7:
					fn.nodes.push(try readNode(model, try f.payload()))
				case 8:
					fn.doc = try f.asString()
				case 9:
					fn.opsets.push(try readOpset(try f.payload()))
				case 10:
					fn.domain = try f.asString()
				case 13:
					fn.overload = try f.asString()
				case 12:
					fn.values.push(try readValueInfo(try f.payload()))
				case 14:
					try readEntry(try f.payload(), fn.metadata)
				default:
			}
		}
		return fn
	}

	internal def readValueInfo(data byte[]) !ValueInfo {
		let info = ValueInfo{valueType: new ValueType(), metadata: new map<string, string>()}
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					info.name = try f.asString()
				case 2:
					info.valueType = try readType(try f.payload())
				case 3:
					info.doc = try f.asString()
				case 4:
					try readEntry(try f.payload(), info.metadata)
				default:
			}
		}
		return info
	}

	internal def readType(data byte[]) !ValueType {
		let t = new ValueType()
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1, 8:
					t.kind = f.number == 1 ?? (ValueKind.Tensor, ValueKind.SparseTensor)
					let inner = new ProtoReader(try f.payload())
					for inner.more() {
						let g = try inner.next()
						if g.number == 1 {
							t.element = ElementType(int(try g.asInt()))
						} else if g.number == 2 {
							t.ranked = true
							t.shape = try readShape(try g.payload())
						}
					}
				case 4, 9:
					t.kind = f.number == 4 ?? (ValueKind.Sequence, ValueKind.Optional)
					let inner = new ProtoReader(try f.payload())
					for inner.more() {
						let g = try inner.next()
						t.inner = try readType(try g.payload()) when g.number == 1
					}
				case 5:
					t.kind = ValueKind.Map
					let inner = new ProtoReader(try f.payload())
					for inner.more() {
						let g = try inner.next()
						if g.number == 1 {
							t.key = ElementType(int(try g.asInt()))
						} else if g.number == 2 {
							t.inner = try readType(try g.payload())
						}
					}
				case 7:
					t.kind = ValueKind.Opaque
					let inner = new ProtoReader(try f.payload())
					for inner.more() {
						let g = try inner.next()
						if g.number == 1 {
							t.domain = try g.asString()
						} else if g.number == 2 {
							t.name = try g.asString()
						}
					}
				case 6:
					t.denotation = try f.asString()
				default:
			}
		}
		return t
	}

	internal def readShape(data byte[]) !Dimension[] {
		let dims Dimension[]
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			continue unless f.number == 1
			let d = Dimension{}
			let inner = new ProtoReader(try f.payload())
			for inner.more() {
				let g = try inner.next()
				match g.number {
					case 1:
						d.value = try g.asInt()
					case 2:
						d.name = try g.asString()
					case 3:
						d.denotation = try g.asString()
					default:
				}
			}
			dims.push(d)
		}
		return dims
	}

	internal def readSparse(model OnnxModel, data byte[]) !SparseTensorData {
		let s = SparseTensorData{values: new TensorData(), indices: new TensorData()}
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					s.values = try readTensor(model, try f.payload())
				case 2:
					s.indices = try readTensor(model, try f.payload())
				case 3:
					s.dims.push(...(try f.asInts()))
				default:
			}
		}
		return s
	}

	// A TensorProto: raw data as a view of `data`, typed fields packed
	// into raw form, external data read from its file.
	internal def readTensor(model OnnxModel, data byte[]) !TensorData {
		let t = new TensorData()
		let (floats, doubles) = (float32[], float[])
		let (int32s, int64s, uint64s) = (int[], int[], int[])
		let raw = false
		let external = false
		let r = new ProtoReader(data)
		for r.more() {
			let f = try r.next()
			match f.number {
				case 1:
					t.dims.push(...(try f.asInts()))
				case 2:
					t.element = ElementType(int(try f.asInt()))
				case 4:
					floats.push(...(try f.asFloat32s()))
				case 5:
					for let (_, v) in try f.asInt32s() {
						int32s.push(int(v))
					}
				case 6:
					t.strings.push(try f.asBytes())
				case 7:
					int64s.push(...(try f.asInts()))
				case 8:
					t.name = try f.asString()
				case 12:
					t.doc = try f.asString()
				case 9:
					t.data = try f.payload()
					raw = true
				case 13:
					try readEntry(try f.payload(), t.external)
				case 14:
					external = (try f.asInt()) == 1
				case 10:
					doubles.push(...(try f.asFloats()))
				case 11:
					for let (_, v) in try f.asUints() {
						uint64s.push(int(v))
					}
				case 16:
					try readEntry(try f.payload(), t.metadata)
				default:
			}
		}
		if external {
			t.data = try externalData(model, t)
		} else if !raw {
			t.data = packTyped(t.element, floats, doubles, int32s, int64s, uint64s)
		}
		return t
	}

	// The bytes of a tensor whose data lies in an external file: pages
	// of the file (mapped once per model) at the entry's offset.
	internal def externalData(model OnnxModel, t TensorData) !byte[] {
		let location = t.external.get("location")
		fail "onnx: tensor {t.name} has external data without a location" when location is none
		let offsetText = t.external.get("offset")
		let lengthText = t.external.get("length")
		let offset = offsetText is none ?? (0, offsetText.toInt<int>())
		let length = lengthText is none ?? (-1, lengthText.toInt<int>())
		fail "onnx: tensor {t.name} names external data outside the model's folder: {location}" when location.contains("..") || location.startsWith("/")
		let mapping = model.maps.get(location)
		if mapping is none {
			let opened = try os.mapFile(os.join(model.dir, location), MapAccess.Copy)
			model.maps.set(location, opened)
			mapping = opened
		}
		let m = model.maps.get(location)
		fail "onnx: external data {location} could not be mapped" when m is none
		let size = length < 0 ?? (m.length() - offset, length)
		fail "onnx: tensor {t.name} reads {size} bytes at {offset} of {location}, which holds {m.length()}" when offset < 0 || size < 0 || offset + size > m.length()
		return size == 0 ?? (byte[], try m.pages(offset, size))
	}

	// The raw form of data given in TensorProto's typed fields.
	internal def packTyped(element ElementType, floats float32[], doubles float[], int32s int[], int64s int[], uint64s int[]) byte[] {
		let out byte[]
		match element {
			case ElementType.Float, ElementType.Complex64:
				for let (_, v) in floats {
					put(out, int(__bitcast_u32_from_f32(v)), 4)
				}
			case ElementType.Double, ElementType.Complex128:
				for let (_, v) in doubles {
					put(out, int(__bitcast_u64_from_f64(v)), 8)
				}
			case ElementType.Int64:
				for let (_, v) in int64s {
					put(out, v, 8)
				}
			case ElementType.Uint32:
				for let (_, v) in uint64s {
					put(out, v, 4)
				}
			case ElementType.Uint64:
				for let (_, v) in uint64s {
					put(out, v, 8)
				}
			case ElementType.Int32:
				for let (_, v) in int32s {
					put(out, v, 4)
				}
			case ElementType.Int16, ElementType.Uint16, ElementType.Float16, ElementType.BFloat16:
				for let (_, v) in int32s {
					put(out, v, 2)
				}
			case ElementType.Float6E2M3, ElementType.Float6E3M2:
				// One code per int32: packed four to three bytes.
				let bits = 0
				let acc = 0
				for let (_, v) in int32s {
					acc |= (v & 63) << bits
					bits += 6
					for bits >= 8 {
						out.push(byte(acc & 255))
						acc >>= 8
						bits -= 8
					}
				}
				out.push(byte(acc & 255)) when bits > 0
			default:
				// One byte per int32: the 8-bit types, and the 4- and 2-bit
				// types already packed into bytes.
				for let (_, v) in int32s {
					out.push(byte(v & 255))
				}
		}
		return out
	}

	// The little-endian unsigned value of `count` bytes of `data` at `at`.
	internal def le(data byte[], at int, count int) int {
		let v = 0
		for let k = count - 1; k >= 0; k-- {
			v = (v << 8) | int(data[at + k])
		}
		return v
	}

	internal def put(out byte[], v int, count int) {
		for let k = 0; k < count; k++ {
			out.push(byte((v >> (8 * k)) & 255))
		}
	}

	// The value of IEEE half-precision bits `h`.
	def halfValue(h int) float32 {
		let sign = (h >> 15) & 1
		let exponent = (h >> 10) & 31
		let mantissa = h & 1023
		let bits = 0
		if exponent == 0 {
			if mantissa == 0 {
				bits = sign << 31
			} else {
				// A subnormal half is a normal float.
				let e = -1
				let m = mantissa
				for m & 1024 == 0 {
					m <<= 1
					e--
				}
				bits = (sign << 31) | ((e + 127 - 14) << 23) | ((m & 1023) << 13)
			}
		} else if exponent == 31 {
			bits = (sign << 31) | (255 << 23) | (mantissa << 13)
		} else {
			bits = (sign << 31) | ((exponent - 15 + 127) << 23) | (mantissa << 13)
		}
		return __bitcast_f32_from_u32(uint32(bits))
	}

	// The value of code `c` of a floating-point type narrower than 16 bits.
	def minifloat(element ElementType, c int) float32 {
		match element {
			case ElementType.Float8E8M0:
				return c == 255 ?? (float32(0) / float32(0), float32(2.0 ** float(c - 127)))
			case ElementType.Float8E4M3FN:
				return (c & 127) == 127 ?? (float32(0) / float32(0), decodeMini(c, 4, 3, 7))
			case ElementType.Float8E4M3FNUZ:
				return c == 128 ?? (float32(0) / float32(0), decodeMini(c, 4, 3, 8))
			case ElementType.Float8E5M2:
				if (c >> 2) & 31 == 31 {
					let sign = c >> 7 == 1 ?? (float32(-1), float32(1))
					return c & 3 == 0 ?? (sign / float32(0), float32(0) / float32(0))
				}
				return decodeMini(c, 5, 2, 15)
			case ElementType.Float8E5M2FNUZ:
				return c == 128 ?? (float32(0) / float32(0), decodeMini(c, 5, 2, 16))
			case ElementType.Float4E2M1:
				return decodeMini(c, 2, 1, 1)
			case ElementType.Float6E2M3:
				return decodeMini(c, 2, 3, 1)
			case ElementType.Float6E3M2:
				return decodeMini(c, 3, 2, 3)
			default:
				return float32(0)
		}
	}

	// A finite sign-exponent-mantissa code of `e` exponent and `m`
	// mantissa bits with exponent bias `bias`; exponent 0 is subnormal.
	internal def decodeMini(c int, e int, m int, bias int) float32 {
		let sign = (c >> (e + m)) & 1 == 1 ?? (-1.0, 1.0)
		let exponent = (c >> m) & ((1 << e) - 1)
		let mantissa = float(c & ((1 << m) - 1)) / float(1 << m)
		if exponent == 0 {
			return float32(sign * mantissa * 2.0 ** float(1 - bias))
		}
		return float32(sign * (1.0 + mantissa) * 2.0 ** float(exponent - bias))
	}

	// The ModelProto of `model`.
	internal def writeModel(model OnnxModel) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, model.irVersion)
		for let (_, o) in model.opsets {
			w.write(8, writeOpset(o))
		}
		w.write(2, model.producerName) when model.producerName.len() > 0
		w.write(3, model.producerVersion) when model.producerVersion.len() > 0
		w.write(4, model.domain) when model.domain.len() > 0
		w.write(5, model.modelVersion) when model.modelVersion != 0
		w.write(6, model.doc) when model.doc.len() > 0
		w.write(7, writeGraph(model.graph))
		writeEntries(w, 14, model.metadata)
		for let (_, f) in model.functions {
			w.write(25, writeFunction(f))
		}
		return w
	}

	internal def writeOpset(o OpsetId) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, o.domain) when o.domain.len() > 0
		w.write(2, o.version)
		return w
	}

	internal def writeEntries(w ProtoWriter, field int, entries map<string, string>) {
		for let (key, value) in entries {
			let e = new ProtoWriter()
			e.write(1, key)
			e.write(2, value)
			w.write(field, e)
		}
	}

	internal def writeGraph(g Graph) ProtoWriter {
		let w = new ProtoWriter()
		for let (_, n) in g.nodes {
			w.write(1, writeNode(n))
		}
		w.write(2, g.name) when g.name.len() > 0
		for let (_, t) in g.initializers {
			w.write(5, writeTensor(t))
		}
		w.write(10, g.doc) when g.doc.len() > 0
		for let (_, v) in g.inputs {
			w.write(11, writeValueInfo(v))
		}
		for let (_, v) in g.outputs {
			w.write(12, writeValueInfo(v))
		}
		for let (_, v) in g.values {
			w.write(13, writeValueInfo(v))
		}
		for let (_, s) in g.sparseInitializers {
			w.write(15, writeSparse(s))
		}
		writeEntries(w, 16, g.metadata)
		return w
	}

	internal def writeNode(n Node) ProtoWriter {
		let w = new ProtoWriter()
		for let (_, i) in n.inputs {
			w.write(1, i)
		}
		for let (_, o) in n.outputs {
			w.write(2, o)
		}
		w.write(3, n.name) when n.name.len() > 0
		w.write(4, n.op)
		for let (_, a) in n.attributes {
			w.write(5, writeAttribute(a))
		}
		w.write(6, n.doc) when n.doc.len() > 0
		w.write(7, n.domain) when n.domain.len() > 0
		w.write(8, n.overload) when n.overload.len() > 0
		writeEntries(w, 9, n.metadata)
		return w
	}

	internal def writeAttribute(a Attribute) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, a.name)
		w.write(21, a.ref) when a.ref.len() > 0
		w.write(13, a.doc) when a.doc.len() > 0
		w.write(20, a.kind.value)
		match a.kind {
			case AttributeKind.Float:
				w.write(2, a.f)
			case AttributeKind.Int:
				w.write(3, a.i)
			case AttributeKind.String:
				w.write(4, a.s)
			case AttributeKind.Tensor:
				let t = a.t
				w.write(5, writeTensor(t)) when t is TensorData
			case AttributeKind.Graph:
				let g = a.g
				w.write(6, writeGraph(g)) when g is Graph
			case AttributeKind.SparseTensor:
				let s = a.sparse
				w.write(22, writeSparse(s)) when s is SparseTensorData
			case AttributeKind.TypeProto:
				let t = a.typeValue
				w.write(14, writeType(t)) when t is ValueType
			case AttributeKind.Floats:
				w.writePacked(7, a.floats)
			case AttributeKind.Ints:
				w.writePacked(8, a.ints)
			case AttributeKind.Strings:
				for let (_, s) in a.strings {
					w.write(9, s)
				}
			case AttributeKind.Tensors:
				for let (_, t) in a.tensors {
					w.write(10, writeTensor(t))
				}
			case AttributeKind.Graphs:
				for let (_, g) in a.graphs {
					w.write(11, writeGraph(g))
				}
			case AttributeKind.SparseTensors:
				for let (_, s) in a.sparseTensors {
					w.write(23, writeSparse(s))
				}
			case AttributeKind.TypeProtos:
				for let (_, t) in a.types {
					w.write(15, writeType(t))
				}
			default:
		}
		return w
	}

	internal def writeFunction(f Function) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, f.name)
		for let (_, i) in f.inputs {
			w.write(4, i)
		}
		for let (_, o) in f.outputs {
			w.write(5, o)
		}
		for let (_, a) in f.attributes {
			w.write(6, a)
		}
		for let (_, n) in f.nodes {
			w.write(7, writeNode(n))
		}
		w.write(8, f.doc) when f.doc.len() > 0
		for let (_, o) in f.opsets {
			w.write(9, writeOpset(o))
		}
		w.write(10, f.domain) when f.domain.len() > 0
		for let (_, a) in f.defaults {
			w.write(11, writeAttribute(a))
		}
		for let (_, v) in f.values {
			w.write(12, writeValueInfo(v))
		}
		w.write(13, f.overload) when f.overload.len() > 0
		writeEntries(w, 14, f.metadata)
		return w
	}

	internal def writeValueInfo(v ValueInfo) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, v.name)
		w.write(2, writeType(v.valueType))
		w.write(3, v.doc) when v.doc.len() > 0
		writeEntries(w, 4, v.metadata) when v.metadata is map<string, string>
		return w
	}

	internal def writeType(t ValueType) ProtoWriter {
		let w = new ProtoWriter()
		match t.kind {
			case ValueKind.Tensor, ValueKind.SparseTensor:
				let inner = new ProtoWriter()
				inner.write(1, t.element.value)
				if t.ranked {
					let shape = new ProtoWriter()
					for let (_, d) in t.shape {
						let dim = new ProtoWriter()
						if d.name.len() > 0 {
							dim.write(2, d.name)
						} else if d.value >= 0 {
							dim.write(1, d.value)
						}
						dim.write(3, d.denotation) when d.denotation.len() > 0
						shape.write(1, dim)
					}
					inner.write(2, shape)
				}
				w.write(t.kind == ValueKind.Tensor ?? (1, 8), inner)
			case ValueKind.Sequence, ValueKind.Optional:
				let inner = new ProtoWriter()
				let elem = t.inner
				inner.write(1, writeType(elem)) when elem is ValueType
				w.write(t.kind == ValueKind.Sequence ?? (4, 9), inner)
			case ValueKind.Map:
				let inner = new ProtoWriter()
				inner.write(1, t.key.value)
				let value = t.inner
				inner.write(2, writeType(value)) when value is ValueType
				w.write(5, inner)
			case ValueKind.Opaque:
				let inner = new ProtoWriter()
				inner.write(1, t.domain) when t.domain.len() > 0
				inner.write(2, t.name) when t.name.len() > 0
				w.write(7, inner)
			default:
		}
		w.write(6, t.denotation) when t.denotation.len() > 0
		return w
	}

	internal def writeTensor(t TensorData) ProtoWriter {
		let w = new ProtoWriter()
		w.writePacked(1, t.dims)
		w.write(2, t.element.value)
		for let (_, s) in t.strings {
			w.write(6, s)
		}
		w.write(8, t.name) when t.name.len() > 0
		w.write(9, t.data) when t.element != ElementType.String
		w.write(12, t.doc) when t.doc.len() > 0
		writeEntries(w, 16, t.metadata)
		return w
	}

	internal def writeSparse(s SparseTensorData) ProtoWriter {
		let w = new ProtoWriter()
		w.write(1, writeTensor(s.values))
		w.write(2, writeTensor(s.indices))
		w.writePacked(3, s.dims)
		return w
	}
}
