partial module std.formats.ai.onnx {
	use (
		std.os
		std.testing
	)

	// Written by the Python onnx package (1.23) with ml_dtypes: every
	// element type as raw data and in the typed fields, a sparse
	// initializer, an If with two subgraphs, a local function, symbolic
	// and unknown dimensions, model properties; and a model whose large
	// tensor lies in an external file.
	@embed("testdata/reader.onnx")
	const readerModel byte[]

	@embed("testdata/external.onnx")
	const externalModel byte[]

	@embed("testdata/external.bin")
	const externalBin byte[]

	check "ONNX models" {
		internal def text(s ?string) string {
			return s is string ?? (s, "")
		}

		internal def attributeOf(n Node, name string) !Attribute {
			let a = n.attribute(name)
			fail "no attribute {name}" unless a is Attribute
			return a
		}

		internal def tensorOf(model OnnxModel, name string) !TensorData {
			let t = model.graph.initializer(name)
			fail "no initializer {name}" when t is none
			return t
		}

		internal def floatsOf(model OnnxModel, name string) !float32[] {
			return (try tensorOf(model, name)).floats()
		}

		internal def intsOf(model OnnxModel, name string) !int[] {
			return (try tensorOf(model, name)).ints()
		}

		@test()
		def TestModelProperties() !none {
			let m = try decode(readerModel)
			assert m.irVersion == 10 && m.producerName == "adm-fixture" && m.producerVersion == "1.0"
			assert m.modelVersion == 7 && m.doc == "reader fixture"
			assert m.opset() == 21 && m.opset("local") == 1 && m.opset("absent") == 0
			assert text(m.metadata.get("author")) == "adm" && text(m.metadata.get("license")) == "MIT"
			return none
		}

		@test()
		def TestEveryElementType() !none {
			let m = try decode(readerModel)
			let f32 = try tensorOf(m, "f32")
			assert f32.element == ElementType.Float && f32.dims.equals(int[2, 3]) && f32.count() == 6
			assert (try f32.floats()).equals(float32[1.5, -2.25, 3, 0, -0.5, 7])
			let f64 = try (try tensorOf(m, "f64")).doubles()
			assert f64[0] == 1.0 / 3.0 && f64[1] == -2.5
			assert (try floatsOf(m, "f16")).equals(float32[0.5, -1, 65504, 0.00006103515625])
			assert (try intsOf(m, "i8")).equals(int[-128, 127, -1])
			assert (try intsOf(m, "u8")).equals(int[0, 255, 7])
			assert (try intsOf(m, "i16")).equals(int[-32768, 32767])
			assert (try intsOf(m, "u16")).equals(int[65535, 1])
			assert (try intsOf(m, "i32")).equals(int[-2147483648, 5])
			assert (try intsOf(m, "u32")).equals(int[4294967295, 9])
			assert (try intsOf(m, "i64")).equals(int[-9223372036854775807 - 1, 1 << 40])
			assert (try intsOf(m, "b")).equals(int[1, 0, 1])
			assert (try floatsOf(m, "bf16")).equals(float32[1, -3.5, 0.15625])
			assert (try floatsOf(m, "e4m3")).equals(float32[0.5, -448, 0.001953125])
			let e5m2 = try floatsOf(m, "e5m2")
			assert e5m2[0] == float32(1.5) && e5m2[1] == float32(-57344) && e5m2[2] > float32(3.4e38)
			assert (try floatsOf(m, "e4m3uz")).equals(float32[0.25, -240])
			assert (try floatsOf(m, "e5m2uz")).equals(float32[3, -0.0078125])
			assert (try floatsOf(m, "e8m0")).equals(float32[1, 0.25, 1024])
			assert (try intsOf(m, "i4")).equals(int[-8, 7, -1])
			assert (try intsOf(m, "u4")).equals(int[15, 0, 9])
			assert (try floatsOf(m, "f4")).equals(float32[0.5, -6, 1.5])
			assert (try intsOf(m, "i2")).equals(int[-2, 1, -1, 0, 1])
			assert (try intsOf(m, "u2")).equals(int[3, 0, 2, 1, 3])
			assert (try floatsOf(m, "f6a")).equals(float32[1.125, -7.5, 0.125, 3, 0.5])
			assert (try floatsOf(m, "f6b")).equals(float32[1.25, -28, 0.0625, 3, 0.5])
			return none
		}

		@test()
		def TestTypedFields() !none {
			let m = try decode(readerModel)
			assert (try floatsOf(m, "tf32")).equals(float32[1.25, -4])
			assert (try intsOf(m, "ti64")).equals(int[1, -2, 1 << 50])
			// The fixture gave helper.make_tensor the bits of 1.5 and -2 as
			// numbers, which it stored as the halves of 15872 and 49152.
			assert (try floatsOf(m, "tf16")).equals(float32[15872, 49152])
			assert (try intsOf(m, "tbool")).equals(int[1, 0])
			assert (try (try tensorOf(m, "tf64")).doubles())[0] == 0.1
			// Above the int range a Uint64 wraps.
			assert (try intsOf(m, "tu64"))[0] == -9223372036854775807 - 1
			let text = try tensorOf(m, "str")
			assert text.element == ElementType.String && text.texts().equals(string["alpha", "été"])
			let failed = false
			text.floats() onerror (err error) {
				failed = err.message.contains("String")
				recover float32[]
			}
			assert failed
			let scalar = try tensorOf(m, "scalar")
			assert scalar.dims.len() == 0 && scalar.count() == 1 && (try scalar.floats()).equals(float32[42])
			return none
		}

		@test()
		def TestGraph() !none {
			let g = (try decode(readerModel)).graph
			assert g.name == "main" && g.nodes.len() == 4
			let choose = g.nodes[0]
			assert choose.op == "If" && choose.name == "choose" && choose.inputs.equals(string["cond"]) && choose.outputs.equals(string["picked"])
			let then = try attributeOf(choose, "then_branch")
			assert then.kind == AttributeKind.Graph
			let branch = then.g
			fail "no then branch" unless branch is Graph
			assert branch.nodes[0].op == "Identity" && branch.outputs[0].name == "r"
			let scale = g.nodes[1]
			assert scale.domain == "local" && scale.op == "Scale"
			let factor = try attributeOf(scale, "factor")
			assert factor.kind == AttributeKind.Float && factor.f == float32(2.5)
			let constant = g.nodes[2]
			let floats = try attributeOf(constant, "value_floats")
			assert floats.kind == AttributeKind.Floats && floats.floats.equals(float32[1, 2]) && constant.doc == "two"
			let cast = g.nodes[3]
			assert cast.inputs.equals(string["x", ""])
			let to = try attributeOf(cast, "to")
			assert to.kind == AttributeKind.Int && to.i == 7
			let strs = try attributeOf(cast, "strs")
			assert strs.strings.len() == 2 && string(strs.strings[1]) == "bc"
			assert (try attributeOf(cast, "ints")).ints.equals(int[3, -4])
			assert cast.attribute("absent") is none
			// A shape of a name, a size and an unknown dimension; a sequence.
			let x = g.inputs[1]
			assert x.name == "x" && x.valueType.kind == ValueKind.Tensor && x.valueType.element == ElementType.Float && x.valueType.ranked
			let dims = x.valueType.shape
			assert dims.len() == 3 && dims[0].name == "batch" && dims[0].value == -1 && dims[1].value == 3 && dims[2].value == -1 && dims[2].name == ""
			assert g.inputs[0].valueType.ranked && g.inputs[0].valueType.shape.len() == 0
			let seq = g.outputs[1].valueType
			let inner = seq.inner
			fail "no sequence element type" unless inner is ValueType
			assert seq.kind == ValueKind.Sequence && inner.element == ElementType.Int64 && inner.shape[0].value == 4
			let sparse = g.sparseInitializers[0]
			assert (try sparse.values.floats()).equals(float32[5, 6]) && (try sparse.indices.ints()).equals(int[1, 4]) && sparse.dims.equals(int[2, 3])
			return none
		}

		@test()
		def TestFunctions() !none {
			let m = try decode(readerModel)
			assert m.functions.len() == 1
			let f = m.functions[0]
			assert f.name == "Scale" && f.domain == "local" && f.inputs.equals(string["X"]) && f.outputs.equals(string["Y"])
			assert f.attributes.equals(string["factor"]) && f.nodes.len() == 2 && f.nodes[1].op == "Mul"
			assert f.opsets.len() == 1 && f.opsets[0].version == 21
			return none
		}

		@test()
		def TestEncodeRoundTrip() !none {
			let first = try decode(readerModel)
			let again = try decode(first.encode())
			assert again.irVersion == 10 && again.opset("local") == 1 && text(again.metadata.get("license")) == "MIT"
			assert again.graph.nodes.len() == 4 && again.graph.initializers.len() == first.graph.initializers.len()
			for let (_, t) in first.graph.initializers {
				let other = again.graph.initializer(t.name)
				fail "{t.name} lost" unless other is TensorData
				assert other.element == t.element && other.dims.equals(t.dims) && other.data.equals(t.data) && other.texts().equals(t.texts())
			}
			assert (try attributeOf(again.graph.nodes[0], "else_branch")).g is Graph
			assert again.functions[0].nodes.len() == 2 && again.graph.inputs[1].valueType.shape[0].name == "batch"
			assert (try again.graph.sparseInitializers[0].indices.ints()).equals(int[1, 4])
			return none
		}

		@test()
		def TestExternalData() !none {
			let dir = os.join(try os.appHome(), "onnx-external")
			try os.mkdir(dir, parents = true)
			try os.writeFile(os.join(dir, "external.onnx"), externalModel)
			try os.writeFile(os.join(dir, "external.bin"), externalBin)
			let m = try load(os.join(dir, "external.onnx"))
			let big = try tensorOf(m, "big")
			assert big.dims.equals(int[10, 100]) && text(big.external.get("location")) == "external.bin"
			let values = try big.floats()
			assert values.len() == 1000 && values[0] == float32(0) && values[999] == float32(999)
			assert (try (try tensorOf(m, "small")).ints()).equals(int[7, 8])
			m.close()
			// The tensor keeps its pages after close.
			assert (try big.floats())[500] == float32(500)
			// From bytes, the external file is found in the folder given.
			let fromBytes = try decode(externalModel, dir)
			assert (try (try tensorOf(fromBytes, "big")).floats())[10] == float32(10)
			fromBytes.close()
			let missing = false
			decode(externalModel, os.join(dir, "absent")) onerror (err error) {
				missing = true
				recover new OnnxModel()
			}
			assert missing
			return none
		}

		@test()
		def TestMalformed() !none {
			let failed = false
			decode(byte[0x0A, 0x05, 0x01]) onerror (err error) {
				failed = true
				recover new OnnxModel()
			}
			assert failed
			return none
		}
	}
}
