partial module std.formats.ai {
	use (
		std.io
		std.formats.video.media.source
		std.formats.ai.store::*
		std.formats.ai.safetensors::*
	)

	// Hugging Face safetensors: an 8-byte header length, a JSON header naming
	// each tensor's dtype, shape and byte range, then the raw little-endian
	// tensor data. Metadata is string-to-string.
	@codec("Safetensors")
	type Safetensors {
		extension string[] {
			def get() string[] {
				return string[".safetensors"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["application/x-safetensors"]
			}
		}

		// matchSignature implements SignatureMatcher: a header length below
		// 100 MB followed by the header's opening brace.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(9)
			let n = r.read(head) onerror recover 0
			return false unless n == 9 && head[8] == byte(0x7B)
			let size = le(head, 0, 8)
			return size > 1 && size < maxHeader
		}

		// decode implements ModelDecoder. A file or byte reader is read in
		// place; any other reader is read into memory first.
		// Fails when the data is not safetensors, its header is not valid
		// JSON, a tensor's dtype has no `TensorType`, a byte range does not
		// match its shape, or the reader fails.
		def decode(reader io.Reader) !ModelFile {
			let src = try source.randomSource(reader)
			let (info, dataStart) = try readTensorsHeader(src)
			return new ModelFile(info, new TensorStore(src.reader, dataStart))
		}

		// info implements ModelDecoder: the header only.
		// Fails like `decode`.
		def info(reader io.Reader) !ModelInfo {
			let (info, _) = try readTensorsHeader(new source.Source(reader))
			return info
		}

		// encode implements ModelEncoder: tensors in directory order, the
		// header padded with spaces to 8 bytes. Metadata strings are written
		// as they are; numbers and booleans as their text, arrays as JSON
		// array text.
		// Fails when a tensor is quantized (safetensors has no block types),
		// a tensor cannot be read, or the writer fails.
		def encode(file ModelFile, writer io.Writer) !none {
			return writeTensorsFile(file, writer)
		}
	}
}

internal partial module std.formats.ai.safetensors {
	use (
		std.io
		std.bytes
		std.data.encoding::(JSON, json)
		std.formats.video.media.source
		std.formats.ai::*
		std.formats.ai.store::*
	)

	// The largest header accepted, as the reference implementation does.
	const maxHeader = 100000000

	// One tensor as the header describes it.
	struct Entry {
		dtype string
		shape int[]
		@json("data_offsets")
		offsets int[]
	}

	// The header's tensors, read as a map (the metadata entry reads as an
	// empty `Entry` and is skipped).
	struct Tensors {
		entries map<string, Entry>
	}

	// The header's metadata.
	struct Header {
		@json("__metadata__")
		metadata map<string, string>
	}

	// The header's metadata and tensor directory, and the file offset where
	// the tensor data starts.
	// Fails when the data is not safetensors, the JSON is not valid, a dtype
	// has no `TensorType`, or a byte range does not match its shape.
	def readTensorsHeader(src source.Source) !(ModelInfo, int) {
		let size = try src.le(8)
		fail "safetensors: header of {size} bytes" unless size > 1 && size < maxHeader
		let text = try src.read(size)
		fail "safetensors: not a safetensors file" unless text[0] == byte(0x7B)
		let codec = new JSON()
		let tensors = Tensors{}
		let wrapped = "\{\"entries\":".bytes()
		wrapped.push(...text)
		wrapped.push(byte(0x7D))
		try codec.decode(wrapped, tensors)
		let header = Header{}
		try codec.decode(text, header)

		let metadata = map<string, MetaValue>{}
		for let (key, value) in header.metadata {
			metadata[key] = value
		}
		let list TensorInfo[]
		for let (name, e) in tensors.entries {
			continue when name == "__metadata__"
			let kind = dtypeKind(e.dtype)
			fail "safetensors: tensor {name} is {e.dtype}, which has no TensorType" when kind is none
			fail "safetensors: tensor {name} has no byte range" unless e.offsets.len() == 2
			let shape int[]
			let count = 1
			for let i = e.shape.len() - 1; i >= 0; i-- {
				shape.push(e.shape[i])
				count *= e.shape[i]
			}
			let byteSize = count * blockBytes(kind)
			fail "safetensors: tensor {name} spans {e.offsets[1] - e.offsets[0]} bytes, its shape needs {byteSize}" unless e.offsets[1] - e.offsets[0] == byteSize
			list.push(TensorInfo{
				name:     name,
				kind:     kind,
				shape:    shape,
				offset:   e.offsets[0],
				count:    count,
				byteSize: byteSize,
			})
		}
		list.sort((a TensorInfo, b TensorInfo) => a.offset < b.offset)
		return (ModelInfo{metadata: metadata, tensors: list}, 8 + size)
	}

	// The tensor type of a safetensors dtype, `none` for dtypes TensorType
	// does not list (unsigned, BOOL, 8-bit floats).
	def dtypeKind(dtype string) ?TensorType {
		match dtype {
			case "F64":
				return TensorType.F64
			case "F32":
				return TensorType.F32
			case "F16":
				return TensorType.F16
			case "BF16":
				return TensorType.BF16
			case "I64":
				return TensorType.I64
			case "I32":
				return TensorType.I32
			case "I16":
				return TensorType.I16
			case "I8":
				return TensorType.I8
			default:
				return none
		}
	}

	// The safetensors dtype of a plain tensor type, `none` for quantized ones.
	def kindDtype(kind TensorType) ?string {
		match kind {
			case TensorType.F64:
				return "F64"
			case TensorType.F32:
				return "F32"
			case TensorType.F16:
				return "F16"
			case TensorType.BF16:
				return "BF16"
			case TensorType.I64:
				return "I64"
			case TensorType.I32:
				return "I32"
			case TensorType.I16:
				return "I16"
			case TensorType.I8:
				return "I8"
			default:
				return none
		}
	}

	// Writes the header and the tensors in directory order.
	// Fails when a tensor is quantized or cannot be read, or the writer fails.
	def writeTensorsFile(file ModelFile, writer io.Writer) !none {
		let codec = new JSON()
		let head = new bytes.Buffer()
		try head.write("\{".bytes())
		let first = true
		if file.metadata.len() > 0 {
			try head.write("\"__metadata__\":\{".bytes())
			let firstKey = true
			for let (key, value) in file.metadata {
				try head.write(",".bytes()) unless firstKey
				firstKey = false
				try head.write(codec.encode(key))
				try head.write(":".bytes())
				try head.write(codec.encode(metaText(codec, value)))
			}
			try head.write("}".bytes())
			first = false
		}
		let offset = 0
		for let (_, t) in file.tensors {
			let dtype = kindDtype(t.kind)
			fail "safetensors: tensor {t.name} is {t.kind.name}; safetensors has no quantized types" when dtype is none
			let shape int[]
			for let i = t.shape.len() - 1; i >= 0; i-- {
				shape.push(t.shape[i])
			}
			try head.write(",".bytes()) unless first
			first = false
			try head.write(codec.encode(t.name))
			try head.write(":\{\"dtype\":\"{dtype}\",\"shape\":".bytes())
			try head.write(codec.encode(shape))
			try head.write(",\"data_offsets\":[{offset},{offset + t.byteSize}]}".bytes())
			offset += t.byteSize
		}
		try head.write("}".bytes())
		let size = align(head.len(), 8)
		try pad(head, size - head.len(), byte(0x20))
		let prefix = new bytes.Buffer()
		try putInt(prefix, size, 8)
		try writeAll(writer, prefix.bytes())
		try writeAll(writer, head.bytes())
		for let (_, t) in file.tensors {
			try writeAll(writer, try file.read(t.name))
		}
		return none
	}

	// A metadata value as safetensors' string metadata holds it.
	def metaText(codec JSON, value MetaValue) string {
		return value when value is string
		if value is MetaArray {
			let items string[]
			for let i = 0; i < value.len(); i++ {
				let item = value.get(i)
				items.push(item is string ?? (string(codec.encode(item)), metaText(codec, item)))
			}
			return "[" + items.join(",") + "]"
		}
		return "{value}"
	}
}
