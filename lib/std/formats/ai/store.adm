internal partial module std.formats.ai.store {
	use (
		std.io
		std.os
		std.bytes
		std.formats
		std.formats.ai::*
		std.formats.ai.grids::*
	)

	let codecRegistry = new formats.CodecRegistry<ModelCodec>("model", codec)

	// GGUF metadata value types, numbered as the file numbers them.
	enum GgufValue {
		Uint8,
		Int8,
		Uint16,
		Int16,
		Uint32,
		Int32,
		Float32,
		Bool,
		String,
		Array,
		Uint64,
		Int64,
		Float64,
	}

	// Where a model file's tensor bytes come from: the open file, or the
	// bytes it was loaded from, starting at the data section.
	type TensorStore {
		internal reader    io.Reader
		internal dataStart int

		def new(reader io.Reader, dataStart int) {
			self.reader = reader
			self.dataStart = dataStart
		}

		// `count` bytes at `offset` in the data section.
		// Fails when the reader cannot seek, or the data ends early.
		def readAt(offset int, count int) !byte[] {
			let r = reader
			if r is os.File {
				try r.seek(int64(dataStart + offset))
			} else if r is bytes.Reader {
				try r.seek(dataStart + offset)
			} else {
				fail "ai: the tensor data cannot be read out of order"
			}
			let out byte[]
			out.len(count)
			let got = 0
			for got < count {
				let n = try reader.read(out[got:])
				fail "ai: the tensor data ends {count - got} bytes early" when n <= 0
				got += n
			}
			return out
		}

		// Closes the file, if the data comes from one.
		def close() {
			let r = reader
			if r is os.File {
				r.close() onerror recover none
			}
		}
	}

	// `at` rounded up to a multiple of `alignment`.
	def align(at int, alignment int) int {
		return (at + alignment - 1) / alignment * alignment
	}

	// Appends `v` as `width` little-endian bytes.
	// Fails when the buffer does.
	def putInt(out bytes.Buffer, v int, width int) !none {
		let b byte[]
		b.len(width)
		for let i = 0; i < width; i++ {
			b[i] = byte((v >> (i * 8)) & 0xFF)
		}
		try out.write(b)
		return none
	}

	// Appends `n` bytes of `fill`.
	// Fails when the buffer does.
	def pad(out bytes.Buffer, n int, fill byte = byte(0)) !none {
		return none when n <= 0
		let run byte[]
		run.len(n)
		run.fill(fill)
		try out.write(run)
		return none
	}

	// Writes all of `data`.
	// Fails when the writer does, or stops taking bytes.
	def writeAll(writer io.Writer, data byte[]) !none {
		let done = 0
		for done < data.len() {
			let n = try writer.write(data[done:])
			fail "ai: the writer stopped taking bytes" when n <= 0
			done += n
		}
		return none
	}

	// The little-endian unsigned number of `count` bytes at `at`.
	def le(data byte[], at int, count int) int {
		let v = 0
		for let i = count - 1; i >= 0; i-- {
			v = (v << 8) | int(data[at + i])
		}
		return v
	}

	// An IEEE half-precision value from its 16 bits.
	def halfToFloat(h int) float32 {
		let sign = (h >> 15) & 1
		let exponent = (h >> 10) & 0x1F
		let mantissa = h & 0x3FF
		if exponent == 0 {
			// Zero and subnormals: mantissa × 2^-24.
			let v = float32(mantissa) * float32(5.9604644775390625e-8)
			return sign == 1 ?? (-v, v)
		}
		let bits = exponent == 31 ?? (0x7F800000 | (mantissa << 13), ((exponent + 112) << 23) | (mantissa << 13))
		return __bitcast_f32_from_u32(uint32((sign << 31) | bits))
	}

	// The half-precision value at `at`.
	def half(data byte[], at int) float32 {
		return halfToFloat(int(data[at]) | (int(data[at + 1]) << 8))
	}

	// The tensor bytes as float32: plain types converted, quantized blocks
	// expanded.
	def expand(kind TensorType, data byte[], count int) float32[] {
		let out float32[]
		out.len(count)
		match kind {
			case TensorType.F32:
				for let i = 0; i < count; i++ {
					out[i] = __bitcast_f32_from_u32(uint32(le(data, i * 4, 4)))
				}
			case TensorType.F16:
				for let i = 0; i < count; i++ {
					out[i] = half(data, i * 2)
				}
			case TensorType.BF16:
				for let i = 0; i < count; i++ {
					out[i] = __bitcast_f32_from_u32(uint32(le(data, i * 2, 2) << 16))
				}
			case TensorType.F64:
				for let i = 0; i < count; i++ {
					out[i] = float32(__bitcast_f64_from_u64(uint64(le(data, i * 8, 8))))
				}
			case TensorType.I8:
				for let i = 0; i < count; i++ {
					out[i] = float32(int8(data[i]))
				}
			case TensorType.I16:
				for let i = 0; i < count; i++ {
					out[i] = float32(int16(le(data, i * 2, 2)))
				}
			case TensorType.I32:
				for let i = 0; i < count; i++ {
					out[i] = float32(int32(le(data, i * 4, 4)))
				}
			case TensorType.I64:
				for let i = 0; i < count; i++ {
					out[i] = float32(le(data, i * 8, 8))
				}
			case TensorType.Q4_0:
				for let b = 0; b < count / 32; b++ {
					let at = b * 18
					let d = half(data, at)
					for let j = 0; j < 16; j++ {
						let q = int(data[at + 2 + j])
						out[b * 32 + j] = float32((q & 0xF) - 8) * d
						out[b * 32 + j + 16] = float32((q >> 4) - 8) * d
					}
				}
			case TensorType.Q4_1:
				for let b = 0; b < count / 32; b++ {
					let at = b * 20
					let d = half(data, at)
					let m = half(data, at + 2)
					for let j = 0; j < 16; j++ {
						let q = int(data[at + 4 + j])
						out[b * 32 + j] = float32(q & 0xF) * d + m
						out[b * 32 + j + 16] = float32(q >> 4) * d + m
					}
				}
			case TensorType.Q5_0:
				for let b = 0; b < count / 32; b++ {
					let at = b * 22
					let d = half(data, at)
					let qh = le(data, at + 2, 4)
					for let j = 0; j < 16; j++ {
						let q = int(data[at + 6 + j])
						let h0 = ((qh >> j) << 4) & 0x10
						let h1 = (qh >> (j + 12)) & 0x10
						out[b * 32 + j] = float32(((q & 0xF) | h0) - 16) * d
						out[b * 32 + j + 16] = float32(((q >> 4) | h1) - 16) * d
					}
				}
			case TensorType.Q5_1:
				for let b = 0; b < count / 32; b++ {
					let at = b * 24
					let d = half(data, at)
					let m = half(data, at + 2)
					let qh = le(data, at + 4, 4)
					for let j = 0; j < 16; j++ {
						let q = int(data[at + 8 + j])
						let h0 = ((qh >> j) << 4) & 0x10
						let h1 = (qh >> (j + 12)) & 0x10
						out[b * 32 + j] = float32((q & 0xF) | h0) * d + m
						out[b * 32 + j + 16] = float32((q >> 4) | h1) * d + m
					}
				}
			case TensorType.Q8_0:
				for let b = 0; b < count / 32; b++ {
					let at = b * 34
					let d = half(data, at)
					for let j = 0; j < 32; j++ {
						out[b * 32 + j] = float32(int8(data[at + 2 + j])) * d
					}
				}
			case TensorType.Q8_1:
				for let b = 0; b < count / 32; b++ {
					let at = b * 36
					let d = half(data, at)
					for let j = 0; j < 32; j++ {
						out[b * 32 + j] = float32(int8(data[at + 4 + j])) * d
					}
				}
			case TensorType.Q4_K:
				for let b = 0; b < count / 256; b++ {
					let at = b * 144
					let d = half(data, at)
					let dmin = half(data, at + 2)
					for let c = 0; c < 4; c++ {
						let (sc0, m0) = scaleMinK4(data, at + 4, 2 * c)
						let (sc1, m1) = scaleMinK4(data, at + 4, 2 * c + 1)
						for let l = 0; l < 32; l++ {
							let q = int(data[at + 16 + c * 32 + l])
							out[b * 256 + c * 64 + l] = d * float32(sc0) * float32(q & 0xF) - dmin * float32(m0)
							out[b * 256 + c * 64 + l + 32] = d * float32(sc1) * float32(q >> 4) - dmin * float32(m1)
						}
					}
				}
			case TensorType.Q5_K:
				for let b = 0; b < count / 256; b++ {
					let at = b * 176
					let d = half(data, at)
					let dmin = half(data, at + 2)
					for let c = 0; c < 4; c++ {
						let (sc0, m0) = scaleMinK4(data, at + 4, 2 * c)
						let (sc1, m1) = scaleMinK4(data, at + 4, 2 * c + 1)
						for let l = 0; l < 32; l++ {
							let q = int(data[at + 48 + c * 32 + l])
							let h = int(data[at + 16 + l])
							let q0 = (q & 0xF) | (((h >> (2 * c)) & 1) << 4)
							let q1 = (q >> 4) | (((h >> (2 * c + 1)) & 1) << 4)
							out[b * 256 + c * 64 + l] = d * float32(sc0) * float32(q0) - dmin * float32(m0)
							out[b * 256 + c * 64 + l + 32] = d * float32(sc1) * float32(q1) - dmin * float32(m1)
						}
					}
				}
			case TensorType.Q6_K:
				for let b = 0; b < count / 256; b++ {
					let at = b * 210
					let d = half(data, at + 208)
					for let n = 0; n < 2; n++ {
						let ql = at + n * 64
						let qh = at + 128 + n * 32
						let sc = at + 192 + n * 8
						let y = b * 256 + n * 128
						for let l = 0; l < 32; l++ {
							let s = l / 16
							let h = int(data[qh + l])
							let a = int(data[ql + l])
							let c = int(data[ql + l + 32])
							out[y + l] = d * float32(int8(data[sc + s])) * float32(((a & 0xF) | ((h & 3) << 4)) - 32)
							out[y + l + 32] = d * float32(int8(data[sc + s + 2])) * float32(((c & 0xF) | (((h >> 2) & 3) << 4)) - 32)
							out[y + l + 64] = d * float32(int8(data[sc + s + 4])) * float32(((a >> 4) | (((h >> 4) & 3) << 4)) - 32)
							out[y + l + 96] = d * float32(int8(data[sc + s + 6])) * float32(((c >> 4) | ((h >> 6) << 4)) - 32)
						}
					}
				}
			case TensorType.Q2_K:
				expandQ2K(data, count, out)
			case TensorType.Q3_K:
				expandQ3K(data, count, out)
			case TensorType.Q8_K:
				expandQ8K(data, count, out)
			case TensorType.TQ1_0:
				expandTQ1(data, count, out)
			case TensorType.TQ2_0:
				expandTQ2(data, count, out)
			case TensorType.IQ4_NL:
				expandIQ4NL(data, count, out)
			case TensorType.IQ4_XS:
				expandIQ4XS(data, count, out)
			case TensorType.MXFP4:
				expandMXFP4(data, count, out)
			case TensorType.NVFP4:
				expandNVFP4(data, count, out)
			case TensorType.IQ2_XXS:
				expandIQ2XXS(data, count, out)
			case TensorType.IQ2_XS:
				expandIQ2XS(data, count, out)
			case TensorType.IQ2_S:
				expandIQ2S(data, count, out)
			case TensorType.IQ3_XXS:
				expandIQ3XXS(data, count, out)
			case TensorType.IQ3_S:
				expandIQ3S(data, count, out)
			case TensorType.IQ1_S:
				expandIQ1S(data, count, out)
			case TensorType.IQ1_M:
				expandIQ1M(data, count, out)
			case TensorType.Q1_0:
				expandQ1(data, count, out)
			case TensorType.Q2_0:
				expandQ2(data, count, out)
		}
		return out
	}

	// The 6-bit scale and minimum of sub-block `j` (0–7) of a Q4_K or Q5_K
	// block, packed in the 12 bytes at `at`.
	def scaleMinK4(data byte[], at int, j int) (int, int) {
		return (int(data[at + j]) & 63, int(data[at + j + 4]) & 63) when j < 4
		let sc = (int(data[at + j + 4]) & 0xF) | ((int(data[at + j - 4]) >> 6) << 4)
		let m = (int(data[at + j + 4]) >> 4) | ((int(data[at + j]) >> 6) << 4)
		return (sc, m)
	}
}
