partial module std.formats.archive {
	use (
		std.io
		std.formats.archive.stream::*
		std.formats.archive.sevenzip::*
	)

	// SevenZip is the 7-Zip codec (`.7z`). It reads archives whose folders
	// use the copy, LZMA, LZMA2, BCJ and BCJ2 (x86), delta, bzip2 and deflate
	// methods,
	// solid or not, with encoded and AES-encrypted headers and entries
	// (`ReadOptions.password`). Entries carry their names, sizes, CRCs,
	// times and attributes; empty files and directories are entries too.
	// Reading a solid folder's entries in order decodes the folder once.
	//
	// Entry attributes: "7z.solidBlock" is the index of the folder holding
	// the entry's bytes, "7z.attributes" the Windows attribute word as a
	// decimal number.
	@codec("7-Zip")
	type SevenZip {
		mimeType string[] {
			def get() string[] {
				return string["application/x-7z-compressed"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".7z"]
			}
		}

		// matchSignature reports whether the reader starts with the 7z
		// signature.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(6)
			let n = io.readFull(r, b) onerror recover 0
			return n == 6 && hasSignature(b)
		}

		// open reads the archive's header and returns it. `opts.password`
		// decrypts encrypted headers and entries. Fails when the data is not a
		// 7z archive, its header is corrupt or uses an unsupported method, the
		// header is encrypted and the password is missing or wrong, or the
		// reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			let header = try readHeader(src, opts.password)
			return new SevenZipArchive(src, header, opts.password)
		}

		// create returns a writer that puts every file into one solid LZMA2
		// folder (stored when `opts.level` is None), with names, times and
		// Unix modes. The archive is assembled in memory and written by the
		// writer's `close`, which does not close `writer`. Symbolic links are
		// refused. Fails when `opts` asks for a password: encrypted writing is
		// not supported.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "7z: writing encrypted archives is not supported"
			}
			return new SevenZipWriter(writer, opts.level)
		}
	}
}
