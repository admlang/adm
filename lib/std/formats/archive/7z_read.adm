internal partial module std.formats.archive.sevenzip {
	use (
		std.bytes
		std.time
		std.crypto.hash
		std.formats.archive::*
		std.formats.archive.stream::*
	)

	// Property IDs of the 7z header.
	const (
		idEnd              = 0x00
		idHeader           = 0x01
		idArchiveProps     = 0x02
		idAdditionalStream = 0x03
		idMainStreams      = 0x04
		idFilesInfo        = 0x05
		idPackInfo         = 0x06
		idUnpackInfo       = 0x07
		idSubStreams       = 0x08
		idSize             = 0x09
		idCRC              = 0x0A
		idFolder           = 0x0B
		idUnpackSize       = 0x0C
		idNumUnpackStream  = 0x0D
		idEmptyStream      = 0x0E
		idEmptyFile        = 0x0F
		idAnti             = 0x10
		idName             = 0x11
		idCTime            = 0x12
		idATime            = 0x13
		idMTime            = 0x14
		idWinAttributes    = 0x15
		idEncodedHeader    = 0x17
		idDummy            = 0x19
		signatureSize      = 32
		// 100 ns ticks between 1601-01-01 and 1970-01-01.
		fileTimeEpoch      = 116444736000000000
	)

	// Whether the bytes start with the 7z signature.
	def hasSignature(b byte[]) bool {
		return b.len() >= 6 && b[0] == 0x37 && b[1] == 0x7A && b[2] == 0xBC && b[3] == 0xAF && b[4] == 0x27 && b[5] == 0x1C
	}

	// One coder of a folder: its method ID, stream counts and properties.
	struct Coder {
		id     byte[]
		numIn  int
		numOut int
		props  byte[]
	}

	// A folder: a graph of coders that turns packed streams into one output,
	// which holds one or more files back to back.
	type Folder {
		coders      Coder[]
		// bindIn[i] is fed by the output stream bindOut[i].
		bindIn      int[]
		bindOut     int[]
		// Coder input streams fed by packed streams, in pack stream order.
		packed      int[]
		// First pack stream of this folder in the archive's pack list.
		firstPack   int
		unpackSizes int[]
		crc         uint32
		hasCRC      bool
		substreams  int

		def new() {
			coders = []
			bindIn = []
			bindOut = []
			packed = []
			unpackSizes = []
			substreams = 1
		}

		def numOut() int {
			let n = 0
			for let c in coders {
				n += c.numOut
			}
			return n
		}

		def numIn() int {
			let n = 0
			for let c in coders {
				n += c.numIn
			}
			return n
		}

		// The output stream no coder reads: the folder's result.
		def mainOut() int {
			for let i = 0; i < numOut(); i++ {
				return i unless i in bindOut
			}
			return 0
		}

		// The folder's total output size.
		def size() int {
			return (unpackSizes.len() > 0) ?? (unpackSizes[mainOut()], 0)
		}

		def encrypted() bool {
			for let c in coders {
				return true when methodName(c.id) == "aes"
			}
			return false
		}
	}

	// What the header says about one file.
	type FileRecord {
		name      string
		hasStream bool
		isDir     bool
		isAnti    bool
		size      int
		crc       uint32
		hasCRC    bool
		folder    int
		offset    int
		attrib    int
		hasAttrib bool
		mtime     int
		atime     int
		ctime     int

		def new() {
			hasStream = true
			folder = -1
		}
	}

	// The lowercase name of a coder method, "" for one this reader does not
	// know.
	def methodName(id byte[]) string {
		let key = id.hex()
		match key {
			case "00":
				return "copy"
			case "03":
				return "delta"
			case "21":
				return "lzma2"
			case "030101":
				return "lzma"
			case "03030103":
				return "bcj"
			case "0303011B":
				return "bcj2"
			case "040108":
				return "deflate"
			case "040202":
				return "bzip2"
			case "030401":
				return "ppmd"
			case "06F10701":
				return "aes"
		}
		return ""
	}

	// Cursor over header bytes with the 7z number encoding.
	type HeaderReader {
		b   byte[]
		pos int

		def new(b byte[]) {
			self.b = b
		}

		def byte() !byte {
			fail "7z: truncated header" when pos >= b.len()
			let v = b[pos]
			pos++
			return v
		}

		def bytes(n int) !byte[] {
			expects {
				assert n >= 0 && pos + n <= b.len() onerror fail "7z: truncated header"
			}
			let v = b[pos:pos + n]
			pos += n
			return v
		}

		// A 7z number: the leading one bits of the first byte count the extra
		// little-endian bytes, its remaining bits are the high part.
		def number() !int {
			let first = int(try byte())
			let mask = 0x80
			let v = 0
			for let i = 0; i < 8; i++ {
				if first & mask == 0 {
					let high = first & (mask - 1)
					v |= high << (8 * i)
					return v
				}
				v |= int(try byte()) << (8 * i)
				mask >>= 1
			}
			fail "7z: number too large" when v < 0
			return v
		}

		// A count that must be plausible for the header's length.
		def count() !int {
			let n = try number()
			fail "7z: corrupt header" when n < 0 || n > b.len() * 8 + 64
			return n
		}

		def uint32() !uint32 {
			let v = try bytes(4)
			return uint32(v[0]) | uint32(v[1]) << 8 | uint32(v[2]) << 16 | uint32(v[3]) << 24
		}

		def uint64() !int {
			let v = try bytes(8)
			let out = 0
			for let i = 7; i >= 0; i-- {
				out = (out << 8) | int(v[i])
			}
			return out
		}

		// A vector of n bits, most significant bit first.
		def bits(n int) !bool[] {
			let out bool[] = []
			out.len(n)
			let cur = 0
			for let i = 0; i < n; i++ {
				cur = int(try byte()) when i % 8 == 0
				out[i] = cur & (0x80 >> (i % 8)) != 0
			}
			return out
		}

		// A bit vector preceded by an "all defined" byte.
		def defined(n int) !bool[] {
			let all = try byte()
			return try bits(n) when all == 0
			let out bool[] = []
			out.len(n)
			out.fill(true)
			return out
		}

		// CRC values for the n streams, with their defined flags.
		def digests(n int) !(bool[], uint32[]) {
			let has = try defined(n)
			let crcs uint32[] = []
			crcs.len(n)
			for let i = 0; i < n; i++ {
				crcs[i] = try uint32() when has[i]
			}
			return (has, crcs)
		}

		def skip(n int) !none {
			try bytes(n)
		}
	}

	// Everything the header describes.
	type SevenZipHeader {
		packPos   int
		packSizes int[]
		folders   Folder[]
		// Per substream, over every folder in order.
		subSizes  int[]
		subHasCRC bool[]
		subCRCs   uint32[]
		files     FileRecord[]

		def new() {
			packSizes = []
			folders = []
			subSizes = []
			subHasCRC = []
			subCRCs = []
			files = []
		}

		def readStreamsInfo(r HeaderReader) !none {
			for {
				let id = try r.number()
				switch {
					case id == idEnd:
						return none
					case id == idPackInfo:
						try readPackInfo(r)
					case id == idUnpackInfo:
						try readUnpackInfo(r)
					case id == idSubStreams:
						try readSubStreams(r)
					default:
						fail "7z: unexpected property in streams info"
				}
			}
		}

		def readPackInfo(r HeaderReader) !none {
			packPos = try r.number()
			let n = try r.count()
			packSizes.len(n)
			packSizes.fill(0)
			for {
				let id = try r.number()
				break when id == idEnd
				if id == idSize {
					for let i = 0; i < n; i++ {
						packSizes[i] = try r.number()
					}
				} else if id == idCRC {
					try r.digests(n)
				} else {
					fail "7z: unexpected property in pack info"
				}
			}
		}

		def readUnpackInfo(r HeaderReader) !none {
			expects {
				assert (try r.number()) == idFolder onerror fail "7z: expected folder list"
			}
			let n = try r.count()
			fail "7z: external folders are not supported" when (try r.byte()) != 0
			let pack = 0
			for let i = 0; i < n; i++ {
				let f = try readFolder(r)
				f.firstPack = pack
				pack += f.packed.len()
				folders.push(f)
			}
			fail "7z: expected unpack sizes" when (try r.number()) != idUnpackSize
			for let f in folders {
				let outs = f.numOut()
				for let k = 0; k < outs; k++ {
					f.unpackSizes.push(try r.number())
				}
			}
			for {
				let id = try r.number()
				break when id == idEnd
				fail "7z: unexpected property in unpack info" when id != idCRC
				let (has, crcs) = try r.digests(n)
				for let i = 0; i < n; i++ {
					folders[i].hasCRC = has[i]
					folders[i].crc = crcs[i]
				}
			}
		}

		def readFolder(r HeaderReader) !Folder {
			let f = new Folder()
			let numCoders = try r.count()
			fail "7z: invalid coder count" when numCoders < 1 || numCoders > 64
			for let i = 0; i < numCoders; i++ {
				let flags = int(try r.byte())
				fail "7z: alternative coder methods are not supported" when flags & 0x80 != 0
				let id = try r.bytes(flags & 0x0F)
				let numIn = 1
				let numOut = 1
				if flags & 0x10 != 0 {
					numIn = try r.count()
					numOut = try r.count()
				}
				let props byte[] = []
				props = try r.bytes(try r.count()) when flags & 0x20 != 0
				f.coders.push(Coder{id: id, numIn: numIn, numOut: numOut, props: props})
			}
			let totalOut = f.numOut()
			let totalIn = f.numIn()
			for let i = 0; i < totalOut - 1; i++ {
				f.bindIn.push(try r.number())
				f.bindOut.push(try r.number())
			}
			let numPacked = totalIn - (totalOut - 1)
			fail "7z: invalid folder" when numPacked < 1
			if numPacked == 1 {
				for let i = 0; i < totalIn; i++ {
					if !(i in f.bindIn) {
						f.packed.push(i)
						break
					}
				}
			} else {
				for let i = 0; i < numPacked; i++ {
					f.packed.push(try r.number())
				}
			}
			return f
		}

		def readSubStreams(r HeaderReader) !none {
			for let f in folders {
				f.substreams = 1
			}
			let id = try r.number()
			if id == idNumUnpackStream {
				for let f in folders {
					f.substreams = try r.count()
				}
				id = try r.number()
			}
			let sizesRead = id == idSize
			for let f in folders {
				continue when f.substreams == 0
				let sum = 0
				for let k = 0; k < f.substreams - 1; k++ {
					let s = sizesRead ?? (try r.number(), 0)
					subSizes.push(s)
					sum += s
				}
				fail "7z: substream sizes exceed the folder" when sum > f.size()
				subSizes.push(f.size() - sum)
			}
			id = try r.number() when sizesRead
			// Streams whose CRC the folder does not already give.
			let unknown = 0
			for let f in folders {
				unknown += f.substreams unless f.substreams == 1 && f.hasCRC
			}
			let total = subSizes.len()
			subHasCRC.len(total)
			subHasCRC.fill(false)
			subCRCs.len(total)
			let at = 0
			for let f in folders {
				if f.substreams == 1 && f.hasCRC {
					subHasCRC[at] = true
					subCRCs[at] = f.crc
				}
				at += f.substreams
			}
			for id != idEnd {
				if id == idCRC {
					let (has, crcs) = try r.digests(unknown)
					let k = 0
					at = 0
					for let f in folders {
						if !(f.substreams == 1 && f.hasCRC) {
							for let j = 0; j < f.substreams; j++ {
								subHasCRC[at + j] = has[k]
								subCRCs[at + j] = crcs[k]
								k++
							}
						}
						at += f.substreams
					}
				} else {
					fail "7z: unexpected property in substreams info"
				}
				id = try r.number()
			}
		}

		// Substream sizes and CRCs default to one per folder when the header
		// has no substreams info.
		def defaultSubStreams() {
			return when subSizes.len() > 0
			for let f in folders {
				continue when f.substreams == 0
				subSizes.push(f.size())
				subHasCRC.push(f.hasCRC)
				subCRCs.push(f.crc)
			}
		}

		def readFilesInfo(r HeaderReader) !none {
			let n = try r.count()
			for let i = 0; i < n; i++ {
				files.push(new FileRecord())
			}
			let emptyStream bool[] = []
			let emptyFile bool[] = []
			let anti bool[] = []
			let numEmpty = 0
			for {
				let id = try r.number()
				break when id == idEnd
				let size = try r.number()
				fail "7z: corrupt file property" when size < 0 || r.pos + size > r.b.len()
				let end = r.pos + size
				switch {
					case id == idEmptyStream:
						emptyStream = try r.bits(n)
						numEmpty = 0
						for let e in emptyStream {
							numEmpty++ when e
						}
					case id == idEmptyFile:
						emptyFile = try r.bits(numEmpty)
					case id == idAnti:
						anti = try r.bits(numEmpty)
					case id == idName:
						fail "7z: external names are not supported" when (try r.byte()) != 0
						let raw = try r.bytes(end - r.pos)
						let at = 0
						for let k = 0; k < n; k++ {
							let (name, next) = utf16Name(raw, at)
							files[k].name = name
							at = next
						}
					case id == idCTime || id == idATime || id == idMTime:
						let has = try r.defined(n)
						fail "7z: external times are not supported" when (try r.byte()) != 0
						for let k = 0; k < n; k++ {
							continue unless has[k]
							let t = try r.uint64()
							if id == idMTime {
								files[k].mtime = t
							} else if id == idATime {
								files[k].atime = t
							} else {
								files[k].ctime = t
							}
						}
					case id == idWinAttributes:
						let has = try r.defined(n)
						fail "7z: external attributes are not supported" when (try r.byte()) != 0
						for let k = 0; k < n; k++ {
							continue unless has[k]
							files[k].attrib = int(try r.uint32())
							files[k].hasAttrib = true
						}
					default:
				}
				r.pos = end
			}
			let e = 0
			for let k = 0; k < n; k++ {
				let f = files[k]
				if emptyStream.len() > 0 && emptyStream[k] {
					f.hasStream = false
					f.isDir = !(emptyFile.len() > e && emptyFile[e])
					f.isAnti = anti.len() > e && anti[e]
					e++
				}
				f.isDir = true when f.hasAttrib && f.attrib & 0x10 != 0
			}
		}

		// Assigns every file with data its folder, offset, size and CRC.
		def mapFiles() !none {
			defaultSubStreams()
			let folder = 0
			let inFolder = 0
			let offset = 0
			let sub = 0
			for let f in files {
				continue unless f.hasStream
				for folder < folders.len() && inFolder >= folders[folder].substreams {
					folder++
					inFolder = 0
					offset = 0
				}
				fail "7z: more files than streams" when folder >= folders.len() || sub >= subSizes.len()
				f.folder = folder
				f.offset = offset
				f.size = subSizes[sub]
				f.hasCRC = subHasCRC[sub]
				f.crc = subCRCs[sub]
				offset += f.size
				inFolder++
				sub++
			}
		}
	}

	// A name in UTF-16LE up to a zero unit, and the offset after it.
	def utf16Name(raw byte[], at int) (string, int) {
		let end = at
		for end + 1 < raw.len() && (raw[end] != 0 || raw[end + 1] != 0) {
			end += 2
		}
		let next = end + 1 < raw.len() ?? (end + 2, raw.len())
		return (raw[at:end].utf16(bytes.Endian.Little), next)
	}

	// The time a FILETIME (100 ns ticks since 1601) stands for; the zero time
	// for 0.
	def fileTime(t int) time.Time {
		return time.fromUnixNs(0) when t == 0
		return time.fromUnixNs(int64((t - fileTimeEpoch) * 100))
	}
}
