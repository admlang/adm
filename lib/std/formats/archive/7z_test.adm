		0x01, 0x05, 0x6c, 0x00, 0x10, 0x00, 0x00, 0x21, 0x21, 0x01, 0x00, 0x14, 0x03, 0x03, 0x01, 0x1b,
		0x04, 0x01, 0x05, 0x00, 0x04, 0x01, 0x03, 0x02, 0x02, 0x06, 0x01, 0x00, 0x0c, 0x00, 0x00, 0x84,
		0x00, 0x84, 0x00, 0x00, 0x08, 0x0a, 0x01, 0xc1, 0x08, 0x3e, 0x5d, 0x00, 0x00, 0x05, 0x01, 0x19,
		0x0f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
		0x11, 0x13, 0x00, 0x63, 0x00, 0x6f, 0x00, 0x64, 0x00, 0x65, 0x00, 0x2e, 0x00, 0x62, 0x00, 0x69,
		0x00, 0x6e, 0x00, 0x00, 0x00, 0x19, 0x00, 0x14, 0x0a, 0x01, 0x00, 0x80, 0x92, 0x6c, 0x26, 0x84,
		0x9f, 0xda, 0x01, 0x15, 0x06, 0x01, 0x00, 0x20, 0x80, 0xa4, 0x81, 0x00, 0x00,
		]
	}

	check "SevenZip" {
		use (
			std.testing
			std.bytes
			std.io
			std.os
			std.time
			std.crypto.hash
			std.formats.archive.stream::*
		)

		def hello() string {
			return "hello ".repeat(20)
		}

		// 64 fake x86 routines, each with a CALL a branch filter rewrites.
		def code() byte[] {
			let out byte[] = []
			for let i = 0; i < 64; i++ {
				let target = uint32(0x1000 - i * 16)
				out.push(0x55, 0x48, 0x89, 0xE5, 0xE8)
				out.push(byte(target), byte(target >> 8), byte(target >> 16), byte(target >> 24))
				out.push(0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90)
			}
			return out
		}

		def openBytes(data byte[], password string = "") !Archive {
			return try new SevenZip().open(new bytes.Reader(data), ReadOptions{password: password})
		}

		def find(arc Archive, name string) !Entry {
			let e = arc.entry(name)
			fail "missing " + name when e is none
			let entry Entry = e
			return entry
		}

		def content(arc Archive, name string) !byte[] {
			return try readAll(try arc.open(try find(arc, name)))
		}

		def readHello(data byte[], password string) !byte[] {
			return try content(try openBytes(data, password), "hello.txt")
		}

		def fails(data byte[], password string) bool {
			let failed = false
			readHello(data, password) onerror (e error) {
				failed = true
				recover []
			}
			return failed
		}

		@test()
		def listsASolidArchive() !none {
			let arc = try openBytes(sevenZipSolid())
			let list = arc.entries()
			assert list.len() == 4
			let names string[] = []
			for let e in list {
				names.push(e.name)
			}
			assert "hello.txt" in names && "sub" in names && "sub/b.txt" in names && "empty.txt" in names
			let h = try find(arc, "hello.txt")
			assert h.size == 120
			assert h.crc32 == hash.crc32(hello().bytes())
			assert h.method == "lzma2"
			assert h.modTime.unixNs() == 1714979289 * 1000000000
			assert int(h.mode) & 0o777 == 0o644
			let dir = try find(arc, "sub")
			assert isDirMode(dir.mode)
			assert string(try content(arc, "hello.txt")) == hello()
			assert string(try content(arc, "sub/b.txt")) == "second\n"
			assert (try content(arc, "empty.txt")).len() == 0
			// Out of order: the folder is decoded again from its start.
			assert string(try content(arc, "hello.txt")) == hello()
		}

		@test()
		def readsEveryMethod() !none {
			for let data in [sevenZipBzip2(), sevenZipDeflate(), sevenZipLzma(), sevenZipCopy()] {
				let arc = try openBytes(data)
				assert string(try content(arc, "hello.txt")) == hello()
			}
			for let data in [sevenZipBcj(), sevenZipDelta(), sevenZipBcj2()] {
				let arc = try openBytes(data)
				assert (try content(arc, "code.bin")).equals(code())
			}
			let loaded = try load(sevenZipLzma())
			assert loaded.entries()[0].name == "hello.txt"
		}

		@test()
		def readsEncryptedArchives() !none {
			let arc = try openBytes(sevenZipSecret(), "secret")
			assert arc.entries()[0].encrypted
			assert string(try content(arc, "hello.txt")) == hello()
			assert fails(sevenZipSecret(), "")
			assert fails(sevenZipSecret(), "wrong")
		}

		@test()
		def rejectsCorruptArchives() !none {
			let bad = sevenZipLzma().clone()
			bad[bad.len() - 3] = bad[bad.len() - 3] ^ 0x10
			assert fails(bad, "")
			let data = sevenZipCopy().clone()
			// A flipped byte of the stored file fails its CRC.
			data[40] = data[40] ^ 0x01
			assert fails(data, "")
			assert fails("7z but not really".bytes(), "")
		}

		@test()
		def roundTrips() !none {
			for let level in [CompressionLevel.None, CompressionLevel.Default] {
				let out = new bytes.Buffer()
				let w = try new SevenZip().create(out, WriteOptions{level: level})
				let stamp = time.fromUnixNs(1714979289 * 1000000000)
				try w.add(Entry{name: "docs", mode: os.FileMode(int(os.FileMode.Dir) | 0o750), modTime: stamp}, new bytes.Reader([]))
				try w.add(Entry{name: "docs/hello.txt", mode: os.FileMode(0o640), modTime: stamp}, new bytes.Reader(hello().bytes()))
				try w.add(Entry{name: "empty.txt"}, new bytes.Reader([]))
				try w.add(Entry{name: "code.bin"}, new bytes.Reader(code()))
				try w.close()
				let arc = try openBytes(out.bytes())
				assert arc.entries().len() == 4
				let dir = try find(arc, "docs")
				assert isDirMode(dir.mode) && int(dir.mode) & 0o777 == 0o750
				let h = try find(arc, "docs/hello.txt")
				assert int(h.mode) & 0o777 == 0o640
				assert h.modTime.unixNs() == stamp.unixNs()
				assert string(try content(arc, "docs/hello.txt")) == hello()
				assert (try content(arc, "code.bin")).equals(code())
				assert (try content(arc, "empty.txt")).len() == 0
			}
			let blank = new bytes.Buffer()
			let w = try new SevenZip().create(blank)
			try w.close()
			assert (try openBytes(blank.bytes())).entries().len() == 0
		}
	}
}
