internal partial module std.formats.archive.sevenzip {
	use (
		std.io
		std.bytes
		std.os
		std.crypto.hash
		std.data.compress.lzma
		std.formats.archive::*
		std.formats.archive.stream::*
	)

	// What the writer records about one entry.
	struct PendingFile {
		name   string
		size   int
		crc    uint32
		isDir  bool
		attrib int
		mtime  int
	}

	// Writes a 7z archive: every file's bytes go into one solid folder,
	// LZMA2-compressed (or stored at CompressionLevel.None), held in memory
	// until `close` writes the signature header, the folder and the header.
	type SevenZipWriter {
		out    io.Writer
		level  CompressionLevel
		packed bytes.Buffer
		lz     lzma.Writer2
		files  PendingFile[]
		closed bool

		def new(out io.Writer, level CompressionLevel) {
			self.out = out
			self.level = level
			packed = new bytes.Buffer()
			let preset = lzma.Level.DefaultCompression
			preset = lzma.Level.BestSpeed when level == CompressionLevel.Fastest
			preset = lzma.Level(3) when level == CompressionLevel.Fast
			preset = lzma.Level.BestCompression when level == CompressionLevel.Best
			lz = new lzma.Writer2(packed, preset)
			files = []
		}

		def stored() bool {
			return level == CompressionLevel.None
		}

		def add(path string, opts AddOptions = AddOptions{}) !none {
			return addTree(self, path, opts)
		}

		def add(entry Entry, content io.Reader) !none {
			fail "7z: the archive is closed" when closed
			let name = entry.name.replace("\\", "/").trim("/")
			fail "7z: entry name is empty" when name.isEmpty()
			fail "7z: symbolic links cannot be written yet" when isLinkMode(entry.mode)
			let perm = int(entry.mode) & 0o777
			let mtime = 0
			mtime = int(entry.modTime.unixNs()) / 100 + fileTimeEpoch unless isZeroTime(entry.modTime)
			if isDirMode(entry.mode) {
				perm = 0o755 when perm == 0
				files.push(PendingFile{name: name, isDir: true, attrib: 0x10 | 0x8000 | ((os.unixMode(entry.mode) | 0o040000) << 16), mtime: mtime})
				return none
			}
			perm = 0o644 when perm == 0
			let mode = os.FileMode(perm)
			let crc = new hash.CRC32()
			let size = 0
			let buf byte[]
			buf.len(64 * 1024)
			for {
				let n = try content.read(buf)
				break when n <= 0
				crc.write(buf[0:n])
				if stored() {
					try packed.write(buf[0:n])
				} else {
					try lz.write(buf[0:n])
				}
				size += n
			}
			files.push(PendingFile{name: name, size: size, crc: crc.checksum ^ 0xFFFFFFFF, attrib: 0x20 | 0x8000 | (os.unixMode(mode) << 16), mtime: mtime})
			return none
		}

		// close implements io.Closer: writes the archive. It does not close
		// the writer the archive was created on. Fails when that writer does.
		def close() !none {
			return none when closed
			closed = true
			let streams = 0
			let total = 0
			for let f in files {
				if !f.isDir && f.size > 0 {
					streams++
					total += f.size
				}
			}
			if streams > 0 && !stored() {
				try lz.close()
			}
			let body = packed.bytes()
			body = [] when streams == 0
			let h = byte[idHeader]
			if streams > 0 {
				h.push(idMainStreams, idPackInfo)
				putNumber(h, 0)
				putNumber(h, 1)
				h.push(idSize)
				putNumber(h, body.len())
				h.push(idEnd, idUnpackInfo, idFolder)
				putNumber(h, 1)
				h.push(0)
				putNumber(h, 1)
				if stored() {
					h.push(0x01, 0x00)
				} else {
					h.push(0x21, 0x21)
					putNumber(h, 1)
					h.push(lz.properties()[0])
				}
				h.push(idUnpackSize)
				putNumber(h, total)
				h.push(idEnd, idSubStreams, idNumUnpackStream)
				putNumber(h, streams)
				h.push(idSize)
				let seen = 0
				for let f in files {
					continue when f.isDir || f.size == 0
					seen++
					putNumber(h, f.size) when seen < streams
				}
				h.push(idCRC, 1)
				for let f in files {
					continue when f.isDir || f.size == 0
					put32(h, int(f.crc))
				}
				h.push(idEnd, idEnd)
			}
			if files.len() > 0 {
				h.push(idFilesInfo)
				putNumber(h, files.len())
				let emptyStream bool[] = []
				let emptyFile bool[] = []
				let anyEmpty = false
				for let f in files {
					let e = f.isDir || f.size == 0
					emptyStream.push(e)
					if e {
						anyEmpty = true
						emptyFile.push(!f.isDir)
					}
				}
				if anyEmpty {
					putProperty(h, idEmptyStream, bitVector(emptyStream))
					putProperty(h, idEmptyFile, bitVector(emptyFile))
				}
				let names byte[] = [0]
				for let f in files {
					names = names + f.name.utf16(bytes.Endian.Little) + byte[0, 0]
				}
				putProperty(h, idName, names)
				let times byte[] = [1, 0]
				let attrs byte[] = [1, 0]
				for let f in files {
					put64(times, f.mtime)
					put32(attrs, f.attrib)
				}
				putProperty(h, idMTime, times)
				putProperty(h, idWinAttributes, attrs)
				h.push(idEnd)
			}
			h.push(idEnd)
			let tail byte[] = []
			put64(tail, body.len())
			put64(tail, h.len())
			put32(tail, int(hash.crc32(h)))
			let sig = byte[0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04]
			put32(sig, int(hash.crc32(tail)))
			try writeAll(out, sig + tail)
			try writeAll(out, body)
			try writeAll(out, h)
			return none
		}
	}

	// Appends a 7z number.
	def putNumber(out byte[], v int) {
		let n = 0
		for n < 8 && v >= (1 << (7 * (n + 1))) {
			n++
		}
		if n == 8 {
			out.push(0xFF)
			put64(out, v)
			return
		}
		let first = (0xFF00 >> n) & 0xFF
		out.push(byte(first | (v >> (8 * n))))
		for let i = 0; i < n; i++ {
			out.push(byte(v >> (8 * i)))
		}
	}

	// Appends a file property: its ID, size and bytes.
	def putProperty(out byte[], id int, data byte[]) {
		out.push(byte(id))
		putNumber(out, data.len())
		for let b in data {
			out.push(b)
		}
	}

	// The bits packed most significant first.
	def bitVector(bits bool[]) byte[] {
		let out byte[] = []
		out.len((bits.len() + 7) / 8)
		out.fill(0)
		for let (i, b) in bits {
			out[i / 8] = out[i / 8] | byte(0x80 >> (i % 8)) when b
		}
		return out
	}
}
