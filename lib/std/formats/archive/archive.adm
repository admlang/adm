partial module std.formats.archive {
	use (
		std.io
		std.os
		std.time
	)

	// How hard a writer should work to shrink entries. Formats map these onto
	// whatever levels their method actually supports.
	enum CompressionLevel {
		// Store without compressing.
		None,
		Fastest,
		Fast,
		Default,
		Best
	}

	// What extraction does when the destination path already exists.
	enum OverwriteMode {
		// Fail the extraction.
		Never,
		Always,
		// Overwrite only when the entry is newer than the file on disk.
		IfNewer,
		// Leave the existing file alone and continue.
		Skip
	}

	// ReadOptions is how an archive is opened: the password for encrypted
	// entries and the name encoding of formats that predate UTF-8.
	struct ReadOptions {
		// Password for archives whose entries -- or whose entry list -- are encrypted.
		password string
		// Character encoding for entry names in formats that predate UTF-8 (legacy zip).
		encoding string
		// Fail on the first CRC mismatch instead of surfacing it per entry.
		strict   bool
	}

	// WriteOptions is how an archive is written: the password, whether to
	// encrypt the entry list too, and the rest.
	struct WriteOptions {
		password      string
		// Encrypt the entry list too, where the format supports it (7z, RAR5).
		encryptHeader bool
		level         CompressionLevel
	}

	// ExtractOptions is how entries are written to disk: whether to restore
	// their times and modes, and the rest.
	struct ExtractOptions {
		// Restore modTime/mode from the entry after writing.
		preserveTimes bool
		preserveMode  bool
		// Recreate symlink entries as symlinks rather than following them.
		restoreLinks  bool
		overwrite     OverwriteMode
	}

	// AddOptions is how a file is added: the path recorded inside the archive,
	// whether to descend into directories, and the rest.
	struct AddOptions {
		// Path recorded inside the archive; defaults to `path` made relative.
		path        string
		recursive   bool
		// Store symlinks as links instead of following them.
		followLinks bool
	}

	// Entry is one member of an archive: its name, comment, mode, size, times and
	// the rest.
	struct Entry {
		name           string
		comment        string
		mode           os.FileMode
		crc32          uint32
		size           uint64
		compressedSize uint64
		modTime        time.Time
		// Zero when the format does not record them (tar does, zip mostly does not).
		accessTime     time.Time
		createTime     time.Time
		// Target path when `mode` says Symlink. Empty otherwise.
		linkTarget     string
		// This entry's bytes are encrypted, even if the entry list was not.
		encrypted      bool
		// How the bytes are stored, lowercase and format-owned: "store",
		// "deflate", "bzip2", "lzma2", "zstd". Empty when the format does not
		// record one (tar). Reporting only -- `Archive.open` decodes whatever
		// this says, so callers never branch on it to read an entry. A format
		// outside this module names its own methods here without needing a
		// change to std.
		method         string
		// Format-specific metadata the shared model has no field for, keyed by
		// a name the format owns ("zip.externalAttrs", "7z.solidBlock"). Empty
		// for formats that expose nothing extra.
		attributes     map<string, string>
	}

	// What the codec registry discovers: one stateless instance per file format.
	// A format that cannot be written fails `create`, which tells a caller more
	// than the registry reporting no codec at all.
	interface ArchiveFormat {
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter
	}

	// A read handle bound to one stream. Closing it releases the stream, and
	// for archives opened by path, the underlying file.
	interface Archive {
		io.Closer

		def entries() Entry[]
		def entry(name string) ?Entry
		// Reader over one entry's decoded bytes.
		def open(entry Entry) !io.Reader

		// Both are `extractAll`/`extractEntry` applied to this archive; a format
		// implements them by delegating rather than repeating the walk.
		def extract(dir string, opts ExtractOptions = ExtractOptions{}) !int
		def extract(entry Entry, dir string, opts ExtractOptions = ExtractOptions{}) !none
	}

	// A write handle bound to one stream. `close()` finalizes the archive --
	// writing the central directory or trailer -- so it is not optional.
	interface ArchiveWriter {
		io.Closer

		// Add a file or directory tree from disk.
		def add(path string, opts AddOptions = AddOptions{}) !none
		// Add an entry whose bytes come from anywhere.
		def add(entry Entry, content io.Reader) !none
	}

	// Extracts every entry of `arc` into `dir`, returning how many were written.
	//
	// Every format's extraction is this same walk over `entries()` + `open()`,
	// so it lives here once and a codec's `Archive.extract` delegates to it
	// rather than repeating it. It is exported so a format implemented outside
	// std gets the same behaviour for free.
	//
	// This is also where entry names are checked before anything is written: an
	// entry named `../../etc/passwd`, an absolute path, or a symlink whose
	// target escapes `dir` must be rejected, not extracted. Centralising that
	// is the point -- per-codec extraction would have to repeat the check, and
	// eventually one of them would not.
	// Fails when an entry cannot be read or written.
	def extractAll(arc Archive, dir string, opts ExtractOptions = ExtractOptions{}) !int {
		let written = 0
		for let entry in arc.entries() {
			written += 1 when try writeEntry(arc, entry, dir, opts)
		}
		return written
	}

	// Extracts a single entry of `arc` into `dir`.
	//
	// Applies the same name and symlink-target checks as `extractAll`, so it is
	// safe to call directly on an entry chosen by a caller.
	// Fails when the entry cannot be read or written.
	def extractEntry(arc Archive, entry Entry, dir string, opts ExtractOptions = ExtractOptions{}) !none {
		let written = try writeEntry(arc, entry, dir, opts)
	}

	// Writes one entry below `dir` and reports whether bytes were written:
	// false for a directory entry, an entry skipped by `opts.overwrite`, or a
	// symlink entry when `opts.restoreLinks` is off.
	//
	// `preserveTimes` is accepted but not applied: the Storage service has no
	// way to set a file's times yet.
	internal def writeEntry(arc Archive, entry Entry, dir string, opts ExtractOptions) !bool {
		let rel = try safeEntryPath(entry.name)
		let dest = os.join(dir, rel)
		let kind = int(entry.mode) & fileTypeMask()
		if kind & int(os.FileMode.Dir) != 0 {
			try ensureDir(dest)
			return false
		}
		if kind & int(os.FileMode.Symlink) != 0 {
			return false unless opts.restoreLinks
			let inside = try checkLinkTarget(rel, entry.linkTarget)
			fail "cannot restore symlink " + entry.name + ": the Storage service cannot create links yet"
		}
		fail "archive entry " + entry.name + " is not a regular file, directory or symlink" when kind != 0

		if try os.exists(dest) {
			match opts.overwrite {
				case OverwriteMode.Never:
					fail "refusing to overwrite " + dest
				case OverwriteMode.Skip:
					return false
				case OverwriteMode.IfNewer:
					let info = try os.stat(dest)
					return false unless entry.modTime.after(info.modTime)
				case OverwriteMode.Always:
			}
		}
		try ensureDir(os.dir(dest))

		let src = try arc.open(entry)
		let out = try os.open(dest, "w")
		// Stop at the entry's recorded size, or at a zero read for formats that
		// do not record one. Readers such as `bytes.Reader` fail when read past
		// their end, so the size bound is what keeps the copy from asking.
		let buf byte[] = []
		buf.len(64 * 1024)
		let remaining = int(entry.size)
		let sized = entry.size > 0
		for !sized || remaining > 0 {
			let want = buf.len()
			want = remaining when sized && remaining < want
			let n = try src.read(buf[0:want])
			break when n <= 0
			let wrote = try out.write(buf[0:n])
			fail "short write to " + dest when wrote != n
			remaining -= n
		}
		try out.close()
		try os.chmod(dest, int64(int(entry.mode) & int(os.FileMode.Perm))) when opts.preserveMode
		return true
	}

	// `os.FileMode.Type` spelled out: a computed enum member currently reads
	// as its ordinal (see AGENT_NOTES), so the mask is rebuilt from the
	// literal members.
	internal def fileTypeMask() int {
		return int(os.FileMode.Dir) | int(os.FileMode.Symlink) | int(os.FileMode.NamedPipe) | int(os.FileMode.Socket) | int(os.FileMode.Device) | int(os.FileMode.CharDevice) | int(os.FileMode.Irregular)
	}

	// Normalises an entry name to a relative path with `/` separators and
	// fails when it is empty, absolute, contains a NUL byte or climbs out of
	// the destination with `..`.
	internal def safeEntryPath(name string) !string {
		let cleaned = name.replace("\\", "/")
		fail "archive entry name is empty" when cleaned.trim("/").isEmpty()
		fail "archive entry name contains a NUL byte: " + name when cleaned.indexOf("\0") >= 0
		fail "archive entry name is absolute: " + name when cleaned.startsWith("/") || isDrivePath(cleaned)
		let parts string[] = []
		for let part in cleaned.split("/") {
			continue when part.isEmpty() || part == "."
			if part == ".." {
				fail "archive entry name escapes the destination: " + name when parts.isEmpty()
				parts.pop()
				continue
			}
			parts.push(part)
		}
		fail "archive entry name resolves to nothing: " + name when parts.isEmpty()
		return parts.join("/")
	}

	// Fails when a symlink stored at `rel` would point outside the destination
	// and returns true otherwise. Absolute targets are rejected; relative ones
	// are resolved against the link's own directory.
	internal def checkLinkTarget(rel string, target string) !bool {
		let cleaned = target.replace("\\", "/")
		fail "symlink " + rel + " has an empty target" when cleaned.isEmpty()
		fail "symlink " + rel + " points at an absolute path: " + target when cleaned.startsWith("/") || isDrivePath(cleaned)
		let depth = rel.split("/").len() - 1
		for let part in cleaned.split("/") {
			continue when part.isEmpty() || part == "."
			if part == ".." {
				depth -= 1
				fail "symlink " + rel + " escapes the destination: " + target when depth < 0
				continue
			}
			depth += 1
		}
		return true
	}

	// `C:/...` and `C:\...` spellings, which `startsWith("/")` misses.
	internal def isDrivePath(path string) bool {
		return false when path.len() < 3
		let letter = path[0]
		let isLetter = (letter >= 'a' && letter <= 'z') || (letter >= 'A' && letter <= 'Z')
		return isLetter && path[1] == ':' && path[2] == '/'
	}

	// Creates `path` and any missing parents; an existing directory is fine.
	internal def ensureDir(path string) !none {
		return none when path.isEmpty() || path == "." || path == "/"
		return none when try os.exists(path)
		let parent = os.dir(path)
		try ensureDir(parent) when parent != path
		try os.mkdir(path)
	}

	// Entries can be opened in any order. tar cannot; zip/7z/rar can.
	interface SeekableArchive {
		Archive
	}

	// Entries can be added to or removed from an existing archive in place.
	interface UpdatableArchive {
		Archive
		def remove(entry Entry) !none
	}
}
