partial module std.formats.archive {
	use (
		std.bytes
		std.io
		std.os
		std.time
	)

	// An archive held in memory: enough of `Archive` to drive the extraction
	// suite. Lives at module scope because methods of a type declared inside a
	// `check` block do not link (see AGENT_NOTES).
	internal type MemArchive {
		list    Entry[]
		content map<string, byte[]>

		def new() {
			list = []
			content = map<string, byte[]>{}
		}

		def file(name string, data string, mode int = 0o644) MemArchive {
			list.push(Entry{name: name, mode: os.FileMode(mode), size: uint64(data.len()), modTime: time.now()})
			content[name] = data.bytes()
			return self
		}

		def dir(name string) MemArchive {
			list.push(Entry{name: name, mode: os.FileMode(int(os.FileMode.Dir) | 0o755)})
			return self
		}

		def link(name string, target string) MemArchive {
			list.push(Entry{name: name, mode: os.FileMode(int(os.FileMode.Symlink) | 0o777), linkTarget: target})
			return self
		}

		def close() !none {
			return none
		}

		def entries() Entry[] {
			return list
		}

		def entry(name string) ?Entry {
			for let e in list {
				return e when e.name == name
			}
			return none
		}

		def open(entry Entry) !io.Reader {
			fail "no such entry: " + entry.name unless content.hasKey(entry.name)
			return new bytes.Reader(content[entry.name])
		}

		def extract(dir string, opts ExtractOptions = ExtractOptions{}) !int {
			return extractAll(self, dir, opts)
		}

		def extract(entry Entry, dir string, opts ExtractOptions = ExtractOptions{}) !none {
			return extractEntry(self, entry, dir, opts)
		}
	}

	check "Extraction" {
		use (
			std.testing
			std.bytes
			std.io
			std.os
			std.time
		)

		def scratch(name string) !string {
			let dir = os.join(try os.appHome(), "archive-test", name)
			try ensureDir(dir)
			return dir
		}

		def safe(name string) string {
			return safeEntryPath(name) onerror recover ""
		}

		def linkOk(rel string, target string) bool {
			let ok = checkLinkTarget(rel, target) onerror recover false
			return ok
		}

		def extractFails(arc MemArchive, dir string, opts ExtractOptions) bool {
			let written = extractAll(arc, dir, opts) onerror recover -1
			return written == -1
		}

		def readText(path string) !string {
			let f = try os.open(path)
			let buf byte[] = []
			buf.len(256)
			let n = try f.read(buf)
			try f.close()
			return string(buf[0:n])
		}

		@test()
		def extractsFilesAndDirectories() !none {
			let dir = try scratch("all")
			let arc = new MemArchive()
			arc.dir("docs").file("docs/readme.txt", "hello").file("deep/er/file.txt", "there")
			let written = try extractAll(arc, dir, ExtractOptions{overwrite: OverwriteMode.Always})
			assert written == 2
			assert (try readText(os.join(dir, "docs/readme.txt"))) == "hello"
			assert (try readText(os.join(dir, "deep/er/file.txt"))) == "there"
			assert (try os.stat(os.join(dir, "docs"))).isDir
		}

		@test()
		def overwriteModes() !none {
			let dir = try scratch("overwrite")
			let arc = new MemArchive()
			arc.file("a.txt", "first")
			try extractEntry(arc, arc.list[0], dir, ExtractOptions{overwrite: OverwriteMode.Always})
			let again = new MemArchive()
			again.file("a.txt", "second")
			assert extractFails(again, dir, ExtractOptions{overwrite: OverwriteMode.Never})
			try extractEntry(again, again.list[0], dir, ExtractOptions{overwrite: OverwriteMode.Skip})
			assert (try readText(os.join(dir, "a.txt"))) == "first"
			try extractEntry(again, again.list[0], dir, ExtractOptions{overwrite: OverwriteMode.Always})
			assert (try readText(os.join(dir, "a.txt"))) == "second"
			// IfNewer: an entry stamped in the past never replaces the file
			let old = new MemArchive()
			old.file("a.txt", "third")
			old.list[0].modTime = time.fromUnixNs(0)
			assert (try extractAll(old, dir, ExtractOptions{overwrite: OverwriteMode.IfNewer})) == 0
			assert (try readText(os.join(dir, "a.txt"))) == "second"
		}

		@test()
		def rejectsEscapingNames() !none {
			assert safe("../../etc/passwd") == ""
			assert safe("/etc/passwd") == ""
			assert safe("C:/windows/system32") == ""
			assert safe("a/../..") == ""
			assert safe("") == ""
			assert (try safeEntryPath("a/./b//c")) == "a/b/c"
			assert (try safeEntryPath("a/b/../c")) == "a/c"
			assert (try safeEntryPath("dir\\file.txt")) == "dir/file.txt"
			let dir = try scratch("escape")
			let arc = new MemArchive()
			arc.file("../outside.txt", "nope")
			assert extractFails(arc, dir, ExtractOptions{})
		}

		@test()
		def symlinks() !none {
			let dir = try scratch("links")
			// ignored unless links are restored
			let arc = new MemArchive()
			arc.link("ln", "target.txt")
			assert (try extractAll(arc, dir)) == 0
			// a target that climbs out is rejected before the (unsupported) creation
			let escaping = new MemArchive()
			escaping.link("sub/ln", "../../etc/passwd")
			assert extractFails(escaping, dir, ExtractOptions{restoreLinks: true})
			assert linkOk("sub/ln", "../sibling")
			assert linkOk("sub/ln", "sibling/../other")
			assert !linkOk("sub/ln", "../../up")
			assert !linkOk("ln", "/abs")
		}
	}
}
