partial module std.formats.archive {
	use (
		std.io
		std.os
		std.bytes
		std.formats.archive.stream::*
		std.formats.archive.compressed::*
	)

	// Bz2 is the bzip2 codec (`.bz2`) seen as an archive of one entry: the
	// compressed file, named by the file name without `.bz2` when the data
	// comes from an `os.File`, else "data". bzip2 records neither the size nor
	// the time, so the entry's size is 0 (unknown). Concatenated streams read
	// as one file. A bzip2 file holding a tar archive is left to the tar
	// codecs.
	@codec("BZIP2")
	type Bz2 {
		mimeType string[] {
			def get() string[] {
				return string["application/x-bzip2"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".bz2"]
			}
		}

		// matchSignature reports whether the reader holds bzip2 data that is
		// not a compressed tar archive.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(10)
			let n = io.readFull(r, b) onerror recover 0
			return false unless n == 10 && b[0] == 0x42 && b[1] == 0x5A && b[2] == 0x68 && b[3] >= 0x31 && b[3] <= 0x39
			let block = b[4] == 0x31 && b[5] == 0x41 && b[6] == 0x59 && b[7] == 0x26 && b[8] == 0x53 && b[9] == 0x59
			let end = b[4] == 0x17 && b[5] == 0x72 && b[6] == 0x45 && b[7] == 0x38 && b[8] == 0x50 && b[9] == 0x90
			return false unless block || end
			return !holdsTar(Kind.Bzip2, new bytes.RewindReader(b, r))
		}

		// open returns the one-entry archive. The options do not apply to
		// bzip2. Fails when the data is not bzip2 or the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			let head = try src.bytesAt(0, (src.size() < 4) ?? (src.size(), 4))
			fail "bz2: not bzip2 data" unless head.len() == 4 && head[0] == 0x42 && head[1] == 0x5A && head[2] == 0x68
			let entry = Entry{
				name: entryName(src, ".bz2"),
				mode: os.FileMode(0o644),
				compressedSize: uint64(src.size()),
				method: "bzip2",
			}
			return new SingleArchive(src, Kind.Bzip2, entry)
		}

		// create returns a writer that compresses the one entry added to it
		// into `writer`: Fastest, Fast and None use 100 kB blocks, the other
		// levels 900 kB. A second entry, a directory or a link is refused. The
		// writer's `close` does not close `writer`. Fails when `opts` asks for
		// a password, which bzip2 does not have.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "bz2: bzip2 files cannot be encrypted"
			}
			return new SingleWriter(writer, Kind.Bzip2, opts.level)
		}
	}
}
