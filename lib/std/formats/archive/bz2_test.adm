partial module std.formats.archive {
	// "hello " twenty times, compressed by the system tool.
	internal def helloBz2() byte[] {
		return byte[
		0x42, 0x5a, 0x68, 0x39, 0x31, 0x41, 0x59, 0x26, 0x53, 0x59, 0x67, 0x26, 0xf7, 0x31, 0x00, 0x00,
		0x1d, 0x91, 0x00, 0x40, 0x00, 0x02, 0x44, 0xa0, 0x00, 0x30, 0xcd, 0x00, 0x52, 0xa3, 0x1a, 0x4c,
		0x27, 0xc9, 0x84, 0xd1, 0x38, 0x5d, 0xc9, 0x14, 0xe1, 0x42, 0x41, 0x9c, 0x9b, 0xdc, 0xc4,
		]
	}

	// A tar archive holding a.txt, compressed by the system tool.
	internal def tarBz2() byte[] {
		return byte[
		0x42, 0x5a, 0x68, 0x39, 0x31, 0x41, 0x59, 0x26, 0x53, 0x59, 0xae, 0x1b, 0x41, 0xb8, 0x00, 0x00,
		0x78, 0xdb, 0x90, 0xcc, 0x00, 0x40, 0x01, 0x77, 0x80, 0x00, 0x08, 0x62, 0x44, 0x9e, 0x40, 0x00,
		0x20, 0x08, 0x08, 0x20, 0x00, 0x74, 0x12, 0x54, 0xc1, 0x01, 0xa1, 0xea, 0x01, 0xb5, 0x04, 0x92,
		0x8c, 0x10, 0xd0, 0x07, 0xa8, 0x34, 0x79, 0x59, 0x98, 0x10, 0x4a, 0x02, 0x04, 0x55, 0xeb, 0x42,
		0x6a, 0x28, 0x10, 0xc9, 0xee, 0x64, 0x83, 0x8a, 0x40, 0xd9, 0x82, 0x33, 0x80, 0x0d, 0x10, 0x94,
		0x61, 0x56, 0xa4, 0xb4, 0xdd, 0xa5, 0x1b, 0xf0, 0xa5, 0x21, 0x29, 0xcc, 0xb3, 0x76, 0x08, 0xaa,
		0x40, 0xfe, 0x02, 0x3d, 0x01, 0x0d, 0x67, 0x7b, 0x3e, 0x75, 0x49, 0x07, 0xe2, 0xee, 0x48, 0xa7,
		0x0a, 0x12, 0x15, 0xc3, 0x68, 0x37, 0x00,
		]
	}

	check "Bz2" {
		use (
			std.testing
			std.bytes
			std.io
			std.os
			std.formats.archive.stream::*
		)

		def hello() string {
			return "hello ".repeat(20)
		}

		@test()
		def readsSystemFiles() !none {
			let arc = try new Bz2().open(new bytes.Reader(helloBz2()))
			let list = arc.entries()
			assert list.len() == 1
			assert list[0].name == "data"
			assert list[0].method == "bzip2"
			assert list[0].size == 0
			assert string(try readAll(try arc.open(list[0]))) == hello()
			// Twice: the data is decompressed again from its start.
			assert string(try readAll(try arc.open(list[0]))) == hello()
			let loaded = try load(helloBz2())
			assert string(try readAll(try loaded.open(loaded.entries()[0]))) == hello()
		}

		@test()
		def leavesTarArchivesToTheTarCodecs() !none {
			assert new Bz2().matchSignature(new bytes.Reader(helloBz2()))
			assert !new Bz2().matchSignature(new bytes.Reader(tarBz2()))
			assert !new Bz2().matchSignature(new bytes.Reader("plain".bytes()))
		}

		@test()
		def namesTheEntryAfterTheFile() !none {
			let dir = os.join(try os.appHome(), "archive-test", "bz2")
			try ensureDir(dir)
			let path = os.join(dir, "notes.txt.bz2")
			let f = try os.open(path, "w")
			try f.write(helloBz2())
			try f.close()
			let arc = try new Bz2().open(try os.open(path))
			assert arc.entries()[0].name == "notes.txt"
			let written = try arc.extract(dir, ExtractOptions{overwrite: OverwriteMode.Always})
			assert written == 1
			try arc.close()
			let back = try os.open(os.join(dir, "notes.txt"))
			assert string(try readAll(back)) == hello()
			try back.close()
		}

		@test()
		def roundTrips() !none {
			for let level in [CompressionLevel.Fastest, CompressionLevel.Default, CompressionLevel.Best] {
				let out = new bytes.Buffer()
				let w = try new Bz2().create(out, WriteOptions{level: level})
				try w.add(Entry{name: "notes.txt"}, new bytes.Reader(hello().bytes()))
				let refused = false
				w.add(Entry{name: "more.txt"}, new bytes.Reader([])) onerror (err error) {
					refused = true
					recover none
				}
				assert refused
				try w.close()
				let arc = try new Bz2().open(new bytes.Reader(out.bytes()))
				assert string(try readAll(try arc.open(arc.entries()[0]))) == hello()
			}
			let blank = new bytes.Buffer()
			let w = try new Bz2().create(blank)
			try w.close()
			let arc = try new Bz2().open(new bytes.Reader(blank.bytes()))
			assert (try readAll(try arc.open(arc.entries()[0]))).len() == 0
		}
	}
}
