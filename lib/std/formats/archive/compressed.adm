internal partial module std.formats.archive.compressed {
	use (
		std.io
		std.bytes
		std.os
		std.data.compress.bzip2
		std.data.compress.xz
		std.data.compress.zstd
		std.formats.archive::*
		std.formats.archive.stream::*
		std.formats.archive.tar::*
	)

	// The compressed formats that hold a single file.
	enum Kind {
		Bzip2
		Xz
		Zstd
	}

	// A decompressing reader of the given kind over r.
	def decoder(kind Kind, r io.Reader) io.Reader {
		return new bzip2.Reader(r) when kind == Kind.Bzip2
		return new zstd.Reader(r) when kind == Kind.Zstd
		return new xz.Reader(r)
	}

	// Whether the first 512 decompressed bytes of the reader are a tar
	// header, so a compressed tar archive is left to its own codec.
	def holdsTar(kind Kind, r io.Reader) bool {
		let block byte[]
		block.len(512)
		let got = readUpTo(decoder(kind, r), block) onerror recover 0
		return got == 512 && !isZeroBlock(block) && checksumOk(block)
	}

	// The entry name of a compressed file: the file name without the
	// extension, "data" when the bytes did not come from a file.
	def entryName(src Source, ext string) string {
		let name = os.base(src.fileName().replace("\\", "/"))
		name = name[0:name.len() - ext.len()] when name.lower().endsWith(ext)
		name = "data" when name.isEmpty() || (name := "." || "..")
		return name
	}

	// A compressing writer of the given kind over out, at the preset closest
	// to level.
	def encoderFor(kind Kind, out io.Writer, level CompressionLevel) io.WriteCloser {
		if kind == Kind.Bzip2 {
			let l = bzip2.Level.BestCompression
			l = bzip2.Level.BestSpeed when level == CompressionLevel.Fastest || level == CompressionLevel.Fast || level == CompressionLevel.None
			return new bzip2.Writer(out, l)
		}
		return new zstd.Writer(out) when kind == Kind.Zstd
		let preset = xz.Level.DefaultCompression
		preset = xz.Level.BestSpeed when level == CompressionLevel.Fastest || level == CompressionLevel.None
		preset = xz.Level.BestCompression when level == CompressionLevel.Best
		return new xz.Writer(out, preset)
	}

	// Restarts decompression of the bytes in src, for a tar archive read
	// through bzip2 or xz.
	type CompressedOrigin {
		src  Source
		kind Kind

		def new(src Source, kind Kind) {
			self.src = src
			self.kind = kind
		}

		// start implements StreamOrigin.
		def start() !io.Reader {
			return decoder(kind, src.reader(0, src.size()))
		}

		// close implements io.Closer: closes the file the bytes come from.
		def close() !none {
			return src.close()
		}
	}

	// Writes a tar archive compressed with bzip2 or xz.
	type CompressedTarWriter {
		packer io.WriteCloser
		tar    TarWriter

		def new(out io.Writer, kind Kind, level CompressionLevel) {
			packer = encoderFor(kind, out, level)
			tar = new TarWriter(packer)
		}

		def add(path string, opts AddOptions = AddOptions{}) !none {
			return addTree(self, path, opts)
		}

		def add(entry Entry, content io.Reader) !none {
			return tar.add(entry, content)
		}

		// close implements io.Closer: ends the tar archive and the compressed
		// data. It does not close the writer the archive was created on. Fails
		// when the writer does.
		def close() !none {
			try tar.close()
			return packer.close()
		}
	}

	// A compressed file seen as an archive of one entry.
	type SingleArchive {
		src  Source
		kind Kind
		list Entry[]

		def new(src Source, kind Kind, entry Entry) {
			self.src = src
			self.kind = kind
			list = [entry]
		}

		// close implements io.Closer: closes the file the archive was read from.
		def close() !none {
			return src.close()
		}

		def entries() Entry[] {
			return list
		}

		def entry(name string) ?Entry {
			return list[0] when list[0].name == name
			return none
		}

		def open(entry Entry) !io.Reader {
			expects {
				assert list[0].name == entry.name onerror fail "archive: no entry named " + entry.name
			}
			return decoder(kind, src.reader(0, src.size()))
		}

		def extract(dir string, opts ExtractOptions = ExtractOptions{}) !int {
			return extractAll(self, dir, opts)
		}

		def extract(entry Entry, dir string, opts ExtractOptions = ExtractOptions{}) !none {
			return extractEntry(self, entry, dir, opts)
		}
	}

	// Writes one file compressed; closing without adding one writes empty
	// compressed data.
	type SingleWriter {
		out    io.Writer
		kind   Kind
		level  CompressionLevel
		used   bool
		closed bool

		def new(out io.Writer, kind Kind, level CompressionLevel) {
			self.out = out
			self.kind = kind
			self.level = level
		}

		def encoder() io.WriteCloser {
			return encoderFor(kind, out, level)
		}

		def add(path string, opts AddOptions = AddOptions{}) !none {
			let info = try os.stat(path)
			fail "archive: " + path + " is a directory; a compressed file holds a single file" when info.isDir
			let file = try os.open(path)
			let failure ?error = none
			add(Entry{name: os.base(path), size: uint64(info.size), modTime: info.modTime}, file) onerror (err error) {
				failure = err
				recover none
			}
			file.close() onerror recover none
			fail failure unless failure is none
			return none
		}

		def add(entry Entry, content io.Reader) !none {
			fail "archive: the archive is closed" when closed
			fail "archive: a compressed file holds a single entry" when used
			fail "archive: " + entry.name + " is not a regular file" when isDirMode(entry.mode) || isLinkMode(entry.mode)
			used = true
			let w = encoder()
			let buf byte[]
			buf.len(64 * 1024)
			for {
				let n = try content.read(buf)
				break when n <= 0
				try writeAll(w, buf[0:n])
			}
			try w.close()
			return none
		}

		// close implements io.Closer: writes empty compressed data when no file
		// was added. It does not close the writer the archive was created on.
		// Fails when the writer does.
		def close() !none {
			return none when closed
			closed = true
			if !used {
				try encoder().close()
			}
			return none
		}
	}

	// The uncompressed size of the .xz data in src, summed from the index of
	// every stream, walking back from the end. Fails when the stream footers
	// or indexes are invalid.
	def xzSize(src Source) !int {
		let pos = src.size()
		let total = 0
		for pos > 0 {
			// Stream padding.
			for pos >= 4 {
				let pad = try src.bytesAt(pos - 4, 4)
				break unless pad[0] == 0 && pad[1] == 0 && pad[2] == 0 && pad[3] == 0
				pos -= 4
			}
			break when pos == 0
			fail "xz: not an xz file" when pos < 24
			let footer = try src.bytesAt(pos - 12, 12)
			fail "xz: invalid stream footer" unless footer[10] == 0x59 && footer[11] == 0x5A
			let indexSize = (le32(footer, 4) + 1) * 4
			let indexStart = pos - 12 - indexSize
			fail "xz: invalid stream footer" when indexStart < 12
			let index = try src.bytesAt(indexStart, indexSize)
			fail "xz: invalid index" when index[0] != 0
			let (count, at) = try xzNumber(index, 1)
			let blocks = 0
			let i = at
			for let k = 0; k < count; k++ {
				let (unpadded, a) = try xzNumber(index, i)
				let (size, b) = try xzNumber(index, a)
				blocks += (unpadded + 3) / 4 * 4
				total += size
				i = b
			}
			pos = indexStart - blocks - 12
			fail "xz: invalid index" when pos < 0
		}
		return total
	}

	// The variable-length number at b[at:] and the offset after it. Fails
	// when it runs past b.
	def xzNumber(b byte[], at int) !(int, int) {
		let v = 0
		for let i = 0; i < 9; i++ {
			fail "xz: invalid index" when at + i >= b.len()
			let c = int(b[at + i])
			v |= (c & 0x7F) << (7 * i)
			return (v, at + i + 1) when c & 0x80 == 0
		}
		fail "xz: invalid index"
	}
}
