partial module std.formats.archive {
	check "Compressed tar" {
		use (
			std.testing
			std.bytes
			std.formats.archive.stream::*
		)

		// A tar archive of two files written through `format`, then read back
		// by `load`, which must pick `format` over the one-entry codec.
		internal def roundTrip(format ArchiveCodec) !none {
			let out = new bytes.Buffer()
			let w = try format.create(out)
			try w.add(Entry{name: "a.txt", size: 5}, new bytes.Reader("alpha".bytes()))
			try w.add(Entry{name: "dir/b.txt", size: 4}, new bytes.Reader("beta".bytes()))
			try w.close()
			assert format.matchSignature(new bytes.Reader(out.bytes()))
			let arc = try load(out.bytes())
			let list = arc.entries()
			assert list.len() == 2
			// Out of order: the second read restarts decompression.
			assert string(try readAll(try arc.open(list[1]))) == "beta"
			assert string(try readAll(try arc.open(list[0]))) == "alpha"
		}

		@test()
		def roundTripsTbz2() !none {
			try roundTrip(new Tbz2())
			assert !new Bz2().matchSignature(new bytes.Reader(try tarBytes(new Tbz2())))
		}

		@test()
		def roundTripsTarXz() !none {
			try roundTrip(new TarXz())
			assert !new Xz().matchSignature(new bytes.Reader(try tarBytes(new TarXz())))
		}

		internal def tarBytes(format ArchiveCodec) !byte[] {
			let out = new bytes.Buffer()
			let w = try format.create(out)
			try w.add(Entry{name: "x", size: 1}, new bytes.Reader("x".bytes()))
			try w.close()
			return out.bytes()
		}
	}
}
