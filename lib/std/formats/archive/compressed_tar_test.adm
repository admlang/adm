partial module std.formats.archive {
	check "Compressed tar" {
		use (
			std.testing
			std.bytes
			std.formats.archive.stream::*
		)

		// A tar archive of two files written through `format`, then read back
		// by `load`, which must pick `format` over the one-entry codec.
		internal def roundTrip(format ArchiveCodec) !none {
			let out = new bytes.Buffer()
			let w = try format.create(out)
			try w.add(Entry{name: "a.txt", size: 5}, new bytes.Reader("alpha".bytes()))
			try w.add(Entry{name: "dir/b.txt", size: 4}, new bytes.Reader("beta".bytes()))
			try w.close()
			assert format.matchSignature(new bytes.Reader(out.bytes()))
			let arc = try load(out.bytes())
			let list = arc.entries()
			assert list.len() == 2
			// Out of order: the second read restarts decompression.
			assert string(try readAll(try arc.open(list[1]))) == "beta"
			assert string(try readAll(try arc.open(list[0]))) == "alpha"
		}

		@test()
		def roundTripsTbz2() !none {
			try roundTrip(new Tbz2())
			assert !new Bz2().matchSignature(new bytes.Reader(try tarBytes(new Tbz2())))
		}

		@test()
		def roundTripsTarXz() !none {
			try roundTrip(new TarXz())
			assert !new Xz().matchSignature(new bytes.Reader(try tarBytes(new TarXz())))
		}

		@test()
		def roundTripsTarZst() !none {
			try roundTrip(new TarZst())
			assert !new Zst().matchSignature(new bytes.Reader(try tarBytes(new TarZst())))
			assert new TarZst().matchSignature(new bytes.Reader(try tarBytes(new TarZst())))
		}

		// A `.zst` file: one entry, its size taken from the frame, written
		// by the reference tool and by this codec.
		@test()
		def readsAndWritesZst() !none {
			let reference byte[] = [0x28, 0xB5, 0x2F, 0xFD, 0x24, 0x78, 0x6D, 0x00, 0x00, 0x30, 0x68, 0x65, 0x6C, 0x6C, 0x6F, 0x20, 0x01, 0x00, 0x2F, 0x69, 0x29, 0x02, 0x7A, 0x3E, 0x7C, 0x28]
			let arc = try new Zst().open(new bytes.Reader(reference))
			let list = arc.entries()
			assert list.len() == 1 && list[0].name == "data" && list[0].method == "zstd" && list[0].size == 120
			assert string(try readAll(try arc.open(list[0]))) == "hello ".repeat(20)

			let out = new bytes.Buffer()
			let w = try new Zst().create(out)
			try w.add(Entry{name: "notes.txt"}, new bytes.Reader("hello ".repeat(20).bytes()))
			try w.close()
			let again = try load(out.bytes())
			// A frame written as a stream records no size.
			assert again.entries()[0].size == 0 && again.entries()[0].method == "zstd"
			assert string(try readAll(try again.open(again.entries()[0]))) == "hello ".repeat(20)
		}

		internal def tarBytes(format ArchiveCodec) !byte[] {
			let out = new bytes.Buffer()
			let w = try format.create(out)
			try w.add(Entry{name: "x", size: 1}, new bytes.Reader("x".bytes()))
			try w.close()
			return out.bytes()
		}
	}
}
