partial module std.formats.archive {
	use (
		std.io
		std.bytes
		std.formats.archive.stream::*
		std.formats.archive.gz::*
	)

	// Gz is the gzip codec (`.gz`) seen as an archive of one entry: the
	// compressed file. The entry is named by the gzip header, else by the file
	// name without `.gz` when the data comes from an `os.File`, else "data".
	// Its size is the one the trailer records, which is the size modulo 4 GiB.
	// Only the first member of a multi-member file is read.
	//
	// Data from a `bytes.Reader` or `os.File` is read in place; any other
	// reader is read into memory first. A gzip file holding a tar archive is
	// claimed by `Tgz` instead.
	@codec("GZIP")
	type Gz {
		mimeType string[] {
			def get() string[] {
				return string["application/gzip"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".gz"]
			}
		}

		// matchSignature reports whether the reader holds gzip data that is not a
		// compressed tar archive.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(3)
			let n = io.readFull(r, b) onerror recover 0
			return false unless n == 3 && hasGzipMagic(b)
			return !gzipHoldsTar(new bytes.RewindReader(b, r))
		}

		// open reads the gzip header and trailer and returns the one-entry
		// archive. The options do not apply to gzip.
		//
		// Fails when the data is not gzip or the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			return readGz(src)
		}

		// create returns a writer that compresses the one entry added to it
		// into `writer` at `opts.level`. A second entry, a directory or a link
		// is refused. The writer's `close` does not close `writer`.
		//
		// Fails when `opts` asks for a password, which gzip does not have.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "gz: gzip files cannot be encrypted"
			}
			return new GzWriter(writer, gzipLevel(opts.level))
		}
	}
}
