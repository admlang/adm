internal partial module std.formats.archive.gz {
	use (
		std.io
		std.bytes
		std.os
		std.data.compress.gzip
		std.formats.archive::*
		std.formats.archive.stream::*
		std.formats.archive.tar::*
	)

	// A gzip member over random-access bytes, decompressed afresh from its
	// start on every `start`.
	type GzipOrigin {
		src Source

		def new(src Source) {
			self.src = src
		}

		// start implements StreamOrigin. It cannot fail; the error type comes
		// from StreamOrigin.
		def start() !io.Reader {
			return new gzip.Reader(src.reader(0, src.size()))
		}

		// close implements io.Closer: closes the file the bytes come from.
		def close() !none {
			return src.close()
		}
	}

	// Whether the bytes start with a gzip member header for DEFLATE data.
	def hasGzipMagic(b byte[]) bool {
		return b.len() >= 3 && int(b[0]) == 0x1F && int(b[1]) == 0x8B && int(b[2]) == 8
	}

	// Whether the reader holds gzip data whose first 512 decompressed bytes
	// are a tar header.
	def gzipHoldsTar(r io.Reader) bool {
		let magic byte[]
		magic.len(3)
		let n = io.readFull(r, magic) onerror recover 0
		return false unless n == 3 && hasGzipMagic(magic)
		let inner = new gzip.Reader(new bytes.RewindReader(magic, r))
		let block byte[]
		block.len(512)
		let got = readUpTo(inner, block) onerror recover 0
		return got == 512 && !isZeroBlock(block) && checksumOk(block)
	}

	// A single gzip file seen as an archive of one entry.
	type GzArchive {
		src  Source
		list Entry[]

		def new(src Source) {
			self.src = src
			list = []
		}

		// close implements io.Closer: closes the file the archive was read from.
		def close() !none {
			return src.close()
		}

		def entries() Entry[] {
			return list
		}

		def entry(name string) ?Entry {
			for let e in list {
				return e when e.name == name
			}
			return none
		}

		def open(entry Entry) !io.Reader {
			expects {
				assert list.len() == 1 && list[0].name == entry.name onerror fail "gz: no entry named " + entry.name
			}
			return new gzip.Reader(src.reader(0, src.size()))
		}

		def extract(dir string, opts ExtractOptions = ExtractOptions{}) !int {
			return extractAll(self, dir, opts)
		}

		def extract(entry Entry, dir string, opts ExtractOptions = ExtractOptions{}) !none {
			return extractEntry(self, entry, dir, opts)
		}
	}

	// Reads the member header and trailer of the gzip data in `src`. Fails
	// when it is not gzip data.
	def readGz(src Source) !GzArchive {
		let size = src.size()
		fail "gz: data too short to be gzip" when size < 18
		let headLen = size < 64 * 1024 ?? (size, 64 * 1024)
		let head = try src.bytesAt(0, headLen)
		fail "gz: not gzip data" unless hasGzipMagic(head)
		let flags = int(head[3])
		let mtime = le32(head, 4)
		let at = 10
		at += 2 + le16(head, at) when flags & 0x04 != 0 && at + 2 <= headLen
		let name = ""
		if flags & 0x08 != 0 {
			let (text, next) = latin1Field(head, at)
			name = text
			at = next
		}
		let comment = ""
		if flags & 0x10 != 0 {
			let (text, next) = latin1Field(head, at)
			comment = text
		}
		let tail = try src.bytesAt(size - 8, 8)
		if name.isEmpty() {
			name = src.fileName()
			let lower = name.lower()
			if lower.endsWith(".tgz") {
				name = name[0:name.len() - 4] + ".tar"
			} else if lower.endsWith(".gz") {
				name = name[0:name.len() - 3]
			}
		}
		name = os.base(name.replace("\\", "/"))
		name = "data" when name.isEmpty() || (name := "." || "..")
		let arc = new GzArchive(src)
		arc.list.push(Entry{
			name:           name,
			comment:        comment,
			mode:           os.FileMode(0o644),
			crc32:          uint32(le32(tail, 0)),
			size:           uint64(le32(tail, 4)),
			compressedSize: uint64(size),
			modTime:        unixTime(mtime),
			method:         "deflate",
		})
		return arc
	}

	// A NUL-terminated Latin-1 field at `at` as text, and the offset after it.
	def latin1Field(b byte[], at int) (string, int) {
		let out byte[] = []
		let i = at
		for i < b.len() && int(b[i]) != 0 {
			let c = int(b[i])
			if c < 0x80 {
				out.push(b[i])
			} else {
				out.push(byte(0xC0 | (c >> 6)))
				out.push(byte(0x80 | (c & 0x3F)))
			}
			i++
		}
		return (string(out), i + 1)
	}

	// The gzip level of a CompressionLevel.
	def gzipLevel(level CompressionLevel) gzip.Level {
		match level {
			case CompressionLevel.None:
				return gzip.Level.NoCompression
			case CompressionLevel.Fastest:
				return gzip.Level.BestSpeed
			case CompressionLevel.Fast:
				return gzip.Level.BestSpeed
			case CompressionLevel.Best:
				return gzip.Level.BestCompression
			default:
				return gzip.Level.DefaultCompression
		}
	}

	// Writes one file as a gzip member; closing without adding one writes an
	// empty member.
	type GzWriter {
		out    io.Writer
		level  gzip.Level
		used   bool
		closed bool

		def new(out io.Writer, level gzip.Level) {
			self.out = out
			self.level = level
		}

		def add(path string, opts AddOptions = AddOptions{}) !none {
			let info = try os.stat(path)
			fail "gz: " + path + " is a directory; gzip holds a single file" when info.isDir
			let name = opts.path.isEmpty() ?? (os.base(path), opts.path)
			let file = try os.open(path)
			let failure ?error = none
			add(Entry{name: name, size: uint64(info.size), modTime: info.modTime}, file) onerror (err error) {
				failure = err
				recover none
			}
			file.close() onerror recover none
			fail failure unless failure is none
			return none
		}

		def add(entry Entry, content io.Reader) !none {
			fail "gz: the archive is closed" when closed
			fail "gz: a gzip file holds a single entry" when used
			fail "gz: " + entry.name + " is not a regular file" when isDirMode(entry.mode) || isLinkMode(entry.mode)
			used = true
			let gw = new gzip.Writer(out, level)
			let name = os.base(entry.name.replace("\\", "/"))
			gw.header.name = isLatin1(name) ?? (name, "")
			gw.header.comment = isLatin1(entry.comment) ?? (entry.comment, "")
			gw.header.modTime = entry.modTime
			gw.header.os = 3
			let buf byte[]
			buf.len(64 * 1024)
			for {
				let n = try content.read(buf)
				break when n <= 0
				try writeAll(gw, buf[0:n])
			}
			try gw.close()
			return none
		}

		// close implements io.Closer: writes an empty member when no file was
		// added. It does not close the writer the archive was created on.
		// Fails when the writer does.
		def close() !none {
			return none when closed
			closed = true
			if !used {
				let gw = new gzip.Writer(out, level)
				try gw.close()
			}
			return none
		}
	}

	// Whether every character of the text is in Latin-1 and none is NUL, as
	// gzip header strings require.
	def isLatin1(text string) bool {
		for let (_, c) in text {
			return false when int(c) == 0 || int(c) > 0xFF
		}
		return true
	}

	// A tar archive written through gzip.
	type TgzWriter {
		gz  gzip.Writer
		tar TarWriter

		def new(out io.Writer, level gzip.Level) {
			gz = new gzip.Writer(out, level)
			gz.header.os = 3
			tar = new TarWriter(gz)
		}

		def add(path string, opts AddOptions = AddOptions{}) !none {
			return addTree(self, path, opts)
		}

		def add(entry Entry, content io.Reader) !none {
			return tar.add(entry, content)
		}

		// close implements io.Closer: ends the tar archive and the gzip member.
		// It does not close the writer the archive was created on. Fails when
		// the writer does.
		def close() !none {
			try tar.close()
			return gz.close()
		}
	}
}
