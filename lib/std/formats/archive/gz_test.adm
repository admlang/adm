partial module std.formats.archive {
	// gzip -9 of hello.txt, name and time recorded.
	internal def helloGz() byte[] {
		return byte[
				0x1f, 0x8b, 0x08, 0x08, 0xda, 0x81, 0x38, 0x66, 0x02, 0x03, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x2e, 0x74, 0x78, 0x74, 0x00, 0xcb, 0x48, 0xcd, 0xc9,
				0xc9, 0x57, 0x28, 0xcf, 0x2f, 0xca, 0x49, 0xe1, 0xca, 0x18, 0x01, 0x6c, 0x00, 0xbc, 0x9e, 0x9d, 0x2e, 0xf0, 0x00, 0x00, 0x00,
		]
	}

	check "Gz" {
		use (
			std.testing
			std.bytes
			std.io
			std.os
			std.time
			std.formats.archive.stream::*
		)

		def hello() string {
			let out = ""
			for let i = 0; i < 20; i++ {
				out += "hello world\n"
			}
			return out
		}

		@test()
		def readsGzipFile() !none {
			let arc = try new Gz().open(new bytes.Reader(helloGz()))
			let list = arc.entries()
			assert list.len() == 1
			assert list[0].name == "hello.txt"
			assert list[0].size == 240
			assert list[0].method == "deflate"
			assert list[0].modTime.unixNs() == 1714979290 * 1000000000
			assert string(try readAll(try arc.open(list[0]))) == hello()
			// Twice: the member is decompressed again from its start.
			assert string(try readAll(try arc.open(list[0]))) == hello()
			assert new Gz().matchSignature(new bytes.Reader(helloGz()))
			assert !new Tgz().matchSignature(new bytes.Reader(helloGz()))
			let loaded = try load(helloGz())
			assert loaded.entries()[0].name == "hello.txt"
		}

		@test()
		def roundTrips() !none {
			let out = new bytes.Buffer()
			let w = try new Gz().create(out, WriteOptions{level: CompressionLevel.Best})
			let stamp = time.fromUnixNs(1714979290 * 1000000000)
			try w.add(Entry{name: "dir/notes.txt", comment: "about", modTime: stamp}, new bytes.Reader(hello().bytes()))
			let refused = false
			w.add(Entry{name: "more.txt"}, new bytes.Reader([])) onerror (err error) {
				refused = true
				recover none
			}
			assert refused
			try w.close()
			let arc = try new Gz().open(new bytes.Reader(out.bytes()))
			let e = arc.entries()[0]
			assert e.name == "notes.txt"
			assert e.comment == "about"
			assert e.size == 240
			assert e.modTime.unixNs() == 1714979290 * 1000000000
			assert string(try readAll(try arc.open(e))) == hello()
			assert out.bytes().len() < 240
		}

		@test()
		def emptyArchiveIsAnEmptyMember() !none {
			let out = new bytes.Buffer()
			let w = try new Gz().create(out)
			try w.close()
			let arc = try new Gz().open(new bytes.Reader(out.bytes()))
			assert arc.entries()[0].size == 0
			assert arc.entries()[0].name == "data"
		}
	}
}
