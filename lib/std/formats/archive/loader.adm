partial module std.formats.archive {
	use (
		std.reflection
		std.formats
		std.bytes
		std.os
		std.io
	)

	// ArchiveCodec is what an archive format registers: the format's reader and
	// its file format description.
	type ArchiveCodec = ArchiveFormat & formats.FileFormat

	// codec registers a type as the archive codec of the named format, found
	// through discovery.
	meta def codec<ArchiveCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	internal let codecRegistry = new formats.CodecRegistry<ArchiveCodec>("archive", codec)

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	// Fails when no codec recognises the data, or opening it does.
	def load(data byte[]) !Archive {
		let (dec, _) = try codecRegistry.probe(data)
		// A fresh reader over the bytes lets random-access formats read them in place.
		return dec.open(new bytes.Reader(data))
	}

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	// Fails when the file cannot be opened, no codec recognises it, or opening it does.
	def load(path string) !Archive {
		// No `defer f.close()` here. An archive is a lazy handle: entries are
		// read after this returns, so ownership of the file passes to the
		// returned archive, whose `close()` closes it.
		let f = try os.open(path)

		let (dec, _) = codecRegistry.probe(f) onerror (err error) {
			// Nothing else holds the file on this path, so close it here.
			f.close() onerror recover none
			return err
		}
		// Hand the codec the file itself, rewound, so random-access formats
		// read it in place instead of through the probe's replay buffer.
		let rewound = f.seek(0) onerror recover -1
		if rewound < 0 {
			f.close() onerror recover none
			fail "archive: cannot rewind " + path
		}
		return dec.open(f)
	}

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	// Fails when no codec recognises the data, or opening it does.
	def load(reader io.Reader) !Archive {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.open(r)
	}
}
