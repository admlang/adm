partial module std.formats.archive {
	use (
		std.io
		std.formats.archive.stream::*
		std.formats.archive.rar::*
	)

	// Rar is the RAR archive codec (`.rar`): every generation of the format,
	// RAR 1.4 through RAR 7, read-only. It decodes the RAR 1.5, 2.x (with
	// multimedia mode), 3.x (LZ, PPMd and the standard filters) and RAR 5 / 7
	// compression; solid archives; archives split into volumes, old (`.r00`)
	// and new (`.part2.rar`) naming, when opened by path; self-extracting
	// archives; and the RAR 1.3, 1.5, 2.0, 3.x (AES-128) and 5 (AES-256)
	// encryption of entries and of the entry list (`ReadOptions.password`).
	// Entries carry their names, sizes, times, attributes, comments and
	// links; their bytes are checked against the stored CRC32, BLAKE2sp or
	// keyed checksum. Reading a solid archive's entries in order decodes it
	// once.
	//
	// Entry attributes: "rar.host" names the system that wrote the entry,
	// "rar.attributes" its attribute word as a decimal number, "rar.level"
	// the compression level 0 (store) to 5, "rar.solid" is "true" for an
	// entry that continues a solid stream, "rar.blake2sp" the entry's
	// BLAKE2sp digest in hex, and "rar.redirect" (with "rar.redirectTarget")
	// marks a hard link, file copy or junction.
	@codec("RAR")
	type Rar {
		// The archive comment that `open` last read.
		comment string = ""

		mimeType string[] {
			def get() string[] {
				return string["application/vnd.rar", "application/x-rar-compressed"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".rar"]
			}
		}

		// matchSignature reports whether the reader starts with a RAR
		// signature of any generation.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(8)
			let n = io.readFull(r, b) onerror recover 0
			return n >= 4 && hasRarSignature(b[0:n])
		}

		// open reads the archive's headers, and those of the volumes that
		// follow it, and returns the archive. `opts.password` decrypts
		// encrypted entries and entry lists; names stored without Unicode are
		// decoded with `opts.encoding` ("cp437", "utf-8" or "latin1"; left
		// empty, valid UTF-8 is read as UTF-8 and the rest as code page 437).
		// The volumes of a multi-volume archive are found beside the first,
		// so it must come from a file.
		//
		// Fails when the data is not a RAR archive, a header is corrupt, the
		// entry list is encrypted and the password is missing or wrong, this
		// is not the first volume, a volume is missing, or the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			let keys = new KeyCache()
			let headers = try readRar(src, src.path(), opts, keys)
			comment = headers.comment
			return new RarArchive(headers, opts.password, keys)
		}

		// create always fails: RAR's compression algorithm is proprietary and
		// unpublished, so RAR archives cannot be written. Write a 7z or zip
		// archive instead.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			fail "rar: RAR archives cannot be written (the RAR compression algorithm is proprietary); write a 7z or zip archive instead"
		}
	}
}
