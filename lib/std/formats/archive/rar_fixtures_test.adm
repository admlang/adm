	// RAR fixtures: archives written by RAR 7, RAR 6, RAR 2.90 and RAR 1.5x
	// for DOS, base64-encoded.
	internal def rarFixture(text string[]) byte[] {
		return new encoding.Base64().decode(text.join("")) onerror recover []
	}

