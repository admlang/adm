internal partial module std.formats.archive.rar {
	use (
		std.os
		std.bytes
		std.time
		std.crypto.hash
		std.data.encoding.codepages
		std.formats.archive::*
		std.formats.archive.stream::*
	)

	const (
		maxSfxSize        = 0x400000
		head3Main         = 0x73
		head3File         = 0x74
		head3Cmt          = 0x75
		head3Av           = 0x76
		head3OldService   = 0x77
		head3Protect      = 0x78
		head3Sign         = 0x79
		head3Service      = 0x7A
		head3EndArc       = 0x7B
		head5Main         = 1
		head5File         = 2
		head5Service      = 3
		head5Crypt        = 4
		head5EndArc       = 5
		uoHead            = 0x101
		// RAR 1.5 - 4 flags.
		mhdVolume         = 0x0001
		mhdComment        = 0x0002
		mhdLock           = 0x0004
		mhdSolid          = 0x0008
		mhdNewNumbering   = 0x0010
		mhdProtect        = 0x0040
		mhdPassword       = 0x0080
		mhdFirstVolume    = 0x0100
		lhdSplitBefore    = 0x0001
		lhdSplitAfter     = 0x0002
		lhdPassword       = 0x0004
		lhdComment        = 0x0008
		lhdSolid          = 0x0010
		lhdWindowMask     = 0x00E0
		lhdDirectory      = 0x00E0
		lhdLarge          = 0x0100
		lhdUnicode        = 0x0200
		lhdSalt           = 0x0400
		lhdVersion        = 0x0800
		lhdExtTime        = 0x1000
		longBlock         = 0x8000
		earcNextVolume    = 0x0001
		earcDataCrc       = 0x0002
		earcVolNumber     = 0x0008
		subheadCmtUnicode = 0x00000001
		// RAR 5 flags.
		hflExtra          = 0x0001
		hflData           = 0x0002
		hflSplitBefore    = 0x0008
		hflSplitAfter     = 0x0010
		hflChild          = 0x0020
		mhflVolume        = 0x0001
		mhflVolNumber     = 0x0002
		mhflSolid         = 0x0004
		mhflProtect       = 0x0008
		mhflLock          = 0x0010
		fhflDirectory     = 0x0001
		fhflUtime         = 0x0002
		fhflCrc32         = 0x0004
		fhflUnpUnknown    = 0x0008
		fciSolid          = 0x0040
		fciRar5Compat     = 0x00100000
		chflPswCheck      = 0x0001
		maxDict           = 0x1000000000
		// RAR 5 redirections.
		redirNone         = 0
		redirUnixLink     = 1
		redirWinLink      = 2
		redirJunction     = 3
		redirHardLink     = 4
		redirFileCopy     = 5
		// Unpack versions this reader decodes.
		verUnknown        = 9999
		// 100 ns ticks between 1601-01-01 and 1970-01-01.
		windowsEpoch      = 116444736000000000
	)

	// Which generation of the container the archive uses.
	enum RarFormat {
		// RAR 1.4: "RE~^".
		Rar14,
		// RAR 1.5 to 4.x: "Rar!\x1A\x07\x00".
		Rar15,
		// RAR 5 and later: "Rar!\x1A\x07\x01\x00".
		Rar50
	}

	// A run of an entry's packed bytes in one volume.
	struct DataPart {
		volume int
		offset int
		size   int
	}

	// What a file or service header says.
	type RarRecord {
		name        string
		isService   bool
		isDir       bool
		size        int
		unknownSize bool
		packSize    int
		parts       DataPart[]
		splitBefore bool
		splitAfter  bool
		method      int
		unpVer      int
		winSize     int
		solid       bool
		hostOS      int
		unixHost    bool
		attr        int
		crc         int
		hasCrc      bool
		// RAR 1.4's 16-bit checksum instead of a CRC32.
		sum14       bool
		blake       byte[]
		mtime       time.Time
		ctime       time.Time
		atime       time.Time
		crypt       CryptMethod
		salt        byte[]
		iv          byte[]
		lg2         int
		useHashKey  bool
		pswCheck    byte[]
		usePswCheck bool
		redirType   int
		redirName   string
		dirTarget   bool
		comment     string
		subData     byte[]
		subFlags    int

		def new() {
			parts = []
			blake = []
			salt = []
			iv = []
			pswCheck = []
			subData = []
			mtime = time.fromUnixNs(0)
			ctime = time.fromUnixNs(0)
			atime = time.fromUnixNs(0)
			crypt = CryptMethod.None
		}

		// Whether the record carries a Unix symlink whose target is its data.
		def dataLink() bool {
			return unixHost && redirType == redirNone && (attr & 0xF000) == 0xA000
		}
	}

	// Everything the headers of an archive and its volumes say.
	type RarHeaders {
		format       RarFormat
		sfx          int
		volume       bool
		solid        bool
		locked       bool
		protected    bool
		newNumbering bool
		firstVolume  bool
		encrypted    bool
		records      RarRecord[]
		comment      string
		volumes      Source[]
		// Header encryption parameters (RAR 5).
		cryptSalt    byte[]
		cryptLg2     int

		def new() {
			records = []
			volumes = []
			cryptSalt = []
			firstVolume = true
		}
	}

	// unrar's RawRead: reads past the end give zeros.
	type HeaderBytes {
		b   byte[]
		pos int

		def new(b byte[]) {
			self.b = b
		}

		def left() int {
			return b.len() - pos
		}

		def get1() int {
			return 0 when pos >= b.len()
			let v = int(b[pos])
			pos++
			return v
		}

		def get2() int {
			return 0 when pos + 1 >= b.len()
			let v = le16(b, pos)
			pos += 2
			return v
		}

		def get4() int {
			return 0 when pos + 3 >= b.len()
			let v = le32(b, pos)
			pos += 4
			return v
		}

		def get8() int {
			let lo = get4()
			let hi = get4()
			return (hi << 32) | lo
		}

		// A RAR 5 variable-length number; 0 when it runs off the end.
		def getV() int {
			let v = 0
			let shift = 0
			for pos < b.len() && shift < 64 {
				let c = int(b[pos])
				pos++
				v += (c & 0x7F) << shift
				return v when c & 0x80 == 0
				shift += 7
			}
			return 0
		}

		def bytes(n int) byte[] {
			let out byte[] = []
			out.len((n < 0) ?? (0, n))
			for let i = 0; i < n && pos < b.len(); i++ {
				out[i] = b[pos]
				pos++
			}
			return out
		}
	}

	// Where the archive's signature sits and which format it announces.
	def findSignature(src Source) !(RarFormat, int) {
		let head = try src.bytesAt(0, (src.size() < 8) ?? (src.size(), 8))
		let (found, fmt) = signatureAt(head, 0)
		return (fmt, 0) when found
		let limit = (src.size() < maxSfxSize) ?? (src.size(), maxSfxSize)
		let buf = try src.bytesAt(0, limit)
		for let i = 1; i < buf.len() - 7; i++ {
			continue when buf[i] != 0x52
			let (ok, f) = signatureAt(buf, i)
			continue unless ok
			if f == RarFormat.Rar14 {
				// A RAR 1.4 self-extractor marks itself with "RSFX" at 28.
				continue unless buf.len() > 31 && buf[28] == 0x52 && buf[29] == 0x53 && buf[30] == 0x46 && buf[31] == 0x58
			}
			return (f, i)
		}
		fail "rar: not a RAR archive"
	}

	def signatureAt(b byte[], at int) (bool, RarFormat) {
		return (false, RarFormat.Rar15) when at + 4 > b.len() || b[at] != 0x52
		return (true, RarFormat.Rar14) when b[at + 1] == 0x45 && b[at + 2] == 0x7E && b[at + 3] == 0x5E
		return (false, RarFormat.Rar15) when at + 7 > b.len()
		let mark = b[at + 1] == 0x61 && b[at + 2] == 0x72 && b[at + 3] == 0x21 && b[at + 4] == 0x1A && b[at + 5] == 0x07
		return (false, RarFormat.Rar15) unless mark
		return (true, RarFormat.Rar15) when b[at + 6] == 0
		return (true, RarFormat.Rar50) when b[at + 6] == 1 && at + 8 <= b.len() && b[at + 7] == 0
		return (false, RarFormat.Rar15)
	}

	// Whether the bytes start with a RAR signature of any generation.
	def hasRarSignature(b byte[]) bool {
		let (ok, _) = signatureAt(b, 0)
		return ok
	}

	// The CRC32 of `data`.
	def crc32(data byte[]) int {
		let c = new hash.CRC32()
		c.write(data)
		return int(c.checksum ^ 0xFFFFFFFF)
	}

	// RAR 1.4's file checksum.
	def checksum14(start int, data byte[]) int {
		let s = start
		for let b in data {
			s = (s + int(b)) & 0xFFFF
			s = ((s << 1) | (s >> 15)) & 0xFFFF
		}
		return s
	}

	// An MS-DOS date and time packed in one word, read as UTC.
	def dosWord(t int) time.Time {
		return dosToTime((t >> 16) & 0xFFFF, t & 0xFFFF)
	}

	// A Windows FILETIME (100 ns ticks since 1601); the zero time for 0.
	def windowsTime(t int) time.Time {
		return time.fromUnixNs(0) when t == 0
		return time.fromUnixNs(int64((t - windowsEpoch) * 100))
	}

	// Legacy (non-Unicode) name bytes: UTF-8 when they are valid UTF-8 or
	// asked for, else the chosen code page (437 by default).
	def legacyText(raw byte[], encoding string) string {
		let ascii = true
		for let b in raw {
			if int(b) >= 0x80 {
				ascii = false
				break
			}
		}
		return string(raw) when ascii || (encoding := "utf-8" || "utf8")
		if encoding.isEmpty() {
			let text = string(raw)
			return text when text.isUTF8()
		}
		return codepages.decode(raw, (encoding := "latin1" || "iso88591") ?? (codepages.CodePage.Latin1, codepages.CodePage.CP437))
	}

	// RAR 3's Unicode names: the legacy name, a zero, then the UTF-16 units
	// coded against it (EncodeFileName::Decode).
	def decodeUnicodeName(name byte[], enc byte[]) string {
		let units int[] = []
		let ep = 0
		let high = (ep < enc.len()) ?? (int(enc[0]), 0)
		ep = (enc.len() > 0) ?? (1, 0)
		let flags = 0
		let flagBits = 0
		for ep < enc.len() {
			if flagBits == 0 {
				flags = int(enc[ep])
				ep++
				flagBits = 8
			}
			match (flags >> 6) & 3 {
				case 0:
					break when ep >= enc.len()
					units.push(int(enc[ep]))
					ep++
				case 1:
					break when ep >= enc.len()
					units.push(int(enc[ep]) + (high << 8))
					ep++
				case 2:
					break when ep + 1 >= enc.len()
					units.push(int(enc[ep]) + (int(enc[ep + 1]) << 8))
					ep += 2
				case 3:
					break when ep >= enc.len()
					let length = int(enc[ep])
					ep++
					if length & 0x80 != 0 {
						break when ep >= enc.len()
						let corr = int(enc[ep])
						ep++
						let n = (length & 0x7F) + 2
						for n > 0 && units.len() < name.len() {
							units.push(((int(name[units.len()]) + corr) & 0xFF) + (high << 8))
							n--
						}
					} else {
						let n = length + 2
						for n > 0 && units.len() < name.len() {
							units.push(int(name[units.len()]))
							n--
						}
					}
			}
			flags = (flags << 2) & 0xFF
			flagBits -= 2
		}
		let raw byte[] = []
		for let u in units {
			raw.push(byte(u))
			raw.push(byte(u >> 8))
		}
		return raw.utf16(bytes.Endian.Little)
	}

	// Cuts a name at its first NUL.
	def truncateAtZero(s string) string {
		for let i = 0; i < s.len(); i++ {
			return s.slice(0, i) when s[i] == '\u0000'
		}
		return s
	}

	// Reads every header of the archive whose first volume is `src`.
	// `path` is that volume's path, empty when it was not read from a file.
	def readRar(src Source, path string, opts ReadOptions, keys KeyCache) !RarHeaders {
		let h = new RarHeaders()
		let (fmt, sfx) = try findSignature(src)
		h.format = fmt
		h.sfx = sfx
		h.volumes.push(src)
		let names string[] = [path]
		let vol = 0
		for {
			let more = false
			match h.format {
				case RarFormat.Rar14:
					try readVolume14(h, vol, opts)
				case RarFormat.Rar15:
					more = try readVolume15(h, vol, opts, keys)
				case RarFormat.Rar50:
					more = try readVolume50(h, vol, opts, keys)
			}
			fail "rar: this is not the first volume of the set; open the first one" when vol == 0 && h.volume && !h.firstVolume
			let last = (h.records.len() > 0) ?? (h.records[h.records.len() - 1].splitAfter, false)
			break unless h.volume && (more || last)
			fail "rar: the archive continues in further volumes; open it by path so they can be found" when path.isEmpty()
			let next = nextVolumeName(names[names.len() - 1], !h.newNumbering)
			let exists = os.exists(next) onerror recover false
			if !exists {
				fail "rar: the next volume " + next + " is missing" when last
				break
			}
			let f = try os.open(next)
			let vsrc = try openSource(f)
			let (vf, vsfx) = try findSignature(vsrc)
			fail "rar: volume " + next + " is not a RAR archive of the same kind" when vf != h.format
			h.volumes.push(vsrc)
			names.push(next)
			vol++
			h.sfx = vsfx
		}
		return h
	}

	// NextVolumeName: name.part1.rar → name.part2.rar, or name.rar → .r00 →
	// .r01 in the old numbering.
	def nextVolumeName(name string, oldNumbering bool) string {
		let full = name.bytes()
		let cut = 0
		for let i = 0; i < full.len(); i++ {
			cut = i + 1 when full[i] == byte('/')
		}
		let prefix = full[0:cut].clone()
		let arc = full[cut:].clone()
		let dot = arc.lastIndexOf(byte('.'))
		if dot < 0 {
			arc = arc + ".rar".bytes()
		} else {
			let ext = string(arc[dot + 1:]).lower()
			arc = arc[0:dot + 1].clone() + "rar".bytes() when dot + 1 == arc.len() || (ext := "exe" || "sfx")
		}
		dot = arc.lastIndexOf(byte('.'))
		if !oldNumbering {
			let pos = volNumPos(arc)
			for {
				if arc[pos] == byte('9') {
					arc[pos] = byte('0')
					break when pos == 0
					pos--
					if !isDigit(arc[pos]) {
						arc = arc[0:pos + 1].clone() + "1".bytes() + arc[pos + 1:]
						break
					}
					continue
				}
				arc[pos] = arc[pos] + 1
				break
			}
		} else {
			if arc.len() - dot < 3 {
				arc = arc[0:dot + 1].clone() + "rar".bytes()
			}
			if !isDigit(arc[dot + 2]) || (dot + 3 >= arc.len() || !isDigit(arc[dot + 3])) {
				arc = arc[0:dot + 2].clone() + "00".bytes()
			} else {
				let pos = arc.len() - 1
				for {
					if arc[pos] == byte('9') {
						if pos == 0 || arc[pos - 1] == byte('.') {
							arc[pos] = byte('a')
							break
						}
						arc[pos] = byte('0')
						pos--
						continue
					}
					arc[pos] = arc[pos] + 1
					break
				}
			}
		}
		return string(prefix + arc)
	}

	def isDigit(c byte) bool {
		return c >= byte('0') && c <= byte('9')
	}

	// GetVolNumPos: the last digit of the volume number.
	def volNumPos(name byte[]) int {
		let pos = name.len() - 1
		for pos > 0 && !isDigit(name[pos]) {
			pos--
		}
		let num = pos
		for num > 0 && isDigit(name[num]) {
			num--
		}
		for num > 0 && name[num] != byte('.') {
			if isDigit(name[num]) {
				let first = name.indexOf(byte('.'))
				pos = num when first >= 0 && first < num
				break
			}
			num--
		}
		return pos
	}

	// Adds a split record's continuation to the record it continues.
	def addRecord(h RarHeaders, r RarRecord) !none {
		if r.splitBefore && !r.isService {
			for let i = h.records.len() - 1; i >= 0; i-- {
				let prev = h.records[i]
				if prev.name == r.name && prev.splitAfter {
					for let p in r.parts {
						prev.parts.push(p)
					}
					prev.packSize += r.packSize
					prev.splitAfter = r.splitAfter
					// The last part carries the whole file's checksum.
					prev.crc = r.crc
					prev.hasCrc = r.hasCrc
					prev.blake = r.blake
					prev.useHashKey = r.useHashKey
					return none
				}
			}
			fail "rar: this is not the first volume of the set; open the first one" when h.records.len() == 0
			fail "rar: " + r.name + " continues from a volume that is not part of this set"
		}
		h.records.push(r)
		return none
	}

	// --- RAR 1.4 ---

	def readVolume14(h RarHeaders, vol int, opts ReadOptions) !none {
		let src = h.volumes[vol]
		let at = h.sfx
		let main = try src.bytesAt(at, 7)
		let headSize = le16(main, 4)
		let flags = int(main[6])
		fail "rar: corrupt archive header" when headSize < 7
		h.volume = flags & mhdVolume != 0
		h.solid = flags & mhdSolid != 0
		h.locked = flags & mhdLock != 0
		if vol == 0 && flags & mhdComment != 0 && at + 9 <= src.size() {
			let lenBytes = try src.bytesAt(at + 7, 2)
			let cmtLen = le16(lenBytes, 0)
			h.comment = try readComment14(src, at + 9, cmtLen, flags & mhdNewNumbering != 0, opts)
		}
		let pos = at + headSize
		for pos + 21 <= src.size() {
			let b = try src.bytesAt(pos, 21)
			let r = new RarRecord()
			r.packSize = le32(b, 0)
			r.size = le32(b, 4)
			r.crc = le16(b, 8)
			r.hasCrc = true
			r.sum14 = true
			let hsize = le16(b, 10)
			break when hsize < 21
			r.mtime = dosWord(le32(b, 12))
			r.attr = int(b[16])
			let fflags = int(b[17])
			r.unpVer = (int(b[18]) == 2) ?? (13, 10)
			let nameSize = int(b[19])
			r.method = int(b[20])
			r.splitBefore = fflags & lhdSplitBefore != 0
			r.splitAfter = fflags & lhdSplitAfter != 0
			r.crypt = (fflags & lhdPassword != 0) ?? (CryptMethod.Rar13, CryptMethod.None)
			r.winSize = 0x10000
			r.isDir = r.attr & 0x10 != 0
			r.solid = h.solid
			let raw = try src.bytesAt(pos + 21, nameSize)
			r.name = legacyText(raw, opts.encoding).replace("\\", "/")
			let data = pos + hsize
			r.parts.push(DataPart{volume: vol, offset: data, size: r.packSize})
			try addRecord(h, r)
			pos = data + r.packSize
		}
	}

	// A RAR 1.4 archive comment: stored, or packed with the 1.5 method and
	// a fixed RAR 1.3 key.
	def readComment14(src Source, at int, length int, packed bool, opts ReadOptions) !string {
		return "" when length == 0 || at + length > src.size()
		if !packed {
			return legacyText(try src.bytesAt(at, length), opts.encoding)
		}
		return "" when length < 2
		let lenBytes = try src.bytesAt(at, 2)
		let unpLen = le16(lenBytes, 0)
		let data = try src.bytesAt(at + 2, length - 2)
		let d = new Decryptor(CryptMethod.Rar13)
		d.keyComment13()
		d.decrypt(data, data.len())
		let text = try unpackBuffer(data, unpLen, 15)
		return legacyText(text, opts.encoding)
	}

	// --- RAR 1.5 to 4.x ---

	// Reads one volume's headers; reports whether the end header says
	// another volume follows.
	def readVolume15(h RarHeaders, vol int, opts ReadOptions, keys KeyCache) !bool {
		let src = h.volumes[vol]
		let pos = h.sfx + 7
		let encrypted = false
		let mainSeen = false
		for pos + 7 <= src.size() {
			let start = pos
			let dec = new Decryptor(CryptMethod.None)
			let at = pos
			if encrypted {
				fail "rar: the archive's entry list is encrypted; a password is needed" when opts.password.isEmpty()
				break when at + 8 + 16 > src.size()
				let salt = try src.bytesAt(at, 8)
				at += 8
				dec = newDecryptor(CryptMethod.Rar30, opts.password, salt, [], 0, keys)
			}
			let first = try readHeaderBytes(src, at, 7, dec, encrypted)
			let headCrc = le16(first, 0)
			let kind = int(first[2])
			let flags = le16(first, 3)
			let headSize = le16(first, 5)
			if headSize < 7 {
				fail "rar: wrong password or corrupt header" when encrypted
				fail "rar: corrupt header"
			}
			let full = (encrypted) ?? (((headSize + 15) / 16) * 16, headSize)
			fail "rar: the archive is truncated" when at + full > src.size()
			let raw = try readHeaderBytes(src, at, headSize, dec, encrypted)
			let readSize = headSize
			if kind == head3Cmt || (kind == head3Main && flags & mhdComment != 0) {
				readSize = 13
			}
			readSize = headSize when readSize > headSize
			let next = at + full
			let r = new HeaderBytes(raw[0:readSize])
			r.pos = 7
			let crcFrom = readSize
			let checkCrc = true
			switch {
				case kind == head3Main:
					r.get2()
					r.get4()
					mainSeen = true
					h.volume = flags & mhdVolume != 0
					h.solid = flags & mhdSolid != 0
					h.locked = flags & mhdLock != 0
					h.protected = flags & mhdProtect != 0
					h.newNumbering = flags & mhdNewNumbering != 0
					if vol == 0 {
						h.encrypted = flags & mhdPassword != 0
						if flags & mhdPassword != 0 {
							h.firstVolume = flags & mhdFirstVolume != 0
						}
					}
					encrypted = flags & mhdPassword != 0
					if vol == 0 && flags & mhdComment != 0 {
						h.comment = try readOldComment(src, h.sfx + 7 + 13, opts)
					}
				case kind == head3File || kind == head3Service:
					let rec = try parseFile15(r, kind == head3File, flags, headSize, raw, opts)
					if kind == head3File && flags & lhdComment != 0 {
						// A RAR 2.x file comment follows the fields the CRC covers.
						crcFrom = r.pos
						rec.comment = try oldCommentFrom(raw[r.pos:], opts)
					}
					next += rec.packSize
					rec.parts.push(DataPart{volume: vol, offset: at + full, size: rec.packSize})
					if vol == 0 && !encrypted && kind == head3File && h.volume && h.records.len() == 0 {
						h.firstVolume = !rec.splitBefore
					}
					if kind == head3File {
						rec.solid = rec.solid || (rec.unpVer <= 15 && h.solid && h.records.len() > 0)
						try addRecord(h, rec)
					} else if rec.name == "CMT" && vol == 0 {
						h.comment = try readServiceComment(h, rec, opts, keys, false)
					}
				case kind == head3EndArc:
					let more = flags & earcNextVolume != 0
					try checkHeaderCrc15(raw, readSize, headCrc, encrypted)
					return more
				case kind == head3Protect:
					let dataSize = r.get4()
					next += dataSize
				case kind == head3OldService:
					let dataSize = r.get4()
					let subType = r.get2()
					next += dataSize
					checkCrc = subType != uoHead
				case kind == head3Av || kind == head3Sign:
					checkCrc = false
					next += r.get4() when flags & longBlock != 0
				case kind == head3Cmt:
				default:
					next += r.get4() when flags & longBlock != 0
			}
			if checkCrc {
				try checkHeaderCrc15(raw, crcFrom, headCrc, encrypted)
			}
			fail "rar: corrupt header" when next <= start
			pos = next
		}
		fail "rar: no archive header" unless mainSeen
		return false
	}

	def checkHeaderCrc15(raw byte[], upTo int, want int, encrypted bool) !none {
		let got = crc32(raw[2:upTo]) & 0xFFFF
		if got != want {
			fail "rar: wrong password or corrupt header" when encrypted
			fail "rar: corrupt header (checksum mismatch)"
		}
		return none
	}

	// The header bytes at `at`, decrypted when the headers are encrypted.
	def readHeaderBytes(src Source, at int, size int, dec Decryptor, encrypted bool) !byte[] {
		return try src.bytesAt(at, size) unless encrypted
		let full = ((size + 15) / 16) * 16
		let b = try src.bytesAt(at, full)
		// Every read restarts from the header's first block, so a copy of
		// the decryptor keeps the chain where it was.
		let d = copyDecryptor(dec)
		d.decrypt(b, full)
		return b[0:size]
	}

	def copyDecryptor(d Decryptor) Decryptor {
		let c = new Decryptor(d.method)
		c.aes = d.aes
		c.prev = d.prev.clone()
		return c
	}

	def parseFile15(r HeaderBytes, isFile bool, flags int, headSize int, raw byte[], opts ReadOptions) !RarRecord {
		let rec = new RarRecord()
		rec.isService = !isFile
		rec.splitBefore = flags & lhdSplitBefore != 0
		rec.splitAfter = flags & lhdSplitAfter != 0
		rec.solid = isFile && flags & lhdSolid != 0
		rec.isDir = (flags & lhdWindowMask) == lhdDirectory
		rec.winSize = rec.isDir ?? (0, 0x10000 << ((flags & lhdWindowMask) >> 5))
		let lowPack = r.get4()
		let lowUnp = r.get4()
		rec.hostOS = r.get1()
		rec.crc = r.get4()
		rec.hasCrc = true
		let fileTime = r.get4()
		rec.unpVer = r.get1()
		rec.method = r.get1() - 0x30
		let nameSize = r.get2()
		rec.attr = r.get4()
		rec.isDir = true when rec.unpVer < 20 && rec.attr & 0x10 != 0
		if flags & lhdPassword != 0 {
			match rec.unpVer {
				case 13:
					rec.crypt = CryptMethod.Rar13
				case 15:
					rec.crypt = CryptMethod.Rar15
				case 20, 26:
					rec.crypt = CryptMethod.Rar20
				default:
					rec.crypt = CryptMethod.Rar30
			}
		}
		rec.unixHost = rec.hostOS == 3 || rec.hostOS == 5
		if rec.hostOS == 3 && (rec.attr & 0xF000) == 0xA000 {
			rec.redirType = redirNone
		}
		let highPack = 0
		let highUnp = 0
		if flags & lhdLarge != 0 {
			highPack = r.get4()
			highUnp = r.get4()
			rec.unknownSize = lowUnp == 0xFFFFFFFF && highUnp == 0xFFFFFFFF
		} else {
			rec.unknownSize = lowUnp == 0xFFFFFFFF
		}
		rec.packSize = (highPack << 32) | lowPack
		rec.size = (highUnp << 32) | lowUnp
		let nameRaw = r.bytes(nameSize)
		if isFile {
			let zero = nameRaw.indexOf(byte(0))
			if flags & lhdUnicode != 0 && zero >= 0 && zero + 1 < nameRaw.len() {
				rec.name = decodeUnicodeName(nameRaw[0:zero], nameRaw[zero + 1:])
			}
			if rec.name.isEmpty() {
				let plain = (zero >= 0) ?? (nameRaw[0:zero], nameRaw)
				rec.name = legacyText(plain, (flags & lhdUnicode != 0 && opts.encoding.isEmpty()) ?? ("utf-8", opts.encoding))
			}
			rec.name = truncateAtZero(rec.name.replace("\\", "/"))
		} else {
			rec.name = string(nameRaw)
			let dataSize = headSize - nameSize - 32
			dataSize -= 8 when flags & lhdSalt != 0
			rec.subData = r.bytes(dataSize) when dataSize > 0
			rec.subFlags = rec.attr
		}
		rec.salt = r.bytes(8) when flags & lhdSalt != 0
		rec.mtime = dosWord(fileTime)
		if flags & lhdExtTime != 0 {
			let tflags = r.get2()
			for let i = 0; i < 4; i++ {
				let mode = tflags >> ((3 - i) * 4)
				continue when mode & 8 == 0
				let base = fileTime
				base = r.get4() when i != 0
				let count = mode & 3
				let rem = 0
				for let j = 0; j < count; j++ {
					rem = rem | (r.get1() << ((j + 3 - count) * 8))
				}
				let t = dosWord(base)
				let ns = t.unixNs() + int64(rem) * 100
				ns += 1000000000 when mode & 4 != 0
				match i {
					case 0:
						rec.mtime = time.fromUnixNs(ns)
					case 1:
						rec.ctime = time.fromUnixNs(ns)
					case 2:
						rec.atime = time.fromUnixNs(ns)
				}
			}
		}
		return rec
	}

	// An old-style comment block (HEAD3_CMT) at `at` of the volume.
	def readOldComment(src Source, at int, opts ReadOptions) !string {
		return "" when at + 13 > src.size()
		let b = try src.bytesAt(at, 13)
		let headSize = le16(b, 5)
		return "" when int(b[2]) != head3Cmt || headSize < 13 || at + headSize > src.size()
		return try oldCommentFrom(try src.bytesAt(at, headSize), opts)
	}

	// An old-style comment block: 13 header bytes, then the text, stored or
	// packed. Fails when the text does not match its checksum.
	def oldCommentFrom(b byte[], opts ReadOptions) !string {
		return "" when b.len() < 13 || int(b[2]) != head3Cmt
		let headSize = le16(b, 5)
		return "" when headSize < 13 || headSize > b.len()
		let unpSize = le16(b, 7)
		let unpVer = int(b[9])
		let method = int(b[10])
		let want = le16(b, 11)
		let text = b[13:headSize]
		if method != 0x30 {
			fail "rar: a comment uses an unknown method" when unpVer < 15 || unpVer > 29 || method > 0x35
			text = try unpackBuffer(text, unpSize, unpVer)
		}
		fail "rar: a comment is corrupt" when (crc32(text) & 0xFFFF) != want
		return legacyText(text, opts.encoding)
	}

	// A service header's comment ("CMT"): RAR 3 text, maybe UTF-16, or
	// RAR 5 UTF-8.
	def readServiceComment(h RarHeaders, rec RarRecord, opts ReadOptions, keys KeyCache, utf8 bool) !string {
		return "" when rec.size > 0x1000000
		let data = try readRecordData(h, rec, opts.password, keys)
		if !utf8 && rec.subFlags & subheadCmtUnicode != 0 {
			return truncateAtZero(data.utf16(bytes.Endian.Little))
		}
		return truncateAtZero(string(data)) when utf8
		return truncateAtZero(legacyText(data, opts.encoding))
	}

	// --- RAR 5 ---

	def readVolume50(h RarHeaders, vol int, opts ReadOptions, keys KeyCache) !bool {
		let src = h.volumes[vol]
		let pos = h.sfx + 8
		let encrypted = false
		let mainSeen = false
		for pos + 7 <= src.size() {
			let start = pos
			let at = pos
			let dec = new Decryptor(CryptMethod.None)
			if encrypted {
				break when at + 16 + 16 > src.size()
				let iv = try src.bytesAt(at, 16)
				at += 16
				dec = newDecryptor(CryptMethod.Rar50, opts.password, h.cryptSalt, iv, h.cryptLg2, keys)
			}
			let first = try readHeaderBytes(src, at, 7, dec, encrypted)
			let headCrc = le32(first, 0)
			let fr = new HeaderBytes(first)
			fr.pos = 4
			let sizeStart = fr.pos
			let blockSize = fr.getV()
			let sizeBytes = fr.pos - sizeStart
			if blockSize == 0 || sizeBytes == 0 || sizeBytes > 3 {
				fail "rar: wrong password or corrupt header" when encrypted
				fail "rar: corrupt header"
			}
			let headerSize = 4 + sizeBytes + blockSize
			let full = encrypted ?? (((headerSize + 15) / 16) * 16, headerSize)
			fail "rar: the archive is truncated" when at + full > src.size()
			let raw = try readHeaderBytes(src, at, headerSize, dec, encrypted)
			if crc32(raw[4:headerSize]) != headCrc {
				fail "rar: wrong password or corrupt header" when encrypted
				fail "rar: corrupt header (checksum mismatch)"
			}
			let r = new HeaderBytes(raw)
			r.pos = 4 + sizeBytes
			let kind = r.getV()
			let flags = r.getV()
			let extraSize = 0
			if flags & hflExtra != 0 {
				extraSize = r.getV()
				fail "rar: corrupt header" when extraSize >= headerSize
			}
			let dataSize = 0
			dataSize = r.getV() when flags & hflData != 0
			let next = at + full + dataSize
			switch {
				case kind == head5Crypt:
					let version = r.getV()
					fail "rar: the archive uses an unknown encryption version" when version > 0
					let eflags = r.getV()
					let lg2 = r.get1()
					fail "rar: the archive's key derivation count is too large" when lg2 > 24
					h.cryptSalt = r.bytes(16)
					h.cryptLg2 = lg2
					h.encrypted = true
					fail "rar: the archive's entry list is encrypted; a password is needed" when opts.password.isEmpty()
					if eflags & chflPswCheck != 0 {
						let stored = r.bytes(8)
						let sum = r.bytes(4)
						let digest = new hash.SHA256().hash(stored)
						if digest[0:4].hex() == sum.hex() {
							let k = keys.rar50(opts.password, h.cryptSalt, lg2)
							fail "rar: wrong password" when k.pswCheck.hex() != stored.hex()
						}
					}
					encrypted = true
				case kind == head5Main:
					mainSeen = true
					let aflags = r.getV()
					h.volume = aflags & mhflVolume != 0
					h.solid = aflags & mhflSolid != 0
					h.locked = aflags & mhflLock != 0
					h.protected = aflags & mhflProtect != 0
					h.newNumbering = true
					let volNumber = 0
					volNumber = r.getV() when aflags & mhflVolNumber != 0
					fail "rar: this is not the first volume of the set; open the first one" when vol == 0 && volNumber != 0
					if vol == 0 {
						h.firstVolume = volNumber == 0
					}
				case kind == head5File || kind == head5Service:
					let rec = try parseFile50(r, kind == head5File, flags, extraSize, dataSize, raw.len())
					rec.parts.push(DataPart{volume: vol, offset: at + full, size: dataSize})
					if kind == head5File {
						try addRecord(h, rec)
					} else if rec.name == "CMT" && vol == 0 {
						h.comment = try readServiceComment(h, rec, opts, keys, true)
					}
				case kind == head5EndArc:
					let eflags = r.getV()
					return eflags & 1 != 0
				default:
			}
			fail "rar: corrupt header" when next <= start
			pos = next
		}
		fail "rar: no archive header" unless mainSeen
		return false
	}

	def parseFile50(r HeaderBytes, isFile bool, flags int, extraSize int, dataSize int, total int) !RarRecord {
		let rec = new RarRecord()
		rec.isService = !isFile
		rec.packSize = dataSize
		let fflags = r.getV()
		rec.size = r.getV()
		rec.unknownSize = fflags & fhflUnpUnknown != 0
		rec.attr = r.getV()
		rec.mtime = unixTime(r.get4()) when fflags & fhflUtime != 0
		if fflags & fhflCrc32 != 0 {
			rec.crc = r.get4()
			rec.hasCrc = true
		}
		let comp = r.getV()
		rec.method = (comp >> 7) & 7
		let ver = comp & 0x3F
		rec.unpVer = (ver == 0) ?? (50, (ver == 1) ?? (70, verUnknown))
		rec.hostOS = r.getV()
		rec.unixHost = rec.hostOS == 1
		let nameSize = r.getV()
		rec.splitBefore = flags & hflSplitBefore != 0
		rec.splitAfter = flags & hflSplitAfter != 0
		rec.solid = isFile && comp & fciSolid != 0
		rec.isDir = fflags & fhflDirectory != 0
		if !rec.isDir && ver <= 1 {
			rec.winSize = 0x20000 << ((comp >> 10) & ((ver == 0) ?? (0x0F, 0x1F)))
			if ver == 1 {
				rec.winSize += rec.winSize / 32 * ((comp >> 15) & 0x1F)
				rec.unpVer = 50 when comp & fciRar5Compat != 0
				rec.unpVer = verUnknown when rec.winSize > maxDict
			}
		}
		let name = string(r.bytes(nameSize))
		if extraSize > 0 {
			let start = total - extraSize
			if start >= r.pos {
				r.pos = start
				readExtra50(r, rec)
			}
		}
		if isFile {
			// RAR 5 separates paths with "/", so a backslash in a Windows name
			// is part of the name, which Unix cannot hold.
			name = name.replace("\\", "_") when rec.hostOS == 0
			rec.name = truncateAtZero(name)
			rec.name = rec.name + ";{rec.subFlags}" when rec.subFlags > 0
		} else {
			rec.name = name
		}
		return rec
	}

	// ProcessExtra50 for file and service headers. The file version is left
	// in `subFlags` of a file record.
	def readExtra50(r HeaderBytes, rec RarRecord) {
		let version = 0
		for r.left() >= 2 {
			let fieldSize = r.getV()
			break when fieldSize <= 0 || r.left() == 0 || fieldSize > r.left()
			let next = r.pos + fieldSize
			let kind = r.getV()
			let size = next - r.pos
			break when size < 0
			match kind {
				case 1:
					let ver = r.getV()
					if ver > 0 {
						rec.crypt = CryptMethod.None
						rec.lg2 = -1
					} else {
						let cflags = r.getV()
						rec.lg2 = r.get1()
						rec.usePswCheck = cflags & 1 != 0
						rec.useHashKey = cflags & 2 != 0
						rec.salt = r.bytes(16)
						rec.iv = r.bytes(16)
						if rec.usePswCheck {
							rec.pswCheck = r.bytes(8)
							let sum = r.bytes(4)
							let digest = new hash.SHA256().hash(rec.pswCheck)
							rec.usePswCheck = digest[0:4].hex() == sum.hex()
							rec.usePswCheck = false when rec.isService && rec.pswCheck.hex() == "0000000000000000"
						}
						rec.crypt = CryptMethod.Rar50
					}
				case 2:
					let htype = r.getV()
					rec.blake = r.bytes(32) when htype == 0
				case 3:
					if size >= 5 {
						let tflags = r.getV()
						let unix = tflags & 1 != 0
						let hasM = tflags & 2 != 0
						let hasC = tflags & 4 != 0
						let hasA = tflags & 8 != 0
						if hasM {
							rec.mtime = unix ?? (unixTime(r.get4()), windowsTime(r.get8()))
						}
						if hasC {
							rec.ctime = unix ?? (unixTime(r.get4()), windowsTime(r.get8()))
						}
						if hasA {
							rec.atime = unix ?? (unixTime(r.get4()), windowsTime(r.get8()))
						}
						if unix && tflags & 0x10 != 0 {
							if hasM {
								let ns = r.get4() & 0x3FFFFFFF
								rec.mtime = time.fromUnixNs(rec.mtime.unixNs() + int64(ns)) when ns < 1000000000
							}
							if hasC {
								let ns = r.get4() & 0x3FFFFFFF
								rec.ctime = time.fromUnixNs(rec.ctime.unixNs() + int64(ns)) when ns < 1000000000
							}
							if hasA {
								let ns = r.get4() & 0x3FFFFFFF
								rec.atime = time.fromUnixNs(rec.atime.unixNs() + int64(ns)) when ns < 1000000000
							}
						}
					}
				case 4:
					if size >= 1 {
						r.getV()
						version = r.getV()
					}
				case 5:
					let rtype = r.getV()
					let rflags = r.getV()
					let nsize = r.getV()
					if nsize > 0 && nsize < 0x10000 {
						rec.redirType = rtype
						rec.dirTarget = rflags & 1 != 0
						rec.redirName = string(r.bytes(nsize))
					}
				case 7:
					rec.subData = r.bytes(size)
				default:
			}
			r.pos = next
		}
		rec.subFlags = version when !rec.isService
	}
}
