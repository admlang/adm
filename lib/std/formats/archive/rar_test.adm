partial module std.formats.archive {
	use (
		std.testing
		std.bytes
		std.io
		std.os
		std.formats.archive.stream::*
		std.formats.archive.rar::*
	)

	check "RAR archives" {
		// The text of hello.txt in the fixtures.
		def tinyHello() string {
			let lines string[] = []
			for let i = 0; i < 40; i++ {
				lines.push("line {i}: the quick brown fox jumps over the lazy dog\n")
			}
			return lines.join("")
		}

		def openRar(data byte[], password string = "") !Archive {
			return try new Rar().open(new bytes.Reader(data), ReadOptions{password: password})
		}

		def openOrNone(data byte[], password string) !?Archive {
			return try openRar(data, password)
		}

		// The message opening the archive fails with, empty when it opens.
		def openFailure(data byte[], password string = "") string {
			let failure = ""
			let arc = openOrNone(data, password) onerror (err error) {
				failure = err.message
				recover none
			}
			return failure
		}

		def entryOrNone(arc Archive, e Entry) !?io.Reader {
			return try arc.open(e)
		}

		// The message opening an entry fails with, empty when it opens.
		def entryFailure(arc Archive, e Entry) string {
			let failure = ""
			let r = entryOrNone(arc, e) onerror (err error) {
				failure = err.message
				recover none
			}
			return failure
		}

		def createOrNone() !?ArchiveWriter {
			return try new Rar().create(new bytes.Buffer())
		}

		def readEntry(arc Archive, name string) !byte[] {
			let e = arc.entry(name)
			fail "no entry " + name when e is none
			let r = try arc.open(e)
			let out byte[] = []
			let buf byte[] = []
			buf.len(1000)
			for {
				let n = try r.read(buf)
				break when n == 0
				out = out + buf[0:n]
			}
			return out
		}

		// Reads every entry to its end: each read checks the stored checksum.
		def readEverything(arc Archive) !int {
			let total = 0
			for let e in arc.entries() {
				let r = try arc.open(e)
				total += (try readAll(r)).len()
			}
			return total
		}

		@test()
		def rar5_entries() !none {
			let arc = try openRar(rarFxRar5())
			let names string[] = []
			for let e in arc.entries() {
				names.push(e.name)
			}
			assert names.join(",") == "sub/table.bin,sub/pic.bmp,sub/empty.txt,sub/naïve ☃.txt,hello.txt,prog.exe,tone.wav,link,sub"
			let hello = arc.entry("hello.txt")
			fail "no hello.txt" when hello is none
			assert hello.size == 2110
			assert hello.method == "rar50"
			assert hello.crc32 == 410736740
			assert hello.modTime.unixNs() == 1714979290 * 1000000000
			assert hello.attributes["rar.host"] == "unix"
			assert string(try readEntry(arc, "hello.txt")) == tinyHello()
			let link = arc.entry("link")
			fail "no link" when link is none
			assert isLinkMode(link.mode)
			assert link.linkTarget == "hello.txt"
			let dir = arc.entry("sub")
			fail "no sub" when dir is none
			assert isDirMode(dir.mode)
			assert string(try readEntry(arc, "sub/naïve ☃.txt")) == "ünïcödé\n"
			assert (try readEverything(arc)) == 2000 + 1206 + 12 + 2110 + 3200 + 3000 + 9
			try arc.close()
		}

		@test()
		def rar5_encrypted_solid_blake2() !none {
			let locked = try openRar(rarFxRar5Enc())
			let e = locked.entry("hello.txt")
			fail "no hello.txt" when e is none
			assert e.encrypted
			assert entryFailure(locked, e).contains("password is needed")
			let wrong = try openRar(rarFxRar5Enc(), "nope")
			let failed = false
			readEntry(wrong, "hello.txt") onerror (err error) {
				failed = err.message.contains("wrong password")
				recover []
			}
			assert failed
			let arc = try openRar(rarFxRar5Enc(), "secret")
			// Out of order: the solid stream restarts and decodes again.
			assert (try readEntry(arc, "prog.exe")).len() == 3200
			assert string(try readEntry(arc, "hello.txt")) == tinyHello()
			assert (try readEntry(arc, "sub/table.bin")).len() == 2000
		}

		@test()
		def encrypted_entry_lists() !none {
			assert openFailure(rarFxRar5HeaderEnc()).contains("password is needed")
			assert openFailure(rarFxRar5HeaderEnc(), "nope").contains("wrong password")
			let five = try openRar(rarFxRar5HeaderEnc(), "secret")
			assert string(try readEntry(five, "hello.txt")) == tinyHello()
			let four = try openRar(rarFxRar4HeaderEnc(), "secret")
			assert string(try readEntry(four, "hello.txt")) == tinyHello()
		}

		@test()
		def rar5_filters_and_comment() !none {
			let filtered = try openRar(rarFxRar5Filters())
			assert (try readEverything(filtered)) == 2000 + 3200
			let codec = new Rar()
			let arc = try codec.open(new bytes.Reader(rarFxRar5Comment()))
			assert codec.comment == "Tiny comment ✓\n"
			assert string(try readEntry(arc, "hello.txt")) == tinyHello()
		}

		@test()
		def rar4_solid_in_any_order() !none {
			let arc = try openRar(rarFxRar4())
			let hello = arc.entry("hello.txt")
			fail "no hello.txt" when hello is none
			assert hello.method == "rar29"
			assert hello.attributes["rar.solid"] == "true"
			assert string(try readEntry(arc, "hello.txt")) == tinyHello()
			assert (try readEntry(arc, "sub/table.bin")).len() == 2000
			assert string(try readEntry(arc, "sub/naïve ☃.txt")) == "ünïcödé\n"
			let link = arc.entry("link")
			fail "no link" when link is none
			assert link.linkTarget == "hello.txt"
			assert (try readEverything(arc)) == 2000 + 1206 + 12 + 2110 + 3200 + 3000 + 9
		}

		@test()
		def rar4_ppmd_and_filters() !none {
			assert string(try readEntry(try openRar(rarFxRar4Ppmd()), "hello.txt")) == tinyHello()
			assert (try readEntry(try openRar(rarFxRar4Audio()), "tone.wav")).len() == 3000
			assert (try readEntry(try openRar(rarFxRar4Rgb()), "sub/pic.bmp")).len() == 1206
			assert (try readEverything(try openRar(rarFxRar4DeltaE8()))) == 2000 + 3200
			assert (try readEntry(try openRar(rarFxRar4Itanium()), "prog.exe")).len() == 3200
		}

		@test()
		def rar4_encrypted() !none {
			let arc = try openRar(rarFxRar4Enc(), "secret")
			assert string(try readEntry(arc, "hello.txt")) == tinyHello()
			assert (try readEntry(arc, "prog.exe")).len() == 3200
			let wrong = try openRar(rarFxRar4Enc(), "nope")
			let failed = false
			readEntry(wrong, "hello.txt") onerror (err error) {
				failed = err.message.contains("wrong password or corrupt data")
				recover []
			}
			assert failed
		}

		@test()
		def older_generations() !none {
			let mm = try openRar(rarFxRar2Multimedia())
			assert string(try readEntry(mm, "hello.txt")) == tinyHello()
			assert (try readEntry(mm, "tone.wav")).len() == 3000
			let two = try openRar(rarFxRar2Enc(), "secret")
			assert string(try readEntry(two, "hello.txt")) == tinyHello()
			let fifteen = try openRar(rarFxRar15())
			let e = fifteen.entry("HELLO.TXT")
			fail "no HELLO.TXT" when e is none
			assert e.method == "rar15"
			assert string(try readEntry(fifteen, "HELLO.TXT")) == tinyHello()
			let fifteenEnc = try openRar(rarFxRar15Enc(), "secret")
			assert (try readEntry(fifteenEnc, "PROG.EXE")).len() == 3200
			let fourteen = try openRar(rarFxRar14())
			assert (try readEntry(fourteen, "DATA.BIN")).len() == 256
			let fourteenEnc = try openRar(rarFxRar14Enc(), "secret")
			let data = try readEntry(fourteenEnc, "DATA.BIN")
			assert data.len() == 256 && int(data[255]) == 255
		}

		@test()
		def volumes_by_path() !none {
			let dir = os.join(try os.appHome(), "rar-volumes")
			try os.mkdir(dir, true)
			let five = [rarFxRar5Vol1(), rarFxRar5Vol2(), rarFxRar5Vol3()]
			for let (i, part) in five {
				let f = try os.open(os.join(dir, "set.part{i + 1}.rar"), "w")
				try f.write(part)
				try f.close()
			}
			let arc = try load(os.join(dir, "set.part1.rar"))
			assert string(try readEntry(arc, "hello.txt")) == tinyHello()
			try arc.close()
			let names = ["old.rar", "old.r00", "old.r01"]
			let four = [rarFxRar4OldVol0(), rarFxRar4OldVol1(), rarFxRar4OldVol2()]
			for let (i, part) in four {
				let f = try os.open(os.join(dir, names[i]), "w")
				try f.write(part)
				try f.close()
			}
			let old = try load(os.join(dir, "old.rar"))
			assert string(try readEntry(old, "hello.txt")) == tinyHello()
			try old.close()
			assert openFailure(rarFxRar5Vol1()).contains("open it by path")
		}

		@test()
		def self_extractor_prefix_and_registry() !none {
			let stub = "MZ this stands in for a self-extractor's code. ".bytes()
			let arc = try openRar(stub + rarFxRar4())
			assert string(try readEntry(arc, "hello.txt")) == tinyHello()
			let found = try load(rarFxRar5())
			assert found.entries().len() == 9
			let failure = ""
			let w = createOrNone() onerror (err error) {
				failure = err.message
				recover none
			}
			assert failure.contains("cannot be written")
		}

		@test()
		def volume_names() {
			assert nextVolumeName("a/set.part1.rar", false) == "a/set.part2.rar"
			assert nextVolumeName("set.part09.rar", false) == "set.part10.rar"
			assert nextVolumeName("set.part99.rar", false) == "set.part100.rar"
			assert nextVolumeName("old.rar", true) == "old.r00"
			assert nextVolumeName("old.r09", true) == "old.r10"
			assert nextVolumeName("old.r99", true) == "old.s00"
			assert nextVolumeName("setup.exe", true) == "setup.r00"
		}
	}
}
