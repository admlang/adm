internal partial module std.formats.archive.stream {
	use (
		std.io
		std.bytes
		std.os
		std.time
		std.formats.archive::*
	)

	// Bytes a SectionReader fetches from its source at a time.
	const sectionChunk = 64 * 1024

	// A stream that can be read again from its first byte: what a sequential
	// format (tar) needs to open an entry it has already scanned past.
	interface StreamOrigin {
		def start() !io.Reader
	}

	// Random access over the whole of an archive's bytes: a `bytes.Reader`, an
	// `os.File`, or the bytes of any other reader read into memory.
	type Source {
		src    io.Reader
		length int

		def new(src io.Reader, length int) {
			self.src = src
			self.length = length
		}

		// size is the number of bytes in the source.
		def size() int {
			return length
		}

		// readAt fills buf with the bytes at offset. Fails when the source ends
		// first or cannot be read.
		def readAt(buf byte[], offset int) !none {
			return none when buf.len() == 0
			fail "archive: read past the end of the data" when offset < 0 || offset + buf.len() > length
			let got = 0
			let s = src
			for got < buf.len() {
				let n = 0
				if s is bytes.Reader {
					n = try s.readAt(buf[got:], offset + got)
				} else if s is os.File {
					n = try s.readAt(buf[got:], offset + got)
				}
				fail "archive: the data ended early" when n <= 0
				got += n
			}
			return none
		}

		// bytesAt returns a new array holding `count` bytes from offset. Fails
		// like readAt.
		def bytesAt(offset int, count int) !byte[] {
			let out byte[]
			out.len(count)
			try readAt(out, offset)
			return out
		}

		// reader streams `count` bytes from offset.
		def reader(offset int, count int) SectionReader {
			return new SectionReader(self, offset, count)
		}

		// The base name of the file the bytes come from, empty for bytes that
		// did not come from a file.
		def fileName() string {
			let s = src
			return s.name() when s is os.File
			return ""
		}

		// start implements StreamOrigin: a reader over every byte.
		def start() !io.Reader {
			return reader(0, length)
		}

		// The path of the file the bytes come from, empty for bytes that did
		// not come from a file.
		def path() string {
			let s = src
			return s.path() when s is os.File
			return ""
		}

		// close closes the file the bytes come from, if any. Fails when closing
		// it does.
		def close() !none {
			let s = src
			return s.close() when s is os.File
			return none
		}
	}

	// Wraps a reader for random access. A `bytes.Reader` or `os.File` is used in
	// place; any other reader is read to its end into memory first. Fails when
	// the reader does.
	def openSource(reader io.Reader) !Source {
		return new Source(reader, reader.size()) when reader is bytes.Reader
		if reader is os.File {
			let end = try reader.seek(0, bytes.Whence.End)
			return new Source(reader, int(end))
		}
		let data = try readAll(reader)
		return new Source(new bytes.Reader(data), data.len())
	}

	// Reads the reader to its end. Fails when it does.
	def readAll(reader io.Reader) !byte[] {
		let out byte[]
		out.len(64 * 1024)
		let used = 0
		for {
			out.len(out.len() * 2) when used == out.len()
			let n = try reader.read(out[used:])
			break when n <= 0
			used += n
		}
		out.len(used)
		return out
	}

	// Reads until buf is full or the reader ends, returning how many bytes
	// arrived. Fails when the reader does.
	def readUpTo(reader io.Reader, buf byte[]) !int {
		let got = 0
		for got < buf.len() {
			let n = try reader.read(buf[got:])
			break when n <= 0
			got += n
		}
		return got
	}

	// Writes every byte of data. Fails when the writer does or stops taking
	// bytes.
	def writeAll(writer io.Writer, data byte[]) !none {
		let at = 0
		for at < data.len() {
			let n = try writer.write(data[at:])
			fail "archive: the writer stopped accepting bytes" when n <= 0
			at += n
		}
		return none
	}

	// Reads a window of a Source as a stream, fetching it in chunks so callers
	// reading a byte at a time stay cheap.
	type SectionReader {
		src    Source
		// Offset of the next byte to fetch from the source.
		next   int
		// Offset one past the window.
		end    int
		chunk  byte[]
		at     int
		filled int

		def new(src Source, offset int, count int) {
			self.src = src
			next = offset
			end = offset + count
		}

		// read implements io.Reader: 0 at the end of the window. Fails when the
		// source cannot be read.
		def read(buf byte[]) !int {
			return 0 when buf.len() == 0
			if at >= filled {
				let left = end - next
				return 0 when left <= 0
				if buf.len() >= sectionChunk {
					let n = buf.len() < left ?? (buf.len(), left)
					try src.readAt(buf[0:n], next)
					next += n
					return n
				}
				chunk.len(sectionChunk) when chunk.len() == 0
				let want = left < sectionChunk ?? (left, sectionChunk)
				try src.readAt(chunk[0:want], next)
				next += want
				at = 0
				filled = want
			}
			let n = filled - at
			n = buf.len() when buf.len() < n
			(chunk[at:at + n]).copy(buf)
			at += n
			return n
		}
	}

	// Reads at most `limit` bytes of a reader, then reports its end.
	type LimitReader {
		src  io.Reader
		left int

		def new(src io.Reader, limit int) {
			self.src = src
			left = limit
		}

		// read implements io.Reader. Fails when the wrapped reader does.
		def read(buf byte[]) !int {
			return 0 when left <= 0 || buf.len() == 0
			let want = buf.len() < left ?? (buf.len(), left)
			let n = try src.read(buf[0:want])
			left -= n
			return n
		}
	}

	// Throws away `count` bytes of a reader. Fails when it ends first.
	def discard(reader io.Reader, count int) !none {
		return none when count <= 0
		let scratch byte[]
		scratch.len(count < sectionChunk ?? (count, sectionChunk))
		let left = count
		for left > 0 {
			let want = left < scratch.len() ?? (left, scratch.len())
			let n = try reader.read(scratch[0:want])
			fail "archive: the data ended early" when n <= 0
			left -= n
		}
		return none
	}

	// Little-endian integers at an offset of a byte array.
	def le16(b byte[], at int) int {
		return int(b[at]) | (int(b[at + 1]) << 8)
	}

	def le32(b byte[], at int) int {
		return int(b[at]) | (int(b[at + 1]) << 8) | (int(b[at + 2]) << 16) | (int(b[at + 3]) << 24)
	}

	def le64(b byte[], at int) int {
		return le32(b, at) | (le32(b, at + 4) << 32)
	}

	// Appends little-endian integers to a byte array.
	def put16(out byte[], v int) {
		out.push(byte(v & 0xFF))
		out.push(byte((v >> 8) & 0xFF))
	}

	def put32(out byte[], v int) {
		put16(out, v & 0xFFFF)
		put16(out, (v >> 16) & 0xFFFF)
	}

	def put64(out byte[], v int) {
		put32(out, v & 0xFFFFFFFF)
		put32(out, (v >> 32) & 0xFFFFFFFF)
	}

	// Whether any bit of `flag` is set in the mode.
	def hasMode(mode os.FileMode, flag os.FileMode) bool {
		return int(mode) & int(flag) != 0
	}

	// Whether the mode names a directory.
	def isDirMode(mode os.FileMode) bool {
		return hasMode(mode, os.FileMode.Dir)
	}

	// Whether the mode names a symbolic link.
	def isLinkMode(mode os.FileMode) bool {
		return hasMode(mode, os.FileMode.Symlink)
	}

	// The time `secs` seconds and `nanos` nanoseconds after the Unix epoch.
	def unixTime(secs int, nanos int = 0) time.Time {
		return time.fromUnixNs(int64(secs) * 1000000000 + int64(nanos))
	}

	// Whole seconds since the Unix epoch, rounded down.
	def unixSeconds(t time.Time) int {
		let ns = int(t.unixNs())
		let secs = ns / 1000000000
		secs -= 1 when ns < 0 && ns % 1000000000 != 0
		return secs
	}

	// Whether a time was never set.
	def isZeroTime(t time.Time) bool {
		return t.unixNs() == 0
	}

	// The name an archive records for a path on disk: `/` separators, no drive,
	// no leading `/`, and no `.` or `..` elements.
	def relativeName(path string) string {
		let cleaned = path.replace("\\", "/")
		cleaned = cleaned[2:] when cleaned.len() >= 2 && cleaned[1] == ':'
		let parts string[] = []
		for let part in cleaned.split("/") {
			continue when part.isEmpty() || (part := "." || "..")
			parts.push(part)
		}
		return os.base(path) when parts.isEmpty()
		return parts.join("/")
	}

	// Adds the file or directory at `path` to the writer, descending into
	// directories when `opts.recursive` is set. Fails when the path cannot be
	// read or the writer refuses an entry.
	def addTree(writer ArchiveWriter, path string, opts AddOptions) !none {
		let info = try os.stat(path)
		let name = opts.path.isEmpty() ?? (relativeName(path), opts.path.replace("\\", "/").trim("/"))
		return addNode(writer, path, name, info, opts.recursive)
	}

	def addNode(writer ArchiveWriter, path string, name string, info os.FileInfo, recursive bool) !none {
		let perm = int(info.mode) & 0o777
		if info.isDir {
			perm = 0o755 when perm == 0
			let dir = Entry{name: name + "/", mode: os.FileMode(int(os.FileMode.Dir) | perm), modTime: info.modTime}
			try writer.add(dir, new bytes.Reader([]))
			return none unless recursive
			let children = try os.readDir(path, 0)
			children.sort((a, b) => a.path < b.path)
			for let child in children {
				try addNode(writer, child.path, name + "/" + os.base(child.path), child.info, true)
			}
			return none
		}
		perm = 0o644 when perm == 0
		let file = try os.open(path)
		let entry = Entry{name: name, mode: os.FileMode(perm), size: uint64(info.size), modTime: info.modTime}
		let failure ?error = none
		writer.add(entry, file) onerror (err error) {
			failure = err
			recover none
		}
		file.close() onerror recover none
		fail failure unless failure is none
		return none
	}

	// Days from 1970-01-01 to the given civil date.
	def daysFromCivil(year int, month int, day int) int {
		let y = month <= 2 ?? (year - 1, year)
		let era = (y >= 0 ?? (y, y - 399)) / 400
		let yoe = y - era * 400
		let mp = (month + 9) % 12
		let doy = (153 * mp + 2) / 5 + day - 1
		let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
		return era * 146097 + doe - 719468
	}

	// An MS-DOS date and time, read as UTC.
	def dosToTime(date int, clock int) time.Time {
		return time.fromUnixNs(0) when date == 0
		let year = 1980 + (date >> 9)
		let month = (date >> 5) & 0xF
		let day = date & 0x1F
		month = 1 when month < 1 || month > 12
		day = 1 when day < 1
		let secs = daysFromCivil(year, month, day) * 86400 + (clock >> 11) * 3600 + ((clock >> 5) & 0x3F) * 60 + (clock & 0x1F) * 2
		return unixTime(secs)
	}

	// The MS-DOS (date, time) of an instant in UTC, clamped to 1980..2107.
	def timeToDos(t time.Time) (int, int) {
		let year = t.year()
		return (0x21, 0) when year < 1980
		return ((127 << 9) | (12 << 5) | 31, (23 << 11) | (59 << 5) | 29) when year > 2107
		let date = ((year - 1980) << 9) | (t.month() << 5) | t.day()
		let clock = (t.hour() << 11) | (t.minute() << 5) | (t.second() / 2)
		return (date, clock)
	}
}
