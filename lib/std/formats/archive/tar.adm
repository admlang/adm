partial module std.formats.archive {
	use (
		std.io
		std.formats.archive.stream::*
		std.formats.archive.tar::*
	)

	// Tar is the tape archive codec (`.tar`). It reads v7, POSIX ustar and pax,
	// and GNU archives (long names and links, sparse files), and writes ustar,
	// with pax extended headers for what ustar cannot hold: long or non-ASCII
	// names, large sizes, owners and times.
	//
	// A tar lists its members in one pass. Entries are read in place from a
	// `bytes.Reader` or `os.File`; any other reader is read into memory first.
	@codec("TAR")
	type Tar {
		mimeType string[] {
			def get() string[] {
				return string["application/x-tar"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".tar"]
			}
		}

		// matchSignature reports whether the reader starts with a tar header
		// block whose checksum holds.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(512)
			let n = io.readFull(r, b) onerror recover 0
			return n == 512 && !isZeroBlock(b) && checksumOk(b)
		}

		// open lists the members of the archive. The password and encoding of
		// `opts` do not apply to tar.
		//
		// Fails when the data is not a tar archive, a header is damaged, or the
		// reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			return readTar(src, src)
		}

		// create returns a writer that builds a tar archive on `writer`. The
		// writer's `close` writes the end-of-archive blocks and does not close
		// `writer`.
		//
		// Fails when `opts` asks for a password or compression, which tar does
		// not have.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "tar: archives cannot be encrypted"
			}
			return new TarWriter(writer)
		}
	}
}
