partial module std.formats.archive {
	use (
		std.io
		std.bytes
		std.formats.archive.stream::*
		std.formats.archive.tar::*
		std.formats.archive.compressed::*
	)

	// TarXz is a tar archive compressed with xz (`.tar.xz`, `.txz`): `Tar` read through
	// xz. Listing decompresses the whole stream once; an entry is read by
	// decompressing forward to it, and from the start again when it lies
	// behind the last one read, so extracting in order stays one pass.
	@codec("TXZ")
	type TarXz {
		mimeType string[] {
			def get() string[] {
				return string["application/x-xz-compressed-tar", "application/x-xz"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".tar.xz", ".txz"]
			}
		}

		// matchSignature reports whether the reader holds xz data whose
		// content starts with a tar header.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(6)
			let n = io.readFull(r, b) onerror recover 0
			return false unless n == 6 && b[0] == 0xFD && b[1] == 0x37 && b[2] == 0x7A && b[3] == 0x58 && b[4] == 0x5A && b[5] == 0
			return holdsTar(Kind.Xz, new bytes.RewindReader(b, r))
		}

		// open lists the members of the compressed tar archive. The options do
		// not apply.
		//
		// Fails when the data is not xz, its content is not a tar archive, or
		// the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			return readTar(new CompressedOrigin(src, Kind.Xz), none)
		}

		// create returns a writer that builds a tar archive compressed with
		// xz at `opts.level` on `writer`. The writer's `close` ends both and
		// does not close `writer`.
		//
		// Fails when `opts` asks for a password.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "tar.xz: archives cannot be encrypted"
			}
			return new CompressedTarWriter(writer, Kind.Xz, opts.level)
		}
	}
}
