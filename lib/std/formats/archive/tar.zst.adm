partial module std.formats.archive {
	use (
		std.io
		std.bytes
		std.formats.archive.stream::*
		std.formats.archive.tar::*
		std.formats.archive.compressed::*
	)

	// TarZst is a tar archive compressed with Zstandard (`.tar.zst`, `.tzst`): `Tar`
	// read through Zstandard. Listing decompresses the whole stream once; an entry is read by
	// decompressing forward to it, and from the start again when it lies
	// behind the last one read, so extracting in order stays one pass.
	@codec("TZST")
	type TarZst {
		mimeType string[] {
			def get() string[] {
				return string["application/x-zstd-compressed-tar", "application/zstd"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".tar.zst", ".tzst"]
			}
		}

		// matchSignature reports whether the reader holds Zstandard data whose
		// content starts with a tar header.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)
			let n = io.readFull(r, b) onerror recover 0
			return false unless n == 4 && b[0] == 0x28 && b[1] == 0xB5 && b[2] == 0x2F && b[3] == 0xFD
			return holdsTar(Kind.Zstd, new bytes.RewindReader(b, r))
		}

		// open lists the members of the compressed tar archive. The options do
		// not apply.
		//
		// Fails when the data is not Zstandard, its content is not a tar archive, or
		// the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			return readTar(new CompressedOrigin(src, Kind.Zstd), none)
		}

		// create returns a writer that builds a tar archive compressed with
		// Zstandard on `writer` (one level; `opts.level` is not used). The writer's `close` ends both and
		// does not close `writer`.
		//
		// Fails when `opts` asks for a password.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "tar.zst: archives cannot be encrypted"
			}
			return new CompressedTarWriter(writer, Kind.Zstd, opts.level)
		}
	}
}
