internal partial module std.formats.archive.tar {
	use (
		std.io
		std.bytes
		std.os
		std.time
		std.formats.archive::*
		std.formats.archive.stream::*
	)

	const blockSize = 512

	// Where one member's bytes are and how to rebuild them.
	type TarRecord {
		entry    Entry
		// Offset of the stored bytes in the tar stream, and their count.
		offset   int
		stored   int
		// Sparse files: (offset, length) pairs of the data segments within the
		// full file, whose stored bytes are these segments back to back.
		sparse   int[]
		isSparse bool
		// Index of the record a hard link points at, -1 otherwise.
		linkTo   int

		def new() {
			sparse = []
			linkTo = -1
		}
	}

	// Reads a tar stream sequentially, tracking its position.
	type TarCursor {
		src ?Source
		r   io.Reader
		pos int

		def new(r io.Reader, src ?Source) {
			self.r = r
			self.src = src
		}

		// Fills buf from the stream. Returns false at a clean end of the
		// stream. Fails when the stream ends inside buf or cannot be read.
		def fill(buf byte[]) !bool {
			let got = try readUpTo(r, buf)
			pos += got
			return false when got == 0
			fail "tar: the archive is truncated" when got < buf.len()
			return true
		}

		// Moves forward `count` bytes. Fails when the stream ends first.
		def skip(count int) !none {
			return none when count <= 0
			let random = src
			if random is Source && count >= sectionChunk {
				fail "tar: the archive is truncated" when pos + count > random.size()
				pos += count
				r = random.reader(pos, random.size() - pos)
				return none
			}
			try discard(r, count)
			pos += count
			return none
		}

		// Reads `count` bytes and moves past their padding to the next block.
		// Fails when the stream ends first.
		def take(count int) !byte[] {
			let out byte[]
			out.len(count)
			if count > 0 {
				fail "tar: the archive is truncated" unless try fill(out)
			}
			try skip(padding(count))
			return out
		}
	}

	// Bytes after `size` that fill its last block.
	def padding(size int) int {
		let rest = size % blockSize
		return rest == 0 ?? (0, blockSize - rest)
	}

	// A tar archive listed by one pass over its stream. Entries are read in
	// place from random-access bytes, or by reading the stream again from its
	// start when an entry lies behind the current position.
	type TarArchive {
		origin  StreamOrigin
		src     ?Source
		records TarRecord[]
		list    Entry[]
		// The sequential stream entries are read from, when not random access.
		cursor  ?TarCursor

		def new(origin StreamOrigin, src ?Source) {
			self.origin = origin
			self.src = src
			records = []
			list = []
		}

		// close implements io.Closer: closes the file the archive was read from.
		def close() !none {
			let random = src
			return random.close() unless random is none
			let o = origin
			return o.close() when o is io.Closer
			return none
		}

		def entries() Entry[] {
			return list
		}

		def entry(name string) ?Entry {
			for let e in list {
				return e when e.name == name
			}
			return none
		}

		def open(entry Entry) !io.Reader {
			// A name can repeat when members were appended; the one whose size
			// and time match is meant, else the last.
			let index = -1
			for let i = 0; i < records.len(); i++ {
				let candidate = records[i].entry
				continue unless candidate.name == entry.name
				index = i
				break when candidate.size == entry.size && candidate.modTime.equals(entry.modTime)
			}
			fail "tar: no entry named " + entry.name when index < 0
			let record = records[index]
			record = records[record.linkTo] when record.linkTo >= 0
			let data = try section(record.offset, record.stored)
			return new SparseReader(data, record.sparse, int(record.entry.size)) when record.isSparse
			return data
		}

		def extract(dir string, opts ExtractOptions = ExtractOptions{}) !int {
			return extractAll(self, dir, opts)
		}

		def extract(entry Entry, dir string, opts ExtractOptions = ExtractOptions{}) !none {
			return extractEntry(self, entry, dir, opts)
		}

		// A reader over `count` bytes at `offset` of the tar stream.
		def section(offset int, count int) !io.Reader {
			let random = src
			return random.reader(offset, count) unless random is none
			let current = cursor
			if current is TarCursor {
				if current.pos <= offset {
					try current.skip(offset - current.pos)
					return new CursorReader(current, count)
				}
			}
			let fresh = new TarCursor(try origin.start(), none)
			cursor = fresh
			try fresh.skip(offset)
			return new CursorReader(fresh, count)
		}
	}

	// Reads up to `left` bytes from a shared cursor, advancing it.
	type CursorReader {
		cursor TarCursor
		left   int

		def new(cursor TarCursor, count int) {
			self.cursor = cursor
			left = count
		}

		// read implements io.Reader. Fails when the stream ends early.
		def read(buf byte[]) !int {
			return 0 when left <= 0 || buf.len() == 0
			let want = buf.len() < left ?? (buf.len(), left)
			let n = try cursor.r.read(buf[0:want])
			fail "tar: the archive is truncated" when n <= 0
			cursor.pos += n
			left -= n
			return n
		}
	}

	// Expands the stored segments of a sparse file into the full file, with
	// zeros in the holes.
	type SparseReader {
		src      io.Reader
		segments int[]
		size     int
		pos      int
		index    int

		def new(src io.Reader, segments int[], size int) {
			self.src = src
			self.segments = segments
			self.size = size
		}

		// read implements io.Reader. Fails when the stored data ends early.
		def read(buf byte[]) !int {
			return 0 when pos >= size || buf.len() == 0
			for index * 2 < segments.len() && pos >= segments[index * 2] + segments[index * 2 + 1] {
				index++
			}
			let limit = size - pos
			limit = buf.len() when buf.len() < limit
			if index * 2 >= segments.len() || pos < segments[index * 2] {
				// A hole up to the next segment, or to the end.
				let holeEnd = index * 2 < segments.len() ?? (segments[index * 2], size)
				let n = holeEnd - pos
				n = limit when limit < n
				buf[0:n].fill(byte(0))
				pos += n
				return n
			}
			let segmentEnd = segments[index * 2] + segments[index * 2 + 1]
			let n = segmentEnd - pos
			n = limit when limit < n
			let got = try src.read(buf[0:n])
			fail "tar: sparse data is truncated" when got <= 0
			pos += got
			return got
		}
	}

	// Scans a whole tar stream from `origin` and lists its members. Fails when
	// the data is not a tar archive or is damaged.
	def readTar(origin StreamOrigin, src ?Source) !TarArchive {
		let arc = new TarArchive(origin, src)
		let cursor = new TarCursor(try origin.start(), src)
		let global = map<string, string>{}
		let block byte[]
		block.len(blockSize)
		let longName = ""
		let longLink = ""
		let local = map<string, string>{}
		let localSparse int[] = []
		for {
			break unless try cursor.fill(block)
			if isZeroBlock(block) {
				// The end: two zero blocks, though one or none is tolerated.
				break
			}
			fail "tar: bad header checksum at offset {cursor.pos - blockSize}" unless checksumOk(block)
			let flag = int(block[156])
			let size = parseNumber(block, 124, 12)
			fail "tar: bad size field at offset {cursor.pos - blockSize}" when size < 0
			if flag == int('x') {
				parsePax(try cursor.take(size), local, localSparse)
				continue
			}
			if flag == int('g') {
				let ignored int[] = []
				parsePax(try cursor.take(size), global, ignored)
				continue
			}
			if flag == int('L') {
				longName = cString(try cursor.take(size), 0, size)
				continue
			}
			if flag == int('K') {
				longLink = cString(try cursor.take(size), 0, size)
				continue
			}
			if flag == int('V') {
				try cursor.skip(size + padding(size))
				continue
			}

			let record = new TarRecord()
			let entry = headerEntry(block)
			entry.attributes = map<string, string>{}
			ownerAttributes(block, entry)
			let gnu = isGnu(block)
			for let (k, v) in global {
				applyPax(entry, record, k, v)
			}
			entry.name = longName unless longName.isEmpty()
			entry.linkTarget = longLink unless longLink.isEmpty()
			let stored = size
			for let (k, v) in local {
				applyPax(entry, record, k, v)
				stored = int(entry.size) when k == "size"
			}
			if flag == int('S') && gnu {
				try readOldSparse(block, cursor, record)
				entry.size = uint64(parseNumber(block, 483, 12))
				record.isSparse = true
			}
			if localSparse.len() > 0 {
				record.sparse = localSparse
				record.isSparse = true
			}
			if local.hasKey("GNU.sparse.major") && local["GNU.sparse.major"] == "1" {
				// Format 1.0: the map heads the stored data, in decimal lines.
				let (segments, used) = try readSparseMap(cursor)
				record.sparse = segments
				record.isSparse = true
				stored -= used
			}
			if record.isSparse {
				let real = paxInt(local, "GNU.sparse.realsize", paxInt(local, "GNU.sparse.size", -1))
				entry.size = uint64(real) when real >= 0
			} else {
				entry.size = uint64(stored)
			}
			entry.compressedSize = uint64(stored)

			if flag == int('1') {
				for let i = arc.records.len() - 1; i >= 0; i-- {
					if arc.records[i].entry.name == entry.linkTarget {
						record.linkTo = i
						break
					}
				}
				entry.attributes["tar.hardlink"] = "true"
				if record.linkTo >= 0 {
					let target = arc.records[record.linkTo].entry
					entry.size = target.size
					entry.mode = target.mode
				}
			}
			record.offset = cursor.pos
			record.stored = stored
			record.entry = entry
			arc.records.push(record)
			arc.list.push(entry)
			// Directories and links carry no data, whatever their size says.
			let hasData = flag := int('0') || 0 || int('7') || int('S')
			try cursor.skip(hasData ?? (stored + padding(stored), size + padding(size)))

			longName = ""
			longLink = ""
			local = map<string, string>{}
			localSparse = []
		}
		return arc
	}

	// The shared fields of a ustar, GNU or v7 header block.
	def headerEntry(block byte[]) Entry {
		let flag = int(block[156])
		let name = cString(block, 0, 100)
		if isUstar(block) {
			let prefix = cString(block, 345, 155)
			name = prefix + "/" + name unless prefix.isEmpty()
		}
		let perm = parseNumber(block, 100, 8) & 0o7777
		let mode = fromUnixMode(perm)
		let kind = 0
		switch {
			case flag == int('2'):
				kind = int(os.FileMode.Symlink)
			case flag == int('3'):
				kind = int(os.FileMode.Device) | int(os.FileMode.CharDevice)
			case flag == int('4'):
				kind = int(os.FileMode.Device)
			case flag == int('5') || flag == int('D'):
				kind = int(os.FileMode.Dir)
			case flag == int('6'):
				kind = int(os.FileMode.NamedPipe)
		}
		kind = int(os.FileMode.Dir) when kind == 0 && (flag := 0 || int('0')) && name.endsWith("/")
		let entry = Entry{
			name: name,
			mode: os.FileMode(int(mode) | kind),
			modTime: unixTime(parseNumber(block, 136, 12)),
			linkTarget: cString(block, 157, 100),
		}
		if isGnu(block) {
			let atime = parseNumber(block, 345, 12)
			let ctime = parseNumber(block, 357, 12)
			entry.accessTime = unixTime(atime) when atime > 0
			entry.createTime = unixTime(ctime) when ctime > 0
		}
		return entry
	}

	// Stores the owner fields of a header in the entry's attributes.
	def ownerAttributes(block byte[], entry Entry) {
		entry.attributes["tar.uid"] = "{parseNumber(block, 108, 8)}"
		entry.attributes["tar.gid"] = "{parseNumber(block, 116, 8)}"
		if isUstar(block) || isGnu(block) {
			let uname = cString(block, 265, 32)
			let gname = cString(block, 297, 32)
			entry.attributes["tar.uname"] = uname unless uname.isEmpty()
			entry.attributes["tar.gname"] = gname unless gname.isEmpty()
		}
	}

	// POSIX ustar magic.
	def isUstar(block byte[]) bool {
		return int(block[257]) == 0x75 && int(block[258]) == 0x73 && int(block[259]) == 0x74 && int(block[260]) == 0x61 && int(block[261]) == 0x72 && int(block[262]) == 0
	}

	// GNU tar's "ustar  " magic, whose layout differs after the owner names.
	def isGnu(block byte[]) bool {
		return int(block[257]) == 0x75 && int(block[262]) == 0x20 && int(block[263]) == 0x20
	}

	def isZeroBlock(block byte[]) bool {
		for let i = 0; i < block.len(); i++ {
			return false when int(block[i]) != 0
		}
		return true
	}

	// Whether the header's checksum matches, summed as unsigned or signed bytes.
	def checksumOk(block byte[]) bool {
		let want = parseNumber(block, 148, 8)
		return false when want < 0
		let unsigned = 0
		let signed = 0
		for let i = 0; i < blockSize; i++ {
			let b = (i >= 148 && i < 156) ?? (0x20, int(block[i]))
			unsigned += b
			signed += b >= 0x80 ?? (b - 256, b)
		}
		return want == unsigned || want == signed
	}

	// A numeric field: octal text, or GNU base-256 when the top bit is set.
	// -1 when it holds anything else.
	def parseNumber(block byte[], at int, len int) int {
		let first = int(block[at])
		if first & 0x80 != 0 {
			let v = first & 0x7F
			for let i = 1; i < len; i++ {
				v = (v << 8) | int(block[at + i])
			}
			return v
		}
		let v = 0
		let i = at
		let end = at + len
		for i < end && (int(block[i]) == 0x20 || int(block[i]) == 0) {
			i++
		}
		for i < end {
			let c = int(block[i])
			break when c := 0x20 || 0
			return -1 when c < 0x30 || c > 0x37
			v = v * 8 + (c - 0x30)
			i++
		}
		return v
	}

	// The text of a NUL-terminated field.
	def cString(block byte[], at int, len int) string {
		let end = at
		for end < at + len && int(block[end]) != 0 {
			end++
		}
		return string(block[at:end])
	}

	// Parses pax records `LEN key=value\n` into `into`; the GNU 0.0 sparse
	// offset/numbytes pairs, which repeat, go to `sparse` in order.
	def parsePax(data byte[], into map<string, string>, sparse int[]) {
		let at = 0
		for at < data.len() {
			let space = at
			for space < data.len() && int(data[space]) != 0x20 {
				space++
			}
			break when space >= data.len()
			let len = string(data[at:space]).toInt<int>()
			break when len <= 0 || at + len > data.len()
			let record = data[space + 1:at + len - 1]
			let eq = 0
			for eq < record.len() && int(record[eq]) != 0x3D {
				eq++
			}
			if eq < record.len() {
				let key = string(record[0:eq])
				let value = string(record[eq + 1:])
				if key := "GNU.sparse.offset" || "GNU.sparse.numbytes" {
					sparse.push(value.toInt<int>())
				} else {
					into[key] = value
				}
			}
			at += len
		}
	}

	// Applies one pax record to the entry.
	def applyPax(entry Entry, record TarRecord, key string, value string) {
		match key {
			case "path":
				entry.name = value
			case "GNU.sparse.name":
				entry.name = value
			case "linkpath":
				entry.linkTarget = value
			case "size":
				entry.size = uint64(value.toInt<int>())
			case "mtime":
				entry.modTime = paxTime(value)
			case "atime":
				entry.accessTime = paxTime(value)
			case "ctime":
				entry.createTime = paxTime(value)
			case "uid":
				entry.attributes["tar.uid"] = value
			case "gid":
				entry.attributes["tar.gid"] = value
			case "uname":
				entry.attributes["tar.uname"] = value
			case "gname":
				entry.attributes["tar.gname"] = value
			case "GNU.sparse.map":
				for let part in value.split(",") {
					record.sparse.push(part.toInt<int>())
				}
				record.isSparse = true
		}
	}

	// A pax record as an integer, `fallback` when absent.
	def paxInt(records map<string, string>, key string, fallback int) int {
		let v = records.get(key)
		return fallback when v is none
		return v.toInt<int>()
	}

	// A pax time: decimal seconds with an optional fraction.
	def paxTime(value string) time.Time {
		let dot = value.indexOf(".")
		return unixTime(value.toInt<int>()) when dot < 0
		let secs = value[0:dot].toInt<int>()
		let frac = value[dot + 1:]
		frac = frac[0:9] when frac.len() > 9
		let nanos = frac.toInt<int>()
		for let i = frac.len(); i < 9; i++ {
			nanos *= 10
		}
		nanos = -nanos when value.startsWith("-")
		return unixTime(secs, nanos)
	}

	// The old GNU sparse map: four entries in the header, then extension
	// blocks of 21 while the "extended" flag is set.
	def readOldSparse(block byte[], cursor TarCursor, record TarRecord) !none {
		for let i = 0; i < 4; i++ {
			let at = 386 + i * 24
			let offset = parseNumber(block, at, 12)
			let count = parseNumber(block, at + 12, 12)
			break when offset <= 0 && count <= 0 && i > 0
			record.sparse.push(offset)
			record.sparse.push(count)
		}
		let extended = int(block[482]) != 0
		let ext byte[]
		ext.len(blockSize)
		for extended {
			fail "tar: the archive is truncated" unless try cursor.fill(ext)
			for let i = 0; i < 21; i++ {
				let at = i * 24
				let offset = parseNumber(ext, at, 12)
				let count = parseNumber(ext, at + 12, 12)
				break when offset <= 0 && count <= 0
				record.sparse.push(offset)
				record.sparse.push(count)
			}
			extended = int(ext[504]) != 0
		}
		return none
	}

	// The sparse map of pax format 1.0 at the head of the data: the entry
	// count, then offset and length per entry, one decimal per line, padded
	// to a block. Returns the map and the bytes it took.
	def readSparseMap(cursor TarCursor) !(int[], int) {
		let text byte[] = []
		let block byte[]
		block.len(blockSize)
		let numbers int[] = []
		let at = 0
		let want = -1
		for want < 0 || numbers.len() < want + 1 {
			if at >= text.len() {
				fail "tar: the archive is truncated" unless try cursor.fill(block)
				for let b in block {
					text.push(b)
				}
			}
			let start = at
			for at < text.len() && int(text[at]) != 0x0A {
				at++
			}
			if at >= text.len() {
				at = start
				fail "tar: the archive is truncated" unless try cursor.fill(block)
				for let b in block {
					text.push(b)
				}
				continue
			}
			numbers.push(string(text[start:at]).toInt<int>())
			at++
			want = numbers[0] * 2 when numbers.len() == 1
		}
		return (numbers[1:].clone(), text.len())
	}
}
