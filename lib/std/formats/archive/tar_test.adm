	check "Tar" {
		use (
			std.testing
			std.bytes
			std.io
			std.os
			std.time
			std.data.compress.gzip
			std.formats.archive.stream::*
			std.formats.archive.tar::*
		)

		def gunzip(data byte[]) !byte[] {
			return readAll(new gzip.Reader(new bytes.Reader(data)))
		}

		def openTar(data byte[]) !Archive {
			return new Tar().open(new bytes.Reader(try gunzip(data)))
		}

		def must(arc Archive, name string) !Entry {
			let e = arc.entry(name)
			fail "missing entry " + name when e is none
			return e
		}

		def content(arc Archive, name string) !byte[] {
			return readAll(try arc.open(try must(arc, name)))
		}

		def hello() string {
			let out = ""
			for let i = 0; i < 20; i++ {
				out += "hello world\n"
			}
			return out
		}

		def longName() string {
			let out = "./sub/"
			for let i = 0; i < 120; i++ {
				out += "n"
			}
			return out
		}

		// The sparse file: 100000 bytes, zero but for DATA at 50000 and END at 99997.
		def checkSparse(arc Archive, name string = "./sparse") !none {
			let e = try must(arc, name)
			assert e.size == 100000
			let data = try content(arc, name)
			assert data.len() == 100000
			assert string(data[50000:50004]) == "DATA"
			assert string(data[99997:100000]) == "END"
			let nonZero = 0
			for let b in data {
				nonZero += 1 when int(b) != 0
			}
			assert nonZero == 7
			return none
		}

		def checkTree(arc Archive) !none {
			let stamp = 1714979290 * 1000000000
			let hello = try must(arc, "./hello.txt")
			let hard = try must(arc, "./hard")
			assert hard.size == 240
			assert hard.modTime.unixNs() == stamp
			assert int(hard.mode) & 0o777 == 0o644
			assert !(hard.attributes.get("tar.uid") is none)
			// One of the two names is the hard link, whichever tar met second.
			assert string(try content(arc, "./hello.txt")) == hello()
			assert string(try content(arc, "./hard")) == hello()
			assert hello.size == 240
			let link = try must(arc, "./link")
			assert isLinkMode(link.mode)
			assert link.linkTarget == "hello.txt"
			assert isDirMode((try must(arc, "./sub/")).mode)
			assert string(try content(arc, longName())) == "x"
			assert string(try content(arc, "./\u00E9.txt")) == "caf\u00E9"
			try checkSparse(arc)
			return none
		}

		@test()
		def readsGnuFormat() !none {
			let arc = try openTar(gnuTarGz())
			assert arc.entries().len() == 8
			try checkTree(arc)
		}

		@test()
		def readsPaxFormat() !none {
			let arc = try openTar(paxTarGz())
			assert arc.entries().len() == 8
			try checkTree(arc)
			let sparse = try openTar(pax01TarGz())
			try checkSparse(sparse, "sparse")
		}

		@test()
		def readsUstarFormat() !none {
			let arc = try openTar(ustarTarGz())
			assert arc.entries().len() == 3
			assert string(try content(arc, "hello.txt")) == hello()
			assert (try must(arc, "link")).linkTarget == "hello.txt"
			assert isDirMode((try must(arc, "sub/")).mode)
		}

		@test()
		def readsTgz() !none {
			let arc = try new Tgz().open(new bytes.Reader(paxTarGz()))
			try checkTree(arc)
			// Reading backwards restarts the decompression.
			assert string(try content(arc, "./\u00E9.txt")) == "caf\u00E9"
			assert string(try content(arc, "./hard")) == hello()
			assert new Tgz().matchSignature(new bytes.Reader(gnuTarGz()))
			assert !new Gz().matchSignature(new bytes.Reader(gnuTarGz()))
			assert new Tar().matchSignature(new bytes.Reader(try gunzip(gnuTarGz())))
			assert !new Tar().matchSignature(new bytes.Reader(gnuTarGz()))
			let loaded = try load(gnuTarGz())
			try checkTree(loaded)
			let plain = try load(try gunzip(ustarTarGz()))
			assert plain.entries().len() == 3
		}

		@test()
		def rejectsDamage() !none {
			let data = try gunzip(ustarTarGz())
			data[10] = data[10] ^ 0x01
			let failed = false
			new Tar().open(new bytes.Reader(data)) onerror (err error) {
				failed = true
				recover new MemArchive()
			}
			assert failed
		}

		def veryLong() string {
			let out = ""
			for let i = 0; i < 30; i++ {
				out += "directory{i}/"
			}
			return out + "file.txt"
		}

		def build(codec ArchiveFormat, level CompressionLevel = CompressionLevel.Default) !byte[] {
			let out = new bytes.Buffer()
			let w = try codec.create(out, WriteOptions{level: level})
			let stamp = time.fromUnixNs(1714979290 * 1000000000)
			let owner = map<string, string>{}
			owner["tar.uid"] = "3000000"
			owner["tar.gid"] = "100"
			owner["tar.uname"] = "somebody"
			try w.add(Entry{name: "top", mode: os.FileMode(int(os.FileMode.Dir) | 0o750), modTime: stamp}, new bytes.Reader([]))
			try w.add(Entry{name: "top/hello.txt", mode: os.FileMode(0o640), size: 240, modTime: stamp, attributes: owner}, new bytes.Reader(hello().bytes()))
			try w.add(Entry{name: "top/split/" + longName()[6:], modTime: stamp}, new bytes.Reader("short".bytes()))
			try w.add(Entry{name: veryLong(), modTime: stamp}, new bytes.Reader("deep".bytes()))
			try w.add(Entry{name: "top/\u00E9t\u00E9.txt", modTime: stamp}, new bytes.Reader("\u00E9".bytes()))
			try w.add(Entry{name: "top/link", mode: os.FileMode(int(os.FileMode.Symlink) | 0o777), linkTarget: veryLong(), modTime: stamp}, new bytes.Reader([]))
			let hard = map<string, string>{}
			hard["tar.hardlink"] = "true"
			try w.add(Entry{name: "top/again", linkTarget: "top/hello.txt", modTime: stamp, attributes: hard}, new bytes.Reader([]))
			try w.close()
			return out.bytes()
		}

		def checkBuilt(arc Archive) !none {
			let list = arc.entries()
			assert list.len() == 7
			assert list[0].name == "top/"
			assert isDirMode(list[0].mode)
			assert int(list[0].mode) & 0o777 == 0o750
			let hello = list[1]
			assert hello.size == 240
			assert int(hello.mode) & 0o777 == 0o640
			assert hello.modTime.unixNs() == 1714979290 * 1000000000
			assert hello.attributes["tar.uid"] == "3000000"
			assert hello.attributes["tar.uname"] == "somebody"
			assert string(try content(arc, "top/hello.txt")) == hello()
			assert string(try content(arc, "top/split/" + longName()[6:])) == "short"
			assert string(try content(arc, veryLong())) == "deep"
			assert string(try content(arc, "top/\u00E9t\u00E9.txt")) == "\u00E9"
			assert list[5].linkTarget == veryLong()
			assert isLinkMode(list[5].mode)
			assert list[6].linkTarget == "top/hello.txt"
			assert string(try content(arc, "top/again")) == hello()
			return none
		}

		@test()
		def roundTrips() !none {
			let plain = try build(new Tar())
			assert plain.len() % 512 == 0
			try checkBuilt(try new Tar().open(new bytes.Reader(plain)))
			let packed = try build(new Tgz())
			assert packed.len() < plain.len()
			try checkBuilt(try new Tgz().open(new bytes.Reader(packed)))
			try checkBuilt(try load(packed))
		}

		@test()
		def extractsToDisk() !none {
			let dir = os.join(try os.appHome(), "archive-test", "tgz-extract")
			let arc = try new Tgz().open(new bytes.Reader(gnuTarGz()))
			let written = try arc.extract(dir, ExtractOptions{overwrite: OverwriteMode.Always})
			assert written == 5
			assert string(try os.readFile(os.join(dir, "hello.txt"))) == hello()
			assert string(try os.readFile(os.join(dir, "hard"))) == hello()
			assert (try os.readFile(os.join(dir, "sparse"))).len() == 100000
		}

		@test()
		def splitsUstarNames() !none {
			let (prefix, name) = splitUstarName("a/b")
			assert prefix == "" && name == "a/b"
			let (p2, n2) = splitUstarName(longName())
			assert p2 == "" && n2 == ""
			let dir = longName()[6:106]
			let (p3, _) = splitUstarName(dir + dir + "/" + dir)
			assert p3 == ""
			let (p4, n4) = splitUstarName(dir + "/" + dir)
			assert p4 == dir && n4 == dir
			assert paxRecord("path", "abc") == "12 path=abc\n"
			assert paxRecord("k", "123456") == "12 k=123456\n"
			assert paxRecord("k", "1234567") == "13 k=1234567\n"
			let value = longName()[6:101]
			assert paxRecord("k", value).len() == 102
			assert paxRecord("k", value).startsWith("102 ")
		}
	}
}
