internal partial module std.formats.archive.tar {
	use (
		std.io
		std.bytes
		std.os
		std.time
		std.formats.archive::*
		std.formats.archive.stream::*
	)

	// Largest value an octal field of `len` bytes holds (len - 1 digits).
	def octalLimit(len int) int {
		return (1 << (3 * (len - 1))) - 1
	}

	// Writes a tar archive: a ustar header per entry, with a pax extended
	// header before it for whatever ustar cannot hold.
	type TarWriter {
		out    io.Writer
		closed bool

		def new(out io.Writer) {
			self.out = out
		}

		def add(path string, opts AddOptions = AddOptions{}) !none {
			return addTree(self, path, opts)
		}

		def add(entry Entry, content io.Reader) !none {
			fail "tar: the archive is closed" when closed
			let name = entry.name.replace("\\", "/")
			for name.startsWith("/") {
				name = name[1:]
			}
			fail "tar: entry name is empty" when name.isEmpty()
			let mode = entry.mode
			let flag = int('0')
			let hardlink = entry.attributes.get("tar.hardlink")
			if isDirMode(mode) || name.endsWith("/") {
				flag = int('5')
				name += "/" unless name.endsWith("/")
			} else if isLinkMode(mode) {
				flag = int('2')
			} else if !(hardlink is none) && !entry.linkTarget.isEmpty() {
				flag = int('1')
			} else if hasMode(mode, os.FileMode.CharDevice) {
				flag = int('3')
			} else if hasMode(mode, os.FileMode.Device) {
				flag = int('4')
			} else if hasMode(mode, os.FileMode.NamedPipe) {
				flag = int('6')
			}
			let perm = int(mode) & 0o777
			perm = (flag := int('5') || int('2')) ?? (0o755, 0o644) when perm == 0
			let unixPerm = unixMode(mode) & 0o7777
			unixPerm = (unixPerm & 0o7000) | perm

			// Regular files need their size before the header; content without
			// a recorded size is read ahead to learn it.
			let size = 0
			let spooled ?byte[] = none
			if flag == int('0') {
				if entry.size > 0 {
					size = int(entry.size)
				} else {
					let data = try readAll(content)
					size = data.len()
					spooled = data
				}
			}

			let modTime = isZeroTime(entry.modTime) ?? (time.now(), entry.modTime)
			let mtime = unixSeconds(modTime)
			let uid = attrInt(entry, "tar.uid")
			let gid = attrInt(entry, "tar.gid")
			let uname = attrText(entry, "tar.uname")
			let gname = attrText(entry, "tar.gname")
			let link = (flag := int('1') || int('2')) ?? (entry.linkTarget.replace("\\", "/"), "")

			let pax string[] = []
			let (prefix, short) = splitUstarName(name)
			if short.isEmpty() || !isAscii(name) {
				pax.push(paxRecord("path", name))
				short = name.len() > 100 ?? (name[0:100], name)
				prefix = ""
			}
			pax.push(paxRecord("linkpath", link)) when link.len() > 100 || !isAscii(link)
			pax.push(paxRecord("size", "{size}")) when size > octalLimit(12)
			pax.push(paxRecord("mtime", "{mtime}")) when mtime < 0 || mtime > octalLimit(12)
			pax.push(paxRecord("uid", "{uid}")) when uid > octalLimit(8)
			pax.push(paxRecord("gid", "{gid}")) when gid > octalLimit(8)
			pax.push(paxRecord("uname", uname)) when uname.len() > 32 || !isAscii(uname)
			pax.push(paxRecord("gname", gname)) when gname.len() > 32 || !isAscii(gname)

			if pax.len() > 0 {
				let records = pax.join("").bytes()
				let paxName = "PaxHeaders/" + os.base(name.trim("/"))
				paxName = paxName[0:100] when paxName.len() > 100
				let header = ustarHeader(paxName.bytes(), "".bytes(), int('x'), 0o644, records.len(), clampOctal(mtime, 12), 0, 0, byte[], byte[], byte[])
				try writeAll(out, header)
				try writeAll(out, records)
				try writeAll(out, zeros(padding(records.len())))
			}
			let header = ustarHeader(short.bytes(), prefix.bytes(), flag, unixPerm, clampOctal(size, 12), clampOctal(mtime, 12), clampOctal(uid, 8), clampOctal(gid, 8), asciiField(uname, 32), asciiField(gname, 32), linkField(link))
			try writeAll(out, header)

			let data = spooled
			if !(data is none) {
				try writeAll(out, data)
			} else if size > 0 {
				try copyExactly(content, out, size, name)
			}
			try writeAll(out, zeros(padding(size)))
			return none
		}

		// close implements io.Closer: writes the two zero blocks that end the
		// archive. It does not close the writer the archive was created on.
		// Fails when the writer does.
		def close() !none {
			return none when closed
			closed = true
			return writeAll(out, zeros(2 * blockSize))
		}
	}

	// Copies exactly `size` bytes. Fails when the reader ends first.
	def copyExactly(content io.Reader, out io.Writer, size int, name string) !none {
		let buf byte[]
		buf.len(size < 64 * 1024 ?? (size, 64 * 1024))
		let left = size
		for left > 0 {
			let want = left < buf.len() ?? (left, buf.len())
			let n = try content.read(buf[0:want])
			fail "tar: " + name + " ended before its recorded size" when n <= 0
			try writeAll(out, buf[0:n])
			left -= n
		}
		return none
	}

	def zeros(count int) byte[] {
		let out byte[]
		out.len(count)
		out.fill(byte(0))
		return out
	}

	def isAscii(text string) bool {
		for let b in text.bytes() {
			return false when int(b) >= 0x80
		}
		return true
	}

	// Splits a name into ustar's prefix (155) and name (100) fields at a
	// slash; the name part is empty when no split fits.
	def splitUstarName(name string) (string, string) {
		return ("", name) when name.len() <= 100
		for let i = name.len() - 1; i > 0; i-- {
			continue unless name[i] == '/'
			return (name[0:i], name[i + 1:]) when i <= 155 && name.len() - i - 1 <= 100 && name.len() - i - 1 > 0
		}
		return ("", "")
	}

	// One pax record: its decimal length (which counts itself), the key, `=`,
	// the value and a newline.
	def paxRecord(key string, value string) string {
		let body = key.bytes().len() + value.bytes().len() + 3
		let digits = "{body}".len()
		let total = body + digits
		total += 1 when "{total}".len() != digits
		return "{total} " + key + "=" + value + "\n"
	}

	def attrText(entry Entry, key string) string {
		let v = entry.attributes.get(key)
		return "" when v is none
		return v
	}

	def attrInt(entry Entry, key string) int {
		let v = entry.attributes.get(key)
		return 0 when v is none
		return v.isNumeric() ?? (v.toInt<int>(), 0)
	}

	// The value when it fits an octal field, else 0 (a pax record holds it).
	def clampOctal(value int, len int) int {
		return (value < 0 || value > octalLimit(len)) ?? (0, value)
	}

	// A text field's bytes when they are ASCII and fit, else none (a pax
	// record holds them).
	def asciiField(text string, len int) byte[] {
		return byte[] when text.len() > len || !isAscii(text)
		return text.bytes()
	}

	def linkField(link string) byte[] {
		return asciiField(link, 100)
	}

	def putOctal(block byte[], at int, len int, value int) {
		let v = value
		for let i = len - 2; i >= 0; i-- {
			block[at + i] = byte(0x30 + (v & 7))
			v = v >> 3
		}
		block[at + len - 1] = byte(0)
	}

	def putText(block byte[], at int, text byte[], len int) {
		let n = text.len() < len ?? (text.len(), len)
		for let i = 0; i < n; i++ {
			block[at + i] = text[i]
		}
	}

	// A ustar header block with its checksum.
	def ustarHeader(name byte[], prefix byte[], flag int, mode int, size int, mtime int, uid int, gid int, uname byte[], gname byte[], link byte[]) byte[] {
		let block = zeros(blockSize)
		putText(block, 0, name, 100)
		putOctal(block, 100, 8, mode)
		putOctal(block, 108, 8, uid)
		putOctal(block, 116, 8, gid)
		putOctal(block, 124, 12, size)
		putOctal(block, 136, 12, mtime)
		block[156] = byte(flag)
		putText(block, 157, link, 100)
		putText(block, 257, "ustar".bytes(), 6)
		block[263] = byte(0x30)
		block[264] = byte(0x30)
		putText(block, 265, uname, 32)
		putText(block, 297, gname, 32)
		putOctal(block, 329, 8, 0)
		putOctal(block, 337, 8, 0)
		putText(block, 345, prefix, 155)
		for let i = 148; i < 156; i++ {
			block[i] = byte(0x20)
		}
		let sum = 0
		for let i = 0; i < blockSize; i++ {
			sum += int(block[i])
		}
		putOctal(block, 148, 7, sum)
		block[155] = byte(0x20)
		return block
	}
}
