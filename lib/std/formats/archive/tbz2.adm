partial module std.formats.archive {
	use (
		std.io
		std.bytes
		std.formats.archive.stream::*
		std.formats.archive.tar::*
		std.formats.archive.compressed::*
	)

	// Tbz2 is a tar archive compressed with bzip2 (`.tbz2`, `.tar.bz2`, `.tbz`): `Tar` read through
	// bzip2. Listing decompresses the whole stream once; an entry is read by
	// decompressing forward to it, and from the start again when it lies
	// behind the last one read, so extracting in order stays one pass.
	@codec("TBZ2")
	type Tbz2 {
		mimeType string[] {
			def get() string[] {
				return string["application/x-bzip-compressed-tar", "application/x-bzip2"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".tbz2", ".tar.bz2", ".tbz"]
			}
		}

		// matchSignature reports whether the reader holds bzip2 data whose
		// content starts with a tar header.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(3)
			let n = io.readFull(r, b) onerror recover 0
			return false unless n == 3 && b[0] == 0x42 && b[1] == 0x5A && b[2] == 0x68
			return holdsTar(Kind.Bzip2, new bytes.RewindReader(b, r))
		}

		// open lists the members of the compressed tar archive. The options do
		// not apply.
		//
		// Fails when the data is not bzip2, its content is not a tar archive, or
		// the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			return readTar(new CompressedOrigin(src, Kind.Bzip2), none)
		}

		// create returns a writer that builds a tar archive compressed with
		// bzip2 at `opts.level` on `writer`. The writer's `close` ends both and
		// does not close `writer`.
		//
		// Fails when `opts` asks for a password.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "tbz2: archives cannot be encrypted"
			}
			return new CompressedTarWriter(writer, Kind.Bzip2, opts.level)
		}
	}
}
