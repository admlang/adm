partial module std.formats.archive {
	use (
		std.io
		std.formats.archive.stream::*
		std.formats.archive.gz::*
		std.formats.archive.tar::*
	)

	// Tgz is a tar archive compressed with gzip (`.tgz`, `.tar.gz`): `Tar`
	// read through gunzip. Listing decompresses the whole stream once; an entry
	// is read by decompressing forward to it, and from the start again when it
	// lies behind the last one read, so extracting in order stays one pass.
	//
	// Data from a `bytes.Reader` or `os.File` is read in place; any other
	// reader is read into memory, compressed, first.
	@codec("TGZ")
	type Tgz {
		mimeType string[] {
			def get() string[] {
				return string["application/x-compressed-tar", "application/gzip"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".tgz", ".tar.gz"]
			}
		}

		// matchSignature reports whether the reader holds gzip data whose
		// content starts with a tar header.
		def matchSignature(r io.Reader) bool {
			return gzipHoldsTar(r)
		}

		// open lists the members of the compressed tar archive. The options do
		// not apply.
		//
		// Fails when the data is not gzip, its content is not a tar archive, or
		// the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			return readTar(new GzipOrigin(src), none)
		}

		// create returns a writer that builds a tar archive compressed with gzip
		// at `opts.level` on `writer`. The writer's `close` ends both and does
		// not close `writer`.
		//
		// Fails when `opts` asks for a password.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "tgz: archives cannot be encrypted"
			}
			return new TgzWriter(writer, gzipLevel(opts.level))
		}
	}
}
