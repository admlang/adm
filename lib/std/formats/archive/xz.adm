partial module std.formats.archive {
	use (
		std.io
		std.os
		std.bytes
		std.formats.archive.stream::*
		std.formats.archive.compressed::*
	)

	// Xz is the xz codec (`.xz`) seen as an archive of one entry: the
	// compressed file, named by the file name without `.xz` when the data
	// comes from an `os.File`, else "data". Its size comes from the stream
	// indexes; xz records no time. Concatenated streams read as one file. An
	// xz file holding a tar archive is left to the tar codecs.
	@codec("XZ")
	type Xz {
		mimeType string[] {
			def get() string[] {
				return string["application/x-xz"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".xz"]
			}
		}

		// matchSignature reports whether the reader holds xz data that is not
		// a compressed tar archive.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(6)
			let n = io.readFull(r, b) onerror recover 0
			return false unless n == 6 && b[0] == 0xFD && b[1] == 0x37 && b[2] == 0x7A && b[3] == 0x58 && b[4] == 0x5A && b[5] == 0
			return !holdsTar(Kind.Xz, new bytes.RewindReader(b, r))
		}

		// open reads the stream indexes and returns the one-entry archive. The
		// options do not apply to xz. Fails when the data is not xz, its
		// indexes are invalid, or the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			let head = try src.bytesAt(0, (src.size() < 6) ?? (src.size(), 6))
			fail "xz: not xz data" unless head.len() == 6 && head[0] == 0xFD && head[1] == 0x37 && head[2] == 0x7A && head[3] == 0x58 && head[4] == 0x5A && head[5] == 0
			let entry = Entry{
				name: entryName(src, ".xz"),
				mode: os.FileMode(0o644),
				size: uint64(try xzSize(src)),
				compressedSize: uint64(src.size()),
				method: "lzma2",
			}
			return new SingleArchive(src, Kind.Xz, entry)
		}

		// create returns a writer that compresses the one entry added to it
		// into `writer`. A second entry, a directory or a link is refused. The
		// writer's `close` does not close `writer`. Fails when `opts` asks for
		// a password, which xz does not have.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "xz: xz files cannot be encrypted"
			}
			return new SingleWriter(writer, Kind.Xz, opts.level)
		}
	}
}
