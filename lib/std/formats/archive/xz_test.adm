partial module std.formats.archive {
	// "hello " twenty times, compressed by the system tool.
	internal def helloXz() byte[] {
		return byte[
		0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x04, 0xe6, 0xd6, 0xb4, 0x46, 0x04, 0xc0, 0x14, 0x78,
		0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x72, 0x29, 0xb5, 0x4b,
		0xe0, 0x00, 0x77, 0x00, 0x0c, 0x5d, 0x00, 0x34, 0x19, 0x49, 0xee, 0x8d, 0xe9, 0x5a, 0x55, 0x6d,
		0x2f, 0x00, 0x00, 0x00, 0x06, 0xea, 0xbd, 0x8e, 0x88, 0x67, 0x76, 0x6b, 0x00, 0x01, 0x30, 0x78,
		0xd6, 0x7a, 0x1e, 0xa1, 0x1f, 0xb6, 0xf3, 0x7d, 0x01, 0x00, 0x00, 0x00, 0x00, 0x04, 0x59, 0x5a,
		]
	}

	// A tar archive holding a.txt, compressed by the system tool.
	internal def tarXz() byte[] {
		return byte[
		0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00, 0x00, 0x04, 0xe6, 0xd6, 0xb4, 0x46, 0x04, 0xc0, 0x72, 0x80,
		0x50, 0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x35, 0x84, 0xec, 0x5c,
		0xe0, 0x27, 0xff, 0x00, 0x6a, 0x5d, 0x00, 0x30, 0x8b, 0x8a, 0x87, 0xc4, 0x0e, 0xf2, 0x97, 0xa4,
		0xf8, 0x75, 0x3d, 0xc5, 0xa9, 0xed, 0xd9, 0x97, 0xa9, 0x0f, 0x1f, 0x24, 0x58, 0x3f, 0x43, 0x79,
		0xfd, 0x8c, 0x9c, 0x02, 0x14, 0xa4, 0x68, 0xf0, 0xee, 0x4e, 0x3f, 0x45, 0x1c, 0x31, 0x02, 0x7d,
		0xe0, 0x29, 0x16, 0xc0, 0x7b, 0x3c, 0xbb, 0x8c, 0xa9, 0x0c, 0x1d, 0xe2, 0xc0, 0x8e, 0x4c, 0x10,
		0x3c, 0xb7, 0x31, 0xb1, 0x60, 0x27, 0x7b, 0xcc, 0x7f, 0x63, 0x4a, 0xf6, 0x25, 0x25, 0x4c, 0xa4,
		0x4d, 0x02, 0x8d, 0x33, 0x41, 0x3d, 0x71, 0xd1, 0xab, 0x69, 0x4e, 0xf3, 0xd9, 0x2a, 0x81, 0xfd,
		0x3a, 0xb6, 0xea, 0x8f, 0x7c, 0xff, 0xfd, 0xd5, 0x21, 0x94, 0x65, 0x79, 0x6c, 0x83, 0x0e, 0x00,
		0x00, 0x00, 0x00, 0x00, 0x99, 0xbf, 0xf5, 0xbc, 0x9c, 0xb6, 0xda, 0x89, 0x00, 0x01, 0x8e, 0x01,
		0x80, 0x50, 0x00, 0x00, 0x4e, 0x10, 0x6a, 0x5b, 0xb1, 0xc4, 0x67, 0xfb, 0x02, 0x00, 0x00, 0x00,
		0x00, 0x04, 0x59, 0x5a,
		]
	}

	check "Xz" {
		use (
			std.testing
			std.bytes
			std.io
			std.os
			std.formats.archive.stream::*
		)

		def hello() string {
			return "hello ".repeat(20)
		}

		@test()
		def readsSystemFiles() !none {
			let arc = try new Xz().open(new bytes.Reader(helloXz()))
			let list = arc.entries()
			assert list.len() == 1
			assert list[0].name == "data"
			assert list[0].method == "lzma2"
			assert list[0].size == 120
			assert string(try readAll(try arc.open(list[0]))) == hello()
			// Twice: the data is decompressed again from its start.
			assert string(try readAll(try arc.open(list[0]))) == hello()
			let loaded = try load(helloXz())
			assert string(try readAll(try loaded.open(loaded.entries()[0]))) == hello()
		}

		@test()
		def leavesTarArchivesToTheTarCodecs() !none {
			assert new Xz().matchSignature(new bytes.Reader(helloXz()))
			assert !new Xz().matchSignature(new bytes.Reader(tarXz()))
			assert !new Xz().matchSignature(new bytes.Reader("plain".bytes()))
		}

		@test()
		def namesTheEntryAfterTheFile() !none {
			let dir = os.join(try os.appHome(), "archive-test", "xz")
			try ensureDir(dir)
			let path = os.join(dir, "notes.txt.xz")
			let f = try os.open(path, "w")
			try f.write(helloXz())
			try f.close()
			let arc = try new Xz().open(try os.open(path))
			assert arc.entries()[0].name == "notes.txt"
			let written = try arc.extract(dir, ExtractOptions{overwrite: OverwriteMode.Always})
			assert written == 1
			try arc.close()
			let back = try os.open(os.join(dir, "notes.txt"))
			assert string(try readAll(back)) == hello()
			try back.close()
		}

		@test()
		def roundTrips() !none {
			for let level in [CompressionLevel.Fastest, CompressionLevel.Default, CompressionLevel.Best] {
				let out = new bytes.Buffer()
				let w = try new Xz().create(out, WriteOptions{level: level})
				try w.add(Entry{name: "notes.txt"}, new bytes.Reader(hello().bytes()))
				let refused = false
				w.add(Entry{name: "more.txt"}, new bytes.Reader([])) onerror (err error) {
					refused = true
					recover none
				}
				assert refused
				try w.close()
				let arc = try new Xz().open(new bytes.Reader(out.bytes()))
				assert string(try readAll(try arc.open(arc.entries()[0]))) == hello()
			}
			let blank = new bytes.Buffer()
			let w = try new Xz().create(blank)
			try w.close()
			let arc = try new Xz().open(new bytes.Reader(blank.bytes()))
			assert (try readAll(try arc.open(arc.entries()[0]))).len() == 0
		}
	}
}
