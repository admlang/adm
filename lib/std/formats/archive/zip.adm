partial module std.formats.archive {
	use (
		std.io
		std.formats.archive.stream::*
		std.formats.archive.zip::*
	)

	// How a zip writer encrypts entries when `WriteOptions.password` is set.
	enum ZipEncryption {
		// The original PKWARE stream cipher: readable by every unzip tool, and
		// easily broken.
		Traditional,
		// WinZip AES (AE-2) with a 128, 192 or 256-bit key.
		AES128,
		AES192,
		AES256
	}

	// Zip is the ZIP archive codec (`.zip`, and the formats built on it such as
	// `.jar`). It reads stored and deflated entries, zip64 archives, Unix and
	// NTFS timestamps and modes, UTF-8 and legacy names, and entries encrypted
	// with the traditional cipher or WinZip AES; it writes stored or deflated
	// entries, switching to zip64 when an archive outgrows the classic limits.
	//
	// Entries can be opened in any order. An archive read from a `bytes.Reader`
	// or `os.File` is read in place; any other reader is read into memory first.
	@codec("ZIP")
	type Zip {
		// The archive comment: what `create` writes, and what `open` last read.
		comment    string        = ""
		// How `create` encrypts entries when a password is given.
		encryption ZipEncryption = ZipEncryption.AES256

		mimeType string[] {
			def get() string[] {
				return string["application/zip"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".zip", ".jar"]
			}
		}

		// matchSignature reports whether the reader starts with a local file
		// header, or is an empty archive's end record.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)
			let n = io.readFull(r, b) onerror recover 0
			return false when n != 4 || int(b[0]) != 0x50 || int(b[1]) != 0x4B
			return (int(b[2]) == 3 && int(b[3]) == 4) || (int(b[2]) == 5 && int(b[3]) == 6) || (int(b[2]) == 7 && int(b[3]) == 8)
		}

		// open reads the central directory and returns the archive. Entry names
		// without the UTF-8 flag are decoded with `opts.encoding`: "cp437",
		// "utf-8" or "latin1"; left empty, names that are valid UTF-8 are read
		// as UTF-8 and the rest as code page 437. `opts.password` decrypts
		// encrypted entries, and `opts.strict` also checks every local header
		// against the directory. A CRC-32 mismatch fails the read of that entry.
		//
		// Fails when the data is not a zip archive, its directory is damaged,
		// the encoding is not one of those above, or the reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			let arc = try readZip(src, opts)
			comment = arc.comment
			return arc
		}

		// create returns a writer that builds a zip archive on `writer`.
		// `opts.level` picks stored (`None`) or deflated entries; with
		// `opts.password` every file entry is encrypted as `encryption` says.
		// A file entry added with `method` "store" and no password is stored
		// with its sizes in the local header and no extra field there, as
		// formats that read their first entry in place require (the
		// `mimetype` of ODF and EPUB).
		// The central directory is written by the writer's `close`, which does
		// not close `writer`.
		//
		// Fails when `opts.encryptHeader` is set: zip cannot hide its entry list.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert !(opts.encryptHeader) onerror fail "zip: the entry list cannot be encrypted"
			}
			return new ZipWriter(writer, opts, comment, encryption)
		}
	}
}
