internal partial module std.formats.archive.zip {
	use (
		std.io
		std.crypto.hash
		std.crypto.cipher
	)

	// The traditional PKWARE stream cipher: three keys stirred by every
	// plaintext byte.
	type ZipCrypto {
		k0 uint32
		k1 uint32
		k2 uint32

		def new(password string) {
			k0 = 0x12345678
			k1 = 0x23456789
			k2 = 0x34567890
			for let b in password.bytes() {
				update(b)
			}
		}

		def update(b byte) {
			k0 = hash.crc32Update(k0, b)
			k1 = (k1 + (k0 & 0xFF)) * 134775813 + 1
			k2 = hash.crc32Update(k2, byte(k1 >> 24))
		}

		def keyByte() byte {
			let t = (k2 | 2) & 0xFFFF
			return byte(((t * (t ^ 1)) >> 8) & 0xFF)
		}

		// Decrypts buf in place.
		def decrypt(buf byte[]) {
			for let i = 0; i < buf.len(); i++ {
				let p = buf[i] ^ keyByte()
				update(p)
				buf[i] = p
			}
		}

		// Encrypts buf in place.
		def encrypt(buf byte[]) {
			for let i = 0; i < buf.len(); i++ {
				let p = buf[i]
				buf[i] = p ^ keyByte()
				update(p)
			}
		}
	}

	// Decrypts a traditionally encrypted entry as it is read.
	type ZipCryptoReader {
		src    io.Reader
		cipher ZipCrypto

		def new(src io.Reader, cipher ZipCrypto) {
			self.src = src
			self.cipher = cipher
		}

		// read implements io.Reader. Fails when the source does.
		def read(buf byte[]) !int {
			let n = try src.read(buf)
			cipher.decrypt(buf[0:n]) when n > 0
			return n
		}
	}

	// The keys PBKDF2 derives from a WinZip AES password and salt.
	type AesKeys {
		cipher   cipher.AES
		mac      hash.HMAC
		verifier byte[]

		def new(cipher cipher.AES, mac hash.HMAC, verifier byte[]) {
			self.cipher = cipher
			self.mac = mac
			self.verifier = verifier
		}
	}

	// Salt length for WinZip AES strength 1, 2 or 3; 0 for any other.
	def aesSaltLength(strength int) int {
		return strength >= 1 && strength <= 3 ?? (4 + 4 * strength, 0)
	}

	// Derives the AES key, HMAC-SHA1 key and password verifier of WinZip AES.
	// Fails for an unknown strength.
	def deriveAesKeys(password string, salt byte[], strength int) !AesKeys {
		expects {
			assert strength >= 1 && strength <= 3 onerror fail "zip: unknown AES strength {strength}"
		}
		let keyLen = 8 + 8 * strength
		let material = hash.pbkdf2(hash.Hash.SHA1, password.bytes(), salt, 1000, 2 * keyLen + 2)
		let aes = try cipher.newAES(material[0:keyLen].clone())
		let mac = new hash.HMAC(hash.Hash.SHA1, material[keyLen:2 * keyLen].clone())
		return new AesKeys(aes, mac, material[2 * keyLen:2 * keyLen + 2].clone())
	}

	// AES in the counter mode WinZip uses: a little-endian block counter from 1.
	type AesCtr {
		aes     cipher.AES
		counter int
		stream  byte[]
		block   byte[]
		used    int

		def new(aes cipher.AES) {
			self.aes = aes
			stream = []
			stream.len(16)
			block = []
			block.len(16)
			used = 16
		}

		// XORs the key stream into buf.
		def apply(buf byte[]) {
			for let i = 0; i < buf.len(); i++ {
				if used == 16 {
					counter++
					let c = counter
					for let j = 0; j < 8; j++ {
						block[j] = byte(c & 0xFF)
						c = c >> 8
					}
					aes.encryptBlock(stream, block)
					used = 0
				}
				buf[i] = buf[i] ^ stream[used]
				used++
			}
		}
	}

	// Decrypts a WinZip AES entry as it is read and checks its authentication
	// code at the end.
	type AesReader {
		src      io.Reader
		keys     AesKeys
		ctr      AesCtr
		authCode byte[]
		name     string
		left     int

		def new(src io.Reader, keys AesKeys, authCode byte[], name string, length int) {
			self.src = src
			self.keys = keys
			self.authCode = authCode
			self.name = name
			left = length
			ctr = new AesCtr(keys.cipher)
		}

		// read implements io.Reader. Fails when the authentication code does
		// not match or the source fails.
		def read(buf byte[]) !int {
			return 0 when left <= 0
			let n = try src.read(buf)
			fail "zip: " + name + " is truncated" when n <= 0
			keys.mac.write(buf[0:n])
			ctr.apply(buf[0:n])
			left -= n
			if left <= 0 {
				let tag = keys.mac.hash()
				fail "zip: authentication failed for " + name unless tag[0:10].equals(authCode)
			}
			return n
		}
	}
}
