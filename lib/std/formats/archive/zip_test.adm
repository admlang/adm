				0x86, 0xa5, 0xb9, 0x6a, 0x75, 0x78, 0x0b, 0x00, 0x01, 0x04, 0xe8, 0x03, 0x00, 0x00, 0x04, 0xe8, 0x03, 0x00, 0x00, 0x01, 0x00, 0x10, 0x00, 0xf0,
				0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0x28, 0xcf, 0x2f,
				0xca, 0x49, 0xe1, 0xca, 0x18, 0x01, 0x6c, 0x00, 0x50, 0x4b, 0x01, 0x02, 0x1e, 0x03, 0x2d, 0x00, 0x00, 0x00, 0x08, 0x00, 0x05, 0x51, 0xa6, 0x58,
				0xbc, 0x9e, 0x9d, 0x2e, 0x11, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0x09, 0x00, 0x24, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00,
				0xa4, 0x81, 0x00, 0x00, 0x00, 0x00, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x2e, 0x74, 0x78, 0x74, 0x55, 0x54, 0x05, 0x00, 0x03, 0xda, 0x81, 0x38, 0x66,
				0x75, 0x78, 0x0b, 0x00, 0x01, 0x04, 0xe8, 0x03, 0x00, 0x00, 0x04, 0xe8, 0x03, 0x00, 0x00, 0x01, 0x00, 0x08, 0x00, 0xf0, 0x00, 0x00, 0x00, 0x00,
				0x00, 0x00, 0x00, 0x50, 0x4b, 0x06, 0x06, 0x2c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1e, 0x03, 0x2d, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
				0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x5b, 0x00, 0x00, 0x00, 0x00,
				0x00, 0x00, 0x00, 0x68, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x50, 0x4b, 0x06, 0x07, 0x00, 0x00, 0x00, 0x00, 0xc3, 0x00, 0x00, 0x00, 0x00,
				0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x50, 0x4b, 0x05, 0x06, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x5b, 0x00, 0x00, 0x00, 0xff,
				0xff, 0xff, 0xff, 0x00, 0x00,
		]
	}

	// Info-ZIP writing to a pipe: one entry "-" with a data descriptor.
	internal def streamedZip() byte[] {
		return byte[
				0x50, 0x4b, 0x03, 0x04, 0x2d, 0x00, 0x08, 0x00, 0x08, 0x00, 0xfc, 0x12, 0x3c, 0x5d, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
				0xff, 0xff, 0x01, 0x00, 0x14, 0x00, 0x2d, 0x01, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
				0x00, 0x00, 0x00, 0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0x28, 0xcf, 0x2f, 0xca, 0x49, 0xe1, 0xca, 0x18, 0x01, 0x6c, 0x00, 0x50, 0x4b, 0x07, 0x08,
				0xbc, 0x9e, 0x9d, 0x2e, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xf0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x50, 0x4b, 0x01, 0x02,
				0x1e, 0x03, 0x2d, 0x00, 0x08, 0x00, 0x08, 0x00, 0xfc, 0x12, 0x3c, 0x5d, 0xbc, 0x9e, 0x9d, 0x2e, 0x11, 0x00, 0x00, 0x00, 0xf0, 0x00, 0x00, 0x00,
				0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x80, 0x11, 0x00, 0x00, 0x00, 0x00, 0x2d, 0x50, 0x4b, 0x05, 0x06, 0x00,
				0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x2f, 0x00, 0x00, 0x00, 0x5c, 0x00, 0x00, 0x00, 0x00, 0x00,
		]
	}

	check "Zip" {
		use (
			std.testing
			std.bytes
			std.io
			std.os
			std.time
			std.formats.archive.stream::*
			std.formats.archive.zip::*
		)

		def openZip(data byte[], opts ReadOptions = ReadOptions{}) !Archive {
			return new Zip().open(new bytes.Reader(data), opts)
		}

		def text(arc Archive, name string) !string {
			let e = arc.entry(name)
			fail "missing entry " + name when e is none
			let r = try arc.open(e)
			return string(try readAll(r))
		}

		def readFails(arc Archive, name string) bool {
			let got = text(arc, name) onerror recover "<failed>"
			return got == "<failed>"
		}

		def openFails(data byte[], opts ReadOptions) bool {
			let failed = false
			openZip(data, opts) onerror (err error) {
				failed = true
				recover new MemArchive()
			}
			return failed
		}

		def hello() string {
			let out = ""
			for let i = 0; i < 20; i++ {
				out += "hello world\n"
			}
			return out
		}

		@test()
		def readsInfoZipArchive() !none {
			let codec = new Zip()
			let arc = try codec.open(new bytes.Reader(basicZip()))
			assert codec.comment == "archive note"
			let list = arc.entries()
			assert list.len() == 4
			assert list[0].name == "hello.txt"
			assert list[0].method == "deflate"
			assert list[0].size == 240
			assert list[0].modTime.unixNs() == 1714979290 * 1000000000
			assert list[1].name == "dir/"
			assert isDirMode(list[1].mode)
			assert int(list[2].mode) & 0o777 == 0o755
			assert list[3].linkTarget == "hello.txt"
			assert isLinkMode(list[3].mode)
			assert (try text(arc, "hello.txt")) == hello()
			assert (try text(arc, "dir/note.txt")) == "note"
			try arc.close()
		}

		def expectEntry(data byte[], method string, expected string) !none {
			let arc = try openZip(data)
			assert arc.entries()[0].method == method
			assert (try text(arc, "m.txt")) == expected
		}

		@test()
		def readsBzip2LzmaAndXzEntries() !none {
			let expected = "methods: bzip2, lzma, xz\n".repeat(40)
			try expectEntry(bzip2Zip(), "bzip2", expected)
			try expectEntry(lzmaZip(), "lzma", expected)
			try expectEntry(xzZip(), "xz", expected)
		}

		@test()
		def decryptsTraditionalCipher() !none {
			let arc = try openZip(traditionalZip(), ReadOptions{password: "secret"})
			assert arc.entries()[0].encrypted
			assert (try text(arc, "hello.txt")) == hello()
			let wrong = try openZip(traditionalZip(), ReadOptions{password: "nope"})
			assert readFails(wrong, "hello.txt")
			let none_ = try openZip(traditionalZip())
			assert readFails(none_, "hello.txt")
		}

		@test()
		def decryptsWinZipAes() !none {
			let arc = try openZip(aesZip(), ReadOptions{password: "Secret"})
			assert arc.entries()[0].encrypted
			assert arc.entries()[0].method == "deflate"
			assert (try text(arc, "hello.txt")) == hello()
			let wrong = try openZip(aesZip(), ReadOptions{password: "secret"})
			assert readFails(wrong, "hello.txt")
		}

		@test()
		def readsZip64AndDataDescriptors() !none {
			let arc = try openZip(zip64Zip())
			assert (try text(arc, "hello.txt")) == hello()
			let streamed = try openZip(streamedZip())
			assert streamed.entries()[0].name == "-"
			assert (try text(streamed, "-")) == hello()
		}

		@test()
		def detectsCorruption() !none {
			// Flip a byte of the deflated data: the entry fails, the listing does not.
			let data = basicZip().clone()
			data[80] = data[80] ^ 0x55
			let arc = try openZip(data)
			assert arc.entries().len() == 4
			assert readFails(arc, "hello.txt")
			assert openFails(byte[0x50, 0x4B, 0x03, 0x04, 0, 0], ReadOptions{})
			assert openFails(basicZip(), ReadOptions{encoding: "klingon"})
		}

		@test()
		def decodesLegacyNames() !none {
			let raw = byte[0x63, 0x61, 0x66, 0x82, 0x2E, 0x74, 0x78, 0x74]
			assert decodeName(raw, false, "") == "caf\u00E9.txt"
			assert decodeName(raw, false, "cp437") == "caf\u00E9.txt"
			assert decodeName(byte[0xE9], false, "latin1") == "\u00E9"
			let utf8 = "\u00E9t\u00E9".bytes()
			assert decodeName(utf8, false, "") == "\u00E9t\u00E9"
			assert decodeName(utf8, true, "cp437") == "\u00E9t\u00E9"
		}

		@test()
		def convertsDosTimes() !none {
			let t = dosToTime((44 << 9) | (5 << 5) | 6, (7 << 11) | (8 << 5) | 5)
			assert t.unixNs() == 1714979290 * 1000000000
			let (date, clock) = timeToDos(t)
			assert date == (44 << 9) | (5 << 5) | 6
			assert clock == (7 << 11) | (8 << 5) | 5
		}

		def build(opts WriteOptions, encryption ZipEncryption = ZipEncryption.AES256) !byte[] {
			let out = new bytes.Buffer()
			let codec = new Zip()
			codec.comment = "made here"
			codec.encryption = encryption
			let w = try codec.create(out, opts)
			let stamp = time.fromUnixNs(1714979290 * 1000000000)
			try w.add(Entry{name: "docs", mode: os.FileMode(int(os.FileMode.Dir) | 0o750), modTime: stamp}, new bytes.Reader([]))
			try w.add(Entry{name: "docs/hello.txt", mode: os.FileMode(0o640), modTime: stamp}, new bytes.Reader(hello().bytes()))
			try w.add(Entry{name: "docs/\u00E9t\u00E9.txt", comment: "summer", modTime: stamp}, new bytes.Reader("\u00E9t\u00E9".bytes()))
			try w.add(Entry{name: "empty", modTime: stamp}, new bytes.Reader([]))
			try w.add(Entry{name: "latest", mode: os.FileMode(int(os.FileMode.Symlink) | 0o777), linkTarget: "docs/hello.txt", modTime: stamp}, new bytes.Reader([]))
			try w.close()
			return out.bytes()
		}

		def checkBuilt(data byte[], password string = "") !none {
			let codec = new Zip()
			let arc = try codec.open(new bytes.Reader(data), ReadOptions{password: password})
			assert codec.comment == "made here"
			let list = arc.entries()
			assert list.len() == 5
			assert list[0].name == "docs/"
			assert isDirMode(list[0].mode)
			assert int(list[0].mode) & 0o777 == 0o750
			assert list[1].size == 240
			assert int(list[1].mode) & 0o777 == 0o640
			assert list[1].modTime.unixNs() == 1714979290 * 1000000000
			assert list[2].name == "docs/\u00E9t\u00E9.txt"
			assert list[2].comment == "summer"
			assert list[4].linkTarget == "docs/hello.txt"
			assert isLinkMode(list[4].mode)
			assert (try text(arc, "docs/hello.txt")) == hello()
			assert (try text(arc, "docs/\u00E9t\u00E9.txt")) == "\u00E9t\u00E9"
			assert (try text(arc, "empty")) == ""
			return none
		}

		@test()
		def roundTripsDeflatedAndStored() !none {
			let deflated = try build(WriteOptions{level: CompressionLevel.Default})
			try checkBuilt(deflated)
			let stored = try build(WriteOptions{level: CompressionLevel.None})
			try checkBuilt(stored)
			assert stored.len() > deflated.len()
			let arc = try openZip(deflated)
			assert arc.entries()[1].method == "deflate"
		}

		@test()
		def roundTripsEncryption() !none {
			let aes = try build(WriteOptions{password: "pw", level: CompressionLevel.Best})
			try checkBuilt(aes, "pw")
			let arc = try openZip(aes, ReadOptions{password: "wrong"})
			assert readFails(arc, "docs/hello.txt")
			let legacy = try build(WriteOptions{password: "pw"}, ZipEncryption.Traditional)
			try checkBuilt(legacy, "pw")
			let aes128 = try build(WriteOptions{password: "pw"}, ZipEncryption.AES128)
			try checkBuilt(aes128, "pw")
		}

		@test()
		def extractsToDisk() !none {
			let dir = os.join(try os.appHome(), "archive-test", "zip-extract")
			let arc = try openZip(try build(WriteOptions{level: CompressionLevel.Fast}))
			let written = try arc.extract(dir, ExtractOptions{overwrite: OverwriteMode.Always, preserveMode: true})
			assert written == 3
			assert string(try os.readFile(os.join(dir, "docs/hello.txt"))) == hello()
			assert int((try os.stat(os.join(dir, "docs/hello.txt"))).mode) & 0o777 == 0o640
			assert string(try os.readFile(os.join(dir, "empty"))) == ""
		}

		@test()
		def loadsThroughTheRegistry() !none {
			assert new Zip().matchSignature(new bytes.Reader(basicZip()))
			assert !new Zip().matchSignature(new bytes.Reader(aesZip()[4:]))
			let arc = try load(basicZip())
			assert arc.entries().len() == 4
			assert (try text(arc, "hello.txt")) == hello()
		}
	}
}
