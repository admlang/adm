partial module std.formats.archive {
	use (
		std.io
		std.os
		std.bytes
		std.formats.archive.stream::*
		std.formats.archive.compressed::*
	)

	// Zst is the Zstandard codec (`.zst`) seen as an archive of one entry:
	// the compressed file, named by the file name without `.zst` when the
	// data comes from an `os.File`, else "data". Its size is the one the
	// first frame records, 0 when it records none; Zstandard records no
	// time. Frames in a row read as one file. A Zstandard file holding a
	// tar archive is left to the tar codecs.
	@codec("ZST")
	type Zst {
		mimeType string[] {
			def get() string[] {
				return string["application/zstd"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".zst"]
			}
		}

		// matchSignature reports whether the reader holds Zstandard data
		// that is not a compressed tar archive.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)
			let n = io.readFull(r, b) onerror recover 0
			return false unless n == 4 && b[0] == 0x28 && b[1] == 0xB5 && b[2] == 0x2F && b[3] == 0xFD
			return !holdsTar(Kind.Zstd, new bytes.RewindReader(b, r))
		}

		// open returns the one-entry archive. The options do not apply to
		// Zstandard. Fails when the data is not a Zstandard frame or the
		// reader fails.
		def open(reader io.Reader, opts ReadOptions = ReadOptions{}) !Archive {
			let src = try openSource(reader)
			let head = try src.bytesAt(0, (src.size() < 14) ?? (src.size(), 14))
			fail "zst: not Zstandard data" unless head.len() >= 5 && head[0] == 0x28 && head[1] == 0xB5 && head[2] == 0x2F && head[3] == 0xFD
			let entry = Entry{
				name:           entryName(src, ".zst"),
				mode:           os.FileMode(0o644),
				size:           uint64(zstdSize(head)),
				compressedSize: uint64(src.size()),
				method:         "zstd",
			}
			return new SingleArchive(src, Kind.Zstd, entry)
		}

		// create returns a writer that compresses the one entry added to it
		// into `writer`. A second entry, a directory or a link is refused. The
		// writer's `close` does not close `writer`. Fails when `opts` asks for
		// a password, which Zstandard does not have.
		def create(writer io.Writer, opts WriteOptions = WriteOptions{}) !ArchiveWriter {
			expects {
				assert opts.password.isEmpty() onerror fail "zst: Zstandard files cannot be encrypted"
			}
			return new SingleWriter(writer, Kind.Zstd, opts.level)
		}
	}

	// The content size a Zstandard frame header records, 0 when it records
	// none or the header is cut short.
	internal def zstdSize(head byte[]) int {
		let descriptor = int(head[4])
		let single = descriptor & 0x20 != 0
		let flag = descriptor >> 6
		let width = int[0, 2, 4, 8][flag]
		width = 1 when flag == 0 && single
		let at = 5 + (single ?? (0, 1)) + int[0, 1, 2, 4][descriptor & 3]
		return 0 when width == 0 || at + width > head.len()
		let value = 0
		for let i = 0; i < width.min(7); i++ {
			value |= int(head[at + i]) << (8 * i)
		}
		return width == 2 ?? (value + 256, value)
	}
}
