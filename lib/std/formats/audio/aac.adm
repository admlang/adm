internal partial module std.formats.audio.aac {
	use std.formats.audio::*

	// Reads a program_config_element (Table 4.2) and returns the channels it
	// describes. `slots`, when not empty, receives for each element (entry
	// type * 16 + tag) the output channel of its first channel, in the WAV
	// order the fixed configurations use: front left, right, centre, LFE,
	// back left, right, front centre pair, back centre, side pair, then
	// whatever else the program lists.
	def aacReadProgramConfig(r AacBitReader, slots int[]) int {
		r.skip(4 + 2 + 4)
		let front = r.read(4)
		let side = r.read(4)
		let back = r.read(4)
		let lfe = r.read(2)
		let data = r.read(3)
		let coupling = r.read(4)
		r.skip(4) when r.flag()
		r.skip(4) when r.flag()
		r.skip(3) when r.flag()
		// Per listed element: its type, tag and pair flag; then each channel
		// gets a position key (its WAV position, 100 on for positions WAV has
		// no place for). Front channels run from the centre outwards: an odd
		// count starts with the centre, and with two front pairs the first is
		// the inner one. Single channel elements pair up like a pair's two.
		let types int[]
		let tags int[]
		let pairs bool[]
		for let i = 0; i < front + side + back; i++ {
			pairs.push(r.flag())
			tags.push(r.read(4))
		}
		let keys int[]
		let extra = 100
		let sections = int[0, front, front + side, front + side + back]
		for let sec = 0; sec < 3; sec++ {
			let count = 0
			for let i = sections[sec]; i < sections[sec + 1]; i++ {
				count += pairs[i] ?? (2, 1)
			}
			// The keys of this section's channels, in order.
			let order int[]
			if sec == 0 {
				order.push(2) when (count & 1) != 0
				let pairCount = count / 2
				if pairCount >= 2 {
					order.push(6)
					order.push(7)
				}
				if pairCount >= 1 {
					order.push(0)
					order.push(1)
				}
			} else if sec == 1 {
				if count >= 2 {
					order.push(9)
					order.push(10)
				}
			} else {
				if count >= 2 {
					order.push(4)
					order.push(5)
				}
			}
			for order.len() < count {
				if sec == 2 && (count & 1) != 0 && order.len() == count - 1 && !order.includes(8) {
					order.push(8)
				} else {
					order.push(extra)
					extra++
				}
			}
			let at = 0
			for let i = sections[sec]; i < sections[sec + 1]; i++ {
				types.push(pairs[i] ?? (aacChannelPair, aacSingleChannel))
				keys.push(order[at])
				at += pairs[i] ?? (2, 1)
			}
		}
		for let i = 0; i < lfe; i++ {
			types.push(aacLfeChannel)
			tags.push(r.read(4))
			keys.push(i == 0 ?? (3, extra))
			extra += 2 when i > 0
		}
		r.skip(4 * data + 5 * coupling)
		r.align()
		r.skip(8 * r.read(8))
		let channels = 0
		for let (_, t) in types {
			channels += t == aacChannelPair ?? (2, 1)
		}
		if slots.len() > 0 {
			slots.fill(-1)
			for let (i, t) in types {
				// Channels whose key comes first, pairs counting twice.
				let at = 0
				for let (j, u) in types {
					at += u == aacChannelPair ?? (2, 1) when keys[j] < keys[i]
				}
				slots[t * 16 + tags[i]] = at
			}
		}
		return channels
	}

	// Decodes raw AAC access units.
	type AacDecoder {
		// Frames per second and channels the stream decodes to, from the config.
		sampleRate     int
		// Lines per long window: 1024, or 960 with frameLengthFlag.
		frame          int
		channels       int
		rateIndex      int
		// Why the config cannot be decoded, empty when it can.
		failure        string
		parts          AacChannel[]
		order          int[]
		tables         AacTables
		books          AacBooks
		long           AacTransform
		short          AacTransform
		midSide        bool[]
		config         byte[]
		// Channels and rate of the core AAC layer; with SBR the output has
		// twice the rate (the same for downsampled SBR), and with parametric
		// stereo a mono core decodes to two channels.
		coreRate       int
		coreChannels   int
		// Whether SBR runs on the core output, signalled in the config or
		// found in the first unit's fill elements (`probe`).
		sbr            bool
		// Whether a single channel element may carry parametric stereo.
		ps             bool
		// Whether the output keeps the core rate (downsampled SBR).
		downsampled    bool
		// SBR state per channel element, by type * 16 + tag.
		sbrs           map<int, AacSbr>
		sbrBooks       AacSbrBooks
		sbrQmf         AacSbrQmf
		// Per output channel, the last unit's SBR output.
		sbrOut         float[][]
		// Whether a unit carried SBR data (`probe` reads it).
		sawSbr         bool
		// The channel configuration of the config; 0 takes the channels
		// from a program config element.
		configuration  int
		// Whether the channels wait for a program config element in the
		// stream (configuration 0 in ADTS).
		needPce        bool
		// Whether the config says if PS is present; when it does not, a mono
		// SBR stream may carry it.
		psKnown        bool
		// The SBR output rate the config gives, 0 for twice the core's.
		sbrRate        int
		// The core's audio object type: 1 AAC Main, 2 LC, 4 LTP.
		coreObjectType int
		// The output channel of each element's first channel by type * 16 +
		// tag, from the configuration or its program config; -1 for an
		// element it does not name, which keeps `defaultOrder`.
		slots          int[]
		// Outputs of the channels in decoding order when elements come in
		// the configuration's order.
		defaultOrder   int[]
		// Outputs placed in the current unit, a bit each.
		placed         int
		// Coupling channel elements by tag.
		couplings      AacCoupling[]
		// The noise generator every channel shares.
		random         AacRandom
		// Tag of each channel element of the last unit.
		elementTags    int[]
		// Type and first channel of each channel element of the last unit.
		elementIds     int[]
		elementFirst   int[]

		// A decoder for the stream the AudioSpecificConfig bytes describe (the
		// `esds` box's DecoderSpecificInfo in MP4, built from the ADTS header in
		// `.aac`).
		def new(config byte[]) {
			failure = ""
			sampleRate = 0
			channels = 0
			self.config = config
			random = new AacRandom()
			sbrs = map<int, AacSbr>{}
			let r = new AacBitReader(config)
			let objectType = r.read(5)
			objectType = 32 + r.read(6) when objectType == 31
			rateIndex = r.read(4)
			if rateIndex == 15 {
				sampleRate = r.read(24)
				rateIndex = aacRateIndex(sampleRate)
			} else if rateIndex < 13 {
				sampleRate = aacSampleRates[rateIndex]
			}
			configuration = r.read(4)
			let extensionRate = 0
			if objectType := 5 || 29 {
				// HE-AAC signalled explicitly: the SBR rate, then the core's
				// object type (1.6.2.1).
				sbr = true
				ps = objectType == 29
				psKnown = ps
				extensionRate = aacReadRate(r)
				objectType = r.read(5)
				objectType = 32 + r.read(6) when objectType == 31
			}
			coreObjectType = objectType
			if objectType != 2 && objectType != 1 && objectType != 4 {
				failure = "aac: audio object type {objectType} is not supported; AAC Main (1), LC (2) and LTP (4) are"
			} else if sampleRate == 0 {
				failure = "aac: reserved sampling frequency index {rateIndex}"
			} else {
				frame = r.flag() ?? (960, 1024)
				r.skip(14) when r.flag()
				r.skip(1)
				if configuration == 0 && r.remaining() < 8 {
					// No program config here: ADTS carries it in the first
					// access unit (`probe` reads it).
					needPce = true
				} else if configuration == 0 {
					slots.len(64)
					channels = aacReadProgramConfig(r, slots)
				} else if configuration < 8 {
					channels = aacConfigChannels[configuration]
				}
				let truncated = r.overrun()
				// A backward-compatible extension may follow (1.6.5.2): sync
				// 0x2B7, SBR's object type and whether SBR is present with its
				// rate, then sync 0x548 and whether PS is.
				if !sbr && r.remaining() >= 16 && r.read(11) == 0x2B7 && r.read(5) == 5 {
					sbr = r.flag()
					if sbr {
						extensionRate = aacReadRate(r)
						if r.remaining() >= 12 && r.read(11) == 0x548 {
							ps = r.flag()
							psKnown = true
						}
					}
				}
				if truncated {
					failure = "aac: the AudioSpecificConfig is truncated"
				} else if channels == 0 && !needPce {
					failure = "aac: channel configuration {configuration} is not supported"
				}
			}
			return when failure != ""
			coreRate = sampleRate
			sbrRate = extensionRate
			tables = aacTables()
			books = aacBooks()
			long = new AacTransform(frame)
			short = new AacTransform(frame / 8)
			midSide.len(8 * aacBandSlots)
			setupChannels() unless needPce
		}

		// Sets the channels up once their count is known: the parts, where
		// each goes in the output, and SBR.
		def setupChannels() {
			coreChannels = channels
			if sbr {
				ps = true when !psKnown && channels == 1
				sbrRate = 2 * coreRate when sbrRate <= 0
				downsampled = sbrRate < 2 * coreRate
				enableSbr()
			}
			parts.len(0)
			order.len(coreChannels)
			defaultOrder.len(coreChannels)
			for let c = 0; c < coreChannels; c++ {
				let part = new AacChannel(rateIndex, random, frame)
				part.useObjectType(coreObjectType)
				parts.push(part)
				defaultOrder[c] = configuration == 0 ?? (c, aacChannelOrder[aacChannelOrderStart[configuration] + c])
			}
			if configuration != 0 {
				// The configuration's elements by type and tag, tags counted
				// per type in element order.
				slots.len(64)
				slots.fill(-1)
				let tags int[]
				tags.len(4)
				let c = 0
				let first = aacConfigElementsStart[configuration]
				for let (_, e) in aacConfigElements[first:aacConfigElementsStart[configuration + 1]] {
					slots[e * 16 + tags[e]] = defaultOrder[c]
					tags[e]++
					c += e == aacChannelPair ?? (2, 1)
				}
			}
		}

		// Takes the channels from a program config element read in the
		// stream, for a config that has none.
		def configure(r AacBitReader) {
			slots.len(64)
			channels = aacReadProgramConfig(r, slots)
			needPce = false
			if channels == 0 {
				failure = "aac: the program config element has no channels"
				return
			}
			setupChannels()
		}

		// Turns SBR on: the output rate doubles unless downsampled, and PS
		// makes a mono core stereo.
		def enableSbr() {
			sbr = true
			sampleRate = downsampled ?? (coreRate, 2 * coreRate)
			channels = ps && coreChannels == 1 ?? (2, coreChannels)
			sbrBooks = new AacSbrBooks()
			sbrQmf = new AacSbrQmf()
			let size = frameLength()
			sbrOut.len(0)
			for let c = 0; c < channels; c++ {
				let v float[]
				v.len(size)
				sbrOut.push(v)
			}
		}

		// Frames each access unit decodes to: 1024 (960 with frameLengthFlag),
		// twice that with SBR at twice the rate.
		def frameLength() int {
			return sbr && !downsampled ?? (2 * frame, frame)
		}

		// Looks at the first access unit for SBR data the config does not
		// signal (implicit HE-AAC, 4.6.18.2): with it the output doubles its
		// rate, and a mono stream turns stereo in case it carries parametric
		// stereo, as the reference decoders do. Call before decoding.
		def probe(unit byte[]) {
			if needPce {
				let r = new AacBitReader(unit)
				configure(r) when r.read(3) == aacProgramConfig
			}
			return when failure != "" || sbr || needPce
			let copy = restart()
			copy.decode(unit) onerror (err error) {
				return
			}
			return unless copy.sawSbr
			ps = coreChannels == 1
			enableSbr()
		}

		// The part element `id` with `tag` decodes into: the output its tag
		// gives it, so its state stays with it whatever order the elements
		// come in; `next`, the next part in stream order, for an element the
		// configuration does not name.
		def placeElement(id int, tag int, next int) int {
			return next when slots.len() == 0
			let slot = slots[id * 16 + tag]
			return next when slot < 0
			let mask = (id == aacChannelPair ?? (3, 1)) << slot
			// Two elements claiming one output: keep the stream order.
			return next when (placed & mask) != 0
			placed |= mask
			order[slot] = slot
			order[slot + 1] = slot + 1 when id == aacChannelPair
			return slot
		}

		// A decoder for the same stream at its start, SBR included when
		// `probe` found it.
		def restart() AacDecoder {
			let d = new AacDecoder(config)
			if d.needPce && !needPce {
				d.channels = coreChannels
				d.slots = slots.clone()
				d.needPce = false
				d.setupChannels()
			}
			if sbr && !d.sbr && d.failure == "" {
				d.ps = ps
				d.enableSbr()
			}
			return d
		}

		// The SBR state of channel element `id` with `tag`.
		def sbrFor(id int, tag int) AacSbr {
			let key = id * 16 + tag
			if !sbrs.hasKey(key) {
				sbrs[key] = new AacSbr(downsampled ?? (2 * coreRate, sampleRate), id, sbrBooks, sbrQmf, frame)
			}
			let s = sbrs[key]
			s.ps.enabled = ps && id == aacSingleChannel && coreChannels == 1
			return s
		}

		// Decodes one access unit into 1024 interleaved frames (2048 with SBR).
		//
		// Fails when the unit is damaged or uses a tool this decoder lacks.
		def decode(unit byte[]) !float32[] {
			fail failure when failure != ""
			return decodeBlock(new AacBitReader(unit))
		}

		// Decodes the raw_data_block at the reader (Table 4.3) into 1024
		// interleaved frames, leaving the reader after its END element.
		//
		// Fails when the block is damaged or uses a tool this decoder lacks.
		def decodeBlock(r AacBitReader) !float32[] {
			fail failure when failure != ""
			let next = 0
			let lastId = -1
			elementIds.len(0)
			elementFirst.len(0)
			elementTags.len(0)
			for let (_, cc) in couplings {
				cc.present = false
			}
			for let c = 0; c < coreChannels; c++ {
				order[c] = defaultOrder[c]
			}
			placed = 0
			for {
				let id = r.read(3)
				fail "aac: damaged unit: no END element" when r.overrun()
				break when id == aacEnd
				if id == aacSingleChannel || id == aacLfeChannel {
					let tag = r.read(4)
					fail "aac: damaged unit: more channels than the config" when next >= coreChannels
					let at = placeElement(id, tag, next)
					let ch = parts[at]
					try ch.read(r, false, books, tables)
					ch.predict() when coreObjectType == 1
					elementIds.push(id)
					elementFirst.push(at)
					elementTags.push(tag)
					lastId = id
					next++
				} else if id == aacChannelPair {
					let tag = r.read(4)
					fail "aac: damaged unit: more channels than the config" when next + 1 >= coreChannels
					let at = placeElement(id, tag, next)
					try parsePair(r, parts[at], parts[at + 1])
					elementIds.push(id)
					elementFirst.push(at)
					elementTags.push(tag)
					lastId = id
					next += 2
				} else if id == aacCoupling {
					let tag = r.read(4)
					for couplings.len() <= tag {
						couplings.push(new AacCoupling(rateIndex, coreObjectType, random, frame))
					}
					try couplings[tag].read(r, books, tables)
				} else if id == aacDataStream {
					r.skip(4)
					let aligned = r.flag()
					let count = r.read(8)
					count += r.read(8) when count == 255
					r.align() when aligned
					r.skip(8 * count)
				} else if id == aacProgramConfig {
					if needPce {
						configure(r)
						fail failure when failure != ""
					} else {
						aacReadProgramConfig(r, int[])
					}
				} else if id == aacFill {
					let count = r.read(4)
					count += r.read(8) - 1 when count == 15
					if count > 0 {
						// extension_payload (Table 4.57): SBR data belongs to the
						// channel element before it.
						let ext = r.read(4)
						let sbrData = (ext == aacExtSbr || ext == aacExtSbrCrc) && (lastId == aacSingleChannel || lastId == aacChannelPair)
						sawSbr = true when sbrData
						if sbrData && sbr {
							sbrFor(lastId, elementTags[elementTags.len() - 1]).readExtension(r, ext == aacExtSbrCrc, count, lastId)
						} else {
							r.skip(8 * count - 4)
						}
					}
				}
			}
			fail "aac: damaged unit: {next} of {coreChannels} channels" when next != coreChannels
			// The tools after parsing, in the reference order: coupling
			// elements first (their output feeds the others), then every
			// channel element with the coupling at each point.
			for let (_, cc) in couplings {
				continue unless cc.present
				cc.channel.applyTns()
				cc.channel.synthesize(tables, long, short) when cc.point == aacCoupleAfterImdct
			}
			for let (e, id) in elementIds {
				let a = parts[elementFirst[e]]
				let pair = id == aacChannelPair
				let b = pair ?? (parts[elementFirst[e] + 1], a)
				let tag = elementTags[e]
				couple(aacCoupleBeforeTns, id, tag, a, b)
				if coreObjectType == 4 {
					a.applyLtp(tables, long)
					b.applyLtp(tables, long) when pair
				}
				a.applyTns()
				b.applyTns() when pair
				couple(aacCoupleBetweenTnsAndImdct, id, tag, a, b)
				a.synthesize(tables, long, short)
				b.synthesize(tables, long, short) when pair
				if coreObjectType == 4 {
					a.updateLtp()
					b.updateLtp() when pair
				}
				couple(aacCoupleAfterImdct, id, tag, a, b)
			}
			let pcm float32[]
			if !sbr {
				pcm.len(frame * channels)
				for let c = 0; c < channels; c++ {
					let out = parts[c].output
					let o = order[c]
					for let n = 0; n < frame; n++ {
						pcm[n * channels + o] = float32(out[n].clamp(-1.0, 1.0))
					}
				}
				return pcm
			}
			for let (e, id) in elementIds {
				let c = elementFirst[e]
				let s = sbrFor(id, elementTags[e])
				if id == aacChannelPair {
					s.apply(id, parts[c].output, parts[c + 1].output, sbrOut[c], sbrOut[c + 1], downsampled)
				} else if s.ps.enabled {
					s.apply(id, parts[c].output, parts[c].output, sbrOut[0], sbrOut[1], downsampled)
				} else {
					s.apply(id, parts[c].output, parts[c].output, sbrOut[c], sbrOut[c], downsampled)
				}
			}
			let size = frameLength()
			pcm.len(size * channels)
			for let c = 0; c < channels; c++ {
				let out = sbrOut[c]
				let o = channels == coreChannels ?? (order[c], c)
				for let n = 0; n < size; n++ {
					pcm[n * channels + o] = float32(out[n].clamp(-1.0, 1.0))
				}
			}
			return pcm
		}

		// Reads a channel_pair_element (Table 4.4) and applies M/S, AAC Main
		// prediction and intensity stereo (4.6.8); LTP, TNS and the filter
		// bank follow once the whole unit is read.
		def parsePair(r AacBitReader, a AacChannel, b AacChannel) !none {
			let common = r.flag()
			let mode = 0
			if common {
				try a.readInfo(r)
				b.shareInfo(a)
				if b.predictorPresent && coreObjectType == 4 {
					b.ltpPresent = r.flag()
					b.readLtp(r) when b.ltpPresent
				}
				mode = r.read(2)
				fail "aac: damaged unit: reserved M/S mode" when mode == 3
				if mode == 1 {
					for let g = 0; g < a.groups; g++ {
						for let s = 0; s < a.maxSfb; s++ {
							midSide[g * aacBandSlots + s] = r.flag()
						}
					}
				}
			}
			try a.read(r, common, books, tables)
			try b.read(r, common, books, tables)
			if common {
				// M/S on the bands neither channel codes as noise or intensity.
				let window = 0
				for let g = 0; g < a.groups; g++ {
					for let s = 0; s < a.maxSfb; s++ {
						let i = g * aacBandSlots + s
						let used = mode == 2 || (mode == 1 && midSide[i])
						let bookA = a.bookOf[i]
						let bookB = b.bookOf[i]
						let start = a.bands[s]
						let end = a.bands[s + 1]
						if bookB == aacIntensityBook || bookB == aacIntensityBook2 {
							continue
						} else if used && bookA == aacNoiseBook && bookB == aacNoiseBook {
							b.copyNoise(a, g, s, tables)
						} else if used && bookA < aacNoiseBook && bookB < aacNoiseBook {
							for let w = window; w < window + a.groupLength[g]; w++ {
								for let k = w * 128 + start; k < w * 128 + end; k++ {
									let l = a.spec[k]
									let m = b.spec[k]
									a.spec[k] = l + m
									b.spec[k] = l - m
								}
							}
						}
					}
					window += a.groupLength[g]
				}
			}
			if coreObjectType == 1 {
				a.predict()
				b.predict()
			}
			if common {
				// Intensity bands of the second channel from the first.
				let window = 0
				for let g = 0; g < a.groups; g++ {
					for let s = 0; s < a.maxSfb; s++ {
						let i = g * aacBandSlots + s
						let bookB = b.bookOf[i]
						continue unless bookB == aacIntensityBook || bookB == aacIntensityBook2
						let used = mode == 2 || (mode == 1 && midSide[i])
						let factor = tables.pow2[aacPow2Zero - b.scale[i]]
						factor = -factor when bookB == aacIntensityBook2
						factor = -factor when used
						let start = a.bands[s]
						let end = a.bands[s + 1]
						for let w = window; w < window + a.groupLength[g]; w++ {
							for let k = w * 128 + start; k < w * 128 + end; k++ {
								b.spec[k] = a.spec[k] * factor
							}
						}
					}
					window += a.groupLength[g]
				}
			}
		}

		// Applies every coupling element that couples at `at` to element
		// `id` with `tag` (channels `a` and `b`).
		def couple(at int, id int, tag int, a AacChannel, b AacChannel) {
			for let (_, cc) in couplings {
				cc.couple(at, id, tag, a, b)
			}
		}
	}

	// The elements of each channel configuration (1 to 7) in order:
	// `aacSingleChannel`, `aacChannelPair` or `aacLfeChannel` (Table 1.19).
	const aacConfigElements = int[
		0,
		1,
		0, 1,
		0, 1, 0,
		0, 1, 1,
		0, 1, 1, 3,
		0, 1, 1, 1, 3
	]

	// Where configuration `n`'s entries start in `aacConfigElements`.
	const aacConfigElementsStart = int[0, 0, 1, 2, 4, 7, 10, 14, 19]

	// Encodes interleaved float32 frames into raw AAC-LC access units.
	//
	// Every unit uses long sine windows. The rate loop shifts all scale factors
	// together until the unit fits its share of the bit rate, with unused bits
	// carried to later units; pairs use M/S per band where it saves bits. The
	// units lag the input by 1024 frames, so a decoder's first 1024 frames are
	// silence.
	type AacEncoder {
		sampleRate    int
		channels      int
		// Why the encoder cannot run, empty when it can.
		failure       string
		bitrate       int
		rateIndex     int
		configuration int
		elements      int[]
		parts         AacChannelEncoder[]
		order         int[]
		tables        AacTables
		books         AacBooks
		transform     AacTransform
		writer        AacBitWriter
		held          float32[]
		heldFrames    int
		carry         float
		midSide       bool[]

		// An encoder at the rate, channel count and bit rate in bits per second.
		def new(sampleRate int, channels int, bitrate int) {
			self.sampleRate = sampleRate
			self.channels = channels
			self.bitrate = bitrate
			failure = ""
			configuration = channels == 8 ?? (7, channels)
			if channels < 1 || channels > 8 || channels == 7 {
				failure = "aac: cannot encode {channels} channels; 1 to 6 and 8 can be"
				configuration = 0
			} else if sampleRate < 7350 || sampleRate > 96000 {
				failure = "aac: cannot encode at {sampleRate} Hz"
			} else if bitrate < 8000 * channels {
				failure = "aac: {bitrate} bits per second is too low for {channels} channels"
			}
			rateIndex = aacRateIndex(sampleRate)
			for let i = 0; i < 13; i++ {
				rateIndex = i when aacSampleRates[i] == sampleRate
			}
			heldFrames = 0
			carry = 0.0
			return when failure != ""
			tables = aacTables()
			books = aacBooks()
			transform = new AacTransform(1024)
			writer = new AacBitWriter()
			midSide.len(aacBandSlots)
			let first = aacConfigElementsStart[configuration]
			let last = aacConfigElementsStart[configuration + 1]
			elements = aacConfigElements[first:last].clone()
			// Bandwidth from the bits each channel gets.
			let share = bitrate / channels
			let cutoff = 20000
			if share < 16000 {
				cutoff = 5000
			} else if share < 24000 {
				cutoff = 7000
			} else if share < 32000 {
				cutoff = 9500
			} else if share < 48000 {
				cutoff = 13000
			} else if share < 64000 {
				cutoff = 15500
			} else if share < 96000 {
				cutoff = 18000
			}
			cutoff = sampleRate / 2 when cutoff > sampleRate / 2
			let count = aacLongBandCount[rateIndex]
			let edges = aacLongBandStart[rateIndex]
			let maxSfb = 0
			for maxSfb < count && aacLongBandOffsets[edges + maxSfb] * sampleRate / 2048 < cutoff {
				maxSfb++
			}
			let lfeSfb = 0
			for lfeSfb < count && aacLongBandOffsets[edges + lfeSfb] * sampleRate / 2048 < 250 {
				lfeSfb++
			}
			order.len(channels)
			let c = 0
			for let (_, e) in elements {
				let n = e == aacChannelPair ?? (2, 1)
				for let i = 0; i < n; i++ {
					parts.push(new AacChannelEncoder(rateIndex, e == aacLfeChannel ?? (lfeSfb, maxSfb)))
					order[c] = aacChannelOrder[aacChannelOrderStart[configuration] + c]
					c++
				}
			}
			held.len(1024 * channels)
		}

		// The AudioSpecificConfig describing the units, for the container.
		def config() byte[] {
			let w = new AacBitWriter()
			w.write(2, 5)
			if aacSampleRates[rateIndex] == sampleRate {
				w.write(rateIndex, 4)
			} else {
				w.write(15, 4)
				w.write(sampleRate, 24)
			}
			w.write(configuration, 4)
			w.write(0, 3)
			return w.bytes()
		}

		// Takes frames and returns every access unit that is now complete.
		//
		// Fails when the samples are not whole frames or the encoder was made
		// with a rate, channel count or bit rate it cannot encode.
		def encode(samples float32[]) !byte[][] {
			fail failure when failure != ""
			fail "aac: the samples are not whole frames" when samples.len() % channels != 0
			let units byte[][]
			let frames = samples.len() / channels
			let at = 0
			for at < frames {
				let n = 1024 - heldFrames
				n = frames - at when n > frames - at
				for let i = 0; i < n * channels; i++ {
					held[heldFrames * channels + i] = samples[at * channels + i]
				}
				heldFrames += n
				at += n
				if heldFrames == 1024 {
					units.push(encodeUnit())
					heldFrames = 0
				}
			}
			return units
		}

		// Flushes the frames still held, padded with silence, as the last units.
		//
		// Does not fail today.
		def flush() !byte[][] {
			let units byte[][]
			return units when failure != ""
			if heldFrames > 0 {
				for let i = heldFrames * channels; i < 1024 * channels; i++ {
					held[i] = float32(0)
				}
				units.push(encodeUnit())
			}
			held[:] = float32(0)
			units.push(encodeUnit())
			heldFrames = 0
			return units
		}

		// Encodes the 1024 held frames as one raw_data_block.
		def encodeUnit() byte[] {
			for let c = 0; c < channels; c++ {
				let p = parts[c]
				let o = order[c]
				for let n = 0; n < 1024; n++ {
					p.current[n] = float(held[n * channels + o]) * 32768.0
				}
				p.analyze(tables, transform)
			}
			// Bits for the unit: the rate less the ADTS header, plus what earlier
			// units left unused.
			let budget = float(bitrate) * 1024.0 / float(sampleRate) - 56.0
			let target = budget + carry
			let weights = 0.0
			for let (_, e) in elements {
				weights += e == aacChannelPair ?? (2.0, e == aacLfeChannel ?? (0.25, 1.0))
			}
			writer.reset()
			let c = 0
			let singles = 0
			let pairs = 0
			let lfes = 0
			let fixed = 3
			for let (_, e) in elements {
				fixed += e == aacChannelPair ?? (7 + 1 + 11 + 2 + parts[c].maxSfb, 7)
				c += e == aacChannelPair ?? (2, 1)
			}
			let spend = target - float(fixed)
			c = 0
			for let (_, e) in elements {
				if e == aacChannelPair {
					let a = parts[c]
					let b = parts[c + 1]
					let used = chooseMidSide(a, b)
					let share = int(spend * 1.0 / weights)
					fit(a, share)
					fit(b, share)
					writer.write(aacChannelPair, 3)
					writer.write(pairs, 4)
					pairs++
					writer.write(1, 1)
					a.writeInfo(writer)
					if used {
						writer.write(1, 2)
						for let s = 0; s < a.maxSfb; s++ {
							writer.write(midSide[s] ?? (1, 0), 1)
						}
					} else {
						writer.write(0, 2)
					}
					a.write(writer, books, false)
					b.write(writer, books, false)
					c += 2
					continue
				}
				let p = parts[c]
				let weight = e == aacLfeChannel ?? (0.25, 1.0)
				p.prepare()
				fit(p, int(spend * weight / weights))
				writer.write(e, 3)
				if e == aacLfeChannel {
					writer.write(lfes, 4)
					lfes++
				} else {
					writer.write(singles, 4)
					singles++
				}
				p.write(writer, books, true)
				c++
			}
			writer.write(aacEnd, 3)
			let unit = writer.bytes()
			carry = target - float(unit.len() * 8)
			let limit = 2048.0 * float(channels)
			carry = limit when carry > limit
			carry = -limit when carry < -limit
			return unit
		}

		// Decides M/S per band for a pair, turns those bands of both spectra into
		// mid and side, measures both, and reports whether any band uses it.
		def chooseMidSide(a AacChannelEncoder, b AacChannelEncoder) bool {
			let any = false
			for let s = 0; s < a.maxSfb; s++ {
				let start = a.bands[s]
				let end = a.bands[s + 1]
				let el = 0.0
				let er = 0.0
				let em = 0.0
				let es = 0.0
				for let k = start; k < end; k++ {
					let l = a.spec[k]
					let r = b.spec[k]
					el += l * l
					er += r * r
					em += (l + r) * (l + r) * 0.25
					es += (l - r) * (l - r) * 0.25
				}
				midSide[s] = em * es < 0.8 * el * er
				continue unless midSide[s]
				any = true
				for let k = start; k < end; k++ {
					let l = a.spec[k]
					let r = b.spec[k]
					a.spec[k] = (l + r) * 0.5
					b.spec[k] = (l - r) * 0.5
				}
			}
			a.prepare()
			b.prepare()
			return any
		}

		// The rate loop: quantizes the channel with the finest scale factors
		// whose stream fits in `bits`.
		def fit(p AacChannelEncoder, bits int) {
			let lo = -60
			let hi = 200
			for lo < hi {
				let mid = (lo + hi) >> 1
				if p.quantize(mid, books) <= bits {
					hi = mid
				} else {
					lo = mid + 1
				}
			}
			p.quantize(lo, books)
		}
	}

	// Decodes the access units of one AAC track: raw, or in ADTS frames
	// (as MPEG transport streams carry them) when there is no
	// configuration.
	type AacUnitDecoder {
		config  byte[]
		decoder AacDecoder
		// Whether packets are ADTS frames, and the bytes of a frame the
		// last packet ended inside.
		framed  bool
		pending byte[]
		// Whether the first unit was looked at for SBR the config does not
		// signal.
		probed  bool

		// A decoder for the stream the AudioSpecificConfig describes, or for
		// ADTS frames when it is empty.
		def new(config byte[]) {
			self.config = config
			framed = config.len() == 0
			decoder = new AacDecoder(framed ?? (byte[0x12, 0x10], config))
		}

		// info implements AudioDecoder: zero until the first ADTS frame for
		// framed packets.
		def info() AudioInfo {
			let known = !framed || config.len() > 0
			return AudioInfo{
				sampleRate: uint32(known ?? (decoder.sampleRate, 0)),
				channels:   uint16(known ?? (decoder.channels, 0)),
				bitDepth:   uint16(32),
				format:     SampleFormat.Float32,
				frames:     uint64(0),
				length:     0s,
				codec:      "aac",
				bitrate:    uint32(0),
				seekable:   false,
			}
		}

		// decode implements AudioDecoder: 1024 frames per access unit, 2048
		// with SBR.
		//
		// Fails when a unit is damaged or an ADTS frame names a format the
		// decoder lacks.
		def decode(packet byte[]) !float32[] {
			if !framed {
				if !probed {
					decoder.probe(packet)
					probed = true
				}
				return decoder.decode(packet)
			}
			let data = pending.len() == 0 ?? (packet, pending.concat(packet))
			let out float32[]
			let at = 0
			for at + 7 <= data.len() {
				let found = adtsHeader(data, at)
				if found is none {
					at++
					continue
				}
				let h AdtsHeader = found
				break when at + h.length > data.len()
				if config.len() == 0 {
					config = adtsConfig(h)
					decoder = new AacDecoder(config)
					decoder.probe(data[at + h.headerLength:at + h.length])
				}
				fail decoder.failure when decoder.failure != ""
				let r = new AacBitReader(data[at + h.headerLength:at + h.length])
				for let b = 0; b < h.blocks; b++ {
					out = out.concat(try decoder.decodeBlock(r))
					r.align()
					r.skip(16) when h.protected && h.blocks > 1
				}
				at += h.length
			}
			pending = at < data.len() ?? (data[at:].clone(), byte[])
			return out
		}

		// flush implements AudioDecoder: AAC holds nothing back.
		//
		// Does not fail.
		def flush() !float32[] {
			return float32[]
		}

		// reset implements AudioDecoder.
		def reset() {
			pending = byte[]
			decoder = config.len() == 0 ?? (new AacDecoder(byte[0x12, 0x10]), decoder.restart())
		}
	}

	// Reads a sampling frequency index, or an explicit rate after index 15,
	// and returns the rate; 0 for a reserved index.
	def aacReadRate(r AacBitReader) int {
		let index = r.read(4)
		return r.read(24) when index == 15
		return index < 13 ?? (aacSampleRates[index], 0)
	}
}
