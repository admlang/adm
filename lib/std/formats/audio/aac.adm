internal partial module std.formats.audio.aac {
	use std.formats.audio::*

	// Reads a program_config_element (Table 4.2) and returns the channels it
	// describes.
	def aacReadProgramConfig(r AacBitReader) int {
		r.skip(4 + 2 + 4)
		let front = r.read(4)
		let side = r.read(4)
		let back = r.read(4)
		let lfe = r.read(2)
		let data = r.read(3)
		let coupling = r.read(4)
		r.skip(4) when r.flag()
		r.skip(4) when r.flag()
		r.skip(3) when r.flag()
		let channels = lfe
		for let i = 0; i < front + side + back; i++ {
			channels += r.flag() ?? (2, 1)
			r.skip(4)
		}
		r.skip(4 * lfe + 4 * data + 5 * coupling)
		r.align()
		r.skip(8 * r.read(8))
		return channels
	}

	// Decodes raw AAC access units.
	type AacDecoder {
		// Frames per second and channels the stream decodes to, from the config.
		sampleRate int
		channels   int
		rateIndex  int
		// Why the config cannot be decoded, empty when it can.
		failure    string
		parts      AacChannel[]
		order      int[]
		tables     AacTables
		books      AacBooks
		long       AacTransform
		short      AacTransform
		midSide    bool[]

		// A decoder for the stream the AudioSpecificConfig bytes describe (the
		// `esds` box's DecoderSpecificInfo in MP4, built from the ADTS header in
		// `.aac`).
		def new(config byte[]) {
			failure = ""
			sampleRate = 0
			channels = 0
			let r = new AacBitReader(config)
			let objectType = r.read(5)
			objectType = 32 + r.read(6) when objectType == 31
			rateIndex = r.read(4)
			if rateIndex == 15 {
				sampleRate = r.read(24)
				rateIndex = aacRateIndex(sampleRate)
			} else if rateIndex < 13 {
				sampleRate = aacSampleRates[rateIndex]
			}
			let configuration = r.read(4)
			if objectType := 5 || 29 {
				failure = "aac: HE-AAC (SBR and parametric stereo) is not supported"
			} else if objectType != 2 {
				failure = "aac: audio object type {objectType} is not supported; only AAC-LC (2) is"
			} else if sampleRate == 0 {
				failure = "aac: reserved sampling frequency index {rateIndex}"
			} else if r.flag() {
				failure = "aac: 960-frame units are not supported"
			} else {
				r.skip(14) when r.flag()
				r.skip(1)
				if configuration == 0 {
					channels = aacReadProgramConfig(r)
				} else if configuration < 8 {
					channels = aacConfigChannels[configuration]
				}
				let truncated = r.overrun()
				// A backward-compatible extension may follow (1.6.5.2): sync
				// 0x2B7, then SBR's object type and whether SBR is present.
				if r.remaining() >= 17 && r.read(11) == 0x2B7 && r.read(5) == 5 && r.flag() {
					failure = "aac: HE-AAC (SBR and parametric stereo) is not supported"
				} else if truncated {
					failure = "aac: the AudioSpecificConfig is truncated"
				} else if channels == 0 {
					failure = "aac: channel configuration {configuration} is not supported"
				}
			}
			return when failure != ""
			tables = aacTables()
			books = aacBooks()
			long = new AacTransform(1024)
			short = new AacTransform(128)
			midSide.len(8 * aacBandSlots)
			order.len(channels)
			for let c = 0; c < channels; c++ {
				parts.push(new AacChannel(rateIndex, 0x1F2E3D4C + c * 7919))
				order[c] = configuration == 0 ?? (c, aacChannelOrder[aacChannelOrderStart[configuration] + c])
			}
		}

		// Decodes one access unit into 1024 interleaved frames.
		//
		// Fails when the unit is damaged or uses a tool this decoder lacks.
		def decode(unit byte[]) !float32[] {
			fail failure when failure != ""
			return decodeBlock(new AacBitReader(unit))
		}

		// Decodes the raw_data_block at the reader (Table 4.3) into 1024
		// interleaved frames, leaving the reader after its END element.
		//
		// Fails when the block is damaged or uses a tool this decoder lacks.
		def decodeBlock(r AacBitReader) !float32[] {
			fail failure when failure != ""
			let next = 0
			for {
				let id = r.read(3)
				fail "aac: damaged unit: no END element" when r.overrun()
				break when id == aacEnd
				if id == aacSingleChannel || id == aacLfeChannel {
					r.skip(4)
					fail "aac: damaged unit: more channels than the config" when next >= channels
					let ch = parts[next]
					try ch.read(r, false, books, tables)
					ch.applyTns()
					ch.synthesize(tables, long, short)
					next++
				} else if id == aacChannelPair {
					r.skip(4)
					fail "aac: damaged unit: more channels than the config" when next + 1 >= channels
					try readPair(r, parts[next], parts[next + 1])
					next += 2
				} else if id == aacCoupling {
					fail "aac: coupling channel elements are not supported"
				} else if id == aacDataStream {
					r.skip(4)
					let aligned = r.flag()
					let count = r.read(8)
					count += r.read(8) when count == 255
					r.align() when aligned
					r.skip(8 * count)
				} else if id == aacProgramConfig {
					aacReadProgramConfig(r)
				} else if id == aacFill {
					let count = r.read(4)
					count += r.read(8) - 1 when count == 15
					r.skip(8 * count)
				}
			}
			fail "aac: damaged unit: {next} of {channels} channels" when next != channels
			let pcm float32[]
			pcm.len(1024 * channels)
			for let c = 0; c < channels; c++ {
				let out = parts[c].output
				let o = order[c]
				for let n = 0; n < 1024; n++ {
					let v = out[n]
					v = 1.0 when v > 1.0
					v = -1.0 when v < -1.0
					pcm[n * channels + o] = float32(v)
				}
			}
			return pcm
		}

		// Reads a channel_pair_element (Table 4.4) and applies M/S and
		// intensity stereo (4.6.8) before TNS and the filter bank.
		def readPair(r AacBitReader, a AacChannel, b AacChannel) !none {
			let common = r.flag()
			let mode = 0
			if common {
				try a.readInfo(r)
				b.shareInfo(a)
				mode = r.read(2)
				fail "aac: damaged unit: reserved M/S mode" when mode == 3
				if mode == 1 {
					for let g = 0; g < a.groups; g++ {
						for let s = 0; s < a.maxSfb; s++ {
							midSide[g * aacBandSlots + s] = r.flag()
						}
					}
				}
			}
			try a.read(r, common, books, tables)
			try b.read(r, common, books, tables)
			if common {
				let window = 0
				for let g = 0; g < a.groups; g++ {
					for let s = 0; s < a.maxSfb; s++ {
						let i = g * aacBandSlots + s
						let used = mode == 2 || (mode == 1 && midSide[i])
						let bookA = a.bookOf[i]
						let bookB = b.bookOf[i]
						let start = a.bands[s]
						let end = a.bands[s + 1]
						if bookB == aacIntensityBook || bookB == aacIntensityBook2 {
							let factor = tables.pow2[aacPow2Zero - b.scale[i]]
							factor = -factor when bookB == aacIntensityBook2
							factor = -factor when used
							for let w = window; w < window + a.groupLength[g]; w++ {
								for let k = w * 128 + start; k < w * 128 + end; k++ {
									b.spec[k] = a.spec[k] * factor
								}
							}
						} else if used && bookA == aacNoiseBook && bookB == aacNoiseBook {
							b.copyNoise(a, g, s, tables)
						} else if used && bookA < aacNoiseBook && bookB < aacNoiseBook {
							for let w = window; w < window + a.groupLength[g]; w++ {
								for let k = w * 128 + start; k < w * 128 + end; k++ {
									let l = a.spec[k]
									let m = b.spec[k]
									a.spec[k] = l + m
									b.spec[k] = l - m
								}
							}
						}
					}
					window += a.groupLength[g]
				}
			}
			a.applyTns()
			b.applyTns()
			a.synthesize(tables, long, short)
			b.synthesize(tables, long, short)
		}
	}

	// The elements of each channel configuration (1 to 7) in order:
	// `aacSingleChannel`, `aacChannelPair` or `aacLfeChannel` (Table 1.19).
	const aacConfigElements = int[
		0,
		1,
		0, 1,
		0, 1, 0,
		0, 1, 1,
		0, 1, 1, 3,
		0, 1, 1, 1, 3
	]

	// Where configuration `n`'s entries start in `aacConfigElements`.
	const aacConfigElementsStart = int[0, 0, 1, 2, 4, 7, 10, 14, 19]

	// Encodes interleaved float32 frames into raw AAC-LC access units.
	//
	// Every unit uses long sine windows. The rate loop shifts all scale factors
	// together until the unit fits its share of the bit rate, with unused bits
	// carried to later units; pairs use M/S per band where it saves bits. The
	// units lag the input by 1024 frames, so a decoder's first 1024 frames are
	// silence.
	type AacEncoder {
		sampleRate    int
		channels      int
		// Why the encoder cannot run, empty when it can.
		failure       string
		bitrate       int
		rateIndex     int
		configuration int
		elements      int[]
		parts         AacChannelEncoder[]
		order         int[]
		tables        AacTables
		books         AacBooks
		transform     AacTransform
		writer        AacBitWriter
		held          float32[]
		heldFrames    int
		carry         float
		midSide       bool[]

		// An encoder at the rate, channel count and bit rate in bits per second.
		def new(sampleRate int, channels int, bitrate int) {
			self.sampleRate = sampleRate
			self.channels = channels
			self.bitrate = bitrate
			failure = ""
			configuration = channels == 8 ?? (7, channels)
			if channels < 1 || channels > 8 || channels == 7 {
				failure = "aac: cannot encode {channels} channels; 1 to 6 and 8 can be"
				configuration = 0
			} else if sampleRate < 7350 || sampleRate > 96000 {
				failure = "aac: cannot encode at {sampleRate} Hz"
			} else if bitrate < 8000 * channels {
				failure = "aac: {bitrate} bits per second is too low for {channels} channels"
			}
			rateIndex = aacRateIndex(sampleRate)
			for let i = 0; i < 13; i++ {
				rateIndex = i when aacSampleRates[i] == sampleRate
			}
			heldFrames = 0
			carry = 0.0
			return when failure != ""
			tables = aacTables()
			books = aacBooks()
			transform = new AacTransform(1024)
			writer = new AacBitWriter()
			midSide.len(aacBandSlots)
			let first = aacConfigElementsStart[configuration]
			let last = aacConfigElementsStart[configuration + 1]
			elements = aacConfigElements[first:last].clone()
			// Bandwidth from the bits each channel gets.
			let share = bitrate / channels
			let cutoff = 20000
			if share < 16000 {
				cutoff = 5000
			} else if share < 24000 {
				cutoff = 7000
			} else if share < 32000 {
				cutoff = 9500
			} else if share < 48000 {
				cutoff = 13000
			} else if share < 64000 {
				cutoff = 15500
			} else if share < 96000 {
				cutoff = 18000
			}
			cutoff = sampleRate / 2 when cutoff > sampleRate / 2
			let count = aacLongBandCount[rateIndex]
			let edges = aacLongBandStart[rateIndex]
			let maxSfb = 0
			for maxSfb < count && aacLongBandOffsets[edges + maxSfb] * sampleRate / 2048 < cutoff {
				maxSfb++
			}
			let lfeSfb = 0
			for lfeSfb < count && aacLongBandOffsets[edges + lfeSfb] * sampleRate / 2048 < 250 {
				lfeSfb++
			}
			order.len(channels)
			let c = 0
			for let (_, e) in elements {
				let n = e == aacChannelPair ?? (2, 1)
				for let i = 0; i < n; i++ {
					parts.push(new AacChannelEncoder(rateIndex, e == aacLfeChannel ?? (lfeSfb, maxSfb)))
					order[c] = aacChannelOrder[aacChannelOrderStart[configuration] + c]
					c++
				}
			}
			held.len(1024 * channels)
		}

		// The AudioSpecificConfig describing the units, for the container.
		def config() byte[] {
			let w = new AacBitWriter()
			w.write(2, 5)
			if aacSampleRates[rateIndex] == sampleRate {
				w.write(rateIndex, 4)
			} else {
				w.write(15, 4)
				w.write(sampleRate, 24)
			}
			w.write(configuration, 4)
			w.write(0, 3)
			return w.bytes()
		}

		// Takes frames and returns every access unit that is now complete.
		//
		// Fails when the samples are not whole frames or the encoder was made
		// with a rate, channel count or bit rate it cannot encode.
		def encode(samples float32[]) !byte[][] {
			fail failure when failure != ""
			fail "aac: the samples are not whole frames" when samples.len() % channels != 0
			let units byte[][]
			let frames = samples.len() / channels
			let at = 0
			for at < frames {
				let n = 1024 - heldFrames
				n = frames - at when n > frames - at
				for let i = 0; i < n * channels; i++ {
					held[heldFrames * channels + i] = samples[at * channels + i]
				}
				heldFrames += n
				at += n
				if heldFrames == 1024 {
					units.push(encodeUnit())
					heldFrames = 0
				}
			}
			return units
		}

		// Flushes the frames still held, padded with silence, as the last units.
		//
		// Does not fail today.
		def flush() !byte[][] {
			let units byte[][]
			return units when failure != ""
			if heldFrames > 0 {
				for let i = heldFrames * channels; i < 1024 * channels; i++ {
					held[i] = float32(0)
				}
				units.push(encodeUnit())
			}
			held[:] = float32(0)
			units.push(encodeUnit())
			heldFrames = 0
			return units
		}

		// Encodes the 1024 held frames as one raw_data_block.
		def encodeUnit() byte[] {
			for let c = 0; c < channels; c++ {
				let p = parts[c]
				let o = order[c]
				for let n = 0; n < 1024; n++ {
					p.current[n] = float(held[n * channels + o]) * 32768.0
				}
				p.analyze(tables, transform)
			}
			// Bits for the unit: the rate less the ADTS header, plus what earlier
			// units left unused.
			let budget = float(bitrate) * 1024.0 / float(sampleRate) - 56.0
			let target = budget + carry
			let weights = 0.0
			for let (_, e) in elements {
				weights += e == aacChannelPair ?? (2.0, e == aacLfeChannel ?? (0.25, 1.0))
			}
			writer.reset()
			let c = 0
			let singles = 0
			let pairs = 0
			let lfes = 0
			let fixed = 3
			for let (_, e) in elements {
				fixed += e == aacChannelPair ?? (7 + 1 + 11 + 2 + parts[c].maxSfb, 7)
				c += e == aacChannelPair ?? (2, 1)
			}
			let spend = target - float(fixed)
			c = 0
			for let (_, e) in elements {
				if e == aacChannelPair {
					let a = parts[c]
					let b = parts[c + 1]
					let used = chooseMidSide(a, b)
					let share = int(spend * 1.0 / weights)
					fit(a, share)
					fit(b, share)
					writer.write(aacChannelPair, 3)
					writer.write(pairs, 4)
					pairs++
					writer.write(1, 1)
					a.writeInfo(writer)
					if used {
						writer.write(1, 2)
						for let s = 0; s < a.maxSfb; s++ {
							writer.write(midSide[s] ?? (1, 0), 1)
						}
					} else {
						writer.write(0, 2)
					}
					a.write(writer, books, false)
					b.write(writer, books, false)
					c += 2
					continue
				}
				let p = parts[c]
				let weight = e == aacLfeChannel ?? (0.25, 1.0)
				p.prepare()
				fit(p, int(spend * weight / weights))
				writer.write(e, 3)
				if e == aacLfeChannel {
					writer.write(lfes, 4)
					lfes++
				} else {
					writer.write(singles, 4)
					singles++
				}
				p.write(writer, books, true)
				c++
			}
			writer.write(aacEnd, 3)
			let unit = writer.bytes()
			carry = target - float(unit.len() * 8)
			let limit = 2048.0 * float(channels)
			carry = limit when carry > limit
			carry = -limit when carry < -limit
			return unit
		}

		// Decides M/S per band for a pair, turns those bands of both spectra into
		// mid and side, measures both, and reports whether any band uses it.
		def chooseMidSide(a AacChannelEncoder, b AacChannelEncoder) bool {
			let any = false
			for let s = 0; s < a.maxSfb; s++ {
				let start = a.bands[s]
				let end = a.bands[s + 1]
				let el = 0.0
				let er = 0.0
				let em = 0.0
				let es = 0.0
				for let k = start; k < end; k++ {
					let l = a.spec[k]
					let r = b.spec[k]
					el += l * l
					er += r * r
					em += (l + r) * (l + r) * 0.25
					es += (l - r) * (l - r) * 0.25
				}
				midSide[s] = em * es < 0.8 * el * er
				continue unless midSide[s]
				any = true
				for let k = start; k < end; k++ {
					let l = a.spec[k]
					let r = b.spec[k]
					a.spec[k] = (l + r) * 0.5
					b.spec[k] = (l - r) * 0.5
				}
			}
			a.prepare()
			b.prepare()
			return any
		}

		// The rate loop: quantizes the channel with the finest scale factors
		// whose stream fits in `bits`.
		def fit(p AacChannelEncoder, bits int) {
			let lo = -60
			let hi = 200
			for lo < hi {
				let mid = (lo + hi) >> 1
				if p.quantize(mid, books) <= bits {
					hi = mid
				} else {
					lo = mid + 1
				}
			}
			p.quantize(lo, books)
		}
	}
}
