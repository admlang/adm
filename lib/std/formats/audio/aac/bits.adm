internal partial module std.formats.audio.aac {
	use std.formats.audio::*

	// Reads an AAC bitstream most significant bit first. Bits past the end
	// read as 0; `overrun` reports whether any were asked for.
	type AacBitReader {
		data  byte[]
		pos   int
		limit int

		// A reader over all of `data`.
		def new(data byte[]) {
			self.data = data
			pos = 0
			limit = data.len() * 8
		}

		// The next `n` bits (at most 32) without consuming them.
		def peek(n int) int {
			let at = pos >> 3
			let v = 0
			if at + 4 < data.len() {
				v = int(data[at]) << 32 | int(data[at + 1]) << 24 | int(data[at + 2]) << 16 | int(data[at + 3]) << 8 | int(data[at + 4])
			} else {
				for let i = 0; i < 5; i++ {
					v = v << 8
					v = v | int(data[at + i]) when at + i < data.len()
				}
			}
			return (v >> (40 - (pos & 7) - n)) & ((1 << n) - 1)
		}

		// Consumes `n` bits.
		def skip(n int) {
			pos += n
		}

		// Reads `n` bits (at most 32) as an unsigned value.
		def read(n int) int {
			return 0 when n == 0
			let v = peek(n)
			pos += n
			return v
		}

		// Reads one bit.
		def bit() int {
			let at = pos >> 3
			let v = 0
			v = (int(data[at]) >> (7 - (pos & 7))) & 1 when at < data.len()
			pos++
			return v
		}

		// Reads one bit as a flag.
		def flag() bool {
			return bit() == 1
		}

		// Skips to the next byte boundary.
		def align() {
			pos = (pos + 7) & ^7
		}

		// The bit position from the start.
		def position() int {
			return pos
		}

		// Bits left before the end.
		def remaining() int {
			return limit - pos
		}

		// Whether more bits were read than the data holds.
		def overrun() bool {
			return pos > limit
		}
	}

	// Writes an AAC bitstream most significant bit first.
	type AacBitWriter {
		out   byte[]
		size  int
		acc   int
		count int

		// An empty writer.
		def new() {
			out.len(256)
			size = 0
			acc = 0
			count = 0
		}

		// Appends the low `n` bits (at most 32) of `value`.
		def write(value int, n int) {
			return when n == 0
			acc = (acc << n) | (value & ((1 << n) - 1))
			count += n
			for count >= 8 {
				count -= 8
				out.len(size * 2) when size == out.len()
				out[size] = byte((acc >> count) & 0xFF)
				size++
			}
			acc = acc & ((1 << count) - 1)
		}

		// Pads with zero bits to the next byte boundary.
		def align() {
			write(0, 8 - count) when count != 0
		}

		// Bits written so far.
		def position() int {
			return size * 8 + count
		}

		// The bytes written, the last one padded with zero bits.
		def bytes() byte[] {
			align()
			return out[0:size].clone()
		}

		// Forgets everything written.
		def reset() {
			size = 0
			acc = 0
			count = 0
		}
	}
}
