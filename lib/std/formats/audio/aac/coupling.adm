internal partial module std.formats.audio.aac {
	// Coupling points of a coupling channel element (4.6.8.3): its spectrum
	// added to the targets before their TNS, between TNS and the filter
	// bank, or its output added to theirs after it.
	const aacCoupleBeforeTns = 0
	const aacCoupleBetweenTnsAndImdct = 1
	const aacCoupleAfterImdct = 3

	// Gain steps of the four gain element scales: 2^(1/8), 2^(1/4), 2^(1/2), 2.
	const aacCouplingScale = float[1.09050773266525765921, 1.18920711500272106672, 1.4142135623730951, 2.0]

	// A coupling channel element (4.4.2.2, Table 4.8): a channel whose
	// spectrum or output is mixed into other elements' channels, with a gain
	// per target list and band.
	type AacCoupling {
		// Carries the channel's spectrum, and its overlap across units when
		// it couples after the filter bank.
		channel    AacChannel
		point      int
		// Coupled elements: type (`aacSingleChannel` or `aacChannelPair`),
		// tag, and for a pair which channels (1 right, 2 left, 3 each with
		// its own gains, 0 both sharing them).
		targets    int
		targetType int[]
		targetTag  int[]
		chSelect   int[]
		// Gain lists: per list and group/band (`list * 8 * aacBandSlots +
		// group * aacBandSlots + band`); after the filter bank, one gain per
		// list at band 0.
		gains      float[]
		// Whether this unit carried the element.
		present    bool

		def new(rateIndex int, objectType int, random AacRandom, frame int) {
			channel = new AacChannel(rateIndex, random, frame)
			channel.useObjectType(objectType)
			targetType.len(8)
			targetTag.len(8)
			chSelect.len(8)
			gains.len(16 * 8 * aacBandSlots)
		}

		// Reads coupling_channel_element after its tag.
		//
		// Fails when its channel stream is damaged.
		def read(r AacBitReader, books AacBooks, tables AacTables) !none {
			point = 2 * r.read(1)
			targets = r.read(3) + 1
			let lists = 0
			for let c = 0; c < targets; c++ {
				lists++
				let pair = r.flag()
				targetType[c] = pair ?? (aacChannelPair, aacSingleChannel)
				targetTag[c] = r.read(4)
				chSelect[c] = pair ?? (r.read(2), 2)
				lists++ when pair && chSelect[c] == 3
			}
			point += (r.flag() || (point >> 1) != 0) ?? (1, 0)
			let sign = r.flag()
			let scale = aacCouplingScale[r.read(2)]
			try channel.read(r, false, books, tables)
			channel.predict() when channel.objectType == 1
			let ch = channel
			for let c = 0; c < lists; c++ {
				let gain = 0
				let cached = 1.0
				let common = true
				if c > 0 {
					common = point == aacCoupleAfterImdct || r.flag()
					gain = common ?? (books.scalefactor.decode(r) - 60, 0)
					cached = scale ** float(0 - gain)
				}
				let base = c * 8 * aacBandSlots
				if point == aacCoupleAfterImdct {
					gains[base] = cached
					continue
				}
				for let g = 0; g < ch.groups; g++ {
					for let s = 0; s < ch.maxSfb; s++ {
						let i = g * aacBandSlots + s
						continue when ch.bookOf[i] == 0
						if !common {
							let t = books.scalefactor.decode(r) - 60
							if t != 0 {
								gain += t
								t = gain
								let mul = 1.0
								if sign {
									mul = (t & 1) != 0 ?? (-1.0, 1.0)
									t >>= 1
								}
								cached = scale ** float(0 - t) * mul
							}
						}
						gains[base + i] = cached
					}
				}
			}
			present = true
		}

		// Adds this element's spectrum times gain list `list` to `target`'s
		// spectrum (dependent coupling).
		def addSpectrum(target AacChannel, list int) {
			let ch = channel
			let base = list * 8 * aacBandSlots
			let window = 0
			for let g = 0; g < ch.groups; g++ {
				for let s = 0; s < ch.maxSfb; s++ {
					let i = g * aacBandSlots + s
					continue when ch.bookOf[i] == 0
					let gain = gains[base + i]
					for let w = window; w < window + ch.groupLength[g]; w++ {
						for let k = w * 128 + ch.bands[s]; k < w * 128 + ch.bands[s + 1]; k++ {
							target.spec[k] += gain * ch.spec[k]
						}
					}
				}
				window += ch.groupLength[g]
			}
		}

		// Adds this element's output times gain list `list` to `target`'s
		// output (independent coupling).
		def addOutput(target AacChannel, list int) {
			let gain = gains[list * 8 * aacBandSlots]
			for let n = 0; n < channel.frame; n++ {
				target.output[n] += gain * channel.output[n]
			}
		}

		// Applies the coupling at `at` to the channels of element `id` with
		// `tag`: `a` and, for a pair, `b`.
		def couple(at int, id int, tag int, a AacChannel, b AacChannel) {
			return unless present && point == at
			let list = 0
			for let c = 0; c < targets; c++ {
				if targetType[c] == id && targetTag[c] == tag {
					if chSelect[c] != 1 {
						apply(a, list)
						list++ when chSelect[c] != 0
					}
					if chSelect[c] != 2 {
						apply(b, list)
						list++
					}
				} else {
					list += chSelect[c] == 3 ?? (2, 1)
				}
			}
		}

		def apply(target AacChannel, list int) {
			if point == aacCoupleAfterImdct {
				addOutput(target, list)
			} else {
				addSpectrum(target, list)
			}
		}
	}
}
