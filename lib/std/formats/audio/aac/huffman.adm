internal partial module std.formats.audio.aac {
	// Bits the first lookup of `AacHuffman` resolves at once.
	const aacHuffmanRootBits = 9

	// A table-driven decoder of one AAC Huffman codebook. Codes up to
	// `aacHuffmanRootBits` long resolve in one lookup, longer ones in two.
	type AacHuffman {
		// Root entries, then the second-level tables. An entry of zero or more
		// is `symbol << 5 | length`; a negative one points at a second-level
		// table as `-(offset << 5 | bits) - 1`.
		table int[]

		// The decoder of the `count` codewords starting at `start` in `codes`
		// and `lengths`; symbol `i` is the codeword at `start + i`.
		def new(codes int[], lengths int[], start int, count int) {
			let root = aacHuffmanRootBits
			table.len(1 << root)
			table[:] = 0
			// The longest code under each root prefix that overflows it.
			let longest int[]
			longest.len(1 << root)
			longest[:] = 0
			for let i = 0; i < count; i++ {
				let n = lengths[start + i]
				let code = codes[start + i]
				if n <= root {
					let first = code << (root - n)
					for let j = 0; j < 1 << (root - n); j++ {
						table[first + j] = i << 5 | n
					}
				} else {
					let prefix = code >> (n - root)
					longest[prefix] = n - root when n - root > longest[prefix]
				}
			}
			for let p = 0; p < 1 << root; p++ {
				continue when longest[p] == 0
				let offset = table.len()
				table.len(offset + (1 << longest[p]))
				table[offset:] = 0
				table[p] = -(offset << 5 | longest[p]) - 1
			}
			for let i = 0; i < count; i++ {
				let n = lengths[start + i]
				continue when n <= root
				let code = codes[start + i]
				let entry = -table[code >> (n - root)] - 1
				let offset = entry >> 5
				let bits = entry & 31
				let rest = n - root
				let first = offset + ((code & ((1 << rest) - 1)) << (bits - rest))
				for let j = 0; j < 1 << (bits - rest); j++ {
					table[first + j] = i << 5 | rest
				}
			}
		}

		// Reads one codeword and returns its symbol.
		def decode(r AacBitReader) int {
			let e = table[r.peek(aacHuffmanRootBits)]
			if e >= 0 {
				r.skip(e & 31)
				return e >> 5
			}
			let sub = -e - 1
			r.skip(aacHuffmanRootBits)
			let e2 = table[(sub >> 5) + r.peek(sub & 31)]
			r.skip(e2 & 31)
			return e2 >> 5
		}
	}

	// One spectral codebook: its decoder and the values each symbol stands
	// for (Table 4.A.2 to 4.A.12).
	type AacCodebook {
		// Values per codeword: 4 for codebooks 1 to 4, else 2.
		dim      int
		// Whether values are magnitudes followed by sign bits.
		unsigned bool
		// The largest magnitude a codeword holds; 16 in codebook 11 is an escape.
		largest  int
		huffman  AacHuffman
		// `dim` values per symbol.
		values   int[]

		// Codebook `book`, 1 to 11.
		def new(book int) {
			dim = book <= 4 ?? (4, 2)
			unsigned = book == 3 || book == 4 || book >= 7
			let start = aacSpectralStart[book - 1]
			let count = aacSpectralStart[book] - start
			huffman = new AacHuffman(aacSpectralCodes, aacSpectralBits, start, count)
			// Values per position and the lowest one.
			let base = 3
			let low = -1
			if book := 3 || 4 {
				low = 0
			} else if book == 5 || book == 6 {
				base = 9
				low = -4
			} else if book == 7 || book == 8 {
				base = 8
				low = 0
			} else if book == 9 || book == 10 {
				base = 13
				low = 0
			} else if book == 11 {
				base = 17
				low = 0
			}
			largest = base + low - 1
			values.len(count * dim)
			for let s = 0; s < count; s++ {
				let rest = s
				for let d = dim - 1; d >= 0; d-- {
					values[s * dim + d] = rest % base + low
					rest = rest / base
				}
			}
		}

		// The symbol encoding the `dim` values at `at` in `q`, magnitudes for an
		// unsigned codebook, with escapes clipped to 16 in codebook 11.
		def symbol(q int[], at int) int {
			let base = unsigned ?? (largest + 1, 2 * largest + 1)
			let low = unsigned ?? (0, -largest)
			let s = 0
			for let d = 0; d < dim; d++ {
				let v = q[at + d]
				if unsigned {
					v = v < 0 ?? (-v, v)
					v = 16 when v > 16
				}
				s = s * base + v - low
			}
			return s
		}
	}

	// The Huffman codebooks of AAC, built once on first use.
	type AacBooks {
		scalefactor AacHuffman
		// Spectral codebooks 1 to 11 at indexes 1 to 11; index 0 is unused.
		spectral    AacCodebook[]

		// Builds every codebook.
		def new() {
			scalefactor = new AacHuffman(aacScalefactorCodes, aacScalefactorBits, 0, 121)
			spectral.push(new AacCodebook(1))
			for let b = 1; b <= 11; b++ {
				spectral.push(new AacCodebook(b))
			}
		}
	}

	let aacBooksCache ?AacBooks = none

	// The shared codebooks, built on the first call.
	def aacBooks() AacBooks {
		if aacBooksCache is none {
			let books = new AacBooks()
			aacBooksCache = books
			return books
		}
		let books AacBooks = aacBooksCache
		return books
	}
}
