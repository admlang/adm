internal partial module std.formats.audio.aac {
	use std.math

	// Parameter bands of the 20 and 34 band layouts, the bands their
	// IPD/OPD cover, hybrid subbands, where the all-pass decay starts, the
	// all-pass bands and the first band with a one-sample delay.
	const aacPsParBands = int[20, 34]
	const aacPsIpdopdBands = int[11, 17]
	const aacPsBands = int[71, 91]
	const aacPsDecayCutoff = int[10, 32]
	const aacPsAllpassBands = int[30, 50]
	const aacPsShortDelayBand = int[42, 62]

	// Envelopes per frame by frame class and bs_num_env (Table 8.29), and
	// parameters per iid/icc mode (Table 8.30).
	const aacPsNumEnv = int[0, 1, 2, 4, 1, 2, 3, 4]
	const aacPsIidIccPars = int[10, 20, 34, 10, 20, 34]
	const aacPsIpdopdPars = int[5, 11, 17, 5, 11, 17]

	// Samples of delay the decorrelator keeps, and those of its all-pass links.
	const aacPsMaxDelay = 14
	const aacPsApDelay = 5
	const aacPsApLinks = 3

	// The hybrid filter prototypes (Table 8.39 to 8.42).
	const aacPsG0Q8 = float[0.00746082949812, 0.02270420949825, 0.04546865930473, 0.07266113929591, 0.09885108575264, 0.11793710567217, 0.125]
	const aacPsG0Q12 = float[0.04081179924692, 0.03812810994926, 0.05144908135699, 0.06399831151592, 0.07428313801106, 0.08100347892914, 0.08333333333333]
	const aacPsG1Q8 = float[0.01565675600122, 0.03752716391991, 0.05417891378782, 0.08417044116767, 0.10307344158036, 0.12222452249753, 0.125]
	const aacPsG2Q4 = float[-0.05908211155639, -0.04871498374946, 0.0, 0.07778723915851, 0.16486303567403, 0.23279856662996, 0.25]
	const aacPsG1Q2 = float[0.0, 0.01899487526049, 0.0, -0.07293139167538, 0.0, 0.30596630545168, 0.5]

	// IID dequantisation, default then fine resolution (Tables 8.43, 8.44).
	const aacPsIidDequant = float[
		0.05623413251903, 0.12589254117942, 0.19952623149689, 0.31622776601684,
		0.44668359215096, 0.63095734448019, 0.79432823472428, 1.0,
		1.25892541179417, 1.58489319246111, 2.23872113856834, 3.16227766016838,
		5.01187233627272, 7.94328234724282, 17.7827941003892,
		0.00316227766017, 0.00562341325190, 0.01, 0.01778279410039,
		0.03162277660168, 0.05623413251903, 0.07943282347243, 0.11220184543020,
		0.15848931924611, 0.22387211385683, 0.31622776601684, 0.39810717055350,
		0.50118723362727, 0.63095734448019, 0.79432823472428, 1.0,
		1.25892541179417, 1.58489319246111, 1.99526231496888, 2.51188643150958,
		3.16227766016838, 4.46683592150963, 6.30957344480193, 8.91250938133745,
		12.5892541179417, 17.7827941003892, 31.6227766016838, 56.2341325190349,
		100.0, 177.827941003892, 316.227766016837
	]

	// ICC dequantisation and its arc cosines (Table 8.45).
	const aacPsIccInvq = float[1.0, 0.937, 0.84118, 0.60092, 0.36764, 0.0, -0.589, -1.0]
	const aacPsAcosIccInvq = float[0.0, 0.35685527, 0.57133466, 0.92614472, 1.1943263, 1.5707963267948966, 2.2006171, 3.141592653589793]

	// Centre frequencies of the hybrid bands for the all-pass phases
	// (8.6.4.5.2), in eighths (20 bands) and 24ths (34 bands).
	const aacPsCentre20 = int[-3, -1, 1, 3, 5, 7, 10, 14, 18, 22]
	const aacPsCentre34 = int[2, 6, 10, 14, 18, 22, 26, 30, 34, -10, -6, -2, 51, 57, 15, 21, 27, 33, 39, 45, 54, 66, 78, 42, 102, 66, 78, 90, 102, 114, 126, 90]

	// All-pass link coefficients (8.6.4.5.2).
	const aacPsAllpassA = float[0.65143905753106, 0.56471812200776, 0.48954165955695]

	// Parametric stereo (ISO/IEC 14496-3 8.6.4): a mono SBR channel made
	// stereo again from inter-channel intensity, coherence and phase cues,
	// applied in a hybrid filter bank over the QMF samples.
	type AacPs {
		// QMF slots per frame: 32, or 30 under a 960-line core.
		slots        int
		// Whether the stream may carry parametric stereo, so a single channel
		// element decodes to two channels.
		enabled      bool
		// Whether a PS header has been read.
		start        bool
		enableIid    bool
		iidQuant     int
		nrIidPar     int
		nrIpdopdPar  int
		enableIcc    bool
		iccMode      int
		nrIccPar     int
		enableExt    bool
		frameClass   int
		numEnvOld    int
		numEnv       int
		enableIpdopd bool
		border       int[]
		// Parameters per envelope and band, [envelope][band] over 34 bands.
		iidPar       int[]
		iccPar       int[]
		ipdPar       int[]
		opdPar       int[]
		is34         bool
		is34Old      bool

		// Hybrid analysis input per QMF band 0..4 over 44 slots.
		inRe                float[]
		inIm                float[]
		// The decorrelator's delay line per hybrid band and its all-pass
		// links, [band][link][slot].
		delayRe             float[]
		delayIm             float[]
		apRe                float[]
		apIm                float[]
		peakDecayNrg        float[]
		powerSmooth         float[]
		peakDecayDiffSmooth float[]
		// Mixing matrices, [real/imaginary][envelope][band].
		h11                 float[]
		h12                 float[]
		h21                 float[]
		h22                 float[]
		// The hybrid samples of both channels, [band][slot] over 32 slots.
		lRe                 float[]
		lIm                 float[]
		rRe                 float[]
		rIm                 float[]
		opdHist             int[]
		ipdHist             int[]
		power               float[]
		gainT               float[]
		iidMapped           int[]
		iccMapped           int[]
		ipdMapped           int[]
		opdMapped           int[]
		temp                float[]

		// Whether the last ps_data had a header.
		headerSeen bool

		// Tables, made when the stream turns out to carry PS.
		prepared   bool
		books      AacHuffman[]
		pdReSmooth float[]
		pdImSmooth float[]
		ha         float[]
		hb         float[]
		f20        float[]
		f34a       float[]
		f34b       float[]
		f34c       float[]
		qFract     float[]
		phiFract   float[]

		def new() {
			slots = 32
			border.len(6)
		}

		// Makes the tables and state the first time PS data arrives.
		def prepare() {
			return when prepared
			prepared = true
			for let i = 0; i < 10; i++ {
				books.push(new AacHuffman(aacPsHuffCodes, aacPsHuffLengths, aacPsHuffStart[i], aacPsHuffCount[i]))
			}
			iidPar.len(6 * 34)
			iccPar.len(6 * 34)
			ipdPar.len(6 * 34)
			opdPar.len(6 * 34)
			inRe.len(5 * 44)
			inIm.len(5 * 44)
			delayRe.len(91 * 46)
			delayIm.len(91 * 46)
			apRe.len(50 * 3 * 37)
			apIm.len(50 * 3 * 37)
			peakDecayNrg.len(34)
			powerSmooth.len(34)
			peakDecayDiffSmooth.len(34)
			h11.len(2 * 6 * 34)
			h12.len(2 * 6 * 34)
			h21.len(2 * 6 * 34)
			h22.len(2 * 6 * 34)
			lRe.len(91 * 32)
			lIm.len(91 * 32)
			rRe.len(91 * 32)
			rIm.len(91 * 32)
			opdHist.len(17)
			ipdHist.len(17)
			power.len(34 * 32)
			gainT.len(34 * 32)
			iidMapped.len(6 * 34)
			iccMapped.len(6 * 34)
			ipdMapped.len(6 * 34)
			opdMapped.len(6 * 34)
			temp.len(24)
			// Smoothed phase steps of three successive IPD/OPD indices.
			let pdSin = float[0.0, math.Sqrt2 / 2.0, 1.0, math.Sqrt2 / 2.0, 0.0, -math.Sqrt2 / 2.0, -1.0, -math.Sqrt2 / 2.0]
			let pdCos = float[1.0, math.Sqrt2 / 2.0, 0.0, -math.Sqrt2 / 2.0, -1.0, -math.Sqrt2 / 2.0, 0.0, math.Sqrt2 / 2.0]
			pdReSmooth.len(512)
			pdImSmooth.len(512)
			for let a = 0; a < 8; a++ {
				for let b = 0; b < 8; b++ {
					for let c = 0; c < 8; c++ {
						let re = 0.25 * pdCos[a] + 0.5 * pdCos[b] + pdCos[c]
						let im = 0.25 * pdSin[a] + 0.5 * pdSin[b] + pdSin[c]
						let mag = 1.0 / math.sqrt(re * re + im * im)
						pdReSmooth[a * 64 + b * 8 + c] = re * mag
						pdImSmooth[a * 64 + b * 8 + c] = im * mag
					}
				}
			}
			// Mixing matrices per IID and ICC index, mixing modes A and B.
			ha.len(46 * 8 * 4)
			hb.len(46 * 8 * 4)
			for let iid = 0; iid < 46; iid++ {
				let c = aacPsIidDequant[iid]
				let c1 = math.Sqrt2 / math.sqrt(1.0 + c * c)
				let c2 = c * c1
				for let icc = 0; icc < 8; icc++ {
					let at = (iid * 8 + icc) * 4
					let alpha = 0.5 * aacPsAcosIccInvq[icc]
					let beta = alpha * (c1 - c2) / math.Sqrt2
					ha[at] = c2 * math.cos(beta + alpha)
					ha[at + 1] = c1 * math.cos(beta - alpha)
					ha[at + 2] = c2 * math.sin(beta + alpha)
					ha[at + 3] = c1 * math.sin(beta - alpha)
					let rho = aacPsIccInvq[icc].max(0.05)
					let a = 0.5 * math.atan2(2.0 * c * rho, c * c - 1.0)
					let mu = c + 1.0 / c
					mu = math.sqrt(1.0 + (4.0 * rho * rho - 4.0) / (mu * mu))
					let gamma = math.atan(math.sqrt((1.0 - mu) / (1.0 + mu)))
					a += math.π / 2.0 when a < 0.0
					hb[at] = math.Sqrt2 * math.cos(a) * math.cos(gamma)
					hb[at + 1] = math.Sqrt2 * math.sin(a) * math.cos(gamma)
					hb[at + 2] = 0.0 - math.Sqrt2 * math.sin(a) * math.sin(gamma)
					hb[at + 3] = math.Sqrt2 * math.cos(a) * math.sin(gamma)
				}
			}
			// All-pass fractional delays and phases per band, [layout][band].
			qFract.len(2 * 50 * 3 * 2)
			phiFract.len(2 * 50 * 2)
			let links = float[0.43, 0.75, 0.347]
			for let layout = 0; layout < 2; layout++ {
				for let k = 0; k < aacPsAllpassBands[layout]; k++ {
					let centre = 0.0
					if layout == 0 {
						centre = k < 10 ?? (float(aacPsCentre20[k]) * 0.125, float(k) - 6.5)
					} else {
						centre = k < 32 ?? (float(aacPsCentre34[k]) / 24.0, float(k) - 26.5)
					}
					for let m = 0; m < 3; m++ {
						let theta = 0.0 - math.π * links[m] * centre
						let at = ((layout * 50 + k) * 3 + m) * 2
						qFract[at] = math.cos(theta)
						qFract[at + 1] = math.sin(theta)
					}
					let theta = 0.0 - math.π * 0.39 * centre
					phiFract[(layout * 50 + k) * 2] = math.cos(theta)
					phiFract[(layout * 50 + k) * 2 + 1] = math.sin(theta)
				}
			}
			f20 = aacPsFilters(aacPsG0Q8, 8)
			f34a = aacPsFilters(aacPsG0Q12, 12)
			f34b = aacPsFilters(aacPsG1Q8, 8)
			f34c = aacPsFilters(aacPsG2Q4, 4)
		}

		// Reads ps_data (Table 8.1) from an SBR extension of `bits` bits and
		// returns the bits read; damaged data turns PS off until the next
		// header.
		def read(r AacBitReader, bits int) int {
			prepare()
			let first = r.position()
			let ok = readData(r)
			let used = r.position() - first
			if ok && used <= bits {
				start = true when headerSeen
				return used
			}
			start = false
			iidPar.fill(0)
			iccPar.fill(0)
			ipdPar.fill(0)
			opdPar.fill(0)
			r.pos = first + bits
			return bits
		}

		// The body of `read`; false on invalid data.
		def readData(r AacBitReader) bool {
			headerSeen = r.flag()
			if headerSeen {
				enableIid = r.flag()
				if enableIid {
					let mode = r.read(3)
					return false when mode > 5
					nrIidPar = aacPsIidIccPars[mode]
					iidQuant = mode > 2 ?? (1, 0)
					nrIpdopdPar = aacPsIpdopdPars[mode]
				}
				enableIcc = r.flag()
				if enableIcc {
					iccMode = r.read(3)
					return false when iccMode > 5
					nrIccPar = aacPsIidIccPars[iccMode]
				}
				enableExt = r.flag()
			}
			frameClass = r.read(1)
			numEnvOld = numEnv
			numEnv = aacPsNumEnv[frameClass * 4 + r.read(2)]
			border[0] = -1
			if frameClass != 0 {
				for let e = 1; e <= numEnv; e++ {
					border[e] = r.read(5)
					return false when border[e] < border[e - 1]
				}
			} else {
				for let e = 1; e <= numEnv; e++ {
					border[e] = (e * slots >> aacPsLog2(numEnv)) - 1
				}
			}
			if enableIid {
				for let e = 0; e < numEnv; e++ {
					let dt = r.flag()
					let book = dt ?? (iidQuant == 0 ?? (3, 1), iidQuant == 0 ?? (2, 0))
					return false unless readPars(r, iidPar, nrIidPar, book, e, dt, 7 + 8 * iidQuant)
				}
			} else {
				iidPar.fill(0)
			}
			if enableIcc {
				for let e = 0; e < numEnv; e++ {
					let dt = r.flag()
					return false unless readPars(r, iccPar, nrIccPar, dt ?? (5, 4), e, dt, -1)
				}
			} else {
				iccPar.fill(0)
			}
			if enableExt {
				let count = r.read(4)
				count += r.read(8) when count == 15
				count *= 8
				for count > 7 {
					let id = r.read(2)
					count -= 2 + readExtension(r, id)
				}
				return false when count < 0
				r.skip(count)
			}
			// A last envelope that stops short of the frame end repeats.
			if numEnv == 0 || border[numEnv] < slots - 1 {
				let source = numEnv != 0 ?? (numEnv - 1, numEnvOld - 1)
				if source >= 0 && source != numEnv {
					for let b = 0; b < 34; b++ {
						iidPar[numEnv * 34 + b] = iidPar[source * 34 + b] when enableIid
						iccPar[numEnv * 34 + b] = iccPar[source * 34 + b] when enableIcc
						if enableIpdopd {
							ipdPar[numEnv * 34 + b] = ipdPar[source * 34 + b]
							opdPar[numEnv * 34 + b] = opdPar[source * 34 + b]
						}
					}
				}
				if enableIid {
					for let b = 0; b < nrIidPar; b++ {
						return false when iidPar[numEnv * 34 + b].abs() > 7 + 8 * iidQuant
					}
				}
				if enableIcc {
					for let b = 0; b < nrIidPar; b++ {
						let v = iccPar[numEnv * 34 + b]
						return false when v < 0 || v > 7
					}
				}
				numEnv++
				border[numEnv] = slots - 1
			}
			is34Old = is34
			if enableIid || enableIcc {
				is34 = (enableIid && nrIidPar == 34) || (enableIcc && nrIccPar == 34)
			}
			if !enableIpdopd {
				ipdPar.fill(0)
				opdPar.fill(0)
			}
			return true
		}

		// Reads one parameter set of envelope `e`: coded against the
		// previous envelope (`dt`) or along the bands. `limit` bounds the
		// absolute value (IID), -1 checks 0..7 (ICC), -2 wraps to 0..7
		// (IPD/OPD).
		def readPars(r AacBitReader, par int[], count int, book int, e int, dt bool, limit int) bool {
			let row = e * 34
			if dt {
				let prev = (e != 0 ?? (e - 1, numEnvOld - 1)).max(0) * 34
				for let b = 0; b < count; b++ {
					let v = par[prev + b] + books[book].decode(r) + aacPsHuffOffset[book]
					v &= 7 when limit == -2
					par[row + b] = v
					return false unless aacPsParOk(v, limit)
				}
			} else {
				let v = 0
				for let b = 0; b < count; b++ {
					v += books[book].decode(r) + aacPsHuffOffset[book]
					v &= 7 when limit == -2
					par[row + b] = v
					return false unless aacPsParOk(v, limit)
				}
			}
			return true
		}

		// Reads a ps_extension (Table 8.4) of type `id` and returns its bits.
		def readExtension(r AacBitReader, id int) int {
			return 0 when id != 0
			let first = r.position()
			enableIpdopd = r.flag()
			if enableIpdopd {
				for let e = 0; e < numEnv; e++ {
					let dt = r.flag()
					readPars(r, ipdPar, nrIpdopdPar, dt ?? (7, 6), e, dt, -2)
					let dt2 = r.flag()
					readPars(r, opdPar, nrIpdopdPar, dt2 ?? (9, 8), e, dt2, -2)
				}
			}
			r.skip(1)
			return r.position() - first
		}

		// Turns the mono QMF samples of channel 0 in `re`/`im` ([channel]
		// [slot][band] over 38 slots of 64 bands) into both channels, over
		// the first `top` QMF bands.
		def apply(re float[], im float[], top int) {
			prepare()
			let layout = is34 ?? (1, 0)
			let bands = aacPsBands[layout]
			let t = top + bands - 64
			for let k = t.max(0); k < bands; k++ {
				for let i = 0; i < 46; i++ {
					delayRe[k * 46 + i] = 0.0
					delayIm[k * 46 + i] = 0.0
				}
			}
			for let k = t.max(0); k < aacPsAllpassBands[layout]; k++ {
				for let i = 0; i < 3 * 37; i++ {
					apRe[k * 111 + i] = 0.0
					apIm[k * 111 + i] = 0.0
				}
			}
			analysis(re, im, layout)
			decorrelate(layout)
			stereo(layout)
			synthesis(re, im, 0, lRe, lIm, layout)
			synthesis(re, im, 38 * 64, rRe, rIm, layout)
		}

		// The hybrid analysis (8.6.4.3): QMF bands 0..4 (0..2 with 20 bands)
		// split further, the rest copied, into `lRe`/`lIm`.
		def analysis(re float[], im float[], layout int) {
			for let i = 0; i < 5; i++ {
				for let j = 0; j < 38; j++ {
					inRe[i * 44 + j + 6] = re[j * 64 + i]
					inIm[i * 44 + j + 6] = im[j * 64 + i]
				}
			}
			if layout == 1 {
				hybridComplex(0, f34a, 12, 0)
				hybridComplex(1, f34b, 8, 12)
				hybridComplex(2, f34c, 4, 20)
				hybridComplex(3, f34c, 4, 24)
				hybridComplex(4, f34c, 4, 28)
				interleave(re, im, 27, 5)
			} else {
				for let i = 0; i < slots; i++ {
					hybridSums(0, i, f20, 8)
					let o = i
					lRe[0 * 32 + o] = temp[6 * 2]
					lIm[0 * 32 + o] = temp[6 * 2 + 1]
					lRe[1 * 32 + o] = temp[7 * 2]
					lIm[1 * 32 + o] = temp[7 * 2 + 1]
					lRe[2 * 32 + o] = temp[0]
					lIm[2 * 32 + o] = temp[1]
					lRe[3 * 32 + o] = temp[2]
					lIm[3 * 32 + o] = temp[3]
					lRe[4 * 32 + o] = temp[4] + temp[10]
					lIm[4 * 32 + o] = temp[5] + temp[11]
					lRe[5 * 32 + o] = temp[6] + temp[8]
					lIm[5 * 32 + o] = temp[7] + temp[9]
				}
				hybridReal(1, 6, true)
				hybridReal(2, 8, false)
				interleave(re, im, 7, 3)
			}
			for let i = 0; i < 5; i++ {
				for let j = 0; j < 6; j++ {
					inRe[i * 44 + j] = inRe[i * 44 + j + slots]
					inIm[i * 44 + j] = inIm[i * 44 + j + slots]
				}
			}
		}

		// The `n` complex filter outputs of input band `band` at slot `i`
		// into `temp`.
		def hybridSums(band int, i int, filter float[], n int) {
			let base = band * 44 + i
			for let q = 0; q < n; q++ {
				let f = q * 16
				let sr = filter[f + 12] * inRe[base + 6]
				let si = filter[f + 12] * inIm[base + 6]
				for let j = 0; j < 6; j++ {
					let re0 = inRe[base + j] + inRe[base + 12 - j]
					let re1 = inIm[base + j] - inIm[base + 12 - j]
					let im0 = inIm[base + j] + inIm[base + 12 - j]
					let im1 = inRe[base + j] - inRe[base + 12 - j]
					sr += filter[f + 2 * j] * re0 - filter[f + 2 * j + 1] * re1
					si += filter[f + 2 * j] * im0 + filter[f + 2 * j + 1] * im1
				}
				temp[2 * q] = sr
				temp[2 * q + 1] = si
			}
		}

		// Splits input band `band` into `n` hybrid bands from `out` with a
		// complex filter.
		def hybridComplex(band int, filter float[], n int, out int) {
			for let i = 0; i < slots; i++ {
				hybridSums(band, i, filter, n)
				for let q = 0; q < n; q++ {
					lRe[(out + q) * 32 + i] = temp[2 * q]
					lIm[(out + q) * 32 + i] = temp[2 * q + 1]
				}
			}
		}

		// Splits input band `band` into two hybrid bands from `out` with the
		// real filter; `reverse` swaps them.
		def hybridReal(band int, out int, reverse bool) {
			let f = aacPsG1Q2
			let first = reverse ?? (out + 1, out)
			let second = reverse ?? (out, out + 1)
			for let i = 0; i < slots; i++ {
				let base = band * 44 + i
				let reIn = f[6] * inRe[base + 6]
				let imIn = f[6] * inIm[base + 6]
				let reOp = 0.0
				let imOp = 0.0
				for let j = 0; j < 6; j += 2 {
					reOp += f[j + 1] * (inRe[base + j + 1] + inRe[base + 12 - j - 1])
					imOp += f[j + 1] * (inIm[base + j + 1] + inIm[base + 12 - j - 1])
				}
				lRe[first * 32 + i] = reIn + reOp
				lIm[first * 32 + i] = imIn + imOp
				lRe[second * 32 + i] = reIn - reOp
				lIm[second * 32 + i] = imIn - imOp
			}
		}

		// Copies QMF bands from `from` up to hybrid bands from `offset + from`.
		def interleave(re float[], im float[], offset int, from int) {
			for let i = from; i < 64; i++ {
				for let j = 0; j < slots; j++ {
					lRe[(offset + i) * 32 + j] = re[j * 64 + i]
					lIm[(offset + i) * 32 + j] = im[j * 64 + i]
				}
			}
		}

		// The decorrelated signal `r` from `l` (8.6.4.5): all-pass filters
		// below the short delay band, plain delays above, scaled down on
		// transients.
		def decorrelate(layout int) {
			let kToI = layout == 1 ?? (aacPsKToI34, aacPsKToI20)
			let bands = aacPsBands[layout]
			let parBands = aacPsParBands[layout]
			if is34 != is34Old {
				peakDecayNrg.fill(0.0)
				powerSmooth.fill(0.0)
				peakDecayDiffSmooth.fill(0.0)
				delayRe.fill(0.0)
				delayIm.fill(0.0)
				apRe.fill(0.0)
				apIm.fill(0.0)
			}
			power.fill(0.0)
			for let k = 0; k < bands; k++ {
				let i = kToI[k]
				for let n = 0; n < slots; n++ {
					let a = lRe[k * 32 + n]
					let b = lIm[k * 32 + n]
					power[i * 32 + n] += a * a + b * b
				}
			}
			let peakDecay = 0.76592833836465
			for let i = 0; i < parBands; i++ {
				for let n = 0; n < slots; n++ {
					let p = power[i * 32 + n]
					peakDecayNrg[i] = (peakDecay * peakDecayNrg[i]).max(p)
					powerSmooth[i] += 0.25 * (p - powerSmooth[i])
					peakDecayDiffSmooth[i] += 0.25 * (peakDecayNrg[i] - p - peakDecayDiffSmooth[i])
					let denom = 1.5 * peakDecayDiffSmooth[i]
					gainT[i * 32 + n] = denom > powerSmooth[i] ?? (powerSmooth[i] / denom, 1.0)
				}
			}
			let k = 0
			for; k < aacPsAllpassBands[layout]; k++ {
				let b = kToI[k]
				let slope = (1.0 - 0.05 * float(k - aacPsDecayCutoff[layout])).clamp(0.0, 1.0)
				shiftDelay(k)
				for let m = 0; m < 3; m++ {
					let at = (k * 3 + m) * 37
					for let i = 0; i < 5; i++ {
						apRe[at + i] = apRe[at + i + slots]
						apIm[at + i] = apIm[at + i + slots]
					}
				}
				allpass(k, b, layout, slope)
			}
			for; k < aacPsShortDelayBand[layout]; k++ {
				shiftDelay(k)
				let i = kToI[k]
				for let n = 0; n < slots; n++ {
					let g = gainT[i * 32 + n]
					rRe[k * 32 + n] = delayRe[k * 46 + n] * g
					rIm[k * 32 + n] = delayIm[k * 46 + n] * g
				}
			}
			for; k < bands; k++ {
				shiftDelay(k)
				let i = kToI[k]
				for let n = 0; n < slots; n++ {
					let g = gainT[i * 32 + n]
					rRe[k * 32 + n] = delayRe[k * 46 + aacPsMaxDelay - 1 + n] * g
					rIm[k * 32 + n] = delayIm[k * 46 + aacPsMaxDelay - 1 + n] * g
				}
			}
		}

		// Moves band `k`'s delay line on by a frame and appends its input.
		def shiftDelay(k int) {
			let at = k * 46
			for let i = 0; i < aacPsMaxDelay; i++ {
				delayRe[at + i] = delayRe[at + i + slots]
				delayIm[at + i] = delayIm[at + i + slots]
			}
			for let n = 0; n < slots; n++ {
				delayRe[at + aacPsMaxDelay + n] = lRe[k * 32 + n]
				delayIm[at + aacPsMaxDelay + n] = lIm[k * 32 + n]
			}
		}

		// The fractional-delay all-pass chain of band `k` (parameter band
		// `b`) over its delay line, two slots back.
		def allpass(k int, b int, layout int, slope float) {
			let pr = phiFract[(layout * 50 + k) * 2]
			let pi = phiFract[(layout * 50 + k) * 2 + 1]
			let d = k * 46 + aacPsMaxDelay - 2
			for let n = 0; n < slots; n++ {
				let dr = delayRe[d + n]
				let di = delayIm[d + n]
				let inRe0 = dr * pr - di * pi
				let inIm0 = dr * pi + di * pr
				for let m = 0; m < 3; m++ {
					let ag = aacPsAllpassA[m] * slope
					let aRe = ag * inRe0
					let aIm = ag * inIm0
					let at = (k * 3 + m) * 37
					let lr = apRe[at + n + 2 - m]
					let li = apIm[at + n + 2 - m]
					let q = ((layout * 50 + k) * 3 + m) * 2
					let fr = qFract[q]
					let fi = qFract[q + 1]
					let apdRe = inRe0
					let apdIm = inIm0
					inRe0 = lr * fr - li * fi - aRe
					inIm0 = lr * fi + li * fr - aIm
					apRe[at + n + 5] = apdRe + ag * inRe0
					apIm[at + n + 5] = apdIm + ag * inIm0
				}
				let g = gainT[b * 32 + n]
				rRe[k * 32 + n] = g * inRe0
				rIm[k * 32 + n] = g * inIm0
			}
		}

		// Mixes `l` and `r` into the two output channels with matrices from
		// the IID, ICC, IPD and OPD cues, interpolated across each envelope
		// (8.6.4.6).
		def stereo(layout int) {
			let kToI = layout == 1 ?? (aacPsKToI34, aacPsKToI20)
			let table = iccMode < 3 ?? (ha, hb)
			let parBands = aacPsParBands[layout]
			if numEnvOld != 0 {
				for let part = 0; part < 2; part++ {
					let dst = part * 204
					let src = part * 204 + numEnvOld * 34
					for let b = 0; b < 34; b++ {
						h11[dst + b] = h11[src + b]
						h12[dst + b] = h12[src + b]
						h21[dst + b] = h21[src + b]
						h22[dst + b] = h22[src + b]
					}
				}
			}
			if layout == 1 {
				remap34(iidMapped, iidPar, nrIidPar, true)
				remap34(iccMapped, iccPar, nrIccPar, true)
				if enableIpdopd {
					remap34(ipdMapped, ipdPar, nrIpdopdPar, false)
					remap34(opdMapped, opdPar, nrIpdopdPar, false)
				}
				if !is34Old {
					for let part = 0; part < 2; part++ {
						aacPsMapVal20To34(h11, part * 204)
						aacPsMapVal20To34(h12, part * 204)
						aacPsMapVal20To34(h21, part * 204)
						aacPsMapVal20To34(h22, part * 204)
					}
					ipdHist.fill(0)
					opdHist.fill(0)
				}
			} else {
				remap20(iidMapped, iidPar, nrIidPar, true)
				remap20(iccMapped, iccPar, nrIccPar, true)
				if enableIpdopd {
					remap20(ipdMapped, ipdPar, nrIpdopdPar, false)
					remap20(opdMapped, opdPar, nrIpdopdPar, false)
				}
				if is34Old {
					for let part = 0; part < 2; part++ {
						aacPsMapVal34To20(h11, part * 204)
						aacPsMapVal34To20(h12, part * 204)
						aacPsMapVal34To20(h21, part * 204)
						aacPsMapVal34To20(h22, part * 204)
					}
					ipdHist.fill(0)
					opdHist.fill(0)
				}
			}
			for let e = 0; e < numEnv; e++ {
				for let b = 0; b < parBands; b++ {
					let at = ((iidMapped[e * 34 + b] + 7 + 23 * iidQuant) * 8 + iccMapped[e * 34 + b]) * 4
					let a11 = table[at]
					let a12 = table[at + 1]
					let a21 = table[at + 2]
					let a22 = table[at + 3]
					let next = (e + 1) * 34 + b
					if enableIpdopd && b < aacPsIpdopdBands[layout] {
						let opdIdx = opdHist[b] * 8 + opdMapped[e * 34 + b]
						let ipdIdx = ipdHist[b] * 8 + ipdMapped[e * 34 + b]
						let opdRe = pdReSmooth[opdIdx]
						let opdIm = pdImSmooth[opdIdx]
						let ipdRe = pdReSmooth[ipdIdx]
						let ipdIm = pdImSmooth[ipdIdx]
						opdHist[b] = opdIdx & 0x3F
						ipdHist[b] = ipdIdx & 0x3F
						let adjRe = opdRe * ipdRe + opdIm * ipdIm
						let adjIm = opdIm * ipdRe - opdRe * ipdIm
						h11[204 + next] = a11 * opdIm
						h12[204 + next] = a12 * adjIm
						h21[204 + next] = a21 * opdIm
						h22[204 + next] = a22 * adjIm
						a11 *= opdRe
						a12 *= adjRe
						a21 *= opdRe
						a22 *= adjRe
					}
					h11[next] = a11
					h12[next] = a12
					h21[next] = a21
					h22[next] = a22
				}
				let first = border[e]
				let end = border[e + 1]
				let width = 1.0 / float((end - first) == 0 ?? (1, end - first))
				for let k = 0; k < aacPsBands[layout]; k++ {
					let b = kToI[k]
					let cur = e * 34 + b
					let next = (e + 1) * 34 + b
					let x11 = h11[cur]
					let x12 = h12[cur]
					let x21 = h21[cur]
					let x22 = h22[cur]
					let s11 = (h11[next] - x11) * width
					let s12 = (h12[next] - x12) * width
					let s21 = (h21[next] - x21) * width
					let s22 = (h22[next] - x22) * width
					continue when end == first
					if !enableIpdopd {
						for let n = first + 1; n < end + 1; n++ {
							let at = k * 32 + n
							let lr = lRe[at]
							let li = lIm[at]
							let rr = rRe[at]
							let ri = rIm[at]
							x11 += s11
							x12 += s12
							x21 += s21
							x22 += s22
							lRe[at] = x11 * lr + x21 * rr
							lIm[at] = x11 * li + x21 * ri
							rRe[at] = x12 * lr + x22 * rr
							rIm[at] = x12 * li + x22 * ri
						}
						continue
					}
					let sign = (layout == 1 && k <= 13 && k >= 9) || (layout == 0 && k <= 1) ?? (-1.0, 1.0)
					let y11 = sign * h11[204 + cur]
					let y12 = sign * h12[204 + cur]
					let y21 = sign * h21[204 + cur]
					let y22 = sign * h22[204 + cur]
					let t11 = (h11[204 + next] - y11) * width
					let t12 = (h12[204 + next] - y12) * width
					let t21 = (h21[204 + next] - y21) * width
					let t22 = (h22[204 + next] - y22) * width
					for let n = first + 1; n < end + 1; n++ {
						let at = k * 32 + n
						let lr = lRe[at]
						let li = lIm[at]
						let rr = rRe[at]
						let ri = rIm[at]
						x11 += s11
						x12 += s12
						x21 += s21
						x22 += s22
						y11 += t11
						y12 += t12
						y21 += t21
						y22 += t22
						lRe[at] = x11 * lr + x21 * rr - y11 * li - y21 * ri
						lIm[at] = x11 * li + x21 * ri + y11 * lr + y21 * rr
						rRe[at] = x12 * lr + x22 * rr - y12 * li - y22 * ri
						rIm[at] = x12 * li + x22 * ri + y12 * lr + y22 * rr
					}
				}
			}
		}

		// Parameters of `count` bands mapped to the 34 band layout.
		def remap34(dst int[], src int[], count int, full bool) {
			for let e = 0; e < numEnv; e++ {
				let at = e * 34
				if count == 20 || count == 11 {
					aacPsMap20To34(dst, src, at, full)
				} else if count == 10 || count == 5 {
					aacPsMap10To34(dst, src, at, full)
				} else {
					for let b = 0; b < 34; b++ {
						dst[at + b] = src[at + b]
					}
				}
			}
		}

		// Parameters of `count` bands mapped to the 20 band layout.
		def remap20(dst int[], src int[], count int, full bool) {
			for let e = 0; e < numEnv; e++ {
				let at = e * 34
				if count == 34 || count == 17 {
					aacPsMap34To20(dst, src, at, full)
				} else if count == 10 || count == 5 {
					if full {
						for let b = 9; b >= 0; b-- {
							dst[at + 2 * b] = src[at + b]
							dst[at + 2 * b + 1] = src[at + b]
						}
					} else {
						dst[at + 10] = 0
						for let b = 4; b >= 0; b-- {
							dst[at + 2 * b] = src[at + b]
							dst[at + 2 * b + 1] = src[at + b]
						}
					}
				} else {
					for let b = 0; b < 34; b++ {
						dst[at + b] = src[at + b]
					}
				}
			}
		}

		// The hybrid synthesis (8.6.4.7) of `re`/`im` from `offset` out of
		// the hybrid samples `hr`/`hi`.
		def synthesis(re float[], im float[], offset int, hr float[], hi float[], layout int) {
			if layout == 1 {
				for let n = 0; n < slots; n++ {
					let o = offset + n * 64
					let sums = int[0, 12, 20, 24, 28, 32]
					for let band = 0; band < 5; band++ {
						let sr = 0.0
						let si = 0.0
						for let i = sums[band]; i < sums[band + 1]; i++ {
							sr += hr[i * 32 + n]
							si += hi[i * 32 + n]
						}
						re[o + band] = sr
						im[o + band] = si
					}
					for let i = 5; i < 64; i++ {
						re[o + i] = hr[(27 + i) * 32 + n]
						im[o + i] = hi[(27 + i) * 32 + n]
					}
				}
				return
			}
			for let n = 0; n < slots; n++ {
				let o = offset + n * 64
				re[o] = hr[n] + hr[32 + n] + hr[64 + n] + hr[96 + n] + hr[128 + n] + hr[160 + n]
				im[o] = hi[n] + hi[32 + n] + hi[64 + n] + hi[96 + n] + hi[128 + n] + hi[160 + n]
				re[o + 1] = hr[6 * 32 + n] + hr[7 * 32 + n]
				im[o + 1] = hi[6 * 32 + n] + hi[7 * 32 + n]
				re[o + 2] = hr[8 * 32 + n] + hr[9 * 32 + n]
				im[o + 2] = hi[8 * 32 + n] + hi[9 * 32 + n]
				for let i = 3; i < 64; i++ {
					re[o + i] = hr[(7 + i) * 32 + n]
					im[o + i] = hi[(7 + i) * 32 + n]
				}
			}
		}
	}

	// Whether a parameter value is in range: |v| <= limit for limit >= 0,
	// 0..7 for -1, anything for -2 (IPD/OPD wrap).
	def aacPsParOk(v int, limit int) bool {
		return v.abs() <= limit when limit >= 0
		return v >= 0 && v <= 7 when limit == -1
		return true
	}

	// log2 of an envelope count of 1, 2 or 4 (3 counts as 1, as the
	// reference computes it).
	def aacPsLog2(n int) int {
		return n >= 4 ?? (2, n >= 2 ?? (1, 0))
	}

	// The complex filters of a hybrid band split: prototype `proto` over
	// `bands` bands, [band][tap][real, imaginary] over 8 taps.
	def aacPsFilters(proto float[], bands int) float[] {
		let f float[]
		f.len(bands * 16)
		for let q = 0; q < bands; q++ {
			for let n = 0; n < 7; n++ {
				let theta = 2.0 * math.π * (float(q) + 0.5) * float(n - 6) / float(bands)
				f[q * 16 + 2 * n] = proto[n] * math.cos(theta)
				f[q * 16 + 2 * n + 1] = 0.0 - proto[n] * math.sin(theta)
			}
		}
		return f
	}

	// Table 8.46: 34 parameters to 20 bands.
	def aacPsMap34To20(dst int[], p int[], at int, full bool) {
		dst[at] = (2 * p[at] + p[at + 1]) / 3
		dst[at + 1] = (p[at + 1] + 2 * p[at + 2]) / 3
		dst[at + 2] = (2 * p[at + 3] + p[at + 4]) / 3
		dst[at + 3] = (p[at + 4] + 2 * p[at + 5]) / 3
		dst[at + 4] = (p[at + 6] + p[at + 7]) / 2
		dst[at + 5] = (p[at + 8] + p[at + 9]) / 2
		dst[at + 6] = p[at + 10]
		dst[at + 7] = p[at + 11]
		dst[at + 8] = (p[at + 12] + p[at + 13]) / 2
		dst[at + 9] = (p[at + 14] + p[at + 15]) / 2
		dst[at + 10] = p[at + 16]
		return unless full
		dst[at + 11] = p[at + 17]
		dst[at + 12] = p[at + 18]
		dst[at + 13] = p[at + 19]
		dst[at + 14] = (p[at + 20] + p[at + 21]) / 2
		dst[at + 15] = (p[at + 22] + p[at + 23]) / 2
		dst[at + 16] = (p[at + 24] + p[at + 25]) / 2
		dst[at + 17] = (p[at + 26] + p[at + 27]) / 2
		dst[at + 18] = (p[at + 28] + p[at + 29] + p[at + 30] + p[at + 31]) / 4
		dst[at + 19] = (p[at + 32] + p[at + 33]) / 2
	}

	// Table 8.47: 10 parameters to 34 bands.
	def aacPsMap10To34(dst int[], p int[], at int, full bool) {
		let src = int[0, 0, 0, 1, 1, 1, 2, 2, 2, 2, 3, 3, 4, 4, 4, 4, 5, 5, 6, 6, 7, 7, 7, 7, 8, 8, 8, 8, 9, 9, 9, 9, 9, 9]
		let last = full ?? (34, 16)
		for let b = 0; b < last; b++ {
			dst[at + b] = p[at + src[b]]
		}
		dst[at + 16] = 0 unless full
	}

	// Table 8.47: 20 parameters to 34 bands.
	def aacPsMap20To34(dst int[], p int[], at int, full bool) {
		let src = int[0, -1, 1, 2, -2, 3, 4, 4, 5, 5, 6, 7, 8, 8, 9, 9, 10, 11, 12, 13, 14, 14, 15, 15, 16, 16, 17, 17, 18, 18, 18, 18, 19, 19]
		let last = full ?? (34, 17)
		for let b = 0; b < last; b++ {
			let s = src[b]
			if s == -1 {
				dst[at + b] = (p[at] + p[at + 1]) / 2
			} else if s == -2 {
				dst[at + b] = (p[at + 2] + p[at + 3]) / 2
			} else {
				dst[at + b] = p[at + s]
			}
		}
	}

	// Mixing matrix values of the 20 band layout carried over to 34 bands.
	def aacPsMapVal20To34(h float[], at int) {
		let src = int[0, -1, 1, 2, -2, 3, 4, 4, 5, 5, 6, 7, 8, 8, 9, 9, 10, 11, 12, 13, 14, 14, 15, 15, 16, 16, 17, 17, 18, 18, 18, 18, 19, 19]
		let old float[]
		old.len(20)
		for let b = 0; b < 20; b++ {
			old[b] = h[at + b]
		}
		for let b = 0; b < 34; b++ {
			let s = src[b]
			if s == -1 {
				h[at + b] = (old[0] + old[1]) * 0.5
			} else if s == -2 {
				h[at + b] = (old[2] + old[3]) * 0.5
			} else {
				h[at + b] = old[s]
			}
		}
	}

	// Mixing matrix values of the 34 band layout carried over to 20 bands.
	def aacPsMapVal34To20(h float[], at int) {
		let p float[]
		p.len(34)
		for let b = 0; b < 34; b++ {
			p[b] = h[at + b]
		}
		h[at] = (2.0 * p[0] + p[1]) * 0.33333333
		h[at + 1] = (p[1] + 2.0 * p[2]) * 0.33333333
		h[at + 2] = (2.0 * p[3] + p[4]) * 0.33333333
		h[at + 3] = (p[4] + 2.0 * p[5]) * 0.33333333
		h[at + 4] = (p[6] + p[7]) * 0.5
		h[at + 5] = (p[8] + p[9]) * 0.5
		h[at + 6] = p[10]
		h[at + 7] = p[11]
		h[at + 8] = (p[12] + p[13]) * 0.5
		h[at + 9] = (p[14] + p[15]) * 0.5
		h[at + 10] = p[16]
		h[at + 11] = p[17]
		h[at + 12] = p[18]
		h[at + 13] = p[19]
		h[at + 14] = (p[20] + p[21]) * 0.5
		h[at + 15] = (p[22] + p[23]) * 0.5
		h[at + 16] = (p[24] + p[25]) * 0.5
		h[at + 17] = (p[26] + p[27]) * 0.5
		h[at + 18] = (p[28] + p[29] + p[30] + p[31]) * 0.25
		h[at + 19] = (p[32] + p[33]) * 0.5
	}
}
