internal partial module std.formats.audio.aac {
	use (
		std.math
		std.simd
	)

	// The MDCT pair of one block length (ISO/IEC 14496-3 4.6.11 and 4.6.18),
	// computed through a DCT-IV on a complex FFT of a quarter of the block.
	// Neither direction scales: the IMDCT leaves out the 2/N of the standard.
	type AacTransform {
		// Coefficients per block: 1024 for long windows, 128 for short ones.
		size     int
		preCos   float[]
		preSin   float[]
		postCos  float[]
		postSin  float[]
		twCos    float[]
		twSin    float[]
		stageCos float[]
		stageSin float[]
		reverse  int[]
		re       float[]
		im       float[]
		folded   float[]
		dct      float[]
		// For 960 and 120 coefficients the quarter-size FFT is m points of
		// radix 2 times 15 (m = 32 or 4): the m-point FFTs of the 15
		// interleaved rows, twiddles, then 15-point DFTs.
		mixed    bool
		m        int
		subRev   int[]
		subCos   float[]
		subSin   float[]
		mixCos   float[]
		mixSin   float[]
		dftCos   float[]
		dftSin   float[]
		rowRe    float[]
		rowIm    float[]

		// A transform of `size` coefficients: a power of two, 960 or 120.
		def new(size int) {
			self.size = size
			let half = size / 2
			mixed = size % 15 == 0
			preCos.len(half)
			preSin.len(half)
			postCos.len(half)
			postSin.len(half)
			for let n = 0; n < half; n++ {
				let a = -math.Pi * float(4 * n + 1) / float(4 * size)
				preCos[n] = math.cos(a)
				preSin[n] = math.sin(a)
				let b = -math.Pi * float(n) / float(size)
				postCos[n] = math.cos(b)
				postSin[n] = math.sin(b)
			}
			re.len(half)
			im.len(half)
			folded.len(size)
			dct.len(size)
			if mixed {
				setupMixed(half)
				return
			}
			twCos.len(half / 2)
			twSin.len(half / 2)
			for let k = 0; k < half / 2; k++ {
				let a = -2.0 * math.Pi * float(k) / float(half)
				twCos[k] = math.cos(a)
				twSin[k] = math.sin(a)
			}
			// Each stage's twiddles in a contiguous run: the stage of half span
			// `mid` at `mid - 1`.
			stageCos.len(half)
			stageSin.len(half)
			for let mid = 1; mid < half; mid *= 2 {
				let step = half / (2 * mid)
				for let j = 0; j < mid; j++ {
					stageCos[mid - 1 + j] = twCos[j * step]
					stageSin[mid - 1 + j] = twSin[j * step]
				}
			}
			let bits = 0
			for (1 << bits) < half {
				bits++
			}
			reverse.len(half)
			for let i = 0; i < half; i++ {
				let r = 0
				for let b = 0; b < bits; b++ {
					r = r | (((i >> b) & 1) << (bits - 1 - b))
				}
				reverse[i] = r
			}
		}

		// The tables of the m x 15 FFT of `half` points.
		def setupMixed(half int) {
			m = half / 15
			let bits = 0
			for (1 << bits) < m {
				bits++
			}
			subRev.len(m)
			for let i = 0; i < m; i++ {
				let r = 0
				for let b = 0; b < bits; b++ {
					r = r | (((i >> b) & 1) << (bits - 1 - b))
				}
				subRev[i] = r
			}
			subCos.len(m / 2)
			subSin.len(m / 2)
			for let k = 0; k < m / 2; k++ {
				let a = -2.0 * math.Pi * float(k) / float(m)
				subCos[k] = math.cos(a)
				subSin[k] = math.sin(a)
			}
			mixCos.len(half)
			mixSin.len(half)
			for let r = 0; r < 15; r++ {
				for let k = 0; k < m; k++ {
					let a = -2.0 * math.Pi * float(r * k) / float(half)
					mixCos[r * m + k] = math.cos(a)
					mixSin[r * m + k] = math.sin(a)
				}
			}
			dftCos.len(15)
			dftSin.len(15)
			for let j = 0; j < 15; j++ {
				let a = -2.0 * math.Pi * float(j) / 15.0
				dftCos[j] = math.cos(a)
				dftSin[j] = math.sin(a)
			}
			rowRe.len(half)
			rowIm.len(half)
		}

		// The FFT of re/im (natural order, `half` = 15 m points) in place.
		def fftMixed() {
			// Row r: the m-point FFT of x[15 n + r], twiddled by W^(r k).
			for let r = 0; r < 15; r++ {
				let o = r * m
				for let n = 0; n < m; n++ {
					rowRe[o + subRev[n]] = re[15 * n + r]
					rowIm[o + subRev[n]] = im[15 * n + r]
				}
				let span = 2
				for span <= m {
					let step = m / span
					let mid = span / 2
					for let start = 0; start < m; start += span {
						for let j = 0; j < mid; j++ {
							let c = subCos[j * step]
							let sn = subSin[j * step]
							let p = o + start + j
							let q = p + mid
							let tr = rowRe[q] * c - rowIm[q] * sn
							let ti = rowRe[q] * sn + rowIm[q] * c
							rowRe[q] = rowRe[p] - tr
							rowIm[q] = rowIm[p] - ti
							rowRe[p] = rowRe[p] + tr
							rowIm[p] = rowIm[p] + ti
						}
					}
					span = span * 2
				}
				for let k = 0; k < m; k++ {
					let c = mixCos[o + k]
					let sn = mixSin[o + k]
					let xr = rowRe[o + k]
					let xi = rowIm[o + k]
					rowRe[o + k] = xr * c - xi * sn
					rowIm[o + k] = xr * sn + xi * c
				}
			}
			// Column k: the 15-point DFT across the rows, to X[k + m j], four
			// columns a vector.
			for let k = 0; k < m; k += 4 {
				for let j = 0; j < 15; j++ {
					let sr = simd.splat4<float>(0.0)
					let si = simd.splat4<float>(0.0)
					for let r = 0; r < 15; r++ {
						let t = (r * j) % 15
						let c = simd.splat4<float>(dftCos[t])
						let sn = simd.splat4<float>(dftSin[t])
						let xr = simd.load4<float>(rowRe, r * m + k)
						let xi = simd.load4<float>(rowIm, r * m + k)
						sr += xr * c - xi * sn
						si += xr * sn + xi * c
					}
					simd.store4<float>(re, k + m * j, sr)
					simd.store4<float>(im, k + m * j, si)
				}
			}
		}

		// The DCT-IV of the `size` values at `at` in `x`, into `out`.
		def dct4(x float[], at int, out float[]) {
			let half = size / 2
			for let n = 0; n < half; n++ {
				let a = x[at + 2 * n]
				let b = x[at + size - 1 - 2 * n]
				let r = mixed ?? (n, reverse[n])
				re[r] = a * preCos[n] - b * preSin[n]
				im[r] = a * preSin[n] + b * preCos[n]
			}
			if mixed {
				fftMixed()
				postTwiddle(out)
				return
			}
			let span = 2
			for span <= half {
				let step = half / span
				let mid = span / 2
				if mid >= 4 {
					// Four butterflies a vector, twiddles from this stage's run of
					// the stage table.
					let w = mid - 1
					for let start = 0; start < half; start += 2 * mid {
						for let j = 0; j < mid; j += 4 {
							let wr = simd.load4<float>(stageCos, w + j)
							let wi = simd.load4<float>(stageSin, w + j)
							let p = start + j
							let q = p + mid
							let xr = simd.load4<float>(re, q)
							let xi = simd.load4<float>(im, q)
							let tr = xr * wr - xi * wi
							let ti = xr * wi + xi * wr
							let pr = simd.load4<float>(re, p)
							let pi = simd.load4<float>(im, p)
							simd.store4<float>(re, q, pr - tr)
							simd.store4<float>(im, q, pi - ti)
							simd.store4<float>(re, p, pr + tr)
							simd.store4<float>(im, p, pi + ti)
						}
					}
				} else {
					for let start = 0; start < half; start += span {
						for let j = 0; j < mid; j++ {
							let c = twCos[j * step]
							let s = twSin[j * step]
							let p = start + j
							let q = p + mid
							let tr = re[q] * c - im[q] * s
							let ti = re[q] * s + im[q] * c
							re[q] = re[p] - tr
							im[q] = im[p] - ti
							re[p] = re[p] + tr
							im[p] = im[p] + ti
						}
					}
				}
				span = span * 2
			}
			postTwiddle(out)
		}

		def postTwiddle(out float[]) {
			let half = size / 2
			for let k = 0; k < half; k++ {
				let yr = re[k] * postCos[k] - im[k] * postSin[k]
				let yi = re[k] * postSin[k] + im[k] * postCos[k]
				out[2 * k] = yr
				out[size - 1 - 2 * k] = -yi
			}
		}

		// The IMDCT of the `size` coefficients at `at` in `spec`: `2 * size`
		// samples into `out` from `outAt`.
		def inverse(spec float[], at int, out float[], outAt int) {
			dct4(spec, at, dct)
			let h = size / 2
			for let n = 0; n < h; n++ {
				out[outAt + n] = dct[n + h]
			}
			for let n = h; n < 3 * h; n++ {
				out[outAt + n] = -dct[3 * h - 1 - n]
			}
			for let n = 3 * h; n < 4 * h; n++ {
				out[outAt + n] = -dct[n - 3 * h]
			}
		}

		// The MDCT of the `2 * size` windowed samples at `at` in `x`: `size`
		// coefficients into `out`.
		def forward(x float[], at int, out float[]) {
			let h = size / 2
			for let i = 0; i < h; i++ {
				folded[i] = -x[at + size + h - 1 - i] - x[at + size + h + i]
				folded[h + i] = x[at + i] - x[at + size - 1 - i]
			}
			dct4(folded, 0, out)
		}
	}
}
