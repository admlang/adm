partial module std.formats.audio {
	use (
		std.io
		std.bytes
		std.formats.audio.aac::*
	)

	// AAC is the codec of raw AAC-LC audio in ADTS frames (`.aac`). It decodes
	// mono to 7.1; HE-AAC, AAC Main, LTP and SSR are refused. The encoder writes
	// AAC-LC with long windows.
	@codec("AAC")
	type AAC {
		// bitrate is the encoder's target in bits per second over all
		// channels; 0 picks 64000 per channel.
		bitrate int = 0

		mimeType string[] {
			def get() string[] {
				return string["audio/aac", "audio/aacp", "audio/x-aac"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".aac", ".adts"]
			}
		}

		// matchSignature reports whether the reader starts with an ADTS frame
		// header (sync 0xFFF, layer 0), after an ID3v2 tag when there is one.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(10)
			let n = io.readFull(r, head) onerror recover 0
			return false when n < 7
			let skip = adtsSkipTag(head)
			if skip > 0 {
				let rest = skip - n
				let chunk byte[]
				chunk.len(4096)
				for rest > 0 {
					let want = rest < 4096 ?? (rest, 4096)
					let got = io.readFull(r, chunk[0:want]) onerror recover 0
					return false when got < want
					rest -= got
				}
				n = io.readFull(r, head) onerror recover 0
				return false when n < 7
			}
			return adtsHeader(head[0:n], 0) is AdtsHeader
		}

		// open returns a stream decoding the ADTS audio of the reader. The file
		// is read into memory; frames are decoded as the stream is read. A
		// live stream reads one frame at a time instead.
		//
		// Fails when the reader does, it holds no ADTS frame, or the format is
		// one the decoder lacks (HE-AAC, AAC Main).
		def open(reader io.Reader, live bool = false) !AudioStream {
			if live {
				let stream = new AdtsStream(reader)
				try stream.startLive()
				return stream
			}
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			let stream = new AdtsStream(buf.bytes(), reader)
			try stream.validate()
			return stream
		}

		// info reads the format from the first frame header and the length from
		// the number of frames, without decoding.
		//
		// Fails when the reader does or it holds no ADTS frame.
		def info(reader io.Reader) !AudioInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			let stream = new AdtsStream(buf.bytes(), reader)
			fail "aac: no ADTS frame found" when stream.frames.len() == 0
			return stream.info()
		}

		// encode writes the stream as AAC-LC in ADTS frames at `bitrate`. A rate
		// ADTS cannot index is resampled to the nearest one it can; 7 channels
		// gain a silent eighth and more than 8 keep the first 8.
		//
		// Fails when the stream has no channels, or the stream or the writer
		// fails.
		def encode(stream AudioStream, writer io.Writer) !none {
			let info = stream.info()
			let inChannels = int(info.channels)
			fail "aac: the stream has no channels" when inChannels <= 0
			let channels = inChannels
			channels = 8 when channels == 7
			channels = 8 when channels > 8
			let inRate = int(info.sampleRate)
			fail "aac: the stream has no sample rate" when inRate <= 0
			let rate = aacSampleRates[aacNearestRate(inRate)]
			let target = bitrate > 0 ?? (bitrate, 64000 * channels)
			let enc = new AacEncoder(rate, channels, target)
			let resampler = new AacResampler(inRate, rate, channels)
			let buf float32[]
			buf.len(4096 * inChannels)
			let frame float32[]
			for {
				let n = try stream.read(buf)
				break when n == 0
				frame.len(n * channels)
				for let i = 0; i < n; i++ {
					for let c = 0; c < channels; c++ {
						frame[i * channels + c] = c < inChannels ?? (buf[i * inChannels + c], float32(0))
					}
				}
				try adtsWrite(writer, enc, try enc.encode(resampler.push(frame)))
			}
			try adtsWrite(writer, enc, try enc.flush())
		}
	}
}

internal partial module std.formats.audio.aac {
	use (
		std.io
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	// The fixed and variable header of one ADTS frame (ISO/IEC 14496-3
	// 1.A.2.2).
	struct AdtsHeader {
		// Audio object type: the profile plus one, 2 for AAC-LC.
		objectType    int
		rateIndex     int
		configuration int
		// The whole frame in bytes, header included.
		length        int
		// Bytes before the first raw_data_block.
		headerLength  int
		// raw_data_blocks in the frame, each 1024 frames of audio.
		blocks        int
		// Whether each block is followed by a CRC.
		protected     bool
	}

	// The ADTS header at `at` in `data`, or none when no valid one starts there.
	def adtsHeader(data byte[], at int) ?AdtsHeader {
		return none when at + 7 > data.len()
		return none unless data[at] == 0xFF && data[at + 1] & 0xF6 == 0xF0
		let protected = data[at + 1] & 1 == 0
		let rateIndex = int(data[at + 2] >> 2) & 15
		return none when rateIndex >= 13
		let configuration = (int(data[at + 2]) & 1) << 2 | int(data[at + 3]) >> 6
		let length = (int(data[at + 3]) & 3) << 11 | int(data[at + 4]) << 3 | int(data[at + 5]) >> 5
		let blocks = (int(data[at + 6]) & 3) + 1
		let headerLength = 7
		headerLength = blocks == 1 ?? (9, 9 + 2 * (blocks - 1)) when protected
		return none when length < headerLength
		return AdtsHeader{
			objectType: (int(data[at + 2]) >> 6) + 1,
			rateIndex: rateIndex,
			configuration: configuration,
			length: length,
			headerLength: headerLength,
			blocks: blocks,
			protected: protected
		}
	}

	// The AudioSpecificConfig matching an ADTS header, for `AacDecoder`.
	def adtsConfig(h AdtsHeader) byte[] {
		let v = h.objectType << 11 | h.rateIndex << 7 | h.configuration << 3
		return byte[byte(v >> 8), byte(v & 0xFF)]
	}

	// Where the audio starts: after an ID3v2 tag when the data opens with one.
	def adtsSkipTag(data byte[]) int {
		return 0 when data.len() < 10
		return 0 unless data[0] == byte('I') && data[1] == byte('D') && data[2] == byte('3')
		let size = int(data[6] & 0x7F) << 21 | int(data[7] & 0x7F) << 14 | int(data[8] & 0x7F) << 7 | int(data[9] & 0x7F)
		let footer = data[5] & 0x10 != 0 ?? (10, 0)
		return 10 + size + footer
	}

	// The offset of the first byte from `at` on that starts an ADTS header, -1
	// when none does.
	def adtsNextHeader(data byte[], at int) int {
		for let pos = at; pos + 7 <= data.len(); pos++ {
			return pos unless adtsHeader(data, pos) is none
		}
		return -1
	}

	// Bytes a live stream reads at a time, and searches for its first frame.
	const adtsLiveChunk = 4096
	const adtsLiveSearch = 1 << 16

	// The byte offset of every whole ADTS frame in `data`, from `at` on,
	// skipping bytes that do not start one.
	def adtsFrames(data byte[], at int) int[] {
		let frames int[]
		let pos = at
		for pos + 7 <= data.len() {
			let h = adtsHeader(data, pos)
			if h is none {
				pos++
				continue
			}
			break when pos + h.length > data.len()
			frames.push(pos)
			pos += h.length
		}
		return frames
	}

	// A lazy stream over an ADTS file held in memory. Each frame is decoded
	// when read.
	//
	// ADTS records no encoder delay, so the stream starts with the priming
	// frames the encoder put first: 2112 for most encoders, 1024 for
	// `AacEncoder`. A player that needs the exact start trims them itself; the
	// M4A container records the delay instead.
	type AdtsStream {
		// The frame the next read starts at.
		framePosition uint64

		data       byte[]
		frames     int[]
		// Audio frames before each ADTS frame, with the total at the end.
		starts     uint64[]
		decoder    AacDecoder
		config     byte[]
		header     AudioInfo
		source     io.Reader
		next       int
		pending    float32[]
		at         int
		dropFrames int
		closed     bool
		// A stream with no end: `data` holds only the bytes not yet decoded,
		// read from `source` as frames are needed, and seeking fails.
		live       bool
		liveEnded  bool

		// A stream over the ADTS frames of `data`, whose first frame's header
		// gives the format; `source` is closed with the stream. `validate`
		// reports whether it can be decoded.
		def new(data byte[], source io.Reader) {
			self.data = data
			self.source = source
			frames = adtsFrames(data, adtsSkipTag(data))
			starts.push(0)
			for let (_, f) in frames {
				let h = adtsHeader(data, f)
				let blocks = h is none ?? (1, h.blocks)
				starts.push(starts[starts.len() - 1] + uint64(blocks * 1024))
			}
			next = 0
			at = 0
			dropFrames = 0
			closed = false
			header = AudioInfo{codec: "aac", format: SampleFormat.Float32, bitDepth: 32, seekable: true}
			return when frames.len() == 0
			let first = adtsHeader(data, frames[0])
			return when first is none
			config = adtsConfig(first)
			decoder = new AacDecoder(config)
			header.sampleRate = uint32(decoder.sampleRate)
			header.channels = uint16(decoder.channels)
			header.frames = starts[starts.len() - 1]
			if decoder.sampleRate > 0 {
				header.length = duration(int64(header.frames) * 1000000000 / int64(decoder.sampleRate))
				let seconds = float(header.frames) / float(decoder.sampleRate)
				header.bitrate = uint32(float(data.len() - frames[0]) * 8.0 / seconds) when seconds > 0.0
			}
		}

		// A live stream over the ADTS frames `source` delivers; `startLive`
		// finds the first one.
		def new(source io.Reader) {
			self.source = source
			live = true
			next = 0
			at = 0
			dropFrames = 0
			closed = false
			starts.push(0)
			header = AudioInfo{codec: "aac", format: SampleFormat.Float32, bitDepth: 32, seekable: false}
		}

		// Finds the first frame of a live stream, one whose next frame follows
		// it, and sets the decoder up from it.
		// Fails when the reader does, no frame starts in the first 64 KiB, or
		// the format is one the decoder lacks.
		def startLive() !none {
			let passed = 0
			for {
				try fillLive(7)
				let pos = adtsNextHeader(data, 0)
				if pos < 0 {
					fail "aac: no ADTS frame found" when liveEnded || passed > adtsLiveSearch
					let drop = (data.len() - 6).max(0)
					passed += drop
					data = data[drop:]
					try fillLive(adtsLiveChunk)
					continue
				}
				passed += pos
				data = data[pos:]
				let h = adtsHeader(data, 0)
				fail "aac: damaged ADTS header" when h is none
				try fillLive(h.length + 7)
				if adtsHeader(data, h.length) is none && data.len() >= h.length + 7 {
					// A false sync: the bytes after it start no frame.
					passed++
					data = data[1:]
					continue
				}
				config = adtsConfig(h)
				decoder = new AacDecoder(config)
				header.sampleRate = uint32(decoder.sampleRate)
				header.channels = uint16(decoder.channels)
				frames.push(0)
				return validate()
			}
			return none
		}

		// Reads from the source until `data` holds `size` bytes or it ends.
		// Fails when the reader does.
		def fillLive(size int) !none {
			let chunk byte[]
			for data.len() < size && !liveEnded {
				chunk.len(adtsLiveChunk) when chunk.len() == 0
				let n = try source.read(chunk)
				if n <= 0 {
					liveEnded = true
				} else {
					data = data + chunk[:n]
				}
			}
		}

		// Decodes the next frame of a live stream and drops its bytes, passing
		// over bytes that start no frame; none at the end.
		// Fails when the reader does, or the frame is damaged.
		def nextLive() !?float32[] {
			for {
				try fillLive(7)
				let pos = adtsNextHeader(data, 0)
				if pos < 0 {
					return none when liveEnded
					data = data[(data.len() - 6).max(0):]
					try fillLive(adtsLiveChunk)
					continue
				}
				data = data[pos:]
				let h = adtsHeader(data, 0)
				return none when h is none
				try fillLive(h.length)
				return none when data.len() < h.length
				let pcm = try decodeAt(0)
				data = data[h.length:]
				return pcm
			}
			return none
		}

		// Checks the stream can be decoded at all.
		//
		// Fails when it holds no ADTS frame or its format is one the decoder
		// lacks.
		def validate() !none {
			fail "aac: no ADTS frame found" when frames.len() == 0
			fail decoder.failure when decoder.failure != ""
			fail "aac: ADTS channel configuration 0 is not supported" when decoder.channels == 0
		}

		// Info implements AudioStream.
		def info() AudioInfo {
			return header
		}

		// Decodes ADTS frame `i`, every block of it.
		def decodeFrame(i int) !float32[] {
			return decodeAt(frames[i])
		}

		// Decodes the ADTS frame at byte `pos` of `data`, every block of it.
		def decodeAt(pos int) !float32[] {
			let h = adtsHeader(data, pos)
			fail "aac: damaged ADTS header" when h is none
			let r = new AacBitReader(data[pos + h.headerLength:pos + h.length])
			return decoder.decodeBlock(r) when h.blocks == 1
			let out float32[]
			for let b = 0; b < h.blocks; b++ {
				let pcm = try decoder.decodeBlock(r)
				for let (_, v) in pcm {
					out.push(v)
				}
				r.align()
				r.skip(16) when h.protected
			}
			return out
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// Read implements AudioStream: fills `buf` with interleaved frames and
		// returns how many, 0 at the end.
		//
		// Fails when `buf` is not whole frames, the stream is closed, or a frame
		// is damaged.
		def readFrames(buf float32[]) !int {
			fail "aac: the stream is closed" when closed
			try validate()
			let channels = int(header.channels)
			fail "aac: the buffer must hold whole frames" when buf.len() % channels != 0
			let written = 0
			for written < buf.len() {
				if at >= pending.len() {
					if live {
						let decoded = try nextLive()
						break when decoded is none
						pending = decoded
						at = 0
						continue
					}
					break when next >= frames.len()
					pending = try decodeFrame(next)
					next++
					at = dropFrames * channels
					dropFrames = 0
					continue
				}
				let n = pending.len() - at
				n = buf.len() - written when n > buf.len() - written
				for let i = 0; i < n; i++ {
					buf[written + i] = pending[at + i]
				}
				written += n
				at += n
			}
			return written / channels
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// Seek implements AudioStream: positions the stream at `frame`. The
		// ADTS frame before the target is decoded again so the overlap is right.
		//
		// Fails when the stream is closed or live, or cannot be decoded.
		def seekFrame(frame uint64) !none {
			fail "aac: the stream is closed" when closed
			fail "aac: a live stream cannot seek" when live
			try validate()
			let target = frame
			target = starts[starts.len() - 1] when target > starts[starts.len() - 1]
			let i = 0
			for i + 1 < frames.len() && starts[i + 1] <= target {
				i++
			}
			decoder = new AacDecoder(config)
			if i > 0 {
				try decodeFrame(i - 1)
			}
			next = i
			pending = float32[]
			at = 0
			dropFrames = int(target - starts[i])
		}

		// Close implements io.Closer, closing the reader the stream came from.
		//
		// Fails when closing the reader does.
		def close() !none {
			return none when closed
			closed = true
			let src any = source
			if src is io.Closer {
				try src.close()
			}
		}
	}

	// The sampling frequency index of the table rate nearest `rate`.
	def aacNearestRate(rate int) int {
		let best = 0
		for let i = 1; i < 13; i++ {
			let d = (aacSampleRates[i] - rate).abs()
			best = i when d < (aacSampleRates[best] - rate).abs()
		}
		return best
	}

	// Writes each unit as one ADTS frame without CRC.
	//
	// Fails when the writer does.
	def adtsWrite(writer io.Writer, enc AacEncoder, units byte[][]) !none {
		let rateIndex = aacNearestRate(enc.sampleRate)
		let configuration = enc.channels == 8 ?? (7, enc.channels)
		for let (_, unit) in units {
			let length = unit.len() + 7
			let h byte[]
			h.len(7)
			h[0] = 0xFF
			h[1] = 0xF1
			h[2] = byte(1 << 6 | rateIndex << 2 | configuration >> 2)
			h[3] = byte((configuration & 3) << 6 | length >> 11)
			h[4] = byte((length >> 3) & 0xFF)
			h[5] = byte((length & 7) << 5 | 0x1F)
			h[6] = 0xFC
			try writer.write(h)
			try writer.write(unit)
		}
	}

	// Converts interleaved frames from one rate to another by linear
	// interpolation; equal rates pass through untouched.
	type AacResampler {
		from     int
		to       int
		channels int
		// The last input frame of the previous chunk, and the position of the
		// next output frame in input frames counted from it.
		last     float32[]
		position float
		started  bool

		// A resampler from rate `from` to rate `to`.
		def new(from int, to int, channels int) {
			self.from = from
			self.to = to
			self.channels = channels
			last.len(channels)
			last[:] = float32(0)
			position = 1.0
			started = false
		}

		// The output frames the input frames lead to.
		def push(input float32[]) float32[] {
			return input when from == to
			let frames = input.len() / channels
			let out float32[]
			let step = float(from) / float(to)
			// Input frame k sits at position k + 1; the carried frame at 0.
			if !started && frames > 0 {
				started = true
				for let c = 0; c < channels; c++ {
					last[c] = input[c]
				}
			}
			for position <= float(frames) {
				let k = int(position.floor())
				let t = float32(position - float(k))
				for let c = 0; c < channels; c++ {
					let a = k == 0 ?? (last[c], input[(k - 1) * channels + c])
					let b = k >= frames ?? (a, input[k * channels + c])
					out.push(a + (b - a) * t)
				}
				position += step
			}
			if frames > 0 {
				for let c = 0; c < channels; c++ {
					last[c] = input[(frames - 1) * channels + c]
				}
				position -= float(frames)
			}
			return out
		}
	}
}
