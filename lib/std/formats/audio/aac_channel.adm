internal partial module std.formats.audio.aac {
	use (
		std.math
		std.formats.audio::*
	)

	// Slots per window group in the per-band arrays of `AacChannel`.
	const aacBandSlots = 64

	// One decoded channel: the individual channel stream of the current access
	// unit (ISO/IEC 14496-3 4.4.2.7) and the overlap carried to the next.
	type AacChannel {
		// ics_info of the current unit.
		windowSequence   int
		windowShape      int
		previousShape    int
		maxSfb           int
		windows          int
		groups           int
		groupLength      int[]
		// Band edges of the current window length, and how many bands it has.
		bands            int[]
		bandCount        int
		// Per group and band (`group * aacBandSlots + band`): the codebook and
		// the scale factor, intensity position or noise energy.
		bookOf           int[]
		scale            int[]
		// Quantized values, then the spectrum: window `w` of a short sequence at
		// `w * 128`.
		quant            int[]
		spec             float[]
		// TNS: filters per window, then per filter (`window * 4 + filter`) the
		// band span, direction, order and LPC coefficients (21 per filter).
		tnsPresent       bool
		tnsFilters       int[]
		tnsLength        int[]
		tnsDown          bool[]
		tnsOrder         int[]
		tnsLpc           float[]
		// The second half of the last unit's windowed IMDCT.
		overlap          float[]
		// This unit's output samples.
		output           float[]
		longBands        int[]
		shortBands       int[]
		longCount        int
		shortCount       int
		tnsLongMax       int
		tnsShortMax      int
		pulseCount       int
		pulseStart       int
		pulseOffset      int[]
		pulseAmp         int[]
		// The noise generator, one per decoder, advanced in parse order.
		random           AacRandom
		block            float[]
		shortBlock       float[]
		tnsState         float[]
		tnsCoef          float[]
		tnsNext          float[]
		// The audio object type: 2 AAC-LC, 1 AAC Main (backward prediction),
		// 4 AAC LTP (long term prediction).
		objectType       int
		// Prediction data of the unit (ics_info), long windows only.
		predictorPresent bool
		predResetGroup   int
		predUsed         bool[]
		predSfbMax       int
		// AAC Main predictor state per spectral line: r0, r1, cor0, cor1,
		// var0, var1 as float32, reset before first use.
		predState        float32[]
		predReady        bool
		// LTP data of the unit and the last three half frames of output:
		// the one before this unit, this unit's, and its overlap.
		ltpPresent       bool
		ltpLag           int
		ltpCoef          float
		ltpUsed          bool[]
		ltpState         float[]
		predTime         float[]
		predFreq         float[]
		// Lines per long window (1024 or 960) and per short one (128, 120).
		frame            int
		shortLen         int

		// A channel decoding at the sampling frequency index `rateIndex`
		// with long windows of `frame` lines (1024 or 960).
		def new(rateIndex int, random AacRandom, frame int = 1024) {
			self.frame = frame
			shortLen = frame / 8
			shortCount = aacShortBandCount[rateIndex]
			if frame == 960 {
				longCount = aacLong960Count[rateIndex]
				longBands = aacLong960Offsets[aacLong960Start[rateIndex]:aacLong960Start[rateIndex] + longCount + 1].clone()
				shortBands = aacShort120Offsets[aacShort120Start[rateIndex]:aacShort120Start[rateIndex] + shortCount + 1].clone()
			} else {
				longCount = aacLongBandCount[rateIndex]
				longBands = aacLongBandOffsets[aacLongBandStart[rateIndex]:aacLongBandStart[rateIndex] + longCount + 1].clone()
				shortBands = aacShortBandOffsets[aacShortBandStart[rateIndex]:aacShortBandStart[rateIndex] + shortCount + 1].clone()
			}
			tnsLongMax = aacTnsMaxBandsLong[rateIndex]
			tnsShortMax = aacTnsMaxBandsShort[rateIndex]
			bands = longBands
			bandCount = longCount
			groupLength.len(8)
			bookOf.len(8 * aacBandSlots)
			scale.len(8 * aacBandSlots)
			quant.len(1024)
			spec.len(1024)
			tnsFilters.len(8)
			tnsLength.len(32)
			tnsDown.len(32)
			tnsOrder.len(32)
			tnsLpc.len(32 * 21)
			overlap.len(frame)
			overlap[:] = 0.0
			output.len(frame)
			pulseOffset.len(4)
			pulseAmp.len(4)
			block.len(2 * frame)
			shortBlock.len(2 * shortLen)
			tnsState.len(21)
			tnsCoef.len(21)
			tnsNext.len(21)
			self.random = random
			windowShape = 0
			previousShape = 0
			objectType = 2
			predUsed.len(41)
			predSfbMax = aacPredSfbMax[rateIndex]
			ltpUsed.len(40)
		}

		// Sets the audio object type and the state its prediction needs.
		def useObjectType(objectType int) {
			self.objectType = objectType
			if objectType == 1 {
				predState.len(frame * 6)
			} else if objectType == 4 {
				ltpState.len(3 * frame)
				predTime.len(2 * frame)
				predFreq.len(frame)
			}
		}

		// Reads ics_info (4.4.2.7, Table 4.6).
		//
		// Fails when it uses prediction, which AAC-LC lacks, or names more bands
		// than the window has.
		def readInfo(r AacBitReader) !none {
			r.skip(1)
			windowSequence = r.read(2)
			windowShape = r.read(1)
			groups = 1
			groupLength[0] = 1
			if windowSequence == aacEightShort {
				maxSfb = r.read(4)
				let grouping = r.read(7)
				for let i = 0; i < 7; i++ {
					if (grouping >> (6 - i)) & 1 == 1 {
						groupLength[groups - 1]++
					} else {
						groupLength[groups] = 1
						groups++
					}
				}
				windows = 8
				bands = shortBands
				bandCount = shortCount
				predictorPresent = false
				ltpPresent = false
			} else {
				maxSfb = r.read(6)
				predictorPresent = r.flag()
				predResetGroup = 0
				ltpPresent = false
				if predictorPresent {
					fail "aac: prediction in an AAC-LC stream" when objectType == 2
					if objectType == 1 {
						if r.flag() {
							predResetGroup = r.read(5)
							fail "aac: damaged unit: predictor reset group {predResetGroup}" when predResetGroup == 0 || predResetGroup > 30
						}
						let count = maxSfb < predSfbMax ?? (maxSfb, predSfbMax)
						for let s = 0; s < count; s++ {
							predUsed[s] = r.flag()
						}
					} else {
						ltpPresent = r.flag()
						readLtp(r) when ltpPresent
					}
				}
				windows = 1
				bands = longBands
				bandCount = longCount
			}
			fail "aac: damaged unit: {maxSfb} bands where the window has {bandCount}" when maxSfb > bandCount
		}

		// Takes the window layout of the other channel of a pair with a common
		// window.
		def shareInfo(other AacChannel) {
			windowSequence = other.windowSequence
			windowShape = other.windowShape
			maxSfb = other.maxSfb
			windows = other.windows
			groups = other.groups
			for let g = 0; g < 8; g++ {
				groupLength[g] = other.groupLength[g]
			}
			bands = other.windows == 8 ?? (shortBands, longBands)
			bandCount = other.windows == 8 ?? (shortCount, longCount)
			predictorPresent = other.predictorPresent
			predResetGroup = other.predResetGroup
			for let s = 0; s < 41; s++ {
				predUsed[s] = other.predUsed[s]
			}
			ltpPresent = false
		}

		// Reads ltp_data (Table 4.44) of a long window.
		def readLtp(r AacBitReader) {
			ltpLag = r.read(11)
			ltpCoef = aacLtpCoef[r.read(3)]
			let count = maxSfb < 40 ?? (maxSfb, 40)
			for let s = 0; s < 40; s++ {
				ltpUsed[s] = s < count && r.flag()
			}
		}

		// AAC Main backward-adaptive prediction (4.6.7): each line of the
		// predicted bands gets its predictor's estimate added, and every
		// predictor learns from the result; short windows reset them all.
		def predict() {
			if !predReady {
				for let k = 0; k < frame; k++ {
					aacResetPredictor(predState, k)
				}
				predReady = true
			}
			if windowSequence == aacEightShort {
				for let k = 0; k < frame; k++ {
					aacResetPredictor(predState, k)
				}
				return
			}
			for let s = 0; s < predSfbMax; s++ {
				let on = predictorPresent && predUsed[s]
				for let k = longBands[s]; k < longBands[s + 1]; k++ {
					spec[k] = float(aacPredict(predState, k, float32(spec[k]), on))
				}
			}
			if predResetGroup != 0 {
				for let k = predResetGroup - 1; k < frame; k += 30 {
					aacResetPredictor(predState, k)
				}
			}
		}

		// Adds the long term prediction (4.6.6): the output of past frames
		// at the coded lag, windowed like this unit and taken through the
		// MDCT and this unit's TNS, in the bands that use it.
		def applyLtp(tables AacTables, long AacTransform) {
			return unless predictorPresent && ltpPresent && windowSequence != aacEightShort
			let n = frame
			let sl = shortLen
			let edge = (n - sl) / 2
			let count = ltpLag < n ?? (ltpLag + n, 2 * n)
			for let i = 0; i < 2 * n; i++ {
				predTime[i] = i < count ?? (ltpState[i + 2 * n - ltpLag] * ltpCoef, 0.0)
			}
			if windowSequence != aacLongStop {
				let w = tables.longWindow(previousShape, n)
				for let i = 0; i < n; i++ {
					predTime[i] *= w[i]
				}
			} else {
				let w = tables.shortWindow(previousShape, n)
				for let i = 0; i < edge; i++ {
					predTime[i] = 0.0
				}
				for let i = 0; i < sl; i++ {
					predTime[edge + i] *= w[i]
				}
			}
			if windowSequence != aacLongStart {
				let w = tables.longWindow(windowShape, n)
				for let i = 0; i < n; i++ {
					predTime[n + i] *= w[n - 1 - i]
				}
			} else {
				let w = tables.shortWindow(windowShape, n)
				for let i = 0; i < sl; i++ {
					predTime[n + edge + i] *= w[sl - 1 - i]
				}
				for let i = n + edge + sl; i < 2 * n; i++ {
					predTime[i] = 0.0
				}
			}
			long.forward(predTime, 0, predFreq)
			for let k = 0; k < n; k++ {
				predFreq[k] *= 65536.0
			}
			filterTns(predFreq, false) when tnsPresent
			let count2 = maxSfb < 40 ?? (maxSfb, 40)
			for let s = 0; s < count2; s++ {
				continue unless ltpUsed[s]
				for let k = longBands[s]; k < longBands[s + 1]; k++ {
					spec[k] += predFreq[k]
				}
			}
		}

		// Moves the LTP history on by this unit's output and overlap.
		def updateLtp() {
			let n = frame
			for let i = 0; i < n; i++ {
				ltpState[i] = ltpState[i + n]
				ltpState[n + i] = output[i]
				ltpState[2 * n + i] = overlap[i]
			}
		}

		// Reads an individual_channel_stream (Table 4.50) and leaves the
		// dequantized spectrum in `spec`, noise bands filled; intensity bands are
		// left zero for the pair to fill.
		//
		// Fails when the stream is damaged or uses gain control (AAC SSR).
		def read(r AacBitReader, commonWindow bool, books AacBooks, tables AacTables) !none {
			let globalGain = r.read(8)
			try readInfo(r) unless commonWindow
			try readSections(r)
			try readScales(r, globalGain, books)
			pulseCount = 0
			if r.flag() {
				fail "aac: damaged unit: pulses in a short window" when windows == 8
				pulseCount = r.read(2) + 1
				pulseStart = r.read(6)
				fail "aac: damaged unit: pulse band out of range" when pulseStart >= bandCount
				for let i = 0; i < pulseCount; i++ {
					pulseOffset[i] = r.read(5)
					pulseAmp[i] = r.read(4)
				}
			}
			tnsPresent = r.flag()
			try readTns(r) when tnsPresent
			fail "aac: gain control (AAC SSR) is not supported" when r.flag()
			try readSpectrum(r, books)
			fail "aac: damaged unit: it ends early" when r.overrun()
			try dequantize(tables)
		}

		// Reads section_data (Table 4.52): the codebook of every band.
		def readSections(r AacBitReader) !none {
			let bits = windows == 8 ?? (3, 5)
			let escape = (1 << bits) - 1
			for let g = 0; g < groups; g++ {
				let k = 0
				for k < maxSfb {
					let book = r.read(4)
					fail "aac: damaged unit: reserved codebook 12" when book == 12
					let length = 0
					for {
						let step = r.read(bits)
						length += step
						break when step != escape
						fail "aac: damaged unit: it ends early" when r.overrun()
					}
					fail "aac: damaged unit: a section runs past the last band" when k + length > maxSfb || length == 0
					for let b = k; b < k + length; b++ {
						bookOf[g * aacBandSlots + b] = book
					}
					k += length
				}
				for let b = maxSfb; b < aacBandSlots; b++ {
					bookOf[g * aacBandSlots + b] = aacZeroBook
				}
			}
		}

		// Reads scale_factor_data (Table 4.53): scale factors, intensity
		// positions and noise energies, each coded as a difference.
		def readScales(r AacBitReader, globalGain int, books AacBooks) !none {
			let gain = globalGain
			let position = 0
			let noise = globalGain - 90
			let firstNoise = true
			for let g = 0; g < groups; g++ {
				for let b = 0; b < maxSfb; b++ {
					let i = g * aacBandSlots + b
					let book = bookOf[i]
					if book == aacZeroBook {
						scale[i] = 0
					} else if book == aacIntensityBook || book == aacIntensityBook2 {
						position += books.scalefactor.decode(r) - 60
						scale[i] = position.clamp(-155, 100)
					} else if book == aacNoiseBook {
						if firstNoise {
							firstNoise = false
							noise += r.read(9) - 256
						} else {
							noise += books.scalefactor.decode(r) - 60
						}
						scale[i] = noise.clamp(-100, 155)
					} else {
						gain += books.scalefactor.decode(r) - 60
						fail "aac: damaged unit: scale factor {gain} out of range" when gain < 0 || gain > 255
						scale[i] = gain
					}
				}
			}
		}

		// Reads tns_data (Table 4.60) and turns each filter's coefficients into
		// LPC coefficients (4.6.9.3).
		def readTns(r AacBitReader) !none {
			let short = windows == 8
			// AAC Main allows order 20 in long windows.
			let maxOrder = short ?? (7, objectType == 1 ?? (20, 12))
			for let w = 0; w < windows; w++ {
				let count = r.read(short ?? (1, 2))
				tnsFilters[w] = count
				continue when count == 0
				let resolution = r.read(1) + 3
				for let f = 0; f < count; f++ {
					let slot = w * 4 + f
					tnsLength[slot] = r.read(short ?? (4, 6))
					let order = r.read(short ?? (3, 5))
					fail "aac: damaged unit: TNS order {order} above {maxOrder}" when order > maxOrder
					tnsOrder[slot] = order
					continue when order == 0
					tnsDown[slot] = r.flag()
					let compress = r.read(1)
					let bits = resolution - compress
					let signBit = 1 << (bits - 1)
					let stepUp = (float(1 << (resolution - 1)) - 0.5) / (math.Pi / 2.0)
					let stepDown = (float(1 << (resolution - 1)) + 0.5) / (math.Pi / 2.0)
					for let i = 0; i < order; i++ {
						let v = r.read(bits)
						v -= 2 * signBit when v & signBit != 0
						tnsCoef[i] = v >= 0 ?? (math.sin(float(v) / stepUp), math.sin(float(v) / stepDown))
					}
					let lpc = slot * 21
					tnsLpc[lpc] = 1.0
					for let m = 1; m <= order; m++ {
						for let i = 1; i < m; i++ {
							tnsNext[i] = tnsLpc[lpc + i] + tnsCoef[m - 1] * tnsLpc[lpc + m - i]
						}
						for let i = 1; i < m; i++ {
							tnsLpc[lpc + i] = tnsNext[i]
						}
						tnsLpc[lpc + m] = tnsCoef[m - 1]
					}
				}
			}
		}

		// Reads spectral_data (Table 4.56) into `quant`.
		def readSpectrum(r AacBitReader, books AacBooks) !none {
			quant[:] = 0
			let window = 0
			for let g = 0; g < groups; g++ {
				for let b = 0; b < maxSfb; b++ {
					let book = bookOf[g * aacBandSlots + b]
					continue when book == aacZeroBook || book >= aacNoiseBook
					let cb = books.spectral[book]
					let dim = cb.dim
					let start = bands[b]
					let end = bands[b + 1]
					for let w = 0; w < groupLength[g]; w++ {
						let base = (window + w) * 128
						for let k = start; k < end; k += dim {
							let at = cb.huffman.decode(r) * dim
							let o = base + k
							for let d = 0; d < dim; d++ {
								quant[o + d] = cb.values[at + d]
							}
							if cb.unsigned {
								for let d = 0; d < dim; d++ {
									quant[o + d] = -quant[o + d] when quant[o + d] != 0 && r.bit() == 1
								}
								if book == 11 {
									for let d = 0; d < dim; d++ {
										let v = quant[o + d]
										continue unless v == 16 || v == -16
										let n = 4
										for r.bit() == 1 {
											n++
											fail "aac: damaged unit: escape too long" when n > 12
										}
										let magnitude = (1 << n) + r.read(n)
										quant[o + d] = v < 0 ?? (-magnitude, magnitude)
									}
								}
							}
						}
					}
				}
				window += groupLength[g]
			}
		}

		// Adds the pulses to `quant` and scales it into `spec`; noise bands get
		// scaled random values (4.6.13).
		def dequantize(tables AacTables) !none {
			if pulseCount > 0 {
				let k = longBands[pulseStart]
				for let i = 0; i < pulseCount; i++ {
					k += pulseOffset[i]
					fail "aac: damaged unit: pulse past the spectrum" when k >= frame
					quant[k] = quant[k] > 0 ?? (quant[k] + pulseAmp[i], quant[k] - pulseAmp[i])
				}
			}
			spec[:] = 0.0
			let window = 0
			for let g = 0; g < groups; g++ {
				for let b = 0; b < maxSfb; b++ {
					let i = g * aacBandSlots + b
					let book = bookOf[i]
					continue when book == aacZeroBook || book == aacIntensityBook || book == aacIntensityBook2
					let start = bands[b]
					let end = bands[b + 1]
					if book == aacNoiseBook {
						for let w = 0; w < groupLength[g]; w++ {
							fillNoise((window + w) * 128 + start, end - start, scale[i], tables)
						}
						continue
					}
					let gain = tables.pow2[scale[i] - 100 + aacPow2Zero]
					for let w = 0; w < groupLength[g]; w++ {
						let base = (window + w) * 128
						for let k = base + start; k < base + end; k++ {
							let q = quant[k]
							if q > 0 {
								fail "aac: damaged unit: value out of range" when q > aacMaxQuant
								spec[k] = tables.pow43[q] * gain
							} else if q < 0 {
								fail "aac: damaged unit: value out of range" when - q > aacMaxQuant
								spec[k] = -tables.pow43[-q] * gain
							}
						}
					}
				}
				window += groupLength[g]
			}
		}

		// Fills `count` values at `at` with random noise whose energy is
		// 2^(energy / 2) (4.6.13.3).
		def fillNoise(at int, count int, energy int, tables AacTables) {
			let total = 0.0
			for let k = at; k < at + count; k++ {
				let v = random.next()
				spec[k] = v
				total += v * v
			}
			return when total <= 0.0
			let factor = tables.pow2[energy + aacPow2Zero] / aacSqrt(total)
			for let k = at; k < at + count; k++ {
				spec[k] *= factor
			}
		}

		// Copies the noise of band `b` in group `g` from the other channel,
		// rescaled to this channel's noise energy.
		def copyNoise(other AacChannel, g int, b int, tables AacTables) {
			let start = bands[b]
			let end = bands[b + 1]
			let window = 0
			for let i = 0; i < g; i++ {
				window += groupLength[i]
			}
			for let w = 0; w < groupLength[g]; w++ {
				let base = (window + w) * 128
				let total = 0.0
				for let k = base + start; k < base + end; k++ {
					total += other.spec[k] * other.spec[k]
				}
				continue when total <= 0.0
				let factor = tables.pow2[scale[g * aacBandSlots + b] + aacPow2Zero] / aacSqrt(total)
				for let k = base + start; k < base + end; k++ {
					spec[k] = other.spec[k] * factor
				}
			}
		}

		// Applies the TNS filters to `spec` (4.6.9.3).
		def applyTns() {
			filterTns(spec, true) when tnsPresent
		}

		// Runs this unit's TNS filters over `buf`: the all-pole synthesis
		// filter when `decode`, else the all-zero analysis filter.
		def filterTns(buf float[], decode bool) {
			let maxBands = windows == 8 ?? (tnsShortMax, tnsLongMax)
			let limit = maxBands < maxSfb ?? (maxBands, maxSfb)
			for let w = 0; w < windows; w++ {
				let top = bandCount
				for let f = 0; f < tnsFilters[w]; f++ {
					let slot = w * 4 + f
					let bottom = top - tnsLength[slot]
					bottom = 0 when bottom < 0
					let order = tnsOrder[slot]
					let hi = top < limit ?? (top, limit)
					let lo = bottom < limit ?? (bottom, limit)
					top = bottom
					continue when order == 0
					let start = bands[lo]
					let end = bands[hi]
					continue when end <= start
					let lpc = slot * 21
					for let j = 0; j < order; j++ {
						tnsState[j] = 0.0
					}
					let base = w * 128
					let step = tnsDown[slot] ?? (-1, 1)
					let k = tnsDown[slot] ?? (base + end - 1, base + start)
					for let n = 0; n < end - start; n++ {
						let x = buf[k]
						let y = x
						for let j = 0; j < order; j++ {
							if decode {
								y -= tnsLpc[lpc + j + 1] * tnsState[j]
							} else {
								y += tnsLpc[lpc + j + 1] * tnsState[j]
							}
						}
						for let j = order - 1; j > 0; j-- {
							tnsState[j] = tnsState[j - 1]
						}
						tnsState[0] = decode ?? (y, x)
						buf[k] = y
						k += step
					}
				}
			}
		}

		// Turns `spec` into `output` through the IMDCT, the window sequence and
		// the overlap with the last unit (4.6.11), scaled to -1..1.
		def synthesize(tables AacTables, long AacTransform, short AacTransform) {
			let n = frame
			let sl = shortLen
			let edge = (n - sl) / 2
			let previousLong = tables.longWindow(previousShape, n)
			let currentLong = tables.longWindow(windowShape, n)
			let previousShort = tables.shortWindow(previousShape, n)
			let currentShort = tables.shortWindow(windowShape, n)
			if windowSequence == aacEightShort {
				let s = 1.0 / (float(sl) * 32768.0)
				block[:] = 0.0
				for let w = 0; w < 8; w++ {
					short.inverse(spec, w * 128, shortBlock, 0)
					let rising = w == 0 ?? (previousShort, currentShort)
					let at = edge + w * sl
					for let i = 0; i < sl; i++ {
						block[at + i] += shortBlock[i] * rising[i] * s
						block[at + sl + i] += shortBlock[sl + i] * currentShort[sl - 1 - i] * s
					}
				}
				for let i = 0; i < n; i++ {
					output[i] = overlap[i] + block[i]
					overlap[i] = block[n + i]
				}
			} else {
				let s = 1.0 / (float(n) * 32768.0)
				long.inverse(spec, 0, block, 0)
				if windowSequence == aacLongStop {
					for let i = 0; i < edge; i++ {
						output[i] = overlap[i]
					}
					for let i = edge; i < edge + sl; i++ {
						output[i] = overlap[i] + block[i] * previousShort[i - edge] * s
					}
					for let i = edge + sl; i < n; i++ {
						output[i] = overlap[i] + block[i] * s
					}
				} else {
					for let i = 0; i < n; i++ {
						output[i] = overlap[i] + block[i] * previousLong[i] * s
					}
				}
				if windowSequence == aacLongStart {
					for let i = 0; i < edge; i++ {
						overlap[i] = block[n + i] * s
					}
					for let i = edge; i < edge + sl; i++ {
						overlap[i] = block[n + i] * currentShort[edge + sl - 1 - i] * s
					}
					for let i = edge + sl; i < n; i++ {
						overlap[i] = 0.0
					}
				} else {
					for let i = 0; i < n; i++ {
						overlap[i] = block[n + i] * currentLong[n - 1 - i] * s
					}
				}
			}
			previousShape = windowShape
		}
	}

	// Scale factor bands AAC Main prediction covers, by sampling frequency
	// index (Table 4.140 onwards).
	const aacPredSfbMax = int[33, 33, 38, 40, 40, 40, 41, 41, 37, 37, 37, 34, 34, 34, 34, 34]

	// LTP coefficients (Table 4.147).
	const aacLtpCoef = float[0.570829, 0.696616, 0.813004, 0.911304, 0.984900, 1.067894, 1.194601, 1.369533]

	// A 32-bit float rounded to its top 16 bits, halves up.
	def aacFlt16Round(x float32) float32 {
		return __bitcast_f32_from_u32(uint32((int(__bitcast_u32_from_f32(x)) + 0x8000) & 0xFFFF0000))
	}

	// A 32-bit float rounded to its top 16 bits, halves up when its lowest
	// bit is set (the reference decoders' "even" rounding).
	def aacFlt16Even(x float32) float32 {
		let i = int(__bitcast_u32_from_f32(x))
		return __bitcast_f32_from_u32(uint32((i + 0x7FFF + (i & 1)) & 0xFFFF0000))
	}

	// A 32-bit float cut to its top 16 bits.
	def aacFlt16Trunc(x float32) float32 {
		return __bitcast_f32_from_u32(uint32(int(__bitcast_u32_from_f32(x)) & 0xFFFF0000))
	}

	// Resets predictor `k` of `state` (4.6.7.2).
	def aacResetPredictor(state float32[], k int) {
		let at = k * 6
		state[at] = 0.0
		state[at + 1] = 0.0
		state[at + 2] = 0.0
		state[at + 3] = 0.0
		state[at + 4] = 1.0
		state[at + 5] = 1.0
	}

	// Runs predictor `k` of `state` on the line value `x` (4.6.7.1): returns
	// the value with the estimate added when `on`, and updates the predictor
	// with it, in the 16-bit-mantissa arithmetic the standard fixes.
	def aacPredict(state float32[], k int, x float32, on bool) float32 {
		let at = k * 6
		let a float32 = 0.953125
		let alpha float32 = 0.90625
		let r0 = state[at]
		let r1 = state[at + 1]
		let cor0 = state[at + 2]
		let cor1 = state[at + 3]
		let var0 = state[at + 4]
		let var1 = state[at + 5]
		let k1 float32 = var0 > float32(1.0) ?? (cor0 * aacFlt16Even(a / var0), float32(0.0))
		let k2 float32 = var1 > float32(1.0) ?? (cor1 * aacFlt16Even(a / var1), float32(0.0))
		let pv = aacFlt16Round(k1 * r0 + k2 * r1)
		let e0 = on ?? (x + pv, x)
		let e1 = e0 - k1 * r0
		let half float32 = 0.5
		state[at + 3] = aacFlt16Trunc(alpha * cor1 + r1 * e1)
		state[at + 5] = aacFlt16Trunc(alpha * var1 + half * (r1 * r1 + e1 * e1))
		state[at + 2] = aacFlt16Trunc(alpha * cor0 + r0 * e0)
		state[at + 4] = aacFlt16Trunc(alpha * var0 + half * (r0 * r0 + e0 * e0))
		state[at + 1] = aacFlt16Trunc(a * (r0 - k1 * e0))
		state[at] = aacFlt16Trunc(a * e0)
		return e0
	}

	// The noise generator of perceptual noise substitution: the reference
	// decoder's linear congruential generator, its states read as signed
	// 32-bit values.
	type AacRandom {
		state int

		def new() {
			state = 0x1F2E3D4C
		}

		// The next value.
		def next() float {
			state = (state * 1664525 + 1013904223) & 0xFFFFFFFF
			return float(state >= 0x80000000 ?? (state - 0x100000000, state))
		}
	}
}
