internal partial module std.formats.audio.aac {
	// The AAC codec core (AAC-LC, ISO/IEC 14496-3), shared by the containers
	// that carry it: ADTS in `.aac`, MP4 in `.m4a`. The core turns one raw
	// access unit into 1024 frames and back; the containers find the units.
	//
	// Samples are interleaved in the order WAV uses (front left, front right,
	// front centre, LFE, back left, back right, then the front centre pair of
	// 7.1), not in the element order of the bitstream.

	// Syntactic elements of a raw_data_block (Table 4.85).
	const (
		aacSingleChannel = 0
		aacChannelPair   = 1
		aacCoupling      = 2
		aacLfeChannel    = 3
		aacDataStream    = 4
		aacProgramConfig = 5
		aacFill          = 6
		aacEnd           = 7
	)

	// For each channel configuration (1 to 7), where each channel in element
	// order goes in the interleaved output; configuration 7 has 8 channels.
	const aacChannelOrder = int[
		0,
		0, 1,
		2, 0, 1,
		2, 0, 1, 3,
		2, 0, 1, 3, 4,
		2, 0, 1, 4, 5, 3,
		2, 0, 1, 6, 7, 4, 5, 3
	]

	// Where configuration `n`'s entries start in `aacChannelOrder`.
	const aacChannelOrderStart = int[0, 0, 1, 3, 6, 10, 15, 21, 29]

	// The channels of each channel configuration.
	const aacConfigChannels = int[0, 1, 2, 3, 4, 5, 6, 8]

	// The sampling frequency index whose tables serve an explicit rate
	// (Table 4.82).
	def aacRateIndex(rate int) int {
		let edges = int[92017, 75132, 55426, 46009, 37566, 27713, 23004, 18783, 13856, 11502, 9391]
		for let i = 0; i < edges.len(); i++ {
			return i when rate >= edges[i]
		}
		return 11
	}
}
