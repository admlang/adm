internal partial module std.formats.audio.aac {
	use (
		std.simd
		std.formats.audio::*
	)

	// The rounding offset of the AAC quantizer, added before truncating: a
	// fractional part of 0.5946 or more rounds up.
	const aacRounding = 0.4054

	// The base 2 logarithm of x, which is positive.
	def aacLog2(x float) float {
		return float(simd.splat4<float64>(float64(x)).log2().lane(0))
	}

	// 2 raised to x.
	def aacExp2(x float) float {
		return float(simd.splat4<float64>(float64(x * 0.6931471805599453)).exp().lane(0))
	}

	// The bits the escape sequence of a codebook 11 magnitude of 16 or more
	// takes.
	def aacEscapeBits(magnitude int) int {
		let n = 4
		for (1 << (n + 1)) <= magnitude {
			n++
		}
		return 2 * n - 3
	}

	// One channel of the encoder: its long-window analysis, the rate loop's
	// quantization of one unit, and the individual_channel_stream it writes
	// (ISO/IEC 14496-3 4.4.2.7).
	type AacChannelEncoder {
		// The input of the current unit and the one before, scaled to 16-bit
		// range.
		current    float[]
		previous   float[]
		block      float[]
		// The MDCT of the unit.
		spec       float[]
		// Bands coded, and the band edges.
		maxSfb     int
		bands      int[]
		// |spec|^(3/4), the magnitude the quantizer works on.
		xr34       float[]
		// Per band: the scale factor the rate loop starts from, and the largest
		// value of `xr34`.
		baseScale  int[]
		peak       float[]
		// The chosen quantization: values, scale factor and codebook per band.
		quant      int[]
		scale      int[]
		book       int[]
		// The first scale factor sent, which global_gain carries.
		globalGain int
		// 2^(-3 (sf - 100) / 16) for every scale factor.
		step       float[]

		// A channel coding `maxSfb` of the long-window bands of the sampling
		// frequency index.
		def new(rateIndex int, maxSfb int) {
			self.maxSfb = maxSfb
			let count = aacLongBandCount[rateIndex]
			bands = aacLongBandOffsets[aacLongBandStart[rateIndex]:aacLongBandStart[rateIndex] + count + 1].clone()
			current.len(1024)
			current[:] = 0.0
			previous.len(1024)
			previous[:] = 0.0
			block.len(2048)
			spec.len(1024)
			xr34.len(1024)
			quant.len(1024)
			quant[:] = 0
			baseScale.len(64)
			peak.len(64)
			scale.len(64)
			book.len(64)
			step.len(256)
			for let s = 0; s < 256; s++ {
				step[s] = aacExp2(-3.0 * float(s - 100) / 16.0)
			}
			globalGain = 100
		}

		// Windows the previous and current input with the sine window and takes
		// the MDCT, scaled to the decoder's IMDCT; the current input then
		// becomes the previous.
		def analyze(tables AacTables, transform AacTransform) {
			let w = tables.sineLong
			for let n = 0; n < 1024; n++ {
				block[n] = previous[n] * w[n]
				block[1024 + n] = current[n] * w[1023 - n]
				previous[n] = current[n]
			}
			transform.forward(block, 0, spec)
			for let k = 0; k < 1024; k++ {
				spec[k] *= 2.0
			}
		}

		// Measures the bands of `spec` and sets the scale factor each starts
		// from: one whose quantization noise is about the same fraction of the
		// band's energy in every band.
		def prepare() {
			for let k = 0; k < 1024; k++ {
				let a = spec[k].abs()
				xr34[k] = a > 0.0 ?? (aacSqrt(a * aacSqrt(a)), 0.0)
			}
			for let b = 0; b < maxSfb; b++ {
				let energy = 0.0
				let halves = 0.0
				let top = 0.0
				for let k = bands[b]; k < bands[b + 1]; k++ {
					energy += spec[k] * spec[k]
					halves += aacSqrt(spec[k].abs())
					top = xr34[k] when xr34[k] > top
				}
				peak[b] = top
				if energy < 0.25 * float(bands[b + 1] - bands[b]) || halves <= 0.0 {
					baseScale[b] = -1
					continue
				}
				// Noise of the quantizer on a band: (4/27) 2^(3 s / 8) sum |x|^(1/2)
				// with s = sf - 100; aim it at the energy scaled by a fixed ratio.
				let width = float(bands[b + 1] - bands[b])
				let allowed = aacExp2(0.3 * aacLog2(energy / width)) * width
				baseScale[b] = 100 + int((8.0 / 3.0 * aacLog2(27.0 * allowed / (4.0 * halves))).round())
			}
		}

		// Quantizes every band with its starting scale factor plus `offset`,
		// picks the codebooks and returns the bits of the channel stream without
		// ics_info.
		def quantize(offset int, books AacBooks) int {
			let last = -1
			let bits = 8 + 3
			for let b = 0; b < maxSfb; b++ {
				book[b] = aacZeroBook
				continue when baseScale[b] < 0
				let sf = (baseScale[b] + offset).clamp(0, 255)
				// The smallest scale factor that keeps every value in range.
				for sf < 255 && peak[b] * step[sf] + aacRounding > 8191.0 {
					sf++
				}
				sf = sf.clamp(last - 60, last + 60) when last >= 0
				let largest = 0
				let f = step[sf]
				for let k = bands[b]; k < bands[b + 1]; k++ {
					let q = int(xr34[k] * f + aacRounding)
					q = 8191 when q > 8191
					quant[k] = spec[k] < 0.0 ?? (-q, q)
					largest = q when q > largest
				}
				continue when largest == 0
				if last < 0 {
					globalGain = sf
					last = sf
				}
				bits += aacScalefactorBits[sf - last + 60]
				last = sf
				scale[b] = sf
				let (choice, cost) = cheapestBook(b, largest, books)
				book[b] = choice
				bits += cost
			}
			for let b = 0; b < maxSfb; b++ {
				if book[b] == aacZeroBook {
					for let k = bands[b]; k < bands[b + 1]; k++ {
						quant[k] = 0
					}
				}
			}
			return bits + sectionBits()
		}

		// The codebook coding band `b` in the fewest bits, and those bits.
		def cheapestBook(b int, largest int, books AacBooks) (int, int) {
			let first = 11
			if largest <= 1 {
				first = 1
			} else if largest <= 2 {
				first = 3
			} else if largest <= 4 {
				first = 5
			} else if largest <= 7 {
				first = 7
			} else if largest <= 12 {
				first = 9
			}
			let best = first
			let bestBits = bookBits(b, first, books)
			if first < 11 {
				let other = bookBits(b, first + 1, books)
				if other < bestBits {
					best = first + 1
					bestBits = other
				}
			}
			return (best, bestBits)
		}

		// The bits band `b` takes in codebook `n`: codewords, signs and escapes.
		def bookBits(b int, n int, books AacBooks) int {
			let cb = books.spectral[n]
			let start = aacSpectralStart[n - 1]
			let bits = 0
			for let k = bands[b]; k < bands[b + 1]; k += cb.dim {
				bits += aacSpectralBits[start + cb.symbol(quant, k)]
				if cb.unsigned {
					for let d = 0; d < cb.dim; d++ {
						let v = quant[k + d]
						continue when v == 0
						bits++
						bits += aacEscapeBits(v.abs()) when n == 11 && v.abs() >= 16
					}
				}
			}
			return bits
		}

		// The bits of section_data for the chosen codebooks.
		def sectionBits() int {
			let bits = 0
			let b = 0
			for b < maxSfb {
				let run = 1
				for b + run < maxSfb && book[b + run] == book[b] {
					run++
				}
				bits += 4 + 5 * (run / 31 + 1)
				b += run
			}
			return bits
		}

		// Writes ics_info for a long window (Table 4.6).
		def writeInfo(w AacBitWriter) {
			w.write(0, 1)
			w.write(aacOnlyLong, 2)
			w.write(0, 1)
			w.write(maxSfb, 6)
			w.write(0, 1)
		}

		// Writes the individual_channel_stream of the last `quantize`, with
		// ics_info unless the pair shares it.
		def write(w AacBitWriter, books AacBooks, withInfo bool) {
			w.write(globalGain, 8)
			writeInfo(w) when withInfo
			let b = 0
			for b < maxSfb {
				let run = 1
				for b + run < maxSfb && book[b + run] == book[b] {
					run++
				}
				w.write(book[b], 4)
				let left = run
				for left >= 31 {
					w.write(31, 5)
					left -= 31
				}
				w.write(left, 5)
				b += run
			}
			let last = globalGain
			for let s = 0; s < maxSfb; s++ {
				continue when book[s] == aacZeroBook
				let d = scale[s] - last + 60
				w.write(aacScalefactorCodes[d], aacScalefactorBits[d])
				last = scale[s]
			}
			w.write(0, 3)
			for let s = 0; s < maxSfb; s++ {
				let n = book[s]
				continue when n == aacZeroBook
				let cb = books.spectral[n]
				let start = aacSpectralStart[n - 1]
				for let k = bands[s]; k < bands[s + 1]; k += cb.dim {
					let sym = cb.symbol(quant, k)
					w.write(aacSpectralCodes[start + sym], aacSpectralBits[start + sym])
					continue unless cb.unsigned
					for let d = 0; d < cb.dim; d++ {
						let v = quant[k + d]
						w.write(v < 0 ?? (1, 0), 1) when v != 0
					}
					continue unless n == 11
					for let d = 0; d < cb.dim; d++ {
						let v = quant[k + d].abs()
						continue when v < 16
						let e = 4
						for (1 << (e + 1)) <= v {
							e++
						}
						w.write((1 << (e - 4 + 1)) - 2, e - 4 + 1)
						w.write(v - (1 << e), e)
					}
				}
			}
		}
	}
}
