partial module std.formats.audio {
	use (
		std.testing
		std.os
		std.bytes
		std.math
		std.formats.audio.m4a::*
	)

	check "AAC tools" {
		// Cuts of the ISO/IEC 14496-26 conformance streams am00_88 (AAC Main),
		// ap05_48 (AAC LTP with SBR and parametric stereo), am05_44 (AAC
		// Main with coupling channel elements), al18_44 (every band noise
		// substituted), al17_44 (two single channel elements whose order
		// changes from unit to unit), and al04sf_48 (960-line frames). Each
		// channel's RMS matches the conformance reference output's; a missing
		// sample skips.
		def rmsOf(path string) !?float[] {
			let data = os.readFile("samples/audio/m4a/" + path) onerror recover byte[]
			return none when data.len() == 0
			let stream = try new M4A().open(new bytes.Reader(data))
			let channels = int(stream.info().channels)
			let buf float32[]
			buf.len(4096 * channels)
			let sums float[]
			sums.len(channels)
			let frames = 0
			for {
				let n = try stream.read(buf)
				break when n == 0
				for let i = 0; i < n * channels; i++ {
					let v = float(buf[i])
					sums[i % channels] += v * v
				}
				frames += n
			}
			let out float[]
			for let (_, s) in sums {
				out.push(math.sqrt(s / float(frames.max(1))))
			}
			return out
		}

		// Whether `got` holds `want`, each within 0.00001.
		def near(got ?float[], want float[]) bool {
			return true when got is none
			let g float[] = got
			return false when g.len() != want.len()
			for let i = 0; i < want.len(); i++ {
				return false when (g[i] - want[i]).abs() > 0.00001
			}
			return true
		}

		@test()
		def TestMainPrediction() !none {
			assert near(try rmsOf("aac_main.m4a"), float[0.176295])
			return none
		}

		@test()
		def TestLongTermPrediction() !none {
			assert near(try rmsOf("aac_ltp_sbr_ps.m4a"), float[0.012816, 0.019142])
			return none
		}

		@test()
		def TestCouplingChannels() !none {
			assert near(try rmsOf("aac_main_coupling.m4a"), float[0.083641, 0.097438, 0.080592, 0.0, 0.095897, 0.055553])
			return none
		}

		@test()
		def TestNoiseSubstitution() !none {
			assert near(try rmsOf("aac_pns.m4a"), float[0.017435])
			return none
		}

		@test()
		def TestElementsByTag() !none {
			assert near(try rmsOf("aac_element_order.m4a"), float[0.06984, 0.039529])
			return none
		}

		@test()
		def TestShortFrames() !none {
			assert near(try rmsOf("aac_960.m4a"), float[0.043492])
			return none
		}
	}
}
