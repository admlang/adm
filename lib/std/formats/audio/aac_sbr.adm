internal partial module std.formats.audio.aac {
	use (
		std.math
		std.simd
	)

	// Frame classes of an SBR grid (ISO/IEC 14496-3 Table 4.70).
	const aacSbrFixFix = 0
	const aacSbrFixVar = 1
	const aacSbrVarFix = 2
	const aacSbrVarVar = 3

	// The SBR Huffman books by name, indices into the `aacSbrHuff*` tables.
	const aacSbrTEnv15 = 0
	const aacSbrFEnv15 = 1
	const aacSbrTEnvBal15 = 2
	const aacSbrFEnvBal15 = 3
	const aacSbrTEnv30 = 4
	const aacSbrFEnv30 = 5
	const aacSbrTEnvBal30 = 6
	const aacSbrFEnvBal30 = 7
	const aacSbrTNoise30 = 8
	const aacSbrTNoiseBal30 = 9

	// QMF slots of the lowband the HF generator reads before the frame's
	// first slot, and the offset of the frame's slots in `xHigh`.
	const aacSbrHfGenSlots = 8
	const aacSbrEnvOffset = 2
	const aacSbrNoiseFloorOffset = 6

	// ceil(log2(i + 1)) for the bs_pointer width.
	const aacSbrCeilLog2 = int[0, 1, 2, 2, 3, 3]

	// Smoothing filter of the gains and noise levels (4.6.18.7.5).
	const aacSbrSmooth = float[0.33333333333333, 0.30150283239582, 0.21816949906249, 0.11516383427084, 0.03183050093751]

	// Largest gain the limiter allows per bs_limiter_gains: -3, 0, 3 dB and off.
	const aacSbrLimiterGains = float[0.70795, 1.0, 1.41254, 10000000000.0]

	// The ten SBR Huffman decoders, shared by every SBR element.
	type AacSbrBooks {
		books AacHuffman[]

		def new() {
			for let i = 0; i < 10; i++ {
				books.push(new AacHuffman(aacSbrHuffCodes, aacSbrHuffLengths, aacSbrHuffStart[i], aacSbrHuffCount[i]))
			}
		}

		// Reads one value of book `book`.
		def read(r AacBitReader, book int) int {
			return books[book].decode(r) + aacSbrHuffOffset[book]
		}
	}

	// The QMF modulation tables and the analysis and synthesis state they
	// share: complex exponentials of the 32-band analysis, the 64-band
	// synthesis and the 32-band (downsampled) synthesis (4.6.18.4).
	type AacSbrQmf {
		// 2 exp(iπ/64 (k + 0.5)(2n - 0.5)), entry n * 32 + k.
		anaCos float[]
		anaSin float[]
		// exp(iπ/128 (k + 0.5)(2n - 255)) / 64, entry k * 128 + n.
		synCos float[]
		synSin float[]
		// exp(iπ/64 (k + 0.5)(2n - 127.5)) / 64, entry k * 64 + n: the
		// half-rate bank sits a quarter sample later than the modulation of
		// the full-rate one would put it.
		dsCos  float[]
		dsSin  float[]
		// The 64-point DCT-IV of the 64-band synthesis.
		dct64  AacTransform

		def new() {
			dct64 = new AacTransform(64)
			anaCos.len(64 * 32)
			anaSin.len(64 * 32)
			for let n = 0; n < 64; n++ {
				for let k = 0; k < 32; k++ {
					let a = math.π / 64.0 * (float(k) + 0.5) * (2.0 * float(n) - 0.5)
					anaCos[n * 32 + k] = 2.0 * math.cos(a)
					anaSin[n * 32 + k] = 2.0 * math.sin(a)
				}
			}
			synCos.len(64 * 128)
			synSin.len(64 * 128)
			for let k = 0; k < 64; k++ {
				for let n = 0; n < 128; n++ {
					let a = math.π / 128.0 * (float(k) + 0.5) * (2.0 * float(n) - 255.0)
					synCos[k * 128 + n] = math.cos(a) / 64.0
					synSin[k * 128 + n] = math.sin(a) / 64.0
				}
			}
			dsCos.len(32 * 64)
			dsSin.len(32 * 64)
			for let k = 0; k < 32; k++ {
				for let n = 0; n < 64; n++ {
					let a = math.π / 64.0 * (float(k) + 0.5) * (2.0 * float(n) - 127.5)
					dsCos[k * 64 + n] = math.cos(a) / 64.0
					dsSin[k * 64 + n] = math.sin(a) / 64.0
				}
			}
		}
	}

	// The SBR state of one channel: its bitstream data for the frame and
	// what carries over between frames.
	type AacSbrChannel {
		frameClass      int
		addHarmonicFlag bool
		numEnv          int
		// bs_freq_res per envelope from index 1; index 0 holds the last one
		// of the previous frame.
		freqRes         int[]
		numNoise        int
		dfEnv           int[]
		dfNoise         int[]
		// bs_invf_mode of this frame (0..4) and the previous one (5..9).
		invfMode        int[]
		addHarmonic     int[]
		ampRes          int

		// Core samples of the analysis filter bank, oldest first: 288 kept
		// from the previous frame, then the 1024 of this one.
		analysis      float[]
		// The synthesis filter bank's V buffer, newest first.
		synthesis     float[]
		// l_APrev and l_A: the transient envelopes of the previous frame and
		// this one, -1 for none.
		eA            int[]
		bw            float[]
		// QMF subband samples of the last two frames, [buffer][slot][band].
		wRe           float[]
		wIm           float[]
		// HF adjuster output of the last two frames, [buffer][slot][band].
		yPos          int
		yRe           float[]
		yIm           float[]
		gTemp         float[]
		qTemp         float[]
		// Sinusoid flags per envelope from index 1, index 0 from the
		// previous frame, [envelope][band - kx].
		sIndexMapped  int[]
		// Envelope scale factors per envelope from index 1, [envelope][band].
		envFacsQ      int[]
		envFacs       float[]
		noiseFacsQ    int[]
		noiseFacs     float[]
		tEnv          int[]
		tEnvNumEnvOld int
		tQ            int[]
		indexNoise    int
		indexSine     int

		def new() {
			freqRes.len(9)
			dfEnv.len(9)
			dfNoise.len(2)
			invfMode.len(10)
			addHarmonic.len(48)
			analysis.len(288 + 1024)
			synthesis.len(1280)
			eA.len(2)
			bw.len(5)
			wRe.len(2 * 32 * 32)
			wIm.len(2 * 32 * 32)
			yRe.len(2 * 38 * 64)
			yIm.len(2 * 38 * 64)
			gTemp.len(42 * 48)
			qTemp.len(42 * 48)
			sIndexMapped.len(9 * 48)
			envFacsQ.len(9 * 48)
			envFacs.len(9 * 48)
			noiseFacsQ.len(3 * 5)
			noiseFacs.len(3 * 5)
			tEnv.len(9)
			tQ.len(3)
		}
	}

	// Spectral Band Replication of one single channel or channel pair
	// element (ISO/IEC 14496-3 4.6.18): rebuilds the upper half of the
	// spectrum from the core's lower half and the envelope data coded in the
	// element's fill data, doubling the sample rate.
	type AacSbr {
		// The output sample rate.
		sampleRate        int
		// Whether a header has been read, so frames carry SBR data.
		start             bool
		readyForDequant   bool
		reset             bool
		// The element the data was read for: `aacSingleChannel` or `aacChannelPair`.
		idAac             int
		startFreq         int
		stopFreq          int
		xoverBand         int
		freqScale         int
		alterScale        int
		noiseBands        int
		ampResHeader      int
		limiterBands      int
		limiterGains      int
		interpolFreq      int
		smoothingMode     int
		coupling          bool
		// k0, k1, k2 of the master table.
		k                 int[]
		// kx and M of the previous frame (0) and this one (1).
		kx                int[]
		m                 int[]
		kxAndMPushed      bool
		nMaster           int
		data              AacSbrChannel[]
		// Bands of the low (0) and high (1) resolution tables.
		n                 int[]
		nQ                int
		nLim              int
		fMaster           int[]
		fLow              int[]
		fHigh             int[]
		fNoise            int[]
		fLim              int[]
		numPatches        int
		patchNumSubbands  int[]
		patchStartSubband int[]
		// The lowband and the generated highband, [band][slot] over 40 slots.
		xLowRe            float[]
		xLowIm            float[]
		xHighRe           float[]
		xHighIm           float[]
		// Synthesis input per channel, [channel][slot][band] over 38 slots.
		xRe               float[]
		xIm               float[]
		alpha0Re          float[]
		alpha0Im          float[]
		alpha1Re          float[]
		alpha1Im          float[]
		// Per envelope and band from kx, [envelope][band].
		eOrigMapped       float[]
		qMapped           float[]
		sMapped           int[]
		eCurr             float[]
		qM                float[]
		sM                float[]
		gain              float[]
		// Scratch of the analysis and synthesis.
		z                 float[]
		u                 float[]
		gFilt             float[]
		qFilt             float[]
		// Input and outputs of the synthesis DCT-IVs.
		dctIn             float[]
		dctA              float[]
		dctS              float[]
		books             AacSbrBooks
		qmf               AacSbrQmf
		ps                AacPs
		// QMF slots per frame: 32, or 30 for 960-line cores.
		slots             int

		// SBR at `sampleRate` for the element `idAac`, sharing `books` and
		// `qmf` with the stream's other elements.
		def new(sampleRate int, idAac int, books AacSbrBooks, qmf AacSbrQmf, frame int = 1024) {
			self.sampleRate = sampleRate
			slots = frame / 32
			self.idAac = idAac
			self.books = books
			self.qmf = qmf
			k.len(5)
			kx.len(2)
			m.len(2)
			n.len(2)
			fMaster.len(49)
			fLow.len(25)
			fHigh.len(49)
			fNoise.len(6)
			fLim.len(30)
			patchNumSubbands.len(6)
			patchStartSubband.len(6)
			data.push(new AacSbrChannel())
			data.push(new AacSbrChannel())
			xLowRe.len(32 * 40)
			xLowIm.len(32 * 40)
			xHighRe.len(64 * 40)
			xHighIm.len(64 * 40)
			xRe.len(2 * 38 * 64)
			xIm.len(2 * 38 * 64)
			alpha0Re.len(64)
			alpha0Im.len(64)
			alpha1Re.len(64)
			alpha1Im.len(64)
			eOrigMapped.len(7 * 48)
			qMapped.len(7 * 48)
			sMapped.len(7 * 48)
			eCurr.len(7 * 48)
			qM.len(7 * 48)
			sM.len(7 * 48)
			gain.len(7 * 48)
			z.len(320)
			u.len(64)
			gFilt.len(48)
			qFilt.len(48)
			dctIn.len(128)
			dctA.len(64)
			dctS.len(64)
			ps = new AacPs()
			ps.slots = slots
			// The spec gives kx' the initial value 32.
			kx[1] = 32
			kx[0] = 32
			turnOff()
			// Parameters no header can hold, so the first header resets.
			startFreq = -1
			limiterBands = -1
		}

		// Falls back to plain upsampling until the next valid header.
		def turnOff() {
			start = false
			readyForDequant = false
			kx[1] = 32
			m[1] = 0
			data[0].eA[1] = -1
			data[1].eA[1] = -1
			startFreq = -1
			stopFreq = -1
			xoverBand = -1
			freqScale = -1
			alterScale = -1
			noiseBands = -1
		}

		// Reads the sbr_extension_data of a fill element (Table 4.64) of
		// `bytes` bytes whose extension type the reader has just passed;
		// leaves the reader after the element's payload.
		def readExtension(r AacBitReader, crc bool, bytes int, idAac int) {
			let end = r.position() + bytes * 8 - 4
			reset = false
			r.skip(10) when crc
			kx[0] = kx[1]
			m[0] = m[1]
			kxAndMPushed = true
			readHeader(r) when r.flag()
			resetTables() when reset
			readData(r, idAac) when start
			turnOff() when r.position() > end
			r.pos = end
		}

		// Reads sbr_header (Table 4.63).
		def readHeader(r AacBitReader) {
			start = true
			readyForDequant = false
			let oldStart = startFreq
			let oldStop = stopFreq
			let oldXover = xoverBand
			let oldScale = freqScale
			let oldAlter = alterScale
			let oldNoise = noiseBands
			let oldLimiter = limiterBands
			ampResHeader = r.read(1)
			startFreq = r.read(4)
			stopFreq = r.read(4)
			xoverBand = r.read(3)
			r.skip(2)
			let extra1 = r.flag()
			let extra2 = r.flag()
			if extra1 {
				freqScale = r.read(2)
				alterScale = r.read(1)
				noiseBands = r.read(2)
			} else {
				freqScale = 2
				alterScale = 1
				noiseBands = 2
			}
			reset = true when startFreq != oldStart || stopFreq != oldStop || xoverBand != oldXover || freqScale != oldScale || alterScale != oldAlter || noiseBands != oldNoise
			if extra2 {
				limiterBands = r.read(2)
				limiterGains = r.read(2)
				interpolFreq = r.read(1)
				smoothingMode = r.read(1)
			} else {
				limiterBands = 2
				limiterGains = 2
				interpolFreq = 1
				smoothingMode = 1
			}
			makeLimiterTable() when limiterBands != oldLimiter && !reset
		}

		// Rebuilds the frequency tables after a header changed them.
		def resetTables() {
			turnOff() when !makeMaster() || !makeDerived()
		}

		// The master frequency band table (4.6.18.3.2.1); false when the
		// header describes an invalid one.
		def makeMaster() bool {
			let group = -1
			if sampleRate == 16000 {
				group = 0
			} else if sampleRate == 22050 {
				group = 1
			} else if sampleRate == 24000 {
				group = 2
			} else if sampleRate == 32000 {
				group = 3
			} else if sampleRate := 44100 || 48000 || 64000 {
				group = 4
			} else if sampleRate := 88200 || 96000 || 128000 || 176400 || 192000 {
				group = 5
			}
			return false when group < 0
			let temp = sampleRate < 32000 ?? (3000, sampleRate < 64000 ?? (4000, 5000))
			let startMin = ((temp << 7) + (sampleRate >> 1)) / sampleRate
			let stopMin = ((temp << 8) + (sampleRate >> 1)) / sampleRate
			k[0] = startMin + aacSbrOffset[group * 16 + startFreq]
			if stopFreq < 14 {
				k[2] = stopMin
				let stopDk = aacSbrMakeBands(stopMin, 64, 13)
				stopDk.sort((a, b) => a < b)
				for let i = 0; i < stopFreq; i++ {
					k[2] += stopDk[i]
				}
			} else if stopFreq == 14 {
				k[2] = 2 * k[0]
			} else {
				k[2] = 3 * k[0]
			}
			k[2] = k[2].min(64)
			let maxBands = sampleRate <= 32000 ?? (48, sampleRate == 44100 ?? (35, 32))
			return false when k[2] - k[0] > maxBands || k[0] <= 0

			if freqScale == 0 {
				let dk = alterScale + 1
				nMaster = ((k[2] - k[0] + (dk & 2)) >> dk) << 1
				return false when nMaster <= 0 || xoverBand >= nMaster
				for let i = 1; i <= nMaster; i++ {
					fMaster[i] = dk
				}
				let k2diff = k[2] - k[0] - nMaster * dk
				if k2diff < 0 {
					fMaster[1]--
					fMaster[2] -= 1 when k2diff < -1
				} else if k2diff != 0 {
					fMaster[nMaster]++
				}
				fMaster[0] = k[0]
				for let i = 1; i <= nMaster; i++ {
					fMaster[i] += fMaster[i - 1]
				}
				return true
			}

			let halfBands = 7 - freqScale
			let twoRegions = 49 * k[2] > 110 * k[0]
			k[1] = twoRegions ?? (2 * k[0], k[2])
			let bands0 = aacSbrRound(float32(halfBands) * aacSbrLog2(k[1], k[0])) * 2
			return false when bands0 <= 0
			let vk0 = aacSbrMakeBands(k[0], k[1], bands0)
			vk0.sort((a, b) => a < b)
			let vdk0Max = vk0[bands0 - 1]
			let edges0 int[]
			edges0.push(k[0])
			for let i = 0; i < bands0; i++ {
				return false when vk0[i] <= 0
				edges0.push(edges0[i] + vk0[i])
			}
			if !twoRegions {
				nMaster = bands0
				return false when xoverBand >= nMaster
				for let i = 0; i <= bands0; i++ {
					fMaster[i] = edges0[i]
				}
				return true
			}
			let invWarp float32 = alterScale != 0 ?? (float32(0.76923076923076923077), float32(1.0))
			let bands1 = aacSbrRound(float32(halfBands) * invWarp * aacSbrLog2(k[2], k[1])) * 2
			return false when bands1 <= 0
			let vk1 = aacSbrMakeBands(k[1], k[2], bands1)
			let vdk1Min = vk1[0]
			for let (_, v) in vk1 {
				vdk1Min = v when v < vdk1Min
			}
			if vdk1Min < vdk0Max {
				vk1.sort((a, b) => a < b)
				let change = (vdk0Max - vk1[0]).min((vk1[bands1 - 1] - vk1[0]) >> 1)
				vk1[0] += change
				vk1[bands1 - 1] -= change
			}
			vk1.sort((a, b) => a < b)
			nMaster = bands0 + bands1
			return false when xoverBand >= nMaster || nMaster > 48
			for let i = 0; i <= bands0; i++ {
				fMaster[i] = edges0[i]
			}
			let at = k[1]
			for let i = 0; i < bands1; i++ {
				return false when vk1[i] <= 0
				at += vk1[i]
				fMaster[bands0 + 1 + i] = at
			}
			return true
		}

		// The derived frequency band tables (4.6.18.3.2.2 to 4.6.18.3.2.4)
		// and the patches; false when they are invalid.
		def makeDerived() bool {
			n[1] = nMaster - xoverBand
			n[0] = (n[1] + 1) >> 1
			for let i = 0; i <= n[1]; i++ {
				fHigh[i] = fMaster[xoverBand + i]
			}
			m[1] = fHigh[n[1]] - fHigh[0]
			kx[1] = fHigh[0]
			return false when kx[1] + m[1] > 64 || kx[1] > 32
			fLow[0] = fHigh[0]
			let odd = n[1] & 1
			for let i = 1; i <= n[0]; i++ {
				fLow[i] = fHigh[2 * i - odd]
			}
			nQ = aacSbrRound(float32(noiseBands) * aacSbrLog2(k[2], kx[1])).max(1)
			if nQ > 5 {
				nQ = 1
				return false
			}
			fNoise[0] = fLow[0]
			let temp = 0
			for let i = 1; i <= nQ; i++ {
				temp += (n[0] - temp) / (nQ + 1 - i)
				fNoise[i] = fLow[temp]
			}
			return false unless makePatches()
			makeLimiterTable()
			data[0].indexNoise = 0
			data[1].indexNoise = 0
			return true
		}

		// Patch construction of the HF generator (4.6.18.6.3); false when
		// the tables give no valid patches.
		def makePatches() bool {
			let msb = k[0]
			let usb = kx[1]
			let goal = ((1000 << 11) + (sampleRate >> 1)) / sampleRate
			numPatches = 0
			let i = 0
			if goal < kx[1] + m[1] {
				for fMaster[i] < goal {
					i++
				}
			} else {
				i = nMaster
			}
			let lastK = -1
			let lastMsb = -1
			let sb = 0
			for {
				return false when i == lastK && msb == lastMsb
				lastK = i
				lastMsb = msb
				let odd = 0
				let j = i
				for {
					sb = fMaster[j]
					odd = (sb + k[0]) & 1
					break unless sb > k[0] - 1 + msb - odd
					j--
					return false when j < 0
				}
				return false when numPatches > 5
				patchNumSubbands[numPatches] = (sb - usb).max(0)
				patchStartSubband[numPatches] = k[0] - odd - patchNumSubbands[numPatches]
				if patchNumSubbands[numPatches] > 0 {
					usb = sb
					msb = sb
					numPatches++
				} else {
					msb = kx[1]
				}
				i = nMaster when fMaster[i] - sb < 3
				break when sb == kx[1] + m[1]
			}
			numPatches-- when numPatches > 1 && patchNumSubbands[numPatches - 1] < 3
			return numPatches > 0 && numPatches <= 5
		}

		// The limiter frequency band table (4.6.18.3.2.3).
		def makeLimiterTable() {
			if limiterBands <= 0 {
				fLim[0] = fLow[0]
				fLim[1] = fLow[n[0]]
				nLim = 1
				return
			}
			let warped = float[1.32715174233856803909, 1.18509277094158210129, 1.11987160404675912501][limiterBands - 1]
			let borders int[]
			borders.push(kx[1])
			for let p = 1; p <= numPatches; p++ {
				borders.push(borders[p - 1] + patchNumSubbands[p - 1])
			}
			let all int[]
			for let i = 0; i <= n[0]; i++ {
				all.push(fLow[i])
			}
			for let p = 1; p < numPatches; p++ {
				all.push(borders[p])
			}
			all.sort((a, b) => a < b)
			nLim = n[0] + numPatches - 1
			let out = 0
			let at = 1
			for out < nLim {
				let hi = all[at]
				let lo = all[out]
				if float(hi) >= float(lo) * warped {
					out++
					all[out] = hi
					at++
				} else if hi == lo || !borders[:numPatches + 1].includes(hi) {
					at++
					nLim--
				} else if !borders[:numPatches + 1].includes(lo) {
					all[out] = hi
					at++
					nLim--
				} else {
					out++
					all[out] = hi
					at++
				}
			}
			for let i = 0; i <= nLim; i++ {
				fLim[i] = all[i]
			}
		}

		// Reads sbr_data (Table 4.65) for the element `idAac`.
		def readData(r AacBitReader, idAac int) {
			self.idAac = idAac
			readyForDequant = true
			let ok = false
			if idAac == aacSingleChannel {
				ok = readSingle(r)
			} else if idAac == aacChannelPair {
				ok = readPair(r)
			}
			if !ok {
				turnOff()
				return
			}
			if r.flag() {
				let left = r.read(4)
				left += r.read(8) when left == 15
				left *= 8
				for left > 7 {
					let id = r.read(2)
					left -= 2
					if id == 2 {
						left -= ps.read(r, left)
					} else {
						r.skip(left)
						left = 0
					}
				}
				r.skip(left) when left > 0
			}
		}

		// sbr_single_channel_element (Table 4.66).
		def readSingle(r AacBitReader) bool {
			r.skip(4) when r.flag()
			let c = data[0]
			return false unless readGrid(r, c)
			readDtdf(r, c)
			readInvf(r, c)
			return false unless readEnvelope(r, c, 0)
			return false unless readNoise(r, c, 0)
			readHarmonics(r, c)
			return true
		}

		// sbr_channel_pair_element (Table 4.67).
		def readPair(r AacBitReader) bool {
			r.skip(8) when r.flag()
			let a = data[0]
			let b = data[1]
			coupling = r.flag()
			if coupling {
				return false unless readGrid(r, a)
				copyGrid(b, a)
				readDtdf(r, a)
				readDtdf(r, b)
				readInvf(r, a)
				for let i = 0; i < 5; i++ {
					b.invfMode[5 + i] = b.invfMode[i]
					b.invfMode[i] = a.invfMode[i]
				}
				return false unless readEnvelope(r, a, 0)
				return false unless readNoise(r, a, 0)
				return false unless readEnvelope(r, b, 1)
				return false unless readNoise(r, b, 1)
			} else {
				return false unless readGrid(r, a)
				return false unless readGrid(r, b)
				readDtdf(r, a)
				readDtdf(r, b)
				readInvf(r, a)
				readInvf(r, b)
				return false unless readEnvelope(r, a, 0)
				return false unless readEnvelope(r, b, 1)
				return false unless readNoise(r, a, 0)
				return false unless readNoise(r, b, 1)
			}
			readHarmonics(r, a)
			readHarmonics(r, b)
			return true
		}

		def readHarmonics(r AacBitReader, c AacSbrChannel) {
			c.addHarmonicFlag = r.flag()
			if c.addHarmonicFlag {
				for let i = 0; i < n[1]; i++ {
					c.addHarmonic[i] = r.read(1)
				}
			}
		}

		// sbr_grid (Table 4.68); false when the grid is invalid.
		def readGrid(r AacBitReader, c AacSbrChannel) bool {
			let pointer = 0
			let trail = slots / 2
			let oldNumEnv = c.numEnv
			c.freqRes[0] = c.freqRes[c.numEnv]
			c.ampRes = ampResHeader
			c.tEnvNumEnvOld = c.tEnv[oldNumEnv]
			let frameClass = r.read(2)
			if frameClass == aacSbrFixFix {
				let count = 1 << r.read(2)
				return false when count > 5
				c.numEnv = count
				c.ampRes = 0 when count == 1
				c.tEnv[0] = 0
				c.tEnv[count] = trail
				let step = (trail + (count >> 1)) / count
				for let i = 0; i < count - 1; i++ {
					c.tEnv[i + 1] = c.tEnv[i] + step
				}
				c.freqRes[1] = r.read(1)
				for let i = 1; i < count; i++ {
					c.freqRes[i + 1] = c.freqRes[1]
				}
			} else if frameClass == aacSbrFixVar {
				trail += r.read(2)
				let relTrail = r.read(2)
				c.numEnv = relTrail + 1
				c.tEnv[0] = 0
				c.tEnv[c.numEnv] = trail
				for let i = 0; i < relTrail; i++ {
					c.tEnv[c.numEnv - 1 - i] = c.tEnv[c.numEnv - i] - 2 * r.read(2) - 2
				}
				pointer = r.read(aacSbrCeilLog2[c.numEnv])
				for let i = 0; i < c.numEnv; i++ {
					c.freqRes[c.numEnv - i] = r.read(1)
				}
			} else if frameClass == aacSbrVarFix {
				c.tEnv[0] = r.read(2)
				let relLead = r.read(2)
				c.numEnv = relLead + 1
				c.tEnv[c.numEnv] = trail
				for let i = 0; i < relLead; i++ {
					c.tEnv[i + 1] = c.tEnv[i] + 2 * r.read(2) + 2
				}
				pointer = r.read(aacSbrCeilLog2[c.numEnv])
				for let i = 0; i < c.numEnv; i++ {
					c.freqRes[i + 1] = r.read(1)
				}
			} else {
				c.tEnv[0] = r.read(2)
				trail += r.read(2)
				let relLead = r.read(2)
				let relTrail = r.read(2)
				let count = relLead + relTrail + 1
				return false when count > 5
				c.numEnv = count
				c.tEnv[count] = trail
				for let i = 0; i < relLead; i++ {
					c.tEnv[i + 1] = c.tEnv[i] + 2 * r.read(2) + 2
				}
				for let i = 0; i < relTrail; i++ {
					c.tEnv[count - 1 - i] = c.tEnv[count - i] - 2 * r.read(2) - 2
				}
				pointer = r.read(aacSbrCeilLog2[count])
				for let i = 0; i < count; i++ {
					c.freqRes[i + 1] = r.read(1)
				}
			}
			c.frameClass = frameClass
			return false when pointer > c.numEnv + 1
			for let i = 1; i <= c.numEnv; i++ {
				return false when c.tEnv[i - 1] >= c.tEnv[i]
			}
			c.numNoise = c.numEnv > 1 ?? (2, 1)
			c.tQ[0] = c.tEnv[0]
			c.tQ[c.numNoise] = c.tEnv[c.numEnv]
			if c.numNoise > 1 {
				let idx = 0
				if frameClass == aacSbrFixFix {
					idx = c.numEnv >> 1
				} else if (frameClass & 1) != 0 {
					idx = c.numEnv - (pointer - 1).max(1)
				} else if pointer == 0 {
					idx = 1
				} else if pointer == 1 {
					idx = c.numEnv - 1
				} else {
					idx = pointer - 1
				}
				c.tQ[1] = c.tEnv[idx]
			}
			c.eA[0] = c.eA[1] != oldNumEnv ?? (-1, 0)
			c.eA[1] = -1
			if (frameClass & 1) != 0 && pointer != 0 {
				c.eA[1] = c.numEnv + 1 - pointer
			} else if frameClass == aacSbrVarFix && pointer > 1 {
				c.eA[1] = pointer - 1
			}
			return true
		}

		// Gives the second channel of a coupled pair the first one's grid.
		def copyGrid(dst AacSbrChannel, src AacSbrChannel) {
			dst.freqRes[0] = dst.freqRes[dst.numEnv]
			dst.tEnvNumEnvOld = dst.tEnv[dst.numEnv]
			dst.eA[0] = dst.eA[1] != dst.numEnv ?? (-1, 0)
			for let i = 1; i < 9; i++ {
				dst.freqRes[i] = src.freqRes[i]
			}
			for let i = 0; i < 9; i++ {
				dst.tEnv[i] = src.tEnv[i]
			}
			for let i = 0; i < 3; i++ {
				dst.tQ[i] = src.tQ[i]
			}
			dst.numEnv = src.numEnv
			dst.ampRes = src.ampRes
			dst.numNoise = src.numNoise
			dst.frameClass = src.frameClass
			dst.eA[1] = src.eA[1]
		}

		// sbr_dtdf (Table 4.70).
		def readDtdf(r AacBitReader, c AacSbrChannel) {
			for let i = 0; i < c.numEnv; i++ {
				c.dfEnv[i] = r.read(1)
			}
			for let i = 0; i < c.numNoise; i++ {
				c.dfNoise[i] = r.read(1)
			}
		}

		// sbr_invf (Table 4.71): the previous frame's modes move to 5..9.
		def readInvf(r AacBitReader, c AacSbrChannel) {
			for let i = 0; i < 5; i++ {
				c.invfMode[5 + i] = c.invfMode[i]
			}
			for let i = 0; i < nQ; i++ {
				c.invfMode[i] = r.read(2)
			}
		}

		// sbr_envelope (Table 4.72) of channel `ch`; false when a value
		// leaves its range.
		def readEnvelope(r AacBitReader, c AacSbrChannel, ch int) bool {
			let delta = ch == 1 && coupling ?? (2, 1)
			let odd = n[1] & 1
			let bits = 0
			let tBook = 0
			let fBook = 0
			if coupling && ch == 1 {
				bits = c.ampRes != 0 ?? (5, 6)
				tBook = c.ampRes != 0 ?? (aacSbrTEnvBal30, aacSbrTEnvBal15)
				fBook = c.ampRes != 0 ?? (aacSbrFEnvBal30, aacSbrFEnvBal15)
			} else {
				bits = c.ampRes != 0 ?? (6, 7)
				tBook = c.ampRes != 0 ?? (aacSbrTEnv30, aacSbrTEnv15)
				fBook = c.ampRes != 0 ?? (aacSbrFEnv30, aacSbrFEnv15)
			}
			for let i = 0; i < c.numEnv; i++ {
				let cur = (i + 1) * 48
				let prev = i * 48
				let res = c.freqRes[i + 1]
				let count = n[res]
				if c.dfEnv[i] != 0 {
					for let j = 0; j < count; j++ {
						let from = j
						if res != c.freqRes[i] {
							from = res != 0 ?? ((j + odd) >> 1, j == 0 ?? (0, 2 * j - odd))
						}
						let v = c.envFacsQ[prev + from] + delta * books.read(r, tBook)
						return false when v < 0 || v > 127
						c.envFacsQ[cur + j] = v
					}
				} else {
					c.envFacsQ[cur] = delta * r.read(bits)
					for let j = 1; j < count; j++ {
						let v = c.envFacsQ[cur + j - 1] + delta * books.read(r, fBook)
						return false when v < 0 || v > 127
						c.envFacsQ[cur + j] = v
					}
				}
			}
			for let j = 0; j < 48; j++ {
				c.envFacsQ[j] = c.envFacsQ[c.numEnv * 48 + j]
			}
			return true
		}

		// sbr_noise (Table 4.73) of channel `ch`; false when a value leaves
		// its range.
		def readNoise(r AacBitReader, c AacSbrChannel, ch int) bool {
			let delta = ch == 1 && coupling ?? (2, 1)
			let tBook = coupling && ch == 1 ?? (aacSbrTNoiseBal30, aacSbrTNoise30)
			let fBook = coupling && ch == 1 ?? (aacSbrFEnvBal30, aacSbrFEnv30)
			for let i = 0; i < c.numNoise; i++ {
				let cur = (i + 1) * 5
				let prev = i * 5
				if c.dfNoise[i] != 0 {
					for let j = 0; j < nQ; j++ {
						let v = c.noiseFacsQ[prev + j] + delta * books.read(r, tBook)
						return false when v < 0 || v > 30
						c.noiseFacsQ[cur + j] = v
					}
				} else {
					c.noiseFacsQ[cur] = delta * r.read(5)
					for let j = 1; j < nQ; j++ {
						let v = c.noiseFacsQ[cur + j - 1] + delta * books.read(r, fBook)
						return false when v < 0 || v > 30
						c.noiseFacsQ[cur + j] = v
					}
				}
			}
			for let j = 0; j < 5; j++ {
				c.noiseFacsQ[j] = c.noiseFacsQ[c.numNoise * 5 + j]
			}
			return true
		}

		// Dequantizes the envelope and noise scale factors, undoing the
		// coupling of a pair (4.6.18.3.5).
		def dequant() {
			if idAac == aacChannelPair && coupling {
				let a = data[0]
				let b = data[1]
				let pan = a.ampRes != 0 ?? (12, 24)
				for let e = 1; e <= a.numEnv; e++ {
					for let i = 0; i < n[a.freqRes[e]]; i++ {
						let qa = a.envFacsQ[e * 48 + i]
						let qb = b.envFacsQ[e * 48 + i]
						let t1 = 0.0
						let t2 = 0.0
						if a.ampRes != 0 {
							t1 = aacSbrExp2(qa + 7)
							t2 = aacSbrExp2(pan - qb)
						} else {
							t1 = aacSbrExp2((qa >> 1) + 7) * ((qa & 1) != 0 ?? (math.Sqrt2, 1.0))
							t2 = aacSbrExp2((pan - qb) >> 1) * (((pan - qb) & 1) != 0 ?? (math.Sqrt2, 1.0))
						}
						t1 = 1.0 when t1 > 1e20
						let fac = t1 / (1.0 + t2)
						a.envFacs[e * 48 + i] = fac
						b.envFacs[e * 48 + i] = fac * t2
					}
				}
				for let e = 1; e <= a.numNoise; e++ {
					for let i = 0; i < nQ; i++ {
						let t1 = aacSbrExp2(aacSbrNoiseFloorOffset - a.noiseFacsQ[e * 5 + i] + 1)
						let t2 = aacSbrExp2(12 - b.noiseFacsQ[e * 5 + i])
						let fac = t1 / (1.0 + t2)
						a.noiseFacs[e * 5 + i] = fac
						b.noiseFacs[e * 5 + i] = fac * t2
					}
				}
				return
			}
			let channels = idAac == aacChannelPair ?? (2, 1)
			for let ch = 0; ch < channels; ch++ {
				let c = data[ch]
				for let e = 1; e <= c.numEnv; e++ {
					for let i = 0; i < n[c.freqRes[e]]; i++ {
						let q = c.envFacsQ[e * 48 + i]
						let v = 0.0
						if c.ampRes != 0 {
							v = aacSbrExp2(q + 6)
						} else {
							v = aacSbrExp2((q >> 1) + 6) * ((q & 1) != 0 ?? (math.Sqrt2, 1.0))
						}
						c.envFacs[e * 48 + i] = v > 1e20 ?? (1.0, v)
					}
				}
				for let e = 1; e <= c.numNoise; e++ {
					for let i = 0; i < nQ; i++ {
						c.noiseFacs[e * 5 + i] = aacSbrExp2(aacSbrNoiseFloorOffset - c.noiseFacsQ[e * 5 + i])
					}
				}
			}
		}

		// Runs SBR over the element's core output: `left` (and `right` for a
		// pair), 1024 samples each at the core rate scaled to -1..1, into
		// `outLeft` and `outRight`, `size` samples each (2048, or 1024 for
		// downsampled SBR). With parametric stereo a single channel element
		// fills both outputs.
		def apply(idAac int, left float[], right float[], outLeft float[], outRight float[], downsampled bool) {
			let channels = idAac == aacChannelPair ?? (2, 1)
			turnOff() when idAac != self.idAac
			turnOff() when start && !readyForDequant
			if !kxAndMPushed {
				kx[0] = kx[1]
				m[0] = m[1]
			} else {
				kxAndMPushed = false
			}
			if start {
				dequant()
				readyForDequant = false
			}
			for let ch = 0; ch < channels; ch++ {
				let c = data[ch]
				analyze(c, ch == 0 ?? (left, right))
				lowband(c)
				c.yPos ^= 1
				if start {
					inverseFilter()
					chirp(c)
					if generate(c) && mapping(c) {
						estimate(c)
						gains(c)
						assemble(c)
					}
				}
				gather(c, ch)
			}
			let stereo = channels == 2
			if ps.enabled {
				if ps.start {
					ps.apply(xRe, xIm, kx[1] + m[1])
				} else {
					let half = 38 * 64
					for let i = 0; i < half; i++ {
						xRe[half + i] = xRe[i]
						xIm[half + i] = xIm[i]
					}
				}
				stereo = true
			}
			synthesize(data[0], 0, outLeft, downsampled)
			synthesize(data[1], 1, outRight, downsampled) when stereo
		}

		// The 32-band analysis filter bank over the 1024 core samples of
		// `input` into this frame's `W` buffer (4.6.18.4.1).
		def analyze(c AacSbrChannel, input float[]) {
			let x = c.analysis
			let nb = slots * 32
			for let i = 0; i < 288; i++ {
				x[i] = x[i + nb]
			}
			for let i = 0; i < nb; i++ {
				x[288 + i] = input[i] * 32768.0
			}
			let w = c.yPos * 1024
			for let slot = 0; slot < slots; slot++ {
				let base = slot * 32
				// z[n] = x[n] c[2n] with x newest first.
				for let i = 0; i < 320; i++ {
					z[i] = x[base + 319 - i] * aacSbrWindow[2 * i]
				}
				for let i = 0; i < 64; i++ {
					u[i] = z[i] + z[i + 64] + z[i + 128] + z[i + 192] + z[i + 256]
				}
				let r0 = simd.splat4<float>(0.0)
				let r1 = r0
				let r2 = r0
				let r3 = r0
				let r4 = r0
				let r5 = r0
				let r6 = r0
				let r7 = r0
				let i0 = r0
				let i1 = r0
				let i2 = r0
				let i3 = r0
				let i4 = r0
				let i5 = r0
				let i6 = r0
				let i7 = r0
				for let i = 0; i < 64; i++ {
					let v = simd.splat4<float>(u[i])
					let row = i * 32
					r0 = r0 + simd.load4<float>(qmf.anaCos, row) * v
					r1 = r1 + simd.load4<float>(qmf.anaCos, row + 4) * v
					r2 = r2 + simd.load4<float>(qmf.anaCos, row + 8) * v
					r3 = r3 + simd.load4<float>(qmf.anaCos, row + 12) * v
					r4 = r4 + simd.load4<float>(qmf.anaCos, row + 16) * v
					r5 = r5 + simd.load4<float>(qmf.anaCos, row + 20) * v
					r6 = r6 + simd.load4<float>(qmf.anaCos, row + 24) * v
					r7 = r7 + simd.load4<float>(qmf.anaCos, row + 28) * v
					i0 = i0 + simd.load4<float>(qmf.anaSin, row) * v
					i1 = i1 + simd.load4<float>(qmf.anaSin, row + 4) * v
					i2 = i2 + simd.load4<float>(qmf.anaSin, row + 8) * v
					i3 = i3 + simd.load4<float>(qmf.anaSin, row + 12) * v
					i4 = i4 + simd.load4<float>(qmf.anaSin, row + 16) * v
					i5 = i5 + simd.load4<float>(qmf.anaSin, row + 20) * v
					i6 = i6 + simd.load4<float>(qmf.anaSin, row + 24) * v
					i7 = i7 + simd.load4<float>(qmf.anaSin, row + 28) * v
				}
				let at = w + slot * 32
				simd.store4<float>(c.wRe, at, r0)
				simd.store4<float>(c.wRe, at + 4, r1)
				simd.store4<float>(c.wRe, at + 8, r2)
				simd.store4<float>(c.wRe, at + 12, r3)
				simd.store4<float>(c.wRe, at + 16, r4)
				simd.store4<float>(c.wRe, at + 20, r5)
				simd.store4<float>(c.wRe, at + 24, r6)
				simd.store4<float>(c.wRe, at + 28, r7)
				simd.store4<float>(c.wIm, at, i0)
				simd.store4<float>(c.wIm, at + 4, i1)
				simd.store4<float>(c.wIm, at + 8, i2)
				simd.store4<float>(c.wIm, at + 12, i3)
				simd.store4<float>(c.wIm, at + 16, i4)
				simd.store4<float>(c.wIm, at + 20, i5)
				simd.store4<float>(c.wIm, at + 24, i6)
				simd.store4<float>(c.wIm, at + 28, i7)
			}
		}

		// The lowband of the HF generator: this frame's slots from slot 8,
		// the last 8 of the previous frame before them (4.6.18.5).
		def lowband(c AacSbrChannel) {
			xLowRe.fill(0.0)
			xLowIm.fill(0.0)
			let cur = c.yPos * 1024
			let prev = (1 - c.yPos) * 1024
			for let b = 0; b < kx[1]; b++ {
				for let i = aacSbrHfGenSlots; i < slots + aacSbrHfGenSlots; i++ {
					xLowRe[b * 40 + i] = c.wRe[cur + (i - aacSbrHfGenSlots) * 32 + b]
					xLowIm[b * 40 + i] = c.wIm[cur + (i - aacSbrHfGenSlots) * 32 + b]
				}
			}
			for let b = 0; b < kx[0]; b++ {
				for let i = 0; i < aacSbrHfGenSlots; i++ {
					xLowRe[b * 40 + i] = c.wRe[prev + (i + slots - aacSbrHfGenSlots) * 32 + b]
					xLowIm[b * 40 + i] = c.wIm[prev + (i + slots - aacSbrHfGenSlots) * 32 + b]
				}
			}
		}

		// The prediction coefficients of the inverse filtering for each
		// lowband subband below k0 (4.6.18.6.2).
		def inverseFilter() {
			for let b = 0; b < k[0]; b++ {
				let o = b * 40
				let r2re = xLowRe[o] * xLowRe[o + 2] + xLowIm[o] * xLowIm[o + 2]
				let r2im = xLowRe[o] * xLowIm[o + 2] - xLowIm[o] * xLowRe[o + 2]
				let r1re = 0.0
				let r1im = 0.0
				let r0re = 0.0
				for let i = 1; i < 38; i++ {
					let are = xLowRe[o + i]
					let aim = xLowIm[o + i]
					r0re += are * are + aim * aim
					r1re += are * xLowRe[o + i + 1] + aim * xLowIm[o + i + 1]
					r1im += are * xLowIm[o + i + 1] - aim * xLowRe[o + i + 1]
					r2re += are * xLowRe[o + i + 2] + aim * xLowIm[o + i + 2]
					r2im += are * xLowIm[o + i + 2] - aim * xLowRe[o + i + 2]
				}
				// phi[i][j] in the spec's terms.
				let p02re = r2re
				let p02im = r2im
				let p11 = r0re + xLowRe[o] * xLowRe[o] + xLowIm[o] * xLowIm[o]
				let p22 = r0re + xLowRe[o + 38] * xLowRe[o + 38] + xLowIm[o + 38] * xLowIm[o + 38]
				let p12re = r1re + xLowRe[o] * xLowRe[o + 1] + xLowIm[o] * xLowIm[o + 1]
				let p12im = r1im + xLowRe[o] * xLowIm[o + 1] - xLowIm[o] * xLowRe[o + 1]
				let p01re = r1re + xLowRe[o + 38] * xLowRe[o + 39] + xLowIm[o + 38] * xLowIm[o + 39]
				let p01im = r1im + xLowRe[o + 38] * xLowIm[o + 39] - xLowIm[o + 38] * xLowRe[o + 39]
				let dk = p11 * p22 - (p12re * p12re + p12im * p12im) / 1.000001
				if dk == 0.0 {
					alpha1Re[b] = 0.0
					alpha1Im[b] = 0.0
				} else {
					alpha1Re[b] = (p01re * p12re - p01im * p12im - p02re * p22) / dk
					alpha1Im[b] = (p01re * p12im + p01im * p12re - p02im * p22) / dk
				}
				if p22 == 0.0 {
					alpha0Re[b] = 0.0
					alpha0Im[b] = 0.0
				} else {
					alpha0Re[b] = 0.0 - (p01re + alpha1Re[b] * p12re + alpha1Im[b] * p12im) / p22
					alpha0Im[b] = 0.0 - (p01im + alpha1Im[b] * p12re - alpha1Re[b] * p12im) / p22
				}
				let a1 = alpha1Re[b] * alpha1Re[b] + alpha1Im[b] * alpha1Im[b]
				let a0 = alpha0Re[b] * alpha0Re[b] + alpha0Im[b] * alpha0Im[b]
				if a1 >= 16.0 || a0 >= 16.0 {
					alpha1Re[b] = 0.0
					alpha1Im[b] = 0.0
					alpha0Re[b] = 0.0
					alpha0Im[b] = 0.0
				}
			}
		}

		// The chirp factors per noise band (4.6.18.6.2).
		def chirp(c AacSbrChannel) {
			for let i = 0; i < nQ; i++ {
				let mode = c.invfMode[i]
				let bw = mode + c.invfMode[5 + i] == 1 ?? (0.6, float[0.0, 0.75, 0.9, 0.98][mode])
				if bw < c.bw[i] {
					bw = 0.75 * bw + 0.25 * c.bw[i]
				} else {
					bw = 0.90625 * bw + 0.09375 * c.bw[i]
				}
				c.bw[i] = bw < 0.015625 ?? (0.0, bw)
			}
		}

		// The HF generator: each patch copies lowband subbands up, filtered
		// by the prediction coefficients (4.6.18.6.3). False when a patch
		// lies below the noise table.
		def generate(c AacSbrChannel) bool {
			let b = kx[1]
			let g = 0
			let first = 2 * c.tEnv[0]
			let last = 2 * c.tEnv[c.numEnv]
			for let j = 0; j < numPatches; j++ {
				for let x = 0; x < patchNumSubbands[j]; x++ {
					let p = patchStartSubband[j] + x
					for g <= nQ && b >= fNoise[g] {
						g++
					}
					g--
					return false when g < 0
					let bw = c.bw[g]
					let a0 = alpha1Re[p] * bw * bw
					let a1 = alpha1Im[p] * bw * bw
					let a2 = alpha0Re[p] * bw
					let a3 = alpha0Im[p] * bw
					let lo = p * 40
					let hi = b * 40 + aacSbrEnvOffset
					for let i = first; i < last; i++ {
						let s = lo + i
						xHighRe[hi + i] = xLowRe[s] * a0 - xLowIm[s] * a1 + xLowRe[s + 1] * a2 - xLowIm[s + 1] * a3 + xLowRe[s + 2]
						xHighIm[hi + i] = xLowIm[s] * a0 + xLowRe[s] * a1 + xLowIm[s + 1] * a2 + xLowRe[s + 1] * a3 + xLowIm[s + 2]
					}
					b++
				}
			}
			for; b < m[1] + kx[1]; b++ {
				for let i = 0; i < 40; i++ {
					xHighRe[b * 40 + i] = 0.0
					xHighIm[b * 40 + i] = 0.0
				}
			}
			return true
		}

		// Maps the envelope and noise scale factors and the sinusoid flags
		// onto QMF subbands (4.6.18.7.2); false on tables that disagree.
		def mapping(c AacSbrChannel) bool {
			for let i = 48; i < 8 * 48; i++ {
				c.sIndexMapped[i] = 0
			}
			for let e = 0; e < c.numEnv; e++ {
				let res = c.freqRes[e + 1]
				let table = res != 0 ?? (fHigh, fLow)
				let count = n[res]
				if kx[1] != table[0] {
					turnOff()
					return false
				}
				for let i = 0; i < count; i++ {
					for let b = table[i]; b < table[i + 1]; b++ {
						eOrigMapped[e * 48 + b - kx[1]] = c.envFacs[(e + 1) * 48 + i]
					}
				}
				let q = c.numNoise > 1 && c.tEnv[e] >= c.tQ[1] ?? (1, 0)
				for let i = 0; i < nQ; i++ {
					for let b = fNoise[i]; b < fNoise[i + 1]; b++ {
						qMapped[e * 48 + b - kx[1]] = c.noiseFacs[(q + 1) * 5 + i]
					}
				}
				if c.addHarmonicFlag {
					for let i = 0; i < n[1]; i++ {
						let mid = (fHigh[i] + fHigh[i + 1]) >> 1
						let on = e >= c.eA[1] || c.sIndexMapped[mid - kx[1]] == 1
						c.sIndexMapped[(e + 1) * 48 + mid - kx[1]] = on ?? (c.addHarmonic[i], 0)
					}
				}
				for let i = 0; i < count; i++ {
					let present = 0
					for let b = table[i]; b < table[i + 1]; b++ {
						if c.sIndexMapped[(e + 1) * 48 + b - kx[1]] != 0 {
							present = 1
							break
						}
					}
					for let b = table[i]; b < table[i + 1]; b++ {
						sMapped[e * 48 + b - kx[1]] = present
					}
				}
			}
			for let i = 0; i < 48; i++ {
				c.sIndexMapped[i] = c.sIndexMapped[c.numEnv * 48 + i]
			}
			return true
		}

		// The energy of the generated highband per envelope and subband
		// (4.6.18.7.3).
		def estimate(c AacSbrChannel) {
			let kx1 = kx[1]
			for let e = 0; e < c.numEnv; e++ {
				let lo = c.tEnv[e] * 2 + aacSbrEnvOffset
				let hi = c.tEnv[e + 1] * 2 + aacSbrEnvOffset
				return when lo >= 40
				if interpolFreq != 0 {
					let scale = 0.5 / float(c.tEnv[e + 1] - c.tEnv[e])
					for let b = 0; b < m[1]; b++ {
						eCurr[e * 48 + b] = sumSquare(b + kx1, lo, hi) * scale
					}
				} else {
					let size = 2 * (c.tEnv[e + 1] - c.tEnv[e])
					let res = c.freqRes[e + 1]
					let table = res != 0 ?? (fHigh, fLow)
					for let p = 0; p < n[res]; p++ {
						let sum = 0.0
						for let b = table[p]; b < table[p + 1]; b++ {
							sum += sumSquare(b, lo, hi)
						}
						sum /= float(size * (table[p + 1] - table[p]))
						for let b = table[p]; b < table[p + 1]; b++ {
							eCurr[e * 48 + b - kx1] = sum
						}
					}
				}
			}
		}

		// The energy of highband subband `b` over slots lo..hi.
		def sumSquare(b int, lo int, hi int) float {
			let s = 0.0
			let o = b * 40
			for let i = lo; i < hi; i++ {
				s += xHighRe[o + i] * xHighRe[o + i] + xHighIm[o + i] * xHighIm[o + i]
			}
			return s
		}

		// The gains, noise and sinusoid levels with the limiter and its
		// compensation (4.6.18.7.4 and 4.6.18.7.5).
		def gains(c AacSbrChannel) {
			for let e = 0; e < c.numEnv; e++ {
				let delta = e == c.eA[1] || e == c.eA[0] ?? (0, 1)
				for let l = 0; l < nLim; l++ {
					let lo = fLim[l] - kx[1]
					let hi = fLim[l + 1] - kx[1]
					for let b = lo; b < hi; b++ {
						let i = e * 48 + b
						let orig = eOrigMapped[i]
						let q = qMapped[i]
						let temp = orig / (1.0 + q)
						qM[i] = math.sqrt(temp * q)
						sM[i] = math.sqrt(temp * float(c.sIndexMapped[(e + 1) * 48 + b]))
						if sMapped[i] == 0 {
							gain[i] = math.sqrt(orig / ((1.0 + eCurr[i]) * (1.0 + q * float(delta))))
						} else {
							gain[i] = math.sqrt(orig * q / ((1.0 + eCurr[i]) * (1.0 + q)))
						}
						gain[i] += 1.17549435e-38
					}
					let sumOrig = 0.0
					let sumCurr = 0.0
					for let b = lo; b < hi; b++ {
						sumOrig += eOrigMapped[e * 48 + b]
						sumCurr += eCurr[e * 48 + b]
					}
					let eps = 1.1920929e-07
					let gainMax = (aacSbrLimiterGains[limiterGains] * math.sqrt((eps + sumOrig) / (eps + sumCurr))).min(100000.0)
					for let b = lo; b < hi; b++ {
						let i = e * 48 + b
						let qMax = qM[i] * gainMax / gain[i]
						qM[i] = qM[i].min(qMax)
						gain[i] = gain[i].min(gainMax)
					}
					sumOrig = 0.0
					sumCurr = 0.0
					for let b = lo; b < hi; b++ {
						let i = e * 48 + b
						sumOrig += eOrigMapped[i]
						sumCurr += eCurr[i] * gain[i] * gain[i] + sM[i] * sM[i]
						sumCurr += qM[i] * qM[i] when delta != 0 && sM[i] == 0.0
					}
					let boost = math.sqrt((eps + sumOrig) / (eps + sumCurr)).min(1.584893192)
					for let b = lo; b < hi; b++ {
						let i = e * 48 + b
						gain[i] *= boost
						qM[i] *= boost
						sM[i] *= boost
					}
				}
			}
		}

		// Assembles the adjusted highband into this frame's Y buffer:
		// smoothed gains, noise and sinusoids (4.6.18.7.5).
		def assemble(c AacSbrChannel) {
			let hSl = smoothingMode != 0 ?? (0, 4)
			let kx1 = kx[1]
			let mMax = m[1]
			let noise = c.indexNoise
			let sine = c.indexSine
			let y = c.yPos * 38 * 64
			if reset {
				for let i = 0; i < hSl; i++ {
					let row = (i + 2 * c.tEnv[0]) * 48
					for let b = 0; b < mMax; b++ {
						c.gTemp[row + b] = gain[b]
						c.qTemp[row + b] = qM[b]
					}
				}
			} else if hSl != 0 {
				for let i = 0; i < 4; i++ {
					let dst = (i + 2 * c.tEnv[0]) * 48
					let src = (i + 2 * c.tEnvNumEnvOld) * 48
					for let b = 0; b < 48; b++ {
						c.gTemp[dst + b] = c.gTemp[src + b]
						c.qTemp[dst + b] = c.qTemp[src + b]
					}
				}
			}
			for let e = 0; e < c.numEnv; e++ {
				for let i = 2 * c.tEnv[e]; i < 2 * c.tEnv[e + 1]; i++ {
					let row = (hSl + i) * 48
					for let b = 0; b < mMax; b++ {
						c.gTemp[row + b] = gain[e * 48 + b]
						c.qTemp[row + b] = qM[e * 48 + b]
					}
				}
			}
			for let e = 0; e < c.numEnv; e++ {
				let transient = e == c.eA[0] || e == c.eA[1]
				for let i = 2 * c.tEnv[e]; i < 2 * c.tEnv[e + 1]; i++ {
					if hSl != 0 && !transient {
						for let b = 0; b < mMax; b++ {
							let g = 0.0
							let q = 0.0
							for let j = 0; j <= hSl; j++ {
								g += c.gTemp[(i + hSl - j) * 48 + b] * aacSbrSmooth[j]
								q += c.qTemp[(i + hSl - j) * 48 + b] * aacSbrSmooth[j]
							}
							gFilt[b] = g
							qFilt[b] = q
						}
					} else {
						for let b = 0; b < mMax; b++ {
							gFilt[b] = c.gTemp[(i + hSl) * 48 + b]
							qFilt[b] = c.qTemp[i * 48 + b]
						}
					}
					let row = y + i * 64
					for let b = 0; b < mMax; b++ {
						let s = (kx1 + b) * 40 + i + aacSbrEnvOffset
						c.yRe[row + kx1 + b] = xHighRe[s] * gFilt[b]
						c.yIm[row + kx1 + b] = xHighIm[s] * gFilt[b]
					}
					if !transient {
						// φ per sine index: (1, 0), (0, ±1), (-1, 0), (0, ∓1),
						// the imaginary sign alternating with the band.
						let sign0 = sine == 0 ?? (1.0, sine == 2 ?? (-1.0, 0.0))
						let sign1 = 0.0
						if (sine & 1) != 0 {
							sign1 = (kx1 & 1) != 0 ?? (-1.0, 1.0)
							sign1 = 0.0 - sign1 when sine == 3
						}
						let nz = noise
						for let b = 0; b < mMax; b++ {
							nz = (nz + 1) & 0x1FF
							let s = sM[e * 48 + b]
							if s != 0.0 {
								c.yRe[row + kx1 + b] += s * sign0
								c.yIm[row + kx1 + b] += s * sign1
							} else {
								c.yRe[row + kx1 + b] += qFilt[b] * aacSbrNoise[2 * nz]
								c.yIm[row + kx1 + b] += qFilt[b] * aacSbrNoise[2 * nz + 1]
							}
							sign1 = 0.0 - sign1
						}
					} else {
						let idx = sine & 1
						let a = 1 - ((sine + (kx1 & 1)) & 2)
						let bSign = idx == 0 ?? (a, 0 - a)
						for let b = 0; b < mMax; b++ {
							let s = sM[e * 48 + b] * float((b & 1) == 0 ?? (a, bSign))
							if idx == 0 {
								c.yRe[row + kx1 + b] += s
							} else {
								c.yIm[row + kx1 + b] += s
							}
						}
					}
					noise = (noise + mMax) & 0x1FF
					sine = (sine + 1) & 3
				}
			}
			c.indexNoise = noise
			c.indexSine = sine
		}

		// Builds the synthesis input of channel `ch` from the lowband and
		// the adjusted highband of this frame and the last (4.6.18.8).
		def gather(c AacSbrChannel, ch int) {
			let base = ch * 38 * 64
			let prevY = (1 - c.yPos) * 38 * 64
			let curY = c.yPos * 38 * 64
			let temp = (2 * c.tEnvNumEnvOld - slots).max(0)
			for let i = 0; i < 38 * 64; i++ {
				xRe[base + i] = 0.0
				xIm[base + i] = 0.0
			}
			let b = 0
			for; b < kx[0]; b++ {
				for let i = 0; i < temp; i++ {
					xRe[base + i * 64 + b] = xLowRe[b * 40 + i + aacSbrEnvOffset]
					xIm[base + i * 64 + b] = xLowIm[b * 40 + i + aacSbrEnvOffset]
				}
			}
			for; b < kx[0] + m[0]; b++ {
				for let i = 0; i < temp; i++ {
					xRe[base + i * 64 + b] = c.yRe[prevY + (i + slots) * 64 + b]
					xIm[base + i * 64 + b] = c.yIm[prevY + (i + slots) * 64 + b]
				}
			}
			b = 0
			for; b < kx[1]; b++ {
				for let i = temp; i < 38; i++ {
					xRe[base + i * 64 + b] = xLowRe[b * 40 + i + aacSbrEnvOffset]
					xIm[base + i * 64 + b] = xLowIm[b * 40 + i + aacSbrEnvOffset]
				}
			}
			for; b < kx[1] + m[1]; b++ {
				for let i = temp; i < slots; i++ {
					xRe[base + i * 64 + b] = c.yRe[curY + i * 64 + b]
					xIm[base + i * 64 + b] = c.yIm[curY + i * 64 + b]
				}
			}
		}

		// The 64-band synthesis filter bank of channel `ch` into `out`, 2048
		// samples scaled to -1..1; with `downsampled` the 32-band one, 1024
		// samples (4.6.18.4.2 and 4.6.18.4.3).
		def synthesize(c AacSbrChannel, ch int, out float[], downsampled bool) {
			let v = c.synthesis
			let base = ch * 38 * 64
			let scale = 1.0 / 32768.0
			if downsampled {
				for let slot = 0; slot < slots; slot++ {
					for let i = 639; i >= 64; i-- {
						v[i] = v[i - 64]
					}
					let row = base + slot * 64
					for let i = 0; i < 64; i += 4 {
						let acc = simd.splat4<float>(0.0)
						for let b = 0; b < 32; b++ {
							let at = b * 64 + i
							acc = acc + simd.splat4<float>(xRe[row + b]) * simd.load4<float>(qmf.dsCos, at) - simd.splat4<float>(xIm[row + b]) * simd.load4<float>(qmf.dsSin, at)
						}
						simd.store4<float>(v, i, acc)
					}
					let o = slot * 32
					for let i = 0; i < 32; i++ {
						let s = 0.0
						for let j = 0; j < 5; j++ {
							s += v[128 * j + i] * aacSbrWindow[2 * (64 * j + i)]
							s += v[128 * j + 96 + i] * aacSbrWindow[2 * (64 * j + 32 + i)]
						}
						out[o + i] = s * scale
					}
				}
				return
			}
			for let slot = 0; slot < slots; slot++ {
				for let i = 1279; i >= 128; i-- {
					v[i] = v[i - 128]
				}
				// v[n] = (S[n] - A[n]) / 64 and v[127 - n] = (A[n] + S[n]) / 64
				// for n < 64, with A the DCT-IV of the real parts and S the
				// DST-IV of the imaginary ones: (-1)^n times the DCT-IV of
				// them reversed.
				let row = base + slot * 64
				for let b = 0; b < 64; b++ {
					dctIn[b] = xRe[row + b]
					dctIn[64 + b] = xIm[row + 63 - b]
				}
				qmf.dct64.dct4(dctIn, 0, dctA)
				qmf.dct64.dct4(dctIn, 64, dctS)
				for let i = 0; i < 64; i++ {
					let a = dctA[i]
					let sv = (i & 1) == 0 ?? (dctS[i], 0.0 - dctS[i])
					v[i] = (sv - a) * (1.0 / 64.0)
					v[127 - i] = (a + sv) * (1.0 / 64.0)
				}
				let o = slot * 64
				for let i = 0; i < 64; i += 4 {
					let s = simd.splat4<float>(0.0)
					for let j = 0; j < 5; j++ {
						s = s + simd.load4<float>(v, 256 * j + i) * simd.load4<float>(aacSbrWindow, 128 * j + i)
						s = s + simd.load4<float>(v, 256 * j + 192 + i) * simd.load4<float>(aacSbrWindow, 128 * j + 64 + i)
					}
					simd.store4<float>(out, o + i, s * simd.splat4<float>(scale))
				}
			}
		}
	}

	// 2^x for an integer x.
	def aacSbrExp2(x int) float {
		return 2.0 ** float(x)
	}

	// log2(a / b) in single precision, as the reference decoders compute
	// the band counts.
	def aacSbrLog2(a int, b int) float32 {
		return float32(math.log2(float(float32(a) / float32(b))))
	}

	// Rounds to the nearest integer, halves to even.
	def aacSbrRound(x float32) int {
		let f = float(x)
		let r = f.floor()
		let d = f - r
		if d > 0.5 || (d == 0.5 && (int(r) & 1) != 0) {
			r += 1.0
		}
		return int(r)
	}

	// The widths of `count` bands spaced logarithmically from `start` to
	// `stop` (4.6.18.3.2.1).
	def aacSbrMakeBands(start int, stop int, count int) int[] {
		let bands int[]
		bands.len(count)
		let base = float32(float(float32(stop) / float32(start)) ** (1.0 / float(count)))
		let prod = float32(start)
		let previous = start
		for let i = 0; i < count - 1; i++ {
			prod *= base
			let present = aacSbrRound(prod)
			bands[i] = present - previous
			previous = present
		}
		bands[count - 1] = stop - previous
		return bands
	}
}
