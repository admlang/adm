partial module std.formats.audio {
	use (
		std.testing
		std.os
		std.bytes
		std.math
		std.formats.audio.aac::*
		std.formats.audio.m4a::*
	)

	check "HE-AAC" {
		// Cuts of the ISO/IEC 14496-26 conformance streams al_sbr_cm_48_2
		// (SBR), al_sbr_sr_48_2_fsaac48 (downsampled SBR), al_sbr_cm_48_5.1
		// (SBR with a program config) and al_sbr_ps_04 (parametric stereo),
		// the last also remuxed to ADTS, where SBR and PS are implicit and
		// the program config sits in the first frame. The expected samples
		// come from the conformance reference output; a missing sample
		// skips.
		def sample(path string) ?byte[] {
			let d = os.readFile("samples/audio/" + path)
			return none when d is error
			return d
		}

		// Every frame of the stream.
		def decodeAll(stream AudioStream) !float32[] {
			let channels = int(stream.info().channels)
			let buf float32[]
			buf.len(4096 * channels)
			let out float32[]
			for {
				let n = try stream.read(buf)
				break when n == 0
				for let i = 0; i < n * channels; i++ {
					out.push(buf[i])
				}
			}
			return out
		}

		// Whether the samples from `at` round to `want` at 16 bits, give or
		// take one step.
		def matches(got float32[], at int, want int[]) bool {
			for let i = 0; i < want.len(); i++ {
				let v = int((float(got[at + i]) * 32768.0).round())
				return false when (v - want[i]).abs() > 1
			}
			return true
		}

		// Root mean square of channel `c` of `channels`.
		def rms(got float32[], c int, channels int) float {
			let sum = 0.0
			let n = got.len() / channels
			for let i = 0; i < n; i++ {
				let v = float(got[i * channels + c])
				sum += v * v
			}
			return math.sqrt(sum / float(n.max(1)))
		}

		@test()
		def TestSbrStereo() !none {
			let data = sample("m4a/he_aac_sbr.m4a")
			return none when data is none
			let stream = try new M4A().open(new bytes.Reader(data))
			assert stream.info().sampleRate == 48000 && stream.info().channels == 2
			let got = try decodeAll(stream)
			assert got.len() == 98304 // 2048 frames per access unit
			assert matches(got, 56890, int[2218, 2219, 2198, 2197])
			assert matches(got, 81416, int[-2887, -2888, -2880, -2880])
			assert (rms(got, 0, 2) - 0.025813).abs() < 0.00001
			assert (rms(got, 1, 2) - 0.025491).abs() < 0.00001
			return none
		}

		@test()
		def TestDownsampledSbr() !none {
			let data = sample("m4a/he_aac_sbr_downsampled.m4a")
			return none when data is none
			let stream = try new M4A().open(new bytes.Reader(data))
			// SBR at the core's own rate: 1024 frames per unit at 48 kHz.
			assert stream.info().sampleRate == 48000
			let got = try decodeAll(stream)
			assert got.len() == 96256
			assert matches(got, 56828, int[496, 521, 492, 502])
			assert matches(got, 77184, int[10164, 10539, 10364, 10142])
			assert (rms(got, 0, 2) - 0.056926).abs() < 0.00001
			return none
		}

		@test()
		def TestSbrWithProgramConfig() !none {
			let data = sample("m4a/he_aac_51.m4a")
			return none when data is none
			let stream = try new M4A().open(new bytes.Reader(data))
			assert stream.info().channels == 6
			let got = try decodeAll(stream)
			// The program config lists centre, inner pair, outer pair and LFE:
			// out come front left, right, centre, LFE and the inner pair.
			let want = float[0.02607, 0.024147, 0.049541, 0.003627, 0.092438, 0.089511]
			for let c = 0; c < 6; c++ {
				assert (rms(got, c, 6) - want[c]).abs() < 0.00001 // channel {c}
			}
			return none
		}

		@test()
		def TestParametricStereo() !none {
			for let (_, path) in string["m4a/he_aac_v2_ps.m4a", "aac/he_aac_v2_ps.aac"] {
				let data = sample(path)
				continue when data is none
				let stream = path.endsWith(".aac") ?? (try new AAC().open(new bytes.Reader(data)), try new M4A().open(new bytes.Reader(data)))
				// A mono core decodes to two channels at twice its rate.
				assert stream.info().sampleRate == 32000 && stream.info().channels == 2
				let got = try decodeAll(stream)
				assert got.len() == 434176
				assert matches(got, 133410, int[3323, 3323, 2088, 2088])
				assert matches(got, 239642, int[-3325, -3199, -3314, -3232])
				assert (rms(got, 0, 2) - 0.066296).abs() < 0.00001
				assert (rms(got, 1, 2) - 0.066328).abs() < 0.00001
			}
			return none
		}

		@test()
		def TestSeekWithSbr() !none {
			let data = sample("aac/he_aac_v2_ps.aac")
			return none when data is none
			let whole = try decodeAll(try new AAC().open(new bytes.Reader(data)))
			let stream = try new AAC().open(new bytes.Reader(data))
			try stream.seek(uint64(100000))
			let buf float32[]
			buf.len(64)
			let n = try stream.read(buf)
			assert n == 32
			for let i = 0; i < 64; i++ {
				assert (buf[i] - whole[200000 + i]).abs() < 0.0001 // same samples as reading through
			}
			return none
		}
	}
}
