internal partial module std.formats.audio.aac {
	use (
		std.math
		std.simd
	)

	// Window sequences of an individual channel stream (Table 4.44).
	const (
		aacOnlyLong   = 0
		aacLongStart  = 1
		aacEightShort = 2
		aacLongStop   = 3
	)

	// Band codebooks with a meaning of their own (Table 4.45).
	const (
		aacZeroBook       = 0
		aacNoiseBook      = 13
		aacIntensityBook2 = 14
		aacIntensityBook  = 15
	)

	// The offset `aacPow2` subtracts from a quarter-power exponent.
	const aacPow2Zero = 512

	// The largest quantized magnitude, after pulses are added.
	const aacMaxQuant = 8191 + 15

	// Numeric tables shared by the decoder and the encoder, computed once.
	type AacTables {
		// |q|^(4/3) for every quantized magnitude.
		pow43     float[]
		// 2^((i - aacPow2Zero) / 4).
		pow2      float[]
		// Rising halves of the windows: sine and KBD, long (1024) and short (128).
		sineLong  float[]
		sineShort float[]
		kbdLong   float[]
		kbdShort  float[]

		// Computes every table.
		def new() {
			pow43.len(aacMaxQuant + 1)
			for let i = 0; i <= aacMaxQuant; i++ {
				pow43[i] = float(i) * aacCbrt(float(i))
			}
			pow2.len(2 * aacPow2Zero)
			let roots = float[1.0, 1.189207115002721, 1.4142135623730951, 1.681792830507429]
			for let i = 0; i < 2 * aacPow2Zero; i++ {
				let e = i - aacPow2Zero
				let whole = e >> 2
				let v = roots[e & 3]
				for let k = 0; k < whole; k++ {
					v *= 2.0
				}
				for let k = 0; k > whole; k-- {
					v *= 0.5
				}
				pow2[i] = v
			}
			sineLong = aacSineWindow(1024)
			sineShort = aacSineWindow(128)
			kbdLong = aacKbdWindow(1024, 4.0)
			kbdShort = aacKbdWindow(128, 6.0)
		}

		// The rising half of the long window of the shape: 0 sine, 1 KBD.
		def longWindow(shape int) float[] {
			return shape == 1 ?? (kbdLong, sineLong)
		}

		// The rising half of the short window of the shape: 0 sine, 1 KBD.
		def shortWindow(shape int) float[] {
			return shape == 1 ?? (kbdShort, sineShort)
		}
	}

	// The square root of x, 0 for x of zero or less.
	def aacSqrt(x float) float {
		return 0.0 when x <= 0.0
		return float(simd.splat4<float64>(float64(x)).sqrt().lane(0))
	}

	// The cube root of x, which is not negative.
	def aacCbrt(x float) float {
		return 0.0 when x <= 0.0
		let y = x > 1.0 ?? (x / 3.0 + 1.0, 1.0)
		for let i = 0; i < 200; i++ {
			let next = (2.0 * y + x / (y * y)) / 3.0
			break when next >= y && i > 0
			y = next
		}
		return y
	}

	// The rising half of a sine window of `half` samples (4.6.11.3.2).
	def aacSineWindow(half int) float[] {
		let w float[]
		w.len(half)
		for let n = 0; n < half; n++ {
			w[n] = math.sin(math.Pi / float(2 * half) * (float(n) + 0.5))
		}
		return w
	}

	// The rising half of a Kaiser-Bessel derived window of `half` samples with
	// the alpha of 4.6.11.3.2.
	def aacKbdWindow(half int, alpha float) float[] {
		let kernel float[]
		kernel.len(half + 1)
		let total = 0.0
		for let n = 0; n <= half; n++ {
			let t = float(2 * n - half) / float(half)
			kernel[n] = aacBesselI0(math.Pi * alpha * aacSqrt(1.0 - t * t))
			total += kernel[n]
		}
		let w float[]
		w.len(half)
		let sum = 0.0
		for let n = 0; n < half; n++ {
			sum += kernel[n]
			w[n] = aacSqrt(sum / total)
		}
		return w
	}

	// The zeroth-order modified Bessel function of the first kind.
	def aacBesselI0(x float) float {
		let term = 1.0
		let sum = 1.0
		let half = x / 2.0
		for let k = 1; k < 100; k++ {
			term *= half / float(k)
			let add = term * term
			sum += add
			break when add < sum * 1e-18
		}
		return sum
	}

	let aacTablesCache ?AacTables = none

	// The shared numeric tables, computed on the first call.
	def aacTables() AacTables {
		if aacTablesCache is none {
			let t = new AacTables()
			aacTablesCache = t
			return t
		}
		let t AacTables = aacTablesCache
		return t
	}
}
