partial module std.formats.audio {
	use (
		std.testing
		std.os
		std.bytes
		std.math
		std.data.encoding
		std.formats.audio.aac::*
		std.formats.audio.seek::*
	)

	// A stream over interleaved samples held in memory, for the encoder tests.
	internal type AacTestStream {
		// The frame the next read starts at.
		internal framePosition uint64

		internal header  AudioInfo
		internal samples float32[]
		internal at      int

		// A stream of `samples` at the rate and channel count.
		def new(rate int, channels int, samples float32[]) {
			self.samples = samples
			header = AudioInfo{
				sampleRate: uint32(rate),
				channels: uint16(channels),
				bitDepth: 32,
				format: SampleFormat.Float32,
				frames: uint64(samples.len() / channels),
				codec: "pcm",
				seekable: true
			}
			at = 0
		}

		// Info implements AudioStream.
		def info() AudioInfo {
			return header
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// Read implements AudioStream. Does not fail.
		internal def readFrames(buf float32[]) !int {
			let n = samples.len() - at
			n = buf.len() when n > buf.len()
			for let i = 0; i < n; i++ {
				buf[i] = samples[at + i]
			}
			at += n
			return n / int(header.channels)
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// Seek implements AudioStream. Does not fail.
		internal def seekFrame(frame uint64) !none {
			at = int(frame) * int(header.channels)
		}

		// Close implements io.Closer. Does not fail.
		def close() !none {
			return none
		}
	}

	// A reader over bytes that records whether it was closed.
	internal type AacTestSource {
		internal data byte[]
		internal at   int
		closed        bool

		// A source over `data`.
		def new(data byte[]) {
			self.data = data
			at = 0
			closed = false
		}

		// Read implements io.Reader. Does not fail.
		def read(buf byte[]) !int {
			let n = data.len() - at
			n = buf.len() when n > buf.len()
			for let i = 0; i < n; i++ {
				buf[i] = data[at + i]
			}
			at += n
			return n
		}

		// Close implements io.Closer. Does not fail.
		def close() !none {
			closed = true
		}
	}

