		internal def sample(name string) ?byte[] {
			let d = os.readFile(sampleDir + name)
			return none when d is error
			return d
		}

		internal def fixture(text string) byte[] {
			return encoding.base64decode(text) onerror recover byte[]
		}

		// Every frame left in the stream.
		internal def decodeAll(stream AudioStream) !float32[] {
			let channels = int(stream.info().channels)
			let buf float32[]
			buf.len(4096 * channels)
			let out float32[]
			for {
				let n = try stream.read(buf)
				break when n == 0
				for let i = 0; i < n * channels; i++ {
					out.push(buf[i])
				}
			}
			return out
		}

		internal def energy(x float32[]) float {
			let sum = 0.0
			for let (_, v) in x {
				sum += float(v) * float(v)
			}
			return sum
		}

		// Whether four frames of channel `c` from `frame` on are the reference
		// decoder's values.
		internal def matches(x float32[], channels int, frame int, c int, want float[]) bool {
			for let i = 0; i < 4; i++ {
				return false when (float(x[(frame + i) * channels + c]) - want[i]).abs() > 1e-5
			}
			return true
		}

		// The signal-to-noise ratio in dB of `got` against `want`, `got` late by
		// `delay` frames.
		internal def snr(want float32[], got float32[], channels int, delay int) float {
			let signal = 0.0
			let noise = 0.0
			for let i = 0; i < want.len() && i + delay * channels < got.len(); i++ {
				let d = float(got[i + delay * channels]) - float(want[i])
				signal += float(want[i]) * float(want[i])
				noise += d * d
			}
			return 100.0 when noise == 0.0
			return 10.0 * aacLog2(signal / noise) / aacLog2(10.0)
		}

		// Two tones per channel, different on every channel, and a little noise;
		// channel 3 holds a low tone alone.
		internal def tones(rate int, channels int, frames int) float32[] {
			let out float32[]
			out.len(frames * channels)
			let state = 12345
			for let n = 0; n < frames; n++ {
				let t = float(n) / float(rate)
				for let c = 0; c < channels; c++ {
					state = (state * 1103515245 + 12345) & 0x7FFFFFFF
					let noise = float(state) / 2147483648.0 - 0.5
					let a = 0.3 * math.sin(2.0 * math.Pi * float(220 + 110 * c) * t)
					let b = 0.1 * math.sin(2.0 * math.Pi * float(1500 + 700 * c) * t)
					if c == 3 {
						// The LFE channel of 5.1 and 7.1 keeps only lows.
						a = 0.3 * math.sin(2.0 * math.Pi * 60.0 * t)
						b = 0.0
					}
					out[n * channels + c] = float32(a + b + 0.01 * noise)
				}
			}
			return out
		}

		// Decodes a sample file through the registry and compares it with the
		// reference decoder: the frame count, the total energy and three windows.
		internal def checkSample(name string, units int, total float, frames int[], values float[]) !none {
			let data = sample(name)
			return none when data is none
			let stream = try open(data)
			let info = stream.info()
			assert info.codec == "aac"
			assert info.sampleRate == 44100
			assert int(info.channels) == 1
			assert info.frames == uint64(units * 1024)
			let pcm = try decodeAll(stream)
			assert pcm.len() == units * 1024
			assert (energy(pcm) - total).abs() < total * 1e-5
			for let w = 0; w < frames.len(); w++ {
				assert matches(pcm, 1, frames[w], 0, values[w * 4:w * 4 + 4])
			}
		}

		@test()
		def TestDecodesSampleFiles() !none {
			try checkSample("aac_5s_sample_file_44KB.aac", 217, 201.89121777519412, int[3000, 111121, 219208], float[
				-0.002174617, -0.00220258, -0.002221898, -0.002232486,
				0.008161136, 0.005056943, 0.001932766, -0.001199139,
				-0.001625169, -0.001493631, -0.001356354, -0.001213882
			])
			try checkSample("aac_15s_sample_file_142KB.aac", 647, 752.418786673309, int[3000, 331281, 659528], float[
				-0.002174617, -0.00220258, -0.002221898, -0.002232486,
				0.02445786, 0.02714442, 0.02972435, 0.03218756,
				0.002155409, 0.002316274, 0.002467927, 0.002609774
			])
			try checkSample("aac_30s_sample_file_288KB.aac", 1293, 1578.2469370928538, int[3000, 662033, 1321032], float[
				-0.002174617, -0.00220258, -0.002221898, -0.002232486,
				0.02955446, 0.03201947, 0.03435872, 0.03656304,
				0.002727179, 0.002847116, 0.002955781, 0.003052754
			])
			try checkSample("aac_60s_sample_file_581KB.aac", 2585, 3229.857221807834, int[3000, 1323537, 2644040], float[
				-0.002174617, -0.00220258, -0.002221898, -0.002232486,
				0.03864277, 0.04055174, 0.04230139, 0.04388484,
				0.003316192, 0.003337963, 0.003346584, 0.003342027
			])
		}

		@test()
		def TestInfoReadsHeadersOnly() !none {
			let data = sample("aac_60s_sample_file_581KB.aac")
			return none when data is none
			let got = try info(new bytes.Reader(data))
			assert got.codec == "aac"
			assert got.frames == uint64(2585 * 1024)
			assert got.seekable
			assert got.bitrate > 75000 && got.bitrate < 82000
		}

		@test()
		def TestDecodesMp4Units() !none {
			// The m4a samples hold the very units of the aac samples; the MP4
			// path hands them to the decoder bare, with the esds config, whose
			// extension says SBR is absent.
			let data = sample("aac_5s_sample_file_44KB.aac")
			return none when data is none
			let dec = new AacDecoder(byte[0x12, 0x08, 0x56, 0xE5, 0x00])
			assert dec.sampleRate == 44100
			assert dec.channels == 1
			let out float32[]
			for let (_, f) in adtsFrames(data, 0) {
				let h = adtsHeader(data, f)
				continue when h is none
				let pcm = try dec.decode(data[f + h.headerLength:f + h.length])
				assert pcm.len() == 1024
				for let (_, v) in pcm {
					out.push(v)
				}
			}
			// The edit list of the m4a starts playback after 1024 priming frames.
			let played = out[1024:]
			assert played.len() == 216 * 1024
			assert matches(played, 1, 1976, 0, float[-0.002174617, -0.00220258, -0.002221898, -0.002232486])
			assert matches(played, 1, 110097, 0, float[0.008161136, 0.005056943, 0.001932766, -0.001199139])
		}

		@test()
		def TestDecodesStereoTools() !none {
			let stream = try new AAC().open(new bytes.Reader(fixture(stereoFixture)))
			assert stream.info().channels == 2
			let pcm = try decodeAll(stream)
			assert pcm.len() == 8192 * 2
			assert (energy(pcm) - 261.25129042488555).abs() < 261.25 * 1e-5
			assert matches(pcm, 2, 1500, 0, float[0.05127463, -0.00203494, -0.05524877, -0.1078205])
			assert matches(pcm, 2, 1500, 1, float[-0.04529885, -0.05530789, -0.06071491, -0.06095922])
			assert matches(pcm, 2, 3100, 0, float[0.1543928, 0.1570374, 0.1581486, 0.1577139])
			assert matches(pcm, 2, 3100, 1, float[-0.02354659, -0.02823521, -0.03136713, -0.03478727])
			assert matches(pcm, 2, 5000, 0, float[-0.09774016, -0.09460229, -0.09096714, -0.08690129])
			assert matches(pcm, 2, 5000, 1, float[-0.1299448, -0.1584737, -0.1872116, -0.2035001])
		}

		@test()
		def TestDecodesTns() !none {
			let stream = try new AAC().open(new bytes.Reader(fixture(tnsFixture)))
			assert stream.info().sampleRate == 22050
			let pcm = try decodeAll(stream)
			assert pcm.len() == 6144
			assert (energy(pcm) - 32.308841578824634).abs() < 32.3 * 1e-5
			assert matches(pcm, 1, 3300, 0, float[-0.0224861, -0.03186344, -0.04057229, -0.05380148])
			assert matches(pcm, 1, 5000, 0, float[0.2115718, 0.2192791, 0.2292152, 0.2342723])
		}

		@test()
		def TestDecodesSurroundInWavOrder() !none {
			let stream = try new AAC().open(new bytes.Reader(fixture(surroundFixture)))
			assert stream.info().channels == 6
			let pcm = try decodeAll(stream)
			assert pcm.len() == 4096 * 6
			assert (energy(pcm) - 842.2399435739023).abs() < 842.2 * 1e-5
			assert matches(pcm, 6, 2400, 0, float[-0.1659863, -0.1741046, -0.1821224, -0.1901])
			assert matches(pcm, 6, 2400, 1, float[0.2562229, 0.2487528, 0.2400651, 0.230112])
			assert matches(pcm, 6, 2400, 2, float[0.122424, 0.1490073, 0.174294, 0.1980776])
			assert matches(pcm, 6, 2400, 3, float[-0.1439759, -0.1470193, -0.150043, -0.1530466])
			assert matches(pcm, 6, 2400, 4, float[-0.148992, -0.1758602, -0.1992429, -0.2188365])
			assert matches(pcm, 6, 2400, 5, float[0.2942491, 0.2846231, 0.2666252, 0.2407952])
		}

		@test()
		def TestNoiseSubstitutionKeepsEnergy() !none {
			// Substituted noise is random, so only its energy is comparable.
			let stream = try new AAC().open(new bytes.Reader(fixture(noiseFixture)))
			let pcm = try decodeAll(stream)
			assert pcm.len() == 6144
			assert (energy(pcm) - 105.32264702489834).abs() < 105.3 * 0.03
		}

		@test()
		def TestSeekMatchesLinearDecode() !none {
			let data = sample("aac_5s_sample_file_44KB.aac")
			return none when data is none
			let all = try decodeAll(try new AAC().open(new bytes.Reader(data)))
			let stream = try new AAC().open(new bytes.Reader(data))
			let buf float32[]
			buf.len(4096)
			for let (_, target) in int[100000, 5, 222000, 0, 51200] {
				try stream.seek(uint64(target))
				let n = try stream.read(buf)
				let want = all.len() - target < 4096 ?? (all.len() - target, 4096)
				assert n == want
				for let i = 0; i < n; i++ {
					assert buf[i] == all[target + i]
				}
			}
			try stream.seek(uint64(all.len() + 10))
			let past = try stream.read(buf)
			assert past == 0
			try stream.close()
		}

		@test()
		def TestCloseClosesTheSource() !none {
			let source = new AacTestSource(fixture(tnsFixture))
			let stream = try new AAC().open(source)
			assert !source.closed
			try stream.close()
			assert source.closed
			let failed = false
			let buf float32[]
			buf.len(16)
			stream.read(buf) onerror (err error) {
				failed = true
				recover 0
			}
			assert failed
		}

		@test()
		def TestEncoderRoundTrip() !none {
			for let (_, channels) in int[1, 2] {
				let input = tones(44100, channels, 22050)
				let out = new bytes.Buffer()
				let codec = new AAC()
				codec.bitrate = 64000 * channels
				try codec.encode(new AacTestStream(44100, channels, input), out)
				let encoded = out.bytes()
				assert codec.matchSignature(new bytes.Reader(encoded))
				let stream = try codec.open(new bytes.Reader(encoded))
				assert stream.info().sampleRate == 44100
				assert int(stream.info().channels) == channels
				let decoded = try decodeAll(stream)
				// 21 whole units, the padded rest and the unit that flushes the
				// encoder's delay.
				assert decoded.len() == 23 * 1024 * channels
				assert snr(input, decoded, channels, 1024) > 25.0
				let rate = float(encoded.len() * 8) * 44100.0 / (23.0 * 1024.0)
				assert rate < 1.1 * float(codec.bitrate)
			}
		}

		@test()
		def TestEncoderCoreKeepsChannelOrder() !none {
			for let (_, channels) in int[6, 8] {
				let enc = new AacEncoder(48000, channels, 48000 * channels)
				let dec = new AacDecoder(enc.config())
				assert dec.sampleRate == 48000
				assert dec.channels == channels
				let input = tones(48000, channels, 4096)
				let units = try enc.encode(input)
				for let (_, u) in try enc.flush() {
					units.push(u)
				}
				assert units.len() == 5
				let decoded float32[]
				for let (_, u) in units {
					for let (_, v) in try dec.decode(u) {
						decoded.push(v)
					}
				}
				// Channel by channel, so a swapped pair fails.
				for let c = 0; c < channels; c++ {
					let want float32[]
					let got float32[]
					for let n = 0; n < 4096; n++ {
						want.push(input[n * channels + c])
					}
					for let n = 0; n < 5 * 1024; n++ {
						got.push(decoded[n * channels + c])
					}
					assert snr(want, got, 1, 1024) > 15.0
				}
			}
		}

		@test()
		def TestEncoderResamplesUnindexedRates() !none {
			let input = tones(37800, 1, 7560)
			let out = new bytes.Buffer()
			try new AAC().encode(new AacTestStream(37800, 1, input), out)
			let stream = try new AAC().open(new bytes.Reader(out.bytes()))
			assert stream.info().sampleRate == 32000
			// 0.2 s at 32 kHz is 6400 frames: 6 whole units, the rest, the flush.
			assert stream.info().frames == uint64(8 * 1024)
		}

		@test()
		def TestSignature() !none {
			let codec = new AAC()
			let adts = byte[0xFF, 0xF1, 0x50, 0x80, 0x2B, 0x7F, 0xFC, 0, 0, 0]
			assert codec.matchSignature(new bytes.Reader(adts))
			let tagged byte[] = byte[byte('I'), byte('D'), byte('3'), 4, 0, 0, 0, 0, 0, 3, 1, 2, 3]
			for let (_, b) in adts {
				tagged.push(b)
			}
			assert codec.matchSignature(new bytes.Reader(tagged))
			// An MP3 frame header has the sync but a non-zero layer.
			assert !codec.matchSignature(new bytes.Reader(byte[0xFF, 0xFB, 0x90, 0x64, 0, 0, 0, 0]))
			assert !codec.matchSignature(new bytes.Reader(byte[0x52, 0x49, 0x46, 0x46, 0, 0, 0, 0]))
			assert !codec.matchSignature(new bytes.Reader(byte[0xFF, 0xF1]))
		}

		@test()
		def TestRefusesWhatItLacks() !none {
			// Object type 5 (SBR) at 24 kHz, stereo.
			let he = new AacDecoder(byte[0x2B, 0x12, 0x08, 0x00])
			let heFailed = false
			he.decode(byte[0xE0]) onerror (err error) {
				heFailed = err.message.contains("HE-AAC")
				recover float32[]
			}
			assert heFailed
			// AAC Main (object type 1).
			let main = new AacDecoder(byte[0x0A, 0x08])
			let mainFailed = false
			main.decode(byte[0xE0]) onerror (err error) {
				mainFailed = true
				recover float32[]
			}
			assert mainFailed
			// A unit cut short has no END element.
			let lc = new AacDecoder(byte[0x12, 0x08])
			let cutFailed = false
			lc.decode(byte[0x00, 0x80]) onerror (err error) {
				cutFailed = true
				recover float32[]
			}
			assert cutFailed
			// Seven channels have no channel configuration.
			let seven = new AacEncoder(48000, 7, 448000)
			let sevenFailed = false
			seven.encode(float32[]) onerror (err error) {
				sevenFailed = true
				recover byte[][]
			}
			assert sevenFailed
		}
	}
}
