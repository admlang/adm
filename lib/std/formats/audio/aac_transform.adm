internal partial module std.formats.audio.aac {
	use std.math

	// The MDCT pair of one block length (ISO/IEC 14496-3 4.6.11 and 4.6.18),
	// computed through a DCT-IV on a complex FFT of a quarter of the block.
	// Neither direction scales: the IMDCT leaves out the 2/N of the standard.
	type AacTransform {
		// Coefficients per block: 1024 for long windows, 128 for short ones.
		size    int
		preCos  float[]
		preSin  float[]
		postCos float[]
		postSin float[]
		twCos   float[]
		twSin   float[]
		reverse int[]
		re      float[]
		im      float[]
		folded  float[]
		dct     float[]

		// A transform of `size` coefficients, a power of two.
		def new(size int) {
			self.size = size
			let half = size / 2
			preCos.len(half)
			preSin.len(half)
			postCos.len(half)
			postSin.len(half)
			for let n = 0; n < half; n++ {
				let a = -math.Pi * float(4 * n + 1) / float(4 * size)
				preCos[n] = math.cos(a)
				preSin[n] = math.sin(a)
				let b = -math.Pi * float(n) / float(size)
				postCos[n] = math.cos(b)
				postSin[n] = math.sin(b)
			}
			twCos.len(half / 2)
			twSin.len(half / 2)
			for let k = 0; k < half / 2; k++ {
				let a = -2.0 * math.Pi * float(k) / float(half)
				twCos[k] = math.cos(a)
				twSin[k] = math.sin(a)
			}
			let bits = 0
			for (1 << bits) < half {
				bits++
			}
			reverse.len(half)
			for let i = 0; i < half; i++ {
				let r = 0
				for let b = 0; b < bits; b++ {
					r = r | (((i >> b) & 1) << (bits - 1 - b))
				}
				reverse[i] = r
			}
			re.len(half)
			im.len(half)
			folded.len(size)
			dct.len(size)
		}

		// The DCT-IV of the `size` values at `at` in `x`, into `out`.
		def dct4(x float[], at int, out float[]) {
			let half = size / 2
			for let n = 0; n < half; n++ {
				let a = x[at + 2 * n]
				let b = x[at + size - 1 - 2 * n]
				let r = reverse[n]
				re[r] = a * preCos[n] - b * preSin[n]
				im[r] = a * preSin[n] + b * preCos[n]
			}
			let span = 2
			for span <= half {
				let step = half / span
				let mid = span / 2
				for let start = 0; start < half; start += span {
					for let j = 0; j < mid; j++ {
						let c = twCos[j * step]
						let s = twSin[j * step]
						let p = start + j
						let q = p + mid
						let tr = re[q] * c - im[q] * s
						let ti = re[q] * s + im[q] * c
						re[q] = re[p] - tr
						im[q] = im[p] - ti
						re[p] = re[p] + tr
						im[p] = im[p] + ti
					}
				}
				span = span * 2
			}
			for let k = 0; k < half; k++ {
				let yr = re[k] * postCos[k] - im[k] * postSin[k]
				let yi = re[k] * postSin[k] + im[k] * postCos[k]
				out[2 * k] = yr
				out[size - 1 - 2 * k] = -yi
			}
		}

		// The IMDCT of the `size` coefficients at `at` in `spec`: `2 * size`
		// samples into `out` from `outAt`.
		def inverse(spec float[], at int, out float[], outAt int) {
			dct4(spec, at, dct)
			let h = size / 2
			for let n = 0; n < h; n++ {
				out[outAt + n] = dct[n + h]
			}
			for let n = h; n < 3 * h; n++ {
				out[outAt + n] = -dct[3 * h - 1 - n]
			}
			for let n = 3 * h; n < 4 * h; n++ {
				out[outAt + n] = -dct[n - 3 * h]
			}
		}

		// The MDCT of the `2 * size` windowed samples at `at` in `x`: `size`
		// coefficients into `out`.
		def forward(x float[], at int, out float[]) {
			let h = size / 2
			for let i = 0; i < h; i++ {
				folded[i] = -x[at + size + h - 1 - i] - x[at + size + h + i]
				folded[h + i] = x[at + i] - x[at + size - 1 - i]
			}
			dct4(folded, 0, out)
		}
	}
}
