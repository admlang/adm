partial module std.formats.audio {
	use (
		std.io
		std.formats.audio.ac3::*
	)

	// AC-3 (Dolby Digital, ATSC A/52) is the surround sound codec of DVDs,
	// Blu-rays, broadcast TV and camcorder `.mts` files. Decoding covers
	// every AC-3 frame: mono to 5.1, dual mono, coupling, rematrixing, block
	// switching, dynamic range gains and the half and quarter rate streams.
	// Channels come out as coded, without downmixing, in the order left,
	// right, centre, LFE, back, sides. The decoder also takes E-AC-3 frames,
	// as `EAC3` describes.
	//
	// Encoding is not implemented yet.
	@codec("AC3")
	type AC3 {
		mimeType string[] {
			def get() string[] {
				return string["audio/ac3", "audio/x-ac3"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ac3"]
			}
		}

		// matchSignature reports whether the reader starts with an AC-3
		// frame followed by another. A stream starting with an E-AC-3 frame
		// is `EAC3`'s.
		def matchSignature(r io.Reader) bool {
			let h = ac3FirstFrame(r)
			return !(h is none) && !h.eac3
		}

		// open returns a stream decoding the AC-3 frames read from the
		// reader. A live stream keeps only the frames still to decode.
		// Fails when the data holds no AC-3 frame, or the reader fails.
		def open(reader io.Reader, live bool = false) !AudioStream {
			let s = new Ac3Stream(reader, live)
			try s.start()
			return s
		}

		// info reads the stream's description, counting its frames. Fails
		// when the data holds no AC-3 frame, or the reader fails.
		def info(reader io.Reader) !AudioInfo {
			let s = new Ac3Stream(reader, false)
			defer s.close()
			try s.start()
			return s.info()
		}

		// decoder returns a decoder of AC-3 frames as a container stores
		// them. A packet may hold several frames or part of one; the
		// `config` bytes are not needed and are ignored.
		//
		// Does not fail.
		def decoder(config byte[]) !AudioDecoder {
			return new Ac3PacketDecoder()
		}

		// encode is not implemented yet: it always fails.
		def encode(stream AudioStream, writer io.Writer) !none {
			fail "ac3: encoding is not implemented"
		}
	}

	// EAC3 (Dolby Digital Plus, ETSI TS 102 366 Annex E) is the codec of
	// streaming services and Blu-ray extras. Decoding covers its frames of
	// one to six blocks, spectral extension, the adaptive hybrid transform
	// and a dependent substream adding channels to 7.1, over an E-AC-3 or
	// AC-3 core. Other independent substreams (extra programs) are skipped.
	// Enhanced coupling and reduced sample rates are refused, as no
	// decoder is given samples of them. Channels come out as `AC3` orders
	// them.
	//
	// Encoding is not implemented yet.
	@codec("EAC3")
	type EAC3 {
		mimeType string[] {
			def get() string[] {
				return string["audio/eac3", "audio/ec3"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".eac3", ".ec3"]
			}
		}

		// matchSignature reports whether the reader starts with an E-AC-3
		// frame followed by another.
		def matchSignature(r io.Reader) bool {
			let h = ac3FirstFrame(r)
			return !(h is none) && h.eac3
		}

		// open returns a stream decoding the frames read from the reader.
		// A live stream keeps only the frames still to decode.
		// Fails when the data holds no frame of substream 0, or the reader
		// fails.
		def open(reader io.Reader, live bool = false) !AudioStream {
			return new AC3().open(reader, live)
		}

		// info reads the stream's description, counting its frames. Fails
		// when the data holds no frame of substream 0, or the reader fails.
		def info(reader io.Reader) !AudioInfo {
			return new AC3().info(reader)
		}

		// decoder returns a decoder of the frames as a container stores
		// them; the `config` bytes are not needed and are ignored.
		//
		// Does not fail.
		def decoder(config byte[]) !AudioDecoder {
			return new Ac3PacketDecoder()
		}

		// encode is not implemented yet: it always fails.
		def encode(stream AudioStream, writer io.Writer) !none {
			fail "eac3: encoding is not implemented"
		}
	}
}

internal partial module std.formats.audio.ac3 {
	use (
		std.io
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	// Bytes read from the reader at a time.
	const ac3ReadChunk = 1 << 16

	// Bytes searched for the first frame.
	const ac3SearchLimit = 1 << 16

	// Units a live stream decodes between dropping the ones behind it.
	const ac3LiveFrames = 256

	// The first frame header at or after `at` in the first `size` bytes of
	// `data` that the frame after it confirms, or that ends the data; -1
	// when there is none.
	def ac3FindFrame(data byte[], at int, size int) int {
		let pos = at
		for pos + 8 <= size {
			let found = ac3ParseHeader(data, pos)
			if !(found is none) {
				let h Ac3Header = found
				return pos when pos + h.size + 8 > size
				let next = ac3ParseHeader(data, pos + h.size)
				return pos unless next is none
			}
			pos++
		}
		return -1
	}

	// The header of the frame the reader starts with, when the frame after
	// it confirms it or the data ends inside it; none otherwise.
	def ac3FirstFrame(r io.Reader) ?Ac3Header {
		let head byte[]
		head.len(8)
		let n = io.readFull(r, head) onerror recover 0
		return none when n < 8
		let found = ac3ParseHeader(head, 0)
		return none when found is none
		let h Ac3Header = found
		let rest byte[]
		rest.len(h.size)
		let got = io.readFull(r, rest) onerror recover 0
		// A file of one frame.
		return h when got < rest.len()
		return none when ac3ParseHeader(rest, h.size - 8) is none
		return h
	}

	// Whether `h` starts a unit: an independent frame of substream 0.
	def ac3StartsUnit(h Ac3Header) bool {
		return h.frameType != 1 && h.substream == 0
	}

	// The header of the frame known to start at `at`.
	def ac3HeaderAt(data byte[], at int) Ac3Header {
		let found = ac3ParseHeader(data, at)
		return Ac3Header{} when found is none
		let h Ac3Header = found
		return h
	}

	// `packet` with the bytes of each 16-bit word swapped, for streams
	// stored with the wrong byte order.
	def ac3Swapped(packet byte[]) byte[] {
		let out byte[]
		out.len(packet.len())
		for let i = 0; i + 1 < packet.len(); i += 2 {
			out[i] = packet[i + 1]
			out[i + 1] = packet[i]
		}
		return out
	}

	// A stream over the units of an `.ac3` or `.eac3` file: each an
	// independent frame of substream 0 with the frames that extend it. The
	// bytes read so far are kept, so seeking backwards needs no rewindable
	// reader; a live stream drops them once decoded and cannot seek.
	type Ac3Stream {
		reader        io.Reader
		live          bool
		ended         bool
		closed        bool
		data          byte[]
		dataLen       int
		first         Ac3Header
		described     AudioInfo
		// Byte offset of each unit found so far.
		offsets       int[]
		scanAt        int
		program       Ac3Program
		// Channels and samples per unit, from the first unit.
		channels      int
		perUnit       int
		// One decoded unit and how much of it has been handed out.
		pcm           float32[]
		pcmFrames     int
		pcmUsed       int
		// Index of the next unit to decode.
		next          int
		// Decoded frames still to drop before a seek target.
		dropFrames    int
		// The frame the next read starts at.
		framePosition uint64

		def new(reader io.Reader, live bool) {
			self.reader = reader
			self.live = live
			program = new Ac3Program()
		}

		// Finds the first unit and decodes it for the channel count; unless
		// live, reads the whole data and counts the units. Fails when there
		// is no frame of substream 0, or the reader fails.
		def start() !none {
			try fill(ac3SearchLimit)
			let at = ac3FindFrame(data, 0, dataLen)
			for at >= 0 && !ac3StartsUnit(ac3HeaderAt(data, at)) {
				at = ac3FindFrame(data, at + 1, dataLen)
			}
			fail "ac3: no AC-3 frames" when at < 0
			first = ac3HeaderAt(data, at)
			scanAt = at
			if !live {
				try fill(1 << 62)
				for try scan() {}
			}
			try fill(at + 8 * first.size)
			let _ = try program.decode(data, at, at + (8 * first.size).min(dataLen - at), float32[])
			channels = program.channels
			perUnit = program.samples
			program.reset()
			let frames = offsets.len() * perUnit
			described = AudioInfo{
				sampleRate: uint32(first.rate),
				channels:   uint16(channels),
				bitDepth:   32,
				format:     SampleFormat.Float32,
				frames:     uint64(frames),
				length:     duration(int64(frames) * 1000000000 / int64(first.rate)),
				codec:      first.eac3 ?? ("eac3", "ac3"),
				bitrate:    uint32(program.bitrate),
				seekable:   !live,
			}
			return none
		}

		// Reads from the reader until `size` bytes are held or it ends.
		// Fails when the reader does.
		def fill(size int) !none {
			for dataLen < size && !ended {
				data.len((data.len() * 2).max(dataLen + ac3ReadChunk)) when data.len() < dataLen + ac3ReadChunk
				let n = try reader.read(data[dataLen:dataLen + ac3ReadChunk])
				if n <= 0 {
					ended = true
				} else {
					dataLen += n
				}
			}
			return none
		}

		// Finds the unit after the last one found. Returns false at the end
		// of the data; frames of other substreams and bytes that are no
		// frame are passed over.
		def scan() !bool {
			for {
				try fill(scanAt + 8)
				let at = ac3FindFrame(data, scanAt, dataLen)
				return false when at < 0
				let h = ac3HeaderAt(data, at)
				try fill(at + h.size)
				// A cut-off last frame is not decoded.
				return false when at + h.size > dataLen
				scanAt = at + h.size
				if ac3StartsUnit(h) && h.rate == first.rate {
					offsets.push(at)
					return true
				}
			}
			return false
		}

		// Decodes the next unit into `pcm`. Returns false at the end.
		// Fails when a frame is damaged.
		def decodeNext() !bool {
			for offsets.len() <= next + 1 {
				break unless try scan()
			}
			return false when offsets.len() <= next
			let at = offsets[next]
			let stop = next + 1 < offsets.len() ?? (offsets[next + 1], dataLen)
			pcm = try program.decode(data, at, stop, pcm[0:0])
			fail "ac3: the channels changed from {channels} to {program.channels}" when program.channels != channels
			pcmFrames = program.samples
			pcmUsed = 0
			next++
			compact() when live && next >= ac3LiveFrames
			return true
		}

		// Drops the bytes and offsets of the units decoded so far.
		def compact() {
			let cut = next < offsets.len() ?? (offsets[next], scanAt)
			let kept byte[]
			kept.len(dataLen - cut + ac3ReadChunk)
			data[cut:dataLen].copy(kept) when dataLen > cut
			data = kept
			dataLen -= cut
			scanAt -= cut
			let rest int[]
			for let i = next; i < offsets.len(); i++ {
				rest.push(offsets[i] - cut)
			}
			offsets = rest
			next = 0
		}

		def info() AudioInfo {
			return described
		}

		// Fills `buf` with the next interleaved frames and returns their
		// count, 0 at the end. Fails when the stream is closed, `buf` is not
		// whole frames, a frame is damaged, or the reader fails.
		def read(buf float32[]) !int {
			fail "ac3: the stream is closed" when closed
			let nch = channels
			fail "ac3: the buffer is not a whole number of frames" when buf.len() % nch != 0
			let want = buf.len() / nch
			let written = 0
			for written < want {
				if pcmUsed >= pcmFrames {
					break unless try decodeNext()
					continue
				}
				if dropFrames > 0 {
					let drop = dropFrames.min(pcmFrames - pcmUsed)
					pcmUsed += drop
					dropFrames -= drop
					continue
				}
				let n = (want - written).min(pcmFrames - pcmUsed)
				pcm[pcmUsed * nch:(pcmUsed + n) * nch].copy(buf[written * nch:(written + n) * nch])
				pcmUsed += n
				written += n
			}
			framePosition += uint64(written)
			return written
		}

		// Positions the stream at `frame`; past the end, at the end.
		// Decoding restarts a unit earlier, so the overlap the target unit
		// needs is there.
		// Fails when the stream is closed or live.
		def seek(frame uint64) !none {
			fail "ac3: the stream is closed" when closed
			fail "ac3: a live stream cannot seek" when live
			let target = int(frame).min(offsets.len() * perUnit)
			let k = target / perUnit
			let restart = (k - 1).max(0)
			program.reset()
			next = restart
			pcmFrames = 0
			pcmUsed = 0
			dropFrames = target - restart * perUnit
			framePosition = uint64(target)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// close releases the stream's buffers; reading after it fails. The
		// reader stays with its owner. Does not fail.
		def close() !none {
			closed = true
			ended = true
			data.len(0)
			dataLen = 0
			offsets.len(0)
			return none
		}
	}

	// Decodes the AC-3 and E-AC-3 frames of a container's track, however
	// its packets cut them. A unit ending where a packet ends is taken as
	// whole.
	type Ac3PacketDecoder {
		program Ac3Program
		// Bytes of a unit the last packet ended inside.
		pending byte[]
		codec   string

		def new() {
			program = new Ac3Program()
			codec = "ac3"
		}

		// info implements AudioDecoder: zero until the first unit.
		def info() AudioInfo {
			return AudioInfo{
				sampleRate: uint32(program.rate),
				channels:   uint16(program.channels),
				bitDepth:   uint16(32),
				format:     SampleFormat.Float32,
				codec:      codec,
				bitrate:    uint32(program.bitrate),
			}
		}

		// decode implements AudioDecoder: the units that end in the packet,
		// with bytes that do not start a frame and frames of other
		// substreams skipped. Frames stored with swapped bytes are swapped
		// back.
		//
		// Fails when a frame is damaged.
		def decode(packet byte[]) !float32[] {
			let fresh = packet
			fresh = ac3Swapped(packet) when packet.len() >= 2 && packet[0] == byte(0x77) && packet[1] == byte(0x0B)
			let data = pending.len() == 0 ?? (fresh, pending.concat(fresh))
			let out float32[]
			let at = 0
			for at + 8 <= data.len() {
				let found = ac3ParseHeader(data, at)
				if found is none {
					at++
					continue
				}
				let h Ac3Header = found
				break when at + h.size > data.len()
				if !ac3StartsUnit(h) {
					at += h.size
					continue
				}
				// The unit runs to the next unit or the end of the packet.
				let stop = at + h.size
				let whole = true
				for stop + 8 <= data.len() {
					let more = ac3ParseHeader(data, stop)
					break when more is none
					let m Ac3Header = more
					break when ac3StartsUnit(m)
					if stop + m.size > data.len() {
						whole = false
						break
					}
					stop += m.size
				}
				break unless whole
				out = try program.decode(data, at, stop, out)
				codec = h.eac3 ?? ("eac3", "ac3")
				at = stop
			}
			pending = at < data.len() ?? (data[at:].clone(), byte[])
			return out
		}

		// flush implements AudioDecoder: AC-3 holds nothing back.
		//
		// Does not fail.
		def flush() !float32[] {
			return float32[]
		}

		// reset implements AudioDecoder.
		def reset() {
			program.reset()
			pending = byte[]
		}
	}
}
