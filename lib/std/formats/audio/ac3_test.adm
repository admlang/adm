partial module std.formats.audio {
	use (
		std.testing
		std.bytes
		std.os
		std.formats.audio.loader::*
		std.formats.audio.ac3::*
	)

	check "AC3" {
		// A 0.5 s 5.1 stream of 80 Hz tones at 0.1 to 0.6 per channel (60 Hz
		// in the LFE), encoded by ffmpeg at 192 kbit/s.
		let surround = "samples/audio/ac3/surround_51.ac3"

		// The peak of channel `ch` of `channels` interleaved ones.
		def peak(samples float32[], ch int, channels int) float {
			let p = 0.0
			for let i = ch; i < samples.len(); i += channels {
				p = p.max(float(samples[i]).abs())
			}
			return p
		}

		@test()
		def TestHeader() !none {
			let data = try os.readFile(surround)
			let found = ac3ParseHeader(data, 0)
			fail "no header" when found is none
			let h Ac3Header = found
			try testing.expectEqual(48000, h.rate)
			try testing.expectEqual(192000, h.bitrate)
			try testing.expectEqual(768, h.size)
			try testing.expectEqual(7, h.mode)
			assert h.lfe
			try testing.expectEqual(6, h.channels)
			assert ac3ParseHeader(data, 1) is none
		}

		@test()
		def TestDecodesEveryChannelInOrder() !none {
			let data = try os.readFile(surround)
			let stream = try new AC3().open(new bytes.Reader(data))
			defer stream.close()
			let info = stream.info()
			try testing.expectEqual(uint32(48000), info.sampleRate)
			try testing.expectEqual(uint16(6), info.channels)
			try testing.expectEqual(uint64(24576), info.frames)
			try testing.expectEqual("ac3", info.codec)
			let sound = try drain(stream)
			try testing.expectEqual(24576 * 6, sound.samples.len())
			// Left, right, centre, LFE, surrounds, as ffmpeg orders them.
			for let ch = 0; ch < 6; ch++ {
				let want = 0.1 * float(ch + 1)
				assert (peak(sound.samples, ch, 6) - want).abs() < 0.005
			}
			// ffmpeg decodes frame 10000 to these samples.
			let want = float[0.099783, 0.199538, 0.299678, 0.361701, 0.499548, 0.599345]
			for let ch = 0; ch < 6; ch++ {
				assert (float(sound.samples[60000 + ch]) - want[ch]).abs() < 0.0001
			}
		}

		@test()
		def TestPacketsCutAnywhere() !none {
			let data = try os.readFile(surround)
			let whole = try new AC3().decoder(byte[])
			let expected = try whole.decode(data)
			let dec = try new AC3().decoder(byte[])
			let got float32[]
			for let at = 0; at < data.len(); at += 1000 {
				got = got.concat(try dec.decode(data[at:(at + 1000).min(data.len())]))
			}
			try testing.expectEqual(expected.len(), got.len())
			for let i = 0; i < got.len(); i++ {
				assert got[i] == expected[i]
			}
			try testing.expectEqual(uint16(6), dec.info().channels)
		}

		@test()
		def TestByteSwappedFrames() !none {
			let data = try os.readFile(surround)
			let expected = try (try new AC3().decoder(byte[])).decode(data)
			let got = try (try new AC3().decoder(byte[])).decode(ac3Swapped(data))
			try testing.expectEqual(expected.len(), got.len())
			assert got[60000] == expected[60000]
		}

		@test()
		def TestSeek() !none {
			let data = try os.readFile(surround)
			let stream = try new AC3().open(new bytes.Reader(data))
			defer stream.close()
			try stream.seek(uint64(10000))
			try testing.expectEqual(uint64(10000), stream.position())
			let buf float32[]
			buf.len(6)
			try testing.expectEqual(1, try stream.read(buf))
			// Only the dither of silent bins differs from reading through.
			assert (float(buf[0]) - 0.099783).abs() < 0.001
			assert (float(buf[5]) - 0.599345).abs() < 0.001
		}

		@test()
		def TestEac3() !none {
			// The same tones encoded as E-AC-3 by ffmpeg.
			let data = try os.readFile("samples/audio/ac3/surround_51.eac3")
			let found = ac3ParseHeader(data, 0)
			fail "no header" when found is none
			let h Ac3Header = found
			assert h.eac3
			try testing.expectEqual(0, h.frameType)
			try testing.expectEqual(6, h.blocks)
			let stream = try new EAC3().open(new bytes.Reader(data))
			defer stream.close()
			try testing.expectEqual("eac3", stream.info().codec)
			try testing.expectEqual(uint64(24576), stream.info().frames)
			let sound = try drain(stream)
			let want = float[0.099773, 0.199547, 0.299641, 0.361706, 0.499587, 0.599282]
			for let ch = 0; ch < 6; ch++ {
				assert (float(sound.samples[60000 + ch]) - want[ch]).abs() < 0.0001
			}
		}

		@test()
		def TestDependentSubstreamLayout() !none {
			// A 5.1 core whose dependent substream (3/1, no LFE) maps its
			// channels to the sides and the back pair, as 7.1 streams do.
			let p = new Ac3Program()
			let core = Ac3Header{mode: 7, lfe: true, channels: 6, blocks: 6}
			p.extension.channelMap = 0x1A00
			p.extension.mode = 5
			p.extension.channels = 4
			p.extension.fbw = 4
			p.layout(core, true)
			try testing.expectEqual(8, p.channels)
			// Front left, right, centre and LFE from the core; back pair and
			// sides from the dependent substream.
			let sources = int[0, 0, 0, 0, 1, 1, 1, 1]
			let slots = int[0, 2, 1, 5, 2, 3, 0, 1]
			for let k = 0; k < 8; k++ {
				try testing.expectEqual(sources[k], p.sourceOf[k])
				try testing.expectEqual(slots[k], p.channelOf[k])
			}
			p.layout(core, false)
			try testing.expectEqual(6, p.channels)
		}

		@test()
		def TestRegistryPicksTheCodec() !none {
			let ac3 = try open(surround)
			defer ac3.close()
			try testing.expectEqual("ac3", ac3.info().codec)
			try testing.expectEqual(uint16(6), ac3.info().channels)
			let eac3 = try open("samples/audio/ac3/surround_51.eac3")
			defer eac3.close()
			try testing.expectEqual("eac3", eac3.info().codec)
			let ac3Data = try os.readFile(surround)
			let eac3Data = try os.readFile("samples/audio/ac3/surround_51.eac3")
			assert new AC3().matchSignature(new bytes.Reader(ac3Data))
			assert !new AC3().matchSignature(new bytes.Reader(eac3Data))
			assert new EAC3().matchSignature(new bytes.Reader(eac3Data))
			assert !new EAC3().matchSignature(new bytes.Reader(ac3Data))
		}

		@test()
		def TestEncodingIsNotImplemented() !none {
			let data = try os.readFile(surround)
			let stream = try new AC3().open(new bytes.Reader(data))
			defer stream.close()
			let out = new bytes.Buffer()
			assert new AC3().encode(stream, out) is error
			assert new EAC3().encode(stream, out) is error
		}

		@test()
		def TestRefusesOtherData() !none {
			let broken = byte[0x0B, 0x77, 0, 0, 0xFF, 0, 0, 0]
			assert ac3ParseHeader(broken, 0) is none
			let failed = new AC3().open(new bytes.Reader(byte[1, 2, 3, 4, 5, 6, 7, 8]))
			assert failed is error
		}
	}
}
