partial module std.formats.audio {
	use (
		std.io
		std.bytes
		std.os
		std.formats.audio.aiff::*
	)

	// A marker the MARK chunk places between frames: a cue or loop point.
	struct AIFFMarker {
		// Positive identifier, unique in the file; comments name markers by it.
		id       uint16
		// Frame the marker sits before; 0 is the start of the sound.
		position uint32
		name     string
	}

	// A comment from the COMT chunk.
	struct AIFFComment {
		// When the comment was made, in seconds since 1904-01-01 00:00 UTC.
		timestamp uint32
		// Identifier of the marker the comment is about, 0 for the whole file.
		marker    uint16
		text      string
	}

	// AIFF is the Audio Interchange File Format codec, AIFF and AIFF-C.
	//
	// It decodes big-endian PCM of 1 to 32 bits, and the AIFF-C compressions
	// `NONE`, `twos`, `sowt` (little-endian PCM), `raw ` (unsigned PCM),
	// `fl32`, `fl64`, `ulaw` and `alaw`. It encodes the layout `format` names.
	//
	// `open` and `info` also fill `name`, `author`, `copyright`,
	// `annotations`, `comments` and `markers` from the file, and `encode`
	// writes them when they are set. `open` reads chunks only up to the sound
	// data, so it misses the ones stored after it; `info` reads them all.
	//
	// Example: Writes 24-bit AIFF with a title
	// ```example
	// let codec = new audio.AIFF()
	// codec.format = audio.SampleFormat.Int24
	// codec.name = "Take 3"
	// try codec.encode(stream, file)
	// ```
	@codec("AIFF")
	type AIFF {
		// The sample layout `encode` writes:
		//
		//     Int16    16-bit AIFF, the default
		//     Int24    24-bit AIFF
		//     Int32    32-bit AIFF
		//     Uint8    8-bit AIFF (AIFF stores 8-bit samples signed)
		//     Float32  AIFF-C `fl32`
		//     Float64  AIFF-C `fl64`
		format SampleFormat = SampleFormat.Int16

		// The NAME chunk: the sound's title.
		name        string
		// The AUTH chunk: who made the sound.
		author      string
		// The `(c) ` chunk: the copyright notice, without the © sign.
		copyright   string
		// The ANNO chunks, in file order.
		annotations string[]
		// The COMT chunk's comments.
		comments    AIFFComment[]
		// The MARK chunk's markers.
		markers     AIFFMarker[]

		mimeType string[] {
			def get() string[] {
				return string["audio/aiff", "audio/x-aiff", "audio/x-aifc"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".aiff", ".aif", ".aifc"]
			}
		}

		// matchSignature reports whether the reader starts with a FORM header of
		// form type AIFF or AIFC.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(12)
			let n = io.readFull(r, b) onerror recover 0
			return false when n != 12
			return false unless string(b[0:4]) == "FORM"
			let kind = string(b[8:12])
			return kind := "AIFF" || "AIFC"
		}

		// info reads every chunk's header and metadata, skipping the sound data.
		// Fails when the reader does not hold AIFF or AIFF-C, the sound uses a
		// compression this codec lacks, the file ends early, or the reader fails.
		def info(reader io.Reader) !AudioInfo {
			let stream = try parse(reader, false)
			return stream.info()
		}

		// open reads the chunks up to the sound data and returns a stream decoding
		// it. The stream is seekable when the reader is a `bytes.Reader`,
		// `bytes.Buffer` or `os.File`, and closing it closes a reader that is an
		// `os.File`. A file whose sound data comes before its COMM chunk is read
		// into memory whole.
		// Fails when the reader does not hold AIFF or AIFF-C, the sound uses a
		// compression this codec lacks, the file ends early, or the reader fails.
		// Fails too when `live` is set: the codec needs the whole file.
		def open(reader io.Reader, live bool = false) !AudioStream {
			fail "aiff: a live stream cannot be decoded" when live
			let stream = try parse(reader, true)
			return stream
		}

		// encode writes the stream from where it stands to its end as AIFF, or
		// AIFF-C for a float `format`, with the metadata fields that are set.
		// Samples outside -1..1 are clipped for the integer layouts.
		// Fails when the stream or the writer does, the stream has no channels or
		// more than 32767, or the sound is too long for a 32-bit chunk size.
		def encode(stream AudioStream, writer io.Writer) !none {
			let source = stream.info()
			let channels = int(source.channels)
			fail "aiff: the stream has no channels" when channels <= 0
			fail "aiff: AIFF holds at most 32767 channels" when channels > 32767

			let floating = format == SampleFormat.Float32 || format == SampleFormat.Float64
			let width = sampleWidth()
			let chunkFrames = 4096
			let samples float32[]
			samples.len(chunkFrames * channels)
			let raw byte[]
			raw.len(chunkFrames * channels * width)

			let data = new bytes.Buffer()
			let frames uint64 = 0
			for {
				let n = try stream.read(samples)
				break when n == 0
				let count = n * channels
				pack(samples, count, raw)
				try data.write(raw[:count * width])
				frames += uint64(n)
				fail "aiff: the sound is too long for AIFF" when frames > 0xFFFFFFFF
			}

			let body = new bytes.Buffer()
			if floating {
				let version = new bytes.Buffer()
				try version.write<uint32>(uint32(0xA2805140))
				try writeChunk(body, "FVER", version.bytes())
			}

			let comm = new bytes.Buffer()
			try comm.write<uint16>(uint16(channels))
			try comm.write<uint32>(uint32(frames))
			try comm.write<uint16>(uint16(width * 8))
			try comm.write(extended(source.sampleRate))
			if floating {
				let label = format == SampleFormat.Float32 ?? ("fl32", "fl64")
				let title = format == SampleFormat.Float32 ?? ("32-bit floating point", "64-bit floating point")
				try comm.writeString(label)
				try comm.write(pascal(title))
			}
			try writeChunk(body, "COMM", comm.bytes())
			try writeMetadata(body)

			let dataLen = data.len()
			let total = 4 + body.len() + 16 + dataLen + dataLen % 2
			fail "aiff: the sound is too long for AIFF" when total > 0xFFFFFFFF

			let head = new bytes.Buffer()
			try head.writeString("FORM")
			try head.write<uint32>(uint32(total))
			try head.writeString(floating ?? ("AIFC", "AIFF"))
			try head.write(body.bytes())
			try head.writeString("SSND")
			try head.write<uint32>(uint32(8 + dataLen))
			try head.write<uint32>(uint32(0))
			try head.write<uint32>(uint32(0))

			try writeAll(writer, head.bytes())
			try writeAll(writer, data.bytes())
			if dataLen % 2 == 1 {
				try writeAll(writer, byte[0])
			}
			return none
		}

		// Bytes per sample of the layout `format` names.
		internal def sampleWidth() int {
			switch format {
				case SampleFormat.Uint8:
					return 1
				case SampleFormat.Int24:
					return 3
				case SampleFormat.Int32, SampleFormat.Float32:
					return 4
				case SampleFormat.Float64:
					return 8
				default:
					return 2
			}
			return 2
		}

		// Writes the first `count` samples into `raw` big-endian, in `format`.
		internal def pack(samples float32[], count int, raw byte[]) {
			switch format {
				case SampleFormat.Float32:
					for let i = 0; i < count; i++ {
						let bits = __bitcast_u32_from_f32(samples[i])
						let o = i * 4
						raw[o], raw[o + 1], raw[o + 2], raw[o + 3] = byte(bits >> 24), byte((bits >> 16) & 0xFF), byte((bits >> 8) & 0xFF), byte(bits & 0xFF)
					}
				case SampleFormat.Float64:
					for let i = 0; i < count; i++ {
						let bits = __bitcast_u64_from_f64(float64(samples[i]))
						let o = i * 8
						for let j = 0; j < 8; j++ {
							raw[o + j] = byte((bits >> uint64(56 - 8 * j)) & 0xFF)
						}
					}
				default:
					let width = sampleWidth()
					let bits = width * 8
					let scale = float64(int64(1) << (bits - 1))
					let top = int64(1) << (bits - 1)
					for let i = 0; i < count; i++ {
						let v = int64((float64(samples[i]) * scale).round())
						v = top - 1 when v >= top
						v = -top when v < -top
						let o = i * width
						for let j = 0; j < width; j++ {
							raw[o + j] = byte((v >> (8 * (width - 1 - j))) & 0xFF)
						}
					}
			}
		}

		// Writes the metadata fields that are set as NAME, AUTH, `(c) `, ANNO,
		// COMT and MARK chunks. Fails when the buffer does.
		internal def writeMetadata(body bytes.Buffer) !none {
			try writeChunk(body, "NAME", name.bytes()) when name.len() > 0
			try writeChunk(body, "AUTH", author.bytes()) when author.len() > 0
			try writeChunk(body, "(c) ", copyright.bytes()) when copyright.len() > 0
			for let (_, note) in annotations {
				try writeChunk(body, "ANNO", note.bytes())
			}
			if comments.len() > 0 {
				let comt = new bytes.Buffer()
				try comt.write<uint16>(uint16(comments.len()))
				for let (_, c) in comments {
					let text = c.text.bytes()
					try comt.write<uint32>(c.timestamp)
					try comt.write<uint16>(c.marker)
					try comt.write<uint16>(uint16(text.len()))
					try comt.write(text)
					try comt.write(byte[0]) when text.len() % 2 == 1
				}
				try writeChunk(body, "COMT", comt.bytes())
			}
			if markers.len() > 0 {
				let mark = new bytes.Buffer()
				try mark.write<uint16>(uint16(markers.len()))
				for let (_, m) in markers {
					try mark.write<uint16>(m.id)
					try mark.write<uint32>(m.position)
					try mark.write(pascal(m.name))
				}
				try writeChunk(body, "MARK", mark.bytes())
			}
			return none
		}

		// Appends a chunk: its id, its big-endian size, the body and a pad byte
		// when the body is odd. Fails when the buffer does.
		internal def writeChunk(out bytes.Buffer, id string, content byte[]) !none {
			try out.writeString(id)
			try out.write<uint32>(uint32(content.len()))
			try out.write(content)
			try out.write(byte[0]) when content.len() % 2 == 1
			return none
		}

		// The text as a Pascal string: a count byte, at most 255 bytes of text,
		// and a pad byte when the two together are odd.
		internal def pascal(text string) byte[] {
			let b = text.bytes()
			let n = b.len() > 255 ?? (255, b.len())
			let out byte[]
			out.len(1 + n + (n + 1) % 2)
			out[:] = 0
			out[0] = byte(n)
			for let i = 0; i < n; i++ {
				out[1 + i] = b[i]
			}
			return out
		}

		// Writes every byte, looping over short writes. Fails when the writer does
		// or stops accepting bytes.
		internal def writeAll(writer io.Writer, b byte[]) !none {
			let done = 0
			for done < b.len() {
				let n = try writer.write(b[done:])
				fail "aiff: the writer accepted no bytes" when n <= 0
				done += n
			}
			return none
		}

		// The sample rate an 80-bit IEEE extended number holds, rounded to the
		// nearest whole rate. Fails when it is negative or does not fit 32 bits.
		internal def sampleRate(ext byte[]) !uint32 {
			expects {
				assert (ext[0] & 0x80) == 0 onerror fail "aiff: the sample rate is negative"
			}
			let exponent = (int(ext[0] & 0x7F) << 8) | int(ext[1])
			let mantissa uint64 = 0
			for let i = 2; i < 10; i++ {
				mantissa = (mantissa << 8) | uint64(ext[i])
			}
			return 0 when mantissa == 0
			let shift = 16383 + 63 - exponent
			fail "aiff: the sample rate is too high" when shift < 32
			return 0 when shift > 64
			let rate = ((mantissa >> uint64(shift - 1)) + 1) >> 1
			fail "aiff: the sample rate is too high" when rate > 0xFFFFFFFF
			return uint32(rate)
		}

		// The rate as the 80-bit IEEE extended number COMM stores, exactly.
		internal def extended(rate uint32) byte[] {
			let out byte[]
			out.len(10)
			out[:] = 0
			return out when rate == 0
			let top = 31
			for (rate >> uint32(top)) & 1 == 0 {
				top--
			}
			let exponent = 16383 + top
			let mantissa = uint64(rate) << uint64(63 - top)
			out[0] = byte(exponent >> 8)
			out[1] = byte(exponent & 0xFF)
			for let i = 0; i < 8; i++ {
				out[2 + i] = byte((mantissa >> uint64(56 - 8 * i)) & 0xFF)
			}
			return out
		}

		// Reads the FORM header and its chunks. With `forStream` it stops at the
		// sound data and leaves the reader there; without, it skips the sound
		// data and reads every chunk to the end of the FORM.
		// Fails when the data is not AIFF or AIFF-C, a chunk is damaged, the
		// compression is unsupported, the file ends early, or the reader fails.
		internal def parse(reader io.Reader, forStream bool) !AIFFStream {
			name, author, copyright = "", "", ""
			annotations = string[]
			comments = AIFFComment[]
			markers = AIFFMarker[]

			let r = new bytes.BinaryReader(reader, bytes.Endian.Big)
			let head = r.read(12) onerror (err error) {
				fail "aiff: the file ends inside the FORM header"
			}
			fail "aiff: not an AIFF file" unless string(head[0:4]) == "FORM"
			let kind = string(head[8:12])
			fail "aiff: not an AIFF file" unless kind := "AIFF" || "AIFC"
			let formEnd = 8 + ((int64(head[4]) << 24) | (int64(head[5]) << 16) | (int64(head[6]) << 8) | int64(head[7]))

			let stream = new AIFFStream(reader)
			stream.desc.codec = kind == "AIFC" ?? ("aifc", "aiff")
			let haveComm = false
			let haveSound = false
			let soundLen int64 = 0
			let chunkHead byte[]
			chunkHead.len(8)

			for int64(r.totalRead()) + 8 <= formEnd {
				let got = try readSome(r, chunkHead)
				break when got == 0 && haveComm && haveSound
				fail "aiff: the file ends before its sound data" when got < 8
				let id = string(chunkHead[0:4])
				let size = (int64(chunkHead[4]) << 24) | (int64(chunkHead[5]) << 16) | (int64(chunkHead[6]) << 8) | int64(chunkHead[7])
				let pad = size % 2

				if id == "SSND" {
					fail "aiff: the SSND chunk is too short" when size < 8
					let offset = int64(try r.read<uint32>())
					try r.read<uint32>()
					fail "aiff: the SSND offset lies outside the chunk" when offset > size - 8
					try skipBytes(r, offset)
					soundLen = size - 8 - offset
					haveSound = true
					if forStream && haveComm {
						try stream.start(soundLen)
						return stream
					}
					if forStream {
						let data = r.read(int(soundLen)) onerror (err error) {
							fail "aiff: the file ends inside the sound data"
						}
						stream.hold(data)
						try skipBytes(r, pad)
					} else {
						try skipBytes(r, soundLen + pad)
					}
					continue
				}

				if size > metadataLimit || !(id := "COMM" || "NAME" || "AUTH" || "(c) " || "ANNO" || "COMT" || "MARK") {
					try skipBytes(r, size + pad)
					continue
				}
				let content = r.read(int(size)) onerror (err error) {
					fail "aiff: the file ends inside the {id} chunk"
				}
				try skipBytes(r, pad)

				switch id {
					case "COMM":
						try readCommon(content, kind == "AIFC", stream)
						haveComm = true
					case "NAME":
						name = string(content)
					case "AUTH":
						author = string(content)
					case "(c) ":
						copyright = string(content)
					case "ANNO":
						annotations.push(string(content))
					case "COMT":
						try readComments(content)
					case "MARK":
						try readMarkers(content)
				}
			}

			fail "aiff: the file has no COMM chunk" unless haveComm
			fail "aiff: the file has no SSND chunk" unless haveSound || stream.desc.frames == 0
			try stream.start(soundLen)
			return stream
		}

		// Reads the COMM chunk into the stream's description and layout.
		// Fails when the chunk is too short, or describes no channels, an
		// unsupported sample size, or an unsupported compression.
		internal def readCommon(content byte[], compressed bool, stream AIFFStream) !none {
			expects {
				assert content.len() >= 18 onerror fail "aiff: the COMM chunk is too short"
			}
			let channels = (int(content[0]) << 8) | int(content[1])
			let frames = (uint64(content[2]) << 24) | (uint64(content[3]) << 16) | (uint64(content[4]) << 8) | uint64(content[5])
			let bits = (int(content[6]) << 8) | int(content[7])
			let rate = try sampleRate(content[8:18])
			fail "aiff: the file has no channels" when channels == 0 || channels > 32767

			let compression = "NONE"
			if compressed {
				fail "aiff: the COMM chunk is too short" when content.len() < 22
				compression = string(content[18:22])
			}
			try stream.describe(compression, bits)
			stream.desc.sampleRate = rate
			stream.desc.channels = uint16(channels)
			stream.desc.frames = frames
			return none
		}

		// Reads the COMT chunk into `comments`. Fails when the chunk is shorter
		// than its counts say.
		internal def readComments(content byte[]) !none {
			let r = new bytes.BinaryReader(new bytes.Reader(content), bytes.Endian.Big)
			let count = int(try r.read<uint16>())
			for let i = 0; i < count; i++ {
				let timestamp = try r.read<uint32>()
				let marker = try r.read<uint16>()
				let n = int(try r.read<uint16>())
				let text = try r.readString(n)
				try r.skip(n % 2)
				comments.push(AIFFComment{timestamp: timestamp, marker: marker, text: text})
			}
			return none
		}

		// Reads the MARK chunk into `markers`. Fails when the chunk is shorter
		// than its counts say.
		internal def readMarkers(content byte[]) !none {
			let r = new bytes.BinaryReader(new bytes.Reader(content), bytes.Endian.Big)
			let count = int(try r.read<uint16>())
			for let i = 0; i < count; i++ {
				let id = try r.read<uint16>()
				let position = try r.read<uint32>()
				let n = int(try r.readByte())
				let label = try r.readString(n)
				try r.skip((n + 1) % 2)
				markers.push(AIFFMarker{id: id, position: position, name: label})
			}
			return none
		}

		// Fills as much of `b` as the reader holds and returns the count, which is
		// short only at the end of the stream. Fails when the reader does.
		internal def readSome(r bytes.BinaryReader, b byte[]) !int {
			let got = 0
			for got < b.len() {
				let n = try r.read(b[got:])
				break when n == 0
				got += n
			}
			return got
		}

		// Reads and discards `count` bytes. Fails when the file ends first or
		// the reader fails.
		internal def skipBytes(r bytes.BinaryReader, count int64) !none {
			let left = count
			for left > 0 {
				let step = left > 65536 ?? (int64(65536), left)
				r.skip(int(step)) onerror (err error) {
					fail "aiff: the file ends early"
				}
				left -= step
			}
			return none
		}
	}
}

internal partial module std.formats.audio.aiff {
	use (
		std.io
		std.bytes
		std.os
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	// Chunks other than SSND larger than this are skipped rather than read.
	const metadataLimit = 16777216

	// How an AIFF file stores each sample.
	enum AIFFEncoding {
		// Big-endian two's complement.
		Signed,
		// Little-endian two's complement (`sowt`).
		Swapped,
		// Big-endian offset binary (`raw `).
		Unsigned,
		Float32,
		Float64,
		ULaw,
		ALaw
	}

	// The lazy decoder `AIFF.open` returns, positioned at the sound data.
	type AIFFStream {
		// The frame the next read starts at.
		framePosition uint64

		source    io.Reader
		desc      AudioInfo
		encoding  AIFFEncoding
		// Bytes per sample and per frame.
		width     int
		frameSize int
		// Frame the next read starts at, and the frames the sound holds.
		streamAt  uint64
		total     uint64
		raw       byte[]
		// Sample values of the 256 G.711 codes.
		table     float32[]
		closed    bool

		// A stream decoding from the reader.
		def new(reader io.Reader) {
			source = reader
		}

		// Sets the layout from the COMM compression and sample size, and the
		// description's `format` and `bitDepth`.
		// Fails when the compression or the sample size is unsupported.
		def describe(compression string, bits int) !none {
			let lower = compression.lower()
			encoding = AIFFEncoding.Signed
			if lower == "sowt" {
				encoding = AIFFEncoding.Swapped
			} else if lower == "raw " {
				encoding = AIFFEncoding.Unsigned
			} else if lower == "fl32" {
				encoding = AIFFEncoding.Float32
			} else if lower == "fl64" {
				encoding = AIFFEncoding.Float64
			} else if lower == "ulaw" {
				encoding = AIFFEncoding.ULaw
			} else if lower == "alaw" {
				encoding = AIFFEncoding.ALaw
			} else if !(lower := "none" || "twos") {
				fail "aiff: unsupported compression \"{compression}\""
			}

			switch encoding {
				case AIFFEncoding.Float32:
					width = 4
					desc.bitDepth, desc.format = 32, SampleFormat.Float32
				case AIFFEncoding.Float64:
					width = 8
					desc.bitDepth, desc.format = 64, SampleFormat.Float64
				case AIFFEncoding.ULaw, AIFFEncoding.ALaw:
					width = 1
					desc.bitDepth, desc.format = 8, SampleFormat.Int16
					table = g711Table(encoding == AIFFEncoding.ULaw)
				default:
					fail "aiff: unsupported sample size {bits}" when bits < 1 || bits > 32
					width = (bits + 7) / 8
					desc.bitDepth = uint16(bits)
					desc.format = SampleFormat.Int32
					desc.format = SampleFormat.Int24 when width == 3
					desc.format = SampleFormat.Int16 when width == 2
					desc.format = SampleFormat.Uint8 when width == 1
			}
			return none
		}

		// Keeps sound data that came before the COMM chunk in memory, to decode
		// from once the layout is known.
		def hold(data byte[]) {
			source = new bytes.Reader(data)
		}

		// Finishes the description once the sound data is reached: frames are
		// capped at what `soundLen` bytes hold.
		// Fails when the COMM chunk was missing.
		def start(soundLen int64) !none {
			fail "aiff: the COMM chunk must come before the sound data" when width == 0
			frameSize = width * int(desc.channels)
			let held = uint64(soundLen / int64(frameSize))
			desc.frames = held when held < desc.frames
			total = desc.frames
			let rate = uint64(desc.sampleRate)
			desc.length = rate == 0 ?? (0s, duration(int64(total * 1000000000 / rate)))
			desc.bitrate = uint32(rate * uint64(frameSize) * 8)
			desc.bitrate = uint32(rate * uint64(desc.channels) * 8) when width == 1
			let src = source
			desc.seekable = src is bytes.Reader || src is bytes.Buffer || src is os.File
			return none
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return desc
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream: it fills `buf` with whole interleaved
		// frames and returns how many, 0 at the end of the sound.
		// Fails when the stream is closed, the file ends before the frames COMM
		// declares, or the reader fails.
		def readFrames(buf float32[]) !int {
			fail "aiff: the stream is closed" when closed
			let channels = int(desc.channels)
			let want = uint64(buf.len() / channels)
			let left = total - streamAt
			want = left when left < want
			return 0 when want == 0

			let length = int(want) * frameSize
			raw.len(length) when raw.len() < length
			let got = 0
			for got < length {
				let n = try source.read(raw[got:length])
				fail "aiff: the file ends inside the sound data" when n == 0
				got += n
			}
			convert(buf, int(want) * channels)
			streamAt += want
			return int(want)
		}

		// Decodes the first `count` samples of `raw` into `buf`.
		def convert(buf float32[], count int) {
			switch encoding {
				case AIFFEncoding.Float32:
					for let i = 0; i < count; i++ {
						let o = i * 4
						let bits = (uint32(raw[o]) << 24) | (uint32(raw[o + 1]) << 16) | (uint32(raw[o + 2]) << 8) | uint32(raw[o + 3])
						buf[i] = __bitcast_f32_from_u32(bits)
					}
				case AIFFEncoding.Float64:
					for let i = 0; i < count; i++ {
						let o = i * 8
						let bits uint64 = 0
						for let j = 0; j < 8; j++ {
							bits = (bits << 8) | uint64(raw[o + j])
						}
						buf[i] = float32(__bitcast_f64_from_u64(bits))
					}
				case AIFFEncoding.ULaw, AIFFEncoding.ALaw:
					for let i = 0; i < count; i++ {
						buf[i] = table[int(raw[i])]
					}
				default:
					convertInteger(buf, count)
			}
		}

		// Decodes integer samples, left-justified in `width` bytes.
		def convertInteger(buf float32[], count int) {
			let half = int64(1) << (width * 8 - 1)
			let scale = float32(1.0 / float64(half))
			if encoding == AIFFEncoding.Signed && width == 2 {
				for let i = 0; i < count; i++ {
					let o = i * 2
					let v = ((int64(raw[o]) << 8) | int64(raw[o + 1])) ^ 0x8000
					buf[i] = float32(v - 0x8000) * scale
				}
				return
			}
			let swapped = encoding == AIFFEncoding.Swapped
			let flip = encoding == AIFFEncoding.Unsigned ?? (int64(0), half)
			for let i = 0; i < count; i++ {
				let o = i * width
				let v int64 = 0
				if swapped {
					for let j = width - 1; j >= 0; j-- {
						v = (v << 8) | int64(raw[o + j])
					}
				} else {
					for let j = 0; j < width; j++ {
						v = (v << 8) | int64(raw[o + j])
					}
				}
				buf[i] = float32((v ^ flip) - half) * scale
			}
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream: the next read starts at `frame`, clamped to
		// the end of the sound.
		// Fails when the stream is closed, the reader cannot seek, or seeking
		// it fails.
		def seekFrame(frame uint64) !none {
			fail "aiff: the stream is closed" when closed
			fail "aiff: the stream is not seekable" unless desc.seekable
			let target = frame < total ?? (frame, total)
			let delta = (int64(target) - int64(streamAt)) * int64(frameSize)
			let src = source
			if src is bytes.Reader {
				try src.seek(int(delta), bytes.Whence.Current)
			} else if src is bytes.Buffer {
				try src.seek(int(delta), bytes.Whence.Current)
			} else if src is os.File {
				try src.seek(delta, bytes.Whence.Current)
			}
			streamAt = target
			return none
		}

		// close implements io.Closer: later reads fail, and a reader that is an
		// `os.File` is closed. Fails when closing the reader does.
		def close() !none {
			return none when closed
			closed = true
			let src = source
			return src.close() when src is os.File
			return none
		}

		// The sample value of each 8-bit G.711 code, µ-law or A-law, on the
		// 16-bit scale.
		def g711Table(ulaw bool) float32[] {
			let out float32[]
			out.len(256)
			for let code = 0; code < 256; code++ {
				let v = 0
				if ulaw {
					let u = code ^ 0xFF
					let t = (((u & 0x0F) << 3) + 0x84) << ((u & 0x70) >> 4)
					v = (u & 0x80) != 0 ?? (0x84 - t, t - 0x84)
				} else {
					let a = code ^ 0x55
					let seg = (a & 0x70) >> 4
					let t = a & 0x0F
					t = seg == 0 ?? ((t * 2 + 1) << 3, (t * 2 + 1 + 32) << (seg + 2))
					v = (a & 0x80) != 0 ?? (t, -t)
				}
				out[code] = float32(v) / 32768.0
			}
			return out
		}
	}
}
