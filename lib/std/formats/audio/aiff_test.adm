partial module std.formats.audio {
	use (
		std.testing
		std.bytes
		std.os
	)

	check "AIFF" {
		// Sample files live in the repo, and `adm test` runs from its root.
		// A missing sample skips rather than fails.
		let sampleDir = "samples/audio/aiff/"

		// 80-bit IEEE extended encodings of common rates.
		let rate8000 = byte[0x40, 0x0B, 0xFA, 0x00, 0, 0, 0, 0, 0, 0]
		let rate22050 = byte[0x40, 0x0D, 0xAC, 0x44, 0, 0, 0, 0, 0, 0]
		let rate44100 = byte[0x40, 0x0E, 0xAC, 0x44, 0, 0, 0, 0, 0, 0]
		let rate48000 = byte[0x40, 0x0E, 0xBB, 0x80, 0, 0, 0, 0, 0, 0]
		let rate96000 = byte[0x40, 0x0F, 0xBB, 0x80, 0, 0, 0, 0, 0, 0]

		// A chunk: id, big-endian size, content, pad byte when odd.
		internal def chunk(id string, content byte[]) !byte[] {
			let b = new bytes.Buffer()
			try b.writeString(id)
			try b.write<uint32>(uint32(content.len()))
			try b.write(content)
			try b.write(byte[0]) when content.len() % 2 == 1
			return b.bytes()
		}

		// A COMM chunk; `compression` is empty for plain AIFF.
		internal def comm(channels int, frames int, bits int, rate byte[], compression string = "") !byte[] {
			let b = new bytes.Buffer()
			try b.write<uint16>(uint16(channels))
			try b.write<uint32>(uint32(frames))
			try b.write<uint16>(uint16(bits))
			try b.write(rate)
			if compression.len() > 0 {
				try b.writeString(compression)
				try b.write(byte[0, 0])
			}
			return chunk("COMM", b.bytes())
		}

		// An SSND chunk with `offset` filler bytes before the sound data.
		internal def ssnd(data byte[], offset int = 0) !byte[] {
			let b = new bytes.Buffer()
			try b.write<uint32>(uint32(offset))
			try b.write<uint32>(uint32(0))
			for let i = 0; i < offset; i++ {
				try b.write(byte[0xEE])
			}
			try b.write(data)
			return chunk("SSND", b.bytes())
		}

		// A FORM of the kind holding the chunks.
		internal def form(kind string, chunks byte[][]) !byte[] {
			let body = new bytes.Buffer()
			try body.writeString(kind)
			for let (_, c) in chunks {
				try body.write(c)
			}
			let b = new bytes.Buffer()
			try b.writeString("FORM")
			try b.write<uint32>(uint32(body.len()))
			try b.write(body.bytes())
			return b.bytes()
		}

		// The values as big-endian float32 sample data.
		internal def float32Data(values float[]) byte[] {
			let out byte[]
			for let (_, v) in values {
				out += float32(v).bytes(bytes.Endian.Big)
			}
			return out
		}

		internal def openBytes(data byte[]) !AudioStream {
			return new AIFF().open(new bytes.Reader(data))
		}

		// Every sample left in the stream.
		internal def decodeAll(stream AudioStream) !float32[] {
			let channels = int(stream.info().channels)
			let buf float32[]
			buf.len(4096 * channels)
			let out float32[]
			for {
				let n = try stream.read(buf)
				break when n == 0
				for let i = 0; i < n * channels; i++ {
					out.push(buf[i])
				}
			}
			return out
		}

		// The message opening the bytes fails with, empty when it succeeds.
		internal def openError(data byte[]) string {
			let result = openBytes(data)
			return result.message when result is error
			return ""
		}

		internal def near(a float32, b float, tolerance float) bool {
			let d = float(a) - b
			return d <= tolerance && d >= -tolerance
		}

		@test()
		def TestSampleFiles() !none {
			let names = string["aiff_5s_sample_file_431KB.aiff", "aiff_15s_sample_file_1.3MB.aiff", "aiff_30s_sample_file_2.5MB.aiff", "aiff_60s_sample_file_5.0MB.aiff"]
			let frames = int[220500, 661500, 1323000, 2646000]
			let absSums = int64[183990868, 643967268, 1333931868, 2713861068]
			let weighted = int64[-1045, -5445, -12045, -25245]
			let at200001 = int[120, 258, 258, 258]
			for let (i, name) in names {
				let path = sampleDir + name
				continue unless os.exists(path) onerror recover false

				let info = try info(path)
				assert info.sampleRate == 44100
				assert info.channels == 1
				assert info.bitDepth == 16
				assert info.format == SampleFormat.Int16
				assert info.frames == uint64(frames[i])
				assert info.codec == "aiff"

				let stream = try open(path)
				let samples = try decodeAll(stream)
				try stream.close()
				assert samples.len() == frames[i]
				let absSum int64 = 0
				let sum int64 = 0
				for let (k, s) in samples {
					let v = int64(s * 32768.0)
					absSum += v < 0 ?? (-v, v)
					sum += v * int64(k % 7 + 1)
				}
				assert absSum == absSums[i]
				assert sum == weighted[i]
				assert int(samples[12345] * 32768.0) == 402
				assert int(samples[100000] * 32768.0) == -1628
				assert int(samples[200001] * 32768.0) == at200001[i]
			}
			return none
		}

		@test()
		def TestIntegerLayouts() !none {
			// 0.5 and -0.25 in each stored layout.
			let plain8 = try openBytes(try form("AIFF", byte[][try comm(1, 2, 8, rate8000), try ssnd(byte[0x40, 0xE0])]))
			let s8 = try decodeAll(plain8)
			assert s8[0] == 0.5 && s8[1] == -0.25
			assert plain8.info().format == SampleFormat.Uint8

			let plain12 = try openBytes(try form("AIFF", byte[][try comm(1, 2, 12, rate8000), try ssnd(byte[0x40, 0x00, 0xE0, 0x00])]))
			let s12 = try decodeAll(plain12)
			assert s12[0] == 0.5 && s12[1] == -0.25
			assert plain12.info().bitDepth == 12

			let plain24 = try openBytes(try form("AIFF", byte[][try comm(1, 2, 24, rate8000), try ssnd(byte[0x40, 0, 0, 0xE0, 0, 0])]))
			let s24 = try decodeAll(plain24)
			assert s24[0] == 0.5 && s24[1] == -0.25
			assert plain24.info().format == SampleFormat.Int24

			let plain32 = try openBytes(try form("AIFF", byte[][try comm(1, 2, 32, rate8000), try ssnd(byte[0x40, 0, 0, 0, 0xE0, 0, 0, 0])]))
			let s32 = try decodeAll(plain32)
			assert s32[0] == 0.5 && s32[1] == -0.25
			assert plain32.info().format == SampleFormat.Int32

			for let (_, label) in string["NONE", "twos"] {
				let s = try decodeAll(try openBytes(try form("AIFC", byte[][try comm(1, 2, 16, rate8000, label), try ssnd(byte[0x40, 0, 0xE0, 0])])))
				assert s[0] == 0.5 && s[1] == -0.25
			}

			let sowt = try openBytes(try form("AIFC", byte[][try comm(1, 2, 24, rate8000, "sowt"), try ssnd(byte[0, 0, 0x40, 0, 0, 0xE0])]))
			let ss = try decodeAll(sowt)
			assert ss[0] == 0.5 && ss[1] == -0.25
			assert sowt.info().codec == "aifc"

			let unsigned = try decodeAll(try openBytes(try form("AIFC", byte[][try comm(1, 2, 8, rate8000, "raw "), try ssnd(byte[0xC0, 0x60])])))
			assert unsigned[0] == 0.5 && unsigned[1] == -0.25
			return none
		}

		@test()
		def TestFloatAndCompandedLayouts() !none {
			for let (_, label) in string["fl32", "FL32"] {
				let stream = try openBytes(try form("AIFC", byte[][try comm(2, 1, 32, rate8000, label), try ssnd(float32Data(float[0.5, -1.25]))]))
				let s = try decodeAll(stream)
				assert s[0] == 0.5 && s[1] == -1.25
				assert stream.info().format == SampleFormat.Float32
			}

			let wide = byte[0x3F, 0xE0, 0, 0, 0, 0, 0, 0, 0xBF, 0xD0, 0, 0, 0, 0, 0, 0]
			for let (_, label) in string["fl64", "FL64"] {
				let stream = try openBytes(try form("AIFC", byte[][try comm(1, 2, 64, rate8000, label), try ssnd(wide)]))
				let s = try decodeAll(stream)
				assert s[0] == 0.5 && s[1] == -0.25
				assert stream.info().format == SampleFormat.Float64
			}

			// Loudest and quietest codes of each law.
			let ulaw = try openBytes(try form("AIFC", byte[][try comm(1, 4, 16, rate8000, "ulaw"), try ssnd(byte[0x80, 0x00, 0xFF, 0x7F])]))
			let su = try decodeAll(ulaw)
			assert su[0] == float32(32124.0 / 32768.0)
			assert su[1] == float32(-32124.0 / 32768.0)
			assert su[2] == 0.0 && su[3] == 0.0
			assert ulaw.info().bitDepth == 8

			let alaw = try decodeAll(try openBytes(try form("AIFC", byte[][try comm(1, 4, 16, rate8000, "alaw"), try ssnd(byte[0xAA, 0x2A, 0xD5, 0x55])])))
			assert alaw[0] == float32(32256.0 / 32768.0)
			assert alaw[1] == float32(-32256.0 / 32768.0)
			assert alaw[2] == float32(8.0 / 32768.0)
			assert alaw[3] == float32(-8.0 / 32768.0)

			assert openError(try form("AIFC", byte[][try comm(1, 1, 16, rate8000, "ima4"), try ssnd(byte[0, 0])])).contains("ima4")
			return none
		}

		@test()
		def TestSampleRates() !none {
			let rates = uint32[8000, 22050, 44100, 48000, 96000]
			let encoded = byte[][rate8000, rate22050, rate44100, rate48000, rate96000]
			for let (i, rate) in rates {
				let data = try form("AIFF", byte[][try comm(1, 1, 16, encoded[i]), try ssnd(byte[0, 0])])
				let stream = try openBytes(data)
				assert stream.info().sampleRate == rate

				let out = new bytes.Buffer()
				try new AIFF().encode(stream, out)
				let written = out.bytes()
				// FORM header (12) + COMM header (8) + channels, frames, bits (8).
				assert written[28:38].equals(encoded[i])
				assert (try openBytes(written)).info().sampleRate == rate
			}

			// 44100.5 Hz rounds to the nearest whole rate.
			let fractional = byte[0x40, 0x0E, 0xAC, 0x44, 0x80, 0, 0, 0, 0, 0]
			let data = try form("AIFF", byte[][try comm(1, 1, 16, fractional), try ssnd(byte[0, 0])])
			assert (try openBytes(data)).info().sampleRate == 44101
			return none
		}

		@test()
		def TestEncodeRoundTrips() !none {
			let values = float[0.5, -0.5, 0.25, -1.0, 1.0, 0.0, 0.123456, -0.654321, 0.999, -0.999, 1.5, -1.5]
			let source = try form("AIFC", byte[][try comm(2, 6, 32, rate48000, "fl32"), try ssnd(float32Data(values))])
			let formats = SampleFormat[SampleFormat.Int16, SampleFormat.Int24, SampleFormat.Int32, SampleFormat.Uint8, SampleFormat.Float32, SampleFormat.Float64]
			let bits = int[16, 24, 32, 8, 32, 64]
			let steps = float[1.0 / 32768.0, 1.0 / 8388608.0, 1.0 / 2147483648.0, 1.0 / 128.0, 0.0, 0.0]
			for let (i, format) in formats {
				let codec = new AIFF()
				codec.format = format
				let out = new bytes.Buffer()
				try codec.encode(try openBytes(source), out)
				let written = out.bytes()
				let floating = format == SampleFormat.Float32 || format == SampleFormat.Float64
				assert string(written[8:12]) == (floating ?? ("AIFC", "AIFF"))
				assert written.len() % 2 == 0

				let stream = try openBytes(written)
				let info = stream.info()
				assert info.channels == 2 && info.frames == 6 && info.sampleRate == 48000
				assert int(info.bitDepth) == bits[i]
				assert info.format == format

				let decoded = try decodeAll(stream)
				assert decoded.len() == values.len()
				for let (k, v) in values {
					let want = float(float32(v))
					if !floating {
						want = 1.0 when want > 1.0
						want = -1.0 when want < -1.0
					}
					assert near(decoded[k], want, steps[i] + 1.0e-7)
				}
			}
			return none
		}

		@test()
		def TestMetadata() !none {
			let codec = new AIFF()
			codec.name = "Take 3"
			codec.author = "Ada"
			codec.copyright = "2026 Ada"
			codec.annotations = string["first", "odd"]
			codec.comments = AIFFComment[AIFFComment{timestamp:3000000000, marker:1, text:"loop here"}]
			codec.markers = AIFFMarker[AIFFMarker{id:1, position:2, name:"loop"}, AIFFMarker{id:2, position:3, name:"end!"}]
			let source = try form("AIFF", byte[][try comm(1, 4, 16, rate8000), try ssnd(byte[0, 1, 0, 2, 0, 3, 0, 4])])
			let out = new bytes.Buffer()
			try codec.encode(try openBytes(source), out)

			let back = new AIFF()
			let info = try back.info(new bytes.Reader(out.bytes()))
			assert info.frames == 4
			assert back.name == "Take 3" && back.author == "Ada" && back.copyright == "2026 Ada"
			assert back.annotations.len() == 2 && back.annotations[1] == "odd"
			assert back.comments.len() == 1
			assert back.comments[0].timestamp == 3000000000 && back.comments[0].marker == 1 && back.comments[0].text == "loop here"
			assert back.markers.len() == 2
			assert back.markers[0].id == 1 && back.markers[0].position == 2 && back.markers[0].name == "loop"
			assert back.markers[1].name == "end!"

			let streamed = new AIFF()
			let s = try decodeAll(try streamed.open(new bytes.Reader(out.bytes())))
			assert s.len() == 4 && s[3] == float32(4.0 / 32768.0)
			assert streamed.markers.len() == 2
			return none
		}

		@test()
		def TestChunkLayout() !none {
			// An odd unknown chunk first, sound before COMM with an offset,
			// then an odd annotation after it.
			let data = try form("AIFF", byte[][
				try chunk("APPL", byte[1, 2, 3]),
				try ssnd(byte[0x40, 0xE0, 0x20], 4),
				try comm(1, 3, 8, rate22050),
				try chunk("ANNO", "hi!".bytes())
			])
			let codec = new AIFF()
			let info = try codec.info(new bytes.Reader(data))
			assert info.frames == 3 && info.sampleRate == 22050
			assert codec.annotations.len() == 1 && codec.annotations[0] == "hi!"

			let stream = try codec.open(new bytes.Reader(data))
			let s = try decodeAll(stream)
			assert s.len() == 3
			assert s[0] == 0.5 && s[1] == -0.25 && s[2] == 0.25

			// COMM claiming more frames than SSND holds yields what is there.
			let short = try form("AIFF", byte[][try comm(1, 9, 8, rate8000), try ssnd(byte[1, 2])])
			assert (try openBytes(short)).info().frames == 2
			return none
		}

		@test()
		def TestSeek() !none {
			let data = try form("AIFF", byte[][try comm(2, 4, 8, rate8000), try ssnd(byte[0, 1, 2, 3, 4, 5, 6, 7])])
			let stream = try openBytes(data)
			assert stream.info().seekable
			try stream.seek(2)
			let buf float32[]
			buf.len(2)
			assert (try stream.read(buf)) == 1
			assert buf[0] == float32(4.0 / 128.0) && buf[1] == float32(5.0 / 128.0)
			try stream.seek(0)
			assert (try stream.read(buf)) == 1
			assert buf[1] == float32(1.0 / 128.0)
			try stream.seek(99)
			assert (try stream.read(buf)) == 0
			try stream.close()

			let failed = false
			stream.read(buf) onerror (err error) {
				failed = true
				recover 0
			}
			assert failed
			return none
		}

		@test()
		def TestRegistry() !none {
			let source = try form("AIFC", byte[][try comm(1, 2, 32, rate44100, "fl32"), try ssnd(float32Data(float[0.5, -0.25]))])
			let stream = try open(source)
			assert stream.info().codec == "aifc"
			assert stream.info().sampleRate == 44100

			let out = new bytes.Buffer()
			try write(stream, out, ".aif")
			let written = out.bytes()
			assert string(written[8:12]) == "AIFF"
			let back = try open(written)
			assert back.info().bitDepth == 16
			let samples = try decodeAll(back)
			assert samples.len() == 2 && samples[0] == 0.5 && samples[1] == -0.25

			let info = try info(new bytes.Reader(written))
			assert info.frames == 2 && info.channels == 1

			let codec = new AIFF()
			assert codec.matchSignature(new bytes.Reader(written))
			assert !codec.matchSignature(new bytes.Reader("RIFFxxxxWAVE".bytes()))
			return none
		}

		@test()
		def TestTruncatedFiles() !none {
			let data = try form("AIFF", byte[][try comm(1, 4, 16, rate8000), try ssnd(byte[0, 1, 0, 2, 0, 3, 0, 4])])
			let cut = data[:data.len() - 3]

			let infoFailed = false
			new AIFF().info(new bytes.Reader(cut)) onerror (err error) {
				infoFailed = true
				recover AudioInfo{}
			}
			assert infoFailed

			let stream = try openBytes(cut)
			let readFailed = false
			decodeAll(stream) onerror (err error) {
				readFailed = err.message.contains("ends")
				recover float32[]
			}
			assert readFailed

			for let (_, n) in int[0, 5, 12, 20, 30] {
				assert openError(data[:n]).len() > 0
			}
			return none
		}
	}
}
