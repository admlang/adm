internal partial module std.formats.audio.amr {
	// The AMR-NB speech decoder of 3GPP TS 26.090, bit-exact to the
	// fixed-point reference of TS 26.073: a frame's parameters in, 160
	// samples at 8 kHz out, with error concealment (TS 26.091), comfort
	// noise (TS 26.092) and decoder homing.

	// Codec modes, 4.75 to 12.2 kbit/s, and the SID frame's parameters.
	const amrMode475 = 0
	const amrMode515 = 1
	const amrMode59 = 2
	const amrMode67 = 3
	const amrMode74 = 4
	const amrMode795 = 5
	const amrMode102 = 6
	const amrMode122 = 7
	const amrModeDtx = 8

	// Receive frame types: what the decoder knows of a frame's arrival.
	const amrRxSpeechGood = 0
	const amrRxSpeechDegraded = 1
	const amrRxOnset = 2
	const amrRxSpeechBad = 3
	const amrRxSidFirst = 4
	const amrRxSidUpdate = 5
	const amrRxSidBad = 6
	const amrRxNoData = 7

	// Samples of a frame.
	const amrFrame = 160

	// Where the current subframe's excitation starts in the excitation
	// history: the longest lag plus the interpolation filter's reach.
	const amrExcAt = 154

	// Parameter bits of a frame of each frame type in the storage format,
	// frame types 9 to 15 carrying none the decoder reads.
	const amrStorageBits = int[95, 103, 118, 134, 148, 159, 204, 244, 35, 0, 0, 0, 0, 0, 0, 0]

	// Bit `i` of the frame payload starting at `at`, most significant bit
	// of each byte first.
	def amrStoredBit(payload byte[], at int, i int) int {
		return (int(payload[at + (i >> 3)]) >> (7 - (i & 7))) & 1
	}

	// Bytes after the header of a frame of each frame type in the storage
	// format (RFC 4867 section 5.3).
	const amrStorageBytes = int[12, 13, 15, 17, 19, 20, 26, 31, 5, 5, 5, 5, 0, 0, 0, 0]

	// Post filter factors of the numerator and denominator: for 12.2 and
	// 10.2 kbit/s, then for the others.
	const amrGamma3High = int[22938, 16057, 11240, 7868, 5508, 3856, 2699, 1889, 1322, 925]
	const amrGamma4High = int[24576, 18432, 13824, 10368, 7776, 5832, 4374, 3281, 2461, 1846]
	const amrGamma3 = int[18022, 9912, 5451, 2998, 1649, 907, 499, 274, 151, 83]
	const amrGamma4 = int[22938, 16057, 11240, 7868, 5508, 3856, 2699, 1889, 1322, 925]

	// The value a homed decoder outputs for each sample of a homing frame.
	const amrHomingSample = 0x0008

	// One decoder: the speech decoder with its post filter and post
	// processing, and the homing and bit buffers around them.
	type AmrDecoder {
		// The excitation: the past amrExcAt samples, then the subframe.
		oldExc         int[]
		memSyn         int[]
		lspOld         int[]
		sharp          int
		oldT0          int
		prevBf         bool
		prevPdf        bool
		// The error state, 0 to 6, of TS 26.091.
		state          int
		t0LagBuff      int
		background     bool
		voicedHangover int
		ltpGainHistory int[]
		excEnergyHist  int[]
		nodataSeed     int
		lsf            AmrLsfState
		lsfAverage     int[]
		pred           AmrGainPredictor
		conceal        AmrGainConcealer
		smoother       AmrGainSmoother
		noise          AmrNoiseDetector
		dispersion     AmrPhaseDispersion
		dtx            AmrDtxDecoder
		// The post filter.
		memSynPst      int[]
		res2           int[]
		synthBuf       int[]
		agcPastGain    int
		preemphMem     int
		// The high-pass post processing.
		y2Hi           int
		y2Lo           int
		y1Hi           int
		y1Lo           int
		x0             int
		x1             int
		prevMode       int
		homed          bool
		// The speech bits of the last frame, in parameter order: a frame
		// without data leaves them as they were, as the reference does.
		bits           int[]

		def new() {
			oldExc.len(amrExcAt + amrSubframe)
			memSyn.len(amrOrder)
			lspOld.len(amrOrder)
			ltpGainHistory.len(9)
			excEnergyHist.len(9)
			lsf = new AmrLsfState()
			lsfAverage.len(amrOrder)
			pred = new AmrGainPredictor()
			conceal = new AmrGainConcealer()
			smoother = new AmrGainSmoother()
			noise = new AmrNoiseDetector()
			dispersion = new AmrPhaseDispersion()
			dtx = new AmrDtxDecoder()
			memSynPst.len(amrOrder)
			res2.len(amrSubframe)
			synthBuf.len(amrFrame + amrOrder)
			bits.len(244)
			reset()
			homed = true
		}

		// Returns the decoder to its initial state (Speech_Decode_Frame_reset).
		def reset() {
			resetSpeech(amrMode475)
			memSynPst.fill(0)
			res2.fill(0)
			synthBuf.fill(0)
			agcPastGain = 4096
			preemphMem = 0
			y2Hi = 0
			y2Lo = 0
			y1Hi = 0
			y1Lo = 0
			x0 = 0
			x1 = 0
			prevMode = amrMode475
		}

		// Resets the speech decoder (Decoder_amr_reset); comfort noise
		// resets it with `amrModeDtx`, which keeps the synthesis memory, the
		// LSPs, the energies and the DTX state.
		def resetSpeech(mode int) {
			oldExc.fill(0)
			sharp = 0
			oldT0 = 40
			prevBf = false
			prevPdf = false
			state = 0
			t0LagBuff = 40
			background = false
			voicedHangover = 0
			ltpGainHistory.fill(0)
			smoother.reset()
			lsf.reset()
			conceal.reset()
			noise.reset()
			nodataSeed = 21845
			dispersion.reset()
			if mode != amrModeDtx {
				memSyn.fill(0)
				for let i = 0; i < amrOrder; i++ {
					lspOld[i] = amrLspInit[i]
					lsfAverage[i] = amrMeanLsf5[i]
				}
				excEnergyHist.fill(0)
				pred.reset()
				dtx.reset()
			}
		}

		// Decodes one frame of the storage format (RFC 4867 section 5.3):
		// `header` is its first byte and `payload` holds `amrStorageBytes`
		// bytes from `at`. Frame types 9 to 14 carry nothing the decoder
		// reads and decode as frames without data. Returns 160 samples.
		def decodeStored(header int, payload byte[], at int) int[] {
			let ft = (header >> 3) & 15
			let good = (header & 4) != 0
			return decodeFrame(amrRxNoData, prevMode) when ft > 8
			let order = ft == amrModeDtx ?? (-1, amrReorderStart[ft])
			let n = amrStorageBits[ft]
			for let i = 0; i < n; i++ {
				bits[order < 0 ?? (i, amrReorder[order + i])] = amrStoredBit(payload, at, i)
			}
			return decodeFrame(good ?? (amrRxSpeechGood, amrRxSpeechBad), ft) when ft != amrModeDtx
			// The SID type indicator, then the mode indication, lowest bit
			// first.
			let mode = amrStoredBit(payload, at, 36) | (amrStoredBit(payload, at, 37) << 1) | (amrStoredBit(payload, at, 38) << 2)
			let rx = amrRxSidBad
			rx = amrStoredBit(payload, at, 35) != 0 ?? (amrRxSidUpdate, amrRxSidFirst) when good
			return decodeFrame(rx, mode)
		}

		// Decodes the frame in `bits` of receive type `rx` and codec mode
		// `mode` into 160 samples, homing as the reference decoder does: a
		// decoder homing frame resets the decoder, and one arriving while
		// the decoder is homed outputs the homing samples.
		def decodeFrame(rx int, frameMode int) int[] {
			let mode = frameMode
			if rx == amrRxNoData {
				mode = prevMode
			} else {
				prevMode = mode
			}
			let resetFlag = false
			resetFlag = isHomingFrame(mode, true) when homed
			let synth int[]
			synth.len(amrFrame)
			if resetFlag && homed {
				synth.fill(amrHomingSample)
			} else {
				decodeSpeech(mode, rx, synth)
			}
			resetFlag = isHomingFrame(mode, false) when !homed
			reset() when resetFlag
			homed = resetFlag
			return synth
		}

		// Whether the bits are the decoder homing frame of `mode`, up to
		// the end of the first subframe when `first`.
		def isHomingFrame(mode int, first bool) bool {
			return false when mode < 0 || mode > amrMode122
			let prm = toParams(mode)
			let n = first ?? (amrHomingFirst[mode], amrParamCount[mode])
			for let i = 0; i < n; i++ {
				return false when prm[i] != amrHoming[amrHomingStart[mode] + i]
			}
			return true
		}

		// The parameters of the bits in mode `mode` (Bits2prm).
		def toParams(mode int) int[] {
			let prm int[]
			prm.len(amrParamCount[mode])
			let at = 0
			let widths = amrParamBitsStart[mode]
			for let i = 0; i < prm.len(); i++ {
				let v = 0
				for let b = 0; b < amrParamBits[widths + i]; b++ {
					v = (v << 1) | bits[at]
					at++
				}
				prm[i] = v
			}
			return prm
		}

		// One frame through the speech decoder, the post filter and the
		// post processing, truncated to 13 bits (Speech_Decode_Frame).
		def decodeSpeech(mode int, rx int, synth int[]) {
			let prm = toParams(rx == amrRxSidBad || rx == amrRxSidUpdate ?? (amrModeDtx, mode))
			let az int[]
			az.len(4 * (amrOrder + 1))
			decodeParams(mode, prm, rx, synth, az)
			postFilter(mode, synth, az)
			postProcess(synth)
			for let i = 0; i < amrFrame; i++ {
				synth[i] = amrW16(synth[i] & 0xFFF8)
			}
		}

		// The speech decoder (Decoder_amr): the synthesized frame into
		// `synth` and each subframe's prediction coefficients into `az`.
		def decodeParams(mode int, prm int[], rx int, synth int[], az int[]) {
			let dtxState = dtx.handle(rx)
			if dtxState != amrSpeech {
				resetSpeech(amrModeDtx)
				dtx.decode(memSyn, lsf, pred, smoother, dtxState, mode, prm, synth, az)
				amrLsfToLsp(lsf.pastLsf, lspOld)
				averageLsf()
				dtx.globalState = dtxState
				return
			}
			let bfi = rx == amrRxSpeechBad || rx == amrRxNoData || rx == amrRxOnset
			let pdfi = rx == amrRxSpeechDegraded
			comfortParams(mode, prm) when rx == amrRxNoData || rx == amrRxOnset
			if bfi {
				state = amrAdd(state, 1)
			} else if state == 6 {
				state = 5
			} else {
				state = 0
			}
			state = state.min(6)
			if dtx.globalState == amrDtx {
				state = 5
				prevBf = false
			} else if dtx.globalState == amrDtxMute {
				state = 5
				prevBf = true
			}
			let prevLsf = lsf.pastLsf.clone()
			let lspNew int[]
			lspNew.len(amrOrder)
			let p = 0
			if mode != amrMode122 {
				lsf.decode3(mode, bfi, prm, 0, lspNew)
				p = 3
				amrInterpolate1to3(lspOld, lspNew, az)
			} else {
				let lspMid int[]
				lspMid.len(amrOrder)
				lsf.decode5(bfi, prm, 0, lspMid, lspNew)
				p = 5
				amrInterpolate1and3(lspOld, lspMid, lspNew, az)
			}
			for let i = 0; i < amrOrder; i++ {
				lspOld[i] = lspNew[i]
			}
			let lowMode = mode == amrMode475 || mode == amrMode515 || mode == amrMode59
			let code int[]
			code.len(amrSubframe)
			let excp int[]
			excp.len(amrSubframe)
			let enhanced int[]
			enhanced.len(amrSubframe)
			let lsfI int[]
			lsfI.len(amrOrder)
			let t0 = 0
			let t0Frac = 0
			let index475 = 0
			let gainPit = 0
			let gainCode = 0
			let even = false
			for let sub = 0; sub < 4; sub++ {
				let at = sub * amrSubframe
				even = !even
				let first = at == 0 || (at == 80 && mode != amrMode475 && mode != amrMode515)
				let index = prm[p]
				p++
				if mode != amrMode122 {
					let flag4 = mode <= amrMode67
					let low = mode == amrMode795 ?? (10, 5)
					let range = mode == amrMode795 ?? (19, 9)
					let t0Min = amrSub(oldT0, low).max(amrPitMin)
					let t0Max = amrAdd(t0Min, range)
					if amrSub(t0Max, amrPitMax) > 0 {
						t0Max = amrPitMax
						t0Min = amrSub(t0Max, range)
					}
					(t0, t0Frac) = amrDecodeLag3(index, t0Min, t0Max, first, oldT0, flag4)
					t0LagBuff = t0
					if bfi {
						oldT0 = amrAdd(oldT0, 1) when amrSub(oldT0, amrPitMax) < 0
						t0 = oldT0
						t0Frac = 0
						t0 = t0LagBuff when background && amrSub(voicedHangover, 4) > 0 && lowMode
					}
					amrPredictLtp(oldExc, amrExcAt, t0, t0Frac, amrSubframe, true)
				} else {
					(t0, t0Frac) = amrDecodeLag6(index, first, t0)
					if bfi || (!first && amrSub(index, 61) >= 0) {
						t0LagBuff = t0
						t0 = oldT0
						t0Frac = 0
					}
					amrPredictLtp(oldExc, amrExcAt, t0, t0Frac, amrSubframe, false)
				}
				let pitSharp = 0
				if mode == amrMode475 || mode == amrMode515 {
					amrCode2i40x9(sub, prm[p + 1], prm[p], code)
					p += 2
					pitSharp = amrShl(sharp, 1)
				} else if mode == amrMode59 {
					amrCode2i40x11(prm[p + 1], prm[p], code)
					p += 2
					pitSharp = amrShl(sharp, 1)
				} else if mode == amrMode67 {
					amrCode3i40x14(prm[p + 1], prm[p], code)
					p += 2
					pitSharp = amrShl(sharp, 1)
				} else if mode <= amrMode795 {
					amrCode4i40x17(prm[p + 1], prm[p], code)
					p += 2
					pitSharp = amrShl(sharp, 1)
				} else if mode == amrMode102 {
					amrCode8i40x31(prm, p, code)
					p += 7
					pitSharp = amrShl(sharp, 1)
				} else {
					let gi = prm[p]
					p++
					gainPit = bfi ?? (conceal.pitch(state), amrDecodePitchGain(mode, gi))
					gainPit = conceal.updatePitch(bfi, prevBf, gainPit)
					amrCode10i40x35(prm, p, code)
					p += 10
					pitSharp = amrShl(gainPit, 1)
				}
				for let i = t0; i < amrSubframe; i++ {
					code[i] = amrAdd(code[i], amrMult(code[i - t0], pitSharp))
				}
				if mode == amrMode475 {
					if even {
						index475 = prm[p]
						p++
					}
					if !bfi {
						(gainPit, gainCode) = amrDecodeGains(pred, mode, index475, code, even)
					} else {
						gainPit = conceal.pitch(state)
						gainCode = conceal.code(pred, state)
					}
					gainPit = conceal.updatePitch(bfi, prevBf, gainPit)
					gainCode = conceal.updateCode(bfi, prevBf, gainCode)
					pitSharp = gainPit.min(amrSharpMax)
				} else if mode <= amrMode74 || mode == amrMode102 {
					let gi = prm[p]
					p++
					if !bfi {
						(gainPit, gainCode) = amrDecodeGains(pred, mode, gi, code, even)
					} else {
						gainPit = conceal.pitch(state)
						gainCode = conceal.code(pred, state)
					}
					gainPit = conceal.updatePitch(bfi, prevBf, gainPit)
					gainCode = conceal.updateCode(bfi, prevBf, gainCode)
					pitSharp = gainPit.min(amrSharpMax)
					pitSharp = amrShr(pitSharp, 2) when mode == amrMode102 && amrSub(oldT0, amrSubframe + 5) > 0
				} else {
					let gi = prm[p]
					p++
					if mode == amrMode795 {
						gainPit = bfi ?? (conceal.pitch(state), amrDecodePitchGain(mode, gi))
						gainPit = conceal.updatePitch(bfi, prevBf, gainPit)
						gi = prm[p]
						p++
						gainCode = bfi ?? (conceal.code(pred, state), amrDecodeCodeGain(pred, mode, gi, code))
						gainCode = conceal.updateCode(bfi, prevBf, gainCode)
						pitSharp = gainPit.min(amrSharpMax)
					} else {
						gainCode = bfi ?? (conceal.code(pred, state), amrDecodeCodeGain(pred, mode, gi, code))
						gainCode = conceal.updateCode(bfi, prevBf, gainCode)
						pitSharp = gainPit
					}
				}
				sharp = gainPit.min(amrSharpMax) when mode != amrMode475 || !even
				pitSharp = amrShl(pitSharp, 1)
				if amrSub(pitSharp, 16384) > 0 {
					for let i = 0; i < amrSubframe; i++ {
						let t = amrLMult(amrMult(oldExc[amrExcAt + i], pitSharp), gainPit)
						t = amrLShr(t, 1) when mode == amrMode122
						excp[i] = amrRound(t)
					}
				}
				if !bfi {
					for let i = 0; i < 8; i++ {
						ltpGainHistory[i] = ltpGainHistory[i + 1]
					}
					ltpGainHistory[8] = gainPit
				}
				if (prevBf || bfi) && background && lowMode {
					gainPit = amrAdd(amrShr(amrSub(gainPit, 12288), 1), 12288) when amrSub(gainPit, 12288) > 0
					gainPit = 14745 when amrSub(gainPit, 14745) > 0
				}
				amrInterpolateLsf(prevLsf, lsf.pastLsf, at, lsfI)
				let gainCodeMix = smoother.average(mode, gainCode, lsfI, lsfAverage, bfi, prevBf, pdfi, prevPdf, background, voicedHangover)
				gainCodeMix = gainCode when mode > amrMode67 && mode != amrMode102
				let pitchFac = gainPit
				let shift = 1
				if mode > amrMode102 {
					pitchFac = amrShr(gainPit, 1)
					shift = 2
				}
				for let i = 0; i < amrSubframe; i++ {
					enhanced[i] = oldExc[amrExcAt + i]
					let t = amrLMult(oldExc[amrExcAt + i], pitchFac)
					t = amrLMac(t, code[i], gainCode)
					oldExc[amrExcAt + i] = amrRound(amrLShl(t, shift))
				}
				dispersion.lockFull = lowMode && amrSub(voicedHangover, 3) > 0 && background && bfi
				dispersion.apply(mode, enhanced, gainCodeMix, gainPit, code, pitchFac, shift)
				let energy = 0
				for let i = 0; i < amrSubframe; i++ {
					energy = amrLMac(energy, enhanced[i], enhanced[i])
				}
				energy = amrLShr(energy, 1)
				let (root, rootExp) = amrSqrtLExp(energy)
				energy = amrLShr(root, amrAdd(amrShr(rootExp, 1), 15))
				let excEnergy = amrW16(amrLShr(energy, 2))
				let careful = pdfi && !bfi
				amrExcitationControl(enhanced, excEnergy, excEnergyHist, voicedHangover, prevBf, careful) when lowMode && amrSub(voicedHangover, 5) > 0 && background && amrSub(state, 4) < 0 && ((pdfi && prevPdf) || bfi || prevBf)
				if !(background && (bfi || prevBf) && amrSub(state, 4) < 0) {
					for let i = 0; i < 8; i++ {
						excEnergyHist[i] = excEnergyHist[i + 1]
					}
					excEnergyHist[8] = excEnergy
				}
				let overflow = false
				if amrSub(pitSharp, 16384) > 0 {
					for let i = 0; i < amrSubframe; i++ {
						excp[i] = amrAdd(excp[i], enhanced[i])
					}
					amrAgc2(enhanced, 0, excp, 0, amrSubframe)
					overflow = amrSynthesis(az, sub * (amrOrder + 1), excp, 0, synth, at, amrSubframe, memSyn, false)
				} else {
					overflow = amrSynthesis(az, sub * (amrOrder + 1), enhanced, 0, synth, at, amrSubframe, memSyn, false)
				}
				if overflow {
					for let i = 0; i < oldExc.len(); i++ {
						oldExc[i] = amrShr(oldExc[i], 2)
					}
					for let i = 0; i < amrSubframe; i++ {
						enhanced[i] = amrShr(enhanced[i], 2)
					}
					let _ = amrSynthesis(az, sub * (amrOrder + 1), enhanced, 0, synth, at, amrSubframe, memSyn, true)
				} else {
					for let i = 0; i < amrOrder; i++ {
						memSyn[i] = synth[at + amrSubframe - amrOrder + i]
					}
				}
				for let i = 0; i < amrExcAt; i++ {
					oldExc[i] = oldExc[i + amrSubframe]
				}
				oldT0 = t0
			}
			(background, voicedHangover) = noise.detect(ltpGainHistory, synth, voicedHangover)
			dtx.update(lsf.pastLsf, synth)
			prevBf = bfi
			prevPdf = pdfi
			averageLsf()
			dtx.globalState = dtxState
		}

		// Moves the LSF average the gain smoother compares with towards the
		// current LSFs (lsp_avg).
		def averageLsf() {
			for let i = 0; i < amrOrder; i++ {
				let t = lsfAverage[i] << 16
				t = amrLMsu(t, 5243, lsfAverage[i])
				t = amrLMac(t, 5243, lsf.pastLsf[i])
				lsfAverage[i] = amrRound(t)
			}
		}

		// Random parameters for a frame without data (build_CN_param).
		def comfortParams(mode int, prm int[]) {
			nodataSeed = amrW16(amrLAdd(amrLShr(amrLMult(nodataSeed, 31821), 1), 13849))
			let at = nodataSeed & 0x7F
			let widths = amrParamBitsStart[mode]
			for let i = 0; i < amrParamCount[mode]; i++ {
				prm[i] = amrW16(amrWindow[at + i] & ((1 << amrParamBits[widths + i]) - 1))
			}
		}

		// The formant and tilt post filter with gain control (Post_Filter).
		def postFilter(mode int, syn int[], az int[]) {
			for let i = 0; i < amrFrame; i++ {
				synthBuf[amrOrder + i] = syn[i]
			}
			let ap3 int[]
			ap3.len(amrOrder + 1)
			let ap4 int[]
			ap4.len(amrOrder + 1)
			let h int[]
			h.len(22)
			let high = mode == amrMode122 || mode == amrMode102
			for let sub = 0; sub < 4; sub++ {
				let at = sub * amrSubframe
				let azAt = sub * (amrOrder + 1)
				amrWeight(az, azAt, high ?? (amrGamma3High, amrGamma3), ap3)
				amrWeight(az, azAt, high ?? (amrGamma4High, amrGamma4), ap4)
				amrResidual(ap3, 0, synthBuf, amrOrder + at, res2, amrSubframe)
				h.fill(0)
				for let i = 0; i <= amrOrder; i++ {
					h[i] = ap3[i]
				}
				let zeros int[]
				zeros.len(amrOrder)
				let _ = amrSynthesis(ap4, 0, h, 0, h, 0, 22, zeros, false)
				let t = amrLMult(h[0], h[0])
				for let i = 1; i < 22; i++ {
					t = amrLMac(t, h[i], h[i])
				}
				let temp1 = t >> 16
				t = amrLMult(h[0], h[1])
				for let i = 1; i < 21; i++ {
					t = amrLMac(t, h[i], h[i + 1])
				}
				let temp2 = t >> 16
				temp2 = temp2 <= 0 ?? (0, amrDivS(amrMult(temp2, 26214), temp1))
				preemphasis(temp2)
				let _ = amrSynthesis(ap4, 0, res2, 0, syn, at, amrSubframe, memSynPst, true)
				agc(synthBuf, amrOrder + at, syn, at)
			}
			for let i = 0; i < amrOrder; i++ {
				synthBuf[i] = synthBuf[amrFrame + i]
			}
		}

		// Tilt compensation of the residual by the factor `g` (preemphasis).
		def preemphasis(g int) {
			let last = res2[amrSubframe - 1]
			for let i = amrSubframe - 1; i > 0; i-- {
				res2[i] = amrSub(res2[i], amrMult(g, res2[i - 1]))
			}
			res2[0] = amrSub(res2[0], amrMult(g, preemphMem))
			preemphMem = last
		}

		// Scales the post filtered subframe of `out` from `outAt` towards
		// the energy of the unfiltered one of `src` from `srcAt`, smoothly
		// (agc).
		def agc(src int[], srcAt int, out int[], outAt int) {
			let i = amrAgcGain(src, srcAt, out, outAt, amrSubframe)
			if i < 0 {
				agcPastGain = 0
				return
			}
			let g0 = amrMult(i, amrSub(32767, 29491))
			let gain = agcPastGain
			for let k = 0; k < amrSubframe; k++ {
				gain = amrAdd(amrMult(gain, 29491), g0)
				out[outAt + k] = amrLShl(amrLMult(out[outAt + k], gain), 3) >> 16
			}
			agcPastGain = gain
		}

		// The 60 Hz high-pass filter and doubling to 16 bits of the frame
		// (Post_Process).
		def postProcess(signal int[]) {
			for let i = 0; i < amrFrame; i++ {
				let x2 = x1
				x1 = x0
				x0 = signal[i]
				let t = amrMpy32x16(y1Hi, y1Lo, 15836)
				t = amrLAdd(t, amrMpy32x16(y2Hi, y2Lo, -7667))
				t = amrLMac(t, x0, 7699)
				t = amrLMac(t, x1, -15398)
				t = amrLMac(t, x2, 7699)
				t = amrLShl(t, 2)
				signal[i] = amrRound(amrLShl(t, 1))
				y2Hi = y1Hi
				y2Lo = y1Lo
				(y1Hi, y1Lo) = amrLExtract(t)
			}
		}
	}
}
