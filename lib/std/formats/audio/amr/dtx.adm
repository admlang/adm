internal partial module std.formats.audio.amr {
	// Discontinuous transmission on the receiving side (3GPP TS 26.092):
	// SID frames carry the noise's spectrum and energy, and the decoder
	// generates comfort noise from them until speech returns.

	// Receive states of the DTX handler.
	const amrSpeech = 0
	const amrDtx = 1
	const amrDtxMute = 2

	// Frames of history the comfort noise parameters are averaged over.
	const amrDtxHistory = 8

	// Frames without a SID update after which comfort noise fades out.
	const amrDtxMaxEmpty = 50

	// Frames of speech decoded since the last SID after which the next
	// SID adds the hangover's averages (24 + 7 - 1).
	const amrDtxElapsedFrames = 30

	// Frames of speech hangover the encoder sends before a SID.
	const amrDtxHangConst = 7

	// Energy adjustment of the comfort noise by the mode of the speech it
	// follows, the last for a SID frame's own mode.
	const amrDtxLogEnAdjust = int[-1023, -878, -732, -586, -440, -294, -148, 0, 0]

	// How far each LSF of comfort noise may vary around its mean.
	const amrLsfHistMeanScale = int[20000, 20000, 20000, 20000, 20000, 18000, 16384, 8192, 0, 0]

	// The comfort noise generator and the history of decoded speech it
	// averages (dtx_dec).
	type AmrDtxDecoder {
		sinceLastSid     int
		trueSidPeriodInv int
		logEn            int
		oldLogEn         int
		// The generator's state, a one-element array so the pseudo-noise
		// functions update it.
		seed             int[]
		lsp              int[]
		lspOld           int[]
		lsfHist          int[]
		lsfHistPtr       int
		lsfHistMean      int[]
		logPgMean        int
		logEnHist        int[]
		logEnHistPtr     int
		logEnAdjust      int
		hangoverCount    int
		decAnaElapsed    int
		sidFrame         bool
		validData        bool
		hangoverAdded    bool
		// The state of the frame before, one of amrSpeech, amrDtx and
		// amrDtxMute.
		globalState      int
		dataUpdated      bool

		def new() {
			seed.len(1)
			lsp.len(amrOrder)
			lspOld.len(amrOrder)
			lsfHist.len(amrOrder * amrDtxHistory)
			lsfHistMean.len(amrOrder * amrDtxHistory)
			logEnHist.len(amrDtxHistory)
			reset()
		}

		def reset() {
			sinceLastSid = 0
			trueSidPeriodInv = 1 << 13
			logEn = 3500
			oldLogEn = 3500
			seed[0] = 0x70816958
			for let i = 0; i < amrOrder; i++ {
				lsp[i] = amrLspInit[i]
				lspOld[i] = amrLspInit[i]
				for let j = 0; j < amrDtxHistory; j++ {
					lsfHist[j * amrOrder + i] = amrMeanLsf5[i]
				}
			}
			lsfHistPtr = 0
			lsfHistMean.fill(0)
			logPgMean = 0
			logEnHist.fill(logEn)
			logEnHistPtr = 0
			logEnAdjust = 0
			hangoverCount = amrDtxHangConst
			decAnaElapsed = 32767
			sidFrame = false
			validData = false
			hangoverAdded = false
			globalState = amrDtx
			dataUpdated = false
		}

		// The receive state of a frame of type `frameType` (rx_dtx_handler).
		def handle(frameType int) int {
			let state = amrSpeech
			let lost = frameType == amrRxNoData || frameType == amrRxSpeechBad || frameType == amrRxOnset
			let sid = frameType == amrRxSidFirst || frameType == amrRxSidUpdate || frameType == amrRxSidBad
			if sid || ((globalState == amrDtx || globalState == amrDtxMute) && lost) {
				state = amrDtx
				state = amrDtxMute when globalState == amrDtxMute && (frameType == amrRxSidBad || frameType == amrRxSidFirst || frameType == amrRxOnset || frameType == amrRxNoData)
				sinceLastSid = amrAdd(sinceLastSid, 1)
				state = amrDtxMute when frameType != amrRxSidUpdate && amrSub(sinceLastSid, amrDtxMaxEmpty) > 0
			} else {
				sinceLastSid = 0
			}
			decAnaElapsed = 0 when !dataUpdated && frameType == amrRxSidUpdate
			decAnaElapsed = amrAdd(decAnaElapsed, 1)
			hangoverAdded = false
			let encDtx = sid || frameType == amrRxOnset || frameType == amrRxNoData
			encDtx = false when frameType == amrRxNoData && state == amrSpeech
			if !encDtx {
				hangoverCount = amrDtxHangConst
			} else if amrSub(decAnaElapsed, amrDtxElapsedFrames) > 0 {
				hangoverAdded = true
				decAnaElapsed = 0
				hangoverCount = 0
			} else if hangoverCount == 0 {
				decAnaElapsed = 0
			} else {
				hangoverCount = amrSub(hangoverCount, 1)
			}
			if state != amrSpeech {
				sidFrame = sid
				validData = frameType == amrRxSidUpdate
				hangoverAdded = false when frameType == amrRxSidBad
			}
			return state
		}

		// Generates a frame of comfort noise into `synth` and its four
		// subframes' coefficients into `az`, from the SID parameters in
		// `prm` when the frame is one (dtx_dec). `lsf`, `pred` and `smoother`
		// are the speech decoder's, set so speech resumes smoothly.
		def decode(memSyn int[], lsf AmrLsfState, pred AmrGainPredictor, smoother AmrGainSmoother, state int, mode int, prm int[], synth int[], az int[]) {
			averageHangover(mode) when hangoverAdded && sidFrame
			if sidFrame {
				for let i = 0; i < amrOrder; i++ {
					lspOld[i] = lsp[i]
				}
				oldLogEn = logEn
				if validData {
					let length = sinceLastSid.min(32)
					sinceLastSid = 0
					trueSidPeriodInv = amrSub(length, 2) >= 0 ?? (amrDivS(1 << 10, amrShl(length, 10)), 1 << 14)
					lsf.initSid(prm[0])
					lsf.decode3(amrModeDtx, false, prm, 1, lsp)
					lsf.pastRq.fill(0)
					let index = prm[4]
					logEn = amrSub(amrShl(index, 9), 5120)
					logEn = -32768 when index == 0
					if !dataUpdated || globalState == amrSpeech {
						for let i = 0; i < amrOrder; i++ {
							lspOld[i] = lsp[i]
						}
						oldLogEn = logEn
					}
				}
				let maInit = amrSub(amrShr(logEn, 1), 9000).min(0).max(-14436)
				pred.set(maInit, amrMult(5443, maInit))
			}
			logEnAdjust = amrAdd(amrMult(logEnAdjust, 29491), amrShr(amrMult(amrShl(amrDtxLogEnAdjust[mode], 5), 3277), 5))
			let intFac = amrMult(amrShl(amrAdd(1, sinceLastSid), 10), trueSidPeriodInv)
			intFac = amrShl(intFac.min(1024), 4)
			let logEnInt = amrLMult(intFac, logEn)
			let lspInt int[]
			lspInt.len(amrOrder)
			for let i = 0; i < amrOrder; i++ {
				lspInt[i] = amrMult(intFac, lsp[i])
			}
			intFac = amrSub(16384, intFac)
			logEnInt = amrLMac(logEnInt, intFac, oldLogEn)
			for let i = 0; i < amrOrder; i++ {
				lspInt[i] = amrShl(amrAdd(lspInt[i], amrMult(intFac, lspOld[i])), 1)
			}
			let variabFactor = amrSub(4096, amrMult(amrSub(logPgMean, 2457), 9830)).min(4096).max(0)
			variabFactor = amrShl(variabFactor, 3)
			let variabIndex = amrPseudoNoise(seed, 3)
			let lsfInt int[]
			lsfInt.len(amrOrder)
			amrLspToLsf(lspInt, lsfInt)
			let lsfVariab int[]
			lsfVariab.len(amrOrder)
			for let i = 0; i < amrOrder; i++ {
				lsfVariab[i] = amrAdd(lsfInt[i], amrMult(variabFactor, lsfHistMean[i + variabIndex * amrOrder]))
			}
			amrReorderLsf(lsfInt)
			amrReorderLsf(lsfVariab)
			for let i = 0; i < amrOrder; i++ {
				lsf.pastLsf[i] = lsfInt[i]
			}
			let lspVariab int[]
			lspVariab.len(amrOrder)
			amrLsfToLsp(lsfInt, lspInt)
			amrLsfToLsp(lsfVariab, lspVariab)
			let acoeff int[]
			acoeff.len(amrOrder + 1)
			let acoeffVariab int[]
			acoeffVariab.len(amrOrder + 1)
			amrLspToAz(lspInt, acoeff, 0)
			amrLspToAz(lspVariab, acoeffVariab, 0)
			for let k = 0; k < 4; k++ {
				for let i = 0; i <= amrOrder; i++ {
					az[k * (amrOrder + 1) + i] = acoeff[i]
				}
			}
			let refl int[]
			refl.len(amrOrder)
			amrReflection(acoeff, 1, refl)
			let predErr = 32767
			for let i = 0; i < amrOrder; i++ {
				predErr = amrMult(predErr, amrSub(32767, amrMult(refl[i], refl[i])))
			}
			let (pgE, pgM) = amrLog2(predErr)
			let logPg = amrShl(amrSub(pgE, 15), 12)
			logPg = amrShr(amrSub(0, amrAdd(logPg, amrShr(pgM, 3))), 1)
			logPgMean = amrAdd(amrMult(29491, logPgMean), amrMult(3277, logPg))
			logEnInt = amrLShr(logEnInt, 10)
			logEnInt = amrLAdd(logEnInt, 4 * 65536)
			logEnInt = amrLSub(logEnInt, amrLShl(logPg, 4))
			logEnInt = amrLAdd(logEnInt, amrLShl(logEnAdjust, 5))
			let intE = logEnInt >> 16
			let intM = amrW16(amrLShr(amrLSub(logEnInt, intE << 16), 1))
			let level = amrW16(amrPow2(intE, intM))
			let ex int[]
			ex.len(amrSubframe)
			for let k = 0; k < 4; k++ {
				amrComfortCode(seed, ex)
				for let j = 0; j < amrSubframe; j++ {
					ex[j] = amrMult(level, ex[j])
				}
				let _ = amrSynthesis(acoeffVariab, 0, ex, 0, synth, k * amrSubframe, amrSubframe, memSyn, true)
			}
			smoother.hangVar = 20
			smoother.hangCount = 0
			if state == amrDtxMute {
				let length = sinceLastSid.min(32)
				length = 8 when length <= 0
				trueSidPeriodInv = amrDivS(1 << 10, amrShl(length, 10))
				sinceLastSid = 0
				for let i = 0; i < amrOrder; i++ {
					lspOld[i] = lsp[i]
				}
				oldLogEn = logEn
				logEn = amrSub(logEn, 256)
			}
			if sidFrame && (validData || hangoverAdded) {
				sinceLastSid = 0
				dataUpdated = true
			}
		}

		// Replaces the noise parameters with the averages of the speech
		// hangover the encoder sent before the first SID.
		def averageHangover(mode int) {
			logEnAdjust = amrDtxLogEnAdjust[mode]
			let ptr = amrAdd(lsfHistPtr, amrOrder)
			ptr = 0 when ptr == 80
			for let i = 0; i < amrOrder; i++ {
				lsfHist[ptr + i] = lsfHist[lsfHistPtr + i]
			}
			ptr = amrAdd(logEnHistPtr, 1)
			ptr = 0 when ptr == amrDtxHistory
			logEnHist[ptr] = logEnHist[logEnHistPtr]
			logEn = 0
			let sums int[]
			sums.len(amrOrder)
			for let i = 0; i < amrDtxHistory; i++ {
				logEn = amrAdd(logEn, amrShr(logEnHist[i], 3))
				for let j = 0; j < amrOrder; j++ {
					sums[j] = amrLAdd(sums[j], lsfHist[i * amrOrder + j])
				}
			}
			let mean int[]
			mean.len(amrOrder)
			for let j = 0; j < amrOrder; j++ {
				mean[j] = amrW16(amrLShr(sums[j], 3))
			}
			amrLsfToLsp(mean, lsp)
			logEn = amrSub(logEn, logEnAdjust)
			for let i = 0; i < amrOrder * amrDtxHistory; i++ {
				lsfHistMean[i] = lsfHist[i]
			}
			for let i = 0; i < amrOrder; i++ {
				let sum = 0
				for let j = 0; j < amrDtxHistory; j++ {
					sum = amrLAdd(sum, lsfHistMean[i + j * amrOrder])
				}
				let lsfMean = amrW16(amrLShr(sum, 3))
				for let j = 0; j < amrDtxHistory; j++ {
					let at = i + j * amrOrder
					let v = amrMult(amrSub(lsfHistMean[at], lsfMean), amrLsfHistMeanScale[i])
					let negative = v < 0
					v = amrAbs(v)
					v = amrAdd(655, amrShr(amrSub(v, 655), 2)) when amrSub(v, 655) > 0
					v = 1310 when amrSub(v, 1310) > 0
					lsfHistMean[at] = negative ?? (-v, v)
				}
			}
		}

		// Records the LSFs and energy of a decoded speech frame
		// (dtx_dec_activity_update).
		def update(lsf int[], frame int[]) {
			lsfHistPtr = amrAdd(lsfHistPtr, amrOrder)
			lsfHistPtr = 0 when lsfHistPtr == 80
			for let i = 0; i < amrOrder; i++ {
				lsfHist[lsfHistPtr + i] = lsf[i]
			}
			let energy = 0
			for let i = 0; i < 160; i++ {
				energy = amrLMac(energy, frame[i], frame[i])
			}
			let (e, m) = amrLog2(energy)
			let logEnergy = amrAdd(amrShl(e, 10), amrShr(m, 5))
			logEnHistPtr = amrAdd(logEnHistPtr, 1)
			logEnHistPtr = 0 when logEnHistPtr == amrDtxHistory
			logEnHist[logEnHistPtr] = amrSub(logEnergy, 7497 + 1024)
		}
	}
}
