internal partial module std.formats.audio.amr {
	// The excitation part of the AMR-NB decoder (3GPP TS 26.090 section 6.1
	// and TS 26.091): pitch lags, fixed codebook vectors, gains with their
	// prediction and concealment, and the enhancements that follow.

	// Samples of a subframe.
	const amrSubframe = 40

	// Longest pitch lag.
	const amrPitMax = 143

	// Shortest pitch lag of 12.2 kbit/s and of the other modes.
	const amrPitMin122 = 18
	const amrPitMin = 20

	// Largest pitch sharpening factor (0.794 in Q14).
	const amrSharpMax = 13017

	// Energies the gain predictors start from.
	const amrMinEnergy = -14336
	const amrMinEnergy122 = -2381

	// Pitch lag and fraction of the first or third subframe coded in
	// thirds (Dec_lag3); `t0Prev` and the range narrow the other subframes.
	// `flag4` is the 4-bit relative coding of the lower modes.
	def amrDecodeLag3(index int, t0Min int, t0Max int, first bool, t0Prev int, flag4 bool) (int, int) {
		if first {
			if amrSub(index, 197) < 0 {
				let t0 = amrAdd(amrMult(amrAdd(index, 2), 10923), 19)
				let i = amrAdd(amrAdd(t0, t0), t0)
				return (t0, amrAdd(amrSub(index, i), 58))
			}
			return (amrSub(index, 112), 0)
		}
		if !flag4 {
			let i = amrSub(amrMult(amrAdd(index, 2), 10923), 1)
			let t0 = amrAdd(i, t0Min)
			i = amrAdd(amrAdd(i, i), i)
			return (t0, amrSub(amrSub(index, 2), i))
		}
		let lag = t0Prev
		lag = amrAdd(t0Min, 5) when amrSub(amrSub(lag, t0Min), 5) > 0
		lag = amrSub(t0Max, 4) when amrSub(amrSub(t0Max, lag), 4) > 0
		return (amrAdd(amrSub(lag, 5), index), 0) when amrSub(index, 4) < 0
		if amrSub(index, 12) < 0 {
			let i = amrSub(amrMult(amrSub(index, 5), 10923), 1)
			let t0 = amrAdd(i, lag)
			i = amrAdd(amrAdd(i, i), i)
			return (t0, amrSub(amrSub(index, 9), i))
		}
		return (amrAdd(amrAdd(amrSub(index, 12), lag), 1), 0)
	}

	// Pitch lag and fraction of 12.2 kbit/s, coded in sixths (Dec_lag6);
	// `t0` is the last lag, which the second and fourth subframes code
	// relative to.
	def amrDecodeLag6(index int, first bool, t0 int) (int, int) {
		if first {
			if amrSub(index, 463) < 0 {
				let lag = amrAdd(amrMult(amrAdd(index, 5), 5462), 17)
				let i = amrAdd(amrAdd(lag, lag), lag)
				return (lag, amrAdd(amrSub(index, amrAdd(i, i)), 105))
			}
			return (amrSub(index, 368), 0)
		}
		let t0Min = amrSub(t0, 5).max(amrPitMin122)
		let t0Max = amrAdd(t0Min, 9)
		if amrSub(t0Max, amrPitMax) > 0 {
			t0Max = amrPitMax
			t0Min = amrSub(t0Max, 9)
		}
		let i = amrSub(amrMult(amrAdd(index, 5), 5462), 1)
		let lag = amrAdd(i, t0Min)
		i = amrAdd(amrAdd(i, i), i)
		return (lag, amrSub(amrSub(index, 3), amrAdd(i, i)))
	}

	// Sets the pulses at `pos` of `code` with the signs of the bits of
	// `sign`, the first pulse's in the low bit.
	def amrPlacePulses(code int[], pos int[], sign int) {
		code.fill(0)
		let s = sign
		for let j = 0; j < pos.len(); j++ {
			code[pos[j]] = (s & 1) != 0 ?? (8191, -8192)
			s = amrShr(s, 1)
		}
	}

	// The two pulses of 4.75 and 5.15 kbit/s (decode_2i40_9bits).
	def amrCode2i40x9(subframe int, sign int, index int, code int[]) {
		let j = amrShr(index & 64, 6)
		let k = amrAdd(amrShl(j, 3), amrShl(subframe, 1))
		let i0 = index & 7
		let i1 = amrShr(index, 3) & 7
		amrPlacePulses(code, int[amrAdd(i0, amrShl(i0, 2)) + amrStartPos[k], amrAdd(i1, amrShl(i1, 2)) + amrStartPos[k + 1]], sign)
	}

	// The two pulses of 5.9 kbit/s (decode_2i40_11bits).
	def amrCode2i40x11(sign int, index int, code int[]) {
		let j = index & 1
		let v = amrShr(index, 1)
		let i = v & 7
		let pos0 = amrAdd(amrAdd(i, amrShl(i, 2)), amrAdd(amrShl(j, 1), 1))
		v = amrShr(v, 3)
		j = v & 3
		v = amrShr(v, 2)
		i = v & 7
		let pos1 = amrAdd(i, amrShl(i, 2))
		pos1 = amrAdd(pos1, j == 3 ?? (4, j))
		amrPlacePulses(code, int[pos0, pos1], sign)
	}

	// The three pulses of 6.7 kbit/s (decode_3i40_14bits).
	def amrCode3i40x14(sign int, index int, code int[]) {
		let i = index & 7
		let pos0 = amrAdd(i, amrShl(i, 2))
		let v = amrShr(index, 3)
		let j = v & 1
		v = amrShr(v, 1)
		i = v & 7
		let pos1 = amrAdd(amrAdd(i, amrShl(i, 2)), amrAdd(amrShl(j, 1), 1))
		v = amrShr(v, 3)
		j = v & 1
		v = amrShr(v, 1)
		i = v & 7
		let pos2 = amrAdd(amrAdd(i, amrShl(i, 2)), amrAdd(amrShl(j, 1), 2))
		amrPlacePulses(code, int[pos0, pos1, pos2], sign)
	}

	// The four Gray-coded pulses of 7.4 and 7.95 kbit/s
	// (decode_4i40_17bits).
	def amrCode4i40x17(sign int, index int, code int[]) {
		let pos int[]
		pos.len(4)
		let v = index
		for let t = 0; t < 3; t++ {
			let i = amrGray[v & 7]
			pos[t] = amrAdd(amrAdd(i, amrShl(i, 2)), t)
			v = amrShr(v, 3)
		}
		let j = v & 1
		v = amrShr(v, 1)
		let i = amrGray[v & 7]
		pos[3] = amrAdd(amrAdd(i, amrShl(i, 2)), amrAdd(3, j))
		amrPlacePulses(code, pos, sign)
	}

	// Positions of three pulses compressed into 10 bits by 10.2 kbit/s.
	def amrDecompress10(msbs int, lsbs int, index1 int, index2 int, index3 int, pos int[]) {
		let m = msbs.min(124)
		let ia = amrMult(m, 1311)
		ia = amrSub(m, amrW16(amrLShr(amrLMult(ia, 25), 1)))
		let ib = amrShl(amrSub(ia, amrW16(amrLShr(amrLMult(amrMult(ia, 6554), 5), 1))), 1)
		let ic = amrSub(lsbs, amrShl(amrShr(lsbs, 2), 2))
		pos[index1] = amrAdd(ib, ic & 1)
		pos[index2] = amrAdd(amrShl(amrMult(ia, 6554), 1), amrShr(ic, 1))
		pos[index3] = amrAdd(amrShl(amrMult(m, 1311), 1), amrShr(lsbs, 2))
	}

	// The eight pulses of 10.2 kbit/s from the seven parameters at `at`
	// in `prm` (dec_8i40_31bits).
	def amrCode8i40x31(prm int[], at int, code int[]) {
		code.fill(0)
		let pos int[]
		pos.len(8)
		amrDecompress10(amrShr(prm[at + 4], 3), prm[at + 4] & 7, 0, 4, 1, pos)
		amrDecompress10(amrShr(prm[at + 5], 3), prm[at + 5] & 7, 2, 6, 5, pos)
		let msbs = amrShr(prm[at + 6], 2)
		let lsbs = prm[at + 6] & 3
		let m024 = amrShr(amrAdd(amrW16(amrLShr(amrLMult(msbs, 25), 1)), 12), 5)
		let ia = amrMult(m024, 6554) & 1
		let ib = amrSub(m024, amrW16(amrLShr(amrLMult(amrMult(m024, 6554), 5), 1)))
		ib = amrSub(4, ib) when ia == 1
		pos[3] = amrAdd(amrShl(ib, 1), lsbs & 1)
		pos[7] = amrAdd(amrShl(amrMult(m024, 6554), 1), amrShr(lsbs, 1))
		for let j = 0; j < 4; j++ {
			let pos1 = amrAdd(amrW16(amrLShr(amrLMult(pos[j], 4), 1)), j)
			let sign = prm[at + j] == 0 ?? (8191, -8191)
			code[pos1] = sign when pos1 < amrSubframe
			let pos2 = amrAdd(amrW16(amrLShr(amrLMult(pos[j + 4], 4), 1)), j)
			sign = amrNegate(sign) when amrSub(pos2, pos1) < 0
			code[pos2] = amrAdd(code[pos2], sign) when pos2 < amrSubframe
		}
	}

	// The ten pulses of 12.2 kbit/s from the ten parameters at `at` in
	// `prm` (dec_10i40_35bits).
	def amrCode10i40x35(prm int[], at int, code int[]) {
		code.fill(0)
		for let j = 0; j < 5; j++ {
			let tmp = prm[at + j]
			let i = amrGray[tmp & 7]
			let pos1 = amrAdd(amrW16(amrLShr(amrLMult(i, 5), 1)), j)
			let sign = (amrShr(tmp, 3) & 1) == 0 ?? (4096, -4096)
			code[pos1] = sign
			i = amrGray[prm[at + j + 5] & 7]
			let pos2 = amrAdd(amrW16(amrLShr(amrLMult(i, 5), 1)), j)
			sign = amrNegate(sign) when amrSub(pos2, pos1) < 0
			code[pos2] = amrAdd(code[pos2], sign)
		}
	}

	// The MA prediction of the codebook gain: the quantized energies of
	// the last four subframes, for 12.2 kbit/s and for the other modes.
	type AmrGainPredictor {
		pastEnergy    int[]
		pastEnergy122 int[]

		def new() {
			pastEnergy.len(4)
			pastEnergy122.len(4)
			reset()
		}

		def reset() {
			pastEnergy.fill(amrMinEnergy)
			pastEnergy122.fill(amrMinEnergy122)
		}

		// Sets every past energy, as comfort noise does.
		def set(energy int, energy122 int) {
			pastEnergy.fill(energy)
			pastEnergy122.fill(energy122)
		}

		// The predicted codebook gain of the innovation `code` as the
		// exponent and fraction of a power of two (gc_pred).
		def predict(mode int, code int[]) (int, int) {
			let energy = amrLMac(0, code[0], code[0])
			for let i = 1; i < amrSubframe; i++ {
				energy = amrLMac(energy, code[i], code[i])
			}
			if mode == amrMode122 {
				energy = amrLMult(amrRound(energy), 26214)
				let (exp, frac) = amrLog2(energy)
				energy = amrLMac(amrSub(exp, 30) << 16, frac, 1)
				let e = 783741
				for let i = 0; i < 4; i++ {
					e = amrLMac(e, pastEnergy122[i], amrPred122[i])
				}
				return amrLExtract(amrLShr(amrLSub(e, energy), 1))
			}
			let expCode = amrNormL(energy)
			energy = amrLShl(energy, expCode)
			let (exp, frac) = amrLog2Norm(energy, expCode)
			let t = amrMpy32x16(exp, frac, -24660)
			if mode == amrMode102 {
				t = amrLMac(t, 16678, 64)
			} else if mode == amrMode795 {
				t = amrLMac(t, 17062, 64)
			} else if mode == amrMode74 {
				t = amrLMac(t, 32588, 32)
			} else if mode == amrMode67 {
				t = amrLMac(t, 32268, 32)
			} else {
				t = amrLMac(t, 16678, 64)
			}
			t = amrLShl(t, 10)
			for let i = 0; i < 4; i++ {
				t = amrLMac(t, amrPred[i], pastEnergy[i])
			}
			let gcode0 = t >> 16
			t = amrLMult(gcode0, mode == amrMode74 ?? (5439, 5443))
			return amrLExtract(amrLShr(t, 8))
		}

		// Pushes the quantized energies of the current subframe.
		def update(energy122 int, energy int) {
			for let i = 3; i > 0; i-- {
				pastEnergy[i] = pastEnergy[i - 1]
				pastEnergy122[i] = pastEnergy122[i - 1]
			}
			pastEnergy122[0] = energy122
			pastEnergy[0] = energy
		}

		// Pushes the average of the past energies, no lower than their
		// starting values, as a lost subframe does.
		def updateAverage() {
			let avg122 = 0
			let avg = 0
			for let i = 0; i < 4; i++ {
				avg122 = amrAdd(avg122, pastEnergy122[i])
				avg = amrAdd(avg, pastEnergy[i])
			}
			update(amrMult(avg122, 8192).max(amrMinEnergy122), amrMult(avg, 8192).max(amrMinEnergy))
		}
	}

	// The MA prediction coefficients of the codebook gain.
	const amrPred = int[5571, 4751, 2785, 1556]
	const amrPred122 = int[44, 37, 22, 12]

	// The pitch and codebook gains of a jointly quantized subframe
	// (Dec_gain).
	def amrDecodeGains(pred AmrGainPredictor, mode int, index int, code int[], evenSubframe bool) (int, int) {
		let at = amrShl(index, 2)
		let gainPit = 0
		let gCode = 0
		let energy122 = 0
		let energy = 0
		if mode == amrMode102 || mode == amrMode74 || mode == amrMode67 {
			gainPit = amrGainHigh[at]
			gCode = amrGainHigh[at + 1]
			energy122 = amrGainHigh[at + 2]
			energy = amrGainHigh[at + 3]
		} else if mode == amrMode475 {
			at = amrAdd(at, amrShl(evenSubframe ?? (0, 1), 1))
			gainPit = amrGain475[at]
			gCode = amrGain475[at + 1]
			let (e, f) = amrLog2(gCode)
			let exp = amrSub(e, 12)
			energy122 = amrAdd(amrShrR(f, 5), amrShl(exp, 10))
			energy = amrRound(amrLShl(amrMpy32x16(exp, f, 24660), 13))
		} else {
			gainPit = amrGainLow[at]
			gCode = amrGainLow[at + 1]
			energy122 = amrGainLow[at + 2]
			energy = amrGainLow[at + 3]
		}
		let (exp, frac) = pred.predict(mode, code)
		let gcode0 = amrW16(amrPow2(14, frac))
		let t = amrLShr(amrLMult(gCode, gcode0), amrSub(10, exp))
		pred.update(energy122, energy)
		return (gainPit, t >> 16)
	}

	// The codebook gain of a scalar quantized subframe (d_gain_code).
	def amrDecodeCodeGain(pred AmrGainPredictor, mode int, index int, code int[]) int {
		let (exp, frac) = pred.predict(mode, code)
		let p = amrAdd(amrAdd(index, index), index)
		let gain = 0
		if mode == amrMode122 {
			let gcode0 = amrShl(amrW16(amrPow2(exp, frac)), 4)
			gain = amrShl(amrMult(gcode0, amrGainCode[p]), 1)
		} else {
			let gcode0 = amrW16(amrPow2(14, frac))
			gain = amrLShr(amrLMult(amrGainCode[p], gcode0), amrSub(9, exp)) >> 16
		}
		pred.update(amrGainCode[p + 1], amrGainCode[p + 2])
		return gain
	}

	// The pitch gain of a scalar quantized subframe (d_gain_pitch).
	def amrDecodePitchGain(mode int, index int) int {
		let gain = amrGainPitch[index]
		return mode == amrMode122 ?? (gain & 0xFFFC, gain)
	}

	// Attenuation of the concealed gains by the error state (TS 26.091).
	const amrPitchDown = int[32767, 32112, 32112, 26214, 9830, 6553, 6553]
	const amrCodeDown = int[32767, 32112, 32112, 32112, 32112, 32112, 22937]

	// The gain history that conceals the gains of lost subframes
	// (ec_gain_pitch and ec_gain_code).
	type AmrGainConcealer {
		pitchBuf  int[]
		pastPitch int
		prevPitch int
		codeBuf   int[]
		pastCode  int
		prevCode  int

		def new() {
			pitchBuf.len(5)
			codeBuf.len(5)
			reset()
		}

		def reset() {
			pitchBuf.fill(1640)
			pastPitch = 0
			prevPitch = 16384
			codeBuf.fill(1)
			pastCode = 0
			prevCode = 1
		}

		// The pitch gain of a lost subframe in error state `state`.
		def pitch(state int) int {
			let tmp = amrMedian(pitchBuf, 0, 5)
			tmp = pastPitch when amrSub(tmp, pastPitch) > 0
			return amrMult(tmp, amrPitchDown[state])
		}

		// The codebook gain of a lost subframe in error state `state`;
		// updates the predictor as a lost subframe does.
		def code(pred AmrGainPredictor, state int) int {
			let tmp = amrMedian(codeBuf, 0, 5)
			tmp = pastCode when amrSub(tmp, pastCode) > 0
			pred.updateAverage()
			return amrMult(tmp, amrCodeDown[state])
		}

		// Records the subframe's pitch gain; a good subframe after a bad
		// one gets no more than the last good gain. Returns the gain.
		def updatePitch(bfi bool, prevBf bool, gain int) int {
			let g = gain
			if !bfi {
				g = prevPitch when prevBf && amrSub(g, prevPitch) > 0
				prevPitch = g
			}
			pastPitch = amrSub(g, 16384) > 0 ?? (16384, g)
			for let i = 1; i < 5; i++ {
				pitchBuf[i - 1] = pitchBuf[i]
			}
			pitchBuf[4] = pastPitch
			return g
		}

		// Records the subframe's codebook gain, limited as `updatePitch`
		// limits the pitch gain. Returns the gain.
		def updateCode(bfi bool, prevBf bool, gain int) int {
			let g = gain
			if !bfi {
				g = prevCode when prevBf && amrSub(g, prevCode) > 0
				prevCode = g
			}
			pastCode = g
			for let i = 1; i < 5; i++ {
				codeBuf[i - 1] = codeBuf[i]
			}
			codeBuf[4] = g
			return g
		}
	}

	// The codebook gain smoothing of stationary background noise in the
	// lower modes (Cb_gain_average).
	type AmrGainSmoother {
		history   int[]
		hangVar   int
		hangCount int

		def new() {
			history.len(7)
			reset()
		}

		def reset() {
			history.fill(0)
			hangVar = 0
			hangCount = 0
		}

		// The codebook gain to mix into the excitation, smoothed towards
		// its recent mean when the LSFs `lsf` stay close to their average
		// `lsfAverage`.
		def average(mode int, gainCode int, lsf int[], lsfAverage int[], bfi bool, prevBf bool, pdfi bool, prevPdf bool, background bool, voicedHangover int) int {
			let mix = gainCode
			for let i = 0; i < 6; i++ {
				history[i] = history[i + 1]
			}
			history[6] = gainCode
			let diff = 0
			for let i = 0; i < amrOrder; i++ {
				let tmp1 = amrAbs(amrSub(lsfAverage[i], lsf[i]))
				let shift1 = amrSub(amrNormS(tmp1), 1)
				tmp1 = amrShl(tmp1, shift1)
				let shift2 = amrNormS(lsfAverage[i])
				let tmp2 = amrShl(lsfAverage[i], shift2)
				let t = amrDivS(tmp1, tmp2)
				let shift = amrSub(amrAdd(2, shift1), shift2)
				t = shift >= 0 ?? (amrShr(t, shift), amrShl(t, amrNegate(shift)))
				diff = i == 0 ?? (t, amrAdd(diff, t))
			}
			hangVar = amrSub(diff, 5325) > 0 ?? (amrAdd(hangVar, 1), 0)
			hangCount = 0 when amrSub(hangVar, 10) > 0
			let lowMode = mode == amrMode475 || mode == amrMode515 || mode == amrMode59
			if mode <= amrMode67 || mode == amrMode102 {
				let noisy = ((pdfi && prevPdf) || bfi || prevBf) && amrSub(voicedHangover, 1) > 0 && background && lowMode
				let over = amrSub(diff, noisy ?? (4506, 3277)).max(0)
				let bgMix = amrSub(2048, over) < 0 ?? (8192, amrShl(over, 2))
				bgMix = 8192 when amrSub(hangCount, 40) < 0 || amrSub(diff, 5325) > 0
				let sum = amrLMult(6554, history[2])
				for let i = 3; i < 7; i++ {
					sum = amrLMac(sum, 6554, history[i])
				}
				let mean = amrRound(sum)
				if (bfi || prevBf) && background && lowMode {
					sum = amrLMult(4681, history[0])
					for let i = 1; i < 7; i++ {
						sum = amrLMac(sum, 4681, history[i])
					}
					mean = amrRound(sum)
				}
				sum = amrLMult(bgMix, mix)
				sum = amrLMac(sum, 8192, mean)
				sum = amrLMsu(sum, bgMix, mean)
				mix = amrRound(amrLShl(sum, 2))
			}
			hangCount = amrAdd(hangCount, 1)
			return mix
		}
	}

	// The anti-sparseness processing of the lower modes (ph_disp): spreads
	// the innovation's pulses through an impulse response picked by the
	// pitch gain.
	type AmrPhaseDispersion {
		gainMem    int[]
		prevState  int
		prevCbGain int
		lockFull   bool
		onset      int

		def new() {
			gainMem.len(5)
			reset()
		}

		def reset() {
			gainMem.fill(0)
			prevState = 0
			prevCbGain = 0
			lockFull = false
			onset = 0
		}

		// Rebuilds the total excitation `x` from its adaptive part `x`,
		// the innovation `inno` (dispersed in place) and the gains.
		def apply(mode int, x int[], cbGain int, ltpGain int, inno int[], pitchFac int, shift int) {
			for let i = 4; i > 0; i-- {
				gainMem[i] = gainMem[i - 1]
			}
			gainMem[0] = ltpGain
			let impNr = amrSub(ltpGain, 14746) < 0 ?? (amrSub(ltpGain, 9830) > 0 ?? (1, 0), 2)
			let tmp1 = amrRound(amrLShl(amrLMult(prevCbGain, 16384), 2))
			if amrSub(cbGain, tmp1) > 0 {
				onset = 2
			} else if onset > 0 {
				onset = amrSub(onset, 1)
			}
			if onset == 0 {
				let i1 = 0
				for let i = 0; i < 5; i++ {
					i1 = amrAdd(i1, 1) when amrSub(gainMem[i], 9830) < 0
				}
				impNr = 0 when amrSub(i1, 2) > 0
			}
			impNr = amrSub(impNr, 1) when amrSub(impNr, amrAdd(prevState, 1)) > 0 && onset == 0
			impNr = amrAdd(impNr, 1) when amrSub(impNr, 2) < 0 && onset > 0
			impNr = 2 when amrSub(cbGain, 10) < 0
			impNr = 0 when lockFull
			prevState = impNr
			prevCbGain = cbGain
			if mode != amrMode122 && mode != amrMode102 && mode != amrMode74 && amrSub(impNr, 2) < 0 {
				let saved int[]
				saved.len(amrSubframe)
				let pulses int[]
				for let i = 0; i < amrSubframe; i++ {
					pulses.push(i) when inno[i] != 0
					saved[i] = inno[i]
					inno[i] = 0
				}
				let imp = mode == amrMode795 ?? (impNr == 0 ?? (amrPhImpLow795, amrPhImpMid795), impNr == 0 ?? (amrPhImpLow, amrPhImpMid))
				for let ppos in pulses {
					let j = 0
					for let i = ppos; i < amrSubframe; i++ {
						inno[i] = amrAdd(inno[i], amrMult(saved[ppos], imp[j]))
						j++
					}
					for let i = 0; i < ppos; i++ {
						inno[i] = amrAdd(inno[i], amrMult(saved[ppos], imp[j]))
						j++
					}
				}
			}
			for let i = 0; i < amrSubframe; i++ {
				let t = amrLMult(x[i], pitchFac)
				t = amrLMac(t, inno[i], cbGain)
				x[i] = amrRound(amrLShl(t, shift))
			}
		}
	}

	// The energy of the `n` samples of `x` from `at`, scaled by 1/16, or
	// of the samples divided by 4 when that saturates.
	def amrEnergy(x int[], at int, n int) int {
		let s = amrLMult(x[at], x[at])
		for let i = 1; i < n; i++ {
			s = amrLMac(s, x[at + i], x[at + i])
		}
		return amrLShr(s, 4) when s != 0x7FFFFFFF
		let t = amrShr(x[at], 2)
		s = amrLMult(t, t)
		for let i = 1; i < n; i++ {
			t = amrShr(x[at + i], 2)
			s = amrLMac(s, t, t)
		}
		return s
	}

	// The gain that scales `out` to the energy of `src`, in Q12 once
	// shifted left by 9 and rounded; -1 when `out` is silent.
	def amrAgcGain(src int[], srcAt int, out int[], outAt int, n int) int {
		let s = amrEnergy(out, outAt, n)
		return -1 when s == 0
		let exp = amrSub(amrNormL(s), 1)
		let gainOut = amrRound(amrLShl(s, exp))
		s = amrEnergy(src, srcAt, n)
		return 0 when s == 0
		let i = amrNormL(s)
		let gainIn = amrRound(amrLShl(s, i))
		exp = amrSub(exp, i)
		s = amrDivS(gainOut, gainIn)
		s = amrLShr(amrLShl(s, 7), exp)
		return amrRound(amrLShl(amrInvSqrt(s), 9))
	}

	// Scales the `n` samples of `out` from `outAt` to the energy of those
	// of `src` from `srcAt`, without smoothing (agc2).
	def amrAgc2(src int[], srcAt int, out int[], outAt int, n int) {
		let g0 = amrAgcGain(src, srcAt, out, outAt, n)
		return when g0 < 0
		for let i = 0; i < n; i++ {
			out[outAt + i] = amrLShl(amrLMult(out[outAt + i], g0), 3) >> 16
		}
	}

	// Limits the excitation energy of a lost subframe in background noise
	// to the recent energies (Ex_ctrl).
	def amrExcitationControl(exc int[], energy int, history int[], voicedHangover int, prevBf bool, careful bool) {
		let avg = amrMedian(history, 0, 9)
		let prev = amrShr(amrAdd(history[7], history[8]), 1)
		prev = history[8] when amrSub(history[8], prev) < 0
		return unless amrSub(energy, avg) < 0 && amrSub(energy, 5) > 0
		let test = amrShl(prev, 2)
		test = amrSub(test, prev) when amrSub(voicedHangover, 7) < 0 || prevBf
		avg = test when amrSub(avg, test) > 0
		let exp = amrNormS(energy)
		let e = amrDivS(16383, amrShl(energy, exp))
		let t = amrLShr(amrLMult(avg, e), amrSub(20, exp))
		t = 32767 when amrLSub(t, 32767) > 0
		let scale = amrW16(t)
		scale = 3072 when careful && amrSub(scale, 3072) > 0
		for let i = 0; i < amrSubframe; i++ {
			exc[i] = amrW16(amrLShr(amrLMult(scale, exc[i]), 11))
		}
	}

	// Frames of energy kept by the background noise detector.
	const amrEnergyHistory = 60

	// The background noise detector (Bgn_scd): whether the decoded speech
	// is stationary noise, which the lower modes then smooth.
	type AmrNoiseDetector {
		energyHist int[]
		hangover   int

		def new() {
			energyHist.len(amrEnergyHistory)
			reset()
		}

		def reset() {
			energyHist.fill(0)
			hangover = 0
		}

		// Whether the frame `speech` is background noise; updates the
		// voiced hangover from the pitch gains `ltpGains`.
		def detect(ltpGains int[], speech int[], voicedHangover int) (bool, int) {
			let s = 0
			for let i = 0; i < 160; i++ {
				s = amrLMac(s, speech[i], speech[i])
			}
			let energy = amrLShl(s, 2) >> 16
			let minEnergy = 32767
			for let i = 0; i < amrEnergyHistory; i++ {
				minEnergy = energyHist[i] when amrSub(energyHist[i], minEnergy) < 0
			}
			let noiseFloor = amrShl(minEnergy, 4)
			let maxEnergy = energyHist[0]
			for let i = 1; i < amrEnergyHistory - 4; i++ {
				maxEnergy = energyHist[i] when amrSub(maxEnergy, energyHist[i]) < 0
			}
			let maxLast = energyHist[40]
			for let i = 41; i < amrEnergyHistory; i++ {
				maxLast = energyHist[i] when amrSub(maxLast, energyHist[i]) < 0
			}
			if amrSub(maxEnergy, 20) > 0 && amrSub(energy, 17578) < 0 && amrSub(energy, 20) > 0 && (amrSub(energy, noiseFloor) < 0 || amrSub(maxLast, 1953) < 0) {
				hangover = amrSub(amrAdd(hangover, 1), 30) > 0 ?? (30, amrAdd(hangover, 1))
			} else {
				hangover = 0
			}
			let noise = amrSub(hangover, 1) > 0
			for let i = 0; i < amrEnergyHistory - 1; i++ {
				energyHist[i] = energyHist[i + 1]
			}
			energyHist[amrEnergyHistory - 1] = energy
			let limit = 13926
			limit = 15565 when amrSub(hangover, 8) > 0
			limit = 16383 when amrSub(hangover, 15) > 0
			let voiced = amrSub(amrMedian(ltpGains, 4, 5), limit) > 0
			voiced = amrSub(amrMedian(ltpGains, 0, 9), limit) > 0 when amrSub(hangover, 20) > 0
			return (noise, 0) when voiced
			let temp = amrAdd(voicedHangover, 1)
			return (noise, amrSub(temp, 10) > 0 ?? (10, temp))
		}
	}

	// The next `bits` bits of the comfort noise generator.
	def amrPseudoNoise(seed int[], bits int) int {
		let out = 0
		for let i = 0; i < bits; i++ {
			let reg = seed[0]
			let sn = (reg & 1) ^ ((reg >> 28) & 1)
			out = amrShl(out, 1) | (reg & 1)
			reg = amrLShr(reg, 1)
			reg |= 0x40000000 when sn != 0
			seed[0] = reg
		}
		return out
	}

	// A random innovation of ten pulses for comfort noise (build_CN_code).
	def amrComfortCode(seed int[], code int[]) {
		code.fill(0)
		for let k = 0; k < 10; k++ {
			let i = amrShr(amrW16(amrLMult(amrPseudoNoise(seed, 2), 10)), 1)
			i = amrAdd(i, k)
			code[i] = amrPseudoNoise(seed, 1) > 0 ?? (4096, -4096)
		}
	}
}
