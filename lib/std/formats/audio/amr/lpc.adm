internal partial module std.formats.audio.amr {
	// The linear prediction part of the AMR-NB decoder (3GPP TS 26.090
	// sections 5.2 and 6.2): LSF dequantization, LSF/LSP conversion,
	// interpolation, and the filters built from the prediction coefficients.

	// Order of the prediction filter.
	const amrOrder = 10

	// Minimum distance between two dequantized LSFs.
	const amrLsfGap = 205

	// The LSP prediction factor of 12.2 kbit/s (0.65 in Q15).
	const amrLspPredFac122 = 21299

	// The LSPs a decoder starts from.
	const amrLspInit = int[30000, 26000, 21000, 15000, 8000, 0, -8000, -15000, -21000, -26000]

	// The LSF dequantizer's memory: the last residual and the last LSFs.
	type AmrLsfState {
		pastRq  int[]
		pastLsf int[]

		def new() {
			pastRq.len(amrOrder)
			pastLsf.len(amrOrder)
			reset()
		}

		def reset() {
			pastRq.fill(0)
			for let i = 0; i < amrOrder; i++ {
				pastLsf[i] = amrMeanLsf5[i]
			}
		}

		// Sets the prediction residual to the initial one a SID frame
		// selects.
		def initSid(index int) {
			for let i = 0; i < amrOrder; i++ {
				pastRq[i] = amrPastRqInit[index * amrOrder + i]
			}
		}

		// Dequantizes the three split indices at `at` in `prm` of the modes
		// other than 12.2 kbit/s into `lsp` (D_plsf_3). A bad frame instead
		// moves the LSFs towards their mean. `mode` 8 is a SID frame, whose
		// residual is predicted without the prediction factors.
		def decode3(mode int, bfi bool, prm int[], at int, lsp int[]) {
			let lsf int[]
			lsf.len(amrOrder)
			if bfi {
				for let i = 0; i < amrOrder; i++ {
					lsf[i] = amrAdd(amrMult(pastLsf[i], 29491), amrMult(amrMeanLsf3[i], 3277))
				}
				for let i = 0; i < amrOrder; i++ {
					let pred = mode != amrModeDtx ?? (amrMult(pastRq[i], amrPredFac3[i]), pastRq[i])
					pastRq[i] = amrSub(lsf[i], amrAdd(amrMeanLsf3[i], pred))
				}
			} else {
				let low = mode == amrMode475 || mode == amrMode515
				let cb1 = mode == amrMode795 ?? (amrLsf3Dico1Mr795, amrLsf3Dico1)
				let cb3 = low ?? (amrLsf3Dico3Mr515, amrLsf3Dico3)
				let r int[]
				r.len(amrOrder)
				let index = prm[at]
				let p = amrAdd(index, amrAdd(index, index))
				r[0] = cb1[p]
				r[1] = cb1[p + 1]
				r[2] = cb1[p + 2]
				index = prm[at + 1]
				index = amrShl(index, 1) when low
				p = amrAdd(index, amrAdd(index, index))
				r[3] = amrLsf3Dico2[p]
				r[4] = amrLsf3Dico2[p + 1]
				r[5] = amrLsf3Dico2[p + 2]
				p = amrShl(prm[at + 2], 2)
				for let i = 0; i < 4; i++ {
					r[6 + i] = cb3[p + i]
				}
				for let i = 0; i < amrOrder; i++ {
					let pred = mode != amrModeDtx ?? (amrMult(pastRq[i], amrPredFac3[i]), pastRq[i])
					lsf[i] = amrAdd(r[i], amrAdd(amrMeanLsf3[i], pred))
					pastRq[i] = r[i]
				}
			}
			amrReorderLsf(lsf)
			for let i = 0; i < amrOrder; i++ {
				pastLsf[i] = lsf[i]
			}
			amrLsfToLsp(lsf, lsp)
		}

		// Dequantizes the five split indices at `at` in `prm` of 12.2 kbit/s
		// into the LSPs of the second and fourth subframes (D_plsf_5).
		def decode5(bfi bool, prm int[], at int, lspMid int[], lspNew int[]) {
			let lsf1 int[]
			lsf1.len(amrOrder)
			let lsf2 int[]
			lsf2.len(amrOrder)
			if bfi {
				for let i = 0; i < amrOrder; i++ {
					lsf1[i] = amrAdd(amrMult(pastLsf[i], 31128), amrMult(amrMeanLsf5[i], 1639))
					lsf2[i] = lsf1[i]
				}
				for let i = 0; i < amrOrder; i++ {
					let temp = amrAdd(amrMeanLsf5[i], amrMult(pastRq[i], amrLspPredFac122))
					pastRq[i] = amrSub(lsf2[i], temp)
				}
			} else {
				let r1 int[]
				r1.len(amrOrder)
				let r2 int[]
				r2.len(amrOrder)
				amrSplit5(amrLsf5Dico1, amrShl(prm[at], 2), false, r1, r2, 0)
				amrSplit5(amrLsf5Dico2, amrShl(prm[at + 1], 2), false, r1, r2, 2)
				amrSplit5(amrLsf5Dico3, amrShl(amrShr(prm[at + 2], 1), 2), (prm[at + 2] & 1) != 0, r1, r2, 4)
				amrSplit5(amrLsf5Dico4, amrShl(prm[at + 3], 2), false, r1, r2, 6)
				amrSplit5(amrLsf5Dico5, amrShl(prm[at + 4], 2), false, r1, r2, 8)
				for let i = 0; i < amrOrder; i++ {
					let temp = amrAdd(amrMeanLsf5[i], amrMult(pastRq[i], amrLspPredFac122))
					lsf1[i] = amrAdd(r1[i], temp)
					lsf2[i] = amrAdd(r2[i], temp)
					pastRq[i] = r2[i]
				}
			}
			amrReorderLsf(lsf1)
			amrReorderLsf(lsf2)
			for let i = 0; i < amrOrder; i++ {
				pastLsf[i] = lsf2[i]
			}
			amrLsfToLsp(lsf1, lspMid)
			amrLsfToLsp(lsf2, lspNew)
		}
	}

	// Copies the two residual pairs at `p` in `dico` to `r1` and `r2` from
	// `at`, negated when `negative`.
	def amrSplit5(dico int[], p int, negative bool, r1 int[], r2 int[], at int) {
		if negative {
			r1[at] = amrNegate(dico[p])
			r1[at + 1] = amrNegate(dico[p + 1])
			r2[at] = amrNegate(dico[p + 2])
			r2[at + 1] = amrNegate(dico[p + 3])
		} else {
			r1[at] = dico[p]
			r1[at + 1] = dico[p + 1]
			r2[at] = dico[p + 2]
			r2[at + 1] = dico[p + 3]
		}
	}

	// Keeps the LSFs at least `amrLsfGap` apart.
	def amrReorderLsf(lsf int[]) {
		let min = amrLsfGap
		for let i = 0; i < amrOrder; i++ {
			lsf[i] = min when amrSub(lsf[i], min) < 0
			min = amrAdd(lsf[i], amrLsfGap)
		}
	}

	// The LSPs (cosine domain) of the LSFs. LSFs past the grid, which only
	// damaged frames give, take its last segment.
	def amrLsfToLsp(lsf int[], lsp int[]) {
		for let i = 0; i < amrOrder; i++ {
			let ind = amrShr(lsf[i], 8).min(63)
			let offset = lsf[i] & 0xFF
			let t = amrLMult(amrSub(amrLspCos[ind + 1], amrLspCos[ind]), offset)
			lsp[i] = amrAdd(amrLspCos[ind], amrW16(amrLShr(t, 9)))
		}
	}

	// The LSFs of the LSPs.
	def amrLspToLsf(lsp int[], lsf int[]) {
		let ind = 63
		for let i = amrOrder - 1; i >= 0; i-- {
			for amrSub(amrLspCos[ind], lsp[i]) < 0 {
				ind--
			}
			let t = amrLMult(amrSub(lsp[i], amrLspCos[ind]), amrLspSlope[ind])
			lsf[i] = amrAdd(amrRound(amrLShl(t, 3)), amrShl(ind, 8))
		}
	}

	// The coefficients of the sum or difference polynomial of the LSPs at
	// `first`, `first` + 2 and so on (Get_lsp_pol).
	def amrLspPolynomial(lsp int[], first int, f int[]) {
		f[0] = amrLMult(4096, 2048)
		f[1] = amrLMsu(0, lsp[first], 512)
		let l = first + 2
		for let i = 2; i <= 5; i++ {
			f[i] = f[i - 2]
			for let j = i; j > 1; j-- {
				let (hi, lo) = amrLExtract(f[j - 1])
				let t = amrLShl(amrMpy32x16(hi, lo, lsp[l]), 1)
				f[j] = amrLSub(amrLAdd(f[j], f[j - 2]), t)
			}
			f[1] = amrLMsu(f[1], lsp[l], 512)
			l += 2
		}
	}

	// The prediction coefficients `a[at..at + 10]` of the LSPs.
	def amrLspToAz(lsp int[], a int[], at int) {
		let f1 int[]
		f1.len(6)
		let f2 int[]
		f2.len(6)
		amrLspPolynomial(lsp, 0, f1)
		amrLspPolynomial(lsp, 1, f2)
		for let i = 5; i > 0; i-- {
			f1[i] = amrLAdd(f1[i], f1[i - 1])
			f2[i] = amrLSub(f2[i], f2[i - 1])
		}
		a[at] = 4096
		for let i = 1; i <= 5; i++ {
			a[at + i] = amrW16(amrLShrR(amrLAdd(f1[i], f2[i]), 13))
			a[at + 11 - i] = amrW16(amrLShrR(amrLSub(f1[i], f2[i]), 13))
		}
	}

	// The coefficients of the four subframes, interpolated from the last
	// frame's LSPs to this one's (Int_lpc_1to3).
	def amrInterpolate1to3(lspOld int[], lspNew int[], az int[]) {
		let lsp int[]
		lsp.len(amrOrder)
		for let i = 0; i < amrOrder; i++ {
			lsp[i] = amrAdd(amrShr(lspNew[i], 2), amrSub(lspOld[i], amrShr(lspOld[i], 2)))
		}
		amrLspToAz(lsp, az, 0)
		for let i = 0; i < amrOrder; i++ {
			lsp[i] = amrAdd(amrShr(lspOld[i], 1), amrShr(lspNew[i], 1))
		}
		amrLspToAz(lsp, az, 11)
		for let i = 0; i < amrOrder; i++ {
			lsp[i] = amrAdd(amrShr(lspOld[i], 2), amrSub(lspNew[i], amrShr(lspNew[i], 2)))
		}
		amrLspToAz(lsp, az, 22)
		amrLspToAz(lspNew, az, 33)
	}

	// The coefficients of the four subframes of 12.2 kbit/s, which codes
	// the LSPs of the second and fourth (Int_lpc_1and3).
	def amrInterpolate1and3(lspOld int[], lspMid int[], lspNew int[], az int[]) {
		let lsp int[]
		lsp.len(amrOrder)
		for let i = 0; i < amrOrder; i++ {
			lsp[i] = amrAdd(amrShr(lspMid[i], 1), amrShr(lspOld[i], 1))
		}
		amrLspToAz(lsp, az, 0)
		amrLspToAz(lspMid, az, 11)
		for let i = 0; i < amrOrder; i++ {
			lsp[i] = amrAdd(amrShr(lspMid[i], 1), amrShr(lspNew[i], 1))
		}
		amrLspToAz(lsp, az, 22)
		amrLspToAz(lspNew, az, 33)
	}

	// The LSFs of subframe `subframe` (a sample offset: 0, 40, 80 or 120)
	// interpolated between the last frame's and this one's (Int_lsf).
	def amrInterpolateLsf(lsfOld int[], lsfNew int[], subframe int, out int[]) {
		for let i = 0; i < amrOrder; i++ {
			if subframe == 0 {
				out[i] = amrAdd(amrSub(lsfOld[i], amrShr(lsfOld[i], 2)), amrShr(lsfNew[i], 2))
			} else if subframe == 40 {
				out[i] = amrAdd(amrShr(lsfOld[i], 1), amrShr(lsfNew[i], 1))
			} else if subframe == 80 {
				out[i] = amrAdd(amrShr(lsfOld[i], 2), amrSub(lsfNew[i], amrShr(lsfNew[i], 2)))
			} else {
				out[i] = lsfNew[i]
			}
		}
	}

	// Filters the `n` samples of `x` from `xAt` through 1/A(z), `a` from
	// `aAt`, into `y` from `yAt`, continuing from the ten outputs in `mem`
	// (Syn_filt). `x` and `y` may be the same array at the same offset.
	// Updates `mem` when `update`. Returns whether any operation saturated.
	def amrSynthesis(a int[], aAt int, x int[], xAt int, y int[], yAt int, n int, mem int[], update bool) bool {
		let yy int[]
		yy.len(n + amrOrder)
		for let i = 0; i < amrOrder; i++ {
			yy[i] = mem[i]
		}
		let overflow = false
		for let i = 0; i < n; i++ {
			let s = x[xAt + i] * a[aAt] * 2
			overflow = true when s == 0x80000000
			s = amrSat32(s)
			for let j = 1; j <= amrOrder; j++ {
				let p = a[aAt + j] * yy[amrOrder + i - j] * 2
				overflow = true when p == 0x80000000
				let v = s - amrSat32(p)
				overflow = true when v != amrSat32(v)
				s = amrSat32(v)
			}
			overflow = true when s > 0x0FFFFFFF || s < -0x10000000
			s = amrLShl(s, 3)
			overflow = true when s + 0x8000 > 0x7FFFFFFF
			yy[amrOrder + i] = amrRound(s)
		}
		for let i = 0; i < n; i++ {
			y[yAt + i] = yy[amrOrder + i]
		}
		if update {
			for let i = 0; i < amrOrder; i++ {
				mem[i] = y[yAt + n - amrOrder + i]
			}
		}
		return overflow
	}

	// The residual of the `n` samples of `x` from `xAt` through A(z), `a`
	// from `aAt`, into `y` (Residu). Reads the ten samples before `xAt`.
	def amrResidual(a int[], aAt int, x int[], xAt int, y int[], n int) {
		for let i = 0; i < n; i++ {
			let s = amrLMult(x[xAt + i], a[aAt])
			for let j = 1; j <= amrOrder; j++ {
				s = amrLMac(s, a[aAt + j], x[xAt + i - j])
			}
			y[i] = amrRound(amrLShl(s, 3))
		}
	}

	// The coefficients `a` from `aAt` weighted by the factors `fac` into
	// `out` (Weight_Ai).
	def amrWeight(a int[], aAt int, fac int[], out int[]) {
		out[0] = a[aAt]
		for let i = 1; i <= amrOrder; i++ {
			out[i] = amrRound(amrLMult(a[aAt + i], fac[i - 1]))
		}
	}

	// The reflection coefficients of the prediction coefficients `a` from
	// `at` (A_Refl); all zero when the filter is unstable.
	def amrReflection(a int[], at int, refl int[]) {
		let aState int[]
		aState.len(amrOrder)
		let bState int[]
		bState.len(amrOrder)
		for let i = 0; i < amrOrder; i++ {
			aState[i] = a[at + i]
		}
		for let i = amrOrder - 1; i >= 0; i-- {
			if amrSub(amrAbs(aState[i]), 4096) >= 0 {
				refl.fill(0)
				return
			}
			refl[i] = amrShl(aState[i], 3)
			let acc = amrLSub(0x7FFFFFFF, amrLMult(refl[i], refl[i]))
			let normShift = amrNormL(acc)
			let scale = amrSub(15, normShift)
			let normProd = amrRound(amrLShl(acc, normShift))
			let mult = amrDivS(16384, normProd)
			for let j = 0; j < i; j++ {
				let t = amrRound(amrLMsu(aState[j] << 16, refl[i], aState[i - j - 1]))
				let v = amrLShrR(amrLMult(mult, t), scale)
				if amrLSub(amrLAbs(v), 32767) > 0 {
					refl.fill(0)
					return
				}
				bState[j] = amrW16(v)
			}
			for let j = 0; j < i; j++ {
				aState[j] = bState[j]
			}
		}
	}

	// Fills `n` samples of the excitation `exc` from `at` with the past
	// excitation `t0` samples back, interpolated at the fraction `frac`
	// of thirds (`thirds`) or sixths (Pred_lt_3or6).
	def amrPredictLtp(exc int[], at int, t0 int, frac int, n int, thirds bool) {
		let x0 = at - t0
		let f = amrNegate(frac)
		f = amrShl(f, 1) when thirds
		if f < 0 {
			f = amrAdd(f, 6)
			x0--
		}
		for let j = 0; j < n; j++ {
			let x1 = x0
			x0++
			let s = 0
			for let i = 0; i < 10; i++ {
				s = amrLMac(s, exc[x1 - i], amrInter6[f + i * 6])
				s = amrLMac(s, exc[x0 + i], amrInter6[6 - f + i * 6])
			}
			exc[at + j] = amrRound(s)
		}
	}
}
