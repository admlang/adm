internal partial module std.formats.audio.amr {
	// The fixed-point arithmetic of 3GPP TS 26.073: every value is a 16-bit
	// or 32-bit integer, and the operations saturate, round and shift
	// exactly as the reference's basic operators do, so the output is
	// bit-exact.

	// x as a signed 16-bit value, wrapping.
	def amrW16(x int) int {
		return ((x + 32768) & 0xFFFF) - 32768
	}

	// x as a signed 32-bit value, wrapping.
	def amrW32(x int) int {
		return ((x + 0x80000000) & 0xFFFFFFFF) - 0x80000000
	}

	// x limited to -32768..32767.
	def amrSat16(x int) int {
		return 32767 when x > 32767
		return -32768 when x < -32768
		return x
	}

	// x limited to the signed 32-bit range.
	def amrSat32(x int) int {
		return 0x7FFFFFFF when x > 0x7FFFFFFF
		return -2147483648 when x < -2147483648
		return x
	}

	// a + b, saturated to 16 bits.
	def amrAdd(a int, b int) int {
		return amrSat16(a + b)
	}

	// a - b, saturated to 16 bits.
	def amrSub(a int, b int) int {
		return amrSat16(a - b)
	}

	// (a * b) >> 15, saturated to 16 bits.
	def amrMult(a int, b int) int {
		return amrSat16((a * b) >> 15)
	}

	// (a * b) >> 15 rounded, saturated to 16 bits.
	def amrMultR(a int, b int) int {
		return amrSat16((a * b + 0x4000) >> 15)
	}

	// a * b * 2, saturated to 32 bits.
	def amrLMult(a int, b int) int {
		return amrSat32(a * b * 2)
	}

	// acc + a * b * 2, saturated to 32 bits.
	def amrLMac(acc int, a int, b int) int {
		return amrSat32(acc + amrLMult(a, b))
	}

	// acc - a * b * 2, saturated to 32 bits.
	def amrLMsu(acc int, a int, b int) int {
		return amrSat32(acc - amrLMult(a, b))
	}

	// a + b, saturated to 32 bits.
	def amrLAdd(a int, b int) int {
		return amrSat32(a + b)
	}

	// a - b, saturated to 32 bits.
	def amrLSub(a int, b int) int {
		return amrSat32(a - b)
	}

	// v shifted left by n (right when n is negative), saturated to 16 bits.
	def amrShl(v int, n int) int {
		return amrShr(v, -n.max(-16)) when n < 0
		return v == 0 ?? (0, v > 0 ?? (32767, -32768)) when n > 15
		return amrSat16(v << n)
	}

	// v shifted right by n (left when n is negative), with the sign.
	def amrShr(v int, n int) int {
		return amrShl(v, -n.max(-16)) when n < 0
		return v < 0 ?? (-1, 0) when n >= 15
		return v >> n
	}

	// v shifted right by n and rounded.
	def amrShrR(v int, n int) int {
		return 0 when n > 15
		let out = amrShr(v, n)
		out++ when n > 0 && (v & (1 << (n - 1))) != 0
		return out
	}

	// v shifted left by n (right when n is negative), saturated to 32 bits.
	def amrLShl(v int, n int) int {
		return amrLShr(v, -n.max(-32)) when n <= 0
		let x = v
		for let i = 0; i < n; i++ {
			return 0x7FFFFFFF when x > 0x3FFFFFFF
			return -2147483648 when x < -0x40000000
			x *= 2
		}
		return x
	}

	// v shifted right by n (left when n is negative), with the sign.
	def amrLShr(v int, n int) int {
		return amrLShl(v, -n.max(-32)) when n < 0
		return v < 0 ?? (-1, 0) when n >= 31
		return v >> n
	}

	// v shifted right by n and rounded.
	def amrLShrR(v int, n int) int {
		return 0 when n > 31
		let out = amrLShr(v, n)
		out++ when n > 0 && (v & (1 << (n - 1))) != 0
		return out
	}

	// The upper 16 bits of v, rounded.
	def amrRound(v int) int {
		return amrLAdd(v, 0x8000) >> 16
	}

	// -v, saturated to 16 bits.
	def amrNegate(v int) int {
		return v == -32768 ?? (32767, -v)
	}

	// |v|, saturated to 16 bits.
	def amrAbs(v int) int {
		return v == -32768 ?? (32767, v.abs())
	}

	// |v|, saturated to 32 bits.
	def amrLAbs(v int) int {
		return v == -2147483648 ?? (0x7FFFFFFF, v.abs())
	}

	// The left shift that normalises the 16-bit v; 0 for 0.
	def amrNormS(v int) int {
		return 0 when v == 0
		return 15 when v == -1
		let x = v < 0 ?? (~v, v)
		let n = 0
		for x < 0x4000 {
			x <<= 1
			n++
		}
		return n
	}

	// The left shift that normalises the 32-bit v; 0 for 0.
	def amrNormL(v int) int {
		return 0 when v == 0
		return 31 when v == -1
		let x = v < 0 ?? (~v, v)
		let n = 0
		for x < 0x40000000 {
			x <<= 1
			n++
		}
		return n
	}

	// a / b in Q15 for 0 <= a <= b. The reference aborts on other
	// arguments; here they give 0, or 32767 when a exceeds b.
	def amrDivS(a int, b int) int {
		return 0 when a <= 0 || b <= 0
		return 32767 when a >= b
		let num = a
		let out = 0
		for let i = 0; i < 15; i++ {
			out <<= 1
			num <<= 1
			if num >= b {
				num -= b
				out++
			}
		}
		return out
	}

	// The high and low parts of the 32-bit v in double precision format:
	// v = hi << 16 + lo << 1.
	def amrLExtract(v int) (int, int) {
		let hi = v >> 16
		return (hi, amrW16(amrLMsu(v >> 1, hi, 16384)))
	}

	// The double precision (hi, lo) value times the 16-bit n.
	def amrMpy32x16(hi int, lo int, n int) int {
		return amrLMac(amrLMult(hi, n), amrMult(lo, n), 1)
	}

	// 2 to the power of exponent + fraction, fraction in Q15.
	def amrPow2(exponent int, fraction int) int {
		let x = amrLMult(fraction, 32)
		let i = (x >> 16) & 31
		let a = amrW16(x >> 1) & 0x7FFF
		x = amrPow2Table[i] << 16
		x = amrLMsu(x, amrSub(amrPow2Table[i], amrPow2Table[i + 1]), a)
		return amrLShrR(x, amrSub(30, exponent))
	}

	// The base 2 logarithm of x normalised by `exp` left shifts: the
	// exponent and the fraction in Q15.
	def amrLog2Norm(x int, exp int) (int, int) {
		return (0, 0) when x <= 0
		let v = x >> 9
		let i = (v >> 16) - 32
		let a = amrW16(v >> 1) & 0x7FFF
		let y = amrLMsu(amrLog2Table[i] << 16, amrSub(amrLog2Table[i], amrLog2Table[i + 1]), a)
		return (amrSub(30, exp), y >> 16)
	}

	// The base 2 logarithm of x: the exponent and the fraction in Q15.
	def amrLog2(x int) (int, int) {
		let exp = amrNormL(x)
		return amrLog2Norm(amrLShl(x, exp), exp)
	}

	// 1 / sqrt(x), with x and the result in Q31.
	def amrInvSqrt(x int) int {
		return 0x3FFFFFFF when x <= 0
		let exp = amrNormL(x)
		let v = amrLShl(x, exp)
		exp = 30 - exp
		v >>= 1 when (exp & 1) == 0
		exp = (exp >> 1) + 1
		v >>= 9
		let i = (v >> 16) - 16
		let a = amrW16(v >> 1) & 0x7FFF
		let y = amrLMsu(amrInvSqrtTable[i] << 16, amrSub(amrInvSqrtTable[i], amrInvSqrtTable[i + 1]), a)
		return amrLShr(y, exp)
	}

	// sqrt(x) and the even left shift x was normalised by: the square
	// root of the original x is the result >> (shift / 2).
	def amrSqrtLExp(x int) (int, int) {
		return (0, 0) when x <= 0
		let e = amrNormL(x) & 0xFFFE
		let v = amrLShl(x, e) >> 9
		let i = (v >> 16) - 16
		let a = amrW16(v >> 1) & 0x7FFF
		let y = amrLMsu(amrSqrtTable[i] << 16, amrSub(amrSqrtTable[i], amrSqrtTable[i + 1]), a)
		return (y, e)
	}

	// The median of the `n` values of `values` from `at`.
	def amrMedian(values int[], at int, n int) int {
		let tmp int[]
		tmp.len(n)
		let order int[]
		order.len(n)
		for let i = 0; i < n; i++ {
			tmp[i] = values[at + i]
		}
		for let i = 0; i < n; i++ {
			let max = -32767
			let ix = 0
			for let j = 0; j < n; j++ {
				if tmp[j] >= max {
					max = tmp[j]
					ix = j
				}
			}
			tmp[ix] = -32768
			order[i] = ix
		}
		return values[at + order[n >> 1]]
	}
}
