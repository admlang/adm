partial module std.formats.audio {
	use (
		std.testing
		std.bytes
		std.os
		std.formats.audio.loader::*
		std.formats.audio.amr::*
	)

	check "AMR" {
		// 3 s of synthetic voiced sound, 1 s of noise between, encoded by
		// the 3GPP reference encoder (TS 26.073) with DTX, the mode moving
		// through all eight every six frames: 150 frames, 5 of them SID
		// and 30 without data.
		let speech = "samples/audio/amr/speech.amr"

		// A polynomial hash of the samples as the reference's 16-bit
		// output, so a whole decode is compared with the reference's.
		def hash(samples float32[], ch int, channels int) int {
			let h = 0
			for let i = ch; i < samples.len(); i += channels {
				let v = int(float(samples[i]) * 32768.0)
				h = (h * 31 + (v & 0xFFFF)) & 0xFFFFFFFF
			}
			return h
		}

		// The file's frames, the magic line dropped.
		def frames(data byte[]) byte[][] {
			let out byte[][]
			let at = 6
			for at < data.len() {
				let size = amrFrameSize(int(data[at]))
				out.push(data[at:at + size].clone())
				at += size
			}
			return out
		}

		// The file with the quality bit of every fifth frame cleared, as a
		// damaged frame arrives.
		def damaged(data byte[]) byte[] {
			let out = data.clone()
			let at = 6
			let k = 0
			for at < out.len() {
				out[at] = out[at] & byte(0xFB) when k % 5 == 0
				at += amrFrameSize(int(out[at]))
				k++
			}
			return out
		}

		@test()
		def TestInfo() !none {
			let data = try os.readFile(speech)
			let stream = try new AMR().open(new bytes.Reader(data))
			defer stream.close()
			let info = stream.info()
			try testing.expectEqual(uint32(8000), info.sampleRate)
			try testing.expectEqual(uint16(1), info.channels)
			try testing.expectEqual(uint64(24000), info.frames)
			try testing.expectEqual("amr", info.codec)
			assert info.seekable
		}

		@test()
		def TestBitExactToTheReference() !none {
			let data = try os.readFile(speech)
			let stream = try new AMR().open(new bytes.Reader(data))
			defer stream.close()
			let sound = try drain(stream)
			try testing.expectEqual(24000, sound.samples.len())
			// The 3GPP reference decoder's output.
			try testing.expectEqual(1627601576, hash(sound.samples, 0, 1))
			let want = int[160, -152, -208, -200]
			for let i = 0; i < 4; i++ {
				try testing.expectEqual(float32(want[i]) / 32768.0, sound.samples[4000 + i])
			}
		}

		@test()
		def TestPacketsMatchTheStream() !none {
			let data = try os.readFile(speech)
			let dec = try new AMR().decoder(byte[])
			let got float32[]
			let packet byte[]
			let k = 0
			for let f in frames(data) {
				packet = packet.concat(f)
				k++
				if k % 3 == 0 {
					got = got.concat(try dec.decode(packet))
					packet = byte[]
				}
			}
			got = got.concat(try dec.decode(packet))
			try testing.expectEqual(24000, got.len())
			try testing.expectEqual(1627601576, hash(got, 0, 1))
			try testing.expectEqual(uint32(8000), dec.info().sampleRate)
		}

		@test()
		def TestDamagedFramesAreConcealed() !none {
			let data = damaged(try os.readFile(speech))
			let stream = try new AMR().open(new bytes.Reader(data))
			defer stream.close()
			let sound = try drain(stream)
			// The reference decoder's output for the same damaged frames.
			try testing.expectEqual(1945633032, hash(sound.samples, 0, 1))
		}

		@test()
		def TestDecoderHoming() !none {
			// The 12.2 kbit/s decoder homing frame (TS 26.073 section 6).
			let homing = byte[0x3C, 0x08, 0x55, 0x6D, 0x94, 0x4C, 0x71, 0xA1, 0xA0, 0x81, 0xE7, 0xEA, 0xD2, 0x04, 0x24, 0x44, 0x80, 0x00, 0x0E, 0xCD, 0x82, 0xB8, 0x11, 0x18, 0x00, 0x00, 0x97, 0xC4, 0x79, 0x4E, 0x77, 0x40]
			let data = try os.readFile(speech)
			let packet = homing.concat(homing).concat(frames(data)[20]).concat(homing)
			let got = try (try new AMR().decoder(byte[])).decode(packet)
			try testing.expectEqual(640, got.len())
			// A homed decoder answers homing frames with the homing pattern.
			for let i = 0; i < 320; i++ {
				try testing.expectEqual(float32(8) / 32768.0, got[i])
			}
			try testing.expectEqual(1271519976, hash(got, 0, 1))
		}

		@test()
		def TestMultichannel() !none {
			let data = try os.readFile(speech)
			let clean = frames(data)
			let bad = frames(damaged(data))
			let file = "#!AMR_MC1.0\n".bytes().concat(byte[0, 0, 0, 2])
			for let i = 0; i < clean.len(); i++ {
				file = file.concat(clean[i]).concat(bad[i])
			}
			let stream = try new AMR().open(new bytes.Reader(file))
			defer stream.close()
			try testing.expectEqual(uint16(2), stream.info().channels)
			let sound = try drain(stream)
			try testing.expectEqual(48000, sound.samples.len())
			try testing.expectEqual(1627601576, hash(sound.samples, 0, 2))
			try testing.expectEqual(1945633032, hash(sound.samples, 1, 2))
		}

		@test()
		def TestThreeGppFile() !none {
			// The same frames as `samr` samples of a 3GP file, as a phone
			// records them.
			let stream = try open("samples/audio/amr/speech.3gp")
			defer stream.close()
			let info = stream.info()
			try testing.expectEqual("amr", info.codec)
			try testing.expectEqual(uint32(8000), info.sampleRate)
			let sound = try drain(stream)
			try testing.expectEqual(24000, sound.samples.len())
			try testing.expectEqual(1627601576, hash(sound.samples, 0, 1))
		}

		@test()
		def TestSeek() !none {
			let data = try os.readFile(speech)
			let stream = try new AMR().open(new bytes.Reader(data))
			defer stream.close()
			try stream.seek(uint64(12000))
			try testing.expectEqual(uint64(12000), stream.position())
			let sound = try drain(stream)
			try testing.expectEqual(12000, sound.samples.len())
		}

		@test()
		def TestRegistryPicksTheCodec() !none {
			let stream = try open(speech)
			defer stream.close()
			try testing.expectEqual("amr", stream.info().codec)
			assert new AMR().matchSignature(new bytes.Reader("#!AMR\n".bytes()))
			assert new AMR().matchSignature(new bytes.Reader("#!AMR_MC1.0\n".bytes()))
			// Wideband files are another codec's.
			assert !new AMR().matchSignature(new bytes.Reader("#!AMR-WB\n".bytes()))
		}

		@test()
		def TestEncodingIsNotImplemented() !none {
			let data = try os.readFile(speech)
			let stream = try new AMR().open(new bytes.Reader(data))
			defer stream.close()
			assert new AMR().encode(stream, new bytes.Buffer()) is error
		}

		@test()
		def TestRefusesOtherData() !none {
			assert new AMR().open(new bytes.Reader(byte[1, 2, 3, 4, 5, 6, 7, 8])) is error
			assert new AMR().open(new bytes.Reader("#!AMR_MC1.0\n".bytes().concat(byte[0, 0, 0, 0]))) is error
		}
	}
}
