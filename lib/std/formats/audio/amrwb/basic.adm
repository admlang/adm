internal partial module std.formats.audio.amrwb {
	// The fixed-point arithmetic of the AMR-WB decoder: 16-bit and 32-bit
	// integers whose operations saturate, round, shift and wrap exactly as
	// the fixed-point reference decoder's do, so the output is bit-exact.

	const wbMax32 = 0x7FFFFFFF
	const wbMin32 = -2147483648

	// x as a signed 16-bit value, wrapping.
	def wbW16(x int) int {
		return ((x + 32768) & 0xFFFF) - 32768
	}

	// x as a signed 32-bit value, wrapping.
	def wbW32(x int) int {
		return ((x + 0x80000000) & 0xFFFFFFFF) - 0x80000000
	}

	// x limited to -32768..32767.
	def wbSat16(x int) int {
		return 32767 when x > 32767
		return -32768 when x < -32768
		return x
	}

	// x limited to the signed 32-bit range.
	def wbSat32(x int) int {
		return wbMax32 when x > wbMax32
		return wbMin32 when x < wbMin32
		return x
	}

	// a + b, saturated to 16 bits.
	def wbAdd(a int, b int) int {
		return wbSat16(a + b)
	}

	// a - b, saturated to 16 bits.
	def wbSub(a int, b int) int {
		return wbSat16(a - b)
	}

	// (a * b) >> 15, saturated to 16 bits.
	def wbMult(a int, b int) int {
		return wbSat16((a * b) >> 15)
	}

	// (a * b) >> 15 rounded, saturated to 16 bits.
	def wbMultR(a int, b int) int {
		return wbSat16((a * b + 0x4000) >> 15)
	}

	// a + b, saturated to 32 bits.
	def wbAdd32(a int, b int) int {
		return wbSat32(a + b)
	}

	// a - b, saturated to 32 bits.
	def wbSub32(a int, b int) int {
		return wbSat32(a - b)
	}

	// a * b * 2, saturated to 32 bits.
	def wbMul(a int, b int) int {
		let p = a * b
		return p == 0x40000000 ?? (wbMax32, p * 2)
	}

	// acc + a * b * 2, saturated to 32 bits.
	def wbMac(acc int, a int, b int) int {
		return wbSat32(acc + wbMul(a, b))
	}

	// acc - a * b * 2, saturated to 32 bits.
	def wbMsu(acc int, a int, b int) int {
		return wbSat32(acc - wbMul(a, b))
	}

	// The upper 16 bits of the 32-bit v, rounded.
	def wbRound(v int) int {
		return 32767 when v == wbMax32
		return wbW16(wbW32(v + 0x8000) >> 16)
	}

	// The upper 16 bits of the 32-bit v shifted left by one, rounded and
	// saturated.
	def wbShl1Round(v int) int {
		return wbW16((v + 0x4000) >> 15) when v >= -0x40000000 && v < 0x40000000
		return wbW16(((v >> 31) ^ wbMax32) >> 16)
	}

	// The upper 16 bits of the 32-bit v.
	def wbHigh(v int) int {
		return wbW16(v >> 16)
	}

	// The 16-bit v in the upper half of a 32-bit value.
	def wbDepositHigh(v int) int {
		return wbW32(v << 16)
	}

	// -v, saturated to 16 bits.
	def wbNegate(v int) int {
		return v == -32768 ?? (32767, -v)
	}

	// v shifted left by n, saturated to 16 bits; a negative n shifts right
	// by its low four bits.
	def wbShl(v int, n int) int {
		return v >> ((-n) & 15) when n < 0
		let s = n & 15
		let out = wbW16(v << s)
		return (out >> s) != v ?? ((v >> 15) ^ 32767, out)
	}

	// v shifted left by n modulo 32 (as the reference compiled for x86
	// shifts), saturated to 32 bits; a zero or negative n shifts right by
	// its low four bits.
	def wbShl32(v int, n int) int {
		return v >> ((-n) & 15) when n <= 0
		let s = n & 31
		let out = wbW32(v << s)
		return (out >> s) != v ?? ((v >> 31) ^ wbMax32, out)
	}

	// v shifted right by n; a negative n shifts left, saturated to 32 bits.
	def wbShr32(v int, n int) int {
		return v >> (n & 31) when n >= 0
		let s = (-n) & 31
		let out = wbW32(v << s)
		return (out >> s) != v ?? ((v >> 31) ^ wbMax32, out)
	}

	// v shifted right by the low four bits of n, rounded.
	def wbShrRound(v int, n int) int {
		let out = wbW16(v >> (n & 15))
		out++ when n != 0 && (v & (1 << (n - 1))) != 0
		return out
	}

	// The left shift that normalises the 32-bit x, as the reference
	// computes it (also for zero and negative x).
	def wbNorm(x int) int {
		let i = 0
		if x > 0x0FFFFFFF {
			i = 0
		} else if x > 0x00FFFFFF {
			i = 3
		} else if x > 0x0000FFFF {
			i = x > 0x000FFFFF ?? (7, 11)
		} else if x > 0x000000FF {
			i = x > 0x00000FFF ?? (15, 19)
		} else {
			i = x > 0x0000000F ?? (23, 27)
		}
		let top = wbW32(x << i) & 0x78000000
		if top == 0x08000000 {
			i += 3
		} else if top == 0x18000000 || top == 0x10000000 {
			i += 2
		} else if top >= 0x20000000 && top < 0x40000000 {
			i++
		}
		return i
	}

	// The left shift that normalises the 16-bit x.
	def wbNormS(x int) int {
		return wbNorm(x) - 16
	}

	// a / b in Q15 for 0 <= a <= b; 0 for other arguments.
	def wbDiv(a int, b int) int {
		return 0 when a > b || a < 0
		return 0 when a == 0
		return 32767 when a == b
		let num = a
		let out = 0
		for let k = 0; k < 15; k++ {
			out <<= 1
			num <<= 1
			if num >= b {
				num -= b
				out |= 1
			}
		}
		return out
	}

	// The 32-bit v in double precision format: v = hi << 16 + lo << 1.
	def wbDpf(v int) (int, int) {
		let hi = wbW16(v >> 16)
		return (hi, wbW16((v - (hi << 16)) >> 1))
	}

	// The product of two double precision values.
	def wbMpyDpf(hi1 int, lo1 int, hi2 int, lo2 int) int {
		let v = wbMul(hi1, hi2)
		v = wbMac(v, wbMult(hi1, lo2), 1)
		return wbMac(v, wbMult(lo1, hi2), 1)
	}

	// The double precision (hi, lo) times the 16-bit n, divided by 2^15.
	def wbMul32x16(hi int, lo int, n int) int {
		return wbW32((hi * n + ((lo * n) >> 15)) << 1)
	}

	// The 32-bit v times the 16-bit n, divided by 2^16.
	def wbMulHigh(v int, n int) int {
		return wbW32((v * wbW32(n << 16)) >> 32)
	}

	// The next value of the noise generator seeded by `seed`.
	def wbNoise(seed int) int {
		return wbW16(seed * 31821 + 13849)
	}

	// 1 / sqrt(frac * 2^exp) as a normalised fraction and exponent.
	def wbInvSqrtNorm(fraction int, exponent int) (int, int) {
		return (wbMax32, 0) when fraction <= 0
		let frac = fraction
		frac >>= 1 when (exponent & 1) == 1
		let exp = wbNegate(wbW16((exponent - 1) >> 1))
		frac >>= 9
		let i = wbHigh(frac)
		frac >>= 1
		let a = wbW16(frac) & 0x7FFF
		i -= 16
		let tmp = wbInvSqrtTable[i] - wbInvSqrtTable[i + 1]
		return (wbMsu(wbDepositHigh(wbInvSqrtTable[i]), tmp, a), exp)
	}

	// 1 / sqrt(x) for the 32-bit x.
	def wbInvSqrt(x int) int {
		let exp = wbNorm(x)
		let (frac, e) = wbInvSqrtNorm(wbW32(x << exp), 31 - exp)
		return wbShl32(frac, e)
	}

	// 2 to the power of exponent + fraction, fraction in Q15; shift
	// counts are taken modulo 32 as x86 does.
	def wbPow2(exponent int, fraction int) int {
		let x = fraction << 5
		let i = fraction >> 10
		let a = wbW16(x) & 0x7FFF
		x = wbPow2Table[i] << 15
		x -= wbW16(wbPow2Table[i] - wbPow2Table[i + 1]) * a
		let e = 29 - exponent
		x = (x >> (e & 31)) + ((x >> ((e - 1) & 31)) & 1) when e != 0
		return wbW32(x)
	}

	// The dot product of the `n` values of x and y from their offsets,
	// normalised: the product and its exponent.
	def wbDot(x int[], xAt int, y int[], yAt int, n int) (int, int) {
		let sum = 1
		for let i = 0; i < n; i++ {
			sum = wbMac(sum, x[xAt + i], y[yAt + i])
		}
		let sft = wbNorm(sum)
		return (wbW32(sum << sft), 30 - sft)
	}

	// The base 2 logarithm of x normalised by `exp` left shifts: the
	// exponent and the fraction in Q15.
	def wbLog2Norm(x int, exp int) (int, int) {
		return (0, 0) when x <= 0
		let v = x >> 9
		let i = wbHigh(v)
		v >>= 1
		let a = wbW16(v) & 0x7FFF
		i -= 32
		let tmp = wbLog2Table[i] - wbLog2Table[i + 1]
		let y = wbMsu(wbDepositHigh(wbLog2Table[i]), tmp, a)
		return (30 - exp, wbHigh(y))
	}

	// The base 2 logarithm of x: the exponent and the fraction in Q15.
	def wbLog2(x int) (int, int) {
		let exp = wbNorm(x)
		return wbLog2Norm(wbShl32(x, exp), exp)
	}

	// Rescales the `n` values of x from `at` by 2^exp, rounding.
	def wbScale(x int[], at int, n int, exp int) {
		if exp > 0 {
			for let i = 0; i < n; i++ {
				x[at + i] = wbRound(wbShl32(x[at + i] << 16, exp))
			}
		} else if exp < 0 {
			let e = (-exp) & 15
			let tmp = wbW16(0x8000 >> (16 - e))
			for let i = 0; i < (n >> 1) * 2; i++ {
				x[at + i] = wbAdd(x[at + i], tmp) >> e
			}
		}
	}
}
