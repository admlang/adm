internal partial module std.formats.audio.amrwb {
	// The AMR-WB speech decoder of 3GPP TS 26.190, bit-exact to the
	// PacketVideo fixed-point decoder (the one libopencore-amrwb carries):
	// a frame's parameters in, 320 samples at 16 kHz out, with the
	// concealment of lost and damaged frames, comfort noise and decoder
	// homing.

	// Samples of a frame at 12.8 kHz and at 16 kHz.
	const wbFrame = 256
	const wbFrame16k = 320

	// Parameter bits of each mode, 6.60 to 23.85 kbit/s, then SID.
	const wbBits660 = 132
	const wbBits885 = 177
	const wbBits1265 = 253
	const wbBits1425 = 285
	const wbBits1585 = 317
	const wbBits1825 = 365
	const wbBits1985 = 397
	const wbBits2305 = 461
	const wbBits2385 = 477
	const wbModeBits = int[132, 177, 253, 285, 317, 365, 397, 461, 477, 35]

	// Frame type of a SID frame.
	const wbModeSid = 9

	// The largest scaling of the excitation.
	const wbQMax = 8

	// The value a homed decoder outputs for each sample of a homing frame.
	const wbHomingSample = 0x0008

	// A frame's parameter bits, one per entry, read most significant bit
	// first.
	type WbBits {
		bits int[]
		at   int

		def new() {
			bits.len(wbBits2385)
		}

		// The next n bits as an unsigned number.
		def read(n int) int {
			let v = 0
			for let i = 0; i < n; i++ {
				v = (v << 1) | bits[at]
				at++
			}
			return v
		}
	}

	// One decoder: the speech decoder's state, the homing and frame type
	// bookkeeping around it, and its working buffers.
	type AmrWbDecoder {
		oldExc      int[]
		ispOld      int[]
		isfOld      int[]
		isfBuf      int[]
		pastIsfq    int[]
		tiltCode    int
		qOld        int
		qSubfr      int[]
		gcThres     int
		memSynHi    int[]
		memSynLo    int[]
		memDeemph   int[]
		memSigOut   int[]
		memOversamp int[]
		memSynHf    int[]
		memHf       int[]
		memHf3      int[]
		seed        int
		seed2       int
		oldT0       int
		oldT0Frac   int
		lagHist     int[]
		gain        WbGainState
		seed3       int
		dispMem     int[]
		memHp400    int[]
		prevBad     bool
		state       int
		firstFrame  bool
		dtx         WbDtxState
		vadHist     int
		// The wrapper's bookkeeping: the mode of the last frame with data,
		// the last mode a frame named, and the homing flags.
		modeOld     int
		prevMode    int
		resetFlag   bool
		resetOld    bool
		bits        WbBits
		// Working buffers.
		exc         int[]
		aq          int[]
		ispNew      int[]
		isf         int[]
		isfTmp      int[]
		code        int[]
		excp        int[]
		exc2        int[]
		hfIsf       int[]
		synthHi     int[]
		synthLo     int[]
		synth       int[]
		hf          int[]
		ap          int[]
		hfA         int[]
		scratch     int[]
		// 32-bit scratch and filter taps of the vectorised filters.
		scratch32   int32[]
		bandTaps    int32[]
		lowTaps     int32[]
		upTaps      int32[]
		pitchTaps   int32[]
		ind         int[]
		out         int[]

		def new() {
			oldExc.len(wbExcAt)
			ispOld.len(wbOrder)
			isfOld.len(wbOrder)
			isfBuf.len(wbMeanBuf * wbOrder)
			pastIsfq.len(wbOrder)
			qSubfr.len(4)
			memSynHi.len(wbOrder)
			memSynLo.len(wbOrder)
			memDeemph.len(1)
			memSigOut.len(6)
			memOversamp.len(24)
			memSynHf.len(wbOrder16k)
			memHf.len(30)
			memHf3.len(30)
			lagHist.len(5)
			gain = new WbGainState()
			dispMem.len(8)
			memHp400.len(6)
			dtx = new WbDtxState()
			bits = new WbBits()
			exc.len(wbFrame + 1 + wbExcAt)
			aq.len(4 * (wbOrder + 1))
			ispNew.len(wbOrder)
			isf.len(wbOrder)
			isfTmp.len(wbOrder)
			code.len(wbSubframe)
			excp.len(wbSubframe)
			exc2.len(wbFrame)
			hfIsf.len(wbOrder16k)
			synthHi.len(wbOrder + wbSubframe)
			synthLo.len(wbOrder + wbSubframe)
			synth.len(wbSubframe)
			hf.len(wbSubframe16k)
			ap.len(wbOrder16k + 1)
			hfA.len(wbOrder16k + 1)
			scratch.len(2 * wbSubframe16k)
			scratch32.len(wbExcAt + 2 * wbSubframe)
			bandTaps = wbTaps32(wbFir6k7k, int[wbFir6k7k[0]])
			lowTaps = wbTaps32(wbFir7k, int[])
			upTaps = wbTaps32(wbFirUp, int[])
			pitchTaps = wbTaps32(wbInter4, int[])
			ind.len(8)
			out.len(wbFrame16k)
			reset(true)
			resetOld = true
		}

		// Returns the decoder to its initial state; without `all`, only the
		// part comfort noise resets (pvDecoder_AmrWb_Reset).
		def reset(all bool) {
			oldExc.fill(0)
			pastIsfq.fill(0)
			oldT0Frac = 0
			oldT0 = 64
			firstFrame = true
			gcThres = 0
			tiltCode = 0
			dispMem.fill(0)
			qOld = wbQMax
			qSubfr.fill(wbQMax)
			return unless all
			gain.reset()
			memOversamp.fill(0)
			memHf.fill(0)
			memHf3.fill(0)
			memSigOut.fill(0)
			memHp400.fill(0)
			lagHist.fill(64)
			for let i = 0; i < wbOrder; i++ {
				ispOld[i] = wbIspInit[i]
				isfOld[i] = wbIsfInit[i]
			}
			for let j = 0; j < wbMeanBuf; j++ {
				for let i = 0; i < wbOrder; i++ {
					isfBuf[j * wbOrder + i] = wbIsfInit[i]
				}
			}
			memDeemph[0] = 0
			seed = 21845
			seed2 = 21845
			seed3 = 21845
			state = 0
			prevBad = false
			memSynHf.fill(0)
			memSynHi.fill(0)
			memSynLo.fill(0)
			dtx.reset()
			vadHist = 0
		}

		// Decodes one frame of the storage format (RFC 4867 section 5.3):
		// `header` is its first byte and `payload` holds its bytes from
		// `at`. A frame whose quality bit is clear decodes as damaged.
		// Returns 320 samples.
		def decodeStored(header int, payload byte[], at int) int[] {
			let ft = (header >> 3) & 15
			let good = (header & 4) != 0
			let mode = ft
			let rx = wbRxNoData
			let n = ft <= wbModeSid ?? (wbModeBits[ft], 0)
			let order = wbSortTable(ft)
			for let i = 0; i < n; i++ {
				bits.bits[i] = 0
			}
			for let i = 0; i < n; i++ {
				let byteAt = at + (i >> 3)
				bits.bits[order[i]] = 1 when byteAt < payload.len() && ((int(payload[byteAt]) >> (7 - (i & 7))) & 1) != 0
			}
			if ft < wbModeSid {
				rx = good ?? (wbRxSpeechGood, wbRxSpeechBad)
			} else {
				if ft == wbModeSid {
					let sti = 0
					let stiAt = at + 4
					sti = (int(payload[stiAt]) >> 4) & 1 when stiAt < payload.len()
					rx = good ?? (sti == 1 ?? (wbRxSidUpdate, wbRxSidFirst), wbRxSidBad)
				} else if ft == 14 {
					rx = wbRxSpeechLost
				}
				mode = prevMode
			}
			prevMode = mode
			return decodeFrame(rx, mode)
		}

		// Decodes the frame in `bits` of receive type `rx` and mode `mode`,
		// homing as the reference does: a decoder homing frame arriving
		// while homed outputs the homing pattern, and any homing frame
		// resets the decoder after it.
		def decodeFrame(rx int, frameMode int) int[] {
			let mode = frameMode
			if rx == wbRxNoData || rx == wbRxSpeechLost {
				mode = modeOld
				resetFlag = false
			} else {
				modeOld = mode
				resetFlag = isHoming(mode, true) when resetOld
			}
			if resetFlag && resetOld {
				out.fill(wbHomingSample)
			} else {
				decodeSpeech(mode, rx)
			}
			for let i = 0; i < wbFrame16k; i++ {
				out[i] = wbW16(out[i] & 0xFFFC)
			}
			resetFlag = isHoming(mode, false) unless resetOld
			reset(true) when resetFlag
			resetOld = resetFlag
			return out
		}

		// Whether the bits are the decoder homing frame of `mode`, up to
		// the end of the first subframe when `first`.
		def isHoming(mode int, first bool) bool {
			return false when mode == wbModeSid
			let pattern = wbHomingFrame(mode)
			let param int[]
			param.len(32)
			bits.at = 0
			let count = 0
			let shift = 0
			if mode != 8 {
				let nparms = first ?? (wbHomingFirstBits[mode], wbModeBits[mode])
				let j = 0
				for nparms - 15 > j {
					param[count] = bits.read(15)
					j += 15
					count++
				}
				let rest = nparms - j
				param[count] = wbShl(bits.read(rest), 15 - rest)
				shift = 15 - rest
			} else {
				for count < 31 {
					let v = bits.read(15)
					v &= 0x61FF when count == 10
					v &= 0xE0FF when count == 17
					v &= 0x7F0F when count == 24
					param[count] = v
					count++
				}
				param[31] = wbShl(bits.read(8), 7)
			}
			let i = 0
			let diff = 0
			for i < count {
				diff = param[i] ^ pattern[i]
				break when diff != 0
				i++
			}
			let mask = wbShl(0x7FFF >> shift, shift)
			diff |= param[i] ^ (pattern[i] & mask)
			return diff == 0
		}

		// Decodes a frame into `out` (pvDecoder_AmrWb).
		def decodeSpeech(mode int, rx int) {
			let nbBits = wbModeBits[mode]
			bits.at = 0
			let newState = dtx.receive(rx)
			dtx.generate(exc2, newState, isf, bits) when newState != wbSpeech
			let bad = false
			let lost = false
			if rx == wbRxSpeechBad || rx == wbRxSpeechDegraded {
				bad = true
			} else if rx == wbRxNoData || rx == wbRxSpeechLost {
				bad = true
				lost = true
			}
			if bad {
				state = (state + 1).min(6)
			} else {
				state >>= 1
			}
			if dtx.globalState == wbDtx {
				state = 5
				prevBad = false
			} else if dtx.globalState == wbDtxMute {
				state = 5
				prevBad = true
			}
			if newState == wbSpeech {
				let vad = bits.read(1)
				vadHist = vad == 0 ?? (wbAdd(vadHist, 1), 0) unless bad
			} else {
				wbIsfToIsp(isf, ispNew, wbOrder)
				wbIspToLpc(ispNew, aq, 0, wbOrder, true)
				for let i = 0; i < wbOrder; i++ {
					isfTmp[i] = isfOld[i]
				}
				for let sub = 0; sub < 4; sub++ {
					interpolateHfIsf(sub)
					synthesise(0, exc2, sub * wbSubframe, 0, sub * wbSubframe16k, 1, nbBits, newState, bad)
				}
				reset(false)
				for let i = 0; i < wbOrder; i++ {
					isfOld[i] = isf[i]
				}
				prevBad = bad
				dtx.globalState = newState
				return
			}
			for let i = 0; i < wbExcAt; i++ {
				exc[i] = oldExc[i]
			}
			if nbBits > wbBits660 {
				ind[0] = bits.read(8)
				ind[1] = bits.read(8)
				ind[2] = bits.read(6)
				ind[3] = bits.read(7)
				ind[4] = bits.read(7)
				ind[5] = bits.read(5)
				ind[6] = bits.read(5)
				wbDecodeIsf46(ind, isf, pastIsfq, isfOld, isfBuf, bad)
			} else {
				ind[0] = bits.read(8)
				ind[1] = bits.read(8)
				let v = bits.read(14)
				ind[3] = v & 0x7F
				ind[2] = v >> 7
				ind[4] = bits.read(6)
				wbDecodeIsf36(ind, isf, pastIsfq, isfOld, isfBuf, bad)
			}
			wbIsfToIsp(isf, ispNew, wbOrder)
			if firstFrame {
				firstFrame = false
				for let i = 0; i < wbOrder; i++ {
					ispOld[i] = ispNew[i]
				}
			}
			wbInterpolateIsp(ispOld, ispNew, aq)
			for let i = 0; i < wbOrder; i++ {
				ispOld[i] = ispNew[i]
			}
			let dist = 0
			for let i = 0; i < wbOrder - 1; i++ {
				let d = wbSub(isf[i], isfOld[i])
				dist = wbMac(dist, d, d)
			}
			let tmp = wbHigh(wbShl32(dist, 8))
			tmp = wbMult(tmp, 26214)
			tmp = wbW16(20480 - tmp)
			let stabFac = wbShl(tmp, 1).max(0)
			for let i = 0; i < wbOrder; i++ {
				isfTmp[i] = isfOld[i]
				isfOld[i] = isf[i]
			}
			let t0Min = 0
			let t0Max = 0
			let qNew = 0
			for let sub = 0; sub < 4; sub++ {
				let iSubfr = sub * wbSubframe
				let at = wbExcAt + iSubfr
				let pitFlag = iSubfr
				pitFlag = 0 when sub == 2 && nbBits > wbBits660
				let t0 = 0
				let t0Frac = 0
				if pitFlag == 0 {
					if nbBits <= wbBits885 {
						let index = bits.read(8)
						if index < (wbPitFr1Narrow - wbPitMin) * 2 {
							t0 = wbPitMin + (index >> 1)
							t0Frac = wbShl(wbSub(index, wbShl(wbSub(t0, wbPitMin), 1)), 1)
						} else {
							t0 = wbAdd(index, wbPitFr1Narrow - (wbPitFr1Narrow - wbPitMin) * 2)
						}
					} else {
						let index = bits.read(9)
						if index < (wbPitFr2 - wbPitMin) * 4 {
							t0 = wbPitMin + (index >> 2)
							t0Frac = wbSub(index, wbShl(wbSub(t0, wbPitMin), 2))
						} else if index < ((wbPitFr2 - wbPitMin) << 2) + ((wbPitFr1Wide - wbPitFr2) << 1) {
							index -= (wbPitFr2 - wbPitMin) << 2
							t0 = wbPitFr2 + (index >> 1)
							t0Frac = wbShl(wbSub(index, wbShl(wbSub(t0, wbPitFr2), 1)), 1)
						} else {
							t0 = wbAdd(index, wbPitFr1Wide - (wbPitFr2 - wbPitMin) * 4 - (wbPitFr1Wide - wbPitFr2) * 2)
						}
					}
					t0Min = (t0 - 8).max(wbPitMin)
					t0Max = t0Min + 15
					if t0Max > wbPitMax {
						t0Max = wbPitMax
						t0Min = wbPitMax - 15
					}
				} else if nbBits <= wbBits885 {
					let index = bits.read(5)
					t0 = t0Min + (index >> 1)
					t0Frac = wbShl(wbSub(index, wbShl(t0 - t0Min, 1)), 1)
				} else {
					let index = bits.read(6)
					t0 = t0Min + (index >> 2)
					t0Frac = wbSub(index, wbShl(t0 - t0Min, 2))
				}
				if bad {
					(t0, seed3) = wbConcealLag(gain.pbuf2, lagHist, t0, oldT0, seed3, lost)
					t0Frac = 0
				}
				wbPredictPitch(exc, at, t0, t0Frac, wbSubframe + 1, pitchTaps, scratch32)
				let smoothing = 1
				smoothing = nbBits <= wbBits885 ?? (0, bits.read(1)) unless lost
				if smoothing == 0 {
					for let i = 0; i < wbSubframe; i++ {
						let v = (exc[at + i - 1] + exc[at + i + 1]) * 5898 + exc[at + i] * 20972
						code[i] = wbRound(wbW32(v << 1))
					}
					for let i = 0; i < wbSubframe; i++ {
						exc[at + i] = code[i]
					}
				}
				readCode(nbBits, lost)
				wbPreemphasis(code, tiltCode, wbSubframe)
				let lag = t0
				lag++ when t0Frac > 2
				wbPitchSharpen(code, lag, 27853, wbSubframe)
				let gainBits = nbBits <= wbBits885 ?? (6, 7)
				let (gainPit, gainCode32) = gain.decode(bits.read(gainBits), gainBits, code, bad, prevBad, state, lost, vadHist)
				let gainCodeL = gainCode32
				let qLimit = qSubfr[0]
				for let i = 1; i < 4; i++ {
					qLimit = qSubfr[i] when qSubfr[i] < qLimit
				}
				qLimit = qLimit.min(wbQMax)
				qNew = 0
				let v = gainCodeL
				for v < 0x08000000 && qNew < qLimit {
					v <<= 1
					qNew++
				}
				let gainCode = wbRound(v)
				wbScale(exc, at - wbExcAt, wbExcAt + wbSubframe, wbW16(qNew - qOld))
				qOld = qNew
				if !bad {
					for let i = 4; i > 0; i-- {
						lagHist[i] = lagHist[i - 1]
					}
					lagHist[0] = t0
					oldT0 = t0
					oldT0Frac = 0
				}
				for let i = wbSubframe - 1; i >= 0; i-- {
					let e = exc[at + i]
					exc2[i] = (e + (e != 32767 ?? (4, 0))) >> 3
				}
				let pitSharp = 0
				if nbBits <= wbBits885 {
					pitSharp = wbShl(gainPit, 1)
					if pitSharp > 16384 {
						for let i = 0; i < wbSubframe; i++ {
							let t = wbMult(exc2[i], pitSharp)
							excp[i] = wbRound(wbMul(t, gainPit) >> 1)
						}
					}
				}
				let voiceFac = wbVoiceFactor(exc2, -3, gainPit, code, gainCode)
				tiltCode = wbW16((voiceFac >> 2) + 8192)
				for let i = 0; i < wbSubframe; i++ {
					exc2[i] = exc[at + i]
				}
				let top = 1
				for let i = 0; i < wbSubframe; i++ {
					let l = wbShl32(wbMul(code[i], gainCode), 5)
					l = wbShl32(wbMac(l, exc[at + i], gainPit), 1)
					let t = wbRound(l)
					exc[at + i] = t
					t = wbW16(t - (t < 0 ?? (1, 0)))
					top |= t ^ (t >> 15)
				}
				qSubfr[3] = qSubfr[2]
				qSubfr[2] = qSubfr[1]
				qSubfr[1] = qSubfr[0]
				qSubfr[0] = wbW16(wbAdd(wbNormS(top), qNew) - 1)
				let dispMode = nbBits <= wbBits660 ?? (0, nbBits <= wbBits885 ?? (1, 2))
				wbPhaseDispersion(wbW16(gainCodeL >> 16), gainPit, code, dispMode, dispMem, scratch)
				tmp = wbW16(16384 - (voiceFac >> 1))
				let fac = wbMult(stabFac, tmp)
				let l = gainCodeL
				if l < gcThres {
					l += wbW32(wbMulHigh(gainCodeL, 6226) << 1)
					l = gcThres when l > gcThres
				} else {
					l = wbW32(wbMulHigh(gainCodeL, 27536) << 1)
					l = gcThres when l < gcThres
				}
				gcThres = l
				gainCodeL = wbW32(wbMulHigh(gainCodeL, 32767 - fac) << 1)
				gainCodeL = wbAdd32(gainCodeL, wbW32(wbMulHigh(l, fac) << 1))
				tmp = wbW16((voiceFac >> 3) + 4096)
				let gc = wbRound(wbShl32(gainCodeL, qNew))
				for let i = 0; i < wbSubframe; i++ {
					let neighbours = 0
					neighbours += code[i - 1] when i > 0
					neighbours += code[i + 1] when i < wbSubframe - 1
					let s = wbW32(code[i] << 16)
					s = wbMsu(s, wbW16(neighbours), tmp)
					s = wbShl32(wbMul(wbRound(s), gc), 5)
					s = wbShl32(wbMac(s, exc2[i], gainPit), 1)
					exc2[i] = wbRound(s)
				}
				if nbBits <= wbBits885 && pitSharp > 16384 {
					for let i = 0; i < wbSubframe; i++ {
						excp[i] = wbAdd(excp[i], exc2[i])
					}
					wbAgc(exc2, excp, wbSubframe)
					for let i = 0; i < wbSubframe; i++ {
						exc2[i] = excp[i]
					}
				}
				if nbBits <= wbBits660 {
					interpolateHfIsf(sub)
				} else {
					for let i = 0; i < wbOrder16k - wbOrder; i++ {
						memSynHf[i] = 0
					}
				}
				let corrGain = nbBits >= wbBits2385 ?? (bits.read(4), 0)
				synthesise(sub * (wbOrder + 1), exc2, 0, qNew, iSubfr + (iSubfr >> 2), corrGain, nbBits, newState, bad)
			}
			for let i = 0; i < wbExcAt; i++ {
				oldExc[i] = exc[wbFrame + i]
			}
			wbScale(exc, wbExcAt, wbFrame, wbW16(-qNew))
			let frameExc = exc[wbExcAt:wbExcAt + wbFrame]
			dtx.update(isf, frameExc)
			dtx.globalState = newState
			prevBad = bad
		}

		// The ISFs of subframe `sub` interpolated between the previous
		// frame's and the new ones, into `hfIsf`.
		def interpolateHfIsf(sub int) {
			let f = wbInterpolFrac[sub]
			for let i = 0; i < wbOrder; i++ {
				hfIsf[i] = wbRound(wbMac(wbMul(isfTmp[i], wbSub(32767, f)), isf[i], f))
			}
		}

		// Reads the algebraic codebook indices of a subframe and builds the
		// code vector, or noise for a lost frame.
		def readCode(nbBits int, lost bool) {
			if lost {
				for let i = 0; i < wbSubframe; i++ {
					seed = wbNoise(seed)
					code[i] = seed >> 3
				}
			} else if nbBits <= wbBits660 {
				wbDecodePulses2(bits.read(12), code)
			} else if nbBits <= wbBits885 {
				for let i = 0; i < 4; i++ {
					ind[i] = bits.read(5)
				}
				wbDecodePulses4(ind, 20, code)
			} else if nbBits <= wbBits1265 {
				for let i = 0; i < 4; i++ {
					ind[i] = bits.read(9)
				}
				wbDecodePulses4(ind, 36, code)
			} else if nbBits <= wbBits1425 {
				ind[0] = bits.read(13)
				ind[1] = bits.read(13)
				ind[2] = bits.read(9)
				ind[3] = bits.read(9)
				wbDecodePulses4(ind, 44, code)
			} else if nbBits <= wbBits1585 {
				for let i = 0; i < 4; i++ {
					ind[i] = bits.read(13)
				}
				wbDecodePulses4(ind, 52, code)
			} else if nbBits <= wbBits1825 {
				for let i = 0; i < 4; i++ {
					ind[i] = bits.read(2)
				}
				for let i = 4; i < 8; i++ {
					ind[i] = bits.read(14)
				}
				wbDecodePulses4(ind, 64, code)
			} else if nbBits <= wbBits1985 {
				ind[0] = bits.read(10)
				ind[1] = bits.read(10)
				ind[2] = bits.read(2)
				ind[3] = bits.read(2)
				ind[4] = bits.read(10)
				ind[5] = bits.read(10)
				ind[6] = bits.read(14)
				ind[7] = bits.read(14)
				wbDecodePulses4(ind, 72, code)
			} else {
				for let i = 0; i < 8; i++ {
					ind[i] = bits.read(11)
				}
				wbDecodePulses4(ind, 88, code)
			}
		}

		// Synthesises a subframe from the excitation `excIn` (from `excAt`,
		// scaled by 2^qNew) through the filter at `aAt` in `aq`, adds the
		// high band, and writes 80 samples to `out` from `outAt`.
		def synthesise(aAt int, excIn int[], excAt int, qNew int, outAt int, corrGain int, nbBits int, newState int, bad bool) {
			for let i = 0; i < wbOrder; i++ {
				synthHi[i] = memSynHi[i]
				synthLo[i] = memSynLo[i]
			}
			wbSynthesis32(aq, aAt, wbOrder, excIn, excAt, qNew, synthHi, synthLo, wbSubframe)
			for let i = 0; i < wbOrder; i++ {
				memSynHi[i] = synthHi[wbSubframe + i]
				memSynLo[i] = synthLo[wbSubframe + i]
			}
			wbDeemphasis(synthHi, synthLo, wbOrder, synth, 22282, wbSubframe, memDeemph)
			wbHighpass50(synth, wbSubframe, memSigOut)
			wbUpsample(synth, wbSubframe, out, outAt, memOversamp, scratch32, upTaps)
			for let i = 0; i < wbSubframe16k; i++ {
				seed2 = wbNoise(seed2)
				hf[i] = seed2 >> 3
			}
			for let i = 0; i < wbSubframe; i++ {
				excIn[excAt + i] = wbAdd(excIn[excAt + i], 4) >> 3
			}
			let q = qNew - 3
			let (e1, x1) = wbDot(excIn, excAt, excIn, excAt, wbSubframe)
			let ener = wbHigh(e1)
			let expEner = x1 - (q << 1)
			let (e2, x2) = wbDot(hf, 0, hf, 0, wbSubframe16k)
			let tmp = wbHigh(e2)
			let exp = x2
			if tmp > ener {
				tmp >>= 1
				exp++
			}
			let (inv, ie) = wbInvSqrtNorm(wbDepositHigh(wbDiv(tmp, ener)), exp - expEner)
			tmp = wbW16(wbShl32(inv, ie + 1) >> 16)
			for let i = 0; i < wbSubframe16k; i++ {
				hf[i] = wbW16((hf[i] * tmp) >> 15)
			}
			wbHighpass400(synth, wbSubframe, memHp400)
			let l1 = wbMac(1, synth[0], synth[0])
			let l2 = 1
			for let i = 1; i < wbSubframe; i++ {
				l1 = wbMac(l1, synth[i], synth[i])
				l2 = wbMac(l2, synth[i], synth[i - 1])
			}
			exp = wbNorm(l1)
			ener = wbW16(wbW32(l1 << exp) >> 16)
			tmp = wbW16(wbW32(l2 << exp) >> 16)
			let fac = tmp > 0 ?? (wbDiv(tmp, ener), 0)
			let gain1 = wbW16(32767 - fac)
			let gain2 = wbShl(wbMult(gain1, 20480), 1)
			tmp = wbW16((vadHist > 0 ?? (gain2, gain1)) - 1)
			tmp = wbW16(tmp + 1) when tmp != 0
			tmp = 3277 when tmp < 3277
			if nbBits >= wbBits2385 && !bad {
				let g = wbHfGain[corrGain]
				for let i = 0; i < wbSubframe16k; i++ {
					hf[i] = wbW16(wbMult(hf[i], g) << 1)
				}
			} else {
				for let i = 0; i < wbSubframe16k; i++ {
					hf[i] = wbMult(hf[i], tmp)
				}
			}
			if nbBits <= wbBits660 && newState == wbSpeech {
				wbExtrapolateIsf(hfIsf)
				wbIspToLpc(hfIsf, hfA, 0, wbOrder16k, false)
				wbWeightLpc(hfA, 0, ap, 29491, wbOrder16k)
				wbSynthesis16(ap, wbOrder16k, hf, hf, wbSubframe16k, memSynHf, 0, scratch)
			} else {
				wbWeightLpc(aq, aAt, ap, 19661, wbOrder)
				wbSynthesis16(ap, wbOrder, hf, hf, wbSubframe16k, memSynHf, wbOrder16k - wbOrder, scratch)
			}
			wbBandPass(hf, wbSubframe16k, memHf, scratch32, bandTaps)
			wbLowPass(hf, wbSubframe16k, memHf3, scratch32, lowTaps) when nbBits >= wbBits2385
			for let i = 0; i < wbSubframe16k; i++ {
				out[outAt + i] = wbAdd(out[outAt + i], hf[i])
			}
		}
	}

	// The bit order table of frame type `ft`, empty for types without
	// speech bits.
	def wbSortTable(ft int) int[] {
		return wbOrder660 when ft == 0
		return wbOrder885 when ft == 1
		return wbOrder1265 when ft == 2
		return wbOrder1425 when ft == 3
		return wbOrder1585 when ft == 4
		return wbOrder1825 when ft == 5
		return wbOrder1985 when ft == 6
		return wbOrder2305 when ft == 7
		return wbOrder2385 when ft == 8
		return wbOrderSid when ft == 9
		return int[]
	}

	// The decoder homing frame of speech mode `mode` in 15-bit words.
	def wbHomingFrame(mode int) int[] {
		return wbHoming660 when mode == 0
		return wbHoming885 when mode == 1
		return wbHoming1265 when mode == 2
		return wbHoming1425 when mode == 3
		return wbHoming1585 when mode == 4
		return wbHoming1825 when mode == 5
		return wbHoming1985 when mode == 6
		return wbHoming2305 when mode == 7
		return wbHoming2385
	}
}
