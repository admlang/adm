internal partial module std.formats.audio.amrwb {
	// Discontinuous transmission of AMR-WB (3GPP TS 26.193): the comfort
	// noise a decoder generates from SID frames while the sender is
	// silent.

	// Decoder states: speech, comfort noise, and comfort noise fading out
	// after SID frames stop arriving.
	const wbSpeech = 0
	const wbDtx = 1
	const wbDtxMute = 2

	// Receive frame types: what the decoder knows of a frame's arrival.
	const wbRxSpeechGood = 0
	const wbRxSpeechDegraded = 1
	const wbRxSpeechLost = 2
	const wbRxSpeechBad = 3
	const wbRxSidFirst = 4
	const wbRxSidUpdate = 5
	const wbRxSidBad = 6
	const wbRxNoData = 7

	// Frames of history the comfort noise averages.
	const wbDtxHist = 8

	// Frames without a SID after which the noise fades out.
	const wbDtxMaxEmpty = 50

	// Frames between SID updates after which a hangover is assumed.
	const wbDtxElapsedThresh = 30

	// Hangover frames the encoder adds before comfort noise.
	const wbDtxHangover = 7

	// The comfort noise generator's state.
	type WbDtxState {
		sinceLastSid     int
		trueSidPeriodInv int
		logEn            int
		oldLogEn         int
		isf              int[]
		isfOld           int[]
		cngSeed          int
		isfHist          int[]
		logEnHist        int[]
		histPtr          int
		hangoverCount    int
		elapsedCount     int
		sidFrame         bool
		validData        bool
		hangoverAdded    bool
		globalState      int
		dataUpdated      bool
		ditherSeed       int
		dither           bool

		def new() {
			isf.len(wbOrder)
			isfOld.len(wbOrder)
			isfHist.len(wbOrder * wbDtxHist)
			logEnHist.len(wbDtxHist)
			reset()
		}

		def reset() {
			sinceLastSid = 0
			trueSidPeriodInv = 1 << 13
			logEn = 3500
			oldLogEn = 3500
			cngSeed = 21845
			histPtr = 0
			for let i = 0; i < wbOrder; i++ {
				isf[i] = wbIsfInit[i]
				isfOld[i] = wbIsfInit[i]
			}
			for let h = 0; h < wbDtxHist; h++ {
				for let i = 0; i < wbOrder; i++ {
					isfHist[h * wbOrder + i] = wbIsfInit[i]
				}
				logEnHist[h] = logEn
			}
			hangoverCount = wbDtxHangover
			elapsedCount = 32767
			sidFrame = false
			validData = false
			hangoverAdded = false
			globalState = wbSpeech
			dataUpdated = false
			ditherSeed = 21845
			dither = false
		}

		// The decoder state the frame of type `rx` moves to, updating the
		// hangover counters (rx_dtx_handler).
		def receive(rx int) int {
			let next = wbSpeech
			let inDtx = globalState == wbDtx || globalState == wbDtxMute
			if rx == wbRxSidFirst || rx == wbRxSidUpdate || rx == wbRxSidBad || (inDtx && (rx == wbRxNoData || rx == wbRxSpeechBad || rx == wbRxSpeechLost)) {
				next = wbDtx
				next = wbDtxMute when globalState == wbDtxMute && (rx == wbRxSidBad || rx == wbRxSidFirst || rx == wbRxSpeechLost || rx == wbRxNoData)
				sinceLastSid = wbAdd(sinceLastSid, 1)
				next = wbDtxMute when sinceLastSid > wbDtxMaxEmpty
			} else {
				sinceLastSid = 0
			}
			elapsedCount = 0 when !dataUpdated && rx == wbRxSidUpdate
			elapsedCount = wbAdd(elapsedCount, 1)
			hangoverAdded = false
			let encDtx = rx == wbRxSidFirst || rx == wbRxSidUpdate || rx == wbRxSidBad || rx == wbRxNoData
			if !encDtx {
				hangoverCount = wbDtxHangover
			} else if elapsedCount > wbDtxElapsedThresh {
				hangoverAdded = true
				elapsedCount = 0
				hangoverCount = 0
			} else if hangoverCount == 0 {
				elapsedCount = 0
			} else {
				hangoverCount--
			}
			if next != wbSpeech {
				sidFrame = false
				validData = false
				if rx == wbRxSidFirst {
					sidFrame = true
				} else if rx == wbRxSidUpdate {
					sidFrame = true
					validData = true
				} else if rx == wbRxSidBad {
					sidFrame = true
					hangoverAdded = false
				}
			}
			return next
		}

		// Generates a frame of comfort noise excitation into `exc` and its
		// ISFs into `isfOut`, reading a SID frame's parameters from `bits`.
		def generate(exc int[], state int, isfOut int[], bits WbBits) {
			if hangoverAdded && sidFrame {
				let ptr = histPtr + 1
				ptr = 0 when ptr == wbDtxHist
				for let i = 0; i < wbOrder; i++ {
					isfHist[ptr * wbOrder + i] = isfHist[histPtr * wbOrder + i]
				}
				logEnHist[ptr] = logEnHist[histPtr]
				logEn = 0
				let sums int[]
				sums.len(wbOrder)
				for let h = 0; h < wbDtxHist; h++ {
					logEn = wbAdd(logEn, logEnHist[h])
					for let j = 0; j < wbOrder; j++ {
						sums[j] = wbAdd32(sums[j], isfHist[h * wbOrder + j])
					}
				}
				logEn = wbW16((logEn >> 1) + 1024).max(0)
				for let j = 0; j < wbOrder; j++ {
					isf[j] = wbW16(sums[j] >> 3)
				}
			}
			if sidFrame {
				for let i = 0; i < wbOrder; i++ {
					isfOld[i] = isf[i]
				}
				oldLogEn = logEn
				if validData {
					let length = sinceLastSid.min(32)
					trueSidPeriodInv = length >= 2 ?? (wbDiv(1 << 10, wbShl(length, 10)), 1 << 14)
					let ind int[]
					ind.len(5)
					ind[0] = bits.read(6)
					ind[1] = bits.read(6)
					ind[2] = bits.read(6)
					ind[3] = bits.read(5)
					ind[4] = bits.read(5)
					wbDecodeIsfNoise(ind, isf)
					let logEnIndex = bits.read(6)
					dither = bits.read(1) == 1
					logEn = wbMult(wbShl(logEnIndex, 9), 12483)
					if !dataUpdated || globalState == wbSpeech {
						for let i = 0; i < wbOrder; i++ {
							isfOld[i] = isf[i]
						}
						oldLogEn = logEn
					}
				}
			}
			sinceLastSid = 0 when sidFrame && validData
			let fac = wbMult(wbShl(sinceLastSid, 10), trueSidPeriodInv).min(1024)
			fac = wbShl(fac, 4)
			let logEnInt = wbMul(fac, logEn)
			for let i = 0; i < wbOrder; i++ {
				isfOut[i] = wbMult(fac, isf[i])
			}
			fac = 16384 - fac
			logEnInt = wbMac(logEnInt, fac, oldLogEn)
			for let i = 0; i < wbOrder; i++ {
				isfOut[i] = wbShl(wbAdd(isfOut[i], wbMult(fac, isfOld[i])), 1)
			}
			logEnInt = ditherNoise(isfOut, logEnInt) when dither
			logEnInt >>= 9
			let e = wbHigh(logEnInt)
			let m = wbW16(wbSub32(logEnInt, wbDepositHigh(e)) >> 1)
			e = wbW16(e + 15)
			let level32 = wbPow2(e, m)
			let exp0 = wbNorm(level32)
			level32 = wbW32(level32 << exp0)
			exp0 = 15 - exp0
			let level = wbW16(level32 >> 16)
			for let i = 0; i < 256; i++ {
				cngSeed = wbNoise(cngSeed)
				exc[i] = cngSeed >> 4
			}
			let (ener, ee) = wbDot(exc, 0, exc, 0, 256)
			let (inv, exp) = wbInvSqrtNorm(ener, ee)
			let gain = wbMult(level, wbHigh(inv))
			exp += exp0 + 4
			for let i = 0; i < 256; i++ {
				exc[i] = wbShl(wbMult(exc[i], gain), exp)
			}
			if state == wbDtxMute {
				let length = sinceLastSid.min(32)
				trueSidPeriodInv = wbDiv(1 << 10, wbShl(length, 10))
				sinceLastSid = 0
				oldLogEn = logEn
				logEn = wbW16(logEn - 64).max(0)
			}
			if sidFrame && (validData || hangoverAdded) {
				sinceLastSid = 0
				dataUpdated = true
			}
		}

		// Dithers the comfort noise's energy and ISFs. Returns the energy.
		def ditherNoise(isfOut int[], logEnInt int) int {
			let r = randomPair()
			let en = wbAdd32(logEnInt, wbMul(r, 75)).max(0)
			let fac = 256
			r = randomPair()
			let tmp = wbAdd(isfOut[0], wbMultR(r, fac))
			isfOut[0] = tmp < wbIsfGap ?? (wbIsfGap, tmp)
			for let i = 1; i < wbOrder - 1; i++ {
				fac = wbAdd(fac, 2)
				r = randomPair()
				tmp = wbAdd(isfOut[i], wbMultR(r, fac))
				if wbSub(tmp, isfOut[i - 1]) < 448 {
					isfOut[i] = wbW16(isfOut[i - 1] + 448)
				} else {
					isfOut[i] = tmp
				}
			}
			isfOut[wbOrder - 2] = 16384 when isfOut[wbOrder - 2] > 16384
			return en
		}

		// The sum of two halved noise values.
		def randomPair() int {
			ditherSeed = wbNoise(ditherSeed)
			let a = ditherSeed >> 1
			ditherSeed = wbNoise(ditherSeed)
			return wbW16(a + (ditherSeed >> 1))
		}

		// Records a speech frame's ISFs and excitation energy in the
		// history the comfort noise averages.
		def update(isfNew int[], exc int[]) {
			histPtr++
			histPtr = 0 when histPtr == wbDtxHist
			for let i = 0; i < wbOrder; i++ {
				isfHist[histPtr * wbOrder + i] = isfNew[i]
			}
			let en = 0
			for let i = 0; i < 256; i++ {
				en = wbMac(en, exc[i], exc[i])
			}
			let (e, m) = wbLog2(en >> 1)
			let v = wbShl(e, 7)
			v = wbW16(v + (m >> 8))
			logEnHist[histPtr] = wbW16(v - 1024)
		}
	}
}
