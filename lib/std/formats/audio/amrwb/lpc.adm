internal partial module std.formats.audio.amrwb {
	// The linear prediction of AMR-WB: dequantising the immittance
	// spectral frequencies (ISFs), converting them to immittance spectral
	// pairs (ISPs) and on to filter coefficients, interpolated for each
	// subframe.

	// Order of the linear prediction filter at 12.8 kHz.
	const wbOrder = 16

	// Order of the high band filter at 16 kHz.
	const wbOrder16k = 20

	// Minimum distance between two neighbouring ISFs.
	const wbIsfGap = 128

	// Past quantised ISFs kept for concealment.
	const wbMeanBuf = 3

	// Weight of the previous frame's ISFs, and of the mean, in a lost frame.
	const wbIsfAlpha = 29491

	// Prediction factor of the ISF residual from the previous frame's.
	const wbIsfMu = 10923

	// Keeps the first n - 1 ISFs at least `minDist` apart, ascending.
	def wbReorderIsf(isf int[], minDist int, n int) {
		let low = minDist
		for let i = 0; i < n - 1; i++ {
			isf[i] = low when isf[i] < low
			low = wbAdd(isf[i], minDist)
		}
	}

	// The ISFs of a lost frame: the previous frame's pulled towards the
	// long-term mean. Updates the prediction memory to match.
	def wbConcealIsf(isf int[], pastIsfq int[], isfOld int[], isfBuf int[]) {
		let ref int[]
		ref.len(wbOrder)
		for let i = 0; i < wbOrder; i++ {
			let v = wbMul(wbMeanIsf[i], 8192)
			for let j = 0; j < wbMeanBuf; j++ {
				v = wbMac(v, isfBuf[j * wbOrder + i], 8192)
			}
			ref[i] = wbRound(v)
		}
		for let i = 0; i < wbOrder; i++ {
			isf[i] = wbAdd(wbMult(wbIsfAlpha, isfOld[i]), wbMult(32768 - wbIsfAlpha, ref[i]))
		}
		for let i = 0; i < wbOrder; i++ {
			let tmp = wbAdd(ref[i], wbMult(pastIsfq[i], wbIsfMu))
			pastIsfq[i] = wbSub(isf[i], tmp) >> 1
		}
	}

	// Shifts the new ISFs into the concealment history.
	def wbPushIsfHistory(isf int[], isfBuf int[]) {
		for let i = 0; i < wbOrder; i++ {
			for let j = wbMeanBuf - 1; j > 0; j-- {
				isfBuf[j * wbOrder + i] = isfBuf[(j - 1) * wbOrder + i]
			}
			isfBuf[i] = isf[i]
		}
	}

	// Dequantises the 46-bit ISF indices of the modes above 6.60 kbit/s
	// into `isf`, or conceals them when `bad`.
	def wbDecodeIsf46(ind int[], isf int[], pastIsfq int[], isfOld int[], isfBuf int[], bad bool) {
		if !bad {
			for let i = 0; i < 9; i++ {
				isf[i] = wbDico1[ind[0] * 9 + i]
			}
			for let i = 0; i < 7; i++ {
				isf[i + 9] = wbDico2[ind[1] * 7 + i]
			}
			for let i = 0; i < 3; i++ {
				isf[i] = wbW16(isf[i] + wbDico21[ind[2] * 3 + i])
				isf[i + 3] = wbW16(isf[i + 3] + wbDico22[ind[3] * 3 + i])
				isf[i + 6] = wbW16(isf[i + 6] + wbDico23[ind[4] * 3 + i])
				isf[i + 9] = wbW16(isf[i + 9] + wbDico24[ind[5] * 3 + i])
				isf[i + 12] = wbW16(isf[i + 12] + wbDico25[ind[6] * 4 + i])
			}
			isf[15] = wbW16(isf[15] + wbDico25[ind[6] * 4 + 3])
			for let i = 0; i < wbOrder; i++ {
				let tmp = isf[i]
				isf[i] = wbW16(isf[i] + wbMeanIsf[i] + ((wbIsfMu * pastIsfq[i]) >> 15))
				pastIsfq[i] = tmp
			}
			wbPushIsfHistory(isf, isfBuf)
		} else {
			wbConcealIsf(isf, pastIsfq, isfOld, isfBuf)
		}
		wbReorderIsf(isf, wbIsfGap, wbOrder)
	}

	// Dequantises the 36-bit ISF indices of the 6.60 kbit/s mode into
	// `isf`, or conceals them when `bad`.
	def wbDecodeIsf36(ind int[], isf int[], pastIsfq int[], isfOld int[], isfBuf int[], bad bool) {
		if !bad {
			for let i = 0; i < 9; i++ {
				isf[i] = wbDico1[ind[0] * 9 + i]
			}
			for let i = 0; i < 7; i++ {
				isf[i + 9] = wbAdd(wbDico2[ind[1] * 7 + i], wbDico23Small[ind[4] * 7 + i])
			}
			for let i = 0; i < 5; i++ {
				isf[i] = wbAdd(isf[i], wbDico21Small[ind[2] * 5 + i])
			}
			for let i = 0; i < 4; i++ {
				isf[i + 5] = wbAdd(isf[i + 5], wbDico22Small[ind[3] * 4 + i])
			}
			for let i = 0; i < wbOrder; i++ {
				let tmp = isf[i]
				isf[i] = wbAdd(wbAdd(tmp, wbMeanIsf[i]), wbMult(wbIsfMu, pastIsfq[i]))
				pastIsfq[i] = tmp
			}
			wbPushIsfHistory(isf, isfBuf)
		} else {
			wbConcealIsf(isf, pastIsfq, isfOld, isfBuf)
		}
		wbReorderIsf(isf, wbIsfGap, wbOrder)
	}

	// Dequantises the ISF indices of a SID frame into `isf`.
	def wbDecodeIsfNoise(ind int[], isf int[]) {
		isf[0] = wbNoiseDico1[ind[0] * 2]
		isf[1] = wbNoiseDico1[ind[0] * 2 + 1]
		for let i = 0; i < 3; i++ {
			isf[i + 2] = wbNoiseDico2[ind[1] * 3 + i]
			isf[i + 5] = wbNoiseDico3[ind[2] * 3 + i]
		}
		for let i = 0; i < 4; i++ {
			isf[i + 8] = wbNoiseDico4[ind[3] * 4 + i]
			isf[i + 12] = wbNoiseDico5[ind[4] * 4 + i]
		}
		for let i = 0; i < wbOrder; i++ {
			isf[i] = wbAdd(isf[i], wbMeanIsfNoise[i])
		}
		wbReorderIsf(isf, wbIsfGap, wbOrder)
	}

	// Converts the m ISFs to ISPs, the cosines of the frequencies; `isp`
	// may be `isf`.
	def wbIsfToIsp(isf int[], isp int[], m int) {
		for let i = 0; i < m - 1; i++ {
			isp[i] = isf[i]
		}
		isp[m - 1] = wbShl(isf[m - 1], 1)
		for let i = 0; i < m; i++ {
			let ind = isp[i] >> 7
			let offset = isp[i] & 0x7F
			let v = wbMul(wbCosTable[ind + 1] - wbCosTable[ind], offset)
			isp[i] = wbAdd(wbCosTable[ind], wbW16(v >> 8))
		}
	}

	// The coefficients of the polynomial whose roots are every second ISP
	// from `at`, n of them: f[0..n] in Q23 (Q21 for the 16 kHz filter).
	def wbIspPolynomial(isp int[], at int, f int[], n int, wide bool) {
		let q = wide ?? (7, 9)
		f[0] = wide ?? (0x00200000, 0x00800000)
		f[1] = wbW32(-isp[at] << q)
		let k = at + 2
		for let i = 2; i <= n; i++ {
			f[i] = f[i - 2]
			for let j = i; j > 1; j-- {
				let t = wbShl32(wbMulHigh(f[j - 1], isp[k]), 2)
				f[j] = wbW32(f[j] - t + f[j - 2])
			}
			f[1] = wbW32(f[1] - (isp[k] << q))
			k += 2
		}
	}

	// Converts the m ISPs to the m + 1 coefficients of the prediction
	// filter `a` from `aAt`, in Q12. With `adaptiveScaling` the
	// coefficients are scaled down when they would overflow.
	def wbIspToLpc(isp int[], a int[], aAt int, m int, adaptiveScaling bool) {
		let nc = m >> 1
		let f1 int[]
		f1.len(11)
		let f2 int[]
		f2.len(10)
		if nc > 8 {
			wbIspPolynomial(isp, 0, f1, nc, true)
			for let i = 0; i <= nc; i++ {
				f1[i] = wbShl32(f1[i], 2)
			}
			wbIspPolynomial(isp, 1, f2, nc - 1, true)
			for let i = 0; i <= nc - 1; i++ {
				f2[i] = wbShl32(f2[i], 2)
			}
		} else {
			wbIspPolynomial(isp, 0, f1, nc, false)
			wbIspPolynomial(isp, 1, f2, nc - 1, false)
		}
		for let i = nc - 1; i > 1; i-- {
			f2[i] = wbW32(f2[i] - f2[i - 2])
		}
		let last = isp[m - 1]
		for let i = 0; i < nc; i++ {
			let t0 = wbW32(wbMulHigh(f1[i], last) << 1)
			let t1 = wbW32(wbMulHigh(f2[i], last) << 1)
			f1[i] = wbW32(f1[i] + t0)
			f2[i] = wbW32(f2[i] - t1)
		}
		a[aAt] = 4096
		let tmax = 1
		let j = m - 1
		for let i = 1; i < nc; i++ {
			let t0 = wbAdd32(f1[i], f2[i])
			let t1 = wbW32(t0 - (t0 < 0 ?? (1, 0)))
			tmax |= t1 ^ (t1 >> 31)
			a[aAt + i] = wbW16((t0 >> 12) + ((t0 >> 11) & 1))
			t0 = wbSub32(f1[i], f2[i])
			t1 = wbW32(t0 - (t0 < 0 ?? (1, 0)))
			tmax |= t1 ^ (t1 >> 31)
			a[aAt + j] = wbW16((t0 >> 12) + ((t0 >> 11) & 1))
			j--
		}
		let q = adaptiveScaling ?? (4 - wbNorm(tmax), 0)
		let qSug = 12
		if q > 0 {
			qSug = 12 + q
			j = m - 1
			for let i = 1; i < nc; i++ {
				let t0 = wbAdd32(f1[i], f2[i])
				a[aAt + i] = wbW16((t0 >> qSug) + ((t0 >> (qSug - 1)) & 1))
				t0 = wbSub32(f1[i], f2[i])
				a[aAt + j] = wbW16((t0 >> qSug) + ((t0 >> (qSug - 1)) & 1))
				j--
			}
			a[aAt] >>= q
		} else {
			q = 0
		}
		let t0 = wbW32(((f1[nc] * last) >> 16) << 1)
		t0 = wbAdd32(f1[nc], t0)
		a[aAt + nc] = wbW16((t0 >> qSug) + ((t0 >> (qSug - 1)) & 1))
		a[aAt + m] = wbShrRound(last, 3 + q)
	}

	// The filters of the four subframes into `az`, interpolating from the
	// previous frame's ISPs to the new ones.
	def wbInterpolateIsp(ispOld int[], ispNew int[], az int[]) {
		let isp int[]
		isp.len(wbOrder)
		for let k = 0; k < 3; k++ {
			let facNew = wbInterpolFrac[k]
			let facOld = wbAdd(wbSub(32767, facNew), 1)
			for let i = 0; i < wbOrder; i++ {
				isp[i] = wbRound(wbMac(wbMul(ispOld[i], facOld), ispNew[i], facNew))
			}
			wbIspToLpc(isp, az, k * (wbOrder + 1), wbOrder, false)
		}
		wbIspToLpc(ispNew, az, 3 * (wbOrder + 1), wbOrder, false)
	}

	// The m + 1 coefficients of `a` from `aAt` weighted by powers of
	// `gamma` into `ap`.
	def wbWeightLpc(a int[], aAt int, ap int[], gamma int, m int) {
		ap[0] = a[aAt]
		let fac = gamma
		for let i = 1; i < m; i++ {
			ap[i] = wbW16((a[aAt + i] * fac + 0x4000) >> 15)
			fac = wbW16((fac * gamma + 0x4000) >> 15)
		}
		ap[m] = wbW16((a[aAt + m] * fac + 0x4000) >> 15)
	}

	// Extends the 16 ISFs of the 6.60 kbit/s mode to the 20 of the high
	// band filter and converts them to ISPs, in place.
	def wbExtrapolateIsf(hfIsf int[]) {
		let diff int[]
		diff.len(wbOrder - 2)
		hfIsf[wbOrder16k - 1] = hfIsf[wbOrder - 1]
		for let i = 1; i < wbOrder - 1; i++ {
			diff[i - 1] = wbSub(hfIsf[i], hfIsf[i - 1])
		}
		let sum = 0
		for let i = 3; i < wbOrder - 1; i++ {
			sum = wbMac(sum, diff[i - 1], 2731)
		}
		let mean = wbRound(sum)
		let top = 0
		for let i = 0; i < wbOrder - 2; i++ {
			top = diff[i] when diff[i] > top
		}
		let exp = wbNormS(top)
		for let i = 0; i < wbOrder - 2; i++ {
			diff[i] = wbShl(diff[i], exp)
		}
		mean = wbShl(mean, exp)
		let corr int[]
		corr.len(3)
		for let c = 0; c < 3; c++ {
			for let i = 7; i < wbOrder - 2; i++ {
				let v = wbMul(wbSub(diff[i], mean), wbSub(diff[i - 2 - c], mean))
				let (hi, lo) = wbDpf(v)
				corr[c] = wbAdd32(corr[c], wbMpyDpf(hi, lo, hi, lo))
			}
		}
		let maxCorr = corr[0] > corr[1] ?? (0, 1)
		maxCorr = 2 when corr[2] > corr[maxCorr]
		maxCorr++
		for let i = wbOrder - 1; i < wbOrder16k - 1; i++ {
			let tmp = wbSub(hfIsf[i - 1 - maxCorr], hfIsf[i - 2 - maxCorr])
			hfIsf[i] = wbAdd(hfIsf[i - 1], tmp)
		}
		let tmp = wbSub(hfIsf[2], wbAdd(hfIsf[4], hfIsf[3]))
		tmp = wbW16(wbMult(tmp, 5461) + 20390)
		tmp = 19456 when tmp > 19456
		tmp = wbSub(tmp, hfIsf[wbOrder - 2])
		let tmp2 = wbSub(hfIsf[wbOrder16k - 2], hfIsf[wbOrder - 2])
		let exp2 = wbNormS(tmp2)
		exp = wbNormS(tmp) - 1
		tmp = wbShiftWrap16(tmp, exp)
		tmp2 = wbShiftWrap16(tmp2, exp2)
		let coeff = wbDiv(tmp, tmp2)
		exp = exp2 - exp
		for let i = wbOrder - 1; i < wbOrder16k - 1; i++ {
			let v = wbMult(wbSub(hfIsf[i], hfIsf[i - 1]), coeff)
			diff[i - (wbOrder - 1)] = wbShl(v, exp)
		}
		for let i = wbOrder; i < wbOrder16k - 1; i++ {
			let a = i - (wbOrder - 1)
			let b = i - wbOrder
			if wbW16(diff[a] + diff[b] - 1280) < 0 {
				if diff[a] > diff[b] {
					diff[b] = wbW16(1280 - diff[a])
				} else {
					diff[a] = wbW16(1280 - diff[b])
				}
			}
		}
		for let i = wbOrder - 1; i < wbOrder16k - 1; i++ {
			hfIsf[i] = wbAdd(hfIsf[i - 1], diff[i - (wbOrder - 1)])
		}
		for let i = 0; i < wbOrder16k - 1; i++ {
			hfIsf[i] = wbMult(hfIsf[i], 26214)
		}
		wbIsfToIsp(hfIsf, hfIsf, wbOrder16k)
	}

	// v << n as the reference's 16-bit `<<=` computes it: a negative n
	// shifts by its value modulo 32, and the result wraps.
	def wbShiftWrap16(v int, n int) int {
		return wbW16(wbW32(v << (n & 31)))
	}
}
