internal partial module std.formats.audio.amrwb {
	use std.simd

	// The excitation of AMR-WB: the adaptive codebook (pitch), the
	// algebraic codebook of 64-position pulse tracks, the gains, their
	// concealment in lost frames, and the post-processing of the code
	// vector.

	// Samples of a subframe at 12.8 kHz.
	const wbSubframe = 64

	// Pitch lag range and the lags where the resolution changes.
	const wbPitMin = 34
	const wbPitFr2 = 128
	const wbPitFr1Wide = 160
	const wbPitFr1Narrow = 92
	const wbPitMax = 231

	// Reach of the pitch interpolation filter.
	const wbInterpol = 17

	// Where the current frame starts in the excitation history.
	const wbExcAt = wbPitMax + wbInterpol

	// The adaptive codebook vector: the past excitation `exc` from `at`
	// delayed by the pitch lag t0 and fraction `frac` quarters, n samples.
	// `taps` is `wbInter4` in 32-bit values and `x` scratch of n + 48
	// entries. Eight outputs at a time in 32-bit lanes (which wrap as the
	// reference's sums do): a block reads at most 23 - t0 samples past its
	// start, so for lags of 24 and more (every lag the decoder makes) it
	// reads only outputs of earlier blocks, which `x` mirrors.
	def wbPredictPitch(exc int[], at int, t0 int, frac int, n int, taps int32[], x int32[]) {
		let p = at - t0
		let f = -frac
		if f < 0 {
			f += 4
			p--
		}
		p -= 15
		let row = (3 - f) * 32
		let ahead = at - p
		for let i = 0; i < ahead; i++ {
			x[i] = int32(exc[p + i])
		}
		let j = 0
		if t0 >= 24 {
			for j + 8 <= n {
				let acc = simd.splat8<int32>(int32(0x2000))
				for let i = 0; i < 32; i++ {
					acc = acc + simd.splat8<int32>(taps[row + i]) * simd.load8<int32>(x, j + i)
				}
				let v = ((acc >> 14) << 16) >> 16
				simd.store8<int32>(x, ahead + j, v)
				simd.store8<int>(exc, at + j, simd.convert<int32, int>(v))
				j += 8
			}
		}
		for j < n {
			let sum = 0x2000
			for let i = 0; i < 32; i++ {
				sum += int(x[j + i]) * int(taps[row + i])
			}
			let v = wbW16(wbW32(sum) >> 14)
			x[ahead + j] = int32(v)
			exc[at + j] = v
			j++
		}
	}

	// Positions of one pulse from its N + 1 bits.
	def wbPulse1(index int, n int, offset int, pos int[], at int) {
		let p = (index & ((1 << n) - 1)) + offset
		p += 16 when ((index >> n) & 1) == 1
		pos[at] = p
	}

	// Positions of two pulses from their 2N + 1 bits.
	def wbPulse2(index int, n int, offset int, pos int[], at int) {
		let mask = wbSub(wbShl(1, n), 1)
		let p1 = wbW16(wbAdd32(wbShr32(index, n) & mask, offset))
		let i = (index >> wbShl(n, 1)) & 1
		let p2 = wbAdd(wbW16(index & mask), offset)
		if p2 < p1 {
			if i == 1 {
				p1 += 16
			} else {
				p2 += 16
			}
		} else if i == 1 {
			p1 += 16
			p2 += 16
		}
		pos[at] = p1
		pos[at + 1] = p2
	}

	// Positions of three pulses from their 3N + 1 bits.
	def wbPulse3(index int, n int, offset int, pos int[], at int) {
		let idx = index & ((1 << (2 * n - 1)) - 1)
		let j = offset
		j += 1 << (n - 1) when ((index >> (2 * n - 1)) & 1) != 0
		wbPulse2(idx, n - 1, j, pos, at)
		idx = (index >> (n << 1)) & ((1 << (n + 1)) - 1)
		wbPulse1(idx, n, offset, pos, at + 2)
	}

	// Positions of four pulses from their 4N + 1 bits.
	def wbPulse4Odd(index int, n int, offset int, pos int[], at int) {
		let idx = index & ((1 << (2 * n - 1)) - 1)
		let j = offset
		j += 1 << (n - 1) when ((index >> (2 * n - 1)) & 1) != 0
		wbPulse2(idx, n - 1, j, pos, at)
		idx = (index >> (n << 1)) & ((1 << (2 * n + 1)) - 1)
		wbPulse2(idx, n, offset, pos, at + 2)
	}

	// Positions of four pulses from their 4N bits.
	def wbPulse4(index int, n int, offset int, pos int[], at int) {
		let n1 = n - 1
		let j = offset + (1 << n1)
		let sel = (index >> ((n << 2) - 2)) & 3
		if sel == 0 {
			let o = ((index >> ((n1 << 2) + 1)) & 1) != 0 ?? (j, offset)
			wbPulse4Odd(index, n1, o, pos, at)
		} else if sel == 1 {
			wbPulse1(index >> (3 * n1 + 1), n1, offset, pos, at)
			wbPulse3(index, n1, j, pos, at + 1)
		} else if sel == 2 {
			wbPulse2(index >> ((n1 << 1) + 1), n1, offset, pos, at)
			wbPulse2(index, n1, j, pos, at + 2)
		} else {
			wbPulse3(index >> (n1 + 1), n1, offset, pos, at)
			wbPulse1(index, n1, j, pos, at + 3)
		}
	}

	// Positions of five pulses from their 5N bits.
	def wbPulse5(index int, n int, offset int, pos int[], at int) {
		let n1 = n - 1
		let j = wbAdd(offset, wbShl(1, n1))
		let idx = index >> ((n << 1) + 1)
		let o = ((index >> (5 * n - 1)) & 1) != 0 ?? (j, offset)
		wbPulse3(idx, n1, o, pos, at)
		wbPulse2(index, n, offset, pos, at + 3)
	}

	// Positions of six pulses from their 6N - 2 bits.
	def wbPulse6(index int, n int, offset int, pos int[], at int) {
		let n1 = n - 1
		let j = offset + (1 << n1)
		let offsetA = j
		let offsetB = j
		if ((index >> (6 * n - 5)) & 1) == 0 {
			offsetA = offset
		} else {
			offsetB = offset
		}
		let sel = (index >> (6 * n - 4)) & 3
		if sel == 0 {
			wbPulse5(index >> n, n1, offsetA, pos, at)
			wbPulse1(index, n1, offsetA, pos, at + 5)
		} else if sel == 1 {
			wbPulse5(index >> n, n1, offsetA, pos, at)
			wbPulse1(index, n1, offsetB, pos, at + 5)
		} else if sel == 2 {
			wbPulse4(index >> (2 * n1 + 1), n1, offsetA, pos, at)
			wbPulse2(index, n1, offsetB, pos, at + 4)
		} else {
			wbPulse3(index >> (3 * n1 + 1), n1, offset, pos, at)
			wbPulse3(index, n1, j, pos, at + 3)
		}
	}

	// Adds the `count` pulses at `pos` to track `track` of `code`.
	def wbAddPulses(pos int[], count int, track int, code int[]) {
		for let k = 0; k < count; k++ {
			let i = ((pos[k] & 15) << 2) + track
			code[i] = wbW16(code[i] + ((pos[k] & 16) == 0 ?? (512, -512)))
		}
	}

	// The algebraic code vector of the 6.60 kbit/s mode: two pulses.
	def wbDecodePulses2(index int, code int[]) {
		code.fill(0)
		let i = (index >> 5) & 0x3E
		code[i] = ((index >> 6) & 32) == 0 ?? (512, -512)
		i = ((index & 0x1F) << 1) + 1
		code[i] = (index & 32) == 0 ?? (512, -512)
	}

	// The algebraic code vector of four tracks of pulses coded in
	// `bits` bits from the indices `ind`.
	def wbDecodePulses4(ind int[], bits int, code int[]) {
		code.fill(0)
		let pos int[]
		pos.len(6)
		if bits == 20 {
			for let k = 0; k < 4; k++ {
				wbPulse1(ind[k], 4, 0, pos, 0)
				wbAddPulses(pos, 1, k, code)
			}
		} else if bits == 36 {
			for let k = 0; k < 4; k++ {
				wbPulse2(ind[k], 4, 0, pos, 0)
				wbAddPulses(pos, 2, k, code)
			}
		} else if bits == 44 {
			for let k = 0; k < 2; k++ {
				wbPulse3(ind[k], 4, 0, pos, 0)
				wbAddPulses(pos, 3, k, code)
			}
			for let k = 2; k < 4; k++ {
				wbPulse2(ind[k], 4, 0, pos, 0)
				wbAddPulses(pos, 2, k, code)
			}
		} else if bits == 52 {
			for let k = 0; k < 4; k++ {
				wbPulse3(ind[k], 4, 0, pos, 0)
				wbAddPulses(pos, 3, k, code)
			}
		} else if bits == 64 {
			for let k = 0; k < 4; k++ {
				wbPulse4((ind[k] << 14) + ind[k + 4], 4, 0, pos, 0)
				wbAddPulses(pos, 4, k, code)
			}
		} else if bits == 72 {
			for let k = 0; k < 2; k++ {
				wbPulse5((ind[k] << 10) + ind[k + 4], 4, 0, pos, 0)
				wbAddPulses(pos, 5, k, code)
			}
			for let k = 2; k < 4; k++ {
				wbPulse4((ind[k] << 14) + ind[k + 4], 4, 0, pos, 0)
				wbAddPulses(pos, 4, k, code)
			}
		} else if bits == 88 {
			for let k = 0; k < 4; k++ {
				wbPulse6((ind[k] << 11) + ind[k + 4], 4, 0, pos, 0)
				wbAddPulses(pos, 6, k, code)
			}
		}
	}

	// Tilts the code vector: x[i] -= mu * x[i - 1], last sample first.
	def wbPreemphasis(x int[], mu int, n int) {
		for let i = n - 1; i > 0; i-- {
			x[i] = wbRound(wbMsu(x[i] << 16, x[i - 1], mu))
		}
	}

	// Sharpens the code vector with the pitch: x[i] += sharp * x[i - lag].
	def wbPitchSharpen(x int[], lag int, sharp int, n int) {
		for let i = lag; i < n; i++ {
			x[i] = wbRound(wbMac(x[i] << 16, x[i - lag], sharp))
		}
	}

	// The median of the five values of x around `at`.
	def wbMedian5(x int[], at int) int {
		let x1 = x[at - 2]
		let x2 = x[at - 1]
		let x3 = x[at]
		let x4 = x[at + 1]
		let x5 = x[at + 2]
		if x2 < x1 {
			let t = x1
			x1 = x2
			x2 = t
		}
		if x3 < x1 {
			let t = x1
			x1 = x3
			x3 = t
		}
		if x4 < x1 {
			let t = x1
			x1 = x4
			x4 = t
		}
		x5 = x1 when x5 < x1
		if x3 < x2 {
			let t = x2
			x2 = x3
			x3 = t
		}
		if x4 < x2 {
			let t = x2
			x2 = x4
			x4 = t
		}
		x5 = x2 when x5 < x2
		x3 = x4 when x4 < x3
		x3 = x5 when x5 < x3
		return x3
	}

	// The gain decoder's memory: the past quantised energies, the last
	// gains and five-entry histories of them for concealment.
	type WbGainState {
		pastQuaEn    int[]
		pastGainPit  int
		pastGainCode int
		prevGc       int
		pbuf         int[]
		gbuf         int[]
		pbuf2        int[]

		def new() {
			pastQuaEn.len(4)
			pbuf.len(5)
			gbuf.len(5)
			pbuf2.len(5)
			reset()
		}

		def reset() {
			pastQuaEn.fill(-14336)
			pastGainPit = 0
			pastGainCode = 0
			prevGc = 0
			pbuf.fill(0)
			gbuf.fill(0)
			pbuf2.fill(0)
		}

		// Decodes the pitch gain and the code gain (Q16) of a subframe from
		// the `bits`-bit index, or conceals them in a bad frame.
		def decode(index int, bits int, code int[], bad bool, prevBad bool, state int, lost bool, vadHist int) (int, int) {
			let (energy, e) = wbDot(code, 0, code, 0, wbSubframe)
			let (inv, ie) = wbInvSqrtNorm(energy, e - 24)
			let gcodeInov = wbHigh(wbShl32(inv, ie - 3))
			if bad {
				pastGainPit = wbMedian5(pbuf, 2).min(15565)
				let gainPit = wbMult(lost ?? (wbPitchDownLost[state], wbPitchDownBad[state]), pastGainPit)
				let median = wbMedian5(gbuf, 2)
				if vadHist > 2 {
					pastGainCode = median
				} else {
					pastGainCode = wbMult(lost ?? (wbCodeDownLost[state], wbCodeDownBad[state]), median)
				}
				// The reference keeps the oldest energy instead of shifting it.
				let sum = pastQuaEn[3] + pastQuaEn[2] + pastQuaEn[1] + pastQuaEn[0]
				pastQuaEn[2] = pastQuaEn[1]
				pastQuaEn[1] = pastQuaEn[0]
				pastQuaEn[0] = wbW16(wbW16(sum >> 3) - 3072).max(-14336)
				for let i = 1; i < 5; i++ {
					gbuf[i - 1] = gbuf[i]
					pbuf[i - 1] = pbuf[i]
				}
				gbuf[4] = pastGainCode
				pbuf[4] = pastGainPit
				return (gainPit, wbMul(pastGainCode, gcodeInov))
			}
			let v = wbShl32(wbDepositHigh(30), 8)
			for let i = 0; i < 4; i++ {
				v = wbMac(v, wbGainPred[i], pastQuaEn[i])
			}
			let gcode0 = wbHigh(v)
			v = (gcode0 * 5443) >> 7
			let (expGcode0, frac) = wbDpf(v)
			gcode0 = wbW16(wbPow2(14, frac))
			expGcode0 -= 14
			let table = bits == 6 ?? (wbGain6, wbGain7)
			let gainPit = table[index * 2]
			let gCode = table[index * 2 + 1]
			let gainCode = wbShl32(wbMul(gCode, gcode0), expGcode0 + 4)
			if prevBad {
				let limit = wbMul(prevGc, 5120)
				gainCode = limit when gainCode > limit && gainCode > 6553600
			}
			pastGainCode = wbRound(wbShl32(gainCode, 3))
			pastGainPit = gainPit
			prevGc = pastGainCode
			// The reference moves only the second entry down here, leaving
			// the three middle ones in place.
			gbuf[0] = gbuf[1]
			pbuf[0] = pbuf[1]
			pbuf2[0] = pbuf2[1]
			gbuf[4] = pastGainCode
			pbuf[4] = pastGainPit
			pbuf2[4] = pastGainPit
			let (hi, lo) = wbDpf(gainCode)
			gainCode = wbShl32(wbMul32x16(hi, lo, gcodeInov), 3)
			pastQuaEn[3] = pastQuaEn[2]
			pastQuaEn[2] = pastQuaEn[1]
			pastQuaEn[1] = pastQuaEn[0]
			let (le, lf) = wbLog2(gCode)
			pastQuaEn[0] = wbW16(wbMul32x16(le - 11, lf, 24660) >> 3)
			return (gainPit, gainCode)
		}
	}

	// The pitch lag of a bad frame from the history of lags and gains
	// (`gains` from `gainAt`, the gain decoder's `pbuf2`): kept, replaced
	// by a recent lag, or drawn around the median. Returns the lag and the
	// new seed.
	def wbConcealLag(gains int[], lags int[], t0 int, oldT0 int, seed int, lost bool) (int, int) {
		let lastGain = gains[4]
		let secLastGain = gains[3]
		let lastLag = lags[0]
		let minLag = lags[0]
		let maxLag = lags[0]
		for let i = 1; i < 5; i++ {
			minLag = lags[i] when lags[i] < minLag
			maxLag = lags[i] when lags[i] > maxLag
		}
		let minGain = gains[0]
		for let i = 1; i < 5; i++ {
			minGain = gains[i] when gains[i] < minGain
		}
		let lagDif = wbSub(maxLag, minLag)
		let t = t0
		let s = seed
		if lost {
			if minGain > 8192 && lagDif < 10 {
				t = oldT0
			} else if lastGain > 8192 && secLastGain > 8192 {
				t = lags[0]
			} else {
				(t, s) = wbRandomLag(lags, s)
			}
			return (wbClampLag(t, minLag, maxLag), s)
		}
		let meanLag = 0
		for let i = 0; i < 5; i++ {
			meanLag = wbAdd(meanLag, lags[i])
		}
		meanLag = wbMult(meanLag, 6554)
		let tmp = wbW16(t - maxLag)
		let tmp2 = wbW16(t - lastLag)
		return (t, s) when lagDif < 10 && t > minLag - 5 && tmp < 5
		return (t, s) when lastGain > 8192 && secLastGain > 8192 && tmp2 + 10 > 0 && tmp2 < 10
		return (t, s) when minGain < 6554 && lastGain == minGain && t > minLag && t < maxLag
		return (t, s) when lagDif < 70 && t > minLag && t < maxLag
		return (t, s) when t > meanLag && t < maxLag
		if minGain > 8192 && lagDif < 10 {
			t = lags[0]
		} else if lastGain > 8192 && secLastGain > 8192 {
			t = lags[0]
		} else {
			(t, s) = wbRandomLag(lags, s)
		}
		return (wbClampLag(t, minLag, maxLag), s)
	}

	// t limited to minLag..maxLag, the upper limit applied first.
	def wbClampLag(t int, minLag int, maxLag int) int {
		let v = t
		v = maxLag when v > maxLag
		v = minLag when v < minLag
		return v
	}

	// A lag drawn around the mean of the three largest past lags. Returns
	// the lag and the new seed.
	def wbRandomLag(lags int[], seed int) (int, int) {
		let sorted = lags.clone()
		for let i = 1; i < 5; i++ {
			let x = sorted[i]
			let j = i - 1
			for j >= 0 && x < sorted[j] {
				sorted[j + 1] = sorted[j]
				j--
			}
			sorted[j + 1] = x
		}
		let lagDif = wbSub(sorted[4], sorted[2]).min(40)
		let s = wbNoise(seed)
		let d2 = wbMult(lagDif >> 1, s)
		let sum = wbAdd(wbAdd(sorted[2], sorted[3]), sorted[4])
		return (wbAdd(wbMult(sum, 10923), d2), s)
	}

	// How voiced the subframe is, -1 to 1 in Q15, from the energies of the
	// pitch and code contributions.
	def wbVoiceFactor(exc int[], qExc int, gainPit int, code int[], gainCode int) int {
		let (e1, x1) = wbDot(exc, 0, exc, 0, wbSubframe)
		let ener1 = wbHigh(e1)
		let exp1 = wbSub(x1, qExc << 1)
		let v = wbMul(gainPit, gainPit)
		let exp = wbNorm(v)
		let tmp = wbW16(wbW32(v << exp) >> 16)
		ener1 = wbMult(ener1, tmp)
		exp1 -= exp + 10
		let (e2, x2) = wbDot(code, 0, code, 0, wbSubframe)
		let ener2 = wbHigh(e2)
		exp = wbNormS(gainCode)
		tmp = wbShl(gainCode, exp)
		tmp = wbMult(tmp, tmp)
		ener2 = wbMult(ener2, tmp)
		let exp2 = x2 - (exp << 1)
		let i = wbW16(exp1 - exp2)
		// Shift counts of 32 or more reach the reference compiled for x86,
		// whose shifts use the count modulo 32.
		if i >= 0 {
			ener1 >>= 1
			ener2 >>= (i + 1) & 31
		} else {
			ener1 >>= (1 - i) & 31
			ener2 >>= 1
		}
		tmp = wbW16(ener1 - ener2)
		ener1 = wbW16(ener1 + ener2 + 1)
		return wbDiv(tmp, ener1) when tmp >= 0
		return wbNegate(wbDiv(wbNegate(tmp), ener1))
	}

	// The phase dispersion of the code vector: spreads its pulses with a
	// fixed impulse response when the pitch gain is low. `mem` holds the
	// previous state, code gain and six pitch gains.
	def wbPhaseDispersion(gainCode int, gainPit int, code int[], mode int, mem int[], code2 int[]) {
		code2.fill(0)
		let state = gainPit < 9830 ?? (0, gainPit < 14746 ?? (1, 2))
		for let i = 5; i > 0; i-- {
			mem[2 + i] = mem[2 + i - 1]
		}
		mem[2] = gainPit
		if wbSub(gainCode, mem[1]) > wbShl(mem[1], 1) {
			state++ when state < 2
		} else {
			let j = 0
			for let i = 0; i < 6; i++ {
				j++ when mem[2 + i] < 9830
			}
			state = 0 when j > 2
			state-- when state > mem[0] + 1
		}
		mem[1] = gainCode
		mem[0] = state
		state += mode
		return when state >= 2
		let imp = state == 0 ?? (wbPhaseLow, wbPhaseMid)
		for let i = 0; i < wbSubframe; i++ {
			if code[i] != 0 {
				for let j = 0; j < wbSubframe; j++ {
					code2[i + j] = wbAdd(code2[i + j], wbMultR(code[i], imp[j]))
				}
			}
		}
		for let i = 0; i < wbSubframe; i++ {
			code[i] = wbAdd(code2[i], code2[i + wbSubframe])
		}
	}

	// Scales `out` so its energy matches that of `input`, n samples.
	def wbAgc(input int[], out int[], n int) {
		let t = out[0] >> 2
		let s = wbW32((t * t) << 1)
		for let i = 1; i < n; i++ {
			t = out[i] >> 2
			s = wbMac(s, t, t)
		}
		return when s == 0
		let exp = wbNorm(s) - 1
		let gainOut = wbRound(wbW32(s << (exp & 31)))
		t = input[0] >> 2
		s = wbMul(t, t)
		for let i = 1; i < n; i++ {
			t = input[i] >> 2
			s = wbMac(s, t, t)
		}
		let g0 = 0
		if s != 0 {
			let i = wbNorm(s)
			let gainIn = wbRound(wbW32(s << i))
			exp -= i
			s = wbDiv(gainOut, gainIn)
			s = wbShl32(s, 7)
			s = wbShr32(s, exp)
			s = wbInvSqrt(s)
			g0 = wbRound(wbShl32(s, 9))
		}
		for let i = 0; i < n; i++ {
			out[i] = wbHigh(wbShl32(out[i] * g0, 3))
		}
	}
}
