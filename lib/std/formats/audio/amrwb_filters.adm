internal partial module std.formats.audio.amrwb {
	use std.simd

	// The filters of AMR-WB synthesis: the 32-bit synthesis filter at
	// 12.8 kHz, de-emphasis, the high-pass filters, the 12.8 to 16 kHz
	// upsampler and the high band's own synthesis and band filters.

	// Samples of a subframe at 16 kHz.
	const wbSubframe16k = 80

	// The synthesis filter 1/A(z) of order m over n samples of `exc` from
	// `excAt`, in double precision: the output's high and low parts go to
	// `hi` and `lo` from `wbOrder`, whose first `wbOrder` entries hold the
	// filter memory. The excitation is scaled by 2^qNew.
	def wbSynthesis32(a int[], aAt int, m int, exc int[], excAt int, qNew int, hi int[], lo int[], n int) {
		let a0 = 9 - qNew
		for let s = 0; s < n; s++ {
			let at = wbOrder + s
			let sumLo = 0
			let sumHi = 0
			for let k = 1; k <= m; k++ {
				sumLo += lo[at - k] * a[aAt + k]
				sumHi += hi[at - k] * a[aAt + k]
			}
			let v = wbW32(wbW32(-sumLo) >> 11)
			v = wbW32(v + (exc[excAt + s] << a0) - wbW32(wbW32(sumHi) << 1))
			v = wbShl32(v, 3)
			hi[at] = wbW16(v >> 16)
			lo[at] = wbW16((v >> 4) - ((v >> 16) << 12))
		}
	}

	// The synthesis filter 1/A(z) of order m in single precision: n
	// samples of x (ahead of the filter memory `mem`) to y, which may be
	// x; `buf` is scratch of m + n entries. Keeps the last m outputs in
	// `mem`.
	def wbSynthesis16(a int[], m int, x int[], y int[], n int, mem int[], memAt int, buf int[]) {
		for let i = 0; i < m; i++ {
			buf[i] = mem[memAt + i]
		}
		for let s = 0; s < n; s++ {
			let sum = -(x[s] << 11)
			for let k = 1; k <= m; k++ {
				sum += buf[m + s - k] * a[k]
			}
			let v = wbShl32(wbW32(sum), 4)
			let out = wbRound(wbW32(-v))
			buf[m + s] = out
			y[s] = out
		}
		for let i = 0; i < m; i++ {
			mem[memAt + i] = y[n - m + i]
		}
	}

	// De-emphasis 1/(1 - mu z^-1) of the double precision signal from
	// `at` into y, with the last output in `mem[0]`.
	def wbDeemphasis(hi int[], lo int[], at int, y int[], mu int, n int, mem int[]) {
		let prev = mem[0]
		for let i = 0; i < n; i++ {
			let v = wbW32((hi[at + i] << 16) + (lo[at + i] << 4))
			v = wbShl32(v, 3)
			v = wbShl32(wbW32(v + prev * mu), 1)
			y[i] = wbRound(v)
			prev = y[i]
		}
		mem[0] = y[n - 1]
	}

	// The 50 Hz high-pass filter at 12.8 kHz, in place.
	def wbHighpass50(signal int[], n int, mem int[]) {
		let y2Hi = mem[0]
		let y2Lo = mem[1]
		let y1Hi = mem[2]
		let y1Lo = mem[3]
		let x0 = mem[4]
		let x1 = mem[5]
		for let i = 0; i < n; i++ {
			let l1 = y1Lo * 16211 + 8192 + y2Lo * (-8021)
			let l2 = y1Hi * 32422 + y2Hi * (-16042)
			let x2 = x1
			x1 = x0
			x0 = signal[i]
			l2 += x2 * 8106 + x1 * (-16212) + x0 * 8106
			let v = wbW32((wbW32(l1) >> 14) + wbW32(l2))
			v = wbW32(v << 2)
			y2Hi = y1Hi
			y2Lo = y1Lo
			y1Hi = wbW16(v >> 16)
			y1Lo = wbW16((v - (y1Hi << 16)) >> 1)
			signal[i] = wbShl1Round(v)
		}
		mem[0] = y2Hi
		mem[1] = y2Lo
		mem[2] = y1Hi
		mem[3] = y1Lo
		mem[4] = x0
		mem[5] = x1
	}

	// The 400 Hz high-pass filter at 12.8 kHz, in place.
	def wbHighpass400(signal int[], n int, mem int[]) {
		let y2Hi = mem[0]
		let y2Lo = mem[1]
		let y1Hi = mem[2]
		let y1Lo = mem[3]
		let x0 = mem[4]
		let x1 = mem[5]
		for let i = 0; i < n; i++ {
			let l1 = y1Lo * 29280 + 8192 + y2Lo * (-14160)
			let l2 = y1Hi * 29280 + y2Hi * (-14160)
			let x2 = x1
			x1 = x0
			x0 = signal[i]
			l2 += x2 * 915 + x1 * (-1830) + x0 * 915
			let v = wbW32((wbW32(l1) >> 13) + wbW32(wbW32(l2) << 2))
			y2Hi = y1Hi
			y2Lo = y1Lo
			signal[i] = wbW16(wbW32(v + 0x8000) >> 16)
			y1Hi = wbW16(v >> 16)
			y1Lo = wbW16((v - (y1Hi << 16)) >> 1)
		}
		mem[0] = y2Hi
		mem[1] = y2Lo
		mem[2] = y1Hi
		mem[3] = y1Lo
		mem[4] = x0
		mem[5] = x1
	}

	// Upsamples n samples at 12.8 kHz to 5n/4 at 16 kHz into `out` from
	// `outAt`. `mem` holds the last 24 input samples; `buf` is scratch of
	// n + 32 entries and `taps` the four 24-tap phases of `wbFirUp`. Each
	// interpolated sample is a 24-tap dot product in 32-bit lanes, which
	// wrap as the reference's sums do.
	def wbUpsample(input int[], n int, out int[], outAt int, mem int[], buf int32[], taps int32[]) {
		for let i = 0; i < 24; i++ {
			buf[i] = int32(mem[i])
		}
		for let i = 0; i < n; i++ {
			buf[24 + i] = int32(input[i])
		}
		let frac = 1
		for let j = 0; j < n + (n >> 2); j++ {
			let i = (j * 6554) >> 13
			frac--
			if frac != 0 {
				let row = (4 - frac) * 24
				let v = simd.load8<int32>(buf, 1 + i) * simd.load8<int32>(taps, row)
				v = v + simd.load8<int32>(buf, 9 + i) * simd.load8<int32>(taps, row + 8)
				v = v + simd.load8<int32>(buf, 17 + i) * simd.load8<int32>(taps, row + 16)
				let sum = wbW32(int(simd.sum(v)) + 0x2000)
				out[outAt + j] = wbW16(wbShl32(sum, 2) >> 16)
			} else {
				out[outAt + j] = int(buf[12 + i])
				frac = 5
			}
		}
		for let i = 0; i < 24; i++ {
			mem[i] = int(buf[n + i])
		}
	}

	// The 6-7 kHz band pass filter of the high band, in place: `taps` is
	// `wbFir6k7k` with its first tap repeated at the end (the reference's
	// `- x << 5` at both ends), `x` scratch of n + 30 entries.
	def wbBandPass(signal int[], n int, mem int[], x int32[], taps int32[]) {
		for let i = 0; i < 30; i++ {
			x[i] = int32(mem[i])
		}
		for let s = 0; s < n; s++ {
			x[s + 30] = int32(signal[s] >> 2)
		}
		wbFir31(x, taps, signal, n)
		for let i = 0; i < 30; i++ {
			mem[i] = int(x[n + i])
		}
	}

	// The 7 kHz low pass filter of the 23.85 kbit/s high band, in place:
	// `taps` is `wbFir7k`, `x` scratch of n + 30 entries.
	def wbLowPass(signal int[], n int, mem int[], x int32[], taps int32[]) {
		for let i = 0; i < 30; i++ {
			x[i] = int32(mem[i])
		}
		for let s = 0; s < n; s++ {
			x[s + 30] = int32(signal[s])
		}
		wbFir31(x, taps, signal, n)
		for let i = 0; i < 30; i++ {
			mem[i] = int(x[n + i])
		}
	}

	// signal[s] = (0x4000 + the 31 taps over x[s..s + 30]) >> 15 as a
	// 16-bit value, for the n outputs, eight at a time in 32-bit lanes
	// (which wrap as the reference's sums do). n is a multiple of 8.
	def wbFir31(x int32[], taps int32[], signal int[], n int) {
		for let s = 0; s < n; s += 8 {
			let acc = simd.splat8<int32>(int32(0x4000))
			for let j = 0; j < 31; j++ {
				acc = acc + simd.splat8<int32>(taps[j]) * simd.load8<int32>(x, s + j)
			}
			let v = ((acc >> 15) << 16) >> 16
			simd.store8<int>(signal, s, simd.convert<int32, int>(v))
		}
	}

	// A table as 32-bit values, with `extra` appended.
	def wbTaps32(table int[], extra int[]) int32[] {
		let out int32[]
		for let v in table {
			out.push(int32(v))
		}
		for let v in extra {
			out.push(int32(v))
		}
		return out
	}
}
