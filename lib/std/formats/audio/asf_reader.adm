internal partial module std.formats.audio.asf {
	use std.io

	// Object and stream type identifiers of the Advanced Systems Format, in
	// their registry spelling.
	const (
		asfHeaderObject           = "75B22630-668E-11CF-A6D9-00AA0062CE6C"
		asfDataObject             = "75B22636-668E-11CF-A6D9-00AA0062CE6C"
		asfFilePropertiesObject   = "8CABDCA1-A947-11CF-8EE4-00C00C205365"
		asfStreamPropertiesObject = "B7DC0791-A9B7-11CF-8EE6-00C00C205365"
		asfHeaderExtensionObject  = "5FBF03B5-A92E-11CF-8EE3-00C00C205365"
		asfContentDescription     = "75B22633-668E-11CF-A6D9-00AA0062CE6C"
		asfExtendedContent        = "D2D0A440-E307-11D2-97F0-00A0C95EA850"
		asfAudioMedia             = "F8699E40-5B4D-11CF-A8FD-00805F5C442B"
		asfAudioSpread            = "BFC3CD50-618F-11CF-8BB2-00AA00B4E220"
		asfReserved1              = "ABD3D211-A9BA-11CF-8EE6-00C00C205365"
	)

	// The five fields of the Content Description object, as tag names.
	const asfDescriptionTags = string["Title", "Author", "Copyright", "Description", "Rating"]

	// The 16 bytes of a GUID in its registry spelling, laid out as ASF stores
	// it: the first three groups little-endian, the rest as written.
	def asfGuid(text string) byte[] {
		let hex byte[]
		for let (_, c) in text.bytes() {
			continue when int(c) == 0x2D
			hex.push(c)
		}
		let raw byte[]
		for let i = 0; i + 1 < hex.len(); i += 2 {
			raw.push(byte((asfHexDigit(hex[i]) << 4) | asfHexDigit(hex[i + 1])))
		}
		return byte[
			raw[3], raw[2], raw[1], raw[0], raw[5], raw[4], raw[7], raw[6],
			raw[8], raw[9], raw[10], raw[11], raw[12], raw[13], raw[14], raw[15]
		]
	}

	// The value of one hexadecimal digit.
	def asfHexDigit(c byte) int {
		let v = int(c)
		return v - 0x30 when v >= 0x30 && v <= 0x39
		return v - 0x41 + 10 when v >= 0x41 && v <= 0x46
		return v - 0x61 + 10 when v >= 0x61 && v <= 0x66
		return 0
	}

	// Whether `data` holds the GUID at `at`.
	def asfIsGuid(data byte[], at int, guid string) bool {
		return false when at + 16 > data.len()
		let want = asfGuid(guid)
		for let i = 0; i < 16; i++ {
			return false when data[at + i] != want[i]
		}
		return true
	}

	// The little-endian unsigned value of `size` bytes at `at`, 0 past the
	// end.
	def asfUint(data byte[], at int, size int) int {
		let v = 0
		for let i = size - 1; i >= 0; i-- {
			let b = at + i < data.len() ?? (int(data[at + i]), 0)
			v = (v << 8) | b
		}
		return v
	}

	// UTF-16LE text of `size` bytes at `at`, up to its first NUL.
	def asfText(data byte[], at int, size int) string {
		let out byte[]
		let i = 0
		let units = size / 2
		for i < units {
			let cp = asfUint(data, at + i * 2, 2)
			i++
			if cp >= 0xD800 && cp < 0xDC00 && i < units {
				let lo = asfUint(data, at + i * 2, 2)
				if lo >= 0xDC00 && lo < 0xE000 {
					cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
					i++
				}
			}
			break when cp == 0
			if cp < 0x80 {
				out.push(byte(cp))
			} else if cp < 0x800 {
				out.push(byte(0xC0 | (cp >> 6)))
				out.push(byte(0x80 | (cp & 0x3F)))
			} else if cp < 0x10000 {
				out.push(byte(0xE0 | (cp >> 12)))
				out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
				out.push(byte(0x80 | (cp & 0x3F)))
			} else {
				out.push(byte(0xF0 | (cp >> 18)))
				out.push(byte(0x80 | ((cp >> 12) & 0x3F)))
				out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
				out.push(byte(0x80 | (cp & 0x3F)))
			}
		}
		return string(out)
	}

	// The audio stream an ASF header describes: its WAVEFORMATEX and the
	// interleaving of its audio spread error correction.
	struct ASFAudioStream {
		// Stream number, 1 to 127.
		number         int
		formatTag      int
		channels       int
		sampleRate     int
		bytesPerSec    int
		blockAlign     int
		bitsPerSample  int
		// Codec-specific bytes after the WAVEFORMATEX fields.
		extra          byte[]
		// Audio spread: media objects are interleaved in `span` rows of
		// `chunkSize` byte chunks, `spanPacketSize` bytes per row. A span of
		// 1 or less means no interleaving.
		span           int
		spanPacketSize int
		chunkSize      int
	}

	// The Header Object of an ASF file and the Data Object header after it.
	type ASFHeader {
		// Milliseconds added to every presentation time.
		preroll      int
		// Duration of the file including the preroll, in 100 ns units.
		playDuration int
		sendDuration int
		// File Properties flags: 1 broadcast, 2 seekable.
		flags        int
		// Bytes per data packet.
		packetSize   int
		maxBitrate   int
		// Data packets in the Data Object, 0 when not recorded.
		packetCount  int
		// Offset of the first data packet from the start of the file.
		dataOffset   int
		// Byte size of the Data Object, 0 when not recorded.
		dataSize     int
		// The first audio stream; its number is 0 when the file has none.
		audio        ASFAudioStream
		// Content Description fields and Extended Content Description
		// entries by name.
		tags         map<string, string>

		def new() {
			tags = new map<string, string>()
			audio = ASFAudioStream{number: 0, formatTag: 0, channels: 0, sampleRate: 0, bytesPerSec: 0, blockAlign: 0, bitsPerSample: 0, extra: byte[], span: 0, spanPacketSize: 0, chunkSize: 0}
		}

		// Reads the Header Object and the Data Object header, leaving the
		// reader at the first data packet.
		//
		// Fails when the reader does not hold an ASF file, the header is cut
		// short, or the reader fails.
		def read(reader io.Reader) !none {
			let head byte[]
			head.len(30)
			try io.readFull(reader, head)
			fail "asf: not an ASF file" unless asfIsGuid(head, 0, asfHeaderObject)
			let size = asfUint(head, 16, 8)
			fail "asf: header object of {size} bytes" when size < 30 || size > 64 * 1024 * 1024
			let body byte[]
			body.len(size - 30)
			try io.readFull(reader, body)
			parseObjects(body, 0, body.len())
			let at = size

			for {
				let obj byte[]
				obj.len(24)
				try io.readFull(reader, obj)
				let objSize = asfUint(obj, 16, 8)
				at += 24
				if asfIsGuid(obj, 0, asfDataObject) {
					let rest byte[]
					rest.len(26)
					try io.readFull(reader, rest)
					at += 26
					packetCount = asfUint(rest, 16, 8)
					dataSize = objSize
					dataOffset = at
					break
				}
				fail "asf: object of {objSize} bytes before the data" when objSize < 24
				let skip byte[]
				skip.len(objSize - 24)
				try io.readFull(reader, skip)
				at += objSize - 24
			}
			fail "asf: no audio stream" when audio.number == 0
			fail "asf: no packet size" when packetSize <= 0
			return none
		}

		// Parses the objects in `data[at:end]`.
		def parseObjects(data byte[], at int, end int) {
			let pos = at
			for pos + 24 <= end {
				let size = asfUint(data, pos + 16, 8)
				break when size < 24 || pos + size > end
				let body = pos + 24
				if asfIsGuid(data, pos, asfFilePropertiesObject) {
					playDuration = asfUint(data, body + 40, 8)
					sendDuration = asfUint(data, body + 48, 8)
					preroll = asfUint(data, body + 56, 8)
					flags = asfUint(data, body + 64, 4)
					packetSize = asfUint(data, body + 68, 4)
					maxBitrate = asfUint(data, body + 76, 4)
				} else if asfIsGuid(data, pos, asfStreamPropertiesObject) {
					parseStream(data, body)
				} else if asfIsGuid(data, pos, asfContentDescription) {
					parseDescription(data, body)
				} else if asfIsGuid(data, pos, asfExtendedContent) {
					parseExtended(data, body, pos + size)
				}
				pos += size
			}
		}

		// Reads a Stream Properties object, keeping the first audio stream.
		def parseStream(data byte[], at int) {
			return when audio.number != 0
			return unless asfIsGuid(data, at, asfAudioMedia)
			let typeLen = asfUint(data, at + 40, 4)
			let ecLen = asfUint(data, at + 44, 4)
			let number = asfUint(data, at + 48, 2) & 0x7F
			let fmt = at + 54
			return when typeLen < 16
			let extraLen = typeLen >= 18 ?? (asfUint(data, fmt + 16, 2), 0)
			extraLen = (typeLen - 18).max(0) when extraLen > typeLen - 18
			let stream = ASFAudioStream{
				number: number,
				formatTag: asfUint(data, fmt, 2),
				channels: asfUint(data, fmt + 2, 2),
				sampleRate: asfUint(data, fmt + 4, 4),
				bytesPerSec: asfUint(data, fmt + 8, 4),
				blockAlign: asfUint(data, fmt + 12, 2),
				bitsPerSample: asfUint(data, fmt + 14, 2),
				extra: data[fmt + 18:fmt + 18 + extraLen].clone(),
				span: 0,
				spanPacketSize: 0,
				chunkSize: 0
			}
			let ec = fmt + typeLen
			if asfIsGuid(data, at + 16, asfAudioSpread) && ecLen >= 5 {
				stream.span = int(data[ec])
				stream.spanPacketSize = asfUint(data, ec + 1, 2)
				stream.chunkSize = asfUint(data, ec + 3, 2)
				let valid = stream.chunkSize > 0 && stream.spanPacketSize / stream.chunkSize > 1 && stream.spanPacketSize % stream.chunkSize == 0
				stream.span = 0 unless valid
			}
			audio = stream
		}

		// Reads the Content Description object into `tags`.
		def parseDescription(data byte[], at int) {
			let pos = at + 10
			for let i = 0; i < 5; i++ {
				let len = asfUint(data, at + i * 2, 2)
				let text = asfText(data, pos, len)
				tags.set(asfDescriptionTags[i], text) when text.len() > 0
				pos += len
			}
		}

		// Reads the Extended Content Description object into `tags`: text,
		// numbers and flags; byte arrays are left out.
		def parseExtended(data byte[], at int, end int) {
			let count = asfUint(data, at, 2)
			let pos = at + 2
			for let i = 0; i < count && pos + 6 <= end; i++ {
				let nameLen = asfUint(data, pos, 2)
				let name = asfText(data, pos + 2, nameLen)
				pos += 2 + nameLen
				let kind = asfUint(data, pos, 2)
				let valueLen = asfUint(data, pos + 2, 2)
				let v = pos + 4
				pos = v + valueLen
				break when pos > end
				if kind == 0 {
					tags.set(name, asfText(data, v, valueLen))
				} else if kind == 2 {
					tags.set(name, asfUint(data, v, valueLen.min(4)) != 0 ?? ("true", "false"))
				} else if kind == 3 || kind == 4 || kind == 5 {
					tags.set(name, "{asfUint(data, v, valueLen.min(8))}")
				}
			}
		}

		// Frames of audio the header's play duration covers, 0 when it
		// records none.
		def frames() int {
			let stream = audio
			return 0 when stream.number == 0
			let length = playDuration - preroll * 10000
			return 0 when length <= 0
			return length * stream.sampleRate / 10000000
		}
	}

	// One media object of the audio stream, reassembled from its payloads.
	struct ASFObject {
		data byte[]
		// Presentation time in milliseconds, preroll removed.
		time int
	}

	// Reads the data packets of an ASF file and returns the media objects
	// of its audio stream in order.
	type ASFPacketReader {
		reader  io.Reader
		header  ASFHeader
		stream  ASFAudioStream
		packet  byte[]
		// Index of the next packet to read.
		index   int
		ready   ASFObject[]
		head    int
		// The object being reassembled.
		current byte[]
		number  int
		filled  int
		time    int
		ended   bool

		// Reads packets from `reader`, which stands at the first packet.
		def new(reader io.Reader, header ASFHeader, stream ASFAudioStream) {
			self.reader = reader
			self.header = header
			self.stream = stream
			packet.len(header.packetSize)
			number = -1
		}

		// The next media object, or none at the end of the data.
		//
		// Fails when the reader does.
		def next() !?ASFObject {
			for head >= ready.len() {
				return none when ended
				ready = ASFObject[]
				head = 0
				try readPacket()
			}
			let obj = ready[head]
			head++
			return obj
		}

		// Positions at packet `index`, which the reader must already stand
		// at, dropping anything half read.
		def restart(index int) {
			self.index = index
			ready = ASFObject[]
			head = 0
			current = byte[]
			number = -1
			filled = 0
			ended = false
		}

		// Reads one packet and queues the objects it completes.
		def readPacket() !none {
			if header.packetCount > 0 && index >= header.packetCount {
				ended = true
				return none
			}
			let n = 0
			for n < packet.len() {
				let got = try reader.read(packet[n:])
				break when got == 0
				n += got
			}
			if n < packet.len() {
				// A file cut short: what arrived of the last packet still
				// counts, and an object it cuts off is returned as far as it
				// goes.
				ended = true
				return none when n == 0
				for let i = n; i < packet.len(); i++ {
					packet[i] = 0
				}
			}
			index++
			parsePacket(packet, n) onerror recover none
			return none
		}

		// The packet's send time in milliseconds, -1 when it is damaged.
		def sendTime(p byte[]) int {
			let i = 0
			i = 1 + int(p[0] & 0x0F) when p[0] & 0x80 != 0
			return -1 when i + 2 > p.len()
			let lengthFlags = int(p[i])
			i += 2
			i += asfFieldSize((lengthFlags >> 5) & 3)
			i += asfFieldSize((lengthFlags >> 1) & 3)
			i += asfFieldSize((lengthFlags >> 3) & 3)
			return -1 when i + 4 > p.len()
			return asfUint(p, i, 4)
		}

		// Splits a packet, of which the first `avail` bytes arrived, into
		// payloads and feeds those of the audio stream to the reassembly.
		// Fails when the packet is damaged.
		def parsePacket(p byte[], avail int) !none {
			let size = p.len()
			let i = 0
			if p[0] & 0x80 != 0 {
				fail "asf: error correction with a length field" when p[0] & 0x60 != 0
				i = 1 + int(p[0] & 0x0F)
			}
			fail "asf: packet header past the packet" when i + 2 > size
			let lengthFlags = int(p[i])
			let props = int(p[i + 1])
			i += 2
			let packetLen = asfUint(p, i, asfFieldSize((lengthFlags >> 5) & 3))
			i += asfFieldSize((lengthFlags >> 5) & 3)
			i += asfFieldSize((lengthFlags >> 1) & 3)
			let padding = asfUint(p, i, asfFieldSize((lengthFlags >> 3) & 3))
			i += asfFieldSize((lengthFlags >> 3) & 3)
			i += 6
			padding += size - packetLen when packetLen > 0 && packetLen < size
			let end = size - padding
			fail "asf: packet padding past the packet" when end < i

			let repType = props & 3
			let offType = (props >> 2) & 3
			let objType = (props >> 4) & 3
			let multiple = lengthFlags & 1 != 0
			let count = 1
			let payloadLenType = 0
			if multiple {
				fail "asf: payload header past the packet" when i >= end
				count = int(p[i]) & 0x3F
				payloadLenType = int(p[i]) >> 6
				i++
			}
			for let k = 0; k < count; k++ {
				fail "asf: payload past the packet" when i >= end
				let streamNumber = int(p[i]) & 0x7F
				i++
				let objNumber = asfUint(p, i, asfFieldSize(objType))
				i += asfFieldSize(objType)
				let offset = asfUint(p, i, asfFieldSize(offType))
				i += asfFieldSize(offType)
				let repLen = asfUint(p, i, asfFieldSize(repType))
				i += asfFieldSize(repType)
				let objSize = 0
				let presTime = 0
				let delta = 0
				let compressed = repLen == 1
				if compressed {
					delta = int(p[i])
					presTime = offset
					i++
				} else {
					if repLen >= 8 {
						objSize = asfUint(p, i, 4)
						presTime = asfUint(p, i + 4, 4)
					}
					i += repLen
				}
				let len = end - i
				if multiple {
					len = asfUint(p, i, asfFieldSize(payloadLenType))
					i += asfFieldSize(payloadLenType)
				}
				fail "asf: payload of {len} bytes past the packet" when len < 0 || i + len > end
				let data = p[i:(i + len).min(avail.max(i))]
				let cut = i + len > avail
				i += len
				continue when streamNumber != stream.number

				if compressed {
					let j = 0
					let t = presTime
					for j < data.len() {
						let sub = int(data[j])
						j++
						break when j + sub > data.len()
						deliver(data[j:j + sub].clone(), t)
						j += sub
						t += delta
					}
				} else {
					add(objNumber, offset, objSize, presTime, data, cut)
				}
			}
			return none
		}

		// Adds a fragment of media object `objNumber` at byte `offset`; a
		// `cut` fragment ends the object where it ends.
		def add(objNumber int, offset int, objSize int, presTime int, data byte[], cut bool) {
			if offset == 0 {
				current = byte[]
				current.len(objSize.max(data.len()))
				number = objNumber
				filled = 0
				time = presTime
			} else if objNumber != number || offset != filled {
				number = -1
				return
			}
			return when number < 0 || offset + data.len() > current.len()
			for let i = 0; i < data.len(); i++ {
				current[offset + i] = data[i]
			}
			filled = offset + data.len()
			if cut && filled < current.len() {
				deliver(current[0:filled], time)
				number = -1
			} else if filled >= current.len() {
				deliver(current, time)
				number = -1
			}
		}

		// Queues a complete media object, undoing the audio spread.
		def deliver(data byte[], presTime int) {
			let out = data
			if stream.span > 1 && data.len() == stream.spanPacketSize * stream.span {
				out = byte[]
				out.len(data.len())
				let chunk = stream.chunkSize
				let rows = stream.spanPacketSize / chunk
				for let offset = 0; offset < data.len(); offset += chunk {
					let off = offset / chunk
					let row = off / stream.span
					let col = off % stream.span
					let idx = row + col * rows
					for let i = 0; i < chunk; i++ {
						out[offset + i] = data[idx * chunk + i]
					}
				}
			}
			ready.push(ASFObject{data: out, time: presTime - header.preroll})
		}
	}

	// Bytes of a packet header field of length type `kind`: none, a byte,
	// a word or a double word.
	def asfFieldSize(kind int) int {
		return kind == 3 ?? (4, kind)
	}
}
