partial module std.formats.audio {
	use (
		std.io
		std.os
		std.bytes
		std.formats.audio.au::*
	)

	// How a Sun AU file stores its samples: the header's encoding field.
	// Samples are big-endian and interleaved.
	enum AuEncoding {
		// 8-bit G.711 µ-law.
		MuLaw = 1,
		// 8-bit signed linear PCM.
		Linear8 = 2,
		// 16-bit signed linear PCM.
		Linear16 = 3,
		// 24-bit signed linear PCM.
		Linear24 = 4,
		// 32-bit signed linear PCM.
		Linear32 = 5,
		// 32-bit IEEE float.
		Float = 6,
		// 64-bit IEEE float.
		Double = 7,
		// 8-bit G.711 A-law.
		ALaw = 27,
	}

	// AU is the Sun/NeXT audio codec (`.au`, `.snd`). It decodes µ-law,
	// A-law, 8, 16, 24 and 32-bit linear PCM, and 32 and 64-bit float, and
	// encodes any of them, 16-bit linear PCM by default.
	//
	// `open` and `info` set `encoding` and `annotation` from the file, so the
	// same instance re-encodes in the layout it read.
	@codec("AU")
	type AU {
		// encoding is the sample layout `encode` writes.
		encoding   AuEncoding = AuEncoding.Linear16
		// annotation is the free text stored after the header: what `encode`
		// writes, and what `open` or `info` last read, up to its first NUL.
		annotation string     = ""

		mimeType string[] {
			def get() string[] {
				return string["audio/basic", "audio/x-au"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".au", ".snd"]
			}
		}

		// matchSignature reports whether the reader starts with the `.snd`
		// magic.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)
			let n = io.readFull(r, b) onerror recover 0
			return n == 4 && b.equals(byte[0x2E, 0x73, 0x6E, 0x64])
		}

		// info reads the header and annotation from the reader. Fails when the
		// data is not an AU header this codec understands, or the reader does.
		def info(reader io.Reader) !AudioInfo {
			let seekable = sourcePosition(reader) >= 0
			let header = try readHeader(reader)
			return header.audioInfo(seekable)
		}

		// open reads the header and returns a stream that decodes the samples as
		// it is read. The stream can seek when the reader is a `bytes.Reader` or
		// an `os.File`, and closes the reader when it is an `os.File`.
		//
		// Fails when the data is not an AU header this codec understands, or the
		// reader does.
		// Fails too when `live` is set: the codec needs the whole file.
		def open(reader io.Reader, live bool = false) !AudioStream {
			fail "au: a live stream cannot be decoded" when live
			let start = sourcePosition(reader)
			let header = try readHeader(reader)
			let law int[]
			law = levels(header.encoding) when header.encoding == AuEncoding.MuLaw || header.encoding == AuEncoding.ALaw
			return new AuStream(reader, header, start < 0 ?? (-1, start + header.dataOffset), law)
		}

		// encode writes the stream from where it stands to its end as an AU file
		// in `encoding`, with `annotation` after the header. Samples beyond
		// -1..1 are clipped for the integer encodings. The data size is exact
		// when the writer is a `bytes.Buffer` or a seekable `os.File`, and
		// otherwise the unknown size (0xFFFFFFFF) that readers take to mean the
		// data runs to the end of the file.
		//
		// Fails when the stream has no channels or a zero sample rate, or when
		// reading the stream or writing does.
		def encode(stream AudioStream, writer io.Writer) !none {
			let info = stream.info()
			let channels = int(info.channels)
			fail "au: the stream has no channels" when channels <= 0
			fail "au: the stream has no sample rate" when info.sampleRate == 0

			let bps = sampleBytes(encoding)
			let start = headerStart(writer)
			try writeAll(writer, header(info.sampleRate, channels))

			let samples float32[]
			samples.len(auEncodeChunkFrames * channels)
			let out byte[]
			out.len(samples.len() * bps)
			let compand byte[]
			compand = compandTable(encoding) when encoding == AuEncoding.MuLaw || encoding == AuEncoding.ALaw
			let total = 0
			for {
				let frames = try stream.read(samples)
				break when frames == 0
				let n = frames * channels
				pack(samples, n, out, compand)
				try writeAll(writer, out[:n * bps])
				total += n * bps
			}
			patchSize(writer, start, total) when total < auUnknownSize
			return none
		}

		// The header and padded annotation for a file at the rate and channel
		// count, with the unknown data size.
		internal def header(sampleRate uint32, channels int) byte[] {
			let text = annotation.bytes()
			// The annotation ends in at least one NUL, padded to 8 bytes.
			let pad = (text.len() + 8) / 8 * 8
			let out byte[]
			out.len(auHeaderLen + pad)
			out[:] = 0
			byte[0x2E, 0x73, 0x6E, 0x64].copy(out)
			putU32(out, 4, auHeaderLen + pad)
			putU32(out, 8, auUnknownSize)
			putU32(out, 12, int(encoding.value))
			putU32(out, 16, int(sampleRate))
			putU32(out, 20, channels)
			text.copy(out[auHeaderLen:])
			return out
		}

		// Where the reader stands in its source: an offset into a `bytes.Reader`
		// or `os.File`, -1 for any reader that cannot be repositioned.
		internal def sourcePosition(reader io.Reader) int {
			return reader.size() - reader.len() when reader is bytes.Reader
			if reader is os.File {
				let at = reader.seek(0, bytes.Whence.Current) onerror recover -1
				return int(at)
			}
			return -1
		}

		// Where the header starts in the writer, for patching the data size
		// once it is known: an offset into a `bytes.Buffer` or `os.File`, -1
		// for any other writer.
		internal def headerStart(writer io.Writer) int {
			return writer.len() when writer is bytes.Buffer
			if writer is os.File {
				let at = writer.seek(0, bytes.Whence.Current) onerror recover -1
				return int(at)
			}
			return -1
		}

		// Writes the data size into the header written at `start`, leaving the
		// unknown size in place when the writer cannot be patched.
		internal def patchSize(writer io.Writer, start int, size int) {
			return when start < 0
			let field = uint32(size).bytes(bytes.Endian.Big)
			if writer is bytes.Buffer {
				field.copy(writer.bytes()[start + 8:start + 12])
				return
			}
			if writer is os.File {
				writer.seek(int64(start + 8)) onerror recover 0
				writer.write(field) onerror recover 0
				writer.seek(0, bytes.Whence.End) onerror recover 0
			}
		}

		// Writes every byte of `data`, however the writer splits it. Fails when
		// the writer does, or stops accepting bytes.
		internal def writeAll(writer io.Writer, data byte[]) !none {
			let at = 0
			for at < data.len() {
				let n = try writer.write(data[at:])
				fail "au: the writer accepted no bytes" when n <= 0
				at += n
			}
			return none
		}

		// Converts the first `count` samples to `encoding` into `out`, through
		// `compandTable` for the G.711 laws.
		internal def pack(samples float32[], count int, out byte[], compand byte[]) {
			switch encoding {
				case AuEncoding.MuLaw, AuEncoding.ALaw:
					for let i = 0; i < count; i++ {
						out[i] = compand[linear(samples[i], 32768.0, 32767) + 32768]
					}
				case AuEncoding.Linear8:
					for let i = 0; i < count; i++ {
						out[i] = byte(linear(samples[i], 128.0, 127) & 0xFF)
					}
				case AuEncoding.Linear16:
					for let i = 0; i < count; i++ {
						let v = linear(samples[i], 32768.0, 32767)
						let o = i * 2
						out[o], out[o + 1] = byte((v >> 8) & 0xFF), byte(v & 0xFF)
					}
				case AuEncoding.Linear24:
					for let i = 0; i < count; i++ {
						let v = linear(samples[i], 8388608.0, 8388607)
						let o = i * 3
						out[o], out[o + 1], out[o + 2] = byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF)
					}
				case AuEncoding.Linear32:
					for let i = 0; i < count; i++ {
						let v = linear(samples[i], 2147483648.0, 2147483647)
						putU32(out, i * 4, v)
					}
				case AuEncoding.Float:
					for let i = 0; i < count; i++ {
						putU32(out, i * 4, int(__bitcast_u32_from_f32(samples[i])))
					}
				case AuEncoding.Double:
					for let i = 0; i < count; i++ {
						let v = __bitcast_u64_from_f64(float64(samples[i]))
						let o = i * 8
						putU32(out, o, int(v >> 32))
						putU32(out, o + 4, int(v & 0xFFFFFFFF))
					}
			}
		}

		// Writes the low 32 bits of `v` big-endian at `o`.
		internal def putU32(out byte[], o int, v int) {
			out[o], out[o + 1] = byte((v >> 24) & 0xFF), byte((v >> 16) & 0xFF)
			out[o + 2], out[o + 3] = byte((v >> 8) & 0xFF), byte(v & 0xFF)
		}

		// The sample scaled by `scale`, rounded and clipped to -scale..top.
		internal def linear(sample float32, scale float, top int) int {
			let x = float(sample) * scale
			return top when x >= float(top)
			return -top - 1 when x <= -scale
			return int(x + 0.5) when x >= 0.0
			return int(x - 0.5)
		}

		// The 16-bit sample each of the 256 codes of a G.711 law stands for.
		internal def levels(law AuEncoding) int[] {
			let out int[]
			out.len(256)
			for let code = 0; code < 256; code++ {
				out[code] = law == AuEncoding.MuLaw ?? (expandMuLaw(code), expandALaw(code))
			}
			return out
		}

		// The code of a G.711 law nearest each 16-bit sample, indexed by the
		// sample plus 32768.
		internal def compandTable(law AuEncoding) byte[] {
			let value = levels(law)
			// Codes in order of the sample they stand for.
			let order int[]
			order.len(256)
			for let i = 0; i < 256; i++ {
				let code = i
				let at = i
				for at > 0 && value[order[at - 1]] > value[code] {
					order[at] = order[at - 1]
					at--
				}
				order[at] = code
			}
			let table byte[]
			table.len(65536)
			let k = 0
			for let i = 0; i < 65536; i++ {
				let v = i - 32768
				for k + 1 < 256 && (value[order[k + 1]] - v).abs() <= (value[order[k]] - v).abs() {
					k++
				}
				table[i] = byte(order[k])
			}
			return table
		}

		// The 16-bit sample a G.711 µ-law code stands for.
		internal def expandMuLaw(code int) int {
			let u = code ^ 0xFF
			let t = ((u & 0x0F) << 3) + 0x84
			t <<= (u & 0x70) >> 4
			return u & 0x80 != 0 ?? (0x84 - t, t - 0x84)
		}

		// The 16-bit sample a G.711 A-law code stands for.
		internal def expandALaw(code int) int {
			let a = code ^ 0x55
			let t = (a & 0x0F) << 1 | 1
			let segment = (a & 0x70) >> 4
			t = segment == 0 ?? (t << 3, (t + 32) << (segment + 2))
			return a & 0x80 != 0 ?? (t, -t)
		}

		// Reads the fixed header and the annotation, leaving the reader at the
		// first sample, and records the encoding and annotation on the codec.
		// Fails when the magic, offset, encoding, rate or channel count is not
		// one this codec reads, or the reader fails or ends first.
		internal def readHeader(reader io.Reader) !AuHeader {
			let head byte[]
			head.len(auHeaderLen)
			try io.readFull(reader, head)
			fail "au: not an AU file" unless head[0:4].equals(byte[0x2E, 0x73, 0x6E, 0x64])

			let r = new bytes.Reader(head, bytes.Endian.Big)
			try r.skip(4)
			let offset = int(try r.read<uint32>())
			let size = int(try r.read<uint32>())
			let code = int(try r.read<uint32>())
			let rate = try r.read<uint32>()
			let channels = int(try r.read<uint32>())

			fail "au: the data offset {offset} lies inside the header" when offset < auHeaderLen
			fail "au: the data offset {offset} is too large" when offset > auMaxHeaderLen
			fail "au: the sample rate is zero" when rate == 0
			fail "au: {channels} channels" when channels <= 0 || channels > 0xFFFF

			let header = AuHeader{
				dataOffset: offset,
				dataSize: size == auUnknownSize ?? (-1, size),
				encoding: try encodingOf(code),
				sampleRate: rate,
				channels: channels,
			}

			let text byte[]
			text.len(offset - auHeaderLen)
			try io.readFull(reader, text)
			let end = 0
			for end < text.len() && text[end] != 0 {
				end++
			}
			encoding = header.encoding
			annotation = string(text[:end])
			return header
		}

		// The encoding the header field names. Fails when it is not one this
		// codec reads.
		internal def encodingOf(code int) !AuEncoding {
			switch code {
				case 1:
					return AuEncoding.MuLaw
				case 2:
					return AuEncoding.Linear8
				case 3:
					return AuEncoding.Linear16
				case 4:
					return AuEncoding.Linear24
				case 5:
					return AuEncoding.Linear32
				case 6:
					return AuEncoding.Float
				case 7:
					return AuEncoding.Double
				case 27:
					return AuEncoding.ALaw
			}
			fail "au: unsupported encoding {code}"
		}
	}
}

internal partial module std.formats.audio.au {
	use (
		std.io
		std.os
		std.bytes
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	const (
		// Bytes of the fixed header: magic, data offset, data size, encoding,
		// sample rate and channel count.
		auHeaderLen         = 24
		// The data size a writer that does not know the length puts in the
		// header: the data runs to the end of the file.
		auUnknownSize       = 0xFFFFFFFF
		// The largest header, annotation included, this codec reads.
		auMaxHeaderLen      = 1 << 24
		// Frames converted per pass while encoding.
		auEncodeChunkFrames = 4096
	)

	// Bytes one sample takes in the encoding.
	def sampleBytes(encoding AuEncoding) int {
		switch encoding {
			case AuEncoding.Linear16:
				return 2
			case AuEncoding.Linear24:
				return 3
			case AuEncoding.Linear32, AuEncoding.Float:
				return 4
			case AuEncoding.Double:
				return 8
		}
		return 1
	}

	// What an AU header says about the samples that follow it.
	type AuHeader {
		// Bytes from the start of the file to the first sample.
		dataOffset int
		// Bytes of sample data, -1 when the file does not say.
		dataSize   int
		encoding   AuEncoding
		sampleRate uint32
		channels   int

		// The header as an `AudioInfo`, for a stream that can seek or not.
		def audioInfo(seekable bool) AudioInfo {
			let bps = sampleBytes(encoding)
			let frames = dataSize < 0 ?? (0, dataSize / (bps * channels))
			let format = SampleFormat.Int16
			switch encoding {
				case AuEncoding.Linear8:
					format = SampleFormat.Uint8
				case AuEncoding.Linear24:
					format = SampleFormat.Int24
				case AuEncoding.Linear32:
					format = SampleFormat.Int32
				case AuEncoding.Float:
					format = SampleFormat.Float32
				case AuEncoding.Double:
					format = SampleFormat.Float64
			}
			return AudioInfo{
				sampleRate: sampleRate,
				channels: uint16(channels),
				bitDepth: uint16(bps * 8),
				format: format,
				frames: uint64(frames),
				length: duration(int64(frames) * 1000000000 / int64(sampleRate)),
				codec: "au",
				bitrate: uint32(int(sampleRate) * channels * bps * 8),
				seekable: seekable,
			}
		}
	}

	// Decodes the samples of an AU file as they are read.
	type AuStream {
		// The frame the next read starts at.
		framePosition uint64

		source   io.Reader
		header   AuHeader
		// Where the first sample sits in the source, -1 when the source cannot
		// be repositioned.
		start    int
		// Frames decoded so far, counting from the first.
		streamAt int
		// Bytes per frame.
		frameLen int
		// Total frames, -1 when the file does not say.
		frames   int
		// Raw bytes of the last read, reused across reads.
		raw      byte[]
		// Sample value of each µ-law or A-law code.
		table    float32[]
		closed   bool

		// A stream over the samples at the reader, which stands at the first of
		// them. `start` is their offset in a repositionable source, else -1;
		// `levels` is the sample of each code for a G.711 law, else empty.
		def new(source io.Reader, header AuHeader, start int, levels int[]) {
			self.source = source
			self.header = header
			self.start = start
			frameLen = sampleBytes(header.encoding) * header.channels
			frames = header.dataSize < 0 ?? (-1, header.dataSize / frameLen)
			table.len(levels.len())
			for let (i, v) in levels {
				table[i] = float32(v) / 32768.0
			}
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return header.audioInfo(start >= 0)
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream: decodes up to `buf.len()` samples of
		// whole frames and returns the frame count, 0 at the end of the data.
		// A partial frame at the end of the file is dropped.
		//
		// Fails when `buf` does not hold whole frames, or the source fails.
		def readFrames(buf float32[]) !int {
			expects {
				assert buf.len() % header.channels == 0 onerror fail "au: a buffer of {buf.len()} samples does not hold whole frames of {header.channels} channels"
			}
			return 0 when closed
			let want = buf.len() / header.channels
			want = want.min(frames - streamAt) when frames >= 0
			return 0 when want <= 0

			let need = want * frameLen
			raw.len(need) when raw.len() < need
			let got = 0
			for got < need {
				let n = try source.read(raw[got:need])
				break when n == 0
				got += n
			}
			let count = got / frameLen
			decode(buf, count * header.channels)
			streamAt += count
			return count
		}

		// Converts the first `n` raw samples into `buf`.
		def decode(buf float32[], n int) {
			switch header.encoding {
				case AuEncoding.MuLaw, AuEncoding.ALaw:
					for let i = 0; i < n; i++ {
						buf[i] = table[int(raw[i])]
					}
				case AuEncoding.Linear8:
					for let i = 0; i < n; i++ {
						buf[i] = float32((int(raw[i]) << 56) >> 56) / 128.0
					}
				case AuEncoding.Linear16:
					for let i = 0; i < n; i++ {
						let o = i * 2
						buf[i] = float32((int(raw[o]) << 56) >> 48 | int(raw[o + 1])) / 32768.0
					}
				case AuEncoding.Linear24:
					for let i = 0; i < n; i++ {
						let o = i * 3
						buf[i] = float32((int(raw[o]) << 56) >> 40 | int(raw[o + 1]) << 8 | int(raw[o + 2])) / 8388608.0
					}
				case AuEncoding.Linear32:
					for let i = 0; i < n; i++ {
						buf[i] = float32(float64((u32(i * 4) << 32) >> 32) / 2147483648.0)
					}
				case AuEncoding.Float:
					for let i = 0; i < n; i++ {
						buf[i] = __bitcast_f32_from_u32(uint32(u32(i * 4)))
					}
				case AuEncoding.Double:
					for let i = 0; i < n; i++ {
						let o = i * 8
						buf[i] = float32(__bitcast_f64_from_u64(uint64(u32(o)) << 32 | uint64(u32(o + 4))))
					}
			}
		}

		// The big-endian 32-bit value at `o` in the raw bytes.
		def u32(o int) int {
			return int(raw[o]) << 24 | int(raw[o + 1]) << 16 | int(raw[o + 2]) << 8 | int(raw[o + 3])
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream: the next read starts at `frame`.
		//
		// Fails when the source cannot be repositioned (`info().seekable` is
		// false), the frame lies past the end of the data, or the source fails.
		def seekFrame(frame uint64) !none {
			fail "au: the stream cannot seek" when start < 0
			let target = int(frame)
			fail "au: frame {frame} is past the end ({frames} frames)" when frames >= 0 && target > frames
			let offset = start + target * frameLen
			let src = source
			if src is bytes.Reader {
				try src.seek(offset)
			} else if src is os.File {
				try src.seek(int64(offset))
			}
			streamAt = target
			return none
		}

		// close implements io.Closer, closing the source when it is an
		// `os.File`; reads after it return 0. Fails when closing the source
		// does.
		def close() !none {
			return none when closed
			closed = true
			let src = source
			if src is os.File {
				try src.close()
			}
			return none
		}
	}
}
