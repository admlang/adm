partial module std.formats.audio {
	use (
		std.testing
		std.bytes
		std.io
		std.formats.audio.loader::*
		std.formats.audio.seek::*
	)

	// An in-memory stream over interleaved samples, the source the encoder
	// tests feed.
	internal type AuTestStream {
		// The frame the next read starts at.
		internal framePosition uint64

		internal samples  float32[]
		internal channels int
		internal at       int

		def new(samples float32[], channels int) {
			self.samples = samples
			self.channels = channels
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return AudioInfo{sampleRate: 8000, channels: uint16(channels), format: SampleFormat.Float32, frames: uint64(samples.len() / channels)}
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream. It cannot fail.
		internal def readFrames(buf float32[]) !int {
			let n = (samples.len() - at).min(buf.len())
			for let i = 0; i < n; i++ {
				buf[i] = samples[at + i]
			}
			at += n
			return n / channels
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream. It cannot fail.
		internal def seekFrame(frame uint64) !none {
			at = int(frame) * channels
			return none
		}

		// close implements io.Closer. It cannot fail.
		def close() !none {
			return none
		}
	}

	// A reader that hands out at most three bytes a call and cannot be
	// repositioned.
	internal type AuTrickleReader {
		internal data byte[]
		internal at   int

		def new(data byte[]) {
			self.data = data
		}

		// read implements io.Reader. It cannot fail.
		def read(buf byte[]) !int {
			let n = (data.len() - at).min(buf.len()).min(3)
			data[at:at + n].copy(buf)
			at += n
			return n
		}
	}

	// A writer that keeps what it is given and cannot be repositioned.
	internal type AuSinkWriter {
		out byte[]

		// write implements io.Writer. It cannot fail.
		def write(buf byte[]) !int {
			for let (_, b) in buf {
				out.push(b)
			}
			return buf.len()
		}
	}

	check "AU" {
		// An AU file: the header with the encoding, rate, channel count and
		// data size, the annotation, then the data.
		internal def auFile(encoding int, rate int, channels int, size int, annotation byte[], data byte[]) byte[] {
			let out = new bytes.Buffer()
			out.write(byte[0x2E, 0x73, 0x6E, 0x64]) onerror recover 0
			for let (_, v) in int[24 + annotation.len(), size, encoding, rate, channels] {
				out.write<uint32>(uint32(v)) onerror recover none
			}
			out.write(annotation) onerror recover 0
			out.write(data) onerror recover 0
			return out.bytes()
		}

		// Every sample the file decodes to. Fails when decoding does.
		internal def decodeAll(data byte[]) !float32[] {
			let stream = try new AU().open(new bytes.Reader(data))
			let channels = int(stream.info().channels)
			let all float32[]
			let buf float32[]
			buf.len(4 * channels)
			for {
				let n = try stream.read(buf)
				break when n == 0
				for let i = 0; i < n * channels; i++ {
					all.push(buf[i])
				}
			}
			return all
		}

		// Whether decoding the file fails.
		internal def fails(data byte[]) bool {
			decodeAll(data) onerror (err error) {
				return true
			}
			return false
		}

		// Whether seeking the stream to the frame succeeds.
		internal def seeks(stream AudioStream, frame uint64) bool {
			stream.seek(frame) onerror (err error) {
				return false
			}
			return true
		}

		// Whether the samples are the expected ones, each within `tolerance`.
		internal def near(got float32[], want float32[], tolerance float) bool {
			return false when got.len() != want.len()
			for let (i, v) in want {
				return false when (float(got[i]) - float(v)).abs() > tolerance
			}
			return true
		}

		// A stereo ramp over -1..1 with both ends, a sample above 1 and a
		// sample below -1.
		internal def ramp() float32[] {
			let out float32[]
			for let i = 0; i <= 64; i++ {
				let v = float32(i - 32) / 32.0
				out.push(v)
				out.push(-v * 0.25)
			}
			out.push(float32(1.5))
			out.push(float32(-1.5))
			return out
		}

		// The ramp encoded in the encoding, into a `bytes.Buffer`.
		internal def encoded(encoding AuEncoding, annotation string = "") byte[] {
			let codec = new AU()
			codec.encoding = encoding
			codec.annotation = annotation
			let out = new bytes.Buffer()
			codec.encode(new AuTestStream(ramp(), 2), out) onerror recover none
			return out.bytes()
		}

		// The big-endian 32-bit field at `o`.
		internal def field(data byte[], o int) int {
			return int(data[o]) << 24 | int(data[o + 1]) << 16 | int(data[o + 2]) << 8 | int(data[o + 3])
		}

		// Encodes the ramp and decodes it back, within `tolerance`, clipping
		// beyond -1..1 unless the encoding is float.
		internal def roundTrips(encoding AuEncoding, bytesPerSample int, tolerance float) !bool {
			let data = encoded(encoding)
			return false unless data.len() == 32 + 132 * bytesPerSample
			return false unless field(data, 8) == 132 * bytesPerSample && field(data, 12) == int(encoding.value)
			let want = ramp()
			if encoding != AuEncoding.Float && encoding != AuEncoding.Double {
				want[130], want[131] = 1.0, -1.0
			}
			return near(try decodeAll(data), want, tolerance)
		}

		@test()
		def decodes_mu_law() !none {
			let data = auFile(1, 8000, 1, 4, byte[0, 0, 0, 0], byte[0xFF, 0x80, 0x00, 0xF0])
			assert near(try decodeAll(data), float32[0.0, float32(32124.0 / 32768.0), float32(-32124.0 / 32768.0), float32(120.0 / 32768.0)], 0.0)
		}

		@test()
		def decodes_a_law() !none {
			let data = auFile(27, 8000, 1, 3, byte[0, 0, 0, 0], byte[0xD5, 0x55, 0xAA])
			assert near(try decodeAll(data), float32[float32(8.0 / 32768.0), float32(-8.0 / 32768.0), float32(32256.0 / 32768.0)], 0.0)
		}

		@test()
		def decodes_linear_8() !none {
			let data = auFile(2, 8000, 1, 3, byte[0, 0, 0, 0], byte[0x80, 0x40, 0xFF])
			assert near(try decodeAll(data), float32[-1.0, 0.5, float32(-1.0 / 128.0)], 0.0)
		}

		@test()
		def decodes_linear_16() !none {
			let data = auFile(3, 8000, 2, 8, byte[0, 0, 0, 0], byte[0x80, 0x00, 0x40, 0x00, 0xFF, 0xFF, 0x00, 0x01])
			assert near(try decodeAll(data), float32[-1.0, 0.5, float32(-1.0 / 32768.0), float32(1.0 / 32768.0)], 0.0)
		}

		@test()
		def decodes_linear_24() !none {
			let data = auFile(4, 8000, 1, 6, byte[0, 0, 0, 0], byte[0x80, 0, 0, 0x40, 0, 0])
			assert near(try decodeAll(data), float32[-1.0, 0.5], 0.0)
		}

		@test()
		def decodes_linear_32() !none {
			let data = auFile(5, 8000, 1, 8, byte[0, 0, 0, 0], byte[0x80, 0, 0, 0, 0xC0, 0, 0, 0])
			assert near(try decodeAll(data), float32[-1.0, -0.5], 0.0)
		}

		@test()
		def decodes_float() !none {
			let data = auFile(6, 8000, 1, 8, byte[0, 0, 0, 0], byte[0x3F, 0, 0, 0, 0xBE, 0x80, 0, 0])
			assert near(try decodeAll(data), float32[0.5, -0.25], 0.0)
		}

		@test()
		def decodes_double() !none {
			let data = auFile(7, 8000, 1, 8, byte[0, 0, 0, 0], byte[0x3F, 0xE0, 0, 0, 0, 0, 0, 0])
			assert near(try decodeAll(data), float32[0.5], 0.0)
		}

		@test()
		def reads_the_header_and_annotation() !none {
			let text = "hello".bytes()
			text.push(0)
			text.push(0)
			text.push(0)
			let data = auFile(4, 44100, 2, 600, text, byte[])
			let codec = new AU()
			let info = codec.info(new bytes.Reader(data)) onerror recover AudioInfo{}
			assert info.sampleRate == 44100 && info.channels == 2
			assert info.bitDepth == 24 && info.format == SampleFormat.Int24
			assert info.frames == 100 && info.codec == "au"
			assert info.length == duration(int64(100 * 1000000000 / 44100))
			assert info.bitrate == 44100 * 2 * 24
			assert codec.annotation == "hello"
			assert codec.encoding == AuEncoding.Linear24
		}

		@test()
		def reads_an_unknown_size_to_the_end() !none {
			let data = auFile(3, 8000, 1, 0xFFFFFFFF, byte[0, 0, 0, 0], byte[0x40, 0, 0x20, 0, 0x10])
			let stream = try new AU().open(new bytes.Reader(data))
			assert stream.info().frames == 0
			// The odd byte at the end is a partial frame and is dropped.
			assert near(try decodeAll(data), float32[0.5, 0.25], 0.0)
		}

		@test()
		def stops_at_the_data_size() !none {
			let data = auFile(2, 8000, 1, 2, byte[0, 0, 0, 0], byte[0x40, 0x20, 0x10, 0x08])
			assert near(try decodeAll(data), float32[0.5, 0.25], 0.0)
		}

		@test()
		def reads_from_a_trickling_reader() !none {
			let data = auFile(3, 8000, 2, 8, byte[0, 0, 0, 0], byte[0x80, 0x00, 0x40, 0x00, 0x20, 0x00, 0x10, 0x00])
			let stream = try new AU().open(new AuTrickleReader(data))
			assert !stream.info().seekable
			let buf float32[]
			buf.len(4)
			assert (try stream.read(buf)) == 2
			assert buf[0] == -1.0 && buf[3] == 0.125
			assert (try stream.read(buf)) == 0
			assert !seeks(stream, 0)
		}

		@test()
		def seeks_on_a_byte_reader() !none {
			let data = auFile(2, 8000, 2, 6, byte[0, 0, 0, 0], byte[1, 2, 3, 4, 5, 6])
			let stream = try new AU().open(new bytes.Reader(data))
			assert stream.info().seekable
			let buf float32[]
			buf.len(2)
			assert seeks(stream, 2)
			assert (try stream.read(buf)) == 1
			assert buf[0] == float32(5.0 / 128.0) && buf[1] == float32(6.0 / 128.0)
			assert seeks(stream, 0)
			assert (try stream.read(buf)) == 1
			assert buf[0] == float32(1.0 / 128.0)
			assert !seeks(stream, 4)
			assert seeks(stream, 3)
		}

		@test()
		def rejects_a_buffer_of_partial_frames() !none {
			let data = auFile(2, 8000, 2, 4, byte[0, 0, 0, 0], byte[1, 2, 3, 4])
			let stream = try new AU().open(new bytes.Reader(data))
			let buf float32[]
			buf.len(3)
			let failed = false
			stream.read(buf) onerror (err error) {
				failed = true
				recover 0
			}
			assert failed
		}

		@test()
		def rejects_what_it_cannot_decode() !none {
			let good = auFile(3, 8000, 1, 2, byte[0, 0, 0, 0], byte[0, 1])
			// A truncated header.
			assert fails(good[:20])
			// A truncated annotation.
			assert fails(auFile(3, 8000, 1, 2, byte[0, 0, 0, 0], byte[])[:26])
			// Not the magic.
			let bad = auFile(3, 8000, 1, 2, byte[0, 0, 0, 0], byte[0, 1])
			bad[0] = byte(0x2F)
			assert fails(bad)
			// An encoding outside the list: 23 is G.721 ADPCM.
			assert fails(auFile(23, 8000, 1, 2, byte[0, 0, 0, 0], byte[0, 1]))
			// No channels, no rate.
			assert fails(auFile(3, 8000, 0, 2, byte[0, 0, 0, 0], byte[0, 1]))
			assert fails(auFile(3, 0, 1, 2, byte[0, 0, 0, 0], byte[0, 1]))
			// A data offset inside the header.
			let early = auFile(3, 8000, 1, 2, byte[0, 0, 0, 0], byte[0, 1])
			early[7] = byte(20)
			assert fails(early)
		}

		@test()
		def round_trips_mu_law() !none {
			assert try roundTrips(AuEncoding.MuLaw, 1, 0.032)
		}

		@test()
		def round_trips_a_law() !none {
			assert try roundTrips(AuEncoding.ALaw, 1, 0.032)
		}

		@test()
		def round_trips_linear_8() !none {
			assert try roundTrips(AuEncoding.Linear8, 1, 1.0 / 128.0)
		}

		@test()
		def round_trips_linear_16() !none {
			assert try roundTrips(AuEncoding.Linear16, 2, 1.0 / 32768.0)
		}

		@test()
		def round_trips_linear_24() !none {
			assert try roundTrips(AuEncoding.Linear24, 3, 1.0 / 8388608.0)
		}

		@test()
		def round_trips_linear_32() !none {
			assert try roundTrips(AuEncoding.Linear32, 4, 1.0 / 2147483648.0)
		}

		@test()
		def round_trips_float() !none {
			assert try roundTrips(AuEncoding.Float, 4, 0.0)
		}

		@test()
		def round_trips_double() !none {
			assert try roundTrips(AuEncoding.Double, 8, 0.0)
		}

		@test()
		def g711_picks_the_nearest_code() !none {
			// µ-law codes near zero stand for multiples of 8, A-law ones for
			// multiples of 16 offset by 8.
			let samples = float32[float32(96.0 / 32768.0), float32(101.0 / 32768.0), float32(-99.0 / 32768.0), float32(1.0)]
			let codec = new AU()
			codec.encoding = AuEncoding.MuLaw
			let out = new bytes.Buffer()
			try codec.encode(new AuTestStream(samples, 1), out)
			let want = float32[float32(96.0 / 32768.0), float32(104.0 / 32768.0), float32(-96.0 / 32768.0), float32(32124.0 / 32768.0)]
			assert near(try decodeAll(out.bytes()), want, 0.0)

			codec.encoding = AuEncoding.ALaw
			out = new bytes.Buffer()
			try codec.encode(new AuTestStream(samples, 1), out)
			want = float32[float32(104.0 / 32768.0), float32(104.0 / 32768.0), float32(-104.0 / 32768.0), float32(32256.0 / 32768.0)]
			assert near(try decodeAll(out.bytes()), want, 0.0)
		}

		@test()
		def writes_the_annotation() !none {
			let data = encoded(AuEncoding.Linear16, "made by adm")
			// 11 bytes and a NUL, padded to 16.
			assert field(data, 4) == 40
			assert string(data[24:35]) == "made by adm" && data[35] == 0
			let codec = new AU()
			codec.info(new bytes.Reader(data)) onerror recover AudioInfo{}
			assert codec.annotation == "made by adm"
		}

		@test()
		def writes_an_unknown_size_to_a_plain_writer() !none {
			let sink = new AuSinkWriter()
			new AU().encode(new AuTestStream(ramp(), 2), sink) onerror recover none
			assert sink.out.len() == 32 + 132 * 2
			assert field(sink.out, 8) == 0xFFFFFFFF
			let want = ramp()
			want[130], want[131] = 1.0, -1.0
			assert near(try decodeAll(sink.out), want, 1.0 / 32768.0)
		}

		@test()
		def registers_as_the_au_codec() !none {
			assert codecRegistry.matchExt(".au") is AU
			assert codecRegistry.matchExt("snd") is AU
			let out = new bytes.Buffer()
			write(new AuTestStream(ramp(), 2), out, ".au") onerror recover none
			assert field(out.bytes(), 12) == 3
			// Through the registry's probe; `load` is not used because its
			// deferred close breaks the LLVM link (a compiler bug).
			let stream = try open(out.bytes())
			assert stream.info().codec == "au" && stream.info().frames == 66
			let buf float32[]
			buf.len(200)
			assert (try stream.read(buf)) == 66
			assert new AU().matchSignature(new bytes.Reader(out.bytes()))
			assert !new AU().matchSignature(new bytes.Reader(byte[0x2E, 0x73, 0x6E]))
		}
	}
}
