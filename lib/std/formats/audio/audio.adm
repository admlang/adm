partial module std.formats.audio {
	use std.io

	// How PCM samples are laid out in memory.
	//
	// `AudioStream` always yields `Float32` frames regardless of what the file
	// stores; this reports what the file itself holds, for callers that care
	// about the source resolution.
	enum SampleFormat {
		Uint8,
		Int16,
		Int24,
		Int32,
		Float32,
		Float64
	}

	// What a file says about its audio before any of it is decoded.
	//
	// Reading this only touches headers, so it stays cheap on a large file.
	struct AudioInfo {
		// Frames per second, per channel: 44100, 48000.
		sampleRate uint32
		channels   uint16
		// Bits per sample as stored in the file.
		bitDepth   uint16
		// Sample layout as stored in the file, which is not what `AudioStream`
		// yields -- see `SampleFormat`.
		format     SampleFormat
		// Total frames, or 0 when the format does not record a length and it
		// cannot be derived without decoding (some streamed ogg, VBR mp3).
		frames     uint64
		// Zero when `frames` is unknown.
		length     duration
		// Lowercase format-owned name: "mp3", "flac", "opus".
		codec      string
		// Average bits per second. 0 when unknown.
		bitrate    uint32
		// Whether `AudioStream.seek` works on this file.
		seekable   bool
	}

	// A frame is one sample per channel, so a stereo frame is two samples.
	// Frames are interleaved: L R L R for stereo.
	//
	// Samples are always `float32` in -1.0..1.0, whatever the file stores. That
	// is what makes decoders interchangeable -- it is lossless for everything up
	// to 24-bit and is the form mixing and DSP want. `AudioInfo.format` reports
	// the file's own layout for callers that need it.
	interface AudioStream {
		io.Closer

		def info() AudioInfo
		// Fills `buf` with interleaved samples and returns the frame count
		// written, which is 0 at end of stream. `buf` must hold a whole number
		// of frames: its length must be a multiple of `info().channels`.
		def read(buf float32[]) !int
		// Positions the stream at `frame`. Fails when `info().seekable` is false.
		def seek(frame uint64) !none
	}

	// Every audio file fully decoded into memory.
	//
	// An hour of 48kHz stereo is over a gigabyte, so this is for short sounds --
	// effects, UI, samples. Use `AudioStream` for anything long.
	struct Audio {
		info    AudioInfo
		// Interleaved frames, `info.frames * info.channels` samples long.
		samples float32[]
	}

	// What the codec registry discovers: one stateless instance per file format.
	//
	// Deliberately minimal. Anything a single format offers beyond decoding --
	// ID3 on mp3, Vorbis comments on flac, chapters on m4a -- belongs on that
	// codec's own type, reached by instantiating it directly, not here.
	interface AudioFormat {
		def open(reader io.Reader) !AudioStream
		// Header-only read, without building a decoder for the whole file.
		def info(reader io.Reader) !AudioInfo
	}


}
