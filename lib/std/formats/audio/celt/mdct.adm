internal partial module std.formats.audio.celt {
	use (
		std.math
		std.formats.audio.m4a::*
	)

	// A complex FFT of one mixed-radix size (factors 2, 3, 4 and 5) over
	// interleaved re/im float32 pairs.
	type CeltFft {
		// Complex points.
		n      int
		cosTw  float[]
		sinTw  float[]
		// Input index of each output position before the butterflies run.
		perm   int[]
		// Radix, sub-transform size and twiddle stride of each stage, outermost
		// first.
		radix  int[]
		sub    int[]
		stride int[]
		xr     float[]
		xi     float[]

		// A transform of n points; n must factor into 2, 3, 4 and 5.
		def new(n int) {
			self.n = n
			cosTw.len(n)
			sinTw.len(n)
			for let i = 0; i < n; i++ {
				let a = -2.0 * math.π * float(i) / float(n)
				cosTw[i] = math.cos(a)
				sinTw[i] = math.sin(a)
			}
			let rest = n
			let fs = 1
			for rest > 1 {
				let p = 5
				if rest % 4 == 0 {
					p = 4
				} else if rest % 2 == 0 {
					p = 2
				} else if rest % 3 == 0 {
					p = 3
				}
				rest /= p
				radix.push(p)
				sub.push(rest)
				stride.push(fs)
				fs *= p
			}
			perm.len(n)
			fill(0, 0, 1, 0)
			xr.len(5)
			xi.len(5)
		}

		// Records, for output position `out`, the input index the recursive
		// decimation reads, level by level.
		def fill(out int, from int, fstride int, level int) {
			if level == radix.len() {
				perm[out] = from
				return
			}
			let p = radix[level]
			let m = sub[level]
			for let j = 0; j < p; j++ {
				fill(out + j * m, from + j * fstride, fstride * p, level + 1)
			}
		}

		// Transforms the n points of `src` into `dst` (different arrays):
		// e^-i when `inverse` is false, e^+i when it is true, unscaled.
		def transform(src float32[], dst float32[], inverse bool) {
			for let i = 0; i < n; i++ {
				let from = perm[i]
				dst[2 * i] = src[2 * from]
				dst[2 * i + 1] = src[2 * from + 1]
			}
			let sign float = inverse ?? (-1.0, 1.0)
			for let level = radix.len() - 1; level >= 0; level-- {
				let p = radix[level]
				let m = sub[level]
				let fs = stride[level]
				if p == 2 {
					butterfly2(dst, m, fs, sign)
				} else if p == 4 {
					butterfly4(dst, m, fs, sign)
				} else if p == 3 {
					butterfly3(dst, m, fs, sign)
				} else if p == 5 {
					butterfly5(dst, m, fs, sign)
				} else {
					butterflyN(dst, p, m, fs, sign)
				}
			}
		}

		// The radix-2 stage over blocks of 2 * m points.
		def butterfly2(f float32[], m int, fs int, sign float) {
			for let blk = 0; blk < fs; blk++ {
				let base = blk * 2 * m
				for let u = 0; u < m; u++ {
					let a = 2 * (base + u)
					let b = 2 * (base + u + m)
					let tw = u * fs
					let wr = cosTw[tw]
					let wi = sign * sinTw[tw]
					let br = float(f[b]) * wr - float(f[b + 1]) * wi
					let bi = float(f[b]) * wi + float(f[b + 1]) * wr
					let ar = float(f[a])
					let ai = float(f[a + 1])
					f[a] = float32(ar + br)
					f[a + 1] = float32(ai + bi)
					f[b] = float32(ar - br)
					f[b + 1] = float32(ai - bi)
				}
			}
		}

		// The radix-4 stage over blocks of 4 * m points.
		def butterfly4(f float32[], m int, fs int, sign float) {
			for let blk = 0; blk < fs; blk++ {
				let base = blk * 4 * m
				for let u = 0; u < m; u++ {
					let i0 = 2 * (base + u)
					let i1 = 2 * (base + u + m)
					let i2 = 2 * (base + u + 2 * m)
					let i3 = 2 * (base + u + 3 * m)
					let t1 = u * fs
					let t2 = 2 * u * fs
					let t3 = 3 * u * fs
					let x0r = float(f[i0])
					let x0i = float(f[i0 + 1])
					let w1r = cosTw[t1]
					let w1i = sign * sinTw[t1]
					let x1r = float(f[i1]) * w1r - float(f[i1 + 1]) * w1i
					let x1i = float(f[i1]) * w1i + float(f[i1 + 1]) * w1r
					let w2r = cosTw[t2]
					let w2i = sign * sinTw[t2]
					let x2r = float(f[i2]) * w2r - float(f[i2 + 1]) * w2i
					let x2i = float(f[i2]) * w2i + float(f[i2 + 1]) * w2r
					let w3r = cosTw[t3]
					let w3i = sign * sinTw[t3]
					let x3r = float(f[i3]) * w3r - float(f[i3 + 1]) * w3i
					let x3i = float(f[i3]) * w3i + float(f[i3 + 1]) * w3r
					let s0r = x0r + x2r
					let s0i = x0i + x2i
					let s1r = x0r - x2r
					let s1i = x0i - x2i
					let s2r = x1r + x3r
					let s2i = x1i + x3i
					let s3r = x1r - x3r
					let s3i = x1i - x3i
					// Multiplying s3 by -i (forward) or +i (inverse).
					let rr = sign * s3i
					let ri = -sign * s3r
					f[i0] = float32(s0r + s2r)
					f[i0 + 1] = float32(s0i + s2i)
					f[i2] = float32(s0r - s2r)
					f[i2 + 1] = float32(s0i - s2i)
					f[i1] = float32(s1r + rr)
					f[i1 + 1] = float32(s1i + ri)
					f[i3] = float32(s1r - rr)
					f[i3 + 1] = float32(s1i - ri)
				}
			}
		}

		// The radix-3 stage over blocks of 3 * m points.
		def butterfly3(f float32[], m int, fs int, sign float) {
			// Imaginary part of the third root of unity.
			let e = sign * sinTw[m * fs]
			for let blk = 0; blk < fs; blk++ {
				let base = blk * 3 * m
				for let u = 0; u < m; u++ {
					let i0 = 2 * (base + u)
					let i1 = 2 * (base + u + m)
					let i2 = 2 * (base + u + 2 * m)
					let t1 = u * fs
					let t2 = 2 * u * fs
					let w1r = cosTw[t1]
					let w1i = sign * sinTw[t1]
					let w2r = cosTw[t2]
					let w2i = sign * sinTw[t2]
					let x1r = float(f[i1]) * w1r - float(f[i1 + 1]) * w1i
					let x1i = float(f[i1]) * w1i + float(f[i1 + 1]) * w1r
					let x2r = float(f[i2]) * w2r - float(f[i2 + 1]) * w2i
					let x2i = float(f[i2]) * w2i + float(f[i2 + 1]) * w2r
					let sr = x1r + x2r
					let si = x1i + x2i
					let dr = (x1r - x2r) * e
					let di = (x1i - x2i) * e
					let x0r = float(f[i0])
					let x0i = float(f[i0 + 1])
					let hr = x0r - 0.5 * sr
					let hi = x0i - 0.5 * si
					f[i0] = float32(x0r + sr)
					f[i0 + 1] = float32(x0i + si)
					f[i1] = float32(hr - di)
					f[i1 + 1] = float32(hi + dr)
					f[i2] = float32(hr + di)
					f[i2 + 1] = float32(hi - dr)
				}
			}
		}

		// The radix-5 stage over blocks of 5 * m points.
		def butterfly5(f float32[], m int, fs int, sign float) {
			// The first and second fifth roots of unity.
			let ar = cosTw[m * fs]
			let ai = sign * sinTw[m * fs]
			let br = cosTw[2 * m * fs]
			let bi = sign * sinTw[2 * m * fs]
			for let blk = 0; blk < fs; blk++ {
				let base = blk * 5 * m
				for let u = 0; u < m; u++ {
					let i0 = 2 * (base + u)
					let i1 = 2 * (base + u + m)
					let i2 = 2 * (base + u + 2 * m)
					let i3 = 2 * (base + u + 3 * m)
					let i4 = 2 * (base + u + 4 * m)
					let t = u * fs
					let w1r = cosTw[t]
					let w1i = sign * sinTw[t]
					let w2r = cosTw[2 * t]
					let w2i = sign * sinTw[2 * t]
					let w3r = cosTw[3 * t]
					let w3i = sign * sinTw[3 * t]
					let w4r = cosTw[4 * t]
					let w4i = sign * sinTw[4 * t]
					let x1r = float(f[i1]) * w1r - float(f[i1 + 1]) * w1i
					let x1i = float(f[i1]) * w1i + float(f[i1 + 1]) * w1r
					let x2r = float(f[i2]) * w2r - float(f[i2 + 1]) * w2i
					let x2i = float(f[i2]) * w2i + float(f[i2 + 1]) * w2r
					let x3r = float(f[i3]) * w3r - float(f[i3 + 1]) * w3i
					let x3i = float(f[i3]) * w3i + float(f[i3 + 1]) * w3r
					let x4r = float(f[i4]) * w4r - float(f[i4 + 1]) * w4i
					let x4i = float(f[i4]) * w4i + float(f[i4 + 1]) * w4r
					let s7r = x1r + x4r
					let s7i = x1i + x4i
					let s10r = x1r - x4r
					let s10i = x1i - x4i
					let s8r = x2r + x3r
					let s8i = x2i + x3i
					let s9r = x2r - x3r
					let s9i = x2i - x3i
					let x0r = float(f[i0])
					let x0i = float(f[i0 + 1])
					f[i0] = float32(x0r + s7r + s8r)
					f[i0 + 1] = float32(x0i + s7i + s8i)
					let s5r = x0r + s7r * ar + s8r * br
					let s5i = x0i + s7i * ar + s8i * br
					let s6r = s10i * ai + s9i * bi
					let s6i = 0.0 - (s10r * ai + s9r * bi)
					f[i1] = float32(s5r - s6r)
					f[i1 + 1] = float32(s5i - s6i)
					f[i4] = float32(s5r + s6r)
					f[i4 + 1] = float32(s5i + s6i)
					let s11r = x0r + s7r * br + s8r * ar
					let s11i = x0i + s7i * br + s8i * ar
					let s12r = s9i * ai - s10i * bi
					let s12i = s10r * bi - s9r * ai
					f[i2] = float32(s11r + s12r)
					f[i2 + 1] = float32(s11i + s12i)
					f[i3] = float32(s11r - s12r)
					f[i3 + 1] = float32(s11i - s12i)
				}
			}
		}

		// A radix-p stage (3 or 5) over blocks of p * m points, by direct DFTs.
		def butterflyN(f float32[], p int, m int, fs int, sign float) {
			// p * m * fs is n, so the input twiddles q * u * fs stay below n,
			// and the DFT twiddle k * q * m * fs mod n is ((k * q) mod p) * m * fs.
			let xr = self.xr
			let xi = self.xi
			let dftStep = m * fs
			for let blk = 0; blk < fs; blk++ {
				let base = blk * p * m
				for let u = 0; u < m; u++ {
					let tw = 0
					for let q = 0; q < p; q++ {
						let at = 2 * (base + u + q * m)
						let wr = cosTw[tw]
						let wi = sign * sinTw[tw]
						xr[q] = float(f[at]) * wr - float(f[at + 1]) * wi
						xi[q] = float(f[at]) * wi + float(f[at + 1]) * wr
						tw += u * fs
					}
					for let k = 0; k < p; k++ {
						let sr = 0.0
						let si = 0.0
						let kq = 0
						for let q = 0; q < p; q++ {
							let dt = kq * dftStep
							let wr = cosTw[dt]
							let wi = sign * sinTw[dt]
							sr += xr[q] * wr - xi[q] * wi
							si += xr[q] * wi + xi[q] * wr
							kq += k
							kq -= p when kq >= p
						}
						let at = 2 * (base + u + k * m)
						f[at] = float32(sr)
						f[at + 1] = float32(si)
					}
				}
			}
		}
	}

	// The MDCT of the 48 kHz CELT mode: 1920 points at the 20 ms frame size,
	// halved per `shift` down to 240 points for a 2.5 ms block, with the
	// low-overlap window of 120 samples.
	type CeltMdct {
		// The 120-sample overlap window, rising.
		window float32[]
		ffts   CeltFft[]
		// cos and sin of 2π(i + 1/8)/N for each shift, N4 values each.
		cosPh  float32[][]
		sinPh  float32[][]
		f      float32[]
		f2     float32[]

		// The transforms of every frame size.
		def new() {
			window.len(120)
			for let i = 0; i < 120; i++ {
				let s = math.sin(0.5 * math.π * (float(i) + 0.5) / 120.0)
				window[i] = float32(math.sin(0.5 * math.π * s * s))
			}
			for let shift = 0; shift < 4; shift++ {
				let n = 1920 >> shift
				let n4 = n >> 2
				ffts.push(new CeltFft(n4))
				let c float32[]
				let s float32[]
				c.len(n4)
				s.len(n4)
				for let i = 0; i < n4; i++ {
					let a = 2.0 * math.π * (float(i) + 0.125) / float(n)
					c[i] = float32(math.cos(a))
					s[i] = float32(math.sin(a))
				}
				cosPh.push(c)
				sinPh.push(s)
			}
			f.len(960)
			f2.len(960)
		}

		// The inverse MDCT of the N/2 coefficients at `input[at]`, every
		// `stride`-th, overlap-added into `out` from `outAt`: the first 120
		// samples are added to what `out` holds, the rest overwritten.
		def backward(input float32[], at int, stride int, out float32[], outAt int, shift int) {
			let n = 1920 >> shift
			let n2 = n >> 1
			let n4 = n >> 2
			let c = cosPh[shift]
			let s = sinPh[shift]
			let fft = ffts[shift]
			let overlap = 120
			let x1 = at
			let x2 = at + stride * (n2 - 1)
			for let i = 0; i < n4; i++ {
				let a = input[x1]
				let b = input[x2]
				f2[2 * i] = -b * c[i] + a * s[i]
				f2[2 * i + 1] = -b * s[i] - a * c[i]
				x1 += 2 * stride
				x2 -= 2 * stride
			}
			fft.transform(f2, f, true)
			for let i = 0; i < n4; i++ {
				let re = f[2 * i]
				let im = f[2 * i + 1]
				f[2 * i] = re * c[i] - im * s[i]
				f[2 * i + 1] = im * c[i] + re * s[i]
			}
			let fp1 = 0
			let fp2 = n2 - 1
			for let i = 0; i < n4; i++ {
				f2[2 * i] = -f[fp1]
				f2[2 * i + 1] = f[fp2]
				fp1 += 2
				fp2 -= 2
			}
			let o = outAt - ((n2 - overlap) >> 1)
			let half = overlap / 2
			let q1 = n4 - 1
			let xp1 = o + n2 - 1
			let yp1 = o + n4 - half
			let w1 = 0
			let w2 = overlap - 1
			for let i = 0; i < n4 - half; i++ {
				out[xp1] = f2[q1]
				xp1--
				q1--
			}
			for let i = n4 - half; i < n4; i++ {
				let v = f2[q1]
				q1--
				out[yp1] = out[yp1] - window[w1] * v
				out[xp1] = out[xp1] + window[w2] * v
				yp1++
				xp1--
				w1++
				w2--
			}
			let q2 = n4
			let xp2 = o + n2
			let yp2 = o + n - 1 - (n4 - half)
			w1 = 0
			w2 = overlap - 1
			for let i = 0; i < n4 - half; i++ {
				out[xp2] = f2[q2]
				xp2++
				q2++
			}
			for let i = n4 - half; i < n4; i++ {
				let v = f2[q2]
				q2++
				out[yp2] = window[w1] * v
				out[xp2] = window[w2] * v
				yp2--
				xp2++
				w1++
				w2--
			}
		}

		// The forward MDCT of the N + 120 windowed samples at `input[at]`
		// into N/2 coefficients written every `stride`-th from `out[outAt]`.
		def forward(input float32[], at int, out float32[], outAt int, stride int, shift int) {
			let n = 1920 >> shift
			let n2 = n >> 1
			let n4 = n >> 2
			let c = cosPh[shift]
			let s = sinPh[shift]
			let fft = ffts[shift]
			let overlap = 120
			let xp1 = at + (overlap >> 1)
			let xp2 = at + n2 - 1 + (overlap >> 1)
			let wp1 = overlap >> 1
			let wp2 = (overlap >> 1) - 1
			let y = 0
			let i = 0
			for; i < (overlap >> 2); i++ {
				f[y] = window[wp2] * input[xp1 + n2] + window[wp1] * input[xp2]
				f[y + 1] = window[wp1] * input[xp1] - window[wp2] * input[xp2 - n2]
				y += 2
				xp1 += 2
				xp2 -= 2
				wp1 += 2
				wp2 -= 2
			}
			wp1 = 0
			wp2 = overlap - 1
			for; i < n4 - (overlap >> 2); i++ {
				f[y] = input[xp2]
				f[y + 1] = input[xp1]
				y += 2
				xp1 += 2
				xp2 -= 2
			}
			for; i < n4; i++ {
				f[y] = -window[wp1] * input[xp1 - n2] + window[wp2] * input[xp2]
				f[y + 1] = window[wp2] * input[xp1] + window[wp1] * input[xp2 + n2]
				y += 2
				xp1 += 2
				xp2 -= 2
				wp1 += 2
				wp2 -= 2
			}
			let scale = float32(1.0 / float(n4))
			for let k = 0; k < n4; k++ {
				let re = f[2 * k]
				let im = f[2 * k + 1]
				f2[2 * k] = (-re * c[k] - im * s[k]) * scale
				f2[2 * k + 1] = (-im * c[k] + re * s[k]) * scale
			}
			fft.transform(f2, f, false)
			let yp1 = outAt
			let yp2 = outAt + stride * (n2 - 1)
			for let k = 0; k < n4; k++ {
				let re = f[2 * k]
				let im = f[2 * k + 1]
				out[yp1] = re * c[k] + im * s[k]
				out[yp2] = re * s[k] - im * c[k]
				yp1 += 2 * stride
				yp2 -= 2 * stride
			}
		}
	}
}
