internal partial module std.formats.audio.celt {
	use (
		std.formats.audio.m4a::*
		std.formats.audio.opus::*
	)

	// Spreading of the pulses across a band (RFC 6716 section 4.3.4.3):
	// none.
	const celtSpreadNone = 0

	// Light spreading.
	const celtSpreadLight = 1

	// Normal spreading.
	const celtSpreadNormal = 2

	// Aggressive spreading.
	const celtSpreadAggressive = 3

	// The CELT noise generator: the next state of a linear congruential
	// generator, 32 bits wide.
	def celtLcgRand(seed int) int {
		return (1664525 * seed + 1013904223) & 0xFFFFFFFF
	}

	// The number of pulses a pseudo-pulse index stands for.
	def celtPulses(i int) int {
		return i when i < 8
		return (8 + (i & 7)) << ((i >> 3) - 1)
	}

	// The most pseudo-pulses band `band` at `lm` holds within `bits` eighth
	// bits.
	def celtBitsToPulses(band int, lm int, bits int) int {
		let at = celtCacheIndex[(lm + 1) * 21 + band]
		let lo = 0
		let hi = celtCacheBits[at]
		let b = bits - 1
		for let i = 0; i < 6; i++ {
			let mid = (lo + hi + 1) >> 1
			if celtCacheBits[at + mid] >= b {
				hi = mid
			} else {
				lo = mid
			}
		}
		let below = lo == 0 ?? (-1, celtCacheBits[at + lo])
		return lo when b - below <= celtCacheBits[at + hi] - b
		return hi
	}

	// The eighth bits `pulses` pseudo-pulses cost in band `band` at `lm`.
	def celtPulsesToBits(band int, lm int, pulses int) int {
		return 0 when pulses == 0
		let at = celtCacheIndex[(lm + 1) * 21 + band]
		return celtCacheBits[at + pulses] + 1
	}

	// Q15 multiply with rounding, as the reference's FRAC_MUL16.
	def celtFracMul16(a int, b int) int {
		return (16384 + a * b) >> 15
	}

	// A cosine of the split angle that every platform computes alike.
	def celtBitexactCos(x int) int {
		let tmp = (4096 + x * x) >> 13
		let x2 = tmp
		x2 = (32767 - x2) + celtFracMul16(x2, (-7651 + celtFracMul16(x2, (8277 + celtFracMul16(-626, x2)))))
		return 1 + x2
	}

	// log2(sin/cos) in Q11, bit-exact.
	def celtBitexactLog2tan(isin int, icos int) int {
		let lc = opusIlog(icos)
		let ls = opusIlog(isin)
		let c = icos << (15 - lc)
		let s = isin << (15 - ls)
		return (ls - lc) * (1 << 11) + celtFracMul16(s, celtFracMul16(s, -2597) + 7932) - celtFracMul16(c, celtFracMul16(c, -2597) + 7932)
	}

	// Codes the normalized shapes of the bands of one frame, decoding them
	// or encoding them, together with the split angles and stereo
	// parameters (RFC 6716 section 4.3.4).
	type CeltBands {
		// Encoding rather than decoding.
		encode    bool
		// The decoder, when decoding.
		dec       OpusRangeDecoder
		// The encoder, when encoding.
		enc       OpusRangeEncoder
		// Eighth bits left for the frame.
		remaining int
		// The noise generator state.
		seed      int
		// The spreading of the frame: celtSpreadNone to celtSpreadAggressive.
		spread    int
		// The first band coded with intensity stereo.
		intensity int
		// Band amplitudes of the frame, which intensity stereo needs when
		// encoding.
		bandE     float32[]
		norm      float32[]
		scr       float32[]
		tmp       float32[]
		iy        int[]
		signx     float32[]
		yq        float32[]
		nil       float32[]

		// A coder with its buffers; set `dec` or `enc` before use.
		def new() {
			dec = new OpusRangeDecoder(byte[], 0, 0)
			enc = new OpusRangeEncoder(0)
			norm.len(2 * 8 * 100)
			scr.len(8 * 22)
			tmp.len(8 * 22)
			iy.len(8 * 22)
			signx.len(8 * 22)
			yq.len(8 * 22)
			bandE.len(42)
		}

		// Eighth bits used so far by whichever coder runs.
		def tellFrac() int {
			return encode ?? (enc.tellFrac(), dec.tellFrac())
		}

		// Codes bands start..end-1 of `x` (and of `x` from `n` on for a
		// second channel when `stereo`), filling `collapse` with each band's
		// collapse mask per channel.
		def quantAll(start int, end int, x float32[], stereo bool, n int, collapse int[], pulses int[], shortBlocks bool, dualStereoIn bool, tfRes int[], totalBits int, balanceIn int, lm int, codedBands int) {
			let m = 1 << lm
			let blocks = shortBlocks ?? (m, 1)
			let c = stereo ?? (2, 1)
			let norm2 = m * celtEBands[21]
			let resynth = !encode
			let lowbandOffset = 0
			let updateLowband = true
			let balance = balanceIn
			let dualStereo = dualStereoIn
			for let i = start; i < end; i++ {
				let xo = m * celtEBands[i]
				let yo = n + xo
				let nb = m * celtEBands[i + 1] - m * celtEBands[i]
				let tell = tellFrac()
				balance -= tell when i != start
				remaining = totalBits - tell - 1
				let b = 0
				if i <= codedBands - 1 {
					let currBalance = balance / (codedBands - i).min(3)
					b = (remaining + 1).min(pulses[i] + currBalance).min(16383).max(0)
				}
				lowbandOffset = i when resynth && (m * celtEBands[i] - nb >= m * celtEBands[start] || i == start + 1) && (updateLowband || lowbandOffset == 0)
				if i == start + 1 {
					let n1 = m * (celtEBands[start + 1] - celtEBands[start])
					let n2 = m * (celtEBands[start + 2] - celtEBands[start + 1])
					let offset = m * celtEBands[start]
					for let j = 0; j < n2 - n1; j++ {
						norm[offset + n1 + j] = norm[offset + 2 * n1 - n2 + j]
						norm[norm2 + offset + n1 + j] = norm[norm2 + offset + 2 * n1 - n2 + j] when stereo
					}
				}
				let tfChange = tfRes[i]
				let effectiveLowband = -1
				let xcm = 0
				let ycm = 0
				if lowbandOffset != 0 && (spread != celtSpreadAggressive || blocks > 1 || tfChange < 0) {
					effectiveLowband = (m * celtEBands[start]).max(m * celtEBands[lowbandOffset] - nb)
					let foldStart = lowbandOffset
					for {
						foldStart--
						break when m * celtEBands[foldStart] <= effectiveLowband
					}
					let foldEnd = lowbandOffset - 1
					for {
						foldEnd++
						break unless foldEnd < i && m * celtEBands[foldEnd] < effectiveLowband + nb
					}
					let f = foldStart
					for {
						xcm |= collapse[f * c]
						ycm |= collapse[f * c + c - 1]
						f++
						break when f >= foldEnd
					}
				} else {
					xcm = (1 << blocks) - 1
					ycm = xcm
				}
				if dualStereo && i == intensity {
					dualStereo = false
					for let j = m * celtEBands[start]; j < m * celtEBands[i]; j++ {
						norm[j] = 0.5 * (norm[j] + norm[norm2 + j])
					}
				}
				let hasLow = effectiveLowband != -1
				// Each band leaves its shape in `norm` for folding and may use the
				// scratch buffer; dual stereo codes the channels one at a time.
				let foldOut = true
				let scratch = true
				let alone = false
				if dualStereo {
					xcm = band(i, x, xo, nil, 0, alone, nb, b / 2, blocks, norm, effectiveLowband, hasLow, lm, norm, m * celtEBands[i], foldOut, 0, float32(1.0), scratch, xcm, tfChange)
					ycm = band(i, x, yo, nil, 0, alone, nb, b / 2, blocks, norm, norm2 + effectiveLowband, hasLow, lm, norm, norm2 + m * celtEBands[i], foldOut, 0, float32(1.0), scratch, ycm, tfChange)
				} else {
					xcm = band(i, x, xo, x, yo, stereo, nb, b, blocks, norm, effectiveLowband, hasLow, lm, norm, m * celtEBands[i], foldOut, 0, float32(1.0), scratch, xcm | ycm, tfChange)
					ycm = xcm
				}
				collapse[i * c] = xcm & 255
				collapse[i * c + c - 1] = ycm & 255
				balance += pulses[i] + tell
				updateLowband = b > (nb << 3)
			}
		}

		// Codes one band (or one half of a split band) of `n` values at
		// `x[xo]`, with its stereo partner at `y[yo]` when `stereo`, from `b`
		// eighth bits; returns the collapse mask of its blocks.
		def band(i int, x float32[], xo int, yIn float32[], yoIn int, stereo bool, n0 int, bIn int, blocksIn int, lowIn float32[], loIn int, hasLowIn bool, lmIn int, lowOut float32[], loo int, hasLowOut bool, level int, gain float32, hasScratch bool, fillIn int, tfIn int) int {
			let resynth = !encode
			let n = n0
			let b = bIn
			let blocks = blocksIn
			let low = lowIn
			let lo = loIn
			let hasLow = hasLowIn
			let lm = lmIn
			let fill = fillIn
			let tf = tfIn
			let y = yIn
			let yo = yoIn
			let nB = n / blocks
			let nB0 = nB
			let b0 = blocks
			let timeDivide = 0
			let recombine = 0
			let inv = false
			let mid float32 = 0.0
			let side float32 = 0.0
			let longBlocks = b0 == 1
			let cm = 0
			let split = stereo
			// Flags of the halves a split band codes: they have no partner, and
			// only the first may fold into `lowOut` or use the scratch buffer.
			let alone = false
			let noFold = false
			let noScratch = false

			if n == 1 {
				let channels = stereo ?? (2, 1)
				for let c = 0; c < channels; c++ {
					let arr = c == 0 ?? (x, y)
					let at = c == 0 ?? (xo, yo)
					let sign = 0
					if remaining >= 8 {
						if encode {
							sign = arr[at] < 0.0 ?? (1, 0)
							enc.bits(sign, 1)
						} else {
							sign = dec.bits(1)
						}
						remaining -= 8
						b -= 8
					}
					arr[at] = sign != 0 ?? (float32(-1.0), float32(1.0)) when resynth
				}
				lowOut[loo] = x[xo] when hasLowOut
				return 1
			}

			if !stereo && level == 0 {
				recombine = tf when tf > 0
				if hasLow && (recombine > 0 || ((nB & 1) == 0 && tf < 0) || b0 > 1) {
					for let j = 0; j < n; j++ {
						scr[j] = low[lo + j]
					}
					low = scr
					lo = 0
				}
				for let k = 0; k < recombine; k++ {
					haar1(x, xo, n >> k, 1 << k) when encode
					haar1(low, lo, n >> k, 1 << k) when hasLow
					fill = celtBitInterleave[fill & 0xF] | (celtBitInterleave[fill >> 4] << 2)
				}
				blocks >>= recombine
				nB <<= recombine
				for (nB & 1) == 0 && tf < 0 {
					haar1(x, xo, nB, blocks) when encode
					haar1(low, lo, nB, blocks) when hasLow
					fill |= fill << blocks
					blocks <<= 1
					nB >>= 1
					timeDivide++
					tf++
				}
				b0 = blocks
				nB0 = nB
				if b0 > 1 {
					deinterleaveHadamard(x, xo, nB >> recombine, b0 << recombine, longBlocks) when encode
					deinterleaveHadamard(low, lo, nB >> recombine, b0 << recombine, longBlocks) when hasLow
				}
			}

			if !stereo && lm != -1 && n > 2 {
				let at = celtCacheIndex[(lm + 1) * 21 + i]
				if b > celtCacheBits[at + celtCacheBits[at]] + 12 {
					n >>= 1
					y = x
					yo = xo + n
					split = true
					lm -= 1
					fill = (fill & 1) | (fill << 1) when blocks == 1
					blocks = (blocks + 1) >> 1
				}
			}

			if split {
				let itheta = 0
				let pulseCap = celtLogN[i] + lm * 8
				let offset = (pulseCap >> 1) - ((stereo && n == 2) ?? (16, 4))
				let qn = computeQn(n, b, offset, pulseCap, stereo)
				qn = 1 when stereo && i >= intensity
				itheta = stereoItheta(x, xo, y, yo, stereo, n) when encode
				let tell = tellFrac()
				if qn != 1 {
					itheta = (itheta * qn + 8192) >> 14 when encode
					if stereo && n > 2 {
						let p0 = 3
						let x0 = qn / 2
						let ft = p0 * (x0 + 1) + x0
						if encode {
							let v = itheta
							let fl = v <= x0 ?? (p0 * v, (v - 1 - x0) + (x0 + 1) * p0)
							let fh = v <= x0 ?? (p0 * (v + 1), (v - x0) + (x0 + 1) * p0)
							enc.encode(fl, fh, ft)
						} else {
							let fs = dec.decode(ft)
							let v = fs < (x0 + 1) * p0 ?? (fs / p0, x0 + 1 + (fs - (x0 + 1) * p0))
							let fl = v <= x0 ?? (p0 * v, (v - 1 - x0) + (x0 + 1) * p0)
							let fh = v <= x0 ?? (p0 * (v + 1), (v - x0) + (x0 + 1) * p0)
							dec.update(fl, fh, ft)
							itheta = v
						}
					} else if b0 > 1 || stereo {
						if encode {
							enc.uint(itheta, qn + 1)
						} else {
							itheta = dec.uint(qn + 1)
						}
					} else {
						let half = qn >> 1
						let ft = (half + 1) * (half + 1)
						if encode {
							let fs = itheta <= half ?? (itheta + 1, qn + 1 - itheta)
							let fl = itheta <= half ?? ((itheta * (itheta + 1)) >> 1, ft - (((qn + 1 - itheta) * (qn + 2 - itheta)) >> 1))
							enc.encode(fl, fl + fs, ft)
						} else {
							let fm = dec.decode(ft)
							let fs = 0
							let fl = 0
							if fm < ((half * (half + 1)) >> 1) {
								itheta = (celtIsqrt(8 * fm + 1) - 1) >> 1
								fs = itheta + 1
								fl = (itheta * (itheta + 1)) >> 1
							} else {
								itheta = (2 * (qn + 1) - celtIsqrt(8 * (ft - fm - 1) + 1)) >> 1
								fs = qn + 1 - itheta
								fl = ft - (((qn + 1 - itheta) * (qn + 2 - itheta)) >> 1)
							}
							dec.update(fl, fl + fs, ft)
						}
					}
					itheta = itheta * 16384 / qn
					if encode && stereo {
						if itheta == 0 {
							intensityStereo(x, xo, y, yo, i, n)
						} else {
							stereoSplit(x, xo, y, yo, n)
						}
					}
				} else if stereo {
					if encode {
						inv = itheta > 8192
						if inv {
							for let j = 0; j < n; j++ {
								y[yo + j] = -y[yo + j]
							}
						}
						intensityStereo(x, xo, y, yo, i, n)
					}
					if b > 16 && remaining > 16 {
						if encode {
							enc.bitLogp(inv, 2)
						} else {
							inv = dec.bitLogp(2)
						}
					} else {
						inv = false
					}
					itheta = 0
				}
				let qalloc = tellFrac() - tell
				b -= qalloc

				let origFill = fill
				let imid = 0
				let iside = 0
				let delta = 0
				if itheta == 0 {
					imid = 32767
					iside = 0
					fill &= (1 << blocks) - 1
					delta = -16384
				} else if itheta == 16384 {
					imid = 0
					iside = 32767
					fill &= ((1 << blocks) - 1) << blocks
					delta = 16384
				} else {
					imid = celtBitexactCos(itheta)
					iside = celtBitexactCos(16384 - itheta)
					delta = celtFracMul16((n - 1) << 7, celtBitexactLog2tan(iside, imid))
				}
				mid = float32(imid) * 0.000030517578125
				side = float32(iside) * 0.000030517578125

				if n == 2 && stereo {
					let mbits = b
					let sbits = 0
					sbits = 8 when itheta != 0 && itheta != 16384
					mbits -= sbits
					let swap = itheta > 8192
					remaining -= qalloc + sbits
					let x2 = swap ?? (y, x)
					let x2o = swap ?? (yo, xo)
					let y2 = swap ?? (x, y)
					let y2o = swap ?? (xo, yo)
					let sign = 0
					if sbits != 0 {
						if encode {
							sign = x2[x2o] * y2[y2o + 1] - x2[x2o + 1] * y2[y2o] < 0.0 ?? (1, 0)
							enc.bits(sign, 1)
						} else {
							sign = dec.bits(1)
						}
					}
					let fsign = float32(1 - 2 * sign)
					cm = band(i, x2, x2o, nil, 0, alone, n, mbits, blocks, low, lo, hasLow, lm, lowOut, loo, hasLowOut, level, gain, hasScratch, origFill, tf)
					y2[y2o] = -fsign * x2[x2o + 1]
					y2[y2o + 1] = fsign * x2[x2o]
					if resynth {
						x[xo] = mid * x[xo]
						x[xo + 1] = mid * x[xo + 1]
						y[yo] = side * y[yo]
						y[yo + 1] = side * y[yo + 1]
						let t0 = x[xo]
						x[xo] = t0 - y[yo]
						y[yo] = t0 + y[yo]
						let t1 = x[xo + 1]
						x[xo + 1] = t1 - y[yo + 1]
						y[yo + 1] = t1 + y[yo + 1]
					}
				} else {
					if b0 > 1 && !stereo && (itheta & 0x3fff) != 0 {
						if itheta > 8192 {
							delta -= delta >> (4 - lm)
						} else {
							delta = (delta + ((n << 3) >> (5 - lm))).min(0)
						}
					}
					let mbits = b.min((b - delta) / 2).max(0)
					let sbits = b - mbits
					remaining -= qalloc
					let hasNextLow2 = hasLow && !stereo
					let nextLevel = stereo ?? (0, level + 1)
					let shift = stereo ?? (0, b0 >> 1)
					let midGain = stereo ?? (float32(1.0), gain * mid)
					let rebalance = remaining
					if mbits >= sbits {
						if stereo {
							cm = band(i, x, xo, nil, 0, alone, n, mbits, blocks, low, lo, hasLow, lm, lowOut, loo, hasLowOut, nextLevel, midGain, hasScratch, fill, tf)
						} else {
							cm = band(i, x, xo, nil, 0, alone, n, mbits, blocks, low, lo, hasLow, lm, nil, 0, noFold, nextLevel, midGain, hasScratch, fill, tf)
						}
						rebalance = mbits - (rebalance - remaining)
						sbits += rebalance - 24 when rebalance > 24 && itheta != 0
						cm |= band(i, y, yo, nil, 0, alone, n, sbits, blocks, low, lo + n, hasNextLow2, lm, nil, 0, noFold, nextLevel, gain * side, noScratch, fill >> blocks, tf) << shift
					} else {
						cm = band(i, y, yo, nil, 0, alone, n, sbits, blocks, low, lo + n, hasNextLow2, lm, nil, 0, noFold, nextLevel, gain * side, noScratch, fill >> blocks, tf) << shift
						rebalance = sbits - (rebalance - remaining)
						mbits += rebalance - 24 when rebalance > 24 && itheta != 16384
						if stereo {
							cm |= band(i, x, xo, nil, 0, alone, n, mbits, blocks, low, lo, hasLow, lm, lowOut, loo, hasLowOut, nextLevel, midGain, hasScratch, fill, tf)
						} else {
							cm |= band(i, x, xo, nil, 0, alone, n, mbits, blocks, low, lo, hasLow, lm, nil, 0, noFold, nextLevel, midGain, hasScratch, fill, tf)
						}
					}
				}
			} else {
				let q = celtBitsToPulses(i, lm, b)
				let currBits = celtPulsesToBits(i, lm, q)
				remaining -= currBits
				for remaining < 0 && q > 0 {
					remaining += currBits
					q--
					currBits = celtPulsesToBits(i, lm, q)
					remaining -= currBits
				}
				if q != 0 {
					let k = celtPulses(q)
					if encode {
						cm = algQuant(x, xo, n, k, blocks)
					} else {
						cm = algUnquant(x, xo, n, k, blocks, gain)
					}
				} else if resynth {
					let cmMask = (1 << blocks) - 1
					fill &= cmMask
					if fill == 0 {
						for let j = 0; j < n; j++ {
							x[xo + j] = 0.0
						}
					} else {
						if !hasLow {
							for let j = 0; j < n; j++ {
								seed = celtLcgRand(seed)
								let s = seed >= 0x80000000 ?? (seed - 0x100000000, seed)
								x[xo + j] = float32(s >> 20)
							}
							cm = cmMask
						} else {
							for let j = 0; j < n; j++ {
								seed = celtLcgRand(seed)
								let t float32 = (seed & 0x8000) != 0 ?? (0.00390625, -0.00390625)
								x[xo + j] = low[lo + j] + t
							}
							cm = fill
						}
						renormalise(x, xo, n, gain)
					}
				}
			}

			if resynth {
				if stereo {
					stereoMerge(x, xo, y, yo, mid, n) when n != 2
					if inv {
						for let j = 0; j < n; j++ {
							y[yo + j] = -y[yo + j]
						}
					}
				} else if level == 0 {
					interleaveHadamard(x, xo, nB >> recombine, b0 << recombine, longBlocks) when b0 > 1
					nB = nB0
					blocks = b0
					for let k = 0; k < timeDivide; k++ {
						blocks >>= 1
						nB <<= 1
						cm |= cm >> blocks
						haar1(x, xo, nB, blocks)
					}
					for let k = 0; k < recombine; k++ {
						cm = celtBitDeinterleave[cm]
						haar1(x, xo, n0 >> k, 1 << k)
					}
					blocks <<= recombine
					if hasLowOut {
						let g = float32(celtSqrt(float(n0)))
						for let j = 0; j < n0; j++ {
							lowOut[loo + j] = g * x[xo + j]
						}
					}
					cm &= (1 << blocks) - 1
				}
			}
			return cm
		}

		// The number of steps the split angle is coded with.
		def computeQn(n int, b int, offset int, pulseCap int, stereo bool) int {
			let n2 = 2 * n - 1
			n2-- when stereo && n == 2
			let qb = (b - pulseCap - 32).min((b + n2 * offset) / n2)
			qb = qb.min(64)
			return 1 when qb < 4
			let qn = celtExp2Table8[qb & 7] >> (14 - (qb >> 3))
			return ((qn + 1) >> 1) << 1
		}

		// One Haar step on pairs `stride` apart of the n0 values at x[at].
		def haar1(x float32[], at int, n0 int, stride int) {
			let n = n0 >> 1
			let k float32 = 0.70710678
			for let i = 0; i < stride; i++ {
				for let j = 0; j < n; j++ {
					let a = at + stride * 2 * j + i
					let b = at + stride * (2 * j + 1) + i
					let t1 = k * x[a]
					let t2 = k * x[b]
					x[a] = t1 + t2
					x[b] = t1 - t2
				}
			}
		}

		// Reorders n0 * stride interleaved values into `stride` runs (in Gray
		// order when `hadamard`).
		def deinterleaveHadamard(x float32[], at int, n0 int, stride int, hadamard bool) {
			let n = n0 * stride
			if hadamard {
				let ord = stride - 2
				for let i = 0; i < stride; i++ {
					let dst = celtOrderyTable[ord + i] * n0
					for let j = 0; j < n0; j++ {
						tmp[dst + j] = x[at + j * stride + i]
					}
				}
			} else {
				for let i = 0; i < stride; i++ {
					for let j = 0; j < n0; j++ {
						tmp[i * n0 + j] = x[at + j * stride + i]
					}
				}
			}
			for let j = 0; j < n; j++ {
				x[at + j] = tmp[j]
			}
		}

		// Undoes `deinterleaveHadamard`.
		def interleaveHadamard(x float32[], at int, n0 int, stride int, hadamard bool) {
			let n = n0 * stride
			if hadamard {
				let ord = stride - 2
				for let i = 0; i < stride; i++ {
					let src = celtOrderyTable[ord + i] * n0
					for let j = 0; j < n0; j++ {
						tmp[j * stride + i] = x[at + src + j]
					}
				}
			} else {
				for let i = 0; i < stride; i++ {
					for let j = 0; j < n0; j++ {
						tmp[j * stride + i] = x[at + i * n0 + j]
					}
				}
			}
			for let j = 0; j < n; j++ {
				x[at + j] = tmp[j]
			}
		}

		// Replaces x with the energy-weighted sum of both channels of band `i`.
		def intensityStereo(x float32[], xo int, y float32[], yo int, i int, n int) {
			let left = bandE[i]
			let right = bandE[i + 21]
			let length float32 = float32(1e-15) + float32(celtSqrt(float(float32(1e-15) + left * left + right * right)))
			let a1 = left / length
			let a2 = right / length
			for let j = 0; j < n; j++ {
				x[xo + j] = a1 * x[xo + j] + a2 * y[yo + j]
			}
		}

		// Turns left/right into mid/side, both scaled by 1/sqrt(2).
		def stereoSplit(x float32[], xo int, y float32[], yo int, n int) {
			let k float32 = 0.70710678
			for let j = 0; j < n; j++ {
				let l = k * x[xo + j]
				let r = k * y[yo + j]
				x[xo + j] = l + r
				y[yo + j] = r - l
			}
		}

		// Turns the coded mid (scaled by `mid`) and side back into left/right
		// of unit norm.
		def stereoMerge(x float32[], xo int, y float32[], yo int, mid float32, n int) {
			let xp float32 = 0.0
			let side float32 = 0.0
			for let j = 0; j < n; j++ {
				xp += x[xo + j] * y[yo + j]
				side += y[yo + j] * y[yo + j]
			}
			xp = mid * xp
			let el = mid * mid + side - 2.0 * xp
			let er = mid * mid + side + 2.0 * xp
			if er < 0.0006 || el < 0.0006 {
				for let j = 0; j < n; j++ {
					y[yo + j] = x[xo + j]
				}
				return
			}
			let lgain = float32(1.0) / float32(celtSqrt(float(el)))
			let rgain = float32(1.0) / float32(celtSqrt(float(er)))
			for let j = 0; j < n; j++ {
				let l = mid * x[xo + j]
				let r = y[yo + j]
				x[xo + j] = lgain * (l - r)
				y[yo + j] = rgain * (l + r)
			}
		}

		// Scales the n values at x[at] to a norm of `gain`.
		def renormalise(x float32[], at int, n int, gain float32) {
			let e float32 = 1e-15
			for let j = 0; j < n; j++ {
				e += x[at + j] * x[at + j]
			}
			let g = (float32(1.0) / float32(celtSqrt(float(e)))) * gain
			for let j = 0; j < n; j++ {
				x[at + j] = g * x[at + j]
			}
		}

		// The split angle of the two halves (or the two channels when `stereo`)
		// in Q14 of a quarter turn.
		def stereoItheta(x float32[], xo int, y float32[], yo int, stereo bool, n int) int {
			let emid float32 = 1e-15
			let eside float32 = 1e-15
			for let j = 0; j < n; j++ {
				let m = stereo ?? (0.5 * x[xo + j] + 0.5 * y[yo + j], x[xo + j])
				let s = stereo ?? (0.5 * x[xo + j] - 0.5 * y[yo + j], y[yo + j])
				emid += m * m
				eside += s * s
			}
			let mid = float32(celtSqrt(float(emid)))
			let side = float32(celtSqrt(float(eside)))
			return int((0.5 + 16384.0 * 0.63662 * celtAtan2(float(side), float(mid))).floor())
		}

		// One pass of Givens rotations of pairs `stride` apart, forwards then
		// backwards.
		def expRotation1(x float32[], at int, len int, stride int, c float32, s float32) {
			let p = at
			for let i = 0; i < len - stride; i++ {
				let x1 = x[p]
				let x2 = x[p + stride]
				x[p + stride] = c * x2 + s * x1
				x[p] = c * x1 - s * x2
				p++
			}
			p = at + len - 2 * stride - 1
			for let i = len - 2 * stride - 1; i >= 0; i-- {
				let x1 = x[p]
				let x2 = x[p + stride]
				x[p + stride] = c * x2 + s * x1
				x[p] = c * x1 - s * x2
				p--
			}
		}

		// Spreads (dir 1) or unspreads (dir -1) the k pulses of a band by
		// rotations whose angle falls as the pulses grow (RFC 6716 section
		// 4.3.4.3).
		def expRotation(x float32[], at int, lenIn int, dir int, stride int, k int) {
			return when 2 * k >= lenIn || spread == celtSpreadNone
			let factor = spread == celtSpreadLight ?? (15, spread == celtSpreadNormal ?? (10, 5))
			let gain = float32(lenIn) / float32(lenIn + factor * k)
			let theta = 0.5 * (gain * gain)
			let c = celtCosNorm(theta)
			let s = celtCosNorm(1.0 - theta)
			let stride2 = 0
			if lenIn >= 8 * stride {
				stride2 = 1
				for (stride2 * stride2 + stride2) * stride + (stride >> 2) < lenIn {
					stride2++
				}
			}
			let len = lenIn / stride
			for let i = 0; i < stride; i++ {
				if dir < 0 {
					expRotation1(x, at + i * len, len, stride2, s, c) when stride2 != 0
					expRotation1(x, at + i * len, len, 1, c, s)
				} else {
					expRotation1(x, at + i * len, len, 1, c, -s)
					expRotation1(x, at + i * len, len, stride2, s, -c) when stride2 != 0
				}
			}
		}

		// The bit set of the `blocks` short blocks that received a pulse.
		def collapseMask(n int, blocks int) int {
			return 1 when blocks <= 1
			let n0 = n / blocks
			let mask = 0
			for let i = 0; i < blocks; i++ {
				for let j = 0; j < n0; j++ {
					if iy[i * n0 + j] != 0 {
						mask |= 1 << i
						break
					}
				}
			}
			return mask
		}

		// Decodes a band's pulses, normalises them to `gain` and undoes the
		// spreading; returns the collapse mask.
		def algUnquant(x float32[], at int, n int, k int, blocks int, gain float32) int {
			decodePulses(n, k)
			let ryy float32 = 0.0
			for let j = 0; j < n; j++ {
				ryy += float32(iy[j] * iy[j])
			}
			let g = (float32(1.0) / float32(celtSqrt(float(ryy)))) * gain
			for let j = 0; j < n; j++ {
				x[at + j] = g * float32(iy[j])
			}
			expRotation(x, at, n, -1, blocks, k)
			return collapseMask(n, blocks)
		}

		// Finds the pulse vector of k pulses closest in direction to the n
		// values at x[at] and codes it; returns the collapse mask.
		def algQuant(x float32[], at int, n int, k int, blocks int) int {
			expRotation(x, at, n, 1, blocks, k)
			let sum float32 = 0.0
			for let j = 0; j < n; j++ {
				if x[at + j] > 0.0 {
					signx[j] = 1.0
				} else {
					signx[j] = -1.0
					x[at + j] = -x[at + j]
				}
				iy[j] = 0
				yq[j] = 0.0
			}
			let xy float32 = 0.0
			let yy float32 = 0.0
			let pulsesLeft = k
			if k > (n >> 1) {
				for let j = 0; j < n; j++ {
					sum += x[at + j]
				}
				if !(sum > 1e-15 && sum < 64.0) {
					x[at] = 1.0
					for let j = 1; j < n; j++ {
						x[at + j] = 0.0
					}
					sum = 1.0
				}
				let rcp = float32(k - 1) * (float32(1.0) / sum)
				for let j = 0; j < n; j++ {
					iy[j] = int((rcp * x[at + j]).floor())
					yq[j] = float32(iy[j])
					yy += yq[j] * yq[j]
					xy += x[at + j] * yq[j]
					yq[j] *= 2.0
					pulsesLeft -= iy[j]
				}
			}
			if pulsesLeft > n + 3 {
				let t = float32(pulsesLeft)
				yy += t * t
				yy += t * yq[0]
				iy[0] += pulsesLeft
				pulsesLeft = 0
			}
			for let p = 0; p < pulsesLeft; p++ {
				let bestId = 0
				let bestNum float32 = -1e15
				let bestDen float32 = 0.0
				yy += 1.0
				for let j = 0; j < n; j++ {
					let rxy = xy + x[at + j]
					let ryy = yy + yq[j]
					let r2 = rxy * rxy
					if bestDen * r2 > ryy * bestNum {
						bestDen = ryy
						bestNum = r2
						bestId = j
					}
				}
				xy += x[at + bestId]
				yy += yq[bestId]
				yq[bestId] += 2.0
				iy[bestId]++
			}
			for let j = 0; j < n; j++ {
				x[at + j] = signx[j] * x[at + j]
				iy[j] = -iy[j] when signx[j] < 0.0
			}
			encodePulses(n)
			return collapseMask(n, blocks)
		}

		// Decodes the pulse vector of n dimensions and k pulses into iy
		// (RFC 6716 section 4.3.4.2).
		def decodePulses(n int, kIn int) {
			let total = celtPvqU[n * celtPvqK + kIn] + celtPvqU[n * celtPvqK + kIn + 1]
			let idx = dec.uint(total)
			let k = kIn
			for let j = 0; j < n; j++ {
				let row = (n - j) * celtPvqK
				let p = celtPvqU[row + k + 1]
				let neg = idx >= p
				idx -= p when neg
				let yj = k
				p = celtPvqU[row + k]
				for p > idx {
					k--
					p = celtPvqU[row + k]
				}
				idx -= p
				yj -= k
				iy[j] = neg ?? (-yj, yj)
			}
		}

		// Encodes the pulse vector of n dimensions in iy.
		def encodePulses(n int) {
			let idx = iy[n - 1] < 0 ?? (1, 0)
			let k = iy[n - 1].abs()
			for let j = n - 2; j >= 0; j-- {
				let row = (n - j) * celtPvqK
				idx += celtPvqU[row + k]
				k += iy[j].abs()
				idx += celtPvqU[row + k + 1] when iy[j] < 0
			}
			enc.uint(idx, celtPvqU[n * celtPvqK + k] + celtPvqU[n * celtPvqK + k + 1])
		}
	}

	// Pulses the PVQ table covers per dimension count: MAX_PULSES + 2.
	const celtPvqK = 131

	// U(n, k) of the PVQ codebook for n up to 176 dimensions and k up to 130,
	// row by row: the number of vectors of k pulses in n dimensions is
	// U(n, k) + U(n, k + 1). Values past 2^40 are clamped; the band
	// coding never uses them.
	let celtPvqU = celtBuildPvqU()

	// Fills the U(n, k) table: U(n, 0) = 0, U(n, 1) = U(1, k) = 1, and
	// U(n, k) = U(n - 1, k) + U(n, k - 1) + U(n - 1, k - 1).
	def celtBuildPvqU() int[] {
		let rows = 177
		let t int[]
		t.len(rows * celtPvqK)
		for let n = 1; n < rows; n++ {
			for let k = 1; k < celtPvqK; k++ {
				if n == 1 || k == 1 {
					t[n * celtPvqK + k] = 1
				} else {
					let v = t[(n - 1) * celtPvqK + k] + t[n * celtPvqK + k - 1] + t[(n - 1) * celtPvqK + k - 1]
					t[n * celtPvqK + k] = v.min(1 << 40)
				}
			}
		}
		return t
	}

	// atan2(y, x) for y, x >= 0, in radians.
	def celtAtan2(y float, x float) float {
		return 0.0 when y <= 0.0 && x <= 0.0
		return 1.5707963267948966 - celtAtan(x / y) when y > x
		return celtAtan(y / x)
	}

	// atan(z) for z in 0..1, to double precision.
	def celtAtan(z float) float {
		// Halve the angle twice so the series converges fast.
		let t = z / (1.0 + celtSqrt(1.0 + z * z))
		t = t / (1.0 + celtSqrt(1.0 + t * t))
		let t2 = t * t
		let term = t
		let sum = t
		for let i = 1; i < 12; i++ {
			term *= -t2
			sum += term / float(2 * i + 1)
		}
		return 4.0 * sum
	}
}
