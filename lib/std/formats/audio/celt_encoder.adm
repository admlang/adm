internal partial module std.formats.audio.celt {
	use std.formats.audio.opus::*

	// Encodes 48 kHz float samples into CELT frames of a fixed size and byte
	// count (RFC 6716 section 5.3): transient detection with short blocks,
	// coarse and fine energy, dynamic allocation and PVQ band shapes.
	type CeltEncoder {
		// Channels coded: 1 or 2.
		channels        int
		mdct            CeltMdct
		bands           CeltBands
		alloc           CeltAllocation
		preemph         float32[]
		// Pre-emphasised input of each channel: the last 120 samples of the
		// previous frame, then the frame, 960 + 120 apart.
		input           float32[]
		freq            float32[]
		x               float32[]
		bandE           float32[]
		bandLogE        float32[]
		oldBandE        float32[]
		errorE          float32[]
		tfRes           int[]
		cap             int[]
		offsets         int[]
		collapse        int[]
		hp              float32[]
		bins            float32[]
		rng             int
		first           bool
		lastCoded       int
		consecTrans     int
		pitch           CeltPitch
		// Unfiltered history (1024 samples per channel) and the frame being
		// pre-filtered.
		prefilterMem    float32[]
		pre             float32[]
		prefilterPeriod int
		prefilterGain   float32
		prefilterTapset int

		// An encoder for `channels` channels.
		def new(channels int) {
			self.channels = channels
			mdct = new CeltMdct()
			bands = new CeltBands()
			alloc = new CeltAllocation()
			preemph.len(2)
			input.len(2 * (960 + 120))
			freq.len(2 * 960)
			x.len(2 * 960)
			bandE.len(42)
			bandLogE.len(42)
			oldBandE.len(42)
			errorE.len(42)
			tfRes.len(21)
			cap.len(21)
			offsets.len(21)
			collapse.len(42)
			hp.len(960 + 120)
			bins.len(20)
			first = true
			lastCoded = 0
			pitch = new CeltPitch(mdct.window)
			prefilterMem.len(2 * 1024)
			pre.len(2 * (1024 + 960))
		}

		// Encodes one frame of `n` samples per channel (120, 240, 480 or 960)
		// of interleaved `pcm` in -1..1 into a CELT frame of exactly `bytes`
		// bytes (2 to 1275).
		def encode(pcm float32[], n int, bytes int) byte[] {
			let lm = 0
			for (120 << lm) != n {
				lm++
			}
			let m = 1 << lm
			let c = channels
			let stride = n + 120
			let silence = true
			for let ch = 0; ch < c; ch++ {
				let base = ch * stride
				for let i = 0; i < 120; i++ {
					input[base + i] = input[base + n + i]
				}
				let pb = ch * (1024 + 960)
				for let i = 0; i < 1024; i++ {
					pre[pb + i] = prefilterMem[ch * 1024 + i]
				}
				let mem = preemph[ch]
				for let i = 0; i < n; i++ {
					let v = pcm[i * c + ch] * 32768.0
					// NaN is the one value unequal to itself.
					v = 0.0 unless v == v
					v = v.max(float32(-65536.0)).min(float32(65536.0))
					let y = v + mem
					mem = -celtPreemph * v
					pre[pb + 1024 + i] = y
					silence = silence && y == 0.0
				}
				preemph[ch] = mem
			}

			let enc = new OpusRangeEncoder(bytes)
			let totalBits = bytes * 8
			enc.bitLogp(silence, 15)
			enc.markWritten(totalBits) when silence

			// The pitch pre-filter: a comb filter at the period of the signal
			// that the decoder's post-filter undoes.
			let pitchIndex = 15
			let gain1 float32 = 0.0
			let tapset = 0
			if bytes > 12 * c && !silence {
				pitch.downsample(pre, 0, 1024 + 960, 1024 + n, c)
				let (period, gain) = pitch.removeDoubling(1024, 15, n, 1024 - pitch.search(512, 0, n, 1024 - 15), prefilterPeriod, prefilterGain)
				pitchIndex = period.min(1022)
				gain1 = 0.7 * gain
			}
			let threshold float32 = 0.2
			threshold += 0.2 when (pitchIndex - prefilterPeriod).abs() * 10 > pitchIndex
			threshold += 0.1 when bytes < 25
			threshold += 0.1 when bytes < 35
			threshold -= 0.1 when prefilterGain > 0.4
			threshold -= 0.1 when prefilterGain > 0.55
			threshold = threshold.max(float32(0.2))
			if gain1 < threshold {
				enc.bitLogp(false, 1) when enc.tell() + 16 <= totalBits
				gain1 = 0.0
			} else {
				gain1 = prefilterGain when (gain1 - prefilterGain).abs() < 0.1
				let qg = (int((0.5 + gain1 * float32(32.0) / float32(3.0)).floor()) - 1).max(0).min(7)
				enc.bitLogp(true, 1)
				let octave = opusIlog(pitchIndex + 1) - 5
				enc.uint(octave, 6)
				enc.bits(pitchIndex + 1 - (16 << octave), 4 + octave)
				enc.bits(qg, 3)
				if enc.tell() + 2 <= totalBits {
					enc.icdf(tapset, celtTapsetIcdf, 2)
				} else {
					tapset = 0
				}
				gain1 = 0.09375 * float32(qg + 1)
			}
			prefilterPeriod = prefilterPeriod.max(15)
			for let ch = 0; ch < c; ch++ {
				let pb = ch * (1024 + 960)
				celtCombFilter(mdct.window, input, ch * stride + 120, pre, pb + 1024, prefilterPeriod, pitchIndex, n, -prefilterGain, -gain1, prefilterTapset, tapset, true)
				let pm = ch * 1024
				for let i = 0; i < 1024 - n; i++ {
					prefilterMem[pm + i] = prefilterMem[pm + n + i]
				}
				for let i = 0; i < n; i++ {
					prefilterMem[pm + 1024 - n + i] = pre[pb + 1024 + i]
				}
			}
			prefilterPeriod = pitchIndex
			prefilterGain = gain1
			prefilterTapset = tapset

			let transient = false
			if lm > 0 && enc.tell() + 3 <= totalBits {
				transient = !silence && detectTransient(n)
				enc.bitLogp(transient, 3)
			}
			consecTrans = transient ?? (consecTrans + 1, 0)

			// Transform, band energies and normalised shapes.
			for let ch = 0; ch < c; ch++ {
				let base = ch * stride
				if transient {
					for let b = 0; b < m; b++ {
						mdct.forward(input, base + b * 120, freq, b + ch * n, m, 3)
					}
				} else {
					mdct.forward(input, base, freq, ch * n, 1, 3 - lm)
				}
			}
			for let ch = 0; ch < c; ch++ {
				for let i = 0; i < 21; i++ {
					let sum float32 = 1e-27
					for let j = m * celtEBands[i]; j < m * celtEBands[i + 1]; j++ {
						let v = freq[ch * n + j]
						sum += v * v
					}
					let e = float32(celtSqrt(float(sum)))
					bandE[ch * 21 + i] = e
					bandLogE[ch * 21 + i] = float32(celtLog2(float(e))) - celtEMeans[i]
					let g = float32(1.0) / (float32(1e-27) + e)
					for let j = m * celtEBands[i]; j < m * celtEBands[i + 1]; j++ {
						x[ch * n + j] = freq[ch * n + j] * g
					}
				}
			}

			let intra = first && enc.tell() + 3 <= totalBits
			first = false
			let maxDecay = float32(16.0).min(float32(0.125) * float32(bytes))
			encodeCoarseEnergy(enc, intra, c, lm, totalBits, maxDecay)
			encodeTf(enc, transient, lm)
			enc.icdf(celtSpreadNormal, celtSpreadIcdf, 5) when enc.tell() + 4 <= totalBits
			for let i = 0; i < 21; i++ {
				let w = (celtEBands[i + 1] - celtEBands[i]) << lm
				cap[i] = ((celtCacheCaps[21 * (2 * lm + c - 1) + i] + 64) * c * w) >> 2
				offsets[i] = 0
			}
			if bytes > 50 && lm >= 1 {
				let t1 float32 = lm <= 1 ?? (3.0, 2.0)
				let t2 float32 = lm <= 1 ?? (5.0, 4.0)
				for let i = 1; i < 20; i++ {
					let d2 = 2.0 * bandLogE[i] - bandLogE[i - 1] - bandLogE[i + 1]
					d2 = 0.5 * (d2 + 2.0 * bandLogE[21 + i] - bandLogE[20 + i] - bandLogE[22 + i]) when c == 2
					offsets[i] += 1 when d2 > t1
					offsets[i] += 1 when d2 > t2
				}
			}
			let dynallocLogp = 6
			let total = totalBits << 3
			let totalBoost = 0
			let tell = enc.tellFrac()
			for let i = 0; i < 21; i++ {
				let width = (c * (celtEBands[i + 1] - celtEBands[i])) << lm
				let quanta = (width << 3).min((6 << 3).max(width))
				let loopLogp = dynallocLogp
				let boost = 0
				let j = 0
				for tell + (loopLogp << 3) < total - totalBoost && boost < cap[i] {
					let flag = j < offsets[i]
					enc.bitLogp(flag, loopLogp)
					tell = enc.tellFrac()
					break unless flag
					boost += quanta
					totalBoost += quanta
					loopLogp = 1
					j++
				}
				dynallocLogp = (dynallocLogp - 1).max(2) when j > 0
				offsets[i] = boost
			}
			let allocTrim = 5
			if tell + (6 << 3) <= total - totalBoost {
				allocTrim = trimAnalysis(c, lm, n)
				enc.icdf(allocTrim, celtTrimIcdf, 7)
			}
			let intensity = 0
			if c == 2 {
				let rate = 2 * (((8 * bytes - 80) >> lm)) / 5
				if rate < 35 {
					intensity = 8
				} else if rate < 50 {
					intensity = 12
				} else if rate < 68 {
					intensity = 16
				} else if rate < 84 {
					intensity = 18
				} else if rate < 102 {
					intensity = 19
				} else if rate < 130 {
					intensity = 20
				} else {
					intensity = 21
				}
			}
			let bits = ((bytes * 8) << 3) - enc.tellFrac() - 1
			let antiCollapseRsv = transient && lm >= 2 && bits >= ((lm + 2) << 3) ?? (8, 0)
			bits -= antiCollapseRsv
			alloc.intensity = intensity
			alloc.dualStereo = c == 2 && lm != 0 && preferDualStereo(lm, n)
			alloc.compute(0, 21, offsets, cap, allocTrim, bits, c, lm, true, bands.dec, enc, lastCoded)
			lastCoded = alloc.codedBands
			encodeFineEnergy(enc, c)

			bands.encode = true
			bands.enc = enc
			bands.seed = rng
			bands.spread = celtSpreadNormal
			bands.intensity = alloc.intensity
			for let i = 0; i < 42; i++ {
				bands.bandE[i] = bandE[i]
			}
			bands.quantAll(0, 21, x, c == 2, n, collapse, alloc.pulses, transient, alloc.dualStereo, tfRes, bytes * 64 - antiCollapseRsv, alloc.balance, lm, alloc.codedBands)
			enc.bits(consecTrans < 2 ?? (1, 0), 1) when antiCollapseRsv > 0
			encodeFinalEnergy(enc, bytes * 8 - enc.tell(), c)
			if silence {
				for let i = 0; i < 42; i++ {
					oldBandE[i] = -28.0
				}
			}
			if c == 1 {
				for let i = 0; i < 21; i++ {
					oldBandE[21 + i] = oldBandE[i]
				}
			}
			enc.done()
			rng = enc.range()
			return enc.bytes()
		}

		// Whether the frame holds a sharp attack that long blocks would
		// smear: the high-passed signal jumps well above its level in the
		// blocks around it.
		def detectTransient(n int) bool {
			let len = n + 120
			let c = channels
			let mem0 float32 = 0.0
			let mem1 float32 = 0.0
			for let i = 0; i < len; i++ {
				let v = c == 1 ?? (input[i], 0.5 * (input[i] + input[len + i]))
				let y = mem0 + v
				mem0 = mem1 + y - 2.0 * v
				mem1 = v - 0.5 * y
				hp[i] = 0.25 * y
			}
			for let i = 0; i < 12; i++ {
				hp[i] = 0.0
			}
			let block = 60
			let nb = len / block
			for let i = 0; i < nb; i++ {
				let mx float32 = 0.0
				for let j = 0; j < block; j++ {
					mx = mx.max(hp[i * block + j].abs())
				}
				bins[i] = mx
			}
			for let i = 0; i < nb; i++ {
				let t1 = 0.15 * bins[i]
				let t2 = 0.4 * bins[i]
				let conseq = 0
				for let j = 0; j < i; j++ {
					conseq++ when bins[j] < t1
					if bins[j] < t2 {
						conseq++
					} else {
						conseq = 0
					}
				}
				return true when conseq >= 3
				conseq = 0
				for let j = i + 1; j < nb; j++ {
					if bins[j] < t1 {
						conseq++
					} else {
						conseq = 0
					}
				}
				return true when conseq >= 7
			}
			return false
		}

		// The allocation trim for the frame: lower (more bits to the low
		// bands) when the channels are strongly correlated or the spectrum
		// falls steeply, higher when it rises.
		def trimAnalysis(c int, lm int, n int) int {
			let trim = 5
			if c == 2 {
				let sum float32 = 0.0
				for let i = 0; i < 8; i++ {
					let part float32 = 0.0
					for let j = celtEBands[i] << lm; j < celtEBands[i + 1] << lm; j++ {
						part += x[j] * x[n + j]
					}
					sum += part
				}
				sum = sum * 0.125
				if sum > 0.995 {
					trim -= 4
				} else if sum > 0.92 {
					trim -= 3
				} else if sum > 0.85 {
					trim -= 2
				} else if sum > 0.8 {
					trim -= 1
				}
			}
			let diff float32 = 0.0
			for let ch = 0; ch < c; ch++ {
				for let i = 0; i < 20; i++ {
					diff += bandLogE[ch * 21 + i] * float32(2 + 2 * i - 21)
				}
			}
			diff = diff / float32(2 * c * 20)
			trim -= 1 when diff > 2.0
			trim -= 1 when diff > 8.0
			trim += 1 when diff < -4.0
			trim += 1 when diff < -10.0
			return trim.max(0).min(10)
		}

		// Whether coding left and right apart costs fewer bits than mid and
		// side, judged by the L1 norms of the low bands.
		def preferDualStereo(lm int, n int) bool {
			let sumLR float32 = 1e-15
			let sumMS float32 = 1e-15
			for let j = 0; j < celtEBands[13] << lm; j++ {
				let l = x[j]
				let r = x[n + j]
				sumLR += l.abs() + r.abs()
				sumMS += (l + r).abs() + (l - r).abs()
			}
			sumMS = 0.707107 * sumMS
			let thetas = lm <= 1 ?? (5, 13)
			return float32((celtEBands[13] << (lm + 1)) + thetas) * sumMS > float32(celtEBands[13] << (lm + 1)) * sumLR
		}

		// Codes the coarse band energies (inter-frame predicted unless `intra`),
		// limiting the deltas when few bits remain, and keeps the residual for
		// the fine energy.
		def encodeCoarseEnergy(enc OpusRangeEncoder, intra bool, c int, lm int, budget int, maxDecay float32) {
			enc.bitLogp(intra, 3) when enc.tell() + 3 <= budget
			let model = (lm * 2 + (intra ?? (1, 0))) * 42
			let coef = intra ?? (float32(0.0), celtPredCoef[lm])
			let beta = intra ?? (celtBetaIntra, celtBetaCoef[lm])
			let prev0 float32 = 0.0
			let prev1 float32 = 0.0
			for let i = 0; i < 21; i++ {
				for let ch = 0; ch < c; ch++ {
					let at = ch * 21 + i
					let xv = bandLogE[at]
					let oldE = oldBandE[at].max(float32(-9.0))
					let prev = ch == 0 ?? (prev0, prev1)
					let f = xv - coef * oldE - prev
					let qi = int((0.5 + f).floor())
					let decayBound = oldBandE[at].max(float32(-28.0)) - maxDecay
					if qi < 0 && xv < decayBound {
						qi += int(decayBound - xv)
						qi = 0 when qi > 0
					}
					let tell = enc.tell()
					let bitsLeft = budget - tell - 3 * c * (21 - i)
					if i != 0 && bitsLeft < 30 {
						qi = qi.min(1) when bitsLeft < 24
						qi = qi.max(-1) when bitsLeft < 16
					}
					if budget - tell >= 15 {
						let pi = 2 * i.min(20)
						qi = enc.laplace(qi, celtEProbModel[model + pi] << 7, celtEProbModel[model + pi + 1] << 6)
					} else if budget - tell >= 2 {
						qi = qi.min(1).max(-1)
						enc.icdf((2 * qi) ^ -(qi < 0 ?? (1, 0)), celtSmallEnergyIcdf, 2)
					} else if budget - tell >= 1 {
						qi = qi.min(0)
						enc.bitLogp(qi != 0, 1)
					} else {
						qi = -1
					}
					let q = float32(qi)
					errorE[at] = f - q
					oldBandE[at] = coef * oldE + prev + q
					if ch == 0 {
						prev0 = prev0 + q - beta * q
					} else {
						prev1 = prev1 + q - beta * q
					}
				}
			}
		}

		// Codes the time-frequency resolution flags, all unchanged.
		def encodeTf(enc OpusRangeEncoder, transient bool, lm int) {
			let budget = enc.size() * 8
			let tell = enc.tell()
			let logp = transient ?? (2, 4)
			let rsv = lm > 0 && tell + logp + 1 <= budget
			budget -= rsv ?? (1, 0)
			let curr = 0
			let changed = 0
			for let i = 0; i < 21; i++ {
				if tell + logp <= budget {
					enc.bitLogp(curr != 0, logp)
					tell = enc.tell()
				}
				tfRes[i] = curr
				logp = transient ?? (4, 5)
			}
			let base = lm * 8 + (transient ?? (4, 0))
			enc.bitLogp(false, 1) when rsv && celtTfSelectTable[base + changed] != celtTfSelectTable[base + 2 + changed]
			for let i = 0; i < 21; i++ {
				tfRes[i] = celtTfSelectTable[base + tfRes[i]]
			}
		}

		// Codes the fine energy bits the allocation gave each band.
		def encodeFineEnergy(enc OpusRangeEncoder, c int) {
			for let i = 0; i < 21; i++ {
				let fq = alloc.fineQuant[i]
				continue when fq <= 0
				let frac = 1 << fq
				for let ch = 0; ch < c; ch++ {
					let at = ch * 21 + i
					let q2 = int(((errorE[at] + 0.5) * float32(frac)).floor())
					q2 = q2.min(frac - 1).max(0)
					enc.bits(q2, fq)
					let offset = (float32(q2) + 0.5) * float32(1 << (14 - fq)) * float32(0.00006103515625) - 0.5
					oldBandE[at] += offset
					errorE[at] -= offset
				}
			}
		}

		// Codes one more fine energy bit per band from the bits left, by
		// priority.
		def encodeFinalEnergy(enc OpusRangeEncoder, bitsLeftIn int, c int) {
			let bitsLeft = bitsLeftIn
			for let prio = 0; prio < 2; prio++ {
				for let i = 0; i < 21 && bitsLeft >= c; i++ {
					continue when alloc.fineQuant[i] >= 8 || alloc.finePriority[i] != prio
					for let ch = 0; ch < c; ch++ {
						let at = ch * 21 + i
						let q2 = errorE[at] < 0.0 ?? (0, 1)
						enc.bits(q2, 1)
						let offset = (float32(q2) - 0.5) * float32(1 << (14 - alloc.fineQuant[i] - 1)) * float32(0.00006103515625)
						oldBandE[at] += offset
						bitsLeft--
					}
				}
			}
		}
	}
}
