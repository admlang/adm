internal partial module std.formats.audio.celt {
	use std.math

	// The square root of x to double precision, 0 for x of zero or less.
	def celtSqrt(x float) float {
		return 0.0 when x <= 0.0
		let m = x
		let scale = 1.0
		for m > 4294967296.0 {
			m *= 0.0000000002328306436538696289
			scale *= 65536.0
		}
		for m < 0.0000000002328306436538696289 {
			m *= 4294967296.0
			scale *= 0.0000152587890625
		}
		for m > 16.0 {
			m *= 0.0625
			scale *= 4.0
		}
		for m < 1.0 {
			m *= 16.0
			scale *= 0.25
		}
		let g = 1.0 + (m - 1.0) * 0.2
		for let i = 0; i < 5; i++ {
			g = 0.5 * (g + m / g)
		}
		return g * scale
	}

	// 2^x to double precision, 0 below 2^-60.
	def celtExp2(x float) float {
		return 0.0 when x < -60.0
		let k = x.floor()
		let t = (x - k) * math.Ln2
		// e^t for t in 0..ln 2, by its series.
		let sum = 1.0
		let term = 1.0
		for let i = 1; i <= 12; i++ {
			term *= t / float(i)
			sum += term
		}
		let e = int(k)
		for e >= 16 {
			sum *= 65536.0
			e -= 16
		}
		for e > 0 {
			sum *= 2.0
			e--
		}
		for e <= -16 {
			sum *= 0.0000152587890625
			e += 16
		}
		for e < 0 {
			sum *= 0.5
			e++
		}
		return sum
	}

	// log2 of x, a large negative number for x of zero or less.
	def celtLog2(x float) float {
		return -1000.0 when x <= 0.0
		return math.ln(x) * 1.442695040888963387
	}

	// cos(πx/2) as the float CELT reference computes it.
	def celtCosNorm(x float32) float32 {
		let a float32 = float32(0.5) * float32(3.141592653) * x
		return float32(math.cos(float(a)))
	}

	// The integer square root of v, rounded down.
	def celtIsqrt(v int) int {
		return 0 when v <= 0
		let r = 0
		let bit = 1 << 30
		for bit > v {
			bit >>= 2
		}
		let rem = v
		for bit != 0 {
			if rem >= r + bit {
				rem -= r + bit
				r = (r >> 1) + bit
			} else {
				r >>= 1
			}
			bit >>= 2
		}
		return r
	}
}
