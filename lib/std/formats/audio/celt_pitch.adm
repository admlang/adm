internal partial module std.formats.audio.celt {
	// Offsets of the second correlation remove_doubling checks for each
	// divisor k of the period.
	const celtSecondCheck = int[0, 0, 3, 2, 3, 2, 5, 2, 3, 2, 3, 2, 5, 2, 3, 2]

	// Pitch analysis of CELT history at half rate: the decoder's concealment
	// and the encoder's pre-filter both find the period of the signal with
	// it, and the concealment models the signal's spectrum with `lpc`.
	type CeltPitch {
		// The half-rate, whitened signal the search runs on.
		buf    float32[]
		// Autocorrelation of the last `lpc` or `downsample` input.
		ac     float32[]
		window float32[]
		xx     float32[]
		lpc4   float32[]
		x4     float32[]
		y4     float32[]
		xcorr  float32[]
		best0  int
		best1  int

		// An analyser that windows autocorrelations with `window` (the 120
		// sample MDCT window).
		def new(window float32[]) {
			self.window = window
			buf.len(1024)
			ac.len(25)
			xx.len(2048)
			lpc4.len(4)
			x4.len(512)
			y4.len(512)
			xcorr.len(1024)
		}

		// The autocorrelation of `n` samples of `x` at lags 0..`lag` into
		// `ac`, windowed at both ends when `windowed`.
		def autocorr(x float32[], n int, lag int, windowed bool) {
			for let i = 0; i < n; i++ {
				xx[i] = x[i]
			}
			if windowed {
				for let i = 0; i < 120; i++ {
					xx[i] = x[i] * window[i]
					xx[n - i - 1] = x[n - i - 1] * window[i]
				}
			}
			for let l = lag; l >= 0; l-- {
				let d float32 = 0.0
				for let i = l; i < n; i++ {
					d += xx[i] * xx[i - l]
				}
				ac[l] = d
			}
			ac[0] += 10.0
		}

		// Linear prediction coefficients of order `p` from `ac` into
		// out[at..], by the Levinson-Durbin recursion.
		def levinson(out float32[], at int, p int) {
			let err = ac[0]
			for let i = 0; i < p; i++ {
				out[at + i] = 0.0
			}
			return when ac[0] == 0.0
			for let i = 0; i < p; i++ {
				let rr float32 = 0.0
				for let j = 0; j < i; j++ {
					rr += out[at + j] * ac[i - j]
				}
				rr += ac[i + 1]
				let r = -(rr / err)
				out[at + i] = r
				for let j = 0; j < (i + 1) >> 1; j++ {
					let t1 = out[at + j]
					let t2 = out[at + i - 1 - j]
					out[at + j] = t1 + r * t2
					out[at + i - 1 - j] = t2 + r * t1
				}
				err = err - r * r * err
				break when err < 0.001 * ac[0]
			}
		}

		// The order `p` LPC model of `n` samples of `x` (windowed at both ends
		// when `windowed`), with a -40 dB noise floor and lag windowing, into
		// out[at..].
		def lpc(x float32[], n int, p int, windowed bool, out float32[], at int) {
			autocorr(x, n, p, windowed)
			ac[0] *= 1.0001
			for let i = 1; i <= p; i++ {
				let f = float32(0.008) * float32(i)
				ac[i] -= ac[i] * f * f
			}
			levinson(out, at, p)
		}

		// Low-passes and decimates `len` samples of each of `c` channels (the
		// first at x[at], the next `stride` later) by two into `buf`, summing
		// the channels, then whitens the result.
		def downsample(x float32[], at int, stride int, len int, c int) {
			let half = len >> 1
			for let ch = 0; ch < c; ch++ {
				let b = at + ch * stride
				for let i = 1; i < half; i++ {
					let v = float32(0.5) * (float32(0.5) * (x[b + 2 * i - 1] + x[b + 2 * i + 1]) + x[b + 2 * i])
					buf[i] = ch == 0 ?? (v, buf[i] + v)
				}
				let v0 = float32(0.5) * (float32(0.5) * x[b + 1] + x[b])
				buf[0] = ch == 0 ?? (v0, buf[0] + v0)
			}
			lpc(buf, half, 4, false, lpc4, 0)
			let tmp float32 = 1.0
			for let i = 0; i < 4; i++ {
				tmp = float32(0.9) * tmp
				lpc4[i] = lpc4[i] * tmp
			}
			let m0 float32 = 0.0
			let m1 float32 = 0.0
			let m2 float32 = 0.0
			let m3 float32 = 0.0
			for let i = 0; i < half; i++ {
				let x0 = buf[i]
				buf[i] = x0 + lpc4[0] * m0 + lpc4[1] * m1 + lpc4[2] * m2 + lpc4[3] * m3
				m3 = m2
				m2 = m1
				m1 = m0
				m0 = x0
			}
			m0 = 0.0
			for let i = 0; i < half; i++ {
				let x0 = buf[i]
				buf[i] = x0 + float32(0.8) * m0
				m0 = x0
			}
		}

		// The lag (in samples at half rate, 0..maxPitch) that best aligns
		// `len` samples of `buf` from `xAt` with it from `yAt`, searched at
		// quarter rate first and refined.
		def search(xAt int, yAt int, len int, maxPitch int) int {
			let lag = len + maxPitch
			for let j = 0; j < len >> 2; j++ {
				x4[j] = buf[xAt + 2 * j]
			}
			for let j = 0; j < lag >> 2; j++ {
				y4[j] = buf[yAt + 2 * j]
			}
			for let i = 0; i < maxPitch >> 2; i++ {
				let sum float32 = 0.0
				for let j = 0; j < len >> 2; j++ {
					sum += x4[j] * y4[i + j]
				}
				xcorr[i] = sum.max(float32(-1.0))
			}
			bestPitch(y4, 0, len >> 2, maxPitch >> 2)
			let b0 = best0
			let b1 = best1
			for let i = 0; i < maxPitch >> 1; i++ {
				xcorr[i] = 0.0
				continue when (i - 2 * b0).abs() > 2 && (i - 2 * b1).abs() > 2
				let sum float32 = 0.0
				for let j = 0; j < len >> 1; j++ {
					sum += buf[xAt + j] * buf[yAt + i + j]
				}
				xcorr[i] = sum.max(float32(-1.0))
			}
			bestPitch(buf, yAt, len >> 1, maxPitch >> 1)
			let offset = 0
			if best0 > 0 && best0 < (maxPitch >> 1) - 1 {
				let a = xcorr[best0 - 1]
				let b = xcorr[best0]
				let cc = xcorr[best0 + 1]
				if (cc - a) > float32(0.7) * (b - a) {
					offset = 1
				} else if (a - cc) > float32(0.7) * (b - cc) {
					offset = -1
				}
			}
			return 2 * best0 - offset
		}

		// The two lags of `xcorr` with the highest normalized correlation
		// against `len` samples of y from `yAt`, into best0 and best1.
		def bestPitch(y float32[], yAt int, len int, maxPitch int) {
			let syy float32 = 1.0
			let num0 float32 = -1.0
			let num1 float32 = -1.0
			let den0 float32 = 0.0
			let den1 float32 = 0.0
			best0 = 0
			best1 = 1
			for let j = 0; j < len; j++ {
				syy += y[yAt + j] * y[yAt + j]
			}
			for let i = 0; i < maxPitch; i++ {
				if xcorr[i] > 0.0 {
					let num = xcorr[i] * xcorr[i]
					if num * den1 > num1 * syy {
						if num * den0 > num0 * syy {
							num1 = num0
							den1 = den0
							best1 = best0
							num0 = num
							den0 = syy
							best0 = i
						} else {
							num1 = num
							den1 = syy
							best1 = i
						}
					}
				}
				syy += y[yAt + i + len] * y[yAt + i + len] - y[yAt + i] * y[yAt + i]
				syy = syy.max(float32(1.0))
			}
		}

		// Checks the period `t0In` (at full rate, found by `search` on a
		// `buf` of maxPeriod + n samples) against its submultiples so a
		// multiple of the true pitch is not taken, preferring the previous
		// period; returns the period and its gain.
		def removeDoubling(maxPeriodIn int, minPeriodIn int, nIn int, t0In int, prevPeriodIn int, prevGain float32) (int, float32) {
			let minPeriod0 = minPeriodIn
			let maxPeriod = maxPeriodIn / 2
			let minPeriod = minPeriodIn / 2
			let t0 = t0In / 2
			let prevPeriod = prevPeriodIn / 2
			let n = nIn / 2
			let x = maxPeriod
			t0 = maxPeriod - 1 when t0 >= maxPeriod
			let t = t0
			let xx0 float32 = 0.0
			let xy float32 = 0.0
			let yy float32 = 0.0
			for let i = 0; i < n; i++ {
				xy += buf[x + i] * buf[x + i - t0]
				xx0 += buf[x + i] * buf[x + i]
				yy += buf[x + i - t0] * buf[x + i - t0]
			}
			let bestXy = xy
			let bestYy = yy
			let g0 = xy / float32(celtSqrt(float(1.0 + xx0 * yy)))
			let g = g0
			for let k = 2; k <= 15; k++ {
				let t1 = (2 * t0 + k) / (2 * k)
				break when t1 < minPeriod
				let t1b = 0
				if k == 2 {
					t1b = t1 + t0 > maxPeriod ?? (t0, t0 + t1)
				} else {
					t1b = (2 * celtSecondCheck[k] * t0 + k) / (2 * k)
				}
				xy = 0.0
				yy = 0.0
				for let i = 0; i < n; i++ {
					xy += buf[x + i] * buf[x + i - t1]
					yy += buf[x + i - t1] * buf[x + i - t1]
					xy += buf[x + i] * buf[x + i - t1b]
					yy += buf[x + i - t1b] * buf[x + i - t1b]
				}
				let g1 = xy / float32(celtSqrt(float(1.0 + 2.0 * xx0 * yy)))
				let cont float32 = 0.0
				if (t1 - prevPeriod).abs() <= 1 {
					cont = prevGain
				} else if (t1 - prevPeriod).abs() <= 2 && 5 * k * k < t0 {
					cont = 0.5 * prevGain
				}
				if g1 > 0.3 + 0.4 * g0 - cont {
					bestXy = xy
					bestYy = yy
					t = t1
					g = g1
				}
			}
			let pg float32 = bestYy <= bestXy ?? (float32(1.0), bestXy / (bestYy + 1.0))
			for let k = 0; k < 3; k++ {
				let t1 = t + k - 1
				let sum float32 = 0.0
				for let i = 0; i < n; i++ {
					sum += buf[x + i] * buf[x + i - t1]
				}
				xcorr[k] = sum
			}
			let offset = 0
			if (xcorr[2] - xcorr[0]) > float32(0.7) * (xcorr[1] - xcorr[0]) {
				offset = 1
			} else if (xcorr[0] - xcorr[2]) > float32(0.7) * (xcorr[1] - xcorr[2]) {
				offset = -1
			}
			pg = g when pg > g
			let period = (2 * t + offset).max(minPeriod0)
			return (period, pg)
		}
	}

	// The pitch comb filter from `src[s]` into `dst[d]` (in place when they
	// are the same samples, as the decoder's post-filter; with negative gains
	// and separate buffers, the encoder's pre-filter), crossfading from
	// the old period, gain and tapset to the new over the first 120
	// samples when `window` (without it, the old values are used
	// throughout).
	def celtCombFilter(w float32[], dst float32[], d int, src float32[], s int, t0 int, t1 int, n int, g0 float32, g1 float32, tap0 int, tap1 int, window bool) {
		let g00 = g0 * celtCombGains[tap0 * 3]
		let g01 = g0 * celtCombGains[tap0 * 3 + 1]
		let g02 = g0 * celtCombGains[tap0 * 3 + 2]
		let g10 = g1 * celtCombGains[tap1 * 3]
		let g11 = g1 * celtCombGains[tap1 * 3 + 1]
		let g12 = g1 * celtCombGains[tap1 * 3 + 2]
		let overlap = window ?? (120, 0)
		for let i = 0; i < overlap; i++ {
			let f = w[i] * w[i]
			let nf = 1.0 - f
			let at = s + i
			dst[d + i] = src[at] + (nf * g00) * src[at - t0] + (nf * g01) * src[at - t0 - 1] + (nf * g01) * src[at - t0 + 1] + (nf * g02) * src[at - t0 - 2] + (nf * g02) * src[at - t0 + 2] + (f * g10) * src[at - t1] + (f * g11) * src[at - t1 - 1] + (f * g11) * src[at - t1 + 1] + (f * g12) * src[at - t1 - 2] + (f * g12) * src[at - t1 + 2]
		}
		for let i = overlap; i < n; i++ {
			let at = s + i
			dst[d + i] = src[at] + g10 * src[at - t1] + g11 * src[at - t1 - 1] + g11 * src[at - t1 + 1] + g12 * src[at - t1 - 2] + g12 * src[at - t1 + 2]
		}
	}
}
