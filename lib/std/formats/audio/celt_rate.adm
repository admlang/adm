internal partial module std.formats.audio.celt {
	use std.formats.audio.opus::*

	// The bit allocation of one CELT frame (RFC 6716 section 4.3.3): how the
	// bits left after the energy go to the shape (pulses) and fine energy
	// of each band. The same computation runs in the decoder and the
	// encoder, which also makes the skip decisions.
	type CeltAllocation {
		// Eighth bits for each band's shape.
		pulses       int[]
		// Fine energy bits per band and channel.
		fineQuant    int[]
		// Whether a band gets a final fine energy bit in the first pass (0)
		// or the second (1).
		finePriority int[]
		// The band above the last coded one.
		codedBands   int
		// The first band coded with intensity stereo.
		intensity    int
		// Whether the stereo bands are coded as left and right apart.
		dualStereo   bool
		// Eighth bits carried over to the band coding.
		balance      int
		bits1        int[]
		bits2        int[]
		thresh       int[]
		trim         int[]

		// An allocation with its buffers.
		def new() {
			pulses.len(21)
			fineQuant.len(21)
			finePriority.len(21)
			bits1.len(21)
			bits2.len(21)
			thresh.len(21)
			trim.len(21)
		}

		// Allocates `totalIn` eighth bits over bands start..end-1, reading the
		// skip, intensity and dual stereo decisions from `dec`, or writing
		// them to `enc` when `encode` (then `intensity` and `dualStereo`
		// hold the encoder's choices, and `prev` is the last frame's coded
		// band count). `c` is the channel count coded.
		def compute(start int, end int, offsets int[], cap int[], allocTrim int, totalIn int, c int, lm int, encode bool, dec OpusRangeDecoder, enc OpusRangeEncoder, prev int) {
			let total = totalIn.max(0)
			let skipStart = start
			let skipRsv = total >= 8 ?? (8, 0)
			total -= skipRsv
			let intensityRsv = 0
			let dualStereoRsv = 0
			if c == 2 {
				intensityRsv = celtLog2FracTable[end - start]
				if intensityRsv > total {
					intensityRsv = 0
				} else {
					total -= intensityRsv
					dualStereoRsv = total >= 8 ?? (8, 0)
					total -= dualStereoRsv
				}
			}
			for let j = start; j < end; j++ {
				let w = celtEBands[j + 1] - celtEBands[j]
				thresh[j] = (c << 3).max((3 * w << lm << 3) >> 4)
				trim[j] = (c * w * (allocTrim - 5 - lm) * (end - j - 1) * (1 << (lm + 3))) >> 6
				trim[j] -= c << 3 when (w << lm) == 1
			}
			let lo = 1
			let hi = 10
			for {
				let done = false
				let psum = 0
				let mid = (lo + hi) >> 1
				for let j = end - 1; j >= start; j-- {
					let w = celtEBands[j + 1] - celtEBands[j]
					let bitsj = (c * w * celtAllocVectors[mid * 21 + j] << lm) >> 2
					bitsj = (bitsj + trim[j]).max(0) when bitsj > 0
					bitsj += offsets[j]
					if bitsj >= thresh[j] || done {
						done = true
						psum += bitsj.min(cap[j])
					} else if bitsj >= c << 3 {
						psum += c << 3
					}
				}
				if psum > total {
					hi = mid - 1
				} else {
					lo = mid + 1
				}
				break when lo > hi
			}
			hi = lo
			lo--
			for let j = start; j < end; j++ {
				let w = celtEBands[j + 1] - celtEBands[j]
				let b1 = (c * w * celtAllocVectors[lo * 21 + j] << lm) >> 2
				let b2 = hi >= 11 ?? (cap[j], (c * w * celtAllocVectors[hi * 21 + j] << lm) >> 2)
				b1 = (b1 + trim[j]).max(0) when b1 > 0
				b2 = (b2 + trim[j]).max(0) when b2 > 0
				b1 += offsets[j] when lo > 0
				b2 += offsets[j]
				skipStart = j when offsets[j] > 0
				b2 = (b2 - b1).max(0)
				bits1[j] = b1
				bits2[j] = b2
			}
			interpolate(start, end, skipStart, cap, total, skipRsv, intensityRsv, dualStereoRsv, c, lm, encode, dec, enc, prev)
		}

		// Interpolates between the two allocation vectors, decides the skipped
		// bands, intensity and dual stereo, and splits each band's bits between
		// fine energy and shape.
		def interpolate(start int, end int, skipStart int, cap int[], totalIn int, skipRsv int, intensityRsvIn int, dualStereoRsvIn int, c int, lm int, encode bool, dec OpusRangeDecoder, enc OpusRangeEncoder, prev int) {
			let total = totalIn
			let intensityRsv = intensityRsvIn
			let dualStereoRsv = dualStereoRsvIn
			let allocFloor = c << 3
			let stereo = c > 1 ?? (1, 0)
			let logM = lm << 3
			let lo = 0
			let hi = 1 << 6
			for let i = 0; i < 6; i++ {
				let mid = (lo + hi) >> 1
				let psum = 0
				let done = false
				for let j = end - 1; j >= start; j-- {
					let t = bits1[j] + ((mid * bits2[j]) >> 6)
					if t >= thresh[j] || done {
						done = true
						psum += t.min(cap[j])
					} else if t >= allocFloor {
						psum += allocFloor
					}
				}
				if psum > total {
					hi = mid
				} else {
					lo = mid
				}
			}
			let psum = 0
			let done = false
			for let j = end - 1; j >= start; j-- {
				let t = bits1[j] + ((lo * bits2[j]) >> 6)
				if t < thresh[j] && !done {
					t = t >= allocFloor ?? (allocFloor, 0)
				} else {
					done = true
				}
				t = t.min(cap[j])
				pulses[j] = t
				psum += t
			}

			let coded = end
			for;; coded-- {
				let j = coded - 1
				if j <= skipStart {
					total += skipRsv
					break
				}
				let left = total - psum
				let span = celtEBands[coded] - celtEBands[start]
				let percoeff = left / span
				left -= span * percoeff
				let rem = (left - (celtEBands[j] - celtEBands[start])).max(0)
				let bandWidth = celtEBands[coded] - celtEBands[j]
				let bandBits = pulses[j] + percoeff * bandWidth + rem
				if bandBits >= thresh[j].max(allocFloor + 8) {
					if encode {
						let limit = ((j < prev ?? (7, 9)) * bandWidth << lm << 3) >> 4
						if bandBits > limit {
							enc.bitLogp(true, 1)
							break
						}
						enc.bitLogp(false, 1)
					} else if dec.bitLogp(1) {
						break
					}
					psum += 8
					bandBits -= 8
				}
				psum -= pulses[j] + intensityRsv
				intensityRsv = celtLog2FracTable[j - start] when intensityRsv > 0
				psum += intensityRsv
				if bandBits >= allocFloor {
					psum += allocFloor
					pulses[j] = allocFloor
				} else {
					pulses[j] = 0
				}
			}
			codedBands = coded

			if intensityRsv > 0 {
				if encode {
					intensity = intensity.min(coded)
					enc.uint(intensity - start, coded + 1 - start)
				} else {
					intensity = start + dec.uint(coded + 1 - start)
				}
			} else {
				intensity = 0
			}
			if intensity <= start {
				total += dualStereoRsv
				dualStereoRsv = 0
			}
			if dualStereoRsv > 0 {
				if encode {
					enc.bitLogp(dualStereo, 1)
				} else {
					dualStereo = dec.bitLogp(1)
				}
			} else {
				dualStereo = false
			}

			let left = total - psum
			let span = celtEBands[coded] - celtEBands[start]
			let percoeff = left / span
			left -= span * percoeff
			for let j = start; j < coded; j++ {
				pulses[j] += percoeff * (celtEBands[j + 1] - celtEBands[j])
			}
			for let j = start; j < coded; j++ {
				let t = left.min(celtEBands[j + 1] - celtEBands[j])
				pulses[j] += t
				left -= t
			}

			let bal = 0
			let j = start
			for; j < coded; j++ {
				let n0 = celtEBands[j + 1] - celtEBands[j]
				let n = n0 << lm
				pulses[j] += bal
				let excess = 0
				if n > 1 {
					excess = (pulses[j] - cap[j]).max(0)
					pulses[j] -= excess
					let den = c * n + ((c == 2 && n > 2 && !dualStereo && j < intensity) ?? (1, 0))
					let nclogn = den * (celtLogN[j] + logM)
					let offset = (nclogn >> 1) - den * 21
					offset += (den << 3) >> 2 when n == 2
					if pulses[j] + offset < (den * 2) << 3 {
						offset += nclogn >> 2
					} else if pulses[j] + offset < (den * 3) << 3 {
						offset += nclogn >> 3
					}
					fineQuant[j] = ((pulses[j] + offset + (den << 2)) / (den << 3)).max(0)
					fineQuant[j] = pulses[j] >> stereo >> 3 when c * fineQuant[j] > (pulses[j] >> 3)
					fineQuant[j] = fineQuant[j].min(8)
					finePriority[j] = fineQuant[j] * (den << 3) >= pulses[j] + offset ?? (1, 0)
					pulses[j] -= (c * fineQuant[j]) << 3
				} else {
					excess = (pulses[j] - (c << 3)).max(0)
					pulses[j] -= excess
					fineQuant[j] = 0
					finePriority[j] = 1
				}
				if excess > 0 {
					let extraFine = (excess >> (stereo + 3)).min(8 - fineQuant[j])
					fineQuant[j] += extraFine
					let extraBits = (extraFine * c) << 3
					finePriority[j] = extraBits >= excess - bal ?? (1, 0)
					excess -= extraBits
				}
				bal = excess
			}
			balance = bal
			for; j < end; j++ {
				fineQuant[j] = pulses[j] >> stereo >> 3
				pulses[j] = 0
				finePriority[j] = fineQuant[j] < 1 ?? (1, 0)
			}
		}
	}
}
