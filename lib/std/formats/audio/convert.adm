partial module std.formats.audio {
	use std.formats.audio.convert::*

	// Converter turns interleaved frames at one rate and channel count into
	// another, a chunk at a time: a player mixing tracks of different rates,
	// a speaker between what a program writes and what the device takes.
	//
	// Channels are mapped first. One channel goes to the front left and right
	// (to the only channel of a mono output); more than two fold down to
	// stereo with the ITU weights (centre and surrounds at -3 dB, LFE left
	// out), in the WAV channel order; stereo averages down to mono; otherwise
	// the first channels carry over and any extra output channel is silent.
	//
	// Rates change through a Kaiser-windowed sinc low-pass filter, so
	// downsampling does not fold high frequencies back down as audible tones.
	// The filter looks a few frames ahead: a converter holds back the last
	// frames of each chunk until more arrive, and `flush` hands them out at
	// the end.
	//
	// ```adm
	// let converter = new audio.Converter(44100, 2, 48000, 2)
	// try sink.write(converter.convert(chunk))
	// try sink.write(converter.flush())
	// ```
	type Converter {
		fromRate     int
		fromChannels int
		toRate       int
		toChannels   int

		// The rate change; none when the rates match.
		internal resampler ?Resampler = none
		// Output channel `o` is the sum over input channels `i` of
		// `mix[o * fromChannels + i]` times that channel.
		internal mix       float32[]

		def new(fromRate int, fromChannels int, toRate int, toChannels int) {
			self.fromRate = fromRate
			self.fromChannels = fromChannels
			self.toRate = toRate
			self.toChannels = toChannels
			mix = mixMatrix(fromChannels, toChannels)
			resampler = new Resampler(fromRate, toRate, toChannels) when fromRate != toRate && fromRate > 0 && toRate > 0
		}

		// Whether converting changes anything.
		def passes() bool {
			return fromRate == toRate && fromChannels == toChannels
		}

		// convert returns `samples`, whole input frames, in the output rate and
		// channels. Frames the filter still needs to look past come out of a
		// later call, or `flush`.
		def convert(samples float32[]) float32[] {
			return samples when passes()
			let mapped = fromChannels == toChannels ?? (samples, mapChannels(samples, fromChannels, toChannels, mix))
			return mapped when resampler is none
			return resampler.push(mapped)
		}

		// flush returns the frames still held back, as if the input ended here,
		// and starts over: the next `convert` begins a new stream.
		def flush() float32[] {
			let held float32[]
			return held when resampler is none
			return resampler.flush()
		}

		// reset forgets the input so far, as after a seek, dropping the frames
		// held back.
		def reset() {
			resampler.reset() unless resampler is none
		}
	}
}

internal partial module std.formats.audio.convert {
	use (
		std.math
		std.simd
	)

	// Zero crossings of the sinc on each side of a tap at the output's
	// Nyquist frequency; more is a steeper filter.
	const SINC_ZEROS = 24
	// Table entries per zero crossing; between them the filter is linear.
	const SINC_STEPS = 128
	// Kaiser window shape: about 90 dB of stopband attenuation.
	const KAISER_BETA = 9.0
	// Passband edge as a share of the lower Nyquist frequency.
	const SINC_ROLLOFF = 0.94
	// -3 dB, the ITU weight of the centre and surround channels in a downmix.
	const MINUS_3DB = 0.7071067811865476

	// The mix matrix from `from` channels to `to`, row per output channel.
	def mixMatrix(from int, to int) float32[] {
		let mix float32[]
		mix.len(from * to)
		return mix when from <= 0 || to <= 0
		if from == to {
			for let c = 0; c < to; c++ {
				mix[c * from + c] = 1.0
			}
			return mix
		}
		if from == 1 {
			mix[0] = 1.0
			mix[1] = 1.0 when to >= 2
			return mix
		}
		if to <= 2 && from > 2 {
			let stereo = stereoDownmix(from)
			return stereo when to == 2
			for let i = 0; i < from; i++ {
				mix[i] = float32(0.5) * (stereo[i] + stereo[from + i])
			}
			return mix
		}
		if to == 1 {
			for let i = 0; i < from; i++ {
				mix[i] = float32(1.0) / float32(from)
			}
			return mix
		}
		for let c = 0; c < to && c < from; c++ {
			mix[c * from + c] = 1.0
		}
		return mix
	}

	// The left and right rows folding `from` channels in the WAV order down to
	// stereo, each row scaled so a full-scale input cannot clip.
	def stereoDownmix(from int) float32[] {
		let left float[]
		let right float[]
		left.len(from)
		right.len(from)
		left[0] = 1.0
		right[1] = 1.0
		let a = MINUS_3DB
		match from {
			// FL FR FC
			case 3:
				left[2] = a
				right[2] = a
			// FL FR BL BR
			case 4:
				left[2] = a
				right[3] = a
			// FL FR FC BL BR
			case 5:
				left[2] = a
				right[2] = a
				left[3] = a
				right[4] = a
			// FL FR FC LFE BL BR
			case 6:
				left[2] = a
				right[2] = a
				left[4] = a
				right[5] = a
			// FL FR FC LFE BC SL SR
			case 7:
				left[2] = a
				right[2] = a
				left[4] = 0.5
				right[4] = 0.5
				left[5] = a
				right[6] = a
			// FL FR FC LFE BL BR SL SR
			case 8:
				left[2] = a
				right[2] = a
				left[4] = a
				right[5] = a
				left[6] = a
				right[7] = a
		}
		let leftSum = 0.0
		let rightSum = 0.0
		for let i = 0; i < from; i++ {
			leftSum += left[i]
			rightSum += right[i]
		}
		let mix float32[]
		mix.len(2 * from)
		for let i = 0; i < from; i++ {
			mix[i] = float32(left[i] / leftSum)
			mix[from + i] = float32(right[i] / rightSum)
		}
		return mix
	}

	// The frames of `samples` with `to` channels, through `mix`.
	def mapChannels(samples float32[], from int, to int, mix float32[]) float32[] {
		let frames = samples.len() / from
		let out float32[]
		out.len(frames * to)
		for let f = 0; f < frames; f++ {
			let at = f * from
			for let o = 0; o < to; o++ {
				let sum float32 = 0.0
				let row = o * from
				for let i = 0; i < from; i++ {
					sum += mix[row + i] * samples[at + i]
				}
				out[f * to + o] = sum
			}
		}
		return out
	}

	// The zeroth-order modified Bessel function of the first kind, which
	// shapes the Kaiser window.
	def besselI0(x float) float {
		let sum = 1.0
		let term = 1.0
		let half = x / 2.0
		for let k = 1; k < 50; k++ {
			term *= (half / float(k)) * (half / float(k))
			sum += term
			break when term < sum * 1e-17
		}
		return sum
	}

	// Largest table of precomputed filter weights, in floats (4 MB); a rate
	// pair needing more computes them per output frame instead.
	const PHASE_TABLE_LIMIT = 1 << 20

	// The greatest common divisor of `a` and `b`.
	def gcd(a int, b int) int {
		for b != 0 {
			a, b = b, a % b
		}
		return a
	}

	// The sum of `count` products `a[aAt + k] * b[bAt + k]`, eight at a time.
	def dot(a float32[], aAt int, b float32[], bAt int, count int) float32 {
		let acc = simd.splat8<float32>(float32(0.0))
		let k = 0
		for; k + 8 <= count; k += 8 {
			acc = acc + simd.load8<float32>(a, aAt + k) * simd.load8<float32>(b, bAt + k)
		}
		let sum = simd.sum(acc)
		for; k < count; k++ {
			sum += a[aAt + k] * b[bAt + k]
		}
		return sum
	}

	// A streaming band-limited rate change of interleaved frames. Output frame
	// `n` sits at input time `n * fromRate / toRate`, kept exactly as a whole
	// frame and a fraction in `toRate`ths, and is the sum of the input frames
	// within `reach` of it, each weighted by the windowed sinc at its distance.
	//
	// The fraction only takes `toRate / gcd` values (160 from 44.1 to 48 kHz),
	// so the weights of each are worked out once, in `phases`; each output
	// frame is then one dot product per channel over that channel's history.
	type Resampler {
		fromRate int
		toRate   int
		channels int
		// The filter's cutoff as a share of the input's Nyquist frequency.
		cutoff   float
		// How far the filter reaches each side, in input frames; an output
		// frame uses `2 * reach` of them.
		reach    int
		taps     int
		// The windowed sinc at `SINC_STEPS` points per zero crossing, from 0.
		table    float[]
		// The weights of every fraction, `taps` each, when they fit
		// `PHASE_TABLE_LIMIT`; `step` is the fraction between two of them.
		phases   float32[]
		step     int
		// Input frames kept, one history per channel; index 0 is input frame
		// `base`.
		history  float32[][]
		base     int
		// Input frames received since the start.
		received int
		// Input time of the next output frame: `whole` plus `fraction / toRate`.
		whole    int
		fraction int
		// The weights of one output frame when they are not precomputed.
		weights  float32[]

		def new(fromRate int, toRate int, channels int) {
			self.fromRate = fromRate
			self.toRate = toRate
			self.channels = channels
			let ratio = float(toRate) / float(fromRate)
			cutoff = SINC_ROLLOFF * (ratio < 1.0 ?? (ratio, 1.0))
			reach = int(float(SINC_ZEROS) / cutoff) + 1
			taps = 2 * reach
			table.len(SINC_ZEROS * SINC_STEPS + 2)
			let norm = besselI0(KAISER_BETA)
			for let m = 0; m < table.len(); m++ {
				let u = float(m) / float(SINC_STEPS)
				if u >= float(SINC_ZEROS) {
					table[m] = 0.0
					continue
				}
				let sinc = m == 0 ?? (1.0, math.sin(math.Pi * u) / (math.Pi * u))
				let w = u / float(SINC_ZEROS)
				table[m] = sinc * besselI0(KAISER_BETA * math.sqrt(1.0 - w * w)) / norm
			}
			weights.len(taps)
			step = gcd(fromRate, toRate)
			let count = toRate / step
			if count * taps <= PHASE_TABLE_LIMIT {
				phases.len(count * taps)
				for let p = 0; p < count; p++ {
					fillWeights(float(p * step) / float(toRate), phases, p * taps)
				}
			}
			reset()
		}

		// Writes the weights of an output frame `offset` of the way past a
		// whole input frame into `out` from `at`.
		def fillWeights(offset float, out float32[], at int) {
			for let k = 0; k < taps; k++ {
				let u = (offset - float(k - reach + 1)).abs() * cutoff * float(SINC_STEPS)
				let m = int(u)
				if m + 1 >= table.len() {
					out[at + k] = float32(0.0)
					continue
				}
				let f = u - float(m)
				out[at + k] = float32(cutoff * (table[m] + (table[m + 1] - table[m]) * f))
			}
		}

		// Starts over: the frames before the first are silent.
		def reset() {
			history = float32[][]
			for let c = 0; c < channels; c++ {
				let silent float32[]
				silent.len(reach)
				history.push(silent)
			}
			base = -reach
			received = 0
			whole = 0
			fraction = 0
		}

		// Appends interleaved frames to the per-channel histories.
		def append(samples float32[]) {
			let frames = samples.len() / channels
			for let c = 0; c < channels; c++ {
				let line = history[c]
				let at = line.len()
				line.len(at + frames)
				for let f = 0; f < frames; f++ {
					line[at + f] = samples[f * channels + c]
				}
				history[c] = line
			}
			received += frames
		}

		// push takes whole frames and returns the output frames every tap of
		// which has arrived.
		def push(samples float32[]) float32[] {
			append(samples)
			return render(base + history[0].len() - reach, false)
		}

		// flush returns the output frames up to the end of the input, then
		// starts over.
		def flush() float32[] {
			let end = received
			let silent float32[]
			silent.len((reach + 1) * channels)
			append(silent)
			let out = render(end, true)
			reset()
			return out
		}

		// The output frames whose time lies before input frame `limit` (while
		// the whole frame is below it), then drops the frames no later output
		// needs.
		def render(limit int, ending bool) float32[] {
			// Count the frames first, so the output is sized once.
			let count = 0
			let w = whole
			let f = fraction
			for w < limit {
				count++
				f += fromRate
				w += f / toRate
				f = f % toRate
			}
			let out float32[]
			out.len(count * channels)
			let at = 0
			let precomputed = phases.len() > 0
			for whole < limit {
				let first = whole - reach + 1
				let from = first - base
				let weightsAt = 0
				let source = weights
				if precomputed {
					source = phases
					weightsAt = fraction / step * taps
				} else {
					fillWeights(float(fraction) / float(toRate), weights, 0)
				}
				for let c = 0; c < channels; c++ {
					out[at + c] = dot(source, weightsAt, history[c], from, taps)
				}
				at += channels
				fraction += fromRate
				whole += fraction / toRate
				fraction = fraction % toRate
			}
			let keep = whole - reach + 1
			let drop = keep - base
			if !ending && drop > 4096 {
				for let c = 0; c < channels; c++ {
					history[c] = history[c][drop:]
				}
				base = keep
			}
			return out
		}
	}
}
