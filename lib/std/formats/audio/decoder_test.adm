partial module std.formats.audio {
	use (
		std.bytes
		std.math
		std.testing
		std.formats.media.ogg::*
		std.formats.media.asf::*
	)

	check "Packet decoders" {
		// `seconds` of a mono 440 Hz tone at `rate`.
		def toneAt(rate int, seconds int) PCM {
			let frames = rate * seconds
			let samples float32[]
			samples.len(frames)
			for let i = 0; i < frames; i++ {
				samples[i] = float32(0.4 * math.sin(2.0 * math.Pi * 440.0 * float(i) / float(rate)))
			}
			let pcm = new PCM()
			pcm.info = AudioInfo{sampleRate: uint32(rate), channels: 1, bitDepth: 32, format: SampleFormat.Float32, frames: uint64(frames)}
			pcm.samples = samples
			return pcm
		}

		// `pcm` encoded by `codec`.
		// Fails when encoding does.
		def encoded(codec AudioEncoder, pcm PCM) !byte[] {
			let out = new bytes.Buffer()
			try codec.encode(pcm.stream(), out)
			return out.bytes()
		}

		// Every sample the codec's stream decodes from the file.
		// Fails when decoding does.
		def whole(codec AudioFormat, data byte[]) !float32[] {
			let stream = try codec.open(new bytes.Reader(data))
			let out float32[]
			let buf float32[]
			buf.len(1000 * int(stream.info().channels))
			for {
				let got = try stream.read(buf)
				break when got == 0
				out = out + buf[:got * int(stream.info().channels)]
			}
			return out
		}

		// Every sample the decoder gives for the packets, and its flush.
		// Fails when decoding does.
		def feed(d AudioDecoder, packets byte[][]) !float32[] {
			let out float32[]
			for let (_, p) in packets {
				out = out + try d.decode(p)
			}
			return out + try d.flush()
		}

		// The bytes cut into pieces of `size`, as a stream cuts them.
		def pieces(data byte[], size int) byte[][] {
			let out byte[][]
			for let at = 0; at < data.len(); at += size {
				out.push(data[at:(at + size).min(data.len())].clone())
			}
			return out
		}

		// The packets of the first logical stream of an Ogg file.
		// Fails when a page is damaged.
		def oggPackets(data byte[]) !byte[][] {
			let r = new OggPacketReader(new bytes.Reader(data))
			let out byte[][]
			for {
				let p = try r.next()
				break when p is none
				out.push(p)
			}
			return out
		}

		// Whether `part` appears in `all` from `at`.
		def sameAt(all float32[], at int, part float32[]) bool {
			return false when at + part.len() > all.len()
			for let i = 0; i < part.len(); i++ {
				return false when (all[at + i] - part[i]).abs() > 0.00001
			}
			return true
		}

		@test()
		def TestAacAdtsPackets() !none {
			let codec = new AAC()
			let data = try encoded(codec, toneAt(44100, 1))
			let d = try codec.decoder(byte[])
			assert d.info().sampleRate == 0
			let got = try feed(d, pieces(data, 333))
			let want = try whole(codec, data)
			try testing.expectEqual(want.len(), got.len())
			assert sameAt(got, 0, want)
			assert d.info().sampleRate == 44100 && d.info().channels == 1
		}

		@test()
		def TestAacConfig() !none {
			let d = try new AAC().decoder(byte[0x12, 0x10])
			assert d.info().sampleRate == 44100 && d.info().channels == 2
			// HE-AAC (object type 5) is refused.
			try testing.expectError(new AAC().decoder(byte[0x2B, 0x92, 0x08, 0x00]))
		}

		@test()
		def TestMp3Packets() !none {
			let codec = new MP3()
			let data = try encoded(codec, toneAt(44100, 1))
			let d = try codec.decoder(byte[])
			let got = try feed(d, pieces(data, 417))
			let want = try whole(codec, data)
			assert got.len() % 1152 == 0 && got.len() >= want.len()
			assert d.info().sampleRate == 44100 && d.info().channels == 1
		}

		@test()
		def TestVorbisPackets() !none {
			let codec = new Vorbis()
			let data = try encoded(codec, toneAt(44100, 1))
			let packets = try oggPackets(data)
			let config byte[]
			for let i = 0; i < 3; i++ {
				let h = packets[i]
				config.push(byte(h.len() >> 8), byte(h.len() & 0xFF))
				config = config.concat(h)
			}
			let d = try codec.decoder(config)
			assert d.info().sampleRate == 44100 && d.info().channels == 1
			let got = try feed(d, packets[3:])
			let want = try whole(codec, data)
			assert got.len() >= want.len() && got.len() < want.len() + 2048
			assert sameAt(got, 0, want[0:1000])
			try testing.expectError(codec.decoder(config[0:20]))
		}

		@test()
		def TestOpusPackets() !none {
			let codec = new Opus()
			let data = try encoded(codec, toneAt(48000, 1))
			let packets = try oggPackets(data)
			let d = try codec.decoder(packets[0])
			assert d.info().sampleRate == 48000 && d.info().channels == 1
			let got = try feed(d, packets[2:])
			let want = try whole(codec, data)
			assert got.len() % 120 == 0 && got.len() >= want.len()
			try testing.expectError(codec.decoder(byte[1, 2, 3]))
		}

		@test()
		def TestWmaPackets() !none {
			let codec = new WMA()
			let data = try encoded(codec, toneAt(44100, 1))
			let reader = new bytes.Reader(data)
			let header = new AsfHeader()
			try header.read(reader)
			let a = header.audio
			let config byte[]
			config.len(18)
			for let (at, field) in int[a.formatTag, a.channels, 0, 0, 0, 0, a.blockAlign, a.bitsPerSample, a.extra.len()] {
				config[at * 2] = byte(field & 0xFF)
				config[at * 2 + 1] = byte((field >> 8) & 0xFF)
			}
			for let i = 0; i < 4; i++ {
				config[4 + i] = byte((a.sampleRate >> (8 * i)) & 0xFF)
				config[8 + i] = byte((a.bytesPerSec >> (8 * i)) & 0xFF)
			}
			config = config.concat(a.extra)
			let d = try codec.decoder(config)
			assert d.info().sampleRate == 44100 && d.info().channels == 1
			let objects = new AsfPacketReader(reader, header, a)
			let packets byte[][]
			for {
				let obj = try objects.next()
				break when obj is none
				packets.push(obj.data)
			}
			let got = try feed(d, packets)
			let want = try whole(codec, data)
			assert got.len() >= want.len() && got.len() <= want.len() + 4096
			assert sameAt(got, 0, want[0:1000])
			try testing.expectError(codec.decoder(byte[1, 0]))
		}
	}
}
