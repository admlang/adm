partial module std.formats.audio {
	use (
		std.io
		std.os
		std.bytes
		std.formats.audio.flac::*
	)

	// What an embedded picture shows, as the FLAC PICTURE block numbers it.
	enum FlacPictureKind {
		Other,
		FileIcon,
		OtherFileIcon,
		FrontCover,
		BackCover,
		Leaflet,
		Media,
		LeadArtist,
		Artist,
		Conductor,
		Band,
		Composer,
		Lyricist,
		RecordingLocation,
		DuringRecording,
		DuringPerformance,
		ScreenCapture,
		BrightFish,
		Illustration,
		BandLogo,
		PublisherLogo
	}

	// A picture embedded in a FLAC file: cover art, a band logo.
	struct FlacPicture {
		kind        FlacPictureKind = FlacPictureKind.FrontCover
		// MIME type of `data`, "image/png", or "-->" when `data` is a URL.
		mimeType    string
		description string
		// Pixel size and colour depth as the file states them, 0 when unknown.
		width       int
		height      int
		depth       int
		// Palette size of an indexed picture, 0 otherwise.
		colors      int
		// The encoded picture, in the format `mimeType` names.
		data        byte[]
	}

	// What a FLAC file's metadata blocks say, beyond `AudioInfo`.
	struct FlacMetadata {
		info         AudioInfo
		// Smallest and largest block size, in frames, the encoder used.
		minBlockSize int
		maxBlockSize int
		// Smallest and largest frame size in bytes, 0 when unknown.
		minFrameSize int
		maxFrameSize int
		// MD5 of the decoded samples, all zero when the encoder did not
		// compute it.
		md5          byte[]
		// Name of the encoder that wrote the Vorbis comments.
		vendor       string
		// Vorbis comments by upper-case field name: "TITLE", "ARTIST". A field
		// may repeat, so each holds every value in file order.
		tags         map<string, string[]>
		pictures     FlacPicture[]
	}

	// FLAC is the Free Lossless Audio Codec: reads and writes native `.flac`
	// files.
	//
	// Decoding covers the whole format: every subframe type, 4 to 32 bits per
	// sample, variable block sizes, with each frame's CRCs checked. The
	// encoder writes fixed and LPC predictors with stereo decorrelation.
	@codec("FLAC")
	type FLAC {
		// Encoder effort, 0 (fastest) to 8 (smallest): 0 to 2 use fixed
		// predictors only (0 without stereo decorrelation), 3 and 4 add LPC
		// up to order 6 and 8 with an estimated order, 5 measures every order
		// up to 8, 6 and 7 up to 12, 8 up to 16, with deeper partition search
		// as the level rises.
		compression  int                   = 5
		// Frames per block the encoder writes, 16 to 65535.
		blockSize    int                   = 4096
		// Spacing of the SEEKTABLE points the encoder writes; 0s writes no
		// seek table.
		seekInterval duration              = 10s
		// Vorbis comments the encoder writes, by field name.
		tags         map<string, string[]> = new map<string, string[]>()
		// Pictures the encoder embeds.
		pictures     FlacPicture[]
		// Whether a stream opened by this codec checks the decoded samples
		// against the stored MD5 when it reaches the end, failing that last
		// read on a mismatch. Only a stream read start to end without a seek
		// is checked.
		verify       bool                  = false

		mimeType string[] {
			def get() string[] {
				return string["audio/flac", "audio/x-flac"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".flac"]
			}
		}

		// matchSignature reports whether the reader starts with the `fLaC`
		// marker, after an ID3v2 tag when one comes first.
		def matchSignature(r io.Reader) bool {
			let consumed = flacReadMarker(r) onerror recover -1
			return consumed >= 0
		}

		// open returns a stream decoding the FLAC audio the reader holds. The
		// stream seeks when the reader is an `os.File` or a `bytes.Reader`, and
		// closes an `os.File` reader when it is closed.
		// Fails when the data is not FLAC, its metadata is damaged, or the
		// reader fails.
		// Fails too when `live` is set: the codec needs the whole file.
		def open(reader io.Reader, live bool = false) !AudioStream {
			fail "flac: a live stream cannot be decoded" when live
			let stream = try new FlacStream(reader, verify).start()
			return stream
		}

		// open returns a seekable stream decoding the FLAC file at path, which
		// stays open until the stream is closed.
		// Fails when the file cannot be opened or is not FLAC.
		def open(path string) !AudioStream {
			let f = try os.open(path)
			let s = new FlacStream(f, verify)
			let stream = s.start() onerror (err error) {
				f.close() onerror recover none
				return err
			}
			return stream
		}

		// open returns a seekable stream decoding the FLAC audio in the bytes.
		// Fails when they are not FLAC or its metadata is damaged.
		def open(data byte[]) !AudioStream {
			return open(new bytes.Reader(data))
		}

		// info reads the stream description from the STREAMINFO block.
		// Fails when the data is not FLAC or the reader fails.
		def info(reader io.Reader) !AudioInfo {
			let (md, _, _) = try flacReadMetadata(reader, false)
			return md.info
		}

		// metadata reads every metadata block: the stream description, the
		// Vorbis comments, the pictures and the stored MD5.
		// Fails when the data is not FLAC, a block is damaged, or the reader
		// fails.
		def metadata(reader io.Reader) !FlacMetadata {
			let (md, _, _) = try flacReadMetadata(reader, true)
			return md
		}

		// metadata reads every metadata block of the FLAC file at path.
		// Fails when the file cannot be read or is not FLAC.
		def metadata(path string) !FlacMetadata {
			let f = try os.open(path)
			defer f.close()
			return metadata(f)
		}

		// encode writes the stream, from where it stands to its end, as a FLAC
		// file with this codec's `compression`, `blockSize`, `tags` and
		// `pictures`. Samples are stored at the stream's bit depth, 4 to 24
		// bits; float sources and deeper integers are stored at 24 bits.
		// Channels past the eighth are dropped.
		// Fails when the stream has no channels or no sample rate, or the
		// stream or the writer fails.
		def encode(stream AudioStream, writer io.Writer) !none {
			let enc = new FlacEncoder(self)
			return enc.encode(stream, writer)
		}

		// encode renders the stream, from where it stands to its end, as FLAC
		// bytes, as `encode(stream, writer)` does.
		// Fails when the stream has no channels or no sample rate, or reading
		// it fails.
		def encode(stream AudioStream) !byte[] {
			let out = new bytes.Buffer()
			try encode(stream, out)
			return out.bytes()
		}
	}
}
