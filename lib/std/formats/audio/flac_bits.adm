internal partial module std.formats.audio.flac {
	use (
		std.formats.audio.loader::*
		std.formats.audio::*
	)

	// CRC-8 of a FLAC frame header: polynomial x^8 + x^2 + x + 1, most
	// significant bit first, starting from 0.
	let flacCrc8Table = flacCrcTable(0x07, 8)

	// CRC-16 of a whole FLAC frame: polynomial x^16 + x^15 + x^2 + 1, most
	// significant bit first, starting from 0.
	let flacCrc16Table = flacCrcTable(0x8005, 16)

	// The byte-at-a-time table of an MSB-first CRC of the given width.
	def flacCrcTable(poly int, width int) int[] {
		let table int[]
		table.len(256)
		let top = 1 << (width - 1)
		let mask = (1 << width) - 1
		for let i = 0; i < 256; i++ {
			let crc = i << (width - 8)
			for let b = 0; b < 8; b++ {
				if (crc & top) != 0 {
					crc = ((crc << 1) ^ poly) & mask
				} else {
					crc = (crc << 1) & mask
				}
			}
			table[i] = crc
		}
		return table
	}

	// The CRC-8 of `data[from:to]`.
	def flacCrc8(data byte[], from int, to int) int {
		let table = flacCrc8Table
		let crc = 0
		for let i = from; i < to; i++ {
			crc = table[crc ^ int(data[i])]
		}
		return crc
	}

	// The CRC-16 of `data[from:to]`.
	def flacCrc16(data byte[], from int, to int) int {
		let table = flacCrc16Table
		let crc = 0
		for let i = from; i < to; i++ {
			crc = ((crc << 8) & 0xFFFF) ^ table[(crc >> 8) ^ int(data[i])]
		}
		return crc
	}

	// Reads a FLAC bitstream: big-endian bit order, most significant bit
	// first, over a window of a byte array.
	//
	// Reading past the window yields zero bits and sets `overrun`, so a frame
	// cut short by the end of the buffered bytes is detected once, after the
	// frame, instead of on every read.
	type FlacBitReader {
		data  byte[]
		// The next byte to load into `acc`.
		pos   int
		// The end of the window.
		end   int
		// Unread bits, left aligned.
		acc   uint64
		// How many bits of `acc` are unread.
		count int
		// Zero bytes loaded past the end of the window.
		extra int

		// Starts reading `data` at byte `from`, up to byte `to`.
		def reset(data byte[], from int, to int) {
			self.data = data
			pos = from
			end = to
			acc = 0
			count = 0
			extra = 0
		}

		// Whether a read went past the end of the window.
		def overrun() bool {
			return extra * 8 > count
		}

		// The byte offset of the next unread bit, rounded down.
		def offset() int {
			return pos + extra - count / 8
		}

		// Loads whole bytes until at least 57 bits are unread.
		def refill() {
			for count <= 56 {
				if pos < end {
					acc = acc | (uint64(data[pos]) << uint64(56 - count))
					pos++
				} else {
					extra++
				}
				count += 8
			}
		}

		// Reads `bits` bits, 0 to 57, as an unsigned number.
		def read(bits int) int {
			return 0 when bits == 0
			refill() when count < bits
			let v = int(acc >> uint64(64 - bits))
			acc = acc << uint64(bits)
			count -= bits
			return v
		}

		// Reads `bits` bits, 1 to 57, as a two's complement number.
		def readSigned(bits int) int {
			return 0 when bits == 0
			let v = read(bits)
			return v - (1 << bits) when v >= (1 << (bits - 1))
			return v
		}

		// Reads a unary number: the count of 0 bits before the next 1 bit,
		// which is consumed too.
		def readUnary() int {
			let q = 0
			for {
				if acc == 0 {
					q += count
					count = 0
					refill()
					return q when extra > 8
					continue
				}
				let z = acc.leadingZeros()
				q += z
				acc = (acc << uint64(z)) << 1
				count -= z + 1
				return q
			}
			return q
		}

		// Skips to the next byte boundary.
		def align() {
			let drop = count % 8
			acc = acc << uint64(drop)
			count -= drop
		}

		// Decodes `n` Rice-coded residuals with parameter `k` into
		// `out[at:at + n]`, as signed numbers.
		def readRice(out int[], at int, n int, k int) {
			let a = acc
			let c = count
			let p = pos
			let e = end
			let src = data
			let stop = at + n
			let k64 = uint64(k)
			let right = uint64(64 - k)
			for let i = at; i < stop; i++ {
				let q = 0
				for a == 0 {
					q += c
					c = 0
					for c <= 56 {
						if p < e {
							a = a | (uint64(src[p]) << uint64(56 - c))
							p++
						} else {
							extra++
						}
						c += 8
					}
					a = 1 << 63 when extra > 8
				}
				let z = a.leadingZeros()
				q += z
				a = (a << uint64(z)) << 1
				c -= z + 1
				let u = q
				if k > 0 {
					if c < k {
						for c <= 56 {
							if p < e {
								a = a | (uint64(src[p]) << uint64(56 - c))
								p++
							} else {
								extra++
							}
							c += 8
						}
					}
					u = (q << k) | int(a >> right)
					a = a << k64
					c -= k
				}
				out[i] = (u >> 1) ^ -(u & 1)
			}
			acc = a
			count = c
			pos = p
		}
	}

	// Writes a FLAC bitstream, most significant bit first, into a growable
	// byte array.
	type FlacBitWriter {
		// The bytes written so far; only the first `size` are meaningful.
		data  byte[]
		size  int
		// Pending bits, right aligned.
		acc   uint64
		// How many bits `acc` holds.
		count int

		def new() {
			data.len(1 << 16)
		}

		// Empties the writer, keeping its storage.
		def reset() {
			size = 0
			acc = 0
			count = 0
		}

		// Makes room for `extra` more bytes.
		def reserve(extra int) {
			return when size + extra <= data.len()
			let grown = data.len() * 2
			grown = size + extra + 1024 when grown < size + extra + 1024
			let next byte[]
			next.len(grown)
			data[0:size].copy(next)
			data = next
		}

		// Moves whole pending bytes into `data`.
		def drain() {
			reserve(8)
			for count >= 8 {
				count -= 8
				data[size] = byte((acc >> uint64(count)) & 0xFF)
				size++
			}
			acc = acc & ((uint64(1) << uint64(count)) - 1)
		}

		// Writes the low `bits` bits of `value`, 0 to 32 bits.
		def write(value int, bits int) {
			return when bits == 0
			drain() when count + bits > 56
			acc = (acc << uint64(bits)) | (uint64(value) & ((uint64(1) << uint64(bits)) - 1))
			count += bits
		}

		// Writes `q` zero bits and a one bit.
		def writeUnary(q int) {
			let left = q
			for left >= 32 {
				write(0, 32)
				left -= 32
			}
			write(1, left + 1)
		}

		// Pads with zero bits to the next byte boundary.
		def align() {
			write(0, 8 - count % 8) when count % 8 != 0
		}

		// Writes `n` residuals from `values[at:at + n]` Rice coded with
		// parameter `k`.
		def writeRice(values int[], at int, n int, k int) {
			let stop = at + n
			for let i = at; i < stop; i++ {
				let v = values[i]
				let u = (v << 1) ^ (v >> 63)
				let q = u >> k
				if q < 24 && count + q + 1 + k <= 56 {
					acc = (acc << uint64(q + 1 + k)) | uint64((1 << k) | (u & ((1 << k) - 1)))
					count += q + 1 + k
				} else {
					writeUnary(q)
					write(u, k)
				}
				drain() when count >= 32
			}
		}

		// The number of bits written.
		def bitLen() int {
			return size * 8 + count
		}

		// Writes every bit `other` holds.
		def append(other FlacBitWriter) {
			other.drain()
			let src = other.data
			let n = other.size
			let i = 0
			for i + 4 <= n {
				write((int(src[i]) << 24) | (int(src[i + 1]) << 16) | (int(src[i + 2]) << 8) | int(src[i + 3]), 32)
				i += 4
			}
			for i < n {
				write(int(src[i]), 8)
				i++
			}
			write(int(other.acc), other.count)
		}

		// The number of whole bytes written, once the writer is aligned.
		def len() int {
			drain()
			return size
		}

		// The bytes written, once the writer is aligned.
		def bytes() byte[] {
			drain()
			return data[0:size]
		}
	}
}
