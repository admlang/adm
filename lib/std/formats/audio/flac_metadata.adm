internal partial module std.formats.audio.flac {
	use (
		std.io
		std.formats.audio::*
	)

	// Metadata block types.
	const (
		flacStreamInfo    = 0
		flacSeekTable     = 3
		flacVorbisComment = 4
		flacPicture       = 6
	)

	// The size of the ID3v2 tag whose 10-byte header is `head`, header
	// included, footer included when its flag is set.
	def flacId3Size(head byte[]) int {
		let size = (int(head[6] & 0x7F) << 21) | (int(head[7] & 0x7F) << 14) | (int(head[8] & 0x7F) << 7) | int(head[9] & 0x7F)
		let footer = (head[5] & 0x10) != 0 ?? (10, 0)
		return 10 + size + footer
	}

	// Reads the `fLaC` marker, skipping an ID3v2 tag in front of it, and
	// returns the number of bytes consumed.
	// Fails when the data does not start with the marker, or the reader fails.
	def flacReadMarker(r io.Reader) !int {
		let head byte[]
		head.len(4)
		fail "flac: truncated file" when (try io.readFull(r, head)) != 4
		let consumed = 4
		if head[0] == 0x49 && head[1] == 0x44 && head[2] == 0x33 {
			let tag byte[]
			tag.len(10)
			tag[0] = head[0]
			tag[1] = head[1]
			tag[2] = head[2]
			tag[3] = head[3]
			let rest byte[]
			rest.len(6)
			fail "flac: truncated ID3 tag" when (try io.readFull(r, rest)) != 6
			for let i = 0; i < 6; i++ {
				tag[4 + i] = rest[i]
			}
			let skip = flacId3Size(tag) - 10
			let body byte[]
			body.len(skip)
			fail "flac: truncated ID3 tag" when (try io.readFull(r, body)) != skip
			fail "flac: truncated file" when (try io.readFull(r, head)) != 4
			consumed = 10 + skip + 4
		}
		fail "not a FLAC file" unless head[0] == 0x66 && head[1] == 0x4C && head[2] == 0x61 && head[3] == 0x43
		return consumed
	}

	// A big-endian unsigned number of `n` bytes at `data[at]`.
	def flacBE(data byte[], at int, n int) int {
		let v = 0
		for let i = 0; i < n; i++ {
			v = (v << 8) | int(data[at + i])
		}
		return v
	}

	// A little-endian 32-bit unsigned number at `data[at]`.
	def flacLE32(data byte[], at int) int {
		return int(data[at]) | (int(data[at + 1]) << 8) | (int(data[at + 2]) << 16) | (int(data[at + 3]) << 24)
	}

	// The sample layout that holds `bps` bits.
	def flacSampleFormat(bps int) SampleFormat {
		return SampleFormat.Uint8 when bps <= 8
		return SampleFormat.Int16 when bps <= 16
		return SampleFormat.Int24 when bps <= 24
		return SampleFormat.Int32
	}

	// Parses a STREAMINFO block into `md`.
	// Fails when the block is too short or describes an impossible stream.
	def flacParseStreamInfo(body byte[], md FlacMetadata) !none {
		expects {
			assert body.len() >= 34 onerror fail "flac: STREAMINFO is too short"
		}
		md.minBlockSize = flacBE(body, 0, 2)
		md.maxBlockSize = flacBE(body, 2, 2)
		md.minFrameSize = flacBE(body, 4, 3)
		md.maxFrameSize = flacBE(body, 7, 3)
		let rate = flacBE(body, 10, 3) >> 4
		let channels = ((int(body[12]) >> 1) & 7) + 1
		let bps = (((int(body[12]) & 1) << 4) | (int(body[13]) >> 4)) + 1
		let frames = ((int(body[13]) & 0x0F) << 32) | flacBE(body, 14, 4)
		fail "flac: STREAMINFO has no sample rate" when rate == 0
		fail "flac: STREAMINFO block sizes are out of range" when md.maxBlockSize < 16 || md.minBlockSize > md.maxBlockSize
		fail "flac: {bps}-bit samples are not supported" when bps < 4
		md.md5 = body[18:34].clone()
		md.info = AudioInfo{
			sampleRate: uint32(rate),
			channels: uint16(channels),
			bitDepth: uint16(bps),
			format: flacSampleFormat(bps),
			frames: uint64(frames),
			length: duration(frames * 1000000000 / rate),
			codec: "flac",
			bitrate: 0,
			seekable: false
		}
		return none
	}

	// Parses a VORBIS_COMMENT block into `md`.
	// Fails when a length runs past the end of the block.
	def flacParseComments(body byte[], md FlacMetadata) !none {
		expects {
			assert body.len() >= 8 onerror fail "flac: truncated Vorbis comment"
		}
		let vendorLen = flacLE32(body, 0)
		fail "flac: truncated Vorbis comment" when 4 + vendorLen + 4 > body.len()
		md.vendor = string(body[4:4 + vendorLen])
		let at = 4 + vendorLen
		let count = flacLE32(body, at)
		at += 4
		for let i = 0; i < count; i++ {
			fail "flac: truncated Vorbis comment" when at + 4 > body.len()
			let n = flacLE32(body, at)
			at += 4
			fail "flac: truncated Vorbis comment" when at + n > body.len()
			let field = string(body[at:at + n])
			at += n
			let eq = field.indexOf("=")
			continue when eq <= 0
			let key = field[0:eq].upper()
			let value = field[eq + 1:]
			let values = md.tags.get(key)
			if values is none {
				md.tags.set(key, string[value])
			} else {
				values.push(value)
				md.tags.set(key, values)
			}
		}
		return none
	}

	// Parses a PICTURE block.
	// Fails when a length runs past the end of the block.
	def flacParsePicture(body byte[]) !FlacPicture {
		expects {
			assert body.len() >= 32 onerror fail "flac: truncated picture"
		}
		let kind = flacBE(body, 0, 4)
		let at = 4
		let mimeLen = flacBE(body, at, 4)
		at += 4
		fail "flac: truncated picture" when at + mimeLen + 4 > body.len()
		let mime = string(body[at:at + mimeLen])
		at += mimeLen
		let descLen = flacBE(body, at, 4)
		at += 4
		fail "flac: truncated picture" when at + descLen + 20 > body.len()
		let desc = string(body[at:at + descLen])
		at += descLen
		let pic = FlacPicture{
			kind: kind <= 20 ?? (FlacPictureKind(kind), FlacPictureKind.Other),
			mimeType: mime,
			description: desc,
			width: flacBE(body, at, 4),
			height: flacBE(body, at + 4, 4),
			depth: flacBE(body, at + 8, 4),
			colors: flacBE(body, at + 12, 4)
		}
		let dataLen = flacBE(body, at + 16, 4)
		at += 20
		fail "flac: truncated picture" when at + dataLen > body.len()
		pic.data = body[at:at + dataLen].clone()
		return pic
	}

	// Reads the marker and the metadata blocks, up to the first audio frame
	// or, unless `full`, up to the end of STREAMINFO. Returns the metadata,
	// the seek table as (sample, byte offset from the first frame) pairs, and
	// the number of bytes consumed.
	// Fails when the data is not FLAC, a block is damaged, or the reader fails.
	def flacReadMetadata(r io.Reader, full bool) !(FlacMetadata, int[], int) {
		let consumed = try flacReadMarker(r)
		let md = FlacMetadata{tags: new map<string, string[]>()}
		let seekTable int[]
		let head byte[]
		head.len(4)
		let first = true
		for {
			fail "flac: truncated metadata" when (try io.readFull(r, head)) != 4
			let last = (head[0] & 0x80) != 0
			let kind = int(head[0] & 0x7F)
			let size = flacBE(head, 1, 3)
			fail "flac: the first metadata block is not STREAMINFO" when first && kind != flacStreamInfo
			fail "flac: invalid metadata block" when kind == 127
			first = false
			let body byte[]
			body.len(size)
			fail "flac: truncated metadata" when (try io.readFull(r, body)) != size
			consumed += 4 + size
			if kind == flacStreamInfo {
				try flacParseStreamInfo(body, md)
				break unless full
			} else if kind == flacVorbisComment {
				try flacParseComments(body, md)
			} else if kind == flacPicture {
				md.pictures.push(try flacParsePicture(body))
			} else if kind == flacSeekTable {
				for let at = 0; at + 18 <= size; at += 18 {
					let sample = flacBE(body, at, 8)
					// Placeholder points carry all ones.
					continue when sample == -1
					seekTable.push(sample, flacBE(body, at + 8, 8))
				}
			}
			break when last
		}
		return (md, seekTable, consumed)
	}
}
