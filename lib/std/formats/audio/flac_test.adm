partial module std.formats.audio {
	use (
		std.io
		std.os
		std.math
		std.bytes
		std.testing
		std.data.encoding
		std.formats.audio.flac::*
		std.formats.audio.seek::*
	)

	// An in-memory stream of interleaved samples that hands out at most 1000
	// frames per read, the encoder's input in the tests.
	internal type FlacTestSource {
		// The frame the next read starts at.
		internal framePosition uint64

		internal samples float32[]
		internal desc    AudioInfo
		internal pos     int

		// Streams `samples`, described by `desc`.
		def new(samples float32[], desc AudioInfo) {
			self.samples = samples
			self.desc = desc
			pos = 0
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return desc
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream; it cannot fail.
		internal def readFrames(buf float32[]) !int {
			let channels = int(desc.channels)
			let n = samples.len() / channels - pos
			n = buf.len() / channels when n > buf.len() / channels
			n = 1000 when n > 1000
			for let i = 0; i < n * channels; i++ {
				buf[i] = samples[pos * channels + i]
			}
			pos += n
			return n
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream; it cannot fail.
		internal def seekFrame(frame uint64) !none {
			pos = int(frame)
			return none
		}

		// close implements io.Closer; it cannot fail.
		def close() !none {
			return none
		}
	}

	// A reader that cannot seek, handing out at most 777 bytes per read.
	internal type FlacTestReader {
		internal data byte[]
		internal pos  int

		// Reads `data`.
		def new(data byte[]) {
			self.data = data
			pos = 0
		}

		// read implements io.Reader; it cannot fail.
		def read(buf byte[]) !int {
			let n = data.len() - pos
			n = buf.len() when n > buf.len()
			n = 777 when n > 777
			for let i = 0; i < n; i++ {
				buf[i] = data[pos + i]
			}
			pos += n
			return n
		}
	}

	check "FLAC" {
		// Sample files live in the repo, and `adm test` runs from its root. A
		// missing sample skips rather than fails.
		let sampleDir = "samples/audio/flac/"

		// Whether the sample file exists.
		internal def present(path string) bool {
			let there = os.exists(path) onerror recover false
			return there
		}

		// A test signal of `frames` frames at `bits` bits: a tone with noise,
		// then silence, then a stretch whose low bits are all zero, then loud
		// noise, so every subframe type turns up.
		internal def signal(frames int, channels int, bits int) float32[] {
			let out float32[]
			out.len(frames * channels)
			let full = 1 << (bits - 1)
			let seed = 12345
			for let i = 0; i < frames; i++ {
				for let c = 0; c < channels; c++ {
					seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
					let noise = (seed >> 8) % 64 - 32
					let v = int(0.6 * float(full) * math.sin(float(i) * (0.01 + 0.003 * float(c)))) + noise * (full >> 12)
					let phase = (i * 5) / frames
					if phase == 1 {
						v = 0
					} else if phase == 2 {
						v = (v >> 3) << 3
					} else if phase == 4 {
						v = (seed % (2 * full)) - full
					}
					v = full - 1 when v > full - 1
					v = -full when v < -full
					out[i * channels + c] = float32(float(v) / float(full))
				}
			}
			return out
		}

		// The description of a test signal.
		internal def describe(channels int, bits int, frames int) AudioInfo {
			return AudioInfo{
				sampleRate: 44100,
				channels: uint16(channels),
				bitDepth: uint16(bits),
				format: flacSampleFormat(bits),
				frames: uint64(frames),
				codec: "test"
			}
		}

		// Every frame of the stream.
		internal def drainAll(stream AudioStream) !float32[] {
			let channels = int(stream.info().channels)
			let out float32[]
			let buf float32[]
			buf.len(3000 * channels)
			for {
				let n = try stream.read(buf)
				break when n == 0
				for let i = 0; i < n * channels; i++ {
					out.push(buf[i])
				}
			}
			return out
		}

		// Encodes a test signal and checks it decodes to the same samples.
		internal def roundTrip(channels int, bits int, level int, block int, frames int) !none {
			let samples = signal(frames, channels, bits)
			let codec = new FLAC()
			codec.compression = level
			codec.blockSize = block
			codec.verify = true
			let data = try codec.encode(new FlacTestSource(samples, describe(channels, bits, frames)))
			let stream = try codec.open(data)
			let info = stream.info()
			assert int(info.channels) == channels
			assert int(info.bitDepth) == bits
			assert int(info.frames) == frames
			assert info.sampleRate == 44100
			assert info.codec == "flac"
			assert info.seekable
			let back = try drainAll(stream)
			assert back.len() == samples.len()
			for let i = 0; i < samples.len(); i++ {
				fail "sample {i} differs: {back[i]} != {samples[i]}" when back[i] != samples[i]
			}
			return none
		}

		@test()
		def TestRoundTrip() !none {
			try roundTrip(1, 16, 5, 4096, 10000)
			try roundTrip(2, 16, 0, 1152, 5000)
			try roundTrip(2, 16, 2, 4096, 9000)
			try roundTrip(2, 24, 8, 4096, 9000)
			try roundTrip(1, 8, 3, 576, 3001)
			try roundTrip(3, 20, 6, 1000, 2500)
			try roundTrip(2, 12, 4, 192, 1000)
			try roundTrip(2, 16, 5, 4096, 100)
			try roundTrip(1, 4, 1, 256, 700)
			return none
		}

		@test()
		def TestEncodesFloatAt24Bits() !none {
			let samples = signal(3000, 2, 24)
			let desc = describe(2, 32, 3000)
			desc.format = SampleFormat.Float32
			let codec = new FLAC()
			let data = try codec.encode(new FlacTestSource(samples, desc))
			let stream = try codec.open(data)
			assert int(stream.info().bitDepth) == 24
			let back = try drainAll(stream)
			for let i = 0; i < samples.len(); i++ {
				fail "sample {i} differs" when back[i] != samples[i]
			}
			return none
		}

		@test()
		def TestEmptyStream() !none {
			let codec = new FLAC()
			let samples float32[]
			let data = try codec.encode(new FlacTestSource(samples, describe(2, 16, 0)))
			let stream = try codec.open(data)
			assert int(stream.info().frames) == 0
			let back = try drainAll(stream)
			assert back.len() == 0
			return none
		}

		@test()
		def TestTagsAndPictures() !none {
			let codec = new FLAC()
			codec.tags.set("TITLE", string["Tone"])
			codec.tags.set("artist", string["Ann", "Bo"])
			codec.pictures.push(FlacPicture{
				kind: FlacPictureKind.BackCover,
				mimeType: "image/png",
				description: "cover",
				width: 2,
				height: 3,
				depth: 24,
				data: byte[1, 2, 3, 4]
			})
			let data = try codec.encode(new FlacTestSource(signal(500, 1, 16), describe(1, 16, 500)))
			let md = try codec.metadata(new bytes.Reader(data))
			assert new FLAC().tags.len() == 0
			assert md.vendor == flacVendor
			let title = md.tags.get("TITLE")
			fail "no title" when title is none
			assert title.join("|") == "Tone"
			let artist = md.tags.get("ARTIST")
			fail "no artist" when artist is none
			assert artist.join("|") == "Ann|Bo"
			assert md.pictures.len() == 1
			let pic = md.pictures[0]
			assert pic.kind == FlacPictureKind.BackCover
			assert pic.mimeType == "image/png"
			assert pic.description == "cover"
			assert pic.width == 2 && pic.height == 3 && pic.depth == 24
			assert pic.data.len() == 4 && pic.data[3] == 4
			assert md.minBlockSize == 4096 && md.maxBlockSize == 4096
			assert !flacIsZero(md.md5)
			return none
		}

		@test()
		def TestDamagedFrameFails() !none {
			let codec = new FLAC()
			let data = try codec.encode(new FlacTestSource(signal(20000, 2, 16), describe(2, 16, 20000)))
			let damaged = data.clone()
			damaged[data.len() / 2] = damaged[data.len() / 2] ^ 0x10
			let failed = false
			let stream = try codec.open(damaged)
			drainAll(stream) onerror (err error) {
				failed = true
				recover float32[]
			}
			assert failed

			let truncated = data[0:data.len() - 100].clone()
			failed = false
			let cut = try codec.open(truncated)
			drainAll(cut) onerror (err error) {
				failed = true
				assert err.message.contains("truncated")
				recover float32[]
			}
			assert failed

			let garbage = codec.open(byte[1, 2, 3, 4, 5, 6, 7, 8])
			assert garbage is error
			return none
		}

		@test()
		def TestVerifyCatchesWrongMD5() !none {
			let codec = new FLAC()
			let data = try codec.encode(new FlacTestSource(signal(5000, 1, 16), describe(1, 16, 5000)))
			// STREAMINFO's MD5 starts 26 bytes into its body.
			data[8 + 26] = data[8 + 26] ^ 0xFF
			let plain = try drainAll(try codec.open(data))
			assert plain.len() == 5000
			codec.verify = true
			let failed = false
			drainAll(try codec.open(data)) onerror (err error) {
				failed = true
				assert err.message.contains("MD5")
				recover float32[]
			}
			assert failed
			return none
		}

		// Seeks through an encoded signal, with a seek table every
		// `interval` or, at 0s, by searching the frame headers.
		internal def seekEncoded(interval duration) !none {
			let samples = signal(30000, 2, 16)
			let codec = new FLAC()
			codec.blockSize = 1024
			codec.seekInterval = interval
			let data = try codec.encode(new FlacTestSource(samples, describe(2, 16, 30000)))
			let stream = try codec.open(data)
			let buf float32[]
			buf.len(8)
			for let (_, target) in int[25000, 3, 1024, 29999, 0, 17777] {
				try stream.seek(uint64(target))
				let n = try stream.read(buf)
				assert n >= 1
				assert buf[0] == samples[target * 2]
				assert buf[1] == samples[target * 2 + 1]
			}
			try stream.seek(30000)
			assert (try stream.read(buf)) == 0

			// A reader that cannot seek moves forward only.
			let forward = try codec.open(new FlacTestReader(data))
			assert !forward.info().seekable
			try forward.seek(20000)
			assert (try forward.read(buf)) >= 1
			assert buf[0] == samples[40000]
			let failed = false
			forward.seek(10) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			return none
		}

		@test()
		def TestSeekInEncoded() !none {
			try seekEncoded(100ms)
			try seekEncoded(0s)
			return none
		}

		@test()
		def TestRegistry() !none {
			let samples = signal(2000, 2, 16)
			let data = try new FLAC().encode(new FlacTestSource(samples, describe(2, 16, 2000)))
			let stream = try open(data)
			assert stream.info().codec == "flac"
			let decoded = try load(data)
			assert decoded.samples.len() == samples.len()
			let out = new bytes.Buffer()
			try write(try open(data), out, ".flac")
			let codec = new FLAC()
			assert codec.matchSignature(new bytes.Reader(data))
			assert !codec.matchSignature(new bytes.Reader(byte[0x66, 0x4C, 0x61, 0x44, 0]))
			// An ID3v2 tag in front of the marker is skipped.
			let tagged = byte[0x49, 0x44, 0x33, 4, 0, 0, 0, 0, 0, 3, 7, 7, 7] + data
			assert codec.matchSignature(new bytes.Reader(tagged))
			let fromTagged = try load(tagged)
			assert fromTagged.samples.len() == samples.len()
			let written = try codec.metadata(new bytes.Reader(out.bytes()))
			assert written.maxBlockSize == 4096
			let again = try load(out.bytes())
			for let i = 0; i < samples.len(); i++ {
				fail "sample {i} differs" when again.samples[i] != samples[i]
			}
			return none
		}

		// Decodes a sample with its MD5 checked, which the ffmpeg decode of
		// every sample matches, so passing means bit-exact output.
		internal def decodeSample(name string, rate int, channels int, bits int, frames int) !none {
			return none unless present(sampleDir + name)
			let codec = new FLAC()
			codec.verify = true
			let stream = try codec.open(sampleDir + name)
			defer stream.close()
			let info = stream.info()
			assert int(info.sampleRate) == rate
			assert int(info.channels) == channels
			assert int(info.bitDepth) == bits
			assert int(info.frames) == frames
			let buf float32[]
			buf.len(8192 * channels)
			let total = 0
			for {
				let n = try stream.read(buf)
				break when n == 0
				total += n
			}
			assert total == frames
			return none
		}

		@test()
		def TestDecodeSamples() !none {
			try decodeSample("flac_5s_sample_file_185KB.flac", 44100, 1, 24, 220500)
			try decodeSample("flac_15s_sample_file_566KB.flac", 44100, 1, 24, 661500)
			try decodeSample("flac_30s_sample_file_1.1MB.flac", 44100, 1, 24, 1323000)
			try decodeSample("flac_60s_sample_file_2.2MB.flac", 44100, 1, 24, 2646000)
			try decodeSample("sample-file-1.flac", 44100, 2, 16, 13230000)
			try decodeSample("sample-file-2.flac", 44100, 2, 16, 5298637)
			try decodeSample("sample-file-3.flac", 44100, 2, 16, 2642220)
			try decodeSample("sample-file-4.flac", 44100, 2, 16, 869400)
			return none
		}

		// 240 frames of 32-bit stereo, mid/side coded, written by ffmpeg.
		internal def deepSample() !byte[] {
			return encoding.base64decode(
				"ZkxhQwAAACIAQABAAAFUAAGjAfQD8AAAAPAi2ME78WI6/U6jIiRdMxsRhAAALg0AAABMYXZm" +
				"NjIuMTIuMTAyAQAAABUAAABlbmNvZGVyPUxhdmY2Mi4xMi4xMDL/+GSOAD8oT4AAAAAE4EzI" +
				"EloAADGSAABxHmYA44gAAZPDMgJhTMxyzDxfHjlBpWSLT0DA0399UKLCq+x/KK6dPrVWWgIS" +
				"eNHpjHS+W4S6jdDAOaKKoI3KtygHZJ4klXc8KzVlpMJ+hFiqV7a9l1sf1OrmNKYWw3qHuurR" +
				"5PEbqLSJms8wzvDLVPK2s4mmp2Xzaoj/FYfn9IIqQVMsb5CwIca6CIpgy7stBaA3rSoVuNPo" +
				"ompiuoENLVYraDilDAbaGiq3HUiz3hFdo6mSytM6YAAAAAP/5QAB/+mAAP/1Mzh//UzMAAGT" +
				"NAACszMOYxtoMio8dyuFDgLx+R0JOW4yKd9GZ5pyT0GHnJc2lMm8aFoeH/IstMK9hIgJ+z5Y" +
				"2SuVJI1mDpKwRSHp3WxDuQjph0f4ZkXryrSpPMlCp8hS92b3zvWHhga0MyWU7RFD85f9GRfY" +
				"SUWJbjp+tQkNRa4i87X7p9KY2JyveuUbdzBYiq19xKy8Q9K1uQXrIiVB0cEEjq78X5YFIFr5" +
				"gkAUZP/4ZK4BP35O/HMAA/fzczT0avM48kWACPHEWaDy9lmg9bhmaPmzpmTlmGO+znC7TdkT" +
				"DoVho377oUFMMyPLNUef0Qm3ZyLEPbItRLSY12xVNS/ueRQUQ8JE8bWpIjfVrlvq4JfYkyYl" +
				"PY0/8RrE4haFjDB6MFuFqUxly04PbQzVrrFy0P7nu2TERVzNt5GXZKdOeV79rLos1mhecLmg" +
				"QcHMwUgJgxPExdR7Fu1gra/l3hfbJK8nse4kF0pnuBxNw2yBhWtxz7Owm6tLM1fyhRoRjlxQ" +
				"CP+jJwDfpmWAYNzNACLRmQAIRMyH/urNA/zXzMH9Q8zQ/jSMzHMYTUTKSye3fFxnedCrH3sQ" +
				"n1vs2eRV6t00YYE4/w/d5nKb8ktnF3CFlVSfWUc5S4R48a/v7YnLZ1ir45vL9Kbg4zLqPteG" +
				"NKTRJTtiCgVs7emi3G+WCM01t1Sxo3zDK0kvNQwNgv+idHp2W1SaYZsguYQ7dRvsL/IIgHcj" +
				"YaWKobhnZHEKPZYF7Q+peveq+6WTldlYeV4zqi2Bhe1iDeSWmm/romH/+GSuAj9BTga3czAK" +
				"eKZgDPj/+A3rGZANM3/4Cug/+AdPjMwC2BmZ5jCNgF7UTr755C1pYum+IqFDkEBn1PFIAAa4" +
				"Kg86PNmC+jHMAET1qO35wa5q48LbxMCqmPeixSd1tujVY/cjQqJ0VMTRJ1iBwXvp+y6lu9Yw" +
				"Nkp6zBkfPfZwdBCY3W8hwcgidFiNW91dbzIwXqv1lr2KMmwu/OEU2cYF8nBObZXi4HBOU0+K" +
				"ZyU/mwhowbDZnuHQMqJGZc6Gtl6M8hbRKvC5u3rOaNKU0vtZ1gH0783MAAfs8gAD+rLM4f/P" +
				"ZmABKszIASdszADLvM0Adh//7mL5WPJIfzkihdb49gzj8joUqDTduHb/wYKkdCt6g6sGLLdS" +
				"E63qtLZq7ROpW42vYZwzvkjEgsNiUwzfniNKibAIiDpeVsAFRF7VQ0zez/Fmok3Ac5/ftaZI" +
				"I4t16ctxurN157livWKLkWAQOGD6ohJe1xISrcDCmhHRLh4NsJS2Y19dTNfVqstStJuINHaE" +
				"OpAUxGemMJ5KM0GsxRQJEnSgRioaTJkYt0WvNf/4ZK4DLyRO9taZnPQSTNDyvEzQ8vvAAPTJ" +
				"5mj37gzO/AfmaQCZczTmLy2M5J2DUFDZLuchXP7woVIevEa5nsuGNLV0sosVg0dAFR1bLbmw" +
				"3r0CkVagtfRHWK6zxqUMJgj5E9cnSoZu/lj30OHsjwOfXsVvCp0yCUFuI3K9Kn1mdsDKLuoI" +
				"SE8WWtBPrppn4IMmMHeb35GS9Kc1Bn528Wj3Lrng4bJ3iE9FNhOA90ZnAE0QAAAKaAAH9l4A" +
				"A/RFmaH3WuZk+sozN31CrM45i88huzEEt+5pw3Mgm++byFZNG+QCEsvf8Ika1p8V+RdoDi5v" +
				"Zl8z1W/n5J2uqBj3WWEwkSmNlEuAk9BHtzI3Zs23QFEMk0hpzo+XNXcVEgMS09AXi5k5CFxi" +
				"fMGMh6QKwengKVXH75hBlJHji5sHkbneuWIaC8vADQKEHgQvOtbSJWC2iLQ="
			)
		}

		@test()
		def TestDecodes32Bit() !none {
			let codec = new FLAC()
			codec.verify = true
			let stream = try codec.open(try deepSample())
			let info = stream.info()
			assert int(info.bitDepth) == 32
			assert info.format == SampleFormat.Int32
			assert int(info.frames) == 240
			let back = try drainAll(stream)
			assert back.len() == 480
			return none
		}

		@test()
		def TestSampleTags() !none {
			let path = sampleDir + "sample-file-3.flac"
			return none unless present(path)
			let md = try new FLAC().metadata(path)
			let title = md.tags.get("TITLE")
			fail "no title" when title is none
			assert title[0] == "The Happy Meeting"
			let genre = md.tags.get("GENRE")
			fail "no genre" when genre is none
			assert genre[0] == "Ambient"
			assert md.maxBlockSize == 4096
			assert md.info.frames == 2642220
			let info = try info(path)
			assert info.codec == "flac"
			return none
		}

		// Checks the sample at `frame` against ffmpeg's decode, in steps of the
		// sample's full scale.
		internal def expectAt(stream AudioStream, frame int, want int[], bits int) !none {
			try stream.seek(uint64(frame))
			let channels = int(stream.info().channels)
			let buf float32[]
			buf.len(channels * 4)
			assert (try stream.read(buf)) >= 1
			let full = float(1 << (bits - 1))
			for let c = 0; c < channels; c++ {
				let got = int(float(buf[c]) * full)
				fail "frame {frame} channel {c}: {got} != {want[c]}" when got != want[c]
			}
			return none
		}

		@test()
		def TestSeekSamples() !none {
			let mono = sampleDir + "flac_60s_sample_file_2.2MB.flac"
			return none unless present(mono)
			let s = try new FLAC().open(mono)
			defer s.close()
			assert s.info().seekable
			try expectAt(s, 1234567, int[-374054], 24)
			try expectAt(s, 1000, int[-1351], 24)
			try expectAt(s, 2645999, int[-1], 24)
			try expectAt(s, 4609, int[-3992], 24)
			try expectAt(s, 1234568, int[-385207], 24)

			let stereo = sampleDir + "sample-file-3.flac"
			return none unless present(stereo)
			let data = try os.readFile(stereo)
			let t = try new FLAC().open(data)
			try expectAt(t, 2000000, int[146, -3516], 16)
			try expectAt(t, 77, int[4, 11], 16)
			try expectAt(t, 2642219, int[-693, -594], 16)
			try expectAt(t, 2000001, int[623, -3655], 16)
			return none
		}
	}
}
