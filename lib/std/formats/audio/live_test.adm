partial module std.formats.audio {
	use (
		std.io
		std.bytes
		std.math
		std.testing
	)

	// A reader handing out its bytes a few at a time, the way a network
	// connection does, and not seekable.
	internal type LiveTestReader {
		internal data  byte[]
		internal at    int
		internal slice int

		def new(data byte[], slice int) {
			self.data = data
			self.slice = slice
		}

		// Does not fail.
		def read(buf byte[]) !int {
			let n = (data.len() - at).min(buf.len()).min(slice)
			data[at:at + n].copy(buf) when n > 0
			at += n
			return n
		}
	}

	check "Live streams" {
		// `seconds` of a stereo tone at 48 kHz, 440 Hz left and 660 Hz right.
		def tone(seconds int) PCM {
			let frames = 48000 * seconds
			let samples float32[]
			samples.len(frames * 2)
			for let i = 0; i < frames; i++ {
				samples[i * 2] = float32(0.4 * math.sin(2.0 * math.Pi * 440.0 * float(i) / 48000.0))
				samples[i * 2 + 1] = float32(0.4 * math.sin(2.0 * math.Pi * 660.0 * float(i) / 48000.0))
			}
			let info = AudioInfo{sampleRate: 48000, channels: 2, bitDepth: 32, format: SampleFormat.Float32, frames: uint64(frames)}
			let pcm = new PCM()
			pcm.info = info
			pcm.samples = samples
			return pcm
		}

		// Every sample of the stream.
		// Fails when reading does.
		def decodeAll(stream AudioStream) !float32[] {
			let out float32[]
			let buf float32[]
			buf.len(1000 * int(stream.info().channels))
			for {
				let got = try stream.read(buf)
				break when got == 0
				out = out + buf[:got * int(stream.info().channels)]
			}
			return out
		}

		// Whether decoding `encoded` live, a few bytes per read, gives the
		// samples decoding it whole does, and the live stream refuses to seek.
		// A live stream that does not know where it started cannot trim the
		// encoder's padding at the end: up to `padding` more frames may follow.
		// Fails when opening or decoding does.
		def matchesWhole(codec AudioFormat, encoded byte[], padding int = 0) !bool {
			let whole = try decodeAll(try codec.open(new bytes.Reader(encoded)))
			let stream = try codec.open(new LiveTestReader(encoded, 333), live = true)
			return false when stream.info().seekable
			let live = try decodeAll(stream)
			let refused = false
			stream.seek(0s) onerror (err error) {
				refused = true
				recover none
			}
			return false when whole.len() == 0 || live.len() < whole.len() || live.len() > whole.len() + padding * 2
			for let i = 0; i < whole.len(); i++ {
				return false when live[i] != whole[i]
			}
			return refused
		}

		// `pcm` encoded by `codec`.
		// Fails when encoding does.
		def encode(codec AudioEncoder, pcm PCM) !byte[] {
			let out = new bytes.Buffer()
			try codec.encode(pcm.stream(), out)
			return out.bytes()
		}

		@test()
		def TestMp3LiveMatchesWholeFile() !none {
			// Past the frames a live stream decodes before dropping them.
			let codec = new MP3()
			assert try matchesWhole(codec, try encode(codec, tone(8)))
		}

		@test()
		def TestAacLiveMatchesWholeFile() !none {
			let codec = new AAC()
			assert try matchesWhole(codec, try encode(codec, tone(2)))
		}

		@test()
		def TestVorbisLiveMatchesWholeFile() !none {
			let codec = new Vorbis()
			assert try matchesWhole(codec, try encode(codec, tone(2)))
		}

		@test()
		def TestOpusLiveMatchesWholeFile() !none {
			let codec = new Opus()
			assert try matchesWhole(codec, try encode(codec, tone(2)), padding = 960)
		}

		@test()
		def TestLiveThroughTheRegistry() !none {
			let encoded = try encode(new MP3(), tone(1))
			let stream = try open(new LiveTestReader(encoded, 1000), live = true)
			assert stream.info().codec == "mp3"
			assert !stream.info().seekable
		}

		@test()
		def TestWholeFileCodecsRefuseLive() !none {
			let encoded = try encode(new WAV(), tone(1))
			let failed = false
			open(new bytes.Reader(encoded), live = true) onerror (err error) {
				failed = true
				recover new PCM().stream()
			}
			assert failed
		}
	}
}
