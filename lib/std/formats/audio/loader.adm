partial module std.formats.audio {
	use (
		std.reflection
		std.formats
		std.bytes
		std.os
		std.io
		std.formats.audio.loader::*
	)

	// AudioCodec is what an audio format registers: the format's decoder, its
	// encoder and its file format description.
	type AudioCodec = AudioFormat & AudioEncoder & formats.FileFormat

	// codec registers a type as the audio codec of the named format, found
	// through discovery.
	meta def codec<AudioCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	// Opens a lazy stream over any supported audio file, picking the codec by
	// signature. The stream decodes as it is read, so this stays cheap on a
	// large file. `live` opens a stream with no end, such as internet radio,
	// as `AudioFormat.open` describes: it cannot seek.
	// Fails when no codec recognises the stream, the codec cannot decode a
	// live stream, or opening it does.
	def open(reader io.Reader, live bool = false) !AudioStream {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.open(r, live)
	}

	// open returns a stream decoding the audio in the bytes, through the codec
	// that recognises them. Fails when none does, or opening does.
	def open(data byte[]) !AudioStream {
		let (dec, _) = try codecRegistry.probe(data)
		// A reader over the bytes themselves, rather than the probe's
		// rewindable one, lets the codec seek.
		return dec.open(new bytes.Reader(data))
	}

	// open returns a stream decoding the audio file at path, through the codec
	// that recognises it. The stream owns the file: closing the stream closes
	// it.
	//
	// Fails when the file cannot be opened, no codec recognises it, or opening
	// the stream does.
	def open(path string) !AudioStream {
		let f = try os.open(path)
		let (dec, _) = codecRegistry.probe(f) onerror (err error) {
			f.close() onerror recover none
			fail err
		}
		// The probe read through a rewindable wrapper; back at the start, the
		// file itself goes to the codec, which can then seek in it.
		f.seek(int64(0)) onerror (err error) {
			f.close() onerror recover none
			fail err
		}
		let stream = dec.open(f) onerror (err error) {
			f.close() onerror recover none
			fail err
		}
		return new FileAudioStream(stream, f)
	}

	// Reads what the headers say without building a decoder for the whole file.
	// Fails when no codec recognises the stream, or reading its headers does.
	def info(reader io.Reader) !AudioInfo {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.info(r)
	}

	// info reads the file's headers through the codec that recognises them. Fails
	// when the file cannot be opened, no codec recognises it, or reading the
	// headers does.
	def info(path string) !AudioInfo {
		let f = try os.open(path)
		defer f.close()

		let (dec, r) = try codecRegistry.probe(f)
		return dec.info(r)
	}

	// Decodes an entire file into memory.
	//
	// An hour of 48kHz stereo is over a gigabyte, so prefer `open` for anything
	// long. Draining a stream is the same loop for every format, so it lives
	// here once rather than in each codec.
	// Fails when no codec recognises the stream, or decoding does.
	def load(reader io.Reader) !Audio {
		let stream = try open(reader)
		defer stream.close()
		return drain(stream)
	}

	// load decodes the whole audio held in the bytes. Fails when no codec
	// recognises them, or decoding does.
	def load(data byte[]) !Audio {
		let stream = try open(data)
		defer stream.close()
		return drain(stream)
	}

	// load decodes the whole audio file at path. Fails when the file cannot be
	// opened, no codec recognises it, or decoding does.
	def load(path string) !Audio {
		let stream = try open(path)
		defer stream.close()
		return drain(stream)
	}

	// save encodes the stream with the codec registered for the path's
	// extension and writes the file. Fails when no codec has the extension,
	// encoding fails, or the file cannot be written.
	def save(stream AudioStream, path string) !none {
		let out = new bytes.Buffer()
		try write(stream, out, os.extension(path))
		return os.writeFile(path, out.bytes())
	}

	// write encodes the stream to the writer with the codec registered for the
	// file extension (".wav", ".flac"). Fails when no codec has the extension,
	// or encoding or the writer does.
	def write(stream AudioStream, writer io.Writer, extension string) !none {
		let enc = codecRegistry.matchExt(extension)
		fail "no audio codec has the extension \"{extension}\"" when enc is none
		return enc.encode(stream, writer)
	}
}

internal partial module std.formats.audio.loader {
	use (
		std.formats
		std.os
		std.formats.audio::*
	)

	let codecRegistry = new formats.CodecRegistry<AudioCodec>("audio", codec)

	// Every frame left in the stream, with the stream's description; `frames`
	// and `length` are what was actually read.
	def drain(stream AudioStream) !Audio {
		let info = stream.info()
		let channels = int(info.channels)
		fail "audio: the stream has no channels" when channels <= 0
		let samples float32[]
		let buf float32[]
		buf.len(DRAIN_CHUNK_FRAMES * channels)
		for {
			let frames = try stream.read(buf)
			break when frames == 0
			for let i = 0; i < frames * channels; i++ {
				samples.push(buf[i])
			}
		}
		info.frames = uint64(samples.len() / channels)
		info.length = info.sampleRate == 0 ?? (0s, duration(int64(info.frames) * 1000000000 / int64(info.sampleRate)))
		return Audio{info: info, samples: samples}
	}

	// A codec's stream over a file the loader opened. Some codecs read the
	// whole file up front and keep no reader, so the file is closed here, after
	// the codec's stream, rather than left to the codec.
	type FileAudioStream {
		stream AudioStream
		file   os.File

		def new(stream AudioStream, file os.File) {
			self.stream = stream
			self.file = file
		}

		def info() AudioInfo {
			return stream.info()
		}

		// Fails as the codec's stream does.
		def read(buf float32[]) !int {
			return stream.read(buf)
		}

		// Fails as the codec's stream does.
		def seek(frame uint64) !none {
			return stream.seek(frame)
		}

		// Fails as the codec's stream does.
		def seek(time duration) !none {
			return stream.seek(time)
		}

		// Fails as the codec's stream does.
		def skip(offset duration) !none {
			return stream.skip(offset)
		}

		def position() uint64 {
			return stream.position()
		}

		// Closes the codec's stream, then the file, even when the first fails.
		//
		// Fails when closing either does.
		def close() !none {
			stream.close() onerror (err error) {
				file.close() onerror recover none
				fail err
			}
			return file.close()
		}
	}

	// Frames read per pass while loading a whole stream.
	const DRAIN_CHUNK_FRAMES = 8192
}
