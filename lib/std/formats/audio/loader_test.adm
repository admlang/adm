partial module std.formats.audio {
	use (
		std.os
		std.testing
		std.time
	)

	check "Audio loader" {
		// The descriptors the process holds, -1 where the system does not list them.
		def openDescriptors() int {
			let entries = __fs_read_dir("/proc/self/fd") onerror recover []
			return entries.len() == 0 ?? (-1, entries.len())
		}

		// A stream opened by path owns its file: closing it releases the
		// descriptor, even with a codec that reads the file up front and keeps
		// no reader. Counted through the process's open descriptors on Linux.
		@test()
		def TestStreamsOpenedByPathCloseTheirFile() !none {
			let path = "samples/audio/mp3/mp3_5s_sample_file_80KB.mp3"
			return none unless try os.exists(path)
			let before = openDescriptors()
			return none when before < 0
			for let i = 0; i < 20; i++ {
				let stream = try open(path)
				try stream.close()
			}
			assert openDescriptors() <= before
			return none
		}

		// Every format moves by time the same way: `position` counts what was
		// read, `skip` moves from there in both directions and stops at the
		// ends, `seek(time)` goes to a time from the start.
		@test()
		def TestSeekAndSkipByTime() !none {
			let files = [
				"samples/audio/wav/wav_15s_sample_file_1.3MB.wav",
				"samples/audio/aiff/aiff_15s_sample_file_1.3MB.aiff",
				"samples/audio/flac/flac_15s_sample_file_566KB.flac",
				"samples/audio/mp3/mp3_15s_sample_file_236KB.mp3",
				"samples/audio/ogg/ogg_15s_sample_file_30KB.ogg",
				"samples/audio/opus/opus_15s_sample_file_281KB.opus",
				"samples/audio/aac/aac_15s_sample_file_142KB.aac",
				"samples/audio/m4a/m4a_15s_sample_file_141KB.m4a",
				"samples/audio/wma/wma_15s_sample_file_254KB.wma",
			]
			for let (_, path) in files {
				continue unless try os.exists(path)
				let stream = try open(path)
				let rate = uint64(stream.info().sampleRate)
				let channels = int(stream.info().channels)
				let buf float32[]
				buf.len(int(rate) * channels)
				let got = 0
				for got < int(rate) {
					let n = try stream.read(buf[0:(int(rate) - got) * channels])
					break when n == 0
					got += n
				}
				assert stream.position() == rate
				try stream.skip(2s)
				assert stream.position() == 3 * rate
				try stream.skip(-1s)
				assert stream.position() == 2 * rate
				try stream.seek(1s)
				assert stream.position() == rate
				try stream.skip(-1m)
				assert stream.position() == uint64(0)
				try stream.skip(1h)
				let end = stream.info().frames
				assert end == uint64(0) || stream.position() == end
				try stream.close()
			}
			return none
		}

		// save picks the codec from the path's extension, and what it wrote
		// loads back with the same samples.
		@test()
		def TestSaveWritesTheExtensionsFormat() !none {
			let source = "samples/audio/wav/wav_5s_sample_file_431KB.wav"
			return none unless try os.exists(source)
			let path = "/tmp/adm-audio-save-{time.now().unixNs()}.flac"
			let original = try load(source)
			let stream = try open(source)
			try save(stream, path)
			try stream.close()
			let copy = try load(path)
			os.remove(path) onerror recover none
			assert copy.info.codec == "flac"
			assert copy.samples.len() == original.samples.len()
			for let i = 0; i < copy.samples.len(); i += 997 {
				assert (copy.samples[i] - original.samples[i]).abs() < float32(0.0001)
			}

			let refused = false
			save(stream, "/tmp/adm-audio-save.nothing") onerror (err error) {
				refused = true
				recover none
			}
			assert refused
			return none
		}
	}
}
