partial module std.formats.audio {
	use (
		std.io
		std.bytes
		std.formats.audio.aac::*
		std.formats.audio.m4a::*
		std.formats.media.bmff::*
	)

	// The iTunes tags of an M4A file, kept in its `moov/udta/meta/ilst` box.
	// Empty strings and zero numbers are tags the file does not carry.
	struct M4aMetadata {
		// The track title (`©nam`).
		title      string
		// The performer (`©ART`).
		artist     string
		// The album (`©alb`).
		album      string
		// The release date (`©day`), usually just the year: "2024".
		date       string
		// The track's number on its disc and the disc's track count (`trkn`).
		track      int
		trackCount int
		// The cover art (`covr`): the bytes of a JPEG or PNG image.
		cover      byte[]
	}

	// MPEG-4 audio: AAC or Apple Lossless (ALAC) in the ISO base media file
	// format, as `.m4a`, `.m4b` and audio-only `.mp4` files.
	//
	// Opening reads the file into memory and decodes its first audio track
	// lazily, one access unit at a time, honouring the edit list that trims the
	// encoder's priming and padding; fragmented files are read too. Encoding
	// writes one AAC-LC track, `moov` before `mdat`, with the tags in
	// `metadata`.
	//
	// Example: read the tags and length
	// ```example
	// use std.formats.audio
	// use std.os
	//
	// let m4a = new audio.M4A()
	// let info = try m4a.info(try os.readFile("song.m4a"))
	// println("{m4a.metadata.artist} - {m4a.metadata.title}: {info.length}")
	// ```
	@codec("M4A")
	type M4A {
		// Bits per second the encoder aims for.
		bitrate  int         = 128000
		// The tags the last `open` or `info` read, and the ones `encode` writes.
		metadata M4aMetadata

		mimeType string[] {
			def get() string[] {
				return string["audio/mp4", "audio/x-m4a", "audio/x-m4b", "audio/3gpp", "audio/3gpp2"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".m4a", ".m4b", ".mp4", ".3gp", ".3g2"]
			}
		}

		// matchSignature reports whether the reader starts with an `ftyp` box
		// whose major or compatible brands name an MPEG-4 audio file: M4A, M4B,
		// M4P, isom, iso2, mp41, mp42, dash, and the 3GPP brands 3gp4 to 3gp6 and 3g2a.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(12)
			let n = io.readFull(r, head) onerror recover 0
			return false when n != 12
			let box = new BoxReader(head)
			return false when box.u32(4) != boxFtyp
			return true when m4aBrand(box.u32(8))
			let size = box.u32(0)
			return false when size < 16 || size > 4096
			let rest byte[]
			rest.len(size - 12)
			n = io.readFull(r, rest) onerror recover 0
			return false when n != rest.len()
			let brands = new BoxReader(rest)
			for let at = 4; at + 4 <= rest.len(); at += 4 {
				return true when m4aBrand(brands.u32(at))
			}
			return false
		}

		// open reads the whole file and returns a stream decoding its first
		// audio track, and fills `metadata` with its tags.
		//
		// Fails when the reader does, the file is damaged or has no audio track.
		// Fails too when `live` is set: the codec needs the whole file.
		def open(reader io.Reader, live bool = false) !AudioStream {
			fail "m4a: a live stream cannot be decoded" when live
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return open(buf.bytes())
		}

		// open decodes the M4A file held in the bytes.
		//
		// Fails when the file is damaged or has no audio track.
		def open(data byte[]) !AudioStream {
			let file = try parse(data)
			return new M4aStream(file.r, file.track)
		}

		// info reads the description of the first audio track, and fills
		// `metadata`, skipping over the media data rather than keeping it.
		//
		// Fails when the reader does, the file is damaged or has no audio track.
		def info(reader io.Reader) !AudioInfo {
			let file = try parse(try m4aHeaders(reader))
			return file.track.info()
		}

		// info describes the M4A file held in the bytes.
		//
		// Fails when the file is damaged or has no audio track.
		def info(data byte[]) !AudioInfo {
			let file = try parse(data)
			return file.track.info()
		}

		// Reads the file's boxes and takes its tags into `metadata`.
		//
		// Fails when the file is damaged or has no audio track.
		internal def parse(data byte[]) !M4aFile {
			let file = new M4aFile(data)
			try file.read()
			metadata = file.metadata
			return file
		}

		// encode implements AudioEncoder: it encodes the stream to AAC-LC at
		// `bitrate` and writes an M4A file carrying `metadata`.
		//
		// Fails when the stream has no channels or rate, or the stream, the
		// encoder or the writer fails.
		def encode(stream AudioStream, writer io.Writer) !none {
			let source = stream.info()
			let channels = int(source.channels)
			let rate = int(source.sampleRate)
			fail "m4a: the stream has no channels" when channels <= 0
			fail "m4a: the stream has no sample rate" when rate <= 0
			let encoder = new AacEncoder(rate, channels, bitrate)
			let muxer = new M4aMuxer(encoder.sampleRate > 0 ?? (encoder.sampleRate, rate), encoder.channels > 0 ?? (encoder.channels, channels), encoder.config(), aacEncoderDelay)
			let buf float32[]
			buf.len(m4aEncodeChunk * channels)
			let frames = 0
			for {
				let n = try stream.read(buf)
				break when n == 0
				frames += n
				for let (_, unit) in try encoder.encode(buf[:n * channels]) {
					muxer.add(unit)
				}
			}
			for let (_, unit) in try encoder.flush() {
				muxer.add(unit)
			}
			muxer.frames = frames
			return muxer.writeTo(writer, metadata)
		}
	}
}

internal partial module std.formats.audio.m4a {
	use (
		std.io
		std.bytes
		std.formats.audio.aac::*
		std.formats.audio.amr::*
		std.formats.audio.amrwb::*
		std.formats.media.bmff::*
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	// Frames the AAC encoder puts before the first input frame, which the edit
	// list tells players to skip.
	const aacEncoderDelay = 1024

	// Frames of the stream read per pass while encoding.
	const m4aEncodeChunk = 4096

	// Whether an `ftyp` brand names a file that may hold MPEG-4 audio.
	def m4aBrand(brand int) bool {
		return brand := brandM4a || brandM4b || brandM4p || brandIsom || brandIso2 || brandMp41 || brandMp42 || brandDash || brand3gp4 || brand3gp5 || brand3gp6 || brand3g2a
	}

	// The top-level boxes of the file with the media data left out: every box
	// but `mdat` and padding is kept, `mdat` is read past.
	//
	// Fails when the reader does or a box header is damaged.
	def m4aHeaders(reader io.Reader) !byte[] {
		let kept byte[]
		let head byte[]
		head.len(8)
		let scratch byte[]
		scratch.len(65536)
		for {
			let n = try m4aFill(reader, head)
			break when n == 0
			fail "m4a: box header cut short" when n != 8
			let box = new BoxReader(head)
			let size = box.u32(0)
			let kind = box.u32(4)
			let header = 8
			let large byte[]
			if size == 1 {
				large.len(8)
				fail "m4a: box header cut short" when (try io.readFull(reader, large)) != 8
				size = new BoxReader(large).u64(0)
				header = 16
			}
			let skip = kind == boxMdat || kind == boxFree
			if size == 0 {
				break when skip
				let rest = new bytes.Buffer()
				try rest.readFrom(reader)
				size = header + rest.len()
				let w = new BoxWriter()
				w.u32(size)
				w.u32(kind)
				kept.push(...w.out)
				kept.push(...rest.bytes())
				break
			}
			fail "m4a: box of {size} bytes is smaller than its header" when size < header
			let left = size - header
			if skip {
				for left > 0 {
					let want = left < scratch.len() ?? (left, scratch.len())
					let got = try io.readFull(reader, scratch[:want])
					fail "m4a: the file ends inside a box" when got != want
					left -= got
				}
				continue
			}
			kept.push(...head)
			kept.push(...large)
			let body byte[]
			body.len(left)
			fail "m4a: the file ends inside a box" when (try io.readFull(reader, body)) != left
			kept.push(...body)
		}
		return kept
	}

	// Reads until `buf` is full or the stream ends and returns the bytes read.
	//
	// Fails when the reader does.
	def m4aFill(reader io.Reader, buf byte[]) !int {
		let n = 0
		for n < buf.len() {
			let got = try reader.read(buf[n:])
			break when got == 0
			n += got
		}
		return n
	}

	// Decodes the samples of one audio track, in order, through its tables.
	type M4aStream {
		// The frame the next read starts at.
		framePosition uint64

		file       BoxReader
		track      M4aTrack
		decoder    M4aDecoder
		described  AudioInfo
		// The next sample to decode.
		next       int
		// Frames still to drop from the front of what decodes next.
		dropFrames int
		// Frames still to hand out before the end the edit list sets.
		left       int
		// Frames decoded and not yet handed out, from `used` on.
		pending    float32[]
		used       int
		closed     bool
		// The decoder's output rate when it differs from the track's (SBR),
		// else 0.
		outRate    int

		// A stream at the first playable frame of the track.
		def new(file BoxReader, track M4aTrack) {
			self.file = file
			self.track = track
			described = track.info()
			decoder = fresh()
			dropFrames = scaled(track.frames(track.priming))
			left = int(described.frames)
		}

		// A decoder for the track, at its start. The AAC decoder's rate and
		// channels, once it knows them, replace what the sample entry declared;
		// SBR data in the first sample (implicit HE-AAC) doubles the rate.
		def fresh() M4aDecoder {
			return new AlacDecoder(track.config) when track.codec == "alac"
			return new AmrPacketDecoder() when track.codec == "amr"
			return new AmrWbPacketDecoder() when track.codec == "amr-wb"
			let aac = new AacDecoder(track.config)
			if track.count() > 0 {
				let first = track.sample(file, 0) onerror recover byte[]
				aac.probe(first)
			}
			described.channels = uint16(aac.channels) when aac.channels > 0
			if outRate == 0 && aac.sampleRate > 0 && int(described.sampleRate) != aac.sampleRate {
				// The sample entry gave the core rate: the counts follow the
				// output rate.
				outRate = aac.sampleRate
				described.frames = uint64(scaled(int(described.frames)))
				described.sampleRate = uint32(aac.sampleRate)
				described.length = duration(int64(described.frames) * 1000000000 / int64(aac.sampleRate))
			}
			return aac
		}

		// Frames at the track's rate as frames at the decoder's output rate.
		def scaled(frames int) int {
			return frames when outRate == 0 || track.sampleRate == 0
			return int(int64(frames) * int64(outRate) / int64(track.sampleRate))
		}

		// Frames at the decoder's output rate as frames at the track's rate.
		def unscaled(frames int) int {
			return frames when outRate == 0 || track.sampleRate == 0
			return int(int64(frames) * int64(track.sampleRate) / int64(outRate))
		}

		// The track's description.
		def info() AudioInfo {
			return described
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream: it fills `buf` with the next frames,
		// decoding samples as it needs them, and returns the frame count, 0 at
		// the end of the track.
		//
		// Fails when the stream is closed, `buf` does not hold whole frames, or a
		// sample is damaged.
		def readFrames(buf float32[]) !int {
			fail "m4a: the stream is closed" when closed
			let channels = int(described.channels)
			fail "m4a: the track has no channels" when channels <= 0
			fail "m4a: a buffer of {buf.len()} samples does not hold whole frames of {channels} channels" when buf.len() % channels != 0
			let want = buf.len() / channels
			let done = 0
			for done < want && left > 0 {
				if used >= pending.len() {
					break when next >= track.count()
					let unit = try track.sample(file, next)
					next++
					pending = try decoder.decode(unit)
					used = 0
					fail "m4a: sample {next - 1} decoded to {pending.len()} samples, not whole frames of {channels} channels" when pending.len() % channels != 0
					let drop = dropFrames * channels
					drop = pending.len() when drop > pending.len()
					dropFrames -= drop / channels
					used = drop
					continue
				}
				let count = (pending.len() - used) / channels
				count = want - done when count > want - done
				count = left when count > left
				for let i = 0; i < count * channels; i++ {
					buf[done * channels + i] = pending[used + i]
				}
				used += count * channels
				done += count
				left -= count
			}
			return done
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream: the next read starts at `frame`. AAC
		// decoding restarts one sample earlier, whose overlap the frame needs.
		//
		// Fails when the stream is closed or `frame` is past the end.
		def seekFrame(frame uint64) !none {
			fail "m4a: the stream is closed" when closed
			fail "m4a: frame {frame} is past the end at {described.frames}" when frame > described.frames
			let target = track.priming + track.ticks(unscaled(int(frame)))
			let at = track.samples.sampleAt(target)
			let start = at > 0 && track.codec == "aac" ?? (at - 1, at)
			decoder = fresh()
			next = start
			pending = []
			used = 0
			dropFrames = start < track.count() ?? (scaled(track.frames(target - track.samples.times[start])), 0)
			left = int(described.frames - frame)
		}

		// close implements io.Closer: later reads fail.
		//
		// Does not fail.
		def close() !none {
			closed = true
			pending = []
		}
	}
}
