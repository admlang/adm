internal partial module std.formats.audio.m4a {
	// Decodes one sample of an audio track into interleaved frames: what the
	// M4A stream needs from AAC and ALAC alike.
	interface M4aDecoder {
		def decode(unit byte[]) !float32[]
	}

	// Decodes Apple Lossless (ALAC) packets: adaptive Golomb-Rice residuals
	// through an adaptive linear predictor, with stereo decorrelation.
	type AlacDecoder {
		// The ALACSpecificConfig fields.
		frameLength int
		bitDepth    int
		pb          int
		mb          int
		kb          int
		channels    int
		maxRun      int
		// The packet being read and the bit the reader is at.
		data        byte[]
		bit         int

		// A decoder for the 24-byte ALACSpecificConfig.
		def new(config byte[]) {
			return when config.len() < 24
			frameLength = int(config[0]) << 24 | int(config[1]) << 16 | int(config[2]) << 8 | int(config[3])
			bitDepth = int(config[5])
			pb = int(config[6])
			mb = int(config[7])
			kb = int(config[8])
			channels = int(config[9])
			maxRun = int(config[10]) << 8 | int(config[11])
		}

		// decode implements M4aDecoder: one packet into interleaved frames in
		// -1.0..1.0.
		//
		// Fails when the configuration was invalid, or the packet is damaged or
		// uses an element ALAC decoders do not support.
		def decode(unit byte[]) !float32[] {
			fail "m4a: ALAC configuration is invalid" when channels < 1 || frameLength < 1
			fail "m4a: ALAC bit depth {bitDepth} is not 16, 20, 24 or 32" unless bitDepth := 16 || 20 || 24 || 32
			data = unit
			bit = 0
			let out float32[]
			let scale = float64(int64(1) << (bitDepth - 1))
			let channel = 0
			let frames = frameLength
			for {
				fail "m4a: ALAC packet ends without an end element" when bit + 3 > data.len() * 8
				let tag = read(3)
				if tag == 7 {
					break
				}
				if tag := 0 || 3 || 1 {
					let pair = tag == 1
					let (left, right, count) = try element(pair)
					if out.len() == 0 {
						frames = count
						out.len(frames * channels)
					}
					fail "m4a: ALAC elements disagree on the frame count" when count != frames
					fail "m4a: ALAC packet holds more channels than its configuration" when channel + (pair ?? (2, 1)) > channels
					for let i = 0; i < frames; i++ {
						out[i * channels + channel] = float32(float64(left[i]) / scale)
					}
					if pair {
						for let i = 0; i < frames; i++ {
							out[i * channels + channel + 1] = float32(float64(right[i]) / scale)
						}
					}
					channel += pair ?? (2, 1)
				} else if tag == 4 {
					// Data stream element: skipped.
					read(4)
					let aligned = read(1)
					let count = read(8)
					count += read(8) when count == 255
					bit = (bit + 7) / 8 * 8 when aligned == 1
					bit += count * 8
				} else if tag == 6 {
					// Fill element: skipped.
					let count = read(4)
					count += read(8) - 1 when count == 15
					bit += count * 8
				} else {
					fail "m4a: ALAC element {tag} is not supported"
				}
			}
			fail "m4a: ALAC packet holds {channel} channels, its configuration {channels}" when channel != channels
			return out
		}

		// Decodes a single-channel element, or a channel pair when `pair`, and
		// returns the samples of each channel and the frame count.
		//
		// Fails when the element is damaged.
		def element(pair bool) !(int[], int[], int) {
			read(4)
			fail "m4a: ALAC element header is damaged" when read(12) != 0
			let header = read(4)
			let short = header >> 3
			let shifted = (header >> 1) & 3
			let verbatim = header & 1
			let frames = frameLength
			frames = read(32) when short == 1
			fail "m4a: ALAC element of {frames} frames exceeds the frame length {frameLength}" when frames < 1 || frames > frameLength
			let lanes = pair ?? (2, 1)
			let chanBits = bitDepth - shifted * 8 + (pair ?? (1, 0))
			let u int[]
			let v int[]
			let low int[]
			let mixBits = 0
			let mixRes = 0

			if verbatim == 0 {
				mixBits = read(8)
				mixRes = signed(read(8), 8)
				let modes int[]
				let shifts int[]
				let factors int[]
				let coefs int[][]
				for let c = 0; c < lanes; c++ {
					let a = read(8)
					modes.push(a >> 4)
					shifts.push(a & 0x0F)
					let b = read(8)
					factors.push(b >> 5)
					let taps int[]
					for let i = 0; i < b & 0x1F; i++ {
						taps.push(signed(read(16), 16))
					}
					coefs.push(taps)
				}
				let shiftAt = bit
				bit += shifted * 8 * lanes * frames
				for let c = 0; c < lanes; c++ {
					let residual = try residuals(frames, chanBits, pb * factors[c] / 4)
					let predicted = modes[c] == 0 ?? (residual, predict(residual, frames, int[], 31, chanBits, 0))
					let samples = predict(predicted, frames, coefs[c], coefs[c].len(), chanBits, shifts[c])
					if c == 0 {
						u = samples
					} else {
						v = samples
					}
				}
				if shifted > 0 {
					let resume = bit
					bit = shiftAt
					for let i = 0; i < frames * lanes; i++ {
						low.push(read(shifted * 8))
					}
					bit = resume
				}
			} else {
				let width = bitDepth
				u.len(frames)
				v.len(frames)
				for let i = 0; i < frames; i++ {
					u[i] = signed(read(width), width)
					v[i] = signed(read(width), width) when pair
				}
				shifted = 0
			}
			fail "m4a: ALAC element runs past the packet" when bit > data.len() * 8

			let left int[]
			let right int[]
			left.len(frames)
			right.len(pair ?? (frames, 0))
			for let i = 0; i < frames; i++ {
				let l = u[i]
				let r = 0
				if pair {
					r = v[i]
					if mixRes != 0 {
						l = u[i] + v[i] - ((mixRes * v[i]) >> mixBits)
						r = l - v[i]
					}
				}
				if shifted > 0 {
					let s = shifted * 8
					l = (l << s) | low[i * lanes]
					r = (r << s) | low[i * lanes + 1] when pair
				}
				left[i] = l
				right[i] = r when pair
			}
			return (left, right, frames)
		}

		// Reads `count` adaptive Golomb-Rice coded residuals of `chanBits` bits,
		// with the mean's adaptation rate `rate`.
		//
		// Fails when a run of zeros overflows the element.
		def residuals(count int, chanBits int, rate int) !int[] {
			let out int[]
			out.len(count)
			let mean = mb
			let zero = 0
			let c = 0
			for c < count {
				let k = log3(mean >> 9)
				k = kb when k > kb
				let n = golomb((1 << k) - 1, k, chanBits)
				let coded = n + zero
				out[c] = (coded & 1) == 0 ?? ((coded + 1) >> 1, 0 - ((coded + 1) >> 1))
				c++
				mean = rate * (n + zero) + mean - ((rate * mean) >> 9)
				mean = 0xFFFF when n > 0xFFFF
				zero = 0
				if mean << 2 < 512 && c < count {
					zero = 1
					let z = leading(mean) - 24 + ((mean + 16) >> 6)
					let run = runLength(((1 << z) - 1) & ((1 << kb) - 1), z)
					fail "m4a: ALAC run of {run} zeros overflows the element" when c + run > count
					c += run
					zero = 0 when run >= 65535
					mean = 0
				}
			}
			return out
		}

		// Reads one residual: a unary prefix of up to 9 ones, then `k` bits, or
		// after 9 ones the value verbatim in `width` bits.
		def golomb(m int, k int, width int) int {
			let prefix = ones(9)
			return read(width) when prefix >= 9
			bit++
			return prefix when k == 1
			let v = peek(k)
			bit += k - 1
			let result = prefix * m
			if v >= 2 {
				result += v - 1
				bit++
			}
			return result
		}

		// Reads a run of zeros: like `golomb`, with a 16-bit escape.
		def runLength(m int, k int) int {
			let prefix = ones(9)
			return read(16) when prefix >= 9
			bit++
			let v = peek(k)
			bit += k
			let result = prefix * m + v - 1
			if v < 2 {
				result -= v - 1
				bit--
			}
			return result
		}

		// Runs the adaptive predictor over the residuals: `taps` coefficients
		// (31 for plain first differences) scaled down by `shift`, with results
		// wrapped to `chanBits` bits.
		def predict(input int[], count int, coefs int[], taps int, chanBits int, shift int) int[] {
			let out int[]
			out.len(count)
			out[0] = input[0]
			if taps == 0 {
				for let j = 1; j < count; j++ {
					out[j] = input[j]
				}
				return out
			}
			if taps == 31 {
				for let j = 1; j < count; j++ {
					out[j] = wrap(input[j] + out[j - 1], chanBits)
				}
				return out
			}
			let a = coefs.clone()
			let half = shift > 0 ?? (1 << (shift - 1), 0)
			for let j = 1; j <= taps && j < count; j++ {
				out[j] = wrap(input[j] + out[j - 1], chanBits)
			}
			for let j = taps + 1; j < count; j++ {
				let top = out[j - taps - 1]
				let sum = 0
				for let k = 0; k < taps; k++ {
					sum += a[k] * (out[j - 1 - k] - top)
				}
				sum = wrap(sum, 32)
				let del = input[j]
				let rest = del
				out[j] = wrap(del + top + ((sum + half) >> shift), chanBits)
				if del > 0 {
					for let k = taps - 1; k >= 0; k-- {
						let dd = top - out[j - 1 - k]
						let sg = sign(dd)
						a[k] = wrap(a[k] - sg, 16)
						rest -= (taps - k) * ((sg * dd) >> shift)
						break when rest <= 0
					}
				} else if del < 0 {
					for let k = taps - 1; k >= 0; k-- {
						let dd = top - out[j - 1 - k]
						let sg = sign(dd)
						a[k] = wrap(a[k] + sg, 16)
						rest -= (taps - k) * ((0 - sg * dd) >> shift)
						break when rest >= 0
					}
				}
			}
			return out
		}

		// Reads `count` bits, most significant first; bits past the packet read
		// as zeros.
		def read(count int) int {
			let v = peek(count)
			bit += count
			return v
		}

		// The next `count` bits, without moving.
		def peek(count int) int {
			let v = 0
			let at = bit
			let left = count
			for left > 0 {
				let index = at >> 3
				let b = index < data.len() ?? (int(data[index]), 0)
				let offset = at & 7
				let take = 8 - offset
				take = left when take > left
				v = v << take | ((b >> (8 - offset - take)) & ((1 << take) - 1))
				at += take
				left -= take
			}
			return v
		}

		// How many one bits follow, up to `limit`, without moving.
		def ones(limit int) int {
			let n = 0
			for n < limit && peekAt(bit + n) == 1 {
				n++
			}
			bit += n
			return n
		}

		// The bit at position `at`, 0 past the packet.
		def peekAt(at int) int {
			let index = at >> 3
			return 0 when index >= data.len()
			return (int(data[index]) >> (7 - (at & 7))) & 1
		}
	}

	// `v` read as a two's complement number of `width` bits.
	def signed(v int, width int) int {
		let top = 1 << (width - 1)
		return ((v & ((top << 1) - 1)) ^ top) - top
	}

	// `v` wrapped to a two's complement number of `width` bits.
	def wrap(v int, width int) int {
		return signed(v, width)
	}

	// -1, 0 or 1 by the sign of `v`.
	def sign(v int) int {
		return v > 0 ?? (1, v < 0 ?? (-1, 0))
	}

	// Leading zero bits of `v` as a 32-bit number.
	def leading(v int) int {
		let n = 0
		for let b = 31; b >= 0 && (v >> b) & 1 == 0; b-- {
			n++
		}
		return n
	}

	// floor(log2(v + 3)), the Golomb parameter for a mean.
	def log3(v int) int {
		return 31 - leading(v + 3)
	}
}
