internal partial module std.formats.audio.m4a {
	use (
		std.formats.audio.mp4::*
		std.formats.audio::*
	)

	// An MP4 file held in memory, read into its first audio track and its tags.
	type M4aFile {
		// The file's bytes.
		r        Mp4Reader
		// The first audio track, once `read` has found it.
		track    M4aTrack
		// The iTunes tags, once `read` has run.
		metadata M4aMetadata

		// A file over the bytes, not yet read.
		def new(data byte[]) {
			r = new Mp4Reader(data)
			track = new M4aTrack()
		}

		// Reads the file's boxes: the first audio track with its tables into
		// `track`, and the tags into `metadata`.
		//
		// Fails when the file is damaged or has no audio track.
		def read() !none {
			let top = try r.boxes(0, r.data.len())
			let moov ?Mp4Box = none
			for let (_, box) in top {
				if box.kind == mp4Moov {
					moov = box
					break
				}
			}
			fail "m4a: the file has no moov box" when moov is none
			let movie Mp4Box = moov

			let movieScale = 0
			let mvhd = try r.child(movie, mp4Mvhd)
			if !(mvhd is none) {
				let header Mp4Box = mvhd
				fail "m4a: mvhd box is too short" unless r.holds(header, 24)
				movieScale = r.u8(header.start) == 1 ?? (r.u32(header.start + 20), r.u32(header.start + 12))
			}

			let found ?M4aTrack = none
			for let (_, trak) in try r.children(movie) {
				continue unless trak.kind == mp4Trak
				let candidate = new M4aTrack()
				if try candidate.read(r, trak, movieScale) {
					found = candidate
					break
				}
			}
			fail "m4a: the file has no audio track" when found is none
			let audio M4aTrack = found

			let mvex = try r.child(movie, mp4Mvex)
			if !(mvex is none) {
				let extends Mp4Box = mvex
				try audio.readTrackDefaults(r, extends)
				try audio.readFragments(r, top)
			}

			metadata = M4aMetadata{}
			let gapless = try readTags(movie)
			audio.applyGapless(gapless) when gapless != "" && audio.priming == 0 && audio.playable < 0
			track = audio
		}

		// Reads the `ilst` tags under `moov/udta/meta` or `moov/meta` into
		// `metadata`, and returns the iTunSMPB gapless text, empty when absent.
		//
		// Fails when a tag box is damaged.
		def readTags(movie Mp4Box) !string {
			let tagBox = try r.path(movie, mp4Udta, mp4Meta)
			tagBox = try r.child(movie, mp4Meta) when tagBox is none
			return "" when tagBox is none
			let box Mp4Box = tagBox
			// ISO meta is a full box; QuickTime's has no version field.
			let start = box.start
			start += 4 unless r.holds(box, 8) && r.u32(start + 4) == mp4Hdlr
			let inner = Mp4Box{kind: mp4Meta, start: start, end: box.end}
			let list = try r.child(inner, mp4Ilst)
			return "" when list is none
			let ilst Mp4Box = list

			let gapless = ""
			for let (_, item) in try r.children(ilst) {
				let name = ""
				let value = byte[]
				for let (_, part) in try r.children(item) {
					if part.kind == mp4Name && r.holds(part, 4) {
						name = string(r.data[part.start + 4:part.end])
					} else if part.kind == mp4Data && r.holds(part, 8) && value.len() == 0 {
						value = r.data[part.start + 8:part.end]
					}
				}
				let text = string(value)
				if item.kind == mp4Nam {
					metadata.title = text
				} else if item.kind == mp4Art {
					metadata.artist = text
				} else if item.kind == mp4Alb {
					metadata.album = text
				} else if item.kind == mp4Day {
					metadata.date = text
				} else if item.kind == mp4Trkn && value.len() >= 6 {
					metadata.track = int(value[2]) << 8 | int(value[3])
					metadata.trackCount = int(value[4]) << 8 | int(value[5])
				} else if item.kind == mp4Covr {
					metadata.cover = value
				} else if item.kind == mp4Item && name == "iTunSMPB" {
					gapless = text
				}
			}
			return gapless
		}
	}
}
