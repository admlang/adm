partial module std.formats.audio {
	use (
		std.testing
		std.os
		std.bytes
		std.formats.audio.aac::*
		std.formats.audio.m4a::*
		std.formats.media.bmff::*
		std.formats.audio.seek::*
	)

	// A sine tone held in memory, as a stream to encode.
	internal type M4aTestTone {
		// The frame the next read starts at.
		internal framePosition uint64

		internal rate     int
		internal channels int
		internal total    int
		internal at       int

		def new(rate int, channels int, total int) {
			self.rate = rate
			self.channels = channels
			self.total = total
		}

		def info() AudioInfo {
			return AudioInfo{
				sampleRate: uint32(rate),
				channels:   uint16(channels),
				bitDepth:   uint16(32),
				format:     SampleFormat.Float32,
				frames:     uint64(total),
				codec:      "pcm",
				seekable:   false,
			}
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		internal def readFrames(buf float32[]) !int {
			let count = buf.len() / channels
			count = total - at when count > total - at
			for let i = 0; i < count; i++ {
				let v = float32(((at + i) % 100) - 50) / float32(100)
				for let c = 0; c < channels; c++ {
					buf[i * channels + c] = v
				}
			}
			at += count
			return count
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		internal def seekFrame(frame uint64) !none {
			fail "the tone cannot seek"
		}

		def close() !none {}
	}

	check "M4A" {
		// Sample files live in the repo, and `adm test` runs from its root. A
		// missing sample skips rather than fails.
		let sampleDir = "samples/audio/m4a/"

		def sample(name string) ?byte[] {
			let d = os.readFile(sampleDir + name)
			return none when d is error
			return d
		}

		// What ffprobe reports for each sample file: frames, samples (packets),
		// their total bytes, the 100th and the last sample's size and offset, the
		// media duration in ticks and the esds bit rate.
		struct Expected {
			name       string
			frames     int
			samples    int
			bytes      int
			lastSize   int
			lastOffset int
			end        int
			bitrate    int
		}

		def expectations() Expected[] {
			return Expected[
				Expected{name: "m4a_5s_sample_file_44KB.m4a", frames: 220500, samples: 217, bytes: 43215, lastSize: 60, lastOffset: 43199, end: 221524, bitrate: 68824},
				Expected{name: "m4a_15s_sample_file_141KB.m4a", frames: 661500, samples: 647, bytes: 140099, lastSize: 93, lastOffset: 140050, end: 662524, bitrate: 74603},
				Expected{name: "m4a_30s_sample_file_285KB.m4a", frames: 1323000, samples: 1293, bytes: 285674, lastSize: 83, lastOffset: 285635, end: 1324024, bitrate: 76120},
				Expected{name: "m4a_60s_sample_file_574KB.m4a", frames: 2646000, samples: 2585, bytes: 576342, lastSize: 91, lastOffset: 576295, end: 2647024, bitrate: 76815},
			]
		}

