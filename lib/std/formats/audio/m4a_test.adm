		// The file's track and tags, read.
		def parsed(data byte[]) !M4aFile {
			let file = new M4aFile(data)
			try file.read()
			return file
		}

		// Whether this build decodes AAC yet: the AAC core is a separate piece of
		// work, and the decode tests skip until it lands.
		def decodes(data byte[]) bool {
			let failed = false
			let file = parsed(data) onerror (err error) {
				failed = true
				recover new M4aFile(data)
			}
			return false when failed
			let decoder = new AacDecoder(file.track.config)
			let unit = file.track.sample(file.r, 0) onerror recover byte[]
			let frames = decoder.decode(unit) onerror recover float32[]
			return frames.len() > 0
		}

		// Whether this build encodes AAC yet.
		def encodes() bool {
			let encoder = new AacEncoder(44100, 1, 64000)
			return encoder.config().len() > 0
		}

		@test()
		def TestM4aSignature() !none {
			let m4a = new M4A()
			let data = sample("m4a_5s_sample_file_44KB.m4a")
			if !(data is none) {
				let file byte[] = data
				assert m4a.matchSignature(new bytes.Reader(file)) // an isom file with an audio track
			}
			// A major brand of M4A.
			assert m4a.matchSignature(new bytes.Reader(byte[0, 0, 0, 20, 0x66, 0x74, 0x79, 0x70, 0x4D, 0x34, 0x41, 0x20, 0, 0, 0, 0, 0x4D, 0x34, 0x41, 0x20]))
			// Only a compatible brand of mp42.
			assert m4a.matchSignature(new bytes.Reader(byte[0, 0, 0, 20, 0x66, 0x74, 0x79, 0x70, 0x78, 0x78, 0x78, 0x78, 0, 0, 0, 0, 0x6D, 0x70, 0x34, 0x32]))
			// QuickTime only.
			assert !m4a.matchSignature(new bytes.Reader(byte[0, 0, 0, 20, 0x66, 0x74, 0x79, 0x70, 0x71, 0x74, 0x20, 0x20, 0, 0, 0, 0, 0x71, 0x74, 0x20, 0x20]))
			// Not an ftyp box, and too short.
			assert !m4a.matchSignature(new bytes.Reader(byte[]("RIFF....WAVEfmt ")))
			assert !m4a.matchSignature(new bytes.Reader(byte[0, 0, 0, 20]))
		}

		@test()
		def TestM4aInfoMatchesFfprobe() !none {
			for let (_, want) in expectations() {
				let data = sample(want.name)
				continue when data is none
				let file byte[] = data
				let m4a = new M4A()
				let info = try m4a.info(file)
				assert int(info.sampleRate) == 44100
				assert int(info.channels) == 1
				assert int(info.frames) == want.frames
				assert info.length == duration(int64(want.frames) * 1000000000 / 44100)
				assert info.codec == "aac"
				assert int(info.bitrate) == want.bitrate
				assert info.seekable

				// The header-only path skips mdat and agrees.
				let streamed = try m4a.info(new bytes.Reader(file))
				assert streamed.frames == info.frames
				assert streamed.bitrate == info.bitrate
			}
		}

		@test()
		def TestM4aInfoThroughRegistry() !none {
			let data = sample("m4a_15s_sample_file_141KB.m4a")
			return none when data is none
			let f = try os.open(sampleDir + "m4a_15s_sample_file_141KB.m4a")
			defer f.close()
			let found = try info(f)
			assert found.codec == "aac"
			assert int(found.frames) == 661500
		}

		@test()
		def TestM4aSampleTables() !none {
			for let (_, want) in expectations() {
				let data = sample(want.name)
				continue when data is none
				let file byte[] = data
				let track = (try parsed(file)).track
				assert track.count() == want.samples
				let total = 0
				for let (_, size) in track.samples.sizes {
					total += size
				}
				assert total == want.bytes
				// The first three and the 100th, as ffprobe -show_packets lists them.
				assert track.samples.sizes[0] == 153 && track.samples.offsets[0] == 44
				assert track.samples.sizes[1] == 57 && track.samples.offsets[1] == 197
				assert track.samples.sizes[2] == 71 && track.samples.offsets[2] == 254
				assert track.samples.sizes[99] == 261 && track.samples.offsets[99] == 19593
				assert track.samples.sizes[want.samples - 1] == want.lastSize
				assert track.samples.offsets[want.samples - 1] == want.lastOffset
				assert track.samples.times[1] == 1024
				assert track.samples.end == want.end
				assert track.priming == 1024
				assert track.timescale == 44100
				// AAC-LC, 44.1 kHz, mono.
				assert track.config.len() >= 2 && track.config[0] == 0x12 && track.config[1] == 0x08
				assert track.objectType == 0x40
			}
		}

		@test()
		def TestM4aSeekArithmetic() !none {
			let data = sample("m4a_5s_sample_file_44KB.m4a")
			return none when data is none
			let file byte[] = data
			let track = (try parsed(file)).track
			assert track.samples.sampleAt(0) == 0
			assert track.samples.sampleAt(1023) == 0
			assert track.samples.sampleAt(1024) == 1
			assert track.samples.sampleAt(1024 + 5000) == 5
			assert track.samples.sampleAt(221523) == 216
			assert track.samples.sampleAt(221524) == 217
			assert track.frames(2048) == 2048
			assert track.playableFrames() == 220500
		}

		@test()
		def TestM4aFragmented() !none {
			let m4a = new M4A()
			let file = fragmented()
			let track = (try parsed(file)).track
			assert track.count() == 4
			assert track.samples.sizes[0] == 357 && track.samples.offsets[0] == 780
			assert track.samples.sizes[1] == 307 && track.samples.offsets[1] == 1245
			assert track.samples.sizes[2] == 307 && track.samples.offsets[2] == 1660
			assert track.samples.sizes[3] == 5 && track.samples.offsets[3] == 2075
			assert track.samples.end == 3424
			let info = try m4a.info(file)
			assert int(info.sampleRate) == 8000
			assert int(info.channels) == 1
			assert int(info.frames) == 3424
			let streamed = try m4a.info(new bytes.Reader(file))
			assert int(streamed.frames) == 3424
		}

		@test()
		def TestM4aRemuxRoundTrip() !none {
			let data = sample("m4a_5s_sample_file_44KB.m4a")
			return none when data is none
			let file byte[] = data
			let original = try parsed(file)
			let r = original.r
			let source = original.track

			let muxer = new M4aMuxer(44100, 1, source.config, 1024)
			for let i = 0; i < source.count(); i++ {
				muxer.add(try source.sample(r, i))
			}
			muxer.frames = 220500
			let cover = byte[0x89, 0x50, 0x4E, 0x47, 13, 10, 26, 10, 1, 2, 3]
			let tags = M4aMetadata{title: "Remuxed", artist: "Somebody", album: "Samples", date: "2026", track: 3, trackCount: 12, cover: cover}
			let out = muxer.bytes(tags)

			let m4a = new M4A()
			assert m4a.matchSignature(new bytes.Reader(out))
			let reread = try parsed(out)
			let back = reread.r
			let track = reread.track
			assert track.count() == source.count()
			for let i = 0; i < track.count(); i++ {
				assert track.samples.sizes[i] == source.samples.sizes[i]
				assert (try track.sample(back, i)).equals(try source.sample(r, i))
			}
			assert track.config.equals(source.config)
			assert track.priming == 1024
			assert track.playableFrames() == 220500
			let info = try m4a.info(out)
			assert int(info.frames) == 220500
			assert reread.metadata.title == "Remuxed"
			assert int(info.sampleRate) == 44100
			assert m4a.metadata.title == "Remuxed"
			assert m4a.metadata.artist == "Somebody"
			assert m4a.metadata.album == "Samples"
			assert m4a.metadata.date == "2026"
			assert m4a.metadata.track == 3
			assert m4a.metadata.trackCount == 12
			assert m4a.metadata.cover.equals(cover)

			// moov comes before mdat.
			let top = try back.boxes(0, out.len())
			assert top.len() == 3
			assert top[0].kind == boxFtyp && top[1].kind == boxMoov && top[2].kind == boxMdat
		}

		@test()
		def TestM4aUntaggedHasNoUdta() !none {
			let muxer = new M4aMuxer(8000, 2, byte[0x15, 0x90], 1024)
			muxer.add(byte[1, 2, 3])
			muxer.add(byte[4, 5])
			let out = muxer.bytes(M4aMetadata{})
			let r = new BoxReader(out)
			let top = try r.boxes(0, out.len())
			assert (try r.child(top[1], boxUdta)) is none
			let m4a = new M4A()
			let track = (try parsed(out)).track
			try m4a.info(out)
			assert track.count() == 2
			assert track.channels == 2
			assert track.sampleRate == 8000
			assert track.playableFrames() == 1024
			assert m4a.metadata.title == ""
		}

		@test()
		def TestM4aRejectsDamage() !none {
			let m4a = new M4A()
			let missing = false
			m4a.info(byte[0, 0, 0, 20, 0x66, 0x74, 0x79, 0x70, 0x4D, 0x34, 0x41, 0x20, 0, 0, 0, 0, 0x4D, 0x34, 0x41, 0x20]) onerror (err error) {
				missing = true
				recover AudioInfo{}
			}
			assert missing // no moov
			let cut = false
			m4a.info(fragmented()[:200]) onerror (err error) {
				cut = true
				recover AudioInfo{}
			}
			assert cut // moov runs past the end
		}

		@test()
		def TestM4aReadsForeignTags() !none {
			let m4a = new M4A()
			let info = try m4a.info(new bytes.Reader(taggedSample()))
			assert int(info.sampleRate) == 8000
			assert int(info.frames) == 1600
			assert m4a.metadata.title == "Tagged"
			assert m4a.metadata.artist == "FF Artist"
			assert m4a.metadata.album == "FF Album"
			assert m4a.metadata.date == "1999"
			assert m4a.metadata.track == 4
			assert m4a.metadata.trackCount == 9
			assert m4a.metadata.cover.len() == 0
		}

		@test()
		def TestM4aAlacInfo() !none {
			let info = try new M4A().info(alacSample())
			assert info.codec == "alac"
			assert int(info.sampleRate) == 8000
			assert int(info.channels) == 2
			assert int(info.bitDepth) == 16
			assert info.format == SampleFormat.Int16
			assert int(info.frames) == 400
			assert int(info.bitrate) == 57120
		}

		@test()
		def TestM4aAlacDecodesLikeFfmpeg() !none {
			let audio = try load(alacSample())
			assert int(audio.info.frames) == 400
			assert audio.samples.len() == 800
			// ffmpeg's s16 output, summed with each sample weighted by its index
			// plus one, and without weights of the magnitudes.
			let weighted = 0
			let magnitude = 0
			for let (i, s) in audio.samples {
				let v = int(s * float32(32768))
				weighted += (i + 1) * v
				magnitude += v < 0 ?? (0 - v, v)
			}
			assert weighted == -13271200
			assert magnitude == 1474600

			let stream = try new M4A().open(alacSample())
			defer stream.close()
			try stream.seek(uint64(123))
			let buf float32[]
			buf.len(6)
			assert (try stream.read(buf)) == 3
			let want = int[-2883, -2883, -2620, -2620, -2048, -2048]
			for let (i, w) in want {
				assert int(buf[i] * float32(32768)) == w
			}
			try stream.seek(uint64(398))
			assert (try stream.read(buf)) == 2
			assert (try stream.read(buf)) == 0
		}

		@test()
		def TestM4aDecodeMatchesFfmpeg() !none {
			let data = sample("m4a_5s_sample_file_44KB.m4a")
			return none when data is none
			let file byte[] = data
			return none unless decodes(file)
			let audio = try load(file)
			assert int(audio.info.frames) == 220500
			// Frames ffmpeg decodes at these positions, after the priming.
			let at = int[1000, 50000, 100000, 150000, 200000]
			let want = float32[-0.000162, -0.037192, -0.049862, -0.029026, 0.005085]
			for let (i, frame) in at {
				let d = audio.samples[frame] - want[i]
				assert d < 0.001 && d > -0.001
			}

			// Seeking lands on the same frames.
			let stream = try new M4A().open(file)
			defer stream.close()
			try stream.seek(uint64(150000))
			let buf float32[]
			buf.len(4)
			assert (try stream.read(buf)) == 4
			let d = buf[0] - want[3]
			assert d < 0.001 && d > -0.001
		}

		@test()
		def TestM4aEncodeRoundTrip() !none {
			return none unless encodes()
			let m4a = new M4A()
			m4a.bitrate = 96000
			m4a.metadata.title = "Tone"
			let out = new bytes.Buffer()
			try m4a.encode(new M4aTestTone(44100, 2, 44100), out)
			let back = new M4A()
			let info = try back.info(out.bytes())
			assert int(info.frames) == 44100
			assert int(info.channels) == 2
			assert back.metadata.title == "Tone"
			return none unless decodes(out.bytes())
			let audio = try load(out.bytes())
			assert int(audio.info.frames) == 44100
		}
	}
}
