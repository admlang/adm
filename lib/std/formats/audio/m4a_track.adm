internal partial module std.formats.audio.m4a {
	use (
		std.formats.audio.mp4::*
		std.formats.audio::*
	)

	// The audio track of an MP4 file: its sample description and the sample
	// tables flattened into one entry per sample (offset, size, start time),
	// from the classic `stbl` tables or from movie fragments.
	type M4aTrack {
		// The track's `tkhd` id, which movie fragments name it by.
		id               int
		// Ticks per second of the sample times, from `mdhd`.
		timescale        int
		// The sample entry's type: `mp4a` or `alac`.
		entry            int
		// "aac" or "alac".
		codec            string
		// Frames per second and channels the sample entry declares.
		sampleRate       int
		channels         int
		// Bits per sample the sample entry declares.
		sampleSize       int
		// The decoder configuration: the AudioSpecificConfig for AAC, the
		// ALACSpecificConfig for ALAC.
		config           byte[]
		// The `esds` object type: 0x40 for MPEG-4 audio.
		objectType       int
		// Average bits per second the `esds` declares, 0 when it does not.
		avgBitrate       int
		// Where each sample starts in the file and how many bytes it holds.
		offsets          int[]
		sizes            int[]
		// When each sample starts, in `timescale` ticks, and when the last ends.
		times            int[]
		end              int
		// Ticks at the start that the encoder added and playback skips (the
		// edit list's media time).
		priming          int
		// Ticks that play from `priming` on, -1 when nothing records it.
		playable         int
		// Defaults `trex` gives the samples of movie fragments.
		fragmentDuration int
		fragmentSize     int

		// An empty track, filled by `read`.
		def new() {
			playable = -1
		}

		// Reads the track's description and sample tables out of its `trak`,
		// with the movie's timescale for the edit list. Returns false for a
		// track that is not audio.
		//
		// Fails when a box the track needs is missing or damaged.
		def read(r Mp4Reader, trak Mp4Box, movieScale int) !bool {
			let handler = try r.path(trak, mp4Mdia, mp4Hdlr)
			return false when handler is none
			let hdlr Mp4Box = handler
			return false unless r.holds(hdlr, 12) && r.u32(hdlr.start + 8) == mp4Soun

			let tkhd = try r.child(trak, mp4Tkhd)
			if !(tkhd is none) {
				let box Mp4Box = tkhd
				fail "m4a: tkhd box is too short" unless r.holds(box, 24)
				id = r.u8(box.start) == 1 ?? (r.u32(box.start + 20), r.u32(box.start + 12))
			}

			let mdhd = try r.path(trak, mp4Mdia, mp4Mdhd)
			fail "m4a: the audio track has no mdhd box" when mdhd is none
			let media Mp4Box = mdhd
			try readMediaHeader(r, media)

			let stbl = try r.path(trak, mp4Mdia, mp4Minf, mp4Stbl)
			fail "m4a: the audio track has no sample table" when stbl is none
			let table Mp4Box = stbl
			let stsd = try r.child(table, mp4Stsd)
			fail "m4a: the audio track has no sample description" when stsd is none
			let description Mp4Box = stsd
			try readDescription(r, description)
			try readTables(r, table)

			let elst = try r.path(trak, mp4Edts, mp4Elst)
			if !(elst is none) {
				let edits Mp4Box = elst
				try readEdits(r, edits, movieScale)
			}
			return true
		}

		// Reads the timescale from `mdhd`.
		//
		// Fails when the box is too short or the timescale is zero.
		def readMediaHeader(r Mp4Reader, box Mp4Box) !none {
			let at = box.start
			if r.u8(at) == 1 {
				fail "m4a: mdhd box is too short" unless r.holds(box, 32)
				timescale = r.u32(at + 20)
			} else {
				fail "m4a: mdhd box is too short" unless r.holds(box, 20)
				timescale = r.u32(at + 12)
			}
			fail "m4a: the audio track has a zero timescale" when timescale == 0
		}

		// Reads the first sample entry of `stsd`: rate, channels and the
		// decoder configuration.
		//
		// Fails when the entry is damaged or is not AAC or ALAC.
		def readDescription(r Mp4Reader, stsd Mp4Box) !none {
			expects {
				assert r.holds(stsd, 8) onerror fail "m4a: stsd box is too short"
				assert r.u32(stsd.start + 4) != 0 onerror fail "m4a: stsd box has no sample entry"
			}
			let entries = try r.boxes(stsd.start + 8, stsd.end)
			fail "m4a: stsd box has no sample entry" when entries.len() == 0
			let box = entries[0]
			entry = box.kind
			fail "m4a: sample entry is too short" unless r.holds(box, 28)
			// The QuickTime sound description version: 1 and 2 add fields.
			let version = r.u16(box.start + 8)
			channels = r.u16(box.start + 16)
			sampleSize = r.u16(box.start + 18)
			sampleRate = r.u32(box.start + 24) >> 16
			let children = box.start + 28
			if version == 1 {
				children += 16
			} else if version == 2 {
				fail "m4a: sample entry is too short" unless r.holds(box, 64)
				sampleRate = int(__bitcast_f64_from_u64(uint64(r.u64(box.start + 32))))
				channels = r.u32(box.start + 40)
				sampleSize = r.u32(box.start + 48)
				children += 36
			}
			fail "m4a: sample entry is too short" when children > box.end
			let inner = Mp4Box{kind: box.kind, start: children, end: box.end}

			if entry == mp4Mp4a {
				codec = "aac"
				let esds = try r.child(inner, mp4Esds)
				if esds is none {
					let wave = try r.child(inner, mp4Wave)
					if !(wave is none) {
						let quicktime Mp4Box = wave
						esds = try r.child(quicktime, mp4Esds)
					}
				}
				fail "m4a: the mp4a sample entry has no esds box" when esds is none
				let descriptors Mp4Box = esds
				try readEsds(r, descriptors)
				fail "m4a: the stream is MPEG-4 object type {objectType}, not AAC audio" unless objectType := 0x40 || 0x66 || 0x67 || 0x68
				return none
			}
			if entry == mp4Alac {
				codec = "alac"
				let cookie = try r.child(inner, mp4Alac)
				fail "m4a: the alac sample entry has no configuration" when cookie is none
				let alac Mp4Box = cookie
				fail "m4a: the alac configuration is too short" unless r.holds(alac, 28)
				config = r.data[alac.start + 4:alac.start + 28]
				sampleSize = r.u8(alac.start + 9)
				channels = r.u8(alac.start + 13)
				sampleRate = r.u32(alac.start + 24)
				return none
			}
			fail "m4a: unsupported sample entry {fourcc(entry)}"
		}

		// Reads the `esds` descriptors: the object type, average bit rate and
		// the DecoderSpecificInfo bytes.
		//
		// Fails when a descriptor runs past the box or there is no decoder
		// configuration.
		def readEsds(r Mp4Reader, box Mp4Box) !none {
			let at = box.start + 4
			let limit = box.end
			for at < limit {
				let tag = r.u8(at)
				at++
				let size = 0
				for let i = 0; i < 4; i++ {
					fail "m4a: esds descriptor cut short" when at >= limit
					let b = r.u8(at)
					at++
					size = size << 7 | (b & 0x7F)
					break when b & 0x80 == 0
				}
				fail "m4a: esds descriptor runs past its box" when at + size > limit
				if tag == 3 {
					// ES_Descriptor: its id, flags, then the descriptors inside.
					let flags = r.u8(at + 2)
					let skip = 3
					skip += 2 when flags & 0x80 != 0
					skip += 1 + r.u8(at + skip) when flags & 0x40 != 0
					skip += 2 when flags & 0x20 != 0
					limit = at + size
					at += skip
				} else if tag == 4 {
					// DecoderConfigDescriptor: the fixed fields, then its
					// DecoderSpecificInfo.
					fail "m4a: decoder configuration is too short" when size < 13
					objectType = r.u8(at)
					avgBitrate = r.u32(at + 9)
					limit = at + size
					at += 13
				} else if tag == 5 {
					config = r.data[at:at + size]
					return none
				} else {
					at += size
				}
			}
			fail "m4a: esds box has no decoder configuration"
		}

		// Reads stts, stsc, stsz or stz2 and stco or co64 into one entry per
		// sample.
		//
		// Fails when a table is missing, damaged, or the tables disagree.
		def readTables(r Mp4Reader, stbl Mp4Box) !none {
			let sttsBox = try r.child(stbl, mp4Stts)
			let stscBox = try r.child(stbl, mp4Stsc)
			let stszBox = try r.child(stbl, mp4Stsz)
			stszBox = try r.child(stbl, mp4Stz2) when stszBox is none
			let stcoBox = try r.child(stbl, mp4Stco)
			stcoBox = try r.child(stbl, mp4Co64) when stcoBox is none
			fail "m4a: the sample table lacks stts, stsc, stsz or stco" when sttsBox is none || stscBox is none || stszBox is none || stcoBox is none
			let stts Mp4Box = sttsBox
			let stsc Mp4Box = stscBox
			let stsz Mp4Box = stszBox
			let stco Mp4Box = stcoBox

			// Sizes.
			fail "m4a: stsz box is too short" unless r.holds(stsz, 12)
			let count = r.u32(stsz.start + 8)
			if stsz.kind == mp4Stsz {
				let fixed = r.u32(stsz.start + 4)
				fail "m4a: stsz box is too short" unless fixed != 0 || r.holds(stsz, 12 + count * 4)
				for let i = 0; i < count; i++ {
					sizes.push(fixed != 0 ?? (fixed, r.u32(stsz.start + 12 + i * 4)))
				}
			} else {
				let bits = r.u8(stsz.start + 7)
				fail "m4a: stz2 field size {bits} is not 4, 8 or 16" unless bits := 4 || 8 || 16
				fail "m4a: stz2 box is too short" unless r.holds(stsz, 12 + (count * bits + 7) / 8)
				for let i = 0; i < count; i++ {
					let at = stsz.start + 12
					if bits == 16 {
						sizes.push(r.u16(at + i * 2))
					} else if bits == 8 {
						sizes.push(r.u8(at + i))
					} else {
						let b = r.u8(at + i / 2)
						sizes.push(i % 2 == 0 ?? (b >> 4, b & 0x0F))
					}
				}
			}

			// Times.
			fail "m4a: stts box is too short" unless r.holds(stts, 8)
			let runs = r.u32(stts.start + 4)
			fail "m4a: stts box is too short" unless r.holds(stts, 8 + runs * 8)
			let time = 0
			for let i = 0; i < runs; i++ {
				let n = r.u32(stts.start + 8 + i * 8)
				let delta = r.u32(stts.start + 12 + i * 8)
				for let k = 0; k < n && times.len() < count; k++ {
					times.push(time)
					time += delta
				}
			}
			fail "m4a: stts covers {times.len()} samples, stsz lists {count}" when times.len() != count
			end = time

			// Offsets: each chunk's samples lie back to back from its offset.
			let wide = stco.kind == mp4Co64
			fail "m4a: chunk offset box is too short" unless r.holds(stco, 8)
			let chunks = r.u32(stco.start + 4)
			fail "m4a: chunk offset box is too short" unless r.holds(stco, 8 + chunks * (wide ?? (8, 4)))
			fail "m4a: stsc box is too short" unless r.holds(stsc, 8)
			let entries = r.u32(stsc.start + 4)
			fail "m4a: stsc box is too short" unless r.holds(stsc, 8 + entries * 12)
			let sample = 0
			for let e = 0; e < entries; e++ {
				let first = r.u32(stsc.start + 8 + e * 12)
				let perChunk = r.u32(stsc.start + 12 + e * 12)
				let last = e + 1 < entries ?? (r.u32(stsc.start + 20 + e * 12) - 1, chunks)
				fail "m4a: stsc names chunk {first}, stco has {chunks}" when first < 1 || last > chunks
				for let c = first; c <= last && sample < count; c++ {
					let at = wide ?? (r.u64(stco.start + 8 + (c - 1) * 8), r.u32(stco.start + 8 + (c - 1) * 4))
					for let k = 0; k < perChunk && sample < count; k++ {
						offsets.push(at)
						at += sizes[sample]
						sample++
					}
				}
			}
			fail "m4a: stsc places {offsets.len()} samples, stsz lists {count}" when offsets.len() != count
		}

		// Reads the first edit that plays media: where playback starts in the
		// media and how long it lasts.
		//
		// Fails when the box is damaged.
		def readEdits(r Mp4Reader, elst Mp4Box, movieScale int) !none {
			expects {
				assert r.holds(elst, 8) onerror fail "m4a: elst box is too short"
			}
			let wide = r.u8(elst.start) == 1
			let entries = r.u32(elst.start + 4)
			let step = wide ?? (20, 12)
			fail "m4a: elst box is too short" unless r.holds(elst, 8 + entries * step)
			for let i = 0; i < entries; i++ {
				let at = elst.start + 8 + i * step
				let length = wide ?? (r.u64(at), r.u32(at))
				let start = wide ?? (r.u64(at + 8), r.s32(at + 4))
				// An empty edit (media time -1) only delays the track.
				continue when start < 0 || wide && start == 0x7FFFFFFFFFFFFFFF
				priming = start
				playable = length * timescale / movieScale when length > 0 && movieScale > 0
				return none
			}
		}

		// Reads the samples movie fragments add to this track: every `traf` of
		// every `moof` naming it.
		//
		// Fails when a fragment box is damaged.
		def readFragments(r Mp4Reader, top Mp4Box[]) !none {
			for let (_, moof) in top {
				continue unless moof.kind == mp4Moof
				for let (_, traf) in try r.children(moof) {
					continue unless traf.kind == mp4Traf
					try readFragment(r, moof, traf)
				}
			}
		}

		// Reads one track fragment's runs.
		//
		// Fails when its boxes are damaged.
		def readFragment(r Mp4Reader, moof Mp4Box, traf Mp4Box) !none {
			let header = try r.child(traf, mp4Tfhd)
			fail "m4a: track fragment without a tfhd box" when header is none
			let tfhd Mp4Box = header
			fail "m4a: tfhd box is too short" unless r.holds(tfhd, 8)
			let flags = r.u24(tfhd.start + 1)
			return none when r.u32(tfhd.start + 4) != id
			// The fragment's data offsets count from the moof box's first byte
			// unless tfhd names a base.
			let base = moof.start - 8
			let duration = fragmentDuration
			let size = fragmentSize
			let at = tfhd.start + 8
			if flags & 0x01 != 0 {
				base = r.u64(at)
				at += 8
			}
			at += 4 when flags & 0x02 != 0
			if flags & 0x08 != 0 {
				duration = r.u32(at)
				at += 4
			}
			if flags & 0x10 != 0 {
				size = r.u32(at)
				at += 4
			}
			fail "m4a: tfhd box is too short" when at > tfhd.end

			let pos = base
			for let (_, trun) in try r.children(traf) {
				continue unless trun.kind == mp4Trun
				fail "m4a: trun box is too short" unless r.holds(trun, 8)
				let runFlags = r.u24(trun.start + 1)
				let count = r.u32(trun.start + 4)
				let field = trun.start + 8
				if runFlags & 0x01 != 0 {
					pos = base + r.s32(field)
					field += 4
				}
				field += 4 when runFlags & 0x04 != 0
				let stride = 0
				for let (_, bit) in int[0x100, 0x200, 0x400, 0x800] {
					stride += 4 when runFlags & bit != 0
				}
				fail "m4a: trun box is too short" when field + count * stride > trun.end
				for let i = 0; i < count; i++ {
					let d = duration
					let s = size
					if runFlags & 0x100 != 0 {
						d = r.u32(field)
						field += 4
					}
					if runFlags & 0x200 != 0 {
						s = r.u32(field)
						field += 4
					}
					field += 4 when runFlags & 0x400 != 0
					field += 4 when runFlags & 0x800 != 0
					offsets.push(pos)
					sizes.push(s)
					times.push(end)
					end += d
					pos += s
				}
			}
		}

		// Reads the `trex` defaults for this track out of `mvex`.
		//
		// Fails when the box is damaged.
		def readTrackDefaults(r Mp4Reader, mvex Mp4Box) !none {
			for let (_, trex) in try r.children(mvex) {
				continue unless trex.kind == mp4Trex && r.holds(trex, 24)
				continue unless r.u32(trex.start + 4) == id
				fragmentDuration = r.u32(trex.start + 12)
				fragmentSize = r.u32(trex.start + 16)
			}
		}

		// How many samples the track holds.
		def count() int {
			return sizes.len()
		}

		// The bytes of sample `i`.
		def sample(r Mp4Reader, i int) !byte[] {
			let at = offsets[i]
			fail "m4a: sample {i} lies outside the file" when at < 0 || at + sizes[i] > r.data.len()
			return r.data[at:at + sizes[i]]
		}

		// The first sample whose time span holds tick `t`, or the sample count
		// when `t` is past the last.
		def sampleAt(t int) int {
			let lo = 0
			let hi = times.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				let next = mid + 1 < times.len() ?? (times[mid + 1], end)
				if next <= t {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			return lo
		}

		// Ticks converted to frames at the track's sample rate.
		def frames(ticks int) int {
			return ticks when timescale == sampleRate || sampleRate == 0
			return ticks * sampleRate / timescale
		}

		// Frames converted to ticks of the track's timescale.
		def ticks(frames int) int {
			return frames when timescale == sampleRate || sampleRate == 0
			return frames * timescale / sampleRate
		}

		// Frames that play: the edit's length, else everything after the
		// priming.
		def playableFrames() int {
			let total = end - priming
			total = playable when playable >= 0 && playable < total
			return total < 0 ?? (0, frames(total))
		}

		// Takes the priming and length from an iTunSMPB text (hex fields: zero,
		// priming frames, padding frames, original frames), for files with no
		// edit list. Leaves the track as it is when the text does not parse.
		def applyGapless(text string) {
			let fields string[]
			for let (_, field) in text.trim().split(" ") {
				fields.push(field) when field != ""
			}
			return when fields.len() < 4
			let delay = fields[1].toInt<int>(16)
			let length = fields[3].toInt<int>(16)
			return when delay <= 0 || length <= 0
			priming = ticks(delay)
			playable = ticks(length)
		}

		// The track as `AudioInfo`: the playable frames, and the declared average
		// bit rate or, without one, the one the sample sizes give.
		def info() AudioInfo {
			let total = playableFrames()
			let bits = avgBitrate
			if bits == 0 && total > 0 && sampleRate > 0 {
				let bytes = 0
				for let (_, size) in sizes {
					bytes += size
				}
				bits = bytes * 8 * sampleRate / total
			}
			let format = SampleFormat.Float32
			let depth = 32
			if codec == "alac" {
				depth = sampleSize
				format = SampleFormat.Int16
				format = SampleFormat.Int24 when sampleSize > 16
				format = SampleFormat.Int32 when sampleSize > 24
			}
			return AudioInfo{
				sampleRate: uint32(sampleRate),
				channels:   uint16(channels),
				bitDepth:   uint16(depth),
				format:     format,
				frames:     uint64(total),
				length:     sampleRate == 0 ?? (0s, duration(int64(total) * 1000000000 / int64(sampleRate))),
				codec:      codec,
				bitrate:    uint32(bits),
				seekable:   true,
			}
		}
	}

	// The four characters of a box type, for messages.
	def fourcc(kind int) string {
		let b byte[]
		for let shift = 24; shift >= 0; shift -= 8 {
			let c = (kind >> shift) & 0xFF
			b.push(c >= 0x20 && c < 0x7F ?? (byte(c), byte('?')))
		}
		return string(b)
	}
}
