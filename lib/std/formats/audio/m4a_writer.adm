internal partial module std.formats.audio.m4a {
	use (
		std.io
		std.formats.audio.mp4::*
		std.formats.audio::*
	)

	// Lays AAC access units out as an M4A file: `ftyp`, then `moov` with one
	// audio track and the tags, then `mdat` holding the units.
	type M4aMuxer {
		// Frames per second and channels of the units.
		sampleRate int
		channels   int
		// The AudioSpecificConfig of the units.
		config     byte[]
		// Frames of priming at the start that playback skips.
		delay      int
		// Frames that play after the priming, -1 for every frame the units
		// hold.
		frames     int
		// The access units, in order.
		units      byte[][]

		// A muxer for units at the rate and channel count, described by the
		// config, starting with `delay` frames of priming.
		def new(sampleRate int, channels int, config byte[], delay int) {
			self.sampleRate = sampleRate
			self.channels = channels
			self.config = config
			self.delay = delay
			frames = -1
		}

		// Appends one access unit of 1024 frames.
		def add(unit byte[]) {
			units.push(unit)
		}

		// Writes the whole file to the writer.
		//
		// Fails when the writer does or takes fewer bytes than given.
		def writeTo(writer io.Writer, metadata M4aMetadata) !none {
			let data = bytes(metadata)
			let at = 0
			for at < data.len() {
				let n = try writer.write(data[at:])
				fail "m4a: the writer took no bytes" when n <= 0
				at += n
			}
		}

		// The whole file.
		def bytes(metadata M4aMetadata) byte[] {
			let payload = 0
			for let (_, unit) in units {
				payload += unit.len()
			}
			let w = new Mp4Writer()
			let ftyp = w.box(mp4Ftyp)
			w.u32(mp4M4a)
			w.u32(0x200)
			for let (_, brand) in int[mp4M4a, mp4Isom, mp4Iso2, mp4Mp41] {
				w.u32(brand)
			}
			w.close(ftyp)

			let large = payload + 8 > 0xFFFFFFFF
			let header = large ?? (16, 8)
			// The chunk offsets depend on the moov size, which does not depend on
			// their values: size it once, then write it for real.
			let sizing = new Mp4Writer()
			movie(sizing, 0, metadata)
			let base = w.len() + sizing.len() + header
			let moov = new Mp4Writer()
			movie(moov, base, metadata)
			w.out.push(...moov.out)

			if large {
				w.u32(1)
				w.u32(mp4Mdat)
				w.u64(payload + 16)
			} else {
				w.u32(payload + 8)
				w.u32(mp4Mdat)
			}
			for let (_, unit) in units {
				w.out.push(...unit)
			}
			return w.out
		}

		// Frames of media the units hold.
		def mediaFrames() int {
			return units.len() * aacFrameLength
		}

		// Frames that play.
		def playFrames() int {
			let total = mediaFrames() - delay
			total = frames when frames >= 0 && frames < total
			return total < 0 ?? (0, total)
		}

		// Samples per chunk: about a second of audio.
		def chunkLength() int {
			let n = sampleRate / aacFrameLength
			return n < 1 ?? (1, n)
		}

		// Writes `moov` with the samples' data starting at file offset `base`.
		def movie(w Mp4Writer, base int, metadata M4aMetadata) {
			let moov = w.box(mp4Moov)
			let length = playFrames()
			let wide = length > 0xFFFFFFFF || mediaFrames() > 0xFFFFFFFF

			let mvhd = w.fullBox(mp4Mvhd, wide ?? (1, 0), 0)
			stamps(w, wide, length)
			w.u32(0x00010000)
			w.u16(0x0100)
			w.zeros(10)
			matrix(w)
			w.zeros(24)
			w.u32(2)
			w.close(mvhd)

			let trak = w.box(mp4Trak)
			let tkhd = w.fullBox(mp4Tkhd, wide ?? (1, 0), 3)
			if wide {
				w.u64(0)
				w.u64(0)
				w.u32(1)
				w.u32(0)
				w.u64(length)
			} else {
				w.u32(0)
				w.u32(0)
				w.u32(1)
				w.u32(0)
				w.u32(length)
			}
			w.zeros(8)
			w.u16(0)
			w.u16(1)
			w.u16(0x0100)
			w.u16(0)
			matrix(w)
			w.u32(0)
			w.u32(0)
			w.close(tkhd)

			let edts = w.box(mp4Edts)
			let elst = w.fullBox(mp4Elst, wide ?? (1, 0), 0)
			w.u32(1)
			if wide {
				w.u64(length)
				w.u64(delay)
			} else {
				w.u32(length)
				w.u32(delay)
			}
			w.u32(0x00010000)
			w.close(elst)
			w.close(edts)

			let mdia = w.box(mp4Mdia)
			let mdhd = w.fullBox(mp4Mdhd, wide ?? (1, 0), 0)
			stamps(w, wide, mediaFrames())
			// "und", packed as three five-bit letters.
			w.u16(0x55C4)
			w.u16(0)
			w.close(mdhd)

			let hdlr = w.fullBox(mp4Hdlr, 0, 0)
			w.u32(0)
			w.u32(mp4Soun)
			w.zeros(12)
			w.bytes(byte[]("SoundHandler"))
			w.u8(0)
			w.close(hdlr)

			let minf = w.box(mp4Minf)
			let smhd = w.fullBox(mp4Smhd, 0, 0)
			w.u32(0)
			w.close(smhd)
			let dinf = w.box(mp4Dinf)
			let dref = w.fullBox(mp4Dref, 0, 0)
			w.u32(1)
			let url = w.fullBox(mp4Url, 0, 1)
			w.close(url)
			w.close(dref)
			w.close(dinf)
			table(w, base)
			w.close(minf)
			w.close(mdia)
			w.close(trak)

			tags(w, metadata)
			w.close(moov)
		}

		// Writes the creation and modification times (zero), the timescale (the
		// sample rate) and the duration of `mvhd` or `mdhd`.
		def stamps(w Mp4Writer, wide bool, length int) {
			if wide {
				w.u64(0)
				w.u64(0)
				w.u32(sampleRate)
				w.u64(length)
			} else {
				w.u32(0)
				w.u32(0)
				w.u32(sampleRate)
				w.u32(length)
			}
		}

		// Writes the identity transformation matrix of `mvhd` and `tkhd`.
		def matrix(w Mp4Writer) {
			for let (_, v) in int[0x00010000, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000] {
				w.u32(v)
			}
		}

		// Writes `stbl`: the mp4a sample entry and the sample tables, one chunk
		// per `chunkLength` samples.
		def table(w Mp4Writer, base int) {
			let stbl = w.box(mp4Stbl)

			let stsd = w.fullBox(mp4Stsd, 0, 0)
			w.u32(1)
			let entry = w.box(mp4Mp4a)
			w.zeros(6)
			w.u16(1)
			w.zeros(8)
			w.u16(channels)
			w.u16(16)
			w.u16(0)
			w.u16(0)
			w.u32(sampleRate < 65536 ?? (sampleRate << 16, 0))
			esds(w)
			w.close(entry)
			w.close(stsd)

			let stts = w.fullBox(mp4Stts, 0, 0)
			if units.len() == 0 {
				w.u32(0)
			} else {
				w.u32(1)
				w.u32(units.len())
				w.u32(aacFrameLength)
			}
			w.close(stts)

			let per = chunkLength()
			let chunks = (units.len() + per - 1) / per
			let rest = units.len() % per
			let stsc = w.fullBox(mp4Stsc, 0, 0)
			let full = rest == 0 ?? (chunks, chunks - 1)
			let runs = 0
			runs++ when full > 0
			runs++ when rest > 0
			w.u32(runs)
			if full > 0 {
				w.u32(1)
				w.u32(per)
				w.u32(1)
			}
			if rest > 0 {
				w.u32(full + 1)
				w.u32(rest)
				w.u32(1)
			}
			w.close(stsc)

			let stsz = w.fullBox(mp4Stsz, 0, 0)
			w.u32(0)
			w.u32(units.len())
			for let (_, unit) in units {
				w.u32(unit.len())
			}
			w.close(stsz)

			let offsets int[]
			let at = base
			for let (i, unit) in units {
				offsets.push(at) when i % per == 0
				at += unit.len()
			}
			let wide = at > 0xFFFFFFFF
			let stco = w.fullBox(wide ?? (mp4Co64, mp4Stco), 0, 0)
			w.u32(offsets.len())
			for let (_, offset) in offsets {
				if wide {
					w.u64(offset)
				} else {
					w.u32(offset)
				}
			}
			w.close(stco)
			w.close(stbl)
		}

		// Writes the `esds` box: an ES descriptor holding the decoder
		// configuration (AAC, the buffer size and bit rates the units give) and
		// the AudioSpecificConfig.
		def esds(w Mp4Writer) {
			let largest = 0
			let total = 0
			for let (_, unit) in units {
				largest = unit.len() when unit.len() > largest
				total += unit.len()
			}
			let seconds = mediaFrames()
			let average = seconds == 0 ?? (0, total * 8 * sampleRate / seconds)
			// The peak over any one second of units.
			let peak = 0
			let per = chunkLength()
			let window = 0
			for let (i, unit) in units {
				window += unit.len()
				window -= units[i - per].len() when i >= per
				peak = window when window > peak
			}
			peak = peak * 8 * sampleRate / (per * aacFrameLength)

			let box = w.fullBox(mp4Esds, 0, 0)
			descriptor(w, 3, 3 + 5 + 13 + 5 + config.len() + 5 + 1)
			w.u16(0)
			w.u8(0)
			descriptor(w, 4, 13 + 5 + config.len())
			w.u8(0x40)
			w.u8(0x15)
			w.u24(largest)
			w.u32(peak > average ?? (peak, average))
			w.u32(average)
			descriptor(w, 5, config.len())
			w.bytes(config)
			descriptor(w, 6, 1)
			w.u8(2)
			w.close(box)
		}

		// Writes a descriptor's tag and its length in the four-byte form.
		def descriptor(w Mp4Writer, tag int, length int) {
			w.u8(tag)
			w.u8(0x80 | (length >> 21) & 0x7F)
			w.u8(0x80 | (length >> 14) & 0x7F)
			w.u8(0x80 | (length >> 7) & 0x7F)
			w.u8(length & 0x7F)
		}

		// Writes `udta/meta/ilst` with the tags that are set, nothing when none
		// is.
		def tags(w Mp4Writer, metadata M4aMetadata) {
			let untagged = metadata.title == "" && metadata.artist == "" && metadata.album == "" && metadata.date == "" && metadata.track == 0 && metadata.trackCount == 0 && metadata.cover.len() == 0
			return when untagged
			let udta = w.box(mp4Udta)
			let tagBox = w.fullBox(mp4Meta, 0, 0)
			let hdlr = w.fullBox(mp4Hdlr, 0, 0)
			w.u32(0)
			w.u32(mp4Mdir)
			w.u32(mp4Appl)
			w.zeros(8)
			w.u8(0)
			w.close(hdlr)
			let ilst = w.box(mp4Ilst)
			text(w, mp4Nam, metadata.title)
			text(w, mp4Art, metadata.artist)
			text(w, mp4Alb, metadata.album)
			text(w, mp4Day, metadata.date)
			if metadata.track != 0 || metadata.trackCount != 0 {
				let value byte[]
				value.len(8)
				value[2] = byte((metadata.track >> 8) & 0xFF)
				value[3] = byte(metadata.track & 0xFF)
				value[4] = byte((metadata.trackCount >> 8) & 0xFF)
				value[5] = byte(metadata.trackCount & 0xFF)
				item(w, mp4Trkn, 0, value)
			}
			if metadata.cover.len() > 0 {
				// 14 marks a PNG, 13 a JPEG.
				let png = metadata.cover.len() >= 4 && metadata.cover[0] == 0x89 && metadata.cover[1] == 0x50 && metadata.cover[2] == 0x4E && metadata.cover[3] == 0x47
				item(w, mp4Covr, png ?? (14, 13), metadata.cover)
			}
			w.close(ilst)
			w.close(tagBox)
			w.close(udta)
		}

		// Writes a UTF-8 text tag, nothing when the text is empty.
		def text(w Mp4Writer, kind int, value string) {
			return when value == ""
			item(w, kind, 1, byte[](value))
		}

		// Writes one `ilst` item: a box of the tag's kind holding a `data` box
		// with the value's type code and the value.
		def item(w Mp4Writer, kind int, typeCode int, value byte[]) {
			let box = w.box(kind)
			let data = w.box(mp4Data)
			w.u32(typeCode)
			w.u32(0)
			w.bytes(value)
			w.close(data)
			w.close(box)
		}
	}

	// Frames one AAC access unit holds.
	const aacFrameLength = 1024
}
