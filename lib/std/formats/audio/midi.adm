partial module std.formats.audio {
	use (
		std.bytes
		std.io
		std.formats.audio.midi::*
	)

	// MIDI is a sequence of note events, not sampled audio.
	//
	// Deliberately not an `AudioFormat`. There are no PCM frames in a MIDI file
	// to decode -- turning one into audio needs a synthesizer and a soundfont,
	// which is a subsystem rather than a codec. Registering it would mean
	// satisfying `AudioFormat.open` by lying about what the file contains, so
	// it is parsed explicitly instead of being discovered by the registry.

	// A parsed Standard MIDI File: its format and division, plus one event
	// list per track.
	//
	// ```adm
	// let midi = new Midi()
	// try midi.fromReader(try os.open("song.mid"))
	// ```
	type Midi {
		// Ticks per quarter note when the top bit is clear. With the top bit
		// set it is SMPTE time: the high byte is the negated frame rate (-24,
		// -25, -29 for 29.97 drop-frame, -30) as a signed byte, the low byte
		// the ticks per frame. Kept as stored so writing reproduces it.
		division uint16
		// 0: a single track. 1: simultaneous tracks, the first holding the
		// tempo map. 2: independent single-track patterns.
		format   uint16
		tracks   MidiTrack[]

		// fromReader parses a Standard MIDI File (format 0, 1 or 2) from the
		// reader, replacing the division, format and tracks. Chunks other than
		// `MThd` and `MTrk` are skipped, as are bytes after the last track the
		// header announces. A track ends at its end-of-track event or at the
		// end of its chunk.
		//
		// Fails when the reader fails, when the file does not start with an
		// `MThd` chunk, when the format is not 0, 1 or 2, when the file ends
		// before every announced track, or when a track holds a truncated
		// event, a data byte with no running status, a variable-length
		// quantity over four bytes, or a status byte a file cannot hold
		// (0xF1-0xFE other than 0xF7).
		def fromReader(reader io.Reader) !none {
			let buffer = new bytes.Buffer()
			try buffer.readFrom(reader)
			let scan = new MidiScanner(buffer.bytes())
			let id = try scan.take(4)
			fail "midi: not a Standard MIDI File (no MThd chunk)" when string(id) != "MThd"
			let headerLen = int(try scan.u32())
			fail "midi: MThd chunk is {headerLen} bytes, needs 6" when headerLen < 6
			let header = new MidiScanner(try scan.take(headerLen))
			let fileFormat = try header.u16()
			fail "midi: unsupported format {fileFormat}" when fileFormat > 2
			let count = int(try header.u16())
			let fileDivision = try header.u16()
			let parsed = MidiTrack[]
			for parsed.len() < count {
				fail "midi: file ends after {parsed.len()} of {count} tracks" when scan.remaining() < 8
				let chunk = string(try scan.take(4))
				let size = int(try scan.u32())
				fail "midi: {chunk} chunk of {size} bytes runs past the end of the file" when size > scan.remaining()
				let body = try scan.take(size)
				continue when chunk != "MTrk"
				parsed.push(try new MidiScanner(body).track())
			}
			format = fileFormat
			division = fileDivision
			tracks = parsed
		}

		// The ticks in a quarter note, or none when `division` counts SMPTE
		// frames instead.
		def ticksPerQuarter() ?int {
			return none when (int(division) & 0x8000) != 0
			return int(division)
		}

		// The SMPTE timing `division` holds: frames per second (24, 25, 29 for
		// 29.97 drop-frame, 30) and ticks per frame; none when it counts ticks
		// per quarter note.
		def smpte() ?(int, int) {
			let raw = int(division)
			return none when (raw & 0x8000) == 0
			return (256 - (raw >> 8), raw & 0xFF)
		}

		// The first tempo event, in microseconds per quarter note, or none when
		// the file sets no tempo (players then assume 500000, 120 beats a
		// minute).
		def tempo() ?int {
			for let (_, track) in tracks {
				for let (_, event) in track.events {
					continue unless event.status == MidiStatus.Meta && event.data.len() == 4 && event.data[0] == MIDI_META_TEMPO
					return int(event.data[1]) << 16 | int(event.data[2]) << 8 | int(event.data[3])
				}
			}
			return none
		}

		// write writes the file as a Standard MIDI File. With `runningStatus`, a
		// channel message repeating the status of the one before it leaves the
		// status byte out, which makes files smaller; without, every channel
		// message carries its own. A meta or system exclusive event ends a
		// running status. Each track
		// gains an end-of-track event when its events do not end with one, and
		// its `name` becomes the first track-name event (replacing the text of
		// an existing one, or inserted at the start when there is none and the
		// name is not empty). The format and division are written as they are.
		//
		// Fails when the writer fails, when there are more than 65535 tracks,
		// or when an event cannot be encoded: a delta over 0x0FFFFFFF, a channel message whose status is
		// not 0x80-0xE0, whose channel is over 15 or whose data length does not
		// match its status, a data byte over 0x7F, a meta event with no type
		// byte, or a status that is none of channel, 0xF0, 0xF7 and 0xFF.
		def write(writer io.Writer, runningStatus bool = false) !none {
			fail "midi: {tracks.len()} tracks, at most 65535 fit" when tracks.len() > 65535
			let out = new MidiEncoder()
			out.text("MThd")
			out.u32(6)
			out.u16(format)
			out.u16(uint16(tracks.len()))
			out.u16(division)
			for let (_, track) in tracks {
				let body = new MidiEncoder()
				try body.track(track, runningStatus)
				let chunk = body.bytes()
				out.text("MTrk")
				out.u32(uint32(chunk.len()))
				out.raw(chunk)
			}
			let data = out.bytes()
			let written = 0
			for written < data.len() {
				let n = try writer.write(data[written:])
				fail "midi: writer accepted no bytes" when n <= 0
				written += n
			}
		}
	}

	// MidiTrack is one track of a MIDI file: its name and its events in order.
	type MidiTrack {
		// The text of the track's first track-name event (meta 0x03), with
		// trailing NUL bytes removed. Text that is not UTF-8 is read as
		// Latin-1, which is what most MIDI software writes.
		name   string
		events MidiEvent[]

		// The track's length in ticks: the deltas of all its events.
		def ticks() int {
			let total = 0
			for let (_, event) in events {
				total += int(event.delta)
			}
			return total
		}

		// Appends a note on, `delta` ticks after the event before it.
		def noteOn(channel int, key int, velocity int, delta int = 0) {
			add(MidiStatus.NoteOn, channel, [byte(key & 0x7F), byte(velocity & 0x7F)], delta)
		}

		// Appends a note off, `delta` ticks after the event before it.
		def noteOff(channel int, key int, velocity int = 0, delta int = 0) {
			add(MidiStatus.NoteOff, channel, [byte(key & 0x7F), byte(velocity & 0x7F)], delta)
		}

		// Appends a control change (volume is 7, sustain 64, ...).
		def controlChange(channel int, controller int, value int, delta int = 0) {
			add(MidiStatus.ControlChange, channel, [byte(controller & 0x7F), byte(value & 0x7F)], delta)
		}

		// Appends a program change: the instrument the channel plays.
		def programChange(channel int, program int, delta int = 0) {
			add(MidiStatus.ProgramChange, channel, [byte(program & 0x7F)], delta)
		}

		// Appends a tempo, in microseconds per quarter note (500000 is 120
		// beats a minute).
		def tempo(microsecondsPerQuarter int, delta int = 0) {
			let v = microsecondsPerQuarter & 0xFFFFFF
			events.push(MidiEvent{delta: uint32(delta), status: MidiStatus.Meta, channel: 0, data: [byte(MIDI_META_TEMPO), byte(v >> 16), byte((v >> 8) & 0xFF), byte(v & 0xFF)]})
		}

		// Appends a time signature: `numerator` beats of a `denominator` note
		// (a power of two: 4 for quarters, 8 for eighths).
		def timeSignature(numerator int, denominator int, delta int = 0) {
			let power = 0
			for (1 << power) < denominator && power < 7 {
				power += 1
			}
			events.push(MidiEvent{delta: uint32(delta), status: MidiStatus.Meta, channel: 0, data: [byte(MIDI_META_TIME_SIGNATURE), byte(numerator & 0xFF), byte(power), byte(24), byte(8)]})
		}

		// Appends the end of the track; `write` adds one when it is missing.
		def endOfTrack(delta int = 0) {
			events.push(MidiEvent{delta: uint32(delta), status: MidiStatus.Meta, channel: 0, data: [byte(MIDI_META_END_OF_TRACK)]})
		}

		internal def add(status MidiStatus, channel int, data byte[], delta int) {
			events.push(MidiEvent{delta: uint32(delta), status: status, channel: byte(channel & 0x0F), data: data})
		}
	}

	// What a MIDI event is; the value is its status byte with the channel
	// removed.
	enum MidiStatus {
		NoteOff = 0x80,
		NoteOn = 0x90,
		// Polyphonic key pressure (aftertouch on one key).
		KeyPressure = 0xA0,
		ControlChange = 0xB0,
		ProgramChange = 0xC0,
		// Aftertouch on the whole channel.
		ChannelPressure = 0xD0,
		PitchBend = 0xE0,
		// A system exclusive message.
		SysEx = 0xF0,
		// The continuation of a system exclusive message, or an escaped message.
		SysExContinue = 0xF7,
		// A meta event: text, tempo, time signature, end of track.
		Meta = 0xFF,
	}

	// One event at a tick offset from the previous event on its track.
	//
	// - Channel messages (`NoteOff` .. `PitchBend`): `channel` is 0-15 and
	//   `data` the one or two data bytes. Running status in the file is
	//   expanded, so every message carries its status.
	// - System exclusive (`SysEx`, `SysExContinue`): `channel` 0 and `data`
	//   the bytes after the length, as stored (a complete message ends with
	//   0xF7).
	// - Meta events (`Meta`): `channel` 0, and `data` the meta type followed
	//   by its payload: `[0x51, 0x07, 0xA1, 0x20]` is a tempo of 500000
	//   microseconds per quarter note, `[0x2F]` the end of the track.
	struct MidiEvent {
		delta   uint32
		status  MidiStatus
		channel byte
		data    byte[]
	}
}

internal partial module std.formats.audio.midi {
	use (
		std.bytes
		std.formats.audio::*
	)

	// Meta event types this module reads or writes.
	const (
		MIDI_META_TRACK_NAME     = 0x03
		MIDI_META_END_OF_TRACK   = 0x2F
		MIDI_META_TEMPO          = 0x51
		MIDI_META_TIME_SIGNATURE = 0x58
	)

	// The status of a channel message from its status byte with the channel
	// removed (0x80 .. 0xE0).
	def midiChannelStatus(kind int) MidiStatus {
		switch kind {
			case 0x80:
				return MidiStatus.NoteOff
			case 0x90:
				return MidiStatus.NoteOn
			case 0xA0:
				return MidiStatus.KeyPressure
			case 0xB0:
				return MidiStatus.ControlChange
			case 0xC0:
				return MidiStatus.ProgramChange
			case 0xD0:
				return MidiStatus.ChannelPressure
		}
		return MidiStatus.PitchBend
	}

	// midiText decodes the text of a meta event: UTF-8 when it is valid,
	// otherwise Latin-1, with trailing NUL bytes removed.
	def midiText(payload byte[]) string {
		let end = payload.len()
		for end > 0 && payload[end - 1] == 0 {
			end -= 1
		}
		let raw = payload[:end]
		let text = string(raw)
		return text when text.isUTF8()
		let out byte[]
		for let (_, b) in raw {
			if b < 0x80 {
				out.push(b)
			} else {
				out.push(byte(0xC0 | (int(b) >> 6)), byte(0x80 | (int(b) & 0x3F)))
			}
		}
		return string(out)
	}

	// Reads a MIDI file from bytes in memory: big-endian numbers,
	// variable-length quantities and the events of a track.
	type MidiScanner {
		data byte[]
		// Offset of the next unread byte.
		pos  int

		// A scanner at the start of the bytes.
		def new(data byte[]) {
			self.data = data
			pos = 0
		}

		// How many bytes are left unread.
		def remaining() int {
			return data.len() - pos
		}

		// The next byte, without consuming it. Fails at the end of the data.
		def peek() !byte {
			fail "midi: unexpected end of data" when pos >= data.len()
			return data[pos]
		}

		// Consumes the next byte. Fails at the end of the data.
		def next() !byte {
			let b = try peek()
			pos += 1
			return b
		}

		// Moves past `count` bytes, stopping at the end of the data.
		def skip(count int) {
			pos = (pos + count).min(data.len())
		}

		// Consumes the next `count` bytes. Fails when fewer are left.
		def take(count int) !byte[] {
			expects {
				assert count <= remaining() onerror fail "midi: unexpected end of data ({remaining()} of {count} bytes left)"
			}
			let out = data[pos:pos + count]
			pos += count
			return out
		}

		// Consumes a big-endian 16-bit number. Fails when fewer than 2 bytes are left.
		def u16() !uint16 {
			let b = try take(2)
			return uint16(int(b[0]) << 8 | int(b[1]))
		}

		// Consumes a big-endian 32-bit number. Fails when fewer than 4 bytes are left.
		def u32() !uint32 {
			let b = try take(4)
			return uint32(int(b[0]) << 24 | int(b[1]) << 16 | int(b[2]) << 8 | int(b[3]))
		}

		// Consumes a variable-length quantity: seven bits per byte, most
		// significant first, the top bit set on every byte but the last.
		//
		// Fails when the data ends inside it or it runs over four bytes, the
		// most a file may use (0x0FFFFFFF).
		def quantity() !uint32 {
			let value = 0
			for let i = 0; i < 4; i++ {
				let b = int(try next())
				value = value << 7 | (b & 0x7F)
				return uint32(value) when b < 0x80
			}
			fail "midi: variable-length quantity runs over four bytes"
		}

		// Reads the events of an `MTrk` chunk body, from here to its
		// end-of-track event or the end of the data. Fails as
		// `Midi.fromReader` describes.
		def track() !MidiTrack {
			let track = new MidiTrack()
			let running = 0
			let named = false
			for remaining() > 0 {
				let delta = try quantity()
				let status = int(try peek())
				if status >= 0x80 {
					skip(1)
				} else {
					fail "midi: data byte 0x{status.hex(2)} with no running status" when running == 0
					status = running
				}
				if status == 0xFF {
					let kind = try next()
					let payload = try take(int(try quantity()))
					let content = byte[kind]
					track.events.push(MidiEvent{delta: delta, status: MidiStatus.Meta, channel: 0, data: content.concat(payload)})
					if kind == 0x03 && !named {
						track.name = midiText(payload)
						named = true
					}
					break when kind == 0x2F
				} else if status == 0xF0 || status == 0xF7 {
					let payload = try take(int(try quantity()))
					track.events.push(MidiEvent{delta: delta, status: status == 0xF0 ?? (MidiStatus.SysEx, MidiStatus.SysExContinue), channel: 0, data: payload})
				} else if status >= 0xF0 {
					fail "midi: status 0x{status.hex(2)} cannot appear in a file"
				} else {
					running = status
					let kind = status & 0xF0
					let size = (kind == 0xC0 || kind == 0xD0) ?? (1, 2)
					let payload = try take(size)
					track.events.push(MidiEvent{delta: delta, status: midiChannelStatus(kind), channel: byte(status & 0x0F), data: payload})
				}
			}
			return track
		}
	}

	// Builds the bytes of a MIDI file.
	type MidiEncoder {
		out byte[]

		// Appends the bytes as they are.
		def raw(data byte[]) {
			out = out.concat(data)
		}

		// Appends the text's bytes.
		def text(value string) {
			raw(value.bytes())
		}

		// Appends a big-endian 16-bit number.
		def u16(value uint16) {
			let v = int(value)
			out.push(byte(v >> 8), byte(v & 0xFF))
		}

		// Appends a big-endian 32-bit number.
		def u32(value uint32) {
			let v = int(value)
			out.push(byte(v >> 24 & 0xFF), byte(v >> 16 & 0xFF), byte(v >> 8 & 0xFF), byte(v & 0xFF))
		}

		// Appends a variable-length quantity. Only the low 28 bits are
		// written, the most four bytes hold.
		def quantity(value uint32) {
			let v = int(value) & 0x0FFFFFFF
			let groups = byte[byte(v & 0x7F)]
			v = v >> 7
			for v > 0 {
				groups.push(byte(0x80 | (v & 0x7F)))
				v = v >> 7
			}
			for let i = groups.len() - 1; i >= 0; i-- {
				out.push(groups[i])
			}
		}

		// Appends a meta event after its delta: 0xFF, the type, the payload
		// length and the payload.
		def metaEvent(kind byte, payload byte[]) {
			out.push(0xFF, kind)
			quantity(uint32(payload.len()))
			raw(payload)
		}

		// Appends the body of the track's `MTrk` chunk. Fails as `Midi.write`
		// describes.
		def track(track MidiTrack, runningStatus bool) !none {
			let running = -1
			let name = track.name
			let wantName = !name.isEmpty()
			if wantName {
				let named = false
				for let (_, event) in track.events {
					if event.status == MidiStatus.Meta && event.data.len() > 0 && event.data[0] == MIDI_META_TRACK_NAME {
						named = true
						break
					}
				}
				if !named {
					quantity(0)
					metaEvent(0x03, name.bytes())
				}
			}
			let nameWritten = false
			let ended = false
			for let (_, event) in track.events {
				ended = false
				fail "midi: delta {event.delta} is over 0x0FFFFFFF" when event.delta > 0x0FFFFFFF
				quantity(event.delta)
				let status = int(event.status.value)
				if status == 0xFF {
					fail "midi: meta event with no type byte" when event.data.len() == 0
					let kind = event.data[0]
					let payload = event.data[1:]
					if kind == 0x03 && !nameWritten {
						nameWritten = true
						payload = name.bytes() when wantName && midiText(payload) != name
					}
					metaEvent(kind, payload)
					ended = kind == 0x2F
					running = -1
				} else if status == 0xF0 || status == 0xF7 {
					running = -1
					raw(byte[byte(status)])
					quantity(uint32(event.data.len()))
					raw(event.data)
				} else {
					let kind = status & 0xF0
					fail "midi: status 0x{status.hex(2)} is not a channel message, 0xF0, 0xF7 or 0xFF" when kind < 0x80 || kind == 0xF0 || status != kind
					fail "midi: channel {event.channel} is over 15" when event.channel > 15
					let size = (kind == 0xC0 || kind == 0xD0) ?? (1, 2)
					fail "midi: status 0x{status.hex(2)} takes {size} data bytes, the event has {event.data.len()}" when event.data.len() != size
					for let (_, b) in event.data {
						fail "midi: data byte 0x{int(b).hex(2)} is over 0x7F" when b > 0x7F
					}
					let full = kind | int(event.channel)
					raw(byte[byte(full)]) unless runningStatus && full == running
					running = full
					raw(event.data)
				}
			}
			if !ended {
				quantity(0)
				metaEvent(0x2F, [])
			}
		}

		// The bytes appended so far.
		def bytes() byte[] {
			return out
		}
	}
}
