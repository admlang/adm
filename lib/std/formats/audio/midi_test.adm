partial module std.formats.audio {
	use (
		std.bytes
		std.os
		std.testing
		std.formats.audio.midi::*
	)

	check "Midi" {
		// Sample files live in the repo, and `adm test` runs from its root.
		// A missing sample skips rather than fails.
		let sampleDir = "samples/audio/midi/"

		internal def sample(name string) ?byte[] {
			let data = os.readFile(sampleDir + name)
			return none when data is error
			return data
		}

		// The value, or the fallback when there is none.
		internal def unwrapOr(value ?int, fallback int) int {
			return fallback when value is none
			let got int = value
			return got
		}

		internal def parse(data byte[]) !Midi {
			let midi = new Midi()
			try midi.fromReader(new bytes.Buffer(data))
			return midi
		}

		internal def encode(midi Midi) !byte[] {
			let out = new bytes.Buffer()
			try midi.write(out)
			return out.bytes()
		}

		// "status channel data" of an event, data in uppercase hex.
		internal def show(event MidiEvent) string {
			return "{int(event.status.value).hex(2)} {event.channel} {event.data.hex()}"
		}

		internal def same(a Midi, b Midi) bool {
			return false when a.format != b.format || a.division != b.division || a.tracks.len() != b.tracks.len()
			for let (i, track) in a.tracks {
				let other = b.tracks[i]
				return false when track.name != other.name || track.events.len() != other.events.len()
				for let (j, event) in track.events {
					let twin = other.events[j]
					return false when event.delta != twin.delta || show(event) != show(twin)
				}
			}
			return true
		}

		// Parses the sample and checks its header, per-track event counts and
		// the first track's name; returns the parse, or none when the sample
		// is missing.
		internal def expect(file string, format int, division int, events int[], name string) !?Midi {
			let data = sample(file)
			return none when data is none
			let midi = try parse(data)
			assert int(midi.format) == format
			assert int(midi.division) == division
			assert midi.tracks.len() == events.len()
			for let (i, count) in events {
				assert midi.tracks[i].events.len() == count
			}
			assert midi.tracks[0].name == name
			return midi
		}

		internal def files() string[] {
			return [
				"fixtures_bossa.mid",
				"fixtures_c-maj-scale.mid",
				"fixtures_closedHat.mid",
				"fixtures_elise.mid",
				"fixtures_elise1track.mid",
				"fixtures_example-format0.mid",
				"fixtures_example-format1.mid",
				"fixtures_satb-basic.mid",
				"fixtures_unquantized.mid",
				"fixtures_unquantized2bars-quantized1_16.mid",
				"fixtures_unquantized2bars-quantized1_32.mid",
				"fixtures_unquantized2bars-quantized1_8.mid",
				"fixtures_unquantized2bars.mid",
				"fixtures_unquantized_quantized-1_32.mid",
				"fixtures_unquantized_quantized-1_32_start_end.mid"
			]
		}

		@test()
		def TestSampleHeaders() !none {
			try expect("fixtures_closedHat.mid", 0, 96, [28], "01 4th Hat Closed Side")
			try expect("fixtures_elise1track.mid", 0, 480, [2147], "F")
			try expect("fixtures_example-format1.mid", 1, 96, [3, 4, 4, 6], "")
			try expect("fixtures_unquantized.mid", 0, 96, [68], "THIS IS A KICK SNARE TEST ")
			try expect("fixtures_unquantized2bars-quantized1_16.mid", 0, 96, [50], "unquantized2bars")
			try expect("fixtures_unquantized2bars-quantized1_32.mid", 0, 96, [50], "unquantized2bars")
			try expect("fixtures_unquantized2bars-quantized1_8.mid", 0, 96, [50], "unquantized2bars")
			try expect("fixtures_unquantized2bars.mid", 0, 96, [50], "")
			try expect("fixtures_unquantized_quantized-1_32.mid", 0, 96, [68], "THIS IS A KICK SNARE TEST ")
			try expect("fixtures_unquantized_quantized-1_32_start_end.mid", 0, 96, [68], "THIS IS A KICK SNARE TEST ")
			try expect("fixtures_bossa.mid", 0, 96, [40], "bossa 1")
			try expect("fixtures_c-maj-scale.mid", 1, 480, [34], "")
			try expect("fixtures_satb-basic.mid", 1, 480, [19, 17, 25, 25], "")
		}

		@test()
		def TestBossa() !none {
			let midi = try expect("fixtures_bossa.mid", 0, 96, [40], "bossa 1")
			return none when midi is none
			assert show(midi.tracks[0].events[0]) == "FF 0 03626F737361203100"
			assert show(midi.tracks[0].events[3]) == "90 0 2430"
		}

		@test()
		def TestScale() !none {
			let midi = try expect("fixtures_c-maj-scale.mid", 1, 480, [34], "")
			return none when midi is none
			assert show(midi.tracks[0].events[1]) == "FF 0 590000"
			assert show(midi.tracks[0].events[3]) == "B0 0 7900"
			assert midi.tracks[0].events[33].delta == 1
			assert show(midi.tracks[0].events[33]) == "FF 0 2F"
		}

		@test()
		def TestSatb() !none {
			let midi = try expect("fixtures_satb-basic.mid", 1, 480, [19, 17, 25, 25], "")
			return none when midi is none
			assert show(midi.tracks[2].events[5]) == "B0 2 5B00"
		}

		// The example file of the SMF specification, which uses running status.
		@test()
		def TestSpecExample() !none {
			let midi = try expect("fixtures_example-format0.mid", 0, 96, [14], "")
			return none when midi is none
			let events = midi.tracks[0].events
			let want = [
				"0 FF 0 5804021808",
				"0 FF 0 5107A120",
				"0 C0 0 05",
				"0 C0 1 2E",
				"0 C0 2 46",
				"0 90 2 3060",
				"0 90 2 3C60",
				"96 90 1 4340",
				"96 90 0 4C20",
				"192 80 2 3040",
				"0 80 2 3C40",
				"0 80 1 4340",
				"0 80 0 4C40",
				"0 FF 0 2F"
			]
			for let (i, line) in want {
				assert "{events[i].delta} {show(events[i])}" == line
			}
		}

		@test()
		def TestElise() !none {
			let midi = try expect("fixtures_elise.mid", 1, 960, [5, 2355, 7, 7], "Track 0")
			return none when midi is none
			// The name is stored as Latin-1 (0xFC for ü).
			assert midi.tracks[1].name == "Für Elise"
			assert midi.tracks[2].name == "http://www.forelise.com/"
			assert midi.tracks[3].name == "Composed by Ludwig van Beethoven"
			assert show(midi.tracks[1].events[4]) == "FF 0 0346FC7220456C697365"
			assert show(midi.tracks[3].events[3]) == "FF 0 5803030C08"
			let noteOn = 0
			let noteOff = 0
			let ticks = 0
			for let (_, event) in midi.tracks[1].events {
				noteOn += 1 when event.status == MidiStatus.NoteOn
				noteOff += 1 when event.status == MidiStatus.NoteOff
				ticks += int(event.delta)
			}
			assert noteOn == 1068
			assert noteOff == 1068
			assert ticks == 190080
		}

		@test()
		def TestRoundTrip() !none {
			for let (_, file) in files() {
				let data = sample(file)
				continue when data is none
				let midi = try parse(data)
				let again = try parse(try encode(midi))
				assert same(midi, again)
			}
		}

		@test()
		def TestQuantity() !none {
			let encodings = [
				byte[0x00],
				byte[0x40],
				byte[0x7F],
				byte[0x81, 0x00],
				byte[0xC0, 0x00],
				byte[0xFF, 0x7F],
				byte[0x81, 0x80, 0x00],
				byte[0x81, 0x80, 0x80, 0x00],
				byte[0xFF, 0xFF, 0xFF, 0x7F]
			]
			let values = [0, 0x40, 0x7F, 0x80, 0x2000, 0x3FFF, 0x4000, 0x200000, 0x0FFFFFFF]
			for let (i, encoded) in encodings {
				let scan = new MidiScanner(encoded)
				assert int(try scan.quantity()) == values[i]
				assert scan.remaining() == 0
				let out = new MidiEncoder()
				out.quantity(uint32(values[i]))
				assert out.bytes().hex() == encoded.hex()
			}
			assert new MidiScanner(byte[0x81]).quantity() is error
			assert new MidiScanner(byte[0x80, 0x80, 0x80, 0x80, 0x00]).quantity() is error
		}

		// A format 0 file with SMPTE division (25 fps, 40 ticks per frame),
		// system exclusive messages, running status, no end-of-track event.
		internal def handmade() byte[] {
			return [
				0x4D, 0x54, 0x68, 0x64, 0, 0, 0, 6, 0, 0, 0, 1, 0xE7, 0x28,
				0x4D, 0x54, 0x72, 0x6B, 0, 0, 0, 21,
				0x00, 0xF0, 0x05, 0x7E, 0x7F, 0x09, 0x01, 0xF7,
				0x00, 0x91, 0x3C, 0x64,
				0x81, 0x00, 0x3C, 0x00,
				0x00, 0xF7, 0x02, 0xF3, 0x01
			]
		}

		@test()
		def TestHandmade() !none {
			let midi = try parse(handmade())
			assert midi.division == 0xE728
			assert int(midi.division) >> 8 == 0xE7 // -25 as a signed byte
			let events = midi.tracks[0].events
			assert events.len() == 4
			assert show(events[0]) == "F0 0 7E7F0901F7"
			assert show(events[1]) == "90 1 3C64"
			assert events[2].delta == 128
			assert show(events[2]) == "90 1 3C00"
			assert show(events[3]) == "F7 0 F301"
			let again = try parse(try encode(midi))
			let written = again.tracks[0].events
			assert written.len() == 5
			assert show(written[4]) == "FF 0 2F"
			for let i = 0; i < 4; i++ {
				assert written[i].delta == events[i].delta
				assert show(written[i]) == show(events[i])
			}
		}

		@test()
		def TestTruncated() !none {
			let data = handmade()
			for let (_, cut) in [0, 4, 10, 14, 18, 22, 25, data.len() - 1] {
				assert parse(data[:cut]) is error
			}
			let wrongId = data.concat([])
			wrongId[0] = 0x58
			assert parse(wrongId) is error
			let format3 = data.concat([])
			format3[9] = 3
			assert parse(format3) is error
			// A data byte before any status byte.
			let orphan = data.concat([])
			orphan[23] = 0x10
			assert parse(orphan) is error
			let whole = sample("fixtures_elise.mid")
			return none when whole is none
			assert parse(whole[:whole.len() / 2]) is error
			assert parse(whole[:whole.len() - 1]) is error
		}

		@test()
		def TestWrite() !none {
			let track = new MidiTrack()
			track.name = "Piano"
			track.events.push(MidiEvent{delta: 0, status: MidiStatus.NoteOn, channel: 3, data: [60, 100]})
			track.events.push(MidiEvent{delta: 0x0FFFFFFF, status: MidiStatus.NoteOff, channel: 3, data: [60, 0]})
			let midi = new Midi()
			midi.format = 0
			midi.division = 480
			midi.tracks.push(track)
			let data = try encode(midi)
			assert data[:14].hex() == "4D546864000000060000000101E0"
			let again = try parse(data)
			let events = again.tracks[0].events
			assert again.tracks[0].name == "Piano"
			assert events.len() == 4
			assert show(events[0]) == "FF 0 035069616E6F"
			assert show(events[1]) == "90 3 3C64"
			assert events[2].delta == 0x0FFFFFFF
			assert show(events[3]) == "FF 0 2F"
			// Renaming a parsed track rewrites its track-name event.
			again.tracks[0].name = "Organ"
			let renamed = try parse(try encode(again))
			assert renamed.tracks[0].name == "Organ"
			assert renamed.tracks[0].events.len() == 4

			let bad = new MidiTrack()
			bad.events.push(MidiEvent{delta: 0, status: MidiStatus.NoteOn, channel: 16, data: [60, 100]})
			midi.tracks = [bad]
			assert encode(midi) is error
			bad.events = [MidiEvent{delta:0, status:MidiStatus.NoteOn, channel:0, data:[60]}]
			assert encode(midi) is error
			bad.events = [MidiEvent{delta:0, status:MidiStatus.NoteOn, channel:0, data:[60, 0x80]}]
			assert encode(midi) is error
			bad.events = [MidiEvent{delta:0, status:MidiStatus.Meta, channel:0, data:[]}]
			assert encode(midi) is error
		}

		// Built with the track's own methods, a file reads back with the tempo,
		// the division and the events it was given, with or without running
		// status, and running status makes it smaller.
		@test()
		def TestBuildAndReadBack() !none {
			let track = new MidiTrack()
			track.name = "Piano"
			track.tempo(600000)
			track.timeSignature(3, 4)
			track.programChange(0, 1)
			track.noteOn(0, 60, 100)
			track.noteOn(0, 64, 100)
			track.noteOff(0, 60, delta = 480)
			track.noteOff(0, 64)
			track.endOfTrack()
			let midi = new Midi()
			midi.division = uint16(480)
			midi.tracks = [track]
			assert track.ticks() == 480
			assert unwrapOr(midi.ticksPerQuarter(), -1) == 480
			assert midi.smpte() is none
			assert unwrapOr(midi.tempo(), -1) == 600000

			let plain = try encode(midi)
			let packed = new bytes.Buffer()
			try midi.write(packed, runningStatus = true)
			assert packed.bytes().len() < plain.len()
			for let (_, data) in [plain, packed.bytes()] {
				let back = try parse(data)
				assert unwrapOr(back.tempo(), -1) == 600000
				assert back.tracks[0].name == "Piano"
				let notes = back.tracks[0].events.filter(e => e.status == MidiStatus.NoteOn)
				assert notes.len() == 2
				assert int(notes[1].data[0]) == 64
			}
		}

		// SMPTE timing: -25 frames a second in the high byte, 40 ticks a frame.
		@test()
		def TestSmpteDivision() {
			let midi = new Midi()
			midi.division = uint16(0xE728)
			assert midi.ticksPerQuarter() is none
			let smpte = midi.smpte()
			assert !(smpte is none)
			return when smpte is none
			let pair (int, int) = smpte
			let (fps, ticks) = pair
			assert fps == 25
			assert ticks == 40
		}
	}
}
