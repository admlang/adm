internal partial module std.formats.audio.mp3 {
	// Reads bits most significant first from a byte array. Reading past the
	// end yields zero bits, never a fault, so damaged data decodes to noise
	// rather than stopping the program.
	type Mp3Bits {
		data byte[]
		// Position in bits from the start of `data`.
		pos  int

		def new() {}

		// Points the reader at `source`, from byte `start`.
		def reset(source byte[], start int) {
			data = source
			pos = start * 8
		}

		// The next `n` bits (at most 24) without consuming them.
		def peek(n int) int {
			let at = pos >> 3
			return slowPeek(n) when at + 3 >= data.len()
			let word = (int(data[at]) << 24) | (int(data[at + 1]) << 16) | (int(data[at + 2]) << 8) | int(data[at + 3])
			return (word >> (32 - (pos & 7) - n)) & ((1 << n) - 1)
		}

		// `peek` near the end of the data, where missing bytes read as zero.
		def slowPeek(n int) int {
			let at = pos >> 3
			let word = 0
			for let i = 0; i < 4; i++ {
				word = word << 8
				word = word | int(data[at + i]) when at + i >= 0 && at + i < data.len()
			}
			return (word >> (32 - (pos & 7) - n)) & ((1 << n) - 1)
		}

		// Reads `n` bits (at most 24).
		def read(n int) int {
			return 0 when n <= 0
			let v = peek(n)
			pos += n
			return v
		}

		// Reads one bit.
		def bit() int {
			let at = pos >> 3
			let v = 0
			v = (int(data[at]) >> (7 - (pos & 7))) & 1 when at < data.len()
			pos++
			return v
		}

		// Steps over `n` bits.
		def skip(n int) {
			pos += n
		}
	}

	// Writes bits most significant first into a growing byte array.
	type Mp3BitWriter {
		data byte[]
		// Bytes completed in `data`.
		size int
		acc  int
		fill int

		def new(capacity int = 4096) {
			data.len(capacity)
			size = 0
			acc = 0
			fill = 0
		}

		// Appends the low `n` bits of `value` (n at most 32).
		def put(value int, n int) {
			return when n <= 0
			acc = (acc << n) | (value & ((1 << n) - 1))
			fill += n
			for fill >= 8 {
				fill -= 8
				push(byte((acc >> fill) & 0xFF))
			}
			acc = acc & ((1 << fill) - 1)
		}

		def push(b byte) {
			data.len(data.len() * 2 + 16) when size >= data.len()
			data[size] = b
			size++
		}

		// Bits written so far.
		def bits() int {
			return size * 8 + fill
		}

		// Pads the last byte with zero bits.
		def align() {
			put(0, 8 - fill) when fill != 0
		}

		// The bytes written, the last one padded with zero bits.
		def bytes() byte[] {
			align()
			return data[0:size]
		}

		// Forgets everything written, keeping the storage.
		def clear() {
			size = 0
			acc = 0
			fill = 0
		}
	}
}
