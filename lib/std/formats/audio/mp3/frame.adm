internal partial module std.formats.audio.mp3 {
	// The four-byte header that opens every MPEG audio frame (ISO/IEC 11172-3
	// 2.4.1.3), decoded.
	type Mp3FrameHeader {
		// Whether the frame is MPEG-2 or MPEG-2.5 (lower sampling frequencies),
		// whose frames carry one granule instead of two.
		lsf        bool
		// Whether the frame is MPEG-2.5.
		mpeg25     bool
		// Audio layer: 1, 2 or 3.
		layer      int
		// Whether a 16-bit CRC follows the header.
		crc        bool
		// Bit rate in kbit/s.
		bitrate    int
		sampleRate int
		// Index into the per-rate tables, 0..8 in the order of `mp3SampleRates`.
		rateIndex  int
		padding    int
		// Channel mode: 0 stereo, 1 joint stereo, 2 dual channel, 3 mono.
		mode       int
		// Joint stereo extension: bit 0 intensity stereo, bit 1 M/S stereo.
		modeExt    int
		channels   int
		// Whole frame length in bytes, header included.
		frameBytes int
		// PCM frames the frame decodes to: 1152, or 576 for MPEG-2/2.5.
		samples    int
		// Length of the side information in bytes.
		sideBytes  int

		def new() {}

		// Bytes of main data the frame carries after its header, CRC and side
		// information.
		def mainBytes() int {
			let crcBytes = crc ?? (2, 0)
			return frameBytes - 4 - crcBytes - sideBytes
		}

		// Whether `other` belongs to the same stream: same version, rate and
		// channel count, which a false sync inside frame data rarely matches.
		def matches(other Mp3FrameHeader) bool {
			return lsf == other.lsf && mpeg25 == other.mpeg25 && layer == other.layer && rateIndex == other.rateIndex && channels == other.channels
		}
	}

	// Decodes the MPEG audio frame header in the four bytes at `at`, none when
	// they are not one (no sync or a reserved field). A free-format header
	// (bit rate index 0) needs the stream's frame size without padding in
	// `freeSize`, which `mp3FreeFormatSize` finds; with 0 it is none too.
	def mp3ParseHeader(data byte[], at int, freeSize int = 0) ?Mp3FrameHeader {
		return none when at < 0 || at + 4 > data.len()
		let b1 = int(data[at + 1])
		let b2 = int(data[at + 2])
		let b3 = int(data[at + 3])
		return none when int(data[at]) != 0xFF || (b1 & 0xE0) != 0xE0
		let version = (b1 >> 3) & 3
		let layer = (b1 >> 1) & 3
		return none when version == 1 || layer == 0
		let bitrateIndex = b2 >> 4
		let rateBits = (b2 >> 2) & 3
		return none when bitrateIndex == 15 || rateBits == 3
		return none when bitrateIndex == 0 && freeSize <= 0
		// Emphasis 2 is reserved.
		return none when (b3 & 3) == 2

		let h = new Mp3FrameHeader()
		h.lsf = version != 3
		h.mpeg25 = version == 0
		h.crc = (b1 & 1) == 0
		h.rateIndex = rateBits + (h.lsf ?? ((h.mpeg25 ?? (6, 3)), 0))
		h.sampleRate = mp3SampleRates[h.rateIndex]
		h.layer = 4 - layer
		h.bitrate = mp3Bitrates[bitrateIndex + (h.lsf ?? (16, 0))]
		h.bitrate = mp3Layer12Bitrate(h.layer, h.lsf, bitrateIndex) when h.layer != 3
		h.padding = (b2 >> 1) & 1
		h.mode = b3 >> 6
		h.modeExt = (b3 >> 4) & 3
		h.channels = h.mode == 3 ?? (1, 2)
		h.samples = h.lsf ?? (576, 1152)
		h.frameBytes = (h.samples / 8) * h.bitrate * 1000 / h.sampleRate + h.padding
		if h.layer == 1 {
			h.samples = 384
			h.frameBytes = (12 * h.bitrate * 1000 / h.sampleRate + h.padding) * 4
			h.sideBytes = 0
		} else if h.layer == 2 {
			h.samples = 1152
			h.frameBytes = 144 * h.bitrate * 1000 / h.sampleRate + h.padding
			h.sideBytes = 0
		} else if h.lsf {
			h.sideBytes = h.channels == 1 ?? (9, 17)
		} else {
			h.sideBytes = h.channels == 1 ?? (17, 32)
		}
		if bitrateIndex == 0 {
			// The bit rate follows from the size: slots of 4 bytes for
			// Layer I, bytes for the others.
			let slotBytes = h.layer == 1 ?? (4, 1)
			h.frameBytes = freeSize + h.padding * slotBytes
			let perFrame = h.layer == 1 ?? (48, h.samples / 8)
			h.bitrate = freeSize * h.sampleRate / perFrame / 1000
			return none when h.bitrate <= 0 || h.frameBytes <= 4 + h.sideBytes
		}
		return h
	}

	// Whether the four bytes at `at` are a free-format frame header.
	def mp3IsFreeFormat(data byte[], at int) bool {
		return false when at < 0 || at + 4 > data.len() || (int(data[at + 2]) >> 4) != 0
		return mp3ParseHeader(data, at, 1 << 20) is Mp3FrameHeader
	}

	// The frame size without padding of the free-format frame at `at`: the
	// distance to the next header of the same stream in `data[:end]`, less
	// this frame's padding. 0 when `at` is not a free-format header or no
	// next header lies within `mp3FreeFormatLimit` bytes.
	def mp3FreeFormatSize(data byte[], at int, end int) int {
		return 0 unless mp3IsFreeFormat(data, at)
		let h = mp3ParseHeader(data, at, 1 << 20)
		return 0 when h is none
		let b1 = int(data[at + 1])
		let b2 = int(data[at + 2]) & 0xFD
		let mode = int(data[at + 3]) >> 6
		let slotBytes = h.layer == 1 ?? (4, 1)
		let last = (end - 4).min(at + mp3FreeFormatLimit)
		for let pos = at + 4 + h.sideBytes + 1; pos <= last; pos++ {
			continue when int(data[pos]) != 0xFF || int(data[pos + 1]) != b1
			continue when (int(data[pos + 2]) & 0xFD) != b2 || (int(data[pos + 3]) >> 6) != mode
			let size = pos - at - h.padding * slotBytes
			continue when h.layer == 1 && (size & 3) != 0
			return size
		}
		return 0
	}

	// The farthest a free-format frame's successor is looked for: the
	// largest frame of the formats, 640 kbit/s Layer III at 32 kHz (2881
	// bytes), with room to spare.
	const mp3FreeFormatLimit = 8192
}
