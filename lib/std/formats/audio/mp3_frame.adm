internal partial module std.formats.audio.mp3 {
	// The four-byte header that opens every MPEG audio frame (ISO/IEC 11172-3
	// 2.4.1.3), decoded.
	type Mp3FrameHeader {
		// Whether the frame is MPEG-2 or MPEG-2.5 (lower sampling frequencies),
		// whose frames carry one granule instead of two.
		lsf        bool
		// Whether the frame is MPEG-2.5.
		mpeg25     bool
		// Whether a 16-bit CRC follows the header.
		crc        bool
		// Bit rate in kbit/s.
		bitrate    int
		sampleRate int
		// Index into the per-rate tables, 0..8 in the order of `mp3SampleRates`.
		rateIndex  int
		padding    int
		// Channel mode: 0 stereo, 1 joint stereo, 2 dual channel, 3 mono.
		mode       int
		// Joint stereo extension: bit 0 intensity stereo, bit 1 M/S stereo.
		modeExt    int
		channels   int
		// Whole frame length in bytes, header included.
		frameBytes int
		// PCM frames the frame decodes to: 1152, or 576 for MPEG-2/2.5.
		samples    int
		// Length of the side information in bytes.
		sideBytes  int

		def new() {}

		// Bytes of main data the frame carries after its header, CRC and side
		// information.
		def mainBytes() int {
			let crcBytes = crc ?? (2, 0)
			return frameBytes - 4 - crcBytes - sideBytes
		}

		// Whether `other` belongs to the same stream: same version, rate and
		// channel count, which a false sync inside frame data rarely matches.
		def matches(other Mp3FrameHeader) bool {
			return lsf == other.lsf && mpeg25 == other.mpeg25 && rateIndex == other.rateIndex && channels == other.channels
		}
	}

	// Decodes the Layer III frame header in the four bytes at `at`, none when
	// they are not one (no sync, a reserved field, free format, or Layer I/II).
	def mp3ParseHeader(data byte[], at int) ?Mp3FrameHeader {
		return none when at < 0 || at + 4 > data.len()
		let b1 = int(data[at + 1])
		let b2 = int(data[at + 2])
		let b3 = int(data[at + 3])
		return none when int(data[at]) != 0xFF || (b1 & 0xE0) != 0xE0
		let version = (b1 >> 3) & 3
		let layer = (b1 >> 1) & 3
		return none when version == 1 || layer != 1
		let bitrateIndex = b2 >> 4
		let rateBits = (b2 >> 2) & 3
		return none when bitrateIndex == 0 || bitrateIndex == 15 || rateBits == 3
		// Emphasis 2 is reserved.
		return none when (b3 & 3) == 2

		let h = new Mp3FrameHeader()
		h.lsf = version != 3
		h.mpeg25 = version == 0
		h.crc = (b1 & 1) == 0
		h.rateIndex = rateBits + (h.lsf ?? ((h.mpeg25 ?? (6, 3)), 0))
		h.sampleRate = mp3SampleRates[h.rateIndex]
		h.bitrate = mp3Bitrates[bitrateIndex + (h.lsf ?? (16, 0))]
		h.padding = (b2 >> 1) & 1
		h.mode = b3 >> 6
		h.modeExt = (b3 >> 4) & 3
		h.channels = h.mode == 3 ?? (1, 2)
		h.samples = h.lsf ?? (576, 1152)
		h.frameBytes = (h.samples / 8) * h.bitrate * 1000 / h.sampleRate + h.padding
		if h.lsf {
			h.sideBytes = h.channels == 1 ?? (9, 17)
		} else {
			h.sideBytes = h.channels == 1 ?? (17, 32)
		}
		return h
	}
}
