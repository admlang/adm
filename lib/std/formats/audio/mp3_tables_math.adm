internal partial module std.formats.audio.mp3 {
	use std.math

	// The tables Layer III decoding and encoding compute once from the
	// constants in `mp3_tables.adm`: Huffman lookup tables, the power laws of
	// requantization, transform kernels and windows.
	type Mp3Tables {
		// Two-level Huffman lookup tables of the distinct code tables. A
		// non-negative entry is `symbol << 5 | length`; a negative one points
		// at a second-level table as `-(start << 5 | bits) - 1`.
		huff           int[]
		// Start of each distinct code table's 256-entry root in `huff`.
		huffRoot       int[]
		// |x|^(4/3) for x up to 8206, the largest escaped value.
		pow43          float[]
		// 2^(q/4) for q = index - `mp3GainBias`.
		gain           float[]
		// cos(π/72 (2i+19)(2k+1)): rows i = 0..8 and 18..26 of the 36-point
		// IMDCT, the only ones it needs by symmetry.
		imdctLong      float[]
		// Rows i < 12 of the 12-point IMDCT, cos(π/24 (2i+7)(2k+1)).
		imdctShort     float[]
		// The four 36-sample windows by block type; block type 2 holds the
		// 12-sample short window in its first entries.
		windows        float[]
		// cos(i (2k+1) π/64), the 32-point DCT the synthesis matrixing
		// reduces to, row i.
		dct            float[]
		// The 512 synthesis window coefficients D.
		synth          float[]
		// Alias reduction butterfly coefficients.
		aliasCs        float[]
		aliasCa        float[]
		// MPEG-1 intensity stereo factors of the left and right channel by
		// intensity position 0..6.
		intensityLeft  float[]
		intensityRight float[]
		// MPEG-2 intensity stereo factors, [scale][channel][position] with
		// scale 0..1, channel 0..1 and position 0..15.
		intensityLsf   float[]

		def new() {
			buildHuffman()
			buildPowers()
			buildTransforms()
			buildStereo()
		}

		// Builds the Huffman lookup tables from the codewords.
		def buildHuffman() {
			huffRoot.len(mp3HuffStart.len())
			let prefixBits int[]
			prefixBits.len(256)
			for let t = 0; t < mp3HuffStart.len(); t++ {
				let first = mp3HuffStart[t]
				let count = mp3HuffCount[t]
				let width = 0
				for width * width < count {
					width++
				}
				let root = huff.len()
				huffRoot[t] = root
				huff.len(root + 256)
				for let p = 0; p < 256; p++ {
					prefixBits[p] = 0
				}
				for let e = 0; e < count; e++ {
					let len = mp3HuffLens[first + e]
					let code = mp3HuffCodes[first + e]
					let sym = t >= mp3HuffSource[32] ?? (e, ((e / width) << 4) | (e % width))
					if len <= 8 {
						let lo = code << (8 - len)
						for let k = 0; k < 1 << (8 - len); k++ {
							huff[root + lo + k] = (sym << 5) | len
						}
					} else {
						let p = code >> (len - 8)
						prefixBits[p] = prefixBits[p].max(len - 8)
					}
				}
				for let p = 0; p < 256; p++ {
					continue when prefixBits[p] == 0
					let sub = huff.len()
					huff.len(sub + (1 << prefixBits[p]))
					huff[root + p] = 0 - ((sub << 5) | prefixBits[p]) - 1
				}
				for let e = 0; e < count; e++ {
					let len = mp3HuffLens[first + e]
					continue when len <= 8
					let code = mp3HuffCodes[first + e]
					let p = code >> (len - 8)
					let d = 0 - huff[root + p] - 1
					let sub = d >> 5
					let bits = d & 31
					let rest = len - 8
					let lo = (code & ((1 << rest) - 1)) << (bits - rest)
					let sym = t >= mp3HuffSource[32] ?? (e, ((e / width) << 4) | (e % width))
					for let k = 0; k < 1 << (bits - rest); k++ {
						huff[sub + lo + k] = (sym << 5) | rest
					}
				}
			}
		}

		// The requantization power laws.
		def buildPowers() {
			pow43.len(8207)
			let guess = 1.0
			for let i = 1; i < 8207; i++ {
				let x = float(i)
				// Newton's method on y^3 = x from the previous cube root.
				let y = guess
				for let n = 0; n < 50; n++ {
					let next = y - (y * y * y - x) / (3.0 * y * y)
					break when next == y
					y = next
				}
				guess = y
				pow43[i] = x * y
			}
			pow43[0] = 0.0
			let quarter = float[1.0, math.sqrt(math.sqrt(2.0)), math.sqrt(2.0), math.sqrt(2.0) * math.sqrt(math.sqrt(2.0))]
			gain.len(mp3GainBias + 128)
			for let i = 0; i < gain.len(); i++ {
				let q = i - mp3GainBias
				let e = q >> 2
				let v = quarter[q & 3]
				for let n = 0; n < e; n++ {
					v *= 2.0
				}
				for let n = 0; n > e; n-- {
					v *= 0.5
				}
				gain[i] = v
			}
		}

		// The transform kernels and windows.
		def buildTransforms() {
			imdctLong.len(18 * 18)
			for let i = 0; i < 18; i++ {
				let row = i < 9 ?? (i, i + 9)
				for let k = 0; k < 18; k++ {
					imdctLong[i * 18 + k] = math.cos(math.Pi / 72.0 * float((2 * row + 19) * (2 * k + 1)))
				}
			}
			imdctShort.len(12 * 6)
			for let i = 0; i < 12; i++ {
				for let k = 0; k < 6; k++ {
					imdctShort[i * 6 + k] = math.cos(math.Pi / 24.0 * float((2 * i + 7) * (2 * k + 1)))
				}
			}
			windows.len(4 * 36)
			for let i = 0; i < 36; i++ {
				let long = math.sin(math.Pi / 36.0 * (float(i) + 0.5))
				windows[i] = long
				// Start window: long rise, flat, short fall, zeros.
				if i < 18 {
					windows[36 + i] = long
				} else if i < 24 {
					windows[36 + i] = 1.0
				} else if i < 30 {
					windows[36 + i] = math.sin(math.Pi / 12.0 * (float(i - 18) + 0.5))
				}
				// Stop window: zeros, short rise, flat, long fall.
				if i >= 6 && i < 12 {
					windows[108 + i] = math.sin(math.Pi / 12.0 * (float(i - 6) + 0.5))
				} else if i >= 12 && i < 18 {
					windows[108 + i] = 1.0
				} else if i >= 18 {
					windows[108 + i] = long
				}
			}
			for let i = 0; i < 12; i++ {
				windows[72 + i] = math.sin(math.Pi / 12.0 * (float(i) + 0.5))
			}
			dct.len(32 * 32)
			for let i = 0; i < 32; i++ {
				for let k = 0; k < 32; k++ {
					dct[i * 32 + k] = math.cos(float(i * (2 * k + 1)) * math.Pi / 64.0)
				}
			}
			synth.len(512)
			for let i = 0; i < 257; i++ {
				let v = float(mp3SynthWindow[i]) / 65536.0
				synth[i] = v
				synth[512 - i] = (i & 63) != 0 ?? (0.0 - v, v) when i != 0 && i != 256
			}
			let ci = float[-0.6, -0.535, -0.33, -0.185, -0.095, -0.041, -0.0142, -0.0037]
			aliasCs.len(8)
			aliasCa.len(8)
			for let i = 0; i < 8; i++ {
				let s = math.sqrt(1.0 + ci[i] * ci[i])
				aliasCs[i] = 1.0 / s
				aliasCa[i] = ci[i] / s
			}
		}

		// The intensity stereo factors.
		def buildStereo() {
			intensityLeft.len(7)
			intensityRight.len(7)
			for let i = 0; i < 7; i++ {
				// tan(iπ/12) / (1 + tan(iπ/12)), written with sin and cos so the
				// last position needs no infinity.
				let s = math.sin(float(i) * math.Pi / 12.0)
				let c = math.cos(float(i) * math.Pi / 12.0)
				intensityLeft[i] = s / (s + c)
				intensityRight[i] = c / (s + c)
			}
			intensityLeft[6] = 1.0
			intensityRight[6] = 0.0
			intensityLsf.len(64)
			for let scale = 0; scale < 2; scale++ {
				for let p = 0; p < 16; p++ {
					// io^((p+1)/2) on one side, 1 on the other; io = 2^(-1/4) or 2^(-1/2).
					let q = 0 - (scale + 1) * ((p + 1) >> 1)
					let v = gain[mp3GainBias + q]
					let odd = p & 1
					intensityLsf[scale * 32 + (odd ^ 1) * 16 + p] = v
					intensityLsf[scale * 32 + odd * 16 + p] = 1.0
				}
			}
		}
	}

	// Offset of q = 0 in `Mp3Tables.gain`: exponents below -1024 quarter steps
	// are silence at any resolution.
	const mp3GainBias = 1024
}
