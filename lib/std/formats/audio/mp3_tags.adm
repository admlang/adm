partial module std.formats.audio {
	// The descriptive tags of an MP3 file, from its ID3v2 tag at the start or
	// its ID3v1 tag at the end. An empty string or 0 means the file does not
	// say.
	struct ID3Tags {
		title     string
		artist    string
		album     string
		// Release year.
		year      int
		// Position on the album, counted from 1.
		track     int
		// The front cover picture's file bytes (JPEG or PNG), empty when there
		// is none.
		cover     byte[]
		// MIME type of `cover`: "image/jpeg", "image/png".
		coverMime string
	}
}

internal partial module std.formats.audio.mp3 {
	use std.formats.audio::*

	// Whether the tags hold nothing.
	def id3Empty(tags ID3Tags) bool {
		return tags.title == "" && tags.artist == "" && tags.album == "" && tags.year == 0 && tags.track == 0 && tags.cover.len() == 0
	}

	// Length of the ID3v2 tag at `at`, header and footer included; 0 when
	// there is none.
	def id3v2Length(data byte[], at int) int {
		return 0 when at + 10 > data.len()
		return 0 unless data[at] == byte('I') && data[at + 1] == byte('D') && data[at + 2] == byte('3')
		let major = int(data[at + 3])
		return 0 when major < 2 || major > 4 || data[at + 4] == 0xFF
		let size = id3SyncSafe(data, at + 6)
		return 0 when size < 0
		let footer = (int(data[at + 5]) & 0x10) != 0 ?? (10, 0)
		return 10 + size + footer
	}

	// The 28-bit synchsafe integer in the four bytes at `at`, -1 when a byte
	// has its top bit set.
	def id3SyncSafe(data byte[], at int) int {
		let v = 0
		for let i = 0; i < 4; i++ {
			let b = int(data[at + i])
			return -1 when b >= 0x80
			v = (v << 7) | b
		}
		return v
	}

	// Big-endian integer of `n` bytes at `at`.
	def id3Int(data byte[], at int, n int) int {
		let v = 0
		for let i = 0; i < n; i++ {
			v = (v << 8) | int(data[at + i])
		}
		return v
	}

	// Reads the ID3v2 tag at the start of `data` into `tags`; frames it does
	// not know, and a damaged tag, are passed over.
	def id3ReadV2(data byte[], tags ID3Tags) {
		let total = id3v2Length(data, 0)
		return when total == 0 || total > data.len()
		let major = int(data[3])
		let flags = int(data[5])
		let body = data[10:total - ((flags & 0x10) != 0 ?? (10, 0))]
		body = id3Resync(body) when (flags & 0x80) != 0 && major < 4
		let pos = 0
		if (flags & 0x40) != 0 && major >= 3 && body.len() >= 4 {
			let ext = major == 4 ?? (id3SyncSafe(body, 0), id3Int(body, 0, 4) + 4)
			return when ext < 0 || ext > body.len()
			pos = ext
		}
		let idLen = major == 2 ?? (3, 4)
		let headLen = major == 2 ?? (6, 10)
		for pos + headLen <= body.len() {
			break when body[pos] == 0
			let id = string(body[pos:pos + idLen])
			let size = 0
			if major == 2 {
				size = id3Int(body, pos + 3, 3)
			} else if major == 3 {
				size = id3Int(body, pos + 4, 4)
			} else {
				size = id3SyncSafe(body, pos + 4)
			}
			break when size < 0 || pos + headLen + size > body.len()
			let content = body[pos + headLen:pos + headLen + size]
			if major == 4 {
				let format = int(body[pos + 9])
				content = content[4:] when (format & 0x01) != 0 && content.len() >= 4
				content = id3Resync(content) when (format & 0x02) != 0
			}
			id3Frame(id, content, tags)
			pos += headLen + size
		}
	}

	// Takes one frame's content into the tags when it is one they hold.
	def id3Frame(id string, content byte[], tags ID3Tags) {
		if id := "TIT2" || "TT2" {
			tags.title = id3Text(content)
		} else if id == "TPE1" || id == "TP1" {
			tags.artist = id3Text(content)
		} else if id == "TALB" || id == "TAL" {
			tags.album = id3Text(content)
		} else if id == "TYER" || id == "TYE" || id == "TDRC" {
			tags.year = id3Number(id3Text(content))
		} else if id == "TRCK" || id == "TRK" {
			tags.track = id3Number(id3Text(content))
		} else if id == "APIC" || id == "PIC" {
			id3Picture(id == "PIC", content, tags)
		}
	}

	// Reads an attached picture frame; the front cover (type 3) wins over
	// any other picture.
	def id3Picture(v22 bool, content byte[], tags ID3Tags) {
		return when content.len() < 4
		let enc = int(content[0])
		let pos = 1
		let mime = ""
		if v22 {
			let format = string(content[1:4]).lower()
			mime = format == "png" ?? ("image/png", "image/jpeg")
			pos = 4
		} else {
			let end = pos
			for end < content.len() && content[end] != 0 {
				end++
			}
			mime = string(content[pos:end]).lower()
			pos = end + 1
			if mime := "png" || "jpg" || "jpeg" {
				mime = mime == "png" ?? ("image/png", "image/jpeg")
			}
		}
		return when pos >= content.len()
		let kind = int(content[pos])
		pos++
		// The description, terminated by one zero byte, or two in UTF-16.
		let wide = enc == 1 || enc == 2
		for pos < content.len() {
			if wide {
				break when pos + 1 >= content.len()
				let done = content[pos] == 0 && content[pos + 1] == 0
				pos += 2
				break when done
			} else {
				let done = content[pos] == 0
				pos++
				break when done
			}
		}
		return when pos > content.len()
		return when tags.cover.len() > 0 && kind != 3
		tags.cover = content[pos:]
		tags.coverMime = mime
	}

	// Decodes a text frame's content: an encoding byte, then Latin-1,
	// UTF-16 with a byte order mark, UTF-16BE or UTF-8. The first of several
	// null-separated values is kept.
	def id3Text(content byte[]) string {
		return "" when content.len() < 1
		let enc = int(content[0])
		let raw = content[1:]
		if enc := 1 || 2 {
			let big = enc == 2
			let start = 0
			if raw.len() >= 2 {
				if raw[0] == 0xFF && raw[1] == 0xFE {
					big = false
					start = 2
				} else if raw[0] == 0xFE && raw[1] == 0xFF {
					big = true
					start = 2
				}
			}
			return id3Utf16(raw, start, big)
		}
		let end = 0
		for end < raw.len() && raw[end] != 0 {
			end++
		}
		return string(raw[0:end]).trim() when enc == 3
		return id3Latin1(raw[0:end]).trim()
	}

	// UTF-16 code units from `start` up to a zero unit, as a string.
	def id3Utf16(raw byte[], start int, big bool) string {
		let out byte[]
		let i = start
		for i + 1 < raw.len() {
			let unit = big ?? ((int(raw[i]) << 8) | int(raw[i + 1]), (int(raw[i + 1]) << 8) | int(raw[i]))
			i += 2
			break when unit == 0
			let cp = unit
			if unit >= 0xD800 && unit <= 0xDBFF && i + 1 < raw.len() {
				let low = big ?? ((int(raw[i]) << 8) | int(raw[i + 1]), (int(raw[i + 1]) << 8) | int(raw[i]))
				if low >= 0xDC00 && low <= 0xDFFF {
					cp = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
					i += 2
				}
			}
			id3PushUtf8(out, cp)
		}
		return string(out).trim()
	}

	// Latin-1 bytes as a string.
	def id3Latin1(raw byte[]) string {
		let out byte[]
		for let (_, b) in raw {
			id3PushUtf8(out, int(b))
		}
		return string(out)
	}

	// Appends the UTF-8 encoding of code point `cp`.
	def id3PushUtf8(out byte[], cp int) {
		if cp < 0x80 {
			out.push(byte(cp))
		} else if cp < 0x800 {
			out.push(byte(0xC0 | (cp >> 6)))
			out.push(byte(0x80 | (cp & 0x3F)))
		} else if cp < 0x10000 {
			out.push(byte(0xE0 | (cp >> 12)))
			out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
			out.push(byte(0x80 | (cp & 0x3F)))
		} else {
			out.push(byte(0xF0 | (cp >> 18)))
			out.push(byte(0x80 | ((cp >> 12) & 0x3F)))
			out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
			out.push(byte(0x80 | (cp & 0x3F)))
		}
	}

	// The leading decimal number of `text` ("7/12" is 7, "2020-05-01" is
	// 2020), 0 when it has none.
	def id3Number(text string) int {
		let v = 0
		for let (_, b) in text.bytes() {
			break when b < byte('0') || b > byte('9')
			v = v * 10 + int(b - byte('0'))
		}
		return v
	}

	// Undoes ID3v2 unsynchronisation: every 0xFF 0x00 becomes 0xFF.
	def id3Resync(raw byte[]) byte[] {
		let out byte[]
		for let i = 0; i < raw.len(); i++ {
			out.push(raw[i])
			if raw[i] == 0xFF && i + 1 < raw.len() && raw[i + 1] == 0 {
				i++
			}
		}
		return out
	}

	// Fills the fields `tags` lacks from the ID3v1 tag in the last 128 bytes
	// of `data`, when there is one.
	def id3ReadV1(data byte[], tags ID3Tags) {
		let at = data.len() - 128
		return when at < 0
		return unless data[at] == byte('T') && data[at + 1] == byte('A') && data[at + 2] == byte('G')
		tags.title = id3Field(data, at + 3, 30) when tags.title == ""
		tags.artist = id3Field(data, at + 33, 30) when tags.artist == ""
		tags.album = id3Field(data, at + 63, 30) when tags.album == ""
		tags.year = id3Number(id3Field(data, at + 93, 4)) when tags.year == 0
		// ID3v1.1 keeps the track in the comment's last byte after a zero.
		tags.track = int(data[at + 126]) when tags.track == 0 && data[at + 125] == 0 && data[at + 126] != 0
	}

	// A fixed-width Latin-1 field of an ID3v1 tag, without its padding.
	def id3Field(data byte[], at int, width int) string {
		let end = at
		for end < at + width && data[end] != 0 {
			end++
		}
		return id3Latin1(data[at:end]).trim()
	}

	// The tags as an ID3v2.4 tag, UTF-8 text, without padding.
	def id3Encode(tags ID3Tags) byte[] {
		let frames byte[]
		id3PutText(frames, "TIT2", tags.title)
		id3PutText(frames, "TPE1", tags.artist)
		id3PutText(frames, "TALB", tags.album)
		id3PutText(frames, "TDRC", "{tags.year}") when tags.year > 0
		id3PutText(frames, "TRCK", "{tags.track}") when tags.track > 0
		if tags.cover.len() > 0 {
			let body byte[]
			body.push(0)
			let mime = tags.coverMime == "" ?? ("image/jpeg", tags.coverMime)
			for let (_, b) in mime.bytes() {
				body.push(b)
			}
			body.push(0)
			body.push(3)
			body.push(0)
			for let (_, b) in tags.cover {
				body.push(b)
			}
			id3PutFrame(frames, "APIC", body)
		}
		let out byte[]
		for let (_, b) in "ID3".bytes() {
			out.push(b)
		}
		out.push(4)
		out.push(0)
		out.push(0)
		id3PutSyncSafe(out, frames.len())
		for let (_, b) in frames {
			out.push(b)
		}
		return out
	}

	// Appends a UTF-8 text frame, nothing when the text is empty.
	def id3PutText(frames byte[], id string, text string) {
		return when text == ""
		let body byte[]
		body.push(3)
		for let (_, b) in text.bytes() {
			body.push(b)
		}
		id3PutFrame(frames, id, body)
	}

	// Appends an ID3v2.4 frame.
	def id3PutFrame(frames byte[], id string, body byte[]) {
		for let (_, b) in id.bytes() {
			frames.push(b)
		}
		id3PutSyncSafe(frames, body.len())
		frames.push(0)
		frames.push(0)
		for let (_, b) in body {
			frames.push(b)
		}
	}

	// Appends `v` as a 28-bit synchsafe integer.
	def id3PutSyncSafe(out byte[], v int) {
		out.push(byte((v >> 21) & 0x7F))
		out.push(byte((v >> 14) & 0x7F))
		out.push(byte((v >> 7) & 0x7F))
		out.push(byte(v & 0x7F))
	}
}
