		// Intensity stereo (MPEG-1 positions, illegal ones, and both MPEG-2
		// scales) with M/S, and mixed blocks: streams no common encoder
		// writes, checked against a reference decoder.
		@test()
		def TestDecodeIntensityAndMixedBlocks() !none {
			let a = try decode(clipIntensity44k())
			assert a.info.sampleRate == 44100 && a.samples.len() == 13230 * 2
			assert near(a.samples, 3307 * 2, float[-0.004008, -0.048000, -0.008517, -0.048854])
			assert near(a.samples, 6615 * 2, float[0.116375, -0.005556, 0.116481, -0.012377])
			assert near(a.samples, 9922 * 2, float[0.124718, 0.100118, 0.130060, 0.098927])
			assert (rms(a.samples) - 0.066347).abs() < 0.000002

			let b = try decode(clipIntensity22k())
			assert b.info.sampleRate == 22050 && b.samples.len() == 8820 * 2
			assert near(b.samples, 2205 * 2, float[0.020570, 0.017830, 0.021352, 0.021555])
			assert near(b.samples, 4410 * 2, float[-0.050819, -0.019516, -0.062318, -0.018702])
			assert near(b.samples, 6615 * 2, float[0.038500, 0.046518, 0.036509, 0.043361])
			assert (rms(b.samples) - 0.029224).abs() < 0.000002
		}

		@test()
		def TestSignature() {
			let codec = new MP3()
			assert codec.matchSignature(new bytes.Reader(byte[73, 68, 51, 4, 0, 0, 0, 0, 0, 10])) // an ID3v2 tag
			assert codec.matchSignature(new bytes.Reader(clip8k())) // bare Layer III frames
			assert !codec.matchSignature(new bytes.Reader(byte[0xFF, 0xF1, 0x50, 0x80, 0, 0, 0, 0, 0, 0])) // ADTS AAC, not Layer III
			assert !codec.matchSignature(new bytes.Reader("RIFF....WAVE".bytes())) // a WAV file
			assert !codec.matchSignature(new bytes.Reader(byte[0xFF])) // too short
		}

		@test()
		def TestHeaders() {
			// MPEG-1 128 kbit/s 44.1 kHz joint stereo with padding.
			let h = mp3ParseHeader(byte[0xFF, 0xFB, 0x92, 0x64], 0)
			assert h is Mp3FrameHeader
			if h is Mp3FrameHeader {
				assert !h.lsf && h.sampleRate == 44100 && h.bitrate == 128 && h.channels == 2
				assert h.frameBytes == 418 && h.samples == 1152 && h.sideBytes == 32 && h.mode == 1
			}
			// MPEG-2 64 kbit/s 22.05 kHz mono.
			let m2 = mp3ParseHeader(byte[0xFF, 0xF3, 0x80, 0xC4], 0)
			assert m2 is Mp3FrameHeader
			if m2 is Mp3FrameHeader {
				assert m2.lsf && !m2.mpeg25 && m2.sampleRate == 22050 && m2.bitrate == 64 && m2.channels == 1
				assert m2.frameBytes == 208 && m2.samples == 576 && m2.sideBytes == 9
			}
			// MPEG-2.5 8 kbit/s 8 kHz.
			let m25 = mp3ParseHeader(byte[0xFF, 0xE3, 0x18, 0xC4], 0)
			assert m25 is Mp3FrameHeader
			if m25 is Mp3FrameHeader {
				assert m25.mpeg25 && m25.sampleRate == 8000 && m25.frameBytes == 72
			}
			// MPEG-1 Layer II 160 kbit/s 44.1 kHz, padded.
			let l2 = mp3ParseHeader(byte[0xFF, 0xFD, 0x92, 0x64], 0)
			assert l2 is Mp3FrameHeader
			if l2 is Mp3FrameHeader {
				assert l2.layer == 2 && l2.bitrate == 160 && l2.frameBytes == 523 && l2.samples == 1152 && l2.sideBytes == 0
			}
			// MPEG-1 Layer I 384 kbit/s 48 kHz.
			let l1 = mp3ParseHeader(byte[0xFF, 0xFF, 0xC4, 0x00], 0)
			assert l1 is Mp3FrameHeader
			if l1 is Mp3FrameHeader {
				assert l1.layer == 1 && l1.bitrate == 384 && l1.frameBytes == 384 && l1.samples == 384
			}
			// The reserved layer, free format, a reserved rate and no sync are
			// refused.
			assert mp3ParseHeader(byte[0xFF, 0xF9, 0x92, 0x64], 0) is none
			assert mp3ParseHeader(byte[0xFF, 0xFB, 0x02, 0x64], 0) is none
			assert mp3ParseHeader(byte[0xFF, 0xFB, 0x9C, 0x64], 0) is none
			assert mp3ParseHeader(byte[0x7F, 0xFB, 0x92, 0x64], 0) is none
		}

		// A gapless MPEG-1 mono file: ID3v2.4, Info header and LAME tag.
		@test()
		def TestDecodeMono() !none {
			let data = sample("mp3_5s_sample_file_80KB.mp3")
			return none when data is none
			let a = try decode(data)
			assert a.info.sampleRate == 44100 && a.info.channels == 1
			assert a.info.frames == 220500
			assert a.samples.len() == 220500
			assert near(a.samples, 55125, float[-0.000003, 0.002973, 0.005937, 0.008877])
			assert near(a.samples, 165375, float[-0.000002, 0.002974, 0.005939, 0.008880])
			assert (rms(a.samples) - 0.028764).abs() < 0.000002
		}

		// No Info header: every frame is audio and nothing is trimmed.
		@test()
		def TestDecodeWithoutInfoHeader() !none {
			let data = sample("440hz.mp3")
			return none when data is none
			let a = try decode(data)
			assert a.samples.len() == 223488
			assert near(a.samples, 55872, float[0.175737, 0.237057, 0.297447, 0.356669])
			assert near(a.samples, 167616, float[-0.401379, -0.343228, -0.283712, -0.223093])
			assert (rms(a.samples) - 0.701829).abs() < 0.000002
		}

		// Joint stereo with M/S frames and short blocks.
		@test()
		def TestDecodeStereo() !none {
			let data = sample("sample-file-4.mp3")
			return none when data is none
			let a = try decode(data)
			assert a.info.channels == 2 && a.info.frames == 869400
			assert near(a.samples, 217350 * 2, float[0.006959, 0.025925, 0.011245, 0.026870])
			assert near(a.samples, 434700 * 2, float[0.017919, 0.093388, 0.014658, 0.097172])
			assert near(a.samples, 652050 * 2, float[0.037824, -0.044691, 0.042215, -0.039468])
			assert (rms(a.samples) - 0.054326).abs() < 0.000002
		}

		// MPEG-2.5 and MPEG-2: one granule per frame, the MPEG-2 scale
		// factors and the lower-rate band tables.
		@test()
		def TestDecodeLowerSampleRates() !none {
			let a = try decode(clip8k())
			assert a.info.sampleRate == 8000 && a.info.channels == 1 && a.samples.len() == 4000
			assert near(a.samples, 1000, float[-0.006319, -0.001830, 0.003666, 0.001394])
			assert near(a.samples, 3000, float[0.033416, 0.031035, 0.025655, 0.017174])
			assert (rms(a.samples) - 0.009761).abs() < 0.000002

			let b = try decode(clip22k())
			assert b.info.sampleRate == 22050 && b.info.channels == 2 && b.samples.len() == 8820 * 2
			assert near(b.samples, 2205 * 2, float[0.038530, -0.014175, 0.035248, -0.019415])
			assert near(b.samples, 6615 * 2, float[0.051580, 0.031760, 0.051111, 0.027175])
			assert (rms(b.samples) - 0.035686).abs() < 0.000002
		}

		// Every sample file's header description, and the text file posing
		// as one refused.
		@test()
		def TestInfoOfEverySample() !none {
			let names = string[
				"440hz.mp3", "mp3_5s_sample_file_80KB.mp3", "mp3_15s_sample_file_236KB.mp3", "mp3_30s_sample_file_470KB.mp3",
				"mp3_60s_sample_file_939KB.mp3", "sample-file-1.mp3", "sample-file-2.mp3", "sample-file-3.mp3", "sample-file-4.mp3"
			]
			let frames = int[223488, 220500, 661500, 1323000, 2646000, 13230000, 5298637, 2642220, 869400]
			let channels = int[1, 1, 1, 1, 1, 2, 2, 2, 2]
			for let (i, name) in names {
				let data = sample(name)
				return none when data is none
				let info = try new MP3().info(new bytes.Reader(data))
				assert info.sampleRate == 44100
				assert int(info.channels) == channels[i]
				assert int(info.frames) == frames[i]
				assert info.codec == "mp3" && info.seekable
			}
			let text = sample("sample_podcast_episode.mp3")
			return none when text is none
			let refused = new MP3().open(new bytes.Reader(text))
			assert refused is error
		}

		// The codec registry finds MP3 by signature and by extension.
		@test()
		def TestRegistry() !none {
			let stream = try open(clip22k())
			assert stream.info().codec == "mp3"
			assert codecRegistry.matchExt(".MP3") is MP3
		}

		// Seeking gives the samples reading straight through gives.
		@test()
		def TestSeek() !none {
			let data = sample("mp3_5s_sample_file_80KB.mp3")
			return none when data is none
			let whole = try decode(data)
			let stream = try new MP3().open(new bytes.Reader(data))
			let buf float32[]
			buf.len(64)
			for let (_, at) in int[100000, 5000, 0, 219000, 1153] {
				try stream.seek(uint64(at))
				let n = try stream.read(buf)
				assert n == 64
				for let i = 0; i < 64; i++ {
					assert buf[i] == whole.samples[at + i]
				}
			}
			// Past the end: nothing more to read.
			try stream.seek(300000)
			assert (try stream.read(buf)) == 0
			try stream.close()
			let after = stream.read(buf)
			assert after is error
		}

		// Stereo and MPEG-2 seeking, frames apart and inside one.
		@test()
		def TestSeekLowerRates() !none {
			let whole = try decode(clip22k())
			let stream = try new MP3().open(new bytes.Reader(clip22k()))
			let buf float32[]
			buf.len(20)
			for let (_, at) in int[7000, 577, 3] {
				try stream.seek(uint64(at))
				assert (try stream.read(buf)) == 10
				for let i = 0; i < 20; i++ {
					assert buf[i] == whole.samples[at * 2 + i]
				}
			}
		}

		// Damaged input fails to open or decodes what it can, never faults.
		@test()
		def TestDamagedInput() !none {
			let nothing = new MP3().open(new bytes.Reader(byte[]))
			assert nothing is error
			let noise byte[]
			let seed = 12345
			for let i = 0; i < 4000; i++ {
				seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
				noise.push(byte((seed >> 16) & 0xFF))
			}
			let random = new MP3().open(new bytes.Reader(noise))
			assert random is error

			// Cut short: the whole frames decode.
			let clip = clip22k()
			let cut = try decode(clip[0:1200])
			assert cut.samples.len() > 0 && cut.samples.len() < 8820 * 2

			// Garbage in the middle: the stream resynchronises.
			let hurt = clip22k()
			for let i = 900; i < 1100; i++ {
				hurt[i] = 0x55
			}
			let got = try decode(hurt)
			assert got.samples.len() > 8820
			for let (_, v) in got.samples {
				assert v >= -2.0 && v <= 2.0
			}
		}

		@test()
		def TestTags() !none {
			let data = sample("sample-file-4.mp3")
			return none when data is none
			let tags = try new MP3().tags(data)
			assert tags.title == "The Happy Meeting"
			assert tags.artist == "Samples Files" && tags.album == "Samples files"
			assert tags.year == 2020 && tags.track == 4
			let old = sample("440hz.mp3")
			return none when old is none
			assert (try new MP3().tags(old)).title == "440Hz Sine Wave"

			// ID3v1 at the end.
			let v1 byte[]
			v1.len(128)
			let fields = string["TAG", "Title One", "Some Artist", "An Album", "1999"]
			let at = int[0, 3, 33, 63, 93]
			for let (i, text) in fields {
				for let (k, b) in text.bytes() {
					v1[at[i] + k] = b
				}
			}
			v1[126] = 7
			let t1 = try new MP3().tags(v1)
			assert t1.title == "Title One" && t1.artist == "Some Artist" && t1.album == "An Album"
			assert t1.year == 1999 && t1.track == 7
		}

		// A stereo tone at 44.1 kHz round-trips through the encoder with the
		// exact length (gapless) and a high signal to noise ratio.
		@test()
		def TestEncodeStereo() !none {
			let tone = new Mp3ToneStream(44100, 2, 44100)
			let a = try roundTrip(tone, 128)
			assert a.info.sampleRate == 44100 && a.info.channels == 2
			assert a.samples.len() == 44100 * 2
			// Above 30 dB.
			assert snr(tone, a) > 1000.0
		}

		// Mono at the MPEG-2 and MPEG-2.5 rates.
		@test()
		def TestEncodeLowerRates() !none {
			let t22 = new Mp3ToneStream(22050, 1, 11025)
			let a = try roundTrip(t22, 64)
			assert a.info.sampleRate == 22050 && a.samples.len() == 11025
			assert snr(t22, a) > 1000.0
			let t8 = new Mp3ToneStream(8000, 1, 4000)
			let b = try roundTrip(t8, 32)
			assert b.info.sampleRate == 8000 && b.samples.len() == 4000
			assert snr(t8, b) > 300.0
		}

		// A rate MP3 cannot hold is resampled, extra channels are mixed down.
		@test()
		def TestEncodeReduces() !none {
			let tone = new Mp3ToneStream(96000, 3, 9600)
			let codec = new MP3()
			let out = new bytes.Buffer()
			try codec.encode(tone, out)
			let a = try decode(out.bytes())
			assert a.info.sampleRate == 48000 && a.info.channels == 2
			assert (a.samples.len() / 2 - 4800).abs() <= 1
		}

		// Tags given to the encoder are read back.
		@test()
		def TestEncodeTags() !none {
			let codec = new MP3()
			codec.metadata = ID3Tags{title: "Tone", artist: "Oscillator", album: "Tests", year: 2026, track: 3, cover: byte[1, 2, 3], coverMime: "image/png"}
			let out = new bytes.Buffer()
			try codec.encode(new Mp3ToneStream(44100, 1, 2000), out)
			let tags = try codec.tags(out.bytes())
			assert tags.title == "Tone" && tags.artist == "Oscillator" && tags.album == "Tests"
			assert tags.year == 2026 && tags.track == 3
			assert tags.cover.len() == 3 && tags.cover[2] == 3 && tags.coverMime == "image/png"
			let a = try decode(out.bytes())
			assert a.samples.len() == 2000
		}

