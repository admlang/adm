partial module std.formats.audio {
	use (
		std.testing
		std.bytes
		std.os
		std.math
		std.data.encoding
		std.formats.audio.loader::*
		std.formats.audio.mp3::*
		std.formats.audio.seek::*
	)

	// A sine wave per channel (440 Hz times the channel number plus one) as
	// an AudioStream, for encoding tests.
	internal type Mp3ToneStream {
		// The frame the next read starts at.
		internal framePosition uint64

		rate         int
		channels     int
		frames       int
		internal pos int

		def new(rate int, channels int, frames int) {
			self.rate = rate
			self.channels = channels
			self.frames = frames
			pos = 0
		}

		// The sample of channel `c` at frame `n`.
		def sample(n int, c int) float {
			return 0.4 * math.sin(2.0 * math.Pi * 440.0 * float(c + 1) * float(n) / float(rate))
		}

		def info() AudioInfo {
			return AudioInfo{
				sampleRate: uint32(rate),
				channels: uint16(channels),
				bitDepth: 32,
				format: SampleFormat.Float32,
				frames: uint64(frames),
				codec: "tone",
				seekable: true,
			}
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		internal def readFrames(buf float32[]) !int {
			let n = (buf.len() / channels).min(frames - pos)
			for let f = 0; f < n; f++ {
				for let c = 0; c < channels; c++ {
					buf[f * channels + c] = float32(sample(pos + f, c))
				}
			}
			pos += n
			return n
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		internal def seekFrame(frame uint64) !none {
			pos = int(frame).min(frames)
		}

		def close() !none {}
	}

	check "MP3" {
		// Sample files live in the repo, and `adm test` runs from its root. A
		// missing sample skips rather than fails.
		let sampleDir = "samples/audio/mp3/"

		def sample(name string) ?byte[] {
			let d = os.readFile(sampleDir + name)
			return none when d is error
			return d
		}

		// Decodes the whole file in the bytes.
		def decode(data byte[]) !Audio {
			let stream = try new MP3().open(new bytes.Reader(data))
			defer stream.close()
			return drain(stream)
		}

		// Whether four samples from `at` are within 1e-5 of `want`.
		def near(samples float32[], at int, want float[]) bool {
			for let i = 0; i < want.len(); i++ {
				return false when (float(samples[at + i]) - want[i]).abs() > 0.00001
			}
			return true
		}

		// Root mean square of the samples.
		def rms(samples float32[]) float {
			let sum = 0.0
			for let (_, v) in samples {
				sum += float(v) * float(v)
			}
			return math.sqrt(sum / float(samples.len().max(1)))
		}

		// Ratio of signal to error energy between a tone and its decoding.
		def snr(tone Mp3ToneStream, decoded Audio) float {
			let signal = 0.0
			let noise = 0.0
			let ch = tone.channels.min(2)
			for let n = 0; n < tone.frames; n++ {
				for let c = 0; c < ch; c++ {
					let want = tone.sample(n, c)
					let d = float(decoded.samples[n * ch + c]) - want
					signal += want * want
					noise += d * d
				}
			}
			return signal / noise.max(0.0000000001)
		}

		// Encodes the tone at `kbps` and decodes the result.
		def roundTrip(tone Mp3ToneStream, kbps int) !Audio {
			let codec = new MP3()
			codec.bitrate = kbps
			let out = new bytes.Buffer()
			try codec.encode(tone, out)
			return decode(out.bytes())
		}

