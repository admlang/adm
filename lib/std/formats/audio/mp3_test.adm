		// Layer I and II decode through the same codec, within float32
		// rounding of FFmpeg's floating point decoders.
		@test()
		def TestDecodeLayer1And2() !none {
			let layer2Mono32kBytes = encoding.base64decode(layer2Mono32kFixture) onerror recover byte[]
			let a = try decode(layer2Mono32kBytes)
			assert a.samples.len() == 4608 * 1
			assert near(a.samples, 920, float[-0.0495000, -0.0334264, -0.0138175, 0.0082632])
			assert near(a.samples, 2304, float[0.0554859, 0.0777231, 0.0970795, 0.1124964])
			assert near(a.samples, 4600, float[0.0000153, 0.0000062, 0.0000079, 0.0000097])
			let layer2Stereo48kBytes = encoding.base64decode(layer2Stereo48kFixture) onerror recover byte[]
			a = try decode(layer2Stereo48kBytes)
			assert a.samples.len() == 5760 * 2
			assert near(a.samples, 2304, float[0.0795089, 0.0726020, 0.0826599, 0.0794203])
			assert near(a.samples, 5760, float[-0.0068463, -0.0242789, -0.0013249, -0.0064767])
			assert near(a.samples, 11512, float[0.0755851, -0.0846354, 0.0719098, -0.0720994])
			let layer2Stereo44kBytes = encoding.base64decode(layer2Stereo44kFixture) onerror recover byte[]
			a = try decode(layer2Stereo44kBytes)
			assert a.samples.len() == 5760 * 2
			assert near(a.samples, 2304, float[-0.0952369, -0.0984850, -0.0971957, -0.0920045])
			assert near(a.samples, 5760, float[-0.0391863, -0.0977718, -0.0334533, -0.0994700])
			assert near(a.samples, 11512, float[-0.0731591, -0.0000619, -0.0760958, -0.0185001])
			let layer2LsfBytes = encoding.base64decode(layer2LsfFixture) onerror recover byte[]
			a = try decode(layer2LsfBytes)
			assert a.samples.len() == 3456 * 1
			assert near(a.samples, 688, float[0.1167436, 0.1219550, 0.1178745, 0.1056009])
			assert near(a.samples, 1728, float[-0.0574903, -0.0756302, -0.0885261, -0.0935775])
			assert near(a.samples, 3448, float[-0.0000038, -0.0000044, -0.0000034, -0.0000028])
			let layer1JointBytes = encoding.base64decode(layer1JointFixture) onerror recover byte[]
			a = try decode(layer1JointBytes)
			assert a.samples.len() == 1536 * 2
			assert near(a.samples, 612, float[0.0031824, 0.0329672, 0.1194680, 0.0319861])
			assert near(a.samples, 1536, float[-0.0561082, -0.1581942, 0.1719667, -0.0242747])
			assert near(a.samples, 3064, float[-0.0145675, 0.0039859, -0.2045234, 0.1132894])
			let info = try new MP3().info(new bytes.Reader(encoding.base64decode(layer2LsfFixture) onerror recover byte[]))
			assert info.codec == "mp2" && info.sampleRate == 22050 && info.channels == 1
		}
	}
}
