internal partial module std.formats.audio.mp4 {
	// The ISO base media file format (ISO/IEC 14496-12) box layer the MP4
	// family shares: box headers, big-endian fields, and a writer that sizes
	// boxes as they close. Box types are held as their four bytes read
	// big-endian into an int, so `©nam` compares like any other type.

	const (
		mp4Ftyp = 0x66747970 // ftyp
		mp4Moov = 0x6D6F6F76 // moov
		mp4Mvhd = 0x6D766864 // mvhd
		mp4Trak = 0x7472616B // trak
		mp4Tkhd = 0x746B6864 // tkhd
		mp4Edts = 0x65647473 // edts
		mp4Elst = 0x656C7374 // elst
		mp4Mdia = 0x6D646961 // mdia
		mp4Mdhd = 0x6D646864 // mdhd
		mp4Hdlr = 0x68646C72 // hdlr
		mp4Minf = 0x6D696E66 // minf
		mp4Smhd = 0x736D6864 // smhd
		mp4Dinf = 0x64696E66 // dinf
		mp4Dref = 0x64726566 // dref
		mp4Url  = 0x75726C20 // "url "
		mp4Stbl = 0x7374626C // stbl
		mp4Stsd = 0x73747364 // stsd
		mp4Stts = 0x73747473 // stts
		mp4Stsc = 0x73747363 // stsc
		mp4Stsz = 0x7374737A // stsz
		mp4Stz2 = 0x73747A32 // stz2
		mp4Stco = 0x7374636F // stco
		mp4Co64 = 0x636F3634 // co64
		mp4Mp4a = 0x6D703461 // mp4a
		mp4Alac = 0x616C6163 // alac
		mp4Esds = 0x65736473 // esds
		mp4Wave = 0x77617665 // wave
		mp4Soun = 0x736F756E // soun
		mp4Mdat = 0x6D646174 // mdat
		mp4Mvex = 0x6D766578 // mvex
		mp4Trex = 0x74726578 // trex
		mp4Moof = 0x6D6F6F66 // moof
		mp4Traf = 0x74726166 // traf
		mp4Tfhd = 0x74666864 // tfhd
		mp4Trun = 0x7472756E // trun
		mp4Udta = 0x75647461 // udta
		mp4Meta = 0x6D657461 // meta
		mp4Mdir = 0x6D646972 // mdir
		mp4Appl = 0x6170706C // appl
		mp4Ilst = 0x696C7374 // ilst
		mp4Data = 0x64617461 // data
		mp4Name = 0x6E616D65 // name
		mp4Free = 0x66726565 // free
		mp4Nam  = 0xA96E616D // ©nam
		mp4Art  = 0xA9415254 // ©ART
		mp4Alb  = 0xA9616C62 // ©alb
		mp4Day  = 0xA9646179 // ©day
		mp4Trkn = 0x74726B6E // trkn
		mp4Covr = 0x636F7672 // covr
		mp4Item = 0x2D2D2D2D // "----", a free-form iTunes item
		mp4M4a  = 0x4D344120 // "M4A "
		mp4M4b  = 0x4D344220 // "M4B "
		mp4M4p  = 0x4D345020 // "M4P "
		mp4Isom = 0x69736F6D // isom
		mp4Iso2 = 0x69736F32 // iso2
		mp4Mp41 = 0x6D703431 // mp41
		mp4Mp42 = 0x6D703432 // mp42
		mp4Dash = 0x64617368 // dash
	)

	// One box of an MP4 file: its type and the byte range of its payload.
	struct Mp4Box {
		// The box type's four bytes, big-endian.
		kind  int
		// Offset of the first payload byte, just after the header.
		start int
		// Offset one past the last payload byte.
		end   int
	}

	// Reads boxes and big-endian fields out of the bytes of an MP4 file.
	type Mp4Reader {
		// The whole file.
		data byte[]

		// A reader over the file's bytes.
		def new(data byte[]) {
			self.data = data
		}

		// The byte at `at`.
		def u8(at int) int {
			return int(data[at])
		}

		// The big-endian 16-bit value at `at`.
		def u16(at int) int {
			return int(data[at]) << 8 | int(data[at + 1])
		}

		// The big-endian 24-bit value at `at`.
		def u24(at int) int {
			return int(data[at]) << 16 | int(data[at + 1]) << 8 | int(data[at + 2])
		}

		// The big-endian 32-bit value at `at`, unsigned.
		def u32(at int) int {
			return int(data[at]) << 24 | int(data[at + 1]) << 16 | int(data[at + 2]) << 8 | int(data[at + 3])
		}

		// The big-endian 32-bit value at `at`, signed.
		def s32(at int) int {
			let v = u32(at)
			return v >= 0x80000000 ?? (v - 0x100000000, v)
		}

		// The big-endian 64-bit value at `at`.
		def u64(at int) int {
			return u32(at) << 32 | u32(at + 4)
		}

		// The boxes laid end to end in `start`..`end`.
		//
		// Fails when a box header is cut short or a box runs past `end`.
		def boxes(start int, end int) !Mp4Box[] {
			let found Mp4Box[]
			let at = start
			for at + 8 <= end {
				let size = u32(at)
				let kind = u32(at + 4)
				let header = 8
				if size == 1 {
					fail "m4a: box header cut short at {at}" when at + 16 > end
					size = u64(at + 8)
					header = 16
				} else if size == 0 {
					size = end - at
				}
				fail "m4a: box of {size} bytes at {at} is smaller than its header" when size < header
				fail "m4a: box at {at} runs past its parent" when at + size > end
				found.push(Mp4Box{kind: kind, start: at + header, end: at + size})
				at += size
			}
			return found
		}

		// The boxes inside `parent`'s payload.
		//
		// Fails when one of them is damaged.
		def children(parent Mp4Box) !Mp4Box[] {
			return boxes(parent.start, parent.end)
		}

		// The first box of the kind inside `parent`, none when there is none.
		//
		// Fails when a box inside `parent` is damaged.
		def child(parent Mp4Box, kind int) !?Mp4Box {
			for let (_, box) in try children(parent) {
				return box when box.kind == kind
			}
			return none
		}

		// The box at the end of the path of kinds under `parent`, none when a
		// step is missing.
		//
		// Fails when a box on the way is damaged.
		def path(parent Mp4Box, kinds ...int) !?Mp4Box {
			let at = parent
			for let (_, kind) in kinds {
				let next = try child(at, kind)
				return none when next is none
				at = next
			}
			return at
		}

		// Whether `box`'s payload holds at least `count` bytes.
		def holds(box Mp4Box, count int) bool {
			return box.end - box.start >= count
		}
	}

	// Builds MP4 boxes into bytes, filling in each box's size when it closes.
	type Mp4Writer {
		// The bytes written so far.
		out byte[]

		// An empty writer.
		def new() {}

		// Appends one byte.
		def u8(v int) {
			out.push(byte(v & 0xFF))
		}

		// Appends a big-endian 16-bit value.
		def u16(v int) {
			u8(v >> 8)
			u8(v)
		}

		// Appends a big-endian 24-bit value.
		def u24(v int) {
			u8(v >> 16)
			u8(v >> 8)
			u8(v)
		}

		// Appends a big-endian 32-bit value.
		def u32(v int) {
			u8(v >> 24)
			u8(v >> 16)
			u8(v >> 8)
			u8(v)
		}

		// Appends a big-endian 64-bit value.
		def u64(v int) {
			u32(v >> 32)
			u32(v)
		}

		// Appends `count` zero bytes.
		def zeros(count int) {
			for let i = 0; i < count; i++ {
				out.push(byte(0))
			}
		}

		// Appends the bytes.
		def bytes(data byte[]) {
			for let (_, b) in data {
				out.push(b)
			}
		}

		// Opens a box of the kind and returns where it starts, for `close`.
		def box(kind int) int {
			let at = out.len()
			u32(0)
			u32(kind)
			return at
		}

		// Opens a full box (one with a version and flags) and returns where it
		// starts, for `close`.
		def fullBox(kind int, version int, flags int) int {
			let at = box(kind)
			u8(version)
			u24(flags)
			return at
		}

		// Closes the box opened at `at` by writing its size.
		def close(at int) {
			let size = out.len() - at
			out[at] = byte((size >> 24) & 0xFF)
			out[at + 1] = byte((size >> 16) & 0xFF)
			out[at + 2] = byte((size >> 8) & 0xFF)
			out[at + 3] = byte(size & 0xFF)
		}

		// How many bytes are written.
		def len() int {
			return out.len()
		}
	}
}
