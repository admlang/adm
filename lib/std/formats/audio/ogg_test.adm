partial module std.formats.audio {
	use (
		std.testing
		std.bytes
		std.io
		std.os
		std.math
		std.formats.audio.loader::*
		std.formats.media.ogg::*
		std.formats.media.source::*
		std.formats.audio.seek::*
		std.formats.audio.vorbis::*
	)

	check "Ogg" {
		// Packet sizes that land on, either side of, and across the 255-byte
		// lacing boundary, and one that needs several pages.
		let sizes = int[0, 1, 254, 255, 256, 509, 510, 511, 4000, 70000, 3]

		// A packet of `size` bytes whose content depends on `seed`.
		def packetOf(size int, seed int) byte[] {
			let p byte[]
			p.len(size)
			for let i = 0; i < size; i++ {
				p[i] = byte((i * 7 + seed * 31) & 0xFF)
			}
			return p
		}

		// Whether two byte arrays hold the same bytes.
		def same(a byte[], b byte[]) bool {
			return false when a.len() != b.len()
			for let i = 0; i < a.len(); i++ {
				return false when a[i] != b[i]
			}
			return true
		}

		// Pages of one stream holding every packet of `sizes`.
		def written(serial uint32) !byte[] {
			let out = new bytes.Buffer()
			let w = new OggPacketWriter(out, serial)
			for let (i, size) in sizes {
				try w.write(packetOf(size, i), int64(i * 100))
				try w.flush() when i == 0
			}
			try w.close()
			return out.bytes()
		}

		@test()
		def TestCrcCheckValue() !none {
			// CRC-32 with polynomial 0x04C11DB7, no reflection, initial value
			// 0 and no final xor over "123456789".
			assert oggCrc(0, byte[]("123456789"), 0, 9) == 0x89A1897F
		}

		@test()
		def TestCrcOfSamplePage() !none {
			let data = os.readFile("samples/audio/ogg/ogg_5s_sample_file_13KB.ogg") onerror recover byte[]
			return none when data.len() == 0
			let size = oggHeaderSize + int(data[26]) + 30
			let page byte[]
			page.len(size)
			data[0:size].copy(page)
			let stored = le(page, 22, 4)
			for let i = 22; i < 26; i++ {
				page[i] = 0
			}
			assert oggCrc(0, page, 0, size) == stored
			return none
		}

		@test()
		def TestRoundTripAcrossLacingAndPages() !none {
			let data = try written(77)
			let r = new OggPacketReader(new bytes.Reader(data))
			for let (i, size) in sizes {
				let p = try r.next()
				if p is none {
					assert false // a packet is missing
				} else {
					assert same(p, packetOf(size, i))
				}
				assert r.serial() == 77
			}
			let tail = try r.next()
			assert tail is none
			// The last packet ends the last page, marked end of stream.
			assert r.final()
			assert r.granule() == int64((sizes.len() - 1) * 100)
			return none
		}

		@test()
		def TestPageLayout() !none {
			let data = try written(5)
			let pages = oggPages(data, 5)
			// The first packet has a page of its own; the 70000-byte packet
			// needs more than one page of 255 segments.
			assert pages.len() >= 4
			assert (int(data[5]) & oggBeginning) != 0
			assert int(data[27]) == 0
			let last = pages[pages.len() - 1].offset
			assert (int(data[last + 5]) & oggEnd) != 0
			// A page that ends no packet carries granule -1, and the one after
			// it is marked as continuing a packet.
			let spanning = 0
			for let (k, page) in pages {
				if page.granule == -1 {
					spanning++
					assert (int(data[pages[k + 1].offset + 5]) & oggContinued) != 0
				}
			}
			assert spanning >= 1
			for let (_, page) in pages {
				assert int(data[page.offset + 26]) <= 255
			}
			return none
		}

		@test()
		def TestDamagedPageFails() !none {
			let data = try written(9)
			data[10] = data[10] ^ 0xFF
			let r = new OggPacketReader(new bytes.Reader(data))
			let failed = false
			r.next() onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			return none
		}

		@test()
		def TestOtherStreamsSkipped() !none {
			// Two streams with their pages interleaved: the reader follows the
			// first stream it meets.
			let a = try written(1)
			let b = try written(2)
			let pa = oggPages(a, 1)
			let pb = oggPages(b, 2)
			let mixed = new bytes.Buffer()
			let count = pa.len() > pb.len() ?? (pa.len(), pb.len())
			for let k = 0; k < count; k++ {
				if k < pa.len() {
					let end = k + 1 < pa.len() ?? (pa[k + 1].offset, a.len())
					try mixed.write(a[pa[k].offset:end])
				}
				if k < pb.len() {
					let end = k + 1 < pb.len() ?? (pb[k + 1].offset, b.len())
					try mixed.write(b[pb[k].offset:end])
				}
			}
			let r = new OggPacketReader(new bytes.Reader(mixed.bytes()))
			let n = 0
			for {
				let p = try r.next()
				break when p is none
				assert r.serial() == 1
				n++
			}
			assert n == sizes.len()
			return none
		}
	}

	check "Vorbis" {
		let sampleDir = "samples/audio/ogg/"

		// A sample file's bytes, none when the samples are not reachable
		// from where the suite runs.
		def sample(name string) ?byte[] {
			let d = os.readFile(sampleDir + name)
			return none when d is error
			return d
		}

		// Every frame the stream yields, and the sum of the squared samples.
		def drain(stream AudioStream) !(int, float) {
			let channels = int(stream.info().channels)
			let buf float32[]
			buf.len(1000 * channels)
			let frames = 0
			let energy = 0.0
			for {
				let n = try stream.read(buf)
				break when n == 0
				for let i = 0; i < n * channels; i++ {
					energy += float(buf[i]) * float(buf[i])
				}
				frames += n
			}
			return (frames, energy)
		}

		// Reads `count` frames at the stream's position.
		def frames(stream AudioStream, count int) !float32[] {
			let buf float32[]
			buf.len(count * int(stream.info().channels))
			let n = try stream.read(buf)
			assert n == count
			return buf
		}

		@test()
		def TestCodebookCodewords() !none {
			// The example of Vorbis I §3.2.1: lengths 2 4 4 4 4 2 3 3 give the
			// codewords 00 0100 0101 0110 0111 10 110 111.
			let lengths = int[2, 4, 4, 4, 4, 2, 3, 3]
			let expected = int[0, 4, 5, 6, 7, 2, 6, 7]
			let w = new VorbisBitWriter()
			w.write(0x564342, 24)
			w.write(1, 16)
			w.write(8, 24)
			w.write(0, 1)
			w.write(0, 1)
			for let (_, l) in lengths {
				w.write(l - 1, 5)
			}
			w.write(0, 4)
			// Entries 5, 0, 7, 3, each codeword most significant bit first.
			for let (_, e) in int[5, 0, 7, 3] {
				for let b = lengths[e] - 1; b >= 0; b-- {
					w.write((expected[e] >> b) & 1, 1)
				}
			}
			let r = new VorbisBitReader(w.bytes())
			let book = try vorbisReadCodebook(r)
			for let e = 0; e < 8; e++ {
				assert book.codes[e] == expected[e]
			}
			assert book.decode(r) == 5
			assert book.decode(r) == 0
			assert book.decode(r) == 7
			assert book.decode(r) == 3
			return none
		}

		@test()
		def TestFloor0() !none {
			// Order 4, 44.1 kHz, 256 Bark bins, 6 amplitude bits, offset 80,
			// one book.
			let w = new VorbisBitWriter()
			w.write(4, 8)
			w.write(44100, 16)
			w.write(256, 16)
			w.write(6, 6)
			w.write(80, 8)
			w.write(0, 4)
			w.write(0, 8)
			let floor = try vorbisReadFloor0(new VorbisBitReader(w.bytes()), 1)
			floor.prepare(1, 64, 256)
			let book = new VorbisCodebook(2, int[1, 1])
			try book.build()
			book.values = float[0.6, 1.2, 0.7, 1.4]
			let books = VorbisCodebook[book]

			// Amplitude 40, book 0, entries 0 and 1: coefficients 0.6, 1.2,
			// then 0.7 and 1.4 each plus the last value 1.2 (LSP frequencies
			// spread over 0..π, as an encoder writes them).
			let p = new VorbisBitWriter()
			p.write(40, 6)
			p.write(0, 1)
			p.write(0, 1)
			p.write(1, 1)
			assert floor.decode(new VorbisBitReader(p.bytes()), books, 0)
			let spectrum float[]
			spectrum.len(64)
			spectrum.fill(1.0)
			floor.apply(0, 64, false, spectrum)

			let coef = float[0.6, 1.2, 1.9, 2.6]
			let bark = floor.maps[0]
			assert bark[64] == -1
			for let i = 0; i < 64; i++ {
				assert bark[i] >= 0 && bark[i] < 256
				assert bark[i] >= bark[i - 1] when i > 0
				let x = math.cos(math.π * float(bark[i]) / 256.0)
				let pp = (1.0 - x) / 2.0
				let q = (1.0 + x) / 2.0
				for let j = 0; j < 4; j += 2 {
					let dq = math.cos(coef[j]) - x
					q *= 4.0 * dq * dq
					let dp = math.cos(coef[j + 1]) - x
					pp *= 4.0 * dp * dp
				}
				let want = math.E ** (0.11512925 * (40.0 * 80.0 / 63.0 / math.sqrt(pp + q) - 80.0))
				assert (spectrum[i] - want).abs() <= want * 0.000000001 // the LSP curve of §6.2.3
			}

			// Amplitude 0 marks the channel unused.
			let z = new VorbisBitWriter()
			z.write(0, 6)
			z.write(0, 8)
			assert !floor.decode(new VorbisBitReader(z.bytes()), books, 0)
			return none
		}

		@test()
		def TestSignature() !none {
			let v = new Vorbis()
			let data = sample("ogg_5s_sample_file_13KB.ogg")
			if data is none {
				// The samples are not reachable from here.
			} else {
				assert v.matchSignature(new bytes.Reader(data))
			}
			// An Ogg page carrying an Opus identification header.
			let opus = new bytes.Buffer()
			let w = new OggPacketWriter(opus, 3)
			let head = byte[]("OpusHead")
			for let (_, b) in byte[1, 2, 56, 1, 128, 187, 0, 0, 0, 0, 0] {
				head.push(b)
			}
			try w.write(head, 0)
			try w.close()
			assert !v.matchSignature(new bytes.Reader(opus.bytes()))
			assert !v.matchSignature(new bytes.Reader(byte[]("RIFF....WAVEfmt ")))
			assert !v.matchSignature(new bytes.Reader(byte[]))
			return none
		}

		@test()
		def TestDecodeMonoMatchesReference() !none {
			let data = sample("ogg_5s_sample_file_13KB.ogg")
			return none when data is none
			let stream = try open(data)
			let info = stream.info()
			assert info.sampleRate == 44100
			assert info.channels == 1
			assert info.frames == 220500
			assert info.codec == "vorbis"
			assert info.seekable
			let first = try frames(stream, 1001)
			// Reference values from another decoder of the same file.
			assert (float(first[0]) - -1.9983107790721988e-07).abs() < 1e-6
			assert (float(first[1000]) - -0.00016892474377527833).abs() < 1e-6
			let (count, _) = try drain(stream)
			assert count + 1001 == 220500
			try stream.seek(0)
			let (whole, total) = try drain(stream)
			assert whole == 220500
			assert (total - 205.0837480010019).abs() < 1e-3
			return none
		}

		@test()
		def TestDecodeStereoMatchesReference() !none {
			let data = sample("sample-file-4.ogg")
			return none when data is none
			let stream = try open(data)
			assert stream.info().channels == 2
			assert stream.info().frames == 869400
			let (count, energy) = try drain(stream)
			assert count == 869400
			assert (energy - 5150.643791036393).abs() < 1e-2
			try stream.seek(44100)
			let f = try frames(stream, 1)
			assert (float(f[0]) - 0.03727808967232704).abs() < 1e-6
			assert (float(f[1]) - 0.036018140614032745).abs() < 1e-6
			try stream.seek(600000)
			let g = try frames(stream, 1)
			assert (float(g[0]) - -0.027551710605621338).abs() < 1e-6
			assert (float(g[1]) - -0.060743313282728195).abs() < 1e-6
			return none
		}

		@test()
		def TestSeek() !none {
			let data = sample("ogg_5s_sample_file_13KB.ogg")
			return none when data is none
			let stream = try open(data)
			try stream.seek(150000)
			let a = try frames(stream, 1)
			assert (float(a[0]) - -0.029212260618805885).abs() < 1e-6
			try stream.seek(100000)
			let b = try frames(stream, 2)
			assert (float(b[0]) - -0.05013455078005791).abs() < 1e-6
			assert (float(b[1]) - -0.05036678910255432).abs() < 1e-6
			try stream.seek(220499)
			let c = try frames(stream, 1)
			assert (float(c[0]) - -2.925940862041898e-06).abs() < 1e-6
			let buf float32[]
			buf.len(4)
			assert (try stream.read(buf)) == 0
			try stream.seek(300000)
			assert (try stream.read(buf)) == 0
			return none
		}

		@test()
		def TestLoadThroughRegistry() !none {
			let data = sample("ogg_15s_sample_file_30KB.ogg")
			return none when data is none
			let clip = try load(data)
			assert clip.info.frames == 661500
			assert clip.samples.len() == 661500
			let about = try info(new bytes.Reader(data))
			assert about.codec == "vorbis"
			assert about.length == 15s
			return none
		}

		@test()
		def TestEncodeRoundTrip() !none {
			// A second of two tones, a different one per channel.
			let rate = 44100
			let samples float32[]
			for let i = 0; i < rate + 123; i++ {
				let t = float(i) / float(rate)
				samples.push(float32(0.5 * math.sin(2.0 * math.π * 440.0 * t)))
				samples.push(float32(0.3 * math.sin(2.0 * math.π * 1250.0 * t)))
			}
			let source = new VorbisTestStream(samples, rate)
			let codec = new Vorbis()
			codec.tags.set("TITLE", "Two tones")
			let out = new bytes.Buffer()
			try codec.encode(source, out)
			let encoded = out.bytes()
			assert codec.matchSignature(new bytes.Reader(encoded))
			let tags = try codec.readTags(new bytes.Reader(encoded))
			let title = tags.get("TITLE")
			if title is none {
				assert false // the title tag is missing
			} else {
				assert title == "Two tones"
			}
			let decoded = try open(encoded)
			assert decoded.info().frames == uint64(rate + 123)
			let back float32[]
			back.len(samples.len())
			let n = try decoded.read(back)
			assert n == rate + 123
			let signal = 0.0
			let noise = 0.0
			for let i = 0; i < samples.len(); i++ {
				let d = float(back[i] - samples[i])
				signal += float(samples[i]) * float(samples[i])
				noise += d * d
			}
			// Better than 25 dB.
			assert signal > 316.0 * noise
			return none
		}
	}

	// A stereo AudioStream over samples in memory, the encoder's input in
	// the suite.
	internal type VorbisTestStream {
		// The frame the next read starts at.
		internal framePosition uint64

		internal samples float32[]
		internal rate    int
		internal at      int

		def new(samples float32[], rate int) {
			self.samples = samples
			self.rate = rate
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return AudioInfo{sampleRate: uint32(rate), channels: 2, frames: uint64(samples.len() / 2)}
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream. Does not fail.
		internal def readFrames(buf float32[]) !int {
			let left = samples.len() / 2 - at
			let n = buf.len() / 2
			n = left when left < n
			samples[at * 2:(at + n) * 2].copy(buf)
			at += n
			return n
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream. Does not fail.
		internal def seekFrame(frame uint64) !none {
			at = int(frame)
			return none
		}

		// close implements AudioStream. Does not fail.
		def close() !none {
			return none
		}
	}
}
