partial module std.formats.audio {
	use (
		std.io
		std.bytes
		std.formats.video.media.ogg::*
		std.formats.audio.opus::*
	)

	// The comment header of an Opus file (RFC 7845 section 5.2): the
	// encoder's name and the metadata as Vorbis comments, "NAME=value".
	type OpusTags {
		// The name of the encoder that wrote the file.
		vendor   string   = "std.formats.audio"
		// Comments in "NAME=value" form, NAME in any case.
		comments string[]

		// The value of the first comment called `name` (in any case), none
		// when there is none.
		def get(name string) ?string {
			let key = name.lower() + "="
			for let (_, c) in comments {
				return c[key.len():] when c.lower().startsWith(key)
			}
			return none
		}

		// Adds a comment called `name` with `value`, after any already
		// there.
		def add(name string, value string) {
			comments.push(name + "=" + value)
		}
	}

	// Opus is the codec of Opus audio in Ogg (`.opus`, RFC 7845): decodes
	// every mode of RFC 6716 (SILK, hybrid and CELT, mono, stereo and the
	// multichannel mappings) to 48 kHz float samples, and encodes CELT
	// frames at a constant bit rate.
	@codec("Opus")
	type Opus {
		// The encoder's bit rate in bits per second, for all channels
		// together: 6000 to 510000.
		bitrate       int      = 96000
		// The length of each encoded frame: 2.5, 5, 10 or 20 ms; other
		// values take the nearest.
		frameDuration duration = 20ms
		// The comment header the encoder writes.
		tags          OpusTags = new OpusTags()

		mimeType string[] {
			def get() string[] {
				return string["audio/opus"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".opus"]
			}
		}

		// matchSignature reports whether the reader starts with an Ogg page
		// carrying an Opus identification header.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(27)
			let n = io.readFull(r, b) onerror recover 0
			return false when n != 27
			return false unless b[0] == 79 && b[1] == 103 && b[2] == 103 && b[3] == 83
			let segs byte[]
			segs.len(int(b[26]) + 8)
			let m = io.readFull(r, segs) onerror recover 0
			return false when m != segs.len()
			return opusIsHeader(segs, int(b[26]), "OpusHead")
		}

		// open returns a stream decoding the file as it is read. The
		// compressed bytes are read into memory first, so the stream can
		// seek; a live stream reads page by page instead, and ends with its
		// logical stream. Fails when the file is not Ogg Opus, or the reader
		// fails.
		def open(reader io.Reader, live bool = false) !AudioStream {
			if live {
				let s = new OpusStream(reader)
				try s.load()
				return s
			}
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			let s = new OpusStream(buf.bytes())
			try s.load()
			return s
		}

		// info reads what the headers and the last page say about the file.
		// Fails when it is not Ogg Opus, or the reader fails.
		def info(reader io.Reader) !AudioInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			let s = new OpusStream(buf.bytes())
			try s.load()
			return s.info()
		}

		// readTags reads the comment header of the file. Fails when it is not
		// Ogg Opus, or the reader fails.
		def readTags(reader io.Reader) !OpusTags {
			let ogg = new OggPacketReader(reader)
			let head = try ogg.next()
			fail "opus: no identification header" when head is none
			let comments = try ogg.next()
			fail "opus: no comment header" when comments is none
			return opusParseTags(comments)
		}

		// decoder returns a decoder of Opus packets as a container stores
		// them, for the stream the OpusHead identification header in
		// `config` describes, with its output gain applied. The output is at
		// 48 kHz. The pre-skip is not dropped: containers place those
		// samples before time zero.
		//
		// Fails when `config` is not an OpusHead header or maps channels to
		// missing streams.
		def decoder(config byte[]) !AudioDecoder {
			return new OpusPacketDecoder(try opusReadHead(config))
		}

		// encode writes the stream as Ogg Opus with CELT frames of
		// `frameDuration` at `bitrate`, resampled to 48 kHz when it is not,
		// with `tags` as its comments. More than two channels are mixed down
		// to stereo. Fails when the stream or the writer does.
		def encode(stream AudioStream, writer io.Writer) !none {
			let enc = new OpusFileEncoder(self)
			return enc.encode(stream, writer)
		}
	}
}

internal partial module std.formats.audio.opus {
	use (
		std.io
		std.bytes
		std.formats.audio.celt::*
		std.formats.video.media.ogg::*
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	// The Vorbis-order channel each WAV-order channel of a family 1 layout
	// comes from, for 1 to 8 channels one after another.
	const opusWavOrder = int[
		0,
		0, 1,
		0, 2, 1,
		0, 1, 2, 3,
		0, 2, 1, 3, 4,
		0, 2, 1, 5, 3, 4,
		0, 2, 1, 6, 5, 3, 4,
		0, 2, 1, 7, 5, 6, 3, 4
	]

	// Where the layout of each channel count starts in `opusWavOrder`.
	const opusWavOrderAt = int[0, 1, 3, 6, 10, 15, 21, 28]

	// Samples decoded and dropped before a seek target so the decoder's
	// predictions have settled: 500 ms, well over the 80 ms RFC 7845 asks
	// for, which leaves the output identical to decoding from the start.
	const opusSeekPreroll = 24000

	// Whether `packet` (from `at`) starts with the eight-byte magic `magic`.
	def opusIsHeader(packet byte[], at int, magic string) bool {
		return false when packet.len() < at + 8
		for let i = 0; i < 8; i++ {
			return false when int(packet[at + i]) != int(magic[i])
		}
		return true
	}

	// The little-endian unsigned 32-bit value at data[at].
	def opusU32(data byte[], at int) int {
		return int(data[at]) | (int(data[at + 1]) << 8) | (int(data[at + 2]) << 16) | (int(data[at + 3]) << 24)
	}

	// Reads an OpusTags packet. Fails when it is not one or is truncated.
	def opusParseTags(p byte[]) !OpusTags {
		expects {
			assert opusIsHeader(p, 0, "OpusTags") onerror fail "opus: bad comment header"
		}
		let tags = new OpusTags()
		let at = 8
		fail "opus: truncated comment header" when at + 4 > p.len()
		let vlen = opusU32(p, at)
		at += 4
		fail "opus: truncated comment header" when at + vlen > p.len()
		tags.vendor = string(p[at:at + vlen])
		at += vlen
		fail "opus: truncated comment header" when at + 4 > p.len()
		let count = opusU32(p, at)
		at += 4
		for let i = 0; i < count; i++ {
			fail "opus: truncated comment header" when at + 4 > p.len()
			let clen = opusU32(p, at)
			at += 4
			fail "opus: truncated comment header" when at + clen > p.len()
			tags.comments.push(string(p[at:at + clen]))
			at += clen
		}
		return tags
	}

	// The samples per channel an Opus packet decodes to, 0 when it is
	// malformed.
	def opusPacketSamples(p byte[]) int {
		return 0 when p.len() < 1
		let toc = int(p[0])
		let size = opusTocFrameSize(toc)
		let code = toc & 3
		return size when code == 0
		return 2 * size when code := 1 || 2
		return 0 when p.len() < 2
		return size * (int(p[1]) & 0x3F)
	}

	// The fields of an OpusHead identification header (RFC 7845 5.1).
	struct OpusHead {
		channels int
		preSkip  int
		gain     float32
		family   int
		streams  int
		coupled  int
		// The stream channel of each output channel, in WAV order.
		mapping  int[]
	}

	// Reads the OpusHead packet: channels, pre-skip, output gain and channel
	// mapping. Fails when it is not one or maps channels to missing streams.
	def opusReadHead(p byte[]) !OpusHead {
		expects {
			assert opusIsHeader(p, 0, "OpusHead") && p.len() >= 19 onerror fail "opus: bad identification header"
			assert (int(p[8]) & 0xF0) == 0 onerror fail "opus: unsupported version"
		}
		let channels = int(p[9])
		fail "opus: no channels" when channels == 0
		let preSkip = int(p[10]) | (int(p[11]) << 8)
		let g = int(p[16]) | (int(p[17]) << 8)
		g -= 65536 when g >= 32768
		let gain = float32(celtExp2(float(g) / 256.0 / 20.0 * 3.321928094887362))
		let family = int(p[18])
		let streams = 1
		let coupled = 0
		let mapping int[]
		if family == 0 {
			fail "opus: family 0 carries one or two channels" when channels > 2
			streams = 1
			coupled = channels - 1
			mapping = int[0, 1]
		} else {
			fail "opus: truncated identification header" when p.len() < 21 + channels
			streams = int(p[19])
			coupled = int(p[20])
			fail "opus: bad stream counts" when streams == 0 || coupled > streams
			fail "opus: family 1 carries one to eight channels" when family == 1 && channels > 8
			for let i = 0; i < channels; i++ {
				let m = int(p[21 + i])
				fail "opus: bad channel mapping" when m != 255 && m >= streams + coupled
				mapping.push(m)
			}
			if family == 1 && channels > 2 {
				// Family 1 stores the channels in Vorbis order; the stream
				// yields the WAV order (front left, front right, centre, LFE,
				// back, side).
				let vorbis = mapping
				mapping = int[]
				let at = opusWavOrderAt[channels - 1]
				for let i = 0; i < channels; i++ {
					mapping.push(vorbis[opusWavOrder[at + i]])
				}
			}
		}
		return OpusHead{channels: channels, preSkip: preSkip, gain: gain, family: family, streams: streams, coupled: coupled, mapping: mapping}
	}

	// A lazy decoding stream over the bytes of an Ogg Opus file.
	type OpusStream {
		// The frame the next read starts at.
		framePosition uint64

		data       byte[]
		loaded     bool
		channels   int
		preSkip    int
		gain       float32
		family     int
		streams    int
		coupled    int
		mapping    int[]
		dec        OpusMultistreamDecoder
		ogg        OggPacketReader
		pcm        float32[]
		pcmPos     int
		pcmLen     int
		streamAt   int64
		total      int64
		dropFrames int64
		base       int64
		pageAt     int[]
		pageGran   int64[]
		pageFirst  int[]
		pageEnded  int[]
		pageCont   bool[]
		audioBytes int
		closed     bool
		// Where a live stream's pages come from; none for bytes in memory.
		source     ?io.Reader             = none

		// A stream over the file's bytes; the headers are read on first use.
		def new(data byte[]) {
			self.data = data
			total = -1
		}

		// A live stream over the pages `source` delivers, which cannot seek;
		// the headers are read on first use.
		def new(source io.Reader) {
			self.source = source
			total = -1
		}

		// Reads the headers and indexes the pages. Fails when the bytes are
		// not Ogg Opus.
		def load() !none {
			return none when loaded
			let live = source
			let r = live is none ?? (new OggPacketReader(new bytes.Reader(data)), new OggPacketReader(live))
			let head = try r.next()
			fail "opus: no identification header" when head is none
			try parseHead(head)
			let comments = try r.next()
			fail "opus: no comment header" when comments is none
			fail "opus: bad comment header" unless opusIsHeader(comments, 0, "OpusTags")
			index(r.serial()) when live is none
			if family == 0 {
				dec = new OpusMultistreamDecoder(channels, 1, channels - 1, mapping)
			} else {
				dec = new OpusMultistreamDecoder(channels, streams, coupled, mapping)
			}
			pcm.len(5760 * channels)
			loaded = true
			if !(live is none) {
				ogg = r
				dropFrames = int64(preSkip)
				return none
			}
			try restart(0)
		}

		// Reads the OpusHead packet: channels, pre-skip, output gain and channel
		// mapping. Fails when it is not one or maps channels to missing streams.
		def parseHead(p byte[]) !none {
			let head = try opusReadHead(p)
			channels = head.channels
			preSkip = head.preSkip
			gain = head.gain
			family = head.family
			streams = head.streams
			coupled = head.coupled
			mapping = head.mapping
			return none
		}

		// Records where each page of the stream starts, its granule, the
		// packet it starts, the packets it completes and whether it
		// continues a packet; finds where the audio starts and ends.
		def index(serial uint32) {
			let at = 0
			let packets = 0
			let lastGranule int64 = -1
			let firstAudio = -1
			for at + 27 <= data.len() {
				if !(data[at] == 79 && data[at + 1] == 103 && data[at + 2] == 103 && data[at + 3] == 83) {
					at++
					continue
				}
				let nsegs = int(data[at + 26])
				break when at + 27 + nsegs > data.len()
				let size = 0
				let ended = 0
				for let i = 0; i < nsegs; i++ {
					let l = int(data[at + 27 + i])
					size += l
					ended += 1 when l < 255
				}
				let s = uint32(opusU32(data, at + 14))
				if s == serial {
					let g int64 = 0
					for let i = 13; i >= 6; i-- {
						g = (g << 8) | int64(data[at + i])
					}
					pageAt.push(at)
					pageGran.push(g)
					pageFirst.push(packets)
					pageEnded.push(ended)
					pageCont.push((int(data[at + 5]) & 1) != 0)
					audioBytes += size when packets >= 2
					packets += ended
					lastGranule = g when g >= 0 && ended > 0
					firstAudio = pageAt.len() - 1 when firstAudio < 0 && packets > 2
				}
				at += 27 + nsegs + size
			}
			base = 0
			if firstAudio >= 0 {
				// The first audio page's granule less the samples of the packets
				// completed on it is where the stream starts.
				let g = pageGran[firstAudio]
				let r = new OggPacketReader(new bytes.Reader(data))
				let samples = 0
				let k = 0
				for {
					let p = r.next() onerror recover none
					break when p is none
					if k >= 2 {
						break when r.granule() != g
						samples += opusPacketSamples(p)
					}
					k++
				}
				base = g - int64(samples) when g - int64(samples) > 0
			}
			if lastGranule >= 0 {
				total = lastGranule - base - int64(preSkip)
				total = 0 when total < 0
			}
		}

		// Positions the decoder to deliver frame `target` next: decoding
		// starts at the last page whose first packet begins at least 500 ms
		// before it, and the samples before it are discarded.
		def restart(target int64) !none {
			dec.reset()
			pcmPos = 0
			pcmLen = 0
			let want = base + int64(preSkip) + target
			let from = want - opusSeekPreroll
			let page = -1
			let startSample = base
			let prevGranule = base
			for let i = 0; i < pageAt.len(); i++ {
				if !pageCont[i] && pageFirst[i] >= 2 {
					if page < 0 || prevGranule <= from {
						page = i
						startSample = prevGranule
					} else {
						break
					}
				}
				prevGranule = pageGran[i] when pageGran[i] >= 0 && pageEnded[i] > 0 && pageFirst[i] + pageEnded[i] > 2
			}
			if page < 0 {
				ogg = new OggPacketReader(new bytes.Reader(data))
				try ogg.next()
				try ogg.next()
				startSample = base
			} else {
				ogg = new OggPacketReader(new bytes.Reader(data[pageAt[page]:]))
			}
			dropFrames = want - startSample
			dropFrames = 0 when dropFrames < 0
			streamAt = target
		}

		// info implements AudioStream.
		def info() AudioInfo {
			let frames = total < 0 ?? (uint64(0), uint64(total))
			let seconds = float(total) / 48000.0
			let rate = total > 0 ?? (uint32(float(audioBytes) * 8.0 / seconds), uint32(0))
			return AudioInfo{
				sampleRate: 48000,
				channels: uint16(channels),
				bitDepth: 32,
				format: SampleFormat.Float32,
				frames: frames,
				length: duration(int64(frames) * 1000000000 / 48000),
				codec: "opus",
				bitrate: rate,
				seekable: source is none
			}
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream. Fails when the file is damaged.
		def readFrames(buf float32[]) !int {
			try load()
			fail "opus: the stream is closed" when closed
			fail "opus: the buffer is not whole frames" when buf.len() % channels != 0
			let want = buf.len() / channels
			let done = 0
			for done < want {
				if total >= 0 && streamAt >= total {
					break
				}
				if pcmPos >= pcmLen {
					let p = try ogg.next()
					break when p is none
					let n = try dec.decode(p, 0, p.len(), pcm, 0)
					pcmPos = 0
					pcmLen = n
					if dropFrames > 0 {
						let d = dropFrames < int64(n) ?? (int(dropFrames), n)
						pcmPos = d
						dropFrames -= int64(d)
					}
					continue
				}
				let take = (pcmLen - pcmPos).min(want - done)
				take = int((total - streamAt).min(int64(take))) when total >= 0
				let src = pcmPos * channels
				let dst = done * channels
				let count = take * channels
				if gain == 1.0 {
					for let i = 0; i < count; i++ {
						buf[dst + i] = pcm[src + i]
					}
				} else {
					for let i = 0; i < count; i++ {
						buf[dst + i] = pcm[src + i] * gain
					}
				}
				pcmPos += take
				done += take
				streamAt += int64(take)
			}
			return done
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream: decoding restarts 500 ms before the
		// frame so the decoder has settled when it gets there. Fails when the
		// file is damaged.
		def seekFrame(frame uint64) !none {
			try load()
			fail "opus: the stream is closed" when closed
			fail "opus: a live stream cannot seek" unless source is none
			let target = int64(frame)
			target = total when total >= 0 && target > total
			return restart(target)
		}

		// close implements io.Closer.
		def close() !none {
			closed = true
			return none
		}
	}

	// Decodes the packets of one Opus track.
	type OpusPacketDecoder {
		head OpusHead
		dec  OpusMultistreamDecoder
		pcm  float32[]

		def new(head OpusHead) {
			self.head = head
			dec = new OpusMultistreamDecoder(head.channels, head.streams, head.coupled, head.mapping)
			pcm.len(5760 * head.channels)
		}

		// info implements AudioDecoder.
		def info() AudioInfo {
			return AudioInfo{
				sampleRate: uint32(48000),
				channels:   uint16(head.channels),
				bitDepth:   uint16(32),
				format:     SampleFormat.Float32,
				frames:     uint64(0),
				length:     0s,
				codec:      "opus",
				bitrate:    uint32(0),
				seekable:   false,
			}
		}

		// decode implements AudioDecoder.
		//
		// Fails when the packet is malformed.
		def decode(packet byte[]) !float32[] {
			let n = try dec.decode(packet, 0, packet.len(), pcm, 0)
			let out = pcm[0:n * head.channels].clone()
			if head.gain != 1.0 {
				for let i = 0; i < out.len(); i++ {
					out[i] = out[i] * head.gain
				}
			}
			return out
		}

		// flush implements AudioDecoder: Opus holds nothing back.
		//
		// Does not fail.
		def flush() !float32[] {
			return float32[]
		}

		// reset implements AudioDecoder.
		def reset() {
			dec.reset()
		}
	}
}
