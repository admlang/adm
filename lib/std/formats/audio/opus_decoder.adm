internal partial module std.formats.audio.opus {
	use (
		std.formats.audio.celt::*
		std.formats.audio.silk::*
	)

	// Coding modes of an Opus frame (RFC 6716 section 3.1): SILK only.
	const opusModeSilk = 1

	// SILK below 8 kHz with CELT above it.
	const opusModeHybrid = 2

	// CELT only.
	const opusModeCelt = 3

	// Audio bandwidths of an Opus frame: narrowband, 4 kHz.
	const opusBandNarrow = 0

	// Medium band: 6 kHz.
	const opusBandMedium = 1

	// Wideband: 8 kHz.
	const opusBandWide = 2

	// Super-wideband: 12 kHz.
	const opusBandSuperWide = 3

	// Fullband: 20 kHz.
	const opusBandFull = 4

	// The coding mode of the packet whose TOC byte is `toc`.
	def opusTocMode(toc int) int {
		return opusModeCelt when (toc & 0x80) != 0
		return opusModeHybrid when (toc & 0x60) == 0x60
		return opusModeSilk
	}

	// The audio bandwidth of the packet whose TOC byte is `toc`.
	def opusTocBandwidth(toc int) int {
		if (toc & 0x80) != 0 {
			let bw = opusBandMedium + ((toc >> 5) & 3)
			return bw == opusBandMedium ?? (opusBandNarrow, bw)
		}
		return (toc & 0x10) != 0 ?? (opusBandFull, opusBandSuperWide) when (toc & 0x60) == 0x60
		return opusBandNarrow + ((toc >> 5) & 3)
	}

	// Samples per channel at 48 kHz in each frame of the packet whose TOC
	// byte is `toc`.
	def opusTocFrameSize(toc int) int {
		return (48000 << ((toc >> 3) & 3)) / 400 when (toc & 0x80) != 0
		return (toc & 0x08) != 0 ?? (960, 480) when (toc & 0x60) == 0x60
		let size = (toc >> 3) & 3
		return 2880 when size == 3
		return (48000 << size) / 100
	}

	// The frames of one Opus packet (RFC 6716 section 3.2).
	type OpusPacket {
		// The TOC byte.
		toc     int
		// Frames in the packet.
		count   int
		// Where each frame starts in the packet's bytes, and its length.
		offsets int[]
		// The length of each frame.
		sizes   int[]
		// The bytes the packet took, which matters for self-delimited
		// packets followed by others.
		length  int

		// An empty packet description.
		def new() {
			offsets.len(48)
			sizes.len(48)
		}

		// A frame length coded in one or two bytes at data[at] and the bytes it
		// took; (-1, 0) when `left` bytes cannot hold it.
		def frameLength(data byte[], at int, left int) (int, int) {
			return (-1, 0) when left < 1
			let b0 = int(data[at])
			return (b0, 1) when b0 < 252
			return (-1, 0) when left < 2
			return (4 * int(data[at + 1]) + b0, 2)
		}

		// Reads the packet of `len` bytes at data[start], self-delimited when
		// `selfDelimited` (RFC 6716 appendix B). Fails when it is malformed.
		def parse(data byte[], start int, len int, selfDelimited bool) !none {
			expects {
				assert len >= 1 onerror fail "opus: empty packet"
			}
			let p = start
			toc = int(data[p])
			p++
			let left = len - 1
			let lastSize = left
			let cbr = false
			let frameSize = opusTocFrameSize(toc)
			let code = toc & 3
			if code == 0 {
				count = 1
			} else if code == 1 {
				count = 2
				cbr = true
				if !selfDelimited {
					fail "opus: odd CBR packet" when (left & 1) != 0
					lastSize = left / 2
					sizes[0] = lastSize
				}
			} else if code == 2 {
				count = 2
				let (size, used) = frameLength(data, p, left)
				left -= used
				fail "opus: bad frame length" when size < 0 || size > left
				sizes[0] = size
				p += used
				lastSize = left - size
			} else {
				fail "opus: truncated packet" when left < 1
				let ch = int(data[p])
				p++
				count = ch & 0x3F
				fail "opus: bad frame count" when count <= 0 || frameSize * count > 5760
				left--
				if (ch & 0x40) != 0 {
					for {
						fail "opus: bad padding" when left <= 0
						let pad = int(data[p])
						p++
						left--
						left -= pad == 255 ?? (254, pad)
						break when pad != 255
					}
				}
				fail "opus: bad padding" when left < 0
				cbr = (ch & 0x80) == 0
				if !cbr {
					lastSize = left
					for let i = 0; i < count - 1; i++ {
						let (size, used) = frameLength(data, p, left)
						left -= used
						fail "opus: bad frame length" when size < 0 || size > left
						sizes[i] = size
						p += used
						lastSize -= used + size
					}
					fail "opus: bad frame length" when lastSize < 0
				} else if !selfDelimited {
					lastSize = left / count
					fail "opus: bad CBR packet" when lastSize * count != left
					for let i = 0; i < count - 1; i++ {
						sizes[i] = lastSize
					}
				}
			}
			if selfDelimited {
				let (size, used) = frameLength(data, p, left)
				left -= used
				fail "opus: bad frame length" when size < 0 || size > left
				p += used
				sizes[count - 1] = size
				if cbr {
					fail "opus: bad CBR packet" when size * count > left
					for let i = 0; i < count - 1; i++ {
						sizes[i] = size
					}
				} else {
					fail "opus: bad frame length" when size > lastSize
				}
			} else {
				fail "opus: frame too long" when lastSize > 1275
				sizes[count - 1] = lastSize
			}
			for let i = 0; i < count; i++ {
				offsets[i] = p
				p += sizes[i]
			}
			length = p - start
		}
	}

	// Decodes the packets of one Opus stream (RFC 6716 section 4): SILK,
	// hybrid and CELT frames with the transitions between them, at 48 kHz.
	type OpusDecoder {
		// Output channels, 1 or 2.
		channels       int
		// Samples per channel the last packet decoded to.
		frameSize      int
		// The final range of the last frame, for conformance checks.
		rangeFinal     int
		celt           CeltDecoder
		silk           SilkDecoder
		// The frames of the last packet.
		packet         OpusPacket
		dec            OpusRangeDecoder
		red            OpusRangeDecoder
		streamChannels int
		bandwidth      int
		mode           int
		prevMode       int
		prevRedundancy bool
		pcmSilk        int[]
		pcmTransition  float32[]
		redundant      float32[]
		silence        byte[]

		// A decoder with `channels` output channels.
		def new(channels int) {
			self.channels = channels
			celt = new CeltDecoder(channels)
			silk = new SilkDecoder(channels)
			packet = new OpusPacket()
			dec = new OpusRangeDecoder(byte[], 0, 0)
			red = new OpusRangeDecoder(byte[], 0, 0)
			pcmSilk.len(5760 * 2)
			pcmTransition.len(240 * 2)
			redundant.len(240 * 2)
			silence = byte[255, 255]
			reset()
		}

		// Forgets every earlier packet.
		def reset() {
			celt.reset()
			silk.reset()
			streamChannels = channels
			bandwidth = 0
			mode = 0
			prevMode = 0
			prevRedundancy = false
			frameSize = 960 / 8
			rangeFinal = 0
		}

		// Decodes the packet of `len` bytes at data[start] into `pcm` from
		// `at`, interleaved, and returns the samples per channel: up to
		// 5760. `selfDelimited` packets are followed by others in the same
		// bytes; `packet.length` is then the bytes this one took. Fails
		// when the packet is malformed.
		def decode(data byte[], start int, len int, selfDelimited bool, pcm float32[], at int) !int {
			try packet.parse(data, start, len, selfDelimited)
			let toc = packet.toc
			mode = opusTocMode(toc)
			bandwidth = opusTocBandwidth(toc)
			frameSize = opusTocFrameSize(toc)
			streamChannels = (toc & 4) != 0 ?? (2, 1)
			let samples = 0
			for let i = 0; i < packet.count; i++ {
				let n = try decodeFrame(data, packet.offsets[i], packet.sizes[i], true, pcm, at + samples * channels, 5760 - samples)
				samples += n
			}
			return samples
		}

		// Conceals `n` lost samples per channel into `pcm` from `at`.
		// Fails when concealment does.
		def conceal(pcm float32[], at int, n int) !int {
			return decodeFrame(silence, 0, 0, false, pcm, at, n)
		}

		// Decodes (or conceals, without data) one frame of `lenIn` bytes into
		// `pcm` from `at` with the mode and bandwidth of the current packet, and
		// returns its samples per channel (RFC 6716 section 4.5).
		def decodeFrame(data byte[], start int, lenIn int, hasDataIn bool, pcm float32[], at int, frameSizeIn int) !int {
			let len = lenIn
			let hasData = hasDataIn && len > 1
			let requested = frameSizeIn
			let f20 = 960
			let f5 = 240
			let f2_5 = 120
			fail "opus: output buffer too small" when requested < f2_5
			requested = requested.min(frameSize) unless hasData
			let audiosize = 0
			let curMode = 0
			if hasData {
				audiosize = frameSize
				curMode = mode
				dec.reset(data, start, len)
			} else {
				audiosize = requested
				if prevMode == 0 {
					for let i = 0; i < audiosize * channels; i++ {
						pcm[at + i] = 0.0
					}
					return audiosize
				}
				curMode = prevMode
			}
			if !hasData && requested > f20 && curMode != opusModeSilk {
				let done = 0
				for done < requested {
					let got = try decodeFrame(data, 0, 0, false, pcm, at + done * channels, f20)
					fail "opus: concealment failed" when got != f20
					done += got
				}
				return requested
			}
			let transition = false
			if hasData && prevMode > 0 && ((curMode == opusModeCelt && prevMode != opusModeCelt && !prevRedundancy) || (curMode != opusModeCelt && prevMode == opusModeCelt)) {
				transition = true
				if curMode == opusModeCelt {
					try decodeFrame(data, 0, 0, false, pcmTransition, 0, f5.min(audiosize))
				}
			}
			fail "opus: output buffer too small" when audiosize > requested
			let n = audiosize

			if curMode != opusModeCelt {
				silk.reset() when prevMode == opusModeCelt
				let payloadMs = (1000 * audiosize / 48000).max(10)
				let internalRate = 16000
				if curMode == opusModeSilk {
					if bandwidth == opusBandNarrow {
						internalRate = 8000
					} else if bandwidth == opusBandMedium {
						internalRate = 12000
					}
				}
				let decoded = 0
				for {
					let got = silk.decode(dec,!hasData, decoded == 0, streamChannels, internalRate, payloadMs, pcmSilk, decoded * channels) onerror recover -1
					if got < 0 {
						fail "opus: damaged SILK frame" when hasData
						for let i = 0; i < n * channels; i++ {
							pcmSilk[decoded * channels + i] = 0
						}
						got = n
					}
					decoded += got
					break when decoded >= n
				}
			}

			let startBand = 0
			let redundancy = false
			let redundancyBytes = 0
			let celtToSilk = false
			let hybridBits = curMode == opusModeHybrid ?? (20, 0)
			if curMode != opusModeCelt && hasData && dec.tell() + 17 + hybridBits <= 8 * len {
				redundancy = curMode == opusModeHybrid ?? (dec.bitLogp(12), true)
				if redundancy {
					celtToSilk = dec.bitLogp(1)
					redundancyBytes = curMode == opusModeHybrid ?? (dec.uint(256) + 2, len - ((dec.tell() + 7) >> 3))
					len -= redundancyBytes
					if len * 8 < dec.tell() {
						len = 0
						redundancyBytes = 0
						redundancy = false
					}
					dec.shrink(redundancyBytes)
				}
			}
			startBand = 17 when curMode != opusModeCelt
			let endBand = 21
			if bandwidth == opusBandNarrow {
				endBand = 13
			} else if bandwidth == opusBandMedium || bandwidth == opusBandWide {
				endBand = 17
			} else if bandwidth == opusBandSuperWide {
				endBand = 19
			}
			celt.end = endBand
			celt.streamChannels = streamChannels
			transition = false when redundancy
			if transition && curMode != opusModeCelt {
				try decodeFrame(data, 0, 0, false, pcmTransition, 0, f5.min(audiosize))
			}
			let redundantRng = 0
			if redundancy && celtToSilk {
				celt.start = 0
				red.reset(data, start + len, redundancyBytes)
				try celt.decode(red, redundancyBytes, redundant, 0, f5)
				redundantRng = celt.rng
			}
			celt.start = startBand
			if curMode != opusModeSilk {
				let celtSize = f20.min(n)
				celt.reset() when curMode != prevMode && prevMode > 0 && !prevRedundancy
				try celt.decode(dec, hasData ?? (len, 0), pcm, at, celtSize)
			} else {
				for let i = 0; i < n * channels; i++ {
					pcm[at + i] = 0.0
				}
				if prevMode == opusModeHybrid && !(redundancy && celtToSilk && prevRedundancy) {
					celt.start = 0
					red.reset(silence, 0, 2)
					try celt.decode(red, 2, pcm, at, f2_5)
				}
			}
			if curMode != opusModeCelt {
				for let i = 0; i < n * channels; i++ {
					pcm[at + i] = pcm[at + i] + float32(0.000030517578125 * float(pcmSilk[i]))
				}
			}
			let window = celt.mdct.window
			if redundancy && !celtToSilk {
				celt.reset()
				celt.start = 0
				red.reset(data, start + len, redundancyBytes)
				try celt.decode(red, redundancyBytes, redundant, 0, f5)
				redundantRng = celt.rng
				smoothFade(pcm, at + channels * (n - f2_5), redundant, channels * f2_5, pcm, at + channels * (n - f2_5), f2_5, window)
			}
			if redundancy && celtToSilk {
				for let i = 0; i < f2_5 * channels; i++ {
					pcm[at + i] = redundant[i]
				}
				smoothFade(redundant, channels * f2_5, pcm, at + channels * f2_5, pcm, at + channels * f2_5, f2_5, window)
			}
			if transition {
				if audiosize >= f5 {
					for let i = 0; i < channels * f2_5; i++ {
						pcm[at + i] = pcmTransition[i]
					}
					smoothFade(pcmTransition, channels * f2_5, pcm, at + channels * f2_5, pcm, at + channels * f2_5, f2_5, window)
				} else {
					smoothFade(pcmTransition, 0, pcm, at, pcm, at, f2_5, window)
				}
			}
			rangeFinal = len <= 1 ?? (0, dec.range() ^ redundantRng)
			prevMode = curMode
			prevRedundancy = redundancy && !celtToSilk
			return audiosize
		}

		// Crossfades from `a` to `b` into `out` over `n` samples per channel
		// with the squared CELT window.
		def smoothFade(a float32[], ao int, b float32[], bo int, out float32[], oo int, n int, window float32[]) {
			for let c = 0; c < channels; c++ {
				for let i = 0; i < n; i++ {
					let w = window[i] * window[i]
					let k = i * channels + c
					out[oo + k] = w * b[bo + k] + (1.0 - w) * a[ao + k]
				}
			}
		}
	}

	// Decodes the packets of an Opus multistream (RFC 7845 section 5.1.1):
	// several Opus streams in each packet, mapped to the output channels.
	type OpusMultistreamDecoder {
		// Output channels.
		channels int
		streams  OpusDecoder[]
		coupled  int
		mapping  int[]
		buf      float32[]

		// A decoder for `streams` streams of which the first `coupled` are
		// stereo, feeding output channel i from decoded channel mapping[i]
		// (255 for silence).
		def new(channels int, streams int, coupled int, mapping int[]) {
			self.channels = channels
			self.coupled = coupled
			self.mapping = mapping
			for let s = 0; s < streams; s++ {
				self.streams.push(new OpusDecoder(s < coupled ?? (2, 1)))
			}
			buf.len(5760 * 2)
		}

		// Forgets every earlier packet.
		def reset() {
			for let (_, d) in streams {
				d.reset()
			}
		}

		// Decodes the packet of `len` bytes at data[start] into `pcm` from
		// `at` and returns the samples per channel. Fails when a stream's
		// packet is malformed or the streams disagree on their length.
		def decode(data byte[], start int, len int, pcm float32[], at int) !int {
			let p = start
			let left = len
			let samples = -1
			for let s = 0; s < streams.len(); s++ {
				let d = streams[s]
				let last = s == streams.len() - 1
				let n = try d.decode(data, p, left,!last, buf, 0)
				fail "opus: streams disagree on the frame length" when samples >= 0 && n != samples
				samples = n
				if !last {
					p += d.packet.length
					left -= d.packet.length
				}
				place(s, d.channels, n, pcm, at)
			}
			return samples
		}

		// Conceals `n` lost samples per channel. Fails when a stream's
		// concealment does.
		def conceal(pcm float32[], at int, n int) !int {
			for let s = 0; s < streams.len(); s++ {
				let d = streams[s]
				try d.conceal(buf, 0, n)
				place(s, d.channels, n, pcm, at)
			}
			return n
		}

		// Copies the `n` frames stream `s` decoded (`sc` channels in `buf`) to
		// the output channels mapped to it.
		def place(s int, sc int, n int, pcm float32[], at int) {
			for let ch = 0; ch < channels; ch++ {
				let m = mapping[ch]
				let src = -1
				if m == 255 {
					src = -1
				} else if m < 2 * coupled {
					src = m / 2 == s ?? (m % 2, -1)
				} else if m - coupled == s {
					src = 0
				}
				if src >= 0 {
					for let i = 0; i < n; i++ {
						pcm[at + i * channels + ch] = buf[i * sc + src]
					}
				} else if m == 255 && s == 0 {
					for let i = 0; i < n; i++ {
						pcm[at + i * channels + ch] = 0.0
					}
				}
			}
		}
	}
}
