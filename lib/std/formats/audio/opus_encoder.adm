internal partial module std.formats.audio.opus {
	use (
		std.io
		std.math
		std.formats.audio.celt::*
		std.formats.audio.ogg::*
		std.formats.audio::*
	)

	// Taps on each side of a sample the rate converter interpolates.
	const opusResampleTaps = 16

	// Kernel phases between two input samples of the rate converter.
	const opusResamplePhases = 256

	// Converts interleaved float samples of any rate and channel count to 48
	// kHz mono or stereo: channels beyond two are folded into left and right
	// (the centre and surrounds at -3 dB, the LFE dropped, WAV order
	// assumed), and the rate is converted by windowed-sinc interpolation.
	type OpusInputConverter {
		// Channels in and out.
		inChannels  int
		// Channels out: 1 or 2.
		outChannels int
		// Input frames per second.
		rate        int
		ready       float32[]
		readyAt     int
		hist        float32[]
		histAt      int
		histFrames  int
		histBase    int64
		nextOut     int64
		step        float
		cutoff      float
		kernel      float[]

		// A converter from `rate` Hz with `channels` channels.
		def new(rate int, channels int) {
			self.rate = rate
			inChannels = channels
			outChannels = channels >= 2 ?? (2, 1)
			step = float(rate) / 48000.0
			cutoff = (48000.0 / float(rate)).min(1.0) * 0.97
			if rate != 48000 {
				let taps = opusResampleTaps
				kernel.len((opusResamplePhases + 1) * 2 * taps)
				for let p = 0; p <= opusResamplePhases; p++ {
					let frac = float(p) / float(opusResamplePhases)
					for let k = 0; k < 2 * taps; k++ {
						let d = float(k - taps + 1) - frac
						let arg = math.π * cutoff * d
						let sinc = d == 0.0 ?? (1.0, math.sin(arg) / arg)
						let w = 0.5 + 0.5 * math.cos(math.π * d / float(taps))
						kernel[p * 2 * taps + k] = cutoff * sinc * w
					}
				}
			}
		}

		// Adds `frames` interleaved input frames from `input`.
		def push(input float32[], frames int) {
			for let i = 0; i < frames; i++ {
				let at = i * inChannels
				if outChannels == 1 {
					hist.push(input[at])
				} else if inChannels == 2 {
					hist.push(input[at])
					hist.push(input[at + 1])
				} else {
					let l = float(input[at])
					let r = float(input[at + 1])
					let norm = 1.0
					if inChannels >= 3 {
						l += 0.7071 * float(input[at + 2])
						r += 0.7071 * float(input[at + 2])
						norm += 0.7071
					}
					for let ch = 4; ch < inChannels; ch++ {
						if (ch & 1) == 0 {
							l += 0.7071 * float(input[at + ch])
							norm += 0.7071
						} else {
							r += 0.7071 * float(input[at + ch])
						}
					}
					hist.push(float32(l / norm))
					hist.push(float32(r / norm))
				}
			}
			histFrames += frames
			convert(false)
		}

		// Converts what the input so far allows; at the `end` of the input
		// the samples after it count as silence.
		def convert(end bool) {
			let c = outChannels
			if rate == 48000 {
				for let i = histAt; i < hist.len(); i++ {
					ready.push(hist[i])
				}
				hist = float32[]
				histAt = 0
				histBase += int64(histFrames)
				histFrames = 0
				return
			}
			let taps = opusResampleTaps
			let lastIn = histBase + int64(histFrames)
			for {
				let t = float(nextOut) * step
				let i0 = int64(t.floor())
				break when !end && i0 + int64(taps) >= lastIn
				break when end && i0 - int64(taps) >= lastIn
				let pf = (t - float(i0)) * float(opusResamplePhases)
				let p = int(pf)
				let w = pf - float(p)
				let k0 = p * 2 * taps
				let k1 = k0 + 2 * taps
				for let ch = 0; ch < c; ch++ {
					let acc = 0.0
					for let k = 0; k < 2 * taps; k++ {
						let j = i0 + int64(k - taps + 1)
						if j >= histBase && j < lastIn {
							let kv = kernel[k0 + k] * (1.0 - w) + kernel[k1 + k] * w
							acc += kv * float(hist[histAt + int(j - histBase) * c + ch])
						}
					}
					ready.push(float32(acc))
				}
				nextOut++
			}
			let need = int64((float(nextOut) * step).floor()) - int64(taps)
			if need > histBase {
				let drop = int(need - histBase).min(histFrames)
				histAt += drop * c
				histFrames -= drop
				histBase += int64(drop)
				if histAt > 65536 {
					let rest float32[]
					rest.len(hist.len() - histAt)
					hist[histAt:].copy(rest)
					hist = rest
					histAt = 0
				}
			}
		}

		// Converted frames waiting to be taken.
		def available() int {
			return (ready.len() - readyAt) / outChannels
		}

		// Moves up to `n` converted frames into `frame`, silence after them,
		// and returns how many there were.
		def take(frame float32[], n int) int {
			let have = available().min(n)
			let c = outChannels
			for let i = 0; i < n * c; i++ {
				frame[i] = i < have * c ?? (ready[readyAt + i], float32(0.0))
			}
			readyAt += have * c
			if readyAt > 65536 {
				let rest float32[]
				rest.len(ready.len() - readyAt)
				ready[readyAt:].copy(rest)
				ready = rest
				readyAt = 0
			}
			return have
		}

		// Output frames the input so far converts to in all.
		def outputFrames() int64 {
			return int64((float(histBase + int64(histFrames)) / step).ceil())
		}
	}

	// Writes an AudioStream as Ogg Opus: identification and comment headers,
	// then constant bit rate CELT packets of one frame each.
	type OpusFileEncoder {
		codec Opus

		// An encoder with the options of `codec`.
		def new(codec Opus) {
			self.codec = codec
		}

		// The CELT frame size in samples nearest to `d`.
		def frameSize(d duration) int {
			let us = int64(d) / 1000
			return 120 when us <= 3750
			return 240 when us <= 7500
			return 480 when us <= 15000
			return 960
		}

		// Encodes the stream to the writer. Fails when the stream or the
		// writer does, or the stream has no channels.
		def encode(stream AudioStream, writer io.Writer) !none {
			let info = stream.info()
			let inChannels = int(info.channels)
			fail "opus: the stream has no channels" when inChannels <= 0
			let rate = int(info.sampleRate)
			fail "opus: the stream has no sample rate" when rate <= 0
			let conv = new OpusInputConverter(rate, inChannels)
			let channels = conv.outChannels
			let n = frameSize(codec.frameDuration)
			let bitrate = codec.bitrate.max(6000).min(510000)
			let packetBytes = (bitrate * n / (8 * 48000)).max(3).min(1276)
			let celtBytes = packetBytes - 1
			let config = 28 + (n == 120 ?? (0, n == 240 ?? (1, n == 480 ?? (2, 3))))
			let toc = byte((config << 3) | (channels == 2 ?? (4, 0)))
			let preSkip = 120
			let ogg = new OggPacketWriter(writer, uint32(0x4f707573))
			try ogg.write(opusHeadPacket(channels, preSkip, rate), 0)
			try ogg.flush()
			try ogg.write(opusTagsPacket(codec.tags), 0)
			try ogg.flush()
			let enc = new CeltEncoder(channels)
			let buf float32[]
			buf.len(4096 * inChannels)
			let frame float32[]
			frame.len(n * channels)
			let packet byte[]
			packet.len(packetBytes)
			let encoded int64 = 0
			let ended = false
			for {
				if !ended {
					let got = try stream.read(buf)
					if got == 0 {
						ended = true
						conv.convert(true)
					} else {
						conv.push(buf, got)
					}
				}
				let total = conv.outputFrames()
				for conv.available() >= n || (ended && encoded < total + int64(preSkip)) {
					conv.take(frame, n)
					let celt = enc.encode(frame, n, celtBytes)
					packet[0] = toc
					for let i = 0; i < celtBytes; i++ {
						packet[1 + i] = celt[i]
					}
					encoded += int64(n)
					let granule = encoded
					granule = total + int64(preSkip) when ended && encoded >= total + int64(preSkip)
					try ogg.write(packet, granule)
					break when ended && encoded >= total + int64(preSkip)
				}
				break when ended
			}
			return ogg.close()
		}
	}

	// The identification header of a family 0 stream (RFC 7845 section 5.1).
	def opusHeadPacket(channels int, preSkip int, rate int) byte[] {
		let p = "OpusHead".bytes()
		p.push(1)
		p.push(byte(channels))
		p.push(byte(preSkip & 255))
		p.push(byte(preSkip >> 8))
		for let i = 0; i < 4; i++ {
			p.push(byte((rate >> (8 * i)) & 255))
		}
		p.push(0)
		p.push(0)
		p.push(0)
		return p
	}

	// The comment header carrying `tags` (RFC 7845 section 5.2).
	def opusTagsPacket(tags OpusTags) byte[] {
		let p = "OpusTags".bytes()
		opusPushString(p, tags.vendor)
		let count = tags.comments.len()
		for let i = 0; i < 4; i++ {
			p.push(byte((count >> (8 * i)) & 255))
		}
		for let (_, c) in tags.comments {
			opusPushString(p, c)
		}
		return p
	}

	// Appends the length (32-bit little-endian) and bytes of `s` to `p`.
	def opusPushString(p byte[], s string) {
		let b = s.bytes()
		let n = b.len()
		for let i = 0; i < 4; i++ {
			p.push(byte((n >> (8 * i)) & 255))
		}
		for let i = 0; i < n; i++ {
			p.push(b[i])
		}
	}
}
