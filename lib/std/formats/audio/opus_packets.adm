partial module std.formats.audio {
	use (
		std.formats.audio.celt::*
		std.formats.audio.opus::*
	)

	// OpusEncoder encodes sound one packet at a time (RFC 6716), for a
	// connection that sends each packet as it is made: `encode` takes the
	// samples of one packet and returns it. The packets are CELT frames at
	// full band and a constant bit rate, which every Opus decoder reads.
	//
	//     let encoder = new audio.OpusEncoder(2, 64000)
	//     let packet = try encoder.encode(pcm, 960)
	type OpusEncoder {
		// Channels coded: 1 or 2.
		channels       int
		// Bits per second for all channels together, 6000 to 510000,
		// from the next packet on.
		bitrate        int         = 32000
		// Discontinuous transmission: after 200 ms of silence a packet
		// is one or two bytes that say nothing was coded (its frames are
		// empty), which need not be sent; every 400 ms of silence one packet is
		// whole again, so the far side's background stays current.
		dtx            bool        = false
		internal celt  CeltEncoder
		// Samples of silence in a row, and since the last whole packet.
		internal quiet int         = 0
		internal since int         = 0

		// An encoder of `channels` channels (1 or 2; more are coded as 2)
		// at `bitsPerSecond`.
		def new(channels int = 1, bitsPerSecond int = 32000) {
			self.channels = channels >= 2 ?? (2, 1)
			bitrate = bitsPerSecond
			celt = new CeltEncoder(self.channels)
		}

		// encode encodes `frames` samples for each channel from `pcm`
		// (interleaved, at 48 kHz) and returns the packet: 120, 240, 480
		// or 960 samples (2.5, 5, 10 or 20 ms) as one frame, 1920 or 2880
		// (40 or 60 ms) as two or three frames of 20 ms. Fails for
		// another count or a `pcm` shorter than that.
		def encode(pcm float32[], frames int) !byte[] {
			fail "opus: a packet takes 120, 240, 480, 960, 1920 or 2880 samples a channel, not {frames}" unless frames := 120 || 240 || 480 || 960 || 1920 || 2880
			fail "opus: {pcm.len()} samples do not hold {frames} for {channels} channels" when pcm.len() < frames * channels
			let n = frames > 960 ?? (960, frames)
			let count = frames / n
			let config = 28 + (n == 120 ?? (0, n == 240 ?? (1, n == 480 ?? (2, 3))))
			let toc = (config << 3) | (channels == 2 ?? (4, 0))
			let rate = bitrate.max(6000).min(510000)
			// One frame's bytes; the packet's first byte, and the frame
			// count of a packet of three, are beside them.
			let head = count == 3 ?? (2, 1)
			let bytes = ((rate * frames / (8 * 48000) - head) / count).max(2).min(1275)
			let silent = dtx && isSilent(pcm, frames * channels)
			quiet = silent ?? (quiet + frames, 0)
			since += frames
			let out byte[]
			out.len(head + count * bytes)
			// Two frames of one size are code 1, three are code 3 with
			// their count (RFC 6716 §3.2).
			out[0] = byte(toc | (count == 2 ?? (1, count == 3 ?? (3, 0))))
			out[1] = 3 when count == 3
			// Every frame is coded, sent or not: the next packet builds
			// on what the encoder has seen.
			for let k = 0; k < count; k++ {
				let frame = celt.encode(k == 0 ?? (pcm, pcm[k * n * channels:]), n, bytes)
				frame.copy(out[head + k * bytes:])
			}
			if silent && quiet > dtxAfter && since < dtxRefresh {
				// Frames of no bytes: one as code 0, several as code 3
				// with their count, so the packet keeps its length in
				// time.
				return count == 1 ?? ([byte(toc)], [byte(toc | 3), byte(count)])
			}
			since = 0
			return out
		}

		// config is the identification header of the packets (RFC 7845
		// section 5.1, "OpusHead"), which a container stores beside
		// them: the channels, the 120 samples a decoder drops from the
		// start, and `sampleRate`, the rate the sound had before it was
		// converted to 48 kHz.
		def config(sampleRate int = 48000) byte[] {
			return opusHeadPacket(channels, 120, sampleRate)
		}

		// setBitrate sets the bits per second from the next packet on.
		def setBitrate(bitsPerSecond int) {
			bitrate = bitsPerSecond
		}

		internal def isSilent(pcm float32[], count int) bool {
			for let i = 0; i < count; i++ {
				return false when pcm[i] > dtxFloor || pcm[i] < 0.0 - dtxFloor
			}
			return true
		}
	}

	// What counts as silence for discontinuous transmission (-80 dB of
	// full scale), the samples of it before packets stop (200 ms) and
	// between the whole packets sent while it lasts (400 ms).
	internal const dtxFloor = float32(0.0001)
	internal const dtxAfter = 9600
	internal const dtxRefresh = 19200
}
