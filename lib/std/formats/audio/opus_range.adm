internal partial module std.formats.audio.opus {
	// The range coder every Opus layer shares (RFC 6716 section 4.1 and 5.1):
	// symbols are coded from the front of a frame, raw bits from its end.

	// Fractional bits of precision `tellFrac` reports: eighths of a bit.
	const opusBitRes = 3

	// The number of bits needed to write x, 0 for 0: ilog(1) == 1,
	// ilog(255) == 8.
	def opusIlog(x int) int {
		return 0 when x <= 0
		let v = x
		let n = 1
		if v >= 0x10000 {
			v >>= 16
			n += 16
		}
		if v >= 0x100 {
			v >>= 8
			n += 8
		}
		if v >= 0x10 {
			v >>= 4
			n += 4
		}
		if v >= 4 {
			v >>= 2
			n += 2
		}
		n += 1 when v >= 2
		return n
	}

	// Decodes the symbols and raw bits of one Opus frame.
	type OpusRangeDecoder {
		buf        byte[]
		start      int
		storage    int
		endOffs    int
		endWindow  int
		nendBits   int
		nbitsTotal int
		offs       int
		rng        int
		val        int
		ext        int
		rem        int
		// Set when a value read did not fit the range it was read against.
		error      bool

		// A decoder over `size` bytes of `data` from `start`.
		def new(data byte[], start int, size int) {
			reset(data, start, size)
		}

		// Starts decoding `size` bytes of `data` from `start`, forgetting what
		// was decoded before.
		def reset(data byte[], start int, size int) {
			buf = data
			self.start = start
			storage = size
			endOffs = 0
			endWindow = 0
			nendBits = 0
			nbitsTotal = 32 + 1 - ((32 - 7) / 8) * 8
			offs = 0
			rng = 1 << 7
			rem = readByte()
			val = rng - 1 - (rem >> 1)
			error = false
			normalize()
		}

		// The next byte from the front of the frame, 0 past its end.
		def readByte() int {
			return 0 when offs >= storage
			let b = int(buf[start + offs])
			offs++
			return b
		}

		// The next byte from the back of the frame, 0 past its start.
		def readByteFromEnd() int {
			return 0 when endOffs >= storage
			endOffs++
			return int(buf[start + storage - endOffs])
		}

		// Refills the range with whole bytes while it is at most 2^23.
		def normalize() {
			for rng <= 0x800000 {
				nbitsTotal += 8
				rng = rng << 8
				let sym = rem
				rem = readByte()
				sym = ((sym << 8) | rem) >> 1
				val = ((val << 8) + (255 & ^sym)) & 0x7FFFFFFF
			}
		}

		// The cumulative frequency of the next symbol in a distribution of
		// total `ft`, to be followed by `update`.
		def decode(ft int) int {
			ext = rng / ft
			let s = val / ext
			return ft - (s + 1).min(ft)
		}

		// `decode` for a total of 2^bits.
		def decodeBin(bits int) int {
			ext = rng >> bits
			let s = val / ext
			let ft = 1 << bits
			return ft - (s + 1).min(ft)
		}

		// Consumes the symbol whose frequencies are fl..fh of ft.
		def update(fl int, fh int, ft int) {
			let s = ext * (ft - fh)
			val -= s
			if fl > 0 {
				rng = ext * (fh - fl)
			} else {
				rng = rng - s
			}
			normalize()
		}

		// A bit that is one with probability 1/2^logp.
		def bitLogp(logp int) bool {
			let r = rng
			let d = val
			let s = r >> logp
			let one = d < s
			if one {
				rng = s
			} else {
				val = d - s
				rng = r - s
			}
			normalize()
			return one
		}

		// A symbol coded with an inverse cumulative table whose total is
		// 2^ftb; `at` is where the table starts in `icdf`.
		def icdf(table int[], at int, ftb int) int {
			let s = rng
			let d = val
			let r = s >> ftb
			let ret = -1
			let t = 0
			for {
				t = s
				ret++
				s = r * table[at + ret]
				break when d >= s
			}
			val = d - s
			rng = t - s
			normalize()
			return ret
		}

		// `icdf` over a whole table.
		def icdf(table int[], ftb int) int {
			return icdf(table, 0, ftb)
		}

		// A uniformly distributed integer in 0..ft-1.
		def uint(ft int) int {
			let top = ft - 1
			let ftb = opusIlog(top)
			if ftb > 8 {
				ftb -= 8
				let f = (top >> ftb) + 1
				let s = decode(f)
				update(s, s + 1, f)
				let t = (s << ftb) | bits(ftb)
				return t when t <= top
				error = true
				return top
			}
			let s = decode(ft)
			update(s, s + 1, ft)
			return s
		}

		// `n` raw bits from the end of the frame, n at most 24.
		def bits(n int) int {
			let window = endWindow
			let available = nendBits
			if available < n {
				for {
					window = window | (readByteFromEnd() << available)
					available += 8
					break when available > 24
				}
			}
			let ret = window & ((1 << n) - 1)
			window = window >> n
			available -= n
			endWindow = window
			nendBits = available
			nbitsTotal += n
			return ret
		}

		// A Laplace-distributed energy delta whose zero has frequency `fs`
		// of 32768 and whose tail decays by decay/16384 per step.
		def laplace(fs0 int, decay int) int {
			let v = 0
			let fs = fs0
			let fm = decodeBin(15)
			let fl = 0
			if fm >= fs {
				v++
				fl = fs
				fs = (((32768 - 32 - fs) * (16384 - decay)) >> 15) + 1
				for fs > 1 && fm >= fl + 2 * fs {
					fs *= 2
					fl += fs
					fs = (((fs - 2) * decay) >> 15) + 1
					v++
				}
				if fs <= 1 {
					let di = (fm - fl) >> 1
					v += di
					fl += 2 * di
				}
				if fm < fl + fs {
					v = -v
				} else {
					fl += fs
				}
			}
			update(fl, (fl + fs).min(32768), 32768)
			return v
		}

		// Bits consumed so far, rounded up.
		def tell() int {
			return nbitsTotal - opusIlog(rng)
		}

		// Bits consumed so far in eighths of a bit, rounded up.
		def tellFrac() int {
			return opusTellFrac(nbitsTotal, rng)
		}

		// The final range, which a matching encoder reproduces.
		def range() int {
			return rng
		}

		// The frame size in bytes.
		def size() int {
			return storage
		}

		// Takes `n` bytes off the end of the frame, which belong to another
		// coder.
		def shrink(n int) {
			storage -= n
		}

		// Counts every bit of a frame of `totalBits` as read, as a silent
		// frame does.
		def markRead(totalBits int) {
			nbitsTotal += totalBits - tell()
		}
	}

	// ec_tell_frac over a coder's bit count and range.
	def opusTellFrac(nbitsTotal int, rng int) int {
		let nbits = nbitsTotal << opusBitRes
		let l = opusIlog(rng)
		let r = rng >> (l - 16)
		for let i = 0; i < opusBitRes; i++ {
			r = (r * r) >> 15
			let b = r >> 16
			l = (l << 1) | b
			r = r >> b
		}
		return nbits - l
	}

	// Encodes the symbols and raw bits of one Opus frame into a fixed-size
	// buffer.
	type OpusRangeEncoder {
		buf        byte[]
		storage    int
		endOffs    int
		endWindow  int
		nendBits   int
		nbitsTotal int
		offs       int
		rng        int
		val        int
		ext        int
		rem        int
		// Set when the symbols no longer fit the buffer.
		error      bool

		// An encoder writing at most `size` bytes.
		def new(size int) {
			buf.len(size)
			storage = size
			endOffs = 0
			endWindow = 0
			nendBits = 0
			nbitsTotal = 32 + 1
			offs = 0
			rng = 0x80000000
			rem = -1
			val = 0
			ext = 0
			error = false
		}

		// Appends a byte to the front part, flagging an overflow.
		def writeByte(v int) {
			if offs + endOffs >= storage {
				error = true
				return
			}
			buf[offs] = byte(v & 255)
			offs++
		}

		// Prepends a byte to the raw bits at the back, flagging an overflow.
		def writeByteAtEnd(v int) {
			if offs + endOffs >= storage {
				error = true
				return
			}
			endOffs++
			buf[storage - endOffs] = byte(v & 255)
		}

		// Outputs byte `c` (with its carry bit), holding back runs of 255 until
		// the carry into them is known.
		def carryOut(c int) {
			if c != 255 {
				let carry = c >> 8
				writeByte(rem + carry) when rem >= 0
				if ext > 0 {
					let sym = (255 + carry) & 255
					for {
						writeByte(sym)
						ext--
						break when ext <= 0
					}
				}
				rem = c & 255
			} else {
				ext++
			}
		}

		// Shifts out whole bytes while the range is at most 2^23.
		def normalize() {
			for rng <= 0x800000 {
				carryOut(val >> 23)
				val = (val << 8) & 0x7FFFFFFF
				rng = rng << 8
				nbitsTotal += 8
			}
		}

		// Codes the symbol whose frequencies are fl..fh of ft.
		def encode(fl int, fh int, ft int) {
			let r = rng / ft
			if fl > 0 {
				val += rng - r * (ft - fl)
				rng = r * (fh - fl)
			} else {
				rng -= r * (ft - fh)
			}
			normalize()
		}

		// `encode` for a total of 2^bits.
		def encodeBin(fl int, fh int, bits int) {
			let r = rng >> bits
			if fl > 0 {
				val += rng - r * ((1 << bits) - fl)
				rng = r * (fh - fl)
			} else {
				rng -= r * ((1 << bits) - fh)
			}
			normalize()
		}

		// A bit that is one with probability 1/2^logp.
		def bitLogp(one bool, logp int) {
			let r = rng
			let l = val
			let s = r >> logp
			r -= s
			val = l + r when one
			rng = one ?? (s, r)
			normalize()
		}

		// Symbol `s` of an inverse cumulative table whose total is 2^ftb;
		// `at` is where the table starts in `icdf`.
		def icdf(s int, table int[], at int, ftb int) {
			let r = rng >> ftb
			if s > 0 {
				val += rng - r * table[at + s - 1]
				rng = r * (table[at + s - 1] - table[at + s])
			} else {
				rng -= r * table[at + s]
			}
			normalize()
		}

		// `icdf` over a whole table.
		def icdf(s int, table int[], ftb int) {
			icdf(s, table, 0, ftb)
		}

		// A uniformly distributed integer fl in 0..ft-1.
		def uint(fl int, ft int) {
			let top = ft - 1
			let ftb = opusIlog(top)
			if ftb > 8 {
				ftb -= 8
				let f = (top >> ftb) + 1
				let v = fl >> ftb
				encode(v, v + 1, f)
				bits(fl & ((1 << ftb) - 1), ftb)
			} else {
				encode(fl, fl + 1, ft)
			}
		}

		// `n` raw bits of `v` at the end of the frame.
		def bits(v int, n int) {
			let window = endWindow
			let used = nendBits
			if used + n > 32 {
				for {
					writeByteAtEnd(window & 255)
					window = window >> 8
					used -= 8
					break when used < 8
				}
			}
			window = window | (v << used)
			used += n
			endWindow = window
			nendBits = used
			nbitsTotal += n
		}

		// A Laplace-distributed energy delta; returns the value actually
		// coded, which is clamped when it falls beyond the coded range.
		def laplace(value int, fs0 int, decay int) int {
			let fl = 0
			let fs = fs0
			let v = value
			let coded = value
			if v != 0 {
				let s = v < 0 ?? (-1, 0)
				v = (v + s) ^ s
				fl = fs
				fs = ((32768 - 32 - fs) * (16384 - decay)) >> 15
				let i = 1
				for fs > 0 && i < v {
					fs *= 2
					fl += fs + 2
					fs = (fs * decay) >> 15
					i++
				}
				if fs == 0 {
					let ndiMax = 32768 - fl
					ndiMax = (ndiMax - s) >> 1
					let di = (v - i).min(ndiMax - 1)
					fl += 2 * di + 1 + s
					fs = (32768 - fl).min(1)
					coded = (i + di + s) ^ s
				} else {
					fs += 1
					fl += fs & ^s
				}
			}
			encodeBin(fl, fl + fs, 15)
			return coded
		}

		// Bits written so far, rounded up.
		def tell() int {
			return nbitsTotal - opusIlog(rng)
		}

		// Bits written so far in eighths of a bit, rounded up.
		def tellFrac() int {
			return opusTellFrac(nbitsTotal, rng)
		}

		// The final range, which a matching decoder reproduces.
		def range() int {
			return rng
		}

		// The frame size in bytes.
		def size() int {
			return storage
		}

		// Counts every bit of a frame of `totalBits` as written, as a silent
		// frame does.
		def markWritten(totalBits int) {
			nbitsTotal += totalBits - tell()
		}

		// Moves the raw bits so the frame ends at `size` bytes.
		def shrink(size int) {
			for let i = 0; i < endOffs; i++ {
				buf[size - endOffs + i] = buf[storage - endOffs + i]
			}
			storage = size
		}

		// Flushes the coder: the buffer then holds the whole frame, the unused
		// middle zeroed.
		def done() {
			let l = 32 - opusIlog(rng)
			let msk = 0x7FFFFFFF >> l
			let end = (val + msk) & ^msk
			if (end | msk) >= val + rng {
				l++
				msk = msk >> 1
				end = (val + msk) & ^msk
			}
			for l > 0 {
				carryOut(end >> 23)
				end = (end << 8) & 0x7FFFFFFF
				l -= 8
			}
			carryOut(0) when rem >= 0 || ext > 0
			let window = endWindow
			let used = nendBits
			for used >= 8 {
				writeByteAtEnd(window & 255)
				window = window >> 8
				used -= 8
			}
			return when error
			for let i = offs; i < storage - endOffs; i++ {
				buf[i] = 0
			}
			if used > 0 {
				if endOffs >= storage {
					error = true
					return
				}
				let nl = -l
				if offs + endOffs >= storage && nl < used {
					window = window & ((1 << nl) - 1)
					error = true
				}
				let at = storage - endOffs - 1
				buf[at] = byte(int(buf[at]) | (window & 255))
			}
		}

		// The coded frame after `done`.
		def bytes() byte[] {
			return buf[0:storage]
		}
	}
}
