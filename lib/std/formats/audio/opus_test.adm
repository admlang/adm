		// The bytes of fixture `name`.
		def fixture(name string) byte[] {
			return opusTestHex(opusTestFixtureSilkNb) when name == "silk_nb"
			return opusTestHex(opusTestFixtureSilkWbStereo) when name == "silk_wb_stereo"
			return opusTestHex(opusTestFixtureHybridFb) when name == "hybrid_fb"
			return opusTestHex(opusTestFixtureSilkWb60ms) when name == "silk_wb_60ms"
			return opusTestHex(opusTestFixtureHybridStereo) when name == "hybrid_stereo"
			return opusTestHex(opusTestFixtureSurround) when name == "surround"
			return opusTestHex(opusTestFixtureSwitch) when name == "switch"
			return byte[]
		}

		// Encodes `tone` with `codec` and decodes the result; returns the
		// signal-to-noise ratio in dB of the decoded audio against the tone
		// sampled at 48 kHz, and checks the frame count.
		def roundTrip(codec Opus, tone OpusTestTone, outChannels int) !float {
			let out = new bytes.Buffer()
			try codec.encode(tone, out)
			let decoded = try load(out.bytes())
			let expected = int((float(tone.frames) * 48000.0 / float(tone.rate)).ceil())
			assert int(decoded.info.channels) == outChannels // channels coded
			assert int(decoded.info.frames) == expected // end trimmed by the granule
			let sig = 0.0
			let err = 0.0
			let ref48 = new OpusTestTone(48000, tone.freqs, expected)
			for let i = 480; i < expected - 480; i++ {
				for let ch = 0; ch < outChannels; ch++ {
					let want = float(ref48.sample(ch.min(tone.freqs.len() - 1), i))
					let got = float(decoded.samples[i * outChannels + ch])
					sig += want * want
					err += (got - want) * (got - want)
				}
			}
			return 10.0 * math.ln(sig / err.max(1e-20)) / math.ln(10.0)
		}

		@test()
		def rangeCoderRoundTrip() !none {
			let enc = new OpusRangeEncoder(4000)
			let kinds int[]
			let values int[]
			let params int[]
			let tells int[]
			let seed = 12345
			for let i = 0; i < 3000; i++ {
				seed = celtLcgRand(seed)
				let kind = (seed >> 8) % 6
				seed = celtLcgRand(seed)
				let r = seed >> 4
				let p = 0
				let v = 0
				if kind == 0 {
					p = 2 + r % 300
					v = (r >> 9) % p
					enc.uint(v, p)
				} else if kind == 1 {
					p = 1 + r % 24
					v = (r >> 5) & ((1 << p) - 1)
					enc.bits(v, p)
				} else if kind == 2 {
					p = 1 + r % 15
					v = ((r >> 4) & 7) == 0 ?? (1, 0)
					enc.bitLogp(v == 1, p)
				} else if kind == 3 {
					v = r % 11
					enc.icdf(v, celtTrimIcdf, 7)
				} else if kind == 4 {
					p = (r >> 3) % 3
					v = ((r >> 8) % 41) - 20
					v = enc.laplace(v, celtEProbModel[p * 2] << 7, celtEProbModel[p * 2 + 1] << 6)
				} else {
					p = 1 + r % 4000000000
					v = (r >> 2) % p
					enc.uint(v, p)
				}
				kinds.push(kind)
				values.push(v)
				params.push(p)
				tells.push(enc.tellFrac())
			}
			enc.done()
			assert !enc.error // the symbols fit the buffer
			let data = enc.bytes()
			let dec = new OpusRangeDecoder(data, 0, data.len())
			for let i = 0; i < kinds.len(); i++ {
				let kind = kinds[i]
				let p = params[i]
				let v = 0
				if kind := 0 || 5 {
					v = dec.uint(p)
				} else if kind == 1 {
					v = dec.bits(p)
				} else if kind == 2 {
					v = dec.bitLogp(p) ?? (1, 0)
				} else if kind == 3 {
					v = dec.icdf(celtTrimIcdf, 7)
				} else {
					v = dec.laplace(celtEProbModel[p * 2] << 7, celtEProbModel[p * 2 + 1] << 6)
				}
				assert v == values[i] // decoded symbol
				assert dec.tellFrac() == tells[i] // both sides count the same bits
			}
			assert dec.range() == enc.range() // the coders end in the same state
			assert !dec.error // no value out of range
		}

		@test()
		def ilogAndIsqrt() !none {
			assert opusIlog(0) == 0
			assert opusIlog(1) == 1
			assert opusIlog(255) == 8
			assert opusIlog(256) == 9
			assert opusIlog(0xFFFFFFFF) == 32
			assert celtIsqrt(0) == 0
			assert celtIsqrt(15) == 3
			assert celtIsqrt(16) == 4
			assert celtIsqrt(1000000) == 1000
		}

		@test()
		def signature() !none {
			let codec = new Opus()
			assert codec.matchSignature(new bytes.Reader(fixture("silk_nb"))) // an Ogg Opus file
			let vorbis = fixture("silk_nb")
			let magic = "\u0001vorbis\u0000".bytes()
			for let i = 0; i < magic.len(); i++ {
				vorbis[28 + i] = magic[i]
			}
			assert !codec.matchSignature(new bytes.Reader(vorbis)) // Ogg carrying Vorbis
			assert !codec.matchSignature(new bytes.Reader("RIFF....WAVEfmt ".bytes())) // not Ogg
			assert !codec.matchSignature(new bytes.Reader(byte[79, 103, 103])) // truncated
		}

		@test()
		def registryOpensOpus() !none {
			let s = try open(fixture("silk_nb"))
			assert s.info().codec == "opus"
			assert s.info().sampleRate == 48000
			assert s.info().seekable
			try s.close()
		}

		@test()
		def decodesSampleFiles() !none {
			for let (_, t) in sampleCases() {
				let data = sample(t.name)
				continue when data is none
				let s = try new Opus().open(new bytes.Reader(data))
				try compareWindows(s, t, 1e-6)
			}
		}

		@test()
		def decodesWholeSample() !none {
			let data = sample("opus_5s_sample_file_94KB.opus")
			return none when data is none
			let audio = try load(data)
			assert audio.info.frames == 240000 // every frame, pre-skip and end trimmed
			assert audio.samples.len() == 240000
			let t = sampleCases()[0]
			for let (_, w) in t.windows {
				for let i = 0; i < w.values.len(); i++ {
					assert float(audio.samples[w.at + i] - w.values[i]).abs() <= 1e-6 // matches ffmpeg
				}
			}
		}

		@test()
		def decodesEveryMode() !none {
			for let (_, t) in fixtureCases() {
				let s = try new Opus().open(new bytes.Reader(fixture(t.name)))
				try compareWindows(s, t, 1e-6)
			}
		}

		@test()
		def seekMatchesContinuousDecoding() !none {
			let data = fixture("hybrid_stereo")
			let whole = try load(data)
			let s = try new Opus().open(new bytes.Reader(data))
			for let (_, at) in int[0, 1, 959, 10000, 23990] {
				try s.seek(uint64(at))
				let buf float32[]
				buf.len(20)
				let got = try s.read(buf)
				assert got == (24000 - at).min(10) // frames up to the trimmed end
				for let i = 0; i < got * 2; i++ {
					assert buf[i] == whole.samples[at * 2 + i] // seeking reproduces the samples
				}
			}
			try s.seek(24000)
			let rest float32[]
			rest.len(8)
			assert (try s.read(rest)) == 0 // nothing after the end
		}

		// The frame length of `n` bytes as a packet codes it.
		def frameLength(p byte[], n int) {
			if n < 252 {
				p.push(byte(n))
			} else {
				p.push(byte(252 + (n & 3)))
				p.push(byte((n - 252 - (n & 3)) >> 2))
			}
		}

		@test()
		def decodesMultiFramePackets() !none {
			let codec = new Opus()
			codec.bitrate = 128000
			let out = new bytes.Buffer()
			try codec.encode(new OpusTestTone(48000, float[440.0, 660.0], 4800), out)
			let r = new OggPacketReader(new bytes.Reader(out.bytes()))
			let frames byte[][]
			for {
				let p = try r.next()
				break when p is none
				frames.push(p)
			}
			let toc = frames[2][0]
			let f1 = frames[2][1:]
			let f2 = frames[3][1:]
			let f3 = frames[4][1:]
			assert f1.len() > 252 // lengths take two bytes
			let single = new OpusDecoder(2)
			let want float32[]
			want.len(5760 * 2)
			let at = 0
			for let k = 2; k < 5; k++ {
				at += 2 * (try single.decode(frames[k], 0, frames[k].len(), false, want, at))
			}
			let packets byte[][]
			// Code 1: two frames of equal size, then the third alone.
			let p1 = byte[byte(int(toc) | 1)]
			p1.push(...f1)
			p1.push(...f2)
			packets.push(p1)
			// Code 2: two frames, the first length coded.
			let p2 = byte[byte(int(toc) | 2)]
			frameLength(p2, f1.len())
			p2.push(...f1)
			p2.push(...f2)
			packets.push(p2)
			// Code 3, constant size with padding.
			let p3 = byte[byte(int(toc) | 3), byte(0x40 | 3), 3]
			p3.push(...f1)
			p3.push(...f2)
			p3.push(...f3)
			p3.push(0, 0, 0)
			packets.push(p3)
			// Code 3, variable size.
			let p4 = byte[byte(int(toc) | 3), byte(0x80 | 3)]
			frameLength(p4, f1.len())
			frameLength(p4, f2.len())
			p4.push(...f1)
			p4.push(...f2)
			p4.push(...f3)
			packets.push(p4)
			for let (i, p) in packets {
				let dec = new OpusDecoder(2)
				let got float32[]
				got.len(5760 * 2)
				let n = try dec.decode(p, 0, p.len(), false, got, 0)
				if i < 2 {
					assert n == 1920 // two 20 ms frames
					n += try dec.decode(frames[4], 0, frames[4].len(), false, got, 2 * n)
				}
				assert n == 2880 // three frames in all
				for let j = 0; j < 2 * n; j++ {
					assert got[j] == want[j] // the same audio as the frames alone
				}
			}
		}

		@test()
		def survivesDamagedPackets() !none {
			let seed = 4242
			let pcm float32[]
			pcm.len(5760 * 8)
			let decoded = 0
			for let (_, t) in fixtureCases() {
				let r = new OggPacketReader(new bytes.Reader(fixture(t.name)))
				let packets byte[][]
				for {
					let p = try r.next()
					break when p is none
					packets.push(p)
				}
				let head = packets[0]
				let channels = int(head[9])
				let mapping = int[0, 1]
				let streams = 1
				let coupled = channels - 1
				if int(head[18]) != 0 {
					streams = int(head[19])
					coupled = int(head[20])
					mapping = int[]
					for let i = 0; i < channels; i++ {
						mapping.push(int(head[21 + i]))
					}
				}
				for let round = 0; round < 4; round++ {
					let dec = new OpusMultistreamDecoder(channels, streams, coupled, mapping)
					for let k = 2; k < packets.len(); k++ {
						let p byte[]
						for let (_, b) in packets[k] {
							p.push(b)
						}
						seed = celtLcgRand(seed)
						for let f = 0; f < seed % 4; f++ {
							seed = celtLcgRand(seed)
							let at = (seed >> 8) % p.len()
							p[at] = byte(int(p[at]) ^ (1 << ((seed >> 20) % 8)))
						}
						if (seed & 31) == 0 {
							dec.conceal(pcm, 0, 960) onerror recover 0
							continue
						}
						// Damage may be caught as an error; it must never crash.
						dec.decode(p, 0, p.len(), pcm, 0) onerror recover 0
						decoded++
					}
				}
			}
			assert decoded > 400 // the damaged packets were decoded or refused
		}

		@test()
		def readsTags() !none {
			let tags = try new Opus().readTags(new bytes.Reader(fixture("silk_nb")))
			assert tags.vendor.len() > 0 // the encoder's name
			assert tags.get("ENCODER") is string // opusenc writes its version
			assert tags.get("NO_SUCH_TAG") is none
		}

		@test()
		def encodesMono() !none {
			let codec = new Opus()
			codec.bitrate = 64000
			codec.tags.add("TITLE", "tone")
			let snr = try roundTrip(codec, new OpusTestTone(48000, float[997.0], 48000), 1)
			assert snr >= 25.0 // a 64 kbit/s tone decodes close to the input
			let out = new bytes.Buffer()
			try codec.encode(new OpusTestTone(48000, float[997.0], 4800), out)
			let tags = try codec.readTags(new bytes.Reader(out.bytes()))
			let title = tags.get("title")
			if title is string {
				assert title == "tone" // comments round-trip
			} else {
				assert false // the title comment is there
			}
			let info = try codec.info(new bytes.Reader(out.bytes()))
			assert info.frames == 4800 // the granule trims the padding
			assert info.channels == 1
		}

		@test()
		def encodesStereoFromOtherRates() !none {
			let codec = new Opus()
			codec.bitrate = 128000
			let snr = try roundTrip(codec, new OpusTestTone(44100, float[440.0, 1250.0], 44100), 2)
			assert snr >= 20.0 // 44.1 kHz stereo resampled and coded
			let snr16 = try roundTrip(codec, new OpusTestTone(16000, float[300.0, 500.0], 8000), 2)
			assert snr16 >= 20.0 // 16 kHz input
		}

		@test()
		def encodesEveryFrameSize() !none {
			for let (_, ms) in int[2500, 5000, 10000, 20000] {
				let codec = new Opus()
				codec.bitrate = 96000
				codec.frameDuration = duration(int64(ms) * 1000)
				let snr = try roundTrip(codec, new OpusTestTone(48000, float[997.0], 24000), 1)
				assert snr >= 20.0 // every CELT frame size decodes
			}
		}

		@test()
		def encodesSilenceAndManyChannels() !none {
			let codec = new Opus()
			let out = new bytes.Buffer()
			try codec.encode(new OpusTestTone(48000, float[0.0], 9600), out)
			let decoded = try load(out.bytes())
			let peak float32 = 0.0
			for let (_, v) in decoded.samples {
				peak = peak.max(v.abs())
			}
			assert peak == 0.0 // silence stays silent
			let snr = try roundTrip(codec, new OpusTestTone(48000, float[400.0, 400.0, 400.0, 0.0, 400.0, 400.0], 9600), 2)
			assert snr >= 15.0 // six channels mixed down to stereo keep the tone
		}
	}
}
