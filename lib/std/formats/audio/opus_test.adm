	check "Opus" {
		// Sample files live in the repo, and `adm test` runs from its root. A
		// missing sample skips rather than fails.
		let sampleDir = "samples/audio/opus/"

		def sample(name string) ?byte[] {
			let d = os.readFile(sampleDir + name)
			return none when d is error
			return d
		}

		// Checks the stream's frame count, then seeks to each window and
		// compares it with `tolerance`; returns the largest difference.
		def compareWindows(s AudioStream, t OpusTestCase, tolerance float) !float {
			let info = s.info()
			assert int(info.channels) == t.channels // channel count
			assert int(info.frames) == t.frames // frame count from the last granule
			let worst = 0.0
			for let (_, w) in t.windows {
				try s.seek(uint64(w.at))
				let buf float32[]
				buf.len(w.values.len())
				let got = try s.read(buf)
				assert got * t.channels == w.values.len() // whole window read
				for let i = 0; i < w.values.len(); i++ {
					let d = float(buf[i] - w.values[i]).abs()
					worst = worst.max(d)
				}
			}
			assert worst <= tolerance // decoded samples match the reference
			return worst
		}

