partial module std.formats.audio {
	use (
		std.testing
		std.os
		std.bytes
		std.math
		std.formats.audio.celt::*
		std.formats.audio.ogg::*
		std.formats.audio.opus::*
		std.formats.audio.seek::*
	)

	// A decoded window a test compares: `values.len() / channels` frames
	// starting at frame `at`.
	internal struct OpusTestWindow {
		at     int
		values float32[]
	}

	// A file with its expected frame count, channels and windows.
	internal struct OpusTestCase {
		name     string
		channels int
		frames   int
		windows  OpusTestWindow[]
	}

	// A synthetic AudioStream of sine tones, one frequency per channel, for
	// the encoder tests.
	internal type OpusTestTone {
		// The frame the next read starts at.
		internal framePosition uint64

		// Frames per second.
		rate              int
		// The tone of each channel in Hz.
		freqs             float[]
		// Frames in the stream.
		frames            int
		internal streamAt int

		// `frames` frames at `rate` Hz of tones at `freqs` Hz (one per
		// channel), amplitude 0.5.
		def new(rate int, freqs float[], frames int) {
			self.rate = rate
			self.freqs = freqs
			self.frames = frames
		}

		// The sample of `channel` at frame `k`.
		def sample(channel int, k int) float32 {
			return float32(0.5 * math.sin(2.0 * math.π * freqs[channel] * float(k) / float(rate)))
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return AudioInfo{
				sampleRate: uint32(rate),
				channels: uint16(freqs.len()),
				bitDepth: 32,
				format: SampleFormat.Float32,
				frames: uint64(frames),
				codec: "tone",
				seekable: true
			}
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream; it cannot fail.
		internal def readFrames(buf float32[]) !int {
			let c = freqs.len()
			let n = (buf.len() / c).min(frames - streamAt)
			for let i = 0; i < n; i++ {
				for let ch = 0; ch < c; ch++ {
					buf[i * c + ch] = sample(ch, streamAt + i)
				}
			}
			streamAt += n
			return n
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream; it cannot fail.
		internal def seekFrame(frame uint64) !none {
			streamAt = int(frame)
			return none
		}

		// close implements io.Closer; it cannot fail.
		def close() !none {
			return none
		}
	}

	// The bytes of a hexadecimal string.
	internal def opusTestHex(s string) byte[] {
		let out byte[]
		let digits = s.bytes()
		for let i = 0; i + 1 < digits.len(); i += 2 {
			out.push(byte(opusTestNibble(int(digits[i])) * 16 + opusTestNibble(int(digits[i + 1]))))
		}
		return out
	}

	// The value of one hexadecimal digit.
	internal def opusTestNibble(c int) int {
		return c - 48 when c <= 57
		return c - 87
	}

