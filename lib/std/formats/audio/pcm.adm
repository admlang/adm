partial module std.formats.audio {
	use (
		std.bytes::(Endian)
		std.io
		std.formats.audio.pcm::*
	)

	// Raw interleaved PCM samples with no container around them.
	//
	// Deliberately not a codec. A `.pcm` file is headerless -- it carries no
	// signature to probe for and no sample rate, channel count, or sample
	// layout to read -- so the registry could never identify one, and a caller
	// has to supply those parameters from somewhere else. That makes PCM a
	// representation rather than a file format, so it is constructed directly
	// instead of being discovered.
	//
	// The bytes are little-endian unless `endian` says otherwise, one sample
	// per channel per frame in `info.format`: `Uint8` is offset by 128, the other integer layouts are
	// signed, and the float layouts are IEEE.
	type PCM {
		info    AudioInfo
		samples float32[]

		// Reads raw interleaved samples from `reader`, interpreting them as
		// `info` describes -- so `info` has to be set before calling this,
		// because the bytes themselves say nothing about rate, channels, or
		// layout.
		//
		// Replaces `samples` with everything up to the end of the reader, as
		// float32 in -1.0..1.0 (float layouts pass through as stored), and sets
		// `info.frames`, `length`, `bitDepth` and `codec`. Bytes after the last
		// whole frame are dropped.
		//
		// Fails when `info.sampleRate` or `info.channels` is 0, or the reader
		// fails.
		def fromReader(reader io.Reader, endian Endian = Endian.Little) !none {
			let channels = int(info.channels)
			fail "pcm: info has no sample rate or channel count" when info.sampleRate == 0 || channels == 0
			let width = sampleWidth()
			let chunk byte[]
			chunk.len(PCM_CHUNK_BYTES)
			let decoded float32[]
			let count = 0
			let held = 0
			for {
				let n = try reader.read(chunk[held:])
				break when n == 0
				let available = held + n
				let whole = available / width
				if count + whole > decoded.len() {
					let grown = decoded.len() * 2
					decoded.len(grown > count + whole ?? (grown, count + whole))
				}
				swapSamples(chunk, whole, width) when endian == Endian.Big
				decode(chunk, whole, decoded, count)
				count += whole
				let used = whole * width
				held = available - used
				for let i = 0; i < held; i++ {
					chunk[i] = chunk[used + i]
				}
			}
			decoded.len(count - count % channels)
			samples = decoded
			info.bitDepth = uint16(width * 8)
			info.codec = "pcm"
			info.seekable = true
			info.frames = uint64(samples.len() / channels)
			info.length = duration(int64(info.frames) * 1000000000 / int64(info.sampleRate))
			return none
		}

		// Writes `samples` as raw interleaved bytes in `info.format`'s layout,
		// in the byte order `endian` says. Integer layouts clip samples to -1.0..1.0 and round to
		// the nearest step; float layouts store them as they are.
		//
		// Fails when the writer fails or accepts no bytes.
		def write(writer io.Writer, endian Endian = Endian.Little) !none {
			let width = sampleWidth()
			let perChunk = PCM_CHUNK_BYTES / width
			let chunk byte[]
			chunk.len(perChunk * width)
			for let start = 0; start < samples.len(); start += perChunk {
				let count = samples.len() - start < perChunk ?? (samples.len() - start, perChunk)
				encode(start, count, chunk)
				swapSamples(chunk, count, width) when endian == Endian.Big
				let size = count * width
				let off = 0
				for off < size {
					let n = try writer.write(chunk[off:size])
					fail "pcm: the writer accepted no bytes" when n <= 0
					off += n
				}
			}
			return none
		}

		// Reads the stream from where it stands to its end into `samples`, and
		// takes its rate and channel count. `info.format` is left as it is, so
		// a following `write` stores the samples in the layout set there.
		//
		// Fails when the stream does or has no channels.
		def fromStream(stream AudioStream) !none {
			let described = stream.info()
			let channels = int(described.channels)
			fail "pcm: the stream has no channels" when channels == 0
			let buf float32[]
			buf.len(PCM_CHUNK_BYTES / 4 / channels * channels)
			let collected float32[]
			for {
				let frames = try stream.read(buf)
				break when frames == 0
				for let i = 0; i < frames * channels; i++ {
					collected.push(buf[i])
				}
			}
			samples = collected
			info.sampleRate = described.sampleRate
			info.channels = described.channels
			info.codec = "pcm"
			info.seekable = true
			info.frames = uint64(collected.len() / channels)
			info.length = described.sampleRate == uint32(0) ?? (0s, duration(int64(info.frames) * 1000000000 / int64(described.sampleRate)))
			return none
		}

		// An `AudioStream` over these samples, so PCM feeds anything that takes
		// decoded audio. The stream reads `samples` in place, so it sees later
		// changes to them; its `info` counts the frames `samples` holds.
		// A decoder for packets of these samples in `endian` order, as
		// containers (AVI, Matroska, MP4, FLV) store PCM tracks: each packet
		// is a run of whole frames in `info.format`.
		//
		// Fails when `info.sampleRate` or `info.channels` is 0.
		def decoder(endian Endian = Endian.Little) !AudioDecoder {
			fail "pcm: info has no sample rate or channel count" when info.sampleRate == 0 || info.channels == 0
			let layout = new PCM()
			layout.info = info
			return new PcmPacketDecoder(layout, endian)
		}

		// A decoder for packets of G.711 codes (A-law or µ-law, one byte a
		// sample) at this layout's rate and channels.
		//
		// Fails when `info.sampleRate` or `info.channels` is 0.
		def decoder(law Companding) !AudioDecoder {
			fail "pcm: info has no sample rate or channel count" when info.sampleRate == 0 || info.channels == 0
			return new CompandedDecoder(info, law)
		}

		def stream() AudioStream {
			return new PCMStream(self)
		}

		// Reverses the bytes of each of the first `count` samples of `width`
		// bytes in `data`, between big- and little-endian.
		internal def swapSamples(data byte[], count int, width int) {
			for let i = 0; i < count; i++ {
				let at = i * width
				for let k = 0; k < width / 2; k++ {
					let b = data[at + k]
					data[at + k] = data[at + width - 1 - k]
					data[at + width - 1 - k] = b
				}
			}
		}

		// Bytes per sample in `info.format`.
		internal def sampleWidth() int {
			match info.format {
				case SampleFormat.Uint8:
					return 1
				case SampleFormat.Int16:
					return 2
				case SampleFormat.Int24:
					return 3
				case SampleFormat.Int32:
					return 4
				case SampleFormat.Float32:
					return 4
				case SampleFormat.Float64:
					return 8
			}
			return 2
		}

		// Decodes `count` samples from the start of `data` into `out` from
		// `at` on.
		internal def decode(data byte[], count int, out float32[], at int) {
			match info.format {
				case SampleFormat.Uint8:
					for let i = 0; i < count; i++ {
						out[at + i] = float32(float64(int(data[i]) - 128) / 128.0)
					}
				case SampleFormat.Int16:
					for let i = 0; i < count; i++ {
						let v = int(data[2 * i]) | int(data[2 * i + 1]) << 8
						out[at + i] = float32(float64(v >= 0x8000 ?? (v - 0x10000, v)) / 32768.0)
					}
				case SampleFormat.Int24:
					for let i = 0; i < count; i++ {
						let o = 3 * i
						let v = int(data[o]) | int(data[o + 1]) << 8 | int(data[o + 2]) << 16
						out[at + i] = float32(float64(v >= 0x800000 ?? (v - 0x1000000, v)) / 8388608.0)
					}
				case SampleFormat.Int32:
					for let i = 0; i < count; i++ {
						let v = littleEndian(data, 4 * i, 4)
						out[at + i] = float32(float64(v >= 0x80000000 ?? (v - 0x100000000, v)) / 2147483648.0)
					}
				case SampleFormat.Float32:
					for let i = 0; i < count; i++ {
						out[at + i] = __bitcast_f32_from_u32(uint32(littleEndian(data, 4 * i, 4)))
					}
				case SampleFormat.Float64:
					for let i = 0; i < count; i++ {
						let lo = uint64(littleEndian(data, 8 * i, 4))
						let hi = uint64(littleEndian(data, 8 * i + 4, 4))
						out[at + i] = float32(__bitcast_f64_from_u64(hi << 32 | lo))
					}
			}
		}

		// Encodes `count` samples from `samples[start]` on into the start of
		// `out`.
		internal def encode(start int, count int, out byte[]) {
			match info.format {
				case SampleFormat.Uint8:
					for let i = 0; i < count; i++ {
						out[i] = byte(quantize(samples[start + i], 128.0, 127) + 128)
					}
				case SampleFormat.Int16:
					for let i = 0; i < count; i++ {
						putLittleEndian(out, 2 * i, 2, quantize(samples[start + i], 32768.0, 32767))
					}
				case SampleFormat.Int24:
					for let i = 0; i < count; i++ {
						putLittleEndian(out, 3 * i, 3, quantize(samples[start + i], 8388608.0, 8388607))
					}
				case SampleFormat.Int32:
					for let i = 0; i < count; i++ {
						putLittleEndian(out, 4 * i, 4, quantize(samples[start + i], 2147483648.0, 2147483647))
					}
				case SampleFormat.Float32:
					for let i = 0; i < count; i++ {
						putLittleEndian(out, 4 * i, 4, int(__bitcast_u32_from_f32(samples[start + i])))
					}
				case SampleFormat.Float64:
					for let i = 0; i < count; i++ {
						let bits = __bitcast_u64_from_f64(float64(samples[start + i]))
						putLittleEndian(out, 8 * i, 4, int(bits & 0xFFFFFFFF))
						putLittleEndian(out, 8 * i + 4, 4, int(bits >> 32))
					}
			}
		}

		// The sample scaled by `scale`, rounded, and clipped to
		// -`scale`..`top`; NaN is silence.
		internal def quantize(sample float32, scale float, top int) int {
			let scaled = (float(sample) * scale).round()
			return int(scaled) when scaled < float(top) && scaled > -scale
			return top when scaled >= float(top)
			return -top - 1 when scaled <= -scale
			return 0
		}

		// The unsigned little-endian number in `size` bytes of `data` at `offset`.
		internal def littleEndian(data byte[], offset int, size int) int {
			let v = 0
			for let i = size - 1; i >= 0; i-- {
				v = v << 8 | int(data[offset + i])
			}
			return v
		}

		// Stores the low `size` bytes of `value` little-endian in `out` at
		// `offset`.
		internal def putLittleEndian(out byte[], offset int, size int, value int) {
			for let i = 0; i < size; i++ {
				out[offset + i] = byte(value >> (8 * i) & 0xFF)
			}
		}
	}

	// Companding names the two laws of ITU-T G.711, which store a 16-bit
	// sample in eight bits.
	enum Companding {
		ALaw,
		MuLaw
	}
}

internal partial module std.formats.audio.pcm {
	use (
		std.bytes
		std.bytes::(Endian)
		std.formats.audio.seek::*
		std.formats.audio::*
		std.formats.audio.wav::(wavALaw, wavMuLaw)
	)

	// Bytes read or written per pass.
	const PCM_CHUNK_BYTES = 65536

	// Streams the samples of a `PCM`.
	type PCMStream {
		// The frame the next read starts at.
		framePosition uint64

		pcm      PCM
		// Index of the next sample to read.
		streamAt int

		// A stream at the first frame of `pcm`.
		def new(pcm PCM) {
			self.pcm = pcm
		}

		// Info implements AudioStream: the `PCM`'s info, with `frames` and
		// `length` counting the frames its samples hold.
		def info() AudioInfo {
			let described = pcm.info
			let channels = int(described.channels)
			described.frames = channels == 0 ?? (uint64(0), uint64(pcm.samples.len() / channels))
			described.length = described.sampleRate == 0 ?? (0s, duration(int64(described.frames) * 1000000000 / int64(described.sampleRate)))
			described.codec = "pcm"
			described.seekable = true
			return described
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// Read implements AudioStream.
		//
		// Fails when the `PCM` has no channels.
		def readFrames(buf float32[]) !int {
			let channels = int(pcm.info.channels)
			fail "pcm: info has no channel count" when channels == 0
			let left = (pcm.samples.len() - streamAt) / channels
			let room = buf.len() / channels
			let frames = left < room ?? (left, room)
			return 0 when frames <= 0
			let n = frames * channels
			pcm.samples[streamAt:streamAt + n].copy(buf)
			streamAt += n
			return frames
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// Seek implements AudioStream.
		//
		// Fails when `frame` is past the last frame.
		def seekFrame(frame uint64) !none {
			let total = info().frames
			fail "pcm: frame {frame} is past the end ({total} frames)" when frame > total
			streamAt = int(frame) * int(pcm.info.channels)
			return none
		}

		// Close implements AudioStream; there is nothing to release.
		def close() !none {
			return none
		}
	}

	// PCM packets decoded one at a time; see `PCM.decoder`.
	type PcmPacketDecoder {
		layout  PCM
		endian  Endian
		details AudioInfo

		def new(layout PCM, endian Endian) {
			self.layout = layout
			self.endian = endian
			details = layout.info
			details.codec = "pcm"
		}

		def info() AudioInfo {
			return details
		}

		// Fails when reading the packet does.
		def decode(packet byte[]) !float32[] {
			try layout.fromReader(new bytes.Reader(packet), endian)
			return layout.samples
		}

		// PCM holds nothing back.
		def flush() !float32[] {
			return float32[]
		}

		def reset() {}
	}

	// CompandedDecoder decodes packets of G.711 codes, one byte a sample,
	// as containers store such tracks (`PCM.decoder(law)`).
	type CompandedDecoder {
		details        AudioInfo
		internal level float32[] = []

		def new(info AudioInfo, law Companding) {
			// A record of its own: `info` stays the caller's.
			details = AudioInfo{sampleRate: info.sampleRate, channels: info.channels, bitDepth: 8, format: SampleFormat.Int16, codec: law == Companding.ALaw ?? ("pcm_alaw", "pcm_mulaw")}
			level.len(256)
			for let code = 0; code < 256; code++ {
				level[code] = float32(float(law == Companding.ALaw ?? (wavALaw(code), wavMuLaw(code))) / 32768.0)
			}
		}

		def info() AudioInfo {
			return details
		}

		// Never fails: every byte is a sample.
		def decode(packet byte[]) !float32[] {
			let out float32[]
			out.len(packet.len())
			for let i = 0; i < packet.len(); i++ {
				out[i] = level[int(packet[i])]
			}
			return out
		}

		// Nothing is held back.
		def flush() !float32[] {
			return float32[]
		}

		def reset() {}
	}
}
