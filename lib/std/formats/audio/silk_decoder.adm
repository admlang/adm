internal partial module std.formats.audio.silk {
	use std.formats.audio.opus::*

	// Signal types of a SILK frame (unvoiced is 1).
	const silkNoVoice = 0

	// Voiced frame (the others are no voice activity, 0, and unvoiced, 1).
	const silkVoiced = 2

	// How a SILK frame's parameters are coded relative to the frame before.
	const silkCodeIndependently = 0

	// Independent coding after a skipped side frame: no LTP scaling.
	const silkCodeIndependentlyNoLtpScaling = 1

	// Coded relative to the previous frame.
	const silkCodeConditionally = 2

	// A SILK NLSF codebook (RFC 6716 section 4.2.7.5): the first-stage
	// vectors, their entropy tables and the second-stage residual model.
	type SilkNlsfCodebook {
		// First-stage vectors.
		vectors      int
		// Coefficients per vector: 10 or 16.
		order        int
		// Residual quantization step in Q16.
		quantStep    int
		// The inverse of the step in Q6.
		invQuantStep int
		// First-stage vectors in Q8, `order` values each.
		cb1          int[]
		// Inverse CDFs of the first-stage index, unvoiced then voiced.
		cb1Icdf      int[]
		// Residual predictor coefficients in Q8.
		pred         int[]
		// Per first-stage vector, the residual tables and predictors of each
		// coefficient pair.
		selection    int[]
		// Inverse CDFs of the residuals.
		residualIcdf int[]
		// Rates of the residuals in Q5.
		residualBits int[]
		// Minimum spacing of the NLSFs in Q15, order + 1 values.
		deltaMin     int[]

		// The narrowband and medium-band codebook when `wide` is false, the
		// wideband one when true.
		def new(wide bool) {
			vectors = 32
			if wide {
				order = 16
				quantStep = 9830
				invQuantStep = 427
				cb1 = silkNlsfCb1Wb
				cb1Icdf = silkNlsfCb1IcdfWb
				pred = silkNlsfPredWb
				selection = silkNlsfCb2SelectWb
				residualIcdf = silkNlsfCb2IcdfWb
				residualBits = silkNlsfCb2BitsWb
				deltaMin = silkNlsfDeltaMinWb
			} else {
				order = 10
				quantStep = 11796
				invQuantStep = 356
				cb1 = silkNlsfCb1NbMb
				cb1Icdf = silkNlsfCb1IcdfNbMb
				pred = silkNlsfPredNbMb
				selection = silkNlsfCb2SelectNbMb
				residualIcdf = silkNlsfCb2IcdfNbMb
				residualBits = silkNlsfCb2BitsNbMb
				deltaMin = silkNlsfDeltaMinNbMb
			}
		}

		// Fills the entropy table offsets and predictor coefficients of first
		// stage vector `index`.
		def unpack(ecIx int[], predQ8 int[], index int) {
			let at = index * order / 2
			for let i = 0; i < order; i += 2 {
				let entry = selection[at]
				at++
				ecIx[i] = ((entry >> 1) & 7) * 9
				predQ8[i] = pred[i + (entry & 1) * (order - 1)]
				ecIx[i + 1] = ((entry >> 5) & 7) * 9
				predQ8[i + 1] = pred[i + ((entry >> 4) & 1) * (order - 1) + 1]
			}
		}

		// The Q15 NLSFs of the codebook path in `indices` (first-stage index,
		// then one residual per coefficient), stabilised.
		def decode(nlsf int[], indices int[], ecIx int[], predQ8 int[], res int[], w int[]) {
			let at = indices[0] * order
			for let i = 0; i < order; i++ {
				nlsf[i] = cb1[at + i] << 7
			}
			unpack(ecIx, predQ8, indices[0])
			let out = 0
			for let i = order - 1; i >= 0; i-- {
				let predQ10 = (silkSmulbb(out, predQ8[i])) >> 8
				out = indices[i + 1] << 10
				if out > 0 {
					out -= 102
				} else if out < 0 {
					out += 102
				}
				out = silkSmlawb(predQ10, out, quantStep)
				res[i] = out
			}
			silkNlsfWeights(w, nlsf, order)
			for let i = 0; i < order; i++ {
				let wq9 = silkSqrtApprox(w[i] << 16)
				let v = nlsf[i] + (res[i] << 14) / wq9
				nlsf[i] = v.max(0).min(32767)
			}
			silkNlsfStabilize(nlsf, deltaMin, order)
		}
	}

	// The Laroia weights of the `d` Q15 NLSFs, in Q2.
	def silkNlsfWeights(w int[], nlsf int[], d int) {
		let t1 = (1 << 17) / nlsf[0].max(1)
		let t2 = (1 << 17) / (nlsf[1] - nlsf[0]).max(1)
		w[0] = (t1 + t2).min(32767)
		for let k = 1; k < d - 1; k += 2 {
			t1 = (1 << 17) / (nlsf[k + 1] - nlsf[k]).max(1)
			w[k] = (t1 + t2).min(32767)
			t2 = (1 << 17) / (nlsf[k + 2] - nlsf[k + 1]).max(1)
			w[k + 1] = (t1 + t2).min(32767)
		}
		t1 = (1 << 17) / ((1 << 15) - nlsf[d - 1]).max(1)
		w[d - 1] = (t1 + t2).min(32767)
	}

	// Resamples SILK output from 8, 12 or 16 kHz to 48 kHz: 2x allpass
	// upsampling followed by fractional FIR interpolation, with the
	// reference decoder's delay compensation.
	type SilkResampler {
		fsIn       int
		inputDelay int
		batchSize  int
		invRatio   int
		sIIR       int[]
		sFIR       int[]
		delayBuf   int[]
		buf        int[]

		// An upsampler for 16 kHz until `init` says otherwise.
		def new() {
			sIIR.len(6)
			sFIR.len(8)
			delayBuf.len(48)
			buf.len(2 * 160 + 8)
			init(16000)
		}

		// Starts over for input at `fsInHz`.
		def init(fsInHz int) {
			for let i = 0; i < 6; i++ {
				sIIR[i] = 0
			}
			for let i = 0; i < 8; i++ {
				sFIR[i] = 0
			}
			for let i = 0; i < 48; i++ {
				delayBuf[i] = 0
			}
			fsIn = fsInHz / 1000
			inputDelay = fsIn == 8 ?? (0, fsIn == 12 ?? (4, 7))
			batchSize = fsIn * 10
			invRatio = (((fsInHz << 15) / 48000) << 2)
			for silkSmulww(invRatio, 48000) < (fsInHz << 1) {
				invRatio++
			}
		}

		// Takes on the state of `other`.
		def copyFrom(other SilkResampler) {
			fsIn = other.fsIn
			inputDelay = other.inputDelay
			batchSize = other.batchSize
			invRatio = other.invRatio
			for let i = 0; i < 6; i++ {
				sIIR[i] = other.sIIR[i]
			}
			for let i = 0; i < 8; i++ {
				sFIR[i] = other.sFIR[i]
			}
			for let i = 0; i < 48; i++ {
				delayBuf[i] = other.delayBuf[i]
			}
		}

		// Resamples `n` samples of `input` from `inAt` into `out` from
		// `outAt`, writing n * 48 / fsIn samples.
		def process(out int[], outAt int, input int[], inAt int, n int) {
			let nSamples = fsIn - inputDelay
			for let i = 0; i < nSamples; i++ {
				delayBuf[inputDelay + i] = input[inAt + i]
			}
			iirFir(out, outAt, delayBuf, 0, fsIn)
			iirFir(out, outAt + 48, input, inAt + nSamples, n - fsIn)
			for let i = 0; i < inputDelay; i++ {
				delayBuf[i] = input[inAt + n - inputDelay + i]
			}
		}

		// Upsamples `len` samples by two with the allpass filters.
		def up2(out int[], outAt int, input int[], inAt int, len int) {
			for let k = 0; k < len; k++ {
				let in32 = input[inAt + k] << 10
				let y = in32 - sIIR[0]
				let x = silkSmulwb(y, silkResamplerUp2Hq0[0])
				let out1 = sIIR[0] + x
				sIIR[0] = in32 + x
				y = out1 - sIIR[1]
				x = silkSmulwb(y, silkResamplerUp2Hq0[1])
				let out2 = sIIR[1] + x
				sIIR[1] = out1 + x
				y = out2 - sIIR[2]
				x = silkSmlawb(y, y, silkResamplerUp2Hq0[2])
				out1 = sIIR[2] + x
				sIIR[2] = out2 + x
				out[outAt + 2 * k] = silkSat16(silkRshiftRound(out1, 10))
				y = in32 - sIIR[3]
				x = silkSmulwb(y, silkResamplerUp2Hq1[0])
				out1 = sIIR[3] + x
				sIIR[3] = in32 + x
				y = out1 - sIIR[4]
				x = silkSmulwb(y, silkResamplerUp2Hq1[1])
				out2 = sIIR[4] + x
				sIIR[4] = out1 + x
				y = out2 - sIIR[5]
				x = silkSmlawb(y, y, silkResamplerUp2Hq1[2])
				out1 = sIIR[5] + x
				sIIR[5] = out2 + x
				out[outAt + 2 * k + 1] = silkSat16(silkRshiftRound(out1, 10))
			}
		}

		// Upsamples `lenIn` samples to 48 kHz in batches and returns where the
		// output ends.
		def iirFir(out int[], outAtIn int, input int[], inAtIn int, lenIn int) int {
			let outAt = outAtIn
			let inAt = inAtIn
			let len = lenIn
			for let i = 0; i < 8; i++ {
				buf[i] = sFIR[i]
			}
			let n = 0
			for {
				n = len.min(batchSize)
				up2(buf, 8, input, inAt, n)
				let maxIndex = n << 17
				for let index = 0; index < maxIndex; index += invRatio {
					let ti = silkSmulwb(index & 0xFFFF, 12)
					let p = index >> 16
					let a = ti * 4
					let b = (11 - ti) * 4
					let res = buf[p] * silkResamplerFracFir12[a] + buf[p + 1] * silkResamplerFracFir12[a + 1] + buf[p + 2] * silkResamplerFracFir12[a + 2] + buf[p + 3] * silkResamplerFracFir12[a + 3] + buf[p + 4] * silkResamplerFracFir12[b + 3] + buf[p + 5] * silkResamplerFracFir12[b + 2] + buf[p + 6] * silkResamplerFracFir12[b + 1] + buf[p + 7] * silkResamplerFracFir12[b]
					out[outAt] = silkSat16(silkRshiftRound(res, 15))
					outAt++
				}
				inAt += n
				len -= n
				break when len <= 0
				for let i = 0; i < 8; i++ {
					buf[i] = buf[(n << 1) + i]
				}
			}
			for let i = 0; i < 8; i++ {
				sFIR[i] = buf[(n << 1) + i]
			}
			return outAt
		}
	}

	// The state of one SILK channel (RFC 6716 section 4.2): the frame
	// parameters, the synthesis filters, the concealment and the comfort
	// noise.
	type SilkChannel {
		prevGain             int
		// Excitation of the last frame in Q14.
		exc                  int[]
		// Short-term synthesis filter state in Q14.
		sLpc                 int[]
		// The last `ltpMemLength` output samples.
		outBuf               int[]
		// Pitch lag of the last subframe of the last frame.
		lagPrev              int
		// Gain index of the last subframe.
		lastGainIndex        int
		// Internal rate in kHz: 8, 12 or 16.
		fsKHz                int
		fsApiHz              int
		// 5 ms subframes in a frame: 2 or 4.
		nbSubfr              int
		// Samples in a frame.
		frameLength          int
		// Samples in a subframe.
		subfrLength          int
		ltpMemLength         int
		lpcOrder             int
		prevNlsf             int[]
		// No frame decoded since the rate changed.
		firstFrameAfterReset bool
		lagLowBitsIcdf       int[]
		contourIcdf          int[]
		// Frames of the current packet decoded so far.
		framesDecoded        int
		// SILK frames in the packet.
		framesPerPacket      int
		ecPrevSignalType     int
		ecPrevLagIndex       int
		// Voice activity of each frame of the packet.
		vadFlags             int[]
		// Whether the packet carries redundant (LBRR) frames.
		lbrrFlag             int
		// Which frames carry redundancy.
		lbrrFlags            int[]
		// Upsamples the channel's output to 48 kHz.
		resampler            SilkResampler
		cb                   SilkNlsfCodebook
		cbNarrow             SilkNlsfCodebook
		cbWide               SilkNlsfCodebook
		gainsIndices         int[]
		ltpIndex             int[]
		nlsfIndices          int[]
		lagIndex             int
		contourIndex         int
		// Signal type of the frame being decoded.
		signalType           int
		quantOffsetType      int
		nlsfInterpCoef       int
		perIndex             int
		ltpScaleIndex        int
		seed                 int
		cngExcBuf            int[]
		cngSmthNlsf          int[]
		cngSynthState        int[]
		cngSmthGain          int
		cngRandSeed          int
		cngFsKHz             int
		// Frames concealed in a row.
		lossCnt              int
		// Signal type of the last frame.
		prevSignalType       int
		plcPitchL            int
		plcLtpCoef           int[]
		plcPrevLpc           int[]
		plcLastFrameLost     bool
		plcRandSeed          int
		plcRandScale         int
		plcConcEnergy        int
		plcConcShift         int
		plcPrevLtpScale      int
		plcPrevGain          int[]
		plcFsKHz             int
		plcNbSubfr           int
		plcSubfrLength       int
		pitchL               int[]
		gains                int[]
		predCoef0            int[]
		predCoef1            int[]
		ltpCoef              int[]
		ltpScale             int
		pulses               int[]
		sLtp                 int[]
		sLtpQ15              int[]
		resQ14               int[]
		sLpcQ14              int[]
		nlsf                 int[]
		nlsf0                int[]
		ecIx                 int[]
		predQ8               int[]
		resQ10               int[]
		wTmp                 int[]
		sumPulses            int[]
		nLshifts             int[]
		pulses1              int[]
		pulses2              int[]
		pulses3              int[]
		signIcdf             int[]
		excBuf               int[]
		aQ12                 int[]
		cngSig               int[]
		frame                int[]

		// A channel in its reset state.
		def new() {
			exc.len(320)
			sLpc.len(16)
			outBuf.len(480)
			prevNlsf.len(16)
			vadFlags.len(3)
			lbrrFlags.len(3)
			resampler = new SilkResampler()
			cbNarrow = new SilkNlsfCodebook(false)
			cbWide = new SilkNlsfCodebook(true)
			cb = cbNarrow
			gainsIndices.len(4)
			ltpIndex.len(4)
			nlsfIndices.len(17)
			cngExcBuf.len(320)
			cngSmthNlsf.len(16)
			cngSynthState.len(16)
			plcLtpCoef.len(5)
			plcPrevLpc.len(16)
			plcPrevGain.len(2)
			pitchL.len(4)
			gains.len(4)
			predCoef0.len(16)
			predCoef1.len(16)
			ltpCoef.len(20)
			pulses.len(336)
			sLtp.len(480)
			sLtpQ15.len(960)
			resQ14.len(80)
			sLpcQ14.len(80 + 16)
			nlsf.len(16)
			nlsf0.len(16)
			ecIx.len(16)
			predQ8.len(16)
			resQ10.len(16)
			wTmp.len(16)
			sumPulses.len(21)
			nLshifts.len(21)
			pulses1.len(8)
			pulses2.len(4)
			pulses3.len(2)
			signIcdf.len(2)
			excBuf.len(160)
			aQ12.len(16)
			cngSig.len(320 + 16)
			frame.len(320)
			reset()
		}

		// Forgets everything decoded, as silk_init_decoder.
		def reset() {
			prevGain = 65536
			for let i = 0; i < 320; i++ {
				exc[i] = 0
				cngExcBuf[i] = 0
			}
			for let i = 0; i < 16; i++ {
				sLpc[i] = 0
				prevNlsf[i] = 0
				cngSynthState[i] = 0
				plcPrevLpc[i] = 0
			}
			for let i = 0; i < 480; i++ {
				outBuf[i] = 0
			}
			lagPrev = 0
			lastGainIndex = 0
			fsKHz = 0
			fsApiHz = 0
			nbSubfr = 0
			frameLength = 0
			subfrLength = 0
			ltpMemLength = 0
			lpcOrder = 0
			firstFrameAfterReset = true
			framesDecoded = 0
			framesPerPacket = 0
			ecPrevSignalType = 0
			ecPrevLagIndex = 0
			lbrrFlag = 0
			for let i = 0; i < 3; i++ {
				vadFlags[i] = 0
				lbrrFlags[i] = 0
			}
			lossCnt = 0
			prevSignalType = 0
			cngFsKHz = 0
			plcFsKHz = 0
			plcLastFrameLost = false
			plcRandSeed = 0
			plcRandScale = 0
			plcConcEnergy = 0
			plcConcShift = 0
			plcPrevLtpScale = 0
			for let i = 0; i < 5; i++ {
				plcLtpCoef[i] = 0
			}
			resampler.init(16000)
			fsApiHz = 0
			cngReset()
			plcReset()
		}

		// Sets the internal rate (kHz) and the subframes per frame, as
		// silk_decoder_set_fs.
		def setFs(fs int, subframes int) {
			nbSubfr = subframes
			subfrLength = 5 * fs
			let length = nbSubfr * subfrLength
			if fsKHz != fs || fsApiHz != 48000 {
				resampler.init(fs * 1000)
				fsApiHz = 48000
			}
			if fsKHz != fs || length != frameLength {
				if fs == 8 {
					contourIcdf = nbSubfr == 4 ?? (silkPitchContourNbIcdf, silkPitchContour10msNbIcdf)
				} else {
					contourIcdf = nbSubfr == 4 ?? (silkPitchContourIcdf, silkPitchContour10msIcdf)
				}
				if fsKHz != fs {
					ltpMemLength = 20 * fs
					if fs := 8 || 12 {
						lpcOrder = 10
						cb = cbNarrow
					} else {
						lpcOrder = 16
						cb = cbWide
					}
					lagLowBitsIcdf = fs == 16 ?? (silkUniform8Icdf, fs == 12 ?? (silkUniform6Icdf, silkUniform4Icdf))
					firstFrameAfterReset = true
					lagPrev = 100
					lastGainIndex = 10
					prevSignalType = silkNoVoice
					for let i = 0; i < 480; i++ {
						outBuf[i] = 0
					}
					for let i = 0; i < 16; i++ {
						sLpc[i] = 0
					}
				}
				fsKHz = fs
				frameLength = length
			}
		}

		// Decodes the side information of frame `index` of the packet
		// (RFC 6716 section 4.2.7).
		def decodeIndices(dec OpusRangeDecoder, index int, lbrr bool, condCoding int) {
			let ix = 0
			if lbrr || vadFlags[index] != 0 {
				ix = dec.icdf(silkTypeOffsetVadIcdf, 8) + 2
			} else {
				ix = dec.icdf(silkTypeOffsetNoVadIcdf, 8)
			}
			signalType = ix >> 1
			quantOffsetType = ix & 1
			if condCoding == silkCodeConditionally {
				gainsIndices[0] = dec.icdf(silkDeltaGainIcdf, 8)
			} else {
				gainsIndices[0] = dec.icdf(silkGainIcdf, signalType * 8, 8) << 3
				gainsIndices[0] += dec.icdf(silkUniform8Icdf, 8)
			}
			for let i = 1; i < nbSubfr; i++ {
				gainsIndices[i] = dec.icdf(silkDeltaGainIcdf, 8)
			}
			nlsfIndices[0] = dec.icdf(cb.cb1Icdf, (signalType >> 1) * cb.vectors, 8)
			cb.unpack(ecIx, predQ8, nlsfIndices[0])
			for let i = 0; i < cb.order; i++ {
				let v = dec.icdf(cb.residualIcdf, ecIx[i], 8)
				if v == 0 {
					v -= dec.icdf(silkNlsfExtIcdf, 8)
				} else if v == 8 {
					v += dec.icdf(silkNlsfExtIcdf, 8)
				}
				nlsfIndices[i + 1] = v - 4
			}
			if nbSubfr == 4 {
				nlsfInterpCoef = dec.icdf(silkNlsfInterpIcdf, 8)
			} else {
				nlsfInterpCoef = 4
			}
			if signalType == silkVoiced {
				let absolute = true
				if condCoding == silkCodeConditionally && ecPrevSignalType == silkVoiced {
					let delta = dec.icdf(silkPitchDeltaIcdf, 8)
					if delta > 0 {
						lagIndex = ecPrevLagIndex + delta - 9
						absolute = false
					}
				}
				if absolute {
					lagIndex = dec.icdf(silkPitchLagIcdf, 8) * (fsKHz >> 1)
					lagIndex += dec.icdf(lagLowBitsIcdf, 8)
				}
				ecPrevLagIndex = lagIndex
				contourIndex = dec.icdf(contourIcdf, 8)
				perIndex = dec.icdf(silkLtpPerIndexIcdf, 8)
				let table = perIndex == 0 ?? (silkLtpGainIcdf0, perIndex == 1 ?? (silkLtpGainIcdf1, silkLtpGainIcdf2))
				for let k = 0; k < nbSubfr; k++ {
					ltpIndex[k] = dec.icdf(table, 8)
				}
				if condCoding == silkCodeIndependently {
					ltpScaleIndex = dec.icdf(silkLtpScaleIcdf, 8)
				} else {
					ltpScaleIndex = 0
				}
			}
			ecPrevSignalType = signalType
			seed = dec.icdf(silkUniform4Icdf, 8)
		}

		// Splits `p` pulses between two halves with the given shell table.
		def shellSplit(dec OpusRangeDecoder, out int[], at int, p int, table int[]) {
			if p > 0 {
				out[at] = dec.icdf(table, silkShellOffsets[p], 8)
				out[at + 1] = p - out[at]
			} else {
				out[at] = 0
				out[at + 1] = 0
			}
		}

		// Decodes the 16 pulse counts of a shell block of `p4` pulses into
		// pulses[at..].
		def shellDecode(dec OpusRangeDecoder, at int, p4 int) {
			shellSplit(dec, pulses3, 0, p4, silkShellTable3)
			shellSplit(dec, pulses2, 0, pulses3[0], silkShellTable2)
			shellSplit(dec, pulses1, 0, pulses2[0], silkShellTable1)
			shellSplit(dec, pulses, at, pulses1[0], silkShellTable0)
			shellSplit(dec, pulses, at + 2, pulses1[1], silkShellTable0)
			shellSplit(dec, pulses1, 2, pulses2[1], silkShellTable1)
			shellSplit(dec, pulses, at + 4, pulses1[2], silkShellTable0)
			shellSplit(dec, pulses, at + 6, pulses1[3], silkShellTable0)
			shellSplit(dec, pulses2, 2, pulses3[1], silkShellTable2)
			shellSplit(dec, pulses1, 4, pulses2[2], silkShellTable1)
			shellSplit(dec, pulses, at + 8, pulses1[4], silkShellTable0)
			shellSplit(dec, pulses, at + 10, pulses1[5], silkShellTable0)
			shellSplit(dec, pulses1, 6, pulses2[3], silkShellTable1)
			shellSplit(dec, pulses, at + 12, pulses1[6], silkShellTable0)
			shellSplit(dec, pulses, at + 14, pulses1[7], silkShellTable0)
		}

		// Decodes the excitation pulses of a frame (RFC 6716 section
		// 4.2.7.8).
		def decodePulses(dec OpusRangeDecoder) {
			let rateLevel = dec.icdf(silkRateLevelsIcdf, (signalType >> 1) * 9, 8)
			let iter = frameLength >> 4
			iter++ when iter * 16 < frameLength
			for let i = 0; i < iter; i++ {
				nLshifts[i] = 0
				sumPulses[i] = dec.icdf(silkPulsesPerBlockIcdf, rateLevel * 18, 8)
				for sumPulses[i] == 17 {
					nLshifts[i]++
					sumPulses[i] = dec.icdf(silkPulsesPerBlockIcdf, 9 * 18 + (nLshifts[i] == 10 ?? (1, 0)), 8)
				}
			}
			for let i = 0; i < iter; i++ {
				if sumPulses[i] > 0 {
					shellDecode(dec, i * 16, sumPulses[i])
				} else {
					for let k = 0; k < 16; k++ {
						pulses[i * 16 + k] = 0
					}
				}
			}
			for let i = 0; i < iter; i++ {
				if nLshifts[i] > 0 {
					let nls = nLshifts[i]
					for let k = 0; k < 16; k++ {
						let q = pulses[i * 16 + k]
						for let j = 0; j < nls; j++ {
							q = (q << 1) + dec.icdf(silkLsbIcdf, 8)
						}
						pulses[i * 16 + k] = q
					}
					sumPulses[i] |= nls << 5
				}
			}
			let base = 7 * (quantOffsetType + (signalType << 1))
			signIcdf[1] = 0
			let blocks = (frameLength + 8) >> 4
			for let i = 0; i < blocks; i++ {
				let p = sumPulses[i]
				if p > 0 {
					signIcdf[0] = silkSignIcdf[base + (p & 0x1F).min(6)]
					for let j = 0; j < 16; j++ {
						let at = i * 16 + j
						pulses[at] *= (dec.icdf(signIcdf, 8) << 1) - 1 when pulses[at] > 0
					}
				}
			}
		}

		// Turns the indices into filter parameters (RFC 6716 section
		// 4.2.7.4 to 4.2.7.6).
		def decodeParameters(condCoding int) {
			for let k = 0; k < nbSubfr; k++ {
				if k == 0 && condCoding != silkCodeConditionally {
					lastGainIndex = gainsIndices[k].max(lastGainIndex - 16)
				} else {
					let t = gainsIndices[k] - 4
					let threshold = 2 * 36 - 64 + lastGainIndex
					if t > threshold {
						lastGainIndex += (t << 1) - threshold
					} else {
						lastGainIndex += t
					}
				}
				lastGainIndex = lastGainIndex.max(0).min(63)
				gains[k] = silkLog2lin((silkSmulwb(1907825, lastGainIndex) + 2090).min(3967))
			}
			cb.decode(nlsf, nlsfIndices, ecIx, predQ8, resQ10, wTmp)
			silkNlsf2a(predCoef1, nlsf, lpcOrder)
			nlsfInterpCoef = 4 when firstFrameAfterReset
			if nlsfInterpCoef < 4 {
				for let i = 0; i < lpcOrder; i++ {
					nlsf0[i] = prevNlsf[i] + ((nlsfInterpCoef * (nlsf[i] - prevNlsf[i])) >> 2)
				}
				silkNlsf2a(predCoef0, nlsf0, lpcOrder)
			} else {
				for let i = 0; i < lpcOrder; i++ {
					predCoef0[i] = predCoef1[i]
				}
			}
			for let i = 0; i < lpcOrder; i++ {
				prevNlsf[i] = nlsf[i]
			}
			if lossCnt != 0 {
				silkBwexpander(predCoef0, lpcOrder, 63570)
				silkBwexpander(predCoef1, lpcOrder, 63570)
			}
			if signalType == silkVoiced {
				decodePitch()
				let vq = perIndex == 0 ?? (silkLtpVq0, perIndex == 1 ?? (silkLtpVq1, silkLtpVq2))
				for let k = 0; k < nbSubfr; k++ {
					let ix = ltpIndex[k]
					for let i = 0; i < 5; i++ {
						ltpCoef[k * 5 + i] = vq[ix * 5 + i] << 7
					}
				}
				ltpScale = silkLtpScalesQ14[ltpScaleIndex]
			} else {
				for let k = 0; k < nbSubfr; k++ {
					pitchL[k] = 0
				}
				for let i = 0; i < 5 * nbSubfr; i++ {
					ltpCoef[i] = 0
				}
				perIndex = 0
				ltpScale = 0
			}
		}

		// The pitch lag of each subframe from the lag index and contour.
		def decodePitch() {
			let table = silkLagsStage3
			let size = 34
			if fsKHz == 8 {
				if nbSubfr == 4 {
					table = silkLagsStage2
					size = 11
				} else {
					table = silkLagsStage2of10ms
					size = 3
				}
			} else if nbSubfr != 4 {
				table = silkLagsStage3of10ms
				size = 12
			}
			let minLag = 2 * fsKHz
			let maxLag = 18 * fsKHz
			let lag = minLag + lagIndex
			for let k = 0; k < nbSubfr; k++ {
				pitchL[k] = (lag + table[k * size + contourIndex]).max(minLag).min(maxLag)
			}
		}

		// The inverse noise shaping: excitation through the long-term and
		// short-term predictors into `xq` from `at` (RFC 6716 section
		// 4.2.7.9).
		def decodeCore(xq int[], at int) {
			let offset = silkQuantOffsetsQ10[((signalType >> 1) << 1) + quantOffsetType]
			let interpolation = nlsfInterpCoef < 4
			let randSeed = seed
			for let i = 0; i < frameLength; i++ {
				randSeed = silkRand(randSeed)
				let e = pulses[i] << 14
				if e > 0 {
					e -= 80 << 4
				} else if e < 0 {
					e += 80 << 4
				}
				e += offset << 4
				e = -e when randSeed < 0
				exc[i] = e
				randSeed = silkInt32(randSeed + pulses[i])
			}
			for let i = 0; i < 16; i++ {
				sLpcQ14[i] = sLpc[i]
			}
			let pexc = 0
			let pxq = at
			let bufIdx = ltpMemLength
			let lag = 0
			for let k = 0; k < nbSubfr; k++ {
				let a = (k >> 1) == 0 ?? (predCoef0, predCoef1)
				let bAt = k * 5
				let kind = signalType
				let gainQ10 = gains[k] >> 6
				let invGain = silkInverse32VarQ(gains[k], 47)
				let gainAdj = 1 << 16
				if gains[k] != prevGain {
					gainAdj = silkDiv32VarQ(prevGain, gains[k], 16)
					for let i = 0; i < 16; i++ {
						sLpcQ14[i] = silkSmulww(gainAdj, sLpcQ14[i])
					}
				}
				prevGain = gains[k]
				if lossCnt != 0 && prevSignalType == silkVoiced && signalType != silkVoiced && k < 2 {
					for let i = 0; i < 5; i++ {
						ltpCoef[bAt + i] = 0
					}
					ltpCoef[bAt + 2] = 4096
					kind = silkVoiced
					pitchL[k] = lagPrev
				}
				if kind == silkVoiced {
					lag = pitchL[k]
					if k == 0 || (k == 2 && interpolation) {
						let startIdx = ltpMemLength - lag - lpcOrder - 2
						if k == 2 {
							for let i = 0; i < 2 * subfrLength; i++ {
								outBuf[ltpMemLength + i] = xq[at + i]
							}
						}
						silkLpcAnalysisFilter(sLtp, startIdx, outBuf, startIdx + k * subfrLength, a, ltpMemLength - startIdx, lpcOrder)
						invGain = silkSmulwb(invGain, ltpScale) << 2 when k == 0
						for let i = 0; i < lag + 2; i++ {
							sLtpQ15[bufIdx - i - 1] = silkSmulwb(invGain, sLtp[ltpMemLength - i - 1])
						}
					} else if gainAdj != 1 << 16 {
						for let i = 0; i < lag + 2; i++ {
							sLtpQ15[bufIdx - i - 1] = silkSmulww(gainAdj, sLtpQ15[bufIdx - i - 1])
						}
					}
				}
				let res = resQ14
				let resAt = 0
				if kind == silkVoiced {
					let p = bufIdx - lag + 2
					for let i = 0; i < subfrLength; i++ {
						let pred = 2
						pred = silkSmlawb(pred, sLtpQ15[p], ltpCoef[bAt])
						pred = silkSmlawb(pred, sLtpQ15[p - 1], ltpCoef[bAt + 1])
						pred = silkSmlawb(pred, sLtpQ15[p - 2], ltpCoef[bAt + 2])
						pred = silkSmlawb(pred, sLtpQ15[p - 3], ltpCoef[bAt + 3])
						pred = silkSmlawb(pred, sLtpQ15[p - 4], ltpCoef[bAt + 4])
						p++
						resQ14[i] = exc[pexc + i] + (pred << 1)
						sLtpQ15[bufIdx] = resQ14[i] << 1
						bufIdx++
					}
				} else {
					res = exc
					resAt = pexc
				}
				for let i = 0; i < subfrLength; i++ {
					let pred = lpcOrder >> 1
					let s = 16 + i
					for let j = 0; j < lpcOrder; j++ {
						pred = silkSmlawb(pred, sLpcQ14[s - 1 - j], a[j])
					}
					sLpcQ14[s] = res[resAt + i] + (pred << 4)
					xq[pxq + i] = silkSat16(silkRshiftRound(silkSmulww(sLpcQ14[s], gainQ10), 8))
				}
				for let i = 0; i < 16; i++ {
					sLpcQ14[i] = sLpcQ14[subfrLength + i]
				}
				pexc += subfrLength
				pxq += subfrLength
			}
			for let i = 0; i < 16; i++ {
				sLpc[i] = sLpcQ14[i]
			}
		}

		// Resets the concealment state.
		def plcReset() {
			plcPitchL = frameLength << 7
			plcPrevGain[0] = 65536
			plcPrevGain[1] = 65536
			plcSubfrLength = 20
			plcNbSubfr = 2
		}

		// Updates the concealment state from a good frame, or conceals a lost
		// one into `xq` from `at`.
		def plc(xq int[], at int, lost bool) {
			if fsKHz != plcFsKHz {
				plcReset()
				plcFsKHz = fsKHz
			}
			if lost {
				plcConceal(xq, at)
				lossCnt++
			} else {
				plcUpdate()
			}
		}

		// Keeps the pitch, LTP and LPC parameters of a good frame for
		// concealment.
		def plcUpdate() {
			prevSignalType = signalType
			let ltpGain = 0
			if signalType == silkVoiced {
				for let j = 0; j * subfrLength < pitchL[nbSubfr - 1]; j++ {
					break when j == nbSubfr
					let t = 0
					for let i = 0; i < 5; i++ {
						t += ltpCoef[(nbSubfr - 1 - j) * 5 + i]
					}
					if t > ltpGain {
						ltpGain = t
						for let i = 0; i < 5; i++ {
							plcLtpCoef[i] = ltpCoef[(nbSubfr - 1 - j) * 5 + i]
						}
						plcPitchL = pitchL[nbSubfr - 1 - j] << 8
					}
				}
				for let i = 0; i < 5; i++ {
					plcLtpCoef[i] = 0
				}
				plcLtpCoef[2] = ltpGain
				if ltpGain < 11469 {
					let scale = (11469 << 10) / ltpGain.max(1)
					for let i = 0; i < 5; i++ {
						plcLtpCoef[i] = (silkSmulbb(plcLtpCoef[i], scale)) >> 10
					}
				} else if ltpGain > 15565 {
					let scale = (15565 << 14) / ltpGain.max(1)
					for let i = 0; i < 5; i++ {
						plcLtpCoef[i] = (silkSmulbb(plcLtpCoef[i], scale)) >> 14
					}
				}
			} else {
				plcPitchL = silkSmulbb(fsKHz, 18) << 8
				for let i = 0; i < 5; i++ {
					plcLtpCoef[i] = 0
				}
			}
			for let i = 0; i < lpcOrder; i++ {
				plcPrevLpc[i] = predCoef1[i]
			}
			plcPrevLtpScale = ltpScale
			plcPrevGain[0] = gains[nbSubfr - 2]
			plcPrevGain[1] = gains[nbSubfr - 1]
			plcSubfrLength = subfrLength
			plcNbSubfr = nbSubfr
		}

		// Synthesises a lost frame from the last excitation, pitch and LPC
		// filter, fading out.
		def plcConceal(xq int[], at int) {
			let prevGain0 = plcPrevGain[0] >> 6
			let prevGain1 = plcPrevGain[1] >> 6
			if firstFrameAfterReset {
				for let i = 0; i < 16; i++ {
					plcPrevLpc[i] = 0
				}
			}
			for let k = 0; k < 2; k++ {
				let g = k == 0 ?? (prevGain0, prevGain1)
				for let i = 0; i < plcSubfrLength; i++ {
					excBuf[k * plcSubfrLength + i] = silkSat16(silkSmulww(exc[i + (k + plcNbSubfr - 2) * plcSubfrLength], g) >> 8)
				}
			}
			let (energy1, shift1) = silkSumSqrShift(excBuf, 0, plcSubfrLength)
			let (energy2, shift2) = silkSumSqrShift(excBuf, plcSubfrLength, plcSubfrLength)
			let randAt = 0
			if (energy1 >> shift2) < (energy2 >> shift1) {
				randAt = ((plcNbSubfr - 1) * plcSubfrLength - 128).max(0)
			} else {
				randAt = (plcNbSubfr * plcSubfrLength - 128).max(0)
			}
			let randScale = plcRandScale
			let att = lossCnt.min(1)
			let harmGain = att == 0 ?? (32440, 31130)
			let randGain = 0
			if prevSignalType == silkVoiced {
				randGain = att == 0 ?? (31130, 26214)
			} else {
				randGain = att == 0 ?? (32440, 29491)
			}
			silkBwexpander(plcPrevLpc, lpcOrder, 64881)
			for let i = 0; i < lpcOrder; i++ {
				aQ12[i] = plcPrevLpc[i]
			}
			if lossCnt == 0 {
				randScale = 1 << 14
				if prevSignalType == silkVoiced {
					for let i = 0; i < 5; i++ {
						randScale -= plcLtpCoef[i]
					}
					randScale = randScale.max(3277)
					randScale = silkInt16((silkSmulbb(randScale, plcPrevLtpScale)) >> 14)
				} else {
					let invGain = silkLpcInversePredGain(plcPrevLpc, lpcOrder)
					let down = ((1 << 30) >> 3).min(invGain)
					down = ((1 << 30) >> 8).max(down)
					down = down << 3
					randGain = (silkSmulwb(down, randGain)) >> 14
				}
			}
			let randSeed = plcRandSeed
			let lag = silkRshiftRound(plcPitchL, 8)
			let bufIdx = ltpMemLength
			let idx = ltpMemLength - lag - lpcOrder - 2
			silkLpcAnalysisFilter(sLtp, idx, outBuf, idx, aQ12, ltpMemLength - idx, lpcOrder)
			let invGain = silkInverse32VarQ(plcPrevGain[1], 46)
			invGain = invGain.min(0x7FFFFFFF >> 1)
			for let i = idx + lpcOrder; i < ltpMemLength; i++ {
				sLtpQ15[i] = silkSmulwb(invGain, sLtp[i])
			}
			for let k = 0; k < nbSubfr; k++ {
				let p = bufIdx - lag + 2
				for let i = 0; i < subfrLength; i++ {
					let pred = 2
					pred = silkSmlawb(pred, sLtpQ15[p], plcLtpCoef[0])
					pred = silkSmlawb(pred, sLtpQ15[p - 1], plcLtpCoef[1])
					pred = silkSmlawb(pred, sLtpQ15[p - 2], plcLtpCoef[2])
					pred = silkSmlawb(pred, sLtpQ15[p - 3], plcLtpCoef[3])
					pred = silkSmlawb(pred, sLtpQ15[p - 4], plcLtpCoef[4])
					p++
					randSeed = silkRand(randSeed)
					let ri = (randSeed >> 25) & 127
					sLtpQ15[bufIdx] = silkInt32(silkSmlawb(pred, exc[randAt + ri], randScale) << 2)
					bufIdx++
				}
				for let j = 0; j < 5; j++ {
					plcLtpCoef[j] = (silkSmulbb(harmGain, plcLtpCoef[j])) >> 15
				}
				randScale = (silkSmulbb(randScale, randGain)) >> 15
				plcPitchL = silkSmlawb(plcPitchL, plcPitchL, 655)
				plcPitchL = plcPitchL.min(silkSmulbb(18, fsKHz) << 8)
				lag = silkRshiftRound(plcPitchL, 8)
			}
			let s0 = ltpMemLength - 16
			for let i = 0; i < 16; i++ {
				sLtpQ15[s0 + i] = sLpc[i]
			}
			for let i = 0; i < frameLength; i++ {
				let pred = lpcOrder >> 1
				let s = s0 + 16 + i
				for let j = 0; j < lpcOrder; j++ {
					pred = silkSmlawb(pred, sLtpQ15[s - 1 - j], aQ12[j])
				}
				sLtpQ15[s] = sLtpQ15[s] + (pred << 4)
				xq[at + i] = silkSat16(silkRshiftRound(silkSmulww(sLtpQ15[s], prevGain1), 8))
			}
			for let i = 0; i < 16; i++ {
				sLpc[i] = sLtpQ15[s0 + frameLength + i]
			}
			plcRandSeed = randSeed
			plcRandScale = randScale
			for let i = 0; i < 4; i++ {
				pitchL[i] = lag
			}
		}

		// Fades a good frame in after concealed ones, matching their energy.
		def glueFrames(xq int[], at int, length int) {
			if lossCnt != 0 {
				let (e, s) = silkSumSqrShift(xq, at, length)
				plcConcEnergy = e
				plcConcShift = s
				plcLastFrameLost = true
				return
			}
			if plcLastFrameLost {
				let (e, s) = silkSumSqrShift(xq, at, length)
				let energy = e
				if s > plcConcShift {
					plcConcEnergy = plcConcEnergy >> (s - plcConcShift)
				} else if s < plcConcShift {
					energy = energy >> (plcConcShift - s)
				}
				if energy > plcConcEnergy {
					let lz = silkClz32(plcConcEnergy) - 1
					plcConcEnergy = silkInt32(plcConcEnergy << lz)
					energy = energy >> (24 - lz).max(0)
					let frac = plcConcEnergy / energy.max(1)
					let gain = silkSqrtApprox(frac) << 4
					let slope = ((1 << 16) - gain) / length
					slope = slope << 2
					for let i = 0; i < length; i++ {
						xq[at + i] = silkInt16(silkSmulwb(gain, xq[at + i]))
						gain += slope
						break when gain > 1 << 16
					}
				}
			}
			plcLastFrameLost = false
		}

		// Resets the comfort noise state.
		def cngReset() {
			let step = 32767 / (lpcOrder + 1)
			let acc = 0
			for let i = 0; i < lpcOrder; i++ {
				acc += step
				cngSmthNlsf[i] = acc
			}
			cngSmthGain = 0
			cngRandSeed = 3176576
		}

		// Tracks the background noise in good frames and adds comfort noise
		// to concealed ones.
		def cng(xq int[], at int, length int) {
			if fsKHz != cngFsKHz {
				cngReset()
				cngFsKHz = fsKHz
			}
			if lossCnt == 0 && prevSignalType == silkNoVoice {
				for let i = 0; i < lpcOrder; i++ {
					cngSmthNlsf[i] += silkSmulwb(prevNlsf[i] - cngSmthNlsf[i], 16348)
				}
				let maxGain = 0
				let subfr = 0
				for let i = 0; i < nbSubfr; i++ {
					if gains[i] > maxGain {
						maxGain = gains[i]
						subfr = i
					}
				}
				for let i = (nbSubfr - 1) * subfrLength - 1; i >= 0; i-- {
					cngExcBuf[subfrLength + i] = cngExcBuf[i]
				}
				for let i = 0; i < subfrLength; i++ {
					cngExcBuf[i] = exc[subfr * subfrLength + i]
				}
				for let i = 0; i < nbSubfr; i++ {
					cngSmthGain += silkSmulwb(gains[i] - cngSmthGain, 4634)
				}
			}
			if lossCnt != 0 {
				let mask = 255
				for mask > length {
					mask >>= 1
				}
				let s = cngRandSeed
				for let i = 0; i < length; i++ {
					s = silkRand(s)
					let idx = (s >> 24) & mask
					cngSig[16 + i] = silkSat16(silkSmulww(cngExcBuf[idx], cngSmthGain >> 4))
				}
				cngRandSeed = s
				silkNlsf2a(aQ12, cngSmthNlsf, lpcOrder)
				for let i = 0; i < 16; i++ {
					cngSig[i] = cngSynthState[i]
				}
				for let i = 0; i < length; i++ {
					let sum = lpcOrder >> 1
					for let j = 0; j < lpcOrder; j++ {
						sum = silkSmlawb(sum, cngSig[16 + i - 1 - j], aQ12[j])
					}
					cngSig[16 + i] = cngSig[16 + i] + (sum << 4)
					xq[at + i] = silkSat16(xq[at + i] + silkRshiftRound(sum, 6))
				}
				for let i = 0; i < 16; i++ {
					cngSynthState[i] = cngSig[length + i]
				}
			} else {
				for let i = 0; i < lpcOrder; i++ {
					cngSynthState[i] = 0
				}
			}
		}

		// Decodes (or conceals, when `lost`) one frame into `xq` from `at` and
		// returns its length (RFC 6716 section 4.2.7).
		def decodeFrame(dec OpusRangeDecoder, xq int[], at int, lost bool, condCoding int) int {
			ltpScale = 0
			if !lost {
				decodeIndices(dec, framesDecoded, false, condCoding)
				decodePulses(dec)
				decodeParameters(condCoding)
				decodeCore(xq, at)
				plc(xq, at, false)
				lossCnt = 0
				prevSignalType = signalType
				firstFrameAfterReset = false
			} else {
				plc(xq, at, true)
			}
			let l = frameLength
			let mv = ltpMemLength - frameLength
			for let i = 0; i < mv; i++ {
				outBuf[i] = outBuf[i + frameLength]
			}
			for let i = 0; i < frameLength; i++ {
				outBuf[mv + i] = xq[at + i]
			}
			glueFrames(xq, at, l)
			cng(xq, at, l)
			lagPrev = pitchL[nbSubfr - 1]
			return l
		}

		// Reads past a redundant (LBRR) frame, which plain decoding ignores.
		def skipFrame(dec OpusRangeDecoder, index int, condCoding int) {
			decodeIndices(dec, index, true, condCoding)
			decodePulses(dec)
		}
	}

	// Decodes the SILK layer of Opus frames (RFC 6716 section 4.2), mono or
	// stereo, to 16-bit samples at 48 kHz.
	type SilkDecoder {
		// Output channels.
		channels       int
		ch             SilkChannel[]
		predPrev       int[]
		sMid           int[]
		sSide          int[]
		channelsApi    int
		channelsCoded  int
		prevMiddleOnly bool
		tmp0           int[]
		tmp1           int[]
		resampled      int[]
		msPred         int[]

		// A decoder for `channels` output channels.
		def new(channels int) {
			self.channels = channels
			ch.push(new SilkChannel())
			ch.push(new SilkChannel())
			predPrev.len(2)
			sMid.len(2)
			sSide.len(2)
			tmp0.len(324)
			tmp1.len(324)
			resampled.len(960)
			msPred.len(2)
			reset()
		}

		// Forgets everything decoded.
		def reset() {
			ch[0].reset()
			ch[1].reset()
			for let i = 0; i < 2; i++ {
				predPrev[i] = 0
				sMid[i] = 0
				sSide[i] = 0
			}
			prevMiddleOnly = false
		}

		// Decodes the two mid/side predictors into msPred.
		def decodePred(dec OpusRangeDecoder) {
			let n = dec.icdf(silkStereoPredJointIcdf, 8)
			let ix02 = n / 5
			let ix12 = n - 5 * ix02
			for let k = 0; k < 2; k++ {
				let i0 = dec.icdf(silkUniform3Icdf, 8)
				let i1 = dec.icdf(silkUniform5Icdf, 8)
				let i2 = k == 0 ?? (ix02, ix12)
				let q = i0 + 3 * i2
				let low = silkStereoPredQuantQ13[q]
				let step = silkSmulwb(silkStereoPredQuantQ13[q + 1] - low, 6554)
				msPred[k] = low + silkSmulbb(step, 2 * i1 + 1)
			}
			msPred[0] -= msPred[1]
		}

		// Adds the interpolated prediction to the side channel and turns mid/side
		// into left/right.
		def msToLr(fsKHz int, n int) {
			tmp0[0] = sMid[0]
			tmp0[1] = sMid[1]
			tmp1[0] = sSide[0]
			tmp1[1] = sSide[1]
			sMid[0] = tmp0[n]
			sMid[1] = tmp0[n + 1]
			sSide[0] = tmp1[n]
			sSide[1] = tmp1[n + 1]
			let pred0 = predPrev[0]
			let pred1 = predPrev[1]
			let denom = (1 << 16) / (8 * fsKHz)
			let delta0 = silkRshiftRound(silkSmulbb(msPred[0] - predPrev[0], denom), 16)
			let delta1 = silkRshiftRound(silkSmulbb(msPred[1] - predPrev[1], denom), 16)
			for let i = 0; i < n; i++ {
				if i < 8 * fsKHz {
					pred0 += delta0
					pred1 += delta1
				} else {
					pred0 = msPred[0]
					pred1 = msPred[1]
				}
				let sum = ((tmp0[i] + tmp0[i + 2]) + (tmp0[i + 1] << 1)) << 9
				sum = silkSmlawb(tmp1[i + 1] << 8, sum, pred0)
				sum = silkSmlawb(sum, tmp0[i + 1] << 11, pred1)
				tmp1[i + 1] = silkSat16(silkRshiftRound(sum, 8))
			}
			predPrev[0] = msPred[0]
			predPrev[1] = msPred[1]
			for let i = 0; i < n; i++ {
				let s = tmp0[i + 1] + tmp1[i + 1]
				let d = tmp0[i + 1] - tmp1[i + 1]
				tmp0[i + 1] = silkSat16(s)
				tmp1[i + 1] = silkSat16(d)
			}
		}

		// Decodes (or conceals, when `lost`) one SILK frame of the packet in
		// `dec` into `out` from `at`, interleaved at 48 kHz, and returns its
		// samples per channel. `first` marks the first frame of a packet.
		// Fails when the frame size or rate is not a SILK one.
		def decode(dec OpusRangeDecoder, lost bool, first bool, coded int, internalRate int, payloadMs int, out int[], at int) !int {
			let c0 = ch[0]
			let c1 = ch[1]
			if first {
				for let n = 0; n < coded; n++ {
					ch[n].framesDecoded = 0
				}
			}
			c1.reset() when coded > channelsCoded
			let stereoToMono = coded == 1 && channelsCoded == 2 && internalRate == 1000 * c0.fsKHz
			if c0.framesDecoded == 0 {
				for let n = 0; n < coded; n++ {
					let c = ch[n]
					let frames = 1
					let subframes = 4
					if payloadMs == 10 {
						subframes = 2
					} else if payloadMs == 40 {
						frames = 2
					} else if payloadMs == 60 {
						frames = 3
					} else {
						fail "silk: bad frame size {payloadMs} ms" when payloadMs != 20
					}
					c.framesPerPacket = frames
					let fs = (internalRate >> 10) + 1
					fail "silk: bad internal rate {internalRate}" when fs != 8 && fs != 12 && fs != 16
					c.setFs(fs, subframes)
				}
			}
			if channels == 2 && coded == 2 && (channelsApi == 1 || channelsCoded == 1) {
				predPrev[0] = 0
				predPrev[1] = 0
				sSide[0] = 0
				sSide[1] = 0
				c1.resampler.copyFrom(c0.resampler)
			}
			channelsApi = channels
			channelsCoded = coded
			let middleOnly = false
			if !lost && c0.framesDecoded == 0 {
				for let n = 0; n < coded; n++ {
					let c = ch[n]
					for let i = 0; i < c.framesPerPacket; i++ {
						c.vadFlags[i] = dec.bitLogp(1) ?? (1, 0)
					}
					c.lbrrFlag = dec.bitLogp(1) ?? (1, 0)
				}
				for let n = 0; n < coded; n++ {
					let c = ch[n]
					for let i = 0; i < 3; i++ {
						c.lbrrFlags[i] = 0
					}
					if c.lbrrFlag != 0 {
						if c.framesPerPacket == 1 {
							c.lbrrFlags[0] = 1
						} else {
							let table = c.framesPerPacket == 2 ?? (silkLbrrFlags2Icdf, silkLbrrFlags3Icdf)
							let sym = dec.icdf(table, 8) + 1
							for let i = 0; i < c.framesPerPacket; i++ {
								c.lbrrFlags[i] = (sym >> i) & 1
							}
						}
					}
				}
				for let i = 0; i < c0.framesPerPacket; i++ {
					for let n = 0; n < coded; n++ {
						let c = ch[n]
						if c.lbrrFlags[i] != 0 {
							if coded == 2 && n == 0 {
								decodePred(dec)
								middleOnly = dec.icdf(silkStereoMidOnlyIcdf, 8) == 1 when c1.lbrrFlags[i] == 0
							}
							let cond = i > 0 && c.lbrrFlags[i - 1] != 0 ?? (silkCodeConditionally, silkCodeIndependently)
							c.skipFrame(dec, i, cond)
						}
					}
				}
			}
			if coded == 2 {
				if !lost {
					decodePred(dec)
					if c1.vadFlags[c0.framesDecoded] == 0 {
						middleOnly = dec.icdf(silkStereoMidOnlyIcdf, 8) == 1
					} else {
						middleOnly = false
					}
				} else {
					msPred[0] = predPrev[0]
					msPred[1] = predPrev[1]
				}
			}
			if coded == 2 && !middleOnly && prevMiddleOnly {
				for let i = 0; i < 480; i++ {
					c1.outBuf[i] = 0
				}
				for let i = 0; i < 16; i++ {
					c1.sLpc[i] = 0
				}
				c1.lagPrev = 100
				c1.lastGainIndex = 10
				c1.prevSignalType = silkNoVoice
				c1.firstFrameAfterReset = true
			}
			let hasSide = lost ?? (!prevMiddleOnly,!middleOnly)
			let nOut = 0
			for let n = 0; n < coded; n++ {
				let buf = n == 0 ?? (tmp0, tmp1)
				if n == 0 || hasSide {
					let frameIndex = c0.framesDecoded - n
					let cond = silkCodeConditionally
					if frameIndex <= 0 {
						cond = silkCodeIndependently
					} else if n > 0 && prevMiddleOnly {
						cond = silkCodeIndependentlyNoLtpScaling
					}
					nOut = ch[n].decodeFrame(dec, buf, 2, lost, cond)
				} else {
					for let i = 0; i < nOut; i++ {
						buf[2 + i] = 0
					}
				}
				ch[n].framesDecoded++
			}
			if channels == 2 && coded == 2 {
				msToLr(c0.fsKHz, nOut)
			} else {
				tmp0[0] = sMid[0]
				tmp0[1] = sMid[1]
				sMid[0] = tmp0[nOut]
				sMid[1] = tmp0[nOut + 1]
			}
			let samples = nOut * 48 / c0.fsKHz
			for let n = 0; n < channels.min(coded); n++ {
				let src = n == 0 ?? (tmp0, tmp1)
				ch[n].resampler.process(resampled, 0, src, 1, nOut)
				for let i = 0; i < samples; i++ {
					out[at + n + channels * i] = resampled[i]
				}
			}
			if channels == 2 && coded == 1 {
				if stereoToMono {
					c1.resampler.process(resampled, 0, tmp0, 1, nOut)
					for let i = 0; i < samples; i++ {
						out[at + 1 + 2 * i] = resampled[i]
					}
				} else {
					for let i = 0; i < samples; i++ {
						out[at + 1 + 2 * i] = out[at + 2 * i]
					}
				}
			}
			if lost {
				for let n = 0; n < channelsCoded; n++ {
					ch[n].lastGainIndex = 10
				}
			} else {
				prevMiddleOnly = middleOnly
			}
			return samples
		}
	}
}
