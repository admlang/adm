internal partial module std.formats.audio.silk {
	use std.formats.audio.opus::*

	// The fixed-point arithmetic of the SILK layer (RFC 6716 section 4.2):
	// every value is an integer in a Q format, and the operations truncate,
	// round and saturate exactly as the reference decoder does so the output
	// is bit-exact.

	// x as a signed 16-bit value, wrapping.
	def silkInt16(x int) int {
		return ((x + 32768) & 0xFFFF) - 32768
	}

	// x as a signed 32-bit value, wrapping.
	def silkInt32(x int) int {
		return ((x + 0x80000000) & 0xFFFFFFFF) - 0x80000000
	}

	// x limited to -32768..32767.
	def silkSat16(x int) int {
		return 32767 when x > 32767
		return -32768 when x < -32768
		return x
	}

	// x limited to the signed 32-bit range.
	def silkSat32(x int) int {
		return 0x7FFFFFFF when x > 0x7FFFFFFF
		return -2147483648 when x < -2147483648
		return x
	}

	// (a * b) >> 16 with a 32-bit and b taken as 16-bit.
	def silkSmulwb(a int, b int) int {
		let b16 = silkInt16(b)
		return (a >> 16) * b16 + (((a & 0xFFFF) * b16) >> 16)
	}

	// a + (b * c) >> 16 with c taken as 16-bit.
	def silkSmlawb(a int, b int, c int) int {
		return a + silkSmulwb(b, c)
	}

	// (a * b) >> 16 with both 32-bit.
	def silkSmulww(a int, b int) int {
		return silkSmulwb(a, b) + a * silkRshiftRound(b, 16)
	}

	// a + (b * c) >> 16 with both 32-bit.
	def silkSmlaww(a int, b int, c int) int {
		return silkSmlawb(a, b, c) + b * silkRshiftRound(c, 16)
	}

	// The product of the low 16 bits of a and b.
	def silkSmulbb(a int, b int) int {
		return silkInt16(a) * silkInt16(b)
	}

	// (a * b) >> 32 with both 32-bit.
	def silkSmmul(a int, b int) int {
		return (a * b) >> 32
	}

	// a >> shift, rounded.
	def silkRshiftRound(a int, shift int) int {
		return (a >> 1) + (a & 1) when shift == 1
		return ((a >> (shift - 1)) + 1) >> 1
	}

	// a << shift, saturated to 32 bits.
	def silkLshiftSat32(a int, shift int) int {
		let lo = -2147483648 >> shift
		let hi = 0x7FFFFFFF >> shift
		let v = a
		v = hi when v > hi
		v = lo when v < lo
		return silkInt32(v << shift)
	}

	// The next state of the SILK noise generator.
	def silkRand(seed int) int {
		return silkInt32(907633515 + seed * 196314165)
	}

	// Leading zeros of x as a 32-bit value; 32 for 0.
	def silkClz32(x int) int {
		let v = x & 0xFFFFFFFF
		return 32 - opusIlog(v)
	}

	// The leading zeros of x and the 7 bits after its leading one.
	def silkClzFrac(x int) (int, int) {
		let lz = silkClz32(x)
		let v = x & 0xFFFFFFFF
		let rot = 24 - lz
		let r = 0
		if rot == 0 {
			r = v
		} else if rot < 0 {
			let m = -rot
			r = ((v << m) | (v >> (32 - m))) & 0xFFFFFFFF
		} else {
			r = ((v << (32 - rot)) | (v >> rot)) & 0xFFFFFFFF
		}
		return (lz, r & 0x7F)
	}

	// An approximate square root, within 2.5% above 120.
	def silkSqrtApprox(x int) int {
		return 0 when x <= 0
		let (lz, frac) = silkClzFrac(x)
		let y = (lz & 1) != 0 ?? (32768, 46214)
		y >>= lz >> 1
		return silkSmlawb(y, y, silkSmulbb(213, frac))
	}

	// About (a << q) / b.
	def silkDiv32VarQ(a int, b int, q int) int {
		let aHead = silkClz32(a.abs()) - 1
		let aNrm = silkInt32(a << aHead)
		let bHead = silkClz32(b.abs()) - 1
		let bNrm = silkInt32(b << bHead)
		let bInv = (0x7FFFFFFF >> 2) / (bNrm >> 16)
		let result = silkSmulwb(aNrm, bInv)
		aNrm = silkInt32(aNrm - silkInt32(silkSmmul(bNrm, result) << 3))
		result = silkSmlawb(result, aNrm, bInv)
		let lshift = 29 + aHead - bHead - q
		return silkLshiftSat32(result, -lshift) when lshift < 0
		return result >> lshift when lshift < 32
		return 0
	}

	// About (1 << q) / b.
	def silkInverse32VarQ(b int, q int) int {
		let bHead = silkClz32(b.abs()) - 1
		let bNrm = silkInt32(b << bHead)
		let bInv = (0x7FFFFFFF >> 2) / (bNrm >> 16)
		let result = bInv << 16
		let err = silkInt32(((1 << 29) - silkSmulwb(bNrm, bInv)) << 3)
		result = silkSmlaww(result, err, bInv)
		let lshift = 61 - bHead - q
		return silkLshiftSat32(result, -lshift) when lshift <= 0
		return result >> lshift when lshift < 32
		return 0
	}

	// 2^(x/128), approximately.
	def silkLog2lin(x int) int {
		return 0 when x < 0
		return 0x7FFFFFFF when x >= 3967
		let out = 1 << (x >> 7)
		let frac = x & 0x7F
		return out + ((out * silkSmlawb(frac, silkSmulbb(frac, 128 - frac), -174)) >> 7) when x < 2048
		return out + (out >> 7) * silkSmlawb(frac, silkSmulbb(frac, 128 - frac), -174)
	}

	// The energy of `n` 16-bit values of x from `at`, and the right shift
	// that makes it fit 31 bits.
	def silkSumSqrShift(x int[], at int, n int) (int, int) {
		let nrg = 0
		let shft = 0
		let len = n - 1
		let i = 0
		for; i < len; i += 2 {
			nrg = silkInt32(nrg + silkSmulbb(x[at + i], x[at + i]))
			nrg = silkInt32(nrg + silkSmulbb(x[at + i + 1], x[at + i + 1]))
			if nrg < 0 {
				nrg = (nrg & 0xFFFFFFFF) >> 2
				shft = 2
				i += 2
				break
			}
		}
		for; i < len; i += 2 {
			let t = silkSmulbb(x[at + i], x[at + i])
			t = silkInt32(t + silkSmulbb(x[at + i + 1], x[at + i + 1]))
			nrg = silkInt32(nrg + ((t & 0xFFFFFFFF) >> shft))
			if nrg < 0 {
				nrg = (nrg & 0xFFFFFFFF) >> 2
				shft += 2
			}
		}
		if i == len {
			let t = silkSmulbb(x[at + i], x[at + i])
			nrg = silkInt32(nrg + ((t & 0xFFFFFFFF) >> shft))
		}
		if (nrg & 0xC0000000) != 0 {
			nrg = (nrg & 0xFFFFFFFF) >> 2
			shft += 2
		}
		return (nrg, shft)
	}

	// Chirps the `d` Q12 coefficients of `ar` (bandwidth expansion).
	def silkBwexpander(ar int[], d int, chirpIn int) {
		let chirp = chirpIn
		let minusOne = chirp - 65536
		for let i = 0; i < d - 1; i++ {
			ar[i] = silkInt16(silkRshiftRound(chirp * ar[i], 16))
			chirp += silkRshiftRound(chirp * minusOne, 16)
		}
		ar[d - 1] = silkInt16(silkRshiftRound(chirp * ar[d - 1], 16))
	}

	// Chirps the `d` 32-bit coefficients of `ar`.
	def silkBwexpander32(ar int[], d int, chirpIn int) {
		let chirp = chirpIn
		let minusOne = chirp - 65536
		for let i = 0; i < d - 1; i++ {
			ar[i] = silkSmulww(chirp, ar[i])
			chirp += silkRshiftRound(chirp * minusOne, 16)
		}
		ar[d - 1] = silkSmulww(chirp, ar[d - 1])
	}

	// The whitening filter of `len` samples of `input` from `inAt` into
	// `out` from `outAt`; the first `d` outputs are zero.
	def silkLpcAnalysisFilter(out int[], outAt int, input int[], inAt int, b int[], len int, d int) {
		for let ix = d; ix < len; ix++ {
			let p = inAt + ix - 1
			let acc = silkSmulbb(input[p], b[0])
			for let j = 1; j < d; j++ {
				acc = silkInt32(acc + silkSmulbb(input[p - j], b[j]))
			}
			acc = silkInt32((input[p + 1] << 12) - acc)
			out[outAt + ix] = silkSat16(silkRshiftRound(acc, 12))
		}
		for let i = 0; i < d; i++ {
			out[outAt + i] = 0
		}
	}

	// The inverse prediction gain of the `order` Q12 coefficients in Q30,
	// 0 when the filter is unstable.
	def silkLpcInversePredGain(a int[], order int) int {
		let t0 int[]
		let t1 int[]
		t0.len(16)
		t1.len(16)
		let dc = 0
		let anew = (order & 1) == 0 ?? (t0, t1)
		for let k = 0; k < order; k++ {
			dc += a[k]
			anew[k] = a[k] << 12
		}
		return 0 when dc >= 4096
		let limit = 16773022
		let invGain = 1 << 30
		for let k = order - 1; k > 0; k-- {
			return 0 when anew[k] > limit || anew[k] < -limit
			let rc = silkInt32(-(anew[k] << 7))
			let mult1 = (1 << 30) - silkSmmul(rc, rc)
			let mult2Q = 32 - silkClz32(mult1.abs())
			let mult2 = silkInverse32VarQ(mult1, mult2Q + 30)
			invGain = silkSmmul(invGain, mult1) << 2
			let aold = anew
			anew = (k & 1) == 0 ?? (t0, t1)
			for let n = 0; n < k; n++ {
				let tmp = silkSat32(aold[n] - silkRshiftRound(aold[k - n - 1] * rc, 31))
				let t64 = silkRshiftRound(tmp * mult2, mult2Q)
				return 0 when t64 > 0x7FFFFFFF || t64 < -2147483648
				anew[n] = t64
			}
		}
		return 0 when anew[0] > limit || anew[0] < -limit
		let rc = silkInt32(-(anew[0] << 7))
		let mult1 = (1 << 30) - silkSmmul(rc, rc)
		invGain = silkSmmul(invGain, mult1) << 2
		return invGain
	}

	// The order in which NLSF2A takes the cosines of 16 NLSFs,
	// chosen for numerical accuracy.
	const silkNlsfOrder16 = int[0, 15, 8, 7, 4, 11, 12, 3, 2, 13, 10, 5, 6, 9, 14, 1]

	// See silkNlsfOrder16, for 10 NLSFs.
	const silkNlsfOrder10 = int[0, 9, 6, 3, 4, 5, 8, 1, 2, 7]

	// One of the two polynomials of the NLSF2A conversion, in Q16, from the
	// cosines at c[at], c[at + 2], ...
	def silkNlsf2aFindPoly(out int[], c int[], at int, dd int) {
		out[0] = 1 << 16
		out[1] = -c[at]
		for let k = 1; k < dd; k++ {
			let f = c[at + 2 * k]
			out[k + 1] = (out[k - 1] << 1) - silkRshiftRound(f * out[k], 16)
			for let n = k; n > 1; n-- {
				out[n] += out[n - 2] - silkRshiftRound(f * out[n - 1], 16)
			}
			out[1] -= f
		}
	}

	// The Q12 prediction filter of `d` coefficients (10 or 16) from the Q15
	// NLSFs, stabilised.
	def silkNlsf2a(a int[], nlsf int[], d int) {
		let cosLsf int[]
		cosLsf.len(16)
		let p int[]
		let q int[]
		p.len(9)
		q.len(9)
		let a32 int[]
		a32.len(16)
		for let k = 0; k < d; k++ {
			let fInt = nlsf[k] >> 8
			let fFrac = nlsf[k] - (fInt << 8)
			let cosVal = silkLsfCosQ12[fInt]
			let delta = silkLsfCosQ12[fInt + 1] - cosVal
			let o = d == 16 ?? (silkNlsfOrder16[k], silkNlsfOrder10[k])
			cosLsf[o] = silkRshiftRound((cosVal << 8) + delta * fFrac, 4)
		}
		let dd = d >> 1
		silkNlsf2aFindPoly(p, cosLsf, 0, dd)
		silkNlsf2aFindPoly(q, cosLsf, 1, dd)
		for let k = 0; k < dd; k++ {
			let pt = p[k + 1] + p[k]
			let qt = q[k + 1] - q[k]
			a32[k] = -qt - pt
			a32[d - k - 1] = qt - pt
		}
		let i = 0
		for; i < 10; i++ {
			let maxabs = 0
			let idx = 0
			for let k = 0; k < d; k++ {
				let absval = a32[k].abs()
				if absval > maxabs {
					maxabs = absval
					idx = k
				}
			}
			maxabs = silkRshiftRound(maxabs, 5)
			break when maxabs <= 32767
			maxabs = maxabs.min(163838)
			let sc = 65470 - ((maxabs - 32767) << 14) / ((maxabs * (idx + 1)) >> 2)
			silkBwexpander32(a32, d, sc)
		}
		if i == 10 {
			for let k = 0; k < d; k++ {
				a[k] = silkSat16(silkRshiftRound(a32[k], 5))
				a32[k] = a[k] << 5
			}
		} else {
			for let k = 0; k < d; k++ {
				a[k] = silkInt16(silkRshiftRound(a32[k], 5))
			}
		}
		for let j = 0; j < 16; j++ {
			break when silkLpcInversePredGain(a, d) >= 107374
			silkBwexpander32(a32, d, 65536 - (2 << j))
			for let k = 0; k < d; k++ {
				a[k] = silkInt16(silkRshiftRound(a32[k], 5))
			}
		}
	}

	// Moves the `l` Q15 NLSFs apart so neighbours keep at least the spacing
	// in `deltaMin` (l + 1 values).
	def silkNlsfStabilize(nlsf int[], deltaMin int[], l int) {
		for let loops = 0; loops < 20; loops++ {
			let minDiff = nlsf[0] - deltaMin[0]
			let ix = 0
			for let i = 1; i <= l - 1; i++ {
				let diff = nlsf[i] - (nlsf[i - 1] + deltaMin[i])
				if diff < minDiff {
					minDiff = diff
					ix = i
				}
			}
			let last = (1 << 15) - (nlsf[l - 1] + deltaMin[l])
			if last < minDiff {
				minDiff = last
				ix = l
			}
			return when minDiff >= 0
			if ix == 0 {
				nlsf[0] = deltaMin[0]
			} else if ix == l {
				nlsf[l - 1] = (1 << 15) - deltaMin[l]
			} else {
				let minCenter = 0
				for let k = 0; k < ix; k++ {
					minCenter += deltaMin[k]
				}
				minCenter += deltaMin[ix] >> 1
				let maxCenter = 1 << 15
				for let k = l; k > ix; k-- {
					maxCenter -= deltaMin[k]
				}
				maxCenter -= deltaMin[ix] >> 1
				let center = silkRshiftRound(nlsf[ix - 1] + nlsf[ix], 1)
				if minCenter > maxCenter {
					center = center > minCenter ?? (minCenter, (center < maxCenter ?? (maxCenter, center)))
				} else {
					center = center > maxCenter ?? (maxCenter, (center < minCenter ?? (minCenter, center)))
				}
				nlsf[ix - 1] = silkInt16(center - (deltaMin[ix] >> 1))
				nlsf[ix] = silkInt16(nlsf[ix - 1] + deltaMin[ix])
			}
		}
		// Fallback after too many rounds: sort, then enforce the spacing.
		for let i = 1; i < l; i++ {
			let v = nlsf[i]
			let j = i - 1
			for j >= 0 && nlsf[j] > v {
				nlsf[j + 1] = nlsf[j]
				j--
			}
			nlsf[j + 1] = v
		}
		nlsf[0] = nlsf[0].max(deltaMin[0])
		for let i = 1; i < l; i++ {
			nlsf[i] = nlsf[i].max(silkSat16(nlsf[i - 1] + deltaMin[i]))
		}
		nlsf[l - 1] = nlsf[l - 1].min((1 << 15) - deltaMin[l])
		for let i = l - 2; i >= 0; i-- {
			nlsf[i] = nlsf[i].min(nlsf[i + 1] - deltaMin[i + 1])
		}
	}
}
