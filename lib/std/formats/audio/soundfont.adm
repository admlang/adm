partial module std.formats.audio {
	use (
		std.io
		std.os
		std.formats.audio.soundfont::*
	)

	// A SoundFont 2 bank (`.sf2`): recorded samples and the presets that play
	// them. Like MIDI it is not an audio stream, so it is read explicitly rather
	// than found by the codec registry; a synthesizer plays what `voices`
	// resolves.
	//
	// ```adm
	// let bank = new SoundFont()
	// try bank.load("/usr/share/soundfonts/FluidR3_GM.sf2")
	// let piano = bank.voices(0, 0, 60, 100)
	// ```
	type SoundFont {
		// The bank's name, from its INFO chunk.
		name                   string
		// The instruments the bank offers.
		presets                SoundFontPreset[]
		// Every sample of the bank, as `smpl` holds them.
		internal samples       int16[]
		// The zones of each preset, in the order of `presets`.
		internal presetParts   SoundFontPart[]
		// The zones of each instrument, by instrument index.
		internal instruments   SoundFontPart[]
		// The sample headers, by sample index.
		internal sampleHeaders SoundFontSample[]

		// Reads a SoundFont 2 file from the reader, replacing what this holds.
		// The name comes from `INAM`, the samples from `smpl` (the extra 8 bits
		// of `sm24` are ignored), the presets and zones from `pdta`. Modulator
		// lists are read past, not kept. Chunks the reader does not know are
		// skipped.
		//
		// Fails when the reader fails or the data is not a SoundFont 2 file:
		// no `RIFF`/`sfbk` header, an `ifil` version other than 2 or none, no
		// `pdta` list, a `pdta` record list that is missing or not a whole
		// number of records, a bag or generator index out of order or past its
		// list, or a chunk running past the end of the file.
		def fromReader(reader io.Reader) !none {
			let input = new SoundFontInput(reader)
			let head = try input.take(12)
			fail "soundfont: not a RIFF file" when string(head[0:4]) != "RIFF"
			fail "soundfont: RIFF form is not sfbk" when string(head[8:12]) != "sfbk"
			let left = soundFontU32(head, 4) - 4
			let bankName = ""
			let version = -1
			let data = int16[]
			let pdta byte[]
			let havePdta = false
			for left >= 8 {
				let chunk = try input.take(8)
				let id = string(chunk[0:4])
				let size = soundFontU32(chunk, 4)
				let padded = size + (size & 1)
				fail "soundfont: {id} chunk of {size} bytes runs past the end of the file" when padded > left - 8
				left -= 8 + padded
				if id != "LIST" || size < 4 {
					try input.skip(padded)
					continue
				}
				let kind = string(try input.take(4))
				let body = size - 4
				if kind == "INFO" {
					let info = try input.take(body)
					let ifil = soundFontSubchunk(info, "ifil")
					version = soundFontU16(ifil, 0) when ifil.len() >= 2
					let inam = soundFontSubchunk(info, "INAM")
					bankName = soundFontText(inam, 0, inam.len())
				} else if kind == "sdta" {
					data = try input.sampleData(body)
				} else if kind == "pdta" {
					pdta = try input.take(body)
					havePdta = true
				} else {
					try input.skip(body)
				}
				try input.skip(size & 1)
			}
			fail "soundfont: no ifil version" when version < 0
			fail "soundfont: version {version} is not SoundFont 2" when version != 2
			fail "soundfont: no pdta list" unless havePdta
			let phdr = try soundFontRecords(pdta, "phdr", 38)
			let pbag = try soundFontRecords(pdta, "pbag", 4)
			let pgen = try soundFontRecords(pdta, "pgen", 4)
			let inst = try soundFontRecords(pdta, "inst", 22)
			let ibag = try soundFontRecords(pdta, "ibag", 4)
			let igen = try soundFontRecords(pdta, "igen", 4)
			let shdr = try soundFontRecords(pdta, "shdr", 46)
			let parts = try soundFontParts(phdr, 38, 24, pbag, pgen, SF_GEN_INSTRUMENT, "preset")
			let listed = SoundFontPreset[]
			for let (i, part) in parts {
				listed.push(SoundFontPreset{name: soundFontText(phdr, i * 38, 20), bank: part.bank, program: part.program})
			}
			let headers = SoundFontSample[]
			for let at = 0; at + 46 <= shdr.len() - 46; at += 46 {
				headers.push(SoundFontSample{
					start: soundFontU32(shdr, at + 20),
					end: soundFontU32(shdr, at + 24),
					loopStart: soundFontU32(shdr, at + 28),
					loopEnd: soundFontU32(shdr, at + 32),
					rate: soundFontU32(shdr, at + 36),
					pitch: int(shdr[at + 40]),
					correction: int(int8(shdr[at + 41])),
					kind: soundFontU16(shdr, at + 44)
				})
			}
			instruments = try soundFontParts(inst, 22, 20, ibag, igen, SF_GEN_SAMPLE, "instrument")
			name = bankName
			samples = data
			presets = listed
			presetParts = parts
			sampleHeaders = headers
		}

		// Reads the SoundFont 2 file at the path.
		//
		// Fails when the file cannot be read or is not a SoundFont 2 file.
		def load(path string) !none {
			let file = try os.open(path)
			defer file.close()
			try fromReader(file)
		}

		// The samples that sound when `key` is played at `velocity` on the
		// preset `bank`/`program`, with the generators of the preset and
		// instrument zones applied. Empty when the bank has no such preset or
		// no zone covers the key and velocity.
		//
		// A melodic bank the file lacks falls back to bank 0, as General MIDI
		// synthesizers do; bank 128 (percussion) does not fall back. A note
		// sounds every instrument zone whose key and velocity ranges cover it,
		// under every preset zone that covers it. Each voice resolves the
		// generators as SoundFont 2.04 section 9.4 has it: defaults, then the
		// instrument's global zone, then the instrument zone; the preset's
		// global zone and preset zone are added on top for the generators a
		// preset may offset (not the sample offsets, `keynum`, `velocity`,
		// `sampleModes`, `exclusiveClass` or `overridingRootKey`); the sums
		// are held to the ranges of section 8.1.3.
		//
		// - A `keynum` override is folded into `tune`, so a synthesizer
		//   pitching by the played key sounds the overriding key, and the
		//   key-scaled hold and decay use it.
		// - `attenuation` is 0.4 times the generator's centibels, the scale of
		//   the EMU hardware banks are voiced on and most synthesizers follow;
		//   `sustain` is the generator's centibels as they are.
		// - No modulator is applied, the default ones (velocity to attenuation
		//   and to filter cutoff, pressure and modulation wheel to vibrato)
		//   included, nor the `velocity` generator: the synthesizer applies
		//   the played velocity itself. The modulation envelope and LFO are not
		//   resolved.
		// - A stereo sample is two instrument zones, one on the left sample
		//   and one on the right, so it comes back as two voices, each panned
		//   by its own zone. Samples in ROM are left out.
		def voices(bank int, program int, key int, velocity int) SoundFontVoice[] {
			let out = SoundFontVoice[]
			let found = findPreset(bank, program)
			found = findPreset(0, program) when found < 0 && bank != 128
			return out when found < 0
			let preset = presetParts[found]
			for let (_, pz) in preset.zones {
				continue unless soundFontCovers(pz, key, velocity)
				continue when pz.link < 0 || pz.link >= instruments.len()
				let instrument = instruments[pz.link]
				for let (_, iz) in instrument.zones {
					continue unless soundFontCovers(iz, key, velocity)
					continue when iz.link < 0 || iz.link >= sampleHeaders.len()
					let header = sampleHeaders[iz.link]
					continue when (header.kind & 0x8000) != 0
					let gens = soundFontDefaults()
					soundFontApply(gens, instrument.global)
					soundFontApply(gens, iz)
					let offsets = int[]
					offsets.len(SF_GEN_COUNT)
					soundFontApply(offsets, preset.global)
					soundFontApply(offsets, pz)
					for let op = 0; op < SF_GEN_COUNT; op++ {
						gens[op] += offsets[op] when soundFontAdditive(op)
					}
					out.push(voice(gens, header, key))
				}
			}
			return out
		}

		// The index in `presetParts` of the preset, or -1.
		internal def findPreset(bank int, program int) int {
			for let (i, part) in presetParts {
				return i when part.bank == bank && part.program == program
			}
			return -1
		}

		// The voice the resolved generators play from the sample for `key`.
		internal def voice(gens int[], header SoundFontSample, key int) SoundFontVoice {
			soundFontClamp(gens)
			let total = samples.len()
			let start = (header.start + gens[0] + 32768 * gens[4]).clamp(0, total)
			let end = (header.end + gens[1] + 32768 * gens[12]).clamp(start, total)
			let loopStart = (header.loopStart + gens[2] + 32768 * gens[45]).clamp(start, end)
			let loopEnd = (header.loopEnd + gens[3] + 32768 * gens[50]).clamp(loopStart, end)
			let root = gens[58]
			root = header.pitch <= 127 ?? (header.pitch, 60) when root < 0
			let tune = gens[51] * 100 + gens[52] + header.correction
			let played = key
			if gens[46] >= 0 {
				played = gens[46]
				tune += (played - key) * gens[56]
			}
			let modes = gens[54] & 3
			let loop = SoundFontLoop.None
			if modes == 1 {
				loop = SoundFontLoop.Continuous
			} else if modes == 3 {
				loop = SoundFontLoop.UntilRelease
			}
			return SoundFontVoice{
				data: samples,
				start: start,
				end: end,
				loopStart: loopStart,
				loopEnd: loopEnd,
				loop: loop,
				sampleRate: header.rate,
				rootKey: root,
				tune: tune,
				scaleTuning: gens[56],
				attenuation: float(gens[48]) * 0.04,
				pan: float(gens[17]) / 500.0,
				delay: soundFontSeconds(gens[33]),
				attack: soundFontSeconds(gens[34]),
				hold: soundFontSeconds(gens[35] + gens[39] * (60 - played)),
				decay: soundFontSeconds(gens[36] + gens[40] * (60 - played)),
				sustain: float(gens[37]) / 10.0,
				release: soundFontSeconds(gens[38]),
				filterCutoff: soundFontHertz(gens[8]),
				filterQ: float(gens[9]) / 10.0,
				vibratoRate: soundFontHertz(gens[24]),
				vibratoDepth: float(gens[6]),
				reverb: float(gens[16]) / 1000.0,
				chorus: float(gens[15]) / 1000.0,
				exclusiveClass: gens[57]
			}
		}
	}

	// An instrument the bank offers, by MIDI bank and program number.
	struct SoundFontPreset {
		name    string
		bank    int
		program int
	}

	// How a sample repeats while its note sounds.
	enum SoundFontLoop {
		// Plays once to its end.
		None,
		// Loops for as long as the note sounds, release included.
		Continuous,
		// Loops while the key is held, then plays on to its end.
		UntilRelease,
	}

	// One sample playing for one note, every setting resolved.
	struct SoundFontVoice {
		// The bank's whole sample memory, 16-bit mono, shared by every voice;
		// this voice plays `start` up to `end`.
		data           int16[]
		start          int
		end            int
		loopStart      int
		loopEnd        int
		loop           SoundFontLoop
		// The rate the sample was recorded at.
		sampleRate     int
		// The key the sample plays at its recorded pitch.
		rootKey        int
		// Tuning in cents: coarse and fine tune and the sample's correction.
		tune           int
		// Cents per key away from the root key, 100 for a normal keyboard.
		scaleTuning    int
		// Attenuation in dB, 0 for full level.
		attenuation    float
		// Stereo position, -1 left to 1 right.
		pan            float
		// Volume envelope: times in seconds, sustain as attenuation in dB.
		delay          float
		attack         float
		hold           float
		decay          float
		sustain        float
		release        float
		// Low-pass filter: cutoff in Hz (20000 and above is open), resonance in dB.
		filterCutoff   float
		filterQ        float
		// Vibrato: frequency in Hz, depth in cents.
		vibratoRate    float
		vibratoDepth   float
		// Effect sends, 0 to 1.
		reverb         float
		chorus         float
		// Voices of one class (hi-hats) cut each other off; 0 for none.
		exclusiveClass int
	}
}

internal partial module std.formats.audio.soundfont {
	use (
		std.io
		std.formats.audio.celt::*
		std.formats.audio.midi::*
	)

	// Generator operators (SoundFont 2.04 section 8.1.2) the reader treats
	// specially: the zone links, the ranges, and how many there are.
	const (
		SF_GEN_INSTRUMENT = 41
		SF_GEN_KEY_RANGE  = 43
		SF_GEN_VEL_RANGE  = 44
		SF_GEN_SAMPLE     = 53
		SF_GEN_COUNT      = 61
	)

	// One zone of a preset or an instrument: the notes it covers and the
	// generators it sets.
	struct SoundFontZone {
		// Key and velocity range, inclusive, the global zone's when the zone
		// sets none.
		keyLow  int
		keyHigh int
		velLow  int
		velHigh int
		// The generators the zone sets other than its ranges and link, in
		// file order.
		ops     int[]
		amounts int[]
		// The instrument (preset zone) or sample (instrument zone) the zone
		// plays; -1 for a global zone.
		link    int
	}

	// A preset or an instrument: its global zone (setting nothing when the
	// file has none) and its other zones.
	struct SoundFontPart {
		global  SoundFontZone
		zones   SoundFontZone[]
		// The preset's MIDI bank and program; 0 for an instrument.
		bank    int
		program int
	}

	// A sample header (`shdr`, section 7.10): where the sample lies in the
	// sample data and how it was recorded.
	struct SoundFontSample {
		start      int
		end        int
		loopStart  int
		loopEnd    int
		rate       int
		// The MIDI key of the recorded pitch; 255 for an unpitched sample.
		pitch      int
		// Pitch correction in cents.
		correction int
		// The sample type: 1 mono, 2 right, 4 left, 8 linked, 0x8000 in ROM.
		kind       int
	}

	// Reads the chunks of a SoundFont file from a reader, which need not
	// seek.
	type SoundFontInput {
		reader  io.Reader
		scratch byte[]

		// An input over the reader.
		def new(reader io.Reader) {
			self.reader = reader
		}

		// The next `count` bytes. Fails when the reader fails or ends first.
		def take(count int) !byte[] {
			let out byte[]
			out.len(count)
			try fill(out)
			return out
		}

		// Fills the buffer. Fails when the reader fails or ends first.
		def fill(buf byte[]) !none {
			let got = 0
			for got < buf.len() {
				let n = try reader.read(buf[got:])
				fail "soundfont: file ends inside a chunk" when n <= 0
				got += n
			}
		}

		// Reads past `count` bytes. Fails when the reader fails or ends first.
		def skip(count int) !none {
			let left = count
			for left > 0 {
				let n = left.min(65536)
				scratch.len(n)
				try fill(scratch)
				left -= n
			}
		}

		// The samples of the `smpl` chunk of an `sdta` list `size` bytes long,
		// the list's other chunks read past. Fails when the reader fails or
		// ends first, or a chunk runs past the list.
		def sampleData(size int) !int16[] {
			let out = int16[]
			let left = size
			for left >= 8 {
				let chunk = try take(8)
				let id = string(chunk[0:4])
				let length = soundFontU32(chunk, 4)
				let padded = length + (length & 1)
				fail "soundfont: {id} chunk of {length} bytes runs past its sdta list" when padded > left - 8
				left -= 8 + padded
				if id == "smpl" {
					out = try samples(length / 2)
					try skip(padded - (length / 2) * 2)
				} else {
					try skip(padded)
				}
			}
			try skip(left)
			return out
		}

		// `count` little-endian 16-bit samples, converted a block at a time so
		// the bank's bytes are never held whole. Fails when the reader fails
		// or ends first.
		def samples(count int) !int16[] {
			let out = int16[]
			out.len(count)
			scratch.len(65536)
			let done = 0
			for done < count {
				let n = (count - done).min(32768)
				let block = scratch[0:2 * n]
				try fill(block)
				for let i = 0; i < n; i++ {
					out[done + i] = int16(int(block[2 * i]) | int(block[2 * i + 1]) << 8)
				}
				done += n
			}
			return out
		}
	}

	// The little-endian unsigned 16-bit number at `at`.
	def soundFontU16(data byte[], at int) int {
		return int(data[at]) | int(data[at + 1]) << 8
	}

	// The little-endian unsigned 32-bit number at `at`.
	def soundFontU32(data byte[], at int) int {
		return int(data[at]) | int(data[at + 1]) << 8 | int(data[at + 2]) << 16 | int(data[at + 3]) << 24
	}

	// The text of a fixed-size name field: up to its first NUL, UTF-8 when
	// valid, else Latin-1.
	def soundFontText(data byte[], at int, size int) string {
		let end = at
		for end < at + size && data[end] != 0 {
			end++
		}
		return midiText(data[at:end])
	}

	// The body of the first sub-chunk `id` of a list body; empty when there
	// is none.
	def soundFontSubchunk(body byte[], id string) byte[] {
		let at = 0
		for at + 8 <= body.len() {
			let size = soundFontU32(body, at + 4)
			break when size > body.len() - at - 8
			return body[at + 8:at + 8 + size] when string(body[at:at + 4]) == id
			at += 8 + size + (size & 1)
		}
		return byte[]
	}

	// The records of the `pdta` sub-chunk `id`, `size` bytes each. Fails
	// when the chunk is missing or is not a whole number of records, at least
	// the terminal one.
	def soundFontRecords(pdta byte[], id string, size int) !byte[] {
		let body = soundFontSubchunk(pdta, id)
		fail "soundfont: {id} chunk of {body.len()} bytes is not whole {size}-byte records" when body.len() % size != 0
		fail "soundfont: no {id} chunk" when body.len() < size
		return body
	}

	// The presets (`phdr`) or instruments (`inst`) with their zones:
	// `headers` holds `record`-byte records whose bag index is at `bagAt`,
	// the terminal record last; `bags` and `gens` the bag and generator
	// lists. A zone ends at its `link` generator, whose amount is its
	// instrument or sample; a first zone without one is the global zone, and
	// any later zone without one is ignored (section 7.3, 7.7).
	//
	// Fails when a bag or generator index goes backwards or past its list.
	def soundFontParts(headers byte[], record int, bagAt int, bags byte[], gens byte[], link int, what string) !SoundFontPart[] {
		let out = SoundFontPart[]
		let count = headers.len() / record - 1
		let bagCount = bags.len() / 4 - 1
		let genCount = gens.len() / 4 - 1
		for let r = 0; r < count; r++ {
			let firstBag = soundFontU16(headers, r * record + bagAt)
			let endBag = soundFontU16(headers, (r + 1) * record + bagAt)
			fail "soundfont: {what} {r} has bags {firstBag} to {endBag} of {bagCount}" when firstBag > endBag || endBag > bagCount
			let part = SoundFontPart{global: soundFontZone(), zones: SoundFontZone[], bank: 0, program: 0}
			if record == 38 {
				part.program = soundFontU16(headers, r * record + 20)
				part.bank = soundFontU16(headers, r * record + 22)
			}
			for let b = firstBag; b < endBag; b++ {
				let firstGen = soundFontU16(bags, b * 4)
				let endGen = soundFontU16(bags, b * 4 + 4)
				fail "soundfont: {what} bag {b} has generators {firstGen} to {endGen} of {genCount}" when firstGen > endGen || endGen > genCount
				let zone = soundFontZone()
				zone.keyLow = -1
				zone.velLow = -1
				for let g = firstGen; g < endGen; g++ {
					let op = soundFontU16(gens, g * 4)
					let raw = soundFontU16(gens, g * 4 + 2)
					if op == SF_GEN_KEY_RANGE {
						zone.keyLow = raw & 0xFF
						zone.keyHigh = raw >> 8
					} else if op == SF_GEN_VEL_RANGE {
						zone.velLow = raw & 0xFF
						zone.velHigh = raw >> 8
					} else if op == link {
						zone.link = raw
						break
					} else if op < SF_GEN_COUNT {
						zone.ops.push(op)
						zone.amounts.push(int(int16(raw)))
					}
				}
				if zone.link < 0 {
					part.global = zone when b == firstBag
					continue
				}
				part.zones.push(zone)
			}
			soundFontRanges(part.global, soundFontZone())
			for let (_, zone) in part.zones {
				soundFontRanges(zone, part.global)
			}
			out.push(part)
		}
		return out
	}

	// A zone covering every key and velocity, setting nothing.
	def soundFontZone() SoundFontZone {
		return SoundFontZone{keyLow: 0, keyHigh: 127, velLow: 0, velHigh: 127, ops: int[], amounts: int[], link: -1}
	}

	// Gives a zone that set no key or velocity range the fallback's.
	def soundFontRanges(zone SoundFontZone, fallback SoundFontZone) {
		if zone.keyLow < 0 {
			zone.keyLow = fallback.keyLow
			zone.keyHigh = fallback.keyHigh
		}
		if zone.velLow < 0 {
			zone.velLow = fallback.velLow
			zone.velHigh = fallback.velHigh
		}
	}

	// Whether the zone's ranges cover the key and velocity.
	def soundFontCovers(zone SoundFontZone, key int, velocity int) bool {
		return key >= zone.keyLow && key <= zone.keyHigh && velocity >= zone.velLow && velocity <= zone.velHigh
	}

	// Sets the zone's generators over the values.
	def soundFontApply(values int[], zone SoundFontZone) {
		for let (i, op) in zone.ops {
			values[op] = zone.amounts[i]
		}
	}

	// The generator defaults of section 8.1.3.
	def soundFontDefaults() int[] {
		let values = int[]
		values.len(SF_GEN_COUNT)
		values[8] = 13500
		for let (_, op) in [21, 23, 25, 26, 27, 28, 30, 33, 34, 35, 36, 38] {
			values[op] = -12000
		}
		values[46] = -1
		values[47] = -1
		values[56] = 100
		values[58] = -1
		return values
	}

	// Whether a preset zone may offset the generator (section 8.5): not the
	// sample offsets, the index generators, the ranges, `keynum`,
	// `velocity`, `sampleModes`, `exclusiveClass`, `overridingRootKey` nor
	// the unused and reserved operators.
	def soundFontAdditive(op int) bool {
		return false when op <= 4 || op == 12 || op == 14 || (op >= 18 && op <= 20)
		return false when op >= 41 && op <= 47
		return false when op == 49 || op == 50 || op == 53 || op == 54 || op == 55 || op >= 57
		return true
	}

	// Holds the generators the voice reads to the ranges of section 8.1.3.
	def soundFontClamp(gens int[]) {
		gens[6] = gens[6].clamp(-12000, 12000)
		gens[8] = gens[8].clamp(1500, 13500)
		gens[9] = gens[9].clamp(0, 960)
		gens[15] = gens[15].clamp(0, 1000)
		gens[16] = gens[16].clamp(0, 1000)
		gens[17] = gens[17].clamp(-500, 500)
		gens[24] = gens[24].clamp(-16000, 4500)
		gens[33] = gens[33].clamp(-12000, 5000)
		gens[34] = gens[34].clamp(-12000, 8000)
		gens[35] = gens[35].clamp(-12000, 5000)
		gens[36] = gens[36].clamp(-12000, 8000)
		gens[37] = gens[37].clamp(0, 1440)
		gens[38] = gens[38].clamp(-12000, 8000)
		gens[39] = gens[39].clamp(-1200, 1200)
		gens[40] = gens[40].clamp(-1200, 1200)
		gens[48] = gens[48].clamp(0, 1440)
		gens[51] = gens[51].clamp(-120, 120)
		gens[52] = gens[52].clamp(-99, 99)
		gens[56] = gens[56].clamp(0, 1200)
	}

	// Timecents as seconds: 2^(tc/1200), so the -12000 default is about a
	// millisecond.
	def soundFontSeconds(timecents int) float {
		return celtExp2(float(timecents) / 1200.0)
	}

	// Absolute cents as Hz: 8.176 Hz (MIDI key 0) times 2^(cents/1200).
	def soundFontHertz(cents int) float {
		return 8.176 * celtExp2(float(cents) / 1200.0)
	}
}
