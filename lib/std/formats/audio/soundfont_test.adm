partial module std.formats.audio {
	use (
		std.bytes
		std.os
		std.testing
		std.time
	)

	check "SoundFont" {
		// The General MIDI bank most Linux systems install; a missing bank
		// skips the tests that read it.
		let systemBank = "/usr/share/soundfonts/FluidR3_GM.sf2"

		// Whether the value is within the tolerance of the expected one.
		internal def close(got float, want float, tolerance float = 0.0001) bool {
			return (got - want).abs() <= tolerance
		}

		// A key range or velocity range generator amount.
		internal def range(low int, high int) int {
			return low | high << 8
		}

		internal def parse(data byte[]) !SoundFont {
			let bank = new SoundFont()
			try bank.fromReader(new bytes.Buffer(data))
			return bank
		}

		// The test bank: 1000 samples counting from -500, and
		//
		// - preset "Test Piano" (0/0): a global zone offsetting the attack by
		//   1200 timecents and the attenuation by 50 cB (and a start offset,
		//   which a preset may not set), and one zone for keys 40-80 at
		//   velocities 10-127 adding fine tune 7 and attenuation 20 over
		//   instrument "Split";
		// - preset "Kit" (128/0): instrument "Stereo", two zones panned hard
		//   left and right;
		// - preset "Tweaks" (0/5): instrument "Tweaked", every other
		//   generator the voice reads, plus preset offsets that push the
		//   filter cutoff and chorus send.
		internal def testBank(version int = 2) byte[] {
			let w = new SoundFontTestWriter()
			w.preset("Test Piano", 0, 0)
			w.presetZone([34, 1200, 48, 50, 0, 99])
			w.presetZone([43, range(40, 80), 44, range(10, 127), 52, 7, 48, 20, 41, 0])
			w.preset("Kit", 0, 128)
			w.presetZone([41, 1])
			w.preset("Tweaks", 5, 0)
			w.presetZone([8, 1200, 15, 500, 41, 2])

			w.instrument("Split")
			w.instrumentZone([34, -1200, 17, 100, 48, 100, 54, 1])
			w.instrumentZone([43, range(0, 63), 17, -200, 0, 10, 3, -20, 51, 2, 53, 0])
			w.instrumentZone([43, range(64, 127), 44, range(0, 63), 54, 3, 58, 70, 39, 100, 35, 0, 53, 1])
			w.instrument("Stereo")
			w.instrumentZone([57, 1, 17, -500, 53, 1])
			w.instrumentZone([17, 500, 53, 0])
			w.instrument("Tweaked")
			w.instrumentZone([
				46, 72,
				56, 50,
				40, 50,
				36, 1200,
				4, 1,
				0, -32700,
				12, -1,
				1, 32767,
				45, 1,
				2, -32768,
				8, 6000,
				9, 100,
				16, 250,
				15, 1000,
				24, 1200,
				6, 50,
				37, 300,
				38, -2400,
				33, -3600,
				53, 0
			])

			w.sample("Mono", 100, 600, 200, 500, 22050, 60, -5, 1)
			w.sample("Drum", 700, 900, 750, 850, 44100, 255, 3, 1)
			let pcm = int16[]
			for let i = 0; i < 1000; i++ {
				pcm.push(int16(i - 500))
			}
			return w.bytes("Test Bank", pcm, version)
		}

		@test()
		def TestHeaderAndPresets() !none {
			let bank = try parse(testBank())
			assert bank.name == "Test Bank"
			assert bank.presets.len() == 3
			assert bank.presets[0].name == "Test Piano" && bank.presets[0].bank == 0 && bank.presets[0].program == 0
			assert bank.presets[1].name == "Kit" && bank.presets[1].bank == 128
			assert bank.presets[2].program == 5
		}

		@test()
		def TestGeneratorArithmetic() !none {
			let bank = try parse(testBank())
			let voices = bank.voices(0, 0, 60, 100)
			assert voices.len() == 1
			let v = voices[0]
			// Instrument global zone plus the zone's own offsets; the preset's
			// start offset is not additive and is dropped.
			assert v.start == 110 && v.end == 600
			assert v.loopStart == 200 && v.loopEnd == 480
			assert int(v.data[v.start]) == -390
			assert v.loop == SoundFontLoop.Continuous
			assert v.sampleRate == 22050 && v.rootKey == 60
			// Coarse tune 2, preset fine tune 7, sample correction -5.
			assert v.tune == 202 && v.scaleTuning == 100
			// 100 cB + 20 cB, the preset zone's 20 replacing its global 50;
			// 0.4 of 12 dB.
			assert close(v.attenuation, 4.8)
			// -1200 + 1200 timecents is one second.
			assert close(v.attack, 1.0)
			assert close(v.pan, -0.4)
			assert close(v.delay, 0.0009765625) && close(v.hold, 0.0009765625)
			assert close(v.sustain, 0.0) && close(v.release, 0.0009765625)
			assert close(v.filterCutoff, 19912.62, 0.01) && close(v.filterQ, 0.0)
			assert close(v.vibratoRate, 8.176) && close(v.vibratoDepth, 0.0)
			assert close(v.reverb, 0.0) && close(v.chorus, 0.0)
			assert v.exclusiveClass == 0
		}

		@test()
		def TestUpperZone() !none {
			let bank = try parse(testBank())
			let voices = bank.voices(0, 0, 70, 50)
			assert voices.len() == 1
			let v = voices[0]
			assert v.start == 700 && v.end == 900 && v.loopStart == 750 && v.loopEnd == 850
			assert v.loop == SoundFontLoop.UntilRelease
			// The overriding root key wins over the unpitched sample.
			assert v.rootKey == 70
			assert v.tune == 10
			assert close(v.pan, 0.2)
			// Hold 0 timecents, 100 per key below 60: key 70 is -1000.
			assert close(v.hold, 0.561231)
		}

		@test()
		def TestRanges() !none {
			let bank = try parse(testBank())
			// Velocity 90 is past the upper zone's 0-63.
			assert bank.voices(0, 0, 70, 90).isEmpty()
			// Outside the preset zone's keys 40-80 and velocities 10-127.
			assert bank.voices(0, 0, 30, 100).isEmpty()
			assert bank.voices(0, 0, 90, 50).isEmpty()
			assert bank.voices(0, 0, 60, 5).isEmpty()
			assert bank.voices(0, 0, 60, 200).isEmpty()
			// No such program; percussion does not fall back to bank 0.
			assert bank.voices(0, 9, 60, 100).isEmpty()
			assert bank.voices(128, 5, 60, 100).isEmpty()
			// A missing melodic bank falls back to bank 0.
			assert bank.voices(3, 5, 60, 100).len() == 1
		}

		@test()
		def TestStereoAndExclusiveClass() !none {
			let bank = try parse(testBank())
			let voices = bank.voices(128, 0, 36, 100)
			assert voices.len() == 2
			assert close(voices[0].pan, -1.0) && close(voices[1].pan, 1.0)
			// Pitch 255 is unpitched: key 60.
			assert voices[0].rootKey == 60 && voices[0].exclusiveClass == 1
			assert voices[1].exclusiveClass == 0
		}

		@test()
		def TestEveryGenerator() !none {
			let bank = try parse(testBank())
			let voices = bank.voices(0, 5, 60, 100)
			assert voices.len() == 1
			let v = voices[0]
			// Coarse offsets: 100 + 32768 - 32700, 600 - 32768 + 32767,
			// 200 + 32768 - 32768.
			assert v.start == 168 && v.end == 599 && v.loopStart == 200 && v.loopEnd == 500
			// keynum 72 at 50 cents a key: 12 keys up, less the -5 correction.
			assert v.tune == 595 && v.scaleTuning == 50
			// Decay 1200 + 50 * (60 - 72) timecents, key-scaled by the keynum.
			assert close(v.decay, 1.414214)
			// 6000 + 1200 absolute cents.
			assert close(v.filterCutoff, 523.264, 0.001)
			assert close(v.filterQ, 10.0)
			assert close(v.reverb, 0.25) && close(v.chorus, 1.0)
			assert close(v.vibratoRate, 16.352) && close(v.vibratoDepth, 50.0)
			assert close(v.sustain, 30.0)
			assert close(v.release, 0.25) && close(v.delay, 0.125)
			assert v.loop == SoundFontLoop.None
		}

		@test()
		def TestRejects() !none {
			assert parse("RIFX".bytes()) is error
			let data = testBank()
			assert parse(testBank(3)) is error
			assert parse(data[:data.len() - 100]) is error
			let wrongForm = data.clone()
			wrongForm[8] = byte('x')
			assert parse(wrongForm) is error
			// A failed read keeps what the bank held.
			let bank = try parse(data)
			assert bank.fromReader(new bytes.Buffer(data[:40])) is error
			assert bank.presets.len() == 3
		}

		@test()
		def TestSystemBank() !none {
			let present = os.exists(systemBank) onerror recover false
			return none unless present
			let bank = new SoundFont()
			let began = time.now().unixNs()
			try bank.load(systemBank)
			let took = (time.now().unixNs() - began) / 1000000
			print("FluidR3_GM.sf2 loaded in {took} ms\n")
			assert took < 20000
			assert bank.presets.len() > 128
			let piano = bank.presets.find(p => p.bank == 0 && p.program == 0)
			fail "no program 0 in bank 0" when piano is none
			assert piano.name == "Yamaha Grand Piano"
			let voices = bank.voices(0, 0, 60, 100)
			assert voices.isNotEmpty()
			for let (_, v) in voices {
				assert v.data.len() > 70000000
				assert v.start < v.end && v.end <= v.data.len()
				assert v.loopStart >= v.start && v.loopEnd <= v.end
				assert v.rootKey >= 50 && v.rootKey <= 70
				assert v.sampleRate >= 22050 && v.sampleRate <= 96000
				assert v.attack >= 0.0 && v.attack < 1.0
				assert v.release > 0.01 && v.release < 20.0
				assert v.attenuation >= 0.0 && v.attenuation < 50.0
				assert v.pan >= -1.0 && v.pan <= 1.0
			}
			let drums = bank.voices(128, 0, 36, 100)
			assert drums.isNotEmpty()
			assert bank.voices(0, 0, 60, 200).isEmpty()
			assert bank.voices(0, 0, 200, 100).isEmpty()
			// A bank the file lacks plays bank 0.
			assert bank.voices(5, 0, 60, 100).len() == voices.len()
		}
	}

	// Writes a minimal SoundFont 2 file for the tests: presets, instruments
	// and zones are appended in order, each zone given as operator/amount
	// pairs.
	internal type SoundFontTestWriter {
		internal phdr byte[]
		internal pbag byte[]
		internal pgen byte[]
		internal inst byte[]
		internal ibag byte[]
		internal igen byte[]
		internal shdr byte[]

		// Starts a preset; the zones added next are its.
		def preset(name string, program int, bank int) {
			soundFontTestName(phdr, name)
			soundFontTestU16(phdr, program)
			soundFontTestU16(phdr, bank)
			soundFontTestU16(phdr, pbag.len() / 4)
			soundFontTestU32(phdr, 0)
			soundFontTestU32(phdr, 0)
			soundFontTestU32(phdr, 0)
		}

		// Adds a zone to the last preset.
		def presetZone(gens int[]) {
			soundFontTestU16(pbag, pgen.len() / 4)
			soundFontTestU16(pbag, 0)
			soundFontTestGens(pgen, gens)
		}

		// Starts an instrument; the zones added next are its.
		def instrument(name string) {
			soundFontTestName(inst, name)
			soundFontTestU16(inst, ibag.len() / 4)
		}

		// Adds a zone to the last instrument.
		def instrumentZone(gens int[]) {
			soundFontTestU16(ibag, igen.len() / 4)
			soundFontTestU16(ibag, 0)
			soundFontTestGens(igen, gens)
		}

		// Adds a sample header.
		def sample(name string, start int, end int, loopStart int, loopEnd int, rate int, pitch int, correction int, kind int) {
			soundFontTestName(shdr, name)
			soundFontTestU32(shdr, start)
			soundFontTestU32(shdr, end)
			soundFontTestU32(shdr, loopStart)
			soundFontTestU32(shdr, loopEnd)
			soundFontTestU32(shdr, rate)
			shdr.push(byte(pitch), byte(correction & 0xFF))
			soundFontTestU16(shdr, 0)
			soundFontTestU16(shdr, kind)
		}

		// The file: the terminal records added, then INFO, sdta and pdta.
		def bytes(name string, samples int16[], version int) byte[] {
			preset("EOP", 0, 0)
			presetZone(int[])
			instrument("EOI")
			instrumentZone(int[])
			sample("EOS", 0, 0, 0, 0, 0, 0, 0, 0)
			soundFontTestU32(pgen, 0)
			soundFontTestU32(igen, 0)
			let ifil byte[]
			soundFontTestU16(ifil, version)
			soundFontTestU16(ifil, 4)
			let inam = (name + "\u0000").bytes()
			let info = "INFO".bytes()
			soundFontTestChunk(info, "ifil", ifil)
			soundFontTestChunk(info, "INAM", inam)
			let pcm byte[]
			for let (_, s) in samples {
				soundFontTestU16(pcm, int(s) & 0xFFFF)
			}
			let sdta = "sdta".bytes()
			soundFontTestChunk(sdta, "smpl", pcm)
			let mods byte[]
			mods.len(10)
			let pdta = "pdta".bytes()
			soundFontTestChunk(pdta, "phdr", phdr)
			soundFontTestChunk(pdta, "pbag", pbag)
			soundFontTestChunk(pdta, "pmod", mods)
			soundFontTestChunk(pdta, "pgen", pgen)
			soundFontTestChunk(pdta, "inst", inst)
			soundFontTestChunk(pdta, "ibag", ibag)
			soundFontTestChunk(pdta, "imod", mods)
			soundFontTestChunk(pdta, "igen", igen)
			soundFontTestChunk(pdta, "shdr", shdr)
			let body = "sfbk".bytes()
			soundFontTestChunk(body, "LIST", info)
			soundFontTestChunk(body, "LIST", sdta)
			soundFontTestChunk(body, "LIST", pdta)
			let out byte[]
			soundFontTestChunk(out, "RIFF", body)
			return out
		}
	}

	// Appends a little-endian 16-bit number.
	internal def soundFontTestU16(out byte[], value int) {
		out.push(byte(value & 0xFF), byte((value >> 8) & 0xFF))
	}

	// Appends a little-endian 32-bit number.
	internal def soundFontTestU32(out byte[], value int) {
		soundFontTestU16(out, value & 0xFFFF)
		soundFontTestU16(out, (value >> 16) & 0xFFFF)
	}

	// Appends a 20-byte, NUL-padded name.
	internal def soundFontTestName(out byte[], name string) {
		let raw = name.bytes()
		for let i = 0; i < 20; i++ {
			out.push(i < raw.len() ?? (raw[i], byte(0)))
		}
	}

	// Appends operator/amount pairs as generator records.
	internal def soundFontTestGens(out byte[], gens int[]) {
		for let i = 0; i + 1 < gens.len(); i += 2 {
			soundFontTestU16(out, gens[i])
			soundFontTestU16(out, gens[i + 1] & 0xFFFF)
		}
	}

	// Appends a chunk, padded to an even length.
	internal def soundFontTestChunk(out byte[], id string, body byte[]) {
		out.push(...id.bytes())
		soundFontTestU32(out, body.len())
		out.push(...body)
		out.push(byte(0)) when (body.len() & 1) == 1
	}
}
