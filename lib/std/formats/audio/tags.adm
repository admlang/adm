partial module std.formats.audio {
	use (
		std.os
		std.formats.audio.tags::*
	)

	// What a file's tags say about the recording, the same for every format
	// that has tags: ID3 in MP3, Vorbis comments in FLAC, Ogg Vorbis and
	// Opus, iTunes tags in M4A, the INFO list in WAV. Fields the file does
	// not carry stay empty. Anything else a format offers stays on that
	// codec's own type (`MP3.tags`, `FLAC.metadata`, `M4A.metadata`).
	struct AudioTags {
		title       string
		artist      string
		album       string
		albumArtist string
		genre       string
		// Release year; 0 when unknown.
		year        int
		// Position on the album and disc number, counted from 1; 0 when
		// unknown.
		track       int
		disc        int
		// The front cover picture's file bytes (JPEG or PNG usually), empty
		// when there is none, and its MIME type.
		cover       byte[]
		coverMime   string
		// ReplayGain: the gain in dB that brings the track (or its whole
		// album) to the reference loudness, and its peak sample, 1 being full
		// scale. None when the file does not say. Opus R128 gains are given
		// on the same reference.
		trackGain   ?float = none
		trackPeak   ?float = none
		albumGain   ?float = none
		albumPeak   ?float = none
	}

	// tags reads the tags of the audio file at `path`, picking the format by
	// content. A format without tags gives empty ones.
	// Fails when the file cannot be read, or no codec recognises it.
	def tags(path string) !AudioTags {
		return tags(try os.readFile(path))
	}

	// tags reads the tags of the audio file held in `data`, picking the
	// format by content. A format without tags gives empty ones.
	// Fails when no codec recognises the data, or its tags do not parse.
	def tags(data byte[]) !AudioTags {
		return readTags(data)
	}
}

internal partial module std.formats.audio.tags {
	use (
		std.bytes
		std.data.encoding
		std.formats.audio::*
		std.formats.audio.loader::*
		std.formats.audio.flac::*
	)

	// The tags of `data` through the codec that recognises it.
	// Fails when none does, or reading the tags does.
	def readTags(data byte[]) !AudioTags {
		let (codec, _) = try codecRegistry.probe(data)
		if codec is MP3 {
			let id3 = try new MP3().tags(data)
			return AudioTags{title: id3.title, artist: id3.artist, album: id3.album, year: id3.year, track: id3.track, cover: id3.cover, coverMime: id3.coverMime}
		}
		if codec is FLAC {
			let found = try new FLAC().metadata(new bytes.Reader(data))
			let out = fromComments(firstValues(found.tags))
			pickPicture(out, found.pictures)
			return out
		}
		if codec is Vorbis {
			let comments = try new Vorbis().readTags(new bytes.Reader(data))
			return fromComments(comments)
		}
		if codec is Opus {
			let opus = try new Opus().readTags(new bytes.Reader(data))
			let comments = new map<string, string>()
			for let (_, c) in opus.comments {
				let eq = c.indexOf("=")
				continue when eq <= 0
				let name = c[:eq].upper()
				comments.set(name, c[eq + 1:]) unless comments.hasKey(name)
			}
			let out = fromComments(comments)
			// R128 gains are Q7.8 dB against -23 LUFS; ReplayGain's reference
			// is 5 dB louder.
			let r128 = comments.get("R128_TRACK_GAIN")
			out.trackGain = parseInt<int>(r128) / 256.0 + 5.0 unless r128 is none
			let album = comments.get("R128_ALBUM_GAIN")
			out.albumGain = parseInt<int>(album) / 256.0 + 5.0 unless album is none
			return out
		}
		if codec is M4A {
			let m4a = new M4A()
			try m4a.info(data)
			let found = m4a.metadata
			return AudioTags{title: found.title, artist: found.artist, album: found.album, year: yearOf(found.date), track: found.track, cover: found.cover, coverMime: imageMime(found.cover)}
		}
		if codec is WAV {
			let wav = new WAV()
			try wav.info(data)
			return AudioTags{title: valueOf(wav.tags, "INAM"), artist: valueOf(wav.tags, "IART"), album: valueOf(wav.tags, "IPRD"), genre: valueOf(wav.tags, "IGNR"), year: yearOf(valueOf(wav.tags, "ICRD")), track: numberOf(valueOf(wav.tags, "ITRK"))}
		}
		return AudioTags{}
	}

	// The first value of each Vorbis comment.
	def firstValues(tags map<string, string[]>) map<string, string> {
		let out = new map<string, string>()
		for let (name, values) in tags {
			out.set(name, values[0]) when values.len() > 0
		}
		return out
	}

	// AudioTags from Vorbis comments by upper-case name, pictures included
	// (`METADATA_BLOCK_PICTURE`, a base64 FLAC picture block).
	def fromComments(c map<string, string>) AudioTags {
		let out = AudioTags{title: valueOf(c, "TITLE"), artist: valueOf(c, "ARTIST"), album: valueOf(c, "ALBUM"), albumArtist: valueOf(c, "ALBUMARTIST"), genre: valueOf(c, "GENRE"), year: yearOf(valueOf(c, "DATE")), track: numberOf(valueOf(c, "TRACKNUMBER")), disc: numberOf(valueOf(c, "DISCNUMBER"))}
		out.trackGain = decibels(valueOf(c, "REPLAYGAIN_TRACK_GAIN"))
		out.trackPeak = number(valueOf(c, "REPLAYGAIN_TRACK_PEAK"))
		out.albumGain = decibels(valueOf(c, "REPLAYGAIN_ALBUM_GAIN"))
		out.albumPeak = number(valueOf(c, "REPLAYGAIN_ALBUM_PEAK"))
		let block = valueOf(c, "METADATA_BLOCK_PICTURE")
		if block != "" {
			let raw = encoding.base64decode(block) onerror recover byte[]
			let picture = flacParsePicture(raw) onerror recover FlacPicture{}
			pickPicture(out, FlacPicture[picture]) when picture.data.len() > 0
		}
		return out
	}

	// Takes the front cover, else the first picture, into `out`; a picture
	// given as a URL is skipped.
	def pickPicture(out AudioTags, pictures FlacPicture[]) {
		let chosen = -1
		for let (i, p) in pictures {
			continue when p.mimeType == "-->" || p.data.len() == 0
			if p.kind == FlacPictureKind.FrontCover {
				chosen = i
				break
			}
			chosen = i when chosen < 0
		}
		return when chosen < 0
		out.cover = pictures[chosen].data
		out.coverMime = pictures[chosen].mimeType
	}

	// The value under `name`, "" when there is none.
	def valueOf(values map<string, string>, name string) string {
		let v = values.get(name)
		return "" when v is none
		return v.trim()
	}

	// The leading number of "7" or "7/12"; 0 when there is none.
	def numberOf(text string) int {
		let slash = text.indexOf("/")
		let head = slash < 0 ?? (text, text[:slash])
		return parseInt<int>(head.trim())
	}

	// The year of "1999", "1999-05-01" or "1999-05-01T00:00:00Z"; 0 when none.
	def yearOf(text string) int {
		let digits = text.trim()
		return 0 when digits.len() < 4
		return parseInt<int>(digits[:4])
	}

	// "-6.50 dB" as -6.5; none for an empty value.
	def decibels(text string) ?float {
		let t = text.trim()
		return none when t == ""
		let space = t.indexOf(" ")
		return parseFloat<float>(space < 0 ?? (t, t[:space]))
	}

	// A plain number, none for an empty value.
	def number(text string) ?float {
		return none when text.trim() == ""
		return parseFloat<float>(text)
	}

	// The MIME type of picture bytes by their signature, "" when unknown.
	def imageMime(data byte[]) string {
		return "" when data.len() < 4
		return "image/jpeg" when data[0] == byte(0xFF) && data[1] == byte(0xD8)
		return "image/png" when data[0] == byte(0x89) && data[1] == byte(0x50)
		return "image/gif" when data[0] == byte(0x47) && data[1] == byte(0x49)
		return ""
	}
}
