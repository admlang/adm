partial module std.formats.audio {
	use (
		std.os
		std.testing
	)

	check "Tags" {
		// Tagged 0.2 s tones made with ffmpeg: the same tags in every format,
		// an 8x8 PNG cover where the format holds one, ReplayGain in some.
		const TAGS_DIR = "samples/audio/tags/"

		internal def common(t AudioTags) bool {
			return t.title == "Tag Title" && t.artist == "Tag Artist" && t.album == "Tag Album" && t.year == 2021 && t.track == 3
		}

		internal def near(value ?float, want float) bool {
			return false when value is none
			let v float = value
			return (v - want).abs() < 1e-9
		}

		internal def isPng(data byte[]) bool {
			return data.len() > 8 && data[0] == byte(0x89) && data[1] == byte(0x50) && data[2] == byte(0x4E) && data[3] == byte(0x47)
		}

		@test()
		def TestMp3Tags() !none {
			let t = try tags(TAGS_DIR + "tagged.mp3")
			assert common(t)
			assert isPng(t.cover) && t.coverMime == "image/png"
		}

		@test()
		def TestFlacTags() !none {
			let t = try tags(TAGS_DIR + "tagged.flac")
			assert common(t) && t.albumArtist == "Various" && t.genre == "Ambient" && t.disc == 1
			assert isPng(t.cover) && t.coverMime == "image/png"
			assert near(t.trackGain, -6.5) && near(t.trackPeak, 0.5) && near(t.albumGain, -7.25) && t.albumPeak is none
		}

		@test()
		def TestVorbisTags() !none {
			let t = try tags(TAGS_DIR + "tagged.ogg")
			assert common(t) && t.genre == "Ambient"
			assert near(t.trackGain, -6.5)
		}

		@test()
		def TestOpusTags() !none {
			let t = try tags(TAGS_DIR + "tagged.opus")
			assert common(t)
			// R128 -2944 is -11.5 dB against -23 LUFS: -6.5 dB on the
			// ReplayGain reference.
			assert near(t.trackGain, -6.5) && t.albumGain is none
		}

		@test()
		def TestM4aTags() !none {
			let t = try tags(TAGS_DIR + "tagged.m4a")
			assert common(t)
			assert isPng(t.cover) && t.coverMime == "image/png"
		}

		// A file read where its tags are and the same bytes read whole give
		// the same tags; an MP3's ID3v1 tag is found at the end of a file
		// whose sound is never read.
		@test()
		def TestFileAndBytesAgree() !none {
			for let (_, name) in ["tagged.mp3", "tagged.flac", "tagged.ogg", "tagged.opus", "tagged.m4a"] {
				let path = TAGS_DIR + name
				let fromFile = try tags(path)
				let fromBytes = try tags(try os.readFile(path))
				assert fromFile.title == fromBytes.title && fromFile.artist == fromBytes.artist && fromFile.album == fromBytes.album
				assert fromFile.year == fromBytes.year && fromFile.track == fromBytes.track && fromFile.genre == fromBytes.genre
				assert fromFile.cover.len() == fromBytes.cover.len() && fromFile.coverMime == fromBytes.coverMime
			}
			// A frame header, a megabyte of sound that is not read, then ID3v1.
			let old byte[]
			old.len(1 << 20)
			old[0] = 0xFF
			old[1] = 0xFB
			old[2] = 0x90
			let tail byte[]
			tail.len(128)
			tail[0] = byte('T')
			tail[1] = byte('A')
			tail[2] = byte('G')
			for let (i, c) in "Old Title".bytes() {
				tail[3 + i] = c
			}
			old.push(...tail)
			let path = os.join(try os.appHome(), "tags-id3v1.mp3")
			try os.writeFile(path, old)
			let file = try os.open(path)
			let id3 = try new MP3().tags(file)
			try file.close()
			try os.remove(path)
			assert id3.title == "Old Title"
		}

		@test()
		def TestNoTags() !none {
			let t = try tags("samples/audio/aiff/aiff_30s_sample_file_2.5MB.aiff")
			assert t.title == "" && t.cover.len() == 0 && t.trackGain is none
			let failed = false
			tags(byte[1, 2, 3, 4, 5, 6, 7, 8]) onerror (err error) {
				failed = true
				recover AudioTags{}
			}
			assert failed
		}
	}
}
