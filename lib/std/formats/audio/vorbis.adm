partial module std.formats.audio {
	use (
		std.io
		std.bytes
		std.formats.video.media.ogg::*
		std.formats.audio.vorbis::*
	)

	// Vorbis audio in an Ogg container (`.ogg`, `.oga`), Vorbis I.
	//
	// Decoding covers the whole of Vorbis I, floor type 0 included (no
	// encoder has produced it since 2000). Channels come out in the WAVE order
	// (front left, front right, centre, LFE, back, side), not the order
	// Vorbis stores them in. Encoding writes a plain constant-quality stream
	// of floor 1 and residue 2 with coupled stereo.
	@codec("Vorbis")
	type Vorbis {
		// Encoder quality, 0 (smallest file) to 100 (best sound).
		quality int                 = 50
		// Tags `encode` writes into the comment header, by name: "TITLE",
		// "ARTIST", "ALBUM".
		tags    map<string, string> = map<string, string>{}

		mimeType string[] {
			def get() string[] {
				return string["audio/ogg", "audio/vorbis"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ogg", ".oga"]
			}
		}

		// matchSignature reports whether the reader starts with an Ogg page
		// whose first packet is a Vorbis identification header: Ogg files
		// carrying Opus or FLAC belong to their own codecs.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(oggHeaderSize + 1 + 7)
			let n = 0
			for n < head.len() {
				let got = r.read(head[n:]) onerror recover 0
				break when got <= 0
				n += got
			}
			return false when n < oggHeaderSize
			return false unless head[0] == 79 && head[1] == 103 && head[2] == 103 && head[3] == 83
			let at = oggHeaderSize + int(head[26])
			let packet byte[]
			packet.len(7)
			if at + 7 <= n {
				head[at:at + 7].copy(packet)
			} else {
				// A long segment table pushes the packet past what was read.
				let skip byte[]
				skip.len(at + 7 - n)
				let got = 0
				for got < skip.len() {
					let k = r.read(skip[got:]) onerror recover 0
					return false when k <= 0
					got += k
				}
				let whole byte[]
				whole.len(at + 7)
				head[0:n].copy(whole)
				skip.copy(whole[n:])
				whole[at:at + 7].copy(packet)
			}
			return vorbisIsIdentification(packet)
		}

		// open decodes the stream lazily as it is read. The compressed file
		// is read into memory first, which is what lets the stream seek and
		// know its length; a live stream reads page by page instead, and ends
		// with its logical stream.
		// Fails when the reader fails, or the data is not an Ogg Vorbis
		// stream this decoder can play.
		def open(reader io.Reader, live bool = false) !AudioStream {
			return vorbisOpenLive(reader) when live
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			let stream = try vorbisOpen(buf.bytes())
			return stream
		}

		// info reads the headers and the granule position of the last page.
		// Fails when the reader fails, or the data is not an Ogg Vorbis
		// stream.
		def info(reader io.Reader) !AudioInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			let stream = try vorbisOpen(buf.bytes())
			return stream.info()
		}

		// readTags returns the Vorbis comments of the stream by upper-case
		// name ("TITLE", "ARTIST"); a name given more than once has its
		// values joined with "; ". The encoder's vendor string is under
		// "VENDOR" unless the file has a tag of that name.
		// Fails when the reader fails, or the data is not an Ogg Vorbis
		// stream.
		def readTags(reader io.Reader) !map<string, string> {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			let stream = try vorbisOpen(buf.bytes())
			let found = map<string, string>{}
			for let (_, c) in stream.decoder.comments {
				let eq = c.indexOf("=")
				continue when eq <= 0
				let name = c[0:eq].upper()
				let value = c[eq + 1:]
				let before = found.get(name)
				if before is none {
					found.set(name, value)
				} else {
					found.set(name, before + "; " + value)
				}
			}
			found.set("VENDOR", stream.decoder.vendor) unless found.hasKey("VENDOR")
			return found
		}

		// decoder returns a decoder of Vorbis audio packets as a container
		// stores them. `config` holds the three header packets
		// (identification, comment, setup), each preceded by its length as
		// a 2-byte big-endian number.
		//
		// Fails when the headers are cut short, out of order or damaged.
		def decoder(config byte[]) !AudioDecoder {
			let d = new VorbisDecoder()
			let at = 0
			for !d.ready() {
				fail "vorbis: the configuration ends inside its headers" when at + 2 > config.len()
				let size = int(config[at]) << 8 | int(config[at + 1])
				at += 2
				fail "vorbis: the configuration ends inside its headers" when at + size > config.len()
				try d.header(config[at:at + size].clone())
				at += size
			}
			return new VorbisPacketDecoder(d)
		}

		// encode implements AudioEncoder: the stream from where it stands to
		// its end as Ogg Vorbis at `quality`, with `tags` in the comment
		// header.
		// Fails with the stream's or the writer's error, or when the stream
		// has no channels, more than 255, or no sample rate.
		def encode(stream AudioStream, writer io.Writer) !none {
			let about = stream.info()
			let channels = int(about.channels)
			fail "vorbis: the stream has no channels" when channels == 0
			fail "vorbis: more than 255 channels" when channels > 255
			fail "vorbis: the stream has no sample rate" when about.sampleRate == 0
			let encoder = new VorbisEncoder(int(about.sampleRate), channels, quality)
			let comments string[]
			for let (name, value) in tags {
				comments.push(name + "=" + value)
			}
			let heads = encoder.headers(vorbisVendor, comments)
			let out = new OggPacketWriter(writer, vorbisSerial)
			try out.write(heads[0], 0)
			try out.flush()
			try out.write(heads[1], 0)
			try out.write(heads[2], 0)
			try out.flush()
			let buf float32[]
			buf.len(4096 * channels)
			let packets byte[][]
			let granules int64[]
			for {
				let n = try stream.read(buf)
				break when n == 0
				encoder.encode(buf, n, packets, granules)
				for let (i, packet) in packets {
					try out.write(packet, granules[i])
				}
				packets = byte[][]
				granules = int64[]
			}
			encoder.end(packets, granules)
			for let (i, packet) in packets {
				try out.write(packet, granules[i])
			}
			return out.close()
		}
	}
}

internal partial module std.formats.audio.vorbis {
	use (
		std.io
		std.bytes
		std.formats.video.media.ogg::*
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	// The vendor string the encoder writes into the comment header.
	const vorbisVendor = "ADM std.formats.audio Vorbis encoder"

	// The serial number of the logical stream the encoder writes.
	const vorbisSerial = 0x564F5242

	// Whether the packet starts with a Vorbis identification header's type
	// and name.
	def vorbisIsIdentification(packet byte[]) bool {
		return false when packet.len() < 7
		return packet[0] == 1 && string(packet[1:7]) == "vorbis"
	}

	// Opens a decoding stream over an Ogg Vorbis file held in memory.
	//
	// Fails when the data is not Ogg Vorbis or its headers are damaged.
	def vorbisOpen(data byte[]) !VorbisStream {
		let packets = new OggPacketReader(new bytes.Reader(data))
		let decoder = new VorbisDecoder()
		for !decoder.ready() {
			let packet = try packets.next()
			fail "vorbis: the stream ends inside its headers" when packet is none
			try decoder.header(packet)
		}
		return new VorbisStream(data, decoder, packets)
	}

	// Opens a decoding stream over a live Ogg Vorbis stream, read page by
	// page from `reader`: it cannot seek and its length is unknown.
	//
	// Fails when the reader does, or the data is not Ogg Vorbis or its
	// headers are damaged.
	def vorbisOpenLive(reader io.Reader) !VorbisStream {
		let packets = new OggPacketReader(reader)
		let decoder = new VorbisDecoder()
		for !decoder.ready() {
			let packet = try packets.next()
			fail "vorbis: the stream ends inside its headers" when packet is none
			try decoder.header(packet)
		}
		let data byte[]
		let stream = new VorbisStream(data, decoder, packets)
		stream.live = true
		// Positions count from where listening began, not the granules.
		stream.synced = true
		stream.streamInfo.seekable = false
		return stream
	}

	// The AudioStream of an Ogg Vorbis file held in memory.
	//
	// Output positions come from the granule positions of the pages: frames
	// decoded before the first page that ends a packet are held until that
	// page says where they lie. That trims the start of a stream that begins
	// past zero, and lets a seek resume at any page.
	type VorbisStream {
		// The frame the next read starts at.
		framePosition uint64

		decoder    VorbisDecoder
		data       byte[]
		packets    OggPacketReader
		streamInfo AudioInfo
		pages      OggPage[]
		// The frames being handed out, from `sourceAt` to `sourceEnd`.
		source     float32[]
		sourceAt   int
		sourceEnd  int
		// Frames decoded before the position is known.
		pending    float32[]
		held       int
		synced     bool
		// Decoding from the first audio page, where the stream starts at 0.
		fresh      bool
		// The first frame to hand out.
		target     int64
		// Position of the frame after the last one decoded.
		streamAt   int64
		finished   bool
		// The page decoding resumed at is too late for the target.
		retry      bool
		closed     bool
		// Read page by page from a stream with no end; seeking fails.
		live       bool

		// A stream positioned after the headers the packet reader has read.
		def new(data byte[], decoder VorbisDecoder, packets OggPacketReader) {
			self.data = data
			self.decoder = decoder
			self.packets = packets
			pages = oggPages(data, packets.serial())
			fresh = true
			let frames = 0
			for let i = pages.len() - 1; i >= 0; i-- {
				if pages[i].granule > 0 {
					frames = int(pages[i].granule)
					break
				}
			}
			let rate = decoder.sampleRate
			let bitrate = decoder.bitrateNominal
			bitrate = int(int64(data.len()) * 8 * int64(rate) / int64(frames)) when bitrate <= 0 && frames > 0
			streamInfo = AudioInfo{
				sampleRate: uint32(rate),
				channels:   uint16(decoder.channels),
				bitDepth:   32,
				format:     SampleFormat.Float32,
				frames:     uint64(frames),
				length:     duration(int64(frames) * 1000000000 / int64(rate)),
				codec:      "vorbis",
				bitrate:    uint32(bitrate),
				seekable:   true,
			}
			pending.len(decoder.blocksizes[1] * decoder.channels)
		}

		// info implements AudioStream: rate, channels and the length from the
		// granule position of the last page.
		def info() AudioInfo {
			return streamInfo
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream.
		// Fails when `buf` is not a whole number of frames, the stream is
		// closed, or a page is damaged.
		def readFrames(buf float32[]) !int {
			let channels = decoder.channels
			fail "vorbis: read buffer is not a whole number of frames" when buf.len() % channels != 0
			fail "vorbis: the stream is closed" when closed
			let want = buf.len() / channels
			let done = 0
			for done < want {
				let avail = sourceEnd - sourceAt
				if avail > 0 {
					let take = avail < want - done ?? (avail, want - done)
					source[sourceAt * channels:(sourceAt + take) * channels].copy(buf[done * channels:])
					sourceAt += take
					done += take
					continue
				}
				break when finished
				try advance()
			}
			return done
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream: resumes at the last page before the
		// frame and decodes forward to it.
		// Fails when the stream is closed or live, or a page is damaged.
		def seekFrame(frame uint64) !none {
			fail "vorbis: the stream is closed" when closed
			fail "vorbis: a live stream cannot seek" when live
			let goal = int64(frame)
			let k = pages.len() - 1
			for k >= 0 && (pages[k].granule <= 0 || pages[k].granule > goal) {
				k--
			}
			for {
				restart(k, goal)
				for !synced && !finished && !retry {
					try advance()
				}
				break unless retry
				k--
				for k >= 0 && pages[k].granule <= 0 {
					k--
				}
			}
			return none
		}

		// close implements AudioStream; the stream reads no more.
		// Does not fail.
		def close() !none {
			closed = true
			finished = true
			sourceAt = 0
			sourceEnd = 0
			return none
		}

		// Starts decoding over at page `k`, or at the first audio packet when
		// `k` is negative, handing out frames from `goal` on.
		def restart(k int, goal int64) {
			let r = new bytes.Reader(data)
			fresh = k < 0
			if !fresh {
				r.seek(pages[k].offset) onerror recover 0
			}
			let serial = packets.serial()
			packets = new OggPacketReader(r)
			packets.follow(serial)
			if fresh {
				for let i = 0; i < 3; i++ {
					packets.next() onerror recover none
				}
			}
			decoder.reset()
			target = goal
			synced = false
			held = 0
			sourceAt = 0
			sourceEnd = 0
			finished = false
			retry = false
		}

		// Decodes the next packet and makes its frames the ones handed out.
		def advance() !none {
			let packet = try packets.next()
			if packet is none {
				finished = true
				if !synced {
					// No page gave a position: count from the start.
					synced = true
					streamAt = held
					handOut(pending, 0, held)
				}
				return none
			}
			let frames = try decoder.decode(packet)
			let granule = packets.granule()
			let known = packets.last() && granule >= 0
			let channels = decoder.channels
			if !synced {
				if held * channels + frames * channels > pending.len() {
					let grown float32[]
					grown.len((held + frames) * channels * 2)
					pending[0:held * channels].copy(grown) when held > 0
					pending = grown
				}
				decoder.output[0:frames * channels].copy(pending[held * channels:]) when frames > 0
				held += frames
				return none unless known
				let start int64 = 0
				if packets.final() {
					if !fresh {
						retry = true
						return none
					}
					held = int(granule) when granule < int64(held)
				} else {
					start = granule - int64(held)
					if !fresh && start > target {
						retry = true
						return none
					}
				}
				synced = true
				streamAt = start + int64(held)
				handOut(pending, start, held)
				return none
			}
			let count = frames
			if known && packets.final() {
				let allowed = granule - streamAt
				count = int(allowed) when allowed < int64(count)
				count = 0 when count < 0
			}
			handOut(decoder.output, streamAt, count)
			streamAt += int64(count)
			return none
		}

		// Hands out `count` frames of `from`, the first at position `start`,
		// leaving out those before the target.
		def handOut(from float32[], start int64, count int) {
			source = from
			sourceEnd = count
			let drop = target - start
			sourceAt = 0
			sourceAt = drop < int64(count) ?? (int(drop), count) when drop > 0
		}
	}

	// Decodes the audio packets of one Vorbis track once its headers are
	// read.
	type VorbisPacketDecoder {
		decoder VorbisDecoder

		def new(decoder VorbisDecoder) {
			self.decoder = decoder
		}

		// info implements AudioDecoder.
		def info() AudioInfo {
			return AudioInfo{
				sampleRate: uint32(decoder.sampleRate),
				channels:   uint16(decoder.channels),
				bitDepth:   uint16(32),
				format:     SampleFormat.Float32,
				frames:     uint64(0),
				length:     0s,
				codec:      "vorbis",
				bitrate:    uint32(decoder.bitrateNominal.max(0)),
				seekable:   false,
			}
		}

		// decode implements AudioDecoder: the frames between the centres of
		// the previous block and this one, none for the first packet.
		//
		// Fails when the packet is damaged.
		def decode(packet byte[]) !float32[] {
			let frames = try decoder.decode(packet)
			return float32[] when frames == 0
			return decoder.output[0:frames * decoder.channels].clone()
		}

		// flush implements AudioDecoder: Vorbis holds nothing back.
		//
		// Does not fail.
		def flush() !float32[] {
			return float32[]
		}

		// reset implements AudioDecoder.
		def reset() {
			decoder.reset()
		}
	}
}
