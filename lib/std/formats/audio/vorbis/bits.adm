internal partial module std.formats.audio.vorbis {
	use std.formats.audio::*

	// Reads a Vorbis packet as a bit stream: each byte's least significant
	// bit first, values packed least significant bit first (Vorbis I §2.1).
	// Bits past the end of the packet read as zero and mark the reader
	// ended, which is the specification's end-of-packet condition.
	type VorbisBitReader {
		data    byte[]
		pos     int
		limit   int
		overrun bool

		// A reader over the packet.
		def new(data byte[]) {
			reset(data)
		}

		// Starts over on another packet.
		def reset(data byte[]) {
			self.data = data
			pos = 0
			limit = data.len() * 8
			overrun = false
		}

		// The next `n` bits (0 to 32) without consuming them.
		def peek(n int) int {
			let at = pos >> 3
			let got = -(pos & 7)
			let v = 0
			let size = data.len()
			for got < n {
				let b = 0
				b = int(data[at]) when at < size
				if got < 0 {
					v = b >> (-got)
				} else {
					v |= b << got
				}
				got += 8
				at++
			}
			return v & ((1 << n) - 1)
		}

		// Consumes `n` bits.
		def skip(n int) {
			pos += n
			overrun = true when pos > limit
		}

		// Reads `n` bits (0 to 32) as an unsigned value.
		def read(n int) int {
			return 0 when n == 0
			let v = peek(n)
			pos += n
			overrun = true when pos > limit
			return v
		}

		// Reads one bit as a flag.
		def flag() bool {
			return read(1) == 1
		}

		// Whether a read went past the end of the packet.
		def ended() bool {
			return overrun
		}
	}

	// Packs values into bytes least significant bit first, the Vorbis bit
	// order.
	type VorbisBitWriter {
		out  byte[]
		size int
		acc  int
		bits int

		// An empty writer.
		def new() {
			out.len(256)
		}

		// Appends the low `n` bits (0 to 32) of `value`.
		def write(value int, n int) {
			return when n == 0
			acc |= (value & ((1 << n) - 1)) << bits
			bits += n
			for bits >= 8 {
				if size == out.len() {
					let grown byte[]
					grown.len(size * 2)
					out.copy(grown)
					out = grown
				}
				out[size] = byte(acc & 0xFF)
				size++
				acc >>= 8
				bits -= 8
			}
		}

		// Appends a flag as one bit.
		def flag(value bool) {
			write(value ?? (1, 0), 1)
		}

		// Appends the bytes of a string, eight bits each.
		def text(value string) {
			for let (_, b) in byte[](value) {
				write(int(b), 8)
			}
		}

		// Bits written so far.
		def length() int {
			return size * 8 + bits
		}

		// The packet written so far, its last byte padded with zero bits.
		def bytes() byte[] {
			let n = size + (bits > 0 ?? (1, 0))
			let packet byte[]
			packet.len(n)
			out[0:size].copy(packet) when size > 0
			packet[size] = byte(acc & 0xFF) when bits > 0
			return packet
		}

		// Empties the writer for the next packet.
		def reset() {
			size = 0
			acc = 0
			bits = 0
		}
	}

	// The number of bits needed to hold `x`: ilog in Vorbis I §9.2.1, 0 for
	// zero and negative values.
	def vorbisIlog(x int) int {
		let n = 0
		let v = x
		for v > 0 {
			n++
			v >>= 1
		}
		return n
	}
}
