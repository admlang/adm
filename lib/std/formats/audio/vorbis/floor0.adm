internal partial module std.formats.audio.vorbis {
	use std.math

	// A floor of type 0 (Vorbis I §6): the spectral envelope as an LSP
	// filter response over a Bark-scaled frequency map, with its amplitude
	// and line spectral pair coefficients coded per packet. No current
	// encoder writes it; streams from early libvorbis betas do.
	type VorbisFloor0 {
		order           int
		rate            int
		barkMapSize     int
		amplitudeBits   int
		amplitudeOffset int
		books           int[]
		// Per channel, the amplitude of the last decoded packet and its
		// `order` coefficients.
		amplitudes      int[]
		coefficients    float[][]
		// The Bark map of the short and the long half block, each ending in -1.
		maps            int[][]

		// Sizes the per-channel state and computes the Bark maps of the two
		// half block sizes.
		def prepare(channels int, shortHalf int, longHalf int) {
			amplitudes.len(channels)
			for let c = 0; c < channels; c++ {
				let v float[]
				v.len(order)
				coefficients.push(v)
			}
			maps.push(barkMap(shortHalf))
			maps.push(barkMap(longHalf))
		}

		// The map from spectral line to Bark bin for a half block of `n`
		// lines (Vorbis I §6.2.3), with the end marker -1 at `n`.
		def barkMap(n int) int[] {
			let m int[]
			m.len(n + 1)
			let top = vorbisBark(0.5 * float(rate))
			for let i = 0; i < n; i++ {
				let v = int((vorbisBark(float(rate) * float(i) / (2.0 * float(n))) * float(barkMapSize) / top).floor())
				m[i] = v.min(barkMapSize - 1)
			}
			m[n] = -1
			return m
		}

		// Reads the amplitude and coefficients of channel `c` (Vorbis I
		// §6.2.2); false when the channel is unused in this packet or the
		// packet ends first.
		def decode(r VorbisBitReader, codebooks VorbisCodebook[], c int) bool {
			let amplitude = r.read(amplitudeBits)
			return false when amplitude == 0 || r.ended()
			let bookNumber = r.read(vorbisIlog(books.len()))
			return false when bookNumber >= books.len() || r.ended()
			let book = codebooks[books[bookNumber]]
			let dims = book.dimensions
			return false when book.values.len() == 0 || dims == 0
			let out = coefficients[c]
			let filled = 0
			let last = 0.0
			for filled < order {
				let entry = book.decode(r)
				return false when entry < 0
				let base = entry * dims
				let tail = 0.0
				for let i = 0; i < dims; i++ {
					let v = book.values[base + i] + last
					out[filled + i] = v when filled + i < order
					tail = v
				}
				last = tail
				filled += dims
			}
			amplitudes[c] = amplitude
			return true
		}

		// Multiplies the `size` spectral lines of `spectrum` by the curve of
		// channel `c` (Vorbis I §6.2.3); `long` picks the long block's map.
		def apply(c int, size int, long bool, spectrum float[]) {
			let bark = maps[long ?? (1, 0)]
			let coef = coefficients[c]
			let cosines float[]
			cosines.len(order)
			for let j = 0; j < order; j++ {
				cosines[j] = math.cos(coef[j])
			}
			let amplitude = float(amplitudes[c])
			let scale = amplitude * float(amplitudeOffset) / float((1 << amplitudeBits) - 1)
			let i = 0
			for i < size {
				let bin = bark[i]
				let w = math.cos(math.π * float(bin) / float(barkMapSize))
				let p = 1.0
				let q = 1.0
				if (order & 1) != 0 {
					p = 1.0 - w * w
					q = 0.25
					for let j = 1; j < order; j += 2 {
						let d = cosines[j] - w
						p *= 4.0 * d * d
					}
					for let j = 0; j < order; j += 2 {
						let d = cosines[j] - w
						q *= 4.0 * d * d
					}
				} else {
					p = (1.0 - w) / 2.0
					q = (1.0 + w) / 2.0
					for let j = 1; j < order; j += 2 {
						let d = cosines[j] - w
						p *= 4.0 * d * d
					}
					for let j = 0; j < order; j += 2 {
						let d = cosines[j] - w
						q *= 4.0 * d * d
					}
				}
				let value = math.E ** (0.11512925 * (scale / math.sqrt(p + q) - float(amplitudeOffset)))
				for i < size && bark[i] == bin {
					spectrum[i] *= value
					i++
				}
			}
		}
	}

	// The Bark scale of frequency `x` in Hz (Vorbis I §6.2.3).
	def vorbisBark(x float) float {
		return 13.1 * math.atan(0.00074 * x) + 2.24 * math.atan(0.0000000185 * x * x) + 0.0001 * x
	}

	// Reads a floor 0 configuration from the setup header (Vorbis I
	// §6.2.1).
	//
	// Fails when it names a codebook that does not exist or has a zero
	// rate or map size.
	def vorbisReadFloor0(r VorbisBitReader, bookCount int) !VorbisFloor0 {
		let floor = new VorbisFloor0()
		floor.order = r.read(8)
		floor.rate = r.read(16)
		floor.barkMapSize = r.read(16)
		floor.amplitudeBits = r.read(6)
		floor.amplitudeOffset = r.read(8)
		let count = r.read(4) + 1
		for let i = 0; i < count; i++ {
			let book = r.read(8)
			fail "vorbis: floor names a missing codebook" when book >= bookCount
			floor.books.push(book)
		}
		fail "vorbis: floor 0 with a zero rate or Bark map size" when floor.rate == 0 || floor.barkMapSize == 0
		fail "vorbis: floor 0 with no order or amplitude bits" when floor.order == 0 || floor.amplitudeBits == 0
		fail "vorbis: floor 0 setup cut short" when r.ended()
		return floor
	}
}
