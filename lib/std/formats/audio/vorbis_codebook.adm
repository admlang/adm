internal partial module std.formats.audio.vorbis {
	// Bits a codebook resolves with one table lookup; longer codewords
	// finish by walking the code tree.
	const vorbisFastBits = 10

	// A Vorbis codebook (Vorbis I §3): Huffman codewords for its entries and,
	// for a vector codebook, the vector each entry stands for.
	type VorbisCodebook {
		dimensions int
		entries    int
		// Codeword length per entry, 0 for an entry the book does not use.
		lengths    int[]
		// Codeword per entry, most significant bit first as it is read.
		codes      int[]
		// Vector values, `dimensions` per entry; empty for a scalar book.
		values     float[]
		lookupType int
		// Indexed by the next `vorbisFastBits` bits: entry << 5 | length for
		// a codeword that short, -(node + 2) to continue the tree walk from
		// `node` after those bits, -1 for no codeword.
		fast       int[]
		// The code tree: per node its child for a 0 bit and a 1 bit; 0 is no
		// child, a positive value an inner node, -(entry + 1) a leaf.
		zero       int[]
		one        int[]

		// A codebook from its entry lengths, with no vectors and no decoding
		// tables yet: `build` makes those.
		def new(dimensions int, lengths int[]) {
			self.dimensions = dimensions
			self.lengths = lengths
			entries = lengths.len()
		}

		// Computes the vector of every entry from the lookup table (Vorbis
		// I §3.2.1, lookup types 1 and 2).
		def unpackVectors(multiplicands int[], minimum float, delta float, sequence bool) {
			values.len(entries * dimensions)
			let lookupValues = multiplicands.len()
			for let e = 0; e < entries; e++ {
				let last = 0.0
				let divisor = 1
				for let i = 0; i < dimensions; i++ {
					let offset = lookupType == 1 ?? ((e / divisor) % lookupValues, e * dimensions + i)
					let v = float(multiplicands[offset]) * delta + minimum + last
					values[e * dimensions + i] = v
					last = v when sequence
					divisor *= lookupValues when lookupType == 1
				}
			}
		}

		// Assigns the codewords and builds the decoding tables.
		//
		// Fails when the lengths over-fill the code space.
		def build() !none {
			codes.len(entries)
			// marker[l] is the next free codeword of length l.
			let marker int[]
			marker.len(33)
			let used = 0
			let only = -1
			for let i = 0; i < entries; i++ {
				let length = lengths[i]
				continue when length == 0
				used++
				only = i
				let code = marker[length]
				fail "vorbis: codebook is over-specified" when length < 32 && (code >> length) != 0
				codes[i] = code
				for let j = length; j > 0; j-- {
					if (marker[j] & 1) != 0 {
						if j == 1 {
							marker[1]++
						} else {
							marker[j] = marker[j - 1] << 1
						}
						break
					}
					marker[j]++
				}
				for let j = length + 1; j < 33; j++ {
					break when (marker[j] >> 1) != code
					code = marker[j]
					marker[j] = marker[j - 1] << 1
				}
			}
			zero.len(1)
			one.len(1)
			if used == 1 {
				// A book with a single entry reads it from one bit, whatever
				// the bit is.
				zero[0] = -(only + 1)
				one[0] = -(only + 1)
			} else {
				for let i = 0; i < entries; i++ {
					let length = lengths[i]
					continue when length == 0
					let node = 0
					for let b = length - 1; b >= 0; b-- {
						let bit = (codes[i] >> b) & 1
						if b == 0 {
							if bit == 0 {
								zero[node] = -(i + 1)
							} else {
								one[node] = -(i + 1)
							}
							break
						}
						let next = bit == 0 ?? (zero[node], one[node])
						if next <= 0 {
							next = zero.len()
							zero.push(0)
							one.push(0)
							if bit == 0 {
								zero[node] = next
							} else {
								one[node] = next
							}
						}
						node = next
					}
				}
			}
			fast.len(1 << vorbisFastBits)
			for let index = 0; index < fast.len(); index++ {
				let node = 0
				let result = -1
				for let depth = 0; depth < vorbisFastBits; depth++ {
					let bit = (index >> depth) & 1
					let next = bit == 0 ?? (zero[node], one[node])
					if next < 0 {
						result = ((-next - 1) << 5) | (depth + 1)
						break
					}
					if next == 0 {
						result = -1
						break
					}
					node = next
					result = -(node + 2) when depth == vorbisFastBits - 1
				}
				fast[index] = result
			}
			return none
		}

		// Reads one codeword and returns its entry, -1 at the end of the
		// packet or on a bit pattern that is no codeword.
		def decode(r VorbisBitReader) int {
			let hit = fast[r.peek(vorbisFastBits)]
			if hit > 0 {
				r.skip(hit & 31)
				return -1 when r.overrun
				return hit >> 5
			}
			return -1 when hit == -1
			r.skip(vorbisFastBits)
			let node = -(hit + 2)
			for {
				return -1 when r.overrun
				let next = r.read(1) == 0 ?? (zero[node], one[node])
				return -1 when next == 0 || r.overrun
				return -next - 1 when next < 0
				node = next
			}
			return -1
		}
	}

	// Reads a codebook from the setup header (Vorbis I §3.2.1).
	//
	// Fails when the sync pattern is missing, the codeword lengths do not
	// form a prefix code, or the book uses an unknown lookup type.
	def vorbisReadCodebook(r VorbisBitReader) !VorbisCodebook {
		fail "vorbis: bad codebook sync pattern" when r.read(24) != 0x564342
		let dims = r.read(16)
		let count = r.read(24)
		let lens int[]
		lens.len(count)
		if r.flag() {
			let entry = 0
			let length = r.read(5) + 1
			for entry < count {
				let number = r.read(vorbisIlog(count - entry))
				fail "vorbis: codebook lengths overflow its entries" when entry + number > count
				for let i = 0; i < number; i++ {
					lens[entry + i] = length
				}
				entry += number
				length++
			}
		} else {
			let sparse = r.flag()
			for let i = 0; i < count; i++ {
				lens[i] = r.read(5) + 1 when !sparse || r.flag()
			}
		}
		let book = new VorbisCodebook(dims, lens)
		let kind = r.read(4)
		book.lookupType = kind
		if kind := 1 || 2 {
			let minimum = vorbisFloat(r.read(32))
			let delta = vorbisFloat(r.read(32))
			let valueBits = r.read(4) + 1
			let sequence = r.flag()
			let lookupValues = kind == 1 ?? (vorbisLookup1Values(count, dims), count * dims)
			let multiplicands int[]
			multiplicands.len(lookupValues)
			for let i = 0; i < lookupValues; i++ {
				multiplicands[i] = r.read(valueBits)
			}
			book.unpackVectors(multiplicands, minimum, delta, sequence)
		} else if kind != 0 {
			fail "vorbis: unknown codebook lookup type {kind}"
		}
		fail "vorbis: setup header ends inside a codebook" when r.ended()
		try book.build()
		return book
	}

	// A packed Vorbis float: 21-bit mantissa, sign, 10-bit exponent biased by
	// 788 (Vorbis I §9.2.2).
	def vorbisFloat(x int) float {
		let mantissa = float(x & 0x1FFFFF)
		mantissa = -mantissa when (x & 0x80000000) != 0
		return mantissa * vorbisPow2(((x >> 21) & 0x3FF) - 788)
	}

	// Two to the power `e`, exactly.
	def vorbisPow2(e int) float {
		let result = 1.0
		let base = e < 0 ?? (0.5, 2.0)
		let k = e.abs()
		for k > 0 {
			result *= base when (k & 1) != 0
			base *= base
			k >>= 1
		}
		return result
	}

	// The greatest r whose `dimensions`-th power does not exceed `entries`
	// (Vorbis I §9.2.3).
	def vorbisLookup1Values(entries int, dimensions int) int {
		let low = 0
		let high = entries
		for low < high {
			let mid = (low + high + 1) / 2
			let p = 1
			let over = false
			for let i = 0; i < dimensions; i++ {
				p *= mid
				if p > entries {
					over = true
					break
				}
			}
			if over {
				high = mid - 1
			} else {
				low = mid
			}
		}
		return low
	}
}
