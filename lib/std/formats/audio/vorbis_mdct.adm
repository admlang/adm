internal partial module std.formats.audio.vorbis {
	use (
		std.math
		std.simd
	)

	// The modified discrete cosine transform of one Vorbis block size (Vorbis
	// I §1.3.2), computed through a DCT-IV of half the size, itself a complex
	// FFT of a quarter of the size with twiddles on either side.
	type VorbisMdct {
		// Samples per block; the block has n / 2 coefficients.
		n        int
		half     int
		quarter  int
		preCos   float[]
		preSin   float[]
		postCos  float[]
		postSin  float[]
		fftCos   float[]
		fftSin   float[]
		stageCos float[]
		stageSin float[]
		reverse  int[]
		re       float[]
		im       float[]
		u        float[]

		// The transform of blocks of `n` samples, a power of two of at least
		// 16.
		def new(n int) {
			self.n = n
			half = n / 2
			quarter = n / 4
			preCos.len(quarter)
			preSin.len(quarter)
			postCos.len(quarter)
			postSin.len(quarter)
			for let k = 0; k < quarter; k++ {
				let a = math.π * float(4 * k + 1) / float(4 * half)
				preCos[k] = math.cos(a)
				preSin[k] = math.sin(a)
				let b = math.π * float(k) / float(half)
				postCos[k] = math.cos(b)
				postSin[k] = math.sin(b)
			}
			let twiddles = quarter / 2
			twiddles = 1 when twiddles < 1
			fftCos.len(twiddles)
			fftSin.len(twiddles)
			for let j = 0; j < twiddles; j++ {
				let a = 2.0 * math.π * float(j) / float(quarter)
				fftCos[j] = math.cos(a)
				fftSin[j] = math.sin(a)
			}
			// Each stage's twiddles in a contiguous run: the stage of half
			// span `mid` at `mid - 1`.
			stageCos.len(quarter)
			stageSin.len(quarter)
			for let mid = 1; mid < quarter; mid *= 2 {
				let step = quarter / (2 * mid)
				for let j = 0; j < mid; j++ {
					stageCos[mid - 1 + j] = fftCos[j * step]
					stageSin[mid - 1 + j] = -fftSin[j * step]
				}
			}
			let bits = vorbisIlog(quarter) - 1
			reverse.len(quarter)
			for let i = 0; i < quarter; i++ {
				let r = 0
				for let b = 0; b < bits; b++ {
					r |= ((i >> b) & 1) << (bits - 1 - b)
				}
				reverse[i] = r
			}
			re.len(quarter)
			im.len(quarter)
			u.len(half)
		}

		// Transforms the n / 2 coefficients in `x` into n samples in `y`.
		def inverse(x float[], y float[]) {
			dct4(x)
			let h = half / 2
			for let i = 0; i < h; i++ {
				y[i] = u[i + h]
			}
			for let i = h; i < 3 * h; i++ {
				y[i] = -u[3 * h - 1 - i]
			}
			for let i = 3 * h; i < n; i++ {
				y[i] = -u[i - 3 * h]
			}
		}

		// Transforms the n samples in `x` into n / 2 coefficients in `y`,
		// the transpose of `inverse`.
		def forward(x float[], y float[]) {
			let h = half / 2
			let folded float[] = y
			for let j = 0; j < half; j++ {
				folded[j] = 0.0
			}
			for let i = 0; i < h; i++ {
				folded[i + h] += x[i]
			}
			for let i = h; i < 3 * h; i++ {
				folded[3 * h - 1 - i] -= x[i]
			}
			for let i = 3 * h; i < n; i++ {
				folded[i - 3 * h] -= x[i]
			}
			dct4(folded)
			for let j = 0; j < half; j++ {
				y[j] = u[j]
			}
		}

		// The DCT-IV of the n / 2 values in `x`, into `u`.
		def dct4(x float[]) {
			for let k = 0; k < quarter; k++ {
				let a = x[2 * k]
				let b = x[half - 1 - 2 * k]
				let c = preCos[k]
				let s = preSin[k]
				let at = reverse[k]
				re[at] = a * c + b * s
				im[at] = b * c - a * s
			}
			let size = 2
			for size <= quarter {
				let span = size / 2
				let step = quarter / size
				if span >= 4 {
					// Four butterflies a vector, twiddles from this stage's run of
					// the stage table.
					let w = span - 1
					for let start = 0; start < quarter; start += 2 * span {
						for let j = 0; j < span; j += 4 {
							let wr = simd.load4<float>(stageCos, w + j)
							let wi = simd.load4<float>(stageSin, w + j)
							let p = start + j
							let q = p + span
							let xr = simd.load4<float>(re, q)
							let xi = simd.load4<float>(im, q)
							let tr = xr * wr - xi * wi
							let ti = xr * wi + xi * wr
							let pr = simd.load4<float>(re, p)
							let pi = simd.load4<float>(im, p)
							simd.store4<float>(re, q, pr - tr)
							simd.store4<float>(im, q, pi - ti)
							simd.store4<float>(re, p, pr + tr)
							simd.store4<float>(im, p, pi + ti)
						}
					}
				} else {
					for let start = 0; start < quarter; start += size {
						for let j = 0; j < span; j++ {
							let wr = fftCos[j * step]
							let wi = -fftSin[j * step]
							let p = start + j
							let q = p + span
							let tr = re[q] * wr - im[q] * wi
							let ti = re[q] * wi + im[q] * wr
							re[q] = re[p] - tr
							im[q] = im[p] - ti
							re[p] += tr
							im[p] += ti
						}
					}
				}
				size *= 2
			}
			for let m = 0; m < quarter; m++ {
				let c = postCos[m]
				let s = postSin[m]
				let tr = re[m] * c + im[m] * s
				let ti = im[m] * c - re[m] * s
				u[2 * m] = tr
				u[half - 1 - 2 * m] = -ti
			}
		}
	}
}
