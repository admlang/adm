internal partial module std.formats.audio.vorbis {
	// A floor of type 1 (Vorbis I §7): the spectral envelope as a piecewise
	// line through points whose positions the setup header fixes and whose
	// heights each packet codes.
	type VorbisFloor1 {
		partitionClass  int[]
		classDimensions int[]
		classSubclasses int[]
		classMasterbook int[]
		// Per class, eight subclass books; -1 for none.
		subclassBooks   int[]
		multiplier      int
		// Height range the points take: 256, 128, 86 or 64.
		range           int
		xList           int[]
		// Point indices in ascending order of position.
		sorted          int[]
		// Per point, the nearest earlier point below and above its position.
		low             int[]
		high            int[]

		// Sorts the points and finds each one's neighbours; call once their
		// positions are read.
		def prepare() {
			let count = xList.len()
			sorted.len(count)
			for let i = 0; i < count; i++ {
				sorted[i] = i
			}
			for let i = 1; i < count; i++ {
				let v = sorted[i]
				let j = i - 1
				for j >= 0 && xList[sorted[j]] > xList[v] {
					sorted[j + 1] = sorted[j]
					j--
				}
				sorted[j + 1] = v
			}
			low.len(count)
			high.len(count)
			for let i = 2; i < count; i++ {
				let lo = 0
				let hi = 1
				let loX = -1
				let hiX = 1 << 30
				for let j = 0; j < i; j++ {
					let x = xList[j]
					if x < xList[i] && x > loX {
						loX = x
						lo = j
					}
					if x > xList[i] && x < hiX {
						hiX = x
						hi = j
					}
				}
				low[i] = lo
				high[i] = hi
			}
		}

		// Reads the point heights of one channel into `y`; false when the
		// channel is unused in this packet or the packet ends first
		// (Vorbis I §7.2.3).
		def decode(r VorbisBitReader, books VorbisCodebook[], y int[]) bool {
			return false unless r.flag()
			let bits = vorbisIlog(range - 1)
			y[0] = r.read(bits)
			y[1] = r.read(bits)
			let offset = 2
			for let (_, cls) in partitionClass {
				let dims = classDimensions[cls]
				let cbits = classSubclasses[cls]
				let csub = (1 << cbits) - 1
				let cval = 0
				if cbits > 0 {
					cval = books[classMasterbook[cls]].decode(r)
					return false when cval < 0
				}
				for let j = 0; j < dims; j++ {
					let book = subclassBooks[cls * 8 + (cval & csub)]
					cval >>= cbits
					if book >= 0 {
						let v = books[book].decode(r)
						return false when v < 0
						y[offset + j] = v
					} else {
						y[offset + j] = 0
					}
				}
				offset += dims
			}
			return !r.ended()
		}

		// Turns the heights in `y` into the curve over the `size` spectral
		// lines and multiplies `spectrum` by it (Vorbis I §7.2.4). `used` and
		// `heights` are scratch of one entry per point.
		def apply(y int[], size int, spectrum float[], used bool[], heights int[]) {
			let count = xList.len()
			used[0] = true
			used[1] = true
			heights[0] = y[0]
			heights[1] = y[1]
			for let i = 2; i < count; i++ {
				let lo = low[i]
				let hi = high[i]
				let predicted = vorbisRenderPoint(xList[lo], heights[lo], xList[hi], heights[hi], xList[i])
				let val = y[i]
				let highroom = range - predicted
				let lowroom = predicted
				let room = highroom < lowroom ?? (highroom * 2, lowroom * 2)
				if val != 0 {
					used[lo] = true
					used[hi] = true
					used[i] = true
					if val >= room {
						if highroom > lowroom {
							heights[i] = val - lowroom + predicted
						} else {
							heights[i] = predicted - val + highroom - 1
						}
					} else if (val & 1) != 0 {
						heights[i] = predicted - (val + 1) / 2
					} else {
						heights[i] = predicted + val / 2
					}
				} else {
					used[i] = false
					heights[i] = predicted
				}
			}
			let lx = 0
			let ly = heights[sorted[0]] * multiplier
			for let k = 1; k < count; k++ {
				let i = sorted[k]
				continue unless used[i]
				let hy = heights[i] * multiplier
				let hx = xList[i]
				vorbisRenderLine(lx, ly, hx, hy, spectrum, size)
				lx = hx
				ly = hy
			}
			if lx < size {
				let gain = vorbisInverseDb[ly.clamp(0, 255)]
				for let x = lx; x < size; x++ {
					spectrum[x] *= gain
				}
			}
		}
	}

	// The height at `x` on the line through (x0, y0) and (x1, y1), in
	// integers (Vorbis I §9.2.6).
	def vorbisRenderPoint(x0 int, y0 int, x1 int, y1 int, x int) int {
		let dy = y1 - y0
		let adx = x1 - x0
		let off = dy.abs() * (x - x0) / adx
		return dy < 0 ?? (y0 - off, y0 + off)
	}

	// Multiplies `v` from x0 up to x1 by the floor along the integer line
	// from (x0, y0) to (x1, y1) (Vorbis I §9.2.7), stopping at `size`.
	def vorbisRenderLine(x0 int, y0 int, x1 int, y1 int, v float[], size int) {
		let dy = y1 - y0
		let adx = x1 - x0
		let base = dy / adx
		let sy = dy < 0 ?? (base - 1, base + 1)
		let ady = dy.abs() - base.abs() * adx
		let y = y0
		let err = 0
		let end = x1 < size ?? (x1, size)
		return when x0 >= end
		v[x0] *= vorbisInverseDb[y & 255]
		for let x = x0 + 1; x < end; x++ {
			err += ady
			if err >= adx {
				err -= adx
				y += sy
			} else {
				y += base
			}
			v[x] *= vorbisInverseDb[y & 255]
		}
	}

	// Reads a floor 1 configuration from the setup header (Vorbis I
	// §7.2.2).
	//
	// Fails when it names a codebook that does not exist.
	def vorbisReadFloor1(r VorbisBitReader, bookCount int) !VorbisFloor1 {
		let floor = new VorbisFloor1()
		let partitions = r.read(5)
		let maxClass = -1
		floor.partitionClass.len(partitions)
		for let i = 0; i < partitions; i++ {
			let c = r.read(4)
			floor.partitionClass[i] = c
			maxClass = c when c > maxClass
		}
		let classes = maxClass + 1
		floor.classDimensions.len(classes)
		floor.classSubclasses.len(classes)
		floor.classMasterbook.len(classes)
		floor.subclassBooks.len(classes * 8)
		for let c = 0; c < classes; c++ {
			floor.classDimensions[c] = r.read(3) + 1
			let sub = r.read(2)
			floor.classSubclasses[c] = sub
			if sub > 0 {
				let master = r.read(8)
				fail "vorbis: floor names a missing codebook" when master >= bookCount
				floor.classMasterbook[c] = master
			}
			for let j = 0; j < 8; j++ {
				floor.subclassBooks[c * 8 + j] = -1
			}
			for let j = 0; j < (1 << sub); j++ {
				let book = r.read(8) - 1
				fail "vorbis: floor names a missing codebook" when book >= bookCount
				floor.subclassBooks[c * 8 + j] = book
			}
		}
		floor.multiplier = r.read(2) + 1
		floor.range = int[256, 128, 86, 64][floor.multiplier - 1]
		let rangeBits = r.read(4)
		floor.xList.push(0)
		floor.xList.push(1 << rangeBits)
		for let (_, c) in floor.partitionClass {
			for let j = 0; j < floor.classDimensions[c]; j++ {
				floor.xList.push(r.read(rangeBits))
			}
		}
		fail "vorbis: floor has more than 65 points" when floor.xList.len() > 65
		floor.prepare()
		return floor
	}

	// A residue configuration (Vorbis I §8): how the spectral fine structure
	// of a block is partitioned, classified and coded.
	type VorbisResidue {
		// 0, 1 or 2.
		kind            int
		start           int
		stop            int
		partitionSize   int
		classifications int
		classbook       int
		// Per classification, eight books, one per pass; -1 for none.
		books           int[]
		// Scratch: the classification of each partition, per vector.
		classes         int[]

		// Decodes the residue of the `count` vectors in `vectors` (each
		// `size` lines long) and adds it to them; vectors whose `skip` is set
		// are neither read nor changed. `interleaved` is scratch of
		// size * count values for type 2.
		def decode(r VorbisBitReader, books VorbisCodebook[], vectors float[][], skip bool[], size int, interleaved float[]) {
			let count = vectors.len()
			if kind == 2 {
				let any = false
				for let i = 0; i < count; i++ {
					any = true unless skip[i]
				}
				return unless any
				let total = size * count
				for let i = 0; i < total; i++ {
					interleaved[i] = 0.0
				}
				let one float[][]
				one.push(interleaved)
				let flags bool[]
				flags.push(false)
				decodeVectors(r, books, one, flags, total)
				for let c = 0; c < count; c++ {
					let v = vectors[c]
					let at = c
					for let i = 0; i < size; i++ {
						v[i] += interleaved[at]
						at += count
					}
				}
				return
			}
			decodeVectors(r, books, vectors, skip, size)
		}

		// The partition passes shared by all three types (Vorbis I §8.6.2).
		def decodeVectors(r VorbisBitReader, books VorbisCodebook[], vectors float[][], skip bool[], size int) {
			let count = vectors.len()
			let from = start < size ?? (start, size)
			let to = stop < size ?? (stop, size)
			let partitions = (to - from) / partitionSize
			return when partitions <= 0
			let classifier = books[classbook]
			let perWord = classifier.dimensions
			let stride = partitions + perWord
			classes.len(stride * count) when classes.len() < stride * count
			for let pass = 0; pass < 8; pass++ {
				let p = 0
				for p < partitions {
					if pass == 0 {
						for let j = 0; j < count; j++ {
							continue when skip[j]
							let temp = classifier.decode(r)
							return when temp < 0
							for let i = perWord - 1; i >= 0; i-- {
								classes[j * stride + p + i] = temp % classifications
								temp /= classifications
							}
						}
					}
					for let i = 0; i < perWord && p < partitions; i++ {
						for let j = 0; j < count; j++ {
							continue when skip[j]
							let book = self.books[classes[j * stride + p] * 8 + pass]
							continue when book < 0
							let offset = from + p * partitionSize
							if kind == 0 {
								return unless addInterleaved(r, books[book], vectors[j], offset)
							} else {
								return unless addSequential(r, books[book], vectors[j], offset)
							}
						}
						p++
					}
				}
			}
		}

		// Adds one partition coded the residue 0 way: each vector's values
		// spread across the partition a step apart. False at the end of the
		// packet.
		def addInterleaved(r VorbisBitReader, book VorbisCodebook, v float[], offset int) bool {
			let dims = book.dimensions
			let step = partitionSize / dims
			for let i = 0; i < step; i++ {
				let entry = book.decode(r)
				return false when entry < 0
				let base = entry * dims
				for let j = 0; j < dims; j++ {
					v[offset + i + j * step] += book.values[base + j]
				}
			}
			return true
		}

		// Adds one partition coded the residue 1 and 2 way: vectors one after
		// the other. False at the end of the packet.
		def addSequential(r VorbisBitReader, book VorbisCodebook, v float[], offset int) bool {
			let dims = book.dimensions
			let values = book.values
			let at = offset
			let end = offset + partitionSize
			for at < end {
				let entry = book.decode(r)
				return false when entry < 0
				let base = entry * dims
				for let j = 0; j < dims; j++ {
					v[at] += values[base + j]
					at++
				}
			}
			return true
		}
	}

	// Reads a residue configuration of the type from the setup header
	// (Vorbis I §8.6.1).
	//
	// Fails when it names a codebook that does not exist or cannot serve.
	def vorbisReadResidue(r VorbisBitReader, kind int, books VorbisCodebook[]) !VorbisResidue {
		let res = new VorbisResidue()
		res.kind = kind
		res.start = r.read(24)
		res.stop = r.read(24)
		res.partitionSize = r.read(24) + 1
		res.classifications = r.read(6) + 1
		res.classbook = r.read(8)
		fail "vorbis: residue names a missing codebook" when res.classbook >= books.len()
		let cascade int[]
		cascade.len(res.classifications)
		for let i = 0; i < res.classifications; i++ {
			let lowBits = r.read(3)
			let highBits = 0
			highBits = r.read(5) when r.flag()
			cascade[i] = highBits * 8 + lowBits
		}
		res.books.len(res.classifications * 8)
		for let i = 0; i < res.classifications; i++ {
			for let j = 0; j < 8; j++ {
				let book = -1
				if (cascade[i] & (1 << j)) != 0 {
					book = r.read(8)
					fail "vorbis: residue names a missing codebook" when book >= books.len()
					fail "vorbis: residue codebook has no vectors" when books[book].values.len() == 0
				}
				res.books[i * 8 + j] = book
			}
		}
		return res
	}

	// A channel mapping (Vorbis I §4.2.4): which floor and residue each
	// channel uses, and which channel pairs are coupled.
	type VorbisMapping {
		submaps       int
		// Per channel, its submap.
		mux           int[]
		submapFloor   int[]
		submapResidue int[]
		magnitude     int[]
		angle         int[]
	}

	// Reads a mapping configuration from the setup header.
	//
	// Fails when it names a channel, floor or residue that does not exist.
	def vorbisReadMapping(r VorbisBitReader, channels int, floors int, residues int) !VorbisMapping {
		let m = new VorbisMapping()
		fail "vorbis: unknown mapping type" when r.read(16) != 0
		m.submaps = 1
		m.submaps = r.read(4) + 1 when r.flag()
		if r.flag() {
			let steps = r.read(8) + 1
			let bits = vorbisIlog(channels - 1)
			for let i = 0; i < steps; i++ {
				let mag = r.read(bits)
				let ang = r.read(bits)
				fail "vorbis: bad channel coupling" when mag == ang || mag >= channels || ang >= channels
				m.magnitude.push(mag)
				m.angle.push(ang)
			}
		}
		fail "vorbis: reserved mapping bits set" when r.read(2) != 0
		m.mux.len(channels)
		if m.submaps > 1 {
			for let c = 0; c < channels; c++ {
				m.mux[c] = r.read(4)
				fail "vorbis: mapping names a missing submap" when m.mux[c] >= m.submaps
			}
		}
		m.submapFloor.len(m.submaps)
		m.submapResidue.len(m.submaps)
		for let i = 0; i < m.submaps; i++ {
			r.read(8)
			m.submapFloor[i] = r.read(8)
			m.submapResidue[i] = r.read(8)
			fail "vorbis: mapping names a missing floor" when m.submapFloor[i] >= floors
			fail "vorbis: mapping names a missing residue" when m.submapResidue[i] >= residues
		}
		return m
	}

	// A mode (Vorbis I §4.2.4): the block size and mapping a packet uses.
	struct VorbisMode {
		long    bool
		mapping int
	}
}
