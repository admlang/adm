internal partial module std.formats.audio.wav {
	use (
		std.io
		std.bytes
		std.os
		std.formats.audio::*
	)

	// Largest LIST or `cue ` chunk read for metadata; bigger ones are skipped.
	const wavMaxMetaChunk = 16 * 1024 * 1024

	// Whether the reader is one `wavSeek` can move: `bytes.Reader`,
	// `bytes.Buffer` or `os.File`.
	def wavCanSeek(reader io.Reader) bool {
		let r any = reader
		return r is bytes.Reader || r is bytes.Buffer || r is os.File
	}

	// Moves a reader `wavCanSeek` accepts and returns the position `os.File`
	// reports (0 for the byte readers, which report none).
	// Fails when the reader cannot seek there, or is not one it can move.
	def wavSeek(reader io.Reader, offset int64, whence bytes.Whence) !int64 {
		let r any = reader
		if r is os.File {
			let file os.File = r
			return file.seek(offset, whence)
		}
		if r is bytes.Reader {
			let br bytes.Reader = r
			return int64(try br.seek(int(offset), whence))
		}
		if r is bytes.Buffer {
			let buffer bytes.Buffer = r
			return int64(try buffer.seek(int(offset), whence))
		}
		fail "wav: the reader cannot seek"
	}

	// What the chunks before the audio say: the sample layout, where the
	// audio starts and how long it is, and the metadata.
	type WAVHeader {
		info       AudioInfo
		tags       map<string, string>
		cues       WAVCue[]
		bigEndian  bool
		// Effective format tag, the sub-format's for WAVE_FORMAT_EXTENSIBLE.
		tag        int
		// Bytes per sample as stored, and per frame.
		bytesPer   int
		blockAlign int
		// Bytes of audio, -1 when the file does not say and it runs to the end.
		dataSize   int64
		// Offset of the first audio byte from where the reader began, and the
		// reader's own position at that point when it can seek.
		dataStart  int64
		base       int64
		// The audio when it came before `fmt ` and had to be read to get there.
		held       byte[]
		holding    bool

		pos      int64
		rf64     bool
		ds64Data int64
		riffSize int64
		haveFmt  bool
		labels   map<uint32, string>
		scratch  byte[]

		def new() {
			tags = new map<string, string>()
			labels = new map<uint32, string>()
			dataSize = -1
			ds64Data = -1
		}

		// Reads the chunks up to the start of the audio data.
		// Fails when the reader does not hold a WAV file, the file uses an
		// encoding this codec lacks, or the headers are cut short.
		def read(reader io.Reader) !none {
			base = try wavSeek(reader, 0, bytes.Whence.Current) when wavCanSeek(reader)

			let head = try take(reader, 12)
			let id = string(head[0:4])
			fail "wav: not a RIFF WAVE file" unless id := "RIFF" || "RIFX" || "RF64" || "BW64"
			fail "wav: not a RIFF WAVE file" unless string(head[8:12]) == "WAVE"
			bigEndian = id == "RIFX"
			rf64 = id := "RF64" || "BW64"
			riffSize = u32(head, 4)

			for {
				let chunk = try takeOrEnd(reader, 8)
				break when chunk.len() == 0
				let cid = string(chunk[0:4])
				let size = u32(chunk, 4)

				if cid == "data" {
					let known = dataLength(size)
					if haveFmt {
						dataSize = known
						dataStart = pos
						return conclude(reader)
					}
					fail "wav: the data chunk precedes fmt and has no length" when known < 0
					held = try take(reader, int(known))
					holding = true
					try skip(reader, known % 2)
					continue
				}

				if cid == "fmt " {
					fail "wav: more than one fmt chunk" when haveFmt
					try parseFmt(try take(reader, int(size)))
					haveFmt = true
				} else if cid == "ds64" && size >= 16 {
					let p = try take(reader, int(size))
					ds64Data = u64(p, 8)
				} else if (cid == "LIST" || cid == "cue ") && size <= wavMaxMetaChunk {
					let p = try take(reader, int(size))
					if cid == "LIST" {
						parseList(p)
					} else {
						parseCues(p)
					}
				} else {
					try skip(reader, size)
				}
				try skip(reader, size % 2)
			}

			fail "wav: no fmt chunk" unless haveFmt
			fail "wav: no data chunk" unless holding
			dataSize = int64(held.len())
			dataStart = 0
			base = 0
			return conclude(reader)
		}

		// The length a `data` chunk's size field gives, reading the `ds64`
		// value for RF64 and -1 for the sizes streaming writers leave behind.
		def dataLength(size int64) int64 {
			if size == 0xFFFFFFFF {
				return ds64Data when rf64 && ds64Data >= 0
				return -1
			}
			return -1 when size == 0 && (riffSize == 0 || riffSize == 0xFFFFFFFF)
			return size
		}

		// Fills in what depends on the whole header: frame count, length,
		// labels on cues and whether the stream can seek.
		def conclude(reader io.Reader) !none {
			for let (i, cue) in cues {
				let label = labels.get(cue.id)
				continue when label is none
				cues[i].label = label
			}
			if dataSize >= 0 {
				info.frames = uint64(dataSize / int64(blockAlign))
				info.length = duration(int64(info.frames) * 1000000000 / int64(info.sampleRate)) when info.sampleRate > 0
			}
			info.seekable = holding || wavCanSeek(reader)
			return none
		}

		// Reads the `fmt ` chunk into the layout and `info`.
		// Fails when the chunk is too short or describes an encoding this codec
		// lacks.
		def parseFmt(p byte[]) !none {
			expects {
				assert p.len() >= 16 onerror fail "wav: the fmt chunk is too short"
			}
			tag = int(u16(p, 0))
			let channels = int(u16(p, 2))
			let rate = u32(p, 4)
			let align = int(u16(p, 12))
			let bits = int(u16(p, 14))
			let validBits = 0
			if tag == wavTagExtensible {
				fail "wav: the extensible fmt chunk is too short" when p.len() < 40
				validBits = int(u16(p, 18))
				tag = int(u32(p, 24) & 0xFFFF)
			}
			fail "wav: the file has no channels" when channels == 0
			fail "wav: the sample rate is 0" when rate == 0

			let container = 0
			if align > 0 && align % channels == 0 {
				container = align / channels
			} else {
				container = (bits + 7) / 8
			}
			bits = container * 8 when bits == 0
			let depth = validBits > 0 && validBits <= bits ?? (validBits, bits)

			if tag == wavTagPCM {
				fail "wav: unsupported PCM sample size of {bits} bits in {container} bytes" when container < 1 || container > 4 || bits > container * 8
				if container == 1 {
					info.format = SampleFormat.Uint8
				} else if container == 2 {
					info.format = SampleFormat.Int16
				} else if container == 3 {
					info.format = SampleFormat.Int24
				} else {
					info.format = SampleFormat.Int32
				}
			} else if tag == wavTagFloat {
				fail "wav: unsupported float sample size of {bits} bits" unless container := 4 || 8
				info.format = container == 4 ?? (SampleFormat.Float32, SampleFormat.Float64)
			} else if tag == wavTagALaw || tag == wavTagMuLaw {
				fail "wav: A-law and µ-law samples must be 8 bits" when container != 1
				info.format = SampleFormat.Int16
				depth = 8
			} else {
				fail "wav: unsupported encoding (format tag {tag})"
			}

			bytesPer = container
			blockAlign = container * channels
			info.sampleRate = uint32(rate)
			info.channels = uint16(channels)
			info.bitDepth = uint16(depth)
			info.codec = "wav"
			info.bitrate = uint32((rate * int64(blockAlign) * 8).min(0xFFFFFFFF))
			return none
		}

		// Reads a LIST chunk: INFO entries into `tags`, adtl labels into `labels`.
		def parseList(p byte[]) {
			return when p.len() < 4
			let kind = string(p[0:4])
			let off = 4
			for off + 8 <= p.len() {
				let sid = string(p[off:off + 4])
				let size = int(u32(p, off + 4))
				off += 8
				let end = (off + size).min(p.len())
				let body = p[off:end]
				if kind == "INFO" {
					tags.set(sid, wavText(body))
				} else if kind == "adtl" && sid == "labl" && body.len() >= 4 {
					labels.set(uint32(u32(body, 0)), wavText(body[4:]))
				}
				off = end + size % 2
			}
		}

		// Reads a `cue ` chunk into `cues`.
		def parseCues(p byte[]) {
			return when p.len() < 4
			let count = int(u32(p, 0))
			for let i = 0; i < count && 4 + (i + 1) * 24 <= p.len(); i++ {
				let o = 4 + i * 24
				cues.push(WAVCue{id: uint32(u32(p, o)), frame: uint64(u32(p, o + 20)), label: ""})
			}
		}

		// Reads exactly `n` bytes.
		// Fails when the reader does or ends first.
		def take(reader io.Reader, n int) !byte[] {
			let b byte[]
			b.len(n)
			let got = 0
			for got < n {
				let r = try reader.read(b[got:])
				fail "wav: the file is cut short" when r == 0
				got += r
			}
			pos += int64(n)
			return b
		}

		// Reads exactly `n` bytes, or none when the reader is already at its end.
		// Fails when the reader does or ends part way.
		def takeOrEnd(reader io.Reader, n int) !byte[] {
			let b byte[]
			b.len(n)
			let got = 0
			for got < n {
				let r = try reader.read(b[got:])
				if r == 0 {
					return byte[] when got == 0
					fail "wav: the file is cut short"
				}
				got += r
			}
			pos += int64(n)
			return b
		}

		// Reads and drops `n` bytes.
		// Fails when the reader does or ends first.
		def skip(reader io.Reader, n int64) !none {
			return none when n <= 0
			scratch.len(8192) when scratch.len() == 0
			let left = n
			for left > 0 {
				let want = int(left.min(int64(scratch.len())))
				let r = try reader.read(scratch[:want])
				fail "wav: the file is cut short" when r == 0
				left -= int64(r)
			}
			pos += n
			return none
		}

		def u16(b byte[], o int) int64 {
			return bigEndian ?? (int64(b[o]) << 8 | int64(b[o + 1]), int64(b[o]) | int64(b[o + 1]) << 8)
		}

		def u32(b byte[], o int) int64 {
			return int64(b[o]) << 24 | int64(b[o + 1]) << 16 | int64(b[o + 2]) << 8 | int64(b[o + 3]) when bigEndian
			return int64(b[o]) | int64(b[o + 1]) << 8 | int64(b[o + 2]) << 16 | int64(b[o + 3]) << 24
		}

		def u64(b byte[], o int) int64 {
			let lo = u32(b, o)
			let hi = u32(b, o + 4)
			return bigEndian ?? (lo << 32 | hi, hi << 32 | lo)
		}
	}

	// The text of a metadata entry: its bytes up to the first NUL.
	def wavText(b byte[]) string {
		let end = b.len()
		for let i = 0; i < b.len(); i++ {
			if b[i] == 0 {
				end = i
				break
			}
		}
		return string(b[0:end])
	}
}
