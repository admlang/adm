internal partial module std.formats.audio.wav {
	use (
		std.io
		std.bytes
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	// The lazy decoder `WAV.open` returns: reads the audio data as frames are
	// asked for and converts them to float32.
	type WAVStream {
		// The frame the next read starts at.
		framePosition uint64

		reader    io.Reader
		source    io.Reader
		header    WAVHeader
		// Bytes of audio left, -1 when the stream runs to the reader's end.
		remaining int64
		raw       byte[]
		// Sample values of the 256 A-law or µ-law codes.
		table     float32[]
		closed    bool

		def new(reader io.Reader, header WAVHeader) {
			self.header = header
			source = reader
			self.reader = header.holding ?? (new bytes.Reader(header.held), reader)
			remaining = header.dataSize
			if header.tag == wavTagALaw || header.tag == wavTagMuLaw {
				table.len(256)
				for let i = 0; i < 256; i++ {
					let v = header.tag == wavTagALaw ?? (wavALaw(i), wavMuLaw(i))
					table[i] = float32(v) / 32768.0
				}
			}
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return header.info
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream: fills `buf` with interleaved frames and
		// returns how many, 0 at the end of the data. A frame cut short by the
		// end of the file is dropped.
		// Fails when the stream is closed or the reader fails.
		def readFrames(buf float32[]) !int {
			fail "wav: the stream is closed" when closed
			let channels = int(header.info.channels)
			let align = header.blockAlign
			let want = buf.len() / channels
			want = int(int64(want).min(remaining / int64(align))) when remaining >= 0
			return 0 when want <= 0

			let size = want * align
			raw.len(size) when raw.len() < size
			let got = 0
			for got < size {
				let n = try reader.read(raw[got:size])
				break when n == 0
				got += n
			}
			let frames = got / align
			if got < size {
				remaining = 0
			} else if remaining >= 0 {
				remaining -= int64(size)
			}
			convert(buf, frames * channels)
			return frames
		}

		// Converts `count` samples from `raw` into `buf`.
		def convert(buf float32[], count int) {
			let big = header.bigEndian
			let tag = header.tag
			let width = header.bytesPer
			if tag == wavTagALaw || tag == wavTagMuLaw {
				for let i = 0; i < count; i++ {
					buf[i] = table[int(raw[i])]
				}
			} else if tag == wavTagFloat && width == 4 {
				let (b0, b1, b2, b3) = big ?? ((3, 2, 1, 0), (0, 1, 2, 3))
				for let i = 0; i < count; i++ {
					let o = i * 4
					let bits = uint32(raw[o + b0]) | uint32(raw[o + b1]) << 8 | uint32(raw[o + b2]) << 16 | uint32(raw[o + b3]) << 24
					buf[i] = __bitcast_f32_from_u32(bits)
				}
			} else if tag == wavTagFloat {
				for let i = 0; i < count; i++ {
					let o = i * 8
					let bits uint64 = 0
					for let k = 0; k < 8; k++ {
						let at = big ?? (o + 7 - k, o + k)
						bits = bits | uint64(raw[at]) << uint64(k * 8)
					}
					buf[i] = float32(__bitcast_f64_from_u64(bits))
				}
			} else if width == 1 {
				for let i = 0; i < count; i++ {
					buf[i] = float32(int(raw[i]) - 128) / 128.0
				}
			} else if width == 2 {
				let (b0, b1) = big ?? ((1, 0), (0, 1))
				for let i = 0; i < count; i++ {
					let o = i * 2
					let v = (int(raw[o + b0]) | int(raw[o + b1]) << 8) << 48 >> 48
					buf[i] = float32(v) / 32768.0
				}
			} else if width == 3 {
				let (b0, b1, b2) = big ?? ((2, 1, 0), (0, 1, 2))
				for let i = 0; i < count; i++ {
					let o = i * 3
					let v = (int(raw[o + b0]) | int(raw[o + b1]) << 8 | int(raw[o + b2]) << 16) << 40 >> 40
					buf[i] = float32(v) / 8388608.0
				}
			} else {
				let (b0, b1, b2, b3) = big ?? ((3, 2, 1, 0), (0, 1, 2, 3))
				for let i = 0; i < count; i++ {
					let o = i * 4
					let v = (int(raw[o + b0]) | int(raw[o + b1]) << 8 | int(raw[o + b2]) << 16 | int(raw[o + b3]) << 24) << 32 >> 32
					buf[i] = float32(float64(v) / 2147483648.0)
				}
			}
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream: the next read starts at `frame`.
		// Fails when the stream is closed, cannot seek, the frame lies past the
		// end, or the reader's seek fails.
		def seekFrame(frame uint64) !none {
			fail "wav: the stream is closed" when closed
			fail "wav: the stream cannot seek" unless header.info.seekable
			fail "wav: frame {frame} is past the end ({header.info.frames} frames)" when header.dataSize >= 0 && frame > header.info.frames
			let offset = int64(frame) * int64(header.blockAlign)
			let target = header.base + header.dataStart + offset
			try wavSeek(reader, target, bytes.Whence.Start)
			remaining = -1
			remaining = header.dataSize - offset when header.dataSize >= 0
			return none
		}

		// close implements io.Closer, closing the reader when it is an
		// `io.Closer`. Closing twice does nothing.
		// Fails when closing the reader does.
		def close() !none {
			return none when closed
			closed = true
			let r any = source
			if r is io.Closer {
				let closer io.Closer = r
				try closer.close()
			}
			return none
		}
	}

	// The 16-bit value of an A-law code (ITU-T G.711).
	def wavALaw(code int) int {
		let a = code ^ 0x55
		let t = a & 0x0F
		let seg = (a & 0x70) >> 4
		if seg > 0 {
			t = (t + t + 1 + 32) << (seg + 2)
		} else {
			t = (t + t + 1) << 3
		}
		return (a & 0x80) != 0 ?? (t, -t)
	}

	// The 16-bit value of a µ-law code (ITU-T G.711).
	def wavMuLaw(code int) int {
		let u = code ^ 0xFF
		let t = ((u & 0x0F) << 3) + 0x84
		t = t << ((u & 0x70) >> 4)
		return (u & 0x80) != 0 ?? (0x84 - t, t - 0x84)
	}
}
