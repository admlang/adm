		internal def tag(codec WAV, id string) string {
			let text = codec.tags.get(id)
			return "" when text is none
			return text
		}

		internal def near(got float32, want float, tolerance float = 0.000001) bool {
			let d = float(got) - want
			return d <= tolerance && d >= -tolerance
		}

		// Every sample of the stream, read in small blocks.
		internal def readAll(stream AudioStream) !float32[] {
			let ch = int(stream.info().channels)
			let buf float32[]
			buf.len(5 * ch)
			let out float32[]
			for {
				let n = try stream.read(buf)
				break when n == 0
				for let i = 0; i < n * ch; i++ {
					out.push(buf[i])
				}
			}
			return out
		}

		internal def decode(data byte[]) !float32[] {
			let stream = try new WAV().open(data)
			let samples = readAll(stream) onerror (err error) {
				stream.close() onerror recover none
				fail err
			}
			try stream.close()
			return samples
		}

		// Checks the samples ffmpeg decodes at indexes 0, 1, 7, 18, 33 and 47.
		internal def matches(name string, want float32[]) !bool {
			let got = try decode(fixture(name))
			fail "{name}: {got.len()} samples" when got.len() != 48
			let indexes = int[0, 1, 7, 18, 33, 47]
			for let (i, index) in indexes {
				fail "{name}: sample {index} is {got[index]}, ffmpeg has {want[i]}" unless near(got[index], float(want[i]))
			}
			return true
		}

		@test()
		def TestDecodesEveryLayout() !none {
			let s16 = float32[0, -0.399993896, 0.624267578, 0.0282592773, -0.399993896, -0.224273682]
			let s24 = float32[0, -0.400000095, 0.624264002, 0.0282696486, -0.400000095, -0.224264145]
			let fl = float32[0, -0.400000006, 0.624264061, 0.0282696839, -0.400000006, -0.22426407]
			assert try matches("pcm_u8", float32[0, -0.3984375, 0.625, 0.03125, -0.3984375, -0.2265625])
			assert try matches("pcm_s16le", s16)
			assert try matches("pcm_s24le", s24)
			assert try matches("pcm_s32le", float32[0, -0.400000006, 0.624264061, 0.0282696821, -0.400000006, -0.22426407])
			assert try matches("pcm_f32le", fl)
			assert try matches("pcm_f64le", fl)
			assert try matches("pcm_alaw", float32[0.000244140625, -0.3984375, 0.609375, 0.0278320312, -0.3984375, -0.22265625])
			assert try matches("pcm_mulaw", float32[0, -0.39440918, 0.63659668, 0.0281982422, -0.39440918, -0.22644043])
			assert try matches("rf64", s16)
			assert try matches("rifx16", s16)
			assert try matches("rifx24", s24)
			assert try matches("datafirst", s16)
			assert try matches("tagged", s16)
			assert try matches("three", float32[0, 0.25, 0.25, 0.493835449, 0.261260986, -0.140625])
			return none
		}

		@test()
		def TestInfo() !none {
			let codec = new WAV()
			let info = try codec.info(fixture("pcm_s24le"))
			assert info.sampleRate == 8000 && info.channels == 2
			assert info.bitDepth == 24 && info.format == SampleFormat.Int24
			assert info.frames == 24 && info.length == 3ms
			assert info.codec == "wav" && info.bitrate == 8000 * 6 * 8
			assert codec.format == SampleFormat.Int24

			let three = try codec.info(fixture("three"))
			assert three.channels == 3 && three.frames == 16

			let law = try codec.info(fixture("pcm_mulaw"))
			assert law.bitDepth == 8 && law.format == SampleFormat.Int16
			let f64 = try codec.info(fixture("pcm_f64le"))
			assert f64.format == SampleFormat.Float64 && f64.bitDepth == 64
			let u8 = try codec.info(fixture("pcm_u8"))
			assert u8.format == SampleFormat.Uint8
			return none
		}

		@test()
		def TestTagsAndCues() !none {
			for let (_, name) in string["tagged", "datafirst"] {
				let codec = new WAV()
				let stream = try codec.open(fixture(name))
				assert stream.info().frames == 24
				assert tag(codec, "INAM") == "Tone"
				assert tag(codec, "IART") == "ADM Tests"
				assert codec.cues.len() == 2
				assert codec.cues[0].id == 1 && codec.cues[0].frame == 3 && codec.cues[0].label == "start"
				assert codec.cues[1].id == 2 && codec.cues[1].frame == 20 && codec.cues[1].label == "end"
			}
			return none
		}

		@test()
		def TestSeek() !none {
			for let (_, name) in string["pcm_s16le", "datafirst", "rifx16"] {
				let stream = try new WAV().open(fixture(name))
				assert stream.info().seekable
				let buf float32[]
				buf.len(2)
				try stream.seek(16)
				assert try stream.read(buf) == 1
				assert near(buf[1], -0.399993896)
				try stream.seek(23)
				assert try stream.read(buf) == 1
				assert near(buf[1], -0.224273682)
				assert try stream.read(buf) == 0
				try stream.seek(0)
				assert try stream.read(buf) == 1
				assert buf[0] == 0.0
				let past = stream.seek(25)
				assert past is error
			}
			return none
		}

		@test()
		def TestUnknownDataLength() !none {
			let data = fixture("pcm_s16le")
			data[40], data[41], data[42], data[43] = byte(0xFF), byte(0xFF), byte(0xFF), byte(0xFF)
			let stream = try new WAV().open(data)
			assert stream.info().frames == 0
			assert (try readAll(stream)).len() == 48
			return none
		}

		@test()
		def TestTruncated() !none {
			let data = fixture("pcm_s16le")
			let header = new WAV().open(data[:30])
			assert header is error
			let noData = new WAV().open(data[:40])
			assert noData is error
			// The header claims 96 bytes of audio that are not there: the
			// stream opens and ends at once.
			assert (try decode(data[:44])).len() == 0
			let cut = try decode(data[:data.len() - 5])
			assert cut.len() == 44
			let info = new WAV().info(data[:20])
			assert info is error
		}

		@test()
		def TestSignature() {
			let codec = new WAV()
			assert codec.matchSignature(new bytes.Reader(fixture("pcm_s16le")))
			assert codec.matchSignature(new bytes.Reader(fixture("rifx16")))
			assert codec.matchSignature(new bytes.Reader(fixture("rf64")))
			assert !codec.matchSignature(new bytes.Reader("RIFF\x00\x00\x00\x00AVI LIST".bytes()))
			assert !codec.matchSignature(new bytes.Reader("RIFF".bytes()))
			assert !codec.matchSignature(new bytes.Reader("ID3 not a wave file".bytes()))
			let avi = new WAV().open("RIFF\x00\x00\x00\x00AVI LIST".bytes())
			assert avi is error
		}

		@test()
		def TestUnsupportedEncoding() {
			let data = fixture("pcm_s16le")
			// Format tag 2, Microsoft ADPCM.
			data[20] = byte(2)
			let stream = new WAV().open(data)
			assert stream is error
		}

		// A two-channel ramp with full-scale ends, a clipped value and a few
		// values between integer steps.
		internal def ramp() float32[] {
			let out float32[]
			for let i = 0; i < 1001; i++ {
				let v = float32(i - 500) / 500.0
				out.push(v)
				out.push(-v * 0.3)
			}
			out.push(float32(1.5))
			out.push(float32(-1.5))
			return out
		}

		internal def roundTrip(format SampleFormat, bits int, tolerance float) !bool {
			let codec = new WAV()
			codec.format = format
			let source = ramp()
			let data = try codec.encode(new WAVTestStream(source, 2, 22050))
			fail "{format}: bits {int(data[34])}" when int(data[34]) != bits
			let decoder = new WAV()
			let stream = try decoder.open(data)
			let info = stream.info()
			fail "{format}: decoded as {info.format}" when info.format != format
			fail "{format}: {info.frames} frames" when info.frames != 1002 || info.sampleRate != 22050
			let got = try readAll(stream)
			fail "{format}: {got.len()} samples" when got.len() != source.len()
			for let i = 0; i < source.len() - 2; i++ {
				fail "{format}: sample {i} is {got[i]}, wrote {source[i]}" unless near(got[i], float(source[i]), tolerance)
			}
			let last = got.len() - 2
			let clipped = format == SampleFormat.Float32 || format == SampleFormat.Float64 ?? (1.5, 1.0)
			fail "{format}: clipped to {got[last]}" unless near(got[last], clipped, tolerance * 2.0)
			return true
		}

		@test()
		def TestRoundTrip() !none {
			assert try roundTrip(SampleFormat.Uint8, 8, 0.0079)
			assert try roundTrip(SampleFormat.Int16, 16, 0.00004)
			assert try roundTrip(SampleFormat.Int24, 24, 0.0000002)
			assert try roundTrip(SampleFormat.Int32, 32, 0.0000001)
			assert try roundTrip(SampleFormat.Float32, 32, 0.0)
			assert try roundTrip(SampleFormat.Float64, 64, 0.0)
			return none
		}

		@test()
		def TestEncodesHeader() !none {
			let data = try new WAV().encode(new WAVTestStream(float32[0.5, -0.5, 0.25], 1, 44100))
			assert string(data[0:4]) == "RIFF" && string(data[8:16]) == "WAVEfmt "
			// RIFF size, then the plain 16-byte fmt chunk: PCM, mono, 44100, 16 bits.
			assert int(data[4]) == data.len() - 8
			assert int(data[16]) == 16 && int(data[20]) == 1 && int(data[22]) == 1
			assert int(data[34]) == 16
			// Six bytes of audio, no pad.
			assert string(data[36:40]) == "data" && int(data[40]) == 6 && data.len() == 50

			// Eight-bit mono with an odd frame count carries a pad byte.
			let codec = new WAV()
			codec.format = SampleFormat.Uint8
			let odd = try codec.encode(new WAVTestStream(float32[0.5, -0.5, 0.25], 1, 8000))
			assert int(odd[40]) == 3 && odd.len() == 48 && int(odd[4]) == 40

			// Four channels use WAVE_FORMAT_EXTENSIBLE with the quad speaker mask.
			let quad = try new WAV().encode(new WAVTestStream(float32[0, 0, 0, 0], 4, 8000))
			assert int(quad[16]) == 40 && int(quad[20]) == 0xFE && int(quad[21]) == 0xFF
			assert int(quad[40]) == 0x33 && int(quad[44]) == 1
			return none
		}

		@test()
		def TestEncodesTagsAndCues() !none {
			let codec = new WAV()
			codec.tags.set("INAM", "Ramp")
			codec.tags.set("ICMT", "odd")
			codec.cues.push(WAVCue{id: 7, frame: 100, label: "mark"})
			codec.cues.push(WAVCue{id: 9, frame: 900, label: ""})
			let data = try codec.encode(new WAVTestStream(ramp(), 2, 8000))

			let back = new WAV()
			let got = try readAll(try back.open(data))
			assert got.len() == 2004
			assert tag(back, "INAM") == "Ramp" && tag(back, "ICMT") == "odd"
			assert back.cues.len() == 2
			assert back.cues[0].id == 7 && back.cues[0].frame == 100 && back.cues[0].label == "mark"
			assert back.cues[1].id == 9 && back.cues[1].frame == 900 && back.cues[1].label == ""
			return none
		}

		@test()
		def TestEncodesToFile() !none {
			let path = "/tmp/adm-wav-" + time.now().unixNs().str() + ".wav"
			let codec = new WAV()
			codec.format = SampleFormat.Int24
			let out = try os.open(path, "w")
			try codec.encode(new WAVTestStream(ramp(), 2, 8000), out)
			try out.close()

			let expected = try codec.encode(new WAVTestStream(ramp(), 2, 8000))
			let written = try os.readFile(path)
			let stream = try open(path)
			let info = stream.info()
			let got = try readAll(stream)
			try stream.close()
			try os.remove(path)
			// The patched header reserves a JUNK chunk for a later ds64.
			assert written.len() == expected.len() + 36
			assert string(written[12:16]) == "JUNK"
			assert info.frames == 1002 && info.format == SampleFormat.Int24
			assert got.len() == 2004 && near(got[2], -0.998, 0.0000002)
			return none
		}

		@test()
		def TestRegistry() !none {
			let loaded = try load(fixture("pcm_s16le"))
			assert loaded.info.frames == 24 && loaded.samples.len() == 48
			assert near(loaded.samples[7], 0.624267578)
			let info = try info(new bytes.Reader(fixture("pcm_f32le")))
			assert info.format == SampleFormat.Float32

			let out = new bytes.Buffer()
			try write(new WAVTestStream(ramp(), 2, 8000), out, ".wav")
			let back = try load(out.bytes())
			assert back.info.frames == 1002
			return none
		}

		// Checks a stream against ffmpeg: rate, channels, sample count, the sum
		// of magnitudes and one sample.
		internal def measure(stream AudioStream, name string, rate int, channels int, samples int, magnitude float, index int, value float) !none {
			let info = stream.info()
			fail "{name}: {info.sampleRate} Hz x {info.channels}" when int(info.sampleRate) != rate || int(info.channels) != channels
			fail "{name}: header says {info.frames} frames" when int(info.frames) * channels != samples
			let buf float32[]
			buf.len(8192 * channels)
			let total = 0
			let sum float = 0
			let seen float32 = 99
			for {
				let n = try stream.read(buf)
				break when n == 0
				let count = n * channels
				for let i = 0; i < count; i++ {
					let v = buf[i]
					sum += v < 0.0 ?? (-float(v), float(v))
				}
				seen = buf[index - total] when index >= total && index < total + count
				total += count
			}
			fail "{name}: {total} samples, ffmpeg has {samples}" when total != samples
			fail "{name}: magnitude {sum}, ffmpeg has {magnitude}" when (sum - magnitude) > 0.01 || (magnitude - sum) > 0.01
			fail "{name}: sample {index} is {seen}, ffmpeg has {value}" unless near(seen, value)
			return none
		}

		// Decodes a sample file in blocks through the registry and checks it
		// against ffmpeg. A missing file passes.
		internal def checkSample(name string, rate int, channels int, samples int, magnitude float, index int, value float) !none {
			let path = sampleDir + name
			let exists = os.exists(path) onerror recover false
			return none unless exists
			let stream = try open(path)
			let result = measure(stream, name, rate, channels, samples, magnitude, index, value)
			try stream.close()
			return result
		}

		@test()
		def TestSampleFiles() !none {
			try checkSample("sample-file-1.wav", 44100, 2, 10597274, 499762.273621, 3532424, -0.170928955)
			try checkSample("sample-file-2.wav", 44100, 2, 5284440, 232146.986664, 1761480, -0.0270690918)
			try checkSample("sample-file-3.wav", 44100, 2, 1738800, 71407.195618, 579600, 0.029876709)
			try checkSample("wav_15s_sample_file_1.3MB.wav", 44100, 1, 661500, 19652.321411, 12345, 0.0122680664)
			try checkSample("wav_30s_sample_file_2.5MB.wav", 44100, 1, 1323000, 40708.369995, 12345, 0.0122680664)
			try checkSample("wav_5s_sample_file_431KB.wav", 44100, 1, 220500, 5614.955688, 73500, 0.0433044434)
			try checkSample("wav_60s_sample_file_5.0MB.wav", 44100, 1, 2646000, 82820.467163, 12345, 0.0122680664)
			// Not a WAV file despite its name: plain text.
			let fake = sampleDir + "sample_background_music.wav"
			let present = os.exists(fake) onerror recover false
			if present {
				let stream = open(fake)
				assert stream is error
			}
			return none
		}
	}
}
