partial module std.formats.audio {
	use (
		std.io
		std.bytes
		std.formats.audio.asf::*
		std.formats.audio.wma::*
	)

	// WMA is the Windows Media Audio codec: WMA v1 and v2 audio in an ASF
	// (Advanced Systems Format) file.
	//
	// It decodes the first audio stream of the file; v1 (format tag 0x0160)
	// and v2 (0x0161) streams with any of the codec's options: bit reservoir,
	// variable block sizes, LSP or Huffman exponents, noise coding and
	// mid/side stereo. Samples line up with other common decoders: the first
	// two frames of the transform's warm-up are dropped, and the frame still
	// held when the stream ends is returned.
	//
	// It encodes WMA v2 at `bitrate`, mono or stereo up to 48 kHz, with the
	// `tags` it holds.
	//
	// `open` and `info` fill `tags` from the file, so the same instance
	// encodes back what it read.
	@codec("WMA")
	type WMA {
		// Bits per second `encode` aims for, 24000 or more. Each channel
		// needs at least 12000 at the stream's rate; lower requests are
		// raised to that.
		bitrate int                 = 128000
		// Text tags by name. "Title", "Author", "Copyright", "Description"
		// and "Rating" are the Content Description fields; any other name
		// ("WM/AlbumTitle", "WM/Genre", "WM/Year", "WM/TrackNumber") is an
		// Extended Content Description entry, written back as text. Binary
		// entries such as cover art are not kept.
		tags    map<string, string>

		def new() {
			tags = new map<string, string>()
		}

		mimeType string[] {
			def get() string[] {
				return string["audio/x-ms-wma", "video/x-ms-asf"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".wma", ".asf"]
			}
		}

		// matchSignature reports whether the reader starts with an ASF
		// Header Object.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(16)
			let n = io.readFull(r, b) onerror recover 0
			return n == 16 && asfIsGuid(b, 0, asfHeaderObject)
		}

		// open reads the ASF header and returns a stream that decodes the
		// audio as it is read. The stream seeks when the reader can
		// (`bytes.Reader`, `os.File`). Closing the stream closes the reader
		// when it is an `io.Closer`.
		// Fails when the reader does not hold an ASF file with a WMA v1 or v2
		// stream, or the header is cut short.
		// Fails too when `live` is set: the codec needs the whole file.
		def open(reader io.Reader, live bool = false) !AudioStream {
			fail "wma: a live stream cannot be decoded" when live
			let header = new ASFHeader()
			try header.read(reader)
			tags = header.tags
			let stream = new WMAStream(reader, header)
			try stream.validate()
			return stream
		}

		// open decodes the WMA file held in the bytes as a stream.
		// Fails when the bytes are not an ASF file with a WMA v1 or v2 stream.
		def open(data byte[]) !AudioStream {
			return open(new bytes.Reader(data))
		}

		// info reads what the ASF header says without decoding any audio.
		// Fails when the reader does not hold an ASF file with a WMA stream,
		// or the header is cut short.
		def info(reader io.Reader) !AudioInfo {
			let header = new ASFHeader()
			try header.read(reader)
			tags = header.tags
			return wmaInfo(header, asfCanSeek(reader))
		}

		// info reads the ASF header of the WMA file held in the bytes.
		// Fails when the bytes are not an ASF file with a WMA stream.
		def info(data byte[]) !AudioInfo {
			return info(new bytes.Reader(data))
		}

		// encode writes the stream, from where it stands to its end, as an
		// ASF file holding one WMA v2 stream at `bitrate`, with `tags`. More
		// than two channels are mixed down to stereo and rates above 48 kHz
		// are refused.
		// Fails when the stream has no channels, its rate is above 48 kHz, or
		// the stream or the writer fails.
		def encode(stream AudioStream, writer io.Writer) !none {
			let src = stream.info()
			fail "wma: the stream has no channels" when src.channels == 0
			fail "wma: sample rate {src.sampleRate} is above 48 kHz" when src.sampleRate > 48000 || src.sampleRate == 0
			let channels = int(src.channels).min(2)
			let encoder = new WMAEncoder(int(src.sampleRate), channels, bitrate.max(24000))
			let asf = new ASFWriter(encoder, tags)
			let buf float32[]
			let inChannels = int(src.channels)
			buf.len(4096 * inChannels)
			for {
				let frames = try stream.read(buf)
				break when frames == 0
				try asf.add(wmaMixDown(buf, frames, inChannels, channels))
			}
			return asf.writeTo(writer)
		}

		// encode returns the stream as the bytes of a WMA file.
		// Fails when the stream has no channels, its rate is above 48 kHz, or
		// the stream fails.
		def encode(stream AudioStream) !byte[] {
			let out = new bytes.Buffer()
			try encode(stream, out)
			return out.bytes()
		}
	}
}

internal partial module std.formats.audio.wma {
	use (
		std.io
		std.bytes
		std.formats.audio.asf::*
		std.formats.audio.seek::*
		std.formats.audio::*
	)

	// Interleaved frames reduced to `channels` channels: extra channels are
	// averaged into the first two.
	def wmaMixDown(buf float32[], frames int, inChannels int, channels int) float32[] {
		let out float32[]
		out.len(frames * channels)
		if inChannels == channels {
			for let i = 0; i < frames * channels; i++ {
				out[i] = buf[i]
			}
			return out
		}
		for let f = 0; f < frames; f++ {
			if channels == 1 {
				let sum = 0.0
				for let c = 0; c < inChannels; c++ {
					sum += float(buf[f * inChannels + c])
				}
				out[f] = float32(sum / float(inChannels))
			} else {
				let left = 0.0
				let right = 0.0
				for let c = 0; c < inChannels; c++ {
					if c % 2 == 0 {
						left += float(buf[f * inChannels + c])
					} else {
						right += float(buf[f * inChannels + c])
					}
				}
				out[f * 2] = float32(left / float((inChannels + 1) / 2))
				out[f * 2 + 1] = float32(right / float(inChannels / 2))
			}
		}
		return out
	}

	// What an ASF header says about its audio stream.
	def wmaInfo(header ASFHeader, seekable bool) AudioInfo {
		let stream = header.audio
		let frames = header.frames()
		let rate = 0
		let channels = 0
		let bits = 16
		let bitrate = 0
		if stream.number != 0 {
			rate = stream.sampleRate
			channels = stream.channels
			bits = stream.bitsPerSample == 0 ?? (16, stream.bitsPerSample)
			bitrate = stream.bytesPerSec * 8
		}
		let format = SampleFormat.Int16
		if bits == 8 {
			format = SampleFormat.Uint8
		} else if bits == 24 {
			format = SampleFormat.Int24
		} else if bits == 32 {
			format = SampleFormat.Int32
		}
		return AudioInfo{
			sampleRate: uint32(rate),
			channels: uint16(channels),
			bitDepth: uint16(bits),
			format: format,
			frames: uint64(frames),
			length: rate == 0 ?? (0s, duration(int64(frames) * 1000000000 / int64(rate))),
			codec: "wma",
			bitrate: uint32(bitrate),
			seekable: seekable
		}
	}

	// A reader that seeks by byte offset, as `os.File` does.
	interface ASFFileSeeker {
		io.Reader
		def seek(offset int64, whence bytes.Whence) !int64
	}

	// Whether the stream can reposition `reader`.
	def asfCanSeek(reader io.Reader) bool {
		let r any = reader
		return r is ASFFileSeeker || r is bytes.Reader
	}

	// Moves `reader` to byte `pos` from its start. Fails when it cannot seek.
	def asfSeek(reader io.Reader, pos int) !none {
		let r any = reader
		if r is bytes.Reader {
			let mem bytes.Reader = r
			try mem.seek(pos, bytes.Whence.Start)
			return none
		}
		if r is ASFFileSeeker {
			let file ASFFileSeeker = r
			try file.seek(int64(pos), bytes.Whence.Start)
			return none
		}
		fail "wma: the reader cannot seek"
	}

	// A lazily decoded WMA stream: media objects are read from the ASF
	// packets and decoded as `read` asks for frames.
	type WMAStream {
		// The frame the next read starts at.
		framePosition uint64

		reader      io.Reader
		header      ASFHeader
		packets     ASFPacketReader
		decoder     WMADecoder
		details     AudioInfo
		channels    int
		// Decoded interleaved samples not yet returned, from `at`.
		buffered    float32[]
		at          int
		// Frames still to drop before output starts.
		dropFrames  int
		flushed     bool
		// Frames from an object's timestamp to its first decoded frame on
		// the output, once `calibrate` has run.
		calibration int
		calibrated  bool

		// A stream over the packets `reader` stands at, described by
		// `header`.
		def new(reader io.Reader, header ASFHeader) {
			self.reader = reader
			self.header = header
			let stream = header.audio
			packets = new ASFPacketReader(reader, header, stream)
			let version = stream.formatTag == wmaTagV1 ?? (1, 2)
			let flags = 0
			if version == 1 && stream.extra.len() >= 4 {
				flags = asfUint(stream.extra, 2, 2)
			} else if version == 2 && stream.extra.len() >= 6 {
				flags = asfUint(stream.extra, 4, 2)
			}
			// Streams with these flags mark variable blocks they do not use.
			flags &= ^wmaFlagVariableBlocks when version == 2 && stream.extra.len() >= 8 && flags == 0xD
			let layout = new WMALayout(version, stream.channels, stream.sampleRate, stream.bytesPerSec * 8, stream.blockAlign, flags)
			decoder = new WMADecoder(layout)
			details = wmaInfo(header, asfCanSeek(reader))
			channels = stream.channels
			dropFrames = 2 * layout.frameLen
		}

		// Checks that the header describes a stream the decoder handles.
		// Fails when it does not.
		def validate() !none {
			let stream = header.audio
			fail "wma: no audio stream" when stream.number == 0
			fail "wma: format tag {stream.formatTag} is not WMA v1 or v2" unless stream.formatTag := wmaTagV1 || wmaTagV2
			return decoder.layout.validate()
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return details
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream: fills `buf` with interleaved frames
		// and returns how many, 0 at the end.
		// Fails when `buf` does not hold whole frames, or the reader fails.
		def readFrames(buf float32[]) !int {
			expects {
				assert channels > 0 && buf.len() % channels == 0 onerror fail "wma: buffer of {buf.len()} samples does not hold whole frames"
			}
			let want = buf.len() / channels
			for buffered.len() - at < want * channels && !flushed {
				try fill()
			}
			let frames = ((buffered.len() - at) / channels).min(want)
			let count = frames * channels
			for let i = 0; i < count; i++ {
				buf[i] = buffered[at + i]
			}
			at += count
			if at >= buffered.len() {
				buffered = float32[]
				at = 0
			}
			return frames
		}

		// Decodes the next media object, or the held frame at the end.
		def fill() !none {
			let obj = try packets.next()
			if obj is none {
				append(decoder.flush())
				flushed = true
				return none
			}
			decodeObject(obj)
			return none
		}

		// Adds decoded samples after dropping what `dropFrames` still asks for.
		def append(samples float32[]) {
			let from = 0
			if dropFrames > 0 {
				let drop = (samples.len() / channels).min(dropFrames)
				dropFrames -= drop
				from = drop * channels
			}
			if at > 0 && at == buffered.len() {
				buffered = float32[]
				at = 0
			}
			for let i = from; i < samples.len(); i++ {
				buffered.push(samples[i])
			}
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream: positions the stream at `frame`. The
		// packets are searched by send time for one a few frames before the
		// target; decoding restarts there and runs up to it, so the frames
		// read after a seek are the ones a straight read returns, apart from
		// the noise a low bit rate stream fills some bands with.
		// Fails when the reader cannot seek or fails.
		def seekFrame(frame uint64) !none {
			fail "wma: the stream is not seekable" unless details.seekable
			let target = int(frame)
			let layout = decoder.layout
			let frameLen = layout.frameLen
			let count = header.packetCount
			return restart(target) when target < 8 * frameLen || count <= 1

			// Superframe times run two frames ahead of the output; aim four
			// frames before the target's.
			let aimMs = (target - 2 * frameLen) * 1000 / layout.sampleRate
			let low = 0
			let high = count - 1
			let probe byte[]
			probe.len(header.packetSize)
			for low < high {
				let mid = (low + high + 1) / 2
				try asfSeek(reader, header.dataOffset + mid * header.packetSize)
				// A packet the file does not hold (it was cut short) counts
				// as past the target.
				let got = io.readFull(reader, probe) onerror recover 0
				if got == probe.len() && packets.sendTime(probe) <= aimMs {
					low = mid
				} else {
					high = mid - 1
				}
			}
			return restart(target) when low == 0

			try calibrate()
			try asfSeek(reader, header.dataOffset + low * header.packetSize)
			packets.restart(low)
			decoder.reset()
			buffered = float32[]
			at = 0
			dropFrames = 0
			flushed = false

			// The first object only rebuilds the overlap and the bit
			// reservoir; the second one's time places the output.
			let first = try packets.next()
			return restart(target) when first is none
			decodeObject(first)
			buffered = float32[]
			let second = try packets.next()
			return restart(target) when second is none
			let start = (superframeAt(second.time) + calibration) * frameLen
			return restart(target) when start > target || start < 0
			decodeObject(second)
			let have = start + buffered.len() / channels
			if have <= target {
				buffered = float32[]
				dropFrames = target - have
			} else {
				at = (target - start) * channels
			}
			return none
		}

		// The superframe, counted in frames, that a presentation time in
		// milliseconds falls on.
		def superframeAt(time int) int {
			let layout = decoder.layout
			return (time * layout.sampleRate + 500 * layout.frameLen) / (1000 * layout.frameLen)
		}

		// Learns how the file's timestamps map to output frames: encoders
		// differ by a frame in what an object's time marks. The first two
		// objects are decoded from the start: the frames the first yields
		// place the second on the output.
		// Fails when the reader cannot seek or fails.
		def calibrate() !none {
			return none when calibrated
			try asfSeek(reader, header.dataOffset)
			packets.restart(0)
			decoder.reset()
			calibrated = true
			calibration = -2
			let first = try packets.next()
			return none when first is none
			let frames = 0
			let size = decoder.layout.blockAlign
			for let off = 0; off + size <= first.data.len(); off += size {
				let samples = decoder.decode(first.data[off:off + size]) onerror recover float32[]
				frames += samples.len() / channels
			}
			let second = try packets.next()
			return none when second is none
			calibration = frames / decoder.layout.frameLen - 2 - superframeAt(second.time)
			return none
		}

		// Rewinds to the first packet and decodes up to `target`. Fails when
		// the reader cannot seek.
		def restart(target int) !none {
			try asfSeek(reader, header.dataOffset)
			packets.restart(0)
			decoder.reset()
			buffered = float32[]
			at = 0
			flushed = false
			dropFrames = 2 * decoder.layout.frameLen + target
			return none
		}

		// Decodes the superframes of a media object into `buffered`.
		def decodeObject(obj ASFObject) {
			let size = decoder.layout.blockAlign
			for let off = 0; off + size <= obj.data.len(); off += size {
				let samples = decoder.decode(obj.data[off:off + size]) onerror recover float32[]
				append(samples)
			}
		}

		// close implements io.Closer: closes the reader when it is one.
		// Fails when closing the reader does.
		def close() !none {
			let r any = reader
			if r is io.Closer {
				let closer io.Closer = r
				return closer.close()
			}
			return none
		}
	}
}
