internal partial module std.formats.audio.wma {
	use std.formats.audio.m4a::*

	// Format tags of the WAVEFORMATEX header for the two WMA versions.
	const (
		wmaTagV1 = 0x0160
		wmaTagV2 = 0x0161
	)

	// Shortest block of the codec, as a power of two.
	const wmaBlockMinBits = 7

	// Length of the pseudo-random table noise coding draws from.
	const wmaNoiseTableSize = 8192

	// Decoding flags of the stream (the `flags2` word of the codec's
	// WAVEFORMATEX extra data).
	const (
		wmaFlagExpVlc         = 0x0001
		wmaFlagBitReservoir   = 0x0002
		wmaFlagVariableBlocks = 0x0004
	)

	// Everything the WMA bitstream derives from the stream's rate, channels,
	// bit rate and flags: frame and block sizes, exponent bands, the noise
	// coded region and the run-level tables. Decoder and encoder share it.
	type WMALayout {
		// 1 for format tag 0x160, 2 for 0x161.
		version           int
		channels          int
		sampleRate        int
		// Bits per second, from the header's average bytes per second.
		bitRate           int
		// Bytes of one superframe.
		blockAlign        int
		flags             int
		useExpVlc         bool
		useBitReservoir   bool
		useVariableBlocks bool
		useNoiseCoding    bool
		// Samples per channel of one frame, `1 << frameBits`.
		frameBits         int
		frameLen          int
		// How many block sizes a frame may use: `frameLen >> k` for k below
		// this.
		blockSizes        int
		// Width of the superframe's last-frame bit offset, minus 3.
		byteOffsetBits    int
		// First coded coefficient; v1 leaves the lowest three to noise.
		coefsStart        int
		// Per block size: exponent band widths.
		exponentBands     int[][]
		// Per block size: first coefficient of the noise coded region.
		highBandStart     int[]
		// Per block size: one past the last coded coefficient.
		coefsEnd          int[]
		// Per block size: widths of the bands in the noise coded region.
		highBands         int[][]
		// Scale of the noise table.
		noiseMult         float
		// Which pair of run-level tables codes the coefficients (0 to 2).
		coefTable         int

		// The layout of a stream; `validate` says whether the codec can
		// handle it.
		def new(version int, channels int, sampleRate int, bitRate int, blockAlign int, flags int) {
			self.version = version
			self.channels = channels
			self.sampleRate = sampleRate
			self.bitRate = bitRate
			self.blockAlign = blockAlign
			self.flags = flags
			useExpVlc = flags & wmaFlagExpVlc != 0
			useBitReservoir = flags & wmaFlagBitReservoir != 0
			useVariableBlocks = flags & wmaFlagVariableBlocks != 0
			return when channels < 1 || channels > 2 || sampleRate < 1 || sampleRate > 50000 || bitRate <= 0
			compute()
		}

		// Fails when the stream is not one this codec handles: more than two
		// channels, a rate above 50 kHz, no bit rate or no superframe size.
		def validate() !none {
			fail "wma: {channels} channels, at most 2 are supported" when channels < 1 || channels > 2
			fail "wma: sample rate {sampleRate} is out of range" when sampleRate < 1 || sampleRate > 50000
			fail "wma: the stream has no bit rate" when bitRate <= 0
			fail "wma: the stream has no block alignment" when blockAlign <= 0
			fail "wma: superframe offset of {byteOffsetBits} bits is too wide" when byteOffsetBits + 3 > 25
			return none
		}

		def compute() {
			if sampleRate <= 16000 {
				frameBits = 9
			} else if sampleRate <= 22050 || (sampleRate <= 32000 && version == 1) {
				frameBits = 10
			} else {
				frameBits = 11
			}
			frameLen = 1 << frameBits
			blockSizes = 1
			if useVariableBlocks {
				let nb = ((flags >> 3) & 3) + 1
				nb += 2 when bitRate / channels >= 32000
				nb = nb.min(frameBits - wmaBlockMinBits)
				blockSizes = nb + 1
			}

			useNoiseCoding = true
			let highFreq = float32(float(sampleRate) * 0.5)
			let rate1 = sampleRate
			if version == 2 {
				if rate1 >= 44100 {
					rate1 = 44100
				} else if rate1 >= 22050 {
					rate1 = 22050
				} else if rate1 >= 16000 {
					rate1 = 16000
				} else if rate1 >= 11025 {
					rate1 = 11025
				} else if rate1 >= 8000 {
					rate1 = 8000
				}
			}
			let bps = float32(bitRate) / float32(channels * sampleRate)
			byteOffsetBits = wmaLog2(int(float(bps * float32(frameLen)) / 8.0 + 0.5)) + 2

			let bps1 = bps
			bps1 = float32(float(bps) * 1.6) when channels == 2
			if rate1 == 44100 {
				if bps1 >= float32(0.61) {
					useNoiseCoding = false
				} else {
					highFreq = float32(float(highFreq) * 0.4)
				}
			} else if rate1 == 22050 {
				if bps1 >= float32(1.16) {
					useNoiseCoding = false
				} else if bps1 >= float32(0.72) {
					highFreq = float32(float(highFreq) * 0.7)
				} else {
					highFreq = float32(float(highFreq) * 0.6)
				}
			} else if rate1 == 16000 {
				if float(bps) > 0.5 {
					highFreq = float32(float(highFreq) * 0.5)
				} else {
					highFreq = float32(float(highFreq) * 0.3)
				}
			} else if rate1 == 11025 {
				highFreq = float32(float(highFreq) * 0.7)
			} else if rate1 == 8000 {
				if float(bps) <= 0.625 {
					highFreq = float32(float(highFreq) * 0.5)
				} else if float(bps) > 0.75 {
					useNoiseCoding = false
				} else {
					highFreq = float32(float(highFreq) * 0.65)
				}
			} else {
				if float(bps) >= 0.8 {
					highFreq = float32(float(highFreq) * 0.75)
				} else if float(bps) >= 0.6 {
					highFreq = float32(float(highFreq) * 0.6)
				} else {
					highFreq = float32(float(highFreq) * 0.5)
				}
			}

			coefsStart = version == 1 ?? (3, 0)
			let critical = wmaCriticalFrequencies()
			exponentBands.len(blockSizes)
			highBandStart.len(blockSizes)
			coefsEnd.len(blockSizes)
			highBands.len(blockSizes)
			for let k = 0; k < blockSizes; k++ {
				let blockLen = frameLen >> k
				let bands int[]
				if version == 1 {
					let lpos = 0
					for let i = 0; i < 25; i++ {
						let pos = (blockLen * 2 * critical[i] + (sampleRate >> 1)) / sampleRate
						pos = pos.min(blockLen)
						bands.push(pos - lpos)
						break when pos >= blockLen
						lpos = pos
					}
				} else {
					let step = frameBits - wmaBlockMinBits - k
					let table int[]
					if step < 3 {
						if sampleRate >= 44100 {
							table = wmaExponentBandTable(44100, step)
						} else if sampleRate >= 32000 {
							table = wmaExponentBandTable(32000, step)
						} else if sampleRate >= 22050 {
							table = wmaExponentBandTable(22050, step)
						}
					}
					if table.len() > 0 {
						bands = table
					} else {
						let lpos = 0
						for let i = 0; i < 25; i++ {
							let pos = (blockLen * 2 * critical[i] + (sampleRate << 1)) / (4 * sampleRate)
							pos = (pos << 2).min(blockLen)
							bands.push(pos - lpos) when pos > lpos
							break when pos >= blockLen
							lpos = pos
						}
					}
				}
				exponentBands[k] = bands

				coefsEnd[k] = (frameLen - (frameLen * 9) / 100) >> k
				highBandStart[k] = int(float(float32(float32(blockLen * 2) * highFreq) / float32(sampleRate)) + 0.5)
				let high int[]
				let pos = 0
				for let (_, width) in bands {
					let start = pos
					pos += width
					let end = pos.min(coefsEnd[k])
					start = start.max(highBandStart[k])
					high.push(end - start) when end > start
				}
				highBands[k] = high
			}

			noiseMult = useExpVlc ?? (float(float32(0.02)), float(float32(0.04)))
			coefTable = 2
			if sampleRate >= 32000 {
				if bps1 < float32(0.72) {
					coefTable = 0
				} else if bps1 < float32(1.16) {
					coefTable = 1
				}
			}
		}

		// The noise table: a fixed pseudo-random sequence scaled by
		// `noiseMult`.
		def noiseTable() float[] {
			let table float[]
			table.len(wmaNoiseTableSize)
			let norm = float32((1.0 / 2147483648.0) * wmaSqrt(3.0) * noiseMult)
			let seed = 1
			for let i = 0; i < wmaNoiseTableSize; i++ {
				seed = (seed * 314159 + 1) & 0xFFFFFFFF
				let signed = seed >= 0x80000000 ?? (seed - 0x100000000, seed)
				table[i] = float(float32(signed) * norm)
			}
			return table
		}
	}

	// The index of the highest set bit of `v`, 0 for 0.
	def wmaLog2(v int) int {
		let n = 0
		for v > 1 {
			v >>= 1
			n++
		}
		return n
	}

	// The escape width of a coefficient level for the frame's total gain.
	def wmaGainBits(totalGain int) int {
		return 13 when totalGain < 15
		return 12 when totalGain < 32
		return 11 when totalGain < 40
		return 10 when totalGain < 45
		return 9
	}

	// Ten to the power `db` / 20: the amplitude of a gain in decibels.
	def wmaDecibels(db int) float {
		let steps = float[
			1.0, 1.1220184543019633, 1.2589254117941673, 1.4125375446227544, 1.5848931924611134,
			1.7782794100389228, 1.9952623149688795, 2.2387211385683394, 2.51188643150958, 2.8183829312644537,
			3.1622776601683795, 3.5481338923357546, 3.9810717055349727, 4.466835921509631, 5.011872336272723,
			5.623413251903491, 6.3095734448019325, 7.0794578438413795, 7.943282347242815, 8.912509381337456
		]
		let q = db / 20
		let r = db - q * 20
		if r < 0 {
			r += 20
			q -= 1
		}
		let v = steps[r]
		for let i = 0; i < q; i++ {
			v *= 10.0
		}
		let div = 1.0
		for let i = 0; i < -q; i++ {
			div *= 10.0
		}
		return v / div
	}
}
