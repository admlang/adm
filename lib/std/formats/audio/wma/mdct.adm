internal partial module std.formats.audio.wma {
	use (
		std.math
		std.simd
	)

	// The modified discrete cosine transform of one WMA block size and its
	// sine window. `n` coefficients map to `2n` samples:
	// y[i] = sum over k of X[k] * cos(π/n * (i + 1/2 + n/2) * (k + 1/2)).
	// Both directions go through a type-IV DCT computed with an `n/2` point
	// complex FFT.
	type WMATransform {
		// Coefficients per block.
		n      int
		// The rising half of the sine window, `n` long:
		// sin((i + 1/2) * π / (2n)).
		window float[]

		half     int
		// exp(-iπ(k + 1/8) / n), applied before and after the FFT.
		twistRe  float[]
		twistIm  float[]
		// exp(-2πik / half) for the FFT butterflies.
		rootRe   float[]
		rootIm   float[]
		// The butterfly twiddles again, one contiguous run per stage.
		stageCos float[]
		stageSin float[]
		reverse  int[]
		re       float[]
		im       float[]
		dct      float[]
		fold     float[]

		// A transform of `n` coefficients, a power of two from 4.
		def new(n int) {
			self.n = n
			half = n / 2
			window.len(n)
			for let i = 0; i < n; i++ {
				window[i] = math.sin((float(i) + 0.5) * (math.π / (2.0 * float(n))))
			}
			twistRe.len(half)
			twistIm.len(half)
			for let k = 0; k < half; k++ {
				let a = -math.π * (float(k) + 0.125) / float(n)
				twistRe[k] = math.cos(a)
				twistIm[k] = math.sin(a)
			}
			rootRe.len(half)
			rootIm.len(half)
			for let k = 0; k < half; k++ {
				let a = -2.0 * math.π * float(k) / float(half)
				rootRe[k] = math.cos(a)
				rootIm[k] = math.sin(a)
			}
			// Each stage's twiddles in a contiguous run: the stage of half
			// span `mid` at `mid - 1`.
			stageCos.len(half)
			stageSin.len(half)
			for let mid = 1; mid < half; mid *= 2 {
				let step = half / (2 * mid)
				for let j = 0; j < mid; j++ {
					stageCos[mid - 1 + j] = rootRe[j * step]
					stageSin[mid - 1 + j] = rootIm[j * step]
				}
			}
			let bits = 0
			for (1 << bits) < half {
				bits++
			}
			reverse.len(half)
			for let i = 0; i < half; i++ {
				let r = 0
				for let b = 0; b < bits; b++ {
					r |= ((i >> b) & 1) << (bits - 1 - b)
				}
				reverse[i] = r
			}
			re.len(half)
			im.len(half)
			dct.len(n)
			fold.len(n)
		}

		// Type-IV DCT of `x` into `dct`:
		// dct[m] = sum over k of x[k] * cos(π/n * (m + 1/2) * (k + 1/2)).
		def dct4(x float[]) {
			for let k = 0; k < half; k++ {
				let a = x[2 * k]
				let b = x[n - 1 - 2 * k]
				let j = reverse[k]
				re[j] = a * twistRe[k] - b * twistIm[k]
				im[j] = a * twistIm[k] + b * twistRe[k]
			}
			let size = 2
			for size <= half {
				let step = half / size
				let mid = size / 2
				if mid >= 4 {
					// Four butterflies a vector, twiddles from this stage's run of
					// the stage table.
					let w = mid - 1
					for let start = 0; start < half; start += 2 * mid {
						for let j = 0; j < mid; j += 4 {
							let wr = simd.load4<float>(stageCos, w + j)
							let wi = simd.load4<float>(stageSin, w + j)
							let p = start + j
							let q = p + mid
							let xr = simd.load4<float>(re, q)
							let xi = simd.load4<float>(im, q)
							let tr = xr * wr - xi * wi
							let ti = xr * wi + xi * wr
							let pr = simd.load4<float>(re, p)
							let pi = simd.load4<float>(im, p)
							simd.store4<float>(re, q, pr - tr)
							simd.store4<float>(im, q, pi - ti)
							simd.store4<float>(re, p, pr + tr)
							simd.store4<float>(im, p, pi + ti)
						}
					}
				} else {
					for let start = 0; start < half; start += size {
						for let k = 0; k < mid; k++ {
							let wr = rootRe[k * step]
							let wi = rootIm[k * step]
							let p = start + k
							let q = p + mid
							let tr = re[q] * wr - im[q] * wi
							let ti = re[q] * wi + im[q] * wr
							re[q] = re[p] - tr
							im[q] = im[p] - ti
							re[p] += tr
							im[p] += ti
						}
					}
				}
				size *= 2
			}
			for let k = 0; k < half; k++ {
				let a = re[k] * twistRe[k] - im[k] * twistIm[k]
				let b = re[k] * twistIm[k] + im[k] * twistRe[k]
				dct[2 * k] = a
				dct[n - 1 - 2 * k] = -b
			}
		}

		// Writes the `2n` samples of `coefs` times `scale` to `out`.
		def inverse(coefs float[], out float[], scale float) {
			dct4(coefs)
			let quarter = n / 2
			for let i = 0; i < 2 * n; i++ {
				let m = i + quarter
				if m < n {
					out[i] = dct[m] * scale
				} else if m < 2 * n {
					out[i] = -dct[2 * n - 1 - m] * scale
				} else {
					out[i] = -dct[m - 2 * n] * scale
				}
			}
		}

		// Writes the `n` coefficients of the `2n` samples in `input` to
		// `coefs`; `inverse` with scale 2/n undoes it after windowed
		// overlap-add.
		def forward(input float[], coefs float[]) {
			for let i = 0; i < n; i++ {
				fold[i] = 0.0
			}
			let quarter = n / 2
			for let i = 0; i < 2 * n; i++ {
				let m = i + quarter
				if m < n {
					fold[m] += input[i]
				} else if m < 2 * n {
					fold[2 * n - 1 - m] -= input[i]
				} else {
					fold[m - 2 * n] -= input[i]
				}
			}
			dct4(fold)
			for let k = 0; k < n; k++ {
				coefs[k] = dct[k]
			}
		}
	}
}
