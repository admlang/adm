internal partial module std.formats.audio.wma {
	use (
		std.io
		std.bytes
		std.formats.video.media.asf::*
	)

	// Milliseconds of preroll the writer gives the stream.
	const asfWriterPreroll = 3100

	// Bytes per data packet the writer uses.
	const asfWriterPacketSize = 3200

	// Bytes of a written packet's header before its payloads: error
	// correction, flags, padding length, send time, duration and payload
	// count.
	const asfPacketHeaderSize = 14

	// Bytes of a written payload's header: stream, object number, offset,
	// replicated data and length.
	const asfPayloadHeaderSize = 17

	// Builds an ASF file holding one WMA stream: collects the encoded
	// superframes, then writes the header, the packets and the tags.
	type ASFWriter {
		encoder WMAEncoder
		tags    map<string, string>
		// Every superframe, in order.
		objects byte[][]

		// A writer for the encoder's stream carrying `tags`.
		def new(encoder WMAEncoder, tags map<string, string>) {
			self.encoder = encoder
			self.tags = tags
		}

		// Encodes interleaved frames and keeps the superframes they complete.
		//
		// Fails when the samples are not whole frames.
		def add(samples float32[]) !none {
			let done = try encoder.encode(samples)
			for let (_, f) in done {
				objects.push(f)
			}
			return none
		}

		// Flushes the encoder and writes the whole file.
		//
		// Fails when the writer does.
		def writeTo(writer io.Writer) !none {
			let rest = try encoder.flush()
			for let (_, f) in rest {
				objects.push(f)
			}
			let packets = packetize()
			let size = headerBytes(packets.len(), 0).len()
			let header = headerBytes(packets.len(), size + 50 + packets.len() * asfWriterPacketSize)
			try asfWriteAll(writer, header)
			let data = new bytes.Buffer()
			data.write(asfGuid(asfDataObject)) onerror recover 0
			asfPut(data, 50 + packets.len() * asfWriterPacketSize, 8)
			data.write(asfGuid(asfFileId)) onerror recover 0
			asfPut(data, packets.len(), 8)
			asfPut(data, 0x0101, 2)
			try asfWriteAll(writer, data.bytes())
			for let (_, p) in packets {
				try asfWriteAll(writer, p)
			}
			return none
		}

		// Presentation time in milliseconds of superframe `index`, preroll
		// included.
		def objectTime(index int) int {
			let layout = encoder.layout
			return asfWriterPreroll + index * layout.frameLen * 1000 / layout.sampleRate
		}

		// Splits the superframes into packets, fragmenting those that do not
		// fit.
		def packetize() byte[][] {
			let packets byte[][]
			let obj = 0
			let offset = 0
			for obj < objects.len() {
				let body = new bytes.Buffer()
				let count = 0
				let sendTime = objectTime(obj) - asfWriterPreroll
				let room = asfWriterPacketSize - asfPacketHeaderSize
				for obj < objects.len() && count < 63 && room > asfPayloadHeaderSize {
					let data = objects[obj]
					let len = (data.len() - offset).min(room - asfPayloadHeaderSize)
					body.write(byte[0x81, byte(obj & 0xFF)]) onerror recover 0
					asfPut(body, offset, 4)
					body.write(byte[8]) onerror recover 0
					asfPut(body, data.len(), 4)
					asfPut(body, objectTime(obj), 4)
					asfPut(body, len, 2)
					body.write(data[offset:offset + len]) onerror recover 0
					room -= asfPayloadHeaderSize + len
					count++
					offset += len
					if offset >= data.len() {
						obj++
						offset = 0
					}
				}
				let p = new bytes.Buffer()
				let padding = asfWriterPacketSize - asfPacketHeaderSize - body.len()
				// Error correction present, two bytes; multiple payloads with
				// a word padding length; byte stream and object numbers,
				// double word offsets, byte replicated data length.
				p.write(byte[0x82, 0, 0, 0x11, 0x5D]) onerror recover 0
				asfPut(p, padding, 2)
				asfPut(p, sendTime, 4)
				asfPut(p, 0, 2)
				p.write(byte[0x80 | count]) onerror recover 0
				p.write(body.bytes()) onerror recover 0
				let packet = p.bytes()
				packet.len(asfWriterPacketSize)
				packets.push(packet)
			}
			return packets
		}

		// The Header Object for `packets` data packets in a file of
		// `fileSize` bytes.
		def headerBytes(packets int, fileSize int) byte[] {
			let layout = encoder.layout
			let parts = new bytes.Buffer()
			let count = 0

			let frames = encoder.count()
			let length = frames * 10000000 / layout.sampleRate
			let props = new bytes.Buffer()
			props.write(asfGuid(asfFileId)) onerror recover 0
			asfPut(props, fileSize, 8)
			asfPut(props, 0, 8)
			asfPut(props, packets, 8)
			asfPut(props, length + asfWriterPreroll * 10000, 8)
			asfPut(props, length, 8)
			asfPut(props, asfWriterPreroll, 8)
			asfPut(props, 2, 4)
			asfPut(props, asfWriterPacketSize, 4)
			asfPut(props, asfWriterPacketSize, 4)
			asfPut(props, layout.bitRate, 4)
			asfObject(parts, asfFilePropertiesObject, props.bytes())
			count++

			let ext = new bytes.Buffer()
			ext.write(asfGuid(asfReserved1)) onerror recover 0
			asfPut(ext, 6, 2)
			asfPut(ext, 0, 4)
			asfObject(parts, asfHeaderExtensionObject, ext.bytes())
			count++

			let stream = new bytes.Buffer()
			stream.write(asfGuid(asfAudioMedia)) onerror recover 0
			stream.write(asfGuid(asfAudioSpread)) onerror recover 0
			asfPut(stream, 0, 8)
			asfPut(stream, 28, 4)
			asfPut(stream, 8, 4)
			asfPut(stream, 1, 2)
			asfPut(stream, 0, 4)
			asfPut(stream, wmaTagV2, 2)
			asfPut(stream, layout.channels, 2)
			asfPut(stream, layout.sampleRate, 4)
			asfPut(stream, layout.bitRate / 8, 4)
			asfPut(stream, layout.blockAlign, 2)
			asfPut(stream, 16, 2)
			asfPut(stream, 10, 2)
			asfPut(stream, layout.frameLen, 4)
			asfPut(stream, layout.flags, 2)
			asfPut(stream, 0, 4)
			// Audio spread without interleaving: a span of one superframe.
			stream.write(byte[1]) onerror recover 0
			asfPut(stream, layout.blockAlign, 2)
			asfPut(stream, layout.blockAlign, 2)
			asfPut(stream, 1, 2)
			stream.write(byte[0]) onerror recover 0
			asfObject(parts, asfStreamPropertiesObject, stream.bytes())
			count++

			let described = false
			for let (_, name) in asfDescriptionTags {
				described = described || tags.hasKey(name)
			}
			if described {
				let lens = new bytes.Buffer()
				let texts = new bytes.Buffer()
				for let (_, name) in asfDescriptionTags {
					let found = tags.get(name)
					let text byte[]
					text = asfEncodeText(found) when !(found is none) && found.len() > 0
					asfPut(lens, text.len(), 2)
					texts.write(text) onerror recover 0
				}
				lens.write(texts.bytes()) onerror recover 0
				asfObject(parts, asfContentDescription, lens.bytes())
				count++
			}

			let extended = new bytes.Buffer()
			let entries = 0
			for let (name, value) in tags {
				continue when name in asfDescriptionTags
				let key = asfEncodeText(name)
				let text = asfEncodeText(value)
				asfPut(extended, key.len(), 2)
				extended.write(key) onerror recover 0
				asfPut(extended, 0, 2)
				asfPut(extended, text.len(), 2)
				extended.write(text) onerror recover 0
				entries++
			}
			if entries > 0 {
				let body = new bytes.Buffer()
				asfPut(body, entries, 2)
				body.write(extended.bytes()) onerror recover 0
				asfObject(parts, asfExtendedContent, body.bytes())
				count++
			}

			let out = new bytes.Buffer()
			out.write(asfGuid(asfHeaderObject)) onerror recover 0
			asfPut(out, 30 + parts.len(), 8)
			asfPut(out, count, 4)
			out.write(byte[1, 2]) onerror recover 0
			out.write(parts.bytes()) onerror recover 0
			return out.bytes()
		}
	}

	// The file identifier the writer stamps in the File Properties and Data
	// objects.
	const asfFileId = "3F2E6D5A-1B0C-4D8E-9A7B-6C5D4E3F2A1B"
}
