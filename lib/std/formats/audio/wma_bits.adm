internal partial module std.formats.audio.wma {
	use std.formats.audio::*

	// Reads a WMA bitstream, most significant bit of each byte first. Reads
	// past the end give zero bits, and `left` goes negative, so a damaged frame
	// is caught by its caller instead of faulting here.
	type WMABitReader {
		data byte[]
		// Cursor, in bits from the start of `data`.
		pos  int
		// Length of the stream in bits; may be shorter than `data`.
		end  int

		// A reader over the first `bits` bits of `data`.
		def new(data byte[], bits int) {
			self.data = data
			pos = 0
			end = bits
		}

		// The bits left before the end, negative once it is overrun.
		def left() int {
			return end - pos
		}

		// The bits read so far.
		def count() int {
			return pos
		}

		// The next `n` bits (0 to 25) as an unsigned value, without consuming
		// them.
		def peek(n int) int {
			let at = pos >> 3
			let word = 0
			if (at + 4) * 8 <= end && at + 4 <= data.len() {
				word = (int(data[at]) << 24) | (int(data[at + 1]) << 16) | (int(data[at + 2]) << 8) | int(data[at + 3])
			} else {
				for let i = 0; i < 4; i++ {
					let b = 0
					b = int(data[at + i]) when at + i < data.len() && (at + i) * 8 < end
					word = (word << 8) | b
				}
			}
			return (word >> (32 - (pos & 7) - n)) & ((1 << n) - 1)
		}

		// Consumes `n` bits.
		def skip(n int) {
			pos += n
		}

		// Reads `n` bits (0 to 25) as an unsigned value.
		def read(n int) int {
			let v = peek(n)
			pos += n
			return v
		}

		// Reads `n` bits (0 to 50) as an unsigned value.
		def readLong(n int) int {
			return read(n) when n <= 25
			let high = read(n - 25)
			return (high << 25) | read(25)
		}

		// Reads one bit.
		def bit() int {
			return read(1)
		}

		// Skips to the next byte boundary.
		def align() {
			pos = (pos + 7) & ^7
		}
	}

	// Writes a WMA bitstream, most significant bit first.
	type WMABitWriter {
		out   byte[]
		acc   int
		nbits int

		def new() {}

		// Appends the low `n` bits (0 to 32) of `value`.
		def write(n int, value int) {
			return when n == 0
			acc = (acc << n) | (value & ((1 << n) - 1))
			nbits += n
			for nbits >= 8 {
				nbits -= 8
				out.push(byte((acc >> nbits) & 0xFF))
			}
			acc &= (1 << nbits) - 1
		}

		// Pads with zero bits to the next byte boundary.
		def align() {
			write(8 - nbits, 0) when nbits > 0
		}

		// The bits written so far.
		def count() int {
			return out.len() * 8 + nbits
		}

		// The whole bytes written so far; call `align` first to include a
		// partial last byte.
		def bytes() byte[] {
			return out
		}
	}

	// A prefix code decoder built from explicit codes and lengths, with
	// lookup tables `rootBits` wide at the first level and nested tables for
	// longer codes.
	type WMAVlc {
		// Per entry: the symbol of a leaf, or the start of a nested table.
		symbols  int[]
		// Per entry: the bits a leaf consumes, minus the index width of a
		// nested table, or 0 where no code lands.
		lengths  int[]
		rootBits int

		// A decoder for code `codes[i]` of `lengths[i]` bits meaning
		// `symbols[i]`.
		def new(codes int[], lengths int[], symbols int[], rootBits int) {
			self.rootBits = rootBits
			let all int[]
			for let i = 0; i < codes.len(); i++ {
				all.push(i)
			}
			build(codes, lengths, symbols, all, 0, rootBits)
		}

		// Adds the table for the codes in `members`, whose first `prefix`
		// bits are already consumed, and returns where it starts.
		def build(codes int[], lengths int[], syms int[], members int[], prefix int, bits int) int {
			let base = symbols.len()
			let size = 1 << bits
			symbols.len(base + size)
			self.lengths.len(base + size)
			for let i = 0; i < size; i++ {
				symbols[base + i] = 0
				self.lengths[base + i] = 0
			}
			// Codes longer than this level, with the index bits they share.
			let longKeys int[]
			let longMembers int[]
			for let (_, m) in members {
				let rest = lengths[m] - prefix
				let code = codes[m] & ((1 << rest) - 1)
				if rest <= bits {
					let start = code << (bits - rest)
					for let j = 0; j < 1 << (bits - rest); j++ {
						symbols[base + start + j] = syms[m]
						self.lengths[base + start + j] = rest
					}
				} else {
					longKeys.push(code >> (rest - bits))
					longMembers.push(m)
				}
			}
			for let key = 0; key < size; key++ {
				let group int[]
				let longest = 0
				for let (i, k) in longKeys {
					continue when k != key
					let m = longMembers[i]
					group.push(m)
					longest = longest.max(lengths[m] - prefix - bits)
				}
				continue when group.len() == 0
				let subBits = longest.min(rootBits)
				let sub = build(codes, lengths, syms, group, prefix + bits, subBits)
				symbols[base + key] = sub
				self.lengths[base + key] = -subBits
			}
			return base
		}

		// Decodes one symbol, or returns -1 on a bit pattern no code has.
		def decode(r WMABitReader) int {
			let base = 0
			let n = rootBits
			for {
				let idx = base + r.peek(n)
				let len = lengths[idx]
				if len > 0 {
					r.skip(len)
					return symbols[idx]
				}
				r.skip(n)
				return -1 when len == 0
				base = symbols[idx]
				n = -len
			}
			return -1
		}
	}
}
