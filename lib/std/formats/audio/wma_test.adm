partial module std.formats.audio {
	use (
		std.testing
		std.os
		std.bytes
		std.math
		std.formats.media.asf::*
		std.formats.audio.seek::*
		std.formats.audio.wma::*
	)

	// Interleaved samples in memory as an audio stream, to feed the encoder.
	internal type WMATestClip {
		// The frame the next read starts at.
		internal framePosition uint64

		samples float32[]
		rate    int
		ch      int
		pos     int

		def new(samples float32[], rate int, ch int) {
			self.samples = samples
			self.rate = rate
			self.ch = ch
		}

		// info implements AudioStream.
		def info() AudioInfo {
			return AudioInfo{sampleRate: uint32(rate), channels: uint16(ch), bitDepth: 32, format: SampleFormat.Float32, frames: uint64(samples.len() / ch), length: 0s, codec: "pcm", bitrate: 0, seekable: false}
		}

		// Fills `buf` with the next frames and returns their count, 0 at the end.
		//
		// Fails as decoding does.
		def read(buf float32[]) !int {
			let readCount = try readFrames(buf)
			framePosition += uint64(readCount)
			return readCount
		}

		// read implements AudioStream. Does not fail.
		internal def readFrames(buf float32[]) !int {
			let n = (samples.len() - pos).min(buf.len())
			for let i = 0; i < n; i++ {
				buf[i] = samples[pos + i]
			}
			pos += n
			return n / ch
		}

		// Positions the stream at `frame`.
		//
		// Fails when the stream cannot seek there.
		def seek(frame uint64) !none {
			try seekFrame(frame)
			let knownFrames = info().frames
			framePosition = knownFrames > uint64(0) && frame > knownFrames ?? (knownFrames, frame)
			return none
		}

		// Positions the stream at `time` from its start.
		//
		// Fails when the stream cannot seek there.
		def seek(time duration) !none {
			return seek(frameAt(time, info()))
		}

		// Moves the stream by `offset`, back when negative.
		//
		// Fails when the stream cannot seek there.
		def skip(offset duration) !none {
			return seek(skipTarget(framePosition, offset, info()))
		}

		// The frame the next read starts at.
		def position() uint64 {
			return framePosition
		}

		// seek implements AudioStream. Always fails: the clip only plays
		// forward.
		internal def seekFrame(frame uint64) !none {
			fail "not seekable"
		}

		// close implements io.Closer. Does not fail.
		def close() !none {
			return none
		}
	}

	check "WMA" {
		// Sample files live in the repo, and `adm test` runs from its root. A
		// missing sample skips rather than fails.
		let sampleDir = "samples/audio/wma/"

		// The codec's tag `name`, empty when it has none.
		internal def tag(codec WMA, name string) string {
			let v = codec.tags.get(name)
			return "" when v is none
			return v
		}

		internal def sample(name string) ?byte[] {
			let data = os.readFile(sampleDir + name)
			return none when data is error
			return data
		}

		// Whether a decoded sample matches figures taken from a reference
		// decoder: the frame count, the sum of magnitudes and of squares,
		// and six samples from a third of the way in.
		internal def matches(clip Audio, frames int, sumAbs float, sumSquares float, window float[]) bool {
			return false when clip.info.channels != 1 || clip.info.sampleRate != 44100
			return false when int(clip.info.frames) != frames
			let abs = 0.0
			let squares = 0.0
			for let (_, v) in clip.samples {
				abs += float(v).abs()
				squares += float(v) * float(v)
			}
			return false when (abs - sumAbs).abs() > sumAbs * 1.0e-6
			return false when (squares - sumSquares).abs() > sumSquares * 1.0e-6
			let at = frames / 3
			for let (i, want) in window {
				return false when (float(clip.samples[at + i]) - want).abs() > 1.0e-6
			}
			return true
		}

		@test()
		def TestDecode5s() !none {
			let data = sample("wma_5s_sample_file_85KB.wma")
			return none when data is none
			let clip = try load(data)
			assert matches(clip, 219136, 5613.268901, 202.103586076, float[0.0497079641, 0.0500666685, 0.0502286926, 0.0501933768, 0.0499608442, 0.0495320037])
			return none
		}

		@test()
		def TestDecode15s() !none {
			let data = sample("wma_15s_sample_file_254KB.wma")
			return none when data is none
			let clip = try load(data)
			assert matches(clip, 659456, 19650.863507, 753.373695369, float[-0.0364186876, -0.0384982675, -0.0404267125, -0.042196434, -0.0438004695, -0.0452325083])
			return none
		}

		@test()
		def TestDecode30s() !none {
			let data = sample("wma_30s_sample_file_507KB.wma")
			return none when data is none
			let clip = try load(data)
			assert matches(clip, 1320960, 40707.363761, 1580.285738313, float[-0.0405576676, -0.0423548408, -0.0439843275, -0.0454398356, -0.0467157513, -0.0478071757])
			return none
		}

		@test()
		def TestDecode60s() !none {
			let data = sample("wma_60s_sample_file_1010KB.wma")
			return none when data is none
			let clip = try load(data)
			assert matches(clip, 2643968, 82819.013491, 3234.000173017, float[-0.0437942594, -0.0452421866, -0.0465126671, -0.0476006977, -0.0485019907, -0.0492129698])
			return none
		}

		@test()
		def TestHeader() !none {
			let data = sample("wma_5s_sample_file_85KB.wma")
			return none when data is none
			let codec = new WMA()
			assert codec.matchSignature(new bytes.Reader(data))
			let info = try codec.info(data)
			assert info.codec == "wma"
			assert info.sampleRate == 44100
			assert info.channels == 1
			assert info.bitrate == 128000
			assert info.frames == 220500
			assert info.length == 5s
			assert info.seekable
			assert tag(codec, "WM/EncodingSettings") == "Lavf60.16.100"

			let header = new AsfHeader()
			try header.read(new bytes.Reader(data))
			assert header.packetSize == 3200
			assert header.packetCount == 27
			assert header.preroll == 3100
			assert header.audio.formatTag == wmaTagV2
			assert header.audio.blockAlign == 743
			assert header.audio.span == 0
			return none
		}

		@test()
		def TestRejectsOther() !none {
			let codec = new WMA()
			let riff = byte[0x52, 0x49, 0x46, 0x46, 0, 0, 0, 0, 0x57, 0x41, 0x56, 0x45, 0, 0, 0, 0]
			assert !codec.matchSignature(new bytes.Reader(riff))
			let failed = false
			codec.info(riff) onerror (err error) {
				failed = true
				recover wmaInfo(new AsfHeader(), false)
			}
			assert failed
			return none
		}

		// Largest difference between a straight read and 32 frames read after
		// seeking to each of `targets`.
		internal def seekError(data byte[], targets int[]) !float {
			let all = try load(data)
			let ch = int(all.info.channels)
			let stream = try new WMA().open(data)
			let worst = 0.0
			for let (_, t) in targets {
				try stream.seek(uint64(t))
				let buf float32[]
				buf.len(32 * ch)
				let n = try stream.read(buf)
				assert n == 32
				for let i = 0; i < n * ch; i++ {
					worst = worst.max((float(buf[i]) - float(all.samples[t * ch + i])).abs())
				}
			}
			return worst
		}

		@test()
		def TestSeek() !none {
			let data = sample("wma_5s_sample_file_85KB.wma")
			return none when data is none
			let err = try seekError(data, int[100000, 20000, 150001, 3000, 0, 65536, 219000])
			assert err == 0.0
			return none
		}

		// One second of a two-tone stereo signal at 44.1 kHz.
		internal def tones() WMATestClip {
			let rate = 44100
			let samples float32[]
			samples.len(rate * 2)
			for let i = 0; i < rate; i++ {
				let t = float(i) / float(rate)
				samples[i * 2] = float32(0.4 * math.sin(2.0 * math.π * 440.0 * t))
				samples[i * 2 + 1] = float32(0.3 * math.sin(2.0 * math.π * 660.0 * t) + 0.1 * math.sin(2.0 * math.π * 3000.0 * t))
			}
			return new WMATestClip(samples, rate, 2)
		}

		// Signal to noise ratio in decibels of `got` against `want` over
		// their common length.
		internal def snr(got float32[], want float32[]) float {
			let n = got.len().min(want.len())
			let signal = 0.0
			let noise = 0.0
			for let i = 0; i < n; i++ {
				let d = float(got[i]) - float(want[i])
				signal += float(want[i]) * float(want[i])
				noise += d * d
			}
			return 999.0 when noise == 0.0
			return 10.0 * math.ln(signal / noise) / math.ln(10.0)
		}

		@test()
		def TestEncodeRoundTrip() !none {
			let source = tones()
			let codec = new WMA()
			codec.bitrate = 128000
			codec.tags.set("Title", "Two tones")
			codec.tags.set("Author", "ADM")
			codec.tags.set("WM/AlbumTitle", "Tests ü")
			let file = try codec.encode(source)

			let back = new WMA()
			let clip = try load(file)
			assert clip.info.channels == 2
			assert clip.info.sampleRate == 44100
			assert clip.info.bitrate == 128000
			// Up to two frames of silence pad the end.
			assert int(clip.info.frames) >= 44100 && int(clip.info.frames) <= 44100 + 2 * 2048
			assert snr(clip.samples, source.samples) > 30.0

			try back.info(file)
			assert tag(back, "Title") == "Two tones"
			assert tag(back, "Author") == "ADM"
			assert tag(back, "WM/AlbumTitle") == "Tests ü"

			let err = try seekError(file, int[30000, 9000, 40000])
			assert err == 0.0
			return none
		}

		@test()
		def TestEncodeMonoRates() !none {
			for let (_, rate) in int[8000, 22050, 32000, 48000] {
				let n = rate / 2
				let samples float32[]
				samples.len(n)
				for let i = 0; i < n; i++ {
					samples[i] = float32(0.5 * math.sin(2.0 * math.π * 500.0 * float(i) / float(rate)))
				}
				let codec = new WMA()
				codec.bitrate = 32000
				let file = try codec.encode(new WMATestClip(samples, rate, 1))
				let clip = try load(file)
				assert int(clip.info.sampleRate) == rate
				assert int(clip.info.frames) >= n
				assert snr(clip.samples, samples) > 20.0
			}
			return none
		}

		@test()
		def TestFragmentedObjects() !none {
			// At this rate a superframe outgrows a packet, so objects are split
			// across packets and put back together.
			let source = tones()
			let codec = new WMA()
			codec.bitrate = 640000
			let file = try codec.encode(source)
			let header = new AsfHeader()
			try header.read(new bytes.Reader(file))
			assert header.audio.blockAlign > header.packetSize
			let clip = try load(file)
			assert snr(clip.samples, source.samples) > 40.0
			return none
		}

		@test()
		def TestVlcTables() {
			for let t = 0; t < 6; t++ {
				let codes = wmaCoefCodes(t)
				let lens = wmaCoefBits(t)
				let syms int[]
				for let i = 0; i < codes.len(); i++ {
					syms.push(i)
				}
				let vlc = new WMAVlc(codes, lens, syms, 9)
				let w = new WMABitWriter()
				for let i = 0; i < codes.len(); i++ {
					w.write(lens[i], codes[i])
				}
				w.align()
				let r = new WMABitReader(w.bytes(), w.count())
				for let i = 0; i < codes.len(); i++ {
					assert vlc.decode(r) == i
				}
			}
		}
	}
}
