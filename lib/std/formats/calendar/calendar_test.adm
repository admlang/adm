partial module std.formats.calendar {
	use (
		std.testing
		std.bytes
		std.time
		std.formats.calendar.civil::*
	)

	check "iCalendar" {
		internal def reader(text string) bytes.Reader {
			return new bytes.Reader(text.bytes())
		}

		internal def two(n int) string {
			return n < 10 ?? ("0" + n.str(), n.str())
		}

		// A moment as a basic UTC date-time.
		internal def stamp(t time.Time) string {
			return "{t.year()}{two(t.month())}{two(t.day())}T{two(t.hour())}{two(t.minute())}{two(t.second())}"
		}

		// The instance starts of one floating event with `rule` from
		// `start`, in a window of years.
		internal def starts(start string, rule string, extra string = "") !string[] {
			let ics = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:test\r\nBEGIN:VEVENT\r\nUID:r1\r\nDTSTAMP:20000101T000000Z\r\nDTSTART:{start}\r\nRRULE:{rule}\r\n{extra}END:VEVENT\r\nEND:VCALENDAR\r\n"
			let cal = try new ICalendar().read(reader(ics))
			let out string[] = []
			for let o in try cal.occurrences(instantOf(int64(0)), instantOf(int64(4102444800))) {
				out.push(stamp(o.start))
			}
			return out
		}

		@test()
		def TestRecurrenceRFC5545() !none {
			assert (try starts("19970902T090000", "FREQ=DAILY;COUNT=10")).len() == 10
			assert (try starts("19970922T090000", "FREQ=MONTHLY;COUNT=6;BYDAY=-2MO")).join(" ") == "19970922T090000 19971020T090000 19971117T090000 19971222T090000 19980119T090000 19980216T090000"
			assert (try starts("19970605T090000", "FREQ=YEARLY;COUNT=10;BYMONTH=6,7")).len() == 10
			assert (try starts("19970519T090000", "FREQ=YEARLY;BYDAY=20MO;COUNT=3")).join(" ") == "19970519T090000 19980518T090000 19990517T090000"
			assert (try starts("19970512T090000", "FREQ=YEARLY;BYWEEKNO=20;BYDAY=MO;COUNT=3")).join(" ") == "19970512T090000 19980511T090000 19990517T090000"
			let friday13 = try starts("19970902T090000", "FREQ=MONTHLY;BYDAY=FR;BYMONTHDAY=13;COUNT=6", "EXDATE:19970902T090000\r\n")
			assert friday13.join(" ") == "19980213T090000 19980313T090000 19981113T090000 19990813T090000 20001013T090000"
			assert (try starts("19970930T090000", "FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1;COUNT=4")).join(" ") == "19970930T090000 19971031T090000 19971128T090000 19971231T090000"
			assert (try starts("19970902T090000", "FREQ=HOURLY;INTERVAL=3;UNTIL=19970902T170000")).join(" ") == "19970902T090000 19970902T120000 19970902T150000"
			assert (try starts("19970902T090000", "FREQ=MINUTELY;INTERVAL=15;COUNT=6")).join(" ") == "19970902T090000 19970902T091500 19970902T093000 19970902T094500 19970902T100000 19970902T101500"
			assert (try starts("19970805T090000", "FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=MO")).join(" ") == "19970805T090000 19970810T090000 19970819T090000 19970824T090000"
			assert (try starts("19970805T090000", "FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=SU")).join(" ") == "19970805T090000 19970817T090000 19970819T090000 19970831T090000"
			assert (try starts("19970902T090000", "FREQ=WEEKLY;UNTIL=19971007T000000Z;WKST=SU;BYDAY=TU,TH")).len() == 10
			assert (try starts("19961105T090000", "FREQ=YEARLY;INTERVAL=4;BYMONTH=11;BYDAY=TU;BYMONTHDAY=2,3,4,5,6,7,8;COUNT=3")).join(" ") == "19961105T090000 20001107T090000 20041102T090000"
		}

		@test()
		def TestRecurrenceSkip() !none {
			assert (try starts("20150131T090000", "FREQ=MONTHLY;RSCALE=GREGORIAN;SKIP=BACKWARD;COUNT=4")).join(" ") == "20150131T090000 20150228T090000 20150331T090000 20150430T090000"
			assert (try starts("20150131T090000", "FREQ=MONTHLY;COUNT=3")).join(" ") == "20150131T090000 20150331T090000 20150531T090000"
			assert (try starts("20160229T090000", "FREQ=YEARLY;COUNT=3")).join(" ") == "20160229T090000 20200229T090000 20240229T090000"
			assert (try starts("20160229T090000", "FREQ=YEARLY;RSCALE=GREGORIAN;SKIP=FORWARD;COUNT=3")).join(" ") == "20160229T090000 20170301T090000 20180301T090000"
			let failed = ""
			starts("20160229T090000", "FREQ=YEARLY;RSCALE=CHINESE;COUNT=3") onerror (err error) {
				failed = err is CalendarError ?? (err.code, "other")
				recover string[]
			}
			assert failed == "scale"
		}

		@test()
		def TestTimeZoneAcrossDST() !none {
			let ics = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:test\r\nBEGIN:VTIMEZONE\r\nTZID:America/New_York\r\nBEGIN:STANDARD\r\nDTSTART:19671029T020000\r\nRRULE:FREQ=YEARLY;BYDAY=-1SU;BYMONTH=10\r\nTZOFFSETFROM:-0400\r\nTZOFFSETTO:-0500\r\nTZNAME:EST\r\nEND:STANDARD\r\nBEGIN:DAYLIGHT\r\nDTSTART:19870405T020000\r\nRRULE:FREQ=YEARLY;BYDAY=1SU;BYMONTH=4\r\nTZOFFSETFROM:-0500\r\nTZOFFSETTO:-0400\r\nTZNAME:EDT\r\nEND:DAYLIGHT\r\nEND:VTIMEZONE\r\nBEGIN:VEVENT\r\nUID:tz1\r\nDTSTAMP:19970901T130000Z\r\nDTSTART;TZID=America/New_York:19971024T090000\r\nDTEND;TZID=America/New_York:19971024T100000\r\nRRULE:FREQ=DAILY;COUNT=5\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
			let cal = try new ICalendar().read(reader(ics))
			assert cal.timeZones.len() == 1 && cal.timeZones[0].observances.len() == 2
			let all = try cal.occurrences(instantOf(int64(0)), instantOf(int64(4102444800)))
			assert all.len() == 5
			// 1997-10-26 02:00 ends daylight time: 09:00 EDT is 13:00Z, EST 14:00Z.
			assert stamp(all[0].start) == "19971024T130000" && stamp(all[0].end) == "19971024T140000"
			assert stamp(all[1].start) == "19971025T130000"
			assert stamp(all[2].start) == "19971026T140000" && stamp(all[4].start) == "19971028T140000"
			assert all[2].recurrenceId.hour == 9 && all[2].recurrenceId.zone == "America/New_York"
			// A UTC exception removes the instance it names in the zone.
			let excepted = try new ICalendar().read(reader(ics.replace("RRULE:FREQ=DAILY;COUNT=5\r\n", "RRULE:FREQ=DAILY;COUNT=5\r\nEXDATE:19971026T140000Z\r\n")))
			let four = try excepted.occurrences(instantOf(int64(0)), instantOf(int64(4102444800)))
			assert four.len() == 4 && stamp(four[2].start) == "19971027T140000"
			// A time in the skipped hour takes the offset before the change.
			let gap = try cal.instant(CalendarTime{year: 1998, month: 4, day: 5, hour: 2, minute: 30, zone: "America/New_York"})
			assert stamp(gap) == "19980405T073000"
			let failed = ""
			cal.instant(CalendarTime{year: 1998, month: 1, day: 1, zone: "Mars/Olympus"}) onerror (err error) {
				failed = err is CalendarError ?? (err.code, "other")
				recover time.now()
			}
			assert failed == "zone"
		}

		@test()
		def TestOverrides() !none {
			let ics = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:test\r\nBEGIN:VEVENT\r\nUID:m1\r\nDTSTAMP:20240101T000000Z\r\nDTSTART:20240101T100000Z\r\nDURATION:PT1H\r\nRRULE:FREQ=DAILY;COUNT=5\r\nEXDATE:20240103T100000Z\r\nRDATE;VALUE=PERIOD:20240110T120000Z/PT30M\r\nSUMMARY:Standup\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nUID:m1\r\nDTSTAMP:20240101T000000Z\r\nRECURRENCE-ID:20240102T100000Z\r\nDTSTART:20240102T150000Z\r\nDTEND:20240102T153000Z\r\nSUMMARY:Standup (moved)\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nUID:m1\r\nDTSTAMP:20240101T000000Z\r\nRECURRENCE-ID;RANGE=THISANDFUTURE:20240104T100000Z\r\nDTSTART:20240104T110000Z\r\nDURATION:PT1H\r\nSUMMARY:Standup (later)\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
			let cal = try new ICalendar().read(reader(ics))
			let all = try cal.occurrences(instantOf(int64(0)), instantOf(int64(4102444800)))
			let text = all.mapElem<string>(o => stamp(o.start) + "-" + stamp(o.end) + " " + o.entry.summary)
			assert text.join("|") == "20240101T100000-20240101T110000 Standup|20240102T150000-20240102T153000 Standup (moved)|20240104T110000-20240104T120000 Standup (later)|20240105T110000-20240105T120000 Standup (later)|20240110T130000-20240110T140000 Standup (later)"
			// The window: only instances that overlap it.
			let some = try cal.occurrences(instantOf(civilSeconds(CalendarTime{year: 2024, month: 1, day: 2, hour: 15, minute: 15})), instantOf(civilSeconds(CalendarTime{year: 2024, month: 1, day: 4, hour: 11})))
			assert some.len() == 1 && some[0].entry.summary == "Standup (moved)"
		}

		@test()
		def TestReadWriteRoundTrip() !none {
			let ics = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Example//EN\r\nMETHOD:REQUEST\r\nX-WR-CALNAME:Team\r\nX-CUSTOM;X-P=1:kept\r\nBEGIN:VEVENT\r\nUID:e1@example.com\r\nDTSTAMP:20240101T000000Z\r\nDTSTART;VALUE=DATE:20240315\r\nDTEND;VALUE=DATE:20240316\r\nSUMMARY:Launch\\, day\\; one\r\nDESCRIPTION:Line one\\nline two\r\nLOCATION:Room 1\r\nORGANIZER;CN=\"Boss, The\":mailto:boss@example.com\r\nATTENDEE;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;RSVP=TRUE;CN=Ann:mailto:ann@example.com\r\nCATEGORIES:WORK,LAUNCH\r\nGEO:37.386013;-122.082932\r\nSTATUS:CONFIRMED\r\nTRANSP:TRANSPARENT\r\nSEQUENCE:3\r\nBEGIN:VALARM\r\nACTION:DISPLAY\r\nDESCRIPTION:Soon\r\nTRIGGER;RELATED=END:-PT15M\r\nEND:VALARM\r\nBEGIN:X-THING\r\nFOO:bar\r\nEND:X-THING\r\nEND:VEVENT\r\nBEGIN:VTODO\r\nUID:t1\r\nDTSTAMP:20240101T000000Z\r\nDUE:20240320T170000Z\r\nPERCENT-COMPLETE:40\r\nSUMMARY:Prepare\r\nEND:VTODO\r\nEND:VCALENDAR\r\n"
			let cal = try new ICalendar().read(reader(ics))
			assert cal.method == "REQUEST" && cal.name == "Team" && cal.extra.len() == 1 && cal.extra[0].name == "X-CUSTOM"
			assert cal.entries.len() == 2
			let e = cal.entries[0]
			assert e.kind == EntryKind.Event && e.summary == "Launch, day; one" && e.description == "Line one\nline two"
			let start = e.start
			assert !(start is none) && start.allDay && start.day == 15
			let organizer = e.organizer
			assert !(organizer is none) && organizer.name == "Boss, The"
			assert e.attendees[0].status == "ACCEPTED" && e.attendees[0].rsvp && e.categories.len() == 2
			assert e.transparent && e.sequence == 3 && e.status == "CONFIRMED"
			let geo = e.geo
			assert !(geo is none) && geo.latitude > 37.0
			let trigger = e.alarms[0].trigger
			assert !(trigger is none) && trigger.negative && trigger.minutes == 15 && e.alarms[0].fromEnd
			assert e.components.len() == 1 && e.components[0].name == "X-THING"
			assert cal.entries[1].kind == EntryKind.Todo && cal.entries[1].percentComplete == 40
			let out = new bytes.Buffer()
			try new ICalendar().write(cal, out)
			let text = string(out.bytes())
			for let line in text.split("\r\n") {
				assert line.bytes().len() <= 75
			}
			assert text.contains("\r\nSUMMARY:Launch\\, day\\; one\r\n") && text.contains("\r\nX-CUSTOM;X-P=1:kept\r\n")
			assert text.contains("\r\nDTSTART;VALUE=DATE:20240315\r\n") && text.contains("\r\nTRIGGER;RELATED=END:-PT15M\r\n")
			assert text.contains("ORGANIZER;CN=\"Boss, The\":mailto:boss@example.com")
			let back = try new ICalendar().read(reader(text))
			assert back.entries.len() == 2 && back.entries[0].summary == e.summary && back.entries[0].components.len() == 1
			assert back.entries[0].attendees[0].name == "Ann" && back.name == "Team"
			// The occurrence of a date event lasts the day.
			let days = try back.occurrences(instantOf(int64(0)), instantOf(int64(4102444800)))
			assert days.len() == 2 && stamp(days[0].end) == "20240316T000000"
		}

		@test()
		def TestValuesAndLoad() !none {
			let cal = new Calendar()
			let rule = RecurrenceRule{frequency: RecurrenceFrequency.Monthly, count: 3, byDay: [WeekdayNum{weekday:time.Weekday.Friday, ordinal:-1}], byMonth: [1, 6], weekStart: time.Weekday.Sunday}
			cal.entries = [CalendarEntry{uid:"x", summary:"Review", start:CalendarTime{year:2024, month:1, day:26, hour:16, utc:true}, duration:CalendarDuration{hours:1, minutes:30}, rules:[rule]}]
			let out = new bytes.Buffer()
			try new ICalendar().write(cal, out)
			let text = string(out.bytes())
			assert text.contains("\r\nRRULE:FREQ=MONTHLY;COUNT=3;BYDAY=-1FR;BYMONTH=1,6;WKST=SU\r\n") && text.contains("\r\nDURATION:PT1H30M\r\n")
			let back = try load(reader(text))
			assert back.entries[0].rules[0].byDay[0].ordinal == -1 && back.entries[0].rules[0].weekStart == time.Weekday.Sunday
			assert length(CalendarDuration{negative: true, weeks: 1, hours: 1}) == 0s - 169h
		}
	}
}
