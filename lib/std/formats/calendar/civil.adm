internal partial module std.formats.calendar.civil {
	use (
		std.time
		std.formats.calendar::*
	)

	// Proleptic Gregorian date arithmetic on wall-clock times, counted as
	// seconds from 1970-01-01T00:00 on the time's own clock.

	// `a` divided by `b`, rounded down.
	def floorDiv(a int64, b int64) int64 {
		let q = a / b
		return (a % b != int64(0) && ((a < int64(0)) != (b < int64(0)))) ?? (q - int64(1), q)
	}

	// Days from 1970-01-01 of a date.
	def daysFromCivil(year int, month int, day int) int64 {
		let y = int64(month <= 2 ?? (year - 1, year))
		let era = floorDiv(y, int64(400))
		let yoe = y - era * int64(400)
		let mp = int64(month > 2 ?? (month - 3, month + 9))
		let doy = (int64(153) * mp + int64(2)) / int64(5) + int64(day) - int64(1)
		let doe = yoe * int64(365) + yoe / int64(4) - yoe / int64(100) + doy
		return era * int64(146097) + doe - int64(719468)
	}

	// The date of a day count from 1970-01-01.
	def civilFromDays(days int64) (int, int, int) {
		let z = days + int64(719468)
		let era = floorDiv(z, int64(146097))
		let doe = z - era * int64(146097)
		let yoe = (doe - doe / int64(1460) + doe / int64(36524) - doe / int64(146096)) / int64(365)
		let doy = doe - (int64(365) * yoe + yoe / int64(4) - yoe / int64(100))
		let mp = (int64(5) * doy + int64(2)) / int64(153)
		let day = int(doy - (int64(153) * mp + int64(2)) / int64(5) + int64(1))
		let month = int(mp < int64(10) ?? (mp + int64(3), mp - int64(9)))
		let year = int(yoe + era * int64(400)) + (month <= 2 ?? (1, 0))
		return (year, month, day)
	}

	// The day of the week of a day count.
	def weekdayOfDays(days int64) time.Weekday {
		let idx = days + int64(4)
		idx = idx - floorDiv(idx, int64(7)) * int64(7)
		return time.Weekday(int(idx))
	}

	// The weekday's index, Sunday 0.
	def weekdayIndex(w time.Weekday) int {
		return int(w)
	}

	// Days in a year.
	def daysInYear(year int) int {
		return time.isLeapYear(year) ?? (366, 365)
	}

	// The day of the year, 1 for January 1st.
	def dayOfYear(year int, month int, day int) int {
		return int(daysFromCivil(year, month, day) - daysFromCivil(year, 1, 1)) + 1
	}

	// A wall time as seconds.
	def civilSeconds(t CalendarTime) int64 {
		return daysFromCivil(t.year, t.month, t.day) * int64(86400) + int64(t.hour * 3600 + t.minute * 60 + t.second)
	}

	// The wall time of `seconds`, with the zone and kind of `like`.
	def timeAt(seconds int64, like CalendarTime) CalendarTime {
		let days = floorDiv(seconds, int64(86400))
		let rest = int(seconds - days * int64(86400))
		let (y, m, d) = civilFromDays(days)
		return CalendarTime{year: y, month: m, day: d, hour: rest / 3600, minute: rest % 3600 / 60, second: rest % 60, allDay: like.allDay, utc: like.utc, zone: like.zone}
	}

	// The instant of UTC wall seconds.
	def instantOf(seconds int64) time.Time {
		return time.fromUnixNs(seconds * int64(1000000000))
	}

	// The UTC wall seconds of an instant.
	def secondsOf(t time.Time) int64 {
		return floorDiv(t.unixNs(), int64(1000000000))
	}

	// Seconds of a duration.
	def secondsIn(d duration) int64 {
		return int64(d) / int64(1000000000)
	}

	// The first day (day count) of the week holding `days`, weeks
	// starting on `weekStart`.
	def weekStartOf(days int64, weekStart time.Weekday) int64 {
		let back = (weekdayIndex(weekdayOfDays(days)) - weekdayIndex(weekStart) + 7) % 7
		return days - int64(back)
	}

	// The day count on which week 1 of `year` starts (RFC 5545: the first
	// week with at least four days of the year).
	def firstWeekOf(year int, weekStart time.Weekday) int64 {
		let jan1 = daysFromCivil(year, 1, 1)
		let offset = (weekdayIndex(weekdayOfDays(jan1)) - weekdayIndex(weekStart) + 7) % 7
		return offset <= 3 ?? (jan1 - int64(offset), jan1 + int64(7 - offset))
	}

	// The weeks in a year.
	def weeksIn(year int, weekStart time.Weekday) int {
		return int((firstWeekOf(year + 1, weekStart) - firstWeekOf(year, weekStart)) / int64(7))
	}

	// The week number of a day and the year the week belongs to.
	def weekNumber(days int64, weekStart time.Weekday) (int, int) {
		let (y, _, _) = civilFromDays(days)
		let first = firstWeekOf(y, weekStart)
		if days < first {
			let prev = firstWeekOf(y - 1, weekStart)
			return (int((days - prev) / int64(7)) + 1, y - 1)
		}
		let next = firstWeekOf(y + 1, weekStart)
		return (1, y + 1) when days >= next
		return (int((days - first) / int64(7)) + 1, y)
	}
}
