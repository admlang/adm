internal partial module std.formats.calendar.ical {
	use (
		std.time
		std.data.encoding
		std.formats.calendar::*
		std.formats.calendar.civil::*
	)

	// ---- content lines ----

	// The components of `text`, nested as BEGIN and END nest them.
	// Fails when the text holds no component.
	def parseComponents(text string) !CalendarComponent[] {
		let top CalendarComponent[] = []
		let stack CalendarComponent[] = []
		for let line in unfold(text) {
			let parsed = parseLine(line)
			continue when parsed is none
			let p CalendarProperty = parsed
			if p.name == "BEGIN" {
				stack.push(CalendarComponent{name: p.value.trim().upper()})
				continue
			}
			if p.name == "END" {
				continue when stack.len() == 0
				let done = stack[stack.len() - 1]
				stack = stack[:stack.len() - 1].clone()
				if stack.len() == 0 {
					top.push(done)
				} else {
					stack[stack.len() - 1].components.push(done)
				}
				continue
			}
			stack[stack.len() - 1].properties.push(p) when stack.len() > 0
		}
		// Components never closed still count.
		for stack.len() > 0 {
			let done = stack[stack.len() - 1]
			stack = stack[:stack.len() - 1].clone()
			if stack.len() == 0 {
				top.push(done)
			} else {
				stack[stack.len() - 1].components.push(done)
			}
		}
		fail "icalendar: no BEGIN" when top.len() == 0
		return top
	}

	// The lines of `text` with folding undone.
	def unfold(text string) string[] {
		let raw = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
		let out string[] = []
		for let line in raw {
			if (line.startsWith(" ") || line.startsWith("\t")) && out.len() > 0 {
				out[out.len() - 1] = out[out.len() - 1] + line[1:]
				continue
			}
			out.push(line)
		}
		return out
	}

	// A content line as a property; none for a line that is not one.
	def parseLine(line string) ?CalendarProperty {
		let b = line.bytes()
		let n = b.len()
		let i = 0
		for i < n && b[i] != byte(';') && b[i] != byte(':') {
			i++
		}
		return none when i >= n
		let name = string(b[:i]).trim().upper()
		return none when name == ""
		let params CalendarParam[] = []
		for i < n && b[i] == byte(';') {
			i++
			let start = i
			for i < n && b[i] != byte('=') && b[i] != byte(';') && b[i] != byte(':') {
				i++
			}
			let pname = string(b[start:i]).trim().upper()
			let values string[] = []
			if i < n && b[i] == byte('=') {
				i++
				for {
					if i < n && b[i] == byte('"') {
						i++
						let s = i
						for i < n && b[i] != byte('"') {
							i++
						}
						values.push(caretDecode(string(b[s:i])))
						i++ when i < n
					} else {
						let s = i
						for i < n && b[i] != byte(',') && b[i] != byte(';') && b[i] != byte(':') {
							i++
						}
						values.push(caretDecode(string(b[s:i]).trim()))
					}
					break unless i < n && b[i] == byte(',')
					i++
				}
			}
			params.push(CalendarParam{name: pname, values: values}) unless pname == ""
		}
		return none unless i < n && b[i] == byte(':')
		return CalendarProperty{name: name, value: string(b[i + 1:]), params: params}
	}

	// Undoes RFC 6868 parameter value encoding.
	def caretDecode(text string) string {
		return text unless text.contains("^")
		return text.replace("^^", "\u0001").replace("^n", "\n").replace("^N", "\n").replace("^'", "\"").replace("\u0001", "^")
	}

	// The values of every parameter called `name`, comma-joined.
	def param(p CalendarProperty, name string) string {
		let out string[] = []
		for let q in p.params {
			out = out + q.values when q.name == name
		}
		return out.join(",")
	}

	// The values of every parameter called `name`.
	def paramList(p CalendarProperty, name string) string[] {
		let out string[] = []
		for let q in p.params {
			out = out + q.values when q.name == name
		}
		return out
	}

	// `params` without those called one of `names`.
	def without(params CalendarParam[], names string[]) CalendarParam[] {
		return params.filter(q => !names.includes(q.name))
	}

	// Text with iCalendar escapes undone.
	def unescape(text string) string {
		return text unless text.contains("\\")
		let b = text.bytes()
		let out byte[] = []
		let i = 0
		for i < b.len() {
			if b[i] == byte('\\') && i + 1 < b.len() {
				let c = b[i + 1]
				out.push((c == byte('n') || c == byte('N')) ?? (byte('\n'), c))
				i += 2
				continue
			}
			out.push(b[i])
			i++
		}
		return string(out)
	}

	// A value split on the commas no backslash escapes, each unescaped.
	def textList(value string) string[] {
		let b = value.bytes()
		let out string[] = []
		return out when b.len() == 0
		let start = 0
		let i = 0
		for i < b.len() {
			if b[i] == byte('\\') {
				i += 2
				continue
			}
			if b[i] == byte(',') {
				out.push(unescape(string(b[start:i])))
				start = i + 1
			}
			i++
		}
		out.push(unescape(string(b[start:(i > b.len() ?? (b.len(), i))])))
		return out
	}

	// ---- values ----

	// Whether `text` is all ASCII digits.
	def digits(text string) bool {
		return text != "" && text.isNumeric() && !text.contains("-") && !text.contains("+") && !text.contains(".")
	}

	// A DATE (`19970714`) or DATE-TIME (`19970714T133000`, `...Z`), in the
	// zone `zone` names.
	def timeOf(text string, zone string, dateOnly bool) ?CalendarTime {
		let v = text.trim()
		return none unless v.len() >= 8 && digits(v[:8])
		let t = CalendarTime{year: v[:4].toInt<int>(), month: v[4:6].toInt<int>(), day: v[6:8].toInt<int>()}
		return none unless t.month >= 1 && t.month <= 12 && t.day >= 1 && t.day <= 31
		if v.len() == 8 || dateOnly {
			t.allDay = true
			return t
		}
		return none unless v[8:9] == "T" && v.len() >= 15 && digits(v[9:15])
		t.hour = v[9:11].toInt<int>()
		t.minute = v[11:13].toInt<int>()
		t.second = v[13:15].toInt<int>()
		t.second = 59 when t.second == 60
		if v.len() > 15 && v[15:16].upper() == "Z" {
			t.utc = true
		} else {
			t.zone = zone
		}
		return t
	}

	// The time of a property: its value, `VALUE=DATE` and `TZID` read.
	def propertyTime(p CalendarProperty) ?CalendarTime {
		return timeOf(p.value, param(p, "TZID"), param(p, "VALUE").upper() == "DATE")
	}

	// Every time of a property with a comma list (`EXDATE`, `RDATE`).
	def propertyTimes(p CalendarProperty) CalendarTime[] {
		let out CalendarTime[] = []
		let zone = param(p, "TZID")
		let dateOnly = param(p, "VALUE").upper() == "DATE"
		for let part in p.value.split(",") {
			let t = timeOf(part, zone, dateOnly)
			out.push(t) unless t is none
		}
		return out
	}

	// A timestamp (`DTSTAMP`, `CREATED`...): a UTC date-time.
	def stampOf(text string) ?time.Time {
		let t = timeOf(text, "", false)
		return none when t is none
		return instantOf(civilSeconds(t))
	}

	// A DURATION: `P15DT5H0M20S`, `-PT15M`, `P7W`.
	def durationOf(text string) ?CalendarDuration {
		let v = text.trim().upper()
		let d = CalendarDuration{}
		if v.startsWith("-") {
			d.negative = true
			v = v[1:]
		} else if v.startsWith("+") {
			v = v[1:]
		}
		return none unless v.startsWith("P") && v.len() > 1
		let number = ""
		let inTime = false
		let seen = false
		for let c in v[1:].bytes() {
			if c >= byte('0') && c <= byte('9') {
				number += string([c])
				continue
			}
			if c == byte('T') {
				inTime = true
				continue
			}
			return none when number == ""
			let n = number.toInt<int>()
			number = ""
			seen = true
			switch {
				case c == byte('W') && !inTime:
					d.weeks = n
				case c == byte('D') && !inTime:
					d.days = n
				case c == byte('H') && inTime:
					d.hours = n
				case c == byte('M') && inTime:
					d.minutes = n
				case c == byte('S') && inTime:
					d.seconds = n
				default:
					return none
			}
		}
		return none unless seen && number == ""
		return d
	}

	// A UTC-OFFSET: `+0100`, `-0500`, `+053000`.
	def offsetOf(text string) ?duration {
		let v = text.trim()
		return none unless v.len() >= 5
		let sign = v[:1]
		let rest = v[1:]
		return none unless (sign := "+" || "-") && digits(rest) && (rest.len() == 4 || rest.len() == 6)
		let seconds = rest[:2].toInt<int>() * 3600 + rest[2:4].toInt<int>() * 60 + (rest.len() == 6 ?? (rest[4:6].toInt<int>(), 0))
		let d = duration(int64(seconds) * 1000000000)
		return sign == "-" ?? (0s - d, d)
	}

	// A PERIOD: `start/end` or `start/duration`.
	def periodOf(text string, zone string) ?Period {
		let slash = text.indexOf("/")
		if slash < 0 {
			let t = timeOf(text, zone, false)
			return none when t is none
			return Period{start: t}
		}
		let start = timeOf(text[:slash], zone, false)
		return none when start is none
		let rest = text[slash + 1:]
		let d = durationOf(rest)
		return Period{start: start, duration: d} unless d is none
		let end = timeOf(rest, zone, false)
		return none when end is none
		return Period{start: start, end: end}
	}

	// The weekday of a two-letter code (`MO`).
	def weekdayOf(code string) ?time.Weekday {
		switch {
			case code == "SU":
				return time.Weekday.Sunday
			case code == "MO":
				return time.Weekday.Monday
			case code == "TU":
				return time.Weekday.Tuesday
			case code == "WE":
				return time.Weekday.Wednesday
			case code == "TH":
				return time.Weekday.Thursday
			case code == "FR":
				return time.Weekday.Friday
			case code == "SA":
				return time.Weekday.Saturday
		}
		return none
	}

	// A comma list of integers; none when one is not.
	def intsOf(text string) ?int[] {
		let out int[] = []
		for let part in text.split(",") {
			let v = part.trim()
			let negative = v.startsWith("-")
			let bare = v.trimPrefix("-").trimPrefix("+")
			return none unless digits(bare)
			out.push(negative ?? (0 - bare.toInt<int>(), bare.toInt<int>()))
		}
		return out
	}

	// A RECUR value: `FREQ=MONTHLY;BYDAY=-1SU;COUNT=10`.
	def ruleOf(text string) ?RecurrenceRule {
		let rule = RecurrenceRule{frequency: RecurrenceFrequency.Daily}
		let hasFrequency = false
		for let part in text.trim().split(";") {
			let eq = part.indexOf("=")
			continue when eq < 0
			let key = part[:eq].trim().upper()
			let value = part[eq + 1:].trim()
			let upper = value.upper()
			switch {
				case key == "FREQ":
					let f = frequencyOf(upper)
					return none when f is none
					rule.frequency = f
					hasFrequency = true
				case key == "INTERVAL":
					return none unless digits(value)
					rule.interval = value.toInt<int>()
				case key == "COUNT":
					return none unless digits(value)
					rule.count = value.toInt<int>()
				case key == "UNTIL":
					rule.until = timeOf(value, "", false)
				case key == "WKST":
					let w = weekdayOf(upper)
					return none when w is none
					rule.weekStart = w
				case key == "RSCALE":
					rule.scale = upper
				case key == "SKIP":
					return none unless upper := "OMIT" || "BACKWARD" || "FORWARD"
					rule.skip = upper
				case key == "BYDAY":
					for let item in upper.split(",") {
						let code = item.trim()
						continue when code.len() < 2
						let w = weekdayOf(code[code.len() - 2:])
						return none when w is none
						let number = code[:code.len() - 2]
						let ordinal = 0
						if number != "" {
							let n = intsOf(number)
							return none when n is none
							ordinal = n[0]
						}
						rule.byDay.push(WeekdayNum{weekday: w, ordinal: ordinal})
					}
				default:
					if key := "BYSECOND" || "BYMINUTE" || "BYHOUR" || "BYMONTHDAY" || "BYYEARDAY" || "BYWEEKNO" || "BYMONTH" || "BYSETPOS" {
						// RFC 7529 leap months (`5L`) are for other scales.
						let list = intsOf(upper.replace("L", ""))
						return none when list is none
						switch {
							case key == "BYSECOND":
								rule.bySecond = list
							case key == "BYMINUTE":
								rule.byMinute = list
							case key == "BYHOUR":
								rule.byHour = list
							case key == "BYMONTHDAY":
								rule.byMonthDay = list
							case key == "BYYEARDAY":
								rule.byYearDay = list
							case key == "BYWEEKNO":
								rule.byWeekNo = list
							case key == "BYMONTH":
								rule.byMonth = list
							default:
								rule.bySetPos = list
						}
					}
			}
		}
		return none unless hasFrequency
		return rule
	}

	// The frequency a FREQ value names.
	def frequencyOf(text string) ?RecurrenceFrequency {
		switch {
			case text == "YEARLY":
				return RecurrenceFrequency.Yearly
			case text == "MONTHLY":
				return RecurrenceFrequency.Monthly
			case text == "WEEKLY":
				return RecurrenceFrequency.Weekly
			case text == "DAILY":
				return RecurrenceFrequency.Daily
			case text == "HOURLY":
				return RecurrenceFrequency.Hourly
			case text == "MINUTELY":
				return RecurrenceFrequency.Minutely
			case text == "SECONDLY":
				return RecurrenceFrequency.Secondly
		}
		return none
	}

	// ---- model ----

	// A calendar component as the model.
	def calendarOf(c CalendarComponent) Calendar {
		let cal = new Calendar()
		cal.productId = ""
		let seen = map<string, bool>{}
		for let p in c.properties {
			let first = !seen.hasKey(p.name)
			seen[p.name] = true
			let text = unescape(p.value)
			switch {
				case p.name == "PRODID" && first:
					cal.productId = text
				case p.name == "VERSION" && first:
					cal.version = text.trim()
				case p.name == "CALSCALE" && first:
					cal.scale = text.trim().upper()
				case p.name == "METHOD" && first:
					cal.method = text.trim().upper()
				case p.name == "NAME" && first:
					cal.name = text
				case p.name == "X-WR-CALNAME" && cal.name == "":
					cal.name = text
				case p.name == "DESCRIPTION" && first:
					cal.description = text
				case p.name == "X-WR-CALDESC" && cal.description == "":
					cal.description = text
				case (p.name := "COLOR" || "X-APPLE-CALENDAR-COLOR") && cal.color == "":
					cal.color = text.trim()
				case p.name == "UID" && first:
					cal.uid = text.trim()
				case p.name == "URL" && first:
					cal.url = text.trim()
				case p.name == "SOURCE" && first:
					cal.source = text.trim()
				case p.name == "REFRESH-INTERVAL" && first:
					cal.refreshInterval = durationOf(p.value)
				case p.name == "LAST-MODIFIED" && first:
					cal.lastModified = stampOf(p.value)
				case p.name == "CATEGORIES":
					cal.categories = cal.categories + textList(p.value)
				case p.name == "IMAGE":
					cal.images.push(p.value.trim())
				default:
					cal.extra.push(p)
			}
		}
		for let sub in c.components {
			switch {
				case sub.name := "VEVENT" || "VTODO" || "VJOURNAL":
					cal.entries.push(entryOf(sub))
				case sub.name == "VFREEBUSY":
					cal.freeBusy.push(freeBusyOf(sub))
				case sub.name == "VTIMEZONE":
					cal.timeZones.push(zoneOf(sub))
				default:
					cal.components.push(sub)
			}
		}
		return cal
	}

	// An ORGANIZER or ATTENDEE.
	def addressOf(p CalendarProperty) CalendarAddress {
		let a = CalendarAddress{address: p.value.trim()}
		a.name = param(p, "CN")
		a.role = param(p, "ROLE").upper()
		a.status = param(p, "PARTSTAT").upper()
		a.rsvp = param(p, "RSVP").upper() == "TRUE"
		a.kind = param(p, "CUTYPE").upper()
		a.members = paramList(p, "MEMBER")
		a.delegatedTo = paramList(p, "DELEGATED-TO")
		a.delegatedFrom = paramList(p, "DELEGATED-FROM")
		a.sentBy = param(p, "SENT-BY")
		a.directory = param(p, "DIR")
		a.params = without(p.params, ["CN", "ROLE", "PARTSTAT", "RSVP", "CUTYPE", "MEMBER", "DELEGATED-TO", "DELEGATED-FROM", "SENT-BY", "DIR"])
		return a
	}

	// An ATTACH.
	def attachmentOf(p CalendarProperty) Attachment {
		let a = Attachment{mediaType: param(p, "FMTTYPE")}
		if param(p, "ENCODING").upper() == "BASE64" || param(p, "VALUE").upper() == "BINARY" {
			a.data = encoding.base64decode(p.value.trim()) onerror recover byte[]
		} else {
			a.uri = p.value.trim()
		}
		return a
	}

	// A GEO: `37.386013;-122.082932`.
	def geoOf(text string) ?Geo {
		let parts = text.trim().split(";")
		return none unless parts.len() == 2
		return Geo{latitude: parseFloat<float64>(parts[0].trim()), longitude: parseFloat<float64>(parts[1].trim())}
	}

	// An event, to-do or journal component as an entry.
	def entryOf(c CalendarComponent) CalendarEntry {
		let e = CalendarEntry{}
		e.kind = c.name == "VTODO" ?? (EntryKind.Todo, c.name == "VJOURNAL" ?? (EntryKind.Journal, EntryKind.Event))
		let seen = map<string, bool>{}
		for let p in c.properties {
			let first = !seen.hasKey(p.name)
			seen[p.name] = true
			let text = unescape(p.value)
			switch {
				case p.name == "UID" && first:
					e.uid = text.trim()
				case p.name == "SEQUENCE" && first && digits(text.trim()):
					e.sequence = text.trim().toInt<int>()
				case p.name == "DTSTAMP" && first:
					e.stamp = stampOf(p.value)
				case p.name == "CREATED" && first:
					e.created = stampOf(p.value)
				case p.name == "LAST-MODIFIED" && first:
					e.lastModified = stampOf(p.value)
				case p.name == "DTSTART" && first:
					e.start = propertyTime(p)
				case p.name == "DTEND" && first:
					e.end = propertyTime(p)
				case p.name == "DURATION" && first:
					e.duration = durationOf(p.value)
				case p.name == "DUE" && first:
					e.due = propertyTime(p)
				case p.name == "COMPLETED" && first:
					e.completed = stampOf(p.value)
				case p.name == "PERCENT-COMPLETE" && first && digits(text.trim()):
					e.percentComplete = text.trim().toInt<int>()
				case p.name == "SUMMARY" && first:
					e.summary = text
				case p.name == "DESCRIPTION" && first:
					e.description = text
				case p.name == "LOCATION" && first:
					e.location = text
				case p.name == "STATUS" && first:
					e.status = text.trim().upper()
				case p.name == "CLASS" && first:
					e.classification = text.trim().upper()
				case p.name == "TRANSP" && first:
					e.transparent = text.trim().upper() == "TRANSPARENT"
				case p.name == "PRIORITY" && first && digits(text.trim()):
					e.priority = text.trim().toInt<int>()
				case p.name == "URL" && first:
					e.url = p.value.trim()
				case p.name == "GEO" && first:
					e.geo = geoOf(text)
				case p.name == "ORGANIZER" && first:
					e.organizer = addressOf(p)
				case p.name == "ATTENDEE":
					e.attendees.push(addressOf(p))
				case p.name == "CATEGORIES":
					e.categories = e.categories + textList(p.value)
				case p.name == "COMMENT":
					e.comments.push(text)
				case p.name == "CONTACT":
					e.contacts.push(text)
				case p.name == "RESOURCES":
					e.resources = e.resources + textList(p.value)
				case p.name == "RELATED-TO":
					let kind = param(p, "RELTYPE").upper()
					e.related.push(Relation{uid: text.trim(), kind: kind == "" ?? ("PARENT", kind)})
				case p.name == "RECURRENCE-ID" && first:
					e.recurrenceId = propertyTime(p)
					e.thisAndFuture = param(p, "RANGE").upper() == "THISANDFUTURE"
				case p.name == "RRULE":
					let rule = ruleOf(p.value)
					if rule is none {
						e.extra.push(p)
					} else {
						e.rules.push(rule)
					}
				case p.name == "RDATE":
					let zone = param(p, "TZID")
					let dateOnly = param(p, "VALUE").upper() == "DATE"
					for let part in p.value.split(",") {
						if dateOnly {
							let t = timeOf(part, zone, true)
							e.dates.push(Period{start: t}) unless t is none
						} else {
							let period = periodOf(part.trim(), zone)
							e.dates.push(period) unless period is none
						}
					}
				case p.name == "EXDATE":
					e.exceptions = e.exceptions + propertyTimes(p)
				case p.name == "ATTACH":
					e.attachments.push(attachmentOf(p))
				case p.name == "COLOR" && first:
					e.color = text.trim()
				case p.name == "IMAGE":
					e.images.push(p.value.trim())
				case p.name == "CONFERENCE":
					e.conferences.push(p.value.trim())
				case p.name == "REQUEST-STATUS":
					e.requestStatus.push(text)
				default:
					e.extra.push(p)
			}
		}
		for let sub in c.components {
			if sub.name == "VALARM" {
				e.alarms.push(alarmOf(sub))
			} else {
				e.components.push(sub)
			}
		}
		return e
	}

	// A VALARM component.
	def alarmOf(c CalendarComponent) Alarm {
		let a = Alarm{action: ""}
		for let p in c.properties {
			let text = unescape(p.value)
			switch {
				case p.name == "ACTION":
					a.action = text.trim().upper()
				case p.name == "TRIGGER":
					if param(p, "VALUE").upper() == "DATE-TIME" {
						a.triggerAt = stampOf(p.value)
					} else {
						a.trigger = durationOf(p.value)
						a.fromEnd = param(p, "RELATED").upper() == "END"
					}
				case p.name == "REPEAT" && digits(text.trim()):
					a.repeat = text.trim().toInt<int>()
				case p.name == "DURATION":
					a.interval = durationOf(p.value)
				case p.name == "DESCRIPTION":
					a.description = text
				case p.name == "SUMMARY":
					a.summary = text
				case p.name == "ATTENDEE":
					a.attendees.push(addressOf(p))
				case p.name == "ATTACH":
					a.attachments.push(attachmentOf(p))
				case p.name == "UID":
					a.uid = text.trim()
				case p.name == "ACKNOWLEDGED":
					a.acknowledged = stampOf(p.value)
				default:
					a.extra.push(p)
			}
		}
		return a
	}

	// A VFREEBUSY component.
	def freeBusyOf(c CalendarComponent) FreeBusy {
		let f = FreeBusy{}
		for let p in c.properties {
			let text = unescape(p.value)
			switch {
				case p.name == "UID":
					f.uid = text.trim()
				case p.name == "DTSTAMP":
					f.stamp = stampOf(p.value)
				case p.name == "DTSTART":
					f.start = propertyTime(p)
				case p.name == "DTEND":
					f.end = propertyTime(p)
				case p.name == "ORGANIZER":
					f.organizer = addressOf(p)
				case p.name == "ATTENDEE":
					f.attendees.push(addressOf(p))
				case p.name == "FREEBUSY":
					let kind = param(p, "FBTYPE").upper()
					for let part in p.value.split(",") {
						let period = periodOf(part.trim(), "")
						continue when period is none
						let startS = civilSeconds(period.start)
						let endS = startS
						let pEnd = period.end
						let pDur = period.duration
						if !(pEnd is none) {
							endS = civilSeconds(pEnd)
						} else if !(pDur is none) {
							endS = startS + secondsIn(length(pDur))
						}
						f.periods.push(BusyPeriod{start: instantOf(startS), end: instantOf(endS), kind: kind == "" ?? ("BUSY", kind)})
					}
				case p.name == "URL":
					f.url = p.value.trim()
				case p.name == "COMMENT":
					f.comments.push(text)
				case p.name == "CONTACT":
					f.contact = text
				default:
					f.extra.push(p)
			}
		}
		return f
	}

	// A VTIMEZONE component.
	def zoneOf(c CalendarComponent) TimeZone {
		let z = TimeZone{id: ""}
		for let p in c.properties {
			switch {
				case p.name == "TZID":
					z.id = unescape(p.value).trim()
				case p.name == "TZURL":
					z.url = p.value.trim()
				case p.name == "LAST-MODIFIED":
					z.lastModified = stampOf(p.value)
				default:
					z.extra.push(p)
			}
		}
		for let sub in c.components {
			continue unless sub.name := "STANDARD" || "DAYLIGHT"
			let o = Observance{daylight: sub.name == "DAYLIGHT", start: CalendarTime{year: 1970, month: 1, day: 1}, offsetFrom: 0s, offsetTo: 0s}
			for let p in sub.properties {
				switch {
					case p.name == "DTSTART":
						let t = timeOf(p.value, "", false)
						o.start = t unless t is none
					case p.name == "TZOFFSETFROM":
						let off = offsetOf(p.value)
						o.offsetFrom = off unless off is none
					case p.name == "TZOFFSETTO":
						let off = offsetOf(p.value)
						o.offsetTo = off unless off is none
					case p.name == "TZNAME":
						o.names.push(unescape(p.value))
					case p.name == "RRULE":
						let rule = ruleOf(p.value)
						o.rules.push(rule) unless rule is none
					case p.name == "RDATE":
						for let part in p.value.split(",") {
							let t = timeOf(part, "", param(p, "VALUE").upper() == "DATE")
							o.dates.push(t) unless t is none
						}
					case p.name == "COMMENT":
						o.comments.push(unescape(p.value))
					default:
						o.extra.push(p)
				}
			}
			z.observances.push(o)
		}
		return z
	}
}
