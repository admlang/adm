internal partial module std.formats.calendar.ical {
	use (
		std.time
		std.crypto::(UUID)
		std.data.encoding
		std.formats.calendar::*
		std.formats.calendar.civil::*
	)

	// ---- content lines ----

	// A component as folded content lines.
	def componentText(c CalendarComponent) string {
		let out = fold("BEGIN:" + c.name)
		for let p in c.properties {
			out += propertyLine(p)
		}
		for let sub in c.components {
			out += componentText(sub)
		}
		return out + fold("END:" + c.name)
	}

	// A property as a folded content line.
	def propertyLine(p CalendarProperty) string {
		let head = p.name
		for let q in p.params {
			continue when q.values.len() == 0
			head += ";" + q.name + "=" + q.values.mapElem<string>(v => paramText(v)).join(",")
		}
		return fold(head + ":" + p.value)
	}

	// A parameter value as written: quoted when it holds a separator,
	// caret-encoded (RFC 6868).
	def paramText(value string) string {
		let v = value.replace("^", "^^").replace("\r\n", "^n").replace("\n", "^n").replace("\"", "^'")
		return "\"" + v + "\"" when v.contains(",") || v.contains(";") || v.contains(":")
		return v
	}

	// A content line folded at 75 octets, never inside a UTF-8 sequence,
	// ended with CRLF.
	def fold(line string) string {
		let b = line.bytes()
		return line + "\r\n" when b.len() <= 75
		let out byte[] = []
		let width = 0
		for let i = 0; i < b.len(); i++ {
			let continuation = (int(b[i]) & 0xC0) == 0x80
			if width >= 75 && !continuation {
				out.push(byte('\r'))
				out.push(byte('\n'))
				out.push(byte(' '))
				width = 1
			}
			out.push(b[i])
			width++
		}
		out.push(byte('\r'))
		out.push(byte('\n'))
		return string(out)
	}

	// Text with iCalendar escapes.
	def escape(text string) string {
		return text.replace("\\", "\\\\").replace("\r\n", "\\n").replace("\n", "\\n").replace(",", "\\,").replace(";", "\\;")
	}

	// ---- values ----

	def pad(n int, width int) string {
		let s = n.str()
		for s.len() < width {
			s = "0" + s
		}
		return s
	}

	// A DATE or DATE-TIME value.
	def timeText(t CalendarTime) string {
		let date = pad(t.year, 4) + pad(t.month, 2) + pad(t.day, 2)
		return date when t.allDay
		return date + "T" + pad(t.hour, 2) + pad(t.minute, 2) + pad(t.second, 2) + (t.utc ?? ("Z", ""))
	}

	// A UTC timestamp.
	def stampText(t time.Time) string {
		return pad(t.year(), 4) + pad(t.month(), 2) + pad(t.day(), 2) + "T" + pad(t.hour(), 2) + pad(t.minute(), 2) + pad(t.second(), 2) + "Z"
	}

	// A DURATION value.
	def durationText(d CalendarDuration) string {
		let out = d.negative ?? ("-P", "P")
		return out + d.weeks.str() + "W" when d.weeks > 0 && d.days == 0 && d.hours == 0 && d.minutes == 0 && d.seconds == 0
		let days = d.weeks * 7 + d.days
		out += days.str() + "D" when days > 0
		if d.hours > 0 || d.minutes > 0 || d.seconds > 0 {
			out += "T"
			out += d.hours.str() + "H" when d.hours > 0
			out += d.minutes.str() + "M" when d.minutes > 0
			out += d.seconds.str() + "S" when d.seconds > 0
		}
		return out == "P" || out == "-P" ?? (out + "T0S", out)
	}

	// A UTC-OFFSET value.
	def offsetText(d duration) string {
		let seconds = secondsIn(d)
		let sign = seconds < int64(0) ?? ("-", "+")
		let abs = int(seconds < int64(0) ?? (int64(0) - seconds, seconds))
		let out = sign + pad(abs / 3600, 2) + pad(abs % 3600 / 60, 2)
		out += pad(abs % 60, 2) when abs % 60 != 0
		return out
	}

	// The two-letter code of a weekday.
	def weekdayCode(w time.Weekday) string {
		return ["SU", "MO", "TU", "WE", "TH", "FR", "SA"][int(w)]
	}

	// A RECUR value.
	def ruleText(r RecurrenceRule) string {
		let parts = ["FREQ=" + r.frequency.value]
		parts.push("RSCALE=" + r.scale) when r.scale != ""
		parts.push("SKIP=" + r.skip) when r.scale != "" && r.skip != "OMIT"
		let until = r.until
		parts.push("UNTIL=" + timeText(until)) unless until is none
		parts.push("COUNT=" + r.count.str()) when r.count > 0
		parts.push("INTERVAL=" + r.interval.str()) when r.interval > 1
		let lists = [("BYSECOND", r.bySecond), ("BYMINUTE", r.byMinute), ("BYHOUR", r.byHour)]
		for let (_, entry) in lists {
			let (name, values) = entry
			parts.push(name + "=" + values.mapElem<string>(v => v.str()).join(",")) when values.len() > 0
		}
		parts.push("BYDAY=" + r.byDay.mapElem<string>(w => (w.ordinal == 0 ?? ("", w.ordinal.str())) + weekdayCode(w.weekday)).join(",")) when r.byDay.len() > 0
		let more = [("BYMONTHDAY", r.byMonthDay), ("BYYEARDAY", r.byYearDay), ("BYWEEKNO", r.byWeekNo), ("BYMONTH", r.byMonth), ("BYSETPOS", r.bySetPos)]
		for let (_, entry) in more {
			let (name, values) = entry
			parts.push(name + "=" + values.mapElem<string>(v => v.str()).join(",")) when values.len() > 0
		}
		parts.push("WKST=" + weekdayCode(r.weekStart)) when r.weekStart != time.Weekday.Monday
		return parts.join(";")
	}

	// ---- model ----

	// A property with no parameters.
	def plain(name string, value string) CalendarProperty {
		return CalendarProperty{name: name, value: value}
	}

	// A text property, unless the text is empty.
	def addText(c CalendarComponent, name string, text string) {
		c.properties.push(plain(name, escape(text))) unless text == ""
	}

	// A time property with `VALUE=DATE` or `TZID` as its time needs.
	def timeProperty(name string, t CalendarTime) CalendarProperty {
		let p = plain(name, timeText(t))
		p.params.push(CalendarParam{name: "VALUE", values: ["DATE"]}) when t.allDay
		p.params.push(CalendarParam{name: "TZID", values: [t.zone]}) when !t.allDay && !t.utc && t.zone != ""
		return p
	}

	// A property of several times (`EXDATE`), grouped by zone and kind.
	def timesProperties(name string, times CalendarTime[]) CalendarProperty[] {
		let out CalendarProperty[] = []
		let keys string[] = []
		let groups map<string, CalendarTime[]> = map<string, CalendarTime[]>{}
		for let t in times {
			let key = (t.allDay ?? ("D", t.utc ?? ("U", "L"))) + t.zone
			if !groups.hasKey(key) {
				keys.push(key)
				groups[key] = []
			}
			groups[key] = groups[key] + [t]
		}
		for let key in keys {
			let group = groups[key]
			let p = timeProperty(name, group[0])
			p.value = group.mapElem<string>(t => timeText(t)).join(",")
			out.push(p)
		}
		return out
	}

	// An ORGANIZER or ATTENDEE property.
	def addressProperty(name string, a CalendarAddress) CalendarProperty {
		let p = plain(name, a.address)
		let add = def (pname string, value string) {
			p.params.push(CalendarParam{name: pname, values: [value]}) unless value == ""
		}
		add("CN", a.name)
		add("ROLE", a.role)
		add("PARTSTAT", a.status)
		add("RSVP", a.rsvp ?? ("TRUE", ""))
		add("CUTYPE", a.kind)
		p.params.push(CalendarParam{name: "MEMBER", values: a.members}) when a.members.len() > 0
		p.params.push(CalendarParam{name: "DELEGATED-TO", values: a.delegatedTo}) when a.delegatedTo.len() > 0
		p.params.push(CalendarParam{name: "DELEGATED-FROM", values: a.delegatedFrom}) when a.delegatedFrom.len() > 0
		add("SENT-BY", a.sentBy)
		add("DIR", a.directory)
		p.params = p.params + a.params
		return p
	}

	// An ATTACH property.
	def attachmentProperty(a Attachment) CalendarProperty {
		let p = plain("ATTACH", a.uri)
		if a.uri == "" {
			p.value = encoding.base64encode(a.data)
			p.params.push(CalendarParam{name: "ENCODING", values: ["BASE64"]})
			p.params.push(CalendarParam{name: "VALUE", values: ["BINARY"]})
		}
		p.params.push(CalendarParam{name: "FMTTYPE", values: [a.mediaType]}) when a.mediaType != ""
		return p
	}

	// A calendar as a VCALENDAR component.
	def componentOf(cal Calendar) CalendarComponent {
		let c = CalendarComponent{name: "VCALENDAR"}
		c.properties.push(plain("VERSION", cal.version == "" ?? ("2.0", cal.version)))
		c.properties.push(plain("PRODID", escape(cal.productId == "" ?? ("-//adm-lang.dev//std.formats.calendar//EN", cal.productId))))
		c.properties.push(plain("CALSCALE", cal.scale)) when cal.scale != ""
		c.properties.push(plain("METHOD", cal.method)) when cal.method != ""
		addText(c, "NAME", cal.name)
		addText(c, "DESCRIPTION", cal.description)
		c.properties.push(plain("COLOR", cal.color)) when cal.color != ""
		c.properties.push(plain("UID", cal.uid)) when cal.uid != ""
		c.properties.push(plain("URL", cal.url)) when cal.url != ""
		c.properties.push(plain("SOURCE", cal.source)) when cal.source != ""
		let refresh = cal.refreshInterval
		c.properties.push(CalendarProperty{name: "REFRESH-INTERVAL", value: durationText(refresh), params: [CalendarParam{name:"VALUE", values:["DURATION"]}]}) unless refresh is none
		let modified = cal.lastModified
		c.properties.push(plain("LAST-MODIFIED", stampText(modified))) unless modified is none
		c.properties.push(plain("CATEGORIES", cal.categories.mapElem<string>(s => escape(s)).join(","))) when cal.categories.len() > 0
		for let image in cal.images {
			c.properties.push(CalendarProperty{name: "IMAGE", value: image, params: [CalendarParam{name:"VALUE", values:["URI"]}]})
		}
		c.properties = c.properties + cal.extra
		for let z in cal.timeZones {
			c.components.push(zoneComponent(z))
		}
		for let e in cal.entries {
			c.components.push(entryComponent(e))
		}
		for let f in cal.freeBusy {
			c.components.push(freeBusyComponent(f))
		}
		c.components = c.components + cal.components
		return c
	}

	// An entry as its component.
	def entryComponent(e CalendarEntry) CalendarComponent {
		let c = CalendarComponent{name: e.kind.value}
		c.properties.push(plain("UID", e.uid == "" ?? (new UUID().str(), e.uid)))
		let stamp = e.stamp
		c.properties.push(plain("DTSTAMP", stampText(stamp is none ?? (time.now(), stamp))))
		let start = e.start
		c.properties.push(timeProperty("DTSTART", start)) unless start is none
		let end = e.end
		c.properties.push(timeProperty("DTEND", end)) unless end is none
		let due = e.due
		c.properties.push(timeProperty("DUE", due)) unless due is none
		let d = e.duration
		c.properties.push(plain("DURATION", durationText(d))) unless d is none
		let rid = e.recurrenceId
		if !(rid is none) {
			let p = timeProperty("RECURRENCE-ID", rid)
			p.params.push(CalendarParam{name: "RANGE", values: ["THISANDFUTURE"]}) when e.thisAndFuture
			c.properties.push(p)
		}
		c.properties.push(plain("SEQUENCE", e.sequence.str())) when e.sequence > 0
		let created = e.created
		c.properties.push(plain("CREATED", stampText(created))) unless created is none
		let modified = e.lastModified
		c.properties.push(plain("LAST-MODIFIED", stampText(modified))) unless modified is none
		addText(c, "SUMMARY", e.summary)
		addText(c, "DESCRIPTION", e.description)
		addText(c, "LOCATION", e.location)
		c.properties.push(plain("STATUS", e.status)) when e.status != ""
		c.properties.push(plain("CLASS", e.classification)) when e.classification != ""
		c.properties.push(plain("TRANSP", "TRANSPARENT")) when e.transparent
		c.properties.push(plain("PRIORITY", e.priority.str())) when e.priority > 0
		let completed = e.completed
		c.properties.push(plain("COMPLETED", stampText(completed))) unless completed is none
		c.properties.push(plain("PERCENT-COMPLETE", e.percentComplete.str())) when e.percentComplete >= 0
		c.properties.push(plain("URL", e.url)) when e.url != ""
		let geo = e.geo
		c.properties.push(plain("GEO", "{geo.latitude};{geo.longitude}")) unless geo is none
		let organizer = e.organizer
		c.properties.push(addressProperty("ORGANIZER", organizer)) unless organizer is none
		for let a in e.attendees {
			c.properties.push(addressProperty("ATTENDEE", a))
		}
		c.properties.push(plain("CATEGORIES", e.categories.mapElem<string>(s => escape(s)).join(","))) when e.categories.len() > 0
		for let s in e.comments {
			addText(c, "COMMENT", s)
		}
		for let s in e.contacts {
			addText(c, "CONTACT", s)
		}
		c.properties.push(plain("RESOURCES", e.resources.mapElem<string>(s => escape(s)).join(","))) when e.resources.len() > 0
		for let r in e.related {
			let p = plain("RELATED-TO", escape(r.uid))
			p.params.push(CalendarParam{name: "RELTYPE", values: [r.kind]}) unless r.kind := "PARENT" || ""
			c.properties.push(p)
		}
		for let rule in e.rules {
			c.properties.push(plain("RRULE", ruleText(rule)))
		}
		for let period in e.dates {
			let pEnd = period.end
			let pDur = period.duration
			if pEnd is none && pDur is none {
				c.properties.push(timeProperty("RDATE", period.start))
			} else {
				let p = timeProperty("RDATE", period.start)
				p.params.push(CalendarParam{name: "VALUE", values: ["PERIOD"]})
				if !(pEnd is none) {
					p.value = timeText(period.start) + "/" + timeText(pEnd)
				} else if !(pDur is none) {
					p.value = timeText(period.start) + "/" + durationText(pDur)
				}
				c.properties.push(p)
			}
		}
		c.properties = c.properties + timesProperties("EXDATE", e.exceptions)
		for let a in e.attachments {
			c.properties.push(attachmentProperty(a))
		}
		c.properties.push(plain("COLOR", e.color)) when e.color != ""
		for let image in e.images {
			c.properties.push(CalendarProperty{name: "IMAGE", value: image, params: [CalendarParam{name:"VALUE", values:["URI"]}]})
		}
		for let conference in e.conferences {
			c.properties.push(CalendarProperty{name: "CONFERENCE", value: conference, params: [CalendarParam{name:"VALUE", values:["URI"]}]})
		}
		for let s in e.requestStatus {
			c.properties.push(plain("REQUEST-STATUS", s))
		}
		c.properties = c.properties + e.extra
		for let a in e.alarms {
			c.components.push(alarmComponent(a))
		}
		c.components = c.components + e.components
		return c
	}

	// An alarm as a VALARM component.
	def alarmComponent(a Alarm) CalendarComponent {
		let c = CalendarComponent{name: "VALARM"}
		c.properties.push(plain("UID", a.uid)) when a.uid != ""
		c.properties.push(plain("ACTION", a.action == "" ?? ("DISPLAY", a.action)))
		let at = a.triggerAt
		let trigger = a.trigger
		if !(at is none) {
			c.properties.push(CalendarProperty{name: "TRIGGER", value: stampText(at), params: [CalendarParam{name:"VALUE", values:["DATE-TIME"]}]})
		} else {
			let p = plain("TRIGGER", trigger is none ?? ("PT0S", durationText(trigger)))
			p.params.push(CalendarParam{name: "RELATED", values: ["END"]}) when a.fromEnd
			c.properties.push(p)
		}
		c.properties.push(plain("REPEAT", a.repeat.str())) when a.repeat > 0
		let interval = a.interval
		c.properties.push(plain("DURATION", durationText(interval))) unless interval is none
		// A display alarm needs a description (RFC 5545 §3.6.6).
		addText(c, "DESCRIPTION", (a.description == "" && (a.action := "" || "DISPLAY")) ?? ("Reminder", a.description))
		addText(c, "SUMMARY", a.summary)
		for let attendee in a.attendees {
			c.properties.push(addressProperty("ATTENDEE", attendee))
		}
		for let attachment in a.attachments {
			c.properties.push(attachmentProperty(attachment))
		}
		let acknowledged = a.acknowledged
		c.properties.push(plain("ACKNOWLEDGED", stampText(acknowledged))) unless acknowledged is none
		c.properties = c.properties + a.extra
		return c
	}

	// A free/busy report as a VFREEBUSY component.
	def freeBusyComponent(f FreeBusy) CalendarComponent {
		let c = CalendarComponent{name: "VFREEBUSY"}
		c.properties.push(plain("UID", f.uid)) when f.uid != ""
		let stamp = f.stamp
		c.properties.push(plain("DTSTAMP", stampText(stamp is none ?? (time.now(), stamp))))
		let start = f.start
		c.properties.push(timeProperty("DTSTART", start)) unless start is none
		let end = f.end
		c.properties.push(timeProperty("DTEND", end)) unless end is none
		let organizer = f.organizer
		c.properties.push(addressProperty("ORGANIZER", organizer)) unless organizer is none
		for let a in f.attendees {
			c.properties.push(addressProperty("ATTENDEE", a))
		}
		for let p in f.periods {
			let prop = plain("FREEBUSY", stampText(p.start) + "/" + stampText(p.end))
			prop.params.push(CalendarParam{name: "FBTYPE", values: [p.kind]}) unless p.kind == "BUSY"
			c.properties.push(prop)
		}
		c.properties.push(plain("URL", f.url)) when f.url != ""
		for let s in f.comments {
			addText(c, "COMMENT", s)
		}
		addText(c, "CONTACT", f.contact)
		c.properties = c.properties + f.extra
		return c
	}

	// A time zone as a VTIMEZONE component.
	def zoneComponent(z TimeZone) CalendarComponent {
		let c = CalendarComponent{name: "VTIMEZONE"}
		c.properties.push(plain("TZID", z.id))
		c.properties.push(plain("TZURL", z.url)) when z.url != ""
		let modified = z.lastModified
		c.properties.push(plain("LAST-MODIFIED", stampText(modified))) unless modified is none
		c.properties = c.properties + z.extra
		for let o in z.observances {
			let sub = CalendarComponent{name: o.daylight ?? ("DAYLIGHT", "STANDARD")}
			sub.properties.push(plain("DTSTART", timeText(CalendarTime{year: o.start.year, month: o.start.month, day: o.start.day, hour: o.start.hour, minute: o.start.minute, second: o.start.second})))
			sub.properties.push(plain("TZOFFSETFROM", offsetText(o.offsetFrom)))
			sub.properties.push(plain("TZOFFSETTO", offsetText(o.offsetTo)))
			for let name in o.names {
				addText(sub, "TZNAME", name)
			}
			for let rule in o.rules {
				sub.properties.push(plain("RRULE", ruleText(rule)))
			}
			sub.properties = sub.properties + timesProperties("RDATE", o.dates)
			for let s in o.comments {
				addText(sub, "COMMENT", s)
			}
			sub.properties = sub.properties + o.extra
			c.components.push(sub)
		}
		return c
	}
}
