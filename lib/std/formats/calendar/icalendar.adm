partial module std.formats.calendar {
	use (
		std.io
		std.formats.calendar.loader::*
		std.formats.calendar.ical::*
	)

	// ICalendar is the iCalendar format (`.ics`, `text/calendar`, RFC 5545
	// with RFC 7986 properties, RFC 7529 rules and RFC 9074 alarms): every
	// component, property and value type, line folding and escaping.
	// Components and properties the model has no field for are kept and
	// written back as read.
	@codec("iCalendar")
	type ICalendar {
		extension string[] {
			def get() string[] {
				return string[".ics", ".ical", ".ifb", ".icalendar"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["text/calendar"]
			}
		}

		// matchSignature implements SignatureMatcher: `BEGIN:VCALENDAR`
		// first, not vCalendar 1.0.
		def matchSignature(r io.Reader) bool {
			let text = head(r, 512).upper()
			return text.trim().startsWith("BEGIN:VCALENDAR") && !text.contains("VERSION:1.0")
		}

		// read implements CalendarFormat: every `VCALENDAR` of the data
		// merged into one calendar, its first calendar's properties kept.
		// Fails when the data holds no `BEGIN:VCALENDAR`, or the reader
		// fails.
		def read(reader io.Reader) !Calendar {
			let components = try readComponents(reader)
			let calendars = components.filter(c => c.name == "VCALENDAR")
			fail "icalendar: no BEGIN:VCALENDAR" when calendars.len() == 0
			let out = calendarOf(calendars[0])
			for let i = 1; i < calendars.len(); i++ {
				let more = calendarOf(calendars[i])
				out.entries = out.entries + more.entries
				out.freeBusy = out.freeBusy + more.freeBusy
				for let z in more.timeZones {
					out.timeZones.push(z) unless out.timeZones.filter(t => t.id == z.id).len() > 0
				}
				out.components = out.components + more.components
			}
			return out
		}

		// write implements CalendarFormat. Entries without a uid or a
		// stamp get one, as every iCalendar entry must have both.
		// Fails when the writer fails.
		def write(calendar Calendar, writer io.Writer) !none {
			return try writeComponents([componentOf(calendar)], writer)
		}

		// readComponents parses the data into its top-level components
		// (`VCALENDAR` usually) as the file writes them: line folding
		// undone, values still escaped.
		// Fails when the data holds no component, or the reader fails.
		def readComponents(reader io.Reader) !CalendarComponent[] {
			return parseComponents(try readText(reader))
		}

		// writeComponents writes components given as `readComponents`
		// gives them, lines folded.
		// Fails when the writer fails.
		def writeComponents(components CalendarComponent[], writer io.Writer) !none {
			for let c in components {
				try put(writer, componentText(c))
			}
		}
	}
}
