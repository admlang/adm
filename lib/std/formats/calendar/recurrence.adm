internal partial module std.formats.calendar.expand {
	use (
		std.i18n
		std.time
		std.formats.calendar::*
		std.formats.calendar.civil::*
	)

	// RRULE expansion (RFC 5545 §3.3.10, RFC 7529 SKIP) on wall-clock
	// times, time zone offsets from VTIMEZONE observances, and the
	// instances of an entry with RDATE, EXDATE and RECURRENCE-ID applied.

	// The most instances one expansion gives before it fails.
	const maxInstances = 100000

	// A rule's lists with the defaults RFC 5545 takes from the start
	// (a yearly rule with no day parts repeats the start's month and day).
	struct Plan {
		rule       RecurrenceRule
		byMonth    int[]
		byMonthDay int[]
		byDay      WeekdayNum[]
		hours      int[]
		minutes    int[]
		seconds    int[]
	}

	def planOf(rule RecurrenceRule, start CalendarTime) Plan {
		let p = Plan{rule: rule, byMonth: rule.byMonth, byMonthDay: rule.byMonthDay, byDay: rule.byDay, hours: rule.byHour, minutes: rule.byMinute, seconds: rule.bySecond}
		if rule.byWeekNo.len() == 0 && rule.byYearDay.len() == 0 && rule.byMonthDay.len() == 0 && rule.byDay.len() == 0 {
			switch {
				case rule.frequency == RecurrenceFrequency.Yearly:
					p.byMonth = [start.month] when p.byMonth.len() == 0
					p.byMonthDay = [start.day]
				case rule.frequency == RecurrenceFrequency.Monthly:
					p.byMonthDay = [start.day]
				case rule.frequency == RecurrenceFrequency.Weekly:
					p.byDay = [WeekdayNum{weekday:weekdayOfDays(daysFromCivil(start.year, start.month, start.day))}]
			}
		}
		if start.allDay {
			p.hours = [0]
			p.minutes = [0]
			p.seconds = [0]
		} else {
			p.hours = [start.hour] when p.hours.len() == 0
			p.minutes = [start.minute] when p.minutes.len() == 0
			p.seconds = [start.second] when p.seconds.len() == 0
		}
		return p
	}

	// Whether `n` is in `list`, a negative entry counting from `total`
	// (-1 is the last).
	def listed(list int[], n int, total int) bool {
		for let v in list {
			return true when v == n || (v < 0 && total + v + 1 == n)
		}
		return false
	}

	// Whether a day passes the rule's day parts. `forward` lets the day
	// after a month too short for a BYMONTHDAY stand in for it (SKIP).
	def dayPasses(p Plan, days int64) bool {
		let (y, m, d) = civilFromDays(days)
		let rule = p.rule
		if p.byMonth.len() > 0 && !p.byMonth.includes(m) {
			// RFC 7529 FORWARD: the 1st stands in for a day the month
			// before lacks.
			return false unless rule.scale != "" && rule.skip == "FORWARD" && d == 1
			let (py, pm, _) = civilFromDays(days - int64(1))
			return false unless p.byMonth.includes(pm) && p.byMonthDay.filter(v => v > time.daysInMonth(py, pm)).len() > 0
		}
		if rule.byWeekNo.len() > 0 {
			let (week, weekYear) = weekNumber(days, rule.weekStart)
			return false unless listed(rule.byWeekNo, week, weeksIn(weekYear, rule.weekStart))
		}
		return false unless rule.byYearDay.len() == 0 || listed(rule.byYearDay, dayOfYear(y, m, d), daysInYear(y))
		if p.byMonthDay.len() > 0 {
			let dim = time.daysInMonth(y, m)
			let ok = listed(p.byMonthDay, d, dim)
			if !ok && rule.scale != "" {
				// RFC 7529: a day the month lacks moves back to its last
				// day, or on to the first of the next month.
				if rule.skip == "BACKWARD" && d == dim {
					for let v in p.byMonthDay {
						ok = true when v > dim
					}
				}
				if rule.skip == "FORWARD" && d == 1 {
					let (py, pm, _) = civilFromDays(days - int64(1))
					let prevDim = time.daysInMonth(py, pm)
					for let v in p.byMonthDay {
						ok = true when v > prevDim
					}
				}
			}
			return false unless ok
		}
		if p.byDay.len() > 0 {
			let wd = weekdayOfDays(days)
			let inMonth = rule.frequency == RecurrenceFrequency.Monthly || (rule.frequency == RecurrenceFrequency.Yearly && p.byMonth.len() > 0)
			let numbered = rule.frequency := RecurrenceFrequency.Monthly || RecurrenceFrequency.Yearly
			let found = false
			for let wn in p.byDay {
				continue unless wn.weekday == wd
				if wn.ordinal == 0 || !numbered {
					found = true
					break
				}
				let span = inMonth ?? (time.daysInMonth(y, m), daysInYear(y))
				let position = inMonth ?? (d, dayOfYear(y, m, d))
				let first = (position - 1) / 7 + 1
				let last = -((span - position) / 7 + 1)
				if wn.ordinal == first || wn.ordinal == last {
					found = true
					break
				}
			}
			return false unless found
		}
		return true
	}

	// The candidate wall times of one period, sorted, BYSETPOS applied.
	def periodCandidates(p Plan, days int64[], hours int[], minutes int[], seconds int[]) int64[] {
		let out int64[] = []
		for let day in days {
			continue unless dayPasses(p, day)
			for let h in hours {
				for let mi in minutes {
					for let s in seconds {
						out.push(day * int64(86400) + int64(h * 3600 + mi * 60 + s))
					}
				}
			}
		}
		out.sort((a, b) => a < b)
		let set = p.rule.bySetPos
		return out when set.len() == 0
		let picked int64[] = []
		for let pos in set {
			let i = pos > 0 ?? (pos - 1, out.len() + pos)
			picked.push(out[i]) when i >= 0 && i < out.len() && !picked.includes(out[i])
		}
		picked.sort((a, b) => a < b)
		return picked
	}

	// The days from `first` for `count` days.
	def dayRange(first int64, count int) int64[] {
		let out int64[] = []
		for let i = 0; i < count; i++ {
			out.push(first + int64(i))
		}
		return out
	}

	// The members of `list` that `limit` allows (all when it is empty).
	def limited(values int[], limit int[]) int[] {
		return values when limit.len() == 0
		return values.filter(v => limit.includes(v))
	}

	// The start times of a rule from `start` (which is always the first)
	// to `end` or `until` (wall seconds, inclusive; -1 for none), at most
	// `rule.count` of them.
	// Fails with CalendarError `scale` for a calendar other than Gregorian,
	// `limit` past `maxInstances`.
	def expandRule(rule RecurrenceRule, start CalendarTime, end int64, until int64) !int64[] {
		let scale = rule.scale.upper()
		fail CalendarError{message: "calendar: cannot expand rules counted in {rule.scale}", code: "scale"} unless scale := "" || "GREGORIAN"
		let p = planOf(rule, start)
		let first = civilSeconds(start)
		let out = [first]
		let interval = rule.interval < 1 ?? (1, rule.interval)
		let startDay = daysFromCivil(start.year, start.month, start.day)
		let idle = 0
		for let k = 0;; k++ {
			let days int64[] = []
			let hours = p.hours
			let minutes = p.minutes
			let seconds = p.seconds
			let periodStart = int64(0)
			switch {
				case rule.frequency == RecurrenceFrequency.Yearly:
					let y = start.year + k * interval
					periodStart = daysFromCivil(y, 1, 1) * int64(86400)
					days = dayRange(daysFromCivil(y, 1, 1), daysInYear(y))
				case rule.frequency == RecurrenceFrequency.Monthly:
					let months = start.month - 1 + k * interval
					let y = start.year + months / 12
					let m = months % 12 + 1
					periodStart = daysFromCivil(y, m, 1) * int64(86400)
					days = dayRange(daysFromCivil(y, m, 1), time.daysInMonth(y, m) + (rule.skip == "FORWARD" && rule.scale != "" ?? (1, 0)))
				case rule.frequency == RecurrenceFrequency.Weekly:
					let week = weekStartOf(startDay, rule.weekStart) + int64(7 * k * interval)
					periodStart = week * int64(86400)
					days = dayRange(week, 7)
				case rule.frequency == RecurrenceFrequency.Daily:
					let day = startDay + int64(k * interval)
					periodStart = day * int64(86400)
					days = [day]
				default:
					let step = rule.frequency == RecurrenceFrequency.Hourly ?? (3600, rule.frequency == RecurrenceFrequency.Minutely ?? (60, 1))
					let base = first - (first % int64(step)) + int64(k * interval * step)
					periodStart = base
					let day = floorDiv(base, int64(86400))
					let clock = int(base - day * int64(86400))
					days = [day]
					hours = limited([clock / 3600], rule.byHour)
					if rule.frequency == RecurrenceFrequency.Hourly {
						minutes = p.minutes
					} else {
						minutes = limited([clock % 3600 / 60], rule.byMinute)
						seconds = rule.frequency == RecurrenceFrequency.Minutely ?? (p.seconds, limited([clock % 60], rule.bySecond))
					}
			}
			return out when end >= int64(0) && periodStart > end
			return out when until >= int64(0) && periodStart > until
			let candidates = periodCandidates(p, days, hours, minutes, seconds)
			idle = candidates.len() == 0 ?? (idle + 1, 0)
			return out when idle > 5000
			for let c in candidates {
				continue when c <= first
				return out when end >= int64(0) && c > end
				return out when until >= int64(0) && c > until
				out.push(c)
				return out when rule.count > 0 && out.len() >= rule.count
				fail CalendarError{message: "calendar: a rule gives more than {maxInstances} instances", code: "limit"} when out.len() > maxInstances
			}
		}
		return out
	}

	// ---- time zones ----

	// The onsets of an observance up to `end` (wall seconds in the
	// offset before the change).
	// Fails when its rules cannot be expanded.
	def onsetsOf(o Observance, end int64) !int64[] {
		let out int64[] = [civilSeconds(o.start)]
		for let rule in o.rules {
			out = out + try expandRule(rule, o.start, end, untilOf(rule, o.offsetFrom))
		}
		for let d in o.dates {
			out.push(civilSeconds(d))
		}
		return out.filter(s => s <= end)
	}

	// The wall seconds a rule's UNTIL stands for in a zone at `offset`,
	// -1 when it has none.
	def untilOf(rule RecurrenceRule, offset duration) int64 {
		let until = rule.until
		return int64(-1) when until is none
		let s = civilSeconds(until)
		return s + int64(86399) when until.allDay
		return s + secondsIn(offset) when until.utc
		return s
	}

	// The offset from UTC of a wall time in a zone. A wall time a change
	// skips takes the offset before it; one a change repeats, the first.
	// Fails when the zone's rules cannot be expanded.
	def offsetAtWall(zone TimeZone, wall int64) !duration {
		return databaseOffsetAtWall(zone.id, wall) when zone.observances.len() == 0
		let best = int64(0)
		let found = false
		let chosen = Observance{start: CalendarTime{year: 1970, month: 1, day: 1}, offsetFrom: 0s, offsetTo: 0s}
		let earliest = chosen
		let earliestAt = int64(0)
		let any = false
		for let o in zone.observances {
			let onsets = try onsetsOf(o, wall + int64(86400))
			for let s in onsets {
				if !any || s < earliestAt {
					earliestAt = s
					earliest = o
					any = true
				}
				if s <= wall && (!found || s > best) {
					best = s
					chosen = o
					found = true
				}
			}
		}
		return earliest.offsetFrom when !found && any
		return 0s unless found
		let jump = secondsIn(chosen.offsetTo - chosen.offsetFrom)
		return chosen.offsetFrom when jump > int64(0) && wall < best + jump
		return chosen.offsetTo
	}

	// The offset from UTC of an instant (UTC wall seconds) in a zone.
	// Fails when the zone's rules cannot be expanded.
	def offsetAtInstant(zone TimeZone, utc int64) !duration {
		if zone.observances.len() == 0 {
			let known = new i18n.TimeZone(zone.id)
			return known.offset(time.fromUnixNs(utc * int64(1000000000)))
		}
		let best = int64(0)
		let found = false
		let offset = 0s
		let earliestAt = int64(0)
		let earliestFrom = 0s
		let any = false
		for let o in zone.observances {
			let from = secondsIn(o.offsetFrom)
			for let s in try onsetsOf(o, utc + from + int64(86400)) {
				let at = s - from
				if !any || at < earliestAt {
					earliestAt = at
					earliestFrom = o.offsetFrom
					any = true
				}
				if at <= utc && (!found || at > best) {
					best = at
					offset = o.offsetTo
					found = true
				}
			}
		}
		return earliestFrom when !found && any
		return offset
	}

	// The offset from UTC of a wall time in a zone of the time zone
	// database (`std.i18n`), with the choices of `offsetAtWall` around a
	// change. An id the database does not know is UTC.
	def databaseOffsetAtWall(id string, wall int64) duration {
		let known = new i18n.TimeZone(id)
		let day = int64(86400)
		let second = int64(1000000000)
		let before = known.offset(time.fromUnixNs((wall - day) * second))
		let after = known.offset(time.fromUnixNs((wall + day) * second))
		return before when before == after
		let early = known.offset(time.fromUnixNs((wall - secondsIn(before)) * second))
		let late = known.offset(time.fromUnixNs((wall - secondsIn(after)) * second))
		return after when early != before && late == after
		return before
	}

	// The zone a time names: the one among `zones` with its id, else the
	// zone of that name in the time zone database (`std.i18n`), which has
	// no observances of its own.
	// Fails with CalendarError `zone` when neither has it.
	def zoneOf(zones TimeZone[], id string) !TimeZone {
		for let z in zones {
			return z when z.id == id
		}
		let known = new i18n.TimeZone(id)
		return TimeZone{id: id} when known.known()
		fail CalendarError{message: "calendar: the time zone \"{id}\" is not defined", code: "zone"}
	}

	// The instant of a calendar time (UTC wall seconds).
	// Fails with CalendarError `zone` when its zone is not defined.
	def utcSeconds(zones TimeZone[], t CalendarTime) !int64 {
		let wall = civilSeconds(t)
		return wall when t.utc || t.allDay || t.zone == ""
		let zone = try zoneOf(zones, t.zone)
		return wall - secondsIn(try offsetAtWall(zone, wall))
	}

	// The instant of a calendar time.
	// Fails with CalendarError `zone` when its zone is not defined.
	def instantIn(zones TimeZone[], t CalendarTime) !time.Time {
		return instantOf(try utcSeconds(zones, t))
	}

	// The wall seconds of an instant on the clock of `like` (its zone, or
	// UTC for a UTC, floating or all-day time).
	// Fails with CalendarError `zone` when the zone is not defined.
	def wallOf(zones TimeZone[], utc int64, like CalendarTime) !int64 {
		return utc when like.utc || like.allDay || like.zone == ""
		let zone = try zoneOf(zones, like.zone)
		return utc + secondsIn(try offsetAtInstant(zone, utc))
	}

	// ---- instances ----

	// `t` moved by a duration: weeks and days on the wall clock, the rest
	// exactly.
	// Fails with CalendarError `zone` when the zone is not defined.
	def addDuration(zones TimeZone[], t CalendarTime, d CalendarDuration) !int64 {
		let sign = d.negative ?? (-1, 1)
		let wall = civilSeconds(t) + int64(sign * (d.weeks * 7 + d.days) * 86400)
		let moved = try utcSeconds(zones, timeAt(wall, t))
		return moved + int64(sign * (d.hours * 3600 + d.minutes * 60 + d.seconds))
	}

	// The end of an instance starting at `start` (UTC seconds of the
	// start in `startUtc`): its DTEND, DUE, DURATION, a day for a date, or
	// the start.
	// Fails with CalendarError `zone` when a zone is not defined.
	def endOf(zones TimeZone[], entry CalendarEntry, start CalendarTime, startUtc int64) !int64 {
		let d = entry.duration
		return try addDuration(zones, start, d) unless d is none
		let closing = entry.kind == EntryKind.Todo ?? (entry.due, entry.end)
		let first = (entry.kind == EntryKind.Todo && entry.start is none) ?? (entry.due, entry.start)
		if !(closing is none) && !(first is none) {
			// The length of the first instance, kept on the wall clock for
			// dates.
			return startUtc + (civilSeconds(closing) - civilSeconds(first)) when start.allDay
			let span = (try utcSeconds(zones, closing)) - (try utcSeconds(zones, first))
			return startUtc + span
		}
		return startUtc + int64(86400) when start.allDay
		return startUtc
	}

	// The instances of `entry` in the window, with its overrides.
	// Fails with CalendarError when a time or rule cannot be expanded.
	def instancesOf(entry CalendarEntry, overrides CalendarEntry[], zones TimeZone[], from time.Time, to time.Time) !Occurrence[] {
		let base = CalendarTime{year: 0, month: 0, day: 0}
		let given = entry.start
		let due = entry.due
		if !(given is none) {
			base = given
		} else if !(due is none) {
			base = due
		}
		let out Occurrence[] = []
		return out when base.month == 0
		let fromS = secondsOf(from)
		let toS = secondsOf(to)
		// Wall seconds of the window end, a day of slack for zone offsets.
		let endWall = (try wallOf(zones, toS, base)) + int64(86400)
		let starts int64[] = []
		let periods map<int64, CalendarTime> = map<int64, CalendarTime>{}
		if entry.rules.len() == 0 && entry.dates.len() == 0 {
			starts.push(civilSeconds(base))
		} else {
			for let rule in entry.rules {
				let until = rule.until
				let limit = int64(-1)
				limit = (until.utc && !base.utc && base.zone != "" && !base.allDay) ?? (try wallOf(zones, civilSeconds(until), base), untilOf(rule, 0s)) unless until is none
				for let s in try expandRule(rule, base, endWall, limit) {
					starts.push(s) unless starts.includes(s)
				}
			}
			starts.push(civilSeconds(base)) unless starts.includes(civilSeconds(base))
			for let p in entry.dates {
				let s = (p.start.utc && !base.utc && base.zone != "") ?? (try wallOf(zones, civilSeconds(p.start), base), civilSeconds(p.start))
				starts.push(s) unless starts.includes(s)
				let pEnd = p.end
				periods[s] = pEnd unless pEnd is none
			}
		}
		let excluded int64[] = []
		for let x in entry.exceptions {
			let s = (x.utc && !base.utc && base.zone != "") ?? (try wallOf(zones, civilSeconds(x), base), civilSeconds(x))
			excluded.push(s)
			// A date exception removes every instance on that day.
			if x.allDay && !base.allDay {
				for let st in starts {
					excluded.push(st) when floorDiv(st, int64(86400)) == floorDiv(s, int64(86400))
				}
			}
		}
		starts.sort((a, b) => a < b)
		// Overrides by the wall seconds of their recurrence id.
		let single map<int64, CalendarEntry> = map<int64, CalendarEntry>{}
		let future CalendarEntry[] = []
		for let o in overrides {
			let rid = o.recurrenceId
			continue when rid is none
			let s = (rid.utc && !base.utc && base.zone != "") ?? (try wallOf(zones, civilSeconds(rid), base), civilSeconds(rid))
			single[s] = o
			future.push(o) when o.thisAndFuture
			starts.push(s) unless starts.includes(s) || excluded.includes(s)
		}
		starts.sort((a, b) => a < b)
		for let s in starts {
			continue when excluded.includes(s)
			let original = timeAt(s, base)
			let describing = entry
			let shift = int64(0)
			let own = single.get(s)
			if !(own is none) {
				describing = own
			} else {
				// The latest THISANDFUTURE override at or before this one.
				let bestAt = int64(-1)
				for let f in future {
					let rid = f.recurrenceId
					continue when rid is none
					let at = civilSeconds(rid)
					if at <= s && at > bestAt {
						bestAt = at
						describing = f
						let fs = f.start
						shift = fs is none ?? (int64(0), civilSeconds(fs) - at)
					}
				}
			}
			let startTime = original
			let ownStart = describing.start
			if !(own is none) && !(ownStart is none) {
				startTime = ownStart
			} else if shift != int64(0) {
				startTime = timeAt(s + shift, base)
			}
			let startUtc = try utcSeconds(zones, startTime)
			let periodEnd = periods.get(s)
			let endUtc = periodEnd is none ?? (try endOf(zones, describing, startTime, startUtc), try utcSeconds(zones, periodEnd))
			let touches = endUtc > fromS || (endUtc == startUtc && startUtc >= fromS)
			continue unless startUtc < toS && touches
			out.push(Occurrence{start: instantOf(startUtc), end: instantOf(endUtc), recurrenceId: original, entry: describing})
		}
		return out
	}
}
