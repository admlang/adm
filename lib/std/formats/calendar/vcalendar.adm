partial module std.formats.calendar {
	use (
		std.io
		std.formats.calendar.loader::*
		std.formats.calendar.vcal::*
	)

	// VCalendar reads vCalendar 1.0 (`.vcs`, `text/x-vcalendar`), as older
	// phones and Outlook export it, into the calendar model: its
	// quoted-printable values and charsets, its recurrence rule grammar
	// (`MP1 1+ MO #3`), `AALARM`/`DALARM`/`PALARM`/`MALARM`, and local
	// times in its `TZ` and `DAYLIGHT` offsets (turned into UTC). Writing
	// is iCalendar's job: `write` fails.
	@codec("vCalendar")
	type VCalendar {
		extension string[] {
			def get() string[] {
				return string[".vcs"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["text/x-vcalendar"]
			}
		}

		// matchSignature implements SignatureMatcher: `BEGIN:VCALENDAR`
		// with `VERSION:1.0`.
		def matchSignature(r io.Reader) bool {
			let text = head(r, 512).upper()
			return text.trim().startsWith("BEGIN:VCALENDAR") && text.contains("VERSION:1.0")
		}

		// read implements CalendarFormat.
		// Fails when the data holds no `BEGIN:VCALENDAR`, or the reader
		// fails.
		def read(reader io.Reader) !Calendar {
			return try readVCalendar(try readText(reader))
		}

		// write implements CalendarFormat: vCalendar 1.0 is read only, so
		// write it as iCalendar (`ICalendar`).
		// Fails always.
		def write(calendar Calendar, writer io.Writer) !none {
			fail "vcalendar: vCalendar 1.0 is read only; write iCalendar instead"
		}
	}
}

internal partial module std.formats.calendar.vcal {
	use (
		std.data.encoding
		std.data.encoding.codepages
		std.formats.calendar::*
		std.formats.calendar.civil::*
		std.formats.calendar.ical::*
	)

	// A DAYLIGHT span: from `start` to `end` (local wall seconds) the
	// offset is `offset`.
	struct Daylight {
		start  int64
		end    int64
		offset int64
	}

	// The time rules of a vCalendar: its standard offset and daylight
	// spans, none when it names no `TZ` (times stay floating).
	struct Clock {
		known    bool       = false
		offset   int64      = int64(0)
		daylight Daylight[] = []
	}

	// Reads a vCalendar text.
	// Fails when it holds no calendar.
	def readVCalendar(text string) !Calendar {
		let roots = componentsOf(text)
		let calendars = roots.filter(c => c.name == "VCALENDAR")
		fail "vcalendar: no BEGIN:VCALENDAR" when calendars.len() == 0
		let root = calendars[0]
		let clock = clockOf(root)
		let out = CalendarComponent{name: "VCALENDAR", properties: [CalendarProperty{name:"VERSION", value:"2.0"}]}
		for let p in root.properties {
			continue when p.name := "VERSION" || "TZ" || "DAYLIGHT" || "GEO"
			out.properties.push(p)
		}
		for let c in root.components {
			out.components.push(entryComponent(c, clock))
		}
		return calendarOf(out)
	}

	// The components of a text: lines unfolded, quoted-printable joined
	// and decoded, parameters named.
	def componentsOf(text string) CalendarComponent[] {
		let top CalendarComponent[] = []
		let stack CalendarComponent[] = []
		for let line in logicalLines(text) {
			let parsed = parseLine(line)
			continue when parsed is none
			let p = decoded(parsed)
			if p.name == "BEGIN" {
				stack.push(CalendarComponent{name: p.value.trim().upper()})
				continue
			}
			if p.name == "END" {
				continue when stack.len() == 0
				let done = stack[stack.len() - 1]
				stack = stack[:stack.len() - 1].clone()
				if stack.len() == 0 {
					top.push(done)
				} else {
					stack[stack.len() - 1].components.push(done)
				}
				continue
			}
			stack[stack.len() - 1].properties.push(p) when stack.len() > 0
		}
		top.push(stack[0]) when stack.len() > 0
		return top
	}

	// Lines with folding and quoted-printable soft breaks undone.
	def logicalLines(text string) string[] {
		let raw = text.trimPrefix("﻿").replace("\r\n", "\n").replace("\r", "\n").split("\n")
		let out string[] = []
		let i = 0
		for i < raw.len() {
			let line = raw[i]
			i++
			for i < raw.len() {
				let next = raw[i]
				if next.startsWith(" ") || next.startsWith("\t") {
					line += next[1:]
					i++
					continue
				}
				let colon = line.indexOf(":")
				let head = colon < 0 ?? ("", line[:colon].upper())
				if line.endsWith("=") && head.contains("QUOTED-PRINTABLE") {
					line = line[:line.len() - 1] + next
					i++
					continue
				}
				break
			}
			out.push(line)
		}
		return out
	}

	// A property with its quoted-printable value and charset decoded and
	// bare parameters named (`;QUOTED-PRINTABLE` is `ENCODING`).
	def decoded(p CalendarProperty) CalendarProperty {
		let params CalendarParam[] = []
		for let q in p.params {
			if q.values.len() == 0 {
				let word = q.name
				let name = (word := "QUOTED-PRINTABLE" || "BASE64" || "8BIT" || "7BIT") ?? ("ENCODING", "TYPE")
				params.push(CalendarParam{name: name, values: [word]})
			} else {
				params.push(q)
			}
		}
		let value = p.value
		let transfer = ""
		let charset = ""
		for let q in params {
			transfer = q.values.join(",").upper() when q.name == "ENCODING"
			charset = q.values.join(",") when q.name == "CHARSET"
		}
		if transfer == "QUOTED-PRINTABLE" {
			let bytes = encoding.quotedPrintableDecode(value) onerror recover value.bytes()
			value = inCharset(bytes, charset).replace("\r\n", "\n").replace("\n", "\\n")
		} else if charset != "" {
			value = inCharset(value.bytes(), charset)
		}
		params = params.filter(q => !(q.name := "ENCODING" || "CHARSET"))
		return CalendarProperty{name: p.name, value: value, params: params}
	}

	// Bytes as text in a charset; UTF-8 for an unknown one.
	def inCharset(data byte[], charset string) string {
		let page = codepages.forCharset(charset)
		return string(data) when page is none
		return codepages.decode(data, page)
	}

	// ---- time ----

	// An offset (`-05:00`, `-05`, `+0100`) in seconds; none when it is not
	// one.
	def offsetSeconds(text string) ?int64 {
		let v = text.trim().replace(":", "")
		return none unless v.len() >= 2
		let sign = v[:1] == "-" ?? (-1, 1)
		let digits = (v[:1] := "+" || "-") ?? (v[1:], v)
		return none unless digits.isNumeric() && (digits.len() == 2 || digits.len() == 4)
		let minutes = digits[:2].toInt<int>() * 60 + (digits.len() == 4 ?? (digits[2:].toInt<int>(), 0))
		return int64(sign * minutes * 60)
	}

	// The clock of a calendar: `TZ` and each `DAYLIGHT`
	// (`TRUE;-04;19960407T025959;19961027T010000;EST;EDT`).
	def clockOf(root CalendarComponent) Clock {
		let clock = Clock{}
		for let p in root.properties {
			if p.name == "TZ" {
				let off = offsetSeconds(p.value)
				if !(off is none) {
					clock.known = true
					clock.offset = off
				}
			}
		}
		for let p in root.properties {
			continue unless p.name == "DAYLIGHT"
			let parts = p.value.split(";")
			continue unless parts.len() >= 4 && parts[0].trim().upper() == "TRUE"
			let off = offsetSeconds(parts[1])
			let start = localTime(parts[2])
			let end = localTime(parts[3])
			continue when off is none || start is none || end is none
			clock.daylight.push(Daylight{start: civilSeconds(start), end: civilSeconds(end), offset: off})
		}
		return clock
	}

	// A local date-time value.
	def localTime(text string) ?CalendarTime {
		let v = text.trim()
		return none unless v.len() >= 15 && v[:8].isNumeric() && v[8:9] == "T" && v[9:15].isNumeric()
		return CalendarTime{year: v[:4].toInt<int>(), month: v[4:6].toInt<int>(), day: v[6:8].toInt<int>(), hour: v[9:11].toInt<int>(), minute: v[11:13].toInt<int>(), second: v[13:15].toInt<int>()}
	}

	// A date-time value in UTC when the clock knows the offset; as
	// written otherwise (UTC already, a date, or floating).
	def utcValue(text string, clock Clock) string {
		let v = text.trim()
		return v unless clock.known && v.len() == 15
		let t = localTime(v)
		return v when t is none
		let wall = civilSeconds(t)
		let offset = clock.offset
		for let d in clock.daylight {
			offset = d.offset when wall >= d.start && wall < d.end
		}
		let u = timeAt(wall - offset, t)
		return "{u.year}{two(u.month)}{two(u.day)}T{two(u.hour)}{two(u.minute)}{two(u.second)}Z"
	}

	def two(n int) string {
		return n < 10 ?? ("0" + n.str(), n.str())
	}

	// ---- components ----

	// An event or to-do as its iCalendar component.
	def entryComponent(c CalendarComponent, clock Clock) CalendarComponent {
		let out = CalendarComponent{name: c.name}
		let times = ["DTSTART", "DTEND", "DUE", "COMPLETED", "DCREATED", "LAST-MODIFIED", "CREATED", "DTSTAMP"]
		for let p in c.properties {
			switch {
				case times.includes(p.name):
					let name = p.name == "DCREATED" ?? ("CREATED", p.name)
					let value = utcValue(p.value, clock)
					let params = p.params.filter(q => q.name != "TZID")
					if name := "CREATED" || "LAST-MODIFIED" || "COMPLETED" || "DTSTAMP" {
						value = value + "Z" when value.len() == 15
					}
					out.properties.push(CalendarProperty{name: name, value: value, params: params})
				case p.name := "EXDATE" || "RDATE":
					let values = p.value.split(";").mapElem<string>(v => utcValue(v, clock))
					out.properties.push(CalendarProperty{name: p.name, value: values.join(","), params: p.params})
				case p.name == "RRULE":
					let rule = ruleText(p.value, clock)
					out.properties.push(CalendarProperty{name: "RRULE", value: rule}) when rule != ""
				case p.name := "CATEGORIES" || "RESOURCES":
					out.properties.push(CalendarProperty{name: p.name, value: p.value.replace("\\;", "\u0001").replace(";", ",").replace("\u0001", ";")})
				case p.name == "STATUS":
					let status = statusOf(p.value, c.name)
					out.properties.push(CalendarProperty{name: "STATUS", value: status}) when status != ""
				case p.name == "TRANSP":
					let v = p.value.trim()
					out.properties.push(CalendarProperty{name: "TRANSP", value: (v == "0" || v.upper() == "OPAQUE") ?? ("OPAQUE", "TRANSPARENT")})
				case p.name == "ATTENDEE":
					out.properties.push(attendeeOf(p))
				case p.name := "AALARM" || "DALARM" || "PALARM" || "MALARM":
					out.components.push(alarmOf(p, clock))
				case p.name := "RNUM" || "VERSION":
					continue
				default:
					out.properties.push(p)
			}
		}
		return out
	}

	// A vCalendar status in iCalendar terms; "" for one it has none for.
	def statusOf(text string, kind string) string {
		let v = text.trim().upper()
		switch {
			case v := "NEEDS ACTION" || "NEEDS-ACTION" || "SENT":
				return "NEEDS-ACTION"
			case v := "ACCEPTED" || "CONFIRMED":
				return kind == "VTODO" ?? ("IN-PROCESS", "CONFIRMED")
			case v == "TENTATIVE":
				return "TENTATIVE"
			case v := "DECLINED" || "CANCELLED":
				return "CANCELLED"
			case v == "COMPLETED":
				return "COMPLETED"
		}
		return ""
	}

	// An ATTENDEE: `ROLE`, `STATUS`, `RSVP` in iCalendar terms, the address
	// as a `mailto:` URI.
	def attendeeOf(p CalendarProperty) CalendarProperty {
		let out = CalendarProperty{name: "ATTENDEE", value: addressOf(p.value)}
		for let q in p.params {
			let v = q.values.join(",").upper()
			switch {
				case q.name == "ROLE":
					out.name = "ORGANIZER" when v := "ORGANIZER" || "OWNER"
					out.params.push(CalendarParam{name: "ROLE", values: ["REQ-PARTICIPANT"]}) when v == "ATTENDEE"
				case q.name == "STATUS":
					let status = (v := "NEEDS ACTION" || "SENT") ?? ("NEEDS-ACTION", v == "CONFIRMED" ?? ("ACCEPTED", v))
					out.params.push(CalendarParam{name: "PARTSTAT", values: [status]})
				case q.name == "RSVP":
					out.params.push(CalendarParam{name: "RSVP", values: [v == "YES" ?? ("TRUE", "FALSE")]})
				case q.name := "EXPECT" || "TYPE":
					continue
				default:
					out.params.push(q)
			}
		}
		return out
	}

	// An attendee's address (`Jane <jane@example.com>` or a bare address)
	// as a URI.
	def addressOf(text string) string {
		let v = text.trim()
		let open = v.indexOf("<")
		let close = v.indexOf(">")
		v = v[open + 1:close].trim() when open >= 0 && close > open
		return v when v.contains(":")
		return "mailto:" + v
	}

	// An alarm property (`runtime;snooze;repeat;text or content`) as a
	// VALARM component.
	def alarmOf(p CalendarProperty, clock Clock) CalendarComponent {
		let parts = p.value.split(";")
		let action = p.name == "AALARM" ?? ("AUDIO", p.name == "MALARM" ?? ("EMAIL", "DISPLAY"))
		let out = CalendarComponent{name: "VALARM", properties: [CalendarProperty{name:"ACTION", value:action}]}
		let run = parts.len() > 0 ?? (utcValue(parts[0], clock), "")
		run = run + "Z" when run.len() == 15
		out.properties.push(CalendarProperty{name: "TRIGGER", value: run, params: [CalendarParam{name:"VALUE", values:["DATE-TIME"]}]}) when run != ""
		if parts.len() > 2 && parts[2].trim().isNumeric() && parts[2].trim() != "0" {
			out.properties.push(CalendarProperty{name: "REPEAT", value: parts[2].trim()})
			out.properties.push(CalendarProperty{name: "DURATION", value: parts[1].trim()}) when parts[1].trim() != ""
		}
		let content = parts.len() > 3 ?? (parts[3:].join(";"), "")
		switch {
			case action == "DISPLAY":
				out.properties.push(CalendarProperty{name: "DESCRIPTION", value: content == "" ?? ("Reminder", content)})
			case action == "EMAIL":
				out.properties.push(CalendarProperty{name: "ATTENDEE", value: addressOf(content)}) when content != ""
				out.properties.push(CalendarProperty{name: "SUMMARY", value: "Reminder"})
				out.properties.push(CalendarProperty{name: "DESCRIPTION", value: parts.len() > 4 ?? (parts[4], "Reminder")})
			default:
				out.properties.push(CalendarProperty{name: "ATTACH", value: content}) when content != ""
		}
		return out
	}

	// A vCalendar 1.0 rule (`W1 MO WE #10`, `MP1 1+ SU 19991231T000000`,
	// `MD1 1- #0`, `YM1 6 7`, `YD2 100`) as an iCalendar RRULE; "" for
	// one it cannot read. No end means two instances; `#0` means none.
	def ruleText(text string, clock Clock) string {
		let words = text.trim().split(" ").filter(w => w != "")
		return "" when words.len() == 0
		let head = words[0].upper()
		let code = (head.startsWith("MP") || head.startsWith("MD") || head.startsWith("YM") || head.startsWith("YD")) ?? (head[:2], head[:1])
		let interval = head[code.len():]
		return "" unless interval.isNumeric()
		let freq = ""
		switch {
			case code == "D":
				freq = "DAILY"
			case code == "W":
				freq = "WEEKLY"
			case code := "MP" || "MD":
				freq = "MONTHLY"
			case code := "YM" || "YD":
				freq = "YEARLY"
			default:
				return ""
		}
		let parts = ["FREQ=" + freq]
		parts.push("INTERVAL=" + interval) unless interval == "1"
		let count = "2"
		let until = ""
		let days string[] = []
		let numbers string[] = []
		let ordinals string[] = []
		let afterDay = false
		for let i = 1; i < words.len(); i++ {
			let w = words[i].upper()
			if w.startsWith("#") {
				count = w[1:]
				continue
			}
			if w.len() >= 15 && w[:8].isNumeric() {
				until = utcValue(w, clock)
				count = ""
				continue
			}
			if w := "SU" || "MO" || "TU" || "WE" || "TH" || "FR" || "SA" {
				for let o in ordinals {
					days.push(o + w)
				} empty {
					days.push(w)
				}
				afterDay = true
				continue
			}
			if w == "LD" {
				numbers.push("-1")
				continue
			}
			let negative = w.endsWith("-")
			let bare = w.trimSuffix("-").trimSuffix("+")
			continue unless bare.isNumeric()
			let n = (negative ?? ("-", "")) + bare
			if code == "MP" {
				// Ordinals apply to the weekdays after them, until the next
				// ordinals.
				ordinals = [] when afterDay
				afterDay = false
				ordinals.push(n)
			} else {
				numbers.push(n)
			}
		}
		parts.push("BYDAY=" + days.join(",")) when days.len() > 0
		if numbers.len() > 0 {
			let key = code == "MD" ?? ("BYMONTHDAY", code == "YM" ?? ("BYMONTH", "BYYEARDAY"))
			parts.push(key + "=" + numbers.join(",")) when code := "MD" || "YM" || "YD"
		}
		parts.push("UNTIL=" + until) when until != ""
		parts.push("COUNT=" + count) when count != "" && count != "0"
		return parts.join(";")
	}
}
