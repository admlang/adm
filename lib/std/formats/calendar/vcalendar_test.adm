partial module std.formats.calendar {
	use (
		std.testing
		std.bytes
		std.formats.calendar.civil::*
	)

	check "vCalendar" {
		internal def two(n int) string {
			return n < 10 ?? ("0" + n.str(), n.str())
		}

		@test()
		def TestVCalendarRead() !none {
			let data = "BEGIN:VCALENDAR\r\nVERSION:1.0\r\nPRODID:-//Nokia//EN\r\nTZ:-05:00\r\nDAYLIGHT:TRUE;-04;19960407T020000;19961027T020000;EST;EDT\r\nBEGIN:VEVENT\r\nDCREATED:19960401T082000\r\nDTSTART:19960415T090000\r\nDTEND:19960415T100000\r\nSUMMARY;ENCODING=QUOTED-PRINTABLE;CHARSET=ISO-8859-1:Caf=E9 =\r\nmeeting\r\nCATEGORIES:WORK;MEETING\r\nRRULE:W1 MO TH #4\r\nEXDATE:19960418T090000\r\nATTENDEE;ROLE=ORGANIZER;STATUS=CONFIRMED:Boss <boss@example.com>\r\nATTENDEE;ROLE=ATTENDEE;STATUS=NEEDS ACTION;RSVP=YES:ann@example.com\r\nDALARM:19960415T083000;PT5M;2;Meeting soon\r\nSTATUS:TENTATIVE\r\nEND:VEVENT\r\nBEGIN:VTODO\r\nDUE:19961231T235959\r\nSUMMARY:Year end\r\nRRULE:MP1 1+ MO 2- 1- FR #3\r\nSTATUS:NEEDS ACTION\r\nEND:VTODO\r\nEND:VCALENDAR\r\n"
			let cal = try new VCalendar().read(new bytes.Reader(data.bytes()))
			assert cal.entries.len() == 2 && cal.productId == "-//Nokia//EN"
			let e = cal.entries[0]
			assert e.summary == "Café meeting" && e.categories.len() == 2 && e.status == "TENTATIVE"
			// April 15 1996 is in daylight time: 09:00 EDT is 13:00Z.
			let start = e.start
			assert !(start is none) && start.utc && start.hour == 13
			let organizer = e.organizer
			assert !(organizer is none) && organizer.address == "mailto:boss@example.com"
			assert e.attendees[0].status == "NEEDS-ACTION" && e.attendees[0].rsvp && e.attendees[0].address == "mailto:ann@example.com"
			assert e.alarms[0].action == "DISPLAY" && e.alarms[0].repeat == 2 && e.alarms[0].description == "Meeting soon"
			assert e.rules[0].count == 4 && e.rules[0].byDay.len() == 2
			let all = try cal.occurrences(instantOf(int64(0)), instantOf(int64(4102444800)))
			let events = all.filter(o => o.entry.kind == EntryKind.Event)
			assert events.len() == 3
			let t = cal.entries[1]
			assert t.kind == EntryKind.Todo && t.status == "NEEDS-ACTION"
			assert t.rules[0].byDay.len() == 3 && t.rules[0].byDay[0].ordinal == 1 && t.rules[0].byDay[1].ordinal == -2 && t.rules[0].byDay[2].ordinal == -1
			let failed = false
			new VCalendar().write(cal, new bytes.Buffer()) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			// load picks vCalendar for a 1.0 file.
			let loaded = try load(new bytes.Reader(data.bytes()))
			assert loaded.entries.len() == 2
		}

		@test()
		def TestXCal() !none {
			// RFC 6321 §4 (trimmed), with a recurrence rule and a list.
			let data = "<?xml version=\"1.0\" encoding=\"utf-8\"?><icalendar xmlns=\"urn:ietf:params:xml:ns:icalendar-2.0\"><vcalendar><properties><calscale><text>GREGORIAN</text></calscale><prodid><text>-//Example Inc.//Example Calendar//EN</text></prodid><version><text>2.0</text></version></properties><components><vevent><properties><dtstamp><date-time>2008-02-05T19:12:24Z</date-time></dtstamp><dtstart><date>2008-10-06</date></dtstart><summary><text>Planning meeting, room 2</text></summary><uid><text>4088E990AD89CB3DBB484909</text></uid><rrule><recur><freq>WEEKLY</freq><count>3</count><byday>MO</byday><byday>WE</byday></recur></rrule><categories><text>WORK</text><text>PLANNING</text></categories><attendee><parameters><rsvp><boolean>true</boolean></rsvp><partstat><text>NEEDS-ACTION</text></partstat></parameters><cal-address>mailto:a@example.com</cal-address></attendee><geo><geo><latitude>37.386013</latitude><longitude>-122.082932</longitude></geo></geo></properties></vevent></components></vcalendar></icalendar>"
			let cal = try new XCal().read(new bytes.Reader(data.bytes()))
			assert cal.scale == "GREGORIAN" && cal.entries.len() == 1
			let e = cal.entries[0]
			assert e.summary == "Planning meeting, room 2" && e.uid == "4088E990AD89CB3DBB484909"
			let start = e.start
			assert !(start is none) && start.allDay && start.day == 6
			assert e.rules[0].count == 3 && e.rules[0].byDay.len() == 2 && e.categories.len() == 2
			assert e.attendees[0].rsvp && e.attendees[0].status == "NEEDS-ACTION"
			let geo = e.geo
			assert !(geo is none) && geo.latitude > 37.0
			let stamp = e.stamp
			assert !(stamp is none) && stamp.hour() == 19
			let out = new bytes.Buffer()
			try new XCal().write(cal, out)
			let xml = string(out.bytes())
			assert xml.contains("<dtstart><date>2008-10-06</date></dtstart>") && xml.contains("<recur><freq>WEEKLY</freq><count>3</count><byday>MO</byday><byday>WE</byday></recur>")
			let back = try new XCal().read(new bytes.Reader(out.bytes()))
			assert back.entries.len() == 1 && back.entries[0].summary == e.summary && back.entries[0].rules[0].count == 3
			let days = try back.occurrences(instantOf(int64(0)), instantOf(int64(4102444800)))
			assert days.len() == 3
		}
	}
}
