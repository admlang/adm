partial module std.formats.calendar {
	use (
		std.io
		std.bytes
		std.formats.calendar.loader::*
		std.formats.calendar.xcal::*
	)

	// XCal is iCalendar as XML (xCal, RFC 6321, `application/calendar+xml`):
	// each component a `properties` and a `components` element, each
	// property its parameters and typed value elements (dates in extended
	// form, recurrence rules as elements). It carries what iCalendar
	// carries, through the same model.
	@codec("xCal")
	type XCal {
		extension string[] {
			def get() string[] {
				return string[".xcs", ".xml"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["application/calendar+xml"]
			}
		}

		// matchSignature implements SignatureMatcher: an `icalendar` root
		// in the xCal namespace.
		def matchSignature(r io.Reader) bool {
			let text = head(r, 1024)
			return text.contains("<icalendar") && text.contains(xcalNamespace)
		}

		// read implements CalendarFormat.
		// Fails when the data is not XML with an `icalendar` root, or the
		// reader fails.
		def read(reader io.Reader) !Calendar {
			let components = try componentsOfXML(try readText(reader))
			let out = new bytes.Buffer()
			let codec = new ICalendar()
			try codec.writeComponents(components, out)
			return try codec.read(new bytes.Reader(out.bytes()))
		}

		// write implements CalendarFormat.
		// Fails when the writer fails.
		def write(calendar Calendar, writer io.Writer) !none {
			let text = new bytes.Buffer()
			let codec = new ICalendar()
			try codec.write(calendar, text)
			let components = try codec.readComponents(new bytes.Reader(text.bytes()))
			return try put(writer, xmlOfComponents(components))
		}
	}
}

internal partial module std.formats.calendar.xcal {
	use (
		std.data.encoding::(XML, XMLNode, XMLNodeKind)
		std.formats.calendar::*
	)

	// The namespace of xCal.
	const xcalNamespace = "urn:ietf:params:xml:ns:icalendar-2.0"

	// The value type a property has when `VALUE` does not say.
	def defaultType(name string) string {
		switch {
			case name := "ATTACH" || "TZURL" || "URL" || "SOURCE" || "IMAGE" || "CONFERENCE":
				return "uri"
			case name := "GEO":
				return "geo"
			case name := "PERCENT-COMPLETE" || "PRIORITY" || "REPEAT" || "SEQUENCE":
				return "integer"
			case name := "COMPLETED" || "DTEND" || "DUE" || "DTSTART" || "RECURRENCE-ID" || "EXDATE" || "RDATE" || "CREATED" || "DTSTAMP" || "LAST-MODIFIED" || "ACKNOWLEDGED":
				return "date-time"
			case name := "DURATION" || "TRIGGER" || "REFRESH-INTERVAL":
				return "duration"
			case name == "FREEBUSY":
				return "period"
			case name := "TZOFFSETFROM" || "TZOFFSETTO":
				return "utc-offset"
			case name := "ATTENDEE" || "ORGANIZER":
				return "cal-address"
			case name == "RRULE":
				return "recur"
			case name == "REQUEST-STATUS":
				return "request-status"
			case name.startsWith("X-") || name.startsWith("IANA-"):
				return "unknown"
		}
		return "text"
	}

	// The value type of a parameter.
	def paramType(name string) string {
		switch {
			case name := "DELEGATED-FROM" || "DELEGATED-TO" || "MEMBER" || "SENT-BY":
				return "cal-address"
			case name := "ALTREP" || "DIR":
				return "uri"
			case name == "RSVP":
				return "boolean"
		}
		return "text"
	}

	// The properties whose values are comma lists.
	def listed(name string) bool {
		return name := "CATEGORIES" || "RESOURCES" || "EXDATE" || "RDATE" || "FREEBUSY"
	}

	// Text with iCalendar escapes.
	def escape(text string) string {
		return text.replace("\\", "\\\\").replace("\n", "\\n").replace(",", "\\,").replace(";", "\\;")
	}

	// Text with iCalendar escapes undone.
	def unescape(text string) string {
		return text unless text.contains("\\")
		return text.replace("\\\\", "\u0001").replace("\\n", "\n").replace("\\N", "\n").replace("\\,", ",").replace("\\;", ";").replace("\u0001", "\\")
	}

	// `value` split on the separator no backslash escapes.
	def splitEscaped(value string, sep string) string[] {
		let out string[] = []
		let current = ""
		let escaped = false
		for let c in value.bytes() {
			let s = string([c])
			if escaped {
				current += s
				escaped = false
				continue
			}
			if s == "\\" {
				current += s
				escaped = true
				continue
			}
			if s == sep {
				out.push(current)
				current = ""
				continue
			}
			current += s
		}
		out.push(current)
		return out
	}

	// A date, date-time, time or offset in basic form (`2011-05-17T12:00:00Z`
	// is `20110517T120000Z`).
	def basic(text string) string {
		return text.trim().replace("-", "").replace(":", "")
	}

	// A basic DATE, DATE-TIME, TIME or UTC-OFFSET in extended form.
	def extended(text string, kind string) string {
		let v = text.trim()
		switch {
			case kind == "date" && v.len() == 8:
				return "{v[:4]}-{v[4:6]}-{v[6:8]}"
			case kind == "date-time" && v.len() >= 15:
				return "{v[:4]}-{v[4:6]}-{v[6:8]}T{v[9:11]}:{v[11:13]}:{v[13:15]}{v[15:]}"
			case kind == "time" && v.len() >= 6:
				return "{v[:2]}:{v[2:4]}:{v[4:6]}{v[6:]}"
			case kind == "utc-offset" && v.len() >= 5:
				let out = "{v[:3]}:{v[3:5]}"
				return v.len() >= 7 ?? (out + ":" + v[5:7], out)
		}
		return v
	}

	// A basic value whose form tells DATE from DATE-TIME.
	def dateKind(value string) string {
		return value.contains("T") ?? ("date-time", "date")
	}

	// ---- reading ----

	// The element children of a node.
	def elementsOf(node XMLNode) XMLNode[] {
		return node.children.filter(c => c.kind == XMLNodeKind.Element)
	}

	// The components of an xCal document.
	// Fails when the text is not XML with an `icalendar` root.
	def componentsOfXML(text string) !CalendarComponent[] {
		let root = try new XML().parse(text)
		fail "xcal: the root is not icalendar" unless root.localName == "icalendar"
		let out CalendarComponent[] = []
		for let el in elementsOf(root) {
			out.push(componentOf(el))
		}
		return out
	}

	// One component element.
	def componentOf(el XMLNode) CalendarComponent {
		let c = CalendarComponent{name: el.localName.upper()}
		for let part in elementsOf(el) {
			if part.localName == "properties" {
				for let p in elementsOf(part) {
					c.properties.push(propertyOf(p))
				}
			} else if part.localName == "components" {
				for let sub in elementsOf(part) {
					c.components.push(componentOf(sub))
				}
			}
		}
		return c
	}

	// One property element as an iCalendar property.
	def propertyOf(el XMLNode) CalendarProperty {
		let name = el.localName.upper()
		let p = CalendarProperty{name: name, value: ""}
		let values XMLNode[] = []
		for let child in elementsOf(el) {
			if child.localName == "parameters" {
				for let param in elementsOf(child) {
					let texts = elementsOf(param).mapElem<string>(v => v.text())
					p.params.push(CalendarParam{name: param.localName.upper(), values: texts})
				}
				continue
			}
			values.push(child)
		}
		let parts string[] = []
		let kind = values.len() > 0 ?? (values[0].localName, "")
		for let v in values {
			parts.push(valueText(v))
		}
		p.value = parts.join(listed(name) ?? (",", ","))
		let expected = defaultType(name)
		if kind != "" && kind != expected && kind != "unknown" && !(kind == "date" && expected == "date-time") {
			p.params.push(CalendarParam{name: "VALUE", values: [kind.upper()]})
		} else if kind == "date" && expected == "date-time" {
			p.params.push(CalendarParam{name: "VALUE", values: ["DATE"]})
		}
		return p
	}

	// One value element as iCalendar value text.
	def valueText(v XMLNode) string {
		let kind = v.localName
		switch {
			case kind := "date" || "date-time" || "time" || "utc-offset":
				return basic(v.text())
			case kind == "text":
				return escape(v.text())
			case kind == "period":
				let start = v.child("start", xcalNamespace)
				let end = v.child("end", xcalNamespace)
				let length = v.child("duration", xcalNamespace)
				let from = start is none ?? ("", basic(start.text()))
				return from + "/" + (end is none ?? (length is none ?? ("", length.text().trim()), basic(end.text())))
			case kind == "recur":
				return recurText(v)
			case kind == "geo":
				let lat = v.child("latitude", xcalNamespace)
				let lon = v.child("longitude", xcalNamespace)
				return (lat is none ?? ("", lat.text().trim())) + ";" + (lon is none ?? ("", lon.text().trim()))
			case kind == "request-status":
				let parts string[] = []
				for let field in elementsOf(v) {
					parts.push(field.localName == "code" ?? (field.text().trim(), escape(field.text())))
				}
				return parts.join(";")
		}
		return v.text()
	}

	// A `recur` element as a RECUR value.
	def recurText(v XMLNode) string {
		let order string[] = []
		let values = map<string, string[]>{}
		for let part in elementsOf(v) {
			let key = part.localName.upper()
			let text = part.text().trim()
			text = basic(text) when key == "UNTIL"
			if !values.hasKey(key) {
				order.push(key)
				values[key] = []
			}
			values[key] = values[key] + [text]
		}
		let parts string[] = []
		for let k in order {
			let items = values.get(k)
			parts.push(k + "=" + items.join(",")) unless items is none
		}
		return parts.join(";")
	}

	// ---- writing ----

	// An element in the xCal namespace.
	def node(name string) XMLNode {
		return new XMLNode(name, xcalNamespace)
	}

	// An element holding text.
	def textNode(name string, text string) XMLNode {
		let n = node(name)
		n.add(text)
		return n
	}

	// The value type a property is written with.
	def valueType(p CalendarProperty) string {
		for let q in p.params {
			return q.values[0].lower() when q.name == "VALUE" && q.values.len() > 0
		}
		let t = defaultType(p.name)
		return (t == "date-time" && !p.value.contains("T")) ?? ("date", t)
	}

	// Components as an xCal document.
	def xmlOfComponents(components CalendarComponent[]) string {
		let root = node("icalendar")
		root.set("xmlns", xcalNamespace)
		for let c in components {
			root.add(componentElement(c))
		}
		return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + root.str() + "\n"
	}

	// One component as an element.
	def componentElement(c CalendarComponent) XMLNode {
		let el = node(c.name.lower())
		if c.properties.len() > 0 {
			let props = el.add(node("properties"))
			for let p in c.properties {
				props.add(propertyElement(p))
			}
		}
		if c.components.len() > 0 {
			let subs = el.add(node("components"))
			for let sub in c.components {
				subs.add(componentElement(sub))
			}
		}
		return el
	}

	// One property as an element.
	def propertyElement(p CalendarProperty) XMLNode {
		let el = node(p.name.lower())
		let params = p.params.filter(q => q.name != "VALUE" && q.values.len() > 0)
		if params.len() > 0 {
			let holder = el.add(node("parameters"))
			for let q in params {
				let pn = holder.add(node(q.name.lower()))
				let t = paramType(q.name)
				for let v in q.values {
					pn.add(textNode(t, t == "boolean" ?? (v.lower(), v)))
				}
			}
		}
		let t = valueType(p)
		let items = listed(p.name) ?? (splitEscaped(p.value, ","), [p.value])
		for let item in items {
			el.add(valueElement(t, item))
		}
		return el
	}

	// One value as its element.
	def valueElement(kind string, value string) XMLNode {
		switch {
			case kind := "date" || "date-time":
				let k = kind == "date-time" ?? (dateKind(value), "date")
				return textNode(k, extended(value, k))
			case kind := "time" || "utc-offset":
				return textNode(kind, extended(value, kind))
			case kind == "text":
				return textNode("text", unescape(value))
			case kind == "period":
				let n = node("period")
				let slash = value.indexOf("/")
				let start = slash < 0 ?? (value, value[:slash])
				let rest = slash < 0 ?? ("", value[slash + 1:])
				n.add(textNode("start", extended(start, dateKind(start))))
				if rest.startsWith("P") || rest.startsWith("-P") || rest.startsWith("+P") {
					n.add(textNode("duration", rest))
				} else if rest != "" {
					n.add(textNode("end", extended(rest, dateKind(rest))))
				}
				return n
			case kind == "recur":
				let n = node("recur")
				for let part in value.split(";") {
					let eq = part.indexOf("=")
					continue when eq < 0
					let key = part[:eq].lower()
					for let item in part[eq + 1:].split(",") {
						n.add(textNode(key, key == "until" ?? (extended(item, dateKind(item)), item)))
					}
				}
				return n
			case kind == "geo":
				let n = node("geo")
				let parts = value.split(";")
				n.add(textNode("latitude", parts[0].trim()))
				n.add(textNode("longitude", parts.len() > 1 ?? (parts[1].trim(), "")))
				return n
			case kind == "request-status":
				let n = node("request-status")
				let parts = splitEscaped(value, ";")
				let names = ["code", "description", "data"]
				for let i = 0; i < parts.len() && i < 3; i++ {
					n.add(textNode(names[i], i == 0 ?? (parts[i], unescape(parts[i]))))
				}
				return n
		}
		return textNode(kind, value)
	}
}
