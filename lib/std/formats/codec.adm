partial module std.formats {
	use (
		std.reflection
		std.io
		std.os
		std.bytes
	)

	internal type Marker = def <FileFormat>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string)

	type CodecRegistry<T: FileFormat> {
		// Domain name for codecs
		internal kind     string
		internal marker   any
		internal registry map<string, reflection.TypeDescriptor>
		internal loaded   bool

		def new(kind string, marker any) {
			self.kind = kind
			self.marker = marker
			registry = new map<string, reflection.TypeDescriptor>()
		}

		internal atomic def discover() {
			return when loaded
			loaded = true
			for let (_, hit) in reflection.attrs(marker) {
				let decoder = reflection.asType(hit.node)
				continue when decoder is none

				let name = hit.attr.arguments.valueOf("name")
				continue when name is none

				let ext = string(name)
				continue when ext.len() == 0

				registry.set(ext, decoder)
			}
		}

		// match probes the stream and returns the codec that claims it, together
		// with a reader rewound to offset 0 and no longer recording.
		def probe(reader io.Reader) !(T, io.Reader) {
			discover()

			let r = new bytes.RewindableReader(reader)
			// Buffer the first 128 bytes so codecs can test signatures without
			// consuming the stream for the final decoder.
			try r.prebuffer(128)

			for let (_, t) in registry {
				let codec = reflection.instantiate(t)
				// Dispatch the signature test through the plain interface: an
				// interface call on a value typed as the generic parameter `T`
				// is not lowered correctly and faults at runtime.
				let sig SignatureMatcher = codec
				continue unless sig.matchSignature(r)

				// Decode from the start; stop recording so the whole
				// file is not retained during decoding.
				r.rewind().freeze()
				let rd io.Reader = r
				let out T = codec
				return (out, rd)
			} every {
				r.rewind()
			}

			fail "unsupported {kind} format"
		}

		def probe(data byte[]) !(T, io.Reader) {
			return probe(new bytes.Reader(data))
		}

		def matchExt(ext string) ?T {
			discover()
			let t = registry.get(ext)
			return none when t is none

			let codec = reflection.instantiate(t)
			return none unless codec is T
			return codec
		}
	}
}
