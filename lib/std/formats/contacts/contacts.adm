partial module std.formats.contacts {
	use (
		std.io
		std.os
		std.bytes
		std.reflection
		std.formats
		std.time
		std.formats.contacts.loader::*
	)

	// Contacts and address books: names, emails, phones, addresses,
	// organisations, dates, photos and groups, read and written by the
	// formats that register with `@codec` (vCard today).
	//
	// ```
	// let people = try contacts.load("friends.vcf")
	// for let person in people {
	//     println(person.fullName)
	// }
	// let card = Contact{fullName: "Ada Lovelace", emails: [ContactValue{value: "ada@example.com", types: ["home"]}]}
	// try contacts.save([card], "ada.vcf")
	// ```

	// ContactKind is what a contact stands for (vCard `KIND`).
	enum ContactKind {
		Individual  = "individual",
		// A group: its members are in `Contact.members`.
		Group       = "group",
		Org         = "org",
		Location    = "location",
		Application = "application",
		Device      = "device",
	}

	// ContactParam is one parameter of a contact property as the file
	// writes it: `TYPE=work,voice` is the name `TYPE` with two values.
	// Names are upper case.
	struct ContactParam {
		name   string
		values string[] = []
	}

	// ContactProperty is a property the model has no field for (`X-`
	// extensions, `CLIENTPIDMAP`, `XML`...), kept as the file wrote it so
	// it is written back unchanged. `value` is the vCard value text, still
	// escaped.
	struct ContactProperty {
		name   string
		value  string
		params ContactParam[] = []
		// The group the property belongs to (`item1.X-ABLabel`), "" for
		// none.
		group  string         = ""
	}

	// ContactValue is one value of a property that holds a single text or
	// URI: an email address, a phone number, a URL, a note, a photo...
	// `types` are the lower-case `TYPE` values (`work`, `home`, `cell`,
	// `voice`...); `pref` is 1 for the most preferred through 100, 0 when
	// not ranked.
	struct ContactValue {
		value  string
		types  string[]       = []
		pref   int            = 0
		// Parameters other than `TYPE` and `PREF` (`MEDIATYPE`, `LANGUAGE`,
		// `ALTID`, `PID`, `LABEL`, `LEVEL`...).
		params ContactParam[] = []
		group  string         = ""
	}

	// PersonName is the parts of a name (vCard `N`). A part may hold
	// several names (`given: ["Mary", "Jane"]`).
	struct PersonName {
		family          string[]       = []
		given           string[]       = []
		// Middle names (`additional names`).
		middle          string[]       = []
		// Honorific prefixes (`Dr.`) and suffixes (`Jr.`, `M.D.`).
		prefixes        string[]       = []
		suffixes        string[]       = []
		// A second family name (Spanish-speaking naming) and the
		// generation (`III`), RFC 9554.
		secondaryFamily string[]       = []
		generation      string[]       = []
		// How the name sorts (`SORT-AS`), e.g. `["Gogh", "Vincent"]` for
		// `van Gogh`.
		sortAs          string[]       = []
		params          ContactParam[] = []
		group           string         = ""
	}

	// Address is a postal address (vCard `ADR`). Every part is text; a
	// part the address does not have stays "".
	struct Address {
		poBox        string         = ""
		// The apartment, suite or building part in the address's own
		// words (`extended address`).
		extended     string         = ""
		street       string         = ""
		// City.
		locality     string         = ""
		// State or province.
		region       string         = ""
		postalCode   string         = ""
		country      string         = ""
		// The finer parts RFC 9554 adds, filled when the file splits the
		// street this way.
		room         string         = ""
		apartment    string         = ""
		floor        string         = ""
		streetNumber string         = ""
		streetName   string         = ""
		building     string         = ""
		block        string         = ""
		subdistrict  string         = ""
		district     string         = ""
		landmark     string         = ""
		direction    string         = ""
		// The address as it is printed on a label (`LABEL`).
		label        string         = ""
		// A `geo:` URI of the place.
		geo          string         = ""
		timeZone     string         = ""
		// ISO 3166 country code (`CC`, RFC 8605).
		countryCode  string         = ""
		types        string[]       = []
		pref         int            = 0
		params       ContactParam[] = []
		group        string         = ""
	}

	// Organization is where a contact works (vCard `ORG`): its name and
	// the units within it, outermost first.
	struct Organization {
		name   string
		units  string[]       = []
		sortAs string[]       = []
		types  string[]       = []
		pref   int            = 0
		params ContactParam[] = []
		group  string         = ""
	}

	// Gender is a contact's sex and gender identity (vCard `GENDER`). `sex`
	// is `M`, `F`, `O` (other), `N` (none or not applicable), `U`
	// (unknown) or "" (not said); `identity` is free text.
	struct Gender {
		sex      string = ""
		identity string = ""
	}

	// ContactDate is a date as contacts carry them: any part may be
	// missing (a birthday without a year is `month` and `day` alone), a
	// time may follow, and some dates are only text (`circa 1800`).
	struct ContactDate {
		// 0 when not given.
		year      int       = 0
		month     int       = 0
		day       int       = 0
		// -1 when not given.
		hour      int       = -1
		minute    int       = -1
		second    int       = -1
		// The offset from UTC of the time, none when the time is local or
		// absent.
		utcOffset ?duration = none
		// The date as text instead of the parts (`VALUE=text`).
		text      string    = ""
		// The calendar the date is in (`CALSCALE`), "" for Gregorian.
		calendar  string    = ""
	}

	// Contact is one person, group, organisation, place or device, with
	// what a vCard can say about it. Lists hold every value the file gave,
	// in its order.
	struct Contact {
		// Identifies the contact across copies (`UID`), usually a
		// `urn:uuid:` URI.
		uid               string            = ""
		kind              ContactKind       = ContactKind.Individual
		// The name as displayed (`FN`).
		fullName          string            = ""
		name              PersonName        = PersonName{}
		nicknames         ContactValue[]    = []
		// Pictures as URIs; an embedded picture is a `data:` URI.
		photos            ContactValue[]    = []
		birthday          ?ContactDate      = none
		birthplace        string            = ""
		deathDate         ?ContactDate      = none
		deathPlace        string            = ""
		anniversary       ?ContactDate      = none
		gender            Gender            = Gender{}
		addresses         Address[]         = []
		phones            ContactValue[]    = []
		emails            ContactValue[]    = []
		// Instant messaging URIs (`xmpp:`, `sip:`...).
		impps             ContactValue[]    = []
		// Languages the contact speaks (`LANG`), as language tags.
		languages         ContactValue[]    = []
		timeZones         ContactValue[]    = []
		// Where the contact is, as `geo:` URIs.
		geos              ContactValue[]    = []
		titles            ContactValue[]    = []
		roles             ContactValue[]    = []
		logos             ContactValue[]    = []
		organizations     Organization[]    = []
		// For a group: the members as URIs (`urn:uuid:` of their `uid`).
		members           ContactValue[]    = []
		// Other people and the relation (`types` such as `spouse`,
		// `child`, `colleague`), as URIs or text.
		related           ContactValue[]    = []
		categories        string[]          = []
		notes             ContactValue[]    = []
		// The software that wrote the card (`PRODID`).
		productId         string            = ""
		// When the card last changed (`REV`).
		revision          ?time.Time        = none
		// When the card was created (`CREATED`, RFC 9554).
		created           ?time.Time        = none
		sounds            ContactValue[]    = []
		urls              ContactValue[]    = []
		// Public keys or certificates, as URIs.
		keys              ContactValue[]    = []
		// Where the current version of the card lives (`SOURCE`).
		sources           ContactValue[]    = []
		freeBusyUrls      ContactValue[]    = []
		// Where to send the contact invitations (`CALADRURI`) and where
		// their calendars are (`CALURI`).
		calendarAddresses ContactValue[]    = []
		calendarUrls      ContactValue[]    = []
		// RFC 6715: what the contact knows, does and likes (`LEVEL` in
		// params), and the directories of their organisation.
		expertise         ContactValue[]    = []
		hobbies           ContactValue[]    = []
		interests         ContactValue[]    = []
		orgDirectories    ContactValue[]    = []
		// How to reach the contact through a form or page (`CONTACT-URI`,
		// RFC 8605).
		contactUrls       ContactValue[]    = []
		// RFC 9554: how to address the contact (`GRAMGENDER`, one of
		// `animate`, `common`, `feminine`, `inanimate`, `masculine`,
		// `neuter`), the language the card is written in, pronouns and
		// social network profiles.
		grammaticalGender string            = ""
		language          string            = ""
		pronouns          ContactValue[]    = []
		socialProfiles    ContactValue[]    = []
		// Properties the model has no field for, written back as read.
		extra             ContactProperty[] = []
	}

	// ContactFormat reads and writes one contact file format.
	interface ContactFormat {
		// read parses every contact of the data.
		// Fails when the data is not this format, or the reader fails.
		def read(reader io.Reader) !Contact[]

		// write writes contacts in this format.
		// Fails when a contact cannot be written in it, or the writer
		// fails.
		def write(contacts Contact[], writer io.Writer) !none
	}

	// ContactCodec is what a contact format registers.
	type ContactCodec = ContactFormat & formats.FileFormat

	// codec registers a contact format under `name`.
	meta def codec<ContactCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	// load reads the contacts of the file at `path`, picking the format by
	// extension, else by content.
	// Fails when no registered format reads the file, or it cannot be read.
	def load(path string) !Contact[] {
		let data = try os.readFile(path)
		let format = codecRegistry.matchExt(os.extension(path))
		return try load(new bytes.Reader(data)) when format is none
		return format.read(new bytes.Reader(data))
	}

	// load reads contacts from `reader`, picking the format by content.
	// Fails when no registered format reads the data, or the reader fails.
	def load(reader io.Reader) !Contact[] {
		let (format, r) = try codecRegistry.probe(reader)
		return format.read(r)
	}

	// save writes contacts to `path` in the format its extension names.
	// Fails when no registered format has the extension, or the file cannot
	// be written.
	def save(contacts Contact[], path string) !none {
		let format = codecRegistry.matchExt(os.extension(path))
		fail "no contact format has the extension \"{os.extension(path)}\"" when format is none
		let out = new bytes.Buffer()
		try format.write(contacts, out)
		return os.writeFile(path, out.bytes())
	}
}

internal partial module std.formats.contacts.loader {
	use (
		std.io
		std.bytes
		std.formats
		std.formats.contacts::*
	)

	let codecRegistry = new formats.CodecRegistry<ContactCodec>("contacts", codec)

	// The whole of `reader` as text, without a UTF-8 byte order mark.
	// Fails when the reader does.
	def readText(reader io.Reader) !string {
		let buffer = new bytes.Buffer()
		try buffer.readFrom(reader)
		return string(buffer.bytes()).trimPrefix("\uFEFF")
	}

	// Up to `count` bytes from the start of `reader` as text, for a signature
	// test; what a failing reader gave before it failed.
	def head(reader io.Reader, count int) string {
		let out byte[]
		let buf byte[]
		buf.len(count)
		for out.len() < count {
			let n = reader.read(buf[:count - out.len()]) onerror recover 0
			break when n <= 0
			for let i = 0; i < n; i++ {
				out.push(buf[i])
			}
		}
		return string(out).trimPrefix("\uFEFF")
	}

	// Writes `text` to `writer`.
	// Fails when the writer does.
	def put(writer io.Writer, text string) !none {
		try writer.write(text.bytes())
	}
}
