partial module std.formats.contacts {
	use (
		std.io
		std.data.encoding::(CSV)
		std.formats.contacts.loader::*
		std.formats.contacts.table::*
	)

	// CSVLayout is the column set of an address book CSV export.
	enum CSVLayout {
		// Google Contacts (`First Name`, `E-mail 1 - Value`...).
		Google,
		// Microsoft Outlook (`E-mail Address`, `Business Phone`...).
		Outlook,
		// Mozilla Thunderbird (`Primary Email`, `Work Phone`...).
		Thunderbird,
	}

	// ContactsCSV is an address book as CSV, as Google Contacts, Outlook
	// and Thunderbird export and import it. Reading takes any of their
	// column sets (older and newer Google headers too), telling columns
	// apart by header; a column none of them has comes back as an `X-`
	// property named after its header. Writing uses `layout`.
	@codec("Contacts CSV")
	type ContactsCSV {
		// The columns `write` writes.
		layout    CSVLayout = CSVLayout.Google
		// The field separator; "" reads whichever of `,`, `;` and tab the
		// header line uses, and writes `,`.
		separator string    = ""

		extension string[] {
			def get() string[] {
				return string[".csv"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["text/csv"]
			}
		}

		// matchSignature implements SignatureMatcher: a header line with a
		// column only address books have.
		def matchSignature(r io.Reader) bool {
			let line = head(r, 2048).split("\n")[0].lower()
			return line.contains("e-mail 1 - value") || line.contains("primary email") || line.contains("e-mail address") || (line.contains("given name") && line.contains("family name"))
		}

		// read implements ContactFormat: one contact per row after the
		// header.
		// Fails when the text is not CSV, or the reader fails.
		def read(reader io.Reader) !Contact[] {
			let text = try readText(reader)
			let sep = separator == "" ?? (separatorOf(text), separator)
			let rows = try new CSV(sep).decode(text)
			fail "contacts csv: no header line" when rows.len() == 0
			let out Contact[] = []
			for let i = 1; i < rows.len(); i++ {
				continue when rows[i].filter(f => f.trim() != "").len() == 0
				out.push(contactOfRow(rows[0], rows[i]))
			}
			return out
		}

		// write implements ContactFormat.
		// Fails when the writer fails.
		def write(contacts Contact[], writer io.Writer) !none {
			let rows = rowsOf(contacts, layout)
			return try put(writer, new CSV(separator == "" ?? (",", separator)).encode(rows))
		}
	}
}
