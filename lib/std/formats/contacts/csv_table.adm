internal partial module std.formats.contacts.table {
	use (
		std.formats.contacts::*
	)

	// The column sets of address book CSV exports, read by header and
	// written in one layout.

	// The separator the header line uses: `,`, `;` or tab, whichever it
	// holds most of outside quotes.
	def separatorOf(text string) string {
		let line = text.trimPrefix("﻿").split("\n")[0]
		let counts = [0, 0, 0]
		let quoted = false
		for let c in line.bytes() {
			if c == byte('"') {
				quoted = !quoted
				continue
			}
			continue when quoted
			counts[0] += 1 when c == byte(',')
			counts[1] += 1 when c == byte(';')
			counts[2] += 1 when c == byte('\t')
		}
		return ";" when counts[1] > counts[0] && counts[1] >= counts[2]
		return "\t" when counts[2] > counts[0] && counts[2] > counts[1]
		return ","
	}

	// A numbered Google column (`E-mail 2 - Value`): its kind (`e-mail`),
	// number and field (`value`); none for another header.
	struct Slot {
		kind   string
		number int
		field  string
	}

	def slotOf(header string) ?Slot {
		let dash = header.indexOf(" - ")
		return none when dash < 0
		let head = header[:dash].trim()
		let field = header[dash + 3:].trim()
		let space = lastSpace(head)
		return none when space < 0
		let number = head[space + 1:]
		return none unless number.isNumeric()
		return Slot{kind: head[:space], number: number.toInt<int>(), field: field}
	}

	// The index of the last space of `text`, -1 when it has none.
	def lastSpace(text string) int {
		let at = -1
		let i = 0
		for let c in text.bytes() {
			at = i when c == byte(' ')
			i++
		}
		return at
	}

	// The types a label names (`Mobile` is `cell`, `Work Fax` is `work`
	// and `fax`); the preferred mark `* ` of Google left out.
	def typesOf(label string) string[] {
		let out string[] = []
		for let word in label.trimPrefix("*").trim().lower().split(" ") {
			let t = word.trim()
			continue when t == ""
			t = "cell" when t == "mobile"
			t = "work" when t == "business"
			out.push(t) unless out.includes(t)
		}
		return out
	}

	// A date as address book exports write it: `1990-05-17`, `--05-17`,
	// `5/17/1990`, `1990/05/17`.
	def dateOf(text string) ?ContactDate {
		let v = text.trim()
		return none when v := "" || "0/0/00" || "1/1/1601"
		if v.startsWith("--") {
			let parts = v[2:].split("-")
			return none unless parts.len() == 2 && parts[0].isNumeric() && parts[1].isNumeric()
			return ContactDate{month: parts[0].toInt<int>(), day: parts[1].toInt<int>()}
		}
		let sep = v.contains("-") ?? ("-", "/")
		let parts = v.split(" ")[0].split(sep)
		return ContactDate{text: v} unless parts.len() == 3 && parts[0].isNumeric() && parts[1].isNumeric() && parts[2].isNumeric()
		let a = parts[0].toInt<int>()
		let b = parts[1].toInt<int>()
		let c = parts[2].toInt<int>()
		return ContactDate{year: a, month: b, day: c} when parts[0].len() == 4
		// Outlook writes month/day/year.
		let year = c < 100 ?? (c + (c < 50 ?? (2000, 1900)), c)
		return ContactDate{year: year, month: a, day: b}
	}

	// A contact date as Google writes it.
	def googleDate(d ContactDate) string {
		return d.text when d.text != ""
		return "--{two(d.month)}-{two(d.day)}" when d.year == 0
		return "{d.year}-{two(d.month)}-{two(d.day)}"
	}

	// A contact date as Outlook writes it.
	def outlookDate(d ContactDate) string {
		return "" when d.text != "" || d.month == 0
		return "{d.month}/{d.day}/{d.year == 0 ?? (1604, d.year)}"
	}

	def two(n int) string {
		return n < 10 ?? ("0" + n.str(), n.str())
	}

	// The value of a column of a row, "" past its end.
	def cell(row string[], i int) string {
		return i < row.len() ?? (row[i], "")
	}

	// A text value.
	def value(text string, types string[]) ContactValue {
		return ContactValue{value: text, types: types}
	}

	// ---- reading ----

	// The contact of one row.
	def contactOfRow(header string[], row string[]) Contact {
		let c = Contact{}
		let slots = map<string, map<string, string>>{}
		let order string[] = []
		let addresses = map<string, Address>{}
		let addressOrder string[] = []
		let birth = ContactDate{}
		let org = Organization{name: ""}
		for let i = 0; i < header.len(); i++ {
			let key = header[i].trim().lower()
			let v = cell(row, i).trim()
			continue when v == "" || key == ""
			let slot = slotOf(key)
			if !(slot is none) {
				let id = "{slot.kind} {slot.number}"
				if !slots.hasKey(id) {
					slots[id] = map<string, string>{}
					order.push(id)
				}
				slots[id][slot.field] = v
				continue
			}
			// Outlook and Thunderbird address columns.
			let place = addressColumn(key)
			if !(place is none) {
				let (kind, part) = place
				if !addresses.hasKey(kind) {
					addresses[kind] = Address{types: [kind]}
					addressOrder.push(kind)
				}
				setAddressPart(addresses[kind], part, v)
				continue
			}
			let phone = phoneColumn(key)
			if phone.len() > 0 {
				let types = phone.filter(t => t != "pref")
				c.phones.push(ContactValue{value: v, types: types, pref: phone.includes("pref") ?? (1, 0)})
				continue
			}
			switch {
				case key := "name" || "display name":
					c.fullName = v
				case key := "given name" || "first name":
					c.name.given = [v]
				case key := "additional name" || "middle name":
					c.name.middle = [v]
				case key := "family name" || "last name":
					c.name.family = [v]
				case key := "name prefix" || "title":
					c.name.prefixes = [v]
				case key := "name suffix" || "suffix":
					c.name.suffixes = [v]
				case key == "nickname":
					c.nicknames.push(value(v, []))
				case key == "file as":
					c.name.sortAs = [v]
				case key == "birthday":
					c.birthday = dateOf(v)
				case key == "anniversary":
					c.anniversary = dateOf(v)
				case key == "birth year" && v.isNumeric():
					birth.year = v.toInt<int>()
				case key == "birth month" && v.isNumeric():
					birth.month = v.toInt<int>()
				case key == "birth day" && v.isNumeric():
					birth.day = v.toInt<int>()
				case key := "notes" || "note":
					c.notes.push(value(v, []))
				case key == "photo":
					c.photos.push(value(v, []))
				case key := "labels" || "group membership":
					for let label in v.split(":::") {
						let name = label.trim().trimPrefix("* ").trim()
						c.categories.push(name) unless name := "" || "myContacts" || "*"
					}
				case key == "categories":
					for let label in v.split(";") {
						c.categories.push(label.trim()) unless label.trim() == ""
					}
				case key := "organization name" || "company" || "organization":
					org.name = v
				case key := "organization title" || "job title":
					c.titles.push(value(v, []))
				case key := "organization department" || "department":
					org.units = [v]
				case key := "e-mail address" || "primary email":
					c.emails.push(ContactValue{value: v, pref: key == "primary email" ?? (1, 0)})
				case key := "e-mail 2 address" || "e-mail 3 address" || "secondary email":
					c.emails.push(value(v, []))
				case key := "web page" || "web page 1" || "business web page":
					c.urls.push(value(v, ["work"]))
				case key := "personal web page" || "web page 2":
					c.urls.push(value(v, ["home"]))
				case key := "im address" || "screen name":
					c.impps.push(value(v, []))
				case key == "spouse":
					c.related.push(ContactValue{value: v, types: ["spouse"], params: [ContactParam{name:"VALUE", values:["text"]}]})
				case key == "manager's name":
					c.related.push(ContactValue{value: v, types: ["x-manager"], params: [ContactParam{name:"VALUE", values:["text"]}]})
				case key == "assistant's name":
					c.related.push(ContactValue{value: v, types: ["x-assistant"], params: [ContactParam{name:"VALUE", values:["text"]}]})
				case key == "hobby":
					c.hobbies.push(value(v, []))
				default:
					c.extra.push(ContactProperty{name: "X-" + propertyName(header[i]), value: escapeText(v)})
			}
		}
		c.birthday = birth when birth.month > 0 && c.birthday is none
		for let id in order {
			applySlot(c, id, slots[id], org)
		}
		for let kind in addressOrder {
			c.addresses.push(addresses[kind])
		}
		c.organizations.push(org) when org.name != "" || org.units.len() > 0
		return c
	}

	// A header as a property name: letters, digits and dashes, upper case.
	def propertyName(header string) string {
		let out byte[] = []
		for let ch in header.trim().upper().bytes() {
			let ok = (ch >= byte('A') && ch <= byte('Z')) || (ch >= byte('0') && ch <= byte('9'))
			out.push(ok ?? (ch, byte('-')))
		}
		return string(out)
	}

	// Text with vCard escapes.
	def escapeText(text string) string {
		return text.replace("\\", "\\\\").replace("\n", "\\n").replace(",", "\\,").replace(";", "\\;")
	}

	// The fields of one numbered Google column group.
	def applySlot(c Contact, id string, fields map<string, string>, org Organization) {
		let kind = id[:lastSpace(id)]
		let label = fields.get("label") is none ?? (fields.get("type") is none ?? ("", fieldOf(fields, "type")), fieldOf(fields, "label"))
		let types = typesOf(label)
		let pref = label.trim().startsWith("*") ?? (1, 0)
		let values = fieldOf(fields, "value").split(":::").mapElem<string>(s => s.trim()).filter(s => s != "")
		switch {
			case kind == "e-mail":
				for let v in values {
					c.emails.push(ContactValue{value: v, types: types, pref: pref})
				}
			case kind == "phone":
				for let v in values {
					c.phones.push(ContactValue{value: v, types: types, pref: pref})
				}
			case kind := "website" || "web site":
				for let v in values {
					c.urls.push(ContactValue{value: v, types: types, pref: pref})
				}
			case kind == "relation":
				for let v in values {
					c.related.push(ContactValue{value: v, types: types, params: [ContactParam{name:"VALUE", values:["text"]}]})
				}
			case kind == "im":
				let scheme = fieldOf(fields, "service").lower()
				for let v in values {
					c.impps.push(ContactValue{value: (scheme == "" || v.contains(":")) ?? (v, scheme + ":" + v), types: types})
				}
			case kind == "event":
				for let v in values {
					let d = dateOf(v)
					if label.lower().contains("anniversary") && c.anniversary is none {
						c.anniversary = d
					} else {
						c.extra.push(ContactProperty{name: "X-EVENT", value: escapeText(v), params: types.len() > 0 ?? ([ContactParam{name:"TYPE", values:types}], ContactParam[])})
					}
				}
			case kind == "address":
				let a = Address{types: types, pref: pref, label: fieldOf(fields, "formatted")}
				a.street = fieldOf(fields, "street")
				a.locality = fieldOf(fields, "city")
				a.poBox = fieldOf(fields, "po box")
				a.region = fieldOf(fields, "region")
				a.postalCode = fieldOf(fields, "postal code")
				a.country = fieldOf(fields, "country")
				a.extended = fieldOf(fields, "extended address")
				c.addresses.push(a)
			case kind == "organization":
				org.name = fieldOf(fields, "name") when fieldOf(fields, "name") != ""
				c.titles.push(value(fieldOf(fields, "title"), [])) when fieldOf(fields, "title") != ""
				org.units = [fieldOf(fields, "department")] when fieldOf(fields, "department") != ""
			case kind == "custom field":
				let name = propertyName(label == "" ?? ("custom", label))
				for let v in values {
					c.extra.push(ContactProperty{name: "X-" + name, value: escapeText(v)})
				}
			default:
				for let v in values {
					c.extra.push(ContactProperty{name: "X-" + propertyName(kind), value: escapeText(v)})
				}
		}
	}

	// A field of a column group, "" when absent.
	def fieldOf(fields map<string, string>, name string) string {
		let v = fields.get(name)
		return v is none ?? ("", v)
	}

	// The place and part an Outlook or Thunderbird address column names.
	def addressColumn(key string) ?(string, string) {
		for let prefix in ["business ", "home ", "other ", "work "] {
			continue unless key.startsWith(prefix)
			let part = key[prefix.len():]
			let kind = prefix.trim() == "business" ?? ("work", prefix.trim())
			return (kind, part) when part := "street" || "street 2" || "street 3" || "city" || "state" || "postal code" || "zipcode" || "country/region" || "country" || "po box" || "address" || "address 2"
		}
		return none
	}

	// Stores one address column.
	def setAddressPart(a Address, part string, v string) {
		switch {
			case part := "street" || "address":
				a.street = a.street == "" ?? (v, v + "\n" + a.street)
			case part := "street 2" || "street 3" || "address 2":
				a.street = a.street == "" ?? (v, a.street + "\n" + v)
			case part == "city":
				a.locality = v
			case part == "state":
				a.region = v
			case part := "postal code" || "zipcode":
				a.postalCode = v
			case part := "country/region" || "country":
				a.country = v
			case part == "po box":
				a.poBox = v
		}
	}

	// The types of an Outlook or Thunderbird phone column; none for
	// another column.
	def phoneColumn(key string) string[] {
		switch {
			case key := "home phone" || "home phone 2":
				return ["home", "voice"]
			case key := "business phone" || "business phone 2" || "work phone" || "company main phone":
				return ["work", "voice"]
			case key := "mobile phone" || "mobile number":
				return ["cell"]
			case key == "car phone":
				return ["car"]
			case key := "other phone" || "callback" || "radio phone" || "telex" || "assistant's phone":
				return ["voice"]
			case key == "primary phone":
				return ["voice", "pref"]
			case key := "pager" || "pager number":
				return ["pager"]
			case key == "business fax":
				return ["work", "fax"]
			case key == "home fax":
				return ["home", "fax"]
			case key := "other fax" || "fax number":
				return ["fax"]
			case key == "tty/tdd phone":
				return ["textphone"]
		}
		return []
	}

	// ---- writing ----

	// The rows of contacts in a layout, header first.
	def rowsOf(contacts Contact[], layout CSVLayout) string[][] {
		switch {
			case layout == CSVLayout.Outlook:
				return outlookRows(contacts)
			case layout == CSVLayout.Thunderbird:
				return thunderbirdRows(contacts)
		}
		return googleRows(contacts)
	}

	// The display name of a contact.
	def fullNameOf(c Contact) string {
		return c.fullName when c.fullName != ""
		return (c.name.prefixes + c.name.given + c.name.middle + c.name.family + c.name.suffixes).filter(p => p != "").join(" ")
	}

	// A label as Google writes it: capitalised types, `* ` when
	// preferred.
	def googleLabel(types string[], pref int) string {
		let words string[] = []
		for let t in types {
			continue when t := "voice" || "internet" || "pref"
			let word = t == "cell" ?? ("mobile", t)
			words.push(word[:1].upper() + word[1:])
		}
		let label = words.join(" ")
		return pref == 1 ?? ("* " + (label == "" ?? ("Other", label)), label)
	}

	def first(list string[]) string {
		return list.len() > 0 ?? (list[0], "")
	}

	def firstValue(list ContactValue[]) string {
		return list.len() > 0 ?? (list[0].value, "")
	}

	def maxOf(a int, b int) int {
		return a > b ?? (a, b)
	}

	def googleRows(contacts Contact[]) string[][] {
		let emails = 0
		let phones = 0
		let addresses = 0
		let urls = 0
		let relations = 0
		for let c in contacts {
			emails = maxOf(emails, c.emails.len())
			phones = maxOf(phones, c.phones.len())
			addresses = maxOf(addresses, c.addresses.len())
			urls = maxOf(urls, c.urls.len())
			relations = maxOf(relations, c.related.len())
		}
		let header = ["First Name", "Middle Name", "Last Name", "Name Prefix", "Name Suffix", "Nickname", "File As", "Organization Name", "Organization Title", "Organization Department", "Birthday", "Notes", "Photo", "Labels"]
		for let k = 1; k <= emails; k++ {
			header = header + ["E-mail {k} - Label", "E-mail {k} - Value"]
		}
		for let k = 1; k <= phones; k++ {
			header = header + ["Phone {k} - Label", "Phone {k} - Value"]
		}
		for let k = 1; k <= addresses; k++ {
			header = header + ["Address {k} - Label", "Address {k} - Formatted", "Address {k} - Street", "Address {k} - City", "Address {k} - PO Box", "Address {k} - Region", "Address {k} - Postal Code", "Address {k} - Country", "Address {k} - Extended Address"]
		}
		for let k = 1; k <= urls; k++ {
			header = header + ["Website {k} - Label", "Website {k} - Value"]
		}
		for let k = 1; k <= relations; k++ {
			header = header + ["Relation {k} - Label", "Relation {k} - Value"]
		}
		header = header + ["Event 1 - Label", "Event 1 - Value"]
		let rows string[][]
		rows.push(header)
		for let c in contacts {
			let org = c.organizations.len() > 0 ?? (c.organizations[0], Organization{name: ""})
			let given = first(c.name.given)
			let family = first(c.name.family)
			given = fullNameOf(c) when given == "" && family == ""
			let bday = c.birthday
			let row = [given, first(c.name.middle), family, first(c.name.prefixes), first(c.name.suffixes), firstValue(c.nicknames), c.name.sortAs.join(" "), org.name, firstValue(c.titles), first(org.units), bday is none ?? ("", googleDate(bday)), c.notes.mapElem<string>(n => n.value).join("\n"), firstValue(c.photos), (["* myContacts"] + c.categories).join(" ::: ")]
			for let k = 0; k < emails; k++ {
				row = row + (k < c.emails.len() ?? ([googleLabel(c.emails[k].types, c.emails[k].pref), c.emails[k].value], ["", ""]))
			}
			for let k = 0; k < phones; k++ {
				row = row + (k < c.phones.len() ?? ([googleLabel(c.phones[k].types, c.phones[k].pref), c.phones[k].value], ["", ""]))
			}
			for let k = 0; k < addresses; k++ {
				if k < c.addresses.len() {
					let a = c.addresses[k]
					row = row + [googleLabel(a.types, a.pref), a.label, a.street, a.locality, a.poBox, a.region, a.postalCode, a.country, a.extended]
				} else {
					row = row + ["", "", "", "", "", "", "", "", ""]
				}
			}
			for let k = 0; k < urls; k++ {
				row = row + (k < c.urls.len() ?? ([googleLabel(c.urls[k].types, 0), c.urls[k].value], ["", ""]))
			}
			for let k = 0; k < relations; k++ {
				row = row + (k < c.related.len() ?? ([googleLabel(c.related[k].types, 0), c.related[k].value], ["", ""]))
			}
			let anniversary = c.anniversary
			row = row + (anniversary is none ?? (["", ""], ["Anniversary", googleDate(anniversary)]))
			rows.push(row)
		}
		return rows
	}

	// The first value with every type in `wanted` and none of `unwanted`.
	def pick(list ContactValue[], wanted string[], unwanted string[], skip int = 0) string {
		let seen = 0
		for let v in list {
			if wanted.filter(t => !v.types.includes(t)).len() == 0 && unwanted.filter(t => v.types.includes(t)).len() == 0 {
				return v.value when seen == skip
				seen++
			}
		}
		return ""
	}

	// The address of a type, or an empty one.
	def addressOf(c Contact, kind string) Address {
		for let a in c.addresses {
			return a when a.types.includes(kind)
		}
		if kind == "home" {
			for let a in c.addresses {
				return a when a.types.len() == 0
			}
		}
		return Address{}
	}

	// A street split into its first line and the rest.
	def streetLines(a Address) (string, string) {
		let lines = a.street.split("\n")
		return (lines[0], lines.len() > 1 ?? (lines[1:].join(" "), ""))
	}

	def outlookRows(contacts Contact[]) string[][] {
		let header = ["First Name", "Middle Name", "Last Name", "Title", "Suffix", "Nickname", "E-mail Address", "E-mail 2 Address", "E-mail 3 Address", "Home Phone", "Business Phone", "Mobile Phone", "Other Phone", "Pager", "Business Fax", "Home Fax", "Company", "Department", "Job Title", "Business Street", "Business Street 2", "Business City", "Business State", "Business Postal Code", "Business Country/Region", "Home Street", "Home Street 2", "Home City", "Home State", "Home Postal Code", "Home Country/Region", "Web Page", "Personal Web Page", "Birthday", "Anniversary", "Spouse", "Categories", "Notes"]
		let rows string[][]
		rows.push(header)
		for let c in contacts {
			let org = c.organizations.len() > 0 ?? (c.organizations[0], Organization{name: ""})
			let work = addressOf(c, "work")
			let home = addressOf(c, "home")
			let (workStreet, workStreet2) = streetLines(work)
			let (homeStreet, homeStreet2) = streetLines(home)
			let given = first(c.name.given)
			let family = first(c.name.family)
			given = fullNameOf(c) when given == "" && family == ""
			let bday = c.birthday
			let anniversary = c.anniversary
			let spouse = c.related.filter(r => r.types.includes("spouse"))
			rows.push([given, first(c.name.middle), family, first(c.name.prefixes), first(c.name.suffixes), firstValue(c.nicknames), c.emails.len() > 0 ?? (c.emails[0].value, ""), c.emails.len() > 1 ?? (c.emails[1].value, ""), c.emails.len() > 2 ?? (c.emails[2].value, ""), pick(c.phones, ["home"], ["fax"]), pick(c.phones, ["work"], ["fax"]), pick(c.phones, ["cell"], []), pick(c.phones, [], ["home", "work", "cell", "fax", "pager"]), pick(c.phones, ["pager"], []), pick(c.phones, ["work", "fax"], []), pick(c.phones, ["home", "fax"], []), org.name, first(org.units), firstValue(c.titles), workStreet, workStreet2, work.locality, work.region, work.postalCode, work.country, homeStreet, homeStreet2, home.locality, home.region, home.postalCode, home.country, pick(c.urls, [], ["home"]), pick(c.urls, ["home"], []), bday is none ?? ("", outlookDate(bday)), anniversary is none ?? ("", outlookDate(anniversary)), spouse.len() > 0 ?? (spouse[0].value, ""), c.categories.join(";"), c.notes.mapElem<string>(n => n.value).join("\n")])
		}
		return rows
	}

	def thunderbirdRows(contacts Contact[]) string[][] {
		let header = ["First Name", "Last Name", "Display Name", "Nickname", "Primary Email", "Secondary Email", "Screen Name", "Work Phone", "Home Phone", "Fax Number", "Pager Number", "Mobile Number", "Home Address", "Home Address 2", "Home City", "Home State", "Home ZipCode", "Home Country", "Work Address", "Work Address 2", "Work City", "Work State", "Work ZipCode", "Work Country", "Job Title", "Department", "Organization", "Web Page 1", "Web Page 2", "Birth Year", "Birth Month", "Birth Day", "Custom 1", "Custom 2", "Custom 3", "Custom 4", "Notes"]
		let rows string[][]
		rows.push(header)
		for let c in contacts {
			let org = c.organizations.len() > 0 ?? (c.organizations[0], Organization{name: ""})
			let work = addressOf(c, "work")
			let home = addressOf(c, "home")
			let (workStreet, workStreet2) = streetLines(work)
			let (homeStreet, homeStreet2) = streetLines(home)
			let bday = c.birthday
			let year = ""
			let month = ""
			let day = ""
			if !(bday is none) && bday.text == "" {
				year = bday.year > 0 ?? (bday.year.str(), "")
				month = bday.month > 0 ?? (bday.month.str(), "")
				day = bday.day > 0 ?? (bday.day.str(), "")
			}
			rows.push([first(c.name.given), first(c.name.family), fullNameOf(c), firstValue(c.nicknames), c.emails.len() > 0 ?? (c.emails[0].value, ""), c.emails.len() > 1 ?? (c.emails[1].value, ""), firstValue(c.impps), pick(c.phones, ["work"], ["fax"]), pick(c.phones, ["home"], ["fax"]), pick(c.phones, ["fax"], []), pick(c.phones, ["pager"], []), pick(c.phones, ["cell"], []), homeStreet, homeStreet2, home.locality, home.region, home.postalCode, home.country, workStreet, workStreet2, work.locality, work.region, work.postalCode, work.country, firstValue(c.titles), first(org.units), org.name, pick(c.urls, [], ["home"]), pick(c.urls, ["home"], []), year, month, day, "", "", "", "", c.notes.mapElem<string>(n => n.value).join("\n")])
		}
		return rows
	}
}
