partial module std.formats.contacts {
	use (
		std.testing
		std.bytes
	)

	check "Address book exports" {
		internal def text(content string) bytes.Reader {
			return new bytes.Reader(content.bytes())
		}

		internal def written(codec ContactFormat, contacts Contact[]) !string {
			let out = new bytes.Buffer()
			try codec.write(contacts, out)
			return string(out.bytes())
		}

		@test()
		def TestGoogleCSV() !none {
			let data = "First Name,Middle Name,Last Name,Nickname,Birthday,Notes,Labels,E-mail 1 - Label,E-mail 1 - Value,E-mail 2 - Label,E-mail 2 - Value,Phone 1 - Label,Phone 1 - Value,Address 1 - Label,Address 1 - Street,Address 1 - City,Address 1 - Postal Code,Address 1 - Country,Organization Name,Organization Title,Relation 1 - Label,Relation 1 - Value,Event 1 - Label,Event 1 - Value,Custom Field 1 - Label,Custom Field 1 - Value\r\nAda,,Lovelace,Countess,--12-10,\"Poet, \"\"mathematician\"\"\",* myContacts ::: Science,* Home,ada@example.com ::: ada@home.example,Work,ada@work.example,Mobile,+44 20 1234,Home,12 St James's Square,London,SW1Y 4JH,UK,Analytical Engines,Programmer,Spouse,William,Anniversary,1835-07-08,Shoe size,5\r\n"
			let all = try new ContactsCSV().read(text(data))
			assert all.len() == 1
			let c = all[0]
			assert c.name.given[0] == "Ada" && c.name.family[0] == "Lovelace" && c.nicknames[0].value == "Countess"
			let bday = c.birthday
			assert !(bday is none) && bday.year == 0 && bday.month == 12 && bday.day == 10
			assert c.notes[0].value == "Poet, \"mathematician\"" && c.categories.len() == 1 && c.categories[0] == "Science"
			assert c.emails.len() == 3 && c.emails[0].pref == 1 && c.emails[0].types[0] == "home" && c.emails[2].types[0] == "work"
			assert c.phones[0].types[0] == "cell" && c.addresses[0].locality == "London" && c.addresses[0].types[0] == "home"
			assert c.organizations[0].name == "Analytical Engines" && c.titles[0].value == "Programmer"
			assert c.related[0].value == "William" && c.related[0].types[0] == "spouse"
			let anniversary = c.anniversary
			assert !(anniversary is none) && anniversary.year == 1835
			assert c.extra.len() == 1 && c.extra[0].name == "X-SHOE-SIZE"
			let out = try written(new ContactsCSV(), all)
			let back = try new ContactsCSV().read(text(out))
			assert back.len() == 1 && back[0].emails.len() == 3 && back[0].addresses[0].postalCode == "SW1Y 4JH"
			assert back[0].categories.includes("Science") && back[0].notes[0].value == "Poet, \"mathematician\""
		}

		@test()
		def TestOutlookAndThunderbirdCSV() !none {
			let outlook = "First Name;Last Name;E-mail Address;Business Phone;Mobile Phone;Business Street;Business City;Company;Job Title;Birthday;Categories\r\nGrace;Hopper;grace@navy.example;+1 555 0100;+1 555 0199;1 Navy Way;Arlington;US Navy;Rear Admiral;12/9/1906;\"Navy;Computing\"\r\n"
			let g = (try new ContactsCSV().read(text(outlook)))[0]
			assert g.name.family[0] == "Hopper" && g.emails[0].value == "grace@navy.example"
			assert g.phones.len() == 2 && g.phones[0].types.includes("work") && g.phones[1].types[0] == "cell"
			assert g.addresses[0].types[0] == "work" && g.addresses[0].locality == "Arlington"
			let bday = g.birthday
			assert !(bday is none) && bday.year == 1906 && bday.month == 12 && bday.day == 9
			assert g.categories.len() == 2
			let codec = new ContactsCSV()
			codec.layout = CSVLayout.Outlook
			let written = try written(codec, [g])
			assert written.startsWith("First Name,Middle Name,Last Name,Title") && written.contains("12/9/1906")
			let tb = "First Name,Last Name,Display Name,Primary Email,Work Phone,Home City,Birth Year,Birth Month,Birth Day,Notes\r\nAlan,Turing,Alan Turing,alan@example.org,+44 1908,Wilmslow,1912,6,23,Codebreaker\r\n"
			let a = (try new ContactsCSV().read(text(tb)))[0]
			assert a.fullName == "Alan Turing" && a.emails[0].pref == 1 && a.addresses[0].types[0] == "home"
			let abday = a.birthday
			assert !(abday is none) && abday.year == 1912 && abday.day == 23
			codec.layout = CSVLayout.Thunderbird
			let again = try new ContactsCSV().read(text(try written(codec, [a])))
			assert again[0].fullName == "Alan Turing" && again[0].addresses[0].locality == "Wilmslow"
		}

		@test()
		def TestLDIF() !none {
			let data = "version: 1\n\n# a comment\ndn: cn=Ada Lovelace,mail=ada@example.com\nobjectclass: top\nobjectclass: inetOrgPerson\ngivenName: Ada\nsn: Lovelace\ncn: Ada Lovelace\nmail: ada@example.com\nmozillaSecondEmail: ada@home.example\ntelephoneNumber: +44 20\nmozillaHomeLocalityName: London\ndescription:: UG9ldCwKbWF0aGVtYXRpY2lhbg==\nbirthyear: 1815\nbirthmonth: 12\nbirthday: 10\nlabeledURI: http://example.com/ada Ada's page\nuid: ada\n\ndn: cn=Friends\nobjectclass: top\nobjectclass: groupOfNames\ncn: Friends\nmember: cn=Ada Lovelace,mail=ada@example.com\n\ndn: cn=gone\nchangetype: delete\n\n"
			let all = try new LDIF().read(text(data))
			assert all.len() == 2
			let a = all[0]
			assert a.fullName == "Ada Lovelace" && a.name.given[0] == "Ada" && a.emails.len() == 2 && a.emails[0].pref == 1
			assert a.notes[0].value == "Poet,\nmathematician" && a.addresses[0].locality == "London" && a.addresses[0].types[0] == "home"
			let bday = a.birthday
			assert !(bday is none) && bday.year == 1815 && bday.day == 10
			assert a.urls[0].value == "http://example.com/ada" && a.extra.len() == 1 && a.extra[0].name == "X-LDAP-UID"
			assert all[1].kind == ContactKind.Group && all[1].members[0].value == "mailto:ada@example.com"
			let out = try written(new LDIF(), all)
			assert out.contains("\ndescription:: UG9ldCwKbWF0aGVtYXRpY2lhbg==\n") && out.contains("\nuid: ada\n")
			let back = try new LDIF().read(text(out))
			assert back.len() == 2 && back[0].notes[0].value == "Poet,\nmathematician" && back[1].members[0].value == "mailto:ada@example.com"
		}

		@test()
		def TestXCard() !none {
			// RFC 6351 §8.
			let data = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<vcards xmlns=\"urn:ietf:params:xml:ns:vcard-4.0\"><vcard><fn><text>Simon Perreault</text></fn><n><surname>Perreault</surname><given>Simon</given><additional/><prefix/><suffix>ing. jr</suffix><suffix>M.Sc.</suffix></n><bday><date>--0203</date></bday><anniversary><date-time>20090808T1430-0500</date-time></anniversary><gender><sex>M</sex></gender><lang><parameters><pref><integer>1</integer></pref></parameters><language-tag>fr</language-tag></lang><org><parameters><type><text>work</text></type></parameters><text>Viagenie</text></org><adr><parameters><type><text>work</text></type><label><text>2875 boul. Laurier, suite D2-630</text></label></parameters><pobox/><ext/><street>2875 boul. Laurier, suite D2-630</street><locality>Quebec</locality><region>QC</region><code>G1V 2M2</code><country>Canada</country></adr><tel><parameters><type><text>work</text><text>voice</text></type><pref><integer>1</integer></pref></parameters><uri>tel:+1-418-656-9254;ext=102</uri></tel><email><parameters><type><text>work</text></type></parameters><text>simon.perreault@viagenie.ca</text></email><geo><uri>geo:46.766336,-71.28955</uri></geo><tz><text>America/Montreal</text></tz><group name=\"item1\"><x-ablabel><unknown>Office</unknown></x-ablabel></group></vcard></vcards>"
			let all = try new XCard().read(text(data))
			assert all.len() == 1
			let c = all[0]
			assert c.fullName == "Simon Perreault" && c.name.family[0] == "Perreault" && c.name.suffixes.len() == 2 && c.name.suffixes[1] == "M.Sc."
			let bday = c.birthday
			assert !(bday is none) && bday.month == 2 && bday.day == 3 && bday.year == 0
			assert c.gender.sex == "M" && c.languages[0].value == "fr" && c.languages[0].pref == 1
			assert c.organizations[0].name == "Viagenie" && c.addresses[0].postalCode == "G1V 2M2" && c.addresses[0].street == "2875 boul. Laurier, suite D2-630"
			assert c.addresses[0].label == "2875 boul. Laurier, suite D2-630"
			assert c.phones[0].value == "tel:+1-418-656-9254;ext=102" && c.phones[0].pref == 1 && c.phones[0].types.len() == 2
			assert c.emails[0].value == "simon.perreault@viagenie.ca" && c.timeZones[0].value == "America/Montreal"
			assert c.extra.len() == 1 && c.extra[0].group == "item1" && c.extra[0].value == "Office"
			let out = try written(new XCard(), all)
			assert out.contains("<n><surname>Perreault</surname><given>Simon</given><additional></additional><prefix></prefix><suffix>ing. jr</suffix><suffix>M.Sc.</suffix></n>") || out.contains("<suffix>M.Sc.</suffix>")
			assert out.contains("<uri>tel:+1-418-656-9254;ext=102</uri>") && out.contains("<group name=\"item1\">")
			let back = try new XCard().read(text(out))
			assert back.len() == 1 && back[0].fullName == "Simon Perreault" && back[0].addresses[0].locality == "Quebec"
			assert back[0].phones[0].value == "tel:+1-418-656-9254;ext=102" && back[0].extra[0].value == "Office"
			let again = back[0].birthday
			assert !(again is none) && again.month == 2 && again.day == 3
		}
	}
}
