partial module std.formats.contacts {
	use (
		std.io
		std.formats.contacts.loader::*
		std.formats.contacts.ldif::*
	)

	// LDIF is an address book as LDAP Data Interchange Format (RFC 2849),
	// as Thunderbird and LDAP directories export it: one entry per contact
	// (`inetOrgPerson` with Mozilla's attributes), a `groupOfNames` entry
	// per group. Reading takes content records and `changetype: add`
	// records; other change records are not contacts and are skipped. An
	// attribute the model has no field for comes back as `X-LDAP-<name>`.
	@codec("LDIF")
	type LDIF {
		extension string[] {
			def get() string[] {
				return string[".ldif", ".ldi"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["text/directory", "application/ldif"]
			}
		}

		// matchSignature implements SignatureMatcher: `version: 1` or a
		// `dn:` line first.
		def matchSignature(r io.Reader) bool {
			for let line in head(r, 512).split("\n") {
				let t = line.trim().lower()
				continue when t == "" || t.startsWith("#")
				return t.startsWith("version:") || t.startsWith("dn:")
			}
			return false
		}

		// read implements ContactFormat.
		// Fails when an entry cannot be read (an unclosed base64 value, a
		// record without `dn`), or the reader fails.
		def read(reader io.Reader) !Contact[] {
			let out Contact[] = []
			for let entry in try entriesOf(try readText(reader)) {
				out.push(contactOfEntry(entry))
			}
			return out
		}

		// write implements ContactFormat.
		// Fails when the writer fails.
		def write(contacts Contact[], writer io.Writer) !none {
			try put(writer, "version: 1\n\n")
			for let c in contacts {
				try put(writer, entryText(c))
			}
		}
	}
}

internal partial module std.formats.contacts.ldif {
	use (
		std.time
		std.data.encoding
		std.formats.contacts::*
	)

	// One LDIF entry: its DN and its attributes in order, names lower-cased.
	struct Entry {
		dn         string
		attributes (string, string)[] = []
	}

	// The content entries of an LDIF text.
	// Fails when a record has no `dn` or a value is not valid base64.
	def entriesOf(text string) !Entry[] {
		let lines string[] = []
		for let raw in text.trimPrefix("﻿").replace("\r\n", "\n").split("\n") {
			if raw.startsWith(" ") && lines.len() > 0 {
				lines[lines.len() - 1] = lines[lines.len() - 1] + raw[1:]
				continue
			}
			lines.push(raw)
		}
		let out Entry[] = []
		let current (string, string)[] = []
		for let i = 0; i <= lines.len(); i++ {
			let line = i < lines.len() ?? (lines[i], "")
			if line.trim() == "" {
				if current.len() > 0 {
					let entry = try entryOf(current)
					out.push(entry) unless entry is none
					current = []
				}
				continue
			}
			continue when line.startsWith("#")
			let colon = line.indexOf(":")
			continue when colon <= 0
			let name = line[:colon].trim().lower()
			let rest = line[colon + 1:]
			let value = ""
			if rest.startsWith(":") {
				let decoded = encoding.base64decode(rest[1:].trim()) onerror (err error) {
					fail "ldif: {name}: the base64 value does not decode"
				}
				value = string(decoded)
			} else if rest.startsWith("<") {
				value = rest[1:].trim()
			} else {
				value = rest.trimPrefix(" ")
			}
			continue when name == "version" && out.len() == 0 && current.len() == 0
			current.push((name, value))
		}
		return out
	}

	// An entry of attribute lines; none for a change record other than
	// `add`.
	// Fails when the record has no `dn`.
	def entryOf(attrs (string, string)[]) !?Entry {
		let (first, dn) = attrs[0]
		fail "ldif: a record does not start with dn" unless first == "dn"
		let entry = Entry{dn: dn}
		for let i = 1; i < attrs.len(); i++ {
			let (name, value) = attrs[i]
			if name == "changetype" {
				return none unless value.trim().lower() == "add"
				continue
			}
			// Attribute options (`cn;lang-fr`) are dropped from the name.
			let semi = name.indexOf(";")
			entry.attributes.push((semi > 0 ?? (name[:semi], name), value))
		}
		return entry
	}

	// The value of an attribute of an entry, "" when it has none.
	def attr(entry Entry, name string) string {
		for let (_, a) in entry.attributes {
			let (n, v) = a
			return v when n == name
		}
		return ""
	}

	// The address of a kind, made on first use.
	def addressFor(c Contact, kind string) Address {
		for let a in c.addresses {
			return a when a.types.includes(kind)
		}
		let a = Address{types: [kind]}
		c.addresses.push(a)
		return a
	}

	// Adds a street line.
	def addStreet(a Address, line string) {
		a.street = a.street == "" ?? (line, a.street + "\n" + line)
	}

	// The contact of an entry.
	def contactOfEntry(entry Entry) Contact {
		let c = Contact{}
		let birth = ContactDate{}
		let org = Organization{name: ""}
		let group = false
		let display = ""
		let common = ""
		for let (_, a) in entry.attributes {
			let (name, v) = a
			continue when v == ""
			switch {
				case name == "objectclass":
					group = true when v.lower() := "groupofnames" || "groupofuniquenames" || "mozillaablist"
				case name == "cn" || name == "commonname":
					common = v when common == ""
				case name == "displayname":
					display = v
				case name == "givenname":
					c.name.given = [v]
				case name := "sn" || "surname":
					c.name.family = [v]
				case name := "mozillanickname" || "xmozillanickname" || "nickname":
					c.nicknames.push(ContactValue{value: v})
				case name := "mail":
					c.emails.push(ContactValue{value: v, pref: c.emails.len() == 0 ?? (1, 0)})
				case name := "mozillasecondemail" || "xmozillasecondemail":
					c.emails.push(ContactValue{value: v})
				case name == "telephonenumber":
					c.phones.push(ContactValue{value: v, types: ["work", "voice"]})
				case name == "homephone":
					c.phones.push(ContactValue{value: v, types: ["home", "voice"]})
				case name := "mobile" || "cellphone":
					c.phones.push(ContactValue{value: v, types: ["cell"]})
				case name := "pager" || "pagerphone":
					c.phones.push(ContactValue{value: v, types: ["pager"]})
				case name := "facsimiletelephonenumber" || "fax":
					c.phones.push(ContactValue{value: v, types: ["fax"]})
				case name := "street" || "streetaddress" || "postaladdress" || "mozillaworkstreet2":
					addStreet(addressFor(c, "work"), v.replace("$", "\n"))
				case name := "l" || "locality":
					addressFor(c, "work").locality = v
				case name := "st" || "state":
					addressFor(c, "work").region = v
				case name := "postalcode" || "zip":
					addressFor(c, "work").postalCode = v
				case name := "c" || "countryname" || "co":
					addressFor(c, "work").country = v
				case name := "mozillahomestreet" || "mozillahomestreet2" || "homepostaladdress":
					addStreet(addressFor(c, "home"), v.replace("$", "\n"))
				case name == "mozillahomelocalityname":
					addressFor(c, "home").locality = v
				case name == "mozillahomestate":
					addressFor(c, "home").region = v
				case name == "mozillahomepostalcode":
					addressFor(c, "home").postalCode = v
				case name == "mozillahomecountryname":
					addressFor(c, "home").country = v
				case name == "title":
					c.titles.push(ContactValue{value: v})
				case name := "ou" || "department" || "organizationalunitname":
					org.units.push(v)
				case name := "o" || "company" || "organizationname":
					org.name = v
				case name := "workurl" || "mozillaworkurl":
					c.urls.push(ContactValue{value: v, types: ["work"]})
				case name := "homeurl" || "mozillahomeurl":
					c.urls.push(ContactValue{value: v, types: ["home"]})
				case name == "labeleduri":
					c.urls.push(ContactValue{value: v.split(" ")[0]})
				case name == "birthyear" && v.isNumeric():
					birth.year = v.toInt<int>()
				case name == "birthmonth" && v.isNumeric():
					birth.month = v.toInt<int>()
				case name == "birthday" && v.isNumeric():
					birth.day = v.toInt<int>()
				case name := "description" || "note":
					c.notes.push(ContactValue{value: v})
				case name == "jpegphoto":
					c.photos.push(ContactValue{value: "data:image/jpeg;base64," + encoding.base64encode(v.bytes())})
				case name := "member" || "uniquemember":
					c.members.push(ContactValue{value: memberURI(v)})
				case name == "modifytimestamp":
					c.revision = timestampOf(v)
				default:
					c.extra.push(ContactProperty{name: "X-LDAP-" + name.upper(), value: v.replace("\\", "\\\\").replace("\n", "\\n").replace(",", "\\,").replace(";", "\\;")})
			}
		}
		c.kind = group ?? (ContactKind.Group, ContactKind.Individual)
		c.fullName = display == "" ?? (common, display)
		c.birthday = birth when birth.month > 0 || birth.year > 0
		c.organizations.push(org) when org.name != "" || org.units.len() > 0
		return c
	}

	// A group member's DN as a URI: `mailto:` when it names a mail
	// address, else an `ldap:///` URI.
	def memberURI(dn string) string {
		for let part in dn.split(",") {
			let eq = part.indexOf("=")
			continue when eq < 0
			return "mailto:" + part[eq + 1:].trim() when part[:eq].trim().lower() == "mail"
		}
		return "ldap:///" + dn
	}

	// A `modifytimestamp` (`20240102030405Z`).
	def timestampOf(text string) ?time.Time {
		let v = text.trim()
		return none unless v.len() >= 14 && v[:14].isNumeric()
		let iso = "{v[:4]}-{v[4:6]}-{v[6:8]}T{v[8:10]}:{v[10:12]}:{v[12:14]}Z"
		return parseTime(iso) onerror recover none
	}

	def parseTime(text string) !?time.Time {
		return try time.parse(text)
	}

	// ---- writing ----

	// Whether a value must be written base64 (RFC 2849 SAFE-STRING).
	def unsafe(value string) bool {
		return false when value == ""
		let b = value.bytes()
		return true when b[0] == byte(' ') || b[0] == byte(':') || b[0] == byte('<') || b[b.len() - 1] == byte(' ')
		for let c in b {
			return true when c >= byte(128) || c == byte('\n') || c == byte('\r') || c == byte(0)
		}
		return false
	}

	// One attribute line, base64 when it needs to be, folded at 76.
	def line(name string, value string) string {
		let text = unsafe(value) ?? (name + ":: " + encoding.base64encode(value.bytes()), name + ": " + value)
		let b = text.bytes()
		return text + "\n" when b.len() <= 76
		let out = string(b[:76])
		let i = 76
		for i < b.len() {
			let end = i + 75 < b.len() ?? (i + 75, b.len())
			out += "\n " + string(b[i:end])
			i = end
		}
		return out + "\n"
	}

	// A DN value with RFC 4514 escapes.
	def dnValue(value string) string {
		let out = ""
		for let ch in value.bytes() {
			let s = string([ch])
			out += (s := "," || "+" || "\"" || "\\" || "<" || ">" || ";" || "=") ?? ("\\" + s, s)
		}
		return out.startsWith(" ") || out.startsWith("#") ?? ("\\" + out, out)
	}

	// The DN a member URI stands for.
	def memberDN(uri string) string {
		return "mail=" + dnValue(uri[7:]) when uri.startsWith("mailto:")
		return uri[8:] when uri.startsWith("ldap:///")
		return "cn=" + dnValue(uri)
	}

	// The display name of a contact.
	def nameOf(c Contact) string {
		return c.fullName when c.fullName != ""
		let joined = (c.name.given + c.name.family).filter(p => p != "").join(" ")
		return joined when joined != ""
		return c.emails.len() > 0 ?? (c.emails[0].value, "")
	}

	// The first value with every type in `wanted` and none of `unwanted`.
	def pick(list ContactValue[], wanted string[], unwanted string[]) string {
		for let v in list {
			return v.value when wanted.filter(t => !v.types.includes(t)).len() == 0 && unwanted.filter(t => v.types.includes(t)).len() == 0
		}
		return ""
	}

	def two(n int) string {
		return n < 10 ?? ("0" + n.str(), n.str())
	}

	// An attribute line, "" for an empty value.
	def field(attribute string, value string) string {
		return value == "" ?? ("", line(attribute, value))
	}

	// One contact as an entry, Thunderbird's way.
	def entryText(c Contact) string {
		let name = nameOf(c)
		let mail = c.emails.len() > 0 ?? (c.emails[0].value, "")
		let dn = "cn=" + dnValue(name) + (mail == "" ?? ("", ",mail=" + dnValue(mail)))
		let out = line("dn", dn)
		if c.kind == ContactKind.Group {
			out += "objectclass: top\nobjectclass: groupOfNames\n"
			out += line("cn", name)
			for let m in c.members {
				out += line("member", memberDN(m.value))
			}
			for let n in c.notes {
				out += line("description", n.value)
			}
			return out + "\n"
		}
		out += "objectclass: top\nobjectclass: person\nobjectclass: organizationalPerson\nobjectclass: inetOrgPerson\nobjectclass: mozillaAbPersonAlpha\n"
		out += field("givenName", c.name.given.join(" "))
		out += field("sn", c.name.family.join(" "))
		out += field("cn", name)
		out += field("mozillaNickname", c.nicknames.len() > 0 ?? (c.nicknames[0].value, ""))
		out += field("mail", mail)
		out += field("mozillaSecondEmail", c.emails.len() > 1 ?? (c.emails[1].value, ""))
		out += field("telephoneNumber", pick(c.phones, ["work"], ["fax"]))
		out += field("homePhone", pick(c.phones, ["home"], ["fax"]))
		out += field("facsimiletelephonenumber", pick(c.phones, ["fax"], []))
		out += field("pager", pick(c.phones, ["pager"], []))
		out += field("mobile", pick(c.phones, ["cell"], []))
		for let a in c.addresses {
			let lines = a.street.split("\n")
			let home = a.types.includes("home") || !a.types.includes("work")
			if home {
				out += field("mozillaHomeStreet", lines[0])
				out += field("mozillaHomeStreet2", lines.len() > 1 ?? (lines[1:].join(" "), ""))
				out += field("mozillaHomeLocalityName", a.locality)
				out += field("mozillaHomeState", a.region)
				out += field("mozillaHomePostalCode", a.postalCode)
				out += field("mozillaHomeCountryName", a.country)
			} else {
				out += field("street", lines[0])
				out += field("mozillaWorkStreet2", lines.len() > 1 ?? (lines[1:].join(" "), ""))
				out += field("l", a.locality)
				out += field("st", a.region)
				out += field("postalCode", a.postalCode)
				out += field("c", a.country)
			}
		}
		out += field("title", c.titles.len() > 0 ?? (c.titles[0].value, ""))
		if c.organizations.len() > 0 {
			out += field("department", c.organizations[0].units.join(", "))
			out += field("company", c.organizations[0].name)
		}
		out += field("mozillaWorkUrl", pick(c.urls, [], ["home"]))
		out += field("mozillaHomeUrl", pick(c.urls, ["home"], []))
		let bday = c.birthday
		if !(bday is none) && bday.text == "" {
			out += field("birthyear", bday.year > 0 ?? (bday.year.str(), ""))
			out += field("birthmonth", bday.month > 0 ?? (two(bday.month), ""))
			out += field("birthday", bday.day > 0 ?? (two(bday.day), ""))
		}
		out += field("description", c.notes.mapElem<string>(n => n.value).join("\n"))
		let rev = c.revision
		out += field("modifytimestamp", "{rev.year()}{two(rev.month())}{two(rev.day())}{two(rev.hour())}{two(rev.minute())}{two(rev.second())}Z") unless rev is none
		for let p in c.extra {
			out += field(p.name[7:].lower(), p.value.replace("\\n", "\n").replace("\\,", ",").replace("\\;", ";").replace("\\\\", "\\")) when p.name.startsWith("X-LDAP-")
		}
		return out + "\n"
	}
}
