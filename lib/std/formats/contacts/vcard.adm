partial module std.formats.contacts {
	use (
		std.io
		std.formats.contacts.loader::*
		std.formats.contacts.vcard::*
	)

	// VCard is the vCard format (`.vcf`, `text/vcard`): reads 4.0 (RFC 6350
	// with RFC 6474, 6715, 8605 and 9554 properties), 3.0 (RFC 2426) and
	// 2.1, quoted-printable and charsets included; writes 4.0, or 3.0 for
	// peers that know no other. What each version cannot say natively is
	// written the way Apple and Google readers expect (`X-ADDRESSBOOKSERVER-KIND`
	// for groups, `X-APPLE-OMIT-YEAR` for a birthday without a year).
	@codec("vCard")
	type VCard {
		// The version `write` writes: "4.0" or "3.0".
		version string = "4.0"

		extension string[] {
			def get() string[] {
				return string[".vcf", ".vcard"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["text/vcard", "text/x-vcard", "text/directory"]
			}
		}

		// matchSignature implements SignatureMatcher: `BEGIN:VCARD` first.
		def matchSignature(r io.Reader) bool {
			return head(r, 64).trim().upper().startsWith("BEGIN:VCARD")
		}

		// read implements ContactFormat.
		// Fails when the data holds no `BEGIN:VCARD`, or the reader fails.
		def read(reader io.Reader) !Contact[] {
			let out Contact[] = []
			for let card in try readCards(reader) {
				out.push(contactOf(card))
			}
			return out
		}

		// write implements ContactFormat. A contact without `fullName` gets
		// one made from its name, organisation or email, as every vCard
		// must have one.
		// Fails when `version` is neither "4.0" nor "3.0", or the writer
		// fails.
		def write(contacts Contact[], writer io.Writer) !none {
			fail "vcard: cannot write version \"{version}\"" unless version := "4.0" || "3.0"
			for let contact in contacts {
				try put(writer, cardText(contact, version == "3.0"))
			}
		}

		// readCards parses the data into the properties of each card, in
		// file order, as the file writes them: line folding and
		// quoted-printable undone, charsets decoded, 2.1 bare parameters
		// named (`TEL;WORK` becomes `TYPE=WORK`), values still escaped.
		// `BEGIN` and `END` are left out; `VERSION` is kept.
		// Fails when the data holds no `BEGIN:VCARD`, or the reader fails.
		def readCards(reader io.Reader) !ContactProperty[][] {
			return parseCards(try readText(reader))
		}

		// writeCards writes cards given as properties, as `readCards`
		// gives them: each between `BEGIN` and `END`, values as they are,
		// lines folded.
		// Fails when the writer fails.
		def writeCards(cards ContactProperty[][], writer io.Writer) !none {
			for let card in cards {
				try put(writer, rawCardText(card))
			}
		}
	}
}
