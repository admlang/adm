internal partial module std.formats.contacts.vcard {
	use (
		std.time
		std.data.encoding
		std.data.encoding.codepages
		std.formats.contacts::*
	)

	// The properties of each card of `text`, `VERSION` included.
	// Fails when the text holds no `BEGIN:VCARD`.
	def parseCards(text string) !ContactProperty[][] {
		let cards ContactProperty[][]
		let current ContactProperty[] = []
		let depth = 0
		let found = false
		for let line in logicalLines(text) {
			let parsed = parseLine(line)
			continue when parsed is none
			let p ContactProperty = parsed
			let word = p.value.trim().upper()
			if p.name == "BEGIN" && word == "VCARD" {
				depth++
				found = true
				current = [] when depth == 1
				continue
			}
			if p.name == "END" && word == "VCARD" {
				depth--
				cards.push(current) when depth == 0
				depth = 0 when depth < 0
				continue
			}
			// A 2.1 AGENT embeds a whole card; its lines are not the outer
			// card's.
			continue unless depth == 1
			current.push(p)
		}
		fail "vcard: no BEGIN:VCARD" unless found
		return cards
	}

	// The lines of `text` with folding undone: a line starting with a space
	// or tab continues the one before, as does the line after a 2.1
	// quoted-printable soft break or inside a 2.1 base64 value.
	def logicalLines(text string) string[] {
		let raw = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
		let out string[] = []
		let i = 0
		for i < raw.len() {
			let line = raw[i]
			i++
			for i < raw.len() {
				let next = raw[i]
				if next.startsWith(" ") || next.startsWith("\t") {
					line += next[1:]
					i++
					continue
				}
				if line.endsWith("=") && paramsPart(line).contains("QUOTED-PRINTABLE") {
					line = line[:line.len() - 1] + next
					i++
					continue
				}
				if next != "" && !next.contains(":") && paramsPart(line).contains("BASE64") {
					line += next.trim()
					i++
					continue
				}
				break
			}
			out.push(line)
		}
		return out
	}

	// The name and parameters of a line, upper-cased: what comes before
	// the first colon.
	def paramsPart(line string) string {
		let colon = line.indexOf(":")
		return colon < 0 ?? ("", line[:colon].upper())
	}

	// A content line split into group, name, parameters and value; none
	// for a line that is not one (blank, or no colon).
	def parseLine(line string) ?ContactProperty {
		let b = line.bytes()
		let n = b.len()
		let i = 0
		for i < n && b[i] != byte(';') && b[i] != byte(':') {
			i++
		}
		return none when i >= n
		let full = string(b[:i]).trim()
		return none when full == ""
		let group = ""
		let name = full
		let dot = lastDot(full)
		if dot >= 0 {
			group = full[:dot]
			name = full[dot + 1:]
		}
		let params ContactParam[] = []
		for i < n && b[i] == byte(';') {
			i++
			let start = i
			for i < n && b[i] != byte('=') && b[i] != byte(';') && b[i] != byte(':') {
				i++
			}
			let pname = string(b[start:i]).trim().upper()
			let values string[] = []
			if i < n && b[i] == byte('=') {
				i++
				for {
					if i < n && b[i] == byte('"') {
						i++
						let s = i
						for i < n && b[i] != byte('"') {
							i++
						}
						values.push(caretDecode(string(b[s:i])))
						i++ when i < n
					} else {
						let s = i
						for i < n && b[i] != byte(',') && b[i] != byte(';') && b[i] != byte(':') {
							i++
						}
						values.push(caretDecode(string(b[s:i]).trim()))
					}
					break unless i < n && b[i] == byte(',')
					i++
				}
				params.push(ContactParam{name: pname, values: values})
			} else if pname != "" {
				params.push(bareParam(pname))
			}
		}
		return none unless i < n && b[i] == byte(':')
		let value = string(b[i + 1:])
		let transfer = paramText(params, "ENCODING").upper()
		let charset = paramText(params, "CHARSET")
		if transfer == "QUOTED-PRINTABLE" {
			let decoded = encoding.quotedPrintableDecode(value) onerror recover value.bytes()
			value = inCharset(decoded, charset).replace("\r\n", "\n").replace("\n", "\\n")
			params = without(params, ["ENCODING", "CHARSET"])
		} else if charset != "" {
			value = inCharset(value.bytes(), charset)
			params = without(params, ["CHARSET"])
		}
		return ContactProperty{name: name.upper(), value: value, params: params, group: group}
	}

	// The index of the last `.` of a property name, -1 when it has none.
	def lastDot(text string) int {
		let at = -1
		let from = 0
		for {
			let next = text[from:].indexOf(".")
			break when next < 0
			at = from + next
			from = at + 1
		}
		return at
	}

	// A 2.1 parameter written without a name: an encoding, a value kind,
	// or a type.
	def bareParam(word string) ContactParam {
		return ContactParam{name: "ENCODING", values: [word]} when word := "QUOTED-PRINTABLE" || "BASE64" || "8BIT" || "7BIT"
		return ContactParam{name: "VALUE", values: [word]} when word := "INLINE" || "URL" || "CID" || "CONTENT-ID"
		return ContactParam{name: "TYPE", values: [word]}
	}

	// Undoes RFC 6868 parameter value encoding: `^n` a newline, `^'` a
	// double quote, `^^` a caret.
	def caretDecode(text string) string {
		return text unless text.contains("^")
		return text.replace("^^", "\u0001").replace("^n", "\n").replace("^N", "\n").replace("^'", "\"").replace("\u0001", "^")
	}

	// `data` as text in `charset`; UTF-8 for an unknown or empty charset.
	def inCharset(data byte[], charset string) string {
		let page = codepages.forCharset(charset)
		return string(data) when page is none
		return codepages.decode(data, page)
	}

	// The values of every parameter called `name`, comma-joined; "" when
	// there is none.
	def paramText(params ContactParam[], name string) string {
		return paramValues(params, name).join(",")
	}

	// The values of every parameter called `name`.
	def paramValues(params ContactParam[], name string) string[] {
		let out string[] = []
		for let p in params {
			continue unless p.name == name
			for let v in p.values {
				out.push(v)
			}
		}
		return out
	}

	// `params` without those called one of `names`.
	def without(params ContactParam[], names string[]) ContactParam[] {
		return params.filter(p => names.indexOf(p.name) < 0)
	}

	// The lower-case `TYPE` values, `pref` aside.
	def typesOf(params ContactParam[]) string[] {
		let out string[] = []
		for let v in paramValues(params, "TYPE") {
			for let part in v.split(",") {
				let t = part.trim().lower()
				out.push(t) unless t == "" || t == "pref" || out.indexOf(t) >= 0
			}
		}
		return out
	}

	// `PREF` as a number; 1 for a 3.0 `TYPE=pref`; 0 when neither.
	def prefOf(params ContactParam[]) int {
		let text = paramText(params, "PREF").trim()
		return text.toInt<int>() when text != "" && text.isNumeric()
		for let v in paramValues(params, "TYPE") {
			return 1 when v.lower().split(",").indexOf("pref") >= 0
		}
		return 0
	}

	// `value` split on the separator bytes no backslash escapes; the
	// pieces keep their escapes.
	def splitEscaped(value string, sep byte) string[] {
		let b = value.bytes()
		let out string[] = []
		let start = 0
		let i = 0
		for i < b.len() {
			if b[i] == byte('\\') {
				i += 2
				continue
			}
			if b[i] == sep {
				out.push(string(b[start:i]))
				start = i + 1
			}
			i++
		}
		out.push(string(b[start:(i > b.len() ?? (b.len(), i))]))
		return out
	}

	// Text with vCard escapes undone: `\n` a newline, `\,` `\;` `\:` and
	// `\\` the character.
	def unescape(text string) string {
		return text unless text.contains("\\")
		let b = text.bytes()
		let out byte[] = []
		let i = 0
		for i < b.len() {
			if b[i] == byte('\\') && i + 1 < b.len() {
				let c = b[i + 1]
				out.push((c == byte('n') || c == byte('N')) ?? (byte('\n'), c))
				i += 2
				continue
			}
			out.push(b[i])
			i++
		}
		return string(out)
	}

	// The components of a structured value (`N`, `ADR`, `ORG`), each a
	// list of unescaped texts.
	def componentsOf(value string) string[][] {
		let out string[][]
		for let part in splitEscaped(value, byte(';')) {
			out.push(listOf(part))
		}
		return out
	}

	// The unescaped items of a comma list; none for an empty value.
	def listOf(value string) string[] {
		let out string[] = []
		return out when value == ""
		for let item in splitEscaped(value, byte(',')) {
			out.push(unescape(item))
		}
		return out
	}

	// Component `i` of a structured value, its items comma-joined.
	def partOf(parts string[][], i int) string {
		return i < parts.len() ?? (parts[i].join(","), "")
	}

	// Component `i` of a structured value as a list.
	def partsOf(parts string[][], i int) string[] {
		return i < parts.len() ?? (parts[i].filter(s => s != ""), string[])
	}

	// A single-valued property as a ContactValue.
	def valueOf(p ContactProperty, text string) ContactValue {
		return ContactValue{value: text, types: typesOf(p.params), pref: prefOf(p.params), params: without(p.params, ["TYPE", "PREF"]), group: p.group}
	}

	// A URI value: escapes some writers add undone.
	def uriOf(value string) string {
		return value unless value.contains("\\")
		return value.replace("\\,", ",").replace("\\;", ";").replace("\\:", ":").replace("\\\\", "\\")
	}

	// A picture, sound or key: an inline 2.1/3.0 base64 value becomes a
	// `data:` URI, and a 3.0 format `TYPE` becomes `MEDIATYPE`.
	def mediaOf(p ContactProperty, kind string, version string) ContactValue {
		let transfer = paramText(p.params, "ENCODING").lower()
		if transfer := "b" || "base64" {
			let mediaType = mediaTypeOf(p.params, kind)
			let data = p.value.replace(" ", "").replace("\t", "")
			let v = ContactValue{value: "data:{mediaType};base64,{data}", pref: prefOf(p.params), group: p.group}
			v.params = without(p.params, ["TYPE", "PREF", "ENCODING", "VALUE", "MEDIATYPE"])
			return v
		}
		let v = valueOf(p, uriOf(p.value))
		if version != "4.0" {
			// Before 4.0 the type of a picture is its format.
			let format = paramText(p.params, "TYPE")
			v.types = []
			v.params = without(p.params, ["TYPE", "PREF", "VALUE"])
			v.params.push(ContactParam{name: "MEDIATYPE", values: [mediaTypeOf(p.params, kind)]}) when format != ""
		}
		return v
	}

	// The media type of a picture, sound or key: `MEDIATYPE`, else its
	// 3.0 format `TYPE` (`JPEG`, `PGP`).
	def mediaTypeOf(params ContactParam[], kind string) string {
		let given = paramText(params, "MEDIATYPE")
		return given when given != ""
		let format = paramText(params, "TYPE").lower().split(",")[0].trim()
		return format when format.contains("/")
		switch {
			case kind == "KEY":
				return "application/pgp-keys" when format := "pgp" || "gpg"
				return "application/pkix-cert" when format := "x509" || "x.509"
				return "application/octet-stream"
			case kind == "SOUND":
				return "audio/wav" when format := "wave" || "wav"
				return "audio/basic" when format := "pcm" || ""
				return "audio/" + format
		}
		return "image/jpeg" when format := "jpg" || "jpeg" || ""
		return "image/" + format
	}

	// A date property; its text when the value is not a date.
	def dateOf(p ContactProperty) ContactDate {
		let calendar = paramText(p.params, "CALSCALE").lower()
		calendar = "" when calendar == "gregorian"
		return ContactDate{text: unescape(p.value), calendar: calendar} when paramText(p.params, "VALUE").lower() == "text"
		let parsed = parseDate(p.value.trim())
		return ContactDate{text: unescape(p.value), calendar: calendar} when parsed is none
		let d ContactDate = parsed
		d.calendar = calendar
		let omit = paramText(p.params, "X-APPLE-OMIT-YEAR").trim()
		d.year = 0 when omit != "" && omit.isNumeric() && omit.toInt<int>() == d.year
		return d
	}

	// Whether `text` is all ASCII digits (and not empty).
	def digits(text string) bool {
		return text != "" && text.isNumeric() && !text.contains("-") && !text.contains("+") && !text.contains(".")
	}

	// Parses a vCard date, time or date-time: `19850412`, `1985-04-12`,
	// `1985-04`, `1985`, `--0412`, `--04`, `---12`, then `T` and a time
	// (`102200`, `10:22:00`, `1022`, `10`, `-2200`, `--00`) with an
	// optional `Z` or `+hh[:mm]` zone; a time alone starts with `T`.
	def parseDate(text string) ?ContactDate {
		return none when text == ""
		let d = ContactDate{}
		let t = text.indexOf("T")
		let datePart = t < 0 ?? (text, text[:t])
		let timePart = t < 0 ?? ("", text[t + 1:])
		if datePart != "" {
			if datePart.startsWith("---") {
				let day = datePart[3:]
				return none unless digits(day) && day.len() == 2
				d.day = day.toInt<int>()
			} else if datePart.startsWith("--") {
				let rest = datePart[2:].replace("-", "")
				return none unless digits(rest) && (rest.len() == 2 || rest.len() == 4)
				d.month = rest[:2].toInt<int>()
				d.day = rest[2:].toInt<int>() when rest.len() == 4
			} else {
				let flat = datePart.replace("-", "")
				return none unless digits(flat) && (flat.len() == 4 || flat.len() == 6 || flat.len() == 8)
				d.year = flat[:4].toInt<int>()
				d.month = flat[4:6].toInt<int>() when flat.len() >= 6
				d.day = flat[6:8].toInt<int>() when flat.len() == 8
			}
			return none when d.month > 12 || d.day > 31
		}
		return d when timePart == ""
		let missing = 0
		for missing < timePart.len() && missing < 2 && timePart[missing:missing + 1] == "-" {
			missing++
		}
		let clock = timePart[missing:]
		let zone = ""
		let z = clock.indexOf("Z")
		z = clock.indexOf("z") when z < 0
		let plus = clock.indexOf("+")
		let minus = clock.indexOf("-")
		let at = z >= 0 ?? (z, plus >= 0 ?? (plus, minus))
		if at >= 0 {
			zone = clock[at:]
			clock = clock[:at]
		}
		let dotAt = clock.indexOf(".")
		clock = clock[:dotAt] when dotAt >= 0
		clock = clock.replace(":", "")
		return none unless clock == "" || (digits(clock) && clock.len() % 2 == 0 && clock.len() + 2 * missing <= 6)
		let slot = missing
		let i = 0
		for i + 2 <= clock.len() {
			let v = clock[i:i + 2].toInt<int>()
			switch {
				case slot == 0:
					d.hour = v
				case slot == 1:
					d.minute = v
				default:
					d.second = v
			}
			slot++
			i += 2
		}
		if zone != "" {
			let offset = zoneOf(zone)
			return none when offset is none
			d.utcOffset = offset
		}
		return d
	}

	// A `Z`, `+hh`, `+hhmm` or `+hh:mm` zone as an offset from UTC.
	def zoneOf(zone string) ?duration {
		return 0s when zone.upper() == "Z"
		let sign = zone[:1]
		let rest = zone[1:].replace(":", "")
		return none unless (sign := "+" || "-") && digits(rest) && (rest.len() == 2 || rest.len() == 4)
		let minutes = rest[:2].toInt<int>() * 60 + (rest.len() == 4 ?? (rest[2:].toInt<int>(), 0))
		let offset = duration(int64(minutes) * 60000000000)
		return sign == "-" ?? (0s - offset, offset)
	}

	// Two digits, zero-padded.
	def two(n int) string {
		return n < 10 ?? ("0" + n.str(), n.str())
	}

	// A timestamp value (`REV`, `CREATED`); none when it names no day.
	def timestampOf(value string) ?time.Time {
		let parsed = parseDate(value.trim())
		return none when parsed is none
		let d ContactDate = parsed
		return none unless d.year > 0 && d.month > 0 && d.day > 0
		let zone = "Z"
		let offset = d.utcOffset
		if !(offset is none) && offset != 0s {
			let minutes = int(offset) / 60000000000
			let sign = minutes < 0 ?? ("-", "+")
			let abs = minutes < 0 ?? (0 - minutes, minutes)
			zone = sign + two(abs / 60) + ":" + two(abs % 60)
		}
		let hour = d.hour < 0 ?? (0, d.hour)
		let minute = d.minute < 0 ?? (0, d.minute)
		let second = d.second < 0 ?? (0, d.second)
		let text = "{d.year}-{two(d.month)}-{two(d.day)}T{two(hour)}:{two(minute)}:{two(second)}{zone}"
		return parseTime(text) onerror recover none
	}

	// `time.parse` for a value that may not parse.
	// Fails when `text` is not RFC 3339.
	def parseTime(text string) !?time.Time {
		return try time.parse(text)
	}

	// The contact kind a `KIND` value names; none for another.
	def kindOf(text string) ?ContactKind {
		let word = text.trim().lower()
		switch {
			case word == "individual":
				return ContactKind.Individual
			case word == "group":
				return ContactKind.Group
			case word == "org":
				return ContactKind.Org
			case word == "location":
				return ContactKind.Location
			case word == "application":
				return ContactKind.Application
			case word == "device":
				return ContactKind.Device
		}
		return none
	}

	// A 2.1/3.0 `GEO` (`lat;lon`) as a `geo:` URI; a 4.0 value as is.
	def geoOf(value string) string {
		let v = uriOf(value.trim())
		return v when v.lower().startsWith("geo:")
		return "geo:" + v.replace(";", ",")
	}

	// The model of one card.
	def contactOf(card ContactProperty[]) Contact {
		let c = Contact{}
		let version = "4.0"
		for let p in card {
			version = p.value.trim() when p.name == "VERSION"
		}
		let labels ContactProperty[] = []
		let seen = map<string, bool>{}
		for let p in card {
			let first = !seen.hasKey(p.name)
			seen[p.name] = true
			let text = unescape(p.value)
			switch {
				case p.name == "VERSION":
					continue
				case p.name == "FN" && first:
					c.fullName = text
				case p.name == "N" && first:
					let parts = componentsOf(p.value)
					c.name = PersonName{family: partsOf(parts, 0), given: partsOf(parts, 1), middle: partsOf(parts, 2), prefixes: partsOf(parts, 3), suffixes: partsOf(parts, 4), secondaryFamily: partsOf(parts, 5), generation: partsOf(parts, 6), group: p.group}
					c.name.sortAs = sortAsOf(p.params) when c.name.sortAs.len() == 0
					c.name.params = without(p.params, ["SORT-AS"])
				case p.name == "SORT-STRING" && c.name.sortAs.len() == 0:
					c.name.sortAs = [text]
				case p.name == "NICKNAME":
					for let nick in listOf(p.value) {
						c.nicknames.push(valueOf(p, nick))
					}
				case p.name == "PHOTO":
					c.photos.push(mediaOf(p, p.name, version))
				case p.name == "LOGO":
					c.logos.push(mediaOf(p, p.name, version))
				case p.name == "SOUND":
					c.sounds.push(mediaOf(p, p.name, version))
				case p.name == "KEY":
					let isText = paramText(p.params, "VALUE").lower() == "text"
					c.keys.push(isText ?? (valueOf(p, text), mediaOf(p, p.name, version)))
				case p.name == "BDAY" && first:
					c.birthday = dateOf(p)
				case p.name == "ANNIVERSARY" && first:
					c.anniversary = dateOf(p)
				case (p.name := "X-ANNIVERSARY" || "X-EVOLUTION-ANNIVERSARY" || "X-MS-ANNIVERSARY") && c.anniversary is none:
					c.anniversary = dateOf(p)
				case p.name == "DEATHDATE" && first:
					c.deathDate = dateOf(p)
				case p.name == "BIRTHPLACE" && first:
					c.birthplace = text
				case p.name == "DEATHPLACE" && first:
					c.deathPlace = text
				case p.name == "GENDER" && first:
					let parts = splitEscaped(p.value, byte(';'))
					c.gender = Gender{sex: unescape(parts[0]).trim().upper(), identity: parts.len() > 1 ?? (unescape(parts[1]), "")}
				case p.name == "ADR":
					c.addresses.push(addressOf(p))
				case p.name == "LABEL" && version != "4.0":
					labels.push(p)
				case p.name == "TEL":
					c.phones.push(valueOf(p, text.trim()))
				case p.name == "EMAIL":
					let v = valueOf(p, text.trim())
					v.types = v.types.filter(t => t != "internet")
					c.emails.push(v)
				case p.name == "IMPP":
					c.impps.push(valueOf(p, uriOf(p.value)))
				case p.name == "LANG":
					c.languages.push(valueOf(p, text))
				case p.name == "TZ":
					c.timeZones.push(valueOf(p, text))
				case p.name == "GEO":
					c.geos.push(valueOf(p, geoOf(p.value)))
				case p.name == "TITLE":
					c.titles.push(valueOf(p, text))
				case p.name == "ROLE":
					c.roles.push(valueOf(p, text))
				case p.name == "ORG":
					let parts = componentsOf(p.value)
					let units string[] = []
					for let i = 1; i < parts.len(); i++ {
						units.push(parts[i].join(","))
					}
					c.organizations.push(Organization{name: partOf(parts, 0), units: units, sortAs: sortAsOf(p.params), types: typesOf(p.params), pref: prefOf(p.params), params: without(p.params, ["TYPE", "PREF", "SORT-AS"]), group: p.group})
				case p.name == "MEMBER" || p.name == "X-ADDRESSBOOKSERVER-MEMBER":
					c.members.push(valueOf(p, uriOf(p.value)))
				case p.name == "RELATED":
					let isText = paramText(p.params, "VALUE").lower() == "text"
					c.related.push(valueOf(p, isText ?? (text, uriOf(p.value))))
				case p.name == "CATEGORIES":
					for let category in listOf(p.value) {
						let trimmed = category.trim()
						c.categories.push(trimmed) unless trimmed == ""
					}
				case p.name == "NOTE":
					c.notes.push(valueOf(p, text))
				case p.name == "PRODID" && first:
					c.productId = text
				case p.name == "REV" && first:
					c.revision = timestampOf(p.value)
				case p.name == "CREATED" && first:
					c.created = timestampOf(p.value)
				case p.name == "UID" && first:
					c.uid = uriOf(p.value).trim()
				case p.name := "KIND" || "X-ADDRESSBOOKSERVER-KIND":
					let kind = kindOf(text)
					if kind is none {
						c.extra.push(p)
					} else {
						c.kind = kind
					}
				case p.name == "URL":
					c.urls.push(valueOf(p, uriOf(p.value)))
				case p.name == "SOURCE":
					c.sources.push(valueOf(p, uriOf(p.value)))
				case p.name == "FBURL":
					c.freeBusyUrls.push(valueOf(p, uriOf(p.value)))
				case p.name == "CALADRURI":
					c.calendarAddresses.push(valueOf(p, uriOf(p.value)))
				case p.name == "CALURI":
					c.calendarUrls.push(valueOf(p, uriOf(p.value)))
				case p.name == "EXPERTISE":
					c.expertise.push(valueOf(p, text))
				case p.name == "HOBBY":
					c.hobbies.push(valueOf(p, text))
				case p.name == "INTEREST":
					c.interests.push(valueOf(p, text))
				case p.name == "ORG-DIRECTORY":
					c.orgDirectories.push(valueOf(p, uriOf(p.value)))
				case p.name == "CONTACT-URI":
					c.contactUrls.push(valueOf(p, uriOf(p.value)))
				case p.name == "GRAMGENDER" && first:
					c.grammaticalGender = text.trim().lower()
				case p.name == "LANGUAGE" && first:
					c.language = text.trim()
				case p.name == "PRONOUNS":
					c.pronouns.push(valueOf(p, text))
				case p.name == "SOCIALPROFILE":
					let isText = paramText(p.params, "VALUE").lower() == "text"
					c.socialProfiles.push(valueOf(p, isText ?? (text, uriOf(p.value))))
				default:
					c.extra.push(p)
			}
		}
		for let label in labels {
			attachLabel(c, label)
		}
		return c
	}

	// The `SORT-AS` values of a property; a quoted value lists them with
	// commas (`SORT-AS="Mann,James"`).
	def sortAsOf(params ContactParam[]) string[] {
		let out string[] = []
		for let v in paramValues(params, "SORT-AS") {
			for let part in v.split(",") {
				out.push(part.trim()) unless part.trim() == ""
			}
		}
		return out
	}

	// An `ADR` property as an Address.
	def addressOf(p ContactProperty) Address {
		let parts = componentsOf(p.value)
		let a = Address{poBox: partOf(parts, 0), extended: partOf(parts, 1), street: partOf(parts, 2), locality: partOf(parts, 3), region: partOf(parts, 4), postalCode: partOf(parts, 5), country: partOf(parts, 6)}
		a.room = partOf(parts, 7)
		a.apartment = partOf(parts, 8)
		a.floor = partOf(parts, 9)
		a.streetNumber = partOf(parts, 10)
		a.streetName = partOf(parts, 11)
		a.building = partOf(parts, 12)
		a.block = partOf(parts, 13)
		a.subdistrict = partOf(parts, 14)
		a.district = partOf(parts, 15)
		a.landmark = partOf(parts, 16)
		a.direction = partOf(parts, 17)
		a.label = paramText(p.params, "LABEL")
		a.geo = paramText(p.params, "GEO")
		a.timeZone = paramText(p.params, "TZ")
		a.countryCode = paramText(p.params, "CC")
		a.types = typesOf(p.params)
		a.pref = prefOf(p.params)
		a.params = without(p.params, ["TYPE", "PREF", "LABEL", "GEO", "TZ", "CC"])
		a.group = p.group
		return a
	}

	// Puts a 2.1/3.0 `LABEL` on the address of the same group or types
	// that has none, else the first without one; a label no address takes
	// stays in `extra`.
	def attachLabel(c Contact, label ContactProperty) {
		let text = unescape(label.value)
		let types = typesOf(label.params)
		for let a in c.addresses {
			if a.label == "" && label.group != "" && a.group == label.group {
				a.label = text
				return
			}
		}
		for let a in c.addresses {
			if a.label == "" && sameTypes(a.types, types) {
				a.label = text
				return
			}
		}
		for let a in c.addresses {
			if a.label == "" {
				a.label = text
				return
			}
		}
		c.extra.push(label)
	}

	// Whether two type lists hold the same types.
	def sameTypes(a string[], b string[]) bool {
		return false unless a.len() == b.len()
		for let t in a {
			return false unless b.indexOf(t) >= 0
		}
		return true
	}
}
