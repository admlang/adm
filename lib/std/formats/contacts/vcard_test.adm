partial module std.formats.contacts {
	use (
		std.testing
		std.bytes
		std.time
	)

	check "vCard" {
		internal def text(content string) bytes.Reader {
			return new bytes.Reader(content.bytes())
		}

		internal def written(contacts Contact[], version string = "4.0") !string {
			let codec = new VCard()
			codec.version = version
			let out = new bytes.Buffer()
			try codec.write(contacts, out)
			return string(out.bytes())
		}

		internal def one(data string) !Contact {
			let all = try new VCard().read(text(data))
			assert all.len() == 1
			return all[0]
		}

		internal def some(d ?ContactDate) ContactDate {
			return ContactDate{text: "<none>"} when d is none
			return d
		}

		@test()
		def TestVCard4Read() !none {
			// RFC 6350 §8, with folding and a group.
			let data = "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:Simon Perreault\r\nN:Perreault;Simon;;;ing. jr,M.Sc.\r\nBDAY:--0203\r\nANNIVERSARY:20090808T1430-0500\r\nGENDER:M\r\nLANG;PREF=1:fr\r\nLANG;PREF=2:en\r\nORG;TYPE=work:Viagenie\r\nADR;TYPE=work:;Suite D2-630;2875 Laurier;\r\n Quebec;QC;G1V 2M2;Canada\r\nTEL;VALUE=uri;TYPE=\"work,voice\";PREF=1:tel:+1-418-656-9254;ext=102\r\nTEL;VALUE=uri;TYPE=\"work,cell,voice,video,text\":tel:+1-418-262-6501\r\nEMAIL;TYPE=work:simon.perreault@viagenie.ca\r\nGEO;TYPE=work:geo:46.772673,-71.282945\r\nKEY;TYPE=work;VALUE=uri:http://www.viagenie.ca/simon.perreault/simon.asc\r\nTZ:-0500\r\nURL;TYPE=home:http://nomis80.org\r\nitem1.X-ABLabel:Office\r\nNOTE:Line one\\nline two\\, with comma\r\nEND:VCARD\r\n"
			let c = try one(data)
			assert c.fullName == "Simon Perreault" && c.kind == ContactKind.Individual
			assert c.name.family[0] == "Perreault" && c.name.given[0] == "Simon"
			assert c.name.suffixes.len() == 2 && c.name.suffixes[1] == "M.Sc."
			let bday = some(c.birthday)
			assert bday.year == 0 && bday.month == 2 && bday.day == 3 && bday.hour == -1
			let anniversary = some(c.anniversary)
			assert anniversary.year == 2009 && anniversary.hour == 14 && anniversary.minute == 30 && anniversary.second == -1
			let offset = anniversary.utcOffset
			assert !(offset is none)
			assert offset == 0s - 5h unless offset is none
			assert c.gender.sex == "M" && c.languages.len() == 2 && c.languages[1].pref == 2
			assert c.organizations[0].name == "Viagenie" && c.organizations[0].types[0] == "work"
			let a = c.addresses[0]
			assert a.extended == "Suite D2-630" && a.street == "2875 Laurier" && a.locality == "Quebec" && a.postalCode == "G1V 2M2" && a.country == "Canada"
			assert c.phones.len() == 2 && c.phones[0].value == "tel:+1-418-656-9254;ext=102" && c.phones[0].pref == 1
			assert c.phones[0].types.len() == 2 && c.phones[1].types.len() == 5
			assert c.emails[0].value == "simon.perreault@viagenie.ca"
			assert c.geos[0].value == "geo:46.772673,-71.282945" && c.keys[0].value.startsWith("http://")
			assert c.timeZones[0].value == "-0500" && c.urls[0].types[0] == "home"
			assert c.notes[0].value == "Line one\nline two, with comma"
			assert c.extra.len() == 1 && c.extra[0].group == "item1" && c.extra[0].name == "X-ABLABEL" && c.extra[0].value == "Office"
		}

		@test()
		def TestVCard3Read() !none {
			// As iOS and macOS Contacts export.
			let data = "BEGIN:VCARD\nVERSION:3.0\nPRODID:-//Apple Inc.//iOS 17.0//EN\nN:Appleseed;Johnny;;;\nFN:Johnny Appleseed\nORG:Apple Inc.;Engineering\nEMAIL;type=INTERNET;type=WORK;type=pref:johnny@example.com\nTEL;type=CELL;type=VOICE;type=pref:+1 (555) 555-1234\nitem1.ADR;type=HOME;type=pref:;;1 Infinite Loop;Cupertino;CA;95014;United States\nitem1.X-ABADR:us\nitem1.LABEL:1 Infinite Loop\\nCupertino CA 95014\nBDAY;X-APPLE-OMIT-YEAR=1604:1604-03-21\nX-ANNIVERSARY:2010-06-01\nPHOTO;ENCODING=b;TYPE=JPEG:/9j/4AAQ\n SkZJRg==\nGEO:37.33;-122.03\nREV:2023-10-12T10:10:10Z\nUID:a1b2\\,c3\nEND:VCARD\n"
			let c = try one(data)
			assert c.productId == "-//Apple Inc.//iOS 17.0//EN" && c.fullName == "Johnny Appleseed"
			assert c.organizations[0].name == "Apple Inc." && c.organizations[0].units[0] == "Engineering"
			assert c.emails[0].types.len() == 1 && c.emails[0].types[0] == "work" && c.emails[0].pref == 1
			assert c.phones[0].value == "+1 (555) 555-1234" && c.phones[0].pref == 1
			let a = c.addresses[0]
			assert a.group == "item1" && a.street == "1 Infinite Loop" && a.label == "1 Infinite Loop\nCupertino CA 95014"
			let bday = some(c.birthday)
			assert bday.year == 0 && bday.month == 3 && bday.day == 21
			let anniversary = some(c.anniversary)
			assert anniversary.year == 2010 && anniversary.month == 6
			assert c.photos[0].value == "data:image/jpeg;base64,/9j/4AAQSkZJRg==" && c.photos[0].types.len() == 0
			assert c.geos[0].value == "geo:37.33,-122.03"
			let found = c.revision
			fail "no revision" when found is none
			let rev time.Time = found
			assert rev.year() == 2023 && rev.hour() == 10 && rev.second() == 10
			assert c.uid == "a1b2,c3"
			assert c.extra.len() == 1 && c.extra[0].name == "X-ABADR"
		}

		@test()
		def TestVCard21Read() !none {
			// Quoted-printable, a charset, bare parameters, soft breaks.
			let data = "BEGIN:VCARD\r\nVERSION:2.1\r\nN;CHARSET=UTF-8;ENCODING=QUOTED-PRINTABLE:M=C3=BCller;J=C3=BCrgen\r\nFN;CHARSET=ISO-8859-1;ENCODING=QUOTED-PRINTABLE:J=FCrgen M=FCller\r\nTEL;WORK;VOICE;PREF:+49 30 1234\r\nNOTE;ENCODING=QUOTED-PRINTABLE:first line=0D=0Asecond =\r\nline\r\nEND:VCARD\r\n"
			let c = try one(data)
			assert c.name.family[0] == "Müller" && c.name.given[0] == "Jürgen"
			assert c.fullName == "Jürgen Müller"
			assert c.phones[0].types.len() == 2 && c.phones[0].types[0] == "work" && c.phones[0].pref == 1
			assert c.notes[0].value == "first line\nsecond line"
		}

		@test()
		def TestVCardManyAndGroup() !none {
			let data = "BEGIN:VCARD\nVERSION:4.0\nKIND:group\nFN:Friends\nMEMBER:urn:uuid:03a0e51f-d1aa-4385-8a53-e29025acd8af\nMEMBER:mailto:subscriber1@example.com\nEND:VCARD\nBEGIN:VCARD\nVERSION:4.0\nFN:Second\nEND:VCARD\n"
			let all = try new VCard().read(text(data))
			assert all.len() == 2 && all[0].kind == ContactKind.Group && all[0].members.len() == 2
			assert all[1].fullName == "Second"
			let cards = try new VCard().readCards(text(data))
			assert cards.len() == 2 && cards[0][0].name == "VERSION" && cards[0][1].name == "KIND"
			let failed = false
			new VCard().read(text("FN:no card\n")) onerror (err error) {
				failed = true
				recover Contact[]
			}
			assert failed
		}

		@test()
		def TestVCardWrite4() !none {
			let c = Contact{fullName: "Ada Lovelace", uid: "urn:uuid:1234"}
			c.name = PersonName{family: ["Lovelace"], given: ["Ada"], sortAs: ["Lovelace", "Ada"]}
			c.emails = [ContactValue{value:"ada@example.com", types:["home"], pref:1}]
			c.phones = [ContactValue{value:"tel:+44-20-1234", types:["cell"]}]
			c.birthday = ContactDate{year: 1815, month: 12, day: 10}
			c.notes = [ContactValue{value:"Poet, mathematician; first\nprogrammer"}]
			c.addresses = [Address{street:"1 Sq", locality:"London", country:"UK", label:"1 Sq\nLondon", types:["home"]}]
			c.categories = ["science", "a,b"]
			c.extra = [ContactProperty{name:"X-CUSTOM", value:"kept\\, as is", group:"g1"}]
			let out = try written([c])
			assert out.startsWith("BEGIN:VCARD\r\nVERSION:4.0\r\nFN:Ada Lovelace\r\nN;SORT-AS=\"Lovelace,Ada\":Lovelace;Ada;;;\r\n")
			assert out.contains("\r\nBDAY:18151210\r\n")
			assert out.contains("\r\nEMAIL;TYPE=home;PREF=1:ada@example.com\r\n")
			assert out.contains("\r\nTEL;TYPE=cell;VALUE=uri:tel:+44-20-1234\r\n")
			assert out.contains("\r\nNOTE:Poet\\, mathematician\\; first\\nprogrammer\r\n")
			assert out.contains("\r\nADR;TYPE=home;LABEL=1 Sq^nLondon:;;1 Sq;London;;;UK\r\n")
			assert out.contains("\r\nCATEGORIES:science,a\\,b\r\n")
			assert out.contains("\r\ng1.X-CUSTOM:kept\\, as is\r\n")
			assert out.endsWith("\r\nUID:urn:uuid:1234\r\ng1.X-CUSTOM:kept\\, as is\r\nEND:VCARD\r\n")
			let back = try one(out)
			assert back.fullName == "Ada Lovelace" && back.name.sortAs.len() == 2
			assert back.notes[0].value == "Poet, mathematician; first\nprogrammer"
			assert back.addresses[0].label == "1 Sq\nLondon"
			assert back.categories.len() == 2 && back.categories[1] == "a,b"
			assert back.phones[0].value == "tel:+44-20-1234" && back.emails[0].pref == 1
			let bday = some(back.birthday)
			assert bday.year == 1815 && bday.day == 10
		}

		@test()
		def TestVCardWrite3() !none {
			let c = Contact{kind: ContactKind.Group, fullName: "Team"}
			c.members = [ContactValue{value:"urn:uuid:a"}]
			c.birthday = ContactDate{month: 3, day: 21}
			c.anniversary = ContactDate{year: 2010, month: 6, day: 1}
			c.photos = [ContactValue{value:"data:image/png;base64,iVBORw0K"}]
			c.phones = [ContactValue{value:"tel:+1-555-0100", types:["work"], pref:1}]
			c.emails = [ContactValue{value:"team@example.com"}]
			c.geos = [ContactValue{value:"geo:1.5,2.5"}]
			c.addresses = [Address{street:"Main", label:"Main\nTown", types:["work"]}]
			c.revision = try time.parse("2024-02-03T04:05:06Z")
			let out = try written([c], "3.0")
			assert out.contains("\r\nVERSION:3.0\r\nX-ADDRESSBOOKSERVER-KIND:group\r\nFN:Team\r\nN:;;;;\r\n")
			assert out.contains("\r\nPHOTO;ENCODING=b;TYPE=PNG:iVBORw0K\r\n")
			assert out.contains("\r\nBDAY;X-APPLE-OMIT-YEAR=1604:1604-03-21\r\n")
			assert out.contains("\r\nX-ANNIVERSARY:2010-06-01\r\n")
			assert out.contains("\r\nTEL;TYPE=work,pref:+1-555-0100\r\n")
			assert out.contains("\r\nEMAIL;TYPE=internet:team@example.com\r\n")
			assert out.contains("\r\nGEO:1.5;2.5\r\n")
			assert out.contains("\r\nADR;TYPE=work:;;Main;;;;\r\nLABEL;TYPE=work:Main\\nTown\r\n")
			assert out.contains("\r\nX-ADDRESSBOOKSERVER-MEMBER:urn:uuid:a\r\n")
			assert out.contains("\r\nREV:2024-02-03T04:05:06Z\r\n")
			let back = try one(out)
			assert back.kind == ContactKind.Group && back.members[0].value == "urn:uuid:a"
			let bday = some(back.birthday)
			assert bday.year == 0 && bday.month == 3
			assert back.photos[0].value == "data:image/png;base64,iVBORw0K"
			assert back.addresses[0].label == "Main\nTown" && back.geos[0].value == "geo:1.5,2.5"
			assert back.phones[0].value == "+1-555-0100" && back.phones[0].pref == 1
		}

		@test()
		def TestVCardFolding() !none {
			let long = "é".repeat(60)
			let out = try written([Contact{fullName:long}])
			for let line in out.split("\r\n") {
				assert line.bytes().len() <= 75
			}
			let back = try one(out)
			assert back.fullName == long
		}

		@test()
		def TestVCardDates() !none {
			let cases = ["19850412", "1985-04", "1985", "--0412", "--04", "---12", "T102200Z", "T1022", "T-2200", "19961022T140000+0530"]
			for let input in cases {
				let c = try one("BEGIN:VCARD\nVERSION:4.0\nFN:x\nBDAY:{input}\nEND:VCARD\n")
				let d = some(c.birthday)
				assert d.text == ""
				let again = try one(try written([c]))
				let e = some(again.birthday)
				assert e.year == d.year && e.month == d.month && e.day == d.day && e.hour == d.hour && e.minute == d.minute && e.second == d.second
			}
			let c = try one("BEGIN:VCARD\nVERSION:4.0\nFN:x\nBDAY;VALUE=text:circa 1800\nDEATHDATE:not a date\nEND:VCARD\n")
			let bday = some(c.birthday)
			let death = some(c.deathDate)
			assert bday.text == "circa 1800" && death.text == "not a date"
			assert (try written([c])).contains("\r\nBDAY;VALUE=text:circa 1800\r\n")
		}

		@test()
		def TestVCardLoadByContent() !none {
			let all = try load(text("BEGIN:VCARD\nVERSION:3.0\nFN:Probe\nEND:VCARD\n"))
			assert all.len() == 1 && all[0].fullName == "Probe"
		}
	}
}
