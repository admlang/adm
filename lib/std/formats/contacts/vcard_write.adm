internal partial module std.formats.contacts.vcard {
	use (
		std.time
		std.formats.contacts::*
	)

	// The properties that hold a URI: their values are written unescaped.
	const uriProperties = ["PHOTO", "LOGO", "SOUND", "KEY", "URL", "SOURCE", "MEMBER", "X-ADDRESSBOOKSERVER-MEMBER", "IMPP", "FBURL", "CALADRURI", "CALURI", "GEO", "CONTACT-URI", "ORG-DIRECTORY", "SOCIALPROFILE", "UID", "RELATED"]

	// Collects the folded lines of one card.
	type CardWriter {
		v3  bool
		out string = ""

		def new(v3 bool) {
			self.v3 = v3
		}

		// Adds a content line; `value` is already in vCard form.
		def line(group string, name string, params ContactParam[], value string) {
			let head = group == "" ?? (name, group + "." + name)
			for let p in params {
				continue when p.values.len() == 0
				head += ";" + p.name + "=" + p.values.mapElem<string>(v => paramValue(v, v3)).join(",")
			}
			out += fold(head + ":" + value)
		}

		// Adds a single-valued property.
		def value(name string, v ContactValue, uri bool) {
			let params = paramsOf(v.types, v.pref, v.params, v3)
			line(v.group, name, params, uri ?? (v.value, escape(v.value)))
		}

		// Adds each of `values`.
		def values(name string, list ContactValue[], uri bool) {
			for let v in list {
				value(name, v, uri)
			}
		}

		// Adds a text property when `text` is not empty.
		def text(name string, text string) {
			line("", name, [], escape(text)) unless text == ""
		}

		// Adds a date property.
		def date(name string, d ContactDate) {
			let params ContactParam[] = []
			if d.text != "" {
				params.push(ContactParam{name: "VALUE", values: ["text"]})
				line("", name, params, escape(d.text))
				return
			}
			params.push(ContactParam{name: "CALSCALE", values: [d.calendar]}) when d.calendar != "" && !v3
			let year = d.year
			if v3 && year == 0 && d.month > 0 {
				// Apple's form of a date without a year.
				year = 1604
				params.push(ContactParam{name: "X-APPLE-OMIT-YEAR", values: ["1604"]})
			}
			line("", name, params, formatDate(ContactDate{year: year, month: d.month, day: d.day, hour: d.hour, minute: d.minute, second: d.second, utcOffset: d.utcOffset}, v3))
		}

		// Adds a timestamp property, in UTC.
		def timestamp(name string, t time.Time) {
			let stamp = v3 ?? ("{t.year()}-{two(t.month())}-{two(t.day())}T{two(t.hour())}:{two(t.minute())}:{two(t.second())}Z", "{t.year()}{two(t.month())}{two(t.day())}T{two(t.hour())}{two(t.minute())}{two(t.second())}Z")
			line("", name, [], stamp)
		}

		// Adds a picture, sound or key. Version 3.0 writes a `data:` URI
		// inline as base64.
		def media(name string, v ContactValue) {
			if !v3 {
				value(name, v, true)
				return
			}
			let params = paramsOf(v.types, v.pref, without(v.params, ["MEDIATYPE"]), v3)
			let comma = v.value.indexOf(",")
			if v.value.startsWith("data:") && comma > 0 && v.value[:comma].endsWith(";base64") {
				let mediaType = v.value[5:comma - 7]
				let slash = mediaType.indexOf("/")
				let format = slash < 0 ?? (mediaType, mediaType[slash + 1:])
				format = "PGP" when format == "pgp-keys"
				format = "X509" when format == "pkix-cert"
				params.push(ContactParam{name: "ENCODING", values: ["b"]})
				params.push(ContactParam{name: "TYPE", values: [format.upper()]}) unless format == ""
				line(v.group, name, params, v.value[comma + 1:])
				return
			}
			let mediaType = paramText(v.params, "MEDIATYPE")
			let slash = mediaType.indexOf("/")
			params.push(ContactParam{name: "VALUE", values: ["uri"]}) unless paramText(params, "VALUE") != ""
			params.push(ContactParam{name: "TYPE", values: [mediaType[slash + 1:].upper()]}) when slash > 0
			line(v.group, name, params, v.value)
		}
	}

	// The parameters of a value: `TYPE` (with `pref` in 3.0), `PREF` in
	// 4.0, then the others.
	def paramsOf(types string[], pref int, others ContactParam[], v3 bool) ContactParam[] {
		let out ContactParam[] = []
		let all = types.clone()
		all.push("pref") when v3 && pref == 1
		out.push(ContactParam{name: "TYPE", values: all}) when all.len() > 0
		out.push(ContactParam{name: "PREF", values: [pref.str()]}) when !v3 && pref > 0
		for let p in others {
			out.push(p)
		}
		return out
	}

	// A parameter value as written: quoted when it holds a separator,
	// 4.0 caret-encoded (RFC 6868).
	def paramValue(value string, v3 bool) string {
		let v = value
		if v3 {
			v = v.replace("\r\n", " ").replace("\n", " ").replace("\"", "'")
		} else {
			v = v.replace("^", "^^").replace("\r\n", "^n").replace("\n", "^n").replace("\"", "^'")
		}
		return "\"" + v + "\"" when v.contains(",") || v.contains(";") || v.contains(":")
		return v
	}

	// Text with vCard escapes: backslash, newline, comma and semicolon.
	def escape(text string) string {
		return text.replace("\\", "\\\\").replace("\r\n", "\\n").replace("\n", "\\n").replace(",", "\\,").replace(";", "\\;")
	}

	// A structured value: components joined by `;`, each escaped.
	def structured(parts string[]) string {
		return parts.mapElem<string>(p => escape(p)).join(";")
	}

	// A structured component that holds a list.
	def listPart(items string[]) string {
		return items.mapElem<string>(p => escape(p)).join(",")
	}

	// A content line folded at 75 octets, never inside a UTF-8 sequence,
	// ended with CRLF.
	def fold(line string) string {
		let b = line.bytes()
		return line + "\r\n" when b.len() <= 75
		let out byte[] = []
		let width = 0
		let limit = 75
		for let i = 0; i < b.len(); i++ {
			let continuation = (int(b[i]) & 0xC0) == 0x80
			if width >= limit && !continuation {
				out.push(byte('\r'))
				out.push(byte('\n'))
				out.push(byte(' '))
				width = 1
			}
			out.push(b[i])
			width++
		}
		out.push(byte('\r'))
		out.push(byte('\n'))
		return string(out)
	}

	// A date as vCard writes it: 4.0 basic form with truncation
	// (`19850412`, `--0412`, `1985-04`), 3.0 extended form (`1985-04-12`).
	def formatDate(d ContactDate, v3 bool) string {
		let out = ""
		let sep = v3 ?? ("-", "")
		if d.year > 0 {
			out = d.year.str()
			for out.len() < 4 {
				out = "0" + out
			}
			if d.month > 0 {
				out += (d.day > 0 ?? (sep, "-")) + two(d.month)
				out += sep + two(d.day) when d.day > 0
			}
		} else if d.month > 0 {
			out = "--" + two(d.month)
			out += sep + two(d.day) when d.day > 0
		} else if d.day > 0 {
			out = "---" + two(d.day)
		}
		if d.hour >= 0 || d.minute >= 0 || d.second >= 0 {
			let colon = v3 ?? (":", "")
			out += "T"
			if d.hour >= 0 {
				out += two(d.hour)
				out += colon + two(d.minute) when d.minute >= 0
				out += colon + two(d.second) when d.minute >= 0 && d.second >= 0
			} else if d.minute >= 0 {
				out += "-" + two(d.minute)
				out += two(d.second) when d.second >= 0
			} else {
				out += "--" + two(d.second)
			}
			let offset = d.utcOffset
			if !(offset is none) {
				if offset == 0s {
					out += "Z"
				} else {
					let minutes = int(offset) / 60000000000
					let sign = minutes < 0 ?? ("-", "+")
					let abs = minutes < 0 ?? (0 - minutes, minutes)
					out += sign + two(abs / 60) + colon + two(abs % 60)
				}
			}
		}
		return out
	}

	// The name a card shows when the contact has no `fullName`.
	def displayName(c Contact) string {
		let parts = c.name.prefixes + c.name.given + c.name.middle + c.name.family + c.name.suffixes
		let joined = parts.filter(p => p != "").join(" ")
		return joined when joined != ""
		return c.organizations[0].name when c.organizations.len() > 0 && c.organizations[0].name != ""
		return c.emails[0].value when c.emails.len() > 0
		return c.phones[0].value when c.phones.len() > 0
		return ""
	}

	// Whether a name has any part.
	def hasName(n PersonName) bool {
		return (n.family + n.given + n.middle + n.prefixes + n.suffixes + n.secondaryFamily + n.generation).len() > 0
	}

	// One card, 4.0 or (`v3`) 3.0.
	def cardText(c Contact, v3 bool) string {
		let w = new CardWriter(v3)
		w.line("", "BEGIN", [], "VCARD")
		w.line("", "VERSION", [], v3 ?? ("3.0", "4.0"))
		w.line("", v3 ?? ("X-ADDRESSBOOKSERVER-KIND", "KIND"), [], c.kind.value) when c.kind != ContactKind.Individual
		let full = c.fullName == "" ?? (displayName(c), c.fullName)
		w.line("", "FN", [], escape(full))
		if hasName(c.name) || v3 {
			let n = c.name
			let parts = [listPart(n.family), listPart(n.given), listPart(n.middle), listPart(n.prefixes), listPart(n.suffixes)]
			if !v3 && (n.secondaryFamily.len() > 0 || n.generation.len() > 0) {
				parts.push(listPart(n.secondaryFamily))
				parts.push(listPart(n.generation))
			}
			let params = n.params.clone()
			params.push(ContactParam{name: "SORT-AS", values: [n.sortAs.join(",")]}) when !v3 && n.sortAs.len() > 0
			w.line(n.group, "N", params, parts.join(";"))
			w.text("SORT-STRING", n.sortAs.join(" ")) when v3
		}
		w.values("NICKNAME", c.nicknames, false)
		for let photo in c.photos {
			w.media("PHOTO", photo)
		}
		w.date("BDAY", c.birthday) unless c.birthday is none
		w.text("BIRTHPLACE", c.birthplace)
		w.date("DEATHDATE", c.deathDate) unless c.deathDate is none
		w.text("DEATHPLACE", c.deathPlace)
		w.date(v3 ?? ("X-ANNIVERSARY", "ANNIVERSARY"), c.anniversary) unless c.anniversary is none
		w.line("", "GENDER", [], c.gender.identity == "" ?? (c.gender.sex, c.gender.sex + ";" + escape(c.gender.identity))) when c.gender.sex != "" || c.gender.identity != ""
		for let a in c.addresses {
			writeAddress(w, a, v3)
		}
		for let phone in c.phones {
			let v = phone
			let isUri = phone.value.lower().startsWith("tel:")
			if v3 {
				v = ContactValue{value: isUri ?? (phone.value[4:], phone.value), types: phone.types, pref: phone.pref, params: without(phone.params, ["VALUE"]), group: phone.group}
			} else if isUri && paramText(phone.params, "VALUE") == "" {
				v = ContactValue{value: phone.value, types: phone.types, pref: phone.pref, params: phone.params + [ContactParam{name:"VALUE", values:["uri"]}], group: phone.group}
			}
			w.value("TEL", v, isUri && !v3)
		}
		for let email in c.emails {
			let types = email.types.clone()
			types = ["internet"] + types when v3
			w.value("EMAIL", ContactValue{value: email.value, types: types, pref: email.pref, params: email.params, group: email.group}, false)
		}
		w.values("IMPP", c.impps, true)
		w.values("LANG", c.languages, false)
		w.values("TZ", c.timeZones, false)
		for let geo in c.geos {
			let v = geo
			if v3 && geo.value.lower().startsWith("geo:") {
				let coords = geo.value[4:].split(";")[0].split(",")
				v = ContactValue{value: coords.join(";"), types: geo.types, pref: geo.pref, params: geo.params, group: geo.group}
			}
			w.value("GEO", v, true)
		}
		w.values("TITLE", c.titles, false)
		w.values("ROLE", c.roles, false)
		for let logo in c.logos {
			w.media("LOGO", logo)
		}
		for let org in c.organizations {
			let params = paramsOf(org.types, org.pref, org.params, v3)
			params.push(ContactParam{name: "SORT-AS", values: [org.sortAs.join(",")]}) when !v3 && org.sortAs.len() > 0
			w.line(org.group, "ORG", params, structured([org.name] + org.units))
		}
		w.values(v3 ?? ("X-ADDRESSBOOKSERVER-MEMBER", "MEMBER"), c.members, true)
		for let r in c.related {
			w.value("RELATED", r, paramText(r.params, "VALUE").lower() != "text")
		}
		w.line("", "CATEGORIES", [], listPart(c.categories)) when c.categories.len() > 0
		w.values("NOTE", c.notes, false)
		w.text("PRODID", c.productId)
		w.timestamp("REV", c.revision) unless c.revision is none
		for let sound in c.sounds {
			w.media("SOUND", sound)
		}
		w.line("", "UID", [], c.uid) when c.uid != ""
		w.values("URL", c.urls, true)
		for let key in c.keys {
			if paramText(key.params, "VALUE").lower() == "text" {
				w.value("KEY", key, false)
			} else {
				w.media("KEY", key)
			}
		}
		w.values("SOURCE", c.sources, true)
		w.values("FBURL", c.freeBusyUrls, true)
		w.values("CALADRURI", c.calendarAddresses, true)
		w.values("CALURI", c.calendarUrls, true)
		w.values("EXPERTISE", c.expertise, false)
		w.values("HOBBY", c.hobbies, false)
		w.values("INTEREST", c.interests, false)
		w.values("ORG-DIRECTORY", c.orgDirectories, true)
		w.values("CONTACT-URI", c.contactUrls, true)
		w.timestamp("CREATED", c.created) unless c.created is none
		w.text("GRAMGENDER", c.grammaticalGender)
		w.text("LANGUAGE", c.language)
		w.values("PRONOUNS", c.pronouns, false)
		for let profile in c.socialProfiles {
			w.value("SOCIALPROFILE", profile, paramText(profile.params, "VALUE").lower() != "text")
		}
		for let p in c.extra {
			w.line(p.group, p.name, p.params, p.value)
		}
		w.line("", "END", [], "VCARD")
		return w.out
	}

	// Adds an address: 4.0 keeps the label, place and zone as parameters,
	// 3.0 writes the label as its own `LABEL`.
	def writeAddress(w CardWriter, a Address, v3 bool) {
		let parts = [a.poBox, a.extended, a.street, a.locality, a.region, a.postalCode, a.country]
		let finer = [a.room, a.apartment, a.floor, a.streetNumber, a.streetName, a.building, a.block, a.subdistrict, a.district, a.landmark, a.direction]
		parts = parts + finer when !v3 && finer.filter(p => p != "").len() > 0
		let params = paramsOf(a.types, a.pref, a.params, v3)
		if !v3 {
			params.push(ContactParam{name: "LABEL", values: [a.label]}) when a.label != ""
			params.push(ContactParam{name: "GEO", values: [a.geo]}) when a.geo != ""
			params.push(ContactParam{name: "TZ", values: [a.timeZone]}) when a.timeZone != ""
			params.push(ContactParam{name: "CC", values: [a.countryCode]}) when a.countryCode != ""
		}
		w.line(a.group, "ADR", params, structured(parts))
		w.line(a.group, "LABEL", paramsOf(a.types, a.pref, [], v3), escape(a.label)) when v3 && a.label != ""
	}

	// A card of raw properties.
	def rawCardText(card ContactProperty[]) string {
		let w = new CardWriter(false)
		w.line("", "BEGIN", [], "VCARD")
		for let p in card {
			w.line(p.group, p.name, p.params, p.value)
		}
		w.line("", "END", [], "VCARD")
		return w.out
	}
}
