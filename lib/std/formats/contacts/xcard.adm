partial module std.formats.contacts {
	use (
		std.io
		std.bytes
		std.formats.contacts.loader::*
		std.formats.contacts.xml::*
	)

	// XCard is vCard as XML (xCard, RFC 6351, `application/vcard+xml`):
	// each property an element holding its parameters and a typed value
	// element, grouped properties inside `group`. It carries what vCard
	// 4.0 carries, through the same model.
	@codec("xCard")
	type XCard {
		extension string[] {
			def get() string[] {
				return string[".xml", ".xcard"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["application/vcard+xml"]
			}
		}

		// matchSignature implements SignatureMatcher: a `vcards` root in the
		// xCard namespace.
		def matchSignature(r io.Reader) bool {
			let text = head(r, 1024)
			return text.contains("<vcards") && text.contains(xcardNamespace)
		}

		// read implements ContactFormat.
		// Fails when the data is not XML with a `vcards` root, or the reader
		// fails.
		def read(reader io.Reader) !Contact[] {
			let text = try readText(reader)
			let cards = try cardsOfXML(text)
			let out = new bytes.Buffer()
			try new VCard().writeCards(cards, out)
			return try new VCard().read(new bytes.Reader(out.bytes()))
		}

		// write implements ContactFormat.
		// Fails when the writer fails.
		def write(contacts Contact[], writer io.Writer) !none {
			let text = new bytes.Buffer()
			try new VCard().write(contacts, text)
			let cards = try new VCard().readCards(new bytes.Reader(text.bytes()))
			return try put(writer, xmlOfCards(cards))
		}
	}
}

internal partial module std.formats.contacts.xml {
	use (
		std.data.encoding::(XML, XMLNode, XMLNodeKind)
		std.formats.contacts::*
	)

	// The namespace of xCard.
	const xcardNamespace = "urn:ietf:params:xml:ns:vcard-4.0"

	// The components of each structured property, in order.
	def componentsOf(name string) string[] {
		switch {
			case name == "N":
				return ["surname", "given", "additional", "prefix", "suffix"]
			case name == "ADR":
				return ["pobox", "ext", "street", "locality", "region", "code", "country"]
			case name == "GENDER":
				return ["sex", "identity"]
			case name == "CLIENTPIDMAP":
				return ["sourceid", "uri"]
		}
		return []
	}

	// The value type a property has when `VALUE` does not say.
	def defaultType(name string) string {
		switch {
			case name := "SOURCE" || "PHOTO" || "IMPP" || "GEO" || "LOGO" || "MEMBER" || "RELATED" || "SOUND" || "UID" || "URL" || "KEY" || "FBURL" || "CALADRURI" || "CALURI" || "ORG-DIRECTORY" || "CONTACT-URI" || "SOCIALPROFILE":
				return "uri"
			case name := "BDAY" || "ANNIVERSARY" || "DEATHDATE":
				return "date-and-or-time"
			case name := "REV" || "CREATED":
				return "timestamp"
			case name := "LANG" || "LANGUAGE":
				return "language-tag"
			case name.startsWith("X-"):
				return "unknown"
		}
		return "text"
	}

	// The value type of a parameter.
	def paramType(name string) string {
		switch {
			case name == "PREF" || name == "INDEX":
				return "integer"
			case name == "GEO":
				return "uri"
			case name == "LANGUAGE":
				return "language-tag"
		}
		return "text"
	}

	// Text with vCard escapes.
	def escape(text string) string {
		return text.replace("\\", "\\\\").replace("\n", "\\n").replace(",", "\\,").replace(";", "\\;")
	}

	// Text with vCard escapes undone.
	def unescape(text string) string {
		return text unless text.contains("\\")
		return text.replace("\\\\", "\u0001").replace("\\n", "\n").replace("\\N", "\n").replace("\\,", ",").replace("\\;", ";").replace("\\:", ":").replace("\u0001", "\\")
	}

	// `value` split on the separator no backslash escapes.
	def splitEscaped(value string, sep string) string[] {
		let out string[] = []
		let current = ""
		let escaped = false
		for let c in value.bytes() {
			let s = string([c])
			if escaped {
				current += s
				escaped = false
				continue
			}
			if s == "\\" {
				current += s
				escaped = true
				continue
			}
			if s == sep {
				out.push(current)
				current = ""
				continue
			}
			current += s
		}
		out.push(current)
		return out
	}

	// ---- reading ----

	// The element children of a node.
	def elementsOf(node XMLNode) XMLNode[] {
		return node.children.filter(c => c.kind == XMLNodeKind.Element)
	}

	// The cards of an xCard document as vCard properties.
	// Fails when the text is not XML with a `vcards` root.
	def cardsOfXML(text string) !ContactProperty[][] {
		let root = try new XML().parse(text)
		fail "xcard: the root is not vcards" unless root.localName == "vcards"
		let cards ContactProperty[][]
		for let card in elementsOf(root) {
			continue unless card.localName == "vcard"
			let props = [ContactProperty{name:"VERSION", value:"4.0"}]
			for let el in elementsOf(card) {
				if el.localName == "version" {
					continue
				}
				if el.localName == "group" {
					let group = el.attribute("name")
					for let inner in elementsOf(el) {
						props.push(propertyOf(inner, group is none ?? ("", group)))
					}
				} else {
					props.push(propertyOf(el, ""))
				}
			}
			cards.push(props)
		}
		return cards
	}

	// One property element as a vCard property.
	def propertyOf(el XMLNode, group string) ContactProperty {
		let name = el.localName.upper()
		let p = ContactProperty{name: name, value: "", group: group}
		let values XMLNode[] = []
		for let child in elementsOf(el) {
			if child.localName == "parameters" {
				for let param in elementsOf(child) {
					let texts = elementsOf(param).mapElem<string>(v => v.text())
					p.params.push(ContactParam{name: param.localName.upper(), values: texts})
				}
				continue
			}
			values.push(child)
		}
		let components = componentsOf(name)
		if components.len() > 0 {
			let parts string[] = []
			for let c in components {
				let items = values.filter(v => v.localName == c)
				let texts = items.mapElem<string>(v => escape(v.text()))
				parts.push(texts.join(","))
			}
			p.value = parts.join(";")
			return p
		}
		if name == "ORG" {
			p.value = values.mapElem<string>(v => escape(v.text())).join(";")
			return p
		}
		if name := "CATEGORIES" || "NICKNAME" {
			p.value = values.mapElem<string>(v => escape(v.text())).join(",")
			return p
		}
		return p when values.len() == 0
		let kind = values[0].localName
		let text = values[0].text()
		p.value = (kind := "text" || "unknown") ?? (escape(text), text)
		let expected = defaultType(name)
		if kind == "text" && expected != "text" && expected != "unknown" {
			p.params.push(ContactParam{name: "VALUE", values: ["text"]})
		} else if kind == "uri" && expected == "text" {
			p.params.push(ContactParam{name: "VALUE", values: ["uri"]})
		}
		return p
	}

	// ---- writing ----

	// An element in the xCard namespace.
	def node(name string) XMLNode {
		return new XMLNode(name, xcardNamespace)
	}

	// An element holding text.
	def textNode(name string, text string) XMLNode {
		let n = node(name)
		n.add(text)
		return n
	}

	// The value element type of a date value.
	def dateType(value string) string {
		return "time" when value.startsWith("T")
		return "date-time" when value.contains("T")
		return "date"
	}

	// The value type a property is written with.
	def valueType(p ContactProperty) string {
		for let q in p.params {
			if q.name == "VALUE" && q.values.len() > 0 {
				let v = q.values[0].lower()
				return v == "date-and-or-time" ?? (dateType(p.value), v)
			}
		}
		let t = defaultType(p.name)
		return t == "date-and-or-time" ?? (dateType(p.value), t)
	}

	// One vCard property as an element.
	def propertyElement(p ContactProperty) XMLNode {
		let el = node(p.name.lower())
		let params = p.params.filter(q => q.name != "VALUE" && q.values.len() > 0)
		if params.len() > 0 {
			let holder = el.add(node("parameters"))
			for let q in params {
				let pn = holder.add(node(q.name.lower()))
				let t = paramType(q.name)
				for let v in q.values {
					pn.add(textNode(t, v))
				}
			}
		}
		let components = componentsOf(p.name)
		if components.len() > 0 {
			let parts = splitEscaped(p.value, ";")
			for let i = 0; i < components.len(); i++ {
				let part = i < parts.len() ?? (parts[i], "")
				let items = part == "" ?? ([""], splitEscaped(part, ","))
				for let item in items {
					el.add(textNode(components[i], unescape(item)))
				}
			}
			return el
		}
		if p.name == "ORG" {
			for let part in splitEscaped(p.value, ";") {
				el.add(textNode("text", unescape(part)))
			}
			return el
		}
		if p.name := "CATEGORIES" || "NICKNAME" {
			for let item in splitEscaped(p.value, ",") {
				el.add(textNode("text", unescape(item)))
			}
			return el
		}
		let t = valueType(p)
		el.add(textNode(t, (t := "text" || "unknown") ?? (unescape(p.value), p.value)))
		return el
	}

	// Cards as an xCard document.
	def xmlOfCards(cards ContactProperty[][]) string {
		let root = node("vcards")
		root.set("xmlns", xcardNamespace)
		for let card in cards {
			let vcard = root.add(node("vcard"))
			let groups = map<string, XMLNode>{}
			for let p in card {
				continue when p.name == "VERSION"
				if p.group == "" {
					vcard.add(propertyElement(p))
					continue
				}
				if !groups.hasKey(p.group) {
					let g = vcard.add(node("group"))
					g.set("name", p.group)
					groups[p.group] = g
				}
				groups[p.group].add(propertyElement(p))
			}
		}
		return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" + root.str() + "\n"
	}
}
