// Zip containers of named parts: the storage of the office formats (DOCX,
// XLSX, ODT, ODS) and of EPUB.
internal std.formats partial module std.formats.container {
	use (
		std.bytes
		std.data.encoding::(XML, XMLNode)
		std.formats.archive::(Archive, CompressionLevel, Entry, WriteOptions, Zip)
		std.formats.archive
		std.io
	)

	// Package is a zip container of parts, the storage of DOCX, ODT and EPUB.
	// Part names are compared without regard to case.
	type Package {
		arc     Archive
		entries map<string, Entry>

		def new(arc Archive) {
			self.arc = arc
			entries = new map<string, Entry>()
			for let (_, entry) in arc.entries() {
				entries.set(entry.name.lower(), entry)
			}
		}

		// has reports whether the package holds the part.
		def has(name string) bool {
			return entries.hasKey(normalize(name).lower())
		}

		// names returns the names of the parts, in the order the package lists
		// them.
		def names() string[] {
			let out = string[]
			for let (_, entry) in arc.entries() {
				out.push(entry.name)
			}
			return out
		}

		// read returns the bytes of the part, none when there is no such part.
		// Fails when the part cannot be decompressed.
		def read(name string) !?byte[] {
			let entry = entries.get(normalize(name).lower())
			return none when entry is none
			let r = try arc.open(entry)
			let out = new bytes.Buffer()
			try out.readFrom(r)
			return out.bytes()
		}

		// xml returns the root element of the part, none when there is no such
		// part. Fails when the part is not well-formed XML.
		def xml(name string) !?XMLNode {
			let data = try read(name)
			return none when data is none
			return try new XML().parse(data)
		}
	}

	// openPackage reads the zip container in the bytes. Fails when they are
	// not a zip archive.
	def openPackage(data byte[]) !Package {
		let arc = try new Zip().open(new bytes.Reader(data))
		return new Package(arc)
	}

	// normalize returns a part name without a leading slash, `.` and `..`
	// resolved and percent escapes decoded.
	def normalize(name string) string {
		let path = name.replace("\\", "/")
		path = unescape(path) when path.indexOf("%") >= 0
		path = path.trimPrefix("/")
		let parts = string[]
		for let (_, part) in path.split("/") {
			if part == ".." {
				parts.pop() when parts.len() > 0
			} else if part != "." && part != "" {
				parts.push(part)
			}
		}
		return parts.join("/")
	}

	// resolve returns the part a reference made from the part `source` names.
	// An absolute reference starts from the root of the package.
	def resolve(source string, target string) string {
		return normalize(target) when target.startsWith("/")
		return normalize(folderOf(source) + target)
	}

	// folderOf returns the folder of a part name with its closing slash,
	// empty for a part at the root.
	def folderOf(name string) string {
		let slash = -1
		for let (i, c) in name {
			slash = i when c == '/'
		}
		return slash < 0 ?? ("", name[:slash + 1])
	}

	// baseName returns the last segment of a part name.
	def baseName(name string) string {
		return name[folderOf(name).len():]
	}

	// unescape decodes the percent escapes of a URI path.
	def unescape(path string) string {
		let raw = path.bytes()
		let out byte[] = []
		let i = 0
		for i < raw.len() {
			if int(raw[i]) == 0x25 && i + 2 < raw.len() {
				let high = hexDigit(int(raw[i + 1]))
				let low = hexDigit(int(raw[i + 2]))
				if high >= 0 && low >= 0 {
					out.push(byte(high * 16 + low))
					i += 3
					continue
				}
			}
			out.push(raw[i])
			i++
		}
		return string(out)
	}

	def hexDigit(c int) int {
		return c - 0x30 when c >= 0x30 && c <= 0x39
		return c - 0x61 + 10 when c >= 0x61 && c <= 0x66
		return c - 0x41 + 10 when c >= 0x41 && c <= 0x46
		return -1
	}

	// PackageWriter builds a zip container part by part.
	type PackageWriter {
		out    bytes.Buffer
		writer ?archive.ArchiveWriter

		def new() {
			out = new bytes.Buffer()
		}

		// add writes a part, stored as it is when `stored` is set, deflated
		// otherwise. Fails when the archive cannot be written.
		def add(name string, data byte[], stored bool = false) !none {
			let zip = writer
			if zip is none {
				let made = try new Zip().create(out, WriteOptions{level: CompressionLevel.Default})
				writer = made
				try made.add(Entry{name: name, method: stored ?? ("store", ""), attributes: new map<string, string>()}, new bytes.Reader(data))
				return none
			}
			try zip.add(Entry{name: name, method: stored ?? ("store", ""), attributes: new map<string, string>()}, new bytes.Reader(data))
		}

		// add writes a part of text, deflated. Fails when the archive cannot be
		// written.
		def add(name string, content string) !none {
			try add(name, content.bytes())
		}

		// bytes writes the central directory and returns the archive's bytes.
		// Fails when the archive cannot be written.
		def bytes() !byte[] {
			let zip = writer
			try zip.close() unless zip is none
			return out.bytes()
		}
	}

	// zipStartsWith reports whether the reader is a zip archive and a local
	// header in its first 64 KiB names an entry starting with the prefix.
	def zipStartsWith(r io.Reader, prefix string) bool {
		let b byte[]
		b.len(64 * 1024)
		let n = 0
		for n < b.len() {
			let got = r.read(b[n:]) onerror recover 0
			break when got <= 0
			n += got
		}
		return false unless n >= 30 && int(b[0]) == 0x50 && int(b[1]) == 0x4B && int(b[2]) == 3 && int(b[3]) == 4
		let wanted = prefix.bytes()
		let at = 0
		for at + 30 + wanted.len() <= n {
			let next = b[at:n].indexOf(byte(0x50))
			break when next < 0
			at += next
			if at + 30 + wanted.len() <= n && int(b[at + 1]) == 0x4B && int(b[at + 2]) == 3 && int(b[at + 3]) == 4 {
				let hit = true
				for let i = 0; i < wanted.len(); i++ {
					hit = hit && b[at + 30 + i] == wanted[i]
				}
				return true when hit
			}
			at++
		}
		return false
	}
}
