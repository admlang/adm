partial module std.formats.data {
	use (
		std.os
		std.reflection
		std.reflection::(Field, FieldKind)
		std.services.runtime::(Runtime)
	)

	// DotEnv reads and writes `.env` files: `NAME=value` lines that set
	// environment variables, `#` comments, an optional `export` before a
	// name.
	//
	// ```
	// let vars = try new DotEnv().decode("PORT=8080\nURL=\"http://localhost:${PORT}\"\n")
	// println(vars["URL"]) // http://localhost:8080
	// try new DotEnv().load() // the variables of ./.env, into the process
	// ```
	//
	// A value is plain (space around it dropped, ` #` starts a comment), in
	// single quotes (taken as it is) or in double quotes or backticks (the
	// escapes `\n`, `\r`, `\t`, `\\`, `\"` and `\$` read); a quoted value
	// may run over lines. In plain and double-quoted values `$NAME`,
	// `${NAME}`, `${NAME:-fallback}` (unset or empty) and `${NAME-fallback}`
	// (unset) are replaced by a variable set earlier in the file, else by
	// the process's environment, else by nothing.
	type DotEnv {
		// Replace `$NAME` and `${NAME}` in values; unset, they stay as text.
		expand bool = true

		def new() {}

		// decode reads the variables in file order; a name set twice keeps
		// its last value.
		// Fails with the line number when a line has no `=`, a name has a
		// character outside letters, digits, `_`, `.` and `-` or starts with
		// a digit, a quote is not closed, or text follows a closing quote.
		def decode(input string) !map<string, string> {
			let vars = map<string, string>{}
			let b = input.trimPrefix("\uFEFF").bytes()
			let n = b.len()
			let i = 0
			let line = 1
			for i < n {
				// Leading space, empty lines.
				if b[i] == byte(' ') || b[i] == byte('\t') || b[i] == byte('\r') {
					i++
					continue
				}
				if b[i] == byte('\n') {
					i++
					line++
					continue
				}
				if b[i] == byte('#') {
					for i < n && b[i] != byte('\n') {
						i++
					}
					continue
				}
				let start = i
				for i < n && b[i] != byte('=') && b[i] != byte('\n') {
					i++
				}
				fail "dotenv: line {line}: expected `NAME=value`" when i >= n || b[i] == byte('\n')
				let name = string(b.slice(start, i - start)).trim()
				name = name[6:].trim() when name.startsWith("export ") || name.startsWith("export\t")
				fail "dotenv: line {line}: `{name}` is not a variable name" unless envIsName(name)
				i++
				for i < n && (b[i] == byte(' ') || b[i] == byte('\t')) {
					i++
				}
				let value byte[] = []
				let literal = false
				if i < n && (b[i] == byte('"') || b[i] == byte('\'') || b[i] == byte('`')) {
					let quote = b[i]
					let opened = line
					literal = quote == byte('\'')
					i++
					for i < n && b[i] != quote {
						if b[i] == byte('\\') && !literal && i + 1 < n {
							i++
							match char(b[i]) {
								case 'n':
									value.push(byte('\n'))
								case 'r':
									value.push(byte('\r'))
								case 't':
									value.push(byte('\t'))
								case '$':
									// Kept escaped until expansion, which drops the backslash.
									value.push(byte('\\'))
									value.push(byte('$'))
								case '\\', '"', '`':
									value.push(b[i])
								default:
									value.push(byte('\\'))
									value.push(b[i])
							}
							i++
							continue
						}
						line++ when b[i] == byte('\n')
						value.push(b[i])
						i++
					}
					fail "dotenv: line {opened}: the quoted value of `{name}` is not closed" when i >= n
					i++
					for i < n && (b[i] == byte(' ') || b[i] == byte('\t') || b[i] == byte('\r')) {
						i++
					}
					if i < n && b[i] == byte('#') {
						for i < n && b[i] != byte('\n') {
							i++
						}
					}
					fail "dotenv: line {line}: text after the closing quote of `{name}`" unless i >= n || b[i] == byte('\n')
				} else {
					let from = i
					let end = -1
					for i < n && b[i] != byte('\n') {
						// A comment starts at a `#` that follows space.
						end = i when end < 0 && b[i] == byte('#') && i > from && (b[i - 1] == byte(' ') || b[i - 1] == byte('\t'))
						i++
					}
					end = i when end < 0
					value = string(b.slice(from, end - from)).trim().bytes()
				}
				let text = string(value)
				text = envExpand(text, vars) when expand && !literal
				vars[name] = text
			}
			return vars
		}

		// decode reads the variables into target's fields: a field takes
		// the variable named by `@dotenv(name)`, else its own name in
		// upper snake case (`databaseUrl` reads `DATABASE_URL`). Bool,
		// integer, float and string fields and optionals of those are
		// filled; a field without a variable is left alone.
		// Fails as the map form does, and when a value does not convert to
		// its field's type.
		def decode(input string, target any) !none {
			let vars = try decode(input)
			for let (_, f) in reflection.fields(target) {
				let name = envKey(f)
				continue when name == "" || !vars.hasKey(name)
				let kind = f.kind == FieldKind.Optional ?? (f.elemKind, f.kind)
				continue unless iniIsScalar(kind)
				try iniSet(f, kind, vars[name], "dotenv: `{name}`")
			}
			return none
		}

		// encode writes a `NAME=value` line per variable in the map's
		// order, lines ended with LF. A value is put in single quotes when
		// plain text would read back differently, in double quotes with
		// escapes when it also holds a single quote.
		def encode(vars map<string, string>) string {
			let out = ""
			for let (name, value) in vars {
				out += name + "=" + envQuoted(value) + "\n"
			}
			return out
		}

		// encode writes an object's fields as `decode(input, target)` reads
		// them; an empty optional is left out.
		def encode(source any) string {
			let vars = map<string, string>{}
			for let (_, f) in reflection.fields(source) {
				let name = envKey(f)
				continue when name == ""
				let kind = f.kind
				if kind == FieldKind.Optional {
					continue when f.value() is none
					kind = f.elemKind
				}
				continue unless iniIsScalar(kind)
				vars[name] = iniScalar(f, kind)
			}
			return encode(vars)
		}

		// load reads the file and sets its variables in the process's
		// environment: those the environment does not have yet, or every
		// one with `override`. Returns the variables of the file.
		// Fails when the file cannot be read or does not decode, or the
		// system refuses a variable.
		def load(path string = ".env", override bool = false) !map<string, string> {
			let vars = try decode(string(try os.readFile(path)))
			for let (name, value) in vars {
				continue unless override || Runtime.getEnv(name) is none
				try Runtime.setEnv(name, value)
			}
			return vars
		}
	}

	// Sets how a field binds to a `.env` variable.
	//
	//     name    variable name to use instead of the field name in upper snake case
	//     ignore  leave the field out of both directions
	meta def dotenv(ctx reflection.FieldMetaContext, name string = "", ignore bool = false) {}

	// Sets how a property binds to a `.env` variable, as on a field.
	meta def dotenv(ctx reflection.PropertyMetaContext, name string = "", ignore bool = false) {}

	// Qualified name of the `@dotenv` meta function, used to look up options.
	internal const envAttr = "std.formats.data.dotenv"

	// The variable of a field, "" when it is left out.
	internal def envKey(f Field) string {
		return "" when f.attr(envAttr, "ignore") == "true"
		let named = f.attr(envAttr, "name")
		return named unless named == ""
		return f.name.snakeCase().upper()
	}

	internal def envIsNameByte(c byte, first bool) bool {
		return true when (c >= byte('a') && c <= byte('z')) || (c >= byte('A') && c <= byte('Z')) || c == byte('_')
		return !first && ((c >= byte('0') && c <= byte('9')) || c == byte('.') || c == byte('-'))
	}

	internal def envIsName(name string) bool {
		let b = name.bytes()
		return false when b.len() == 0
		for let (i, c) in b {
			return false unless envIsNameByte(c, i == 0)
		}
		return true
	}

	// The value of a variable for expansion: the file's, else the
	// process's.
	internal def envLookup(name string, vars map<string, string>) ?string {
		return vars[name] when vars.hasKey(name)
		return Runtime.getEnv(name)
	}

	// Replaces `$NAME`, `${NAME}`, `${NAME:-fallback}` and
	// `${NAME-fallback}`; `\$` is a dollar sign.
	internal def envExpand(text string, vars map<string, string>) string {
		return text unless text.contains("$")
		let b = text.bytes()
		let n = b.len()
		let out byte[] = []
		let i = 0
		for i < n {
			if b[i] == byte('\\') && i + 1 < n && b[i + 1] == byte('$') {
				out.push(byte('$'))
				i += 2
				continue
			}
			if b[i] != byte('$') || i + 1 >= n {
				out.push(b[i])
				i++
				continue
			}
			if b[i + 1] == byte('{') {
				let close = i + 2
				for close < n && b[close] != byte('}') {
					close++
				}
				if close >= n {
					out.push(b[i])
					i++
					continue
				}
				let inner = string(b.slice(i + 2, close - i - 2))
				let name = inner
				let fallback = ""
				let orEmpty = false
				let colon = inner.indexOf(":-")
				let dash = inner.indexOf("-")
				if colon >= 0 && (dash < 0 || colon < dash) {
					name = inner[:colon]
					fallback = inner[colon + 2:]
					orEmpty = true
				} else if dash >= 0 {
					name = inner[:dash]
					fallback = inner[dash + 1:]
				}
				let found = envLookup(name, vars)
				if found is none || (orEmpty && found == "") {
					out.push(...envExpand(fallback, vars).bytes())
				} else {
					out.push(...found.bytes())
				}
				i = close + 1
				continue
			}
			let end = i + 1
			for end < n && envIsNameByte(b[end], end == i + 1) && b[end] != byte('.') && b[end] != byte('-') {
				end++
			}
			if end == i + 1 {
				out.push(b[i])
				i++
				continue
			}
			let found = envLookup(string(b.slice(i + 1, end - i - 1)), vars)
			out.push(...found.bytes()) unless found is none
			i = end
		}
		return string(out)
	}

	// A value as written after `=`.
	internal def envQuoted(value string) string {
		let plain = value == value.trim() && !value.contains("\n") && !value.contains("\r") && !value.contains("#") && !value.contains("$") && !value.contains("\\")
		plain = false when value.startsWith("\"") || value.startsWith("'") || value.startsWith("`")
		return value when plain
		return "'" + value + "'" unless value.contains("'")
		return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").replace("$", "\\$").replace("\n", "\\n").replace("\r", "\\r") + "\""
	}
}
