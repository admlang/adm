partial module std.formats.data {
	use std.formats

	// The file formats this module reads or writes: each one's name, extensions and media
	// types, by name.
	def supportedFormats() formats.SupportedFormat[] {
		return [
			formats.SupportedFormat{name: "BitTorrent metainfo", extensions: [".torrent"], mimeTypes: ["application/x-bittorrent"]},
			formats.SupportedFormat{name: "Dotenv", extensions: [".env"], mimeTypes: []},
			formats.SupportedFormat{name: "INI", extensions: [".ini"], mimeTypes: []},
		]
	}
}
