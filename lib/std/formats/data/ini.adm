partial module std.formats.data {
	use (
		std.reflection
		std.reflection::(Field, FieldKind)
	)

	// INIEntry is one `key = value` line of an INI file.
	struct INIEntry {
		key     string
		value   string
		// The comment lines above the entry, without their markers, joined
		// by line breaks; empty for none.
		comment string
	}

	// INISection is a `[name]` block of an INI file: its entries in file
	// order. Keys are looked up ignoring case; a key may repeat.
	type INISection {
		name    string
		// The comment lines above the section header, as on an entry.
		comment string     = ""
		entries INIEntry[]

		def new(name string) {
			self.name = name
		}

		// The names of the keys in file order, a repeated key once.
		def keys() string[] {
			let out string[] = []
			let seen = map<string, bool>{}
			for let (_, e) in entries {
				let k = e.key.lower()
				continue when seen.hasKey(k)
				seen[k] = true
				out.push(e.key)
			}
			return out
		}

		// Reports whether the section has an entry of the key.
		def has(key string) bool {
			return find(key) >= 0
		}

		// The value of the key, the last one when it repeats; none when the
		// section has no such key.
		def get(key string) ?string {
			let at = find(key)
			return none when at < 0
			return entries[at].value
		}

		// Every value of the key in file order.
		def all(key string) string[] {
			let k = key.lower()
			let out string[] = []
			for let (_, e) in entries {
				out.push(e.value) when e.key.lower() == k
			}
			return out
		}

		// Sets the value of the key: the last entry of that key when there
		// is one, else a new entry at the end.
		def set(key string, value string) {
			let at = find(key)
			if at >= 0 {
				entries[at].value = value
				return
			}
			entries.push(INIEntry{key: key, value: value, comment: ""})
		}

		// Adds an entry at the end, beside any the key already has.
		def add(key string, value string) {
			entries.push(INIEntry{key: key, value: value, comment: ""})
		}

		// Removes every entry of the key; reports whether there was one.
		def remove(key string) bool {
			let k = key.lower()
			let kept INIEntry[] = []
			for let (_, e) in entries {
				kept.push(e) unless e.key.lower() == k
			}
			let removed = kept.len() != entries.len()
			entries = kept
			return removed
		}

		// The value of the key, or the fallback when absent.
		def string(key string, fallback string = "") string {
			let v = get(key)
			return fallback when v is none
			return v
		}

		// The value as an integer (decimal, or with a `0x`, `0o` or `0b`
		// prefix), or the fallback when absent or not an integer.
		def int(key string, fallback int = 0) int {
			let v = get(key)
			return fallback when v is none
			return fallback unless iniIsInteger(v.trim())
			return parseInt<int>(v.trim())
		}

		// The value as a number, or the fallback when absent or not one.
		def float(key string, fallback float = 0.0) float {
			let v = get(key)
			return fallback when v is none
			return fallback unless iniIsNumber(v.trim())
			return parseFloat<float>(v.trim())
		}

		// The value as a bool: `true`, `yes`, `on`, `1` and `false`, `no`,
		// `off`, `0` in any case; the fallback when absent or none of them.
		def bool(key string, fallback bool = false) bool {
			let v = get(key)
			return fallback when v is none
			let b = iniBool(v.trim())
			return fallback when b is none
			return b
		}

		// Index of the last entry of the key, -1 for none.
		internal def find(key string) int {
			let k = key.lower()
			for let i = entries.len() - 1; i >= 0; i-- {
				return i when entries[i].key.lower() == k
			}
			return -1
		}
	}

	// INIFile is an INI file as data: the entries before the first section
	// header, then the sections in file order. Section names are looked up
	// ignoring case.
	type INIFile {
		// The entries above the first `[section]`.
		global   INISection
		sections INISection[]
		// Comment lines after the last entry.
		footer   string       = ""

		def new() {
			global = new INISection("")
		}

		// The section of that name, none when the file has none; the empty
		// name is `global`.
		def section(name string) ?INISection {
			return global when name == ""
			let n = name.lower()
			for let (_, s) in sections {
				return s when s.name.lower() == n
			}
			return none
		}

		// The section of that name, added at the end when the file has none.
		def add(name string) INISection {
			let found = section(name)
			return found unless found is none
			let s = new INISection(name)
			sections.push(s)
			return s
		}

		// Removes the section; reports whether there was one.
		def remove(name string) bool {
			let n = name.lower()
			let kept INISection[] = []
			for let (_, s) in sections {
				kept.push(s) unless s.name.lower() == n
			}
			let removed = kept.len() != sections.len()
			sections = kept
			return removed
		}

		// The value of a key in a section ("" for the entries above the
		// first header); none when the section or the key is absent.
		def get(section string, key string) ?string {
			let s = self.section(section)
			return none when s is none
			return s.get(key)
		}

		// Sets a key in a section, adding the section when absent.
		def set(section string, key string, value string) {
			add(section).set(key, value)
		}
	}

	// INI reads and writes INI files: `key = value` lines grouped under
	// `[section]` headers, comment lines starting with `;` or `#`.
	//
	// ```
	// let file = try new INI().parse("[server]\nhost = example.com\nport = 8080\n")
	// let port = file.add("server").int("port") // 8080
	// file.set("server", "host", "localhost")
	// let text = new INI().encode(file)
	// ```
	//
	// A value in double quotes keeps its edge spaces and reads the escapes
	// `\\`, `\"`, `\'`, `\n`, `\r` and `\t`; a value in single quotes
	// is taken as it is. `decode` and `encode` also bind an object: its
	// scalar fields are the entries above the first header, each field
	// holding an object is the section of that name with that object's
	// scalar fields, and a `map<string, string>` field takes every entry of
	// its section.
	//
	// ```
	// struct Server {
	//     host string
	//     port int
	// }
	// struct Config {
	//     name string
	//     server Server
	//     @ini(name = "env")
	//     environment map<string, string>
	// }
	// let config = new Config()
	// try new INI().decode(text, config)
	// ```
	type INI {
		// The characters that end a key: the first one on a line does.
		delimiters string = "=:"

		// When set, ` ;` or ` #` after an unquoted value starts a comment.
		inlineComments bool = false

		// When set, a line with no delimiter is a key with an empty value;
		// otherwise it fails.
		bareKeys bool = false

		// When set, an indented line continues the value of the entry above
		// it on a new line, as Python's configparser reads them.
		multiline bool = false

		def new() {}

		// parse reads the text into an INIFile. A repeated section header
		// continues the earlier section; a repeated key is kept (`get`
		// gives the last, `all` every one). CRLF or LF line ends, a UTF-8
		// byte order mark ignored.
		// Fails with the line number when a header is not closed, a line
		// has no key or (without `bareKeys`) no delimiter, or a quoted
		// value is not closed.
		def parse(input string) !INIFile {
			let file = new INIFile()
			let current = file.global
			let comment string[] = []
			// The entry a continuation line extends, when `multiline`.
			let last ?INIEntry = none
			for let (n, raw) in input.trimPrefix("\uFEFF").split("\n") {
				let line = raw.trimSuffix("\r")
				let text = line.trim()
				if text == "" {
					last = none
					continue
				}
				if multiline && !(last is none) && (line.startsWith(" ") || line.startsWith("\t")) {
					last.value += "\n" + iniCutComment(text, inlineComments)
					continue
				}
				if text.startsWith(";") || text.startsWith("#") {
					comment.push(text[1:].trimPrefix(" "))
					continue
				}
				if text.startsWith("[") {
					let close = text.indexOf("]")
					fail "ini: line {n + 1}: the section header is not closed" when close < 0
					let rest = text[close + 1:].trim()
					fail "ini: line {n + 1}: text after the section header" unless rest == "" || rest.startsWith(";") || rest.startsWith("#")
					current = file.add(text[1:close].trim())
					if comment.len() > 0 {
						current.comment = comment.join("\n")
						comment = []
					}
					last = none
					continue
				}
				let cut = -1
				for let (_, d) in delimiters.split("") {
					let at = text.indexOf(d)
					cut = at when at >= 0 && (cut < 0 || at < cut)
				}
				let key = text
				let value = ""
				if cut >= 0 {
					key = text[:cut].trim()
					value = try iniValue(text[cut + 1:].trim(), inlineComments, n + 1)
				} else {
					fail "ini: line {n + 1}: expected `key = value`" unless bareKeys
					key = iniCutComment(text, inlineComments)
				}
				fail "ini: line {n + 1}: the line has no key" when key == ""
				let entry = INIEntry{key: key, value: value, comment: comment.join("\n")}
				comment = []
				current.entries.push(entry)
				last = entry
			}
			file.footer = comment.join("\n")
			return file
		}

		// decode reads the text into target: an INIFile is filled as
		// `parse` does (after what it holds), any other object by its
		// fields, entries going to the fields of their names (or
		// `@ini(name)`), ignoring case. Entries without a field and fields
		// without an entry are left alone.
		// Fails as `parse` does, and when a value does not convert to its
		// field's type.
		def decode(input string, target any) !none {
			let file = try parse(input)
			match target {
				case INIFile:
					let into INIFile = target
					iniMerge(into, file)
					return none
				default:
			}
			try iniBind(file.global, target, file)
			return none
		}

		// encode writes an INIFile, or an object as `decode` reads one:
		// the entries above the first header, then each section after an
		// empty line, comments as `; ` lines, lines ended with LF. A value
		// is put in double quotes when it would not read back as it is.
		def encode(source any) string {
			match source {
				case INIFile:
					let file INIFile = source
					return iniText(file, self)
				default:
			}
			return iniText(iniFromObject(source), self)
		}
	}

	// Sets how a field binds to an INI entry or section.
	//
	//     name    key or section name to use instead of the field name
	//     ignore  leave the field out of both directions
	meta def ini(ctx reflection.FieldMetaContext, name string = "", ignore bool = false) {}

	// Sets how a property binds to an INI entry or section, as on a field.
	meta def ini(ctx reflection.PropertyMetaContext, name string = "", ignore bool = false) {}

	// Qualified name of the `@ini` meta function, used to look up options.
	internal const iniAttr = "std.formats.data.ini"

	// A value as written after the delimiter: unquoted, or cut at an inline
	// comment.
	internal def iniValue(text string, inlineComments bool, line int) !string {
		if text.startsWith("\"") {
			let b = text.bytes()
			let out byte[] = []
			let i = 1
			for i < b.len() && b[i] != byte('"') {
				if b[i] == byte('\\') && i + 1 < b.len() {
					i++
					match char(b[i]) {
						case 'n':
							out.push(byte('\n'))
						case 'r':
							out.push(byte('\r'))
						case 't':
							out.push(byte('\t'))
						case '\\', '"', '\'':
							out.push(b[i])
						default:
							// Not an escape: Windows paths keep their backslashes.
							out.push(byte('\\'))
							out.push(b[i])
					}
					i++
					continue
				}
				out.push(b[i])
				i++
			}
			fail "ini: line {line}: the quoted value is not closed" when i >= b.len()
			let rest = string(b.slice(i + 1, b.len() - i - 1)).trim()
			fail "ini: line {line}: text after the closing quote" unless rest == "" || rest.startsWith(";") || rest.startsWith("#")
			return string(out)
		}
		if text.startsWith("'") {
			let close = text.indexOf("'", 1)
			fail "ini: line {line}: the quoted value is not closed" when close < 0
			let rest = text[close + 1:].trim()
			fail "ini: line {line}: text after the closing quote" unless rest == "" || rest.startsWith(";") || rest.startsWith("#")
			return text[1:close]
		}
		return iniCutComment(text, inlineComments)
	}

	// The text before its inline comment, when those are read.
	internal def iniCutComment(text string, inlineComments bool) string {
		return text unless inlineComments
		let cut = -1
		for let (_, mark) in [" ;", " #", "\t;", "\t#"] {
			let at = text.indexOf(mark)
			cut = at when at >= 0 && (cut < 0 || at < cut)
		}
		return text when cut < 0
		return text[:cut].trim()
	}

	internal def iniIsInteger(text string) bool {
		let b = text.lower().bytes()
		let i = 0
		i++ when b.len() > 0 && (b[0] == byte('+') || b[0] == byte('-'))
		let base = 10
		if i + 1 < b.len() && b[i] == byte('0') && (b[i + 1] == byte('x') || b[i + 1] == byte('o') || b[i + 1] == byte('b')) {
			base = b[i + 1] == byte('x') ?? (16, b[i + 1] == byte('o') ?? (8, 2))
			i += 2
		}
		return false when i >= b.len()
		for i < b.len() {
			let c = b[i]
			let digit = c >= byte('0') && c <= byte('9') ?? (int(c) - 48, c >= byte('a') && c <= byte('f') ?? (int(c) - 87, 99))
			return false when digit >= base
			i++
		}
		return true
	}

	// Reports whether text is a decimal number: sign, digits, an optional
	// fraction and exponent, or `inf` / `nan`.
	internal def iniIsNumber(text string) bool {
		let b = text.lower().bytes()
		let i = 0
		i++ when b.len() > 0 && (b[0] == byte('+') || b[0] == byte('-'))
		let rest = string(b.slice(i, b.len() - i))
		return true when rest := "inf" || "infinity" || "nan"
		let digits = 0
		for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
			i++
			digits++
		}
		if i < b.len() && b[i] == byte('.') {
			i++
			for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
				i++
				digits++
			}
		}
		return false when digits == 0
		if i < b.len() && b[i] == byte('e') {
			i++
			i++ when i < b.len() && (b[i] == byte('+') || b[i] == byte('-'))
			let start = i
			for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
				i++
			}
			return false when i == start
		}
		return i == b.len()
	}

	internal def iniBool(text string) ?bool {
		match text.lower() {
			case "true", "yes", "on", "1":
				return true
			case "false", "no", "off", "0":
				return false
			default:
				return none
		}
	}

	// Appends what `from` holds to `into`, section by section.
	internal def iniMerge(into INIFile, from INIFile) {
		into.global.entries.push(...from.global.entries)
		for let (_, s) in from.sections {
			let target = into.add(s.name)
			target.comment = s.comment when target.comment == ""
			target.entries.push(...s.entries)
		}
		into.footer = from.footer unless from.footer == ""
	}

	// The key of a field, "" when it is left out.
	internal def iniKey(f Field) string {
		return "" when f.attr(iniAttr, "ignore") == "true"
		let named = f.attr(iniAttr, "name")
		return named unless named == ""
		return f.name
	}

	internal def iniIsScalar(kind FieldKind) bool {
		return kind := FieldKind.Bool || FieldKind.Int || FieldKind.Uint || FieldKind.Float || FieldKind.String || FieldKind.Enum
	}

	// Fills target's scalar fields from the section's entries and, when
	// `file` is given, its object and map fields from the file's sections.
	internal def iniBind(section INISection, target any, file ?INIFile) !none {
		for let (_, f) in reflection.fields(target) {
			let key = iniKey(f)
			continue when key == ""
			let kind = f.kind == FieldKind.Optional ?? (f.elemKind, f.kind)
			if iniIsScalar(kind) {
				let value = section.get(key)
				continue when value is none
				try iniSet(f, kind, value, section.name == "" ?? ("ini: `{key}`", "ini: `{key}` in [{section.name}]"))
				continue
			}
			continue when file is none
			let from = file.section(key)
			continue when from is none
			if kind == FieldKind.Map {
				continue unless f.elemKind == FieldKind.String
				for let (_, e) in from.entries {
					f.entry(e.key).setString(e.value)
				}
				continue
			}
			continue unless kind == FieldKind.Struct
			let nested = f.ensureValue()
			continue when nested is none
			try iniBind(from, nested, none)
		}
		return none
	}

	// Stores a value in a scalar field, converted to the field's type;
	// `place` starts the error of a value that does not convert.
	internal def iniSet(f Field, kind FieldKind, value string, place string) !none {
		let text = value.trim()
		match kind {
			case FieldKind.String:
				f.setString(value)
			case FieldKind.Bool:
				let b = iniBool(text)
				fail "{place}: `{text}` is not a bool" when b is none
				f.setBool(b)
			case FieldKind.Int, FieldKind.Enum:
				fail "{place}: `{text}` is not an integer" unless iniIsInteger(text)
				f.setInt(parseInt<int>(text))
			case FieldKind.Uint:
				fail "{place}: `{text}` is not an unsigned integer" unless iniIsInteger(text) && !text.startsWith("-")
				f.setUint(parseInt<uint>(text))
			case FieldKind.Float:
				fail "{place}: `{text}` is not a number" unless iniIsNumber(text)
				f.setFloat(parseFloat<float>(text))
			default:
		}
		return none
	}

	// The text of a scalar field.
	internal def iniScalar(f Field, kind FieldKind) string {
		match kind {
			case FieldKind.String:
				return f.asString()
			case FieldKind.Bool:
				return f.asBool() ?? ("true", "false")
			case FieldKind.Uint:
				return f.asUint().str()
			case FieldKind.Float:
				return f.asFloat().str()
			default:
				return f.asInt().str()
		}
	}

	// Adds an object's scalar fields to the section; with `file`, its
	// object and map fields become sections.
	internal def iniCollect(section INISection, source any, file ?INIFile) {
		for let (_, f) in reflection.fields(source) {
			let key = iniKey(f)
			continue when key == ""
			let kind = f.kind
			if kind == FieldKind.Optional {
				continue when f.value() is none
				kind = f.elemKind
			}
			if iniIsScalar(kind) {
				section.add(key, iniScalar(f, kind))
				continue
			}
			continue when file is none
			if kind == FieldKind.Map {
				continue unless f.elemKind == FieldKind.String
				let into = file.add(key)
				for let (_, k) in f.keys() {
					into.add(k, f.entry(k).asString())
				}
				continue
			}
			continue unless kind == FieldKind.Struct
			let nested = f.value()
			continue when nested is none
			iniCollect(file.add(key), nested, none)
		}
	}

	internal def iniFromObject(source any) INIFile {
		let file = new INIFile()
		iniCollect(file.global, source, file)
		return file
	}

	// A value as written: in double quotes with escapes when plain text
	// would read back differently.
	internal def iniQuoted(value string, codec INI) string {
		let plain = value != "" && value == value.trim() && !value.startsWith("\"") && !value.startsWith("'") && !value.contains("\r")
		plain = false when value.contains("\n") && !codec.multiline
		plain = false when codec.inlineComments && iniCutComment(value, true) != value
		return value.replace("\n", "\n\t") when plain
		return value when value == ""
		return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r") + "\""
	}

	internal def iniComment(out string[], comment string) {
		return when comment == ""
		for let (_, line) in comment.split("\n") {
			out.push(line == "" ?? (";", "; " + line))
		}
	}

	internal def iniSectionText(out string[], section INISection, codec INI) {
		let mark = codec.delimiters == "" ?? ("=", codec.delimiters.split("")[0])
		let between = mark == ":" ?? (": ", " " + mark + " ")
		for let (_, e) in section.entries {
			iniComment(out, e.comment)
			if e.value == "" && codec.bareKeys {
				out.push(e.key)
			} else {
				out.push(e.key + between + iniQuoted(e.value, codec))
			}
		}
	}

	internal def iniText(file INIFile, codec INI) string {
		let out string[] = []
		iniSectionText(out, file.global, codec)
		for let (_, s) in file.sections {
			out.push("") when out.len() > 0
			iniComment(out, s.comment)
			out.push("[" + s.name + "]")
			iniSectionText(out, s, codec)
		}
		if file.footer != "" {
			out.push("") when out.len() > 0
			iniComment(out, file.footer)
		}
		return "" when out.len() == 0
		return out.join("\n") + "\n"
	}
}
