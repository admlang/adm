partial module std.formats.data {
	use (
		std.testing
		std.time
		std.os
		std.services.runtime::(Runtime)
	)

	internal struct IniServer {
		host  string
		port  int
		tls   ?bool
		ratio float
	}

	internal struct IniConfig {
		name string
		retries uint
		server IniServer
		@ini(name = "env")
		environment map<string, string>
		@ini(ignore = true)
		secret string
		missing ?int
	}

	internal struct EnvConfig {
		databaseUrl string
		port int
		debug bool
		@dotenv(name = "RATE")
		ratio ?float
		@dotenv(ignore = true)
		secret string
		absent ?string
	}

	// An optional string for comparison.
	internal def iniText(value ?string) string {
		return "<none>" when value is none
		return value
	}

	check "INI" {
		def sample() string {
			return "\uFEFF; app settings\r\nname = demo\r\nretries: 3\r\n\r\n# the server\r\n[Server]\r\nhost = \"  example.com \"\r\nport = 0x1F90\r\ntls = yes\r\nratio = 2.5e-1\r\npath = 'C:\\temp' ; kept\r\n\r\n[env]\r\nA = 1\r\nB = two words\r\nA = 3\r\n; the end\r\n"
		}

		@test()
		def TestParse() !none {
			let file = try new INI().parse(sample())
			assert file.global.keys().join(",") == "name,retries"
			assert file.global.entries[0].comment == "app settings"
			assert file.global.string("name") == "demo" && file.global.int("retries") == 3
			assert file.sections.len() == 2 && file.sections[0].name == "Server" && file.sections[0].comment == "the server"
			let server = file.section("server")
			fail "no server section" when server is none
			assert server.string("HOST") == "  example.com " && server.int("port") == 8080 && server.bool("tls") && server.float("ratio") == 0.25
			assert server.string("path") == "C:\\temp"
			assert server.int("host", 7) == 7 && server.string("nope", "x") == "x" && !server.has("nope")
			assert iniText(file.get("env", "a")) == "3" && file.get("env", "zz") is none && file.get("nope", "a") is none
			let env = file.add("ENV")
			assert env.all("A").join(",") == "1,3" && env.keys().join(",") == "A,B" && file.sections.len() == 2
			assert file.footer == "the end"
		}

		@test()
		def TestEdit() !none {
			let file = new INIFile()
			file.set("", "title", " padded ")
			file.set("paths", "home", "/root")
			file.set("paths", "home", "/home/ada")
			file.add("paths").add("extra", "a\nb")
			file.add("paths").comment = "where things live"
			file.set("empty", "k", "")
			let text = new INI().encode(file)
			assert text == "title = \" padded \"\n\n; where things live\n[paths]\nhome = /home/ada\nextra = \"a\\nb\"\n\n[empty]\nk = \n"
			let back = try new INI().parse(text)
			assert iniText(back.get("", "title")) == " padded " && iniText(back.get("paths", "extra")) == "a\nb" && iniText(back.get("empty", "k")) == ""
			assert back.add("paths").remove("HOME") && !back.add("paths").remove("home")
			assert back.remove("Empty") && back.sections.len() == 1
		}

		@test()
		def TestOptions() !none {
			let codec = new INI()
			codec.inlineComments = true
			codec.bareKeys = true
			codec.multiline = true
			let file = try codec.parse("[core]\nbare\nurl = http://x/#frag ; note\nlist = one\n  two # second\n\tthree\nafter = 1\n")
			let core = file.add("core")
			assert core.has("bare") && core.string("bare") == "" && core.string("url") == "http://x/#frag"
			assert core.string("list") == "one\ntwo\nthree" && core.int("after") == 1
			let text = codec.encode(file)
			assert text == "[core]\nbare\nurl = http://x/#frag\nlist = one\n\ttwo\n\tthree\nafter = 1\n"
			let colon = new INI()
			colon.delimiters = ":"
			assert colon.encode(try colon.parse("a=b: c\n")) == "a=b: c\n"

			let errors string[] = []
			for let (_, bad) in ["[open\n", "x\n", "= 1\n", "a = \"open\n", "[s] junk\n", "a = \"x\" y\n"] {
				new INI().parse("ok = 1\n" + bad) onerror (err error) {
					errors.push(err.message)
					recover new INIFile()
				}
			}
			assert errors.len() == 6
			assert errors[0] == "ini: line 2: the section header is not closed" && errors[1] == "ini: line 2: expected `key = value`"
		}

		@test()
		def TestObjects() !none {
			let config = new IniConfig()
			config.secret = "keep"
			try new INI().decode(sample(), config)
			assert config.name == "demo" && config.retries == uint(3) && config.secret == "keep" && config.missing is none
			assert config.server.host == "  example.com " && config.server.port == 8080 && config.server.ratio == 0.25
			let tls = config.server.tls
			fail "tls was not read" when tls is none
			assert tls
			assert config.environment.len() == 2 && config.environment["A"] == "3" && config.environment["B"] == "two words"

			let text = new INI().encode(config)
			assert text == "name = demo\nretries = 3\n\n[server]\nhost = \"  example.com \"\nport = 8080\ntls = true\nratio = 0.25\n\n[env]\nA = 3\nB = two words\n"
			let again = new IniConfig()
			try new INI().decode(text, again)
			assert again.server.port == 8080 && again.environment["B"] == "two words"

			let into = new INIFile()
			into.set("env", "C", "4")
			try new INI().decode(sample(), into)
			assert into.add("env").keys().join(",") == "C,A,B"

			let message = ""
			new INI().decode("[server]\nport = high\n", new IniConfig()) onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "ini: `port` in [server]: `high` is not an integer"
		}
	}

	check "DotEnv" {
		@test()
		def TestDecode() !none {
			let text = "\uFEFF# settings\r\nexport PORT=8080\r\n  HOST = example.com   # the host\r\nEMPTY=\r\nURL=\"http://$\{HOST\}:$PORT/a\\tb\"\r\nRAW='$PORT $\{HOST\} \\n'\nMULTI=\"line one\nline two\" # done\nTICK=`a \"b\" 'c'`\nHASH=a#b\nFALLBACK=$\{ADM_TEST_UNSET_1:-none\}/$\{EMPTY:-void\}/$\{EMPTY-set\}/$\{ADM_TEST_UNSET_1-gone\}\nNESTED=$\{ADM_TEST_UNSET_1:-$PORT\}\nESCAPED=\"cost \\$5 $ADM_TEST_UNSET_1.\"\nPORT=9090\n"
			let vars = try new DotEnv().decode(text)
			assert vars.keys().join(",") == "PORT,HOST,EMPTY,URL,RAW,MULTI,TICK,HASH,FALLBACK,NESTED,ESCAPED"
			assert vars["PORT"] == "9090" && vars["HOST"] == "example.com" && vars["EMPTY"] == ""
			assert vars["URL"] == "http://example.com:8080/a\tb"
			assert vars["RAW"] == "$PORT $\{HOST\} \\n"
			assert vars["MULTI"] == "line one\nline two" && vars["TICK"] == "a \"b\" 'c'" && vars["HASH"] == "a#b"
			assert vars["FALLBACK"] == "none/void//gone" && vars["NESTED"] == "8080" && vars["ESCAPED"] == "cost $5 ."

			let plain = new DotEnv()
			plain.expand = false
			assert (try plain.decode("A=1\nB=$A\n"))["B"] == "$A"

			let errors string[] = []
			for let (_, bad) in ["JUST\n", "1A=x\n", "A B=x\n", "A=\"open\n", "A='x' y\n"] {
				new DotEnv().decode("OK=1\n" + bad) onerror (err error) {
					errors.push(err.message)
					recover map<string, string>{}
				}
			}
			assert errors.len() == 5 && errors[0] == "dotenv: line 2: expected `NAME=value`"
			assert errors[3] == "dotenv: line 2: the quoted value of `A` is not closed"
		}

		@test()
		def TestEncodeAndObjects() !none {
			let vars = map<string, string>{}
			vars["PLAIN"] = "value"
			vars["SPACED"] = " two words "
			vars["MONEY"] = "$5 # not a comment"
			vars["QUOTE"] = "it's \"so\"\n$HOME"
			vars["EMPTY"] = ""
			let text = new DotEnv().encode(vars)
			assert text == "PLAIN=value\nSPACED=' two words '\nMONEY='$5 # not a comment'\nQUOTE=\"it's \\\"so\\\"\\n\\$HOME\"\nEMPTY=\n"
			let back = try new DotEnv().decode(text)
			for let (name, value) in vars {
				assert back[name] == value
			}

			let config = new EnvConfig()
			config.secret = "keep"
			try new DotEnv().decode("DATABASE_URL=postgres://db/app\nPORT=5432\nDEBUG=on\nRATE=0.5\nSECRET=no\n", config)
			assert config.databaseUrl == "postgres://db/app" && config.port == 5432 && config.debug && config.secret == "keep" && config.absent is none
			let ratio = config.ratio
			fail "the rate was not read" when ratio is none
			assert ratio == 0.5
			assert new DotEnv().encode(config) == "DATABASE_URL=postgres://db/app\nPORT=5432\nDEBUG=true\nRATE=0.5\n"
			let message = ""
			new DotEnv().decode("PORT=abc\n", config) onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "dotenv: `PORT`: `abc` is not an integer"
		}

		@test()
		def TestLoad() !none {
			let path = "/tmp/adm-dotenv-{time.now().unixNs()}.env"
			defer os.remove(path)
			try os.writeFile(path, "ADM_DOTENV_TEST_A=from file\nADM_DOTENV_TEST_B=$\{ADM_DOTENV_TEST_A\}!\n".bytes())
			try Runtime.setEnv("ADM_DOTENV_TEST_A", "already")
			let vars = try new DotEnv().load(path)
			assert vars["ADM_DOTENV_TEST_B"] == "from file!"
			assert iniText(Runtime.getEnv("ADM_DOTENV_TEST_A")) == "already" && iniText(Runtime.getEnv("ADM_DOTENV_TEST_B")) == "from file!"
			let _ = try new DotEnv().load(path, true)
			assert iniText(Runtime.getEnv("ADM_DOTENV_TEST_A")) == "from file"
			let failed = false
			new DotEnv().load(path + ".missing") onerror (err error) {
				failed = true
				recover map<string, string>{}
			}
			assert failed
		}
	}
}
