// MaxMind DB files (`.mmdb`): a binary search tree over IP addresses whose
// leaves point at records, the format of the GeoIP2 and GeoLite2 databases
// and of the DB-IP and IPinfo ones (MaxMind DB File Format 2.0).
//
// ```
// use std.formats.data.mmdb
//
// let db = try mmdb.open("/usr/share/GeoIP/GeoLite2-City.mmdb")
// let place = try db.location("81.2.69.142")
// println(place.country.code) unless place is none
// ```
partial module std.formats.data.mmdb {
	use (
		std.net::(ipText, parseIPText)
		std.os
		std.time
	)

	// Metadata is what a database says about itself.
	struct Metadata {
		// The kind of records the database holds, such as `GeoLite2-City`,
		// `GeoIP2-Country` or `GeoLite2-ASN`.
		databaseType string
		// A description of the database per language code.
		description  map<string, string>
		// The language codes the names in the records may be given in.
		languages    string[]
		// 4 when the tree holds IPv4 addresses only, 6 when it holds IPv6
		// addresses with the IPv4 ones under `::/96`.
		ipVersion    int
		// The number of nodes in the search tree.
		nodeCount    int
		// The size of a tree record in bits: 24, 28 or 32.
		recordSize   int
		// The version of the file format, 2.0 today.
		majorVersion int
		minorVersion int
		// When the database was built.
		built        time.Time
	}

	// Record is what a database holds for an address.
	struct Record {
		// The network the address falls in, as CIDR text (`81.2.69.0/24`).
		// Every address of that network has the same record.
		network string
		// The length of that network's prefix in bits.
		prefix  int
		// The stored data as plain values: a map as `map<string, any>`, an
		// array as `any[]`, a string as `string`, bytes as `byte[]`, a double
		// as `float`, a float as `float32`, a boolean as `bool`, uint16,
		// uint32 and int32 as `int`, uint64 as `uint64` and uint128 as
		// `bigint`.
		data    any
	}

	// Place is a named place of a GeoIP2 or GeoLite2 record: a continent, a
	// country, a subdivision or a city. A place the record does not have has
	// an empty code and name and an id of 0.
	struct Place {
		// The continent code (`EU`), the ISO 3166-1 country code (`GB`) or
		// the ISO 3166-2 subdivision code (`ENG`). Cities have none.
		code      string
		// The place's id in the GeoNames database.
		geonameId int
		// The name in the language the lookup asked for.
		name      string
	}

	// Location is a GeoIP2 or GeoLite2 Country or City record. A Country
	// database fills the continent and the countries; a City database fills
	// the rest too, where it knows it.
	struct Location {
		// The network the address falls in, as CIDR text.
		network           string
		continent         Place
		// The country the address is in.
		country           Place
		// The country the address is registered in.
		registeredCountry Place
		// Whether the country is a member of the European Union.
		inEuropeanUnion   bool
		// The subdivisions from the largest (a state, a nation) to the
		// smallest (a county).
		subdivisions      Place[]
		city              Place
		postalCode        string
		// Approximate coordinates in degrees; both 0 when unknown.
		latitude          float
		longitude         float
		// The radius in kilometres around the coordinates the address is
		// likely within; 0 when unknown.
		accuracyRadius    int
		// The IANA time zone name, such as `Europe/London`.
		timeZone          string
	}

	// AutonomousSystem is a GeoLite2 ASN record: the network operator that
	// announces the address.
	struct AutonomousSystem {
		// The network the address falls in, as CIDR text.
		network      string
		number       int
		organization string
	}

	// Opens the database file at the path. The whole file is read into
	// memory. Fails when the file cannot be read or is not a MaxMind DB
	// file of format version 2.
	def open(path string) !Database {
		return try open(try os.readFile(path))
	}

	// Opens a database held in memory. The array is used as it is, not
	// copied. Fails when the bytes are not a MaxMind DB file of format
	// version 2.
	def open(data byte[]) !Database {
		let marker = metadataMarker(data)
		fail "mmdb: not a MaxMind DB file: no metadata marker" when marker < 0
		let start = marker + 14
		let head = new Cursor(data, start, data.len())
		let major = try requiredNumber(head, start, "binary_format_major_version")
		fail "mmdb: format version {major} is not supported" when major != 2

		let nodeCount = try requiredNumber(head, start, "node_count")
		let recordSize = try requiredNumber(head, start, "record_size")
		let ipVersion = try requiredNumber(head, start, "ip_version")
		fail "mmdb: record size {recordSize} is not 24, 28 or 32" when recordSize != 24 && recordSize != 28 && recordSize != 32
		fail "mmdb: IP version {ipVersion} is not 4 or 6" when ipVersion != 4 && ipVersion != 6
		let treeSize = nodeCount * recordSize / 4
		fail "mmdb: the search tree of {nodeCount} nodes does not fit the file" when treeSize + 16 > marker

		let info = Metadata{
			databaseType: "",
			description:  map<string, string>{},
			languages:    [],
			ipVersion:    ipVersion,
			nodeCount:    nodeCount,
			recordSize:   recordSize,
			majorVersion: major,
			minorVersion: 0,
			built:        time.fromUnixNs(0),
		}
		let at = try head.find(start, "database_type".bytes())
		info.databaseType = try head.text(at) when at >= 0
		at = try head.find(start, "binary_format_minor_version".bytes())
		info.minorVersion = int(try head.number(at)) when at >= 0
		at = try head.find(start, "build_epoch".bytes())
		info.built = time.fromUnixNs(int64(try head.number(at)) * 1000000000) when at >= 0
		at = try head.find(start, "description".bytes())
		if at >= 0 {
			try head.read(at)
			fail "mmdb: the metadata description is not a map" when head.kind != 7
			let count = head.size
			let p = head.at
			for let i = 0; i < count; i++ {
				let language = try head.text(p)
				let valueAt = head.next
				info.description[language] = try head.text(valueAt)
				p = head.next
			}
		}
		at = try head.find(start, "languages".bytes())
		if at >= 0 {
			try head.read(at)
			fail "mmdb: the metadata languages are not an array" when head.kind != 11
			let count = head.size
			let p = head.at
			for let i = 0; i < count; i++ {
				info.languages.push(try head.text(p))
				p = head.next
			}
		}
		return new Database(data, info, marker)
	}

	// Database is an open MaxMind DB file. Lookups only read, so one
	// database serves any number of tasks at once.
	//
	// An address is text (`81.2.69.142`, `2001:db8::1`) or its 4 or 16
	// bytes. Every lookup fails on text that is not an IP address, on an
	// IPv6 address in a database of IPv4 addresses, and on a file whose
	// tree or records are damaged.
	type Database {
		// What the database says about itself.
		metadata Metadata

		internal data       byte[]
		internal nodeCount  int
		internal recordSize int
		internal treeSize   int
		// Where the data section ends: at the metadata marker.
		internal dataEnd    int
		// The node the 96 zero bits of `::/96` lead to: where IPv4
		// addresses start in a tree of IPv6 addresses.
		internal ipv4Start  int

		def new(data byte[], metadata Metadata, dataEnd int) {
			self.data = data
			self.metadata = metadata
			self.dataEnd = dataEnd
			nodeCount = metadata.nodeCount
			recordSize = metadata.recordSize
			treeSize = nodeCount * recordSize / 4
			ipv4Start = 0
			if metadata.ipVersion == 6 {
				for let i = 0; i < 96 && ipv4Start < nodeCount; i++ {
					ipv4Start = next(ipv4Start, 0)
				}
			}
		}

		// The data stored for the address as plain values (see
		// `Record.data`), or none when the database has nothing for it.
		// Fails on an address that is not an IP address, on an IPv6 address
		// in a database of IPv4 addresses, and on a damaged file.
		def lookup(address string) !any {
			return try lookup(try addressBytes(address))
		}

		// The data stored for the address given as its 4 or 16 bytes.
		// Fails on another length, as the text form does otherwise.
		def lookup(address byte[]) !any {
			let records = new Cursor(data, treeSize + 16, dataEnd)
			let prefix = try seek(address, records)
			return none when records.at < 0
			return try records.value(records.at, 0)
		}

		// The record for the address with the network it covers, or none
		// when the database has nothing for the address.
		// Fails on an address that is not an IP address, on an IPv6 address
		// in a database of IPv4 addresses, and on a damaged file.
		def record(address string) !?Record {
			return try record(try addressBytes(address))
		}

		// The record for the address given as its 4 or 16 bytes. Fails on
		// another length, as the text form does otherwise.
		def record(address byte[]) !?Record {
			let records = new Cursor(data, treeSize + 16, dataEnd)
			let prefix = try seek(address, records)
			return none when records.at < 0
			return Record{network: networkText(address, prefix), prefix: prefix, data: try records.value(records.at, 0)}
		}

		// The address's record read as a GeoIP2 or GeoLite2 Country or
		// City record, with place names in the language (a code from
		// `metadata.languages`; a name the record lacks in it is empty).
		// None when the database has nothing for the address. Parts the
		// record lacks stay empty, so a database of another kind gives an
		// empty Location.
		// Fails on an address that is not an IP address, on an IPv6 address
		// in a database of IPv4 addresses, and on a damaged file.
		def location(address string, language string = "en") !?Location {
			return try location(try addressBytes(address), language)
		}

		// The Location for the address given as its 4 or 16 bytes. Fails on
		// another length, as the text form does otherwise.
		def location(address byte[], language string = "en") !?Location {
			let records = new Cursor(data, treeSize + 16, dataEnd)
			let prefix = try seek(address, records)
			return none when records.at < 0
			let tongue = language.bytes()
			let out = Location{
				network:           networkText(address, prefix),
				continent:         noPlace(),
				country:           noPlace(),
				registeredCountry: noPlace(),
				inEuropeanUnion:   false,
				subdivisions:      [],
				city:              noPlace(),
				postalCode:        "",
				latitude:          0.0,
				longitude:         0.0,
				accuracyRadius:    0,
				timeZone:          "",
			}
			try records.read(records.at)
			fail "mmdb: the record is not a map" when records.kind != 7
			let count = records.size
			let p = records.at
			for let i = 0; i < count; i++ {
				try records.read(p)
				fail "mmdb: a map key is not a string" when records.kind != 2
				let valueAt = records.next
				if records.named(keyCountry) {
					out.country = try place(records, valueAt, tongue)
					let eu = try records.find(valueAt, keyInEuropeanUnion)
					out.inEuropeanUnion = try records.flag(eu) when eu >= 0
				} else if records.named(keyContinent) {
					out.continent = try place(records, valueAt, tongue)
				} else if records.named(keyRegisteredCountry) {
					out.registeredCountry = try place(records, valueAt, tongue)
				} else if records.named(keyCity) {
					out.city = try place(records, valueAt, tongue)
				} else if records.named(keySubdivisions) {
					try records.read(valueAt)
					fail "mmdb: the subdivisions of a record are not an array" when records.kind != 11
					let parts = records.size
					let q = records.at
					for let j = 0; j < parts; j++ {
						out.subdivisions.push(try place(records, q, tongue))
						q = try records.skip(q, 0)
					}
				} else if records.named(keyPostal) {
					let code = try records.find(valueAt, keyCode)
					out.postalCode = try records.text(code) when code >= 0
				} else if records.named(keyLocation) {
					let part = try records.find(valueAt, keyLatitude)
					out.latitude = try records.real(part) when part >= 0
					part = try records.find(valueAt, keyLongitude)
					out.longitude = try records.real(part) when part >= 0
					part = try records.find(valueAt, keyAccuracyRadius)
					out.accuracyRadius = int(try records.number(part)) when part >= 0
					part = try records.find(valueAt, keyTimeZone)
					out.timeZone = try records.text(part) when part >= 0
				}
				p = try records.skip(valueAt, 0)
			}
			return out
		}

		// The address's record read as a GeoLite2 ASN record, or none when
		// the database has nothing for the address. A record without the
		// ASN fields gives number 0 and an empty organization.
		// Fails on an address that is not an IP address, on an IPv6 address
		// in a database of IPv4 addresses, and on a damaged file.
		def autonomousSystem(address string) !?AutonomousSystem {
			return try autonomousSystem(try addressBytes(address))
		}

		// The ASN record for the address given as its 4 or 16 bytes. Fails
		// on another length, as the text form does otherwise.
		def autonomousSystem(address byte[]) !?AutonomousSystem {
			let records = new Cursor(data, treeSize + 16, dataEnd)
			let prefix = try seek(address, records)
			return none when records.at < 0
			let root = records.at
			let out = AutonomousSystem{network: networkText(address, prefix), number: 0, organization: ""}
			let at = try records.find(root, keyAsNumber)
			out.number = int(try records.number(at)) when at >= 0
			at = try records.find(root, keyAsOrganization)
			out.organization = try records.text(at) when at >= 0
			return out
		}

		// Walks the tree along the address's bits and returns the number
		// of bits walked, the prefix length of the network. Leaves the
		// offset of the record in `records.at`, -1 when there is none.
		internal def seek(address byte[], records Cursor) !int {
			let size = address.len()
			fail "mmdb: an address is 4 or 16 bytes, not {size}" when size != 4 && size != 16
			fail "mmdb: an IPv6 address cannot be looked up in a database of IPv4 addresses" when size == 16 && metadata.ipVersion == 4
			let node = 0
			node = ipv4Start when size == 4 && metadata.ipVersion == 6
			let bits = size * 8
			let i = 0
			for i < bits && node < nodeCount {
				let bit = (int(address[i >> 3]) >> (7 - (i & 7))) & 1
				node = next(node, bit)
				i++
			}
			records.at = -1
			return i when node == nodeCount
			fail "mmdb: the search tree is deeper than an address is long" when node < nodeCount
			let at = node - nodeCount + treeSize
			fail "mmdb: a tree record points outside the data section" when at < records.base || at >= records.limit
			records.at = at
			return i
		}

		// The left (0) or right (1) record of a node: a node number, the
		// node count for "no data", or a larger value that locates a record.
		internal def next(node int, side int) int {
			if recordSize == 24 {
				let at = node * 6 + side * 3
				return (int(data[at]) << 16) | (int(data[at + 1]) << 8) | int(data[at + 2])
			}
			if recordSize == 28 {
				let at = node * 7
				let middle = int(data[at + 3])
				return ((middle >> 4) << 24) | (int(data[at]) << 16) | (int(data[at + 1]) << 8) | int(data[at + 2]) when side == 0
				return ((middle & 15) << 24) | (int(data[at + 4]) << 16) | (int(data[at + 5]) << 8) | int(data[at + 6])
			}
			let at = node * 8 + side * 4
			return (int(data[at]) << 24) | (int(data[at + 1]) << 16) | (int(data[at + 2]) << 8) | int(data[at + 3])
		}
	}

	// Reads the fields of a data section: the records of a database, or its
	// metadata. Pointers are offsets from `base`, and nothing is read at or
	// past `limit`. A read leaves the field in `kind`, `size`, `at` and
	// `next`, so one cursor serves one lookup at a time.
	internal type Cursor {
		data  byte[]
		base  int
		limit int
		// The format's type number of the field last read: 2 string,
		// 3 double, 4 bytes, 5 uint16, 6 uint32, 7 map, 8 int32, 9 uint64,
		// 10 uint128, 11 array, 14 boolean, 15 float; 1 (pointer) only
		// after `raw`.
		kind  int
		// Its payload's length in bytes; for a map its number of pairs,
		// for an array its number of items, for a boolean its value.
		size  int
		// Where its payload starts, or the first key or item of a
		// container; after `raw` on a pointer, where the pointer leads.
		at    int
		// Where the field after it starts in the stream it was read from:
		// after the pointer when one led to it. For a container read in
		// place that is `at`, its contents.
		next  int

		def new(data byte[], base int, limit int) {
			self.data = data
			self.base = base
			self.limit = limit
			kind = 0
			size = 0
			at = -1
			next = -1
		}

		// Reads the field at the offset without following a pointer.
		// Fails on a field that runs past the section and on a type or
		// size the format does not have.
		def raw(from int) !none {
			expects {
				assert from >= base && from < limit onerror fail "mmdb: a field starts outside its section"
			}
			let control = int(data[from])
			let pos = from + 1
			kind = control >> 5
			if kind == 1 {
				let width = ((control >> 3) & 3) + 1
				fail "mmdb: a pointer runs past its section" when pos + width > limit
				let value = control & 7
				value = 0 when width == 4
				for let i = 0; i < width; i++ {
					value = (value << 8) | int(data[pos + i])
				}
				value += 2048 when width == 2
				value += 526336 when width == 3
				fail "mmdb: a pointer leads outside its section" when base + value >= limit
				size = 0
				at = base + value
				next = pos + width
				return none
			}
			if kind == 0 {
				fail "mmdb: a field runs past its section" when pos >= limit
				kind = int(data[pos]) + 7
				pos++
			}
			size = control & 31
			if size >= 29 {
				let extra = size - 28
				fail "mmdb: a field runs past its section" when pos + extra > limit
				let more = 0
				for let i = 0; i < extra; i++ {
					more = (more << 8) | int(data[pos + i])
				}
				pos += extra
				size = 29 + more when extra == 1
				size = 285 + more when extra == 2
				size = 65821 + more when extra == 3
			}
			at = pos
			next = pos
			return none when kind := 7 || 11 || 14
			let most = 0
			switch kind {
				case 2, 4:
					most = size
				case 3:
					fail "mmdb: a double of {size} bytes" when size != 8
					most = 8
				case 15:
					fail "mmdb: a float of {size} bytes" when size != 4
					most = 4
				case 5:
					most = 2
				case 6, 8:
					most = 4
				case 9:
					most = 8
				case 10:
					most = 16
				default:
					fail "mmdb: unknown field type {kind}"
			}
			fail "mmdb: an integer of type {kind} takes {size} bytes" when size > most
			fail "mmdb: a field runs past its section" when pos + size > limit
			next = pos + size
			return none
		}

		// Reads the field at the offset, following a pointer. Fails as
		// `raw` does, and on a pointer that leads to another pointer.
		def read(from int) !none {
			try raw(from)
			return none when kind != 1
			let after = next
			try raw(at)
			fail "mmdb: a pointer leads to another pointer" when kind == 1
			next = after
			return none
		}

		// The offset after the whole value at the offset, contents of a
		// container included. Fails on containers nested deeper than 512.
		def skip(from int, depth int) !int {
			expects {
				assert depth <= 512 onerror fail "mmdb: a value nests deeper than 512 levels"
			}
			try raw(from)
			let count = 0
			count = size * 2 when kind == 7
			count = size when kind == 11
			let p = next
			for let i = 0; i < count; i++ {
				p = try skip(p, depth + 1)
			}
			return p
		}

		// Whether the string field last read is the wanted bytes.
		def named(want byte[]) bool {
			return false when size != want.len()
			for let j = 0; j < size; j++ {
				return false when data[at + j] != want[j]
			}
			return true
		}

		// The offset of the value stored under the key in the map at the
		// offset, or -1 when the map has no such key or the offset is -1.
		// Fails when the value there is not a map.
		def find(from int, key byte[]) !int {
			return -1 when from < 0
			try read(from)
			fail "mmdb: looked for a key in a value that is not a map" when kind != 7
			let count = size
			let p = at
			for let i = 0; i < count; i++ {
				try read(p)
				fail "mmdb: a map key is not a string" when kind != 2
				return next when named(key)
				p = try skip(next, 0)
			}
			return -1
		}

		// The string at the offset. Fails when the value is not a string.
		def text(from int) !string {
			try read(from)
			fail "mmdb: expected a string, found type {kind}" when kind != 2
			return string(data[at:at + size])
		}

		// The unsigned integer at the offset (uint16, uint32 or uint64).
		// Fails when the value is another type.
		def number(from int) !uint64 {
			try read(from)
			fail "mmdb: expected an unsigned integer, found type {kind}" when kind != 5 && kind != 6 && kind != 9
			return unsigned()
		}

		// The double or float at the offset. Fails when the value is
		// another type.
		def real(from int) !float {
			try read(from)
			return float(__bitcast_f64_from_u64(unsigned())) when kind == 3
			return float(__bitcast_f32_from_u32(uint32(unsigned()))) when kind == 15
			fail "mmdb: expected a double or a float, found type {kind}"
		}

		// The boolean at the offset. Fails when the value is another type.
		def flag(from int) !bool {
			try read(from)
			fail "mmdb: expected a boolean, found type {kind}" when kind != 14
			return size != 0
		}

		// The value at the offset as plain values (see `Record.data`).
		// Fails on containers nested deeper than 512.
		def value(from int, depth int) !any {
			expects {
				assert depth <= 512 onerror fail "mmdb: a value nests deeper than 512 levels"
			}
			try read(from)
			switch kind {
				case 2:
					return string(data[at:at + size])
				case 3:
					return float(__bitcast_f64_from_u64(unsigned()))
				case 4:
					return data[at:at + size].clone()
				case 5, 6:
					return int(unsigned())
				case 8:
					let wide = int(unsigned())
					wide -= 4294967296 when size == 4 && wide >= 2147483648
					return wide
				case 9:
					return unsigned()
				case 10:
					return parseBigInt(data[at:at + size])
				case 14:
					return size != 0
				case 15:
					return __bitcast_f32_from_u32(uint32(unsigned()))
				case 11:
					let items any[] = []
					let count = size
					let p = at
					for let i = 0; i < count; i++ {
						items.push(try value(p, depth + 1))
						p = try skip(p, depth + 1)
					}
					return items
				default:
					let pairs = map<string, any>{}
					let count = size
					let p = at
					for let i = 0; i < count; i++ {
						try read(p)
						fail "mmdb: a map key is not a string" when kind != 2
						let key = string(data[at:at + size])
						let valueAt = next
						pairs[key] = try value(valueAt, depth + 1)
						p = try skip(valueAt, depth + 1)
					}
					return pairs
			}
		}

		// The payload of the integer, double or float field last read as
		// big-endian bits; fewer bytes than the type's width are the low
		// ones.
		def unsigned() uint64 {
			let out = uint64(0)
			for let i = 0; i < size; i++ {
				out = (out << 8) | uint64(data[at + i])
			}
			return out
		}
	}

	// The keys of GeoIP2 and GeoLite2 records, as the bytes a map holds.
	internal let (
		keyAccuracyRadius    = "accuracy_radius".bytes()
		keyAsNumber          = "autonomous_system_number".bytes()
		keyAsOrganization    = "autonomous_system_organization".bytes()
		keyCity              = "city".bytes()
		keyCode              = "code".bytes()
		keyContinent         = "continent".bytes()
		keyCountry           = "country".bytes()
		keyGeonameId         = "geoname_id".bytes()
		keyInEuropeanUnion   = "is_in_european_union".bytes()
		keyIsoCode           = "iso_code".bytes()
		keyLatitude          = "latitude".bytes()
		keyLocation          = "location".bytes()
		keyLongitude         = "longitude".bytes()
		keyNames             = "names".bytes()
		keyPostal            = "postal".bytes()
		keyRegisteredCountry = "registered_country".bytes()
		keySubdivisions      = "subdivisions".bytes()
		keyTimeZone          = "time_zone".bytes()
	)

	// Where the metadata marker (`\xAB\xCD\xEFMaxMind.com`) last starts in
	// the file's final 128 KiB, the most the metadata may take; -1 when it
	// is not there.
	internal def metadataMarker(data byte[]) int {
		let marker = byte[0xAB, 0xCD, 0xEF, 0x4D, 0x61, 0x78, 0x4D, 0x69, 0x6E, 0x64, 0x2E, 0x63, 0x6F, 0x6D]
		let lowest = (data.len() - 131072 - 14).max(0)
		for let at = data.len() - 14; at >= lowest; at-- {
			continue when data[at] != marker[0]
			let same = true
			for let j = 1; j < 14 && same; j++ {
				same = data[at + j] == marker[j]
			}
			return at when same
		}
		return -1
	}

	// A number the metadata must have.
	internal def requiredNumber(head Cursor, root int, key string) !int {
		let at = try head.find(root, key.bytes())
		fail "mmdb: the metadata has no {key}" when at < 0
		return int(try head.number(at))
	}

	// A place the record does not have.
	internal def noPlace() Place {
		return Place{code: "", geonameId: 0, name: ""}
	}

	// The place stored in the map at the offset, named in the language.
	internal def place(records Cursor, from int, language byte[]) !Place {
		let out = noPlace()
		try records.read(from)
		fail "mmdb: a place of a record is not a map" when records.kind != 7
		let count = records.size
		let p = records.at
		for let i = 0; i < count; i++ {
			try records.read(p)
			fail "mmdb: a map key is not a string" when records.kind != 2
			let valueAt = records.next
			if records.named(keyIsoCode) || records.named(keyCode) {
				out.code = try records.text(valueAt)
			} else if records.named(keyGeonameId) {
				out.geonameId = int(try records.number(valueAt))
			} else if records.named(keyNames) {
				let name = try records.find(valueAt, language)
				out.name = try records.text(name) when name >= 0
			}
			p = try records.skip(valueAt, 0)
		}
		return out
	}

	// The 4 or 16 bytes of an address written as text.
	internal def addressBytes(text string) !byte[] {
		let parsed = parseIPText(text)
		fail "mmdb: `{text}` is not an IP address" when parsed is none
		return parsed
	}

	// The network of the address's first `prefix` bits as CIDR text.
	internal def networkText(address byte[], prefix int) string {
		let base = address.clone()
		for let i = 0; i < base.len(); i++ {
			let keep = (prefix - i * 8).max(0).min(8)
			base[i] = byte(int(base[i]) & ((0xFF << (8 - keep)) & 0xFF))
		}
		return "{ipText(base)}/{prefix}"
	}
}
