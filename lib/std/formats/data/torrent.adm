partial module std.formats.data {
	use (
		std.time
		std.io
	)

	// TorrentFile is one file of a torrent: its path inside the torrent and its
	// length.
	struct TorrentFile {
		path   string
		length uint64
	}

	// TorrentVerification is the outcome of checking a torrent's data: which
	// pieces are valid, invalid or missing.
	struct TorrentVerification {
		valid   uint[]
		invalid uint[]
		missing uint[]
	}

	// TorrentPiece is one piece of a torrent: its index, offset into the data,
	// length and hash.
	struct TorrentPiece {
		index  uint
		offset uint64
		length uint64
		hash   byte[]
	}

	// Torrent is a torrent metainfo file: its name, trackers, files and pieces.
	// Not implemented yet: every operation is a stub.
	type Torrent {
		name string {
			def get() string {
				return ""
			}

			def set(value string) {}
		}

		comment string {
			def get() string {
				return ""
			}

			def set(value string) {}
		}

		createdBy ?string {
			def get() ?string {
				return ""
			}

			def set(value ?string) {}
		}

		private bool {
			def get() bool {
				return false
			}

			def set(value bool) {}
		}

		createdAt ?time.Time {
			def get() ?time.Time {
				return none
			}

			def set(value ?time.Time) {}
		}

		pieceLength uint64 {
			def get() uint64 {
				return 0
			}

			def set(value uint64) {}
		}

		// load reads the torrent from the file at path. Not implemented yet. It cannot fail.
		def load(path string) !none {
			return none
		}

		// load reads the torrent from the reader. Not implemented yet. It cannot fail.
		def load(reader io.Reader) !none {
			return none
		}

		// save writes the torrent to the file at path. Not implemented yet. It cannot fail.
		def save(path string) !none {
			return none
		}

		// save writes the torrent to the writer. Not implemented yet. It cannot fail.
		def save(writer io.Writer) !none {
			return none
		}

		// trackers lists the tracker URLs. Not implemented yet.
		def trackers() string[] {
			return []
		}

		// addTracker adds a tracker URL. Not implemented yet. It cannot fail.
		def addTracker(url string) !none {
			return none
		}

		// removeTracker removes a tracker URL and reports whether it was there. Not implemented yet.
		def removeTracker(url string) bool {
			return false
		}

		// hasTracker reports whether the URL is among the trackers. Not implemented yet.
		def hasTracker(url string) bool {
			return false
		}

		// files lists the files the torrent describes. Not implemented yet.
		def files() TorrentFile[] {
			return []
		}

		// hasFile reports whether the path is among the files. Not implemented yet.
		def hasFile(path string) bool {
			return false
		}

		// addFile adds the file at source under path. Not implemented yet. It cannot fail.
		def addFile(source, path string) !none {
			return none
		}

		// removeFile removes the file at path. Not implemented yet. It cannot fail.
		def removeFile(path string) !none {
			return none
		}

		// file returns the file at path, none when there is none. Not implemented yet.
		def file(path string) ?TorrentFile {
			return none
		}

		// addDirectory adds the directory at source under path, with its files. Not implemented yet. It cannot fail.
		def addDirectory(source, path string) !none {
			return none
		}

		// removeDirectory removes the directory at path with its files. Not implemented yet. It cannot fail.
		def removeDirectory(path string) !none {
			return none
		}

		// pieceCount returns how many pieces the data is split into. Not implemented yet.
		def pieceCount() uint {
			return 0
		}

		// totalSize returns the total length of the files in bytes. Not implemented yet.
		def totalSize() uint64 {
			return 0
		}

		// infoHash returns the hash of the info dictionary. Not implemented yet.
		def infoHash() byte[] {
			return []
		}

		// build computes the pieces and info hash from the added files. Not implemented yet. It cannot fail.
		def build() !none {
			return none
		}

		// verify checks the data at source against the pieces. Fails, as it is not implemented yet.
		def verify(source string) !TorrentVerification {
			fail "not implemented"
		}

		// magnetLink renders the torrent as a magnet link. Not implemented yet.
		def magnetLink() string {
			return ""
		}

		// piece returns the piece at index, none when there is none. Not implemented yet.
		def piece(index uint) ?TorrentPiece {
			return none
		}
	}
}
