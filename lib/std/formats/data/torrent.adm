partial module std.formats.data {
	use (
		std.time
		std.io
	)

	struct TorrentFile {
		path   string
		length uint64
	}

	struct TorrentVerification {
		valid   uint[]
		invalid uint[]
		missing uint[]
	}

	struct TorrentPiece {
		index  uint
		offset uint64
		length uint64
		hash   byte[]
	}

	type Torrent {
		name string {
			def get() string {
				return ""
			}

			def set(value string) {}
		}

		comment string {
			def get() string {
				return ""
			}

			def set(value string) {}
		}

		createdBy ?string {
			def get() ?string {
				return ""
			}

			def set(value ?string) {}
		}

		private bool {
			def get() bool {
				return false
			}

			def set(value bool) {}
		}

		createdAt ?time.Time {
			def get() ?time.Time {
				return none
			}

			def set(value ?time.Time) {}
		}

		pieceLength uint64 {
			def get() uint64 {
				return 0
			}

			def set(value uint64) {}
		}

		def load(path string) !none {
			return none
		}

		def load(reader io.Reader) !none {
			return none
		}

		def save(path string) !none {
			return none
		}

		def save(writer io.Writer) !none {
			return none
		}

		def trackers() string[] {
			return []
		}

		def addTracker(url string) !none {
			return none
		}

		def removeTracker(url string) bool {
			return false
		}

		def hasTracker(url string) bool {
			return false
		}

		def files() TorrentFile[] {
			return []
		}

		def hasFile(path string) bool {
			return false
		}

		def addFile(source, path string) !none {
			return none
		}

		def removeFile(path string) !none {
			return none
		}

		def file(path string) ?TorrentFile {
			return none
		}

		def addDirectory(source, path string) !none {
			return none
		}

		def removeDirectory(path string) !none {
			return none
		}

		def pieceCount() uint {
			return 0
		}

		def totalSize() uint64 {
			return 0
		}

		def infoHash() byte[] {
			return []
		}

		def build() !none {
			return none
		}

		def verify(source string) !TorrentVerification {
			fail "not implemented"
		}

		def magnetLink() string {
			return ""
		}

		def piece(index uint) ?TorrentPiece {
			return none
		}
	}
}
