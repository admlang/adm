partial module std.formats.docs {
	use (
		std.bytes
		std.gfx.color
		std.io
		std.os
		std.time
	)

	// BlockKind names what a Block is. Each member lists the Block fields it uses;
	// the others keep their zero value.
	enum BlockKind {
		// The root of a document, or a nested group of blocks. Uses `children`.
		Section,
		// A title. Uses `level` (1 is the highest) and `inlines`.
		Heading,
		// A run of text. Uses `inlines`.
		Paragraph,
		// A list. Uses `ordered`, `start` and `children`, each an Item.
		List,
		// One entry of a List. Uses `children` and `checked`.
		Item,
		// A table. Uses `alignments` and `children`, each a Row.
		Table,
		// One row of a Table. Uses `header` and `children`, each a Cell.
		Row,
		// One cell of a Row. Uses `children`, `columnSpan` and `rowSpan`.
		Cell,
		// A picture standing on its own. Uses `source`, `title` and `inlines` as
		// the caption.
		Image,
		// Preformatted source text. Uses `language` and `content`.
		Code,
		// Quoted blocks. Uses `children`.
		Quote,
		// A horizontal rule.
		Rule,
		// A forced page break. Writers of unpaged formats leave it out.
		PageBreak,
		// Text in the syntax of one format, written only by that format's
		// encoder and left out by the others. Uses `format` and `content`.
		Raw,
	}

	// InlineKind names what an Inline is. Each member lists the Inline fields it
	// uses; the others keep their zero value.
	enum InlineKind {
		// Plain characters. Uses `content`.
		Text,
		// Uses `children`.
		Bold,
		// Uses `children`.
		Italic,
		// Uses `children`.
		Underline,
		// Uses `children`.
		Strike,
		// Inline source text. Uses `content`.
		Code,
		// A hyperlink. Uses `url`, `title` and `children`.
		Link,
		// A picture in the text flow. Uses `url` as the source, `title` and
		// `children` as the alternative text.
		Image,
		// Colored or role-styled text. Uses `foreground`, `background`, `role`
		// and `children`.
		Styled,
		// A line break inside a paragraph.
		LineBreak,
		// A note set apart from the text flow. Uses `note`.
		Footnote,
		// Text in the syntax of one format, written only by that format's
		// encoder. Uses `format` and `content`.
		Raw,
	}

	// Alignment is the horizontal placement of a block or a table column.
	enum Alignment {
		// Whatever the output format does by default.
		Default,
		Left,
		Center,
		Right,
		Justify,
	}

	// Document is format-neutral prose: metadata, a tree of blocks and the
	// binary resources the blocks refer to. Every codec of this module decodes
	// into a Document and encodes from one, so any format converts to any other.
	//
	// Example: Build and save
	// ```example
	// use std.formats.docs::(Document, bold, text)
	//
	// let doc = new Document("Report")
	// doc.heading(1, "Summary")
	// doc.paragraph(text("Revenue grew "), bold("12%"), text("."))
	// doc.table(["Region", "Sales"], [["North", "120"], ["South", "95"]])
	// try doc.save("report.html")
	// ```
	type Document {
		title     string
		authors   string[]
		// When the document was written, none when it does not say.
		date      ?time.Time
		// BCP 47 language tag, empty when unknown.
		language  string
		// Any other metadata the source carried: front matter keys, HTML meta
		// names, document properties.
		metadata  map<string, string>
		// The root block, a Section.
		body      Block
		// Embedded binary content by name, as Image blocks and inlines refer to
		// it through their source.
		resources map<string, byte[]>

		def new(title string = "") {
			self.title = title
			authors = string[]
			metadata = new map<string, string>()
			body = new Block(BlockKind.Section)
			resources = new map<string, byte[]>()
		}

		// blocks are the top-level blocks, the children of `body`.
		blocks Block[] {
			def get() Block[] {
				return body.children
			}
		}

		// heading appends a Heading to the body and returns it. See Block.heading.
		def heading(level int, content string) Block {
			return body.heading(level, content)
		}

		// paragraph appends a Paragraph of plain text to the body and returns it.
		def paragraph(content string) Block {
			return body.paragraph(content)
		}

		// paragraph appends a Paragraph made of the inlines to the body and returns it.
		def paragraph(parts ...Inline) Block {
			return body.paragraph(...parts)
		}

		// list appends a List with one Item per string to the body and returns it.
		def list(items string[], ordered bool = false) Block {
			return body.list(items, ordered)
		}

		// table appends a Table to the body and returns it. See Block.table.
		def table(header string[], rows string[][]) Block {
			return body.table(header, rows)
		}

		// image appends an Image to the body and returns it. See Block.image.
		def image(source string, caption string = "") Block {
			return body.image(source, caption)
		}

		// image stores the data as the resource `name`, appends an Image that
		// refers to it and returns the Image.
		def image(name string, data byte[], caption string = "") Block {
			resources.set(name, data)
			return body.image(name, caption)
		}

		// code appends a Code block to the body and returns it.
		def code(language string, content string) Block {
			return body.code(language, content)
		}

		// quote appends an empty Quote to the body and returns it, ready to be
		// filled.
		def quote() Block {
			return body.quote()
		}

		// rule appends a Rule to the body and returns it.
		def rule() Block {
			return body.rule()
		}

		// pageBreak appends a PageBreak to the body and returns it.
		def pageBreak() Block {
			return body.pageBreak()
		}

		// raw appends a Raw block to the body and returns it. See Block.raw.
		def raw(format string, content string) Block {
			return body.raw(format, content)
		}

		// save writes the document to the file, in the format of the path's
		// extension. Fails when no codec has the extension, or the file cannot
		// be written.
		def save(path string) !none {
			let out = new bytes.Buffer()
			try write(out, os.extension(path))
			return os.writeFile(path, out.bytes())
		}

		// write encodes the document to the writer with the codec registered for
		// the file extension (".md", ".html"). Fails when no codec has the
		// extension, or the writer does.
		def write(writer io.Writer, extension string) !none {
			let enc = codecRegistry.matchExt(extension)
			fail "no document codec has the extension \"{extension}\"" when enc is none
			return enc.encode(self, writer)
		}

		// resource returns the embedded content stored under the name, none when
		// there is none.
		def resource(name string) ?byte[] {
			return resources.get(name)
		}

		// walk visits every block in document order, parents before children,
		// until visit returns false.
		def walk(visit def (Block) bool) {
			for let (_, child) in body.children {
				return unless walkBlocks(child, visit)
			}
		}

		// headings returns every Heading in document order: the outline.
		def headings() Block[] {
			return collect(BlockKind.Heading)
		}

		// tables returns every Table at any depth, in document order.
		def tables() Block[] {
			return collect(BlockKind.Table)
		}

		// images returns every Image block at any depth, in document order.
		def images() Block[] {
			return collect(BlockKind.Image)
		}

		internal def collect(kind BlockKind) Block[] {
			let out = Block[]
			walk(def (block Block) bool {
				out.push(block) when block.kind == kind
				return true
			})
			return out
		}

		// plainText returns the text of the document with all formatting removed,
		// blocks separated by blank lines.
		def plainText() string {
			return body.plainText()
		}
	}

	// Block is a structural part of a document: a heading, a paragraph, a table
	// and so on, as `kind` says. Container kinds hold blocks in `children`, leaf
	// kinds hold text in `inlines` or `content`.
	type Block {
		kind       BlockKind
		// Heading depth, 1 to 6.
		level      int
		// Whether a List is numbered.
		ordered    bool
		// First number of an ordered List.
		start      int                 = 1
		// Task state of an Item: none when it is not a task.
		checked    ?bool
		// Whether a Row is a header row.
		header     bool
		// Columns a Cell covers.
		columnSpan int                 = 1
		// Rows a Cell covers.
		rowSpan    int                 = 1
		// Column alignments of a Table, one per column.
		alignments Alignment[]
		alignment  Alignment           = Alignment.Default
		// Language of a Code block, empty when unknown.
		language   string
		// Format a Raw block belongs to, as a file extension without the dot:
		// "html", "md".
		format     string
		// Text of a Code or Raw block.
		content    string
		// Where an Image comes from: a URL, a path, or a name in
		// Document.resources.
		source     string
		// Title of an Image.
		title      string
		// Named style: a paragraph style of a word processor, a class in HTML, a
		// theme role in a terminal.
		styleName  string
		// Format-specific attributes that have no field here, such as an HTML id.
		attributes map<string, string>
		inlines    Inline[]
		children   Block[]

		def new(kind BlockKind) {
			self.kind = kind
			alignments = Alignment[]
			attributes = new map<string, string>()
			inlines = Inline[]
			children = Block[]
		}

		// add appends the block to `children` and returns it.
		def add(block Block) Block {
			children.push(block)
			return block
		}

		// heading appends a Heading of plain text and returns it. The level is
		// clamped to 1..6.
		def heading(level int, content string) Block {
			let block = new Block(BlockKind.Heading)
			block.level = level.clamp(1, 6)
			block.inlines.push(text(content))
			return add(block)
		}

		// paragraph appends a Paragraph of plain text and returns it. The text is
		// taken as is, no markup is read from it.
		def paragraph(content string) Block {
			return paragraph(text(content))
		}

		// paragraph appends a Paragraph made of the inlines and returns it.
		def paragraph(parts ...Inline) Block {
			let block = new Block(BlockKind.Paragraph)
			block.inlines = parts
			return add(block)
		}

		// list appends a List with one Item per string and returns it.
		def list(items string[], ordered bool = false) Block {
			let block = new Block(BlockKind.List)
			block.ordered = ordered
			for let (_, entry) in items {
				block.item(entry)
			}
			return add(block)
		}

		// item appends an Item holding one Paragraph of plain text and returns the
		// Item. Meant for a List.
		def item(content string) Block {
			let block = new Block(BlockKind.Item)
			block.paragraph(content)
			return add(block)
		}

		// table appends a Table with one header Row and the given rows of plain
		// text cells, and returns it. Short rows are padded with empty cells.
		def table(header string[], rows string[][]) Block {
			let width = header.len()
			for let (_, cells) in rows {
				width = cells.len() when cells.len() > width
			}

			let block = new Block(BlockKind.Table)
			for let i = 0; i < width; i++ {
				block.alignments.push(Alignment.Default)
			}
			block.row(...padded(header, width)).header = true
			for let (_, cells) in rows {
				block.row(...padded(cells, width))
			}
			return add(block)
		}

		// row appends a Row of plain text cells and returns it. Meant for a Table.
		def row(cells ...string) Block {
			let block = new Block(BlockKind.Row)
			for let (_, entry) in cells {
				let cell = new Block(BlockKind.Cell)
				cell.paragraph(entry) unless entry == ""
				block.add(cell)
			}
			return add(block)
		}

		// cell returns the Cell at the row and column of a Table, both counted
		// from 0 with header rows included, none when outside the table.
		def cell(row int, column int) ?Block {
			return none when row < 0 || row >= children.len()
			let cells = children[row].children
			return none when column < 0 || column >= cells.len()
			return cells[column]
		}

		// columns returns the width of a Table: the cell count of its widest row.
		def columns() int {
			let width = 0
			for let (_, row) in children {
				width = row.children.len() when row.children.len() > width
			}
			return width
		}

		// image appends an Image and returns it. The source is a URL, a path or a
		// resource name.
		def image(source string, caption string = "") Block {
			let block = new Block(BlockKind.Image)
			block.source = source
			block.inlines.push(text(caption)) unless caption == ""
			return add(block)
		}

		// code appends a Code block and returns it.
		def code(language string, content string) Block {
			let block = new Block(BlockKind.Code)
			block.language = language
			block.content = content
			return add(block)
		}

		// quote appends an empty Quote and returns it.
		def quote() Block {
			return add(new Block(BlockKind.Quote))
		}

		// rule appends a Rule and returns it.
		def rule() Block {
			return add(new Block(BlockKind.Rule))
		}

		// pageBreak appends a PageBreak and returns it.
		def pageBreak() Block {
			return add(new Block(BlockKind.PageBreak))
		}

		// raw appends a Raw block and returns it. The format is a file extension
		// without the dot; only that format's encoder writes the content.
		def raw(format string, content string) Block {
			let block = new Block(BlockKind.Raw)
			block.format = format
			block.content = content
			return add(block)
		}

		// walk visits every inline of this block in order, parents before
		// children, until visit returns false. Blocks in `children` are not
		// entered.
		def walk(visit def (Inline) bool) {
			walkInlines(inlines, visit)
		}

		// plainText returns the text of the block and of everything below it with
		// all formatting removed.
		def plainText() string {
			match kind {
				case BlockKind.Code:
					return content
				case BlockKind.Raw, BlockKind.Rule, BlockKind.PageBreak:
					return ""
				case BlockKind.Section, BlockKind.Quote:
					return childText("\n\n")
				case BlockKind.Row:
					return childText("\t")
				case BlockKind.List, BlockKind.Item, BlockKind.Table, BlockKind.Cell:
					return childText("\n")
				default:
					return inlineText(inlines)
			}
		}

		// childText joins the text of the children that have any.
		internal def childText(separator string) string {
			let parts = string[]
			for let (_, child) in children {
				let part = child.plainText()
				parts.push(part) unless part == ""
			}
			return parts.join(separator)
		}
	}

	// Inline is a piece of text flow inside a block: characters, a formatted
	// span, a link and so on, as `kind` says.
	type Inline {
		kind       InlineKind
		// Characters of a Text, Code or Raw inline.
		content    string
		// Target of a Link, source of an Image.
		url        string
		// Title of a Link or Image.
		title      string
		// Text color of a Styled inline, none to keep the surrounding one.
		foreground ?color.Color
		// Background color of a Styled inline, none to keep the surrounding one.
		background ?color.Color
		// Theme role of a Styled inline, empty when it has none. An encoder that
		// knows the role styles the text by it, the others ignore it.
		role       string
		// Format a Raw inline belongs to. See Block.format.
		format     string
		// Blocks of a Footnote.
		note       Block[]
		children   Inline[]

		def new(kind InlineKind) {
			self.kind = kind
			note = Block[]
			children = Inline[]
		}

		// plainText returns the text of the inline and of everything below it
		// with all formatting removed. A Footnote contributes nothing.
		def plainText() string {
			match kind {
				case InlineKind.Text, InlineKind.Code:
					return content
				case InlineKind.LineBreak:
					return "\n"
				case InlineKind.Footnote, InlineKind.Raw:
					return ""
				default:
					return inlineText(children)
			}
		}
	}

	// text returns a Text inline holding the characters as they are.
	def text(content string) Inline {
		let inline = new Inline(InlineKind.Text)
		inline.content = content
		return inline
	}

	// bold returns a Bold inline around plain text.
	def bold(content string) Inline {
		return span(InlineKind.Bold, Inline[text(content)])
	}

	// bold returns a Bold inline around the parts.
	def bold(parts ...Inline) Inline {
		return span(InlineKind.Bold, parts)
	}

	// italic returns an Italic inline around plain text.
	def italic(content string) Inline {
		return span(InlineKind.Italic, Inline[text(content)])
	}

	// italic returns an Italic inline around the parts.
	def italic(parts ...Inline) Inline {
		return span(InlineKind.Italic, parts)
	}

	// underline returns an Underline inline around plain text.
	def underline(content string) Inline {
		return span(InlineKind.Underline, Inline[text(content)])
	}

	// underline returns an Underline inline around the parts.
	def underline(parts ...Inline) Inline {
		return span(InlineKind.Underline, parts)
	}

	// strike returns a Strike inline around plain text.
	def strike(content string) Inline {
		return span(InlineKind.Strike, Inline[text(content)])
	}

	// strike returns a Strike inline around the parts.
	def strike(parts ...Inline) Inline {
		return span(InlineKind.Strike, parts)
	}

	// code returns a Code inline holding the source text.
	def code(content string) Inline {
		let inline = new Inline(InlineKind.Code)
		inline.content = content
		return inline
	}

	// link returns a Link showing plain text.
	def link(content string, url string, title string = "") Inline {
		let inline = span(InlineKind.Link, Inline[text(content)])
		inline.url = url
		inline.title = title
		return inline
	}

	// colored returns a Styled inline around plain text with the text color and,
	// when given, the background color.
	def colored(content string, foreground color.Color, background ?color.Color = none) Inline {
		let inline = span(InlineKind.Styled, Inline[text(content)])
		inline.foreground = foreground
		inline.background = background
		return inline
	}

	// styled returns a Styled inline around plain text carrying the theme role.
	def styled(content string, role string) Inline {
		let inline = span(InlineKind.Styled, Inline[text(content)])
		inline.role = role
		return inline
	}

	// lineBreak returns a LineBreak inline.
	def lineBreak() Inline {
		return new Inline(InlineKind.LineBreak)
	}

	// footnote returns a Footnote holding one Paragraph of plain text.
	def footnote(content string) Inline {
		let paragraph = new Block(BlockKind.Paragraph)
		paragraph.inlines.push(text(content))

		let inline = new Inline(InlineKind.Footnote)
		inline.note.push(paragraph)
		return inline
	}

	// span returns an inline of the kind around the parts.
	internal def span(kind InlineKind, parts Inline[]) Inline {
		let inline = new Inline(kind)
		inline.children = parts
		return inline
	}

	// padded returns the cells extended with empty strings up to the width.
	internal def padded(cells string[], width int) string[] {
		let out = string[] + cells
		for out.len() < width {
			out.push("")
		}
		return out
	}

	// inlineText joins the plain text of the inlines.
	internal def inlineText(items Inline[]) string {
		let out = ""
		for let (_, item) in items {
			out += item.plainText()
		}
		return out
	}

	// walkBlocks visits the block, then its children. It returns false once
	// visit did, which ends the walk.
	internal def walkBlocks(block Block, visit def (Block) bool) bool {
		return false unless visit(block)
		for let (_, child) in block.children {
			return false unless walkBlocks(child, visit)
		}
		return true
	}

	// walkInlines visits each inline, then its children. It returns false once
	// visit did, which ends the walk.
	internal def walkInlines(items Inline[], visit def (Inline) bool) bool {
		for let (_, item) in items {
			return false unless visit(item)
			return false unless walkInlines(item.children, visit)
		}
		return true
	}
}
