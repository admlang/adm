partial module std.formats.docs {
	use (
		std.gfx.color
		std.testing
	)

	check "Document" {
		@test()
		def TestBuilders() {
			let doc = new Document("Report")
			doc.heading(9, "Summary")
			doc.paragraph(text("Revenue grew "), bold("12%"), text("."))
			doc.paragraph("Plain")
			doc.list(string["one", "two"], true)
			doc.code("adm", "let x = 1")
			doc.rule()
			doc.pageBreak()
			doc.raw("html", "<hr>")
			let quote = doc.quote()
			quote.paragraph("Quoted")

			assert doc.title == "Report"
			assert doc.blocks.len() == 9
			assert doc.blocks[0].kind == BlockKind.Heading
			assert doc.blocks[0].level == 6
			assert doc.blocks[1].inlines.len() == 3
			assert doc.blocks[1].inlines[1].kind == InlineKind.Bold
			assert doc.blocks[3].ordered
			assert doc.blocks[3].children.len() == 2
			assert doc.blocks[3].children[1].kind == BlockKind.Item
			assert doc.blocks[4].language == "adm"
			assert doc.blocks[7].format == "html"
			assert doc.blocks[8].children[0].plainText() == "Quoted"
		}

		@test()
		def TestTable() {
			let doc = new Document()
			let table = doc.table(string["Region", "Sales"], string[][string["North", "120", "extra"], string["South"]])

			assert table.columns() == 3
			assert table.children.len() == 3
			assert table.children[0].header
			assert !table.children[1].header
			assert table.alignments.len() == 3

			let north = table.cell(1, 0)
			assert !(north is none)
			assert north.plainText() == "North" unless north is none
			let padded = table.cell(2, 2)
			assert padded.children.len() == 0 unless padded is none
			assert table.cell(3, 0) is none
			assert table.cell(0, 3) is none
			assert table.cell(-1, 0) is none
			assert doc.tables().len() == 1
		}

		@test()
		def TestImagesAndResources() {
			let doc = new Document()
			doc.image("https://example.com/a.png", "Remote")
			doc.image("logo", byte[1, 2, 3], "Logo")

			assert doc.images().len() == 2
			assert doc.images()[0].source == "https://example.com/a.png"
			assert doc.images()[1].plainText() == "Logo"
			let stored = doc.resource("logo")
			assert stored.len() == 3 unless stored is none
			assert !(stored is none)
			assert doc.resource("missing") is none
		}

		@test()
		def TestWalkAndOutline() {
			let doc = new Document()
			doc.heading(1, "One")
			let quote = doc.quote()
			quote.heading(2, "Two")
			quote.paragraph("Body")
			doc.heading(2, "Three")

			let outline = doc.headings()
			assert outline.len() == 3
			assert outline[1].plainText() == "Two"

			let seen = 0
			doc.walk(def (block Block) bool {
				seen++
				return block.kind != BlockKind.Quote
			})
			assert seen == 2
		}

		@test()
		def TestInlines() {
			let red = new color.Color("red")
			let section = new Block(BlockKind.Section)
			let paragraph = section.paragraph(italic("a"), underline("b"), strike("c"), code("d"), link("e", "https://example.com", "Title"), colored("f", red), styled("g", "danger"), lineBreak(), footnote("hidden"), bold(italic("h"), text("i")))

			assert paragraph.plainText() == "abcdefg\nhi"
			assert paragraph.inlines[4].url == "https://example.com"
			assert paragraph.inlines[4].title == "Title"
			assert !(paragraph.inlines[5].foreground is none)
			assert paragraph.inlines[5].background is none
			assert paragraph.inlines[6].role == "danger"
			assert paragraph.inlines[8].note.len() == 1

			let kinds = InlineKind[]
			paragraph.walk(def (inline Inline) bool {
				kinds.push(inline.kind)
				return true
			})
			assert kinds.len() == 19
			assert kinds[0] == InlineKind.Italic
			assert kinds[1] == InlineKind.Text
		}

		@test()
		def TestPlainText() {
			let doc = new Document()
			doc.heading(1, "Title")
			doc.paragraph("First")
			doc.list(string["a", "b"])
			doc.table(string["k", "v"], string[][string["x", "1"]])
			doc.rule()
			doc.code("", "code")

			assert doc.plainText() == "Title\n\nFirst\n\na\nb\n\nk\tv\nx\t1\n\ncode"
		}
	}
}
