partial module std.formats.docs {
	use (
		std.bytes
		std.formats.docs.docx::*
		std.formats.container::(openPackage, zipStartsWith)
		std.io
	)

	// Docx is the Office Open XML codec, the format of Microsoft Word since
	// 2007 and the one most word processors save in.
	//
	// Decoding reads the package's main document: paragraphs with their
	// alignment and named style; headings from a "heading N" style or an
	// outline level; the title and subtitle from those styles; bulleted and
	// numbered lists from the numbering definitions, nested by level, with
	// their start numbers, `☐`/`☒` starting a task item; tables with header
	// rows and cells merged across and down, column alignments from the
	// cells; quotes from a "Quote" style; code from a code style ("Source
	// Code", "HTML Preformatted") or paragraphs all in a monospace font, runs
	// in one or in a verbatim style as code; bold, italic, underline, strike,
	// text, highlight and shading colors; hyperlinks (and HYPERLINK fields);
	// pictures, stored in `Document.resources` under their names in the
	// package; footnotes and endnotes; line and page breaks; an empty
	// paragraph with a bottom border as a Rule; a heading's bookmark as its
	// `attributes["id"]`; and the title, authors, subject, keywords,
	// description, category, creation date and language of the document
	// properties, the company from the application properties. Tracked
	// deletions, comments, headers, footers, text boxes and fields other than
	// links (their shown result is kept) are left out.
	//
	// Encoding writes a package Word and LibreOffice open: the same
	// constructs, with styles for headings, quotes, code, captions and
	// footnotes, one numbering instance per list, bordered tables, pictures
	// embedded at their pixel size (at most the text width) or linked when
	// they are not in the resources, and the metadata above. A quote's
	// nesting, blocks other than paragraphs and lists inside list items,
	// theme roles, footnotes inside footnotes and Raw content of formats
	// other than "docx" are left out; metadata other than those keys is not
	// written.
	//
	// Example: Extract the text
	// ```example
	// use std.formats.docs
	//
	// let doc = try docs.load("report.docx")
	// println(doc.plainText())
	// ```
	@codec("Office Open XML")
	type Docx {
		// Font of the text.
		font     string = "Calibri"
		// Font of code blocks and code spans.
		codeFont string = "Consolas"
		// Size of the text, in points. Headings and code are sized from it.
		fontSize int    = 11

		mimeType string[] {
			def get() string[] {
				return string["application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".docx", ".docm", ".dotx"]
			}
		}

		// matchSignature reports whether the reader is a zip archive whose
		// first entries include a part under `word/`.
		def matchSignature(r io.Reader) bool {
			return zipStartsWith(r, "word/")
		}

		// decode reads the whole reader as a DOCX package. Fails when the
		// reader does, or as decode(byte[]) does.
		def decode(reader io.Reader) !Document {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes())
		}

		// decode reads the bytes as a DOCX package. Fails when they are not a
		// zip archive, the package has no main document, or one of its parts
		// is not well-formed XML.
		def decode(data byte[]) !Document {
			let pkg = try openPackage(data)
			let reader = new DocxReader(pkg)
			return reader.read()
		}

		// encode writes the document as a DOCX package. Fails when the writer
		// does.
		def encode(doc Document, writer io.Writer) !none {
			try writer.write(try encode(doc))
		}

		// encode returns the document as the bytes of a DOCX package. Fails
		// only when the archive cannot be built.
		def encode(doc Document) !byte[] {
			let writer = new DocxWriter(doc, font, codeFont, fontSize)
			return writer.encode()
		}
	}
}
