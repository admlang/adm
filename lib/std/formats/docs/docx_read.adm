internal partial module std.formats.docs.docx {
	use (
		std.data.encoding::(XMLNode, XMLNodeKind)
		std.formats.docs.office::*
		std.formats.docs::*
		std.gfx.color
	)

	// Relationship is one entry of a part's relationships: its type, and the
	// part or URL it points to.
	struct Relationship {
		kind     string
		target   string
		external bool
	}

	// Style is what the reader needs of a style of styles.xml.
	type Style {
		name     string
		kind     string
		basedOn  string
		// Outline level, -1 when the style sets none.
		outline  int    = -1
		numId    string
		level    int
		marks    Marks
		// Whether the style sets its own character formatting.
		hasMarks bool

		def new() {}
	}

	// A list open while paragraphs are read: the List block, its level and
	// its numbering.
	type ListFrame {
		list  Block
		level int
		numId string

		def new(list Block, level int, numId string) {
			self.list = list
			self.level = level
			self.numId = numId
		}
	}

	// Flow is where the paragraphs of one container go: the container block,
	// the lists open in it, and the code block or quote the last paragraphs
	// joined.
	type Flow {
		parent Block
		lists  ListFrame[]
		code   ?Block
		quote  ?Block
		last   ?Block

		def new(parent Block) {
			self.parent = parent
			lists = ListFrame[]
		}

		def close() {
			lists = ListFrame[]
			code = none
			quote = none
		}

		def add(block Block) Block {
			close()
			parent.add(block)
			last = block
			return block
		}
	}

	// A field being read: its instruction, and the inlines of its result.
	type Field {
		instruction string
		result      Spans
		// Whether the separator has passed, so runs are the result.
		separated   bool

		def new() {
			result = new Spans()
		}
	}

	// Where the runs of a paragraph are read into.
	type RunState {
		// Parts of the paragraph between page breaks.
		segments Spans[]
		fields   Field[]
		inLink   bool
		bookmark string

		def new() {
			segments = Spans[new Spans()]
			fields = Field[]
		}

		def sink() Spans {
			if fields.len() > 0 {
				let top = fields[fields.len() - 1]
				return top.result
			}
			return segments[segments.len() - 1]
		}

		// collecting reports whether runs are a field instruction, whose text
		// is not shown.
		def collecting() bool {
			return fields.len() > 0 && !fields[fields.len() - 1].separated
		}
	}

	// DocxReader turns the parts of a DOCX package into a Document.
	type DocxReader {
		pkg          Package
		doc          Document
		main         string
		rels         map<string, Relationship>
		styles       map<string, Style>
		defaultStyle string
		// Levels of each abstract numbering: format and start, by level.
		formats      map<string, string[]>
		starts       map<string, int[]>
		// Abstract numbering of each numbering instance.
		nums         map<string, string>
		// Start overrides by numbering instance and level: "3:0".
		overrides    map<string, int>
		footnotes    map<string, XMLNode>
		endnotes     map<string, XMLNode>
		// Resource names of the image parts read so far.
		images       map<string, string>

		def new(pkg Package) {
			self.pkg = pkg
			doc = new Document()
			rels = new map<string, Relationship>()
			styles = new map<string, Style>()
			formats = new map<string, string[]>()
			starts = new map<string, int[]>()
			nums = new map<string, string>()
			overrides = new map<string, int>()
			footnotes = new map<string, XMLNode>()
			endnotes = new map<string, XMLNode>()
			images = new map<string, string>()
		}

		// read decodes the package. Fails when it has no main document part or
		// a part is not well-formed.
		def read() !Document {
			let packageRels = try relationships("")
			main = "word/document.xml"
			let coreName = "docProps/core.xml"
			let appName = "docProps/app.xml"
			for let (_, rel) in packageRels {
				if rel.kind.endsWith("/officeDocument") {
					main = rel.target
				} else if rel.kind.endsWith("/core-properties") {
					coreName = rel.target
				} else if rel.kind.endsWith("/extended-properties") {
					appName = rel.target
				}
			}
			let root = try pkg.xml(main)
			fail DocumentError{message: "docx: no main document part", format: "Office Open XML"} when root is none
			rels = try relationships(main)

			let partOf = def (kind string, fallback string) string {
				for let (_, rel) in rels {
					return rel.target when rel.kind.endsWith("/" + kind)
				}
				return resolve(main, fallback)
			}
			let stylesRoot = try pkg.xml(partOf("styles", "styles.xml"))
			readStyles(stylesRoot) unless stylesRoot is none
			let numbering = try pkg.xml(partOf("numbering", "numbering.xml"))
			readNumbering(numbering) unless numbering is none
			let notes = try pkg.xml(partOf("footnotes", "footnotes.xml"))
			readNotes(notes, footnotes) unless notes is none
			let ends = try pkg.xml(partOf("endnotes", "endnotes.xml"))
			readNotes(ends, endnotes) unless ends is none
			let core = try pkg.xml(coreName)
			readCore(core) unless core is none
			let app = try pkg.xml(appName)
			readApp(app) unless app is none

			let body = root.child("body")
			if !(body is none) {
				let flow = new Flow(doc.body)
				blocks(body, flow)
			}
			if doc.title == "" && doc.body.children.len() > 0 {
				let opening = doc.body.children[0]
				doc.title = opening.plainText() when opening.kind == BlockKind.Heading && opening.level == 1
			}
			return doc
		}

		// relationships reads the relationships of the part, the package's own
		// for an empty name. Targets are resolved to part names.
		def relationships(part string) !map<string, Relationship> {
			let out = new map<string, Relationship>()
			let name = folderOf(part) + "_rels/" + baseName(part) + ".rels"
			let root = try pkg.xml(name)
			return out when root is none
			for let (_, rel) in root.elements("Relationship") {
				let external = value(rel, "TargetMode") == "External"
				let target = value(rel, "Target")
				out.set(value(rel, "Id"), Relationship{kind: value(rel, "Type"), target: external ?? (target, resolve(part, target)), external: external})
			}
			return out
		}

		def readStyles(root XMLNode) {
			let defaults = root.child("docDefaults")
			if !(defaults is none) {
				for let (_, lang) in defaults.descendants("lang") {
					let tag = prop(lang, "val")
					doc.language = tag when tag != "" && doc.language == ""
				}
			}
			for let (_, node) in root.elements("style") {
				let entry = new Style()
				let id = prop(node, "styleId")
				entry.kind = prop(node, "type")
				let name = node.child("name")
				entry.name = name is none ?? (id, prop(name, "val"))
				let based = node.child("basedOn")
				entry.basedOn = based is none ?? ("", prop(based, "val"))
				let ppr = node.child("pPr")
				if !(ppr is none) {
					let outline = ppr.child("outlineLvl")
					entry.outline = prop(outline, "val").toInt<int>() unless outline is none
					let numPr = ppr.child("numPr")
					if !(numPr is none) {
						let numId = numPr.child("numId")
						entry.numId = prop(numId, "val") unless numId is none
						let ilvl = numPr.child("ilvl")
						entry.level = prop(ilvl, "val").toInt<int>() unless ilvl is none
					}
				}
				let rpr = node.child("rPr")
				if !(rpr is none) {
					entry.marks = runMarks(rpr, Marks{})
					entry.hasMarks = true
				}
				defaultStyle = id when entry.kind == "paragraph" && (value(node, "w:default") == "1" || value(node, "w:default") == "true")
				styles.set(id, entry)
			}
		}

		def readNumbering(root XMLNode) {
			for let (_, abstract) in root.elements("abstractNum") {
				let id = prop(abstract, "abstractNumId")
				let levelFormats = string["", "", "", "", "", "", "", "", ""]
				let levelStarts = int[1, 1, 1, 1, 1, 1, 1, 1, 1]
				for let (_, lvl) in abstract.elements("lvl") {
					let level = prop(lvl, "ilvl").toInt<int>()
					continue when level < 0 || level > 8
					let format = lvl.child("numFmt")
					levelFormats[level] = format is none ?? ("decimal", prop(format, "val"))
					let start = lvl.child("start")
					levelStarts[level] = prop(start, "val").toInt<int>() unless start is none
				}
				formats.set(id, levelFormats)
				starts.set(id, levelStarts)
			}
			for let (_, num) in root.elements("num") {
				let id = prop(num, "numId")
				let abstract = num.child("abstractNumId")
				nums.set(id, prop(abstract, "val")) unless abstract is none
				for let (_, override) in num.elements("lvlOverride") {
					let start = override.child("startOverride")
					overrides.set(id + ":" + prop(override, "ilvl"), prop(start, "val").toInt<int>()) unless start is none
				}
			}
		}

		def readNotes(root XMLNode, into map<string, XMLNode>) {
			for let (_, note) in root.children {
				continue unless note.kind == XMLNodeKind.Element
				let kind = prop(note, "type")
				continue when kind := "separator" || "continuationSeparator" || "continuationNotice"
				into.set(prop(note, "id"), note)
			}
		}

		def readCore(root XMLNode) {
			for let (_, node) in root.elements() {
				let content = node.text().trim()
				continue when content == ""
				match node.localName {
					case "title":
						doc.title = content
					case "creator":
						for let (_, name) in content.split(";") {
							doc.authors.push(name.trim()) unless name.trim() == ""
						}
					case "subject", "keywords", "description", "category":
						doc.metadata.set(node.localName, content)
					case "language":
						doc.language = content
					case "created":
						doc.date = dateOf(content)
				}
			}
		}

		def readApp(root XMLNode) {
			let company = root.child("Company")
			if !(company is none) {
				let name = company.text().trim()
				doc.metadata.set("company", name) unless name == ""
			}
		}

		// blocks reads the paragraphs and tables of a container.
		def blocks(container XMLNode, flow Flow) {
			for let (_, child) in container.children {
				continue unless child.kind == XMLNodeKind.Element
				match child.localName {
					case "p":
						paragraph(child, flow)
					case "tbl":
						flow.close()
						let made = table(child)
						flow.add(made) unless made is none
					case "sdt":
						let content = child.child("sdtContent")
						blocks(content, flow) unless content is none
					case "customXml", "ins", "smartTag":
						blocks(child, flow)
					case "AlternateContent":
						let choice = child.child("Choice")
						blocks(choice, flow) unless choice is none
				}
			}
		}

		// styleChain returns the style and those it is based on, nearest first.
		def styleChain(id string) Style[] {
			let out = Style[]
			let current = id == "" ?? (defaultStyle, id)
			for out.len() < 10 && current != "" {
				let entry = styles.get(current)
				break when entry is none
				out.push(entry)
				current = entry.basedOn
			}
			return out
		}

		def paragraph(p XMLNode, flow Flow) {
			let ppr = p.child("pPr")
			let styleId = ""
			let numId = ""
			let level = 0
			let outline = -1
			let alignment = Alignment.Default
			let breakBefore = false
			let indented = false
			let ruled = false
			if !(ppr is none) {
				let pstyle = ppr.child("pStyle")
				styleId = prop(pstyle, "val") unless pstyle is none
				let numPr = ppr.child("numPr")
				if !(numPr is none) {
					let id = numPr.child("numId")
					numId = id is none ?? ("", prop(id, "val"))
					let ilvl = numPr.child("ilvl")
					level = prop(ilvl, "val").toInt<int>() unless ilvl is none
				}
				let outlineLvl = ppr.child("outlineLvl")
				outline = prop(outlineLvl, "val").toInt<int>() unless outlineLvl is none
				let jc = ppr.child("jc")
				alignment = alignmentOf(prop(jc, "val")) unless jc is none
				let pageBefore = ppr.child("pageBreakBefore")
				breakBefore = !(pageBefore is none) && isOn(value(pageBefore, "w:val"))
				let ind = ppr.child("ind")
				if !(ind is none) {
					let left = prop(ind, "left")
					left = prop(ind, "start") when left == ""
					indented = left.toInt<int>() > 0
				}
				let border = ppr.child("pBdr")
				ruled = !(border is none) && !(border.child("bottom") is none)
			}
			let chain = styleChain(styleId)
			let styleName = chain.len() > 0 ?? (chain[0].name, "")
			for let (_, entry) in chain {
				if numId == "" && entry.numId != "" {
					numId = entry.numId
					level = entry.level
				}
				outline = entry.outline when outline < 0
			}
			let lower = styleName.lower()

			let state = new RunState()
			runs(p, state)
			flow.add(new Block(BlockKind.PageBreak)) when breakBefore
			for let (i, spans) in state.segments {
				let segment = spans.items
				flow.add(new Block(BlockKind.PageBreak)) when i > 0
				let items = tidyRuns(segment)
				if i > 0 {
					plain(items, flow, "", alignment)
					continue
				}
				if lower == "title" {
					doc.title = textOf(items).trim() when doc.title == ""
					continue
				}
				if lower == "subtitle" {
					doc.metadata.set("subtitle", textOf(items).trim())
					continue
				}
				let headingLevel = headingOf(lower, outline)
				if headingLevel > 0 && items.len() > 0 {
					let heading = new Block(BlockKind.Heading)
					heading.level = headingLevel
					heading.inlines = unwrap(items, InlineKind.Bold)
					heading.alignment = alignment
					heading.attributes.set("id", state.bookmark) unless state.bookmark == ""
					flow.add(heading)
					continue
				}
				if isCodeStyle(lower) || (items.len() > 0 && allCode(items)) {
					addCode(textOf(items), flow)
					continue
				}
				if lower := "quote" || "intense quote" || "block text" {
					let items2 = unwrap(items, InlineKind.Italic)
					continue when items2.len() == 0
					let quote = flow.quote
					if quote is none {
						let made = flow.add(new Block(BlockKind.Quote))
						flow.quote = made
						made.paragraph(...items2)
					} else {
						quote.paragraph(...items2)
					}
					continue
				}
				if lower == "caption" {
					let last = flow.last
					if !(last is none) && last.kind == BlockKind.Image {
						last.inlines = items
						continue
					}
				}
				if numId != "" && numId != "0" && nums.hasKey(numId) {
					listItem(items, numId, level, alignment, flow)
					continue
				}
				if items.len() == 0 {
					flow.add(new Block(BlockKind.Rule)) when ruled
					continue
				}
				if indented && flow.lists.len() > 0 {
					let frame = flow.lists[flow.lists.len() - 1]
					let items3 = frame.list.children
					if items3.len() > 0 {
						items3[items3.len() - 1].paragraph(...items)
						continue
					}
				}
				let kept = (lower == "normal" || lower == "body text" || lower == "list paragraph" || lower == "first paragraph" || lower == "compact" || styleName == "") ?? ("", styleName)
				plain(items, flow, kept, alignment)
			}
		}

		// plain adds a paragraph, or an Image block for a paragraph that is one
		// picture.
		def plain(items Inline[], flow Flow, styleName string, alignment Alignment) {
			return when items.len() == 0
			if items.len() == 1 && items[0].kind == InlineKind.Image {
				let image = new Block(BlockKind.Image)
				image.source = items[0].url
				image.title = items[0].title
				image.inlines = items[0].children
				image.alignment = alignment
				flow.add(image)
				return
			}
			let block = new Block(BlockKind.Paragraph)
			block.inlines = items
			block.styleName = styleName
			block.alignment = alignment
			flow.add(block)
		}

		def addCode(content string, flow Flow) {
			let open = flow.code
			if !(open is none) {
				open.content += "\n" + content
				return
			}
			let block = new Block(BlockKind.Code)
			block.content = content
			flow.add(block)
			flow.code = block
		}

		def listItem(items Inline[], numId string, level int, alignment Alignment, flow Flow) {
			flow.code = none
			flow.quote = none
			let lists = flow.lists
			for lists.len() > 0 && lists[lists.len() - 1].level > level {
				lists.pop()
			}
			lists.pop() when lists.len() > 0 && lists[lists.len() - 1].level == level && lists[lists.len() - 1].numId != numId
			if lists.len() == 0 || lists[lists.len() - 1].level < level {
				let list = new Block(BlockKind.List)
				let abstract = nums.get(numId)
				let format = "bullet"
				let start = 1
				if !(abstract is none) {
					let levelFormats = formats.get(abstract)
					format = levelFormats[level.clamp(0, 8)] unless levelFormats is none
					let levelStarts = starts.get(abstract)
					start = levelStarts[level.clamp(0, 8)] unless levelStarts is none
				}
				let override = overrides.get("{numId}:{level}")
				start = override unless override is none
				list.ordered = format != "bullet" && format != "none" && format != ""
				list.start = start
				if lists.len() == 0 {
					flow.parent.add(list)
					flow.last = list
				} else {
					let outer = lists[lists.len() - 1].list
					outer.add(new Block(BlockKind.Item)) when outer.children.len() == 0
					outer.children[outer.children.len() - 1].add(list)
				}
				lists.push(new ListFrame(list, level, numId))
			}
			let item = new Block(BlockKind.Item)
			let content = items
			if content.len() > 0 && content[0].kind == InlineKind.Text {
				let first = content[0].content
				for let (_, box) in string["☐ ", "☑ ", "☒ "] {
					if first.startsWith(box) {
						item.checked = box != "☐ "
						content = Inline[text(first[2:])] + content[1:]
						content = content[1:] when first.len() == 2
						break
					}
				}
			}
			if content.len() > 0 {
				let paragraph = item.paragraph(...content)
				paragraph.alignment = alignment
			}
			lists[lists.len() - 1].list.add(item)
		}

		def table(tbl XMLNode) ?Block {
			let table = new Block(BlockKind.Table)
			let origins = new map<int, Block>()
			for let (_, tr) in tbl.elements("tr") {
				let row = new Block(BlockKind.Row)
				let trPr = tr.child("trPr")
				if !(trPr is none) {
					let header = trPr.child("tblHeader")
					row.header = !(header is none) && isOn(value(header, "w:val"))
				}
				let column = 0
				for let (_, tc) in cellsOf(tr) {
					let span = 1
					let merge = ""
					let tcPr = tc.child("tcPr")
					if !(tcPr is none) {
						let gridSpan = tcPr.child("gridSpan")
						span = prop(gridSpan, "val").toInt<int>().clamp(1, 1000) unless gridSpan is none
						let vMerge = tcPr.child("vMerge")
						merge = vMerge is none ?? ("", prop(vMerge, "val") == "restart" ?? ("restart", "continue"))
					}
					if merge == "continue" {
						let origin = origins.get(column)
						if !(origin is none) {
							origin.rowSpan++
							column += span
							continue
						}
					}
					let cell = new Block(BlockKind.Cell)
					cell.columnSpan = span
					let flow = new Flow(cell)
					blocks(tc, flow)
					if merge == "restart" {
						origins.set(column, cell)
					} else {
						origins.delete(column)
					}
					row.add(cell)
					column += span
				}
				table.add(row) when row.children.len() > 0
			}
			return none when table.children.len() == 0
			let width = gridWidth(table)
			for let i = 0; i < width; i++ {
				table.alignments.push(Alignment.Default)
			}
			columnAlignments(table)
			return table
		}

		// cellsOf returns the cells of a row, those in content controls too.
		def cellsOf(tr XMLNode) XMLNode[] {
			let out = XMLNode[]
			for let (_, child) in tr.children {
				continue unless child.kind == XMLNodeKind.Element
				if child.localName == "tc" {
					out.push(child)
				} else if child.localName == "sdt" || child.localName == "customXml" {
					let content = child.child("sdtContent")
					out.push(...cellsOf(content is none ?? (child, content)))
				}
			}
			return out
		}

		// runs reads the inline content of a paragraph or of an element inside
		// one.
		def runs(node XMLNode, state RunState) {
			for let (_, child) in node.children {
				continue unless child.kind == XMLNodeKind.Element
				match child.localName {
					case "r":
						run(child, state)
					case "hyperlink":
						let id = prop(child, "id")
						let url = ""
						let rel = rels.get(id)
						url = rel.target unless id == "" || rel is none
						let anchor = prop(child, "anchor")
						url = "#" + anchor when url == "" && anchor != ""
						link(child, url, prop(child, "tooltip"), state)
					case "fldSimple":
						let target = hyperlinkTarget(prop(child, "instr"))
						if target == "" {
							runs(child, state)
						} else {
							link(child, target, "", state)
						}
					case "ins", "smartTag", "customXml", "dir", "bdo", "moveTo":
						runs(child, state)
					case "sdt":
						let content = child.child("sdtContent")
						runs(content, state) unless content is none
					case "AlternateContent":
						let choice = child.child("Choice")
						runs(choice, state) unless choice is none
					case "bookmarkStart":
						let name = prop(child, "name")
						state.bookmark = name when state.bookmark == "" && name != "" && !name.startsWith("_")
					case "oMath", "oMathPara":
						let math = ""
						for let (_, t) in child.descendants("t") {
							math += t.text()
						}
						state.sink().put(text(math)) unless math == ""
				}
			}
		}

		def link(node XMLNode, url string, title string, state RunState) {
			let inner = new RunState()
			inner.inLink = true
			runs(node, inner)
			let children = Inline[]
			for let (_, segment) in inner.segments {
				children.push(...segment.items)
			}
			if url == "" {
				for let (_, item) in children {
					state.sink().put(item)
				}
				return
			}
			let item = new Inline(InlineKind.Link)
			item.url = url
			item.title = title
			item.children = children
			state.sink().put(item)
		}

		// hyperlinkTarget returns the target of a HYPERLINK field instruction,
		// empty for any other field.
		def hyperlinkTarget(instruction string) string {
			let words = instruction.trim()
			return "" unless words.startsWith("HYPERLINK")
			let rest = words[9:].trim()
			let anchor = false
			let target = ""
			for rest != "" {
				if rest.startsWith("\\l") {
					anchor = true
					rest = rest[2:].trim()
					continue
				}
				if rest.startsWith("\\") {
					let space = rest.indexOf(" ")
					rest = space < 0 ?? ("", rest[space:].trim())
					if rest.startsWith("\"") {
						let close = rest.indexOf("\"", 1)
						rest = close < 0 ?? ("", rest[close + 1:].trim())
					}
					continue
				}
				let word = ""
				if rest.startsWith("\"") {
					let close = rest.indexOf("\"", 1)
					word = close < 0 ?? (rest[1:], rest[1:close])
					rest = close < 0 ?? ("", rest[close + 1:].trim())
				} else {
					let space = rest.indexOf(" ")
					word = space < 0 ?? (rest, rest[:space])
					rest = space < 0 ?? ("", rest[space:].trim())
				}
				return target + "#" + word when anchor
				target = word when target == ""
			}
			return target
		}

		def run(r XMLNode, state RunState) {
			let rpr = r.child("rPr")
			let marks = Marks{}
			if !(rpr is none) {
				let vanish = rpr.child("vanish")
				return when !(vanish is none) && isOn(propOrEmpty(vanish, "val"))
				let rstyle = rpr.child("rStyle")
				marks = characterStyle(prop(rstyle, "val")) unless (rstyle is none)
				marks = runMarks(rpr, marks)
			}
			marks = Marks{...marks, underline: false, foreground: none} when state.inLink
			for let (_, child) in r.children {
				continue unless child.kind == XMLNodeKind.Element
				if state.collecting() {
					if child.localName == "instrText" {
						let top = state.fields[state.fields.len() - 1]
						top.instruction += child.text()
					} else if child.localName == "fldChar" {
						field(prop(child, "fldCharType"), state)
					}
					continue
				}
				match child.localName {
					case "t":
						state.sink().add(child.text(), marks)
					case "tab", "ptab":
						state.sink().add("\t", marks)
					case "br":
						let kind = prop(child, "type")
						if kind == "page" && state.fields.len() == 0 {
							state.segments.push(new Spans())
						} else if kind != "column" {
							state.sink().put(lineBreak())
						}
					case "cr":
						state.sink().put(lineBreak())
					case "noBreakHyphen":
						state.sink().add("-", marks)
					case "sym":
						let code = prop(child, "char").toInt<int>(16)
						code = code - 0xF000 when code >= 0xF000
						state.sink().add(string(char(code)), marks) when code > 0x20
					case "drawing", "pict", "object":
						let image = picture(child)
						state.sink().place(image, marks) unless image is none
					case "footnoteReference":
						state.sink().put(note(footnotes, prop(child, "id")))
					case "endnoteReference":
						state.sink().put(note(endnotes, prop(child, "id")))
					case "fldChar":
						field(prop(child, "fldCharType"), state)
					case "AlternateContent":
						let choice = child.child("Choice")
						if !(choice is none) {
							let image = picture(choice)
							state.sink().place(image, marks) unless image is none
						}
				}
			}
		}

		def field(kind string, state RunState) {
			match kind {
				case "begin":
					state.fields.push(new Field())
				case "separate":
					state.fields[state.fields.len() - 1].separated = true when state.fields.len() > 0
				case "end":
					return when state.fields.len() == 0
					let done = state.fields.pop()
					let target = hyperlinkTarget(done.instruction)
					if target == "" {
						for let (_, item) in done.result.items {
							state.sink().put(item)
						}
						return
					}
					let item = new Inline(InlineKind.Link)
					item.url = target
					for let (_, child) in done.result.items {
						item.children.push(withoutLinkLook(child))
					}
					state.sink().put(item)
			}
		}

		// withoutLinkLook drops the underline and color a hyperlink field's
		// result is set in.
		def withoutLinkLook(item Inline) Inline {
			return item.children.len() == 1 ?? (withoutLinkLook(item.children[0]), item) when item.kind == InlineKind.Underline || (item.kind == InlineKind.Styled && item.role == "")
			return item
		}

		def note(notes map<string, XMLNode>, id string) Inline {
			let footnote = new Inline(InlineKind.Footnote)
			let body = notes.get(id)
			return footnote when body is none
			let holder = new Block(BlockKind.Section)
			let flow = new Flow(holder)
			blocks(body, flow)
			footnote.note = holder.children
			return footnote
		}

		// picture returns the Image inline of a drawing, none when it refers to
		// no picture of the package.
		def picture(node XMLNode) ?Inline {
			let blips = node.descendants("blip")
			let id = ""
			if blips.len() > 0 {
				id = prop(blips[0], "embed")
				id = prop(blips[0], "link") when id == ""
			} else {
				let data = node.descendants("imagedata")
				id = prop(data[0], "id") when data.len() > 0
			}
			return none when id == ""
			let rel = rels.get(id)
			return none when rel is none
			let image = new Inline(InlineKind.Image)
			if rel.external {
				image.url = rel.target
			} else {
				let name = images.get(rel.target)
				if name is none {
					let data = pkg.read(rel.target) onerror recover none
					return none when data is none
					let base = baseName(rel.target)
					let unique = base
					let n = 2
					for doc.resources.hasKey(unique) {
						unique = "{n}-{base}"
						n++
					}
					doc.resources.set(unique, data)
					images.set(rel.target, unique)
					image.url = unique
				} else {
					image.url = name
				}
			}
			let props = node.descendants("docPr")
			if props.len() > 0 {
				let alt = prop(props[0], "descr").trim()
				image.children.push(text(alt)) unless alt == ""
				image.title = prop(props[0], "title")
			}
			return image
		}

		// characterStyle returns the marks of a character style: its own
		// formatting, and code for the styles of verbatim text.
		def characterStyle(id string) Marks {
			let marks = Marks{}
			let chain = styleChain(id)
			for let i = chain.len() - 1; i >= 0; i-- {
				let entry = chain[i]
				let name = entry.name.lower()
				if name := "hyperlink" || "default paragraph font" {
					continue
				}
				marks = combine(marks, entry.marks) when entry.hasMarks
				marks = Marks{...marks, code: true} when name := "verbatim char" || "html code" || "source code" || "code"
				marks = Marks{...marks, bold: true} when name == "strong"
				marks = Marks{...marks, italic: true} when name == "emphasis"
			}
			return marks
		}
	}

	// combine returns the marks with those set in `over` added.
	def combine(base Marks, over Marks) Marks {
		let foreground = over.foreground
		foreground = base.foreground when foreground is none
		let background = over.background
		background = base.background when background is none
		return Marks{bold: base.bold || over.bold, italic: base.italic || over.italic, underline: base.underline || over.underline, strike: base.strike || over.strike, code: base.code || over.code, foreground: foreground, background: background}
	}

	// runMarks returns the marks with the character properties applied.
	def runMarks(rpr XMLNode, base Marks) Marks {
		let marks = base
		for let (_, child) in rpr.children {
			continue unless child.kind == XMLNodeKind.Element
			let on = isOn(propOrEmpty(child, "val"))
			match child.localName {
				case "b":
					marks = Marks{...marks, bold: on}
				case "i":
					marks = Marks{...marks, italic: on}
				case "u":
					let kind = prop(child, "val")
					marks = Marks{...marks, underline: kind != "none" && kind != "0"}
				case "strike", "dstrike":
					marks = Marks{...marks, strike: on}
				case "color":
					let found = hexColor(prop(child, "val"))
					marks = Marks{...marks, foreground: found} unless found is none
				case "highlight":
					let found = highlightColor(prop(child, "val"))
					marks = Marks{...marks, background: found} unless found is none
				case "shd":
					let found = hexColor(prop(child, "fill"))
					marks = Marks{...marks, background: found} unless found is none
				case "rFonts":
					let font = prop(child, "ascii")
					font = prop(child, "hAnsi") when font == ""
					marks = Marks{...marks, code: isMonospace(font)} unless font == ""
			}
		}
		return marks
	}

	// highlightColor returns the color of a highlight name, none for "none".
	def highlightColor(name string) ?color.Color {
		let names = string["yellow FFFF00", "green 00FF00", "cyan 00FFFF", "magenta FF00FF", "blue 0000FF", "red FF0000", "darkBlue 000080", "darkCyan 008080", "darkGreen 008000", "darkMagenta 800080", "darkRed 800000", "darkYellow 808000", "darkGray 808080", "lightGray C0C0C0", "black 000000", "white FFFFFF"]
		for let (_, entry) in names {
			let space = entry.indexOf(" ")
			return hexColor(entry[space + 1:]) when entry[:space] == name
		}
		return none
	}

	// isOn reads an on/off value; a missing one is on.
	def isOn(value string) bool {
		return !(value == "0" || value == "false" || value == "off" || value == "none")
	}

	def alignmentOf(value string) Alignment {
		match value {
			case "left", "start":
				return Alignment.Left
			case "center":
				return Alignment.Center
			case "right", "end":
				return Alignment.Right
			case "both", "distribute", "justify":
				return Alignment.Justify
			default:
				return Alignment.Default
		}
	}

	// headingOf returns the heading level of a paragraph by its entry name
	// and outline level, 0 when it is no heading.
	def headingOf(styleName string, outline int) int {
		if styleName.startsWith("heading ") && styleName.len() == 9 {
			let level = int(styleName[8]) - int('0')
			return level when level >= 1 && level <= 9
		}
		return outline + 1 when outline >= 0 && outline <= 5
		return 0
	}

	def isCodeStyle(styleName string) bool {
		return styleName == "source code" || styleName == "html preformatted" || styleName == "code" || styleName == "macro text" || styleName == "plain text"
	}
}
