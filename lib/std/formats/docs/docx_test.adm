partial module std.formats.docs {
	use (
		std.bytes
		std.data.encoding::(XML)
		std.formats.archive::(CompressionLevel, Entry, WriteOptions, Zip)
		std.gfx.color
		std.testing
	)

	check "Docx" {
		// docxSample builds a document with the constructs DOCX keeps.
		internal def docxSample() Document {
			let doc = new Document("Quarterly Report")
			doc.authors.push("Ann Lee", "Bo Chen")
			doc.metadata.set("subject", "Sales")
			doc.metadata.set("company", "ACME")
			doc.language = "de-DE"
			doc.heading(1, "Summary").attributes.set("id", "summary")
			doc.paragraph(text("Revenue "), bold("grew"), text(" by "), italic(text("a "), bold("lot")), text(", "), strike("not"), text(" see "), link("the site", "https://a.example/x?q=1&r=2", "Home"), text(" and "), code("x<y>"), text(" "), underline("under"), text(" "), link("back", "#summary"), text("."))
			doc.paragraph(text("Colors: "), colored("red", new color.Color(color.RGBA{r: 255, g: 0, b: 0, a: 255})), text(" and "), text("Ünïcødé — 😀 <&>"), lineBreak(), text("next\tline"), footnote("A note."))
			doc.paragraph("centered").alignment = Alignment.Center
			doc.paragraph("styled").styleName = "Fancy"
			doc.heading(2, "Lists")
			let items = doc.list(string["one", "two"])
			items.children[0].list(string["nested a", "nested b"], true).start = 4
			let tasks = doc.list(string["done", "open"])
			tasks.children[0].checked = true
			tasks.children[1].checked = false
			doc.list(string["ninth", "tenth"], true).start = 9
			let quote = doc.quote()
			quote.paragraph("quoted")
			quote.paragraph("again")
			doc.code("", "func main() \{\n\tprintln(1)\n\}")
			doc.rule()
			let table = doc.table(string["Region", "Sales", "Note"], string[][string["North", "120", "a"], string["South", "95", "b"], string["East", "7"]])
			table.alignments[1] = Alignment.Right
			table.children[1].children[2].rowSpan = 2
			table.children[3].children[0].columnSpan = 2
			table.children[3].children.pop()
			table.children[2].children.pop()
			doc.pageBreak()
			doc.image("chart.png", byte[0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 13, 0x49, 0x48, 0x44, 0x52, 0, 0, 0, 2, 0, 0, 0, 3], "The chart")
			doc.paragraph("last")
			return doc
		}

		@test()
		def TestRoundTrip() !none {
			let codec = new Docx()
			let doc = docxSample()
			let encoded = try codec.encode(doc)
			let back = try codec.decode(encoded)

			assert back.title == doc.title
			assert back.authors.join("|") == "Ann Lee|Bo Chen"
			assert back.metadata.len() == 2 && back.metadata["subject"] == "Sales" && back.metadata["company"] == "ACME"
			assert back.language == "de-DE"
			let markdown = new Markdown()
			assert markdown.encode(back) == markdown.encode(doc).replace("chart.png", "image1.png")
			assert back.blocks[0].attributes["id"] == "summary"
			assert back.blocks[3].alignment == Alignment.Center
			assert back.blocks[4].styleName == "Fancy"
			let table = back.tables()[0]
			assert table.alignments[1] == Alignment.Right
			assert table.children[1].children[2].rowSpan == 2
			assert table.children[3].children[0].columnSpan == 2
			let data = back.resource("image1.png")
			fail "no picture" when data is none
			assert data.len() == 24
			let again = try codec.encode(back)
			assert markdown.encode(try codec.decode(again)) == markdown.encode(back)
			return none
		}

		@test()
		def TestPackageParts() !none {
			let encoded = try new Docx().encode(docxSample())
			let arc = try new Zip().open(new bytes.Reader(encoded))
			let names = string[]
			for let (_, entry) in arc.entries() {
				names.push(entry.name)
			}
			assert names.join(",") == "[Content_Types].xml,_rels/.rels,docProps/core.xml,docProps/app.xml,word/document.xml,word/_rels/document.xml.rels,word/styles.xml,word/settings.xml,word/numbering.xml,word/footnotes.xml,word/media/image1.png"
			let entry = arc.entry("word/document.xml")
			fail "no document" when entry is none
			let content = new bytes.Buffer()
			try content.readFrom(try arc.open(entry))
			let root = try new XML().parse(content.bytes())
			assert root.namespace == "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
			assert !(root.child("body") is none)
			return none
		}

		// part adds an entry of text to the zip writer.
		internal def part(names string[], contents string[], name string, content string) {
			names.push(name)
			contents.push(content)
		}

		// buildPackage builds a DOCX package from parts given as text.
		internal def buildPackage(names string[], contents string[]) !byte[] {
			let out = new bytes.Buffer()
			let zip = try new Zip().create(out, WriteOptions{level: CompressionLevel.Default})
			for let (i, name) in names {
				try zip.add(Entry{name: name, attributes: new map<string, string>()}, new bytes.Reader(contents[i].bytes()))
			}
			try zip.close()
			return out.bytes()
		}

		@test()
		def TestDecodeWordFeatures() !none {
			let w = "xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\""
			let names = string[]
			let contents = string[]
			part(names, contents, "[Content_Types].xml", "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"/>")
			part(names, contents, "_rels/.rels", "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"/word/main.xml\"/><Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties\" Target=\"docProps/core.xml\"/></Relationships>")
			part(names, contents, "word/_rels/main.xml.rels", "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId7\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/hyperlink\" Target=\"https://example.com/\" TargetMode=\"External\"/><Relationship Id=\"rId8\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/><Relationship Id=\"rId9\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/numbering\" Target=\"numbering.xml\"/><Relationship Id=\"rId10\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/footnotes\" Target=\"footnotes.xml\"/></Relationships>")
			part(names, contents, "word/styles.xml", "<w:styles {w}><w:docDefaults><w:rPrDefault><w:rPr><w:lang w:val=\"fr-FR\"/></w:rPr></w:rPrDefault></w:docDefaults><w:style w:type=\"paragraph\" w:default=\"1\" w:styleId=\"Normal\"><w:name w:val=\"Normal\"/></w:style><w:style w:type=\"paragraph\" w:styleId=\"Titre2\"><w:name w:val=\"heading 2\"/><w:basedOn w:val=\"Normal\"/></w:style><w:style w:type=\"paragraph\" w:styleId=\"Plan\"><w:name w:val=\"Plan\"/><w:pPr><w:outlineLvl w:val=\"2\"/></w:pPr></w:style><w:style w:type=\"paragraph\" w:styleId=\"Code\"><w:name w:val=\"HTML Preformatted\"/></w:style><w:style w:type=\"character\" w:styleId=\"Fort\"><w:name w:val=\"Strong\"/></w:style></w:styles>")
			part(names, contents, "word/numbering.xml", "<w:numbering {w}><w:abstractNum w:abstractNumId=\"0\"><w:lvl w:ilvl=\"0\"><w:start w:val=\"1\"/><w:numFmt w:val=\"bullet\"/></w:lvl><w:lvl w:ilvl=\"1\"><w:start w:val=\"1\"/><w:numFmt w:val=\"lowerLetter\"/></w:lvl></w:abstractNum><w:num w:numId=\"5\"><w:abstractNumId w:val=\"0\"/><w:lvlOverride w:ilvl=\"1\"><w:startOverride w:val=\"3\"/></w:lvlOverride></w:num></w:numbering>")
			part(names, contents, "word/footnotes.xml", "<w:footnotes {w}><w:footnote w:type=\"separator\" w:id=\"-1\"><w:p><w:r><w:separator/></w:r></w:p></w:footnote><w:footnote w:id=\"1\"><w:p><w:r><w:footnoteRef/></w:r><w:r><w:t xml:space=\"preserve\"> Note text.</w:t></w:r></w:p></w:footnote></w:footnotes>")
			part(names, contents, "docProps/core.xml", "<cp:coreProperties xmlns:cp=\"http://schemas.openxmlformats.org/package/2006/metadata/core-properties\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:dcterms=\"http://purl.org/dc/terms/\"><dc:title>Rapport</dc:title><dc:creator>Zoé; Luc</dc:creator><cp:keywords>a, b</cp:keywords><dcterms:created>2026-09-21T10:00:00Z</dcterms:created></cp:coreProperties>")
			let body = "<w:p><w:pPr><w:pStyle w:val=\"Titre2\"/></w:pPr><w:bookmarkStart w:id=\"0\" w:name=\"_Toc1\"/><w:bookmarkStart w:id=\"1\" w:name=\"intro\"/><w:r><w:rPr><w:b/></w:rPr><w:t>Intro</w:t></w:r></w:p>"
			body += "<w:p><w:pPr><w:pStyle w:val=\"Plan\"/></w:pPr><w:r><w:t>Deep</w:t></w:r></w:p>"
			body += "<w:p><w:r><w:t xml:space=\"preserve\">Go </w:t></w:r><w:hyperlink r:id=\"rId7\"><w:r><w:rPr><w:rStyle w:val=\"Hyperlink\"/><w:u w:val=\"single\"/><w:color w:val=\"0000FF\"/></w:rPr><w:t>there</w:t></w:r></w:hyperlink><w:r><w:t xml:space=\"preserve\"> or </w:t></w:r><w:r><w:fldChar w:fldCharType=\"begin\"/></w:r><w:r><w:instrText xml:space=\"preserve\"> HYPERLINK \\l \"intro\" </w:instrText></w:r><w:r><w:fldChar w:fldCharType=\"separate\"/></w:r><w:r><w:t>up</w:t></w:r><w:r><w:fldChar w:fldCharType=\"end\"/></w:r><w:r><w:rPr><w:rStyle w:val=\"Fort\"/></w:rPr><w:t xml:space=\"preserve\"> strong</w:t></w:r><w:r><w:rPr><w:i/><w:b w:val=\"0\"/></w:rPr><w:t xml:space=\"preserve\"> it</w:t></w:r><w:r><w:rPr><w:highlight w:val=\"yellow\"/></w:rPr><w:t xml:space=\"preserve\"> lit</w:t></w:r><w:r><w:rPr><w:vanish/></w:rPr><w:t>hidden</w:t></w:r><w:del><w:r><w:delText>gone</w:delText></w:r></w:del><w:ins><w:r><w:t xml:space=\"preserve\"> new</w:t></w:r></w:ins><w:r><w:footnoteReference w:id=\"1\"/></w:r></w:p>"
			body += "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"5\"/></w:numPr></w:pPr><w:r><w:t>first</w:t></w:r></w:p>"
			body += "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"1\"/><w:numId w:val=\"5\"/></w:numPr></w:pPr><w:r><w:t>sub</w:t></w:r></w:p>"
			body += "<w:p><w:pPr><w:numPr><w:ilvl w:val=\"0\"/><w:numId w:val=\"5\"/></w:numPr></w:pPr><w:r><w:t>☒ second</w:t></w:r></w:p>"
			body += "<w:p><w:pPr><w:pStyle w:val=\"Code\"/></w:pPr><w:r><w:t>a = 1</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val=\"Code\"/></w:pPr><w:r><w:t>b = 2</w:t></w:r></w:p>"
			body += "<w:tbl><w:tblGrid><w:gridCol/><w:gridCol/><w:gridCol/></w:tblGrid><w:tr><w:trPr><w:tblHeader/></w:trPr><w:tc><w:tcPr><w:gridSpan w:val=\"2\"/></w:tcPr><w:p><w:r><w:t>AB</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:vMerge w:val=\"restart\"/></w:tcPr><w:p><w:r><w:t>C</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:p><w:pPr><w:jc w:val=\"right\"/></w:pPr><w:r><w:t>1</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>2</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:vMerge/></w:tcPr><w:p/></w:tc></w:tr></w:tbl>"
			body += "<w:p><w:r><w:rPr><w:rFonts w:ascii=\"Courier New\"/></w:rPr><w:t>mono</w:t></w:r></w:p>"
			body += "<w:p><w:r><w:t>before</w:t></w:r><w:r><w:br w:type=\"page\"/><w:t>after</w:t></w:r></w:p>"
			body += "<w:sdt><w:sdtContent><w:p><w:r><w:t>in control</w:t></w:r></w:p></w:sdtContent></w:sdt>"
			part(names, contents, "word/main.xml", "<w:document {w}><w:body>{body}<w:sectPr/></w:body></w:document>")

			let doc = try new Docx().decode(try buildPackage(names, contents))
			assert doc.title == "Rapport"
			assert doc.authors.join("|") == "Zoé|Luc"
			assert doc.metadata["keywords"] == "a, b"
			assert doc.language == "fr-FR"
			let date = doc.date
			assert !(date is none)
			let kinds = string[]
			for let (_, block) in doc.blocks {
				kinds.push("{block.kind}")
			}
			assert kinds.join(",") == "Heading,Heading,Paragraph,List,Code,Table,Code,Paragraph,PageBreak,Paragraph,Paragraph"
			let intro = doc.blocks[0]
			assert intro.level == 2
			assert intro.attributes["id"] == "intro"
			assert intro.inlines.len() == 1 && intro.inlines[0].kind == InlineKind.Text
			assert doc.blocks[1].level == 3

			let para = doc.blocks[2]
			assert para.plainText() == "Go there or up strong it lit new"
			assert para.inlines[1].kind == InlineKind.Link && para.inlines[1].url == "https://example.com/"
			assert para.inlines[1].children[0].kind == InlineKind.Text
			assert para.inlines[3].kind == InlineKind.Link && para.inlines[3].url == "#intro"
			assert para.inlines[4].kind == InlineKind.Bold
			assert para.inlines[5].kind == InlineKind.Italic
			assert para.inlines[6].kind == InlineKind.Styled
			let last = para.inlines[para.inlines.len() - 1]
			assert last.kind == InlineKind.Footnote && last.note[0].plainText() == "Note text."

			let list = doc.blocks[3]
			assert !list.ordered
			assert list.children.len() == 2
			let nested = list.children[0].children[1]
			assert nested.kind == BlockKind.List && nested.ordered && nested.start == 3
			let second = list.children[1]
			assert !(second.checked is none)
			assert second.plainText() == "second"

			assert doc.blocks[4].content == "a = 1\nb = 2"
			assert doc.blocks[6].content == "mono"
			let table = doc.blocks[5]
			assert table.children[0].header
			assert table.children[0].children[0].columnSpan == 2
			assert table.children[0].children[1].rowSpan == 2
			assert table.children[1].children.len() == 2
			assert table.alignments[0] == Alignment.Right
			assert doc.blocks[7].plainText() == "before"
			assert doc.blocks[9].plainText() == "after"
			assert doc.blocks[10].plainText() == "in control"
			return none
		}

		@test()
		def TestSignatureAndLoad() !none {
			let codec = new Docx()
			let encoded = try codec.encode(docxSample())
			assert codec.matchSignature(new bytes.Reader(encoded))
			assert !codec.matchSignature(new bytes.Reader("PK\u0003\u0004 not really".bytes()))
			let doc = try load(encoded)
			assert doc.title == "Quarterly Report"
			let failed = false
			codec.decode("not a zip".bytes()) onerror (err error) {
				failed = true
				recover new Document()
			}
			assert failed
			return none
		}
	}
}
