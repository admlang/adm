internal partial module std.formats.docs.docx {
	use (
		std.data.encoding::(XMLWriter)
		std.formats.docs.office::*
		std.formats.container::*
		std.formats.docs::*
		std.os
	)

	const nsW = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
	const nsR = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
	const relBase = "http://schemas.openxmlformats.org/officeDocument/2006/relationships/"

	// Relationships of one part being written, and the ids handed out.
	type PartRels {
		ids       string[]
		kinds     string[]
		targets   string[]
		externals bool[]
		byTarget  map<string, string>

		def new() {
			ids = string[]
			kinds = string[]
			targets = string[]
			externals = bool[]
			byTarget = new map<string, string>()
		}

		// add returns the id of the relationship, adding it when it is new.
		def add(kind string, target string, external bool) string {
			let key = kind + " " + target
			let known = byTarget.get(key)
			return known unless known is none
			let id = "rId{ids.len() + 1}"
			ids.push(id)
			kinds.push(kind)
			targets.push(target)
			externals.push(external)
			byTarget.set(key, id)
			return id
		}

		def xml() string {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("Relationships")
			w.attribute("xmlns", "http://schemas.openxmlformats.org/package/2006/relationships")
			for let (i, id) in ids {
				w.start("Relationship")
				w.attribute("Id", id)
				w.attribute("Type", relBase + kinds[i])
				w.attribute("Target", targets[i])
				w.attribute("TargetMode", "External") when externals[i]
				w.end()
			}
			return w.str()
		}
	}

	// A numbering instance the document uses: which list kind, and the level
	// and number it starts at.
	struct Numbering {
		ordered bool
		level   int
		start   int
	}

	// DocxWriter writes a Document as a DOCX package.
	type DocxWriter {
		doc       Document
		font      string
		codeFont  string
		fontSize  int
		body      XMLWriter
		notes     XMLWriter
		// Relationships of the part being written: the document or the notes.
		mainRels  PartRels
		noteRels  PartRels
		inNote    bool
		noteCount int
		numbering Numbering[]
		// Media part of each resource written.
		media     map<string, string>
		mediaExts string[]
		styleIds  map<string, string>
		pictures  int
		bookmarks int

		def new(doc Document, font string, codeFont string, fontSize int) {
			self.doc = doc
			self.font = font
			self.codeFont = codeFont
			self.fontSize = fontSize
			body = new XMLWriter()
			notes = new XMLWriter()
			mainRels = new PartRels()
			noteRels = new PartRels()
			numbering = Numbering[]
			media = new map<string, string>()
			mediaExts = string[]
			styleIds = new map<string, string>()
		}

		// encode returns the package's bytes. Fails when the zip writer does.
		def encode() !byte[] {
			mainRels.add("styles", "styles.xml", false)
			mainRels.add("settings", "settings.xml", false)
			document()
			let hasNotes = noteCount > 0
			mainRels.add("numbering", "numbering.xml", false) when numbering.len() > 0
			mainRels.add("footnotes", "footnotes.xml", false) when hasNotes

			let pkg = new PackageWriter()
			try pkg.add("[Content_Types].xml", contentTypes(hasNotes))
			try pkg.add("_rels/.rels", packageRels())
			try pkg.add("docProps/core.xml", core())
			try pkg.add("docProps/app.xml", app())
			try pkg.add("word/document.xml", body.bytes())
			try pkg.add("word/_rels/document.xml.rels", mainRels.xml())
			try pkg.add("word/styles.xml", styles())
			try pkg.add("word/settings.xml", settings(hasNotes))
			try pkg.add("word/numbering.xml", numberingPart()) when numbering.len() > 0
			if hasNotes {
				notes.end()
				try pkg.add("word/footnotes.xml", notes.bytes())
				try pkg.add("word/_rels/footnotes.xml.rels", noteRels.xml()) when noteRels.ids.len() > 0
			}
			for let (name, part) in media {
				let data = doc.resources.get(name)
				try pkg.add("word/" + part, data) unless data is none
			}
			return try pkg.bytes()
		}

		def rels() PartRels {
			return inNote ?? (noteRels, mainRels)
		}

		def document() {
			let w = body
			w.declaration(true)
			w.start("w:document")
			w.attribute("xmlns:w", nsW)
			w.attribute("xmlns:r", nsR)
			w.attribute("xmlns:wp", "http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing")
			w.attribute("xmlns:a", "http://schemas.openxmlformats.org/drawingml/2006/main")
			w.attribute("xmlns:pic", "http://schemas.openxmlformats.org/drawingml/2006/picture")
			w.start("w:body")
			if doc.title != "" {
				let opening = doc.body.children.len() > 0 ?? (doc.body.children[0], new Block(BlockKind.Paragraph))
				if !(opening.kind == BlockKind.Heading && opening.level == 1 && opening.plainText() == doc.title) {
					paragraphStart(w, "Title", Alignment.Default)
					w.end()
					runText(w, doc.title, Marks{}, "")
					w.end()
				}
			}
			let subtitle = doc.metadata.get("subtitle")
			if !(subtitle is none) {
				paragraphStart(w, "Subtitle", Alignment.Default)
				w.end()
				runText(w, subtitle, Marks{}, "")
				w.end()
			}

			notes.declaration(true)
			notes.start("w:footnotes")
			notes.attribute("xmlns:w", nsW)
			notes.attribute("xmlns:r", nsR)
			notes.attribute("xmlns:wp", "http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing")
			notes.attribute("xmlns:a", "http://schemas.openxmlformats.org/drawingml/2006/main")
			notes.attribute("xmlns:pic", "http://schemas.openxmlformats.org/drawingml/2006/picture")
			separator(notes, "separator", "-1")
			separator(notes, "continuationSeparator", "0")

			blocks(w, doc.body.children, 0)
			w.start("w:sectPr")
			w.start("w:pgSz")
			w.attribute("w:w", "12240")
			w.attribute("w:h", "15840")
			w.end()
			w.start("w:pgMar")
			for let (_, side) in string["top", "right", "bottom", "left"] {
				w.attribute("w:" + side, "1440")
			}
			w.attribute("w:header", "720")
			w.attribute("w:footer", "720")
			w.attribute("w:gutter", "0")
			w.end()
			w.end()
			w.end()
			w.end()
		}

		def separator(w XMLWriter, kind string, id string) {
			w.start("w:footnote")
			w.attribute("w:type", kind)
			w.attribute("w:id", id)
			w.start("w:p")
			w.start("w:pPr")
			w.start("w:spacing")
			w.attribute("w:after", "0")
			w.attribute("w:line", "240")
			w.attribute("w:lineRule", "auto")
			w.end()
			w.end()
			w.start("w:r")
			w.start(kind == "separator" ?? ("w:separator", "w:continuationSeparator"))
			w.end()
			w.end()
			w.end()
			w.end()
		}

		def blocks(w XMLWriter, items Block[], quoteDepth int) {
			for let (_, block) in items {
				write(w, block, quoteDepth)
			}
		}

		def write(w XMLWriter, block Block, quoteDepth int) {
			match block.kind {
				case BlockKind.Heading:
					paragraphStart(w, "Heading{block.level.clamp(1, 6)}", block.alignment)
					w.end()
					let id = block.attributes.get("id")
					if !(id is none) {
						bookmarks++
						w.start("w:bookmarkStart")
						w.attribute("w:id", "{bookmarks}")
						w.attribute("w:name", id)
						w.end()
					}
					inlines(w, block.inlines, Marks{}, "")
					if !(id is none) {
						w.start("w:bookmarkEnd")
						w.attribute("w:id", "{bookmarks}")
						w.end()
					}
					w.end()
				case BlockKind.Paragraph:
					let styleId = quoteDepth > 0 ?? ("Quote", customStyle(block.styleName))
					paragraphStart(w, styleId, block.alignment)
					w.end()
					inlines(w, block.inlines, Marks{}, "")
					w.end()
				case BlockKind.List:
					list(w, block, 0)
				case BlockKind.Table:
					table(w, block)
				case BlockKind.Image:
					paragraphStart(w, "", block.alignment)
					w.end()
					let caption = textOf(block.inlines)
					picture(w, block.source, caption, block.title)
					w.end()
					if block.inlines.len() > 0 {
						paragraphStart(w, "Caption", Alignment.Default)
						w.end()
						inlines(w, block.inlines, Marks{}, "")
						w.end()
					}
				case BlockKind.Code:
					paragraphStart(w, "SourceCode", Alignment.Default)
					w.end()
					runText(w, block.content, Marks{}, "")
					w.end()
				case BlockKind.Quote:
					blocks(w, block.children, quoteDepth + 1)
				case BlockKind.Rule:
					w.start("w:p")
					w.start("w:pPr")
					w.start("w:pBdr")
					w.start("w:bottom")
					w.attribute("w:val", "single")
					w.attribute("w:sz", "6")
					w.attribute("w:space", "1")
					w.attribute("w:color", "auto")
					w.end()
					w.end()
					w.end()
					w.end()
				case BlockKind.PageBreak:
					w.start("w:p")
					w.start("w:r")
					w.start("w:br")
					w.attribute("w:type", "page")
					w.end()
					w.end()
					w.end()
				case BlockKind.Raw:
					w.raw(block.content) when block.format == "docx"
				default:
					blocks(w, block.children, quoteDepth)
			}
		}

		// paragraphStart opens a paragraph and its properties, which the caller
		// may add to and closes.
		def paragraphStart(w XMLWriter, styleId string, alignment Alignment) {
			w.start("w:p")
			w.start("w:pPr")
			if styleId != "" {
				w.start("w:pStyle")
				w.attribute("w:val", styleId)
				w.end()
			}
			justify(w, alignment)
		}

		def justify(w XMLWriter, alignment Alignment) {
			let value = ""
			match alignment {
				case Alignment.Left:
					value = "left"
				case Alignment.Center:
					value = "center"
				case Alignment.Right:
					value = "right"
				case Alignment.Justify:
					value = "both"
				default:
					return
			}
			return when value == ""
			w.start("w:jc")
			w.attribute("w:val", value)
			w.end()
		}

		// customStyle returns the id of the paragraph style of the name,
		// declaring it the first time.
		def customStyle(name string) string {
			return "" when name == ""
			let known = styleIds.get(name)
			return known unless known is none
			let id = ""
			for let (_, c) in name {
				id += string(c) when (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
			}
			id = "Style" + id
			id += "{styleIds.len() + 1}" when styleIds.values().includes(id)
			styleIds.set(name, id)
			return id
		}

		def list(w XMLWriter, block Block, level int) {
			numbering.push(Numbering{ordered: block.ordered, level: level, start: block.start})
			let numId = numbering.len()
			for let (_, item) in block.children {
				let first = true
				for let (_, child) in item.children {
					if child.kind == BlockKind.List {
						list(w, child, level + 1)
						continue
					}
					if child.kind != BlockKind.Paragraph {
						write(w, child, 0)
						continue
					}
					paragraphStart(w, customStyle(child.styleName), child.alignment)
					if first {
						w.start("w:numPr")
						w.start("w:ilvl")
						w.attribute("w:val", "{level.clamp(0, 8)}")
						w.end()
						w.start("w:numId")
						w.attribute("w:val", "{numId}")
						w.end()
						w.end()
					} else {
						w.start("w:ind")
						w.attribute("w:left", "{720 * (level + 1)}")
						w.end()
					}
					w.end()
					let checked = item.checked
					runText(w, checked ?? ("☒ ", "☐ "), Marks{}, "") when first && !(checked is none)
					inlines(w, child.inlines, Marks{}, "")
					w.end()
					first = false
				}
				if first {
					paragraphStart(w, "", Alignment.Default)
					w.start("w:numPr")
					w.start("w:ilvl")
					w.attribute("w:val", "{level.clamp(0, 8)}")
					w.end()
					w.start("w:numId")
					w.attribute("w:val", "{numId}")
					w.end()
					w.end()
					w.end()
					let checked = item.checked
					runText(w, checked ?? ("☒", "☐"), Marks{}, "") unless checked is none
					w.end()
				}
			}
		}

		def table(w XMLWriter, block Block) {
			let width = gridWidth(block)
			return when width == 0
			w.start("w:tbl")
			w.start("w:tblPr")
			w.start("w:tblW")
			w.attribute("w:w", "5000")
			w.attribute("w:type", "pct")
			w.end()
			w.start("w:tblBorders")
			for let (_, side) in string["top", "left", "bottom", "right", "insideH", "insideV"] {
				w.start("w:" + side)
				w.attribute("w:val", "single")
				w.attribute("w:sz", "4")
				w.attribute("w:space", "0")
				w.attribute("w:color", "auto")
				w.end()
			}
			w.end()
			w.end()
			w.start("w:tblGrid")
			for let i = 0; i < width; i++ {
				w.start("w:gridCol")
				w.attribute("w:w", "{9360 / width}")
				w.end()
			}
			w.end()

			// Rows still covered by a cell above, and how many columns it spans,
			// by the column it starts at.
			let covered = int[]
			let coveredSpan = int[]
			for let i = 0; i < width; i++ {
				covered.push(0)
				coveredSpan.push(1)
			}
			for let (_, row) in block.children {
				w.start("w:tr")
				if row.header {
					w.start("w:trPr")
					w.start("w:tblHeader")
					w.end()
					w.end()
				}
				let column = 0
				let cells = row.children
				let next = 0
				for column < width {
					if covered[column] > 0 {
						covered[column]--
						let span = coveredSpan[column]
						cellStart(w, span, "continue")
						w.start("w:p")
						w.end()
						w.end()
						column += span
						continue
					}
					if next >= cells.len() {
						cellStart(w, 1, "")
						w.start("w:p")
						w.end()
						w.end()
						column++
						continue
					}
					let cell = cells[next]
					next++
					let span = cell.columnSpan.clamp(1, width - column)
					let merge = ""
					if cell.rowSpan > 1 {
						merge = "restart"
						covered[column] = cell.rowSpan - 1
						coveredSpan[column] = span
					}
					cellStart(w, span, merge)
					let alignment = column < block.alignments.len() ?? (block.alignments[column], Alignment.Default)
					cellContent(w, cell, alignment)
					w.end()
					column += span
				}
				w.end()
			}
			w.end()
			// A table cannot be followed by another table directly.
			w.start("w:p")
			w.end()
		}

		def cellStart(w XMLWriter, span int, merge string) {
			w.start("w:tc")
			w.start("w:tcPr")
			if span > 1 {
				w.start("w:gridSpan")
				w.attribute("w:val", "{span}")
				w.end()
			}
			if merge != "" {
				w.start("w:vMerge")
				w.attribute("w:val", merge) when merge == "restart"
				w.end()
			}
			w.end()
		}

		def cellContent(w XMLWriter, cell Block, alignment Alignment) {
			let wrote = false
			for let (_, child) in cell.children {
				if child.kind == BlockKind.Paragraph {
					let own = child.alignment == Alignment.Default ?? (alignment, child.alignment)
					paragraphStart(w, customStyle(child.styleName), own)
					w.end()
					inlines(w, child.inlines, Marks{}, "")
					w.end()
				} else {
					write(w, child, 0)
				}
				wrote = true
			}
			if !wrote || cell.children[cell.children.len() - 1].kind == BlockKind.Table {
				w.start("w:p")
				w.end()
			}
		}

		def inlines(w XMLWriter, items Inline[], marks Marks, charStyle string) {
			for let (_, item) in items {
				match item.kind {
					case InlineKind.Text:
						runText(w, item.content, marks, charStyle)
					case InlineKind.Bold:
						inlines(w, item.children, Marks{...marks, bold: true}, charStyle)
					case InlineKind.Italic:
						inlines(w, item.children, Marks{...marks, italic: true}, charStyle)
					case InlineKind.Underline:
						inlines(w, item.children, Marks{...marks, underline: true}, charStyle)
					case InlineKind.Strike:
						inlines(w, item.children, Marks{...marks, strike: true}, charStyle)
					case InlineKind.Code:
						runText(w, item.content, marks, "VerbatimChar")
					case InlineKind.Styled:
						let foreground = item.foreground
						foreground = marks.foreground when foreground is none
						let background = item.background
						background = marks.background when background is none
						inlines(w, item.children, Marks{...marks, foreground: foreground, background: background}, charStyle)
					case InlineKind.Link:
						w.start("w:hyperlink")
						if item.url.startsWith("#") {
							w.attribute("w:anchor", item.url[1:])
						} else {
							w.attribute("r:id", rels().add("hyperlink", item.url, true))
						}
						w.attribute("w:tooltip", item.title) unless item.title == ""
						inlines(w, item.children, marks, "Hyperlink")
						w.end()
					case InlineKind.Image:
						picture(w, item.url, textOf(item.children), item.title)
					case InlineKind.LineBreak:
						w.start("w:r")
						w.start("w:br")
						w.end()
						w.end()
					case InlineKind.Footnote:
						footnote(w, item)
					case InlineKind.Raw:
						w.raw(item.content) when item.format == "docx"
				}
			}
		}

		// runText writes the text as runs, tabs and line breaks becoming their
		// own elements.
		def runText(w XMLWriter, content string, marks Marks, charStyle string) {
			return when content == ""
			w.start("w:r")
			runProperties(w, marks, charStyle)
			let start = 0
			let n = content.len()
			for let i = 0; i <= n; i++ {
				let c = i < n ?? (content[i], '\n')
				continue unless c == '\t' || c == '\n' || i == n
				if i > start {
					w.start("w:t")
					w.attribute("xml:space", "preserve")
					w.text(content[start:i])
					w.end()
				}
				if i < n {
					w.start(c == '\t' ?? ("w:tab", "w:br"))
					w.end()
				}
				start = i + 1
			}
			w.end()
		}

		def runProperties(w XMLWriter, marks Marks, charStyle string) {
			let foreground = marks.foreground
			let background = marks.background
			let plain = charStyle == "" && !marks.bold && !marks.italic && !marks.underline && !marks.strike && foreground is none && background is none
			return when plain
			w.start("w:rPr")
			if charStyle != "" {
				w.start("w:rStyle")
				w.attribute("w:val", charStyle)
				w.end()
			}
			if marks.bold {
				w.start("w:b")
				w.end()
			}
			if marks.italic {
				w.start("w:i")
				w.end()
			}
			if marks.strike {
				w.start("w:strike")
				w.end()
			}
			if !(foreground is none) {
				w.start("w:color")
				w.attribute("w:val", rgb(foreground))
				w.end()
			}
			if marks.underline {
				w.start("w:u")
				w.attribute("w:val", "single")
				w.end()
			}
			if !(background is none) {
				w.start("w:shd")
				w.attribute("w:val", "clear")
				w.attribute("w:color", "auto")
				w.attribute("w:fill", rgb(background))
				w.end()
			}
			w.end()
		}

		def footnote(w XMLWriter, item Inline) {
			return when inNote
			noteCount++
			let id = "{noteCount}"
			w.start("w:r")
			w.start("w:rPr")
			w.start("w:rStyle")
			w.attribute("w:val", "FootnoteReference")
			w.end()
			w.end()
			w.start("w:footnoteReference")
			w.attribute("w:id", id)
			w.end()
			w.end()

			inNote = true
			let n = notes
			n.start("w:footnote")
			n.attribute("w:id", id)
			let first = true
			for let (_, block) in item.note {
				if first && block.kind == BlockKind.Paragraph {
					paragraphStart(n, "FootnoteText", block.alignment)
					n.end()
					noteMark(n)
					inlines(n, block.inlines, Marks{}, "")
					n.end()
				} else {
					write(n, block, 0)
				}
				first = false
			}
			if first {
				paragraphStart(n, "FootnoteText", Alignment.Default)
				n.end()
				noteMark(n)
				n.end()
			}
			n.end()
			inNote = false
		}

		def noteMark(n XMLWriter) {
			n.start("w:r")
			n.start("w:rPr")
			n.start("w:rStyle")
			n.attribute("w:val", "FootnoteReference")
			n.end()
			n.end()
			n.start("w:footnoteRef")
			n.end()
			n.end()
			n.start("w:r")
			n.start("w:t")
			n.attribute("xml:space", "preserve")
			n.text(" ")
			n.end()
			n.end()
		}

		// picture writes a run holding the image: embedded when it is a
		// resource, linked otherwise.
		def picture(w XMLWriter, source string, alt string, title string) {
			let data = doc.resources.get(source)
			let relId = ""
			let widthEmu = 3657600
			let heightEmu = 2743200
			if data is none {
				relId = rels().add("image", source, true)
			} else {
				let known = media.get(source)
				let part = known is none ?? ("", known)
				if part == "" {
					let ext = os.extension(source).lower().trimPrefix(".")
					ext = imageExtension(data) when ext == ""
					let made = "media/image{media.len() + 1}.{ext}"
					media.set(source, made)
					mediaExts.push(ext) unless mediaExts.includes(ext)
					part = made
				}
				relId = rels().add("image", part, false)
				let (px, py) = pixelSize(data)
				if px > 0 && py > 0 {
					widthEmu = px * 9525
					heightEmu = py * 9525
					if widthEmu > 5486400 {
						heightEmu = heightEmu * 5486400 / widthEmu
						widthEmu = 5486400
					}
				}
			}
			pictures++
			w.start("w:r")
			w.start("w:drawing")
			w.start("wp:inline")
			for let (_, side) in string["distT", "distB", "distL", "distR"] {
				w.attribute(side, "0")
			}
			w.start("wp:extent")
			w.attribute("cx", "{widthEmu}")
			w.attribute("cy", "{heightEmu}")
			w.end()
			w.start("wp:docPr")
			w.attribute("id", "{pictures}")
			w.attribute("name", "Picture {pictures}")
			w.attribute("descr", alt) unless alt == ""
			w.attribute("title", title) unless title == ""
			w.end()
			w.start("wp:cNvGraphicFramePr")
			w.start("a:graphicFrameLocks")
			w.attribute("noChangeAspect", "1")
			w.end()
			w.end()
			w.start("a:graphic")
			w.start("a:graphicData")
			w.attribute("uri", "http://schemas.openxmlformats.org/drawingml/2006/picture")
			w.start("pic:pic")
			w.start("pic:nvPicPr")
			w.start("pic:cNvPr")
			w.attribute("id", "0")
			w.attribute("name", baseName(source))
			w.end()
			w.start("pic:cNvPicPr")
			w.end()
			w.end()
			w.start("pic:blipFill")
			w.start("a:blip")
			w.attribute(data is none ?? ("r:link", "r:embed"), relId)
			w.end()
			w.start("a:stretch")
			w.start("a:fillRect")
			w.end()
			w.end()
			w.end()
			w.start("pic:spPr")
			w.start("a:xfrm")
			w.start("a:off")
			w.attribute("x", "0")
			w.attribute("y", "0")
			w.end()
			w.start("a:ext")
			w.attribute("cx", "{widthEmu}")
			w.attribute("cy", "{heightEmu}")
			w.end()
			w.end()
			w.start("a:prstGeom")
			w.attribute("prst", "rect")
			w.start("a:avLst")
			w.end()
			w.end()
			w.end()
			w.end()
			w.end()
			w.end()
			w.end()
			w.end()
			w.end()
		}

		def contentTypes(hasNotes bool) string {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("Types")
			w.attribute("xmlns", "http://schemas.openxmlformats.org/package/2006/content-types")
			defaultType(w, "rels", "application/vnd.openxmlformats-package.relationships+xml")
			defaultType(w, "xml", "application/xml")
			for let (_, ext) in mediaExts {
				defaultType(w, ext, mediaType("x." + ext))
			}
			let office = "application/vnd.openxmlformats-officedocument."
			override(w, "/word/document.xml", office + "wordprocessingml.document.main+xml")
			override(w, "/word/styles.xml", office + "wordprocessingml.styles+xml")
			override(w, "/word/settings.xml", office + "wordprocessingml.settings+xml")
			override(w, "/word/numbering.xml", office + "wordprocessingml.numbering+xml") when numbering.len() > 0
			override(w, "/word/footnotes.xml", office + "wordprocessingml.footnotes+xml") when hasNotes
			override(w, "/docProps/core.xml", "application/vnd.openxmlformats-package.core-properties+xml")
			override(w, "/docProps/app.xml", office + "extended-properties+xml")
			return w.str()
		}

		def defaultType(w XMLWriter, ext string, kind string) {
			w.start("Default")
			w.attribute("Extension", ext)
			w.attribute("ContentType", kind)
			w.end()
		}

		def override(w XMLWriter, part string, kind string) {
			w.start("Override")
			w.attribute("PartName", part)
			w.attribute("ContentType", kind)
			w.end()
		}

		def packageRels() string {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("Relationships")
			w.attribute("xmlns", "http://schemas.openxmlformats.org/package/2006/relationships")
			relationship(w, "rId1", relBase + "officeDocument", "word/document.xml")
			relationship(w, "rId2", "http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties", "docProps/core.xml")
			relationship(w, "rId3", relBase + "extended-properties", "docProps/app.xml")
			return w.str()
		}

		def relationship(w XMLWriter, id string, kind string, target string) {
			w.start("Relationship")
			w.attribute("Id", id)
			w.attribute("Type", kind)
			w.attribute("Target", target)
			w.end()
		}

		def core() string {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("cp:coreProperties")
			w.attribute("xmlns:cp", "http://schemas.openxmlformats.org/package/2006/metadata/core-properties")
			w.attribute("xmlns:dc", "http://purl.org/dc/elements/1.1/")
			w.attribute("xmlns:dcterms", "http://purl.org/dc/terms/")
			w.attribute("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance")
			w.element("dc:title", doc.title) unless doc.title == ""
			w.element("dc:creator", doc.authors.join("; ")) when doc.authors.len() > 0
			for let (_, pair) in string["subject dc:subject", "keywords cp:keywords", "description dc:description", "category cp:category"] {
				let space = pair.indexOf(" ")
				let found = doc.metadata.get(pair[:space])
				w.element(pair[space + 1:], found) unless found is none
			}
			w.element("dc:language", doc.language) unless doc.language == ""
			let date = doc.date
			if !(date is none) {
				w.start("dcterms:created")
				w.attribute("xsi:type", "dcterms:W3CDTF")
				w.text(stamp(date))
				w.end()
			}
			return w.str()
		}

		def app() string {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("Properties")
			w.attribute("xmlns", "http://schemas.openxmlformats.org/officeDocument/2006/extended-properties")
			w.element("Application", "ADM")
			let company = doc.metadata.get("company")
			w.element("Company", company) unless company is none
			return w.str()
		}

		def settings(hasNotes bool) string {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("w:settings")
			w.attribute("xmlns:w", nsW)
			w.start("w:defaultTabStop")
			w.attribute("w:val", "720")
			w.end()
			if hasNotes {
				w.start("w:footnotePr")
				for let (_, id) in string["-1", "0"] {
					w.start("w:footnote")
					w.attribute("w:id", id)
					w.end()
				}
				w.end()
			}
			w.start("w:compat")
			w.start("w:compatSetting")
			w.attribute("w:name", "compatibilityMode")
			w.attribute("w:uri", "http://schemas.microsoft.com/office/word")
			w.attribute("w:val", "15")
			w.end()
			w.end()
			return w.str()
		}

		def styles() string {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("w:styles")
			w.attribute("xmlns:w", nsW)
			w.start("w:docDefaults")
			w.start("w:rPrDefault")
			w.start("w:rPr")
			fonts(w, font)
			size(w, fontSize * 2)
			if doc.language != "" {
				w.start("w:lang")
				w.attribute("w:val", doc.language)
				w.end()
			}
			w.end()
			w.end()
			w.start("w:pPrDefault")
			w.start("w:pPr")
			spacing(w, 0, 160)
			w.end()
			w.end()
			w.end()

			openStyle(w, "paragraph", "Normal", "Normal", "", true)
			w.end()
			let sizes = int[16, 14, 13, 12, 12, 12]
			for let level = 1; level <= 6; level++ {
				openStyle(w, "paragraph", "Heading{level}", "heading {level}", "Normal", false)
				w.start("w:next")
				w.attribute("w:val", "Normal")
				w.end()
				w.start("w:qFormat")
				w.end()
				w.start("w:pPr")
				w.start("w:keepNext")
				w.end()
				spacing(w, level <= 2 ?? (360, 240), 80)
				w.start("w:outlineLvl")
				w.attribute("w:val", "{level - 1}")
				w.end()
				w.end()
				w.start("w:rPr")
				w.start("w:b")
				w.end()
				w.start("w:i") when level == 6
				w.end() when level == 6
				size(w, sizes[level - 1] * 2 * fontSize / 11)
				w.end()
				w.end()
			}
			openStyle(w, "paragraph", "Title", "Title", "Normal", false)
			w.start("w:rPr")
			size(w, 56 * fontSize / 11)
			w.end()
			w.end()
			openStyle(w, "paragraph", "Subtitle", "Subtitle", "Normal", false)
			w.start("w:rPr")
			size(w, 30 * fontSize / 11)
			w.end()
			w.end()
			openStyle(w, "paragraph", "Quote", "Quote", "Normal", false)
			w.start("w:pPr")
			w.start("w:ind")
			w.attribute("w:left", "720")
			w.attribute("w:right", "720")
			w.end()
			w.end()
			w.start("w:rPr")
			w.start("w:i")
			w.end()
			w.end()
			w.end()
			openStyle(w, "paragraph", "SourceCode", "Source Code", "Normal", false)
			w.start("w:pPr")
			spacing(w, 0, 160)
			w.end()
			w.start("w:rPr")
			fonts(w, codeFont)
			size(w, (fontSize - 1) * 2)
			w.end()
			w.end()
			openStyle(w, "paragraph", "Caption", "caption", "Normal", false)
			w.start("w:rPr")
			w.start("w:i")
			w.end()
			size(w, (fontSize - 1) * 2)
			w.end()
			w.end()
			openStyle(w, "paragraph", "FootnoteText", "footnote text", "Normal", false)
			w.start("w:pPr")
			spacing(w, 0, 0)
			w.end()
			w.start("w:rPr")
			size(w, (fontSize - 1) * 2)
			w.end()
			w.end()
			openStyle(w, "character", "VerbatimChar", "Verbatim Char", "", false)
			w.start("w:rPr")
			fonts(w, codeFont)
			w.end()
			w.end()
			openStyle(w, "character", "Hyperlink", "Hyperlink", "", false)
			w.start("w:rPr")
			w.start("w:color")
			w.attribute("w:val", "0563C1")
			w.end()
			w.start("w:u")
			w.attribute("w:val", "single")
			w.end()
			w.end()
			w.end()
			openStyle(w, "character", "FootnoteReference", "footnote reference", "", false)
			w.start("w:rPr")
			w.start("w:vertAlign")
			w.attribute("w:val", "superscript")
			w.end()
			w.end()
			w.end()
			let names = styleIds.keys()
			names.sort((a string, b string) => a.compare(b) < 0)
			for let (_, name) in names {
				let id = styleIds.get(name)
				continue when id is none
				openStyle(w, "paragraph", id, name, "Normal", false)
				w.start("w:qFormat")
				w.end()
				w.end()
			}
			return w.str()
		}

		// openStyle opens a style element with its name, which the caller fills
		// and closes.
		def openStyle(w XMLWriter, kind string, id string, name string, basedOn string, isDefault bool) {
			w.start("w:style")
			w.attribute("w:type", kind)
			w.attribute("w:default", "1") when isDefault
			w.attribute("w:styleId", id)
			w.start("w:name")
			w.attribute("w:val", name)
			w.end()
			if basedOn != "" {
				w.start("w:basedOn")
				w.attribute("w:val", basedOn)
				w.end()
			}
		}

		def fonts(w XMLWriter, name string) {
			w.start("w:rFonts")
			for let (_, slot) in string["ascii", "hAnsi", "eastAsia", "cs"] {
				w.attribute("w:" + slot, name)
			}
			w.end()
		}

		def size(w XMLWriter, halfPoints int) {
			w.start("w:sz")
			w.attribute("w:val", "{halfPoints}")
			w.end()
			w.start("w:szCs")
			w.attribute("w:val", "{halfPoints}")
			w.end()
		}

		def spacing(w XMLWriter, before int, after int) {
			w.start("w:spacing")
			w.attribute("w:before", "{before}")
			w.attribute("w:after", "{after}")
			w.end()
		}

		def numberingPart() string {
			let w = new XMLWriter()
			w.declaration(true)
			w.start("w:numbering")
			w.attribute("xmlns:w", nsW)
			let bullets = string["•", "◦", "▪"]
			for let abstract = 1; abstract <= 2; abstract++ {
				w.start("w:abstractNum")
				w.attribute("w:abstractNumId", "{abstract}")
				w.start("w:multiLevelType")
				w.attribute("w:val", "multilevel")
				w.end()
				for let level = 0; level < 9; level++ {
					w.start("w:lvl")
					w.attribute("w:ilvl", "{level}")
					w.start("w:start")
					w.attribute("w:val", "1")
					w.end()
					w.start("w:numFmt")
					w.attribute("w:val", abstract == 1 ?? ("bullet", "decimal"))
					w.end()
					w.start("w:lvlText")
					w.attribute("w:val", abstract == 1 ?? (bullets[level % 3], "%{level + 1}."))
					w.end()
					w.start("w:lvlJc")
					w.attribute("w:val", "left")
					w.end()
					w.start("w:pPr")
					w.start("w:ind")
					w.attribute("w:left", "{720 * (level + 1)}")
					w.attribute("w:hanging", "360")
					w.end()
					w.end()
					w.end()
				}
				w.end()
			}
			for let (i, num) in numbering {
				w.start("w:num")
				w.attribute("w:numId", "{i + 1}")
				w.start("w:abstractNumId")
				w.attribute("w:val", num.ordered ?? ("2", "1"))
				w.end()
				w.start("w:lvlOverride")
				w.attribute("w:ilvl", "{num.level.clamp(0, 8)}")
				w.start("w:startOverride")
				w.attribute("w:val", "{num.start}")
				w.end()
				w.end()
				w.end()
			}
			return w.str()
		}
	}
}
