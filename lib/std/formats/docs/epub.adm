partial module std.formats.docs {
	use (
		std.bytes
		std.formats.docs.epub::*
		std.formats.docs.office::(openPackage)
		std.io
	)

	// Epub is the EPUB e-book codec, versions 2 and 3.
	//
	// Decoding reads the container's package document: title, creators,
	// language, date, subjects, description, publisher, rights, identifier
	// and the cover image into the metadata (`metadata["cover"]` names the
	// resource), every image of the manifest into `Document.resources`
	// under its path from the package document, then the pages of the spine
	// in reading order through the HTML decoder, with a page break between
	// pages. Links to other pages of the book become links inside the
	// document; a page without a heading gets its table of contents label,
	// from the navigation document or the NCX, as one. Pages outside the
	// linear reading order, styles and scripts are left out, as are
	// footnotes kept on a page other than the one referring to them.
	//
	// Encoding writes an EPUB 3 book, with an NCX for older readers: one
	// XHTML page per part of the document between page breaks, a table of
	// contents from the first heading of each page, a small stylesheet, the
	// resources, and the metadata above. Footnotes go at the end of their
	// page.
	//
	// Example: Read a book's chapters
	// ```example
	// use std.formats.docs
	//
	// let book = try docs.load("novel.epub")
	// for let (_, heading) in book.headings() {
	//     println(heading.plainText())
	// }
	// ```
	@codec("EPUB")
	type Epub {
		mimeType string[] {
			def get() string[] {
				return string["application/epub+zip"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".epub"]
			}
		}

		// matchSignature reports whether the reader is a zip archive whose
		// first entry is a `mimetype` naming an EPUB.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(64)
			let n = 0
			for n < b.len() {
				let got = r.read(b[n:]) onerror recover 0
				break when got <= 0
				n += got
			}
			return false unless n >= 58 && string(b[30:38]) == "mimetype"
			return string(b[38:58]) == "application/epub+zip"
		}

		// decode reads the whole reader as an EPUB container. Fails when the
		// reader does, or as decode(byte[]) does.
		def decode(reader io.Reader) !Document {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes())
		}

		// decode reads the bytes as an EPUB container. Fails when they are not
		// a zip archive, the container names no package document, or the
		// package document is not well-formed XML.
		def decode(data byte[]) !Document {
			let pkg = try openPackage(data)
			let reader = new EpubReader(pkg)
			return reader.read()
		}

		// encode writes the document as an EPUB container. Fails when the
		// writer does.
		def encode(doc Document, writer io.Writer) !none {
			try writer.write(try encode(doc))
		}

		// encode returns the document as the bytes of an EPUB container. Fails
		// only when the archive cannot be built.
		def encode(doc Document) !byte[] {
			let writer = new EpubWriter(doc)
			return writer.encode()
		}
	}
}
