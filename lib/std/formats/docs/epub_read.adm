internal partial module std.formats.docs.epub {
	use (
		std.data.encoding::(XMLNode, XMLNodeKind)
		std.formats.docs.html::(HtmlParser, HtmlReader)
		std.formats.docs.office::*
		std.formats.container::*
		std.formats.docs::*
	)

	// A manifest item of the package document.
	struct Item {
		// Path in the zip container.
		path       string
		mediaType  string
		properties string
	}

	// EpubReader turns an EPUB container into a Document: the package
	// document's metadata, then the pages of the spine in reading order.
	type EpubReader {
		pkg    Package
		doc    Document
		// Folder of the package document, which resource names are relative
		// to.
		root   string
		items  map<string, Item>
		// Navigation labels by page path, for pages without a heading.
		labels map<string, string>

		def new(pkg Package) {
			self.pkg = pkg
			doc = new Document()
			items = new map<string, Item>()
			labels = new map<string, string>()
		}

		// read decodes the container. Fails when it names no package
		// document, or the package document is not well-formed.
		def read() !Document {
			let opfPath = try packagePath()
			let opf = try pkg.xml(opfPath)
			fail DocumentError{message: "epub: no package document", format: "EPUB"} when opf is none
			root = folderOf(opfPath)

			let manifest = opf.child("manifest")
			if !(manifest is none) {
				for let (_, node) in manifest.elements("item") {
					items.set(prop(node, "id"), Item{path: resolve(opfPath, prop(node, "href")), mediaType: prop(node, "media-type"), properties: prop(node, "properties")})
				}
			}
			let metadata = opf.child("metadata")
			readMetadata(metadata) unless metadata is none

			for let (_, item) in items {
				continue unless item.mediaType.startsWith("image/")
				let data = pkg.read(item.path) onerror recover none
				doc.resources.set(relative(item.path), data) unless data is none
			}
			let cover = doc.metadata.get("cover")
			if !(cover is none) {
				let item = items.get(cover)
				doc.metadata.set("cover", relative(item.path)) unless item is none
			}
			for let (_, item) in items {
				doc.metadata.set("cover", relative(item.path)) when hasWord(item.properties, "cover-image")
			}
			try navigation()

			let spine = opf.child("spine")
			return doc when spine is none
			let pages = new map<string, bool>()
			let order = Item[]
			for let (_, ref) in spine.elements("itemref") {
				let item = items.get(prop(ref, "idref"))
				continue when item is none || prop(ref, "linear") == "no"
				continue unless item.mediaType := "application/xhtml+xml" || "text/html"
				order.push(item)
				pages.set(relative(item.path), true)
			}
			for let (_, item) in order {
				let data = pkg.read(item.path) onerror recover none
				continue when data is none
				let page = new Block(BlockKind.Section)
				let reader = new HtmlReader(doc)
				let folder = relative(folderOf(item.path))
				reader.base = folder == "" ?? (".", folder.trimSuffix("/"))
				reader.pages = pages
				let parser = new HtmlParser(data)
				reader.readBody(parser.parse(), page)
				let blocks = flatten(page.children)
				continue when blocks.len() == 0
				let label = labels.get(item.path)
				if !(label is none) && label != "" && !hasHeading(blocks) {
					let heading = new Block(BlockKind.Heading)
					heading.level = 1
					heading.inlines.push(text(label))
					blocks.unshift(heading)
				}
				doc.body.add(new Block(BlockKind.PageBreak)) when doc.body.children.len() > 0
				for let (_, block) in blocks {
					doc.body.add(block)
				}
			}
			if doc.title == "" {
				for let (_, block) in doc.body.children {
					if block.kind == BlockKind.Heading {
						doc.title = block.plainText() when block.level == 1
						break
					}
				}
			}
			return doc
		}

		// packagePath returns the path of the package document the container
		// names. Fails when there is none.
		def packagePath() !string {
			let container = try pkg.xml("META-INF/container.xml")
			if !(container is none) {
				for let (_, file) in container.descendants("rootfile") {
					let kind = prop(file, "media-type")
					return normalize(prop(file, "full-path")) when kind := "" || "application/oebps-package+xml"
				}
			}
			for let (_, name) in pkg.names() {
				return name when name.lower().endsWith(".opf")
			}
			fail DocumentError{message: "epub: no package document", format: "EPUB"}
		}

		// relative returns a container path relative to the package
		// document's folder, which resources are named by.
		def relative(path string) string {
			return path[root.len():] when root != "" && path.startsWith(root)
			return path
		}

		def readMetadata(metadata XMLNode) {
			let subjects = string[]
			for let (_, node) in metadata.children {
				continue unless node.kind == XMLNodeKind.Element
				let content = node.text().trim()
				match node.localName {
					case "title":
						doc.title = content when doc.title == "" && content != ""
					case "creator":
						doc.authors.push(content) unless content == ""
					case "language":
						doc.language = content when doc.language == "" && content != "" && content != "C" && content != "und"
					case "date":
						doc.date = dateOf(content) when doc.date is none && content != ""
					case "subject":
						subjects.push(content) unless content == ""
					case "description", "publisher", "rights", "identifier", "contributor", "source":
						doc.metadata.set(node.localName, content) unless content == "" || doc.metadata.hasKey(node.localName)
					case "meta":
						let name = prop(node, "name")
						if name == "cover" {
							doc.metadata.set("cover", prop(node, "content"))
						} else if name != "" && !name.startsWith("calibre:") {
							doc.metadata.set(name, prop(node, "content")) unless prop(node, "content") == ""
						}
				}
			}
			doc.metadata.set("subject", subjects.join(", ")) when subjects.len() > 0
		}

		// navigation reads the labels of the table of contents, from the
		// navigation document or else the NCX.
		def navigation() !none {
			for let (_, item) in items {
				continue unless hasWord(item.properties, "nav")
				let data = pkg.read(item.path) onerror recover none
				continue when data is none
				let parser = new HtmlParser(data)
				let page = parser.parse()
				for let (_, nav) in page.descendants("nav") {
					let kind = value(nav, "epub:type")
					continue unless kind == "" || hasWord(kind, "toc")
					for let (_, a) in nav.descendants("a") {
						label(resolve(item.path, value(a, "href")), a.text())
					}
					return none
				}
			}
			for let (_, item) in items {
				continue unless item.mediaType == "application/x-dtbncx+xml"
				let ncx = pkg.xml(item.path) onerror recover none
				continue when ncx is none
				for let (_, point) in ncx.descendants("navPoint") {
					let contentNode = point.child("content")
					let labelNode = point.child("navLabel")
					continue when contentNode is none || labelNode is none
					label(resolve(item.path, prop(contentNode, "src")), labelNode.text())
				}
			}
		}

		def label(target string, name string) {
			let hash = target.indexOf("#")
			let path = hash < 0 ?? (target, target[:hash])
			let clean = name.trim()
			labels.set(path, clean) unless labels.hasKey(path) || clean == ""
		}
	}

	// flatten returns the blocks with the sections a page wraps its content
	// in opened.
	def flatten(blocks Block[]) Block[] {
		let out = Block[]
		for let (_, block) in blocks {
			if block.kind == BlockKind.Section {
				out.push(...flatten(block.children))
			} else {
				out.push(block)
			}
		}
		return out
	}

	def hasHeading(blocks Block[]) bool {
		for let (_, block) in blocks {
			return true when block.kind == BlockKind.Heading
		}
		return false
	}

	// hasWord reports whether the space-separated list holds the word.
	def hasWord(list string, word string) bool {
		return list != "" && (" " + list + " ").indexOf(" " + word + " ") >= 0
	}
}
