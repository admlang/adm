partial module std.formats.docs {
	use (
		std.bytes
		std.data.encoding::(XML)
		std.formats.archive::(CompressionLevel, Entry, WriteOptions, Zip)
		std.testing
	)

	check "Epub" {
		// epubSample builds a book of two chapters.
		internal def epubSample() Document {
			let doc = new Document("The Book")
			doc.authors.push("Ann Lee")
			doc.language = "en-GB"
			doc.metadata.set("publisher", "ACME")
			doc.metadata.set("identifier", "urn:isbn:9780000000000")
			doc.metadata.set("cover", "cover.png")
			doc.heading(1, "One").attributes.set("id", "one")
			doc.paragraph(text("See "), link("chapter two", "#two"), text(" and a note"), footnote("The note."), text("."))
			doc.image("cover.png", byte[0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a], "Cover")
			doc.pageBreak()
			doc.heading(1, "Two").attributes.set("id", "two")
			doc.list(string["a", "b"])
			doc.paragraph(text("Back to "), link("one", "#one"), lineBreak(), text("end"))
			return doc
		}

		@test()
		def TestRoundTrip() !none {
			let codec = new Epub()
			let doc = epubSample()
			let back = try codec.decode(try codec.encode(doc))
			assert back.title == "The Book"
			assert back.authors.join("|") == "Ann Lee"
			assert back.language == "en-GB"
			assert back.metadata["publisher"] == "ACME"
			assert back.metadata["identifier"] == "urn:isbn:9780000000000"
			assert back.metadata["cover"] == "cover.png"
			let markdown = new Markdown()
			assert markdown.encode(back) == markdown.encode(doc)
			let data = back.resource("cover.png")
			fail "no cover" when data is none
			assert data.len() == 8
			return none
		}

		@test()
		def TestContainerLayout() !none {
			let encoded = try new Epub().encode(epubSample())
			assert string(encoded[30:38]) == "mimetype"
			assert string(encoded[38:58]) == "application/epub+zip"
			let arc = try new Zip().open(new bytes.Reader(encoded))
			let names = string[]
			for let (_, entry) in arc.entries() {
				names.push(entry.name)
			}
			assert names.join(",") == "mimetype,META-INF/container.xml,OEBPS/content.opf,OEBPS/nav.xhtml,OEBPS/toc.ncx,OEBPS/style.css,OEBPS/chapter1.xhtml,OEBPS/chapter2.xhtml,OEBPS/cover.png"
			let xml = new XML()
			for let (_, name) in names {
				continue unless name.endsWith(".xhtml") || name.endsWith(".opf") || name.endsWith(".ncx")
				let entry = arc.entry(name)
				fail "missing {name}" when entry is none
				let content = new bytes.Buffer()
				try content.readFrom(try arc.open(entry))
				let root = try xml.parse(content.bytes())
				if name.endsWith("chapter1.xhtml") {
					let links = root.descendants("a")
					let href = links[0].attribute("href")
					fail "no href" when href is none
					assert href == "chapter2.xhtml#two"
				}
				if name.endsWith(".opf") {
					let manifest = root.child("manifest")
					fail "no manifest" when manifest is none
					let covers = 0
					for let (_, item) in manifest.elements("item") {
						let properties = item.attribute("properties")
						covers++ when !(properties is none) && properties == "cover-image"
					}
					assert covers == 1
				}
			}
			return none
		}

		@test()
		def TestDecodeEpub2() !none {
			let names = string[]
			let parts = string[]
			names.push("mimetype")
			parts.push("application/epub+zip")
			names.push("META-INF/container.xml")
			parts.push("<container xmlns=\"urn:oasis:names:tc:opendocument:xmlns:container\" version=\"1.0\"><rootfiles><rootfile full-path=\"OPS/book.opf\" media-type=\"application/oebps-package+xml\"/></rootfiles></container>")
			names.push("OPS/book.opf")
			parts.push("<package xmlns=\"http://www.idpf.org/2007/opf\" version=\"2.0\"><metadata xmlns:dc=\"http://purl.org/dc/elements/1.1/\"><dc:title>Old Book</dc:title><dc:creator>A. Writer</dc:creator><dc:subject>x</dc:subject><dc:subject>y</dc:subject><dc:language>fr</dc:language><meta name=\"cover\" content=\"pic\"/></metadata><manifest><item id=\"ncx\" href=\"toc.ncx\" media-type=\"application/x-dtbncx+xml\"/><item id=\"c1\" href=\"text/c1.html\" media-type=\"application/xhtml+xml\"/><item id=\"c2\" href=\"text/c2.html\" media-type=\"application/xhtml+xml\"/><item id=\"cv\" href=\"cover.html\" media-type=\"application/xhtml+xml\"/><item id=\"pic\" href=\"img/p.png\" media-type=\"image/png\"/></manifest><spine toc=\"ncx\"><itemref idref=\"cv\" linear=\"no\"/><itemref idref=\"c1\"/><itemref idref=\"c2\"/></spine></package>")
			names.push("OPS/toc.ncx")
			parts.push("<ncx xmlns=\"http://www.daisy.org/z3986/2005/ncx/\"><navMap><navPoint><navLabel><text>First</text></navLabel><content src=\"text/c1.html\"/></navPoint><navPoint><navLabel><text>Second</text></navLabel><content src=\"text/c2.html#top\"/></navPoint></navMap></ncx>")
			names.push("OPS/cover.html")
			parts.push("<html><body><p>cover page</p></body></html>")
			names.push("OPS/text/c1.html")
			parts.push("<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>c1</title></head><body><div><p>Opening &amp; <a href=\"c2.html#deep\">jump</a>.</p><p><img src=\"../img/p.png\" alt=\"pic\"/></p></div></body></html>")
			names.push("OPS/text/c2.html")
			parts.push("<html><body><h2 id=\"deep\">Deep</h2><p>More<br/>text</p></body></html>")
			names.push("OPS/img/p.png")
			parts.push("PNGDATA")

			let out = new bytes.Buffer()
			let zip = try new Zip().create(out, WriteOptions{level: CompressionLevel.Default})
			for let (i, name) in names {
				try zip.add(Entry{name: name, method: i == 0 ?? ("store", ""), attributes: new map<string, string>()}, new bytes.Reader(parts[i].bytes()))
			}
			try zip.close()
			let codec = new Epub()
			assert codec.matchSignature(new bytes.Reader(out.bytes()))
			let doc = try codec.decode(out.bytes())
			assert doc.title == "Old Book"
			assert doc.authors.join("|") == "A. Writer"
			assert doc.language == "fr"
			assert doc.metadata["subject"] == "x, y"
			assert doc.metadata["cover"] == "img/p.png"
			let kinds = string[]
			for let (_, block) in doc.blocks {
				kinds.push("{block.kind}")
			}
			assert kinds.join(",") == "Heading,Paragraph,Image,PageBreak,Heading,Paragraph"
			assert doc.blocks[0].plainText() == "First"
			assert doc.blocks[1].inlines[1].url == "#deep"
			assert doc.blocks[2].source == "img/p.png"
			assert doc.blocks[4].plainText() == "Deep"
			let data = doc.resource("img/p.png")
			fail "no image" when data is none
			assert string(data) == "PNGDATA"
			assert doc.plainText().indexOf("cover page") < 0
			return none
		}
	}
}
