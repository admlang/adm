internal partial module std.formats.docs.epub {
	use (
		std.crypto.hash
		std.data.encoding::(XMLWriter)
		std.formats.docs.html::(HtmlWriter)
		std.formats.docs.office::*
		std.formats.docs::*
		std.time
	)

	const stylesheet = "body \{ font-family: serif; line-height: 1.4; \}\nh1, h2, h3, h4, h5, h6 \{ font-family: sans-serif; \}\npre \{ white-space: pre-wrap; font-size: 90%; \}\nblockquote \{ margin-left: 1.5em; font-style: italic; \}\ntable \{ border-collapse: collapse; \}\nth, td \{ border: 1px solid #888; padding: 0.2em 0.4em; \}\nfigure \{ text-align: center; \}\nimg \{ max-width: 100%; \}\n"

	// EpubWriter writes a Document as an EPUB 3 container, one page per
	// part between page breaks.
	type EpubWriter {
		doc Document

		def new(doc Document) {
			self.doc = doc
		}

		// encode returns the container's bytes. Fails when the zip writer
		// does.
		def encode() !byte[] {
			let chapters = split(doc.body.children)
			let anchors = new map<string, string>()
			for let (i, chapter) in chapters {
				for let (_, block) in chapter {
					anchorsOf(block, "chapter{i + 1}.xhtml", anchors)
				}
			}
			let titles = string[]
			let pages = string[]
			for let (i, chapter) in chapters {
				let title = chapterTitle(chapter, i)
				titles.push(title)
				let writer = new HtmlWriter(doc, ".")
				writer.xhtml = true
				writer.anchors = anchors
				writer.pageName = "chapter{i + 1}.xhtml"
				pages.push(writer.chapter(chapter, title, "style.css"))
			}

			let pkg = new PackageWriter()
			try pkg.add("mimetype", "application/epub+zip".bytes(), true)
			try pkg.add("META-INF/container.xml", container())
			try pkg.add("OEBPS/content.opf", opf(chapters.len()))
			try pkg.add("OEBPS/nav.xhtml", nav(titles))
			try pkg.add("OEBPS/toc.ncx", ncx(titles))
			try pkg.add("OEBPS/style.css", stylesheet)
			for let (i, page) in pages {
				try pkg.add("OEBPS/chapter{i + 1}.xhtml", page)
			}
			for let (name, data) in doc.resources {
				try pkg.add("OEBPS/" + normalize(name), data)
			}
			return try pkg.bytes()
		}

		// split returns the blocks between page breaks, parts without blocks
		// left out; one empty part for an empty document.
		def split(blocks Block[]) Block[][] {
			let out = Block[][]
			let current = Block[]
			for let (_, block) in blocks {
				if block.kind == BlockKind.PageBreak {
					out.push(current) when current.len() > 0
					current = Block[]
					continue
				}
				current.push(block)
			}
			out.push(current) when current.len() > 0 || out.len() == 0
			return out
		}

		def anchorsOf(block Block, page string, anchors map<string, string>) {
			let id = block.attributes.get("id")
			anchors.set(id, page) unless id is none
			for let (_, child) in block.children {
				anchorsOf(child, page, anchors)
			}
		}

		def chapterTitle(chapter Block[], index int) string {
			for let (_, block) in chapter {
				return block.plainText() when block.kind == BlockKind.Heading
			}
			return index == 0 && doc.title != "" ?? (doc.title, "Chapter {index + 1}")
		}

		def identifier() string {
			let known = doc.metadata.get("identifier")
			return known unless known is none
			let seed = doc.title + "|" + doc.authors.join("|") + "|" + doc.plainText()
			let crc = hash.crc32(seed.bytes())
			return "urn:adm:{crc}"
		}

		def container() string {
			let w = new XMLWriter()
			w.declaration()
			w.start("container")
			w.attribute("version", "1.0")
			w.attribute("xmlns", "urn:oasis:names:tc:opendocument:xmlns:container")
			w.start("rootfiles")
			w.start("rootfile")
			w.attribute("full-path", "OEBPS/content.opf")
			w.attribute("media-type", "application/oebps-package+xml")
			return w.str()
		}

		def opf(count int) string {
			let w = new XMLWriter()
			w.declaration()
			w.start("package")
			w.attribute("xmlns", "http://www.idpf.org/2007/opf")
			w.attribute("version", "3.0")
			w.attribute("unique-identifier", "uid")
			w.start("metadata")
			w.attribute("xmlns:dc", "http://purl.org/dc/elements/1.1/")
			w.start("dc:identifier")
			w.attribute("id", "uid")
			w.text(identifier())
			w.end()
			w.element("dc:title", doc.title == "" ?? ("Untitled", doc.title))
			w.element("dc:language", doc.language == "" ?? ("en", doc.language))
			for let (_, author) in doc.authors {
				w.element("dc:creator", author)
			}
			let date = doc.date
			w.element("dc:date", stamp(date)) unless date is none
			let subjects = doc.metadata.get("subject")
			if !(subjects is none) {
				for let (_, subject) in subjects.split(",") {
					w.element("dc:subject", subject.trim()) unless subject.trim() == ""
				}
			}
			for let (_, key) in string["description", "publisher", "rights", "contributor", "source"] {
				let found = doc.metadata.get(key)
				w.element("dc:" + key, found) unless found is none
			}
			w.start("meta")
			w.attribute("property", "dcterms:modified")
			w.text(stamp(date is none ?? (time.now(), date)))
			w.end()
			let cover = doc.metadata.get("cover")
			let coverName = cover is none ?? ("", cover)
			if coverName != "" && doc.resources.hasKey(coverName) {
				w.start("meta")
				w.attribute("name", "cover")
				w.attribute("content", "img{indexOf(coverName)}")
				w.end()
			}
			w.end()

			w.start("manifest")
			item(w, "nav", "nav.xhtml", "application/xhtml+xml", "nav")
			item(w, "ncx", "toc.ncx", "application/x-dtbncx+xml", "")
			item(w, "css", "style.css", "text/css", "")
			for let i = 1; i <= count; i++ {
				item(w, "chapter{i}", "chapter{i}.xhtml", "application/xhtml+xml", "")
			}
			let n = 0
			for let (name, _) in doc.resources {
				item(w, "img{n}", normalize(name), mediaType(name), name == coverName ?? ("cover-image", ""))
				n++
			}
			w.end()

			w.start("spine")
			w.attribute("toc", "ncx")
			for let i = 1; i <= count; i++ {
				w.start("itemref")
				w.attribute("idref", "chapter{i}")
				w.end()
			}
			return w.str()
		}

		// indexOf returns the position of the resource among the resources.
		def indexOf(name string) int {
			let n = 0
			for let (key, _) in doc.resources {
				return n when key == name
				n++
			}
			return -1
		}

		def item(w XMLWriter, id string, href string, kind string, properties string) {
			w.start("item")
			w.attribute("id", id)
			w.attribute("href", href)
			w.attribute("media-type", kind)
			w.attribute("properties", properties) unless properties == ""
			w.end()
		}

		def nav(titles string[]) string {
			let w = new XMLWriter()
			w.declaration()
			w.raw("<!DOCTYPE html>\n")
			w.start("html")
			w.attribute("xmlns", "http://www.w3.org/1999/xhtml")
			w.attribute("xmlns:epub", "http://www.idpf.org/2007/ops")
			w.start("head")
			w.element("title", doc.title == "" ?? ("Contents", doc.title))
			w.end()
			w.start("body")
			w.start("nav")
			w.attribute("epub:type", "toc")
			w.attribute("id", "toc")
			w.element("h1", "Contents")
			w.start("ol")
			for let (i, title) in titles {
				w.start("li")
				w.start("a")
				w.attribute("href", "chapter{i + 1}.xhtml")
				w.text(title)
				w.end()
				w.end()
			}
			return w.str()
		}

		def ncx(titles string[]) string {
			let w = new XMLWriter()
			w.declaration()
			w.start("ncx")
			w.attribute("xmlns", "http://www.daisy.org/z3986/2005/ncx/")
			w.attribute("version", "2005-1")
			w.start("head")
			w.start("meta")
			w.attribute("name", "dtb:uid")
			w.attribute("content", identifier())
			w.end()
			w.end()
			w.start("docTitle")
			w.element("text", doc.title == "" ?? ("Untitled", doc.title))
			w.end()
			w.start("navMap")
			for let (i, title) in titles {
				w.start("navPoint")
				w.attribute("id", "nav{i + 1}")
				w.attribute("playOrder", "{i + 1}")
				w.start("navLabel")
				w.element("text", title)
				w.end()
				w.start("content")
				w.attribute("src", "chapter{i + 1}.xhtml")
				w.end()
				w.end()
			}
			return w.str()
		}
	}
}
