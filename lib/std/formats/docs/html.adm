partial module std.formats.docs {
	use (
		std.bytes
		std.formats.docs.html::*
		std.io
		std.os
	)

	// Html is the HTML codec, for web pages and the XHTML of e-books.
	//
	// Decoding reads a page as browsers do: tags left out, void elements,
	// stray end tags, named and numeric character references, and bytes that
	// are not UTF-8 read as Windows-1252. The title, the `lang` and the
	// author, date and other meta elements become the metadata, the title
	// falling back to the level 1 heading the page opens with. Headings,
	// paragraphs, lists (start numbers, check boxes), definition lists as a
	// bold term and a quote, tables (header rows, spans, column alignment,
	// the caption as a paragraph after), preformatted code with its
	// `language-` class, quotes, rules, figures and pictures standing alone
	// become blocks; `section` a Section; other containers are read through.
	// Inline marks, links, pictures, line breaks and spans with a color, a
	// background or a `data-role` become inlines, as do bold, italic,
	// underline and strike set in a `style` attribute; other CSS is not
	// read. Footnote sections (`role="doc-endnotes"`, class `footnotes`,
	// `epub:type` footnote or endnote) become Footnote inlines where they are
	// referred to. Pictures in `data:` URIs are stored in
	// `Document.resources` as `image1.png` and so on. The id, class and
	// alignment of a block are kept in `attributes["id"]`, `styleName` and
	// `alignment`. Scripts, styles, forms and embedded media are left out.
	//
	// Encoding writes semantic HTML5 with the metadata in the head:
	// `section`, `h1`–`h6`, `p`, `ul`/`ol` (check boxes as disabled inputs),
	// `table` with `thead` and spans, `figure` with `figcaption`, `pre` and
	// `code class="language-…"`, `blockquote`, `hr`, a page break as a `div`
	// breaking the page, `strong`, `em`, `u`, `s`, `a`, `img`, `span` with a
	// color style and `data-role`, and footnotes numbered in an endnote
	// section with links both ways. Pictures in the resources are embedded
	// as `data:` URIs, or referred to in `resourceFolder`. Raw content of
	// formats other than "html" is left out.
	//
	// Example: Convert Markdown to a page
	// ```example
	// use std.formats.docs::(Html, Markdown)
	//
	// let doc = new Markdown().decode("# Hello\n\nSome *text*.")
	// println(new Html().encode(doc))
	// ```
	@codec("HTML")
	type Html {
		// Folder, relative to the page, where the page refers to the pictures
		// of `Document.resources` and `save` writes them. Empty embeds them in
		// the page as `data:` URIs.
		resourceFolder string = ""
		// Whether `encode` writes the body content only, without the doctype,
		// head and body elements, for a page to include.
		fragment       bool   = false

		mimeType string[] {
			def get() string[] {
				return string["text/html", "application/xhtml+xml"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".html", ".htm", ".xhtml"]
			}
		}

		// matchSignature reports whether the reader starts, after white space,
		// an XML declaration and comments, with `<!doctype html` or `<html`,
		// in any case.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(1024)
			let n = 0
			for n < b.len() {
				let got = r.read(b[n:]) onerror recover 0
				break when got <= 0
				n += got
			}
			let head = string(b[:n]).lower()
			let i = 0
			for i < head.len() {
				let c = head[i]
				if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == char(0xFEFF) {
					i++
					continue
				}
				let rest = head[i:]
				if rest.startsWith("<?xml") || rest.startsWith("<!--") {
					let close = rest.startsWith("<!--") ?? ("-->", "?>")
					let end = head.indexOf(close, i)
					return false when end < 0
					i = end + close.len()
					continue
				}
				return rest.startsWith("<!doctype html") || rest.startsWith("<html")
			}
			return false
		}

		// decode reads the whole reader as HTML. Any bytes decode, so it fails
		// only when the reader does.
		def decode(reader io.Reader) !Document {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes())
		}

		// decode reads the text as HTML.
		def decode(source string) Document {
			return decode(source.bytes())
		}

		// decode reads the bytes as HTML.
		def decode(source byte[]) Document {
			let parser = new HtmlParser(source)
			let doc = new Document()
			let reader = new HtmlReader(doc)
			reader.read(parser.parse())
			return doc
		}

		// encode writes the document as HTML. Fails when the writer does.
		def encode(doc Document, writer io.Writer) !none {
			try writer.write(encode(doc).bytes())
		}

		// encode returns the document as HTML text: a whole page, or the body
		// content when `fragment` is set.
		def encode(doc Document) string {
			let writer = new HtmlWriter(doc, resourceFolder)
			return fragment ?? (writer.body(), writer.page())
		}

		// save writes the document as an HTML page to the path, and, when
		// `resourceFolder` is set, the resources into that folder beside it.
		// Fails when a file or the folder cannot be written.
		def save(doc Document, path string) !none {
			try os.writeFile(path, encode(doc).bytes())
			return none when resourceFolder == "" || doc.resources.len() == 0
			let folder = os.join(os.dir(path), resourceFolder)
			try os.mkdir(folder) unless try os.exists(folder)
			for let (name, data) in doc.resources {
				try os.writeFile(os.join(folder, name), data)
			}
		}
	}
}
