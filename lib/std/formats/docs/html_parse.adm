internal partial module std.formats.docs.html {
	use (
		std.data.encoding::(XMLNode, htmlDecode)
		std.data.encoding.codepages
		std.formats.docs::*
	)

	// Elements that have no content and no end tag.
	const voidElements = " area base br col embed hr img input keygen link meta param source track wbr "

	// Elements whose start tag closes an open paragraph.
	const closesParagraph = " address article aside blockquote center details dialog dir div dl fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 header hgroup hr main menu nav ol p pre section table ul li dd dt "

	// Elements whose content is text up to their end tag, never markup.
	const rawTextElements = " script style xmp iframe noembed noframes noscript "

	// Elements whose content is text up to their end tag, with references.
	const escapableElements = " textarea title "

	// Elements an end tag looking for its start tag does not search past.
	const scopeBoundaries = " table td th caption html template "

	// isOneOf reports whether the name is a word of the space-separated set.
	def isOneOf(name string, set string) bool {
		return set.indexOf(" " + name + " ") >= 0
	}

	// HtmlParser builds an element tree from HTML the way browsers do in the
	// common cases: void elements, end tags left out of paragraphs, list
	// items and table cells, stray end tags ignored, script and style content
	// kept as text. Names are lowercased; the tree's root is `#document`.
	type HtmlParser {
		data  byte[]
		pos   int
		stack XMLNode[]

		def new(source byte[]) {
			data = toUTF8(source)
			stack = XMLNode[new XMLNode("#document")]
		}

		def parse() XMLNode {
			let n = data.len()
			pos = 3 when n >= 3 && int(data[0]) == 0xEF && int(data[1]) == 0xBB && int(data[2]) == 0xBF
			for pos < n {
				let at = data[pos:].indexOf(byte('<'))
				if at != 0 {
					let end = at < 0 ?? (n, pos + at)
					top().add(decodeReferences(data[pos:end], false))
					pos = end
					continue
				}
				markup()
			}
			return stack[0]
		}

		def top() XMLNode {
			return stack[stack.len() - 1]
		}

		// markup reads what starts at a `<`: a tag, a comment, a declaration,
		// or a lone `<` that is text.
		def markup() {
			let n = data.len()
			let next = pos + 1 < n ?? (int(data[pos + 1]), 0)
			if next == 0x21 {
				if startsWith("<!--") {
					let end = find("-->", pos + 4)
					pos = end < 0 ?? (n, end + 3)
				} else {
					let end = data[pos:].indexOf(byte('>'))
					pos = end < 0 ?? (n, pos + end + 1)
				}
				return
			}
			if next == 0x3F {
				let end = data[pos:].indexOf(byte('>'))
				pos = end < 0 ?? (n, pos + end + 1)
				return
			}
			if next == 0x2F {
				let c = pos + 2 < n ?? (int(data[pos + 2]), 0)
				if isLetter(c) {
					endTag()
					return
				}
				let end = data[pos:].indexOf(byte('>'))
				pos = end < 0 ?? (n, pos + end + 1)
				return
			}
			if !isLetter(next) {
				top().add("<")
				pos++
				return
			}
			startTag()
		}

		def startTag() {
			pos++
			let name = readName()
			let element = new XMLNode(name)
			let selfClosing = readAttributes(element)
			if name := "html" || "body" || "head" {
				let existing = findOpen(name)
				if !(existing is none) {
					for let (_, attr) in element.attributes {
						existing.set(attr.name, attr.value) when existing.attribute(attr.name) is none
					}
					return
				}
			}
			impliedEnds(name)
			top().add(element)
			return when isOneOf(name, voidElements) || selfClosing
			if isOneOf(name, rawTextElements) || isOneOf(name, escapableElements) {
				let end = findEndTag(name)
				let content = data[pos:end]
				element.add(isOneOf(name, escapableElements) ?? (decodeReferences(content, false), string(content))) when content.len() > 0
				pos = end
				return
			}
			if name == "plaintext" {
				element.add(string(data[pos:]))
				pos = data.len()
				return
			}
			stack.push(element)
		}

		// impliedEnds closes the elements a start tag of the name ends.
		def impliedEnds(name string) {
			closeOpen("p", " button " + scopeBoundaries) when isOneOf(name, closesParagraph)
			if name == "li" {
				closeOpen("li", " ul ol " + scopeBoundaries)
			} else if name == "dt" || name == "dd" {
				closeOpen("dt", " dl " + scopeBoundaries)
				closeOpen("dd", " dl " + scopeBoundaries)
			} else if name.len() == 2 && name[0] == 'h' && name[1] >= '1' && name[1] <= '6' {
				let current = top().name
				stack.pop() when current.len() == 2 && current[0] == 'h' && current[1] >= '1' && current[1] <= '6'
			} else if name == "tr" {
				closeOpen("tr", " table thead tbody tfoot html template ")
			} else if name == "td" || name == "th" {
				closeOpen("td", " tr table html template ")
				closeOpen("th", " tr table html template ")
			} else if name == "thead" || name == "tbody" || name == "tfoot" {
				closeOpen("thead", " table html template ")
				closeOpen("tbody", " table html template ")
				closeOpen("tfoot", " table html template ")
			} else if name == "a" {
				closeOpen("a", scopeBoundaries)
			} else if name == "option" {
				closeOpen("option", " select " + scopeBoundaries)
			}
		}

		// closeOpen pops the stack through the innermost open element of the
		// name, when one is open above the nearest boundary.
		def closeOpen(name string, boundaries string) {
			for let i = stack.len() - 1; i > 0; i-- {
				let open = stack[i].name
				if open == name {
					stack.len(i)
					return
				}
				return when isOneOf(open, boundaries)
			}
		}

		def findOpen(name string) ?XMLNode {
			for let (_, open) in stack {
				return open when open.name == name
			}
			return none
		}

		def endTag() {
			pos += 2
			let name = readName()
			let end = data[pos:].indexOf(byte('>'))
			pos = end < 0 ?? (data.len(), pos + end + 1)
			if name == "br" {
				top().add(new XMLNode("br"))
				return
			}
			return when name := "html" || "body" || "head"
			let tableName = isOneOf(name, " table tr td th thead tbody tfoot caption ")
			for let i = stack.len() - 1; i > 0; i-- {
				let open = stack[i].name
				if open == name {
					stack.len(i)
					return
				}
				return when !tableName && isOneOf(open, scopeBoundaries)
				return when name == "li" && (open == "ul" || open == "ol")
			}
		}

		// readAttributes reads the attributes up to the end of the tag and
		// reports whether the tag ends with `/>`.
		def readAttributes(element XMLNode) bool {
			let n = data.len()
			for pos < n {
				skipSpace()
				break when pos >= n
				let c = int(data[pos])
				if c == 0x3E {
					pos++
					return false
				}
				if c == 0x2F {
					pos++
					if pos < n && int(data[pos]) == 0x3E {
						pos++
						return true
					}
					continue
				}
				let start = pos
				pos++
				for pos < n {
					let d = int(data[pos])
					break when d := 0x20 || 0x09 || 0x0A || 0x0D || 0x0C || 0x2F || 0x3E || 0x3D
					pos++
				}
				let name = asciiLower(string(data[start:pos]))
				skipSpace()
				let value = ""
				if pos < n && int(data[pos]) == 0x3D {
					pos++
					skipSpace()
					if pos < n && (int(data[pos]) == 0x22 || int(data[pos]) == 0x27) {
						let quote = data[pos]
						pos++
						let end = data[pos:].indexOf(quote)
						let stop = end < 0 ?? (n, pos + end)
						value = decodeReferences(data[pos:stop], true)
						pos = end < 0 ?? (n, stop + 1)
					} else {
						let valueStart = pos
						for pos < n {
							let d = int(data[pos])
							break when d := 0x20 || 0x09 || 0x0A || 0x0D || 0x0C || 0x3E
							pos++
						}
						value = decodeReferences(data[valueStart:pos], true)
					}
				}
				element.set(name, value) when element.attribute(name) is none
			}
			return false
		}

		def readName() string {
			let start = pos
			let n = data.len()
			for pos < n {
				let d = int(data[pos])
				break when d := 0x20 || 0x09 || 0x0A || 0x0D || 0x0C || 0x2F || 0x3E
				pos++
			}
			return asciiLower(string(data[start:pos]))
		}

		def skipSpace() {
			let n = data.len()
			for pos < n {
				let d = int(data[pos])
				break unless d := 0x20 || 0x09 || 0x0A || 0x0D || 0x0C
				pos++
			}
		}

		def startsWith(prefix string) bool {
			let p = prefix.bytes()
			return false when pos + p.len() > data.len()
			for let i = 0; i < p.len(); i++ {
				return false unless data[pos + i] == p[i]
			}
			return true
		}

		// find returns where the text next occurs from the offset, -1 when it
		// does not.
		def find(text string, from int) int {
			let t = text.bytes()
			let n = data.len()
			let i = from
			for i + t.len() <= n {
				let next = data[i:].indexOf(t[0])
				return -1 when next < 0
				i += next
				let hit = i + t.len() <= n
				for let k = 1; hit && k < t.len(); k++ {
					hit = data[i + k] == t[k]
				}
				return i when hit
				i++
			}
			return -1
		}

		// findEndTag returns where the end tag of the raw text element starts,
		// the end of the data when it has none.
		def findEndTag(name string) int {
			let n = data.len()
			let i = pos
			for {
				let at = find("</", i)
				return n when at < 0
				let k = at + 2
				let matched = true
				for let (j, c) in name {
					if k + j >= n || asciiLowerByte(int(data[k + j])) != int(c) {
						matched = false
						break
					}
				}
				if matched {
					let after = k + name.len()
					let d = after < n ?? (int(data[after]), 0x3E)
					return at when d := 0x3E || 0x20 || 0x2F || 0x09 || 0x0A || 0x0D
				}
				i = at + 2
			}
			return n
		}
	}

	def isLetter(c int) bool {
		return (c >= 0x61 && c <= 0x7A) || (c >= 0x41 && c <= 0x5A)
	}

	def asciiLowerByte(c int) int {
		return c >= 0x41 && c <= 0x5A ?? (c + 32, c)
	}

	// asciiLower lowercases the ASCII letters of a name.
	def asciiLower(name string) string {
		for let (_, c) in name {
			return name.lower() when c >= 'A' && c <= 'Z'
		}
		return name
	}

	// decodeReferences returns the text with its character references
	// decoded the HTML way.
	def decodeReferences(raw byte[], attr bool) string {
		return string(raw) when raw.indexOf(byte('&')) < 0
		return htmlDecode(string(raw), attr)
	}

	// toUTF8 returns the bytes as UTF-8: as they are when they are valid
	// UTF-8, otherwise with each byte that starts no valid sequence read as
	// Windows-1252, the encoding browsers assume for Latin-1 pages.
	def toUTF8(source byte[]) byte[] {
		let n = source.len()
		let i = utf8Width(source, 0, true)
		return source when i >= n

		let out byte[] = []
		out.push(...source[:i])
		for i < n {
			let c = int(source[i])
			if c < 0x80 {
				out.push(source[i])
				i++
				continue
			}
			let width = utf8Width(source, i, false)
			if width > 0 {
				out.push(...source[i:i + width])
				i += width
				continue
			}
			out.append(codepages.decode(byte(c), codepages.CodePage.Windows1252))
			i++
		}
		return out
	}

	// utf8Width returns the length of the valid UTF-8 sequence at `at`, 0
	// when there is none. With `run`, it instead returns where the run of
	// valid UTF-8 starting at `at` ends.
	def utf8Width(source byte[], at int, run bool) int {
		let n = source.len()
		let i = at
		for i < n {
			let c = int(source[i])
			if c < 0x80 {
				return 1 unless run
				i++
				continue
			}
			let width = c >= 0xF0 ?? (4, c >= 0xE0 ?? (3, c >= 0xC2 ?? (2, 0)))
			let ok = width > 0 && c <= 0xF4 && i + width <= n
			for let k = 1; ok && k < width; k++ {
				ok = (int(source[i + k]) & 0xC0) == 0x80
			}
			return run ?? (i, 0) unless ok
			return width unless run
			i += width
		}
		return run ?? (n, 0)
	}
}
