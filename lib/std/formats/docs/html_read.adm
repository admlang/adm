internal partial module std.formats.docs.html {
	use (
		std.data.encoding::(XMLNode, XMLNodeKind, base64decode)
		std.formats.docs.office::(normalize)
		std.gfx.color
		std.os
		std.time
		std.formats.docs::*
	)

	// Elements that are blocks where they appear among blocks.
	const blockElements = " p h1 h2 h3 h4 h5 h6 ul ol menu dir li dl dt dd table pre blockquote hr figure figcaption div section article main header footer nav aside address center form fieldset details summary dialog hgroup body html caption "

	// Elements whose content is not part of the document text.
	const skippedElements = " head title meta link base style script noscript template iframe object embed svg math canvas audio video select button textarea input map area colgroup col source track param "

	// HtmlReader turns an element tree of an HTML page into the blocks of a
	// Document.
	type HtmlReader {
		doc          Document
		// Footnote bodies by the id their references link to.
		notes        map<string, XMLNode>
		// Ids of the elements that refer to a footnote, which back links in the
		// notes point to.
		referenceIds map<string, bool>
		// Folder of the page inside a package, for sources relative to it;
		// empty for a page on its own.
		base         string
		// Pages of the package by their path, a link to which becomes a link
		// inside the document.
		pages        map<string, bool>
		images       int

		def new(doc Document) {
			self.doc = doc
			notes = new map<string, XMLNode>()
			referenceIds = new map<string, bool>()
			pages = new map<string, bool>()
		}

		// readBody adds the blocks of the page's body to the parent, leaving
		// the metadata of its head out.
		def readBody(root XMLNode, parent Block) {
			let body = find(root, "body")
			let content = body is none ?? (root, body)
			extractNotes(content)
			blocks(content, parent)
		}

		// read adds the page's metadata and body to the document.
		def read(root XMLNode) {
			head(root)
			let body = find(root, "body")
			let content = body is none ?? (root, body)
			extractNotes(content)
			blocks(content, doc.body)
			if doc.title == "" && doc.body.children.len() > 0 {
				let opening = doc.body.children[0]
				doc.title = opening.plainText() when opening.kind == BlockKind.Heading && opening.level == 1
			}
		}

		// head reads the title, the language and the meta elements.
		def head(root XMLNode) {
			let html = find(root, "html")
			if !(html is none) {
				let lang = html.attribute("lang")
				lang = html.attribute("xml:lang") when lang is none
				doc.language = lang.trim() unless lang is none
			}
			headElements(root)
		}

		def headElements(node XMLNode) {
			for let (_, child) in node.children {
				continue unless child.kind == XMLNodeKind.Element
				let name = child.localName
				continue when name := "body" || "svg" || "math"
				if name == "title" {
					doc.title = collapse(child.text()).trim() when doc.title == ""
				} else if name == "meta" {
					readMeta(child)
				} else {
					headElements(child)
				}
			}
		}

		def readMeta(node XMLNode) {
			let key = attr(node, "name")
			key = attr(node, "property") when key == ""
			key = key.lower()
			let content = attr(node, "content").trim()
			return when key == "" || content == "" || key == "viewport"
			match key {
				case "author", "dc.creator", "dcterms.creator":
					doc.authors.push(content)
				case "date", "dc.date", "dcterms.date", "dcterms.created":
					doc.date = dateOf(content)
				case "dc.title", "dcterms.title":
					doc.title = content when doc.title == ""
				case "dc.language", "dcterms.language":
					doc.language = content when doc.language == ""
				default:
					doc.metadata.set(key, content)
			}
		}

		// extractNotes takes the footnote sections out of the tree, keeping
		// each note by its id for the references to it.
		def extractNotes(node XMLNode) {
			let kept = XMLNode[]
			let changed = false
			for let (_, child) in node.children {
				if child.kind == XMLNodeKind.Element && isNoteContainer(child) {
					collectNotes(child)
					changed = true
					continue
				}
				kept.push(child)
				extractNotes(child) when child.kind == XMLNodeKind.Element
			}
			node.children = kept when changed
		}

		def isNoteContainer(node XMLNode) bool {
			let role = attr(node, "role")
			return true when role := "doc-endnotes" || "doc-footnote" || "doc-endnote"
			let kind = epubType(node)
			return true when hasWord(kind, "footnote") || hasWord(kind, "footnotes") || hasWord(kind, "endnote") || hasWord(kind, "endnotes") || hasWord(kind, "rearnote") || hasWord(kind, "rearnotes")
			return hasWord(attr(node, "class"), "footnotes")
		}

		def collectNotes(node XMLNode) {
			let id = attr(node, "id")
			let kind = epubType(node)
			let role = attr(node, "role")
			let single = hasWord(kind, "footnote") || hasWord(kind, "endnote") || hasWord(kind, "rearnote") || role == "doc-footnote" || role == "doc-endnote"
			if single && id != "" {
				notes.set(id, node)
				return
			}
			node.walk(def (child XMLNode) bool {
				let childId = attr(child, "id")
				if childId != "" && (child.localName == "li" || child.localName == "aside" || child.localName == "div" || child.localName == "p") {
					notes.set(childId, child) unless notes.hasKey(childId)
				}
				return true
			})
		}

		// blocks reads the children of a block container into the parent,
		// gathering runs of inline content into paragraphs.
		def blocks(node XMLNode, parent Block) {
			let pending = Inline[]
			for let (_, child) in node.children {
				if child.kind == XMLNodeKind.Text {
					pending.push(text(collapse(child.content)))
					continue
				}
				let name = child.localName
				continue when isOneOf(name, skippedElements)
				if isOneOf(name, blockElements) {
					flush(pending, parent)
					pending = Inline[]
					block(child, parent)
				} else {
					inline(child, pending)
				}
			}
			flush(pending, parent)
		}

		// flush adds the inlines as a Paragraph, or as an Image block when they
		// are one image.
		def flush(pending Inline[], parent Block) {
			let items = tidy(pending)
			let breaks = 0
			for let (_, item) in items {
				breaks++ when item.kind == InlineKind.LineBreak
			}
			return when breaks == items.len()
			if items.len() == 1 && items[0].kind == InlineKind.Image {
				let image = parent.image(items[0].url)
				image.title = items[0].title
				image.inlines = items[0].children
				return
			}
			let paragraph = new Block(BlockKind.Paragraph)
			paragraph.inlines = items
			parent.add(paragraph)
		}

		def block(node XMLNode, parent Block) {
			let name = node.localName
			match name {
				case "p":
					let before = parent.children.len()
					let items = Inline[]
					inlines(node, items)
					flush(items, parent)
					if parent.children.len() > before {
						let made = parent.children[parent.children.len() - 1]
						decorate(made, node) when made.kind == BlockKind.Paragraph
					}
				case "h1", "h2", "h3", "h4", "h5", "h6":
					let items = Inline[]
					inlines(node, items)
					let heading = new Block(BlockKind.Heading)
					heading.level = int(name[1]) - int('0')
					heading.inlines = tidy(items)
					decorate(heading, node)
					parent.add(heading) when heading.inlines.len() > 0
				case "ul", "ol", "menu", "dir":
					list(node, parent)
				case "dl":
					definitions(node, parent)
				case "table":
					table(node, parent)
				case "pre":
					codeBlock(node, parent)
				case "blockquote":
					let quote = parent.quote()
					decorate(quote, node)
					blocks(node, quote)
				case "hr":
					parent.rule()
				case "figure":
					figure(node, parent)
				case "section":
					let section = new Block(BlockKind.Section)
					decorate(section, node)
					blocks(node, section)
					parent.add(section) when section.children.len() > 0
				case "div":
					if isPageBreak(node) {
						parent.pageBreak()
						return when node.children.len() == 0
					}
					blocks(node, parent)
				default:
					blocks(node, parent)
			}
		}

		def isPageBreak(node XMLNode) bool {
			for let (_, property) in string["break-after", "break-before", "page-break-after", "page-break-before"] {
				let value = styleValue(node, property)
				return true when value := "page" || "always"
			}
			return false
		}

		// decorate copies the id, the class and the alignment of the element
		// onto the block.
		def decorate(block Block, node XMLNode) {
			let id = attr(node, "id")
			block.attributes.set("id", id) unless id == ""
			let classes = attr(node, "class").trim()
			block.styleName = classes unless classes == ""
			block.alignment = alignmentOf(node)
		}

		def list(node XMLNode, parent Block) {
			let list = new Block(BlockKind.List)
			list.ordered = node.localName == "ol"
			let start = attr(node, "start")
			list.start = start.trim().toInt<int>() unless start == ""
			decorate(list, node)
			let loose = XMLNode[]
			for let (_, child) in node.children {
				if child.kind == XMLNodeKind.Element && child.localName == "li" {
					flushLoose(loose, list)
					loose = XMLNode[]
					let item = new Block(BlockKind.Item)
					item.checked = checkbox(child)
					blocks(child, item)
					list.add(item)
				} else if child.kind == XMLNodeKind.Element && (child.localName == "ul" || child.localName == "ol") && list.children.len() > 0 && loose.len() == 0 {
					block(child, list.children[list.children.len() - 1])
				} else {
					loose.push(child)
				}
			}
			flushLoose(loose, list)
			parent.add(list) when list.children.len() > 0
		}

		// flushLoose reads content a list holds outside its items into an item
		// of its own, when it is more than white space.
		def flushLoose(loose XMLNode[], list Block) {
			return when loose.len() == 0
			let holder = new XMLNode("li")
			holder.children = loose
			let item = new Block(BlockKind.Item)
			blocks(holder, item)
			list.add(item) when item.children.len() > 0
		}

		// checkbox returns the state of the check box a list item starts with,
		// none when it starts with none.
		def checkbox(item XMLNode) ?bool {
			let node = item
			for let depth = 0; depth < 2; depth++ {
				let next ?XMLNode = none
				for let (_, child) in node.children {
					if child.kind == XMLNodeKind.Text {
						continue when child.content.trim() == ""
						return none
					}
					if child.localName == "input" {
						return none unless attr(child, "type").lower() == "checkbox"
						return !(child.attribute("checked") is none)
					}
					next = child
					break
				}
				return none when next is none
				node = next
			}
			return none
		}

		def definitions(node XMLNode, parent Block) {
			for let (_, child) in node.children {
				continue unless child.kind == XMLNodeKind.Element
				if child.localName == "dt" {
					let items = Inline[]
					inlines(child, items)
					let term = tidy(items)
					parent.paragraph(bold(...term)) when term.len() > 0
				} else if child.localName == "dd" {
					blocks(child, parent.quote())
				} else {
					definitions(child, parent)
				}
			}
		}

		def table(node XMLNode, parent Block) {
			let table = new Block(BlockKind.Table)
			decorate(table, node)
			let caption ?XMLNode = none
			let rows = XMLNode[]
			let heads = bool[]
			for let (_, child) in node.children {
				continue unless child.kind == XMLNodeKind.Element
				let name = child.localName
				if name == "tr" {
					rows.push(child)
					heads.push(false)
				} else if name == "thead" || name == "tbody" || name == "tfoot" {
					for let (_, tr) in child.elements("tr") {
						rows.push(tr)
						heads.push(name == "thead")
					}
				} else if name == "caption" {
					caption = child
				}
			}

			let aligned = new map<int, Alignment>()
			for let (r, tr) in rows {
				let row = new Block(BlockKind.Row)
				let allHeader = true
				let column = 0
				for let (_, cell) in tr.children {
					continue unless cell.kind == XMLNodeKind.Element && (cell.localName == "td" || cell.localName == "th")
					let block = new Block(BlockKind.Cell)
					block.columnSpan = spanOf(cell, "colspan")
					block.rowSpan = spanOf(cell, "rowspan")
					allHeader = allHeader && cell.localName == "th"
					let alignment = alignmentOf(cell)
					aligned.set(column, alignment) when alignment != Alignment.Default && !aligned.hasKey(column)
					column += block.columnSpan
					blocks(cell, block)
					row.add(block)
				}
				continue when row.children.len() == 0
				row.header = heads[r] || allHeader
				table.add(row)
			}
			return when table.children.len() == 0
			let width = 0
			for let (_, row) in table.children {
				let span = 0
				for let (_, cell) in row.children {
					span += cell.columnSpan
				}
				width = span when span > width
			}
			for let i = 0; i < width; i++ {
				let alignment = aligned.get(i)
				table.alignments.push(alignment is none ?? (Alignment.Default, alignment))
			}
			parent.add(table)
			if !(caption is none) {
				let items = Inline[]
				inlines(caption, items)
				let words = tidy(items)
				if words.len() > 0 {
					let paragraph = parent.paragraph(...words)
					paragraph.styleName = "caption"
				}
			}
		}

		def spanOf(cell XMLNode, name string) int {
			let value = attr(cell, name)
			return 1 when value == ""
			let span = value.trim().toInt<int>()
			return span < 1 ?? (1, span)
		}

		def codeBlock(node XMLNode, parent Block) {
			let content = node.text()
			content = content[1:] when content.startsWith("\n")
			content = content[:content.len() - 1] when content.endsWith("\n")
			let language = languageOf(node)
			if language == "" {
				let inner = node.child("code")
				language = languageOf(inner) unless inner is none
			}
			let block = parent.code(language, content)
			let id = attr(node, "id")
			block.attributes.set("id", id) unless id == ""
		}

		def languageOf(node XMLNode) string {
			let lang = attr(node, "data-lang")
			return lang unless lang == ""
			for let (_, word) in attr(node, "class").split(" ") {
				return word[9:] when word.startsWith("language-")
				return word[5:] when word.startsWith("lang-")
			}
			return ""
		}

		def figure(node XMLNode, parent Block) {
			let pictures = node.descendants("img")
			if pictures.len() != 1 {
				blocks(node, parent)
				return
			}
			let img = pictures[0]
			let image = parent.image(source(attr(img, "src")))
			image.title = attr(img, "title")
			decorate(image, node)
			let caption = node.child("figcaption")
			let items = Inline[]
			if caption is none {
				let alt = collapse(attr(img, "alt")).trim()
				items.push(text(alt)) unless alt == ""
			} else {
				inlines(caption, items)
			}
			image.inlines = tidy(items)
			for let (_, child) in node.children {
				continue unless child.kind == XMLNodeKind.Element && child.localName != "figcaption" && child.localName != "img"
				continue when child.descendants("img").len() > 0
				blocks(child, parent)
			}
		}

		// inlines reads the children of the element as inline content.
		def inlines(node XMLNode, out Inline[]) {
			for let (_, child) in node.children {
				if child.kind == XMLNodeKind.Text {
					out.push(text(collapse(child.content)))
				} else {
					inline(child, out)
				}
			}
		}

		def inline(node XMLNode, out Inline[]) {
			let name = node.localName
			match name {
				case "strong", "b":
					out.push(wrap(InlineKind.Bold, node))
				case "em", "i", "cite", "dfn", "var":
					out.push(wrap(InlineKind.Italic, node))
				case "u", "ins":
					out.push(wrap(InlineKind.Underline, node))
				case "s", "strike", "del":
					out.push(wrap(InlineKind.Strike, node))
				case "code", "kbd", "samp", "tt":
					out.push(code(collapse(node.text())))
				case "br":
					out.push(lineBreak())
				case "img":
					let image = new Inline(InlineKind.Image)
					image.url = source(attr(node, "src"))
					image.title = attr(node, "title")
					let alt = collapse(attr(node, "alt")).trim()
					image.children.push(text(alt)) unless alt == ""
					out.push(image)
				case "a":
					anchor(node, out)
				case "span", "font":
					styledSpan(node, out)
				case "wbr":
					return
				default:
					return when isOneOf(name, skippedElements)
					inlines(node, out)
			}
		}

		def wrap(kind InlineKind, node XMLNode) Inline {
			let inline = new Inline(kind)
			inlines(node, inline.children)
			return inline
		}

		def anchor(node XMLNode, out Inline[]) {
			let href = attr(node, "href").trim()
			let role = attr(node, "role")
			if href.startsWith("#") {
				let target = href[1:]
				return when referenceIds.hasKey(target) || role == "doc-backlink" || hasWord(attr(node, "class"), "footnote-back")
				let note = notes.get(target)
				if !(note is none) {
					notes.delete(target)
					let id = attr(node, "id")
					referenceIds.set(id, true) unless id == ""
					let holder = new Block(BlockKind.Section)
					blocks(note, holder)
					let footnote = new Inline(InlineKind.Footnote)
					footnote.note = holder.children
					out.push(footnote)
					return
				}
			}
			if href == "" {
				inlines(node, out)
				return
			}
			let link = new Inline(InlineKind.Link)
			link.url = href
			if pages.len() > 0 && href.indexOf("://") < 0 && !href.startsWith("#") {
				let hash = href.indexOf("#")
				let path = hash < 0 ?? (href, href[:hash])
				let fragment = hash < 0 ?? ("", href[hash + 1:])
				link.url = "#" + fragment when fragment != "" && pages.hasKey(normalize(base + "/" + path))
			}
			link.title = attr(node, "title")
			inlines(node, link.children)
			out.push(link)
		}

		// styledSpan reads a span or font element: its colors and data-role
		// into a Styled inline, bold, italic, underline and strike set in its
		// style attribute into those marks.
		def styledSpan(node XMLNode, out Inline[]) {
			let children = Inline[]
			inlines(node, children)
			let foreground = colorOf(styleValue(node, "color"))
			foreground = colorOf(attr(node, "color")) when foreground is none && node.localName == "font"
			let background = colorOf(styleValue(node, "background-color"))
			background = colorOf(styleValue(node, "background")) when background is none
			let role = attr(node, "data-role")
			let result = children
			let weight = styleValue(node, "font-weight")
			if weight := "bold" || "bolder" || "600" || "700" || "800" || "900" {
				result = Inline[mark(InlineKind.Bold, result)]
			}
			result = Inline[mark(InlineKind.Italic, result)] when styleValue(node, "font-style") == "italic"
			let decoration = styleValue(node, "text-decoration")
			decoration = styleValue(node, "text-decoration-line") when decoration == ""
			result = Inline[mark(InlineKind.Underline, result)] when decoration.indexOf("underline") >= 0
			result = Inline[mark(InlineKind.Strike, result)] when decoration.indexOf("line-through") >= 0
			if !(foreground is none) || !(background is none) || role != "" {
				let styled = mark(InlineKind.Styled, result)
				styled.foreground = foreground
				styled.background = background
				styled.role = role
				result = Inline[styled]
			}
			out.push(...result)
		}

		// source returns what an image refers to: a resource made from a data
		// URI, a resource of the package the page belongs to, or the source as
		// it is.
		def source(src string) string {
			let value = src.trim()
			if value.startsWith("data:") {
				let comma = value.indexOf(",")
				let header = comma < 0 ?? ("", value[5:comma])
				if comma > 0 && header.endsWith(";base64") {
					let data = base64decode(value[comma + 1:].replace(" ", "")) onerror recover byte[]
					if data.len() > 0 {
						images++
						let name = "image{images}.{extensionOf(header[:header.len() - 7])}"
						doc.resources.set(name, data)
						return name
					}
				}
				return value
			}
			return value when base == "" || value.indexOf("://") >= 0
			let path = value
			let hash = path.indexOf("#")
			path = path[:hash] when hash >= 0
			path = normalize(base + "/" + path)
			return doc.resources.hasKey(path) ?? (path, value)
		}
	}

	// dateOf reads an RFC 3339 timestamp or a plain `2026-09-21` date, none
	// when the value is neither.
	def dateOf(value string) ?time.Time {
		let stamp = value.len() == 10 ?? (value + "T00:00:00Z", value)
		let failed = false
		let parsed = time.parse(stamp) onerror (err error) {
			failed = true
			recover time.now()
		}
		return none when failed
		return parsed
	}

	// mark returns an inline of the kind around the parts.
	def mark(kind InlineKind, parts Inline[]) Inline {
		let inline = new Inline(kind)
		inline.children = parts
		return inline
	}

	// extensionOf returns the file extension for an image media type.
	def extensionOf(mime string) string {
		match mime.lower() {
			case "image/jpeg", "image/jpg":
				return "jpg"
			case "image/gif":
				return "gif"
			case "image/svg+xml":
				return "svg"
			case "image/webp":
				return "webp"
			case "image/bmp":
				return "bmp"
			case "image/tiff":
				return "tiff"
			default:
				return "png"
		}
	}

	// find returns the first element of the local name at any depth, none
	// when there is none.
	def find(root XMLNode, name string) ?XMLNode {
		let found = root.descendants(name)
		return found.len() > 0 ?? (found[0], none)
	}

	// attr returns the value of the attribute, empty when there is none.
	def attr(node XMLNode, name string) string {
		let value = node.attribute(name)
		return value is none ?? ("", value)
	}

	// epubType returns the `epub:type` of the element, empty when it has none.
	def epubType(node XMLNode) string {
		let value = node.attribute("type", "http://www.idpf.org/2007/ops")
		value = node.attribute("epub:type") when value is none
		return value is none ?? ("", value)
	}

	// hasWord reports whether the space-separated list holds the word.
	def hasWord(list string, word string) bool {
		return list != "" && (" " + list + " ").indexOf(" " + word + " ") >= 0
	}

	// styleValue returns a property of the element's style attribute,
	// lowercased and trimmed, empty when it is not set.
	def styleValue(node XMLNode, property string) string {
		let css = attr(node, "style")
		return "" when css == ""
		for let (_, declaration) in css.split(";") {
			let colon = declaration.indexOf(":")
			continue when colon < 0
			continue unless declaration[:colon].trim().lower() == property
			let value = declaration[colon + 1:].trim().lower()
			return value.trimSuffix("!important").trim()
		}
		return ""
	}

	// alignmentOf reads text-align from the style, or the align attribute.
	def alignmentOf(node XMLNode) Alignment {
		let value = styleValue(node, "text-align")
		value = attr(node, "align").lower() when value == ""
		match value {
			case "left", "start":
				return Alignment.Left
			case "center":
				return Alignment.Center
			case "right", "end":
				return Alignment.Right
			case "justify":
				return Alignment.Justify
			default:
				return Alignment.Default
		}
	}

	// colorOf parses a CSS color, none when it is empty or not one.
	def colorOf(value string) ?color.Color {
		let text = value.trim()
		return none when text := "" || "inherit" || "transparent" || "initial" || "currentcolor"
		let failed = false
		let parsed = color.parse(text) onerror (err error) {
			failed = true
			recover new color.Color("#000000")
		}
		return none when failed
		return parsed
	}

	// collapse returns the text with each run of white space made one space.
	def collapse(content string) string {
		let raw = content.bytes()
		let out byte[] = []
		let space = false
		let changed = false
		for let i = 0; i < raw.len(); i++ {
			let c = int(raw[i])
			if c := 0x20 || 0x09 || 0x0A || 0x0D || 0x0C {
				changed = true when c != 0x20 || space
				space = true
				continue
			}
			if space {
				out.push(byte(' '))
				space = false
			}
			out.push(raw[i])
		}
		out.push(byte(' ')) when space
		return changed ?? (string(out), content)
	}

	// tidy drops the white space collapsed text leaves at the start and end
	// of a paragraph, twice between words, and before a line break, and the
	// spans left empty.
	def tidy(items Inline[]) Inline[] {
		let (out, _) = squeeze(items, true)
		trimEnd(out)
		return out
	}

	def squeeze(items Inline[], afterSpace bool) (Inline[], bool) {
		let out = Inline[]
		let space = afterSpace
		for let (_, item) in items {
			match item.kind {
				case InlineKind.Text:
					let content = item.content
					content = content[1:] when space && content.startsWith(" ")
					continue when content == ""
					space = content.endsWith(" ")
					out.push(content == item.content ?? (item, text(content)))
				case InlineKind.LineBreak:
					trimEnd(out)
					out.push(item)
					space = true
				case InlineKind.Bold, InlineKind.Italic, InlineKind.Underline, InlineKind.Strike, InlineKind.Styled:
					let (children, after) = squeeze(item.children, space)
					continue when children.len() == 0
					item.children = children
					space = after
					out.push(item)
				case InlineKind.Link:
					let (children, after) = squeeze(item.children, space)
					item.children = children
					space = after
					out.push(item)
				case InlineKind.Footnote:
					space = false
					out.push(item)
				default:
					space = false
					out.push(item)
			}
		}
		return (out, space)
	}

	// trimEnd drops the white space the inlines end with.
	def trimEnd(items Inline[]) {
		for items.len() > 0 {
			let last = items[items.len() - 1]
			if last.kind == InlineKind.Text {
				let content = last.content.trimEnd(" ")
				if content == "" {
					items.pop()
					continue
				}
				items[items.len() - 1] = text(content) unless content == last.content
				return
			}
			return unless last.kind == InlineKind.Bold || last.kind == InlineKind.Italic || last.kind == InlineKind.Underline || last.kind == InlineKind.Strike || last.kind == InlineKind.Styled || last.kind == InlineKind.Link
			trimEnd(last.children)
			return unless last.children.len() == 0 && last.kind != InlineKind.Link
			items.pop()
		}
	}
}
