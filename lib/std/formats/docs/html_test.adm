partial module std.formats.docs {
	use (
		std.bytes
		std.gfx.color
		std.testing
	)

	check "Html" {
		// htmlSample builds a document with every construct the codec writes.
		internal def htmlSample() Document {
			let doc = new Document("Quarterly Report")
			doc.authors.push("Ann Lee", "Bo Chen")
			doc.metadata.set("description", "Sales & more")
			doc.language = "de-DE"
			doc.heading(1, "Summary").attributes.set("id", "summary")
			doc.paragraph(text("Revenue "), bold("grew"), text(" by "), italic(text("a "), bold("lot")), text(", "), strike("not"), text(" see "), link("the site", "https://a.example/x?q=1&r=2#top", "Home"), text(" and "), code("x<y>"), text(" "), underline("under"), text("."))
			doc.paragraph(text("Colors: "), colored("red", new color.Color(color.RGBA{r: 255, g: 0, b: 0, a: 255})), text(" and "), styled("warn", "danger"), text(" Ünïcødé — 😀 <&>"), lineBreak(), text("next line"), footnote("A note."))
			doc.paragraph("centered").alignment = Alignment.Center
			doc.paragraph("styled").styleName = "Fancy"
			doc.heading(2, "Lists")
			let items = doc.list(string["one", "two"])
			items.children[0].list(string["nested a", "nested b"], true).start = 4
			let tasks = doc.list(string["done", "open"])
			tasks.children[0].checked = true
			tasks.children[1].checked = false
			let quote = doc.quote()
			quote.paragraph("quoted")
			quote.quote().paragraph("deeper")
			doc.code("go", "func main() \{\n\tprintln(\"<1>\")\n\}")
			doc.rule()
			let table = doc.table(string["Region", "Sales"], string[][string["North", "120"], string["South", "95"]])
			table.alignments[1] = Alignment.Right
			doc.image("chart.png", byte[0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a], "The chart")
			doc.image("https://a.example/logo.svg")
			doc.paragraph(text("with "), footnote("Second."), text(" end"))
			return doc
		}

		@test()
		def TestEncode() {
			let html = new Html().encode(htmlSample())
			assert html.startsWith("<!DOCTYPE html>\n<html lang=\"de-DE\">\n<head>\n<meta charset=\"utf-8\">")
			assert html.indexOf("<title>Quarterly Report</title>") > 0
			assert html.indexOf("<meta name=\"author\" content=\"Ann Lee\">\n<meta name=\"author\" content=\"Bo Chen\">") > 0
			assert html.indexOf("<meta name=\"description\" content=\"Sales &amp; more\">") > 0
			assert html.indexOf("<h1 id=\"summary\">Summary</h1>") > 0
			assert html.indexOf("<p>Revenue <strong>grew</strong> by <em>a <strong>lot</strong></em>, <s>not</s> see <a href=\"https://a.example/x?q=1&amp;r=2#top\" title=\"Home\">the site</a> and <code>x&lt;y&gt;</code> <u>under</u>.</p>") > 0
			assert html.indexOf("<span style=\"color: #f00\">red</span> and <span data-role=\"danger\">warn</span> Ünïcødé — 😀 &lt;&amp;&gt;<br>next line<sup><a href=\"#fn1\" id=\"fnref1\" role=\"doc-noteref\">1</a></sup></p>") > 0
			assert html.indexOf("<p style=\"text-align: center\">centered</p>\n<p class=\"Fancy\">styled</p>") > 0
			assert html.indexOf("<ul>\n  <li>one\n    <ol start=\"4\">\n      <li>nested a</li>") > 0
			assert html.indexOf("<li><input type=\"checkbox\" disabled checked> done</li>\n  <li><input type=\"checkbox\" disabled> open</li>") > 0
			assert html.indexOf("<blockquote>\n  <p>quoted</p>\n  <blockquote>\n    <p>deeper</p>\n  </blockquote>\n</blockquote>") > 0
			assert html.indexOf("<pre><code class=\"language-go\">func main() \{\n\tprintln(\"&lt;1&gt;\")\n\}</code></pre>") > 0
			assert html.indexOf("<thead>\n    <tr>\n      <th>Region</th>\n      <th style=\"text-align: right\">Sales</th>") > 0
			assert html.indexOf("<img src=\"data:image/png;base64,iVBORw0KGgo=\" alt=\"The chart\">\n  <figcaption>The chart</figcaption>") > 0
			assert html.indexOf("<img src=\"https://a.example/logo.svg\" alt=\"\">") > 0
			assert html.indexOf("<li id=\"fn2\"><p>Second. <a href=\"#fnref2\" class=\"footnote-back\" role=\"doc-backlink\">↩</a></p></li>") > 0
			assert html.endsWith("</ol>\n</section>\n</body>\n</html>\n")

			let codec = new Html()
			codec.fragment = true
			codec.resourceFolder = "media"
			let body = codec.encode(htmlSample())
			assert body.startsWith("<h1 id=\"summary\">")
			assert body.indexOf("<img src=\"media/chart.png\"") > 0
		}

		@test()
		def TestRoundTrip() !none {
			let codec = new Html()
			let doc = htmlSample()
			let encoded = codec.encode(doc)
			let back = codec.decode(encoded)
			assert back.title == doc.title
			assert back.authors.join("|") == "Ann Lee|Bo Chen"
			assert back.metadata.len() == 1 && back.metadata["description"] == "Sales & more"
			assert back.language == "de-DE"
			let markdown = new Markdown()
			assert markdown.encode(back) == markdown.encode(doc).replace("chart.png", "image1.png")
			assert back.blocks[0].attributes["id"] == "summary"
			assert back.blocks[3].alignment == Alignment.Center
			assert back.blocks[4].styleName == "Fancy"
			let data = back.resource("image1.png")
			fail "no picture" when data is none
			assert data.len() == 8
			assert codec.encode(back) == encoded.replace("chart.png", "image1.png")
			return none
		}

		@test()
		def TestTolerantParsing() {
			let source = "<!doctype html><HTML><head><title>T &amp; U</title><meta name=viewport content=x><style>p \{ color: red \}</style>\n<script>if (a < b && c) document.write('<p>no</p>')</script></head>\n<BODY><P>one<p>two &copy 2026 &#150; &notin; &nbsp;x</P>\n<ul><li>a<li>b <b>bold <i>both</b> after</i></ul>\n<table><tr><th>H1<th>H2<tr><td align=right>1<td colspan=2>2</table>\n<div>loose text</div></span></div>\n<p>after<!-- comment --> <img src=x.png alt='the x'></p>\n<p><img src=\"only.png\" alt=\"Only\"></p>\n<br><dl><dt>Term<dd>Meaning</dl>"
			let doc = new Html().decode(source)
			assert doc.title == "T & U"
			assert doc.metadata.len() == 0
			let kinds = string[]
			for let (_, block) in doc.blocks {
				kinds.push("{block.kind}")
			}
			assert kinds.join(",") == "Paragraph,Paragraph,List,Table,Paragraph,Paragraph,Image,Paragraph,Quote"
			assert doc.blocks[0].plainText() == "one"
			assert doc.blocks[1].plainText() == "two © 2026 – ∉  x"
			let list = doc.blocks[2]
			assert list.children.len() == 2
			assert list.children[1].plainText() == "b bold both after"
			let table = doc.blocks[3]
			assert table.children.len() == 2
			assert table.children[0].header
			assert !table.children[1].header
			assert table.children[1].children[1].columnSpan == 2
			assert table.alignments.len() == 3
			assert table.alignments[0] == Alignment.Right
			assert table.children[1].children[0].plainText() == "1"
			assert doc.blocks[4].plainText() == "loose text"
			let para = doc.blocks[5]
			assert para.inlines.len() == 2
			assert para.inlines[1].kind == InlineKind.Image
			assert para.inlines[1].url == "x.png"
			assert doc.blocks[6].source == "only.png"
			assert doc.blocks[6].plainText() == "Only"
			assert doc.blocks[7].inlines[0].kind == InlineKind.Bold
			assert doc.blocks[8].plainText() == "Meaning"
		}

		@test()
		def TestWhitespaceAndInlines() {
			let doc = new Html().decode("<p>  lots   of\n\tspace <em> here </em> and<br> \n there  </p><pre>\n  keep\n    this\n</pre><p><span style=\"font-weight: bold; color: rgb(0, 0, 255)\">blue</span> <a name=\"x\">anchor</a> <a href=\"/p\">link</a></p>")
			assert doc.blocks[0].plainText() == "lots of space here and\nthere"
			assert doc.blocks[1].kind == BlockKind.Code
			assert doc.blocks[1].content == "  keep\n    this"
			let inlines = doc.blocks[2].inlines
			assert inlines[0].kind == InlineKind.Styled
			assert inlines[0].children[0].kind == InlineKind.Bold
			let blue = inlines[0].foreground
			assert !(blue is none)
			assert inlines[inlines.len() - 1].kind == InlineKind.Link && inlines[inlines.len() - 1].url == "/p"
			assert doc.blocks[2].plainText() == "blue anchor link"
		}

		@test()
		def TestFootnoteForms() {
			let epub = new Html().decode("<html xmlns:epub=\"http://www.idpf.org/2007/ops\"><body><p>Text<a epub:type=\"noteref\" href=\"#n1\">1</a>.</p><aside epub:type=\"footnote\" id=\"n1\"><p>The note.</p></aside></body></html>")
			assert epub.blocks.len() == 1
			let note = epub.blocks[0].inlines[1]
			assert note.kind == InlineKind.Footnote
			assert note.note[0].plainText() == "The note."
			assert epub.plainText() == "Text."
		}

		@test()
		def TestWindows1252() {
			let data = "<p>caf".bytes() + byte[0xE9, 0x20, 0x93] + "q".bytes() + byte[0x94] + "</p>".bytes()
			let doc = new Html().decode(data)
			assert doc.plainText() == "café “q”"
		}

		@test()
		def TestSignatureAndLoad() !none {
			let codec = new Html()
			assert codec.matchSignature(new bytes.Reader("\n  <!DOCTYPE HTML><p>x".bytes()))
			assert codec.matchSignature(new bytes.Reader("<?xml version=\"1.0\"?>\n<!-- c --><html xmlns=\"http://www.w3.org/1999/xhtml\">".bytes()))
			assert !codec.matchSignature(new bytes.Reader("<p>fragment</p>".bytes()))
			let doc = try load("<!DOCTYPE html><title>Hi</title><h1>Head</h1>".bytes())
			assert doc.title == "Hi"
			assert doc.blocks[0].kind == BlockKind.Heading
			let fragment = try load(new bytes.Reader("<p>x</p>".bytes()), ".htm")
			assert fragment.plainText() == "x"
			let untitled = codec.decode("<h1>Opening</h1><p>x</p>")
			assert untitled.title == "Opening"
			return none
		}
	}
}
