internal partial module std.formats.docs.html {
	use (
		std.data.encoding::(base64encode, htmlEncode)
		std.formats.docs.office::(mediaType, textOf)
		std.gfx.color
		std.formats.docs::*
	)

	// HtmlWriter writes a Document as HTML5.
	type HtmlWriter {
		doc      Document
		// Where pictures in the resources are referred to: empty embeds them
		// as data URIs.
		folder   string
		out      byte[]
		// Footnotes met so far, numbered in this order.
		notes    Inline[]
		// Whether to write XHTML: empty elements closed, attributes with
		// values.
		xhtml    bool
		// Page of each id when the document is split into pages, so a link to
		// an id on another page names that page.
		anchors  map<string, string>
		pageName string

		def new(doc Document, folder string) {
			self.doc = doc
			self.folder = folder
			out = byte[]
			notes = Inline[]
			anchors = new map<string, string>()
		}

		// page writes the whole page: doctype, head and body.
		def page() string {
			line(0, "<!DOCTYPE html>")
			let lang = doc.language == "" ?? ("", " lang=\"{escape(doc.language)}\"")
			line(0, "<html{lang}>")
			line(0, "<head>")
			line(0, "<meta charset=\"utf-8\">")
			line(0, "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
			line(0, "<title>{escapeText(doc.title)}</title>")
			for let (_, author) in doc.authors {
				line(0, "<meta name=\"author\" content=\"{escape(author)}\">")
			}
			let date = doc.date
			if !(date is none) {
				let stamp = date.str()
				stamp = stamp[:10] when stamp.endsWith("T00:00:00Z")
				line(0, "<meta name=\"dcterms.date\" content=\"{escape(stamp)}\">")
			}
			let keys = doc.metadata.keys()
			keys.sort((a string, b string) => a.compare(b) < 0)
			for let (_, key) in keys {
				let value = doc.metadata.get(key)
				line(0, "<meta name=\"{escape(key)}\" content=\"{escape(value)}\">") unless value is none
			}
			line(0, "</head>")
			line(0, "<body>")
			body()
			line(0, "</body>")
			line(0, "</html>")
			return string(out)
		}

		// chapter writes an XHTML page of an e-book holding the blocks and
		// their footnotes.
		def chapter(items Block[], title string, stylesheet string) string {
			line(0, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
			line(0, "<!DOCTYPE html>")
			let lang = doc.language == "" ?? ("", " lang=\"{escape(doc.language)}\" xml:lang=\"{escape(doc.language)}\"")
			line(0, "<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\"{lang}>")
			line(0, "<head>")
			line(0, "<meta charset=\"utf-8\"/>")
			line(0, "<title>{escapeText(title)}</title>")
			line(0, "<link rel=\"stylesheet\" type=\"text/css\" href=\"{escape(stylesheet)}\"/>") unless stylesheet == ""
			line(0, "</head>")
			line(0, "<body>")
			blocks(items, 0)
			footnotes()
			line(0, "</body>")
			line(0, "</html>")
			return string(out)
		}

		def closer() string {
			return xhtml ?? ("/>", ">")
		}

		// body writes the blocks and the footnotes after them.
		def body() string {
			blocks(doc.body.children, 0)
			footnotes()
			return string(out)
		}

		def footnotes() {
			return when notes.len() == 0
			line(0, "<section class=\"footnotes\" role=\"doc-endnotes\">")
			line(0, "<hr{closer()}")
			line(0, "<ol>")
			// A note may hold notes of its own, which join the end of the list.
			for let i = 0; i < notes.len(); i++ {
				let n = i + 1
				let back = "<a href=\"#fnref{n}\" class=\"footnote-back\" role=\"doc-backlink\">↩</a>"
				let body = notes[i].note
				if body.len() == 1 && body[0].kind == BlockKind.Paragraph {
					line(1, "<li id=\"fn{n}\"><p>{inlines(body[0].inlines)} {back}</p></li>")
					continue
				}
				line(1, "<li id=\"fn{n}\">")
				blocks(body, 2)
				line(2, "<p>{back}</p>")
				line(1, "</li>")
			}
			line(0, "</ol>")
			line(0, "</section>")
		}

		def blocks(items Block[], depth int) {
			for let (_, block) in items {
				write(block, depth)
			}
		}

		def write(block Block, depth int) {
			match block.kind {
				case BlockKind.Section:
					line(depth, "<section{attributes(block)}>")
					blocks(block.children, depth + 1)
					line(depth, "</section>")
				case BlockKind.Heading:
					let level = block.level.clamp(1, 6)
					line(depth, "<h{level}{attributes(block)}>{inlines(block.inlines)}</h{level}>")
				case BlockKind.Paragraph:
					line(depth, "<p{attributes(block)}>{inlines(block.inlines)}</p>")
				case BlockKind.List:
					list(block, depth)
				case BlockKind.Table:
					table(block, depth)
				case BlockKind.Image:
					line(depth, "<figure{attributes(block)}>")
					let title = block.title == "" ?? ("", " title=\"{escape(block.title)}\"")
					line(depth + 1, "<img src=\"{escape(source(block.source))}\" alt=\"{escape(textOf(block.inlines))}\"{title}{closer()}")
					line(depth + 1, "<figcaption>{inlines(block.inlines)}</figcaption>") when block.inlines.len() > 0
					line(depth, "</figure>")
				case BlockKind.Code:
					let language = block.language == "" ?? ("", " class=\"language-{escape(block.language)}\"")
					line(depth, "<pre{attributes(block)}><code{language}>{escapeText(block.content)}</code></pre>")
				case BlockKind.Quote:
					line(depth, "<blockquote{attributes(block)}>")
					blocks(block.children, depth + 1)
					line(depth, "</blockquote>")
				case BlockKind.Rule:
					line(depth, "<hr{closer()}")
				case BlockKind.PageBreak:
					line(depth, "<div style=\"break-after: page\"></div>")
				case BlockKind.Raw:
					line(depth, block.content) when block.format == "html"
				default:
					blocks(block.children, depth)
			}
		}

		def list(block Block, depth int) {
			let tag = block.ordered ?? ("ol", "ul")
			let start = block.ordered && block.start != 1 ?? (" start=\"{block.start}\"", "")
			line(depth, "<{tag}{start}{attributes(block)}>")
			for let (_, item) in block.children {
				let box = ""
				let checked = item.checked
				if !(checked is none) {
					let disabled = xhtml ?? (" disabled=\"disabled\"", " disabled")
					let on = xhtml ?? (" checked=\"checked\"", " checked")
					box = checked ?? ("<input type=\"checkbox\"{disabled}{on}{closer()} ", "<input type=\"checkbox\"{disabled}{closer()} ")
				}
				let children = item.children
				if children.len() == 0 {
					line(depth + 1, "<li>{box}</li>")
				} else if children.len() == 1 && children[0].kind == BlockKind.Paragraph && plain(children[0]) {
					line(depth + 1, "<li>{box}{inlines(children[0].inlines)}</li>")
				} else if children[0].kind == BlockKind.Paragraph && plain(children[0]) && tight(children) {
					line(depth + 1, "<li>{box}{inlines(children[0].inlines)}")
					blocks(children[1:], depth + 2)
					line(depth + 1, "</li>")
				} else {
					line(depth + 1, "<li>{box}")
					blocks(children, depth + 2)
					line(depth + 1, "</li>")
				}
			}
			line(depth, "</{tag}>")
		}

		// tight reports whether the item holds one paragraph and then only lists.
		def tight(children Block[]) bool {
			for let i = 1; i < children.len(); i++ {
				return false unless children[i].kind == BlockKind.List
			}
			return true
		}

		// plain reports whether the paragraph carries nothing its element would
		// have to hold.
		def plain(block Block) bool {
			return block.styleName == "" && block.alignment == Alignment.Default && block.attributes.len() == 0
		}

		def table(block Block, depth int) {
			line(depth, "<table{attributes(block)}>")
			let rows = block.children
			let heads = 0
			for heads < rows.len() && rows[heads].header {
				heads++
			}
			if heads > 0 {
				line(depth + 1, "<thead>")
				for let i = 0; i < heads; i++ {
					row(block, rows[i], depth + 2, true)
				}
				line(depth + 1, "</thead>")
			}
			if heads < rows.len() {
				line(depth + 1, "<tbody>")
				for let i = heads; i < rows.len(); i++ {
					row(block, rows[i], depth + 2, rows[i].header)
				}
				line(depth + 1, "</tbody>")
			}
			line(depth, "</table>")
		}

		def row(table Block, row Block, depth int, header bool) {
			line(depth, "<tr>")
			let tag = header ?? ("th", "td")
			let column = 0
			for let (_, cell) in row.children {
				let extra = ""
				extra += " colspan=\"{cell.columnSpan}\"" when cell.columnSpan > 1
				extra += " rowspan=\"{cell.rowSpan}\"" when cell.rowSpan > 1
				let alignment = cell.alignment
				alignment = table.alignments[column] when alignment == Alignment.Default && column < table.alignments.len()
				extra += alignStyle(alignment)
				column += cell.columnSpan
				let children = cell.children
				if children.len() == 0 {
					line(depth + 1, "<{tag}{extra}></{tag}>")
				} else if children.len() == 1 && children[0].kind == BlockKind.Paragraph && plain(children[0]) {
					line(depth + 1, "<{tag}{extra}>{inlines(children[0].inlines)}</{tag}>")
				} else {
					line(depth + 1, "<{tag}{extra}>")
					blocks(children, depth + 2)
					line(depth + 1, "</{tag}>")
				}
			}
			line(depth, "</tr>")
		}

		// attributes returns the id, class, alignment and data attributes of the
		// block as HTML attributes.
		def attributes(block Block) string {
			let markup = ""
			let id = block.attributes.get("id")
			markup += " id=\"{escape(id)}\"" unless id is none
			markup += " class=\"{escape(block.styleName)}\"" unless block.styleName == ""
			markup += alignStyle(block.alignment)
			let keys = block.attributes.keys()
			keys.sort((a string, b string) => a.compare(b) < 0)
			for let (_, key) in keys {
				continue unless key.startsWith("data-") || key == "lang" || key == "dir" || key == "title"
				let value = block.attributes.get(key)
				markup += " {key}=\"{escape(value)}\"" unless value is none
			}
			return markup
		}

		def alignStyle(alignment Alignment) string {
			match alignment {
				case Alignment.Left:
					return " style=\"text-align: left\""
				case Alignment.Center:
					return " style=\"text-align: center\""
				case Alignment.Right:
					return " style=\"text-align: right\""
				case Alignment.Justify:
					return " style=\"text-align: justify\""
				default:
					return ""
			}
		}

		def inlines(items Inline[]) string {
			let markup = ""
			for let (_, item) in items {
				markup += inline(item)
			}
			return markup
		}

		def inline(item Inline) string {
			match item.kind {
				case InlineKind.Text:
					return escapeText(item.content)
				case InlineKind.Bold:
					return "<strong>{inlines(item.children)}</strong>"
				case InlineKind.Italic:
					return "<em>{inlines(item.children)}</em>"
				case InlineKind.Underline:
					return "<u>{inlines(item.children)}</u>"
				case InlineKind.Strike:
					return "<s>{inlines(item.children)}</s>"
				case InlineKind.Code:
					return "<code>{escapeText(item.content)}</code>"
				case InlineKind.Link:
					let title = item.title == "" ?? ("", " title=\"{escape(item.title)}\"")
					let href = item.url
					if href.startsWith("#") {
						let target = anchors.get(href[1:])
						href = target + href when !(target is none) && target != pageName
					}
					return "<a href=\"{escape(href)}\"{title}>{inlines(item.children)}</a>"
				case InlineKind.Image:
					let title = item.title == "" ?? ("", " title=\"{escape(item.title)}\"")
					return "<img src=\"{escape(source(item.url))}\" alt=\"{escape(textOf(item.children))}\"{title}{closer()}"
				case InlineKind.Styled:
					let css = string[]
					let foreground = item.foreground
					css.push("color: " + hex(foreground)) unless foreground is none
					let background = item.background
					css.push("background-color: " + hex(background)) unless background is none
					let attrs = css.len() == 0 ?? ("", " style=\"{css.join("; ")}\"")
					attrs += " data-role=\"{escape(item.role)}\"" unless item.role == ""
					return "<span{attrs}>{inlines(item.children)}</span>"
				case InlineKind.LineBreak:
					return "<br{closer()}"
				case InlineKind.Footnote:
					notes.push(item)
					let n = notes.len()
					return "<sup><a href=\"#fn{n}\" id=\"fnref{n}\" role=\"doc-noteref\">{n}</a></sup>"
				case InlineKind.Raw:
					return item.format == "html" ?? (item.content, "")
				default:
					return inlines(item.children)
			}
		}

		// source returns how the page refers to an image: a data URI or a path
		// in the resource folder for a resource, the source itself otherwise.
		def source(name string) string {
			let data = doc.resources.get(name)
			return name when data is none
			return name when folder == "."
			return folder + "/" + name unless folder == ""
			return "data:{mediaType(name)};base64,{base64encode(data)}"
		}

		def hex(value color.Color) string {
			return value.css(color.ColorFormat.Hex)
		}

		def line(depth int, content string) {
			for let i = 0; i < depth; i++ {
				out.push(byte(' '), byte(' '))
			}
			out.push(...content.bytes())
			out.push(byte('\n'))
		}
	}

	// escape returns the text escaped for an attribute value.
	def escape(value string) string {
		return htmlEncode(value)
	}

	// escapeText returns the text escaped for element content.
	def escapeText(value string) string {
		let raw = value.bytes()
		for let i = 0; i < raw.len(); i++ {
			let c = int(raw[i])
			return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;") when c := 0x26 || 0x3C || 0x3E
		}
		return value
	}
}
