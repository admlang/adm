partial module std.formats.docs {
	use (
		std.bytes
		std.errors
		std.formats
		std.io
		std.os
		std.reflection
		std.time
	)

	// DocumentError is the payload of a document that does not decode or encode.
	struct DocumentError {
		message string
		code    string            = "document"
		cause   ?error
		stack   errors.StackTrace
		// Name of the codec that failed, as registered with `codec`.
		format  string
		// Line of the source the error was found on, 0 when the format has no
		// lines or the line is unknown.
		line    int
	}

	// DocumentDecoder reads a document from a reader.
	interface DocumentDecoder {
		// decode reads the whole reader. Fails with a DocumentError when the
		// content is not valid for the format, or with the reader's own error.
		def decode(reader io.Reader) !Document
	}

	// DocumentEncoder writes a document to a writer.
	interface DocumentEncoder {
		// encode writes the document in the codec's format. What the format
		// cannot express is simplified or left out, never an error. Fails with
		// the writer's own error.
		def encode(doc Document, writer io.Writer) !none
	}

	// DocumentCodec is what a document format registers: a decoder, an encoder
	// and the file format description.
	type DocumentCodec = DocumentDecoder & DocumentEncoder & formats.FileFormat

	// codec registers a type as the document codec of the named format, found
	// through discovery.
	meta def codec<DocumentCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	internal let codecRegistry = new formats.CodecRegistry<DocumentCodec>("document", codec)

	// load reads the document in the file. The codec is found by the file's
	// signature, then by its extension, since text formats have no signature.
	// Fails when the file cannot be read, no codec claims it, or decoding does.
	def load(path string) !Document {
		let f = try os.open(path)
		defer f.close()

		let r = new bytes.RewindableReader(f)
		let found = sniff(r) onerror recover none
		if found is none {
			let byExtension = codecRegistry.matchExt(os.extension(path))
			fail "no document codec reads \"{path}\"" when byExtension is none
			r.rewind().freeze()
			return byExtension.decode(r)
		}

		let (dec, body) = found
		return dec.decode(body)
	}

	// load reads a document from the bytes, the codec found by signature.
	// Fails when no codec claims the data, or decoding does.
	def load(data byte[]) !Document {
		let (dec, r) = try codecRegistry.probe(data)
		return dec.decode(r)
	}

	// load reads a document from the reader, the codec found by signature.
	// Fails when no codec claims the data, or decoding does.
	def load(reader io.Reader) !Document {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.decode(r)
	}

	// load reads a document from the reader with the codec registered for the
	// file extension (".md", ".html"), for formats that have no signature.
	// Fails when no codec has the extension, or decoding does.
	def load(reader io.Reader, extension string) !Document {
		let dec = codecRegistry.matchExt(extension)
		fail "no document codec has the extension \"{extension}\"" when dec is none
		return dec.decode(reader)
	}

	// documentDate reads an RFC 3339 timestamp or a plain `2026-09-21` date, the
	// two forms text formats write a document date in.
	internal def documentDate(value string) !?time.Time {
		let stamp = value
		stamp = value + "T00:00:00Z" when value.len() == 10
		return try time.parse(stamp)
	}

	// sniff returns the codec whose signature the reader carries, with a reader
	// rewound to the start, none when there is no such codec.
	internal def sniff(reader io.Reader) !?(DocumentCodec, io.Reader) {
		return try codecRegistry.probe(reader)
	}
}
