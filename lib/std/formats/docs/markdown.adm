partial module std.formats.docs {
	use (
		std.bytes
		std.io
		std.formats.docs.markdown::*
	)

	// Markdown is the Markdown codec: CommonMark with the GitHub extensions
	// (tables, strikethrough, task lists, footnotes, bare links).
	//
	// Two additions carry what plain Markdown cannot:
	//   - a front matter block between `---` lines holds the metadata: `title`,
	//     `author` or `authors`, `date`, `language`, any other key lands in
	//     `Document.metadata`. Without a title there, the title is the level 1
	//     heading the document starts with.
	//   - tags style a span: `[color=red]…[/color]`, `[background=#202020]…[/]`
	//     and a theme role, `[danger]…[/]`. A role tag is read only when its
	//     closing tag follows. `<u>…</u>` is underline.
	//
	// A paragraph holding one image becomes an Image block. HTML is kept as Raw
	// blocks and inlines of the format "html".
	//
	// Encoding leaves out what Markdown has no syntax for: block alignment,
	// named styles, attributes, cell spans, page breaks, and Raw content of
	// formats other than "md" and "html". A table cell is written on one line.
	//
	// Example: Read help text
	// ```example
	// use std.formats.docs::(Markdown)
	//
	// let markdown = new Markdown()
	// let doc = markdown.decode("Removes the **whole** folder, [danger]without asking[/].")
	// print(doc.plainText())
	// ```
	@codec("Markdown")
	type Markdown {
		mimeType string[] {
			def get() string[] {
				return string["text/markdown", "text/x-markdown"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".md", ".markdown"]
			}
		}

		// matchSignature is always false: Markdown is plain text and carries no
		// signature, so it is found by its file extension.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// decode reads the whole reader as Markdown. Any text is valid Markdown,
		// so it fails only when the reader does.
		def decode(reader io.Reader) !Document {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(string(source.bytes()))
		}

		// decode reads the text as Markdown.
		def decode(source string) Document {
			let decoder = new MarkdownDecoder()
			return decoder.decode(source)
		}

		// encode writes the document as Markdown. Fails when the writer does.
		def encode(doc Document, writer io.Writer) !none {
			try writer.write(encode(doc).bytes())
		}

		// encode returns the document as Markdown text.
		def encode(doc Document) string {
			let encoder = new MarkdownEncoder()
			return encoder.encode(doc)
		}
	}
}

internal partial module std.formats.docs.markdown {
	use (
		std.formats.docs::*
		std.bytes
		std.io
		std.formats.docs.tree::*
	)

	// Tag names that open an HTML block even in the middle of other content.
	const markdownBlockTags = " address article aside base basefont blockquote body caption center col colgroup dd details dialog dir div dl dt fieldset figcaption figure footer form frame frameset h1 h2 h3 h4 h5 h6 head header hr html iframe legend li link main menu menuitem nav noframes ol optgroup option p param pre script search section style summary table tbody td textarea tfoot th thead title tr track ul "

	// MarkdownLink is the target a link label stands for.
	struct MarkdownLink {
		url   string
		title string
	}

	// MarkdownMarker describes the list marker a line starts with.
	struct MarkdownMarker {
		// Column where the content of the item starts.
		width     int
		ordered   bool
		start     int
		// The bullet, or the character after the number.
		delimiter char
		// Whether nothing follows the marker on its line.
		blank     bool
	}

	// MarkdownDecoder reads the block structure line by line, keeping the text of
	// headings, paragraphs and cells in `Block.content` until every link and
	// footnote definition is known, then parses that text into inlines.
	//
	// Every line a reader handles is the end of one source line with its
	// indentation's tabs expanded (readers only cut lines at the front), so
	// the index of that source line, carried beside it in `origins`, gives
	// each character its place in the source.
	type MarkdownDecoder {
		// Link reference definitions by normalized label.
		links          map<string, MarkdownLink>
		// Footnote definitions by label.
		notes          map<string, Block[]>
		// Where each source line ends in the source, its line end left out.
		lineEnds       int[]
		// The headings, paragraphs and cells whose `content` is parsed into
		// inlines once the definitions are known, in document order, and the
		// first of each one's segments.
		textBlocks     Block[]
		textFirst      int[]
		// Where the characters of those texts come from, in runs of segments:
		// from the index `segmentStarts[s]` of its text on, each character is
		// the source's from `segmentSources[s]` on, one for one, up to the
		// next segment. A text's segments run up to the next text's first.
		segmentStarts  int[]
		segmentSources int[]

		def new() {
			links = new map<string, MarkdownLink>()
			notes = new map<string, Block[]>()
			lineEnds = int[]
			textBlocks = Block[]
			textFirst = int[]
			segmentStarts = int[]
			segmentSources = int[]
		}

		def decode(source string) Document {
			let doc = new Document()
			let lines = source.replace("\r\n", "\n").replace("\r", "\n").split("\n")
			let returns = source.contains("\r")
			let start = 0
			// Tabs inside a fenced code block are content, not indentation.
			let fence = ""
			for let i = 0; i < lines.len(); i++ {
				let raw = lines[i]
				let end = start + raw.len()
				lineEnds.push(end)
				start = end + 1
				start++ when returns && source[end] == '\r' && source[end + 1] == '\n'
				let content = raw.trimStart(" \t>")
				if fence == "" {
					lines[i] = expandTabs(raw)
					let length = fenceLength(content)
					fence = content[:length] when length > 0
				} else if content.startsWith(fence) && content.trimStart(fence[:1]).trim() == "" {
					lines[i] = expandTabs(raw)
					fence = ""
				}
			}

			let first = frontMatter(lines, doc)
			let content = string[]
			let origins = int[]
			for let i = first; i < lines.len(); i++ {
				content.push(lines[i])
				origins.push(i)
			}
			doc.body.sourceStart = 0
			doc.body.sourceEnd = source.len()
			readBlocks(content, origins, doc.body)

			for let k = 0; k < textBlocks.len(); k++ {
				resolve(k)
			}

			if doc.title == "" && doc.body.children.len() > 0 {
				let opening = doc.body.children[0]
				doc.title = opening.plainText() when opening.kind == BlockKind.Heading && opening.level == 1
			}
			return doc
		}

		// sourceAt returns the position in the source of the character at the
		// index of the line, which is the end of the source line `origin`: it
		// lies as far before that line's end. Expanding tabs changed only the
		// indentation, so this holds for a character past it, and every block
		// and text starts at a character that is not white space.
		def sourceAt(origin int, line string, at int) int {
			return lineEnds[origin] - line.len() + at
		}

		// place sets where the block lies in the source: from the first
		// character of `lines[from]` that is not white space to the end of the
		// last line before `to` that is not blank.
		def place(block Block, lines string[], origins int[], from int, to int) {
			block.sourceStart = sourceAt(origins[from], lines[from], leadingSpace(lines[from]))
			let last = to - 1
			for last > from && isBlank(lines[last]) {
				last--
			}
			block.sourceEnd = sourceAt(origins[last], lines[last], contentEnd(lines[last]))
		}

		// leadingSpace returns how many spaces and tabs the line starts with.
		def leadingSpace(line string) int {
			let i = 0
			for i < line.len() && (line[i] == ' ' || line[i] == '\t') {
				i++
			}
			return i
		}

		// contentEnd returns the length of the line without the spaces and
		// tabs it ends in.
		def contentEnd(line string) int {
			let end = line.len()
			for end > 0 && (line[end - 1] == ' ' || line[end - 1] == '\t') {
				end--
			}
			return end
		}

		// keep adds the block's text, whose segments start at `first`, to the
		// texts parsed once the definitions are known.
		def keep(block Block, first int) {
			textBlocks.push(block)
			textFirst.push(first)
		}

		def addSegment(at int, source int) {
			segmentStarts.push(at)
			segmentSources.push(source)
		}

		// textEnd returns the index after the last segment of the text.
		def textEnd(text int) int {
			return segmentStarts.len() when text + 1 == textFirst.len()
			return textFirst[text + 1]
		}

		// track keeps the block's one-line text for parsing.
		def track(block Block, part string, origin int) {
			let first = segmentStarts.len()
			addSegment(0, sourceAt(origin, part, 0))
			keep(block, first)
		}

		// trackCell keeps the text of the cell at line[from:to] for parsing. It
		// lost the backslash of each `\|` in it: the characters after one come
		// from one further on.
		def trackCell(paragraph Block, line string, origin int, from int, to int) {
			let first = segmentStarts.len()
			addSegment(0, sourceAt(origin, line, from))
			let removed = 0
			let i = from
			for i + 1 < to {
				if line[i] == '\\' && line[i + 1] == '|' {
					removed++
					addSegment(i + 1 - from - removed, sourceAt(origin, line, i + 1))
					i += 2
					continue
				}
				i++
			}
			keep(paragraph, first)
		}

		// expandTabs replaces the tabs of the indentation with spaces up to the
		// next multiple of four columns.
		def expandTabs(line string) string {
			return line unless line.contains("\t")

			let column = 0
			let i = 0
			for i < line.len() {
				let c = line[i]
				if c == '\t' {
					column += 4 - (column % 4)
				} else if c == ' ' {
					column++
				} else {
					break
				}
				i++
			}
			return " ".repeat(column) + line[i:]
		}

		def indentOf(line string) int {
			let i = 0
			for i < line.len() && line[i] == ' ' {
				i++
			}
			return i
		}

		def isBlank(line string) bool {
			return line.trim() == ""
		}

		// frontMatter reads the metadata block the lines start with into the
		// document and returns the index of the first line after it, 0 when there
		// is no such block.
		def frontMatter(lines string[], doc Document) int {
			return 0 when lines.len() < 2 || lines[0].trimEnd() != "---"

			let end = -1
			for let i = 1; i < lines.len(); i++ {
				let line = lines[i].trimEnd()
				if line := "---" || "..." {
					end = i
					break
				}
			}
			return 0 when end < 0

			let key = ""
			for let i = 1; i < end; i++ {
				let line = lines[i]
				let entry = line.trim()
				continue when entry == "" || entry.startsWith("#")

				if line.startsWith(" ") {
					frontValue(doc, key, unquote(entry[2:].trim())) when entry.startsWith("- ")
					continue
				}

				let colon = line.indexOf(":")
				continue when colon < 1
				key = line[:colon].trim()
				let value = line[colon + 1:].trim()
				continue when value == ""

				if value.startsWith("[") && value.endsWith("]") {
					for let (_, part) in splitList(value[1:value.len() - 1]) {
						frontValue(doc, key, part)
					}
					continue
				}
				frontValue(doc, key, unquote(value))
			}
			return end + 1
		}

		def frontValue(doc Document, key string, value string) {
			switch key.lower() {
				case "title":
					doc.title = value
				case "author", "authors":
					doc.authors.push(value)
				case "lang", "language":
					doc.language = value
				case "date":
					let parsed = documentDate(value) onerror recover none
					if parsed is none {
						doc.metadata.set(key, value)
					} else {
						doc.date = parsed
					}
				default:
					let known = doc.metadata.get(key)
					if known is none {
						doc.metadata.set(key, value)
					} else {
						doc.metadata.set(key, known + ", " + value)
					}
			}
		}

		// unquote removes the quotes around a front matter value.
		def unquote(value string) string {
			return value when value.len() < 2
			return value[1:value.len() - 1].replace("\\\"", "\"").replace("\\\\", "\\") when value.startsWith("\"") && value.endsWith("\"")
			return value[1:value.len() - 1] when value.startsWith("'") && value.endsWith("'")
			return value
		}

		// splitList splits the inside of a `[a, "b, c"]` front matter list.
		def splitList(content string) string[] {
			let out = string[]
			let current = ""
			let quote = char(0)
			for let (_, c) in content {
				if quote != char(0) {
					quote = char(0) when c == quote
				} else if c == '"' || c == '\'' {
					quote = c
				} else if c == ',' {
					out.push(unquote(current.trim()))
					current = ""
					continue
				}
				current += string(c)
			}
			out.push(unquote(current.trim())) unless current.trim() == ""
			return out
		}

		// readBlocks parses the lines into children of the parent. `origins`
		// holds the index of the source line each line is the end of.
		def readBlocks(lines string[], origins int[], parent Block) {
			let i = 0
			for i < lines.len() {
				if isBlank(lines[i]) {
					i++
					continue
				}
				let count = parent.children.len()
				let next = readBlock(lines, origins, i, parent)
				for let k = count; k < parent.children.len(); k++ {
					place(parent.children[k], lines, origins, i, next)
				}
				i = next
			}
		}

		// readBlock reads the block that starts at the line into the parent and
		// returns the index of the line after it. Definitions add no block.
		def readBlock(lines string[], origins int[], from int, parent Block) int {
			let line = lines[from]
			return readIndented(lines, from, parent) when indentOf(line) >= 4

			let content = line.trimStart()
			return readFence(lines, from, parent) when fenceLength(content) > 0

			let level = headingLevel(content)
			if level > 0 {
				let heading = new Block(BlockKind.Heading)
				heading.level = level
				heading.content = headingText(content, level)
				track(heading, content[level:].trimStart(), origins[from])
				parent.add(heading)
				return from + 1
			}
			if isRule(content) {
				parent.rule()
				return from + 1
			}
			return readQuote(lines, origins, from, parent) when content.startsWith(">")
			return readList(lines, origins, from, parent) unless marker(line) is none
			return readHTML(lines, from, parent) when isHTML(content)

			let label = noteLabel(content)
			return readNote(lines, origins, from, label) when label != ""
			return from + 1 when linkDefinition(content)

			let alignments = tableAt(lines, from)
			return readParagraph(lines, origins, from, parent) when alignments is none
			return readTable(lines, origins, from, alignments, parent)
		}

		// headingLevel returns the level of an ATX heading line, 0 for any other
		// line.
		def headingLevel(content string) int {
			let level = 0
			for level < content.len() && content[level] == '#' {
				level++
			}
			return 0 when level == 0 || level > 6
			return level when level == content.len() || content[level] == ' '
			return 0
		}

		// headingText returns the text of an ATX heading without its closing `#`s.
		def headingText(content string, level int) string {
			let title = content[level:].trim()
			let end = title.len()
			for end > 0 && title[end - 1] == '#' {
				end--
			}
			return "" when end == 0
			return title[:end].trimEnd() when title[end - 1] == ' '
			return title
		}

		// isRule reports a thematic break: three or more `-`, `*` or `_`.
		def isRule(content string) bool {
			return false when content == ""
			let mark = content[0]
			return false unless (mark := '-' || '*' || '_')

			let count = 0
			for let (_, c) in content {
				continue when c == ' '
				return false unless c == mark
				count++
			}
			return count >= 3
		}

		// fenceLength returns the length of the code fence the line opens, 0 when
		// it opens none.
		def fenceLength(content string) int {
			return 0 when content == ""
			let mark = content[0]
			return 0 unless (mark := '`' || '~')

			let count = 0
			for count < content.len() && content[count] == mark {
				count++
			}
			return 0 when count < 3
			return 0 when mark == '`' && content[count:].contains("`")
			return count
		}

		def readFence(lines string[], from int, parent Block) int {
			let indent = indentOf(lines[from])
			let opening = lines[from].trimStart()
			let mark = opening[0]
			let length = fenceLength(opening)
			let language = opening[length:].trim().split(" ")[0]

			let body = string[]
			let i = from + 1
			for i < lines.len() {
				let line = lines[i]
				let content = line.trimStart()
				i++
				if indentOf(line) < 4 && content != "" && content[0] == mark {
					let closing = fenceLength(content)
					break when closing >= length && content[closing:].trim() == ""
				}

				let strip = indentOf(line)
				strip = indent when strip > indent
				body.push(line[strip:])
			}
			parent.code(language, body.join("\n"))
			return i
		}

		def readIndented(lines string[], from int, parent Block) int {
			let body = string[]
			let i = from
			for i < lines.len() {
				let line = lines[i]
				if isBlank(line) {
					body.push("")
				} else if indentOf(line) >= 4 {
					body.push(line[4:])
				} else {
					break
				}
				i++
			}
			for body.len() > 0 && body[body.len() - 1] == "" {
				body.pop()
			}
			parent.code("", body.join("\n"))
			return i
		}

		def readQuote(lines string[], origins int[], from int, parent Block) int {
			let body = string[]
			let bodyOrigins = int[]
			let fenced = false
			let i = from
			for i < lines.len() {
				let line = lines[i]
				let content = line.trimStart()
				if indentOf(line) < 4 && content.startsWith(">") {
					let inner = content[1:]
					inner = inner[1:] when inner.startsWith(" ")
					fenced = !fenced when fenceLength(inner.trimStart()) > 0
					body.push(inner)
					bodyOrigins.push(origins[i])
					i++
					continue
				}

				// A paragraph of the quote may go on without the `>`.
				break when fenced || isBlank(line) || startsBlock(line)
				break when body.len() == 0 || isBlank(body[body.len() - 1])
				body.push(content)
				bodyOrigins.push(origins[i])
				i++
			}
			readBlocks(body, bodyOrigins, parent.quote())
			return i
		}

		// marker returns the list marker the line starts with, none when it
		// starts with none.
		def marker(line string) ?MarkdownMarker {
			let indent = indentOf(line)
			return none when indent >= 4 || indent >= line.len()

			let content = line[indent:]
			let delimiter = content[0]
			let after = 1
			let ordered = false
			let start = 1
			if delimiter.isDigit() {
				let digits = 0
				for digits < content.len() && digits < 9 && content[digits].isDigit() {
					digits++
				}
				return none when digits >= content.len()
				delimiter = content[digits]
				return none unless (delimiter := '.' || ')')
				ordered = true
				start = content[:digits].toInt<int>()
				after = digits + 1
			} else {
				return none unless (delimiter := '-' || '+' || '*')
			}

			let spaces = 0
			for after + spaces < content.len() && content[after + spaces] == ' ' {
				spaces++
			}
			return MarkdownMarker{width: indent + after + 1, ordered: ordered, start: start, delimiter: delimiter, blank: true} when after + spaces >= content.len()
			return none when spaces == 0

			// More than four spaces start an indented code block inside the item.
			spaces = 1 when spaces > 4
			return MarkdownMarker{width: indent + after + spaces, ordered: ordered, start: start, delimiter: delimiter, blank: false}
		}

		def readList(lines string[], origins int[], from int, parent Block) int {
			let first = marker(lines[from])
			return from + 1 when first is none

			let list = new Block(BlockKind.List)
			list.ordered = first.ordered
			list.start = first.start

			let i = from
			for i < lines.len() {
				let line = lines[i]
				let current = marker(line)
				break when current is none || isRule(line.trimStart())
				break unless current.ordered == first.ordered && current.delimiter == first.delimiter

				let body = string[]
				if current.blank {
					body.push("")
				} else {
					body.push(line[current.width:])
				}
				let bodyOrigins = int[origins[i]]
				let end = readNested(lines, origins, i + 1, current.width, body, bodyOrigins)

				let item = new Block(BlockKind.Item)
				let text = textBlocks.len()
				readBlocks(body, bodyOrigins, item)
				taskState(item, text)
				place(item, lines, origins, i, end)
				list.add(item)
				i = end

				// Blank lines between two items belong to the list.
				let next = i
				for next < lines.len() && isBlank(lines[next]) {
					next++
				}
				break when next >= lines.len() || marker(lines[next]) is none
				i = next
			}
			parent.add(list)
			return i
		}

		// readNested moves the lines of a container whose content starts at the
		// column `width` into body and returns the index of the line after them.
		def readNested(lines string[], origins int[], from int, width int, body string[], bodyOrigins int[]) int {
			let i = from
			for i < lines.len() {
				let line = lines[i]
				if isBlank(line) {
					let next = i
					for next < lines.len() && isBlank(lines[next]) {
						next++
					}
					break when next >= lines.len() || indentOf(lines[next]) < width
					for i < next {
						body.push("")
						bodyOrigins.push(origins[i])
						i++
					}
					continue
				}
				if indentOf(line) >= width {
					body.push(line[width:])
					bodyOrigins.push(origins[i])
					i++
					continue
				}

				// A paragraph of the container may go on without the indentation.
				break when body.len() == 0 || body[body.len() - 1] == ""
				break when startsBlock(line) || line.trimStart().startsWith("[^")
				break unless marker(line) is none
				body.push(line.trimStart())
				bodyOrigins.push(origins[i])
				i++
			}
			return i
		}

		// taskState reads the `[ ]` or `[x]` a task list item starts with.
		// `text` is the index of the item's first text.
		def taskState(item Block, text int) {
			return when item.children.len() == 0
			let first = item.children[0]
			return unless first.kind == BlockKind.Paragraph

			let content = first.content
			if content.startsWith("[ ] ") {
				item.checked = false
			} else if content.startsWith("[x] ") || content.startsWith("[X] ") {
				item.checked = true
			} else {
				return
			}
			first.content = content[4:]
			// The four characters are on the paragraph's first line.
			first.sourceStart += 4
			let opening = textFirst[text]
			segmentSources[opening] += 4
			for let s = opening + 1; s < textEnd(text); s++ {
				segmentStarts[s] -= 4
			}
		}

		// startsBlock reports whether the line opens a block that ends the
		// paragraph before it.
		def startsBlock(line string) bool {
			return false when indentOf(line) >= 4

			let content = line.trimStart()
			return true when headingLevel(content) > 0 || fenceLength(content) > 0
			return true when content.startsWith(">") || isRule(content)

			let found = marker(line)
			return false when found is none
			return false when found.blank
			return !found.ordered || found.start == 1
		}

		// isHTML reports whether the line opens an HTML block.
		def isHTML(content string) bool {
			return false unless content.startsWith("<") && content.len() > 2
			return true when content.startsWith("<!--") || content.startsWith("<?") || content.startsWith("<!")

			let i = 1
			i = 2 when content[1] == '/'
			let start = i
			for i < content.len() && (content[i].isAlphanumeric() || content[i] == '-') {
				i++
			}
			return false when i == start || !content[start].isLetter()
			if i < content.len() {
				let next = content[i]
				return false unless (next := ' ' || '>' || '/')
			}
			return true when markdownBlockTags.contains(" " + content[start:i].lower() + " ")

			// Any other tag opens a block only when it has the line to itself.
			let line = content.trimEnd()
			return line.endsWith(">") && line.count(">") == 1
		}

		def readHTML(lines string[], from int, parent Block) int {
			let comment = lines[from].trimStart().startsWith("<!--")
			let body = string[]
			let i = from
			for i < lines.len() {
				let line = lines[i]
				break when !comment && isBlank(line)
				body.push(line)
				i++
				break when comment && line.contains("-->")
			}
			parent.raw("html", body.join("\n"))
			return i
		}

		// noteLabel returns the label of the footnote definition the line opens,
		// empty for any other line.
		def noteLabel(content string) string {
			return "" unless content.startsWith("[^")
			let close = content.indexOf("]:")
			return "" when close < 3

			let label = content[2:close]
			return "" when label.contains(" ") || label.contains("]")
			return label
		}

		def readNote(lines string[], origins int[], from int, label string) int {
			let content = lines[from].trimStart()
			let body = string[content[content.indexOf("]:") + 2:].trimStart()]
			let bodyOrigins = int[origins[from]]
			let i = readNested(lines, origins, from + 1, 4, body, bodyOrigins)

			let holder = new Block(BlockKind.Section)
			readBlocks(body, bodyOrigins, holder)
			notes.set(label, holder.children) unless notes.hasKey(label)
			return i
		}

		// linkDefinition records the link reference definition on the line and
		// reports whether there was one.
		def linkDefinition(content string) bool {
			return false unless content.startsWith("[")
			let close = content.indexOf("]:")
			return false when close < 2

			let label = content[1:close]
			return false when label.contains("[") || label.contains("]") || label.trim() == ""

			let rest = content[close + 2:].trim()
			return false when rest == ""

			let url = ""
			if rest.startsWith("<") {
				let end = rest.indexOf(">")
				return false when end < 0
				url = rest[1:end]
				rest = rest[end + 1:].trim()
			} else {
				let space = rest.indexOf(" ")
				if space < 0 {
					url = rest
					rest = ""
				} else {
					url = rest[:space]
					rest = rest[space:].trim()
				}
			}

			let title = ""
			if rest != "" {
				return false when rest.len() < 2
				let open = rest[0]
				let last = rest[rest.len() - 1]
				return false unless (open == '"' && last == '"') || (open == '\'' && last == '\'') || (open == '(' && last == ')')
				title = rest[1:rest.len() - 1]
			}

			let key = markdownLabel(label)
			links.set(key, MarkdownLink{url: markdownUnescape(url), title: markdownUnescape(title)}) unless links.hasKey(key)
			return true
		}

		// tableAt returns the column alignments when a table starts at the line:
		// a header row followed by a delimiter row of the same width.
		def tableAt(lines string[], at int) ?Alignment[] {
			return none when at + 1 >= lines.len()
			return none unless lines[at].contains("|")

			let alignments = delimiterRow(lines[at + 1])
			return none when alignments is none
			return none unless splitRow(lines[at]).len() == alignments.len()
			return alignments
		}

		// delimiterRow reads a `| :--- | ---: |` row, none when the line is not
		// one.
		def delimiterRow(line string) ?Alignment[] {
			return none unless line.contains("-")

			let out = Alignment[]
			for let (_, cell) in splitRow(line) {
				let left = cell.startsWith(":")
				let right = cell.endsWith(":")
				let dashes = cell.trim(":")
				return none when dashes == "" || dashes.replace("-", "") != ""

				if left && right {
					out.push(Alignment.Center)
				} else if left {
					out.push(Alignment.Left)
				} else if right {
					out.push(Alignment.Right)
				} else {
					out.push(Alignment.Default)
				}
			}
			return out
		}

		// splitRow returns the trimmed cells of a table row. `\|` is a pipe inside
		// a cell.
		def splitRow(line string) string[] {
			let bounds = int[]
			return splitRow(line, bounds)
		}

		// splitRow returns the trimmed cells of a table row and adds where each
		// starts and ends in the line to `bounds`.
		def splitRow(line string, bounds int[]) string[] {
			let offset = line.len() - line.trimStart().len()
			let row = line.trim()
			if row.startsWith("|") {
				row = row[1:]
				offset++
			}
			row = row[:row.len() - 1] when row.endsWith("|") && !row.endsWith("\\|")

			let cells = string[]
			let start = 0
			let i = 0
			for i < row.len() {
				let c = row[i]
				if c == '\\' && i + 1 < row.len() && row[i + 1] == '|' {
					i += 2
					continue
				}
				if c == '|' {
					cells.push(cellText(row, start, i, offset, bounds))
					start = i + 1
				}
				i++
			}
			cells.push(cellText(row, start, row.len(), offset, bounds))
			return cells
		}

		// cellText returns the trimmed text of `row[from:to]` with `\|` read as a
		// pipe, and adds where it starts and ends in the line, `offset` places
		// before the row, to `bounds`.
		def cellText(row string, from int, to int, offset int, bounds int[]) string {
			let raw = row[from:to]
			let content = raw.trim()
			let start = offset + from + raw.len() - raw.trimStart().len()
			bounds.push(start)
			bounds.push(start + content.len())
			return content.replace("\\|", "|")
		}

		def readTable(lines string[], origins int[], from int, alignments Alignment[], parent Block) int {
			let table = new Block(BlockKind.Table)
			table.alignments = alignments
			addRow(table, lines[from], origins[from], true)

			let i = from + 2
			for i < lines.len() {
				let line = lines[i]
				break when isBlank(line) || startsBlock(line)
				addRow(table, line, origins[i], false)
				i++
			}
			parent.add(table)
			return i
		}

		def addRow(table Block, line string, origin int, header bool) {
			let bounds = int[]
			let cells = splitRow(line, bounds)
			let row = new Block(BlockKind.Row)
			row.header = header
			row.sourceStart = sourceAt(origin, line, leadingSpace(line))
			row.sourceEnd = sourceAt(origin, line, contentEnd(line))
			for let column = 0; column < table.alignments.len(); column++ {
				let cell = new Block(BlockKind.Cell)
				if column < cells.len() {
					let from = bounds[2 * column]
					let to = bounds[2 * column + 1]
					cell.sourceStart = sourceAt(origin, line, from)
					cell.sourceEnd = sourceAt(origin, line, to)
					if cells[column] != "" {
						let paragraph = new Block(BlockKind.Paragraph)
						paragraph.content = cells[column]
						paragraph.sourceStart = cell.sourceStart
						paragraph.sourceEnd = cell.sourceEnd
						trackCell(paragraph, line, origin, from, to)
						cell.add(paragraph)
					}
				}
				row.add(cell)
			}
			table.add(row)
		}

		def readParagraph(lines string[], origins int[], from int, parent Block) int {
			let opening = lines[from].trimStart()
			let parts = string[opening]
			let first = segmentStarts.len()
			addSegment(0, sourceAt(origins[from], opening, 0))
			let at = opening.len() + 1
			let i = from + 1
			for i < lines.len() {
				let line = lines[i]
				break when isBlank(line)

				let level = underline(line)
				if level > 0 {
					let heading = new Block(BlockKind.Heading)
					heading.level = level
					heading.content = parts.join("\n").trim()
					keep(heading, first)
					parent.add(heading)
					return i + 1
				}
				break when startsBlock(line)
				break unless tableAt(lines, i) is none
				let part = line.trimStart()
				parts.push(part)
				addSegment(at, sourceAt(origins[i], part, 0))
				at += part.len() + 1
				i++
			}

			let paragraph = new Block(BlockKind.Paragraph)
			paragraph.content = parts.join("\n").trim()
			keep(paragraph, first)
			parent.add(paragraph)
			return i
		}

		// underline returns the heading level a setext underline gives the
		// paragraph above it: 1 for `===`, 2 for `---`, 0 for any other line.
		def underline(line string) int {
			return 0 when indentOf(line) >= 4
			let content = line.trim()
			return 0 when content == ""
			return 1 when content.replace("=", "") == ""
			return 2 when content.replace("-", "") == ""
			return 0
		}

		// resolve parses the text the block keeps in `content` into inlines.
		def resolve(text int) {
			let block = textBlocks[text]
			let parser = new MarkdownInlines(block.content, links, notes, segmentStarts, segmentSources, textFirst[text], textEnd(text))
			block.inlines = parser.parse()
			block.content = ""
			promoteImage(block)
		}

		// promoteImage turns a paragraph that holds one image into an Image block.
		def promoteImage(block Block) {
			return unless block.kind == BlockKind.Paragraph && block.inlines.len() == 1
			let only = block.inlines[0]
			return unless only.kind == InlineKind.Image

			block.kind = BlockKind.Image
			block.source = only.url
			block.title = only.title
			block.inlines = only.children
		}
	}

	// markdownLabel returns a link label in the form labels are compared in:
	// lower case, runs of whitespace as one space.
	def markdownLabel(label string) string {
		return label.lower().replace("\n", " ").split(" ").filter(part => part != "").join(" ")
	}

	// markdownUnescape removes the backslash in front of escaped punctuation.
	def markdownUnescape(content string) string {
		return content unless content.contains("\\")

		let out = ""
		let start = 0
		let i = 0
		for i + 1 < content.len() {
			if content[i] == '\\' && markdownPunctuation(content[i + 1]) {
				out += content[start:i]
				start = i + 1
				i++
			}
			i++
		}
		return out + content[start:]
	}

	// markdownPunctuation reports an ASCII punctuation character, the only kind
	// a backslash escapes.
	def markdownPunctuation(c char) bool {
		return c.isASCII() && int(c) > 32 && int(c) < 127 && !c.isAlphanumeric()
	}
}
