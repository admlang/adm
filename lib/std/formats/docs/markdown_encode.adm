partial module std.formats.docs {
	use std.gfx.color

	// Characters that make a front matter value need quotes.
	internal const markdownQuoted = ":#[],\"'\{\}&*!|>%@`"

	// MarkdownEncoder writes a Document as Markdown text.
	internal type MarkdownEncoder {
		// Footnotes met so far, written after the body in this order.
		notes Inline[]

		def new() {
			notes = Inline[]
		}

		def encode(doc Document) string {
			let lines = frontMatter(doc)
			lines.push(...blocks(doc.body.children, false))

			for let i = 0; i < notes.len(); i++ {
				lines.push("") unless lines.len() == 0
				let body = blocks(notes[i].note, false)
				body.push("") when body.len() == 0
				lines.push("[^{i + 1}]: " + body[0])
				for let k = 1; k < body.len(); k++ {
					lines.push(indented(body[k], 4))
				}
			}
			return lines.join("\n") + "\n"
		}

		def indented(line string, width int) string {
			return "" when line == ""
			return " ".repeat(width) + line
		}

		// frontMatter returns the metadata block and the blank line after it, no
		// lines when the document has no metadata. The title is left out when the
		// document starts with it as a level 1 heading, where decoding finds it.
		def frontMatter(doc Document) string[] {
			let fields = string[]

			let title = doc.title
			if title != "" && doc.body.children.len() > 0 {
				let opening = doc.body.children[0]
				title = "" when opening.kind == BlockKind.Heading && opening.level == 1 && opening.plainText() == title
			}
			fields.push("title: " + quoted(title)) unless title == ""

			if doc.authors.len() == 1 {
				fields.push("author: " + quoted(doc.authors[0]))
			} else if doc.authors.len() > 1 {
				let names = string[]
				for let (_, name) in doc.authors {
					names.push(quoted(name))
				}
				fields.push("authors: [" + names.join(", ") + "]")
			}

			let date = doc.date
			if !(date is none) {
				let stamp = date.str()
				stamp = stamp[:10] when stamp.endsWith("T00:00:00Z")
				fields.push("date: " + stamp)
			}
			fields.push("language: " + quoted(doc.language)) unless doc.language == ""

			let keys = doc.metadata.keys()
			keys.sort((a string, b string) => a.compare(b) < 0)
			for let (_, key) in keys {
				let value = doc.metadata.get(key)
				fields.push(key + ": " + quoted(value)) unless value is none
			}

			return fields when fields.len() == 0
			let out = string["---"]
			out.push(...fields)
			out.push("---", "")
			return out
		}

		// quoted returns a front matter value, in quotes when it has to be.
		def quoted(value string) string {
			let plain = value != "" && value.trim() == value && !value.startsWith("-")
			for let (_, c) in value {
				plain = false when markdownQuoted.contains(string(c))
			}
			return value when plain
			return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
		}

		// blocks returns the lines of the blocks, a blank line between two of them
		// unless they are tight.
		def blocks(items Block[], tight bool) string[] {
			let out = string[]
			for let (_, block) in items {
				let lines = block(block)
				continue when lines.len() == 0
				out.push("") unless tight || out.len() == 0
				out.push(...lines)
			}
			return out
		}

		def block(item Block) string[] {
			match item.kind {
				case BlockKind.Heading:
					return string["#".repeat(item.level.clamp(1, 6)) + " " + oneLine(inlines(item.inlines))]
				case BlockKind.Paragraph:
					return paragraph(inlines(item.inlines))
				case BlockKind.List:
					return list(item)
				case BlockKind.Table:
					return table(item)
				case BlockKind.Image:
					return string[image(item.source, item.title, inlines(item.inlines))]
				case BlockKind.Code:
					return fenced(item)
				case BlockKind.Quote:
					let out = string[]
					for let (_, line) in blocks(item.children, false) {
						out.push((line == "") ?? (">", "> " + line))
					}
					return out
				case BlockKind.Rule:
					return string["---"]
				case BlockKind.PageBreak:
					return string[]
				case BlockKind.Raw:
					return item.content.split("\n") when (item.format := "md" || "markdown" || "html")
					return string[]
				default:
					return blocks(item.children, false)
			}
		}

		// oneLine returns inline text without its line breaks.
		def oneLine(content string) string {
			return content.replace("\\\n", " ").replace("\n", " ")
		}

		// paragraph returns the lines of a paragraph, with a backslash in front of
		// what would start another block.
		def paragraph(content string) string[] {
			let out = string[]
			for let (_, raw) in content.split("\n") {
				out.push(guardStart(raw.trimStart()))
			}
			return out
		}

		def guardStart(line string) string {
			return line when line == ""
			let first = line[0]
			return "\\" + line when (first := '#' || '>' || '=')
			if first := '-' || '+' {
				return "\\" + line when line.len() == 1 || line[1] == ' ' || line[1] == first
				return line
			}
			return line unless first.isDigit()

			let digits = 0
			for digits < line.len() && line[digits].isDigit() {
				digits++
			}
			return line when digits >= line.len()
			let after = line[digits]
			return line unless (after := '.' || ')')
			return line unless digits + 1 == line.len() || line[digits + 1] == ' '
			return line[:digits] + "\\" + line[digits:]
		}

		def list(item Block) string[] {
			let tight = isTight(item)
			let out = string[]
			let number = item.start
			for let (_, entry) in item.children {
				let mark = item.ordered ?? ("{number}. ", "- ")
				number++

				let body = string[]
				if entry.kind == BlockKind.Item {
					body = blocks(entry.children, tight)
				} else {
					body = block(entry)
				}
				body.push("") when body.len() == 0
				body[0] = taskMark(entry) + body[0]

				out.push("") unless tight || out.len() == 0
				out.push(mark + body[0])
				for let k = 1; k < body.len(); k++ {
					out.push(indented(body[k], mark.len()))
				}
			}
			return out
		}

		def taskMark(entry Block) string {
			let state = entry.checked
			return "" when state is none
			return state ?? ("[x] ", "[ ] ")
		}

		// isTight reports a list whose items are one paragraph each, with or
		// without a list below it: such a list is written without blank lines.
		def isTight(item Block) bool {
			for let (_, entry) in item.children {
				continue unless entry.kind == BlockKind.Item
				for let (i, child) in entry.children {
					continue when child.kind == BlockKind.Paragraph && i == 0
					continue when child.kind == BlockKind.List && isTight(child)
					return false
				}
			}
			return true
		}

		def fenced(item Block) string[] {
			let longest = 2
			let current = 0
			for let (_, c) in item.content {
				if c == '`' {
					current++
					longest = current when current > longest
				} else {
					current = 0
				}
			}

			let fence = "`".repeat(longest + 1)
			let out = string[fence + item.language]
			out.push(...item.content.split("\n")) unless item.content == ""
			out.push(fence)
			return out
		}

		def table(item Block) string[] {
			let columns = item.columns()
			return string[] when columns == 0

			let rows = string[][]
			let widths = int[]
			for let i = 0; i < columns; i++ {
				widths.push(3)
			}

			let headed = item.children.len() > 0 && item.children[0].header
			if !headed {
				let blank = string[]
				for let i = 0; i < columns; i++ {
					blank.push("")
				}
				rows.push(blank)
			}
			for let (_, row) in item.children {
				let cells = string[]
				for let column = 0; column < columns; column++ {
					let content = ""
					content = cellText(row.children[column]) when column < row.children.len()
					widths[column] = content.len() when content.len() > widths[column]
					cells.push(content)
				}
				rows.push(cells)
			}

			let out = string[]
			for let (i, cells) in rows {
				out.push(tableRow(cells, widths))
				out.push(delimiterRow(item.alignments, widths)) when i == 0
			}
			return out
		}

		def tableRow(cells string[], widths int[]) string {
			let out = "|"
			for let (column, content) in cells {
				out += " " + content.padEnd(widths[column]) + " |"
			}
			return out
		}

		def delimiterRow(alignments Alignment[], widths int[]) string {
			let out = "|"
			for let (column, width) in widths {
				let alignment = Alignment.Default
				alignment = alignments[column] when column < alignments.len()
				match alignment {
					case Alignment.Left:
						out += " :" + "-".repeat(width - 1) + " |"
					case Alignment.Right:
						out += " " + "-".repeat(width - 1) + ": |"
					case Alignment.Center:
						out += " :" + "-".repeat(width - 2) + ": |"
					default:
						out += " " + "-".repeat(width) + " |"
				}
			}
			return out
		}

		// cellText returns the content of a table cell on one line.
		def cellText(cell Block) string {
			let parts = string[]
			for let (_, child) in cell.children {
				let part = ""
				if child.kind := BlockKind.Paragraph || BlockKind.Heading {
					part = inlines(child.inlines)
				} else {
					part = escape(child.plainText())
				}
				parts.push(part) unless part == ""
			}
			return parts.join(" ").replace("\\\n", "<br>").replace("\n", " ").replace("|", "\\|")
		}

		def image(source string, title string, alternative string) string {
			return "![" + oneLine(alternative) + "](" + target(source, title) + ")"
		}

		// target returns the inside of the parentheses of a link: the destination,
		// in angle brackets when it has to be, and the title.
		def target(url string, title string) string {
			let out = url
			out = "<" + url + ">" when url == "" || url.contains(" ") || url.contains("(") || url.contains(")")
			return out when title == ""
			return out + " \"" + title.replace("\"", "\\\"") + "\""
		}

		def inlines(items Inline[]) string {
			let out = ""
			for let (_, item) in items {
				out += inline(item)
			}
			return out
		}

		def inline(item Inline) string {
			match item.kind {
				case InlineKind.Text:
					return escape(item.content)
				case InlineKind.Bold:
					return "**" + inlines(item.children) + "**"
				case InlineKind.Italic:
					return "*" + inlines(item.children) + "*"
				case InlineKind.Underline:
					return "<u>" + inlines(item.children) + "</u>"
				case InlineKind.Strike:
					return "~~" + inlines(item.children) + "~~"
				case InlineKind.Code:
					return codeSpan(item.content)
				case InlineKind.Link:
					let label = inlines(item.children)
					return "<" + item.url + ">" when item.title == "" && item.url.contains(":") && !item.url.contains(" ") && inlineText(item.children) == item.url
					return "[" + label + "](" + target(item.url, item.title) + ")"
				case InlineKind.Image:
					return image(item.url, item.title, inlines(item.children))
				case InlineKind.Styled:
					return styledSpan(item)
				case InlineKind.LineBreak:
					return "\\\n"
				case InlineKind.Footnote:
					notes.push(item)
					return "[^{notes.len()}]"
				case InlineKind.Raw:
					return item.content when (item.format := "md" || "markdown" || "html")
					return ""
			}
			return ""
		}

		def styledSpan(item Inline) string {
			let out = inlines(item.children)

			let background = item.background
			out = "[background=" + hexOf(background) + "]" + out + "[/background]" unless background is none
			let foreground = item.foreground
			out = "[color=" + hexOf(foreground) + "]" + out + "[/color]" unless foreground is none
			out = "[" + item.role + "]" + out + "[/]" unless item.role == ""
			return out
		}

		def hexOf(value color.Color) string {
			let code = value.css(color.ColorFormat.Hex)
			return code when code.startsWith("#")
			return "#" + code
		}

		def codeSpan(content string) string {
			let longest = 0
			let current = 0
			for let (_, c) in content {
				if c == '`' {
					current++
					longest = current when current > longest
				} else {
					current = 0
				}
			}

			let fence = "`".repeat(longest + 1)
			let padded = content.startsWith("`") || content.endsWith("`") || (content.startsWith(" ") && content.endsWith(" ") && content.trim() != "")
			return fence + " " + content + " " + fence when padded
			return fence + content + fence
		}

		// escape returns text with a backslash in front of every character
		// Markdown would read as markup.
		def escape(content string) string {
			let out = ""
			let start = 0
			let size = content.len()
			for let i = 0; i < size; i++ {
				let c = content[i]
				let special = false
				if c := '\\' || '`' || '*' || '[' || ']' || '<' || '~' {
					special = true
				} else if c == '_' {
					let inWord = i > 0 && i + 1 < size && content[i - 1].isAlphanumeric() && content[i + 1].isAlphanumeric()
					special = !inWord
				} else if c == '&' {
					special = entityAt(content, i)
				}
				continue unless special

				out += content[start:i] + "\\"
				start = i
			}
			return (out + content[start:]).replace("\n", " ")
		}

		// entityAt reports whether the `&` at the index starts what reads as a
		// character reference.
		def entityAt(content string, at int) bool {
			let end = content.indexOf(";", at)
			return false when end < at + 2 || end - at > 32
			for let i = at + 1; i < end; i++ {
				let c = content[i]
				return false unless c.isAlphanumeric() || c == '#'
			}
			return true
		}
	}
}
