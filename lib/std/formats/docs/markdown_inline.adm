partial module std.formats.docs {
	use (
		std.data.encoding
		std.gfx.color
	)

	// MarkdownTokenKind names what a MarkdownToken is.
	internal enum MarkdownTokenKind {
		// A finished inline. Uses `node`.
		Node,
		// A run of `*`, `_` or `~` that may open or close emphasis. Uses `marker`,
		// `count`, `canOpen` and `canClose`.
		Delimiter,
		// A `[` or `![` that may open a link or an image. Uses `image`, `active`
		// and `position`.
		Bracket,
		// An opening style tag waiting for its closing tag. Uses `name`, `literal`
		// and `node`, the inline the tag content goes into.
		Tag,
	}

	// MarkdownToken is a piece of inline text on its way to becoming an Inline.
	internal type MarkdownToken {
		kind     MarkdownTokenKind
		node     ?Inline
		marker   char
		// Characters of a delimiter run that are not used up yet.
		count    int
		canOpen  bool
		canClose bool
		image    bool
		// Whether a link may still start at the bracket: no link inside a link.
		active   bool              = true
		// Where the label of a bracket starts in the source.
		position int
		name     string
		// Source text of a tag, written back when the tag is never closed.
		literal  string

		def new(kind MarkdownTokenKind) {
			self.kind = kind
		}
	}

	// MarkdownInlines parses the text of one block into inlines.
	internal type MarkdownInlines {
		src    string
		size   int
		pos    int
		// Start of the plain characters not yet turned into a token.
		run    int
		// Where parsing goes on after the link target read last.
		resume int
		links  map<string, MarkdownLink>
		notes  map<string, Block[]>
		tokens MarkdownToken[]

		def new(src string, links map<string, MarkdownLink>, notes map<string, Block[]>) {
			self.src = src
			self.links = links
			self.notes = notes
			size = src.len()
			tokens = MarkdownToken[]
		}

		def parse() Inline[] {
			for pos < size {
				let c = src[pos]
				switch {
					case c == '\\':
						escape()
					case c == '`':
						codeSpan()
					case c == '*' || c == '_' || c == '~':
						delimiter(c)
					case c == '[':
						openBracket()
					case c == '!' && peek(1) == '[':
						flush()
						let bracket = new MarkdownToken(MarkdownTokenKind.Bracket)
						bracket.image = true
						bracket.position = pos + 2
						tokens.push(bracket)
						pos += 2
						run = pos
					case c == ']':
						closeBracket()
					case c == '<':
						angle()
					case c == '&':
						entity()
					case c == '\n':
						lineEnd()
					case c == 'h':
						bareLink()
					default:
						pos++
				}
			}
			flush()
			return emphasize(tokens)
		}

		// peek returns the character `offset` places ahead, a space past the end.
		def peek(offset int) char {
			return ' ' when pos + offset >= size
			return src[pos + offset]
		}

		// flush turns the plain characters read so far into a Text token.
		def flush() {
			pushText(src[run:pos]) when run < pos
			run = pos
		}

		def pushText(content string) {
			return when content == ""
			pushNode(text(content))
		}

		def pushNode(node Inline) {
			let token = new MarkdownToken(MarkdownTokenKind.Node)
			token.node = node
			tokens.push(token)
		}

		// consume moves past a construct that ended at `end`.
		def consume(end int) {
			pos = end
			run = end
		}

		def escape() {
			let next = peek(1)
			if next == '\n' && pos + 1 < size {
				flush()
				pushNode(lineBreak())
				consume(pos + 2)
				skipSpaces()
				return
			}
			if markdownPunctuation(next) && pos + 1 < size {
				flush()
				// The run restarts at the escaped character, which stays plain.
				run = pos + 1
				pos += 2
				return
			}
			pos++
		}

		def skipSpaces() {
			for pos < size && src[pos] == ' ' {
				pos++
			}
			run = pos
		}

		def backticks(at int) int {
			let count = 0
			for at + count < size && src[at + count] == '`' {
				count++
			}
			return count
		}

		def codeSpan() {
			let length = backticks(pos)
			let i = pos + length
			for i < size {
				if src[i] != '`' {
					i++
					continue
				}
				let closing = backticks(i)
				if closing != length {
					i += closing
					continue
				}

				let content = src[pos + length:i].replace("\n", " ")
				content = content[1:content.len() - 1] when content.len() > 1 && content.startsWith(" ") && content.endsWith(" ") && content.trim(" ") != ""
				flush()
				pushNode(code(content))
				consume(i + length)
				return
			}
			pos += length
		}

		def delimiter(mark char) {
			let count = 0
			for pos + count < size && src[pos + count] == mark {
				count++
			}
			if mark == '~' && count > 2 {
				pos += count
				return
			}

			let before = ' '
			before = src[pos - 1] when pos > 0
			let after = peek(count)
			let spaceBefore = before.isSpace()
			let spaceAfter = after.isSpace()
			let punctBefore = markdownPunctuation(before)
			let punctAfter = markdownPunctuation(after)
			let left = !spaceAfter && (!punctAfter || spaceBefore || punctBefore)
			let right = !spaceBefore && (!punctBefore || spaceAfter || punctAfter)

			flush()
			let token = new MarkdownToken(MarkdownTokenKind.Delimiter)
			token.marker = mark
			token.count = count
			if mark == '_' {
				token.canOpen = left && (!right || punctBefore)
				token.canClose = right && (!left || punctAfter)
			} else {
				token.canOpen = left
				token.canClose = right
			}
			tokens.push(token)
			consume(pos + count)
		}

		def openBracket() {
			let end = src.indexOf("]", pos)
			if end > pos + 1 {
				let inside = src[pos + 1:end]
				if inside.startsWith("^") {
					let note = notes.get(inside[1:])
					if !(note is none) {
						flush()
						let reference = new Inline(InlineKind.Footnote)
						reference.note = note
						pushNode(reference)
						consume(end + 1)
						return
					}
				}
				return when tag(inside, end)
			}

			flush()
			let bracket = new MarkdownToken(MarkdownTokenKind.Bracket)
			bracket.position = pos + 1
			tokens.push(bracket)
			consume(pos + 1)
		}

		// tag reads the style tag between the brackets and reports whether there
		// was one. `end` is where the closing bracket sits.
		def tag(inside string, end int) bool {
			return closeTag(inside[1:].trim().lower(), end) when inside.startsWith("/")

			let equals = inside.indexOf("=")
			if equals > 0 {
				let key = inside[:equals].trim().lower()
				key = "background" when key == "bg"
				return false unless (key := "color" || "background")

				let parsed = parseColor(inside[equals + 1:].trim()) onerror recover none
				return false when parsed is none

				let node = new Inline(InlineKind.Styled)
				if key == "color" {
					node.foreground = parsed
				} else {
					node.background = parsed
				}
				openTag(key, node, end)
				return true
			}

			return false unless roleName(inside)
			return false when links.hasKey(markdownLabel(inside))
			let next = ' '
			next = src[end + 1] when end + 1 < size
			return false when next := '(' || '['
			return false unless src.indexOf("[/]", end) >= 0 || src.indexOf("[/" + inside + "]", end) >= 0

			let node = new Inline(InlineKind.Styled)
			node.role = inside
			openTag(inside.lower(), node, end)
			return true
		}

		def parseColor(value string) !?color.Color {
			return try color.parse(value)
		}

		// roleName reports a name a theme role may have: a letter, then letters,
		// digits, `-` and `_`.
		def roleName(name string) bool {
			return false when name == "" || !name[0].isLetter()
			for let (_, c) in name {
				return false unless c.isAlphanumeric() || c == '-' || c == '_'
			}
			return true
		}

		def openTag(name string, node Inline, end int) {
			flush()
			let token = new MarkdownToken(MarkdownTokenKind.Tag)
			token.name = name
			token.node = node
			token.literal = src[pos:end + 1]
			tokens.push(token)
			consume(end + 1)
		}

		// closeTag ends the last open tag of the name, or the last open tag when
		// the name is empty, and reports whether there was one.
		def closeTag(name string, end int) bool {
			let wanted = name
			wanted = "background" when name == "bg"

			let at = -1
			for let i = tokens.len() - 1; i >= 0; i-- {
				let token = tokens[i]
				continue unless token.kind == MarkdownTokenKind.Tag
				if wanted == "" || token.name == wanted {
					at = i
					break
				}
			}
			return false when at < 0

			flush()
			let node = tokens[at].node
			return false when node is none
			node.children = emphasize(tail(at + 1))
			tokens = head(at)
			pushNode(node)
			consume(end + 1)
			return true
		}

		// head returns a copy of the first `count` tokens.
		def head(count int) MarkdownToken[] {
			let out = MarkdownToken[]
			for let i = 0; i < count; i++ {
				out.push(tokens[i])
			}
			return out
		}

		// tail returns a copy of the tokens from the index on.
		def tail(from int) MarkdownToken[] {
			let out = MarkdownToken[]
			for let i = from; i < tokens.len(); i++ {
				out.push(tokens[i])
			}
			return out
		}

		def closeBracket() {
			let at = -1
			for let i = tokens.len() - 1; i >= 0; i-- {
				if tokens[i].kind == MarkdownTokenKind.Bracket {
					at = i
					break
				}
			}
			if at < 0 {
				pos++
				return
			}

			flush()
			let opener = tokens[at]
			let target ?MarkdownLink = none
			target = linkTarget(src[opener.position:pos]) when opener.active
			if target is none {
				tokens[at] = plain(opener)
				pos++
				return
			}

			let kind = opener.image ?? (InlineKind.Image, InlineKind.Link)
			let node = new Inline(kind)
			node.url = target.url
			node.title = target.title
			node.children = emphasize(tail(at + 1))
			tokens = head(at)
			pushNode(node)
			consume(resume)

			return when opener.image
			for let (_, token) in tokens {
				token.active = false when token.kind == MarkdownTokenKind.Bracket && !token.image
			}
		}

		// plain returns the Text token a bracket that opened nothing turns into.
		def plain(bracket MarkdownToken) MarkdownToken {
			let token = new MarkdownToken(MarkdownTokenKind.Node)
			token.node = text(bracket.image ?? ("![", "["))
			return token
		}

		// linkTarget finds what the link whose text just ended at `pos` points to:
		// an inline `(url "title")`, a `[label]` reference, or the text itself as
		// a label. It sets `resume`. Returns none when the brackets are no link.
		def linkTarget(label string) ?MarkdownLink {
			if peek(1) == '(' {
				let inline = inlineTarget(pos + 2)
				return inline unless inline is none
			}
			if peek(1) == '[' {
				let close = src.indexOf("]", pos + 2)
				if close >= 0 {
					let reference = src[pos + 2:close]
					reference = label when reference.trim() == ""
					let found = links.get(markdownLabel(reference))
					if !(found is none) {
						resume = close + 1
						return found
					}
				}
			}
			resume = pos + 1
			return links.get(markdownLabel(label))
		}

		def skipBlank(from int) int {
			let i = from
			for i < size && src[i].isSpace() {
				i++
			}
			return i
		}

		// inlineTarget reads `url "title")` from the index on. It sets `resume`.
		// Returns none when the text is not a link target.
		def inlineTarget(from int) ?MarkdownLink {
			let i = skipBlank(from)
			return none when i >= size

			let url = ""
			if src[i] == '<' {
				let close = src.indexOf(">", i)
				return none when close < 0
				url = src[i + 1:close]
				return none when url.contains("\n")
				i = close + 1
			} else {
				let start = i
				let depth = 0
				for i < size {
					let c = src[i]
					break when c.isSpace()
					if c == '\\' {
						i += 2
						continue
					}
					depth++ when c == '('
					if c == ')' {
						break when depth == 0
						depth--
					}
					i++
				}
				i = size when i > size
				url = src[start:i]
			}

			i = skipBlank(i)
			return none when i >= size

			let title = ""
			let open = src[i]
			if open := '"' || '\'' || '(' {
				let closer = open
				closer = ')' when open == '('
				let start = i + 1
				i = start
				for i < size && src[i] != closer {
					i++ when src[i] == '\\'
					i++
				}
				return none when i >= size
				title = src[start:i]
				i = skipBlank(i + 1)
			}
			return none when i >= size || src[i] != ')'

			resume = i + 1
			return MarkdownLink{url: markdownUnescape(url), title: markdownUnescape(title)}
		}

		def angle() {
			if startsWith("<u>") {
				openTag("u", new Inline(InlineKind.Underline), pos + 2)
				return
			}
			return when startsWith("</u>") && closeTag("u", pos + 3)

			if startsWith("<!--") {
				let close = src.indexOf("-->", pos)
				if close >= 0 {
					rawHTML(close + 3)
					return
				}
			}

			let close = src.indexOf(">", pos)
			if close < pos + 2 {
				pos++
				return
			}

			let inside = src[pos + 1:close]
			if !inside.contains(" ") && !inside.contains("\n") && !inside.contains("<") {
				let target = ""
				if scheme(inside) {
					target = inside
				} else if inside.contains("@") && !inside.contains(":") && !inside.contains("/") {
					target = "mailto:" + inside
				}
				if target != "" {
					flush()
					pushNode(link(inside, target))
					consume(close + 1)
					return
				}
			}

			let first = inside[0]
			first = inside[1] when first == '/' && inside.len() > 1
			if first.isLetter() || first == '!' || first == '?' {
				rawHTML(close + 1)
				return
			}
			pos++
		}

		def startsWith(prefix string) bool {
			let end = pos + prefix.len()
			return end <= size && src[pos:end] == prefix
		}

		def rawHTML(end int) {
			flush()
			let node = new Inline(InlineKind.Raw)
			node.format = "html"
			node.content = src[pos:end]
			pushNode(node)
			consume(end)
		}

		// scheme reports whether the text starts with a URL scheme and a colon.
		def scheme(content string) bool {
			let colon = content.indexOf(":")
			return false when colon < 2 || colon > 32 || !content[0].isLetter()
			for let i = 1; i < colon; i++ {
				let c = content[i]
				return false unless c.isAlphanumeric() || c == '+' || c == '.' || c == '-'
			}
			return true
		}

		def entity() {
			let end = src.indexOf(";", pos)
			if end < pos + 2 || end - pos > 32 {
				pos++
				return
			}
			for let i = pos + 1; i < end; i++ {
				let c = src[i]
				if !(c.isAlphanumeric() || c == '#') {
					pos++
					return
				}
			}

			let source = src[pos:end + 1]
			let decoded = encoding.htmlDecode(source)
			if decoded == source {
				pos++
				return
			}
			flush()
			pushText(decoded)
			consume(end + 1)
		}

		// lineEnd reads a line ending inside a paragraph: a hard break after two
		// spaces, a space otherwise.
		def lineEnd() {
			let end = pos
			for end > run && src[end - 1] == ' ' {
				end--
			}
			let hard = pos - end >= 2
			pushText(src[run:end]) when run < end

			if hard {
				pushNode(lineBreak())
			} else {
				pushText(" ")
			}
			consume(pos + 1)
			skipSpaces()
		}

		// bareLink reads a `http://` or `https://` URL written without brackets.
		def bareLink() {
			let bare = startsWith("http://") || startsWith("https://")
			let inWord = pos > 0 && src[pos - 1].isAlphanumeric()
			if !bare || inWord || insideLink() {
				pos++
				return
			}

			let end = pos
			for end < size && !src[end].isSpace() && src[end] != '<' {
				end++
			}
			for end > pos {
				let last = src[end - 1]
				if last == ')' {
					let url = src[pos:end]
					break when url.count("(") >= url.count(")")
				} else {
					break unless (last := '?' || '!' || '.' || ',' || ':' || ';' || '*' || '_' || '~' || '\'' || '"')
				}
				end--
			}

			let url = src[pos:end]
			if url.endsWith("://") {
				pos++
				return
			}
			flush()
			pushNode(link(url, url))
			consume(end)
		}

		// insideLink reports whether a bracket that may still become a link is
		// open.
		def insideLink() bool {
			for let (_, token) in tokens {
				return true when token.kind == MarkdownTokenKind.Bracket && token.active && !token.image
			}
			return false
		}

		// emphasize pairs the delimiter runs of the tokens into Bold, Italic and
		// Strike inlines and returns the finished inlines.
		def emphasize(items MarkdownToken[]) Inline[] {
			let list = items
			let at = 0
			for at < list.len() {
				let closer = list[at]
				if closer.kind != MarkdownTokenKind.Delimiter || !closer.canClose || closer.count == 0 {
					at++
					continue
				}
				let from = opener(list, at)
				if from < 0 {
					at++
					continue
				}

				let open = list[from]
				let used = 1
				let kind = InlineKind.Italic
				if closer.marker == '~' {
					used = closer.count
					kind = InlineKind.Strike
				} else if open.count >= 2 && closer.count >= 2 {
					used = 2
					kind = InlineKind.Bold
				}
				open.count -= used
				closer.count -= used

				let inner = MarkdownToken[]
				for let i = from + 1; i < at; i++ {
					inner.push(list[i])
				}
				let wrapped = new MarkdownToken(MarkdownTokenKind.Node)
				wrapped.node = span(kind, flatten(inner))

				let next = MarkdownToken[]
				for let i = 0; i <= from; i++ {
					next.push(list[i])
				}
				next.push(wrapped)
				for let i = at; i < list.len(); i++ {
					next.push(list[i])
				}
				list = next
				// The closer now sits right after the new node.
				at = from + 2
			}
			return flatten(list)
		}

		// opener returns the index of the delimiter run that the closer at the
		// index pairs with, -1 when there is none.
		def opener(list MarkdownToken[], at int) int {
			let closer = list[at]
			for let i = at - 1; i >= 0; i-- {
				let open = list[i]
				continue unless open.kind == MarkdownTokenKind.Delimiter && open.marker == closer.marker
				continue unless open.canOpen && open.count > 0

				if closer.marker == '~' {
					continue unless open.count == closer.count
					return i
				}
				// A run that both opens and closes pairs only when the lengths do
				// not add up to a multiple of three.
				if open.canClose || closer.canOpen {
					let sum = open.count + closer.count
					continue when sum % 3 == 0 && !(open.count % 3 == 0 && closer.count % 3 == 0)
				}
				return i
			}
			return -1
		}

		// flatten returns the inlines of the tokens. What never paired is text.
		def flatten(list MarkdownToken[]) Inline[] {
			let out = Inline[]
			let pending = ""
			for let (_, token) in list {
				match token.kind {
					case MarkdownTokenKind.Delimiter:
						pending += string(token.marker).repeat(token.count)
					case MarkdownTokenKind.Bracket:
						pending += token.image ?? ("![", "[")
					case MarkdownTokenKind.Tag:
						pending += token.literal
					case MarkdownTokenKind.Node:
						let node = token.node
						continue when node is none
						if node.kind == InlineKind.Text {
							pending += node.content
							continue
						}
						out.push(text(pending)) unless pending == ""
						pending = ""
						out.push(node)
				}
			}
			out.push(text(pending)) unless pending == ""
			return out
		}
	}
}
