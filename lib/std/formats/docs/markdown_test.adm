partial module std.formats.docs {
	use (
		std.bytes
		std.gfx.color
		std.os
		std.testing
		std.time
	)

	check "Markdown" {
		internal def decode(source string) Document {
			let markdown = new Markdown()
			return markdown.decode(source)
		}

		internal def encode(doc Document) string {
			let markdown = new Markdown()
			return markdown.encode(doc)
		}

		// shape writes inlines as tags, so one compare checks a whole tree.
		internal def shape(items Inline[]) string {
			let out = ""
			for let (_, item) in items {
				match item.kind {
					case InlineKind.Text:
						out += item.content
					case InlineKind.Bold:
						out += "<b>" + shape(item.children) + "</b>"
					case InlineKind.Italic:
						out += "<i>" + shape(item.children) + "</i>"
					case InlineKind.Underline:
						out += "<u>" + shape(item.children) + "</u>"
					case InlineKind.Strike:
						out += "<s>" + shape(item.children) + "</s>"
					case InlineKind.Code:
						out += "<code>" + item.content + "</code>"
					case InlineKind.Link:
						out += "<a " + item.url + "|" + item.title + ">" + shape(item.children) + "</a>"
					case InlineKind.Image:
						out += "<img " + item.url + "|" + item.title + ">" + shape(item.children) + "</img>"
					case InlineKind.Styled:
						out += "<style " + item.role + ">" + shape(item.children) + "</style>"
					case InlineKind.LineBreak:
						out += "<br>"
					case InlineKind.Footnote:
						out += "<fn>"
					case InlineKind.Raw:
						out += "<raw>" + item.content + "</raw>"
				}
			}
			return out
		}

		internal def inlineShape(source string) string {
			let doc = decode(source)
			return "" when doc.blocks.len() == 0
			return shape(doc.blocks[0].inlines)
		}

		@test()
		def TestHeadings() {
			let doc = decode("# One\n\n## Two ##\n\nThree\n=====\n\nFour\nmore\n---\n\n####### seven\n\n#hash")
			assert doc.blocks.len() == 6
			assert doc.blocks[0].level == 1
			assert doc.blocks[0].plainText() == "One"
			assert doc.blocks[1].level == 2
			assert doc.blocks[1].plainText() == "Two"
			assert doc.blocks[2].kind == BlockKind.Heading
			assert doc.blocks[2].level == 1
			assert doc.blocks[3].level == 2
			assert doc.blocks[3].plainText() == "Four more"
			assert doc.blocks[4].kind == BlockKind.Paragraph
			assert doc.blocks[5].kind == BlockKind.Paragraph
			assert doc.title == "One"
		}

		@test()
		def TestEmphasis() {
			assert inlineShape("*a* **b** ***c*** _d_") == "<i>a</i> <b>b</b> <i><b>c</b></i> <i>d</i>"
			assert inlineShape("snake_case_name and 2 * 3 * 4") == "snake_case_name and 2 * 3 * 4"
			assert inlineShape("**bold *nested* text**") == "<b>bold <i>nested</i> text</b>"
			assert inlineShape("~~gone~~ ~one~ ~~~three~~~") == "<s>gone</s> <s>one</s> ~~~three~~~"
			assert inlineShape("*open and \\*escaped\\*") == "*open and *escaped*"
			assert inlineShape("**a** and __b__") == "<b>a</b> and <b>b</b>"
		}

		@test()
		def TestCode() {
			assert inlineShape("use `a*b` and `` tick ` inside ``") == "use <code>a*b</code> and <code>tick ` inside</code>"
			assert inlineShape("lonely ` tick") == "lonely ` tick"

			let doc = decode("```adm linenos\nlet x = 1\n\n  indented\n```\n\n    four\n      six\n\n~~~\n```\n~~~")
			assert doc.blocks.len() == 3
			assert doc.blocks[0].kind == BlockKind.Code
			assert doc.blocks[0].language == "adm"
			assert doc.blocks[0].content == "let x = 1\n\n  indented"
			assert doc.blocks[1].language == ""
			assert doc.blocks[1].content == "four\n  six"
			assert doc.blocks[2].content == "```"

			let tabs = decode("\t- item\n\n```\n\tkept\n```")
			assert tabs.blocks[0].kind == BlockKind.Code
			assert tabs.blocks[0].content == "- item"
			assert tabs.blocks[1].content == "\tkept"
		}

		@test()
		def TestLists() {
			let doc = decode("- one\n- two\n  continues\n  - nested\n  - again\n- three\n\n3. third\n4. fourth\n\n* loose\n\n  second paragraph\n\n* next")
			assert doc.blocks.len() == 3

			let bullets = doc.blocks[0]
			assert bullets.kind == BlockKind.List
			assert !bullets.ordered
			assert bullets.children.len() == 3
			assert bullets.children[1].children.len() == 2
			assert bullets.children[1].children[0].plainText() == "two continues"
			assert bullets.children[1].children[1].kind == BlockKind.List
			assert bullets.children[1].children[1].children.len() == 2

			let numbers = doc.blocks[1]
			assert numbers.ordered
			assert numbers.start == 3
			assert numbers.children.len() == 2

			let loose = doc.blocks[2]
			assert loose.children.len() == 2
			assert loose.children[0].children.len() == 2
			assert loose.children[0].children[1].plainText() == "second paragraph"
		}

		@test()
		def TestTasks() {
			let doc = decode("- [ ] open\n- [x] done\n- plain")
			let items = doc.blocks[0].children
			assert items.len() == 3

			let open = items[0].checked
			assert !(open is none)
			assert !open unless open is none
			let done = items[1].checked
			assert done unless done is none
			assert !(done is none)
			assert items[2].checked is none
			assert items[1].plainText() == "done"
		}

		@test()
		def TestQuotes() {
			let doc = decode("> # Title\n> text\nlazy line\n>\n> - item\n\nafter")
			assert doc.blocks.len() == 2

			let quote = doc.blocks[0]
			assert quote.kind == BlockKind.Quote
			assert quote.children.len() == 3
			assert quote.children[0].kind == BlockKind.Heading
			assert quote.children[1].plainText() == "text lazy line"
			assert quote.children[2].kind == BlockKind.List
			assert doc.blocks[1].plainText() == "after"
		}

		@test()
		def TestTables() {
			let doc = decode("| Name | Count | Note |\n|:-----|------:|:----:|\n| a \\| b | **1** |\n| c | 2 | x | extra |\n\nafter")
			assert doc.blocks.len() == 2

			let table = doc.blocks[0]
			assert table.kind == BlockKind.Table
			assert table.columns() == 3
			assert table.children.len() == 3
			assert table.children[0].header
			assert table.alignments[0] == Alignment.Left
			assert table.alignments[1] == Alignment.Right
			assert table.alignments[2] == Alignment.Center

			let piped = table.cell(1, 0)
			assert piped.plainText() == "a | b" unless piped is none
			let strong = table.cell(1, 1)
			assert strong.children[0].inlines[0].kind == InlineKind.Bold unless strong is none
			let missing = table.cell(1, 2)
			assert missing.children.len() == 0 unless missing is none
			assert !(piped is none) && !(strong is none) && !(missing is none)

			assert decode("a | b\nplain text").blocks[0].kind == BlockKind.Paragraph
		}

		@test()
		def TestLinks() {
			assert inlineShape("[text](https://a.example \"Title\")") == "<a https://a.example|Title>text</a>"
			assert inlineShape("[*rich* text](<my file.md>)") == "<a my file.md|><i>rich</i> text</a>"
			assert inlineShape("[paren](https://a.example/x_(y))") == "<a https://a.example/x_(y)|>paren</a>"
			assert inlineShape("<https://a.example> and <me@a.example>") == "<a https://a.example|>https://a.example</a> and <a mailto:me@a.example|>me@a.example</a>"
			assert inlineShape("see https://a.example/path. Done") == "see <a https://a.example/path|>https://a.example/path</a>. Done"
			assert inlineShape("[not a link] and [broken](") == "[not a link] and [broken]("
			assert inlineShape("text ![alt *x*](pic.png) more") == "text <img pic.png|>alt <i>x</i></img> more"

			let doc = decode("[Full][ref], [collapsed][] and [Shortcut].\n\n[REF]: https://ref.example 'Ref'\n[collapsed]: <https://c.example>\n[shortcut]: https://s.example")
			assert doc.blocks.len() == 1
			assert shape(doc.blocks[0].inlines) == "<a https://ref.example|Ref>Full</a>, <a https://c.example|>collapsed</a> and <a https://s.example|>Shortcut</a>."
		}

		@test()
		def TestImages() {
			let doc = decode("![A *logo*](logo.png \"Logo\")\n\nbeside ![inline](i.png)")
			assert doc.blocks[0].kind == BlockKind.Image
			assert doc.blocks[0].source == "logo.png"
			assert doc.blocks[0].title == "Logo"
			assert doc.blocks[0].plainText() == "A logo"
			assert doc.blocks[1].kind == BlockKind.Paragraph
			assert doc.images().len() == 1
		}

		@test()
		def TestFootnotes() {
			let doc = decode("Claim[^1] and unknown[^2].\n\n[^1]: The *source*.\n\n    Second paragraph.\n\nafter")
			assert doc.blocks.len() == 2
			assert shape(doc.blocks[0].inlines) == "Claim<fn> and unknown[^2]."

			let note = doc.blocks[0].inlines[1].note
			assert note.len() == 2
			assert shape(note[0].inlines) == "The <i>source</i>."
			assert note[1].plainText() == "Second paragraph."
		}

		@test()
		def TestTags() {
			assert inlineShape("[danger]stop **now**[/] ok") == "<style danger>stop <b>now</b></style> ok"
			assert inlineShape("[warning]a[/warning] [note] stays") == "<style warning>a</style> [note] stays"
			assert inlineShape("<u>under</u> [/] alone") == "<u>under</u> [/] alone"
			assert inlineShape("[color=nocolor]x[/color]") == "[color=nocolor]x[/color]"
			assert inlineShape("[color=red]never closed") == "[color=red]never closed"

			let doc = decode("[color=#ff0000]red [bg=blue]on blue[/bg][/color]")
			let red = doc.blocks[0].inlines[0]
			assert red.kind == InlineKind.Styled
			let foreground = red.foreground
			assert !(foreground is none)
			assert foreground.equals(new color.Color("red")) unless foreground is none
			assert red.background is none

			let blue = red.children[1]
			assert blue.kind == InlineKind.Styled
			assert !(blue.background is none)
			assert blue.plainText() == "on blue"
		}

		@test()
		def TestTextDetails() {
			assert inlineShape("AT&amp;T &lt;b&gt; &#65; R&D &unknown;") == "AT&T <b> A R&D &unknown;"
			assert inlineShape("hard  \nbreak\\\nsoft\nline") == "hard<br>break<br>soft line"
			assert inlineShape("a <span class=\"x\">b</span> <!-- c --> 1 < 2") == "a <raw><span class=\"x\"></raw>b<raw></span></raw> <raw><!-- c --></raw> 1 < 2"

			let doc = decode("<div>\n*raw*\n</div>\n\n***\n\n<!-- note\n\nstill -->\ntext")
			assert doc.blocks.len() == 4
			assert doc.blocks[0].kind == BlockKind.Raw
			assert doc.blocks[0].format == "html"
			assert doc.blocks[0].content == "<div>\n*raw*\n</div>"
			assert doc.blocks[1].kind == BlockKind.Rule
			assert doc.blocks[2].content == "<!-- note\n\nstill -->"
			assert doc.blocks[3].plainText() == "text"
		}

		@test()
		def TestFrontMatter() {
			let doc = decode("---\ntitle: \"Report: Q3\"\nauthors: [Ann, \"Lee, Bo\"]\ndate: 2026-09-21\nlang: en\ntags:\n  - a\n  - b\nstatus: draft\n---\n\n# Heading\r\n\r\nBody")
			assert doc.title == "Report: Q3"
			assert doc.authors.len() == 2
			assert doc.authors[1] == "Lee, Bo"
			assert doc.language == "en"
			let date = doc.date
			assert !(date is none)
			assert date.year() == 2026 && date.month() == 9 && date.day() == 21 unless date is none
			assert doc.metadata["tags"] == "a, b"
			assert doc.metadata["status"] == "draft"
			assert doc.blocks.len() == 2

			let plain = decode("---\n\nnot front matter")
			assert plain.blocks[0].kind == BlockKind.Rule
		}

		@test()
		def TestEncode() {
			let doc = new Document("Report")
			doc.authors.push("Ann")
			doc.heading(1, "Summary")
			doc.paragraph(text("Revenue *grew* "), bold("12%"), text(", see "), link("the site", "https://a.example"), text("."))
			doc.paragraph("# not a heading\n1. not a list")
			let items = doc.list(string["one", "two"])
			items.children[0].checked = true
			doc.list(string["first"], true).start = 4
			doc.table(string["Region", "Sales"], string[][string["North | East", "120"]]).alignments[1] = Alignment.Right
			doc.code("adm", "let x = 1")
			doc.quote().paragraph(styled("careful", "danger"), lineBreak(), underline("really"), footnote("A note."))
			doc.image("logo.png", "The logo")
			doc.pageBreak()
			doc.rule()
			doc.raw("rtf", "dropped")
			doc.raw("html", "<hr>")

			let expected = string[
				"---", "title: Report", "author: Ann", "---", "",
				"# Summary", "",
				"Revenue \\*grew\\* **12%**, see [the site](https://a.example).", "",
				"\\# not a heading 1. not a list", "",
				"- [x] one", "- two", "",
				"4. first", "",
				"| Region        | Sales |", "| ------------- | ----: |", "| North \\| East | 120   |", "",
				"```adm", "let x = 1", "```", "",
				"> [danger]careful[/]\\", "> <u>really</u>[^1]", "",
				"![The logo](logo.png)", "",
				"---", "",
				"<hr>", "",
				"[^1]: A note.", ""
			]
			assert encode(doc) == expected.join("\n")
		}

		@test()
		def TestRoundTrip() {
			let source = string[
				"# Guide", "",
				"Some *text* with `code`, a [link](https://a.example \"T\") and ~~old~~ words\\", "on two lines.", "",
				"- one", "  - nested", "- two", "",
				"1. first", "",
				"   more", "",
				"2. second", "",
				"> quoted **text**", ">", "> ```sh", "> ls", "> ```", "",
				"| a   | b   |", "| :-- | :-: |", "| 1   | 2   |", "",
				"[color=#ff8000]orange[/color] and [note]role[/]", "",
				"Claim[^1].", "",
				"[^1]: Proof.", ""
			].join("\n")

			let once = encode(decode(source))
			assert once == source
			assert encode(decode(once)) == once
			assert decode(source).title == "Guide"
		}

		@test()
		def TestCodecRegistry() !none {
			let doc = try load(new bytes.Buffer("# Title\n\nBody".bytes()), ".md")
			assert doc.title == "Title"
			assert doc.blocks.len() == 2

			let out = new bytes.Buffer()
			try doc.write(out, "MARKDOWN")
			assert string(out.bytes()) == "# Title\n\nBody\n"

			let failed = false
			doc.write(out, ".nope") onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			let markdown = new Markdown()
			assert !markdown.matchSignature(new bytes.Buffer("# Title".bytes()))
		}

		@test()
		def TestFiles() !none {
			let path = "/tmp/adm-docs-" + time.now().unixNs().str() + ".md"
			let doc = new Document()
			doc.heading(1, "Saved")
			let table = doc.body.add(new Block(BlockKind.Table))
			table.row("a", "b").header = true
			table.row("1", "")
			try doc.save(path)

			let loaded = try load(path)
			try os.remove(path)
			assert loaded.title == "Saved"
			assert loaded.tables().len() == 1
			assert loaded.tables()[0].columns() == 2
			assert loaded.tables()[0].children[1].plainText() == "1"

			let refused = false
			doc.save("/tmp/adm-docs.unknown-format") onerror (err error) {
				refused = true
				recover none
			}
			assert refused
		}
	}
}
