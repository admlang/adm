partial module std.formats.docs {
	use (
		std.bytes
		std.formats.docs.odt::*
		std.formats.docs.office::(openPackage)
		std.io
	)

	// Odt is the OpenDocument Text codec, the format of LibreOffice Writer.
	//
	// Decoding reads `content.xml`, `styles.xml` and `meta.xml`: headings
	// with their outline level, paragraphs with their alignment and named
	// style, the title and subtitle from those styles, bulleted and numbered
	// lists from the list styles, nested, with their start values, `☐`/`☒`
	// starting a task item, tables with header rows and cells spanning
	// columns and rows, quotes from the "Quotations" style, code from the
	// "Preformatted Text" style or paragraphs all in a fixed-pitch font,
	// spans in bold, italic, underline, strike, colors and fixed-pitch fonts
	// (styles based on styles included), links, pictures, stored in
	// `Document.resources` under their names in the package, footnotes and
	// endnotes, line breaks, tabs and spaces, page breaks set in paragraph
	// styles, an empty paragraph with a bottom border as a Rule, a heading's
	// bookmark as its `attributes["id"]`, and the title, creators, subject,
	// description, keywords, language, creation date and user-defined
	// properties. Tracked deletions, annotations, drawings other than
	// pictures and fields' codes (their shown text is kept) are left out.
	//
	// Encoding writes a package LibreOffice and Word open: the `mimetype`
	// entry first and stored, the manifest, named styles for headings,
	// quotes, code, captions, footnotes and tables, automatic styles for
	// marks, alignment and page breaks, one list style per list, bordered
	// tables, pictures embedded at their pixel size (at most the text width)
	// or linked when they are not in the resources, and every metadata key
	// (keys without a place of their own as user-defined properties). A
	// quote's nesting, blocks other than paragraphs and lists inside list
	// items, theme roles, code languages, footnotes inside footnotes and Raw
	// content of formats other than "odt" are left out.
	//
	// Example: Convert to DOCX
	// ```example
	// use std.formats.docs
	//
	// let doc = try docs.load("letter.odt")
	// try doc.save("letter.docx")
	// ```
	@codec("OpenDocument Text")
	type Odt {
		// Font of the text.
		font     string = "Liberation Serif"
		// Font of code blocks and code spans.
		codeFont string = "Liberation Mono"
		// Size of the text, in points. Headings and code are sized from it.
		fontSize int    = 12

		mimeType string[] {
			def get() string[] {
				return string["application/vnd.oasis.opendocument.text"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".odt", ".ott"]
			}
		}

		// matchSignature reports whether the reader is a zip archive whose
		// first entry is a `mimetype` naming an OpenDocument text.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(80)
			let n = 0
			for n < b.len() {
				let got = r.read(b[n:]) onerror recover 0
				break when got <= 0
				n += got
			}
			return false unless n >= 38 && string(b[30:38]) == "mimetype"
			return string(b[38:n]).startsWith("application/vnd.oasis.opendocument.text")
		}

		// decode reads the whole reader as an ODF text package. Fails when the
		// reader does, or as decode(byte[]) does.
		def decode(reader io.Reader) !Document {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes())
		}

		// decode reads the bytes as an ODF text package. Fails when they are
		// not a zip archive, the package has no `content.xml`, or one of its
		// parts is not well-formed XML.
		def decode(data byte[]) !Document {
			let pkg = try openPackage(data)
			let reader = new OdtReader(pkg)
			return reader.read()
		}

		// encode writes the document as an ODF text package. Fails when the
		// writer does.
		def encode(doc Document, writer io.Writer) !none {
			try writer.write(try encode(doc))
		}

		// encode returns the document as the bytes of an ODF text package.
		// Fails only when the archive cannot be built.
		def encode(doc Document) !byte[] {
			let writer = new OdtWriter(doc, font, codeFont, fontSize)
			return writer.encode()
		}
	}
}
