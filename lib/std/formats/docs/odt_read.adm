internal partial module std.formats.docs.odt {
	use (
		std.data.encoding::(XMLNode, XMLNodeKind)
		std.formats.docs.office::*
		std.formats.container::*
		std.formats.docs::*
	)

	// Style is what the reader needs of an ODF style.
	type Style {
		name        string
		displayName string
		family      string
		parent      string
		marks       Marks
		// Which of the marks the style sets, so a child can override them.
		sets        string[]
		alignment   Alignment = Alignment.Default
		breakBefore bool
		breakAfter  bool
		bottomLine  bool
		// Whether the style comes from the automatic styles, the formatting
		// of one paragraph rather than a named style.
		automatic   bool

		def new() {
			sets = string[]
		}
	}

	// A list level of a list style: whether it is numbered, and from where.
	struct ListLevel {
		ordered bool
		start   int
	}

	// Flow is where the paragraphs of one container go, with the code block
	// or quote the last ones joined.
	type Flow {
		parent Block
		code   ?Block
		quote  ?Block
		last   ?Block

		def new(parent Block) {
			self.parent = parent
		}

		def add(block Block) Block {
			code = none
			quote = none
			parent.add(block)
			last = block
			return block
		}
	}

	// OdtReader turns the parts of an ODF text package into a Document.
	type OdtReader {
		pkg        Package
		doc        Document
		styles     map<string, Style>
		listStyles map<string, ListLevel[]>
		// Font families that have a fixed pitch.
		monoFonts  map<string, bool>
		images     map<string, string>
		bookmark   string

		def new(pkg Package) {
			self.pkg = pkg
			doc = new Document()
			styles = new map<string, Style>()
			listStyles = new map<string, ListLevel[]>()
			monoFonts = new map<string, bool>()
			images = new map<string, string>()
		}

		// read decodes the package. Fails when it has no content part or a
		// part is not well-formed.
		def read() !Document {
			let stylesRoot = try pkg.xml("styles.xml")
			readStyles(stylesRoot, false) unless stylesRoot is none
			let content = try pkg.xml("content.xml")
			fail DocumentError{message: "odt: no content part", format: "OpenDocument Text"} when content is none
			readStyles(content, true)
			let metaRoot = try pkg.xml("meta.xml")
			readMeta(metaRoot) unless metaRoot is none

			let body = content.child("body")
			if !(body is none) {
				let flowText = body.child("text")
				blocks(flowText, new Flow(doc.body)) unless flowText is none
			}
			if doc.title == "" && doc.body.children.len() > 0 {
				let opening = doc.body.children[0]
				doc.title = opening.plainText() when opening.kind == BlockKind.Heading && opening.level == 1
			}
			return doc
		}

		def readStyles(root XMLNode, automatic bool) {
			for let (_, group) in root.children {
				continue unless group.kind == XMLNodeKind.Element
				match group.localName {
					case "font-face-decls":
						for let (_, face) in group.elements("font-face") {
							let family = prop(face, "font-family")
							let mono = prop(face, "font-pitch") == "fixed" || isMonospace(family) || isMonospace(prop(face, "name"))
							monoFonts.set(prop(face, "name"), mono)
						}
					case "styles", "automatic-styles":
						for let (_, node) in group.children {
							continue unless node.kind == XMLNodeKind.Element
							if node.localName == "style" {
								readStyle(node, automatic || group.localName == "automatic-styles")
							} else if node.localName == "default-style" && prop(node, "family") == "paragraph" {
								let props = node.child("text-properties")
								if !(props is none) && doc.language == "" {
									let language = prop(props, "language")
									let country = prop(props, "country")
									doc.language = country == "" || country == "none" ?? (language, language + "-" + country) when language != "" && language != "none"
								}
							} else if node.localName == "list-style" {
								readListStyle(node)
							}
						}
				}
			}
		}

		def readStyle(node XMLNode, automatic bool) {
			let entry = new Style()
			entry.name = prop(node, "name")
			entry.displayName = prop(node, "display-name")
			entry.displayName = entry.name.replace("_20_", " ") when entry.displayName == ""
			entry.family = prop(node, "family")
			entry.parent = prop(node, "parent-style-name")
			entry.automatic = automatic
			let paragraph = node.child("paragraph-properties")
			if !(paragraph is none) {
				entry.alignment = alignmentOf(prop(paragraph, "text-align"))
				entry.breakBefore = prop(paragraph, "break-before") == "page"
				entry.breakAfter = prop(paragraph, "break-after") == "page"
				let border = prop(paragraph, "border-bottom")
				entry.bottomLine = border != "" && border != "none"
			}
			let textProps = node.child("text-properties")
			if !(textProps is none) {
				let marks = Marks{}
				for let (_, attr) in textProps.attributes {
					match attr.localName {
						case "font-weight":
							marks = Marks{...marks, bold: attr.value == "bold" || attr.value.toInt<int>() >= 600}
							entry.sets.push("b")
						case "font-style":
							marks = Marks{...marks, italic: attr.value == "italic" || attr.value == "oblique"}
							entry.sets.push("i")
						case "text-underline-style":
							marks = Marks{...marks, underline: attr.value != "none"}
							entry.sets.push("u")
						case "text-line-through-style":
							marks = Marks{...marks, strike: attr.value != "none"}
							entry.sets.push("s")
						case "color":
							let found = hexColor(attr.value.trimPrefix("#"))
							marks = Marks{...marks, foreground: found}
							entry.sets.push("fg") unless found is none
						case "background-color":
							let found = hexColor(attr.value.trimPrefix("#"))
							marks = Marks{...marks, background: found}
							entry.sets.push("bg") unless found is none
						case "font-name":
							let mono = monoFonts.get(attr.value)
							marks = Marks{...marks, code: !(mono is none) && mono || isMonospace(attr.value)}
							entry.sets.push("code")
					}
				}
				entry.marks = marks
			}
			styles.set(entry.name, entry)
		}

		def readListStyle(node XMLNode) {
			let levels = ListLevel[]
			for let i = 0; i < 10; i++ {
				levels.push(ListLevel{ordered: false, start: 1})
			}
			for let (_, level) in node.children {
				continue unless level.kind == XMLNodeKind.Element
				let depth = prop(level, "level").toInt<int>() - 1
				continue when depth < 0 || depth > 9
				if level.localName == "list-level-style-number" {
					let format = prop(level, "num-format")
					let start = prop(level, "start-value")
					levels[depth] = ListLevel{ordered: format != "", start: start == "" ?? (1, start.toInt<int>())}
				}
			}
			listStyles.set(prop(node, "name"), levels)
		}

		def readMeta(root XMLNode) {
			let info = root.child("meta")
			return when info is none
			let creators = string[]
			for let (_, node) in info.elements() {
				let content = node.text().trim()
				continue when content == ""
				match node.localName {
					case "title":
						doc.title = content
					case "initial-creator", "creator":
						creators.push(content) unless creators.includes(content)
					case "subject", "description":
						doc.metadata.set(node.localName, content)
					case "keyword":
						let known = doc.metadata.get("keywords")
						doc.metadata.set("keywords", known is none ?? (content, known + ", " + content))
					case "language":
						doc.language = content
					case "creation-date":
						doc.date = dateOf(content)
					case "user-defined":
						let name = prop(node, "name")
						doc.metadata.set(name, content) unless name == ""
				}
			}
			for let (_, creator) in creators {
				for let (_, name) in creator.split(";") {
					doc.authors.push(name.trim()) unless name.trim() == "" || doc.authors.includes(name.trim())
				}
			}
		}

		// styleChain returns the style and those it is based on, nearest first.
		def styleChain(name string) Style[] {
			let out = Style[]
			let current = name
			for out.len() < 10 && current != "" {
				let found = styles.get(current)
				break when found is none
				out.push(found)
				current = found.parent
			}
			return out
		}

		// marksOf returns the character formatting a text style gives, the
		// styles it is based on included.
		def marksOf(name string, base Marks) Marks {
			let marks = base
			let chain = styleChain(name)
			for let i = chain.len() - 1; i >= 0; i-- {
				marks = apply(marks, chain[i])
			}
			return marks
		}

		def apply(base Marks, entry Style) Marks {
			let marks = base
			let own = entry.marks
			for let (_, key) in entry.sets {
				match key {
					case "b":
						marks = Marks{...marks, bold: own.bold}
					case "i":
						marks = Marks{...marks, italic: own.italic}
					case "u":
						marks = Marks{...marks, underline: own.underline}
					case "s":
						marks = Marks{...marks, strike: own.strike}
					case "fg":
						marks = Marks{...marks, foreground: own.foreground}
					case "bg":
						marks = Marks{...marks, background: own.background}
					case "code":
						marks = Marks{...marks, code: own.code}
				}
			}
			let name = entry.displayName.lower()
			marks = Marks{...marks, code: true} when name := "source text" || "source code" || "verbatim char"
			marks = Marks{...marks, bold: true} when name := "strong emphasis" || "strong"
			marks = Marks{...marks, italic: true} when name == "emphasis"
			return marks
		}

		// named returns the named style a paragraph style is or derives from,
		// skipping automatic ones, with the alignment and page breaks the
		// chain sets.
		def paragraphStyle(name string) (string, Alignment, bool, bool, bool, Marks) {
			let chain = styleChain(name)
			let named = ""
			let alignment = Alignment.Default
			let before = false
			let after = false
			let line = false
			let marks = Marks{}
			for let (_, entry) in chain {
				named = entry.displayName when named == "" && !entry.automatic
				alignment = entry.alignment when alignment == Alignment.Default
				before = before || entry.breakBefore
				after = after || entry.breakAfter
				line = line || entry.bottomLine
			}
			for let i = chain.len() - 1; i >= 0; i-- {
				marks = apply(marks, chain[i]) when chain[i].automatic
			}
			return (named, alignment, before, after, line, marks)
		}

		def blocks(container XMLNode, flow Flow) {
			for let (_, child) in container.children {
				continue unless child.kind == XMLNodeKind.Element
				match child.localName {
					case "h":
						heading(child, flow)
					case "p":
						paragraph(child, flow)
					case "list":
						flow.add(list(child, 0, ""))
					case "table":
						let made = table(child)
						flow.add(made) unless made is none
					case "section", "index-body", "table-of-content", "alphabetical-index", "illustration-index", "bibliography", "change-start", "deletion":
						blocks(child, flow) unless child.localName == "deletion"
					case "tracked-changes", "sequence-decls", "variable-decls", "user-field-decls", "forms", "index-title-template", "table-of-content-source":
						continue
					default:
						blocks(child, flow)
				}
			}
		}

		def heading(node XMLNode, flow Flow) {
			let (named, alignment, before, after, _, marks) = paragraphStyle(prop(node, "style-name"))
			flow.add(new Block(BlockKind.PageBreak)) when before && flow.parent.children.len() > 0
			bookmark = ""
			let items = unwrap(tidyRuns(runs(node, marks)), InlineKind.Bold)
			let level = prop(node, "outline-level")
			let block = new Block(BlockKind.Heading)
			block.level = level == "" ?? (1, level.toInt<int>().clamp(1, 6))
			block.inlines = items
			block.alignment = alignment
			block.attributes.set("id", bookmark) unless bookmark == ""
			let lower = named.lower()
			if lower == "title" {
				doc.title = textOf(items).trim() when doc.title == ""
			} else if items.len() > 0 {
				flow.add(block)
			}
			flow.add(new Block(BlockKind.PageBreak)) when after
		}

		def paragraph(node XMLNode, flow Flow) {
			let (named, alignment, before, after, line, marks) = paragraphStyle(prop(node, "style-name"))
			flow.add(new Block(BlockKind.PageBreak)) when before && flow.parent.children.len() > 0
			let lower = named.lower()
			let raw = runs(node, marks)
			let items = tidyRuns(raw)
			if lower == "title" {
				doc.title = textOf(items).trim() when doc.title == ""
			} else if lower == "subtitle" {
				doc.metadata.set("subtitle", textOf(items).trim())
			} else if lower == "preformatted text" || lower == "source code" || lower == "code" || (items.len() > 0 && allCode(items)) {
				let content = textOf(raw)
				let open = flow.code
				if open is none {
					let block = new Block(BlockKind.Code)
					block.content = content
					flow.add(block)
					flow.code = block
				} else {
					open.content += "\n" + content
				}
			} else if (lower == "quotations" || lower == "quote") && items.len() > 0 {
				let open = flow.quote
				if open is none {
					let made = flow.add(new Block(BlockKind.Quote))
					flow.quote = made
					made.paragraph(...unwrap(items, InlineKind.Italic))
				} else {
					open.paragraph(...unwrap(items, InlineKind.Italic))
				}
			} else if lower == "caption" || lower == "illustration" || lower == "figure" {
				let last = flow.last
				if !(last is none) && last.kind == BlockKind.Image {
					last.inlines = items
				} else if items.len() > 0 {
					plain(items, flow, named, alignment)
				}
			} else if items.len() == 0 {
				flow.add(new Block(BlockKind.Rule)) when line || lower == "horizontal line"
			} else {
				let kept = (lower == "standard" || lower == "default paragraph style" || lower == "text body" || lower == "body text" || lower == "normal" || lower == "first paragraph" || lower == "table contents" || lower == "table heading" || lower == "footnote" || lower == "endnote" || lower == "list paragraph" || lower == "list contents" || lower == "list") ?? ("", named)
				plain(items, flow, kept, alignment)
			}
			flow.add(new Block(BlockKind.PageBreak)) when after
		}

		def plain(items Inline[], flow Flow, styleName string, alignment Alignment) {
			if items.len() == 1 && items[0].kind == InlineKind.Image {
				let image = new Block(BlockKind.Image)
				image.source = items[0].url
				image.title = items[0].title
				image.inlines = items[0].children
				image.alignment = alignment
				flow.add(image)
				return
			}
			let block = new Block(BlockKind.Paragraph)
			block.inlines = items
			block.styleName = styleName
			block.alignment = alignment
			flow.add(block)
		}

		// list reads a list and the lists nested in it, their numbering from
		// the list style the outermost one names.
		def list(node XMLNode, depth int, inherited string) Block {
			let styleName = prop(node, "style-name")
			styleName = inherited when styleName == ""
			let levels = listStyles.get(styleName)
			let level = levels is none ?? (ListLevel{ordered: false, start: 1}, levels[depth.clamp(0, 9)])
			let list = new Block(BlockKind.List)
			list.ordered = level.ordered
			list.start = level.start
			let first = true
			for let (_, child) in node.children {
				continue unless child.kind == XMLNodeKind.Element && (child.localName == "list-item" || child.localName == "list-header")
				let item = new Block(BlockKind.Item)
				let start = prop(child, "start-value")
				list.start = start.toInt<int>() when first && start != ""
				first = false
				let flow = new Flow(item)
				for let (_, part) in child.children {
					continue unless part.kind == XMLNodeKind.Element
					if part.localName == "list" {
						flow.add(list(part, depth + 1, styleName))
					} else {
						let holder = new XMLNode("holder")
						holder.children.push(part)
						blocks(holder, flow)
					}
				}
				task(item)
				list.add(item)
			}
			return list
		}

		// task reads a `☐` or `☒` an item starts with as its task state.
		def task(item Block) {
			return when item.children.len() == 0 || item.children[0].kind != BlockKind.Paragraph
			let paragraph = item.children[0]
			return when paragraph.inlines.len() == 0 || paragraph.inlines[0].kind != InlineKind.Text
			let first = paragraph.inlines[0].content
			for let (_, box) in string["☐ ", "☑ ", "☒ "] {
				if first.startsWith(box) {
					item.checked = box != "☐ "
					if first.len() == 2 {
						paragraph.inlines = paragraph.inlines[1:]
					} else {
						paragraph.inlines[0] = text(first[2:])
					}
					return
				}
			}
		}

		def table(node XMLNode) ?Block {
			let table = new Block(BlockKind.Table)
			let rows = XMLNode[]
			let heads = bool[]
			collectRows(node, rows, heads, false)
			for let (r, tr) in rows {
				let row = new Block(BlockKind.Row)
				row.header = heads[r]
				for let (_, tc) in tr.children {
					continue unless tc.kind == XMLNodeKind.Element && tc.localName == "table-cell"
					let cell = new Block(BlockKind.Cell)
					let across = prop(tc, "number-columns-spanned")
					let down = prop(tc, "number-rows-spanned")
					cell.columnSpan = across == "" ?? (1, across.toInt<int>().clamp(1, 1000))
					cell.rowSpan = down == "" ?? (1, down.toInt<int>().clamp(1, 1000))
					let repeat = prop(tc, "number-columns-repeated")
					let times = repeat == "" ?? (1, repeat.toInt<int>().clamp(1, 1000))
					blocks(tc, new Flow(cell))
					row.add(cell)
					for let k = 1; k < times && k < 64; k++ {
						let copy = new Block(BlockKind.Cell)
						blocks(tc, new Flow(copy))
						row.add(copy)
					}
				}
				table.add(row) when row.children.len() > 0
			}
			return none when table.children.len() == 0
			let width = gridWidth(table)
			for let i = 0; i < width; i++ {
				table.alignments.push(Alignment.Default)
			}
			columnAlignments(table)
			return table
		}

		def collectRows(node XMLNode, rows XMLNode[], heads bool[], header bool) {
			for let (_, child) in node.children {
				continue unless child.kind == XMLNodeKind.Element
				match child.localName {
					case "table-row":
						let repeat = prop(child, "number-rows-repeated")
						let times = repeat == "" ?? (1, repeat.toInt<int>().clamp(1, 64))
						for let k = 0; k < times; k++ {
							rows.push(child)
							heads.push(header)
						}
					case "table-header-rows":
						collectRows(child, rows, heads, true)
					case "table-rows", "table-row-group":
						collectRows(child, rows, heads, header)
				}
			}
		}

		// runs reads the inline content of a paragraph or heading.
		def runs(node XMLNode, marks Marks) Inline[] {
			let spans = new Spans()
			inline(node, marks, spans)
			return spans.items
		}

		def inline(node XMLNode, marks Marks, spans Spans) {
			for let (_, child) in node.children {
				if child.kind == XMLNodeKind.Text {
					spans.add(squash(child.content), marks)
					continue
				}
				match child.localName {
					case "span":
						inline(child, marksOf(prop(child, "style-name"), marks), spans)
					case "a":
						let link = new Inline(InlineKind.Link)
						link.url = prop(child, "href")
						link.title = prop(child, "title")
						let inner = new Spans()
						inline(child, Marks{...marks, underline: false, foreground: none}, inner)
						link.children = inner.items
						spans.put(link)
					case "s":
						let count = prop(child, "c")
						spans.add(" ".repeat(count == "" ?? (1, count.toInt<int>().clamp(1, 1000))), marks)
					case "tab":
						spans.add("\t", marks)
					case "line-break":
						spans.put(lineBreak())
					case "note":
						spans.put(note(child))
					case "frame":
						let image = picture(child)
						spans.put(image) unless image is none
					case "bookmark", "bookmark-start":
						let name = prop(child, "name")
						bookmark = name when bookmark == "" && name != "" && !name.startsWith("_")
					case "soft-page-break", "bookmark-end", "reference-mark", "reference-mark-start", "reference-mark-end", "annotation", "annotation-end", "change", "change-start", "change-end", "toc-mark", "alphabetical-index-mark":
						continue
					default:
						inline(child, marks, spans)
				}
			}
		}

		def note(node XMLNode) Inline {
			let footnote = new Inline(InlineKind.Footnote)
			let body = node.child("note-body")
			return footnote when body is none
			let holder = new Block(BlockKind.Section)
			blocks(body, new Flow(holder))
			footnote.note = holder.children
			return footnote
		}

		// picture returns the Image inline of a frame, none when the frame holds
		// no picture.
		def picture(frame XMLNode) ?Inline {
			let found = frame.elements("image")
			return none when found.len() == 0
			let href = prop(found[0], "href")
			return none when href == ""
			let image = new Inline(InlineKind.Image)
			if href.indexOf("://") >= 0 {
				image.url = href
			} else {
				let part = normalize(href)
				let known = images.get(part)
				if known is none {
					let data = pkg.read(part) onerror recover none
					if data is none {
						image.url = href
					} else {
						let base = baseName(part)
						let unique = base
						let n = 2
						for doc.resources.hasKey(unique) {
							unique = "{n}-{base}"
							n++
						}
						doc.resources.set(unique, data)
						images.set(part, unique)
						image.url = unique
					}
				} else {
					image.url = known
				}
			}
			let title = frame.child("title")
			image.title = title is none ?? ("", title.text().trim())
			let desc = frame.child("desc")
			let alt = desc is none ?? ("", desc.text().trim())
			image.children.push(text(alt)) unless alt == ""
			return image
		}
	}

	// squash returns the text with each run of white space made one space, as
	// ODF reads character data.
	def squash(content string) string {
		let raw = content.bytes()
		let plain = true
		for let i = 0; i < raw.len(); i++ {
			let c = int(raw[i])
			if c == 0x09 || c == 0x0A || c == 0x0D || (c == 0x20 && i + 1 < raw.len() && int(raw[i + 1]) == 0x20) {
				plain = false
				break
			}
		}
		return content when plain
		let out byte[] = []
		let space = false
		for let i = 0; i < raw.len(); i++ {
			let c = int(raw[i])
			if c := 0x20 || 0x09 || 0x0A || 0x0D {
				space = true
				continue
			}
			out.push(byte(' ')) when space
			space = false
			out.push(raw[i])
		}
		out.push(byte(' ')) when space
		return string(out)
	}

	def alignmentOf(value string) Alignment {
		match value {
			case "left", "start":
				return Alignment.Left
			case "center":
				return Alignment.Center
			case "right", "end":
				return Alignment.Right
			case "justify":
				return Alignment.Justify
			default:
				return Alignment.Default
		}
	}
}
