partial module std.formats.docs {
	use (
		std.bytes
		std.data.encoding::(XML)
		std.formats.archive::(CompressionLevel, Entry, WriteOptions, Zip)
		std.gfx.color
		std.testing
	)

	check "Odt" {
		// odtSample builds a document with the constructs ODT keeps.
		internal def odtSample() Document {
			let doc = new Document("Quarterly Report")
			doc.authors.push("Ann Lee", "Bo Chen")
			doc.metadata.set("subject", "Sales")
			doc.metadata.set("project", "Apollo")
			doc.language = "de-DE"
			doc.heading(1, "Summary").attributes.set("id", "summary")
			doc.paragraph(text("Revenue "), bold("grew"), text(" by "), italic(text("a "), bold("lot")), text(", "), strike("not"), text(" see "), link("the site", "https://a.example/x?q=1&r=2", "Home"), text(" and "), code("x  <y>"), text(" "), underline("under"), text("."))
			doc.paragraph(text("Colors: "), colored("red", new color.Color(color.RGBA{r: 255, g: 0, b: 0, a: 255})), text(" and "), text("Ünïcødé — 😀 <&>"), lineBreak(), text("next\tline"), footnote("A note."))
			doc.paragraph("centered").alignment = Alignment.Center
			doc.paragraph("styled").styleName = "Fancy"
			doc.heading(2, "Lists")
			let items = doc.list(string["one", "two"])
			items.children[0].list(string["nested a", "nested b"], true).start = 4
			let tasks = doc.list(string["done", "open"])
			tasks.children[0].checked = true
			tasks.children[1].checked = false
			doc.list(string["ninth", "tenth"], true).start = 9
			let quote = doc.quote()
			quote.paragraph("quoted")
			quote.paragraph("again")
			doc.code("", "func main() \{\n    println(1)\n\}")
			doc.rule()
			let table = doc.table(string["Region", "Sales", "Note"], string[][string["North", "120", "a"], string["South", "95", "b"], string["East", "7"]])
			table.alignments[1] = Alignment.Right
			table.children[1].children[2].rowSpan = 2
			table.children[3].children[0].columnSpan = 2
			table.children[3].children.pop()
			table.children[2].children.pop()
			doc.paragraph("before break")
			doc.pageBreak()
			doc.image("chart.png", byte[0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 13, 0x49, 0x48, 0x44, 0x52, 0, 0, 0, 2, 0, 0, 0, 3], "The chart")
			doc.paragraph("last")
			return doc
		}

		@test()
		def TestRoundTrip() !none {
			let codec = new Odt()
			let doc = odtSample()
			let back = try codec.decode(try codec.encode(doc))
			assert back.title == doc.title
			assert back.authors.join("|") == "Ann Lee|Bo Chen"
			assert back.metadata.len() == 2 && back.metadata["subject"] == "Sales" && back.metadata["project"] == "Apollo"
			assert back.language == "de-DE"
			let markdown = new Markdown()
			assert markdown.encode(back) == markdown.encode(doc).replace("chart.png", "image1.png")
			assert back.blocks[0].attributes["id"] == "summary"
			assert back.blocks[3].alignment == Alignment.Center
			assert back.blocks[4].styleName == "Fancy"
			let table = back.tables()[0]
			assert table.alignments[1] == Alignment.Right
			assert table.children[0].header && !table.children[1].header
			assert table.children[1].children[2].rowSpan == 2
			assert table.children[3].children[0].columnSpan == 2
			let breaks = 0
			back.walk(def (block Block) bool {
				breaks++ when block.kind == BlockKind.PageBreak
				return true
			})
			assert breaks == 1
			let data = back.resource("image1.png")
			fail "no picture" when data is none
			assert data.len() == 24
			return none
		}

		@test()
		def TestPackageLayout() !none {
			let encoded = try new Odt().encode(odtSample())
			assert string(encoded[30:38]) == "mimetype"
			assert string(encoded[38:77]) == "application/vnd.oasis.opendocument.text"
			assert int(encoded[8]) == 0 && int(encoded[28]) == 0
			let arc = try new Zip().open(new bytes.Reader(encoded))
			let names = string[]
			for let (_, entry) in arc.entries() {
				names.push(entry.name)
			}
			assert names.join(",") == "mimetype,META-INF/manifest.xml,meta.xml,styles.xml,content.xml,Pictures/image1.png"
			assert arc.entries()[0].method == "store"
			let entry = arc.entry("content.xml")
			fail "no content" when entry is none
			let content = new bytes.Buffer()
			try content.readFrom(try arc.open(entry))
			let root = try new XML().parse(content.bytes())
			assert root.namespace == "urn:oasis:names:tc:opendocument:xmlns:office:1.0"
			return none
		}

		@test()
		def TestDecodeWriterFeatures() !none {
			let ns = "xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:style=\"urn:oasis:names:tc:opendocument:xmlns:style:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" xmlns:fo=\"urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:meta=\"urn:oasis:names:tc:opendocument:xmlns:meta:1.0\""
			let styles = "<office:document-styles {ns}><office:font-face-decls><style:font-face style:name=\"Mono\" svg:font-family=\"Whatever\" style:font-pitch=\"fixed\"/></office:font-face-decls><office:styles><style:default-style style:family=\"paragraph\"><style:text-properties fo:language=\"pt\" fo:country=\"BR\"/></style:default-style><style:style style:name=\"Standard\" style:family=\"paragraph\"/><style:style style:name=\"Quotations\" style:family=\"paragraph\"/><style:style style:name=\"Strong_20_Emphasis\" style:display-name=\"Strong Emphasis\" style:family=\"text\"/><style:style style:name=\"Base\" style:family=\"text\"><style:text-properties fo:font-style=\"italic\"/></style:style><text:list-style style:name=\"Numbers\"><text:list-level-style-number text:level=\"1\" style:num-format=\"1\" text:start-value=\"5\"/><text:list-level-style-bullet text:level=\"2\" text:bullet-char=\"-\"/></text:list-style></office:styles></office:document-styles>"
			let body = "<text:h text:outline-level=\"3\"><text:bookmark-start text:name=\"deep\"/>Deep  <text:span text:style-name=\"T1\">heading</text:span></text:h>"
			body += "<text:p text:style-name=\"P1\">  Lots   of\n  space<text:s text:c=\"3\"/>kept<text:tab/>tab <text:span text:style-name=\"T2\">child</text:span> <text:span text:style-name=\"Strong_20_Emphasis\">strong</text:span> <text:a xlink:href=\"https://x.example/\">link</text:a><text:line-break/>next<text:note text:note-class=\"footnote\"><text:note-citation>1</text:note-citation><text:note-body><text:p>Note body.</text:p></text:note-body></text:note></text:p>"
			body += "<text:list text:style-name=\"Numbers\"><text:list-item><text:p>five</text:p><text:list><text:list-item><text:p>dash</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p>six</text:p></text:list-item></text:list>"
			body += "<text:p text:style-name=\"Quotations\">Quoted</text:p>"
			body += "<text:p><text:span text:style-name=\"T3\">code only</text:span></text:p>"
			body += "<table:table><table:table-column table:number-columns-repeated=\"2\"/><table:table-header-rows><table:table-row><table:table-cell table:number-columns-spanned=\"2\"><text:p>Head</text:p></table:table-cell><table:covered-table-cell/></table:table-row></table:table-header-rows><table:table-row><table:table-cell><text:p>a</text:p></table:table-cell><table:table-cell><text:p>b</text:p></table:table-cell></table:table-row></table:table>"
			body += "<text:p text:style-name=\"P2\">after break</text:p>"
			let content = "<office:document-content {ns}><office:automatic-styles><style:style style:name=\"P1\" style:family=\"paragraph\" style:parent-style-name=\"Standard\"><style:paragraph-properties fo:text-align=\"end\"/></style:style><style:style style:name=\"P2\" style:family=\"paragraph\"><style:paragraph-properties fo:break-before=\"page\"/></style:style><style:style style:name=\"T1\" style:family=\"text\"><style:text-properties fo:font-weight=\"bold\"/></style:style><style:style style:name=\"T2\" style:family=\"text\" style:parent-style-name=\"Base\"><style:text-properties fo:font-weight=\"bold\"/></style:style><style:style style:name=\"T3\" style:family=\"text\"><style:text-properties style:font-name=\"Mono\"/></style:style></office:automatic-styles><office:body><office:text>{body}</office:text></office:body></office:document-content>"
			let metaXml = "<office:document-meta {ns}><office:meta><dc:title>Título</dc:title><meta:initial-creator>Ana</meta:initial-creator><dc:creator>Ana</dc:creator><meta:keyword>x</meta:keyword><meta:keyword>y</meta:keyword><meta:user-defined meta:name=\"Client\">ACME</meta:user-defined><meta:creation-date>2026-09-21T10:00:00</meta:creation-date></office:meta></office:document-meta>"

			let out = new bytes.Buffer()
			let zip = try new Zip().create(out, WriteOptions{level: CompressionLevel.Default})
			let names = string["mimetype", "styles.xml", "content.xml", "meta.xml"]
			let parts = string["application/vnd.oasis.opendocument.text", styles, content, metaXml]
			for let (i, name) in names {
				try zip.add(Entry{name: name, method: i == 0 ?? ("store", ""), attributes: new map<string, string>()}, new bytes.Reader(parts[i].bytes()))
			}
			try zip.close()
			let codec = new Odt()
			assert codec.matchSignature(new bytes.Reader(out.bytes()))
			let doc = try codec.decode(out.bytes())

			assert doc.title == "Título"
			assert doc.authors.join("|") == "Ana"
			assert doc.metadata["keywords"] == "x, y"
			assert doc.metadata["Client"] == "ACME"
			assert doc.language == "pt-BR"
			let kinds = string[]
			for let (_, block) in doc.blocks {
				kinds.push("{block.kind}")
			}
			assert kinds.join(",") == "Heading,Paragraph,List,Quote,Code,Table,PageBreak,Paragraph"
			let heading = doc.blocks[0]
			assert heading.level == 3
			assert heading.attributes["id"] == "deep"
			assert heading.plainText() == "Deep heading"
			let para = doc.blocks[1]
			assert para.alignment == Alignment.Right
			assert para.plainText() == "Lots of space   kept\ttab child strong link\nnext"
			let child = para.inlines[1]
			assert child.kind == InlineKind.Bold && child.children[0].kind == InlineKind.Italic
			assert para.inlines[3].kind == InlineKind.Bold
			assert para.inlines[5].kind == InlineKind.Link && para.inlines[5].url == "https://x.example/"
			let last = para.inlines[para.inlines.len() - 1]
			assert last.kind == InlineKind.Footnote && last.note[0].plainText() == "Note body."
			let list = doc.blocks[2]
			assert list.ordered && list.start == 5 && list.children.len() == 2
			let nested = list.children[0].children[1]
			assert nested.kind == BlockKind.List && !nested.ordered
			assert doc.blocks[3].plainText() == "Quoted"
			assert doc.blocks[4].content == "code only"
			let table = doc.blocks[5]
			assert table.children[0].header
			assert table.children[0].children[0].columnSpan == 2
			assert table.children[1].children.len() == 2
			assert doc.blocks[7].plainText() == "after break"
			return none
		}

		@test()
		def TestSignatureAndLoad() !none {
			let codec = new Odt()
			let encoded = try codec.encode(odtSample())
			assert codec.matchSignature(new bytes.Reader(encoded))
			assert !codec.matchSignature(new bytes.Reader(try new Docx().encode(odtSample())))
			let doc = try load(encoded)
			assert doc.title == "Quarterly Report"
			return none
		}
	}
}
