internal partial module std.formats.docs.odt {
	use (
		std.data.encoding::(XMLWriter)
		std.formats.docs.office::*
		std.formats.container::*
		std.formats.docs::*
		std.os
	)

	const mimeOdt = "application/vnd.oasis.opendocument.text"

	// Namespaces of the parts, by prefix.
	const odfNamespaces = "office urn:oasis:names:tc:opendocument:xmlns:office:1.0|style urn:oasis:names:tc:opendocument:xmlns:style:1.0|text urn:oasis:names:tc:opendocument:xmlns:text:1.0|table urn:oasis:names:tc:opendocument:xmlns:table:1.0|draw urn:oasis:names:tc:opendocument:xmlns:drawing:1.0|fo urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0|xlink http://www.w3.org/1999/xlink|dc http://purl.org/dc/elements/1.1/|meta urn:oasis:names:tc:opendocument:xmlns:meta:1.0|svg urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"

	// OdtWriter writes a Document as an ODF text package.
	type OdtWriter {
		doc        Document
		font       string
		codeFont   string
		fontSize   int
		body       XMLWriter
		// Automatic styles by what they set, and their names in order.
		textStyles map<string, string>
		textKeys   string[]
		paraStyles map<string, string>
		paraKeys   string[]
		// Level kinds of each list style: "b" bullet, "n" number.
		listStyles string[]
		named      map<string, string>
		media      map<string, string>
		notes      int
		frames     int
		tables     int
		inNote     bool

		def new(doc Document, font string, codeFont string, fontSize int) {
			self.doc = doc
			self.font = font
			self.codeFont = codeFont
			self.fontSize = fontSize
			body = new XMLWriter()
			textStyles = new map<string, string>()
			textKeys = string[]
			paraStyles = new map<string, string>()
			paraKeys = string[]
			listStyles = string[]
			named = new map<string, string>()
			media = new map<string, string>()
		}

		// encode returns the package's bytes. Fails when the zip writer does.
		def encode() !byte[] {
			text()
			let pkg = new PackageWriter()
			try pkg.add("mimetype", mimeOdt.bytes(), true)
			try pkg.add("META-INF/manifest.xml", manifest())
			try pkg.add("meta.xml", metaPart())
			try pkg.add("styles.xml", stylesPart())
			try pkg.add("content.xml", content())
			for let (name, part) in media {
				let data = doc.resources.get(name)
				try pkg.add(part, data) unless data is none
			}
			return try pkg.bytes()
		}

		def open(w XMLWriter, root string) {
			w.declaration()
			w.start(root)
			for let (_, pair) in odfNamespaces.split("|") {
				let space = pair.indexOf(" ")
				w.attribute("xmlns:" + pair[:space], pair[space + 1:])
			}
			w.attribute("office:version", "1.3")
		}

		def manifest() string {
			let w = new XMLWriter()
			w.declaration()
			w.start("manifest:manifest")
			w.attribute("xmlns:manifest", "urn:oasis:names:tc:opendocument:xmlns:manifest:1.0")
			w.attribute("manifest:version", "1.3")
			fileEntry(w, "/", mimeOdt)
			for let (_, part) in string["content.xml", "styles.xml", "meta.xml"] {
				fileEntry(w, part, "text/xml")
			}
			for let (_, part) in media {
				fileEntry(w, part, mediaType(part))
			}
			return w.str()
		}

		def fileEntry(w XMLWriter, path string, kind string) {
			w.start("manifest:file-entry")
			w.attribute("manifest:full-path", path)
			w.attribute("manifest:version", "1.3") when path == "/"
			w.attribute("manifest:media-type", kind)
			w.end()
		}

		def metaPart() string {
			let w = new XMLWriter()
			open(w, "office:document-meta")
			w.start("office:meta")
			w.element("meta:generator", "ADM")
			w.element("dc:title", doc.title) unless doc.title == ""
			if doc.authors.len() > 0 {
				w.element("meta:initial-creator", doc.authors[0])
				w.element("dc:creator", doc.authors.join("; "))
			}
			let date = doc.date
			w.element("meta:creation-date", stamp(date)) unless date is none
			w.element("dc:language", doc.language) unless doc.language == ""
			let keys = doc.metadata.keys()
			keys.sort((a string, b string) => a.compare(b) < 0)
			for let (_, key) in keys {
				let value = doc.metadata.get(key)
				continue when value is none || key == "subtitle"
				if key := "subject" || "description" {
					w.element("dc:" + key, value)
				} else if key == "keywords" {
					w.element("meta:keyword", value)
				} else {
					w.start("meta:user-defined")
					w.attribute("meta:name", key)
					w.text(value)
					w.end()
				}
			}
			return w.str()
		}

		def text() {
			let w = body
			if doc.title != "" {
				let opening = doc.body.children.len() > 0 ?? (doc.body.children[0], new Block(BlockKind.Paragraph))
				if !(opening.kind == BlockKind.Heading && opening.level == 1 && opening.plainText() == doc.title) {
					w.start("text:p")
					w.attribute("text:style-name", "Title")
					writeText(w, doc.title, false)
					w.end()
				}
			}
			let subtitle = doc.metadata.get("subtitle")
			if !(subtitle is none) {
				w.start("text:p")
				w.attribute("text:style-name", "Subtitle")
				writeText(w, subtitle, false)
				w.end()
			}
			blocks(w, doc.body.children, false)
		}

		def blocks(w XMLWriter, items Block[], quoted bool) {
			for let (i, block) in items {
				let breakAfter = i + 1 < items.len() && items[i + 1].kind == BlockKind.PageBreak
				write(w, block, quoted, breakAfter)
			}
		}

		def write(w XMLWriter, block Block, quoted bool, breakAfter bool) {
			match block.kind {
				case BlockKind.Heading:
					let level = block.level.clamp(1, 6)
					w.start("text:h")
					w.attribute("text:style-name", paragraphStyle("Heading_20_{level}", block.alignment, breakAfter))
					w.attribute("text:outline-level", "{level}")
					let id = block.attributes.get("id")
					if !(id is none) {
						w.start("text:bookmark")
						w.attribute("text:name", id)
						w.end()
					}
					inlines(w, block.inlines, Marks{})
					w.end()
				case BlockKind.Paragraph:
					let parent = quoted ?? ("Quotations", namedStyle(block.styleName))
					w.start("text:p")
					w.attribute("text:style-name", paragraphStyle(parent, block.alignment, breakAfter))
					inlines(w, block.inlines, Marks{})
					w.end()
				case BlockKind.List:
					list(w, block, 0, "")
				case BlockKind.Table:
					table(w, block)
				case BlockKind.Image:
					w.start("text:p")
					w.attribute("text:style-name", paragraphStyle("Standard", block.alignment, breakAfter && block.inlines.len() == 0))
					frame(w, block.source, textOf(block.inlines), block.title)
					w.end()
					if block.inlines.len() > 0 {
						w.start("text:p")
						w.attribute("text:style-name", paragraphStyle("Caption", Alignment.Default, breakAfter))
						inlines(w, block.inlines, Marks{})
						w.end()
					}
				case BlockKind.Code:
					w.start("text:p")
					w.attribute("text:style-name", paragraphStyle("Preformatted_20_Text", Alignment.Default, breakAfter))
					writeText(w, block.content, true)
					w.end()
				case BlockKind.Quote:
					blocks(w, block.children, true)
				case BlockKind.Rule:
					w.start("text:p")
					w.attribute("text:style-name", paragraphStyle("Horizontal_20_Line", Alignment.Default, breakAfter))
					w.end()
				case BlockKind.PageBreak:
					return
				case BlockKind.Raw:
					w.raw(block.content) when block.format == "odt"
				default:
					blocks(w, block.children, quoted)
			}
		}

		// paragraphStyle returns the style a paragraph names: the named style
		// itself, or an automatic one based on it that adds the alignment or
		// a page break after.
		def paragraphStyle(parent string, alignment Alignment, breakAfter bool) string {
			return parent when alignment == Alignment.Default && !breakAfter
			let key = "{parent}|{alignment}|{breakAfter}"
			let known = paraStyles.get(key)
			return known unless known is none
			let name = "P{paraKeys.len() + 1}"
			paraStyles.set(key, name)
			paraKeys.push(key)
			return name
		}

		// namedStyle returns the style name of a styleName, declaring it the
		// first time; Standard when there is none.
		def namedStyle(styleName string) string {
			return "Standard" when styleName == ""
			let known = named.get(styleName)
			return known unless known is none
			let name = ""
			for let (_, c) in styleName {
				name += c == ' ' ?? ("_20_", string(c)) when (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == ' '
			}
			name = "Custom" when name == ""
			named.set(styleName, name)
			return name
		}

		def list(w XMLWriter, block Block, depth int, styleName string) {
			w.start("text:list")
			let listStyle = styleName
			if depth == 0 {
				listStyle = "L{listStyles.len() + 1}"
				let kinds = string["", "", "", "", "", "", "", "", "", ""]
				levelKinds(block, 0, kinds)
				listStyles.push(kinds.join(","))
				w.attribute("text:style-name", listStyle)
			}
			for let (i, item) in block.children {
				w.start("text:list-item")
				w.attribute("text:start-value", "{block.start}") when i == 0 && block.ordered && block.start != 1
				let first = true
				for let (_, child) in item.children {
					if child.kind == BlockKind.List {
						list(w, child, depth + 1, listStyle)
						continue
					}
					if child.kind != BlockKind.Paragraph {
						write(w, child, quoted = false, breakAfter = false)
						continue
					}
					w.start("text:p")
					w.attribute("text:style-name", paragraphStyle(namedStyle(child.styleName), child.alignment, false))
					let checked = item.checked
					writeText(w, checked ?? ("☒ ", "☐ "), false) when first && !(checked is none)
					inlines(w, child.inlines, Marks{})
					w.end()
					first = false
				}
				if first {
					w.start("text:p")
					w.attribute("text:style-name", "Standard")
					let checked = item.checked
					writeText(w, checked ?? ("☒", "☐"), false) unless checked is none
					w.end()
				}
				w.end()
			}
			w.end()
		}

		// levelKinds records whether each depth of the list is numbered, the
		// first list met at a depth deciding.
		def levelKinds(block Block, depth int, kinds string[]) {
			return when depth > 9
			kinds[depth] = block.ordered ?? ("n", "b") when kinds[depth] == ""
			for let (_, item) in block.children {
				for let (_, child) in item.children {
					levelKinds(child, depth + 1, kinds) when child.kind == BlockKind.List
				}
			}
		}

		def table(w XMLWriter, block Block) {
			let width = gridWidth(block)
			return when width == 0
			tables++
			w.start("table:table")
			w.attribute("table:name", "Table{tables}")
			w.attribute("table:style-name", "Tbl")
			w.start("table:table-column")
			w.attribute("table:number-columns-repeated", "{width}")
			w.end()
			let covered = int[]
			for let i = 0; i < width; i++ {
				covered.push(0)
			}
			let rows = block.children
			let heads = 0
			for heads < rows.len() && rows[heads].header {
				heads++
			}
			w.start("table:table-header-rows") when heads > 0
			for let (r, row) in rows {
				w.end() when r == heads && heads > 0
				w.start("table:table-row")
				let column = 0
				let next = 0
				for column < width {
					if covered[column] > 0 {
						covered[column]--
						w.start("table:covered-table-cell")
						w.end()
						column++
						continue
					}
					if next >= row.children.len() {
						w.start("table:table-cell")
						w.attribute("table:style-name", "Cell")
						w.start("text:p")
						w.end()
						w.end()
						column++
						continue
					}
					let cell = row.children[next]
					next++
					let across = cell.columnSpan.clamp(1, width - column)
					w.start("table:table-cell")
					w.attribute("table:style-name", "Cell")
					w.attribute("table:number-columns-spanned", "{across}") when across > 1
					w.attribute("table:number-rows-spanned", "{cell.rowSpan}") when cell.rowSpan > 1
					w.attribute("office:value-type", "string")
					let alignment = column < block.alignments.len() ?? (block.alignments[column], Alignment.Default)
					let parent = row.header ?? ("Table_20_Heading", "Table_20_Contents")
					let wrote = false
					for let (_, child) in cell.children {
						if child.kind == BlockKind.Paragraph {
							w.start("text:p")
							let own = child.alignment == Alignment.Default ?? (alignment, child.alignment)
							w.attribute("text:style-name", paragraphStyle(child.styleName == "" ?? (parent, namedStyle(child.styleName)), own, false))
							inlines(w, child.inlines, Marks{})
							w.end()
						} else {
							write(w, child, quoted = false, breakAfter = false)
						}
						wrote = true
					}
					if !wrote {
						w.start("text:p")
						w.attribute("text:style-name", parent)
						w.end()
					}
					w.end()
					for let k = 0; k < across; k++ {
						covered[column + k] = cell.rowSpan - 1
					}
					for let k = 1; k < across; k++ {
						w.start("table:covered-table-cell")
						w.end()
					}
					column += across
				}
				w.end()
			}
			w.end() when heads == rows.len() && heads > 0
			w.end()
		}

		def inlines(w XMLWriter, items Inline[], marks Marks) {
			for let (_, item) in items {
				match item.kind {
					case InlineKind.Text:
						span(w, item.content, marks, false)
					case InlineKind.Bold:
						inlines(w, item.children, Marks{...marks, bold: true})
					case InlineKind.Italic:
						inlines(w, item.children, Marks{...marks, italic: true})
					case InlineKind.Underline:
						inlines(w, item.children, Marks{...marks, underline: true})
					case InlineKind.Strike:
						inlines(w, item.children, Marks{...marks, strike: true})
					case InlineKind.Code:
						span(w, item.content, marks, true)
					case InlineKind.Styled:
						let foreground = item.foreground
						foreground = marks.foreground when foreground is none
						let background = item.background
						background = marks.background when background is none
						inlines(w, item.children, Marks{...marks, foreground: foreground, background: background})
					case InlineKind.Link:
						w.start("text:a")
						w.attribute("xlink:type", "simple")
						w.attribute("xlink:href", item.url)
						w.attribute("office:title", item.title) unless item.title == ""
						w.attribute("text:style-name", "Internet_20_link")
						inlines(w, item.children, marks)
						w.end()
					case InlineKind.Image:
						frame(w, item.url, textOf(item.children), item.title)
					case InlineKind.LineBreak:
						w.start("text:line-break")
						w.end()
					case InlineKind.Footnote:
						footnote(w, item)
					case InlineKind.Raw:
						w.raw(item.content) when item.format == "odt"
				}
			}
		}

		// span writes text inside the automatic style its marks need, and
		// inside the code style for code.
		def span(w XMLWriter, content string, marks Marks, code bool) {
			return when content == ""
			let auto = textStyle(marks)
			if auto != "" {
				w.start("text:span")
				w.attribute("text:style-name", auto)
			}
			if code {
				w.start("text:span")
				w.attribute("text:style-name", "Source_20_Text")
			}
			writeText(w, content, code)
			w.end() when code
			w.end() when auto != ""
		}

		def textStyle(marks Marks) string {
			let key = markKeys(marks).join("|")
			return "" when key == ""
			let known = textStyles.get(key)
			return known unless known is none
			let name = "T{textKeys.len() + 1}"
			textStyles.set(key, name)
			textKeys.push(key)
			return name
		}

		// writeText writes characters, tabs, line breaks and runs of spaces as
		// ODF needs them. With `preserve` a leading space is kept too.
		def writeText(w XMLWriter, content string, preserve bool) {
			let pending = ""
			let n = content.len()
			let i = 0
			for i < n {
				let c = content[i]
				if c := '\t' || '\n' {
					w.text(pending)
					pending = ""
					w.start(c == '\t' ?? ("text:tab", "text:line-break"))
					w.end()
					i++
					continue
				}
				if c == ' ' {
					let runEnd = i
					for runEnd < n && content[runEnd] == ' ' {
						runEnd++
					}
					let count = runEnd - i
					let leading = i == 0 || content[i - 1] == '\n' || content[i - 1] == '\t'
					let literal = leading && preserve ?? (0, 1)
					pending += " " when literal == 1
					let rest = count - literal
					if rest > 0 {
						w.text(pending)
						pending = ""
						w.start("text:s")
						w.attribute("text:c", "{rest}") when rest > 1
						w.end()
					}
					i = runEnd
					continue
				}
				pending += string(c)
				i++
			}
			w.text(pending)
		}

		def footnote(w XMLWriter, item Inline) {
			return when inNote
			notes++
			inNote = true
			w.start("text:note")
			w.attribute("text:id", "ftn{notes}")
			w.attribute("text:note-class", "footnote")
			w.element("text:note-citation", "{notes}")
			w.start("text:note-body")
			let wrote = false
			for let (_, block) in item.note {
				if block.kind == BlockKind.Paragraph {
					w.start("text:p")
					w.attribute("text:style-name", "Footnote")
					inlines(w, block.inlines, Marks{})
					w.end()
				} else {
					write(w, block, quoted = false, breakAfter = false)
				}
				wrote = true
			}
			if !wrote {
				w.start("text:p")
				w.attribute("text:style-name", "Footnote")
				w.end()
			}
			w.end()
			w.end()
			inNote = false
		}

		// frame writes a picture in the text flow, embedded when it is a
		// resource.
		def frame(w XMLWriter, source string, alt string, title string) {
			let data = doc.resources.get(source)
			let href = source
			let width = 4.0
			let height = 3.0
			if !(data is none) {
				let known = media.get(source)
				href = known is none ?? ("", known)
				if href == "" {
					let ext = os.extension(source).lower().trimPrefix(".")
					ext = imageExtension(data) when ext == ""
					href = "Pictures/image{media.len() + 1}.{ext}"
					media.set(source, href)
				}
				let (px, py) = pixelSize(data)
				if px > 0 && py > 0 {
					width = float(px) / 96.0
					height = float(py) / 96.0
					if width > 6.5 {
						height = height * 6.5 / width
						width = 6.5
					}
				}
			}
			frames++
			w.start("draw:frame")
			w.attribute("draw:name", "Image{frames}")
			w.attribute("text:anchor-type", "as-char")
			w.attribute("svg:width", inches(width))
			w.attribute("svg:height", inches(height))
			w.start("draw:image")
			w.attribute("xlink:href", href)
			w.attribute("xlink:type", "simple")
			w.attribute("xlink:show", "embed")
			w.attribute("xlink:actuate", "onLoad")
			w.end()
			w.element("svg:title", title) unless title == ""
			w.element("svg:desc", alt) unless alt == ""
			w.end()
		}

		def content() string {
			let w = new XMLWriter()
			open(w, "office:document-content")
			fontDecls(w)
			w.start("office:automatic-styles")
			for let (i, key) in textKeys {
				w.start("style:style")
				w.attribute("style:name", "T{i + 1}")
				w.attribute("style:family", "text")
				w.start("style:text-properties")
				for let (_, part) in key.split("|") {
					match part {
						case "b":
							w.attribute("fo:font-weight", "bold")
						case "i":
							w.attribute("fo:font-style", "italic")
						case "u":
							w.attribute("style:text-underline-style", "solid")
							w.attribute("style:text-underline-width", "auto")
							w.attribute("style:text-underline-color", "font-color")
						case "s":
							w.attribute("style:text-line-through-style", "solid")
						default:
							let slash = part.indexOf("/")
							let fore = part[2:slash]
							let back = part[slash + 1:]
							w.attribute("fo:color", "#" + fore.lower()) unless fore == ""
							w.attribute("fo:background-color", "#" + back.lower()) unless back == ""
					}
				}
				w.end()
				w.end()
			}
			for let (i, key) in paraKeys {
				let parts = key.split("|")
				w.start("style:style")
				w.attribute("style:name", "P{i + 1}")
				w.attribute("style:family", "paragraph")
				w.attribute("style:parent-style-name", parts[0])
				w.start("style:paragraph-properties")
				match parts[1] {
					case "Left":
						w.attribute("fo:text-align", "start")
					case "Center":
						w.attribute("fo:text-align", "center")
					case "Right":
						w.attribute("fo:text-align", "end")
					case "Justify":
						w.attribute("fo:text-align", "justify")
				}
				w.attribute("fo:break-after", "page") when parts[2] == "true"
				w.end()
				w.end()
			}
			for let (i, kinds) in listStyles {
				w.start("text:list-style")
				w.attribute("style:name", "L{i + 1}")
				for let (depth, kind) in kinds.split(",") {
					let level = depth + 1
					if kind == "n" {
						w.start("text:list-level-style-number")
						w.attribute("text:level", "{level}")
						w.attribute("style:num-suffix", ".")
						w.attribute("style:num-format", "1")
					} else {
						w.start("text:list-level-style-bullet")
						w.attribute("text:level", "{level}")
						w.attribute("text:bullet-char", depth % 3 == 0 ?? ("•", depth % 3 == 1 ?? ("◦", "▪")))
					}
					w.start("style:list-level-properties")
					w.attribute("text:list-level-position-and-space-mode", "label-alignment")
					w.start("style:list-level-label-alignment")
					w.attribute("text:label-followed-by", "listtab")
					w.attribute("fo:text-indent", "-0.25in")
					w.attribute("fo:margin-left", inches(0.5 * float(level)))
					w.end()
					w.end()
					w.end()
				}
				w.end()
			}
			w.start("style:style")
			w.attribute("style:name", "Tbl")
			w.attribute("style:family", "table")
			w.start("style:table-properties")
			w.attribute("style:width", "6.5in")
			w.attribute("table:align", "margins")
			w.end()
			w.end()
			w.start("style:style")
			w.attribute("style:name", "Cell")
			w.attribute("style:family", "table-cell")
			w.start("style:table-cell-properties")
			w.attribute("fo:padding", "0.04in")
			w.attribute("fo:border", "0.5pt solid #000000")
			w.end()
			w.end()
			w.end()
			w.start("office:body")
			w.start("office:text")
			w.raw(string(body.bytes()))
			w.end()
			w.end()
			return w.str()
		}

		def fontDecls(w XMLWriter) {
			w.start("office:font-face-decls")
			w.start("style:font-face")
			w.attribute("style:name", font)
			w.attribute("svg:font-family", font)
			w.attribute("style:font-pitch", "variable")
			w.end()
			w.start("style:font-face")
			w.attribute("style:name", codeFont)
			w.attribute("svg:font-family", codeFont)
			w.attribute("style:font-family-generic", "modern")
			w.attribute("style:font-pitch", "fixed")
			w.end()
			w.end()
		}

		def stylesPart() string {
			let w = new XMLWriter()
			open(w, "office:document-styles")
			fontDecls(w)
			w.start("office:styles")
			w.start("style:default-style")
			w.attribute("style:family", "paragraph")
			w.start("style:text-properties")
			w.attribute("style:font-name", font)
			w.attribute("fo:font-size", "{fontSize}pt")
			if doc.language != "" {
				let dash = doc.language.indexOf("-")
				w.attribute("fo:language", dash < 0 ?? (doc.language, doc.language[:dash]))
				w.attribute("fo:country", dash < 0 ?? ("none", doc.language[dash + 1:]))
			}
			w.end()
			w.end()
			paragraph(w, "Standard", "", "", "")
			w.start("style:paragraph-properties")
			w.attribute("fo:margin-bottom", "0.08in")
			w.end()
			w.end()
			paragraph(w, "Heading", "", "Standard", "")
			w.start("style:paragraph-properties")
			w.attribute("fo:margin-top", "0.17in")
			w.attribute("fo:keep-with-next", "always")
			w.end()
			w.start("style:text-properties")
			w.attribute("fo:font-weight", "bold")
			w.end()
			w.end()
			let sizes = int[180, 150, 130, 115, 110, 100]
			for let level = 1; level <= 6; level++ {
				paragraph(w, "Heading_20_{level}", "Heading {level}", "Heading", "{level}")
				w.start("style:text-properties")
				w.attribute("fo:font-size", "{sizes[level - 1]}%")
				w.end()
				w.end()
			}
			paragraph(w, "Title", "", "Heading", "")
			w.start("style:paragraph-properties")
			w.attribute("fo:text-align", "center")
			w.end()
			w.start("style:text-properties")
			w.attribute("fo:font-size", "220%")
			w.end()
			w.end()
			paragraph(w, "Subtitle", "", "Heading", "")
			w.start("style:paragraph-properties")
			w.attribute("fo:text-align", "center")
			w.end()
			w.start("style:text-properties")
			w.attribute("fo:font-size", "140%")
			w.attribute("fo:font-weight", "normal")
			w.end()
			w.end()
			paragraph(w, "Quotations", "", "Standard", "")
			w.start("style:paragraph-properties")
			w.attribute("fo:margin-left", "0.4in")
			w.attribute("fo:margin-right", "0.4in")
			w.end()
			w.start("style:text-properties")
			w.attribute("fo:font-style", "italic")
			w.end()
			w.end()
			paragraph(w, "Preformatted_20_Text", "Preformatted Text", "Standard", "")
			w.start("style:text-properties")
			w.attribute("style:font-name", codeFont)
			w.attribute("fo:font-size", "90%")
			w.end()
			w.end()
			paragraph(w, "Caption", "", "Standard", "")
			w.start("style:text-properties")
			w.attribute("fo:font-style", "italic")
			w.attribute("fo:font-size", "90%")
			w.end()
			w.end()
			paragraph(w, "Footnote", "", "Standard", "")
			w.start("style:text-properties")
			w.attribute("fo:font-size", "85%")
			w.end()
			w.end()
			paragraph(w, "Table_20_Contents", "Table Contents", "Standard", "")
			w.end()
			paragraph(w, "Table_20_Heading", "Table Heading", "Table_20_Contents", "")
			w.start("style:text-properties")
			w.attribute("fo:font-weight", "bold")
			w.end()
			w.end()
			paragraph(w, "Horizontal_20_Line", "Horizontal Line", "Standard", "")
			w.start("style:paragraph-properties")
			w.attribute("fo:border-bottom", "0.5pt solid #808080")
			w.attribute("fo:padding-bottom", "0in")
			w.end()
			w.end()
			let names = named.keys()
			names.sort((a string, b string) => a.compare(b) < 0)
			for let (_, display) in names {
				let name = named.get(display)
				continue when name is none
				paragraph(w, name, display, "Standard", "")
				w.end()
			}
			w.start("style:style")
			w.attribute("style:name", "Source_20_Text")
			w.attribute("style:display-name", "Source Text")
			w.attribute("style:family", "text")
			w.start("style:text-properties")
			w.attribute("style:font-name", codeFont)
			w.end()
			w.end()
			w.start("style:style")
			w.attribute("style:name", "Internet_20_link")
			w.attribute("style:display-name", "Internet link")
			w.attribute("style:family", "text")
			w.start("style:text-properties")
			w.attribute("fo:color", "#000080")
			w.attribute("style:text-underline-style", "solid")
			w.attribute("style:text-underline-width", "auto")
			w.attribute("style:text-underline-color", "font-color")
			w.end()
			w.end()
			w.end()
			w.start("office:automatic-styles")
			w.start("style:page-layout")
			w.attribute("style:name", "pm1")
			w.start("style:page-layout-properties")
			w.attribute("fo:page-width", "8.5in")
			w.attribute("fo:page-height", "11in")
			for let (_, side) in string["top", "bottom", "left", "right"] {
				w.attribute("fo:margin-" + side, "1in")
			}
			w.end()
			w.end()
			w.end()
			w.start("office:master-styles")
			w.start("style:master-page")
			w.attribute("style:name", "Standard")
			w.attribute("style:page-layout-name", "pm1")
			w.end()
			w.end()
			return w.str()
		}

		// paragraph opens a named paragraph style, which the caller fills and
		// closes.
		def paragraph(w XMLWriter, name string, display string, parent string, outline string) {
			w.start("style:style")
			w.attribute("style:name", name)
			w.attribute("style:display-name", display) unless display == ""
			w.attribute("style:family", "paragraph")
			w.attribute("style:parent-style-name", parent) unless parent == ""
			w.attribute("style:default-outline-level", outline) unless outline == ""
			w.attribute("style:class", "text")
		}
	}

	// inches returns a length in inches as ODF writes it.
	def inches(value float) string {
		let hundredths = int(value * 100.0 + 0.5)
		return "{hundredths / 100}.{"{hundredths % 100}".padStart(2, "0")}in"
	}
}
