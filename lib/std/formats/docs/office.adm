internal partial module std.formats.docs.office {
	use (
		std.formats.image
		std.data.encoding::(XMLNode)
		std.gfx.color
		std.os
		std.time
		std.formats.docs::*
		std.formats.container::*
	)

	// gridWidth returns the number of grid columns a Table covers, cells
	// spanning columns and rows counted in.
	def gridWidth(table Block) int {
		let covered = int[]
		let width = 0
		for let (_, row) in table.children {
			let column = 0
			for let (_, cell) in row.children {
				for column < covered.len() && covered[column] > 0 {
					column++
				}
				let span = cell.columnSpan.clamp(1, 1000)
				for covered.len() < column + span {
					covered.push(0)
				}
				for let k = 0; k < span; k++ {
					covered[column + k] = cell.rowSpan.clamp(1, 1000)
				}
				column += span
			}
			width = covered.len() when covered.len() > width
			for let k = 0; k < covered.len(); k++ {
				covered[k]-- when covered[k] > 0
			}
		}
		return width
	}

	// pixelSize returns the width and height of an image in any format
	// `std.formats.image` reads, zeros when they cannot be read.
	def pixelSize(data byte[]) (int, int) {
		let info = image.info(data) onerror (err error) {
			return (0, 0)
		}
		return (int(info.size.width), int(info.size.height))
	}

	// mediaType returns the media type of a file name by its extension.
	def mediaType(name string) string {
		match os.extension(name).lower().trimPrefix(".") {
			case "jpg", "jpeg":
				return "image/jpeg"
			case "png":
				return "image/png"
			case "gif":
				return "image/gif"
			case "svg":
				return "image/svg+xml"
			case "webp":
				return "image/webp"
			case "bmp":
				return "image/bmp"
			case "tif", "tiff":
				return "image/tiff"
			case "emf":
				return "image/x-emf"
			case "wmf":
				return "image/x-wmf"
			default:
				return "application/octet-stream"
		}
	}

	// value returns the attribute of the element, empty when it has none. The
	// name is compared as written, prefix included.
	def value(node XMLNode, name string) string {
		let found = node.attribute(name)
		return found is none ?? ("", found)
	}

	// value returns the attribute of the element in the namespace, empty when
	// it has none.
	def value(node XMLNode, name string, namespace string) string {
		let found = node.attribute(name, namespace)
		return found is none ?? ("", found)
	}

	// Marks is the character formatting of a run of text.
	struct Marks {
		bold       bool
		italic     bool
		underline  bool
		strike     bool
		code       bool
		foreground ?color.Color
		background ?color.Color
	}

	// Spans builds the inlines of runs of formatted text. A mark the next
	// run shares with the one before stays open, so a bold word inside an
	// italic phrase nests in it, and neighbouring text of one format joins.
	type Spans {
		items Inline[]
		keys  string[]
		open  Inline[]

		def new() {
			items = Inline[]
			keys = string[]
			open = Inline[]
		}

		// top returns the inlines the next piece goes into.
		def top() Inline[] {
			return open.len() > 0 ?? (open[open.len() - 1].children, items)
		}

		// add appends text, or code when the marks say so, carrying the marks.
		def add(content string, marks Marks) {
			return when content == ""
			reopen(marks)
			let into = top()
			let kind = marks.code ?? (InlineKind.Code, InlineKind.Text)
			if into.len() > 0 && into[into.len() - 1].kind == kind {
				let joined = into[into.len() - 1].content + content
				into[into.len() - 1] = marks.code ?? (code(joined), text(joined))
				return
			}
			into.push(marks.code ?? (code(content), text(content)))
		}

		// put appends an inline inside the marks open now: a line break, a
		// picture, a note, a link.
		def put(item Inline) {
			let into = top()
			if item.kind == InlineKind.Text && into.len() > 0 && into[into.len() - 1].kind == InlineKind.Text {
				into[into.len() - 1] = text(into[into.len() - 1].content + item.content)
				return
			}
			into.push(item)
		}

		// place appends an inline carrying the marks.
		def place(item Inline, marks Marks) {
			reopen(marks)
			put(item)
		}

		// reopen closes the open marks the run does not have and opens those
		// it adds, in the order color, bold, italic, underline, strike.
		def reopen(marks Marks) {
			let wanted = markKeys(marks)
			let kept = 0
			for kept < keys.len() && wanted.includes(keys[kept]) {
				kept++
			}
			keys.len(kept)
			open.len(kept)
			for let (_, key) in wanted {
				continue when keys.includes(key)
				let span = new Inline(key == "b" ?? (InlineKind.Bold, key == "i" ?? (InlineKind.Italic, key == "u" ?? (InlineKind.Underline, key == "s" ?? (InlineKind.Strike, InlineKind.Styled)))))
				if span.kind == InlineKind.Styled {
					span.foreground = marks.foreground
					span.background = marks.background
				}
				top().push(span)
				keys.push(key)
				open.push(span)
			}
		}
	}

	// markKeys names the marks, a color by its values.
	def markKeys(marks Marks) string[] {
		let out = string[]
		let foreground = marks.foreground
		let background = marks.background
		if !(foreground is none) || !(background is none) {
			let fore = foreground is none ?? ("", rgb(foreground))
			let back = background is none ?? ("", rgb(background))
			out.push("c:" + fore + "/" + back)
		}
		out.push("b") when marks.bold
		out.push("i") when marks.italic
		out.push("u") when marks.underline
		out.push("s") when marks.strike
		return out
	}

	def sameColor(a ?color.Color, b ?color.Color) bool {
		return b is none when a is none
		return false when b is none
		return a.equals(b)
	}

	// hexColor parses a `RRGGBB` color as office formats write it, none for
	// "auto" or anything else.
	def hexColor(value string) ?color.Color {
		return none unless value.len() == 6
		for let (_, c) in value {
			return none unless (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
		}
		let failed = false
		let parsed = color.parse("#" + value) onerror (err error) {
			failed = true
			recover new color.Color("#000000")
		}
		return none when failed
		return parsed
	}

	// rgb returns the color as `RRGGBB`.
	def rgb(value color.Color) string {
		let code = value.css(color.ColorFormat.Hex).trimPrefix("#").upper()
		return "{code[0]}{code[0]}{code[1]}{code[1]}{code[2]}{code[2]}" when code.len() == 3
		return code[:6]
	}

	// textOf returns the plain text of the inlines.
	def textOf(items Inline[]) string {
		let out = ""
		for let (_, item) in items {
			out += item.plainText()
		}
		return out
	}

	// isMonospace reports whether the font is a fixed-width one by its name.
	def isMonospace(font string) bool {
		let name = font.lower()
		for let (_, known) in string["courier", "consolas", "menlo", "monaco", "mono", "lucida console", "source code", "fira code", "inconsolata", "andale", "fixedsys", "liberation mono", "dejavu sans mono"] {
			return true when name.indexOf(known) >= 0
		}
		return false
	}

	// stamp returns the time as an ISO 8601 UTC timestamp to the second.
	def stamp(value time.Time) string {
		let text = value.str()
		let dot = text.indexOf(".")
		return text[:dot] + "Z" when dot > 0 && text.endsWith("Z")
		return text
	}

	// prop returns the attribute of the local name in any namespace, empty
	// when the element has none.
	def prop(node XMLNode, localName string) string {
		for let (_, attr) in node.attributes {
			return attr.value when attr.localName == localName
		}
		return ""
	}

	// propOrEmpty is prop, with "on" for a missing attribute: a toggle
	// property written without a value is on.
	def propOrEmpty(node XMLNode, localName string) string {
		for let (_, attr) in node.attributes {
			return attr.value when attr.localName == localName
		}
		return "true"
	}

	// tidyRuns drops the empty text runs leave and the spaces the paragraph
	// starts and ends with.
	def tidyRuns(items Inline[]) Inline[] {
		let out = items
		for out.len() > 0 && out[0].kind == InlineKind.Text {
			let trimmed = out[0].content.trimStart(" ")
			if trimmed == "" {
				out = out[1:]
				continue
			}
			out[0] = text(trimmed) unless trimmed == out[0].content
			break
		}
		for out.len() > 0 && out[out.len() - 1].kind == InlineKind.Text {
			let last = out[out.len() - 1]
			let trimmed = last.content.trimEnd(" ")
			if trimmed == "" {
				out.pop()
				continue
			}
			out[out.len() - 1] = text(trimmed) unless trimmed == last.content
			break
		}
		return out
	}

	// dateOf reads an ISO 8601 timestamp, none when the value is none.
	def dateOf(value string) ?time.Time {
		let stamp = value.len() == 10 ?? (value + "T00:00:00Z", value)
		let failed = false
		let parsed = time.parse(stamp) onerror (err error) {
			failed = true
			recover time.now()
		}
		return none when failed
		return parsed
	}

	// allCode reports whether the inlines are all code or white space.
	def allCode(items Inline[]) bool {
		let found = false
		for let (_, item) in items {
			if item.kind == InlineKind.Code {
				found = true
				continue
			}
			return false unless (item.kind == InlineKind.Text && item.content.trim() == "") || item.kind == InlineKind.LineBreak
		}
		return found
	}

	// unwrap drops a mark that covers the whole of the inlines.
	def unwrap(items Inline[], kind InlineKind) Inline[] {
		return items[0].children when items.len() == 1 && items[0].kind == kind
		return items
	}

	// imageExtension returns the file extension an image's bytes call for.
	def imageExtension(data byte[]) string {
		return "png" when data.len() > 1 && int(data[0]) == 0x89 && int(data[1]) == 0x50
		return "jpeg" when data.len() > 1 && int(data[0]) == 0xFF && int(data[1]) == 0xD8
		return "gif" when data.len() > 1 && int(data[0]) == 0x47 && int(data[1]) == 0x49
		return "bmp" when data.len() > 1 && int(data[0]) == 0x42 && int(data[1]) == 0x4D
		return "bin"
	}

	// columnAlignments moves an alignment every body cell of a column
	// shares from the cells' paragraphs to the table.
	def columnAlignments(table Block) {
		let width = table.alignments.len()
		for let column = 0; column < width; column++ {
			let shared = Alignment.Default
			let consistent = true
			let seen = false
			for let (_, row) in table.children {
				continue when row.header
				let cell = cellAt(row, column)
				continue when cell is none
				for let (_, block) in cell.children {
					if !seen {
						shared = block.alignment
						seen = true
					} else if block.alignment != shared {
						consistent = false
					}
				}
			}
			continue unless seen && consistent && shared != Alignment.Default
			table.alignments[column] = shared
			for let (_, row) in table.children {
				let cell = cellAt(row, column)
				continue when cell is none
				for let (_, block) in cell.children {
					block.alignment = Alignment.Default when block.alignment == shared
				}
			}
		}
	}

	def cellAt(row Block, column int) ?Block {
		let at = 0
		for let (_, cell) in row.children {
			return cell when at == column
			at += cell.columnSpan
			return none when at > column
		}
		return none
	}
}
