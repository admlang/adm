partial module std.formats.docs {
	use (
		std.bytes
		std.formats.docs.pdf::*
		std.io
	)

	// PdfFont is the family of the standard fonts the encoder writes with.
	// Code is always set in Courier.
	enum PdfFont {
		Helvetica,
		Times,
		Courier,
	}

	// Pdf is the Portable Document Format codec.
	//
	// Decoding reads the file's objects (cross-reference tables and streams,
	// object streams, incremental updates, and files whose cross-reference
	// data is damaged), decrypts files protected by the standard security
	// handler (RC4, AES-128, AES-256) and recovers the document from where
	// its text is drawn: glyph runs become lines by their baseline, lines
	// become paragraphs by spacing and indent, lines set larger than the body
	// text or named by the outline (bookmarks) become headings, bullets and
	// numbers start list items, hyphenated line ends are joined, text in bold,
	// italic and monospace fonts keeps that style (whole lines of monospace
	// become Code blocks), link annotations become links, and page numbers
	// and running heads and feet are dropped. Images drawn on the pages are
	// stored in `Document.resources` as `image1.jpg`, `image2.png` and so on,
	// JPEG and JPEG 2000 as they are, other images as PNG; inline images,
	// stencil masks and JBIG2 and fax images are left out. Title, authors,
	// subject, keywords, dates and language come from the document
	// information, the catalog and the XMP metadata. Text drawn as paths,
	// tables, and the reading order of complex layouts are not recovered.
	// The lower layers are public: `open` returns the file's objects.
	//
	// Encoding lays the document out on pages set up by the fields below, in
	// the standard fonts, which every reader has, so no font is embedded and
	// only the characters of Windows-1252 print (others become `?`).
	// Headings are set bold and larger, and listed in the outline; lists
	// get bullets or numbers; code is set in Courier; links become link
	// annotations; tables become ruled grids; images are embedded, JPEG as
	// is and other formats the image codecs read as compressed RGB. Line
	// breaking is greedy and text is ranged left. Footnotes, colors, theme
	// roles and Raw content are left out.
	//
	// Example: Extract the text
	// ```example
	// use std.formats.docs
	//
	// let doc = try docs.load("report.pdf")
	// println(doc.plainText())
	// ```
	@codec("Portable Document Format")
	type Pdf {
		// Password of an encrypted file, as user or owner password. Empty opens
		// the files that need no password to be read.
		password   string
		// Page width, in points (a 72nd of an inch). US Letter by default.
		pageWidth  float   = 612.0
		// Page height, in points.
		pageHeight float   = 792.0
		// Margin on each side of the page, in points.
		margin     float   = 72.0
		// Font family of the text.
		font       PdfFont = PdfFont.Helvetica
		// Size of the text, in points. Headings and code are sized from it.
		fontSize   float   = 11.0

		mimeType string[] {
			def get() string[] {
				return string["application/pdf"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".pdf"]
			}
		}

		// matchSignature reports whether `%PDF-` appears in the first 1024
		// bytes of the reader, where readers accept the header.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(1024)
			let n = 0
			for n < b.len() {
				let got = r.read(b[n:]) onerror recover 0
				break when got <= 0
				n += got
			}
			return n >= 5 && indexOf(b[:n], "%PDF-", 0) >= 0
		}

		// open reads the objects of the PDF file held in the bytes. Fails when
		// no document catalog can be found, even by scanning the file, or when
		// the file is encrypted and `password` does not open it.
		def open(data byte[]) !PdfFile {
			let store = new Store(data)
			try store.load(password)
			return new PdfFile(store)
		}

		// decode reads the whole reader as PDF. Fails when the reader does, or
		// as `open` does.
		def decode(reader io.Reader) !Document {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes())
		}

		// decode reads the bytes as PDF. Fails as `open` does.
		def decode(data byte[]) !Document {
			let store = new Store(data)
			try store.load(password)
			return extractDocument(store)
		}

		// encode writes the document as PDF. Fails when the writer does.
		def encode(doc Document, writer io.Writer) !none {
			try writer.write(encode(doc))
		}

		// encode returns the document as PDF bytes.
		def encode(doc Document) byte[] {
			let writer = new DocumentWriter(self, doc)
			return writer.encode()
		}
	}
}
