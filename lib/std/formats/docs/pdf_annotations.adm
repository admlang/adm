internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::(PdfObject, PdfKind)
		std.gfx.color::Color
		std.math.geom::(Path, Rect, Transform2D, StrokeStyle)
		std.units::Pixels
	)

	// A field's value/type may be on a parent rather than its Widget.
	def fieldEntry(store Store, widget PdfObject, key string) PdfObject {
		let node = widget
		for let depth = 0; depth < 32 && !node.isNull(); depth++ {
			let value = store.resolve(node.get(key))
			return value unless value.isNull()
			node = store.resolve(node.get("Parent"))
		}
		return new PdfObject()
	}

	// AP/N is either a single Form stream or a dictionary of states. AS is
	// authoritative; inherited V is a fallback only when AS was not supplied.
	def normalAppearance(store Store, annotation PdfObject) PdfObject {
		let normal = store.resolve(store.resolve(annotation.get("AP")).get("N"))
		return normal when normal.kind == PdfKind.Stream
		return new PdfObject() unless normal.kind == PdfKind.Dictionary
		let state = store.resolve(annotation.get("AS"))
		state = fieldEntry(store, annotation, "V") when state.isNull()
		if state.kind == PdfKind.Name {
			let selected = store.resolve(normal.get(state.name))
			return selected when selected.kind == PdfKind.Stream
		}
		return store.resolve(normal.get("Off"))
	}

	def annotationRect(store Store, value PdfObject) !Rect {
		fail "annotation has no valid rectangle" unless value.items.len() == 4
		let x0 = store.resolve(value.items[0]).number
		let y0 = store.resolve(value.items[1]).number
		let x1 = store.resolve(value.items[2]).number
		let y1 = store.resolve(value.items[3]).number
		return Rect{left: x0.min(x1), top: y0.min(y1), right: x0.max(x1), bottom: y0.max(y1)}
	}

	// PDF 32000-1, 12.5.5: fit the axis-aligned bounds of Matrix(BBox) to
	// Rect; xobject then applies the appearance Matrix exactly once.
	def appearancePlacement(store Store, appearance PdfObject, target Rect) !Transform2D {
		let box = try annotationRect(store, store.resolve(appearance.get("BBox")))
		let transform = new Transform2D()
		let values = store.resolve(appearance.get("Matrix"))
		if !values.isNull() {
			fail "invalid annotation appearance Matrix" unless values.items.len() == 6
			let entries PdfObject[]
			for let value in values.items {
				entries.push(store.resolve(value))
			}
			transform = matrix(entries)
		}
		let bounds = new Path().rect(box).transformed(transform).bounds()
		let width = bounds.right - bounds.left
		let height = bounds.bottom - bounds.top
		fail "empty annotation appearance bounds" unless width > 0.0 && height > 0.0
		let sx = (target.right - target.left) / width
		let sy = (target.bottom - target.top) / height
		return new Transform2D(a = sx, d = sy, tx = target.left - bounds.left * sx, ty = target.top - bounds.top * sy)
	}

	def annotationColor(store Store, value PdfObject, fallback Color) Color {
		return fallback unless value.items.len() := 1 || 3 || 4
		let channels float[]
		for let item in value.items {
			channels.push(store.resolve(item).number)
		}
		return sampleColor(channels)
	}

	// For widgets without AP, preserve their declared background and border.
	// Generating text/checkmark appearances from field values is separate work.
	def widgetBorder(renderer Renderer, annotation PdfObject, bounds Rect, base Transform2D) {
		let store = renderer.store
		let mk = store.resolve(annotation.get("MK"))
		let bg = store.resolve(mk.get("BG"))
		let bc = store.resolve(mk.get("BC"))
		let bs = store.resolve(annotation.get("BS"))
		let border = store.resolve(annotation.get("Border"))
		let canvas = renderer.canvas
		canvas.setTransform(base)
		if bg.items.len() > 0 {
			canvas.fill(bounds, annotationColor(store, bg, rgb(1.0, 1.0, 1.0)))
		}
		return when bc.items.len() == 0 && bs.isNull() && border.isNull()
		let w = store.resolve(bs.get("W"))
		let width = w.isNull() ?? (1.0, w.number)
		width = store.resolve(border.items[2]).number when bs.isNull() && border.items.len() >= 3
		return unless width > 0.0
		width = width.min((bounds.right - bounds.left) / 2.0).min((bounds.bottom - bounds.top) / 2.0)
		let inset = width / 2.0
		let path = new Path()
		let borderStyle = store.resolve(bs.get("S")).name
		if borderStyle == "U" {
			path.moveTo(bounds.left, bounds.top + inset)
			path.lineTo(bounds.right, bounds.top + inset)
		} else {
			path.rect(Rect{left: bounds.left + inset, top: bounds.top + inset, right: bounds.right - inset, bottom: bounds.bottom - inset})
		}
		let dash Pixels[]
		let pattern = store.resolve(bs.get("D"))
		pattern = store.resolve(border.items[3]) when bs.isNull() && border.items.len() >= 4
		if borderStyle == "D" || bs.isNull() {
			for let entry in pattern.items {
				dash.push(store.resolve(entry).number.max(0.0) * 1(px))
			}
			dash = [3(px)] when borderStyle == "D" && dash.len() == 0
		}
		canvas.stroke(path, annotationColor(store, bc, rgb(0.0, 0.0, 0.0)), StrokeStyle{width: width * 1(px), dash: dash})
	}

	def renderAnnotations(renderer Renderer, page PdfObject, base Transform2D) !none {
		let store = renderer.store
		let annotations = store.resolve(page.get("Annots"))
		let root = store.resolve(store.trailer.get("Root"))
		let acroform = store.resolve(root.get("AcroForm"))
		let resources = store.resolve(acroform.get("DR"))
		resources = store.resolve(page.get("Resources")) when resources.isNull()
		for let item in annotations.items {
			let annotation = store.resolve(item)
			continue unless annotation.kind == PdfKind.Dictionary
			let flags = store.integer(annotation, "F")
			// Screen rendering: Invisible, Hidden and NoView suppress display.
			continue when (flags & 35) != 0
			let rect = try annotationRect(store, store.resolve(annotation.get("Rect")))
			continue unless rect.right > rect.left && rect.bottom > rect.top
			let appearance = normalAppearance(store, annotation)
			let subtype = store.resolve(annotation.get("Subtype")).name
			renderer.canvas.save()
			renderer.canvas.setTransform(base)
			renderer.canvas.clip(rect)
			if appearance.kind == PdfKind.Stream {
				let placement = try appearancePlacement(store, appearance, rect)
				renderer.gs = new Graphics()
				renderer.gs.ctm = base.then(placement)
				try renderer.xobject(appearance, resources, 0)
				renderer.warnings.set("annotation NoZoom/NoRotate flags are not implemented", true) when (flags & 24) != 0
			} else if subtype == "Widget" {
				widgetBorder(renderer, annotation, rect, base)
				renderer.warnings.set("widget has no usable normal appearance; only its declared border/background is rendered", true)
			} else {
				renderer.warnings.set("annotation {subtype} has no rendered appearance", true)
			}
			renderer.canvas.restore()
		}
		return none
	}
}
