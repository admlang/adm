internal partial module std.formats.docs.pdf {
	use std.formats.docs::*

	// Segment is a stretch of paragraph text in one style.
	type Segment {
		text   byte[]
		bold   bool
		italic bool
		mono   bool
		url    string

		def new(run Run) {
			text = byte[]
			bold = run.bold
			italic = run.italic
			mono = run.mono
			url = run.url
		}

		def sameStyle(run Run) bool {
			return bold == run.bold && italic == run.italic && mono == run.mono && url == run.url
		}
	}

	// Layout turns lines into blocks: headings, paragraphs, lists, code and
	// images.
	type Layout {
		doc       Document
		lines     Line[]
		outline   map<string, int>
		body      float
		leadings  map<int, float>
		lefts     float[]
		rights    float[]
		boldLevel int
		para      Line[]
		list      ?Block
		listX     float
		items     Line[]
		// Bytes of the list marker at the start of `items[0]`.
		skip      int
		code      Line[]
		heading   ?Block
		prev      ?Line

		def new(doc Document, lines Line[], outline map<string, int>) {
			self.doc = doc
			self.lines = lines
			self.outline = outline
			leadings = new map<int, float>()
			lefts = float[]
			rights = float[]
			para = Line[]
			items = Line[]
			code = Line[]
		}

		def build() {
			measure()
			for let (_, line) in lines {
				continue when line.dropped
				place(line)
			}
			flushAll()
		}

		// measure finds the body size, the usual leading per size, the text
		// margins per page and the heading level of each line.
		def measure() {
			let weights = new map<int, int>()
			let boldWeight = 0
			let total = 0
			let pages = 0
			for let (_, line) in lines {
				pages = pages.max(line.page + 1)
				continue when line.dropped || line.image != ""
				let length = line.text().len()
				let key = sizeKey(line.size)
				let seen = weights.get(key)
				weights.set(key, (seen is none) ?? (length, seen + length))
				total += length
				boldWeight += length when line.allBold()
			}
			let bestKey = 0
			let best = -1
			for let (key, weight) in weights {
				if weight > best {
					best = weight
					bestKey = key
				}
			}
			body = float(bestKey) / 2.0

			let gaps = new map<int, map<int, int>>()
			let before = new Line(new Run())
			let has = false
			for let (_, line) in lines {
				continue when line.dropped || line.image != ""
				if has && before.page == line.page && sizeKey(before.size) == sizeKey(line.size) {
					let gap = before.y - line.y
					if gap > 0.0 && gap < 3.0 * line.size {
						let key = sizeKey(line.size)
						gaps.set(key, new map<int, int>()) unless gaps.hasKey(key)
						let counts = gaps[key]
						let g = sizeKey(gap)
						let seen = counts.get(g)
						counts.set(g, (seen is none) ?? (1, seen + 1))
					}
				}
				before = line
				has = true
			}
			for let (key, counts) in gaps {
				let top = 0
				let topCount = 0
				for let (g, count) in counts {
					if count > topCount {
						topCount = count
						top = g
					}
				}
				leadings.set(key, float(top) / 2.0)
			}

			for let p = 0; p < pages; p++ {
				lefts.push(100000.0)
				rights.push(-100000.0)
			}
			for let pass = 0; pass < 2; pass++ {
				for let (_, line) in lines {
					continue when line.dropped || line.image != ""
					continue when pass == 0 && (line.size - body).abs() > 0.1 * body
					continue when pass == 1 && lefts[line.page] < 100000.0
					lefts[line.page] = lefts[line.page].min(line.x)
					rights[line.page] = rights[line.page].max(line.x1)
				}
			}

			let headingKeys = int[]
			for let (_, line) in lines {
				continue when line.dropped || line.image != ""
				let text = string(line.text())
				let known = outline.get(normalizeTitle(text))
				if !(known is none) {
					line.level = known
					continue
				}
				if line.size > body * 1.15 && text.len() <= 150 {
					let key = sizeKey(line.size)
					headingKeys.push(key) unless headingKeys.includes(key)
				}
			}
			headingKeys = headingKeys.sort((a, b int) => a > b)
			for let (_, line) in lines {
				continue when line.dropped || line.image != "" || line.level > 0
				let rank = headingKeys.indexOf(sizeKey(line.size))
				line.level = (rank + 1).min(6) when rank >= 0 && line.size > body * 1.15
			}
			boldLevel = (headingKeys.len() + 1).min(6)
			// Bold one-line paragraphs are headings only when bold is rare.
			boldLevel = 0 when total > 0 && boldWeight * 3 > total
		}

		// place adds a line to the block being built, or starts a new one.
		def place(line Line) {
			if line.image != "" {
				flushAll()
				doc.body.image(line.image)
				prev = none
				return
			}
			let text = line.text()
			return when isBlank(text)
			let before = prev
			prev = line

			if line.level > 0 {
				flushParagraphs()
				flushCode()
				let h = heading
				if !(h is none) && continuesHeading(before, line) {
					h.inlines.push(text(" " + string(text).trim()))
					return
				}
				heading = doc.body.heading(line.level, string(text).trim())
				return
			}
			heading = none

			if line.allMono() {
				flushParagraphs()
				flushCode() when code.len() > 0 && !(before is none) && (before.page != line.page || before.y - line.y > 3.0 * line.size)
				code.push(line)
				return
			}
			flushCode()

			let marker = listMarker(text)
			if marker.len() > 0 {
				flushParagraph()
				let ordered = marker[0] == 1
				let open = list
				flushList() when !(open is none) && (open.ordered != ordered || (line.x - listX).abs() > line.size)
				flushItem()
				if list is none {
					let block = new Block(BlockKind.List)
					block.ordered = ordered
					block.start = marker[1]
					doc.body.add(block)
					list = block
					listX = line.x
				}
				items = Line[line]
				skip = marker[2]
				return
			}
			if items.len() > 0 {
				if !(before is none) && line.x > listX + 0.3 * line.size && !breakBetween(before, line, true) {
					items.push(line)
					return
				}
				flushList()
			}
			if para.len() > 0 && !(before is none) && !breakBetween(before, line, false) {
				para.push(line)
				return
			}
			flushParagraph()
			para.push(line)
		}

		// continuesHeading reports whether the line carries on the heading of
		// the line before it.
		def continuesHeading(before ?Line, line Line) bool {
			return false when before is none
			return before.level == line.level && before.page == line.page && before.y - line.y < 2.0 * line.size
		}

		// breakBetween reports whether a paragraph ends between the two lines:
		// a page or column change after a sentence end, a size change, a gap
		// larger than the leading, a first-line indent or a short line.
		def breakBetween(a Line, b Line, inList bool) bool {
			let text = a.text()
			let sizeChange = (a.size - b.size).abs() > 0.12 * b.size
			return endsSentence(text) || sizeChange when a.page != b.page
			return true when sizeChange
			let gap = a.y - b.y
			return endsSentence(text) when gap < -0.5 * b.size
			let lead = leadings.get(sizeKey(b.size))
			let limit = (lead is none) ?? (b.size * 1.7, lead * 1.3 + 0.5)
			return true when gap > limit
			return false when inList
			let left = lefts[b.page]
			let right = rights[b.page]
			return true when b.x > a.x + 0.8 * b.size && b.x > left + 0.8 * b.size
			let slack = (6.0 * b.size).max(0.12 * (right - left))
			return a.x1 < right - slack
		}

		def flushAll() {
			flushParagraphs()
			flushCode()
		}

		def flushParagraphs() {
			flushParagraph()
			flushList()
		}

		// flushParagraph ends the open paragraph. A lone bold line becomes a
		// heading when bold text is rare in the document.
		def flushParagraph() {
			return when para.len() == 0
			let group = para
			para = Line[]
			let first = group[0]
			let text = string(first.text()).trim()
			if group.len() == 1 && boldLevel > 0 && first.allBold() && text.len() < 80 && !text.endsWith(".") && !text.endsWith(",") && !text.endsWith(":") && !text.endsWith(";") {
				doc.body.heading(boldLevel, text)
				return
			}
			let block = new Block(BlockKind.Paragraph)
			block.inlines = inlinesOf(group, 0)
			doc.body.add(block) when block.inlines.len() > 0
		}

		def flushItem() {
			return when items.len() == 0
			let open = list
			if !(open is none) {
				let item = new Block(BlockKind.Item)
				let paragraph = new Block(BlockKind.Paragraph)
				paragraph.inlines = inlinesOf(items, skip)
				item.add(paragraph)
				open.add(item)
			}
			items = Line[]
		}

		def flushList() {
			flushItem()
			list = none
		}

		// flushCode ends the open code block, indentation kept from the
		// horizontal positions.
		def flushCode() {
			return when code.len() == 0
			let left = code[0].x
			for let (_, line) in code {
				left = left.min(line.x)
			}
			let out = string[]
			for let (i, line) in code {
				out.push("") when i > 0 && code[i - 1].y - line.y > 1.8 * line.size
				let indent = int(((line.x - left) / (0.6 * line.size)).round())
				out.push(" ".repeat(indent.max(0)) + string(line.text()).trimEnd())
			}
			doc.body.code("", out.join("\n"))
			code = Line[]
		}

		// inlinesOf joins lines into styled inlines: runs of a style become
		// Bold, Italic, Code and Link inlines; a hyphen ending a line before a
		// lowercase letter is dropped with the break.
		def inlinesOf(group Line[], markerBytes int) Inline[] {
			let segments = Segment[]
			for let (n, line) in group {
				let toSkip = (n == 0) ?? (markerBytes, 0)
				for let (i, run) in line.runs {
					let piece = run.text
					if i > 0 && needsSpace(line.runs[i - 1], run) {
						if toSkip > 0 {
							toSkip--
						} else if segments.len() > 0 {
							segments[segments.len() - 1].text.push(32)
						}
					}
					if toSkip > 0 {
						let cut = toSkip.min(piece.len())
						piece = piece[cut:]
						toSkip -= cut
					}
					continue when piece.len() == 0
					segments.push(new Segment(run)) when segments.len() == 0 || !segments[segments.len() - 1].sameStyle(run)
					segments[segments.len() - 1].text.push(...piece)
				}
				if n + 1 < group.len() && segments.len() > 0 {
					let last = segments[segments.len() - 1]
					let t = last.text
					let next = group[n + 1].text()
					let hyphen = t.len() >= 2 && t[t.len() - 1] == 45 && isLetter(t[t.len() - 2]) && next.len() > 0 && next[0] >= 97 && next[0] <= 122
					if hyphen {
						last.text = t[:t.len() - 1]
					} else if t.len() > 0 && t[t.len() - 1] != 32 {
						last.text.push(32)
					}
				}
			}
			let out = Inline[]
			for let (i, segment) in segments {
				let content = string(segment.text)
				content = content.trimStart() when i == 0
				content = content.trimEnd() when i == segments.len() - 1
				continue when content == ""
				let plain = !segment.mono && !segment.bold && !segment.italic && segment.url == ""
				if plain {
					appendText(out, content)
					continue
				}
				let core = content.trim()
				appendText(out, " ") when content.startsWith(" ")
				if core != "" {
					let inline = text(core)
					if segment.mono {
						inline = code(core)
					} else if segment.bold && segment.italic {
						inline = bold(italic(core))
					} else if segment.bold {
						inline = bold(core)
					} else if segment.italic {
						inline = italic(core)
					}
					if segment.url != "" {
						let wrapped = new Inline(InlineKind.Link)
						wrapped.url = segment.url
						wrapped.children.push(inline)
						inline = wrapped
					}
					out.push(inline)
				}
				appendText(out, " ") when content.endsWith(" ") && core != ""
			}
			return out
		}
	}

	// appendText adds plain text to the inlines, merged into a Text inline
	// that ends them.
	def appendText(out Inline[], content string) {
		if out.len() > 0 && out[out.len() - 1].kind == InlineKind.Text {
			out[out.len() - 1].content += content
			return
		}
		out.push(text(content))
	}

	// sizeKey rounds a size to the half point, as an integer key.
	def sizeKey(size float) int {
		return int((size * 2.0).round())
	}

	// isLetter reports whether the byte is an ASCII letter or part of a
	// multi-byte character.
	def isLetter(b byte) bool {
		return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b >= 0x80
	}

	// listMarker recognizes a bullet (`•`, `-`, `*` and other bullet
	// characters) or a number (`1.`, `2)`, `a.`, `(3)`) that starts a list
	// item. It returns whether the list is ordered (1 or 0), the item number
	// and how many bytes the marker and its spaces take; empty when the text
	// does not start with a marker.
	def listMarker(text byte[]) int[] {
		let i = 0
		for i < text.len() && text[i] == 32 {
			i++
		}
		let start = i
		return int[] when i >= text.len()
		let c = text[i]
		let ordered = 0
		let number = 1
		if c := 45 || 42 || 43 {
			i++
		} else if c >= 0x80 {
			let length = (c >= 0xf0) ?? (4, (c >= 0xe0) ?? (3, 2))
			return int[] when i + length > text.len()
			let code = string(text[i:i + length])
			return int[] unless "•·◦▪■●○–➢❖✓►▸‣⁃".contains(code) || (length == 3 && text[i] == 0xef)
			i += length
		} else if c >= 48 && c <= 57 {
			let value = 0
			for i < text.len() && text[i] >= 48 && text[i] <= 57 && i - start < 3 {
				value = value * 10 + int(text[i]) - 48
				i++
			}
			return int[] unless i < text.len() && (text[i] == 46 || text[i] == 41)
			i++
			ordered = 1
			number = value
		} else if c >= 97 && c <= 122 && i + 1 < text.len() && (text[i + 1] == 46 || text[i + 1] == 41) {
			ordered = 1
			number = int(c) - 96
			i += 2
		} else if c == 40 {
			let close = i + 1
			for close < text.len() && close - i < 4 && text[close] != 41 {
				close++
			}
			return int[] unless close < text.len() && text[close] == 41 && close > i + 1
			let inner = string(text[i + 1:close])
			return int[] unless /^([0-9]{1,2}|[a-z])$/.test(inner)
			ordered = 1
			number = /^[0-9]+$/.test(inner) ?? (parseInt<int>(inner), int(text[i + 1]) - 96)
			i = close + 1
		} else {
			return int[]
		}
		return int[] unless i < text.len() && text[i] == 32
		for i < text.len() && text[i] == 32 {
			i++
		}
		return int[] when i >= text.len()
		return int[ordered, number, i]
	}
}
