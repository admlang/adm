internal partial module std.formats.docs.pdf {
	use (
		std.crypto.cipher
		std.crypto.hash
		std.formats.docs::*
	)

	// The 32 bytes a password is padded with.
	let passwordPadding = byte[
		0x28, 0xbf, 0x4e, 0x5e, 0x4e, 0x75, 0x8a, 0x41, 0x64, 0x00, 0x4e, 0x56, 0xff, 0xfa, 0x01, 0x08,
		0x2e, 0x2e, 0x00, 0xb6, 0xd0, 0x68, 0x3e, 0x80, 0x2f, 0x0c, 0xa9, 0xfe, 0x64, 0x53, 0x69, 0x7a
	]

	// CryptMethod is how strings or streams are encrypted.
	enum CryptMethod {
		None,
		RC4,
		AES128,
		AES256,
	}

	// Security is the standard security handler of an encrypted file: the file
	// key and the methods for strings and streams.
	type Security {
		key             byte[]
		strings         CryptMethod
		streams         CryptMethod
		encryptMetadata bool        = true

		def new() {
			key = byte[]
		}

		// decryptStrings decrypts every string inside the object, in place.
		def decryptStrings(obj PdfObject, number int, generation int) {
			return when strings == CryptMethod.None
			walkStrings(obj, number, generation, 0)
		}

		def walkStrings(obj PdfObject, number int, generation int, depth int) {
			return when depth > maxDepth
			match obj.kind {
				case PdfKind.String:
					obj.data = decrypt(obj.data, number, generation, strings)
				case PdfKind.Array:
					for let (_, item) in obj.items {
						walkStrings(item, number, generation, depth + 1)
					}
				case PdfKind.Dictionary, PdfKind.Stream:
					for let (_, item) in obj.entries {
						walkStrings(item, number, generation, depth + 1)
					}
				default:
			}
		}

		// decryptStream decrypts stream data.
		def decryptStream(data byte[], number int, generation int) byte[] {
			return decrypt(data, number, generation, streams)
		}

		def decrypt(data byte[], number int, generation int, method CryptMethod) byte[] {
			match method {
				case CryptMethod.None:
					return data
				case CryptMethod.AES256:
					return aesCbcDecrypt(key, data)
				default:
			}
			let material = key.clone()
			material.push(byte(number & 0xff), byte((number >> 8) & 0xff), byte((number >> 16) & 0xff), byte(generation & 0xff), byte((generation >> 8) & 0xff))
			material.push(0x73, 0x41, 0x6c, 0x54) when method == CryptMethod.AES128
			let digest = new hash.MD5().hash(material)
			let objectKey = digest[:(key.len() + 5).min(16)]
			return aesCbcDecrypt(objectKey, data) when method == CryptMethod.AES128
			return cipher.rc4(objectKey, data) onerror recover data
		}
	}

	// newSecurity sets up the standard security handler from the encryption
	// dictionary. Fails when the handler is not the standard one, its revision
	// is unknown, or the password opens the file neither as user nor as
	// owner.
	def newSecurity(objects Store, dict PdfObject, id byte[], password string) !Security {
		let filter = objects.resolve(dict.get("Filter")).name
		fail "pdf: unsupported security handler {filter}" unless filter == "Standard"
		let v = objects.integer(dict, "V")
		let r = objects.integer(dict, "R")
		let out = new Security()
		let metadata = objects.resolve(dict.get("EncryptMetadata"))
		out.encryptMetadata = !(metadata.kind == PdfKind.Boolean && !metadata.boolean)
		let owner = objects.resolve(dict.get("O")).data
		let user = objects.resolve(dict.get("U")).data
		let pw = password.bytes()

		if v == 5 || r == 5 || r == 6 {
			out.strings = cryptMethod(objects, dict, "StrF")
			out.streams = cryptMethod(objects, dict, "StmF")
			let ownerKey = objects.resolve(dict.get("OE")).data
			let userKey = objects.resolve(dict.get("UE")).data
			pw = pw[:127] when pw.len() > 127
			fail "pdf: damaged encryption dictionary" when owner.len() < 48 || user.len() < 48
			let key = unlockV5(pw, user, userKey, owner, ownerKey, r)
			fail "pdf: the password does not open the file" when key is none
			out.key = key
			return out
		}

		fail "pdf: unsupported encryption revision {r}" unless r >= 2 && r <= 4
		let length = (v == 1) ?? (5, objects.integer(dict, "Length", 40) / 8)
		length = length.clamp(5, 16)
		if v == 4 {
			out.strings = cryptMethod(objects, dict, "StrF")
			out.streams = cryptMethod(objects, dict, "StmF")
			length = 16
		} else {
			out.strings = CryptMethod.RC4
			out.streams = CryptMethod.RC4
		}
		let p = objects.integer(dict, "P")
		let key = fileKey(pw, owner, p, id, r, length, out.encryptMetadata)
		if !userMatches(key, user, id, r) {
			// Try the password as the owner password: it unlocks the user one.
			let ownerPassword = ownerDecrypt(pw, owner, r, length)
			key = fileKey(ownerPassword, owner, p, id, r, length, out.encryptMetadata)
			fail "pdf: the password does not open the file" unless userMatches(key, user, id, r)
		}
		out.key = key
		return out
	}

	// cryptMethod returns the method of the crypt filter the entry names.
	def cryptMethod(objects Store, dict PdfObject, entry string) CryptMethod {
		let name = objects.resolve(dict.get(entry)).name
		return CryptMethod.None when name == "Identity"
		let filters = objects.resolve(dict.get("CF"))
		let filter = objects.resolve(filters.get((name == "") ?? ("StdCF", name)))
		match objects.resolve(filter.get("CFM")).name {
			case "AESV2":
				return CryptMethod.AES128
			case "AESV3":
				return CryptMethod.AES256
			case "None":
				return CryptMethod.None
			default:
				return CryptMethod.RC4
		}
	}

	// padded returns the password truncated or padded to 32 bytes.
	def padded(password byte[]) byte[] {
		let out = password[:password.len().min(32)].clone()
		for let i = 0; out.len() < 32; i++ {
			out.push(passwordPadding[i])
		}
		return out
	}

	// fileKey computes the file key of revisions 2 to 4 from a user password.
	def fileKey(password byte[], owner byte[], p int, id byte[], r int, length int, encryptMetadata bool) byte[] {
		let material = padded(password)
		material.push(...owner[:owner.len().min(32)])
		material.push(byte(p & 0xff), byte((p >> 8) & 0xff), byte((p >> 16) & 0xff), byte((p >> 24) & 0xff))
		material.push(...id)
		material.push(0xff, 0xff, 0xff, 0xff) when r >= 4 && !encryptMetadata
		let digest = new hash.MD5().hash(material)
		if r >= 3 {
			for let i = 0; i < 50; i++ {
				digest = new hash.MD5().hash(digest[:length])
			}
		}
		return digest[:length]
	}

	// userMatches reports whether the key reproduces the `U` entry.
	def userMatches(key byte[], user byte[], id byte[], r int) bool {
		if r == 2 {
			let probe = cipher.rc4(key, passwordPadding) onerror recover byte[]
			return probe.len() == 32 && user.len() >= 32 && probe.equals(user[:32])
		}
		let material = passwordPadding.clone()
		material.push(...id)
		let probe = new hash.MD5().hash(material)
		for let i = 0; i < 20; i++ {
			probe = cipher.rc4(xorKey(key, i), probe) onerror recover byte[]
		}
		return probe.len() == 16 && user.len() >= 16 && probe.equals(user[:16])
	}

	// ownerDecrypt recovers the user password from the `O` entry with the
	// owner password.
	def ownerDecrypt(password byte[], owner byte[], r int, length int) byte[] {
		let digest = new hash.MD5().hash(padded(password))
		if r >= 3 {
			for let i = 0; i < 50; i++ {
				digest = new hash.MD5().hash(digest)
			}
		}
		let key = digest[:length]
		let out = owner[:owner.len().min(32)].clone()
		if r == 2 {
			return cipher.rc4(key, out) onerror recover out
		}
		for let i = 19; i >= 0; i-- {
			out = cipher.rc4(xorKey(key, i), out) onerror recover out
		}
		return out
	}

	// xorKey returns the key with every byte XORed with the value.
	def xorKey(key byte[], value int) byte[] {
		let out = key.clone()
		for let i = 0; i < out.len(); i++ {
			out[i] = out[i] ^ byte(value)
		}
		return out
	}

	// unlockV5 returns the file key of revisions 5 and 6, trying the password
	// as the user password, then as the owner password; none when it is
	// neither.
	def unlockV5(password byte[], user byte[], userKey byte[], owner byte[], ownerKey byte[], r int) ?byte[] {
		let noExtra = byte[]
		if hashV5(password, user[32:40], noExtra, r).equals(user[:32]) {
			let intermediate = hashV5(password, user[40:48], noExtra, r)
			return aesCbcDecrypt(intermediate, userKey, false)
		}
		let u = user[:48]
		if hashV5(password, owner[32:40], u, r).equals(owner[:32]) {
			let intermediate = hashV5(password, owner[40:48], u, r)
			return aesCbcDecrypt(intermediate, ownerKey, false)
		}
		return none
	}

	// hashV5 is the password hash of revision 5 (SHA-256) or 6 (the iterated
	// algorithm 2.B).
	def hashV5(password byte[], salt byte[], extra byte[], r int) byte[] {
		let material = password.clone()
		material.push(...salt)
		material.push(...extra)
		let k = new hash.SHA256().hash(material)
		return k when r < 6
		let round = 0
		for {
			let block = password.clone()
			block.push(...k)
			block.push(...extra)
			let repeated byte[]
			for let i = 0; i < 64; i++ {
				repeated.push(...block)
			}
			let e = aesCbcEncrypt(k[:16], k[16:32], repeated)
			let sum = 0
			for let i = 0; i < 16; i++ {
				sum += int(e[i])
			}
			match sum % 3 {
				case 0:
					k = new hash.SHA256().hash(e)
				case 1:
					k = new hash.SHA384().hash(e)
				default:
					k = new hash.SHA512().hash(e)
			}
			round++
			break when round >= 64 && int(e[e.len() - 1]) <= round - 32
		}
		return k[:32]
	}

	// aesCbcDecrypt decrypts AES-CBC data. With `withIv` the first 16 bytes
	// are the initialisation vector and PKCS#5 padding is removed; without,
	// the vector is zero and nothing is removed. Damaged data comes back noExtra.
	def aesCbcDecrypt(key byte[], data byte[], withIv bool = true) byte[] {
		let start = withIv ?? (16, 0)
		return byte[] when data.len() < start
		let iv byte[]
		if withIv {
			iv = data[:16]
		} else {
			iv.len(16)
		}
		let count = (data.len() - start) / 16
		let block = cipher.newAES(key) onerror (e error) {
			return byte[]
		}
		let cbc = cipher.newCBC(block, iv) onerror (e error) {
			return byte[]
		}
		let out = cbc.decrypt(data[start:start + count * 16]) onerror (e error) {
			return byte[]
		}
		return out unless withIv && out.len() > 0
		return cipher.unpadPKCS7(out, 16) onerror recover out
	}

	// aesCbcEncrypt encrypts whole blocks with AES-CBC and no padding.
	def aesCbcEncrypt(key byte[], iv byte[], data byte[]) byte[] {
		let block = cipher.newAES(key) onerror (e error) {
			return byte[]
		}
		let cbc = cipher.newCBC(block, iv) onerror (e error) {
			return byte[]
		}
		return cbc.encrypt(data[:data.len() / 16 * 16]) onerror recover byte[]
	}
}
