internal partial module std.formats.docs.pdf {
	// PDF CIDFontType2 programs need glyph outlines, not a Unicode cmap. Supply
	// an empty, valid cmap to the general font loader when the PDF omits it.
	// The original PDF bytes stay untouched and CIDToGIDMap still picks glyphs.
	def cidFontProgram(data byte[]) !byte[] {
		fail "truncated TrueType header" when data.len()<12
		let count = field(data, 4, 2)
		fail "invalid TrueType table directory" when count>4096 || 12 + count * 16>data.len()
		let tables = new map<string, byte[]>()
		for let i = 0; i<count; i++ {
			let entry = 12 + i * 16
			let tag = string(data[entry:entry + 4])
			return data when tag == "cmap"
			let at = field(data, entry + 8, 4)
			let size = field(data, entry + 12, 4)
			fail "truncated TrueType table {tag}" when at<0 || size<0 || at + size>data.len()
			tables.set(tag, data[at:at + size].clone())
		}
		// Format 4, one sentinel segment mapping U+FFFF to glyph zero.
		tables.set("cmap", byte[0, 0, 0, 1, 0, 3, 0, 1, 0, 0, 0, 12, 0, 4, 0, 24, 0, 0, 0, 2, 0, 2, 0, 0, 0, 0, 255, 255, 0, 0, 255, 255, 0, 1, 0, 0])
		let tags = tables.keys()
		tags.sort((a string, b string) => a<b)
		let total = 12 + tags.len() * 16
		for let tag in tags {
			let t = tables.get(tag)
			if !(t is none) {
				total += (t.len() + 3) / 4 * 4
			}
		}
		let out byte[]
		out.len(total)
		out.fill(0)
		putField(out, 0, field(data, 0, 4), 4)
		putField(out, 4, tags.len(), 2)
		let power = 1
		let selector = 0
		for power * 2 <= tags.len() {
			power *= 2
			selector++
		}
		putField(out, 6, power * 16, 2)
		putField(out, 8, selector, 2)
		putField(out, 10, tags.len() * 16 - power * 16, 2)
		let at = 12 + tags.len() * 16
		let head = -1
		for let (i, tag) in tags {
			let found = tables.get(tag)
			continue when found is none
			let table = found
			if tag == "head" && table.len() >= 12 {
				putField(table, 8, 0, 4)
				head = at
			}
			let record = 12 + i * 16
			let name = tag.bytes()
			for let k = 0; k<4; k++ {
				out[record + k] = name[k]
			}
			putField(out, record + 8, at, 4)
			putField(out, record + 12, table.len(), 4)
			for let k = 0; k<table.len(); k++ {
				out[at + k] = table[k]
			}
			let padded = (table.len() + 3) / 4 * 4
			putField(out, record + 4, int(fontChecksum(out[at:at + padded])), 4)
			at += padded
		}
		putField(out, head + 8, int(uint32(0xb1b0afba) - fontChecksum(out)), 4) when head >= 0
		return out
	}

	def putField(out byte[], at int, value int, count int) {
		for let i = 0; i<count; i++ {
			out[at + i] = byte((value >> ((count - i - 1) * 8)) & 255)
		}
	}

	def fontChecksum(data byte[]) uint32 {
		let sum = uint32(0)
		for let i = 0; i<data.len(); i += 4 {
			sum += uint32(field(data, i, 4))
		}
		return sum
	}
}
