internal partial module std.formats.docs.pdf {
	use (
		std.bytes
		std.data.compress.zlib
		std.formats.docs::*
		std.formats.image
	)

	// Font styles of the writer, and the resource names F1 to F5 they get.
	const regularStyle = 0
	const boldStyle = 1
	const italicStyle = 2
	const boldItalicStyle = 3
	const monoStyle = 4

	// WinAnsi code per character above 127, built on first use.
	let winAnsiCodes = new map<int, int>()

	// winAnsi returns the text in WinAnsiEncoding, `?` for what it cannot
	// hold.
	def winAnsi(text string) byte[] {
		if winAnsiCodes.len() == 0 {
			for let i = 128; i < 256; i++ {
				winAnsiCodes.set(winAnsiEncoding[i], i) unless winAnsiEncoding[i] == 0
			}
		}
		let out = byte[]
		for let (_, c) in text {
			let code = int(c)
			if code >= 32 && code < 127 {
				out.push(byte(code))
			} else if code == 9 {
				out.push(32)
			} else {
				let mapped = winAnsiCodes.get(code)
				out.push((mapped is none) ?? (byte(63), byte(mapped)))
			}
		}
		return out
	}

	// number writes a coordinate with at most two decimals.
	def number(value float) string {
		let hundredths = int((value * 100.0).round())
		let sign = (hundredths < 0) ?? ("-", "")
		let magnitude = hundredths.abs()
		let whole = magnitude / 100
		let fraction = magnitude % 100
		return "{sign}{whole}" when fraction == 0
		return "{sign}{whole}.{fraction / 10}" when fraction % 10 == 0
		return "{sign}{whole}.{fraction.str().padStart(2, "0")}"
	}

	// literal writes bytes as a literal string.
	def literal(data byte[]) byte[] {
		let out = byte[40]
		for let i = 0; i < data.len(); i++ {
			let c = data[i]
			if c := 40 || 41 || 92 {
				out.push(92, c)
			} else if c == 10 {
				out.push(92, 110)
			} else if c == 13 {
				out.push(92, 114)
			} else {
				out.push(c)
			}
		}
		out.push(41)
		return out
	}

	// textObject writes a text string: literal when it is ASCII, UTF-16 with a
	// byte order mark otherwise.
	def textObject(text string) string {
		let ascii = true
		for let (_, c) in text {
			ascii = false unless int(c) >= 32 && int(c) < 127
		}
		return string(literal(text.bytes())) when ascii
		let out = "<FEFF"
		for let (_, c) in text {
			let code = int(c)
			if code >= 0x10000 {
				let v = code - 0x10000
				out += hex4(0xd800 + (v >> 10)) + hex4(0xdc00 + (v & 0x3ff))
			} else {
				out += hex4(code)
			}
		}
		return out + ">"
	}

	def hex4(value int) string {
		let digits = "0123456789ABCDEF"
		let out = ""
		for let shift = 12; shift >= 0; shift -= 4 {
			out += digits.slice((value >> shift) & 15, ((value >> shift) & 15) + 1)
		}
		return out
	}

	// deflate compresses data as a zlib stream.
	def deflate(data byte[]) byte[] {
		let out = new bytes.Buffer()
		let w = new zlib.Writer(out)
		w.write(data) onerror recover 0
		w.close() onerror recover none
		return out.bytes()
	}

	// Piece is a word, a space or a forced line break of flowing text.
	type Piece {
		text  string
		face  int
		url   string
		width float
		space bool
		// A line break: the line ends here.
		stop  bool

		def new() {}
	}

	// Heading remembered for the outline.
	struct Mark {
		title string
		level int
		page  int
		y     float
	}

	// DocumentWriter lays a document out on pages with the standard fonts and
	// writes the PDF file.
	type DocumentWriter {
		codec        Pdf
		doc          Document
		// Object bodies, object n at index n - 1.
		objects      byte[][]
		pages        int[]
		contents     byte[][]
		annots       string[][]
		content      byte[]
		y            float
		left         float
		width        float
		// Image XObject names by resource name.
		xobjects     map<string, string>
		// The resource dictionary entries of the image XObjects.
		imageEntries string
		marks        Mark[]

		def new(codec Pdf, doc Document) {
			self.codec = codec
			self.doc = doc
			objects = byte[][]
			pages = int[]
			contents = byte[][]
			annots = string[][]
			content = byte[]
			xobjects = new map<string, string>()
			marks = Mark[]
			left = codec.margin
			width = codec.pageWidth - 2.0 * codec.margin
		}

		// reserve allocates an object number.
		def reserve() int {
			objects.push(byte[])
			return objects.len()
		}

		def set(number int, body string) {
			objects[number - 1] = body.bytes()
		}

		def encode() byte[] {
			let catalog = reserve()
			let pageTree = reserve()
			let info = reserve()
			let fontObjects = int[]
			let names = fontNames(codec.font)
			for let (_, name) in names {
				let n = reserve()
				let encoding = name.startsWith("Symbol") ?? ("", "/Encoding/WinAnsiEncoding")
				set(n, "<</Type/Font/Subtype/Type1/BaseFont/{name}{encoding}>>")
				fontObjects.push(n)
			}
			newPage()
			render(doc.body.children, 0.0)
			finishPage()

			let fonts = ""
			for let (i, n) in fontObjects {
				fonts += "/F{i + 1} {n} 0 R"
			}
			let resources = "<</Font<<{fonts}>>/XObject<<{imageEntries}>>>>"
			let kids = ""
			for let (i, page) in pages {
				let stream = reserve()
				objects[stream - 1] = streamBody("/Filter/FlateDecode", deflate(contents[i]))
				let annotations = ""
				annotations = "/Annots[" + annots[i].join(" ") + "]" when annots[i].len() > 0
				set(page, "<</Type/Page/Parent {pageTree} 0 R/MediaBox[0 0 {number(codec.pageWidth)} {number(codec.pageHeight)}]/Resources {resources}/Contents {stream} 0 R{annotations}>>")
				kids += "{page} 0 R "
			}
			set(pageTree, "<</Type/Pages/Kids[{kids.trim()}]/Count {pages.len()}>>")

			let catalogExtra = ""
			catalogExtra += "/Lang" + textObject(doc.language) unless doc.language == ""
			let outline = writeOutline()
			catalogExtra += "/Outlines {outline} 0 R/PageMode/UseOutlines" when outline > 0
			set(catalog, "<</Type/Catalog/Pages {pageTree} 0 R{catalogExtra}>>")
			set(info, infoDictionary())
			return serialize(catalog, info)
		}

		// infoDictionary writes title, authors, subject, keywords and date.
		def infoDictionary() string {
			let out = "<</Producer(ADM std.formats.docs)"
			out += "/Title" + textObject(doc.title) unless doc.title == ""
			out += "/Author" + textObject(doc.authors.join("; ")) when doc.authors.len() > 0
			let subject = doc.metadata.get("subject")
			out += "/Subject" + textObject(subject) unless subject is none
			let keywords = doc.metadata.get("keywords")
			out += "/Keywords" + textObject(keywords) unless keywords is none
			let date = doc.date
			if !(date is none) {
				let stamp = date.str()
				let digits = ""
				for let (_, c) in stamp.slice(0, 19) {
					digits += string(c) when c.isDigit()
				}
				out += "/CreationDate(D:{digits}Z)"
			}
			return out + ">>"
		}

		// serialize writes the header, the objects, the cross-reference table
		// and the trailer.
		def serialize(catalog int, info int) byte[] {
			let out = "%PDF-1.7\n%".bytes()
			out.push(0xe2, 0xe3, 0xcf, 0xd3, 10)
			let offsets = int[]
			for let (i, body) in objects {
				offsets.push(out.len())
				out.push(..."{i + 1} 0 obj\n".bytes())
				out.push(...body)
				out.push(..."\nendobj\n".bytes())
			}
			let xref = out.len()
			out.push(..."xref\n0 {objects.len() + 1}\n0000000000 65535 f \n".bytes())
			for let (_, offset) in offsets {
				out.push(..."{offset.str().padStart(10, "0")} 00000 n \n".bytes())
			}
			out.push(..."trailer\n<</Size {objects.len() + 1}/Root {catalog} 0 R/Info {info} 0 R>>\nstartxref\n{xref}\n%%EOF\n".bytes())
			return out
		}

		def streamBody(dict string, data byte[]) byte[] {
			let out = "<<{dict}/Length {data.len()}>>stream\n".bytes()
			out.push(...data)
			out.push(..."\nendstream".bytes())
			return out
		}

		// writeOutline writes the headings as bookmarks, nested by level, and
		// returns the outline's object number, 0 when there are no headings.
		def writeOutline() int {
			return 0 when marks.len() == 0
			let root = reserve()
			let numbers = int[]
			for let (_, _) in marks {
				numbers.push(reserve())
			}
			// parents[i] is the index of the entry's parent, -1 for the root.
			let parents = int[]
			let stack = int[]
			for let (i, mark) in marks {
				for stack.len() > 0 && marks[stack[stack.len() - 1]].level >= mark.level {
					stack.pop()
				}
				parents.push((stack.len() > 0) ?? (stack[stack.len() - 1], -1))
				stack.push(i)
			}
			let rootKids = int[]
			for let (i, mark) in marks {
				let kids = int[]
				for let k = i + 1; k < marks.len(); k++ {
					kids.push(k) when parents[k] == i
				}
				let siblings = int[]
				for let k = 0; k < marks.len(); k++ {
					siblings.push(k) when parents[k] == parents[i]
				}
				let at = siblings.indexOf(i)
				let parent = (parents[i] < 0) ?? (root, numbers[parents[i]])
				let body = "<</Title{textObject(mark.title)}/Parent {parent} 0 R/Dest[{pages[mark.page]} 0 R/XYZ 0 {number(mark.y)} 0]"
				body += "/Prev {numbers[siblings[at - 1]]} 0 R" when at > 0
				body += "/Next {numbers[siblings[at + 1]]} 0 R" when at + 1 < siblings.len()
				body += "/First {numbers[kids[0]]} 0 R/Last {numbers[kids[kids.len() - 1]]} 0 R/Count {kids.len()}" when kids.len() > 0
				set(numbers[i], body + ">>")
				rootKids.push(i) when parents[i] < 0
			}
			set(root, "<</Type/Outlines/First {numbers[rootKids[0]]} 0 R/Last {numbers[rootKids[rootKids.len() - 1]]} 0 R/Count {rootKids.len()}>>")
			return root
		}

		def newPage() {
			finishPage() when pages.len() > 0
			pages.push(reserve())
			annots.push(string[])
			content = byte[]
			y = codec.pageHeight - codec.margin
		}

		def finishPage() {
			return when contents.len() == pages.len()
			contents.push(content)
		}

		// advance moves down by the height, to a new page when it does not fit.
		def advance(height float) {
			if y - height < codec.margin && y < codec.pageHeight - codec.margin {
				finishPage()
				newPage()
			}
			y -= height
		}

		def space(height float) {
			y -= height
		}

		def emit(text string) {
			content.push(...text.bytes())
		}

		// render lays out the blocks, indented from the left margin.
		def render(blocks Block[], indent float) {
			let size = codec.fontSize
			for let (_, block) in blocks {
				match block.kind {
					case BlockKind.Heading:
						let scales = float[2.0, 1.6, 1.35, 1.2, 1.1, 1.0]
						let hsize = size * scales[(block.level - 1).clamp(0, 5)]
						space(0.8 * hsize)
						advanceFor(1.3 * hsize * 2.0)
						marks.push(Mark{title: block.plainText(), level: block.level.clamp(1, 6), page: pages.len() - 1, y: y})
						flow(pieces(block.inlines, boldStyle, ""), hsize, indent, "")
						space(0.4 * hsize)
					case BlockKind.Paragraph:
						flow(pieces(block.inlines, regularStyle, ""), size, indent, "")
						space(0.6 * size)
					case BlockKind.List:
						for let (i, item) in block.children {
							let marker = block.ordered ?? ("{block.start + i}.", "•")
							renderItem(item, indent, marker)
						}
						space(0.4 * size)
					case BlockKind.Item:
						renderItem(block, indent, "•")
					case BlockKind.Quote, BlockKind.Section, BlockKind.Cell:
						render(block.children, indent + ((block.kind == BlockKind.Quote) ?? (18.0, 0.0)))
					case BlockKind.Code:
						code(block.content, indent)
						space(0.6 * size)
					case BlockKind.Rule:
						advance(0.8 * size)
						emit("0.5 w {number(left + indent)} {number(y)} m {number(left + width)} {number(y)} l S\n")
						space(0.8 * size)
					case BlockKind.PageBreak:
						finishPage()
						newPage()
					case BlockKind.Table:
						table(block, indent)
						space(0.6 * size)
					case BlockKind.Image:
						picture(block, indent)
					default:
				}
			}
		}

		// advanceFor starts a new page when less than the height is left, so a
		// heading does not end a page alone.
		def advanceFor(height float) {
			if y - height < codec.margin && y < codec.pageHeight - codec.margin {
				finishPage()
				newPage()
			}
		}

		// renderItem lays out a list item: its first paragraph behind the
		// marker, the rest of its blocks indented under it.
		def renderItem(item Block, indent float, marker string) {
			let size = codec.fontSize
			let rest = Block[]
			let first = true
			for let (_, child) in item.children {
				if first && child.kind == BlockKind.Paragraph {
					flow(pieces(child.inlines, regularStyle, ""), size, indent + 18.0, marker)
					first = false
				} else {
					rest.push(child)
				}
			}
			flow(Piece[], size, indent + 18.0, marker) when first
			render(rest, indent + 18.0)
			space(0.2 * size)
		}

		// pieces splits inlines into words and spaces with their face.
		def pieces(items Inline[], face int, url string) Piece[] {
			let out = Piece[]
			for let (_, item) in items {
				match item.kind {
					case InlineKind.Text:
						words(out, item.content, face, url)
					case InlineKind.Code:
						words(out, item.content, monoStyle, url)
					case InlineKind.Bold:
						out.push(...pieces(item.children, (face == monoStyle) ?? (face, face | boldStyle), url))
					case InlineKind.Italic:
						out.push(...pieces(item.children, (face == monoStyle) ?? (face, face | italicStyle), url))
					case InlineKind.Link:
						out.push(...pieces(item.children, face, item.url))
					case InlineKind.LineBreak:
						let stop = new Piece()
						stop.stop = true
						out.push(stop)
					case InlineKind.Image:
						words(out, item.plainText(), face, url)
					case InlineKind.Footnote, InlineKind.Raw:
					default:
						out.push(...pieces(item.children, face, url))
				}
			}
			return out
		}

		def words(out Piece[], text string, face int, url string) {
			let current = ""
			for let (_, c) in text {
				if c := ' ' || '\n' || '\t' {
					addWord(out, current, face, url)
					current = ""
					let blank = new Piece()
					blank.space = true
					blank.text = " "
					blank.face = face
					blank.url = url
					out.push(blank)
				} else {
					current += string(c)
				}
			}
			addWord(out, current, face, url)
		}

		def addWord(out Piece[], text string, face int, url string) {
			return when text == ""
			let piece = new Piece()
			piece.text = text
			piece.face = face
			piece.url = url
			out.push(piece)
		}

		// measure returns the width of the text in the face at the size.
		def measure(text string, face int, size float) float {
			let data = winAnsi(text)
			return float(data.len()) * 0.6 * size when face == monoStyle || codec.font == PdfFont.Courier
			let table = styleWidths(codec.font, face)
			let total = 0
			for let i = 0; i < data.len(); i++ {
				let w = table[int(data[i])]
				total += (w == 0) ?? (500, w)
			}
			return float(total) * size / 1000.0
		}

		// flow breaks the pieces into lines that fit the width and draws them,
		// the marker (a bullet or a number) before the first line.
		def flow(items Piece[], size float, indent float, marker string) {
			let leading = 1.25 * size
			let avail = width - indent
			let line = Piece[]
			let used = 0.0
			let pending ?Piece = none
			let markerLeft = marker
			for let (_, piece) in items {
				if piece.stop {
					drawLine(line, size, leading, indent, markerLeft)
					markerLeft = ""
					line = Piece[]
					used = 0.0
					pending = none
					continue
				}
				piece.width = measure(piece.text, piece.face, size)
				if piece.space {
					pending = piece when line.len() > 0
					continue
				}
				let gap = 0.0
				let blank = pending
				gap = blank.width unless (blank is none)
				if line.len() > 0 && used + gap + piece.width > avail {
					drawLine(line, size, leading, indent, markerLeft)
					markerLeft = ""
					line = Piece[]
					used = 0.0
					pending = none
					blank = none
					gap = 0.0
				}
				if !(blank is none) {
					line.push(blank)
					used += gap
					pending = none
				}
				// A word wider than the line is cut to fit.
				let word = piece
				for line.len() == 0 && word.width > avail && word.text.len() > 1 {
					let cut = word.text.len() - 1
					for cut > 1 && measure(word.text.slice(0, cut), word.face, size) > avail {
						cut--
					}
					let head = new Piece()
					head.text = word.text.slice(0, cut)
					head.face = word.face
					head.url = word.url
					head.width = measure(head.text, head.face, size)
					drawLine(Piece[head], size, leading, indent, markerLeft)
					markerLeft = ""
					let tail = new Piece()
					tail.text = word.text.slice(cut)
					tail.face = word.face
					tail.url = word.url
					tail.width = measure(tail.text, tail.face, size)
					word = tail
				}
				line.push(word)
				used += word.width
			}
			drawLine(line, size, leading, indent, markerLeft) when line.len() > 0 || markerLeft != ""
		}

		// drawLine draws one line of pieces, face runs as one string each,
		// and adds link annotations over linked pieces.
		def drawLine(line Piece[], size float, leading float, indent float, marker string) {
			advance(leading)
			let x = left + indent
			emit("BT /F1 {number(size)} Tf {number(x - 18.0)} {number(y)} Td {string(literal(winAnsi(marker)))} Tj ET\n") when marker != ""
			return when line.len() == 0
			emit("BT {number(x)} {number(y)} Td")
			let face = -1
			let url = ""
			let run = ""
			let linkStart = x
			let at = x
			for let (_, piece) in line {
				if piece.face != face || piece.url != url {
					emit(" {string(literal(winAnsi(run)))} Tj") when run != ""
					if piece.url != url {
						if url != "" {
							addLink(url, linkStart, at, size)
							emit(" 0 g")
						}
						if piece.url != "" {
							linkStart = at
							emit(" 0 0 1 rg")
						}
						url = piece.url
					}
					if piece.face != face {
						face = piece.face
						emit(" /F{face + 1} {number(size)} Tf")
					}
					run = ""
				}
				run += piece.text
				at += piece.width
			}
			emit(" {string(literal(winAnsi(run)))} Tj") when run != ""
			if url != "" {
				addLink(url, linkStart, at, size)
				emit(" 0 g")
			}
			emit(" ET\n")
		}

		def addLink(url string, x0 float, x1 float, size float) {
			let n = reserve()
			set(n, "<</Type/Annot/Subtype/Link/Rect[{number(x0)} {number(y - 0.25 * size)} {number(x1)} {number(y + 0.85 * size)}]/Border[0 0 0]/A<</S/URI/URI{string(literal(url.bytes()))}>>>>")
			annots[annots.len() - 1].push("{n} 0 R")
		}

		// code draws preformatted lines in Courier, cut where they are wider
		// than the page.
		def code(text string, indent float) {
			let size = codec.fontSize * 0.9
			let leading = 1.2 * size
			let columns = int((width - indent) / (0.6 * size)).max(8)
			for let (_, raw) in text.split("\n") {
				let line = raw.replace("\t", "    ")
				let first = true
				for first || line.len() > 0 {
					first = false
					let part = line.slice(0, line.len().min(columns))
					line = line.slice(part.len())
					advance(leading)
					continue when part.trim() == ""
					emit("BT /F5 {number(size)} Tf {number(left + indent)} {number(y)} Td {string(literal(winAnsi(part)))} Tj ET\n")
				}
			}
		}

		// table draws a grid of equal columns, header rows in bold.
		def table(block Block, indent float) {
			let size = codec.fontSize
			let leading = 1.25 * size
			let columns = block.columns()
			return when columns == 0
			let columnWidth = (width - indent) / float(columns)
			for let (_, row) in block.children {
				let cellLines = string[][]
				let most = 1
				for let (_, cell) in row.children {
					let wrapped = wrapPlain(cell.plainText(), row.header ?? (boldStyle, regularStyle), size, columnWidth - 8.0)
					most = most.max(wrapped.len())
					cellLines.push(wrapped)
				}
				let height = float(most) * leading + 6.0
				advanceFor(height)
				let top = y
				let x = left + indent
				for let (_, lines) in cellLines {
					let baseline = top - 3.0
					for let (_, text) in lines {
						baseline -= leading
						let face = row.header ?? (boldStyle, regularStyle)
						emit("BT /F{face + 1} {number(size)} Tf {number(x + 4.0)} {number(baseline + 0.25 * size)} Td {string(literal(winAnsi(text)))} Tj ET\n")
					}
					emit("0.5 w {number(x)} {number(top - height)} {number(columnWidth)} {number(height)} re S\n")
					x += columnWidth
				}
				y = top - height
			}
		}

		// wrapPlain breaks plain text into lines that fit the width.
		def wrapPlain(text string, face int, size float, avail float) string[] {
			let out = string[]
			let line = ""
			for let (_, word) in text.replace("\n", " ").split(" ") {
				continue when word == ""
				let candidate = (line == "") ?? (word, line + " " + word)
				if line != "" && measure(candidate, face, size) > avail {
					out.push(line)
					line = word
				} else {
					line = candidate
				}
			}
			out.push(line) unless line == ""
			return out
		}

		// picture draws an Image block from the document's resources, scaled to
		// fit, with its caption below.
		def picture(block Block, indent float) {
			let size = codec.fontSize
			let name = imageObject(block.source)
			if name != "" {
				let dims = name.split(" ")
				let w = parseFloat<float>(dims[1])
				let h = parseFloat<float>(dims[2])
				let maxWidth = width - indent
				let maxHeight = codec.pageHeight - 2.0 * codec.margin
				let scale = (maxWidth / w).min(maxHeight / h).min(1.0)
				w *= scale
				h *= scale
				advance(h)
				emit("q {number(w)} 0 0 {number(h)} {number(left + indent)} {number(y)} cm /{dims[0]} Do Q\n")
				space(0.3 * size)
			}
			flow(pieces(block.inlines, italicStyle, ""), size, indent, "") when block.inlines.len() > 0
			space(0.6 * size)
		}

		// imageObject writes the resource as an image XObject once, and returns
		// its name with its pixel size, "Im1 640 480"; empty when the resource
		// is missing or no image codec reads it.
		def imageObject(source string) string {
			let known = xobjects.get(source)
			return known unless known is none
			let data = doc.resource(source)
			if data is none {
				xobjects.set(source, "")
				return ""
			}
			let number = reserve()
			let name = "Im{xobjects.len() + 1}"
			let out = ""
			if data.len() > 3 && data[0] == 0xff && data[1] == 0xd8 {
				let info = image.info(data) onerror (e error) {
					xobjects.set(source, "")
					return ""
				}
				let w = int(info.size.width)
				let h = int(info.size.height)
				let colorSpace = (info.colorFormat.str().lower().contains("gray")) ?? ("DeviceGray", "DeviceRGB")
				objects[number - 1] = streamBody("/Type/XObject/Subtype/Image/Width {w}/Height {h}/ColorSpace/{colorSpace}/BitsPerComponent 8/Filter/DCTDecode", data)
				out = "{name} {w} {h}"
			} else {
				let picture = image.load(data) onerror (e error) {
					xobjects.set(source, "")
					return ""
				}
				let w = int(picture.size().width)
				let h = int(picture.size().height)
				let raw = picture.raw()
				let stride = picture.stride()
				let rgb byte[]
				rgb.len(w * h * 3)
				let alpha byte[]
				alpha.len(w * h)
				let transparent = false
				for let row = 0; row < h; row++ {
					for let col = 0; col < w; col++ {
						let o = row * stride + col * 4
						let p = row * w + col
						rgb[p * 3] = raw[o]
						rgb[p * 3 + 1] = raw[o + 1]
						rgb[p * 3 + 2] = raw[o + 2]
						alpha[p] = raw[o + 3]
						transparent = true when raw[o + 3] != 255
					}
				}
				let mask = ""
				if transparent {
					let maskNumber = reserve()
					objects[maskNumber - 1] = streamBody("/Type/XObject/Subtype/Image/Width {w}/Height {h}/ColorSpace/DeviceGray/BitsPerComponent 8/Filter/FlateDecode", deflate(alpha))
					mask = "/SMask {maskNumber} 0 R"
				}
				objects[number - 1] = streamBody("/Type/XObject/Subtype/Image/Width {w}/Height {h}/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter/FlateDecode{mask}", deflate(rgb))
				out = "{name} {w} {h}"
			}
			imageEntries += "/{name} {number} 0 R"
			xobjects.set(source, out)
			return out
		}
	}

	// fontNames returns the regular, bold, italic, bold italic and code fonts
	// of the family.
	def fontNames(family PdfFont) string[] {
		match family {
			case PdfFont.Times:
				return string["Times-Roman", "Times-Bold", "Times-Italic", "Times-BoldItalic", "Courier"]
			case PdfFont.Courier:
				return string["Courier", "Courier-Bold", "Courier-Oblique", "Courier-BoldOblique", "Courier"]
			default:
				return string["Helvetica", "Helvetica-Bold", "Helvetica-Oblique", "Helvetica-BoldOblique", "Courier"]
		}
	}

	// styleWidths returns the glyph widths of the family in the face, by
	// WinAnsi code.
	def styleWidths(family PdfFont, face int) int[] {
		let bold = (face & boldStyle) != 0
		let italic = (face & italicStyle) != 0
		return bold ?? (italic ?? (timesBoldItalicWidths, timesBoldWidths), italic ?? (timesItalicWidths, timesWidths)) when family == PdfFont.Times
		return bold ?? (helveticaBoldWidths, helveticaWidths)
	}
}
