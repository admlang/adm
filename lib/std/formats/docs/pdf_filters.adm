internal partial module std.formats.docs.pdf {
	use (
		std.bytes
		std.data.compress.flate
		std.data.compress.lzw
		std.formats.docs::*
		std.io
	)

	// drain reads the reader to its end or its first error and returns what
	// it produced, so damaged data decodes as far as it goes.
	def drain(reader io.Reader) byte[] {
		let out = new bytes.Buffer()
		let chunk byte[]
		chunk.len(65536)
		for {
			let n = reader.read(chunk) onerror recover 0
			break when n <= 0
			out.write(chunk[:n]) onerror recover 0
		}
		return out.bytes()
	}

	// inflate undoes FlateDecode: a zlib stream, or raw DEFLATE data when the
	// zlib header is missing. The checksum is not checked.
	def inflate(data byte[]) byte[] {
		let start = 0
		start = 2 when data.len() >= 2 && (data[0] & 0x0f) == 8 && ((int(data[0]) << 8) | int(data[1])) % 31 == 0
		let reader = new flate.Reader(new bytes.Buffer(data[start:]))
		return drain(reader)
	}

	// lzwDecode undoes LZWDecode, whose codes grow one code early unless
	// `EarlyChange` is 0.
	def lzwDecode(data byte[], param PdfObject, store Store) byte[] {
		let early = store.integer(param, "EarlyChange", 1) != 0
		let reader = new lzw.Reader(new bytes.Buffer(data), lzw.Order.MSB, 8, early)
		return drain(reader)
	}

	// predict undoes the TIFF (2) or PNG (10 to 15) predictor named by the
	// decode parameters.
	def predict(data byte[], param PdfObject, store Store) byte[] {
		return data unless param.kind == PdfKind.Dictionary
		let predictor = store.integer(param, "Predictor", 1)
		return data when predictor < 2
		let colors = store.integer(param, "Colors", 1).max(1)
		let bits = store.integer(param, "BitsPerComponent", 8).max(1)
		let columns = store.integer(param, "Columns", 1).max(1)
		let pixel = (colors * bits + 7) / 8
		let row = (colors * bits * columns + 7) / 8
		if predictor == 2 {
			return data unless bits == 8
			let out = data.clone()
			for let start = 0; start + row <= out.len(); start += row {
				for let i = pixel; i < row; i++ {
					out[start + i] = byte((int(out[start + i]) + int(out[start + i - pixel])) & 0xff)
				}
			}
			return out
		}

		let out byte[]
		out.len((data.len() / (row + 1)) * row)
		let previous = 0
		let at = 0
		let o = 0
		for at + row + 1 <= data.len() {
			let kind = int(data[at])
			let src = at + 1
			for let i = 0; i < row; i++ {
				let raw = int(data[src + i])
				let left = (i >= pixel) ?? (int(out[o + i - pixel]), 0)
				let up = (o > 0) ?? (int(out[previous + i]), 0)
				let corner = (o > 0 && i >= pixel) ?? (int(out[previous + i - pixel]), 0)
				let value = raw
				match kind {
					case 1:
						value = raw + left
					case 2:
						value = raw + up
					case 3:
						value = raw + (left + up) / 2
					case 4:
						value = raw + paeth(left, up, corner)
					default:
				}
				out[o + i] = byte(value & 0xff)
			}
			previous = o
			o += row
			at += row + 1
		}
		return out
	}

	// paeth returns the neighbour the PNG Paeth predictor picks.
	def paeth(a int, b int, c int) int {
		let p = a + b - c
		let pa = (p - a).abs()
		let pb = (p - b).abs()
		let pc = (p - c).abs()
		return a when pa <= pb && pa <= pc
		return b when pb <= pc
		return c
	}

	// asciiHexDecode undoes ASCIIHexDecode, up to its `>`.
	def asciiHexDecode(data byte[]) byte[] {
		let out byte[]
		let high = -1
		for let i = 0; i < data.len(); i++ {
			let c = int(data[i])
			break when c == 62
			let v = hexValue(c)
			continue when v < 0
			if high < 0 {
				high = v
			} else {
				out.push(byte(high * 16 + v))
				high = -1
			}
		}
		out.push(byte(high * 16)) when high >= 0
		return out
	}

	// ascii85Decode undoes ASCII85Decode, up to its `~>`.
	def ascii85Decode(data byte[]) byte[] {
		let out byte[]
		let group = 0
		let count = 0
		let i = 0
		i = 2 when data.len() >= 2 && data[0] == 60 && data[1] == 126
		for; i < data.len(); i++ {
			let c = int(data[i])
			break when c == 126
			if c == 122 && count == 0 {
				out.push(0, 0, 0, 0)
				continue
			}
			continue when c < 33 || c > 117
			group = group * 85 + (c - 33)
			count++
			if count == 5 {
				out.push(byte((group >> 24) & 0xff), byte((group >> 16) & 0xff), byte((group >> 8) & 0xff), byte(group & 0xff))
				group = 0
				count = 0
			}
		}
		if count > 1 {
			for let k = count; k < 5; k++ {
				group = group * 85 + 84
			}
			for let k = 0; k < count - 1; k++ {
				out.push(byte((group >> (24 - 8 * k)) & 0xff))
			}
		}
		return out
	}

	// runLengthDecode undoes RunLengthDecode, up to its end marker 128.
	def runLengthDecode(data byte[]) byte[] {
		let out byte[]
		let i = 0
		for i < data.len() {
			let length = int(data[i])
			i++
			break when length == 128
			if length < 128 {
				let end = (i + length + 1).min(data.len())
				out.push(...data[i:end])
				i = end
			} else {
				break when i >= data.len()
				let value = data[i]
				for let k = 0; k < 257 - length; k++ {
					out.push(value)
				}
				i++
			}
		}
		return out
	}
}
