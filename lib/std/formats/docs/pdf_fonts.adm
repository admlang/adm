internal partial module std.formats.docs.pdf {
	use (
		std.bytes
		std.formats.docs::*
	)

	// The glyph name table, built on first use from `glyphNameList`.
	let glyphNames = new map<string, int>()

	// glyphText returns the characters a glyph name stands for in UTF-8:
	// a name of the glyph list, `uniXXXX…`, `uXXXX`, a ligature `f_f_i` or a
	// name with a `.suffix`. Empty when the name means nothing known.
	def glyphText(name string) byte[] {
		let out = byte[]
		if glyphNames.len() == 0 {
			let parts = glyphNameList.split(" ")
			for let i = 0; i + 1 < parts.len(); i += 2 {
				glyphNames.set(parts[i], parseInt<int>(parts[i + 1], 16))
			}
		}
		let base = name
		let dot = base.indexOf(".")
		base = base.slice(0, dot) when dot > 0
		if base.contains("_") {
			for let (_, part) in base.split("_") {
				out.push(...glyphText(part))
			}
			return out
		}
		let known = glyphNames.get(base)
		if !(known is none) {
			out.append(char(known))
			return out
		}
		let b = base.bytes()
		if base.startsWith("uni") && (b.len() - 3) % 4 == 0 && b.len() > 3 {
			for let i = 3; i + 4 <= b.len(); i += 4 {
				let code = hexNumber(b, i, 4)
				return byte[] when code < 0
				out.append(char(code))
			}
			return out
		}
		if base.startsWith("u") && b.len() >= 5 && b.len() <= 7 {
			let code = hexNumber(b, 1, b.len() - 1)
			out.append(char(code)) when code > 0 && code < 0x110000
			return out
		}
		return out
	}

	// Latin ligatures U+FB00 to U+FB06 spelled out.
	let ligatureLetters = string["ff", "fi", "fl", "ffi", "ffl", "st", "st"]

	// ligatures returns the text with the Latin ligature characters spelled
	// out as letters, so extracted words read and search as typed.
	def ligatures(text byte[]) byte[] {
		let found = false
		for let i = 0; i + 2 < text.len(); i++ {
			found = true when text[i] == 0xef && text[i + 1] == 0xac && text[i + 2] <= 0x86
		}
		return text unless found
		let out = byte[]
		let i = 0
		for i < text.len() {
			if i + 2 < text.len() && text[i] == 0xef && text[i + 1] == 0xac && text[i + 2] <= 0x86 {
				out.push(...ligatureLetters[int(text[i + 2]) - 0x80].bytes())
				i += 3
			} else {
				out.push(text[i])
				i++
			}
		}
		return out
	}

	// hexNumber reads count hexadecimal digits at the offset, -1 when any is
	// not one.
	def hexNumber(b byte[], at int, count int) int {
		let value = 0
		for let i = at; i < at + count; i++ {
			let v = hexValue(int(b[i]))
			return -1 when v < 0
			value = value * 16 + v
		}
		return value
	}

	// CMap maps character codes: to Unicode text (a ToUnicode CMap) or to
	// CIDs (an encoding CMap), with the code space ranges that say how many
	// bytes each code takes.
	type CMap {
		// Preserve ligature characters when the mapping is used for painting.
		expandLigatures bool             = true
		// Code space ranges: low, high and byte count, three ints per range.
		spaces          int[]
		chars           map<int, byte[]>
		// Ranges of `bfrange`: low, high, and the index in `starts`.
		ranges          int[]
		starts          int[][]
		cids            map<int, int>
		// Ranges of `cidrange`: low, high, first CID.
		cidRanges       int[]

		def new() {
			spaces = int[]
			chars = new map<int, byte[]>()
			ranges = int[]
			starts = int[][]
			cids = new map<int, int>()
			cidRanges = int[]
		}

		// codeLength returns how many bytes the code at the offset takes.
		def codeLength(data byte[], at int, fallback int) int {
			return fallback when spaces.len() == 0
			let value = 0
			for let n = 1; n <= 4 && at + n <= data.len(); n++ {
				value = value << 8 | int(data[at + n - 1])
				for let i = 0; i + 2 < spaces.len(); i += 3 {
					return n when spaces[i + 2] == n && value >= spaces[i] && value <= spaces[i + 1]
				}
			}
			return spaces[2]
		}

		// text returns the Unicode text of the code, none when the CMap does
		// not map it.
		def text(code int) ?byte[] {
			let direct = chars.get(code)
			return direct unless direct is none
			for let i = 0; i + 2 < ranges.len(); i += 3 {
				continue unless code >= ranges[i] && code <= ranges[i + 1]
				let units = starts[ranges[i + 2]]
				let out = byte[]
				for let k = 0; k < units.len(); k++ {
					let unit = units[k]
					unit += code - ranges[i] when k == units.len() - 1
					out.append(char(unit))
				}
				let spelled = expandLigatures ?? (ligatures(out), out)
				chars.set(code, spelled)
				return spelled
			}
			return none
		}

		// cid returns the CID of the code, the code itself when unmapped.
		def cid(code int) int {
			let direct = cids.get(code)
			return direct unless direct is none
			for let i = 0; i + 2 < cidRanges.len(); i += 3 {
				return cidRanges[i + 2] + code - cidRanges[i] when code >= cidRanges[i] && code <= cidRanges[i + 1]
			}
			return code
		}
	}

	// parseCMap reads the code spaces and mappings of a CMap program.
	def parseCMap(data byte[], expandLigatures bool = true) CMap {
		let out = new CMap()
		out.expandLigatures = expandLigatures
		let p = new Parser(data)
		p.refs = false
		let operands = PdfObject[]
		for {
			p.skipSpace()
			break when p.atEnd()
			let c = p.peek()
			if isRegular(c) && !(c >= 48 && c <= 57) && c != 45 && c != 43 && c != 46 {
				let w = p.word()
				match w {
					case "endcodespacerange":
						for let i = 0; i + 1 < operands.len(); i += 2 {
							out.spaces.push(codeValue(operands[i]), codeValue(operands[i + 1]), operands[i].data.len().max(1))
						}
					case "endbfchar":
						for let i = 0; i + 1 < operands.len(); i += 2 {
							out.chars.set(codeValue(operands[i]), (expandLigatures ?? (ligatures(unicodeOf(operands[i + 1])), unicodeOf(operands[i + 1]))))
						}
					case "endbfrange":
						for let i = 0; i + 2 < operands.len(); i += 3 {
							let low = codeValue(operands[i])
							let high = codeValue(operands[i + 1])
							let dst = operands[i + 2]
							if dst.kind == PdfKind.Array {
								for let k = 0; k < dst.items.len() && low + k <= high; k++ {
									out.chars.set(low + k, (expandLigatures ?? (ligatures(unicodeOf(dst.items[k])), unicodeOf(dst.items[k]))))
								}
							} else if high >= low {
								out.ranges.push(low, high, out.starts.len())
								out.starts.push(utf16Units(dst.data))
							}
						}
					case "endcidchar":
						for let i = 0; i + 1 < operands.len(); i += 2 {
							out.cids.set(codeValue(operands[i]), int(operands[i + 1].number))
						}
					case "endcidrange":
						for let i = 0; i + 2 < operands.len(); i += 3 {
							out.cidRanges.push(codeValue(operands[i]), codeValue(operands[i + 1]), int(operands[i + 2].number))
						}
					default:
				}
				operands = PdfObject[]
				continue
			}
			operands.push(p.value())
		}
		return out
	}

	// codeValue reads a code written as a string of bytes, or as a number.
	def codeValue(value PdfObject) int {
		return int(value.number) unless value.kind == PdfKind.String
		return field(value.data, 0, value.data.len().min(4))
	}

	// unicodeOf returns a CMap destination as UTF-8: UTF-16 bytes, or a
	// glyph name.
	def unicodeOf(value PdfObject) byte[] {
		return glyphText(value.name) when value.kind == PdfKind.Name
		return value.data.utf16(bytes.Endian.Big).bytes()
	}

	// utf16Units returns the code points of UTF-16 bytes.
	def utf16Units(data byte[]) int[] {
		let out = int[]
		for let (_, c) in data.utf16(bytes.Endian.Big) {
			out.push(int(c))
		}
		out.push(int(data[0])) when data.len() == 1
		return out
	}

	// Font is the mapping shared by extraction and painting: how string bytes
	// split into codes, the text and the width of each code, and its style.
	type Font {
		// Extraction expands ligatures; painting must preserve the original glyph.
		expandLigatures bool            = true
		name            string
		composite       bool
		bold            bool
		italic          bool
		mono            bool
		// Text per code of a simple font, UTF-8.
		texts           byte[][]
		// Width per code of a simple font, in text space units.
		widths          float[]
		toUnicode       ?CMap
		// The encoding CMap of a composite font, none for Identity.
		encoding        ?CMap
		// Whether the codes of a composite font are UTF-16 code units.
		ucs2            bool
		cidWidths       map<int, float>
		defaultWidth    float           = 1.0
		// How much larger than the font size the glyphs are drawn: 1 but for
		// Type 3 fonts.
		sizeScale       float           = 1.0

		def new() {
			texts = byte[][]
			widths = float[]
			cidWidths = new map<int, float>()
		}

		// codeLength returns how many bytes the code at the offset takes.
		def codeLength(data byte[], at int) int {
			return 1 unless composite
			let enc = encoding
			return 2 when enc is none
			return enc.codeLength(data, at, 2)
		}

		// text returns the characters of the code in UTF-8.
		def text(code int) byte[] {
			let map = toUnicode
			if composite {
				if !(map is none) {
					let found = map.text(code)
					return found unless found is none
				}
				if ucs2 {
					let out = byte[]
					out.append(char(code)) when code >= 32
					return out
				}
				return byte[]
			}
			return byte[] when code < 0 || code >= texts.len()
			return texts[code]
		}

		// width returns the advance of the code in text space units, before the
		// font size.
		def width(code int) float {
			if composite {
				let enc = encoding
				let cid = (enc is none) ?? (code, enc.cid(code))
				let w = cidWidths.get(cid)
				return (w is none) ?? (defaultWidth, w)
			}
			return 0.0 when code < 0 || code >= widths.len()
			return widths[code]
		}
	}

	// loadFont reads a font dictionary.
	def loadFont(store Store, dict PdfObject, expandLigatures bool = true) Font {
		let font = new Font()
		font.expandLigatures = expandLigatures
		let subtype = store.resolve(dict.get("Subtype")).name
		let baseName = store.resolve(dict.get("BaseFont")).name
		baseName = baseName.slice(7) when baseName.len() > 7 && baseName[6] == '+'
		font.name = baseName
		let descriptor = store.resolve(dict.get("FontDescriptor"))
		let descendant = new PdfObject()
		if subtype == "Type0" {
			font.composite = true
			let kids = store.resolve(dict.get("DescendantFonts"))
			if kids.kind == PdfKind.Array && kids.items.len() > 0 {
				descendant = store.resolve(kids.items[0])
				descriptor = store.resolve(descendant.get("FontDescriptor"))
			}
		}
		fontStyle(store, font, descriptor)

		let toUnicode = store.resolve(dict.get("ToUnicode"))
		if toUnicode.kind == PdfKind.Stream {
			let body = store.decode(toUnicode) onerror recover byte[]
			font.toUnicode = parseCMap(body, expandLigatures)
		}

		if font.composite {
			compositeFont(store, font, dict, descendant)
		} else {
			simpleFont(store, font, dict, descriptor, subtype)
		}
		return font
	}

	// fontStyle reads bold, italic and monospace from the name and the font
	// descriptor.
	def fontStyle(store Store, font Font, descriptor PdfObject) {
		let lower = font.name.lower()
		let flags = store.integer(descriptor, "Flags")
		let weight = store.integer(descriptor, "FontWeight")
		font.bold = lower.contains("bold") || lower.contains("black") || lower.contains("heavy") || lower.contains("semibold") || lower.contains("demi") || weight >= 600 || (flags & 262144) != 0
		font.italic = lower.contains("italic") || lower.contains("oblique") || (flags & 64) != 0
		font.mono = lower.contains("courier") || lower.contains("mono") || lower.contains("consol") || lower.contains("code") || lower.contains("typewriter") || lower.startsWith("lmtt") || lower.startsWith("cmtt") || (flags & 1) != 0
	}

	// compositeFont reads the encoding CMap and CID widths of a Type 0 font.
	def compositeFont(store Store, font Font, dict PdfObject, descendant PdfObject) {
		let enc = store.resolve(dict.get("Encoding"))
		if enc.kind == PdfKind.Stream {
			let body = store.decode(enc) onerror recover byte[]
			font.encoding = parseCMap(body)
		} else if enc.name.contains("UCS2") || enc.name.contains("UTF16") {
			font.ucs2 = true
		}
		font.defaultWidth = float(store.integer(descendant, "DW", 1000)) / 1000.0
		let w = store.resolve(descendant.get("W"))
		return unless w.kind == PdfKind.Array
		let i = 0
		for i < w.items.len() {
			let first = int(store.resolve(w.items[i]).number)
			break when i + 1 >= w.items.len()
			let next = store.resolve(w.items[i + 1])
			if next.kind == PdfKind.Array {
				for let (k, item) in next.items {
					font.cidWidths.set(first + k, store.resolve(item).number / 1000.0)
				}
				i += 2
			} else {
				break when i + 2 >= w.items.len()
				let last = int(next.number)
				let width = store.resolve(w.items[i + 2]).number / 1000.0
				for let cid = first; cid <= last && cid - first < 65536; cid++ {
					font.cidWidths.set(cid, width)
				}
				i += 3
			}
		}
	}

	// simpleFont reads the encoding, differences and widths of a one-byte
	// font.
	def simpleFont(store Store, font Font, dict PdfObject, descriptor PdfObject, subtype string) {
		let enc = store.resolve(dict.get("Encoding"))
		let baseName = enc.name
		baseName = store.resolve(enc.get("BaseEncoding")).name when enc.kind == PdfKind.Dictionary
		let flags = store.integer(descriptor, "Flags")
		let lower = font.name.lower()
		let table = standardEncoding
		match baseName {
			case "WinAnsiEncoding":
				table = winAnsiEncoding
			case "MacRomanEncoding":
				table = macRomanEncoding
			case "StandardEncoding":
				table = standardEncoding
			default:
				if lower.startsWith("symbol") {
					table = symbolEncoding
				} else if subtype == "TrueType" || (flags & 4) != 0 {
					table = winAnsiEncoding
				}
		}
		let wingdings = lower.contains("wingdings") || lower.contains("webdings") || lower.contains("zapfdingbats")
		let bullet = byte[0xe2, 0x80, 0xa2]
		for let code = 0; code < 256; code++ {
			let out = byte[]
			if wingdings {
				out = bullet when code > 32
			} else if table[code] != 0 {
				out.append(char(table[code]))
			}
			font.texts.push(out)
		}
		if enc.kind == PdfKind.Dictionary {
			let differences = store.resolve(enc.get("Differences"))
			let code = 0
			for let (_, item) in differences.items {
				let entry = store.resolve(item)
				if entry.kind == PdfKind.Integer {
					code = int(entry.number)
				} else if entry.kind == PdfKind.Name {
					if code >= 0 && code < 256 {
						let found = glyphText(entry.name)
						font.texts[code] = found when found.len() > 0 || !wingdings
					}
					code++
				}
			}
		}
		let map = font.toUnicode
		if !(map is none) {
			for let code = 0; code < 256; code++ {
				let found = map.text(code)
				font.texts[code] = found unless found is none
			}
		}

		for let code = 0; code < 256; code++ {
			font.texts[code] = ligatures(font.texts[code]) when font.expandLigatures
		}

		let scale = 0.001
		if subtype == "Type3" {
			let matrix = store.resolve(dict.get("FontMatrix"))
			if matrix.kind == PdfKind.Array && matrix.items.len() >= 4 {
				scale = store.resolve(matrix.items[0]).number
				font.sizeScale = (store.resolve(matrix.items[3]).number * 1000.0).abs().clamp(0.05, 20.0)
			}
		}
		let missing = float(store.integer(descriptor, "MissingWidth")) * scale
		font.widths.len(256)
		let given = store.resolve(dict.get("Widths"))
		if given.kind == PdfKind.Array {
			for let code = 0; code < 256; code++ {
				font.widths[code] = missing
			}
			let first = store.integer(dict, "FirstChar")
			for let (k, item) in given.items {
				let code = first + k
				break when code >= 256
				font.widths[code] = store.resolve(item).number * scale when code >= 0
			}
			return
		}
		standardWidths(font, lower)
	}

	// standardWidths fills in the widths of one of the standard 14 fonts,
	// which files may use without giving widths.
	def standardWidths(font Font, lower string) {
		let bold = font.bold
		let italic = font.italic
		let table = helveticaWidths
		if font.mono {
			for let code = 0; code < 256; code++ {
				font.widths[code] = 0.6
			}
			return
		}
		let direct = false
		if lower.startsWith("symbol") {
			table = symbolWidths
			direct = true
		} else if lower.contains("dingbats") {
			table = zapfDingbatsWidths
			direct = true
		} else if lower.contains("times") || lower.contains("roman") || (lower.contains("serif") && !lower.contains("sans")) {
			table = bold ?? (italic ?? (timesBoldItalicWidths, timesBoldWidths), italic ?? (timesItalicWidths, timesWidths))
		} else {
			table = bold ?? (helveticaBoldWidths, helveticaWidths)
		}
		for let code = 0; code < 256; code++ {
			let index = direct ?? (code, winAnsiCode(font.texts[code]))
			let w = (index > 0) ?? (table[index], 0)
			font.widths[code] = float((w == 0) ?? (500, w)) / 1000.0
		}
	}

	// winAnsiCode returns the WinAnsi code of the first character of the
	// text, 0 when it has none.
	def winAnsiCode(text byte[]) int {
		return 0 when text.len() == 0
		let s = string(text)
		let code = int(s[0])
		return code when code < 128
		for let i = 128; i < 256; i++ {
			return i when winAnsiEncoding[i] == code
		}
		return 0
	}
}
