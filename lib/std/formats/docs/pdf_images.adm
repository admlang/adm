internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::*
		std.formats.image
	)

	// ImageStore turns the image XObjects pages draw into document resources,
	// each image once.
	type ImageStore {
		store     Store
		resources map<string, byte[]>
		names     map<int, string>
		count     int

		def new(store Store, resources map<string, byte[]>) {
			self.store = store
			self.resources = resources
			names = new map<int, string>()
		}

		// add stores the image and returns its resource name, empty when the
		// image cannot be converted.
		def add(obj PdfObject) string {
			let key = obj.objectNumber
			let known = names.get(key)
			return known unless known is none
			let name = convert(obj)
			names.set(key, name)
			return name
		}

		def convert(obj PdfObject) string {
			let filters = store.filterNames(store.resolve(obj.get("Filter")))
			let last = (filters.len() > 0) ?? (filters[filters.len() - 1], "")
			let data = store.decode(obj) onerror recover byte[]
			return "" when data.len() == 0
			match last {
				case "DCTDecode", "DCT":
					return save(data, ".jpg")
				case "JPXDecode":
					return save(data, ".jp2")
				case "JBIG2Decode", "CCITTFaxDecode", "CCF":
					return ""
				default:
			}
			return "" when store.resolve(obj.get("ImageMask")).boolean
			let png = rasterize(obj, data)
			return "" when png.len() == 0
			return save(png, ".png")
		}

		def save(data byte[], extension string) string {
			count++
			let name = "image{count}{extension}"
			resources.set(name, data)
			return name
		}

		// rasterize converts raw samples to PNG: gray, RGB, CMYK or indexed
		// colour, 1 to 8 bits per component. Empty for anything else.
		def rasterize(obj PdfObject, data byte[]) byte[] {
			let width = store.integer(obj, "Width")
			let height = store.integer(obj, "Height")
			let bits = store.integer(obj, "BitsPerComponent", 8)
			return byte[] when width <= 0 || height <= 0 || width * height > 40000000
			return byte[] unless bits := 1 || 2 || 4 || 8
			let space = store.resolve(obj.get("ColorSpace"))
			let palette = byte[]
			let components = colorComponents(space)
			if space.kind == PdfKind.Array && space.items.len() >= 4 && store.resolve(space.items[0]).name == "Indexed" {
				let base = colorComponents(store.resolve(space.items[1]))
				let lookup = store.resolve(space.items[3])
				palette = lookup.data
				if lookup.kind == PdfKind.Stream {
					palette = store.decode(lookup) onerror recover byte[]
				}
				palette = paletteRgb(palette, base)
				components = 1
			}
			return byte[] when components == 0
			let row = (width * components * bits + 7) / 8
			return byte[] when data.len() < row * height

			let img = new image.Image(width, height)
			let out = img.raw()
			let stride = img.stride()
			let max = (1 << bits) - 1
			for let y = 0; y < height; y++ {
				let rowStart = y * row
				for let x = 0; x < width; x++ {
					let o = y * stride + x * 4
					let s = x * components
					let c0 = sample(data, rowStart, s, bits)
					if palette.len() > 0 {
						let at = c0 * 3
						if at + 2 < palette.len() {
							out[o] = palette[at]
							out[o + 1] = palette[at + 1]
							out[o + 2] = palette[at + 2]
						}
					} else if components == 1 {
						let v = byte(c0 * 255 / max)
						out[o] = v
						out[o + 1] = v
						out[o + 2] = v
					} else if components == 3 {
						out[o] = byte(c0 * 255 / max)
						out[o + 1] = byte(sample(data, rowStart, s + 1, bits) * 255 / max)
						out[o + 2] = byte(sample(data, rowStart, s + 2, bits) * 255 / max)
					} else {
						let k = sample(data, rowStart, s + 3, bits) * 255 / max
						out[o] = byte((255 - c0 * 255 / max) * (255 - k) / 255)
						out[o + 1] = byte((255 - sample(data, rowStart, s + 1, bits) * 255 / max) * (255 - k) / 255)
						out[o + 2] = byte((255 - sample(data, rowStart, s + 2, bits) * 255 / max) * (255 - k) / 255)
					}
					out[o + 3] = 255
				}
			}
			applySoftMask(obj, out, stride, width, height)
			let png = new image.PNG()
			return png.encode(img) onerror recover byte[]
		}

		// applySoftMask copies an 8-bit gray soft mask of the same size into the
		// alpha channel.
		def applySoftMask(obj PdfObject, out byte[], stride int, width int, height int) {
			let mask = store.resolve(obj.get("SMask"))
			return unless mask.kind == PdfKind.Stream
			return unless store.integer(mask, "Width") == width && store.integer(mask, "Height") == height && store.integer(mask, "BitsPerComponent", 8) == 8
			let alpha = store.decode(mask) onerror recover byte[]
			return when alpha.len() < width * height
			for let y = 0; y < height; y++ {
				for let x = 0; x < width; x++ {
					out[y * stride + x * 4 + 3] = alpha[y * width + x]
				}
			}
		}

		// colorComponents returns the components of a colour space, 0 for one
		// that is not converted.
		def colorComponents(space PdfObject) int {
			let name = space.name
			if space.kind == PdfKind.Array && space.items.len() > 0 {
				name = store.resolve(space.items[0]).name
				if name == "ICCBased" && space.items.len() > 1 {
					let profile = store.resolve(space.items[1])
					return store.integer(profile, "N", 3)
				}
			}
			match name {
				case "DeviceGray", "CalGray", "G":
					return 1
				case "DeviceRGB", "CalRGB", "RGB":
					return 3
				case "DeviceCMYK", "CMYK":
					return 4
				case "":
					return 1
				default:
					return 0
			}
		}
	}

	// sample reads the component at the index of a row of packed samples.
	def sample(data byte[], rowStart int, index int, bits int) int {
		return int(data[rowStart + index]) when bits == 8
		let bit = index * bits
		let b = int(data[rowStart + bit / 8])
		return (b >> (8 - bits - bit % 8)) & ((1 << bits) - 1)
	}

	// paletteRgb returns an indexed palette as RGB triples.
	def paletteRgb(lookup byte[], components int) byte[] {
		return lookup when components == 3
		let out byte[]
		for let i = 0; i + components <= lookup.len(); i += components {
			if components == 1 {
				out.push(lookup[i], lookup[i], lookup[i])
			} else if components == 4 {
				let k = 255 - int(lookup[i + 3])
				out.push(byte((255 - int(lookup[i])) * k / 255), byte((255 - int(lookup[i + 1])) * k / 255), byte((255 - int(lookup[i + 2])) * k / 255))
			} else {
				out.push(0, 0, 0)
			}
		}
		return out
	}
}
