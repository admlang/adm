internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::*
		std.time
	)

	// Line is text on one baseline of one page, as runs left to right, or an
	// image standing on its own.
	type Line {
		runs    Run[]
		x       float
		x1      float
		y       float
		size    float
		page    int
		image   string
		// Heading level decided for the line, 0 for body text.
		level   int
		dropped bool

		def new(run Run) {
			runs = Run[run]
			x = run.x
			x1 = run.x1
			y = run.y
			size = run.size
			page = run.page
			image = run.image
		}

		// text returns the characters of the line, runs joined with a space
		// where they stand apart.
		def text() byte[] {
			let out = byte[]
			for let (i, run) in runs {
				out.push(32) when i > 0 && needsSpace(runs[i - 1], run)
				out.push(...run.text)
			}
			return out
		}

		// allMono reports whether every run is in a monospace font.
		def allMono() bool {
			for let (_, run) in runs {
				return false unless run.mono || isBlank(run.text)
			}
			return true
		}

		// allBold reports whether every run is bold.
		def allBold() bool {
			for let (_, run) in runs {
				return false unless run.bold || isBlank(run.text)
			}
			return true
		}
	}

	// needsSpace reports whether a space separates two runs of a line.
	def needsSpace(a Run, b Run) bool {
		return false when a.endsWithSpace() || (b.text.len() > 0 && b.text[0] == 32)
		return b.x - a.x1 > 0.15 * a.size.min(b.size)
	}

	// isBlank reports whether the text holds nothing but spaces.
	def isBlank(text byte[]) bool {
		for let i = 0; i < text.len(); i++ {
			return false unless text[i] == 32
		}
		return true
	}

	// endsSentence reports whether the text ends like a paragraph can.
	def endsSentence(text byte[]) bool {
		let i = text.len() - 1
		for i >= 0 && text[i] == 32 {
			i--
		}
		return false when i < 0
		let c = text[i]
		return c == 46 || c == 33 || c == 63 || c == 58 || (i >= 2 && text[i - 2] == 0xe2 && text[i - 1] == 0x80 && text[i] == 0x9d)
	}

	// extractDocument recovers the document of a PDF file.
	def extractDocument(store Store) Document {
		let doc = new Document()
		readMetadata(store, doc)
		let pages = store.pages()
		let images = new ImageStore(store, doc.resources)
		let interpreter = new Interpreter(store, images)
		let tops = float[]
		let bottoms = float[]
		for let (i, page) in pages {
			interpreter.links = pageLinks(store, page)
			interpreter.runPage(page, i)
			let box = store.resolve(page.get("CropBox"))
			box = store.resolve(page.get("MediaBox")) unless box.kind == PdfKind.Array && box.items.len() == 4
			if box.kind == PdfKind.Array && box.items.len() == 4 {
				let y0 = store.resolve(box.items[1]).number
				let y1 = store.resolve(box.items[3]).number
				bottoms.push(y0.min(y1))
				tops.push(y0.max(y1))
			} else {
				bottoms.push(0.0)
				tops.push(792.0)
			}
		}
		let lines = buildLines(interpreter.runs)
		dropFurniture(lines, tops, bottoms)
		let builder = new Layout(doc, lines, outlineLevels(store))
		builder.build()
		if doc.title == "" {
			for let (_, block) in doc.body.children {
				if block.kind == BlockKind.Heading && block.level == 1 {
					doc.title = block.plainText()
					break
				}
			}
		}
		return doc
	}

	// pageLinks returns the areas of the page's link annotations that carry
	// a URI.
	def pageLinks(store Store, page PdfObject) LinkArea[] {
		let out = LinkArea[]
		let annots = store.resolve(page.get("Annots"))
		return out unless annots.kind == PdfKind.Array
		for let (_, item) in annots.items {
			let annot = store.resolve(item)
			continue unless store.resolve(annot.get("Subtype")).name == "Link"
			let action = store.resolve(annot.get("A"))
			let uri = store.resolve(action.get("URI"))
			continue unless uri.kind == PdfKind.String
			let rect = store.resolve(annot.get("Rect"))
			continue unless rect.kind == PdfKind.Array && rect.items.len() == 4
			let area = new LinkArea(string(uri.data))
			let x0 = store.resolve(rect.items[0]).number
			let y0 = store.resolve(rect.items[1]).number
			let x1 = store.resolve(rect.items[2]).number
			let y1 = store.resolve(rect.items[3]).number
			area.left = x0.min(x1) - 1.0
			area.right = x0.max(x1) + 1.0
			area.bottom = y0.min(y1) - 2.0
			area.top = y0.max(y1) + 2.0
			out.push(area)
		}
		return out
	}

	// buildLines groups runs into lines: a run joins the line before it when
	// it continues it to the right on the same baseline, or sits just above
	// or below it in a smaller size.
	def buildLines(runs Run[]) Line[] {
		let lines = Line[]
		let current = new Line(new Run())
		let open = false
		for let (_, run) in runs {
			if run.image != "" {
				lines.push(new Line(run))
				open = false
				continue
			}
			if open && current.page == run.page {
				let dy = (run.y - current.y).abs()
				let size = run.size.max(current.size)
				let rightward = run.x >= current.x1 - 0.5 * size
				let shifted = run.size < 0.85 * current.size && dy < 0.6 * current.size
				if rightward && (dy < 0.35 * size || shifted) {
					current.runs.push(run)
					current.x1 = current.x1.max(run.x1)
					if run.size > current.size && !shifted {
						current.size = run.size
						current.y = run.y
					}
					continue
				}
			}
			current = new Line(run)
			lines.push(current)
			open = true
		}
		return lines
	}

	// dropFurniture marks page numbers and running heads and feet: among the
	// two top and two bottom lines of each page, those near the edge that are
	// a bare page number, or that repeat, digits aside, on many pages.
	def dropFurniture(lines Line[], tops float[], bottoms float[]) {
		let pages = tops.len()
		let candidates = int[]
		let keys = string[]
		let byPage = int[][]
		for let p = 0; p < pages; p++ {
			byPage.push(int[])
		}
		for let (i, line) in lines {
			byPage[line.page].push(i) when line.image == "" && line.page < pages
		}
		for let (p, indexes) in byPage {
			let sorted = indexes.clone().sort((a, b int) => lines[a].y > lines[b].y)
			let band = (tops[p] - bottoms[p]) * 0.15
			for let (k, index) in sorted {
				let line = lines[index]
				let edge = (k < 2 && line.y > tops[p] - band) || (k >= sorted.len() - 2 && line.y < bottoms[p] + band)
				continue unless edge
				candidates.push(index)
				keys.push(furnitureKey(line))
			}
		}
		let counts = new map<string, int>()
		for let (_, key) in keys {
			let seen = counts.get(key)
			counts.set(key, (seen is none) ?? (1, seen + 1))
		}
		for let (k, index) in candidates {
			let line = lines[index]
			let text = string(line.text()).trim()
			if isPageNumber(text) {
				line.dropped = true
				continue
			}
			let seen = counts.get(keys[k])
			line.dropped = true when text.len() <= 100 && pages >= 3 && !(seen is none) && seen >= 3 && seen * 2 >= pages
		}
	}

	// furnitureKey returns the line's text with digits masked and its height
	// on the page.
	def furnitureKey(line Line) string {
		let text = line.text()
		let masked = byte[]
		for let i = 0; i < text.len(); i++ {
			masked.push((text[i] >= 48 && text[i] <= 57) ?? (byte(35), text[i]))
		}
		return "{int(line.y / 3.0)}|{string(masked)}"
	}

	// isPageNumber reports whether the text is a page number: `12`, `- 12 -`,
	// `Page 12`, `12 of 30`, `xii`.
	def isPageNumber(text string) bool {
		let s = text.trim(" -–—").lower()
		return false when s == ""
		let roman = true
		for let (_, c) in s {
			roman = false unless c := 'i' || 'v' || 'x' || 'l' || 'c'
		}
		return true when roman && s.len() <= 7
		s = s.trimPrefix("page").trimPrefix("p.").trim()
		let parts = s.replace(" of ", "/").replace(" ", "").split("/")
		return false when parts.len() > 2
		for let (_, part) in parts {
			return false unless part.len() >= 1 && part.len() <= 4 && part.isNumeric()
		}
		return true
	}

	// outlineLevels returns the titles of the outline (bookmarks), normalized,
	// with their depth as heading level.
	def outlineLevels(store Store) map<string, int> {
		let out = new map<string, int>()
		let root = store.resolve(store.resolve(store.trailer.get("Root")).get("Outlines"))
		let seen = new map<int, bool>()
		walkOutline(store, root.get("First"), 1, out, seen)
		return out
	}

	def walkOutline(store Store, first ?PdfObject, level int, out map<string, int>, seen map<int, bool>) {
		let ref = first
		for let guard = 0; guard < 10000; guard++ {
			let current = ref
			return when current is none
			if current.kind == PdfKind.Reference {
				return when seen.hasKey(current.objectNumber)
				seen.set(current.objectNumber, true)
			}
			let item = store.resolve(current)
			return unless item.kind == PdfKind.Dictionary
			let title = normalizeTitle(store.resolve(item.get("Title")).text())
			out.set(title, level.min(6)) unless title == "" || out.hasKey(title)
			walkOutline(store, item.get("First"), level + 1, out, seen) when level < 6
			ref = item.get("Next")
		}
	}

	// normalizeTitle lowercases the text and collapses its white space.
	def normalizeTitle(text string) string {
		return text.lower().words().join(" ")
	}

	// readMetadata fills the title, authors, date, language and metadata from
	// the information dictionary and the XMP metadata.
	def readMetadata(store Store, doc Document) {
		let info = store.resolve(store.trailer.get("Info"))
		let root = store.resolve(store.trailer.get("Root"))
		if info.kind == PdfKind.Dictionary {
			doc.title = store.resolve(info.get("Title")).text().trim()
			let author = store.resolve(info.get("Author")).text()
			for let (_, name) in author.split(";") {
				doc.authors.push(name.trim()) unless name.trim() == ""
			}
			for let (_, key) in string["Subject", "Keywords", "Creator", "Producer"] {
				let value = store.resolve(info.get(key)).text().trim()
				doc.metadata.set(key.lower(), value) unless value == ""
			}
			doc.date = pdfDate(store.resolve(info.get("CreationDate")).text())
			let modified = pdfDate(store.resolve(info.get("ModDate")).text())
			doc.metadata.set("modified", modified.str()) unless modified is none
		}
		let lang = store.resolve(root.get("Lang")).text().trim()
		doc.language = lang unless lang == ""

		let metadata = store.resolve(root.get("Metadata"))
		return unless metadata.kind == PdfKind.Stream
		let body = store.decode(metadata) onerror recover byte[]
		let xmp = string(body)
		if doc.title == "" {
			let titles = xmpItems(xmp, "dc:title")
			doc.title = titles[0] when titles.len() > 0
		}
		doc.authors = xmpItems(xmp, "dc:creator") when doc.authors.len() == 0
		if doc.language == "" {
			let languages = xmpItems(xmp, "dc:language")
			doc.language = languages[0] when languages.len() > 0
		}
		if doc.date is none {
			let created = xmpItems(xmp, "xmp:CreateDate")
			doc.date = parseStamp(created[0]) when created.len() > 0
		}
		if !doc.metadata.hasKey("subject") {
			let described = xmpItems(xmp, "dc:description")
			doc.metadata.set("subject", described[0]) when described.len() > 0
		}
		if !doc.metadata.hasKey("keywords") {
			let keywords = xmpItems(xmp, "pdf:Keywords")
			doc.metadata.set("keywords", keywords[0]) when keywords.len() > 0
		}
	}

	// xmpItems returns the values of an XMP property: its `rdf:li` items, or
	// its text, or its attribute form `tag="…"`.
	def xmpItems(xmp string, tag string) string[] {
		let out = string[]
		let open = xmp.indexOf("<" + tag)
		if open < 0 {
			let attribute = xmp.indexOf(tag + "=\"")
			return out when attribute < 0
			let start = attribute + tag.len() + 2
			let end = xmp.indexOf("\"", start)
			out.push(xmlText(xmp.slice(start, end))) when end > start
			return out
		}
		let bodyStart = xmp.indexOf(">", open)
		let close = xmp.indexOf("</" + tag, open)
		return out when bodyStart < 0 || close < bodyStart
		let inner = xmp.slice(bodyStart + 1, close)
		let at = inner.indexOf("<rdf:li")
		if at < 0 {
			let value = xmlText(inner).trim()
			out.push(value) unless value == ""
			return out
		}
		for at >= 0 {
			let start = inner.indexOf(">", at)
			let end = inner.indexOf("</rdf:li>", at)
			break when start < 0 || end < start
			let value = xmlText(inner.slice(start + 1, end)).trim()
			out.push(value) unless value == ""
			at = inner.indexOf("<rdf:li", end)
		}
		return out
	}

	// xmlText resolves the five predefined entities and numeric references.
	def xmlText(text string) string {
		return text unless text.contains("&")
		let out = text.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&apos;", "'")
		for out.contains("&#") {
			let at = out.indexOf("&#")
			let end = out.indexOf(";", at)
			break when end < 0
			let digits = out.slice(at + 2, end)
			let code = digits.startsWith("x") ?? (parseInt<int>(digits.slice(1), 16), parseInt<int>(digits))
			out = out.slice(0, at) + string(char(code)) + out.slice(end + 1)
		}
		return out.replace("&amp;", "&")
	}

	// pdfDate reads a PDF date `D:YYYYMMDDHHmmSSOHH'mm'`, where every part
	// after the year may be missing. None when it is not one.
	def pdfDate(value string) ?time.Time {
		let s = value.trim().trimPrefix("D:")
		let b = s.bytes()
		let digits = 0
		for digits < b.len() && digits < 14 && b[digits] >= 48 && b[digits] <= 57 {
			digits++
		}
		return none when digits < 4
		let parts = string["0000", "01", "01", "00", "00", "00"]
		let widths = int[4, 2, 2, 2, 2, 2]
		let at = 0
		for let (i, width) in widths {
			break when at + width > digits
			parts[i] = s.slice(at, at + width)
			at += width
		}
		let zone = "Z"
		if digits < b.len() && (b[digits] == 43 || b[digits] == 45) {
			let rest = s.slice(digits + 1).replace("'", "")
			if rest.len() >= 2 {
				let minutes = (rest.len() >= 4) ?? (rest.slice(2, 4), "00")
				zone = s.slice(digits, digits + 1) + rest.slice(0, 2) + ":" + minutes
			}
		}
		let stamp = "{parts[0]}-{parts[1]}-{parts[2]}T{parts[3]}:{parts[4]}:{parts[5]}{zone}"
		return parseStamp(stamp)
	}

	// parseStamp reads an RFC 3339 timestamp, none when it is not one.
	def parseStamp(stamp string) ?time.Time {
		return time.parse(stamp) onerror (e error) {
			return none
		}
	}
}
