partial module std.formats.docs {
	use (
		std.formats.docs.pdf::*
		std.gfx::Raster
	)

	// PdfKind names what a PdfObject is. Each member lists the PdfObject fields
	// it uses; the others keep their zero value.
	enum PdfKind {
		// The null object, also what a missing object resolves to.
		Null,
		// Uses `boolean`.
		Boolean,
		// Uses `number`.
		Integer,
		// Uses `number`.
		Real,
		// A byte string. Uses `data`; `text()` reads it as a text string.
		String,
		// Uses `name`.
		Name,
		// Uses `items`.
		Array,
		// Uses `entries`.
		Dictionary,
		// Uses `entries` for the stream dictionary, `data` for the content as
		// stored, still encoded, and `objectNumber` and `generation` for the
		// indirect object it was read from.
		Stream,
		// A reference to an indirect object. Uses `objectNumber` and
		// `generation`.
		Reference,
	}

	// PdfObject is one value of the PDF object syntax: a number, a string, a
	// name, an array, a dictionary, a stream or a reference to an indirect
	// object, as `kind` says.
	type PdfObject {
		kind         PdfKind
		boolean      bool
		number       float
		// A name without its slash, `#xx` escapes resolved.
		name         string
		data         byte[]
		items        PdfObject[]
		entries      map<string, PdfObject>
		objectNumber int
		generation   int

		def new(kind PdfKind = PdfKind.Null) {
			self.kind = kind
			data = byte[]
			items = PdfObject[]
			entries = new map<string, PdfObject>()
		}

		// get returns the entry of a Dictionary or of a Stream's dictionary,
		// none when there is no such key. A Reference is returned as is; see
		// PdfFile.resolve.
		def get(key string) ?PdfObject {
			return entries.get(key)
		}

		// text returns a String read as a PDF text string (UTF-16 or UTF-8 when
		// it starts with a byte order mark, PDFDocEncoding otherwise), the name
		// of a Name, and an empty string for any other kind.
		def text() string {
			return name when kind == PdfKind.Name
			return "" unless kind == PdfKind.String
			return textString(data)
		}

		// isNull reports whether the object is the null object.
		def isNull() bool {
			return kind == PdfKind.Null
		}
	}

	// PdfFile is the object layer of a PDF file: its cross-reference data, its
	// trailer and every indirect object, read on demand and decrypted when the
	// file is encrypted. `Pdf.open` returns one.
	//
	// Example: List the page sizes
	// ```example
	// use std.formats.docs::(Pdf)
	// use std.os
	//
	// let file = try new Pdf().open(try os.readFile("report.pdf"))
	// for let (i, page) in file.pages() {
	//     let box = file.resolve(page.get("MediaBox"))
	//     println("page {i + 1}: {box.items[2].number} x {box.items[3].number}")
	// }
	// ```
	type PdfFile {
		// Version in the header, "1.7" for `%PDF-1.7`, empty when the header is
		// missing.
		version   string
		// The trailer dictionary of the newest revision, with the entries of
		// older revisions it does not repeat.
		trailer   PdfObject
		// Whether the file is encrypted. Objects come back decrypted.
		encrypted bool

		internal store Store

		internal def new(store Store) {
			self.store = store
			version = store.version
			trailer = store.trailer
			encrypted = !(store.security is none)
		}

		// object returns the indirect object with the number, none when the
		// file has no such object or it does not parse.
		def object(number int) ?PdfObject {
			return store.object(number)
		}

		// resolve follows references until it reaches a direct value. A
		// missing value or a reference to a missing object gives the null
		// object.
		def resolve(value ?PdfObject) PdfObject {
			return store.resolve(value)
		}

		// decode returns the content of a stream with its filters undone:
		// FlateDecode and LZWDecode (with their predictors), ASCIIHexDecode,
		// ASCII85Decode and RunLengthDecode. Image filters (DCTDecode,
		// JPXDecode, JBIG2Decode, CCITTFaxDecode) end the chain, so a JPEG comes
		// back as JPEG bytes. Damaged compressed data decodes as far as it goes.
		// Fails when the value is not a stream or a filter is unknown.
		def decode(stream PdfObject) !byte[] {
			return store.decode(stream)
		}

		// root returns the document catalog, the null object when the file has
		// none.
		def root() PdfObject {
			return store.resolve(trailer.get("Root"))
		}

		// info returns the document information dictionary, the null object
		// when the file has none.
		def info() PdfObject {
			return store.resolve(trailer.get("Info"))
		}

		// pages returns the page dictionaries in page order, each with the
		// inheritable entries (Resources, MediaBox, CropBox, Rotate) it takes
		// from its ancestors filled in.
		def pages() PdfObject[] {
			return store.pages()
		}

		// Reports embedded signature data, not cryptographic validity or trust.
		// Empty signature fields and all-zero signing placeholders do not count.
		def isSigned() bool {
			return new SignatureReader(store).collect().len() > 0
		}

		// Reads digital signatures reachable from the current form/catalog.
		// Returns PDF metadata, byte ranges, CMS signers and X.509 certificates.
		// Malformed/unsupported payloads retain their metadata with warnings.
		// Does not verify signatures, certificate trust, revocation or timestamps.
		def signatures() PdfSignature[] {
			let found = new SignatureReader(store).collect()
			for let signature in found {
				readSignatureDetails(store, signature)
			}
			return found
		}

		// Paints selected pages into one RGBA raster. None selects every page;
		// an explicit array preserves its order and duplicates. An empty array
		// produces a 0 x 0 raster. Pass page objects from this file's pages().
		// Default: a vertical list of 800-pixel-wide pages with thin borders.
		// Fails for invalid options/pages, decoding errors or an output larger
		// than options.maxPixels. Unsupported painting features are reported
		// through options.onWarning. The receiver and page objects are unchanged.
		def render(pages ?PdfObject[] = none, options PdfRenderOptions = PdfRenderOptions{}) !Raster {
			if pages is none {
				return renderPages(store, self.pages(), options)
			}
			return renderPages(store, pages, options)
		}
	}
}
