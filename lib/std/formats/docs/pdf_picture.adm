internal partial module std.formats.docs.pdf {
	use (
		std.formats.fonts
		std.gfx
		std.gfx::(Mask, Raster)
		std.gfx.canvas::(Blur, Border, Canvas, ColorSpace, ColorStop, Composite, ConicGradient, DrawContext, DrawState, Effect, LinearGradient, MeshGradient, Paint, Painter, Paragraph, Pattern, Picture, RadialGradient, Sampling, Spread, TextMetrics, TextOrientation, TextStyle)
		std.gfx.color::(BlendMode, Color, RGBA)
		std.math::(Tau, cos, sin, sqrt, tan)
		std.math.geom as geom
		std.math.geom::(Circle, Corners, Edges, FillRule, LineCap, LineJoin, Path, PathVerb, Point, Rect, Size, StrokeStyle, Transform2D)
		std.units::(FontRelative, Percent, Pixels)
	)

	// The resource categories, in the order the shared dictionary lists them.
	const resourceKinds = string["ExtGState", "Pattern", "Shading", "XObject", "Font"]

	// An image XObject already in the file: its pixels, to share it.
	struct PdfImage {
		width  int
		height int
		pixels byte[]
		smooth bool
		name   string
	}

	// One glyph of a Type 3 font: its code, the text it stands for, and the
	// face's glyph.
	struct PdfGlyph {
		glyph fonts.GlyphID
		text  string
	}

	// A Type 3 font made of a face's outlines: up to 256 glyphs, each code
	// one glyph standing for one piece of text.
	type PdfType3 {
		name   string
		object int
		glyphs PdfGlyph[]

		def new(name string, object int) {
			self.name = name
			self.object = object
		}
	}

	// The Type 3 fonts written for one face, and where each glyph went.
	type PdfFace {
		face  fonts.Face
		fonts PdfType3[]
		// "glyph/text" to font index * 256 + code.
		codes map<string, int>

		def new(face fonts.Face) {
			self.face = face
		}
	}

	// PdfOut is the file a picture becomes: its objects, and the named
	// resources content streams use.
	type PdfOut {
		// Object bodies, object n at index n - 1.
		objects byte[][]
		// A resource name's category and object.
		kinds   map<string, string>
		numbers map<string, int>
		gstates map<string, string>
		names   int
		images  PdfImage[]
		faces   PdfFace[]

		def new() {}

		def reserve() int {
			objects.push(byte[])
			return objects.len()
		}

		def set(number int, body string) {
			objects[number - 1] = body.bytes()
		}

		def add(body string) int {
			let n = reserve()
			set(n, body)
			return n
		}

		// A compressed stream object.
		def stream(dict string, data byte[]) int {
			let n = reserve()
			setStream(n, dict, data)
			return n
		}

		def setStream(n int, dict string, data byte[]) {
			let packed = deflate(data)
			let out = "<<{dict}/Filter/FlateDecode/Length {packed.len()}>>stream\n".bytes()
			out.push(...packed)
			out.push(..."\nendstream".bytes())
			objects[n - 1] = out
		}

		// A new resource name for the object.
		def resource(kind string, prefix string, object int) string {
			names++
			let name = "{prefix}{names}"
			kinds[name] = kind
			numbers[name] = object
			return name
		}

		// The resource dictionary of a content stream: the resources its
		// operators name, and no others, so no stream lists itself.
		def resourcesOf(content string) string {
			let raw = content.bytes()
			let found map<string, string>
			let seen map<string, bool>
			let i = 0
			for i < raw.len() {
				if raw[i] != 47 {
					i++
					continue
				}
				let j = i + 1
				for j < raw.len() && ((raw[j] >= 48 && raw[j] <= 57) || (raw[j] >= 65 && raw[j] <= 90) || (raw[j] >= 97 && raw[j] <= 122)) {
					j++
				}
				let name = string(raw[i + 1:j])
				if kinds.hasKey(name) && !seen.hasKey(name) {
					seen[name] = true
					let kind = kinds[name]
					let had = found.hasKey(kind) ?? (found[kind], "")
					found[kind] = had + "/{name} {numbers[name]} 0 R"
				}
				i = j
			}
			let dict = "<<"
			for let (_, kind) in resourceKinds {
				dict += "/{kind}<<{found[kind]}>>" when found.hasKey(kind)
			}
			return dict + ">>"
		}

		// The graphics state dictionary's name, one per distinct body.
		def gs(body string) string {
			return gstates[body] when gstates.hasKey(body)
			let name = resource("ExtGState", "G", add("<</Type/ExtGState{body}>>"))
			gstates[body] = name
			return name
		}

		// A form XObject of the content, drawn with the shared resources.
		def form(content string, box Rect, group string) string {
			let n = stream("/Type/XObject/Subtype/Form/BBox[{boxOf(box)}]{group}/Resources {resourcesOf(content)}", content.bytes())
			return resource("XObject", "X", n)
		}

		// An image XObject of the straight RGBA pixels, with a soft mask
		// when any is translucent; equal pixels share one object.
		def image(pixels byte[], w int, h int, smooth bool) string {
			for let (_, im) in images {
				return im.name when im.width == w && im.height == h && im.smooth == smooth && sameBytes(im.pixels, pixels)
			}
			let rgb byte[]
			rgb.len(w * h * 3)
			let alpha byte[]
			alpha.len(w * h)
			let opaque = true
			for let i = 0; i < w * h; i++ {
				rgb[i * 3] = pixels[i * 4]
				rgb[i * 3 + 1] = pixels[i * 4 + 1]
				rgb[i * 3 + 2] = pixels[i * 4 + 2]
				alpha[i] = pixels[i * 4 + 3]
				opaque = false when pixels[i * 4 + 3] != 255
			}
			let interpolate = smooth ?? ("/Interpolate true", "")
			let mask = ""
			if !opaque {
				let m = stream("/Type/XObject/Subtype/Image/Width {w}/Height {h}/ColorSpace/DeviceGray/BitsPerComponent 8{interpolate}", alpha)
				mask = "/SMask {m} 0 R"
			}
			let n = stream("/Type/XObject/Subtype/Image/Width {w}/Height {h}/ColorSpace/DeviceRGB/BitsPerComponent 8{interpolate}{mask}", rgb)
			let name = resource("XObject", "I", n)
			images.push(PdfImage{width: w, height: h, pixels: pixels, smooth: smooth, name: name})
			return name
		}

		// The font and code that show the glyph standing for `text`.
		def glyphCode(face fonts.Face, glyph fonts.GlyphID, text string) (string, int) {
			let at = -1
			for let (i, known) in faces {
				if known.face == face {
					at = i
					break
				}
			}
			if at < 0 {
				faces.push(new PdfFace(face))
				at = faces.len() - 1
			}
			let f = faces[at]
			let key = "{int(glyph)}/{text}"
			if f.codes.hasKey(key) {
				let known = f.codes[key]
				return (f.fonts[known / 256].name, known % 256)
			}
			if f.fonts.len() == 0 || f.fonts[f.fonts.len() - 1].glyphs.len() == 256 {
				let n = reserve()
				f.fonts.push(new PdfType3(resource("Font", "T", n), n))
			}
			let last = f.fonts.len() - 1
			let t3 = f.fonts[last]
			let code = t3.glyphs.len()
			t3.glyphs.push(PdfGlyph{glyph: glyph, text: text})
			f.codes[key] = last * 256 + code
			return (t3.name, code)
		}

		// Writes the Type 3 fonts: each glyph's outline in font units, y up,
		// filled in the text's paint.
		def writeFonts() {
			for let (_, f) in faces {
				let face = f.face
				let upm = float(face.info().unitsPerEm).max(1.0)
				for let (_, t3) in f.fonts {
					let procs = ""
					let diffs = ""
					let widths string[]
					let (
						bx0 = 0.0
						by0 = 0.0
						bx1 = 0.0
						by1 = 0.0
					)
					for let (code, g) in t3.glyphs {
						let gm = face.metrics(g.glyph) onerror recover fonts.GlyphMetrics{}
						let b = gm.bounds
						let outline = face.outline(g.glyph) onerror recover new fonts.Outline()
						let path = outline.path(1.0).transformed(new Transform2D(d = -1.0))
						let body = "{pdfNumber(float(gm.advance))} 0 {pdfNumber(b.left)} {pdfNumber(b.top)} {pdfNumber(b.right)} {pdfNumber(b.bottom)} d1\n"
						let ops = pathOps(path)
						body += ops + "f\n" unless ops == ""
						let proc = stream("", body.bytes())
						procs += "/g{code} {proc} 0 R"
						diffs += "/g{code}"
						widths.push(pdfNumber(float(gm.advance)))
						bx0 = bx0.min(b.left)
						by0 = by0.min(b.top)
						bx1 = bx1.max(b.right)
						by1 = by1.max(b.bottom)
					}
					let unicode = stream("", toUnicode(t3.glyphs).bytes())
					let k = pdfNumber(1.0 / upm)
					set(t3.object, "<</Type/Font/Subtype/Type3/FontBBox[{pdfNumber(bx0)} {pdfNumber(by0)} {pdfNumber(bx1)} {pdfNumber(by1)}]/FontMatrix[{k} 0 0 {k} 0 0]/CharProcs<<{procs}>>/Encoding<</Type/Encoding/Differences[0{diffs}]>>/FirstChar 0/LastChar {t3.glyphs.len() - 1}/Widths[{widths.join(" ")}]/Resources<<>>/ToUnicode {unicode} 0 R>>")
				}
			}
		}

		// The finished file: one page of the content, `width` by `height`
		// points.
		def file(content string, width int, height int) byte[] {
			writeFonts()
			let contents = stream("", content.bytes())
			let pages = reserve()
			let page = add("<</Type/Page/Parent {pages} 0 R/MediaBox[0 0 {width} {height}]/Resources {resourcesOf(content)}/Contents {contents} 0 R/Group<</S/Transparency/CS/DeviceRGB>>>>")
			set(pages, "<</Type/Pages/Kids[{page} 0 R]/Count 1>>")
			let catalog = add("<</Type/Catalog/Pages {pages} 0 R>>")
			let info = add("<</Producer(ADM std.gfx.canvas)>>")
			let out = "%PDF-1.7\n%".bytes()
			out.push(0xe2, 0xe3, 0xcf, 0xd3, 10)
			let offsets = int[]
			for let (i, body) in objects {
				offsets.push(out.len())
				out.push(..."{i + 1} 0 obj\n".bytes())
				out.push(...body)
				out.push(..."\nendobj\n".bytes())
			}
			let xref = out.len()
			out.push(..."xref\n0 {objects.len() + 1}\n0000000000 65535 f \n".bytes())
			for let (_, offset) in offsets {
				out.push(..."{offset.str().padStart(10, "0")} 00000 n \n".bytes())
			}
			out.push(..."trailer\n<</Size {objects.len() + 1}/Root {catalog} 0 R/Info {info} 0 R>>\nstartxref\n{xref}\n%%EOF\n".bytes())
			return out
		}
	}

	// The ToUnicode map of a Type 3 font's codes; glyphs that stand for no
	// text of their own (the second glyph of a cluster) are left out.
	def toUnicode(glyphs PdfGlyph[]) string {
		let entries string[]
		for let (code, g) in glyphs {
			continue when g.text == ""
			let utf16 = ""
			for let (_, c) in g.text {
				let v = int(c)
				if v >= 0x10000 {
					let w = v - 0x10000
					utf16 += hex4(0xd800 + (w >> 10)) + hex4(0xdc00 + (w & 0x3ff))
				} else {
					utf16 += hex4(v)
				}
			}
			entries.push("<{uint8(code).hex(2)}> <{utf16}>")
		}
		let out = "/CIDInit /ProcSet findresource begin\n12 dict begin\nbegincmap\n/CIDSystemInfo<</Registry(Adobe)/Ordering(UCS)/Supplement 0>>def\n/CMapName/Adobe-Identity-UCS def\n/CMapType 2 def\n1 begincodespacerange\n<00> <FF>\nendcodespacerange\n"
		for let at = 0; at < entries.len(); at += 100 {
			let block = entries[at:(at + 100).min(entries.len())]
			out += "{block.len()} beginbfchar\n{block.join("\n")}\nendbfchar\n"
		}
		return out + "endcmap\nCMapName currentdict /CMap defineresource pop\nend\nend\n"
	}

	// One piece of a content stream: operators as they are, a clip whose
	// operators run inside q … Q around its children, or a soft mask whose
	// children become a form drawn through it.
	type PdfNode {
		raw  string
		head string
		// The graphics state holding the soft mask; children go in a form.
		mask string
		box  Rect
		kids PdfNode[]

		def new(raw string = "", head string = "") {
			self.raw = raw
			self.head = head
			mask = ""
			box = Rect{}
		}

		def add(n PdfNode) PdfNode {
			kids.push(n)
			return n
		}

		def text(out PdfOut) string {
			return raw when raw != ""
			let parts string[]
			for let (_, k) in kids {
				parts.push(k.text(out))
			}
			let body = parts.join("")
			if mask != "" {
				return "" when body == ""
				let form = out.form(body, box, "/Group<</S/Transparency/CS/DeviceRGB>>")
				return "q /{mask} gs /{form} Do Q\n"
			}
			return body when head == ""
			return "q\n{head}{body}Q\n"
		}
	}

	// A clip in force: what its node opens with, and the call that redoes
	// it on a painter (for the rasterized parts).
	type PdfClip {
		id    int
		head  string
		mask  string
		apply def(Painter)

		def new(id int, head string, mask string, apply def(Painter)) {
			self.id = id
			self.head = head
			self.mask = mask
			self.apply = apply
		}
	}

	// The page or a group being written: its node, the clip nodes open in
	// it, and every drawing call since it began (to rasterize what PDF
	// cannot say).
	type PdfFrame {
		container PdfNode
		opens     PdfNode[]
		openClips PdfClip[]
		active    PdfClip[]
		saved     PdfClip[][]
		history   DrawContext
		// The group's own settings; unused for the page.
		opacity   float
		blend     BlendMode
		effects   Effect[]
		mask      ?Mask
		bounds    ?Rect
		start     DrawState
		outer     PdfClip[]

		def new(container PdfNode, history DrawContext) {
			self.container = container
			self.history = history
			opacity = 1.0
			blend = BlendMode.Normal
			mask = none
			bounds = none
			start = DrawState{}
		}

		def node() PdfNode {
			return opens.len() > 0 ?? (opens[opens.len() - 1], container)
		}

		// Whether what is added now lands inside a form XObject.
		def inForm() bool {
			for let (_, c) in openClips {
				return true when c.mask != ""
			}
			return false
		}
	}

	// What a paint becomes: the operators that select it (a colour or a
	// tiling pattern) or the shading to paint inside the shape (gradients),
	// its own constant opacity, and the soft mask that carries its varying
	// opacity.
	struct PdfPaint {
		ops     string
		shading string = ""
		alpha   float  = 1.0
		smask   string = ""
	}

	// PdfWriter is a Painter that writes PDF: every call becomes content
	// stream operators, with one unit a point, and what PDF cannot express
	// (Porter-Duff operators, some blend modes, noise, layer effects, mesh
	// warps) becomes an image of just the pixels it changes, rendered by
	// the canvas itself.
	type PdfWriter {
		out    PdfOut
		width  int
		height int
		root   PdfNode
		frames PdfFrame[]
		nextId int
		// The page's default space from the drawing's: y flipped on a page,
		// the identity in a pattern cell.
		top    Transform2D

		def new(out PdfOut, width int, height int, page bool = true) {
			self.out = out
			self.width = width.max(1)
			self.height = height.max(1)
			root = new PdfNode()
			nextId = 0
			top = page ?? (new Transform2D(d = -1.0, ty = float(self.height)), new Transform2D())
			frames.push(new PdfFrame(root, new DrawContext(new Size(self.width, self.height))))
		}

		// The content, in the drawing's coordinates.
		def content() string {
			return root.text(out)
		}

		// The finished file.
		def file() byte[] {
			return out.file("1 0 0 -1 0 {height} cm\n" + content(), width, height)
		}

		def frame() PdfFrame {
			return frames[frames.len() - 1]
		}

		def box() Rect {
			return Rect{left: 0.0, top: 0.0, right: float(width), bottom: float(height)}
		}

		// Sends the call to every open frame's history.
		def forward(call def(Painter)) {
			for let (_, f) in frames {
				call(f.history)
			}
		}

		// Painter: state.

		def clear(c Color) {
			forward((p Painter) => p.clear(c))
			// Every pixel of the frame becomes the colour: what it held goes.
			let f = frame()
			f.container.kids.len(0)
			f.opens.len(0)
			f.openClips.len(0)
			let rgba = c.rgba
			if rgba.a > 0 {
				let alpha = rgba.a == 255 ?? ("", "/{out.gs("/ca {pdfNumber(float(rgba.a) / 255.0)}")} gs ")
				f.container.add(new PdfNode("q {alpha}{colorOps(rgba, "rg")}0 0 {width} {height} re f Q\n"))
			}
			syncClips(f)
		}

		def save() {
			forward((p Painter) => p.save())
			let f = frame()
			f.saved.push(copyClips(f.active))
		}

		def restore() {
			forward((p Painter) => p.restore())
			let f = frame()
			if f.saved.len() > 0 {
				f.active = f.saved.pop()
			}
			syncClips(f)
		}

		def state() DrawState {
			return frame().history.state()
		}

		def setState(s DrawState) {
			forward((p Painter) => p.setState(s))
			let f = frame()
			f.active.len(0)
			syncClips(f)
		}

		def translate(dx, dy float) {
			forward((p Painter) => p.translate(dx, dy))
		}

		def rotate(angle float, around Point = new Point(0.0, 0.0)) {
			forward((p Painter) => p.rotate(angle, around))
		}

		def scale(sx, sy float) {
			forward((p Painter) => p.scale(sx, sy))
		}

		def transform(t Transform2D) {
			forward((p Painter) => p.transform(t))
		}

		def setTransform(t Transform2D) {
			forward((p Painter) => p.setTransform(t))
		}

		def resetTransform() {
			forward((p Painter) => p.resetTransform())
		}

		def clip(path Path, rule FillRule = FillRule.NonZero, antialias bool = true) {
			forward((p Painter) => p.clip(path, rule, antialias))
			let t = copyTransform(state().transform)
			let ops = pathOps(path.transformed(t))
			let head = ops == "" ?? ("0 0 m h W n\n", ops + (rule == FillRule.EvenOdd ?? ("W* n\n", "W n\n")))
			pushClip(head, "", (p Painter) => {
				p.setTransform(t)
				p.clip(path, rule, antialias)
			})
		}

		def clip(rect Rect) {
			clip(new Path().rect(rect))
		}

		def clip(mask Mask) {
			forward((p Painter) => p.clip(mask))
			pushClip("", out.gs(maskOf(mask)), (p Painter) => p.clip(mask))
		}

		def setAlpha(alpha float | Percent) {
			forward((p Painter) => p.setAlpha(alpha))
		}

		def setComposite(op Composite) {
			forward((p Painter) => p.setComposite(op))
		}

		def setBlend(mode BlendMode) {
			forward((p Painter) => p.setBlend(mode))
		}

		def setAntialias(on bool) {
			forward((p Painter) => p.setAntialias(on))
		}

		def setSampling(s Sampling) {
			forward((p Painter) => p.setSampling(s))
		}

		def tag(id int) {
			forward((p Painter) => p.tag(id))
		}

		// Painter: shapes.

		def fill(path Path, paint Paint, rule FillRule = FillRule.NonZero) {
			forward((p Painter) => p.fill(path, paint, rule))
			shape(path, paint, rule, none, (p Painter) => p.fill(path, paint, rule))
		}

		def stroke(path Path, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			forward((p Painter) => p.stroke(path, paint, strokeStyle))
			shape(path, paint, FillRule.NonZero, strokeStyle, (p Painter) => p.stroke(path, paint, strokeStyle))
		}

		def fill(rect Rect, paint Paint) {
			fill(new Path().rect(rect), paint)
		}

		def fill(rect Rect, radius float, paint Paint) {
			fill(new Path().roundRect(rect, radius * 1(px)), paint)
		}

		def stroke(rect Rect, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(new Path().rect(rect), paint, strokeStyle)
		}

		// The clips and fills the canvas draws borders with.
		def stroke(rect Rect, borders Edges<Border>, radius Corners<Pixels> = new Corners<Pixels>(0(px))) {
			let ctx = new DrawContext()
			ctx.setTransform(state().transform)
			ctx.stroke(rect, borders, radius)
			ctx.replay(self)
		}

		def fill(circle Circle, paint Paint) {
			fill(new Path().circle(circle.center, circle.radius), paint)
		}

		def stroke(line geom.Line, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(new Path().moveTo(line.start.x, line.start.y).lineTo(line.end.x, line.end.y), paint, strokeStyle)
		}

		// Painter: images.

		def drawImage(src Raster, at Point) {
			let size = src.size()
			drawImage(src, Rect{left: 0.0, top: 0.0, right: float(size.width), bottom: float(size.height)}, Rect{left: at.x, top: at.y, right: at.x + float(size.width), bottom: at.y + float(size.height)}, state().sampling)
		}

		def drawImage(src Raster, dest Rect, sampling = Sampling.Bilinear) {
			let size = src.size()
			drawImage(src, Rect{left: 0.0, top: 0.0, right: float(size.width), bottom: float(size.height)}, dest, sampling)
		}

		def drawImage(src Raster, source Rect, dest Rect, sampling = Sampling.Bilinear) {
			forward((p Painter) => p.drawImage(src, source, dest, sampling))
			let draw = (p Painter) => p.drawImage(src, source, dest, sampling)
			let st = state()
			if needsBackdrop(st) {
				backdropPatch(draw)
				return
			}
			if !wholeRect(source) {
				selfPatch(draw)
				return
			}
			let name = imageOf(src, int(source.left), int(source.top), int(source.right - source.left), int(source.bottom - source.top), sampling != Sampling.Nearest, none)
			return when name == ""
			let place = "{pdfNumber(dest.right - dest.left)} 0 0 {pdfNumber(dest.top - dest.bottom)} {pdfNumber(dest.left)} {pdfNumber(dest.bottom)} cm"
			frame().node().add(new PdfNode("q\n{cmOf(st.transform)}{stateGs(st, 1.0, "")}{place} /{name} Do\nQ\n"))
		}

		// Mesh warps have no PDF form: the canvas's pixels.
		def drawImage(src Raster, mesh Point[][], sampling = Sampling.Bilinear) {
			forward((p Painter) => p.drawImage(src, mesh, sampling))
			let draw = (p Painter) => p.drawImage(src, mesh, sampling)
			if needsBackdrop(state()) {
				backdropPatch(draw)
				return
			}
			selfPatch(draw)
		}

		// Sprites as image XObjects, one per distinct source rectangle and
		// tint (the tint multiplied into the pixels), each drawn through its
		// transform. Sources off whole pixels are pixels, as drawImage's are.
		def drawAtlas(src Raster, sources Rect[], transforms Transform2D[], colors Color[] = []) {
			forward((p Painter) => p.drawAtlas(src, sources, transforms, colors))
			let draw = (p Painter) => p.drawAtlas(src, sources, transforms, colors)
			let st = state()
			if needsBackdrop(st) {
				backdropPatch(draw)
				return
			}
			let n = sources.len().min(transforms.len())
			for let i = 0; i < n; i++ {
				if !wholeRect(sources[i]) {
					selfPatch(draw)
					return
				}
			}
			let smooth = st.sampling != Sampling.Nearest
			let parts string[]
			for let i = 0; i < n; i++ {
				let s = sources[i]
				let (w, h) = (int(s.right - s.left), int(s.bottom - s.top))
				continue when w <= 0 || h <= 0
				let tint ?RGBA = none
				if i < colors.len() {
					let c = colors[i].rgba
					tint = c unless c.r == 255 && c.g == 255 && c.b == 255 && c.a == 255
				}
				let name = imageOf(src, int(s.left), int(s.top), w, h, smooth, tint)
				continue when name == ""
				parts.push("q {matrixOf(transforms[i])} cm {w} 0 0 {-h} 0 {h} cm /{name} Do Q\n")
			}
			return when parts.len() == 0
			frame().node().add(new PdfNode("q\n{cmOf(st.transform)}{stateGs(st, 1.0, "")}{parts.join("")}Q\n"))
		}

		// Nine-slice as nine source-to-destination images, as Canvas cuts it.
		def drawImage(src Raster, dest Rect, insets Edges<Pixels>) {
			let size = src.size()
			let w = float(size.width)
			let h = float(size.height)
			let (l, r, t, b) = (float(insets.left), float(insets.right), float(insets.top), float(insets.bottom))
			let dw = dest.right - dest.left
			let dh = dest.bottom - dest.top
			let fx = (l + r > dw && l + r > 0.0) ?? (dw / (l + r), 1.0)
			let fy = (t + b > dh && t + b > 0.0) ?? (dh / (t + b), 1.0)
			let sx = float[0.0, l, w - r, w]
			let sy = float[0.0, t, h - b, h]
			let dx = float[dest.left, dest.left + l * fx, dest.right - r * fx, dest.right]
			let dy = float[dest.top, dest.top + t * fy, dest.bottom - b * fy, dest.bottom]
			for let j = 0; j < 3; j++ {
				for let i = 0; i < 3; i++ {
					continue when sx[i + 1] <= sx[i] || sy[j + 1] <= sy[j] || dx[i + 1] <= dx[i] || dy[j + 1] <= dy[j]
					drawImage(src, Rect{left: sx[i], top: sy[j], right: sx[i + 1], bottom: sy[j + 1]}, Rect{left: dx[i], top: dy[j], right: dx[i + 1], bottom: dy[j + 1]}, state().sampling)
				}
			}
		}

		// Painter: text.

		// Text as glyphs of Type 3 fonts made from the face's outlines, so
		// it can be searched and copied; each code maps back to its text.
		def fillText(text string, at Point, textStyle TextStyle, paint Paint) {
			forward((p Painter) => p.fillText(text, at, textStyle, paint))
			let draw = (p Painter) => p.fillText(text, at, textStyle, paint)
			let st = state()
			if needsBackdrop(st) {
				backdropPatch(draw)
				return
			}
			let m = frame().history.measureText(text, textStyle)
			return when m.glyphs.len() == 0
			let reach = Rect{left: at.x + m.bounds.left - 1.0, top: at.y + m.bounds.top - 1.0, right: at.x + m.bounds.right + 1.0, bottom: at.y + m.bounds.bottom + 1.0}
			let found = paintOf(paint, false, st.transform, reach, new Transform2D())
			if found is none {
				selfPatch(draw)
				return
			}
			let painted PdfPaint = found
			// A gradient paints the glyph outlines through a clip (viewers
			// fill Type 3 glyphs with a shading pattern unreliably), under
			// the same glyphs as invisible text, to keep it searchable.
			let paintOps = painted.ops
			let shaded = ""
			if painted.shading != "" {
				let ops = pathOps(frame().history.textPath(text, at, plainStyle(textStyle)))
				return when ops == ""
				shaded = "q\n{ops}W n\n/{painted.shading} sh\nQ\n"
				paintOps = "3 Tr\n"
			}
			let face = textStyle.face
			let size = textSizeOf(textStyle)
			let turned = textStyle.orientation == TextOrientation.Sideways
			let pieces = clusterTexts(text, m)
			let parts string[]
			let current = ""
			for let (i, g) in m.glyphs {
				let (font, code) = out.glyphCode(face, g.glyph, pieces[i])
				if font != current {
					parts.push("/{font} {pdfNumber(size)} Tf\n")
					current = font
				}
				let orient = turned ?? ("0 1 1 0", "1 0 0 -1")
				parts.push("{orient} {pdfNumber(at.x + g.x)} {pdfNumber(at.y + g.y)} Tm <{uint8(code).hex(2)}> Tj\n")
			}
			frame().node().add(new PdfNode("q\n{cmOf(st.transform)}{stateGs(st, painted.alpha, painted.smask)}{shaded}BT\n{paintOps}{parts.join("")}ET\nQ\n"))
		}

		def strokeText(text string, at Point, textStyle TextStyle, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(textPath(text, at, plainStyle(textStyle)), paint, strokeStyle)
		}

		// The text fills the canvas draws the paragraph with.
		def fillText(paragraph Paragraph, at Point) {
			let ctx = new DrawContext()
			ctx.setTransform(state().transform)
			ctx.fillText(paragraph, at)
			ctx.replay(self)
		}

		// Text along a path, as the outlines the canvas fills.
		def fillText(text string, along Path, textStyle TextStyle, paint Paint, offset float = 0.0) {
			let ctx = new DrawContext()
			ctx.setTransform(state().transform)
			ctx.fillText(text, along, textStyle, paint, offset)
			ctx.replay(self)
		}

		def measureText(text string, textStyle TextStyle) TextMetrics {
			return frame().history.measureText(text, textStyle)
		}

		def textPath(text string, at Point, textStyle TextStyle) Path {
			return frame().history.textPath(text, at, textStyle)
		}

		// Painter: groups.

		def beginGroup(opacity float | Percent = 100(%), blend = BlendMode.Normal, effects Effect[] = [], mask ?Mask = none, bounds ?Rect = none) {
			forward((p Painter) => p.beginGroup(opacity, blend, effects, mask, bounds))
			let outer = frame()
			let st = copyState(outer.history.state())
			let history = new DrawContext(new Size(width, height))
			// The group's content starts from the settings and clips in force.
			history.setState(st)
			let inherited = copyClips(outer.openClips)
			for let (_, c) in inherited {
				c.apply(history)
			}
			history.setTransform(st.transform)
			let f = new PdfFrame(new PdfNode(), history)
			f.opacity = opacity is Percent ?? (float(opacity) / 100.0, float(opacity))
			f.blend = blend
			f.effects = effects
			f.mask = mask
			f.bounds = bounds
			f.start = st
			f.outer = inherited
			frames.push(f)
			if bounds is Rect {
				let r Rect = bounds
				history.clip(r)
				let t = copyTransform(st.transform)
				pushClip(pathOps(new Path().rect(r).transformed(t)) + "W n\n", "", (p Painter) => {
					p.setTransform(t)
					p.clip(r)
				})
			}
		}

		// A group without effects is a transparency group form drawn with
		// its opacity, blend mode and mask; effects have no PDF form, so a
		// group with them is the canvas's pixels.
		def endGroup() {
			return when frames.len() < 2
			let f = frames.pop()
			forward((p Painter) => p.endGroup())
			let replayGroup = (p Painter) => {
				p.setState(f.start)
				for let (_, c) in f.outer {
					c.apply(p)
				}
				p.setTransform(f.start.transform)
				p.beginGroup(f.opacity, f.blend, f.effects, f.mask, f.bounds)
				f.history.replay(p)
				p.endGroup()
			}
			if !pdfBlend(f.blend) || readsBackdrop(f.effects) {
				backdropPatch(replayGroup)
				return
			}
			if f.effects.len() > 0 {
				selfPatch(replayGroup)
				return
			}
			let body = f.container.text(out)
			return when body == ""
			let form = out.form(body, box(), "/Group<</S/Transparency/I true/CS/DeviceRGB>>")
			let dict = ""
			if f.opacity < 1.0 {
				let a = pdfNumber(f.opacity.clamp(0.0, 1.0))
				dict += "/ca {a}/CA {a}"
			}
			dict += "/BM/{blendName(f.blend)}" unless f.blend == BlendMode.Normal
			let groupMask = f.mask
			if !(groupMask is none) {
				dict += maskOf(groupMask)
			}
			let gs = dict == "" ?? ("", "/{out.gs(dict)} gs ")
			frame().node().add(new PdfNode("q {gs}/{form} Do Q\n"))
		}

		// Painter: hit testing, as the recording would.

		def isInPath(path Path, p Point, rule FillRule = FillRule.NonZero) bool {
			return frame().history.isInPath(path, p, rule)
		}

		def isInStroke(path Path, p Point, strokeStyle StrokeStyle) bool {
			return frame().history.isInStroke(path, p, strokeStyle)
		}

		// Clips.

		def pushClip(head string, mask string, apply def(Painter)) {
			let f = frame()
			nextId++
			f.active.push(new PdfClip(nextId, head, mask, apply))
			syncClips(f)
		}

		// Opens and closes clip nodes until they match the clips in force.
		def syncClips(f PdfFrame) {
			let keep = 0
			for keep < f.openClips.len() && keep < f.active.len() && f.openClips[keep].id == f.active[keep].id {
				keep++
			}
			f.opens.len(keep)
			f.openClips.len(keep)
			for let i = keep; i < f.active.len(); i++ {
				let c = f.active[i]
				let n = new PdfNode("", c.head)
				n.mask = c.mask
				n.box = box()
				f.node().add(n)
				f.opens.push(n)
				f.openClips.push(c)
			}
		}

		// Drawing.

		// A fill or stroke as path operators, unless the settings or paint
		// need the canvas. Strokes of a fixed width are drawn in the page's
		// space, so the transform cannot widen them.
		def shape(path Path, paint Paint, rule FillRule, strokeStyle ?StrokeStyle, draw def(Painter)) {
			let st = state()
			if needsBackdrop(st) {
				backdropPatch(draw)
				return
			}
			let t = st.transform
			let fixed = false
			let width = 0.0
			let miter = 4.0
			if strokeStyle is StrokeStyle {
				let s StrokeStyle = strokeStyle
				fixed = s.fixedWidth
				width = float(s.width)
				miter = s.miterLimit
			}
			let drawn = fixed ?? (path.transformed(t), path)
			let ops = pathOps(drawn)
			return when ops == ""
			let pad = width / 2.0 * miter.max(1.5) + 1.0
			let b = drawn.bounds()
			let reach = Rect{left: b.left - pad, top: b.top - pad, right: b.right + pad, bottom: b.bottom + pad}
			let drawnSpace = fixed ?? (new Transform2D(), t)
			let found = paintOf(paint, !(strokeStyle is none), t, fixed ?? (rectUnder(reach, t.inverse()), reach), fixed ?? (t, new Transform2D()))
			if found is none {
				selfPatch(draw)
				return
			}
			let painted PdfPaint = found
			let body = "q\n{cmOf(drawnSpace)}{stateGs(st, painted.alpha, painted.smask)}{painted.ops}"
			if painted.shading != "" {
				// Shadings paint through a clip of the shape (a stroke's
				// outline), in the gradient's space: unlike shading patterns,
				// the same in every stream, a page, a form or a pattern cell.
				let outline = ops
				let even = rule == FillRule.EvenOdd && strokeStyle is none
				if strokeStyle is StrokeStyle {
					let s StrokeStyle = strokeStyle
					let k = fixed ?? (1.0, scaleOf(t).max(1e-9))
					outline = pathOps(drawn.stroked(s, 0.05 / k))
					return when outline == ""
				}
				body += outline + (even ?? ("W* n\n", "W n\n")) + cmOf(fixed ?? (t, new Transform2D())) + "/{painted.shading} sh\n"
				frame().node().add(new PdfNode(body + "Q\n"))
				return
			}
			if strokeStyle is StrokeStyle {
				let s StrokeStyle = strokeStyle
				body += "{pdfNumber(width)} w {capOf(s.cap)} J {joinOf(s.join)} j {pdfNumber(s.miterLimit)} M\n"
				if s.dash.len() > 0 {
					let parts string[]
					for let (_, d) in s.dash {
						parts.push(pdfNumber(float(d)))
					}
					body += "[{parts.join(" ")}] {pdfNumber(float(s.dashOffset))} d\n"
				}
				body += ops + "S\n"
			} else {
				body += ops + (rule == FillRule.EvenOdd ?? ("f*\n", "f\n"))
			}
			frame().node().add(new PdfNode(body + "Q\n"))
		}

		// The settings' graphics state: alpha (times the paint's own), blend
		// mode and the paint's soft mask.
		def stateGs(st DrawState, paintAlpha float, smask string) string {
			let dict = ""
			let a = (st.alpha * paintAlpha).clamp(0.0, 1.0)
			dict += "/ca {pdfNumber(a)}/CA {pdfNumber(a)}" when a < 1.0
			dict += "/BM/{blendName(st.blend)}" unless st.blend == BlendMode.Normal
			dict += "/SMask {smask}" unless smask == ""
			return "" when dict == ""
			return "/{out.gs(dict)} gs\n"
		}

		// The paint as operators for a fill (or a stroke), in the user space
		// `t` maps to the page, over `reach` (the drawing's extent in that
		// space); a varying opacity becomes a soft mask in the space `maskT`
		// maps to the one the mask is set in. None for a paint PDF cannot
		// show.
		def paintOf(paint Paint, stroking bool, t Transform2D, reach Rect, maskT Transform2D) ?PdfPaint {
			let (space, set) = stroking ?? (("CS", "SCN"), ("cs", "scn"))
			let named = (name string) => "/Pattern {space} /{name} {set}\n"
			match paint {
				case Color:
					let c = paint.rgba
					return PdfPaint{ops: colorOps(c, stroking ?? ("RG", "rg")), alpha: float(c.a) / 255.0}
				case LinearGradient:
					let d = new Point(paint.to.x - paint.from.x, paint.to.y - paint.from.y)
					let len2 = d.x * d.x + d.y * d.y
					return none when len2 == 0.0 || paint.stops.len() == 0
					let (lo, hi) = (0.0, 1.0)
					if paint.spread != Spread.Pad {
						lo = 1e300
						hi = -1e300
						for let (_, p) in corners(reach) {
							let v = ((p.x - paint.from.x) * d.x + (p.y - paint.from.y) * d.y) / len2
							lo = lo.min(v)
							hi = hi.max(v)
						}
						lo = lo.floor()
						hi = hi.ceil().max(lo + 1.0)
					}
					let geometry = "/ShadingType 2/Coords[{pdfNumber(paint.from.x + lo * d.x)} {pdfNumber(paint.from.y + lo * d.y)} {pdfNumber(paint.from.x + hi * d.x)} {pdfNumber(paint.from.y + hi * d.y)}]"
					return gradientPaint(geometry, paint.stops, opaqueStops(paint.stops), paint.space == ColorSpace.SRGB, !paint.premultiplied, (v float) => paint.colorAt(v), paint.spread, lo, hi, reach, maskT)
				case RadialGradient:
					return none when paint.stops.len() == 0
					let f = paint.center
					let given = paint.focus
					if given is Point {
						f = given
					}
					let (dcx, dcy, dr) = (paint.center.x - f.x, paint.center.y - f.y, paint.radius - paint.focusRadius)
					let hi = 1.0
					if paint.spread != Spread.Pad {
						// The circle at t holds every point within fr + t (dr - |dc|)
						// of the focus.
						let grow = dr - sqrt(dcx * dcx + dcy * dcy)
						return none when grow <= 0.0
						for let (_, p) in corners(reach) {
							let dist = sqrt((p.x - f.x) * (p.x - f.x) + (p.y - f.y) * (p.y - f.y))
							hi = hi.max(((dist - paint.focusRadius) / grow).ceil())
						}
					}
					let geometry = "/ShadingType 3/Coords[{pdfNumber(f.x)} {pdfNumber(f.y)} {pdfNumber(paint.focusRadius)} {pdfNumber(f.x + hi * dcx)} {pdfNumber(f.y + hi * dcy)} {pdfNumber(paint.focusRadius + hi * dr)}]"
					return gradientPaint(geometry, paint.stops, opaqueStops(paint.stops), paint.space == ColorSpace.SRGB, !paint.premultiplied, (v float) => paint.colorAt(v), paint.spread, 0.0, hi, reach, maskT)
				case ConicGradient:
					return none when paint.stops.len() == 0
					let (patches, colors, alphas, opaque) = conicPatches(paint, reach)
					return meshPaint(patches, colors, alphas, opaque, reach, maskT)
				case MeshGradient:
					let (patches, colors, alphas, opaque) = meshPatches(paint)
					return none when patches.len() == 0
					return meshPaint(patches, colors, alphas, opaque, reach, maskT)
				case Pattern:
					let name = tilingOf(paint, t)
					return none when name == ""
					return PdfPaint{ops: named(name)}
				default:
					// Noise has no PDF form.
					return none
			}
		}

		// An axial or radial gradient: its colours as a shading pattern, and
		// its opacity, when it varies, as a soft mask of the same shading in
		// gray.
		// `straight`: the gradient mixes colour and opacity apart, as PDF's
		// shading and soft mask do, so sRGB stops are exact as they are.
		def gradientPaint(geometry string, stops ColorStop[], opaque bool, srgb bool, straight bool, at def(float) Color, spread Spread, lo float, hi float, reach Rect, maskT Transform2D) ?PdfPaint {
			let extend = "/Extend[true true]"
			let domain = "/Domain[{pdfNumber(lo)} {pdfNumber(hi)}]"
			let colors = spreadFunction(out.add(stopsFunction(stops, at, false, (opaque || straight) && srgb)), spread, lo, hi)
			let shading = out.add("<<{geometry}/ColorSpace/DeviceRGB{domain}/Function {colors}{extend}>>")
			let painted = PdfPaint{ops: "", shading: out.resource("Shading", "S", shading)}
			return painted when opaque
			let alphas = spreadFunction(out.add(stopsFunction(stops, at, true, false)), spread, lo, hi)
			let gray = out.add("<<{geometry}/ColorSpace/DeviceGray{domain}/Function {alphas}{extend}>>")
			painted.smask = softMask(gray, reach, maskT)
			return painted
		}

		// A patch mesh paint: the coloured patches as a shading pattern, and
		// their opacity, unless every corner is opaque, as a soft mask.
		def meshPaint(patches Point[], colors RGBA[], alphas byte[], opaque bool, reach Rect, maskT Transform2D) PdfPaint {
			let (data, decode) = patchData(patches, colors, alphas, false)
			let shading = out.stream("/ShadingType 6/ColorSpace/DeviceRGB/BitsPerCoordinate 32/BitsPerComponent 8/BitsPerFlag 8/Decode[{decode}]", data)
			let painted = PdfPaint{ops: "", shading: out.resource("Shading", "S", shading)}
			return painted when opaque
			let (gdata, gdecode) = patchData(patches, colors, alphas, true)
			let gray = out.stream("/ShadingType 6/ColorSpace/DeviceGray/BitsPerCoordinate 32/BitsPerComponent 8/BitsPerFlag 8/Decode[{gdecode}]", gdata)
			painted.smask = softMask(gray, reach, maskT)
			return painted
		}

		// A luminosity soft mask painting the gray shading over `reach`.
		def softMask(gray int, reach Rect, maskT Transform2D) string {
			let sh = out.resource("Shading", "S", gray)
			let maskBox = rectUnder(reach, maskT)
			let body = "{cmOf(maskT)}/{sh} sh\n"
			let n = out.stream("/Type/XObject/Subtype/Form/BBox[{boxOf(maskBox)}]/Group<</S/Transparency/CS/DeviceGray>>/Resources {out.resourcesOf(body)}", body.bytes())
			return "<</Type/Mask/S/Luminosity/G {n} 0 R>>"
		}

		// A repeating pattern as a tiling pattern: a raster's pixels, or a
		// picture's own drawing, one cell a tile; "" for spreads other than
		// Repeat, which tiling cannot show.
		def tilingOf(paint Pattern, t Transform2D) string {
			return "" when paint.repeatX != Spread.Repeat || paint.repeatY != Spread.Repeat
			let tile = paint.tile
			let (tw, th) = (tile.right - tile.left, tile.bottom - tile.top)
			return "" when !(tw > 0.0 && th > 0.0)
			let src = paint.src
			let cell = ""
			if src is Picture {
				let sub = new PdfWriter(out, int(tw.ceil()), int(th.ceil()), false)
				sub.setTransform(new Transform2D(tx = -tile.left, ty = -tile.top))
				src.replay(sub)
				cell = sub.content()
			} else {
				let raster Raster = src
				let name = imageOf(raster, 0, 0, int(tw), int(th), paint.sampling != Sampling.Nearest, none)
				return "" when name == ""
				cell = "{pdfNumber(tw)} 0 0 {pdfNumber(-th)} 0 {pdfNumber(th)} cm /{name} Do\n"
			}
			let base = frame().inForm() || frames.len() > 1 ?? (new Transform2D(), top)
			let m = base.then(t).then(paint.transform).then(new Transform2D(tx = tile.left, ty = tile.top))
			let n = out.stream("/Type/Pattern/PatternType 1/PaintType 1/TilingType 1/BBox[0 0 {pdfNumber(tw)} {pdfNumber(th)}]/XStep {pdfNumber(tw)}/YStep {pdfNumber(th)}/Matrix[{matrixOf(m)}]/Resources {out.resourcesOf(cell)}", cell.bytes())
			return out.resource("Pattern", "P", n)
		}

		// Rasterized parts.

		// Draws `draw` alone on a transparent canvas through the current
		// settings (blend and operator aside, which PDF applies) and places
		// the pixels it changed as an image: for what PDF cannot draw but
		// that does not depend on what is below.
		def selfPatch(draw def(Painter)) {
			let st = copyState(state())
			let blend = st.blend
			st.blend = BlendMode.Normal
			st.composite = Composite.SourceOver
			let c = new Canvas(width, height)
			c.setState(st)
			draw(c)
			let changed = c.changes()
			return when changed is none
			let b Rect = changed
			let x0 = int(b.left).max(0)
			let y0 = int(b.top).max(0)
			let x1 = int(b.right).min(width)
			let y1 = int(b.bottom).min(height)
			return when x0 >= x1 || y0 >= y1
			let name = imageOf(c, x0, y0, x1 - x0, y1 - y0, false, none)
			return when name == ""
			let gs = pdfBlend(blend) && blend != BlendMode.Normal ?? ("/{out.gs("/BM/{blendName(blend)}")} gs ", "")
			frame().node().add(new PdfNode("q {gs}{x1 - x0} 0 0 {y0 - y1} {x0} {y1} cm /{name} Do Q\n"))
		}

		// Draws the frame so far (which already holds `draw`) on the canvas
		// and replaces the box `draw` changes with those pixels: for
		// operators and blends that read what is below. What the frame held
		// is clipped out of the box first, so erasing works too.
		def backdropPatch(draw def(Painter)) {
			let f = frame()
			// The box the call may change, through the clips in force.
			let probe = new DrawContext(new Size(width, height))
			probe.setState(copyState(state()))
			for let (_, c) in f.outer {
				c.apply(probe)
			}
			for let (_, c) in f.active {
				c.apply(probe)
			}
			probe.setState(copyState(state()))
			draw(probe)
			let b = probe.bounds()
			let x0 = int(b.left.floor()).max(0)
			let y0 = int(b.top.floor()).max(0)
			let x1 = int(b.right.ceil()).min(width)
			let y1 = int(b.bottom.ceil()).min(height)
			return when x0 >= x1 || y0 >= y1
			let c = new Canvas(width, height)
			f.history.replay(c)
			let name = imageOf(c, x0, y0, x1 - x0, y1 - y0, false, none)
			// Earlier content, with a hole where the patch goes.
			let before = new PdfNode("", "0 0 {width} {height} re {x0} {y0} {x1 - x0} {y1 - y0} re W* n\n")
			for let (_, k) in f.container.kids {
				before.add(k)
			}
			f.container.kids.len(0)
			f.container.add(before)
			if name != "" {
				f.container.add(new PdfNode("q {x1 - x0} 0 0 {y0 - y1} {x0} {y1} cm /{name} Do Q\n"))
			}
			// The clips reopen after the patch for what comes next.
			f.opens.len(0)
			f.openClips.len(0)
			syncClips(f)
		}

		// A mask in device pixels as a soft mask graphics state entry: a
		// luminosity group of a gray image of its coverage.
		def maskOf(mask Mask) string {
			let (x0, y0, x1, y1) = (0, 0, width, height)
			let reach = gfx.coverageBounds(mask)
			if reach is Rect {
				let r Rect = reach
				x0 = int(r.left.floor()).max(0)
				y0 = int(r.top.floor()).max(0)
				x1 = int(r.right.ceil()).min(width)
				y1 = int(r.bottom.ceil()).min(height)
			}
			let draw = ""
			if x0 < x1 && y0 < y1 {
				let w = x1 - x0
				let h = y1 - y0
				let gray byte[]
				gray.len(w * h)
				let row float32[]
				row.len(w)
				for let y = 0; y < h; y++ {
					gfx.coverageRow(mask, x0, y0 + y, row)
					for let x = 0; x < w; x++ {
						gray[y * w + x] = byte(int((float(row[x]).clamp(0.0, 1.0) * 255.0 + 0.5).floor()))
					}
				}
				let n = out.stream("/Type/XObject/Subtype/Image/Width {w}/Height {h}/ColorSpace/DeviceGray/BitsPerComponent 8", gray)
				let name = out.resource("XObject", "I", n)
				draw = "q {w} 0 0 {-h} {x0} {y1} cm /{name} Do Q\n"
			}
			let g = out.stream("/Type/XObject/Subtype/Form/BBox[{boxOf(box())}]/Group<</S/Transparency/CS/DeviceGray>>/Resources {out.resourcesOf(draw)}", draw.bytes())
			return "/SMask<</Type/Mask/S/Luminosity/G {g} 0 R>>"
		}

		// Pixels.

		// The part of the raster as an image XObject, tinted (multiplied)
		// when a tint is given; "" when the part lies outside the raster.
		def imageOf(src Raster, x int, y int, w int, h int, smooth bool, tint ?RGBA) string {
			return "" when w <= 0 || h <= 0
			let size = src.size()
			return "" when x < 0 || y < 0 || x + w > int(size.width) || y + h > int(size.height)
			let px = src.raw()
			let stride = src.stride()
			let pixels byte[]
			pixels.len(w * h * 4)
			for let row = 0; row < h; row++ {
				let from = (y + row) * stride + x * 4
				for let i = 0; i < w * 4; i++ {
					pixels[row * w * 4 + i] = px[from + i]
				}
			}
			if tint is RGBA {
				let k RGBA = tint
				let mul = byte[k.r, k.g, k.b, k.a]
				for let i = 0; i < w * h * 4; i++ {
					pixels[i] = byte((int(pixels[i]) * int(mul[i % 4]) + 127) / 255)
				}
			}
			return out.image(pixels, w, h, smooth)
		}
	}

	// The colour (or the opacity, as gray) along 0..1: a type 2 function
	// per stretch between stops, stitched. Exact stretches (opaque sRGB
	// stops) interpolate between the stops as the canvas does; other
	// stretches are cut into 64ths, read from `at`, closely enough that the
	// steps cannot be seen. Each stretch reads `at` just inside its ends, so
	// a hard stop stays hard.
	def stopsFunction(stops ColorStop[], at def(float) Color, alpha bool, exact bool) string {
		let marks = float[0.0, 1.0]
		if !exact {
			for let k = 1; k < 64; k++ {
				marks.push(float(k) / 64.0)
			}
		}
		for let (_, s) in stops {
			marks.push(float(s.offset) / 100.0)
		}
		marks = marks.sort((a float, b float) => a < b)
		let cuts float[]
		for let (_, m) in marks {
			continue when m < 0.0 || m > 1.0
			cuts.push(m) when cuts.len() == 0 || m - cuts[cuts.len() - 1] > 1e-9
		}
		let fns string[]
		let bounds string[]
		let encode string[]
		for let i = 0; i + 1 < cuts.len(); i++ {
			let (a, b) = (cuts[i], cuts[i + 1])
			let eps = (b - a) * 1e-6
			fns.push("<</FunctionType 2/Domain[0 1]/C0[{channels(at(a + eps).rgba, alpha)}]/C1[{channels(at(b - eps).rgba, alpha)}]/N 1>>")
			bounds.push(pdfNumber(b)) when i + 2 < cuts.len()
			encode.push("0 1")
		}
		return fns[0] when fns.len() == 1
		return "<</FunctionType 3/Domain[0 1]/Functions[{fns.join("")}]/Bounds[{bounds.join(" ")}]/Encode[{encode.join(" ")}]>>"
	}

	// The function of `base` over [lo, hi]: itself for Pad, else a copy per
	// period, every other one reversed for Reflect.
	def spreadFunction(base int, spread Spread, lo float, hi float) string {
		return "{base} 0 R" when spread == Spread.Pad
		let fns string[]
		let bounds string[]
		let encode string[]
		for let k = lo.floor(); k < hi; k += 1.0 {
			let (a, b) = (k.max(lo) - k, (k + 1.0).min(hi) - k)
			let reversed = spread == Spread.Reflect && (int(k) % 2 + 2) % 2 == 1
			fns.push("{base} 0 R")
			encode.push(reversed ?? ("{pdfNumber(1.0 - a)} {pdfNumber(1.0 - b)}", "{pdfNumber(a)} {pdfNumber(b)}"))
			bounds.push(pdfNumber(k + 1.0)) when k + 1.0 < hi
		}
		return "<</FunctionType 3/Domain[{pdfNumber(lo)} {pdfNumber(hi)}]/Functions[{fns.join(" ")}]/Bounds[{bounds.join(" ")}]/Encode[{encode.join(" ")}]>>"
	}

	// The colour's channels as function values: r g b, or the opacity.
	def channels(c RGBA, alpha bool) string {
		return pdfNumber(float(c.a) / 255.0) when alpha
		return "{pdfNumber(float(c.r) / 255.0)} {pdfNumber(float(c.g) / 255.0)} {pdfNumber(float(c.b) / 255.0)}"
	}

	def opaqueStops(stops ColorStop[]) bool {
		for let (_, s) in stops {
			return false when s.color.rgba.a != 255
		}
		return true
	}

	// The patches of a conic gradient, wedges around its centre reaching
	// past every corner of `reach`: a turn cut into 256 wedges and at every
	// stop, each a Coons patch from the centre (12 points) with the colours
	// of its two sides.
	def conicPatches(g ConicGradient, reach Rect) (Point[], RGBA[], byte[], bool) {
		let c = g.center
		let r = 1.0
		for let (_, p) in corners(reach) {
			r = r.max(sqrt((p.x - c.x) * (p.x - c.x) + (p.y - c.y) * (p.y - c.y)) + 1.0)
		}
		let marks = float[0.0, 1.0]
		for let k = 1; k < 256; k++ {
			marks.push(float(k) / 256.0)
		}
		for let (_, s) in g.stops {
			marks.push(float(s.offset) / 100.0)
		}
		marks = marks.sort((a float, b float) => a < b)
		let cuts float[]
		for let (_, m) in marks {
			continue when m < 0.0 || m > 1.0
			cuts.push(m) when cuts.len() == 0 || m - cuts[cuts.len() - 1] > 1e-9
		}
		let points Point[]
		let colors RGBA[]
		let alphas byte[]
		let opaque = true
		for let i = 0; i + 1 < cuts.len(); i++ {
			let (s0, s1) = (cuts[i], cuts[i + 1])
			let eps = (s1 - s0) * 1e-6
			let (a0, a1) = (g.angle + s0 * Tau, g.angle + s1 * Tau)
			let k = 4.0 / 3.0 * tan((a1 - a0) / 4.0) * r
			let p0 = new Point(c.x + r * cos(a0), c.y + r * sin(a0))
			let p3 = new Point(c.x + r * cos(a1), c.y + r * sin(a1))
			let p1 = new Point(p0.x - k * sin(a0), p0.y + k * cos(a0))
			let p2 = new Point(p3.x + k * sin(a1), p3.y - k * cos(a1))
			let third = (a Point, b Point, f float) => new Point(a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f)
			// p11 at the centre, up the a0 side, along the arc, down the a1
			// side, and the collapsed edge at the centre.
			points.push(c, third(c, p0, 1.0 / 3.0), third(c, p0, 2.0 / 3.0), p0, p1, p2, p3, third(p3, c, 1.0 / 3.0), third(p3, c, 2.0 / 3.0), c, c, c)
			let (c0, c1) = (g.colorAt(s0 + eps).rgba, g.colorAt(s1 - eps).rgba)
			colors.push(c0, c0, c1, c1)
			alphas.push(c0.a, c0.a, c1.a, c1.a)
			opaque = false when c0.a != 255 || c1.a != 255
		}
		return (points, colors, alphas, opaque)
	}

	// The patches of a mesh gradient: each cell cut 8 by 8, every piece a
	// bilinear Coons patch with the gradient's smooth colours at its
	// corners. Empty for a mesh the canvas does not draw.
	def meshPatches(m MeshGradient) (Point[], RGBA[], byte[], bool) {
		let points Point[]
		let colors RGBA[]
		let alphas byte[]
		let opaque = true
		let w = m.columns + 1
		let valid = m.columns >= 1 && m.rows >= 1 && m.points.len() == w * (m.rows + 1) && m.colors.len() == w * (m.rows + 1)
		return (points, colors, alphas, opaque) unless valid
		let steps = 8
		let third = (a Point, b Point, f float) => new Point(a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f)
		for let r = 0; r < m.rows * steps; r++ {
			for let col = 0; col < m.columns * steps; col++ {
				let (u0, u1) = (float(col) / float(steps), float(col + 1) / float(steps))
				let (v0, v1) = (float(r) / float(steps), float(r + 1) / float(steps))
				let (p11, p14, p44, p41) = (meshPoint(m, u0, v0), meshPoint(m, u0, v1), meshPoint(m, u1, v1), meshPoint(m, u1, v0))
				points.push(p11, third(p11, p14, 1.0 / 3.0), third(p11, p14, 2.0 / 3.0), p14, third(p14, p44, 1.0 / 3.0), third(p14, p44, 2.0 / 3.0), p44, third(p44, p41, 1.0 / 3.0), third(p44, p41, 2.0 / 3.0), p41, third(p41, p11, 1.0 / 3.0), third(p41, p11, 2.0 / 3.0))
				for let (_, uv) in [new Point(u0, v0), new Point(u0, v1), new Point(u1, v1), new Point(u1, v0)] {
					let k = m.colorAt(uv.x, uv.y).rgba
					colors.push(k)
					alphas.push(k.a)
					opaque = false when k.a != 255
				}
			}
		}
		return (points, colors, alphas, opaque)
	}

	// The point at (u, v) in grid units, bilinear in its cell.
	def meshPoint(m MeshGradient, u float, v float) Point {
		let w = m.columns + 1
		let (cu, cv) = (int(u.floor()).min(m.columns - 1), int(v.floor()).min(m.rows - 1))
		let (fu, fv) = (u - float(cu), v - float(cv))
		let (q00, q10, q01, q11) = (m.points[cv * w + cu], m.points[cv * w + cu + 1], m.points[(cv + 1) * w + cu], m.points[(cv + 1) * w + cu + 1])
		let top = new Point(q00.x + (q10.x - q00.x) * fu, q00.y + (q10.y - q00.y) * fu)
		let bottom = new Point(q01.x + (q11.x - q01.x) * fu, q01.y + (q11.y - q01.y) * fu)
		return new Point(top.x + (bottom.x - top.x) * fv, top.y + (bottom.y - top.y) * fv)
	}

	// Type 6 shading data: per patch a flag, 12 points as 32-bit fractions
	// of the box they span, and 4 colours (or opacities) of a byte per
	// channel; with the Decode array that maps them back.
	def patchData(points Point[], colors RGBA[], alphas byte[], gray bool) (byte[], string) {
		let (x0, y0, x1, y1) = (1e300, 1e300, -1e300, -1e300)
		for let (_, p) in points {
			x0 = x0.min(p.x)
			y0 = y0.min(p.y)
			x1 = x1.max(p.x)
			y1 = y1.max(p.y)
		}
		x1 = x0 + 1.0 when x1 <= x0
		y1 = y0 + 1.0 when y1 <= y0
		let full = 4294967295.0
		let data byte[]
		let put = (v float, lo float, hi float) => {
			let q = uint32(((v - lo) / (hi - lo) * full + 0.5).floor().clamp(0.0, full))
			data.push(byte(q >> 24), byte((q >> 16) & 255), byte((q >> 8) & 255), byte(q & 255))
		}
		for let patch = 0; patch * 12 < points.len(); patch++ {
			data.push(0)
			for let i = 0; i < 12; i++ {
				let p = points[patch * 12 + i]
				put(p.x, x0, x1)
				put(p.y, y0, y1)
			}
			for let i = 0; i < 4; i++ {
				if gray {
					data.push(alphas[patch * 4 + i])
				} else {
					let c = colors[patch * 4 + i]
					data.push(c.r, c.g, c.b)
				}
			}
		}
		let decode = "{pdfNumber(x0)} {pdfNumber(x1)} {pdfNumber(y0)} {pdfNumber(y1)}" + (gray ?? (" 0 1", " 0 1 0 1 0 1"))
		return (data, decode)
	}

	// For each glyph, the text it stands for: from its cluster to the next
	// cluster after it; the later glyphs of a cluster stand for nothing.
	def clusterTexts(text string, m TextMetrics) string[] {
		let raw = text.bytes()
		let starts int[]
		for let (_, g) in m.glyphs {
			starts.push(g.cluster)
		}
		starts = starts.sort((a int, b int) => a < b)
		let out string[]
		let seen map<int, bool>
		for let (_, g) in m.glyphs {
			if seen.hasKey(g.cluster) {
				out.push("")
				continue
			}
			seen[g.cluster] = true
			let end = raw.len()
			for let (_, s) in starts {
				if s > g.cluster {
					end = s
					break
				}
			}
			let from = g.cluster.clamp(0, raw.len())
			out.push(string(raw[from:end.max(from)]))
		}
		return out
	}

	// The style's size in pixels.
	def textSizeOf(s TextStyle) float {
		match s.size {
			case FontRelative:
				return float(s.size) * float(s.rootSize)
			case Pixels:
				return float(s.size)
		}
		return 16.0
	}

	// The style with hinting off: outlines for a resolution-independent page.
	def plainStyle(s TextStyle) TextStyle {
		return TextStyle{face: s.face, size: s.size, align: s.align, baseline: s.baseline, spacing: s.spacing, hinting: false, rootSize: s.rootSize, script: s.script, orientation: s.orientation}
	}

	// A number as PDF writes it: no exponent, no trailing zeros, at most six
	// decimals.
	def pdfNumber(v float) string {
		let r = (v * 1000000.0).round() / 1000000.0
		r = 0.0 when r == 0.0
		return "{int(r)}" when r == r.floor() && r.abs() < 1e15
		let neg = r < 0.0
		let micro = int((r.abs() * 1000000.0).round())
		let frac = (micro % 1000000).str().padStart(6, "0").trimEnd("0")
		return (neg ?? ("-", "")) + "{micro / 1000000}.{frac}"
	}

	// The path as PDF path operators, quadratic curves raised to cubics;
	// "" for a path with no segments.
	def pathOps(path Path) string {
		let parts string[]
		let pts = path.coords
		let j = 0
		let (cx, cy) = (0.0, 0.0)
		for let (_, op) in path.verbs {
			match op {
				case PathVerb.Move:
					parts.push("{pdfNumber(pts[j])} {pdfNumber(pts[j + 1])} m")
					cx = pts[j]
					cy = pts[j + 1]
					j += 2
				case PathVerb.Line:
					parts.push("{pdfNumber(pts[j])} {pdfNumber(pts[j + 1])} l")
					cx = pts[j]
					cy = pts[j + 1]
					j += 2
				case PathVerb.Quad:
					let (qx, qy, x, y) = (pts[j], pts[j + 1], pts[j + 2], pts[j + 3])
					parts.push("{pdfNumber(cx + (qx - cx) * 2.0 / 3.0)} {pdfNumber(cy + (qy - cy) * 2.0 / 3.0)} {pdfNumber(x + (qx - x) * 2.0 / 3.0)} {pdfNumber(y + (qy - y) * 2.0 / 3.0)} {pdfNumber(x)} {pdfNumber(y)} c")
					cx = x
					cy = y
					j += 4
				case PathVerb.Cubic:
					parts.push("{pdfNumber(pts[j])} {pdfNumber(pts[j + 1])} {pdfNumber(pts[j + 2])} {pdfNumber(pts[j + 3])} {pdfNumber(pts[j + 4])} {pdfNumber(pts[j + 5])} c")
					cx = pts[j + 4]
					cy = pts[j + 5]
					j += 6
				case PathVerb.Close:
					parts.push("h")
			}
		}
		return "" when parts.len() == 0
		return parts.join("\n") + "\n"
	}

	def colorOps(c RGBA, op string) string {
		return "{pdfNumber(float(c.r) / 255.0)} {pdfNumber(float(c.g) / 255.0)} {pdfNumber(float(c.b) / 255.0)} {op}\n"
	}

	// `a b c d e f cm` for a non-identity transform.
	def cmOf(t Transform2D) string {
		return "" when t.a == 1.0 && t.b == 0.0 && t.c == 0.0 && t.d == 1.0 && t.tx == 0.0 && t.ty == 0.0
		return matrixOf(t) + " cm\n"
	}

	def matrixOf(t Transform2D) string {
		return "{pdfNumber(t.a)} {pdfNumber(t.b)} {pdfNumber(t.c)} {pdfNumber(t.d)} {pdfNumber(t.tx)} {pdfNumber(t.ty)}"
	}

	// How much the transform enlarges lengths, at most.
	def scaleOf(t Transform2D) float {
		return sqrt(t.a * t.a + t.b * t.b).max(sqrt(t.c * t.c + t.d * t.d))
	}

	def boxOf(r Rect) string {
		return "{pdfNumber(r.left)} {pdfNumber(r.top)} {pdfNumber(r.right)} {pdfNumber(r.bottom)}"
	}

	def corners(r Rect) Point[] {
		return [new Point(r.left, r.top), new Point(r.right, r.top), new Point(r.right, r.bottom), new Point(r.left, r.bottom)]
	}

	// The box holding the rectangle's corners moved by `t`.
	def rectUnder(r Rect, t Transform2D) Rect {
		let (x0, y0, x1, y1) = (1e300, 1e300, -1e300, -1e300)
		for let (_, p) in corners(r) {
			let q = t.apply(p)
			x0 = x0.min(q.x)
			y0 = y0.min(q.y)
			x1 = x1.max(q.x)
			y1 = y1.max(q.y)
		}
		return Rect{left: x0, top: y0, right: x1, bottom: y1}
	}

	def wholeRect(r Rect) bool {
		return r.left == r.left.floor() && r.top == r.top.floor() && r.right == r.right.floor() && r.bottom == r.bottom.floor()
	}

	def sameBytes(a byte[], b byte[]) bool {
		return false when a.len() != b.len()
		for let i = 0; i < a.len(); i++ {
			return false when a[i] != b[i]
		}
		return true
	}

	// Whether the state draws something PDF composites differently.
	def needsBackdrop(st DrawState) bool {
		return st.composite != Composite.SourceOver || !pdfBlend(st.blend)
	}

	// Whether an effect reads what is below the group (a backdrop blur).
	def readsBackdrop(effects Effect[]) bool {
		for let (_, e) in effects {
			if e is Blur {
				let b Blur = e
				return true when b.backdrop
			}
		}
		return false
	}

	// The blend modes PDF has.
	def pdfBlend(mode BlendMode) bool {
		return mode := BlendMode.Normal || BlendMode.Multiply || BlendMode.Screen || BlendMode.Overlay || BlendMode.Darken || BlendMode.Lighten || BlendMode.ColorDodge || BlendMode.ColorBurn || BlendMode.HardLight || BlendMode.SoftLight || BlendMode.Difference || BlendMode.Exclusion || BlendMode.Hue || BlendMode.Saturation || BlendMode.Color || BlendMode.Luminosity
	}

	// The PDF name of a blend mode PDF has (pdfBlend).
	def blendName(mode BlendMode) string {
		match mode {
			case BlendMode.Multiply:
				return "Multiply"
			case BlendMode.Screen:
				return "Screen"
			case BlendMode.Overlay:
				return "Overlay"
			case BlendMode.Darken:
				return "Darken"
			case BlendMode.Lighten:
				return "Lighten"
			case BlendMode.ColorDodge:
				return "ColorDodge"
			case BlendMode.ColorBurn:
				return "ColorBurn"
			case BlendMode.HardLight:
				return "HardLight"
			case BlendMode.SoftLight:
				return "SoftLight"
			case BlendMode.Difference:
				return "Difference"
			case BlendMode.Exclusion:
				return "Exclusion"
			case BlendMode.Hue:
				return "Hue"
			case BlendMode.Saturation:
				return "Saturation"
			case BlendMode.Color:
				return "Color"
			case BlendMode.Luminosity:
				return "Luminosity"
			default:
				return "Normal"
		}
	}

	def capOf(cap LineCap) int {
		match cap {
			case LineCap.Round:
				return 1
			case LineCap.Square:
				return 2
			default:
				return 0
		}
	}

	def joinOf(join LineJoin) int {
		match join {
			case LineJoin.Round:
				return 1
			case LineJoin.Bevel:
				return 2
			default:
				return 0
		}
	}

	def copyClips(list PdfClip[]) PdfClip[] {
		let out PdfClip[]
		for let (_, c) in list {
			out.push(c)
		}
		return out
	}

	def copyTransform(t Transform2D) Transform2D {
		return new Transform2D(a = t.a, b = t.b, c = t.c, d = t.d, tx = t.tx, ty = t.ty)
	}

	def copyState(s DrawState) DrawState {
		return DrawState{transform: copyTransform(s.transform), clip: none, alpha: s.alpha, composite: s.composite, blend: s.blend, antialias: s.antialias, sampling: s.sampling}
	}
}
