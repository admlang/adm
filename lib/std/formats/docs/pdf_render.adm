partial module std.formats.docs {
	use (
		std.formats.fonts::FontSet
		std.gfx.color::(Color, RGBA)
		std.math.geom::Size
	)

	// How selected PDF pages are placed in the returned raster, in selection order.
	enum PdfRenderLayout {
		Vertical,
		Horizontal,
		// Left to right, then down; gridCount is the number of columns.
		HorizontalGrid,
		// Top to bottom, then right; gridCount is the number of rows.
		VerticalGrid,
	}

	// Pixel sizes describe the page itself; borders, gaps and margins are extra.
	struct PdfRenderOptions {
		layout      PdfRenderLayout = PdfRenderLayout.Vertical
		// One zero dimension is calculated from the page's aspect ratio. With
		// both positive, fit inside this size without stretching. Both zero
		// uses the PDF's physical size at dpi. Rotation is applied before fitting.
		pageSize    Size<int>       = new Size<int>(800, 0)
		dpi         float           = 144.0
		gridCount   int             = 3
		gap         int             = 12
		margin      int             = 12
		borderWidth int             = 1
		borderColor Color           = new Color(RGBA{r: 160, g: 160, b: 160, a: 255})
		background  Color           = new Color(RGBA{r: 238, g: 238, b: 238, a: 255})
		// Maximum pixels in the combined raster; fail before allocating it
		// rather than silently dropping pages or reducing their resolution.
		maxPixels   int             = 100000000
		// None uses installed system fonts for unembedded/unsupported fonts.
		fonts       ?FontSet        = none
		// Reports each distinct approximation/omission once per render call.
		onWarning   ?def(string)    = none
	}
}
