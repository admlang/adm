internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::(PdfObject, PdfKind)
		std.formats.fonts
		std.math.geom::Path
	)

	type PageFont {
		mapping   Font
		face      fonts.Face
		directCID bool           = false
		gidMap    byte[]
		outlines  map<int, Path>

		def new(mapping Font, face fonts.Face) {
			self.mapping = mapping
			self.face = face
			outlines = new map<int, Path>()
		}

		def glyph(code int) int {
			if directCID {
				let enc = mapping.encoding
				let cid = enc is none ?? (code, enc.cid(code))
				return cid when gidMap.len() == 0
				return 0 when cid < 0 || cid >= gidMap.len() / 2
				return field(gidMap, cid * 2, 2)
			}
			let text = string(mapping.text(code))
			return 0 when text.len() == 0
			let found = face.glyph(text[0])
			if found is none {
				found = face.glyph(char(0xf000 + code))
			}
			return found is none ?? (0, int(found))
		}

		def outline(code int) !Path {
			let id = glyph(code)
			let cached = outlines.get(id)
			return cached unless cached is none
			let outline = try face.outline(fonts.GlyphID(id))
			let path = outline.path(1.0 / float(face.info().unitsPerEm))
			outlines.set(id, path)
			return path
		}
	}

	def pageFont(store Store, dict PdfObject, available fonts.FontSet, warnings map<string, bool>) !PageFont {
		let mapping = loadFont(store, dict, expandLigatures = false)
		let descriptor = store.resolve(dict.get("FontDescriptor"))
		let descendant = dict
		if mapping.composite {
			let kids = store.resolve(dict.get("DescendantFonts"))
			if kids.items.len() > 0 {
				descendant = store.resolve(kids.items[0])
			}
			descriptor = store.resolve(descendant.get("FontDescriptor"))
		}
		let encoding = store.resolve(dict.get("Encoding"))
		fail "vertical font encoding {encoding.name} is not implemented" when encoding.name.endsWith("-V")
		fail "Type 3 font rendering is not implemented" when store.resolve(dict.get("Subtype")).name == "Type3"
		let face ?fonts.Face
		for let key in ["FontFile2", "FontFile3"] {
			let stream = store.resolve(descriptor.get(key))
			continue unless stream.kind == PdfKind.Stream
			let data = try store.decode(stream)
			data = try cidFontProgram(data) when key == "FontFile2" && mapping.composite
			let font = fonts.load(data) onerror (err error) {
				warnings.set("font {mapping.name}: embedded {key} unavailable ({err.message})", true)
				continue
			}
			face = try font.face(0)
			break
		}
		let embedded = !(face is none)
		if face is none {
			let family = mapping.mono ?? ("Nimbus Mono PS", "Nimbus Sans")
			let lower = mapping.name.lower()
			family = "Nimbus Roman" when lower.contains("roman") || lower.contains("times") || (lower.contains("serif") && !lower.contains("sans"))
			let generic = mapping.mono ?? ("monospace", family == "Nimbus Roman" ?? ("serif", "sans-serif"))
			face = available.find([mapping.name, family, generic], mapping.bold ?? (700, 400), mapping.italic)
			fail "no installed substitute for {mapping.name}" when face is none
			warnings.set("font substitute: {mapping.name} -> {face.info().family}", true)
		}
		fail "font could not be loaded" when face is none
		let out = new PageFont(mapping, face)
		out.directCID = embedded && store.resolve(descendant.get("Subtype")).name == "CIDFontType2"
		if out.directCID {
			let map = store.resolve(descendant.get("CIDToGIDMap"))
			out.gidMap = try store.decode(map) when map.kind == PdfKind.Stream
		}
		return out
	}
}
