internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::(PdfObject, PdfKind)
		std.formats.image
		std.gfx.color::(Color, RGBA)
	)

	def rgb(r float, g float, b float) Color {
		return new Color(RGBA{r: byte((r.clamp(0.0, 1.0) * 255.0).round()), g: byte((g.clamp(0.0, 1.0) * 255.0).round()), b: byte((b.clamp(0.0, 1.0) * 255.0).round()), a: 255})
	}

	def components(store Store, space PdfObject) int {
		if space.kind == PdfKind.Array && space.items.len() > 0 {
			let name = store.resolve(space.items[0]).name
			if name == "ICCBased" && space.items.len() > 1 {
				return store.integer(store.resolve(space.items[1]), "N")
			}
			if name == "Indexed" || name == "I" {
				return 1
			}
			return components(store, store.resolve(space.items[0]))
		}
		match space.name {
			case "DeviceRGB", "RGB", "CalRGB":
				return 3
			case "DeviceCMYK", "CMYK":
				return 4
			case "DeviceGray", "G", "CalGray":
				return 1
			default:
				return 0
		}
	}

	def sampleColor(values float[]) Color {
		return rgb(values[0], values[0], values[0]) when values.len() == 1
		return rgb(values[0], values[1], values[2]) when values.len() == 3
		let k = 1.0 - values[3]
		return rgb((1.0 - values[0]) * k, (1.0 - values[1]) * k, (1.0 - values[2]) * k)
	}

	def imageXObject(store Store, obj PdfObject, resources PdfObject, ink Color, depth int = 0) !image.Image {
		return decodedImage(store, obj, resources, ink, try store.decode(obj), depth)
	}

	def decodedImage(store Store, obj PdfObject, resources PdfObject, ink Color, data byte[], depth int) !image.Image {
		fail "image mask nesting exceeds 8" when depth > 8
		let filters = store.filterNames(store.resolve(obj.get("Filter")))
		let last = filters.len() == 0 ?? ("", filters[filters.len() - 1])
		if last == "DCTDecode" || last == "DCT" || last == "JPXDecode" {
			let img = try image.load(data)
			try applyMask(store, obj, resources, img, depth)
			return img
		}
		fail "image filter {last} is not implemented" when last == "JBIG2Decode" || last == "CCITTFaxDecode" || last == "CCF"
		let width = store.integer(obj, "Width")
		let height = store.integer(obj, "Height")
		fail "invalid image dimensions" when width <= 0 || height <= 0 || width > 20000 || height > 20000 || width * height > 40000000
		let stencil = store.resolve(obj.get("ImageMask")).boolean
		let bits = store.integer(obj, "BitsPerComponent", stencil ?? (1, 8))
		fail "unsupported image bit depth {bits}" unless bits := 1 || 2 || 4 || 8 || 16
		let space = store.resolve(obj.get("ColorSpace"))
		if space.kind == PdfKind.Name && components(store, space) == 0 {
			space = store.resolve(store.resolve(resources.get("ColorSpace")).get(space.name))
		}
		let channels = stencil ?? (1, components(store, space))
		fail "unsupported image color space {space.name}" unless channels := 1 || 3 || 4
		let palette byte[]
		let paletteChannels = 0
		if space.kind == PdfKind.Array && space.items.len() >= 4 && (space.items[0].name == "Indexed" || space.items[0].name == "I") {
			paletteChannels = components(store, store.resolve(space.items[1]))
			let lookup = store.resolve(space.items[3])
			palette = lookup.kind == PdfKind.Stream ?? (try store.decode(lookup), lookup.data)
			fail "unsupported indexed palette" unless paletteChannels := 1 || 3 || 4
		}
		let row = (width * channels * bits + 7) / 8
		fail "truncated image samples" when data.len() < row * height
		let decode = store.resolve(obj.get("Decode"))
		let mask = store.resolve(obj.get("Mask"))
		let img = new image.Image(width, height)
		let pixels = img.raw()
		let maximum = float((1 << bits) - 1)
		for let y = 0; y < height; y++ {
			for let x = 0; x < width; x++ {
				let values float[]
				let transparent = mask.kind == PdfKind.Array && mask.items.len() >= channels * 2
				for let c = 0; c < channels; c++ {
					let raw = sample(data, y * row, x * channels + c, bits)
					if transparent {
						transparent = float(raw) >= mask.items[c * 2].number && float(raw) <= mask.items[c * 2 + 1].number
					}
					let value = float(raw) / maximum
					if decode.items.len() >= channels * 2 {
						value = decode.items[c * 2].number + value * (decode.items[c * 2 + 1].number - decode.items[c * 2].number)
					}
					values.push(value)
				}
				if paletteChannels > 0 {
					let index = int((decode.items.len() >= 2 ?? (values[0], values[0] * maximum)).round())
					values = float[]
					fail "image palette index out of range" when index < 0 || (index + 1) * paletteChannels > palette.len()
					for let c = 0; c < paletteChannels; c++ {
						values.push(float(palette[index * paletteChannels + c]) / 255.0)
					}
				}
				let rgba = stencil ?? (ink.rgba, sampleColor(values).rgba)
				let offset = y * img.stride() + x * 4
				pixels[offset] = rgba.r
				pixels[offset + 1] = rgba.g
				pixels[offset + 2] = rgba.b
				pixels[offset + 3] = stencil ?? (byte(((1.0 - values[0]).clamp(0.0, 1.0) * 255.0).round()), transparent ?? (byte(0), byte(255)))
			}
		}
		try applyMask(store, obj, resources, img, depth)
		return img
	}

	def applyMask(store Store, obj PdfObject, resources PdfObject, img image.Image, depth int) !none {
		let mask = store.resolve(obj.get("SMask"))
		let soft = mask.kind == PdfKind.Stream
		mask = store.resolve(obj.get("Mask")) unless soft
		return none unless mask.kind == PdfKind.Stream
		let alpha = try imageXObject(store, mask, resources, rgb(0.0, 0.0, 0.0), depth + 1)
		let a = alpha.raw()
		let out = img.raw()
		let width = int(img.size().width)
		let height = int(img.size().height)
		for let y = 0; y < height; y++ {
			for let x = 0; x < width; x++ {
				let mx = x * int(alpha.size().width) / width
				let my = y * int(alpha.size().height) / height
				out[y * img.stride() + x * 4 + 3] = a[my * alpha.stride() + mx * 4 + (soft ?? (0, 3))]
			}
		}
		return none
	}
}
