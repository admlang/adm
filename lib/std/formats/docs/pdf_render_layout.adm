internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::(PdfObject, PdfKind, PdfRenderLayout, PdfRenderOptions)
		std.formats.fonts
		std.gfx::Raster
		std.gfx.canvas::Canvas
		std.math.geom::(Rectangle, Size, Point)
	)

	struct PageGeometry {
		x, y, width, height float
		unit                float = 1.0
		rotation            int
	}

	// Crop to the visible part of MediaBox, and resolve referenced numbers.
	def pageGeometry(store Store, page PdfObject) !PageGeometry {
		fail "expected a PDF page" unless page.kind == PdfKind.Dictionary && store.resolve(page.get("Type")).name == "Page"
		let media = store.resolve(page.get("MediaBox"))
		fail "page has no valid MediaBox" unless media.items.len() == 4
		let x = store.resolve(media.items[0]).number
		let y = store.resolve(media.items[1]).number
		let right = store.resolve(media.items[2]).number
		let top = store.resolve(media.items[3]).number
		let crop = store.resolve(page.get("CropBox"))
		if !crop.isNull() {
			fail "page has no valid CropBox" unless crop.items.len() == 4
			x = x.max(store.resolve(crop.items[0]).number)
			y = y.max(store.resolve(crop.items[1]).number)
			right = right.min(store.resolve(crop.items[2]).number)
			top = top.min(store.resolve(crop.items[3]).number)
		}
		let unit = store.resolve(page.get("UserUnit"))
		let scale = unit.isNull() ?? (1.0, unit.number)
		fail "invalid page dimensions or UserUnit" unless right > x && top > y && scale > 0.0 && scale <= 75000.0
		let rotation = ((store.integer(page, "Rotate") % 360) + 360) % 360
		fail "page rotation must be a multiple of 90" unless rotation := 0 || 90 || 180 || 270
		return PageGeometry{x: x, y: y, width: right - x, height: top - y, unit: scale, rotation: rotation}
	}

	// Avoid a spurious extra pixel when fitting introduces rounding noise.
	def pixelExtent(value float) int {
		return int((value - 0.0000001).ceil()).max(1)
	}

	struct PagePlacement {
		page                PdfObject
		dpi                 float
		width, height, x, y int
	}

	def pagePlacement(store Store, page PdfObject, options PdfRenderOptions) !PagePlacement {
		let g = try pageGeometry(store, page)
		let sideways = g.rotation == 90 || g.rotation == 270
		let width = (sideways ?? (g.height, g.width)) * g.unit
		let height = (sideways ?? (g.width, g.height)) * g.unit
		let dpi = options.dpi
		let target = options.pageSize
		if target.width > 0 && target.height > 0 {
			let pageRect = new Rectangle(position = new Point(0.0, 0.0), size = new Size(width, height))
			let box = new Rectangle(position = new Point(0.0, 0.0), size = new Size(float(target.width), float(target.height)))
			dpi = pageRect.fitInside(box).size.width / width * 72.0
		} else if target.width > 0 {
			dpi = float(target.width) / width * 72.0
		} else if target.height > 0 {
			dpi = float(target.height) / height * 72.0
		}
		let pw = width * dpi / 72.0
		let ph = height * dpi / 72.0
		fail "invalid or excessive rendered page size" unless pw > 0.0 && ph > 0.0 && pw <= 1000000.0 && ph <= 1000000.0
		return PagePlacement{page: page, dpi: dpi, width: pixelExtent(pw), height: pixelExtent(ph)}
	}

	def renderPages(store Store, selected PdfObject[], options PdfRenderOptions) !Raster {
		fail "pageSize dimensions must be between 0 and 1000000" unless options.pageSize.width >= 0 && options.pageSize.height >= 0 && options.pageSize.width <= 1000000 && options.pageSize.height <= 1000000
		fail "DPI must be positive and at most 9600" unless options.dpi > 0.0 && options.dpi <= 9600.0
		fail "gap, margin and borderWidth must be between 0 and 1000000" unless options.gap >= 0 && options.margin >= 0 && options.borderWidth >= 0 && options.gap <= 1000000 && options.margin <= 1000000 && options.borderWidth <= 1000000
		fail "maxPixels must be between 1 and 536870911" unless options.maxPixels > 0 && options.maxPixels <= 536870911
		let horizontalGrid = options.layout == PdfRenderLayout.HorizontalGrid
		let verticalGrid = options.layout == PdfRenderLayout.VerticalGrid
		fail "gridCount must be positive" when (horizontalGrid || verticalGrid) && options.gridCount <= 0
		fail "unknown PDF render layout" unless horizontalGrid || verticalGrid || options.layout == PdfRenderLayout.Vertical || options.layout == PdfRenderLayout.Horizontal
		return new Canvas(0, 0) when selected.len() == 0
		let placements PagePlacement[]
		let cellWidth = 0
		let cellHeight = 0
		let border = options.borderWidth
		let gap = options.gap
		let margin = options.margin
		let width = 0
		let height = 0
		for let item in selected {
			let p = try pagePlacement(store, store.resolve(item), options)
			let w = p.width + border * 2
			let h = p.height + border * 2
			cellWidth = cellWidth.max(w)
			cellHeight = cellHeight.max(h)
			if options.layout == PdfRenderLayout.Vertical {
				p.y = height
				height += h + gap
				width = width.max(w)
			} else if options.layout == PdfRenderLayout.Horizontal {
				p.x = width
				width += w + gap
				height = height.max(h)
			}
			placements.push(p)
		}
		let rows = 1
		let columns = 1
		if horizontalGrid || verticalGrid {
			let count = options.gridCount.min(placements.len())
			let across = (placements.len() - 1) / count + 1
			columns = horizontalGrid ?? (count, across)
			rows = horizontalGrid ?? (across, count)
			width = columns * (cellWidth + gap) - gap
			height = rows * (cellHeight + gap) - gap
		} else if options.layout == PdfRenderLayout.Vertical {
			height -= gap
		} else {
			width -= gap
		}
		let outputWidth = width + margin * 2
		let outputHeight = height + margin * 2
		fail "PDF raster exceeds maxPixels; select fewer pages or reduce pageSize/DPI" when outputWidth <= 0 || outputHeight <= 0 || outputWidth > options.maxPixels / outputHeight
		let cells Rectangle<int>[]
		if horizontalGrid || verticalGrid {
			// Existing geometry owns cell subdivision; the trailing gap is not
			// part of the output, but makes every cell have the same stride.
			cells = new Rectangle<int>(position = new Point<int>(0, 0), size = new Size<int>(width + gap, height + gap)).grid(rows, columns)
		}
		let output = new Canvas(outputWidth, outputHeight)
		output.clear(options.background)
		let configured = options.fonts
		let available = configured is none ?? (fonts.systemFonts(), configured)
		let renderer = new Renderer(store, available)
		renderer.pixelLimit = options.maxPixels
		for let (i, p) in placements {
			let x = p.x
			let y = p.y
			if horizontalGrid || verticalGrid {
				let index = horizontalGrid ?? (i, (i % rows) * columns + i / rows)
				let cell = cells[index]
				x = cell.position.x + (cellWidth - p.width - border * 2) / 2
				y = cell.position.y + (cellHeight - p.height - border * 2) / 2
			} else if options.layout == PdfRenderLayout.Vertical {
				x = (width - p.width - border * 2) / 2
			} else {
				y = (height - p.height - border * 2) / 2
			}
			x += margin
			y += margin
			// Paint the border outside the page, leaving all page pixels visible.
			if border > 0 {
				output.fill(rectangle(float(x), float(y), float(p.width + border * 2), float(p.height + border * 2)), options.borderColor)
			}
			let page = try renderer.render(p.page, p.dpi)
			output.drawImage(page, new Point(float(x + border), float(y + border)))
		}
		let callback = options.onWarning
		if !(callback is none) {
			let report def(string) = callback
			let warnings = renderer.warnings.keys()
			warnings.sort((a string, b string) => a < b)
			for let warning in warnings {
				report(warning)
			}
		}
		return output
	}
}
