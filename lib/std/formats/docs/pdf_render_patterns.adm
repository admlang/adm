internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::(PdfObject, PdfKind)
		std.gfx.canvas::(Canvas, Paint, Pattern)
		std.gfx.color::(Color, RGBA)
		std.math::sqrt
		std.math.geom::Transform2D
	)

	// A rasterized period and its placement in device space. Keeping that
	// placement independent of the current CTM preserves PDF pattern phase.
	struct TilingPaint {
		tile      Canvas
		placement Transform2D
	}

	def pdfPaint(color Color, pattern ?TilingPaint, current Transform2D) Paint {
		return color when pattern is none
		return new Pattern(pattern.tile, transform = current.inverse().then(pattern.placement))
	}

	def renderColorSpace(store Store, space PdfObject, resources PdfObject) PdfObject {
		let resolved = store.resolve(space)
		for let i = 0; i < 8; i++ {
			break unless resolved.kind == PdfKind.Name && resolved.name != "Pattern" && components(store, resolved) == 0
			resolved = store.resolve(store.resolve(resources.get("ColorSpace")).get(resolved.name))
		}
		return resolved
	}

	def selectPdfPaint(renderer Renderer, args PdfObject[], stroke bool, resources PdfObject, initial Graphics, depth int) {
		let gs = renderer.gs
		let space = renderColorSpace(renderer.store, stroke ?? (gs.strokeSpace, gs.fillSpace), resources)
		let family = space
		family = renderer.store.resolve(space.items[0]) when space.kind == PdfKind.Array && space.items.len() > 0
		let color = rgb(0.0, 0.0, 0.0)
		let pattern ?TilingPaint = none
		if family.name == "Pattern" {
			// Missing/unsupported patterns must not become opaque black fills.
			color = new Color(RGBA{r: 0, g: 0, b: 0, a: 0})
			pattern = readTilingPaint(renderer, args, space, resources, initial, depth) onerror (err error) {
				renderer.warnings.set("PDF pattern: " + err.message, true)
				recover none
			}
		} else {
			color = renderer.setColor(args, space, resources)
		}
		if stroke {
			gs.stroke = color
			gs.strokePattern = pattern
		} else {
			gs.fill = color
			gs.fillPattern = pattern
		}
	}

	// PDF 32000-1 8.7.3: clip the cell to BBox, repeat by XStep/YStep,
	// and map pattern coordinates through Matrix into the parent's initial
	// space. Canvas already provides raster tiling, filtering and compositing.
	def readTilingPaint(renderer Renderer, args PdfObject[], space PdfObject, resources PdfObject, initial Graphics, depth int) !?TilingPaint {
		fail "pattern nesting exceeds 32" when depth >= 32
		fail "missing pattern name" when args.len() == 0 || args[args.len() - 1].kind != PdfKind.Name
		let store = renderer.store
		let name = args[args.len() - 1].name
		let dict = store.resolve(store.resolve(resources.get("Pattern")).get(name))
		fail "unsupported or missing tiling pattern {name}" unless dict.kind == PdfKind.Stream && store.integer(dict, "PatternType") == 1
		let paintType = store.integer(dict, "PaintType")
		fail "invalid PaintType in {name}" unless paintType == 1 || paintType == 2
		let ink = rgb(0.0, 0.0, 0.0)
		if paintType == 2 {
			fail "uncolored pattern {name} has no base color space" unless space.kind == PdfKind.Array && space.items.len() == 2
			let base = renderColorSpace(store, space.items[1], resources)
			fail "invalid base color in {name}" unless components(store, base) > 0 && args.len() == components(store, base) + 1
			ink = renderer.setColor(args, base, resources)
		} else {
			fail "colored pattern {name} takes only a name" unless args.len() == 1
		}
		let box = try annotationRect(store, store.resolve(dict.get("BBox")))
		let dx = store.resolve(dict.get("XStep")).number.abs()
		let dy = store.resolve(dict.get("YStep")).number.abs()
		let bw = box.right - box.left
		let bh = box.bottom - box.top
		fail "invalid tiling bounds/steps in {name}" unless dx > 0.0 && dy > 0.0 && bw > 0.0 && bh > 0.0
		let transform = new Transform2D()
		let values = store.resolve(dict.get("Matrix"))
		if !values.isNull() {
			fail "invalid pattern Matrix in {name}" unless values.items.len() == 6
			transform = matrix(values.items)
		}
		let placement = initial.ctm.then(transform)
		fail "singular pattern Matrix in {name}" unless (placement.a * placement.d - placement.b * placement.c).abs() > 0.00000001
		let width = dx * sqrt(placement.a * placement.a + placement.b * placement.b)
		let height = dy * sqrt(placement.c * placement.c + placement.d * placement.d)
		fail "excessive pattern dimensions in {name}" unless width > 0.0 && height > 0.0 && width <= 1000000.0 && height <= 1000000.0
		let pw = pixelExtent(width)
		let ph = pixelExtent(height)
		fail "pattern exceeds pixel limit" when pw > renderer.pixelLimit / ph
		// Oversized BBoxes can overlap adjacent cells. Composite the pieces
		// intersecting one period, rather than dropping the overlap or gaps.
		fail "excessive overlapping pattern cells" unless bw / dx <= 64.0 && bh / dy <= 64.0
		let nx = int((bw / dx).ceil())
		let ny = int((bh / dy).ceil())
		fail "excessive overlapping pattern cells" when nx * ny > 64
		let tile = new Canvas(pw, ph)
		let toTile = new Transform2D(a = float(pw) / dx, d = float(ph) / dy, tx = -box.left * float(pw) / dx, ty = -box.top * float(ph) / dy)
		let local = store.resolve(dict.get("Resources"))
		local = resources when local.isNull()
		let body = try store.decode(dict)
		let cell = new Renderer(store, renderer.available)
		cell.pixelLimit = renderer.pixelLimit
		cell.warnings = renderer.warnings
		cell.imageCache = renderer.imageCache
		cell.fontCache = renderer.fontCache
		for let y = 1 - ny; y <= 0; y++ {
			for let x = 1 - nx; x <= 0; x++ {
				let graphics = initial.copy()
				graphics.ctm = toTile.then(new Transform2D(tx = float(x) * dx, ty = float(y) * dy))
				graphics.fillPattern = none
				graphics.strokePattern = none
				if paintType == 2 {
					graphics.fill = ink
					graphics.stroke = ink
				}
				cell.initialize(tile, graphics)
				tile.save()
				tile.setTransform(graphics.ctm)
				tile.clip(box)
				try cell.execute(body, local, depth + 1)
				for cell.stack.len() > 0 {
					cell.restore()
				}
				tile.restore()
			}
		}
		return TilingPaint{tile: tile, placement: placement.then(toTile.inverse())}
	}
}
