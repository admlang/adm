partial module std.formats.docs {
	use (
		std.testing
		std.formats.docs.pdf::Renderer
		std.formats.fonts::FontSet
		std.gfx.canvas::Canvas
	)

	check "Positioned PDF rendering" {
		internal def stream(data byte[], extra string = "") byte[] {
			let out = "<</Length {data.len()} {extra}>>\nstream\n".bytes()
			out.push(...data)
			out.push(..."\nendstream".bytes())
			return out
		}

		internal def fixture(content string, pageExtra string = "", resources string = "", extras byte[][] = []) !PdfFile {
			let objects = ["<</Type /Catalog /Pages 2 0 R>>".bytes(), "<</Type /Pages /Kids [3 0 R] /Count 1>>".bytes(), "<</Type /Page /Parent 2 0 R /MediaBox [0 0 120 100] /Resources <<{resources}>> /Contents 4 0 R {pageExtra}>>".bytes(), stream(content.bytes())]
			objects.push(...extras)
			let out = "%PDF-1.7\n".bytes()
			let offsets int[]
			for let (i, obj) in objects {
				offsets.push(out.len())
				out.push(..."{i+1} 0 obj\n".bytes())
				out.push(...obj)
				out.push(..."\nendobj\n".bytes())
			}
			let xref = out.len()
			out.push(..."xref\n0 {objects.len()+1}\n0000000000 65535 f \n".bytes())
			for let offset in offsets {
				out.push(...("{offset}".padStart(10, "0") + " 00000 n \n").bytes())
			}
			out.push(..."trailer\n<</Root 1 0 R /Size {objects.len()+1}>>\nstartxref\n{xref}\n%%EOF\n".bytes())
			return new Pdf().open(out)
		}

		internal def pixel(cv Canvas, x int, y int, r int, g int, b int) {
			let at = (y * cv.width + x) * 4
			assert (int(cv.pixels[at]) - r).abs() <= 1
			assert (int(cv.pixels[at + 1]) - g).abs() <= 1
			assert (int(cv.pixels[at + 2]) - b).abs() <= 1
		}

		@test()
		def pathsTransformsClippingAndRestore() !none {
			let file = try fixture("1 0 0 rg 10 20 30 40 re f q 1 0 0 1 50 0 cm 0 0 1 rg 0 0 20 20 re W n 0 0 50 50 re f Q 0 1 0 rg 90 70 10 10 re f")
			let cv = try new Renderer(file.store, new FontSet()).render(file.pages()[0], 72.0)
			pixel(cv, 20, 60, 255, 0, 0)
			pixel(cv, 55, 90, 0, 0, 255)
			pixel(cv, 75, 90, 255, 255, 255)
			pixel(cv, 95, 25, 0, 255, 0)
		}

		@test()
		def pageCropRotationAndUserUnit() !none {
			let file = try fixture("1 0 0 rg 10 20 10 10 re f", "/CropBox [10 20 110 80] /Rotate 90 /UserUnit 2")
			let cv = try new Renderer(file.store, new FontSet()).render(file.pages()[0], 72.0)
			assert cv.width == 120 && cv.height == 200
			pixel(cv, 5, 5, 255, 0, 0)
			pixel(cv, 30, 5, 255, 255, 255)
		}

		@test()
		def formMatrixAndBoundingBox() !none {
			let form = stream("1 0 0 rg 0 0 20 20 re f".bytes(), "/Type /XObject /Subtype /Form /BBox [0 0 10 10] /Matrix [2 0 0 2 10 10]")
			let file = try fixture("/Fm Do 0 0 1 rg 50 50 10 10 re f", "", "/XObject <</Fm 5 0 R>>", [form])
			let cv = try new Renderer(file.store, new FontSet()).render(file.pages()[0], 72.0)
			pixel(cv, 15, 85, 255, 0, 0)
			pixel(cv, 35, 85, 255, 255, 255)
			pixel(cv, 55, 45, 0, 0, 255)
		}

		@test()
		def imageTopRowOrientation() !none {
			let image = stream(byte[255, 0, 0, 0, 0, 255], "/Type /XObject /Subtype /Image /Width 1 /Height 2 /ColorSpace /DeviceRGB /BitsPerComponent 8")
			let file = try fixture("q 20 0 0 40 10 20 cm /Im Do Q", "", "/XObject <</Im 5 0 R>>", [image])
			let cv = try new Renderer(file.store, new FontSet()).render(file.pages()[0], 72.0)
			pixel(cv, 20, 42, 255, 0, 0)
			pixel(cv, 20, 77, 0, 0, 255)
		}

		@test()
		def evenOddAndAlpha() !none {
			let file = try fixture("0 0 1 rg 0 0 120 100 re f /Half gs 1 0 0 rg 10 10 60 60 re 20 20 20 20 re f*", "", "/ExtGState <</Half <</ca 0.5>>>>")
			let cv = try new Renderer(file.store, new FontSet()).render(file.pages()[0], 72.0)
			pixel(cv, 15, 85, 128, 0, 127)
			pixel(cv, 25, 75, 0, 0, 255)
		}
	}
}
