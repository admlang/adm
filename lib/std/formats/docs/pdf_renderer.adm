internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::(PdfFile, PdfObject, PdfKind)
		std.formats.fonts
		std.formats.image
		std.gfx.canvas::Canvas
		std.gfx.color::(Color, BlendMode)
		std.math.geom::(Path, Point, Rect, Transform2D, StrokeStyle, FillRule, LineCap, LineJoin)
		std.units::Pixels
	)

	def numbers(args PdfObject[], at int) float {
		return at < args.len() ?? (args[at].number, 0.0)
	}

	def matrix(args PdfObject[]) Transform2D {
		return new Transform2D(a = numbers(args, 0), b = numbers(args, 1), c = numbers(args, 2), d = numbers(args, 3), tx = numbers(args, 4), ty = numbers(args, 5))
	}

	def named(name string) PdfObject {
		let obj = new PdfObject(PdfKind.Name)
		obj.name = name
		return obj
	}

	def rectangle(x float, y float, width float, height float) Rect {
		return Rect{left: x, top: y, right: x + width, bottom: y + height}
	}

	type Graphics {
		ctm           Transform2D  = new Transform2D()
		fill          Color        = rgb(0.0, 0.0, 0.0)
		stroke        Color        = rgb(0.0, 0.0, 0.0)
		fillPattern   ?TilingPaint
		strokePattern ?TilingPaint
		fillSpace     PdfObject    = named("DeviceGray")
		strokeSpace   PdfObject    = named("DeviceGray")
		line          StrokeStyle
		fillAlpha     float        = 1.0
		strokeAlpha   float        = 1.0
		blend         BlendMode    = BlendMode.Normal
		font          ?PageFont
		size          float        = 12.0
		charSpace     float
		wordSpace     float
		horizontal    float        = 1.0
		leading       float
		rise          float
		textMode      int

		def new() {}

		def copy() Graphics {
			let out = new Graphics()
			out.ctm = ctm
			out.fill = fill
			out.stroke = stroke
			out.fillPattern = fillPattern
			out.strokePattern = strokePattern
			out.fillSpace = fillSpace
			out.strokeSpace = strokeSpace
			out.line = StrokeStyle{width: line.width, cap: line.cap, join: line.join, miterLimit: line.miterLimit, dash: line.dash, dashOffset: line.dashOffset, fixedWidth: line.fixedWidth}
			out.fillAlpha = fillAlpha
			out.strokeAlpha = strokeAlpha
			out.blend = blend
			out.font = font
			out.size = size
			out.charSpace = charSpace
			out.wordSpace = wordSpace
			out.horizontal = horizontal
			out.leading = leading
			out.rise = rise
			out.textMode = textMode
			return out
		}
	}

	// Interprets operators in paint order. Paths are accumulated in device space,
	// so a later cm changes future points without moving points already built.
	type Renderer {
		pixelLimit   int                   = 100000000
		store        Store
		available    fonts.FontSet
		fontCache    map<int, PageFont>
		imageCache   map<int, image.Image>
		warnings     map<string, bool>
		canvas       Canvas
		gs           Graphics
		stack        Graphics[]
		tm           Transform2D
		tlm          Transform2D
		path         Path
		current      Point
		start        Point
		pendingClip  int                   = -1
		textClip     Path
		clippingText bool                  = false

		def new(store Store, available fonts.FontSet) {
			self.store = store
			self.available = available
			fontCache = new map<int, PageFont>()
			imageCache = new map<int, image.Image>()
			warnings = new map<string, bool>()
		}

		def render(page PdfObject, dpi float) !Canvas {
			let geometry = try pageGeometry(store, page)
			let x = geometry.x
			let y = geometry.y
			let width = geometry.width
			let height = geometry.height
			let scale = dpi / 72.0 * geometry.unit
			let rotation = geometry.rotation
			let swapped = rotation == 90 || rotation == 270
			let scaledWidth = (swapped ?? (height, width)) * scale
			let scaledHeight = (swapped ?? (width, height)) * scale
			fail "invalid or excessive page dimensions" unless scaledWidth > 0.0 && scaledHeight > 0.0 && scaledWidth <= 1000000.0 && scaledHeight <= 1000000.0
			let pw = pixelExtent(scaledWidth)
			let ph = pixelExtent(scaledHeight)
			fail "page exceeds pixel limit" when pw > pixelLimit / ph
			canvas = new Canvas(pw, ph)
			canvas.clear(rgb(1.0, 1.0, 1.0))
			gs = new Graphics()
			let base = new Transform2D(a = scale, d = -scale, tx = -x * scale, ty = (y + height) * scale)
			match rotation {
				case 90: base = new Transform2D(a = 0.0, b = scale, c = scale, d = 0.0, tx = -y * scale, ty = -x * scale)
				case 180: base = new Transform2D(a = -scale, d = scale, tx = (x + width) * scale, ty = -y * scale)
				case 270: base = new Transform2D(a = 0.0, b = -scale, c = -scale, d = 0.0, tx = (y + height) * scale, ty = (x + width) * scale)
				default:
			}
			gs.ctm = base
			initialize(canvas, gs)
			let contents = store.resolve(page.get("Contents"))
			let body byte[]
			if contents.kind == PdfKind.Stream {
				body = try store.decode(contents)
			} else if contents.kind == PdfKind.Array {
				for let entry in contents.items {
					body.push(...try store.decode(store.resolve(entry)))
					body.push(10)
				}
			}
			// Annotations start in default page space, independent of any CTM,
			// colors or clipping left behind by the page's content stream.
			canvas.save()
			try execute(body, store.resolve(page.get("Resources")), 0)
			for stack.len() > 0 {
				restore()
			}
			canvas.restore()
			try renderAnnotations(self, page, base)
			return canvas
		}

		// Shared setup for a page or an offscreen pattern cell.
		def initialize(target Canvas, graphics Graphics) {
			canvas = target
			gs = graphics
			stack = Graphics[]
			tm = new Transform2D()
			tlm = new Transform2D()
			path = new Path()
			textClip = new Path()
			pendingClip = -1
			clippingText = false
			current = new Point(0.0, 0.0)
			start = current
		}

		def execute(data byte[], resources PdfObject, depth int) !none {
			fail "Form XObject nesting exceeds 32" when depth > 32
			// Pattern matrices use the parent stream's initial space/state,
			// unaffected by cm/q/Q inside that stream.
			let initial = gs.copy()
			let parser = new Parser(data)
			parser.refs = false
			let operands PdfObject[]
			for {
				parser.skipSpace()
				break when parser.atEnd()
				let c = parser.peek()
				if isRegular(c) && !(c >= 48 && c <= 57) && c != 43 && c != 45 && c != 46 {
					let op = parser.word()
					if op == "true" || op == "false" || op == "null" {
						parser.pos -= op.len()
						operands.push(parser.value())
						continue
					}
					if op == "BI" {
						try inlineImage(parser, resources)
					} else {
						try operator(op, operands, resources, depth, initial)
					}
					operands = PdfObject[]
				} else {
					let before = parser.pos
					operands.push(parser.value())
					fail "invalid PDF content token at byte {before}" when parser.pos == before
					fail "excessive PDF operands" when operands.len() > 10000
				}
			}
			return none
		}

		def restore() {
			if stack.len() == 0 {
				warnings.set("unbalanced graphics-state restore", true)
				return
			}
			gs = stack[stack.len() - 1]
			stack.pop()
			canvas.restore()
		}

		def painted(fill bool, stroke bool, even bool, close bool = false) {
			path.close() when close
			canvas.resetTransform()
			canvas.setBlend(gs.blend)
			let rule = even ?? (FillRule.EvenOdd, FillRule.NonZero)
			if fill {
				canvas.setAlpha(gs.fillAlpha)
				canvas.fill(path, pdfPaint(gs.fill, gs.fillPattern, new Transform2D()), rule)
			}
			if stroke {
				let det = gs.ctm.a * gs.ctm.d - gs.ctm.b * gs.ctm.c
				if det.abs() > 0.00000001 {
					canvas.setTransform(gs.ctm)
					canvas.setAlpha(gs.strokeAlpha)
					canvas.stroke(path.transformed(gs.ctm.inverse()), pdfPaint(gs.stroke, gs.strokePattern, gs.ctm), gs.line)
				}
			}
			canvas.resetTransform()
			if pendingClip >= 0 {
				canvas.clip(path, pendingClip == 1 ?? (FillRule.EvenOdd, FillRule.NonZero))
			}
			pendingClip = -1
			path = new Path()
		}

		def move(x float, y float) {
			current = gs.ctm.apply(new Point(x, y))
			start = current
			path.moveTo(current.x, current.y)
		}

		def lineTo(x float, y float) {
			current = gs.ctm.apply(new Point(x, y))
			path.lineTo(current.x, current.y)
		}

		def curve(c1 Point, c2 Point, end Point) {
			path.cubicTo(c1.x, c1.y, c2.x, c2.y, end.x, end.y)
			current = end
		}

		def nextLine() {
			tlm = tlm.then(new Transform2D(ty = -gs.leading))
			tm = tlm
		}

		def show(data byte[]) !none {
			let font = gs.font
			fail "text shown without a font" when font is none
			let offset = 0
			for offset < data.len() {
				let length = font.mapping.codeLength(data, offset)
				fail "truncated character code" when length <= 0 || offset + length > data.len()
				let code = field(data, offset, length)
				offset += length
				if gs.textMode != 3 {
					let glyph = try font.outline(code)
					let trm = tm.then(new Transform2D(a = gs.size * gs.horizontal, d = -gs.size, ty = gs.rise))
					let shape = glyph.transformed(trm)
					canvas.setTransform(gs.ctm)
					canvas.setBlend(gs.blend)
					if gs.textMode == 0 || gs.textMode == 2 || gs.textMode == 4 || gs.textMode == 6 {
						canvas.setAlpha(gs.fillAlpha)
						canvas.fill(shape, pdfPaint(gs.fill, gs.fillPattern, gs.ctm))
					}
					if gs.textMode == 1 || gs.textMode == 2 || gs.textMode == 5 || gs.textMode == 6 {
						canvas.setAlpha(gs.strokeAlpha)
						canvas.stroke(shape, pdfPaint(gs.stroke, gs.strokePattern, gs.ctm), gs.line)
					}
					if gs.textMode >= 4 {
						textClip.add(shape, gs.ctm)
						clippingText = true
					}
				}
				let advance = (font.mapping.width(code) * gs.size + gs.charSpace + (code == 32 && length == 1 ?? (gs.wordSpace, 0.0))) * gs.horizontal
				tm = tm.then(new Transform2D(tx = advance))
			}
			return none
		}

		def setColor(args PdfObject[], space PdfObject, resources PdfObject) Color {
			let resolved = renderColorSpace(store, space, resources)
			let count = components(store, resolved)
			if count == 0 || args.len()<count {
				warnings.set("unsupported color space {space.name}", true)
				return rgb(0.0, 0.0, 0.0)
			}
			warnings.set("calibrated/ICC colors use device-color approximation", true) when resolved.kind == PdfKind.Array
			let values float[]
			for let i = 0; i<count; i++ {
				values.push(args[i].number)
			}
			return sampleColor(values)
		}

		def operator(op string, a PdfObject[], resources PdfObject, depth int, initial Graphics) !none {
			let x = numbers(a, 0)
			let y = numbers(a, 1)
			gs.fillPattern = none when op := "g" || "rg" || "k" || "cs"
			gs.strokePattern = none when op := "G" || "RG" || "K" || "CS"
			match op {
				case "q":
					canvas.save()
					stack.push(gs.copy())
				case "Q": restore()
				case "cm": gs.ctm = gs.ctm.then(matrix(a))
				case "w":
					gs.line.width = (x == 0.0 ?? (1.0, x)) * 1(px)
					gs.line.fixedWidth = x == 0.0
				case "J": gs.line.cap = [LineCap.Butt, LineCap.Round, LineCap.Square][int(x).clamp(0, 2)]
				case "j": gs.line.join = [LineJoin.Miter, LineJoin.Round, LineJoin.Bevel][int(x).clamp(0, 2)]
				case "M": gs.line.miterLimit = x
				case "d":
					let dash Pixels[]
					if a.len()>0 {
						for let v in a[0].items {
							dash.push(v.number * 1(px))
						}
					}
					gs.line.dash = dash
					gs.line.dashOffset = y * 1(px)
				case "m": move(x, y)
				case "l": lineTo(x, y)
				case "c": curve(gs.ctm.apply(new Point(x, y)), gs.ctm.apply(new Point(numbers(a, 2), numbers(a, 3))), gs.ctm.apply(new Point(numbers(a, 4), numbers(a, 5))))
				case "v": curve(current, gs.ctm.apply(new Point(x, y)), gs.ctm.apply(new Point(numbers(a, 2), numbers(a, 3))))
				case "y":
					let end = gs.ctm.apply(new Point(numbers(a, 2), numbers(a, 3)))
					curve(gs.ctm.apply(new Point(x, y)), end, end)
				case "h":
					path.close()
					current = start
				case "re":
					move(x, y)
					lineTo(x + numbers(a, 2), y)
					lineTo(x + numbers(a, 2), y + numbers(a, 3))
					lineTo(x, y + numbers(a, 3))
					path.close()
					current = start
				case "S": painted(false, true, false)
				case "s": painted(false, true, false, true)
				case "f", "F": painted(true, false, false)
				case "f*": painted(true, false, true)
				case "B": painted(true, true, false)
				case "B*": painted(true, true, true)
				case "b": painted(true, true, false, true)
				case "b*": painted(true, true, true, true)
				case "n": painted(false, false, false)
				case "W": pendingClip = 0
				case "W*": pendingClip = 1
				case "g":
					gs.fill = rgb(x, x, x)
					gs.fillSpace = named("DeviceGray")
				case "G":
					gs.stroke = rgb(x, x, x)
					gs.strokeSpace = named("DeviceGray")
				case "rg":
					gs.fill = rgb(x, y, numbers(a, 2))
					gs.fillSpace = named("DeviceRGB")
				case "RG":
					gs.stroke = rgb(x, y, numbers(a, 2))
					gs.strokeSpace = named("DeviceRGB")
				case "k":
					gs.fill = setColor(a, named("DeviceCMYK"), resources)
					gs.fillSpace = named("DeviceCMYK")
				case "K":
					gs.stroke = setColor(a, named("DeviceCMYK"), resources)
					gs.strokeSpace = named("DeviceCMYK")
				case "cs":
					if a.len()>0 {
						gs.fillSpace = a[0]
					}
				case "CS":
					if a.len()>0 {
						gs.strokeSpace = a[0]
					}
				case "sc", "scn": selectPdfPaint(self, a, false, resources, initial, depth)
				case "SC", "SCN": selectPdfPaint(self, a, true, resources, initial, depth)
				case "BT":
					tm = new Transform2D()
					tlm = new Transform2D()
					textClip = new Path()
					clippingText = false
				case "ET":
					if clippingText {
						canvas.resetTransform()
						canvas.clip(textClip)
						clippingText = false
					}
				case "Tf":
					fail "invalid Tf operands" when a.len()<2
					let dict = store.resolve(store.resolve(resources.get("Font")).get(a[0].name))
					fail "missing font {a[0].name}" when dict.isNull()
					let cached = fontCache.get(dict.objectNumber)
					if cached is none || dict.objectNumber == 0 {
						let loaded = try pageFont(store, dict, available, warnings)
						fontCache.set(dict.objectNumber, loaded)
						cached = loaded
					}
					gs.font = cached
					gs.size = y
				case "Tm":
					tm = matrix(a)
					tlm = tm
				case "Td", "TD":
					gs.leading = -y when op == "TD"
					tlm = tlm.then(new Transform2D(tx = x, ty = y))
					tm = tlm
				case "T*": nextLine()
				case "Tc": gs.charSpace = x
				case "Tw": gs.wordSpace = x
				case "Tz": gs.horizontal = x / 100.0
				case "TL": gs.leading = x
				case "Ts": gs.rise = x
				case "Tr": gs.textMode = int(x)
				case "Tj":
					if a.len()>0 {
						try show(a[0].data)
					}
				case "TJ":
					if a.len()>0 {
						for let item in a[0].items {
							if item.kind == PdfKind.String {
								try show(item.data)
							} else {
								tm = tm.then(new Transform2D(tx = -item.number / 1000.0 * gs.size * gs.horizontal))
							}
						}
					}
				case "'":
					nextLine()
					if a.len()>0 {
						try show(a[0].data)
					}
				case "\"":
					gs.wordSpace = x
					gs.charSpace = y
					nextLine()
					if a.len()>2 {
						try show(a[2].data)
					}
				case "Do":
					if a.len()>0 {
						try xobject(store.resolve(store.resolve(resources.get("XObject")).get(a[0].name)), resources, depth)
					}
				case "gs":
					if a.len()>0 {
						try extended(store.resolve(store.resolve(resources.get("ExtGState")).get(a[0].name)))
					}
				case "BMC", "BDC", "EMC", "MP", "DP", "BX", "EX", "i", "ri":
				default: warnings.set("unsupported content operator: {op}", true)
			}
			return none
		}

		def drawImageObject(obj PdfObject, resources PdfObject) !none {
			let stencil = store.resolve(obj.get("ImageMask")).boolean
			let img = imageCache.get(obj.objectNumber)
			if img is none || obj.objectNumber == 0 || stencil {
				let loaded = try imageXObject(store, obj, resources, gs.fill)
				img = loaded
				imageCache.set(obj.objectNumber, loaded) when obj.objectNumber>0 && !stencil
			}
			fail "image could not be decoded" when img is none
			if stencil && !(gs.fillPattern is none) {
				let mask = new Canvas(canvas.width, canvas.height)
				mask.setTransform(gs.ctm.then(new Transform2D(d = -1.0, ty = 1.0)))
				mask.drawImage(img, rectangle(0.0, 0.0, 1.0, 1.0))
				canvas.save()
				canvas.clip(mask)
				canvas.resetTransform()
				canvas.setAlpha(gs.fillAlpha)
				canvas.setBlend(gs.blend)
				canvas.fill(rectangle(0.0, 0.0, float(canvas.width), float(canvas.height)), pdfPaint(gs.fill, gs.fillPattern, new Transform2D()))
				canvas.restore()
				return none
			}
			canvas.setTransform(gs.ctm.then(new Transform2D(d = -1.0, ty = 1.0)))
			canvas.setAlpha(gs.fillAlpha)
			canvas.setBlend(gs.blend)
			canvas.drawImage(img, rectangle(0.0, 0.0, 1.0, 1.0))
			return none
		}

		def xobject(obj PdfObject, resources PdfObject, depth int) !none {
			fail "missing XObject stream" unless obj.kind == PdfKind.Stream
			let kind = store.resolve(obj.get("Subtype")).name
			if kind == "Image" {
				drawImageObject(obj, resources) onerror (err error) {
					warnings.set("image {obj.objectNumber}: {err.message}", true)
					recover none
				}
				return none
			}
			if kind != "Form" {
				warnings.set("unsupported XObject subtype: {kind}", true)
				return none
			}
			let oldGS = gs
			let oldStack = stack
			let oldTM = tm
			let oldTLM = tlm
			let oldPath = path
			let oldCurrent = current
			let oldStart = start
			let oldClip = pendingClip
			let oldTextClip = textClip
			let oldClipping = clippingText
			canvas.save()
			gs = gs.copy()
			stack = Graphics[]
			path = new Path()
			pendingClip = -1
			let transform = store.resolve(obj.get("Matrix"))
			gs.ctm = gs.ctm.then(matrix(transform.items)) when transform.items.len() == 6
			let bounds = store.resolve(obj.get("BBox"))
			if bounds.items.len() == 4 {
				canvas.setTransform(gs.ctm)
				canvas.clip(rectangle(bounds.items[0].number, bounds.items[1].number, bounds.items[2].number - bounds.items[0].number, bounds.items[3].number - bounds.items[1].number))
			}
			let local = store.resolve(obj.get("Resources"))
			local = resources when local.isNull()
			let group = store.resolve(obj.get("Group"))
			warnings.set("Form transparency group isolation/knockout not implemented", true) when !group.isNull()
			// Always restore the caller, including when a nested stream fails.
			let failure = ""
			executeForm(obj, local, depth + 1) onerror (err error) {
				failure = err.message
				recover none
			}
			for stack.len()>0 {
				restore()
			}
			canvas.restore()
			gs = oldGS
			stack = oldStack
			tm = oldTM
			tlm = oldTLM
			path = oldPath
			current = oldCurrent
			start = oldStart
			pendingClip = oldClip
			textClip = oldTextClip
			clippingText = oldClipping
			fail failure unless failure == ""
			return none
		}

		def executeForm(obj PdfObject, resources PdfObject, depth int) !none {
			return execute(try store.decode(obj), resources, depth)
		}

		def extended(dict PdfObject) !none {
			fail "missing ExtGState dictionary" when dict.isNull()
			let fill = store.resolve(dict.get("ca"))
			let stroke = store.resolve(dict.get("CA"))
			gs.fillAlpha = fill.number.clamp(0.0, 1.0) unless fill.isNull()
			gs.strokeAlpha = stroke.number.clamp(0.0, 1.0) unless stroke.isNull()
			let width = store.resolve(dict.get("LW"))
			if !width.isNull() {
				gs.line.width = (width.number == 0.0 ?? (1.0, width.number)) * 1(px)
				gs.line.fixedWidth = width.number == 0.0
			}
			let mode = store.resolve(dict.get("BM"))
			mode = store.resolve(mode.items[0]) when mode.items.len()>0
			match mode.name {
				case "Normal", "Compatible": gs.blend = BlendMode.Normal
				case "Multiply": gs.blend = BlendMode.Multiply
				case "Screen": gs.blend = BlendMode.Screen
				case "Overlay": gs.blend = BlendMode.Overlay
				case "Darken": gs.blend = BlendMode.Darken
				case "Lighten": gs.blend = BlendMode.Lighten
				case "ColorDodge": gs.blend = BlendMode.ColorDodge
				case "ColorBurn": gs.blend = BlendMode.ColorBurn
				case "HardLight": gs.blend = BlendMode.HardLight
				case "SoftLight": gs.blend = BlendMode.SoftLight
				case "Difference": gs.blend = BlendMode.Difference
				case "Exclusion": gs.blend = BlendMode.Exclusion
				case "Hue": gs.blend = BlendMode.Hue
				case "Saturation": gs.blend = BlendMode.Saturation
				case "Color": gs.blend = BlendMode.Color
				case "Luminosity": gs.blend = BlendMode.Luminosity
				case "":
				default: warnings.set("unsupported blend mode: {mode.name}", true)
			}
			let mask = store.resolve(dict.get("SMask"))
			warnings.set("graphics-state soft masks are not implemented", true) when !mask.isNull() && mask.name != "None"
			let overprint = store.resolve(dict.get("OP"))
			warnings.set("overprint simulation is not implemented", true) when overprint.boolean
			return none
		}

		def inlineImage(p Parser, resources PdfObject) !none {
			let obj = new PdfObject(PdfKind.Stream)
			let aliases = map<string, string>{"W": "Width", "H": "Height", "BPC": "BitsPerComponent", "CS": "ColorSpace", "D": "Decode", "DP": "DecodeParms", "F": "Filter", "IM": "ImageMask", "I": "Interpolate"}
			for {
				p.skipSpace()
				fail "unterminated inline image dictionary" when p.atEnd()
				if p.keywordAt("ID") {
					p.pos += 2
					break
				}
				let key = p.value()
				fail "invalid inline image key" unless key.kind == PdfKind.Name
				let full = aliases.get(key.name)
				obj.entries.set(full is none ?? (key.name, full), p.value())
			}
			// ID is followed by one whitespace delimiter (CRLF counts as one).
			if p.peek() == 13 {
				p.pos++
				p.pos++ when p.peek() == 10
			} else if isWhite(p.peek()) {
				p.pos++
			}
			let start = p.pos
			let end = -1
			let filter = store.resolve(obj.get("Filter"))
			if filter.isNull() {
				let width = store.integer(obj, "Width")
				let height = store.integer(obj, "Height")
				let stencil = store.resolve(obj.get("ImageMask")).boolean
				let channels = stencil ?? (1, components(store, store.resolve(obj.get("ColorSpace"))))
				let bits = store.integer(obj, "BitsPerComponent", stencil ?? (1, 8))
				end = start + (width * channels * bits + 7) / 8 * height when channels>0 && width>0 && height>0
			}
			if end<0 {
				for let i = start + 1; i + 2<p.data.len(); i++ {
					if p.data[i] == 69 && p.data[i + 1] == 73 && isWhite(int(p.data[i - 1])) && isWhite(int(p.data[i + 2])) {
						end = i - 1
						break
					}
				}
			}
			fail "unterminated inline image data" when end<start || end>p.data.len()
			obj.data = p.data[start:end]
			p.pos = end
			p.skipSpace()
			fail "inline image has no EI marker" unless p.keywordAt("EI")
			p.pos += 2
			drawImageObject(obj, resources) onerror (err error) {
				warnings.set("inline image: {err.message}", true)
				recover none
			}
			return none
		}
	}
}
