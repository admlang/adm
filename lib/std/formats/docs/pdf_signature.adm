partial module std.formats.docs {
	use (
		std.crypto.x509::Certificate
		std.time::Time
	)

	// One CMS SignerInfo. All claims are unverified. Algorithm names are OIDs.
	// certificate is matched by issuer/serial or subject-key identifier, never
	// by position in the embedded certificate set. None if no match was found.
	struct PdfSignerInfo {
		issuer             string
		serialNumber       string
		subjectKeyId       byte[]
		digestAlgorithm    string
		signatureAlgorithm string
		signingTime        ?Time
		signature          byte[]
		certificate        ?Certificate
	}

	// Inspection of an embedded digital signature; NOT a validation result.
	// A picture of a signature and an unfilled signature field are not entries.
	struct PdfSignature {
		fieldName              string
		// The original resolved signature dictionary, for additional PDF keys.
		dictionary             PdfObject
		name                   string
		reason                 string
		location               string
		contactInfo            string
		// Claimed PDF /M date, distinct from each CMS signer's signingTime.
		signingTime            ?Time
		filter                 string
		subFilter              string
		documentTimestamp      bool
		certification          bool
		// DocMDP permission: 1=no changes, 2=form filling/signing, 3=annotations
		// as well; 0 when not supplied/recognized. Not an enforcement decision.
		modificationPermission int
		// Original /Contents, including any zero padding reserved by the writer.
		contents               byte[]
		// Alternating offsets and lengths from /ByteRange; empty if malformed.
		byteRange              int[]
		// Only checks integer ranges, ordering and file bounds, NOT digests or
		// whether the excluded gap is precisely the signature's Contents.
		byteRangeInBounds      bool
		// None for malformed ranges. The greatest declared range end and the
		// bytes after it; a zero tail does not prove the whole file is signed.
		signedRevisionLength   ?int
		unsignedTailLength     ?int
		certificates           Certificate[]
		signers                PdfSignerInfo[]
		warnings               string[]
	}
}
