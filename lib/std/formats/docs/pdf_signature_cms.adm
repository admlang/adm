internal partial module std.formats.docs.pdf {
	use (
		std.formats.docs::(PdfSignature, PdfSignerInfo)
		std.data.encoding::(ASN1Element, ASN1Tag, berParse)
		std.crypto::constantTimeEqual
		std.crypto.x509::(parseCertificate, parseName)
	)

	// CMS structure only (RFC 5652 sections 5 and 11). ASN.1 lengths, tags,
	// names, times, certificates and keys belong to the existing public APIs.
	def readSignatureCertificate(signature PdfSignature, raw byte[]) {
		let cert = parseCertificate(raw) onerror (err error) {
			signature.warnings.push("Cannot read embedded certificate: " + err.message)
			return
		}
		signature.certificates.push(cert)
	}

	def signatureAlgorithmOID(algorithm ASN1Element) !string {
		fail "invalid AlgorithmIdentifier" unless algorithm.isTag(ASN1Tag.Sequence) && algorithm.children.len() >= 1
		return (try algorithm.children[0].asOID()).str()
	}

	def readSignatureCMS(signature PdfSignature) !none {
		// PDF reserves space in Contents, then pads the CMS value with zeros.
		// Parse exactly one BER value; stripping trailing zeros could corrupt it.
		let (content, consumed) = try berParse(signature.contents)
		for let i = consumed; i < signature.contents.len(); i++ {
			if signature.contents[i] != 0 {
				signature.warnings.push("Nonzero bytes after CMS ContentInfo")
				break
			}
		}
		fail "invalid ContentInfo" unless content.isTag(ASN1Tag.Sequence) && content.children.len() == 2
		fail "ContentInfo is not SignedData" unless (try content.children[0].asOID()).equals("1.2.840.113549.1.7.2")
		let wrapper = content.children[1]
		fail "missing SignedData wrapper" unless wrapper.isContext(0) && wrapper.children.len() == 1
		let signed = wrapper.children[0]
		fail "invalid SignedData" unless signed.isTag(ASN1Tag.Sequence) && signed.children.len() >= 4
		let parts = signed.children
		try parts[0].asInt()
		fail "invalid digestAlgorithms" unless parts[1].isTag(ASN1Tag.Set)
		fail "invalid EncapsulatedContentInfo" unless parts[2].isTag(ASN1Tag.Sequence)
		let at = 3
		if parts[at].isContext(0) {
			for let cert in parts[at].children {
				if cert.isTag(ASN1Tag.Sequence) {
					readSignatureCertificate(signature, cert.raw)
				} else {
					signature.warnings.push("Unsupported CMS certificate choice")
				}
			}
			at++
		}
		at++ when at < parts.len() && parts[at].isContext(1)
		fail "missing signerInfos" unless at == parts.len() - 1 && parts[at].isTag(ASN1Tag.Set)
		for let entry in parts[at].children {
			let signer = readSignatureSigner(signature, entry) onerror (err error) {
				signature.warnings.push("Cannot read CMS signer: " + err.message)
				continue
			}
			signature.signers.push(signer)
		}
		signature.warnings.push("CMS contains no signer information") when parts[at].children.len() == 0
	}

	def readSignatureSigner(signature PdfSignature, entry ASN1Element) !PdfSignerInfo {
		fail "invalid SignerInfo" unless entry.isTag(ASN1Tag.Sequence) && entry.children.len() >= 5
		let parts = entry.children
		try parts[0].asInt()
		let signer = PdfSignerInfo{}
		let sid = parts[1]
		if sid.isTag(ASN1Tag.Sequence) && sid.children.len() == 2 {
			let issuer = try parseName(sid.children[0])
			let serial = try sid.children[1].asBigInt()
			signer.issuer = issuer.str()
			signer.serialNumber = serial.toRadix(10)
			for let cert in signature.certificates {
				if cert.serialNumber == serial && constantTimeEqual(cert.rawIssuer, sid.children[0].raw) {
					signer.certificate = cert
					break
				}
			}
		} else if sid.isContext(0) && !sid.constructed && sid.content.len() > 0 {
			signer.subjectKeyId = sid.content
			for let cert in signature.certificates {
				if constantTimeEqual(cert.subjectKeyId, sid.content) {
					signer.certificate = cert
					break
				}
			}
		} else {
			fail "invalid SignerIdentifier"
		}
		signer.digestAlgorithm = try signatureAlgorithmOID(parts[2])
		let at = 3
		if parts[at].isContext(0) {
			for let attribute in parts[at].children {
				fail "invalid signed attribute" unless attribute.isTag(ASN1Tag.Sequence) && attribute.children.len() == 2
				let oid = try attribute.children[0].asOID()
				if oid.equals("1.2.840.113549.1.9.5") {
					let values = attribute.children[1]
					fail "invalid signingTime attribute" unless values.isTag(ASN1Tag.Set) && values.children.len() == 1 && signer.signingTime is none
					signer.signingTime = try values.children[0].asTime()
				}
			}
			at++
		}
		fail "missing signature value" unless at + 1 < parts.len()
		signer.signatureAlgorithm = try signatureAlgorithmOID(parts[at])
		signer.signature = try parts[at + 1].asBytes()
		fail "empty signature value" when signer.signature.len() == 0
		at += 2
		at++ when at < parts.len() && parts[at].isContext(1)
		fail "extra SignerInfo fields" unless at == parts.len()
		signature.warnings.push("No embedded certificate matches a CMS signer") when signer.certificate is none
		return signer
	}
}
