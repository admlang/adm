internal partial module std.formats.docs.pdf {
	use std.formats.docs::(PdfObject, PdfKind, PdfSignature)

	// Only follow the live form tree and catalog permissions. Scanning old
	// object bodies would mistake removed signatures in prior revisions for
	// current signatures. Reference guards and depth limits bound broken trees.
	type SignatureReader {
		store  Store
		fields map<int, bool>
		values map<int, bool>
		found  PdfSignature[]

		def new(store Store) {
			self.store = store
			fields = new map<int, bool>()
			values = new map<int, bool>()
		}

		def collect() PdfSignature[] {
			let root = store.resolve(store.trailer.get("Root"))
			let form = store.resolve(root.get("AcroForm"))
			for let field in store.resolve(form.get("Fields")).items {
				walk(field, "", 0)
			}
			let perms = store.resolve(root.get("Perms"))
			for let key in string["DocMDP", "UR", "UR3"] {
				add(store.resolve(perms.get(key)), "", key == "DocMDP", perms.get(key))
			}
			return found
		}

		def walk(value PdfObject, prefix string, depth int) {
			return when depth >= 64
			if value.kind == PdfKind.Reference {
				return when fields.hasKey(value.objectNumber)
				fields.set(value.objectNumber, true)
			}
			let field = store.resolve(value)
			return unless field.kind == PdfKind.Dictionary
			let name = store.resolve(field.get("T")).text()
			let fullName = prefix
			fullName = (prefix == "") ?? (name, prefix + "." + name) when name != ""
			// V belongs to the field, not each of its widget children. Inherited
			// FT identifies terminal signature fields below grouping parents.
			if fieldEntry(store, field, "FT").name == "Sig" {
				add(store.resolve(field.get("V")), fullName, false, field.get("V"))
			}
			for let child in store.resolve(field.get("Kids")).items {
				walk(child, fullName, depth + 1)
			}
		}

		def add(dict PdfObject, name string, certification bool, reference ?PdfObject) {
			return unless dict.kind == PdfKind.Dictionary
			for let existing in found {
				if existing.dictionary == dict {
					existing.certification = true when certification
					return
				}
			}
			if !(reference is none) && reference.kind == PdfKind.Reference {
				return when values.hasKey(reference.objectNumber)
				values.set(reference.objectNumber, true)
			}
			let contents = store.resolve(dict.get("Contents"))
			return unless contents.kind == PdfKind.String
			let present = false
			for let b in contents.data {
				if b != 0 {
					present = true
					break
				}
			}
			return unless present
			found.push(PdfSignature{
				fieldName:     name, dictionary: dict, contents: contents.data,
				certification: certification
			})
		}
	}

	def readSignatureDetails(store Store, signature PdfSignature) {
		let dict = signature.dictionary
		signature.name = store.resolve(dict.get("Name")).text()
		signature.reason = store.resolve(dict.get("Reason")).text()
		signature.location = store.resolve(dict.get("Location")).text()
		signature.contactInfo = store.resolve(dict.get("ContactInfo")).text()
		signature.signingTime = pdfDate(store.resolve(dict.get("M")).text())
		signature.filter = store.resolve(dict.get("Filter")).name
		signature.subFilter = store.resolve(dict.get("SubFilter")).name
		signature.documentTimestamp = store.resolve(dict.get("Type")).name == "DocTimeStamp" || signature.subFilter == "ETSI.RFC3161"
		for let ref in store.resolve(dict.get("Reference")).items {
			let transform = store.resolve(ref)
			if store.resolve(transform.get("TransformMethod")).name == "DocMDP" {
				signature.certification = true
				let params = store.resolve(transform.get("TransformParams"))
				let permission = store.resolve(params.get("P"))
				if permission.kind == PdfKind.Integer && permission.number >= 1.0 && permission.number <= 3.0 {
					signature.modificationPermission = int(permission.number)
				}
			}
		}
		readSignatureRanges(store, signature)
		if signature.subFilter == "adbe.x509.rsa_sha1" {
			let certs = store.resolve(dict.get("Cert"))
			if certs.kind == PdfKind.String {
				readSignatureCertificate(signature, certs.data)
			} else {
				for let cert in certs.items {
					readSignatureCertificate(signature, store.resolve(cert).data)
				}
			}
			return
		}
		if signature.subFilter := "adbe.pkcs7.detached" || "adbe.pkcs7.sha1" || "ETSI.CAdES.detached" || "ETSI.RFC3161" {
			readSignatureCMS(signature) onerror (err error) {
				signature.warnings.push("Cannot read CMS signature: " + err.message)
				recover none
			}
		} else {
			signature.warnings.push("Unsupported signature SubFilter: " + signature.subFilter)
		}
	}

	def readSignatureRanges(store Store, signature PdfSignature) {
		let ranges = store.resolve(signature.dictionary.get("ByteRange"))
		let valid = ranges.kind == PdfKind.Array && ranges.items.len() >= 4 && ranges.items.len() % 2 == 0
		for let item in ranges.items {
			let number = store.resolve(item)
			// Bound before conversion: PDF numbers use float in the object layer.
			if number.kind != PdfKind.Integer || !(number.number >= 0.0 && number.number <= float(store.data.len())) {
				valid = false
				break
			}
			signature.byteRange.push(int(number.number))
		}
		let end = 0
		if valid {
			for let i = 0; i < signature.byteRange.len(); i += 2 {
				let offset = signature.byteRange[i]
				let length = signature.byteRange[i + 1]
				if offset < end || length > store.data.len() - offset {
					valid = false
					break
				}
				end = offset + length
			}
		}
		signature.byteRangeInBounds = valid
		if valid {
			signature.signedRevisionLength = end
			signature.unsignedTailLength = store.data.len() - end
		} else {
			signature.byteRange = int[]
			signature.warnings.push("Missing or malformed ByteRange; file coverage is unknown")
		}
	}
}
