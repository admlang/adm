internal partial module std.formats.docs.pdf {
	use std.formats.docs::*

	// ObjectStream is a decoded object stream: the numbers of the objects it
	// holds and where each starts.
	type ObjectStream {
		data    byte[]
		numbers int[]
		offsets int[]

		def new(data byte[], count int, first int) {
			self.data = data
			numbers = int[]
			offsets = int[]
			let p = new Parser(data)
			for let i = 0; i < count; i++ {
				let number = p.integer()
				let offset = p.integer()
				break when number is none || offset is none
				numbers.push(number)
				offsets.push(first + offset)
			}
		}

		// object parses the object at the index, or the one with the number when
		// the index does not hold it.
		def object(number int, index int) ?PdfObject {
			let at = index
			at = numbers.indexOf(number) when at < 0 || at >= numbers.len() || numbers[at] != number
			return none when at < 0 || offsets[at] >= data.len()
			let p = new Parser(data, offsets[at])
			return p.value()
		}
	}

	// Store holds a PDF file's bytes, its cross-reference data and the objects
	// read so far.
	type Store {
		data      byte[]
		version   string
		trailer   PdfObject
		security  ?Security
		// Per object number: 0 unknown, 1 at a byte offset, 2 in an object
		// stream.
		kinds     int[]
		// The byte offset, or the number of the object stream.
		offsets   int[]
		// The index inside the object stream.
		indexes   int[]
		cache     map<int, PdfObject>
		streams   map<int, ObjectStream>
		// Objects being read, so a stream length that refers back to its own
		// object does not recurse.
		reading   map<int, bool>
		scanned   bool
		// Number of the encryption dictionary, whose strings are not encrypted.
		encryptNo int                    = -1

		def new(data byte[]) {
			self.data = data
			trailer = new PdfObject(PdfKind.Dictionary)
			kinds = int[]
			offsets = int[]
			indexes = int[]
			cache = new map<int, PdfObject>()
			streams = new map<int, ObjectStream>()
			reading = new map<int, bool>()
		}

		// load reads the header, the cross-reference sections and the security
		// handler. Fails when the file holds no document catalog, or it is
		// encrypted and the password opens it neither as user nor as owner.
		def load(password string) !none {
			let head = indexOf(data, "%PDF-", 0, 1024)
			if head >= 0 {
				let p = new Parser(data, head + 5)
				version = p.word()
			}
			let ok = readSections() onerror recover false
			scan() when !ok || resolve(trailer.get("Root")).kind != PdfKind.Dictionary
			fail "pdf: no document catalog" unless resolve(trailer.get("Root")).kind == PdfKind.Dictionary

			let encrypt = trailer.get("Encrypt")
			if !(encrypt is none) && encrypt.kind != PdfKind.Null {
				encryptNo = encrypt.objectNumber when encrypt.kind == PdfKind.Reference
				let dict = resolve(encrypt)
				let ids = resolve(trailer.get("ID"))
				let id = byte[]
				id = resolve(ids.items[0]).data when ids.kind == PdfKind.Array && ids.items.len() > 0
				security = try newSecurity(self, dict, id, password)
				// Objects read before the handler existed hold encrypted strings.
				cache = new map<int, PdfObject>()
				streams = new map<int, ObjectStream>()
			}
			return none
		}

		// readSections follows the cross-reference chain from `startxref`.
		// Returns false when it is missing or does not parse.
		def readSections() !bool {
			let at = lastIndexOf(data, "startxref", data.len() - 4096)
			return false when at < 0
			let p = new Parser(data, at + 9)
			let start = p.integer()
			return false when start is none
			let offset = start
			let seen = new map<int, bool>()
			let any = false
			for offset > 0 && offset < data.len() && !seen.hasKey(offset) {
				seen.set(offset, true)
				let section = readSection(offset)
				break when section is none
				any = true
				mergeTrailer(section)
				let prev = section.get("Prev")
				break when prev is none || prev.kind != PdfKind.Integer
				offset = int(prev.number)
			}
			return any
		}

		// mergeTrailer adds the entries of an older trailer the newer ones do not
		// have.
		def mergeTrailer(section PdfObject) {
			for let (key, value) in section.entries {
				trailer.entries.set(key, value) unless trailer.entries.hasKey(key)
			}
		}

		// readSection reads the table or stream at the offset and returns its
		// trailer dictionary, none when there is neither.
		def readSection(offset int) ?PdfObject {
			let p = new Parser(data, offset)
			p.skipSpace()
			if p.keywordAt("xref") {
				p.pos += 4
				return readTable(p)
			}
			let obj = objectAt(offset, -1)
			return none when obj is none || obj.kind != PdfKind.Stream
			readXrefStream(obj)
			return obj
		}

		// readTable reads a classic table after its `xref` keyword, then the
		// trailer, and the stream a hybrid file names in `XRefStm`.
		def readTable(p Parser) ?PdfObject {
			let numbers = int[]
			let places = int[]
			for {
				p.skipSpace()
				break when p.atEnd() || p.keywordAt("trailer")
				let first = p.integer()
				let count = p.integer()
				return none when first is none || count is none
				for let i = 0; i < count; i++ {
					let offset = p.integer()
					let generation = p.integer()
					p.skipSpace()
					return none when offset is none || generation is none || p.atEnd()
					let kind = p.data[p.pos]
					p.pos++
					if kind == 110 && offset > 0 {
						numbers.push(first + i)
						places.push(offset)
					}
				}
			}
			return none unless p.keywordAt("trailer")
			p.pos += 7
			let section = p.value()
			return none unless section.kind == PdfKind.Dictionary

			let hybrid = section.get("XRefStm")
			if !(hybrid is none) && hybrid.kind == PdfKind.Integer {
				let obj = objectAt(int(hybrid.number), -1)
				readXrefStream(obj) when !(obj is none) && obj.kind == PdfKind.Stream
			}
			for let i = 0; i < numbers.len(); i++ {
				setEntry(numbers[i], 1, places[i], 0)
			}
			return section
		}

		// readXrefStream reads the entries of a cross-reference stream.
		def readXrefStream(obj PdfObject) {
			let widths = obj.get("W")
			return when widths is none || widths.kind != PdfKind.Array || widths.items.len() < 3
			let w0 = int(widths.items[0].number)
			let w1 = int(widths.items[1].number)
			let w2 = int(widths.items[2].number)
			let entry = w0 + w1 + w2
			return when entry <= 0
			let body = decode(obj) onerror recover byte[]
			let index = obj.get("Index")
			let ranges = int[]
			if !(index is none) && index.kind == PdfKind.Array {
				for let (_, item) in index.items {
					ranges.push(int(item.number))
				}
			} else {
				let size = obj.get("Size")
				ranges.push(0, (size is none) ?? (0, int(size.number)))
			}
			let at = 0
			for let r = 0; r + 1 < ranges.len(); r += 2 {
				for let i = 0; i < ranges[r + 1] && at + entry <= body.len(); i++ {
					let kind = (w0 == 0) ?? (1, field(body, at, w0))
					let second = field(body, at + w0, w1)
					let third = field(body, at + w0 + w1, w2)
					at += entry
					setEntry(ranges[r] + i, kind, second, third) when kind := 1 || 2
				}
			}
		}

		// setEntry records where an object is, unless a newer section did.
		def setEntry(number int, kind int, offset int, index int) {
			return when number < 0 || number > 8388607
			grow(number)
			return unless kinds[number] == 0
			kinds[number] = kind
			offsets[number] = offset
			indexes[number] = index
		}

		def grow(number int) {
			return when number < kinds.len()
			let size = (number + 1).max(kinds.len() * 2)
			kinds.len(size)
			offsets.len(size)
			indexes.len(size)
		}

		// scan rebuilds the cross-reference data by finding every `n g obj` in
		// the file, for files whose table is missing or wrong. Later objects win,
		// as in an incremental update, and the trailers found are merged.
		def scan() {
			return when scanned
			scanned = true
			let n = data.len()
			let catalogs = int[]
			let objectStreams = int[]
			let i = 0
			for i + 3 <= n {
				let c = data[i]
				if c == 111 && data[i + 1] == 98 && data[i + 2] == 106 && i > 0 && isWhite(int(data[i - 1])) && (i + 3 == n || !isRegular(int(data[i + 3]))) {
					record(i, catalogs, objectStreams)
					i += 3
				} else if c == 116 && data[i + 1] == 114 && indexOf(data, "trailer", i, i + 7) == i {
					let p = new Parser(data, i + 7)
					let found = p.value()
					if found.kind == PdfKind.Dictionary {
						for let (key, value) in found.entries {
							trailer.entries.set(key, value)
						}
					}
					i += 7
				} else {
					i++
				}
			}
			for let (_, number) in objectStreams {
				let obj = object(number)
				continue when obj is none || obj.kind != PdfKind.Stream
				let count = obj.get("N")
				continue when count is none
				let stream = objectStream(number)
				continue when stream is none
				for let (k, member) in stream.numbers {
					setEntry(member, 2, number, k)
				}
			}
			if resolve(trailer.get("Root")).kind != PdfKind.Dictionary {
				for let (_, number) in catalogs {
					let obj = object(number)
					if !(obj is none) && obj.kind == PdfKind.Dictionary && resolve(obj.get("Type")).name == "Catalog" {
						let ref = new PdfObject(PdfKind.Reference)
						ref.objectNumber = number
						trailer.entries.set("Root", ref)
						break
					}
				}
			}
		}

		// record notes the object whose `obj` keyword is at the position, and
		// whether it looks like a catalog or an object stream.
		def record(at int, catalogs int[], objectStreams int[]) {
			let start = objectStart(at)
			return when start < 0
			let found = new Parser(data, start).integer()
			return when found is none
			let number = found
			grow(number)
			if kinds[number] != 2 {
				kinds[number] = 1
				offsets[number] = start
				indexes[number] = 0
			}
			cache.delete(number)
			let head = indexOf(data, "endobj", at, at + 400)
			let window = (head < 0) ?? ((at + 400).min(data.len()), head)
			catalogs.push(number) when indexOf(data, "/Catalog", at, window) >= 0
			objectStreams.push(number) when indexOf(data, "/ObjStm", at, window) >= 0
		}

		// objectStart returns where `n g` begins before the `obj` keyword at the
		// position, -1 when the keyword is not preceded by two integers.
		def objectStart(at int) int {
			let i = at - 1
			for i >= 0 && isWhite(int(data[i])) {
				i--
			}
			let genEnd = i
			for i >= 0 && data[i] >= 48 && data[i] <= 57 {
				i--
			}
			return -1 when i == genEnd || i < 0 || !isWhite(int(data[i]))
			for i >= 0 && isWhite(int(data[i])) {
				i--
			}
			let numEnd = i
			for i >= 0 && data[i] >= 48 && data[i] <= 57 {
				i--
			}
			return -1 when i == numEnd || numEnd - i > 8
			return -1 when i >= 0 && isRegular(int(data[i]))
			return i + 1
		}

		// object returns the indirect object with the number, none when there is
		// none.
		def object(number int) ?PdfObject {
			let cached = cache.get(number)
			return cached unless cached is none
			return none when number < 0 || reading.hasKey(number)
			reading.set(number, true)
			let obj = fetch(number)
			if obj is none && !scanned && number < 8388608 {
				scan()
				obj = fetch(number)
			}
			reading.delete(number)
			return none when obj is none
			cache.set(number, obj)
			return obj
		}

		// fetch reads the object from where the cross-reference data says.
		def fetch(number int) ?PdfObject {
			return none when number >= kinds.len()
			let kind = kinds[number]
			return objectAt(offsets[number], number) when kind == 1
			if kind == 2 {
				let stream = objectStream(offsets[number])
				return none when stream is none
				return stream.object(number, indexes[number])
			}
			return none
		}

		// objectStream returns the decoded object stream with the number.
		def objectStream(number int) ?ObjectStream {
			let cached = streams.get(number)
			return cached unless cached is none
			let obj = object(number)
			return none when obj is none || obj.kind != PdfKind.Stream
			let count = obj.get("N")
			let first = obj.get("First")
			return none when count is none || first is none
			let body = decode(obj) onerror recover byte[]
			let stream = new ObjectStream(body, int(count.number), int(first.number))
			streams.set(number, stream)
			return stream
		}

		// objectAt parses the indirect object at the byte offset, none when no
		// `n g obj` stands there or its number is not the expected one (-1
		// accepts any).
		def objectAt(offset int, expected int) ?PdfObject {
			return none when offset < 0 || offset >= data.len()
			let p = new Parser(data, offset)
			let number = p.integer()
			let generation = p.integer()
			return none when number is none || generation is none
			return none when expected >= 0 && number != expected
			p.skipSpace()
			return none unless p.keywordAt("obj")
			p.pos += 3
			let obj = p.value()
			if obj.kind == PdfKind.Dictionary {
				p.skipSpace()
				if p.keywordAt("stream") {
					p.pos += 6
					p.pos++ when p.pos < data.len() && data[p.pos] == 13
					p.pos++ when p.pos < data.len() && data[p.pos] == 10
					obj.kind = PdfKind.Stream
					obj.data = streamBody(obj, p.pos)
					obj.objectNumber = number
					obj.generation = generation
				}
			}
			let s = security
			s.decryptStrings(obj, number, generation) when !(s is none) && number != encryptNo && !(obj.kind == PdfKind.Stream && resolve(obj.get("Type")).name == "XRef")
			return obj
		}

		// streamBody returns the bytes of a stream starting at the position:
		// `Length` of them when `endstream` follows, else up to `endstream`.
		def streamBody(dict PdfObject, start int) byte[] {
			let length = resolve(dict.get("Length"))
			if length.kind == PdfKind.Integer {
				let end = start + int(length.number)
				if end >= start && end <= data.len() {
					let p = new Parser(data, end)
					p.skipSpace()
					return data[start:end] when p.keywordAt("endstream")
				}
			}
			let end = indexOf(data, "endstream", start)
			end = data.len() when end < 0
			// The end of line before `endstream` is not part of the data.
			end-- when end > start && data[end - 1] == 10
			end-- when end > start && data[end - 1] == 13
			return data[start:end]
		}

		// resolve follows references to a direct value, the null object when
		// there is none.
		def resolve(value ?PdfObject) PdfObject {
			return new PdfObject() when value is none
			let current = value
			for let hops = 0; current.kind == PdfKind.Reference && hops < 32; hops++ {
				let target = object(current.objectNumber)
				return new PdfObject() when target is none
				current = target
			}
			return current
		}

		// decode undoes the filters of a stream. See PdfFile.decode.
		def decode(stream PdfObject) !byte[] {
			expects {
				assert stream.kind == PdfKind.Stream onerror fail "pdf: not a stream"
			}
			let body = stream.data
			let filters = filterNames(resolve(stream.get("Filter")))
			let params = resolve(stream.get("DecodeParms"))
			params = resolve(stream.get("DP")) when params.isNull()
			let s = security
			if !(s is none) && stream.objectNumber != encryptNo && !filters.includes("Crypt") {
				let typeName = resolve(stream.get("Type")).name
				body = s.decryptStream(body, stream.objectNumber, stream.generation) when typeName != "XRef" && !(typeName == "Metadata" && !s.encryptMetadata)
			}
			for let (i, filter) in filters {
				let param = new PdfObject()
				if params.kind == PdfKind.Array {
					param = resolve(params.items[i]) when i < params.items.len()
				} else {
					param = params
				}
				match filter {
					case "FlateDecode", "Fl":
						body = predict(inflate(body), param, self)
					case "LZWDecode", "LZW":
						body = predict(lzwDecode(body, param, self), param, self)
					case "ASCIIHexDecode", "AHx":
						body = asciiHexDecode(body)
					case "ASCII85Decode", "A85":
						body = ascii85Decode(body)
					case "RunLengthDecode", "RL":
						body = runLengthDecode(body)
					case "Crypt":
					case "DCTDecode", "DCT", "JPXDecode", "JBIG2Decode", "CCITTFaxDecode", "CCF":
						return body
					default:
						fail "pdf: unknown filter {filter}"
				}
			}
			return body
		}

		// filterNames returns the filters of a `Filter` entry in order.
		def filterNames(value PdfObject) string[] {
			let out = string[]
			if value.kind == PdfKind.Name {
				out.push(value.name)
			} else if value.kind == PdfKind.Array {
				for let (_, item) in value.items {
					let resolved = resolve(item)
					out.push(resolved.name) when resolved.kind == PdfKind.Name
				}
			}
			return out
		}

		// integer returns a number entry of a dictionary, the fallback when it
		// is missing or not a number.
		def integer(dict PdfObject, key string, fallback int = 0) int {
			let value = resolve(dict.get(key))
			return fallback unless value.kind == PdfKind.Integer || value.kind == PdfKind.Real
			return int(value.number)
		}

		// pages walks the page tree.
		def pages() PdfObject[] {
			let out = PdfObject[]
			let root = resolve(trailer.get("Root"))
			let seen = new map<int, bool>()
			collectPages(root.get("Pages"), new PdfObject(PdfKind.Dictionary), out, seen, 0)
			return out
		}

		def collectPages(ref ?PdfObject, inherited PdfObject, out PdfObject[], seen map<int, bool>, depth int) {
			return when ref is none || depth > maxDepth
			if ref.kind == PdfKind.Reference {
				return when seen.hasKey(ref.objectNumber)
				seen.set(ref.objectNumber, true)
			}
			let node = resolve(ref)
			return unless node.kind == PdfKind.Dictionary
			let kids = resolve(node.get("Kids"))
			let typeName = resolve(node.get("Type")).name
			if typeName == "Page" || (typeName != "Pages" && kids.kind != PdfKind.Array) {
				for let (key, value) in inherited.entries {
					node.entries.set(key, value) unless node.entries.hasKey(key)
				}
				out.push(node)
				return
			}
			let passed = new PdfObject(PdfKind.Dictionary)
			for let (_, key) in string["Resources", "MediaBox", "CropBox", "Rotate"] {
				let own = node.get(key)
				if !(own is none) {
					passed.entries.set(key, own)
				} else {
					let up = inherited.get(key)
					passed.entries.set(key, up) unless up is none
				}
			}
			return unless kids.kind == PdfKind.Array
			for let (_, kid) in kids.items {
				collectPages(kid, passed, out, seen, depth + 1)
			}
		}
	}

	// field reads a big-endian unsigned integer of the width at the offset.
	def field(data byte[], at int, width int) int {
		let value = 0
		for let i = 0; i < width; i++ {
			value = value << 8 | int(data[at + i])
		}
		return value
	}
}
