internal partial module std.formats.docs.pdf {
	use (
		std.bytes
		std.formats.docs::*
	)

	// Nesting deeper than this is treated as damage, so hostile input cannot
	// exhaust the stack.
	const maxDepth = 64

	// isWhite reports whether the byte is PDF white space.
	def isWhite(c int) bool {
		return c == 32 || c == 10 || c == 13 || c == 9 || c == 12 || c == 0
	}

	// isDelimiter reports whether the byte is one of `()<>[]{}/%`.
	def isDelimiter(c int) bool {
		return c == 40 || c == 41 || c == 60 || c == 62 || c == 91 || c == 93 || c == 123 || c == 125 || c == 47 || c == 37
	}

	// isRegular reports whether the byte belongs to a name, number or keyword.
	def isRegular(c int) bool {
		return !isWhite(c) && !isDelimiter(c)
	}

	// hexValue returns the value of a hexadecimal digit, -1 for any other byte.
	def hexValue(c int) int {
		return c - 48 when c >= 48 && c <= 57
		return c - 55 when c >= 65 && c <= 70
		return c - 87 when c >= 97 && c <= 102
		return -1
	}

	// textString reads the bytes of a text string: UTF-16 or UTF-8 behind a
	// byte order mark, PDFDocEncoding otherwise.
	def textString(data byte[]) string {
		let out = byte[]
		if data.len() >= 2 && ((data[0] == 0xfe && data[1] == 0xff) || (data[0] == 0xff && data[1] == 0xfe)) {
			// The byte order mark picks the order.
			return data.utf16(bytes.Endian.Big)
		} else if data.len() >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf {
			return string(data[3:])
		} else {
			for let i = 0; i < data.len(); i++ {
				let code = pdfDocEncoding[int(data[i])]
				code = int(data[i]) when code == 0 && (data[i] == 9 || data[i] == 10 || data[i] == 13)
				out.append(char(code)) unless code == 0
			}
		}
		return string(out)
	}

	// indexOf returns where the pattern first occurs in data within
	// [from, to), -1 when it does not.
	def indexOf(data byte[], pattern string, from int, to int = -1) int {
		let end = (to < 0 || to > data.len()) ?? (data.len(), to)
		let p = pattern.bytes()
		let first = p[0]
		for let i = from.max(0); i + p.len() <= end; i++ {
			continue unless data[i] == first
			let j = 1
			for j < p.len() && data[i + j] == p[j] {
				j++
			}
			return i when j == p.len()
		}
		return -1
	}

	// lastIndexOf returns where the pattern last occurs in data at or after
	// `from`, -1 when it does not.
	def lastIndexOf(data byte[], pattern string, from int = 0) int {
		let p = pattern.bytes()
		for let i = data.len() - p.len(); i >= from.max(0); i-- {
			let j = 0
			for j < p.len() && data[i + j] == p[j] {
				j++
			}
			return i when j == p.len()
		}
		return -1
	}

	// Parser reads PDF objects from bytes, starting at `pos`. It never fails:
	// damaged input reads as null objects, and every call makes progress.
	type Parser {
		data    byte[]
		pos     int
		// Whether `n g R` reads as a reference; off in content streams.
		refs    bool   = true
		// Set when `value` stopped at a keyword that ends an object (`endobj`,
		// `stream`, `obj`…) rather than reading a value.
		stopped bool

		def new(data byte[], pos int = 0) {
			self.data = data
			self.pos = pos
		}

		// atEnd reports whether the parser has read all bytes.
		def atEnd() bool {
			return pos >= data.len()
		}

		// peek returns the byte at the position, -1 at the end.
		def peek() int {
			return -1 when pos >= data.len()
			return int(data[pos])
		}

		// skipSpace moves past white space and comments.
		def skipSpace() {
			let n = data.len()
			for pos < n {
				let c = int(data[pos])
				if c == 37 {
					for pos < n && data[pos] != 10 && data[pos] != 13 {
						pos++
					}
				} else if isWhite(c) {
					pos++
				} else {
					return
				}
			}
		}

		// word reads a run of regular bytes: a keyword or an operator.
		def word() string {
			let start = pos
			for pos < data.len() && isRegular(int(data[pos])) {
				pos++
			}
			return string(data[start:pos])
		}

		// keywordAt reports whether the keyword stands at the position, followed
		// by a byte that ends it.
		def keywordAt(keyword string) bool {
			let k = keyword.bytes()
			return false when pos + k.len() > data.len()
			for let i = 0; i < k.len(); i++ {
				return false unless data[pos + i] == k[i]
			}
			return pos + k.len() == data.len() || !isRegular(int(data[pos + k.len()]))
		}

		// integer reads an unsigned decimal integer after white space, none when
		// none stands there.
		def integer() ?int {
			skipSpace()
			let start = pos
			let value = 0
			for pos < data.len() && data[pos] >= 48 && data[pos] <= 57 {
				value = value * 10 + int(data[pos]) - 48
				pos++
			}
			return none when pos == start
			return value
		}

		// value reads the next object.
		def value(depth int = 0) PdfObject {
			stopped = false
			skipSpace()
			return new PdfObject() when pos >= data.len()
			let c = int(data[pos])
			if c == 47 {
				pos++
				let out = new PdfObject(PdfKind.Name)
				out.name = nameValue()
				return out
			}
			if c == 40 {
				pos++
				return literalString()
			}
			if c == 60 {
				if pos + 1 < data.len() && data[pos + 1] == 60 {
					pos += 2
					return dictValue(depth + 1)
				}
				pos++
				return hexString()
			}
			if c == 91 {
				pos++
				return arrayValue(depth + 1)
			}
			return numberValue() when (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46
			if isRegular(c) {
				let start = pos
				let w = word()
				match w {
					case "true", "false":
						let out = new PdfObject(PdfKind.Boolean)
						out.boolean = w == "true"
						return out
					case "null":
						return new PdfObject()
					case "endobj", "stream", "endstream", "obj", "xref", "trailer", "startxref", "R":
						pos = start
						stopped = true
						return new PdfObject()
					default:
						return new PdfObject()
				}
			}
			pos++
			return new PdfObject()
		}

		// name reads a name after its slash, resolving `#xx` escapes.
		def nameValue() string {
			let start = pos
			let escaped = false
			for pos < data.len() && isRegular(int(data[pos])) {
				escaped = true when data[pos] == 35
				pos++
			}
			return string(data[start:pos]) unless escaped
			let out = byte[]
			for let i = start; i < pos; i++ {
				if data[i] == 35 && i + 2 < pos && hexValue(int(data[i + 1])) >= 0 && hexValue(int(data[i + 2])) >= 0 {
					out.push(byte(hexValue(int(data[i + 1])) * 16 + hexValue(int(data[i + 2]))))
					i += 2
				} else {
					out.push(data[i])
				}
			}
			return string(out)
		}

		// number reads an integer or a real, and a reference when `refs` is set
		// and `n g R` follows.
		def numberValue() PdfObject {
			let negative = false
			if data[pos] := 45 || 43 {
				negative = data[pos] == 45
				pos++
				// Some writers double the sign.
				pos++ when pos < data.len() && (data[pos] == 45 || data[pos] == 43)
			}
			let whole float = 0.0
			let digits = 0
			for pos < data.len() && data[pos] >= 48 && data[pos] <= 57 {
				whole = whole * 10.0 + float(int(data[pos]) - 48)
				pos++
				digits++
			}
			let real = false
			if pos < data.len() && data[pos] == 46 {
				real = true
				pos++
				let scale = 0.1
				for pos < data.len() && data[pos] >= 48 && data[pos] <= 57 {
					whole += scale * float(int(data[pos]) - 48)
					scale /= 10.0
					pos++
				}
			}
			let out = new PdfObject(real ?? (PdfKind.Real, PdfKind.Integer))
			out.number = negative ?? (-whole, whole)
			return out when real || negative || !refs || digits == 0

			// `n g R`
			let save = pos
			let generation = integer()
			if !(generation is none) {
				skipSpace()
				if pos < data.len() && data[pos] == 82 && (pos + 1 == data.len() || !isRegular(int(data[pos + 1]))) {
					pos++
					let ref = new PdfObject(PdfKind.Reference)
					ref.objectNumber = int(whole)
					ref.generation = generation
					return ref
				}
			}
			pos = save
			return out
		}

		// literal reads a `(…)` string after its opening parenthesis.
		def literalString() PdfObject {
			let out = byte[]
			let depth = 1
			let n = data.len()
			for pos < n {
				let c = data[pos]
				pos++
				if c == 92 {
					break when pos >= n
					let e = data[pos]
					pos++
					match int(e) {
						case 110:
							out.push(10)
						case 114:
							out.push(13)
						case 116:
							out.push(9)
						case 98:
							out.push(8)
						case 102:
							out.push(12)
						case 13:
							pos++ when pos < n && data[pos] == 10
						case 10:
						default:
							if e >= 48 && e <= 55 {
								let code = int(e) - 48
								for let k = 0; k < 2 && pos < n && data[pos] >= 48 && data[pos] <= 55; k++ {
									code = code * 8 + int(data[pos]) - 48
									pos++
								}
								out.push(byte(code & 0xff))
							} else {
								out.push(e)
							}
					}
				} else if c == 40 {
					depth++
					out.push(c)
				} else if c == 41 {
					depth--
					break when depth == 0
					out.push(c)
				} else if c == 13 {
					pos++ when pos < n && data[pos] == 10
					out.push(10)
				} else {
					out.push(c)
				}
			}
			let s = new PdfObject(PdfKind.String)
			s.data = out
			return s
		}

		// hex reads a `<…>` string after its opening bracket. An odd last digit
		// is followed by 0.
		def hexString() PdfObject {
			let out = byte[]
			let high = -1
			for pos < data.len() {
				let c = int(data[pos])
				pos++
				break when c == 62
				let v = hexValue(c)
				continue when v < 0
				if high < 0 {
					high = v
				} else {
					out.push(byte(high * 16 + v))
					high = -1
				}
			}
			out.push(byte(high * 16)) when high >= 0
			let s = new PdfObject(PdfKind.String)
			s.data = out
			return s
		}

		// array reads a `[…]` array after its opening bracket.
		def arrayValue(depth int) PdfObject {
			let out = new PdfObject(PdfKind.Array)
			for {
				skipSpace()
				break when pos >= data.len()
				if data[pos] == 93 {
					pos++
					break
				}
				break when depth > maxDepth
				let item = value(depth)
				break when stopped
				out.items.push(item)
			}
			stopped = false
			return out
		}

		// dictionary reads a `<<…>>` dictionary after its opening brackets. A key
		// without a value is left out.
		def dictValue(depth int) PdfObject {
			let out = new PdfObject(PdfKind.Dictionary)
			for {
				skipSpace()
				break when pos >= data.len()
				let c = data[pos]
				if c == 62 {
					pos++
					pos++ when pos < data.len() && data[pos] == 62
					break
				}
				break when depth > maxDepth
				if c != 47 {
					value(depth)
					break when stopped
					continue
				}
				pos++
				let key = nameValue()
				skipSpace()
				break when pos >= data.len()
				if data[pos] == 62 && pos + 1 < data.len() && data[pos + 1] == 62 {
					continue
				}
				let item = value(depth)
				break when stopped
				out.entries.set(key, item)
			}
			stopped = false
			return out
		}
	}
}
