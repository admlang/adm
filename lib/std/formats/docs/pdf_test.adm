partial module std.formats.docs {
	use (
		std.bytes
		std.data.compress.zlib
		std.data.encoding
		std.formats.image
		std.os
		std.testing
	)

	check "Pdf" {
		// Sample documents live in the repo, and `adm test` runs from its root.
		// A missing sample skips rather than fails.
		let sampleDir = "samples/documents/pdf/"

		// build writes a PDF of the object bodies, numbered from 1, with a
		// classic cross-reference table and the trailer entries given.
		internal def build(objects byte[][], trailer string = "") byte[] {
			let out = "%PDF-1.7\n".bytes()
			let offsets = int[]
			for let (i, body) in objects {
				offsets.push(out.len())
				out.push(..."{i + 1} 0 obj\n".bytes())
				out.push(...body)
				out.push(..."\nendobj\n".bytes())
			}
			let xref = out.len()
			out.push(..."xref\n0 {objects.len() + 1}\n0000000000 65535 f \n".bytes())
			for let (_, offset) in offsets {
				out.push(..."{offset.str().padStart(10, "0")} 00000 n \n".bytes())
			}
			out.push(..."trailer\n<</Size {objects.len() + 1}/Root 1 0 R{trailer}>>\nstartxref\n{xref}\n%%EOF\n".bytes())
			return out
		}

		// stream returns a stream object body holding the data.
		internal def stream(dict string, data byte[]) byte[] {
			let out = "<<{dict}/Length {data.len()}>>stream\n".bytes()
			out.push(...data)
			out.push(..."\nendstream".bytes())
			return out
		}

		internal def deflate(data byte[]) byte[] {
			let out = new bytes.Buffer()
			let w = new zlib.Writer(out)
			w.write(data) onerror recover 0
			w.close() onerror recover none
			return out.bytes()
		}

		// page returns the objects of a one-page document drawing the content
		// with Helvetica as F1, Helvetica-Bold as F2 and Courier as F3.
		internal def page(content string, extra byte[][] = byte[][], pageExtra string = "", catalogExtra string = "") byte[][] {
			let objects = byte[][
				"<</Type/Catalog/Pages 2 0 R{catalogExtra}>>".bytes(),
				"<</Type/Pages/Kids[3 0 R]/Count 1/MediaBox[0 0 612 792]>>".bytes(),
				"<</Type/Page/Parent 2 0 R/Resources<</Font<</F1 4 0 R/F2 5 0 R/F3 6 0 R>>/XObject<</Im1 8 0 R/Im2 9 0 R>>>>/Contents 7 0 R{pageExtra}>>".bytes(),
				"<</Type/Font/Subtype/Type1/BaseFont/Helvetica/Encoding/WinAnsiEncoding>>".bytes(),
				"<</Type/Font/Subtype/Type1/BaseFont/Helvetica-Bold/Encoding/WinAnsiEncoding>>".bytes(),
				"<</Type/Font/Subtype/Type1/BaseFont/Courier>>".bytes(),
				stream("", content.bytes())
			]
			objects.push(...extra)
			return objects
		}

		internal def pdf() Pdf {
			return new Pdf()
		}

		internal def decode(data byte[], password string = "") !Document {
			let codec = new Pdf()
			codec.password = password
			return codec.decode(data)
		}

		internal def kinds(doc Document) string {
			let out = string[]
			for let (_, block) in doc.blocks {
				out.push("{block.kind}")
			}
			return out.join(",")
		}

		internal def shape(items Inline[]) string {
			let out = ""
			for let (_, item) in items {
				match item.kind {
					case InlineKind.Text:
						out += item.content
					case InlineKind.Bold:
						out += "<b>" + shape(item.children) + "</b>"
					case InlineKind.Italic:
						out += "<i>" + shape(item.children) + "</i>"
					case InlineKind.Code:
						out += "<code>" + item.content + "</code>"
					case InlineKind.Link:
						out += "<a " + item.url + ">" + shape(item.children) + "</a>"
					default:
						out += item.plainText()
				}
			}
			return out
		}

		internal def sample(name string) ?byte[] {
			let data = os.readFile(sampleDir + name)
			return none when data is error
			return data
		}

