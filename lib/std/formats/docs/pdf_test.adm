			"BFjbmSNrHxOxRlimcT2xKAC4ysnFLOiU/TFJWKBMMU9ZpgS0kfh0QwwZT14LJJKTE4pg41P2JGy5FJ2XBM4RMTdEUs0Dv/K4" +
			"qIp53VnGbIMf8pJeyKFlj4R0uTAywE6M6eJDJtCaIhLsuEkprWvEgXkZeXJM06FPSmskw0SkVq5fWZJWZYkvKTgGgMvpAiOm" +
			"AKMSUmsfCPK4RWScicIXWuRPaWliZXELI6ILQo0aESTofIkklNKIixAxICA="

		// fails reports whether decoding the data fails.
		internal def fails(data byte[], password string = "") bool {
			decode(data, password) onerror (e error) {
				return true
			}
			return false
		}

		// numbered returns the indirect object, the null object when missing.
		internal def numbered(file PdfFile, number int) PdfObject {
			let found = file.object(number)
			return new PdfObject() when found is none
			return found
		}

		@test()
		def TestObjectSyntax() !none {
			let objects = page("")
			objects.push("<</Int 42/Neg -3/Real -.5/Str(a\\(b\\)\\n\\101 c)/Hex<48 65 6C6C 6F7>/Name/A#20B/Arr[1 [2] <</K true>> null]/Ref 1 0 R/Bool false>>".bytes())
			let file = try pdf().open(build(objects))
			assert file.version == "1.7"
			let obj = numbered(file, 8)
			assert obj.kind == PdfKind.Dictionary
			assert file.resolve(obj.get("Int")).number == 42.0
			assert file.resolve(obj.get("Neg")).number == -3.0
			let real = file.resolve(obj.get("Real"))
			assert real.kind == PdfKind.Real && real.number == -0.5
			assert string(file.resolve(obj.get("Str")).data) == "a(b)\nA c"
			assert string(file.resolve(obj.get("Hex")).data) == "Hellop"
			assert file.resolve(obj.get("Name")).name == "A B"
			let arr = file.resolve(obj.get("Arr"))
			assert arr.items.len() == 4
			assert arr.items[1].items[0].number == 2.0
			assert arr.items[2].get("K") is PdfObject
			assert arr.items[3].isNull()
			let ref = file.resolve(obj.get("Bool"))
			assert ref.kind == PdfKind.Boolean && !ref.boolean
			let target = obj.get("Ref")
			fail "no reference" when target is none
			assert target.kind == PdfKind.Reference && target.objectNumber == 1
			assert file.resolve(target).get("Pages") is PdfObject
			assert file.root().kind == PdfKind.Dictionary
			let pages = file.pages()
			assert pages.len() == 1
			let box = file.resolve(pages[0].get("MediaBox"))
			assert box.items.len() == 4 && box.items[2].number == 612.0
			assert file.object(99) is none
			assert !file.encrypted
			return none
		}

		@test()
		def TestXrefStreamAndObjectStream() !none {
			let members = string[
				"<</Type/Catalog/Pages 2 0 R>>",
				"<</Type/Pages/Kids[3 0 R]/Count 1>>",
				"<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 4 0 R>>>>/Contents 6 0 R>>",
				"<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>"
			]
			let head = ""
			let body = ""
			for let (i, member) in members {
				head += "{i + 1} {body.len()} "
				body += member + "\n"
			}
			let out = "%PDF-1.5\n".bytes()
			let offsets = int[0, 0, 0, 0, 0, 0, 0, 0]
			offsets[5] = out.len()
			out.push(..."5 0 obj\n".bytes())
			out.push(...stream("/Type/ObjStm/N 4/First {head.len()}/Filter/FlateDecode", deflate((head + body).bytes())))
			out.push(..."\nendobj\n".bytes())
			offsets[6] = out.len()
			out.push(..."6 0 obj\n".bytes())
			out.push(...stream("/Filter/FlateDecode", deflate("BT /F1 12 Tf 72 700 Td (Packed away) Tj ET".bytes())))
			out.push(..."\nendobj\n".bytes())
			offsets[7] = out.len()

			// Rows of W [1 2 1], each behind the PNG Up predictor.
			let rows = byte[][byte[0, 0, 0, 255]]
			for let k = 0; k < 4; k++ {
				rows.push(byte[2, 0, 5, byte(k)])
			}
			for let n = 5; n <= 7; n++ {
				rows.push(byte[1, byte(offsets[n] >> 8), byte(offsets[n] & 0xff), 0])
			}
			let predicted = byte[]
			let previous = byte[0, 0, 0, 0]
			for let (_, row) in rows {
				predicted.push(2)
				for let c = 0; c < 4; c++ {
					predicted.push(byte((int(row[c]) - int(previous[c])) & 0xff))
				}
				previous = row
			}
			out.push(..."7 0 obj\n".bytes())
			out.push(...stream("/Type/XRef/Size 8/W[1 2 1]/Root 1 0 R/Filter/FlateDecode/DecodeParms<</Predictor 12/Columns 4>>", deflate(predicted)))
			out.push(..."\nendobj\nstartxref\n{offsets[7]}\n%%EOF\n".bytes())

			let file = try pdf().open(out)
			assert file.version == "1.5"
			assert file.pages().len() == 1
			assert file.resolve(numbered(file, 4).get("BaseFont")).name == "Helvetica"
			let doc = try decode(out)
			assert doc.plainText() == "Packed away"
			return none
		}

		@test()
		def TestIncrementalUpdate() !none {
			let base = build(page("BT /F1 12 Tf 72 700 Td (Old text) Tj ET", byte[][
				"<<>>".bytes(), "<<>>".bytes(), "<</Title(First)/Author(Ann)>>".bytes()
			]), "/Info 10 0 R")
			let text = string(base)
			let previous = text.slice(text.indexOf("startxref") + 10).trim().split("\n")[0]
			let update = base.clone()
			let infoAt = update.len()
			update.push(..."10 0 obj\n<</Title(Second)>>\nendobj\n".bytes())
			let contentAt = update.len()
			update.push(..."7 0 obj\n".bytes())
			update.push(...stream("", "BT /F1 12 Tf 72 700 Td (New text) Tj ET".bytes()))
			update.push(..."\nendobj\n".bytes())
			let xref = update.len()
			update.push(..."xref\n7 1\n{contentAt.str().padStart(10, "0")} 00000 n \n10 1\n{infoAt.str().padStart(10, "0")} 00000 n \n".bytes())
			update.push(..."trailer\n<</Size 11/Root 1 0 R/Info 10 0 R/Prev {previous}>>\nstartxref\n{xref}\n%%EOF\n".bytes())

			let doc = try decode(update)
			assert doc.title == "Second"
			assert doc.authors.len() == 0
			assert doc.plainText() == "New text"
			let file = try pdf().open(update)
			assert numbered(file, 4).kind == PdfKind.Dictionary
			assert file.trailer.get("Prev") is PdfObject
			return none
		}

		@test()
		def TestDamagedCrossReference() !none {
			let good = string(build(page("BT /F1 12 Tf 72 700 Td (Still readable) Tj ET")))

			// Bytes inserted after the header move every offset.
			let shifted = "%PDF-1.7\n% inserted\n" + good.slice(9)
			let doc = try decode(shifted.bytes())
			assert doc.plainText() == "Still readable"

			// startxref pointing past the end.
			let lost = good.slice(0, good.indexOf("startxref")) + "startxref\n999999\n%%EOF\n"
			doc = try decode(lost.bytes())
			assert doc.plainText() == "Still readable"

			// Neither cross-reference data nor trailer.
			let bare = good.slice(0, good.indexOf("xref"))
			doc = try decode(bare.bytes())
			assert doc.plainText() == "Still readable"

			assert fails("%PDF-1.4\nnothing here".bytes())
			return none
		}

		@test()
		def TestFilters() !none {
			let numbers = string[]
			for let i = 0; i < 400; i++ {
				numbers.push("{i * i * 7919 % 100003}")
			}
			let objects = page("")
			objects.push(stream("/Filter/ASCIIHexDecode", "48 65 6c6c6f 2>".bytes()))
			objects.push(stream("/Filter/A85", "<~87cURD]i,\"Ebo7~>".bytes()))
			objects.push(stream("/Filter/RunLengthDecode", byte[2, 97, 98, 99, 253, 120, 128]))
			objects.push(stream("/Filter/LZWDecode", try encoding.base64decode(lzwNumbers)))
			let rows = byte[2, 1, 2, 3, 2, 1, 1, 1]
			objects.push(stream("/Filter[/AHx/Fl]/DecodeParms[null<</Predictor 12/Columns 3>>]", deflate(rows).hex().bytes()))
			objects.push(stream("/Filter[/FlateDecode/DCTDecode]", deflate(byte[0xff, 0xd8, 0xff, 0xd9])))
			objects.push(stream("/Filter/Unknown", byte[1]))
			let file = try pdf().open(build(objects))
			assert string(try file.decode(numbered(file, 8))) == "Hello "
			assert string(try file.decode(numbered(file, 9))) == "Hello World"
			assert string(try file.decode(numbered(file, 10))) == "abcxxxx"
			assert string(try file.decode(numbered(file, 11))) == numbers.join(" ")
			assert (try file.decode(numbered(file, 12))).equals(byte[1, 2, 3, 2, 3, 4])
			assert (try file.decode(numbered(file, 13))).equals(byte[0xff, 0xd8, 0xff, 0xd9])
			let unknown = file.decode(numbered(file, 14)) onerror recover byte[9]
			assert unknown.equals(byte[9])
			let notStream = file.decode(numbered(file, 4)) onerror recover byte[9]
			assert notStream.equals(byte[9])
			return none
		}

		@test()
		def TestEncryption() !none {
			for let (_, fixture) in string[rc4Revision2, rc4Revision3, aesRevision4] {
				let data = try encoding.base64decode(fixture)
				let doc = try decode(data)
				assert doc.title == "Locked"
				assert doc.plainText() == "Secret text"
				let owner = try decode(data, "owner")
				assert owner.plainText() == "Secret text"
				let file = try pdf().open(data)
				assert file.encrypted
			}
			let data = try encoding.base64decode(aesRevision6)
			assert fails(data)
			let user = try decode(data, "pw")
			assert user.title == "Locked" && user.plainText() == "Secret text"
			let owner = try decode(data, "owner")
			assert owner.plainText() == "Secret text"
			assert fails(data, "nope")
			return none
		}

		@test()
		def TestStructure() !none {
			let content = string[
				"BT /F1 20 Tf 72 720 Td (Annual Report) Tj ET",
				"BT /F1 14 Tf 72 690 Td (Summary) Tj ET",
				"BT /F1 11 Tf 13 TL 72 660 Td (This report covers the whole year in review, with enough words to fill a line) Tj T* (and it ends on this shorter line.) Tj ET",
				"BT /F1 11 Tf 13 TL 72 620 Td (The second paragraph starts after a gap and carries a word broken as an exam-) Tj T* (ple across the break, then stops.) Tj ET",
				"BT /F1 11 Tf 13 TL 72 580 Td (\\225 First point) Tj T* (\\225 Second point) Tj T* (1. One) Tj T* (2. Two) Tj ET",
				"BT /F1 11 Tf 72 510 Td (Plain text and ) Tj /F2 11 Tf (bold words) Tj /F1 11 Tf ( in one line.) Tj ET",
				"BT /F3 10 Tf 12 TL 72 480 Td (let x = 1) Tj T* (  print\\(x\\)) Tj ET",
				"BT /F1 11 Tf 72 440 Td (Visit the site) Tj ET",
				"BT /F1 11 Tf 72 410 Td [(Kerned)-300(words)10(stay)] TJ ET",
				"BT /F1 9 Tf 300 40 Td (1) Tj ET"
			].join("\n")
			let link = "<</Type/Annot/Subtype/Link/Rect[70 436 150 452]/A<</S/URI/URI(https://example.com/)>>>>".bytes()
			let doc = try decode(build(page(content, byte[][byte[], byte[], link], "/Annots[10 0 R]")))
			assert kinds(doc) == "Heading,Heading,Paragraph,Paragraph,List,List,Paragraph,Code,Paragraph,Paragraph"
			let blocks = doc.blocks
			assert doc.title == "Annual Report"
			assert blocks[0].level == 1 && blocks[1].level == 2 && blocks[1].plainText() == "Summary"
			assert blocks[2].plainText() == "This report covers the whole year in review, with enough words to fill a line and it ends on this shorter line."
			assert blocks[3].plainText() == "The second paragraph starts after a gap and carries a word broken as an example across the break, then stops."
			assert !blocks[4].ordered && blocks[4].children.len() == 2 && blocks[4].children[1].plainText() == "Second point"
			assert blocks[5].ordered && blocks[5].start == 1 && blocks[5].plainText() == "One\nTwo"
			assert shape(blocks[6].inlines) == "Plain text and <b>bold words</b> in one line."
			assert blocks[7].content == "let x = 1\n  print(x)"
			assert shape(blocks[8].inlines) == "<a https://example.com/>Visit the site</a>"
			assert blocks[9].plainText() == "Kerned wordsstay"
			return none
		}

		@test()
		def TestFonts() !none {
			let simpleMap = "/CIDInit /ProcSet findresource begin 12 dict begin begincmap 1 begincodespacerange <00> <FF> endcodespacerange 1 beginbfchar <01> <0048> endbfchar 1 beginbfrange <02> <03> <0069> endbfrange endcmap"
			let wideMap = "begincmap 1 begincodespacerange <0000> <FFFF> endcodespacerange 1 beginbfrange <0001> <0002> [<0041> <004200430044>] endbfrange endcmap"
			let objects = byte[][
				"<</Type/Catalog/Pages 2 0 R>>".bytes(),
				"<</Type/Pages/Kids[3 0 R]/Count 1>>".bytes(),
				"<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 4 0 R/F2 5 0 R/F3 6 0 R>>>>/Contents 7 0 R>>".bytes(),
				"<</Type/Font/Subtype/Type1/BaseFont/Custom/FirstChar 65/LastChar 67/Widths[500 500 500]/Encoding<</Type/Encoding/Differences[65/fi/Aacute/uni263A]>>>>".bytes(),
				"<</Type/Font/Subtype/TrueType/BaseFont/ABCDEF+Mapped/FirstChar 1/LastChar 3/Widths[600 300 300]/ToUnicode 8 0 R>>".bytes(),
				"<</Type/Font/Subtype/Type0/BaseFont/Wide/Encoding/Identity-H/DescendantFonts[9 0 R]/ToUnicode 10 0 R>>".bytes(),
				stream("", "BT /F1 12 Tf 72 700 Td (ABC) Tj ET BT /F2 12 Tf 72 650 Td <010203> Tj ET BT /F3 12 Tf 72 600 Td <00010002> Tj ET".bytes()),
				stream("", simpleMap.bytes()),
				"<</Type/Font/Subtype/CIDFontType2/BaseFont/Wide/CIDSystemInfo<</Registry(Adobe)/Ordering(Identity)/Supplement 0>>/W[1[500 1000]]/DW 1000>>".bytes(),
				stream("", wideMap.bytes())
			]
			let doc = try decode(build(objects))
			assert doc.plainText() == "fiÁ☺\n\nHij\n\nABCD"
			return none
		}

		@test()
		def TestMetadata() !none {
			let info = "<</Title<FEFF005200E900730075006D00E9>/Author(Ann Lee; Bo Chen)/Subject(Sales)/Keywords(a, b)/CreationDate(D:20260921103000+02'00')/ModDate(D:2026)>>".bytes()
			let doc = try decode(build(page("", byte[][byte[], byte[], info]), "/Info 10 0 R"))
			assert doc.title == "Résumé"
			assert doc.authors.join("|") == "Ann Lee|Bo Chen"
			assert doc.metadata["subject"] == "Sales" && doc.metadata["keywords"] == "a, b"
			assert doc.metadata["modified"] == "2026-01-01T00:00:00Z"
			let date = doc.date
			fail "no date" when date is none
			assert date.str() == "2026-09-21T08:30:00Z"

			let xmp = "<x:xmpmeta xmlns:x=\"adobe:ns:meta/\"><rdf:RDF><rdf:Description rdf:about=\"\"><dc:title><rdf:Alt><rdf:li xml:lang=\"x-default\">XMP &amp; Title</rdf:li></rdf:Alt></dc:title><dc:creator><rdf:Seq><rdf:li>Ann</rdf:li><rdf:li>Bo</rdf:li></rdf:Seq></dc:creator><xmp:CreateDate>2025-01-02T03:04:05Z</xmp:CreateDate></rdf:Description></rdf:RDF></x:xmpmeta>"
			let described = try decode(build(page("", byte[][byte[], byte[], stream("/Type/Metadata/Subtype/XML", xmp.bytes())], "", "/Lang(en-GB)/Metadata 10 0 R")))
			assert described.title == "XMP & Title"
			assert described.authors.join("|") == "Ann|Bo"
			assert described.language == "en-GB"
			let created = described.date
			fail "no XMP date" when created is none
			assert created.str() == "2025-01-02T03:04:05Z"
			return none
		}

		@test()
		def TestOutlineHeadings() !none {
			let content = string[
				"BT /F1 11 Tf 13 TL 72 700 Td (Chapter One) Tj T* T* (Body text under the chapter that runs on for a while to look like a line.) Tj ET",
				"BT /F1 11 Tf 13 TL 72 640 Td (Part A) Tj T* T* (More body text under the part that runs on for a while to look like a line.) Tj ET"
			].join("\n")
			let outline = byte[][
				byte[], byte[],
				"<</Type/Outlines/First 11 0 R/Last 11 0 R/Count 2>>".bytes(),
				"<</Title(Chapter One)/Parent 10 0 R/First 12 0 R/Last 12 0 R>>".bytes(),
				"<</Title(Part A)/Parent 11 0 R>>".bytes()
			]
			let doc = try decode(build(page(content, outline, "", "/Outlines 10 0 R")))
			assert kinds(doc) == "Heading,Paragraph,Heading,Paragraph"
			assert doc.blocks[0].level == 1 && doc.blocks[2].level == 2
			assert doc.blocks[2].plainText() == "Part A"
			return none
		}

		@test()
		def TestImages() !none {
			let jpeg = byte[0xff, 0xd8, 0xff, 0xd9]
			let content = "q 100 0 0 50 72 600 cm /Im1 Do Q BT /F1 11 Tf 72 580 Td (Caption line) Tj ET q 20 0 0 10 72 500 cm /Im2 Do Q q 20 0 0 10 72 450 cm /Im1 Do Q"
			let images = byte[][
				stream("/Type/XObject/Subtype/Image/Width 1/Height 1/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter/DCTDecode", jpeg),
				stream("/Type/XObject/Subtype/Image/Width 2/Height 1/ColorSpace/DeviceRGB/BitsPerComponent 8", byte[255, 0, 0, 0, 0, 255])
			]
			let doc = try decode(build(page(content, images)))
			assert kinds(doc) == "Image,Paragraph,Image,Image"
			assert doc.blocks[0].source == "image1.jpg" && doc.blocks[2].source == "image2.png" && doc.blocks[3].source == "image1.jpg"
			assert doc.resources.len() == 2
			let stored = doc.resource("image1.jpg")
			fail "no JPEG" when stored is none
			assert stored.equals(jpeg)
			let png = doc.resource("image2.png")
			fail "no PNG" when png is none
			let picture = try image.load(png)
			assert picture.size().width == 2
			let left = try picture.at(0, 0)
			let right = try picture.at(1, 0)
			assert left.red == 255 && left.blue == 0 && right.blue == 255 && right.red == 0
			return none
		}

		@test()
		def TestLoad() !none {
			let data = build(page("BT /F1 12 Tf 72 700 Td (Found by signature) Tj ET"))
			let doc = try load(data)
			assert doc.plainText() == "Found by signature"
			assert pdf().matchSignature(new bytes.Buffer(data))
			assert !pdf().matchSignature(new bytes.Buffer("\{\\rtf1 x\}".bytes()))
			assert pdf().extension[0] == ".pdf"
			return none
		}

		@test()
		def TestSamples() !none {
			let report = sample("sample_report.pdf")
			if !(report is none) {
				let doc = try decode(report)
				assert doc.title == "Sample Business Report"
				let titles = string[]
				for let (_, h) in doc.headings() {
					titles.push(h.plainText())
				}
				assert titles.join("|") == "Sample Business Report|Executive Summary|Financial Overview|Recommendations"
			}
			let word = sample("sample-2-one-page.pdf")
			if !(word is none) {
				let doc = try decode(word)
				assert doc.authors.join("|") == "Jorge Hernando Duarte Alvarez"
				assert doc.language == "es-CO"
				assert kinds(doc) == "Heading,Paragraph,Paragraph,Paragraph,Paragraph,Paragraph"
			}
			let small = sample("sample-1-small-size.pdf")
			if !(small is none) {
				let doc = try decode(small)
				assert doc.plainText() == "https://samples-files.com"
			}
			return none
		}

		@test()
		def TestRoundTrip() !none {
			let long = "Paragraphs longer than a line are broken into lines that fill the width of the page and are joined again when the file is read back, so the words survive the trip unchanged."
			let doc = new Document("Round Trip")
			doc.authors.push("Ann Lee")
			doc.language = "en-US"
			doc.metadata.set("subject", "Testing")
			doc.heading(1, "Round Trip")
			doc.paragraph(text("A paragraph with "), bold("bold"), text(", "), italic("italic"), text(" and "), code("code"), text(" and a "), link("link", "https://example.com/"), text("."))
			doc.heading(2, "Details")
			doc.paragraph(long)
			doc.list(string["First", "Second"])
			doc.list(string["One", "Two"], true)
			doc.code("", "let x = 1\n  print(x)")
			let picture = new image.Image(16, 8)
			let raw = picture.raw()
			for let i = 0; i < raw.len(); i += 4 {
				raw[i] = 0
				raw[i + 1] = 128
				raw[i + 2] = 255
				raw[i + 3] = 255
			}
			doc.image("dot.png", try new image.PNG().encode(picture))
			doc.pageBreak()
			doc.paragraph("On the second page.")

			let codec = pdf()
			codec.font = PdfFont.Times
			let data = codec.encode(doc)
			let file = try pdf().open(data)
			assert file.pages().len() == 2

			let back = try decode(data)
			assert back.title == "Round Trip"
			assert back.authors.join("|") == "Ann Lee"
			assert back.language == "en-US"
			assert back.metadata["subject"] == "Testing"
			assert kinds(back) == "Heading,Paragraph,Heading,Paragraph,List,List,Code,Image,Paragraph"
			let blocks = back.blocks
			assert blocks[0].level == 1 && blocks[2].level == 2
			assert shape(blocks[1].inlines) == "A paragraph with <b>bold</b>, <i>italic</i> and <code>code</code> and a <a https://example.com/>link</a>."
			assert blocks[3].plainText() == long
			assert blocks[4].plainText() == "First\nSecond"
			assert blocks[5].ordered && blocks[5].plainText() == "One\nTwo"
			assert blocks[6].content == "let x = 1\n  print(x)"
			let stored = back.resource(blocks[7].source)
			fail "image lost" when stored is none
			let again = try image.load(stored)
			let pixel = try again.at(1, 1)
			assert again.size().width == 16 && pixel.green == 128 && pixel.blue == 255
			assert blocks[8].plainText() == "On the second page."

			let markdown = new Markdown()
			let original = markdown.encode(doc)
			assert original.contains("Round Trip")
			return none
		}
	}
}
