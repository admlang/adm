partial module std.formats.docs {
	use (
		std.bytes
		std.io
	)

	// PlainText is the plain text codec: a document laid out with nothing but
	// characters, for a terminal, an e-mail or a `.txt` file.
	//
	// Encoding wraps paragraphs to `width` and honours their alignment (left,
	// center, right, justify). A level 1 heading is underlined with `═`, a level 2
	// heading with `─`. Lists hang under `•`, `◦`, `▪` or their number, a task shows
	// `☐` or `☑`. A table is drawn with box characters, its columns aligned, its
	// cells wrapped when the table is wider than `width`. A quote runs beside a `│`
	// bar, code is indented by four spaces, a rule is a line of `─`, a page break
	// is a form feed. Bold is written `*so*`, italic `_so_`, strike `~so~`; a
	// link adds its `<url>`; a footnote becomes `[1]` with the notes after the
	// body. Colors, roles, underline, images' data, named styles, attributes and
	// cell spans are left out, as is Raw content of formats other than "txt".
	//
	// Decoding reads the same layout back: underlined headings, bullets, numbers
	// and tasks, boxed tables with their column alignments, `│` quotes, indented
	// code, rules, form feeds, centered and right-aligned paragraphs. Wrapped
	// lines are joined. The text itself is taken as it is: `*so*` stays
	// `*so*`. The title is the level 1 heading the document starts with.
	//
	// Widths are counted in characters, so text in scripts whose characters take
	// two columns does not line up.
	//
	// Example: Print a table
	// ```example
	// use std.formats.docs::(Document, PlainText)
	//
	// let doc = new Document()
	// doc.table(["Region", "Sales"], [["North", "120"], ["South", "95"]])
	// let plain = new PlainText()
	// print(plain.encode(doc))
	// ```
	@codec("Plain Text")
	type PlainText {
		// Widest line written, in characters. A code line, or a table with more
		// columns than fit, goes past it.
		width int = 80

		mimeType string[] {
			def get() string[] {
				return string["text/plain"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".txt", ".text"]
			}
		}

		// matchSignature is always false: plain text carries no signature, so it
		// is found by its file extension.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// decode reads the whole reader as plain text. Any text is valid, so it
		// fails only when the reader does.
		def decode(reader io.Reader) !Document {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(string(source.bytes()))
		}

		// decode reads the text as a plain text document.
		def decode(source string) Document {
			let decoder = new PlainTextDecoder()
			return decoder.decode(source)
		}

		// encode writes the document as plain text. Fails when the writer does.
		def encode(doc Document, writer io.Writer) !none {
			try writer.write(encode(doc).bytes())
		}

		// encode returns the document as plain text.
		def encode(doc Document) string {
			let encoder = new PlainTextEncoder(width)
			return encoder.encode(doc)
		}
	}

	// PlainTextEncoder lays a Document out as lines of text.
	internal type PlainTextEncoder {
		width int
		// How many lists the block being written sits in, which picks the bullet.
		depth int
		// Footnotes met so far, written after the body in this order.
		notes Inline[]

		def new(width int) {
			self.width = width < 20 ?? (20, width)
			notes = Inline[]
		}

		def encode(doc Document) string {
			let lines = front(doc)
			lines.push(...blocks(doc.body.children, width, false))

			lines.push("", "─".repeat(20)) when notes.len() > 0
			for let i = 0; i < notes.len(); i++ {
				let mark = "[{i + 1}] "
				lines.push(...hanging(mark, blocks(notes[i].note, width - mark.len(), false)))
			}
			return lines.join("\n") + "\n"
		}

		// front returns the centered title, authors and date, and the blank line
		// after them. The title is left out when the document starts with it as a
		// level 1 heading.
		def front(doc Document) string[] {
			let out = string[]

			let title = doc.title
			if title != "" && doc.body.children.len() > 0 {
				let opening = doc.body.children[0]
				title = "" when opening.kind == BlockKind.Heading && opening.level == 1 && opening.plainText() == title
			}
			if title != "" {
				let lines = title.wrap(width).split("\n")
				lines.push("═".repeat(widest(lines)))
				out.push(...aligned(lines, width, Alignment.Center))
			}
			out.push(...aligned(doc.authors.join(", ").wrap(width).split("\n"), width, Alignment.Center)) when doc.authors.len() > 0

			let date = doc.date
			if !(date is none) {
				let stamp = date.str()
				stamp = stamp[:10] when stamp.endsWith("T00:00:00Z")
				out.push(...aligned(string[stamp], width, Alignment.Center))
			}
			out.push("") when out.len() > 0
			return out
		}

		def widest(lines string[]) int {
			let out = 0
			for let (_, line) in lines {
				out = line.len() when line.len() > out
			}
			return out
		}

		// hanging puts the mark in front of the first line and indents the others
		// under the text that follows it.
		def hanging(mark string, lines string[]) string[] {
			let out = string[]
			for let (i, line) in lines {
				if i == 0 {
					out.push(mark + line)
				} else if line == "" {
					out.push("")
				} else {
					out.push(" ".repeat(mark.len()) + line)
				}
			}
			out.push(mark.trimEnd()) when out.len() == 0
			return out
		}

		// aligned places each line in a field of the width. Trailing spaces are
		// never written.
		def aligned(lines string[], field int, alignment Alignment) string[] {
			let out = string[]
			match alignment {
				case Alignment.Center:
					for let (_, line) in lines {
						out.push(line.pad(field).trimEnd())
					}
				case Alignment.Right:
					for let (_, line) in lines {
						out.push(line.padStart(field))
					}
				case Alignment.Justify:
					return lines.join("\n").justify(field).split("\n")
				default:
					return lines
			}
			return out
		}

		// wrapped returns inline text as lines no wider than the field, keeping
		// the line breaks it holds.
		def wrapped(content string, field int) string[] {
			let out = string[]
			for let (_, part) in content.split("\n") {
				out.push(...part.trim().wrap(field).split("\n"))
			}
			return out
		}

		// blocks returns the lines of the blocks, a blank line between two of them
		// unless they are tight.
		def blocks(items Block[], field int, tight bool) string[] {
			let out = string[]
			for let (_, item) in items {
				let lines = block(item, field)
				continue when lines.len() == 0
				out.push("") unless tight || out.len() == 0
				out.push(...lines)
			}
			return out
		}

		def block(item Block, field int) string[] {
			match item.kind {
				case BlockKind.Heading:
					let lines = wrapped(inlines(item.inlines), field)
					lines.push("═".repeat(widest(lines))) when item.level <= 1
					lines.push("─".repeat(widest(lines))) when item.level == 2
					return aligned(lines, field, item.alignment)
				case BlockKind.Paragraph:
					return aligned(wrapped(inlines(item.inlines), field), field, item.alignment)
				case BlockKind.List:
					return list(item, field)
				case BlockKind.Table:
					return table(item, field)
				case BlockKind.Image:
					let caption = inlines(item.inlines)
					let label = caption == "" ?? ("[Image]", "[Image: " + caption + "]")
					return wrapped(label + " (" + item.source + ")", field)
				case BlockKind.Code:
					let out = string[]
					for let (_, line) in item.content.split("\n") {
						out.push((line == "") ?? ("", "    " + line))
					}
					return out
				case BlockKind.Quote:
					let out = string[]
					for let (_, line) in blocks(item.children, field - 2, false) {
						out.push((line == "") ?? ("│", "│ " + line))
					}
					return out
				case BlockKind.Rule:
					return string["─".repeat(field)]
				case BlockKind.PageBreak:
					return string[string(char(12))]
				case BlockKind.Raw:
					return item.content.split("\n") when (item.format := "txt" || "text")
					return string[]
				default:
					return blocks(item.children, field, false)
			}
		}

		def list(item Block, field int) string[] {
			let bullets = string["• ", "◦ ", "▪ "]
			let tight = isTight(item)
			let out = string[]
			let number = item.start
			for let (_, entry) in item.children {
				let mark = item.ordered ?? ("{number}. ", bullets[depth % 3])
				number++
				let state = entry.checked
				mark = state ?? ("☑ ", "☐ ") unless state is none

				depth++
				let body = string[]
				if entry.kind == BlockKind.Item {
					body = blocks(entry.children, field - mark.len(), tight)
				} else {
					body = block(entry, field - mark.len())
				}
				depth--

				out.push("") unless tight || out.len() == 0
				out.push(...hanging(mark, body))
			}
			return out
		}

		// isTight reports a list whose items are one paragraph each, with or
		// without a list below it: such a list is written without blank lines.
		def isTight(item Block) bool {
			for let (_, entry) in item.children {
				continue unless entry.kind == BlockKind.Item
				for let (i, child) in entry.children {
					continue when child.kind == BlockKind.Paragraph && i == 0
					continue when child.kind == BlockKind.List && isTight(child)
					return false
				}
			}
			return true
		}

		def table(item Block, field int) string[] {
			let columns = item.columns()
			return string[] when columns == 0

			// The text of every cell, and the width each column would like.
			let texts = string[][]
			let widths = int[]
			for let i = 0; i < columns; i++ {
				widths.push(1)
			}
			for let (_, row) in item.children {
				let cells = string[]
				for let column = 0; column < columns; column++ {
					let content = ""
					content = cellText(row.children[column]) when column < row.children.len()
					widths[column] = content.len() when content.len() > widths[column]
					cells.push(content)
				}
				texts.push(cells)
			}

			// Narrow the widest column, one character at a time, until the table
			// fits or no column can give more.
			let room = field - (3 * columns + 1)
			for total(widths) > room {
				let target = 0
				for let (column, size) in widths {
					target = column when size > widths[target]
				}
				break when widths[target] <= 4
				widths[target] = widths[target] - 1
			}

			// Wrap the cells. A word that cannot be cut makes its column grow back.
			let cells = string[][][]
			let folded = false
			for let (_, row) in texts {
				let lines = string[][]
				for let (column, content) in row {
					let parts = content.wrap(widths[column], true).split("\n")
					widths[column] = widest(parts) when widest(parts) > widths[column]
					folded = true when parts.len() > 1
					lines.push(parts)
				}
				cells.push(lines)
			}

			let out = string[border("┌", "─", "┬", "┐", widths)]
			for let (index, row) in cells {
				let height = 1
				for let (_, parts) in row {
					height = parts.len() when parts.len() > height
				}
				for let line = 0; line < height; line++ {
					let text = "│"
					for let (column, parts) in row {
						let part = ""
						part = parts[line] when line < parts.len()
						text += " " + cell(part, widths[column], columnAlignment(item, column)) + " │"
					}
					out.push(text)
				}

				continue when index + 1 >= cells.len()
				let header = item.children[index].header
				if header && !item.children[index + 1].header {
					out.push(border("╞", "═", "╪", "╡", widths))
				} else if folded {
					out.push(border("├", "─", "┼", "┤", widths))
				}
			}
			out.push(border("└", "─", "┴", "┘", widths))
			return out
		}

		def total(widths int[]) int {
			let out = 0
			for let (_, size) in widths {
				out += size
			}
			return out
		}

		def columnAlignment(item Block, column int) Alignment {
			return Alignment.Default when column >= item.alignments.len()
			return item.alignments[column]
		}

		def cell(content string, size int, alignment Alignment) string {
			match alignment {
				case Alignment.Right:
					return content.padStart(size)
				case Alignment.Center:
					return content.pad(size)
				default:
					return content.padEnd(size)
			}
		}

		def border(left string, fill string, middle string, right string, widths int[]) string {
			let parts = string[]
			for let (_, size) in widths {
				parts.push(fill.repeat(size + 2))
			}
			return left + parts.join(middle) + right
		}

		// cellText returns the content of a table cell on one line.
		def cellText(item Block) string {
			let parts = string[]
			for let (_, child) in item.children {
				let part = child.plainText()
				part = inlines(child.inlines) when (child.kind := BlockKind.Paragraph || BlockKind.Heading)
				parts.push(part) unless part == ""
			}
			return parts.join(" ").replace("\n", " ")
		}

		def inlines(items Inline[]) string {
			let out = ""
			for let (_, item) in items {
				out += inline(item)
			}
			return out
		}

		def inline(item Inline) string {
			match item.kind {
				case InlineKind.Text, InlineKind.Code:
					return item.content
				case InlineKind.Bold:
					return "*" + inlines(item.children) + "*"
				case InlineKind.Italic:
					return "_" + inlines(item.children) + "_"
				case InlineKind.Strike:
					return "~" + inlines(item.children) + "~"
				case InlineKind.Link:
					let label = inlines(item.children)
					return label when item.url == "" || item.url == label
					return item.url when label == ""
					return label + " <" + item.url + ">"
				case InlineKind.Image:
					return "[" + inlines(item.children) + "]"
				case InlineKind.LineBreak:
					return "\n"
				case InlineKind.Footnote:
					notes.push(item)
					return "[{notes.len()}]"
				case InlineKind.Raw:
					return item.content when (item.format := "txt" || "text")
					return ""
				default:
					return inlines(item.children)
			}
		}
	}

	// PlainTextMarker describes the list marker a line starts with.
	internal struct PlainTextMarker {
		// Column where the content of the item starts.
		width   int
		ordered bool
		start   int
		// Task state: 0 for no task, 1 for an open one, 2 for a done one.
		task    int
	}

	// PlainTextDecoder reads the layout PlainTextEncoder writes, and what people
	// type by hand in the same spirit.
	internal type PlainTextDecoder {
		def decode(source string) Document {
			let feed = string(char(12))
			let doc = new Document()
			let content = source.replace("\r\n", "\n").replace("\r", "\n").replace("\t", "    ")
			// A form feed stands alone, whatever it was typed next to.
			readBlocks(content.replace(feed, "\n\n" + feed + "\n\n").split("\n"), doc.body)

			readNotes(doc)
			if doc.body.children.len() > 0 {
				let opening = doc.body.children[0]
				doc.title = opening.plainText() when opening.kind == BlockKind.Heading && opening.level == 1
			}
			readFront(doc)
			return doc
		}

		// readFront takes the centered title with the centered authors and date
		// under it out of the body, where the encoder's front lines were read as a
		// heading and a paragraph.
		def readFront(doc Document) {
			let blocks = doc.body.children
			return when blocks.len() < 2
			let title = blocks[0]
			let credits = blocks[1]
			return unless title.kind == BlockKind.Heading && title.level == 1 && title.alignment == Alignment.Center
			return unless credits.kind == BlockKind.Paragraph && credits.alignment == Alignment.Center

			let names = credits.plainText()
			let cut = names.len() - 10
			if cut >= 0 {
				let parsed = documentDate(names[cut:]) onerror recover none
				if !(parsed is none) {
					doc.date = parsed
					names = names[:cut].trim()
				}
			}
			for let (_, name) in names.split(", ") {
				doc.authors.push(name.trim()) unless name.trim() == ""
			}

			let rest = Block[]
			for let i = 2; i < blocks.len(); i++ {
				rest.push(blocks[i])
			}
			doc.body.children = rest
		}

		// readNotes turns the `[1] …` paragraphs after the closing short rule into
		// footnotes, and every `[1]` in the text into a reference to them.
		def readNotes(doc Document) {
			let blocks = doc.body.children
			let at = -1
			for let i = blocks.len() - 1; i >= 0; i-- {
				if blocks[i].kind == BlockKind.Rule {
					at = i
					break
				}
				break unless blocks[i].kind == BlockKind.Paragraph && noteNumber(blocks[i].plainText()) > 0
			}
			return when at < 0 || at == blocks.len() - 1

			let notes = new map<int, Block>()
			for let i = at + 1; i < blocks.len(); i++ {
				let content = blocks[i].plainText()
				let number = noteNumber(content)
				let note = new Block(BlockKind.Paragraph)
				note.inlines.push(text(content[content.indexOf("]") + 1:].trim()))
				notes.set(number, note)
			}

			let rest = Block[]
			for let i = 0; i < at; i++ {
				rest.push(blocks[i])
			}
			doc.body.children = rest
			doc.walk(def (block Block) bool {
				refer(block, notes)
				return true
			})
		}

		// noteNumber returns the number a `[12] …` line starts with, 0 for any
		// other line.
		def noteNumber(content string) int {
			return 0 unless content.startsWith("[")
			let close = content.indexOf("]")
			return 0 when close < 2
			let digits = content[1:close]
			return 0 unless digits.isNumeric()
			return digits.toInt<int>()
		}

		// refer splits the text of the block at every `[n]` that names a note.
		def refer(block Block, notes map<int, Block>) {
			let out = Inline[]
			for let (_, item) in block.inlines {
				if item.kind != InlineKind.Text {
					out.push(item)
					continue
				}

				let content = item.content
				let start = 0
				let open = content.indexOf("[")
				for open >= 0 {
					let number = noteNumber(content[open:])
					let note = notes.get(number)
					if number == 0 || note is none {
						open = content.indexOf("[", open + 1)
						continue
					}
					out.push(text(content[start:open])) when open > start
					let reference = new Inline(InlineKind.Footnote)
					reference.note.push(note)
					out.push(reference)
					start = content.indexOf("]", open) + 1
					open = content.indexOf("[", start)
				}
				out.push(text(content[start:])) when start < content.len()
			}
			block.inlines = out
		}

		def indentOf(line string) int {
			let i = 0
			for i < line.len() && line[i] == ' ' {
				i++
			}
			return i
		}

		def isBlank(line string) bool {
			return line.trim() == ""
		}

		// ruleOf returns 1 for a line of `═` or `=`, 2 for a line of `─` or `-`,
		// 0 for any other line. Three characters make a line.
		def ruleOf(line string) int {
			let content = line.trim()
			return 0 when content.len() < 3
			return 1 when content.replace("═", "") == "" || content.replace("=", "") == ""
			return 2 when content.replace("─", "") == "" || content.replace("-", "") == ""
			return 0
		}

		// marker returns the list marker the line starts with, none when it starts
		// with none.
		def marker(line string) ?PlainTextMarker {
			let indent = indentOf(line)
			let content = line[indent:]
			return none when content.len() < 2

			let first = content[0]
			if first := '•' || '◦' || '▪' || '‣' || '-' || '*' || '☐' || '☑' {
				return none unless content[1] == ' '
				let task = 0
				task = 1 when first == '☐'
				task = 2 when first == '☑'
				return PlainTextMarker{width: indent + 2, ordered: false, start: 1, task: task}
			}
			return none unless first.isDigit()

			let digits = 0
			for digits < content.len() && digits < 9 && content[digits].isDigit() {
				digits++
			}
			return none when digits + 1 >= content.len()
			let after = content[digits]
			return none unless (after := '.' || ')')
			return none unless content[digits + 1] == ' '
			return PlainTextMarker{width: indent + digits + 2, ordered: true, start: content[:digits].toInt<int>(), task: 0}
		}

		def readBlocks(lines string[], parent Block) {
			let feed = string(char(12))
			let i = 0
			for i < lines.len() {
				let line = lines[i]
				let content = line.trim()
				if content == "" {
					i++
					continue
				}
				if content == feed {
					parent.pageBreak()
					i++
					continue
				}
				if content.startsWith("┌") {
					i = readTable(lines, i, parent)
					continue
				}
				if ruleOf(line) > 0 {
					parent.rule()
					i++
					continue
				}
				if content == "│" || content.startsWith("│ ") {
					i = readQuote(lines, i, parent)
					continue
				}
				if !(marker(line) is none) {
					i = readList(lines, i, parent)
					continue
				}
				i = readText(lines, i, parent)
			}
		}

		def readQuote(lines string[], from int, parent Block) int {
			let body = string[]
			let i = from
			for i < lines.len() {
				let content = lines[i].trimStart()
				break unless content == "│" || content.startsWith("│ ")
				body.push(content.len() > 2 ?? (content[2:], ""))
				i++
			}
			readBlocks(body, parent.quote())
			return i
		}

		def readList(lines string[], from int, parent Block) int {
			let first = marker(lines[from])
			return from + 1 when first is none

			let list = new Block(BlockKind.List)
			list.ordered = first.ordered
			list.start = first.start

			let i = from
			for i < lines.len() {
				let current = marker(lines[i])
				break when current is none
				break unless current.ordered == first.ordered && indentOf(lines[i]) == indentOf(lines[from])

				// The item is its first line and what is indented under it.
				let body = string[lines[i][current.width:]]
				i++
				for i < lines.len() {
					let line = lines[i]
					if isBlank(line) {
						let next = i
						for next < lines.len() && isBlank(lines[next]) {
							next++
						}
						break when next >= lines.len() || indentOf(lines[next]) < current.width
						for i < next {
							body.push("")
							i++
						}
						continue
					}
					break when indentOf(line) < current.width
					body.push(line[current.width:])
					i++
				}

				let item = new Block(BlockKind.Item)
				item.checked = current.task == 2 unless current.task == 0
				readBlocks(body, item)
				list.add(item)

				let next = i
				for next < lines.len() && isBlank(lines[next]) {
					next++
				}
				break when next >= lines.len() || marker(lines[next]) is none
				i = next
			}
			parent.add(list)
			return i
		}

		// readText reads what has no mark of its own: a heading with its underline,
		// code indented by four spaces, or a paragraph, which is centered or
		// right-aligned when its lines are laid out so.
		def readText(lines string[], from int, parent Block) int {
			let run = string[]
			let i = from
			for i < lines.len() {
				let line = lines[i]
				break when isBlank(line)
				break when i > from && (line.trim().startsWith("┌") || line.trim().startsWith("│ ") || !(marker(line) is none))

				let level = ruleOf(line)
				if level > 0 && i > from {
					let heading = new Block(BlockKind.Heading)
					heading.level = level
					heading.alignment = alignmentOf(run)
					heading.inlines.push(text(joined(run)))
					parent.add(heading)
					return i + 1
				}
				run.push(line.trimEnd())
				i++
			}

			let indent = indentOf(run[0])
			for let (_, line) in run {
				indent = indentOf(line) when indentOf(line) < indent
			}
			if indent == 4 {
				let body = string[]
				for let (_, line) in run {
					body.push(line[4:])
				}
				i = readCode(lines, i, body)
				parent.code("", body.join("\n"))
				return i
			}

			let paragraph = parent.paragraph(joined(run))
			paragraph.alignment = alignmentOf(run)
			return i
		}

		// readCode adds the indented lines that follow a code block after blank
		// lines to it, and returns the index of the line after the block.
		def readCode(lines string[], from int, body string[]) int {
			let i = from
			for i < lines.len() {
				let next = i
				for next < lines.len() && isBlank(lines[next]) {
					next++
				}
				break when next >= lines.len() || next == i || indentOf(lines[next]) < 4
				for i < next {
					body.push("")
					i++
				}
				for i < lines.len() && !isBlank(lines[i]) && indentOf(lines[i]) >= 4 {
					body.push(lines[i][4:].trimEnd())
					i++
				}
			}
			return i
		}

		def joined(run string[]) string {
			let parts = string[]
			for let (_, line) in run {
				parts.push(line.trim())
			}
			return parts.join(" ")
		}

		// alignmentOf tells how indented lines are laid out: Right when they all
		// end in one column, Center otherwise. Lines starting at the margin are
		// Default.
		def alignmentOf(run string[]) Alignment {
			let edge = run[0].len()
			let flush = true
			for let (_, line) in run {
				return Alignment.Default when indentOf(line) == 0
				flush = false unless line.len() == edge
			}
			return flush && run.len() > 1 ?? (Alignment.Right, Alignment.Center)
		}

		def readTable(lines string[], from int, parent Block) int {
			// With lines between the rows, a row is every line up to the next one;
			// without them each line is a row.
			let ruled = false
			let end = from
			for end < lines.len() {
				let content = lines[end].trim()
				ruled = true when content.startsWith("├")
				break when content.startsWith("└")
				break unless (content.startsWith("┌") || content.startsWith("│") || content.startsWith("├") || content.startsWith("╞"))
				end++
			}

			let table = new Block(BlockKind.Table)
			let votes = int[][]
			let pending = string[][]
			for let i = from + 1; i < end; i++ {
				let content = lines[i].trim()
				if content.startsWith("│") {
					let raw = content.trimPrefix("│").trimSuffix("│").split("│")
					for let (column, part) in raw {
						pending.push(string[]) when column >= pending.len()
						votes.push(int[0, 0, 0]) when column >= votes.len()
						pending[column].push(part.trim())
						vote(votes[column], part)
					}
					continue when ruled
				}
				addRow(table, pending, content.startsWith("╞"))
				pending = string[][]
			}
			addRow(table, pending, false)

			for let (_, tally) in votes {
				table.alignments.push(elected(tally))
			}
			parent.add(table)
			return end < lines.len() ?? (end + 1, end)
		}

		// vote counts how a cell sits between its bars: [left, center, right]. A
		// cell that fills its column, or is empty, says nothing.
		def vote(tally int[], part string) {
			return when part.trim() == ""
			let left = indentOf(part)
			let right = part.len() - part.trimEnd().len()
			if left > 1 && right > 1 {
				tally[1] = tally[1] + 1
			} else if left > 1 {
				tally[2] = tally[2] + 1
			} else if right > 2 {
				// One spare column on the right is what centering an odd
				// remainder leaves too, so it takes two to say "left".
				tally[0] = tally[0] + 1
			}
		}

		def elected(tally int[]) Alignment {
			return Alignment.Right when tally[2] > 0 && tally[0] == 0 && tally[1] == 0
			return Alignment.Center when tally[1] > 0 && tally[0] == 0 && tally[2] == 0
			return Alignment.Default
		}

		// addRow turns the cell lines gathered so far into a Row. With header set
		// the row and every row before it are header rows.
		def addRow(table Block, pending string[][], header bool) {
			if pending.len() > 0 {
				let row = new Block(BlockKind.Row)
				for let (_, parts) in pending {
					let cell = new Block(BlockKind.Cell)
					let content = parts.filter(part => part != "").join(" ")
					cell.paragraph(content) unless content == ""
					row.add(cell)
				}
				table.add(row)
			}
			return unless header
			for let (_, row) in table.children {
				row.header = true
			}
		}
	}
}
