partial module std.formats.docs {
	use (
		std.bytes
		std.gfx.color
		std.testing
	)

	check "PlainText" {
		internal def plain(width int) PlainText {
			let codec = new PlainText()
			codec.width = width
			return codec
		}

		internal def rendered(doc Document, width int) string[] {
			return plain(width).encode(doc).trimEnd("\n").split("\n")
		}

		@test()
		def TestHeadingsAndParagraphs() {
			let doc = new Document()
			doc.heading(1, "Summary")
			doc.heading(2, "Part")
			doc.heading(3, "Detail")
			doc.paragraph(text("Revenue "), bold("grew"), text(" by "), italic("a lot"), text(", "), strike("not"), text(" see "), link("the site", "https://a.example"), text("."))
			doc.paragraph("centered").alignment = Alignment.Center
			doc.paragraph("right").alignment = Alignment.Right

			let expected = string[
				"Summary", "═══════", "",
				"Part", "────", "",
				"Detail", "",
				"Revenue *grew* by _a lot_, ~not~ see the", "site <https://a.example>.", "",
				"                centered", "",
				"                                   right"
			]
			assert rendered(doc, 40).join("\n") == expected.join("\n")
		}

		@test()
		def TestJustify() {
			let doc = new Document()
			doc.paragraph("aa bb cc dd ee ff gg hh ii jj kk ll mm").alignment = Alignment.Justify
			let lines = rendered(doc, 20)
			assert lines.len() == 2
			assert lines[0].len() == 20
			assert lines[0].startsWith("aa") && lines[0].endsWith("gg")
			assert lines[1] == "hh ii jj kk ll mm"
		}

		@test()
		def TestLists() {
			let doc = new Document()
			let items = doc.list(string["one", "two words that wrap around here"])
			items.children[0].list(string["nested"]).children[0].list(string["third"])
			let tasks = doc.list(string["done", "open"])
			tasks.children[0].checked = true
			tasks.children[1].checked = false
			doc.list(string["ninth", "tenth"], true).start = 9

			let expected = string[
				"• one", "  ◦ nested", "    ▪ third", "• two words that", "  wrap around here", "",
				"☑ done", "☐ open", "",
				"9. ninth", "10. tenth"
			]
			assert rendered(doc, 20).join("\n") == expected.join("\n")
		}

		@test()
		def TestTable() {
			let doc = new Document()
			let table = doc.table(string["Region", "Sales", "Note"], string[][string["North", "120", "ok"], string["South", "95"]])
			table.alignments[1] = Alignment.Right
			table.alignments[2] = Alignment.Center

			let expected = string[
				"┌────────┬───────┬──────┐",
				"│ Region │ Sales │ Note │",
				"╞════════╪═══════╪══════╡",
				"│ North  │   120 │  ok  │",
				"│ South  │    95 │      │",
				"└────────┴───────┴──────┘"
			]
			assert rendered(doc, 80).join("\n") == expected.join("\n")
		}

		@test()
		def TestTableWraps() {
			let doc = new Document()
			doc.table(string["Key", "Text"], string[][string["a", "one two three four five six"], string["b", "short"]])

			let expected = string[
				"┌─────┬──────────────┐",
				"│ Key │ Text         │",
				"╞═════╪══════════════╡",
				"│ a   │ one two      │",
				"│     │ three four   │",
				"│     │ five six     │",
				"├─────┼──────────────┤",
				"│ b   │ short        │",
				"└─────┴──────────────┘"
			]
			let lines = rendered(doc, 22)
			assert lines.join("\n") == expected.join("\n")
			for let (_, line) in lines {
				assert line.len() <= 22
			}
		}

		@test()
		def TestOtherBlocks() {
			let doc = new Document("Report")
			doc.authors.push("Ann", "Bo")
			doc.quote().paragraph("quoted words that wrap")
			doc.code("adm", "let x = 1\n\nprint(x)")
			doc.rule()
			doc.image("logo.png", "Logo")
			doc.pageBreak()
			doc.raw("html", "<hr>")
			doc.raw("txt", "as is")
			doc.paragraph(text("Claim"), footnote("Proof."), text(" and "), colored("red", new color.Color("red")), underline("line"))

			let expected = string[
				"       Report", "       ══════", "      Ann, Bo", "",
				"│ quoted words that", "│ wrap", "",
				"    let x = 1", "", "    print(x)", "",
				"────────────────────", "",
				"[Image: Logo]", "(logo.png)", "",
				string(char(12)), "",
				"as is", "",
				"Claim[1] and redline", "",
				"────────────────────", "[1] Proof."
			]
			assert rendered(doc, 20).join("\n") == expected.join("\n")
		}

		@test()
		def TestDecode() {
			let source = string[
				"Title", "=====", "",
				"A paragraph that was", "wrapped by hand.", "",
				"Part", "----", "",
				"- one", "  * nested", "- two", "",
				"1) first", "2) second", "",
				"☑ done", "☐ open", "",
				"│ quoted", "│ words", "",
				"    code", "", "      more", "",
				"---", "",
				"            centered", "",
				"        right one", "        and right"
			].join("\n")
			let doc = plain(80).decode(source + string(char(12)) + "last")

			assert doc.title == "Title"
			assert doc.blocks.len() == 13
			assert doc.blocks[0].level == 1
			assert doc.blocks[1].plainText() == "A paragraph that was wrapped by hand."
			assert doc.blocks[2].level == 2
			assert doc.blocks[3].children.len() == 2
			assert doc.blocks[3].children[0].children[1].kind == BlockKind.List
			assert doc.blocks[4].ordered
			assert doc.blocks[4].children.len() == 2

			let done = doc.blocks[5].children[0].checked
			assert !(done is none)
			assert done unless done is none
			let open = doc.blocks[5].children[1].checked
			assert !open unless open is none

			assert doc.blocks[6].kind == BlockKind.Quote
			assert doc.blocks[6].plainText() == "quoted words"
			assert doc.blocks[7].kind == BlockKind.Code
			assert doc.blocks[7].content == "code\n\n  more"
			assert doc.blocks[8].kind == BlockKind.Rule
			assert doc.blocks[9].alignment == Alignment.Center
			assert doc.blocks[10].alignment == Alignment.Right
			assert doc.blocks[10].plainText() == "right one and right"
			assert doc.blocks[11].kind == BlockKind.PageBreak
			assert doc.blocks[12].plainText() == "last"
		}

		@test()
		def TestDecodeTable() {
			let source = string[
				"┌─────┬──────────────┬─────┐",
				"│ Key │ Text         │   N │",
				"╞═════╪══════════════╪═════╡",
				"│ a   │ one two      │   1 │",
				"│     │ three four   │     │",
				"├─────┼──────────────┼─────┤",
				"│ b   │ short        │  22 │",
				"└─────┴──────────────┴─────┘"
			].join("\n")
			let doc = plain(80).decode(source)

			let table = doc.blocks[0]
			assert table.kind == BlockKind.Table
			assert table.children.len() == 3
			assert table.columns() == 3
			assert table.children[0].header
			assert !table.children[1].header
			assert table.alignments[0] == Alignment.Default
			assert table.alignments[2] == Alignment.Right

			let folded = table.cell(1, 1)
			assert folded.plainText() == "one two three four" unless folded is none
			let blank = table.cell(1, 2)
			assert blank.plainText() == "1" unless blank is none
			assert !(folded is none) && !(blank is none)
		}

		@test()
		def TestRoundTrip() {
			let doc = new Document("Guide")
			doc.authors.push("Ann Lee")
			doc.heading(1, "Start")
			doc.paragraph(text("Text with a note"), footnote("The note."), text(" that wraps around the narrow page."))
			doc.list(string["one", "two"]).children[1].list(string["deep"], true)
			doc.table(string["a", "b"], string[][string["1", "2"]]).alignments[1] = Alignment.Right
			doc.quote().code("", "quoted code")
			doc.paragraph("the end").alignment = Alignment.Center

			let codec = plain(30)
			let once = codec.encode(doc)
			let back = codec.decode(once)
			assert back.title == "Guide"
			assert back.authors.len() == 1 && back.authors[0] == "Ann Lee"
			assert back.blocks[1].inlines[1].kind == InlineKind.Footnote
			assert back.blocks[1].inlines[1].note[0].plainText() == "The note."
			assert codec.encode(back) == once
		}

		@test()
		def TestCodecRegistry() !none {
			let doc = try load(new bytes.Buffer("Title\n═════\n\nBody".bytes()), ".txt")
			assert doc.title == "Title"

			let out = new bytes.Buffer()
			try doc.write(out, "txt")
			assert string(out.bytes()) == "Title\n═════\n\nBody\n"

			let codec = new PlainText()
			assert codec.width == 80
			assert !codec.matchSignature(new bytes.Buffer("x".bytes()))
		}
	}
}
