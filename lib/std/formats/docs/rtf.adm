partial module std.formats.docs {
	use (
		std.bytes
		std.gfx.color
		std.io
		std.time
	)

	// Destinations whose content a reader leaves out: headers and footers,
	// document tables it has no use for, fallback text and bookkeeping.
	internal const rtfSkipped = " header headerl headerr headerf footer footerl footerr footerf themedata colorschememapping datastore latentstyles xmlnstbl rsidtbl mmathPr generator listtext pntext pntxta pntxtb leveltext levelnumbers listname revtim printim buptim nonshppict filetbl revtbl pgdsctbl ftnsep ftnsepc ftncn aftnsep aftnsepc aftncn annotation atnid atnauthor atndate atnref atrfstart atrfend template docvar userprops xe tc tcn txe bkmkstart bkmkend shp shpinst shprslt do fldtype formfield datafield objdata objclass objname blipuid picprop falt panose wgrffmtfilter pgp ipgp background pnseclvl listpicture fchars lchars protusertbl keycode nesttableprops mmathPict "

	// Characters 0x80 to 0x9f of Windows-1252, the rest of the code page being
	// Latin-1.
	internal let rtfWindows1252 = int[
		0x20ac, 0x81, 0x201a, 0x192, 0x201e, 0x2026, 0x2020, 0x2021, 0x2c6, 0x2030, 0x160, 0x2039, 0x152, 0x8d, 0x17d, 0x8f,
		0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014, 0x2dc, 0x2122, 0x161, 0x203a, 0x153, 0x9d, 0x17e, 0x178
	]

	// Windows language identifiers and the BCP 47 tags they stand for.
	internal let rtfLanguages = string[
		"1025 ar-SA", "1026 bg-BG", "1027 ca-ES", "1028 zh-TW", "1029 cs-CZ", "1030 da-DK", "1031 de-DE", "1032 el-GR",
		"1033 en-US", "1034 es-ES", "1035 fi-FI", "1036 fr-FR", "1037 he-IL", "1038 hu-HU", "1040 it-IT", "1041 ja-JP",
		"1042 ko-KR", "1043 nl-NL", "1044 nb-NO", "1045 pl-PL", "1046 pt-BR", "1048 ro-RO", "1049 ru-RU", "1050 hr-HR",
		"1051 sk-SK", "1053 sv-SE", "1054 th-TH", "1055 tr-TR", "1057 id-ID", "1058 uk-UA", "1060 sl-SI", "1061 et-EE",
		"1062 lv-LV", "1063 lt-LT", "1066 vi-VN", "1081 hi-IN", "2052 zh-CN", "2057 en-GB", "2070 pt-PT", "3082 es-ES",
		"3081 en-AU", "4105 en-CA", "3084 fr-CA", "2055 de-CH", "3079 de-AT", "2067 nl-BE", "2060 fr-BE", "1086 ms-MY"
	]

	// Rtf is the Rich Text Format codec, the format of WordPad, TextEdit and
	// every word processor's "Save as RTF".
	//
	// Decoding reads paragraphs with their alignment and named style; headings
	// from the outline level or a "heading N" style; bold, italic, underline,
	// strike, text and background colors; runs in a monospace font as code,
	// whole paragraphs of them (or in a code style) as Code blocks; quotes from
	// a "Quote" style; bulleted and numbered lists, nested by level, from the
	// list table or the older `\pn` numbering, `☐`/`☑` starting a task item;
	// tables with header rows and merged cells; hyperlinks and INCLUDEPICTURE
	// fields; embedded pictures, stored in `Document.resources` as
	// `image1.png` and so on; footnotes; line and page breaks; a paragraph with
	// a bottom border and no text as a Rule; title, author, subject, keywords,
	// creation time and language from the info group. The title falls back to
	// the level 1 heading the document starts with. Headers, footers, comments,
	// hidden text, floating shapes and nested tables' layout are left out.
	// `\'hh` characters are read as Windows-1252 whatever the code page.
	//
	// Encoding writes the same constructs back, with the page set up by the
	// fields below. Named styles become paragraph styles. Left alignment reads
	// back as Default, a quote's entirely italic text loses its italic, a
	// heading's entirely bold text its bold. Blocks other than paragraphs and
	// lists inside a list item, and anything but paragraphs inside a quote,
	// read back after the list or quote. Theme roles, code languages and Raw
	// content of formats other than "rtf" are left out; an image that is not
	// in the resources is written as an INCLUDEPICTURE field.
	//
	// Example: Convert to Markdown
	// ```example
	// use std.formats.docs::(Markdown, Rtf)
	//
	// let rtf = new Rtf()
	// let doc = rtf.decode("\{\\rtf1 \{\\b Hello\} world\\par\}")
	// let markdown = new Markdown()
	// print(markdown.encode(doc))
	// ```
	@codec("Rich Text Format")
	type Rtf {
		// Page width, in twips (a twentieth of a point). US Letter by default.
		pageWidth  int    = 12240
		// Page height, in twips.
		pageHeight int    = 15840
		// Margin on each side of the page, in twips.
		margin     int    = 1440
		// Font of the text.
		font       string = "Times New Roman"
		// Font of code blocks and code spans.
		codeFont   string = "Courier New"
		// Size of the text, in points. Headings and code are sized from it.
		fontSize   int    = 12

		mimeType string[] {
			def get() string[] {
				return string["application/rtf", "text/rtf"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".rtf"]
			}
		}

		// matchSignature reports whether the reader starts with `{\rtf`.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(5)
			let n = r.read(b) onerror recover 0
			return n == 5 && string(b) == "\{\\rtf"
		}

		// decode reads the whole reader as RTF. Damaged input decodes as far as
		// it goes, so it fails only when the reader does.
		def decode(reader io.Reader) !Document {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes())
		}

		// decode reads the text as RTF.
		def decode(source string) Document {
			return decode(source.bytes())
		}

		// decode reads the bytes as RTF.
		def decode(source byte[]) Document {
			let decoder = new RtfDecoder()
			return decoder.decode(source)
		}

		// encode writes the document as RTF. Fails when the writer does.
		def encode(doc Document, writer io.Writer) !none {
			try writer.write(encode(doc).bytes())
		}

		// encode returns the document as RTF text, 7-bit ASCII.
		def encode(doc Document) string {
			let encoder = new RtfEncoder(self, doc)
			return encoder.encode()
		}
	}

	// RtfDest is what the text of a group is read into.
	internal enum RtfDest {
		Body,
		Skip,
		Fonts,
		Colors,
		Styles,
		Info,
		InfoField,
		Lists,
		Overrides,
		Picture,
		Instruction,
		Numbering,
		// An object or `\upr` group: text left out until its `\result` or `\ud`.
		Fallback,
	}

	// RtfFrame is the state of one `{…}` group: its destination and the
	// character formatting in force.
	internal type RtfFrame {
		dest      RtfDest = RtfDest.Body
		// Whether `\*` opened the group, so an unknown destination is skipped.
		starred   bool
		// The table entry, field or note this group opened, finished when it
		// closes.
		opens     string
		bold      bool
		italic    bool
		underline bool
		strike    bool
		hidden    bool
		font      int     = -1
		fg        int
		bg        int
		// Characters of fallback text after a `\u`.
		uc        int     = 1

		def new() {}

		// child returns the state a nested group starts with.
		def child() RtfFrame {
			let out = new RtfFrame()
			out.dest = dest
			out.bold = bold
			out.italic = italic
			out.underline = underline
			out.strike = strike
			out.hidden = hidden
			out.font = font
			out.fg = fg
			out.bg = bg
			out.uc = uc
			return out
		}

		// reset drops the character formatting, as `\plain` does.
		def reset() {
			bold = false
			italic = false
			underline = false
			strike = false
			hidden = false
			font = -1
			fg = 0
			bg = 0
		}
	}

	// RtfPara is the paragraph formatting in force.
	internal type RtfPara {
		alignment  Alignment = Alignment.Default
		styleId    int
		// Outline level, 0 for a level 1 heading, -1 when not given.
		outline    int       = -1
		inTable    bool
		// `\ls` list override, 0 for none, -1 for an old-style bullet, -2 for an
		// old-style number.
		list       int
		level      int
		// First number of an old-style numbered list.
		start      int       = 1
		// Left indent, in twips.
		indent     int
		border     bool
		pageBefore bool

		def new() {}

		def copy() RtfPara {
			let out = new RtfPara()
			out.alignment = alignment
			out.styleId = styleId
			out.outline = outline
			out.inTable = inTable
			out.list = list
			out.level = level
			out.start = start
			out.indent = indent
			out.border = border
			out.pageBefore = pageBefore
			return out
		}
	}

	// RtfRun is a stretch of paragraph content with one formatting: text, or a
	// node already built (a link, a picture, a footnote, a line break).
	internal type RtfRun {
		content   string
		bold      bool
		italic    bool
		underline bool
		strike    bool
		mono      bool
		fg        int
		bg        int
		node      ?Inline = none

		def new() {}

		def sameFormat(other RtfRun) bool {
			return bold == other.bold && italic == other.italic && underline == other.underline && strike == other.strike && mono == other.mono && fg == other.fg && bg == other.bg
		}

		// blank reports whether the run shows nothing but whitespace.
		def blank() bool {
			let shown = node
			return content.trim() == "" when shown is none
			return shown.kind == InlineKind.LineBreak
		}
	}

	// RtfParagraph is an ended paragraph waiting to be placed.
	internal type RtfParagraph {
		runs  RtfRun[]
		props RtfPara

		def new(runs RtfRun[], props RtfPara) {
			self.runs = runs
			self.props = props
		}
	}

	// RtfOpenList is a list still taking items, at a list level.
	internal type RtfOpenList {
		list  Block
		level int
		id    int

		def new(list Block, level int, id int) {
			self.list = list
			self.level = level
			self.id = id
		}
	}

	// RtfPlacer adds paragraphs to a container block, gathering consecutive
	// ones into lists, code blocks and quotes.
	internal type RtfPlacer {
		container Block
		lists     RtfOpenList[]
		code      ?Block        = none
		quote     ?Block        = none
		// The Image block placed last, which a caption paragraph may follow.
		image     ?Block        = none

		def new(container Block) {
			self.container = container
			lists = RtfOpenList[]
		}

		// reset ends the open lists, code block and quote.
		def reset() {
			lists = RtfOpenList[]
			code = none
			quote = none
			image = none
		}
	}

	// RtfCellDef is what `\cellx` closes: the merges of one cell.
	internal type RtfCellDef {
		// `\clmrg`: merged into the cell on the left.
		merged  bool
		// `\clvmrg`: merged into the cell above.
		vmerged bool
		// `\clvmgf`: first of vertically merged cells.
		vfirst  bool

		def new() {}
	}

	// RtfFlow is one stream of paragraphs: the body, or a footnote.
	internal type RtfFlow {
		runs    RtfRun[]
		pending byte[]
		para    RtfPara
		// Paragraphs ended so far, which tells a field whether it stayed in one.
		serial  int
		placer  RtfPlacer
		cell    ?RtfPlacer      = none
		cells   Block[]
		table   ?Block          = none
		header  bool
		defs    RtfCellDef[]
		next    RtfCellDef
		// The cell a vertical merge started in, by column.
		owners  map<int, Block>

		def new(container Block) {
			runs = RtfRun[]
			pending = byte[]
			para = new RtfPara()
			placer = new RtfPlacer(container)
			cells = Block[]
			defs = RtfCellDef[]
			next = new RtfCellDef()
			owners = new map<int, Block>()
		}
	}

	// RtfField is a `\field` being read.
	internal type RtfField {
		instruction string
		// Index of the first run of the result, and the flow and paragraph it
		// is in.
		start       int
		flow        int
		serial      int

		def new(start int, flow int, serial int) {
			self.start = start
			self.flow = flow
			self.serial = serial
		}
	}

	internal type RtfStyle {
		name    string
		outline int    = -1

		def new(name string, outline int) {
			self.name = name
			self.outline = outline
		}
	}

	internal type RtfLevel {
		// `\levelnfc`: 23 is a bullet, 255 nothing, the others numbers.
		format int
		start  int = 1

		def new() {}
	}

	// RtfDecoder reads RTF in one pass over the bytes: groups push and pop
	// formatting, control words change it, text goes where the destination
	// says. Paragraphs are gathered into blocks as they end.
	internal type RtfDecoder {
		src          byte[]
		pos          int
		doc          Document
		frames       RtfFrame[]
		flows        RtfFlow[]
		fields       RtfField[]
		monoFonts    map<int, bool>
		defaultFont  int
		colors       color.Color[]
		// Whether each entry of `colors` was given, false for "automatic".
		colorSet     bool[]
		styles       map<int, RtfStyle>
		lists        map<int, RtfLevel[]>
		overrides    map<int, int>
		// The table entry being read: a font, a style, an info field.
		entry        byte[]
		entryNumber  int
		entryMono    bool
		entryOutline int
		red          int
		green        int
		blue         int
		colorGiven   bool
		levels       RtfLevel[]
		listId       int
		overrideLs   int
		// Year, month, day, hour and minute of the creation time.
		stamp        int[]
		picture      byte[]
		pictureExt   string
		nibble       int                  = -1
		pictures     int
		skipChars    int
		surrogate    int
		lcid         int

		def new() {
			doc = new Document()
			frames = RtfFrame[]
			flows = RtfFlow[]
			fields = RtfField[]
			monoFonts = new map<int, bool>()
			colors = color.Color[]
			colorSet = bool[]
			styles = new map<int, RtfStyle>()
			lists = new map<int, RtfLevel[]>()
			overrides = new map<int, int>()
			entry = byte[]
			levels = RtfLevel[]
			stamp = int[0, 0, 0, 0, 0]
			picture = byte[]
		}

		def decode(source byte[]) Document {
			src = source
			frames.push(new RtfFrame())
			flows.push(new RtfFlow(doc.body))
			let n = src.len()
			for pos < n {
				let c = char(src[pos])
				if c == '{' {
					pos++
					openGroup()
				} else if c == '}' {
					pos++
					closeGroup()
				} else if c == '\\' {
					controlWord()
				} else if c == '\r' || c == '\n' {
					pos++
				} else {
					let start = pos
					for pos < n && !rtfSpecial(char(src[pos])) {
						pos++
					}
					addText(src[start:pos])
				}
			}
			for frames.len() > 1 {
				closeGroup()
			}

			let body = flows[0]
			endParagraph(false) when body.runs.len() > 0 || body.pending.len() > 0
			closeTable(body)

			if doc.title == "" && doc.body.children.len() > 0 {
				let opening = doc.body.children[0]
				doc.title = opening.plainText() when opening.kind == BlockKind.Heading && opening.level == 1
			}
			let language = rtfLanguageTag(lcid)
			doc.language = language unless language == ""
			return doc
		}

		def frame() RtfFrame {
			return frames[frames.len() - 1]
		}

		def flow() RtfFlow {
			return flows[flows.len() - 1]
		}

		def openGroup() {
			flushText()
			skipChars = 0
			let top = frame()
			let f = top.child()
			if top.dest == RtfDest.Styles {
				f.opens = "style"
				entry = byte[]
				entryNumber = 0
				entryOutline = -1
			} else if top.dest == RtfDest.Fonts {
				f.opens = "font"
				entry = byte[]
				entryMono = false
			}
			frames.push(f)
		}

		def closeGroup() {
			return when frames.len() <= 1
			flushText()
			skipChars = 0
			let f = frames.pop()
			let skipped = f.dest == RtfDest.Skip
			match f.opens {
				case "style":
					styles.set(entryNumber, new RtfStyle(string(entry).trim().trimEnd(";").trim(), entryOutline)) unless skipped
				case "font":
					storeFont()
				case "list":
					lists.set(listId, levels)
				case "override":
					overrides.set(overrideLs, listId)
				case "footnote":
					endFootnote()
				case "field":
					endField()
				case "picture":
					endPicture()
				case "creatim":
					endStamp()
				case "title", "author", "subject", "keywords", "doccomm", "company", "category", "manager":
					endInfo(f.opens)
				default:
			}
		}

		def controlWord() {
			pos++
			return when pos >= src.len()
			let c = char(src[pos])
			if !c.isLetter() {
				pos++
				symbol(c)
				return
			}

			let start = pos
			for pos < src.len() && char(src[pos]).isLetter() {
				pos++
			}
			let name = string(src[start:pos])
			let negative = false
			if pos + 1 < src.len() && char(src[pos]) == '-' && char(src[pos + 1]).isDigit() {
				negative = true
				pos++
			}
			let given = false
			let value = 0
			for pos < src.len() && char(src[pos]).isDigit() {
				value = value * 10 + int(src[pos]) - 48
				given = true
				pos++
			}
			value = -value when negative
			pos++ when pos < src.len() && char(src[pos]) == ' '
			word(name, given, value)
		}

		// symbol handles a control symbol: a backslash and one character that
		// is not a letter.
		def symbol(c char) {
			if c == char(39) {
				return when pos + 1 >= src.len()
				let high = rtfHexValue(char(src[pos]))
				let low = rtfHexValue(char(src[pos + 1]))
				pos += 2
				if skipChars > 0 {
					skipChars--
					return
				}
				addCode(rtfCodePage(high * 16 + low)) when high >= 0 && low >= 0
			} else if c == '*' {
				frame().starred = true
			} else if c == '\n' || c == '\r' {
				word("par", false, 0)
			} else {
				let code = rtfSymbolCode(c)
				return when code < 0
				if skipChars > 0 {
					skipChars--
					return
				}
				addCode(code) when code > 0
			}
		}

		def word(name string, given bool, value int) {
			if name == "bin" {
				binary(value)
				return
			}
			flushText()
			let f = frame()
			return when f.dest == RtfDest.Skip
			if skipChars > 0 && name != "u" {
				skipChars--
				return
			}
			if f.starred {
				f.starred = false
				f.dest = RtfDest.Skip unless destination(name)
				return
			}
			return when destination(name)

			let on = !given || value != 0
			match f.dest {
				case RtfDest.Body:
					bodyWord(name, on, value)
				case RtfDest.Fonts:
					if name == "f" {
						storeFont() when entry.len() > 0
						entryNumber = value
						entryMono = false
					} else {
						entryMono = true when name == "fmodern"
					}
				case RtfDest.Colors:
					colorGiven = true when name := "red" || "green" || "blue"
					red = value when name == "red"
					green = value when name == "green"
					blue = value when name == "blue"
				case RtfDest.Styles:
					entryNumber = value when name == "s"
					entryOutline = value when name == "outlinelevel"
				case RtfDest.Info:
					let index = rtfStampIndex(name)
					stamp[index] = value when index >= 0 && f.opens == "creatim"
				case RtfDest.Lists:
					listWord(name, value)
				case RtfDest.Overrides:
					listId = value when name == "listid"
					overrideLs = value when name == "ls"
				case RtfDest.Picture:
					let ext = rtfPictureExt(name)
					pictureExt = ext unless ext == ""
				case RtfDest.Numbering:
					numberingWord(name, value)
				default:
			}
		}

		// destination handles a control word that starts a destination and
		// reports whether it was one.
		def destination(name string) bool {
			let f = frame()
			match name {
				case "fonttbl":
					f.dest = RtfDest.Fonts
				case "colortbl":
					f.dest = RtfDest.Colors
				case "stylesheet":
					f.dest = RtfDest.Styles
				case "info":
					f.dest = RtfDest.Info
				case "title", "author", "subject", "keywords", "doccomm", "company", "category", "manager":
					if f.dest == RtfDest.Info {
						f.dest = RtfDest.InfoField
						f.opens = name
						entry = byte[]
					} else {
						f.dest = RtfDest.Skip
					}
				case "creatim":
					f.opens = "creatim"
					stamp = int[0, 0, 0, 0, 0]
				case "listtable":
					f.dest = RtfDest.Lists
				case "list":
					return false unless f.dest == RtfDest.Lists
					f.opens = "list"
					levels = RtfLevel[]
					listId = 0
				case "listlevel":
					return false unless f.dest == RtfDest.Lists
					levels.push(new RtfLevel())
				case "listoverridetable":
					f.dest = RtfDest.Overrides
				case "listoverride":
					return false unless f.dest == RtfDest.Overrides
					f.opens = "override"
					listId = 0
					overrideLs = 0
				case "field":
					if f.dest == RtfDest.Body {
						f.opens = "field"
						let current = flow()
						fields.push(new RtfField(current.runs.len(), flows.len() - 1, current.serial))
					} else {
						f.dest = RtfDest.Skip
					}
				case "fldinst":
					f.dest = RtfDest.Instruction
				case "fldrslt":
					f.dest = RtfDest.Body
				case "footnote":
					if f.dest == RtfDest.Body {
						f.opens = "footnote"
						flows.push(new RtfFlow(new Block(BlockKind.Section)))
					} else {
						f.dest = RtfDest.Skip
					}
				case "pict":
					if f.dest == RtfDest.Body {
						f.dest = RtfDest.Picture
						f.opens = "picture"
						picture = byte[]
						pictureExt = ""
						nibble = -1
					} else {
						f.dest = RtfDest.Skip
					}
				case "shppict":
				case "object", "upr":
					f.dest = RtfDest.Fallback
				case "result", "ud":
					f.dest = RtfDest.Body when f.dest == RtfDest.Fallback
				case "pn":
					f.dest = RtfDest.Numbering
				default:
					return false unless rtfSkipped.contains(" " + name + " ")
					f.dest = RtfDest.Skip
			}
			return true
		}

		def bodyWord(name string, on bool, value int) {
			let f = frame()
			let current = flow()
			let para = current.para
			match name {
				case "par", "sect":
					endParagraph(false)
				case "line":
					addNode(lineBreak())
				case "tab":
					addCode(9)
				case "page":
					pageBreak()
				case "cell":
					endCell()
				case "nestcell":
					endParagraph(true)
				case "row":
					endRow()
				case "u":
					unicode(value)
				case "uc":
					f.uc = value
				case "plain":
					f.reset()
				case "b":
					f.bold = on
				case "i":
					f.italic = on
				case "strike", "striked":
					f.strike = on
				case "ul", "uld", "uldash", "uldashd", "uldashdd", "uldb", "ulth", "ulw", "ulwave", "ulhwave", "ululdbwave", "ulthd", "ulthdash", "ulldash", "ulthldash", "ulthdashd", "ulthdashdd":
					f.underline = on
				case "ulnone":
					f.underline = false
				case "v", "webhidden":
					f.hidden = on
				case "f":
					f.font = value
				case "cf":
					f.fg = value
				case "cb", "highlight", "chcbpat":
					f.bg = value
				case "pard":
					current.para = new RtfPara()
				case "s":
					para.styleId = value
				case "ql":
					para.alignment = Alignment.Default
				case "qc":
					para.alignment = Alignment.Center
				case "qr":
					para.alignment = Alignment.Right
				case "qj", "qd":
					para.alignment = Alignment.Justify
				case "intbl":
					para.inTable = true
				case "itap":
					para.inTable = value > 0
				case "ls":
					para.list = value
				case "ilvl":
					para.level = value
				case "outlinelevel":
					para.outline = value
				case "li":
					para.indent = value
				case "brdrb":
					para.border = true
				case "pagebb":
					para.pageBefore = on
				case "trowd":
					current.defs = RtfCellDef[]
					current.header = false
					current.next = new RtfCellDef()
				case "trhdr":
					current.header = true
				case "clmrg":
					current.next.merged = true
				case "clvmgf":
					current.next.vfirst = true
				case "clvmrg":
					current.next.vmerged = true
				case "cellx":
					current.defs.push(current.next)
					current.next = new RtfCellDef()
				case "deff":
					defaultFont = value
				case "deflang":
					lcid = value when lcid == 0
				default:
					let code = rtfCharacterWord(name)
					addCode(code) when code > 0
			}
		}

		def listWord(name string, value int) {
			if name == "listid" {
				listId = value
				return
			}
			return when levels.len() == 0
			let level = levels[levels.len() - 1]
			level.format = value when name := "levelnfc" || "levelnfcn"
			level.start = value when name == "levelstartat"
		}

		def numberingWord(name string, value int) {
			let para = flow().para
			match name {
				case "pnlvlblt":
					para.list = -1
				case "pnlvlbody":
					para.list = -2
				case "pnlvl":
					para.list = -2
					para.level = (value - 1).clamp(0, 8)
				case "pnstart":
					para.start = value
				default:
			}
		}

		def unicode(value int) {
			let code = value < 0 ?? (value + 65536, value)
			if code >= 0xd800 && code < 0xdc00 {
				surrogate = code
			} else if code >= 0xdc00 && code < 0xe000 {
				addCode(0x10000 + ((surrogate - 0xd800) * 1024) + (code - 0xdc00)) when surrogate > 0
				surrogate = 0
			} else {
				addCode(code)
			}
			skipChars = frame().uc
		}

		// binary reads the `\bin` data that follows, part of a picture.
		def binary(count int) {
			let end = (pos + count).clamp(pos, src.len())
			if frame().dest == RtfDest.Picture {
				for let i = pos; i < end; i++ {
					picture.push(src[i])
				}
			}
			pos = end
		}

		// addText takes a run of plain source bytes.
		def addText(data byte[]) {
			let f = frame()
			if f.dest == RtfDest.Picture {
				for let (_, b) in data {
					let v = rtfHexValue(char(b))
					continue when v < 0
					if nibble < 0 {
						nibble = v
					} else {
						picture.push(byte(nibble * 16 + v))
						nibble = -1
					}
				}
				return
			}
			for let (_, b) in data {
				if skipChars > 0 {
					skipChars--
					continue
				}
				addCode(rtfCodePage(int(b)))
			}
		}

		// addCode takes one character of text, where the destination says.
		def addCode(code int) {
			let f = frame()
			match f.dest {
				case RtfDest.Body:
					rtfAppend(flow().pending, code) unless f.hidden
				case RtfDest.Fonts:
					if code == 59 {
						storeFont()
					} else {
						rtfAppend(entry, code)
					}
				case RtfDest.Styles, RtfDest.InfoField:
					rtfAppend(entry, code)
				case RtfDest.Colors:
					storeColor() when code == 59
				case RtfDest.Instruction:
					if fields.len() > 0 {
						let field = fields[fields.len() - 1]
						field.instruction += string(char(code))
					}
				default:
			}
		}

		// flushText turns the pending text of the flow into a run with the
		// formatting in force.
		def flushText() {
			let current = flow()
			return when current.pending.len() == 0
			let f = frame()
			let run = new RtfRun()
			run.content = string(current.pending)
			current.pending = byte[]
			run.bold = f.bold
			run.italic = f.italic
			run.underline = f.underline
			run.strike = f.strike
			run.fg = f.fg
			run.bg = f.bg
			let font = f.font < 0 ?? (defaultFont, f.font)
			run.mono = monoFonts.hasKey(font)

			let count = current.runs.len()
			if count > 0 {
				let last = current.runs[count - 1]
				if last.node is none && last.sameFormat(run) {
					last.content += run.content
					return
				}
			}
			current.runs.push(run)
		}

		def addNode(node Inline) {
			flushText()
			let run = new RtfRun()
			run.node = node
			flow().runs.push(run)
		}

		def storeFont() {
			let name = string(entry).trim().trimEnd(";").trim()
			monoFonts.set(entryNumber, true) when entryMono || rtfMonospace(name)
			entry = byte[]
			entryMono = false
		}

		def storeColor() {
			let rgba = color.RGBA{r: uint8(red), g: uint8(green), b: uint8(blue), a: 255}
			colors.push(new color.Color(rgba))
			colorSet.push(colorGiven)
			red = 0
			green = 0
			blue = 0
			colorGiven = false
		}

		// colorAt returns the color table entry, none for automatic or unknown.
		def colorAt(index int) ?color.Color {
			return none when index <= 0 || index >= colors.len() || !colorSet[index]
			return colors[index]
		}

		def endInfo(key string) {
			let value = string(entry).trim()
			entry = byte[]
			return when value == ""
			match key {
				case "title":
					doc.title = value
				case "author":
					for let (_, name) in value.split(";") {
						doc.authors.push(name.trim()) unless name.trim() == ""
					}
				case "doccomm":
					doc.metadata.set("comment", value)
				default:
					doc.metadata.set(key, value)
			}
		}

		def endStamp() {
			return when stamp[0] <= 0
			let text = "{stamp[0]}-" + rtfTwo(stamp[1].clamp(1, 12)) + "-" + rtfTwo(stamp[2].clamp(1, 31)) + "T" + rtfTwo(stamp[3]) + ":" + rtfTwo(stamp[4]) + ":00Z"
			let parsed = rtfTime(text) onerror recover none
			doc.date = parsed unless parsed is none
		}

		def endPicture() {
			return when picture.len() == 0
			pictures++
			let ext = pictureExt == "" ?? ("bin", pictureExt)
			let name = "image{pictures}.{ext}"
			doc.resources.set(name, picture)
			picture = byte[]
			let image = new Inline(InlineKind.Image)
			image.url = name
			addNode(image)
		}

		def endFootnote() {
			let note = flow()
			endParagraph(false) when note.runs.len() > 0
			closeTable(note)
			flows.pop()
			let footnote = new Inline(InlineKind.Footnote)
			footnote.note = note.placer.container.children
			addNode(footnote)
		}

		def endField() {
			return when fields.len() == 0
			let field = fields.pop()
			return when field.flow >= flows.len()
			let current = flows[field.flow]
			return when field.serial != current.serial || field.start > current.runs.len()

			let args = rtfArguments(field.instruction)
			return when args.len() < 2
			let kind = args[0].upper()
			let result = RtfRun[]
			let kept = RtfRun[]
			for let (i, run) in current.runs {
				if i < field.start {
					kept.push(run)
				} else {
					result.push(run)
				}
			}

			let node Inline
			if kind == "HYPERLINK" {
				node = new Inline(InlineKind.Link)
				let target = ""
				let anchor = ""
				let i = 1
				for i < args.len() {
					let arg = args[i]
					if arg := "\\l" || "\\o" || "\\t" {
						let next = i + 1 < args.len() ?? (args[i + 1], "")
						anchor = "#" + next when arg == "\\l"
						node.title = next when arg == "\\o"
						i += 2
						continue
					}
					target = arg when target == "" && !arg.startsWith("\\")
					i++
				}
				node.url = target + anchor
				rtfPlainLink(result)
				node.children = rtfInlines(result, self)
			} else if kind == "INCLUDEPICTURE" {
				for let (_, run) in result {
					let inner = run.node
					return unless inner is none || inner.kind != InlineKind.Image
				}
				node = new Inline(InlineKind.Image)
				node.url = args[1]
				node.children = rtfInlines(result, self)
			} else {
				return
			}

			let run = new RtfRun()
			run.node = node
			kept.push(run)
			current.runs = kept
		}

		// endParagraph ends the paragraph being read and places it. `inTable`
		// forces it into the current table cell.
		def endParagraph(inTable bool) {
			flushText()
			let current = flow()
			let props = current.para.copy()
			props.inTable = true when inTable
			let runs = current.runs
			current.runs = RtfRun[]
			current.serial++
			place(current, new RtfParagraph(runs, props))
		}

		def pageBreak() {
			flushText()
			let current = flow()
			return when current.para.inTable
			let content = false
			for let (_, run) in current.runs {
				content = true unless run.blank()
			}
			endParagraph(false) when content
			current.runs = RtfRun[]
			closeTable(current)
			current.placer.reset()
			current.placer.container.pageBreak()
		}

		def endCell() {
			endParagraph(true)
			let current = flow()
			let cell = current.cell
			if cell is none {
				current.cells.push(new Block(BlockKind.Cell))
			} else {
				current.cells.push(cell.container)
			}
			current.cell = none
		}

		def endRow() {
			flushText()
			let current = flow()
			let open = current.cell
			if !(open is none) {
				current.cells.push(open.container)
				current.cell = none
			}
			return when current.cells.len() == 0

			let table = new Block(BlockKind.Table)
			let existing = current.table
			if existing is none {
				current.placer.reset()
				current.placer.container.add(table)
				current.table = table
				current.owners = new map<int, Block>()
			} else {
				table = existing
			}

			let row = new Block(BlockKind.Row)
			row.header = current.header
			let column = 0
			// The cell a horizontal merge widens, none after a cell merged into
			// the row above.
			let anchor ?Block = none
			for let (i, cell) in current.cells {
				let cellDef = i < current.defs.len() ?? (current.defs[i], new RtfCellDef())
				if cellDef.merged {
					if !(anchor is none) {
						anchor.columnSpan++
					}
					column++
					continue
				}
				if cellDef.vmerged {
					let owner = current.owners.get(column)
					if !(owner is none) {
						owner.rowSpan++
						anchor = none
						column++
						continue
					}
				}
				if cellDef.vfirst {
					current.owners.set(column, cell)
				} else {
					current.owners.delete(column)
				}
				row.add(cell)
				anchor = cell
				column++
			}
			table.add(row)
			current.cells = Block[]
		}

		// closeTable ends the table of the flow, taking each column's alignment
		// from its first body row.
		def closeTable(current RtfFlow) {
			let table = current.table
			return when table is none
			current.table = none
			return when table.children.len() == 0

			let reference = table.children[0]
			for let (_, row) in table.children {
				if !row.header {
					reference = row
					break
				}
			}
			let columns = table.columns()
			for let c = 0; c < columns; c++ {
				let alignment = Alignment.Default
				if c < reference.children.len() {
					let cell = reference.children[c]
					alignment = cell.children[0].alignment when cell.children.len() > 0 && cell.children[0].kind == BlockKind.Paragraph
				}
				table.alignments.push(alignment)
				for let (_, row) in table.children {
					continue when c >= row.children.len()
					for let (_, block) in row.children[c].children {
						block.alignment = Alignment.Default when block.kind == BlockKind.Paragraph && block.alignment == alignment
					}
				}
			}
		}

		def place(current RtfFlow, p RtfParagraph) {
			if p.props.inTable {
				let cell = current.cell
				if cell is none {
					let opened = new RtfPlacer(new Block(BlockKind.Cell))
					current.cell = opened
					placeIn(opened, p)
				} else {
					placeIn(cell, p)
				}
				return
			}
			closeTable(current)
			if p.props.pageBefore {
				current.placer.reset()
				current.placer.container.pageBreak()
			}
			placeIn(current.placer, p)
		}

		def styleOf(number int) RtfStyle {
			let found = styles.get(number)
			return new RtfStyle("", -1) when found is none
			return found
		}

		// placeIn adds the paragraph to the placer's container as the block its
		// formatting says it is.
		def placeIn(placer RtfPlacer, p RtfParagraph) {
			let props = p.props
			let named = styleOf(props.styleId)
			let name = named.name.lower()
			let runs = p.runs

			let blank = true
			for let (_, run) in runs {
				blank = false unless run.blank()
			}
			if blank {
				let code = placer.code
				if props.border {
					placer.reset()
					placer.container.rule()
				} else if rtfCodeStyle(name) && !(code is none) {
					code.content += "\n"
				} else {
					placer.reset()
				}
				return
			}

			let outline = props.outline >= 0 ?? (props.outline, named.outline)
			outline = rtfHeadingStyle(name) - 1 when outline < 0
			if outline >= 0 && outline < 9 {
				placer.reset()
				rtfStrip(runs, true)
				runs = rtfTrim(runs)
				let heading = new Block(BlockKind.Heading)
				heading.level = (outline + 1).clamp(1, 6)
				heading.alignment = props.alignment
				heading.inlines = rtfInlines(runs, self)
				placer.container.add(heading)
				return
			}

			if rtfCodeStyle(name) || rtfAllMono(runs) {
				let content = rtfCodeText(runs)
				let code = placer.code
				if code is none {
					placer.reset()
					placer.code = placer.container.code("", content)
				} else {
					code.content += "\n" + content
				}
				return
			}

			if name := "quote" || "intense quote" || "block text" {
				rtfStrip(runs, false)
				let target = new Block(BlockKind.Quote)
				let top = placer.quote
				if top is none {
					placer.reset()
					placer.container.add(target)
					placer.quote = target
				} else {
					target = top
				}
				let depth = props.indent >= 1440 ?? (props.indent / 720, 1)
				for let d = 1; d < depth; d++ {
					let count = target.children.len()
					if count > 0 && target.children[count - 1].kind == BlockKind.Quote {
						target = target.children[count - 1]
					} else {
						target = target.quote()
					}
				}
				target.add(paragraphOf(runs, props, named))
				return
			}

			if props.list != 0 {
				placeItem(placer, p, named)
				return
			}
			if props.indent > 0 && placer.lists.len() > 0 {
				let open = placer.lists[placer.lists.len() - 1].list
				open.children[open.children.len() - 1].add(paragraphOf(runs, props, named))
				return
			}

			let inlines = rtfInlines(runs, self)
			if inlines.len() == 1 && inlines[0].kind == InlineKind.Image {
				placer.reset()
				let only = inlines[0]
				let image = new Block(BlockKind.Image)
				image.source = only.url
				image.title = only.title
				image.inlines = only.children
				image.alignment = props.alignment
				placer.container.add(image)
				placer.image = image
				return
			}
			let image = placer.image
			if name == "caption" && !(image is none) {
				image.inlines = inlines
				placer.image = none
				return
			}

			placer.reset()
			placer.container.add(paragraphOf(runs, props, named))
		}

		def paragraphOf(runs RtfRun[], props RtfPara, named RtfStyle) Block {
			let block = new Block(BlockKind.Paragraph)
			block.inlines = rtfInlines(rtfTrim(runs), self)
			block.alignment = props.alignment
			block.styleName = named.name unless rtfPlainStyle(named.name.lower())
			return block
		}

		def placeItem(placer RtfPlacer, p RtfParagraph, named RtfStyle) {
			let props = p.props
			let shape = listShape(props)
			let level = props.level
			let id = props.list
			placer.code = none
			placer.quote = none
			placer.image = none

			for placer.lists.len() > 0 && placer.lists[placer.lists.len() - 1].level > level {
				placer.lists.pop()
			}
			if placer.lists.len() > 0 {
				let top = placer.lists[placer.lists.len() - 1]
				placer.lists.pop() when top.level == level && top.id != id
			}
			if placer.lists.len() == 0 || placer.lists[placer.lists.len() - 1].level < level {
				let list = new Block(BlockKind.List)
				list.ordered = !(shape.format := 23 || 255)
				list.start = shape.start
				if placer.lists.len() == 0 {
					placer.container.add(list)
				} else {
					let parent = placer.lists[placer.lists.len() - 1].list
					parent.add(new Block(BlockKind.Item)) when parent.children.len() == 0
					parent.children[parent.children.len() - 1].add(list)
				}
				placer.lists.push(new RtfOpenList(list, level, id))
			}

			let item = new Block(BlockKind.Item)
			let runs = p.runs
			if runs.len() > 0 && runs[0].node is none {
				let first = runs[0].content.trimStart()
				if first.startsWith("☐") || first.startsWith("☑") || first.startsWith("☒") {
					item.checked = !first.startsWith("☐")
					runs[0].content = first[1:].trimStart()
				}
			}
			item.add(paragraphOf(runs, props, named))
			placer.lists[placer.lists.len() - 1].list.add(item)
		}

		// listShape returns the numbering of the paragraph's list level: its
		// format and first number.
		def listShape(props RtfPara) RtfLevel {
			let shape = new RtfLevel()
			shape.format = 23
			if props.list < 0 {
				if props.list == -2 {
					shape.format = 0
					shape.start = props.start
				}
				return shape
			}
			let id = overrides.get(props.list)
			return shape when id is none
			let defined = lists.get(id)
			return shape when defined is none || props.level >= defined.len()
			return defined[props.level]
		}
	}

	// rtfSpecial reports whether the byte ends a run of plain text.
	internal def rtfSpecial(c char) bool {
		return c := '{' || '}' || '\\' || '\r' || '\n'
	}

	internal def rtfHexValue(c char) int {
		return -1 unless c.isHexDigit()
		return c.digitValue(16)
	}

	// rtfCodePage returns the character a source byte stands for, as
	// Windows-1252.
	internal def rtfCodePage(value int) int {
		return rtfWindows1252[value - 0x80] when value >= 0x80 && value < 0xa0
		return value
	}

	// rtfAppend adds the character to the buffer in UTF-8.
	internal def rtfAppend(buffer byte[], code int) {
		if code < 128 {
			buffer.push(byte(code))
		} else {
			buffer.push(...string(char(code)).bytes())
		}
	}

	// rtfSymbolCode returns the character a control symbol stands for, 0 for
	// one that stands for nothing and -1 for one that is not text at all.
	internal def rtfSymbolCode(c char) int {
		match c {
			case '\\', '{', '}':
				return int(c)
			case '~':
				return 0xa0
			case '_':
				return 0x2011
			case '-':
				return 0
			default:
				return -1
		}
	}

	// rtfCharacterWord returns the character a control word stands for, 0
	// when it stands for none.
	internal def rtfCharacterWord(name string) int {
		match name {
			case "emdash":
				return 0x2014
			case "endash":
				return 0x2013
			case "lquote":
				return 0x2018
			case "rquote":
				return 0x2019
			case "ldblquote":
				return 0x201c
			case "rdblquote":
				return 0x201d
			case "bullet":
				return 0x2022
			case "emspace":
				return 0x2003
			case "enspace":
				return 0x2002
			case "qmspace":
				return 0x2005
			case "zwj":
				return 0x200d
			case "zwnj":
				return 0x200c
			case "ltrmark":
				return 0x200e
			case "rtlmark":
				return 0x200f
			default:
				return 0
		}
	}

	internal def rtfStampIndex(name string) int {
		match name {
			case "yr":
				return 0
			case "mo":
				return 1
			case "dy":
				return 2
			case "hr":
				return 3
			case "min":
				return 4
			default:
				return -1
		}
	}

	internal def rtfPictureExt(name string) string {
		match name {
			case "pngblip":
				return "png"
			case "jpegblip":
				return "jpg"
			case "emfblip":
				return "emf"
			case "wmetafile":
				return "wmf"
			case "dibitmap", "wbitmap":
				return "bmp"
			case "macpict":
				return "pict"
			default:
				return ""
		}
	}

	internal def rtfTwo(value int) string {
		return "{value}".padStart(2, "0")
	}

	internal def rtfTime(text string) !?time.Time {
		return try time.parse(text)
	}

	// rtfMonospace reports whether a font name is one of the usual
	// monospace fonts.
	internal def rtfMonospace(name string) bool {
		let lowered = name.lower()
		return lowered.contains("mono") || lowered.contains("courier") || lowered.contains("consolas") || lowered.contains("menlo") || lowered.contains("monaco") || lowered.contains("lucida console") || lowered.contains("source code")
	}

	// rtfHeadingStyle returns N for a style named "heading N", 0 otherwise.
	internal def rtfHeadingStyle(name string) int {
		return 0 unless name.startsWith("heading ")
		let digits = name[8:].trim()
		return 0 unless digits.len() == 1 && digits.isNumeric()
		return digits.toInt<int>()
	}

	internal def rtfCodeStyle(name string) bool {
		return name := "source code" || "code" || "html preformatted" || "preformatted text" || "plain text" || "verbatim"
	}

	// rtfPlainStyle reports whether a style name says nothing beyond "text",
	// so a paragraph in it keeps no styleName.
	internal def rtfPlainStyle(name string) bool {
		return name := "" || "normal" || "body text" || "list paragraph" || "no spacing" || "default" || "standard" || "text body"
	}

	// rtfLanguageTag returns the BCP 47 tag of a Windows language identifier,
	// empty when unknown.
	internal def rtfLanguageTag(lcid int) string {
		let prefix = "{lcid} "
		for let (_, pair) in rtfLanguages {
			return pair[prefix.len():] when pair.startsWith(prefix)
		}
		return ""
	}

	// rtfLanguageId returns the Windows language identifier of a BCP 47 tag,
	// matching the language alone when the region is not listed; 0 when
	// unknown.
	internal def rtfLanguageId(tag string) int {
		return 0 when tag == ""
		let wanted = tag.lower()
		let primary = wanted.split("-")[0]
		let fallback = 0
		for let (_, pair) in rtfLanguages {
			let parts = pair.split(" ")
			let known = parts[1].lower()
			return parts[0].toInt<int>() when known == wanted
			fallback = parts[0].toInt<int>() when fallback == 0 && known.split("-")[0] == primary
		}
		return fallback
	}

	// rtfArguments splits a field instruction into words, a quoted string
	// being one word without its quotes.
	internal def rtfArguments(instruction string) string[] {
		let out = string[]
		let current = ""
		let quoted = false
		let started = false
		for let (_, c) in instruction {
			if c == '"' {
				quoted = !quoted
				started = true
			} else if !quoted && (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
				out.push(current) when started
				current = ""
				started = false
			} else {
				current += string(c)
				started = true
			}
		}
		out.push(current) when started
		return out
	}

	// rtfStrip drops bold (or italic) from the runs when every one with text
	// has it: a heading's or a quote's own look, not a mark.
	internal def rtfStrip(runs RtfRun[], bold bool) {
		for let (_, run) in runs {
			continue unless run.node is none
			continue when run.content.trim() == ""
			return unless (bold ?? (run.bold, run.italic))
		}
		for let (_, run) in runs {
			if bold {
				run.bold = false
			} else {
				run.italic = false
			}
		}
	}

	// rtfPlainLink drops the underline and color every run of a link result
	// has: the look of a link, not a mark.
	internal def rtfPlainLink(runs RtfRun[]) {
		return when runs.len() == 0
		let underlined = true
		let fg = runs[0].fg
		for let (_, run) in runs {
			underlined = false unless run.underline
			fg = -1 when run.fg != fg
		}
		for let (_, run) in runs {
			run.underline = false when underlined
			run.fg = 0 when fg >= 0
		}
	}

	// rtfTrim drops the spaces a paragraph starts and ends with, which RTF
	// writers leave after control words, and the runs left empty.
	internal def rtfTrim(runs RtfRun[]) RtfRun[] {
		let count = runs.len()
		return runs when count == 0
		runs[0].content = runs[0].content.trimStart(" ") when runs[0].node is none
		runs[count - 1].content = runs[count - 1].content.trimEnd(" ") when runs[count - 1].node is none
		return runs.filter(run => !(run.node is none && run.content == ""))
	}

	// rtfAllMono reports whether the runs are text in a monospace font and
	// line breaks, with some text: a line of code.
	internal def rtfAllMono(runs RtfRun[]) bool {
		let text = false
		for let (_, run) in runs {
			let node = run.node
			if node is none {
				if run.content.trim() != "" {
					return false unless run.mono
					text = true
				}
			} else {
				return false unless node.kind == InlineKind.LineBreak
			}
		}
		return text
	}

	internal def rtfCodeText(runs RtfRun[]) string {
		let out = ""
		for let (_, run) in runs {
			if run.node is none {
				out += run.content
			} else {
				out += "\n"
			}
		}
		return out
	}

	// rtfInlines turns runs into inlines. Marks a run shares with the one
	// before stay open, so `{\i a {\b b}}` nests bold inside italic instead of
	// starting a second italic.
	internal def rtfInlines(runs RtfRun[], decoder RtfDecoder) Inline[] {
		let out = Inline[]
		// The spans open at this point, outermost first, and their mark keys.
		let keys = string[]
		let open = Inline[]
		for let (_, run) in runs {
			let node = run.node
			let leaf Inline
			let wanted = string[]
			if node is none {
				leaf = run.mono ?? (code(run.content), text(run.content))
				wanted = rtfMarks(run)
			} else {
				leaf = node
				// A line break or a note sits inside whatever is open.
				wanted = (node.kind := InlineKind.LineBreak || InlineKind.Footnote) ?? (keys.clone(), rtfMarks(run))
			}

			let keep = 0
			for keep < keys.len() && wanted.indexOf(keys[keep]) >= 0 {
				keep++
			}
			for keys.len() > keep {
				keys.pop()
				open.pop()
			}
			for let (_, key) in wanted {
				continue when keys.indexOf(key) >= 0
				let item = rtfSpan(key, run, decoder)
				rtfAdd(open.len() == 0 ?? (out, open[open.len() - 1].children), item)
				keys.push(key)
				open.push(item)
			}
			rtfAdd(open.len() == 0 ?? (out, open[open.len() - 1].children), leaf)
		}
		return out
	}

	// rtfMarks returns the keys of a run's marks, outermost first.
	internal def rtfMarks(run RtfRun) string[] {
		let out = string[]
		out.push("c{run.fg}/{run.bg}") when run.fg > 0 || run.bg > 0
		out.push("b") when run.bold
		out.push("i") when run.italic
		out.push("u") when run.underline
		out.push("s") when run.strike
		return out
	}

	// rtfSpan returns an empty span for a mark key.
	internal def rtfSpan(key string, run RtfRun, decoder RtfDecoder) Inline {
		match key {
			case "b":
				return new Inline(InlineKind.Bold)
			case "i":
				return new Inline(InlineKind.Italic)
			case "u":
				return new Inline(InlineKind.Underline)
			case "s":
				return new Inline(InlineKind.Strike)
			default:
				let item = new Inline(InlineKind.Styled)
				item.foreground = decoder.colorAt(run.fg)
				item.background = decoder.colorAt(run.bg)
				return item
		}
	}

	// rtfAdd appends the inline, joined to the text or code before it.
	internal def rtfAdd(items Inline[], item Inline) {
		let count = items.len()
		if count > 0 && (item.kind := InlineKind.Text || InlineKind.Code) {
			let last = items[count - 1]
			if last.kind == item.kind {
				last.content += item.content
				return
			}
		}
		items.push(item)
	}

	internal def rtfColorKey(value ?color.Color) string {
		return "" when value is none
		return value.css(color.ColorFormat.Hex)
	}
}
