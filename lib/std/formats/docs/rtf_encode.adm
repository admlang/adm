partial module std.formats.docs {
	use (
		std.gfx.color
	)

	// Paragraph style numbers the encoder's stylesheet declares. Named styles of
	// the document follow from rtfFirstCustomStyle on.
	internal const rtfQuoteStyle = 7
	internal const rtfCodeStyleId = 8
	internal const rtfCaptionStyle = 9
	internal const rtfFirstCustomStyle = 10

	// RtfUnit is a piece of the encoded body: a paragraph still to be ended by
	// `\par` or `\cell`, or text standing on its own (a table, a page break, raw
	// RTF).
	internal struct RtfUnit {
		content   string
		paragraph bool
	}

	// RtfEncoder writes a Document as RTF. The body is written first, since it
	// decides the color table, the named styles and the lists the header
	// declares.
	internal type RtfEncoder {
		codec     Rtf
		doc       Document
		palette   color.Color[]
		// Hex codes of `palette`, to find a color again.
		keys      string[]
		// Named styles, numbered from rtfFirstCustomStyle.
		styles    string[]
		listDefs  string[]
		overrides string[]

		def new(codec Rtf, doc Document) {
			self.codec = codec
			self.doc = doc
			palette = color.Color[]
			keys = string[]
			styles = string[]
			listDefs = string[]
			overrides = string[]
		}

		def encode() string {
			let body = string[]
			for let (_, unit) in units(doc.body.children, false, 0, Alignment.Default) {
				body.push(unit.paragraph ?? (unit.content + "\\par", unit.content))
			}

			let out = string[]
			let lcid = rtfLanguageId(doc.language)
			out.push("\{\\rtf1\\ansi\\ansicpg1252\\deff0\\uc1" + (lcid > 0 ?? ("\\deflang{lcid}", "")))
			out.push("\{\\fonttbl\{\\f0\\fnil\\fcharset0 " + rtfEscape(codec.font) + ";\}\{\\f1\\fmodern\\fcharset0 " + rtfEscape(codec.codeFont) + ";\}\}")
			if palette.len() > 0 {
				let table = "\{\\colortbl;"
				for let (_, entry) in palette {
					table += "\\red{entry.red}\\green{entry.green}\\blue{entry.blue};"
				}
				out.push(table + "\}")
			}
			out.push(stylesheet())
			if listDefs.len() > 0 {
				out.push("\{\\*\\listtable" + listDefs.join("\n") + "\}")
				out.push("\{\\*\\listoverridetable" + overrides.join("\n") + "\}")
			}
			let info = infoGroup()
			out.push(info) unless info == ""
			let m = codec.margin
			out.push("\\paperw{codec.pageWidth}\\paperh{codec.pageHeight}\\margl{m}\\margr{m}\\margt{m}\\margb{m}\\widowctrl")
			out.push(...body)
			out.push("\}")
			return out.join("\n") + "\n"
		}

		def textSize() int {
			return codec.fontSize.clamp(4, 400) * 2
		}

		def stylesheet() string {
			let fs = textSize()
			let out = "\{\\stylesheet\{\\f0\\fs{fs} Normal;\}"
			for let level = 1; level <= 6; level++ {
				let size = fs + (level < 5 ?? ((5 - level) * 4, 0))
				out += "\n\{\\s{level}\\outlinelevel{level - 1}\\keepn\\sb240\\sa120\\b\\f0\\fs{size}\\sbasedon0\\snext0 heading {level};\}"
			}
			out += "\n\{\\s{rtfQuoteStyle}\\li720\\ri720\\sa120\\f0\\fs{fs}\\sbasedon0\\snext{rtfQuoteStyle} Quote;\}"
			out += "\n\{\\s{rtfCodeStyleId}\\sa0\\f1\\fs{fs - 4}\\sbasedon0\\snext{rtfCodeStyleId} Source Code;\}"
			out += "\n\{\\s{rtfCaptionStyle}\\sa120\\f0\\fs{fs - 4}\\sbasedon0\\snext0 Caption;\}"
			for let (i, name) in styles {
				out += "\n\{\\s{rtfFirstCustomStyle + i}\\sa120\\f0\\fs{fs}\\sbasedon0 " + rtfEscape(name) + ";\}"
			}
			return out + "\}"
		}

		def infoGroup() string {
			let out = ""
			out += "\{\\title " + rtfEscape(doc.title) + "\}" unless doc.title == ""
			out += "\{\\author " + rtfEscape(doc.authors.join("; ")) + "\}" when doc.authors.len() > 0
			let date = doc.date
			out += "\{\\creatim\\yr{date.year()}\\mo{date.month()}\\dy{date.day()}\\hr{date.hour()}\\min{date.minute()}\}" unless date is none
			for let (_, key) in string["subject", "keywords", "comment", "company", "category", "manager"] {
				let value = doc.metadata.get(key)
				continue when value is none
				let name = key == "comment" ?? ("doccomm", key)
				out += "\{\\" + name + " " + rtfEscape(value) + "\}"
			}
			return "" when out == ""
			return "\{\\info" + out + "\}"
		}

		// colorNumber returns the color's index in the color table, adding it.
		def colorNumber(value color.Color) int {
			let key = rtfColorKey(value)
			let index = keys.indexOf(key)
			if index < 0 {
				keys.push(key)
				palette.push(value)
				return keys.len()
			}
			return index + 1
		}

		// styleNumber returns the paragraph style of a named style, adding it; 0
		// for no name.
		def styleNumber(name string) int {
			return 0 when rtfPlainStyle(name.lower())
			let index = styles.indexOf(name)
			if index < 0 {
				styles.push(name)
				index = styles.len() - 1
			}
			return rtfFirstCustomStyle + index
		}

		// start returns the opening of a paragraph: its formatting reset, then
		// the style, the extra words and the alignment.
		def start(styleId int, extra string, inTable bool, alignment Alignment) string {
			let out = "\\pard\\plain"
			out += "\\intbl" when inTable
			out += "\\s{styleId}" when styleId > 0
			return out + extra + rtfAlignWord(alignment) + "\\f0\\fs{textSize()} "
		}

		// units encodes the blocks. `quote` is how many quotes they sit in, and
		// `fallback` the alignment of paragraphs that have none (a table
		// column's).
		def units(blocks Block[], inTable bool, quote int, fallback Alignment) RtfUnit[] {
			let out = RtfUnit[]
			for let (_, block) in blocks {
				let alignment = block.alignment == Alignment.Default ?? (fallback, block.alignment)
				match block.kind {
					case BlockKind.Section, BlockKind.Item, BlockKind.Row, BlockKind.Cell:
						out.push(...units(block.children, inTable, quote, fallback))
					case BlockKind.Heading:
						let level = block.level.clamp(1, 6)
						let size = textSize() + (level < 5 ?? ((5 - level) * 4, 0))
						let head = start(level, "\\outlinelevel{level - 1}\\keepn\\sb240\\sa120", inTable, alignment)
						out.push(RtfUnit{content: head + "\\b\\fs{size} " + inlines(block.inlines), paragraph: true})
					case BlockKind.Paragraph:
						let head = ""
						if quote > 0 {
							head = start(rtfQuoteStyle, "\\li{720 * quote}\\ri720\\sa120", inTable, alignment)
						} else {
							head = start(styleNumber(block.styleName), "\\sa120", inTable, alignment)
						}
						out.push(RtfUnit{content: head + inlines(block.inlines), paragraph: true})
					case BlockKind.List:
						out.push(...listUnits(block, 0, inTable, quote))
					case BlockKind.Table:
						out.push(...tableUnits(block, inTable))
					case BlockKind.Image:
						let alt = block.title == "" ?? (inlineText(block.inlines), block.title)
						out.push(RtfUnit{content: start(0, "\\sa120", inTable, alignment) + picture(block.source, alt), paragraph: true})
						out.push(RtfUnit{content: start(rtfCaptionStyle, "\\sa120", inTable, alignment) + inlines(block.inlines), paragraph: true}) when block.inlines.len() > 0
					case BlockKind.Code:
						let lines = string[]
						for let (_, line) in block.content.split("\n") {
							lines.push(rtfEscape(line))
						}
						let head = "\\pard\\plain" + (inTable ?? ("\\intbl", "")) + "\\s{rtfCodeStyleId}\\sa0\\f1\\fs{textSize() - 4} "
						out.push(RtfUnit{content: head + lines.join("\\line "), paragraph: true})
					case BlockKind.Quote:
						out.push(...units(block.children, inTable, quote + 1, fallback))
					case BlockKind.Rule:
						out.push(RtfUnit{content: "\\pard\\plain" + (inTable ?? ("\\intbl", "")) + "\\brdrb\\brdrs\\brdrw10\\brsp20 ", paragraph: true})
					case BlockKind.PageBreak:
						out.push(RtfUnit{content: "\\page", paragraph: false}) unless inTable
					case BlockKind.Raw:
						out.push(RtfUnit{content: block.content, paragraph: false}) when block.format == "rtf"
					default:
				}
			}
			return out
		}

		// listUnits encodes a list at a list level: its own list definition, a
		// paragraph per item, nested lists one level down.
		def listUnits(list Block, depth int, inTable bool, quote int) RtfUnit[] {
			let id = listDef(list)
			let indent = 720 * (depth + 1)
			let out = RtfUnit[]
			let number = list.start
			for let (_, item) in list.children {
				let first = true
				for let (_, child) in item.children {
					if child.kind == BlockKind.Paragraph && first {
						first = false
						let marker = list.ordered ?? ("{number}.", "\\u8226 ?")
						let task = ""
						let checked = item.checked
						task = rtfEscape(checked ?? ("☑ ", "☐ ")) unless checked is none
						let head = start(0, "\\ls{id}\\ilvl{depth}\\li{indent}\\fi-360\\sa60", inTable, child.alignment)
						out.push(RtfUnit{content: head + "\{\\listtext " + marker + "\\tab\}" + task + inlines(child.inlines), paragraph: true})
					} else if child.kind == BlockKind.List {
						out.push(...listUnits(child, depth + 1, inTable, quote))
					} else if child.kind == BlockKind.Paragraph {
						out.push(RtfUnit{content: start(0, "\\li{indent}\\sa60", inTable, child.alignment) + inlines(child.inlines), paragraph: true})
					} else {
						out.push(...units(Block[child], inTable, quote, Alignment.Default))
					}
				}
				number++
			}
			return out
		}

		// listDef declares the list in the list table and returns its `\ls`
		// number. Every level numbers alike, so a nested list gets its own.
		def listDef(list Block) int {
			let id = listDefs.len() + 1
			let levels = ""
			for let level = 0; level < 9; level++ {
				let indent = 720 * (level + 1)
				if list.ordered {
					levels += "\n\{\\listlevel\\levelnfc0\\levelnfcn0\\leveljc0\\leveljcn0\\levelfollow0\\levelstartat{list.start}\\levelspace0\\levelindent0\{\\leveltext\\'02\\'0{level}.;\}\{\\levelnumbers\\'01;\}\\fi-360\\li{indent}\\lin{indent}\}"
				} else {
					levels += "\n\{\\listlevel\\levelnfc23\\levelnfcn23\\leveljc0\\leveljcn0\\levelfollow0\\levelstartat1\\levelspace0\\levelindent0\{\\leveltext\\'01\\u8226 ?;\}\{\\levelnumbers;\}\\fi-360\\li{indent}\\lin{indent}\}"
				}
			}
			listDefs.push("\{\\list\\listtemplateid{id}\\listhybrid" + levels + "\{\\listname ;\}\\listid{id}\}")
			overrides.push("\{\\listoverride\\listid{id}\\listoverridecount0\\ls{id}\}")
			return id
		}

		// tableUnits encodes a table as rows of cells, merged cells as
		// `\clmrg` and `\clvmrg` continuations, and an empty paragraph after it
		// so a following table stays apart. Inside a cell, where RTF nesting is
		// not written, each row becomes a paragraph of tab-separated text.
		def tableUnits(table Block, inTable bool) RtfUnit[] {
			let out = RtfUnit[]
			if inTable {
				for let (_, row) in table.children {
					let texts = string[]
					for let (_, cell) in row.children {
						texts.push(cell.plainText().replace("\n", " "))
					}
					out.push(RtfUnit{content: start(0, "", true, Alignment.Default) + rtfEscape(texts.join("\t")), paragraph: true})
				}
				return out
			}

			let grid = 1
			for let (_, row) in table.children {
				let count = 0
				for let (_, cell) in row.children {
					count += cell.columnSpan.clamp(1, 63)
				}
				grid = count when count > grid
			}
			let width = ((codec.pageWidth - 2 * codec.margin) / grid).clamp(200, 31680)
			let border = "\\clbrdrt\\brdrs\\brdrw10\\clbrdrl\\brdrs\\brdrw10\\clbrdrb\\brdrs\\brdrw10\\clbrdrr\\brdrs\\brdrw10"
			let blankCell = "\\pard\\intbl\\cell "
			// Rows still covered below a cell that spans rows, and that cell's
			// column span, by column.
			let pending = int[]
			let spans = int[]
			let rows = string[]
			for let (_, row) in table.children {
				let defs = "\\trowd\\trgaph108\\trleft0" + (row.header ?? ("\\trhdr", ""))
				let cells = ""
				let column = 0
				let k = 0
				for k < row.children.len() || rtfPendingFrom(pending, column) {
					rtfGrow(pending, column + 1)
					rtfGrow(spans, column + 1)
					if pending[column] > 0 {
						let span = spans[column]
						pending[column]--
						for let s = 0; s < span; s++ {
							defs += (s == 0 ?? ("\\clvmrg", "\\clmrg")) + border + "\\cellx{(column + s + 1) * width}"
							cells += blankCell
						}
						column += span
						continue
					}
					if k >= row.children.len() {
						defs += border + "\\cellx{(column + 1) * width}"
						cells += blankCell
						column++
						continue
					}

					let cell = row.children[k]
					k++
					let span = cell.columnSpan.clamp(1, 63)
					if cell.rowSpan > 1 {
						pending[column] = cell.rowSpan - 1
						spans[column] = span
					}
					for let s = 0; s < span; s++ {
						let merge = s == 0 ?? ((cell.rowSpan > 1 ?? ("\\clvmgf", "")), "\\clmrg")
						defs += merge + border + "\\cellx{(column + s + 1) * width}"
					}
					let alignment = column < table.alignments.len() ?? (table.alignments[column], Alignment.Default)
					cells += cellContent(cell, alignment)
					for let s = 1; s < span; s++ {
						cells += blankCell
					}
					column += span
				}
				rows.push(defs + "\n" + cells + "\\row")
			}
			out.push(RtfUnit{content: rows.join("\n"), paragraph: false})
			out.push(RtfUnit{content: "\\pard\\plain ", paragraph: true})
			return out
		}

		// cellContent encodes the blocks of a cell, the last paragraph ended by
		// `\cell`.
		def cellContent(cell Block, alignment Alignment) string {
			let parts = units(cell.children, true, 0, alignment)
			return "\\pard\\intbl\\cell " when parts.len() == 0
			let out = ""
			for let (i, unit) in parts {
				let last = i == parts.len() - 1
				if unit.paragraph {
					out += unit.content + (last ?? ("\\cell ", "\\par "))
				} else {
					out += unit.content + (last ?? ("\\pard\\intbl\\cell ", ""))
				}
			}
			return out
		}

		def inlines(items Inline[]) string {
			let parts = string[]
			for let (_, item) in items {
				parts.push(inline(item))
			}
			return parts.join("")
		}

		def inline(item Inline) string {
			match item.kind {
				case InlineKind.Text:
					return rtfEscape(item.content)
				case InlineKind.Bold:
					return "\{\\b " + inlines(item.children) + "\}"
				case InlineKind.Italic:
					return "\{\\i " + inlines(item.children) + "\}"
				case InlineKind.Underline:
					return "\{\\ul " + inlines(item.children) + "\}"
				case InlineKind.Strike:
					return "\{\\strike " + inlines(item.children) + "\}"
				case InlineKind.Code:
					return "\{\\f1 " + rtfEscape(item.content) + "\}"
				case InlineKind.Link:
					let instruction = "HYPERLINK \"" + rtfFieldText(item.url) + "\""
					instruction += " \\\\o \"" + rtfFieldText(item.title) + "\"" unless item.title == ""
					let blue = colorNumber(new color.Color(color.RGBA{r: 5, g: 99, b: 193, a: 255}))
					return "\{\\field\{\\*\\fldinst\{" + instruction + "\}\}\{\\fldrslt\{\\ul\\cf{blue} " + inlines(item.children) + "\}\}\}"
				case InlineKind.Image:
					return picture(item.url, inlineText(item.children))
				case InlineKind.Styled:
					let words = ""
					let fg = item.foreground
					let bg = item.background
					words += "\\cf{colorNumber(fg)}" unless fg is none
					words += "\\chcbpat{colorNumber(bg)}" unless bg is none
					return inlines(item.children) when words == ""
					return "\{" + words + " " + inlines(item.children) + "\}"
				case InlineKind.LineBreak:
					return "\\line "
				case InlineKind.Footnote:
					let paragraphs = string[]
					for let (_, unit) in units(item.note, false, 0, Alignment.Default) {
						paragraphs.push(unit.content)
					}
					return "\{\\super\\chftn\}\{\\footnote " + paragraphs.join("\\par\n") + "\}"
				case InlineKind.Raw:
					return item.format == "rtf" ?? (item.content, "")
				default:
					return ""
			}
		}

		// picture embeds the resource the source names, or writes an
		// INCLUDEPICTURE field for a picture that is not embedded or of a kind
		// RTF does not hold.
		def picture(source string, alt string) string {
			let data = doc.resources.get(source)
			let blip = ""
			blip = rtfBlip(source, data) unless data is none
			return "\{\\field\{\\*\\fldinst\{INCLUDEPICTURE \"" + rtfFieldText(source) + "\" \\\\d\}\}\{\\fldrslt " + rtfEscape(alt) + "\}\}" when data is none || blip == ""

			let size = rtfPixelSize(data)
			let w = size[0] > 0 ?? (size[0], 320)
			let h = size[1] > 0 ?? (size[1], 240)
			let goalWidth = w * 15
			let goalHeight = h * 15
			let widest = codec.pageWidth - 2 * codec.margin
			if goalWidth > widest && widest > 0 {
				goalHeight = goalHeight * widest / goalWidth
				goalWidth = widest
			}
			let lines = string[]
			for let i = 0; i < data.len(); i += 64 {
				let end = (i + 64).clamp(0, data.len())
				lines.push(data[i:end].hex())
			}
			return "\{\\pict" + blip + "\\picw{w}\\pich{h}\\picwgoal{goalWidth}\\pichgoal{goalHeight}\n" + lines.join("\n") + "\}"
		}
	}

	internal def rtfAlignWord(alignment Alignment) string {
		match alignment {
			case Alignment.Left:
				return "\\ql"
			case Alignment.Center:
				return "\\qc"
			case Alignment.Right:
				return "\\qr"
			case Alignment.Justify:
				return "\\qj"
			default:
				return ""
		}
	}

	// rtfEscape returns text as RTF: `\`, `{` and `}` escaped, tabs and line
	// ends as control words, everything past ASCII as `\uN?`.
	internal def rtfEscape(content string) string {
		let out = byte[]
		for let (_, c) in content {
			let code = int(c)
			if c := '\\' || '{' || '}' {
				out.push(byte(92), byte(code))
			} else if c == '\t' {
				out.push(..."\\tab ".bytes())
			} else if c == '\n' {
				out.push(..."\\line ".bytes())
			} else if c == '\r' {
				continue
			} else if code < 128 {
				out.push(byte(code))
			} else if code < 0x10000 {
				out.push(...rtfUnicode(code).bytes())
			} else {
				let rest = code - 0x10000
				out.push(...rtfUnicode(0xd800 + (rest / 1024)).bytes())
				out.push(...rtfUnicode(0xdc00 + (rest % 1024)).bytes())
			}
		}
		return string(out)
	}

	// rtfUnicode returns `\uN?` for a UTF-16 unit, N signed as RTF wants it.
	internal def rtfUnicode(unit int) string {
		let signed = unit > 32767 ?? (unit - 65536, unit)
		return "\\u{signed}?"
	}

	// rtfFieldText returns text for a quoted field argument.
	internal def rtfFieldText(content string) string {
		return rtfEscape(content.replace("\"", "%22"))
	}

	internal def rtfPendingFrom(pending int[], column int) bool {
		for let i = column; i < pending.len(); i++ {
			return true when pending[i] > 0
		}
		return false
	}

	internal def rtfGrow(values int[], size int) {
		for values.len() < size {
			values.push(0)
		}
	}

	// rtfBlip returns the picture-kind control word for the data, empty when
	// RTF cannot hold it.
	internal def rtfBlip(source string, data byte[]) string {
		return "\\pngblip" when data.len() > 4 && int(data[0]) == 0x89 && int(data[1]) == 0x50
		return "\\jpegblip" when data.len() > 3 && int(data[0]) == 0xff && int(data[1]) == 0xd8
		let lowered = source.lower()
		return "\\emfblip" when lowered.endsWith(".emf")
		return "\\wmetafile8" when lowered.endsWith(".wmf")
		return ""
	}

	// rtfPixelSize returns the width and height of a PNG or JPEG image, zeros
	// when they cannot be read.
	internal def rtfPixelSize(data byte[]) int[] {
		return int[rtfBig(data, 16, 4), rtfBig(data, 20, 4)] when data.len() >= 24 && int(data[0]) == 0x89
		if data.len() > 4 && int(data[0]) == 0xff && int(data[1]) == 0xd8 {
			let i = 2
			for i + 9 < data.len() && int(data[i]) == 0xff {
				let marker = int(data[i + 1])
				if marker >= 0xc0 && marker <= 0xcf && !(marker := 0xc4 || 0xc8 || 0xcc) {
					return int[rtfBig(data, i + 7, 2), rtfBig(data, i + 5, 2)]
				}
				i += 2 + rtfBig(data, i + 2, 2)
			}
		}
		return int[0, 0]
	}

	// rtfBig reads a big-endian number of `count` bytes at the offset.
	internal def rtfBig(data byte[], offset int, count int) int {
		let out = 0
		for let i = 0; i < count; i++ {
			out = out * 256 + int(data[offset + i])
		}
		return out
	}
}
