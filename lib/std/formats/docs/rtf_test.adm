partial module std.formats.docs {
	use (
		std.bytes
		std.gfx.color
		std.os
		std.testing
	)

	check "Rtf" {
		// Sample documents live in the repo, and `adm test` runs from its root.
		// A missing sample skips rather than fails.
		let sampleDir = "samples/documents/rtf/"

		internal def kinds(items Inline[]) string {
			let out = string[]
			for let (_, item) in items {
				out.push("{item.kind}")
			}
			return out.join(",")
		}

		internal def rtf() Rtf {
			return new Rtf()
		}

		internal def sample(name string) ?byte[] {
			let data = os.readFile(sampleDir + name)
			return none when data is error
			return data
		}

		@test()
		def TestCharacters() !none {
			let source = "\{\\rtf1\\ansi\\deff0\{\\fonttbl\{\\f0 Times;\}\{\\f1\\fmodern Courier New;\}\}\{\\colortbl;\\red255\\green0\\blue0;\}\n\\pard Plain \{\\b bold\} \{\\i it\}\{\\ul u\}\{\\strike s\} \{\\cf1 red\} \{\\f1 mono\} caf\\'e9 \\'93q\\'94 \\u8364? \\u-10179?\\u-8704? a\\tab b\\~c\\emdash d\\par\}"
			let doc = rtf().decode(source)
			assert doc.blocks.len() == 1
			let p = doc.blocks[0]
			assert p.plainText() == "Plain bold itus red mono café “q” € 😀 a\tb c—d"
			assert kinds(p.inlines) == "Text,Bold,Text,Italic,Underline,Strike,Text,Styled,Text,Code,Text"
			let styled = p.inlines[7]
			let fg = styled.foreground
			fail "no color" when fg is none
			assert fg.red == 255 && fg.green == 0
			return none
		}

		@test()
		def TestMergesRuns() {
			let doc = rtf().decode("\{\\rtf1 \{\\b one \}\{\\b\\i two\}\{\\b  three\}\\par\}")
			let p = doc.blocks[0]
			assert kinds(p.inlines) == "Bold"
			assert kinds(p.inlines[0].children) == "Text,Italic,Text"
		}

		@test()
		def TestInfo() !none {
			let source = "\{\\rtf1\\deflang2057\{\\info\{\\title Report\}\{\\author Ann Lee; Bo Chen\}\{\\subject Sales\}\{\\creatim\\yr2026\\mo9\\dy21\\hr10\\min30\}\{\\revtim\\yr2020\\mo1\\dy1\}\}\\pard Text\\par\}"
			let doc = rtf().decode(source)
			assert doc.title == "Report"
			assert doc.authors.join("|") == "Ann Lee|Bo Chen"
			assert doc.metadata.hasKey("subject") && doc.metadata["subject"] == "Sales"
			assert doc.language == "en-GB"
			let date = doc.date
			fail "no date" when date is none
			assert date.str().startsWith("2026-09-21T10:30")
			assert doc.plainText() == "Text"
			return none
		}

		@test()
		def TestStructure() !none {
			let source = string[
				"\{\\rtf1\{\\stylesheet\{Normal;\}\{\\s1\\outlinelevel0 heading 1;\}\{\\s2 heading 2;\}\{\\s7 Quote;\}\{\\s8 Source Code;\}\{\\s9 Fancy;\}\}\n",
				"\{\\*\\listtable\{\\list\{\\listlevel\\levelnfc23\{\\leveltext\\'01\\u8226 ?;\}\}\{\\listlevel\\levelnfc0\\levelstartat3\}\\listid5\}\}\{\\*\\listoverridetable\{\\listoverride\\listid5\\ls1\}\}\n",
				"\\pard\\s1\{\\b Title\}\\par\\pard\\s2 Part\\par\n",
				"\\pard\\s9\\qc Centered\\par\n",
				"\\pard\\ls1\\ilvl0\{\\listtext\\u8226 ?\\tab\}one\\par\\pard\\ls1\\ilvl1\{\\listtext 3.\\tab\}nested\\par\\pard\\ls1\\ilvl0 two\\par\n",
				"\\pard\\ls1 \\u9745 ? done\\par\n",
				"\\pard\\s7\\i quoted\\par\\pard\\s7\\li1440 deeper\\par\n",
				"\\pard\\s8 let x = 1\\line let y = 2\\par\\pard\\s8\\par\\pard\\s8 z\\par\n",
				"\\pard\\brdrb\\brdrs\\brdrw10 \\par\\pard after\\page next\\par\}"
			].join("")
			let doc = rtf().decode(source)
			let blocks = doc.blocks
			assert doc.title == "Title"
			assert blocks[0].kind == BlockKind.Heading && blocks[0].level == 1
			assert kinds(blocks[0].inlines) == "Text"
			assert blocks[1].kind == BlockKind.Heading && blocks[1].level == 2
			assert blocks[2].styleName == "Fancy" && blocks[2].alignment == Alignment.Center

			let list = blocks[3]
			assert list.kind == BlockKind.List && !list.ordered
			assert list.children.len() == 3
			let nested = list.children[0].children[1]
			assert nested.kind == BlockKind.List && nested.ordered && nested.start == 3
			assert list.children[1].plainText() == "two"
			let task = list.children[2]
			let checked = task.checked
			fail "not a task" when checked is none
			assert checked
			assert task.plainText() == "done"

			let quote = blocks[4]
			assert quote.kind == BlockKind.Quote
			assert kinds(quote.children[0].inlines) == "Text"
			assert quote.children[1].kind == BlockKind.Quote
			assert quote.children[1].plainText() == "deeper"

			assert blocks[5].kind == BlockKind.Code
			assert blocks[5].content == "let x = 1\nlet y = 2\n\nz"
			assert blocks[6].kind == BlockKind.Rule
			assert blocks[7].plainText() == "after"
			assert blocks[8].kind == BlockKind.PageBreak
			assert blocks[9].plainText() == "next"
			assert blocks.len() == 10
			return none
		}

		@test()
		def TestTable() {
			let row1 = "\\trowd\\trhdr\\cellx1000\\cellx2000\\cellx3000\\pard\\intbl A\\cell B\\cell C\\cell\\row\n"
			let row2 = "\\trowd\\clvmgf\\cellx1000\\cellx2000\\clmrg\\cellx3000\\pard\\intbl\\qr 1\\cell\\qc wide\\cell\\cell\\row\n"
			let row3 = "\\trowd\\clvmrg\\cellx1000\\cellx2000\\cellx3000\\pard\\intbl\\cell\\qc x\\cell\\qc y\\par more\\cell\\row\n"
			let doc = rtf().decode("\{\\rtf1 " + row1 + row2 + row3 + "\\pard after\\par\}")
			let table = doc.blocks[0]
			assert table.kind == BlockKind.Table
			assert table.children.len() == 3
			assert table.children[0].header && !table.children[1].header
			assert table.children[1].children.len() == 2
			assert table.children[1].children[0].rowSpan == 2
			assert table.children[1].children[1].columnSpan == 2
			assert table.children[2].children.len() == 2
			assert table.children[2].children[1].plainText() == "y\nmore"
			assert table.alignments[0] == Alignment.Right
			assert table.alignments[1] == Alignment.Center
			assert table.children[1].children[1].children[0].alignment == Alignment.Default
			assert doc.blocks[1].plainText() == "after"
		}

		@test()
		def TestFieldsNotesPictures() !none {
			let link = "\{\\field\{\\*\\fldinst\{HYPERLINK \"https://a.example\" \\\\o \"tip\"\}\}\{\\fldrslt\{\\ul\\cf1 site\}\}\}"
			let picture = "\{\\*\\shppict\{\\pict\\pngblip\\picw1\\pich1 89504e47\n0d0a\}\}\{\\nonshppict\{\\pict\\wmetafile8 0102\}\}"
			let note = "\{\\super\\chftn\}\{\\footnote\\pard\\plain\{\\super\\chftn\} a note\}"
			let doc = rtf().decode("\{\\rtf1\{\\colortbl;\\red0\\green0\\blue255;\}\{\\stylesheet\{\\s9 caption;\}\}\\pard see " + link + note + " end\\par\\pard " + picture + "\\par\\pard\\s9 Figure\\par\{\\header head\}\}")
			let p = doc.blocks[0]
			assert kinds(p.inlines) == "Text,Link,Footnote,Text"
			let found = p.inlines[1]
			assert found.url == "https://a.example" && found.title == "tip"
			assert kinds(found.children) == "Text"
			assert p.inlines[2].note[0].plainText() == "a note"

			let image = doc.blocks[1]
			assert image.kind == BlockKind.Image
			assert image.source == "image1.png"
			let data = doc.resource("image1.png")
			fail "no picture" when data is none
			assert data.hex() == "89504E470D0A"
			assert image.plainText() == "Figure"
			assert doc.resources.len() == 1
			assert doc.blocks.len() == 2
			return none
		}

		// sampleDoc builds a document with every construct the codec writes.
		internal def sampleDoc() Document {
			let doc = new Document("Quarterly Report")
			doc.authors.push("Ann Lee", "Bo Chen")
			doc.metadata.set("subject", "Sales")
			doc.language = "de-DE"
			doc.heading(1, "Summary")
			doc.paragraph(text("Revenue "), bold("grew"), text(" by "), italic(text("a "), bold("lot")), text(", "), strike("not"), text(" see "), link("the site", "https://a.example/x?q=1#top", "Home"), text(" and "), code("x\{y\}"), text(" "), underline("under"), text("."))
			doc.paragraph(text("Colors: "), colored("red", new color.Color(color.RGBA{r: 255, g: 0, b: 0, a: 255})), text(" and "), text("Ünïcødé — 😀 \\ \{ \}"), lineBreak(), text("next line"), footnote("A note."))
			doc.paragraph("centered").alignment = Alignment.Center
			doc.paragraph("styled").styleName = "Fancy"
			doc.heading(2, "Lists")
			let items = doc.list(string["one", "two"])
			items.children[0].list(string["nested a", "nested b"], true).start = 4
			let tasks = doc.list(string["done", "open"])
			tasks.children[0].checked = true
			tasks.children[1].checked = false
			doc.list(string["ninth", "tenth"], true).start = 9
			let quote = doc.quote()
			quote.paragraph("quoted")
			quote.quote().paragraph("deeper")
			doc.code("go", "func main() \{\n\tprintln(1)\n\}")
			doc.rule()
			let table = doc.table(string["Region", "Sales"], string[][string["North", "120"], string["South", "95"]])
			table.alignments[1] = Alignment.Right
			doc.pageBreak()
			doc.image("chart.png", byte[0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 13, 0x49, 0x48, 0x44, 0x52, 0, 0, 0, 2, 0, 0, 0, 3], "The chart")
			doc.paragraph("last")
			return doc
		}

		@test()
		def TestRoundTrip() !none {
			let codec = new Rtf()
			let doc = sampleDoc()
			let encoded = codec.encode(doc)
			for let (_, c) in encoded {
				assert int(c) < 128
			}
			let back = codec.decode(encoded)

			assert back.title == doc.title
			assert back.authors.join("|") == "Ann Lee|Bo Chen"
			assert back.metadata.hasKey("subject") && back.metadata["subject"] == "Sales"
			assert back.language == "de-DE"
			let markdown = new Markdown()
			// RTF has no code language, and a picture comes back under the name
			// its kind gives it.
			assert markdown.encode(back) == markdown.encode(doc).replace("```go", "```").replace("chart.png", "image1.png")
			let plain = new PlainText()
			assert plain.encode(back) == plain.encode(doc).replace("chart.png", "image1.png")
			assert back.blocks[3].alignment == Alignment.Center
			assert back.blocks[4].styleName == "Fancy"
			let data = back.resource("image1.png")
			fail "no picture" when data is none
			assert data.len() == 24
			assert codec.encode(back) == encoded.replace("chart.png", "image1.png")
			return none
		}

		@test()
		def TestSpans() {
			let doc = new Document()
			let table = doc.table(string["A", "B", "C"], string[][string["1", "2"], string["3"]])
			table.children[1].children[0].rowSpan = 2
			table.children[1].children[1].columnSpan = 2
			table.children[1].children.pop()
			table.children[2].children.pop()
			table.children[2].children.pop()
			let codec = new Rtf()
			let back = codec.decode(codec.encode(doc)).blocks[0]
			assert back.children[1].children.len() == 2
			assert back.children[1].children[0].rowSpan == 2
			assert back.children[1].children[1].columnSpan == 2
			assert back.children[2].children.len() == 1
			assert back.children[2].children[0].plainText() == "3"
		}

		@test()
		def TestSignatureAndLoad() !none {
			let codec = new Rtf()
			assert codec.matchSignature(new bytes.Reader("\{\\rtf1 x\}".bytes()))
			assert !codec.matchSignature(new bytes.Reader("\{\\pard x\}".bytes()))
			let doc = try load("\{\\rtf1 \{\\b Hi\}\\par\}".bytes())
			assert doc.plainText() == "Hi"
			let plain = try load(new bytes.Reader("\{\\pard x\\par\}".bytes()), ".rtf")
			assert plain.plainText() == "x"
			return none
		}

		@test()
		def TestSamples() {
			let data = sample("10-pages.rtf")
			return when data is none
			let doc = rtf().decode(data)
			assert doc.authors.join("|") == "mysamplefiles.com"
			assert doc.language == "en-US"
			let text = doc.plainText()
			assert text.startsWith("Chapter 1: The Hidden Forest")
			assert text.contains("I think we’re close to something special!")
			assert text.contains("“I can feel it,”")
			assert !text.contains("Times New Roman")
			assert kinds(doc.blocks[0].inlines) == "Bold"

			for let (_, name) in string["1-page.rtf", "3-pages.rtf", "5-pages.rtf", "7-pages.rtf", "rtf_sample_file_50KB.rtf", "rtf_sample_file_1MB.rtf"] {
				let other = sample(name)
				continue when other is none
				let decoded = rtf().decode(other)
				assert decoded.blocks.len() > 0
				assert decoded.plainText().len() > 1000
			}
			let lorem = sample("rtf_sample_file_50KB.rtf")
			return when lorem is none
			assert rtf().decode(lorem).plainText().startsWith("Lorem ipsum dolor sit amet")
		}
	}
}
