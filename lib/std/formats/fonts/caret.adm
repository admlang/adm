// Caret placement and hit testing on shaped text: where between glyphs a
// text position falls, and which position a point along the line is
// nearest, ligatures and right-to-left runs included.

partial module std.formats.fonts {
	use (
		std.text.unicode
		std.formats.fonts.layout
	)

	// How far a shaped run reaches along its line, in font units: the sum of
	// the advances (downward ones for vertical runs).
	def advance(run ShapedRun) float {
		let total = 0.0
		for let (_, g) in run.glyphs {
			total += run.direction == TextDirection.TopToBottom ?? (-float(g.yAdvance), float(g.xAdvance))
		}
		return total
	}

	// Where the caret goes in a shaped run before byte `offset` of `text`,
	// the text the run was shaped from: font units along the line from the
	// run's left (vertical runs: top) edge. Offsets inside a user-perceived
	// character move back to its start; the end of the text is the run's
	// far edge in reading order. Inside a ligature the caret sits at the
	// face's own ligature caret positions (GDEF) when `face`, the face the
	// run was shaped with, lists them; otherwise the ligature's width is
	// shared evenly by the characters it joins.
	def caretPosition(run ShapedRun, text string, offset int, face ?Face = none) float {
		let rtl = run.direction == TextDirection.RightToLeft
		let total = advance(run)
		let bounds = graphemeOffsets(text)
		let textBytes = bounds[bounds.len() - 1]
		let o = 0
		for let (_, b) in bounds {
			o = b when b <= offset
		}
		return rtl ?? (0.0, total) when o >= textBytes
		for let (_, cl) in caretClusters(run, bounds) {
			if o >= cl.start && o < cl.end {
				let carets = clusterCarets(cl, bounds, rtl, face)
				let k = 0
				for let (_, b) in bounds {
					k++ when b > cl.start && b < cl.end && b <= o
				}
				return carets[k]
			}
		}
		return rtl ?? (0.0, total)
	}

	// The byte offset of `text` whose caret in the shaped run is nearest
	// `position` (font units along the line from the run's left or top
	// edge): always the start of a user-perceived character or the end of
	// the text. Positions past either edge give the text's start or end, as
	// the run's direction says.
	def hitTest(run ShapedRun, text string, position float, face ?Face = none) int {
		let rtl = run.direction == TextDirection.RightToLeft
		let bounds = graphemeOffsets(text)
		let textBytes = bounds[bounds.len() - 1]
		let clusters = caretClusters(run, bounds)
		return 0 when clusters.len() == 0
		let total = advance(run)
		return rtl ?? (textBytes, 0) when position <= 0.0
		return rtl ?? (0, textBytes) when position >= total
		let cl = clusters[clusters.len() - 1]
		for let (_, c) in clusters {
			if position >= c.from && position < c.to {
				cl = c
				break
			}
		}
		let carets = clusterCarets(cl, bounds, rtl, face)
		let offsets int[]
		offsets.push(cl.start)
		for let (_, b) in bounds {
			offsets.push(b) when b > cl.start && b < cl.end
		}
		offsets.push(cl.end)
		let best = 0
		for let k = 1; k < carets.len(); k++ {
			best = k when (carets[k] - position).abs() < (carets[best] - position).abs()
		}
		return offsets[best]
	}

	// One cluster of a run in visual order: where it starts and ends along
	// the line, the glyph that carries it, and the text bytes it covers.
	internal struct CaretCluster {
		from   float
		to     float
		glyph  int
		single bool
		start  int
		end    int
	}

	// The run's clusters in visual order, with each one's text range;
	// `bounds` are the text's grapheme offsets.
	internal def caretClusters(run ShapedRun, bounds int[]) CaretCluster[] {
		let textBytes = bounds[bounds.len() - 1]
		let vertical = run.direction == TextDirection.TopToBottom
		let out CaretCluster[]
		let pos = 0.0
		let k = 0
		let n = run.glyphs.len()
		for k < n {
			let c = run.glyphs[k].cluster
			let j = k
			let width = 0.0
			for j < n && run.glyphs[j].cluster == c {
				let g = run.glyphs[j]
				width += vertical ?? (-float(g.yAdvance), float(g.xAdvance))
				j++
			}
			// The cluster's text runs to the next larger cluster value.
			let end = textBytes
			for let (_, g) in run.glyphs {
				end = g.cluster when g.cluster > c && g.cluster < end
			}
			// Widened to whole user-perceived characters: a mark shaped apart
			// from its base never splits them.
			let start = 0
			for let (_, b) in bounds {
				start = b when b <= c
			}
			let stop = textBytes
			for let i = bounds.len() - 1; i >= 0; i-- {
				stop = bounds[i] when bounds[i] >= end
			}
			out.push(CaretCluster{from: pos, to: pos + width, glyph: int(run.glyphs[k].glyph), single: j - k == 1, start: start, end: stop})
			pos += width
			k = j
		}
		return out
	}

	// Byte offsets where the text's user-perceived characters start, and
	// its end.
	internal def graphemeOffsets(text string) int[] {
		let bytesAt int[]
		let at = 0
		bytesAt.push(0)
		for let (_, ch) in text {
			let cp = int(ch)
			at += cp < 0x80 ?? (1, cp < 0x800 ?? (2, cp < 0x10000 ?? (3, 4)))
			bytesAt.push(at)
		}
		let out int[]
		out.push(0)
		for let (_, b) in unicode.graphemeBreaks(text) {
			out.push(bytesAt[b])
		}
		return out
	}

	// The caret positions inside a cluster, one per grapheme boundary from
	// its start to its end in logical order, along the line.
	internal def clusterCarets(cl CaretCluster, bounds int[], rtl bool, face ?Face) float[] {
		let inside int[]
		for let (_, b) in bounds {
			inside.push(b) when b > cl.start && b < cl.end
		}
		let parts = inside.len() + 1
		// A ligature's own caret positions, when the font lists them.
		let listed = cl.single && parts > 1 ?? (ligatureCarets(face, cl.glyph), float[])
		let out float[]
		for let k = 0; k <= parts; k++ {
			let fraction = float(k) / float(parts)
			let x = 0.0
			if k > 0 && k < parts && listed.len() == parts - 1 {
				// Listed in increasing x: the first grapheme of a right-to-left
				// ligature is the rightmost.
				x = cl.from + (rtl ?? (listed[parts - 1 - k], listed[k - 1]))
			} else {
				x = rtl ?? (cl.to - (cl.to - cl.from) * fraction, cl.from + (cl.to - cl.from) * fraction)
			}
			out.push(x)
		}
		return out
	}

	// GDEF ligature caret positions of a glyph, in font units from its
	// origin, ascending; empty when the face lists none.
	internal def ligatureCarets(face ?Face, glyph int) float[] {
		let out float[]
		let f = face
		return out when f is none
		let font = new layout.ShapeFont(f)
		for let (_, x) in font.gdef.ligatureCarets(glyph, font) {
			out.push(float(x))
		}
		return out
	}
}
