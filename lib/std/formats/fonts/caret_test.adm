partial module std.formats.fonts {
	use std.testing

	check "Carets and hit testing" {
		def caretFace() !Face {
			return try (try load("samples/fonts/ttf/caret.ttf")).face(0)
		}

		@test()
		def caretsFollowGlyphsAndLigatureCarets() !none {
			let face = try caretFace()
			let text = "office fi"
			// o, ffi (a ligature with GDEF carets), c, e, space, fi (one without).
			let run = try shape(face, text)
			assert run.glyphs.len() == 6 // two ligatures formed
			assert advance(run) == 3000.0 // 500 + 800 + 450 + 480 + 250 + 520
			let want = [0.0, 500.0, 750.0, 1060.0, 1300.0, 1750.0, 2230.0, 2480.0, 2740.0, 3000.0]
			for let (k, x) in want {
				assert caretPosition(run, text, k, face) == x // GDEF carets inside ffi, half way inside fi
			}
			// Without the face, a ligature's width is shared evenly.
			assert (caretPosition(run, text, 2) - (500.0 + 800.0 / 3.0)).abs() < 0.001 // a third of ffi
		}

		@test()
		def hitTestingFindsTheNearestCaret() !none {
			let face = try caretFace()
			let text = "office fi"
			let run = try shape(face, text)
			for let k = 0; k <= 9; k++ {
				assert hitTest(run, text, caretPosition(run, text, k, face), face) == k // every caret round-trips
			}
			assert hitTest(run, text, 760.0, face) == 2 // inside ffi, next to its first caret
			assert hitTest(run, text, 1000.0, face) == 3 // nearer the second
			assert hitTest(run, text, -50.0, face) == 0 // left of the run: the start
			assert hitTest(run, text, 9999.0, face) == 9 // right of it: the end
		}

		@test()
		def caretsOnOutlinePoints() !none {
			let face = try caretFace()
			// "fo" ligates; its caret is the x of the ligature's outline point 1.
			let run = try shape(face, "fo")
			assert run.glyphs.len() == 1 // one ligature
			assert caretPosition(run, "fo", 1, face) == 210.0 // on the point, not half way
		}

		@test()
		def rightToLeftRunsMirror() {
			// Three one-byte characters, shaped right to left: the first is
			// rightmost.
			let run = ShapedRun{direction: TextDirection.RightToLeft, glyphs: [ShapedGlyph{glyph:GlyphID(3), xAdvance:100, cluster:2}, ShapedGlyph{glyph:GlyphID(2), xAdvance:100, cluster:1}, ShapedGlyph{glyph:GlyphID(1), xAdvance:100, cluster:0}]}
			assert caretPosition(run, "abc", 0) == 300.0 // the start is the right edge
			assert caretPosition(run, "abc", 1) == 200.0 // after the first character
			assert caretPosition(run, "abc", 3) == 0.0 // the end is the left edge
			assert hitTest(run, "abc", 260.0) == 0 // nearest the right edge
			assert hitTest(run, "abc", 240.0) == 1 // nearest the next caret
			assert hitTest(run, "abc", -10.0) == 3 // left of the run: the end
		}

		@test()
		def caretsSkipInsideCharacters() {
			// e with a combining acute (bytes 1-2), then x: one character, then another.
			let run = ShapedRun{direction: TextDirection.LeftToRight, glyphs: [ShapedGlyph{glyph:GlyphID(1), xAdvance:500, cluster:0}, ShapedGlyph{glyph:GlyphID(2), xAdvance:0, cluster:1}, ShapedGlyph{glyph:GlyphID(3), xAdvance:400, cluster:3}]}
			assert caretPosition(run, "éx", 1) == 0.0 // inside "é": back to its start
			assert caretPosition(run, "éx", 3) == 500.0 // before x
			assert hitTest(run, "éx", 300.0) == 3 // never between the e and its accent
		}
	}
}
