// CFF: the Compact Font Format that carries PostScript outlines, in an
// OpenType font's `CFF ` table (version 1) or `CFF2` table (version 2, the
// variable-font form).

partial module std.formats.fonts.cff {
	use (
		std.math.geom
		std.formats.fonts
		std.formats.fonts.layout
		std.formats.fonts.cff.table::*
		std.formats.fonts.cff.charstring::*
	)

	// The per-Font-DICT state a charstring runs against.
	internal struct FontDict {
		subrs   Index
		vsindex int
		// The Private DICT bytes, for hinting parameters.
		priv    byte[]
	}

	// A parsed CFF or CFF2 font program: the glyph charstrings and everything
	// they reference. Outlines are decoded on demand.
	//
	// CFF2 outlines come out at the instance `outline` is given coordinates
	// for, the default one otherwise.
	type Cff {
		// The font's PostScript name, from the Name INDEX. Empty in CFF2, which
		// takes its name from the `name` table instead.
		name string

		internal data        byte[]
		internal cff2        bool
		internal cid         bool
		internal charStrings Index
		internal globalSubrs Index
		internal fontDicts   FontDict[]
		internal fdSelect    int[]
		internal charset     int[]
		internal regions     int[]
		// The CFF2 variation store `blend` weighs deltas with.
		internal vstore      layout.VariationStore
		// Offset of that store in the table, 0 when there is none.
		internal vstoreAt    int
		// Character code -> glyph, from the built-in encoding. Empty for CID
		// and CFF2 fonts.
		internal encoding    int[]

		def new() {}

		// Reads a CFF or CFF2 table.
		// Fails when the data is not a CFF font program, uses Type 1 charstrings,
		// or is truncated or inconsistent.
		def parse(data byte[]) !none {
			self.data = data
			let major = try readUint(data, 0, 1)
			let hdrSize = try readUint(data, 2, 1)

			if major == 2 {
				try parseCff2(hdrSize)
				return none
			}
			fail "not a CFF font program: version {major}" when major != 1

			let names = try readIndex(data, hdrSize)
			let topDicts = try readIndex(data, names.end)
			let strings = try readIndex(data, topDicts.end)
			globalSubrs = try readIndex(data, strings.end)
			fail "cff: the font set is empty" when topDicts.count() == 0

			name = string(try names.item(0)) when names.count() > 0

			let top = try parseDict(try topDicts.item(0))
			fail "cff: only Type 2 charstrings are supported" when int(top.number(opCharstringType, 2.0)) != 2
			fail "cff: the font has no CharStrings" unless top.has(opCharStrings)

			charStrings = try readIndex(data, int(top.number(opCharStrings)))
			let glyphs = charStrings.count()

			cid = top.has(opROS)
			if cid {
				fail "cff: a CID-keyed font needs an FDArray" unless top.has(opFDArray)
				try readFontDicts(int(top.number(opFDArray)))
				fdSelect = try readFDSelect(data, int(top.number(opFDSelect)), glyphs) when top.has(opFDSelect)
			} else {
				fontDicts.push(try readPrivate(top))
			}

			charset = try readCharset(data, int(top.number(opCharset)), glyphs)
			if !cid {
				try readEncoding(int(top.number(opEncoding)))
			}
		}

		internal def parseCff2(hdrSize int) !none {
			cff2 = true
			let topLength = try readUint(data, 3, 2)
			fail "cff: the top dict runs past the end of the data" when hdrSize + topLength > data.len()
			let top = try parseDict(data[hdrSize:hdrSize + topLength])
			globalSubrs = try readIndex(data, hdrSize + topLength, cff2 = true)

			fail "cff: the font has no CharStrings" unless top.has(opCharStrings)
			charStrings = try readIndex(data, int(top.number(opCharStrings)), cff2 = true)
			let glyphs = charStrings.count()

			if top.has(opVStore) {
				try readRegionCounts(int(top.number(opVStore)))
			}

			fail "cff: a CFF2 font needs an FDArray" unless top.has(opFDArray)
			try readFontDicts(int(top.number(opFDArray)))
			fdSelect = try readFDSelect(data, int(top.number(opFDSelect)), glyphs) when top.has(opFDSelect)
		}

		// Region counts of each ItemVariationData in the variation store, which
		// is what `blend` needs to know how many deltas to drop.
		internal def readRegionCounts(at int) !none {
			// The store is preceded by its 16-bit length.
			let store = at + 2
			vstore = new layout.VariationStore(new layout.Data(data), store)
			vstoreAt = store
			let dataCount = try readUint(data, store + 6, 2)
			for let i = 0; i < dataCount; i++ {
				let off = try readUint(data, store + 8 + i * 4, 4)
				regions.push(try readUint(data, store + off + 4, 2))
			}
		}

		internal def readFontDicts(at int) !none {
			let array = try readIndex(data, at, cff2)
			for let i = 0; i < array.count(); i++ {
				let fd = try parseDict(try array.item(i), regions)
				fontDicts.push(try readPrivate(fd))
			}
		}

		// Reads the Private DICT a Top or Font DICT points at, for its local
		// subroutines.
		internal def readPrivate(owner Dict) !FontDict {
			let out = FontDict{subrs: new Index(), vsindex: 0, priv: byte[]}
			let priv = owner.operands(opPrivate)
			return out when priv.len() < 2

			let size = int(priv[0])
			let offset = int(priv[1])
			fail "cff: the private dict runs past the end of the data" when offset < 0 || offset + size > data.len()
			out.priv = data[offset:offset + size]
			let dict = try parseDict(data[offset:offset + size], regions)
			out.vsindex = int(dict.number(opVsIndex))
			out.subrs = try readIndex(data, offset + int(dict.number(opSubrs)), cff2) when dict.has(opSubrs)
			return out
		}

		internal def readEncoding(at int) !none {
			let glyphs = charStrings.count()
			encoding.len(256)
			encoding[:] = 0

			if at == 0 {
				// The standard encoding: code -> SID -> glyph through the charset.
				let bySID = sidToGlyph()
				for let code = 0; code < 256; code++ {
					let sid = standardSID(code)
					continue when sid == 0
					let g = bySID.get(sid)
					encoding[code] = g unless g is none
				}
				return none
			}
			// The expert encoding is not modelled; such fonts map no codes.
			return none when at == 1

			let format = try readUint(data, at, 1)
			let p = at + 1
			if (format & 0x7F) == 0 {
				let count = try readUint(data, p, 1)
				for let g = 1; g <= count && g < glyphs; g++ {
					encoding[try readUint(data, p + g, 1)] = g
				}
				p += 1 + count
			} else if (format & 0x7F) == 1 {
				let ranges = try readUint(data, p, 1)
				let g = 1
				for let r = 0; r < ranges; r++ {
					let first = try readUint(data, p + 1 + r * 2, 1)
					let left = try readUint(data, p + 2 + r * 2, 1)
					for let k = 0; k <= left && g < glyphs; k++ {
						encoding[(first + k) & 0xFF] = g
						g++
					}
				}
				p += 1 + ranges * 2
			} else {
				fail "cff: unknown encoding format {format & 0x7F}"
			}

			if (format & 0x80) != 0 {
				// Supplements: extra codes for glyphs already named by SID.
				let bySID = sidToGlyph()
				let count = try readUint(data, p, 1)
				for let s = 0; s < count; s++ {
					let code = try readUint(data, p + 1 + s * 3, 1)
					let g = bySID.get(try readUint(data, p + 2 + s * 3, 2))
					encoding[code] = g unless g is none
				}
			}
		}

		internal def sidToGlyph() map<int, int> {
			let out = new map<int, int>()
			for let g = charset.len() - 1; g >= 0; g-- {
				out.set(charset[g], g)
			}
			return out
		}

		// Whether this is a CFF2 table.
		def isCFF2() bool {
			return cff2
		}

		// A glyph's charstring. Fails when the glyph is out of range.
		def charString(glyph int) !byte[] {
			return try charStrings.item(glyph)
		}

		// How many global subroutines the font has.
		def globalSubrCount() int {
			return globalSubrs.count()
		}

		// A global subroutine's charstring. Fails when `i` is out of range.
		def globalSubr(i int) !byte[] {
			return try globalSubrs.item(i)
		}

		// The Font DICT a glyph uses.
		def fontDictOf(glyph int) int {
			return glyph < fdSelect.len() ?? (fdSelect[glyph], 0)
		}

		// How many Font DICTs the font has.
		def fontDictCount() int {
			return fontDicts.len()
		}

		// How many local subroutines a Font DICT's Private DICT has.
		def localSubrCount(fd int) int {
			return fd < fontDicts.len() ?? (fontDicts[fd].subrs.count(), 0)
		}

		// A local subroutine of a Font DICT. Fails when either index is out of range.
		def localSubr(fd int, i int) !byte[] {
			fail "cff: font dict {fd} is out of range" when fd >= fontDicts.len()
			return try fontDicts[fd].subrs.item(i)
		}

		// The raw Private DICT of a Font DICT.
		def privateDict(fd int) byte[] {
			return fd < fontDicts.len() ?? (fontDicts[fd].priv, byte[])
		}

		// The region count of each CFF2 variation data entry, indexed by vsindex.
		def regionCounts() int[] {
			return regions
		}

		// Where the CFF2 variation store starts in `bytes()`, 0 when the font
		// has none.
		def variationStoreOffset() int {
			return vstoreAt
		}

		// The table bytes the program was parsed from.
		def bytes() byte[] {
			return data
		}

		// The vsindex a Font DICT's Private DICT selects.
		def vsIndex(fd int) int {
			return fd < fontDicts.len() ?? (fontDicts[fd].vsindex, 0)
		}

		// The glyph a Standard Encoding code names (seac accents), or -1.
		def standardGlyph(code int) int {
			return -1 when cid || code < 0 || code > 255
			let g = sidToGlyph().get(standardSID(code))
			return g is none ?? (-1, g)
		}

		// How many glyphs the font program holds.
		def glyphCount() int {
			return charStrings.count()
		}

		// Whether this is a CID-keyed font, whose glyphs are named by CID
		// through several Font DICTs rather than by glyph name.
		def isCID() bool {
			return cid
		}

		// The glyph a character code selects through the font's built-in
		// encoding, or, in a CID-keyed font, the glyph a CID names. None when the
		// code is unmapped, and always for CFF2, which has neither.
		def glyph(code int) ?fonts.GlyphID {
			if cid {
				for let g = 0; g < charset.len(); g++ {
					return fonts.GlyphID(g) when charset[g] == code
				}
				return none
			}
			return none when code < 0 || code >= encoding.len()
			let g = encoding[code]
			return none when g == 0
			return fonts.GlyphID(g)
		}

		// The glyph's outline, as cubic segments in font units, at the instance
		// of a CFF2 font that `coords` (normalized F2Dot14, one per axis) name.
		// Fails when the glyph id is out of range or its charstring is malformed.
		def outline(glyph fonts.GlyphID, coords int[] = int[]) !fonts.Outline {
			let segs = try draw(int(glyph), true, blendScalars(coords))
			return new fonts.Outline(segs)
		}

		// The region scalars of each vsindex at `coords`; empty at the default
		// instance, where `blend` keeps the default values.
		def blendScalars(coords int[]) float32[][] {
			let out float32[][]
			let varied = false
			for let (_, c) in coords {
				varied = true when c != 0
			}
			return out unless cff2 && varied && vstore.present()
			for let i = 0; i < regions.len(); i++ {
				out.push(vstore.regionScalars(i, coords))
			}
			return out
		}

		internal def draw(glyph int, allowAccent bool, scalars float32[][] = float32[][]) !fonts.Segment[] {
			expects {
				assert glyph >= 0 && glyph < charStrings.count() onerror fail "glyph {glyph} is out of range"
			}

			let fd = 0
			fd = fdSelect[glyph] when fdSelect.len() > glyph
			fail "cff: glyph {glyph} names a missing font dict" when fd >= fontDicts.len()

			let run = new Interpreter(globalSubrs, fontDicts[fd].subrs, cff2, regions, fontDicts[fd].vsindex, scalars)
			try run.run(try charStrings.item(glyph), 0)
			return run.segments unless run.seac

			// An accented character built from two standard-encoded glyphs: the
			// base as is, the accent moved by (dx, dy).
			fail "cff: accent composition nests" unless allowAccent
			let bySID = sidToGlyph()
			let base = bySID.get(standardSID(run.seacBase))
			let accent = bySID.get(standardSID(run.seacAccent))
			fail "cff: accented glyph {glyph} names a missing component" when base is none || accent is none

			let segs = try draw(base, false)
			for let (_, s) in try draw(accent, false) {
				segs.push(fonts.Segment{
					kind:     s.kind,
					to:       geom.Point{x: s.to.x + run.seacDx, y: s.to.y + run.seacDy},
					control1: geom.Point{x: s.control1.x + run.seacDx, y: s.control1.y + run.seacDy},
					control2: geom.Point{x: s.control2.x + run.seacDx, y: s.control2.y + run.seacDy}
				})
			}
			return segs
		}
	}
}
