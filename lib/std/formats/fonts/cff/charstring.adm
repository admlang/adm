// The Type 2 charstring interpreter: turns a glyph program into cubic
// outline segments.

internal partial module std.formats.fonts.cff.charstring {
	use (
		std.math
		std.math.geom
		std.formats.fonts
		std.formats.fonts.cff.table::*
	)

	// Limits from the Type 2 and CFF2 charstring specifications.
	const (
		maxStack      = 513
		maxSubrDepth  = 10
		transientSize = 32
	)

	// The subroutine number bias, which lets the common case use short operands.
	def subrBias(count int) int {
		return 107 when count < 1240
		return 1131 when count < 33900
		return 32768
	}

	// One glyph program run: the operand stack, the pen, and the segments
	// drawn so far.
	type Interpreter {
		gsubrs  Index
		lsubrs  Index
		gbias   int
		lbias   int
		cff2    bool
		// Variation regions per vsindex, for CFF2 `blend`.
		regions int[]
		vsindex int
		// Region scalars per vsindex at the instance being drawn; empty at the
		// default instance.
		scalars float32[][]

		stack     float[]
		sp        int
		transient float[]
		x         float
		y         float
		// Where the open contour started.
		startX    float
		startY    float
		open      bool
		stems     int
		// Whether the optional leading advance width has been dealt with.
		widthDone bool
		ended     bool
		random    int

		segments fonts.Segment[]

		// Set by an `endchar` carrying the four accent-composition operands.
		seac       bool
		seacDx     float
		seacDy     float
		seacBase   int
		seacAccent int

		def new(gsubrs Index, lsubrs Index, cff2 bool, regions int[], vsindex int, scalars float32[][] = float32[][]) {
			self.scalars = scalars
			self.gsubrs = gsubrs
			self.lsubrs = lsubrs
			self.cff2 = cff2
			self.regions = regions
			self.vsindex = vsindex
			gbias = subrBias(gsubrs.count())
			lbias = subrBias(lsubrs.count())
			stack.len(maxStack)
			transient.len(transientSize)
			transient[:] = 0.0
			widthDone = cff2
			random = 1
		}

		def push(v float) !none {
			fail "cff: charstring operand stack overflow" when sp >= maxStack
			stack[sp] = v
			sp++
		}

		def pop() !float {
			fail "cff: charstring operand stack underflow" when sp == 0
			sp--
			return stack[sp]
		}

		// Skips the advance width a CFF1 charstring may put below the first
		// stack-clearing operator's operands; `hasExtra` is whether the stack
		// holds one operand more than the operator takes. Returns the index of
		// the first real operand.
		def takeWidth(hasExtra bool) int {
			return 0 when widthDone
			widthDone = true
			return hasExtra ?? (1, 0)
		}

		// Ends the current contour with a line back to its start when it
		// stopped elsewhere, the way HarfBuzz closes a path.
		def closeContour() {
			if open {
				if x != startX || y != startY {
					segments.push(fonts.Segment{kind: fonts.SegmentKind.Line, to: geom.Point{x: startX, y: startY}})
				}
				segments.push(fonts.Segment{kind: fonts.SegmentKind.Close})
				open = false
			}
		}

		// A move only sets the current point; the contour opens with its
		// first drawing operator, so a move with nothing drawn leaves no trace.
		def moveTo(dx float, dy float) {
			closeContour()
			x += dx
			y += dy
		}

		def ensureOpen() {
			if !open {
				segments.push(fonts.Segment{kind: fonts.SegmentKind.Move, to: geom.Point{x: x, y: y}})
				open = true
				startX = x
				startY = y
			}
		}

		def lineTo(dx float, dy float) {
			ensureOpen()
			x += dx
			y += dy
			segments.push(fonts.Segment{kind: fonts.SegmentKind.Line, to: geom.Point{x: x, y: y}})
		}

		def curveTo(dx1 float, dy1 float, dx2 float, dy2 float, dx3 float, dy3 float) {
			ensureOpen()
			let x1 = x + dx1
			let y1 = y + dy1
			let x2 = x1 + dx2
			let y2 = y1 + dy2
			x = x2 + dx3
			y = y2 + dy3
			segments.push(fonts.Segment{
				kind:     fonts.SegmentKind.Cubic,
				control1: geom.Point{x: x1, y: y1},
				control2: geom.Point{x: x2, y: y2},
				to:       geom.Point{x: x, y: y}
			})
		}

		// Runs a charstring to its end, or to `endchar`.
		// Fails when the program is malformed.
		def run(code byte[], depth int) !none {
			expects {
				assert depth <= maxSubrDepth onerror fail "cff: subroutines nest too deeply"
			}

			let i = 0
			let n = code.len()
			for i < n && !ended {
				let b0 = int(code[i])
				i++

				// Operands.
				if b0 >= 32 {
					if b0 <= 246 {
						try push(float(b0 - 139))
					} else if b0 <= 250 {
						fail "cff: truncated charstring" when i >= n
						try push(float((b0 - 247) * 256 + int(code[i]) + 108))
						i++
					} else if b0 <= 254 {
						fail "cff: truncated charstring" when i >= n
						try push(float(-(b0 - 251) * 256 - int(code[i]) - 108))
						i++
					} else {
						fail "cff: truncated charstring" when i + 4 > n
						let v = (int(code[i]) << 24) | (int(code[i + 1]) << 16) | (int(code[i + 2]) << 8) | int(code[i + 3])
						v = v - 0x100000000 when v >= 0x80000000
						try push(float(v) / 65536.0)
						i += 4
					}
					continue
				}
				if b0 == 28 {
					fail "cff: truncated charstring" when i + 2 > n
					let v = (int(code[i]) << 8) | int(code[i + 1])
					try push(float(v >= 0x8000 ?? (v - 0x10000, v)))
					i += 2
					continue
				}

				switch b0 {
					case 1, 3, 18, 23:
						// hstem, vstem, hstemhm, vstemhm
						let first = takeWidth(sp % 2 == 1)
						stems += (sp - first) / 2
						sp = 0
					case 19, 20:
						// hintmask, cntrmask: operands left on the stack are
						// implicit vstems.
						let first = takeWidth(sp % 2 == 1)
						stems += (sp - first) / 2
						sp = 0
						i += (stems + 7) / 8
					case 21:
						// rmoveto
						let first = takeWidth(sp > 2)
						fail "cff: rmoveto needs two operands" when sp - first < 2
						moveTo(stack[first], stack[first + 1])
						sp = 0
					case 22:
						// hmoveto
						let first = takeWidth(sp > 1)
						fail "cff: hmoveto needs an operand" when sp - first < 1
						moveTo(stack[first], 0.0)
						sp = 0
					case 4:
						// vmoveto
						let first = takeWidth(sp > 1)
						fail "cff: vmoveto needs an operand" when sp - first < 1
						moveTo(0.0, stack[first])
						sp = 0
					case 5:
						// rlineto
						for let k = 0; k + 1 < sp; k += 2 {
							lineTo(stack[k], stack[k + 1])
						}
						sp = 0
					case 6, 7:
						// hlineto, vlineto: alternating axes.
						let horizontal = b0 == 6
						for let k = 0; k < sp; k++ {
							if horizontal {
								lineTo(stack[k], 0.0)
							} else {
								lineTo(0.0, stack[k])
							}
							horizontal = !horizontal
						}
						sp = 0
					case 8:
						// rrcurveto
						for let k = 0; k + 5 < sp; k += 6 {
							curveTo(stack[k], stack[k + 1], stack[k + 2], stack[k + 3], stack[k + 4], stack[k + 5])
						}
						sp = 0
					case 24:
						// rcurveline
						let k = 0
						for k + 7 < sp {
							curveTo(stack[k], stack[k + 1], stack[k + 2], stack[k + 3], stack[k + 4], stack[k + 5])
							k += 6
						}
						lineTo(stack[k], stack[k + 1]) when k + 1 < sp
						sp = 0
					case 25:
						// rlinecurve
						let k = 0
						for k + 7 < sp {
							lineTo(stack[k], stack[k + 1])
							k += 2
						}
						curveTo(stack[k], stack[k + 1], stack[k + 2], stack[k + 3], stack[k + 4], stack[k + 5]) when k + 5 < sp
						sp = 0
					case 26:
						// vvcurveto
						let k = 0
						let dx1 = 0.0
						if sp % 2 == 1 {
							dx1 = stack[0]
							k = 1
						}
						for k + 3 < sp {
							curveTo(dx1, stack[k], stack[k + 1], stack[k + 2], 0.0, stack[k + 3])
							dx1 = 0.0
							k += 4
						}
						sp = 0
					case 27:
						// hhcurveto
						let k = 0
						let dy1 = 0.0
						if sp % 2 == 1 {
							dy1 = stack[0]
							k = 1
						}
						for k + 3 < sp {
							curveTo(stack[k], dy1, stack[k + 1], stack[k + 2], stack[k + 3], 0.0)
							dy1 = 0.0
							k += 4
						}
						sp = 0
					case 30, 31:
						// vhcurveto, hvcurveto: curves alternate between
						// starting vertical and horizontal; an odd operand at
						// the end bends the last curve's final tangent.
						let horizontal = b0 == 31
						let k = 0
						for k + 3 < sp {
							let last = k + 5 == sp
							let tail = last ?? (stack[k + 4], 0.0)
							if horizontal {
								curveTo(stack[k], 0.0, stack[k + 1], stack[k + 2], tail, stack[k + 3])
							} else {
								curveTo(0.0, stack[k], stack[k + 1], stack[k + 2], stack[k + 3], tail)
							}
							horizontal = !horizontal
							k += 4
						}
						sp = 0
					case 10:
						// callsubr
						let index = int(try pop()) + lbias
						let subr = try lsubrs.item(index)
						try run(subr, depth + 1)
					case 29:
						// callgsubr
						let index = int(try pop()) + gbias
						let subr = try gsubrs.item(index)
						try run(subr, depth + 1)
					case 11:
						// return
						return none
					case 14:
						// endchar
						fail "cff: endchar is not allowed in CFF2" when cff2
						let first = takeWidth(sp == 1 || sp == 5)
						if sp - first == 4 {
							seac = true
							seacDx = stack[first]
							seacDy = stack[first + 1]
							seacBase = int(stack[first + 2])
							seacAccent = int(stack[first + 3])
						}
						closeContour()
						ended = true
						sp = 0
					case 15:
						// vsindex (CFF2)
						vsindex = int(try pop())
						sp = 0
					case 16:
						// blend (CFF2): each default value plus its deltas weighed
						// by the region scalars.
						let count = int(try pop())
						let k = vsindex < regions.len() ?? (regions[vsindex], 0)
						let total = count * (k + 1)
						fail "cff: blend underflows the operand stack" when count < 0 || total > sp
						let start = sp - total
						if vsindex < scalars.len() && scalars[vsindex].len() == k {
							let weights = scalars[vsindex]
							for let v = 0; v < count; v++ {
								let sum = 0.0
								for let j = 0; j < k; j++ {
									sum += float(weights[j]) * stack[start + count + v * k + j]
								}
								stack[start + v] = stack[start + v] + sum
							}
						}
						sp = sp - total + count
					case 12:
						fail "cff: truncated charstring" when i >= n
						let b1 = int(code[i])
						i++
						try escaped(b1)
					default:
						fail "cff: unknown charstring operator {b0}"
				}
			}

			closeContour() when depth == 0
		}

		// Two-byte operators: flex and the arithmetic set.
		def escaped(op int) !none {
			switch op {
				case 35:
					// flex
					fail "cff: flex needs 13 operands" when sp < 13
					curveTo(stack[0], stack[1], stack[2], stack[3], stack[4], stack[5])
					curveTo(stack[6], stack[7], stack[8], stack[9], stack[10], stack[11])
					sp = 0
				case 34:
					// hflex
					fail "cff: hflex needs 7 operands" when sp < 7
					curveTo(stack[0], 0.0, stack[1], stack[2], stack[3], 0.0)
					curveTo(stack[4], 0.0, stack[5], -stack[2], stack[6], 0.0)
					sp = 0
				case 36:
					// hflex1
					fail "cff: hflex1 needs 9 operands" when sp < 9
					curveTo(stack[0], stack[1], stack[2], stack[3], stack[4], 0.0)
					curveTo(stack[5], 0.0, stack[6], stack[7], stack[8], -(stack[1] + stack[3] + stack[7]))
					sp = 0
				case 37:
					// flex1: the last point returns to the starting line of
					// whichever axis moved least.
					fail "cff: flex1 needs 11 operands" when sp < 11
					let dx = stack[0] + stack[2] + stack[4] + stack[6] + stack[8]
					let dy = stack[1] + stack[3] + stack[5] + stack[7] + stack[9]
					curveTo(stack[0], stack[1], stack[2], stack[3], stack[4], stack[5])
					if dx.abs() > dy.abs() {
						curveTo(stack[6], stack[7], stack[8], stack[9], stack[10], -dy)
					} else {
						curveTo(stack[6], stack[7], stack[8], stack[9], -dx, stack[10])
					}
					sp = 0
				case 0:
					// dotsection: a Type 1 hint, ignored.
					sp = 0
				case 3:
					let b = try pop()
					let a = try pop()
					try push(a != 0.0 && b != 0.0 ?? (1.0, 0.0))
				case 4:
					let b = try pop()
					let a = try pop()
					try push(a != 0.0 || b != 0.0 ?? (1.0, 0.0))
				case 5:
					let a = try pop()
					try push(a == 0.0 ?? (1.0, 0.0))
				case 9:
					try push((try pop()).abs())
				case 10:
					let b = try pop()
					let a = try pop()
					try push(a + b)
				case 11:
					let b = try pop()
					let a = try pop()
					try push(a - b)
				case 12:
					let b = try pop()
					let a = try pop()
					fail "cff: division by zero in a charstring" when b == 0.0
					try push(a / b)
				case 14:
					try push(-(try pop()))
				case 15:
					let b = try pop()
					let a = try pop()
					try push(a == b ?? (1.0, 0.0))
				case 18:
					try pop()
				case 20:
					let index = int(try pop())
					let value = try pop()
					fail "cff: transient index out of range" when index < 0 || index >= transientSize
					transient[index] = value
				case 21:
					let index = int(try pop())
					fail "cff: transient index out of range" when index < 0 || index >= transientSize
					try push(transient[index])
				case 22:
					let v2 = try pop()
					let v1 = try pop()
					let s2 = try pop()
					let s1 = try pop()
					try push(v1 <= v2 ?? (s1, s2))
				case 23:
					// A deterministic sequence in (0, 1]: outlines must not
					// change between runs.
					random = (random * 1103515245 + 12345) & 0x7FFFFFFF
					try push(float((random >> 8) + 1) / 8388608.0)
				case 24:
					let b = try pop()
					let a = try pop()
					try push(a * b)
				case 26:
					let a = try pop()
					fail "cff: square root of a negative number" when a < 0.0
					try push(math.sqrt(a))
				case 27:
					let a = try pop()
					try push(a)
					try push(a)
				case 28:
					let b = try pop()
					let a = try pop()
					try push(b)
					try push(a)
				case 29:
					let index = int(try pop())
					fail "cff: index on an empty stack" when sp == 0
					let at = index < 0 ?? (sp - 1, sp - 1 - index)
					fail "cff: index out of range" when at < 0
					try push(stack[at])
				case 30:
					let shift = int(try pop())
					let count = int(try pop())
					fail "cff: roll out of range" when count <= 0 || count > sp
					let base = sp - count
					let items float[]
					items.len(count)
					for let k = 0; k < count; k++ {
						let to = ((k + shift) % count + count) % count
						items[to] = stack[base + k]
					}
					for let k = 0; k < count; k++ {
						stack[base + k] = items[k]
					}
				default:
					fail "cff: unknown charstring operator 12 {op}"
			}
		}
	}
}
