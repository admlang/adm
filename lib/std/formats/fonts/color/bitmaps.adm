// Embedded colour bitmaps: the CBDT/CBLC tables (Google's colour emoji) and
// Apple's sbix. After HarfBuzz 14.1's OT/Color/CBDT and OT/Color/sbix,
// with the index formats and image types HarfBuzz leaves out read too.

internal std partial module std.formats.fonts.color {
	use (
		std.math.geom
		std.formats.fonts
		std.formats.fonts.layout
		std.formats.image
	)

	// The strike HarfBuzz picks among `ppems` for `size` pixels per em: the
	// smallest at least that big, else the biggest; size 0 asks for the
	// biggest.
	internal def chooseStrike(ppems int[], size float) int {
		return -1 when ppems.len() == 0
		let want = size <= 0.0 ?? (float(1 << 30), size)
		let best = 0
		let bestPpem = ppems[0]
		for let i = 1; i < ppems.len(); i++ {
			let p = ppems[i]
			if (want <= float(p) && p < bestPpem) || (want > float(bestPpem) && p > bestPpem) {
				best = i
				bestPpem = p
			}
		}
		return best
	}

	// A bitmap's pixel extents (left bearing, top bearing, width, height)
	// in font units, each rounded as HarfBuzz rounds them, as a rectangle
	// with y up.
	internal def bitmapBounds(x int, y int, w int, h int, upem int, ppemX int, ppemY int) geom.Rect {
		let sx = float(upem) / float(ppemX)
		let sy = float(upem) / float(ppemY)
		let left = float(layout.roundHalfUp(float32(float(x) * sx)))
		let top = float(layout.roundHalfUp(float32(float(y) * sy)))
		let width = float(layout.roundHalfUp(float32(float(w) * sx)))
		let height = float(layout.roundHalfUp(float32(float(-h) * sy)))
		return geom.Rect{left: left, top: top + height, right: left + width, bottom: top}
	}

	// The CBDT and CBLC tables, dropped when either does not validate.
	type Cbdt {
		internal data layout.Data
		internal loc  layout.Data
		internal upem int

		def new(cbdt byte[], cblc byte[], upem int) {
			data = new layout.Data(cbdt)
			loc = new layout.Data(cblc)
			self.upem = upem
			if !(validLocations() && data.len() >= 4 && (data.u16(0) := 2 || 3)) {
				data = new layout.Data()
				loc = new layout.Data()
			}
		}

		def present() bool {
			return data.len() > 0
		}

		// Glyph `g`'s bitmap at the strike `size` picks, none when it has
		// none there.
		def glyph(g int, size float) ?BitmapGlyph {
			return none unless present()
			let ppems int[]
			for let i = 0; i < loc.u32(4); i++ {
				let s = 8 + i * 48
				ppems.push(loc.u8(s + 44).max(loc.u8(s + 45)))
			}
			let k = chooseStrike(ppems, size)
			return none when k < 0
			let strike = 8 + k * 48
			let ppemX = loc.u8(strike + 44)
			let ppemY = loc.u8(strike + 45)
			return none when ppemX == 0 || ppemY == 0
			let array = loc.u32(strike)
			for let i = 0; i < loc.u32(strike + 8); i++ {
				let rec = array + i * 8
				let first = loc.u16(rec)
				continue unless first <= g && g <= loc.u16(rec + 2)
				let sub = array + loc.u32(rec + 4)
				return self.bitmapAt(sub, g - first, g, ppemX, ppemY)
			}
			return none
		}

		// The image of glyph `g`, index `idx` of the index subtable at `sub`.
		internal def bitmapAt(sub int, idx int, g int, ppemX int, ppemY int) ?BitmapGlyph {
			let indexFormat = loc.u16(sub)
			let imageFormat = loc.u16(sub + 2)
			let base = loc.u32(sub + 4)
			let at = -1
			let length = 0
			// Metrics an index subtable holds for every glyph (formats 2, 5).
			let shared = -1
			match indexFormat {
				case 1, 3:
					let wide = indexFormat == 1
					let o0 = wide ?? (loc.u32(sub + 8 + idx * 4), loc.u16(sub + 8 + idx * 2))
					let o1 = wide ?? (loc.u32(sub + 8 + (idx + 1) * 4), loc.u16(sub + 8 + (idx + 1) * 2))
					return none when o1 <= o0
					at = base + o0
					length = o1 - o0
				case 2:
					length = loc.u32(sub + 8)
					shared = sub + 12
					at = base + idx * length
				case 4:
					let count = loc.u32(sub + 8)
					for let i = 0; i < count; i++ {
						let p = sub + 12 + i * 4
						if loc.u16(p) == g {
							let o0 = loc.u16(p + 2)
							let o1 = loc.u16(p + 6)
							return none when o1 <= o0
							at = base + o0
							length = o1 - o0
							break
						}
					}
				case 5:
					length = loc.u32(sub + 8)
					shared = sub + 12
					let count = loc.u32(sub + 20)
					for let i = 0; i < count; i++ {
						if loc.u16(sub + 24 + i * 2) == g {
							at = base + i * length
							break
						}
					}
				default:
					return none
			}
			return none when at < 0 || !data.has(at, length)
			let (h, w, x, y, png) = (0, 0, 0, 0, -1)
			match imageFormat {
				case 17:
					return none when length < 9
					(h, w, x, y) = (data.u8(at), data.u8(at + 1), sbyte(data.u8(at + 2)), sbyte(data.u8(at + 3)))
					png = at + 5
				case 18:
					return none when length < 12
					(h, w, x, y) = (data.u8(at), data.u8(at + 1), sbyte(data.u8(at + 2)), sbyte(data.u8(at + 3)))
					png = at + 8
				case 19:
					return none when length < 4 || shared < 0
					(h, w, x, y) = (loc.u8(shared), loc.u8(shared + 1), sbyte(loc.u8(shared + 2)), sbyte(loc.u8(shared + 3)))
					png = at
				default:
					return none
			}
			let n = data.u32(png)
			return none unless data.has(png + 4, n)
			let picture = image.load(data.slice(png + 4, n))
			return none when picture is error
			return BitmapGlyph{image: picture, bounds: bitmapBounds(x, y, w, h, upem, ppemX, ppemY), ppem: ppemX.max(ppemY)}
		}

		// HarfBuzz's CBLC sanitize, with the index formats it skips checked
		// too.
		internal def validLocations() bool {
			let s = new layout.Sanitizer(loc)
			return false unless s.fits(0, 8) && (loc.u16(0) := 2 || 3)
			let sizes = loc.u32(4)
			return false unless s.array(8, sizes, 48)
			for let i = 0; i < sizes; i++ {
				let strike = 8 + i * 48
				let array = loc.u32(strike)
				let count = loc.u32(strike + 8)
				return false unless s.array(array, count, 8)
				for let k = 0; k < count; k++ {
					let rec = array + k * 8
					let first = loc.u16(rec)
					let last = loc.u16(rec + 2)
					return false when first > last
					let sub = array + loc.u32(rec + 4)
					return false unless s.fits(sub, 8)
					let glyphs = last - first + 1
					match loc.u16(sub) {
						case 1:
							return false unless s.array(sub + 8, glyphs + 1, 4)
						case 3:
							return false unless s.array(sub + 8, glyphs + 1, 2)
						case 2:
							return false unless s.fits(sub, 20)
						case 4:
							return false unless s.fits(sub, 12) && s.array(sub + 12, loc.u32(sub + 8) + 1, 4)
						case 5:
							return false unless s.fits(sub, 24) && s.array(sub + 24, loc.u32(sub + 20), 2)
					}
				}
			}
			return true
		}
	}

	// The sbix table: per strike, an image for each glyph.
	type Sbix {
		internal d         layout.Data
		internal upem      int
		internal numGlyphs int

		def new(table byte[], upem int, numGlyphs int) {
			d = new layout.Data(table)
			self.upem = upem
			self.numGlyphs = numGlyphs
			d = new layout.Data() unless valid()
		}

		def present() bool {
			return d.len() > 0
		}

		// Glyph `g`'s image at the strike `size` picks, following `dupe`
		// entries; none when the strike has no image for it.
		def glyph(g int, size float) ?BitmapGlyph {
			return none unless present()
			let ppems int[]
			for let i = 0; i < d.u32(4); i++ {
				ppems.push(d.u16(d.u32(8 + i * 4)))
			}
			let k = chooseStrike(ppems, size)
			return none when k < 0
			let strike = d.u32(8 + k * 4)
			let ppem = d.u16(strike)
			return none when ppem == 0
			let id = g
			for let retry = 0; retry <= 8; retry++ {
				return none when id >= numGlyphs
				let o0 = d.u32(strike + 4 + id * 4)
				let o1 = d.u32(strike + 4 + (id + 1) * 4)
				return none when o1 <= o0 || o1 - o0 <= 8 || o1 > d.len() - strike
				let at = strike + o0
				let kind = d.tag(at + 4)
				let length = o1 - o0 - 8
				if kind == "dupe" {
					return none when length < 2
					id = d.u16(at + 8)
					continue
				}
				return none unless kind := "png " || "jpg " || "tiff"
				let picture = image.load(d.slice(at + 8, length))
				return none when picture is error
				let dims = picture.size()
				let w = int(dims.width)
				let h = int(dims.height)
				return none when w >= 65536 || h >= 65536
				let x = d.i16(at)
				let y = d.i16(at + 2)
				return BitmapGlyph{image: picture, bounds: bitmapBounds(x, h + y, w, h, upem, ppem, ppem), ppem: ppem}
			}
			return none
		}

		internal def valid() bool {
			let s = new layout.Sanitizer(d)
			return false unless s.fits(0, 8) && d.u16(0) >= 1
			let count = d.u32(4)
			return false unless s.array(8, count, 4)
			for let i = 0; i < count; i++ {
				let off = d.u32(8 + i * 4)
				continue when off == 0
				return false unless s.fits(off, 4) && s.fits(off + 4, (numGlyphs + 1) * 4)
			}
			return true
		}
	}

	// A signed byte.
	internal def sbyte(v int) int {
		return v >= 128 ?? (v - 256, v)
	}
}
