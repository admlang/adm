partial module std.formats.fonts.color {
	use (
		std.testing
		std.formats.fonts
		std.gfx.color::(Color)
	)

	// Expected values are HarfBuzz 14.5's (hb_font_paint_glyph and the
	// hb_ot_color calls, through uharfbuzz) for the fixtures in
	// samples/fonts/ttf/color, written the way its paint callbacks are
	// called: CR/CG clip to a rectangle or glyph, S a solid colour, L/R/W
	// gradients, T a transform, G a group closed by its composite mode.
	check "Colour glyphs" {
		def colorFace(name string, coords map<string, float> = map<string, float>{}) !ColorSource {
			let face = try (try fonts.load("samples/fonts/ttf/color/" + name)).face(0)
			let at = face
			at = try face.instance(coords) when coords.len() > 0 && face is fonts.VariableFace
			fail "{name} is not a colour face" unless at is ColorSource
			return at
		}

		def glyphOf(face ColorSource, glyph int, size float = 0.0, palette int = 0) ?ColorGlyph {
			return face.colorGlyphOf(glyph, size, palette, new Color("#000"))
		}

		def f(v float) string {
			let s = "%.3f".format(v)
			return s == "-0.000" ?? ("0.000", s)
		}

		def col(c Color) string {
			let x = c.rgba
			return "#" + int(x.r).hex(2) + int(x.g).hex(2) + int(x.b).hex(2) + int(x.a).hex(2)
		}

		def stops(s ColrStop[], e int) string {
			let out = e == 1 ?? ("repeat", e == 2 ?? ("reflect", "pad"))
			out += " ["
			for let (i, st) in s {
				out += " " when i > 0
				out += f(st.offset) + ":" + col(st.color)
			}
			return out + "]"
		}

		def emit(p ColrPaint, out string[]) {
			if p is ColrSolid {
				out.push("S " + col(p.color))
			} else if p is ColrLinear {
				out.push("L {f(p.p0.x)} {f(p.p0.y)} {f(p.p1.x)} {f(p.p1.y)} {f(p.p2.x)} {f(p.p2.y)} " + stops(p.stops, p.extend))
			} else if p is ColrRadial {
				out.push("R {f(p.c0.x)} {f(p.c0.y)} {f(p.r0)} {f(p.c1.x)} {f(p.c1.y)} {f(p.r1)} " + stops(p.stops, p.extend))
			} else if p is ColrSweep {
				out.push("W {f(p.center.x)} {f(p.center.y)} {f(p.startAngle)} {f(p.endAngle)} " + stops(p.stops, p.extend))
			} else if p is ColrGlyph {
				out.push("CG {int(p.glyph)}")
				emit(p.paint, out)
				out.push("/C")
			} else if p is ColrLayers {
				for let (_, l) in p.layers {
					emit(l, out)
				}
			} else if p is ColrTransform {
				let t = p.transform
				out.push("T {f(t.a)} {f(t.b)} {f(t.c)} {f(t.d)} {f(t.tx)} {f(t.ty)}")
				emit(p.paint, out)
				out.push("/T")
			} else if p is ColrComposite {
				out.push("G")
				emit(p.backdrop, out)
				out.push("G")
				emit(p.source, out)
				out.push("/G {p.mode}")
				out.push("/G 3")
			} else if p is ColrClip {
				out.push("CR {f(p.clip.left)} {f(p.clip.top)} {f(p.clip.right)} {f(p.clip.bottom)}")
				emit(p.paint, out)
				out.push("/C")
			}
		}

		def trace(face ColorSource, glyph int, palette int = 0) string {
			let c = glyphOf(face, glyph, palette = palette)
			return "none" when c is none
			return "not painted" unless c is PaintedGlyph
			let parts string[]
			emit(c.paint, parts)
			return parts.join(" | ").upper()
		}

		@test()
		def paintsColrVersion1() !none {
			let face = try colorFace("test_glyphs-glyf_colr_1.ttf")
			assert trace(face, 10) == "CR 100.000 250.000 900.000 950.000 | CG 10 | L 100.000 250.000 900.000 250.000 100.000 300.000 REPEAT [0.000:#FF0000FF 1.500:#0000FFFF] | /C | /C" // linear gradient
			assert trace(face, 12) == "CR 0.000 0.000 1000.000 1000.000 | CG 176 | W 500.000 600.000 0.000 6.283 PAD [0.250:#FAF0E6FF 0.417:#0000FFFF 0.583:#FF0000FF 0.750:#2F4F4FFF] | /C | /C" // sweep gradient
			assert trace(face, 84) == "G | CG 3 | S #0000FF80 | /C | G | T 0.500 0.000 0.000 1.500 250.000 -250.000 | CG 3 | S #FFA500B3 | /C | /T | /G 4 | /G 3" // scale around a centre, composited
			assert trace(face, 100) == "G | CG 3 | S #0000FF80 | /C | G | T 0.985 -0.174 0.174 0.985 -158.421 188.791 | CG 3 | S #FFA500B3 | /C | /T | /G 4 | /G 3" // rotation around a centre
			assert trace(face, 156) == "CR 0.000 500.000 500.000 1000.000 | G | CR 100.000 100.000 900.000 900.000 | CR 0.000 0.000 1000.000 1000.000 | CG 2 | R 166.000 768.000 0.000 166.000 768.000 256.000 REFLECT [0.000:#008000FF 0.500:#FFFFFFFF 1.000:#FF0000FF] | /C | /C | /C | G | CG 161 | S #80808066 | /C | /G 3 | /G 3 | /C" // another colour glyph reused, with its clip box
			assert glyphOf(face, 1) is none // an outline-only glyph
		}

		@test()
		def variesWithTheInstance() !none {
			let face = try colorFace("test_glyphs-glyf_colr_1_variable.ttf", map<string, float>{"SWPS": 45.0, "SWPE": -30.0, "SWC1": 1.0, "SWC2": -0.5})
			assert trace(face, 12) == "CR 0.000 0.000 1000.000 1000.000 | CG 176 | W 500.000 600.000 0.785 5.760 PAD [1.250:#FAF0E6FF -0.083:#0000FFFF 0.583:#FF0000FF 0.750:#2F4F4FFF] | /C | /C" // angles and stops moved
		}

		@test()
		def paintsColrVersion0Layers() !none {
			let face = try colorFace("COLRv0.extents.ttf")
			assert trace(face, 13) == "CG 8 | S #00000000 | /C | CG 9 | S #9A7312FF | /C | CG 10 | S #D4AF37FF | /C | CG 11 | S #471C01FF | /C | CG 12 | S #902900E6 | /C" // one colour per layer
		}

		@test()
		def readsPalettes() !none {
			let face = try colorFace("cpal-v1.ttf")
			let palettes = face.colorPalettes()
			assert palettes.len() == 3 // three palettes
			assert palettes[0].name == "Autumn" && palettes[0].darkBackground && !palettes[0].lightBackground // named, for dark backgrounds
			assert palettes[1].name == "" && palettes[1].lightBackground // unnamed, for light ones
			assert col(palettes[2].colors[1]) == "#800000FF" // colours in order
			assert trace(face, 2, 1) == "CG 3 | S #FFCC66FF | /C | CG 4 | S #000000FF | /C" // layers coloured from the chosen palette
		}

		def bitmap(face ColorSource, glyph int, size float = 0.0) string {
			let c = glyphOf(face, glyph, size)
			return "none" when c is none
			return "not a bitmap" unless c is BitmapGlyph
			let dims = c.image.size()
			return "{int(c.bounds.left)} {int(c.bounds.top)} {int(c.bounds.right)} {int(c.bounds.bottom)} {dims.width}x{dims.height} @{c.ppem}"
		}

		@test()
		def drawsEmbeddedBitmaps() !none {
			assert bitmap(try colorFace("chromacheck-cbdt.ttf"), 1) == "0 0 1024 1024 80x80 @80" // CBDT PNG, bounds in font units
			assert bitmap(try colorFace("chromacheck-sbix.ttf"), 1) == "0 0 800 800 300x300 @300" // sbix PNG
			let emoji = try colorFace("NotoColorEmoji.subset.multiple_size_tables.ttf")
			assert bitmap(emoji, 1) == "0 -263 1326 985 136x128 @210" // the biggest strike by default
			assert bitmap(emoji, 1, 20.0) == "0 -507 2555 1898 136x128 @109" // the smallest at least 20 pixels
		}

		@test()
		def findsSvgDocuments() !none {
			let c = glyphOf(try colorFace("chromacheck-svg.ttf"), 1)
			fail "no SVG document" unless c is SvgGlyph
			assert byte[](c.document).len() == 146 && c.id == "glyph1" // the document and the element that draws the glyph
		}
	}
}
