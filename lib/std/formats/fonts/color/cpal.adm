// The CPAL table: the colour palettes COLR glyphs pick their colours from.
// After HarfBuzz 14.1's OT/Color/CPAL/CPAL.hh.

internal std partial module std.formats.fonts.color {
	use (
		std.formats.fonts.layout
		std.gfx.color::(RGBA)
	)

	// A CPAL table, dropped whole when it does not validate.
	type Cpal {
		internal d            layout.Data
		internal colorCount   int
		internal paletteCount int
		internal recordCount  int
		internal records      int
		internal flags        int
		internal labels       int

		def new(table byte[]) {
			d = new layout.Data(table)
			if !valid() {
				d = new layout.Data()
				return
			}
			colorCount = d.u16(2)
			paletteCount = d.u16(4)
			recordCount = d.u16(6)
			records = d.u32(8)
			if d.u16(0) >= 1 {
				let v1 = 12 + paletteCount * 2
				flags = d.u32(v1)
				labels = d.u32(v1 + 4)
			}
		}

		// How many palettes the table holds.
		def count() int {
			return paletteCount
		}

		// The colours of palette `p`; entries past the colour records are
		// transparent black, as HarfBuzz reads them.
		def colors(p int) RGBA[] {
			let out RGBA[]
			return out when p < 0 || p >= paletteCount
			let start = d.u16(12 + p * 2)
			for let i = 0; i < colorCount && start + i < recordCount; i++ {
				let at = records + (start + i) * 4
				out.push(RGBA{r: uint8(d.u8(at + 2)), g: uint8(d.u8(at + 1)), b: uint8(d.u8(at)), a: uint8(d.u8(at + 3))})
			}
			return out
		}

		// Palette `p`'s flags: bit 0 suits a light background, bit 1 a dark
		// one.
		def flagsOf(p int) int {
			return 0 when flags == 0 || p >= paletteCount
			return d.u32(flags + p * 4)
		}

		// The `name` ID of palette `p`'s label, 0xFFFF when it has none.
		def labelOf(p int) int {
			return 0xFFFF when labels == 0 || p >= paletteCount
			return d.u16(labels + p * 2)
		}

		internal def valid() bool {
			let s = new layout.Sanitizer(d)
			return false unless s.fits(0, 12)
			let palettes = d.u16(4)
			return false unless s.array(d.u32(8), d.u16(6), 4)
			return false unless s.array(12, palettes, 2)
			return true when d.u16(0) == 0
			let v1 = 12 + palettes * 2
			return false unless s.fits(v1, 12)
			return false unless d.u32(v1) == 0 || s.array(d.u32(v1), palettes, 4)
			return false unless d.u32(v1 + 4) == 0 || s.array(d.u32(v1 + 4), palettes, 2)
			return d.u32(v1 + 8) == 0 || s.array(d.u32(v1 + 8), d.u16(2), 2)
		}
	}
}
