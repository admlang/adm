// What the colour tables say about a glyph, decoded for `draw`: a COLR
// paint graph, an embedded bitmap or an SVG document. Coordinates are font
// units with y up, as outlines are.

internal std partial module std.formats.fonts.color {
	use (
		std.math.geom
		std.formats.fonts
		std.formats.image
		std.gfx.color::(Color)
	)

	// A face whose colour tables can be read: every sfnt face, variable
	// instances included.
	interface ColorSource {
		// Glyph `glyph` in colour, none when it is drawn only as an outline.
		// `size` (pixels per em) picks the bitmap strike; `palette` indexes
		// the CPAL palettes (past the end is the default); `foreground` is
		// the text colour. Without `svg`, SVG documents are passed over for
		// the bitmap or outline after them.
		def colorGlyphOf(glyph int, size float, palette int, foreground Color, svg bool = true) ?ColorGlyph

		// The CPAL palettes, the default first.
		def colorPalettes() Palette[]
	}

	// A CPAL palette.
	struct Palette {
		colors          Color[]
		// Suits text on a light or a dark background (CPAL 1).
		lightBackground bool
		darkBackground  bool
		// From the `name` table; empty when it has none.
		name            string
	}

	// How a glyph is drawn in colour.
	type ColorGlyph = PaintedGlyph | BitmapGlyph | SvgGlyph

	// A COLR glyph: layers of outlines filled with one colour each (version
	// 0) or a paint graph (version 1).
	struct PaintedGlyph {
		paint ColrPaint
	}

	// An embedded bitmap (CBDT or sbix) drawn into `bounds`; its pixels
	// belong to a strike of `ppem` pixels per em.
	struct BitmapGlyph {
		image  image.Image
		bounds geom.Rect
		ppem   int
	}

	// An SVG document whose element `id` draws the glyph, y down.
	struct SvgGlyph {
		document string
		id       string
	}

	// One node of a COLR paint graph.
	type ColrPaint = ColrSolid | ColrLinear | ColrRadial | ColrSweep | ColrGlyph | ColrLayers | ColrTransform | ColrComposite | ColrClip

	struct ColrSolid {
		color Color
	}

	// A colour line stop; offsets may lie outside 0..1 and out of order.
	struct ColrStop {
		offset float
		color  Color
	}

	// Along p0 to p1, colour lines parallel to p0 to p2.
	struct ColrLinear {
		p0     geom.Point
		p1     geom.Point
		p2     geom.Point
		stops  ColrStop[]
		// What lies past the ends: 0 pad, 1 repeat, 2 reflect.
		extend int
	}

	// From the circle (c0, r0) to the circle (c1, r1).
	struct ColrRadial {
		c0     geom.Point
		r0     float
		c1     geom.Point
		r1     float
		stops  ColrStop[]
		extend int
	}

	// Around `center` from `startAngle` to `endAngle`, radians
	// counter-clockwise from +x.
	struct ColrSweep {
		center     geom.Point
		startAngle float
		endAngle   float
		stops      ColrStop[]
		extend     int
	}

	// `paint` inside the outline of `glyph`.
	struct ColrGlyph {
		glyph fonts.GlyphID
		paint ColrPaint
	}

	struct ColrLayers {
		layers ColrPaint[]
	}

	struct ColrTransform {
		transform geom.Transform2D
		paint     ColrPaint
	}

	// `source` over `backdrop` by COLR composite mode `mode` (0 clear, 1
	// source, 2 destination, 3 source over ... 12 plus, 13..27 the blend
	// modes screen to luminosity).
	struct ColrComposite {
		source   ColrPaint
		backdrop ColrPaint
		mode     int
	}

	struct ColrClip {
		clip  geom.Rect
		paint ColrPaint
	}
}
