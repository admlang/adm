// The OpenType `SVG ` table: SVG documents that draw glyphs. After
// HarfBuzz 14.1's OT/Color/svg/svg.hh; gzip-compressed documents are
// unpacked.

internal std partial module std.formats.fonts.color {
	use (
		std.io
		std.bytes
		std.data.compress.gzip
		std.formats.fonts
		std.formats.fonts.layout
	)

	// The SVG table, dropped when its document index does not validate.
	type Svg {
		internal d    layout.Data
		internal list int

		def new(table byte[]) {
			d = new layout.Data(table)
			let s = new layout.Sanitizer(d)
			list = s.fits(0, 6) ?? (d.u32(2), 0)
			if list == 0 || !(s.fits(list, 2) && s.array(list + 2, d.u16(list), 12)) {
				d = new layout.Data()
				list = 0
			}
		}

		def present() bool {
			return list != 0
		}

		// The document that draws glyph `g`, none when no document does.
		def glyph(g int) ?SvgGlyph {
			return none unless present()
			let lo = 0
			let hi = d.u16(list) - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let at = list + 2 + mid * 12
				if g < d.u16(at) {
					hi = mid - 1
				} else if g > d.u16(at + 2) {
					lo = mid + 1
				} else {
					let start = list + d.u32(at + 4)
					return none when start >= d.len()
					let doc = d.slice(start, d.u32(at + 8).min(d.len() - start))
					return none when doc.len() == 0
					if doc.len() >= 2 && doc[0] == byte(0x1F) && doc[1] == byte(0x8B) {
						let unpacked = io.readAll(new gzip.Reader(new bytes.Reader(doc)))
						return none when unpacked is error
						doc = unpacked
					}
					return SvgGlyph{document: string(doc), id: "glyph{g}"}
				}
			}
			return none
		}
	}
}
