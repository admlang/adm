// A face's colour tables together, read on first use and shared by every
// instance of a variable font.

internal std partial module std.formats.fonts.color {
	use (
		std.formats.fonts
		std.gfx.color::(Color)
	)

	type ColorTables {
		colr Colr
		cpal Cpal
		cbdt Cbdt
		sbix Sbix
		svg  Svg

		// `table` gives a table's bytes, empty when the face lacks it.
		def new(table def (string) byte[], upem int, numGlyphs int) {
			colr = new Colr(table("COLR"))
			cpal = new Cpal(table("CPAL"))
			cbdt = new Cbdt(table("CBDT"), table("CBLC"), upem)
			sbix = new Sbix(table("sbix"), upem, numGlyphs)
			svg = new Svg(table("SVG "))
		}

		// The palettes, each named through `nameOf` (a `name` ID to text).
		def palettes(nameOf def (int) string) Palette[] {
			let out Palette[]
			for let p = 0; p < cpal.count(); p++ {
				let colors Color[]
				for let (_, c) in cpal.colors(p) {
					colors.push(new Color(c))
				}
				let flags = cpal.flagsOf(p)
				let label = cpal.labelOf(p)
				out.push(Palette{
					colors:          colors,
					lightBackground: flags & 1 != 0,
					darkBackground:  flags & 2 != 0,
					name:            label == 0xFFFF ?? ("", nameOf(label))
				})
			}
			return out
		}

		// Glyph `g` in colour: COLR, then SVG, then CBDT, then sbix, as
		// HarfBuzz tries them.
		def glyph(g int, size float, palette int, foreground Color, coords int[], svg bool = true) ?ColorGlyph {
			let p = palette >= 0 && palette < cpal.count() ?? (palette, 0)
			let painted = colr.paint(g, cpal.colors(p), foreground.rgba, coords)
			return PaintedGlyph{paint: painted} unless painted is none
			if svg {
				let document = self.svg.glyph(g)
				return document unless document is none
			}
			let bitmap = cbdt.glyph(g, size)
			return bitmap unless bitmap is none
			let image = sbix.glyph(g, size)
			return image unless image is none
			return none
		}
	}
}
