partial module std.formats.fonts {
	use (
		std.io
		std.bytes
		std.formats.fonts.opentype
	)

	// EOT is the Embedded OpenType codec: a TrueType font behind a header of
	// names and embedding rights, optionally MicroType Express compressed and
	// XOR-obfuscated. Faces report "eot" as their format.
	@codec("EOT")
	type EOT {
		mimeType string[] {
			def get() string[] {
				return string["application/vnd.ms-fontobject"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".eot"]
			}
		}

		// The magic number 0x504C at byte 34, with a known version at byte 8.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(36)

			let n = r.read(b) onerror recover 0
			return false when n != 36
			return false unless b[34] == 0x4C && b[35] == 0x50

			let version = (int(b[11]) << 24) | (int(b[10]) << 16) | (int(b[9]) << 8) | int(b[8])
			return version == eotVersion1 || version == eotVersion21 || version == eotVersion22
		}

		// open reads the TrueType font an EOT file embeds, undoing MicroType Express
		// compression when it is applied. Fails when the data is not EOT, or the
		// compressed data or the font inside is damaged.
		def open(reader io.Reader) !Font {
			return opentype.open(try unwrap(try opentype.readAll(reader)), "eot")
		}

		// info reads the font's description from the reader. Fails like open.
		def info(reader io.Reader) !FontInfo {
			return opentype.info(try unwrap(try opentype.readAll(reader)), "eot")
		}

		// Returns the embedded font data, de-obfuscated.
		internal def unwrap(data byte[]) !byte[] {
			let r = new bytes.Reader(data, bytes.Endian.Little)
			fail "not an EOT font" when data.len() < 82

			let eotSize = int(try r.read<uint32>())
			let fontDataSize = int(try r.read<uint32>())
			let version = int(try r.read<uint32>())
			let flags = int(try r.read<uint32>())
			try r.seek(34)
			fail "not an EOT font" when (try r.read<uint16>()) != eotMagic
			fail "unknown EOT version {version}" unless version == eotVersion1 || version == eotVersion21 || version == eotVersion22
			fail "EOT size field is larger than the file" when eotSize > data.len()

			// Four length-prefixed UTF-16 names, each after two bytes of padding.
			try r.seek(80)
			for let i = 0; i < 4; i++ {
				try r.skip(2)
				try r.skip(int(try r.read<uint16>()))
			}
			if version >= eotVersion21 {
				try r.skip(2)
				// RootString
				try r.skip(int(try r.read<uint16>()))
			}
			if version == eotVersion22 {
				// RootStringCheckSum, EUDCCodePage, padding
				try r.skip(10)
				// Signature
				try r.skip(int(try r.read<uint16>()))
				// EUDCFlags
				try r.skip(4)
				// EUDC font data
				try r.skip(int(try r.read<uint32>()))
			}

			let start = r.size() - r.len()
			fail "EOT font data runs past the end of the file" when start + fontDataSize > data.len()

			let font = data[start:start + fontDataSize]
			if (flags & eotXorEncrypted) != 0 {
				font = font.clone()
				for let i = 0; i < font.len(); i++ {
					font[i] = font[i] ^ 0x50
				}
			}
			font = try opentype.unpackMtx(font) when (flags & eotCompressed) != 0
			return font
		}
	}

	internal const (
		eotMagic        = 0x504C
		eotVersion1     = 0x00010000
		eotVersion21    = 0x00020001
		eotVersion22    = 0x00020002
		eotCompressed   = 0x00000004
		eotXorEncrypted = 0x10000000
	)
}
