partial module std.formats.fonts {
	use (
		std.os
		std.bytes
		std.testing
		std.formats.fonts.opentype
	)

	check "EOT codec" {
		// A name as the EOT header stores it: UTF-16LE after its byte length.
		def writeName(b bytes.Buffer, name string) !none {
			try b.write<uint16>(uint16(0), bytes.Endian.Little)
			try b.write<uint16>(uint16(name.len() * 2), bytes.Endian.Little)
			for let (_, c) in name.bytes() {
				try b.write<uint16>(uint16(c), bytes.Endian.Little)
			}
		}

		// Wraps tinyTrueType in an EOT header of the given version and flags,
		// XOR-obfuscating the font data when the flags ask for it.
		def wrap(version int, flags int) !byte[] {
			let b = new bytes.Buffer()
			let le = bytes.Endian.Little
			// EOTSize, patched below.
			try b.write<uint32>(uint32(0), le)
			try b.write<uint32>(uint32(tinyTrueType.len()), le)
			try b.write<uint32>(uint32(version), le)
			try b.write<uint32>(uint32(flags), le)
			// PANOSE
			for let i = 0; i < 10; i++ {
				try b.write<byte>(byte(0), le)
			}
			// Charset, italic, weight, fsType, magic
			try b.write<byte>(byte(1), le)
			try b.write<byte>(byte(0), le)
			try b.write<uint32>(uint32(400), le)
			try b.write<uint16>(uint16(0), le)
			try b.write<uint16>(uint16(0x504C), le)
			// Unicode and code page ranges, checksum adjustment, reserved
			for let i = 0; i < 11; i++ {
				try b.write<uint32>(uint32(0), le)
			}
			try writeName(b, "Tiny Serif")
			try writeName(b, "Regular")
			try writeName(b, "Version 1.0")
			try writeName(b, "Tiny Serif Regular")
			if version >= 0x00020001 {
				try writeName(b, "")
			}
			if version == 0x00020002 {
				// RootStringCheckSum, EUDCCodePage, padding, signature size
				try b.write<uint32>(uint32(0), le)
				try b.write<uint32>(uint32(0), le)
				try b.write<uint16>(uint16(0), le)
				try b.write<uint16>(uint16(3), le)
				try b.write(byte[1, 2, 3])
				// EUDCFlags, EUDC font size and data
				try b.write<uint32>(uint32(0), le)
				try b.write<uint32>(uint32(2), le)
				try b.write(byte[9, 9])
			}

			let font = tinyTrueType.clone()
			if (flags & 0x10000000) != 0 {
				for let i = 0; i < font.len(); i++ {
					font[i] = font[i] ^ 0x50
				}
			}
			try b.write(font)

			let out = b.bytes()
			let size = out.len()
			out[0] = byte(size & 0xFF)
			out[1] = byte((size >> 8) & 0xFF)
			out[2] = byte((size >> 16) & 0xFF)
			out[3] = byte((size >> 24) & 0xFF)
			return out
		}

		@test()
		def signature() !none {
			let eot = new EOT()
			assert eot.matchSignature(new bytes.Reader(try wrap(0x00020001, 0))) // magic and version
			assert !(eot.matchSignature(new bytes.Reader(tinyTrueType))) // bare sfnt is not EOT
		}

		@test()
		def readsEveryVersion() !none {
			let plain = try renderFace(try (try load(tinyTrueType)).face(0))
			for let (_, version) in int[0x00010000, 0x00020001, 0x00020002] {
				let face = try (try load(try wrap(version, 0))).face(0)
				assert face.info().format == "eot" // format tag
				assert face.info().family == "Tiny Serif" // names from the embedded font
				assert (try renderFace(face)) == plain // the embedded font reads unchanged
			}
		}

		@test()
		def undoesXorObfuscation() !none {
			let face = try (try load(try wrap(0x00020002, 0x10000000))).face(0)
			assert (try renderFace(face)) == (try renderFace(try (try load(tinyTrueType)).face(0))) // XOR 0x50 is undone
		}

		// MicroType Express needs its own compressor to produce, so the whole
		// path is checked against the sample EOT and the WOFF of the same font.
		// Missing samples skip, as in the TTF suite.
		@test()
		def unpacksMicroTypeExpress() !none {
			let eot = os.readFile("samples/fonts/eot/ClearSans-Regular.eot")
			let woff = os.readFile("samples/fonts/woff/ClearSans-Regular.woff")
			return none when eot is error || woff is error

			let face = try (try load(eot)).face(0)
			assert face.info().family == "Clear Sans" // names from the rebuilt font
			assert (try renderFace(face)) == (try renderFace(try (try load(woff)).face(0))) // every outline and advance matches
			if face is OpenTypeFace {
				let cvt = face.table("cvt ")
				fail "the cvt table is missing" when cvt is none
				assert cvt.len() > 0 // cvt comes back from its delta encoding
			}
		}

		@test()
		def rejectsDamagedMicroTypeExpress() !none {
			assert load(try wrap(0x00020001, 0x4)) is error // an sfnt is not MTX data
		}

		@test()
		def rebuildsCompactTables() !none {
			// cvt: 5, +300, -10, +1000 as one-, two-, two- and three-byte deltas.
			let cvt = try opentype.rebuildCvt(byte[0, 4, 5, 248, 62, 239, 10, 238, 0x03, 0xE8])
			assert cvt.equals(byte[0, 5, 1, 0x31, 1, 0x27, 5, 0x0F]) // cumulative values

			// hdmx: one 12 ppem record, surprises 0, +1, -1 against advances
			// scaled from 500, 1000 and 250 units at 1000 per em.
			let hdmx = try opentype.rebuildHdmx(byte[0, 0, 0, 1, 0, 0, 0, 8, 12, 7, 0x52], int[500, 1000, 250], 1000)
			assert hdmx.equals(byte[0, 0, 0, 1, 0, 0, 0, 8, 12, 7, 6, 13, 2, 0, 0, 0]) // predicted widths plus surprises

			// VDMX: one group of two heights predicted from multipliers 1.0 and
			// 0.5 in 5.11 fixed point.
			let vdmx = try opentype.rebuildVdmx(byte[
				0, 1, 0, 1, 0, 1, 1, 1, 1, 1, 0, 12, 0, 2, 8, 0, 4, 0, 0x22, 0x0A
			])
			assert vdmx.equals(byte[
				0, 1, 0, 1, 0, 1, 1, 1, 1, 1, 0, 12, 0, 2, 8, 10, 0, 8, 0, 9, 0xFF, 0xFC, 0, 10, 0, 10,
				0xFF, 0xFA
			])

			// The run-length stage: escape 0xAA; 0xAA 0 is a literal escape,
			// 0xAA n b is n copies of b.
			assert opentype.unRunLength(byte[0xAA, 1, 0xAA, 0, 2, 0xAA, 3, 7]).equals(byte[1, 0xAA, 2, 7, 7, 7]) // runs expand
		}

		@test()
		def opensThroughTheCodec() !none {
			assert (try (try (new EOT()).open(new bytes.Reader(try wrap(0x00010000, 0)))).face(0)).info().format == "eot" // EOT.open
		}

		@test()
		def rejectsTruncatedFiles() !none {
			let data = try wrap(0x00020001, 0)
			assert load(data[0:data.len() - 100]) is error // font data cut short
		}
	}
}
