partial module std.formats.fonts {
	use (
		std.io
		std.formats.fonts.opentype
		std.formats.fonts.winfnt
	)

	// FON is the Windows bitmap font codec: .fon files, which bundle FNT
	// resources in a 16-bit executable, and bare .fnt resources. Each FNT is one
	// face at one pixel size; faces are bitmap-only (`FontInfo.scalable` is
	// false), so glyphs come from `Face.rasterize`.
	@codec("FON")
	type FON {
		mimeType string[] {
			def get() string[] {
				return string["application/x-font-fon"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".fon", ".fnt"]
			}
		}

		// An MZ executable whose extended header is NE, or an FNT header of
		// version 2 or 3 for a raster font.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(118)
			let n = r.read(b) onerror recover 0
			return false when n < 64

			if b[0] == byte('M') && b[1] == byte('Z') {
				let ne = int(b[0x3C]) | (int(b[0x3D]) << 8) | (int(b[0x3E]) << 16) | (int(b[0x3F]) << 24)
				return false when ne < 64 || ne > 0x10000
				return b[ne] == byte('N') && b[ne + 1] == byte('E') when ne + 2 <= n
				let rest byte[]
				rest.len(ne + 2 - n)
				let got = r.read(rest) onerror recover 0
				return got == rest.len() && rest[rest.len() - 2] == byte('N') && rest[rest.len() - 1] == byte('E')
			}

			return false when n != 118
			return false unless b[0] == 0x00 && (b[1] == 0x02 || b[1] == 0x03)
			let size = int(b[2]) | (int(b[3]) << 8) | (int(b[4]) << 16) | (int(b[5]) << 24)
			// A raster font whose header fits in the size it declares.
			return size >= 118 && (b[66] & 1) == 0 && b[96] >= b[95]
		}

		// open reads every FNT face of a .fon or .fnt file. Fails when the data is
		// neither, or a face is a vector font or damaged.
		def open(reader io.Reader) !Font {
			return winfnt.open(try opentype.readAll(reader))
		}

		// info describes the first face. Fails like open.
		def info(reader io.Reader) !FontInfo {
			let font = try winfnt.open(try opentype.readAll(reader))
			return (try font.face(0)).info()
		}
	}
}
