partial module std.formats.fonts {
	use (
		std.bytes
		std.testing
	)

	check "FON codec" {
		// First and last character codes of the test fonts: A to 0x82.
		let firstCode = 0x41
		let lastCode = 0x82

		// A 4-pixel-high FNT resource. A is 3 pixels wide, B 9 (two byte
		// columns), code 0x82 a 2-pixel bar; every other code is a blank 3-pixel
		// cell.
		def fnt(version int, charset int) !byte[] {
			let le = bytes.Endian.Little
			let count = lastCode - firstCode + 1
			let headerSize = version == 0x0200 ?? (118, 148)
			let entry = version == 0x0200 ?? (4, 6)
			let faceAt = headerSize + (count + 1) * entry
			let bitsAt = faceAt + 8

			let b = new bytes.Buffer()
			try b.write<uint16>(uint16(version), le)
			// dfSize, patched below
			try b.write<uint32>(uint32(0), le)
			for let i = 0; i < 60; i++ {
				try b.write<byte>(byte(0), le)
			}
			// type, points, vertical and horizontal resolution, ascent,
			// internal and external leading
			for let (_, v) in int[0, 3, 96, 96, 3, 0, 1] {
				try b.write<uint16>(uint16(v), le)
			}
			// italic, underline, strikeout
			for let i = 0; i < 3; i++ {
				try b.write<byte>(byte(0), le)
			}
			try b.write<uint16>(uint16(700), le)
			try b.write<byte>(byte(charset), le)
			// pixel width 0 (proportional), pixel height 4
			try b.write<uint16>(uint16(0), le)
			try b.write<uint16>(uint16(4), le)
			// pitch and family: bit 0 set means variable pitch
			try b.write<byte>(byte(1), le)
			// average and maximum width
			try b.write<uint16>(uint16(3), le)
			try b.write<uint16>(uint16(9), le)
			for let (_, v) in int[firstCode, lastCode, 0, 0] {
				try b.write<byte>(byte(v), le)
			}
			// width bytes, device, face, bits pointer, bits offset
			try b.write<uint16>(uint16(2), le)
			try b.write<uint32>(uint32(0), le)
			try b.write<uint32>(uint32(faceAt), le)
			try b.write<uint32>(uint32(0), le)
			try b.write<uint32>(uint32(bitsAt), le)
			try b.write<byte>(byte(0), le)
			if version == 0x0300 {
				for let i = 0; i < 30; i++ {
					try b.write<byte>(byte(0), le)
				}
			}

			// Bitmaps: A (4 bytes), B (8), the bar (4), then one blank cell.
			let aAt = bitsAt
			let bAt = aAt + 4
			let barAt = bAt + 8
			let blankAt = barAt + 4
			for let code = firstCode; code <= lastCode + 1; code++ {
				let width = 3
				let at = blankAt
				if code == 0x41 {
					at = aAt
				} else if code == 0x42 {
					width = 9
					at = bAt
				} else if code == 0x82 {
					width = 2
					at = barAt
				}
				try b.write<uint16>(uint16(width), le)
				if version == 0x0200 {
					try b.write<uint16>(uint16(at), le)
				} else {
					try b.write<uint32>(uint32(at), le)
				}
			}
			try b.write("Test".bytes() + byte[0, 0, 0, 0])
			try b.write(byte[0x40, 0xA0, 0xE0, 0xA0])
			try b.write(byte[0xFF, 0x80, 0xFF, 0x00, 0x80, 0x80, 0x80, 0x00])
			try b.write(byte[0xC0, 0xC0, 0x00, 0xC0])
			try b.write(byte[0, 0, 0, 0])

			let out = b.bytes()
			out[2] = byte(out.len() & 0xFF)
			out[3] = byte((out.len() >> 8) & 0xFF)
			return out
		}

		// A .fon file: an MZ stub, an NE header and a resource table holding
		// the given FNT resources.
		def fon(resources byte[][]) !byte[] {
			let le = bytes.Endian.Little
			let b = new bytes.Buffer()
			try b.write("MZ".bytes())
			for b.len() < 0x3C {
				try b.write<byte>(byte(0), le)
			}
			try b.write<uint32>(uint32(64), le)

			// NE header, with the resource table 64 bytes in.
			try b.write("NE".bytes())
			for b.len() < 64 + 0x24 {
				try b.write<byte>(byte(0), le)
			}
			try b.write<uint16>(uint16(64), le)
			for b.len() < 128 {
				try b.write<byte>(byte(0), le)
			}

			// Resource table: alignment shift 0, one type with every font.
			let at = 128 + 2 + 8 + 12 * resources.len() + 2
			try b.write<uint16>(uint16(0), le)
			try b.write<uint16>(uint16(0x8008), le)
			try b.write<uint16>(uint16(resources.len()), le)
			try b.write<uint32>(uint32(0), le)
			for let (i, r) in resources {
				try b.write<uint16>(uint16(at), le)
				try b.write<uint16>(uint16(r.len()), le)
				try b.write<uint16>(uint16(0), le)
				try b.write<uint16>(uint16(0x8001 + i), le)
				try b.write<uint32>(uint32(0), le)
				at += r.len()
			}
			try b.write<uint16>(uint16(0), le)
			for let (_, r) in resources {
				try b.write(r)
			}
			return b.bytes()
		}

		def art(bm Bitmap) string {
			let rows string[]
			for let y = 0; y < bm.height; y++ {
				let row = ""
				for let x = 0; x < bm.width; x++ {
					row += bm.coverage[y * bm.width + x] > 0 ?? ("#", ".")
				}
				rows.push(row)
			}
			return rows.join("/")
		}

		@test()
		def signature() !none {
			let codec = new FON()
			assert codec.matchSignature(new bytes.Reader(try fon(byte[][try fnt(0x0200, 255)]))) // MZ with an NE header
			assert codec.matchSignature(new bytes.Reader(try fnt(0x0300, 0))) // a bare FNT resource
			assert !(codec.matchSignature(new bytes.Reader(tinyTrueType))) // sfnt is not FON
		}

		@test()
		def readsEveryResourceAsAFace() !none {
			let font = try load(try fon(byte[][try fnt(0x0200, 255), try fnt(0x0300, 0)]))
			assert font.faces() == 2 // one face per FNT resource
			let i = (try font.face(0)).info()
			assert i.family == "Test" // face name from the resource
			assert i.subfamily == "Bold" // weight 700
			assert i.weight == FontWeight.Bold // weight class
			assert !(i.scalable) // bitmap only
			assert !(i.fixedPitch) // variable pitch
			assert int(i.unitsPerEm) == 4 // one unit per pixel of height
			assert int(i.glyphCount) == lastCode - firstCode + 1 // one glyph per code
			assert i.format == "fon" // format tag
			assert (try font.face(1)).info().format == "fon" // version 3 resources read too
		}

		@test()
		def readsBareFntFiles() !none {
			let font = try load(try fnt(0x0300, 0))
			assert font.faces() == 1 // a .fnt is one face
			assert (try font.face(0)).info().format == "fnt" // format tag
		}

		@test()
		def mapsCharacterSets() !none {
			let oem = try (try load(try fnt(0x0200, 255))).face(0)
			let ansi = try (try load(try fnt(0x0200, 0))).face(0)

			let a = oem.glyph('A')
			fail "A is not mapped" when a is none
			assert int(a) == 0 // A is the first code
			let e = oem.glyph('é')
			fail "é is not mapped in CP437" when e is none
			assert int(e) == 0x82 - firstCode // é is CP437 0x82
			assert ansi.glyph('é') is none // in Windows-1252 é is 0xE9, past the last code
			let quote = ansi.glyph('‚')
			fail "‚ is not mapped in Windows-1252" when quote is none
			assert int(quote) == 0x82 - firstCode // the low quote is Windows-1252 0x82
			assert oem.glyph('中') is none // outside every code page
		}

		@test()
		def rasterizesStoredBitmaps() !none {
			let face = try (try load(try fnt(0x0200, 255))).face(0)
			let a = face.glyph('A')
			let b = face.glyph('B')
			fail "A is not mapped" when a is none
			fail "B is not mapped" when b is none

			let bm = try face.rasterize(a, 4.0)
			assert bm.width == 3 && bm.height == 4 // the glyph cell
			assert bm.bearingY == 3 // the ascent
			assert art(bm) == ".#./#.#/###/#.#" // row-major coverage
			assert art(try face.rasterize(b, 4.0)) == "#########/#.......#/#########/........." // two byte columns

			let big = try face.rasterize(a, 8.0)
			assert big.width == 6 && big.height == 8 // twice the size
			assert art(big) == "..##../..##../##..##/##..##/######/######/##..##/##..##" // pixels repeat

			assert (try face.metrics(b)).advance == int16(9) // advance is the cell width
			assert face.outline(a) is error // no outlines in a bitmap face
		}

		@test()
		def opensThroughTheCodec() !none {
			assert (try (new FON()).open(new bytes.Reader(try fnt(0x0200, 255)))).faces() == 1 // FON.open
		}

		@test()
		def rejectsDamagedFiles() !none {
			let data = try fnt(0x0200, 255)
			let vector = data.clone()
			vector[66] = 1
			assert load(vector) is error // vector fonts are refused
			assert load(data[0:100]) is error // a truncated header
		}
	}
}
