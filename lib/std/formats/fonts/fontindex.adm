partial module std.formats.fonts {
	use (
		std.os
		std.time
		std.services.policy::(Policy)
	)

	// The on-disk index of the installed fonts, so a program does not parse
	// every font file each time it starts. One file, `system.idx` in
	// `fontCacheDir()`, shared by every ADM program of the user:
	//
	//     "ADMFIDX1"  magic and version
	//     u32         file count, then per font file:
	//       str         path
	//       u32 u32     size, high and low halves
	//       u32 u32     modification time in ns since 1970, high and low
	//       u32         face count (0 for a file that is not a font), then per face:
	//         u32         index in the file
	//         str         family as the font spells it
	//         u32 str...  lower-cased family names
	//         u32 u32 u32 weight, width, flags (1 italic, 2 colour glyphs)
	//         u32 str...  design languages
	//         u32 u32...  covered code points as (first, last) pairs
	//
	// Integers are big-endian; a str is a u32 byte length and UTF-8 bytes.
	// A file whose size and time still match reuses its faces; the rest are
	// read again and the index is rewritten when anything changed. A missing
	// or unreadable index is rebuilt.
	internal const indexMagic = "ADMFIDX1"

	// One font file as the index records it.
	internal struct IndexedFile {
		path     string
		size     int64
		modified int64
		faces    FaceEntry[]
	}

	// Fills `set` with the fonts under `dirs`, through the index at `cache`
	// (no index when empty).
	internal def indexFonts(set FontSet, dirs string[], cache string) {
		let previous = cache == "" ?? (map<string, IndexedFile>{}, readFontIndex(cache))
		let files IndexedFile[]
		let changed = false
		for let (_, dir) in dirs {
			// Std reads the installed fonts on its own account: a policy
			// `ask` never puts these folders to the user.
			Policy.registerResources("adm.storage.read", [globLiteral(dir) + "*"]) onerror recover none
			let found = os.readDir(dir, 8)
			continue when found is error
			for let (_, entry) in found {
				continue when entry.info.isDir
				let ext = os.extension(entry.path).lower()
				continue unless ext := "ttf" || "otf" || "ttc" || "otc"
				let file = IndexedFile{path: entry.path, size: entry.info.size, modified: entry.info.modTime.unixNs(), faces: FaceEntry[]}
				let known = previous.get(entry.path)
				if known is IndexedFile && known.size == file.size && known.modified == file.modified {
					file.faces = known.faces
					set.entries.push(...known.faces)
				} else {
					let before = set.entries.len()
					set.add(entry.path) onerror recover none
					for let k = before; k < set.entries.len(); k++ {
						file.faces.push(set.entries[k])
					}
					changed = true
				}
				files.push(file)
			}
		}
		changed = true when files.len() != previous.len()
		writeFontIndex(cache, files) when changed && cache != ""
	}

	// The index at `path` by font file path; empty when it is missing or
	// does not read.
	internal def readFontIndex(path string) map<string, IndexedFile> {
		let out = map<string, IndexedFile>{}
		Policy.registerResources("adm.storage.read", [globLiteral(path)]) onerror recover none
		let data = os.readFile(path)
		return out when data is error
		let r = new IndexReader(data)
		return out unless r.readText(indexMagic.len()) == indexMagic
		let count = r.readCount()
		for let i = 0; i < count && r.ok; i++ {
			let file = IndexedFile{path: r.readStr(), size: r.readU64(), modified: r.readU64(), faces: FaceEntry[]}
			let faces = r.readCount()
			for let k = 0; k < faces && r.ok; k++ {
				let e = new FaceEntry(file.path, r.readU32())
				e.family = r.readStr()
				e.families = r.readStrs()
				e.weight = r.readU32()
				e.width = r.readU32()
				let flags = r.readU32()
				e.italic = flags & 1 != 0
				e.color = flags & 2 != 0
				e.languages = r.readStrs()
				let spans = r.readCount()
				for let s = 0; s < spans && r.ok; s++ {
					e.spans.push(r.readU32())
				}
				file.faces.push(e)
			}
			out[file.path] = file when r.ok
		}
		return r.ok ?? (out, map<string, IndexedFile>{})
	}

	// Writes the index to `path`, through a temporary file renamed over it
	// so a reader never sees half of one. A failure leaves no index: the
	// next program builds it again.
	internal def writeFontIndex(path string, files IndexedFile[]) {
		let out byte[]
		out.push(...byte[](indexMagic))
		appendU32(out, files.len())
		for let (_, file) in files {
			appendStr(out, file.path)
			appendU64(out, file.size)
			appendU64(out, file.modified)
			appendU32(out, file.faces.len())
			for let (_, e) in file.faces {
				appendU32(out, e.index)
				appendStr(out, e.family)
				appendStrs(out, e.families)
				appendU32(out, e.weight)
				appendU32(out, e.width)
				appendU32(out, (e.italic ?? (1, 0)) | (e.color ?? (2, 0)))
				appendStrs(out, e.languages)
				appendU32(out, e.spans.len())
				for let (_, v) in e.spans {
					appendU32(out, v)
				}
			}
		}
		let dir = parentDir(path)
		Policy.registerResources("adm.storage.write", [globLiteral(dir) + "*"]) onerror recover none
		Policy.registerResources("adm.storage.read", [globLiteral(dir) + "*"]) onerror recover none
		makeDirs(dir)
		let temp = "{path}.{time.now().unixNs()}"
		if os.writeFile(temp, out) is error {
			os.remove(temp) onerror recover none
			return
		}
		os.rename(temp, path) onerror recover os.remove(temp) onerror recover none
	}

	// Creates `dir` and its missing parents; failures are left for the
	// write that follows to report.
	internal def makeDirs(dir string) {
		return when dir == ""
		let exists = os.exists(dir)
		return when exists is error || exists
		makeDirs(parentDir(dir))
		os.mkdir(dir) onerror recover none
	}

	// `path` without its last element, either separator.
	internal def parentDir(path string) string {
		for let i = path.len() - 1; i > 0; i-- {
			return path[:i] when path[i] := '/' || '\\'
		}
		return ""
	}

	// `text` as a glob pattern matching only itself.
	internal def globLiteral(text string) string {
		let out = ""
		for let (_, ch) in text {
			out += "\\" when ch := '*' || '?' || '\\'
			out += string(ch)
		}
		return out
	}

	internal def appendU32(out byte[], v int) {
		out.push(byte(v >> 24 & 0xFF))
		out.push(byte(v >> 16 & 0xFF))
		out.push(byte(v >> 8 & 0xFF))
		out.push(byte(v & 0xFF))
	}

	internal def appendU64(out byte[], v int64) {
		appendU32(out, int(v >> 32 & 0xFFFFFFFF))
		appendU32(out, int(v & 0xFFFFFFFF))
	}

	internal def appendStr(out byte[], s string) {
		let b = byte[](s)
		appendU32(out, b.len())
		out.push(...b)
	}

	internal def appendStrs(out byte[], list string[]) {
		appendU32(out, list.len())
		for let (_, s) in list {
			appendStr(out, s)
		}
	}

	// Reads the index; `ok` turns false, and stays false, at the first read
	// past the end or count larger than what is left.
	internal type IndexReader {
		internal data byte[]
		internal at   int
		ok            bool

		def new(data byte[]) {
			self.data = data
			ok = true
		}

		def readU32() int {
			if at + 4 > data.len() {
				ok = false
				return 0
			}
			at += 4
			return u32(data, at - 4)
		}

		def readU64() int64 {
			let hi = int64(readU32())
			return hi << 32 | int64(readU32())
		}

		// A count of items at least four bytes each.
		def readCount() int {
			let n = readU32()
			ok = false when n * 4 > data.len() - at
			return ok ?? (n, 0)
		}

		def readText(n int) string {
			if n < 0 || at + n > data.len() {
				ok = false
				return ""
			}
			at += n
			return string(data[at - n:at])
		}

		def readStr() string {
			return readText(readU32())
		}

		def readStrs() string[] {
			let out string[]
			let n = readCount()
			for let i = 0; i < n && ok; i++ {
				out.push(readStr())
			}
			return out
		}
	}
}
