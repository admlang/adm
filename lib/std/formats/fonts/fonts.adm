partial module std.formats.fonts {
	use (
		std.io
		std.math.geom
	)

	// A glyph's index within a face. Not a codepoint -- the mapping from
	// codepoints to glyphs is what `Face.glyph` does, and it is many-to-one in
	// both directions.
	type GlyphID = uint16

	// How thick a face is drawn, on the OpenType 100..900 scale.
	enum FontWeight {
		Thin       = 100,
		ExtraLight = 200,
		Light      = 300,
		Regular    = 400,
		Medium     = 500,
		SemiBold   = 600,
		Bold       = 700,
		ExtraBold  = 800,
		Black      = 900
	}

	// How wide a face is drawn, on the OpenType 1..9 scale.
	enum FontWidth {
		UltraCondensed = 1,
		ExtraCondensed = 2,
		Condensed      = 3,
		SemiCondensed  = 4,
		Normal         = 5,
		SemiExpanded   = 6,
		Expanded       = 7,
		ExtraExpanded  = 8,
		UltraExpanded  = 9
	}

	// What a font file says about a face before any glyph is read.
	//
	// This is what font matching runs on: a `ui.FontStyle` naming a family,
	// weight and slant is resolved against these.
	struct FontInfo {
		// "Open Sans", "Proxima Nova".
		family     string
		// "Regular", "Bold Italic".
		subfamily  string
		// Unique PostScript name: "OpenSans-Regular".
		postscript string
		weight     FontWeight
		width      FontWidth
		italic     bool
		// Design grid the outlines and metrics are expressed in, typically 1000
		// (PostScript) or 2048 (TrueType). Everything in `FontMetrics` and
		// `GlyphMetrics` is in these units; scale by `size / unitsPerEm`.
		unitsPerEm uint16
		glyphCount uint16
		// Every glyph advances by the same amount.
		fixedPitch bool
		// False for bitmap-only faces, where `Face.outline` fails.
		scalable   bool
		// Carries colour glyphs (COLR/CPAL, CBDT, sbix).
		color      bool
		// Lowercase format-owned name: "ttf", "otf", "woff2".
		format     string
	}

	// Face-wide metrics, in font units. See `FontInfo.unitsPerEm`.
	struct FontMetrics {
		// Distance above the baseline. Positive.
		ascent    int16
		// Distance below the baseline. Negative.
		descent   int16
		// Extra leading between lines, on top of ascent - descent.
		lineGap   int16
		// Zero when the face does not record them.
		capHeight int16
		xHeight   int16
		underlinePosition  int16
		underlineThickness int16
		// Box enclosing every glyph in the face.
		bounds    geom.Rect
	}

	// One glyph's metrics, in font units.
	struct GlyphMetrics {
		// How far the pen moves after drawing this glyph.
		advance          int16
		leftSideBearing  int16
		bounds           geom.Rect
	}

	// What kind of segment an outline step is.
	enum SegmentKind {
		// Starts a new contour at `to`.
		Move,
		Line,
		// One control point: TrueType outlines.
		Quadratic,
		// Two control points: CFF/PostScript outlines.
		Cubic,
		// Closes the current contour. Point fields are unused.
		Close
	}

	// One step of a glyph outline, in font units.
	struct Segment {
		kind     SegmentKind
		to       geom.Point
		control1 geom.Point
		control2 geom.Point
	}

	// A glyph's scalable outline: the contours a rasteriser fills.
	//
	// Empty for whitespace glyphs, which is not an error.
	struct Outline {
		segments Segment[]
	}

	// A glyph rasterised at a specific size, ready to go into a texture atlas.
	struct Bitmap {
		width  int
		height int
		// Where the bitmap sits relative to the pen position, in pixels.
		bearingX int
		bearingY int
		// 8-bit coverage, `width * height` bytes, row-major.
		coverage byte[]
	}

	// One axis of a variable font, e.g. `wght` 100..900.
	struct VariationAxis {
		// Four-character axis tag: "wght", "wdth", "slnt", "opsz".
		tag     string
		name    string
		min     float
		max     float
		initial float
	}

	// One typeface: a single set of glyphs with one set of metrics.
	//
	// Metrics and outlines come back in font units rather than pixels, because
	// a face is shared across every size it is drawn at. Scale by
	// `size / info().unitsPerEm`.
	interface Face {
		def info() FontInfo
		def metrics() FontMetrics

		// The glyph a codepoint maps to, or none when the face has no glyph for
		// it -- which is what drives fallback to another font.
		def glyph(codepoint char) ?GlyphID
		def metrics(glyph GlyphID) !GlyphMetrics

		// Horizontal adjustment applied between two adjacent glyphs, in font
		// units. Zero when the face records no kerning for the pair.
		def kern(left GlyphID, right GlyphID) int16

		// The glyph's contours. Fails on bitmap-only faces, where
		// `info().scalable` is false -- use `rasterize` there.
		def outline(glyph GlyphID) !Outline

		// The glyph filled at `size` pixels per em. Works for both outline and
		// bitmap faces, so a text renderer building an atlas can use it alone.
		def rasterize(glyph GlyphID, size float) !Bitmap
	}

	// A variable face, whose outlines move along one or more design axes.
	//
	// Tested for with `is`, since most faces are not variable.
	interface VariableFace {
		Face

		def axes() VariationAxis[]
		// A face fixed at one point in the design space, keyed by axis tag.
		def instance(coords map<string, float>) !Face
	}

	// A face backed by OpenType layout tables, which is what shaping needs.
	//
	// ttf, otf and their compressed wrappers satisfy this; bitmap faces do not,
	// so `shape` falls back to plain codepoint mapping for those. Tested for
	// with `is`.
	interface OpenTypeFace {
		Face

		// Raw bytes of a named table -- "GSUB", "GPOS", "cmap", "COLR" -- or
		// none when the face has no such table.
		//
		// Raw rather than parsed on purpose: a codec's job is to find the table
		// in the file, and the shaper is what understands its contents. That
		// keeps GSUB/GPOS parsing in one place instead of in every codec, and
		// leaves a way to reach tables std does not model yet.
		def table(tag string) ?byte[]
	}

	// Which way a run of text advances.
	enum TextDirection {
		LeftToRight,
		RightToLeft,
		TopToBottom
	}

	// One glyph placed by the shaper.
	struct ShapedGlyph {
		glyph    GlyphID
		// Offset from the pen position, in font units. Usually zero; non-zero
		// for marks and accents that attach to another glyph.
		xOffset  int16
		yOffset  int16
		// How far the pen moves after drawing this glyph, in font units.
		xAdvance int16
		yAdvance int16
		// Byte index into the source string this glyph came from.
		//
		// Neither direction is one-to-one: "fi" may shape to a single ligature
		// glyph, and one Devanagari codepoint may produce several glyphs. This
		// is what maps a glyph back to the text for cursor placement, hit
		// testing and selection.
		cluster  int
	}

	// The result of shaping a run of text with one face.
	struct ShapedRun {
		glyphs    ShapedGlyph[]
		direction TextDirection
	}

	struct ShapeOptions {
		// ISO 15924 script tag: "Latn", "Arab", "Deva". Empty guesses from the
		// text.
		script    string
		// BCP 47 language tag. Changes some substitutions -- Turkish keeps a
		// dotless i where English would ligate.
		language  string
		direction TextDirection
		// OpenType feature tags forced on or off: "liga" (standard ligatures),
		// "kern", "smcp" (small caps), "tnum" (tabular figures). Unlisted
		// features keep the font's own default.
		features  map<string, bool>
	}

	// Turns text into positioned glyphs using the face's layout tables.
	//
	// This is what makes "fi" draw as one ligature glyph, applies kerning from
	// GPOS rather than the simpler `Face.kern`, and picks the right contextual
	// form for scripts where a letter changes shape next to its neighbours.
	//
	// Shared rather than per-codec: every OpenType face encodes these rules the
	// same way, so the logic lives here once and reads the tables through
	// `OpenTypeFace.table`. A face without layout tables falls back to mapping
	// each codepoint through `Face.glyph` with `Face.kern` between pairs, which
	// is correct for Latin text and all a bitmap face can do anyway.
	def shape(face Face, text string, opts ShapeOptions = ShapeOptions{}) !ShapedRun {}

	// The OpenType feature tags a face actually carries, for a UI that wants to
	// offer them -- optional ligatures, stylistic sets, alternate figures.
	def features(face Face) string[] {}

	// A font file, which may hold more than one face -- `.ttc` collections do,
	// and so do OpenType collections.
	//
	// Closing it releases the underlying stream and every face taken from it.
	interface Font {
		io.Closer

		def faces() int
		def face(index int) !Face
	}

	// What the codec registry discovers: one stateless instance per file format.
	//
	// Deliberately minimal, like the audio and archive codecs. Anything one
	// format alone offers belongs on that codec's own type, reached by
	// instantiating it directly.
	interface FontFormat {
		def open(reader io.Reader) !Font
		// Header-only read of the first face, without parsing glyph data.
		def info(reader io.Reader) !FontInfo
	}

}
