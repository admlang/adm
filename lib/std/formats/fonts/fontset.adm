partial module std.formats.fonts {
	use (
		std.os
		std.text.unicode
		std.formats.fonts.sfnt
	)

	// FaceRun is a stretch of text one face draws: characters [start, end)
	// as `string.slice` counts them.
	struct FaceRun {
		face  Face
		start int
		end   int
	}

	// What a font set knows of a face without loading it.
	internal type FaceEntry {
		path      string
		index     int
		// Lower-cased family names: the typographic family (name 16) and the
		// legacy one (name 1).
		families  string[]
		family    string
		weight    int
		italic    bool
		width     int
		// Whether it has colour glyphs (COLR, CBDT, sbix or SVG): what emoji
		// prefer.
		color     bool
		// Lower-cased BCP 47 tags of the languages and scripts it is
		// designed for: the `meta` table's `dlng`, else read from a family
		// name ending in JP, SC, TC, HK or KR as Noto and Source Han name
		// their CJK faces.
		languages string[]
		// Covered code points as inclusive (first, last) pairs, ascending.
		spans     int[]
		loaded    ?Face

		def new(path string, index int) {
			self.path = path
			self.index = index
			weight = 400
			width = 5
		}

		def covers(cp int) bool {
			let lo = 0
			let hi = spans.len() / 2 - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				if cp < spans[mid * 2] {
					hi = mid - 1
				} else if cp > spans[mid * 2 + 1] {
					lo = mid + 1
				} else {
					return true
				}
			}
			return false
		}

		// The face, loaded on first use; none when the file no longer reads.
		def face() ?Face {
			return loaded unless loaded is none
			let font = load(path)
			return none when font is error
			let f = font.face(index)
			return none when f is error
			loaded = f
			return f
		}
	}

	// FontSet is a collection of faces to choose from by family, weight and
	// slant, and to fall back on for characters a face does not have.
	// Faces are indexed when added (names, style, the characters they
	// cover) and loaded only when chosen. `systemFonts()` is the set of
	// fonts installed on the computer.
	type FontSet {
		internal entries FaceEntry[]

		def new() {}

		// Adds every face of the font file at `path`, reading only its table
		// directory and the cmap, name, OS/2 and head tables. Fails when the
		// file cannot be read or is not an sfnt font (TrueType, OpenType or a
		// collection of them).
		atomic def add(path string) !none {
			try indexFile(path)
		}

		// Adds a face already open. Faces without a character map (bitmap
		// FON faces) are matched by name and style but never chosen for a
		// fallback.
		atomic def add(face Face) {
			let e = new FaceEntry("", 0)
			e.loaded = face
			let info = face.info()
			e.family = info.family
			e.families.push(info.family.lower())
			e.weight = int(info.weight)
			e.italic = info.italic
			if face is OpenTypeFace {
				for let (_, tag) in ["COLR", "CBDT", "sbix", "SVG "] {
					e.color = true unless face.table(tag) is none
				}
				let dlng = face.table("meta")
				e.languages = designLanguages(dlng) unless dlng is none
				let found = face.table("cmap")
				let cmap = found is none ?? (byte[], found)
				if cmap.len() > 0 {
					let s = new sfnt.Sfnt()
					let parsed = s.parse(syntheticFont(map<string, byte[]>{"cmap": cmap}))
					if !(parsed is error) {
						let c = sfnt.readCmap(s)
						e.spans = c.spans() unless c is error
					}
				}
			}
			e.languages = familyLanguages(e.family) when e.languages.len() == 0
			entries.push(e)
		}

		// The family names the set holds, as the fonts spell them, each once.
		atomic def families() string[] {
			let out string[]
			for let (_, e) in entries {
				out.push(e.family) when e.family != "" && out.indexOf(e.family) < 0
			}
			return out
		}

		// The face that best matches a request, as CSS matches fonts:
		// `family` names in order of preference (the generic "sans-serif",
		// "serif", "monospace", "cursive", "fantasy", "system-ui" and "emoji"
		// stand for this platform's usual faces), then the closest weight
		// (100 thin to 900 black) and slant. None when no family is in the set.
		atomic def find(family string | string[], weight int = 400, italic bool = false) ?Face {
			let wanted string[]
			match family {
				case string:
					wanted.push(family)
				case string[]:
					wanted = family
			}
			for let (_, name) in wanted {
				let names = genericFamilies(name.lower())
				names = [name.lower()] when names.len() == 0
				for let (_, n) in names {
					let best = bestOf(n, weight, italic)
					if best >= 0 {
						let f = entries[best].face()
						return f unless f is none
					}
				}
			}
			return none
		}

		// A face of the set that has `ch`, the one closest in style to
		// `like` (same family first, then the text's `language`, a BCP 47
		// tag, then weight and slant). None when no face has it. The
		// language tells Japanese, Chinese and Korean faces apart: "ja" picks
		// a JP face for an ideograph they all have.
		atomic def fallback(ch char, like ?Face = none, language string = "") ?Face {
			let e = fallbackEntry(int(ch), like, language)
			return none when e < 0
			return entries[e].face()
		}

		// The text split into runs each drawn by one face, for shaping one
		// run at a time: each user-perceived character goes to the first of
		// `faces` that has all of it, else to the fallback face already in
		// use, else to the face of the set closest in style to `faces[0]`
		// that has it, else stays with the face before it. Spaces,
		// punctuation and digits stay with the face before them when it has
		// them; emoji prefer faces with colour glyphs, pictographs in text
		// style faces without. `language`, a BCP 47 tag, steers fallback as
		// in `fallback`.
		atomic def faceRuns(text string, faces Face[], language string = "") FaceRun[] {
			let out FaceRun[]
			let chars char[]
			for let (_, ch) in text {
				chars.push(ch)
			}
			return out when chars.len() == 0
			let like ?Face = none
			like = faces[0] when faces.len() > 0
			// Faces in use: the given ones, then fallbacks as they are found.
			let pool = faces.clone()
			let current = faces.len() > 0 ?? (0, -1)
			let start = 0
			let prev = 0
			for let (_, end) in unicode.graphemeBreaks(text) {
				let needed int[]
				for let k = prev; k < end; k++ {
					// Joiners and selectors ride along with their cluster.
					needed.push(int(chars[k])) unless unicode.isDefaultIgnorable(chars[k])
				}
				let emoji = isEmoji(chars, prev, end)
				let pictograph = false
				for let k = prev; k < end; k++ {
					pictograph = true when unicode.isExtendedPictographic(chars[k])
				}
				// Spaces, punctuation and digits belong to no script: they stay
				// with the face before them when it has them.
				let neutral = true
				for let k = prev; k < end; k++ {
					let sc = unicode.script(chars[k])
					neutral = false unless sc := "Zyyy" || "Zinh"
				}
				let fits = (i int) => i >= 0 && hasAll(pool[i], needed) && (!emoji || isColor(pool[i]))
				let chosen = -1
				if needed.len() == 0 || (neutral && fits(current)) {
					chosen = current
				} else {
					// The first of the given faces that has it all.
					for let (i, f) in faces {
						if fits(i) {
							chosen = i
							break
						}
					}
					// A fallback face in use, then one from the set.
					chosen = current when chosen < 0 && fits(current)
					if chosen < 0 {
						// Emoji prefer colour faces, text-style pictographs plain ones.
						let e = fallbackEntry(needed[0], like, language, needed, emoji, pictograph && !emoji)
						e = fallbackEntry(needed[0], like, language, needed) when e < 0 && (emoji || pictograph)
						if e >= 0 {
							let f = entries[e].face()
							if f is Face {
								chosen = pool.indexOf(f)
								if chosen < 0 {
									pool.push(f)
									chosen = pool.len() - 1
								}
							}
						}
					}
					chosen = current when chosen < 0
				}
				if chosen >= 0 {
					if current >= 0 && current != chosen && prev > start {
						out.push(FaceRun{face: pool[current], start: start, end: prev})
						start = prev
					}
					current = chosen
				}
				prev = end
			}
			out.push(FaceRun{face: pool[current], start: start, end: chars.len()}) when current >= 0
			return out
		}

		// Whether characters [from, to) are an emoji meant to show in colour
		// (UTS #51): one with the emoji selector U+FE0F (keycaps too), an
		// Emoji_Presentation character, or a pictograph with a joiner or a
		// skin tone; the text selector U+FE0E keeps it text.
		internal def isEmoji(chars char[], from int, to int) bool {
			let pict = false
			let marked = false
			let presentation = false
			for let k = from; k < to; k++ {
				let cp = int(chars[k])
				return false when cp == 0xFE0E
				pict = true when unicode.isExtendedPictographic(chars[k])
				presentation = true when cp == 0xFE0F || unicode.isEmojiPresentation(chars[k])
				marked = true when cp == 0x200D || (cp >= 0x1F3FB && cp <= 0x1F3FF)
			}
			return presentation || (pict && marked)
		}

		// Whether a face draws colour glyphs.
		internal def isColor(f Face) bool {
			for let (_, e) in entries {
				let l = e.loaded
				if l is Face {
					return e.color when l == f
				}
			}
			return false unless f is OpenTypeFace
			return !(f.table("COLR") is none && f.table("CBDT") is none && f.table("sbix") is none && f.table("SVG ") is none)
		}

		internal def hasAll(f Face, cps int[]) bool {
			for let (_, cp) in cps {
				return false when f.glyph(char(cp)) is none
			}
			return true
		}

		// The entry closest to `like` and `language` that covers `cp` (and
		// every one of `all`, when given), -1 when none.
		// With `color`, only faces with colour glyphs; with `plain`, only
		// faces without.
		internal def fallbackEntry(cp int, like ?Face, language string, all int[] = int[], color bool = false, plain bool = false) int {
			let wanted = language == "" ?? (none, parseTag(language))
			let family = ""
			let weight = 400
			let italic = false
			if like is Face {
				let info = like.info()
				family = info.family.lower()
				weight = int(info.weight)
				italic = info.italic
			}
			let mono = family.contains("mono")
			let best = -1
			let bestScore = 0
			for let (i, e) in entries {
				continue unless e.covers(cp)
				continue when (color && !e.color) || (plain && e.color)
				let ok = true
				for let (_, other) in all {
					ok = false unless e.covers(other)
				}
				continue unless ok
				// Same family first, then the language, then fixed or
				// proportional pitch like it, then slant, then weight distance.
				let pitch = e.family.lower().contains("mono") == mono ?? (0, 50000)
				let lang = wanted is none ?? (0, languagePenalty(e.languages, wanted))
				let score = (e.families.indexOf(family) >= 0 ?? (0, 200000)) + lang + pitch + (e.italic == italic ?? (0, 10000)) + (e.weight - weight).abs() + (e.width - 5).abs() * 10
				if best < 0 || score < bestScore {
					best = i
					bestScore = score
				}
			}
			return best
		}

		// The entry of `family` best matching weight and slant (CSS Fonts
		// 4, 5.2), -1 when the family is not in the set.
		internal def bestOf(family string, weight int, italic bool) int {
			let candidates int[]
			for let (i, e) in entries {
				candidates.push(i) when e.families.indexOf(family) >= 0
			}
			return -1 when candidates.len() == 0
			// Slant: the wanted one when the family has it.
			let slanted int[]
			for let (_, i) in candidates {
				slanted.push(i) when entries[i].italic == italic
			}
			candidates = slanted when slanted.len() > 0
			// Width: normal, else the nearest.
			let nearest = 100
			for let (_, i) in candidates {
				nearest = nearest.min((entries[i].width - 5).abs())
			}
			let widths int[]
			for let (_, i) in candidates {
				widths.push(i) when (entries[i].width - 5).abs() == nearest
			}
			candidates = widths
			// Weight.
			let best = -1
			let bestRank = 0
			for let (_, i) in candidates {
				let rank = weightRank(entries[i].weight, weight)
				if best < 0 || rank < bestRank {
					best = i
					bestRank = rank
				}
			}
			return best
		}

		// How CSS orders a face's weight `w` for a wanted weight: lower is
		// better.
		internal def weightRank(w int, wanted int) int {
			if wanted >= 400 && wanted <= 500 {
				return w - wanted when w >= wanted && w <= 500
				return 1000 + (wanted - w) when w < wanted
				return 2000 + (w - 500)
			}
			if wanted < 400 {
				return wanted - w when w <= wanted
				return 1000 + (w - wanted)
			}
			return w - wanted when w >= wanted
			return 1000 + (wanted - w)
		}

		// Indexes every face of an sfnt file.
		internal def indexFile(path string) !none {
			let f = try os.open(path)
			defer f.close()
			let head byte[]
			head.len(12)
			fail "{path}: not a font" when (try f.readAt(head, 0)) < 12
			let offsets int[]
			if u32(head, 0) == 0x74746366 {
				// A collection: the offset of each face's table directory.
				let count = u32(head, 8)
				fail "{path}: font collection holds no faces" when count == 0 || count > 10000
				let table byte[]
				table.len(count * 4)
				try f.readAt(table, 12)
				for let i = 0; i < count; i++ {
					offsets.push(u32(table, i * 4))
				}
			} else {
				offsets.push(0)
			}
			for let (index, at) in offsets {
				let e = try indexFace(f, path, index, at)
				entries.push(e)
			}
		}

		// Reads one face's directory and the tables the index needs.
		internal def indexFace(f os.File, path string, index int, at int) !FaceEntry {
			let dir byte[]
			dir.len(12)
			try f.readAt(dir, at)
			let version = u32(dir, 0)
			fail "{path}: not an sfnt font" unless version := 0x00010000 || 0x4F54544F || 0x74727565
			let count = int(dir[4]) << 8 | int(dir[5])
			let records byte[]
			records.len(count * 16)
			try f.readAt(records, at + 12)
			let tables = map<string, byte[]>{}
			let e = new FaceEntry(path, index)
			for let i = 0; i < count; i++ {
				let r = i * 16
				let tag = string(records[r:r + 4])
				e.color = true when tag := "COLR" || "CBDT" || "sbix" || "SVG "
				continue unless tag := "cmap" || "name" || "OS/2" || "head" || "meta"
				let length = u32(records, r + 12)
				continue when length > 16 << 20
				let data byte[]
				data.len(length)
				try f.readAt(data, u32(records, r + 8))
				tables[tag] = data
			}
			let s = new sfnt.Sfnt()
			try s.parse(syntheticFont(tables))
			for let (_, id) in [16, 1] {
				let name = sfnt.readName(s, id)
				if name != "" {
					e.family = name when e.family == ""
					e.families.push(name.lower()) when e.families.indexOf(name.lower()) < 0
				}
			}
			let os2 = sfnt.readOs2(s)
			if os2 is sfnt.Os2 {
				e.weight = int(os2.weightClass) when os2.weightClass > 0
				e.width = int(os2.widthClass) when os2.widthClass > 0
				e.italic = os2.isItalic()
			} else {
				// macStyle bit 1: italic.
				let found = tables.get("head")
				let h = found is none ?? (byte[], found)
				e.italic = h.len() >= 46 && h[45] & 2 != 0
			}
			let dlng = tables.get("meta")
			e.languages = designLanguages(dlng) unless dlng is none
			e.languages = familyLanguages(e.family) when e.languages.len() == 0
			let cmap = sfnt.readCmap(s)
			e.spans = cmap.spans() unless cmap is error
			return e
		}
	}

	// A BCP 47 tag split into its language, script and region subtags,
	// lower-cased; the script is implied where the language has one usual
	// script ("ja" is Jpan) or the region decides it (zh-TW is Hant).
	internal struct LanguageTag {
		language string
		script   string
		region   string
	}

	internal def parseTag(tag string) LanguageTag {
		let t = LanguageTag{language: "", script: "", region: ""}
		for let (i, part) in tag.trim().lower().replace("_", "-").split("-") {
			if i == 0 && part.len() == 4 {
				t.script = part // a bare script tag, as `meta` allows
			} else if i == 0 {
				t.language = part
			} else if part.len() == 4 && t.script == "" && t.region == "" {
				t.script = part
			} else if (part.len() == 2 || part.len() == 3) && t.region == "" {
				t.region = part
			}
		}
		if t.script == "" {
			if t.language == "ja" {
				t.script = "jpan"
			} else if t.language == "ko" {
				t.script = "kore"
			} else if t.language == "zh" {
				t.script = (t.region := "tw" || "hk" || "mo") ?? ("hant", "hans")
			}
		}
		return t
	}

	// How far a face designed for `tags` is from the wanted language: 0 for
	// the same language or script and region ("ja" for "ja", zh-HK for
	// zh-HK), more for the same script or language with another region
	// (zh-Hant for zh-TW), more again when the face names a different
	// region, most for none of them.
	internal def languagePenalty(tags string[], wanted LanguageTag) int {
		let best = 90000
		for let (_, tag) in tags {
			let t = parseTag(tag)
			let sameLanguage = t.language != "" && t.language == wanted.language
			let sameScript = t.script != "" && t.script == wanted.script
			let compatible = (sameScript && (t.language == "" || sameLanguage)) || (sameLanguage && (t.script == "" || wanted.script == ""))
			continue unless compatible
			if t.region == wanted.region {
				best = 0
			} else {
				best = best.min(t.region == "" ?? (30000, 35000))
			}
		}
		return best
	}

	// The design languages a `meta` table lists (`dlng`, comma-separated
	// ScriptLangTags), lower-cased; none when the table holds none or is
	// malformed.
	internal def designLanguages(table byte[]) string[] {
		let out string[]
		return out when table.len() < 16
		let count = u32(table, 12)
		for let i = 0; i < count; i++ {
			let at = 16 + i * 12
			break when at + 12 > table.len()
			continue unless string(table[at:at + 4]) == "dlng"
			let offset = u32(table, at + 4)
			let length = u32(table, at + 8)
			break when offset + length > table.len()
			for let (_, tag) in string(table[offset:offset + length]).split(",") {
				let t = tag.trim().lower()
				out.push(t) when t != ""
			}
		}
		return out
	}

	// The language a CJK family name declares by its last word: "Noto Sans
	// CJK JP", "Source Han Sans K", "Droid Sans Japanese".
	internal def familyLanguages(family string) string[] {
		let words = family.lower().split(" ")
		let last = words[words.len() - 1]
		return ["ja"] when last := "jp" || "japanese"
		return ["zh-hans"] when last := "sc" || "cn"
		return ["zh-hant"] when last := "tc" || "tw"
		return ["zh-hk"] when last := "hk" || "hc"
		return ["ko"] when last := "kr" || "korean"
		return ["ko"] when last == "k" && family.lower().contains("han")
		return string[]
	}

	// A minimal sfnt holding only `tables`, for the table readers.
	internal def syntheticFont(tables map<string, byte[]>) byte[] {
		let tags string[]
		let datas byte[][]
		for let (tag, t) in tables {
			tags.push(tag)
			datas.push(t)
		}
		// Directory entries sorted by tag, as the format asks.
		let order int[]
		for let i = 0; i < tags.len(); i++ {
			order.push(i)
		}
		order.sort((a int, b int) => tags[a] < tags[b])
		let size = 12 + tags.len() * 16
		for let (_, t) in datas {
			size += (t.len() + 3) / 4 * 4
		}
		let out byte[]
		out.len(size)
		out.fill(0)
		putU32(out, 0, 0x00010000)
		out[4] = byte(tags.len() >> 8)
		out[5] = byte(tags.len() & 0xFF)
		let at = 12 + tags.len() * 16
		for let (k, i) in order {
			let rec = 12 + k * 16
			let t = datas[i]
			let name = byte[](tags[i])
			for let b = 0; b < 4; b++ {
				out[rec + b] = name[b]
			}
			putU32(out, rec + 8, at)
			putU32(out, rec + 12, t.len())
			for let b = 0; b < t.len(); b++ {
				out[at + b] = t[b]
			}
			at += (t.len() + 3) / 4 * 4
		}
		return out
	}

	internal def putU32(out byte[], at int, v int) {
		out[at] = byte(v >> 24 & 0xFF)
		out[at + 1] = byte(v >> 16 & 0xFF)
		out[at + 2] = byte(v >> 8 & 0xFF)
		out[at + 3] = byte(v & 0xFF)
	}

	internal def u32(b byte[], at int) int {
		return int(b[at]) << 24 | int(b[at + 1]) << 16 | int(b[at + 2]) << 8 | int(b[at + 3])
	}

	// The fonts installed on this computer, found in the platform's font
	// folders on first use and shared afterwards. Files that do not read as
	// fonts are skipped. What each file holds is cached on disk for every ADM
	// program of the user (~/.cache/adm/fonts on Linux), so only new or
	// changed files are read again.
	def systemFonts() FontSet {
		return installed.get()
	}

	// Builds the system set once.
	internal type SystemFonts {
		internal set   FontSet
		internal ready bool

		def new() {
			set = new FontSet()
		}

		atomic def get() FontSet {
			if !ready {
				ready = true
				let cache = fontCacheDir()
				indexFonts(set, systemFontDirs(), cache == "" ?? ("", cache + (__os__ == "windows" ?? ("\\", "/")) + "system.idx"))
			}
			return set
		}
	}

	internal let installed = new SystemFonts()
}
