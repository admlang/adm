@os("linux")
partial module std.formats.fonts {
	use std.services.runtime::(Runtime)

	// Where Linux keeps installed fonts: system-wide, then the user's own.
	internal def systemFontDirs() string[] {
		let dirs = ["/usr/share/fonts", "/usr/local/share/fonts"]
		let data = Runtime.getEnv("XDG_DATA_HOME")
		let home = Runtime.getEnv("HOME")
		if data is string {
			dirs.push(data + "/fonts")
		} else if home is string {
			dirs.push(home + "/.local/share/fonts")
		}
		dirs.push(home + "/.fonts") when home is string
		return dirs
	}

	// Where the system font index is cached, shared by every ADM program of
	// the user: $XDG_CACHE_HOME/adm/fonts, else ~/.cache/adm/fonts. Empty
	// when neither is known.
	internal def fontCacheDir() string {
		let cache = Runtime.getEnv("XDG_CACHE_HOME")
		return cache + "/adm/fonts" when cache is string && cache != ""
		let home = Runtime.getEnv("HOME")
		return home + "/.cache/adm/fonts" when home is string && home != ""
		return ""
	}

	// The faces a generic family stands for here, best first; empty for a
	// name that is not generic.
	internal def genericFamilies(name string) string[] {
		match name {
			case "sans-serif", "system-ui":
				return ["noto sans", "dejavu sans", "liberation sans", "cantarell", "open sans", "arial", "helvetica"]
			case "serif":
				return ["noto serif", "dejavu serif", "liberation serif", "times new roman", "times"]
			case "monospace":
				return ["noto sans mono", "dejavu sans mono", "liberation mono", "source code pro", "courier new"]
			case "cursive":
				return ["comic neue", "comic sans ms", "noto serif"]
			case "fantasy":
				return ["impact", "noto sans"]
			case "emoji":
				return ["noto color emoji", "twemoji", "emoji one"]
		}
		return string[]
	}
}
