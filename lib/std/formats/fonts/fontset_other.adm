@os("darwin")
@os("windows")
partial module std.formats.fonts {
	use std.services.runtime::(Runtime)

	// Where macOS and Windows keep installed fonts.
	internal def systemFontDirs() string[] {
		let home = Runtime.getEnv("HOME")
		let local = Runtime.getEnv("LOCALAPPDATA")
		let windir = Runtime.getEnv("WINDIR")
		let dirs string[]
		if windir is string || local is string {
			dirs.push((windir is string ?? (windir, "C:\\Windows")) + "\\Fonts")
			dirs.push(local + "\\Microsoft\\Windows\\Fonts") when local is string
			return dirs
		}
		dirs = ["/System/Library/Fonts", "/Library/Fonts"]
		dirs.push(home + "/Library/Fonts") when home is string
		return dirs
	}

	// Where the system font index is cached, shared by every ADM program of
	// the user: %LOCALAPPDATA%\adm\cache\fonts on Windows,
	// ~/Library/Caches/adm/fonts on macOS. Empty when neither is known.
	internal def fontCacheDir() string {
		let local = Runtime.getEnv("LOCALAPPDATA")
		return local + "\\adm\\cache\\fonts" when local is string && local != ""
		let home = Runtime.getEnv("HOME")
		return home + "/Library/Caches/adm/fonts" when home is string && home != ""
		return ""
	}

	// The faces a generic family stands for here, best first; empty for a
	// name that is not generic.
	internal def genericFamilies(name string) string[] {
		match name {
			case "sans-serif":
				return ["helvetica neue", "helvetica", "arial", "segoe ui"]
			case "system-ui":
				return ["sf pro", "sf pro text", ".sf ns", "segoe ui", "helvetica neue"]
			case "serif":
				return ["times new roman", "times", "georgia"]
			case "monospace":
				return ["sf mono", "menlo", "consolas", "courier new"]
			case "cursive":
				return ["apple chancery", "comic sans ms"]
			case "fantasy":
				return ["papyrus", "impact"]
			case "emoji":
				return ["apple color emoji", "segoe ui emoji"]
		}
		return string[]
	}
}
