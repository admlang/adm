partial module std.formats.fonts {
	use (
		std.testing
		std.os
		std.services::(Application)
	)

	check "Font sets" {
		def sampleSet() !FontSet {
			let set = new FontSet()
			try set.add("samples/fonts/ttf/SourceSansPro-Black.ttf")
			try set.add("samples/fonts/ttf/ProximaNova-Bold.ttf")
			try set.add("samples/fonts/otf/SourceCodePro-Subset.otf")
			try set.add("samples/fonts/ttf/aat-kerx0.ttf")
			return set
		}

		def familyOf(f ?Face) string {
			return "none" when f is none
			return f.info().family
		}

		@test()
		def findsFacesByFamilyAndStyle() !none {
			let set = try sampleSet()
			assert set.families().len() == 4 // one family per file
			assert familyOf(set.find("Proxima Nova")) == "Proxima Nova" // by the typographic family name
			assert familyOf(set.find("proximanova-bold")) == "Proxima Nova" // or the legacy one, any case
			assert familyOf(set.find(["Missing Sans", "Source Sans Pro"])) == "Source Sans Pro" // first family the set has
			assert set.find("Missing Sans") is none // nothing to match
			assert familyOf(set.find("Source Sans Pro", 300)) == "Source Sans Pro" // the only weight serves any request
		}

		@test()
		def rejectsFilesThatAreNotFonts() {
			let set = new FontSet()
			assert set.add("samples/fonts/fon/Bm437_ATI_8x14.FON") is error // not an sfnt font
			assert set.add("samples/fonts/missing.ttf") is error // no such file
		}

		@test()
		def splitsTextByTheFaceThatHasIt() !none {
			let set = try sampleSet()
			// The AAT test face has only Latin letters: digits fall back.
			let letters = try (try load("samples/fonts/ttf/aat-kerx0.ttf")).face(0)
			let runs = set.faceRuns("AB 12 CD", [letters])
			assert runs.len() == 3 // letters, digits, letters
			assert runs[0].start == 0 && runs[0].end == 3 && runs[0].face == letters // "AB " stays with the first face
			assert runs[1].start == 3 && runs[1].end == 6 && runs[1].face.info().family != "AatTest" // "12 " from the set
			assert runs[2].start == 6 && runs[2].end == 8 && runs[2].face == letters // back to the first face
			assert set.faceRuns("", [letters]).len() == 0 // nothing to split
			assert familyOf(set.fallback('7', letters)) != "none" // a face of the set has digits
			assert set.fallback(char(0x4E16), letters) is none // none has ideographs
		}

		@test()
		def fallsBackByLanguage() !none {
			let set = new FontSet()
			for let (_, name) in ["NotoSansCJKJP", "NotoSansCJKSC", "NotoSansCJKKR", "MetaHanTest"] {
				try set.add("samples/fonts/ttf/cjk/{name}-4E16.otf")
			}
			try set.add("samples/fonts/ttf/cjk/DroidSansFallback-4E16.ttf")
			let letters = try (try load("samples/fonts/ttf/aat-kerx0.ttf")).face(0)
			let ideograph = char(0x4E16)
			assert familyOf(set.fallback(ideograph, letters, "ja")) == "Noto Sans CJK JP" // the family name says JP
			assert familyOf(set.fallback(ideograph, letters, "ko-KR")) == "Noto Sans CJK KR"
			assert familyOf(set.fallback(ideograph, letters, "zh")) == "Noto Sans CJK SC" // Chinese is Simplified unless the region says otherwise
			assert familyOf(set.fallback(ideograph, letters, "zh-TW")) == "Meta Han Test" // its meta table says Hant
			assert familyOf(set.fallback(ideograph, letters, "zh-Hant-HK")) == "Meta Han Test"
			assert familyOf(set.fallback(ideograph, letters, "en")) == familyOf(set.fallback(ideograph, letters)) // no face for the language: style decides
			assert familyOf(set.faceRuns("A\u4E16", [letters], "ja")[1].face) == "Noto Sans CJK JP"
		}

		@test()
		def cachesTheIndexOnDisk() !none {
			let cache = (try Application.home()) + "/fonts-test.idx"
			os.remove(cache) onerror recover none
			let first = new FontSet()
			indexFonts(first, ["samples/fonts/ttf/cjk"], cache)
			assert try os.exists(cache) // written after a scan
			let stored = readFontIndex(cache)
			assert stored.len() == 5 // the four OTFs and Droid Sans Fallback
			let written = (try os.stat(cache)).modTime.unixNs()
			let second = new FontSet()
			indexFonts(second, ["samples/fonts/ttf/cjk"], cache)
			assert (try os.stat(cache)).modTime.unixNs() == written // nothing changed, nothing rewritten
			assert second.families().len() == 5 // same faces, read from the index
			let ideograph = char(0x4E16)
			assert familyOf(second.fallback(ideograph, none, "ja")) == "Noto Sans CJK JP" // languages survive the round trip
			assert familyOf(second.fallback(ideograph, none, "zh-TW")) == "Meta Han Test"
			try os.writeFile(cache, byte[]("ADMFIDX1\x00\x00\x00\x09")) // a count past the end
			assert readFontIndex(cache).len() == 0 // a broken index reads as none
			os.remove(cache) onerror recover none
		}

		@test()
		def sendsEmojiToColourFaces() !none {
			let set = new FontSet()
			try set.add("samples/fonts/ttf/SourceSansPro-Black.ttf")
			try set.add("samples/fonts/ttf/color/NotoColorEmoji.subset.multiple_size_tables.ttf")
			let letters = try (try load("samples/fonts/ttf/aat-kerx0.ttf")).face(0)
			// U+2049 is pictographic but text by default (not Emoji_Presentation).
			assert set.faceRuns("A\u2049", [letters])[1].face.info().family == "Source Sans Pro" // text style
			assert set.faceRuns("A\u2049\uFE0F", [letters])[1].face.info().family != "Source Sans Pro" // the emoji selector picks colour
			assert set.faceRuns("A\u2049\uFE0E", [letters])[1].face.info().family == "Source Sans Pro" // the text selector keeps text
		}

		@test()
		def scansInstalledFonts() {
			let here = systemFonts()
			assert here == systemFonts() // scanned once, shared
			// Only when this computer has fonts at all.
			if here.families().len() > 0 {
				assert !(here.find(["sans-serif", "serif", "monospace"]) is none) // some generic family resolves
			}
		}
	}
}
