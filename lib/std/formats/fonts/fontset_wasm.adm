@os("wasm")
partial module std.formats.fonts {
	// The fonts a web build carries (the page's loader puts them here): a web
	// page cannot read the fonts installed on the machine.
	internal def systemFontDirs() string[] {
		return ["/usr/share/fonts"]
	}

	// None: the page's fonts are few and indexed afresh.
	internal def fontCacheDir() string {
		return ""
	}

	// The faces a generic family stands for on the web: the ones a web build
	// carries, Noto Sans and Noto Sans Mono; empty for a name that is not
	// generic or has none.
	internal def genericFamilies(name string) string[] {
		match name {
			case "sans-serif", "system-ui", "serif", "cursive", "fantasy":
				return ["noto sans"]
			case "monospace":
				return ["noto sans mono"]
		}
		return string[]
	}
}
