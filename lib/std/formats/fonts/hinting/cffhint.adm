// CFF hinting: stem hints and blue zones fitted to the pixel grid along y,
// the way Adobe's CFF rasterizer (as FreeType carries it) does, including
// its fixed-point charstring interpreter so points come out identical.

internal partial module std.formats.fonts.hinting {
	use (
		std.math.geom
		std.formats.fonts
		std.formats.fonts.cff
	)

	// Hint edge flags.
	const (
		hintGhostBottom = 0x01
		hintPairBottom  = 0x02
		hintGhostTop    = 0x04
		hintPairTop     = 0x08
		hintLocked      = 0x10
		hintSynthetic   = 0x20
	)

	const (
		cf2MaxHints   = 96
		cf2MinCounter = 0x8000
		cf2IcfTop     = 880 << 16
		cf2IcfBottom  = -120 << 16
		cf2MaxSubr    = 16
	)

	def fixedRound(x int) int {
		return int32(((x & 0xFFFFFFFF) + 0x8000) & 0xFFFF0000)
	}

	def fixedFloor(x int) int {
		return int32((x & 0xFFFFFFFF) & 0xFFFF0000)
	}

	// Private DICT values the hinter reads, as the reference parses them.
	type CffPrivate {
		blueValues       int[]
		otherBlues       int[]
		familyBlues      int[]
		familyOtherBlues int[]
		// BlueScale times 1000, 16.16.
		blueScale     int
		blueShift     int
		blueFuzz      int
		stdHW         int
		stdVW         int
		languageGroup int
		defaultWidth  int
		nominalWidth  int
		vsindex       int

		// `regions` holds the CFF2 region count per vsindex and `bv` the blend
		// vector per vsindex, for `blend`.
		def new(dict byte[], regions int[] = [], bv int[][] = int[][]) {
			// A Font DICT without a Private DICT keeps every value zero.
			return when dict.len() == 0
			blueScale = 2596864
			blueShift = 7
			blueFuzz = 1
			parse(new Bytes(dict), regions, bv)
			blueValues.len(blueValues.len() & ~1)
			blueShift = 7 when blueShift > 1000 || blueShift < 0
			blueFuzz = 1 when blueFuzz > 1000 || blueFuzz < 0
		}

		internal def parse(d Bytes, regions int[], bv int[][]) {
			let stack byte[][]
			let at = 0
			for at < d.len() {
				let b = d.u8(at)
				if b >= 32 || b == 28 || b == 29 || b == 30 || b == 255 {
					let n = operandLength(d, at)
					stack.push(d.slice(at, at + n))
					at += n
					continue
				}
				let op = b
				at++
				if b == 12 {
					op = 1200 + d.u8(at)
					at++
				}
				if op == 23 {
					blend(stack, regions, bv)
					continue
				}
				apply(op, stack)
				stack = byte[][]
			}
		}

		// CFF2 `blend`: each value plus its deltas weighed by the blend
		// vector (none off the default instance), re-encoded as a 16.16
		// operand.
		internal def blend(stack byte[][], regions int[], bv int[][]) {
			return when stack.len() == 0 || vsindex < 0 || vsindex >= regions.len()
			let numBlends = cffNum(new Bytes(stack[stack.len() - 1]), 0)
			let lenBV = regions[vsindex] + 1
			let count = stack.len() - 1
			let numOperands = numBlends * lenBV
			return when numBlends < 0 || numOperands > count
			let base = count - numOperands
			let weights = vsindex < bv.len() ?? (bv[vsindex], int[])
			let delta = base + numBlends
			for let i = 0; i < numBlends; i++ {
				let sum = cffFixed(new Bytes(stack[base + i]), 0, 0)
				for let j = 1; j < lenBV; j++ {
					let w = j < weights.len() ?? (weights[j], 0)
					sum += mulFix(cffFixed(new Bytes(stack[delta]), 0, 0), w)
					delta++
				}
				sum = sum & 0xFFFFFFFF
				let e byte[]
				e.push(byte(255))
				e.push(byte(sum >> 24))
				e.push(byte((sum >> 16) & 0xFF))
				e.push(byte((sum >> 8) & 0xFF))
				e.push(byte(sum & 0xFF))
				stack[base + i] = e
			}
			stack.len(base + numBlends)
		}

		internal def apply(op int, stack byte[][]) {
			let first = stack.len() > 0 ?? (new Bytes(stack[0]), new Bytes())
			let has = stack.len() > 0
			match op {
				case 6:
					blueValues = deltaFixed(stack, 14)
				case 7:
					otherBlues = deltaFixed(stack, 10)
				case 8:
					familyBlues = deltaFixed(stack, 14)
				case 9:
					familyOtherBlues = deltaFixed(stack, 10)
				case 10:
					stdHW = cffNum(first, 0) when has
				case 11:
					stdVW = cffNum(first, 0) when has
				case 22:
					vsindex = cffNum(first, 0) when has
				case 1209:
					blueScale = cffFixed(first, 0, 3) when has
				case 1210:
					blueShift = cffNum(first, 0) when has
				case 1211:
					blueFuzz = cffNum(first, 0) when has
				case 1217:
					languageGroup = cffNum(first, 0) when has
				case 20:
					defaultWidth = cffNum(first, 0) when has
				case 21:
					nominalWidth = cffNum(first, 0) when has
			}
		}

		internal def deltaFixed(stack byte[][], max int) int[] {
			let out int[]
			let v = 0
			for let i = 0; i < stack.len() && i < max; i++ {
				v += cffFixed(new Bytes(stack[i]), 0, 0)
				out.push(v)
			}
			return out
		}
	}

	internal def operandLength(d Bytes, at int) int {
		let b = d.u8(at)
		return 3 when b == 28
		return 5 when b == 29 || b == 255
		if b == 30 {
			let i = at + 1
			for i < d.len() {
				let x = d.u8(i)
				i++
				break when x & 0x0F == 0x0F || x >> 4 == 0x0F
			}
			return i - at
		}
		return 2 when b >= 247 && b <= 254
		return 1
	}

	internal def cffInteger(d Bytes, at int) int {
		let v = d.u8(at)
		return d.i16(at + 1) when v == 28
		return int32(d.u32(at + 1)) when v == 29
		return v - 139 when v < 247
		return (v - 247) * 256 + d.u8(at + 1) + 108 when v < 251
		return -(v - 251) * 256 - d.u8(at + 1) - 108
	}

	let powerTens = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000]
	let powerTenLimits = [0x7FFFFFFF, 0x7FFFFFFF / 10, 0x7FFFFFFF / 100, 0x7FFFFFFF / 1000, 0x7FFFFFFF / 10000, 0x7FFFFFFF / 100000, 0x7FFFFFFF / 1000000, 0x7FFFFFFF / 10000000, 0x7FFFFFFF / 100000000, 0x7FFFFFFF / 1000000000]

	// A DICT real (operator 30) as 16.16 times 10^powerTen.
	internal def cffReal(d Bytes, start int, powerTen int) int {
		let p = start
		let phase = 4
		let number = 0
		let exponent = 0
		let exponentAdd = 0
		let integerLength = 0
		let fractionLength = 0
		let sign = false
		let exponentSign = false
		let overflow = false
		let nib = 0
		for {
			if phase != 0 {
				p++
			}
			nib = (d.u8(p) >> phase) & 0xF
			phase = 4 - phase
			if nib == 0xE {
				sign = true
			} else if nib > 9 {
				break
			} else if number >= 0xCCCCCCC {
				exponentAdd++
			} else if nib != 0 || number != 0 {
				integerLength++
				number = number * 10 + nib
			}
			return 0 when p >= d.len()
		}
		if nib == 0xA {
			for {
				if phase != 0 {
					p++
				}
				nib = (d.u8(p) >> phase) & 0xF
				phase = 4 - phase
				break when nib >= 10
				if nib == 0 && number == 0 {
					exponentAdd--
				} else if number < 0xCCCCCCC && fractionLength < 9 {
					fractionLength++
					number = number * 10 + nib
				}
				return 0 when p >= d.len()
			}
		}
		if nib == 12 {
			exponentSign = true
			nib = 11
		}
		if nib == 11 {
			for {
				if phase != 0 {
					p++
				}
				nib = (d.u8(p) >> phase) & 0xF
				phase = 4 - phase
				break when nib >= 10
				if exponent > 1000 {
					overflow = true
				} else {
					exponent = exponent * 10 + nib
				}
				return 0 when p >= d.len()
			}
			exponent = -exponent when exponentSign
		}
		return 0 when number == 0
		if overflow {
			return exponentSign ?? (0, sign ?? (-0x7FFFFFFF, 0x7FFFFFFF))
		}
		exponent += powerTen + exponentAdd
		integerLength += exponent
		fractionLength -= exponent
		if integerLength > 5 {
			return sign ?? (-0x7FFFFFFF, 0x7FFFFFFF)
		}
		return 0 when integerLength < -5
		if integerLength < 0 {
			number /= powerTens[-integerLength]
			fractionLength += integerLength
		}
		if fractionLength == 10 {
			number /= 10
			fractionLength--
		}
		let result = 0
		if fractionLength > 0 {
			return 0 when number / powerTens[fractionLength] > 0x7FFF
			result = divFix(number, powerTens[fractionLength])
		} else {
			number *= powerTens[-fractionLength]
			if number > 0x7FFF {
				return sign ?? (-0x7FFFFFFF, 0x7FFFFFFF)
			}
			result = number << 16
		}
		return sign ?? (-result, result)
	}

	// A DICT number as 16.16 times 10^scaling.
	internal def cffFixed(d Bytes, at int, scaling int) int {
		let b = d.u8(at)
		return cffReal(d, at, scaling) when b == 30
		if b == 255 {
			let v = int32(d.u32(at + 1))
			if scaling != 0 {
				return v > 0 ?? (0x7FFFFFFF, -0x7FFFFFFF) when v.abs() > powerTenLimits[scaling]
				v *= powerTens[scaling]
			}
			return v
		}
		let v = cffInteger(d, at)
		if scaling != 0 {
			if (v.abs() << 16) > powerTenLimits[scaling] {
				return v > 0 ?? (0x7FFFFFFF, -0x7FFFFFFF)
			}
			v *= powerTens[scaling]
		}
		return 0x7FFFFFFF when v > 0x7FFF
		return -0x7FFFFFFF when v < -0x7FFF
		return v << 16
	}

	// A DICT number as an integer.
	internal def cffNum(d Bytes, at int) int {
		let b = d.u8(at)
		return cffReal(d, at, 0) >> 16 when b == 30
		if b == 255 {
			let v = ((d.u8(at + 1) << 16 | d.u8(at + 2) << 8 | d.u8(at + 3)) + 0x80) >> 8
			let s = v & 0xFFFF
			return s >= 0x8000 ?? (s - 0x10000, s)
		}
		return cffInteger(d, at)
	}

	// One zone: bottom and top edges, the flat edge and its device position.
	type BlueZone {
		csBottomEdge int
		csTopEdge    int
		csFlatEdge   int
		dsFlatEdge   int
		bottomZone   bool

		def new() {}
	}

	// One edge of a stem hint, in character space (csCoord) and device
	// space (dsCoord).
	type HintEdge {
		csCoord int
		dsCoord int
		scale   int
		flags   int
		index   int

		def new() {}

		def copy() HintEdge {
			let h = new HintEdge()
			h.csCoord = csCoord
			h.dsCoord = dsCoord
			h.scale = scale
			h.flags = flags
			h.index = index
			return h
		}

		def isValid() bool {
			return flags != 0
		}

		def isPair() bool {
			return flags & (hintPairBottom | hintPairTop) != 0
		}

		def isPairTop() bool {
			return flags & hintPairTop != 0
		}

		def isTop() bool {
			return flags & (hintPairTop | hintGhostTop) != 0
		}

		def isBottom() bool {
			return flags & (hintPairBottom | hintGhostBottom) != 0
		}

		def isLocked() bool {
			return flags & hintLocked != 0
		}

		def isSynthetic() bool {
			return flags & hintSynthetic != 0
		}
	}

	// The blue zones of one Font DICT at one scale.
	type Blues {
		scale       int
		blueScale   int
		blueShift   int
		blueFuzz    int
		zones       BlueZone[]
		suppressOvershoot bool
		boost       int
		doEmBoxHints bool
		emBoxBottom HintEdge
		emBoxTop    HintEdge

		def new(priv CffPrivate, scale int) {
			self.scale = scale
			emBoxBottom = new HintEdge()
			emBoxTop = new HintEdge()
			blueScale = divFix(priv.blueScale, 1000 << 16)
			blueShift = priv.blueShift << 16
			blueFuzz = priv.blueFuzz << 16
			let bv = priv.blueValues
			if priv.languageGroup == 1 && (bv.len() == 0 || (bv.len() == 4 && bv[0] < cf2IcfBottom && bv[1] < cf2IcfBottom && bv[2] > cf2IcfTop && bv[3] > cf2IcfTop)) {
				emBoxBottom.csCoord = cf2IcfBottom - 1
				emBoxBottom.dsCoord = fixedRound(mulFix(emBoxBottom.csCoord, scale)) - cf2MinCounter
				emBoxBottom.scale = scale
				emBoxBottom.flags = hintGhostBottom | hintLocked | hintSynthetic
				emBoxTop.csCoord = cf2IcfTop + 1
				emBoxTop.dsCoord = fixedRound(mulFix(emBoxTop.csCoord, scale)) + cf2MinCounter
				emBoxTop.scale = scale
				emBoxTop.flags = hintGhostTop | hintLocked | hintSynthetic
				doEmBoxHints = true
				return
			}
			let maxZoneHeight = 0
			for let i = 0; i + 1 < bv.len(); i += 2 {
				let z = new BlueZone()
				z.csBottomEdge = bv[i]
				z.csTopEdge = bv[i + 1]
				let h = z.csTopEdge - z.csBottomEdge
				continue when h < 0
				maxZoneHeight = h when h > maxZoneHeight
				z.bottomZone = i == 0
				z.csFlatEdge = i == 0 ?? (z.csTopEdge, z.csBottomEdge)
				zones.push(z)
			}
			let ob = priv.otherBlues
			for let i = 0; i + 1 < ob.len(); i += 2 {
				let z = new BlueZone()
				z.csBottomEdge = ob[i]
				z.csTopEdge = ob[i + 1]
				let h = z.csTopEdge - z.csBottomEdge
				continue when h < 0
				maxZoneHeight = h when h > maxZoneHeight
				z.bottomZone = true
				z.csFlatEdge = z.csTopEdge
				zones.push(z)
			}
			// Snap to FamilyBlues edges less than a pixel away.
			let csUnitsPerPixel = divFix(1 << 16, scale)
			let fb = priv.familyBlues
			let fob = priv.familyOtherBlues
			for let (_, z) in zones {
				let flat = z.csFlatEdge
				if z.bottomZone {
					let minDiff = 0x7FFFFFFF
					for let j = 0; j + 1 < fob.len(); j += 2 {
						let e = fob[j + 1]
						let diff = (flat - e).abs()
						if diff < minDiff && diff < csUnitsPerPixel {
							z.csFlatEdge = e
							minDiff = diff
							break when diff == 0
						}
					}
					if fb.len() >= 2 {
						let e = fb[1]
						let diff = (flat - e).abs()
						z.csFlatEdge = e when diff < minDiff && diff < csUnitsPerPixel
					}
				} else {
					let minDiff = 0x7FFFFFFF
					for let j = 2; j + 1 < fb.len(); j += 2 {
						let e = fb[j]
						let diff = (flat - e).abs()
						if diff < minDiff && diff < csUnitsPerPixel {
							z.csFlatEdge = e
							minDiff = diff
							break when diff == 0
						}
					}
				}
			}
			if maxZoneHeight > 0 && blueScale > divFix(1 << 16, maxZoneHeight) {
				blueScale = divFix(1 << 16, maxZoneHeight)
			}
			if scale < blueScale {
				suppressOvershoot = true
				// 0.6 in 16.16, rounded as the reference does.
				boost = 39322 - mulDiv(39322, scale, blueScale)
				boost = 0x7FFF when boost > 0x7FFF
			}
			for let (_, z) in zones {
				if z.bottomZone {
					z.dsFlatEdge = fixedRound(mulFix(z.csFlatEdge, scale) - boost)
				} else {
					z.dsFlatEdge = fixedRound(mulFix(z.csFlatEdge, scale) + boost)
				}
			}
		}

		// Snaps a stem whose edge falls in a zone; returns whether it did.
		def capture(bottom HintEdge, top HintEdge) bool {
			let fuzz = blueFuzz
			let dsMove = 0
			let captured = false
			for let (_, z) in zones {
				if z.bottomZone && bottom.isBottom() {
					if z.csBottomEdge - fuzz <= bottom.csCoord && bottom.csCoord <= z.csTopEdge + fuzz {
						let dsNew = 0
						if suppressOvershoot {
							dsNew = z.dsFlatEdge
						} else if z.csTopEdge - bottom.csCoord >= blueShift {
							dsNew = fixedRound(bottom.dsCoord).min(z.dsFlatEdge - (1 << 16))
						} else {
							dsNew = fixedRound(bottom.dsCoord)
						}
						dsMove = dsNew - bottom.dsCoord
						captured = true
						break
					}
				}
				if !z.bottomZone && top.isTop() {
					if z.csBottomEdge - fuzz <= top.csCoord && top.csCoord <= z.csTopEdge + fuzz {
						let dsNew = 0
						if suppressOvershoot {
							dsNew = z.dsFlatEdge
						} else if top.csCoord - z.csBottomEdge >= blueShift {
							dsNew = fixedRound(top.dsCoord).max(z.dsFlatEdge + (1 << 16))
						} else {
							dsNew = fixedRound(top.dsCoord)
						}
						dsMove = dsNew - top.dsCoord
						captured = true
						break
					}
				}
			}
			if captured {
				if bottom.isValid() {
					bottom.dsCoord += dsMove
					bottom.flags |= hintLocked
				}
				if top.isValid() {
					top.dsCoord += dsMove
					top.flags |= hintLocked
				}
			}
			return captured
		}
	}

	// A stem hint from the charstring, and where it landed once used.
	type StemHint {
		used  bool
		min   int
		max   int
		minDS int
		maxDS int

		def new(min int, max int) {
			self.min = min
			self.max = max
		}
	}

	// Which stem hints are active.
	type HintMask {
		isValid  bool
		isNew    bool
		bitCount int
		mask     int[]

		def new() {
			mask.len((cf2MaxHints + 7) / 8)
			mask.fill(0)
		}

		def copy() HintMask {
			let m = new HintMask()
			m.isValid = isValid
			m.isNew = isNew
			m.bitCount = bitCount
			m.mask = mask.clone()
			return m
		}

		def setCounts(n int) bool {
			return false when n > cf2MaxHints
			bitCount = n
			isValid = true
			isNew = true
			return true
		}

		def setAll(n int) {
			return when !setCounts(n)
			let bytes = (n + 7) / 8
			for let i = 0; i < bytes; i++ {
				mask[i] = 0xFF
			}
			let unused = (1 << (-n & 7)) - 1
			mask[bytes - 1] &= ~unused & 0xFF when bytes > 0
		}
	}

	// A piecewise-linear map from character to device space along y, built
	// from the active stem hints.
	type HintMap {
		hinted  bool
		scale   int
		isValid bool
		lastIndex int
		edges   HintEdge[]

		def new(hinted bool, scale int) {
			self.hinted = hinted
			self.scale = scale
		}

		def copy() HintMap {
			let m = new HintMap(hinted, scale)
			m.isValid = isValid
			m.lastIndex = lastIndex
			for let (_, e) in edges {
				m.edges.push(e.copy())
			}
			return m
		}

		def map(cs int) int {
			let n = edges.len()
			if n == 0 || !hinted {
				return mulFix(cs, scale)
			}
			let i = lastIndex
			for i < n - 1 && cs >= edges[i + 1].csCoord {
				i++
			}
			for i > 0 && cs < edges[i].csCoord {
				i--
			}
			lastIndex = i
			if i == 0 && cs < edges[0].csCoord {
				return mulFix(cs - edges[0].csCoord, scale) + edges[0].dsCoord
			}
			return mulFix(cs - edges[i].csCoord, edges[i].scale) + edges[i].dsCoord
		}

		// Nudges edges to whole pixels without overlapping neighbours.
		def adjust() {
			let movesJ int[]
			let movesUp int[]
			let i = 0
			for i < edges.len() {
				let isPair = edges[i].isPair()
				let j = isPair ?? (i + 1, i)
				let dsI = edges[i].dsCoord
				let dsJ = edges[j].dsCoord
				if !edges[i].isLocked() {
					let fracDown = dsI - fixedFloor(dsI)
					let fracUp = dsJ - fixedFloor(dsJ)
					let downMoveDown = -fracDown
					let upMoveDown = -fracUp
					let downMoveUp = fracDown == 0 ?? (0, (1 << 16) - fracDown)
					let upMoveUp = fracUp == 0 ?? (0, (1 << 16) - fracUp)
					let moveUp = downMoveUp.min(upMoveUp)
					let moveDown = downMoveDown.max(upMoveDown)
					let move = 0
					let saveEdge = false
					if j >= edges.len() - 1 || edges[j + 1].dsCoord >= dsJ + moveUp + cf2MinCounter {
						if i == 0 || edges[i - 1].dsCoord <= dsI + moveDown - cf2MinCounter {
							move = -moveDown < moveUp ?? (moveDown, moveUp)
						} else {
							move = moveUp
						}
					} else {
						if i == 0 || edges[i - 1].dsCoord <= dsI + moveDown - cf2MinCounter {
							move = moveDown
							saveEdge = moveUp < -moveDown
						} else {
							move = 0
							saveEdge = true
						}
					}
					if saveEdge && j < edges.len() - 1 && !edges[j + 1].isLocked() {
						movesJ.push(j)
						movesUp.push(moveUp - move)
					}
					edges[i].dsCoord = dsI + move
					edges[j].dsCoord = dsJ + move when isPair
				}
				if i > 0 && edges[i].csCoord != edges[i - 1].csCoord {
					edges[i - 1].scale = divFix(edges[i].dsCoord - edges[i - 1].dsCoord, edges[i].csCoord - edges[i - 1].csCoord)
				}
				if isPair {
					if edges[j].csCoord != edges[j - 1].csCoord {
						edges[j - 1].scale = divFix(edges[j].dsCoord - edges[j - 1].dsCoord, edges[j].csCoord - edges[j - 1].csCoord)
					}
					i++
				}
				i++
			}
			for let k = movesJ.len() - 1; k >= 0; k-- {
				let j = movesJ[k]
				if edges[j + 1].dsCoord >= edges[j].dsCoord + movesUp[k] + cf2MinCounter {
					edges[j].dsCoord += movesUp[k]
					edges[j - 1].dsCoord += movesUp[k] when edges[j].isPair()
				}
			}
		}

		// Inserts one hint (a pair, or a single ghost edge) in csCoord order.
		def insert(bottom HintEdge, top HintEdge, initial HintMap) {
			let isPair = true
			let first = bottom
			let second = top
			if !bottom.isValid() {
				first = top
				isPair = false
			} else if !top.isValid() {
				isPair = false
			}
			return when isPair && top.csCoord < bottom.csCoord
			let at = 0
			for at < edges.len() && edges[at].csCoord < first.csCoord {
				at++
			}
			if at < edges.len() {
				return when edges[at].csCoord == first.csCoord
				return when isPair && edges[at].csCoord <= second.csCoord
				return when edges[at].isPairTop()
			}
			if initial.isValid && !first.isLocked() {
				if isPair {
					let mid = initial.map(first.csCoord + (second.csCoord - first.csCoord) / 2)
					let half = mulFix((second.csCoord - first.csCoord) / 2, scale)
					first.dsCoord = mid - half
					second.dsCoord = mid + half
				} else {
					first.dsCoord = initial.map(first.csCoord)
				}
			}
			return when at > 0 && first.dsCoord < edges[at - 1].dsCoord
			if at < edges.len() {
				return when isPair && second.dsCoord > edges[at].dsCoord
				return when !isPair && first.dsCoord > edges[at].dsCoord
			}
			return when (isPair ?? (edges.len() + 1, edges.len())) >= cf2MaxHints * 2
			let tail HintEdge[]
			for let k = at; k < edges.len(); k++ {
				tail.push(edges[k])
			}
			edges.len(at)
			edges.push(first.copy())
			edges.push(second.copy()) when isPair
			for let (_, e) in tail {
				edges.push(e)
			}
		}
	}

	// Where a CFF glyph's points go, in 26.6 pixels, with contours opened and
	// closed by the reference outline builder's rules.
	type CffBuilder {
		xs        int[]
		ys        int[]
		on        bool[]
		contours  int[]
		pathBegun bool

		def new() {}

		def moveTo() {
			closeContour()
			pathBegun = false
		}

		def lineTo(x0 int, y0 int, x1 int, y1 int) {
			startPoint(x0, y0) unless pathBegun
			add(x1, y1, true)
		}

		def cubeTo(x0 int, y0 int, x1 int, y1 int, x2 int, y2 int, x3 int, y3 int) {
			startPoint(x0, y0) unless pathBegun
			add(x1, y1, false)
			add(x2, y2, false)
			add(x3, y3, true)
		}

		// Points arrive as 16.16.
		internal def add(x int, y int, onCurve bool) {
			xs.push(x >> 10)
			ys.push(y >> 10)
			on.push(onCurve)
		}

		internal def startPoint(x int, y int) {
			pathBegun = true
			let n = contours.len()
			contours[n - 1] = xs.len() - 1 when n > 0
			contours.push(-1)
			add(x, y, true)
		}

		internal def truncate(n int) {
			xs.len(n)
			ys.len(n)
			on.len(n)
		}

		// Ends the open contour: drops a last point that repeats the first and
		// a contour of one point.
		def closeContour() {
			let nc = contours.len()
			let np = xs.len()
			let first = nc <= 1 ?? (0, contours[nc - 2] + 1)
			if nc > 0 && first == np {
				contours.len(nc - 1)
				return
			}
			if np > 1 && xs[first] == xs[np - 1] && ys[first] == ys[np - 1] && on[np - 1] {
				np--
				truncate(np)
			}
			return when nc == 0
			if first == np - 1 {
				contours.len(nc - 1)
				truncate(np - 1)
			} else {
				contours[nc - 1] = np - 1
			}
		}
	}

	// A CFF font program prepared for hinting: its Private DICTs parsed once.
	type HintedCff {
		program   cff.Cff
		upem      int
		privates  CffPrivate[]
		random    int
		// The blend vector of each vsindex: 1 for the default master, then
		// each region's weight at the instance (all 0 at the default one).
		bv        int[][]
		variation ?FtVariation

		// `upem` is the face's units per em; `variation` the instance of a
		// variable face, none at the default instance.
		def new(program cff.Cff, upem int, variation ?FtVariation = none) {
			self.program = program
			self.upem = upem
			self.variation = variation
			random = 123456789
			let regions = program.regionCounts()
			let store = new FtItemStore(new Bytes(program.bytes()), program.variationStoreOffset(), variation is none ?? (0, variation.axisCount))
			for let vs = 0; vs < regions.len(); vs++ {
				let row = [0x10000]
				let indices = variation is none ?? (int[], store.regionIndices(vs))
				for let m = 0; m < regions[vs]; m++ {
					row.push(variation is none || m >= indices.len() ?? (0, store.regionScalar(indices[m], variation.coords)))
				}
				bv.push(row)
			}
			for let fd = 0; fd < program.fontDictCount(); fd++ {
				privates.push(new CffPrivate(program.privateDict(fd), regions, bv))
			}
			privates.push(new CffPrivate(byte[])) when privates.len() == 0
		}

		// Glyph `g`'s advance `base` (font units) at the instance: `HVAR`
		// adjusts it as FreeType does.
		def advance(g int, base int) int {
			let v = variation
			return base unless v is FtVariation
			return v.hvar.adjust(g, base, v.coords)
		}

		// The glyph at `charSize` (26.6 pixels per em), as the reference hints
		// it. Glyphs above 2000 pixels per em come out unhinted, scaled.
		// Fails when the charstring is malformed.
		def load(glyph int, charSize int) !CffBuilder {
			fail "size must be positive" when charSize <= 0
			fail "cff: units per em {upem} is out of range" when upem <= 0 || upem > 0x7FFF
			let xScale = divFix(charSize, upem)
			let scale = int32(xScale + 32) / 64
			let hinted = scale <= divFix(2000 << 16, upem << 16)
			let fd = program.fontDictOf(glyph)
			fd = 0 when fd >= privates.len()
			let run = new CffRun(self, fd, hinted ?? (scale, 0x400), hinted)
			let code = try program.charString(glyph)
			let call = new CffCall(run, code, 0)
			call.interpret(false, 0, 0)
			fail "cff: {run.err} in glyph {glyph}" when run.err != ""
			run.builder.closeContour()
			if !hinted {
				for let i = 0; i < run.builder.xs.len(); i++ {
					run.builder.xs[i] = mulFix(run.builder.xs[i], xScale)
					run.builder.ys[i] = mulFix(run.builder.ys[i], xScale)
				}
			}
			return run.builder
		}

		// The glyph at `size` pixels per em, hinted, in pixels (y up). `advance`
		// is its advance width in font units.
		// Fails when the size is not positive or the charstring is malformed.
		def outline(glyph int, size float, advance int) !fonts.Outline {
			let charSize = int((size * 64.0).round())
			let b = try load(glyph, charSize)
			let o = new fonts.Outline()
			o.advance = float(pixRound(mulFix(advance, divFix(charSize, upem)))) / 64.0
			let first = 0
			for let (_, last) in b.contours {
				emitContour(o.segments, b, first, last)
				first = last + 1
			}
			return o
		}

		// One contour of on-curve points and cubic control pairs as segments.
		internal def emitContour(segs fonts.Segment[], b CffBuilder, first int, last int) {
			return when last < first
			let pt = (i int) => geom.Point{x: float(b.xs[i]) / 64.0, y: float(b.ys[i]) / 64.0}
			segs.push(fonts.Segment{kind: fonts.SegmentKind.Move, to: pt(first)})
			let controls int[]
			for let i = first + 1; i <= last + 1; i++ {
				let at = i > last ?? (first, i)
				if !b.on[at] {
					controls.push(at)
					continue
				}
				if controls.len() >= 2 {
					segs.push(fonts.Segment{kind: fonts.SegmentKind.Cubic, to: pt(at), control1: pt(controls[0]), control2: pt(controls[1])})
				} else if at != first {
					segs.push(fonts.Segment{kind: fonts.SegmentKind.Line, to: pt(at)})
				}
				controls = int[]
			}
			segs.push(fonts.Segment{kind: fonts.SegmentKind.Close})
		}

		// The next value of the charstring `random` operator.
		def nextRandom() int {
			let r = (random & 0xFFFF) + 1
			let v = random & 0xFFFFFFFF
			v ^= (v << 13) & 0xFFFFFFFF
			v ^= v >> 17
			v ^= (v << 5) & 0xFFFFFFFF
			random = v
			return r
		}
	}

	// The state one glyph load shares across its seac components.
	type CffRun {
		face     HintedCff
		cff2     bool
		fd       int
		priv     CffPrivate
		blues    Blues
		scale    int
		hinted   bool
		builder  CffBuilder
		err      string
		vsindex  int
		usedBV   bool
		gbias    int
		lbias    int

		def new(face HintedCff, fd int, scale int, hinted bool) {
			self.face = face
			self.fd = fd
			self.scale = scale
			self.hinted = hinted
			cff2 = face.program.isCFF2()
			priv = face.privates[fd]
			blues = new Blues(priv, scale)
			builder = new CffBuilder()
			vsindex = cff2 ?? (face.program.vsIndex(fd), 0)
			gbias = cffSubrBias(face.program.globalSubrCount())
			lbias = cffSubrBias(face.program.localSubrCount(fd))
		}
	}

	def cffSubrBias(count int) int {
		return 107 when count < 1240
		return 1131 when count < 33900
		return 32768
	}

	// (x^0.5) of a 16.16 value, rounded up the reference's way.
	def sqrtFixed(v int) int {
		return 0 when v == 0
		let r = (v << 16) - 1
		let q = 1 << ((17 + msb(v)) >> 1)
		let t = 0
		for {
			t = q
			q = (t + r / t + 1) >> 1
			break when q == t
		}
		return q
	}

	// One charstring interpretation: the operand stack, stem hints, hint
	// mask and glyph path of a glyph or of one seac component.
	type CffCall {
		run      CffRun
		code     byte[]
		pos      int
		saved    byte[][]
		savedPos int[]
		vals     int[]
		ints     bool[]
		maxStack int
		storage  int[]
		hStems   StemHint[]
		vStems   StemHint[]
		mask     HintMask

		initialMap  HintMap
		firstMap    HintMap
		hintMap     HintMap
		hintOriginY int

		moveIsPending bool
		pathIsOpen    bool
		pathIsClosing bool
		elemIsQueued  bool
		prevIsCurve   bool
		curCSX        int
		curCSY        int
		curDSX        int
		curDSY        int
		startX        int
		startY        int
		offset0X      int
		offset0Y      int
		offset1X      int
		offset1Y      int
		prev0X        int
		prev0Y        int
		prev1X        int
		prev1Y        int
		prev2X        int
		prev2Y        int
		prev3X        int
		prev3Y        int

		def new(run CffRun, code byte[], hintOriginY int) {
			self.run = run
			self.code = code
			self.hintOriginY = hintOriginY
			maxStack = run.cff2 ?? (513, 48)
			storage.len(32)
			storage.fill(0)
			mask = new HintMask()
			initialMap = new HintMap(run.hinted, run.scale)
			firstMap = new HintMap(run.hinted, run.scale)
			hintMap = new HintMap(run.hinted, run.scale)
			moveIsPending = true
		}

		internal def fault(message string) {
			run.err = message when run.err == ""
		}

		// Operand stack: values are integers or 16.16, as pushed.

		internal def pushInt(v int) {
			if vals.len() >= maxStack {
				fault("operand stack overflow")
				return
			}
			vals.push(v)
			ints.push(true)
		}

		internal def pushFixed(v int) {
			if vals.len() >= maxStack {
				fault("operand stack overflow")
				return
			}
			vals.push(int32(v))
			ints.push(false)
		}

		internal def popInt() int {
			let n = vals.len()
			if n == 0 {
				fault("operand stack underflow")
				return 0
			}
			if !ints[n - 1] {
				fault("an integer operand is 16.16")
				return 0
			}
			let v = vals[n - 1]
			vals.len(n - 1)
			ints.len(n - 1)
			return v
		}

		internal def popFixed() int {
			let n = vals.len()
			if n == 0 {
				fault("operand stack underflow")
				return 0
			}
			let v = vals[n - 1]
			let isInt = ints[n - 1]
			vals.len(n - 1)
			ints.len(n - 1)
			return isInt ?? (int32(v << 16), v)
		}

		internal def real(i int) int {
			if i >= vals.len() {
				fault("operand index out of range")
				return 0
			}
			return ints[i] ?? (int32(vals[i] << 16), vals[i])
		}

		internal def setReal(i int, v int) {
			return when i >= vals.len()
			vals[i] = int32(v)
			ints[i] = false
		}

		internal def clearStack() {
			vals.len(0)
			ints.len(0)
		}

		// Rolls the bottom `count` entries by `shift`, as the reference does.
		internal def roll(count int, shift int) {
			return when count < 2
			if count > vals.len() {
				fault("roll past the operand stack")
				return
			}
			shift = shift < 0 ?? (-((-shift) % count), shift % count)
			return when shift == 0
			let startIdx = -1
			let idx = -1
			let lastV = 0
			let lastI = true
			for let i = 0; i < count; i++ {
				if startIdx == idx {
					startIdx++
					idx = startIdx
					lastV = vals[idx]
					lastI = ints[idx]
				}
				idx += shift
				if idx >= count {
					idx -= count
				} else if idx < 0 {
					idx += count
				}
				let tv = vals[idx]
				let ti = ints[idx]
				vals[idx] = lastV
				ints[idx] = lastI
				lastV = tv
				lastI = ti
			}
		}

		internal def readByte() int {
			if pos >= code.len() {
				fault("charstring ends inside an operator")
				return 0
			}
			let b = int(code[pos])
			pos++
			return b
		}

		internal def doStems(stems StemHint[]) {
			let count = vals.len()
			let position = 0
			for let i = count & 1; i < count; i += 2 {
				position = int32(position + real(i))
				let min = position
				position = int32(position + real(i + 1))
				stems.push(new StemHint(min, position))
			}
			clearStack()
		}

		internal def doFlex(curX int, curY int, readFromStack bool[], conditionalLast bool) (int, int) {
			let v int[]
			v.len(14)
			v.fill(0)
			v[0] = curX
			v[1] = curY
			let idx = 0
			let isHFlex = !readFromStack[9]
			let top = isHFlex ?? (9, 10)
			for let i = 0; i < top; i++ {
				v[i + 2] = v[i]
				if readFromStack[i] {
					v[i + 2] = int32(v[i + 2] + real(idx))
					idx++
				}
			}
			v[11] = curY when isHFlex
			if conditionalLast {
				let lastIsX = (v[10] - curX).abs() > (v[11] - curY).abs()
				let last = real(idx)
				if lastIsX {
					v[12] = int32(v[10] + last)
					v[13] = curY
				} else {
					v[12] = curX
					v[13] = int32(v[11] + last)
				}
			} else {
				if readFromStack[10] {
					v[12] = int32(v[10] + real(idx))
					idx++
				} else {
					v[12] = curX
				}
				v[13] = readFromStack[11] ?? (int32(v[11] + real(idx)), curY)
			}
			for let j = 0; j < 2; j++ {
				curveTo(v[j * 6 + 2], v[j * 6 + 3], v[j * 6 + 4], v[j * 6 + 5], v[j * 6 + 6], v[j * 6 + 7])
			}
			clearStack()
			return (v[12], v[13])
		}

		internal def doBlend(numBlends int) {
			let regions = run.face.program.regionCounts()
			if run.vsindex < 0 || run.vsindex >= regions.len() {
				fault("blend without variation data")
				return
			}
			let lenBV = regions[run.vsindex] + 1
			let numOperands = numBlends * lenBV
			let base = vals.len() - numOperands
			if base < 0 {
				fault("blend past the operand stack")
				return
			}
			let weights = run.vsindex < run.face.bv.len() ?? (run.face.bv[run.vsindex], int[])
			let delta = base + numBlends
			for let i = 0; i < numBlends; i++ {
				let sum = real(i + base)
				for let j = 1; j < lenBV; j++ {
					let w = j < weights.len() ?? (weights[j], 0)
					sum = int32(sum + mulFix(w, real(delta)))
					delta++
				}
				setReal(i + base, sum)
			}
			vals.len(vals.len() - (numOperands - numBlends))
			ints.len(vals.len())
		}

		internal def readMask(m HintMask) {
			let bitCount = hStems.len() + vStems.len()
			if !m.setCounts(bitCount) {
				fault("more than 96 stem hints")
				return
			}
			for let i = 0; i < (bitCount + 7) / 8; i++ {
				m.mask[i] = readByte()
			}
		}

		// Runs the charstring. `doingSeac` marks a seac component; (curX, curY)
		// is where it starts.
		def interpret(doingSeac bool, curX int, curY int) {
			let limit = 20000000
			for {
				let op = 0
				if pos >= code.len() {
					op = saved.len() > 0 ?? (11, 14)
				} else {
					op = int(code[pos])
					pos++
					op = 0 when run.cff2 && (op == 11 || op == 14)
				}
				return when run.err != ""
				limit--
				if limit == 0 {
					fault("instruction limit reached")
					return
				}
				let clear = true
				match op {
					case 0, 2, 17:
						clear = true
					case 15:
						if run.cff2 {
							if run.usedBV {
								fault("vsindex after blend")
								return
							}
							let t = popInt()
							run.vsindex = t when t >= 0
						}
					case 16:
						if run.cff2 {
							let n = popInt()
							if n > maxStack {
								fault("blend count out of range")
								return
							}
							doBlend(n)
							run.usedBV = true
							clear = false
						}
					case 1, 18:
						doStems(hStems) unless mask.isValid
					case 3, 23:
						doStems(vStems) unless mask.isValid
					case 4:
						curY = int32(curY + popFixed())
						moveTo(curX, curY)
					case 5:
						let count = vals.len()
						for let i = 0; i < count; i += 2 {
							curX = int32(curX + real(i))
							curY = int32(curY + real(i + 1))
							lineTo(curX, curY)
						}
						clearStack()
						clear = false
					case 6, 7:
						let count = vals.len()
						let isX = op == 6
						for let i = 0; i < count; i++ {
							let v = real(i)
							if isX {
								curX = int32(curX + v)
							} else {
								curY = int32(curY + v)
							}
							isX = !isX
							lineTo(curX, curY)
						}
						clearStack()
						clear = false
					case 8, 24:
						let count = vals.len()
						let i = 0
						for i + 6 <= count {
							let x1 = int32(real(i) + curX)
							let y1 = int32(real(i + 1) + curY)
							let x2 = int32(real(i + 2) + x1)
							let y2 = int32(real(i + 3) + y1)
							let x3 = int32(real(i + 4) + x2)
							let y3 = int32(real(i + 5) + y2)
							curveTo(x1, y1, x2, y2, x3, y3)
							curX = x3
							curY = y3
							i += 6
						}
						if op == 24 {
							curX = int32(curX + real(i))
							curY = int32(curY + real(i + 1))
							lineTo(curX, curY)
						}
						clearStack()
						clear = false
					case 10, 29:
						if saved.len() > cf2MaxSubr {
							fault("subroutines nest too deep")
							return
						}
						let n = popInt()
						let program = run.face.program
						let global = op == 29
						let idx = n + (global ?? (run.gbias, run.lbias))
						let count = global ?? (program.globalSubrCount(), program.localSubrCount(run.fd))
						if idx < 0 || idx >= count {
							fault("subroutine {n} does not exist")
							return
						}
						let sub = global ?? (program.globalSubr(idx), program.localSubr(run.fd, idx))
						if sub is error {
							fault("subroutine {n} cannot be read")
							return
						}
						saved.push(code)
						savedPos.push(pos)
						code = sub
						pos = 0
						clear = false
					case 11:
						if saved.len() < 1 {
							fault("return outside a subroutine")
							return
						}
						code = saved[saved.len() - 1]
						pos = savedPos[savedPos.len() - 1]
						saved.len(saved.len() - 1)
						savedPos.len(savedPos.len() - 1)
						clear = false
					case 12:
						let (x, y, keep) = escape(readByte(), curX, curY)
						curX = x
						curY = y
						clear = !keep
					case 14:
						closeOpenPath()
						if !run.cff2 && vals.len() > 1 {
							if doingSeac {
								fault("nested seac")
								return
							}
							let achar = popInt()
							let bchar = popInt()
							let ay = popFixed()
							let ax = popFixed()
							seacComponent(achar, ax, ay)
							seacComponent(bchar, 0, 0) when run.err == ""
						}
						return
					case 19, 20:
						if !(vals.len() > 1 && mask.isValid) {
							doStems(vStems)
							if op == 19 {
								readMask(mask)
							} else {
								let counterMap = new HintMap(run.hinted, run.scale)
								let counterMask = new HintMask()
								readMask(counterMask)
								buildMap(counterMap, counterMask, 0, false)
							}
						}
					case 21:
						curY = int32(curY + popFixed())
						curX = int32(curX + popFixed())
						moveTo(curX, curY)
					case 22:
						curX = int32(curX + popFixed())
						moveTo(curX, curY)
					case 25:
						let count = vals.len()
						let i = 0
						for i + 6 < count {
							curX = int32(curX + real(i))
							curY = int32(curY + real(i + 1))
							lineTo(curX, curY)
							i += 2
						}
						for i < count {
							let x1 = int32(real(i) + curX)
							let y1 = int32(real(i + 1) + curY)
							let x2 = int32(real(i + 2) + x1)
							let y2 = int32(real(i + 3) + y1)
							let x3 = int32(real(i + 4) + x2)
							let y3 = int32(real(i + 5) + y2)
							curveTo(x1, y1, x2, y2, x3, y3)
							curX = x3
							curY = y3
							i += 6
						}
						clearStack()
						clear = false
					case 26, 27:
						let count1 = vals.len()
						let count = count1 & ~2
						let i = count1 - count
						let vertical = op == 26
						for i < count {
							let x1 = curX
							let y1 = curY
							if (count - i) & 1 != 0 {
								if vertical {
									x1 = int32(real(i) + curX)
								} else {
									y1 = int32(real(i) + curY)
								}
								i++
							}
							let x2 = 0
							let y2 = 0
							let x3 = 0
							let y3 = 0
							if vertical {
								y1 = int32(real(i) + curY)
								x2 = int32(real(i + 1) + x1)
								y2 = int32(real(i + 2) + y1)
								x3 = x2
								y3 = int32(real(i + 3) + y2)
							} else {
								x1 = int32(real(i) + curX)
								x2 = int32(real(i + 1) + x1)
								y2 = int32(real(i + 2) + y1)
								x3 = int32(real(i + 3) + x2)
								y3 = y2
							}
							curveTo(x1, y1, x2, y2, x3, y3)
							curX = x3
							curY = y3
							i += 4
						}
						clearStack()
						clear = false
					case 30, 31:
						let count1 = vals.len()
						let count = count1 & ~2
						let i = count1 - count
						let alternate = op == 31
						for i < count {
							let x1 = 0
							let y1 = 0
							let x2 = 0
							let y2 = 0
							let x3 = 0
							let y3 = 0
							if alternate {
								x1 = int32(real(i) + curX)
								y1 = curY
								x2 = int32(real(i + 1) + x1)
								y2 = int32(real(i + 2) + y1)
								y3 = int32(real(i + 3) + y2)
								if count - i == 5 {
									x3 = int32(real(i + 4) + x2)
									i++
								} else {
									x3 = x2
								}
							} else {
								x1 = curX
								y1 = int32(real(i) + curY)
								x2 = int32(real(i + 1) + x1)
								y2 = int32(real(i + 2) + y1)
								x3 = int32(real(i + 3) + x2)
								if count - i == 5 {
									y3 = int32(real(i + 4) + y2)
									i++
								} else {
									y3 = y2
								}
							}
							alternate = !alternate
							curveTo(x1, y1, x2, y2, x3, y3)
							curX = x3
							curY = y3
							i += 4
						}
						clearStack()
						clear = false
					case 28:
						let b1 = readByte()
						let b2 = readByte()
						let v = (b1 << 8) | b2
						pushInt(v >= 0x8000 ?? (v - 0x10000, v))
						clear = false
					default:
						clear = false
						if op >= 32 && op <= 246 {
							pushInt(op - 139)
						} else if op >= 247 && op <= 250 {
							pushInt((op - 247) * 256 + readByte() + 108)
						} else if op >= 251 && op <= 254 {
							pushInt(-((op - 251) * 256 + readByte()) - 108)
						} else if op == 255 {
							let b1 = readByte()
							let b2 = readByte()
							let b3 = readByte()
							let b4 = readByte()
							pushFixed(int32((b1 << 24) | (b2 << 16) | (b3 << 8) | b4))
						} else {
							// Operators 9 and 13 are Type 1 only.
							clear = true
						}
				}
				clearStack() when clear
			}
		}

		// The two-byte operators. Returns the current point and whether the
		// operand stack is kept.
		internal def escape(op int, curX int, curY int) (int, int, bool) {
			match op {
				case 34:
					let (x, y) = doFlex(curX, curY, [true, false, true, true, true, false, true, false, true, false, true, false], false)
					return (x, y, true)
				case 35:
					let (x, y) = doFlex(curX, curY, [true, true, true, true, true, true, true, true, true, true, true, true], false)
					return (x, y, false)
				case 36:
					let (x, y) = doFlex(curX, curY, [true, true, true, true, true, false, true, false, true, true, true, false], false)
					return (x, y, true)
				case 37:
					let (x, y) = doFlex(curX, curY, [true, true, true, true, true, true, true, true, true, true, false, false], true)
					return (x, y, true)
			}
			return (curX, curY, false) when run.cff2 || op >= 38
			match op {
				case 3:
					let b = popFixed()
					let a = popFixed()
					pushInt((a != 0 && b != 0) ?? (1, 0))
				case 4:
					let b = popFixed()
					let a = popFixed()
					pushInt((a != 0 || b != 0) ?? (1, 0))
				case 5:
					pushInt(popFixed() == 0 ?? (1, 0))
				case 9:
					let a = popFixed()
					pushFixed(a < -0x7FFFFFFF ?? (0x7FFFFFFF, a.abs()))
				case 10:
					let b = popFixed()
					let a = popFixed()
					pushFixed(a + b)
				case 11:
					let b = popFixed()
					let a = popFixed()
					pushFixed(a - b)
				case 12:
					let b = popFixed()
					let a = popFixed()
					pushFixed(divFix(a, b))
				case 14:
					let a = popFixed()
					pushFixed(a < -0x7FFFFFFF ?? (0x7FFFFFFF, -a))
				case 15:
					let b = popFixed()
					let a = popFixed()
					pushInt(a == b ?? (1, 0))
				case 16, 17:
					// callothersubr and pop are Type 1 only; the stack stays.
					return (curX, curY, true)
				case 18:
					let _ = popFixed()
				case 20:
					let idx = popInt()
					let v = popFixed()
					storage[idx] = v when idx >= 0 && idx < storage.len()
				case 21:
					let idx = popInt()
					pushFixed(storage[idx]) when idx >= 0 && idx < storage.len()
				case 22:
					let c2 = popFixed()
					let c1 = popFixed()
					let b = popFixed()
					let a = popFixed()
					pushFixed(c1 <= c2 ?? (a, b))
				case 23:
					pushFixed(run.face.nextRandom())
				case 24:
					let b = popFixed()
					let a = popFixed()
					pushFixed(mulFix(a, b))
				case 26:
					let a = popFixed()
					pushFixed(a > 0 ?? (sqrtFixed(a), 0))
				case 27:
					let a = popFixed()
					pushFixed(a)
					pushFixed(a)
				case 28:
					let b = popFixed()
					let a = popFixed()
					pushFixed(b)
					pushFixed(a)
				case 29:
					let idx = popInt()
					let size = vals.len()
					if size > 0 {
						let at = idx < 0 ?? (size - 1, idx >= size ?? (0, size - 1 - idx))
						pushFixed(real(at))
					}
				case 30:
					let shift = popInt()
					let count = popInt()
					roll(count, shift)
				default:
					// dotsection, reserved and Type 1 only operators clear the stack.
					return (curX, curY, false)
			}
			return (curX, curY, true)
		}

		// Draws a seac component: its own hints and path, into the same outline.
		internal def seacComponent(code int, x int, y int) {
			let g = run.face.program.standardGlyph(code)
			if g < 0 {
				fault("seac names no glyph for code {code}")
				return
			}
			let cs = run.face.program.charString(g)
			if cs is error {
				fault("seac component {g} cannot be read")
				return
			}
			let part = new CffCall(run, cs, y)
			part.interpret(true, x, y)
		}

		// The stem hint `index` as a hint map edge, bottom or top.
		internal def hintEdge(index int, origin int, bottom bool) HintEdge {
			let h = new HintEdge()
			let stem = hStems[index]
			let width = int32(stem.max - stem.min)
			if width == -21 << 16 {
				if bottom {
					h.csCoord = stem.max
					h.flags = hintGhostBottom
				}
			} else if width == -20 << 16 {
				if !bottom {
					h.csCoord = stem.min
					h.flags = hintGhostTop
				}
			} else if width < 0 {
				h.csCoord = bottom ?? (stem.max, stem.min)
				h.flags = bottom ?? (hintPairBottom, hintPairTop)
			} else {
				h.csCoord = bottom ?? (stem.min, stem.max)
				h.flags = bottom ?? (hintPairBottom, hintPairTop)
			}
			h.csCoord = int32(h.csCoord + origin)
			h.scale = run.scale
			h.index = index
			if h.flags != 0 && stem.used {
				h.dsCoord = h.isTop() ?? (stem.maxDS, stem.minDS)
				h.flags |= hintLocked
			} else {
				h.dsCoord = mulFix(h.csCoord, run.scale)
			}
			return h
		}

		// Rebuilds `m` from the stems `hints` selects. `isInitial` builds the
		// map every other one starts from.
		internal def buildMap(m HintMap, hints HintMask, origin int, isInitial bool) {
			if !isInitial && !initialMap.isValid {
				buildMap(initialMap, new HintMask(), origin, true)
			}
			if !hints.isValid {
				let n = hStems.len() + vStems.len()
				if n > cf2MaxHints {
					fault("more than 96 stem hints")
					return
				}
				hints.setAll(n)
			}
			m.edges = HintEdge[]
			m.lastIndex = 0
			let temp = hints.copy()
			let bitCount = hStems.len()
			return when bitCount > hints.bitCount
			let initial = initialMap
			if run.blues.doEmBoxHints {
				m.insert(run.blues.emBoxBottom, new HintEdge(), initial)
				m.insert(new HintEdge(), run.blues.emBoxTop, initial)
			}
			for let i = 0; i < bitCount; i++ {
				continue when temp.mask[i >> 3] & (0x80 >> (i & 7)) == 0
				let bottom = hintEdge(i, origin, true)
				let top = hintEdge(i, origin, false)
				if bottom.isLocked() || top.isLocked() || run.blues.capture(bottom, top) {
					m.insert(bottom, top, initial)
					// Captured hints are placed; the second pass skips them.
					temp.mask[i >> 3] &= ~(0x80 >> (i & 7)) & 0xFF
				}
			}
			if isInitial {
				let n = m.edges.len()
				if n == 0 || m.edges[0].csCoord > 0 || m.edges[n - 1].csCoord < 0 {
					let edge = new HintEdge()
					edge.flags = hintGhostBottom | hintLocked | hintSynthetic
					edge.scale = m.scale
					m.insert(edge, new HintEdge(), initial)
				}
			} else {
				for let i = 0; i < bitCount; i++ {
					continue when temp.mask[i >> 3] & (0x80 >> (i & 7)) == 0
					m.insert(hintEdge(i, origin, true), hintEdge(i, origin, false), initial)
				}
			}
			m.adjust()
			if !isInitial {
				for let (_, e) in m.edges {
					continue when e.isSynthetic()
					let stem = hStems[e.index]
					if e.isTop() {
						stem.maxDS = e.dsCoord
					} else {
						stem.minDS = e.dsCoord
					}
					stem.used = true
				}
			}
			m.isValid = true
			hints.isNew = false
		}

		// Glyph path: elements wait one step in a queue before they are
		// mapped through the hint map and handed to the builder.

		internal def hintPoint(m HintMap, x int, y int) (int, int) {
			return (mulFix(run.scale, x), m.map(y))
		}

		internal def pushPrevElem(m HintMap, nextX int, nextY int, close bool) {
			if !prevIsCurve {
				let (x1, y1) = hintPoint(close ?? (firstMap, m), prev1X, prev1Y)
				if curDSX != x1 || curDSY != y1 {
					run.builder.lineTo(curDSX, curDSY, x1, y1)
					curDSX = x1
					curDSY = y1
				}
			} else {
				let (x1, y1) = hintPoint(m, prev1X, prev1Y)
				let (x2, y2) = hintPoint(m, prev2X, prev2Y)
				let (x3, y3) = hintPoint(m, prev3X, prev3Y)
				run.builder.cubeTo(curDSX, curDSY, x1, y1, x2, y2, x3, y3)
				curDSX = x3
				curDSY = y3
			}
			let (x, y) = hintPoint(close ?? (firstMap, m), nextX, nextY)
			if x != curDSX || y != curDSY {
				run.builder.lineTo(curDSX, curDSY, x, y)
				curDSX = x
				curDSY = y
			}
		}

		internal def pushMove(x int, y int) {
			moveTo(startX, startY) unless hintMap.isValid
			let (px, py) = hintPoint(hintMap, x, y)
			run.builder.moveTo()
			curDSX = px
			curDSY = py
			offset0X = x
			offset0Y = y
		}

		internal def moveTo(x int, y int) {
			closeOpenPath()
			curCSX = x
			curCSY = y
			startX = x
			startY = y
			moveIsPending = true
			if !hintMap.isValid || mask.isNew {
				buildMap(hintMap, mask, hintOriginY, false)
			}
			firstMap = hintMap.copy()
		}

		internal def lineTo(x int, y int) {
			let newHintMap = mask.isNew && !pathIsClosing
			return when curCSX == x && curCSY == y && !newHintMap
			let p0X = curCSX
			let p0Y = curCSY
			if moveIsPending {
				pushMove(p0X, p0Y)
				moveIsPending = false
				pathIsOpen = true
				offset1X = x
				offset1Y = y
			}
			pushPrevElem(hintMap, p0X, p0Y, false) when elemIsQueued
			elemIsQueued = true
			prevIsCurve = false
			prev0X = p0X
			prev0Y = p0Y
			prev1X = x
			prev1Y = y
			buildMap(hintMap, mask, hintOriginY, false) when newHintMap
			curCSX = x
			curCSY = y
		}

		internal def curveTo(x1 int, y1 int, x2 int, y2 int, x3 int, y3 int) {
			let p0X = curCSX
			let p0Y = curCSY
			if moveIsPending {
				pushMove(p0X, p0Y)
				moveIsPending = false
				pathIsOpen = true
				offset1X = x1
				offset1Y = y1
			}
			pushPrevElem(hintMap, p0X, p0Y, false) when elemIsQueued
			elemIsQueued = true
			prevIsCurve = true
			prev0X = p0X
			prev0Y = p0Y
			prev1X = x1
			prev1Y = y1
			prev2X = x2
			prev2Y = y2
			prev3X = x3
			prev3Y = y3
			buildMap(hintMap, mask, hintOriginY, false) when mask.isNew
			curCSX = x3
			curCSY = y3
		}

		internal def closeOpenPath() {
			return when !pathIsOpen
			pathIsClosing = true
			lineTo(startX, startY)
			pushPrevElem(hintMap, offset0X, offset0Y, true) when elemIsQueued
			moveIsPending = true
			pathIsOpen = false
			pathIsClosing = false
			elemIsQueued = false
		}
	}
}
