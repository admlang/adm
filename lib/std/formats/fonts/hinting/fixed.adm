// Fixed-point arithmetic of TrueType hinting: 26.6 pixel coordinates, 16.16
// scales and 2.14 unit vectors, rounded the way the reference rasterizers
// round, so hinted outlines come out bit for bit the same.

internal partial module std.formats.fonts.hinting {
	// (a * b) / 65536, rounded half away from zero.
	def mulFix(a int, b int) int {
		let ab = a * b
		return (ab + 0x8000 - (ab < 0 ?? (1, 0))) >> 16
	}

	// (a * 65536) / b, rounded; 0x7FFFFFFF when b is 0.
	def divFix(a int, b int) int {
		let s = 1
		if a < 0 {
			a = -a
			s = -s
		}
		if b < 0 {
			b = -b
			s = -s
		}
		let q = b > 0 ?? (((a << 16) + (b >> 1)) / b, 0x7FFFFFFF)
		return s < 0 ?? (-q, q)
	}

	// (a * b) / c, rounded; 0x7FFFFFFF when c is 0.
	def mulDiv(a int, b int, c int) int {
		let s = 1
		if a < 0 {
			a = -a
			s = -s
		}
		if b < 0 {
			b = -b
			s = -s
		}
		if c < 0 {
			c = -c
			s = -s
		}
		let d = c > 0 ?? ((a * b + (c >> 1)) / c, 0x7FFFFFFF)
		return s < 0 ?? (-d, d)
	}

	// (a * b) / c, truncated.
	def mulDivNoRound(a int, b int, c int) int {
		let s = 1
		if a < 0 {
			a = -a
			s = -s
		}
		if b < 0 {
			b = -b
			s = -s
		}
		if c < 0 {
			c = -c
			s = -s
		}
		let d = c > 0 ?? (a * b / c, 0x7FFFFFFF)
		return s < 0 ?? (-d, d)
	}

	// Truncates to a signed 32-bit value.
	def int32(v int) int {
		let w = v & 0xFFFFFFFF
		return w >= 0x80000000 ?? (w - 0x100000000, w)
	}

	// (a * b) / 16384, rounded: a 26.6 value times a 2.14 component.
	def mulFix14(a int, b int) int {
		let r = a * b
		r += 0x2000 + (r < 0 ?? (-1, 0))
		return int32(r >> 14)
	}

	// (ax * bx + ay * by) / 16384, rounded: projection on a 2.14 vector.
	def dotFix14(ax int, ay int, bx int, by int) int {
		let t = ax * bx + ay * by
		t += 0x2000 + (t < 0 ?? (-1, 0))
		return int32(t >> 14)
	}

	def pixRound(x int) int {
		return (x + 32) & -64
	}

	def pixFloor(x int) int {
		return x & -64
	}

	def pixCeil(x int) int {
		return (x + 63) & -64
	}

	// Index of the highest set bit.
	def msb(x int) int {
		let n = -1
		for x > 0 {
			n++
			x >>= 1
		}
		return n
	}

	// Scales (x, y) to a unit vector with 16.16 components, with the
	// reference's integer iteration and 32-bit wraparound. Returns the vector
	// and whether it was changed (a zero vector stays as it is).
	def normLen(vx int, vy int) (int, int) {
		let sx = 1
		let sy = 1
		let x = vx
		let y = vy
		if x < 0 {
			x = (0 - x) & 0xFFFFFFFF
			sx = -1
		}
		if y < 0 {
			y = (0 - y) & 0xFFFFFFFF
			sy = -1
		}
		if x == 0 {
			return (vx, y > 0 ?? (sy * 0x10000, vy))
		}
		if y == 0 {
			return (sx * 0x10000, vy)
		}
		let l = x > y ?? (x + (y >> 1), y + (x >> 1))
		let shift = 31 - msb(l)
		shift -= 15 + (l >= (0xAAAAAAAA >> shift) ?? (1, 0))
		if shift > 0 {
			x = (x << shift) & 0xFFFFFFFF
			y = (y << shift) & 0xFFFFFFFF
			l = x > y ?? (x + (y >> 1), y + (x >> 1))
		} else {
			x >>= -shift
			y >>= -shift
			l >>= -shift
		}
		let b = 0x10000 - int32(l)
		let xs = int32(x)
		let ys = int32(y)
		let u = 0
		let v = 0
		for {
			u = (xs + (int32(xs * b) >> 16)) & 0xFFFFFFFF
			v = (ys + (int32(ys * b) >> 16)) & 0xFFFFFFFF
			let z = -int32((u * u + v * v) & 0xFFFFFFFF) / 0x200
			z = z * ((0x10000 + b) >> 8) / 0x10000
			b += z
			break when z <= 0
		}
		return (sx < 0 ?? (-u, u), sy < 0 ?? (-v, v))
	}
}
