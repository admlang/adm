internal partial module std.formats.fonts.hinting {
	// Code ranges: the font program, the control value program, a glyph.
	const (
		rangeFont  = 1
		rangeCvt   = 2
		rangeGlyph = 3
	)

	// Rounding modes of the graphics state.
	const (
		roundHalfGrid   = 0
		roundGrid       = 1
		roundDoubleGrid = 2
		roundDownToGrid = 3
		roundUpToGrid   = 4
		roundOff        = 5
		roundSuper      = 6
		roundSuper45    = 7
	)

	const maxRunnableOpcodes = 1000000

	// Instruction lengths; negative for NPUSHB/NPUSHW, whose length follows.
	let opcodeLength = opcodeLengthTable()

	internal def opcodeLengthTable() int[] {
		let t int[]
		t.len(256)
		t.fill(1)
		t[0x40] = -1
		t[0x41] = -2
		for let i = 0; i < 8; i++ {
			t[0xB0 + i] = 2 + i
			t[0xB8 + i] = 3 + 2 * i
		}
		return t
	}

	// Arguments an opcode pops (high nibble) and results it pushes (low).
	let popPush = int[
		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x02, 0x02, 0x00, 0x50,
		0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x00, 0x00, 0x10, 0x00, 0x10, 0x10, 0x10, 0x10,
		0x12, 0x10, 0x00, 0x22, 0x01, 0x11, 0x10, 0x20, 0x00, 0x10, 0x20, 0x10, 0x10, 0x00, 0x10, 0x10,
		0x00, 0x00, 0x00, 0x00, 0x10, 0x10, 0x10, 0x10, 0x10, 0x00, 0x20, 0x20, 0x00, 0x00, 0x20, 0x20,
		0x00, 0x00, 0x20, 0x11, 0x20, 0x11, 0x11, 0x11, 0x20, 0x21, 0x21, 0x01, 0x01, 0x00, 0x00, 0x10,
		0x21, 0x21, 0x21, 0x21, 0x21, 0x21, 0x11, 0x11, 0x10, 0x00, 0x21, 0x21, 0x11, 0x10, 0x10, 0x10,
		0x21, 0x21, 0x21, 0x21, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11,
		0x20, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x20, 0x20, 0x00, 0x00, 0x00, 0x00, 0x10, 0x10,
		0x00, 0x20, 0x20, 0x00, 0x00, 0x10, 0x20, 0x20, 0x11, 0x10, 0x33, 0x21, 0x21, 0x10, 0x20, 0x00,
		0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
		0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
		0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10,
		0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10,
		0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20,
		0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20
	]

	// The graphics state instructions read and set.
	type GraphicsState {
		rp0               int
		rp1               int
		rp2               int
		dualX             int
		dualY             int
		projX             int
		projY             int
		freeX             int
		freeY             int
		loop              int
		minimumDistance   int
		roundState        int
		autoFlip          bool
		controlValueCutIn int
		singleWidthCutIn  int
		singleWidthValue  int
		deltaBase         int
		deltaShift        int
		instructControl   int
		scanControl       bool
		scanType          int
		gep0              int
		gep1              int
		gep2              int

		// The state before any program runs.
		def new() {
			dualX = 0x4000
			projX = 0x4000
			freeX = 0x4000
			loop = 1
			minimumDistance = 64
			roundState = roundGrid
			autoFlip = true
			controlValueCutIn = 68
			deltaBase = 9
			deltaShift = 3
			gep0 = 1
			gep1 = 1
			gep2 = 1
		}

		def clone() GraphicsState {
			let g = new GraphicsState()
			g.rp0 = rp0
			g.rp1 = rp1
			g.rp2 = rp2
			g.dualX = dualX
			g.dualY = dualY
			g.projX = projX
			g.projY = projY
			g.freeX = freeX
			g.freeY = freeY
			g.loop = loop
			g.minimumDistance = minimumDistance
			g.roundState = roundState
			g.autoFlip = autoFlip
			g.controlValueCutIn = controlValueCutIn
			g.singleWidthCutIn = singleWidthCutIn
			g.singleWidthValue = singleWidthValue
			g.deltaBase = deltaBase
			g.deltaShift = deltaShift
			g.instructControl = instructControl
			g.scanControl = scanControl
			g.scanType = scanType
			g.gep0 = gep0
			g.gep1 = gep1
			g.gep2 = gep2
			return g
		}
	}

	// A function or instruction definition.
	type Definition {
		opc       int
		codeRange int
		start     int
		end       int
		active    bool

		def new() {}
	}

	// A return address on the call stack.
	type CallRecord {
		callerRange int
		callerIP    int
		count       int
		target      Definition

		def new(callerRange int, callerIP int, count int, target Definition) {
			self.callerRange = callerRange
			self.callerIP = callerIP
			self.count = count
			self.target = target
		}
	}

	// The TrueType bytecode interpreter: one per face and size, keeping the
	// definitions, CVT, storage and twilight zone between glyphs.
	type Interpreter {
		// Configuration.
		version               int
		grayscale             bool
		subpixelLean          bool
		grayscaleCleartype    bool
		backwardCompatibility bool
		// Size.
		ppem                  int
		scale                 int
		xScale                int
		yScale                int
		pointSize             int
		// Programs.
		codes                 byte[][]
		code                  byte[]
		codeSize              int
		curRange              int
		iniRange              int
		ip                    int
		opcode                int
		length                int
		stepIns               bool
		// Stack.
		stack                 int[]
		top                   int
		args                  int
		newTop                int
		callStack             CallRecord[]
		// Definitions.
		fdefs                 Definition[]
		idefs                 Definition[]
		maxFunc               int
		maxFDefs              int
		maxIDefs              int
		// Values.
		cvt                   int[]
		sizeCvt               int[]
		storage               int[]
		sizeStorage           int[]
		// Whether a glyph program made its own copy of the CVT or storage.
		cvtCopied             bool
		storageCopied         bool
		// Zones.
		twilight              Zone
		pts                   Zone
		zp0                   Zone
		zp1                   Zone
		zp2                   Zone
		gs                    GraphicsState
		// Derived state.
		fDotP                 int
		projMode              int
		dualMode              int
		moveMode              int
		period                int
		phase                 int
		threshold             int
		iupxCalled            bool
		iupyCalled            bool
		isComposite           bool
		failed                bool
		loopcallCounter       int
		loopcallCounterMax    int
		negJumpCounter        int
		negJumpCounterMax     int
		numGlyphs             int

		def new(version int, maxFDefs int, maxIDefs int, stackSize int, numGlyphs int) {
			self.version = version
			self.maxFDefs = maxFDefs
			self.maxIDefs = maxIDefs
			self.numGlyphs = numGlyphs
			codes = [byte[], byte[], byte[], byte[]]
			stack.len(stackSize)
			gs = new GraphicsState()
			pts = new Zone(1, 0)
			twilight = new Zone(0, 0)
			zp0 = pts
			zp1 = pts
			zp2 = pts
		}

		// Runs code range `range` from the start. Returns false on an error.
		def run(range int) bool {
			curRange = range
			code = codes[range]
			codeSize = code.len()
			ip = 0
			top = 0
			callStack = CallRecord[]
			return execute()
		}

		// -- derived functions ------------------------------------------------

		def computeFuncs() {
			if gs.freeX == 0x4000 {
				fDotP = gs.projX
			} else if gs.freeY == 0x4000 {
				fDotP = gs.projY
			} else {
				fDotP = (gs.projX * gs.freeX + gs.projY * gs.freeY) >> 14
			}
			projMode = gs.projX == 0x4000 ?? (1, gs.projY == 0x4000 ?? (2, 0))
			dualMode = gs.dualX == 0x4000 ?? (1, gs.dualY == 0x4000 ?? (2, 0))
			moveMode = 0
			if fDotP == 0x4000 {
				moveMode = gs.freeX == 0x4000 ?? (1, gs.freeY == 0x4000 ?? (2, 0))
			}
			fDotP = 0x4000 when fDotP.abs() < 0x400
		}

		def project(dx int, dy int) int {
			return dx when projMode == 1
			return dy when projMode == 2
			return dotFix14(dx, dy, gs.projX, gs.projY)
		}

		def dualProject(dx int, dy int) int {
			return dx when dualMode == 1
			return dy when dualMode == 2
			return dotFix14(dx, dy, gs.dualX, gs.dualY)
		}

		// Whether moves along y are blocked: after both IUPs in backward
		// compatibility mode.
		internal def postIUP() bool {
			return backwardCompatibility && iupxCalled && iupyCalled
		}

		// Moves point `p` of `zone` by `distance` along the freedom vector.
		def move(zone Zone, p int, distance int) {
			if moveMode == 1 {
				zone.curX[p] += distance when !backwardCompatibility
				zone.tags[p] |= tagTouchX
				return
			}
			if moveMode == 2 {
				zone.curY[p] += distance when !postIUP()
				zone.tags[p] |= tagTouchY
				return
			}
			if gs.freeX != 0 {
				zone.curX[p] += mulDiv(distance, gs.freeX, fDotP) when !backwardCompatibility
				zone.tags[p] |= tagTouchX
			}
			if gs.freeY != 0 {
				zone.curY[p] += mulDiv(distance, gs.freeY, fDotP) when !postIUP()
				zone.tags[p] |= tagTouchY
			}
		}

		def moveOrig(zone Zone, p int, distance int) {
			if moveMode == 1 {
				zone.orgX[p] += distance
				return
			}
			if moveMode == 2 {
				zone.orgY[p] += distance
				return
			}
			zone.orgX[p] += mulDiv(distance, gs.freeX, fDotP) when gs.freeX != 0
			zone.orgY[p] += mulDiv(distance, gs.freeY, fDotP) when gs.freeY != 0
		}

		// -- rounding ------------------------------------------------------------

		def round(distance int) int {
			match gs.roundState {
				case 0:
					if distance >= 0 {
						let v = pixFloor(distance) + 32
						return v < 0 ?? (32, v)
					}
					let v = -(pixFloor(-distance) + 32)
					return v > 0 ?? (-32, v)
				case 1:
					if distance >= 0 {
						let v = pixRound(distance)
						return v < 0 ?? (0, v)
					}
					let v = -pixRound(-distance)
					return v > 0 ?? (0, v)
				case 2:
					if distance >= 0 {
						let v = (distance + 16) & -32
						return v < 0 ?? (0, v)
					}
					let v = -((-distance + 16) & -32)
					return v > 0 ?? (0, v)
				case 3:
					if distance >= 0 {
						let v = pixFloor(distance)
						return v < 0 ?? (0, v)
					}
					let v = -pixFloor(-distance)
					return v > 0 ?? (0, v)
				case 4:
					if distance >= 0 {
						let v = pixCeil(distance)
						return v < 0 ?? (0, v)
					}
					let v = -pixCeil(-distance)
					return v > 0 ?? (0, v)
				case 5:
					return roundNone(distance)
				case 6:
					if distance >= 0 {
						let v = ((distance + threshold - phase) & -period) + phase
						return v < 0 ?? (phase, v)
					}
					let v = -((threshold - phase - distance) & -period) - phase
					return v > 0 ?? (-phase, v)
				case 7:
					if distance >= 0 {
						let v = (distance + threshold - phase) / period * period + phase
						return v < 0 ?? (phase, v)
					}
					let v = -((threshold - phase - distance) / period * period) - phase
					return v > 0 ?? (-phase, v)
			}
			return distance
		}

		def roundNone(distance int) int {
			if distance >= 0 {
				return distance.max(0)
			}
			return distance.min(0)
		}

		def setSuperRound(gridPeriod int, selector int) {
			match selector & 0xC0 {
				case 0:
					period = gridPeriod / 2
				case 0x40:
					period = gridPeriod
				case 0x80:
					period = gridPeriod * 2
				case 0xC0:
					period = gridPeriod
			}
			match selector & 0x30 {
				case 0:
					phase = 0
				case 0x10:
					phase = period / 4
				case 0x20:
					phase = period / 2
				case 0x30:
					phase = period * 3 / 4
			}
			if selector & 0x0F == 0 {
				threshold = period - 1
			} else {
				threshold = ((selector & 0x0F) - 4) * period / 8
			}
			period >>= 8
			phase >>= 8
			threshold >>= 8
		}

		// -- vectors ---------------------------------------------------------------

		// The unit vector along (vx, vy) as 2.14 components; (0, 0) keeps the
		// old vector, as the reference does.
		def normalize(vx int, vy int) (bool, int, int) {
			return (false, 0, 0) when vx == 0 && vy == 0
			let (x, y) = normLen(vx, vy)
			return (true, x / 4, y / 4)
		}

		// -- CVT and storage ------------------------------------------------------

		// A glyph program writes to its own copy of the CVT.
		internal def cvtForWrite() {
			if iniRange == rangeGlyph && !cvtCopied {
				cvt = sizeCvt.clone()
				cvtCopied = true
			}
		}

		// -- the main loop --------------------------------------------------------

		def execute() bool {
			let counter = 0
			let twilightMax = (2 * (pts.nPoints + cvt.len())).max(30).min(0xFFFF)
			twilight.nPoints = twilightMax when twilight.nPoints > twilightMax
			loopcallCounter = 0
			negJumpCounter = 0
			if pts.nPoints > 0 {
				loopcallCounterMax = (10 * pts.nPoints).max(50) + (cvt.len() / 10).max(50)
			} else {
				loopcallCounterMax = 300 + 22 * cvt.len()
			}
			loopcallCounterMax = 100 * numGlyphs when loopcallCounterMax > 100 * numGlyphs
			negJumpCounterMax = loopcallCounterMax
			iniRange = curRange
			computeFuncs()
			iupxCalled = false
			iupyCalled = false
			failed = false

			for ip < codeSize {
				opcode = int(code[ip])
				length = opcodeLength[opcode]
				if length < 0 {
					return false when ip + 1 >= codeSize
					length = 2 - length * int(code[ip + 1])
				}
				return false when ip + length > codeSize

				let pops = popPush[opcode] >> 4
				args = top - pops
				if args < 0 {
					for let i = 0; i < pops; i++ {
						stack[i] = 0
					}
					args = 0
				}
				newTop = args + (popPush[opcode] & 15)
				return false when newTop > stack.len()
				stepIns = true
				dispatch()
				return false when failed
				top = newTop
				ip += length when stepIns
				counter++
				return false when counter > maxRunnableOpcodes
				// Falling off the end of a function body is an error.
				return false when ip >= codeSize && callStack.len() > 0
			}
			return true
		}

		def abort() {
			failed = true
		}

		// Moves to code range `range` at `at`.
		def gotoRange(range int, at int) bool {
			if range < 1 || range > 3 || codes[range].len() == 0 {
				abort()
				return false
			}
			if at > codes[range].len() {
				abort()
				return false
			}
			code = codes[range]
			codeSize = code.len()
			ip = at
			curRange = range
			return true
		}

		// Moves past the current instruction while skipping code (IF, FDEF).
		def skipCode() bool {
			ip += length
			if ip < codeSize {
				opcode = int(code[ip])
				length = opcodeLength[opcode]
				if length < 0 {
					if ip + 1 >= codeSize {
						abort()
						return false
					}
					length = 2 - length * int(code[ip + 1])
				}
				return true when ip + length <= codeSize
			}
			abort()
			return false
		}

		internal def shortAt(at int) int {
			let v = int(code[at]) << 8 | int(code[at + 1])
			return v >= 0x8000 ?? (v - 0x10000, v)
		}

		// Short for the arguments of the current instruction.
		internal def a(i int) int {
			return stack[args + i]
		}

		internal def setA(i int, v int) {
			stack[args + i] = v
		}

		internal def zoneOf(n int) ?Zone {
			return twilight when n == 0
			return pts when n == 1
			return none
		}

		def dispatch() {
			let op = opcode
			if op <= 0x05 {
				// SVTCA, SPVTCA, SFVTCA.
				let aa = (op & 1) << 14
				let bb = aa ^ 0x4000
				if op < 4 {
					gs.projX = aa
					gs.projY = bb
					gs.dualX = aa
					gs.dualY = bb
				}
				if op & 2 == 0 {
					gs.freeX = aa
					gs.freeY = bb
				}
				computeFuncs()
				return
			}
			match op {
				case 0x06, 0x07:
					let (ok, x, y) = lineVector(a(1), a(0))
					if ok {
						gs.projX = x
						gs.projY = y
						gs.dualX = x
						gs.dualY = y
						computeFuncs()
					}
				case 0x08, 0x09:
					let (ok, x, y) = lineVector(a(1), a(0))
					if ok {
						gs.freeX = x
						gs.freeY = y
						computeFuncs()
					}
				case 0x0A:
					let (ok, x, y) = normalize(int16(a(0)), int16(a(1)))
					if ok {
						gs.projX = x
						gs.projY = y
					}
					gs.dualX = gs.projX
					gs.dualY = gs.projY
					computeFuncs()
				case 0x0B:
					let (ok, x, y) = normalize(int16(a(0)), int16(a(1)))
					if ok {
						gs.freeX = x
						gs.freeY = y
					}
					computeFuncs()
				case 0x0C:
					setA(0, gs.projX)
					setA(1, gs.projY)
				case 0x0D:
					setA(0, gs.freeX)
					setA(1, gs.freeY)
				case 0x0E:
					gs.freeX = gs.projX
					gs.freeY = gs.projY
					computeFuncs()
				case 0x0F:
					insISECT()
				case 0x10:
					gs.rp0 = a(0) & 0xFFFF
				case 0x11:
					gs.rp1 = a(0) & 0xFFFF
				case 0x12:
					gs.rp2 = a(0) & 0xFFFF
				case 0x13, 0x14, 0x15, 0x16:
					let z = zoneOf(a(0))
					return when z is none
					if op == 0x13 || op == 0x16 {
						zp0 = z
						gs.gep0 = a(0)
					}
					if op == 0x14 || op == 0x16 {
						zp1 = z
						gs.gep1 = a(0)
					}
					if op == 0x15 || op == 0x16 {
						zp2 = z
						gs.gep2 = a(0)
					}
				case 0x17:
					if a(0) < 0 {
						abort()
						return
					}
					gs.loop = a(0).min(0xFFFF)
				case 0x18:
					gs.roundState = roundGrid
				case 0x19:
					gs.roundState = roundHalfGrid
				case 0x1A:
					gs.minimumDistance = a(0)
				case 0x1B:
					insELSE()
				case 0x1C:
					insJMPR(a(0))
				case 0x1D:
					gs.controlValueCutIn = a(0)
				case 0x1E:
					gs.singleWidthCutIn = a(0)
				case 0x1F:
					gs.singleWidthValue = mulFix(a(0), scale)
				case 0x20:
					setA(1, a(0))
				case 0x21:
				// POP
				case 0x22:
					newTop = 0
				case 0x23:
					let t = a(0)
					setA(0, a(1))
					setA(1, t)
				case 0x24:
					setA(0, top)
				case 0x25:
					let l = a(0)
					setA(0, l <= 0 || l > args ?? (0, stack[args - l]))
				case 0x26:
					let l = a(0)
					if l > 0 && l <= args {
						let k = stack[args - l]
						for let i = args - l; i < args - 1; i++ {
							stack[i] = stack[i + 1]
						}
						stack[args - 1] = k
					}
				case 0x27:
					insALIGNPTS()
				case 0x29:
					insUTP()
				case 0x2A:
					insLOOPCALL()
				case 0x2B:
					insCALL()
				case 0x2C:
					insFDEF()
				case 0x2D:
					insENDF()
				case 0x2E, 0x2F:
					insMDAP()
				case 0x30, 0x31:
					insIUP()
				case 0x32, 0x33:
					insSHP()
				case 0x34, 0x35:
					insSHC()
				case 0x36, 0x37:
					insSHZ()
				case 0x38:
					insSHPIX()
				case 0x39:
					insIP()
				case 0x3A, 0x3B:
					insMSIRP()
				case 0x3C:
					insALIGNRP()
				case 0x3D:
					gs.roundState = roundDoubleGrid
				case 0x3E, 0x3F:
					insMIAP()
				case 0x40:
					let n = int(code[ip + 1])
					if n > stack.len() + 1 - top {
						abort()
						return
					}
					for let k = 0; k < n; k++ {
						stack[args + k] = int(code[ip + 2 + k])
					}
					newTop += n
				case 0x41:
					let n = int(code[ip + 1])
					if n > stack.len() + 1 - top {
						abort()
						return
					}
					for let k = 0; k < n; k++ {
						stack[args + k] = shortAt(ip + 2 + k * 2)
					}
					newTop += n
				case 0x42:
					let i = a(0)
					if i >= 0 && i < storage.len() {
						if iniRange == rangeGlyph && !storageCopied {
							storage = sizeStorage.clone()
							storageCopied = true
						}
						storage[i] = a(1)
					}
				case 0x43:
					let i = a(0)
					setA(0, i >= 0 && i < storage.len() ?? (storage[i], 0))
				case 0x44:
					let i = a(0)
					if i >= 0 && i < cvt.len() {
						cvtForWrite()
						cvt[i] = a(1)
					}
				case 0x45:
					let i = a(0)
					setA(0, i >= 0 && i < cvt.len() ?? (cvt[i], 0))
				case 0x46, 0x47:
					let l = a(0)
					if l < 0 || l >= zp2.nPoints {
						setA(0, 0)
					} else if op & 1 != 0 {
						setA(0, dualProject(zp2.orgX[l], zp2.orgY[l]))
					} else {
						setA(0, project(zp2.curX[l], zp2.curY[l]))
					}
				case 0x48:
					let l = a(0) & 0xFFFF
					return when l >= zp2.nPoints
					let k = project(zp2.curX[l], zp2.curY[l])
					move(zp2, l, a(1) - k)
					if gs.gep2 == 0 {
						zp2.orgX[l] = zp2.curX[l]
						zp2.orgY[l] = zp2.curY[l]
					}
				case 0x49, 0x4A:
					insMD()
				case 0x4B, 0x4C:
					setA(0, ppem)
				case 0x4D:
					gs.autoFlip = true
				case 0x4E:
					gs.autoFlip = false
				case 0x4F:
					abort()
				case 0x50:
					setA(0, a(0) < a(1) ?? (1, 0))
				case 0x51:
					setA(0, a(0) <= a(1) ?? (1, 0))
				case 0x52:
					setA(0, a(0) > a(1) ?? (1, 0))
				case 0x53:
					setA(0, a(0) >= a(1) ?? (1, 0))
				case 0x54:
					setA(0, a(0) == a(1) ?? (1, 0))
				case 0x55:
					setA(0, a(0) != a(1) ?? (1, 0))
				case 0x56:
					setA(0, round(a(0)) & 127 == 64 ?? (1, 0))
				case 0x57:
					setA(0, round(a(0)) & 127 == 0 ?? (1, 0))
				case 0x58:
					insIF()
				case 0x59:
				// EIF
				case 0x5A:
					setA(0, a(0) != 0 && a(1) != 0 ?? (1, 0))
				case 0x5B:
					setA(0, a(0) != 0 || a(1) != 0 ?? (1, 0))
				case 0x5C:
					setA(0, a(0) == 0 ?? (1, 0))
				case 0x5D, 0x71, 0x72:
					insDELTAP()
				case 0x5E:
					gs.deltaBase = a(0) & 0xFFFF
				case 0x5F:
					if a(0) < 0 || a(0) > 6 {
						abort()
						return
					}
					gs.deltaShift = a(0)
				case 0x60:
					setA(0, a(0) + a(1))
				case 0x61:
					setA(0, a(0) - a(1))
				case 0x62:
					if a(1) == 0 {
						abort()
						return
					}
					setA(0, mulDivNoRound(a(0), 64, a(1)))
				case 0x63:
					setA(0, mulDiv(a(0), a(1), 64))
				case 0x64:
					setA(0, a(0).abs())
				case 0x65:
					setA(0, -a(0))
				case 0x66:
					setA(0, pixFloor(a(0)))
				case 0x67:
					setA(0, pixCeil(a(0)))
				case 0x68, 0x69, 0x6A, 0x6B:
					setA(0, round(a(0)))
				case 0x6C, 0x6D, 0x6E, 0x6F:
					setA(0, roundNone(a(0)))
				case 0x70:
					let i = a(0)
					if i >= 0 && i < cvt.len() {
						cvtForWrite()
						cvt[i] = mulFix(a(1), scale)
					}
				case 0x73, 0x74, 0x75:
					insDELTAC()
				case 0x76:
					setSuperRound(0x4000, a(0))
					gs.roundState = roundSuper
				case 0x77:
					setSuperRound(0x2D41, a(0))
					gs.roundState = roundSuper45
				case 0x78:
					insJMPR(a(0)) when a(1) != 0
				case 0x79:
					insJMPR(a(0)) when a(1) == 0
				case 0x7A:
					gs.roundState = roundOff
				case 0x7C:
					gs.roundState = roundUpToGrid
				case 0x7D:
					gs.roundState = roundDownToGrid
				case 0x7E, 0x7F:
				// SANGW, AA: no longer supported.
				case 0x80:
					insFLIPPT()
				case 0x81, 0x82:
					insFLIPRG(op == 0x81)
				case 0x85:
					insSCANCTRL()
				case 0x86, 0x87:
					insSDPVTL()
				case 0x88:
					insGETINFO()
				case 0x89:
					insIDEF()
				case 0x8A:
					let x = a(2)
					setA(2, a(0))
					setA(0, a(1))
					setA(1, x)
				case 0x8B:
					setA(0, a(0).max(a(1)))
				case 0x8C:
					setA(0, a(0).min(a(1)))
				case 0x8D:
					gs.scanType = a(0) & 0xFFFF when a(0) >= 0
				case 0x8E:
					insINSTCTRL()
				default:
					if op >= 0xB0 && op <= 0xB7 {
						let n = op - 0xB0 + 1
						for let k = 0; k < n; k++ {
							stack[args + k] = int(code[ip + 1 + k])
						}
						return
					}
					if op >= 0xB8 && op <= 0xBF {
						let n = op - 0xB8 + 1
						for let k = 0; k < n; k++ {
							stack[args + k] = shortAt(ip + 1 + k * 2)
						}
						return
					}
					if op >= 0xC0 && op <= 0xDF {
						insMDRP()
						return
					}
					if op >= 0xE0 {
						insMIRP()
						return
					}
					insUNKNOWN()
			}
		}

		// SPVTL/SFVTL: the vector along the line between two points.
		internal def lineVector(p1 int, p2 int) (bool, int, int) {
			p1 &= 0xFFFF
			p2 &= 0xFFFF
			return (false, 0, 0) when p1 >= zp2.nPoints || p2 >= zp1.nPoints
			let dx = zp1.curX[p2] - zp2.curX[p1]
			let dy = zp1.curY[p2] - zp2.curY[p1]
			let odd = opcode & 1 != 0
			if dx == 0 && dy == 0 {
				dx = 0x4000
				odd = false
			}
			if odd {
				let c = dy
				dy = dx
				dx = -c
			}
			let (ok, x, y) = normalize(dx, dy)
			return (true, ok ?? (x, 0), ok ?? (y, 0)) when ok
			return (true, 0, 0)
		}

		internal def insSDPVTL() {
			let p1 = a(1) & 0xFFFF
			let p2 = a(0) & 0xFFFF
			return when p2 >= zp1.nPoints || p1 >= zp2.nPoints
			let odd = opcode & 1 != 0
			let dx = zp1.orgX[p2] - zp2.orgX[p1]
			let dy = zp1.orgY[p2] - zp2.orgY[p1]
			if dx == 0 && dy == 0 {
				dx = 0x4000
				odd = false
			}
			if odd {
				let c = dy
				dy = dx
				dx = -c
			}
			let (ok1, x1, y1) = normalize(dx, dy)
			if ok1 {
				gs.dualX = x1
				gs.dualY = y1
			}
			dx = zp1.curX[p2] - zp2.curX[p1]
			dy = zp1.curY[p2] - zp2.curY[p1]
			if dx == 0 && dy == 0 {
				dx = 0x4000
				odd = false
			}
			if odd {
				let c = dy
				dy = dx
				dx = -c
			}
			let (ok2, x2, y2) = normalize(dx, dy)
			if ok2 {
				gs.projX = x2
				gs.projY = y2
			}
			computeFuncs()
		}

		// -- flow control ---------------------------------------------------------

		internal def insIF() {
			return when a(0) != 0
			let nIfs = 1
			let out = false
			for !out {
				return when !skipCode()
				if opcode == 0x58 {
					nIfs++
				} else if opcode == 0x1B {
					out = nIfs == 1
				} else if opcode == 0x59 {
					nIfs--
					out = nIfs == 0
				}
			}
		}

		internal def insELSE() {
			let nIfs = 1
			for nIfs != 0 {
				return when !skipCode()
				if opcode == 0x58 {
					nIfs++
				} else if opcode == 0x59 {
					nIfs--
				}
			}
		}

		internal def insJMPR(offset int) {
			if offset == 0 && args == 0 {
				abort()
				return
			}
			ip += offset
			if ip < 0 || (callStack.len() > 0 && ip > callStack[callStack.len() - 1].target.end) {
				abort()
				return
			}
			stepIns = false
			if offset < 0 {
				negJumpCounter++
				abort() when negJumpCounter > negJumpCounterMax
			}
		}

		internal def insFDEF() {
			if iniRange == rangeGlyph {
				abort()
				return
			}
			let n = a(0)
			let at = -1
			for let (i, d) in fdefs {
				if d.opc == n {
					at = i
					break
				}
			}
			if at < 0 {
				if fdefs.len() >= maxFDefs {
					abort()
					return
				}
				fdefs.push(new Definition())
				at = fdefs.len() - 1
			}
			let rec = fdefs[at]
			if n < 0 || n > 0xFFFF {
				abort()
				return
			}
			rec.codeRange = curRange
			rec.opc = n
			rec.start = ip + 1
			rec.active = true
			maxFunc = n when n > maxFunc
			for skipCode() {
				if opcode == 0x89 || opcode == 0x2C {
					abort()
					return
				}
				if opcode == 0x2D {
					rec.end = ip
					return
				}
			}
		}

		internal def insIDEF() {
			if iniRange == rangeGlyph {
				abort()
				return
			}
			let n = a(0)
			let at = -1
			for let (i, d) in idefs {
				if d.opc == n {
					at = i
					break
				}
			}
			if at < 0 {
				if idefs.len() >= maxIDefs {
					abort()
					return
				}
				idefs.push(new Definition())
				at = idefs.len() - 1
			}
			let rec = idefs[at]
			if n < 0 || n > 0xFF {
				abort()
				return
			}
			rec.opc = n
			rec.start = ip + 1
			rec.codeRange = curRange
			rec.active = true
			for skipCode() {
				if opcode == 0x89 || opcode == 0x2C {
					abort()
					return
				}
				if opcode == 0x2D {
					rec.end = ip
					return
				}
			}
		}

		internal def insENDF() {
			if callStack.len() == 0 {
				abort()
				return
			}
			let rec = callStack[callStack.len() - 1]
			rec.count--
			stepIns = false
			if rec.count > 0 {
				ip = rec.target.start
				return
			}
			callStack.len(callStack.len() - 1)
			gotoRange(rec.callerRange, rec.callerIP)
		}

		internal def findFunction(f int) ?Definition {
			return none when f < 0 || f > maxFunc || fdefs.len() == 0
			for let (_, d) in fdefs {
				return d when d.opc == f
			}
			return none
		}

		internal def insCALL() {
			let d = findFunction(a(0))
			if d is none || !d.active {
				abort()
				return
			}
			if callStack.len() >= 32 {
				abort()
				return
			}
			callStack.push(new CallRecord(curRange, ip + 1, 1, d))
			gotoRange(d.codeRange, d.start)
			stepIns = false
		}

		internal def insLOOPCALL() {
			let d = findFunction(a(1))
			if d is none || !d.active {
				abort()
				return
			}
			if callStack.len() >= 32 {
				abort()
				return
			}
			if a(0) > 0 {
				callStack.push(new CallRecord(curRange, ip + 1, a(0), d))
				gotoRange(d.codeRange, d.start)
				stepIns = false
				loopcallCounter += a(0)
				abort() when loopcallCounter > loopcallCounterMax
			}
		}

		internal def insUNKNOWN() {
			for let (_, d) in idefs {
				if d.opc == opcode && d.active {
					if callStack.len() >= 32 {
						abort()
						return
					}
					callStack.push(new CallRecord(curRange, ip + 1, 1, d))
					gotoRange(d.codeRange, d.start)
					stepIns = false
					return
				}
			}
			abort()
		}

		// -- control ----------------------------------------------------------

		internal def insINSTCTRL() {
			let k = a(1)
			let l = a(0)
			return when k < 1 || k > 3
			let kf = 1 << (k - 1)
			return when l != 0 && l != kf
			if iniRange == rangeCvt {
				gs.instructControl &= ~kf
				gs.instructControl |= l
			} else if iniRange == rangeGlyph && k == 3 {
				backwardCompatibility = l != 4 when version == 40 && subpixelLean
			}
		}

		internal def insSCANCTRL() {
			let x = a(0) & 0xFF
			if x == 0xFF {
				gs.scanControl = true
				return
			}
			if x == 0 {
				gs.scanControl = false
				return
			}
			gs.scanControl = true when a(0) & 0x100 != 0 && ppem <= x
			gs.scanControl = false when a(0) & 0x800 != 0 && ppem > x
		}

		internal def insGETINFO() {
			let sel = a(0)
			let k = 0
			k = version when sel & 1 != 0
			k |= 1 << 12 when sel & 32 != 0 && grayscale
			if version == 40 && subpixelLean {
				k |= 1 << 13 when sel & 64 != 0
				k |= 1 << 17 when sel & 1024 != 0
				k |= 1 << 18 when sel & 2048 != 0
				k |= 1 << 19 when sel & 4096 != 0 && grayscaleCleartype
			}
			setA(0, k)
		}

		// -- points ------------------------------------------------------------

		internal def insFLIPPT() {
			if postIUP() || top < gs.loop {
				gs.loop = 1
				newTop = args
				return
			}
			for gs.loop > 0 {
				args--
				let p = stack[args] & 0xFFFF
				pts.tags[p] ^= tagOn when p < pts.nPoints
				gs.loop--
			}
			gs.loop = 1
			newTop = args
		}

		internal def insFLIPRG(on bool) {
			return when postIUP()
			let k = a(1) & 0xFFFF
			let l = a(0) & 0xFFFF
			return when k >= pts.nPoints || l >= pts.nPoints
			for let i = l; i <= k; i++ {
				if on {
					pts.tags[i] |= tagOn
				} else {
					pts.tags[i] &= ~tagOn
				}
			}
		}

		// The displacement of reference point rp1 (in zp0) or rp2 (in zp1).
		// Returns ok, dx, dy, its zone and index.
		internal def pointDisplacement() (bool, int, int, Zone, int) {
			let zp = opcode & 1 != 0 ?? (zp0, zp1)
			let p = opcode & 1 != 0 ?? (gs.rp1, gs.rp2)
			return (false, 0, 0, zp, 0) when p >= zp.nPoints
			let d = project(zp.curX[p] - zp.orgX[p], zp.curY[p] - zp.orgY[p])
			return (true, mulDiv(d, gs.freeX, fDotP), mulDiv(d, gs.freeY, fDotP), zp, p)
		}

		internal def moveZp2(p int, dx int, dy int, touch bool) {
			if gs.freeX != 0 {
				zp2.curX[p] += dx when !backwardCompatibility
				zp2.tags[p] |= tagTouchX when touch
			}
			if gs.freeY != 0 {
				zp2.curY[p] += dy when !postIUP()
				zp2.tags[p] |= tagTouchY when touch
			}
		}

		internal def insSHP() {
			if top < gs.loop {
				gs.loop = 1
				newTop = args
				return
			}
			let (ok, dx, dy, _, _) = pointDisplacement()
			return when !ok
			for gs.loop > 0 {
				args--
				let p = stack[args] & 0xFFFF
				moveZp2(p, dx, dy, true) when p < zp2.nPoints
				gs.loop--
			}
			gs.loop = 1
			newTop = args
		}

		internal def insSHC() {
			let c = a(0) & 0xFFFF
			let bounds = gs.gep2 == 0 ?? (1, zp2.nContours())
			return when c >= bounds
			let (ok, dx, dy, zp, refp) = pointDisplacement()
			return when !ok
			let start = c == 0 ?? (0, zp2.contours[c - 1] + 1)
			let limit = gs.gep2 == 0 ?? (zp2.nPoints, zp2.contours[c] + 1)
			for let i = start; i < limit; i++ {
				moveZp2(i, dx, dy, true) when zp.id != zp2.id || refp != i
			}
		}

		internal def insSHZ() {
			return when a(0) < 0 || a(0) >= 2
			let (ok, dx, dy, zp, refp) = pointDisplacement()
			return when !ok
			let limit = 0
			if gs.gep2 == 0 {
				limit = zp2.nPoints
			} else if gs.gep2 == 1 && zp2.nContours() > 0 {
				limit = zp2.contours[zp2.nContours() - 1] + 1
			}
			for let i = 0; i < limit; i++ {
				moveZp2(i, dx, dy, false) when zp.id != zp2.id || refp != i
			}
		}

		internal def insSHPIX() {
			let inTwilight = gs.gep0 == 0 || gs.gep1 == 0 || gs.gep2 == 0
			if top < gs.loop + 1 {
				gs.loop = 1
				newTop = args
				return
			}
			let dx = mulFix14(a(0), gs.freeX)
			let dy = mulFix14(a(0), gs.freeY)
			for gs.loop > 0 {
				args--
				let p = stack[args] & 0xFFFF
				if p < zp2.nPoints {
					if backwardCompatibility {
						if inTwilight || (!(iupxCalled && iupyCalled) && ((isComposite && gs.freeY != 0) || zp2.tags[p] & tagTouchY != 0)) {
							moveZp2(p, 0, dy, true)
						}
					} else {
						moveZp2(p, dx, dy, true)
					}
				}
				gs.loop--
			}
			gs.loop = 1
			newTop = args
		}

		internal def insMSIRP() {
			let p = a(0) & 0xFFFF
			return when p >= zp1.nPoints || gs.rp0 >= zp0.nPoints
			if gs.gep1 == 0 {
				zp1.orgX[p] = zp0.orgX[gs.rp0]
				zp1.orgY[p] = zp0.orgY[gs.rp0]
				moveOrig(zp1, p, a(1))
				zp1.curX[p] = zp1.orgX[p]
				zp1.curY[p] = zp1.orgY[p]
			}
			let distance = project(zp1.curX[p] - zp0.curX[gs.rp0], zp1.curY[p] - zp0.curY[gs.rp0])
			move(zp1, p, a(1) - distance)
			gs.rp1 = gs.rp0
			gs.rp2 = p
			gs.rp0 = p when opcode & 1 != 0
		}

		internal def insMDAP() {
			let p = a(0) & 0xFFFF
			return when p >= zp0.nPoints
			let distance = 0
			if opcode & 1 != 0 {
				let cur = project(zp0.curX[p], zp0.curY[p])
				distance = round(cur) - cur
			}
			move(zp0, p, distance)
			gs.rp0 = p
			gs.rp1 = p
		}

		internal def insMIAP() {
			let cvtEntry = a(1)
			let p = a(0) & 0xFFFF
			if p >= zp0.nPoints || cvtEntry < 0 || cvtEntry >= cvt.len() {
				gs.rp0 = p
				gs.rp1 = p
				return
			}
			let distance = cvt[cvtEntry]
			if gs.gep0 == 0 {
				zp0.orgX[p] = mulFix14(distance, gs.freeX)
				zp0.orgY[p] = mulFix14(distance, gs.freeY)
				zp0.curX[p] = zp0.orgX[p]
				zp0.curY[p] = zp0.orgY[p]
			}
			let orgDist = project(zp0.curX[p], zp0.curY[p])
			if opcode & 1 != 0 {
				distance = orgDist when (distance - orgDist).abs() > gs.controlValueCutIn
				distance = round(distance)
			}
			move(zp0, p, distance - orgDist)
			gs.rp0 = p
			gs.rp1 = p
		}

		// Distance between two points before scaling-dependent hinting: from
		// font units scaled, or the originals in the twilight zone.
		internal def originalDistance(za Zone, pa int, zb Zone, pb int) int {
			if gs.gep0 == 0 || gs.gep1 == 0 {
				return dualProject(za.orgX[pa] - zb.orgX[pb], za.orgY[pa] - zb.orgY[pb])
			}
			if xScale == yScale {
				return mulFix(dualProject(za.orusX[pa] - zb.orusX[pb], za.orusY[pa] - zb.orusY[pb]), xScale)
			}
			let vx = mulFix(za.orusX[pa] - zb.orusX[pb], xScale)
			let vy = mulFix(za.orusY[pa] - zb.orusY[pb], yScale)
			return dualProject(vx, vy)
		}

		internal def insMD() {
			let k = a(1) & 0xFFFF
			let l = a(0) & 0xFFFF
			if l >= zp0.nPoints || k >= zp1.nPoints {
				setA(0, 0)
				return
			}
			if opcode & 1 != 0 {
				setA(0, project(zp0.curX[l] - zp1.curX[k], zp0.curY[l] - zp1.curY[k]))
			} else {
				setA(0, originalDistance(zp0, l, zp1, k))
			}
		}

		internal def insMDRP() {
			let p = a(0) & 0xFFFF
			if p >= zp1.nPoints || gs.rp0 >= zp0.nPoints {
				gs.rp1 = gs.rp0
				gs.rp2 = p
				gs.rp0 = p when opcode & 16 != 0
				return
			}
			let orgDist = originalDistance(zp1, p, zp0, gs.rp0)
			if gs.singleWidthCutIn > 0 && orgDist < gs.singleWidthValue + gs.singleWidthCutIn && orgDist > gs.singleWidthValue - gs.singleWidthCutIn {
				orgDist = orgDist >= 0 ?? (gs.singleWidthValue, -gs.singleWidthValue)
			}
			let distance = opcode & 4 != 0 ?? (round(orgDist), roundNone(orgDist))
			if opcode & 8 != 0 {
				if orgDist >= 0 {
					distance = gs.minimumDistance when distance < gs.minimumDistance
				} else {
					distance = -gs.minimumDistance when distance > -gs.minimumDistance
				}
			}
			let cur = project(zp1.curX[p] - zp0.curX[gs.rp0], zp1.curY[p] - zp0.curY[gs.rp0])
			move(zp1, p, distance - cur)
			gs.rp1 = gs.rp0
			gs.rp2 = p
			gs.rp0 = p when opcode & 16 != 0
		}

		internal def insMIRP() {
			let p = a(0) & 0xFFFF
			let cvtEntry = a(1) + 1
			if p >= zp1.nPoints || cvtEntry < 0 || cvtEntry >= cvt.len() + 1 || gs.rp0 >= zp0.nPoints {
				gs.rp1 = gs.rp0
				gs.rp0 = p when opcode & 16 != 0
				gs.rp2 = p
				return
			}
			let cvtDist = cvtEntry == 0 ?? (0, cvt[cvtEntry - 1])
			if (cvtDist - gs.singleWidthValue).abs() < gs.singleWidthCutIn {
				cvtDist = cvtDist >= 0 ?? (gs.singleWidthValue, -gs.singleWidthValue)
			}
			if gs.gep1 == 0 {
				zp1.orgX[p] = zp0.orgX[gs.rp0] + mulFix14(cvtDist, gs.freeX)
				zp1.orgY[p] = zp0.orgY[gs.rp0] + mulFix14(cvtDist, gs.freeY)
				zp1.curX[p] = zp1.orgX[p]
				zp1.curY[p] = zp1.orgY[p]
			}
			let orgDist = dualProject(zp1.orgX[p] - zp0.orgX[gs.rp0], zp1.orgY[p] - zp0.orgY[gs.rp0])
			let curDist = project(zp1.curX[p] - zp0.curX[gs.rp0], zp1.curY[p] - zp0.curY[gs.rp0])
			if gs.autoFlip && (orgDist ^ cvtDist) < 0 {
				cvtDist = -cvtDist
			}
			let distance = 0
			if opcode & 4 != 0 {
				if gs.gep0 == gs.gep1 && (cvtDist - orgDist).abs() > gs.controlValueCutIn {
					cvtDist = orgDist
				}
				distance = round(cvtDist)
			} else {
				distance = roundNone(cvtDist)
			}
			if opcode & 8 != 0 {
				if orgDist >= 0 {
					distance = gs.minimumDistance when distance < gs.minimumDistance
				} else {
					distance = -gs.minimumDistance when distance > -gs.minimumDistance
				}
			}
			move(zp1, p, distance - curDist)
			gs.rp1 = gs.rp0
			gs.rp0 = p when opcode & 16 != 0
			gs.rp2 = p
		}

		internal def insALIGNRP() {
			if top < gs.loop || gs.rp0 >= zp0.nPoints {
				gs.loop = 1
				newTop = args
				return
			}
			for gs.loop > 0 {
				args--
				let p = stack[args] & 0xFFFF
				if p < zp1.nPoints {
					let d = project(zp1.curX[p] - zp0.curX[gs.rp0], zp1.curY[p] - zp0.curY[gs.rp0])
					move(zp1, p, -d)
				}
				gs.loop--
			}
			gs.loop = 1
			newTop = args
		}

		internal def insISECT() {
			let p = a(0) & 0xFFFF
			let a0 = a(1) & 0xFFFF
			let a1 = a(2) & 0xFFFF
			let b0 = a(3) & 0xFFFF
			let b1 = a(4) & 0xFFFF
			return when b0 >= zp0.nPoints || b1 >= zp0.nPoints || a0 >= zp1.nPoints || a1 >= zp1.nPoints || p >= zp2.nPoints
			let dbx = zp0.curX[b1] - zp0.curX[b0]
			let dby = zp0.curY[b1] - zp0.curY[b0]
			let dax = zp1.curX[a1] - zp1.curX[a0]
			let day = zp1.curY[a1] - zp1.curY[a0]
			let dx = zp0.curX[b0] - zp1.curX[a0]
			let dy = zp0.curY[b0] - zp1.curY[a0]
			let discriminant = mulDiv(dax, -dby, 0x40) + mulDiv(day, dbx, 0x40)
			let dotproduct = mulDiv(dax, dbx, 0x40) + mulDiv(day, dby, 0x40)
			if 19 * discriminant.abs() > dotproduct.abs() {
				let val = mulDiv(dx, -dby, 0x40) + mulDiv(dy, dbx, 0x40)
				zp2.curX[p] = zp1.curX[a0] + mulDiv(val, dax, discriminant)
				zp2.curY[p] = zp1.curY[a0] + mulDiv(val, day, discriminant)
			} else {
				zp2.curX[p] = (zp1.curX[a0] + zp1.curX[a1] + (zp0.curX[b0] + zp0.curX[b1])) / 4
				zp2.curY[p] = (zp1.curY[a0] + zp1.curY[a1] + (zp0.curY[b0] + zp0.curY[b1])) / 4
			}
			zp2.tags[p] |= tagTouchBoth
		}

		internal def insALIGNPTS() {
			let p1 = a(0) & 0xFFFF
			let p2 = a(1) & 0xFFFF
			return when p1 >= zp1.nPoints || p2 >= zp0.nPoints
			let distance = project(zp0.curX[p2] - zp1.curX[p1], zp0.curY[p2] - zp1.curY[p1]) / 2
			move(zp1, p1, distance)
			move(zp0, p2, -distance)
		}

		internal def insIP() {
			if top < gs.loop {
				gs.loop = 1
				newTop = args
				return
			}
			let twilightZone = gs.gep0 == 0 || gs.gep1 == 0 || gs.gep2 == 0
			if gs.rp1 >= zp0.nPoints {
				gs.loop = 1
				newTop = args
				return
			}
			let rp1 = gs.rp1
			let baseX = twilightZone ?? (zp0.orgX[rp1], zp0.orusX[rp1])
			let baseY = twilightZone ?? (zp0.orgY[rp1], zp0.orusY[rp1])
			let oldRange = 0
			let curRange = 0
			if gs.rp2 < zp1.nPoints {
				let rp2 = gs.rp2
				if twilightZone {
					oldRange = dualProject(zp1.orgX[rp2] - baseX, zp1.orgY[rp2] - baseY)
				} else if xScale == yScale {
					oldRange = dualProject(zp1.orusX[rp2] - baseX, zp1.orusY[rp2] - baseY)
				} else {
					oldRange = dualProject(mulFix(zp1.orusX[rp2] - baseX, xScale), mulFix(zp1.orusY[rp2] - baseY, yScale))
				}
				curRange = project(zp1.curX[rp2] - zp0.curX[rp1], zp1.curY[rp2] - zp0.curY[rp1])
			}
			for gs.loop > 0 {
				args--
				let p = stack[args]
				if p >= 0 && p < zp2.nPoints {
					let orgDist = 0
					if twilightZone {
						orgDist = dualProject(zp2.orgX[p] - baseX, zp2.orgY[p] - baseY)
					} else if xScale == yScale {
						orgDist = dualProject(zp2.orusX[p] - baseX, zp2.orusY[p] - baseY)
					} else {
						orgDist = dualProject(mulFix(zp2.orusX[p] - baseX, xScale), mulFix(zp2.orusY[p] - baseY, yScale))
					}
					let curDist = project(zp2.curX[p] - zp0.curX[rp1], zp2.curY[p] - zp0.curY[rp1])
					let newDist = 0
					if orgDist != 0 {
						newDist = oldRange != 0 ?? (mulDiv(orgDist, curRange, oldRange), orgDist)
					}
					move(zp2, p, newDist - curDist)
				}
				gs.loop--
			}
			gs.loop = 1
			newTop = args
		}

		internal def insUTP() {
			let p = a(0) & 0xFFFF
			return when p >= zp0.nPoints
			let mask = 0xFF
			mask &= ~tagTouchX when gs.freeX != 0
			mask &= ~tagTouchY when gs.freeY != 0
			zp0.tags[p] &= mask
		}

		// Interpolates untouched points between touched ones, per contour.
		internal def insIUP() {
			if backwardCompatibility {
				return when iupxCalled && iupyCalled
				if opcode & 1 != 0 {
					iupxCalled = true
				} else {
					iupyCalled = true
				}
			}
			return when pts.nContours() == 0
			let xAxis = opcode & 1 != 0
			let mask = xAxis ?? (tagTouchX, tagTouchY)
			let orgs = xAxis ?? (pts.orgX, pts.orgY)
			let curs = xAxis ?? (pts.curX, pts.curY)
			let orus = xAxis ?? (pts.orusX, pts.orusY)
			let point = 0
			for let contour = 0; contour < pts.nContours(); contour++ {
				let endPoint = pts.contours[contour]
				let firstPoint = point
				endPoint = pts.nPoints - 1 when endPoint < 0 || endPoint >= pts.nPoints
				for point <= endPoint && pts.tags[point] & mask == 0 {
					point++
				}
				if point <= endPoint {
					let firstTouched = point
					let curTouched = point
					point++
					for point <= endPoint {
						if pts.tags[point] & mask != 0 {
							iupInterpolate(orgs, curs, orus, curTouched + 1, point - 1, curTouched, point)
							curTouched = point
						}
						point++
					}
					if curTouched == firstTouched {
						iupShift(orgs, curs, firstPoint, endPoint, curTouched)
					} else {
						iupInterpolate(orgs, curs, orus, curTouched + 1, endPoint, curTouched, firstTouched)
						if firstTouched > 0 {
							iupInterpolate(orgs, curs, orus, firstPoint, firstTouched - 1, curTouched, firstTouched)
						}
					}
				}
			}
		}

		internal def iupShift(orgs int[], curs int[], p1 int, p2 int, p int) {
			let dx = curs[p] - orgs[p]
			return when dx == 0
			for let i = p1; i < p; i++ {
				curs[i] += dx
			}
			for let i = p + 1; i <= p2; i++ {
				curs[i] += dx
			}
		}

		internal def iupInterpolate(orgs int[], curs int[], orus int[], p1 int, p2 int, ref1 int, ref2 int) {
			return when p1 > p2
			return when ref1 >= pts.nPoints || ref2 >= pts.nPoints
			let orus1 = orus[ref1]
			let orus2 = orus[ref2]
			if orus1 > orus2 {
				let t = orus1
				orus1 = orus2
				orus2 = t
				let r = ref1
				ref1 = ref2
				ref2 = r
			}
			let org1 = orgs[ref1]
			let org2 = orgs[ref2]
			let cur1 = curs[ref1]
			let cur2 = curs[ref2]
			let delta1 = cur1 - org1
			let delta2 = cur2 - org2
			if cur1 == cur2 || orus1 == orus2 {
				for let i = p1; i <= p2; i++ {
					let x = orgs[i]
					if x <= org1 {
						x += delta1
					} else if x >= org2 {
						x += delta2
					} else {
						x = cur1
					}
					curs[i] = x
				}
				return
			}
			let scaleValid = false
			let s = 0
			for let i = p1; i <= p2; i++ {
				let x = orgs[i]
				if x <= org1 {
					x += delta1
				} else if x >= org2 {
					x += delta2
				} else {
					if !scaleValid {
						scaleValid = true
						s = divFix(cur2 - cur1, orus2 - orus1)
					}
					x = cur1 + mulFix(orus[i] - orus1, s)
				}
				curs[i] = x
			}
		}

		internal def insDELTAP() {
			let nump = a(0)
			for let k = 1; k <= nump; k++ {
				if args < 2 {
					args = 0
					break
				}
				args -= 2
				let point = stack[args + 1] & 0xFFFF
				let b = stack[args]
				if point < zp0.nPoints {
					let c = (b & 0xF0) >> 4
					c += 16 when opcode == 0x71
					c += 32 when opcode == 0x72
					c += gs.deltaBase
					if ppem == c {
						let d = (b & 0xF) - 8
						d++ when d >= 0
						d *= 1 << (6 - gs.deltaShift)
						if backwardCompatibility {
							if !(iupxCalled && iupyCalled) && ((isComposite && gs.freeY != 0) || zp0.tags[point] & tagTouchY != 0) {
								move(zp0, point, d)
							}
						} else {
							move(zp0, point, d)
						}
					}
				}
			}
			newTop = args
		}

		internal def insDELTAC() {
			let nump = a(0)
			for let k = 1; k <= nump; k++ {
				if args < 2 {
					args = 0
					break
				}
				args -= 2
				let entry = stack[args + 1]
				let b = stack[args]
				if entry >= 0 && entry < cvt.len() {
					let c = (b & 0xF0) >> 4
					c += 16 when opcode == 0x74
					c += 32 when opcode == 0x75
					c += gs.deltaBase
					if ppem == c {
						let d = (b & 0xF) - 8
						d++ when d >= 0
						d *= 1 << (6 - gs.deltaShift)
						cvtForWrite()
						cvt[entry] += d
					}
				}
			}
			newTop = args
		}
	}
}
