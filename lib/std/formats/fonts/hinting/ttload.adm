internal partial module std.formats.fonts.hinting {
	use (
		std.math::(sqrt)
		std.math.geom
		std.formats.fonts
	)

	// Composite component flags.
	const (
		argsAreWords     = 0x0001
		argsAreXY        = 0x0002
		roundXYToGrid    = 0x0004
		haveScale        = 0x0008
		moreComponents   = 0x0020
		haveXYScale      = 0x0040
		have2x2          = 0x0080
		haveInstructions = 0x0100
		useMyMetrics     = 0x0200
		scaledOffset     = 0x0800
	)

	// Big-endian reads from a table; 0 past the end.
	type Bytes {
		internal b byte[]

		def new(b byte[] = byte[]) {
			self.b = b
		}

		def len() int {
			return b.len()
		}

		def u8(at int) int {
			return at < 0 || at >= b.len() ?? (0, int(b[at]))
		}

		def u16(at int) int {
			return at < 0 || at + 2 > b.len() ?? (0, int(b[at]) << 8 | int(b[at + 1]))
		}

		def i16(at int) int {
			let v = u16(at)
			return v >= 0x8000 ?? (v - 0x10000, v)
		}

		def u32(at int) int {
			return at < 0 || at + 4 > b.len() ?? (0, int(b[at]) << 24 | int(b[at + 1]) << 16 | int(b[at + 2]) << 8 | int(b[at + 3]))
		}

		def slice(from int, to int) byte[] {
			return byte[] when from < 0 || to > b.len() || to <= from
			return b[from:to]
		}
	}

	// Which bytecode interpreter behaviour to reproduce.
	const (
		// Full hinting, both axes (the classic interpreter).
		modeFull  = 35
		// Vertical-only hinting: x moves are ignored (backward compatibility
		// with subpixel rendering).
		modeLight = 40
	)

	// The hinting data of a TrueType face: programs, CVT, metrics and glyph
	// locations, read once.
	type HintedFace {
		glyf               Bytes
		offsets            int[]
		hmtx               Bytes
		numberOfHMetrics   int
		vmtx               Bytes
		numberOfVMetrics   int
		hdmx               Bytes
		upem               int
		forcePpem          bool
		fixedPitch         bool
		typoAscender       int
		typoDescender      int
		hasOs2             bool
		ascender           int
		descender          int
		fpgm               byte[]
		prep               byte[]
		// Control values in 26.6, after `cvar` at a variable instance.
		cvt                int[]
		// The instance of a variable face; none at the default instance.
		variation          ?FtVariation
		maxFunctionDefs    int
		maxInstructionDefs int
		maxStorage         int
		maxStack           int
		maxTwilight        int
		numGlyphs          int
		// Prepared sizes, keyed by mode and 26.6 size.
		sizes              map<string, HintedSize>

		// `table` returns a table's bytes, or empty when the font lacks it;
		// `offsets` are the glyph offsets from loca (numGlyphs + 1 entries).
		def new(table def (string) byte[], offsets int[], instance map<string, float> = new map<string, float>()) {
			self.offsets = offsets
			if instance.len() > 0 {
				let v = new FtVariation(table, instance)
				variation = v when v.varied()
			}
			glyf = new Bytes(table("glyf"))
			let head = new Bytes(table("head"))
			upem = head.u16(18)
			forcePpem = head.u16(16) & 8 != 0
			let hhea = new Bytes(table("hhea"))
			ascender = hhea.i16(4)
			descender = hhea.i16(6)
			numberOfHMetrics = hhea.u16(34)
			hmtx = new Bytes(table("hmtx"))
			let vhea = new Bytes(table("vhea"))
			vmtx = new Bytes(table("vmtx"))
			numberOfVMetrics = vhea.len() >= 36 && vmtx.len() > 0 ?? (vhea.u16(34), 0)
			hdmx = new Bytes(table("hdmx"))
			let os2 = new Bytes(table("OS/2"))
			hasOs2 = os2.len() >= 72
			typoAscender = os2.i16(68)
			typoDescender = os2.i16(70)
			fixedPitch = new Bytes(table("post")).u32(12) != 0
			fpgm = table("fpgm")
			prep = table("prep")
			let cvtTable = new Bytes(table("cvt "))
			let units int[]
			for let i = 0; i + 2 <= cvtTable.len(); i += 2 {
				units.push(cvtTable.i16(i))
			}
			let v = variation
			if v is FtVariation {
				cvt = v.varyCvt(units)
				typoAscender = toShort(typoAscender + toShort(v.metricDelta("hasc")))
				typoDescender = toShort(typoDescender + toShort(v.metricDelta("hdsc")))
			} else {
				for let (_, u) in units {
					cvt.push(u * 64)
				}
			}
			let maxp = new Bytes(table("maxp"))
			numGlyphs = maxp.u16(4)
			maxTwilight = maxp.u16(16)
			maxStorage = maxp.u16(18)
			maxFunctionDefs = maxp.u16(20)
			maxInstructionDefs = maxp.u16(22)
			maxStack = maxp.u16(24)
		}

		// Advance width and left side bearing of a glyph, in font units; the
		// advance follows `HVAR` at a variable instance.
		def hMetrics(g int) (int, int) {
			let (advance, lsb) = rawHMetrics(g)
			let v = variation
			return (v.hvar.adjust(g, advance, v.coords), lsb) when v is FtVariation
			return (advance, lsb)
		}

		internal def rawHMetrics(g int) (int, int) {
			return (0, 0) when numberOfHMetrics == 0
			if g < numberOfHMetrics {
				return (hmtx.u16(g * 4), hmtx.i16(g * 4 + 2))
			}
			let last = numberOfHMetrics - 1
			return (hmtx.u16(last * 4), hmtx.i16(numberOfHMetrics * 4 + (g - numberOfHMetrics) * 2))
		}

		// Top side bearing and advance height, from vmtx (and `VVAR`) or the
		// ascender.
		def vMetrics(g int, yMax int) (int, int) {
			if numberOfVMetrics > 0 {
				let v = variation
				if g < numberOfVMetrics {
					let advance = vmtx.u16(g * 4)
					advance = v.vvar.adjust(g, advance, v.coords) when v is FtVariation
					return (vmtx.i16(g * 4 + 2), advance)
				}
				let last = numberOfVMetrics - 1
				let advance = vmtx.u16(last * 4)
				advance = v.vvar.adjust(g, advance, v.coords) when v is FtVariation
				return (vmtx.i16(numberOfVMetrics * 4 + (g - numberOfVMetrics) * 2), advance)
			}
			if hasOs2 {
				return (typoAscender - yMax, (typoAscender - typoDescender).abs())
			}
			return (ascender - yMax, (ascender - descender).abs())
		}

		// The hdmx width of a glyph at `ppem`, or -1 when not recorded.
		def deviceWidth(ppem int, g int) int {
			return -1 when hdmx.len() < 8
			let count = hdmx.u16(2)
			let size = hdmx.u32(4)
			for let i = 0; i < count; i++ {
				let rec = 8 + i * size
				return hdmx.u8(rec + 2 + g) when hdmx.u8(rec) == ppem && g < size - 2
			}
			return -1
		}

		// The glyph at `size` pixels per em hinted with `mode`, in pixels.
		def outline(glyph int, size float, mode int) !fonts.Outline {
			let charSize = int((size * 64.0).round())
			fail "size must be positive" when charSize <= 0
			let key = "{mode}/{charSize}"
			let cached = sizes.get(key)
			if cached is HintedSize {
				return cached.load(glyph)
			}
			let s = new HintedSize(self, charSize, mode)
			sizes[key] = s
			return s.load(glyph)
		}
	}

	// One face at one size and mode: scales and the interpreter after the
	// font and control value programs ran.
	type HintedSize {
		// The face this size belongs to, which owns it through `sizes`.
		weak face ?HintedFace
		mode      int
		ppem      int
		xScale    int
		yScale    int
		interp    Interpreter
		// False when a program failed: glyphs then load scaled only.
		ready     bool
		sizeGS    GraphicsState

		def new(face HintedFace, charSize int, mode int) {
			self.face = face
			self.mode = mode
			xScale = divFix(charSize, face.upem)
			yScale = xScale
			ppem = (charSize + 32) >> 6
			if face.forcePpem {
				xScale = divFix(ppem << 6, face.upem)
				yScale = xScale
			}
			interp = new Interpreter(mode, face.maxFunctionDefs, face.maxInstructionDefs, face.maxStack + 32, face.numGlyphs)
			interp.codes[rangeFont] = face.fpgm
			interp.codes[rangeCvt] = face.prep
			interp.twilight = new Zone(0, face.maxTwilight + 4)
			interp.sizeStorage.len(face.maxStorage)
			interp.sizeStorage.fill(0)
			interp.storage = interp.sizeStorage
			ready = runFontProgram(face) && runControlProgram(face, false) && runControlProgram(face, true)
		}

		// The font program runs once, with no size set.
		internal def runFontProgram(face HintedFace) bool {
			let it = interp
			it.ppem = 0
			it.scale = 0
			it.xScale = 0
			it.yScale = 0
			it.period = 64
			it.phase = 0
			it.threshold = 0
			it.fDotP = 0x4000
			it.gs = new GraphicsState()
			it.cvt = int[]
			it.sizeCvt = it.cvt
			return true when face.fpgm.len() == 0
			return it.run(rangeFont)
		}

		// The control value program scales the CVT for this size. The
		// reference runs it first with its rendering flags unset, then again
		// once a glyph asks for grayscale or subpixel output; the twilight
		// zone and storage carry over between the runs.
		internal def runControlProgram(face HintedFace, withFlags bool) bool {
			let it = interp
			it.ppem = ppem
			it.scale = xScale
			it.xScale = xScale
			it.yScale = yScale
			it.sizeCvt = int[]
			// The 26.6 values lose their fraction before scaling, as in the
			// reference.
			for let (_, v) in face.cvt {
				let units = v < 0 ?? (-((-v) >> 6), v >> 6)
				it.sizeCvt.push(mulFix(units, xScale))
			}
			it.cvt = it.sizeCvt
			it.cvtCopied = false
			it.storage = it.sizeStorage
			it.storageCopied = false
			if withFlags {
				if mode == modeFull {
					it.grayscale = true
				} else {
					it.subpixelLean = true
					it.grayscaleCleartype = true
				}
			} else {
				// Before the first run the state is the default.
				it.gs = new GraphicsState()
				for let i = 0; i < it.twilight.nPoints; i++ {
					it.twilight.orgX[i] = 0
					it.twilight.orgY[i] = 0
					it.twilight.curX[i] = 0
					it.twilight.curY[i] = 0
				}
			}
			if !withFlags {
				it.gs = new GraphicsState()
			} else {
				it.gs = sizeGS.clone()
			}
			let ok = face.prep.len() == 0 || it.run(rangeCvt)
			let g = it.gs
			g.dualX = 0x4000
			g.dualY = 0
			g.projX = 0x4000
			g.projY = 0
			g.freeX = 0x4000
			g.freeY = 0
			g.rp0 = 0
			g.rp1 = 0
			g.rp2 = 0
			g.gep0 = 1
			g.gep1 = 1
			g.gep2 = 1
			g.loop = 1
			sizeGS = g.clone()
			return ok
		}

		// -- glyph loading --------------------------------------------------------

		def load(glyph int) !fonts.Outline {
			let l = try prepare(glyph)
			return l.result(glyph)
		}

		// Loads a glyph's points, hinted when the programs are ready.
		def prepare(glyph int) !GlyphLoad {
			let owner = face
			if owner is none {
				fail "the hinted face was freed"
			}
			let l = new GlyphLoad(self, owner)
			l.hinted = ready && sizeGS.instructControl & 1 == 0
			// A glyph starts from prep's graphics state, or the default when
			// prep asked for that.
			l.startGS = sizeGS.instructControl & 2 != 0 ?? (new GraphicsState(), sizeGS)
			interp.backwardCompatibility = mode == modeLight && sizeGS.instructControl & 4 == 0
			// CVT and storage writes of the glyph's programs (components and
			// composite alike) share one copy, dropped after the glyph.
			interp.cvt = interp.sizeCvt
			interp.cvtCopied = false
			interp.storage = interp.sizeStorage
			interp.storageCopied = false
			try l.loadGlyph(glyph, 0)
			return l
		}
	}

	// The state of loading one glyph: accumulated points and phantoms.
	type GlyphLoad {
		size     HintedSize
		face     HintedFace
		hinted   bool
		startGS  GraphicsState
		xs       int[]
		ys       int[]
		on       bool[]
		contours int[]
		pp       int[]

		def new(size HintedSize, face HintedFace) {
			self.size = size
			self.face = face
			pp.len(8)
		}

		// The phantom points from metrics, in font units.
		internal def setPhantoms(g int, xMin int, yMax int) {
			let (advance, lsb) = face.hMetrics(g)
			let (tsb, vadvance) = face.vMetrics(g, yMax)
			pp[0] = xMin - lsb
			pp[1] = 0
			pp[2] = pp[0] + advance
			pp[3] = 0
			pp[4] = 0
			pp[5] = yMax + tsb
			pp[6] = 0
			pp[7] = pp[5] - vadvance
			if size.mode == modeLight {
				pp[4] = advance / 2
				pp[6] = advance / 2
			}
		}

		internal def scalePhantoms() {
			for let i = 0; i < 8; i += 2 {
				pp[i] = mulFix(pp[i], size.xScale)
				pp[i + 1] = mulFix(pp[i + 1], size.yScale)
			}
		}

		// Loads glyph `g` and appends its points.
		def loadGlyph(g int, depth int) !none {
			fail "composite glyphs nest too deeply" when depth > 16
			fail "glyph {g} is out of range" when g < 0 || g + 1 >= face.offsets.len()
			let from = face.offsets[g]
			let to = face.offsets[g + 1]
			let d = face.glyf
			if to <= from || to - from < 10 || d.i16(from) == 0 {
				// An empty glyph: only its phantom points.
				setPhantoms(g, 0, 0)
				try varyPhantoms(g, int[], int[], int[])
				scalePhantoms()
				return none
			}
			let nContours = d.i16(from)
			let xMin = d.i16(from + 2)
			let yMax = d.i16(from + 8)
			setPhantoms(g, xMin, yMax)
			if nContours > 0 {
				try loadSimple(g, from, to, nContours)
				return none
			}
			try loadComposite(g, from, to, depth)
		}

		// Moves the phantom points, after `points` (font units) whose contours
		// end at `ends`, to the variable instance; the points move with them.
		// Returns the unrounded positions in 26.6, none at the default
		// instance.
		internal def varyPhantoms(g int, xs int[], ys int[], ends int[]) !?(int[], int[]) {
			let v = face.variation
			return none unless v is FtVariation
			for let k = 0; k < 4; k++ {
				xs.push(pp[k * 2])
				ys.push(pp[k * 2 + 1])
			}
			let (ux, uy) = try v.applyGlyph(g, xs, ys, ends)
			let n = xs.len() - 4
			for let k = 0; k < 4; k++ {
				pp[k * 2] = xs[n + k]
				pp[k * 2 + 1] = ys[n + k]
			}
			xs.len(n)
			ys.len(n)
			return (ux, uy)
		}

		internal def loadSimple(g int, from int, to int, nContours int) !none {
			let d = face.glyf
			let at = from + 10
			let ends int[]
			for let i = 0; i < nContours; i++ {
				ends.push(d.u16(at))
				at += 2
			}
			let n = ends[nContours - 1] + 1
			let nIns = d.u16(at)
			at += 2
			fail "glyph instructions run past the glyph" when at + nIns > to
			let ins = d.slice(at, at + nIns)
			at += nIns
			let flags int[]
			for flags.len() < n {
				let f = d.u8(at)
				at++
				flags.push(f)
				if f & 0x08 != 0 {
					let r = d.u8(at)
					at++
					for let k = 0; k < r && flags.len() < n; k++ {
						flags.push(f)
					}
				}
			}
			let px int[]
			let x = 0
			for let i = 0; i < n; i++ {
				let f = flags[i]
				if f & 0x02 != 0 {
					let v = d.u8(at)
					at++
					x += f & 0x10 != 0 ?? (v, -v)
				} else if f & 0x10 == 0 {
					x += d.i16(at)
					at += 2
				}
				px.push(x)
			}
			let py int[]
			let y = 0
			for let i = 0; i < n; i++ {
				let f = flags[i]
				if f & 0x04 != 0 {
					let v = d.u8(at)
					at++
					y += f & 0x20 != 0 ?? (v, -v)
				} else if f & 0x20 == 0 {
					y += d.i16(at)
					at += 2
				}
				py.push(y)
			}

			// At a variable instance the points move first; they scale from
			// their unrounded positions.
			let original = pp.clone()
			let unrounded = try varyPhantoms(g, px, py, ends)

			// The zone: the glyph's points plus the four phantoms.
			let zone = new Zone(1, n + 4)
			for let i = 0; i < n; i++ {
				zone.orusX[i] = px[i]
				zone.orusY[i] = py[i]
				zone.tags[i] = flags[i] & 1
			}
			for let k = 0; k < 4; k++ {
				zone.orusX[n + k] = pp[k * 2]
				zone.orusY[n + k] = pp[k * 2 + 1]
			}
			zone.contours = ends
			if !(unrounded is none) {
				let (ux, uy) = unrounded
				for let i = 0; i < n + 4; i++ {
					zone.curX[i] = (mulFix(ux[i], size.xScale) + 32) >> 6
					zone.curY[i] = (mulFix(uy[i], size.yScale) + 32) >> 6
				}
			} else {
				for let i = 0; i < n + 4; i++ {
					zone.curX[i] = mulFix(zone.orusX[i], size.xScale)
					zone.curY[i] = mulFix(zone.orusY[i], size.yScale)
				}
			}
			for let k = 0; k < 4; k++ {
				pp[k * 2] = zone.curX[n + k]
				pp[k * 2 + 1] = zone.curY[n + k]
			}
			// Advances `HVAR`/`VVAR` already adjusted keep their unvaried
			// phantom points, scaled.
			let v = face.variation
			if v is FtVariation {
				if v.hvar.present {
					pp[0] = mulFix(original[0], size.xScale)
					pp[2] = mulFix(original[2], size.xScale)
				}
				if v.vvar.present {
					for let k = 4; k < 8; k += 2 {
						pp[k] = mulFix(original[k], size.xScale)
						pp[k + 1] = mulFix(original[k + 1], size.yScale)
					}
				}
			}
			hint(zone, ins, false) when hinted

			let base = xs.len()
			for let i = 0; i < n; i++ {
				xs.push(zone.curX[i])
				ys.push(zone.curY[i])
				on.push(zone.tags[i] & tagOn != 0)
			}
			for let (_, e) in ends {
				contours.push(base + e)
			}
		}

		// Runs a glyph program over `zone` (whose last four points are the
		// phantoms) and takes the hinted phantoms.
		internal def hint(zone Zone, ins byte[], composite bool) {
			let it = size.interp
			let n = zone.nPoints
			if ins.len() > 0 {
				for let i = 0; i < n; i++ {
					zone.orgX[i] = zone.curX[i]
					zone.orgY[i] = zone.curY[i]
				}
			}
			if composite {
				it.xScale = 1 << 16
				it.yScale = 1 << 16
				for let i = 0; i < n; i++ {
					zone.orusX[i] = zone.curX[i]
					zone.orusY[i] = zone.curY[i]
				}
			} else {
				it.xScale = size.xScale
				it.yScale = size.yScale
			}
			zone.curX[n - 4] = pixRound(zone.curX[n - 4])
			zone.curX[n - 3] = pixRound(zone.curX[n - 3])
			zone.curY[n - 2] = pixRound(zone.curY[n - 2])
			zone.curY[n - 1] = pixRound(zone.curY[n - 1])
			if ins.len() > 0 {
				it.gs = startGS.clone()
				it.codes[rangeGlyph] = ins
				it.pts = zone
				it.zp0 = zone
				it.zp1 = zone
				it.zp2 = zone
				it.isComposite = composite
				let g = it.gs
				g.gep0 = 1
				g.gep1 = 1
				g.gep2 = 1
				g.projX = 0x4000
				g.projY = 0
				g.freeX = 0x4000
				g.freeY = 0
				g.dualX = 0x4000
				g.dualY = 0
				g.roundState = roundGrid
				g.loop = 1
				// Errors are not fatal: the points keep what ran.
				it.run(rangeGlyph)
			}
			return when size.mode == modeLight && it.backwardCompatibility
			for let k = 0; k < 4; k++ {
				pp[k * 2] = zone.curX[n - 4 + k]
				pp[k * 2 + 1] = zone.curY[n - 4 + k]
			}
		}

		internal def loadComposite(g int, from int, to int, depth int) !none {
			let d = face.glyf
			let startPoint = xs.len()
			let startContour = contours.len()
			let at = from + 10
			let lastFlags = 0
			let flagsList int[]
			let glyphs int[]
			let arg1s int[]
			let arg2s int[]
			let xx int[]
			let yx int[]
			let xy int[]
			let yy int[]
			for {
				let flags = d.u16(at)
				let glyph = d.u16(at + 2)
				at += 4
				let a1 = 0
				let a2 = 0
				if flags & argsAreWords != 0 {
					a1 = flags & argsAreXY != 0 ?? (d.i16(at), d.u16(at))
					a2 = flags & argsAreXY != 0 ?? (d.i16(at + 2), d.u16(at + 2))
					at += 4
				} else {
					a1 = d.u8(at)
					a2 = d.u8(at + 1)
					if flags & argsAreXY != 0 {
						a1 = a1 >= 128 ?? (a1 - 256, a1)
						a2 = a2 >= 128 ?? (a2 - 256, a2)
					}
					at += 2
				}
				// 2.14 components as 16.16.
				let m = [0x10000, 0, 0, 0x10000]
				if flags & haveScale != 0 {
					m[0] = d.i16(at) << 2
					m[3] = m[0]
					at += 2
				} else if flags & haveXYScale != 0 {
					m[0] = d.i16(at) << 2
					m[3] = d.i16(at + 2) << 2
					at += 4
				} else if flags & have2x2 != 0 {
					m[0] = d.i16(at) << 2
					m[1] = d.i16(at + 2) << 2
					m[2] = d.i16(at + 4) << 2
					m[3] = d.i16(at + 6) << 2
					at += 8
				}
				flagsList.push(flags)
				glyphs.push(glyph)
				arg1s.push(a1)
				arg2s.push(a2)
				xx.push(m[0])
				yx.push(m[1])
				xy.push(m[2])
				yy.push(m[3])
				lastFlags = flags
				break when flags & moreComponents == 0 || at >= to
			}
			let insAt = at

			// At a variable instance the component offsets move like points,
			// each its own contour.
			let components = flagsList.len()
			let cx = arg1s.clone()
			let cy = arg2s.clone()
			let ends int[]
			for let i = 0; i < components; i++ {
				ends.push(i)
			}
			if !((try varyPhantoms(g, cx, cy, ends)) is none) {
				for let i = 0; i < components; i++ {
					if flagsList[i] & argsAreXY != 0 {
						arg1s[i] = toShort(cx[i])
						arg2s[i] = toShort(cy[i])
					}
				}
			}
			scalePhantoms()

			for let (i, flags) in flagsList {
				let saved = pp.clone()
				let numBase = xs.len()
				try loadGlyph(glyphs[i], depth + 1)
				if flags & useMyMetrics == 0 {
					pp = saved
				}
				continue when xs.len() == numBase
				placeComponent(flags, arg1s[i], arg2s[i], xx[i], xy[i], yx[i], yy[i], startPoint, numBase)
			}

			if hinted && lastFlags & haveInstructions != 0 && xs.len() > startPoint {
				let nIns = d.u16(insAt)
				return none when nIns == 0
				fail "composite instructions run past the glyph" when insAt + 2 + nIns > to
				let ins = d.slice(insAt + 2, insAt + 2 + nIns)
				let n = xs.len() - startPoint
				let zone = new Zone(1, n + 4)
				for let i = 0; i < n; i++ {
					zone.curX[i] = xs[startPoint + i]
					zone.curY[i] = ys[startPoint + i]
					zone.tags[i] = on[startPoint + i] ?? (tagOn, 0)
				}
				for let k = 0; k < 4; k++ {
					zone.curX[n + k] = pp[k * 2]
					zone.curY[n + k] = pp[k * 2 + 1]
				}
				for let c = startContour; c < contours.len(); c++ {
					zone.contours.push(contours[c] - startPoint)
				}
				hint(zone, ins, true)
				for let i = 0; i < n; i++ {
					xs[startPoint + i] = zone.curX[i]
					ys[startPoint + i] = zone.curY[i]
					on[startPoint + i] = zone.tags[i] & tagOn != 0
				}
			}
		}

		// Transforms and offsets a loaded component (points numBase..end).
		internal def placeComponent(flags int, a1 int, a2 int, xx int, xy int, yx int, yy int, startPoint int, numBase int) {
			let scaled = flags & (haveScale | haveXYScale | have2x2) != 0
			if scaled {
				for let i = numBase; i < xs.len(); i++ {
					let x = xs[i]
					let y = ys[i]
					xs[i] = mulFix(x, xx) + mulFix(y, xy)
					ys[i] = mulFix(x, yx) + mulFix(y, yy)
				}
			}
			let dx = 0
			let dy = 0
			if flags & argsAreXY == 0 {
				let k = a1 + startPoint
				let l = a2 + numBase
				return when k >= numBase || l >= xs.len()
				dx = xs[k] - xs[l]
				dy = ys[k] - ys[l]
			} else {
				dx = a1
				dy = a2
				return when dx == 0 && dy == 0
				if scaled && flags & scaledOffset != 0 {
					dx = mulFix(dx, hypot(xx, xy))
					dy = mulFix(dy, hypot(yy, yx))
				}
				dx = mulFix(dx, size.xScale)
				dy = mulFix(dy, size.yScale)
				if flags & roundXYToGrid != 0 && hinted {
					dx = pixRound(dx) when size.mode == modeFull
					dy = pixRound(dy)
				}
			}
			return when dx == 0 && dy == 0
			for let i = numBase; i < xs.len(); i++ {
				xs[i] += dx
				ys[i] += dy
			}
		}

		internal def hypot(a int, b int) int {
			let fa = float(a)
			let fb = float(b)
			return int(sqrt(fa * fa + fb * fb).round())
		}

		// The loaded glyph as an outline in pixels, origin at the left
		// phantom point.
		def result(g int) fonts.Outline {
			let shift = pp[0]
			let advance = pp[2] - pp[0]
			if hinted && !(size.mode == modeLight && size.interp.backwardCompatibility) && !face.fixedPitch {
				let w = face.deviceWidth(size.ppem, g)
				advance = w * 64 when w >= 0
			}
			let o = new fonts.Outline()
			o.advance = float(pixRound(advance)) / 64.0
			let start = 0
			for let (_, end) in contours {
				emitContour(o.segments, start, end, shift)
				start = end + 1
			}
			return o
		}

		// One contour of on/off-curve quadratic points as segments.
		internal def emitContour(segs fonts.Segment[], first int, last int, shift int) {
			let n = last - first + 1
			return when n <= 0
			let px = (i int) => float(xs[first + i] - shift) / 64.0
			let py = (i int) => float(ys[first + i]) / 64.0
			let startIdx = -1
			for let i = 0; i < n; i++ {
				if on[first + i] {
					startIdx = i
					break
				}
			}
			let sx = 0.0
			let sy = 0.0
			if startIdx < 0 {
				sx = (px(n - 1) + px(0)) / 2.0
				sy = (py(n - 1) + py(0)) / 2.0
				startIdx = 0
			} else {
				sx = px(startIdx)
				sy = py(startIdx)
				startIdx++
			}
			segs.push(fonts.Segment{kind: fonts.SegmentKind.Move, to: geom.Point{x: sx, y: sy}})
			let cx = 0.0
			let cy = 0.0
			let haveControl = false
			for let k = 0; k < n; k++ {
				let i = (startIdx + k) % n
				let x = px(i)
				let y = py(i)
				if on[first + i] {
					if haveControl {
						segs.push(fonts.Segment{kind: fonts.SegmentKind.Quadratic, to: geom.Point{x: x, y: y}, control1: geom.Point{x: cx, y: cy}})
						haveControl = false
					} else {
						segs.push(fonts.Segment{kind: fonts.SegmentKind.Line, to: geom.Point{x: x, y: y}})
					}
					continue
				}
				if haveControl {
					segs.push(fonts.Segment{kind: fonts.SegmentKind.Quadratic, to: geom.Point{x: (cx + x) / 2.0, y: (cy + y) / 2.0}, control1: geom.Point{x: cx, y: cy}})
				}
				cx = x
				cy = y
				haveControl = true
			}
			if haveControl {
				segs.push(fonts.Segment{kind: fonts.SegmentKind.Quadratic, to: geom.Point{x: sx, y: sy}, control1: geom.Point{x: cx, y: cy}})
			}
			segs.push(fonts.Segment{kind: fonts.SegmentKind.Close})
		}
	}
}
