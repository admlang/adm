// Font variations the way FreeType applies them to TrueType glyphs it hints:
// 16.16 normalized coordinates, fixed-point tuple scalars, deltas inferred
// per tuple, `cvar` on the control values and `HVAR`/`VVAR`/`MVAR` metric
// adjustments rounded to whole units. Hinted outlines of an instance depend
// on every one of these roundings, so they are FreeType's rather than the
// single-precision arithmetic the font-unit outlines use.

internal partial module std.formats.fonts.hinting {
	internal const (
		ftEmbeddedPeak  = 0x8000
		ftIntermediate  = 0x4000
		ftPrivatePoints = 0x2000
		ftTupleIndex    = 0x0FFF
		ftSharedPoints  = 0x8000
		ftTupleCount    = 0x0FFF
	)

	// A variable face at one instance, as FreeType's TrueType driver sees it.
	type FtVariation {
		// Normalized coordinates, 16.16, one per axis.
		coords       int[]
		axisCount    int
		gvar         Bytes
		// Glyph variation data ranges, FreeType-sanitized.
		glyphStarts  int[]
		sharedTuples int[]
		cvar         Bytes
		hvar         FtMetricsVariation
		vvar         FtMetricsVariation
		mvar         Bytes
		mvarStore    FtItemStore

		// The instance at `user` (design coordinates keyed by axis tag; a tag
		// sets every axis carrying it) of the face whose tables `table` gives.
		def new(table def (string) byte[], user map<string, float>) {
			let fvar = new Bytes(table("fvar"))
			axisCount = fvar.len() >= 16 ?? (fvar.u16(8), 0)
			let axesAt = fvar.u16(4)
			let axisSize = fvar.u16(10)
			let design int[]
			let mins int[]
			let defs int[]
			let maxs int[]
			for let i = 0; i < axisCount; i++ {
				let a = axesAt + i * axisSize
				let lo = int32(fvar.u32(a + 4))
				let initial = int32(fvar.u32(a + 8))
				let hi = int32(fvar.u32(a + 12))
				if lo > initial || initial > hi {
					lo = initial
					hi = initial
				}
				mins.push(lo)
				defs.push(initial)
				maxs.push(hi)
				let tag = string(fvar.slice(a, a + 4))
				let v = user.get(tag)
				design.push(v is none ?? (initial, roundAway(v * 65536.0)))
			}
			for let i = 0; i < axisCount; i++ {
				let c = design[i]
				let n = 0
				if c > defs[i] {
					n = c >= maxs[i] ?? (0x10000, divFix(c - defs[i], maxs[i] - defs[i]))
				} else if c < defs[i] {
					n = c <= mins[i] ?? (-0x10000, divFix(c - defs[i], defs[i] - mins[i]))
				}
				coords.push(n)
			}
			applyAvar(new Bytes(table("avar")))

			gvar = new Bytes(table("gvar"))
			loadGvar()
			cvar = new Bytes(table("cvar"))
			hvar = new FtMetricsVariation(new Bytes(table("HVAR")), axisCount)
			vvar = new FtMetricsVariation(new Bytes(table("VVAR")), axisCount)
			mvar = new Bytes(table("MVAR"))
			mvarStore = new FtItemStore(mvar, 0, axisCount)
			if mvar.len() >= 12 && mvar.u16(0) == 1 {
				mvarStore = new FtItemStore(mvar, mvar.u16(10), axisCount)
			}
		}

		// Whether the instance is off the default.
		def varied() bool {
			for let (_, c) in coords {
				return true when c != 0
			}
			return false
		}

		// The `avar` segment maps, then (version 2) its item variation deltas.
		internal def applyAvar(d Bytes) {
			return when d.len() < 8
			let major = d.u16(0)
			return when major != 1 && major != 2
			return when d.u16(6) != axisCount
			let at = 8
			let segments int[]
			for let i = 0; i < axisCount; i++ {
				let pairs = d.u16(at)
				return when pairs * 4 > d.len()
				segments.push(at)
				at += 2 + pairs * 4
			}
			for let (i, s) in segments {
				let pairs = d.u16(s)
				for let j = 1; j < pairs; j++ {
					let from = d.i16(s + 2 + j * 4) << 2
					if coords[i] < from {
						let pf = d.i16(s + 2 + (j - 1) * 4) << 2
						let pt = d.i16(s + 4 + (j - 1) * 4) << 2
						let to = d.i16(s + 4 + j * 4) << 2
						coords[i] = mulDiv(coords[i] - pf, to - pt, from - pf) + pt
						break
					}
				}
			}
			return when major < 2 || at + 8 > d.len()
			let mapAt = d.u32(at)
			let storeAt = d.u32(at + 4)
			return when storeAt == 0
			let store = new FtItemStore(d, storeAt, axisCount)
			return unless store.valid
			let indexMap = new FtIndexMap(d, mapAt, store)
			let out int[]
			for let i = 0; i < axisCount; i++ {
				let (outer, inner) = indexMap.present ?? (indexMap.lookup(i), (0, i))
				let v = coords[i] + store.delta(outer, inner, coords) * 4
				out.push(v.clamp(-0x10000, 0x10000))
			}
			coords = out
		}

		// The glyph data offsets, made monotonic and kept inside the table.
		internal def loadGvar() {
			let d = gvar
			return when d.len() < 20 || d.u32(0) != 0x00010000 || d.u16(4) != axisCount
			let sharedCount = d.u16(6)
			return when sharedCount * axisCount > d.len() / 2
			let glyphs = d.u16(12)
			let long = d.u16(14) & 1 != 0
			let dataAt = d.u32(16)
			return when (glyphs + 1) * (long ?? (4, 2)) > d.len()
			let highest = 0
			for let i = 0; i <= glyphs; i++ {
				let off = dataAt + (long ?? (d.u32(20 + i * 4), d.u16(20 + i * 2) * 2))
				if highest <= off {
					highest = off
				} else {
					off = highest
				}
				off = d.len() when d.len() < off
				glyphStarts.push(off)
			}
			let sharedAt = d.u32(8)
			for let i = 0; i < sharedCount * axisCount; i++ {
				sharedTuples.push(d.i16(sharedAt + i * 2) << 2)
			}
		}

		// How much a tuple applies at this instance, 16.16.
		internal def tupleScalar(index int, peak int[], start int[], end int[]) int {
			let apply = 0x10000
			for let i = 0; i < axisCount; i++ {
				let ncv = coords[i]
				continue when peak[i] == ncv || peak[i] == 0
				if index & ftIntermediate == 0 {
					if (peak[i] > ncv && ncv > 0) || (peak[i] < ncv && ncv < 0) {
						apply = mulDiv(apply, ncv, peak[i])
					} else {
						return 0
					}
				} else {
					return 0 when ncv <= start[i] || ncv >= end[i]
					if ncv < peak[i] {
						apply = mulDiv(apply, ncv - start[i], peak[i] - start[i])
					} else {
						apply = mulDiv(apply, end[i] - ncv, end[i] - peak[i])
					}
				}
			}
			return apply
		}

		// Moves glyph `g`'s points in place: `xs`/`ys` are font units, the
		// last four the phantom points, `ends` the contour end indices.
		// Returns the unrounded positions in 26.6. Fails when the variation
		// data is malformed.
		def applyGlyph(g int, xs int[], ys int[], ends int[]) !(int[], int[]) {
			let n = xs.len()
			let ux int[]
			let uy int[]
			for let i = 0; i < n; i++ {
				ux.push(xs[i] * 64)
				uy.push(ys[i] * 64)
			}
			return (ux, uy) when g + 1 >= glyphStarts.len() || glyphStarts[g] == glyphStarts[g + 1]
			let d = gvar
			let start = glyphStarts[g]
			let size = glyphStarts[g + 1] - start
			let header = d.u16(start)
			let tuples = header & ftTupleCount
			let dataOffset = d.u16(start + 2)
			fail "glyph {g} has an invalid variation header" when dataOffset > size || tuples * 4 > size
			let limit = start + size
			let data = start + dataOffset
			let shared int[]
			let sharedOk = true
			if header & ftSharedPoints != 0 {
				let (ok, next) = ftReadPoints(d, data, limit, shared)
				sharedOk = ok
				data = next
			}

			let dx int[]
			let dy int[]
			dx.len(n)
			dy.len(n)
			dx.fill(0)
			dy.fill(0)
			let orgX int[]
			let orgY int[]
			for let i = 0; i < n; i++ {
				orgX.push(xs[i] << 16)
				orgY.push(ys[i] << 16)
			}

			let at = start + 4
			for let t = 0; t < tuples; t++ {
				let dataSize = d.u16(at)
				let index = d.u16(at + 2)
				at += 4
				let peak int[]
				if index & ftEmbeddedPeak != 0 {
					for let j = 0; j < axisCount; j++ {
						peak.push(d.i16(at) << 2)
						at += 2
					}
				} else {
					let k = index & ftTupleIndex
					fail "glyph {g} names a missing shared tuple" when (k + 1) * axisCount > sharedTuples.len()
					peak = sharedTuples[k * axisCount:(k + 1) * axisCount]
				}
				let lo int[]
				let hi int[]
				if index & ftIntermediate != 0 {
					for let j = 0; j < axisCount; j++ {
						lo.push(d.i16(at) << 2)
						at += 2
					}
					for let j = 0; j < axisCount; j++ {
						hi.push(d.i16(at) << 2)
						at += 2
					}
				}
				let apply = tupleScalar(index, peak, lo, hi)
				if apply == 0 {
					data += dataSize
					continue
				}
				let p = data
				let points = shared
				let ok = sharedOk
				if index & ftPrivatePoints != 0 {
					let own int[]
					let (pok, next) = ftReadPoints(d, p, limit, own)
					ok = pok
					p = next
					points = own
				}
				let count = points.len() == 0 ?? (n, points.len())
				let xd int[]
				let yd int[]
				xd.len(count)
				yd.len(count)
				let (okX, afterX) = ftReadDeltas(d, p, limit, xd)
				let (okY, _) = ftReadDeltas(d, afterX, limit, yd)
				data += dataSize
				continue unless ok && okX && okY

				if points.len() == 0 {
					for let j = 0; j < n; j++ {
						dx[j] += mulFix(xd[j], apply)
						dy[j] += mulFix(yd[j], apply)
					}
					continue
				}
				let has bool[]
				has.len(n)
				has.fill(false)
				let outX = orgX.clone()
				let outY = orgY.clone()
				for let (j, idx) in points {
					continue when idx >= n
					has[idx] = true
					outX[idx] += mulFix(xd[j], apply)
					outY[idx] += mulFix(yd[j], apply)
				}
				interpolateDeltas(ends, outX, orgX, has)
				interpolateDeltas(ends, outY, orgY, has)
				for let j = 0; j < n; j++ {
					dx[j] += outX[j] - orgX[j]
					dy[j] += outY[j] - orgY[j]
				}
			}

			if hvar.present {
				dx[n - 4] = 0
				dy[n - 4] = 0
				dx[n - 3] = 0
				dy[n - 3] = 0
			}
			if vvar.present {
				dx[n - 2] = 0
				dy[n - 2] = 0
				dx[n - 1] = 0
				dy[n - 1] = 0
			}
			for let i = 0; i < n; i++ {
				ux[i] += (dx[i] + 0x200) >> 10
				uy[i] += (dy[i] + 0x200) >> 10
				xs[i] += toShort((dx[i] + 0x8000) >> 16)
				ys[i] += toShort((dy[i] + 0x8000) >> 16)
			}
			return (ux, uy)
		}

		// The control values in 26.6 after `cvar`.
		def varyCvt(cvt int[]) int[] {
			let out int[]
			for let (_, v) in cvt {
				out.push(v * 64)
			}
			let d = cvar
			return out when d.len() < 8 || d.u32(0) != 0x00010000 || cvt.len() == 0
			let header = d.u16(4)
			let tuples = header & ftTupleCount
			let data = d.u16(6)
			return out when data + tuples * 4 > d.len()
			let limit = d.len()
			let shared int[]
			let sharedOk = true
			if header & ftSharedPoints != 0 {
				let (ok, next) = ftReadPoints(d, data, limit, shared)
				sharedOk = ok
				data = next
			}
			let deltas int[]
			deltas.len(cvt.len())
			deltas.fill(0)
			let at = 8
			for let t = 0; t < tuples; t++ {
				let dataSize = d.u16(at)
				let index = d.u16(at + 2)
				at += 4
				let peak int[]
				if index & ftEmbeddedPeak != 0 {
					for let j = 0; j < axisCount; j++ {
						peak.push(d.i16(at) << 2)
						at += 2
					}
				} else {
					let k = index & ftTupleIndex
					return out when (k + 1) * axisCount > sharedTuples.len()
					peak = sharedTuples[k * axisCount:(k + 1) * axisCount]
				}
				let lo int[]
				let hi int[]
				if index & ftIntermediate != 0 {
					for let j = 0; j < axisCount; j++ {
						lo.push(d.i16(at) << 2)
						at += 2
					}
					for let j = 0; j < axisCount; j++ {
						hi.push(d.i16(at) << 2)
						at += 2
					}
				}
				let apply = tupleScalar(index, peak, lo, hi)
				if apply == 0 {
					data += dataSize
					continue
				}
				let p = data
				let points = shared
				let ok = sharedOk
				let private = index & ftPrivatePoints != 0
				if private {
					let own int[]
					let (pok, next) = ftReadPoints(d, p, limit, own)
					ok = pok
					p = next
					points = own
				}
				let values int[]
				values.len(points.len() == 0 ?? (cvt.len(), points.len()))
				let (okD, _) = ftReadDeltas(d, p, limit, values)
				data += dataSize
				continue unless ok && okD
				if private && points.len() == 0 {
					for let j = 0; j < cvt.len(); j++ {
						deltas[j] += mulFix(values[j], apply)
					}
				} else {
					for let (j, idx) in points {
						continue when idx >= cvt.len()
						deltas[idx] += mulFix(values[j], apply)
					}
				}
			}
			for let i = 0; i < out.len(); i++ {
				out[i] += (deltas[i] + 0x200) >> 10
			}
			return out
		}

		// An `MVAR` value's rounded delta, 0 when the table does not vary it.
		def metricDelta(tag string) int {
			let d = mvar
			return 0 when d.len() < 12 || d.u16(0) != 1 || !mvarStore.valid
			let size = d.u16(6)
			let count = d.u16(8)
			for let i = 0; i < count; i++ {
				let r = 12 + i * size
				continue unless string(d.slice(r, r + 4)) == tag
				return mvarStore.delta(d.u16(r + 4), d.u16(r + 6), coords)
			}
			return 0
		}
	}

	// C's (FT_Short) cast: the low 16 bits, signed.
	def toShort(v int) int {
		let w = v & 0xFFFF
		return w >= 0x8000 ?? (w - 0x10000, w)
	}

	// Rounds half away from zero, as C's lround.
	def roundAway(v float) int {
		return v < 0.0 ?? (-int((-v + 0.5).floor()), int((v + 0.5).floor()))
	}

	// Packed point numbers into `out`, FreeType's way: a run longer than the
	// count left is cut short. An empty list means every point.
	def ftReadPoints(d Bytes, p int, limit int, out int[]) (bool, int) {
		return (false, p) when p >= limit
		let n = d.u8(p)
		p++
		return (true, p) when n == 0
		if n & 0x80 != 0 {
			n = ((n & 0x7F) << 8) | d.u8(p)
			p++
		}
		let first = 0
		let i = 0
		for i < n {
			return (false, p) when p >= limit
			let run = d.u8(p)
			p++
			let cnt = (run & 0x7F) + 1
			cnt = n - i when cnt > n - i
			if run & 0x80 != 0 {
				return (false, p) when 2 * cnt > limit - p
				for let j = 0; j < cnt; j++ {
					first = (first + d.u16(p)) & 0xFFFF
					p += 2
					out.push(first)
					i++
				}
			} else {
				return (false, p) when cnt > limit - p
				for let j = 0; j < cnt; j++ {
					first = (first + d.u8(p)) & 0xFFFF
					p++
					out.push(first)
					i++
				}
			}
		}
		return (true, p)
	}

	// Packed deltas into `out` as 16.16 values. Only zero, byte and word
	// runs exist here: a run with both size bits set reads as zeros.
	def ftReadDeltas(d Bytes, p int, limit int, out int[]) (bool, int) {
		let count = out.len()
		let i = 0
		for i < count {
			return (false, p) when p >= limit
			let run = d.u8(p)
			p++
			let cnt = (run & 0x3F) + 1
			cnt = count - i when cnt > count - i
			if run & 0x80 != 0 {
				for let j = 0; j < cnt; j++ {
					out[i] = 0
					i++
				}
			} else if run & 0x40 != 0 {
				return (false, p) when 2 * cnt > limit - p
				for let j = 0; j < cnt; j++ {
					out[i] = d.i16(p) << 16
					p += 2
					i++
				}
			} else {
				return (false, p) when cnt > limit - p
				for let j = 0; j < cnt; j++ {
					let v = d.u8(p)
					out[i] = (v >= 128 ?? (v - 256, v)) << 16
					p++
					i++
				}
			}
		}
		return (true, p)
	}

	// Infers the moves of points a tuple left out, contour by contour, like
	// the IUP instruction: between two moved points by interpolation, a lone
	// moved point shifting its whole contour.
	def interpolateDeltas(ends int[], out int[], org int[], has bool[]) {
		let point = 0
		for let (_, end) in ends {
			let first = point
			for point <= end && !has[point] {
				point++
			}
			if point <= end {
				let firstDelta = point
				let cur = point
				point++
				for point <= end {
					if has[point] {
						deltaInterpolate(cur + 1, point - 1, cur, point, org, out)
						cur = point
					}
					point++
				}
				if cur == firstDelta {
					let delta = out[cur] - org[cur]
					if delta != 0 {
						for let p = first; p <= end; p++ {
							out[p] += delta unless p == cur
						}
					}
				} else {
					deltaInterpolate(cur + 1, end, cur, firstDelta, org, out)
					deltaInterpolate(first, firstDelta - 1, cur, firstDelta, org, out) when firstDelta > 0
				}
			}
			point = end + 1
		}
	}

	def deltaInterpolate(p1 int, p2 int, ref1 int, ref2 int, org int[], out int[]) {
		return when p1 > p2
		if org[ref1] > org[ref2] {
			let t = ref1
			ref1 = ref2
			ref2 = t
		}
		let in1 = org[ref1]
		let in2 = org[ref2]
		let out1 = out[ref1]
		let out2 = out[ref2]
		let d1 = out1 - in1
		let d2 = out2 - in2
		return unless in1 != in2 || out1 == out2
		let scale = in1 != in2 ?? (divFix(out2 - out1, in2 - in1), 0)
		for let p = p1; p <= p2; p++ {
			let v = org[p]
			if v <= in1 {
				v += d1
			} else if v >= in2 {
				v += d2
			} else {
				v = out1 + mulFix(v - in1, scale)
			}
			out[p] = v
		}
	}

	// An item variation store as FreeType reads it; deltas come back rounded
	// to whole units.
	type FtItemStore {
		d           Bytes
		at          int
		valid       bool
		axisCount   int
		regions     int
		regionCount int

		def new(d Bytes, at int, axisCount int) {
			self.d = d
			self.at = at
			self.axisCount = axisCount
			return when at == 0 || d.u16(at) != 1
			regions = at + d.u32(at + 2)
			return when d.u16(regions) != axisCount
			regionCount = d.u16(regions + 2)
			return when regionCount >= 32768 || d.u16(at + 6) == 0
			valid = true
		}

		def dataCount() int {
			return valid ?? (d.u16(at + 6), 0)
		}

		def itemCount(outer int) int {
			return 0 when outer >= dataCount()
			return d.u16(at + d.u32(at + 8 + outer * 4))
		}

		// The delta of entry (outer, inner) at `coords` (16.16).
		def delta(outer int, inner int, coords int[]) int {
			return 0 unless valid
			return 0 when outer == 0xFFFF && inner == 0xFFFF
			return 0 when outer >= dataCount()
			let data = at + d.u32(at + 8 + outer * 4)
			let items = d.u16(data)
			let wordField = d.u16(data + 2)
			let count = d.u16(data + 4)
			return 0 when inner >= items || count == 0
			let long = wordField & 0x8000 != 0
			let words = wordField & 0x7FFF
			let rowSize = long ?? ((words + count) * 2, words + count)
			let p = data + 6 + count * 2 + inner * rowSize
			let sum = 0
			for let m = 0; m < count; m++ {
				let v = 0
				if long {
					if m < words {
						v = int32(d.u32(p))
						p += 4
					} else {
						v = d.i16(p)
						p += 2
					}
				} else if m < words {
					v = d.i16(p)
					p += 2
				} else {
					let b = d.u8(p)
					v = b >= 128 ?? (b - 256, b)
					p++
				}
				sum += regionScalar(d.u16(data + 6 + m * 2), coords) * v
			}
			return (sum + 0x8000) >> 16
		}

		// The region indices variation data `outer` blends over.
		def regionIndices(outer int) int[] {
			let out int[]
			return out when outer >= dataCount()
			let data = at + d.u32(at + 8 + outer * 4)
			for let i = 0; i < d.u16(data + 4); i++ {
				out.push(d.u16(data + 6 + i * 2))
			}
			return out
		}

		// How much region `r` applies at `coords`, 16.16.
		def regionScalar(r int, coords int[]) int {
			return 0 when r >= regionCount
			let base = regions + 4 + r * axisCount * 6
			let scalar = 0x10000
			for let j = 0; j < axisCount; j++ {
				let start = d.i16(base + j * 6)
				let peak = d.i16(base + j * 6 + 2)
				let end = d.i16(base + j * 6 + 4)
				peak = 0 when (start < 0 && end > 0) || start > peak || peak > end
				let s = start << 2
				let pk = peak << 2
				let e = end << 2
				let ncv = j < coords.len() ?? (coords[j], 0)
				continue when pk == ncv || pk == 0
				return 0 when ncv <= s || ncv >= e
				scalar = ncv < pk ?? (mulDiv(scalar, ncv - s, pk - s), mulDiv(scalar, e - ncv, e - pk))
			}
			return scalar
		}
	}

	// A delta-set index map as FreeType reads it.
	type FtIndexMap {
		present bool
		outer   int[]
		inner   int[]

		def new(d Bytes, at int, store FtItemStore) {
			return when at == 0
			let format = d.u8(at)
			let entry = d.u8(at + 1)
			return when entry & 0xC0 != 0
			let count = 0
			let p = at + 2
			if format == 0 {
				count = d.u16(p)
				p += 2
			} else if format == 1 {
				count = d.u32(p)
				p += 4
			} else {
				return
			}
			let size = ((entry & 0x30) >> 4) + 1
			let bits = (entry & 0x0F) + 1
			return when count * size > d.len()
			for let i = 0; i < count; i++ {
				let v = 0
				for let j = 0; j < size; j++ {
					v = (v << 8) | d.u8(p)
					p++
				}
				if v == 0xFFFFFFFF {
					outer.push(0xFFFF)
					inner.push(0xFFFF)
					continue
				}
				let o = v >> bits
				let n = v & ((1 << bits) - 1)
				return when o >= store.dataCount() || n >= store.itemCount(o)
				outer.push(o)
				inner.push(n)
			}
			present = count > 0
		}

		def lookup(i int) (int, int) {
			let k = i >= outer.len() ?? (outer.len() - 1, i)
			return (outer[k], inner[k])
		}
	}

	// `HVAR` or `VVAR`: advance adjustments. Present only when the table
	// loads cleanly, as FreeType flags it.
	type FtMetricsVariation {
		present  bool
		store    FtItemStore
		widthMap FtIndexMap

		def new(d Bytes, axisCount int) {
			store = new FtItemStore(d, 0, axisCount)
			widthMap = new FtIndexMap(d, 0, store)
			return when d.len() < 20 || d.u16(0) != 1
			store = new FtItemStore(d, d.u32(4), axisCount)
			return unless store.valid
			let mapAt = d.u32(8)
			widthMap = new FtIndexMap(d, mapAt, store)
			return when mapAt != 0 && !widthMap.present && d.u8(mapAt) <= 1
			present = true
		}

		// `advance` of glyph `g` adjusted to the instance, kept to 16 bits
		// unsigned as the metrics tables store it.
		def adjust(g int, advance int, coords int[]) int {
			return advance unless present
			let (outer, inner) = widthMap.present ?? (widthMap.lookup(g), (0, g))
			return (advance + store.delta(outer, inner, coords)) & 0xFFFF
		}
	}
}
