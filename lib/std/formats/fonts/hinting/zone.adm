internal partial module std.formats.fonts.hinting {
	// Point tags: on-curve, and touched by an instruction along x or y.
	const (
		tagOn        = 0x01
		tagTouchX    = 0x08
		tagTouchY    = 0x10
		tagTouchBoth = 0x18
	)

	// A set of points instructions work on: the glyph's (with its four
	// phantom points last) or the twilight zone's.
	type Zone {
		// 0 twilight, 1 glyph.
		id       int
		// Original, current and unscaled (font unit) positions; 26.6 except
		// orus.
		orgX     int[]
		orgY     int[]
		curX     int[]
		curY     int[]
		orusX    int[]
		orusY    int[]
		tags     int[]
		// Last point of each contour.
		contours int[]
		nPoints  int

		def new(id int, n int) {
			self.id = id
			size(n)
		}

		def size(n int) {
			nPoints = n
			orgX.len(n)
			orgY.len(n)
			curX.len(n)
			curY.len(n)
			orusX.len(n)
			orusY.len(n)
			tags.len(n)
		}

		def nContours() int {
			return contours.len()
		}
	}
}
