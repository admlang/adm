partial module std.formats.fonts {
	use (
		std.testing
		std.os
	)

	check "Hinting" {
		// Expected outlines are FreeType 2.13.3's for the same font, size and
		// mode (interpreter v35 for Full, v40 for Light, the Adobe CFF engine),
		// written by ~/.cache/adm-scratch/fontkit/genhinttest.py. Coordinates
		// are in 1/128 pixel, y up; the prefix is the rounded advance.
		def sample(path string) ?byte[] {
			let d = os.readFile("samples/fonts/" + path)
			return none when d is error
			return d
		}

		def render(o Outline) string {
			let c = (v float) => "{int(v * 128.0)}"
			let s = "{c(o.advance)}|"
			for let (i, seg) in o.segments {
				s += " " when i > 0
				match seg.kind {
					case SegmentKind.Move:
						s += "M{c(seg.to.x)},{c(seg.to.y)}"
					case SegmentKind.Line:
						s += "L{c(seg.to.x)},{c(seg.to.y)}"
					case SegmentKind.Quadratic:
						s += "Q{c(seg.control1.x)},{c(seg.control1.y)},{c(seg.to.x)},{c(seg.to.y)}"
					case SegmentKind.Cubic:
						s += "C{c(seg.control1.x)},{c(seg.control1.y)},{c(seg.control2.x)},{c(seg.control2.y)},{c(seg.to.x)},{c(seg.to.y)}"
					case SegmentKind.Close:
						s += "Z"
				}
			}
			return s
		}

		def hinted(face Face, ch char, size float, hinting Hinting = Hinting.Full) !string {
			let g = face.glyph(ch)
			fail "no glyph for {ch}" when g is none
			return render(try face.outline(g, size, hinting))
		}

		// TrueType bytecode, both interpreter modes.
		@test()
		def runsTrueTypeInstructions() !none {
			let data = sample("ttf/SourceSansPro-Black.ttf")
			return none when data is none
			let face = try (try load(data)).face(0)
			assert (try hinted(face, 'a', 11.0, Hinting.Full)) == "768|M264,0 Q216,0,176,15 Q136,30,109,56 Q82,82,68,116 Q54,150,54,188 Q54,284,144,338 Q234,392,436,410 Q428,512,338,512 Q300,512,258,497 Q216,482,160,452 L76,578 Q150,608,226,624 Q302,640,386,640 Q522,640,600,571 Q678,502,678,348 L678,0 L482,0 L464,74 L460,74 Q416,40,369,20 Q322,0,264,0 Z M350,128 Q378,128,397,149 Q416,170,436,202 L436,282 Q350,268,317,241 Q284,214,284,182 Q284,128,350,128 Z" // "a" at 11px, v35
			assert (try hinted(face, 'a', 11.0, Hinting.Light)) == "768|M264,0 Q216,0,176,15 Q136,30,109,56 Q82,82,68,116 Q54,150,54,188 Q54,284,144,338 Q234,392,436,410 Q428,512,338,512 Q300,512,258,497 Q216,482,160,452 L76,578 Q150,608,226,624 Q302,640,386,640 Q522,640,600,571 Q678,502,678,348 L678,0 L482,0 L464,74 L460,74 Q416,40,369,20 Q322,0,264,0 Z M350,128 Q378,128,397,149 Q416,170,436,202 L436,282 Q350,268,317,241 Q284,214,284,182 Q284,128,350,128 Z" // "a" at 11px, v40
			assert (try hinted(face, 'a', 17.0, Hinting.Full)) == "1152|M410,0 Q332,0,272,24 Q212,48,169,89 Q126,130,104,185 Q82,240,82,300 Q82,452,222,539 Q362,626,674,656 Q662,768,522,768 Q464,768,398,745 Q332,722,248,676 L118,900 Q232,960,350,992 Q468,1024,596,1024 Q808,1024,928,913 Q1048,802,1048,556 L1048,0 L744,0 L718,118 L710,118 Q644,64,571,32 Q498,0,410,0 Z M540,256 Q586,256,615,289 Q644,322,674,374 L674,400 Q540,388,490,362 Q440,336,440,306 Q440,256,540,256 Z" // "a" at 17px, v35
			assert (try hinted(face, 'a', 17.0, Hinting.Light)) == "1152|M410,0 Q332,0,272,24 Q212,48,169,89 Q126,130,104,185 Q82,240,82,300 Q82,452,222,539 Q362,626,674,656 Q662,768,522,768 Q464,768,398,745 Q332,722,248,676 L118,900 Q232,960,350,992 Q468,1024,596,1024 Q808,1024,928,913 Q1048,802,1048,556 L1048,0 L744,0 L718,118 L710,118 Q644,64,571,32 Q498,0,410,0 Z M540,256 Q586,256,615,289 Q644,322,674,374 L674,400 Q540,388,490,362 Q440,336,440,306 Q440,256,540,256 Z" // "a" at 17px, v40
			assert (try hinted(face, 'g', 11.0, Hinting.Full)) == "768|M338,-256 Q278,-256,224,-247 Q170,-238,130,-218 Q90,-198,66,-167 Q42,-136,42,-92 Q42,-12,140,36 L140,42 Q112,62,94,92 Q76,122,76,168 Q76,206,97,243 Q118,280,154,306 L154,312 Q116,332,88,366 Q60,400,60,448 Q60,496,85,533 Q110,570,152,593 Q194,616,248,628 Q302,640,360,640 Q422,640,474,640 L734,640 L734,512 L634,512 Q638,502,641,485 Q644,468,644,450 Q644,400,622,363 Q600,326,562,302 Q524,278,472,267 Q420,256,360,256 Q326,256,282,266 Q270,256,267,242 Q264,228,264,202 Q264,160,287,144 Q310,128,364,128 L468,128 Q602,128,674,90 Q746,52,746,-32 Q746,-82,717,-123 Q688,-164,635,-194 Q582,-224,507,-240 Q432,-256,338,-256 Z M360,384 Q394,384,415,400 Q436,416,436,448 Q436,482,415,497 Q394,512,360,512 Q326,512,305,497 Q284,482,284,448 Q284,416,305,400 Q326,384,360,384 Z M378,-128 Q436,-128,476,-107 Q516,-86,516,-50 Q516,-16,491,-8 Q466,0,420,0 L366,0 Q324,0,302,2 Q280,4,264,8 Q252,-6,246,-19 Q240,-32,240,-50 Q240,-90,278,-109 Q316,-128,378,-128 Z" // "g" at 11px, v35
			assert (try hinted(face, 'g', 11.0, Hinting.Light)) == "768|M338,-256 Q278,-256,224,-247 Q170,-238,130,-218 Q90,-198,66,-167 Q42,-136,42,-92 Q42,-12,140,36 L140,42 Q112,62,94,92 Q76,122,76,168 Q76,206,97,243 Q118,280,154,306 L154,312 Q116,332,88,366 Q60,400,60,448 Q60,496,85,533 Q110,570,152,593 Q194,616,248,628 Q302,640,360,640 Q422,640,474,640 L734,640 L734,512 L634,512 Q638,502,641,485 Q644,468,644,450 Q644,400,622,363 Q600,326,562,302 Q524,278,472,267 Q420,256,360,256 Q326,256,282,266 Q270,256,267,242 Q264,228,264,202 Q264,160,287,144 Q310,128,364,128 L468,128 Q602,128,674,90 Q746,52,746,-32 Q746,-82,717,-123 Q688,-164,635,-194 Q582,-224,507,-240 Q432,-256,338,-256 Z M360,384 Q394,384,415,400 Q436,416,436,448 Q436,482,415,497 Q394,512,360,512 Q326,512,305,497 Q284,482,284,448 Q284,416,305,400 Q326,384,360,384 Z M378,-128 Q436,-128,476,-107 Q516,-86,516,-50 Q516,-16,491,-8 Q466,0,420,0 L366,0 Q324,0,302,2 Q280,4,264,8 Q252,-6,246,-19 Q240,-32,240,-50 Q240,-90,278,-109 Q316,-128,378,-128 Z" // "g" at 11px, v40
			assert (try hinted(face, 'g', 17.0, Hinting.Full)) == "1152|M522,-384 Q428,-384,346,-370 Q264,-356,202,-325 Q140,-294,103,-245 Q66,-196,66,-126 Q66,-4,218,74 L218,82 Q174,114,146,158 Q118,202,118,274 Q118,332,150,388 Q182,444,240,486 L240,494 Q180,524,136,581 Q92,638,92,712 Q92,792,131,851 Q170,910,235,948 Q300,986,384,1005 Q468,1024,558,1024 Q652,1024,732,1024 L1136,1024 L1136,768 L980,768 Q986,752,991,727 Q996,702,996,676 Q996,598,961,543 Q926,488,868,453 Q810,418,729,401 Q648,384,558,384 Q502,384,436,400 Q418,384,414,370 Q410,356,410,330 Q410,288,444,272 Q478,256,562,256 L724,256 Q930,256,1042,193 Q1154,130,1154,-10 Q1154,-94,1109,-163 Q1064,-232,982,-281 Q900,-330,784,-357 Q668,-384,522,-384 Z M558,640 Q610,640,642,656 Q674,672,674,704 Q674,738,642,753 Q610,768,558,768 Q504,768,472,753 Q440,738,440,704 Q440,672,472,656 Q504,640,558,640 Z M584,-128 Q674,-128,735,-107 Q796,-86,796,-50 Q796,-16,758,-8 Q720,0,650,0 L566,0 Q500,0,467,3 Q434,6,410,12 Q390,-6,380,-19 Q370,-32,370,-50 Q370,-90,429,-109 Q488,-128,584,-128 Z" // "g" at 17px, v35
			assert (try hinted(face, 'g', 17.0, Hinting.Light)) == "1152|M522,-384 Q428,-384,346,-370 Q264,-356,202,-325 Q140,-294,103,-245 Q66,-196,66,-126 Q66,-4,218,74 L218,82 Q174,114,146,158 Q118,202,118,274 Q118,332,150,388 Q182,444,240,486 L240,494 Q180,524,136,581 Q92,638,92,712 Q92,792,131,851 Q170,910,235,948 Q300,986,384,1005 Q468,1024,558,1024 Q652,1024,732,1024 L1136,1024 L1136,768 L980,768 Q986,752,991,727 Q996,702,996,676 Q996,598,961,543 Q926,488,868,453 Q810,418,729,401 Q648,384,558,384 Q502,384,436,400 Q418,384,414,370 Q410,356,410,330 Q410,288,444,272 Q478,256,562,256 L724,256 Q930,256,1042,193 Q1154,130,1154,-10 Q1154,-94,1109,-163 Q1064,-232,982,-281 Q900,-330,784,-357 Q668,-384,522,-384 Z M558,640 Q610,640,642,656 Q674,672,674,704 Q674,738,642,753 Q610,768,558,768 Q504,768,472,753 Q440,738,440,704 Q440,672,472,656 Q504,640,558,640 Z M584,-128 Q674,-128,735,-107 Q796,-86,796,-50 Q796,-16,758,-8 Q720,0,650,0 L566,0 Q500,0,467,3 Q434,6,410,12 Q390,-6,380,-19 Q370,-32,370,-50 Q370,-90,429,-109 Q488,-128,584,-128 Z" // "g" at 17px, v40
		}

		// CFF stem hints and blue zones; Light hints CFF the same as Full.
		@test()
		def fitsCffStemHints() !none {
			let data = sample("otf/SourceCodePro-Subset.otf")
			return none when data is none
			let face = try (try load(data)).face(0)
			assert (try hinted(face, 'a', 9.0)) == "640|M282,0 C362,0,442,40,504,90 L508,90 L516,0 L592,0 L592,388 C592,546,518,640,366,640 C268,640,174,596,116,558 L154,486 C206,522,276,560,350,560 C458,560,496,488,498,402 C208,376,92,306,92,164 C92,50,178,-14,282,-14 Z M308,70 C244,76,184,104,184,176 C184,258,258,312,498,334 L498,168 C434,108,372,76,308,76 Z" // "a" at 9px
			assert (try hinted(face, 'a', 14.0)) == "1024|M440,0 C564,0,688,64,784,138 L790,138 L802,0 L922,0 L922,536 C922,754,808,896,570,896 C416,896,270,826,182,770 L240,668 C320,720,432,774,544,774 C712,774,772,672,776,554 C326,518,144,422,144,226 C144,70,276,-22,440,-22 Z M480,96 C380,118,288,158,288,254 C288,366,402,436,776,466 L776,242 C676,162,578,118,480,118 Z" // "a" at 14px
			assert (try hinted(face, 'g', 9.0)) == "640|M340,-256 C530,-256,652,-166,652,-56 C652,40,582,78,438,78 L312,78 C238,78,196,100,196,146 C196,174,212,196,240,212 C270,198,306,192,334,192 C456,192,550,266,550,418 C550,476,530,528,504,562 L648,562 L648,640 L418,640 C394,634,366,640,334,640 C216,640,114,558,114,414 C114,334,146,274,184,242 L184,238 C140,208,116,166,116,128 C116,76,144,46,174,28 L174,22 C114,-4,82,-52,82,-98 C82,-200,176,-256,340,-256 Z M334,256 C264,256,206,316,206,414 C206,506,264,570,334,570 C406,570,464,506,464,414 C464,316,406,256,334,256 Z M348,-188 C228,-188,164,-152,164,-94 C164,-62,182,-30,236,0 C260,2,288,0,320,0 L430,0 C516,0,558,-16,558,-72 C558,-132,478,-188,348,-188 Z" // "g" at 9px
			assert (try hinted(face, 'g', 14.0)) == "1024|M530,-384 C826,-384,1014,-244,1014,-82 C1014,64,906,120,682,120 L486,120 C372,120,306,152,306,218 C306,258,330,290,374,316 C422,296,476,284,520,284 C710,284,858,398,858,592 C858,664,824,732,784,774 L1010,774 L1010,896 L650,896 C612,888,570,896,520,896 C336,896,178,774,178,586 C178,484,226,408,286,364 L286,356 C220,312,182,248,182,190 C182,114,224,68,272,42 L272,34 C178,-6,128,-76,128,-144 C128,-298,276,-384,530,-384 Z M520,384 C412,384,320,462,320,586 C320,706,412,788,520,788 C632,788,722,706,722,586 C722,462,632,384,520,384 Z M540,-278 C354,-278,256,-224,256,-138 C256,-90,284,-44,366,0 C404,2,450,0,500,0 L670,0 C802,0,868,-24,868,-106 C868,-194,744,-278,540,-278 Z" // "g" at 14px
			assert (try hinted(face, 'e', 12.0, Hinting.Light)) == (try hinted(face, 'e', 12.0)) // CFF has one hinting mode
		}

		// None scales the font-unit outline and its advance without rounding.
		@test()
		def noneScalesTheDesignOutline() !none {
			let data = sample("otf/SourceCodePro-Subset.otf")
			return none when data is none
			let face = try (try load(data)).face(0)
			let g = face.glyph('o')
			return none when g is none
			let plain = try face.outline(g)
			let scaled = try face.outline(g, 10.0, Hinting.None)
			assert scaled.segments.len() == plain.segments.len() // same segments
			assert scaled.advance == plain.advance * 10.0 / 1000.0 // advance scaled, not rounded
			assert face.outline(g, 0.0) is error // the size must be positive
		}
	}
}
