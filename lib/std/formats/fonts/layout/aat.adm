// Apple Advanced Typography: the lookup tables and state machines `morx`,
// `mort`, `kerx` and the Apple `kern` table share, and the driver that runs
// a state machine over the buffer. A port of HarfBuzz 14.1's
// hb-aat-layout-common.hh.

internal partial module std.formats.fonts.layout {
	// The glyph a subtable deletes: kept in the buffer until substitution
	// ends, then removed.
	const aatDeletedGlyph = 0xFFFF

	// Set on a deleted entry's Unicode properties, beside the Format category.
	const upropsAATDeleted = 0x800

	// Classes every state table reserves.
	const (
		aatClassEndOfText   = 0
		aatClassOutOfBounds = 1
		aatClassDeleted     = 2
	)

	// A set of 16-bit glyph ids.
	type GlyphSet {
		internal bits int[]

		def new() {
			bits.len(1024)
			bits.fill(0)
		}

		def add(g int) {
			return when g < 0 || g > 0xFFFF
			bits[g >> 6] |= 1 << (g & 63)
		}

		// Adds [first, last].
		def addRange(first int, last int) {
			last = last.min(0xFFFF)
			for let g = first.max(0); g <= last; g++ {
				add(g)
			}
		}

		def has(g int) bool {
			return false when g < 0 || g > 0xFFFF
			return bits[g >> 6] & (1 << (g & 63)) != 0
		}

		// Whether any of the buffer's glyphs is in the set.
		def hasAny(b Buffer) bool {
			for let i = 0; i < b.len; i++ {
				return true when has(b.info.glyph[i])
			}
			return false
		}
	}

	// An AAT lookup table: glyph to a `size`-byte value, in one of formats 0
	// (array), 2 (segments), 4 (segment arrays), 6 (single glyphs), 8
	// (trimmed array) or 10 (trimmed array of any value size).
	type AatLookup {
		internal d    Data
		internal at   int
		internal size int

		def new(d Data, at int, size int = 2) {
			self.d = d
			self.at = at
			self.size = size
		}

		// The value of `g`, -1 when the table has none. Format 10 answers
		// only through `valueOrZero`.
		def value(g int, numGlyphs int) int {
			let format = d.u16(at)
			if format == 0 {
				return -1 when g < 0 || g >= numGlyphs
				return read(at + 2 + g * size)
			}
			if format == 2 {
				let unit = segment(g, 2)
				return unit < 0 ?? (-1, read(unit + 4))
			}
			if format == 4 {
				let unit = segment(g, 2)
				return -1 when unit < 0
				return read(at + d.u16(unit + 4) + (g - d.u16(unit + 2)) * size)
			}
			if format == 6 {
				let unit = segment(g, 1)
				return unit < 0 ?? (-1, read(unit + 2))
			}
			if format == 8 {
				let first = d.u16(at + 2)
				return -1 when g < first || g - first >= d.u16(at + 4)
				return read(at + 6 + (g - first) * size)
			}
			return -1
		}

		// The value of `g`, 0 when the table has none; format 10 included.
		def valueOrZero(g int, numGlyphs int) int {
			if d.u16(at) == 10 {
				let width = d.u16(at + 2)
				let first = d.u16(at + 4)
				return 0 when g < first || g - first >= d.u16(at + 6)
				let p = at + 8 + (g - first) * width
				let v = 0
				for let k = 0; k < width; k++ {
					v = v << 8 | d.u8(p + k)
				}
				return v
			}
			let v = value(g, numGlyphs)
			return v < 0 ?? (0, v)
		}

		internal def read(p int) int {
			return size == 4 ?? (d.u32(p), d.u16(p))
		}

		// The unit of a binary-search table holding `g`, -1 when none. Units
		// start with (last, first) glyphs when `words` is 2, with the glyph
		// alone when 1; trailing 0xFFFF terminator units are not searched.
		internal def segment(g int, words int) int {
			let unitSize = d.u16(at + 2)
			let units = d.u16(at + 4)
			let base = at + 12
			if units > 0 {
				let last = base + (units - 1) * unitSize
				let terminator = true
				for let k = 0; k < words; k++ {
					terminator = false when d.u16(last + k * 2) != 0xFFFF
				}
				units-- when terminator
			}
			let lo = 0
			let hi = units - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let unit = base + mid * unitSize
				let high = d.u16(unit)
				let low = words == 2 ?? (d.u16(unit + 2), high)
				if g < low {
					hi = mid - 1
				} else if g > high {
					lo = mid + 1
				} else {
					return unit
				}
			}
			return -1
		}

		// Units of a binary-search table, terminator excluded, with their size.
		internal def units(words int) (int, int) {
			let unitSize = d.u16(at + 2)
			let n = d.u16(at + 4)
			if n > 0 {
				let last = at + 12 + (n - 1) * unitSize
				let terminator = true
				for let k = 0; k < words; k++ {
					terminator = false when d.u16(last + k * 2) != 0xFFFF
				}
				n-- when terminator
			}
			return (n, unitSize)
		}

		// Adds every glyph the table maps to `set`.
		def collect(set GlyphSet, numGlyphs int) {
			collectWhere(set, numGlyphs, (v int) => true)
		}

		// Adds every glyph whose value `keep` accepts.
		def collectWhere(set GlyphSet, numGlyphs int, keep def (int) bool) {
			let format = d.u16(at)
			if format == 0 {
				for let g = 0; g < numGlyphs; g++ {
					set.add(g) when keep(read(at + 2 + g * size))
				}
			} else if format == 2 || format == 4 {
				let (n, unitSize) = units(2)
				for let i = 0; i < n; i++ {
					let unit = at + 12 + i * unitSize
					let last = d.u16(unit)
					let first = d.u16(unit + 2)
					continue when first == aatDeletedGlyph
					if format == 2 {
						set.addRange(first, last) when keep(read(unit + 4))
					} else {
						let values = at + d.u16(unit + 4)
						for let g = first; g <= last; g++ {
							set.add(g) when keep(read(values + (g - first) * size))
						}
					}
				}
			} else if format == 6 {
				let (n, unitSize) = units(1)
				for let i = 0; i < n; i++ {
					let unit = at + 12 + i * unitSize
					let g = d.u16(unit)
					set.add(g) when g != aatDeletedGlyph && keep(read(unit + 2))
				}
			} else if format == 8 {
				let first = d.u16(at + 2)
				let count = d.u16(at + 4)
				return when count == 0 || first == aatDeletedGlyph
				for let i = 0; i < count; i++ {
					set.add(first + i) when keep(read(at + 6 + i * size))
				}
			} else if format == 10 {
				let width = d.u16(at + 2)
				let first = d.u16(at + 4)
				let count = d.u16(at + 6)
				return when count == 0 || first == aatDeletedGlyph
				for let i = 0; i < count; i++ {
					let v = 0
					for let k = 0; k < width; k++ {
						v = v << 8 | d.u8(at + 8 + i * width + k)
					}
					set.add(first + i) when keep(v)
				}
			}
		}
	}

	// A state table: glyph classes, a state array and entries. Extended
	// tables (`morx`, `kerx`) have 32-bit header fields, 16-bit states and
	// lookup-table classes; the older ones (`mort`, Apple `kern`) 16-bit
	// fields, byte states, a trimmed class array, and new states given as
	// byte offsets into the state array.
	type StateTable {
		d                Data
		// Start of the table header.
		base             int
		extended         bool
		nClasses         int
		internal classes int
		internal states  int
		internal entries int
		// Bytes of an entry: new state, flags and `dataSize` bytes of data.
		entrySize        int

		def new(d Data, base int, extended bool, dataSize int) {
			self.d = d
			self.base = base
			self.extended = extended
			if extended {
				nClasses = d.u32(base)
				classes = base + d.u32(base + 4)
				states = base + d.u32(base + 8)
				entries = base + d.u32(base + 12)
			} else {
				nClasses = d.u16(base)
				classes = base + d.u16(base + 2)
				states = base + d.u16(base + 4)
				entries = base + d.u16(base + 6)
			}
			entrySize = 4 + dataSize
		}

		// Bytes of the header: where the subtable's own fields follow.
		def headerSize() int {
			return extended ?? (16, 8)
		}

		def glyphClass(g int, numGlyphs int) int {
			return aatClassDeleted when g == aatDeletedGlyph
			if extended {
				let v = new AatLookup(d, classes).value(g, numGlyphs)
				return v < 0 ?? (aatClassOutOfBounds, v)
			}
			let i = g - d.u16(classes)
			return aatClassOutOfBounds when i < 0 || i >= d.u16(classes + 2)
			return d.u8(classes + 4 + i)
		}

		// Byte offset of the entry for `state` and class `k`.
		def entry(state int, k int) int {
			k = aatClassOutOfBounds when k >= nClasses
			let i = state * nClasses + k
			let e = extended ?? (d.u16(states + i * 2), d.u8(states + i))
			return entries + e * entrySize
		}

		// The state an entry goes to.
		def newState(e int) int {
			let s = d.u16(e)
			return s when extended
			// C division: toward zero.
			let off = s - (states - base)
			return off < 0 ?? (-(-off / nClasses), off / nClasses)
		}

		def flags(e int) int {
			return d.u16(e + 2)
		}

		// The entry's `k`th 16-bit data word.
		def data(e int, k int) int {
			return d.u16(e + 4 + k * 2)
		}

		// Glyphs that can start work from the start of text: those whose class
		// leaves the start state, acts, or starts an action there.
		def collectInitial(set GlyphSet, numGlyphs int, driven AatDriven) {
			if nClasses > 512 {
				collectClasses(set, numGlyphs, (v int) => v != aatClassOutOfBounds, true)
				return
			}
			let filter bool[]
			filter.len(512)
			filter.fill(false)
			for let k = 0; k < nClasses; k++ {
				let e = entry(0, k)
				continue when newState(e) == 0 && !driven.isInitiable(e) && !driven.isActionable(e)
				filter[k] = true
			}
			set.add(aatDeletedGlyph) when filter[aatClassDeleted]
			collectClasses(set, numGlyphs, (v int) => filter[v & 511], false)
		}

		// Glyphs whose class `keep` accepts. `all` takes every glyph of an
		// extended lookup whatever its value.
		internal def collectClasses(set GlyphSet, numGlyphs int, keep def (int) bool, all bool) {
			if extended {
				let lookup = new AatLookup(d, classes)
				if all {
					lookup.collect(set, numGlyphs)
				} else {
					lookup.collectWhere(set, numGlyphs, keep)
				}
				return
			}
			let first = d.u16(classes)
			for let i = 0; i < d.u16(classes + 2); i++ {
				set.add(first + i) when keep(d.u8(classes + 4 + i))
			}
		}
	}

	// What a state machine subtable does on each transition.
	interface AatDriven {
		// Whether the subtable works on a copy of the buffer (insertion,
		// ligatures) rather than in place.
		def inPlace() bool
		def isActionable(e int) bool
		def isInitiable(e int) bool
		def transition(b Buffer, e int)
	}

	// Runs a state machine over the buffer, from the start of text to past
	// its end.
	def driveStateMachine(c AatContext, m StateTable, driven AatDriven) {
		let b = c.b
		b.clearOutput() when !driven.inPlace()
		let state = 0
		let dontAdvance = 0x4000
		// With several ranges, glyphs whose range turns this subtable off
		// pass through, the machine back at the start of text.
		let ranged = c.ranges.flags.len() > 1
		let range = 0
		b.idx = 0
		for b.successful {
			if ranged {
				range = c.rangeOf(b.info.cluster[b.idx], range) when b.idx < b.len
				if c.ranges.flags[range] & c.subtableFlags == 0 {
					break when b.idx == b.len
					state = 0
					b.nextGlyph()
					continue
				}
			}
			let k = b.idx < b.len ?? (m.glyphClass(b.info.glyph[b.idx], c.numGlyphs), aatClassEndOfText)
			let e = m.entry(state, k)
			let next = m.newState(e)
			let advance = m.flags(e) & dontAdvance == 0
			// Breaking before this glyph changes nothing when the transition
			// does nothing, starting afresh here would end in the same state,
			// and the end of text would not act after the previous glyph.
			let safe = !driven.isActionable(e) && !driven.isActionable(m.entry(state, aatClassEndOfText))
			if safe && state != 0 && !(!advance && next == 0) {
				let fresh = m.entry(0, k)
				safe = !driven.isActionable(fresh) && next == m.newState(fresh) && (m.flags(e) & dontAdvance) == (m.flags(fresh) & dontAdvance)
			}
			b.unsafeToBreak(b.backtrackLen() - 1, b.idx + 1, true) when !safe && b.backtrackLen() > 0 && b.idx < b.len
			driven.transition(b, e)
			state = next
			break when b.idx == b.len
			let exhausted = b.maxOps <= 0
			b.maxOps-- when !advance
			b.nextGlyph() when advance || exhausted
		}
		b.sync() when !driven.inPlace()
	}

	// State shared by the subtables of one AAT table while it runs.
	type AatContext {
		b                 Buffer
		plan              Plan
		font              ShapeFont
		numGlyphs         int
		internal gdef     Gdef
		internal classes  bool
		// Whether the buffer runs against its logical order right now.
		reversed          bool
		// Glyphs that have been in the buffer since the table started, kept
		// for buffers of four or more; shorter ones are scanned.
		internal usingSet bool
		internal seen     GlyphSet
		// Glyphs that make the current subtable worth running.
		firstSet          GlyphSet
		secondSet         GlyphSet
		// The current `morx` chain's flags per cluster range, and the
		// running subtable's own flags.
		ranges            AatRanges
		subtableFlags     int

		def new(plan Plan, b Buffer) {
			self.plan = plan
			self.b = b
			font = plan.font
			numGlyphs = font.numGlyphs
			gdef = font.gdef
			classes = gdef.hasGlyphClasses()
			firstSet = new GlyphSet()
			secondSet = new GlyphSet()
			ranges = AatRanges{flags: [-1], first: [0], last: [aatGlobalEnd]}
			subtableFlags = -1
		}

		// The range holding `cluster`, searching from `from`.
		def rangeOf(cluster int, from int) int {
			let r = from
			for r > 0 && cluster < ranges.first[r] {
				r--
			}
			for r + 1 < ranges.first.len() && cluster > ranges.last[r] {
				r++
			}
			return r
		}

		def reverseBuffer() {
			b.reverse()
			reversed = !reversed
		}

		// Starts tracking the buffer's glyphs (`morx` and `kerx` do; `mort`
		// scans every time).
		def trackGlyphs() {
			usingSet = b.len >= 4
			return when !usingSet
			seen = new GlyphSet()
			for let i = 0; i < b.len; i++ {
				seen.add(b.info.glyph[i])
			}
		}

		// Whether the buffer holds a glyph the current subtable starts on.
		def intersectsMachine() bool {
			if usingSet {
				for let w = 0; w < 1024; w++ {
					return true when seen.bits[w] & firstSet.bits[w] != 0
				}
				return false
			}
			return firstSet.hasAny(b)
		}

		internal def markDeleted(i int) {
			b.scratch |= scratchAATDeleted
			b.info.setCategory(i, catCf)
			b.info.uprops[i] |= upropsAATDeleted | upropsHidden
		}

		// Inserts `glyphs` at the cursor, each a copy of the current entry.
		def outputGlyphs(glyphs int[]) {
			if usingSet {
				for let (_, g) in glyphs {
					seen.add(g)
				}
			}
			for let (_, g) in glyphs {
				if b.idx < b.len {
					if g == aatDeletedGlyph {
						markDeleted(b.idx)
					} else if classes {
						b.info.gprops[b.idx] = gdef.glyphProps(g)
					}
				} else if g == aatDeletedGlyph {
					b.scratch |= scratchAATDeleted
				}
				b.outputGlyph(g)
				return when !b.successful
			}
		}

		def replaceGlyph(g int) {
			markDeleted(b.idx) when g == aatDeletedGlyph
			seen.add(g) when usingSet
			b.info.gprops[b.idx] = gdef.glyphProps(g) when classes
			b.replaceGlyph(g)
		}

		def deleteGlyph() {
			markDeleted(b.idx)
			b.replaceGlyph(aatDeletedGlyph)
		}

		def replaceGlyphInPlace(i int, g int) {
			b.info.glyph[i] = g
			seen.add(g) when usingSet
			b.info.gprops[i] = gdef.glyphProps(g) when classes
		}
	}

	def isAATDeleted(b Buffer, i int) bool {
		return b.info.category(i) == catCf && b.info.uprops[i] & upropsAATDeleted != 0
	}

	// Drops the glyphs `morx` deleted.
	def removeDeletedGlyphs(b Buffer) {
		b.deleteWhere((i int) => isAATDeleted(b, i)) when b.scratch & scratchAATDeleted != 0
	}
}
