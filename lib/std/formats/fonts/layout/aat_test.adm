partial module std.formats.fonts.layout {
	use (
		std.os
		std.testing
		std.formats.fonts
	)

	// Expected runs are HarfBuzz 14.1's (hb-shape --font-funcs=ot) for the
	// fixtures samples/fonts/ttf/mkaat.py builds, written by
	// ~/.cache/adm-scratch/fontkit/aat/gensuite.py.
	check "AAT layout" {
		// Shapes `text` and renders it as hb-shape does:
		// [glyph=cluster@x,y+advance|...].
		def shapeSample(path string, text string, features string, direction int, ptem float, language string) !string {
			let loaded = try fonts.load(try os.readFile("samples/fonts/ttf/" + path))
			let font = new ShapeFont(try loaded.face(0))
			font.ptem = ptem
			let wanted = map<string, bool>{}
			if features != "" {
				for let (_, spec) in features.split(",") {
					let kv = spec.split("=")
					wanted[kv[0]] = kv[1] == "1"
				}
			}
			let b = shapeText(font, text, "", language, direction, wanted, flagBeginningOfText | flagEndOfText)
			let s = "["
			for let i = 0; i < b.len; i++ {
				s += "|" when i > 0
				s += "{b.info.glyph[i]}={b.info.cluster[i]}"
				s += "@{b.pos.xOffset[i]},{b.pos.yOffset[i]}" when b.pos.xOffset[i] != 0 || b.pos.yOffset[i] != 0
				s += "+{b.pos.xAdvance[i]}"
				s += ",{b.pos.yAdvance[i]}" when b.pos.yAdvance[i] != 0
			}
			return s + "]"
		}

		def checkShape(path string, text string, features string, direction int, ptem float, language string, want string) !none {
			let got = try shapeSample(path, text, features, direction, ptem, language)
			print("{path} {text} {features}: got {got}, want {want}\n") when got != want
			assert got == want // same glyphs, clusters and positions as HarfBuzz
		}

		def kern(path string, left char, right char) !int {
			let face = try (try fonts.load(try os.readFile("samples/fonts/ttf/" + path))).face(0)
			let l = face.glyph(left)
			fail "no glyph for {left}" when l is none
			let r = face.glyph(right)
			fail "no glyph for {right}" when r is none
			return int(face.kern(l, r))
		}

		// `Face.kern` of a face that kerns through `kerx`: pair lists, class
		// matrices and row/column tables; cross-stream subtables do not count.
		@test()
		def kernsThroughKerx() !none {
			assert (try kern("aat-kerx0.ttf", 'A', 'V')) == -80 // format 0, cross-stream +120 left out
			assert (try kern("aat-kerx2.ttf", 'W', 'A')) == -50 // format 2
			assert (try kern("aat-kerx6.ttf", 'T', 'o')) == -120 // format 6, 32-bit values
			assert (try kern("aat-kerx6.ttf", 'A', 'A')) == 0 // not in the tables
		}

		// The public API: tracking at `ShapeOptions.pointSize`, and the
		// `feat` settings offered as OpenType tags.
		@test()
		def pointSizeAndFeatures() !none {
			let trak = try (try fonts.load(try os.readFile("samples/fonts/ttf/aat-trak.ttf"))).face(0)
			let run = try fonts.shape(trak, "ABC", fonts.ShapeOptions{pointSize: 1.5})
			assert run.glyphs[0].xAdvance == 720 // +200 at 1.5 pt, as hb-shape --font-ptem=1.5
			let plain = try fonts.shape(trak, "ABC")
			assert plain.glyphs[0].xAdvance == 520 // 0 at the default 12 pt
			let feat = try (try fonts.load(try os.readFile("samples/fonts/ttf/aat-feat.ttf"))).face(0)
			let tags = fonts.features(feat)
			assert tags.len() == 2 && tags.indexOf("liga") >= 0 && tags.indexOf("smcp") >= 0 // ligatures on, lower-case small caps
		}

		@test()
		def shapesLikeHarfBuzz() !none {
			try checkShape("aat-kerx0.ttf", "AVAVAT", "", 0, 0.0, "", "[2=0+480|23=1@-40,120+655|2=2@-35,120+445|23=3@-40,240+655|2=4@-35,240+455|21=5@-30,240+680]")
			try checkShape("aat-kerx0.ttf", "To Te", "", 0, 0.0, "", "[21=0+650|42=1@-60,0+860|1=2+510|21=3+665|32=4@-45,0+775]")
			try checkShape("aat-kerx0.ttf", "AVAV", "kern=0", 0, 0.0, "", "[2=0+520|23=1+730|2=2+520|23=3+730]")
			try checkShape("aat-kerx0.ttf", "VAV", "", 5, 0.0, "", "[23=2+695|2=1@-35,0+445|23=0@-40,120+690]")
			try checkShape("aat-kerx1.ttf", "AVAV", "", 0, 0.0, "", "[2=0@-42,0+478|23=1@-60,0+670|2=2@-42,0+478|23=3@-60,0+670]")
			try checkShape("aat-kerx1.ttf", "AAVV", "", 0, 0.0, "", "[2=0+520|2=1+520|23=2+730|23=3+730]")
			try checkShape("aat-kerx1.ttf", "AVAV", "", 5, 0.0, "", "[23=3+730|2=2@-42,0+478|23=1@-60,0+670|2=0+520]")
			try checkShape("aat-kerx1.ttf", "AVAV", "kern=0", 0, 0.0, "", "[2=0+520|23=1+730|2=2+520|23=3+730]")
			try checkShape("aat-kerx2.ttf", "WAVE To Tea", "", 0, 0.0, "", "[24=0+715|2=1@-25,0+455|23=2@-40,0+690|6=3+560|1=4+510|21=5+650|42=6@-60,0+860|1=7+510|21=8+665|32=9@-45,0+775|28=10+780]")
			try checkShape("aat-kerx4.ttf", "V\u0301W\u0301", "", 0, 0.0, "", "[23=0+730|54=0@-200,200+0|24=3+740|54=3@-240,220+0]")
			try checkShape("aat-kerx4.ttf", "V\u0301\u0301", "", 0, 0.0, "", "[23=0+730|54=0@-200,200+0|54=0@-200,200+0]")
			try checkShape("aat-kerx6.ttf", "AVATAR To", "", 0, 0.0, "", "[2=0+480|23=1@-40,0+655|2=2@-35,0+455|21=3@-30,0+680|2=4+520|19=5+690|1=6+510|21=7+650|42=8@-60,0+860]")
			try checkShape("aat-kern1.ttf", "AVAV", "", 0, 0.0, "", "[2=0@-42,0+478|23=1@-60,0+670|2=2@-42,0+478|23=3@-60,0+670]")
			try checkShape("aat-kern1.ttf", "AVAV", "kern=0", 0, 0.0, "", "[2=0+520|23=1+730|2=2+520|23=3+730]")
			try checkShape("aat-kern3.ttf", "WAVE To Tea", "", 0, 0.0, "", "[24=0+715|2=1@-25,0+455|23=2@-40,0+690|6=3+560|1=4+510|21=5+650|42=6@-60,0+860|1=7+510|21=8+665|32=9@-45,0+775|28=10+780]")
			try checkShape("aat-feat.ttf", "FFIabe", "", 0, 0.0, "", "[12=0+620|28=3+780|29=4+790|32=5+820]")
			try checkShape("aat-feat.ttf", "FFIabe", "liga=0", 0, 0.0, "", "[7=0+570|7=1+570|10=2+600|28=3+780|29=4+790|32=5+820]")
			try checkShape("aat-feat.ttf", "FFIabe", "smcp=1", 0, 0.0, "", "[12=0+620|2=3+520|3=4+530|6=5+560]")
			try checkShape("aat-morx.ttf", "XYYZ", "", 0, 0.0, "", "[26=0+760|27=0+770|26=0+760|25=0+750]")
			try checkShape("aat-morx.ttf", "PQ", "", 0, 0.0, "", "[20=0+700|19=1+690]")
			try checkShape("aat-morx.ttf", "FFI FI", "", 0, 0.0, "", "[12=0+620|1=3+510|13=4+630]")
			try checkShape("aat-morx.ttf", "MN", "", 0, 0.0, "", "[3=0+530|14=0+640|15=0+650|16=0+660|15=1+650]")
			try checkShape("aat-morx.ttf", "NMN", "", 0, 0.0, "", "[15=0+650|3=1+530|14=1+640|15=1+650|16=1+660|15=2+650]")
			try checkShape("aat-morx.ttf", "abe", "", 0, 0.0, "", "[28=0+780|29=1+790|32=2+820]")
			try checkShape("aat-morx.ttf", "abe", "", 6, 0.0, "", "[2=0@-260,-850+0,-1000|3=1@-265,-850+0,-1000|6=2@-280,-850+0,-1000]")
			try checkShape("aat-morx.ttf", "XYZ PQ", "", 5, 0.0, "", "[18=5+680|17=4+670|1=3+510|27=2+770|26=1+760|25=0+750]")
			try checkShape("aat-mort.ttf", "XYYZ", "", 0, 0.0, "", "[26=0+760|27=0+770|26=0+760|25=0+750]")
			try checkShape("aat-mort.ttf", "PQ", "", 0, 0.0, "", "[20=0+700|19=1+690]")
			try checkShape("aat-mort.ttf", "FFI FI", "", 0, 0.0, "", "[12=0+620|1=3+510|13=4+630]")
			try checkShape("aat-mort.ttf", "MN", "", 0, 0.0, "", "[3=0+530|14=0+640|15=0+650|16=0+660|15=1+650]")
			try checkShape("aat-mort.ttf", "NMN", "", 0, 0.0, "", "[15=0+650|3=1+530|14=1+640|15=1+650|16=1+660|15=2+650]")
			try checkShape("aat-mort.ttf", "abe", "", 0, 0.0, "", "[28=0+780|29=1+790|32=2+820]")
			try checkShape("aat-mort.ttf", "abe", "", 6, 0.0, "", "[2=0@-260,-850+0,-1000|3=1@-265,-850+0,-1000|6=2@-280,-850+0,-1000]")
			try checkShape("aat-mort.ttf", "XYZ PQ", "", 5, 0.0, "", "[18=5+680|17=4+670|1=3+510|27=2+770|26=1+760|25=0+750]")
			try checkShape("aat-trak.ttf", "ABC", "", 0, 0.0, "", "[2=0+520|3=1+530|4=2+540]")
			try checkShape("aat-trak.ttf", "ABC", "", 0, 1.5, "", "[2=0+720|3=1+730|4=2+740]")
			try checkShape("aat-trak.ttf", "ABC", "", 0, 9.0, "", "[2=0+580|3=1+590|4=2+600]")
			try checkShape("aat-trak.ttf", "ABC", "", 0, 24.0, "", "[2=0+506|3=1+516|4=2+526]")
			try checkShape("aat-trak.ttf", "ABC", "", 0, 144.0, "", "[2=0+420|3=1+430|4=2+440]")
			try checkShape("aat-feat.ttf", "FFIabe", "", 0, 0.0, "tr", "[12=0+620|32=3+820|29=4+790|32=5+820]")
			try checkShape("aat-feat.ttf", "FFIabe", "", 0, 0.0, "tr-TR", "[12=0+620|32=3+820|29=4+790|32=5+820]")
			try checkShape("aat-feat.ttf", "FFIabe", "", 0, 0.0, "de", "[12=0+620|28=3+780|29=4+790|32=5+820]")
		}
	}
}
