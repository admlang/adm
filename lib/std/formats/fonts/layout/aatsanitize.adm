// Table validation for the AAT tables and `kern`: HarfBuzz 14.1's sanitize
// rules for morx, mort, kerx, kern, ankr, trak, feat and ltag. A table any
// of whose structures reaches outside it is dropped whole, as HarfBuzz
// drops it, so a broken font shapes as it does there.

internal partial module std.formats.fonts.layout {
	// Validates one AAT table's bytes. Positions are table offsets; checks
	// run inside [start, end), which a subtable narrows to itself.
	type AatSanitizer {
		internal d          Data
		internal start      int
		internal end        int
		// Bytes left to check: 64 per byte of the table, at least 16384.
		internal ops        int
		internal numGlyphs  int
		// Where `ankr` glyph anchors are counted from.
		internal anchorBase int
		// Entries the last state table reached.
		internal entries    int

		def new(table byte[], numGlyphs int) {
			d = new Data(table)
			end = table.len()
			ops = (table.len() * 64).clamp(16384, 0x3FFFFFFF)
			self.numGlyphs = numGlyphs
		}

		// A fixed-size structure: inside the range, free.
		def fits(at int, n int) bool {
			return at >= start && at <= end && end - at >= n
		}

		// `n` bytes from `at` inside the range; charges them. Sizes past 32
		// bits overflow in HarfBuzz and fail.
		def range(at int, n int) bool {
			return false when n < 0 || n > 0xFFFFFFFF || !fits(at, n)
			ops -= n
			return ops > 0
		}

		// Narrows the range to the structure at `at` of `size` bytes, as
		// HarfBuzz's set_object; nothing fits when `at` is outside it.
		def narrow(at int, size int) {
			if at < start || end <= at {
				start = 0
				end = -1
				return
			}
			end = at + (end - at).min(size)
			start = at
		}

		def widen() {
			start = 0
			end = d.len()
		}

		// A `Lookup` of `size`-byte values; with `anchors`, values are
		// offsets to `ankr` glyph anchors, checked too.
		def lookup(at int, size int, anchors bool = false) bool {
			return false unless fits(at, 2)
			let format = d.u16(at)
			if format == 0 {
				return false unless range(at + 2, numGlyphs * (anchors ?? (2, size)))
				for let i = 0; anchors && i < numGlyphs; i++ {
					return false unless anchorOffset(at + 2 + i * 2)
				}
				return true
			}
			if format := 2 || 4 || 6 {
				return false unless fits(at + 2, 10)
				let unit = d.u16(at + 2)
				let units = d.u16(at + 4)
				let minimum = format == 2 ?? (4 + size, format == 4 ?? (6, 2 + size))
				return false when unit < minimum || !range(at + 12, units * unit)
				// A last unit of 0xFFFF words ends the search and is no
				// segment: two words for formats 2 and 4, one for 6.
				let count = units
				if units > 0 {
					let last = at + 12 + (units - 1) * unit
					let terminator = d.u16(last) == 0xFFFF && (format == 6 || d.u16(last + 2) == 0xFFFF)
					count-- when terminator
				}
				for let i = 0; i < count; i++ {
					let p = at + 12 + i * unit
					if format == 4 {
						// Segments of values: last, first, offset from the lookup.
						return false unless fits(p, 6) && d.u16(p + 2) <= d.u16(p)
						let values = at + d.u16(p + 4)
						let n = d.u16(p) - d.u16(p + 2) + 1
						return false unless range(values, n * (anchors ?? (2, size)))
						for let k = 0; anchors && k < n; k++ {
							return false unless anchorOffset(values + k * 2)
						}
					} else if anchors {
						let value = format == 2 ?? (p + 4, p + 2)
						return false unless fits(p, value - p + 2) && anchorOffset(value)
					}
				}
				return true
			}
			if format == 8 {
				return false unless fits(at, 6)
				let count = d.u16(at + 4)
				return false unless range(at + 6, count * (anchors ?? (2, size)))
				for let i = 0; anchors && i < count; i++ {
					return false unless anchorOffset(at + 6 + i * 2)
				}
				return true
			}
			if format == 10 {
				return false when anchors // not supported with offsets
				return fits(at, 8) && d.u16(at + 2) <= 4 && range(at + 8, d.u16(at + 6) * d.u16(at + 2))
			}
			return true
		}

		// An offset to an `ankr` glyph's anchor array (a u32 count of
		// 4-byte points).
		def anchorOffset(at int) bool {
			return false unless fits(at, 2)
			let anchors = anchorBase + d.u16(at)
			return fits(anchors, 4) && range(anchors + 4, d.u32(anchors) * 4)
		}

		// A state table at `at` whose entries are `entrySize` bytes:
		// extended (morx, kerx: 32-bit header, lookup classes, 16-bit
		// states) or not (mort, kern: 16-bit header, byte classes and
		// states, states named by byte offset). Walks every state and entry
		// reachable from the start state; sets `entries`.
		def stateTable(at int, extended bool, entrySize int) bool {
			let w = extended ?? (4, 2)
			return false unless fits(at, 4 * w)
			let word = (p int) => extended ?? (self.d.u32(p), self.d.u16(p))
			let classes = word(at)
			let stateArray = word(at + 2 * w)
			return false when classes < 4
			let classTable = at + word(at + w)
			if extended {
				return false unless lookup(classTable, 2)
			} else {
				return false unless fits(classTable, 4) && range(classTable + 4, d.u16(classTable + 2))
			}
			let states = at + stateArray
			let entryArray = at + word(at + 3 * w)
			let cell = extended ?? (2, 1)
			let stride = classes * cell
			return false when stride > 0xFFFFFFFF
			let minState = 0
			let maxState = 0
			let reached = 0
			let statePos = 0
			let stateNeg = 0
			let entry = 0
			for minState < stateNeg || statePos <= maxState {
				// A state before the start one (mort, kern) fails HarfBuzz's
				// unsigned overflow check of its row index: such a table is
				// dropped.
				return false when minState < stateNeg
				return false unless (maxState + 1) * stride <= 0xFFFFFFFF && range(states, (maxState + 1) * stride)
				ops -= maxState - statePos + 1
				return false when ops <= 0
				for let i = statePos * classes; i < (maxState + 1) * classes; i++ {
					let v = extended ?? (d.u16(states + i * 2), d.u8(states + i))
					reached = reached.max(v + 1)
				}
				statePos = maxState + 1
				return false unless range(entryArray, reached * entrySize)
				ops -= reached - entry
				return false when ops <= 0
				for let i = entry; i < reached; i++ {
					let next = d.u16(entryArray + i * entrySize)
					// mort and kern name states by byte offset into the array,
					// divided as C divides (toward zero).
					let offset = next - stateArray
					let state = extended ?? (next, offset >= 0 ?? (offset / classes, -(-offset / classes)))
					minState = minState.min(state)
					maxState = maxState.max(state)
				}
				entry = reached
			}
			entries = reached
			return true
		}

		// The per-subtable glyph coverage bitfields after a version 3 chain
		// or kerx table.
		def subtableCoverage(at int, count int) bool {
			return false unless range(at, count * 4)
			let bytes = (numGlyphs + 7) / 8
			for let i = 0; i < count; i++ {
				let off = d.u32(at + i * 4)
				continue when off := 0 || 0xFFFFFFFF
				return false unless range(at + off, bytes)
			}
			return true
		}

		// `morx` (extended) or `mort`.
		def morx(extended bool) bool {
			return false unless fits(0, 2) && d.u16(0) != 0 && fits(4, 4)
			let version = d.u16(0)
			let chain = 8
			for let i = 0; i < d.u32(4); i++ {
				return false unless self.chain(chain, version, extended)
				chain += d.u32(chain + 4)
			}
			return true
		}

		def chain(at int, version int, extended bool) bool {
			let w = extended ?? (4, 2)
			return false unless fits(at + 4, 4)
			let length = d.u32(at + 4)
			return false unless length >= 8 + 2 * w && range(at, length)
			let features = extended ?? (d.u32(at + 8), d.u16(at + 8))
			let count = extended ?? (d.u32(at + 8 + w), d.u16(at + 8 + w))
			return false unless range(at + 8 + 2 * w, features * 12)
			let sub = at + 8 + 2 * w + features * 12
			for let i = 0; i < count; i++ {
				return false unless chainSubtable(sub, extended)
				sub += extended ?? (d.u32(sub), d.u16(sub))
			}
			return version < 3 || subtableCoverage(sub, count)
		}

		def chainSubtable(at int, extended bool) bool {
			let w = extended ?? (4, 2)
			return false unless fits(at, w)
			let length = extended ?? (d.u32(at), d.u16(at))
			return false unless length >= 2 * w + 4 && range(at, length)
			let kind = extended ?? (d.u8(at + 7), d.u8(at + 3))
			let body = at + 2 * w + 4
			let word = (p int) => extended ?? (self.d.u32(p), self.d.u16(p))
			match kind {
				case 0:
					return stateTable(body, extended, 4)
				case 1:
					return false unless stateTable(body, extended, 8)
					// Substitution lookups: as many as entries name (mort
					// tables use none of them here).
					let lookups = 0
					if extended {
						for let i = 0; i < entries; i++ {
							let e = word(body + 3 * w) + body + i * 8
							lookups = lookups.max(d.u16(e + 4) + 1) when d.u16(e + 4) != 0xFFFF
							lookups = lookups.max(d.u16(e + 6) + 1) when d.u16(e + 6) != 0xFFFF
						}
					}
					return false unless fits(body + 4 * w, w)
					let list = body + word(body + 4 * w)
					return false unless range(list, lookups * w)
					for let i = 0; i < lookups; i++ {
						return false unless fits(list + i * w, w) && lookup(list + word(list + i * w), 2)
					}
					return true
				case 2:
					return false unless fits(body, 7 * w) && stateTable(body, extended, extended ?? (6, 4))
					return word(body + 4 * w) != 0 && word(body + 5 * w) != 0 && word(body + 6 * w) != 0
				case 4:
					return lookup(body, 2)
				case 5:
					return fits(body, 5 * w) && stateTable(body, extended, 8) && word(body + 4 * w) != 0
			}
			return true
		}

		// `kern`: the OpenType (version 0) or Apple (version 1.0) layout.
		def kern() bool {
			return false unless fits(0, 4)
			return kerxTable(false, 6) when d.u16(0) == 0
			return kerxTable(false, 8) when d.u16(0) == 1
			return true
		}

		// `kerx`, or `kern` with subtable headers of `header` bytes (6 for
		// OpenType, 8 for Apple). Every subtable but the last is checked
		// inside its own length: old `kern` tables overflow the 16-bit one
		// of their last subtable.
		def kerxTable(extended bool, header int) bool {
			let version = 0
			let count = 0
			let sub = 0
			if extended {
				return false unless fits(0, 2) && d.u16(0) >= 2 && fits(4, 4)
				version = d.u16(0)
				count = d.u32(4)
				sub = 8
			} else if header == 6 {
				return false unless fits(0, 2) && fits(2, 2)
				count = d.u16(2)
				sub = 4
			} else {
				return false unless fits(0, 4) && d.u32(0) >= 0x00010000 && fits(4, 4)
				version = d.u16(0)
				count = d.u32(4)
				sub = 8
			}
			for let i = 0; i < count; i++ {
				return false unless fits(sub, header)
				let length = subtableLength(sub, extended, header)
				narrow(sub, length) when i < count - 1
				let ok = kerxSubtable(sub, extended, header)
				widen()
				return false unless ok
				sub += length
			}
			return version < 3 || subtableCoverage(sub, count)
		}

		def subtableLength(at int, extended bool, header int) int {
			return d.u32(at) when extended || header == 8
			return d.u16(at + 2)
		}

		def kerxSubtable(at int, extended bool, header int) bool {
			return false unless fits(at, header)
			let length = subtableLength(at, extended, header)
			return false unless length >= header && range(at, length)
			let w = extended ?? (4, 2)
			let word = (p int) => extended ?? (self.d.u32(p), self.d.u16(p))
			let format = extended ?? (d.u8(at + 7), header == 6 ?? (d.u8(at + 4), d.u8(at + 5)))
			let body = at + header
			match format {
				case 0:
					return fits(body, 4 * w) && range(body + 4 * w, word(body) * 6)
				case 1:
					return fits(at, header + 5 * w) && stateTable(body, extended, extended ?? (6, 4))
				case 2:
					return false unless fits(at, header + 4 * w)
					for let k = 1; k <= 2; k++ {
						let classes = at + word(body + k * w)
						if extended {
							return false unless lookup(classes, 2)
						} else {
							return false unless fits(classes, 4) && range(classes + 4, d.u16(classes + 2) * 2)
						}
					}
					return range(at, word(body + 3 * w))
				case 3:
					// kerx has no format 3 and HarfBuzz lets it pass.
					return true when extended
					return fits(at, header + 6) && range(body + 6, d.u8(body + 2) * 2 + d.u16(body) * 2 + d.u8(body + 3) * d.u8(body + 4))
				case 4:
					return true unless extended // kern has no format 4
					return fits(at, header + 4 * w + 4) && stateTable(body, true, 6)
				case 6:
					return true unless extended // nor format 6
					return false unless fits(at, header + 24)
					let size = d.u32(body) & 1 != 0 ?? (4, 2)
					return false unless lookup(at + d.u32(body + 8), size) && lookup(at + d.u32(body + 12), size)
					return range(at, d.u32(body + 16)) && (d.u32(at + 8) == 0 || range(at, d.u32(body + 20)))
			}
			return true
		}

		// `ankr`: the lookup from glyphs to their anchor arrays.
		def ankr() bool {
			return false unless fits(0, 12) && d.u16(0) == 0
			anchorBase = d.u32(8)
			return false unless range(0, anchorBase)
			let lookupAt = d.u32(4)
			return lookupAt == 0 || lookup(lookupAt, 2, true)
		}

		// `trak`: horizontal and vertical track data, each optional.
		def trak() bool {
			return false unless fits(0, 12) && d.u16(0) == 1
			return trackData(d.u16(6)) && trackData(d.u16(8))
		}

		def trackData(off int) bool {
			return true when off == 0
			return false unless fits(off, 8)
			let tracks = d.u16(off)
			let sizes = d.u16(off + 2)
			return false unless range(d.u32(off + 4), sizes * 4) && range(off + 8, tracks * 8)
			for let i = 0; i < tracks; i++ {
				let e = off + 8 + i * 8
				return false unless fits(e, 8) && range(d.u16(e + 6), sizes * 2)
			}
			return true
		}

		// `feat`: feature names and their setting arrays.
		def feat() bool {
			return false unless fits(0, 12) && d.u16(0) == 1
			let count = d.u16(4)
			return false unless range(12, count * 12)
			for let i = 0; i < count; i++ {
				let f = 12 + i * 12
				return false unless fits(f, 12) && range(d.u32(f + 4), d.u16(f + 2) * 4)
			}
			return true
		}

		// `ltag`: language tag strings.
		def ltag() bool {
			return false unless fits(0, 12) && d.u32(0) >= 1
			let count = d.u32(8)
			return false unless range(12, count * 4)
			for let i = 0; i < count; i++ {
				let r = 12 + i * 4
				return false unless fits(r, 4) && range(d.u16(r), d.u16(r + 2))
			}
			return true
		}
	}

	// The table as HarfBuzz would use it: empty when it does not validate.
	// `tag` is one of morx, mort, kerx, kern, ankr, trak, feat, ltag.
	def sanitizeAat(tag string, table byte[], numGlyphs int) byte[] {
		return table when table.len() == 0
		let s = new AatSanitizer(table, numGlyphs)
		let ok = true
		match tag {
			case "morx":
				ok = s.morx(true)
			case "mort":
				ok = s.morx(false)
			case "kerx":
				ok = s.kerxTable(true, 12)
			case "kern":
				ok = s.kern()
			case "ankr":
				ok = s.ankr()
			case "trak":
				ok = s.trak()
			case "feat":
				ok = s.feat()
			case "ltag":
				ok = s.ltag()
		}
		return ok ?? (table, byte[])
	}

	// Whether HarfBuzz ignores this font's `morx`: one whose table sizes
	// (morx, and the GSUB and GDEF it keeps) mark it as broken.
	def morxBlocklisted(morx int, gsub int, gdef int) bool {
		return morx == 19892 && gsub == 2794 && gdef == 340 // AALMAGHRIBI.ttf, harfbuzz#4108
	}
}
