partial module std.formats.fonts.layout {
	use (
		std.testing
		std.formats.fonts
	)

	// The AAT fixtures with one field changed; outcomes are what HarfBuzz
	// 14.1 does with the same bytes (fontkit/aatsan/unitcases.py).
	check "AAT sanitizer" {
		// The `tag` table of `font` and its glyph count.
		def tableOf(font string, tag string) !(byte[], int) {
			let face = try (try fonts.load("samples/fonts/ttf/{font}")).face(0)
			if face is fonts.OpenTypeFace {
				let t = face.table(tag)
				return (t is none ?? (byte[], t.clone()), int(face.info().glyphCount))
			}
			fail "{font} is not an sfnt face"
		}

		// Whether HarfBuzz's rules keep `tag` of `font` with the big-endian
		// `value` of `size` bytes written at `at`.
		def keptWith(font string, tag string, at int, size int, value int) !bool {
			let (table, glyphs) = try tableOf(font, tag)
			for let k = 0; k < size; k++ {
				table[at + k] = byte(value >> ((size - 1 - k) * 8) & 0xFF)
			}
			return sanitizeAat(tag, table, glyphs).len() > 0
		}

		def kept(font string, tag string) !bool {
			let (table, glyphs) = try tableOf(font, tag)
			return table.len() > 0 && sanitizeAat(tag, table, glyphs).len() == table.len()
		}

		@test()
		def keepsValidTables() !none {
			assert try kept("aat-morx.ttf", "morx")
			assert try kept("aat-mort.ttf", "mort")
			assert try kept("aat-feat.ttf", "feat")
			assert try kept("aat-trak.ttf", "trak")
			for let (_, font) in ["aat-kerx0.ttf", "aat-kerx1.ttf", "aat-kerx2.ttf", "aat-kerx4.ttf", "aat-kerx4cp.ttf", "aat-kerx6.ttf"] {
				assert try kept(font, "kerx")
			}
			assert try kept("aat-kerx4.ttf", "ankr")
			assert try kept("aat-kern1.ttf", "kern")
			assert try kept("aat-kern3.ttf", "kern")
			assert sanitizeAat("morx", byte[], 10).len() == 0 // no table, nothing to keep
		}

		@test()
		def dropsBrokenTablesWhole() !none {
			assert !(try keptWith("aat-morx.ttf", "morx", 12, 4, 698)) // chain longer than the table
			assert !(try keptWith("aat-morx.ttf", "morx", 36, 4, 3)) // state table with fewer than 4 classes
			assert !(try keptWith("aat-morx.ttf", "morx", 0, 2, 0)) // version 0
			assert !(try keptWith("aat-mort.ttf", "mort", 12, 4, 422)) // chain longer than the table
			assert !(try keptWith("aat-kerx2.ttf", "kerx", 32, 4, 161)) // class array past the subtable
			assert !(try keptWith("aat-trak.ttf", "trak", 6, 2, 52)) // horizontal data at the end
			assert !(try keptWith("aat-feat.ttf", "feat", 16, 4, 52)) // settings past the end
			assert try keptWith("aat-kerx6.ttf", "kerx", 40, 4, 0xFFFF) // the vector is unchecked without tuples
		}
	}
}
