internal partial module std.formats.fonts.layout {
	// How a positioned glyph hangs off another (Positions.attachType).
	const (
		attachMark    = 1
		attachCursive = 2
	)

	const (
		maxNesting       = 64
		maxContextLength = 64
	)

	// What a sequence of match values means.
	const (
		matchNone     = 0
		matchGlyph    = 1
		matchClass    = 2
		matchCoverage = 3
		// Every visible entry matches: the rule-set fast paths peek ahead.
		matchAlways   = 4
	)

	// Outcomes of testing one entry against a matcher.
	const (
		resultMatch    = 0
		resultNotMatch = 1
		resultSkip     = 2
	)

	// Whether a lookup with `props` sees entry `i`.
	def glyphVisible(gdef Gdef, info Infos, i int, props int) bool {
		let g = info.gprops[i]
		return false when g & props & flagIgnoreMask != 0
		if g & propsMark != 0 {
			return gdef.markSetCovers(props >> 16, info.glyph[i]) when props & flagUseMarkFilteringSet != 0
			return props & flagMarkAttachmentType == g & flagMarkAttachmentType when props & flagMarkAttachmentType != 0
		}
		return true
	}

	// A quick, inexact set of glyphs: three 64-bit masks of glyph id bits
	// (HarfBuzz's set digest). It may say yes to a glyph never added, never
	// no to one that was.
	type GlyphDigest {
		internal masks int[]

		def new() {
			masks = [0, 0, 0]
		}

		def add(g int) {
			masks[0] |= 1 << ((g >> 4) & 63)
			masks[1] |= 1 << (g & 63)
			masks[2] |= 1 << ((g >> 6) & 63)
		}

		def fill() {
			masks = [-1, -1, -1]
		}

		def mayHave(g int) bool {
			return masks[0] & (1 << ((g >> 4) & 63)) != 0 && masks[1] & (1 << (g & 63)) != 0 && masks[2] & (1 << ((g >> 6) & 63)) != 0
		}
	}

	// Walks the buffer from a position to the next (or previous) entry a
	// lookup can see, skipping what its flags ignore, and tests entries
	// against a sequence of glyph ids, classes or coverages.
	type Skipper {
		internal buffer       Buffer
		internal gdef         Gdef
		internal d            Data
		idx                   int
		internal end          int
		lookupProps           int
		internal mask         int
		internal ignoreZWNJ   bool
		internal ignoreZWJ    bool
		internal ignoreHidden bool
		internal perSyllable  bool
		internal syllable     int
		// The match sequence: kind, the table offset its values are
		// relative to (class def or subtable), and where the u16 values are.
		internal kind         int
		internal base         int
		internal values       int
		internal next         int
		// After a failed `forward`: where breaking is safe again (one past
		// the entry that failed, or the end); after a failed `backward`, the
		// first entry that mattered.
		unsafeTo              int
		unsafeFrom            int

		def new(buffer Buffer, gdef Gdef, d Data) {
			self.buffer = buffer
			self.gdef = gdef
			self.d = d
		}

		def init(c ApplyContext, contextMatch bool) {
			kind = matchNone
			values = 0
			next = 0
			lookupProps = c.lookupProps
			ignoreZWNJ = c.table == 1 || (contextMatch && c.autoZWNJ)
			ignoreZWJ = contextMatch || c.autoZWJ
			ignoreHidden = c.table == 1
			mask = contextMatch ?? (-1, c.lookupMask)
			perSyllable = c.table == 0 && c.perSyllable
			syllable = 0
			end = buffer.len
		}

		// Match against the u16 values at `values` of kind `kind`.
		def setMatch(kind int, base int, values int) {
			self.kind = kind
			self.base = base
			self.values = values
			next = 0
		}

		def reset(start int) {
			idx = start
			end = buffer.len
			let b = buffer
			syllable = b.idx < b.len ?? (b.info.syllable[b.idx], 0)
		}

		def resetFast(start int) {
			idx = start
		}

		// 0 no, 1 yes, 2 maybe.
		def maySkip(info Infos, i int) int {
			return 1 when !glyphVisible(gdef, info, i, lookupProps)
			return 2 when info.isDefaultIgnorable(i) && (ignoreZWNJ || !info.isZWNJ(i)) && (ignoreZWJ || !info.isZWJ(i)) && (ignoreHidden || !info.isHidden(i))
			return 0
		}

		// 0 no, 1 yes, 2 maybe.
		internal def mayMatch(info Infos, i int) int {
			return 0 when info.mask[i] & mask == 0
			return 0 when perSyllable && syllable != 0 && syllable != info.syllable[i]
			return 2 when kind == matchNone
			return 1 when kind == matchAlways
			let v = d.u16(values + next * 2)
			let g = info.glyph[i]
			return g == v ?? (1, 0) when kind == matchGlyph
			return d.classOf(base, g) == v ?? (1, 0) when kind == matchClass
			return d.coverage(base + v, g) >= 0 ?? (1, 0)
		}

		def test(info Infos, i int) int {
			let skip = maySkip(info, i)
			return resultSkip when skip == 1
			let m = mayMatch(info, i)
			return resultMatch when m == 1 || (m == 2 && skip == 0)
			return resultNotMatch when skip == 0
			return resultSkip
		}

		// Moves to the next visible entry; false when it does not match or the
		// buffer ends.
		def forward() bool {
			let info = buffer.info
			for idx < end - 1 {
				idx++
				let r = test(info, idx)
				if r == resultMatch {
					next++
					return true
				}
				if r == resultNotMatch {
					unsafeTo = idx + 1
					return false
				}
			}
			unsafeTo = end
			return false
		}

		// Moves back through the output.
		def backward() bool {
			let info = buffer.out
			for idx > 0 {
				idx--
				let r = test(info, idx)
				if r == resultMatch {
					next++
					return true
				}
				if r == resultNotMatch {
					unsafeFrom = idx.max(1) - 1
					return false
				}
			}
			unsafeFrom = 0
			return false
		}
	}

	// State of one GSUB or GPOS pass over a buffer.
	type ApplyContext {
		// 0 for GSUB, 1 for GPOS.
		table               int
		// The instance's normalized coordinates; `varied` when any is off
		// the default, which is when device deltas apply.
		coords              int[]
		varied              bool
		lt                  LayoutTable
		d                   Data
		buffer              Buffer
		gdef                Gdef
		hasGlyphClasses     bool
		direction           int
		lookupMask          int
		lookupIndex         int
		lookupProps         int
		nestingLeft         int
		autoZWNJ            bool
		autoZWJ             bool
		perSyllable         bool
		random              bool
		newSyllables        int
		lastBase            int
		lastBaseUntil       int
		matchPositions      int[]
		iterInput           Skipper
		iterContext         Skipper
		internal subOffsets int[][]
		internal subTypes   int[][]
		internal subLoaded  bool[]
		// Second-component digests of ligature subtables, by offset.
		internal digests    map<int, GlyphDigest>

		def new(table int, lt LayoutTable, buffer Buffer, gdef Gdef, coords int[] = int[]) {
			self.table = table
			self.coords = coords
			for let (_, v) in coords {
				varied = true when v != 0
			}
			self.lt = lt
			d = lt.data()
			self.buffer = buffer
			self.gdef = gdef
			hasGlyphClasses = gdef.hasGlyphClasses()
			direction = buffer.direction
			lookupMask = 1
			lookupIndex = -1
			nestingLeft = maxNesting
			autoZWNJ = true
			autoZWJ = true
			newSyllables = -1
			lastBase = -1
			let n = lt.lookupCount()
			subOffsets.len(n)
			subTypes.len(n)
			subLoaded.len(n)
			iterInput = new Skipper(buffer, gdef, d)
			iterContext = new Skipper(buffer, gdef, d)
			digests = map<int, GlyphDigest>{}
			initIters()
		}

		// The glyphs that may follow the first of a ligature in a
		// LigatureSubst subtable, as HarfBuzz's digest has them (a ligature
		// of one component lets anything through).
		def secondsDigest(sub int) GlyphDigest {
			let known = digests.get(sub)
			return known when known is GlyphDigest
			let digest = new GlyphDigest()
			for let k = 0; k < d.u16(sub + 4); k++ {
				let set = sub + d.u16(sub + 6 + k * 2)
				for let l = 0; l < d.u16(set); l++ {
					let lig = set + d.u16(set + 2 + l * 2)
					if d.u16(lig + 2) <= 1 {
						digest.fill()
					} else {
						digest.add(d.u16(lig + 4))
					}
				}
			}
			digests[sub] = digest
			return digest
		}

		def initIters() {
			iterInput.init(self, false)
			iterContext.init(self, true)
		}

		def useLookupMask(mask int) {
			lookupMask = mask
			lastBase = -1
			lastBaseUntil = 0
			initIters()
		}

		def useLookupProps(props int) {
			lookupProps = gdef.sanitizeLookupProps(props)
			initIters()
		}

		def checkGlyphProperty(info Infos, i int, props int) bool {
			return glyphVisible(gdef, info, i, props)
		}

		// minstd_rand, with the product wrapped to 32 bits as unsigned
		// arithmetic does, so a font's random alternates match other shapers.
		def randomNumber() int {
			buffer.randomState = ((buffer.randomState * 48271) & 0xFFFFFFFF) % 2147483647
			return buffer.randomState
		}

		// Gives the current entry the class of `glyph` and substitution flags.
		internal def setGlyphClass(glyph int, classGuess int, ligature bool, multiplied bool) {
			let b = buffer
			let i = b.idx
			b.info.syllable[i] = newSyllables when newSyllables >= 0
			let props = b.info.gprops[i] | propsSubstituted
			if ligature {
				props |= propsLigated
				props &= ~propsMultiplied
			}
			props |= propsMultiplied when multiplied
			if hasGlyphClasses {
				b.info.gprops[i] = props & propsPreserve | gdef.glyphProps(glyph)
			} else if classGuess != 0 {
				b.info.gprops[i] = props & propsPreserve | classGuess
			} else {
				b.info.gprops[i] = props
			}
		}

		def replaceGlyph(glyph int) {
			setGlyphClass(glyph, 0, ligature = false, multiplied = false)
			buffer.replaceGlyph(glyph)
		}

		def replaceGlyphInPlace(glyph int) {
			setGlyphClass(glyph, 0, ligature = false, multiplied = false)
			buffer.info.glyph[buffer.idx] = glyph
		}

		def replaceWithLigature(glyph int, classGuess int) {
			setGlyphClass(glyph, classGuess, ligature = true, multiplied = false)
			buffer.replaceGlyph(glyph)
		}

		def outputForComponent(glyph int, classGuess int) {
			setGlyphClass(glyph, classGuess, ligature = false, multiplied = true)
			buffer.outputGlyph(glyph)
		}

		// Subtables of lookup `li`, loaded once.
		internal def loadSubtables(li int) {
			return when subLoaded[li]
			let (offsets, types) = lt.subtables(li, table == 0 ?? (7, 9))
			subOffsets[li] = offsets
			subTypes[li] = types
			subLoaded[li] = true
		}

		// Applies lookup `li` at the current entry: the first subtable that
		// applies wins.
		def applyAt(li int) bool {
			loadSubtables(li)
			let offsets = subOffsets[li]
			let types = subTypes[li]
			for let (s, off) in offsets {
				let ok = table == 0 ?? (applySubst(self, types[s], off), applyPos(self, types[s], off))
				return true when ok
			}
			return false
		}

		// A nested lookup from a contextual rule.
		def recurse(li int) bool {
			return false when nestingLeft == 0 || li >= lt.lookupCount()
			return false when !buffer.spend(1)
			let savedProps = lookupProps
			let savedIndex = lookupIndex
			lookupIndex = li
			useLookupProps(lt.lookupProps(li))
			// The nested lookup matches with its own positions.
			let saved = matchPositions
			matchPositions = int[]
			nestingLeft--
			let ret = applyAt(li)
			nestingLeft++
			matchPositions = saved
			lookupIndex = savedIndex
			useLookupProps(savedProps)
			return ret
		}

		// Runs lookup `li` over the whole buffer.
		def applyString(li int) {
			return when buffer.len == 0 || lookupMask == 0
			lookupIndex = li
			useLookupProps(lt.lookupProps(li))
			let reverse = table == 0 && lt.lookupType(li) == 8
			if !reverse {
				buffer.clearOutput() when table == 0
				buffer.idx = 0
				applyForward(li)
				buffer.sync() when table == 0
			} else {
				buffer.idx = buffer.len - 1
				applyBackward(li)
			}
		}

		internal def applyForward(li int) {
			let b = buffer
			for b.idx < b.len && b.successful {
				let applied = false
				applied = applyAt(li) when b.info.mask[b.idx] & lookupMask != 0 && checkGlyphProperty(b.info, b.idx, lookupProps)
				b.nextGlyph() when !applied
			}
		}

		internal def applyBackward(li int) {
			let b = buffer
			for b.idx >= 0 {
				applyAt(li) when b.info.mask[b.idx] & lookupMask != 0 && checkGlyphProperty(b.info, b.idx, lookupProps)
				b.idx--
			}
		}

		// Matches the rest of an input sequence after the current entry.
		// Returns whether it matched, where the match ends (on a failure,
		// where breaking is safe again, -1 when a ligature check failed),
		// and the total ligature components; `matchPositions` holds the
		// matched entries.
		def matchInput(count int, kind int, base int, values int) (bool, int, int) {
			let b = buffer
			matchPositions.len(count.max(1))
			matchPositions[0] = b.idx
			return (true, b.idx + 1, b.info.ligNumComps(b.idx)) when count == 1
			return (false, 0, 0) when count > maxContextLength

			let it = iterInput
			it.reset(b.idx)
			it.setMatch(kind, base, values)
			let total = 0
			let firstId = b.info.ligId(b.idx)
			let firstComp = b.info.ligComp(b.idx)
			// 0 not checked, 1 may not skip, 2 may skip.
			let ligbase = 0
			for let i = 1; i < count; i++ {
				return (false, it.unsafeTo, 0) when !it.forward()
				matchPositions[i] = it.idx
				let thisId = b.info.ligId(it.idx)
				let thisComp = b.info.ligComp(it.idx)
				if firstId != 0 && firstComp != 0 {
					// Components of one ligature, or of none: a mark on a
					// ligature component must not join a different component.
					if firstId != thisId || firstComp != thisComp {
						if ligbase == 0 {
							let found = false
							let j = b.outLen
							for j > 0 && b.out.ligId(j - 1) == firstId {
								if b.out.ligComp(j - 1) == 0 {
									j--
									found = true
									break
								}
								j--
							}
							ligbase = found && it.maySkip(b.out, j) == 1 ?? (2, 1)
						}
						return (false, -1, 0) when ligbase == 1
					}
				} else if thisId != 0 && thisComp != 0 && thisId != firstId {
					return (false, -1, 0)
				}
				total += b.info.ligNumComps(it.idx)
			}
			total += b.info.ligNumComps(b.idx)
			return (true, it.idx + 1, total)
		}

		// Replaces a matched input sequence with a ligature glyph, keeping the
		// marks in between and recording which component each belongs to.
		def ligateInput(count int, matchEnd int, ligGlyph int, totalComponents int) {
			let b = buffer
			b.mergeClusters(b.idx, matchEnd)
			let isBaseLigature = b.info.isBase(matchPositions[0])
			let isMarkLigature = b.info.isMark(matchPositions[0])
			for let i = 1; i < count; i++ {
				if !b.info.isMark(matchPositions[i]) {
					isBaseLigature = false
					isMarkLigature = false
					break
				}
			}
			let isLigature = !isBaseLigature && !isMarkLigature
			let klass = isLigature ?? (propsLigature, 0)
			let ligId = isLigature ?? (allocateLigId(), 0)
			let lastLigId = b.info.ligId(b.idx)
			let lastNumComps = b.info.ligNumComps(b.idx)
			let soFar = lastNumComps
			if isLigature {
				b.info.setLigForLigature(b.idx, ligId, totalComponents)
				b.info.setCategory(b.idx, catLo) when b.info.category(b.idx) == catMn
			}
			replaceWithLigature(ligGlyph, klass)
			for let i = 1; i < count; i++ {
				for b.idx < matchPositions[i] {
					if isLigature {
						let comp = b.info.ligComp(b.idx)
						comp = lastNumComps when comp == 0
						b.info.setLigForMark(b.idx, ligId, soFar - lastNumComps + comp.min(lastNumComps))
					}
					b.nextGlyph()
				}
				lastLigId = b.info.ligId(b.idx)
				lastNumComps = b.info.ligNumComps(b.idx)
				soFar += lastNumComps
				// Skip the component itself.
				b.idx++
			}
			if !isMarkLigature && lastLigId != 0 {
				// Marks after the last component that belonged to it.
				for let i = b.idx; i < b.len; i++ {
					break when b.info.ligId(i) != lastLigId
					let comp = b.info.ligComp(i)
					break when comp == 0
					b.info.setLigForMark(i, ligId, soFar - lastNumComps + comp.min(lastNumComps))
				}
			}
		}

		internal def allocateLigId() int {
			let id = buffer.nextSerial() & 0x07
			for id == 0 {
				id = buffer.nextSerial() & 0x07
			}
			return id
		}

		// Matches `count` entries before the current one; returns whether it
		// matched and where the match (or the failure that mattered) starts
		// in the output.
		def matchBacktrack(count int, kind int, base int, values int) (bool, int) {
			return (true, buffer.backtrackLen()) when count == 0
			let it = iterContext
			it.reset(buffer.backtrackLen())
			it.setMatch(kind, base, values)
			for let i = 0; i < count; i++ {
				return (false, it.unsafeFrom) when !it.backward()
			}
			return (true, it.idx)
		}

		// Matches `count` entries from `start` on; returns whether it matched
		// and where the match ends.
		def matchLookahead(count int, kind int, base int, values int, start int) (bool, int) {
			return (true, start) when count == 0
			let it = iterContext
			it.reset(start - 1)
			it.setMatch(kind, base, values)
			for let i = 0; i < count; i++ {
				return (false, it.unsafeTo) when !it.forward()
			}
			return (true, it.idx + 1)
		}

		// Runs the nested lookups of a matched rule: `records` points at
		// `lookupCount` (sequence index, lookup index) pairs.
		def applyLookupRecords(count int, lookupCount int, records int, matchEnd int) {
			let b = buffer
			let bl = b.backtrackLen()
			let end = bl + matchEnd - b.idx
			let delta = bl - b.idx
			for let j = 0; j < count; j++ {
				matchPositions[j] += delta
			}
			for let i = 0; i < lookupCount && b.successful; i++ {
				let seq = d.u16(records + i * 4)
				let li = d.u16(records + i * 4 + 2)
				continue when seq >= count
				let origLen = b.backtrackLen() + b.lookaheadLen()
				continue when matchPositions[seq] >= origLen
				b.moveTo(matchPositions[seq])
				break when !b.successful || b.maxOps <= 0
				continue when !recurse(li)

				let newLen = b.backtrackLen() + b.lookaheadLen()
				let dl = newLen - origLen
				continue when dl == 0
				end += dl
				if end < matchPositions[seq] {
					dl += matchPositions[seq] - end
					end = matchPositions[seq]
				}
				let next = seq + 1
				if dl > 0 {
					break when dl + count > maxContextLength
					matchPositions.len(count + dl) when matchPositions.len() < count + dl
				} else {
					dl = dl.max(next - count)
					next -= dl
				}
				// Shift the positions after the recursed one by `dl`.
				if dl > 0 {
					for let k = count - 1; k >= next; k-- {
						matchPositions[k + dl] = matchPositions[k]
					}
				} else {
					for let k = next; k < count; k++ {
						matchPositions[k + dl] = matchPositions[k]
					}
				}
				next += dl
				count += dl
				for let j = seq + 1; j < next; j++ {
					matchPositions[j] = matchPositions[j - 1] + 1
				}
				for next < count {
					matchPositions[next] += dl
					next++
				}
			}
			b.moveTo(end)
		}

		// A contextual rule: `input` values (after the first entry) of `kind`,
		// then lookup records.
		def contextRule(inputCount int, kind int, base int, input int, lookupCount int, records int) bool {
			return false when inputCount > maxContextLength
			let (ok, matchEnd, _) = matchInput(inputCount, kind, base, input)
			let b = buffer
			if !ok {
				b.unsafeToConcat(b.idx, matchEnd.max(0))
				return false
			}
			b.unsafeToBreak(b.idx, matchEnd)
			applyLookupRecords(inputCount, lookupCount, records, matchEnd)
			return true
		}

		// A chained rule: backtrack, input and lookahead sequences, each with
		// its own kind and base.
		def chainRule(backCount int, backKind int, backBase int, back int, inputCount int, inKind int, inBase int, input int, aheadCount int, aheadKind int, aheadBase int, ahead int, lookupCount int, records int) bool {
			return false when inputCount > maxContextLength
			let b = buffer
			let (ok, matchEnd, _) = matchInput(inputCount, inKind, inBase, input)
			let endIndex = b.idx
			if ok {
				let (okAhead, aheadEnd) = matchLookahead(aheadCount, aheadKind, aheadBase, ahead, matchEnd)
				endIndex = aheadEnd
				ok = okAhead
			}
			if !ok {
				b.unsafeToConcat(b.idx, endIndex)
				return false
			}
			let (okBack, startIndex) = matchBacktrack(backCount, backKind, backBase, back)
			if !okBack {
				b.unsafeToConcat(startIndex, endIndex, true)
				return false
			}
			b.unsafeToBreak(startIndex, endIndex, true)
			applyLookupRecords(inputCount, lookupCount, records, matchEnd)
			return true
		}

		// Whether glyph `g` matches value `v` of a sequence of `kind`.
		def matchesValue(kind int, base int, g int, v int) bool {
			return g == v when kind == matchGlyph
			return d.classOf(base, g) == v when kind == matchClass
			return d.coverage(base + v, g) >= 0
		}

		// The next two entries a rule set may peek at, for the fast paths of
		// sets of more than four rules: (usable, first, second or -1). Not
		// usable when there is no next entry or a peeked one could be skipped.
		internal def peekTwo() (int, int, int) {
			let b = buffer
			let it = iterContext
			it.reset(b.idx)
			it.setMatch(matchAlways, 0, 0)
			return (0, -1, -1) when !it.forward()
			return (-1, -1, -1) when it.maySkip(b.info, it.idx) != 0
			let first = it.idx
			return (1, first, -1) when !it.forward()
			return (-1, -1, -1) when it.maySkip(b.info, it.idx) != 0
			return (1, first, it.idx)
		}

		// A Context rule set (formats 1 and 2): the first rule that applies.
		// Sets of more than four rules check the next two glyphs against each
		// rule first, as HarfBuzz does, which decides what is marked unsafe to
		// concatenate.
		def ruleSet(set int, kind int, base int) bool {
			let b = buffer
			let n = d.u16(set)
			let (peek, first, second) = n > 4 ?? (peekTwo(), (-1, -1, -1))
			let unsafeTo = -1
			let r = 0
			for r < n {
				let rule = set + d.u16(set + 2 + r * 2)
				let inputCount = d.u16(rule)
				let lookupCount = d.u16(rule + 2)
				let input = rule + 4
				let records = input + (inputCount - 1).max(0) * 2
				if peek == 0 && inputCount > 1 {
					// No next glyph: only rules without further input.
					r++
					continue
				}
				if peek == 1 {
					if inputCount <= 1 || matchesValue(kind, base, b.info.glyph[first], d.u16(input)) {
						if second >= 0 && inputCount > 2 && !matchesValue(kind, base, b.info.glyph[second], d.u16(input + 2)) {
							unsafeTo = second + 1
							r++
							continue
						}
					} else {
						unsafeTo = first + 1 when unsafeTo < 0
						// Rules sharing this first value fail too.
						let firstValue = d.u16(input)
						for r + 1 < n {
							let next = set + d.u16(set + 2 + (r + 1) * 2)
							break when d.u16(next) <= 1 || d.u16(next + 4) != firstValue
							r++
						}
						r++
						continue
					}
				}
				if d.has(records, lookupCount * 4) && contextRule(inputCount, kind, base, input, lookupCount, records) {
					b.unsafeToConcat(b.idx, unsafeTo) when peek == 1 && unsafeTo >= 0
					return true
				}
				r++
			}
			b.unsafeToConcat(b.idx, unsafeTo) when peek == 1 && unsafeTo >= 0
			return false
		}

		// A ChainContext rule set (formats 1 and 2), with the same fast path
		// as `ruleSet`, the lookahead standing in for short inputs.
		def chainRuleSet(set int, kind int, backDef int, inDef int, aheadDef int) bool {
			let b = buffer
			let n = d.u16(set)
			let (peek, first, second) = n > 4 ?? (peekTwo(), (-1, -1, -1))
			let unsafeTo = -1
			let r = 0
			for r < n {
				let rule = set + d.u16(set + 2 + r * 2)
				let backCount = d.u16(rule)
				let back = rule + 2
				let inAt = back + backCount * 2
				let inputCount = d.u16(inAt)
				let input = inAt + 2
				let aheadAt = input + (inputCount - 1).max(0) * 2
				let aheadCount = d.u16(aheadAt)
				let ahead = aheadAt + 2
				let lcAt = ahead + aheadCount * 2
				let lookupCount = d.u16(lcAt)
				if peek == 0 && (inputCount > 1 || aheadCount > 0) {
					r++
					continue
				}
				if peek == 1 {
					let ok1 = inputCount > 1 ?? (matchesValue(kind, inDef, b.info.glyph[first], d.u16(input)), aheadCount == 0 || matchesValue(kind, aheadDef, b.info.glyph[first], d.u16(ahead)))
					if ok1 {
						let lenP1 = inputCount.max(1)
						let ok2 = true
						if second >= 0 {
							if lenP1 > 2 {
								ok2 = matchesValue(kind, inDef, b.info.glyph[second], d.u16(input + 2))
							} else {
								ok2 = aheadCount <= 2 - lenP1 || matchesValue(kind, aheadDef, b.info.glyph[second], d.u16(ahead + (2 - lenP1) * 2))
							}
						}
						if !ok2 {
							unsafeTo = second + 1
							r++
							continue
						}
					} else {
						unsafeTo = first + 1 when unsafeTo < 0
						if inputCount > 1 {
							let firstValue = d.u16(input)
							for r + 1 < n {
								let next = set + d.u16(set + 2 + (r + 1) * 2)
								let nextIn = next + 2 + d.u16(next) * 2
								break when d.u16(nextIn) <= 1 || d.u16(nextIn + 2) != firstValue
								r++
							}
						}
						r++
						continue
					}
				}
				if d.has(lcAt + 2, lookupCount * 4) && chainRule(backCount, kind, backDef, back, inputCount, kind, inDef, input, aheadCount, kind, aheadDef, ahead, lookupCount, lcAt + 2) {
					b.unsafeToConcat(b.idx, unsafeTo) when peek == 1 && unsafeTo >= 0
					return true
				}
				r++
			}
			b.unsafeToConcat(b.idx, unsafeTo) when peek == 1 && unsafeTo >= 0
			return false
		}

		// Context lookups (GSUB 5, GPOS 7), formats 1..3.
		def applyContext(sub int) bool {
			let b = buffer
			let g = b.info.glyph[b.idx]
			let format = d.u16(sub)
			if format == 1 {
				let index = d.coverage(sub + d.u16(sub + 2), g)
				return false when index < 0 || index >= d.u16(sub + 4)
				return ruleSet(sub + d.u16(sub + 6 + index * 2), matchGlyph, 0)
			}
			if format == 2 {
				return false when d.coverage(sub + d.u16(sub + 2), g) < 0
				let classDef = sub + d.u16(sub + 4)
				let klass = d.classOf(classDef, g)
				return false when klass >= d.u16(sub + 6)
				let setOff = d.u16(sub + 8 + klass * 2)
				return false when setOff == 0
				return ruleSet(sub + setOff, matchClass, classDef)
			}
			if format == 3 {
				let count = d.u16(sub + 2)
				return false when count == 0
				return false when d.coverage(sub + d.u16(sub + 6), g) < 0
				let lookupCount = d.u16(sub + 4)
				let records = sub + 6 + count * 2
				return false when !d.has(records, lookupCount * 4)
				return contextRule(count, matchCoverage, sub, sub + 8, lookupCount, records)
			}
			return false
		}

		// Chained context lookups (GSUB 6, GPOS 8), formats 1..3.
		def applyChainContext(sub int) bool {
			let b = buffer
			let g = b.info.glyph[b.idx]
			let format = d.u16(sub)
			if format := 1 || 2 {
				let index = d.coverage(sub + d.u16(sub + 2), g)
				return false when index < 0
				let backDef = 0
				let inDef = 0
				let aheadDef = 0
				let kind = matchGlyph
				let setCount = 0
				let sets = 0
				if format == 1 {
					setCount = d.u16(sub + 4)
					sets = sub + 6
				} else {
					backDef = sub + d.u16(sub + 4)
					inDef = sub + d.u16(sub + 6)
					aheadDef = sub + d.u16(sub + 8)
					setCount = d.u16(sub + 10)
					sets = sub + 12
					index = d.classOf(inDef, g)
					kind = matchClass
				}
				return false when index >= setCount
				let setOff = d.u16(sets + index * 2)
				return false when setOff == 0
				return chainRuleSet(sub + setOff, kind, backDef, inDef, aheadDef)
			}
			if format == 3 {
				let backCount = d.u16(sub + 2)
				let back = sub + 4
				let inAt = back + backCount * 2
				let inputCount = d.u16(inAt)
				return false when inputCount == 0
				let input = inAt + 2
				return false when d.coverage(sub + d.u16(input), g) < 0
				let aheadAt = input + inputCount * 2
				let aheadCount = d.u16(aheadAt)
				let ahead = aheadAt + 2
				let lcAt = ahead + aheadCount * 2
				let lookupCount = d.u16(lcAt)
				return false when !d.has(lcAt + 2, lookupCount * 4)
				return chainRule(backCount, matchCoverage, sub, back, inputCount, matchCoverage, sub, input + 2, aheadCount, matchCoverage, sub, ahead, lookupCount, lcAt + 2)
			}
			return false
		}
	}
}
