internal partial module std.formats.fonts.layout {
	// The BASE table: baseline positions per script, for each axis.
	type BaseTable {
		internal d      Data
		internal coords int[]
		internal varied bool
		// The item variation store of BASE 1.1, for format 3 coordinates.
		internal store  VariationStore

		// `coords` (normalized F2Dot14) place the baselines at a variable
		// instance.
		def new(table byte[], coords int[] = int[]) {
			d = new Data(table)
			self.coords = coords
			for let (_, c) in coords {
				varied = true when c != 0
			}
			store = new VariationStore()
			if d.len() >= 12 && d.u16(0) == 1 && d.u16(2) >= 1 {
				store = new VariationStore(d, d.u32(8))
			}
		}

		// The baselines one script records on an axis: their tags, their
		// coordinates (font units), and the tag of the default baseline.
		// `scripts` are OpenType script tags in preference order; DFLT is
		// tried after them. Empty when the font records nothing.
		def baselines(scripts string[], vertical bool) (string[], int[], string) {
			let tags string[]
			let values int[]
			return (tags, values, "") when d.len() < 8 || d.u16(0) != 1
			let axisOff = d.u16(vertical ?? (6, 4))
			return (tags, values, "") when axisOff == 0
			let axis = axisOff
			let tagListOff = d.u16(axis)
			let scriptListOff = d.u16(axis + 2)
			return (tags, values, "") when tagListOff == 0 || scriptListOff == 0
			let tagList = axis + tagListOff
			let scriptList = axis + scriptListOff

			let record = -1
			let wanted = scripts.clone()
			wanted.push("DFLT")
			for let (_, want) in wanted {
				for let i = 0; i < d.u16(scriptList); i++ {
					let rec = scriptList + 2 + i * 6
					if d.tag(rec) == want {
						record = scriptList + d.u16(rec + 4)
						break
					}
				}
				break when record >= 0
			}
			return (tags, values, "") when record < 0

			let valuesOff = d.u16(record)
			return (tags, values, "") when valuesOff == 0
			let bv = record + valuesOff
			let defaultIndex = d.u16(bv)
			let count = d.u16(bv + 2)
			let tagCount = d.u16(tagList)
			for let i = 0; i < count && i < tagCount; i++ {
				let coordOff = d.u16(bv + 4 + i * 2)
				continue when coordOff == 0
				let coord = bv + coordOff
				// Format 2's contour point applies only at a pixel size; format
				// 3's device table moves the coordinate at a variable instance.
				continue when !d.has(coord, 4) || d.u16(coord) < 1 || d.u16(coord) > 3
				tags.push(d.tag(tagList + 2 + i * 4))
				let v = d.i16(coord + 2)
				if varied && d.u16(coord) == 3 {
					v += deviceDelta(d, device(d, coord, coord + 4), store, coords)
				}
				values.push(v)
			}
			let dominant = defaultIndex < tagCount ?? (d.tag(tagList + 2 + defaultIndex * 4), "")
			return (tags, values, dominant)
		}
	}
}
