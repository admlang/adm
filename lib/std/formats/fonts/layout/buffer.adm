internal partial module std.formats.fonts.layout {
	// Directions, numbered so the low bit says backward and the next says
	// vertical.
	const (
		dirLTR = 4
		dirRTL = 5
		dirTTB = 6
		dirBTT = 7
	)

	def isHorizontal(dir int) bool {
		return dir & ~1 == 4
	}

	def isVertical(dir int) bool {
		return dir & ~1 == 6
	}

	def isBackward(dir int) bool {
		return dir & ~2 == 5
	}

	def isForward(dir int) bool {
		return dir & ~2 == 4
	}

	// Unicode properties of a buffer entry (`Infos.uprops`): the category in
	// the low five bits, flags, then the modified combining class of a mark
	// (or the space kind of a space) in bits 8..15.
	const (
		upropsCategory     = 0x1F
		upropsIgnorable    = 0x20
		// Hidden like a default ignorable, but not skipped by lookups:
		// Mongolian free variation selectors, tags, CGJ.
		upropsHidden       = 0x40
		// Continues the grapheme of the entry before it.
		upropsContinuation = 0x80
		// For Format characters only, in the top byte.
		upropsZWJ          = 0x100
		upropsZWNJ         = 0x200
		upropsVS           = 0x400
	)

	// Glyph properties (`Infos.gprops`): the GDEF class as a flag bit, then
	// what substitution did to the glyph.
	const (
		propsBase        = 0x02
		propsLigature    = 0x04
		propsMark        = 0x08
		propsClassMask   = 0x0E
		propsSubstituted = 0x10
		propsLigated     = 0x20
		propsMultiplied  = 0x40
		propsPreserve    = 0x70
	)

	// Ligature properties (`Infos.lig`): ligature id in bits 5..7, a
	// ligature-base flag, and the component index or count in bits 0..3.
	const ligIsBase = 0x10

	// Scratch flags: what the text holds, so passes with nothing to do skip.
	const (
		scratchDefaultIgnorables = 0x1
		scratchContinuations     = 0x2
		scratchCGJ               = 0x4
		scratchSpaceFallback     = 0x8
		scratchFractionSlash     = 0x10
		scratchBrokenSyllable    = 0x20
		scratchVSFallback        = 0x40
		scratchGposAttachment    = 0x80
	)

	// Per-entry data of a buffer, as parallel arrays so an entry copies by
	// value.
	type Infos {
		// The code point until glyphs are mapped, then the glyph id.
		glyph    int[]
		// Feature masks: which lookups apply to the entry.
		mask     int[]
		// Byte offset of the entry's source text.
		cluster  int[]
		uprops   int[]
		gprops   int[]
		lig      int[]
		// Shaper scratch: syllable serial and type, shaper category, position.
		syllable int[]
		cat      int[]
		pos      int[]
		// Glyph id found by normalization; action codes of some shapers.
		aux      int[]

		def new() {}

		def len() int {
			return glyph.len()
		}

		// Grows or shrinks every array to `n` entries.
		def size(n int) {
			glyph.len(n)
			mask.len(n)
			cluster.len(n)
			uprops.len(n)
			gprops.len(n)
			lig.len(n)
			syllable.len(n)
			cat.len(n)
			pos.len(n)
			aux.len(n)
		}

		// Entry `i` becomes a copy of entry `j` of `from`.
		def copy(i int, from Infos, j int) {
			glyph[i] = from.glyph[j]
			mask[i] = from.mask[j]
			cluster[i] = from.cluster[j]
			uprops[i] = from.uprops[j]
			gprops[i] = from.gprops[j]
			lig[i] = from.lig[j]
			syllable[i] = from.syllable[j]
			cat[i] = from.cat[j]
			pos[i] = from.pos[j]
			aux[i] = from.aux[j]
		}

		def category(i int) int {
			return uprops[i] & upropsCategory
		}

		def setCategory(i int, c int) {
			uprops[i] = c | uprops[i] & (0xFF & ~upropsCategory)
		}

		def isUnicodeMark(i int) bool {
			let c = category(i)
			return c >= catMn && c <= catMe
		}

		def combiningClass(i int) int {
			return isUnicodeMark(i) ?? (uprops[i] >> 8, 0)
		}

		def setCombiningClass(i int, c int) {
			return when !isUnicodeMark(i)
			uprops[i] = c << 8 | uprops[i] & 0xFF
		}

		def isDefaultIgnorable(i int) bool {
			return uprops[i] & upropsIgnorable != 0 && gprops[i] & propsSubstituted == 0
		}

		def isHidden(i int) bool {
			return uprops[i] & upropsHidden != 0
		}

		def isContinuation(i int) bool {
			return uprops[i] & upropsContinuation != 0
		}

		def isZWJ(i int) bool {
			return category(i) == catCf && uprops[i] & upropsZWJ != 0
		}

		def isZWNJ(i int) bool {
			return category(i) == catCf && uprops[i] & upropsZWNJ != 0
		}

		def isVariationSelector(i int) bool {
			return category(i) == catCf && uprops[i] & upropsVS != 0
		}

		def isMark(i int) bool {
			return gprops[i] & propsMark != 0
		}

		def isBase(i int) bool {
			return gprops[i] & propsBase != 0
		}

		def isLigature(i int) bool {
			return gprops[i] & propsLigature != 0
		}

		def ligId(i int) int {
			return lig[i] >> 5
		}

		// Component of a ligature the entry belongs to; 0 on the ligature itself.
		def ligComp(i int) int {
			return lig[i] & ligIsBase != 0 ?? (0, lig[i] & 0x0F)
		}

		def ligNumComps(i int) int {
			return gprops[i] & propsLigature != 0 && lig[i] & ligIsBase != 0 ?? (lig[i] & 0x0F, 1)
		}

		def setLigForLigature(i int, id int, comps int) {
			lig[i] = id << 5 | ligIsBase | comps & 0x0F
		}

		def setLigForMark(i int, id int, comp int) {
			lig[i] = id << 5 | comp & 0x0F
		}
	}

	// Positions of a buffer's glyphs, in font units.
	type Positions {
		xAdvance    int[]
		yAdvance    int[]
		xOffset     int[]
		yOffset     int[]
		// Distance to the glyph this one attaches to (0 = none), and how.
		attachChain int[]
		attachType  int[]

		def new() {}

		def size(n int) {
			xAdvance.len(n)
			yAdvance.len(n)
			xOffset.len(n)
			yOffset.len(n)
			attachChain.len(n)
			attachType.len(n)
		}

		def clear() {
			xAdvance.fill(0)
			yAdvance.fill(0)
			xOffset.fill(0)
			yOffset.fill(0)
			attachChain.fill(0)
			attachType.fill(0)
		}

		def swap(i int, j int) {
			let t = xAdvance[i]
			xAdvance[i] = xAdvance[j]
			xAdvance[j] = t
			t = yAdvance[i]
			yAdvance[i] = yAdvance[j]
			yAdvance[j] = t
			t = xOffset[i]
			xOffset[i] = xOffset[j]
			xOffset[j] = t
			t = yOffset[i]
			yOffset[i] = yOffset[j]
			yOffset[j] = t
			t = attachChain[i]
			attachChain[i] = attachChain[j]
			attachChain[j] = t
			t = attachType[i]
			attachType[i] = attachType[j]
			attachType[j] = t
		}
	}

	// The text being shaped: code points turning into positioned glyphs.
	//
	// Lookups read entries at `idx` from `info` and write results to `out`.
	// Until a lookup changes the length, `out` is `info` itself and moving on
	// copies nothing; the first insertion splits them.
	type Buffer {
		info        Infos
		out         Infos
		pos         Positions
		len         int
		outLen      int
		idx         int
		haveOutput  bool
		// Whether `out` is its own storage rather than `info`.
		separate    bool
		direction   int
		script      string
		language    string
		scratch     int
		serial      int
		randomState int
		// False once a limit was hit: pathological fonts (substitutions that
		// multiply without end) stop instead of exhausting memory.
		successful  bool
		maxLen      int
		maxOps      int
		// Glyph a hidden default ignorable becomes; -1 until looked up.
		invisible   int

		def new() {
			info = new Infos()
			out = info
			pos = new Positions()
			invisible = -1
			randomState = 1
			successful = true
			maxLen = 0x3FFFFFFF
			maxOps = 0x1FFFFFFF
		}

		// Sets the limits for shaping the current text: 256 entries and 4096
		// operations per input entry, at least 65536 of each.
		def enter() {
			maxLen = (len * 256).max(65536)
			maxOps = (len * 4096).max(65536)
			successful = true
		}

		// Charges `n` operations; false (and unsuccessful) once over budget.
		def spend(n int) bool {
			maxOps -= n
			successful = false when maxOps < 0
			return successful
		}

		// Whether the output may grow to `n` entries.
		def canHold(n int) bool {
			successful = false when n > maxLen
			return successful
		}

		// Appends a code point from byte offset `cluster` of the text.
		def add(cp int, cluster int) {
			info.size(len + 1)
			info.glyph[len] = cp
			info.mask[len] = 0
			info.cluster[len] = cluster
			info.uprops[len] = 0
			info.gprops[len] = 0
			info.lig[len] = 0
			info.syllable[len] = 0
			info.cat[len] = 0
			info.pos[len] = 0
			info.aux[len] = 0
			len++
		}

		def nextSerial() int {
			serial++
			return serial
		}

		def clearOutput() {
			haveOutput = true
			idx = 0
			outLen = 0
			out = info
			separate = false
		}

		// Entries before the cursor: the output while there is one.
		def backtrackLen() int {
			return haveOutput ?? (outLen, idx)
		}

		def lookaheadLen() int {
			return len - idx
		}

		// Moves the rest of the input to the output and makes it the buffer.
		// After a failure the output is dropped and the input stays.
		def sync() {
			nextGlyphs(len - idx) when successful
			if !successful {
				haveOutput = false
				outLen = 0
				out = info
				separate = false
				idx = 0
				return
			}
			swapBuffers()
		}

		// Makes the output the buffer.
		def swapBuffers() {
			haveOutput = false
			info = out when separate
			len = outLen
			info.size(len)
			outLen = 0
			idx = 0
			out = info
			separate = false
		}

		// Room for `numOut` entries replacing `numIn`: splits `out` from `info`
		// when writing in place would overwrite entries not read yet.
		def makeRoom(numIn int, numOut int) bool {
			return false when !canHold(outLen + numOut)
			split() when !separate && outLen + numOut > idx + numIn
			out.size(outLen + numOut) when out.len() < outLen + numOut
			return true
		}

		// Copies the current entry to the output and moves on.
		def nextGlyph() {
			if haveOutput {
				if separate || outLen != idx {
					return when !canHold(outLen + 1)
					out.size(outLen + 1) when out.len() < outLen + 1
					out.copy(outLen, info, idx)
				}
				outLen++
			}
			idx++
		}

		def nextGlyphs(n int) {
			for let k = 0; k < n; k++ {
				nextGlyph()
			}
		}

		def skipGlyph() {
			idx++
		}

		// Replaces `numIn` entries at `idx` with `glyphs`, each a copy of the
		// first replaced entry with a new glyph.
		def replaceGlyphs(numIn int, glyphs int[]) {
			return when !makeRoom(numIn, glyphs.len())
			mergeClusters(idx, idx + numIn)
			let from = idx < len ?? (idx, idx - 1)
			// Read the template before writing: `out` may be `info`.
			let tmp = new Infos()
			tmp.size(1)
			tmp.copy(0, info, from)
			for let (k, g) in glyphs {
				out.copy(outLen + k, tmp, 0)
				out.glyph[outLen + k] = g
			}
			idx += numIn
			outLen += glyphs.len()
		}

		def replaceGlyph(g int) {
			if !separate && outLen == idx {
				// In place: nothing to copy.
				info.glyph[idx] = g
				idx++
				outLen++
				return
			}
			replaceGlyphs(1, [g])
		}

		def outputGlyph(g int) {
			replaceGlyphs(0, [g])
		}

		// Appends a copy of entry `j` of `from` to the output.
		def outputInfo(from Infos, j int) {
			let tmp = new Infos()
			tmp.size(1)
			tmp.copy(0, from, j)
			return when !makeRoom(0, 1)
			out.copy(outLen, tmp, 0)
			outLen++
		}

		def copyGlyph() {
			outputInfo(info, idx)
		}

		// Moves the cursor so that `i` entries are in the output, taking them
		// from the input or giving them back.
		def moveTo(i int) {
			if !haveOutput {
				idx = i
				return
			}
			if outLen < i {
				let count = i - outLen
				return when !makeRoom(count, count)
				for let k = 0; k < count; k++ {
					out.copy(outLen + k, info, idx + k) when separate || outLen + k != idx + k
				}
				idx += count
				outLen += count
			} else if outLen > i {
				let count = outLen - i
				shiftForward(count - idx) when idx < count
				idx -= count
				outLen -= count
				for let k = 0; k < count; k++ {
					info.copy(idx + k, out, outLen + k) when separate || idx + k != outLen + k
				}
			}
		}

		// Gives the output its own storage, holding what was written so far.
		internal def split() {
			let copy = new Infos()
			copy.size(outLen)
			for let i = 0; i < outLen; i++ {
				copy.copy(i, info, i)
			}
			out = copy
			separate = true
		}

		// Opens `count` free entries before `idx`.
		internal def shiftForward(count int) {
			return when !canHold(len + count) || !spend(len - idx)
			// Keep the written output apart before moving the input.
			split() when !separate
			info.size(len + count)
			for let i = len - 1; i >= idx; i-- {
				info.copy(i + count, info, i)
			}
			len += count
			idx += count
		}

		// Gives every entry in [start, end) the smallest cluster among them,
		// widening to whole clusters.
		def mergeClusters(start int, end int) {
			return when end - start < 2
			spend(end - start)
			let c = info.cluster[start]
			for let i = start + 1; i < end; i++ {
				c = info.cluster[i] when info.cluster[i] < c
			}
			if c != info.cluster[end - 1] {
				for end < len && info.cluster[end - 1] == info.cluster[end] {
					end++
				}
			}
			if c != info.cluster[start] {
				for idx < start && info.cluster[start - 1] == info.cluster[start] {
					start--
				}
			}
			if idx == start && info.cluster[start] != c {
				let old = info.cluster[start]
				for let i = outLen; i > 0 && out.cluster[i - 1] == old; i-- {
					out.cluster[i - 1] = c
				}
			}
			for let i = start; i < end; i++ {
				info.cluster[i] = c
			}
		}

		def mergeOutClusters(start int, end int) {
			return when end - start < 2
			spend(end - start)
			let c = out.cluster[start]
			for let i = start + 1; i < end; i++ {
				c = out.cluster[i] when out.cluster[i] < c
			}
			for start > 0 && out.cluster[start - 1] == out.cluster[start] {
				start--
			}
			for end < outLen && out.cluster[end - 1] == out.cluster[end] {
				end++
			}
			if end == outLen {
				let old = out.cluster[end - 1]
				for let i = idx; i < len && info.cluster[i] == old; i++ {
					info.cluster[i] = c
				}
			}
			for let i = start; i < end; i++ {
				out.cluster[i] = c
			}
		}

		// Drops the entry at `idx`, keeping its cluster alive in a neighbour.
		def deleteGlyph() {
			let c = info.cluster[idx]
			if (idx + 1 < len && c == info.cluster[idx + 1]) || (outLen > 0 && c == out.cluster[outLen - 1]) {
				skipGlyph()
				return
			}
			if outLen > 0 {
				if c < out.cluster[outLen - 1] {
					let old = out.cluster[outLen - 1]
					for let i = outLen; i > 0 && out.cluster[i - 1] == old; i-- {
						out.cluster[i - 1] = c
					}
				}
				skipGlyph()
				return
			}
			mergeClusters(idx, idx + 2) when idx + 1 < len
			skipGlyph()
		}

		// Removes, in place, every entry `drop` selects.
		def deleteWhere(drop def (int) bool) {
			let j = 0
			for let i = 0; i < len; i++ {
				if drop(i) {
					let c = info.cluster[i]
					continue when i + 1 < len && c == info.cluster[i + 1]
					if j > 0 {
						if c < info.cluster[j - 1] {
							let old = info.cluster[j - 1]
							for let k = j; k > 0 && info.cluster[k - 1] == old; k-- {
								info.cluster[k - 1] = c
							}
						}
						continue
					}
					mergeClusters(i, i + 2) when i + 1 < len
					continue
				}
				if j != i {
					info.copy(j, info, i)
					pos.xAdvance[j] = pos.xAdvance[i]
					pos.yAdvance[j] = pos.yAdvance[i]
					pos.xOffset[j] = pos.xOffset[i]
					pos.yOffset[j] = pos.yOffset[i]
					pos.attachChain[j] = pos.attachChain[i]
					pos.attachType[j] = pos.attachType[i]
				}
				j++
			}
			len = j
			info.size(len)
			pos.size(len)
		}

		def resetMasks(mask int) {
			for let i = 0; i < len; i++ {
				info.mask[i] = mask
			}
		}

		def setMasks(value int, mask int, clusterStart int, clusterEnd int) {
			return when mask == 0
			spend(len)
			value &= mask
			for let i = 0; i < len; i++ {
				let c = info.cluster[i]
				info.mask[i] = info.mask[i] & ~mask | value when c >= clusterStart && c < clusterEnd
			}
		}

		// Reverses entries [start, end), positions too once they exist.
		def reverseRange(start int, end int) {
			let i = start
			let j = end - 1
			let tmp = new Infos()
			tmp.size(1)
			for i < j {
				tmp.copy(0, info, i)
				info.copy(i, info, j)
				info.copy(j, tmp, 0)
				pos.swap(i, j) when pos.xAdvance.len() == len
				i++
				j--
			}
		}

		def reverse() {
			reverseRange(0, len)
		}

		// Reverses the order of groups, keeping each group's own order.
		def reverseGroups(same def (int, int) bool, merge bool) {
			return when len == 0
			let start = 0
			for let i = 1; i < len; i++ {
				if !same(i - 1, i) {
					mergeClusters(start, i) when merge
					reverseRange(start, i)
					start = i
				}
			}
			mergeClusters(start, len) when merge
			reverseRange(start, len)
			reverse()
		}

		def reverseClusters() {
			reverseGroups((a int, b int) => info.cluster[a] == info.cluster[b], false)
		}

		// End of the group starting at `start`.
		def groupEnd(start int, same def (int, int) bool) int {
			start++
			for start < len && same(start - 1, start) {
				start++
			}
			return start
		}

		def clusterEnd(start int) int {
			return groupEnd(start, (a int, b int) => info.cluster[a] == info.cluster[b])
		}

		// Stable insertion sort of [start, end), merging the clusters of moved
		// entries.
		def sort(start int, end int, before def (int, int) bool) {
			let tmp = new Infos()
			tmp.size(1)
			for let i = start + 1; i < end; i++ {
				let j = i
				for j > start && before(i, j - 1) {
					j--
				}
				continue when i == j
				mergeClusters(j, i + 1)
				tmp.copy(0, info, i)
				for let k = i; k > j; k-- {
					info.copy(k, info, k - 1)
				}
				info.copy(j, tmp, 0)
			}
		}

		def clearPositions() {
			pos.size(len)
			pos.clear()
		}
	}
}
