// OpenType layout tables (GSUB, GPOS, kern) read in place from the table
// bytes. Nothing is parsed up front: a lookup walks offsets on demand, so a
// face with a large GPOS costs nothing until text is positioned with it.

internal partial module std.formats.fonts.layout {
	// Big-endian reads from a table's bytes. A read past the end gives 0, which
	// every layout structure treats as empty, so a truncated or hostile table
	// degrades to "no data" instead of failing mid-shape.
	type Data {
		internal b byte[]

		def new(b byte[] = byte[]) {
			self.b = b
		}

		def len() int {
			return b.len()
		}

		// Whether `n` bytes from `at` lie inside the table.
		def has(at int, n int) bool {
			return at >= 0 && n >= 0 && at + n <= b.len()
		}

		def u8(at int) int {
			return 0 when at < 0 || at >= b.len()
			return int(b[at])
		}

		def u16(at int) int {
			return 0 when at < 0 || at + 2 > b.len()
			return int(b[at]) << 8 | int(b[at + 1])
		}

		def i16(at int) int {
			let v = u16(at)
			return v - 65536 when v >= 32768
			return v
		}

		def u32(at int) int {
			return 0 when at < 0 || at + 4 > b.len()
			return int(b[at]) << 24 | int(b[at + 1]) << 16 | int(b[at + 2]) << 8 | int(b[at + 3])
		}

		// The four-character tag at `at`: "kern", "DFLT", "latn".
		// `n` bytes from `at`; empty when they run past the end.
		def slice(at int, n int) byte[] {
			return byte[] when at < 0 || n < 0 || at + n > b.len()
			return b[at:at + n]
		}

		def tag(at int) string {
			return "" when at < 0 || at + 4 > b.len()
			return string(b[at:at + 4])
		}

		// Index of `glyph` in the Coverage table at `at`, or -1 when not covered.
		def coverage(at int, glyph int) int {
			let format = u16(at)
			if format == 1 {
				// Sorted glyph array.
				let lo = 0
				let hi = u16(at + 2) - 1
				for lo <= hi {
					let mid = (lo + hi) / 2
					let g = u16(at + 4 + mid * 2)
					if g < glyph {
						lo = mid + 1
					} else if g > glyph {
						hi = mid - 1
					} else {
						return mid
					}
				}
				return -1
			}
			if format == 2 {
				// Sorted ranges: start, end, coverage index of start.
				let lo = 0
				let hi = u16(at + 2) - 1
				for lo <= hi {
					let mid = (lo + hi) / 2
					let r = at + 4 + mid * 6
					if u16(r + 2) < glyph {
						lo = mid + 1
					} else if u16(r) > glyph {
						hi = mid - 1
					} else {
						return u16(r + 4) + glyph - u16(r)
					}
				}
			}
			return -1
		}

		// Class of `glyph` in the ClassDef table at `at`; 0 for unlisted glyphs.
		def classOf(at int, glyph int) int {
			let format = u16(at)
			if format == 1 {
				let i = glyph - u16(at + 2)
				return 0 when i < 0 || i >= u16(at + 4)
				return u16(at + 6 + i * 2)
			}
			if format == 2 {
				let lo = 0
				let hi = u16(at + 2) - 1
				for lo <= hi {
					let mid = (lo + hi) / 2
					let r = at + 4 + mid * 6
					if u16(r + 2) < glyph {
						lo = mid + 1
					} else if u16(r) > glyph {
						hi = mid - 1
					} else {
						return u16(r + 4)
					}
				}
			}
			return 0
		}
	}
}
