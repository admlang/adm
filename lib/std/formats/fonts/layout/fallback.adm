internal partial module std.formats.fonts.layout {
	// Combining classes fallback positioning places marks by.
	const (
		cccAttachedBelowLeft  = 200
		cccAttachedBelow      = 202
		cccAttachedAbove      = 214
		cccAttachedAboveRight = 216
		cccBelowLeft          = 218
		cccBelow              = 220
		cccBelowRight         = 222
		cccLeft               = 224
		cccRight              = 226
		cccAboveLeft          = 228
		cccAbove              = 230
		cccAboveRight         = 232
		cccDoubleBelow        = 233
		cccDoubleAbove        = 234
	)

	// Classes of script-specific marks turned into positions (above, below)
	// fallback positioning understands.
	def recategorizeClass(u int, klass int) int {
		return klass when klass >= 200
		if u & ~0xFF == 0x0E00 {
			if klass == 0 {
				match u {
					case 0x0E31, 0x0E34, 0x0E35, 0x0E36, 0x0E37, 0x0E47, 0x0E4C, 0x0E4D, 0x0E4E:
						klass = cccAboveRight
					case 0x0EB1, 0x0EB4, 0x0EB5, 0x0EB6, 0x0EB7, 0x0EBB, 0x0ECC, 0x0ECD:
						klass = cccAbove
					case 0x0EBC:
						klass = cccBelow
				}
			} else if u == 0x0E3A {
				klass = cccBelowRight
			}
		}
		match klass {
			// Hebrew points below, meteg.
			case 22, 15, 16, 17, 23, 18, 19, 20, 21, 24, 25:
				return cccBelow
			case 13:
				return cccAttachedAbove
			case 10:
				return cccAboveRight
			case 11, 14:
				return cccAboveLeft
			case 26:
				return cccAbove
			// Arabic harakat.
			case 28, 29, 31, 32, 27, 34, 35, 36:
				return cccAbove
			case 30, 33:
				return cccBelow
			case 3:
				return cccBelowRight
			case 107:
				return cccAboveRight
			case 118:
				return cccBelow
			case 122:
				return cccAbove
			case 129:
				return cccBelow
			case 132:
				return cccAbove
			case 131:
				return cccBelow
		}
		return klass
	}

	def recategorizeMarks(b Buffer) {
		for let i = 0; i < b.len; i++ {
			b.info.setCombiningClass(i, recategorizeClass(b.info.glyph[i], b.info.combiningClass(i))) when b.info.category(i) == catMn
		}
	}

	// Extents of a glyph being built up as marks stack on it.
	type Box {
		x int
		y int
		w int
		h int

		def new(x int, y int, w int, h int) {
			self.x = x
			self.y = y
			self.w = w
			self.h = h
		}

		def copy() Box {
			return new Box(x, y, w, h)
		}
	}

	// Places marks around their base by combining class, for fonts without
	// GPOS mark attachment.
	def fallbackMarkPosition(p Plan, b Buffer, adjustOffsets bool) {
		let start = 0
		for let i = 1; i < b.len; i++ {
			if !b.info.isUnicodeMark(i) && !b.info.isHidden(i) && !b.info.isDefaultIgnorable(i) {
				positionCluster(p, b, start, i, adjustOffsets)
				start = i
			}
		}
		positionCluster(p, b, start, b.len, adjustOffsets)
	}

	internal def positionCluster(p Plan, b Buffer, start int, end int, adjustOffsets bool) {
		return when end - start < 2
		let i = start
		for i < end {
			if b.info.isUnicodeMark(i) {
				i++
				continue
			}
			let j = i + 1
			for j < end {
				if b.info.isHidden(j) || b.info.isDefaultIgnorable(j) {
					j++
					continue
				}
				break when !b.info.isUnicodeMark(j)
				j++
			}
			positionAroundBase(p, b, i, j, adjustOffsets)
			i = j
		}
	}

	internal def zeroMarkAdvances(b Buffer, start int, end int, adjustOffsets bool) {
		for let i = start; i < end; i++ {
			if b.info.category(i) == catMn {
				if adjustOffsets {
					b.pos.xOffset[i] -= b.pos.xAdvance[i]
					b.pos.yOffset[i] -= b.pos.yAdvance[i]
				}
				b.pos.xAdvance[i] = 0
				b.pos.yAdvance[i] = 0
			}
		}
	}

	internal def positionAroundBase(p Plan, b Buffer, base int, end int, adjustOffsets bool) {
		b.unsafeToBreak(base, end)
		let font = p.font
		let (ok, _, by, _, bh) = font.extents(b.info.glyph[base])
		if !ok {
			zeroMarkAdvances(b, base + 1, end, adjustOffsets)
			return
		}
		let baseBox = new Box(0, by + b.pos.yOffset[base], font.advance(b.info.glyph[base]), bh)
		let ligId = b.info.ligId(base)
		let numComps = b.info.ligNumComps(base)
		let xOffset = 0
		let yOffset = 0
		if isForward(b.direction) {
			xOffset -= b.pos.xAdvance[base]
			yOffset -= b.pos.yAdvance[base]
		}
		let compBox = baseBox.copy()
		let lastComponent = -1
		let lastClass = 255
		let cluster = baseBox.copy()
		let horizDir = 0
		for let i = base + 1; i < end; i++ {
			let cc = b.info.combiningClass(i)
			if cc != 0 {
				if numComps > 1 {
					let thisId = b.info.ligId(i)
					let thisComp = b.info.ligComp(i) - 1
					thisComp = numComps - 1 when ligId == 0 || ligId != thisId || thisComp >= numComps
					if lastComponent != thisComp {
						lastComponent = thisComp
						lastClass = 255
						compBox = baseBox.copy()
						horizDir = isHorizontal(p.direction) ?? (p.direction, scriptDirection(p.script)) when horizDir == 0
						if horizDir == dirLTR {
							compBox.x += thisComp * compBox.w / numComps
						} else {
							compBox.x += (numComps - 1 - thisComp) * compBox.w / numComps
						}
						compBox.w /= numComps
					}
				}
				if lastClass != cc {
					lastClass = cc
					cluster = compBox.copy()
				}
				positionMark(p, b, cluster, i, cc)
				b.pos.xAdvance[i] = 0
				b.pos.yAdvance[i] = 0
				b.pos.xOffset[i] += xOffset
				b.pos.yOffset[i] += yOffset
			} else if isForward(b.direction) {
				xOffset -= b.pos.xAdvance[i]
				yOffset -= b.pos.yAdvance[i]
			} else {
				xOffset += b.pos.xAdvance[i]
				yOffset += b.pos.yAdvance[i]
			}
		}
	}

	internal def positionMark(p Plan, b Buffer, base Box, i int, cc int) {
		let (ok, mx, my, mw, mh) = p.font.extents(b.info.glyph[i])
		return when !ok
		let gap = p.font.upem / 16
		b.pos.xOffset[i] = 0
		b.pos.yOffset[i] = 0

		// Horizontal placement.
		let centered = true
		if cc == cccDoubleBelow || cc == cccDoubleAbove {
			if b.direction == dirLTR {
				b.pos.xOffset[i] += base.x + base.w - mw / 2 - mx
				centered = false
			} else if b.direction == dirRTL {
				b.pos.xOffset[i] += base.x - mw / 2 - mx
				centered = false
			}
		} else if cc == cccAttachedBelowLeft || cc == cccBelowLeft || cc == cccAboveLeft {
			b.pos.xOffset[i] += base.x - mx
			centered = false
		} else if cc == cccAttachedAboveRight || cc == cccBelowRight || cc == cccAboveRight {
			b.pos.xOffset[i] += base.x + base.w - mw - mx
			centered = false
		}
		b.pos.xOffset[i] += base.x + (base.w - mw) / 2 - mx when centered

		// Vertical placement: stack below or above what is already there.
		if cc == cccDoubleBelow || cc == cccBelowLeft || cc == cccBelow || cc == cccBelowRight || cc == cccAttachedBelowLeft || cc == cccAttachedBelow {
			base.h -= gap when cc != cccAttachedBelowLeft && cc != cccAttachedBelow
			b.pos.yOffset[i] = base.y + base.h - my
			if (gap > 0) == (b.pos.yOffset[i] > 0) {
				base.h -= b.pos.yOffset[i]
				b.pos.yOffset[i] = 0
			}
			base.h += mh
		} else if cc == cccDoubleAbove || cc == cccAboveLeft || cc == cccAbove || cc == cccAboveRight || cc == cccAttachedAbove || cc == cccAttachedAboveRight {
			if cc != cccAttachedAbove && cc != cccAttachedAboveRight {
				base.y += gap
				base.h -= gap
			}
			b.pos.yOffset[i] = base.y - (my + mh)
			if (gap > 0) != (b.pos.yOffset[i] > 0) {
				let correction = -b.pos.yOffset[i] / 2
				base.y += correction
				base.h -= correction
				b.pos.yOffset[i] += correction
			}
			base.y -= mh
			base.h += mh
		}
	}

	// Widths for spaces the font lacks, derived from the em or other glyphs.
	def fallbackSpaces(p Plan, b Buffer) {
		let horizontal = isHorizontal(b.direction)
		let upem = p.font.upem
		for let i = 0; i < b.len; i++ {
			continue when b.info.category(i) != catZs || b.info.gprops[i] & propsLigated != 0
			let kind = b.info.uprops[i] >> 8
			if kind >= spaceEm && kind <= spaceEm16 {
				let v = (upem + kind / 2) / kind
				if horizontal {
					b.pos.xAdvance[i] = v
				} else {
					b.pos.yAdvance[i] = -v
				}
			} else if kind == space4Em18 {
				if horizontal {
					b.pos.xAdvance[i] = upem * 4 / 18
				} else {
					b.pos.yAdvance[i] = -upem * 4 / 18
				}
			} else if kind == spaceFigure {
				for let u = 0x30; u <= 0x39; u++ {
					let g = p.font.glyph(u)
					if g >= 0 {
						b.pos.xAdvance[i] = p.font.advance(g) when horizontal
						break
					}
				}
			} else if kind == spacePunctuation {
				let g = p.font.glyph(0x2E)
				g = p.font.glyph(0x2C) when g < 0
				b.pos.xAdvance[i] = p.font.advance(g) when g >= 0 && horizontal
			} else if kind == spaceNarrow {
				if horizontal {
					b.pos.xAdvance[i] /= 2
				} else {
					b.pos.yAdvance[i] /= 2
				}
			}
		}
	}
}
