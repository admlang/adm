internal partial module std.formats.fonts.layout {
	use std.formats.fonts

	// What shaping reads from a face: glyph mapping, advances, extents and
	// the layout tables, cached per face.
	type ShapeFont {
		face                     fonts.Face
		upem                     int
		gsub                     LayoutTable
		gpos                     LayoutTable
		gdef                     Gdef
		kern                     Data
		kerning                  Kerning
		internal cmap            Data
		internal vmtx            Data
		internal vorg            Data
		internal verticalMetrics int
		internal hasGlyf         bool
		// Horizontal ascender and descender (positive, negative).
		ascender                 int
		descender                int
		internal uvs             int
		internal advances        int[]
		internal nominal         map<int, int>

		def new(face fonts.Face) {
			self.face = face
			upem = int(face.info().unitsPerEm)
			upem = 1000 when upem == 0
			let blank = byte[]
			let gsubBytes = blank
			let gposBytes = blank
			let gdefBytes = blank
			let kernBytes = blank
			let cmapBytes = blank
			let hhea = new Data()
			let os2 = new Data()
			let vhea = new Data()
			if face is fonts.OpenTypeFace {
				gsubBytes = tableOr(face, "GSUB")
				gposBytes = tableOr(face, "GPOS")
				gdefBytes = tableOr(face, "GDEF")
				kernBytes = tableOr(face, "kern")
				cmapBytes = tableOr(face, "cmap")
				hhea = new Data(tableOr(face, "hhea"))
				os2 = new Data(tableOr(face, "OS/2"))
				vhea = new Data(tableOr(face, "vhea"))
				vmtx = new Data(tableOr(face, "vmtx"))
				vorg = new Data(tableOr(face, "VORG"))
				hasGlyf = !(face.table("glyf") is none)
			}
			readVerticalExtents(hhea, os2)
			verticalMetrics = vhea.len() >= 36 && vmtx.len() > 0 ?? (vhea.u16(34), 0)
			gsub = new LayoutTable(gsubBytes)
			gpos = new LayoutTable(gposBytes)
			gdef = new Gdef(gdefBytes)
			kern = new Data(kernBytes)
			kerning = new Kerning(kernBytes, byte[])
			cmap = new Data(cmapBytes)
			uvs = findVariationSubtable()
			advances.len(int(face.info().glyphCount))
			advances.fill(-1)
		}

		internal def tableOr(face fonts.OpenTypeFace, tag string) byte[] {
			let t = face.table(tag)
			return t is none ?? (byte[], t)
		}

		// The glyph of a code point, -1 when the face has none.
		def glyph(cp int) int {
			let known = nominal.get(cp)
			return known when known is int
			let g = face.glyph(char(cp))
			let r = g is none ?? (-1, int(g))
			nominal[cp] = r
			return r
		}

		def hasGlyph(cp int) bool {
			return glyph(cp) >= 0
		}

		// Offset of the cmap format 14 subtable, 0 when none.
		internal def findVariationSubtable() int {
			return 0 when cmap.len() < 4
			for let i = 0; i < cmap.u16(2); i++ {
				let rec = 4 + i * 8
				let off = cmap.u32(rec + 4)
				return off when cmap.u16(rec) == 0 && cmap.u16(rec + 2) == 5 && cmap.u16(off) == 14
			}
			return 0
		}

		// The glyph for a code point with a variation selector, -1 when the
		// face has no variant for the pair.
		def variationGlyph(cp int, selector int) int {
			return -1 when uvs == 0
			let count = cmap.u32(uvs + 6)
			let lo = 0
			let hi = count - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let rec = uvs + 10 + mid * 11
				let vs = cmap.u8(rec) << 16 | cmap.u16(rec + 1)
				if vs < selector {
					lo = mid + 1
				} else if vs > selector {
					hi = mid - 1
				} else {
					let defaults = cmap.u32(rec + 3)
					return glyph(cp) when defaults != 0 && inDefaultUVS(uvs + defaults, cp)
					let special = cmap.u32(rec + 7)
					return special == 0 ?? (-1, nonDefaultUVS(uvs + special, cp))
				}
			}
			return -1
		}

		internal def inDefaultUVS(at int, cp int) bool {
			let n = cmap.u32(at)
			for let i = 0; i < n; i++ {
				let r = at + 4 + i * 4
				let start = cmap.u8(r) << 16 | cmap.u16(r + 1)
				return false when cp < start
				return true when cp <= start + cmap.u8(r + 3)
			}
			return false
		}

		internal def nonDefaultUVS(at int, cp int) int {
			let n = cmap.u32(at)
			let lo = 0
			let hi = n - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let r = at + 4 + mid * 5
				let u = cmap.u8(r) << 16 | cmap.u16(r + 1)
				if u < cp {
					lo = mid + 1
				} else if u > cp {
					hi = mid - 1
				} else {
					return cmap.u16(r + 3)
				}
			}
			return -1
		}

		// Ascender and descender as shapers read them: OS/2 typographic values
		// when the font asks for them, else hhea, else 0.8 and -0.2 em.
		internal def readVerticalExtents(hhea Data, os2 Data) {
			let typo = os2.len() >= 78 && os2.u16(62) & 0x80 != 0
			if typo {
				ascender = os2.i16(68).abs()
				descender = -os2.i16(70).abs()
			} else if hhea.len() >= 10 && hhea.u16(0) != 0 {
				ascender = hhea.i16(4).abs()
				descender = -hhea.i16(6).abs()
			} else {
				ascender = upem * 8 / 10
				descender = ascender - upem
			}
		}

		// Vertical advance of a glyph: negative, downwards.
		def vAdvance(g int) int {
			return descender - ascender when verticalMetrics == 0
			let i = g.min(verticalMetrics - 1)
			return -vmtx.u16(i * 4)
		}

		// Top side bearing from vmtx.
		internal def topBearing(g int) int {
			return g < verticalMetrics ?? (vmtx.i16(g * 4 + 2), vmtx.i16(verticalMetrics * 4 + (g - verticalMetrics) * 2))
		}

		// Vertical origin of a glyph relative to its horizontal origin.
		def vOrigin(g int) (int, int) {
			let x = advance(g) / 2
			if vorg.len() >= 8 {
				// Sorted (glyph, y) pairs, else the default.
				let lo = 0
				let hi = vorg.u16(6) - 1
				for lo <= hi {
					let mid = (lo + hi) / 2
					let r = 8 + mid * 4
					let gg = vorg.u16(r)
					if gg < g {
						lo = mid + 1
					} else if gg > g {
						hi = mid - 1
					} else {
						return (x, vorg.i16(r + 2))
					}
				}
				return (x, vorg.i16(4))
			}
			let (ok, _, top, _, height) = extents(g)
			return (x, (ok ?? (top, 0)) + topBearing(g)) when verticalMetrics > 0 && hasGlyf
			return (x, ascender) when !ok
			let fontAdvance = ascender - descender
			return (x, top + ((fontAdvance + height) >> 1))
		}

		// Horizontal advance of a glyph, in font units.
		def advance(g int) int {
			return 0 when g < 0
			return advances[g] when g < advances.len() && advances[g] >= 0
			let m = face.metrics(fonts.GlyphID(g))
			let a = m is error ?? (0, int(m.advance))
			advances[g] = a when g < advances.len()
			return a
		}

		// Ink box of a glyph as x bearing, y bearing (top), width and height
		// (negative, downwards); ok false when the glyph has no outline.
		def extents(g int) (bool, int, int, int, int) {
			let o = face.outline(fonts.GlyphID(g))
			return (false, 0, 0, 0, 0) when o is error
			// Points are rounded to whole units first, as TrueType does for
			// scaled composite glyphs.
			let minX = 0
			let minY = 0
			let maxX = 0
			let maxY = 0
			let first = true
			for let (_, s) in o.segments {
				continue when s.kind == fonts.SegmentKind.Close
				let points = s.kind == fonts.SegmentKind.Cubic ?? (3, s.kind == fonts.SegmentKind.Quadratic ?? (2, 1))
				for let k = 0; k < points; k++ {
					let p = k == 0 ?? (s.to, k == 1 ?? (s.control1, s.control2))
					let x = roundAway(p.x)
					let y = roundAway(p.y)
					if first {
						minX = x
						maxX = x
						minY = y
						maxY = y
						first = false
					} else {
						minX = minX.min(x)
						maxX = maxX.max(x)
						minY = minY.min(y)
						maxY = maxY.max(y)
					}
				}
			}
			return (true, 0, 0, 0, 0) when first
			return (true, minX, maxY, maxX - minX, minY - maxY)
		}
	}

	// Rounds half away from zero, as C's roundf.
	def roundAway(v float) int {
		return v < 0.0 ?? (-int((-v + 0.5).floor()), int((v + 0.5).floor()))
	}
}
