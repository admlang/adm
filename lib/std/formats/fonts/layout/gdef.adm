internal partial module std.formats.fonts.layout {

	// Lookup flags (the low byte of a lookup's flag word); the mark
	// attachment type sits in bits 8..15 and a mark filtering set index,
	// when used, above bit 16 of the lookup props.
	const (
		flagRightToLeft         = 0x01
		flagIgnoreBase          = 0x02
		flagIgnoreLigatures     = 0x04
		flagIgnoreMarks         = 0x08
		flagIgnoreMask          = 0x0E
		flagUseMarkFilteringSet = 0x10
		flagMarkAttachmentType  = 0xFF00
	)

	// The GDEF table: glyph classes, mark attachment classes and mark
	// filtering sets.
	type Gdef {
		internal d            Data
		internal classDef     int
		internal attachDef    int
		internal markSets     int
		internal markSetCount int
		// The item variation store GPOS device tables index (GDEF 1.3).
		varStore              VariationStore

		def new(table byte[]) {
			d = new Data(table)
			varStore = new VariationStore()
			// Only major version 1 is defined; any other reads as no table.
			return when d.len() < 12 || d.u16(0) != 1
			let minor = d.u16(2)
			classDef = d.u16(4)
			attachDef = d.u16(10)
			if minor >= 2 && d.len() >= 14 && d.u16(12) != 0 {
				markSets = d.u16(12)
				markSetCount = d.u16(markSets + 2)
			}
			if minor >= 3 && d.len() >= 18 {
				varStore = new VariationStore(d, d.u32(14))
			}
		}

		// Whether the font classifies its glyphs at all.
		def hasGlyphClasses() bool {
			return classDef != 0
		}

		// Glyph props of a glyph: its class as a props bit, and for marks the
		// attachment class in bits 8..15. Unclassified and component glyphs
		// give 0.
		def glyphProps(glyph int) int {
			return 0 when classDef == 0
			let c = d.classOf(classDef, glyph)
			return propsBase when c == 1
			return propsLigature when c == 2
			if c == 3 {
				let attach = attachDef == 0 ?? (0, d.classOf(attachDef, glyph))
				return propsMark | attach << 8
			}
			return 0
		}

		// Whether mark filtering set `set` holds the glyph.
		def markSetCovers(set int, glyph int) bool {
			return false when set >= markSetCount
			let at = markSets + d.u32(markSets + 4 + set * 4)
			return d.coverage(at, glyph) >= 0
		}

		// The caret positions inside ligature glyph `glyph`, in font units
		// along the line from its origin, ascending; empty when the font lists
		// none. Format 2 carets sit on an outline point, format 3 ones move
		// with the instance.
		def ligatureCarets(glyph int, font ShapeFont) int[] {
			let out int[]
			let list = d.len() >= 12 ?? (d.u16(8), 0)
			return out when list == 0
			let index = d.coverage(list + d.u16(list), glyph)
			return out when index < 0 || index >= d.u16(list + 2)
			let lig = list + d.u16(list + 4 + index * 2)
			for let i = 0; i < d.u16(lig); i++ {
				let value = lig + d.u16(lig + 2 + i * 2)
				match d.u16(value) {
					case 1:
						out.push(d.i16(value + 2))
					case 2:
						let p = font.contourPoint(glyph, d.u16(value + 2))
						out.push(p is none ?? (0, p.x))
					case 3:
						out.push(d.i16(value + 2) + deviceDelta(d, device(d, value, value + 4), varStore, font.coords))
					default:
						return int[]
				}
			}
			out.sort((a int, b int) => a < b)
			return out
		}

		// Lookup props with an out-of-range mark filtering set dropped.
		def sanitizeLookupProps(props int) int {
			return props & ~flagUseMarkFilteringSet when props & flagUseMarkFilteringSet != 0 && props >> 16 >= markSetCount
			return props
		}
	}
}
