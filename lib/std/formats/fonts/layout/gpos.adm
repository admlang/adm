internal partial module std.formats.fonts.layout {
	// Applies GPOS subtable `sub` of lookup type `kind` at the current entry.
	def applyPos(c ApplyContext, kind int, sub int) bool {
		match kind {
			case 1:
				return singlePos(c, sub)
			case 2:
				return pairPos(c, sub)
			case 3:
				return cursivePos(c, sub)
			case 4:
				return markBasePos(c, sub)
			case 5:
				return markLigPos(c, sub)
			case 6:
				return markMarkPos(c, sub)
			case 7:
				return c.applyContext(sub)
			case 8:
				return c.applyChainContext(sub)
		}
		return false
	}

	// Bytes of a ValueRecord of `format`.
	def valueLen(format int) int {
		let n = 0
		for let bit = 0; bit < 8; bit++ {
			n += 2 when format & (1 << bit) != 0
		}
		return n
	}

	// Adds the ValueRecord at `at` to entry `i`'s position; returns whether
	// any value was non-zero. Device tables apply only to hinted or varied
	// fonts, so they are skipped.
	def applyValue(c ApplyContext, format int, at int, i int) bool {
		let d = c.d
		let p = c.buffer.pos
		let horizontal = isHorizontal(c.direction)
		let ret = false
		let v = at
		if format & 0x1 != 0 {
			let x = d.i16(v)
			p.xOffset[i] += x
			ret = ret || x != 0
			v += 2
		}
		if format & 0x2 != 0 {
			let y = d.i16(v)
			p.yOffset[i] += y
			ret = ret || y != 0
			v += 2
		}
		if format & 0x4 != 0 {
			let x = d.i16(v)
			p.xAdvance[i] += x when horizontal
			ret = ret || x != 0
			v += 2
		}
		if format & 0x8 != 0 {
			let y = d.i16(v)
			// y advances grow downward, font space upward.
			p.yAdvance[i] -= y when !horizontal
			ret = ret || y != 0
		}
		return ret
	}

	def singlePos(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		let index = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when index < 0
		let format = d.u16(sub + 4)
		if d.u16(sub) == 1 {
			applyValue(c, format, sub + 6, b.idx)
		} else if d.u16(sub) == 2 {
			return false when index >= d.u16(sub + 6)
			applyValue(c, format, sub + 8 + index * valueLen(format), b.idx)
		} else {
			return false
		}
		b.idx++
		return true
	}

	def pairPos(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		let index = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when index < 0
		let it = c.iterInput
		it.resetFast(b.idx)
		return false when !it.forward()
		let second = it.idx
		let format1 = d.u16(sub + 4)
		let format2 = d.u16(sub + 6)
		let len1 = valueLen(format1)
		let len2 = valueLen(format2)

		if d.u16(sub) == 1 {
			return false when index >= d.u16(sub + 8)
			let set = sub + d.u16(sub + 10 + index * 2)
			let size = 2 + len1 + len2
			return false when !d.has(set, 2 + d.u16(set) * size)
			let g2 = b.info.glyph[second]
			let lo = 0
			let hi = d.u16(set) - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let rec = set + 2 + mid * size
				let g = d.u16(rec)
				if g < g2 {
					lo = mid + 1
				} else if g > g2 {
					hi = mid - 1
				} else {
					applyValue(c, format1, rec + 2, b.idx) when len1 > 0
					applyValue(c, format2, rec + 2 + len1, second) when len2 > 0
					b.idx = len2 > 0 ?? (second + 1, second)
					return true
				}
			}
			return false
		}

		if d.u16(sub) == 2 {
			let class1 = d.classOf(sub + d.u16(sub + 8), b.info.glyph[b.idx])
			let class2 = d.classOf(sub + d.u16(sub + 10), b.info.glyph[second])
			let count1 = d.u16(sub + 12)
			let count2 = d.u16(sub + 14)
			return false when class1 >= count1 || class2 >= count2
			let rec = sub + 16 + (class1 * count2 + class2) * (len1 + len2)
			return false when !d.has(sub + 16, count1 * count2 * (len1 + len2))
			applyValue(c, format1, rec, b.idx) when len1 > 0
			applyValue(c, format2, rec + len1, second) when len2 > 0
			b.idx = len2 > 0 ?? (second + 1, second)
			return true
		}
		return false
	}

	// An anchor's point. Formats 2 and 3 add a contour point and device
	// tables, both only for hinted rendering, so every format reads the same.
	def anchor(d Data, at int) (int, int) {
		return (d.i16(at + 2), d.i16(at + 4))
	}

	def cursivePos(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		return false when d.u16(sub) != 1
		let cov = sub + d.u16(sub + 2)
		let count = d.u16(sub + 4)
		let thisIndex = d.coverage(cov, b.info.glyph[b.idx])
		return false when thisIndex < 0 || thisIndex >= count
		let entry = d.u16(sub + 6 + thisIndex * 4)
		return false when entry == 0

		let it = c.iterInput
		it.resetFast(b.idx)
		return false when !it.backward()
		let prevIndex = d.coverage(cov, b.info.glyph[it.idx])
		return false when prevIndex < 0 || prevIndex >= count
		let exit = d.u16(sub + 6 + prevIndex * 4 + 2)
		return false when exit == 0

		let i = it.idx
		let j = b.idx
		let (exitX, exitY) = anchor(d, sub + exit)
		let (entryX, entryY) = anchor(d, sub + entry)
		let p = b.pos
		if c.direction == dirLTR {
			p.xAdvance[i] = exitX + p.xOffset[i]
			let dd = entryX + p.xOffset[j]
			p.xAdvance[j] -= dd
			p.xOffset[j] -= dd
		} else if c.direction == dirRTL {
			let dd = exitX + p.xOffset[i]
			p.xAdvance[i] -= dd
			p.xOffset[i] -= dd
			p.xAdvance[j] = entryX + p.xOffset[j]
		} else if c.direction == dirTTB {
			p.yAdvance[i] = exitY + p.yOffset[i]
			let dd = entryY + p.yOffset[j]
			p.yAdvance[j] -= dd
			p.yOffset[j] -= dd
		} else if c.direction == dirBTT {
			let dd = exitY + p.yOffset[i]
			p.yAdvance[i] -= dd
			p.yOffset[i] -= dd
			p.yAdvance[j] = entryY
		}

		// The glyph whose cross-stream offset moves: the later one, unless the
		// lookup says right to left.
		let child = i
		let parent = j
		let xOff = entryX - exitX
		let yOff = entryY - exitY
		if c.lookupProps & flagRightToLeft == 0 {
			child = j
			parent = i
			xOff = -xOff
			yOff = -yOff
		}
		reverseCursiveMinorOffset(p, b.len, child, c.direction, parent)
		p.attachChain[child] = parent - child
		p.attachType[child] = attachCursive
		b.scratch |= scratchGposAttachment
		if isHorizontal(c.direction) {
			p.yOffset[child] = yOff
		} else {
			p.xOffset[child] = xOff
		}
		// A glyph attached to its own child breaks the loop.
		if p.attachChain[parent] == -p.attachChain[child] {
			p.attachChain[parent] = 0
			if isHorizontal(c.direction) {
				p.yOffset[parent] = 0
			} else {
				p.xOffset[parent] = 0
			}
		}
		b.idx++
		return true
	}

	def reverseCursiveMinorOffset(p Positions, len int, i int, direction int, newParent int) {
		let chain = p.attachChain[i]
		let kind = p.attachType[i]
		return when chain == 0 || kind & attachCursive == 0
		p.attachChain[i] = 0
		let j = i + chain
		return when j < 0 || j >= len || j == newParent
		reverseCursiveMinorOffset(p, len, j, direction, newParent)
		if isHorizontal(direction) {
			p.yOffset[j] = -p.yOffset[i]
		} else {
			p.xOffset[j] = -p.xOffset[i]
		}
		p.attachChain[j] = -chain
		p.attachType[j] = kind
	}

	// Attaches the current mark to entry `glyphPos` through the anchors of a
	// MarkArray and an anchor matrix row.
	def markArrayApply(c ApplyContext, markArray int, markIndex int, matrix int, row int, classCount int, glyphPos int) bool {
		let d = c.d
		let b = c.buffer
		let rec = markArray + 2 + markIndex * 4
		return false when markIndex >= d.u16(markArray) || !d.has(rec, 4)
		let markClass = d.u16(rec)
		let markAnchor = markArray + d.u16(rec + 2)
		return false when markClass >= classCount
		let rows = d.u16(matrix)
		return false when row >= rows
		let off = d.u16(matrix + 2 + (row * classCount + markClass) * 2)
		return false when off == 0 || !d.has(matrix + off, 6) || !d.has(markAnchor, 6)
		let (markX, markY) = anchor(d, markAnchor)
		let (baseX, baseY) = anchor(d, matrix + off)
		let p = b.pos
		p.attachChain[b.idx] = glyphPos - b.idx
		p.attachType[b.idx] = attachMark
		p.xOffset[b.idx] = baseX - markX
		p.yOffset[b.idx] = baseY - markY
		b.scratch |= scratchGposAttachment
		b.idx++
		return true
	}

	// Whether entry `i` can carry marks: not a component a multiple
	// substitution split off after the first.
	def acceptBase(b Buffer, i int) bool {
		let info = b.info
		return !(info.gprops[i] & propsMultiplied != 0) || info.ligComp(i) == 0 || i == 0 || info.isMark(i - 1) || info.gprops[i - 1] & propsMultiplied == 0 || info.ligId(i) != info.ligId(i - 1) || info.ligComp(i) != info.ligComp(i - 1) + 1
	}

	def markBasePos(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		return false when d.u16(sub) != 1
		let markIndex = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when markIndex < 0
		let baseCov = sub + d.u16(sub + 4)

		let it = c.iterInput
		it.lookupProps = flagIgnoreMarks
		if c.lastBaseUntil > b.idx {
			c.lastBaseUntil = 0
			c.lastBase = -1
		}
		for let j = b.idx; j > c.lastBaseUntil; j-- {
			let r = it.test(b.info, j - 1)
			r = resultSkip when r == resultMatch && !acceptBase(b, j - 1) && d.coverage(baseCov, b.info.glyph[j - 1]) < 0
			if r == resultMatch {
				c.lastBase = j - 1
				break
			}
		}
		c.lastBaseUntil = b.idx
		return false when c.lastBase < 0

		let base = c.lastBase
		let baseIndex = d.coverage(baseCov, b.info.glyph[base])
		return false when baseIndex < 0
		let classCount = d.u16(sub + 6)
		return markArrayApply(c, sub + d.u16(sub + 8), markIndex, sub + d.u16(sub + 10), baseIndex, classCount, base)
	}

	def markLigPos(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		return false when d.u16(sub) != 1
		let markIndex = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when markIndex < 0

		let it = c.iterInput
		it.lookupProps = flagIgnoreMarks
		if c.lastBaseUntil > b.idx {
			c.lastBaseUntil = 0
			c.lastBase = -1
		}
		for let j = b.idx; j > c.lastBaseUntil; j-- {
			if it.test(b.info, j - 1) == resultMatch {
				c.lastBase = j - 1
				break
			}
		}
		c.lastBaseUntil = b.idx
		return false when c.lastBase < 0

		let base = c.lastBase
		let ligIndex = d.coverage(sub + d.u16(sub + 4), b.info.glyph[base])
		return false when ligIndex < 0
		let ligArray = sub + d.u16(sub + 10)
		return false when ligIndex >= d.u16(ligArray)
		let attach = ligArray + d.u16(ligArray + 2 + ligIndex * 2)
		let compCount = d.u16(attach)
		return false when compCount == 0

		// The component the mark belongs to, else the last one.
		let ligId = b.info.ligId(base)
		let markId = b.info.ligId(b.idx)
		let markComp = b.info.ligComp(b.idx)
		let compIndex = ligId != 0 && ligId == markId && markComp > 0 ?? (compCount.min(markComp) - 1, compCount - 1)
		let classCount = d.u16(sub + 6)
		return markArrayApply(c, sub + d.u16(sub + 8), markIndex, attach, compIndex, classCount, base)
	}

	def markMarkPos(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		return false when d.u16(sub) != 1
		let mark1Index = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when mark1Index < 0

		let it = c.iterInput
		it.resetFast(b.idx)
		it.lookupProps = c.lookupProps & ~flagIgnoreMask
		return false when !it.backward()
		let j = it.idx
		return false when !b.info.isMark(j)

		let id1 = b.info.ligId(b.idx)
		let id2 = b.info.ligId(j)
		let comp1 = b.info.ligComp(b.idx)
		let comp2 = b.info.ligComp(j)
		let good = false
		if id1 == id2 {
			// Marks on one base, or on one ligature component.
			good = id1 == 0 || comp1 == comp2
		} else {
			// One of them sits on a whole ligature.
			good = (id1 > 0 && comp1 == 0) || (id2 > 0 && comp2 == 0)
		}
		return false when !good

		let mark2Index = d.coverage(sub + d.u16(sub + 4), b.info.glyph[j])
		return false when mark2Index < 0
		let classCount = d.u16(sub + 6)
		return markArrayApply(c, sub + d.u16(sub + 8), mark1Index, sub + d.u16(sub + 10), mark2Index, classCount, j)
	}

	// Turns attachment chains into final offsets: each attached glyph takes
	// its parent's offset and the advances between them.
	def propagateAttachments(b Buffer) {
		return when b.scratch & scratchGposAttachment == 0
		let p = b.pos
		if isForward(b.direction) {
			for let i = 0; i < b.len; i++ {
				propagateAttachment(p, b.len, i, b.direction, maxNesting) when p.attachChain[i] != 0
			}
		} else {
			for let i = b.len - 1; i >= 0; i-- {
				propagateAttachment(p, b.len, i, b.direction, maxNesting) when p.attachChain[i] != 0
			}
		}
	}

	def propagateAttachment(p Positions, len int, i int, direction int, nesting int) {
		let chain = p.attachChain[i]
		let kind = p.attachType[i]
		p.attachChain[i] = 0
		let j = i + chain
		return when j < 0 || j >= len || nesting == 0
		propagateAttachment(p, len, j, direction, nesting - 1) when p.attachChain[j] != 0

		if kind & attachCursive != 0 {
			if isHorizontal(direction) {
				p.yOffset[i] += p.yOffset[j]
			} else {
				p.xOffset[i] += p.xOffset[j]
			}
			return
		}
		p.xOffset[i] += p.xOffset[j]
		p.yOffset[i] += p.yOffset[j]
		if j < i {
			if isForward(direction) {
				for let k = j; k < i; k++ {
					p.xOffset[i] -= p.xAdvance[k]
					p.yOffset[i] -= p.yAdvance[k]
				}
			} else {
				for let k = j + 1; k < i + 1; k++ {
					p.xOffset[i] += p.xAdvance[k]
					p.yOffset[i] += p.yAdvance[k]
				}
			}
		} else {
			if isForward(direction) {
				for let k = i; k < j; k++ {
					p.xOffset[i] += p.xAdvance[k]
					p.yOffset[i] += p.yAdvance[k]
				}
			} else {
				for let k = i + 1; k < j + 1; k++ {
					p.xOffset[i] -= p.xAdvance[k]
					p.yOffset[i] -= p.yAdvance[k]
				}
			}
		}
	}
}
