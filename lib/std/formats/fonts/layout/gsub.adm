internal partial module std.formats.fonts.layout {
	// Applies GSUB subtable `sub` of lookup type `kind` at the current entry.
	def applySubst(c ApplyContext, kind int, sub int) bool {
		match kind {
			case 1:
				return singleSubst(c, sub)
			case 2:
				return multipleSubst(c, sub)
			case 3:
				return alternateSubst(c, sub)
			case 4:
				return ligatureSubst(c, sub)
			case 5:
				return c.applyContext(sub)
			case 6:
				return c.applyChainContext(sub)
			case 8:
				return reverseChainSubst(c, sub)
		}
		return false
	}

	def singleSubst(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		let g = b.info.glyph[b.idx]
		let index = d.coverage(sub + d.u16(sub + 2), g)
		return false when index < 0
		let format = d.u16(sub)
		if format == 1 {
			c.replaceGlyph((g + d.i16(sub + 4)) & 0xFFFF)
			return true
		}
		if format == 2 {
			return false when index >= d.u16(sub + 4) || !d.has(sub + 6 + index * 2, 2)
			c.replaceGlyph(d.u16(sub + 6 + index * 2))
			return true
		}
		return false
	}

	def multipleSubst(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		return false when d.u16(sub) != 1
		let index = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when index < 0 || index >= d.u16(sub + 4)
		let seq = sub + d.u16(sub + 6 + index * 2)
		let count = d.u16(seq)
		return false when !d.has(seq, 2 + count * 2)
		if count == 1 {
			c.replaceGlyph(d.u16(seq + 2))
			return true
		}
		if count == 0 {
			// Deleting the glyph is what fonts using this mean.
			b.deleteGlyph()
			return true
		}
		let klass = b.info.isLigature(b.idx) ?? (propsBase, 0)
		let ligId = b.info.ligId(b.idx)
		for let i = 0; i < count; i++ {
			// A component outside any ligature remembers its index, so marks can
			// find the right piece later.
			b.info.setLigForMark(b.idx, 0, i) when ligId == 0
			c.outputForComponent(d.u16(seq + 2 + i * 2), klass)
		}
		b.skipGlyph()
		return true
	}

	def alternateSubst(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		return false when d.u16(sub) != 1
		let index = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when index < 0 || index >= d.u16(sub + 4)
		let set = sub + d.u16(sub + 6 + index * 2)
		let count = d.u16(set)
		return false when count == 0 || !d.has(set, 2 + count * 2)

		// The feature value picks the alternate; `rand` at its maximum picks
		// one at random.
		let shift = 0
		for (c.lookupMask >> shift) & 1 == 0 && shift < 31 {
			shift++
		}
		let alt = (c.lookupMask & b.info.mask[b.idx]) >> shift
		alt = c.randomNumber() % count + 1 when alt == mapMaxValue && c.random
		return false when alt > count || alt == 0
		c.replaceGlyph(d.u16(set + 2 + (alt - 1) * 2))
		return true
	}

	def ligatureSubst(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		return false when d.u16(sub) != 1
		let index = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when index < 0 || index >= d.u16(sub + 4)
		let set = sub + d.u16(sub + 6 + index * 2)
		for let l = 0; l < d.u16(set); l++ {
			let lig = set + d.u16(set + 2 + l * 2)
			let glyph = d.u16(lig)
			let count = d.u16(lig + 2)
			// A truncated ligature is dropped, as a sanitizer would.
			continue when count == 0 || !d.has(lig, 4 + (count - 1) * 2)
			if count == 1 {
				c.replaceGlyph(glyph)
				return true
			}
			continue when count > maxContextLength
			let (ok, matchEnd, total) = c.matchInput(count, matchGlyph, 0, lig + 4)
			continue when !ok
			c.ligateInput(count, matchEnd, glyph, total)
			return true
		}
		return false
	}

	// Reverse chaining single substitution, applied last to first in place.
	def reverseChainSubst(c ApplyContext, sub int) bool {
		let d = c.d
		let b = c.buffer
		return false when d.u16(sub) != 1
		let index = d.coverage(sub + d.u16(sub + 2), b.info.glyph[b.idx])
		return false when index < 0
		// Not reachable from a contextual lookup.
		return false when c.nestingLeft != maxNesting

		let backCount = d.u16(sub + 4)
		let back = sub + 6
		let aheadAt = back + backCount * 2
		let aheadCount = d.u16(aheadAt)
		let ahead = aheadAt + 2
		let substAt = ahead + aheadCount * 2
		return false when index >= d.u16(substAt)

		if c.matchBacktrack(backCount, matchCoverage, sub, back) {
			let (ok, _) = c.matchLookahead(aheadCount, matchCoverage, sub, ahead, b.idx + 1)
			if ok {
				// The main loop moves the cursor back.
				c.replaceGlyphInPlace(d.u16(substAt + 2 + index * 2))
				return true
			}
		}
		return false
	}
}
