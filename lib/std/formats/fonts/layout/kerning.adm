internal partial module std.formats.fonts.layout {
	// Pair kerning of a face: the `kern` table, and GPOS pair adjustment
	// through the `kern` feature. What `Face.kern` answers from; the shaper
	// applies the full GPOS instead.
	type Kerning {
		internal kern       Data
		internal gpos       Data
		// Start of every PairPos subtable the `kern` feature reaches, in lookup
		// order, extension subtables already unwrapped.
		internal pairPos    int[]
		// Whether each of those opens a new lookup: within a lookup the first
		// subtable that covers the pair wins, across lookups they add up.
		internal lookupHead bool[]

		// `kern` and `gpos` are the raw tables, empty when the face has none.
		def new(kern byte[], gpos byte[]) {
			self.kern = new Data(kern)
			self.gpos = new Data(gpos)
			collectPairPos()
		}

		// Horizontal adjustment between two adjacent glyphs, in font units.
		// GPOS wins when the face has a `kern` feature there, as shapers do;
		// otherwise the `kern` table answers.
		def pair(left, right int) int {
			return gposPair(left, right) when pairPos.len() > 0
			return kernPair(left, right)
		}

		// PairPos subtables of the `kern` feature, under the default script
		// (`DFLT`, then `latn`, then the first listed) and its default language.
		internal def collectPairPos() {
			return when gpos.len() < 10
			let scripts = gpos.u16(4)
			let features = gpos.u16(6)
			let lookups = gpos.u16(8)
			return when scripts == 0 || features == 0 || lookups == 0

			let script = findScript(scripts, "DFLT")
			script = findScript(scripts, "dflt") when script < 0
			script = findScript(scripts, "latn") when script < 0
			script = scripts + gpos.u16(scripts + 6) when script < 0 && gpos.u16(scripts) > 0
			return when script < 0

			let langSys = gpos.u16(script)
			return when langSys == 0
			langSys += script

			// Feature indices of the language system, required feature first.
			let indices int[]
			let required = gpos.u16(langSys + 2)
			indices.push(required) when required != 0xFFFF
			for let i = 0; i < gpos.u16(langSys + 4); i++ {
				indices.push(gpos.u16(langSys + 6 + i * 2))
			}

			// Lookups of every `kern` feature among them, deduplicated, in
			// lookup-list order as the spec applies them.
			let count = gpos.u16(lookups)
			let wanted bool[]
			wanted.len(count)
			wanted.fill(false)
			for let (_, fi) in indices {
				continue when fi >= gpos.u16(features)
				let rec = features + 2 + fi * 6
				continue when gpos.tag(rec) != "kern"
				let feature = features + gpos.u16(rec + 4)
				for let j = 0; j < gpos.u16(feature + 2); j++ {
					let li = gpos.u16(feature + 4 + j * 2)
					wanted[li] = true when li < count
				}
			}

			for let li = 0; li < count; li++ {
				continue when !wanted[li]
				let lookup = lookups + gpos.u16(lookups + 2 + li * 2)
				let kind = gpos.u16(lookup)
				let head = true
				for let s = 0; s < gpos.u16(lookup + 4); s++ {
					let sub = lookup + gpos.u16(lookup + 6 + s * 2)
					let subKind = kind
					// Extension: a 32-bit offset to the real subtable.
					if kind == 9 {
						subKind = gpos.u16(sub + 2)
						sub += gpos.u32(sub + 4)
					}
					continue when subKind != 2
					pairPos.push(sub)
					lookupHead.push(head)
					head = false
				}
			}
		}

		// The script table tagged `tag`, or -1.
		internal def findScript(scripts int, tag string) int {
			for let i = 0; i < gpos.u16(scripts); i++ {
				let rec = scripts + 2 + i * 6
				return scripts + gpos.u16(rec + 4) when gpos.tag(rec) == tag
			}
			return -1
		}

		internal def gposPair(left, right int) int {
			let total = 0
			// Set once a subtable of the current lookup has matched.
			let done = false
			for let (i, sub) in pairPos {
				done = false when lookupHead[i]
				continue when done
				let (hit, value) = pairValue(sub, left, right)
				if hit {
					total += value
					done = true
				}
			}
			return total
		}

		// The first glyph's x advance adjustment from one PairPos subtable, and
		// whether the subtable holds the pair at all.
		internal def pairValue(sub, left, right int) (bool, int) {
			let covered = gpos.coverage(sub + gpos.u16(sub + 2), left)
			return (false, 0) when covered < 0

			let format1 = gpos.u16(sub + 4)
			let format2 = gpos.u16(sub + 6)
			let size1 = valueSize(format1)
			let size2 = valueSize(format2)

			if gpos.u16(sub) == 1 {
				// A PairSet per covered first glyph: second glyphs, sorted.
				return (false, 0) when covered >= gpos.u16(sub + 8)
				let set = sub + gpos.u16(sub + 10 + covered * 2)
				let stride = 2 + size1 + size2
				let lo = 0
				let hi = gpos.u16(set) - 1
				for lo <= hi {
					let mid = (lo + hi) / 2
					let rec = set + 2 + mid * stride
					let g = gpos.u16(rec)
					if g < right {
						lo = mid + 1
					} else if g > right {
						hi = mid - 1
					} else {
						return (true, xAdvance(rec + 2, format1))
					}
				}
				return (false, 0)
			}

			if gpos.u16(sub) == 2 {
				// A class-by-class matrix. Every covered first glyph matches, even
				// when the value is zero.
				let class1 = gpos.classOf(sub + gpos.u16(sub + 8), left)
				let class2 = gpos.classOf(sub + gpos.u16(sub + 10), right)
				return (false, 0) when class1 >= gpos.u16(sub + 12) || class2 >= gpos.u16(sub + 14)
				let rec = sub + 16 + (class1 * gpos.u16(sub + 14) + class2) * (size1 + size2)
				return (true, xAdvance(rec, format1))
			}
			return (false, 0)
		}

		// XAdvance of the ValueRecord at `at`, 0 when its format leaves it out.
		internal def xAdvance(at, format int) int {
			return 0 when format & 0x4 == 0
			return gpos.i16(at + valueSize(format & 0x3))
		}

		// Bytes of a ValueRecord: two per field its format lists.
		internal def valueSize(format int) int {
			let n = 0
			for let bit = 0; bit < 8; bit++ {
				n += 2 when format & (1 << bit) != 0
			}
			return n
		}

		// The `kern` table: the OpenType layout (version 0) and Apple's
		// (version 1.0). Horizontal pair subtables add up, an override subtable
		// replaces the running total; minimum, cross-stream, vertical and
		// variation subtables are not pair kerning. Format 1 is contextual and
		// belongs to the shaper.
		internal def kernPair(left, right int) int {
			return 0 when kern.len() < 4
			let total = 0

			if kern.u16(0) == 0 {
				let at = 4
				for let t = 0; t < kern.u16(2); t++ {
					let length = kern.u16(at + 2)
					let coverage = kern.u16(at + 4)
					// Bit 0 horizontal, bit 1 minimum, bit 2 cross-stream.
					if coverage & 0x1 != 0 && coverage & 0x6 == 0 {
						let (hit, v) = subtablePair(at, 6, coverage >> 8, left, right)
						// Bit 3: the pair's value replaces the running total.
						total = v when hit && coverage & 0x8 != 0
						total += v when hit && coverage & 0x8 == 0
					}
					break when length < 6
					at += length
				}
				return total
			}

			if kern.u32(0) == 0x00010000 {
				let at = 8
				for let t = 0; t < kern.u32(4); t++ {
					let length = kern.u32(at)
					let coverage = kern.u16(at + 4)
					// 0x8000 vertical, 0x4000 cross-stream, 0x2000 variation.
					if coverage & 0xE000 == 0 {
						let (_, v) = subtablePair(at, 8, coverage & 0xFF, left, right)
						total += v
					}
					break when length < 8
					at += length
				}
			}
			return total
		}

		// One pair subtable starting at `at`, its body after `header` bytes:
		// whether it lists the pair, and the value.
		def subtablePair(at, header, format, left, right int) (bool, int) {
			let body = at + header
			if format == 0 {
				// Pairs sorted by (left, right).
				let key = left << 16 | right
				let lo = 0
				let hi = kern.u16(body) - 1
				for lo <= hi {
					let mid = (lo + hi) / 2
					let rec = body + 8 + mid * 6
					let k = kern.u16(rec) << 16 | kern.u16(rec + 2)
					if k < key {
						lo = mid + 1
					} else if k > key {
						hi = mid - 1
					} else {
						return (true, kern.i16(rec + 4))
					}
				}
				return (false, 0)
			}

			if format == 2 {
				// Class values are byte offsets from the subtable start: the left
				// one to its row, the right one within the row. A glyph outside a
				// class table has no kerning.
				let array = kern.u16(body + 6)
				let l = classOffset(at + kern.u16(body + 2), left)
				let r = classOffset(at + kern.u16(body + 4), right)
				return (false, 0) when l < array || r < 0
				return (true, kern.i16(at + l + r))
			}

			if format == 3 {
				let glyphs = kern.u16(body)
				return (false, 0) when left >= glyphs || right >= glyphs
				let values = kern.u8(body + 2)
				let leftClasses = kern.u8(body + 3)
				let rightClasses = kern.u8(body + 4)
				let valueAt = body + 6
				let leftAt = valueAt + values * 2
				let rightAt = leftAt + glyphs
				let indexAt = rightAt + glyphs
				let lc = kern.u8(leftAt + left)
				let rc = kern.u8(rightAt + right)
				return (false, 0) when lc >= leftClasses || rc >= rightClasses
				let index = kern.u8(indexAt + lc * rightClasses + rc)
				return (false, 0) when index >= values
				return (true, kern.i16(valueAt + index * 2))
			}
			return (false, 0)
		}

		// Format 2 class table: first glyph, count, then one offset per glyph.
		// -1 for a glyph outside it.
		internal def classOffset(at, glyph int) int {
			let i = glyph - kern.u16(at)
			return -1 when i < 0 || i >= kern.u16(at + 2)
			return kern.u16(at + 4 + i * 2)
		}
	}
}
