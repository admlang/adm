// Kerning by the AAT `kerx` table and the `kern` table, OpenType (version
// 0) and Apple (version 1.0) alike: pair lists, class matrices, state
// machines and anchor attachment. A port of HarfBuzz 14.1's
// hb-aat-layout-kerx-table.hh, hb-ot-kern-table.hh and hb-kern.hh.

internal partial module std.formats.fonts.layout {

	// Which table a KerxTable reads.
	const (
		kerxExtended = 0
		kernOpenType = 1
		kernApple    = 2
	)

	// Subtable coverage bits, as the `kerx` header spells them; the `kern`
	// headers are translated.
	const (
		kerxVertical    = 0x80000000
		kerxCrossStream = 0x40000000
		kerxVariation   = 0x20000000
		kerxBackwards   = 0x10000000
	)

	// A `kerx` or `kern` table.
	type KerxTable {
		internal d    Data
		internal kind int
		internal ankr Data

		// `table` is the `kerx` bytes when `extended`, else the `kern` bytes;
		// `ankr` holds anchor points for `kerx` attachment.
		def new(table byte[], extended bool, ankr byte[] = byte[]) {
			d = new Data(table)
			self.ankr = new Data(ankr)
			if extended {
				kind = kerxExtended
			} else {
				kind = d.u16(0) == 1 ?? (kernApple, kernOpenType)
			}
		}

		def hasData() bool {
			return d.u16(0) != 0 when kind == kerxExtended
			return d.u32(0) != 0 && d.u16(0) <= 1
		}

		internal def count() int {
			return kind == kernOpenType ?? (d.u16(2), d.u32(4))
		}

		internal def first() int {
			return kind == kernOpenType ?? (4, 8)
		}

		internal def length(sub int) int {
			return kind == kernOpenType ?? (d.u16(sub + 2), d.u32(sub))
		}

		// Bytes of a subtable header.
		internal def headerSize() int {
			return kind == kerxExtended ?? (12, kind == kernApple ?? (8, 6))
		}

		internal def format(sub int) int {
			return d.u32(sub + 4) & 0xFF when kind == kerxExtended
			return d.u8(sub + 5) when kind == kernApple
			return d.u8(sub + 4)
		}

		// Coverage in `kerx` bits.
		def coverage(sub int) int {
			return d.u32(sub + 4) & 0xF0000000 when kind == kerxExtended
			let c = kind == kernApple ?? (d.u8(sub + 4), d.u8(sub + 5))
			return (c & 0x80 != 0 ?? (kerxVertical, 0)) | (c & 0x40 != 0 ?? (kerxCrossStream, 0)) | (c & 0x20 != 0 ?? (kerxVariation, 0)) when kind == kernApple
			// OpenType: bit 0 horizontal, bit 2 cross-stream.
			return (c & 0x01 == 0 ?? (kerxVertical, 0)) | (c & 0x04 != 0 ?? (kerxCrossStream, 0))
		}

		def tupleCount(sub int) int {
			return kind == kerxExtended ?? (d.u32(sub + 8), 0)
		}

		// Whether a subtable kerns by a state machine (format 1).
		def hasStateMachine() bool {
			let sub = first()
			for let i = 0; i < count(); i++ {
				return true when format(sub) == 1
				sub += length(sub)
			}
			return false
		}

		def hasCrossStream() bool {
			let sub = first()
			for let i = 0; i < count(); i++ {
				return true when coverage(sub) & kerxCrossStream != 0
				sub += length(sub)
			}
			return false
		}

		// Kerns the buffer.
		def apply(plan Plan, b Buffer) {
			b.unsafeToConcat()
			let c = new AatContext(plan, b)
			c.trackGlyphs()
			let seenCrossStream = false
			let sub = first()
			let n = count()
			for let i = 0; i < n; i++ {
				let cov = coverage(sub)
				let skip = kind != kerxExtended && cov & kerxVariation != 0
				skip = true when isHorizontal(b.direction) == (cov & kerxVertical != 0)
				if !skip {
					c.firstSet = new GlyphSet()
					c.secondSet = new GlyphSet()
					collect(c, sub)
					if c.intersectsMachine() {
						let reverse = (cov & kerxBackwards != 0) != isBackward(b.direction)
						if !seenCrossStream && cov & kerxCrossStream != 0 {
							// Chain every glyph to the one before it.
							seenCrossStream = true
							for let k = 0; k < b.len; k++ {
								b.pos.attachType[k] = attachCursive
								b.pos.attachChain[k] = isForward(b.direction) ?? (-1, 1)
							}
						}
						c.reverseBuffer() when reverse != c.reversed
						dispatch(c, sub, i == n - 1 ?? (d.len(), sub + length(sub)))
					}
				}
				sub += length(sub)
			}
			c.reverseBuffer() when c.reversed
		}

		// Fills the context's glyph sets for a subtable: first glyphs it can
		// act on, and second glyphs of pairs.
		internal def collect(c AatContext, sub int) {
			let body = sub + headerSize()
			let extended = kind == kerxExtended
			match format(sub) {
				case 0:
					let (n, pairs) = pairList(sub)
					for let k = 0; k < n; k++ {
						c.firstSet.add(d.u16(pairs + k * 6))
						c.secondSet.add(d.u16(pairs + k * 6 + 2))
					}
				case 1:
					let m = new StateTable(d, body, extended, extended ?? (2, 0))
					m.collectInitial(c.firstSet, c.numGlyphs, new KerxMachine(c, self, sub, m, 0)) when aatValidMachine(m)
				case 2:
					let (left, right, _) = classTables(sub)
					collectClasses(c, left, c.firstSet)
					collectClasses(c, right, c.secondSet)
				case 3:
					if kind != kerxExtended && d.u16(body) != 0 {
						c.firstSet.addRange(0, c.numGlyphs - 1)
						c.secondSet.addRange(0, c.numGlyphs - 1)
					}
				case 4:
					if extended {
						let m = new StateTable(d, body, true, 2)
						m.collectInitial(c.firstSet, c.numGlyphs, new KerxAnchors(c, self, m)) when aatValidMachine(m)
					}
				case 6:
					if extended {
						let long = d.u32(body) & 1 != 0
						new AatLookup(d, sub + d.u32(body + 8), long ?? (4, 2)).collect(c.firstSet, c.numGlyphs)
						new AatLookup(d, sub + d.u32(body + 12), long ?? (4, 2)).collect(c.secondSet, c.numGlyphs)
					}
			}
		}

		internal def collectClasses(c AatContext, at int, set GlyphSet) {
			if kind == kerxExtended {
				new AatLookup(d, at).collect(set, c.numGlyphs)
				return
			}
			let firstGlyph = d.u16(at)
			for let i = 0; i < d.u16(at + 2); i++ {
				set.add(firstGlyph + i) when d.u16(at + 4 + i * 2) != aatClassOutOfBounds
			}
		}

		// Runs one subtable; reads stay below `limit`.
		internal def dispatch(c AatContext, sub int, limit int) {
			let body = sub + headerSize()
			let cov = coverage(sub)
			let extended = kind == kerxExtended
			let requested = c.plan.kernMask != 0
			let f = format(sub)
			if f == 0 || f == 2 || (f == 3 && !extended) || (f == 6 && extended) {
				return when !requested || cov & kerxBackwards != 0
				kernPairs(c, cov & kerxCrossStream != 0, (l int, r int) => pairKern(c, sub, limit, l, r))
			} else if f == 1 {
				return when !requested && cov & kerxCrossStream == 0
				let m = new StateTable(d, body, extended, extended ?? (2, 0))
				driveStateMachine(c, m, new KerxMachine(c, self, sub, m, limit)) when aatValidMachine(m)
			} else if f == 4 && extended {
				let m = new StateTable(d, body, true, 2)
				driveStateMachine(c, m, new KerxAnchors(c, self, m)) when aatValidMachine(m)
			}
		}

		// Kerning between two glyphs from a pair subtable, 0 unless both are
		// in its glyph sets.
		internal def pairKern(c AatContext, sub int, limit int, left int, right int) int {
			return 0 when !c.firstSet.has(left) || !c.secondSet.has(right)
			return pairValue(sub, limit, left, right, c.numGlyphs)
		}

		// Horizontal kerning between two glyphs, summed over the pair
		// subtables (formats 0, 2, 3 and 6) that are neither cross-stream nor
		// variation ones: what `Face.kern` answers for AAT faces.
		def pair(left int, right int, numGlyphs int) int {
			let total = 0
			let sub = first()
			let n = count()
			for let i = 0; i < n; i++ {
				let f = format(sub)
				let pairs = f == 0 || f == 2 || (f == 3 && kind != kerxExtended) || (f == 6 && kind == kerxExtended)
				total += pairValue(sub, i == n - 1 ?? (d.len(), sub + length(sub)), left, right, numGlyphs) when pairs && coverage(sub) & (kerxVertical | kerxCrossStream | kerxVariation) == 0 && covers(sub, left, right, numGlyphs)
				sub += length(sub)
			}
			return total
		}

		// Whether both glyphs are in a class subtable's tables.
		internal def covers(sub int, left int, right int, numGlyphs int) bool {
			let body = sub + headerSize()
			if format(sub) == 2 {
				let (leftTable, rightTable, _) = classTables(sub)
				return hasClass(leftTable, left, numGlyphs) && hasClass(rightTable, right, numGlyphs)
			}
			if format(sub) == 6 {
				let long = d.u32(body) & 1 != 0
				let rows = new AatLookup(d, sub + d.u32(body + 8), long ?? (4, 2))
				let columns = new AatLookup(d, sub + d.u32(body + 12), long ?? (4, 2))
				return inLookup(rows, left, numGlyphs) && inLookup(columns, right, numGlyphs)
			}
			return true
		}

		internal def hasClass(at int, g int, numGlyphs int) bool {
			return new AatLookup(d, at).value(g, numGlyphs) >= 0 when kind == kerxExtended
			let i = g - d.u16(at)
			return i >= 0 && i < d.u16(at + 2) && d.u16(at + 4 + i * 2) != aatClassOutOfBounds
		}

		internal def inLookup(lookup AatLookup, g int, numGlyphs int) bool {
			let t = lookup.d
			if t.u16(lookup.at) == 10 {
				let first = t.u16(lookup.at + 4)
				return g >= first && g - first < t.u16(lookup.at + 6)
			}
			return lookup.value(g, numGlyphs) >= 0
		}

		// The value a pair subtable holds for two glyphs, 0 when none.
		internal def pairValue(sub int, limit int, left int, right int, numGlyphs int) int {
			let body = sub + headerSize()
			match format(sub) {
				case 0:
					let (n, pairs) = pairList(sub)
					let key = left << 16 | right
					let lo = 0
					let hi = n - 1
					for lo <= hi {
						let mid = (lo + hi) / 2
						let rec = pairs + mid * 6
						let k = d.u16(rec) << 16 | d.u16(rec + 2)
						if key < k {
							hi = mid - 1
						} else if key > k {
							lo = mid + 1
						} else {
							return tupleKern(d.i16(rec + 4), sub, sub, limit)
						}
					}
					return 0
				case 2:
					let (leftTable, rightTable, array) = classTables(sub)
					let l = classOf(leftTable, left, numGlyphs)
					let r = classOf(rightTable, right, numGlyphs)
					let index = l + r
					if kind != kerxExtended {
						// Class values are byte offsets from the subtable.
						let rel = array - sub
						return 0 when index < rel
						index = (index - rel) / 2
					}
					let at = array + index * 2
					return 0 when at + 2 > limit
					return tupleKern(d.i16(at), sub, sub, limit)
				case 3:
					let glyphs = d.u16(body)
					let values = d.u8(body + 2)
					let leftClasses = d.u8(body + 3)
					let rightClasses = d.u8(body + 4)
					let valueAt = body + 6
					let leftAt = valueAt + values * 2
					let rightAt = leftAt + glyphs
					let indexAt = rightAt + glyphs
					// Out of the arrays reads as 0.
					let lc = left < glyphs ?? (d.u8(leftAt + left), 0)
					let rc = right < glyphs ?? (d.u8(rightAt + right), 0)
					return 0 when lc >= leftClasses || rc >= rightClasses
					let i = lc * rightClasses + rc
					let index = i < leftClasses * rightClasses ?? (d.u8(indexAt + i), 0)
					return index < values ?? (d.i16(valueAt + index * 2), 0)
				case 6:
					let flags = d.u32(body)
					let long = flags & 1 != 0
					let rows = new AatLookup(d, sub + d.u32(body + 8), long ?? (4, 2))
					let columns = new AatLookup(d, sub + d.u32(body + 12), long ?? (4, 2))
					let array = sub + d.u32(body + 16)
					let vector = sub + d.u32(body + 20)
					let offset = rows.valueOrZero(left, numGlyphs) + columns.valueOrZero(right, numGlyphs)
					if long {
						let at = array + offset * 4
						return 0 when offset > 0xFFFFFFFF || at + 4 > limit
						let v = d.u32(at)
						v -= 0x100000000 when v >= 0x80000000
						return tupleKern(v, sub, vector, limit)
					}
					let at = array + offset * 2
					return 0 when at + 2 > limit
					return tupleKern(d.i16(at), sub, vector, limit)
			}
			return 0
		}

		// A value of a subtable with variation tuples is an offset from
		// `base` to the tuple values; the first one applies.
		internal def tupleKern(value int, sub int, base int, limit int) int {
			let tuples = tupleCount(sub)
			return value when tuples == 0
			let at = base + (value & 0xFFFFFFFF)
			return 0 when at + tuples * 2 > limit
			return d.i16(at)
		}

		// Pair count and first pair of a format 0 subtable.
		internal def pairList(sub int) (int, int) {
			let body = sub + headerSize()
			return kind == kerxExtended ?? ((d.u32(body), body + 16), (d.u16(body), body + 8))
		}

		// Left and right class tables and the value array of format 2.
		internal def classTables(sub int) (int, int, int) {
			let body = sub + headerSize()
			return (sub + d.u32(body + 4), sub + d.u32(body + 8), sub + d.u32(body + 12)) when kind == kerxExtended
			return (sub + d.u16(body + 2), sub + d.u16(body + 4), sub + d.u16(body + 6))
		}

		internal def classOf(at int, g int, numGlyphs int) int {
			if kind == kerxExtended {
				let v = new AatLookup(d, at).value(g, numGlyphs)
				return v < 0 ?? (0, v)
			}
			let i = g - d.u16(at)
			return 0 when i < 0 || i >= d.u16(at + 2)
			return d.u16(at + 4 + i * 2)
		}
	}

	// Adds the kerning `pair` gives between each glyph and the next one
	// that is not a mark, splitting it between the two advances.
	def kernPairs(c AatContext, crossStream bool, pair def (int, int) int) {
		let b = c.b
		b.unsafeToConcat()
		let mask = c.plan.kernMask
		let ac = new ApplyContext(1, new LayoutTable(byte[]), b, c.plan.font.gdef)
		ac.useLookupMask(mask)
		ac.useLookupProps(flagIgnoreMarks)
		let it = ac.iterInput
		let horizontal = isHorizontal(b.direction)
		let idx = 0
		for idx < b.len {
			if b.info.mask[idx] & mask == 0 {
				idx++
				continue
			}
			it.resetFast(idx)
			if !it.forward() {
				idx++
				continue
			}
			let i = idx
			let j = it.idx
			let kern = pair(b.info.glyph[i], b.info.glyph[j])
			if kern != 0 {
				if crossStream {
					if horizontal {
						b.pos.yOffset[j] = kern
					} else {
						b.pos.xOffset[j] = kern
					}
					b.scratch |= scratchGposAttachment
				} else {
					let k1 = kern >> 1
					let k2 = kern - k1
					if horizontal {
						b.pos.xAdvance[i] += k1
						b.pos.xAdvance[j] += k2
						b.pos.xOffset[j] += k2
					} else {
						b.pos.yAdvance[i] += k1
						b.pos.yAdvance[j] += k2
						b.pos.yOffset[j] += k2
					}
				}
				b.unsafeToBreak(i, j + 1)
			}
			idx = j
		}
	}

	// Format 1: a state machine pushes glyphs and pops kerning values onto
	// them.
	type KerxMachine {
		internal c           AatContext
		internal t           KerxTable
		internal m           StateTable
		internal limit       int
		internal actions     int
		internal crossStream bool
		internal tuples      int
		internal stack       int[]
		internal depth       int

		def new(c AatContext, t KerxTable, sub int, m StateTable, limit int) {
			self.c = c
			self.t = t
			self.m = m
			self.limit = limit
			// Counted from the state table, not the subtable.
			let off = m.base + m.headerSize()
			actions = m.base + (m.extended ?? (m.d.u32(off), m.d.u16(off)))
			crossStream = t.coverage(sub) & kerxCrossStream != 0
			tuples = t.tupleCount(sub).max(1)
			stack.len(8)
			stack.fill(0)
		}

		def inPlace() bool {
			return true
		}

		def isInitiable(e int) bool {
			return m.flags(e) & 0x8000 != 0
		}

		def isActionable(e int) bool {
			return m.extended ?? (m.data(e, 0) != 0xFFFF, m.flags(e) & 0x3FFF != 0)
		}

		def transition(b Buffer, e int) {
			let d = m.d
			let flags = m.flags(e)
			// Reset exists in `kerx` only.
			depth = 0 when m.extended && flags & 0x2000 != 0
			if flags & 0x8000 != 0 {
				if depth < 8 {
					stack[depth] = b.idx
					depth++
				} else {
					depth = 0
				}
			}
			return when !isActionable(e) || depth == 0
			let index = 0
			if m.extended {
				index = m.data(e, 0) / 2
			} else {
				let rel = actions - m.base
				let off = flags & 0x3FFF
				index = off < rel ?? (-1, (off - rel) / 2)
			}
			let at = actions + index * 2
			if index < 0 || at + depth * tuples * 2 > limit {
				depth = 0
				return
			}
			let mask = c.plan.kernMask
			let horizontal = isHorizontal(b.direction)
			let last = false
			for !last && depth > 0 {
				depth--
				let idx = stack[depth]
				let v = d.i16(at)
				at += tuples * 2
				continue when idx >= b.len
				// An odd value ends the list.
				last = v & 1 != 0
				v &= ~1
				if crossStream {
					if v == -0x8000 {
						b.pos.attachType[idx] = 0
						b.pos.attachChain[idx] = 0
						if horizontal {
							b.pos.yOffset[idx] = 0
						} else {
							b.pos.xOffset[idx] = 0
						}
					} else if b.pos.attachType[idx] != 0 {
						if horizontal {
							b.pos.yOffset[idx] += v
						} else {
							b.pos.xOffset[idx] += v
						}
						b.scratch |= scratchGposAttachment
					}
				} else if b.info.mask[idx] & mask != 0 {
					if horizontal {
						b.pos.xAdvance[idx] += v
						b.pos.xOffset[idx] += v
					} else {
						b.pos.yAdvance[idx] += v
						b.pos.yOffset[idx] += v
					}
				}
			}
		}
	}

	// Format 4: attaches the current glyph to the marked one, through
	// anchor points of the `ankr` table or coordinates in the subtable.
	type KerxAnchors {
		internal c       AatContext
		internal t       KerxTable
		internal m       StateTable
		internal action  int
		internal data    int
		internal markSet bool
		internal mark    int

		def new(c AatContext, t KerxTable, m StateTable) {
			self.c = c
			self.t = t
			self.m = m
			let flags = m.d.u32(m.base + 16)
			action = flags >> 30
			data = m.base + (flags & 0xFFFFFF)
		}

		def inPlace() bool {
			return true
		}

		def isInitiable(e int) bool {
			return m.flags(e) & 0x8000 != 0
		}

		def isActionable(e int) bool {
			return m.data(e, 0) != 0xFFFF
		}

		def transition(b Buffer, e int) {
			let d = m.d
			let index = m.data(e, 0)
			if markSet && index != 0xFFFF && b.idx < b.len {
				let i = b.idx
				// Action 3 is undefined: the glyph attaches where it is.
				if action == 0 {
					// Outline control points of the two glyphs; a glyph without
					// that point stays where it is.
					let at = data + index * 4
					return when !d.has(at, 4)
					let mp = c.font.contourPoint(b.info.glyph[mark], d.u16(at))
					let cp = c.font.contourPoint(b.info.glyph[i], d.u16(at + 2))
					return when mp is none || cp is none
					b.pos.xOffset[i] = mp.x - cp.x
					b.pos.yOffset[i] = mp.y - cp.y
				} else if action == 3 {} else if action == 1 {
					let at = data + index * 4
					return when !d.has(at, 4)
					let (mx, my) = anchor(b.info.glyph[mark], d.u16(at))
					let (cx, cy) = anchor(b.info.glyph[i], d.u16(at + 2))
					b.pos.xOffset[i] = mx - cx
					b.pos.yOffset[i] = my - cy
				} else {
					let at = data + index * 8
					return when !d.has(at, 8)
					b.pos.xOffset[i] = d.i16(at) - d.i16(at + 4)
					b.pos.yOffset[i] = d.i16(at + 2) - d.i16(at + 6)
				}
				b.pos.attachType[i] = attachMark
				let chain = mark - i
				b.pos.attachChain[i] = c.reversed ?? (-chain, chain)
				b.scratch |= scratchGposAttachment
			}
			if m.flags(e) & 0x8000 != 0 {
				markSet = true
				mark = b.idx
			}
		}

		// Anchor point `k` of a glyph in the `ankr` table, (0, 0) when none.
		internal def anchor(g int, k int) (int, int) {
			let a = t.ankr
			return (0, 0) when a.len() < 12
			let offset = new AatLookup(a, a.u32(4)).value(g, c.numGlyphs)
			return (0, 0) when offset < 0
			let list = a.u32(8) + offset
			return (0, 0) when k >= a.u32(list)
			let at = list + 4 + k * 4
			return (a.i16(at), a.i16(at + 2))
		}
	}
}
