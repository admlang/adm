internal partial module std.formats.fonts.layout {
	// Feature flags of the map builder.
	const (
		featGlobal              = 0x01
		featHasFallback         = 0x02
		featManualZWNJ          = 0x04
		featManualZWJ           = 0x08
		featGlobalSearch        = 0x10
		featRandom              = 0x20
		featPerSyllable         = 0x40
		featManualJoiners       = 0x0C
		featGlobalManualJoiners = 0x0D
		featGlobalHasFallback   = 0x03
	)

	const (
		mapMaxBits  = 8
		mapMaxValue = 255
		globalShift = 31
		globalBit   = 0x80000000
	)

	// Runs between two stages of lookups: a shaper reorders or classifies
	// the buffer there. Returns whether it changed glyphs.
	type Pause = def (Buffer) bool

	// The lookups one table applies, in order, with how each applies.
	type MapLookups {
		index       int[]
		mask        int[]
		autoZWNJ    bool[]
		autoZWJ     bool[]
		random      bool[]
		perSyllable bool[]
		// End of each stage in the lookup arrays, and what runs after it.
		stageEnd    int[]
		stagePause  Pause[]

		def new() {}

		def push(i int, m int, zwnj bool, zwj bool, r bool, syl bool) {
			index.push(i)
			mask.push(m)
			autoZWNJ.push(zwnj)
			autoZWJ.push(zwj)
			random.push(r)
			perSyllable.push(syl)
		}
	}

	// A compiled feature map: which mask bits select which features, and the
	// staged lookup lists of GSUB and GPOS.
	type Map {
		globalMask    int
		tags          string[]
		index         int[][]
		stage         int[][]
		shift         int[]
		mask          int[]
		needsFallback bool[]
		lookups       MapLookups[]
		chosenScript  string[]
		foundScript   bool[]

		def new() {
			index = [int[], int[]]
			stage = [int[], int[]]
			lookups = [new MapLookups(), new MapLookups()]
			chosenScript = ["", ""]
			foundScript = [false, false]
		}

		internal def find(tag string) int {
			for let (i, t) in tags {
				return i when t == tag
			}
			return -1
		}

		// The mask bits of feature `tag`; 0 when the map lacks it.
		def maskOf(tag string) int {
			let i = find(tag)
			return i < 0 ?? (0, mask[i])
		}

		def shiftOf(tag string) int {
			let i = find(tag)
			return i < 0 ?? (0, shift[i])
		}

		// The mask bit that turns feature `tag` on with value 1.
		def oneMask(tag string) int {
			let i = find(tag)
			return i < 0 ?? (0, 1 << shift[i] & mask[i])
		}

		def featureIndex(table int, tag string) int {
			let i = find(tag)
			return i < 0 ?? (-1, index[table][i])
		}

		def featureNeedsFallback(tag string) bool {
			let i = find(tag)
			return i >= 0 && needsFallback[i]
		}
	}

	// Collects features and pauses, then compiles them against a face's
	// GSUB and GPOS into a Map.
	type MapBuilder {
		tables        LayoutTable[]
		scriptIndex   int[]
		languageIndex int[]
		foundScript   bool[]
		chosenScript  string[]
		currentStage  int[]
		// Pauses per table: the stage they end, and the function.
		pauseStage    int[][]
		pauseFunc     Pause[][]
		// Feature requests, in the order added.
		ftag          string[]
		fseq          int[]
		fmax          int[]
		fflags        int[]
		fdefault      int[]
		fstage0       int[]
		fstage1       int[]
		isSimple      bool

		def new(gsub LayoutTable, gpos LayoutTable, scriptTags string[], languageTags string[]) {
			tables = [gsub, gpos]
			scriptIndex = [-1, -1]
			languageIndex = [-1, -1]
			foundScript = [false, false]
			chosenScript = ["", ""]
			currentStage = [0, 0]
			pauseStage = [int[], int[]]
			pauseFunc = [Pause[], Pause[]]
			for let t = 0; t < 2; t++ {
				selectScript(t, scriptTags)
				selectLanguage(t, languageTags)
			}
		}

		// The first of `tags` the table has, else DFLT, dflt or latn (which
		// count as not found).
		internal def selectScript(t int, tags string[]) {
			let table = tables[t]
			for let (_, tag) in tags {
				let i = table.findScript(tag)
				if i >= 0 {
					scriptIndex[t] = i
					chosenScript[t] = tag
					foundScript[t] = true
					return
				}
			}
			for let (_, tag) in ["DFLT", "dflt", "latn"] {
				let i = table.findScript(tag)
				if i >= 0 {
					scriptIndex[t] = i
					chosenScript[t] = tag
					return
				}
			}
		}

		internal def selectLanguage(t int, tags string[]) {
			let table = tables[t]
			for let (_, tag) in tags {
				let i = table.findLanguage(scriptIndex[t], tag)
				if i >= 0 {
					languageIndex[t] = i
					return
				}
			}
			languageIndex[t] = table.findLanguage(scriptIndex[t], "dflt")
		}

		def addFeature(tag string, flags int = 0, value int = 1) {
			ftag.push(tag)
			fseq.push(ftag.len())
			fmax.push(value)
			fflags.push(flags)
			fdefault.push(flags & featGlobal != 0 ?? (value, 0))
			fstage0.push(currentStage[0])
			fstage1.push(currentStage[1])
		}

		def enableFeature(tag string, flags int = 0, value int = 1) {
			addFeature(tag, flags | featGlobal, value)
		}

		def disableFeature(tag string) {
			addFeature(tag, featGlobal, 0)
		}

		// Whether GSUB or GPOS lists `tag` for the chosen language system.
		def hasFeature(tag string) bool {
			for let t = 0; t < 2; t++ {
				let ls = tables[t].langSys(scriptIndex[t], languageIndex[t])
				for let (_, fi) in tables[t].featureIndices(ls) {
					return true when tables[t].featureTag(fi) == tag
				}
			}
			return false
		}

		def addGsubPause(pause Pause = noPause) {
			addPause(0, pause)
		}

		def addGposPause(pause Pause = noPause) {
			addPause(1, pause)
		}

		internal def addPause(t int, pause Pause) {
			pauseStage[t].push(currentStage[t])
			pauseFunc[t].push(pause)
			currentStage[t]++
		}

		def compile() Map {
			let m = new Map()
			m.globalMask = globalBit
			let required = [-1, -1]
			let requiredTag = ["", ""]
			let requiredStage = [0, 0]
			let langSys = [0, 0]
			for let t = 0; t < 2; t++ {
				m.chosenScript[t] = chosenScript[t]
				m.foundScript[t] = foundScript[t]
				langSys[t] = tables[t].langSys(scriptIndex[t], languageIndex[t])
				required[t] = tables[t].requiredFeature(langSys[t])
				requiredTag[t] = required[t] < 0 ?? ("", tables[t].featureTag(required[t]))
			}

			// Sort requests by tag (then order added) and merge duplicates.
			let order int[]
			for let i = 0; i < ftag.len(); i++ {
				order.push(i)
				let j = order.len() - 1
				for j > 0 && !isSimple && ftag[order[j - 1]] > ftag[i] {
					order[j] = order[j - 1]
					j--
				}
				order[j] = i
			}
			let ut string[]
			let umax int[]
			let uflags int[]
			let udefault int[]
			let ustage0 int[]
			let ustage1 int[]
			for let (_, i) in order {
				let last = ut.len() - 1
				if last < 0 || ut[last] != ftag[i] {
					ut.push(ftag[i])
					umax.push(fmax[i])
					uflags.push(fflags[i])
					udefault.push(fdefault[i])
					ustage0.push(fstage0[i])
					ustage1.push(fstage1[i])
					continue
				}
				if fflags[i] & featGlobal != 0 {
					uflags[last] |= featGlobal
					umax[last] = fmax[i]
					udefault[last] = fdefault[i]
				} else {
					uflags[last] ^= featGlobal when uflags[last] & featGlobal != 0
					umax[last] = umax[last].max(fmax[i])
				}
				uflags[last] |= fflags[i] & featHasFallback
				ustage0[last] = ustage0[last].min(fstage0[i])
				ustage1[last] = ustage1[last].min(fstage1[i])
			}

			// Feature tag -> index for the language system; earlier entries win.
			let featureMaps = [map<string, int>{}, map<string, int>{}]
			for let t = 0; t < 2; t++ {
				let indices = tables[t].featureIndices(langSys[t])
				for let k = indices.len() - 1; k >= 0; k-- {
					featureMaps[t][tables[t].featureTag(indices[k])] = indices[k]
				}
			}

			let nextBit = 4
			let fautoZWNJ bool[]
			let fautoZWJ bool[]
			let frandom bool[]
			let fsyllable bool[]
			for let (i, tag) in ut {
				let bits = uflags[i] & featGlobal != 0 && umax[i] == 1 ?? (0, bitStorage(umax[i]).min(mapMaxBits))
				continue when umax[i] == 0 || nextBit + bits >= globalShift

				let found = false
				let fi = [-1, -1]
				for let t = 0; t < 2; t++ {
					requiredStage[t] = t == 0 ?? (ustage0[i], ustage1[i]) when requiredTag[t] == tag
					let idx = featureMaps[t].get(tag)
					if idx is int {
						fi[t] = idx
						found = true
					}
				}
				if !found && uflags[i] & featGlobalSearch != 0 {
					for let t = 0; t < 2; t++ {
						fi[t] = tables[t].findFeature(tag)
						found = true when fi[t] >= 0
					}
				}
				continue when !found && uflags[i] & featHasFallback == 0

				m.tags.push(tag)
				m.index[0].push(fi[0])
				m.index[1].push(fi[1])
				m.stage[0].push(ustage0[i])
				m.stage[1].push(ustage1[i])
				fautoZWNJ.push(uflags[i] & featManualZWNJ == 0)
				fautoZWJ.push(uflags[i] & featManualZWJ == 0)
				frandom.push(uflags[i] & featRandom != 0)
				fsyllable.push(uflags[i] & featPerSyllable != 0)
				if uflags[i] & featGlobal != 0 && umax[i] == 1 {
					m.shift.push(globalShift)
					m.mask.push(globalBit)
				} else {
					m.shift.push(nextBit)
					let mask = (1 << (nextBit + bits)) - (1 << nextBit)
					m.mask.push(mask)
					nextBit += bits
					m.globalMask |= udefault[i] << m.shift[m.shift.len() - 1] & mask
				}
				m.needsFallback.push(!found)
			}

			addGsubPause()
			addGposPause()

			for let t = 0; t < 2; t++ {
				let ls = m.lookups[t]
				let stageIndex = 0
				let lastCount = 0
				let lookupCount = tables[t].lookupCount()
				for let stage = 0; stage < currentStage[t]; stage++ {
					addLookups(t, ls, required[t], globalBit, zwnj = true, zwj = true, r = false, syl = false, count = lookupCount) when required[t] >= 0 && requiredStage[t] == stage
					for let (i, _) in m.tags {
						addLookups(t, ls, m.index[t][i], m.mask[i], fautoZWNJ[i], fautoZWJ[i], frandom[i], fsyllable[i], lookupCount) when m.stage[t][i] == stage && m.index[t][i] >= 0
					}
					sortStage(ls, lastCount)
					lastCount = ls.index.len()
					if stageIndex < pauseStage[t].len() && pauseStage[t][stageIndex] == stage {
						ls.stageEnd.push(lastCount)
						ls.stagePause.push(pauseFunc[t][stageIndex])
						stageIndex++
					}
				}
			}
			return m
		}

		internal def addLookups(t int, ls MapLookups, feature int, mask int, zwnj bool, zwj bool, r bool, syl bool, count int) {
			for let (_, li) in tables[t].featureLookups(feature) {
				ls.push(li, mask, zwnj, zwj, r, syl) when li < count
			}
		}

		// Sorts the lookups added since `from` by index, merging duplicates.
		internal def sortStage(ls MapLookups, from int) {
			let n = ls.index.len()
			return when from + 1 >= n
			for let i = from + 1; i < n; i++ {
				let j = i
				for j > from && ls.index[j - 1] > ls.index[j] {
					swapLookup(ls, j - 1, j)
					j--
				}
			}
			let w = from
			for let i = from + 1; i < n; i++ {
				if ls.index[i] != ls.index[w] {
					w++
					swapLookup(ls, w, i) when w != i
				} else {
					ls.mask[w] |= ls.mask[i]
					ls.autoZWNJ[w] = ls.autoZWNJ[w] && ls.autoZWNJ[i]
					ls.autoZWJ[w] = ls.autoZWJ[w] && ls.autoZWJ[i]
				}
			}
			let keep = w + 1
			ls.index.len(keep)
			ls.mask.len(keep)
			ls.autoZWNJ.len(keep)
			ls.autoZWJ.len(keep)
			ls.random.len(keep)
			ls.perSyllable.len(keep)
		}

		internal def swapLookup(ls MapLookups, a int, b int) {
			let t = ls.index[a]
			ls.index[a] = ls.index[b]
			ls.index[b] = t
			t = ls.mask[a]
			ls.mask[a] = ls.mask[b]
			ls.mask[b] = t
			let f = ls.autoZWNJ[a]
			ls.autoZWNJ[a] = ls.autoZWNJ[b]
			ls.autoZWNJ[b] = f
			f = ls.autoZWJ[a]
			ls.autoZWJ[a] = ls.autoZWJ[b]
			ls.autoZWJ[b] = f
			f = ls.random[a]
			ls.random[a] = ls.random[b]
			ls.random[b] = f
			f = ls.perSyllable[a]
			ls.perSyllable[a] = ls.perSyllable[b]
			ls.perSyllable[b] = f
		}
	}

	// The pause of a stage with nothing to do between lookups.
	def noPause(b Buffer) bool {
		return false
	}

	// Bits needed to store `v`.
	def bitStorage(v int) int {
		let n = 0
		for v > 0 {
			n++
			v >>= 1
		}
		return n
	}
}
