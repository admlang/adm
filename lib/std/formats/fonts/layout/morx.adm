// Glyph metamorphosis: the AAT `morx` table and its predecessor `mort`,
// which replace GSUB in fonts made for Apple platforms. A port of HarfBuzz
// 14.1's hb-aat-layout-morx-table.hh and hb-aat-map.cc.

internal partial module std.formats.fonts.layout {
	// AAT feature types HarfBuzz treats specially.
	const (
		aatTypeLetterCase             = 3
		aatTypeCharacterAlternatives  = 17
		aatTypeLowerCase              = 37
		aatTypeLanguageTag            = 39
		aatSelectorSmallCaps          = 3
		aatSelectorLowerCaseSmallCaps = 1
	)

	// Most glyphs a subtable keeps track of at once.
	const aatMaxContext = 64

	// A requested AAT feature setting over clusters [start, end); end -1
	// runs to the end of the text.
	struct AatFeature {
		kind      int
		setting   int
		exclusive bool
		// Order of the request, for stable sorting.
		seq       int
		start     int
		end       int
	}

	// One chain's subtable flags per range of clusters, in cluster order:
	// flags[k] apply to clusters first[k]..last[k].
	struct AatRanges {
		flags int[]
		first int[]
		last  int[]
	}

	// The end of the text, as cluster ranges count it.
	const aatGlobalEnd = 0x7FFFFFFF

	// The `morx` (or `mort`) table of a face and the settings a shaping
	// call asked for.
	type Morx {
		internal d        Data
		// Whether this is the older `mort`.
		internal obsolete bool
		internal feat     Data
		internal ltag     Data

		def new(morx byte[], mort byte[], feat byte[], ltag byte[]) {
			d = new Data(morx)
			if d.len() < 8 || d.u16(0) == 0 {
				d = new Data(mort)
				obsolete = true
			}
			d = new Data() when d.len() < 8 || d.u16(0) == 0
			self.feat = new Data(feat)
			self.ltag = new Data(ltag)
		}

		def hasData() bool {
			return d.len() >= 8
		}

		// The settings of user features: those with an AAT equivalent the
		// `feat` table lists, in request order. Without `feat`, none.
		def settings(features UserFeature[]) AatFeature[] {
			let out AatFeature[]
			return out when feat.len() < 12 || feat.u32(0) == 0
			for let (_, f) in features {
				let tag = f.tag
				let on = f.value != 0
				let end = f.end < 0 ?? (aatGlobalEnd, f.end)
				if tag == "aalt" {
					continue when !exposes(aatTypeCharacterAlternatives)
					out.push(AatFeature{kind: aatTypeCharacterAlternatives, setting: f.value, exclusive: true, seq: out.len() + 1, start: f.start, end: end})
					continue
				}
				let i = aatFeatureTags.indexOf(tag)
				continue when i < 0
				let kind = aatFeatureTypes[i]
				let name = featureName(kind)
				if name < 0 {
					// Small caps may still come through the deprecated setting.
					continue when !(kind == aatTypeLowerCase && aatEnableSelectors[i] == aatSelectorLowerCaseSmallCaps)
					name = featureName(aatTypeLetterCase)
					continue when name < 0
				}
				let setting = on ?? (aatEnableSelectors[i], aatDisableSelectors[i])
				out.push(AatFeature{kind: kind, setting: setting, exclusive: feat.u16(name + 8) & 0x8000 != 0, seq: out.len() + 1, start: f.start, end: end})
			}
			return out
		}

		// The `feat` record of a feature type with settings, -1 when none.
		internal def featureName(kind int) int {
			let lo = 0
			let hi = feat.u16(4) - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let rec = 12 + mid * 12
				let k = feat.u16(rec)
				if kind < k {
					hi = mid - 1
				} else if kind > k {
					lo = mid + 1
				} else {
					return feat.u16(rec + 2) > 0 ?? (rec, -1)
				}
			}
			return -1
		}

		// OpenType tags whose AAT setting the `feat` table lists: `aalt` for
		// character alternatives, else a tag when its feature type has its
		// enabling selector.
		def featureTags() string[] {
			let out string[]
			return out when feat.len() < 12 || feat.u32(0) == 0
			out.push("aalt") when exposes(aatTypeCharacterAlternatives)
			for let (i, tag) in aatFeatureTags {
				let name = featureName(aatFeatureTypes[i])
				continue when name < 0
				let settings = feat.u32(name + 4)
				for let k = 0; k < feat.u16(name + 2); k++ {
					if feat.u16(settings + k * 4) == aatEnableSelectors[i] {
						out.push(tag)
						break
					}
				}
			}
			return out
		}

		internal def exposes(kind int) bool {
			return featureName(kind) >= 0
		}

		// Sorts the requested settings and drops duplicates, as the map
		// builder does for one range of text.
		def activeFeatures(requested AatFeature[]) AatFeature[] {
			let sorted AatFeature[]
			for let (_, f) in requested {
				let at = sorted.len()
				for at > 0 && featureOrder(f, sorted[at - 1]) < 0 {
					at--
				}
				sorted = sorted[:at] + [f] + sorted[at:]
			}
			let out AatFeature[]
			for let (_, f) in sorted {
				if out.len() > 0 {
					let last = out[out.len() - 1]
					continue unless f.kind != last.kind || (!f.exclusive && f.setting & ~1 != last.setting & ~1)
				}
				out.push(f)
			}
			return out
		}

		internal def featureOrder(a AatFeature, b AatFeature) int {
			return a.kind < b.kind ?? (-1, 1) when a.kind != b.kind
			return a.setting < b.setting ?? (-1, 1) when !a.exclusive && a.setting & ~1 != b.setting & ~1
			return a.seq < b.seq ?? (-1, a.seq > b.seq ?? (1, 0))
		}

		// Binary search by (type, setting) over the active features.
		internal def isActive(active AatFeature[], kind int, setting int) bool {
			let lo = 0
			let hi = active.len() - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let f = active[mid]
				let c = kind != f.kind ?? (kind < f.kind ?? (-1, 1), setting != f.setting ?? (setting < f.setting ?? (-1, 1), 0))
				if c < 0 {
					hi = mid - 1
				} else if c > 0 {
					lo = mid + 1
				} else {
					return true
				}
			}
			return false
		}

		// The subtable flags each chain runs with, per range of clusters the
		// requested settings divide the text into (the AAT map's events).
		def chainRanges(requested AatFeature[], language string) AatRanges[] {
			let chains int[]
			let at = 8
			for let i = 0; i < d.u32(4); i++ {
				chains.push(at)
				at += d.u32(at + 4)
			}
			let out AatRanges[]
			for let (_, _) in chains {
				out.push(AatRanges{flags: int[], first: int[], last: int[]})
			}
			if requested.len() == 0 {
				for let (k, chain) in chains {
					out[k].flags.push(compileFlags(chain, requested, language))
					out[k].first.push(0)
					out[k].last.push(aatGlobalEnd)
				}
				return out
			}
			// Start and end events, sorted by index, ends first, then as the
			// features sort.
			let events AatFeature[]
			let starts bool[]
			let indices int[]
			for let (_, f) in requested {
				continue when f.start == f.end
				for let (_, isStart) in [true, false] {
					let index = isStart ?? (f.start, f.end)
					let k = events.len()
					for k > 0 && eventOrder(index, isStart, f, indices[k - 1], starts[k - 1], events[k - 1]) < 0 {
						k--
					}
					events = events[:k] + [f] + events[k:]
					starts = starts[:k] + [isStart] + starts[k:]
					indices = indices[:k] + [index] + indices[k:]
				}
			}
			// The final event closes the last range.
			events.push(AatFeature{seq: requested.len() + 1})
			starts.push(false)
			indices.push(aatGlobalEnd)
			let active AatFeature[]
			let lastIndex = 0
			for let (e, f) in events {
				if indices[e] != lastIndex {
					let current = activeFeatures(active)
					for let (k, chain) in chains {
						out[k].flags.push(compileFlags(chain, current, language))
						out[k].first.push(lastIndex)
						out[k].last.push(indices[e] - 1)
					}
					lastIndex = indices[e]
				}
				if starts[e] {
					active.push(f)
				} else {
					for let (i, a) in active {
						if a.seq == f.seq {
							active = active[:i] + active[i + 1:]
							break
						}
					}
				}
			}
			for let (k, _) in chains {
				out[k].last[out[k].last.len() - 1] = aatGlobalEnd when out[k].last.len() > 0
			}
			return out
		}

		internal def eventOrder(ia int, sa bool, fa AatFeature, ib int, sb bool, fb AatFeature) int {
			return ia < ib ?? (-1, 1) when ia != ib
			return !sa ?? (-1, 1) when sa != sb
			return featureOrder(fa, fb)
		}

		internal def compileFlags(chain int, active AatFeature[], language string) int {
			let flags = d.u32(chain)
			let count = obsolete ?? (d.u16(chain + 8), d.u32(chain + 8))
			let features = chain + (obsolete ?? (12, 16))
			for let i = 0; i < count; i++ {
				let rec = features + i * 12
				let kind = d.u16(rec)
				let setting = d.u16(rec + 2)
				let enable = d.u32(rec + 4)
				let disable = d.u32(rec + 8)
				let hit = isActive(active, kind, setting)
				// Small caps may come through its deprecated setting.
				hit = isActive(active, aatTypeLowerCase, aatSelectorLowerCaseSmallCaps) when !hit && kind == aatTypeLetterCase && setting == aatSelectorSmallCaps
				hit = languageMatches(setting - 1, language) when !hit && kind == aatTypeLanguageTag && setting != 0
				if hit {
					flags &= disable
					flags |= enable
				}
			}
			return flags
		}

		// Whether `ltag` entry `i` is the shaping language or a prefix of it.
		internal def languageMatches(i int, language string) bool {
			return false when ltag.len() < 12 || i >= ltag.u32(8)
			let rec = 12 + i * 4
			let at = ltag.u16(rec)
			let n = ltag.u16(rec + 2)
			return false when !ltag.has(at, n)
			let tag = canonicalLanguage(string(ltag.b[at:at + n]))
			let want = canonicalLanguage(language)
			return false when tag == "" || want == "" || tag.len() > want.len()
			return want == tag || want.startsWith(tag + "-")
		}

		internal def canonicalLanguage(s string) string {
			return s.lower().replace("_", "-")
		}

		// Runs every chain over the buffer.
		def apply(plan Plan, b Buffer, ranges AatRanges[]) {
			return when !b.successful
			b.unsafeToConcat()
			let c = new AatContext(plan, b)
			// Only `morx` keeps a running set of the buffer's glyphs.
			c.trackGlyphs() when !obsolete
			let at = 8
			for let i = 0; i < d.u32(4) && i < ranges.len(); i++ {
				c.ranges = ranges[i]
				applyChain(c, at)
				return when !b.successful
				at += d.u32(at + 4)
			}
		}

		internal def applyChain(c AatContext, chain int) {
			let b = c.b
			let featureCount = obsolete ?? (d.u16(chain + 8), d.u32(chain + 8))
			let count = obsolete ?? (d.u16(chain + 10), d.u32(chain + 12))
			let sub = chain + (obsolete ?? (12, 16)) + featureCount * 12
			for let i = 0; i < count; i++ {
				let length = obsolete ?? (d.u16(sub), d.u32(sub))
				let coverage = obsolete ?? (d.u16(sub + 2) >> 8, d.u32(sub + 4) >> 24)
				let kind = obsolete ?? (d.u16(sub + 2) & 0xFF, d.u32(sub + 4) & 0xFF)
				let subFlags = d.u32(sub + (obsolete ?? (4, 8)))
				let body = sub + (obsolete ?? (8, 12))
				let run = false
				for let (_, f) in c.ranges.flags {
					run = true when subFlags & f != 0
				}
				c.subtableFlags = subFlags
				// 0x20 all directions, else 0x80 vertical only.
				run = false when coverage & 0x20 == 0 && isVertical(b.direction) != (coverage & 0x80 != 0)
				if run {
					let driven = subtable(c, kind, body)
					c.firstSet = new GlyphSet()
					driven.collect(c.firstSet)
					if c.intersectsMachine() {
						// 0x10 logical order, 0x40 backwards.
						let backwards = coverage & 0x40 != 0
						let reverse = coverage & 0x10 != 0 ?? (backwards, backwards != isBackward(b.direction))
						c.reverseBuffer() when reverse != c.reversed
						driven.run()
						break when !b.successful
					}
				}
				break when length == 0
				sub += length
			}
			c.reverseBuffer() when c.reversed
		}

		// The subtable of type `kind` whose body starts at `body`.
		internal def subtable(c AatContext, kind int, body int) MorxSubtable {
			let extended = !obsolete
			match kind {
				case 0:
					return new Rearrangement(c, new StateTable(d, body, extended, 0))
				case 1:
					return new ContextualSubst(c, new StateTable(d, body, extended, 4))
				case 2:
					return new LigatureSubst(c, new StateTable(d, body, extended, extended ?? (2, 0)))
				case 4:
					return new NoncontextualSubst(c, d, body)
				case 5:
					return new InsertionSubst(c, new StateTable(d, body, extended, 4))
			}
			return new UnknownSubtable()
		}
	}

	// A subtable type this does not know (3 is unassigned): it starts on no
	// glyph, so it never runs.
	type UnknownSubtable {
		def new() {}

		def collect(set GlyphSet) {}

		def run() {}
	}

	// A `morx` subtable: what it starts on, and running it.
	interface MorxSubtable {
		def collect(set GlyphSet)
		def run()
	}

	// Whether a state table is usable: every table reserves four classes.
	def aatValidMachine(m StateTable) bool {
		return m.nClasses >= 4
	}

	// Type 0: moves glyphs at the ends of a marked range.
	type Rearrangement {
		internal c     AatContext
		internal m     StateTable
		internal start int
		internal end   int

		def new(c AatContext, m StateTable) {
			self.c = c
			self.m = m
		}

		def collect(set GlyphSet) {
			m.collectInitial(set, c.numGlyphs, self) when aatValidMachine(m)
		}

		def run() {
			driveStateMachine(c, m, self) when aatValidMachine(m)
		}

		def inPlace() bool {
			return true
		}

		def isInitiable(e int) bool {
			return m.flags(e) & 0x8000 != 0
		}

		def isActionable(e int) bool {
			return m.flags(e) & 0xF != 0
		}

		def transition(b Buffer, e int) {
			let flags = m.flags(e)
			start = b.idx when flags & 0x8000 != 0
			end = (b.idx + 1).min(b.len) when flags & 0x2000 != 0
			return when flags & 0xF == 0 || start >= end
			// Per verb, how many glyphs move from the start side (high
			// nibble) and the end side (low); 3 moves two and swaps them.
			let verbs = [0x00, 0x10, 0x01, 0x11, 0x20, 0x30, 0x02, 0x03, 0x12, 0x13, 0x21, 0x31, 0x22, 0x32, 0x23, 0x33]
			let v = verbs[flags & 0xF]
			let l = (v >> 4).min(2)
			let r = (v & 0xF).min(2)
			let reverseL = v >> 4 == 3
			let reverseR = v & 0xF == 3
			return when end - start < l + r || end - start > aatMaxContext
			b.mergeClusters(start, (b.idx + 1).min(b.len))
			b.mergeClusters(start, end)
			let info = b.info
			let saved = new Infos()
			saved.size(4)
			for let k = 0; k < l; k++ {
				saved.copy(k, info, start + k)
			}
			for let k = 0; k < r; k++ {
				saved.copy(2 + k, info, end - r + k)
			}
			if l != r {
				let n = end - start - l - r
				if r > l {
					for let k = n - 1; k >= 0; k-- {
						info.copy(start + r + k, info, start + l + k)
					}
				} else {
					for let k = 0; k < n; k++ {
						info.copy(start + r + k, info, start + l + k)
					}
				}
			}
			for let k = 0; k < r; k++ {
				info.copy(start + k, saved, 2 + k)
			}
			for let k = 0; k < l; k++ {
				info.copy(end - l + k, saved, k)
			}
			if reverseL {
				saved.copy(0, info, end - 1)
				info.copy(end - 1, info, end - 2)
				info.copy(end - 2, saved, 0)
			}
			if reverseR {
				saved.copy(0, info, start)
				info.copy(start, info, start + 1)
				info.copy(start + 1, saved, 0)
			}
		}
	}

	// Type 1: substitutes the marked and the current glyph through lookup
	// tables the entries pick.
	type ContextualSubst {
		internal c       AatContext
		internal m       StateTable
		internal subs    int
		internal markSet bool
		internal mark    int

		def new(c AatContext, m StateTable) {
			self.c = c
			self.m = m
			let off = m.base + m.headerSize()
			subs = m.base + (m.extended ?? (m.d.u32(off), m.d.u16(off)))
		}

		def collect(set GlyphSet) {
			m.collectInitial(set, c.numGlyphs, self) when aatValidMachine(m)
		}

		def run() {
			driveStateMachine(c, m, self) when aatValidMachine(m)
		}

		def inPlace() bool {
			return true
		}

		def isInitiable(e int) bool {
			return m.flags(e) & 0x8000 != 0
		}

		def isActionable(e int) bool {
			return m.data(e, 0) != 0xFFFF || m.data(e, 1) != 0xFFFF
		}

		// The replacement of `g` through table `index`, -1 when none.
		internal def replacement(index int, g int) int {
			let d = m.d
			if m.extended {
				return -1 when index == 0xFFFF
				let lookup = subs + d.u32(subs + index * 4)
				return new AatLookup(d, lookup).value(g, c.numGlyphs)
			}
			// `mort`: a word offset from the subtable to the glyph.
			let offset = (index + g) * 2
			let rel = subs - m.base
			return -1 when offset < rel
			let at = subs + (offset - rel) / 2 * 2
			return -1 when !d.has(at, 2) || d.u16(at) == 0
			return d.u16(at)
		}

		def transition(b Buffer, e int) {
			// CoreText substitutes nothing at the end of text without a mark.
			return when b.idx == b.len && !markSet
			if mark < b.len {
				let r = replacement(m.data(e, 0), b.info.glyph[mark])
				if r >= 0 {
					b.unsafeToBreak(mark, (b.idx + 1).min(b.len))
					c.replaceGlyphInPlace(mark, r)
				}
			}
			let i = b.idx.min(b.len - 1)
			let r = replacement(m.data(e, 1), b.info.glyph[i])
			c.replaceGlyphInPlace(i, r) when r >= 0
			if m.flags(e) & 0x8000 != 0 {
				markSet = true
				mark = b.idx
			}
		}
	}

	// Type 2: collects components on a stack and replaces them with a
	// ligature.
	type LigatureSubst {
		internal c          AatContext
		internal m          StateTable
		internal actions    int
		internal components int
		internal ligature   int
		internal positions  int[]
		internal matched    int

		def new(c AatContext, m StateTable) {
			self.c = c
			self.m = m
			let d = m.d
			let off = m.base + m.headerSize()
			if m.extended {
				actions = m.base + d.u32(off)
				components = m.base + d.u32(off + 4)
				ligature = m.base + d.u32(off + 8)
			} else {
				actions = m.base + d.u16(off)
				components = m.base + d.u16(off + 2)
				ligature = m.base + d.u16(off + 4)
			}
			positions.len(aatMaxContext)
			positions.fill(0)
		}

		def collect(set GlyphSet) {
			m.collectInitial(set, c.numGlyphs, self) when aatValidMachine(m)
		}

		def run() {
			driveStateMachine(c, m, self) when aatValidMachine(m)
		}

		def inPlace() bool {
			return false
		}

		def isInitiable(e int) bool {
			return m.flags(e) & 0x8000 != 0
		}

		def isActionable(e int) bool {
			return m.extended ?? (m.flags(e) & 0x2000 != 0, m.flags(e) & 0x3FFF != 0)
		}

		// Index of an entry into an array at `array`, from a byte offset
		// counted from the subtable start (`mort`); `morx` stores indices.
		internal def index(offset int, array int, width int) int {
			return offset when m.extended
			let rel = array - m.base
			return -1 when offset < rel
			return (offset - rel) / width
		}

		def transition(b Buffer, e int) {
			let d = m.d
			let flags = m.flags(e)
			if flags & 0x8000 != 0 {
				// Never mark the same entry twice (after DontAdvance).
				matched-- when matched > 0 && positions[(matched - 1) % aatMaxContext] == b.outLen
				positions[matched % aatMaxContext] = b.outLen
				matched++
			}
			return when !isActionable(e)
			let end = b.outLen
			return when matched == 0 || b.idx >= b.len
			let cursor = matched
			let actionIndex = m.extended ?? (m.data(e, 0), index(flags & 0x3FFF, actions, 4))
			let action = actions + actionIndex * 4
			let ligIndex = 0
			for {
				if cursor == 0 {
					// Stack underflow: clear it.
					matched = 0
					break
				}
				cursor--
				b.moveTo(positions[cursor % aatMaxContext])
				return when !b.successful
				break when actionIndex < 0 || !d.has(action, 4)
				let a = d.u32(action)
				let offset = a & 0x3FFFFFFF
				offset -= 0x40000000 when offset & 0x20000000 != 0
				let ci = b.info.glyph[b.idx] + offset
				ci = m.extended ?? (ci, index(ci * 2, components, 2))
				let componentAt = components + ci * 2
				break when ci < 0 || !d.has(componentAt, 2)
				ligIndex += d.u16(componentAt)
				// 0x80000000 last action, 0x40000000 store.
				if a & 0xC0000000 != 0 {
					// The running index becomes an entry index (`mort` stores
					// byte offsets) and keeps adding from there.
					ligIndex = index(ligIndex, ligature, 2)
					let ligatureAt = ligature + ligIndex * 2
					break when ligIndex < 0 || !d.has(ligatureAt, 2)
					c.replaceGlyph(d.u16(ligatureAt))
					return when !b.successful
					let ligEnd = positions[(matched - 1) % aatMaxContext] + 1
					// Delete the components after the first.
					for matched - 1 > cursor {
						matched--
						b.moveTo(positions[matched % aatMaxContext])
						return when !b.successful
						c.deleteGlyph()
						return when !b.successful
					}
					b.moveTo(ligEnd)
					return when !b.successful
					b.mergeOutClusters(positions[cursor % aatMaxContext], b.outLen)
				}
				action += 4
				break when a & 0x80000000 != 0
			}
			b.moveTo(end)
		}
	}

	// Type 4: substitutes every glyph through one lookup table.
	type NoncontextualSubst {
		internal c      AatContext
		internal lookup AatLookup

		def new(c AatContext, d Data, body int) {
			self.c = c
			lookup = new AatLookup(d, body)
		}

		def collect(set GlyphSet) {
			lookup.collect(set, c.numGlyphs)
		}

		def run() {
			let b = c.b
			let ranged = c.ranges.flags.len() > 1
			let range = 0
			for let i = 0; i < b.len; i++ {
				if ranged {
					range = c.rangeOf(b.info.cluster[i], range)
					continue when c.ranges.flags[range] & c.subtableFlags == 0
				}
				let r = lookup.value(b.info.glyph[i], c.numGlyphs)
				c.replaceGlyphInPlace(i, r) when r >= 0
			}
		}
	}

	// Type 5: inserts glyphs at the marked or the current glyph.
	type InsertionSubst {
		internal c      AatContext
		internal m      StateTable
		internal glyphs int
		internal mark   int

		def new(c AatContext, m StateTable) {
			self.c = c
			self.m = m
			let off = m.base + m.headerSize()
			glyphs = m.base + (m.extended ?? (m.d.u32(off), m.d.u16(off)))
		}

		def collect(set GlyphSet) {
			m.collectInitial(set, c.numGlyphs, self) when aatValidMachine(m)
		}

		def run() {
			driveStateMachine(c, m, self) when aatValidMachine(m)
		}

		def inPlace() bool {
			return false
		}

		def isInitiable(e int) bool {
			return m.flags(e) & 0x8000 != 0
		}

		def isActionable(e int) bool {
			return m.flags(e) & 0x3FF != 0 && (m.data(e, 0) != 0xFFFF || m.data(e, 1) != 0xFFFF)
		}

		// The `count` glyphs of the insertion list from `start`, none when
		// the table does not hold them all.
		internal def list(start int, count int) int[] {
			let out int[]
			let at = glyphs + start * 2
			return out when !m.d.has(at, count * 2)
			for let k = 0; k < count; k++ {
				out.push(m.d.u16(at + k * 2))
			}
			return out
		}

		def transition(b Buffer, e int) {
			let flags = m.flags(e)
			let markLoc = b.outLen
			let marked = m.data(e, 1)
			if marked != 0xFFFF {
				let count = flags & 0x1F
				b.maxOps -= count
				return when b.maxOps <= 0
				let inserted = list(marked, count)
				// 0x0400: insert before the marked glyph.
				let before = flags & 0x0400 != 0
				let end = b.outLen
				b.moveTo(mark)
				return when !b.successful
				b.copyGlyph() when b.idx < b.len && !before
				return when !b.successful
				c.outputGlyphs(inserted)
				return when !b.successful
				b.skipGlyph() when b.idx < b.len && !before
				b.moveTo(end + inserted.len())
				return when !b.successful
				b.unsafeToBreak(mark, (b.idx + 1).min(b.len), true)
			}
			mark = markLoc when flags & 0x8000 != 0
			let current = m.data(e, 0)
			if current != 0xFFFF {
				let count = (flags & 0x3E0) >> 5
				b.maxOps -= count
				return when b.maxOps <= 0
				let inserted = list(current, count)
				// 0x0800: insert before the current glyph.
				let before = flags & 0x0800 != 0
				let end = b.outLen
				b.copyGlyph() when b.idx < b.len && !before
				return when !b.successful
				c.outputGlyphs(inserted)
				return when !b.successful
				b.skipGlyph() when b.idx < b.len && !before
				// Without DontAdvance the inserted glyphs are passed over;
				// with it they are processed next.
				b.moveTo(flags & 0x4000 != 0 ?? (end, end + inserted.len()))
			}
		}
	}
}
