internal partial module std.formats.fonts.layout {
	use std.text.unicode

	// How a shaper wants text normalized before glyph mapping.
	const (
		normalizeNone                   = 0
		normalizeDecomposed             = 1
		// Compose marks onto their base when the font has the composite.
		normalizeComposed               = 2
		normalizeComposedNoShortCircuit = 3
		normalizeAuto                   = 4
	)

	const maxCombiningMarks = 32

	// Gives entry `i` its Unicode properties from its code point.
	def setUnicodeProps(b Buffer, info Infos, i int) {
		let u = info.glyph[i]
		let cat = categoryOf(u)
		let props = cat
		if u >= 0x80 {
			if unicode.isDefaultIgnorable(char(u)) {
				b.scratch |= scratchDefaultIgnorables
				props |= upropsIgnorable
				if u == 0x200C {
					props |= upropsZWNJ
				} else if u == 0x200D {
					props |= upropsZWJ
				} else if (u >= 0x180B && u <= 0x180D) || u == 0x180F || (u >= 0xE0020 && u <= 0xE007F) {
					// Mongolian free variation selectors and tags: hidden, but
					// lookups still see them.
					props |= upropsHidden
				} else if u == 0x034F {
					b.scratch |= scratchCGJ
					props |= upropsHidden
				}
			}
			if isMarkCategory(cat) {
				b.scratch |= scratchContinuations
				props |= upropsContinuation
				props |= modifiedCombiningClass(u) << 8
			}
		}
		info.uprops[i] = props
	}

	// Decomposes text to what the font covers, reorders marks, and composes
	// them back where the font has the composite. Leaves each entry's glyph
	// in `aux`.
	def normalizeText(p Plan, b Buffer) {
		return when b.len == 0
		let font = p.font
		let mode = p.shaper.normalization
		mode = normalizeComposed when mode == normalizeAuto
		let alwaysShort = mode == normalizeNone
		let mightShort = alwaysShort || (mode != normalizeDecomposed && mode != normalizeComposedNoShortCircuit)

		let allSimple = true
		b.clearOutput()
		let count = b.len
		b.idx = 0
		for b.idx < count && b.successful {
			let end = b.idx + 1
			for end < count && !b.info.isUnicodeMark(end) {
				end++
			}
			// Leave one base for the marks to cluster with.
			end-- when end < count
			if mightShort {
				for b.idx < end {
					let g = font.glyph(b.info.glyph[b.idx])
					break when g < 0
					b.info.aux[b.idx] = g
					b.nextGlyph()
				}
			}
			for b.idx < end && b.successful {
				decomposeCurrent(p, b, mightShort)
			}
			break when b.idx == count
			allSimple = false
			end = b.idx + 1
			for end < count && b.info.isUnicodeMark(end) {
				end++
			}
			decomposeCluster(p, b, end, alwaysShort)
		}
		b.sync()

		if !allSimple {
			// Canonical ordering by modified combining class.
			let i = 0
			for i < b.len {
				if b.info.combiningClass(i) == 0 {
					i++
					continue
				}
				let end = i + 1
				for end < b.len && b.info.combiningClass(end) != 0 {
					end++
				}
				if end - i <= maxCombiningMarks {
					b.sort(i, end, (x int, y int) => b.info.combiningClass(x) < b.info.combiningClass(y))
					reorderMarks(p, b, i, end)
				}
				i = end
			}
		}

		if b.scratch & scratchCGJ != 0 {
			// A CGJ that does not change mark order stays visible to lookups.
			for let i = 1; i + 1 < b.len; i++ {
				b.info.uprops[i] &= ~upropsHidden when b.info.glyph[i] == 0x034F && (b.info.combiningClass(i + 1) == 0 || b.info.combiningClass(i - 1) <= b.info.combiningClass(i + 1))
			}
		}

		if !allSimple && (mode == normalizeComposed || mode == normalizeComposedNoShortCircuit) {
			b.clearOutput()
			let n = b.len
			let starter = 0
			b.nextGlyph()
			for b.idx < n {
				if b.info.isUnicodeMark(b.idx) {
					let blocked = !(starter == b.outLen - 1 || b.out.combiningClass(b.outLen - 1) < b.info.combiningClass(b.idx))
					if !blocked {
						let composed = composeChars(p, b.out.glyph[starter], b.info.glyph[b.idx])
						if composed >= 0 {
							let g = font.glyph(composed)
							if g >= 0 {
								b.nextGlyph()
								b.mergeOutClusters(starter, b.outLen)
								b.outLen--
								b.out.glyph[starter] = composed
								b.out.aux[starter] = g
								setUnicodeProps(b, b.out, starter)
								continue
							}
						}
					}
				}
				b.nextGlyph()
				starter = b.outLen - 1 when b.out.combiningClass(b.outLen - 1) == 0
			}
			b.sync()
		}
	}

	// One-step canonical decomposition as (a, b); b is 0 for a singleton,
	// and (0, 0) when the code point does not decompose.
	def decomposeChar(p Plan, ab int) (int, int) {
		let (handled, a, b) = shaperDecompose(p, ab)
		return (a, b) when handled
		let parts = unicode.decompose(char(ab), compatibility = false, full = false)
		return (0, 0) when parts.len() == 1 && int(parts[0]) == ab
		return (int(parts[0]), 0) when parts.len() == 1
		return (int(parts[0]), int(parts[1]))
	}

	def composeChars(p Plan, a int, b int) int {
		let (handled, c) = shaperCompose(p, a, b)
		return c when handled
		let r = unicode.compose(char(a), char(b))
		return r is none ?? (-1, int(r))
	}

	// Outputs code point `u` with glyph `g` before the current entry.
	internal def outputChar(b Buffer, u int, g int) {
		b.info.aux[b.idx] = g
		b.outputGlyph(u)
		setUnicodeProps(b, b.out, b.outLen - 1)
	}

	internal def nextChar(b Buffer, g int) {
		b.info.aux[b.idx] = g
		b.nextGlyph()
	}

	// Decomposes `ab` into what the font covers; returns how many entries it
	// output, 0 when it could not.
	internal def decompose(p Plan, b Buffer, shortest bool, ab int) int {
		let font = p.font
		let (a, bb) = decomposeChar(p, ab)
		return 0 when a == 0
		let bGlyph = 0
		if bb != 0 {
			bGlyph = font.glyph(bb)
			return 0 when bGlyph < 0
		}
		let aGlyph = font.glyph(a)
		if shortest && aGlyph >= 0 {
			outputChar(b, a, aGlyph)
			if bb != 0 {
				outputChar(b, bb, bGlyph)
				return 2
			}
			return 1
		}
		let ret = decompose(p, b, shortest, a)
		if ret > 0 {
			if bb != 0 {
				outputChar(b, bb, bGlyph)
				return ret + 1
			}
			return ret
		}
		if aGlyph >= 0 {
			outputChar(b, a, aGlyph)
			if bb != 0 {
				outputChar(b, bb, bGlyph)
				return 2
			}
			return 1
		}
		return 0
	}

	internal def decomposeCurrent(p Plan, b Buffer, shortest bool) {
		let font = p.font
		let u = b.info.glyph[b.idx]
		let g = font.glyph(u)
		if shortest && g >= 0 {
			nextChar(b, g)
			return
		}
		if decompose(p, b, shortest, u) > 0 {
			b.skipGlyph()
			return
		}
		if !shortest && g >= 0 {
			nextChar(b, g)
			return
		}
		if b.info.category(b.idx) == catZs {
			let kind = spaceFallbackType(u)
			if kind != spaceNot {
				let space = font.glyph(0x20)
				space = b.invisible when space < 0
				if space >= 0 {
					b.info.uprops[b.idx] = kind << 8 | b.info.uprops[b.idx] & 0xFF
					nextChar(b, space)
					b.scratch |= scratchSpaceFallback
					return
				}
			}
		}
		if u == 0x2011 {
			// Non-breaking hyphen draws as a hyphen.
			let other = font.glyph(0x2010)
			if other >= 0 {
				nextChar(b, other)
				return
			}
		}
		nextChar(b, g.max(0))
	}

	// A base and its marks. Variation selectors pick glyph variants.
	internal def decomposeCluster(p Plan, b Buffer, end int, shortCircuit bool) {
		for let i = b.idx; i < end; i++ {
			if isVariationSelector(b.info.glyph[i]) {
				variationCluster(p, b, end)
				return
			}
		}
		for b.idx < end {
			decomposeCurrent(p, b, shortCircuit)
		}
	}

	internal def variationCluster(p Plan, b Buffer, end int) {
		let font = p.font
		for b.idx < end - 1 {
			if isVariationSelector(b.info.glyph[b.idx + 1]) {
				let variant = font.variationGlyph(b.info.glyph[b.idx], b.info.glyph[b.idx + 1])
				if variant >= 0 {
					b.info.aux[b.idx] = variant
					b.replaceGlyphs(2, [b.info.glyph[b.idx]])
				} else {
					b.info.aux[b.idx] = font.glyph(b.info.glyph[b.idx]).max(0)
					b.nextGlyph()
					b.scratch |= scratchVSFallback
					// Keep the selector, marked, so it can be hidden later.
					b.info.setCategory(b.idx, catCf)
					b.info.uprops[b.idx] |= upropsVS
					b.info.aux[b.idx] = font.glyph(b.info.glyph[b.idx]).max(0)
					b.nextGlyph()
				}
				for b.idx < end && isVariationSelector(b.info.glyph[b.idx]) {
					b.info.aux[b.idx] = font.glyph(b.info.glyph[b.idx]).max(0)
					b.nextGlyph()
				}
			} else {
				b.info.aux[b.idx] = font.glyph(b.info.glyph[b.idx]).max(0)
				b.nextGlyph()
			}
		}
		if b.idx < end {
			b.info.aux[b.idx] = font.glyph(b.info.glyph[b.idx]).max(0)
			b.nextGlyph()
		}
	}
}
