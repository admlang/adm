internal partial module std.formats.fonts.layout {
	use std.text.unicode

	// General categories by `unicode.Category` ordinal, as buffer entries
	// store them.
	const (
		catLu = 0
		catLl = 1
		catLt = 2
		catLm = 3
		catLo = 4
		catMn = 5
		catMc = 6
		catMe = 7
		catNd = 8
		catNl = 9
		catNo = 10
		catPc = 11
		catPd = 12
		catPs = 13
		catPe = 14
		catPi = 15
		catPf = 16
		catPo = 17
		catSm = 18
		catSc = 19
		catSk = 20
		catSo = 21
		catZs = 22
		catZl = 23
		catZp = 24
		catCc = 25
		catCf = 26
		catCs = 27
		catCo = 28
		catCn = 29
	)

	def categoryOf(cp int) int {
		return int(unicode.category(char(cp)))
	}

	def isLetterCategory(c int) bool {
		return c <= catLo
	}

	def isMarkCategory(c int) bool {
		return c >= catMn && c <= catMe
	}

	// Combining classes the shaper reorders by: Hebrew, Arabic, Syriac,
	// Telugu, Thai, Lao and Tibetan classes remapped so that the order marks
	// sort into is the one fonts expect.
	let modifiedClass = modifiedClassTable()

	def modifiedClassTable() int[] {
		let t int[]
		t.len(256)
		for let i = 0; i < 256; i++ {
			t[i] = i
		}
		let remap = [10, 22, 11, 15, 12, 16, 13, 17, 14, 23, 15, 18, 16, 19, 17, 20, 18, 21, 19, 14, 20, 24, 21, 12, 22, 25, 23, 13, 24, 10, 25, 11, 26, 26, 27, 28, 28, 29, 29, 30, 30, 31, 31, 32, 32, 33, 33, 27, 34, 34, 35, 35, 36, 36, 84, 4, 91, 5, 103, 3, 107, 107, 118, 118, 122, 122, 129, 129, 130, 132, 132, 131]
		for let i = 0; i < remap.len(); i += 2 {
			t[remap[i]] = remap[i + 1]
		}
		return t
	}

	def modifiedCombiningClass(cp int) int {
		// Sakot after tone marks, padma after vowels, tsa-phru before U+0F74.
		return 254 when cp := 0x1A60 || 0x0FC6
		return 127 when cp == 0x0F39
		return modifiedClass[unicode.combiningClass(char(cp))]
	}

	def isVariationSelector(cp int) bool {
		return (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0xE0100 && cp <= 0xE01EF)
	}

	// Widths a missing space may take from the space glyph (fractions of an
	// em, or the width of other glyphs).
	const (
		spaceNot         = 0
		spaceEm          = 1
		spaceEm2         = 2
		spaceEm3         = 3
		spaceEm4         = 4
		spaceEm5         = 5
		spaceEm6         = 6
		spaceEm16        = 16
		space4Em18       = 17
		spaceSpace       = 18
		spaceFigure      = 19
		spacePunctuation = 20
		spaceNarrow      = 21
	)

	def spaceFallbackType(cp int) int {
		match cp {
			case 0x0020, 0x00A0:
				return spaceSpace
			case 0x2000, 0x2002:
				return spaceEm2
			case 0x2001, 0x2003, 0x3000:
				return spaceEm
			case 0x2004:
				return spaceEm3
			case 0x2005:
				return spaceEm4
			case 0x2006:
				return spaceEm6
			case 0x2007:
				return spaceFigure
			case 0x2008:
				return spacePunctuation
			case 0x2009:
				return spaceEm5
			case 0x200A:
				return spaceEm16
			case 0x202F:
				return spaceNarrow
			case 0x205F:
				return space4Em18
		}
		return spaceNot
	}
}
