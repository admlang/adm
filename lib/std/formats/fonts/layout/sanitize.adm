// Table validation: HarfBuzz 14.1's sanitize rules for GSUB, GPOS and
// GDEF. A table any of whose structures reaches outside it is dropped
// whole, as HarfBuzz drops it, so broken fonts shape as they do there.

internal partial module std.formats.fonts.layout {
	// Validates one table's bytes.
	type Sanitizer {
		internal d         Data
		// Bytes left to check: 64 per byte of the table, at least 16384.
		internal ops       int
		internal subtables int
		// GPOS checks anchors and device tables when it uses them.
		internal lazy      bool
		internal depth     int

		def new(d Data, lazy bool = false) {
			self.d = d
			self.lazy = lazy
			ops = (d.len() * 64).clamp(16384, 0x3FFFFFFF)
		}

		// Whether `n` bytes from `at` lie inside the table; charges them.
		def range(at int, n int) bool {
			return false when at < 0 || n < 0 || at > d.len() || d.len() - at < n
			ops -= n
			return ops > 0
		}

		// A fixed-size header: inside the table, free.
		def fits(at int, n int) bool {
			return at >= 0 && at + n <= d.len()
		}

		def spend(count int) bool {
			if ops < 0 || count >= ops {
				ops = -1
				return false
			}
			ops -= count
			return true
		}

		// An array of `count` items of `size` bytes at `at`.
		def array(at int, count int, size int) bool {
			return range(at, count * size)
		}

		// A u16 count then that many `size`-byte items.
		def array16(at int, size int) bool {
			return fits(at, 2) && array(at + 2, d.u16(at), size)
		}

		// The offset field at `field` (from `base`) is in range, and so is
		// its target by `target` unless the offset is 0 (null, when allowed).
		def offset16(field int, base int, target def (int) bool, nullable bool = true) bool {
			return false unless fits(field, 2)
			let off = d.u16(field)
			return true when off == 0 && nullable
			return target(base + off)
		}

		def offset32(field int, base int, target def (int) bool) bool {
			return false unless fits(field, 4)
			let off = d.u32(field)
			return true when off == 0
			return target(base + off)
		}

		// A u16 count of u16 offsets from `base`, each by `target`.
		def offsets16(at int, base int, target def (int) bool) bool {
			return false unless array16(at, 2)
			for let i = 0; i < d.u16(at); i++ {
				return false unless offset16(at + 2 + i * 2, base, target)
			}
			return true
		}

		def coverage(at int) bool {
			return false unless fits(at, 2)
			let f = d.u16(at)
			return array16(at + 2, 2) when f == 1
			return array16(at + 2, 6) when f == 2
			return true
		}

		// How many glyphs a coverage holds, for the operation budget.
		def population(at int) int {
			let f = d.u16(at)
			return d.u16(at + 2) when f == 1
			if f == 2 {
				let n = 0
				for let i = 0; i < d.u16(at + 2); i++ {
					let r = at + 4 + i * 6
					n += (d.u16(r + 2) - d.u16(r) + 1).max(0)
				}
				return n
			}
			return 0
		}

		def classDef(at int) bool {
			return false unless fits(at, 2)
			let f = d.u16(at)
			return fits(at, 6) && array16(at + 4, 2) when f == 1
			return array16(at + 2, 6) when f == 2
			return true
		}

		def device(at int) bool {
			return false unless fits(at, 6)
			let f = d.u16(at + 4)
			if f >= 1 && f <= 3 {
				let start = d.u16(at)
				let end = d.u16(at + 2)
				let size = start > end ?? (6, 2 * (4 + ((end - start) >> (4 - f))))
				return range(at, size)
			}
			return true
		}

		// ---- GSUB / GPOS

		// The whole table; `gpos` picks the subtable kinds.
		def layout(gpos bool) bool {
			return false unless fits(0, 4)
			return true unless d.u16(0) == 1
			return false unless fits(0, 10)
			return false unless offset16(4, 0, (at int) => self.scriptList(at))
			return false unless offset16(6, 0, (at int) => self.featureList(at))
			return false unless offset16(8, 0, (at int) => self.lookupList(at, gpos))
			return true when d.u32(0) < 0x00010001
			return offset32(10, 0, (at int) => self.featureVariations(at))
		}

		def scriptList(at int) bool {
			return false unless array16(at, 6)
			for let i = 0; i < d.u16(at); i++ {
				return false unless offset16(at + 2 + i * 6 + 4, at, (s int) => self.script(s))
			}
			return true
		}

		def script(at int) bool {
			return false unless offset16(at, at, (l int) => self.langSys(l))
			return false unless array16(at + 2, 6)
			for let i = 0; i < d.u16(at + 2); i++ {
				return false unless offset16(at + 4 + i * 6 + 4, at, (l int) => self.langSys(l))
			}
			return true
		}

		def langSys(at int) bool {
			return fits(at, 6) && array16(at + 4, 2)
		}

		def featureList(at int) bool {
			return false unless array16(at, 6)
			for let i = 0; i < d.u16(at); i++ {
				let rec = at + 2 + i * 6
				let tag = d.tag(rec)
				return false unless offset16(rec + 4, at, (f int) => self.feature(f, tag))
			}
			return true
		}

		def feature(at int, tag string) bool {
			return false unless fits(at, 4)
			return false unless offset16(at, at, (p int) => self.featureParams(p, tag))
			return array16(at + 2, 2)
		}

		def featureParams(at int, tag string) bool {
			if tag == "size" {
				return false unless fits(at, 10)
				let design = d.u16(at)
				let family = d.u16(at + 2)
				let name = d.u16(at + 4)
				let start = d.u16(at + 6)
				let end = d.u16(at + 8)
				return false when design == 0
				return true when family == 0 && name == 0 && start == 0 && end == 0
				return !(design < start || design > end || name < 256 || name > 32767)
			}
			return fits(at, 4) when tag.startsWith("ss")
			return fits(at, 14) && array(at + 14, d.u16(at + 12), 3) when tag.startsWith("cv")
			return true
		}

		def lookupList(at int, gpos bool) bool {
			return false unless array16(at, 2)
			for let i = 0; i < d.u16(at); i++ {
				return false unless offset16(at + 2 + i * 2, at, (l int) => self.lookup(l, gpos))
			}
			return true
		}

		def lookup(at int, gpos bool) bool {
			return false unless fits(at, 6) && array16(at + 4, 2)
			let kind = d.u16(at)
			let count = d.u16(at + 4)
			subtables += count
			return false unless subtables < 0x4000
			if d.u16(at + 2) & flagUseMarkFilteringSet != 0 {
				return false unless fits(at + 6 + count * 2, 2)
			}
			for let i = 0; i < count; i++ {
				return false unless offset16(at + 6 + i * 2, at, (s int) => self.subtable(s, kind, gpos))
			}
			let extension = gpos ?? (9, 7)
			if kind == extension && count > 0 {
				// Every subtable of an extension lookup wraps the same type.
				let first = extensionType(at + d.u16(at + 6))
				for let i = 1; i < count; i++ {
					return false unless extensionType(at + d.u16(at + 6 + i * 2)) == first
				}
			}
			return true
		}

		// The lookup type an extension subtable wraps; 0 for other formats.
		def extensionType(at int) int {
			return d.u16(at) == 1 ?? (d.u16(at + 2), 0)
		}

		def subtable(at int, kind int, gpos bool) bool {
			return false unless fits(at, 2)
			let format = d.u16(at)
			if (gpos && kind == 9) || (!gpos && kind == 7) {
				return true unless format == 1
				return false unless fits(at, 8)
				let inner = d.u16(at + 2)
				return false when inner == kind
				// A null target is HarfBuzz's empty object, outside the table.
				return false when d.u32(at + 4) == 0
				return subtable(at + d.u32(at + 4), inner, gpos)
			}
			return gposSubtable(at, kind, format) when gpos
			return gsubSubtable(at, kind, format)
		}

		def gsubSubtable(at int, kind int, format int) bool {
			let cov = (c int) => self.coverage(c)
			match kind {
				case 1:
					if format == 1 {
						return fits(at, 6) && offset16(at + 2, at, cov) && spend(population(at + d.u16(at + 2)) >> 1)
					}
					return offset16(at + 2, at, cov) && array16(at + 4, 2) when format == 2
				case 2, 3:
					// Multiple: sequences; alternate: sets. Both u16 arrays.
					return offset16(at + 2, at, cov) && offsets16(at + 4, at, (s int) => self.array16(s, 2)) when format == 1
				case 4:
					return offset16(at + 2, at, cov) && offsets16(at + 4, at, (s int) => self.offsets16(s, s, (l int) => self.ligature(l))) when format == 1
				case 5:
					return context(at, format)
				case 6:
					return chainContext(at, format)
				case 8:
					if format == 1 {
						return false unless offset16(at + 2, at, cov) && coverages16(at + 4, at)
						let ahead = at + 4 + 2 + d.u16(at + 4) * 2
						return false unless coverages16(ahead, at)
						return array16(ahead + 2 + d.u16(ahead) * 2, 2)
					}
			}
			return true
		}

		def ligature(at int) bool {
			return false unless fits(at, 4)
			let count = d.u16(at + 2)
			return array(at + 4, count > 0 ?? (count - 1, 0), 2)
		}

		// A u16 count of coverage offsets from `base`.
		def coverages16(at int, base int) bool {
			return offsets16(at, base, (c int) => self.coverage(c))
		}

		def context(at int, format int) bool {
			let cov = (c int) => self.coverage(c)
			if format == 1 {
				return offset16(at + 2, at, cov) && offsets16(at + 4, at, (s int) => self.offsets16(s, s, (r int) => self.rule(r)))
			}
			if format == 2 {
				return offset16(at + 2, at, cov) && offset16(at + 4, at, (c int) => self.classDef(c)) && offsets16(at + 6, at, (s int) => self.offsets16(s, s, (r int) => self.rule(r)))
			}
			if format == 3 {
				return false unless fits(at, 6)
				let count = d.u16(at + 2)
				return false when count == 0
				return false unless array(at + 6, count, 2)
				for let i = 0; i < count; i++ {
					return false unless offset16(at + 6 + i * 2, at, cov)
				}
				return array(at + 6 + count * 2, d.u16(at + 4), 4)
			}
			return true
		}

		def rule(at int) bool {
			return false unless fits(at, 4)
			let input = d.u16(at)
			return range(at + 4, 2 * (input > 0 ?? (input - 1, 0)) + 4 * d.u16(at + 2))
		}

		def chainContext(at int, format int) bool {
			let cov = (c int) => self.coverage(c)
			if format == 1 {
				return offset16(at + 2, at, cov) && offsets16(at + 4, at, (s int) => self.offsets16(s, s, (r int) => self.chainRule(r)))
			}
			if format == 2 {
				let cd = (c int) => self.classDef(c)
				return offset16(at + 2, at, cov) && offset16(at + 4, at, cd) && offset16(at + 6, at, cd) && offset16(at + 8, at, cd) && offsets16(at + 10, at, (s int) => self.offsets16(s, s, (r int) => self.chainRule(r)))
			}
			if format == 3 {
				return false unless coverages16(at + 2, at)
				let input = at + 2 + 2 + d.u16(at + 2) * 2
				return false unless coverages16(input, at)
				return false when d.u16(input) == 0
				let ahead = input + 2 + d.u16(input) * 2
				return false unless coverages16(ahead, at)
				return array16(ahead + 2 + d.u16(ahead) * 2, 4)
			}
			return true
		}

		def chainRule(at int) bool {
			return false unless fits(at, 2)
			let input = at + 2 + d.u16(at) * 2
			return false unless fits(input, 2)
			let ahead = input + 2 + (d.u16(input) > 0 ?? (d.u16(input) - 1, 0)) * 2
			return false unless fits(ahead, 2)
			return array16(ahead + 2 + d.u16(ahead) * 2, 4)
		}

		def gposSubtable(at int, kind int, format int) bool {
			let cov = (c int) => self.coverage(c)
			match kind {
				case 1:
					if format == 1 {
						return fits(at, 6) && offset16(at + 2, at, cov) && spend(population(at + d.u16(at + 2)) >> 1) && values(at, d.u16(at + 4), at + 6, 1, valueLen(d.u16(at + 4)) * 2)
					}
					if format == 2 {
						return fits(at, 8) && offset16(at + 2, at, cov) && values(at, d.u16(at + 4), at + 8, d.u16(at + 6), valueLen(d.u16(at + 4)) * 2)
					}
				case 2:
					return pairPos(at, format)
				case 3:
					if format == 1 {
						return false unless offset16(at + 2, at, cov) && array16(at + 4, 4)
						return true when lazy
						for let i = 0; i < d.u16(at + 4); i++ {
							let rec = at + 6 + i * 4
							return false unless offset16(rec, at, (a int) => self.anchor(a)) && offset16(rec + 2, at, (a int) => self.anchor(a))
						}
						return true
					}
				case 4, 5, 6:
					if format == 1 {
						return false unless fits(at, 12)
						let classes = d.u16(at + 6)
						return false unless offset16(at + 2, at, cov) && offset16(at + 4, at, cov) && offset16(at + 8, at, (m int) => self.markArray(m))
						if kind == 5 {
							return offset16(at + 10, at, (l int) => self.offsets16(l, l, (m int) => self.anchorMatrix(m, classes)))
						}
						return offset16(at + 10, at, (m int) => self.anchorMatrix(m, classes))
					}
				case 7:
					return context(at, format)
				case 8:
					return chainContext(at, format)
			}
			return true
		}

		def pairPos(at int, format int) bool {
			let cov = (c int) => self.coverage(c)
			if format == 1 {
				return false unless fits(at, 10)
				let f1 = d.u16(at + 4)
				let f2 = d.u16(at + 6)
				let len1 = valueLen(f1)
				let stride = 2 + (len1 + valueLen(f2)) * 2
				return offset16(at + 2, at, cov) && offsets16(at + 8, at, (s int) => self.pairSet(s, f1, f2, len1, stride))
			}
			if format == 2 {
				let cd = (c int) => self.classDef(c)
				return false unless fits(at, 16) && offset16(at + 2, at, cov) && offset16(at + 8, at, cd) && offset16(at + 10, at, cd)
				let f1 = d.u16(at + 4)
				let f2 = d.u16(at + 6)
				let len1 = valueLen(f1)
				let stride = (len1 + valueLen(f2)) * 2
				let count = d.u16(at + 12) * d.u16(at + 14)
				return false unless range(at + 16, count * stride)
				return true when lazy
				return valueDevices(at, f1, at + 16, count, stride) && valueDevices(at, f2, at + 16 + len1 * 2, count, stride)
			}
			return true
		}

		def pairSet(at int, f1 int, f2 int, len1 int, stride int) bool {
			return false unless fits(at, 2) && range(at + 2, d.u16(at) * stride)
			return true when lazy
			let count = d.u16(at)
			return valueDevices(at, f1, at + 4, count, stride) && valueDevices(at, f2, at + 4 + len1 * 2, count, stride)
		}

		// `count` value records of `format`, `stride` bytes apart: in range,
		// and (unless lazy) their device tables valid.
		def values(base int, format int, at int, count int, stride int) bool {
			return false unless range(at, count * valueLen(format) * 2)
			return true when lazy
			return valueDevices(base, format, at, count, stride)
		}

		def valueDevices(base int, format int, at int, count int, stride int) bool {
			return true when format & 0xF0 == 0
			for let i = 0; i < count; i++ {
				let v = at + i * stride + valueLen(format & 0xF) * 2
				for let bit = 0x10; bit <= 0x80; bit <<= 1 {
					continue when format & bit == 0
					return false unless offset16(v, base, (x int) => self.device(x))
					v += 2
				}
			}
			return true
		}

		def valueLen(format int) int {
			let n = 0
			for let b = 0; b < 8; b++ {
				n++ when format & (1 << b) != 0
			}
			return n
		}

		def anchor(at int) bool {
			return false unless fits(at, 2)
			let f = d.u16(at)
			return fits(at, 6) when f == 1
			return fits(at, 8) when f == 2
			if f == 3 {
				return fits(at, 10) && offset16(at + 6, at, (x int) => self.device(x)) && offset16(at + 8, at, (x int) => self.device(x))
			}
			return true
		}

		def markArray(at int) bool {
			return false unless array16(at, 4)
			for let i = 0; i < d.u16(at); i++ {
				return false unless offset16(at + 2 + i * 4 + 2, at, (a int) => self.anchor(a))
			}
			return true
		}

		def anchorMatrix(at int, cols int) bool {
			return false unless fits(at, 2)
			let count = d.u16(at) * cols
			return false unless array(at + 2, count, 2)
			return true when lazy
			for let i = 0; i < count; i++ {
				return false unless offset16(at + 2 + i * 2, at, (a int) => self.anchor(a))
			}
			return true
		}

		// ---- FeatureVariations

		def featureVariations(at int) bool {
			return false unless fits(at, 8) && d.u16(at) == 1
			return false unless array(at + 8, d.u32(at + 4), 8)
			for let i = 0; i < d.u32(at + 4); i++ {
				let rec = at + 8 + i * 8
				return false unless offset32(rec, at, (s int) => self.conditionSet(s))
				return false unless offset32(rec + 4, at, (s int) => self.substitutions(s))
			}
			return true
		}

		def conditionSet(at int) bool {
			return false unless array16(at, 4)
			for let i = 0; i < d.u16(at); i++ {
				return false unless offset32(at + 2 + i * 4, at, (c int) => self.condition(c))
			}
			return true
		}

		def condition(at int) bool {
			return false unless fits(at, 2)
			let f = d.u16(at)
			return fits(at, 8) when f == 1 || f == 2
			if f == 3 || f == 4 {
				// A u8 count of 24-bit offsets.
				return false unless fits(at, 3) && array(at + 3, d.u8(at + 2), 3)
				return false when depth >= 64
				depth++
				let ok = true
				for let i = 0; i < d.u8(at + 2) && ok; i++ {
					let rec = at + 3 + i * 3
					let off = d.u8(rec) << 16 | d.u16(rec + 1)
					ok = off == 0 || condition(at + off)
				}
				depth--
				return ok
			}
			if f == 5 {
				return false unless fits(at, 5)
				let off = d.u8(at + 2) << 16 | d.u16(at + 3)
				return true when off == 0
				return false when depth >= 64
				depth++
				let ok = condition(at + off)
				depth--
				return ok
			}
			return true
		}

		def substitutions(at int) bool {
			return false unless fits(at, 4) && d.u16(at) == 1
			return false unless array16(at + 4, 6)
			for let i = 0; i < d.u16(at + 4); i++ {
				return false unless offset32(at + 6 + i * 6 + 2, at, (f int) => self.feature(f, ""))
			}
			return true
		}

		// ---- GDEF

		def gdef() bool {
			return false unless fits(0, 4)
			return true unless d.u16(0) == 1
			return false unless fits(0, 12)
			let cd = (c int) => self.classDef(c)
			return false unless offset16(4, 0, cd)
			return false unless offset16(6, 0, (a int) => self.offset16(a, a, (c int) => self.coverage(c)) && self.offsets16(a + 2, a, (p int) => self.array16(p, 2)))
			return false unless offset16(8, 0, (l int) => self.offset16(l, l, (c int) => self.coverage(c)) && self.offsets16(l + 2, l, (g int) => self.offsets16(g, g, (v int) => self.caretValue(v))))
			return false unless offset16(10, 0, cd)
			let version = d.u32(0)
			if version >= 0x00010002 {
				return false unless offset16(12, 0, (m int) => self.markGlyphSets(m))
			}
			if version >= 0x00010003 {
				return false unless offset32(14, 0, (v int) => self.itemVariationStore(v))
			}
			return true
		}

		def caretValue(at int) bool {
			return false unless fits(at, 2)
			let f = d.u16(at)
			return fits(at, 4) when f == 1 || f == 2
			return fits(at, 6) && offset16(at + 4, at, (x int) => self.device(x)) when f == 3
			return true
		}

		def markGlyphSets(at int) bool {
			return false unless fits(at, 2)
			return true unless d.u16(at) == 1
			return false unless array16(at + 2, 4)
			for let i = 0; i < d.u16(at + 2); i++ {
				return false unless offset32(at + 4 + i * 4, at, (c int) => self.coverage(c))
			}
			return true
		}

		def itemVariationStore(at int) bool {
			return false unless fits(at, 8) && d.u16(at) == 1
			let regions = (r int) => self.fits(r, 4) && self.array(r + 4, d.u16(r) * d.u16(r + 2), 6)
			return false unless offset32(at + 2, at, regions)
			return false unless array16(at + 6, 4)
			for let i = 0; i < d.u16(at + 6); i++ {
				return false unless offset32(at + 8 + i * 4, at, (v int) => self.varData(v))
			}
			return true
		}

		def varData(at int) bool {
			return false unless fits(at, 6) && array16(at + 4, 2)
			let items = d.u16(at)
			let sizes = d.u16(at + 2)
			let regions = d.u16(at + 4)
			let words = sizes & 0x7FFF
			return false when words > regions
			let long = sizes & 0x8000 != 0
			let row = long ?? (words * 4 + (regions - words) * 2, words * 2 + (regions - words))
			return range(at + 6 + regions * 2, items * row)
		}
	}

	// Font table sizes (GDEF, GSUB, GPOS) of fonts whose GDEF HarfBuzz
	// ignores: they mark glyphs wrongly in ways that break shaping.
	let gdefBlocklist = [442, 2874, 42038, 430, 2874, 40662, 442, 2874, 39116, 430, 2874, 39374, 490, 3046, 41638, 478, 3046, 41902, 898, 12554, 46470, 910, 12566, 47732, 928, 23298, 59332, 940, 23310, 60732, 964, 23836, 60072, 976, 23832, 61456, 994, 24474, 60336, 1006, 24470, 61740, 1006, 24576, 61346, 1018, 24572, 62828, 1006, 24576, 61352, 1018, 24572, 62834, 832, 7324, 47162, 844, 7302, 45474, 180, 13054, 7254, 192, 12638, 7254, 192, 12690, 7254, 188, 248, 3852, 188, 264, 3426, 1058, 47032, 11818, 1046, 47030, 12600, 1058, 71796, 16770, 1046, 71790, 17862, 1046, 71788, 17112, 1058, 71794, 17514, 1330, 109904, 57938, 1330, 109904, 58972, 1004, 59092, 14836, 588, 5078, 14418, 588, 5078, 14238, 894, 17162, 33960, 894, 17154, 34472, 816, 7868, 17052, 816, 7868, 17138]

	// The layout tables of a face as HarfBuzz would use them: each dropped
	// when it does not validate, GDEF also when the font is blocklisted.
	def sanitizeLayout(gsub byte[], gpos byte[], gdef byte[]) (byte[], byte[], byte[]) {
		let blank = byte[]
		let s = gsub.len() > 0 && new Sanitizer(new Data(gsub)).layout(false) ?? (gsub, blank)
		let p = gpos.len() > 0 && new Sanitizer(new Data(gpos), true).layout(true) ?? (gpos, blank)
		let g = gdef.len() > 0 && new Sanitizer(new Data(gdef)).gdef() ?? (gdef, blank)
		for let i = 0; i + 2 < gdefBlocklist.len(); i += 3 {
			if gdef.len() == gdefBlocklist[i] && s.len() == gdefBlocklist[i + 1] && p.len() == gdefBlocklist[i + 2] {
				g = blank
				break
			}
		}
		return (s, p, g)
	}
}
