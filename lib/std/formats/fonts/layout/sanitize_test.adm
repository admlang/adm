partial module std.formats.fonts.layout {
	use std.testing

	// Hand-built tables; outcomes are what HarfBuzz 14.1's sanitizer does
	// with the same bytes.
	check "Layout sanitizer" {
		def bytesOf(words int[]) byte[] {
			let out byte[]
			for let (_, w) in words {
				out.push(byte(w >> 8 & 0xFF))
				out.push(byte(w & 0xFF))
			}
			return out
		}

		// GSUB 1.0 with one single-substitution lookup whose coverage sits at
		// `coverage` from its subtable (6 is right).
		def gsub(coverage int) byte[] {
			return bytesOf([
				1, 0, 10, 12, 14, // header
				0, // script list
				0, // feature list
				1, 4, // lookup list
				1, 0, 1, 8, // lookup
				1, coverage, 1, // single substitution format 1
				1, 1, 5 // coverage: glyph 5
			])
		}

		@test()
		def keepsValidTables() !none {
			let (sub, pos, gdef) = sanitizeLayout(gsub(6), byte[], byte[])
			assert sub.len() == 38 // kept whole
			assert new LayoutTable(sub).lookupCount() == 1 // lookup readable
			assert pos.len() == 0 && gdef.len() == 0 // absent stay absent
		}

		@test()
		def dropsTablesWithBadOffsets() !none {
			let (sub, _, _) = sanitizeLayout(gsub(0x7FF0), byte[], byte[])
			assert sub.len() == 0 // coverage past the end drops the table
			let (cut, _, _) = sanitizeLayout(gsub(6)[0:36], byte[], byte[])
			assert cut.len() == 0 // truncated coverage drops it too
		}

		@test()
		def keepsUnknownMajorVersions() !none {
			// HarfBuzz accepts a table of a future major version and reads it
			// as empty.
			let future = gsub(6)
			future[1] = byte(2)
			let (sub, _, _) = sanitizeLayout(future, byte[], byte[])
			assert new LayoutTable(sub).lookupCount() == 0 // nothing read
		}

		@test()
		def dropsBlocklistedGdef() !none {
			// A GDEF of 442 bytes beside a 2874-byte GSUB and a 42038-byte GPOS
			// is one HarfBuzz ignores.
			let gdef = bytesOf([1, 0, 0, 0, 0, 0])
			gdef.len(442)
			let sub byte[]
			sub.len(2874)
			let pos byte[]
			pos.len(42038)
			let (_, _, blocked) = sanitizeLayout(sub, pos, gdef)
			assert blocked.len() == 0 // blocklisted
			let (_, _, kept) = sanitizeLayout(sub, pos[0:42000], gdef)
			assert kept.len() == 442 // other sizes keep it
		}
	}
}
