internal partial module std.formats.fonts.layout {
	use std.text.unicode

	// Buffer flags a caller passes: the text starts or ends a paragraph.
	const (
		flagBeginningOfText = 1
		flagEndOfText       = 2
	)

	// A feature the caller asked for: its value (0 off, 1 on, n the nth
	// alternate) over the clusters [start, end) of the text, the whole text
	// when start is 0 and end -1.
	struct UserFeature {
		tag   string
		value int
		start int
		end   int
	}

	// The on/off features of a map as whole-text features, then `extra`.
	def userFeatureList(features map<string, bool>, extra UserFeature[] = UserFeature[]) UserFeature[] {
		let out UserFeature[]
		for let (tag, on) in features {
			out.push(UserFeature{tag: tag, value: on ?? (1, 0), start: 0, end: -1})
		}
		for let (_, f) in extra {
			out.push(f)
		}
		return out
	}

	def isGlobalFeature(f UserFeature) bool {
		return f.start == 0 && f.end == -1
	}

	// Everything fixed for one shaping call: the map, the shaper and which
	// positioning steps run.
	type Plan {
		font                             ShapeFont
		direction                        int
		script                           string
		language                         string
		shaper                           Shaper
		m                                Map
		userFeatures                     UserFeature[]
		fracMask                         int
		numrMask                         int
		dnomMask                         int
		hasFrac                          bool
		rtlmMask                         int
		kernMask                         int
		hasVert                          bool
		hasGposMark                      bool
		applyGpos                        bool
		applyKern                        bool
		// AAT: `morx` replaces GSUB, `kerx` GPOS; `trak` adds tracking.
		applyMorx                        bool
		applyKerx                        bool
		applyTrak                        bool
		// Subtable flags of each `morx` chain, per range of clusters.
		morxRanges                       AatRanges[]
		zeroMarks                        bool
		fallbackGlyphClasses             bool
		adjustMarkPositioningWhenZeroing bool
		fallbackMarkPositioning          bool

		def new(font ShapeFont, direction int, script string, language string, userFeatures UserFeature[]) {
			self.font = font
			self.direction = direction
			self.script = script
			self.language = language
			self.userFeatures = userFeatures

			let builder = new MapBuilder(font.gsub, font.gpos, scriptTags(script), languageTags(language))
			shaper = chooseShaper(script, builder.chosenScript[0])
			// `morx` serves vertical text only when there is no GSUB.
			applyMorx = font.morx.hasData() && (isHorizontal(direction) || font.gsub.isEmpty())
			// Script shapers would fight the font's own rules.
			shaper = new Shaper(shaperDumber) when applyMorx && shaper.kind != shaperDefault
			collectFeatures(builder)
			m = builder.compile()

			fracMask = m.oneMask("frac")
			numrMask = m.oneMask("numr")
			dnomMask = m.oneMask("dnom")
			hasFrac = fracMask != 0 || (numrMask != 0 && dnomMask != 0)
			rtlmMask = m.oneMask("rtlm")
			hasVert = m.oneMask("vert") != 0
			let kernTag = isHorizontal(direction) ?? ("kern", "vkrn")
			kernMask = m.maskOf(kernTag)
			let hasGposKern = m.featureIndex(1, kernTag) >= 0
			let disableGpos = shaper.gposTag != "" && shaper.gposTag != m.chosenScript[1]
			fallbackGlyphClasses = !font.gdef.hasGlyphClasses()
			if applyMorx {
				let morx = font.morx
				morxRanges = morx.chainRanges(morx.settings(userFeatures), language)
			}

			// Positioning: GPOS, `kerx` or `kern`. GPOS wins over `kerx` only
			// in fonts that also use GSUB.
			let hasKerx = font.kerx.hasData()
			let hasGsub = !applyMorx && !font.gsub.isEmpty()
			let hasGpos = !disableGpos && !font.gpos.isEmpty()
			if hasKerx && !(hasGsub && hasGpos) {
				applyKerx = true
			} else if hasGpos {
				applyGpos = true
			}
			if !applyKerx && (!hasGposKern || !applyGpos) {
				if hasKerx {
					applyKerx = true
				} else if font.kernTable.hasData() {
					// Not every shaper applies the legacy table.
					applyKern = shaper.fallbackPosition
				}
			}
			zeroMarks = shaper.zeroMarks != zeroMarksNone && !applyKerx && (!applyKern || !font.kernTable.hasStateMachine())
			hasGposMark = m.oneMask("mark") != 0
			adjustMarkPositioningWhenZeroing = !applyGpos && !applyKerx && (!applyKern || !font.kernTable.hasCrossStream())
			fallbackMarkPositioning = adjustMarkPositioningWhenZeroing && shaper.fallbackPosition
			// Emoji sequences in `morx` fonts expect marks where they are.
			adjustMarkPositioningWhenZeroing = false when applyMorx
			applyTrak = font.trak.hasData() && font.hasStat
		}

		internal def collectFeatures(m MapBuilder) {
			m.isSimple = true
			m.enableFeature("rvrn")
			m.addGsubPause()
			if direction == dirLTR {
				m.enableFeature("ltra")
				m.enableFeature("ltrm")
			} else if direction == dirRTL {
				m.enableFeature("rtla")
				m.addFeature("rtlm")
			}
			// Automatic fractions.
			m.addFeature("frac")
			m.addFeature("numr")
			m.addFeature("dnom")
			m.enableFeature("rand", featRandom, mapMaxValue)
			m.enableFeature("Harf")
			m.enableFeature("HARF")
			m.isSimple = false when shaper.kind != shaperDefault
			shaperCollectFeatures(self, m)
			m.enableFeature("Buzz")
			m.enableFeature("BUZZ")
			for let (_, tag) in ["abvm", "blwm", "ccmp", "locl"] {
				m.addFeature(tag, featGlobal)
			}
			m.addFeature("mark", featGlobalManualJoiners)
			m.addFeature("mkmk", featGlobalManualJoiners)
			m.addFeature("rlig", featGlobal)
			if isHorizontal(direction) {
				for let (_, tag) in ["calt", "clig", "curs", "dist"] {
					m.addFeature(tag, featGlobal)
				}
				m.addFeature("kern", featGlobalHasFallback)
				m.addFeature("liga", featGlobal)
				m.addFeature("rclt", featGlobal)
			} else {
				m.enableFeature("vert", featGlobalSearch)
			}
			m.isSimple = false when userFeatures.len() > 0
			for let (_, f) in userFeatures {
				m.addFeature(f.tag, isGlobalFeature(f) ?? (featGlobal, 0), f.value)
			}
			shaperOverrideFeatures(self, m)
		}

		// Runs `morx`, or else the GSUB stages.
		def substitute(b Buffer) {
			if applyMorx {
				font.morx.apply(self, b, morxRanges)
			} else {
				applyStages(0, b)
			}
		}

		def position(b Buffer) {
			if applyGpos {
				applyStages(1, b)
			} else if applyKerx {
				font.kerx.apply(self, b)
			}
			font.kernTable.apply(self, b) when applyKern
			font.trak.apply(b, font.ptem) when applyTrak
		}

		internal def applyStages(t int, b Buffer) {
			let table = t == 0 ?? (font.gsub, font.gpos)
			let ls = m.lookups[t]
			let c = new ApplyContext(t, table, b, font.gdef, font.coords)
			let i = 0
			for let (s, end) in ls.stageEnd {
				for i < end {
					c.lookupIndex = ls.index[i]
					c.useLookupMask(ls.mask[i])
					c.autoZWJ = ls.autoZWJ[i]
					c.autoZWNJ = ls.autoZWNJ[i]
					c.random = ls.random[i]
					c.perSyllable = ls.perSyllable[i]
					c.initIters()
					c.applyString(ls.index[i])
					i++
				}
				let pause = ls.stagePause[s]
				// A pause may rewrite glyphs: their GDEF classes follow.
				if pause(b) && c.hasGlyphClasses {
					for let k = 0; k < b.len; k++ {
						b.info.gprops[k] = b.info.gprops[k] & propsPreserve | font.gdef.glyphProps(b.info.glyph[k])
					}
				}
			}
		}
	}

	// Right-to-left scripts, by ISO 15924 code.
	let rtlScripts = ["Arab", "Hebr", "Syrc", "Thaa", "Cprt", "Khar", "Phnx", "Nkoo", "Lydi", "Avst", "Armi", "Phli", "Prti", "Sarb", "Orkh", "Samr", "Mand", "Merc", "Mero", "Mani", "Mend", "Nbat", "Narb", "Palm", "Phlp", "Hatr", "Adlm", "Rohg", "Sogo", "Sogd", "Elym", "Chrs", "Yezi", "Ougr", "Gara", "Sidt"]

	// The direction a script is written in horizontally: 0 when it may go
	// either way (runes, Old Italic, Old Hungarian, Tifinagh).
	def scriptDirection(script string) int {
		return dirRTL when rtlScripts.indexOf(script) >= 0
		return 0 when script := "Hung" || "Ital" || "Runr" || "Tfng"
		return dirLTR
	}

	// Shapes `text` with `font`: code points to positioned glyphs. `script`
	// (ISO 15924) and `direction` are guessed from the text when empty or 0.
	def shapeText(font ShapeFont, text string, script string, language string, direction int, features map<string, bool>, flags int, extra UserFeature[] = UserFeature[], concat bool = false) Buffer {
		let b = new Buffer()
		b.produceConcat = concat
		let at = 0
		for let (_, ch) in text {
			let cp = int(ch)
			b.add(cp, at)
			at += cp < 0x80 ?? (1, cp < 0x800 ?? (2, cp < 0x10000 ?? (3, 4)))
		}
		shapeBuffer(font, b, script, language, direction, features, flags, extra)
		return b
	}

	// Shapes a buffer of code points in place.
	def shapeBuffer(font ShapeFont, b Buffer, script string, language string, direction int, features map<string, bool>, flags int, extra UserFeature[] = UserFeature[]) {
		if script == "" {
			for let i = 0; i < b.len; i++ {
				let s = unicode.script(char(b.info.glyph[i]))
				if s != "Zyyy" && s != "Zinh" && s != "Zzzz" {
					script = s
					break
				}
			}
		}
		if direction == 0 {
			direction = scriptDirection(script)
			direction = dirLTR when direction == 0
		}
		b.script = script
		b.language = language
		b.direction = direction

		let p = new Plan(font, direction, script, language, userFeatureList(features, extra))
		let target = direction

		b.enter()
		b.resetMasks(p.m.globalMask)
		setAllUnicodeProps(b)
		insertDottedCircle(p, b, flags)
		formClusters(b)
		ensureNativeDirection(b)
		shaperPreprocessText(p, b)

		// Substitution.
		rotateChars(p, b, target)
		normalizeText(p, b)
		setupMasks(p, b)
		recategorizeMarks(b) when p.fallbackMarkPositioning
		for let i = 0; i < b.len; i++ {
			b.info.glyph[i] = b.info.aux[i]
		}
		substituteStart(p, b)
		p.substitute(b)
		removeDeletedGlyphs(b) when p.applyMorx && p.applyGpos

		// Positioning.
		b.clearPositions()
		positionDefault(p, b)
		positionPlan(p, b)
		b.reverse() when isBackward(b.direction)

		// After substitution.
		removeDeletedGlyphs(b) when p.applyMorx && !p.applyGpos
		hideDefaultIgnorables(p, b)
		shaperPostprocessGlyphs(p, b)
		b.propagateFlags()
		b.direction = target
	}

	def setAllUnicodeProps(b Buffer) {
		let info = b.info
		let i = 0
		for i < b.len {
			setUnicodeProps(b, info, i)
			let u = info.glyph[i]
			if u >= 0x80 {
				let cat = info.category(i)
				if !(isLetterCategory(cat) && cat != catLm) && cat != catZs {
					if cat == catSk && u >= 0x1F3FB && u <= 0x1F3FF {
						// Skin tone modifiers join the emoji before them.
						info.uprops[i] |= upropsContinuation
						b.scratch |= scratchContinuations
					} else if i > 0 && isRegionalIndicator(u) {
						if isRegionalIndicator(info.glyph[i - 1]) && !info.isContinuation(i - 1) {
							info.uprops[i] |= upropsContinuation
							b.scratch |= scratchContinuations
						}
					} else if info.isZWJ(i) {
						info.uprops[i] |= upropsContinuation
						b.scratch |= scratchContinuations
						if i + 1 < b.len && unicode.isExtendedPictographic(char(info.glyph[i + 1])) {
							i++
							setUnicodeProps(b, info, i)
							info.uprops[i] |= upropsContinuation
						}
					} else if (u >= 0xFF9E && u <= 0xFF9F) || (u >= 0xE0020 && u <= 0xE007F) {
						info.uprops[i] |= upropsContinuation
						b.scratch |= scratchContinuations
					} else if u == 0x2044 {
						b.scratch |= scratchFractionSlash
					}
				}
			}
			i++
		}
	}

	def isRegionalIndicator(u int) bool {
		return u >= 0x1F1E6 && u <= 0x1F1FF
	}

	// A mark at the start of a paragraph gets a dotted circle to sit on.
	def insertDottedCircle(p Plan, b Buffer, flags int) {
		return when flags & flagBeginningOfText == 0 || b.len == 0 || !b.info.isUnicodeMark(0)
		return when !p.font.hasGlyph(0x25CC)
		b.clearOutput()
		b.idx = 0
		let tmp = new Infos()
		tmp.size(1)
		tmp.glyph[0] = 0x25CC
		tmp.cluster[0] = b.info.cluster[0]
		tmp.mask[0] = b.info.mask[0]
		setUnicodeProps(b, tmp, 0)
		b.outputInfo(tmp, 0)
		b.sync()
	}

	// Makes every grapheme one cluster.
	def formClusters(b Buffer) {
		return when b.scratch & scratchContinuations == 0
		let start = 0
		for start < b.len {
			let end = b.groupEnd(start, (x int, y int) => b.info.isContinuation(y))
			b.mergeClusters(start, end)
			start = end
		}
	}

	// Reverses text shaped against its script's direction (RTL text in an
	// LTR buffer), keeping graphemes in order.
	def ensureNativeDirection(b Buffer) {
		let direction = b.direction
		let horiz = scriptDirection(b.script)
		if horiz == dirRTL && direction == dirLTR {
			// Digits and flags alone keep the buffer's direction.
			let foundNumber = false
			let foundLetter = false
			let foundRI = false
			for let i = 0; i < b.len; i++ {
				let cat = b.info.category(i)
				if isLetterCategory(cat) {
					foundLetter = true
					break
				} else if cat == catNd {
					foundNumber = true
				} else if isRegionalIndicator(b.info.glyph[i]) {
					foundRI = true
				}
			}
			horiz = dirLTR when (foundNumber || foundRI) && !foundLetter
		}
		if (isHorizontal(direction) && direction != horiz && horiz != 0) || (isVertical(direction) && direction != dirTTB) {
			b.reverseGroups((x int, y int) => b.info.isContinuation(y), false)
			b.direction = direction ^ 1
		}
	}

	// Mirrors characters in right-to-left text where the font has the
	// mirror; otherwise `rtlm` may. Vertical text without a `vert` feature
	// takes the vertical presentation forms of punctuation.
	def rotateChars(p Plan, b Buffer, target int) {
		if isBackward(target) {
			for let i = 0; i < b.len; i++ {
				let m = unicode.mirror(char(b.info.glyph[i]))
				if m is char && p.font.hasGlyph(int(m)) {
					b.info.glyph[i] = int(m)
				} else {
					b.info.mask[i] |= p.rtlmMask
				}
			}
		}
		if isVertical(target) && !p.hasVert {
			for let i = 0; i < b.len; i++ {
				let v = verticalForm(b.info.glyph[i])
				b.info.glyph[i] = v when v != b.info.glyph[i] && p.font.hasGlyph(v)
			}
		}
	}

	// Punctuation with a vertical presentation form (U+FE10..FE48).
	let verticalFrom = [0x2013, 0x2014, 0x2025, 0x2026, 0x3001, 0x3002, 0x3008, 0x3009, 0x300A, 0x300B, 0x300C, 0x300D, 0x300E, 0x300F, 0x3010, 0x3011, 0x3014, 0x3015, 0x3016, 0x3017, 0xFE4F, 0xFF01, 0xFF08, 0xFF09, 0xFF0C, 0xFF1A, 0xFF1B, 0xFF1F, 0xFF3B, 0xFF3D, 0xFF3F, 0xFF5B, 0xFF5D]
	let verticalTo = [0xFE32, 0xFE31, 0xFE30, 0xFE19, 0xFE11, 0xFE12, 0xFE3F, 0xFE40, 0xFE3D, 0xFE3E, 0xFE41, 0xFE42, 0xFE43, 0xFE44, 0xFE3B, 0xFE3C, 0xFE39, 0xFE3A, 0xFE17, 0xFE18, 0xFE34, 0xFE15, 0xFE35, 0xFE36, 0xFE10, 0xFE13, 0xFE14, 0xFE16, 0xFE47, 0xFE48, 0xFE33, 0xFE37, 0xFE38]

	def verticalForm(u int) int {
		let i = verticalFrom.indexOf(u)
		return i < 0 ?? (u, verticalTo[i])
	}

	def setupMasks(p Plan, b Buffer) {
		setupFractionMasks(p, b)
		shaperSetupMasks(p, b)
		// Features over part of the text set their bits on its clusters.
		for let (_, f) in p.userFeatures {
			continue when isGlobalFeature(f)
			let mask = p.m.maskOf(f.tag)
			b.setMasks(f.value << p.m.shiftOf(f.tag), mask, f.start, f.end < 0 ?? (0x7FFFFFFF, f.end))
		}
	}

	// Digits around U+2044 FRACTION SLASH take numr/dnom/frac.
	def setupFractionMasks(p Plan, b Buffer) {
		return when b.scratch & scratchFractionSlash == 0 || !p.hasFrac
		let pre = 0
		let post = 0
		if isForward(b.direction) {
			pre = p.numrMask | p.fracMask
			post = p.fracMask | p.dnomMask
		} else {
			pre = p.fracMask | p.dnomMask
			post = p.numrMask | p.fracMask
		}
		let i = 0
		for i < b.len {
			if b.info.glyph[i] == 0x2044 {
				let start = i
				let end = i + 1
				for start > 0 && b.info.category(start - 1) == catNd {
					start--
				}
				for end < b.len && b.info.category(end) == catNd {
					end++
				}
				if start == i || end == i + 1 {
					// A lone slash: what joins on either side could make it a
					// fraction.
					b.unsafeToConcat(start, start + 1) when start == i
					b.unsafeToConcat(end - 1, end) when end == i + 1
				} else {
					b.unsafeToBreak(start, end)
					for let j = start; j < i; j++ {
						b.info.mask[j] |= pre
					}
					b.info.mask[i] |= p.fracMask
					for let j = i + 1; j < end; j++ {
						b.info.mask[j] |= post
					}
					i = end
					continue
				}
			}
			i++
		}
	}

	// Glyph classes from GDEF, or guessed from Unicode when it has none.
	def substituteStart(p Plan, b Buffer) {
		let gdef = p.font.gdef
		for let i = 0; i < b.len; i++ {
			b.info.gprops[i] = gdef.glyphProps(b.info.glyph[i])
			b.info.lig[i] = 0
		}
		if p.fallbackGlyphClasses {
			for let i = 0; i < b.len; i++ {
				let mark = b.info.category(i) == catMn && !b.info.isDefaultIgnorable(i)
				b.info.gprops[i] = mark ?? (propsMark, propsBase)
			}
		}
	}

	def positionDefault(p Plan, b Buffer) {
		if isHorizontal(b.direction) {
			for let i = 0; i < b.len; i++ {
				b.pos.xAdvance[i] = p.font.advance(b.info.glyph[i])
			}
		} else {
			// Vertical: advance down, positions relative to the vertical origin.
			for let i = 0; i < b.len; i++ {
				let g = b.info.glyph[i]
				b.pos.yAdvance[i] = p.font.vAdvance(g)
				let (x, y) = p.font.vOrigin(g)
				b.pos.xOffset[i] -= x
				b.pos.yOffset[i] -= y
			}
		}
		fallbackSpaces(p, b) when b.scratch & scratchSpaceFallback != 0
	}

	def positionPlan(p Plan, b Buffer) {
		let adjustOffsets = p.adjustMarkPositioningWhenZeroing && isForward(b.direction)
		for let i = 0; i < b.len; i++ {
			b.pos.attachChain[i] = 0
			b.pos.attachType[i] = 0
		}
		zeroMarkWidths(b, adjustOffsets) when p.zeroMarks && p.shaper.zeroMarks == zeroMarksEarly
		p.position(b)
		zeroMarkWidths(b, adjustOffsets) when p.zeroMarks && p.shaper.zeroMarks == zeroMarksLate
		zeroWidthDefaultIgnorables(b)
		propagateAttachments(b)
		fallbackMarkPosition(p, b, adjustOffsets) when p.fallbackMarkPositioning
	}

	def zeroMarkWidths(b Buffer, adjustOffsets bool) {
		for let i = 0; i < b.len; i++ {
			if b.info.isMark(i) {
				if adjustOffsets {
					b.pos.xOffset[i] -= b.pos.xAdvance[i]
					b.pos.yOffset[i] -= b.pos.yAdvance[i]
				}
				b.pos.xAdvance[i] = 0
				b.pos.yAdvance[i] = 0
			}
		}
	}

	def zeroWidthDefaultIgnorables(b Buffer) {
		return when b.scratch & scratchDefaultIgnorables == 0
		for let i = 0; i < b.len; i++ {
			if b.info.isDefaultIgnorable(i) {
				b.pos.xAdvance[i] = 0
				b.pos.yAdvance[i] = 0
				if isHorizontal(b.direction) {
					b.pos.xOffset[i] = 0
				} else {
					b.pos.yOffset[i] = 0
				}
			}
		}
	}

	// Default ignorables the font has no glyph for become invisible space
	// glyphs, or disappear when it has no space.
	def hideDefaultIgnorables(p Plan, b Buffer) {
		return when b.scratch & scratchDefaultIgnorables == 0
		let invisible = b.invisible >= 0 ?? (b.invisible, p.font.glyph(0x20))
		if invisible >= 0 {
			for let i = 0; i < b.len; i++ {
				b.info.glyph[i] = invisible when b.info.isDefaultIgnorable(i)
			}
		} else {
			b.deleteWhere((i int) => b.info.isDefaultIgnorable(i))
		}
	}
}
