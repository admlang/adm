internal partial module std.formats.fonts.layout {
	// Script shapers. Each adds features and pauses, classifies and reorders
	// text, and says how marks are normalized and positioned.
	const (
		shaperDefault = 0
		// No features beyond the defaults and no normalization tweaks: scripts
		// shaped purely by the font.
		shaperDumber  = 1
	)

	// When mark advances are zeroed: never, from GDEF before GPOS, or after.
	const (
		zeroMarksNone  = 0
		zeroMarksEarly = 1
		zeroMarksLate  = 2
	)

	// The shaper a plan uses, with its fixed properties.
	type Shaper {
		kind             int
		normalization    int
		zeroMarks        int
		fallbackPosition bool
		// GPOS script tag the shaper needs; GPOS is skipped when the font
		// chose another. Empty for any.
		gposTag          string

		def new(kind int) {
			self.kind = kind
			normalization = normalizeAuto
			zeroMarks = zeroMarksLate
			fallbackPosition = true
			if kind == shaperDumber {
				normalization = normalizeNone
				zeroMarks = zeroMarksNone
				fallbackPosition = false
			}
		}
	}

	// The shaper for a script, given the GSUB script tag the font chose.
	def chooseShaper(script string, chosenGsubScript string) Shaper {
		return new Shaper(shaperDefault)
	}

	// Features the shaper adds, in stages.
	def shaperCollectFeatures(p Plan, m MapBuilder) {}

	def shaperOverrideFeatures(p Plan, m MapBuilder) {}

	// Runs before normalization, on code points.
	def shaperPreprocessText(p Plan, b Buffer) {}

	// Sets per-entry masks after normalization.
	def shaperSetupMasks(p Plan, b Buffer) {}

	// Reorders marks [start, end) after canonical ordering.
	def reorderMarks(p Plan, b Buffer, start int, end int) {}

	// A shaper's own one-step decomposition: (handled, a, b).
	def shaperDecompose(p Plan, ab int) (bool, int, int) {
		return (false, 0, 0)
	}

	// A shaper's own composition: (handled, composite or -1).
	def shaperCompose(p Plan, a int, b int) (bool, int) {
		return (false, -1)
	}

	// Runs after GSUB, on glyphs.
	def shaperPostprocessGlyphs(p Plan, b Buffer) {}
}
