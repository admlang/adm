internal partial module std.formats.fonts.layout {
	// Whether no rule of the font reaches its space glyph: no GSUB or GPOS
	// lookup names it in any position (a coverage, a class its rules match, a
	// glyph of a sequence, the second glyph of a pair a value is given for),
	// none skips base glyphs (it could match across one), and the font has no
	// AAT tables or legacy `kern` table, whose machines and pairs are not
	// looked into. Then text cut after its spaces shapes, piece by piece, to
	// what it shapes to whole, which lets a caller shape it a word at a time
	// (Blink's word cache asks HarfBuzz the same). A font without a space
	// glyph does not qualify.
	def spacesStandApart(font ShapeFont) bool {
		let space = font.glyph(0x20)
		return false when space < 0
		return false when font.morx.hasData() || font.kerx.hasData() || font.kern.len() > 0
		return !tableNames(font.gsub, space, true) && !tableNames(font.gpos, space, false)
	}

	// Whether any lookup of the table names glyph `g` or skips base glyphs.
	internal def tableNames(lt LayoutTable, g int, substitution bool) bool {
		let d = lt.data()
		for let i = 0; i < lt.lookupCount(); i++ {
			return true when lt.lookupProps(i) & flagIgnoreBase != 0
			let (offsets, types) = lt.subtables(i, substitution ?? (7, 9))
			for let (s, sub) in offsets {
				return true when subtableNames(d, sub, types[s], substitution, g)
			}
		}
		return false
	}

	// Whether a subtable of lookup type `kind` names glyph `g`; a format this
	// does not know counts as naming it.
	internal def subtableNames(d Data, sub int, kind int, substitution bool, g int) bool {
		let format = d.u16(sub)
		if substitution {
			match kind {
				case 1, 2, 3:
					return covers(d, sub, 2, g)
				case 4:
					return covers(d, sub, 2, g) || ligatureNames(d, sub, g)
				case 5:
					return contextNames(d, sub, format, g)
				case 6:
					return chainNames(d, sub, format, g)
				case 8:
					return reverseChainNames(d, sub, g)
				default:
					return true
			}
		}
		match kind {
			case 1, 3:
				return covers(d, sub, 2, g)
			case 2:
				return covers(d, sub, 2, g) || pairNames(d, sub, format, g)
			case 4, 5, 6:
				return covers(d, sub, 2, g) || covers(d, sub, 4, g)
			case 7:
				return contextNames(d, sub, format, g)
			case 8:
				return chainNames(d, sub, format, g)
			default:
				return true
		}
	}

	// Whether the Coverage table at the offset stored at `sub + at` (from
	// `sub`) holds `g`; an absent table holds nothing.
	internal def covers(d Data, sub int, at int, g int) bool {
		let off = d.u16(sub + at)
		return off != 0 && d.coverage(sub + off, g) >= 0
	}

	// A ligature's components after the first.
	internal def ligatureNames(d Data, sub int, g int) bool {
		for let k = 0; k < d.u16(sub + 4); k++ {
			let set = sub + d.u16(sub + 6 + k * 2)
			for let l = 0; l < d.u16(set); l++ {
				let lig = set + d.u16(set + 2 + l * 2)
				for let c = 1; c < d.u16(lig + 2); c++ {
					return true when d.u16(lig + 2 + c * 2) == g
				}
			}
		}
		return false
	}

	// Whether `count` u16 values at `at` hold `value`.
	internal def holds(d Data, at int, count int, value int) bool {
		for let i = 0; i < count; i++ {
			return true when d.u16(at + i * 2) == value
		}
		return false
	}

	// Context (SequenceContext) formats 1-3: the glyphs, the classes of the
	// glyph's class, or the coverages its rules match after the first glyph.
	internal def contextNames(d Data, sub int, format int, g int) bool {
		match format {
			case 1:
				return true when covers(d, sub, 2, g)
				for let k = 0; k < d.u16(sub + 4); k++ {
					let set = d.u16(sub + 6 + k * 2)
					continue when set == 0
					let setAt = sub + set
					for let r = 0; r < d.u16(setAt); r++ {
						let rule = setAt + d.u16(setAt + 2 + r * 2)
						return true when holds(d, rule + 4, d.u16(rule) - 1, g)
					}
				}
				return false
			case 2:
				return true when covers(d, sub, 2, g)
				let own = d.classOf(sub + d.u16(sub + 4), g)
				for let k = 0; k < d.u16(sub + 6); k++ {
					let set = d.u16(sub + 8 + k * 2)
					continue when set == 0
					let setAt = sub + set
					for let r = 0; r < d.u16(setAt); r++ {
						let rule = setAt + d.u16(setAt + 2 + r * 2)
						return true when holds(d, rule + 4, d.u16(rule) - 1, own)
					}
				}
				return false
			case 3:
				for let i = 0; i < d.u16(sub + 2); i++ {
					return true when covers(d, sub, 6 + i * 2, g)
				}
				return false
			default:
				return true
		}
	}

	// Chained context formats 1-3: backtrack, input after the first glyph and
	// lookahead alike.
	internal def chainNames(d Data, sub int, format int, g int) bool {
		match format {
			case 1:
				return true when covers(d, sub, 2, g)
				for let k = 0; k < d.u16(sub + 4); k++ {
					let set = d.u16(sub + 6 + k * 2)
					continue when set == 0
					let setAt = sub + set
					for let r = 0; r < d.u16(setAt); r++ {
						let rule = setAt + d.u16(setAt + 2 + r * 2)
						let back = d.u16(rule)
						return true when holds(d, rule + 2, back, g)
						let input = rule + 2 + back * 2
						let inputs = d.u16(input)
						return true when holds(d, input + 2, inputs - 1, g)
						let ahead = input + 2 + (inputs - 1).max(0) * 2
						return true when holds(d, ahead + 2, d.u16(ahead), g)
					}
				}
				return false
			case 2:
				return true when covers(d, sub, 2, g)
				let backClass = d.classOf(sub + d.u16(sub + 4), g)
				let inputClass = d.classOf(sub + d.u16(sub + 6), g)
				let aheadClass = d.classOf(sub + d.u16(sub + 8), g)
				for let k = 0; k < d.u16(sub + 10); k++ {
					let set = d.u16(sub + 12 + k * 2)
					continue when set == 0
					let setAt = sub + set
					for let r = 0; r < d.u16(setAt); r++ {
						let rule = setAt + d.u16(setAt + 2 + r * 2)
						let back = d.u16(rule)
						return true when holds(d, rule + 2, back, backClass)
						let input = rule + 2 + back * 2
						let inputs = d.u16(input)
						return true when holds(d, input + 2, inputs - 1, inputClass)
						let ahead = input + 2 + (inputs - 1).max(0) * 2
						return true when holds(d, ahead + 2, d.u16(ahead), aheadClass)
					}
				}
				return false
			case 3:
				let back = d.u16(sub + 2)
				for let i = 0; i < back; i++ {
					return true when covers(d, sub, 4 + i * 2, g)
				}
				let input = 4 + back * 2
				let inputs = d.u16(sub + input)
				for let i = 0; i < inputs; i++ {
					return true when covers(d, sub, input + 2 + i * 2, g)
				}
				let ahead = input + 2 + inputs * 2
				for let i = 0; i < d.u16(sub + ahead); i++ {
					return true when covers(d, sub, ahead + 2 + i * 2, g)
				}
				return false
			default:
				return true
		}
	}

	// Reverse chained single substitution: its coverage, backtrack and lookahead.
	internal def reverseChainNames(d Data, sub int, g int) bool {
		return true when covers(d, sub, 2, g)
		let back = d.u16(sub + 4)
		for let i = 0; i < back; i++ {
			return true when covers(d, sub, 6 + i * 2, g)
		}
		let ahead = 6 + back * 2
		for let i = 0; i < d.u16(sub + ahead); i++ {
			return true when covers(d, sub, ahead + 2 + i * 2, g)
		}
		return false
	}

	// Pair positioning: format 1's second glyphs; format 2's second-glyph
	// class when any first class gives it a value.
	internal def pairNames(d Data, sub int, format int, g int) bool {
		let (first, second) = (d.u16(sub + 4), d.u16(sub + 6))
		let (size1, size2) = (valueSize(first), valueSize(second))
		match format {
			case 1:
				for let k = 0; k < d.u16(sub + 8); k++ {
					let set = sub + d.u16(sub + 10 + k * 2)
					let record = 2 + size1 + size2
					for let p = 0; p < d.u16(set); p++ {
						return true when d.u16(set + 2 + p * record) == g
					}
				}
				return false
			case 2:
				let own = d.classOf(sub + d.u16(sub + 10), g)
				let (classes1, classes2) = (d.u16(sub + 12), d.u16(sub + 14))
				let record = size1 + size2
				for let c1 = 0; c1 < classes1; c1++ {
					let at = sub + 16 + (c1 * classes2 + own) * record
					for let b = 0; b < record; b += 2 {
						return true when d.u16(at + b) != 0
					}
				}
				return false
			default:
				return true
		}
	}

	// The bytes of a ValueRecord in `format`: two per bit set.
	internal def valueSize(format int) int {
		let n = 0
		for let bit = 0; bit < 8; bit++ {
			n += 2 when format & (1 << bit) != 0
		}
		return n
	}
}
