internal partial module std.formats.fonts.layout {
	// A GSUB or GPOS table: script, feature and lookup lists read in place.
	type LayoutTable {
		internal d           Data
		internal scripts     int
		internal features    int
		internal lookups     int
		// Feature index -> replacement feature table, from the
		// FeatureVariations record the instance selects.
		internal substitutes map<int, int>
		// Each lookup's subtables and first-glyph digest, by lookup index, read
		// the first time it runs (`accel`).
		internal accels      map<int, LookupAccel>

		def new(table byte[]) {
			d = new Data(table)
			return when d.len() < 10 || d.u16(0) != 1
			scripts = d.u16(4)
			features = d.u16(6)
			lookups = d.u16(8)
		}

		// Selects the FeatureVariations record whose conditions hold at
		// `coords` (normalized F2Dot14); the first match wins, and its
		// feature tables replace the originals.
		def selectVariations(coords int[], store VariationStore) {
			substitutes = new map<int, int>()
			return when d.len() < 14 || d.u16(2) < 1
			let fv = d.u32(10)
			return when fv == 0
			for let i = 0; i < d.u32(fv + 4); i++ {
				let rec = fv + 8 + i * 8
				break unless d.has(rec, 8)
				let set = d.u32(rec)
				if conditionSetHolds(set == 0 ?? (0, fv + set), coords, store) {
					let sub = fv + d.u32(rec + 4)
					if d.u32(rec + 4) != 0 {
						for let k = 0; k < d.u16(sub + 4); k++ {
							let r = sub + 6 + k * 6
							substitutes[d.u16(r)] = sub + d.u32(r + 2)
						}
					}
					return
				}
			}
		}

		// Whether every condition of the ConditionSet at `at` holds; an
		// empty or absent set always does.
		internal def conditionSetHolds(at int, coords int[], store VariationStore) bool {
			return true when at == 0
			for let i = 0; i < d.u16(at); i++ {
				return false unless conditionHolds(d, at + d.u32(at + 2 + i * 4), coords, (index int) => store.delta(index, coords), 0)
			}
			return true
		}

		def isEmpty() bool {
			return lookups == 0
		}

		def data() Data {
			return d
		}

		def scriptCount() int {
			return scripts == 0 ?? (0, d.u16(scripts))
		}

		def scriptTag(i int) string {
			return d.tag(scripts + 2 + i * 6)
		}

		// Index of the script tagged `tag`, or -1.
		def findScript(tag string) int {
			for let i = 0; i < scriptCount(); i++ {
				return i when scriptTag(i) == tag
			}
			return -1
		}

		internal def scriptAt(i int) int {
			return scripts + d.u16(scripts + 2 + i * 6 + 4)
		}

		// Index of the language system tagged `tag` in script `script`, or -1.
		def findLanguage(script int, tag string) int {
			return -1 when script < 0
			let s = scriptAt(script)
			for let i = 0; i < d.u16(s + 2); i++ {
				return i when d.tag(s + 4 + i * 6) == tag
			}
			return -1
		}

		// Offset of a language system: `language` -1 is the script's default.
		// 0 when there is none.
		def langSys(script int, language int) int {
			return 0 when script < 0
			let s = scriptAt(script)
			if language < 0 {
				let off = d.u16(s)
				return off == 0 ?? (0, s + off)
			}
			return s + d.u16(s + 4 + language * 6 + 4)
		}

		// Required feature index of a language system, -1 when none.
		def requiredFeature(langSys int) int {
			return -1 when langSys == 0
			let f = d.u16(langSys + 2)
			return f == 0xFFFF ?? (-1, f)
		}

		// Feature indices of a language system, in order.
		def featureIndices(langSys int) int[] {
			let out int[]
			return out when langSys == 0
			for let i = 0; i < d.u16(langSys + 4); i++ {
				out.push(d.u16(langSys + 6 + i * 2))
			}
			return out
		}

		def featureCount() int {
			return features == 0 ?? (0, d.u16(features))
		}

		def featureTag(i int) string {
			return d.tag(features + 2 + i * 6)
		}

		// First feature tagged `tag` anywhere in the feature list, or -1.
		def findFeature(tag string) int {
			for let i = 0; i < featureCount(); i++ {
				return i when featureTag(i) == tag
			}
			return -1
		}

		// Lookup indices of feature `i`.
		def featureLookups(i int) int[] {
			let out int[]
			return out when i < 0 || i >= featureCount()
			let f = features + d.u16(features + 2 + i * 6 + 4)
			let alternate = substitutes.get(i)
			if !(alternate is none) {
				f = alternate
			}
			for let j = 0; j < d.u16(f + 2); j++ {
				out.push(d.u16(f + 4 + j * 2))
			}
			return out
		}

		def lookupCount() int {
			return lookups == 0 ?? (0, d.u16(lookups))
		}

		internal def lookupAt(i int) int {
			return lookups + d.u16(lookups + 2 + i * 2)
		}

		def lookupType(i int) int {
			return d.u16(lookupAt(i))
		}

		// Lookup flags, with the mark filtering set index in bits 16 and up.
		def lookupProps(i int) int {
			let l = lookupAt(i)
			let flag = d.u16(l + 2)
			flag |= d.u16(l + 6 + d.u16(l + 4) * 2) << 16 when flag & flagUseMarkFilteringSet != 0
			return flag
		}

		// Offsets of a lookup's subtables and their types, extension subtables
		// unwrapped. `extension` is the extension lookup type of the table
		// (7 for GSUB, 9 for GPOS).
		// What running lookup `i` needs, read once: its subtables (`subtables`)
		// and a digest of the glyphs its first glyph may be, so a pass over a
		// buffer skips the glyphs it cannot apply to without reading a coverage
		// table, as HarfBuzz's lookup accelerators do. `extension` is the
		// table's extension lookup type: 7 in GSUB, 9 in GPOS.
		def accel(i int, extension int) LookupAccel {
			let known = accels.get(i)
			return known when known is LookupAccel
			let (offsets, types) = subtables(i, extension)
			let firsts = new GlyphDigest()
			for let (s, sub) in offsets {
				addFirsts(firsts, sub, types[s], extension == 7)
			}
			let made = LookupAccel{offsets: offsets, types: types, firsts: firsts}
			accels[i] = made
			return made
		}

		// Adds to `firsts` the glyphs a subtable of lookup type `kind` may start
		// at: its coverage, the first input coverage of a contextual one; every
		// glyph when it names none this reads.
		internal def addFirsts(firsts GlyphDigest, sub int, kind int, substitution bool) {
			let context = substitution ?? (5, 7)
			let chained = substitution ?? (6, 8)
			let known = substitution ?? (kind := 1 || 2 || 3 || 4 || 8, kind := 1 || 2 || 3 || 4 || 5 || 6)
			let coverage = 0
			if kind == context {
				let format = d.u16(sub)
				if format == 3 {
					coverage = d.u16(sub + 2) > 0 ?? (d.u16(sub + 6), 0)
				} else if format := 1 || 2 {
					coverage = d.u16(sub + 2)
				}
			} else if kind == chained {
				let format = d.u16(sub)
				if format == 3 {
					let back = d.u16(sub + 2)
					coverage = d.u16(sub + 4 + back * 2) > 0 ?? (d.u16(sub + 6 + back * 2), 0)
				} else if format := 1 || 2 {
					coverage = d.u16(sub + 2)
				}
			} else if known {
				coverage = d.u16(sub + 2)
			}
			if coverage == 0 {
				firsts.fill()
				return
			}
			let at = sub + coverage
			match d.u16(at) {
				case 1:
					for let k = 0; k < d.u16(at + 2); k++ {
						firsts.add(d.u16(at + 4 + k * 2))
					}
				case 2:
					for let r = 0; r < d.u16(at + 2); r++ {
						let range = at + 4 + r * 6
						let (first, last) = (d.u16(range), d.u16(range + 2))
						// A digest of a few thousand glyphs has every bit set.
						if last - first >= 4096 {
							firsts.fill()
							return
						}
						for let g = first; g <= last; g++ {
							firsts.add(g)
						}
					}
				default:
					firsts.fill()
			}
		}

		def subtables(i int, extension int) (int[], int[]) {
			let offsets int[]
			let types int[]
			let l = lookupAt(i)
			let kind = d.u16(l)
			for let s = 0; s < d.u16(l + 4); s++ {
				let sub = l + d.u16(l + 6 + s * 2)
				let subKind = kind
				if kind == extension && d.u16(sub) == 1 {
					subKind = d.u16(sub + 2)
					sub += d.u32(sub + 4)
				}
				offsets.push(sub)
				types.push(subKind)
			}
			return (offsets, types)
		}
	}

	// A lookup's subtables, their types, and the digest of the glyphs its first
	// glyph may be (`LayoutTable.accel`).
	struct LookupAccel {
		offsets int[]
		types   int[]
		firsts  GlyphDigest
	}

	// Whether the Condition table at `at` holds at `coords`: an axis range
	// (format 1), a varying value above zero (2, its delta from `delta`), or
	// the and (3), or (4) and negation (5) of other conditions.
	def conditionHolds(d Data, at int, coords int[], delta def (int) float32, depth int) bool {
		return false when depth > 16
		match d.u16(at) {
			case 1:
				let axis = d.u16(at + 2)
				let coord = axis < coords.len() ?? (coords[axis], 0)
				return d.i16(at + 4) <= coord && coord <= d.i16(at + 6)
			case 2:
				let value = float32(d.i16(at + 2)) + delta(d.u32(at + 4))
				return value > float32(0.0)
			case 3:
				for let i = 0; i < d.u8(at + 2); i++ {
					return false unless conditionHolds(d, at + u24(d, at + 3 + i * 3), coords, delta, depth + 1)
				}
				return true
			case 4:
				for let i = 0; i < d.u8(at + 2); i++ {
					return true when conditionHolds(d, at + u24(d, at + 3 + i * 3), coords, delta, depth + 1)
				}
				return false
			case 5:
				return !conditionHolds(d, at + u24(d, at + 2), coords, delta, depth + 1)
		}
		return false
	}

	def u24(d Data, at int) int {
		return d.u8(at) << 16 | d.u16(at + 1)
	}
}
