internal partial module std.formats.fonts.layout {
	// OpenType script tags for an ISO 15924 script, most preferred first:
	// the Indic and Myanmar "new" tags before the old one.
	def scriptTags(script string) string[] {
		let out string[]
		let newTag = newScriptTag(script)
		if newTag != "" {
			out.push(newTag[0:3] + "3") when newTag != "mym2"
			out.push(newTag)
		}
		let old = oldScriptTag(script)
		out.push(old) when old != ""
		return out
	}

	internal def newScriptTag(script string) string {
		let isos = ["Beng", "Deva", "Gujr", "Guru", "Knda", "Mlym", "Orya", "Taml", "Telu", "Mymr"]
		let tags = ["bng2", "dev2", "gjr2", "gur2", "knd2", "mlm2", "ory2", "tml2", "tel2", "mym2"]
		let i = isos.indexOf(script)
		return i < 0 ?? ("", tags[i])
	}

	internal def oldScriptTag(script string) string {
		return "" when script := "" || "Zyyy" || "Zinh" || "Zzzz"
		return "math" when script == "Zmth"
		return "kana" when script == "Hira"
		return "lao " when script == "Laoo"
		return "yi  " when script == "Yiii"
		return "nko " when script == "Nkoo"
		return "vai " when script == "Vaii"
		return script.lower()
	}

	// OpenType language system tags for a BCP 47 language tag.
	def languageTags(language string) string[] {
		let out string[]
		return out when language == ""
		let lang = language.lower()
		return out when lang.startsWith("x-")
		// The language part ends where a private-use subtag (-x-) starts.
		let limit = lang.len()
		let px = lang.indexOf("-x-")
		limit = px when px >= 0
		let complex = complexLanguageTags(lang, limit)
		return complex when complex.len() > 0
		let parts = lang[0:limit].split("-")
		let first = parts[0]
		// An extended language subtag (zh-yue) stands for the language.
		first = parts[1] when parts.len() > 1 && parts[1].len() == 3 && parts[1][0:1] >= "a" && parts[1][0:1] <= "z"
		if first.len() == 2 {
			let i = lowerBound(lang2Keys, first)
			for i < lang2Keys.len() && lang2Keys[i] == first {
				out.push(lang2Tags[i]) when lang2Tags[i] != ""
				i++
			}
			return out
		}
		if first.len() == 3 {
			let i = lowerBound(lang3Keys, first)
			if i < lang3Keys.len() && lang3Keys[i] == first {
				out.push(lang3Tags[i])
				return out
			}
			i = lowerBound(lang3MultiKeys, first)
			if i < lang3MultiKeys.len() && lang3MultiKeys[i] == first {
				for let k = 0; k < lang3MultiCount[i]; k++ {
					out.push(lang3MultiTags[lang3MultiStart[i] + k])
				}
				return out
			}
			i = lowerBound(lang3Blocked, first)
			return out when i < lang3Blocked.len() && lang3Blocked[i] == first
			out.push(first.upper() + " ")
		}
		return out
	}

	// First index whose key is not below `key`.
	def lowerBound(keys string[], key string) int {
		let lo = 0
		let hi = keys.len()
		for lo < hi {
			let mid = (lo + hi) / 2
			if keys[mid] < key {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo
	}

	// Whether `subtag` ("-hant") occurs in s[0:limit] as a whole subtag.
	def subtagMatches(s string, limit int, subtag string) bool {
		return false when limit < subtag.len()
		let from = 0
		for {
			let i = s[from:].indexOf(subtag)
			return false when i < 0
			i += from
			return false when i >= limit
			let after = i + subtag.len()
			return true when after >= s.len() || !isAlnum(s[after:after + 1])
			from = after
		}
		return false
	}

	// Whether s starts with the language spec, followed by the end or '-'.
	def langMatches(s string, limit int, spec string) bool {
		return false when limit < spec.len() || !s.startsWith(spec)
		return s.len() == spec.len() || s[spec.len():spec.len() + 1] == "-"
	}

	def isAlnum(c string) bool {
		return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
	}
}
