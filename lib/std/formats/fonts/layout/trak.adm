// Tracking: the AAT `trak` table, spacing added to every grapheme by point
// size. A port of HarfBuzz 14.1's hb-aat-layout-trak-table.hh.

internal partial module std.formats.fonts.layout {
	// The point size tracking assumes when the caller gives none, as
	// CoreText does.
	const defaultPointSize = 12.0

	// The `trak` table of a face.
	type Trak {
		internal d Data

		def new(bytes byte[]) {
			d = new Data(bytes)
		}

		def hasData() bool {
			return d.u32(0) != 0
		}

		// Adds the tracking at `ptem` points to the first glyph of every
		// grapheme, in font units.
		def apply(b Buffer, ptem float) {
			ptem = defaultPointSize when ptem <= 0.0
			let horizontal = isHorizontal(b.direction)
			let data = d.u16(horizontal ?? (6, 8))
			let add = roundHalfUp(float32(tracking(data, ptem, 0.0)))
			let start = 0
			for start < b.len {
				if horizontal {
					b.pos.xAdvance[start] += add
				} else {
					b.pos.yAdvance[start] += add
				}
				start = b.groupEnd(start, (x int, y int) => b.info.isContinuation(y))
			}
		}

		// The tracking of the track nearest `track`, at `ptem` points, in font
		// units: interpolated between sizes and between tracks.
		internal def tracking(data int, ptem float, track float) float {
			return 0.0 when data == 0
			let tracks = d.u16(data)
			let sizes = d.u16(data + 2)
			let sizeTable = d.u32(data + 4)
			return 0.0 when tracks == 0
			return value(data + 8, ptem, sizeTable, sizes) when tracks == 1
			let i = 0
			let j = tracks - 1
			for i + 1 < tracks && trackValue(data, i + 1) <= track {
				i++
			}
			for j > 0 && trackValue(data, j - 1) >= track {
				j--
			}
			return value(data + 8 + i * 8, ptem, sizeTable, sizes) when i == j
			let t0 = trackValue(data, i)
			let t1 = trackValue(data, j)
			let t = (track - t0) / (t1 - t0)
			let a = value(data + 8 + i * 8, ptem, sizeTable, sizes)
			let v = value(data + 8 + j * 8, ptem, sizeTable, sizes)
			return float(float32(a + t * (v - a)))
		}

		internal def trackValue(data int, i int) float {
			return fixed(data + 8 + i * 8)
		}

		internal def fixed(at int) float {
			let v = d.u32(at)
			v -= 0x100000000 when v >= 0x80000000
			return float(float32(v) / float32(65536.0))
		}

		// One track's value at `ptem`, between the two sizes around it.
		internal def value(entry int, ptem float, sizeTable int, sizes int) float {
			let values = d.u16(entry + 6)
			return 0.0 when sizes == 0
			return float(d.i16(values)) when sizes == 1
			let i = 0
			for i < sizes && fixed(sizeTable + i * 4) < ptem {
				i++
			}
			return float(d.i16(values)) when i == 0
			return float(d.i16(values + (sizes - 1) * 2)) when i == sizes
			return float(d.i16(values + i * 2)) when fixed(sizeTable + i * 4) == ptem
			let s0 = fixed(sizeTable + (i - 1) * 4)
			let s1 = fixed(sizeTable + i * 4)
			let v0 = d.i16(values + (i - 1) * 2)
			let v1 = d.i16(values + i * 2)
			if s1 < s0 {
				let s = s0
				s0 = s1
				s1 = s
				let v = v0
				v0 = v1
				v1 = v
			}
			return float(v0) when ptem < s0
			return float(v1) when ptem > s1
			return float(float32(v0 + v1) * float32(0.5)) when s0 == s1
			let t = float32(ptem - s0) / float32(s1 - s0)
			return float(float32(v0) + t * float32(v1 - v0))
		}
	}
}
