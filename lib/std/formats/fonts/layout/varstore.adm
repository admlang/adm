// OpenType variation data shared by several tables: the item variation store
// (HVAR, VVAR, MVAR, avar 2, GDEF) and the delta-set index map that picks a
// store entry for a glyph or an axis.

internal partial module std.formats.fonts.layout {
	// An ItemVariationStore read in place. Coordinates are normalized F2Dot14
	// values, one per axis; deltas come back unrounded, summed in single
	// precision as HarfBuzz does.
	type VariationStore {
		internal d          Data
		internal at         int
		internal regions    int
		internal axisCount  int
		internal regionCount int

		// The store at `at` in `d`; an offset of 0 or a store in a format other
		// than 1 is empty.
		def new(d Data = new Data(), at int = 0) {
			self.d = d
			self.at = at
			if at == 0 || d.u16(at) != 1 {
				self.at = 0
				return
			}
			regions = at + d.u32(at + 2)
			axisCount = d.u16(regions)
			regionCount = d.u16(regions + 2)
		}

		// Whether the store holds any data.
		def present() bool {
			return at != 0
		}

		// The delta of entry `index` (outer << 16 | inner) at `coords`.
		def delta(index int, coords int[]) float32 {
			return float32(0.0) when at == 0
			let outer = (index >> 16) & 0xFFFF
			let inner = index & 0xFFFF
			return float32(0.0) when outer >= d.u16(at + 6)
			let data = at + d.u32(at + 8 + outer * 4)
			let itemCount = d.u16(data)
			let wordField = d.u16(data + 2)
			let count = d.u16(data + 4)
			return float32(0.0) when count == 0 || inner >= itemCount
			let long = wordField & 0x8000 != 0
			let words = wordField & 0x7FFF
			let rowSize = long ?? ((words + count) * 2, words + count)
			let row = data + 6 + count * 2 + inner * rowSize
			// Wide deltas come first: 32-bit then 16-bit in long rows, 16-bit
			// then 8-bit otherwise.
			let wide = long ?? (4, 2)
			let narrow = long ?? (2, 1)
			let sum = float32(0.0)
			let p = row
			for let i = 0; i < count; i++ {
				let size = i < words ?? (wide, narrow)
				let scalar = regionScalar(d.u16(data + 6 + i * 2), coords)
				if scalar != float32(0.0) {
					sum += scalar * float32(signed(p, size))
				}
				p += size
			}
			return sum
		}

		// The signed big-endian value of `size` bytes at `p`.
		internal def signed(p int, size int) int {
			match size {
				case 1:
					let v = d.u8(p)
					return v >= 128 ?? (v - 256, v)
				case 2:
					return d.i16(p)
			}
			let v = d.u32(p)
			return v >= 0x80000000 ?? (v - 0x100000000, v)
		}

		// How much each region of variation data `outer` applies at `coords`,
		// in the data's region order: what a CFF2 `blend` weighs its deltas by.
		def regionScalars(outer int, coords int[]) float32[] {
			let out float32[]
			return out when at == 0 || outer >= d.u16(at + 6)
			let data = at + d.u32(at + 8 + outer * 4)
			for let i = 0; i < d.u16(data + 4); i++ {
				out.push(regionScalar(d.u16(data + 6 + i * 2), coords))
			}
			return out
		}

		// How much region `r` applies at `coords`: the product of each axis's
		// tent, 0 outside the region.
		def regionScalar(r int, coords int[]) float32 {
			return float32(0.0) when r >= regionCount
			let base = regions + 4 + r * axisCount * 6
			let v = float32(1.0)
			for let i = 0; i < axisCount; i++ {
				let coord = i < coords.len() ?? (coords[i], 0)
				let f = axisScalar(d.i16(base + i * 6), d.i16(base + i * 6 + 2), d.i16(base + i * 6 + 4), coord)
				return float32(0.0) when f == float32(0.0)
				v *= f
			}
			return v
		}
	}

	// One axis's contribution to a region: 1 at the peak, falling linearly to
	// 0 at start and end. A peak of 0 or a malformed range leaves the axis out.
	def axisScalar(start int, peak int, end int, coord int) float32 {
		return float32(1.0) when peak == 0 || coord == peak
		return float32(0.0) when coord == 0
		return float32(1.0) when start > peak || peak > end
		return float32(1.0) when start < 0 && end > 0
		return float32(0.0) when coord <= start || end <= coord
		if coord < peak {
			return float32(coord - start) / float32(peak - start)
		}
		return float32(end - coord) / float32(end - peak)
	}

	// A DeltaSetIndexMap: glyph or axis index to a variation store entry
	// (outer << 16 | inner). An absent map passes the index through.
	type DeltaSetIndexMap {
		internal d        Data
		internal at       int
		internal count    int
		internal width    int
		internal innerBits int
		internal entries  int

		def new(d Data = new Data(), at int = 0) {
			self.d = d
			self.at = at
			return when at == 0
			let format = d.u8(at)
			let entry = d.u8(at + 1)
			if format == 0 {
				count = d.u16(at + 2)
				entries = at + 4
			} else if format == 1 {
				count = d.u32(at + 2)
				entries = at + 6
			} else {
				self.at = 0
				return
			}
			width = ((entry >> 4) & 3) + 1
			innerBits = (entry & 0xF) + 1
		}

		def map(v int) int {
			return v when at == 0 || count == 0
			let i = v >= count ?? (count - 1, v)
			let u = 0
			let p = entries + width * i
			for let k = 0; k < width; k++ {
				u = (u << 8) + d.u8(p + k)
			}
			let outer = u >> innerBits
			let inner = u & ((1 << innerBits) - 1)
			return outer << 16 | inner
		}
	}
}
