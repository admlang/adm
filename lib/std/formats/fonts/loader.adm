partial module std.formats.fonts {
	use (
		std.reflection
		std.formats
		std.bytes
		std.os
		std.io
	)

	type FontCodec = FontFormat & formats.FileFormat

	meta def codec<FontCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	internal let codecRegistry = new formats.CodecRegistry<FontCodec>("font", codec)

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	def load(data byte[]) !Font {
		let (dec, r) = try codecRegistry.probe(data)
		return dec.open(r)
	}

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	//
	// The file has to outlive this call: faces read glyph data on demand, so the
	// descriptor cannot be closed here. Ownership belongs to the returned font
	// -- see the same note in std.formats.archive.loader.
	def load(path string) !Font {
		let f = try os.open(path)

		let (dec, r) = codecRegistry.probe(f) onerror (err error) {
			f.close()
			return err
		}
		return dec.open(r)
	}

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	def load(reader io.Reader) !Font {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.open(r)
	}

	// Info reads what the headers say about the first face -- family, weight,
	// units per em -- without parsing glyph data. This is what a font database
	// scanning a directory needs, and it stays cheap over hundreds of files.
	def info(data byte[]) !FontInfo {
		let (dec, r) = try codecRegistry.probe(data)
		return dec.info(r)
	}

	// Info reads what the headers say without parsing glyph data.
	def info(path string) !FontInfo {
		// Everything needed is read before returning, so closing here is safe.
		let f = try os.open(path)
		defer f.close()

		let (dec, r) = try codecRegistry.probe(f)
		return dec.info(r)
	}

	// Info reads what the headers say without parsing glyph data.
	def info(reader io.Reader) !FontInfo {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.info(r)
	}
}
