// MicroType Express: the compression Embedded OpenType applies to TrueType
// fonts. Three LZCOMP-compressed blocks hold a Compact Table Format font --
// an sfnt whose glyf, cvt, hdmx and VDMX tables are re-encoded and whose loca
// is dropped -- plus the glyphs' hint push data and instructions, split out
// of glyf. Unpacking undoes both steps and yields a plain TrueType font.

internal partial module std.formats.fonts.opentype {
	// Bytes LZCOMP preloads into its window before the first symbol, so early
	// data can already use copy items.
	const lzPreload = 2 * 32 * 96 + 4 * 256

	// Most-significant-bit-first bit input.
	type MtxBits {
		data  byte[]
		pos   int
		buf   int
		count int

		def new(data byte[]) {
			self.data = data
		}

		def bit() !int {
			if count == 0 {
				fail "MTX data ends early" when pos >= data.len()
				buf = int(data[pos])
				pos++
				count = 8
			}
			count--
			return (buf >> count) & 1
		}

		def value(n int) !int {
			let v = 0
			for let i = 0; i < n; i++ {
				v = (v << 1) | (try bit())
			}
			return v
		}
	}

	// The adaptive Huffman coder LZCOMP reads every symbol through: a sibling
	// property tree whose weights grow with each symbol read.
	type AdaptiveHuffman {
		up          int[]
		left        int[]
		right       int[]
		code        int[]
		weight      int[]
		symbolIndex int[]

		def new(range int) {
			let size = 2 * range
			up.len(size)
			left.len(size)
			right.len(size)
			code.len(size)
			weight.len(size)
			symbolIndex.len(range)
			up[:] = 0
			left[:] = 0
			right[:] = 0
			weight[:] = 1
			for let i = 2; i < size; i++ {
				up[i] = i / 2
			}
			for let i = 1; i < range; i++ {
				left[i] = 2 * i
				right[i] = 2 * i + 1
			}
			for let i = 0; i < range; i++ {
				code[i] = -1
				code[range + i] = i
				left[range + i] = -1
				right[range + i] = -1
				symbolIndex[i] = range + i
			}
			for let i = range - 1; i >= 1; i-- {
				weight[i] = weight[left[i]] + weight[right[i]]
			}
			// Node 0 is outside the tree; a weight no node reaches keeps the
			// sibling search from walking into it.
			weight[0] = 0x7FFFFFFF

			if range > 256 && range < 512 {
				// The symbol coder starts biased towards short copies and the
				// one-byte copy symbols.
				update(symbolIndex[256])
				update(symbolIndex[257])
				for let i = 0; i < 12; i++ {
					update(symbolIndex[range - 3])
				}
				for let i = 0; i < 6; i++ {
					update(symbolIndex[range - 2])
				}
			} else {
				for let pass = 0; pass < 2; pass++ {
					for let i = 0; i < range; i++ {
						update(symbolIndex[i])
					}
				}
			}
		}

		def swap(a int, b int) {
			let upA = up[a]
			let upB = up[b]
			let l = left[a]
			let r = right[a]
			let c = code[a]
			let w = weight[a]
			left[a] = left[b]
			right[a] = right[b]
			code[a] = code[b]
			weight[a] = weight[b]
			left[b] = l
			right[b] = r
			code[b] = c
			weight[b] = w
			up[a] = upA
			up[b] = upB

			for let (_, n) in int[a, b] {
				if code[n] < 0 {
					up[left[n]] = n
					up[right[n]] = n
				} else {
					symbolIndex[code[n]] = n
				}
			}
		}

		// Adds one to the weight of node `a` and its ancestors, swapping nodes
		// to keep weights in decreasing order.
		def update(start int) {
			let a = start
			for a != 1 {
				let w = weight[a]
				let b = a - 1
				if weight[b] == w {
					for weight[b] == w {
						b--
					}
					b++
					if b > 1 {
						swap(a, b)
						a = b
					}
				}
				weight[a] = w + 1
				a = up[a]
			}
			weight[1] += 1
		}

		def read(bits MtxBits) !int {
			let a = 1
			for {
				a = (try bits.bit()) != 0 ?? (right[a], left[a])
				break when code[a] >= 0
			}
			// Updating moves nodes, so the symbol is taken first.
			let symbol = code[a]
			update(a)
			return symbol
		}
	}

	// Decompresses one LZCOMP block. `version` is the MTX header version;
	// version 1 predates the optional run-length stage.
	// Fails when the block is truncated or refers outside its window.
	def lzcompDecode(data byte[], version int) !byte[] {
		let bits = new MtxBits(data)
		let runLength = version != 1 && (try bits.bit()) != 0
		let distances = new AdaptiveHuffman(8)
		let lengths = new AdaptiveHuffman(8)
		let outLen = try bits.value(24)

		let ranges = 1
		for (1 << (3 * ranges)) < outLen {
			ranges++
		}
		let dup2 = 256 + 8 * ranges
		let symbols = new AdaptiveHuffman(dup2 + 3)

		let window byte[]
		window.len(lzPreload + outLen)
		let i = 0
		for let k = 0; k < 32; k++ {
			for let j = 0; j < 96; j++ {
				window[i] = byte(k)
				window[i + 1] = byte(j)
				i += 2
			}
		}
		for let j = 0; j < 256; j++ {
			window[i] = byte(j)
			window[i + 1] = byte(j)
			window[i + 2] = byte(j)
			window[i + 3] = byte(j)
			i += 4
		}

		let pos = lzPreload
		let end = lzPreload + outLen
		for pos < end {
			let sym = try symbols.read(bits)
			if sym < 256 {
				window[pos] = byte(sym)
				pos++
				continue
			}
			if sym >= dup2 {
				let back = 2 * (sym - dup2 + 1)
				window[pos] = window[pos - back]
				pos++
				continue
			}

			// A copy item: the symbol carries the number of distance symbols and
			// the first two length bits, with a stop bit.
			let lengthBits = sym - 256
			let distRanges = lengthBits / 8 + 1
			lengthBits %= 8
			let length = 0
			for {
				length = (length << 2) | (lengthBits & 3)
				break when (lengthBits & 4) == 0
				lengthBits = try lengths.read(bits)
			}
			length += 2

			let distance = 0
			for let k = 0; k < distRanges; k++ {
				distance = (distance << 3) | (try distances.read(bits))
			}
			distance += 1
			length++ when distance >= 512

			let from = pos - distance - length + 1
			fail "MTX copy reaches outside its window" when from < 0 || pos + length > end
			for let k = 0; k < length; k++ {
				window[pos] = window[from + k]
				pos++
			}
		}

		let out = window[lzPreload:end]
		return runLength ?? (unRunLength(out), out)
	}

	// Undoes LZCOMP's run-length stage: the first byte is the escape; escape,
	// 0 is a literal escape, and escape, n, b is n copies of b.
	def unRunLength(data byte[]) byte[] {
		let out byte[]
		return out when data.len() == 0
		let escape = data[0]
		let i = 1
		for i < data.len() {
			let b = data[i]
			i++
			if b != escape {
				out.push(b)
				continue
			}
			break when i >= data.len()
			let count = int(data[i])
			i++
			if count == 0 {
				out.push(escape)
				continue
			}
			break when i >= data.len()
			let value = data[i]
			i++
			for let k = 0; k < count; k++ {
				out.push(value)
			}
		}
		return out
	}

	// Least-significant-bit-first input of magnitude-dependent values: n ones,
	// a zero, then a sign bit when n is not zero.
	type MagnitudeBits {
		data byte[]
		pos  int
		bit  int

		def new(data byte[], pos int) {
			self.data = data
			self.pos = pos
		}

		def next() !int {
			fail "MTX device metrics end early" when pos >= data.len()
			let v = (int(data[pos]) >> bit) & 1
			bit++
			if bit == 8 {
				bit = 0
				pos++
			}
			return v
		}

		def value() !int {
			let n = 0
			for (try next()) == 1 {
				n++
			}
			return n when n == 0
			return (try next()) == 1 ?? (-n, n)
		}

		// The first byte after the bits read so far.
		def byteEnd() int {
			return bit == 0 ?? (pos, pos + 1)
		}
	}

	// Rebuilds a TrueType font from MicroType Express data.
	// Fails when the data is not MTX or a block or table is damaged.
	def unpackMtx(data byte[]) !byte[] {
		let h = new Cursor(data)
		let version = try h.u8()
		fail "unknown MicroType Express version {version}" when version != 3 && version != 1 && version != 2
		// copy limit
		try h.take(3)
		let off2 = ((try h.u8()) << 16) | (try h.u16())
		let off3 = ((try h.u8()) << 16) | (try h.u16())
		fail "MicroType Express block offsets are inconsistent" when off2 < 10 || off3 < off2 || off3 > data.len()

		let ctf = try lzcompDecode(data[10:off2], version)
		let push = try lzcompDecode(data[off2:off3], version)
		let code = try lzcompDecode(data[off3:], version)
		return rebuildCtf(ctf, push, code)
	}

	// Turns a Compact Table Format font back into plain TrueType.
	// Fails when a re-encoded table is damaged.
	def rebuildCtf(ctf byte[], push byte[], code byte[]) !byte[] {
		let c = new Cursor(ctf)
		let flavor = try c.u32()
		let numTables = try c.u16()
		c.pos = 12

		let tables TableData[]
		let byTag = new map<string, int>()
		for let i = 0; i < numTables; i++ {
			let tag = string(try c.take(4))
			// checksum
			try c.u32()
			let offset = try c.u32()
			let length = try c.u32()
			fail "MTX table {tag} runs past the end of the font" when offset + length > ctf.len()
			byTag.set(tag, tables.len())
			tables.push(TableData{tag: tag, data: ctf[offset:offset + length]})
		}

		let glyfAt = byTag.get("glyf")
		let headAt = byTag.get("head")
		let maxpAt = byTag.get("maxp")
		fail "MTX font has no head table" when headAt is none
		fail "MTX font has no maxp table" when maxpAt is none
		let numGlyphs = try (new Cursor(tables[maxpAt].data, 4)).u16()
		let head = tables[headAt].data.clone()
		fail "MTX head table is too short" when head.len() < 54
		let unitsPerEm = try (new Cursor(head, 18)).u16()

		if !(glyfAt is none) {
			let indexFormat = try (new Cursor(head, 50)).i16()
			let rebuilt = try rebuildCtfGlyf(tables[glyfAt].data, numGlyphs, indexFormat, push, code)
			tables[glyfAt] = TableData{tag: "glyf", data: rebuilt.glyf}
			let locaAt = byTag.get("loca")
			if locaAt is none {
				byTag.set("loca", tables.len())
				tables.push(TableData{tag: "loca", data: rebuilt.loca})
			} else {
				tables[locaAt] = TableData{tag: "loca", data: rebuilt.loca}
			}
			head[50] = 0
			head[51] = byte(rebuilt.longOffsets ?? (1, 0))
		}
		tables[headAt] = TableData{tag: "head", data: head}

		let cvtAt = byTag.get("cvt ")
		tables[cvtAt] = TableData{tag: "cvt ", data: try rebuildCvt(tables[cvtAt].data)} unless (cvtAt is none)

		let hdmxAt = byTag.get("hdmx")
		if !(hdmxAt is none) {
			let advances = try ctfAdvances(tables, byTag, numGlyphs)
			tables[hdmxAt] = TableData{tag: "hdmx", data: try rebuildHdmx(tables[hdmxAt].data, advances, unitsPerEm)}
		}

		let vdmxAt = byTag.get("VDMX")
		tables[vdmxAt] = TableData{tag: "VDMX", data: try rebuildVdmx(tables[vdmxAt].data)} unless (vdmxAt is none)

		let indices int[]
		for let i = 0; i < tables.len(); i++ {
			indices.push(i)
		}
		return assemble(tables, FontEntry[FontEntry{flavor:uint32(flavor), tables:indices}])
	}

	// Rebuilds `glyf` and `loca`, putting each glyph's hint push data and
	// instructions back in front of its outline data.
	def rebuildCtfGlyf(src byte[], numGlyphs int, indexFormat int, pushData byte[], codeData byte[]) !RebuiltGlyf {
		let c = new Cursor(src)
		let pushes = new Cursor(pushData)
		let codes = new Cursor(codeData)
		let out = new Writer()
		let offsets int[]
		let xMins int[]
		let endPts int[]
		let xs int[]
		let ys int[]
		let onCurve bool[]

		for let g = 0; g < numGlyphs; g++ {
			offsets.push(out.len())
			xMins.push(0)
			let contours = try c.i16()
			continue when contours == 0

			if contours < 0 {
				out.i16(-1)
				let xMin = try c.i16()
				xMins[g] = xMin
				out.i16(xMin)
				out.i16(try c.i16())
				out.i16(try c.i16())
				out.i16(try c.i16())

				let start = c.pos
				let hasInstructions = false
				for {
					let flags = try c.u16()
					let skip = 2
					skip += (flags & argsAreWords) != 0 ?? (4, 2)
					if (flags & haveScale) != 0 {
						skip += 2
					} else if (flags & haveXYScale) != 0 {
						skip += 4
					} else if (flags & haveTwoByTwo) != 0 {
						skip += 8
					}
					try c.take(skip)
					hasInstructions = true when (flags & haveInstructions) != 0
					break when (flags & moreComponents) == 0
				}
				out.bytes(src[start:c.pos])
				if hasInstructions {
					let program = try glyphProgram(c, pushes, codes)
					out.u16(program.len())
					out.bytes(program)
				}
				out.pad(indexFormat == 0 ?? (2, 4))
				continue
			}

			let box int[]
			if contours == 0x7FFF {
				contours = try c.i16()
				for let k = 0; k < 4; k++ {
					box.push(try c.i16())
				}
			}

			// The first value is the first contour's end point, the rest are
			// point counts.
			endPts.len(0)
			let last = -1
			for let k = 0; k < contours; k++ {
				let v = try c.u255()
				last = k == 0 ?? (v, last + v)
				endPts.push(last)
			}
			let total = last + 1
			fail "MTX glyph {g} has a negative point count" when total < 0
			xs.len(total)
			ys.len(total)
			onCurve.len(total)

			let flags = try c.take(total)
			let x = 0
			let y = 0
			for let p = 0; p < total; p++ {
				let flag = int(flags[p])
				onCurve[p] = (flag & 0x80) == 0
				let (dx, dy) = try decodeTriplet(flag & 0x7F, c)
				x += dx
				y += dy
				xs[p] = x
				ys[p] = y
			}

			let program = try glyphProgram(c, pushes, codes)
			xMins[g] = writeSimpleGlyph(out, endPts, xs, ys, onCurve, box, program, false)
			out.pad(indexFormat == 0 ?? (2, 4))
		}
		offsets.push(out.len())
		return finishGlyf(out, offsets, indexFormat, xMins)
	}

	// Reads a glyph's push count and code size, and joins its push data --
	// re-encoded as TrueType push instructions -- with its instructions.
	def glyphProgram(c Cursor, pushes Cursor, codes Cursor) !byte[] {
		let pushCount = try c.u255()
		let codeSize = try c.u255()

		let values int[]
		for values.len() < pushCount {
			let b = try pushes.u8()
			if b := 251 || 252 {
				// Hop codes: A, x1, A, x2, A (and, for 252, x3, A) with only
				// the xs stored.
				fail "MTX push data hops before two values" when values.len() < 2
				let a = values[values.len() - 2]
				values.push(a)
				values.push(try readPushValue(pushes))
				values.push(a)
				if b == 252 {
					values.push(try readPushValue(pushes))
					values.push(a)
				}
				continue
			}
			pushes.pos--
			values.push(try readPushValue(pushes))
		}
		fail "MTX push data overruns its count" when values.len() != pushCount

		let out = new Writer()
		let i = 0
		for i < values.len() {
			let n = values.len() - i
			n = 255 when n > 255
			let bytesOnly = true
			for let k = i; k < i + n; k++ {
				bytesOnly = false when values[k] < 0 || values[k] > 255
			}
			if bytesOnly {
				// PUSHB[n-1] or NPUSHB
				if n <= 8 {
					out.u8(0xB0 + n - 1)
				} else {
					out.u8(0x40)
					out.u8(n)
				}
				for let k = i; k < i + n; k++ {
					out.u8(values[k])
				}
			} else {
				// PUSHW[n-1] or NPUSHW
				if n <= 8 {
					out.u8(0xB8 + n - 1)
				} else {
					out.u8(0x41)
					out.u8(n)
				}
				for let k = i; k < i + n; k++ {
					out.i16(values[k])
				}
			}
			i += n
		}
		out.bytes(try codes.take(codeSize))
		return out.data
	}

	// A 255SHORT: small magnitudes in one byte, an optional sign flip, and
	// escapes for larger values.
	def readPushValue(c Cursor) !int {
		let b = try c.u8()
		return try c.i16() when b == 253
		let sign = 1
		if b == 250 {
			sign = -1
			b = try c.u8()
		}
		let v = b
		if b == 255 {
			v = (try c.u8()) + 250
		} else if b == 254 {
			v = (try c.u8()) + 500
		}
		return v * sign
	}

	// `cvt ` stores deltas between neighbouring values in one to three bytes.
	def rebuildCvt(src byte[]) !byte[] {
		let c = new Cursor(src)
		let count = try c.u16()
		let out = new Writer()
		let value = 0
		for let i = 0; i < count; i++ {
			let b = try c.u8()
			let delta = 0
			if b < 238 {
				delta = b
			} else if b == 238 {
				delta = try c.i16()
			} else if b <= 247 {
				delta = -((b - 239) * 238 + (try c.u8()))
			} else {
				delta = (b - 247) * 238 + (try c.u8())
			}
			value = (value + delta) & 0xFFFF
			out.u16(value)
		}
		return out.data
	}

	// Every glyph's advance width, for predicting `hdmx`.
	def ctfAdvances(tables TableData[], byTag map<string, int>, numGlyphs int) !int[] {
		let hheaAt = byTag.get("hhea")
		let hmtxAt = byTag.get("hmtx")
		fail "MTX font has hdmx but no hhea" when hheaAt is none
		fail "MTX font has hdmx but no hmtx" when hmtxAt is none
		let numHMetrics = try (new Cursor(tables[hheaAt].data, 34)).u16()
		let c = new Cursor(tables[hmtxAt].data)
		let out int[]
		let last = 0
		for let g = 0; g < numGlyphs; g++ {
			if g < numHMetrics {
				last = try c.u16()
				try c.i16()
			}
			out.push(last)
		}
		return out
	}

	// `hdmx` stores each width as its difference from the advance scaled to the
	// record's size.
	def rebuildHdmx(src byte[], advances int[], unitsPerEm int) !byte[] {
		let c = new Cursor(src)
		let version = try c.u16()
		if version >= 0x8000 {
			// Stored as is; the version says so.
			let raw = src.clone()
			let real = 0xFFFF - version
			raw[0] = byte(real >> 8)
			raw[1] = byte(real & 0xFF)
			return raw
		}
		let numRecords = try c.u16()
		let recordSize = try c.u32()
		let sizes int[]
		let maxWidths int[]
		for let r = 0; r < numRecords; r++ {
			sizes.push(try c.u8())
			maxWidths.push(try c.u8())
		}

		let out = new Writer()
		out.u16(version)
		out.u16(numRecords)
		out.u32(recordSize)
		let bits = new MagnitudeBits(src, c.pos)
		for let r = 0; r < numRecords; r++ {
			let start = out.len()
			let ppem = sizes[r]
			out.u8(ppem)
			out.u8(maxWidths[r])
			for let (_, aw) in advances {
				let predicted = ((64 * ppem * aw + unitsPerEm / 2) / unitsPerEm + 32) / 64
				out.u8(predicted + (try bits.value()))
			}
			for out.len() - start < recordSize {
				out.u8(0)
			}
		}
		return out.data
	}

	// `VDMX` stores each group's heights as differences from a linear
	// prediction.
	def rebuildVdmx(src byte[]) !byte[] {
		let c = new Cursor(src)
		let version = try c.u16()
		if version >= 0x8000 {
			let raw = src.clone()
			let real = 0xFFFF - version
			raw[0] = byte(real >> 8)
			raw[1] = byte(real & 0xFF)
			return raw
		}
		let numRecs = try c.u16()
		let numRatios = try c.u16()
		let ratios = try c.take(4 * numRatios)
		let offsets int[]
		for let i = 0; i < numRatios; i++ {
			offsets.push(try c.u16())
		}
		fail "VDMX has no ratios" when numRatios == 0

		// Decode every group, noting where each started in the source.
		let starts int[]
		let groups Writer[]
		let at = offsets[0]
		for let g = 0; g < numRecs; g++ {
			starts.push(at)
			let gc = new Cursor(src, at)
			let recs = try gc.u16()
			let yMaxMult = try gc.i16()
			let yMinMult = try gc.i16()
			let bits = new MagnitudeBits(src, gc.pos)
			let entries = new Writer()
			let predicted = 8
			let first = 0
			let last = 0
			for let k = 0; k < recs; k++ {
				let ppem = predicted + (try bits.value())
				let yMax = (ppem * yMaxMult + 1024) / 2048 + (try bits.value())
				let yMin = -((ppem * yMinMult + 1024) / 2048) + (try bits.value())
				entries.u16(ppem)
				entries.i16(yMax)
				entries.i16(yMin)
				first = ppem when k == 0
				last = ppem
				predicted = ppem + 1
			}
			let group = new Writer()
			group.u16(recs)
			group.u8(first)
			group.u8(last)
			group.bytes(entries.data)
			groups.push(group)
			at = bits.byteEnd()
		}

		let out = new Writer()
		out.u16(version)
		out.u16(numRecs)
		out.u16(numRatios)
		out.bytes(ratios)
		let base = 6 + 4 * numRatios + 2 * numRatios
		let groupAt int[]
		let pos = base
		for let (_, gw) in groups {
			groupAt.push(pos)
			pos += gw.len()
		}
		for let (_, o) in offsets {
			let index = 0
			for let g = 0; g < starts.len(); g++ {
				index = g when starts[g] == o
			}
			out.u16(groupAt.len() > 0 ?? (groupAt[index], base))
		}
		for let (_, gw) in groups {
			out.bytes(gw.data)
		}
		return out.data
	}
}
