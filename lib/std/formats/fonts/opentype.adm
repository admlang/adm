// The face and font every sfnt-based codec hands out: ttf and otf directly,
// woff, woff2 and eot after unwrapping their packaging into plain sfnt bytes.

internal partial module std.formats.fonts.opentype {
	use (
		std.io
		std.bytes
		std.math.geom
		std.formats.fonts
		std.formats.fonts.sfnt
		std.formats.fonts.truetype
		std.formats.fonts.cff
	)

	// One face of an sfnt font, with TrueType (`glyf`) or PostScript (`CFF `,
	// `CFF2`) outlines.
	//
	// Everything is read up front except glyph outlines, which are decoded on
	// demand -- a face with thousands of glyphs is rarely asked for more than a
	// few dozen.
	type SfntFace {
		font     sfnt.Sfnt
		trueType bool
		loca     truetype.Loca
		program  cff.Cff
		cmap     sfnt.Cmap
		hmetric  sfnt.HMetric[]
		details  fonts.FontInfo
		face     fonts.FontMetrics

		def new(font sfnt.Sfnt) {
			self.font = font
		}

		// Reads every table the face needs. `format` names the file format; empty
		// picks "ttf" or "otf" from the outline kind.
		// Fails when a required table is missing or damaged.
		def load(format string) !none {
			let head = try sfnt.readHead(font)
			let glyphCount = try sfnt.readGlyphCount(font)
			let hhea = try sfnt.readHhea(font)

			trueType = font.isTrueType()
			if trueType {
				loca = try truetype.readLoca(font, head, glyphCount)
			} else {
				let table = font.table("CFF ")
				table = font.table("CFF2") when table is none
				fail "font has neither glyf nor CFF outlines" when table is none
				program = new cff.Cff()
				try program.parse(table)
			}

			cmap = try sfnt.readCmap(font)
			hmetric = try sfnt.readHMetrics(font, hhea, glyphCount)
			details = try describe(font, format)
			face = try readFaceMetrics(font, head, hhea)
		}

		// info returns the font's description: family, style and the rest.
		def info() fonts.FontInfo {
			return details
		}

		// metrics returns the face's vertical metrics.
		def metrics() fonts.FontMetrics {
			return face
		}

		// glyph returns the glyph for the character, none when the font lacks it.
		def glyph(codepoint char) ?fonts.GlyphID {
			return cmap.lookup(uint32(codepoint))
		}

		// metrics returns the glyph's advance and bearings. Fails when the glyph is
		// out of range.
		def metrics(glyph fonts.GlyphID) !fonts.GlyphMetrics {
			let i = int(glyph)
			fail "glyph {i} is out of range" when i < 0 || i >= hmetric.len()

			// `hmtx` carries advance and left bearing; the bounding box comes
			// from the outline, which is only decoded when asked for.
			return fonts.GlyphMetrics{
				advance: int16(hmetric[i].advance),
				leftSideBearing: hmetric[i].leftSideBearing
			}
		}

		// Kerning from the legacy `kern` table is not read, and GPOS kerning is
		// the shaper's job, so this reports no adjustment for now.
		def kern(left fonts.GlyphID, right fonts.GlyphID) int16 {
			return int16(0)
		}

		// outline returns the glyph's outline: quadratic segments for TrueType
		// outlines, cubic ones for CFF. Fails when the glyph data cannot be read.
		def outline(glyph fonts.GlyphID) !fonts.Outline {
			return truetype.readGlyph(font, loca, glyph) when trueType
			return program.outline(glyph)
		}

		// rasterize renders the glyph at the size as a bitmap. Not implemented yet:
		// always fails.
		def rasterize(glyph fonts.GlyphID, size float) !fonts.Bitmap {
			fail "rasterising is not implemented yet"
		}

		// table returns the raw bytes of a table, none when the face has none.
		def table(tag string) ?byte[] {
			return font.table(tag)
		}
	}

	// A font file holding one sfnt face, or several for a collection. Faces are
	// parsed when first asked for.
	type SfntFont {
		data    byte[]
		offsets uint32[]
		format  string
		loaded  map<int, fonts.Face>

		def new(data byte[], offsets uint32[], format string) {
			self.data = data
			self.offsets = offsets
			self.format = format
			loaded = new map<int, fonts.Face>()
		}

		// faces returns how many faces the font holds.
		def faces() int {
			return offsets.len()
		}

		// face returns the face at index. Fails when the index is out of range or
		// the face's tables are damaged.
		def face(index int) !fonts.Face {
			expects {
				assert index >= 0 && index < offsets.len() onerror fail "face index {index} is out of range"
			}
			let cached = loaded.get(index)
			return cached unless cached is none

			let font = new sfnt.Sfnt()
			try font.parse(data, offsets[index])
			let out = new SfntFace(font)
			try out.load(format)
			let f fonts.Face = out
			loaded.set(index, f)
			return f
		}

		// close releases the font's data and faces. It cannot fail.
		def close() !none {
			loaded = new map<int, fonts.Face>()
			data = byte[]
			return none
		}
	}

	// Opens sfnt bytes -- a single font or a collection -- as a Font. The first
	// face is parsed straight away so that damaged data fails here.
	// Fails when the data is not an sfnt font or its first face is damaged.
	def open(data byte[], format string) !fonts.Font {
		let offsets = try sfnt.faceOffsets(data)
		let out = new SfntFont(data, offsets, format)
		try out.face(0)
		return out
	}

	// Describes the first face of sfnt bytes without reading glyph data.
	// Fails when the data is not an sfnt font or its `head` table is damaged.
	def info(data byte[], format string) !fonts.FontInfo {
		let offsets = try sfnt.faceOffsets(data)
		let font = new sfnt.Sfnt()
		try font.parse(data, offsets[0])
		return describe(font, format)
	}

	// Reads a whole stream into memory.
	// Fails when the reader does.
	def readAll(reader io.Reader) !byte[] {
		let buf = new bytes.Buffer()
		try buf.readFrom(reader)
		return buf.bytes()
	}

	// Fills in what a font matcher selects on.
	def describe(font sfnt.Sfnt, format string) !fonts.FontInfo {
		let head = try sfnt.readHead(font)
		let names = sfnt.readNames(font) onerror recover sfnt.Names{}

		let glyphCount = sfnt.readGlyphCount(font) onerror recover uint16(0)

		let out = fonts.FontInfo{
			family:     names.family,
			subfamily:  names.subfamily,
			postscript: names.postscript,
			unitsPerEm: head.unitsPerEm,
			glyphCount: glyphCount,
			scalable:   true,
			format:     format
		}
		out.format = font.isTrueType() ?? ("ttf", "otf") when format == ""

		// `OS/2` is the authority on weight and slant, but a font may omit it --
		// `head.macStyle` carries a coarse version of the same claims.
		let os2 = sfnt.readOs2(font)
		if os2 is error {
			out.weight = (head.macStyle & 0x0001) != 0 ?? (fonts.FontWeight.Bold, fonts.FontWeight.Regular)
			out.width = fonts.FontWidth.Normal
			out.italic = (head.macStyle & 0x0002) != 0
		} else {
			out.weight = weightFromClass(os2.weightClass)
			out.width = widthFromClass(os2.widthClass)
			out.italic = os2.isItalic()
		}

		let post = sfnt.readPost(font)
		out.fixedPitch = post.fixedPitch unless (post is error)

		// Colour glyph tables, any of which makes a face colour-capable.
		out.color = font.has("COLR") || font.has("CBDT") || font.has("sbix")

		return out
	}

	def readFaceMetrics(font sfnt.Sfnt, head sfnt.Head, hhea sfnt.Hhea) !fonts.FontMetrics {
		let out = fonts.FontMetrics{
			ascent:  hhea.ascender,
			descent: hhea.descender,
			lineGap: hhea.lineGap,
			bounds:  geom.Rect{
				left:   float(head.xMin),
				top:    float(head.yMin),
				right:  float(head.xMax),
				bottom: float(head.yMax)
			}
		}

		let os2 = sfnt.readOs2(font)
		if !(os2 is error) {
			out.capHeight = os2.capHeight
			out.xHeight = os2.xHeight
		}

		let post = sfnt.readPost(font)
		if !(post is error) {
			out.underlinePosition = post.underlinePosition
			out.underlineThickness = post.underlineThickness
		}

		return out
	}

	// The OpenType weight class is already the 100..900 scale, but a font may
	// store a value off the scale, so it is snapped to the nearest step.
	def weightFromClass(cls uint16) fonts.FontWeight {
		return fonts.FontWeight.Thin when cls < 150
		return fonts.FontWeight.ExtraLight when cls < 250
		return fonts.FontWeight.Light when cls < 350
		return fonts.FontWeight.Regular when cls < 450
		return fonts.FontWeight.Medium when cls < 550
		return fonts.FontWeight.SemiBold when cls < 650
		return fonts.FontWeight.Bold when cls < 750
		return fonts.FontWeight.ExtraBold when cls < 850
		return fonts.FontWeight.Black
	}

	def widthFromClass(cls uint16) fonts.FontWidth {
		return fonts.FontWidth.UltraCondensed when cls <= 1
		return fonts.FontWidth.ExtraCondensed when cls == 2
		return fonts.FontWidth.Condensed when cls == 3
		return fonts.FontWidth.SemiCondensed when cls == 4
		return fonts.FontWidth.Normal when cls == 5
		return fonts.FontWidth.SemiExpanded when cls == 6
		return fonts.FontWidth.Expanded when cls == 7
		return fonts.FontWidth.ExtraExpanded when cls == 8
		return fonts.FontWidth.UltraExpanded
	}

	// One table of a font being rebuilt from a wrapper format.
	struct TableData {
		tag  string
		data byte[]
	}

	// One font of a rebuilt file: its sfnt version and the tables it uses, as
	// indices into the shared table list.
	struct FontEntry {
		flavor uint32
		tables int[]
	}

	// Lays tables out as a plain sfnt file, or as a collection when there is
	// more than one font, sharing tables that several fonts list.
	// Fails only when writing to the in-memory buffer does.
	def assemble(tables TableData[], entries FontEntry[]) !byte[] {
		let collection = entries.len() > 1
		let headerSize = collection ?? (12 + 4 * entries.len(), 0)
		let dirStart int[]
		let size = headerSize
		for let (_, e) in entries {
			dirStart.push(size)
			size += 12 + 16 * e.tables.len()
		}

		let tableAt int[]
		for let (_, t) in tables {
			tableAt.push(size)
			size += (t.data.len() + 3) & ~3
		}

		let w = new bytes.Buffer()
		if collection {
			try w.writeString("ttcf")
			try w.write<uint32>(uint32(0x00010000))
			try w.write<uint32>(uint32(entries.len()))
			for let (_, at) in dirStart {
				try w.write<uint32>(uint32(at))
			}
		}

		for let (_, e) in entries {
			// Directory entries are sorted by tag, as the binary-search fields
			// promise.
			let order = e.tables.clone().sort((a, b) => tables[a].tag < tables[b].tag)
			let n = order.len()
			let pow = 1
			let log = 0
			for pow * 2 <= n {
				pow *= 2
				log++
			}
			try w.write<uint32>(e.flavor)
			try w.write<uint16>(uint16(n))
			try w.write<uint16>(uint16(pow * 16))
			try w.write<uint16>(uint16(log))
			try w.write<uint16>(uint16(n * 16 - pow * 16))
			for let (_, ti) in order {
				let t = tables[ti]
				try w.writeString(t.tag)
				try w.write<uint32>(checksum(t.data))
				try w.write<uint32>(uint32(tableAt[ti]))
				try w.write<uint32>(uint32(t.data.len()))
			}
		}

		let pad = byte[0, 0, 0]
		for let (_, t) in tables {
			try w.write(t.data)
			let extra = ((t.data.len() + 3) & ~3) - t.data.len()
			if extra > 0 {
				try w.write(pad[0:extra])
			}
		}
		return w.bytes()
	}

	// The sfnt table checksum: the sum of the table as big-endian 32-bit words.
	def checksum(data byte[]) uint32 {
		let sum = 0
		let i = 0
		for i + 4 <= data.len() {
			sum += (int(data[i]) << 24) | (int(data[i + 1]) << 16) | (int(data[i + 2]) << 8) | int(data[i + 3])
			i += 4
		}
		let shift = 24
		for i < data.len() {
			sum += int(data[i]) << shift
			shift -= 8
			i++
		}
		return uint32(sum & 0xFFFFFFFF)
	}
}
