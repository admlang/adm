// The face and font every sfnt-based codec hands out: ttf and otf directly,
// woff, woff2 and eot after unwrapping their packaging into plain sfnt bytes.

internal partial module std.formats.fonts.opentype {
	use (
		std.io
		std.bytes
		std.math.geom
		std.formats.fonts
		std.formats.fonts.sfnt
		std.formats.fonts.truetype
		std.formats.fonts.cff
		std.formats.fonts.layout
		std.formats.fonts.hinting
		std.formats.fonts.variations
		std.formats.fonts.color
		std.gfx.color::(Color)
	)

	// One face of an sfnt font, with TrueType (`glyf`) or PostScript (`CFF `,
	// `CFF2`) outlines.
	//
	// Everything is read up front except glyph outlines, which are decoded on
	// demand -- a face with thousands of glyphs is rarely asked for more than a
	// few dozen.
	type SfntFace {
		font        sfnt.Sfnt
		trueType    bool
		// Whether the face has outlines at all; colour-bitmap and stripped
		// fonts have none, but still map and advance glyphs.
		outlines    bool
		glyphCount  int
		unitsPerEm  int
		loca        truetype.Loca
		program     cff.Cff
		cmap        sfnt.Cmap
		hmetric     sfnt.HMetric[]
		details     fonts.FontInfo
		face        fonts.FontMetrics
		kerning     layout.Kerning
		// Bytecode hinting state, built on first use.
		hinter      ?hinting.HintedFace
		// CFF hinting state, built on first use.
		cffHinter   ?hinting.HintedCff
		// TrueType glyphs as points, at this face's instance.
		glyphs      truetype.GlyphLoader
		// Variation tables, shared by every instance of the font.
		vars        variations.FaceVariations
		// Normalized F2Dot14 coordinates of this instance, one per axis; all
		// zero (or empty) at the default instance.
		coords      int[]
		// The instance's design coordinates by axis tag, which the hinter
		// normalizes its own way; empty at the default instance.
		design      map<string, float>
		// Glyph loaders at the coordinates composite components ask for.
		leafLoaders map<string, truetype.GlyphLoader>
		// The colour tables, read on first use.
		colorTables ?color.ColorTables

		def new(font sfnt.Sfnt) {
			self.font = font
		}

		// Reads every table the face needs. `format` names the file format; empty
		// picks "ttf" or "otf" from the outline kind.
		// Fails when a required table is missing or damaged.
		def load(format string) !none {
			let head = try sfnt.readHead(font)
			let count = try sfnt.readGlyphCount(font)
			glyphCount = int(count)
			unitsPerEm = int(head.unitsPerEm)
			// Without `hhea` every glyph advances by half an em, as shapers
			// assume.
			let hhea = sfnt.readHhea(font) onerror recover sfnt.Hhea{}

			trueType = font.has("glyf") && font.has("loca")
			if trueType {
				loca = try truetype.readLoca(font, head, count)
				outlines = true
			} else {
				let table = font.table("CFF ")
				table = font.table("CFF2") when table is none
				if !(table is none) {
					program = new cff.Cff()
					try program.parse(table)
					outlines = true
				}
			}

			cmap = try sfnt.readCmap(font)
			if hhea.numberOfHMetrics > 0 {
				hmetric = try sfnt.readHMetrics(font, hhea, count)
			}
			details = try describe(font, format)
			face = try readFaceMetrics(font, head, hhea)

			let kern = font.table("kern")
			let gpos = font.table("GPOS")
			kerning = new layout.Kerning(kern is none ?? (byte[], kern), gpos is none ?? (byte[], gpos), int[], byte[], tableOrEmpty("kerx"), int(count))

			vars = new variations.FaceVariations((tag string) => tableOrEmpty(tag))
			coords.len(vars.fvar.axes.len())
			coords.fill(0)
			glyphs = makeLoader()
		}

		// A glyph loader for this face's instance.
		internal def makeLoader(at ?int[] = none) truetype.GlyphLoader {
			let vhea = tableOrEmpty("vhea")
			let vmetrics = vhea.len() >= 36 ?? (int(vhea[34]) << 8 | int(vhea[35]), 0)
			let vmtx = tableOrEmpty("vmtx")
			vmetrics = 0 when vmtx.len() == 0
			return new truetype.GlyphLoader(font, loca, hmetric, vmtx, vmetrics, unitsPerEm, vars.gvar, at is none ?? (coords, at))
		}

		// The same face at another point of its design space.
		def atCoords(normalized int[]) SfntFace {
			let out = new SfntFace(font)
			out.trueType = trueType
			out.outlines = outlines
			out.glyphCount = glyphCount
			out.unitsPerEm = unitsPerEm
			out.loca = loca
			out.program = program
			out.colorTables = colorTables
			out.cmap = cmap
			out.hmetric = hmetric
			out.details = fonts.FontInfo{
				family:     details.family,
				subfamily:  details.subfamily,
				postscript: details.postscript,
				weight:     details.weight,
				width:      details.width,
				italic:     details.italic,
				unitsPerEm: details.unitsPerEm,
				glyphCount: details.glyphCount,
				fixedPitch: details.fixedPitch,
				scalable:   details.scalable,
				color:      details.color,
				format:     details.format
			}
			out.face = fonts.FontMetrics{
				ascent:             face.ascent,
				descent:            face.descent,
				lineGap:            face.lineGap,
				capHeight:          face.capHeight,
				xHeight:            face.xHeight,
				underlinePosition:  face.underlinePosition,
				underlineThickness: face.underlineThickness,
				bounds:             face.bounds
			}
			let kern = font.table("kern")
			let gpos = font.table("GPOS")
			out.kerning = new layout.Kerning(kern is none ?? (byte[], kern), gpos is none ?? (byte[], gpos), normalized, tableOrEmpty("GDEF"), tableOrEmpty("kerx"), glyphCount)
			out.vars = vars
			out.coords = normalized
			out.glyphs = out.makeLoader()
			out.applyMetricVariations()
			return out
		}

		// Whether this face sits off the default instance.
		internal def varied() bool {
			return variations.varied(coords)
		}

		// The instance's normalized coordinates (F2Dot14), which shaping
		// keys its variation data on.
		def normalizedCoords() int[] {
			return coords
		}

		// The unrounded `MVAR` delta of the metric tagged `tag`.
		def metricVariation(tag string) float32 {
			return vars.mvar.delta(tag, coords)
		}

		// Glyph `g`'s vertical advance at the instance: `VVAR` when the font
		// has it, else the phantom points `gvar` moves, else `vmtx` (an em
		// without one).
		def verticalAdvance(g int) int {
			let vmtx = tableOrEmpty("vmtx")
			let vhea = tableOrEmpty("vhea")
			let count = vhea.len() >= 36 && vmtx.len() > 0 ?? (int(vhea[34]) << 8 | int(vhea[35]), 0)
			return unitsPerEm when count == 0
			let i = g.min(count - 1)
			let base = int(vmtx[i * 4]) << 8 | int(vmtx[i * 4 + 1])
			return base unless varied()
			if vars.vvar.present() {
				return (base + layout.roundHalfUp(vars.vvar.advanceDelta(g, coords))).max(0)
			}
			return base unless trueType && vars.gvar.present()
			let a = glyphs.advance(g, true)
			return a is error ?? (unitsPerEm, a)
		}

		// The top phantom point of glyph `g` at the instance, none for faces
		// without glyf outlines.
		def verticalOrigin(g int) ?int {
			return none unless trueType
			let pts = glyphs.points(g)
			return none when pts is error
			return layout.roundHalfUp(pts.ys[pts.len() - 2])
		}

		// Point `index` of glyph `g`'s TrueType outline at the instance, in
		// font units from its origin, components' points in order: what `kerx`
		// control-point attachment and GDEF ligature carets of format 2 name.
		// None for faces without glyf outlines and for indices past the
		// glyph's points.
		def contourPoint(g int, index int) ?geom.Point<int> {
			return none unless trueType
			let pts = glyphs.points(g)
			return none when pts is error || index < 0 || index >= pts.len() - 4
			return new geom.Point<int>(layout.roundHalfUp(pts.xs[index]), layout.roundHalfUp(pts.ys[index]))
		}

		// The face's CPAL palettes, the default first (color.ColorSource).
		def colorPalettes() color.Palette[] {
			return colors().palettes((id int) => sfnt.readName(font, uint16(id)))
		}

		// How `glyph` is drawn in colour at this instance, none when only as
		// an outline (color.ColorSource).
		def colorGlyphOf(glyph int, size float, palette int, foreground Color, svg bool = true) ?color.ColorGlyph {
			return colors().glyph(glyph, size, palette, foreground, coords, svg)
		}

		internal def colors() color.ColorTables {
			let known = colorTables
			return known unless known is none
			let made = new color.ColorTables((tag string) => self.tableOrEmpty(tag), unitsPerEm, glyphCount)
			colorTables = made
			return made
		}

		// The rounded `VVAR` delta of glyph `g`'s `VORG` origin.
		def originVariation(g int) int {
			return layout.roundHalfUp(vars.vvar.originDelta(g, coords))
		}

		// Moves the face-wide metrics by their `MVAR` deltas.
		internal def applyMetricVariations() {
			return unless varied()
			face.ascent = int16(int(face.ascent) + vars.metric("hasc", coords))
			face.descent = int16(int(face.descent) + vars.metric("hdsc", coords))
			face.lineGap = int16(int(face.lineGap) + vars.metric("hlgp", coords))
			face.capHeight = int16(int(face.capHeight) + vars.metric("cpht", coords))
			face.xHeight = int16(int(face.xHeight) + vars.metric("xhgt", coords))
			face.underlinePosition = int16(int(face.underlinePosition) + vars.metric("undo", coords))
			face.underlineThickness = int16(int(face.underlineThickness) + vars.metric("unds", coords))
		}

		// The glyph's advance at this instance: `HVAR` when the font has it,
		// else the phantom points `gvar` moves.
		internal def variedAdvance(i int) int {
			let base = i < hmetric.len() ?? (int(hmetric[i].advance), unitsPerEm / 2)
			if vars.hvar.present() {
				return (base + layout.roundHalfUp(vars.hvar.advanceDelta(i, coords))).max(0)
			}
			return base unless trueType && vars.gvar.present()
			let a = glyphs.advance(i)
			return a is error ?? (unitsPerEm / 2, a)
		}

		// info returns the font's description: family, style and the rest.
		def info() fonts.FontInfo {
			return details
		}

		// metrics returns the face's vertical metrics.
		def metrics() fonts.FontMetrics {
			return face
		}

		// glyph returns the glyph for the character, none when the font lacks it.
		def glyph(codepoint char) ?fonts.GlyphID {
			return cmap.lookup(uint32(codepoint))
		}

		// metrics returns the glyph's advance and bearings. Fails when the glyph is
		// out of range.
		def metrics(glyph fonts.GlyphID) !fonts.GlyphMetrics {
			let i = int(glyph)
			fail "glyph {i} is out of range" when i < 0 || i >= glyphCount
			let box = bounds(glyph)
			return fonts.GlyphMetrics{advance: int16(unitsPerEm / 2), bounds: box} when hmetric.len() == 0
			fail "glyph {i} is out of range" when i >= hmetric.len()
			if varied() {
				return fonts.GlyphMetrics{
					advance:         int16(variedAdvance(i).min(32767)),
					leftSideBearing: int16(layout.roundHalfUp(float32(box.left))),
					bounds:          box
				}
			}

			return fonts.GlyphMetrics{
				advance:         int16(hmetric[i].advance),
				leftSideBearing: hmetric[i].leftSideBearing,
				bounds:          box
			}
		}

		// The glyph's ink box in font units, as `FontMetrics.bounds` has it
		// (top is the lowest y). TrueType glyphs store it in their header;
		// CFF glyphs take it from their outline. Empty for blank glyphs and
		// faces without outlines.
		internal def bounds(glyph fonts.GlyphID) geom.Rect {
			let blank = geom.Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}
			return blank when !outlines
			return boxOf(composite(int(glyph))) when vars.varc.covers(int(glyph))
			if trueType && varied() {
				let pts = glyphs.points(int(glyph))
				return blank when pts is error
				let n = pts.len() - 4
				return blank when n <= 0
				let box = geom.Rect{left: float(pts.xs[0]), top: float(pts.ys[0]), right: float(pts.xs[0]), bottom: float(pts.ys[0])}
				for let k = 1; k < n; k++ {
					box.left = box.left.min(float(pts.xs[k]))
					box.right = box.right.max(float(pts.xs[k]))
					box.top = box.top.min(float(pts.ys[k]))
					box.bottom = box.bottom.max(float(pts.ys[k]))
				}
				return box
			}
			if trueType {
				let table = font.table("glyf")
				let span = loca.range(glyph)
				return blank when table is none || span is none
				let (from, to) = span
				return blank when to < from + 10 || int(to) > table.len()
				let at = int(from)
				return geom.Rect{left: float(i16(table, at + 2)), top: float(i16(table, at + 4)), right: float(i16(table, at + 6)), bottom: float(i16(table, at + 8))}
			}
			let o = program.outline(glyph, coords)
			return blank when o is error
			let first = true
			let box = blank
			for let (_, s) in o.segments {
				continue when s.kind == fonts.SegmentKind.Close
				let points = s.kind == fonts.SegmentKind.Cubic ?? (3, s.kind == fonts.SegmentKind.Quadratic ?? (2, 1))
				for let k = 0; k < points; k++ {
					let p = k == 0 ?? (s.to, k == 1 ?? (s.control1, s.control2))
					if first {
						box = geom.Rect{left: p.x, top: p.y, right: p.x, bottom: p.y}
						first = false
					} else {
						box.left = box.left.min(p.x)
						box.right = box.right.max(p.x)
						box.top = box.top.min(p.y)
						box.bottom = box.bottom.max(p.y)
					}
				}
			}
			return box
		}

		internal def i16(b byte[], at int) int {
			let v = int(b[at]) << 8 | int(b[at + 1])
			return v >= 32768 ?? (v - 65536, v)
		}

		// kern returns the pair adjustment from GPOS (the `kern` feature's pair
		// lookups), else from the legacy `kern` table.
		def kern(left fonts.GlyphID, right fonts.GlyphID) int16 {
			let v = kerning.pair(int(left), int(right))
			return int16(v.clamp(-32768, 32767))
		}

		// outline returns the glyph's outline: quadratic segments for TrueType
		// outlines, cubic ones for CFF. Fails when the face has no outlines or
		// the glyph data cannot be read.
		def outline(glyph fonts.GlyphID) !fonts.Outline {
			fail "font has no outlines" when !outlines
			let o = vars.varc.covers(int(glyph)) ?? (composite(int(glyph)), trueType ?? (try glyphs.outline(int(glyph)), try program.outline(glyph, coords)))
			let m = metrics(glyph)
			o.advance = m is error ?? (0.0, float(m.advance))
			return o
		}

		// A variable composite (`VARC`) glyph: its components drawn at their
		// own coordinates through their transforms. Components that cannot be
		// read draw nothing.
		internal def composite(g int) fonts.Outline {
			let sink = new CompositeSink()
			vars.varc.draw(g, coords, (leaf int, at int[], t variations.Transform) => sink.add(leafOutline(leaf, at), t))
			return new fonts.Outline(sink.segments)
		}

		// Glyph `g`'s own outline at `at`, for a composite's component.
		internal def leafOutline(g int, at int[]) ?fonts.Outline {
			if !trueType {
				let c = program.outline(fonts.GlyphID(g), at)
				return c is error ?? (none, c)
			}
			let key = "{at}"
			let cached = leafLoaders.get(key)
			let loader = cached is none ?? (makeLoader(at), cached)
			leafLoaders[key] = loader when cached is none
			let o = loader.outline(g)
			return o is error ?? (none, o)
		}

		// The box around every point of an outline, control points included.
		internal def boxOf(o fonts.Outline) geom.Rect {
			let box = geom.Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}
			let first = true
			for let (_, s) in o.segments {
				continue when s.kind == fonts.SegmentKind.Close
				let points = s.kind == fonts.SegmentKind.Cubic ?? (3, s.kind == fonts.SegmentKind.Quadratic ?? (2, 1))
				for let k = 0; k < points; k++ {
					let p = k == 0 ?? (s.to, k == 1 ?? (s.control1, s.control2))
					if first {
						box = geom.Rect{left: p.x, top: p.y, right: p.x, bottom: p.y}
						first = false
					} else {
						box.left = box.left.min(p.x)
						box.right = box.right.max(p.x)
						box.top = box.top.min(p.y)
						box.bottom = box.bottom.max(p.y)
					}
				}
			}
			return box
		}

		// baselines reads the script's baselines from the BASE table.
		def baselines(script string, axis fonts.Axis = fonts.Axis.Horizontal) fonts.Baselines {
			let out = fonts.Baselines{}
			let t = font.table("BASE")
			return out when t is none
			let base = new layout.BaseTable(t, coords)
			let (tags, values, dominant) = base.baselines(layout.scriptTags(script), axis == fonts.Axis.Vertical)
			out.dominant = dominant
			for let (i, tag) in tags {
				let v = int16(values[i])
				match tag {
					case "romn":
						out.alphabetic = v
					case "hang":
						out.hanging = v
					case "ideo":
						out.ideographicBottom = v
					case "idtp":
						out.ideographicTop = v
					case "icfb":
						out.ideographicCharacterBottom = v
					case "icft":
						out.ideographicCharacterTop = v
					case "math":
						out.math = v
				}
			}
			return out
		}

		// outline returns the glyph at `size` pixels per em, in pixels. TrueType
		// glyphs run their bytecode (vertical only for Light); CFF glyphs fit
		// their stem hints and blue zones to the pixel grid along y, the same
		// for Light and Full. Fails when the face has no outlines, the size is
		// not positive or the glyph data cannot be read.
		def outline(glyph fonts.GlyphID, size float, hinting fonts.Hinting = fonts.Hinting.Full) !fonts.Outline {
			fail "font has no outlines" when !outlines
			fail "size must be positive" when size <= 0.0
			if hinting == fonts.Hinting.None {
				return scaled(try outline(glyph), size / float(unitsPerEm))
			}
			return trueType ?? (try hinted(glyph, size, hinting == fonts.Hinting.Full), try hintedCff(glyph, size))
		}

		// The glyph with its CFF stem hints applied at `size`.
		internal def hintedCff(glyph fonts.GlyphID, size float) !fonts.Outline {
			let i = int(glyph)
			fail "glyph {i} is out of range" when i < 0 || i >= glyphCount
			let advance = i < hmetric.len() ?? (int(hmetric[i].advance), unitsPerEm / 2)
			let h = cffHinter
			if h is hinting.HintedCff {
				return h.outline(i, size, h.advance(i, advance))
			}
			let variation ?hinting.FtVariation = none
			if design.len() > 0 {
				let v = new hinting.FtVariation((tag string) => tableOrEmpty(tag), design)
				variation = v when v.varied()
			}
			let made = new hinting.HintedCff(program, unitsPerEm, variation)
			cffHinter = made
			return made.outline(i, size, made.advance(i, advance))
		}

		// The glyph run through its TrueType bytecode at `size`.
		internal def hinted(glyph fonts.GlyphID, size float, full bool) !fonts.Outline {
			let mode = full ?? (hinting.modeFull, hinting.modeLight)
			let h = hinter
			return h.outline(int(glyph), size, mode) when h is hinting.HintedFace
			let offsets int[]
			for let i = 0; i < glyphCount; i++ {
				let span = loca.range(uint16(i))
				if span is none {
					offsets.push(offsets.len() > 0 ?? (offsets[offsets.len() - 1], 0))
					continue
				}
				let (start, _) = span
				offsets.push(int(start))
			}
			let end = offsets.len() > 0 ?? (offsets[offsets.len() - 1], 0)
			if glyphCount > 0 {
				let span = loca.range(uint16(glyphCount - 1))
				if !(span is none) {
					let (_, stop) = span
					end = int(stop)
				}
			}
			offsets.push(end)
			let made = new hinting.HintedFace((tag string) => tableOrEmpty(tag), offsets, design)
			hinter = made
			return made.outline(int(glyph), size, mode)
		}

		internal def tableOrEmpty(tag string) byte[] {
			let t = font.table(tag)
			return t is none ?? (byte[], t)
		}

		// A font-unit outline multiplied by `k`.
		internal def scaled(o fonts.Outline, k float) fonts.Outline {
			let out = new fonts.Outline()
			out.advance = o.advance * k
			for let (_, s) in o.segments {
				out.segments.push(fonts.Segment{
					kind:     s.kind,
					to:       geom.Point{x: s.to.x * k, y: s.to.y * k},
					control1: geom.Point{x: s.control1.x * k, y: s.control1.y * k},
					control2: geom.Point{x: s.control2.x * k, y: s.control2.y * k}
				})
			}
			return out
		}

		// rasterize renders the glyph at the size as a bitmap. Not implemented yet:
		// always fails.
		def rasterize(glyph fonts.GlyphID, size float) !fonts.Bitmap {
			fail "rasterising is not implemented yet"
		}

		// table returns the raw bytes of a table, none when the face has none.
		def table(tag string) ?byte[] {
			return font.table(tag)
		}
	}

	// A font file holding one sfnt face, or several for a collection. Faces are
	// parsed when first asked for.
	type SfntFont {
		data    byte[]
		offsets uint32[]
		format  string
		loaded  map<int, fonts.Face>

		def new(data byte[], offsets uint32[], format string) {
			self.data = data
			self.offsets = offsets
			self.format = format
			loaded = new map<int, fonts.Face>()
		}

		// faces returns how many faces the font holds.
		def faces() int {
			return offsets.len()
		}

		// face returns the face at index. Fails when the index is out of range or
		// the face's tables are damaged.
		def face(index int) !fonts.Face {
			expects {
				assert index >= 0 && index < offsets.len() onerror fail "face index {index} is out of range"
			}
			let cached = loaded.get(index)
			return cached unless cached is none

			let font = new sfnt.Sfnt()
			try font.parse(data, offsets[index])
			let out = new SfntFace(font)
			try out.load(format)
			let f fonts.Face = out
			f = new VariableSfntFace(out) when out.vars.variable()
			loaded.set(index, f)
			return f
		}

		// close releases the font's data and faces. It cannot fail.
		def close() !none {
			loaded = new map<int, fonts.Face>()
			data = byte[]
			return none
		}
	}

	// Opens sfnt bytes -- a single font or a collection -- as a Font. The first
	// face is parsed straight away so that damaged data fails here.
	// Fails when the data is not an sfnt font or its first face is damaged.
	def open(data byte[], format string) !fonts.Font {
		let offsets = try sfnt.faceOffsets(data)
		let out = new SfntFont(data, offsets, format)
		try out.face(0)
		return out
	}

	// Describes the first face of sfnt bytes without reading glyph data.
	// Fails when the data is not an sfnt font or its `head` table is damaged.
	def info(data byte[], format string) !fonts.FontInfo {
		let offsets = try sfnt.faceOffsets(data)
		let font = new sfnt.Sfnt()
		try font.parse(data, offsets[0])
		return describe(font, format)
	}

	// Reads a whole stream into memory.
	// Fails when the reader does.
	def readAll(reader io.Reader) !byte[] {
		let buf = new bytes.Buffer()
		try buf.readFrom(reader)
		return buf.bytes()
	}

	// Fills in what a font matcher selects on.
	def describe(font sfnt.Sfnt, format string) !fonts.FontInfo {
		let head = try sfnt.readHead(font)
		let names = sfnt.readNames(font) onerror recover sfnt.Names{}

		let glyphCount = sfnt.readGlyphCount(font) onerror recover uint16(0)

		let out = fonts.FontInfo{
			family:     names.family,
			subfamily:  names.subfamily,
			postscript: names.postscript,
			unitsPerEm: head.unitsPerEm,
			glyphCount: glyphCount,
			scalable:   font.has("glyf") || font.has("CFF ") || font.has("CFF2"),
			format:     format
		}
		out.format = font.isTrueType() ?? ("ttf", "otf") when format == ""

		// `OS/2` is the authority on weight and slant, but a font may omit it --
		// `head.macStyle` carries a coarse version of the same claims.
		let os2 = sfnt.readOs2(font)
		if os2 is error {
			out.weight = (head.macStyle & 0x0001) != 0 ?? (fonts.FontWeight.Bold, fonts.FontWeight.Regular)
			out.width = fonts.FontWidth.Normal
			out.italic = (head.macStyle & 0x0002) != 0
		} else {
			out.weight = weightFromClass(os2.weightClass)
			out.width = widthFromClass(os2.widthClass)
			out.italic = os2.isItalic()
		}

		let post = sfnt.readPost(font)
		out.fixedPitch = post.fixedPitch unless (post is error)

		// Colour glyph tables, any of which makes a face colour-capable.
		out.color = font.has("COLR") || font.has("CBDT") || font.has("sbix") || font.has("SVG ")

		return out
	}

	def readFaceMetrics(font sfnt.Sfnt, head sfnt.Head, hhea sfnt.Hhea) !fonts.FontMetrics {
		let out = fonts.FontMetrics{
			ascent:  hhea.ascender,
			descent: hhea.descender,
			lineGap: hhea.lineGap,
			bounds:  geom.Rect{
				left:   float(head.xMin),
				top:    float(head.yMin),
				right:  float(head.xMax),
				bottom: float(head.yMax)
			}
		}

		let os2 = sfnt.readOs2(font)
		if !(os2 is error) {
			out.capHeight = os2.capHeight
			out.xHeight = os2.xHeight
		}

		let post = sfnt.readPost(font)
		if !(post is error) {
			out.underlinePosition = post.underlinePosition
			out.underlineThickness = post.underlineThickness
		}

		return out
	}

	// The OpenType weight class is already the 100..900 scale, but a font may
	// store a value off the scale, so it is snapped to the nearest step.
	def weightFromClass(cls uint16) fonts.FontWeight {
		return fonts.FontWeight.Thin when cls < 150
		return fonts.FontWeight.ExtraLight when cls < 250
		return fonts.FontWeight.Light when cls < 350
		return fonts.FontWeight.Regular when cls < 450
		return fonts.FontWeight.Medium when cls < 550
		return fonts.FontWeight.SemiBold when cls < 650
		return fonts.FontWeight.Bold when cls < 750
		return fonts.FontWeight.ExtraBold when cls < 850
		return fonts.FontWeight.Black
	}

	def widthFromClass(cls uint16) fonts.FontWidth {
		return fonts.FontWidth.UltraCondensed when cls <= 1
		return fonts.FontWidth.ExtraCondensed when cls == 2
		return fonts.FontWidth.Condensed when cls == 3
		return fonts.FontWidth.SemiCondensed when cls == 4
		return fonts.FontWidth.Normal when cls == 5
		return fonts.FontWidth.SemiExpanded when cls == 6
		return fonts.FontWidth.Expanded when cls == 7
		return fonts.FontWidth.ExtraExpanded when cls == 8
		return fonts.FontWidth.UltraExpanded
	}

	// One table of a font being rebuilt from a wrapper format.
	struct TableData {
		tag  string
		data byte[]
	}

	// One font of a rebuilt file: its sfnt version and the tables it uses, as
	// indices into the shared table list.
	struct FontEntry {
		flavor uint32
		tables int[]
	}

	// Lays tables out as a plain sfnt file, or as a collection when there is
	// more than one font, sharing tables that several fonts list.
	// Fails only when writing to the in-memory buffer does.
	def assemble(tables TableData[], entries FontEntry[]) !byte[] {
		let collection = entries.len() > 1
		let headerSize = collection ?? (12 + 4 * entries.len(), 0)
		let dirStart int[]
		let size = headerSize
		for let (_, e) in entries {
			dirStart.push(size)
			size += 12 + 16 * e.tables.len()
		}

		let tableAt int[]
		for let (_, t) in tables {
			tableAt.push(size)
			size += (t.data.len() + 3) & ~3
		}

		let w = new bytes.Buffer()
		if collection {
			try w.writeString("ttcf")
			try w.write<uint32>(uint32(0x00010000))
			try w.write<uint32>(uint32(entries.len()))
			for let (_, at) in dirStart {
				try w.write<uint32>(uint32(at))
			}
		}

		for let (_, e) in entries {
			// Directory entries are sorted by tag, as the binary-search fields
			// promise.
			let order = e.tables.clone().sort((a, b) => tables[a].tag < tables[b].tag)
			let n = order.len()
			let pow = 1
			let log = 0
			for pow * 2 <= n {
				pow *= 2
				log++
			}
			try w.write<uint32>(e.flavor)
			try w.write<uint16>(uint16(n))
			try w.write<uint16>(uint16(pow * 16))
			try w.write<uint16>(uint16(log))
			try w.write<uint16>(uint16(n * 16 - pow * 16))
			for let (_, ti) in order {
				let t = tables[ti]
				try w.writeString(t.tag)
				try w.write<uint32>(checksum(t.data))
				try w.write<uint32>(uint32(tableAt[ti]))
				try w.write<uint32>(uint32(t.data.len()))
			}
		}

		let pad = byte[0, 0, 0]
		for let (_, t) in tables {
			try w.write(t.data)
			let extra = ((t.data.len() + 3) & ~3) - t.data.len()
			if extra > 0 {
				try w.write(pad[0:extra])
			}
		}
		return w.bytes()
	}

	// The sfnt table checksum: the sum of the table as big-endian 32-bit words.
	def checksum(data byte[]) uint32 {
		let sum = 0
		let i = 0
		for i + 4 <= data.len() {
			sum += (int(data[i]) << 24) | (int(data[i + 1]) << 16) | (int(data[i + 2]) << 8) | int(data[i + 3])
			i += 4
		}
		let shift = 24
		for i < data.len() {
			sum += int(data[i]) << shift
			shift -= 8
			i++
		}
		return uint32(sum & 0xFFFFFFFF)
	}

	// Collects the transformed segments of a composite's components.
	type CompositeSink {
		segments fonts.Segment[]

		def new() {}

		def add(o ?fonts.Outline, t variations.Transform) bool {
			return true when o is none
			let same = variations.isIdentity(t)
			for let (_, s) in o.segments {
				segments.push(same ?? (s, fonts.Segment{
					kind:     s.kind,
					to:       apply(t, s.to),
					control1: apply(t, s.control1),
					control2: apply(t, s.control2)
				}))
			}
			return true
		}

		internal def apply(t variations.Transform, p geom.Point) geom.Point {
			return geom.Point{x: t.x0 + t.xx * p.x + t.xy * p.y, y: t.y0 + t.yx * p.x + t.yy * p.y}
		}
	}
}
