partial module std.formats.fonts {
	use (
		std.io
		std.formats.fonts.opentype
	)

	// OTF is the OpenType codec for fonts with PostScript outlines: a `CFF `
	// table, or `CFF2` in a variable font (read at its default instance).
	// Collections of them (`.otc`) start with `ttcf` and are opened by the TTF
	// codec.
	@codec("OpenType")
	type OTF {
		mimeType string[] {
			def get() string[] {
				return string["font/otf", "application/x-font-otf"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".otf"]
			}
		}

		// The sfnt version tag `OTTO`.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)

			let n = r.read(b) onerror recover 0
			return false when n != 4
			return b.equals(byte[byte('O'), byte('T'), byte('T'), byte('O')])
		}

		// open parses an OpenType font from the reader. Fails when the data is not
		// an sfnt font or its tables are damaged.
		def open(reader io.Reader) !Font {
			return opentype.open(try opentype.readAll(reader), "otf")
		}

		// info reads the font's description from the reader without loading glyphs.
		// Fails when the data is not an sfnt font.
		def info(reader io.Reader) !FontInfo {
			return opentype.info(try opentype.readAll(reader), "otf")
		}
	}
}
