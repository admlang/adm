	// One outline as "M x y L x y Q cx cy x y C x1 y1 x2 y2 x y Z", for comparing
	// the same glyph read through different containers.
	internal def renderOutline(o Outline) string {
		let parts string[]
		for let (_, s) in o.segments {
			switch s.kind {
				case SegmentKind.Move:
					parts.push("M {int(s.to.x)} {int(s.to.y)}")
				case SegmentKind.Line:
					parts.push("L {int(s.to.x)} {int(s.to.y)}")
				case SegmentKind.Quadratic:
					parts.push("Q {int(s.control1.x)} {int(s.control1.y)} {int(s.to.x)} {int(s.to.y)}")
				case SegmentKind.Cubic:
					parts.push("C {int(s.control1.x)} {int(s.control1.y)} {int(s.control2.x)} {int(s.control2.y)} {int(s.to.x)} {int(s.to.y)}")
				case SegmentKind.Close:
					parts.push("Z")
			}
		}
		return parts.join(" ")
	}

	// Every glyph's advance and outline, one line each.
	internal def renderFace(face Face) !string {
		let lines string[]
		for let g = 0; g < int(face.info().glyphCount); g++ {
			let id = GlyphID(g)
			lines.push("{int((try face.metrics(id)).advance)}: {renderOutline(try face.outline(id))}")
		}
		return lines.join("\n")
	}

	check "OTF codec" {
		@test()
		def signatureAcceptsOTTO() !none {
			let otf = new OTF()
			assert otf.matchSignature(new bytes.Reader(tinyOpenType)) // OTTO is CFF-flavoured sfnt
			assert !(otf.matchSignature(new bytes.Reader(tinyTrueType))) // 0x00010000 belongs to the TTF codec
			assert !(otf.matchSignature(new bytes.Reader(tinyCollection))) // ttcf belongs to the TTF codec
		}

		@test()
		def readsFaceMetadata() !none {
			let font = try load(tinyOpenType)
			assert font.faces() == 1 // a plain otf holds one face
			let i = (try font.face(0)).info()
			assert i.family == "Tiny Sans" // family name
			assert i.subfamily == "Bold" // subfamily name
			assert i.postscript == "TinySans-Bold" // postscript name
			assert i.weight == FontWeight.Bold // weight from OS/2
			assert int(i.unitsPerEm) == 1000 // units per em
			assert int(i.glyphCount) == 4 // glyph count
			assert i.scalable // CFF outlines scale
			assert i.format == "otf" // format tag
		}

		@test()
		def drawsCubicOutlines() !none {
			let face = try (try load(tinyOpenType)).face(0)
			let a = face.glyph('A')
			let o = face.glyph('o')
			fail "A is not mapped" when a is none
			fail "o is not mapped" when o is none
			assert renderOutline(try face.outline(a)) == "M 10 0 L 300 0 L 155 500 L 10 0 Z" // a triangle
			assert renderOutline(try face.outline(o)) == "M 50 250 C 50 400 150 500 250 500 C 350 500 450 400 450 250 L 50 250 Z" // two cubic arcs and a closing line
			assert (try face.metrics(a)).advance == int16(310) // advance from hmtx
			assert (try face.outline(a)).advance == 310.0 // outlines carry the design advance
			// Ink boxes come from the outline, control points included.
			let ba = (try face.metrics(a)).bounds
			assert ba.left == 10.0 && ba.top == 0.0 && ba.right == 300.0 && ba.bottom == 500.0 // triangle box
			let bo = (try face.metrics(o)).bounds
			assert bo.left == 50.0 && bo.top == 250.0 && bo.right == 450.0 && bo.bottom == 500.0 // arcs box
			assert face.glyph('z') is none // unmapped
		}

		@test()
		def exposesRawTables() !none {
			let face = try (try load(tinyOpenType)).face(0)
			assert face is OpenTypeFace // sfnt faces carry their layout tables
			if face is OpenTypeFace {
				assert !(face.table("CFF ") is none) // the CFF table is reachable
				assert face.table("GSUB") is none // the font has no GSUB
			}
		}

		@test()
		def infoAgreesWithLoadedFace() !none {
			let quick = try info(tinyOpenType)
			assert quick.family == "Tiny Sans" // header-only read
			assert quick.format == "otf" // format tag
		}

		// A collection opens through the TTF codec, and each face reports the
		// outline kind it has.
		@test()
		def readsCollections() !none {
			let font = try load(tinyCollection)
			assert font.faces() == 2 // two faces in the collection
			let serif = try font.face(0)
			let sans = try font.face(1)
			assert serif.info().family == "Tiny Serif" // first face
			assert serif.info().format == "ttf" // TrueType outlines
			assert sans.info().family == "Tiny Sans" // second face
			assert sans.info().format == "otf" // CFF outlines
			assert (try renderFace(sans)) == (try renderFace(try (try load(tinyOpenType)).face(0))) // shared tables read the same as the standalone font
			assert (try renderFace(serif)) == (try renderFace(try (try load(tinyTrueType)).face(0))) // likewise for the TrueType face
			assert font.face(2) is error // no third face
			assert (try info(tinyCollection)).family == "Tiny Serif" // info describes the first face
		}

		// The codec opens directly too, without the registry probe.
		@test()
		def opensThroughTheCodec() !none {
			assert (try (new OTF()).open(new bytes.Reader(tinyOpenType))).faces() == 1 // OTF.open
			assert (try (new TTF()).open(new bytes.Reader(tinyCollection))).faces() == 2 // TTF.open reads collections
		}

		@test()
		def rejectsDamagedFonts() !none {
			assert load(tinyOpenType[0:200]) is error // truncated tables
		}
	}
}
