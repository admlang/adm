partial module std.formats.fonts.sfnt {
	use (
		std.bytes
		std.data.encoding.codepages
		std.data.encoding.codepages::(CodePage)
		std.data.encoding.shiftjis
	)

	// One contiguous run of codepoints mapping to a run of glyphs.
	//
	// Every subtable format worth supporting is built from runs like this, so
	// parsing collapses them into one representation and lookup does not care
	// which format the font used.
	internal struct CmapRange {
		first      uint32
		last       uint32
		// Glyph for `first`; consecutive codepoints take consecutive glyphs.
		// Ignored when `glyphs` is non-empty.
		startGlyph uint16
		// Explicit glyph per codepoint, for runs that are not consecutive.
		glyphs     uint16[]
		// Every codepoint of the run maps to `startGlyph` (format 13).
		same       bool
	}

	// Platform and encoding pairs, best first, in HarfBuzz's order: a
	// Windows symbol subtable (whose codepoints live at U+F000..F0FF) before
	// all, then full-Unicode subtables, BMP ones, Mac Roman, and any other
	// Mac subtable last.
	internal def cmapScore(platform uint16, encoding uint16) int {
		return 100 when platform == 3 && encoding == 0
		return 95 when platform == 3 && encoding == 10
		return 94 when platform == 0 && encoding == 6
		return 93 when platform == 0 && encoding == 4
		return 90 when platform == 3 && encoding == 1
		return 85 when platform == 0 && encoding == 3
		return 84 when platform == 0 && encoding == 2
		return 83 when platform == 0 && encoding == 1
		return 82 when platform == 0 && encoding == 0
		return 10 when platform == 1 && encoding == 0
		return 5 when platform == 1
		return -1
	}

	// The character set of a Mac subtable, from its script (the encoding
	// ID) and language (the Mac language code + 1; 0 for any). Roman
	// variants go by language as the Mac OS chose them. Japanese is
	// `shiftJis`; scripts without a code page here map ASCII only.
	internal def macCodePage(script int, language int) ?CodePage {
		let lang = language - 1
		match script {
			case 0:
				return CodePage.MacIcelandic when lang == 15 || lang == 30
				return CodePage.MacTurkish when lang == 17
				return CodePage.MacCroatian when lang == 18 || lang == 40
				return CodePage.MacRomanian when lang == 37
				return CodePage.MacCeltic when lang := 35 || 128 || 142
				return CodePage.MacGaelic when lang := 144 || 145 || 146
				return CodePage.MacRoman
			case 4:
				return lang == 31 ?? (CodePage.MacFarsi, CodePage.MacArabic)
			case 5:
				return CodePage.MacHebrew
			case 6:
				return CodePage.MacGreek
			case 7:
				return CodePage.MacCyrillic
			case 21:
				return CodePage.MacThai
			case 29:
				return CodePage.MacCentralEurope
			default:
				return none
		}
	}

	// A font's character map: which glyph draws a given codepoint.
	//
	// Ranges are kept rather than expanded into a lookup table. A CJK font maps
	// tens of thousands of codepoints in a handful of runs, and materialising
	// every one of them would cost far more than the search saves.
	type Cmap {
		internal ranges   CmapRange[]
		// A symbol-font subtable: codepoints 0x00..0xFF also look in
		// U+F000..F0FF, where such fonts put their glyphs.
		symbol            bool
		// A Mac subtable, keyed by codes of a Mac character set rather than
		// by code points: `page`'s, Shift JIS for Japanese, or ASCII alone
		// when neither is set.
		internal mac      bool
		internal page     ?CodePage
		internal shiftJis bool

		def new() {}

		// The glyph for a codepoint, or none when the font has none -- which is
		// the signal to fall back to another font.
		def lookup(codepoint uint32) ?uint16 {
			if mac {
				return find(codepoint) when codepoint < 0x80
				let code = macCode(codepoint)
				return none when code < 0
				return find(uint32(code))
			}
			let g = find(codepoint)
			return g when !(g is none) || !symbol || codepoint > 0xFF
			return find(0xF000 + codepoint)
		}

		// The code of a non-ASCII code point in the Mac subtable's character
		// set, -1 when it has none.
		internal def macCode(codepoint uint32) int {
			return -1 when codepoint > 0x10FFFF
			let c = char(int(codepoint))
			if shiftJis {
				let code = shiftjis.encode(c)
				return code is none ?? (-1, code)
			}
			let p = page
			return -1 when p is none
			let b = codepages.encode(c, p)
			return b is none ?? (-1, int(b))
		}

		// The code point a code of the Mac subtable stands for, -1 when none.
		internal def macCodePoint(code int) int {
			return code when code < 0x80
			if shiftJis {
				let bytes = code > 0xFF ?? (byte[byte(code >> 8), byte(code & 0xFF)], byte[byte(code)])
				let cp = -1
				for let (i, c) in shiftjis.decode(bytes) {
					return -1 when i > 0
					cp = int(c)
				}
				return cp == 0xFFFD ?? (-1, cp)
			}
			let p = page
			return -1 when p is none || code > 0xFF
			let cp = int(codepages.decode(byte(code), p))
			return cp == 0xFFFD ?? (-1, cp)
		}

		internal def find(codepoint uint32) ?uint16 {
			// Ranges come out of the tables in ascending order, so this is a
			// binary search rather than a scan.
			let lo = 0
			let hi = ranges.len() - 1

			for lo <= hi {
				let mid = (lo + hi) / 2
				let r = ranges[mid]

				if codepoint < r.first {
					hi = mid - 1
					continue
				}
				if codepoint > r.last {
					lo = mid + 1
					continue
				}

				let offset = int(codepoint - r.first)
				return r.startGlyph when r.same
				if r.glyphs.len() > 0 {
					let g = r.glyphs[offset]
					// A zero entry means "no glyph", not glyph 0.
					return none when g == 0
					return g
				}
				let g = (int(r.startGlyph) + offset) & 0xFFFF
				return none when g == 0
				return uint16(g)
			}

			return none
		}

		// The code points the map gives a glyph, as inclusive (first, last)
		// pairs in ascending order: what a font database keeps to answer
		// "which face has this character" without the font loaded. A symbol
		// font's U+F020..F0FF also cover U+0020..00FF.
		def spans() int[] {
			let out int[]
			let add = (first int, last int) => {
				if out.len() >= 2 && out[out.len() - 1] + 1 >= first {
					out[out.len() - 1] = out[out.len() - 1].max(last)
				} else {
					out.push(first)
					out.push(last)
				}
			}
			for let (_, r) in ranges {
				if r.glyphs.len() == 0 {
					let first = int(r.first)
					let last = int(r.last)
					// Consecutive glyphs wrap through glyph 0 at one code point,
					// which then maps to none (format 13 maps them all alike).
					let zero = r.same ?? (-1, first + (65536 - int(r.startGlyph)) % 65536)
					if r.same && r.startGlyph == 0 {} else if zero < first || zero > last {
						add(first, last)
					} else {
						add(first, zero - 1) when zero > first
						add(zero + 1, last) when zero < last
					}
					continue
				}
				let k = 0
				for k < r.glyphs.len() {
					if r.glyphs[k] == 0 {
						k++
						continue
					}
					let j = k
					for j < r.glyphs.len() && r.glyphs[j] != 0 {
						j++
					}
					add(int(r.first) + k, int(r.first) + j - 1)
					k = j
				}
			}
			if mac {
				let codes = out
				out = int[]
				let points int[]
				for let i = 0; i < codes.len(); i += 2 {
					for let code = codes[i]; code <= codes[i + 1] && code <= 0xFFFF; code++ {
						let cp = macCodePoint(code)
						points.push(cp) when cp >= 0
					}
				}
				points.sort((a int, b int) => a < b)
				for let (_, cp) in points {
					add(cp, cp)
				}
				return out
			}
			if symbol {
				let lo = 0
				for lo + 1 < out.len() {
					if out[lo + 1] >= 0xF020 && out[lo] <= 0xF0FF {
						let first = out[lo].max(0xF020) - 0xF000
						let last = out[lo + 1].min(0xF0FF) - 0xF000
						let extra int[]
						extra.push(first)
						extra.push(last)
						out = mergeSpans(out, extra)
						break
					}
					lo += 2
				}
			}
			return out
		}

		// count returns how many character ranges the map holds.
		def count() int {
			return ranges.len()
		}

		// Parses one subtable, which must already be sliced to its own start.
		// Fails when the format is unsupported or the subtable is truncated.
		def parse(format int, sub byte[]) !none {
			return parse0(sub) when format == 0
			return parse2(sub) when format == 2
			return parse4(sub) when format == 4
			return parse6(sub) when format == 6
			return parse8(sub) when format == 8
			return parse10(sub) when format == 10
			return parse12(sub) when format == 12
			return parse13(sub) when format == 13

			fail "unsupported cmap subtable format {format}"
		}

		// Format 0: one byte per codepoint, 256 entries. Only in very old fonts.
		internal def parse0(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, length and language
			try r.skip(6)

			let glyphs uint16[]
			for let i in 0..256 {
				glyphs.push(uint16(try r.readByte()))
			}

			ranges.push(CmapRange{first: 0, last: 255, startGlyph: 0, glyphs: glyphs})
		}

		// Format 2: one- and two-byte codes of a multi-byte character set
		// (Shift JIS, Big5, ...). A lead byte's sub-header lists the trail
		// bytes it takes; sub-header 0 marks single-byte codes.
		internal def parse2(sub byte[]) !none {
			fail "cmap format 2 is truncated" when sub.len() < 6 + 512
			let u16 = (at int) => int(sub[at]) << 8 | int(sub[at + 1])
			let found CmapRange[]
			for let high = 0; high < 256; high++ {
				let k = u16(6 + high * 2) / 8
				let header = 6 + 512 + k * 8
				break when header + 8 > sub.len()
				let firstCode = u16(header)
				let count = u16(header + 2)
				let delta = u16(header + 4)
				// Measured from the idRangeOffset field itself.
				let base = header + 6 + u16(header + 6)
				if k == 0 {
					// A single-byte code: the byte indexes sub-header 0's array.
					continue when high < firstCode || high >= firstCode + count
					let at = base + (high - firstCode) * 2
					continue when at + 2 > sub.len()
					let raw = u16(at)
					continue when raw == 0
					let glyph uint16[]
					glyph.push(uint16((raw + delta) & 0xFFFF))
					found.push(CmapRange{first: uint32(high), last: uint32(high), glyphs: glyph})
					continue
				}
				let glyphs uint16[]
				for let i = 0; i < count && base + i * 2 + 2 <= sub.len(); i++ {
					let raw = u16(base + i * 2)
					glyphs.push(raw == 0 ?? (uint16(0), uint16((raw + delta) & 0xFFFF)))
				}
				continue when glyphs.len() == 0
				let first = high << 8 | firstCode
				found.push(CmapRange{first: uint32(first), last: uint32(first + glyphs.len() - 1), glyphs: glyphs})
			}
			found.sort((a CmapRange, b CmapRange) => a.first < b.first)
			for let (_, r) in found {
				ranges.push(r)
			}
		}

		// Format 8: groups over a mix of 16- and 32-bit codes. The codes are
		// taken as they stand; the bitmap telling the two sizes apart only
		// matters when reading text, not when looking codes up.
		internal def parse8(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, reserved, length, language and the is32 bitmap
			try r.skip(12 + 8192)
			let nGroups = int(try r.read<uint32>())
			for let i in 0..nGroups {
				let first = try r.read<uint32>()
				let last = try r.read<uint32>()
				let startGlyph = try r.read<uint32>()
				continue when first > last
				ranges.push(CmapRange{first: first, last: last, startGlyph: uint16(startGlyph)})
			}
		}

		// Format 6: a single contiguous run with an explicit glyph each.
		internal def parse6(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, length and language
			try r.skip(6)

			let first = int(try r.read<uint16>())
			let count = int(try r.read<uint16>())
			return none when count == 0

			let glyphs uint16[]
			for let i in 0..count {
				glyphs.push(try r.read<uint16>())
			}

			ranges.push(CmapRange{
				first:      uint32(first),
				last:       uint32(first + count - 1),
				startGlyph: 0,
				glyphs:     glyphs
			})
		}

		// Format 4: segmented mapping of the Basic Multilingual Plane. This is
		// the subtable essentially every font has, and the only one many have.
		internal def parse4(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, length and language
			try r.skip(6)

			let segCount = int(try r.read<uint16>()) / 2
			fail "cmap format 4 has no segments" when segCount == 0

			// searchRange, entrySelector and rangeShift: a binary-search hint
			// derivable from segCount, and unreliable in the wild.
			try r.skip(6)

			let endCode uint16[]
			for let i in 0..segCount {
				endCode.push(try r.read<uint16>())
			}

			// reservedPad
			try r.skip(2)

			let startCode uint16[]
			for let i in 0..segCount {
				startCode.push(try r.read<uint16>())
			}

			let idDelta int16[]
			for let i in 0..segCount {
				idDelta.push(try r.read<int16>())
			}

			// Where the idRangeOffset array begins within the subtable: 14
			// bytes of header, endCode, the two-byte reservedPad, then
			// startCode and idDelta -- so 16 + 6*segCount, and dropping the pad
			// from this sum silently shifts every indirect lookup by one glyph.
			// The offsets stored in that array are measured from their own
			// slot, so its position is needed to resolve them.
			let idRangeOffsetPos = 16 + (segCount * 6)

			let idRangeOffset uint16[]
			for let i in 0..segCount {
				idRangeOffset.push(try r.read<uint16>())
			}

			let g = new bytes.Reader(sub, bytes.Endian.Big)

			for let i in 0..segCount {
				let first = int(startCode[i])
				let last = int(endCode[i])

				// A start above the end is malformed. The final segment ends at
				// 0xFFFF and maps like any other (usually to nothing).
				continue when first > last

				if idRangeOffset[i] == 0 {
					// Consecutive glyphs: add the delta, wrapping at 16 bits.
					ranges.push(CmapRange{
						first:      uint32(first),
						last:       uint32(last),
						startGlyph: uint16((first + int(idDelta[i])) & 0xFFFF)
					})
					continue
				}

				// Indirect: the offset points into the glyph array that
				// follows, measured from this segment's own idRangeOffset slot.
				let base = idRangeOffsetPos + (i * 2) + int(idRangeOffset[i])
				let glyphs uint16[]

				for let c in first..(last + 1) {
					let at = base + ((c - first) * 2)
					// A segment pointing past the subtable is malformed; treat
					// the rest of it as unmapped rather than failing the font.
					break when at + 2 > sub.len()

					try g.seek(at)
					let raw = try g.read<uint16>()
					// Zero means unmapped. A real glyph still takes the delta.
					glyphs.push(raw == 0 ?? (uint16(0), uint16((int(raw) + int(idDelta[i])) & 0xFFFF)))
				}

				continue when glyphs.len() == 0

				ranges.push(CmapRange{
					first:      uint32(first),
					last:       uint32(first + glyphs.len() - 1),
					startGlyph: 0,
					glyphs:     glyphs
				})
			}
		}

		// Format 10: a single contiguous run over all of Unicode, 32-bit
		// codes with an explicit glyph each.
		internal def parse10(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, reserved, length and language
			try r.skip(12)

			let first = try r.read<uint32>()
			let count = int(try r.read<uint32>())
			return none when count == 0

			let glyphs uint16[]
			for let i in 0..count {
				glyphs.push(try r.read<uint16>())
			}
			ranges.push(CmapRange{first: first, last: first + uint32(count - 1), startGlyph: 0, glyphs: glyphs})
		}

		// Format 13: ranges that all map to one glyph -- a last-resort font
		// drawing every character of a block the same way.
		internal def parse13(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, reserved, length and language
			try r.skip(12)

			let nGroups = int(try r.read<uint32>())
			for let i in 0..nGroups {
				let first = try r.read<uint32>()
				let last = try r.read<uint32>()
				let glyph = try r.read<uint32>()
				continue when first > last
				ranges.push(CmapRange{first: first, last: last, startGlyph: uint16(glyph), same: true})
			}
		}

		// Format 12: grouped ranges over the whole of Unicode, not just the
		// BMP. Fonts covering emoji or CJK extensions need this.
		internal def parse12(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, reserved, length and language
			try r.skip(12)

			let nGroups = int(try r.read<uint32>())
			for let i in 0..nGroups {
				let first = try r.read<uint32>()
				let last = try r.read<uint32>()
				let startGlyph = try r.read<uint32>()

				continue when first > last

				ranges.push(CmapRange{
					first:      first,
					last:       last,
					startGlyph: uint16(startGlyph)
				})
			}
		}
	}

	// The union of two sorted span lists.
	internal def mergeSpans(a int[], b int[]) int[] {
		let pairs int[]
		for let i = 0; i < a.len(); i += 2 {
			pairs.push(a[i] << 21 | a[i + 1])
		}
		for let i = 0; i < b.len(); i += 2 {
			pairs.push(b[i] << 21 | b[i + 1])
		}
		pairs.sort((x int, y int) => x < y)
		let out int[]
		for let (_, p) in pairs {
			let first = p >> 21
			let last = p & 0x1FFFFF
			if out.len() >= 2 && out[out.len() - 1] + 1 >= first {
				out[out.len() - 1] = out[out.len() - 1].max(last)
			} else {
				out.push(first)
				out.push(last)
			}
		}
		return out
	}

	// Reads the best subtable of the `cmap` table, as HarfBuzz picks it. A
	// font without a usable one gets an empty map: it loads, and every
	// character falls back to another font.
	// Fails when a subtable's records run past the table.
	def readCmap(font Sfnt) !Cmap {
		let cmap = new Cmap()
		let table = font.table("cmap")
		return cmap when table is none

		let r = new bytes.Reader(table, bytes.Endian.Big)
		// version
		try r.skip(2)
		let numTables = int(try r.read<uint16>())

		let bestScore = -1
		let bestOffset = 0
		let bestPlatform = 0
		let bestEncoding = 0

		for let i in 0..numTables {
			let platform = try r.read<uint16>()
			let encoding = try r.read<uint16>()
			let offset = int(try r.read<uint32>())

			continue when offset + 2 > table.len()

			let score = cmapScore(platform, encoding)
			continue when score <= bestScore

			bestScore = score
			bestOffset = offset
			bestPlatform = int(platform)
			bestEncoding = int(encoding)
		}

		return cmap when bestScore < 0

		// Work on the subtable alone from here: format 4 stores offsets
		// relative to positions inside itself, so slicing keeps that arithmetic
		// honest instead of carrying the parent offset through every step.
		let sub = table[bestOffset:]
		let format = int(sub[0]) << 8 | int(sub[1])

		cmap.symbol = bestPlatform == 3 && bestEncoding == 0
		if bestPlatform == 1 {
			cmap.mac = true
			let language = format >= 8 ?? (sub.len() >= 12 ?? (int(sub[10]) << 8 | int(sub[11]), 0), sub.len() >= 6 ?? (int(sub[4]) << 8 | int(sub[5]), 0))
			cmap.page = macCodePage(bestEncoding, language)
			cmap.shiftJis = bestEncoding == 1
		}
		// A format this reader does not know maps nothing, as in HarfBuzz.
		cmap.parse(format, sub) onerror (err error) {
			return new Cmap()
		}
		return cmap
	}
}
