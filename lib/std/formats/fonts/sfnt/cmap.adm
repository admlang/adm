partial module std.formats.fonts.sfnt {
	use std.bytes

	// One contiguous run of codepoints mapping to a run of glyphs.
	//
	// Every subtable format worth supporting is built from runs like this, so
	// parsing collapses them into one representation and lookup does not care
	// which format the font used.
	internal struct CmapRange {
		first      uint32
		last       uint32
		// Glyph for `first`; consecutive codepoints take consecutive glyphs.
		// Ignored when `glyphs` is non-empty.
		startGlyph uint16
		// Explicit glyph per codepoint, for runs that are not consecutive.
		glyphs     uint16[]
	}

	// Platform and encoding pairs, best first.
	//
	// (3,10) and (3,1) are Windows Unicode, full and BMP-only. (0,*) is the
	// platform-independent Unicode encoding. (3,0) is a symbol font, whose
	// codepoints live in a private-use block. (1,0) is Mac Roman, and a last
	// resort.
	internal def cmapScore(platform uint16, encoding uint16) int {
		return 100 when platform == 3 && encoding == 10
		return 90 when platform == 3 && encoding == 1
		return 80 when platform == 0
		return 50 when platform == 3 && encoding == 0
		return 10 when platform == 1 && encoding == 0
		return 0
	}

	// A font's character map: which glyph draws a given codepoint.
	//
	// Ranges are kept rather than expanded into a lookup table. A CJK font maps
	// tens of thousands of codepoints in a handful of runs, and materialising
	// every one of them would cost far more than the search saves.
	type Cmap {
		internal ranges CmapRange[]

		def new() {}

		// The glyph for a codepoint, or none when the font has none -- which is
		// the signal to fall back to another font.
		def lookup(codepoint uint32) ?uint16 {
			// Ranges come out of the tables in ascending order, so this is a
			// binary search rather than a scan.
			let lo = 0
			let hi = ranges.len() - 1

			for lo <= hi {
				let mid = (lo + hi) / 2
				let r = ranges[mid]

				if codepoint < r.first {
					hi = mid - 1
					continue
				}
				if codepoint > r.last {
					lo = mid + 1
					continue
				}

				let offset = int(codepoint - r.first)
				if r.glyphs.len() > 0 {
					let g = r.glyphs[offset]
					// A zero entry means "no glyph", not glyph 0.
					return none when g == 0
					return g
				}
				return uint16(int(r.startGlyph) + offset)
			}

			return none
		}

		def count() int {
			return ranges.len()
		}

		// Parses one subtable, which must already be sliced to its own start.
		def parse(format int, sub byte[]) !none {
			return parse0(sub) when format == 0
			return parse4(sub) when format == 4
			return parse6(sub) when format == 6
			return parse12(sub) when format == 12

			fail "unsupported cmap subtable format ${format}"
		}

		// Format 0: one byte per codepoint, 256 entries. Only in very old fonts.
		internal def parse0(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, length and language
			try r.skip(6)

			let glyphs uint16[]
			for let i in 0..256 {
				glyphs.push(uint16(try r.readByte()))
			}

			ranges.push(CmapRange{first: 0, last: 255, startGlyph: 0, glyphs: glyphs})
		}

		// Format 6: a single contiguous run with an explicit glyph each.
		internal def parse6(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, length and language
			try r.skip(6)

			let first = int(try r.read<uint16>())
			let count = int(try r.read<uint16>())
			return none when count == 0

			let glyphs uint16[]
			for let i in 0..count {
				glyphs.push(try r.read<uint16>())
			}

			ranges.push(CmapRange{
				first: uint32(first),
				last:  uint32(first + count - 1),
				startGlyph: 0,
				glyphs: glyphs
			})
		}

		// Format 4: segmented mapping of the Basic Multilingual Plane. This is
		// the subtable essentially every font has, and the only one many have.
		internal def parse4(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, length and language
			try r.skip(6)

			let segCount = int(try r.read<uint16>()) / 2
			fail "cmap format 4 has no segments" when segCount == 0

			// searchRange, entrySelector and rangeShift: a binary-search hint
			// derivable from segCount, and unreliable in the wild.
			try r.skip(6)

			let endCode uint16[]
			for let i in 0..segCount {
				endCode.push(try r.read<uint16>())
			}

			// reservedPad
			try r.skip(2)

			let startCode uint16[]
			for let i in 0..segCount {
				startCode.push(try r.read<uint16>())
			}

			let idDelta int16[]
			for let i in 0..segCount {
				idDelta.push(try r.read<int16>())
			}

			// Where the idRangeOffset array begins within the subtable: 14
			// bytes of header, endCode, the two-byte reservedPad, then
			// startCode and idDelta -- so 16 + 6*segCount, and dropping the pad
			// from this sum silently shifts every indirect lookup by one glyph.
			// The offsets stored in that array are measured from their own
			// slot, so its position is needed to resolve them.
			let idRangeOffsetPos = 16 + (segCount * 6)

			let idRangeOffset uint16[]
			for let i in 0..segCount {
				idRangeOffset.push(try r.read<uint16>())
			}

			let g = new bytes.Reader(sub, bytes.Endian.Big)

			for let i in 0..segCount {
				let first = int(startCode[i])
				let last = int(endCode[i])

				// The final segment is a sentinel ending at 0xFFFF, and a start
				// above the end is malformed either way.
				continue when first > last || first == 0xFFFF

				if idRangeOffset[i] == 0 {
					// Consecutive glyphs: add the delta, wrapping at 16 bits.
					ranges.push(CmapRange{
						first: uint32(first),
						last:  uint32(last),
						startGlyph: uint16((first + int(idDelta[i])) & 0xFFFF)
					})
					continue
				}

				// Indirect: the offset points into the glyph array that
				// follows, measured from this segment's own idRangeOffset slot.
				let base = idRangeOffsetPos + (i * 2) + int(idRangeOffset[i])
				let glyphs uint16[]

				for let c in first..(last + 1) {
					let at = base + ((c - first) * 2)
					// A segment pointing past the subtable is malformed; treat
					// the rest of it as unmapped rather than failing the font.
					break when at + 2 > sub.len()

					try g.seek(at)
					let raw = try g.read<uint16>()
					// Zero means unmapped. A real glyph still takes the delta.
					glyphs.push(raw == 0 ?? (uint16(0), uint16((int(raw) + int(idDelta[i])) & 0xFFFF)))
				}

				continue when glyphs.len() == 0

				ranges.push(CmapRange{
					first: uint32(first),
					last:  uint32(first + glyphs.len() - 1),
					startGlyph: 0,
					glyphs: glyphs
				})
			}
		}

		// Format 12: grouped ranges over the whole of Unicode, not just the
		// BMP. Fonts covering emoji or CJK extensions need this.
		internal def parse12(sub byte[]) !none {
			let r = new bytes.Reader(sub, bytes.Endian.Big)
			// format, reserved, length and language
			try r.skip(12)

			let nGroups = int(try r.read<uint32>())
			for let i in 0..nGroups {
				let first = try r.read<uint32>()
				let last = try r.read<uint32>()
				let startGlyph = try r.read<uint32>()

				continue when first > last

				ranges.push(CmapRange{
					first: first,
					last:  last,
					startGlyph: uint16(startGlyph)
				})
			}
		}
	}

	// Reads the best available subtable of the `cmap` table.
	def readCmap(font Sfnt) !Cmap {
		let table = font.table("cmap")
		fail "font has no cmap table" when table is none

		let r = new bytes.Reader(table, bytes.Endian.Big)
		// version
		try r.skip(2)
		let numTables = int(try r.read<uint16>())

		let bestScore = -1
		let bestOffset = 0

		for let i in 0..numTables {
			let platform = try r.read<uint16>()
			let encoding = try r.read<uint16>()
			let offset = int(try r.read<uint32>())

			continue when offset >= table.len()

			let score = cmapScore(platform, encoding)
			continue when score <= bestScore

			bestScore = score
			bestOffset = offset
		}

		fail "cmap table has no usable subtable" when bestScore < 0

		// Work on the subtable alone from here: format 4 stores offsets
		// relative to positions inside itself, so slicing keeps that arithmetic
		// honest instead of carrying the parent offset through every step.
		let sub = table[bestOffset:]

		let head = new bytes.Reader(sub, bytes.Endian.Big)
		let format = int(try head.read<uint16>())

		let cmap = new Cmap()
		try cmap.parse(format, sub)
		return cmap
	}
}
