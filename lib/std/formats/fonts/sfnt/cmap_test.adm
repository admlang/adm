partial module std.formats.fonts.sfnt {
	use (
		std.os
		std.testing
		std.data.encoding.codepages::(CodePage)
	)

	// Expected glyphs are those the fixtures' test files list: AOTS for
	// formats 2 and 8 (HarfBuzz leaves both out), the Unicode
	// text-rendering tests (CoreText's answers) for the Mac Turkish font.
	check "Character maps" {
		def cmapOf(path string) !Cmap {
			let s = new Sfnt()
			try s.parse(try os.readFile(path))
			return try readCmap(s)
		}

		def glyphs(cmap Cmap, codes int[]) string {
			let out = ""
			for let (i, c) in codes {
				out += "|" when i > 0
				let g = cmap.lookup(uint32(c))
				out += g is none ?? ("0", "{g}")
			}
			return out
		}

		def covers(spans int[], cp int) bool {
			for let i = 0; i < spans.len(); i += 2 {
				return true when spans[i] <= cp && cp <= spans[i + 1]
			}
			return false
		}

		@test()
		def readsMacCodePagesByLanguage() !none {
			// A Mac Roman-script subtable whose language is Turkish.
			let cmap = try cmapOf("samples/fonts/ttf/TestCMAPMacTurkish.ttf")
			assert glyphs(cmap, [0x201C, 0x41, 0xC7, 0x11E, 0x130, 0x15E, 0x131, 0x15F]) == "200|34|126|176|178|181|222|182" // Turkish letters
			let spans = cmap.spans()
			assert covers(spans, 0x11E) && covers(spans, 0x41) && !covers(spans, 0xFB01) // spans in code points; Mac Roman has ﬁ at 0xDE, Turkish Ş
		}

		@test()
		def readsFormats2And8() !none {
			let two = try cmapOf("samples/fonts/otf/cmap2_font1.otf")
			assert glyphs(two, [0x0, 0x1, 0x33, 0x34, 0x35, 0x36, 0x37, 0x8431, 0x8432, 0x8434, 0x9232, 0xFFFF]) == "0|0|0|17|56|12|0|0|20|22|23|0" // format 2
			let eight = try cmapOf("samples/fonts/otf/cmap8_font1.otf")
			assert glyphs(eight, [0x0, 0x1, 0x33, 0x34, 0x35, 0x36, 0x37, 0x8431, 0x8432, 0x8434, 0x9232, 0x109422, 0x109423, 0x109424, 0x109425, 0xFFFF]) == "0|0|0|17|56|12|0|0|20|22|23|0|26|27|32|0" // format 8
		}

		@test()
		def prefersSymbolSubtables() !none {
			assert cmapScore(3, 0) > cmapScore(3, 10) // HarfBuzz picks symbol first
			assert cmapScore(1, 0) > cmapScore(1, 7) && cmapScore(1, 7) > 0 // Mac Roman, then any Mac
			let turkish = macCodePage(0, 18)
			let cyrillic = macCodePage(7, 0)
			fail "no code page" when turkish is none || cyrillic is none
			assert turkish == CodePage.MacTurkish // language is the Mac code + 1
			assert cyrillic == CodePage.MacCyrillic
			assert macCodePage(2, 0) is none // Traditional Chinese maps ASCII only
		}
	}
}
