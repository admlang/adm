partial module std.formats.fonts.sfnt {
	// The `head` table: font-wide values every other table is interpreted
	// against.
	struct Head {
		// Design grid the outlines are drawn on, typically 1000 or 2048.
		unitsPerEm       uint16
		// Bit 0 is italic, bit 5 is bold. The same claims appear in `OS/2`,
		// which is the one to trust when they disagree.
		macStyle         uint16
		// Box enclosing every glyph in the font, in font units.
		xMin             int16
		yMin             int16
		xMax             int16
		yMax             int16
		// 0 when `loca` holds 16-bit offsets, 1 when it holds 32-bit ones.
		// Reading `loca` without this gives garbage for every glyph.
		indexToLocFormat int16
	}

	internal const headMagic = 0x5F0F3CF5

	// readHead reads the head table: units per em, the bounding box, the loca
	// format and the rest. Fails when the font has no head table or it is
	// truncated.
	def readHead(font Sfnt) !Head {
		let r = font.reader("head")
		fail "font has no head table" when r is none

		// version, fontRevision, checkSumAdjustment
		try r.skip(12)

		let magic = try r.read<uint32>()
		fail "head table has a bad magic number" when magic != headMagic

		// flags
		try r.skip(2)
		let unitsPerEm = try r.read<uint16>()
		// A zero would make every scale factor a division by zero downstream.
		fail "head table has an invalid unitsPerEm" when unitsPerEm == 0

		// created and modified, 8 bytes each.
		try r.skip(16)

		let head = Head{
			unitsPerEm: unitsPerEm,
			xMin: try r.read<int16>(),
			yMin: try r.read<int16>(),
			xMax: try r.read<int16>(),
			yMax: try r.read<int16>(),
			macStyle: try r.read<uint16>()
		}

		// lowestRecPPEM, fontDirectionHint
		try r.skip(4)
		head.indexToLocFormat = try r.read<int16>()

		return head
	}
}
