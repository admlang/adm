partial module std.formats.fonts.sfnt {
	// The `hhea` table: horizontal metrics that apply to the whole face.
	struct Hhea {
		// Above the baseline, positive.
		ascender         int16
		// Below the baseline, negative.
		descender        int16
		// Extra leading between lines, on top of ascender - descender.
		lineGap          int16
		// How many glyphs at the start of `hmtx` carry their own advance. Every
		// glyph after that reuses the last one's, which is how monospaced and
		// CJK fonts avoid storing the same advance thousands of times.
		numberOfHMetrics uint16
	}

	// readHhea reads the horizontal header: ascent, descent, line gap and how
	// many horizontal metrics follow. Fails when the font has no hhea table or it
	// is truncated.
	def readHhea(font Sfnt) !Hhea {
		let r = font.reader("hhea")
		fail "font has no hhea table" when r is none

		// version
		try r.skip(4)

		let hhea = Hhea{
			ascender:  try r.read<int16>(),
			descender: try r.read<int16>(),
			lineGap:   try r.read<int16>()
		}

		// advanceWidthMax, minLeftSideBearing, minRightSideBearing, xMaxExtent,
		// caretSlopeRise, caretSlopeRun, caretOffset, four reserved fields and
		// metricDataFormat: 12 int16s, putting numberOfHMetrics at offset 34 of
		// a 36-byte table.
		try r.skip(24)
		hhea.numberOfHMetrics = try r.read<uint16>()

		return hhea
	}

	// One glyph's horizontal metrics, in font units.
	struct HMetric {
		advance         uint16
		leftSideBearing int16
	}

	// The `hmtx` table, expanded so every glyph has an entry.
	//
	// On disk it is `numberOfHMetrics` full entries followed by bearings alone;
	// this fills the tail in with the last advance, which is what the format
	// means by omitting them.
	// Fails when the font has no hmtx table or it is shorter than the metrics count.
	def readHMetrics(font Sfnt, hhea Hhea, glyphCount uint16) !HMetric[] {
		let r = font.reader("hmtx")
		fail "font has no hmtx table" when r is none

		let paired = int(hhea.numberOfHMetrics)
		fail "hmtx table claims no metrics" when paired == 0

		let total = int(glyphCount)
		// A font claiming more paired metrics than it has glyphs is malformed;
		// clamping keeps the read inside the table.
		paired = total when paired > total

		let out HMetric[]
		let advance uint16 = 0

		for let i in 0..paired {
			advance = try r.read<uint16>()
			out.push(HMetric{advance: advance, leftSideBearing: try r.read<int16>()})
		}

		// Remaining glyphs repeat the final advance and carry only a bearing.
		// A font may stop short of the count `maxp` claims, so a missing bearing
		// is treated as zero rather than failing the whole face.
		for let i in paired..total {
			out.push(HMetric{
				advance: advance,
				leftSideBearing: r.read<int16>() onerror recover int16(0)
			})
		}

		return out
	}
}
