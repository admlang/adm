partial module std.formats.fonts.sfnt {
	// The `maxp` table. Only the glyph count matters outside the rasteriser;
	// the rest sizes hinting workspaces this implementation does not use.
	// Fails when the font has no maxp table or it is truncated.
	def readGlyphCount(font Sfnt) !uint16 {
		let r = font.reader("maxp")
		fail "font has no maxp table" when r is none

		// version
		try r.skip(4)
		return try r.read<uint16>()
	}
}
