partial module std.formats.fonts.sfnt {
	use std.bytes

	// The name IDs worth reading. A font carries many more -- copyright,
	// trademark, sample text -- none of which matter for identifying a face.
	internal const (
		nameIDFamily               = 1
		nameIDSubfamily            = 2
		nameIDPostScript           = 6
		// The "typographic" pair supersedes 1 and 2 for families with more than
		// four members, where 1/2 are forced to squeeze into the old
		// Regular/Bold/Italic/BoldItalic model. `Source Sans Pro Black` is
		// family 16 "Source Sans Pro", subfamily 17 "Black", while family 1
		// says "Source Sans Pro Black" and subfamily 2 says "Regular".
		nameIDTypographicFamily    = 16
		nameIDTypographicSubfamily = 17
	)

	// The names a font records about itself.
	struct Names {
		family     string
		subfamily  string
		postscript string
	}

	// Decodes UTF-16BE, which is what every Windows and Unicode name record
	// uses, into a string.
	//
	// Surrogate pairs are combined; a lone surrogate is dropped rather than
	// emitted as invalid UTF-8.
	internal def decodeUTF16BE(raw byte[]) string {
		let out byte[]
		let i = 0

		for i + 1 < raw.len() {
			let unit = (int(raw[i]) << 8) | int(raw[i + 1])
			i += 2

			let cp = unit
			if unit >= 0xD800 && unit <= 0xDBFF {
				// High surrogate: needs the low half to mean anything.
				break when i + 1 >= raw.len()
				let low = (int(raw[i]) << 8) | int(raw[i + 1])
				continue when low < 0xDC00 || low > 0xDFFF
				i += 2
				cp = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
			} else if unit >= 0xDC00 && unit <= 0xDFFF {
				// Unpaired low surrogate.
				continue
			}

			if cp < 0x80 {
				out.push(byte(cp))
			} else if cp < 0x800 {
				out.push(byte(0xC0 | (cp >> 6)))
				out.push(byte(0x80 | (cp & 0x3F)))
			} else if cp < 0x10000 {
				out.push(byte(0xE0 | (cp >> 12)))
				out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
				out.push(byte(0x80 | (cp & 0x3F)))
			} else {
				out.push(byte(0xF0 | (cp >> 18)))
				out.push(byte(0x80 | ((cp >> 12) & 0x3F)))
				out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
				out.push(byte(0x80 | (cp & 0x3F)))
			}
		}

		return string(out)
	}

	// Whether a name ID is one of the few worth decoding.
	internal def wantedNameID(id int) bool {
		return true when id == nameIDFamily || id == nameIDSubfamily
		return true when id == nameIDPostScript
		return true when id == nameIDTypographicFamily || id == nameIDTypographicSubfamily
		return false
	}

	// How much a name record is preferred, so the best encoding of a given name
	// wins regardless of the order records appear in.
	//
	// Windows Unicode first, then platform-independent Unicode, then Mac Roman
	// -- which is only read as ASCII here, and is a last resort for that reason.
	internal def nameScore(platform uint16, encoding uint16) int {
		return 30 when platform == 3 && (encoding == 1 || encoding == 10)
		return 20 when platform == 0
		return 10 when platform == 1 && encoding == 0
		return 0
	}

	// Reads the `name` table.
	//
	// A missing name is an empty string rather than a failure: plenty of fonts
	// omit one, and a face is still usable without it.
	def readNames(font Sfnt) !Names {
		let table = font.table("name")
		fail "font has no name table" when table is none

		let r = new bytes.Reader(table, bytes.Endian.Big)
		// format
		try r.skip(2)
		let count = int(try r.read<uint16>())
		let storage = int(try r.read<uint16>())

		let names = Names{}
		// Best score seen for each field, so a later worse-encoded record does
		// not overwrite a better one.
		let bestFamily = -1
		let bestSubfamily = -1
		let bestPostScript = -1

		for let i in 0..count {
			let platform = try r.read<uint16>()
			let encoding = try r.read<uint16>()
			// languageID: only used to prefer English, which the scoring below
			// ignores -- a font's first record is overwhelmingly English.
			try r.skip(2)
			let nameID = int(try r.read<uint16>())
			let length = int(try r.read<uint16>())
			let offset = int(try r.read<uint16>())

			// Skip anything that is not one of the few IDs worth reading before
			// paying for the string decode.
			continue unless wantedNameID(nameID)

			let from = storage + offset
			continue when from < 0 || from + length > table.len() || length <= 0

			let score = nameScore(platform, encoding)
			continue when score == 0

			// The typographic pair describes the family better, so it outranks
			// any encoding of the legacy pair.
			let effective = score
			effective += 100 when nameID == nameIDTypographicFamily || nameID == nameIDTypographicSubfamily

			let raw = table[from:from + length]
			// Only Mac Roman is single-byte here; everything else scored above
			// is UTF-16BE.
			let value = platform == 1 ?? (string(raw), decodeUTF16BE(raw))
			continue when value.len() == 0

			if nameID == nameIDFamily || nameID == nameIDTypographicFamily {
				if effective > bestFamily {
					bestFamily = effective
					names.family = value
				}
				continue
			}
			if nameID == nameIDSubfamily || nameID == nameIDTypographicSubfamily {
				if effective > bestSubfamily {
					bestSubfamily = effective
					names.subfamily = value
				}
				continue
			}
			if effective > bestPostScript {
				bestPostScript = effective
				names.postscript = value
			}
		}

		return names
	}
}
