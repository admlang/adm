partial module std.formats.fonts.sfnt {
	use std.bytes

	internal const (
		os2SelectionItalic  = 0x0001
		os2SelectionBold    = 0x0020
		os2SelectionOblique = 0x0200
	)

	// The `OS/2` table: the weight, width and slant a font matcher selects on.
	//
	// `head.macStyle` makes the same italic and bold claims in two bits. When
	// they disagree this table is the one to believe -- it is what shapers and
	// font databases read, and it carries the full 100..900 scale rather than a
	// single bold flag.
	type Os2 {
		// OpenType 100..900.
		weightClass uint16
		// OpenType 1..9, 5 being normal width.
		widthClass  uint16
		// Bit 0 italic, bit 5 bold, bit 6 regular, bit 9 oblique.
		selection   uint16
		// Zero in version 0, which predates both fields.
		xHeight     int16
		capHeight   int16
		version     uint16

		def isItalic() bool {
			return (selection & os2SelectionItalic) != 0 || (selection & os2SelectionOblique) != 0
		}

		def isBold() bool {
			return (selection & os2SelectionBold) != 0
		}
	}

	def readOs2(font Sfnt) !Os2 {
		let r = font.reader("OS/2")
		fail "font has no OS/2 table" when r is none

		let os2 = new Os2()
		os2.version = try r.read<uint16>()

		// xAvgCharWidth
		try r.skip(2)
		os2.weightClass = try r.read<uint16>()
		os2.widthClass = try r.read<uint16>()

		// fsType, the subscript, superscript and strikeout metrics,
		// sFamilyClass, panose, ulUnicodeRange and achVendID: bytes 8..61.
		try r.skip(54)
		os2.selection = try r.read<uint16>()

		// usFirstCharIndex through usWinDescent.
		try r.skip(14)

		// sxHeight and sCapHeight arrived in version 2. Reading them from a
		// version 0 or 1 table would return whatever follows the table.
		if os2.version >= 2 {
			// ulCodePageRange1 and 2, added in version 1.
			try r.skip(8)
			os2.xHeight = try r.read<int16>()
			os2.capHeight = try r.read<int16>()
		}

		return os2
	}
}
