partial module std.formats.fonts.sfnt {
	use std.bytes

	// The `post` table: the parts a text renderer needs.
	//
	// Versions 2.0 and 2.5 also carry glyph names, which matter for PostScript
	// output and for looking a glyph up by name. Nothing here needs them yet, so
	// only the header is read.
	struct Post {
		// Where to draw an underline relative to the baseline, in font units.
		// Negative, since underlines sit below it.
		underlinePosition  int16
		underlineThickness int16
		// Every glyph advances by the same amount.
		fixedPitch bool
	}

	def readPost(font Sfnt) !Post {
		let r = font.reader("post")
		fail "font has no post table" when r is none

		// version and italicAngle
		try r.skip(8)

		let post = Post{
			underlinePosition:  try r.read<int16>(),
			underlineThickness: try r.read<int16>()
		}
		post.fixedPitch = (try r.read<uint32>()) != 0

		return post
	}
}
