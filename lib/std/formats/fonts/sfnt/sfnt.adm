// The sfnt container: the table directory shared by every OpenType-family font.
//
// ttf, otf and the compressed wrappers (woff, woff2, eot) all hold the same
// thing -- a directory of four-character-tagged tables -- and differ only in how
// those bytes are packaged. Parsing the directory and the tables common to all
// of them lives here once, so a format-specific codec is left with only what
// makes it different: TrueType outlines, CFF charstrings, or a decompression
// step in front.

partial module std.formats.fonts.sfnt {
	use (
		std.bytes
		std.io
	)

	// sfnt version tags, the first four bytes of the file.
	internal const (
		// TrueType outlines: `glyf`/`loca`.
		versionTrueType   = 0x00010000
		// CFF outlines. The literal is 'OTTO'.
		versionCFF        = 0x4F54544F
		// Apple TrueType, still `glyf`/`loca`. The literal is 'true'.
		versionApple      = 0x74727565
		// A collection holding several fonts. The literal is 'ttcf'.
		versionCollection = 0x74746366
	)

	// One entry of the table directory: where a table lives in the file.
	struct TableRecord {
		// Four-character tag: "cmap", "glyf", "head".
		tag      string
		checksum uint32
		offset   uint32
		length   uint32
	}

	// A parsed sfnt font: the table directory plus the bytes it points into.
	//
	// The whole file is held in memory. Fonts are tens to hundreds of kilobytes
	// and every table is reached by absolute offset, so streaming would mean
	// seeking backwards constantly for no saving worth having.
	type Sfnt {
		// Raw file bytes. Table offsets index into this.
		internal data    byte[]
		internal version uint32
		internal records map<string, TableRecord>

		// Number of glyphs, from `maxp`. Cached because bounds checks need it.
		glyphCount uint16

		def new() {
			records = new map<string, TableRecord>()
		}

		// Reads the table directory at `offset` in `data`.
		//
		// `offset` is 0 for a plain font and the font's entry in the collection
		// directory for a `.ttc`.
		// Fails when the data is not an sfnt directory or the offset lies outside it.
		def parse(data byte[], offset uint32 = 0) !none {
			self.data = data

			let r = new bytes.Reader(data, bytes.Endian.Big)
			try r.seek(int(offset))

			version = try r.read<uint32>()
			if version != versionTrueType && version != versionCFF && version != versionApple {
				fail "not an sfnt font: unknown version ${version}"
			}

			let numTables = try r.read<uint16>()
			// searchRange, entrySelector and rangeShift are a binary-search hint
			// that is redundant with numTables, and is wrong often enough in real
			// fonts that nothing should depend on it.
			try r.skip(6)

			let tagBuf byte[]
			tagBuf.len(4)

			for let i in 0..int(numTables) {
				try r.read(tagBuf)
				let tag = string(tagBuf)
				let record = TableRecord{
					tag:      tag,
					checksum: try r.read<uint32>(),
					offset:   try r.read<uint32>(),
					length:   try r.read<uint32>()
				}

				// A record pointing outside the file would make every later read
				// of that table a silent out-of-bounds, so drop it here.
				continue when int(record.offset) + int(record.length) > data.len()

				records.set(tag, record)
			}
		}

		// Reads the directory from `reader`, consuming all of it.
		// Fails when the reader does, or the data is not an sfnt directory.
		def parse(reader io.Reader) !none {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return parse(buf.bytes())
		}

		// Whether the font carries a table.
		def has(tag string) bool {
			return !(records.get(tag) is none)
		}

		// The bytes of one table, or none when the font has no such table.
		def table(tag string) ?byte[] {
			let record = records.get(tag)
			return none when record is none
			return data[int(record.offset):int(record.offset) + int(record.length)]
		}

		// A big-endian reader positioned at the start of a table.
		def reader(tag string) ?bytes.Reader {
			let t = table(tag)
			return none when t is none
			return new bytes.Reader(t, bytes.Endian.Big)
		}

		// Whether outlines are TrueType (`glyf`/`loca`) rather than CFF.
		def isTrueType() bool {
			return version == versionTrueType || version == versionApple
		}

		// tags lists the tags of the tables the font carries.
		def tags() string[] {
			let out string[]
			for let (tag, _) in records {
				out.push(tag)
			}
			return out
		}
	}
}
