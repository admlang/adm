partial module std.formats.fonts {
	use std.formats.fonts.layout

	// The faces shaped with so far, each with its tables read and checked once
	// (`layout.ShapeFont`) and the plans its runs were shaped with: making those
	// is most of the time a short run takes. Runs are shaped under the lock, as a
	// font fills its glyph caches as it goes.
	internal type ShapeFonts {
		faces Face[]
		fonts layout.ShapeFont[]
		plans layout.PlanCache[]
		used  int[]
		clock int

		atomic def shape(face Face, text string, opts ShapeOptions) ShapedRun {
			clock++
			let at = -1
			for let (i, f) in faces {
				if f == face {
					at = i
					break
				}
			}
			if at < 0 {
				// A program shapes with a handful of faces; past that many the one
				// used longest ago goes.
				if faces.len() >= maxShapeFonts {
					let oldest = 0
					for let (i, u) in used {
						oldest = i when u < used[oldest]
					}
					faces.remove(oldest)
					fonts.remove(oldest)
					plans.remove(oldest)
					used.remove(oldest)
				}
				faces.push(face)
				fonts.push(new layout.ShapeFont(face))
				plans.push(new layout.PlanCache())
				used.push(0)
				at = faces.len() - 1
			}
			used[at] = clock
			return shapeWith(fonts[at], plans[at], text, opts)
		}
	}

	// How many faces `ShapeFonts` keeps.
	const maxShapeFonts = 32

	// The faces `shapeRun` shaped with, program-wide.
	internal let shapeFonts = new ShapeFonts()

	internal def shapeRun(face Face, text string, opts ShapeOptions) ShapedRun {
		return shapeFonts.shape(face, text, opts)
	}

	internal def shapeWith(font layout.ShapeFont, plans layout.PlanCache, text string, opts ShapeOptions) ShapedRun {
		font.ptem = opts.pointSize
		let direction = layout.dirLTR
		match opts.direction {
			case TextDirection.LeftToRight:
				direction = layout.dirLTR
			case TextDirection.RightToLeft:
				direction = layout.dirRTL
			case TextDirection.TopToBottom:
				direction = layout.dirTTB
		}
		let extra layout.UserFeature[]
		for let (_, f) in opts.featureRanges {
			extra.push(layout.UserFeature{tag: f.tag, value: f.value, start: f.start, end: f.end})
		}
		let b = layout.shapeText(font, text, opts.script, opts.language, direction, opts.features, layout.flagBeginningOfText | layout.flagEndOfText, extra, opts.concatFlags, plans)
		let run = ShapedRun{direction: opts.direction}
		for let i = 0; i < b.len; i++ {
			run.glyphs.push(ShapedGlyph{
				glyph:          GlyphID(b.info.glyph[i]),
				xOffset:        clamp16(b.pos.xOffset[i]),
				yOffset:        clamp16(b.pos.yOffset[i]),
				xAdvance:       clamp16(b.pos.xAdvance[i]),
				yAdvance:       clamp16(b.pos.yAdvance[i]),
				cluster:        b.info.cluster[i],
				unsafeToBreak:  b.info.mask[i] & layout.flagUnsafeToBreak != 0,
				unsafeToConcat: b.info.mask[i] & layout.flagUnsafeToConcat != 0
			})
		}
		return run
	}

	internal def clamp16(v int) int16 {
		return int16(v.clamp(-32768, 32767))
	}

	internal def featureTags(face Face) string[] {
		let out string[]
		return out when !(face is OpenTypeFace)
		let font = new layout.ShapeFont(face)
		for let (_, table) in [font.gsub, font.gpos] {
			for let i = 0; i < table.featureCount(); i++ {
				let tag = table.featureTag(i)
				out.push(tag) when out.indexOf(tag) < 0
			}
		}
		for let (_, tag) in font.morx.featureTags() {
			out.push(tag) when out.indexOf(tag) < 0
		}
		return out
	}
}
