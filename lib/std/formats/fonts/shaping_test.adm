partial module std.formats.fonts {
	use (
		std.os
		std.testing
	)

	// Expected runs are HarfBuzz 14.1's for the same text with --bot --eot,
	// written the way hb-shape prints them: glyph=cluster@x,y+advance.
	check "Text shaping" {
		def face(name string) ?Face {
			let data = os.readFile("samples/fonts/ttf/" + name)
			return none when data is error
			let font = load(data)
			return none when font is error
			let f = font.face(0)
			return f is error ?? (none, f)
		}

		def render(run ShapedRun) string {
			let s = "["
			for let (i, g) in run.glyphs {
				s += "|" when i > 0
				s += "{int(g.glyph)}={g.cluster}"
				s += "@{g.xOffset},{g.yOffset}" when g.xOffset != int16(0) || g.yOffset != int16(0)
				s += "+{g.xAdvance}"
			}
			return s + "]"
		}

		@test()
		def ligaturesAndKerning() !none {
			let proxima = face("ProximaNova-Bold.ttf")
			return none when proxima is none
			// "ffi" and "fl" ligate; clusters point at the first letter.
			assert render(try shape(proxima, "office fly")) == "[82=0+1177|661=1+1857|70=4+1021|72=5+1132|3=6+526|660=7+1187|92=9+1050]" // ligatures
			// GPOS pair kerning (AV, VA, AT, Ty, To).
			assert render(try shape(proxima, "AVATAR Toyota")) == "[36=0+1304|57=1+1304|36=2+1269|55=3+1060|36=4+1400|53=5+1316|3=6+526|55=7+990|82=8+1177|92=9+1050|82=10+1177|87=11+692|68=12+1112]" // kerning
		}

		@test()
		def composesAccentsTheFontHas() !none {
			let source = face("SourceSansPro-Black.ttf")
			return none when source is none
			// e + U+0301 and n + U+0303 become the precomposed glyphs; clusters
			// are byte offsets.
			assert render(try shape(source, "é ñ 1/2")) == "[285=0+526|1=3+200|347=4+582|1=7+200|1088=8+540|1181=9+334|1089=10+540]" // composition
		}

		@test()
		def mirrorsInRightToLeftText() !none {
			let source = face("SourceSansPro-Black.ttf")
			return none when source is none
			let run = try shape(source, "(ab)", ShapeOptions{direction: TextDirection.RightToLeft})
			// Visual order, parentheses swapped for their mirrors.
			assert render(run) == "[1175=3+360|29=2+570|28=1+536|1176=0+360]" // mirrored
		}

		@test()
		def featuresCanBeTurnedOff() !none {
			let source = face("SourceSansPro-Black.ttf")
			return none when source is none
			let run = try shape(source, "office AV", ShapeOptions{features: map<string, bool>{"liga": false, "kern": false}})
			assert render(run) == "[42=0+560|33=1+360|33=2+360|36=3+288|30=4+472|32=5+526|1=6+200|2=7+584|23=8+572]" // no ligatures, no kerning
		}

		@test()
		def listsFeatureTags() !none {
			let source = face("SourceSansPro-Black.ttf")
			return none when source is none
			let tags = features(source)
			assert tags.indexOf("liga") >= 0 // GSUB feature
			assert tags.indexOf("kern") >= 0 // GPOS feature
		}
	}
}
