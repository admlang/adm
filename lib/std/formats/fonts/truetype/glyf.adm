partial module std.formats.fonts.truetype {
	use (
		std.bytes
		std.math.geom
		std.formats.fonts
		std.formats.fonts.sfnt
		std.formats.fonts.variations
		std.formats.fonts.layout
	)

	// Point flags, as stored in a simple glyph.
	internal const (
		flagOnCurve         = 0x01
		flagXShort          = 0x02
		flagYShort          = 0x04
		flagRepeat          = 0x08
		// When the matching short bit is set this is the sign of the delta;
		// when it is clear it means "same as the previous coordinate".
		flagXSameOrPositive = 0x10
		flagYSameOrPositive = 0x20
	)

	// Composite glyph component flags.
	internal const (
		compArgsAreWords   = 0x0001
		compArgsAreXY      = 0x0002
		compHasScale       = 0x0008
		compMoreComponents = 0x0020
		compHasXYScale     = 0x0040
		compHasTwoByTwo    = 0x0080
	)

	// How deep a composite may nest before it is treated as malformed. Real
	// fonts rarely go past two, and a cycle would otherwise recurse forever.
	internal const maxCompositeDepth = 8

	// One point of a glyph contour, in font units.
	internal struct GlyphPoint {
		x       float
		y       float
		// Off-curve points are quadratic control points.
		onCurve bool
	}

	// Composite flags beyond the ones above.
	internal const (
		compUseMyMetrics   = 0x0200
		compScaledOffset   = 0x0800
		compUnscaledOffset = 0x1000
	)

	// Phantom points follow a glyph's own points: left and right give the
	// horizontal origin and advance, top and bottom the vertical ones.
	internal const (
		phantomLeft   = 0
		phantomRight  = 1
		phantomTop    = 2
		phantomBottom = 3
		phantomCount  = 4
	)

	// Reads one glyph's outline.
	//
	// Returns an empty outline for a glyph with no data, which is how a space
	// is stored, rather than failing.
	// Fails when the glyph data is truncated or malformed.
	def readGlyph(font sfnt.Sfnt, loca Loca, id uint16) !fonts.Outline {
		let loader = new GlyphLoader(font, loca)
		return loader.outline(int(id))
	}

	// Loads glyphs as points, the form variations and metrics work on:
	// contours, component offsets and the four phantom points, moved to the
	// instance at `coords` when the font has `gvar` deltas.
	type GlyphLoader {
		internal font     sfnt.Sfnt
		internal loca     Loca
		internal glyf     byte[]
		internal hmetric  sfnt.HMetric[]
		internal vmtx     byte[]
		internal vmetrics int
		internal upem     int
		internal gvar     variations.Gvar
		internal coords   int[]

		// `hmetric` and the vertical metrics place the phantom points; `gvar`
		// and `coords` (F2Dot14, one per axis) pick the instance.
		def new(font sfnt.Sfnt, loca Loca, hmetric sfnt.HMetric[] = sfnt.HMetric[], vmtx byte[] = byte[], vmetrics int = 0, upem int = 1000, gvar variations.Gvar = new variations.Gvar(), coords int[] = int[]) {
			self.font = font
			self.loca = loca
			let t = font.table("glyf")
			glyf = t is none ?? (byte[], t)
			self.hmetric = hmetric
			self.vmtx = vmtx
			self.vmetrics = vmetrics
			self.upem = upem
			self.gvar = gvar
			self.coords = coords
		}

		// The glyph's outline in font units. Fails when the glyph data is
		// malformed.
		def outline(id int) !fonts.Outline {
			let pts = try points(id)
			let segs fonts.Segment[]
			let n = pts.len() - phantomCount
			let start = 0
			for let i = 0; i < n; i++ {
				continue unless pts.ends[i]
				// A contour that opens off-curve is drawn from its last point,
				// as FreeType and CoreText do.
				let contour GlyphPoint[]
				let last = i
				if !pts.on[start] {
					contour.push(GlyphPoint{x: float(pts.xs[i]), y: float(pts.ys[i]), onCurve: pts.on[i]})
					last = i - 1
				}
				for let k = start; k <= last; k++ {
					contour.push(GlyphPoint{x: float(pts.xs[k]), y: float(pts.ys[k]), onCurve: pts.on[k]})
				}
				emitContour(contour, segs)
				start = i + 1
			}
			return new fonts.Outline(segs)
		}

		// The glyph's points with its four phantom points last, shifted so the
		// left phantom sits at x = 0. Fails when the glyph data is malformed.
		def points(id int) !variations.GlyphPoints {
			let all = new variations.GlyphPoints()
			try collect(id, all, 0)
			let n = all.len()
			let shift = all.xs[n - phantomCount + phantomLeft]
			if shift != float32(0.0) {
				for let i = 0; i < n; i++ {
					all.xs[i] -= shift
				}
			}
			return all
		}

		// The advance of glyph `id` from its phantom points, rounded:
		// horizontal, or vertical when `vertical`. Fails when the glyph data is
		// malformed.
		def advance(id int, vertical bool = false) !int {
			let pts = try points(id)
			let n = pts.len()
			let p = n - phantomCount
			let v = vertical ?? (pts.ys[p + phantomTop] - pts.ys[p + phantomBottom], pts.xs[p + phantomRight] - pts.xs[p + phantomLeft])
			return layout.roundHalfUp(v).max(0)
		}

		// The glyph's bytes, empty for a blank glyph.
		internal def bytesOf(id int) byte[] {
			let span = loca.range(uint16(id))
			return byte[] when id < 0 || id > 65535 || span is none
			let (from, to) = span
			return byte[] when to <= from || int(to) > glyf.len()
			return glyf[int(from):int(to)]
		}

		// Appends glyph `id`'s points and its phantoms to `all`.
		internal def collect(id int, all variations.GlyphPoints, depth int) !none {
			fail "composite glyph nesting is too deep" when depth > maxCompositeDepth
			let data = bytesOf(id)
			let contours = 0
			let xMin = 0
			let yMax = 0
			if data.len() >= 10 {
				let r = new bytes.Reader(data, bytes.Endian.Big)
				contours = int(try r.read<int16>())
				xMin = int(try r.read<int16>())
				try r.skip(2)
				try r.skip(2)
				yMax = int(try r.read<int16>())
			}

			// The glyph's own points: contours of a simple glyph, one offset
			// per component of a composite.
			let simple = data.len() >= 10 && contours >= 0
			let composite = data.len() >= 10 && contours < 0
			let own = simple ?? (all, new variations.GlyphPoints())
			let base = own.len()
			let parts Component[]
			if simple {
				try readSimplePoints(data, contours, own)
			} else if composite {
				parts = try readComponents(data)
				for let (_, c) in parts {
					let xy = c.flags & compArgsAreXY != 0
					own.push(xy ?? (float32(c.dx), float32(0.0)), xy ?? (float32(c.dy), float32(0.0)), true)
				}
			}

			// Phantom points from the unvaried metrics.
			let lsb = id < hmetric.len() ?? (int(hmetric[id].leftSideBearing), 0)
			let hAdvance = id < hmetric.len() ?? (int(hmetric[id].advance), upem / 2)
			let (vAdvance, tsb) = verticalMetrics(id)
			let hDelta = xMin - lsb
			let vOrigin = yMax + tsb
			own.push(float32(hDelta), float32(0.0), false)
			own.push(float32(hAdvance + hDelta), float32(0.0), false)
			own.push(float32(0.0), float32(vOrigin), false)
			own.push(float32(0.0), float32(vOrigin - vAdvance), false)

			if variations.varied(coords) && gvar.present() {
				let slice = simple ?? (sub(own, base), own)
				fail "glyph {id} has malformed variation data" unless gvar.apply(id, coords, slice)
				if simple {
					for let i = 0; i < slice.len(); i++ {
						own.xs[base + i] = slice.xs[i]
						own.ys[base + i] = slice.ys[i]
					}
				}
			}
			return none when simple

			let phantoms = own.len() - phantomCount
			if composite {
				for let (k, c) in parts {
					let before = all.len()
					try collect(c.glyph, all, depth + 1)
					let childEnd = all.len()
					if c.flags & compUseMyMetrics != 0 {
						for let p = 0; p < phantomCount; p++ {
							own.xs[phantoms + p] = all.xs[childEnd - phantomCount + p]
							own.ys[phantoms + p] = all.ys[childEnd - phantomCount + p]
						}
					}
					let tx = own.xs[k]
					let ty = own.ys[k]
					let scaledFirst = c.flags & (compScaledOffset | compUnscaledOffset) == compScaledOffset
					let identity = c.a == float32(1.0) && c.b == float32(0.0) && c.c == float32(0.0) && c.d == float32(1.0)
					for let i = before; i < childEnd; i++ {
						if scaledFirst {
							all.xs[i] += tx
							all.ys[i] += ty
						}
						if !identity {
							let x = all.xs[i]
							let y = all.ys[i]
							all.xs[i] = x * c.a + y * c.c
							all.ys[i] = x * c.b + y * c.d
						}
						if !scaledFirst {
							all.xs[i] += tx
							all.ys[i] += ty
						}
					}
					if c.flags & compArgsAreXY == 0 {
						// Point matching: move the child so its point p2 lands on
						// point p1 of what came before.
						let p1 = c.dx
						let p2 = c.dy
						if p1 < all.len() && p2 < childEnd - before {
							let mx = all.xs[p1] - all.xs[before + p2]
							let my = all.ys[p1] - all.ys[before + p2]
							for let i = before; i < childEnd; i++ {
								all.xs[i] += mx
								all.ys[i] += my
							}
						}
					}
					all.truncate(childEnd - phantomCount)
				}
			}
			for let p = 0; p < phantomCount; p++ {
				all.push(own.xs[phantoms + p], own.ys[phantoms + p], false)
			}
			return none
		}

		// Vertical advance and top side bearing of glyph `id` from `vmtx`; a
		// face without one advances by an em from a bearing of 0.
		internal def verticalMetrics(id int) (int, int) {
			return (upem, 0) when vmetrics == 0
			let i = id.min(vmetrics - 1)
			let advance = u16(vmtx, i * 4)
			let tsb = id < vmetrics ?? (i16(vmtx, id * 4 + 2), i16(vmtx, vmetrics * 4 + (id - vmetrics) * 2))
			return (advance, tsb)
		}
	}

	// A copy of the points of `p` from `from` on.
	internal def sub(p variations.GlyphPoints, from int) variations.GlyphPoints {
		let out = new variations.GlyphPoints()
		for let i = from; i < p.len(); i++ {
			out.push(p.xs[i], p.ys[i], p.ends[i], p.on[i])
		}
		return out
	}

	internal def u16(b byte[], at int) int {
		return 0 when at < 0 || at + 2 > b.len()
		return int(b[at]) << 8 | int(b[at + 1])
	}

	internal def i16(b byte[], at int) int {
		let v = u16(b, at)
		return v >= 32768 ?? (v - 65536, v)
	}

	// One component of a composite glyph. For point-matched components `dx`
	// and `dy` hold the two point numbers and the offset is zero.
	internal struct Component {
		glyph int
		flags int
		dx    int
		dy    int
		a     float32
		b     float32
		c     float32
		d     float32
	}

	// A composite glyph's component records.
	internal def readComponents(data byte[]) !Component[] {
		let r = new bytes.Reader(data, bytes.Endian.Big)
		try r.skip(10)
		let out Component[]
		let more = true
		for more {
			let flags = int(try r.read<uint16>())
			let c = Component{glyph: int(try r.read<uint16>()), flags: flags, a: float32(1.0), d: float32(1.0)}
			if flags & compArgsAreWords != 0 {
				if flags & compArgsAreXY != 0 {
					c.dx = int(try r.read<int16>())
					c.dy = int(try r.read<int16>())
				} else {
					c.dx = int(try r.read<uint16>())
					c.dy = int(try r.read<uint16>())
				}
			} else {
				if flags & compArgsAreXY != 0 {
					c.dx = int(try r.read<int8>())
					c.dy = int(try r.read<int8>())
				} else {
					c.dx = int(try r.readByte())
					c.dy = int(try r.readByte())
				}
			}
			if flags & compHasScale != 0 {
				c.a = f2dot14(try r.read<int16>())
				c.d = c.a
			} else if flags & compHasXYScale != 0 {
				c.a = f2dot14(try r.read<int16>())
				c.d = f2dot14(try r.read<int16>())
			} else if flags & compHasTwoByTwo != 0 {
				c.a = f2dot14(try r.read<int16>())
				c.b = f2dot14(try r.read<int16>())
				c.c = f2dot14(try r.read<int16>())
				c.d = f2dot14(try r.read<int16>())
			}
			out.push(c)
			more = flags & compMoreComponents != 0
		}
		return out
	}

	// A simple glyph: contours of points, stored as three parallel runs of
	// flags, x deltas and y deltas.
	internal def readSimplePoints(data byte[], numberOfContours int, out variations.GlyphPoints) !none {
		return none when numberOfContours == 0
		let r = new bytes.Reader(data, bytes.Endian.Big)
		try r.skip(10)

		let endPts int[]
		for let i in 0..numberOfContours {
			endPts.push(int(try r.read<uint16>()))
		}

		let pointCount = endPts[numberOfContours - 1] + 1
		fail "glyph has a negative point count" when pointCount <= 0

		// Hinting bytecode, which the hinter reads on its own.
		let instructionLength = int(try r.read<uint16>())
		try r.skip(instructionLength)

		// Flags, run-length encoded: a flag with the repeat bit is followed by
		// a count of additional points sharing it.
		let flags int[]
		for flags.len() < pointCount {
			let f = int(try r.readByte())
			flags.push(f)

			continue when (f & flagRepeat) == 0

			let repeat = int(try r.readByte())
			for let i in 0..repeat {
				break when flags.len() >= pointCount
				flags.push(f)
			}
		}

		// X then Y, each as deltas from the previous point.
		let xs int[]
		let x = 0
		for let i in 0..pointCount {
			let f = flags[i]
			if (f & flagXShort) != 0 {
				let d = int(try r.readByte())
				x += (f & flagXSameOrPositive) != 0 ?? (d, -d)
			} else if (f & flagXSameOrPositive) == 0 {
				x += int(try r.read<int16>())
			}
			xs.push(x)
		}

		let ys int[]
		let y = 0
		for let i in 0..pointCount {
			let f = flags[i]
			if (f & flagYShort) != 0 {
				let d = int(try r.readByte())
				y += (f & flagYSameOrPositive) != 0 ?? (d, -d)
			} else if (f & flagYSameOrPositive) == 0 {
				y += int(try r.read<int16>())
			}
			ys.push(y)
		}

		let ends bool[]
		ends.len(pointCount)
		ends.fill(false)
		for let (_, e) in endPts {
			ends[e] = true when e < pointCount
		}
		for let i in 0..pointCount {
			out.push(float32(xs[i]), float32(ys[i]), ends[i], (flags[i] & flagOnCurve) != 0)
		}
	}

	// Turns one contour's points into path segments, the way HarfBuzz draws
	// a glyf contour.
	//
	// TrueType contours are quadratic and may omit on-curve points: two
	// consecutive off-curve points imply an on-curve point at their midpoint.
	// The contour starts at its first on-curve point, or at the midpoint of
	// its first two points when both are off-curve; control points before
	// the start close the contour at the end.
	internal def emitContour(points GlyphPoint[], segs fonts.Segment[]) {
		let pen = new ContourPen(segs)
		for let (_, p) in points {
			pen.point(p.x, p.y, p.onCurve)
		}
		pen.end()
	}

	// The state of drawing one contour: the first on- and off-curve points
	// and the pending control point.
	internal type ContourPen {
		segs        fonts.Segment[]
		hasFirstOn  bool
		firstOnX    float
		firstOnY    float
		hasFirstOff bool
		firstOffX   float
		firstOffY   float
		hasLastOff  bool
		lastOffX    float
		lastOffY    float
		// The draw state: a path opens on its first drawing segment.
		open        bool
		startX      float
		startY      float
		curX        float
		curY        float

		def new(segs fonts.Segment[]) {
			self.segs = segs
		}

		def point(x float, y float, onCurve bool) {
			if !hasFirstOn {
				if onCurve {
					hasFirstOn = true
					firstOnX = x
					firstOnY = y
					moveTo(x, y)
				} else if hasFirstOff {
					let mx = (firstOffX + x) * 0.5
					let my = (firstOffY + y) * 0.5
					hasFirstOn = true
					firstOnX = mx
					firstOnY = my
					hasLastOff = true
					lastOffX = x
					lastOffY = y
					moveTo(mx, my)
				} else {
					hasFirstOff = true
					firstOffX = x
					firstOffY = y
				}
				return
			}
			if hasLastOff {
				if onCurve {
					quadTo(lastOffX, lastOffY, x, y)
					hasLastOff = false
				} else {
					quadTo(lastOffX, lastOffY, (lastOffX + x) * 0.5, (lastOffY + y) * 0.5)
					lastOffX = x
					lastOffY = y
				}
				return
			}
			if onCurve {
				lineTo(x, y)
			} else {
				hasLastOff = true
				lastOffX = x
				lastOffY = y
			}
		}

		def end() {
			if hasFirstOff && hasLastOff {
				quadTo(lastOffX, lastOffY, (lastOffX + firstOffX) * 0.5, (lastOffY + firstOffY) * 0.5)
				hasLastOff = false
			}
			if hasFirstOff && hasFirstOn {
				quadTo(firstOffX, firstOffY, firstOnX, firstOnY)
			} else if hasLastOff && hasFirstOn {
				quadTo(lastOffX, lastOffY, firstOnX, firstOnY)
			} else if hasFirstOn {
				lineTo(firstOnX, firstOnY)
			} else if hasFirstOff {
				moveTo(firstOffX, firstOffY)
				quadTo(firstOffX, firstOffY, firstOffX, firstOffY)
			}
			close()
		}

		internal def moveTo(x float, y float) {
			close() when open
			curX = x
			curY = y
		}

		internal def openPath() {
			return when open
			segs.push(fonts.Segment{kind: fonts.SegmentKind.Move, to: geom.Point{x: curX, y: curY}})
			open = true
			startX = curX
			startY = curY
		}

		internal def lineTo(x float, y float) {
			openPath()
			segs.push(fonts.Segment{kind: fonts.SegmentKind.Line, to: geom.Point{x: x, y: y}})
			curX = x
			curY = y
		}

		internal def quadTo(cx float, cy float, x float, y float) {
			openPath()
			segs.push(fonts.Segment{kind: fonts.SegmentKind.Quadratic, to: geom.Point{x: x, y: y}, control1: geom.Point{x: cx, y: cy}})
			curX = x
			curY = y
		}

		internal def close() {
			if open {
				if startX != curX || startY != curY {
					segs.push(fonts.Segment{kind: fonts.SegmentKind.Line, to: geom.Point{x: startX, y: startY}})
				}
				segs.push(fonts.Segment{kind: fonts.SegmentKind.Close})
			}
			open = false
			startX = 0.0
			startY = 0.0
			curX = 0.0
			curY = 0.0
		}
	}

	internal def f2dot14(v int16) float32 {
		return float32(v) / float32(16384.0)
	}
}
