partial module std.formats.fonts.truetype {
	use (
		std.bytes
		std.math.geom
		std.formats.fonts
		std.formats.fonts.sfnt
	)

	// Point flags, as stored in a simple glyph.
	internal const (
		flagOnCurve  = 0x01
		flagXShort   = 0x02
		flagYShort   = 0x04
		flagRepeat   = 0x08
		// When the matching short bit is set this is the sign of the delta;
		// when it is clear it means "same as the previous coordinate".
		flagXSameOrPositive = 0x10
		flagYSameOrPositive = 0x20
	)

	// Composite glyph component flags.
	internal const (
		compArgsAreWords    = 0x0001
		compArgsAreXY       = 0x0002
		compHasScale        = 0x0008
		compMoreComponents  = 0x0020
		compHasXYScale      = 0x0040
		compHasTwoByTwo     = 0x0080
	)

	// How deep a composite may nest before it is treated as malformed. Real
	// fonts rarely go past two, and a cycle would otherwise recurse forever.
	internal const maxCompositeDepth = 8

	// One point of a glyph contour, in font units.
	internal struct GlyphPoint {
		x       int
		y       int
		// Off-curve points are quadratic control points.
		onCurve bool
	}

	// Reads one glyph's outline.
	//
	// Returns an empty outline for a glyph with no data, which is how a space
	// is stored, rather than failing.
	def readGlyph(font sfnt.Sfnt, loca Loca, id uint16) !fonts.Outline {
		return readGlyphAt(font, loca, id, 0)
	}

	internal def readGlyphAt(font sfnt.Sfnt, loca Loca, id uint16, depth int) !fonts.Outline {
		fail "composite glyph nesting is too deep" when depth > maxCompositeDepth

		// Segments are collected into a local array and wrapped only on the way
		// out. Passing the `Outline` struct down and pushing onto its field from
		// a callee grows an array reached through a copy of the struct, which
		// does not reliably reach the caller's copy.
		let segs fonts.Segment[]

		let table = font.table("glyf")
		fail "font has no glyf table" when table is none

		let span = loca.range(id)
		// An id outside `loca` is out of range; an empty span is a blank glyph.
		return fonts.Outline{segments: segs} when span is none

		let (from, to) = span
		return fonts.Outline{segments: segs} when to <= from
		return fonts.Outline{segments: segs} when int(to) > table.len()

		let data = table[int(from):int(to)]
		let r = new bytes.Reader(data, bytes.Endian.Big)

		let numberOfContours = int(try r.read<int16>())
		// xMin, yMin, xMax, yMax: the glyph's own bounds, which the caller can
		// get from `hmtx` and the outline itself.
		try r.skip(8)

		if numberOfContours < 0 {
			try readComposite(font, loca, r, segs, depth)
			return fonts.Outline{segments: segs}
		}

		try readSimple(r, numberOfContours, segs)
		return fonts.Outline{segments: segs}
	}

	// A simple glyph: contours of points, stored as three parallel runs of
	// flags, x deltas and y deltas.
	internal def readSimple(r bytes.Reader, numberOfContours int, segs fonts.Segment[]) !none {
		return none when numberOfContours == 0

		let endPts int[]
		for let i in 0..numberOfContours {
			endPts.push(int(try r.read<uint16>()))
		}

		let pointCount = endPts[numberOfContours - 1] + 1
		fail "glyph has a negative point count" when pointCount <= 0

		// Hinting bytecode, which this implementation does not run.
		let instructionLength = int(try r.read<uint16>())
		try r.skip(instructionLength)

		// Flags, run-length encoded: a flag with the repeat bit is followed by
		// a count of additional points sharing it.
		let flags int[]
		for flags.len() < pointCount {
			let f = int(try r.readByte())
			flags.push(f)

			continue when (f & flagRepeat) == 0

			let repeat = int(try r.readByte())
			for let i in 0..repeat {
				break when flags.len() >= pointCount
				flags.push(f)
			}
		}

		// X then Y, each as deltas from the previous point.
		let xs int[]
		let x = 0
		for let i in 0..pointCount {
			let f = flags[i]
			if (f & flagXShort) != 0 {
				let d = int(try r.readByte())
				x += (f & flagXSameOrPositive) != 0 ?? (d, -d)
			} else if (f & flagXSameOrPositive) == 0 {
				x += int(try r.read<int16>())
			}
			xs.push(x)
		}

		let ys int[]
		let y = 0
		for let i in 0..pointCount {
			let f = flags[i]
			if (f & flagYShort) != 0 {
				let d = int(try r.readByte())
				y += (f & flagYSameOrPositive) != 0 ?? (d, -d)
			} else if (f & flagYSameOrPositive) == 0 {
				y += int(try r.read<int16>())
			}
			ys.push(y)
		}

		let start = 0
		for let c in 0..numberOfContours {
			let end = endPts[c]
			break when end < start || end >= pointCount

			let points GlyphPoint[]
			for let i in start..(end + 1) {
				points.push(GlyphPoint{x: xs[i], y: ys[i], onCurve: (flags[i] & flagOnCurve) != 0})
			}

			emitContour(points, segs)
			start = end + 1
		}
	}

	// Turns one contour's points into path segments.
	//
	// TrueType contours are quadratic and may omit on-curve points: two
	// consecutive off-curve points imply an on-curve point at their midpoint.
	// A contour may also begin off-curve, in which case the starting point has
	// to be synthesised before anything can be drawn.
	internal def emitContour(points GlyphPoint[], segs fonts.Segment[]) {
		let n = points.len()
		return when n == 0

		// Find a starting on-curve point, or invent one.
		let startIdx = -1
		for let i in 0..n {
			if points[i].onCurve {
				startIdx = i
				break
			}
		}

		let startX = 0.0
		let startY = 0.0
		if startIdx < 0 {
			// Every point is off-curve: start at the midpoint of the last and
			// first control points, which is on the curve by definition.
			startX = float(points[n - 1].x + points[0].x) / 2.0
			startY = float(points[n - 1].y + points[0].y) / 2.0
			startIdx = 0
		} else {
			startX = float(points[startIdx].x)
			startY = float(points[startIdx].y)
			startIdx = startIdx + 1
		}

		segs.push(fonts.Segment{
			kind: fonts.SegmentKind.Move,
			to: geom.Point{x: startX, y: startY}
		})

		let controlX = 0.0
		let controlY = 0.0
		let haveControl = false

		for let k in 0..n {
			let p = points[(startIdx + k) % n]
			let px = float(p.x)
			let py = float(p.y)

			if p.onCurve {
				if haveControl {
					segs.push(fonts.Segment{
						kind: fonts.SegmentKind.Quadratic,
						to: geom.Point{x: px, y: py},
						control1: geom.Point{x: controlX, y: controlY}
					})
					haveControl = false
					continue
				}
				segs.push(fonts.Segment{
					kind: fonts.SegmentKind.Line,
					to: geom.Point{x: px, y: py}
				})
				continue
			}

			if haveControl {
				// Two controls in a row: the implied on-curve point sits halfway
				// between them.
				let midX = (controlX + px) / 2.0
				let midY = (controlY + py) / 2.0
				segs.push(fonts.Segment{
					kind: fonts.SegmentKind.Quadratic,
					to: geom.Point{x: midX, y: midY},
					control1: geom.Point{x: controlX, y: controlY}
				})
			}

			controlX = px
			controlY = py
			haveControl = true
		}

		// Close back onto the start, through a pending control point if there
		// is one.
		if haveControl {
			segs.push(fonts.Segment{
				kind: fonts.SegmentKind.Quadratic,
				to: geom.Point{x: startX, y: startY},
				control1: geom.Point{x: controlX, y: controlY}
			})
		}

		segs.push(fonts.Segment{kind: fonts.SegmentKind.Close})
	}

	// A composite glyph: other glyphs placed by an offset, and optionally
	// scaled. Accented letters are built this way, sharing one base outline.
	internal def readComposite(font sfnt.Sfnt, loca Loca, r bytes.Reader, segs fonts.Segment[], depth int) !none {
		let more = true

		for more {
			let flags = int(try r.read<uint16>())
			let componentID = try r.read<uint16>()

			let dx = 0.0
			let dy = 0.0

			if (flags & compArgsAreWords) != 0 {
				let a1 = int(try r.read<int16>())
				let a2 = int(try r.read<int16>())
				if (flags & compArgsAreXY) != 0 {
					dx = float(a1)
					dy = float(a2)
				}
			} else {
				let a1 = int(try r.read<int8>())
				let a2 = int(try r.read<int8>())
				if (flags & compArgsAreXY) != 0 {
					dx = float(a1)
					dy = float(a2)
				}
			}

			// Scaling is stored as F2Dot14 -- a signed 2.14 fixed-point value.
			// Only the offset is applied here; a scaled component would need the
			// full 2x2 transform, which no sample font in the tree uses.
			if (flags & compHasScale) != 0 {
				try r.skip(2)
			} else if (flags & compHasXYScale) != 0 {
				try r.skip(4)
			} else if (flags & compHasTwoByTwo) != 0 {
				try r.skip(8)
			}

			let part = try readGlyphAt(font, loca, componentID, depth + 1)
			for let (_, seg) in part.segments {
				segs.push(fonts.Segment{
					kind: seg.kind,
					to: geom.Point{x: seg.to.x + dx, y: seg.to.y + dy},
					control1: geom.Point{x: seg.control1.x + dx, y: seg.control1.y + dy},
					control2: geom.Point{x: seg.control2.x + dx, y: seg.control2.y + dy}
				})
			}

			more = (flags & compMoreComponents) != 0
		}
	}
}
