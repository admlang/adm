// TrueType outlines: the `glyf` and `loca` tables.
//
// This is what separates a ttf from an otf. Both share the sfnt container and
// every table in `std.formats.fonts.sfnt`; only the outline representation
// differs, quadratic contours here against CFF charstrings there.

partial module std.formats.fonts.truetype {
	use (
		std.bytes
		std.formats.fonts.sfnt
	)

	// Byte ranges of each glyph's entry in `glyf`.
	//
	// `loca` holds one more entry than there are glyphs: a glyph's data runs
	// from its own offset to the next one, so the extra entry terminates the
	// last glyph. Equal neighbours mean an empty glyph -- a space -- which is
	// not an error.
	type Loca {
		internal offsets uint32[]

		def new() {}

		// Where glyph `id` lives in the `glyf` table, or none when the id is out
		// of range.
		def range(id uint16) ?(uint32, uint32) {
			let i = int(id)
			return none when i < 0 || i + 1 >= offsets.len()

			let from = offsets[i]
			let to = offsets[i + 1]
			return none when to < from
			return (from, to)
		}

		// count returns how many glyphs the table indexes.
		def count() int {
			return offsets.len() - 1 when offsets.len() > 0
			return 0
		}

		// Reads `entries` offsets in the width `shortFormat` selects.
		//
		// The short format stores halved offsets, which is why those values are
		// doubled: a glyph always starts on an even byte, so the format can
		// address twice as much data in 16 bits.
		// Fails when the table ends before the entries.
		def parse(r bytes.Reader, shortFormat bool, entries int) !none {
			if shortFormat {
				for let i in 0..entries {
					offsets.push(uint32(int(try r.read<uint16>()) * 2))
				}
				return none
			}

			for let i in 0..entries {
				offsets.push(try r.read<uint32>())
			}
		}
	}

	// Reads `loca`, whose entry width is decided by `head.indexToLocFormat`.
	// Fails when the font has no loca table or it is truncated.
	def readLoca(font sfnt.Sfnt, head sfnt.Head, glyphCount uint16) !Loca {
		let r = font.reader("loca")
		fail "font has no loca table" when r is none

		let loca = new Loca()
		try loca.parse(r, head.indexToLocFormat == 0, int(glyphCount) + 1)
		return loca
	}
}
