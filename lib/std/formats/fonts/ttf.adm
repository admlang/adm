partial module std.formats.fonts {
	use (
		std.io
		std.formats.fonts.opentype
	)

	// TTF is the TrueType font codec: opens .ttf files and .ttc collections and
	// reads their descriptions.
	//
	// A collection may mix outline kinds; each face reports "ttf" or "otf" in
	// `FontInfo.format` after its own outlines.
	@codec("TrueType")
	type TTF {
		mimeType string[] {
			def get() string[] {
				return string["font/ttf", "font/collection", "application/x-font-ttf"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".ttf", ".ttc", ".otc"]
			}
		}

		// The sfnt version tag: 0x00010000 for TrueType outlines, the literal
		// `true` that Apple's variant uses, or `ttcf` for a collection. `OTTO`
		// is CFF and belongs to the otf codec, so it deliberately does not match
		// here.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)

			let n = r.read(b) onerror recover 0
			return false when n != 4

			return true when b[0] == 0x00 && b[1] == 0x01 && b[2] == 0x00 && b[3] == 0x00
			return true when b.equals(byte[byte('t'), byte('t'), byte('c'), byte('f')])
			return b.equals(byte[byte('t'), byte('r'), byte('u'), byte('e')])
		}

		// open parses a TrueType font or collection from the reader. Fails when the
		// data is not an sfnt font or its first face is damaged.
		def open(reader io.Reader) !Font {
			return opentype.open(try opentype.readAll(reader), "")
		}

		// info reads the first face's description from the reader without loading
		// glyphs. Fails when the data is not an sfnt font.
		def info(reader io.Reader) !FontInfo {
			return opentype.info(try opentype.readAll(reader), "")
		}
	}
}
