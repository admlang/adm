partial module std.formats.fonts {
	use (
		std.io
		std.bytes
		std.math.geom
		std.formats.fonts.sfnt
		std.formats.fonts.truetype
	)

	// A TrueType face: one set of glyphs read out of an sfnt container.
	//
	// Everything is read up front except glyph outlines, which are decoded on
	// demand -- a face with thousands of glyphs is rarely asked for more than a
	// few dozen.
	type TrueTypeFace {
		internal font    sfnt.Sfnt
		internal loca    truetype.Loca
		internal cmap    sfnt.Cmap
		internal hmetric sfnt.HMetric[]
		internal details FontInfo
		internal face    FontMetrics

		def new() {}

		// Reads every table a face needs. Populating the fields from a module
		// function is not possible -- they are internal to this type.
		// Fails when the data is not a TrueType font, or a required table is missing or damaged.
		def load(reader io.Reader) !none {
			font = new sfnt.Sfnt()
			try font.parse(reader)

			fail "not a TrueType font: outlines are not glyf-based" unless font.isTrueType()

			let head = try sfnt.readHead(font)
			let glyphCount = try sfnt.readGlyphCount(font)
			let hhea = try sfnt.readHhea(font)

			loca = try truetype.readLoca(font, head, glyphCount)
			cmap = try sfnt.readCmap(font)
			hmetric = try sfnt.readHMetrics(font, hhea, glyphCount)
			details = try describe(font)
			face = try readFaceMetrics(font, head, hhea)
		}

		// info returns the font's description: family, style and the rest.
		def info() FontInfo {
			return details
		}

		// metrics returns the face's vertical metrics.
		def metrics() FontMetrics {
			return face
		}

		// glyph returns the glyph for the character, none when the font lacks it.
		def glyph(codepoint char) ?GlyphID {
			return cmap.lookup(uint32(codepoint))
		}

		// metrics returns the glyph's advance and bearings. Fails when the glyph is
		// out of range.
		def metrics(glyph GlyphID) !GlyphMetrics {
			let i = int(glyph)
			fail "glyph ${i} is out of range" when i < 0 || i >= hmetric.len()

			// `hmtx` carries advance and left bearing; the bounding box comes
			// from the outline, which is only decoded when asked for.
			return GlyphMetrics{
				advance: int16(hmetric[i].advance),
				leftSideBearing: hmetric[i].leftSideBearing
			}
		}

		// Kerning from the legacy `kern` table is not read, and GPOS kerning is
		// the shaper's job, so this reports no adjustment for now.
		def kern(left GlyphID, right GlyphID) int16 {
			return int16(0)
		}

		// outline returns the glyph's outline. Fails when the glyph data cannot be
		// read.
		def outline(glyph GlyphID) !Outline {
			return truetype.readGlyph(font, loca, glyph)
		}

		// rasterize renders the glyph at the size as a bitmap. Not implemented yet:
		// always fails.
		def rasterize(glyph GlyphID, size float) !Bitmap {
			fail "rasterising is not implemented yet"
		}
	}

	// A TrueType font file. `.ttc` collections are not read yet, so this always
	// holds exactly one face.
	type TrueTypeFont {
		internal only Face

		def new(face Face) {
			only = face
		}

		// faces returns how many faces the font holds, 1 for a plain TrueType file.
		def faces() int {
			return 1
		}

		// face returns the face at index. Fails when the index is not 0.
		def face(index int) !Face {
			fail "face index ${index} is out of range" when index != 0
			return only
		}

		// close releases the font. It cannot fail.
		def close() !none {
			return none
		}
	}

	// TTF is the TrueType font codec: opens .ttf files and reads their
	// descriptions.
	@codec("TrueType")
	type TTF {
		mimeType string[] {
			def get() string[] {
				return string["font/ttf", "application/x-font-ttf"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".ttf", ".ttc"]
			}
		}

		// The sfnt version tag: 0x00010000 for TrueType outlines, or the literal
		// `true` that Apple's variant uses. `OTTO` is CFF and belongs to the otf
		// codec, so it deliberately does not match here.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)

			let n = r.read(b) onerror recover 0
			return false when n != 4

			return true when b[0] == 0x00 && b[1] == 0x01 && b[2] == 0x00 && b[3] == 0x00
			return b.equals(byte[byte('t'), byte('r'), byte('u'), byte('e')])
		}

		// open parses a TrueType font from the reader. Fails when the data is not a
		// TrueType font.
		def open(reader io.Reader) !Font {
			return new TrueTypeFont(try readFace(reader))
		}

		// info reads the font's description from the reader without loading glyphs.
		// Fails when the data is not a TrueType font.
		def info(reader io.Reader) !FontInfo {
			let font = new sfnt.Sfnt()
			try font.parse(reader)
			return try describe(font)
		}
	}

	internal def readFace(reader io.Reader) !Face {
		let out = new TrueTypeFace()
		try out.load(reader)
		return out
	}

	// Fills in what a font matcher selects on.
	internal def describe(font sfnt.Sfnt) !FontInfo {
		let head = try sfnt.readHead(font)
		let names = sfnt.readNames(font) onerror recover sfnt.Names{}

		let glyphCount = sfnt.readGlyphCount(font) onerror recover uint16(0)

		let out = FontInfo{
			family:     names.family,
			subfamily:  names.subfamily,
			postscript: names.postscript,
			unitsPerEm: head.unitsPerEm,
			glyphCount: glyphCount,
			scalable:   true,
			format:     "ttf"
		}

		// `OS/2` is the authority on weight and slant, but a font may omit it --
		// `head.macStyle` carries a coarse version of the same claims.
		let os2 = sfnt.readOs2(font)
		if os2 is error {
			out.weight = (head.macStyle & 0x0001) != 0 ?? (FontWeight.Bold, FontWeight.Regular)
			out.width = FontWidth.Normal
			out.italic = (head.macStyle & 0x0002) != 0
		} else {
			out.weight = weightFromClass(os2.weightClass)
			out.width = widthFromClass(os2.widthClass)
			out.italic = os2.isItalic()
		}

		let post = sfnt.readPost(font)
		if !(post is error) {
			out.fixedPitch = post.fixedPitch
		}

		// Colour glyph tables, any of which makes a face colour-capable.
		out.color = font.has("COLR") || font.has("CBDT") || font.has("sbix")

		return out
	}

	internal def readFaceMetrics(font sfnt.Sfnt, head sfnt.Head, hhea sfnt.Hhea) !FontMetrics {
		let out = FontMetrics{
			ascent:  hhea.ascender,
			descent: hhea.descender,
			lineGap: hhea.lineGap,
			bounds:  geom.Rect{
				left:   float(head.xMin),
				top:    float(head.yMin),
				right:  float(head.xMax),
				bottom: float(head.yMax)
			}
		}

		let os2 = sfnt.readOs2(font)
		if !(os2 is error) {
			out.capHeight = os2.capHeight
			out.xHeight = os2.xHeight
		}

		let post = sfnt.readPost(font)
		if !(post is error) {
			out.underlinePosition = post.underlinePosition
			out.underlineThickness = post.underlineThickness
		}

		return out
	}

	// The OpenType weight class is already the 100..900 scale, but a font may
	// store a value off the scale, so it is snapped to the nearest step.
	internal def weightFromClass(cls uint16) FontWeight {
		return FontWeight.Thin when cls < 150
		return FontWeight.ExtraLight when cls < 250
		return FontWeight.Light when cls < 350
		return FontWeight.Regular when cls < 450
		return FontWeight.Medium when cls < 550
		return FontWeight.SemiBold when cls < 650
		return FontWeight.Bold when cls < 750
		return FontWeight.ExtraBold when cls < 850
		return FontWeight.Black
	}

	internal def widthFromClass(cls uint16) FontWidth {
		return FontWidth.UltraCondensed when cls <= 1
		return FontWidth.ExtraCondensed when cls == 2
		return FontWidth.Condensed when cls == 3
		return FontWidth.SemiCondensed when cls == 4
		return FontWidth.Normal when cls == 5
		return FontWidth.SemiExpanded when cls == 6
		return FontWidth.Expanded when cls == 7
		return FontWidth.ExtraExpanded when cls == 8
		return FontWidth.UltraExpanded
	}
}
