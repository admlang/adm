partial module std.formats.fonts {
	use (
		// Imported for the `@test` annotation. The assertions here use `assert`
		// rather than std.testing's expect* helpers: apart from expectEqual,
		// those are stubs whose bodies are `return none`, so a test written with
		// them passes no matter what the code does.
		std.testing
		std.os
		std.bytes
	)

	check "TTF codec" {
		// Sample fonts live in the repo, and `adm test` runs from its root. A
		// missing sample skips rather than fails, so the suite still means
		// something when it is run from somewhere else.
		let sampleDir = "samples/fonts/ttf/"

		def sample(name string) ?byte[] {
			let d = os.readFile(sampleDir + name)
			return none when d is error
			return d
		}

		@test()
		def signatureAcceptsTrueType() !none {
			let ttf = new TTF()

			// Version 1.0, the ordinary TrueType tag.
			assert ttf.matchSignature(new bytes.Reader(byte[0x00, 0x01, 0x00, 0x00, 0x00, 0x0E])) // 0x00010000 is a TrueType signature

			// Apple's `true` variant.
			assert ttf.matchSignature(new bytes.Reader(byte[byte('t'), byte('r'), byte('u'), byte('e'), 0, 0])) // 'true' is a TrueType signature
		}

		@test()
		def signatureRejectsOthers() !none {
			let ttf = new TTF()

			// `OTTO` is CFF outlines and belongs to the otf codec, so matching it
			// here would make the registry hand otf files to this decoder.
			assert !(ttf.matchSignature(new bytes.Reader(byte[byte('O'), byte('T'), byte('T'), byte('O'), 0, 0]))) // OTTO is CFF, not TrueType

			assert !(ttf.matchSignature(new bytes.Reader(byte[byte('w'), byte('O'), byte('F'), byte('F'), 0, 0]))) // wOFF is a compressed wrapper, not bare sfnt

			// Too short to carry a signature at all.
			assert !(ttf.matchSignature(new bytes.Reader(byte[0x00, 0x01]))) // a truncated stream is not a signature match
		}

		@test()
		def readsFaceMetadata() !none {
			let data = sample("ProximaNova-Bold.ttf")
			return none when data is none

			let font = try load(data)
			assert font.faces() == 1 // a plain ttf holds one face

			let face = try font.face(0)
			let i = face.info()

			assert i.family == "Proxima Nova" // family name
			assert i.subfamily == "Bold" // subfamily name
			assert i.postscript == "ProximaNova-Bold" // postscript name
			assert int(i.unitsPerEm) == 2048 // units per em
			assert int(i.glyphCount) == 702 // glyph count
			assert i.weight == FontWeight.Bold // weight from OS/2
			assert i.width == FontWidth.Normal // width from OS/2
			assert !(i.italic) // upright face
			assert !(i.fixedPitch) // proportional face
			assert i.scalable // outlines are scalable
			assert i.format == "ttf" // format tag
		}

		// The typographic name IDs (16/17) describe the family better than the
		// legacy pair for families with more than four members. This font is the
		// case that proves it: IDs 1/2 say "Source Sans Pro Black" / "Regular".
		@test()
		def prefersTypographicNames() !none {
			let data = sample("SourceSansPro-Black.ttf")
			return none when data is none

			let font = try load(data)
			let i = (try font.face(0)).info()

			assert i.family == "Source Sans Pro" // typographic family beats the legacy name
			assert i.subfamily == "Black" // typographic subfamily beats the legacy name
			assert i.weight == FontWeight.Black // weight 900
		}

		@test()
		def readsFaceWideMetrics() !none {
			let data = sample("ProximaNova-Bold.ttf")
			return none when data is none

			let m = (try (try load(data)).face(0)).metrics()

			assert int(m.ascent) == 1618 // ascender
			assert int(m.descent) == -430 // descender is negative
			assert int(m.capHeight) == 1366 // cap height from OS/2 v2+
			assert int(m.xHeight) == 989 // x height from OS/2 v2+
			assert int(m.underlineThickness) == 40 // underline thickness from post
			assert m.underlinePosition < int16(0) // underline sits below the baseline
		}

		@test()
		def mapsCodepointsToGlyphs() !none {
			let data = sample("ProximaNova-Bold.ttf")
			return none when data is none

			let face = try (try load(data)).face(0)

			// Consecutive letters land on consecutive glyphs in this font, which
			// is the ordinary shape of a cmap format 4 delta segment.
			let a = face.glyph('A')
			let b = face.glyph('B')
			fail "A is not mapped" when a is none
			fail "B is not mapped" when b is none
			assert int(b) - int(a) == 1 // A and B are adjacent glyphs

			// Outside this font's coverage entirely.
			assert face.glyph('中') is none // an unmapped codepoint reports none
		}

		// Px437 is a DOS codepage font: every glyph advances by the same amount,
		// and `hmtx` stores only a handful of entries for 289 glyphs, so this
		// also covers the run-length tail that repeats the last advance.
		@test()
		def monospaceAdvancesAreUniform() !none {
			let data = sample("Px437_Wyse700a.ttf")
			return none when data is none

			let face = try (try load(data)).face(0)
			assert face.info().fixedPitch // font reports fixed pitch

			let first = int16(0)
			for let (idx, cp) in char['A', 'm', '0', '.'] {
				let g = face.glyph(cp)
				fail "codepoint is not mapped" when g is none

				let m = try face.metrics(g)
				if idx == 0 {
					first = m.advance
					assert first > int16(0) // advance is positive
					continue
				}
				assert m.advance == first // every glyph shares one advance
			}
		}

		@test()
		def decodesOutlines() !none {
			let data = sample("ProximaNova-Bold.ttf")
			return none when data is none

			let face = try (try load(data)).face(0)

			// `A` is drawn entirely with straight lines, so it has contours but
			// no quadratic segments.
			let a = face.glyph('A')
			fail "A is not mapped" when a is none
			let outline = try face.outline(a)
			assert outline.segments.len() > 0 // A has an outline

			let moves = 0
			let quads = 0
			for let (_, s) in outline.segments {
				moves += 1 when s.kind == SegmentKind.Move
				quads += 1 when s.kind == SegmentKind.Quadratic
			}
			assert moves == 2 // A is two contours: the outside and the counter
			assert quads == 0 // A is drawn with straight lines only

			// A round letter must use quadratics.
			let o = face.glyph('o')
			fail "o is not mapped" when o is none
			assert (try face.outline(o)).segments.len() > 0 // o has an outline
		}

		@test()
		def blankGlyphHasNoOutlineButAdvances() !none {
			let data = sample("ProximaNova-Bold.ttf")
			return none when data is none

			let face = try (try load(data)).face(0)
			let space = face.glyph(' ')
			fail "space is not mapped" when space is none

			// An empty `loca` range is a blank glyph, not an error.
			assert (try face.outline(space)).segments.len() == 0 // space draws nothing
			assert (try face.metrics(space)).advance > int16(0) // space still advances the pen
		}

		// Accented letters are composite glyphs: a base plus a mark, each placed
		// by an offset. Decoding one exercises a different `glyf` path entirely.
		@test()
		def decodesCompositeGlyphs() !none {
			let data = sample("ProximaNova-Bold.ttf")
			return none when data is none

			let face = try (try load(data)).face(0)
			let e = face.glyph('e')
			let accented = face.glyph('é')
			fail "e is not mapped" when e is none
			fail "é is not mapped" when accented is none

			let plain = try face.outline(e)
			let composed = try face.outline(accented)

			assert composed.segments.len() > plain.segments.len() // é carries the base letter plus its accent
		}

		@test()
		def rejectsAnOutOfRangeFaceIndex() !none {
			let data = sample("ProximaNova-Bold.ttf")
			return none when data is none

			let font = try load(data)
			assert font.face(1) is error // there is no second face
			assert font.face(-1) is error // a negative index is out of range
		}

		// `info` reads headers without building a decoder, so it must agree with
		// what a fully loaded face reports.
		@test()
		def infoAgreesWithLoadedFace() !none {
			let data = sample("SourceSansPro-Black.ttf")
			return none when data is none

			let quick = try info(data)
			let full = (try (try load(data)).face(0)).info()

			assert quick.family == full.family // same family
			assert quick.subfamily == full.subfamily // same subfamily
			assert int(quick.unitsPerEm) == int(full.unitsPerEm) // same units per em
			assert int(quick.glyphCount) == int(full.glyphCount) // same glyph count
			assert quick.weight == full.weight // same weight
		}

		@test()
		def rejectsNonFontData() !none {
			assert load(byte[1, 2, 3, 4, 5, 6, 7, 8]) is error // random bytes are not a font
		}
	}
}
