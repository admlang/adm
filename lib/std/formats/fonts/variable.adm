// Variable sfnt faces: the default instance of a font with an `fvar` design
// space, and the way to other instances.

internal partial module std.formats.fonts.opentype {
	use (
		std.formats.fonts
		std.formats.fonts.sfnt
		std.formats.fonts.color
		std.formats.fonts.variations
		std.math.geom
		std.gfx.color::(Color)
	)

	// An sfnt face with variation axes. It answers as the default instance;
	// `instance` gives the face at any other point of the design space.
	type VariableSfntFace {
		internal base SfntFace

		def new(base SfntFace) {
			self.base = base
		}

		// axes returns the font's variation axes, hidden ones included.
		def axes() fonts.VariationAxis[] {
			let out fonts.VariationAxis[]
			for let (_, a) in base.vars.fvar.axes {
				out.push(fonts.VariationAxis{
					tag:     a.tag,
					name:    sfnt.readName(base.font, a.nameID),
					min:     float(a.min),
					max:     float(a.max),
					initial: float(a.initial)
				})
			}
			return out
		}

		// instance returns the face at `coords`, keyed by axis tag. Values
		// outside an axis's range are clamped to it, unknown tags are ignored
		// and axes left out stay at their default. Fails when a coordinate is
		// not a finite number.
		def instance(coords map<string, float>) !fonts.Face {
			for let (tag, v) in coords {
				fail "coordinate {v} for axis {tag} is not a finite number" unless v - v == 0.0
			}
			let out = base.atCoords(base.vars.normalize(coords))
			out.design = coords
			describeInstance(out, coords)
			return out
		}

		// Names the instance after the named instance it sits on, if any, and
		// derives weight, width and slope from the registered axes.
		internal def describeInstance(out SfntFace, coords map<string, float>) {
			let fvar = base.vars.fvar
			let user float32[]
			for let (_, a) in fvar.axes {
				let v = coords.get(a.tag)
				user.push(v is none ?? (a.initial, float32(v).clamp(a.min, a.max)))
			}
			for let (_, n) in fvar.instances {
				let same = n.coords.len() == user.len()
				for let (i, c) in n.coords {
					same = false when i < user.len() && c != user[i]
				}
				continue unless same
				let name = sfnt.readName(base.font, n.subfamilyNameID)
				out.details.subfamily = name when name != ""
				let ps = n.postscriptNameID == 0 ?? ("", sfnt.readName(base.font, n.postscriptNameID))
				out.details.postscript = ps when ps != ""
				break
			}
			let w = fvar.find("wght")
			out.details.weight = weightFromClass(uint16(float(user[w]).round().clamp(1.0, 1000.0))) when w >= 0
			let wd = fvar.find("wdth")
			out.details.width = widthFromPercent(float(user[wd])) when wd >= 0
			let it = fvar.find("ital")
			out.details.italic = user[it] >= float32(0.5) when it >= 0
			let sl = fvar.find("slnt")
			out.details.italic = out.details.italic || user[sl] != float32(0.0) when sl >= 0
		}

		// The rest of `Face` and `OpenTypeFace` answers for the default
		// instance.

		def info() fonts.FontInfo {
			return base.info()
		}

		def metrics() fonts.FontMetrics {
			return base.metrics()
		}

		def glyph(codepoint char) ?fonts.GlyphID {
			return base.glyph(codepoint)
		}

		def metrics(glyph fonts.GlyphID) !fonts.GlyphMetrics {
			return base.metrics(glyph)
		}

		def kern(left fonts.GlyphID, right fonts.GlyphID) int16 {
			return base.kern(left, right)
		}

		def outline(glyph fonts.GlyphID) !fonts.Outline {
			return base.outline(glyph)
		}

		def outline(glyph fonts.GlyphID, size float, hinting fonts.Hinting = fonts.Hinting.Full) !fonts.Outline {
			return base.outline(glyph, size, hinting)
		}

		def baselines(script string, axis fonts.Axis = fonts.Axis.Horizontal) fonts.Baselines {
			return base.baselines(script, axis)
		}

		def rasterize(glyph fonts.GlyphID, size float) !fonts.Bitmap {
			return base.rasterize(glyph, size)
		}

		def table(tag string) ?byte[] {
			return base.table(tag)
		}

		def normalizedCoords() int[] {
			return base.normalizedCoords()
		}

		def metricVariation(tag string) float32 {
			return base.metricVariation(tag)
		}

		def verticalAdvance(g int) int {
			return base.verticalAdvance(g)
		}

		def colorPalettes() color.Palette[] {
			return base.colorPalettes()
		}

		def colorGlyphOf(glyph int, size float, palette int, foreground Color, svg bool = true) ?color.ColorGlyph {
			return base.colorGlyphOf(glyph, size, palette, foreground, svg)
		}

		def contourPoint(g int, index int) ?geom.Point<int> {
			return base.contourPoint(g, index)
		}

		def verticalOrigin(g int) ?int {
			return base.verticalOrigin(g)
		}

		def originVariation(g int) int {
			return base.originVariation(g)
		}
	}

	// The OpenType width class of a `wdth` axis value, a percentage of the
	// normal width.
	def widthFromPercent(p float) fonts.FontWidth {
		return fonts.FontWidth.UltraCondensed when p < 56.25
		return fonts.FontWidth.ExtraCondensed when p < 68.75
		return fonts.FontWidth.Condensed when p < 81.25
		return fonts.FontWidth.SemiCondensed when p < 93.75
		return fonts.FontWidth.Normal when p < 106.25
		return fonts.FontWidth.SemiExpanded when p < 118.75
		return fonts.FontWidth.Expanded when p < 137.5
		return fonts.FontWidth.ExtraExpanded when p < 175.0
		return fonts.FontWidth.UltraExpanded
	}
}
