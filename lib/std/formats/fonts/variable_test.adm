partial module std.formats.fonts {
	use (
		std.testing
		std.os
	)

	// Expected values are HarfBuzz 14.1's (outlines, advances, metrics,
	// shaping) and FreeType 2.13.3's (hinted points) for the same instances,
	// written by ~/.cache/adm-scratch/fontkit/var/gensuite.py. The fonts are
	// OFL subsets: Selawik (glyf, gvar, cvar, HVAR, avar, hinted) and
	// Cantarell (CFF2, HVAR, MVAR).
	check "Variable fonts" {
		def variable(path string) ?VariableFace {
			let data = os.readFile("samples/fonts/" + path)
			return none when data is error
			let font = load(data)
			return none when font is error
			let face = font.face(0)
			return none when face is error
			return face is VariableFace ?? (face, none)
		}

		// The first `n` outline steps, as "M x y; Q cx cy x y; ...", values
		// to two decimals.
		def steps(o Outline, n int) string {
			let r = (v float) => "%.2f".format(v)
			let parts string[]
			for let (_, s) in o.segments {
				break when parts.len() >= n
				match s.kind {
					case SegmentKind.Move:
						parts.push("M {r(s.to.x)} {r(s.to.y)}")
					case SegmentKind.Line:
						parts.push("L {r(s.to.x)} {r(s.to.y)}")
					case SegmentKind.Quadratic:
						parts.push("Q {r(s.control1.x)} {r(s.control1.y)} {r(s.to.x)} {r(s.to.y)}")
					case SegmentKind.Cubic:
						parts.push("C {r(s.control1.x)} {r(s.control1.y)} {r(s.control2.x)} {r(s.control2.y)} {r(s.to.x)} {r(s.to.y)}")
					case SegmentKind.Close:
						parts.push("Z")
				}
			}
			return parts.join("; ")
		}

		def glyphOf(face Face, ch char) !GlyphID {
			let g = face.glyph(ch)
			fail "no glyph for {ch}" when g is none
			return g
		}

		def render(run ShapedRun) string {
			let s = "["
			for let (i, g) in run.glyphs {
				s += "|" when i > 0
				s += "{int(g.glyph)}={g.cluster}+{g.xAdvance}"
			}
			return s + "]"
		}

		@test()
		def listsAxes() !none {
			let face = variable("ttf/Selawik-VF-Subset.ttf")
			return none when face is none
			let axes = face.axes()
			assert axes.len() == 2 // wght and opsz
			assert axes[0].tag == "wght" && axes[0].name == "Weight" // tag and name-table name
			assert axes[0].min == 300.0 && axes[0].initial == 400.0 && axes[0].max == 700.0 // range
			assert axes[1].tag == "opsz" && axes[1].name == "Optical" // second axis
			let plain = os.readFile("samples/fonts/ttf/ProximaNova-Bold.ttf")
			if !(plain is error) {
				assert !((try (try load(plain)).face(0)) is VariableFace) // a static face is not variable
			}
		}

		@test()
		def movesTrueTypeOutlines() !none {
			let face = variable("ttf/Selawik-VF-Subset.ttf")
			return none when face is none
			let a = try glyphOf(face, 'a')
			let bold = try face.instance(map<string, float>{"wght": 700.0})
			assert steps(try bold.outline(a), 5) == "M 386.00 -20.00; Q 366.00 24.00 354.50 69.50; Q 343.00 115.00 343.00 164.00; L 343.00 302.00; Q 343.00 342.00 320.50 359.50" // gvar deltas
			assert (try bold.metrics(a)).advance == int16(551) // HVAR advance
			// Between masters, with the second axis moved too: fractional
			// points from interpolated deltas.
			let mid = try face.instance(map<string, float>{"wght": 450.0, "opsz": 60.0})
			assert steps(try mid.outline(a), 5) == "M 417.15 -20.00; Q 393.59 24.00 379.42 69.50; Q 365.25 115.00 365.25 164.00; L 365.25 302.00; Q 365.25 361.58 336.97 387.09" // interpolated
			assert (try mid.metrics(a)).advance == int16(524) // advance between masters
		}

		@test()
		def clampsAndIgnoresCoordinates() !none {
			let face = variable("ttf/Selawik-VF-Subset.ttf")
			return none when face is none
			let a = try glyphOf(face, 'a')
			let wild = try face.instance(map<string, float>{"wght": 5000.0, "xxxx": 3.0})
			let bold = try face.instance(map<string, float>{"wght": 700.0})
			assert steps(try wild.outline(a), 8) == steps(try bold.outline(a), 8) // clamped to the axis maximum, unknown tag ignored
			let initial = try face.instance(map<string, float>{})
			assert steps(try initial.outline(a), 8) == steps(try face.outline(a), 8) // no coordinates: the default instance
			assert face.instance(map<string, float>{"wght": 0.0 / 0.0}) is error // not a number
		}

		@test()
		def namesInstances() !none {
			let face = variable("ttf/Selawik-VF-Subset.ttf")
			return none when face is none
			let semibold = try face.instance(map<string, float>{"wght": 600.0})
			assert semibold.info().subfamily == "Semibold" // named instance's style name
			assert semibold.info().weight == FontWeight.SemiBold // weight from the wght axis
		}

		@test()
		def blendsCFF2Outlines() !none {
			let face = variable("otf/Cantarell-VF-Subset.otf")
			return none when face is none
			let a = try glyphOf(face, 'a')
			let heavy = try face.instance(map<string, float>{"wght": 800.0})
			assert steps(try heavy.outline(a), 5) == "M 374.00 0.00; L 499.00 0.00; L 499.00 272.00; C 499.00 420.00 417.00 500.00 257.00 500.00; C 181.00 500.00 101.00 482.00 39.00 452.00" // CFF2 blend
			assert (try heavy.metrics(a)).advance == int16(550) // HVAR advance
		}

		@test()
		def movesFaceMetrics() !none {
			let face = variable("otf/Cantarell-VF-Subset.otf")
			return none when face is none
			assert face.metrics().xHeight == int16(482) // default x-height
			let heavy = try face.instance(map<string, float>{"wght": 800.0})
			assert heavy.metrics().xHeight == int16(490) // MVAR xhgt
			assert heavy.metrics().ascent == int16(983) // hasc does not vary here
		}

		@test()
		def hintsInstances() !none {
			let face = variable("ttf/Selawik-VF-Subset.ttf")
			return none when face is none
			let a = try glyphOf(face, 'a')
			// FreeType's first on-curve point, in 1/128 pixel, and the
			// advance: cvar and gvar both move them.
			let bold = try face.instance(map<string, float>{"wght": 700.0})
			let h = try bold.outline(a, 13.0)
			assert int(h.advance * 128.0) == 896 && int(h.segments[0].to.x * 128.0) == 628 && int(h.segments[0].to.y * 128.0) == -12 // hinted instance
			let d = try face.outline(a, 13.0)
			assert int(d.segments[0].to.x * 128.0) == 684 // the default instance hints differently
		}

		@test()
		def shapesInstances() !none {
			let sel = variable("ttf/Selawik-VF-Subset.ttf")
			let can = variable("otf/Cantarell-VF-Subset.otf")
			return none when sel is none || can is none
			let bold = try sel.instance(map<string, float>{"wght": 700.0})
			assert render(try shape(bold, "AVaegno")) == "[1=0+664|2=1+606|3=2+551|4=3+554|5=4+634|6=5+620|7=6+626]" // advances and kerning at the instance
			let heavy = try can.instance(map<string, float>{"wght": 800.0})
			assert render(try shape(heavy, "AVaegno")) == "[1=0+691|2=1+675|3=2+550|4=3+546|5=4+597|6=5+598|7=6+597]" // CFF2 face
		}
	}
}
