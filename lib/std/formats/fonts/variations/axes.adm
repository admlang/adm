// The design space of a variable font: its axes and named instances (`fvar`),
// the per-axis remapping of normalized coordinates (`avar`, versions 1 and 2),
// and the step from user coordinates to the normalized F2Dot14 coordinates
// every variation table is keyed on.

internal partial module std.formats.fonts.variations {
	use std.formats.fonts.layout

	// One axis as `fvar` records it, with min <= initial <= max.
	struct Axis {
		tag     string
		min     float32
		initial float32
		max     float32
		// `name` table ID of the axis name.
		nameID  int
		// Bit 0: the axis is meant to be hidden from users.
		flags   int
	}

	// A named instance: a point in the design space with a style name.
	struct NamedInstance {
		subfamilyNameID  int
		// 0 when the font records none.
		postscriptNameID int
		coords           float32[]
	}

	// The `fvar` table.
	type Fvar {
		axes      Axis[]
		instances NamedInstance[]

		def new(b byte[] = byte[]) {
			let d = new layout.Data(b)
			return when d.len() < 16 || d.u16(0) != 1
			let axesAt = d.u16(4)
			let count = d.u16(8)
			let axisSize = d.u16(10)
			let instanceCount = d.u16(12)
			let instanceSize = d.u16(14)
			return when axisSize < 20 || !d.has(axesAt, count * axisSize)
			for let i = 0; i < count; i++ {
				let a = axesAt + i * axisSize
				let initial = fixed(d, a + 8)
				axes.push(Axis{
					tag:     d.tag(a),
					min:     fixed(d, a + 4).min(initial),
					initial: initial,
					max:     fixed(d, a + 12).max(initial),
					flags:   d.u16(a + 16),
					nameID:  d.u16(a + 18)
				})
			}
			let at = axesAt + count * axisSize
			return when instanceSize < count * 4 + 4
			for let i = 0; i < instanceCount; i++ {
				let p = at + i * instanceSize
				break unless d.has(p, instanceSize)
				let coords float32[]
				for let k = 0; k < count; k++ {
					coords.push(fixed(d, p + 4 + k * 4))
				}
				instances.push(NamedInstance{
					subfamilyNameID:  d.u16(p),
					postscriptNameID: instanceSize >= count * 4 + 6 ?? (d.u16(p + 4 + count * 4), 0),
					coords:           coords
				})
			}
		}

		// Index of the axis tagged `tag`, -1 when the font has none.
		def find(tag string) int {
			for let (i, a) in axes {
				return i when a.tag == tag
			}
			return -1
		}

		// `v` on axis `i` mapped to -1..1: 0 at the default, clamped to the
		// axis range.
		def normalize(i int, v float32) float32 {
			let a = axes[i]
			let c = v.clamp(a.min, a.max)
			return float32(0.0) when c == a.initial
			return (c - a.initial) / (a.initial - a.min) when c < a.initial
			return (c - a.initial) / (a.max - a.initial)
		}
	}

	// A 16.16 fixed-point value.
	def fixed(d layout.Data, at int) float32 {
		let v = d.u32(at)
		let s = v >= 0x80000000 ?? (v - 0x100000000, v)
		return float32(s) / float32(65536.0)
	}

	// The `avar` table: a piecewise-linear remap per axis, then (version 2)
	// deltas from an item variation store keyed on the remapped coordinates.
	type Avar {
		internal d        layout.Data
		// Offset of each axis's segment map.
		internal segments int[]
		internal store    layout.VariationStore
		internal indexMap layout.DeltaSetIndexMap
		internal v2       bool

		def new(b byte[] = byte[]) {
			d = new layout.Data(b)
			store = new layout.VariationStore()
			indexMap = new layout.DeltaSetIndexMap()
			let major = d.u16(0)
			return when d.len() < 8 || (major != 1 && major != 2)
			let count = d.u16(6)
			let at = 8
			for let i = 0; i < count; i++ {
				return unless d.has(at, 2)
				segments.push(at)
				at += 2 + d.u16(at) * 4
			}
			if major == 2 && d.has(at, 8) {
				v2 = true
				indexMap = new layout.DeltaSetIndexMap(d, d.u32(at))
				store = new layout.VariationStore(d, d.u32(at + 4))
			}
		}

		// Remaps 16.16 normalized coordinates in place.
		def map(coords int[]) {
			let count = coords.len().min(segments.len())
			for let i = 0; i < count; i++ {
				coords[i] = layout.roundHalfUp(segmentMap(segments[i], float32(coords[i]) / float32(65536.0)) * float32(65536.0))
			}
			return unless v2
			let f2dot14 int[]
			for let (_, c) in coords {
				f2dot14.push(layout.roundHalfUp(float32(c) / float32(4.0)))
			}
			let out int[]
			for let (i, c) in coords {
				let delta = store.delta(indexMap.map(i), f2dot14)
				out.push((c + layout.roundHalfUp(delta * float32(4.0))).clamp(-65536, 65536))
			}
			for let (i, c) in out {
				coords[i] = c
			}
		}

		// One axis's segment map at `v`. Beyond what the specification asks
		// (at least -1, 0 and 1 mapped), repeated and missing entries are
		// resolved the way CoreText does, which real fonts rely on.
		internal def segmentMap(at int, v float32) float32 {
			let len = d.u16(at)
			return v when len == 0
			if len == 1 {
				return v - from(at, 0) + to(at, 0)
			}
			let start = 0
			let end = len
			start++ when from(at, 0) == float32(-1.0) && to(at, 0) == float32(-1.0) && from(at, 1) == float32(-1.0)
			end-- when from(at, end - 1) == float32(1.0) && to(at, end - 1) == float32(1.0) && from(at, end - 2) == float32(1.0)

			let i = start
			for i < end && v != from(at, i) {
				i++
			}
			if i < end {
				let j = i
				for j + 1 < end && v == from(at, j + 1) {
					j++
				}
				return to(at, i) when i == j
				return to(at, i + 1) when i + 2 == j
				return to(at, j) when v < float32(0.0)
				return to(at, i) when v > float32(0.0)
				return to(at, i).abs() < to(at, j).abs() ?? (to(at, i), to(at, j))
			}

			i = start
			for i < end && !(v < from(at, i)) {
				i++
			}
			return v - from(at, 0) + to(at, 0) when i == 0
			return v - from(at, end - 1) + to(at, end - 1) when i == end
			let denom = from(at, i) - from(at, i - 1)
			return to(at, i - 1) + (to(at, i) - to(at, i - 1)) * (v - from(at, i - 1)) / denom
		}

		internal def from(at int, i int) float32 {
			return float32(d.i16(at + 2 + i * 4)) / float32(16384.0)
		}

		internal def to(at int, i int) float32 {
			return float32(d.i16(at + 4 + i * 4)) / float32(16384.0)
		}
	}

	// Normalized F2Dot14 coordinates, one per axis, for user coordinates keyed
	// by axis tag. Unknown tags are ignored and missing axes stay at their
	// default; a tag several axes share sets them all.
	def normalizeUser(fvar Fvar, avar Avar, user map<string, float>) int[] {
		let coords int[]
		coords.len(fvar.axes.len())
		coords.fill(0)
		// A tag names every axis that carries it.
		for let (i, a) in fvar.axes {
			let value = user.get(a.tag)
			continue when value is none
			coords[i] = layout.roundHalfUp(fvar.normalize(i, float32(value)) * float32(65536.0))
		}
		avar.map(coords)
		for let i = 0; i < coords.len(); i++ {
			coords[i] = (coords[i] + 2) >> 2
		}
		return coords
	}
}
