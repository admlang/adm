// Glyph outline variations (`gvar`): per-glyph tuples of point deltas, each
// scaled by how far the instance sits toward the tuple's peak, with deltas
// for points a tuple leaves out inferred from their neighbours.

internal partial module std.formats.fonts.variations {
	use std.formats.fonts.layout

	internal const (
		tupleEmbeddedPeak  = 0x8000
		tupleIntermediate  = 0x4000
		tuplePrivatePoints = 0x2000
		tupleIndexMask     = 0x0FFF
		sharedPointNumbers = 0x8000
		tupleCountMask     = 0x0FFF
	)

	// A glyph's points as variations move them: coordinates in font units and
	// whether each point ends a contour. Composite glyphs contribute one point
	// per component (its offset), each its own contour; the four phantom
	// points close the list and end no contour.
	type GlyphPoints {
		xs   float32[]
		ys   float32[]
		ends bool[]
		// On-curve flags of simple-glyph points.
		on   bool[]

		def new() {}

		def push(x float32, y float32, end bool, onCurve bool = false) {
			xs.push(x)
			ys.push(y)
			ends.push(end)
			on.push(onCurve)
		}

		// Drops every point from `n` on.
		def truncate(n int) {
			xs.len(n)
			ys.len(n)
			ends.len(n)
			on.len(n)
		}

		def len() int {
			return xs.len()
		}
	}

	// The `gvar` table.
	type Gvar {
		internal d          layout.Data
		internal axisCount  int
		internal sharedAt   int
		internal sharedCount int
		internal glyphCount int
		internal long       bool
		internal dataAt     int

		def new(b byte[] = byte[]) {
			d = new layout.Data(b)
			return when d.len() < 20 || d.u32(0) != 0x00010000
			axisCount = d.u16(4)
			sharedCount = d.u16(6)
			sharedAt = d.u32(8)
			glyphCount = d.u16(12)
			long = d.u16(14) & 1 != 0
			dataAt = d.u32(16)
		}

		def present() bool {
			return glyphCount > 0
		}

		// The byte range of a glyph's variation data.
		internal def span(g int) (int, int) {
			if long {
				return (dataAt + d.u32(20 + g * 4), dataAt + d.u32(24 + g * 4))
			}
			return (dataAt + d.u16(20 + g * 2) * 2, dataAt + d.u16(22 + g * 2) * 2)
		}

		// Moves `points` of glyph `g` to the instance at `coords` (F2Dot14,
		// one per axis). False when the variation data is malformed.
		def apply(g int, coords int[], points GlyphPoints) bool {
			return true when g >= glyphCount
			let (start, stop) = span(g)
			return true when stop <= start || stop > d.len()
			let header = d.u16(start)
			let tuples = header & tupleCountMask
			return true when tuples == 0
			let serialized = start + d.u16(start + 2)

			let shared int[]
			let cursor = serialized
			if header & sharedPointNumbers != 0 {
				let (ok, next) = readPoints(cursor, stop, shared)
				return false unless ok
				cursor = next
			}

			let count = points.len()
			let dx float32[]
			let dy float32[]
			let flags bool[]
			let origX float32[]
			let origY float32[]
			let havePending = false
			let haveOrig = false
			let anyPrivate = false
			let privateChecked = false
			let flush = false

			let at = start + 4
			let left = tuples
			for left > 0 {
				let index = d.u16(at + 2)
				let size = tupleHeaderSize(index)
				break when at + size > stop
				let dataSize = d.u16(at)
				let dataStart = cursor
				cursor += dataSize
				let tupleAt = at
				at += size
				left--

				let scalar = float32(tupleScalar(tupleAt, index, coords))
				continue when scalar == float32(0.0)

				if !privateChecked {
					let scanAt = tupleAt
					let scanLeft = left + 1
					for scanLeft > 0 {
						let si = d.u16(scanAt + 2)
						let ss = tupleHeaderSize(si)
						break when scanAt + ss > stop
						if si & tuplePrivatePoints != 0 {
							anyPrivate = true
							break
						}
						scanAt += ss
						scanLeft--
					}
					privateChecked = true
				}
				let end = dataStart + dataSize
				return false when end > stop

				if !havePending {
					dx.len(count)
					dy.len(count)
					flags.len(count)
					dx.fill(float32(0.0))
					dy.fill(float32(0.0))
					flags.fill(false)
					havePending = true
				}

				let p = dataStart
				let indices = shared
				if index & tuplePrivatePoints != 0 {
					let own int[]
					let (ok, next) = readPoints(p, end, own)
					return false unless ok
					p = next
					indices = own
				}
				let all = indices.len() == 0
				let n = all ?? (count, indices.len())

				let xd int[]
				let yd int[]
				xd.len(n)
				yd.len(n)
				let (okX, afterX) = readDeltas(p, end, xd)
				return false unless okX
				let (okY, _) = readDeltas(afterX, end, yd)
				return false unless okY

				if all && !anyPrivate {
					for let i = 0; i < count; i++ {
						points.xs[i] += float32(xd[i]) * scalar
					}
					for let i = 0; i < count; i++ {
						points.ys[i] += float32(yd[i]) * scalar
					}
					continue
				}

				if !all {
					if !haveOrig {
						origX = points.xs.clone()
						origY = points.ys.clone()
						haveOrig = true
					}
					if flush {
						for let i = 0; i < count; i++ {
							points.xs[i] += dx[i]
							points.ys[i] += dy[i]
						}
					}
					dx.fill(float32(0.0))
					dy.fill(float32(0.0))
					flags.fill(false)
				}

				for let i = 0; i < n; i++ {
					let pt = all ?? (i, indices[i])
					continue when pt >= count
					flags[pt] = true unless all
					if scalar != float32(1.0) {
						dx[pt] += float32(xd[i]) * scalar
						dy[pt] += float32(yd[i]) * scalar
					} else {
						dx[pt] += float32(xd[i])
						dy[pt] += float32(yd[i])
					}
				}

				infer(points, origX, origY, dx, dy, flags) unless all
				flush = true
			}

			if flush {
				for let i = 0; i < count; i++ {
					points.xs[i] += dx[i]
					points.ys[i] += dy[i]
				}
			}
			return true
		}

		// Size of a tuple variation header with tuple index `index`.
		internal def tupleHeaderSize(index int) int {
			let size = 4
			size += axisCount * 2 when index & tupleEmbeddedPeak != 0
			size += axisCount * 4 when index & tupleIntermediate != 0
			return size
		}

		// How much the tuple at `at` applies at `coords`, in double precision.
		internal def tupleScalar(at int, index int, coords int[]) float {
			let peakAt = 0
			if index & tupleEmbeddedPeak != 0 {
				peakAt = at + 4
			} else {
				let shared = index & tupleIndexMask
				return 0.0 when (shared + 1) * axisCount > sharedCount * axisCount
				peakAt = sharedAt + shared * axisCount * 2
			}
			let interm = index & tupleIntermediate != 0
			let startAt = at + 4 + (index & tupleEmbeddedPeak != 0 ?? (axisCount * 2, 0))
			let endAt = startAt + axisCount * 2
			let scalar = 1.0
			for let i = 0; i < axisCount; i++ {
				let peak = d.i16(peakAt + i * 2)
				continue when peak == 0
				let v = i < coords.len() ?? (coords[i], 0)
				return 0.0 when v == 0
				continue when v == peak
				if interm {
					let start = d.i16(startAt + i * 2)
					let end = d.i16(endAt + i * 2)
					continue when start > peak || peak > end || (start < 0 && end > 0)
					return 0.0 when v < start || v > end
					if v < peak {
						scalar *= float(v - start) / float(peak - start) when peak != start
					} else {
						scalar *= float(end - v) / float(end - peak) when peak != end
					}
				} else {
					return 0.0 when v < 0.min(peak) || v > 0.max(peak)
					scalar *= float(v) / float(peak)
				}
			}
			return scalar
		}

		// Packed point numbers at `p` into `out`; no numbers means every point.
		internal def readPoints(p int, end int, out int[]) (bool, int) {
			return (false, p) when p + 1 > end
			let count = d.u8(p)
			p++
			if count & 0x80 != 0 {
				return (false, p) when p + 1 > end
				count = ((count & 0x7F) << 8) | d.u8(p)
				p++
			}
			let n = 0
			let i = 0
			for i < count {
				return (false, p) when p + 1 > end
				let control = d.u8(p)
				p++
				let run = (control & 0x7F) + 1
				return (false, p) when i + run > count
				let words = control & 0x80 != 0
				return (false, p) when p + run * (words ?? (2, 1)) > end
				for let k = 0; k < run; k++ {
					if words {
						n += d.u16(p)
						p += 2
					} else {
						n += d.u8(p)
						p++
					}
					out.push(n)
					i++
				}
			}
			return (true, p)
		}

		// Packed deltas at `p` filling `out`.
		internal def readDeltas(p int, end int, out int[]) (bool, int) {
			let count = out.len()
			let i = 0
			for i < count {
				return (false, p) when p + 1 > end
				let control = d.u8(p)
				p++
				let run = (control & 0x3F) + 1
				return (false, p) when i + run > count
				match control & 0xC0 {
					case 0x80:
						for let k = 0; k < run; k++ {
							out[i + k] = 0
						}
					case 0x40:
						return (false, p) when p + run * 2 > end
						for let k = 0; k < run; k++ {
							out[i + k] = d.i16(p + k * 2)
						}
						p += run * 2
					case 0xC0:
						return (false, p) when p + run * 4 > end
						for let k = 0; k < run; k++ {
							let v = d.u32(p + k * 4)
							out[i + k] = v >= 0x80000000 ?? (v - 0x100000000, v)
						}
						p += run * 4
					default:
						return (false, p) when p + run > end
						for let k = 0; k < run; k++ {
							let v = d.u8(p + k)
							out[i + k] = v >= 128 ?? (v - 256, v)
						}
						p += run
				}
				i += run
			}
			return (true, p)
		}
	}

	// Fills in deltas for the points of each contour a tuple left out, from
	// the referenced points on either side.
	def infer(points GlyphPoints, ox float32[], oy float32[], dx float32[], dy float32[], flags bool[]) {
		let count = points.len()
		let start = 0
		let stop = 0
		for true {
			for stop < count && !points.ends[stop] {
				stop++
			}
			break when stop == count
			let referenced = 0
			for let i = start; i <= stop; i++ {
				referenced++ when flags[i]
			}
			let unref = (stop - start + 1) - referenced
			if unref > 0 && unref <= stop - start {
				let j = start
				let done = false
				for !done {
					let i = j
					for true {
						i = j
						j = nextIndex(i, start, stop)
						break when flags[i] && !flags[j]
					}
					let prev = i
					j = i
					for true {
						i = j
						j = nextIndex(i, start, stop)
						break when !flags[i] && flags[j]
					}
					let next = j
					i = prev
					for true {
						i = nextIndex(i, start, stop)
						break when i == next
						dx[i] = inferDelta(ox, dx, i, prev, next)
						dy[i] = inferDelta(oy, dy, i, prev, next)
						unref--
						if unref == 0 {
							done = true
							break
						}
					}
				}
			}
			stop++
			start = stop
		}
	}

	def nextIndex(i int, start int, end int) int {
		return i >= end ?? (start, i + 1)
	}

	// The delta for `target` between referenced points `prev` and `next`:
	// shifted like the nearer one when outside their span, interpolated
	// inside it.
	def inferDelta(orig float32[], deltas float32[], target int, prev int, next int) float32 {
		let t = orig[target]
		let pv = orig[prev]
		let nv = orig[next]
		let pd = deltas[prev]
		let nd = deltas[next]
		if pv == nv {
			return pd == nd ?? (pd, float32(0.0))
		}
		if t <= pv.min(nv) {
			return pv < nv ?? (pd, nd)
		}
		if t >= pv.max(nv) {
			return pv > nv ?? (pd, nd)
		}
		let r = (t - pv) / (nv - pv)
		return pd + r * (nd - pd)
	}
}
