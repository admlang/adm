// Variable composite glyphs (`VARC`): glyphs built from other glyphs, each
// placed by a decomposed transform and drawn at its own point of the design
// space, with the transforms and those points varying too.

internal partial module std.formats.fonts.variations {
	use (
		std.math::(sin, cos, tan)
		std.formats.fonts.layout
	)

	internal const (
		varcResetAxes       = 0x0001
		varcHaveAxes        = 0x0002
		varcAxesVary        = 0x0004
		varcTransformVaries = 0x0008
		varcTranslateX      = 0x0010
		varcTranslateY      = 0x0020
		varcRotation        = 0x0040
		varcCondition       = 0x0080
		varcScaleX          = 0x0100
		varcScaleY          = 0x0200
		varcCenterX         = 0x0400
		varcCenterY         = 0x0800
		varcGid24           = 0x1000
		varcSkewX           = 0x2000
		varcSkewY           = 0x4000
		varcReservedMask    = 0xFFFF8000
		// A VarIdx meaning "no variation".
		noVariation         = 0xFFFFFFFF
		varcMaxDepth        = 64
		varcMaxEdges        = 2048
	)

	// A 2D affine transform: x' = xx·x + xy·y + x0, y' = yx·x + yy·y + y0.
	struct Transform {
		xx float
		yx float
		xy float
		yy float
		x0 float
		y0 float
	}

	def identity() Transform {
		return Transform{xx: 1.0, yy: 1.0}
	}

	// `a` followed by `b`: b applies first, then a.
	def compose(a Transform, b Transform) Transform {
		return Transform{
			xx: a.xx * b.xx + a.xy * b.yx,
			yx: a.yx * b.xx + a.yy * b.yx,
			xy: a.xx * b.xy + a.xy * b.yy,
			yy: a.yx * b.xy + a.yy * b.yy,
			x0: a.xx * b.x0 + a.xy * b.y0 + a.x0,
			y0: a.yx * b.x0 + a.yy * b.y0 + a.y0
		}
	}

	def isIdentity(t Transform) bool {
		return t.xx == 1.0 && t.yx == 0.0 && t.xy == 0.0 && t.yy == 1.0 && t.x0 == 0.0 && t.y0 == 0.0
	}

	// A decomposed component transform, in the order the table applies it:
	// translate to the center plus offset, rotate, scale, skew, translate
	// back from the center. Angles are in radians, counter-clockwise.
	def decomposed(translateX float, translateY float, rotation float, scaleX float, scaleY float, skewX float, skewY float, centerX float, centerY float) Transform {
		let t = identity()
		t = translate(t, translateX + centerX, translateY + centerY)
		if rotation != 0.0 {
			let c = cos(rotation)
			let s = sin(rotation)
			t = compose(t, Transform{xx: c, yx: s, xy: -s, yy: c})
		}
		if scaleX != 1.0 || scaleY != 1.0 {
			t.xx *= scaleX
			t.yx *= scaleX
			t.xy *= scaleY
			t.yy *= scaleY
		}
		if skewX != 0.0 || skewY != 0.0 {
			let sx = -skewX
			t = compose(t, Transform{xx: 1.0, yx: skewY != 0.0 ?? (tan(skewY), 0.0), xy: sx != 0.0 ?? (tan(sx), 0.0), yy: 1.0})
		}
		return translate(t, -centerX, -centerY)
	}

	def translate(t Transform, x float, y float) Transform {
		return t when x == 0.0 && y == 0.0
		let out = t
		out.x0 = t.x0 + t.xx * x + t.xy * y
		out.y0 = t.y0 + t.yx * x + t.yy * y
		return out
	}

	// A variable-length unsigned integer (1 to 5 bytes, the leading bits of
	// the first byte giving the length), and where it ends.
	def readVarInt(d layout.Data, p int) (int, int) {
		let b0 = d.u8(p)
		return (b0, p + 1) when b0 < 0x80
		return ((b0 & 0x3F) << 8 | d.u8(p + 1), p + 2) when b0 < 0xC0
		return ((b0 & 0x1F) << 16 | d.u16(p + 1), p + 3) when b0 < 0xE0
		return ((b0 & 0x0F) << 24 | d.u8(p + 1) << 16 | d.u16(p + 2), p + 4) when b0 < 0xF0
		return (d.u32(p + 1), p + 5)
	}

	def varIntSize(d layout.Data, p int) int {
		let b0 = d.u8(p)
		return b0 < 0x80 ?? (1, b0 < 0xC0 ?? (2, b0 < 0xE0 ?? (3, b0 < 0xF0 ?? (4, 5))))
	}

	// A CFF2-style INDEX: a 32-bit count, then offsets of `offSize` bytes
	// into the data after them.
	type Index2 {
		internal d       layout.Data
		internal at      int
		internal count   int
		internal offSize int

		def new(d layout.Data = new layout.Data(), at int = 0) {
			self.d = d
			self.at = at
			return when at == 0
			count = d.u32(at)
			offSize = d.u8(at + 4)
			count = 0 when offSize < 1 || offSize > 4
		}

		def len() int {
			return count
		}

		internal def offset(i int) int {
			let p = at + 5 + i * offSize
			let v = 0
			for let k = 0; k < offSize; k++ {
				v = (v << 8) | d.u8(p + k)
			}
			return v
		}

		// The byte range of item `i`: (start, end) in the data.
		def item(i int) (int, int) {
			return (0, 0) when i < 0 || i >= count
			let base = at + 5 + (count + 1) * offSize - 1
			let start = base + offset(i)
			let end = base + offset(i + 1)
			return (0, 0) when end < start || end > d.len()
			return (start, end)
		}
	}

	// Streams packed TupleValues: runs of zeros, bytes, words or longs.
	type TupleReader {
		internal d     layout.Data
		internal p     int
		internal end   int
		internal run   int
		internal width int

		def new(d layout.Data, p int, end int) {
			self.d = d
			self.p = p
			self.end = end
		}

		internal def ensureRun() bool {
			return true when run > 0
			return false when p >= end
			let control = d.u8(p)
			p++
			run = (control & 0x3F) + 1
			match control & 0xC0 {
				case 0x80:
					width = 0
				case 0x00:
					width = 1
				case 0x40:
					width = 2
				default:
					width = 4
			}
			if p + run * width > end {
				run = 0
				return false
			}
			return true
		}

		internal def value() int {
			match width {
				case 0:
					return 0
				case 1:
					let v = d.u8(p)
					p++
					return v >= 128 ?? (v - 256, v)
				case 2:
					let v = d.i16(p)
					p += 2
					return v
			}
			let v = d.u32(p)
			p += 4
			return v >= 0x80000000 ?? (v - 0x100000000, v)
		}

		// The next value; false when the data runs out.
		def next() (bool, int) {
			return (false, 0) unless ensureRun()
			run--
			return (true, value())
		}

		def skip(n int) {
			for let i = 0; i < n; i++ {
				let (ok, _) = next()
				return unless ok
			}
		}

		// Adds the next `out.len()` values, times `scale`, to `out`.
		def addTo(out float32[], scale float32) {
			for let i = 0; i < out.len(); i++ {
				let (ok, v) = next()
				return unless ok
				out[i] += float32(v) * scale
			}
		}
	}

	// Every value of the TupleValues in [p, end).
	def readTuples(d layout.Data, p int, end int) int[] {
		let out int[]
		let r = new TupleReader(d, p, end)
		for true {
			let (ok, v) = r.next()
			break unless ok
			out.push(v)
		}
		return out
	}

	// A MultiItemVariationStore: each entry varies a whole list of values,
	// over sparse regions that name only the axes they use.
	type MultiItemStore {
		internal d       layout.Data
		internal at      int
		internal regions int

		def new(d layout.Data = new layout.Data(), at int = 0) {
			self.d = d
			self.at = at
			return when at == 0 || d.u16(at) != 1
			regions = at + d.u32(at + 2)
		}

		internal def regionScalar(r int, coords int[]) float32 {
			return float32(0.0) when r >= d.u16(regions)
			let region = regions + d.u32(regions + 2 + r * 4)
			let v = float32(1.0)
			for let i = 0; i < d.u16(region); i++ {
				let a = region + 2 + i * 8
				let axis = d.u16(a)
				let coord = axis < coords.len() ?? (coords[axis], 0)
				let f = layout.axisScalar(d.i16(a + 2), d.i16(a + 4), d.i16(a + 6), coord)
				return float32(0.0) when f == float32(0.0)
				v *= f
			}
			return v
		}

		// Adds entry `index`'s deltas at `coords` to `out`, one per value.
		def addDeltas(index int, coords int[], out float32[]) {
			return when at == 0 || index == noVariation
			let outer = (index >> 16) & 0xFFFF
			let inner = index & 0xFFFF
			return when outer >= d.u16(at + 6)
			let data = at + d.u32(at + 8 + outer * 4)
			return when d.u8(data) != 1
			let count = d.u16(data + 1)
			let sets = new Index2(d, data + 3 + count * 2)
			let (start, end) = sets.item(inner)
			return when end <= start
			let r = new TupleReader(d, start, end)
			let skip = 0
			for let k = 0; k < count; k++ {
				let scalar = regionScalar(d.u16(data + 3 + k * 2), coords)
				if scalar == float32(0.0) {
					skip += out.len()
				} else {
					r.skip(skip)
					skip = 0
					r.addTo(out, scalar)
				}
			}
		}
	}

	// The `VARC` table.
	type Varc {
		internal d          layout.Data
		internal coverage   int
		internal store      MultiItemStore
		internal conditions int
		internal axisLists  Index2
		internal records    Index2

		def new(b byte[] = byte[]) {
			d = new layout.Data(b)
			store = new MultiItemStore()
			axisLists = new Index2()
			records = new Index2()
			return when d.len() < 24 || d.u16(0) != 1
			coverage = d.u32(4)
			store = new MultiItemStore(d, d.u32(8))
			conditions = d.u32(12)
			axisLists = new Index2(d, d.u32(16))
			records = new Index2(d, d.u32(20))
		}

		def present() bool {
			return coverage != 0
		}

		// Whether glyph `g` is a variable composite.
		def covers(g int) bool {
			return coverage != 0 && d.coverage(coverage, g) >= 0
		}

		// Draws glyph `g` at `coords` through `transform`: each component
		// that is not itself a variable composite reaches `leaf` with its
		// glyph, coordinates and accumulated transform.
		def draw(g int, coords int[], leaf def (int, int[], Transform) bool) {
			let budget = [varcMaxEdges]
			let visiting int[]
			drawAt(g, coords, identity(), -1, leaf, varcMaxDepth, budget, visiting, coords)
		}

		internal def drawAt(g int, coords int[], t Transform, parent int, leaf def (int, int[], Transform) bool, depth int, budget int[], visiting int[], fontCoords int[]) {
			let idx = g == parent ?? (-1, (coverage == 0 ?? (-1, d.coverage(coverage, g))))
			if idx < 0 {
				leaf(g, coords, t)
				return
			}
			return when depth <= 0 || budget[0] <= 0
			budget[0]--
			for let (_, v) in visiting {
				return when v == g
			}
			visiting.push(g)
			let (start, end) = records.item(idx)
			let p = start
			for p < end {
				p = drawComponent(g, p, end, coords, t, leaf, depth, budget, visiting, fontCoords)
				break when p < 0
			}
			visiting.len(visiting.len() - 1)
		}

		// Reads and draws the component record at `p`; returns where the next
		// one starts, -1 when the record is truncated.
		internal def drawComponent(parent int, p int, end int, coords int[], total Transform, leaf def (int, int[], Transform) bool, depth int, budget int[], visiting int[], fontCoords int[]) int {
			return -1 when p + 1 > end || p + varIntSize(d, p) > end
			let (flags, afterFlags) = readVarInt(d, p)
			p = afterFlags
			let gid = 0
			if flags & varcGid24 != 0 {
				return -1 when p + 3 > end
				gid = d.u8(p) << 16 | d.u16(p + 1)
				p += 3
			} else {
				return -1 when p + 2 > end
				gid = d.u16(p)
				p += 2
			}

			let show = true
			if flags & varcCondition != 0 {
				return -1 when p + varIntSize(d, p) > end
				let (index, next) = readVarInt(d, p)
				p = next
				let list = conditions
				if list != 0 && index < d.u32(list) {
					let cond = list + d.u32(list + 4 + index * 4)
					let values = store
					show = layout.conditionHolds(d, cond, coords, (varIdx int) => oneDelta(values, varIdx, coords), 0)
				} else {
					show = false
				}
			}

			let axisIndices int[]
			let axisValues float32[]
			if flags & varcHaveAxes != 0 {
				return -1 when p + varIntSize(d, p) > end
				let (listIndex, next) = readVarInt(d, p)
				p = next
				let (ls, le) = axisLists.item(listIndex)
				axisIndices = readTuples(d, ls, le)
				let r = new TupleReader(d, p, end)
				for let i = 0; i < axisIndices.len(); i++ {
					let (_, v) = r.next()
					axisValues.push(float32(v))
				}
				p = r.p
			}
			if flags & varcAxesVary != 0 {
				return -1 when p + varIntSize(d, p) > end
				let (varIdx, next) = readVarInt(d, p)
				p = next
				store.addDeltas(varIdx, coords, axisValues) when show && varied(coords)
			}

			let componentCoords = coords
			componentCoords = fontCoords when flags & varcResetAxes != 0

			let transformIdx = noVariation
			if flags & varcTransformVaries != 0 {
				return -1 when p + varIntSize(d, p) > end
				let (varIdx, next) = readVarInt(d, p)
				transformIdx = varIdx
				p = next
			}

			// Translate x and y, rotation, scale x and y, skew x and y and the
			// center, in that order, each present by its flag.
			let order = [varcTranslateX, varcTranslateY, varcRotation, varcScaleX, varcScaleY, varcSkewX, varcSkewY, varcCenterX, varcCenterY]
			let shifts = [0, 0, 12, 10, 10, 12, 12, 0, 0]
			let values float32[]
			values.len(9)
			values.fill(float32(0.0))
			values[3] = float32(1.0)
			values[4] = float32(1.0)
			let present float32[]
			for let (k, flag) in order {
				if flags & flag != 0 {
					return -1 when p + 2 > end
					values[k] = float32(d.i16(p))
					p += 2
				}
			}
			// Reserved fields: one variable-length integer per set bit.
			let reserved = flags & varcReservedMask
			for reserved != 0 {
				return -1 when p + varIntSize(d, p) > end
				let (_, next) = readVarInt(d, p)
				p = next
				reserved = reserved & (reserved - 1)
			}

			if show {
				let childCoords = componentCoords
				if axisIndices.len() > 0 {
					childCoords = componentCoords.clone()
					for let (i, axis) in axisIndices {
						continue when axis >= 4096
						for childCoords.len() <= axis {
							childCoords.push(0)
						}
						childCoords[axis] = layout.roundHalfUp(axisValues[i])
					}
				}
				if transformIdx != noVariation && varied(coords) {
					for let (k, flag) in order {
						present.push(values[k]) when flags & flag != 0
					}
					store.addDeltas(transformIdx, coords, present)
					let n = 0
					for let (k, flag) in order {
						if flags & flag != 0 {
							values[k] = present[n]
							n++
						}
					}
				}
				for let (k, flag) in order {
					if shifts[k] != 0 && flags & flag != 0 {
						values[k] *= float32(1.0) / float32(1 << shifts[k])
					}
				}
				values[4] = values[3] unless flags & varcScaleY != 0
				let pi = 3.14159265358979323846
				let local = decomposed(float(values[0]), float(values[1]), float(values[2]) * pi, float(values[3]), float(values[4]), float(values[5]) * pi, float(values[6]) * pi, float(values[7]), float(values[8]))
				drawAt(gid, childCoords, compose(total, local), parent, leaf, depth - 1, budget, visiting, fontCoords)
			}
			return p
		}
	}

	// One delta of a MultiItemVariationStore entry.
	def oneDelta(store MultiItemStore, index int, coords int[]) float32 {
		let out = [float32(0.0)]
		store.addDeltas(index, coords, out)
		return out[0]
	}
}
