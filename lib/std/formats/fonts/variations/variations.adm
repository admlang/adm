// Everything a variable sfnt face varies by, read once per font and shared by
// every instance: the design space, glyph outline deltas and the metric
// variation tables (`HVAR`, `VVAR`, `MVAR`).

internal partial module std.formats.fonts.variations {
	use std.formats.fonts.layout

	// Advance and side-bearing variations, horizontal (`HVAR`) or vertical
	// (`VVAR`).
	type MetricsVariations {
		internal store     layout.VariationStore
		internal advance   layout.DeltaSetIndexMap
		// VVAR's vertical-origin map; absent in HVAR.
		internal origin    layout.DeltaSetIndexMap
		internal hasOrigin bool

		def new(b byte[] = byte[]) {
			let d = new layout.Data(b)
			store = new layout.VariationStore()
			advance = new layout.DeltaSetIndexMap()
			origin = new layout.DeltaSetIndexMap()
			return when d.len() < 20 || d.u16(0) != 1
			store = new layout.VariationStore(d, d.u32(4))
			advance = new layout.DeltaSetIndexMap(d, d.u32(8))
			if d.len() >= 24 && d.u32(20) != 0 {
				origin = new layout.DeltaSetIndexMap(d, d.u32(20))
				hasOrigin = true
			}
		}

		def present() bool {
			return store.present()
		}

		// The advance delta of glyph `g` at `coords`, unrounded.
		def advanceDelta(g int, coords int[]) float32 {
			return store.delta(advance.map(g), coords)
		}

		// The vertical-origin delta of glyph `g` at `coords` (VVAR only), 0
		// when the table has no origin map.
		def originDelta(g int, coords int[]) float32 {
			return float32(0.0) unless hasOrigin
			return store.delta(origin.map(g), coords)
		}
	}

	// Font-wide metric variations (`MVAR`), keyed by tags such as "hasc" or
	// "xhgt".
	type Mvar {
		internal d       layout.Data
		internal store   layout.VariationStore
		internal records int
		internal size    int
		internal count   int

		def new(b byte[] = byte[]) {
			d = new layout.Data(b)
			store = new layout.VariationStore()
			return when d.len() < 12 || d.u16(0) != 1
			size = d.u16(6)
			count = d.u16(8)
			records = 12
			store = new layout.VariationStore(d, d.u16(10))
			count = 0 when size < 8
		}

		// The delta of the value tagged `tag` at `coords`, unrounded; 0 when
		// the table does not vary it.
		def delta(tag string, coords int[]) float32 {
			let lo = 0
			let hi = count - 1
			for lo <= hi {
				let mid = (lo + hi) / 2
				let r = records + mid * size
				let t = d.tag(r)
				if t < tag {
					lo = mid + 1
				} else if t > tag {
					hi = mid - 1
				} else {
					return store.delta(d.u16(r + 4) << 16 | d.u16(r + 6), coords)
				}
			}
			return float32(0.0)
		}
	}

	// The variation tables of one face.
	type FaceVariations {
		fvar Fvar
		avar Avar
		gvar Gvar
		hvar MetricsVariations
		vvar MetricsVariations
		mvar Mvar
		varc Varc

		// Reads the tables through `table`, which gives a table's bytes or an
		// empty array when the face lacks it.
		def new(table def (string) byte[]) {
			fvar = new Fvar(table("fvar"))
			avar = new Avar(table("avar"))
			gvar = new Gvar(table("gvar"))
			hvar = new MetricsVariations(table("HVAR"))
			vvar = new MetricsVariations(table("VVAR"))
			mvar = new Mvar(table("MVAR"))
			varc = new Varc(table("VARC"))
		}

		// Whether the face has a design space to move in.
		def variable() bool {
			return fvar.axes.len() > 0
		}

		// Normalized coordinates for user coordinates keyed by axis tag.
		def normalize(user map<string, float>) int[] {
			return normalizeUser(fvar, avar, user)
		}

		// The rounded delta of an `MVAR` value.
		def metric(tag string, coords int[]) int {
			return layout.roundHalfUp(mvar.delta(tag, coords))
		}
	}

	// Whether any coordinate is off the default.
	def varied(coords int[]) bool {
		for let (_, c) in coords {
			return true when c != 0
		}
		return false
	}
}
