// Windows bitmap fonts: FNT resources (versions 2 and 3), alone in a .fnt file
// or several to a .fon file, which is a 16-bit NE executable holding them as
// resources.

internal partial module std.formats.fonts.winfnt {
	use (
		std.math.geom
		std.formats.fonts
		std.formats.fonts.opentype
		std.data.encoding.codepages
	)

	const (
		// NE resource type of a font.
		resourceFont = 0x8008
		// FNT character sets that are not a plain byte-to-codepoint mapping.
		charsetANSI  = 0
		charsetOEM   = 255
	)

	// Codepoints of the pictures DOS draws for CP437 codes 0x01..0x1F.
	let cp437Graphics = int[
		0x263A, 0x263B, 0x2665, 0x2666, 0x2663, 0x2660, 0x2022, 0x25D8, 0x25CB, 0x25D9, 0x2642, 0x2640,
		0x266A, 0x266B, 0x263C, 0x25BA, 0x25C4, 0x2195, 0x203C, 0xB6, 0xA7, 0x25AC, 0x21A8, 0x2191,
		0x2193, 0x2192, 0x2190, 0x221F, 0x2194, 0x25B2, 0x25BC
	]


	def u8(data byte[], at int) !int {
		expects {
			assert at >= 0 && at < data.len() onerror fail "FNT data ends early"
		}
		return int(data[at])
	}

	def u16(data byte[], at int) !int {
		expects {
			assert at >= 0 && at + 2 <= data.len() onerror fail "FNT data ends early"
		}
		return int(data[at]) | (int(data[at + 1]) << 8)
	}

	def u32(data byte[], at int) !int {
		expects {
			assert at >= 0 && at + 4 <= data.len() onerror fail "FNT data ends early"
		}
		return int(data[at]) | (int(data[at + 1]) << 8) | (int(data[at + 2]) << 16) | (int(data[at + 3]) << 24)
	}

	// The FNT resources of a .fon file, as byte slices.
	// Fails when the NE header or resource table is damaged.
	def fonResources(data byte[]) !byte[][] {
		expects {
			assert data.len() >= 64 && data[0] == byte('M') && data[1] == byte('Z') onerror fail "not a FON file"
		}
		let ne = try u32(data, 0x3C)
		fail "FON file is not a 16-bit NE executable" when ne + 64 > data.len() || data[ne] != byte('N') || data[ne + 1] != byte('E')

		let table = ne + (try u16(data, ne + 0x24))
		let shift = try u16(data, table)
		fail "FON resource alignment is invalid" when shift > 16

		let out byte[][]
		let p = table + 2
		for {
			let kind = try u16(data, p)
			break when kind == 0
			let count = try u16(data, p + 2)
			p += 8
			for let i = 0; i < count; i++ {
				if kind == resourceFont {
					let offset = (try u16(data, p)) << shift
					let length = (try u16(data, p + 2)) << shift
					fail "FON font resource runs past the end of the file" when offset + length > data.len()
					out.push(data[offset:offset + length])
				}
				p += 12
			}
		}
		fail "FON file holds no fonts" when out.len() == 0
		return out
	}

	// One FNT resource: a bitmap face at a single size.
	type FNTFace {
		data     byte[]
		version  int
		ascent   int
		height   int
		leading  int
		charset  int
		first    int
		last     int
		maxWidth int
		widths   int[]
		offsets  int[]
		details  fonts.FontInfo
		// Codepoint -> character code, for the character sets that need one.
		codes    map<int, int>

		def new() {
			codes = new map<int, int>()
		}

		// Reads the FNT header and glyph table.
		// Fails when the resource is not a raster FNT of version 2 or 3.
		def parse(data byte[], format string) !none {
			self.data = data
			version = try u16(data, 0)
			fail "unsupported FNT version {version >> 8}.{version & 0xFF}" when version != 0x0200 && version != 0x0300
			fail "FNT holds a vector font, which is not supported" when ((try u16(data, 66)) & 1) != 0

			let points = try u16(data, 68)
			ascent = try u16(data, 74)
			leading = try u16(data, 78)
			let italic = (try u8(data, 80)) != 0
			let weight = try u16(data, 83)
			charset = try u8(data, 85)
			let pixWidth = try u16(data, 86)
			height = try u16(data, 88)
			let pitch = try u8(data, 90)
			maxWidth = try u16(data, 93)
			first = try u8(data, 95)
			last = try u8(data, 96)
			fail "FNT character range is empty" when last < first
			fail "FNT has no pixel height" when height == 0

			let faceAt = try u32(data, 105)
			let family = ""
			if faceAt > 0 && faceAt < data.len() {
				let end = faceAt
				for end < data.len() && data[end] != 0 {
					end++
				}
				family = string(data[faceAt:end])
			}

			let entry = version == 0x0200 ?? (4, 6)
			let tableAt = version == 0x0200 ?? (118, 148)
			let count = last - first + 1
			for let i = 0; i < count; i++ {
				let at = tableAt + i * entry
				widths.push(try u16(data, at))
				offsets.push(version == 0x0200 ?? (try u16(data, at + 2), try u32(data, at + 2)))
			}

			let bold = weight >= 600
			let sub = bold ?? ("Bold", "Regular")
			sub = bold ?? ("Bold Italic", "Italic") when italic
			details = fonts.FontInfo{
				family:     family,
				subfamily:  sub,
				postscript: family.replace(" ", "") + "-" + sub.replace(" ", ""),
				weight:     opentype.weightFromClass(uint16(weight == 0 ?? (400, weight))),
				width:      fonts.FontWidth.Normal,
				italic:     italic,
				unitsPerEm: uint16(height),
				glyphCount: uint16(count),
				fixedPitch: pixWidth != 0 || (pitch & 1) == 0,
				scalable:   false,
				color:      false,
				format:     format
			}
			fail "FNT point size is zero" when points == 0

			if charset == charsetOEM {
				for let b = 0x80; b < 0x100; b++ {
					codes.set(int(codepages.decode(byte(b), codepages.CodePage.CP437)), b)
				}
				for let i = 0; i < cp437Graphics.len(); i++ {
					codes.set(cp437Graphics[i], 1 + i)
				}
				codes.set(0x2302, 0x7F)
			} else if charset == charsetANSI {
				for let b = 0x80; b < 0x100; b++ {
					codes.set(int(codepages.decode(byte(b), codepages.CodePage.Windows1252)), b)
				}
			}
		}

		// info returns the face's description. Every size of a family is its own
		// face, with `unitsPerEm` set to its pixel height.
		def info() fonts.FontInfo {
			return details
		}

		// metrics returns the face's vertical metrics, in pixels.
		def metrics() fonts.FontMetrics {
			return fonts.FontMetrics{
				ascent:  int16(ascent),
				descent: int16(ascent - height),
				lineGap: int16(leading),
				bounds:  geom.Rect{left: 0.0, top: float(ascent - height), right: float(maxWidth), bottom: float(ascent)}
			}
		}

		// glyph returns the glyph for the character, none when the font lacks it.
		def glyph(codepoint char) ?fonts.GlyphID {
			let cp = int(codepoint)
			let code = cp
			let mapped = codes.get(cp)
			if mapped is none {
				// Below 0x80 every character set agrees with ASCII; above it
				// OEM and ANSI map only through their tables, and the rest map
				// bytes straight through.
				return none when cp > 0xFF
				return none when cp >= 0x80 && charset == charsetOEM
				return none when cp >= 0x80 && cp < 0xA0 && charset == charsetANSI
			} else {
				code = mapped
			}
			return none when code < first || code > last
			return fonts.GlyphID(code - first)
		}

		// metrics returns the glyph's advance, in pixels. Fails when the glyph is
		// out of range.
		def metrics(glyph fonts.GlyphID) !fonts.GlyphMetrics {
			let i = int(glyph)
			fail "glyph {i} is out of range" when i < 0 || i >= widths.len()
			return fonts.GlyphMetrics{
				advance: int16(widths[i]),
				bounds: geom.Rect{left: 0.0, top: float(ascent - height), right: float(widths[i]), bottom: float(ascent)}
			}
		}

		// Bitmap fonts carry no kerning.
		def kern(left fonts.GlyphID, right fonts.GlyphID) int16 {
			return int16(0)
		}

		// A bitmap face has no outlines: this always fails.
		def outline(glyph fonts.GlyphID) !fonts.Outline {
			fail "a bitmap font has no outlines"
		}

		// rasterize returns the glyph's bitmap. At the face's own pixel height it
		// is the stored bitmap; other sizes scale it by pixel repetition.
		// Fails when the glyph is out of range, its bitmap runs past the data, or
		// the size is not positive.
		def rasterize(glyph fonts.GlyphID, size float) !fonts.Bitmap {
			let i = int(glyph)
			fail "glyph {i} is out of range" when i < 0 || i >= widths.len()
			fail "size must be positive" when size <= 0.0

			let w = widths[i]
			let columns = (w + 7) / 8
			let at = offsets[i]
			fail "glyph {i} bitmap runs past the end of the font" when at + columns * height > data.len()

			let scale = size / float(height)
			let outW = int(float(w) * scale + 0.5)
			let outH = int(size + 0.5)
			outW = 1 when outW < 1 && w > 0
			outH = 1 when outH < 1

			let coverage byte[]
			coverage.len(outW * outH)
			coverage[:] = 0
			for let y = 0; y < outH; y++ {
				let sy = int(float(y) / scale)
				sy = height - 1 when sy >= height
				for let x = 0; x < outW; x++ {
					let sx = int(float(x) / scale)
					sx = w - 1 when sx >= w
					let b = int(data[at + (sx >> 3) * height + sy])
					coverage[y * outW + x] = 255 when (b & (0x80 >> (sx & 7))) != 0
				}
			}
			return fonts.Bitmap{
				width: outW,
				height: outH,
				bearingX: 0,
				bearingY: int(float(ascent) * scale + 0.5),
				coverage: coverage
			}
		}
	}

	// A .fon or .fnt file: one face per FNT resource, all parsed on open.
	type FONFont {
		list fonts.Face[]

		def new(list fonts.Face[]) {
			self.list = list
		}

		// faces returns how many faces the file holds.
		def faces() int {
			return list.len()
		}

		// face returns the face at index. Fails when the index is out of range.
		def face(index int) !fonts.Face {
			expects {
				assert index >= 0 && index < list.len() onerror fail "face index {index} is out of range"
			}
			return list[index]
		}

		// close releases the faces. It cannot fail.
		def close() !none {
			list = fonts.Face[]
			return none
		}
	}

	// Opens .fon or .fnt bytes.
	// Fails when the data is neither, or a resource is damaged.
	def open(data byte[]) !FONFont {
		let resources byte[][]
		let format = "fnt"
		if data.len() >= 2 && data[0] == byte('M') && data[1] == byte('Z') {
			resources = try fonResources(data)
			format = "fon"
		} else {
			resources.push(data)
		}

		let list fonts.Face[]
		for let (_, r) in resources {
			let face = new FNTFace()
			try face.parse(r, format)
			list.push(face)
		}
		return new FONFont(list)
	}
}
