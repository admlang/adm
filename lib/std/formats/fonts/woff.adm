partial module std.formats.fonts {
	use (
		std.io
		std.bytes
		std.data.compress.zlib
		std.formats.fonts.opentype
	)

	// WOFF is the Web Open Font Format 1.0 codec: an sfnt font whose tables are
	// zlib-compressed one by one. Faces report "woff" as their format.
	@codec("WOFF")
	type WOFF {
		mimeType string[] {
			def get() string[] {
				return string["font/woff", "application/font-woff"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".woff"]
			}
		}

		// The signature `wOFF`.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)

			let n = r.read(b) onerror recover 0
			return false when n != 4
			return b.equals(byte[byte('w'), byte('O'), byte('F'), byte('F')])
		}

		// open decompresses a WOFF font from the reader. Fails when the data is not
		// WOFF, a table does not decompress to its declared size, or the font
		// inside is damaged.
		def open(reader io.Reader) !Font {
			return opentype.open(try unpack(try opentype.readAll(reader)), "woff")
		}

		// info reads the font's description from the reader. Fails like open.
		def info(reader io.Reader) !FontInfo {
			return opentype.info(try unpack(try opentype.readAll(reader)), "woff")
		}

		// The extended metadata block: an XML document describing the font's
		// origin and licence, or an empty string when the file carries none.
		// Fails when the data is not WOFF or the block does not decompress.
		def metadata(reader io.Reader) !string {
			let data = try opentype.readAll(reader)
			let r = new bytes.Reader(data, bytes.Endian.Big)
			fail "not a WOFF font" when data.len() < woffHeaderSize || (try r.read<uint32>()) != woffSignature

			try r.seek(24)
			let offset = int(try r.read<uint32>())
			let length = int(try r.read<uint32>())
			let original = int(try r.read<uint32>())
			return "" when length == 0
			fail "WOFF metadata runs past the end of the file" when offset + length > data.len()

			let xml = try zlib.decompress(data[offset:offset + length], original)
			fail "WOFF metadata does not decompress to its declared size" when xml.len() != original
			return string(xml)
		}

		// Rebuilds the sfnt font the WOFF file wraps.
		internal def unpack(data byte[]) !byte[] {
			let r = new bytes.Reader(data, bytes.Endian.Big)
			fail "not a WOFF font" when data.len() < woffHeaderSize || (try r.read<uint32>()) != woffSignature

			let flavor = try r.read<uint32>()
			let length = int(try r.read<uint32>())
			let numTables = int(try r.read<uint16>())
			fail "WOFF length field does not match the file" when length > data.len()
			try r.seek(woffHeaderSize)

			let tables opentype.TableData[]
			let indices int[]
			let tagBuf byte[]
			tagBuf.len(4)
			for let i = 0; i < numTables; i++ {
				try r.read(tagBuf)
				let tag = string(tagBuf)
				let offset = int(try r.read<uint32>())
				let compLength = int(try r.read<uint32>())
				let origLength = int(try r.read<uint32>())
				// origChecksum
				try r.skip(4)

				fail "WOFF table {tag} runs past the end of the file" when offset + compLength > length
				fail "WOFF table {tag} is larger compressed than decompressed" when compLength > origLength

				let raw = data[offset:offset + compLength]
				if compLength < origLength {
					raw = try zlib.decompress(raw, origLength)
					fail "WOFF table {tag} does not decompress to its declared size" when raw.len() != origLength
				}
				tables.push(opentype.TableData{tag: tag, data: raw})
				indices.push(i)
			}

			return opentype.assemble(tables, opentype.FontEntry[opentype.FontEntry{flavor:flavor, tables:indices}])
		}
	}

	internal const (
		woffSignature  = 0x774F4646
		woffHeaderSize = 44
	)
}
