partial module std.formats.fonts {
	use (
		std.io
		std.bytes
		std.data.compress.brotli
		std.formats.fonts.opentype
	)

	// WOFF2 is the Web Open Font Format 2.0 codec: an sfnt font or collection
	// whose tables are Brotli-compressed as one stream, with `glyf`/`loca` and
	// `hmtx` optionally stored in a compacter transformed form. Faces report
	// "woff2" as their format.
	@codec("WOFF2")
	type WOFF2 {
		mimeType string[] {
			def get() string[] {
				return string["font/woff2"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".woff2"]
			}
		}

		// The signature `wOF2`.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)

			let n = r.read(b) onerror recover 0
			return false when n != 4
			return b.equals(byte[byte('w'), byte('O'), byte('F'), byte('2')])
		}

		// open decompresses a WOFF2 font or collection from the reader. Fails when
		// the data is not WOFF2, does not decompress, or a transformed table or the
		// font inside is damaged.
		def open(reader io.Reader) !Font {
			return opentype.open(try opentype.unpackWoff2(try opentype.readAll(reader)), "woff2")
		}

		// info reads the first face's description from the reader. Fails like open.
		def info(reader io.Reader) !FontInfo {
			return opentype.info(try opentype.unpackWoff2(try opentype.readAll(reader)), "woff2")
		}

		// The extended metadata block: an XML document describing the font's
		// origin and licence, or an empty string when the file carries none.
		// Fails when the data is not WOFF2 or the block does not decompress.
		def metadata(reader io.Reader) !string {
			let data = try opentype.readAll(reader)
			let r = new bytes.Reader(data, bytes.Endian.Big)
			fail "not a WOFF2 font" when data.len() < 48 || (try r.read<uint32>()) != 0x774F4632

			try r.seek(28)
			let offset = int(try r.read<uint32>())
			let length = int(try r.read<uint32>())
			let original = int(try r.read<uint32>())
			return "" when length == 0
			fail "WOFF2 metadata runs past the end of the file" when offset + length > data.len()

			let xml = try brotli.decompress(data[offset:offset + length], original)
			fail "WOFF2 metadata does not decompress to its declared size" when xml.len() != original
			return string(xml)
		}
	}
}
