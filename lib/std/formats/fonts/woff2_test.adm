		@test()
		def signature() !none {
			let woff2 = new WOFF2()
			assert woff2.matchSignature(new bytes.Reader(transformed)) // wOF2
			assert !(woff2.matchSignature(new bytes.Reader(tinyTrueType))) // bare sfnt is not WOFF2
		}

		@test()
		def rebuildsTransformedTables() !none {
			let face = try (try load(transformed)).face(0)
			assert face.info().format == "woff2" // format tag
			let plain = try (try load(tinyTrueType)).face(0)
			assert (try renderFace(face)) == (try renderFace(plain)) // glyf, loca and hmtx rebuild exactly
			for let g = 0; g < 4; g++ {
				let id = GlyphID(g)
				assert (try face.metrics(id)).leftSideBearing == (try plain.metrics(id)).leftSideBearing // bearings come back from glyph boxes
			}
		}

		@test()
		def readsCFFFlavour() !none {
			let face = try (try load(postscript)).face(0)
			assert face.info().family == "Tiny Sans" // CFF-flavoured WOFF2
			assert (try renderFace(face)) == (try renderFace(try (try load(tinyOpenType)).face(0))) // matches the plain otf
		}

		@test()
		def readsCollections() !none {
			let font = try load(collection)
			assert font.faces() == 2 // both faces of the collection
			assert (try renderFace(try font.face(0))) == (try renderFace(try (try load(tinyTrueType)).face(0))) // TrueType face
			assert (try renderFace(try font.face(1))) == (try renderFace(try (try load(tinyOpenType)).face(0))) // CFF face
		}

		@test()
		def readsMetadata() !none {
			assert (try (new WOFF2()).metadata(new bytes.Reader(transformed))).contains("org.example.tiny") // Brotli-compressed metadata
			assert (try (new WOFF2()).metadata(new bytes.Reader(postscript))) == "" // no metadata block
		}

		@test()
		def opensThroughTheCodec() !none {
			assert (try (new WOFF2()).open(new bytes.Reader(collection))).faces() == 2 // WOFF2.open
		}

		@test()
		def rejectsDamagedFiles() !none {
			assert load(transformed[0:transformed.len() / 2]) is error // truncated stream
		}
	}
}
