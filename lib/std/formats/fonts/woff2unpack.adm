// WOFF2 unpacking: the table directory, the collection directory, and the
// reconstruction of transformed `glyf`/`loca` and `hmtx` tables into their
// plain sfnt form.

internal partial module std.formats.fonts.opentype {
	use (
		std.data.compress.brotli
	)

	// Tags a WOFF2 table directory can name with a 6-bit index.
	let woff2KnownTags = string[
		"cmap", "head", "hhea", "hmtx", "maxp", "name", "OS/2", "post", "cvt ", "fpgm", "glyf", "loca",
		"prep", "CFF ", "VORG", "EBDT", "EBLC", "gasp", "hdmx", "kern", "LTSH", "PCLT", "VDMX", "vhea",
		"vmtx", "BASE", "GDEF", "GPOS", "GSUB", "EBSC", "JSTF", "MATH", "CBDT", "CBLC", "COLR", "CPAL",
		"SVG ", "sbix", "acnt", "avar", "bdat", "bloc", "bsln", "cvar", "fdsc", "feat", "fmtx", "fvar",
		"gvar", "hsty", "just", "lcar", "mort", "morx", "opbd", "prop", "trak", "Zapf", "Silf", "Glat",
		"Gloc", "Feat", "Sill"
	]

	const (
		woff2Signature  = 0x774F4632
		woff2HeaderSize = 48
		collectionTag   = 0x74746366
	)

	// A big-endian read cursor over a byte array that fails instead of running
	// off the end.
	type Cursor {
		data byte[]
		pos  int

		def new(data byte[], pos int = 0) {
			self.data = data
			self.pos = pos
		}

		def need(n int) !none {
			expects {
				assert n >= 0 && pos + n <= data.len() onerror fail "WOFF2 data ends early"
			}
		}

		def u8() !int {
			try need(1)
			pos++
			return int(data[pos - 1])
		}

		def u16() !int {
			try need(2)
			pos += 2
			return (int(data[pos - 2]) << 8) | int(data[pos - 1])
		}

		def i16() !int {
			let v = try u16()
			return v >= 0x8000 ?? (v - 0x10000, v)
		}

		def u32() !int {
			try need(4)
			pos += 4
			return (int(data[pos - 4]) << 24) | (int(data[pos - 3]) << 16) | (int(data[pos - 2]) << 8) | int(data[pos - 1])
		}

		def take(n int) !byte[] {
			try need(n)
			pos += n
			return data[pos - n:pos]
		}

		// UIntBase128: seven bits per byte, most significant first, at most five
		// bytes, no leading zeros.
		def base128() !int {
			let v = 0
			for let i = 0; i < 5; i++ {
				let b = try u8()
				fail "WOFF2 number has a leading zero" when i == 0 && b == 0x80
				fail "WOFF2 number overflows" when (v & 0xFE000000) != 0
				v = (v << 7) | (b & 0x7F)
				return v when (b & 0x80) == 0
			}
			fail "WOFF2 number is too long"
		}

		// 255UInt16: one byte, or an escape code followed by one or two more.
		def u255() !int {
			let code = try u8()
			return try u16() when code == 253
			return (try u8()) + 253 when code == 255
			return (try u8()) + 506 when code == 254
			return code
		}
	}

	// One entry of the WOFF2 table directory.
	struct Woff2Table {
		tag         string
		transformed bool
		origLength  int
		// Bytes this table takes in the decompressed stream.
		length      int
		offset      int
	}

	// Rebuilds the sfnt font or collection a WOFF2 file wraps.
	// Fails when the data is not WOFF2, does not decompress, or a transformed
	// table is damaged.
	def unpackWoff2(data byte[]) !byte[] {
		let c = new Cursor(data)
		fail "not a WOFF2 font" when data.len() < woff2HeaderSize || (try c.u32()) != woff2Signature

		let flavor = try c.u32()
		let length = try c.u32()
		let numTables = try c.u16()
		// reserved
		try c.u16()
		// totalSfntSize
		try c.u32()
		let totalCompressedSize = try c.u32()
		fail "WOFF2 length field does not match the file" when length > data.len()
		c.pos = woff2HeaderSize

		let entries Woff2Table[]
		let streamSize = 0
		for let i = 0; i < numTables; i++ {
			let flags = try c.u8()
			let tag = ""
			if (flags & 0x3F) == 63 {
				tag = string(try c.take(4))
			} else {
				tag = woff2KnownTags[flags & 0x3F]
			}
			let version = (flags >> 6) & 3
			let origLength = try c.base128()

			// glyf and loca are transformed at version 0 and plain at 3; every
			// other table is the other way round.
			let transformed = (tag == "glyf" || tag == "loca") ?? (version == 0, version != 0)
			let size = origLength
			if transformed {
				size = try c.base128()
				fail "WOFF2 transforms {tag}, which has no defined transform" when tag != "glyf" && tag != "loca" && tag != "hmtx"
			}
			entries.push(Woff2Table{tag: tag, transformed: transformed, origLength: origLength, length: size, offset: streamSize})
			streamSize += size
		}

		let fontEntries FontEntry[]
		if flavor == collectionTag {
			// ttcVersion
			try c.u32()
			let numFonts = try c.u255()
			for let f = 0; f < numFonts; f++ {
				let count = try c.u255()
				let fontFlavor = try c.u32()
				let indices int[]
				for let k = 0; k < count; k++ {
					let index = try c.u255()
					fail "WOFF2 collection names a missing table" when index >= numTables
					indices.push(index)
				}
				fontEntries.push(FontEntry{flavor: uint32(fontFlavor), tables: indices})
			}
		} else {
			let indices int[]
			for let k = 0; k < numTables; k++ {
				indices.push(k)
			}
			fontEntries.push(FontEntry{flavor: uint32(flavor), tables: indices})
		}

		fail "WOFF2 compressed data runs past the end of the file" when c.pos + totalCompressedSize > data.len()
		let stream = try brotli.decompress(data[c.pos:c.pos + totalCompressedSize], streamSize)
		fail "WOFF2 tables do not decompress to their declared size" when stream.len() != streamSize

		let tables TableData[]
		for let (_, e) in entries {
			tables.push(TableData{tag: e.tag, data: stream[e.offset:e.offset + e.length]})
		}

		for let (_, font) in fontEntries {
			try reconstructFont(entries, tables, font)
		}
		return assemble(tables, fontEntries)
	}

	// Replaces one font's transformed tables with their plain forms. Tables
	// already rebuilt for an earlier font of a collection are left alone.
	internal def reconstructFont(entries Woff2Table[], tables TableData[], font FontEntry) !none {
		let glyfIndex = -1
		let locaIndex = -1
		let hmtxIndex = -1
		let headIndex = -1
		let hheaIndex = -1
		for let (_, i) in font.tables {
			let tag = entries[i].tag
			glyfIndex = i when tag == "glyf"
			locaIndex = i when tag == "loca"
			hmtxIndex = i when tag == "hmtx"
			headIndex = i when tag == "head"
			hheaIndex = i when tag == "hhea"
		}

		let xMins int[]
		if glyfIndex >= 0 && entries[glyfIndex].transformed {
			fail "WOFF2 font has a transformed glyf but no loca" when locaIndex < 0
			fail "WOFF2 font has a transformed glyf but no head" when headIndex < 0
			let rebuilt = try rebuildGlyf(tables[glyfIndex].data)
			tables[glyfIndex] = TableData{tag: "glyf", data: rebuilt.glyf}
			tables[locaIndex] = TableData{tag: "loca", data: rebuilt.loca}
			entries[glyfIndex].transformed = false
			entries[locaIndex].transformed = false
			let sameFormat = rebuilt.longOffsets == (tables[headIndex].data.len() > 51 && tables[headIndex].data[51] != 0)
			fail "WOFF2 loca does not match its declared size" when sameFormat && rebuilt.loca.len() != entries[locaIndex].origLength

			// Record the loca format the rebuilt table uses.
			let head = tables[headIndex].data.clone()
			fail "WOFF2 head table is too short" when head.len() < 54
			head[50] = 0
			head[51] = byte(rebuilt.longOffsets ?? (1, 0))
			tables[headIndex] = TableData{tag: "head", data: head}
			xMins = rebuilt.xMins
		} else if locaIndex >= 0 && entries[locaIndex].transformed {
			fail "WOFF2 transforms loca without glyf"
		}

		if hmtxIndex >= 0 && entries[hmtxIndex].transformed {
			fail "WOFF2 font has a transformed hmtx but no hhea" when hheaIndex < 0
			xMins = try glyphXMins(tables[glyfIndex].data, tables[locaIndex].data, tables[headIndex].data) when xMins.len() == 0 && glyfIndex >= 0
			let hhea = new Cursor(tables[hheaIndex].data, 34)
			let numHMetrics = try hhea.u16()
			tables[hmtxIndex] = TableData{tag: "hmtx", data: try rebuildHmtx(tables[hmtxIndex].data, numHMetrics, xMins)}
			entries[hmtxIndex].transformed = false
		}
	}

	// A rebuilt `glyf`/`loca` pair plus each glyph's xMin, which a transformed
	// `hmtx` falls back on for its bearings.
	struct RebuiltGlyf {
		glyf        byte[]
		loca        byte[]
		longOffsets bool
		xMins       int[]
	}

	// Composite glyph flags that decide a component's length.
	const (
		argsAreWords     = 0x0001
		haveScale        = 0x0008
		moreComponents   = 0x0020
		haveXYScale      = 0x0040
		haveTwoByTwo     = 0x0080
		haveInstructions = 0x0100
	)

	// Simple glyph flag bits written back out.
	const (
		outOnCurve = 0x01
		outXShort  = 0x02
		outYShort  = 0x04
		outXSame   = 0x10
		outYSame   = 0x20
		outOverlap = 0x40
	)

	// Rebuilds `glyf` and `loca` from the transformed `glyf` stream.
	// Fails when a stream is truncated or inconsistent.
	def rebuildGlyf(src byte[]) !RebuiltGlyf {
		let h = new Cursor(src)
		// reserved
		try h.u16()
		let optionFlags = try h.u16()
		let numGlyphs = try h.u16()
		let indexFormat = try h.u16()
		let sizes int[]
		for let i = 0; i < 7; i++ {
			sizes.push(try h.u32())
		}

		let at = h.pos
		let streams Cursor[]
		for let i = 0; i < 7; i++ {
			fail "WOFF2 glyf stream runs past the table" when at + sizes[i] > src.len()
			streams.push(new Cursor(src[at:at + sizes[i]]))
			at += sizes[i]
		}
		let nContours = streams[0]
		let nPoints = streams[1]
		let flagStream = streams[2]
		let glyphs = streams[3]
		let composites = streams[4]
		let bboxes = streams[5]
		let instructions = streams[6]

		let overlap byte[]
		if (optionFlags & 1) != 0 {
			let n = (numGlyphs + 7) >> 3
			fail "WOFF2 overlap bitmap runs past the table" when at + n > src.len()
			overlap = src[at:at + n]
		}

		// The bbox stream opens with one bit per glyph saying whether its box is
		// stored explicitly.
		let bitmapSize = ((numGlyphs + 31) >> 5) << 2
		let bboxBitmap = try bboxes.take(bitmapSize)

		let out = new Writer()
		let offsets int[]
		let xMins int[]
		xMins.len(numGlyphs)
		xMins[:] = 0

		let xs int[]
		let ys int[]
		let onCurve bool[]
		let endPts int[]

		for let g = 0; g < numGlyphs; g++ {
			offsets.push(out.len())
			let contours = try nContours.i16()
			let explicitBox = (int(bboxBitmap[g >> 3]) & (0x80 >> (g & 7))) != 0

			if contours == 0 {
				fail "WOFF2 empty glyph {g} has a bounding box" when explicitBox
				continue
			}

			if contours < 0 {
				fail "WOFF2 composite glyph {g} has no bounding box" unless explicitBox
				out.i16(-1)
				let xMin = try bboxes.i16()
				xMins[g] = xMin
				out.i16(xMin)
				out.i16(try bboxes.i16())
				out.i16(try bboxes.i16())
				out.i16(try bboxes.i16())

				let start = composites.pos
				let hasInstructions = false
				for {
					let flags = try composites.u16()
					// glyph index
					let skip = 2
					skip += (flags & argsAreWords) != 0 ?? (4, 2)
					if (flags & haveScale) != 0 {
						skip += 2
					} else if (flags & haveXYScale) != 0 {
						skip += 4
					} else if (flags & haveTwoByTwo) != 0 {
						skip += 8
					}
					try composites.take(skip)
					hasInstructions = true when (flags & haveInstructions) != 0
					break when (flags & moreComponents) == 0
				}
				out.bytes(composites.data[start:composites.pos])

				if hasInstructions {
					let n = try glyphs.u255()
					out.u16(n)
					out.bytes(try instructions.take(n))
				}
				out.pad(indexFormat == 0 ?? (2, 4))
				continue
			}

			// A simple glyph: points per contour, then one flag and one triplet
			// per point.
			endPts.len(0)
			let total = 0
			for let k = 0; k < contours; k++ {
				total += try nPoints.u255()
				endPts.push(total - 1)
			}
			xs.len(total)
			ys.len(total)
			onCurve.len(total)

			let x = 0
			let y = 0
			for let p = 0; p < total; p++ {
				let flag = try flagStream.u8()
				onCurve[p] = (flag & 0x80) == 0
				let (dx, dy) = try decodeTriplet(flag & 0x7F, glyphs)
				x += dx
				y += dy
				xs[p] = x
				ys[p] = y
			}

			let box int[]
			if explicitBox {
				for let k = 0; k < 4; k++ {
					box.push(try bboxes.i16())
				}
			}
			let n = try glyphs.u255()
			let overlapping = overlap.len() > 0 && (int(overlap[g >> 3]) & (0x80 >> (g & 7))) != 0
			xMins[g] = writeSimpleGlyph(out, endPts, xs, ys, onCurve, box, try instructions.take(n), overlapping)
			out.pad(indexFormat == 0 ?? (2, 4))
		}
		offsets.push(out.len())

		return finishGlyf(out, offsets, indexFormat, xMins)
	}

	// Builds `loca` for a rebuilt `glyf` in the format `indexFormat` asks for.
	// Short offsets store half the byte offset in 16 bits, so a table too large
	// for that switches to long offsets.
	def finishGlyf(out Writer, offsets int[], indexFormat int, xMins int[]) RebuiltGlyf {
		let longOffsets = indexFormat != 0 || out.len() > 0x1FFFE
		let loca = new Writer()
		for let (_, o) in offsets {
			if longOffsets {
				loca.u32(o)
			} else {
				loca.u16(o >> 1)
			}
		}
		return RebuiltGlyf{glyf: out.data, loca: loca.data, longOffsets: longOffsets, xMins: xMins}
	}

	// Writes a simple glyph record with compact flags and coordinates. `box`
	// holds xMin, yMin, xMax and yMax, or is empty to compute them from the
	// points. Returns xMin.
	def writeSimpleGlyph(out Writer, endPts int[], xs int[], ys int[], onCurve bool[], box int[], instructions byte[], overlapping bool) int {
		let total = xs.len()
		let xMin = 0
		let yMin = 0
		let xMax = 0
		let yMax = 0
		if box.len() == 4 {
			xMin = box[0]
			yMin = box[1]
			xMax = box[2]
			yMax = box[3]
		} else if total > 0 {
			xMin = xs[0]
			xMax = xs[0]
			yMin = ys[0]
			yMax = ys[0]
			for let p = 1; p < total; p++ {
				xMin = xs[p] when xs[p] < xMin
				xMax = xs[p] when xs[p] > xMax
				yMin = ys[p] when ys[p] < yMin
				yMax = ys[p] when ys[p] > yMax
			}
		}

		out.i16(endPts.len())
		out.i16(xMin)
		out.i16(yMin)
		out.i16(xMax)
		out.i16(yMax)
		for let (_, e) in endPts {
			out.u16(e)
		}
		out.u16(instructions.len())
		out.bytes(instructions)
		let px = 0
		let py = 0
		for let p = 0; p < total; p++ {
			let f = onCurve[p] ?? (outOnCurve, 0)
			f |= outOverlap when p == 0 && overlapping
			let dx = xs[p] - px
			let dy = ys[p] - py
			if dx == 0 {
				f |= outXSame
			} else if dx > -256 && dx < 256 {
				f |= outXShort
				f |= outXSame when dx > 0
			}
			if dy == 0 {
				f |= outYSame
			} else if dy > -256 && dy < 256 {
				f |= outYShort
				f |= outYSame when dy > 0
			}
			out.u8(f)
			px = xs[p]
			py = ys[p]
		}
		px = 0
		for let p = 0; p < total; p++ {
			let dx = xs[p] - px
			if dx != 0 {
				if dx > -256 && dx < 256 {
					out.u8(dx < 0 ?? (-dx, dx))
				} else {
					out.i16(dx)
				}
			}
			px = xs[p]
		}
		py = 0
		for let p = 0; p < total; p++ {
			let dy = ys[p] - py
			if dy != 0 {
				if dy > -256 && dy < 256 {
					out.u8(dy < 0 ?? (-dy, dy))
				} else {
					out.i16(dy)
				}
			}
			py = ys[p]
		}
		return xMin
	}

	// Decodes one point's coordinate deltas from its flag and the glyph stream.
	def decodeTriplet(flag int, s Cursor) !(int, int) {
		if flag < 10 {
			let b = try s.u8()
			return (0, withSign(flag, ((flag & 14) << 7) + b))
		}
		if flag < 20 {
			let b = try s.u8()
			return (withSign(flag, (((flag - 10) & 14) << 7) + b), 0)
		}
		if flag < 84 {
			let b0 = flag - 20
			let b1 = try s.u8()
			return (withSign(flag, 1 + (b0 & 0x30) + (b1 >> 4)), withSign(flag >> 1, 1 + ((b0 & 0x0C) << 2) + (b1 & 0x0F)))
		}
		if flag < 120 {
			let b0 = flag - 84
			let b1 = try s.u8()
			let b2 = try s.u8()
			return (withSign(flag, 1 + ((b0 / 12) << 8) + b1), withSign(flag >> 1, 1 + (((b0 % 12) >> 2) << 8) + b2))
		}
		if flag < 124 {
			let b1 = try s.u8()
			let b2 = try s.u8()
			let b3 = try s.u8()
			return (withSign(flag, (b1 << 4) + (b2 >> 4)), withSign(flag >> 1, ((b2 & 0x0F) << 8) + b3))
		}
		let b1 = try s.u8()
		let b2 = try s.u8()
		let b3 = try s.u8()
		let b4 = try s.u8()
		return (withSign(flag, (b1 << 8) + b2), withSign(flag >> 1, (b3 << 8) + b4))
	}

	def withSign(flag int, v int) int {
		return (flag & 1) != 0 ?? (v, -v)
	}

	// Rebuilds `hmtx`: advances are always stored, bearings may be left out and
	// then equal each glyph's xMin.
	// Fails when the transformed table is truncated.
	def rebuildHmtx(src byte[], numHMetrics int, xMins int[]) !byte[] {
		let c = new Cursor(src)
		let flags = try c.u8()
		let numGlyphs = xMins.len()
		fail "WOFF2 hmtx has more metrics than glyphs" when numHMetrics > numGlyphs || numHMetrics == 0

		let advances int[]
		for let i = 0; i < numHMetrics; i++ {
			advances.push(try c.u16())
		}
		let bearings int[]
		for let i = 0; i < numGlyphs; i++ {
			// Bit 0 drops the bearings of the glyphs with their own advance,
			// bit 1 those of the glyphs repeating the last one.
			let implied = i < numHMetrics ?? ((flags & 1) != 0, (flags & 2) != 0)
			if implied {
				bearings.push(xMins[i])
			} else {
				bearings.push(try c.i16())
			}
		}

		let out = new Writer()
		for let i = 0; i < numGlyphs; i++ {
			out.u16(advances[i]) when i < numHMetrics
			out.i16(bearings[i])
		}
		return out.data
	}

	// Each glyph's xMin, read from a plain `glyf`, for an `hmtx` transform in a
	// font whose `glyf` is stored untransformed.
	// Fails when the tables are inconsistent.
	def glyphXMins(glyf byte[], loca byte[], head byte[]) !int[] {
		let longOffsets = head.len() > 51 && head[51] != 0
		let entries = longOffsets ?? (loca.len() / 4, loca.len() / 2)
		let c = new Cursor(loca)
		let offsets int[]
		for let i = 0; i < entries; i++ {
			if longOffsets {
				offsets.push(try c.u32())
			} else {
				offsets.push((try c.u16()) * 2)
			}
		}
		let out int[]
		for let g = 0; g + 1 < offsets.len(); g++ {
			if offsets[g + 1] <= offsets[g] {
				out.push(0)
				continue
			}
			let at = new Cursor(glyf, offsets[g] + 2)
			out.push(try at.i16())
		}
		return out
	}

	// An append-only big-endian byte writer.
	type Writer {
		data byte[]

		def new() {}

		def len() int {
			return data.len()
		}

		def u8(v int) {
			data.push(byte(v & 0xFF))
		}

		def u16(v int) {
			data.push(byte((v >> 8) & 0xFF))
			data.push(byte(v & 0xFF))
		}

		def i16(v int) {
			u16(v & 0xFFFF)
		}

		def u32(v int) {
			data.push(byte((v >> 24) & 0xFF))
			data.push(byte((v >> 16) & 0xFF))
			data.push(byte((v >> 8) & 0xFF))
			data.push(byte(v & 0xFF))
		}

		def bytes(b byte[]) {
			let at = data.len()
			data.len(at + b.len())
			b.copy(data[at:])
		}

		// Zero-fills up to the next multiple of `align`.
		def pad(align int) {
			for data.len() % align != 0 {
				data.push(0)
			}
		}
	}
}
