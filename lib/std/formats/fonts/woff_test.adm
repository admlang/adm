partial module std.formats.fonts {
	use (
		std.bytes
		std.testing
	)

	check "WOFF codec" {
		// tinyTrueType as WOFF 1.0, with an extended metadata block.
		let packed = byte[
			119, 79, 70, 70, 0, 1, 0, 0, 0, 0, 2, 251, 0, 10, 0, 0, 0, 0, 2, 240, 0, 1, 0, 0, 0,
			0, 2, 156, 0, 0, 0, 95, 0, 0, 0, 106, 0, 0, 0, 0, 0, 0, 0, 0, 79, 83, 47, 50, 0, 0,
			1, 100, 0, 0, 0, 52, 0, 0, 0, 96, 71, 188, 69, 133, 99, 109, 97, 112, 0, 0, 1, 168,
			0, 0, 0, 55, 0, 0, 0, 68, 0, 85, 0, 249, 103, 108, 121, 102, 0, 0, 1, 236, 0, 0, 0,
			50, 0, 0, 0, 50, 142, 235, 114, 211, 104, 101, 97, 100, 0, 0, 0, 244, 0, 0, 0, 54, 0,
			0, 0, 54, 46, 160, 248, 249, 104, 104, 101, 97, 0, 0, 1, 44, 0, 0, 0, 32, 0, 0, 0,
			36, 4, 238, 1, 59, 104, 109, 116, 120, 0, 0, 1, 152, 0, 0, 0, 16, 0, 0, 0, 16, 6, 24,
			0, 60, 108, 111, 99, 97, 0, 0, 1, 224, 0, 0, 0, 10, 0, 0, 0, 10, 0, 25, 0, 12, 109,
			97, 120, 112, 0, 0, 1, 76, 0, 0, 0, 24, 0, 0, 0, 32, 0, 6, 0, 7, 110, 97, 109, 101,
			0, 0, 2, 32, 0, 0, 0, 111, 0, 0, 0, 180, 11, 203, 116, 220, 112, 111, 115, 116, 0, 0,
			2, 144, 0, 0, 0, 12, 0, 0, 0, 32, 0, 3, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 108, 118, 73,
			253, 95, 15, 60, 245, 0, 3, 3, 232, 0, 0, 0, 0, 230, 223, 90, 161, 0, 0, 0, 0, 230,
			223, 91, 132, 0, 10, 0, 0, 1, 194, 1, 244, 0, 0, 0, 3, 0, 2, 0, 0, 0, 0, 0, 0, 120,
			156, 99, 96, 100, 96, 96, 86, 248, 111, 193, 192, 192, 248, 133, 129, 139, 129, 139,
			241, 16, 3, 35, 3, 42, 96, 1, 0, 80, 246, 3, 45, 120, 156, 99, 96, 100, 96, 96, 96,
			97, 96, 101, 0, 209, 12, 12, 76, 12, 104, 0, 0, 1, 97, 0, 14, 120, 156, 99, 96, 102,
			108, 99, 156, 192, 192, 202, 192, 194, 64, 24, 48, 34, 115, 236, 237, 237, 237, 25,
			24, 24, 20, 24, 242, 153, 21, 254, 91, 48, 48, 48, 43, 48, 156, 128, 43, 252, 194,
			180, 7, 44, 199, 0, 0, 224, 192, 6, 201, 1, 244, 0, 0, 0, 250, 0, 0, 1, 54, 0, 10, 1,
			244, 0, 50, 120, 156, 99, 96, 96, 96, 98, 96, 96, 96, 102, 96, 96, 16, 97, 96, 102,
			96, 4, 211, 44, 12, 6, 12, 12, 12, 28, 12, 28, 96, 57, 5, 6, 71, 134, 252, 255, 255,
			17, 172, 255, 15, 255, 31, 252, 63, 5, 172, 22, 12, 0, 224, 118, 11, 72, 0, 0, 0, 0,
			0, 0, 0, 0, 12, 0, 25, 0, 0, 0, 1, 0, 10, 0, 0, 1, 44, 1, 244, 0, 2, 0, 0, 51, 33, 3,
			10, 1, 34, 145, 1, 244, 0, 0, 1, 0, 50, 0, 250, 1, 194, 1, 244, 0, 4, 0, 0, 55, 52,
			51, 50, 21, 50, 200, 200, 250, 250, 250, 0, 0, 0, 120, 156, 85, 138, 61, 10, 128, 32,
			0, 133, 63, 43, 140, 26, 130, 160, 3, 132, 123, 107, 39, 104, 110, 168, 46, 208, 160,
			34, 132, 131, 208, 208, 237, 67, 17, 162, 55, 60, 190, 247, 3, 72, 86, 4, 81, 130,
			54, 121, 84, 65, 77, 155, 89, 210, 211, 83, 34, 170, 6, 193, 128, 202, 92, 208, 49,
			103, 150, 40, 150, 195, 249, 103, 220, 117, 112, 102, 211, 246, 190, 206, 16, 139,
			148, 167, 92, 112, 224, 240, 60, 140, 236, 104, 2, 14, 195, 134, 198, 114, 115, 113,
			242, 61, 190, 125, 250, 63, 94, 1, 213, 28, 16, 0, 120, 156, 99, 96, 102, 192, 11, 0,
			0, 125, 0, 4, 120, 156, 85, 203, 59, 14, 128, 32, 12, 0, 208, 171, 144, 238, 162,
			110, 14, 5, 54, 79, 160, 7, 32, 210, 144, 38, 82, 252, 160, 193, 219, 59, 57, 184,
			191, 135, 174, 166, 85, 221, 116, 156, 156, 197, 64, 175, 59, 80, 36, 75, 14, 44,
			209, 192, 60, 141, 205, 0, 206, 98, 162, 226, 131, 47, 254, 47, 45, 94, 194, 251, 69,
			28, 20, 7, 3, 249, 136, 154, 170, 79, 219, 74, 186, 176, 60, 208, 90, 108, 191, 105,
			95, 67, 157, 35, 102
		]

		@test()
		def signature() !none {
			let woff = new WOFF()
			assert woff.matchSignature(new bytes.Reader(packed)) // wOFF
			assert !(woff.matchSignature(new bytes.Reader(tinyTrueType))) // bare sfnt is not WOFF
		}

		@test()
		def unpacksTheFont() !none {
			let face = try (try load(packed)).face(0)
			assert face.info().format == "woff" // format tag
			assert face.info().family == "Tiny Serif" // names survive decompression
			let plain = try (try load(tinyTrueType)).face(0)
			assert (try renderFace(face)) == (try renderFace(plain)) // every glyph matches the uncompressed font
			assert (try info(packed)).family == "Tiny Serif" // header-only read
		}

		@test()
		def readsMetadata() !none {
			let xml = try (new WOFF()).metadata(new bytes.Reader(packed))
			assert xml.startsWith("<?xml") // the metadata block inflates to XML
			assert xml.contains("org.example.tiny") // with the font's unique id
			assert (try (new WOFF()).metadata(new bytes.Reader(packed))) == xml // reading twice gives the same text
		}

		@test()
		def opensThroughTheCodec() !none {
			assert (try (try (new WOFF()).open(new bytes.Reader(packed))).face(0)).info().format == "woff" // WOFF.open
		}

		@test()
		def rejectsDamagedFiles() !none {
			// The header says how long the file is.
			assert load(packed[0:100]) is error // truncated
			let broken = packed.clone()
			// Point the first table past the end of the file.
			broken[48] = 0x7F
			assert load(broken) is error // a table outside the file
		}
	}
}
