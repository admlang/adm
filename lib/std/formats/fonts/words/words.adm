// Whether a face shapes text the same a word at a time as whole, for std's
// text engines (the canvas's paragraphs shape their words through the text
// cache when it does). Kept per face: finding out reads its layout tables.
internal std module std.formats.fonts.words {
	use (
		std.formats.fonts::Face
		std.formats.fonts.layout
	)

	// Whether text set with `face` and cut after its spaces (U+0020) shapes,
	// piece by piece, to what it shapes to whole: no rule of the face's layout
	// tables reaches its space glyph (`layout.spacesStandApart`).
	def apart(face Face) bool {
		return known.of(face)
	}

	// The faces asked about and what they answered.
	internal type Answers {
		faces   Face[]
		answers bool[]

		atomic def of(face Face) bool {
			for let (i, f) in faces {
				return answers[i] when f == face
			}
			let answer = layout.spacesStandApart(new layout.ShapeFont(face))
			// A program sets text in a handful of faces; past that many the
			// oldest are asked again when they come back.
			if faces.len() >= 64 {
				faces = faces[32:].clone()
				answers = answers[32:].clone()
			}
			faces.push(face)
			answers.push(answer)
			return answer
		}
	}

	let known = new Answers()
}
