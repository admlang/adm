partial module std.formats {
	use std.io

	// FormatInfo describes a file format: its MIME types and file extensions.
	datatype FormatInfo {
		// List of supported mimeTypes
		mimeType  string[]
		// List of supported file extensions
		extension string[]
	}

	// Signature matcher are able to detect the file format based on the
	// file signature
	interface SignatureMatcher {
		// Check if the given bytes data start with the file signature
		def matchSignature(r io.Reader) bool
	}

	// FileFormat is what a codec registers: its format description and a
	// signature matcher.
	type FileFormat = FormatInfo & SignatureMatcher
}
