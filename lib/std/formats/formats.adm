partial module std.formats {
	use std.io

	// FormatInfo describes a file format: its MIME types and file extensions.
	datatype FormatInfo {
		// List of supported mimeTypes
		mimeType  string[]
		// List of supported file extensions
		extension string[]
	}

	// Signature matcher are able to detect the file format based on the
	// file signature
	interface SignatureMatcher {
		// Check if the given bytes data start with the file signature
		def matchSignature(r io.Reader) bool
	}

	// ExtensionAware is a codec whose format has a variant per file extension
	// (Netpbm's bitmap, greymap, pixmap, arbitrary map and float map): the
	// registry tells it the extension a file is written as, lower case with
	// its dot, before the encoder runs.
	interface ExtensionAware {
		def forExtension(extension string)
	}

	// SupportedFormat is a file format a family of codecs reads or writes, as the family's
	// `supportedFormats()` lists it: `image.supportedFormats()`, `audio.supportedFormats()`.
	struct SupportedFormat {
		// Its readable name.
		name       string
		// Its file extensions, lower case with the leading dot.
		extensions string[]
		// Its media types.
		mimeTypes  string[]
	}

	// FileFormat is what a codec registers: its format description and a
	// signature matcher.
	type FileFormat = FormatInfo & SignatureMatcher
}
