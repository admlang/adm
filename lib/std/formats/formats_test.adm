partial module std.formats {
	use (
		std.formats.ai
		std.formats.archive
		std.formats.audio
		std.formats.calendar
		std.formats.contacts
		std.formats.data
		std.formats.docs
		std.formats.fonts
		std.formats.image
		std.formats.mail
		std.formats.models
		std.formats.playlist
		std.formats.sheets
		std.formats.slides
		std.formats.translations
		std.formats.video
		std.testing
	)

	check "Supported formats" {
		// Each format is named, in order of name, with extensions as promised, and `extension`
		// is among them under the format named `name`.
		def lists(found SupportedFormat[], name string, extension string) bool {
			let hit = false
			for let (i, format) in found {
				assert format.name != ""
				assert i == 0 || found[i - 1].name < format.name
				for let (_, ext) in format.extensions {
					assert ext.startsWith(".") && ext == ext.lower()
				}
				hit = true when format.name == name && format.extensions.includes(extension)
			}
			return hit
		}

		@test()
		def TestEveryFamilyAnswers() {
			assert lists(image.supportedFormats(), "Portable Network Graphics", ".png")
			assert lists(audio.supportedFormats(), "FLAC", ".flac")
			assert lists(archive.supportedFormats(), "ZIP", ".zip")
			assert lists(docs.supportedFormats(), "Markdown", ".md")
			assert lists(sheets.supportedFormats(), "Office Open XML Workbook", ".xlsx")
			assert lists(fonts.supportedFormats(), "WOFF2", ".woff2")
			assert lists(calendar.supportedFormats(), "xCal", ".xcs")
			assert lists(contacts.supportedFormats(), "vCard", ".vcf")
			assert lists(data.supportedFormats(), "INI", ".ini")
			assert lists(mail.supportedFormats(), "Internet Message", ".eml")
			for let found in [video.supportedFormats(), models.supportedFormats(), playlist.supportedFormats(), translations.supportedFormats(), ai.supportedFormats()] {
				assert found.len() > 0
				lists(found, "", "")
			}
			assert slides.supportedFormats().len() == 0
		}

		// The formats the picture viewer once listed by hand and lost.
		@test()
		def TestImageExtensions() {
			let all string[]
			for let (_, format) in image.supportedFormats() {
				all.push(...format.extensions)
			}
			assert all.includes(".jfif") && all.includes(".pcx") && all.includes(".jpg")
		}

		// What it hands out is its own: changing a list changes nothing here.
		@test()
		def TestListsAreCopies() {
			let first = image.supportedFormats()
			first[0].extensions.push(".nope")
			first.len(0)
			let again = image.supportedFormats()
			assert again.len() > 0 && !again[0].extensions.includes(".nope")
		}
	}
}
