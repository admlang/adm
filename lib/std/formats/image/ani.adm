partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.formats.image.ani::*
		std.formats.image.ico::*
	)

	// ANI is the Windows animated cursor codec: a RIFF file of cursor (or
	// icon) frames, each shown for a number of jiffies (1/60 s), played in
	// an optional step order.
	//
	// `decode` returns the first step and fills `frames`, one per step with
	// the largest entry of that step's cursor, so a frame the sequence
	// repeats appears each time it plays. `encode(writer)` writes `frames`
	// back, storing each distinct picture once.
	@codec("Animated cursor")
	type ANI {
		// The steps in play order, each the full cursor image and how long it
		// shows. Lengths are stored in whole jiffies, at least one.
		frames    ImageFrame[]
		// Always 0: an animated cursor loops for as long as it is shown.
		loopCount int          = 0
		// The click point, in pixels from the top-left corner. Decoding reads
		// it from the first frame's cursor; encoding gives it to every frame.
		hotspotX  int
		// The click point's row.
		hotspotY  int
		// The animation's name, from the INFO list; empty when it has none.
		title     string
		// Who made it, from the INFO list; empty when it has none.
		artist    string

		mimeType string[] {
			def get() string[] {
				return string["application/x-navi-animation"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ani"]
			}
		}

		// matchSignature reports whether the reader starts with a RIFF ACON
		// header.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(12)
			let n = r.read(b) onerror recover 0
			return false when n != 12
			return aniTag(b, 0, "RIFF") && aniTag(b, 8, "ACON")
		}

		// info reads the size of the first frame from the bytes. Fails when
		// they are not an animated cursor.
		def info(data byte[]) !ImageInfo {
			let (icons, _, _) = try parse(data, false)
			let s = new IconSet()
			try s.load(icons[0])
			return s.info()
		}

		// info reads the size of the first frame from the reader. Fails when
		// the data is not an animated cursor, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads an animated cursor from the bytes, fills `frames`,
		// `hotspotX`, `hotspotY`, `title` and `artist`, and returns the first
		// frame's image. Fails when the bytes are not an animated cursor, or
		// a frame cannot be decoded.
		def decode(data byte[]) !Image {
			let (icons, steps, rates) = try parse(data, true)
			let images Image[]
			for let (i, icon) in icons {
				let s = new IconSet()
				try s.load(icon)
				let best = s.best()
				if i == 0 {
					hotspotX = s.slots[best].entry.hotspotX
					hotspotY = s.slots[best].entry.hotspotY
				}
				images.push(try s.render(best))
			}
			let out ImageFrame[]
			for let (i, step) in steps {
				fail "ani: step {i} names frame {step} of {icons.len()}" when step < 0 || step >= icons.len()
				let f = new ImageFrame()
				f.image = images[step].copy()
				f.length = aniDuration(rates[i])
				out.push(f)
			}
			frames = out
			loopCount = 0
			return frames[0].image
		}

		// decode reads an animated cursor from the reader; see
		// `decode(data)`. Fails when the data is not an animated cursor, or
		// the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// Walks the RIFF chunks: returns each stored icon's bytes and, when
		// `full`, the frame each step shows and its jiffies.
		internal def parse(data byte[], full bool) !(byte[][], int[], int[]) {
			expects {
				assert data.len() >= 12 && aniTag(data, 0, "RIFF") && aniTag(data, 8, "ACON") onerror fail "ani: not a RIFF ACON file"
			}
			let end = (8 + icoU32(data, 4)).min(data.len())
			let frameCount = 0
			let stepCount = 0
			let rate = 0
			let flags = 0
			let sawHeader = false
			let seq int[]
			let rateList int[]
			let icons byte[][]
			if full {
				title = ""
				artist = ""
			}
			let pos = 12
			for pos + 8 <= end {
				let size = icoU32(data, pos + 4)
				let body = pos + 8
				fail "ani: truncated chunk" when body + size > end
				if aniTag(data, pos, "anih") {
					fail "ani: short anih chunk" when size < 36
					frameCount = icoU32(data, body + 4)
					stepCount = icoU32(data, body + 8)
					rate = icoU32(data, body + 28)
					flags = icoU32(data, body + 32)
					sawHeader = true
				} else if aniTag(data, pos, "rate") {
					for let i = 0; i + 4 <= size; i += 4 {
						rateList.push(icoU32(data, body + i))
					}
				} else if aniTag(data, pos, "seq ") {
					for let i = 0; i + 4 <= size; i += 4 {
						seq.push(icoU32(data, body + i))
					}
				} else if aniTag(data, pos, "LIST") && size >= 4 {
					let listEnd = body + size
					let isFrames = aniTag(data, body, "fram")
					let isInfo = aniTag(data, body, "INFO")
					let sub = body + 4
					for sub + 8 <= listEnd {
						let subSize = icoU32(data, sub + 4)
						let subBody = sub + 8
						fail "ani: truncated chunk" when subBody + subSize > listEnd
						if isFrames && aniTag(data, sub, "icon") {
							icons.push(data[subBody:subBody + subSize])
						} else if isInfo && full {
							let text = subSize
							for let i = 0; i < subSize; i++ {
								if data[subBody + i] == byte(0) {
									text = i
									break
								}
							}
							let value = string(data[subBody:subBody + text])
							title = value when aniTag(data, sub, "INAM")
							artist = value when aniTag(data, sub, "IART")
						}
						sub = subBody + subSize + subSize % 2
					}
				}
				pos = body + size + size % 2
			}
			fail "ani: missing anih chunk" unless sawHeader
			fail "ani: frames are raw bitmaps, not icons" when flags & 1 == 0
			fail "ani: no frames" when icons.len() == 0
			let steps int[]
			let rates int[]
			return (icons, steps, rates) unless full

			stepCount = frameCount when stepCount == 0
			stepCount = icons.len() when stepCount == 0
			for let i = 0; i < stepCount; i++ {
				let step = i
				step = seq[i] when flags & 2 != 0 && i < seq.len()
				steps.push(step)
				let jiffies = rate
				jiffies = rateList[i] when i < rateList.len()
				rates.push(jiffies)
			}
			return (icons, steps, rates)
		}

		// encode writes `frames` as an animated cursor, each distinct image
		// stored once as a one-entry cursor with the hotspot. Frames larger
		// than 256 x 256 are scaled down to fit. Fails when there are no
		// frames, or the writer fails.
		def encode(writer io.Writer) !none {
			fail "ani: no frames to encode" when frames.len() == 0
			let unique Image[]
			let steps int[]
			let rates int[]
			for let (_, f) in frames {
				let at = -1
				for let (j, u) in unique {
					if u.size().width == f.image.size().width && u.size().height == f.image.size().height && u.raw().equals(f.image.raw()) {
						at = j
						break
					}
				}
				if at < 0 {
					at = unique.len()
					unique.push(f.image)
				}
				steps.push(at)
				rates.push(aniJiffies(f.length))
			}
			let sameRate = true
			for let (_, r) in rates {
				sameRate = false when r != rates[0]
			}
			let ordered = unique.len() == frames.len()

			let head byte[]
			head.len(36)
			icoPut32(head, 0, 36)
			icoPut32(head, 4, unique.len())
			icoPut32(head, 8, frames.len())
			icoPut32(head, 28, rates[0])
			icoPut32(head, 32, ordered ?? (1, 3))

			let parts byte[][]
			parts.push(byte[])
			if title != "" || artist != "" {
				let info byte[][]
				info.push(byte[73, 78, 70, 79])
				info.push(aniChunk("INAM", aniText(title))) when title != ""
				info.push(aniChunk("IART", aniText(artist))) when artist != ""
				parts.push(aniChunk("LIST", aniJoin(info)))
			}
			parts.push(aniChunk("anih", head))
			parts.push(aniChunk("rate", aniInts(rates))) unless sameRate
			parts.push(aniChunk("seq ", aniInts(steps))) unless ordered
			let icons byte[][]
			icons.push(byte[102, 114, 97, 109])
			for let (_, img) in unique {
				let s = new IconSet()
				s.add(img, hotspotX, hotspotY)
				icons.push(aniChunk("icon", try s.bytes(2)))
			}
			parts.push(aniChunk("LIST", aniJoin(icons)))

			let riff byte[]
			riff.len(12)
			aniPutTag(riff, 0, "RIFF")
			aniPutTag(riff, 8, "ACON")
			parts[0] = riff
			let out = aniJoin(parts)
			icoPut32(out, 4, out.len() - 8)
			try writer.write(out)
		}

		// encode renders `frames` as an animated cursor; see
		// `encode(writer)`. Fails when there are no frames.
		def encode() !byte[] {
			let out = new bytes.Buffer()
			try encode(out)
			return out.bytes()
		}

		// encode renders the image as a one-frame animated cursor; see
		// `encode(img, writer)`. Fails when encoding does.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as a one-frame animated cursor with the
		// hotspot, leaving `frames` alone. Fails with the writer's error.
		def encode(img Image, writer io.Writer) !none {
			let one = new ANI()
			one.hotspotX = hotspotX
			one.hotspotY = hotspotY
			let f = new ImageFrame()
			f.image = img
			f.length = aniDuration(1)
			one.frames.push(f)
			return one.encode(writer)
		}
	}
}

internal partial module std.formats.image.ani {
	use std.formats.image.ico::*

	// ANI times its steps in jiffies, 1/60 s.
	const aniJiffiesPerSecond = 60

	def aniDuration(jiffies int) duration {
		return duration(jiffies * 1000000000 / aniJiffiesPerSecond)
	}

	// The whole jiffies nearest to `length`, at least one.
	def aniJiffies(length duration) int {
		return ((int(length) * aniJiffiesPerSecond + 500000000) / 1000000000).max(1)
	}

	// Whether the four bytes at `o` spell `tag`.
	def aniTag(b byte[], o int, tag string) bool {
		let t = tag.bytes()
		for let i = 0; i < 4; i++ {
			return false when b[o + i] != t[i]
		}
		return true
	}

	def aniPutTag(b byte[], o int, tag string) {
		tag.bytes().copy(b[o:o + 4])
	}

	// A RIFF chunk: the tag, the length and the body, padded to an even
	// length.
	def aniChunk(tag string, body byte[]) byte[] {
		let out byte[]
		out.len(8 + body.len() + body.len() % 2)
		aniPutTag(out, 0, tag)
		icoPut32(out, 4, body.len())
		body.copy(out[8:8 + body.len()])
		return out
	}

	// A list of 32-bit values as a chunk body.
	def aniInts(values int[]) byte[] {
		let out byte[]
		out.len(values.len() * 4)
		for let (i, v) in values {
			icoPut32(out, i * 4, v)
		}
		return out
	}

	// Joins byte arrays.
	def aniJoin(parts byte[][]) byte[] {
		let n = 0
		for let (_, p) in parts {
			n += p.len()
		}
		let out byte[]
		out.len(n)
		let at = 0
		for let (_, p) in parts {
			p.copy(out[at:at + p.len()])
			at += p.len()
		}
		return out
	}

	// A zero-terminated INFO string as a chunk body.
	def aniText(text string) byte[] {
		let out = text.bytes()
		out.push(byte(0))
		return out
	}
}
