partial module std.formats.image {
	use (
		std.testing
		std.bytes
	)

	check "ANI" {
		internal def solid(w int, h int, r int, a int) Image {
			let img = new Image(w, h)
			let px = img.raw()
			for let i = 0; i < px.len(); i += 4 {
				px[i] = byte(r)
				px[i + 1] = byte(i % 251)
				px[i + 3] = byte(a)
			}
			return img
		}

		internal def frame(img Image, length duration) ImageFrame {
			let f = new ImageFrame()
			f.image = img
			f.length = length
			return f
		}

		// Three steps showing two pictures: the repeat is stored once and
		// played through the sequence.
		internal def sample() ANI {
			let ani = new ANI()
			ani.frames.push(frame(solid(32, 32, 200, 255), 100ms))
			ani.frames.push(frame(solid(32, 32, 50, 128), 50ms))
			ani.frames.push(frame(solid(32, 32, 200, 255), 100ms))
			ani.hotspotX = 4
			ani.hotspotY = 9
			ani.title = "Busy"
			ani.artist = "ADM"
			return ani
		}

		internal def hasTag(data byte[], tag string) bool {
			let t = tag.bytes()
			for let i = 0; i + 4 <= data.len(); i++ {
				return true when data[i] == t[0] && data[i + 1] == t[1] && data[i + 2] == t[2] && data[i + 3] == t[3]
			}
			return false
		}

		@test()
		def round_trips_frames_and_timing() {
			let src = sample()
			let data = src.encode() onerror recover byte[]
			assert hasTag(data, "seq ")
			assert hasTag(data, "rate")

			let ani = new ANI()
			let first = ani.decode(data) onerror recover new Image(1, 1)
			assert first.raw().equals(src.frames[0].image.raw())
			assert ani.frames.len() == 3
			for let (i, f) in ani.frames {
				assert f.image.raw().equals(src.frames[i].image.raw())
				assert f.length == src.frames[i].length
			}
			assert ani.loopCount == 0
			assert ani.hotspotX == 4
			assert ani.hotspotY == 9
			assert ani.title == "Busy"
			assert ani.artist == "ADM"
		}

		// Distinct frames at one rate need neither a sequence nor a rate
		// table.
		@test()
		def writes_the_plain_form_when_it_can() {
			let ani = new ANI()
			ani.frames.push(frame(solid(16, 16, 1, 255), 200ms))
			ani.frames.push(frame(solid(16, 16, 2, 255), 200ms))
			let data = ani.encode() onerror recover byte[]
			assert !hasTag(data, "seq ")
			assert !hasTag(data, "rate")
			assert !hasTag(data, "INFO")
			let back = new ANI()
			back.decode(data) onerror recover new Image(1, 1)
			assert back.frames.len() == 2
			assert back.frames[1].length == 200ms
			assert int(back.frames[1].image.raw()[0]) == 2
		}

		@test()
		def encodes_one_image() {
			let data = new ANI().encode(solid(8, 8, 9, 255)) onerror recover byte[]
			let ani = new ANI()
			assert ani.matchSignature(new bytes.Buffer(data))
			let img = ani.decode(data) onerror recover new Image(1, 1)
			assert int(img.size().width) == 8
			assert ani.frames.len() == 1
			let info = new ANI().info(data) onerror recover ImageInfo{}
			assert int(info.size.width) == 8
		}

		@test()
		def rejects_what_it_cannot_decode() {
			let good = sample().encode() onerror recover byte[]
			// Clearing the icon flag marks the frames as raw bitmaps.
			let raw byte[]
			raw.len(good.len())
			good.copy(raw)
			for let i = 0; i + 4 <= raw.len(); i++ {
				if raw[i] == byte(97) && raw[i + 1] == byte(110) && raw[i + 2] == byte(105) && raw[i + 3] == byte(104) {
					raw[i + 8 + 32] = byte(0)
					break
				}
			}
			let cases = byte[][
				byte[82, 73, 70, 70, 4, 0, 0, 0, 65, 67, 79, 78],
				byte[82, 73, 70, 70, 4, 0, 0, 0, 87, 65, 86, 69],
				good[:good.len() - 10],
				raw
			]
			for let (_, c) in cases {
				let failed = false
				new ANI().decode(c) onerror (err error) {
					failed = true
					recover new Image(1, 1)
				}
				assert failed
			}
			let refused = false
			new ANI().encode() onerror (err error) {
				refused = true
				recover []
			}
			assert refused
		}
	}
}
