partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.mem
		std.math.geom
		std.gfx.color
		std.data.compress.zlib
		std.formats.image.apng::*
		std.formats.image.png::*
	)

	// APNG is the animated PNG codec. `decode` returns the first frame and
	// fills `frames` with every frame composited onto the full canvas;
	// `encode(writer)` writes `frames` back.
	@codec("Animated Portable Network Graphics")
	type APNG {
		// frames are the animation's frames, each the full canvas as it shows.
		frames       ImageFrame[]
		// loopCount is how many times the animation plays, 0 meaning forever.
		loopCount    int          = 0
		// defaultImage is the image shown by viewers without animation support
		// when it is not part of the animation; none means the first frame.
		defaultImage ?Image       = none
		// compression is the zlib level of the image data: DefaultCompression,
		// or 0 (none) to 9 (smallest, slowest).
		compression  zlib.Level   = zlib.Level.DefaultCompression

		internal canvas Image

		mimeType string[] {
			def get() string[] {
				return string["image/apng", "image/vnd.mozilla.apng"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".apng"]
			}
		}

		// matchSignature reports whether the reader holds an animated PNG: the
		// PNG signature, then an acTL chunk before the image data.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(8)
			let n = io.readFull(r, b) onerror recover 0
			return false when n != 8
			return false unless pngHasSignature(b)
			return pngAnimated(r)
		}

		// info reads the canvas dimensions and pixel format from the bytes.
		// Fails when they are not a PNG header.
		def info(data byte[]) !ImageInfo {
			return pngInfo(data)
		}

		// info reads the canvas dimensions and pixel format from the reader.
		// Fails when the data is not a PNG header, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return pngInfo(buf.bytes())
		}

		// decode reads an animated PNG from the bytes, fills `frames`,
		// `loopCount` and `defaultImage`, and returns the first frame. A PNG
		// without animation gives one frame. Fails when the data is not a PNG
		// the codec understands, or a frame lies outside the canvas.
		def decode(data byte[]) !Image {
			fail "not a PNG" unless pngHasSignature(data)
			frames = ImageFrame[]
			loopCount = 0
			defaultImage = none

			let width = 0
			let height = 0
			let bitDepth = 0
			let colorType = 0
			let interlace = 0
			let sawHeader = false
			let animated = false
			let sawIDAT = false
			let defaultIsFrame = false
			let palette byte[]
			let trans byte[]
			let idat = new bytes.Buffer()

			// The frame whose fcTL was read last and whose data is being gathered.
			let pending = false
			let fw = 0
			let fh = 0
			let fx = 0
			let fy = 0
			let delayNum = 0
			let delayDen = 0
			let disposeOp = 0
			let blendOp = 0
			let fdata = new bytes.Buffer()

			let pos = 8
			for pos + 8 <= data.len() {
				let length = pngU32(data, pos)
				fail "corrupt PNG: bad chunk length" when length < 0
				let kind = pos + 4
				let body = pos + 8
				fail "truncated PNG chunk" when body + length + 4 > data.len()

				if pngIsChunk(data, kind, "IHDR") {
					(width, height, bitDepth, colorType, interlace) = try pngHeader(data, body, length)
					sawHeader = true
					canvas = new Image(width, height)
				} else if pngIsChunk(data, kind, "PLTE") {
					palette = data[body:body + length]
				} else if pngIsChunk(data, kind, "tRNS") {
					trans = data[body:body + length]
				} else if pngIsChunk(data, kind, "acTL") {
					fail "apng: short acTL chunk" when length < 8
					animated = !sawIDAT
					loopCount = pngU32(data, body + 4)
				} else if pngIsChunk(data, kind, "fcTL") && animated {
					fail "apng: short fcTL chunk" when length < 26
					fail "corrupt PNG: no header" unless sawHeader
					if pending {
						let img = try pngDecodePixels(fw, fh, bitDepth, colorType, interlace, palette, trans, fdata.bytes())
						try addFrame(img, fx, fy, delayNum, delayDen, disposeOp, blendOp)
					}
					defaultIsFrame = true when !sawIDAT
					fw = pngU32(data, body + 4)
					fh = pngU32(data, body + 8)
					fx = pngU32(data, body + 12)
					fy = pngU32(data, body + 16)
					delayNum = int(data[body + 20]) << 8 | int(data[body + 21])
					delayDen = int(data[body + 22]) << 8 | int(data[body + 23])
					disposeOp = int(data[body + 24])
					blendOp = int(data[body + 25])
					fail "apng: invalid frame size" when fw <= 0 || fh <= 0
					fail "apng: frame outside the canvas" when fx < 0 || fy < 0 || fx + fw > width || fy + fh > height
					fail "apng: invalid dispose operation" when disposeOp > apngDisposePrevious
					fail "apng: invalid blend operation" when blendOp > apngBlendOver
					fail "apng: the first frame must cover the canvas" when !sawIDAT && (fx != 0 || fy != 0 || fw != width || fh != height)
					// A first frame restoring what came before restores the empty canvas.
					disposeOp = apngDisposeBackground when frames.len() == 0 && disposeOp == apngDisposePrevious
					pending = true
					fdata = new bytes.Buffer()
				} else if pngIsChunk(data, kind, "IDAT") {
					sawIDAT = true
					let part = data[body:body + length]
					try idat.write(part)
					try fdata.write(part) when pending
				} else if pngIsChunk(data, kind, "fdAT") && animated {
					fail "apng: fdAT chunk without a frame control" unless pending
					fail "apng: short fdAT chunk" when length < 4
					try fdata.write(data[body + 4:body + length])
				} else if pngIsChunk(data, kind, "IEND") {
					break
				}

				pos = body + length + 4
			}

			fail "corrupt PNG: no header" unless sawHeader
			let still = try pngDecodePixels(width, height, bitDepth, colorType, interlace, palette, trans, idat.bytes())
			if !animated || !pending {
				loopCount = 0
				frames.push(ImageFrame{image: still.copy(), length: duration(0), offset: new geom.Point(0.0, 0.0), blendMode: color.BlendMode.Normal})
				return still
			}

			let last = try pngDecodePixels(fw, fh, bitDepth, colorType, interlace, palette, trans, fdata.bytes())
			try addFrame(last, fx, fy, delayNum, delayDen, disposeOp, blendOp)
			defaultImage = still unless defaultIsFrame
			return frames[0].image
		}

		// decode reads an animated PNG from the reader. Fails when the data is
		// not a PNG the codec understands, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// Draws one decoded frame onto the canvas, records the result, then
		// disposes of the frame's region.
		internal def addFrame(img Image, x int, y int, delayNum int, delayDen int, disposeOp int, blendOp int) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			let saved = new Image(0, 0)
			if disposeOp == apngDisposePrevious {
				saved = new Image(w, h)
				apngCopyBlock(saved, 0, 0, canvas, x, y, w, h)
			}

			if blendOp == apngBlendSource {
				apngCopyBlock(canvas, x, y, img, 0, 0, w, h)
			} else {
				apngBlendOverAt(canvas, x, y, img)
			}

			let den = delayDen
			den = 100 when den == 0
			let length = duration(int64(delayNum) * 1000000000 / int64(den))
			frames.push(ImageFrame{image: canvas.copy(), length: length, offset: new geom.Point(0.0, 0.0), blendMode: color.BlendMode.Normal})

			if disposeOp == apngDisposeBackground {
				let px = canvas.raw()
				for let row = 0; row < h; row++ {
					let o = canvas.pixelOffset(x, y + row)
					px[o:o + w * 4] = 0
				}
			} else if disposeOp == apngDisposePrevious {
				apngCopyBlock(canvas, x, y, saved, 0, 0, w, h)
			}
		}

		// encode renders the image as a one-frame animated PNG. Fails when the
		// image is empty.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as a one-frame animated PNG to the writer.
		// Fails when the image is empty, or the writer does.
		def encode(img Image, writer io.Writer) !none {
			let one ImageFrame[]
			one.push(ImageFrame{image: img, length: duration(0), offset: new geom.Point(0.0, 0.0), blendMode: color.BlendMode.Normal})
			return writeFrames(one, none, writer)
		}

		// encode renders `frames`, `loopCount` and `defaultImage` as an animated
		// PNG. Fails when there are no frames or they differ in size.
		def encode() !byte[] {
			let out = new bytes.Buffer()
			try encode(out)
			return out.bytes()
		}

		// encode writes `frames`, `loopCount` and `defaultImage` as an animated
		// PNG to the writer. Each frame after the first is stored as the part
		// that changed since the previous one. Fails when there are no frames,
		// they differ in size, or the writer does.
		def encode(writer io.Writer) !none {
			return writeFrames(frames, defaultImage, writer)
		}

		internal def writeFrames(list ImageFrame[], still ?Image, writer io.Writer) !none {
			fail "apng: no frames to encode" when list.len() == 0
			let width = int(list[0].image.size().width)
			let height = int(list[0].image.size().height)
			fail "apng: cannot encode an empty image" when width <= 0 || height <= 0

			let images Image[]
			for let (i, f) in list {
				let fw = int(f.image.size().width)
				let fh = int(f.image.size().height)
				fail "apng: frame {i} is {fw}x{fh}, the canvas is {width}x{height}" when fw != width || fh != height
				images.push(f.image)
			}
			if still is Image {
				fail "apng: the default image differs in size from the frames" when int(still.size().width) != width || int(still.size().height) != height
				images.push(still)
			}

			let layout = pngChooseLayout(images, list.len() > 1)
			try pngWriteHeader(writer, width, height, layout)

			let actl byte[]
			actl.len(8)
			pngPut32(actl, 0, list.len())
			pngPut32(actl, 4, loopCount)
			try pngWriteChunk(writer, "acTL", actl)

			if still is Image {
				try pngWriteIDAT(writer, try pngCompress(still, layout, compression))
			}

			let seq = 0
			for let (i, f) in list {
				let x = 0
				let y = 0
				let part = f.image
				let blendOp = apngBlendSource
				(part, x, y, blendOp) = changedPart(list[i - 1].image, f.image, layout) when i > 0

				let fctl byte[]
				fctl.len(26)
				fctl[:] = 0
				pngPut32(fctl, 0, seq)
				seq++
				pngPut32(fctl, 4, int(part.size().width))
				pngPut32(fctl, 8, int(part.size().height))
				pngPut32(fctl, 12, x)
				pngPut32(fctl, 16, y)
				let (num, den) = apngDelay(f.length)
				fctl[20] = byte(num >> 8)
				fctl[21] = byte(num & 0xFF)
				fctl[22] = byte(den >> 8)
				fctl[23] = byte(den & 0xFF)
				fctl[24] = byte(apngDisposeNone)
				fctl[25] = byte(blendOp)
				try pngWriteChunk(writer, "fcTL", fctl)

				let zdata = try pngCompress(part, layout, compression)
				if i == 0 && still is none {
					try pngWriteIDAT(writer, zdata)
					continue
				}
				let at = 0
				for {
					let n = zdata.len() - at
					n = pngMaxChunk when n > pngMaxChunk
					let chunk byte[]
					chunk.len(n + 4)
					pngPut32(chunk, 0, seq)
					seq++
					mem.copyN(chunk[4:], zdata[at:at + n], n)
					try pngWriteChunk(writer, "fdAT", chunk)
					at += n
					break when at >= zdata.len()
				}
			}
			try pngWriteChunk(writer, "IEND", byte[])
		}

		// The smallest rectangle holding every pixel that differs between
		// `prev` and `next`, cut from `next`, with its position and the blend
		// operation that reproduces `next` over `prev`. When every changed
		// pixel is opaque and the layout has a transparent colour, the
		// unchanged ones are made transparent and blended over.
		internal def changedPart(prev Image, next Image, layout PngLayout) (Image, int, int, int) {
			let w = int(next.size().width)
			let h = int(next.size().height)
			let a = prev.raw()
			let b = next.raw()
			let x0 = w
			let y0 = h
			let x1 = -1
			let y1 = -1
			let allOpaque = true
			for let y = 0; y < h; y++ {
				let pa = prev.pixelOffset(0, y)
				let pb = next.pixelOffset(0, y)
				for let x = 0; x < w; x++ {
					if a[pa] != b[pb] || a[pa + 1] != b[pb + 1] || a[pa + 2] != b[pb + 2] || a[pa + 3] != b[pb + 3] {
						x0 = x when x < x0
						x1 = x when x > x1
						y0 = y when y < y0
						y1 = y
						allOpaque = false when b[pb + 3] != byte(255)
					}
					pa += 4
					pb += 4
				}
			}

			// Nothing changed: one pixel, copied as it is.
			return (apngCrop(next, 0, 0, 1, 1), 0, 0, apngBlendSource) when x1 < 0

			let pw = x1 - x0 + 1
			let ph = y1 - y0 + 1
			let part = apngCrop(next, x0, y0, pw, ph)
			return (part, x0, y0, apngBlendSource) unless allOpaque && layout.canBeTransparent()

			let cr = byte(0)
			let cg = byte(0)
			let cb = byte(0)
			if layout.colorType == ctPaletted {
				let t = layout.transparentIndex
				cr = layout.palette[t * 3]
				cg = layout.palette[t * 3 + 1]
				cb = layout.palette[t * 3 + 2]
			}
			let px = part.raw()
			for let y = 0; y < ph; y++ {
				let pa = prev.pixelOffset(x0, y0 + y)
				let o = part.pixelOffset(0, y)
				for let x = 0; x < pw; x++ {
					if a[pa] == px[o] && a[pa + 1] == px[o + 1] && a[pa + 2] == px[o + 2] && a[pa + 3] == px[o + 3] {
						px[o] = cr
						px[o + 1] = cg
						px[o + 2] = cb
						px[o + 3] = byte(0)
					}
					pa += 4
					o += 4
				}
			}
			return (part, x0, y0, apngBlendOver)
		}
	}
}

internal partial module std.formats.image.apng {
	use (
		std.mem
		std.formats.image::*
	)

	const (
		apngDisposeNone       = 0
		apngDisposeBackground = 1
		apngDisposePrevious   = 2
		apngBlendSource       = 0
		apngBlendOver         = 1
	)

	// Copies a `w` by `h` block of pixels from `src` at (sx, sy) to `dst` at
	// (dx, dy).
	def apngCopyBlock(dst Image, dx int, dy int, src Image, sx int, sy int, w int, h int) {
		let dpx = dst.raw()
		let spx = src.raw()
		let span = w * 4
		for let row = 0; row < h; row++ {
			let d = dst.pixelOffset(dx, dy + row)
			let s = src.pixelOffset(sx, sy + row)
			mem.copyN(dpx[d:d + span], spx[s:s + span], span)
		}
	}

	// A new image holding the `w` by `h` block of `src` at (x, y).
	def apngCrop(src Image, x int, y int, w int, h int) Image {
		let out = new Image(w, h)
		apngCopyBlock(out, 0, 0, src, x, y, w, h)
		return out
	}

	// Composites `src` over `dst` at (x, y) with straight alpha.
	def apngBlendOverAt(dst Image, x int, y int, src Image) {
		let w = int(src.size().width)
		let h = int(src.size().height)
		let dpx = dst.raw()
		let spx = src.raw()
		for let row = 0; row < h; row++ {
			let d = dst.pixelOffset(x, y + row)
			let s = src.pixelOffset(0, row)
			for let col = 0; col < w; col++ {
				let sa = int(spx[s + 3])
				if sa == 255 || (sa > 0 && dpx[d + 3] == byte(0)) {
					dpx[d] = spx[s]
					dpx[d + 1] = spx[s + 1]
					dpx[d + 2] = spx[s + 2]
					dpx[d + 3] = spx[s + 3]
				} else if sa > 0 {
					let da = int(dpx[d + 3])
					let sw = sa * 255
					let dw = da * (255 - sa)
					let outA = sw + dw
					for let c = 0; c < 3; c++ {
						let v = (int(spx[s + c]) * sw + int(dpx[d + c]) * dw + outA / 2) / outA
						dpx[d + c] = byte(v)
					}
					dpx[d + 3] = byte((outA + 127) / 255)
				}
				d += 4
				s += 4
			}
		}
	}

	// The frame delay as the fcTL numerator and denominator: milliseconds when
	// they fit, else hundredths of a second.
	def apngDelay(length duration) (int, int) {
		let ms = int(int64(length) / 1000000)
		ms = 0 when ms < 0
		return (ms, 1000) when ms <= 65535
		let cs = ms / 10
		cs = 65535 when cs > 65535
		return (cs, 100)
	}
}
