partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.formats.image.bmp::*
	)

	// BMP is the Windows bitmap codec. It decodes 1, 2, 4 and 8-bit paletted
	// (raw or RLE), 16, 24 and 32-bit bitmaps, and encodes 8-bit paletted when
	// the image is opaque with at most 256 colours, 24-bit when opaque, and
	// 32-bit BITMAPV5 with an alpha channel otherwise.
	@codec("Bitmap")
	type BMP {
		internal config  ImageInfo
		internal bpp     uint16
		internal size    uint32
		internal topDown bool
		internal rgb565  bool
		internal noAlpha bool
		internal rle     bool

		mimeType string[] {
			def get() string[] {
				return string["image/bmp", "image/x-bmp", "image/x-ms-bmp"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".bmp", ".dib"]
			}
		}

		// matchSignature reports whether the reader starts with the BM signature.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(10)

			let n = r.read(b) onerror recover 0
			return false when n != 10

			return false unless b[0:2].equals(byte[byte('B'), byte('M')])
			// 4 bytes of size which we don't care here
			return false unless b[6:].equals(byte[0, 0, 0, 0])
			return true
		}

		internal def newCheckedImage() !Image {
			let w = int(config.size.width)
			let h = int(config.size.height)
			fail "invalid bmp dimensions" when w <= 0 || h <= 0

			// The in-memory Image is always RGBA (4 bytes per pixel).
			const maxBytes = 1024 * 1024 * 1024 // 1GiB safety cap to avoid runtime aborts on huge headers.
			fail "bmp dimensions overflow" when w > maxBytes / 4
			let stride = w * 4
			fail "bmp dimensions overflow" when stride <= 0
			fail "bmp image too large" when h > maxBytes / stride

			return new Image(w, h)
		}

		// info reads the dimensions and pixel format from the bytes. Fails when they
		// are not a BMP header.
		def info(data byte[]) !ImageInfo {
			return info(new bytes.Buffer(data))
		}

		// info reads the dimensions and pixel format from the reader. Fails when the
		// data is not a BMP header, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let b byte[]
			b.len(1024)
			b[:] = 0

			try reader.read(b[:bmpFileHeaderLen + 4])
			let r = new bytes.Reader(b)

			let signature = try r.read<uint16>() // offset 0-2
			fail "not a BMP file" when signature != 0x4d42

			try r.skip(8) // skip over size (4bytes) reserved (4 bytes)

			let offset = try r.read<uint32>() // offset 10-14
			let infoLen = try r.read<uint32>() // offset 14-18

			fail "unsupported DIB version" unless infoLen := bmpInfoHeaderLen || bmpV4InfoHeaderLen || bmpV5InfoHeaderLen

			try reader.read(b[bmpFileHeaderLen + 4:bmpFileHeaderLen + infoLen])

			// BMP stores dimensions as signed 32-bit integers; negative height indicates a top-down image.
			let width = int(try r.read<int32>()) // offset 18-22
			let height = int(try r.read<int32>()) // offset 22-26
			if height < 0 {
				height, topDown = -height, true
			}
			fail "invalid image size" when width <= 0 || height <= 0

			let planes = try r.read<uint16>() // offset 26-28
			fail "unsupported BMP format" when planes != 1

			bpp = try r.read<uint16>() // offset 28-30
			let compression = try r.read<uint32>() // offset 30-34
			size = try r.read<uint32>() // offset 34-38

			try r.skip(8)
			let colors = try r.read<uint32>()
			let colorMaskLen uint32 = 0

			if compression == biBitFields && infoLen == bmpInfoHeaderLen {
				colorMaskLen = 4 * 3
				try reader.read(b[bmpFileHeaderLen + infoLen:bmpFileHeaderLen + infoLen + colorMaskLen])

				try r.seek(bmpFileHeaderLen + bmpInfoHeaderLen)
				let flag1 = try r.read<uint32>() // offset 54-58
				let flag2 = try r.read<uint32>() // offset 58-62
				let flag3 = try r.read<uint32>() // offset 62-66
				let flag4 = try r.read<uint32>() // offset 66-70

				if bpp == 16 && flag1 == 0xF800 && flag2 == 0x7E0 && flag3 == 0x1F {
					rgb565 = true
					compression = biRGB
				}
				if bpp == 16 && flag1 == 0x7C00 && flag2 == 0x3E0 && flag3 == 0x1F {
					compression = biRGB
				}
				if bpp == 32 && flag1 == 0xFF0000 && flag2 == 0xFF00 && flag3 == 0xFF && (infoLen == bmpInfoHeaderLen || flag4 == 0xFF000000) {
					compression = biRGB
					if infoLen == bmpInfoHeaderLen {
						noAlpha = true
					}
				}
			} else if compression == biBitFields && infoLen > bmpInfoHeaderLen {
				// The masks sit inside the V4/V5 header, already read.
				try r.seek(bmpFileHeaderLen + bmpInfoHeaderLen)
				let flag1 = try r.read<uint32>() // offset 54-58
				let flag2 = try r.read<uint32>() // offset 58-62
				let flag3 = try r.read<uint32>() // offset 62-66
				let flag4 = try r.read<uint32>() // offset 66-70

				if flag1 == 0xFF0000 && flag2 == 0xFF00 && flag3 == 0xFF && flag4 == 0xFF000000 {
					compression = biRGB
				}
			} else if (bpp == 4 && compression == biRLE4) || (bpp == 8 && compression == biRLE8) && !topDown {
				rle = true
				compression = biRGB
			}

			fail "unsupported compression method" unless compression == biRGB

			switch bpp {
				case 1, 2, 4, 8:
					if colors == 0 {
						colors = 1 << bpp
					}
					if offset != bmpFileHeaderLen + infoLen + colors * 4 {
						fail "wrong bitmap color offset"
					}
					try reader.read(b[:int(colors * 4)])

					let pcm = new color.Palette(colors)

					for let (i, _) in pcm.colors {
						pcm.colors[i] = new color.Color(color.RGBA{r: b[4 * i + 2], g: b[4 * i + 1], b: b[4 * i + 0], a: 0xff})
					}
					config = ImageInfo{
						size: new geom.Size(float(width), float(height)),
						colorFormat: color.ColorFormat.Palette,
						palette: pcm,
					}
				case 16:
					fail "invalid bitmap offset" when offset != bmpFileHeaderLen + infoLen + colorMaskLen
					config = ImageInfo{
						size: new geom.Size(float(width), float(height)),
						colorFormat: color.ColorFormat.RGBA,
					}
				case 24, 32:
					fail "invalid bitmap offset" when offset != bmpFileHeaderLen + infoLen + colorMaskLen
					config = ImageInfo{
						size: new geom.Size(float(width), float(height)),
						colorFormat: color.ColorFormat.RGBA,
					}
				default:
					fail "unsupported bitmap color depth"
			}
			return config
		}

		// decode reads a BMP image from the bytes. Fails when they are not a
		// BMP the codec understands.
		def decode(data byte[]) !Image {
			return decode(new bytes.Buffer(data))
		}

		// decode reads a BMP image from the reader. Fails when the data is not a
		// BMP the codec understands, or the reader does.
		def decode(reader io.Reader) !Image {
			try info(reader)

			if rle {
				return decodeRLE(reader)
			}

			switch bpp {
				case 1, 2, 4:
					return decodeSmallPaletted(reader)
				case 8:
					return decodePaletted(reader)
				case 16:
					return decodeRGB5x5(reader)
				case 24:
					return decodeRGB(reader)
				case 32:
					return decodeNRGBA(reader)
				default:
					fail "unsupported bitmap color depth"
			}
		}

		internal def decodeRLE(reader io.Reader) !Image {
			let img = try newCheckedImage()
			fail "invalid color palette" when config.palette is none
			let palette = config.palette

			// reads an 4 or 8 bit-per-pixel RLE-encoded BMP image
			let x, y = 0, int(config.size.height) - 1

			let b byte[]
			b.len(256)

			let isValid = def () bool {
							return x >= 0 && x < int(config.size.width) && y >= 0 && y < int(config.size.height)
						}
			let buf = new bytes.BinaryReader(reader)
			let count = 0
			for let iter = 0; iter < size; iter++ {
				let b1 = try buf.readByte()
				let b2 = try buf.readByte()

				switch b1 {
					case 0:
						switch b2 {
							case 0:
								x, y = 0, y - 1
								fail "invalid RLE data 1" when !isValid()
							case 1:
								return img // EOF
							case 2:
								// delta
								b1 = try buf.readByte()
								b2 = try buf.readByte()
								x, y = x + int(b1), y - int(b2)
								fail "invalid RLE data 2" when !isValid()
							default:
								// absolute mode
								let n = (uint16(b2) * bpp + 8 - 1) / 8
								if (bpp == 8 && b2 & 0x1 != 0) || (bpp == 4 && ((b2 & 0x3 == 1) || (b2 & 0x3 == 2))) {
									n++
								}
								b.len(n)
								try buf.read(b)
								for let i, j = uint8(0), 0; i < b2; i++ {
									let c byte
									if bpp == 8 {
										c = b[int(i)]
									} else {
										c = (b[j] >> 4) & 0xF
									}
									fail "invalid RLE data 3" when !isValid()
									let col = palette.colors[int(c)]
									try img.setPixel(x, int(y), col)
									x++
									if bpp == 4 {
										if i++; i < b2 {
											fail "invalid RLE data 4" when !isValid()
											col = palette.colors[int(b[j]) & 0xF]
											try img.setPixel(x, int(y), col)
											x++
										}
										if i % 2 != 0 {
											j++
										}
									}
								}
						}
					default:
						// encoded mode
						for let i = uint8(0); i < b1; i++ {
							fail "invalid RLE data 5" unless isValid()

							let c byte
							if bpp == 8 {
								c = b2
							} else {
								if i % 2 == 0 {
									c = (b2 >> 4) & 0xF
								} else {
									c = b2 & 0xF
								}
							}
							let col = palette.colors[int(c)]
							try img.setPixel(x, y, col)
							x++
						}
				}
			}

			return img
		}

		internal def decodeSmallPaletted(reader io.Reader) !Image {
			let img = try newCheckedImage()
			let pixelsPerByte = 8 / bpp
			fail "invalid color palette" when config.palette is none

			let palette = config.palette

			let b byte[]
			b.len((((int(config.size.width) + pixelsPerByte-1) / pixelsPerByte+3) >> 2) << 2)

			let y0, y1, yDelta = int(config.size.height) - 1, -1, -1
			if topDown {
				y0, y1, yDelta = 0, int(config.size.height), 1
			}
			for let y = y0; y != y1; y += yDelta {
				let n = try reader.read(b)
				let byt, bit = 0, 8 - bpp
				for let x = 0; x < int(config.size.width); x++ {
					let colorIndex = (b[byt] >> bit) & (1 << bpp-1)
					let c color.Color
					c = palette.colors[int(colorIndex)] when int(colorIndex) < palette.colors.len()
					try img.setPixel(x, y, c)
					if bit == 0 {
						bit = 8 - bpp
						byt++
					} else {
						bit -= bpp
					}
				}
			}
			return img
		}

		internal def decodePaletted(reader io.Reader) !Image {
			let img = try newCheckedImage()
			fail "invalid color palette" when config.palette is none
			let palette = config.palette

			let y0, y1, yDelta = int(config.size.height) - 1, -1, -1
			if topDown {
				y0, y1, yDelta = 0, int(config.size.height), 1
			}

			let b, tmp byte[]

			b.len(int(config.size.width))
			tmp.len(4)

			for let y = y0; y != y1; y += yDelta {
				// read all color indexes for the current row
				let n = try reader.read(b)
				// rows are 4byte alligned, so we need to read the extra bytes if needed
				if n % 4 != 0 {
					tmp.len(4 - n % 4)
					try reader.read(tmp)
				}
				for let x = 0; x < int(config.size.width); x++ {
					let colorIndex = b[x]
					let c color.Color
					c = palette.colors[int(colorIndex)] when int(colorIndex) < palette.colors.len()
					try img.setPixel(x, y, c)
				}
			}
			return img
		}

		internal def decodeRGB5x5(reader io.Reader) !Image {
			let img = try newCheckedImage()

			let b byte[]
			b.len(((2 * int(config.size.width) + 2) >> 2) << 2)

			let y0, y1, yDelta = int(config.size.height) - 1, -1, -1
			if topDown {
				y0, y1, yDelta = 0, int(config.size.height), 1
			}
			let buf = new bytes.Reader(b)

			for let y = y0; y != y1; y += yDelta {
				try reader.read(b)
				try buf.seek(0)
				for let x = 0; x < int(config.size.width); x++ {
					let col = color.RGBA{a: 0xFF}
					let pixel = try buf.read<uint16>()
					// Low bits repeat the high ones, so full intensity is 255.
					let r5 = 0
					let g = 0
					if rgb565 {
						r5 = int((pixel & 0xF800) >> 11)
						let g6 = int((pixel & 0x7E0) >> 5)
						g = g6 << 2 | g6 >> 4
					} else {
						r5 = int((pixel & 0x7C00) >> 10)
						let g5 = int((pixel & 0x3E0) >> 5)
						g = g5 << 3 | g5 >> 2
					}
					let b5 = int(pixel & 0x1F)
					col.r = uint8(r5 << 3 | r5 >> 2)
					col.g = uint8(g)
					col.b = uint8(b5 << 3 | b5 >> 2)
					try img.setPixel(x, y, new color.Color(col))
				}
			}
			return img
		}

		internal def decodeRGB(reader io.Reader) !Image {
			let img = try newCheckedImage()

			let b byte[]
			b.len(((3 * int(config.size.width) + 3) >> 2) << 2) // There are 3 bytes per pixel, and each row is 4-byte aligned.

			let y0, y1, yDelta = int(config.size.height) - 1, -1, -1
			if topDown {
				y0, y1, yDelta = 0, int(config.size.height), 1
			}

			for let y = y0; y != y1; y += yDelta {
				try reader.read(b)
				let p = img.raw()[y * img.stride():y * img.stride() + int(config.size.width) * 4]
				for let i, j = 0, 0; i < p.len(); i, j = i + 4, j + 3 {
					// BMP images are stored in BGR order rather than RGB order.
					p[i + 0] = b[j + 2]
					p[i + 1] = b[j + 1]
					p[i + 2] = b[j + 0]
					p[i + 3] = 0xFF
				}
			}
			return img
		}

		internal def decodeNRGBA(reader io.Reader) !Image {
			let img = try newCheckedImage()
			let y0, y1, yDelta = int(config.size.height) - 1, -1, -1
			if topDown {
				y0, y1, yDelta = 0, int(config.size.height), 1
			}

			let b byte[]
			b.len(img.stride())

			for let y = y0; y != y1; y += yDelta {
				try reader.read(b)
				for let x = 0; x < int(config.size.width); x++ {
					// BMP images are stored in BGRA order rather than RGBA order.
					try img.setPixel(x, y, new color.Color(color.RGBA{
											r: b[(4*x)+2],
											g: b[(4*x)+1],
											b: b[(4*x)],
											a: noAlpha ?? (0xFF, b[(4*x)+3])
										}))
				}
			}
			return img
		}

		// encode renders the image as BMP: 8-bit paletted when it is opaque with
		// at most 256 colours, 24-bit when opaque, else 32-bit BITMAPV5 with alpha.
		// Fails when the image is empty.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as BMP to the writer; see the byte overload for
		// the layout. Fails with the writer's error.
		def encode(img Image, writer io.Writer) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			fail "bmp: empty image" when w <= 0 || h <= 0
			let px = img.raw()
			let stride = img.stride()

			// Opaque, and its palette while it has at most 256 colours.
			let opaque = true
			let index = new map<int, int>()
			let colors int[]
			for let y = 0; y < h && opaque; y++ {
				let o = y * stride
				for let x = 0; x < w; x++ {
					if px[o + 3] != 255 {
						opaque = false
						break
					}
					if colors.len() <= 256 {
						let key = int(px[o]) << 16 | int(px[o + 1]) << 8 | int(px[o + 2])
						if !index.hasKey(key) {
							index.set(key, colors.len())
							colors.push(key)
						}
					}
					o += 4
				}
			}

			let depth = 24
			let infoLen = bmpInfoHeaderLen
			let ncolors = 0
			if !opaque {
				depth = 32
				infoLen = bmpV5InfoHeaderLen
			} else if colors.len() <= 256 {
				depth = 8
				ncolors = colors.len()
			}
			let rowLen = ((w * depth / 8) + 3) / 4 * 4
			let offset = bmpFileHeaderLen + infoLen + ncolors * 4
			let fileSize = offset + rowLen * h

			let out byte[]
			out.len(fileSize)
			out[0] = byte('B')
			out[1] = byte('M')
			bmpPut32(out, 2, fileSize)
			bmpPut32(out, 10, offset)
			bmpPut32(out, 14, infoLen)
			bmpPut32(out, 18, w)
			bmpPut32(out, 22, h)
			out[26] = 1
			out[28] = byte(depth)
			bmpPut32(out, 30, depth == 32 ?? (biBitFields, biRGB))
			bmpPut32(out, 34, rowLen * h)
			// 72 DPI.
			bmpPut32(out, 38, 2835)
			bmpPut32(out, 42, 2835)
			bmpPut32(out, 46, ncolors)
			if depth == 32 {
				bmpPut32(out, 54, 0x00FF0000)
				bmpPut32(out, 58, 0x0000FF00)
				bmpPut32(out, 62, 0x000000FF)
				bmpPut32(out, 66, 0xFF000000)
				// LCS_sRGB colour space, LCS_GM_IMAGES intent.
				bmpPut32(out, 70, 0x73524742)
				bmpPut32(out, 122, 4)
			}
			for let (i, c) in colors {
				continue when ncolors == 0
				let o = bmpFileHeaderLen + infoLen + i * 4
				out[o] = byte(c & 0xFF)
				out[o + 1] = byte((c >> 8) & 0xFF)
				out[o + 2] = byte((c >> 16) & 0xFF)
			}

			// Rows bottom-up.
			for let y = 0; y < h; y++ {
				let s = (h - 1 - y) * stride
				let d = offset + y * rowLen
				if depth == 8 {
					for let x = 0; x < w; x++ {
						let key = int(px[s]) << 16 | int(px[s + 1]) << 8 | int(px[s + 2])
						out[d + x] = byte(index[key])
						s += 4
					}
				} else if depth == 24 {
					for let x = 0; x < w; x++ {
						out[d] = px[s + 2]
						out[d + 1] = px[s + 1]
						out[d + 2] = px[s]
						s += 4
						d += 3
					}
				} else {
					for let x = 0; x < w; x++ {
						out[d] = px[s + 2]
						out[d + 1] = px[s + 1]
						out[d + 2] = px[s]
						out[d + 3] = px[s + 3]
						s += 4
						d += 4
					}
				}
			}
			try writer.write(out)
		}
	}
}

internal partial module std.formats.image.bmp {
	const (
		bmpFileHeaderLen   = 14
		bmpInfoHeaderLen   = 40
		bmpV4InfoHeaderLen = 108
		bmpV5InfoHeaderLen = 124
	)

	const (
		biRGB       = 0
		biRLE8      = 1
		biRLE4      = 2
		biBitFields = 3
	)

	// Writes a little-endian 32-bit value at `o`.
	def bmpPut32(out byte[], o int, v int) {
		out[o] = byte(v & 0xFF)
		out[o + 1] = byte((v >> 8) & 0xFF)
		out[o + 2] = byte((v >> 16) & 0xFF)
		out[o + 3] = byte((v >> 24) & 0xFF)
	}
}
