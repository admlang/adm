partial module std.formats.image {
	use std.testing

	check "BMP decoding" {
		internal def bmpPut(d byte[], o int, v int, n int) {
			for let i = 0; i < n; i++ {
				d[o + i] = byte((v >> (8 * i)) & 0xFF)
			}
		}

		internal def bmpNoise(n int, seed int) byte[] {
			let px byte[]
			px.len(n)
			let s = uint32(seed)
			for let i = 0; i < n; i++ {
				s = s * uint32(1664525) + uint32(1013904223)
				px[i] = byte(s >> 24)
			}
			return px
		}

		// A BMP file: the header of `info` bytes (40, 108 or 124), the three
		// bit masks after a 40-byte header when there are any, `colors`
		// palette entries and the pixel data; a negative height is top-down.
		internal def bmpFile(w int, h int, bpp int, compression int, info int, masks int[], colors int, data byte[]) byte[] {
			let maskLen = 0
			maskLen = 12 when masks.len() > 0 && info == 40
			let offset = 14 + info + maskLen + colors * 4
			let d byte[]
			d.len(offset + data.len())
			d[0] = byte(66)
			d[1] = byte(77)
			bmpPut(d, 2, d.len(), 4)
			bmpPut(d, 10, offset, 4)
			bmpPut(d, 14, info, 4)
			bmpPut(d, 18, w, 4)
			bmpPut(d, 22, h, 4)
			bmpPut(d, 26, 1, 2)
			bmpPut(d, 28, bpp, 2)
			bmpPut(d, 30, compression, 4)
			bmpPut(d, 34, data.len(), 4)
			bmpPut(d, 46, colors, 4)
			for let (i, m) in masks {
				bmpPut(d, 54 + i * 4, m, 4)
			}
			let pal = bmpNoise(colors * 4, 77)
			for let i = 0; i < colors * 4; i++ {
				d[14 + info + maskLen + i] = pal[i]
			}
			for let i = 0; i < data.len(); i++ {
				d[offset + i] = data[i]
			}
			return d
		}

		internal def bmpRows(w int, h int, bpp int, seed int) byte[] {
			let row = ((w * bpp + 31) / 32) * 4
			return bmpNoise(row * h.abs(), seed)
		}

		internal def bmpChecksum(data byte[]) string {
			let codec = new BMP()
			let img = codec.decode(data) onerror recover new Image(1, 1)
			let h = uint64(14695981039346656037)
			for let (_, b) in img.raw() {
				h = (h ^ uint64(b)) * uint64(1099511628211)
			}
			return "{img.size().width}x{img.size().height}:{h.hex()}"
		}

		// Run-length data for a w-pixel-wide image: runs, an absolute run,
		// a delta, end-of-line codes and the end of the bitmap.
		internal def bmpRle(w int, h int, four bool) byte[] {
			let d byte[]
			for let y = 0; y < h; y++ {
				let x = 0
				d.push(byte(5), byte(y * 17 + 3))
				x += 5
				d.push(byte(0), byte(6))
				// Six pixels: three bytes (padded to four) at 4 bits, six at 8.
				for let i = 0; i < (four ?? (4, 6)); i++ {
					d.push(byte(i * 37 + y))
				}
				x += 6
				if y == 2 {
					d.push(byte(0), byte(2), byte(1), byte(0))
					x += 1
				}
				d.push(byte(w - x - 1), byte(y * 29 + 1))
				d.push(byte(0), byte(0)) when y < h - 1
			}
			d.push(byte(0), byte(1))
			return d
		}

		@test()
		def rle_index_past_the_palette_fails() {
			let data = bmpFile(8, 2, 8, 1, 40, [], 4, byte[3, 9, 0, 0, 0, 1])
			let failed = false
			new BMP().decode(data) onerror {
				failed = true
				recover new Image(1, 1)
			}
			assert failed
		}

		@test()
		def outputs_stay_pinned() {
			let files byte[][]
			let w = 37
			for let (_, bpp) in [1, 2, 4, 8] {
				files.push(bmpFile(w, 9, bpp, 0, 40, [], 1 << bpp, bmpRows(w, 9, bpp, bpp)))
				files.push(bmpFile(w, -9, bpp, 0, 40, [], 1 << bpp, bmpRows(w, 9, bpp, bpp + 1)))
			}
			// A short palette: indices past it.
			files.push(bmpFile(w, 9, 8, 0, 40, [], 5, bmpRows(w, 9, 8, 3)))
			files.push(bmpFile(w, 7, 8, 1, 40, [], 256, bmpRle(w, 7, false)))
			files.push(bmpFile(w, 7, 4, 2, 40, [], 16, bmpRle(w, 7, true)))
			files.push(bmpFile(w, 9, 16, 3, 40, [0x7C00, 0x3E0, 0x1F], 0, bmpRows(w, 9, 16, 5)))
			files.push(bmpFile(w, 9, 16, 3, 40, [0xF800, 0x7E0, 0x1F], 0, bmpRows(w, 9, 16, 6)))
			files.push(bmpFile(w, 9, 24, 0, 40, [], 0, bmpRows(w, 9, 24, 7)))
			files.push(bmpFile(w, -9, 24, 0, 40, [], 0, bmpRows(w, 9, 24, 8)))
			files.push(bmpFile(w, 9, 32, 0, 40, [], 0, bmpRows(w, 9, 32, 9)))
			files.push(bmpFile(w, 9, 32, 3, 40, [0xFF0000, 0xFF00, 0xFF], 0, bmpRows(w, 9, 32, 10)))
			files.push(bmpFile(w, 9, 32, 3, 124, [0xFF0000, 0xFF00, 0xFF, 0xFF000000], 0, bmpRows(w, 9, 32, 11)))
			// Pinned when the byte loops replaced the per-pixel Color writes,
			// which gave the same output.
			let want = [
				"37x9:FEC2DA6E8AC22B1",
				"37x9:C0DA1091C591C541",
				"37x9:66F8F74D0CFEC16D",
				"37x9:C6A3339A6BC8491",
				"37x9:25EA6763F2CFF693",
				"37x9:99BEC63AE634911",
				"37x9:2F057FAA918C0FAA",
				"37x9:4E8FF363EFBC08AB",
				"37x9:ADDCD2888B812F2B",
				"37x7:B82E9538BA66AA15",
				"37x7:4D3EF18FE9460C9E",
				"37x9:666E4741B56E7B24",
				"37x9:40B958B0E5E4F1B",
				"37x9:EB89329DE943797F",
				"37x9:2B541D83D398C668",
				"37x9:3E22BF839577FB67",
				"37x9:D593460476E9AB7C",
				"37x9:C5FBB53FE96B9E67",
			]
			assert files.len() == want.len()
			for let (i, f) in files {
				assert bmpChecksum(f) == want[i]
			}
		}
	}
}
