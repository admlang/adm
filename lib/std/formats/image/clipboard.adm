// Pictures on the system clipboard, through the `Clipboard` service.

partial module std.formats.image {
	use std.services.clipboard::Clipboard

	// copyImage puts the image on the system clipboard as a PNG (`image/png`), for
	// other programs to paste. Fails when the clipboard refuses: the policy, or no
	// window open and no clipboard program that carries pictures (wl-clipboard and
	// xclip do).
	def copyImage(img Image) !none {
		let data = try new PNG().encode(img)
		return Clipboard.copyData("image/png", data)
	}

	// pasteImage reads the picture on the system clipboard: `image/png` when it is
	// offered, else the first other `image/` type a codec here decodes; none when it
	// offers no picture. Fails when the clipboard refuses or the picture does not
	// decode.
	def pasteImage() !?Image {
		let offered = try Clipboard.formats()
		let types string[]
		types.push("image/png") when offered.includes("image/png")
		for let t in offered {
			types.push(t) when t.startsWith("image/") && !types.includes(t)
		}
		for let t in types {
			let data = try Clipboard.pasteData(t)
			continue when data is none
			let found = open(data)
			continue when found is error
			let (img, _) = found
			return img
		}
		return none
	}
}
