partial module std.formats.image {
	use (
		std.services.clipboard::(Clipboard, ClipboardRequest)
		std.testing
	)

	// Stands for a window system's clipboard holding data by type, while `serving`.
	internal type PictureClipboard {
		serving bool                = false
		data    map<string, byte[]> = map<string, byte[]>{}
	}

	internal let pictureClipboard = new PictureClipboard()

	check "Image clipboard" {
		@on(Clipboard.reading)
		def onReading(evt Event<ClipboardRequest>) {
			return unless pictureClipboard.serving
			let request = evt.result
			if request.mime == "*" {
				let types string[]
				for let (name, _) in pictureClipboard.data {
					types.push(name)
				}
				request.answerFormats(types)
				return
			}
			request.answerData(pictureClipboard.data.get(request.mime)) when request.mime != ""
		}

		@on(Clipboard.writing)
		def onWriting(evt Event<ClipboardRequest>) {
			return unless pictureClipboard.serving
			let request = evt.result
			return when request.mime == ""
			let data = request.data
			pictureClipboard.data[request.mime] = data unless data is none
			request.done()
		}

		// A picture copied goes on the clipboard as a PNG and pastes back the same;
		// with no picture offered there is none to paste; another picture type a codec
		// reads pastes too.
		@test()
		def TestCopiesAndPastesPictures() !none {
			pictureClipboard.serving = true
			defer def () {
				pictureClipboard.serving = false
				pictureClipboard.data = map<string, byte[]>{}
			}()
			let img = new Image(3, 2)
			let px = img.raw()
			for let i = 0; i < px.len(); i += 4 {
				px[i] = byte(i * 9)
				px[i + 1] = byte(200)
				px[i + 3] = byte(255)
			}
			try copyImage(img)
			let held = pictureClipboard.data.get("image/png")
			fail "no PNG on the clipboard" when held is none
			assert codecFor(held) is PNG
			let back = try pasteImage()
			fail "nothing pasted" when back is none
			assert int(back.size().width) == 3 && int(back.size().height) == 2 && back.raw().equals(img.raw())

			pictureClipboard.data = map<string, byte[]>{}
			pictureClipboard.data["text/plain"] = "words".bytes()
			assert try pasteImage() is none

			pictureClipboard.data["image/bmp"] = try new BMP().encode(img)
			let bmp = try pasteImage()
			fail "no BMP pasted" when bmp is none
			assert int(bmp.size().width) == 3 && bmp.raw().equals(img.raw())
			return none
		}
	}
}
