partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.formats.image.ico::*
	)

	// CUR is the Windows cursor codec. A cursor is an icon whose entries each
	// carry a hotspot, the pixel that clicks; see ICO for the entry forms.
	//
	// `decode` returns the largest entry and keeps them all: `entries()`
	// lists them with their hotspots, `image(size)` renders one, `add`
	// appends another, and `encode(writer)` writes the whole set back. An
	// editor works on one entry by its position as with `ICO`: `indexed`,
	// `replace`, `remove`, `add(pixels)`, and `setHotspot` moves its click
	// point.
	@codec("Cursor")
	type CUR {
		internal set        = new IconSet()
		// The bytes `decode` read, which `encode` gives back as they were
		// while no entry has changed; empty for a cursor built from images.
		internal raw byte[]

		mimeType string[] {
			def get() string[] {
				return string["application/octet-stream"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".cur"]
			}
		}

		// matchSignature reports whether the reader starts with a cursor
		// directory.
		def matchSignature(r io.Reader) bool {
			return icoMatch(r, 2)
		}

		// info reads the size of the largest entry from the bytes. Fails when
		// they are not a cursor or icon.
		def info(data byte[]) !ImageInfo {
			let s = new IconSet()
			try s.load(data)
			return s.info()
		}

		// info reads the size of the largest entry from the reader. Fails when
		// the data is not a cursor or icon, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads a cursor from the bytes and returns its largest entry,
		// the deepest among equal sizes; the codec keeps every entry. Also
		// reads icon files, whose entries get a (0, 0) hotspot. Fails when
		// the bytes are neither, or that entry cannot be decoded.
		def decode(data byte[]) !Image {
			let s = new IconSet()
			try s.load(data)
			set = s
			raw = data
			return s.render(s.best())
		}

		// decode reads a cursor from the reader; see `decode(data)`. Fails
		// when the data is not a cursor, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// entries describes the entries the codec holds, in file order, with
		// their hotspots.
		def entries() IconEntry[] {
			return set.entries()
		}

		// sizes lists the distinct entry sizes (the larger side), smallest
		// first.
		def sizes() int[] {
			return set.sizes()
		}

		// image renders the cursor at `size` pixels (the larger side), picked
		// as ICO.image does. Fails when the codec holds no entry, or the entry
		// cannot be decoded.
		def image(size int) !Image {
			return set.pick(size)
		}

		// image decodes the entry `entries()` described: the one at its
		// `index` when that is it, else the first that matches. Fails when the
		// codec holds no such entry, or it cannot be decoded.
		def image(entry IconEntry) !Image {
			return set.find(entry)
		}

		// indexed reads the entry at `at` as stored: its palette in file
		// order, one index per pixel and the mask. Fails when there is no such
		// entry, or it is not paletted (24 or 32 bits, or a PNG).
		def indexed(at int) !IndexedPixels {
			return set.indexed(at)
		}

		// add appends the image as a new entry clicking at (`hotspotX`,
		// `hotspotY`), scaled down to fit 256 x 256 when larger, the hotspot
		// with it.
		def add(img Image, hotspotX int = 0, hotspotY int = 0) {
			set.add(img, hotspotX, hotspotY)
		}

		// add appends paletted pixels as a new entry clicking at (`hotspotX`,
		// `hotspotY`), of `bitDepth` bits (1, 4 or 8), or of the fewest that
		// hold the palette when 0. Fails when the pixels do not agree with each
		// other (a size over 256, an index past the palette, a palette too
		// large for the depth).
		def add(pixels IndexedPixels, hotspotX int = 0, hotspotY int = 0, bitDepth int = 0) !none {
			return set.addIndexed(pixels, hotspotX, hotspotY, bitDepth)
		}

		// replace rewrites the entry at `at` with the image, at the entry's own
		// depth, as `ICO.replace` does; the hotspot stays. Fails when there is
		// no such entry, or the image is wider or taller than 256.
		def replace(at int, img Image) !none {
			return set.replace(at, img)
		}

		// replace rewrites the entry at `at` with paletted pixels, as
		// `ICO.replace` does; the hotspot stays. Fails when there is no such
		// entry, or the pixels do not agree with each other.
		def replace(at int, pixels IndexedPixels) !none {
			return set.replaceIndexed(at, pixels)
		}

		// remove drops the entry at `at`. Fails when there is none.
		def remove(at int) !none {
			return set.remove(at)
		}

		// setHotspot moves the click point of the entry at `at` to (`x`, `y`),
		// a pixel of it. Fails when there is no such entry, or the point is
		// outside it.
		def setHotspot(at int, x int, y int) !none {
			return set.setHotspot(at, x, y)
		}

		// clear drops every entry.
		def clear() {
			set = new IconSet()
			raw = []
		}

		// encode writes every entry the codec holds as a cursor: the bytes
		// `decode` read when no entry has changed since, else the directory
		// and every entry anew, unchanged entries byte for byte. Fails when it
		// holds none, or the writer fails.
		def encode(writer io.Writer) !none {
			if raw.len() > 0 && !set.changed {
				try writer.write(raw)
				return none
			}
			return set.write(writer, 2)
		}

		// encode renders every entry the codec holds as a cursor; see
		// `encode(writer)`. Fails when it holds none.
		def encode() !byte[] {
			return raw when raw.len() > 0 && !set.changed
			return set.bytes(2)
		}

		// encode renders the image as a cursor; see `encode(img, writer)`.
		// Fails when encoding does.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as a cursor of one entry with its hotspot at
		// (0, 0), scaled down to fit 256 x 256 when larger, leaving the
		// entries the codec holds alone. Fails with the writer's error.
		def encode(img Image, writer io.Writer) !none {
			let s = new IconSet()
			s.add(img, 0, 0)
			return s.write(writer, 2)
		}
	}
}
