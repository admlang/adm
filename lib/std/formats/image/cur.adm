partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.formats.image.ico::*
	)

	// CUR is the Windows cursor codec. A cursor is an icon whose entries each
	// carry a hotspot, the pixel that clicks; see ICO for the entry forms.
	//
	// `decode` returns the largest entry and keeps them all: `entries()`
	// lists them with their hotspots, `image(size)` renders one, `add`
	// appends another, and `encode(writer)` writes the whole set back.
	@codec("Cursor")
	type CUR {
		internal set = new IconSet()

		mimeType string[] {
			def get() string[] {
				return string["application/octet-stream"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".cur"]
			}
		}

		// matchSignature reports whether the reader starts with a cursor
		// directory.
		def matchSignature(r io.Reader) bool {
			return icoMatch(r, 2)
		}

		// info reads the size of the largest entry from the bytes. Fails when
		// they are not a cursor or icon.
		def info(data byte[]) !ImageInfo {
			let s = new IconSet()
			try s.load(data)
			return s.info()
		}

		// info reads the size of the largest entry from the reader. Fails when
		// the data is not a cursor or icon, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads a cursor from the bytes and returns its largest entry,
		// the deepest among equal sizes; the codec keeps every entry. Also
		// reads icon files, whose entries get a (0, 0) hotspot. Fails when
		// the bytes are neither, or that entry cannot be decoded.
		def decode(data byte[]) !Image {
			let s = new IconSet()
			try s.load(data)
			set = s
			return s.render(s.best())
		}

		// decode reads a cursor from the reader; see `decode(data)`. Fails
		// when the data is not a cursor, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// entries describes the entries the codec holds, in file order, with
		// their hotspots.
		def entries() IconEntry[] {
			return set.entries()
		}

		// sizes lists the distinct entry sizes (the larger side), smallest
		// first.
		def sizes() int[] {
			return set.sizes()
		}

		// image renders the cursor at `size` pixels (the larger side), picked
		// as ICO.image does. Fails when the codec holds no entry, or the entry
		// cannot be decoded.
		def image(size int) !Image {
			return set.pick(size)
		}

		// image decodes the entry `entries()` described. Fails when the codec
		// holds no such entry, or it cannot be decoded.
		def image(entry IconEntry) !Image {
			return set.find(entry)
		}

		// add appends the image as a new entry clicking at (`hotspotX`,
		// `hotspotY`), scaled down to fit 256 x 256 when larger, the hotspot
		// with it.
		def add(img Image, hotspotX int = 0, hotspotY int = 0) {
			set.add(img, hotspotX, hotspotY)
		}

		// clear drops every entry.
		def clear() {
			set = new IconSet()
		}

		// encode writes every entry the codec holds as a cursor. Fails when it
		// holds none, or the writer fails.
		def encode(writer io.Writer) !none {
			return set.write(writer, 2)
		}

		// encode renders every entry the codec holds as a cursor. Fails when
		// it holds none.
		def encode() !byte[] {
			return set.bytes(2)
		}

		// encode renders the image as a cursor; see `encode(img, writer)`.
		// Fails when encoding does.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as a cursor of one entry with its hotspot at
		// (0, 0), scaled down to fit 256 x 256 when larger, leaving the
		// entries the codec holds alone. Fails with the writer's error.
		def encode(img Image, writer io.Writer) !none {
			let s = new IconSet()
			s.add(img, 0, 0)
			return s.write(writer, 2)
		}
	}
}
