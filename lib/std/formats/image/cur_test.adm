partial module std.formats.image {
	use (
		std.testing
		std.bytes
	)

	check "CUR" {
		// A solid square whose pixel (x, y) is recognisable.
		internal def cursorImage(w int, h int) Image {
			let img = new Image(w, h)
			let px = img.raw()
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					let o = img.pixelOffset(x, y)
					px[o] = byte(x % 256)
					px[o + 1] = byte(y % 256)
					px[o + 3] = byte(x == y ?? (255, 0))
				}
			}
			return img
		}

		@test()
		def keeps_hotspots() {
			let cur = new CUR()
			cur.add(cursorImage(32, 32), 5, 7)
			cur.add(cursorImage(16, 16), 2, 3)
			let data = cur.encode() onerror recover byte[]
			assert int(data[2]) == 2

			let back = new CUR()
			let img = back.decode(data) onerror recover new Image(1, 1)
			assert int(img.size().width) == 32
			assert img.raw().equals(cursorImage(32, 32).raw())
			let e = back.entries()
			assert e.len() == 2
			assert e[0].hotspotX == 5
			assert e[0].hotspotY == 7
			assert e[1].hotspotX == 2
			assert e[1].hotspotY == 3
		}

		@test()
		def scales_the_hotspot_with_the_image() {
			let cur = new CUR()
			cur.add(cursorImage(512, 512), 100, 400)
			let e = cur.entries()
			assert e[0].width == 256
			assert e[0].hotspotX == 50
			assert e[0].hotspotY == 200
		}

		@test()
		def matches_its_signature() {
			let data = new CUR().encode(cursorImage(8, 8)) onerror recover byte[]
			assert new CUR().matchSignature(new bytes.Buffer(data))
			assert !new ICO().matchSignature(new bytes.Buffer(data))
			let info = new CUR().info(data) onerror recover ImageInfo{}
			assert int(info.size.width) == 8
		}

		// Cursors saved with the icon type still read, with no hotspot.
		@test()
		def reads_icon_files() {
			let data = new ICO().encode(cursorImage(8, 8)) onerror recover byte[]
			let cur = new CUR()
			let img = cur.decode(data) onerror recover new Image(1, 1)
			assert int(img.size().width) == 8
			assert cur.entries()[0].hotspotX == 0
		}

		@test()
		def rejects_what_it_cannot_decode() {
			let failed = false
			new CUR().decode(byte[0, 0, 2, 0, 1, 0, 32, 32]) onerror (err error) {
				failed = true
				recover new Image(1, 1)
			}
			assert failed
			let refused = false
			new CUR().encode() onerror (err error) {
				refused = true
				recover []
			}
			assert refused
		}
	}
}
