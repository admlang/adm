partial module std.formats.image {
	use (
		std.math.geom
		std.gfx.color
	)

	// ImageFrame is one frame of an animated image: the image and how long it
	// shows.
	type ImageFrame {
		image     Image
		length    duration
		offset    geom.Point
		blendMode color.BlendMode
	}

	// ImageSequence is an animated image: its frames in order and how many times
	// they loop, 0 meaning forever.
	type ImageSequence {
		loopCount int          = 0 // 0 means infinite loop
		frames    ImageFrame[]
	}
}
