partial module std.formats.image {
	use (
		std.testing
		std.bytes
		std.math.geom
		std.gfx.color
	)

	check "GIF" {
		internal def assertPixel(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			assert int(img.raw()[o]) == r
			assert int(img.raw()[o + 1]) == g
			assert int(img.raw()[o + 2]) == b
			assert int(img.raw()[o + 3]) == a
		}

		// Whether two images hold the same pixels, treating every fully
		// transparent pixel as equal.
		internal def samePixels(a Image, b Image) bool {
			return false unless a.size().width == b.size().width && a.size().height == b.size().height
			let pa = a.raw()
			let pb = b.raw()
			for let o = 0; o < pa.len(); o += 4 {
				continue when pa[o + 3] == byte(0) && pb[o + 3] == byte(0)
				return false unless pa[o] == pb[o] && pa[o + 1] == pb[o + 1] && pa[o + 2] == pb[o + 2] && pa[o + 3] == pb[o + 3]
			}
			return true
		}

		internal def fill(img Image, r int, g int, b int, a int) Image {
			let px = img.raw()
			for let o = 0; o < px.len(); o += 4 {
				px[o] = byte(r)
				px[o + 1] = byte(g)
				px[o + 2] = byte(b)
				px[o + 3] = byte(a)
			}
			return img
		}

		internal def put(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			img.raw()[o] = byte(r)
			img.raw()[o + 1] = byte(g)
			img.raw()[o + 2] = byte(b)
			img.raw()[o + 3] = byte(a)
		}

		// A smooth colour field with far more than 256 colours.
		internal def gradient(w int, h int) Image {
			let img = new Image(w, h)
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					put(img, x, y, x * 255 / (w - 1), y * 255 / (h - 1), (x + y) * 255 / (w + h - 2), 255)
				}
			}
			return img
		}

		// 4x3 GIF87a with a four-colour global table: red, green, blue, white.
		// Rows are 0 1 2 3 / 3 2 1 0 / 0 0 1 1.
		internal def staticGIF() byte[] {
			return byte[
				71, 73, 70, 56, 55, 97, 4, 0, 3, 0, 145, 0, 0, 255, 0, 0,
				0, 255, 0, 0, 0, 255, 255, 255, 255, 44, 0, 0, 0, 0, 4, 0,
				3, 0, 0, 2, 7, 68, 52, 35, 1, 29, 81, 0, 0, 59,
			]
		}

		// 8x8 interlaced; row y is palette entry y, (y*30, 255-y*30, y*10).
		internal def interlacedGIF() byte[] {
			return byte[
				71, 73, 70, 56, 57, 97, 8, 0, 8, 0, 162, 0, 0, 0, 255, 0,
				30, 225, 10, 60, 195, 20, 90, 165, 30, 120, 135, 40, 150, 105, 50, 180,
				75, 60, 210, 45, 70, 44, 0, 0, 0, 0, 8, 0, 8, 0, 64, 3,
				22, 8, 186, 74, 254, 78, 200, 41, 141, 189, 54, 232, 173, 135, 255, 94,
				33, 142, 226, 97, 158, 102, 2, 0, 59,
			]
		}

		// 4x4 animation, loop extension 5, comment "hello", palette red,
		// green, blue, white:
		// 1. red over the canvas, delay 10;
		// 2. green 2x2 at (1,1) with (2,1) transparent, disposal restore-to-previous;
		// 3. local-table blue at (0,0), disposal restore-to-background;
		// 4. white at (3,3).
		internal def animatedGIF() byte[] {
			return byte[
				71, 73, 70, 56, 57, 97, 4, 0, 4, 0, 145, 3, 0, 255, 0, 0,
				0, 255, 0, 0, 0, 255, 255, 255, 255, 33, 255, 11, 78, 69, 84, 83,
				67, 65, 80, 69, 50, 46, 48, 3, 1, 5, 0, 0, 33, 254, 5, 104,
				101, 108, 108, 111, 0, 33, 249, 4, 4, 10, 0, 0, 0, 44, 0, 0,
				0, 0, 4, 0, 4, 0, 0, 2, 4, 132, 143, 9, 5, 0, 33, 249,
				4, 13, 20, 0, 3, 0, 44, 1, 0, 1, 0, 2, 0, 2, 0, 0,
				2, 3, 204, 18, 5, 0, 33, 249, 4, 8, 30, 0, 0, 0, 44, 0,
				0, 0, 0, 1, 0, 1, 0, 128, 0, 0, 255, 255, 255, 255, 2, 2,
				68, 1, 0, 33, 249, 4, 0, 40, 0, 0, 0, 44, 3, 0, 3, 0,
				1, 0, 1, 0, 0, 2, 2, 92, 1, 0, 59,
			]
		}

		@test()
		def matches_the_signature() {
			let codec = new GIF()
			assert codec.matchSignature(new bytes.Buffer(staticGIF()))
			assert codec.matchSignature(new bytes.Buffer(animatedGIF()))
			assert !codec.matchSignature(new bytes.Buffer(byte[71, 73, 70, 56, 56, 97]))
			assert !codec.matchSignature(new bytes.Buffer(byte[71, 73, 70]))
		}

		@test()
		def info_reads_the_header() {
			let codec = new GIF()
			let got = codec.info(staticGIF()) onerror recover ImageInfo{}
			assert int(got.size.width) == 4
			assert int(got.size.height) == 3
			assert got.palette.len() == 4
			let c = got.palette.colors[2]
			assert int(c.blue) == 255 && int(c.red) == 0
		}

		@test()
		def decodes_a_static_image() {
			let codec = new GIF()
			let img = codec.decode(staticGIF()) onerror recover new Image(1, 1)
			assert int(img.size().width) == 4
			assert int(img.size().height) == 3
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 1, 0, 0, 255, 0, 255)
			assertPixel(img, 2, 0, 0, 0, 255, 255)
			assertPixel(img, 3, 0, 255, 255, 255, 255)
			assertPixel(img, 0, 1, 255, 255, 255, 255)
			assertPixel(img, 3, 1, 255, 0, 0, 255)
			assertPixel(img, 2, 2, 0, 255, 0, 255)
			assert codec.frames.len() == 1
			assert codec.loopCount == 1
			let bg = codec.background
			if bg is none {
				assert false
			} else {
				assert int(bg.red) == 255
			}
		}

		@test()
		def decodes_interlaced_rows_in_place() {
			let codec = new GIF()
			let img = codec.decode(interlacedGIF()) onerror recover new Image(1, 1)
			assert int(img.size().width) == 8
			for let y = 0; y < 8; y++ {
				assertPixel(img, 0, y, y * 30, 255 - y * 30, y * 10, 255)
				assertPixel(img, 7, y, y * 30, 255 - y * 30, y * 10, 255)
			}
		}

		@test()
		def composites_every_frame() {
			let codec = new GIF()
			let first = codec.decode(animatedGIF()) onerror recover new Image(1, 1)
			assert codec.frames.len() == 4
			assert codec.loopCount == 6
			assert codec.comment == "hello"
			assert int(codec.frames[0].length) == 100000000
			assert int(codec.frames[3].length) == 400000000
			assert samePixels(first, codec.frames[0].image)

			let f0 = codec.frames[0].image
			assertPixel(f0, 0, 0, 255, 0, 0, 255)
			assertPixel(f0, 3, 3, 255, 0, 0, 255)

			// Green over red; the transparent index lets red through.
			let f1 = codec.frames[1].image
			assertPixel(f1, 1, 1, 0, 255, 0, 255)
			assertPixel(f1, 2, 1, 255, 0, 0, 255)
			assertPixel(f1, 2, 2, 0, 255, 0, 255)
			assertPixel(f1, 0, 0, 255, 0, 0, 255)

			// Frame 1 restores the canvas to frame 0 before the blue pixel.
			let f2 = codec.frames[2].image
			assertPixel(f2, 0, 0, 0, 0, 255, 255)
			assertPixel(f2, 1, 1, 255, 0, 0, 255)

			// Frame 2 clears its rectangle to transparent.
			let f3 = codec.frames[3].image
			assertPixel(f3, 0, 0, 0, 0, 0, 0)
			assertPixel(f3, 1, 1, 255, 0, 0, 255)
			assertPixel(f3, 3, 3, 255, 255, 255, 255)
		}

		@test()
		def keeps_what_arrived_of_a_truncated_file() {
			let whole = animatedGIF()
			// Cut inside the third frame's image data.
			let cut = whole[0:whole.len() - 22]
			let codec = new GIF()
			let img = codec.decode(cut) onerror recover new Image(1, 1)
			assert int(img.size().width) == 4
			assert codec.frames.len() == 3

			// Cut inside the only frame's pixels: the rows that arrived show.
			let s = staticGIF()
			let truncated = new GIF()
			let part = truncated.decode(s[0:s.len() - 4]) onerror recover new Image(1, 1)
			assert int(part.size().width) == 4
			assertPixel(part, 0, 0, 255, 0, 0, 255)
		}

		@test()
		def rejects_what_it_cannot_decode() {
			let codec = new GIF()
			let img = codec.decode(byte[1, 2, 3, 4, 5, 6, 7, 8, 9]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
			let s = staticGIF()
			let noImage = codec.decode(s[0:25]) onerror recover new Image(7, 7)
			assert int(noImage.size().width) == 7
			let head = codec.decode(s[0:10]) onerror recover new Image(7, 7)
			assert int(head.size().width) == 7
			let info = codec.info(s[0:20]) onerror recover ImageInfo{}
			assert int(info.size.width) == 0
		}

		@test()
		def round_trips_few_colours_exactly() {
			let img = new Image(9, 7)
			fill(img, 10, 20, 30, 255)
			put(img, 0, 0, 255, 0, 0, 255)
			put(img, 8, 6, 0, 0, 255, 255)
			put(img, 4, 3, 0, 0, 0, 0)
			put(img, 5, 3, 1, 2, 3, 100)
			let codec = new GIF()
			let data = codec.encode(img) onerror recover byte[]
			let back = new GIF().decode(data) onerror recover new Image(1, 1)
			assertPixel(back, 0, 0, 255, 0, 0, 255)
			assertPixel(back, 8, 6, 0, 0, 255, 255)
			assertPixel(back, 1, 1, 10, 20, 30, 255)
			assert int(back.raw()[back.pixelOffset(4, 3) + 3]) == 0
			assert int(back.raw()[back.pixelOffset(5, 3) + 3]) == 0
		}

		// 256 colours in a noisy order fill the LZW table, which has to be
		// cleared and restarted along the way.
		@test()
		def round_trips_through_a_full_code_table() {
			let img = new Image(128, 96)
			let seed = 12345
			let px = img.raw()
			for let o = 0; o < px.len(); o += 4 {
				seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
				let v = (seed >> 16) & 255
				px[o] = byte(v)
				px[o + 1] = byte(255 - v)
				px[o + 2] = byte(v ^ 0x5A)
				px[o + 3] = byte(255)
			}
			let data = new GIF().encode(img) onerror recover byte[]
			let back = new GIF().decode(data) onerror recover new Image(1, 1)
			assert samePixels(img, back)
		}

		@test()
		def reduces_many_colours_in_every_dither_mode() {
			let img = gradient(64, 48)
			for let mode in GIFDither[GIFDither.None, GIFDither.Ordered, GIFDither.FloydSteinberg] {
				let codec = new GIF()
				codec.dither = mode
				let data = codec.encode(img) onerror recover byte[]
				let back = new GIF().decode(data) onerror recover new Image(1, 1)
				assert int(back.size().width) == 64
				// Average error per channel stays small.
				let total = 0
				let a = img.raw()
				let b = back.raw()
				for let o = 0; o < a.len(); o += 4 {
					assert int(b[o + 3]) == 255
					total += (int(a[o]) - int(b[o])).abs() + (int(a[o + 1]) - int(b[o + 1])).abs() + (int(a[o + 2]) - int(b[o + 2])).abs()
				}
				assert total / (64 * 48 * 3) < 12
			}
		}

		@test()
		def round_trips_an_animation() {
			let a = fill(new Image(6, 5), 200, 10, 10, 255)
			let b = a.copy()
			put(b, 2, 2, 10, 200, 10, 255)
			put(b, 3, 3, 10, 10, 200, 255)
			// A pixel that turns transparent needs the canvas cleared.
			let c = b.copy()
			put(c, 0, 0, 0, 0, 0, 0)
			// Unchanged from c.
			let d = c.copy()
			let codec = new GIF()
			codec.loopCount = 3
			codec.comment = "made by adm"
			for let img in Image[a, b, c, d] {
				codec.frames.push(ImageFrame{image: img, length: 70ms, offset: new geom.Point(0.0, 0.0), blendMode: color.BlendMode.Normal})
			}
			let data = codec.encode() onerror recover byte[]

			let back = new GIF()
			let first = back.decode(data) onerror recover new Image(1, 1)
			assert samePixels(first, a)
			assert back.frames.len() == 4
			assert back.loopCount == 3
			assert back.comment == "made by adm"
			assert samePixels(back.frames[1].image, b)
			assert samePixels(back.frames[2].image, c)
			assert samePixels(back.frames[3].image, d)
			assert int(back.frames[2].length) == 70000000
		}

		// More than 255 colours across the frames puts a local table on each.
		@test()
		def round_trips_an_animation_with_local_tables() {
			let a = gradient(32, 32)
			let b = a.copy()
			fill(b, 0, 0, 0, 0)
			b.draw(gradient(16, 16), 8, 8)
			let codec = new GIF()
			codec.frames.push(ImageFrame{image: a, length: 10ms, offset: new geom.Point(0.0, 0.0), blendMode: color.BlendMode.Normal})
			codec.frames.push(ImageFrame{image: b, length: 10ms, offset: new geom.Point(0.0, 0.0), blendMode: color.BlendMode.Normal})
			let data = codec.encode() onerror recover byte[]
			let back = new GIF()
			back.decode(data) onerror recover new Image(1, 1)
			assert back.frames.len() == 2
			assert back.loopCount == 0
			let f = back.frames[1].image
			assert int(f.raw()[f.pixelOffset(0, 0) + 3]) == 0
			assert int(f.raw()[f.pixelOffset(8, 8) + 3]) == 255
		}

		@test()
		def refuses_an_empty_animation() {
			let codec = new GIF()
			let data = codec.encode() onerror recover byte[7]
			assert data.len() == 1
		}
	}
}
