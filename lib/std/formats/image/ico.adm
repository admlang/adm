partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.gfx.color
		std.formats.image.ico::*
	)

	// IconEntry describes one image of an icon (ICO) or cursor (CUR) file.
	struct IconEntry {
		// Its position among `entries()`, from 0: what `at` names in the
		// methods that read or edit one entry.
		index    int
		// Pixel width as stored.
		width    int
		// Pixel height as stored.
		height   int
		// Bits per pixel as stored: 1, 4, 8, 24 or 32.
		bitDepth int
		// Whether the image is stored as an embedded PNG rather than a bitmap.
		png      bool
		// The click point of a cursor, in pixels from the top-left corner; 0
		// in icons.
		hotspotX int
		// The click point's row.
		hotspotY int
	}

	// IndexedPixels is a paletted entry (1, 4 or 8 bits) as stored: every
	// colour of its palette in file order, the unused ones too; one palette
	// index per pixel, row by row from the top left; and whether the mask
	// hides each pixel. What an editor of icons reads and writes back without
	// losing the palette or the depth.
	struct IndexedPixels {
		width       int
		height      int
		palette     color.Palette
		indices     byte[]
		transparent bool[]
	}

	// ICO is the Windows icon codec. An icon holds the same picture at several
	// sizes and depths, each a bitmap (1, 4, 8, 24 or 32 bits with a
	// transparency mask) or an embedded PNG.
	//
	// `decode` returns the largest entry and keeps them all: `entries()` and
	// `sizes()` list them, `image(size)` renders one, `add` appends another,
	// and `encode(writer)` writes the whole set back, unchanged entries
	// byte for byte. An editor works on one entry at a time by its position:
	// `indexed(at)` reads a paletted entry's palette, indices and mask,
	// `replace(at, …)` rewrites an entry at its own depth, `remove(at)` drops
	// one, and `add(pixels)` appends a paletted one.
	//
	// ```adm
	// let ico = new ICO()
	// let big = try ico.decode(data)
	// let small = try ico.image(16)
	// ico.add(try ico.image(20))
	// let pixels = try ico.indexed(0)
	// pixels.indices[3] = 1
	// try ico.replace(0, pixels)
	// try ico.encode(writer)
	// ```
	@codec("Icon")
	type ICO {
		// The sizes `encode(img, writer)` writes, each scaled down from the
		// image and fitted to a square of that side. Empty (the default)
		// writes the image at its own size, scaled down to 256 when larger.
		// `int[16, 24, 32, 48, 64, 128, 256]` is the usual set.
		encodeSizes int[]

		internal set = new IconSet()

		mimeType string[] {
			def get() string[] {
				return string["image/x-icon", "image/vnd.microsoft.icon"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ico"]
			}
		}

		// matchSignature reports whether the reader starts with an icon
		// directory.
		def matchSignature(r io.Reader) bool {
			return icoMatch(r, 1)
		}

		// info reads the size of the largest entry from the bytes. Fails when
		// they are not an icon.
		def info(data byte[]) !ImageInfo {
			let s = new IconSet()
			try s.load(data)
			return s.info()
		}

		// info reads the size of the largest entry from the reader. Fails when
		// the data is not an icon, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads an icon from the bytes and returns its largest entry,
		// the deepest among equal sizes; the codec keeps every entry. Also
		// reads cursor files, whose hotspots it ignores. Fails when the bytes
		// are not an icon, or that entry cannot be decoded.
		def decode(data byte[]) !Image {
			let s = new IconSet()
			try s.load(data)
			set = s
			return s.render(s.best())
		}

		// decode reads an icon from the reader; see `decode(data)`. Fails when
		// the data is not an icon, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// entries describes the entries the codec holds, in file order.
		def entries() IconEntry[] {
			return set.entries()
		}

		// sizes lists the distinct entry sizes (the larger side), smallest
		// first.
		def sizes() int[] {
			return set.sizes()
		}

		// image renders the icon at `size` pixels (the larger side): the entry
		// of that size, the deepest when several are; else the smallest
		// larger entry scaled down; else the largest entry scaled up. Fails
		// when the codec holds no entry, or the entry cannot be decoded.
		def image(size int) !Image {
			return set.pick(size)
		}

		// image decodes the entry `entries()` described: the one at its
		// `index` when that is it, else the first that matches. Fails when the
		// codec holds no such entry, or it cannot be decoded.
		def image(entry IconEntry) !Image {
			return set.find(entry)
		}

		// indexed reads the entry at `at` as stored: its palette in file
		// order, one index per pixel and the mask. Fails when there is no such
		// entry, or it is not paletted (24 or 32 bits, or a PNG).
		def indexed(at int) !IndexedPixels {
			return set.indexed(at)
		}

		// add appends the image as a new entry, scaled down to fit 256 x 256
		// when larger.
		def add(img Image) {
			set.add(img, 0, 0)
		}

		// add appends paletted pixels as a new entry of `bitDepth` bits (1, 4
		// or 8), or of the fewest that hold the palette when 0. Fails when the
		// pixels do not agree with each other (a size over 256, an index past
		// the palette, a palette too large for the depth).
		def add(pixels IndexedPixels, bitDepth int = 0) !none {
			return set.addIndexed(pixels, 0, 0, bitDepth)
		}

		// replace rewrites the entry at `at` with the image, at the entry's own
		// depth: a PNG entry stays a PNG, a 32-bit one 32 bits, a 24-bit one
		// 24 bits with the mask from the image's transparency, and a paletted
		// one keeps its palette and depth, each pixel taking the nearest
		// colour. Fails when there is no such entry, or the image is wider or
		// taller than 256.
		def replace(at int, img Image) !none {
			return set.replace(at, img)
		}

		// replace rewrites the entry at `at` with paletted pixels, in the
		// palette's order: at the entry's depth when it is paletted and holds
		// the palette, else at the fewest bits that do. Fails when there is no
		// such entry, or the pixels do not agree with each other.
		def replace(at int, pixels IndexedPixels) !none {
			return set.replaceIndexed(at, pixels)
		}

		// remove drops the entry at `at`. Fails when there is none.
		def remove(at int) !none {
			return set.remove(at)
		}

		// clear drops every entry.
		def clear() {
			set = new IconSet()
		}

		// encode writes every entry the codec holds as an icon. Fails when it
		// holds none, or the writer fails.
		def encode(writer io.Writer) !none {
			return set.write(writer, 1)
		}

		// encode renders every entry the codec holds as an icon. Fails when
		// it holds none.
		def encode() !byte[] {
			return set.bytes(1)
		}

		// encode renders the image as an icon; see `encode(img, writer)`. Fails
		// when encoding does.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as an icon of one entry, or of one entry per
		// size in `encodeSizes`, leaving the entries the codec holds alone.
		// Fails with the writer's error.
		def encode(img Image, writer io.Writer) !none {
			let s = new IconSet()
			if encodeSizes.len() == 0 {
				s.add(img, 0, 0)
			} else {
				let w = int(img.size().width)
				let h = int(img.size().height)
				for let (_, side) in encodeSizes {
					let (fw, fh) = icoFit(w, h, side.clamp(1, icoMaxSide))
					s.add(icoResize(img, fw, fh), 0, 0)
				}
			}
			return s.write(writer, 1)
		}
	}
}

internal partial module std.formats.image.ico {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.gfx.processing.transform
		std.formats.image.png::*
		std.formats.image::*
	)

	// The largest side an icon or cursor entry can have.
	const icoMaxSide = 256

	// One entry of an icon set: what it is, its bytes as stored, and the
	// pixels once decoded.
	type IconSlot {
		entry IconEntry
		data  byte[]
		image ?Image
	}

	def icoU16(b byte[], o int) int {
		return int(b[o]) | int(b[o + 1]) << 8
	}

	def icoU32(b byte[], o int) int {
		return int(b[o]) | int(b[o + 1]) << 8 | int(b[o + 2]) << 16 | int(b[o + 3]) << 24
	}

	def icoI32(b byte[], o int) int {
		let v = icoU32(b, o)
		return v - 0x100000000 when v >= 0x80000000
		return v
	}

	def icoPut16(b byte[], o int, v int) {
		b[o] = byte(v & 0xFF)
		b[o + 1] = byte((v >> 8) & 0xFF)
	}

	def icoPut32(b byte[], o int, v int) {
		b[o] = byte(v & 0xFF)
		b[o + 1] = byte((v >> 8) & 0xFF)
		b[o + 2] = byte((v >> 16) & 0xFF)
		b[o + 3] = byte((v >> 24) & 0xFF)
	}

	// Whether the bytes at `o` start a PNG stream.
	def icoIsPNG(b byte[], o int, n int) bool {
		return false when n < 8
		for let i = 0; i < 8; i++ {
			return false when b[o + i] != pngSignature[i]
		}
		return true
	}

	// Whether the reader starts with an icon directory of the given resource
	// type (1 icon, 2 cursor).
	def icoMatch(r io.Reader, kind int) bool {
		let b byte[]
		b.len(22)
		let n = r.read(b) onerror recover 0
		return false when n != 22
		return false when icoU16(b, 0) != 0 || icoU16(b, 2) != kind || icoU16(b, 4) == 0
		return false when b[9] != byte(0)
		return false when kind == 1 && icoU16(b, 10) > 1
		return icoU32(b, 14) > 0 && icoU32(b, 18) >= 22
	}

	// A copy of the image scaled to `w` x `h` by area averaging, which keeps
	// small icons from aliasing.
	def icoResize(src Image, w int, h int) Image {
		let out = src.copy()
		transform.resize(out, new geom.Size<uint>(uint(w), uint(h)), transform.ResizeMode.Area)
		return out
	}

	// The dimensions that fit `w` x `h` inside a `side` x `side` square,
	// keeping the aspect ratio.
	def icoFit(w int, h int, side int) (int, int) {
		return (side, side) when w <= 0 || h <= 0
		return (side, ((h * side + w / 2) / w).max(1)) when w >= h
		return (((w * side + h / 2) / h).max(1), side)
	}

	// The fewest bits a palette of `colors` entries is stored at: 1, 4 or 8.
	def icoFitDepth(colors int) int {
		return 1 when colors <= 2
		return 4 when colors <= 16
		return 8
	}

	// Fails when paletted pixels do not agree with each other or with a
	// depth of `bpp` bits.
	def icoCheckIndexed(p IndexedPixels, bpp int) !none {
		expects {
			assert bpp := 1 || 4 || 8 onerror fail "ico: a paletted entry is 1, 4 or 8 bits, not {bpp}"
			assert p.width > 0 && p.height > 0 && p.width <= icoMaxSide && p.height <= icoMaxSide onerror fail "ico: invalid bitmap size {p.width}x{p.height}"
		}
		let colors = p.palette.colors.len()
		fail "ico: a palette of {colors} colours does not fit {bpp} bits" when colors > 1 << bpp
		fail "ico: {p.indices.len()} indices for {p.width}x{p.height} pixels" when p.indices.len() != p.width * p.height
		fail "ico: {p.transparent.len()} mask bits for {p.width}x{p.height} pixels" when p.transparent.len() != p.width * p.height
		for let (_, i) in p.indices {
			fail "ico: index {int(i)} past a palette of {colors} colours" when int(i) >= colors
		}
	}

	// Decodes a paletted bitmap as icons store it into its palette, indices
	// and mask; `at` names the entry in the failure.
	def icoDecodeIndexed(data byte[], at int) !IndexedPixels {
		expects {
			assert data.len() >= 40 && !icoIsPNG(data, 0, data.len()) onerror fail "ico: entry {at} has no palette"
		}
		let hs = icoU32(data, 0)
		fail "ico: unsupported bitmap header size {hs}" when hs < 40 || hs > data.len()
		let w = icoI32(data, 4)
		let hRaw = icoI32(data, 8)
		let topDown = hRaw < 0
		let h = (topDown ?? (-hRaw, hRaw)) / 2
		fail "ico: invalid bitmap size {w}x{h}" when w <= 0 || h <= 0 || w > 4096 || h > 4096
		let bpp = icoU16(data, 14)
		fail "ico: entry {at} has no palette" unless bpp := 1 || 4 || 8
		fail "ico: compressed bitmaps are not supported" when icoU32(data, 16) != 0
		let used = icoU32(data, 32)
		let colors = used
		colors = 1 << bpp when used == 0 || used > 1 << bpp
		let pal = hs
		let pix = pal + colors * 4
		let xorStride = ((w * bpp + 31) / 32) * 4
		let andStride = ((w + 31) / 32) * 4
		fail "ico: truncated bitmap" when pix + xorStride * h > data.len()
		let mask = pix + xorStride * h
		let hasMask = mask + andStride * h <= data.len()
		let out = IndexedPixels{width: w, height: h, palette: new color.Palette(colors)}
		for let i = 0; i < colors; i++ {
			let c = pal + i * 4
			out.palette.colors[i] = new color.Color(color.RGBA{r: data[c + 2], g: data[c + 1], b: data[c], a: 255})
		}
		out.indices.len(w * h)
		out.transparent.len(w * h)
		let perByte = 8 / bpp
		let bitMask = (1 << bpp) - 1
		for let r = 0; r < h; r++ {
			let y = topDown ?? (r, h - 1 - r)
			let s = pix + r * xorStride
			let m = mask + r * andStride
			for let x = 0; x < w; x++ {
				let v = int(data[s + x / perByte])
				let shift = 8 - bpp * (x % perByte + 1)
				out.indices[y * w + x] = byte((v >> shift) & bitMask)
				out.transparent[y * w + x] = hasMask && (int(data[m + x / 8]) >> (7 - x % 8)) & 1 == 1
			}
		}
		return out
	}

	// Encodes paletted pixels as a bitmap of `bpp` bits: the header, the
	// palette in its order, the index rows and the mask rows, both bottom-up.
	def icoEncodeIndexedDIB(p IndexedPixels, bpp int) byte[] {
		let (w, h) = (p.width, p.height)
		let colors = p.palette.colors.len()
		let xorStride = ((w * bpp + 31) / 32) * 4
		let andStride = ((w + 31) / 32) * 4
		let pix = 40 + colors * 4
		let out byte[]
		out.len(pix + (xorStride + andStride) * h)
		icoPut32(out, 0, 40)
		icoPut32(out, 4, w)
		icoPut32(out, 8, h * 2)
		icoPut16(out, 12, 1)
		icoPut16(out, 14, bpp)
		icoPut32(out, 20, (xorStride + andStride) * h)
		icoPut32(out, 32, colors)
		for let (i, c) in p.palette.colors {
			let o = 40 + i * 4
			out[o] = c.blue
			out[o + 1] = c.green
			out[o + 2] = c.red
		}
		let perByte = 8 / bpp
		let mask = pix + xorStride * h
		for let r = 0; r < h; r++ {
			let y = h - 1 - r
			let d = pix + r * xorStride
			let m = mask + r * andStride
			for let x = 0; x < w; x++ {
				let i = y * w + x
				let shift = 8 - bpp * (x % perByte + 1)
				out[d + x / perByte] = out[d + x / perByte] | byte((int(p.indices[i]) << shift) & 0xFF)
				out[m + x / 8] = out[m + x / 8] | byte(0x80 >> (x % 8)) when p.transparent[i]
			}
		}
		return out
	}

	// The image as paletted pixels over `palette`: each pixel the nearest
	// colour, hidden where its alpha is 0.
	def icoQuantize(img Image, palette color.Palette) IndexedPixels {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let out = IndexedPixels{width: w, height: h, palette: palette}
		out.indices.len(w * h)
		out.transparent.len(w * h)
		let px = img.raw()
		let stride = img.stride()
		// Each distinct colour is matched once.
		let found = map<int, int>{}
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let p = y * stride + x * 4
				let i = y * w + x
				out.transparent[i] = px[p + 3] == byte(0)
				let key = int(px[p]) << 16 | int(px[p + 1]) << 8 | int(px[p + 2])
				if !found.hasKey(key) {
					let near = palette.nearestIndex(new color.Color(color.RGBA{r: px[p], g: px[p + 1], b: px[p + 2], a: 255}))
					found[key] = near.max(0)
				}
				out.indices[i] = byte(found[key])
			}
		}
		return out
	}

	// Encodes an image as a 24-bit bitmap with its transparency mask: the
	// pixels whose alpha is 0 are hidden.
	def icoEncodeDIB24(img Image) byte[] {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let xorStride = ((w * 24 + 31) / 32) * 4
		let andStride = ((w + 31) / 32) * 4
		let out byte[]
		out.len(40 + (xorStride + andStride) * h)
		icoPut32(out, 0, 40)
		icoPut32(out, 4, w)
		icoPut32(out, 8, h * 2)
		icoPut16(out, 12, 1)
		icoPut16(out, 14, 24)
		icoPut32(out, 20, (xorStride + andStride) * h)
		let px = img.raw()
		let stride = img.stride()
		let mask = 40 + xorStride * h
		for let r = 0; r < h; r++ {
			let s = (h - 1 - r) * stride
			let d = 40 + r * xorStride
			let m = mask + r * andStride
			for let x = 0; x < w; x++ {
				let p = s + x * 4
				let o = d + x * 3
				out[o] = px[p + 2]
				out[o + 1] = px[p + 1]
				out[o + 2] = px[p]
				out[m + x / 8] = out[m + x / 8] | byte(0x80 >> (x % 8)) when px[p + 3] == byte(0)
			}
		}
		return out
	}

	// Decodes a device-independent bitmap as icons store it: the colour
	// (XOR) rows over the 1-bit transparency (AND) mask, the header's
	// height counting both.
	def icoDecodeDIB(data byte[], off int, n int) !Image {
		expects {
			assert n >= 40 onerror fail "ico: truncated bitmap header"
		}
		let hs = icoU32(data, off)
		fail "ico: unsupported bitmap header size {hs}" when hs < 40 || hs > n
		let w = icoI32(data, off + 4)
		let hRaw = icoI32(data, off + 8)
		let topDown = hRaw < 0
		let h = (topDown ?? (-hRaw, hRaw)) / 2
		fail "ico: invalid bitmap size {w}x{h}" when w <= 0 || h <= 0 || w > 4096 || h > 4096
		let bpp = icoU16(data, off + 14)
		let comp = icoU32(data, off + 16)
		fail "ico: unsupported bit depth {bpp}" unless bpp := 1 || 4 || 8 || 24 || 32
		fail "ico: compressed bitmaps are not supported" when comp != 0
		let used = icoU32(data, off + 32)
		let colors = used
		if bpp <= 8 {
			colors = 1 << bpp when used == 0 || used > 1 << bpp
		}
		let pal = off + hs
		let pix = pal + colors * 4
		let xorStride = ((w * bpp + 31) / 32) * 4
		let andStride = ((w + 31) / 32) * 4
		let end = off + n
		fail "ico: truncated bitmap" when pix + xorStride * h > end
		let mask = pix + xorStride * h
		let hasMask = mask + andStride * h <= end

		let img = new Image(w, h)
		let px = img.raw()
		let stride = img.stride()
		let anyAlpha = false
		for let r = 0; r < h; r++ {
			let dy = topDown ?? (r, h - 1 - r)
			let s = pix + r * xorStride
			let d = dy * stride
			match bpp {
				case 32:
					for let x = 0; x < w; x++ {
						let o = s + x * 4
						let p = d + x * 4
						px[p] = data[o + 2]
						px[p + 1] = data[o + 1]
						px[p + 2] = data[o]
						px[p + 3] = data[o + 3]
						anyAlpha = true when data[o + 3] != byte(0)
					}
				case 24:
					for let x = 0; x < w; x++ {
						let o = s + x * 3
						let p = d + x * 4
						px[p] = data[o + 2]
						px[p + 1] = data[o + 1]
						px[p + 2] = data[o]
						px[p + 3] = byte(255)
					}
				default:
					let perByte = 8 / bpp
					let bitMask = (1 << bpp) - 1
					for let x = 0; x < w; x++ {
						let v = int(data[s + x / perByte])
						let shift = 8 - bpp * (x % perByte + 1)
						let idx = (v >> shift) & bitMask
						let p = d + x * 4
						if idx < colors {
							let c = pal + idx * 4
							px[p] = data[c + 2]
							px[p + 1] = data[c + 1]
							px[p + 2] = data[c]
						}
						px[p + 3] = byte(255)
					}
			}
		}

		return img when bpp == 32 && anyAlpha
		if bpp == 32 {
			// No alpha at all: the mask alone says what shows.
			for let i = 3; i < px.len(); i += 4 {
				px[i] = byte(255)
			}
		}
		return img unless hasMask
		for let r = 0; r < h; r++ {
			let dy = topDown ?? (r, h - 1 - r)
			let s = mask + r * andStride
			let d = dy * stride
			for let x = 0; x < w; x++ {
				continue when (int(data[s + x / 8]) >> (7 - x % 8)) & 1 == 0
				px[d + x * 4 + 3] = byte(0)
			}
		}
		return img
	}

	// Encodes an image as a 32-bit bitmap with its transparency mask, the
	// form every icon reader understands.
	def icoEncodeDIB(img Image) byte[] {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let xorStride = w * 4
		let andStride = ((w + 31) / 32) * 4
		let out byte[]
		out.len(40 + (xorStride + andStride) * h)
		icoPut32(out, 0, 40)
		icoPut32(out, 4, w)
		icoPut32(out, 8, h * 2)
		icoPut16(out, 12, 1)
		icoPut16(out, 14, 32)
		icoPut32(out, 20, (xorStride + andStride) * h)
		let px = img.raw()
		let stride = img.stride()
		let mask = 40 + xorStride * h
		for let r = 0; r < h; r++ {
			let s = (h - 1 - r) * stride
			let d = 40 + r * xorStride
			let m = mask + r * andStride
			for let x = 0; x < w; x++ {
				let p = s + x * 4
				let o = d + x * 4
				out[o] = px[p + 2]
				out[o + 1] = px[p + 1]
				out[o + 2] = px[p]
				out[o + 3] = px[p + 3]
				out[m + x / 8] = out[m + x / 8] | byte(0x80 >> (x % 8)) when px[p + 3] == byte(0)
			}
		}
		return out
	}

	// IconSet is the directory of an icon or cursor file: the part ICO, CUR
	// and each ANI frame share.
	type IconSet {
		slots   IconSlot[]
		// Whether an entry was added, replaced, removed or given another
		// hotspot since the set was loaded: a set that was not can be written
		// back from the bytes it came from.
		changed bool       = false

		// Reads the directory and keeps each entry's bytes; the pixels are
		// decoded on demand. Returns the resource type, 1 icon or 2 cursor.
		def load(data byte[]) !int {
			expects {
				assert data.len() >= 6 onerror fail "ico: truncated header"
			}
			let kind = icoU16(data, 2)
			fail "ico: not an icon or cursor file" when icoU16(data, 0) != 0 || (kind != 1 && kind != 2)
			let count = icoU16(data, 4)
			fail "ico: no images" when count == 0
			fail "ico: truncated directory" when 6 + count * 16 > data.len()
			let found IconSlot[]
			for let i = 0; i < count; i++ {
				let e = 6 + i * 16
				let size = icoU32(data, e + 8)
				let off = icoU32(data, e + 12)
				fail "ico: entry {i} lies outside the file" when size <= 0 || off < 6 + count * 16 || off + size > data.len()
				let entry = IconEntry{}
				if icoIsPNG(data, off, size) {
					fail "ico: truncated PNG entry {i}" when size < 33
					entry.png = true
					entry.width = int(data[off + 16]) << 24 | int(data[off + 17]) << 16 | int(data[off + 18]) << 8 | int(data[off + 19])
					entry.height = int(data[off + 20]) << 24 | int(data[off + 21]) << 16 | int(data[off + 22]) << 8 | int(data[off + 23])
					let channels = pngChannels(int(data[off + 25]))
					entry.bitDepth = channels * int(data[off + 24])
				} else {
					fail "ico: truncated bitmap header in entry {i}" when size < 40
					entry.width = icoI32(data, off + 4)
					let hRaw = icoI32(data, off + 8)
					entry.height = (hRaw < 0 ?? (-hRaw, hRaw)) / 2
					entry.bitDepth = icoU16(data, off + 14)
				}
				if kind == 2 {
					entry.hotspotX = icoU16(data, e + 4)
					entry.hotspotY = icoU16(data, e + 6)
				}
				let slot = new IconSlot()
				slot.entry = entry
				slot.data = data[off:off + size]
				found.push(slot)
			}
			slots = found
			return kind
		}

		// The index of the largest entry, the deepest among equals.
		def best() int {
			let pick = 0
			for let i = 1; i < slots.len(); i++ {
				let a = slots[i].entry
				let b = slots[pick].entry
				let areaA = a.width * a.height
				let areaB = b.width * b.height
				pick = i when areaA > areaB || (areaA == areaB && a.bitDepth > b.bitDepth)
			}
			return pick
		}

		// Decodes entry `i`, once.
		def render(i int) !Image {
			let slot = slots[i]
			if slot.image is none {
				let data = slot.data
				if slot.entry.png {
					slot.image = try new PNG().decode(data)
				} else {
					slot.image = try icoDecodeDIB(data, 0, data.len())
				}
			}
			let img = slot.image
			fail "ico: entry {i} did not decode" when img is none
			return img
		}

		// The entry of `size` pixels (the larger side), else the smallest
		// larger one scaled down, else the largest scaled up.
		def pick(size int) !Image {
			fail "ico: no images" when slots.len() == 0
			fail "ico: invalid size {size}" when size <= 0
			let exact = -1
			let above = -1
			let below = -1
			for let (i, slot) in slots {
				let side = slot.entry.width.max(slot.entry.height)
				if side == size {
					exact = i when deeperOrCloser(i, exact, true)
				} else if side > size {
					above = i when deeperOrCloser(i, above, true)
				} else {
					below = i when deeperOrCloser(i, below, false)
				}
			}
			return try render(exact) when exact >= 0
			let from = above >= 0 ?? (above, below)
			let src = try render(from)
			let (w, h) = icoFit(int(src.size().width), int(src.size().height), size)
			return icoResize(src, w, h)
		}

		// Whether entry `i` beats entry `j` (-1 for none yet): a smaller side
		// when `smaller`, else a larger one; the deeper of equal sides.
		def deeperOrCloser(i int, j int, smaller bool) bool {
			return true when j < 0
			let a = slots[i].entry
			let b = slots[j].entry
			let sa = a.width.max(a.height)
			let sb = b.width.max(b.height)
			return a.bitDepth > b.bitDepth when sa == sb
			return smaller ?? (sa < sb, sa > sb)
		}

		// Whether two descriptions name the same kind of entry, wherever it is.
		def alike(a IconEntry, b IconEntry) bool {
			return a.width == b.width && a.height == b.height && a.bitDepth == b.bitDepth && a.png == b.png && a.hotspotX == b.hotspotX && a.hotspotY == b.hotspotY
		}

		// The entry described by `entry`: the one at its `index` when that is
		// it (two entries can be alike), else the first alike.
		def find(entry IconEntry) !Image {
			let at = entry.index
			return render(at) when at >= 0 && at < slots.len() && alike(slots[at].entry, entry)
			for let (i, slot) in slots {
				return render(i) when alike(slot.entry, entry)
			}
			fail "ico: no {entry.width}x{entry.height} {entry.bitDepth}-bit entry"
		}

		// The entry at `at`. Fails when there is none.
		def slotAt(at int) !IconSlot {
			expects {
				assert at >= 0 && at < slots.len() onerror fail "ico: no entry {at} among {slots.len()}"
			}
			return slots[at]
		}

		// The entry at `at` as stored: palette, indices and mask.
		def indexed(at int) !IndexedPixels {
			let slot = try slotAt(at)
			fail "ico: entry {at} has no palette" when slot.entry.png
			return icoDecodeIndexed(slot.data, at)
		}

		// Rewrites the entry at `at` with the image at the entry's own depth.
		def replace(at int, img Image) !none {
			let slot = try slotAt(at)
			let e = slot.entry
			let w = int(img.size().width)
			let h = int(img.size().height)
			fail "ico: invalid bitmap size {w}x{h}" when w <= 0 || h <= 0 || w > icoMaxSide || h > icoMaxSide
			if e.png {
				slot.data = try new PNG().encode(img)
			} else if e.bitDepth <= 8 {
				let stored = try icoDecodeIndexed(slot.data, at)
				slot.data = icoEncodeIndexedDIB(icoQuantize(img, stored.palette), e.bitDepth)
			} else if e.bitDepth == 24 {
				slot.data = icoEncodeDIB24(img)
			} else {
				slot.data = icoEncodeDIB(img)
			}
			slot.entry = IconEntry{...e, width: w, height: h}
			slot.image = img.copy()
			changed = true
		}

		// Rewrites the entry at `at` with paletted pixels: at the entry's
		// depth when it is paletted and holds the palette, else at the fewest
		// bits that do.
		def replaceIndexed(at int, p IndexedPixels) !none {
			let slot = try slotAt(at)
			let e = slot.entry
			let fit = icoFitDepth(p.palette.colors.len())
			let bpp = !e.png && e.bitDepth <= 8 && e.bitDepth >= fit ?? (e.bitDepth, fit)
			try icoCheckIndexed(p, bpp)
			slot.data = icoEncodeIndexedDIB(p, bpp)
			slot.entry = IconEntry{...e, width: p.width, height: p.height, bitDepth: bpp, png: false}
			slot.image = none
			changed = true
		}

		// Drops the entry at `at`.
		def remove(at int) !none {
			let _ = try slotAt(at)
			slots.remove(at)
			changed = true
		}

		// Adds paletted pixels as a new entry of `bpp` bits, or of the fewest
		// that hold the palette when `bpp` is 0.
		def addIndexed(p IndexedPixels, hotspotX int, hotspotY int, bpp int) !none {
			let depth = bpp == 0 ?? (icoFitDepth(p.palette.colors.len()), bpp)
			try icoCheckIndexed(p, depth)
			let slot = new IconSlot()
			slot.entry = IconEntry{width: p.width, height: p.height, bitDepth: depth, hotspotX: hotspotX, hotspotY: hotspotY}
			slot.data = icoEncodeIndexedDIB(p, depth)
			slots.push(slot)
			changed = true
		}

		// Gives the entry at `at` the click point (`x`, `y`), a pixel of it.
		def setHotspot(at int, x int, y int) !none {
			let slot = try slotAt(at)
			let e = slot.entry
			fail "ico: hotspot ({x}, {y}) is outside the {e.width}x{e.height} entry" when x < 0 || y < 0 || x >= e.width || y >= e.height
			slot.entry = IconEntry{...e, hotspotX: x, hotspotY: y}
			changed = true
		}

		// Adds an image as a new entry, scaled down to fit 256 x 256 when
		// larger. 256-pixel entries are stored as PNG when a PNG encoder is
		// available, the rest as 32-bit bitmaps.
		def add(img Image, hotspotX int, hotspotY int) {
			let w = int(img.size().width)
			let h = int(img.size().height)
			let src = img
			let hx = hotspotX
			let hy = hotspotY
			if w > icoMaxSide || h > icoMaxSide {
				let (fw, fh) = icoFit(w, h, icoMaxSide)
				src = icoResize(img, fw, fh)
				hx = hotspotX * fw / w
				hy = hotspotY * fh / h
				w, h = fw, fh
			}
			let slot = new IconSlot()
			slot.entry = IconEntry{width: w, height: h, bitDepth: 32, hotspotX: hx, hotspotY: hy}
			slot.image = src
			if w.max(h) == icoMaxSide {
				slot.data = new PNG().encode(src) onerror recover []
				slot.entry.png = slot.data.len() > 0
			}
			slot.data = icoEncodeDIB(src) when slot.data.len() == 0
			slots.push(slot)
			changed = true
		}

		// The entries in file order, each with its position.
		def entries() IconEntry[] {
			let out IconEntry[]
			for let (i, slot) in slots {
				out.push(IconEntry{...slot.entry, index: i})
			}
			return out
		}

		// The distinct sizes (larger side), smallest first.
		def sizes() int[] {
			let out int[]
			for let (_, slot) in slots {
				let side = slot.entry.width.max(slot.entry.height)
				continue when out.includes(side)
				out.push(side)
			}
			return out.sort((a, b int) => a < b)
		}

		// Writes the directory and every entry, as an icon (kind 1) or a
		// cursor (kind 2). Fails with the writer's error, or when the set
		// is empty.
		def write(writer io.Writer, kind int) !none {
			fail "ico: no images to encode" when slots.len() == 0
			let count = slots.len()
			let head byte[]
			head.len(6 + count * 16)
			icoPut16(head, 2, kind)
			icoPut16(head, 4, count)
			let off = head.len()
			for let (i, slot) in slots {
				let e = slot.entry
				let d = 6 + i * 16
				head[d] = byte(e.width >= icoMaxSide ?? (0, e.width))
				head[d + 1] = byte(e.height >= icoMaxSide ?? (0, e.height))
				head[d + 2] = byte(e.bitDepth < 8 ?? (1 << e.bitDepth, 0))
				if kind == 2 {
					icoPut16(head, d + 4, e.hotspotX)
					icoPut16(head, d + 6, e.hotspotY)
				} else {
					icoPut16(head, d + 4, 1)
					icoPut16(head, d + 6, e.bitDepth)
				}
				icoPut32(head, d + 8, slot.data.len())
				icoPut32(head, d + 12, off)
				off += slot.data.len()
			}
			try writer.write(head)
			for let (_, slot) in slots {
				try writer.write(slot.data)
			}
		}

		// The file's bytes, as an icon (kind 1) or a cursor (kind 2).
		def bytes(kind int) !byte[] {
			let out = new bytes.Buffer()
			try write(out, kind)
			return out.bytes()
		}

		// What the headers say about the largest entry, and how many entries
		// there are.
		def info() ImageInfo {
			let e = slots[best()].entry
			return ImageInfo{
				size:        new geom.Size(float(e.width), float(e.height)),
				colorFormat: color.ColorFormat.RGBA,
				frames:      slots.len(),
			}
		}
	}
}
