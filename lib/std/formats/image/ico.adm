partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.formats.image.ico::*
	)

	// IconEntry describes one image of an icon (ICO) or cursor (CUR) file.
	struct IconEntry {
		// Pixel width as stored.
		width    int
		// Pixel height as stored.
		height   int
		// Bits per pixel as stored: 1, 4, 8, 24 or 32.
		bitDepth int
		// Whether the image is stored as an embedded PNG rather than a bitmap.
		png      bool
		// The click point of a cursor, in pixels from the top-left corner; 0
		// in icons.
		hotspotX int
		// The click point's row.
		hotspotY int
	}

	// ICO is the Windows icon codec. An icon holds the same picture at several
	// sizes and depths, each a bitmap (1, 4, 8, 24 or 32 bits with a
	// transparency mask) or an embedded PNG.
	//
	// `decode` returns the largest entry and keeps them all: `entries()` and
	// `sizes()` list them, `image(size)` renders one, `add` appends another,
	// and `encode(writer)` writes the whole set back, unchanged entries
	// byte for byte.
	//
	// ```adm
	// let ico = new ICO()
	// let big = try ico.decode(data)
	// let small = try ico.image(16)
	// ico.add(try ico.image(20))
	// try ico.encode(writer)
	// ```
	@codec("Icon")
	type ICO {
		// The sizes `encode(img, writer)` writes, each scaled down from the
		// image and fitted to a square of that side. Empty (the default)
		// writes the image at its own size, scaled down to 256 when larger.
		// `int[16, 24, 32, 48, 64, 128, 256]` is the usual set.
		encodeSizes int[]

		internal set = new IconSet()

		mimeType string[] {
			def get() string[] {
				return string["image/x-icon", "image/vnd.microsoft.icon"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ico"]
			}
		}

		// matchSignature reports whether the reader starts with an icon
		// directory.
		def matchSignature(r io.Reader) bool {
			return icoMatch(r, 1)
		}

		// info reads the size of the largest entry from the bytes. Fails when
		// they are not an icon.
		def info(data byte[]) !ImageInfo {
			let s = new IconSet()
			try s.load(data)
			return s.info()
		}

		// info reads the size of the largest entry from the reader. Fails when
		// the data is not an icon, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads an icon from the bytes and returns its largest entry,
		// the deepest among equal sizes; the codec keeps every entry. Also
		// reads cursor files, whose hotspots it ignores. Fails when the bytes
		// are not an icon, or that entry cannot be decoded.
		def decode(data byte[]) !Image {
			let s = new IconSet()
			try s.load(data)
			set = s
			return s.render(s.best())
		}

		// decode reads an icon from the reader; see `decode(data)`. Fails when
		// the data is not an icon, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// entries describes the entries the codec holds, in file order.
		def entries() IconEntry[] {
			return set.entries()
		}

		// sizes lists the distinct entry sizes (the larger side), smallest
		// first.
		def sizes() int[] {
			return set.sizes()
		}

		// image renders the icon at `size` pixels (the larger side): the entry
		// of that size, the deepest when several are; else the smallest
		// larger entry scaled down; else the largest entry scaled up. Fails
		// when the codec holds no entry, or the entry cannot be decoded.
		def image(size int) !Image {
			return set.pick(size)
		}

		// image decodes the entry `entries()` described. Fails when the codec
		// holds no such entry, or it cannot be decoded.
		def image(entry IconEntry) !Image {
			return set.find(entry)
		}

		// add appends the image as a new entry, scaled down to fit 256 x 256
		// when larger.
		def add(img Image) {
			set.add(img, 0, 0)
		}

		// clear drops every entry.
		def clear() {
			set = new IconSet()
		}

		// encode writes every entry the codec holds as an icon. Fails when it
		// holds none, or the writer fails.
		def encode(writer io.Writer) !none {
			return set.write(writer, 1)
		}

		// encode renders every entry the codec holds as an icon. Fails when
		// it holds none.
		def encode() !byte[] {
			return set.bytes(1)
		}

		// encode renders the image as an icon; see `encode(img, writer)`. Fails
		// when encoding does.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as an icon of one entry, or of one entry per
		// size in `encodeSizes`, leaving the entries the codec holds alone.
		// Fails with the writer's error.
		def encode(img Image, writer io.Writer) !none {
			let s = new IconSet()
			if encodeSizes.len() == 0 {
				s.add(img, 0, 0)
			} else {
				let w = int(img.size().width)
				let h = int(img.size().height)
				for let (_, side) in encodeSizes {
					let (fw, fh) = icoFit(w, h, side.clamp(1, icoMaxSide))
					s.add(icoResize(img, fw, fh), 0, 0)
				}
			}
			return s.write(writer, 1)
		}
	}
}

internal partial module std.formats.image.ico {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.gfx.processing.transform
		std.formats.image.png::*
		std.formats.image::*
	)

	// The largest side an icon or cursor entry can have.
	const icoMaxSide = 256

	// One entry of an icon set: what it is, its bytes as stored, and the
	// pixels once decoded.
	type IconSlot {
		entry IconEntry
		data  byte[]
		image ?Image
	}

	def icoU16(b byte[], o int) int {
		return int(b[o]) | int(b[o + 1]) << 8
	}

	def icoU32(b byte[], o int) int {
		return int(b[o]) | int(b[o + 1]) << 8 | int(b[o + 2]) << 16 | int(b[o + 3]) << 24
	}

	def icoI32(b byte[], o int) int {
		let v = icoU32(b, o)
		return v - 0x100000000 when v >= 0x80000000
		return v
	}

	def icoPut16(b byte[], o int, v int) {
		b[o] = byte(v & 0xFF)
		b[o + 1] = byte((v >> 8) & 0xFF)
	}

	def icoPut32(b byte[], o int, v int) {
		b[o] = byte(v & 0xFF)
		b[o + 1] = byte((v >> 8) & 0xFF)
		b[o + 2] = byte((v >> 16) & 0xFF)
		b[o + 3] = byte((v >> 24) & 0xFF)
	}

	// Whether the bytes at `o` start a PNG stream.
	def icoIsPNG(b byte[], o int, n int) bool {
		return false when n < 8
		for let i = 0; i < 8; i++ {
			return false when b[o + i] != pngSignature[i]
		}
		return true
	}

	// Whether the reader starts with an icon directory of the given resource
	// type (1 icon, 2 cursor).
	def icoMatch(r io.Reader, kind int) bool {
		let b byte[]
		b.len(22)
		let n = r.read(b) onerror recover 0
		return false when n != 22
		return false when icoU16(b, 0) != 0 || icoU16(b, 2) != kind || icoU16(b, 4) == 0
		return false when b[9] != byte(0)
		return false when kind == 1 && icoU16(b, 10) > 1
		return icoU32(b, 14) > 0 && icoU32(b, 18) >= 22
	}

	// A copy of the image scaled to `w` x `h` by area averaging, which keeps
	// small icons from aliasing.
	def icoResize(src Image, w int, h int) Image {
		let out = src.copy()
		transform.resize(out, new geom.Size<uint>(uint(w), uint(h)), transform.ResizeMode.Area)
		return out
	}

	// The dimensions that fit `w` x `h` inside a `side` x `side` square,
	// keeping the aspect ratio.
	def icoFit(w int, h int, side int) (int, int) {
		return (side, side) when w <= 0 || h <= 0
		return (side, ((h * side + w / 2) / w).max(1)) when w >= h
		return (((w * side + h / 2) / h).max(1), side)
	}

	// Decodes a device-independent bitmap as icons store it: the colour
	// (XOR) rows over the 1-bit transparency (AND) mask, the header's
	// height counting both.
	def icoDecodeDIB(data byte[], off int, n int) !Image {
		expects {
			assert n >= 40 onerror fail "ico: truncated bitmap header"
		}
		let hs = icoU32(data, off)
		fail "ico: unsupported bitmap header size {hs}" when hs < 40 || hs > n
		let w = icoI32(data, off + 4)
		let hRaw = icoI32(data, off + 8)
		let topDown = hRaw < 0
		let h = (topDown ?? (-hRaw, hRaw)) / 2
		fail "ico: invalid bitmap size {w}x{h}" when w <= 0 || h <= 0 || w > 4096 || h > 4096
		let bpp = icoU16(data, off + 14)
		let comp = icoU32(data, off + 16)
		fail "ico: unsupported bit depth {bpp}" unless bpp := 1 || 4 || 8 || 24 || 32
		fail "ico: compressed bitmaps are not supported" when comp != 0
		let used = icoU32(data, off + 32)
		let colors = used
		if bpp <= 8 {
			colors = 1 << bpp when used == 0 || used > 1 << bpp
		}
		let pal = off + hs
		let pix = pal + colors * 4
		let xorStride = ((w * bpp + 31) / 32) * 4
		let andStride = ((w + 31) / 32) * 4
		let end = off + n
		fail "ico: truncated bitmap" when pix + xorStride * h > end
		let mask = pix + xorStride * h
		let hasMask = mask + andStride * h <= end

		let img = new Image(w, h)
		let px = img.raw()
		let stride = img.stride()
		let anyAlpha = false
		for let r = 0; r < h; r++ {
			let dy = topDown ?? (r, h - 1 - r)
			let s = pix + r * xorStride
			let d = dy * stride
			match bpp {
				case 32:
					for let x = 0; x < w; x++ {
						let o = s + x * 4
						let p = d + x * 4
						px[p] = data[o + 2]
						px[p + 1] = data[o + 1]
						px[p + 2] = data[o]
						px[p + 3] = data[o + 3]
						anyAlpha = true when data[o + 3] != byte(0)
					}
				case 24:
					for let x = 0; x < w; x++ {
						let o = s + x * 3
						let p = d + x * 4
						px[p] = data[o + 2]
						px[p + 1] = data[o + 1]
						px[p + 2] = data[o]
						px[p + 3] = byte(255)
					}
				default:
					let perByte = 8 / bpp
					let bitMask = (1 << bpp) - 1
					for let x = 0; x < w; x++ {
						let v = int(data[s + x / perByte])
						let shift = 8 - bpp * (x % perByte + 1)
						let idx = (v >> shift) & bitMask
						let p = d + x * 4
						if idx < colors {
							let c = pal + idx * 4
							px[p] = data[c + 2]
							px[p + 1] = data[c + 1]
							px[p + 2] = data[c]
						}
						px[p + 3] = byte(255)
					}
			}
		}

		return img when bpp == 32 && anyAlpha
		if bpp == 32 {
			// No alpha at all: the mask alone says what shows.
			for let i = 3; i < px.len(); i += 4 {
				px[i] = byte(255)
			}
		}
		return img unless hasMask
		for let r = 0; r < h; r++ {
			let dy = topDown ?? (r, h - 1 - r)
			let s = mask + r * andStride
			let d = dy * stride
			for let x = 0; x < w; x++ {
				continue when (int(data[s + x / 8]) >> (7 - x % 8)) & 1 == 0
				px[d + x * 4 + 3] = byte(0)
			}
		}
		return img
	}

	// Encodes an image as a 32-bit bitmap with its transparency mask, the
	// form every icon reader understands.
	def icoEncodeDIB(img Image) byte[] {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let xorStride = w * 4
		let andStride = ((w + 31) / 32) * 4
		let out byte[]
		out.len(40 + (xorStride + andStride) * h)
		icoPut32(out, 0, 40)
		icoPut32(out, 4, w)
		icoPut32(out, 8, h * 2)
		icoPut16(out, 12, 1)
		icoPut16(out, 14, 32)
		icoPut32(out, 20, (xorStride + andStride) * h)
		let px = img.raw()
		let stride = img.stride()
		let mask = 40 + xorStride * h
		for let r = 0; r < h; r++ {
			let s = (h - 1 - r) * stride
			let d = 40 + r * xorStride
			let m = mask + r * andStride
			for let x = 0; x < w; x++ {
				let p = s + x * 4
				let o = d + x * 4
				out[o] = px[p + 2]
				out[o + 1] = px[p + 1]
				out[o + 2] = px[p]
				out[o + 3] = px[p + 3]
				out[m + x / 8] = out[m + x / 8] | byte(0x80 >> (x % 8)) when px[p + 3] == byte(0)
			}
		}
		return out
	}

	// IconSet is the directory of an icon or cursor file: the part ICO, CUR
	// and each ANI frame share.
	type IconSet {
		slots IconSlot[]

		// Reads the directory and keeps each entry's bytes; the pixels are
		// decoded on demand. Returns the resource type, 1 icon or 2 cursor.
		def load(data byte[]) !int {
			expects {
				assert data.len() >= 6 onerror fail "ico: truncated header"
			}
			let kind = icoU16(data, 2)
			fail "ico: not an icon or cursor file" when icoU16(data, 0) != 0 || (kind != 1 && kind != 2)
			let count = icoU16(data, 4)
			fail "ico: no images" when count == 0
			fail "ico: truncated directory" when 6 + count * 16 > data.len()
			let found IconSlot[]
			for let i = 0; i < count; i++ {
				let e = 6 + i * 16
				let size = icoU32(data, e + 8)
				let off = icoU32(data, e + 12)
				fail "ico: entry {i} lies outside the file" when size <= 0 || off < 6 + count * 16 || off + size > data.len()
				let entry = IconEntry{}
				if icoIsPNG(data, off, size) {
					fail "ico: truncated PNG entry {i}" when size < 33
					entry.png = true
					entry.width = int(data[off + 16]) << 24 | int(data[off + 17]) << 16 | int(data[off + 18]) << 8 | int(data[off + 19])
					entry.height = int(data[off + 20]) << 24 | int(data[off + 21]) << 16 | int(data[off + 22]) << 8 | int(data[off + 23])
					let channels = pngChannels(int(data[off + 25]))
					entry.bitDepth = channels * int(data[off + 24])
				} else {
					fail "ico: truncated bitmap header in entry {i}" when size < 40
					entry.width = icoI32(data, off + 4)
					let hRaw = icoI32(data, off + 8)
					entry.height = (hRaw < 0 ?? (-hRaw, hRaw)) / 2
					entry.bitDepth = icoU16(data, off + 14)
				}
				if kind == 2 {
					entry.hotspotX = icoU16(data, e + 4)
					entry.hotspotY = icoU16(data, e + 6)
				}
				let slot = new IconSlot()
				slot.entry = entry
				slot.data = data[off:off + size]
				found.push(slot)
			}
			slots = found
			return kind
		}

		// The index of the largest entry, the deepest among equals.
		def best() int {
			let pick = 0
			for let i = 1; i < slots.len(); i++ {
				let a = slots[i].entry
				let b = slots[pick].entry
				let areaA = a.width * a.height
				let areaB = b.width * b.height
				pick = i when areaA > areaB || (areaA == areaB && a.bitDepth > b.bitDepth)
			}
			return pick
		}

		// Decodes entry `i`, once.
		def render(i int) !Image {
			let slot = slots[i]
			if slot.image is none {
				let data = slot.data
				if slot.entry.png {
					slot.image = try new PNG().decode(data)
				} else {
					slot.image = try icoDecodeDIB(data, 0, data.len())
				}
			}
			let img = slot.image
			fail "ico: entry {i} did not decode" when img is none
			return img
		}

		// The entry of `size` pixels (the larger side), else the smallest
		// larger one scaled down, else the largest scaled up.
		def pick(size int) !Image {
			fail "ico: no images" when slots.len() == 0
			fail "ico: invalid size {size}" when size <= 0
			let exact = -1
			let above = -1
			let below = -1
			for let (i, slot) in slots {
				let side = slot.entry.width.max(slot.entry.height)
				if side == size {
					exact = i when deeperOrCloser(i, exact, true)
				} else if side > size {
					above = i when deeperOrCloser(i, above, true)
				} else {
					below = i when deeperOrCloser(i, below, false)
				}
			}
			return try render(exact) when exact >= 0
			let from = above >= 0 ?? (above, below)
			let src = try render(from)
			let (w, h) = icoFit(int(src.size().width), int(src.size().height), size)
			return icoResize(src, w, h)
		}

		// Whether entry `i` beats entry `j` (-1 for none yet): a smaller side
		// when `smaller`, else a larger one; the deeper of equal sides.
		def deeperOrCloser(i int, j int, smaller bool) bool {
			return true when j < 0
			let a = slots[i].entry
			let b = slots[j].entry
			let sa = a.width.max(a.height)
			let sb = b.width.max(b.height)
			return a.bitDepth > b.bitDepth when sa == sb
			return smaller ?? (sa < sb, sa > sb)
		}

		// The entry described by `entry`.
		def find(entry IconEntry) !Image {
			for let (i, slot) in slots {
				let e = slot.entry
				return render(i) when e.width == entry.width && e.height == entry.height && e.bitDepth == entry.bitDepth && e.png == entry.png && e.hotspotX == entry.hotspotX && e.hotspotY == entry.hotspotY
			}
			fail "ico: no {entry.width}x{entry.height} {entry.bitDepth}-bit entry"
		}

		// Adds an image as a new entry, scaled down to fit 256 x 256 when
		// larger. 256-pixel entries are stored as PNG when a PNG encoder is
		// available, the rest as 32-bit bitmaps.
		def add(img Image, hotspotX int, hotspotY int) {
			let w = int(img.size().width)
			let h = int(img.size().height)
			let src = img
			let hx = hotspotX
			let hy = hotspotY
			if w > icoMaxSide || h > icoMaxSide {
				let (fw, fh) = icoFit(w, h, icoMaxSide)
				src = icoResize(img, fw, fh)
				hx = hotspotX * fw / w
				hy = hotspotY * fh / h
				w, h = fw, fh
			}
			let slot = new IconSlot()
			slot.entry = IconEntry{width: w, height: h, bitDepth: 32, hotspotX: hx, hotspotY: hy}
			slot.image = src
			if w.max(h) == icoMaxSide {
				slot.data = new PNG().encode(src) onerror recover []
				slot.entry.png = slot.data.len() > 0
			}
			slot.data = icoEncodeDIB(src) when slot.data.len() == 0
			slots.push(slot)
		}

		def entries() IconEntry[] {
			let out IconEntry[]
			for let (_, slot) in slots {
				out.push(slot.entry)
			}
			return out
		}

		// The distinct sizes (larger side), smallest first.
		def sizes() int[] {
			let out int[]
			for let (_, slot) in slots {
				let side = slot.entry.width.max(slot.entry.height)
				continue when out.includes(side)
				out.push(side)
			}
			return out.sort((a, b int) => a < b)
		}

		// Writes the directory and every entry, as an icon (kind 1) or a
		// cursor (kind 2). Fails with the writer's error, or when the set
		// is empty.
		def write(writer io.Writer, kind int) !none {
			fail "ico: no images to encode" when slots.len() == 0
			let count = slots.len()
			let head byte[]
			head.len(6 + count * 16)
			icoPut16(head, 2, kind)
			icoPut16(head, 4, count)
			let off = head.len()
			for let (i, slot) in slots {
				let e = slot.entry
				let d = 6 + i * 16
				head[d] = byte(e.width >= icoMaxSide ?? (0, e.width))
				head[d + 1] = byte(e.height >= icoMaxSide ?? (0, e.height))
				head[d + 2] = byte(e.bitDepth < 8 ?? (1 << e.bitDepth, 0))
				if kind == 2 {
					icoPut16(head, d + 4, e.hotspotX)
					icoPut16(head, d + 6, e.hotspotY)
				} else {
					icoPut16(head, d + 4, 1)
					icoPut16(head, d + 6, e.bitDepth)
				}
				icoPut32(head, d + 8, slot.data.len())
				icoPut32(head, d + 12, off)
				off += slot.data.len()
			}
			try writer.write(head)
			for let (_, slot) in slots {
				try writer.write(slot.data)
			}
		}

		// The file's bytes, as an icon (kind 1) or a cursor (kind 2).
		def bytes(kind int) !byte[] {
			let out = new bytes.Buffer()
			try write(out, kind)
			return out.bytes()
		}

		// What the headers say about the largest entry.
		def info() ImageInfo {
			let e = slots[best()].entry
			return ImageInfo{
				size: new geom.Size(float(e.width), float(e.height)),
				colorFormat: color.ColorFormat.RGBA,
			}
		}
	}
}
