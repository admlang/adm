partial module std.formats.image {
	use (
		std.testing
		std.bytes
	)

	check "ICO" {
		internal def assertPixel(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			assert int(img.raw()[o]) == r
			assert int(img.raw()[o + 1]) == g
			assert int(img.raw()[o + 2]) == b
			assert int(img.raw()[o + 3]) == a
		}

		// Every pixel differs from its neighbours; the alpha varies too.
		internal def pattern(w int, h int) Image {
			let img = new Image(w, h)
			let px = img.raw()
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					let o = img.pixelOffset(x, y)
					px[o] = byte(x % 256)
					px[o + 1] = byte(y % 256)
					px[o + 2] = byte((x * 7 + y * 13) % 256)
					px[o + 3] = byte((x + y) % 3 == 0 ?? (0, 255))
				}
			}
			return img
		}

		internal def le32(v int) byte[] {
			return byte[byte(v & 255), byte((v >> 8) & 255), byte((v >> 16) & 255), byte((v >> 24) & 255)]
		}

		internal def join(parts byte[][]) byte[] {
			let out byte[]
			for let (_, p) in parts {
				for let (_, b) in p {
					out.push(b)
				}
			}
			return out
		}

		// A bitmap entry: header, palette, colour rows and mask rows, both
		// bottom-up.
		internal def dib(w int, h int, bpp int, palette byte[], xor byte[], mask byte[]) byte[] {
			let head = join(byte[][
				le32(40), le32(w), le32(h * 2),
				byte[1, 0, byte(bpp), 0],
				le32(0), le32(xor.len() + mask.len()), le32(0), le32(0), le32(0), le32(0)
			])
			return join(byte[][head, palette, xor, mask])
		}

		// An icon file holding the entries.
		internal def iconFile(kind int, entries byte[][], sizes int[]) byte[] {
			let head = byte[0, 0, byte(kind), 0, byte(entries.len()), 0]
			let off = 6 + entries.len() * 16
			let parts byte[][]
			parts.push(head)
			for let (i, e) in entries {
				let s = sizes[i]
				parts.push(join(byte[][byte[byte(s), byte(s), 0, 0, 1, 0, 32, 0], le32(e.len()), le32(off)]))
				off += e.len()
			}
			for let (_, e) in entries {
				parts.push(e)
			}
			return join(parts)
		}

		// 8x8 red-to-blue gradient, truecolour PNG.
		internal def gradientPNG() byte[] {
			return byte[
				137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
				0, 0, 0, 8, 0, 0, 0, 8, 8, 2, 0, 0, 0, 75, 109, 41,
				220, 0, 0, 0, 35, 73, 68, 65, 84, 8, 215, 99, 252, 207, 128, 29,
				176, 220, 97, 80, 193, 46, 113, 155, 65, 149, 214, 58, 24, 85, 24, 110,
				99, 151, 96, 96, 192, 238, 96, 0, 129, 156, 8, 21, 234, 137, 101, 48,
				0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130
			]
		}

		internal def decodeOr(data byte[]) Image {
			return new ICO().decode(data) onerror recover new Image(1, 1)
		}

		@test()
		def decodes_1_bit_with_mask() {
			// Rows bottom-up: bottom = black, white; top = white, black.
			// The mask clears the top-right pixel.
			let entry = dib(2, 2, 1, byte[0, 0, 0, 0, 255, 255, 255, 0],
				byte[0x40, 0, 0, 0, 0x80, 0, 0, 0],
				byte[0, 0, 0, 0, 0x40, 0, 0, 0])
			let img = decodeOr(iconFile(1, byte[][entry], int[2]))
			assert int(img.size().width) == 2
			assert int(img.size().height) == 2
			assertPixel(img, 0, 0, 255, 255, 255, 255)
			assertPixel(img, 1, 0, 0, 0, 0, 0)
			assertPixel(img, 0, 1, 0, 0, 0, 255)
			assertPixel(img, 1, 1, 255, 255, 255, 255)
		}

		@test()
		def decodes_4_bit() {
			let palette byte[]
			palette.len(64)
			palette[4 + 2] = byte(255)
			palette[8 + 1] = byte(255)
			palette[12] = byte(255)
			// One row: indexes 1, 2, 3 (red, green, blue).
			let entry = dib(3, 1, 4, palette, byte[0x12, 0x30, 0, 0], byte[0, 0, 0, 0])
			let img = decodeOr(iconFile(1, byte[][entry], int[3]))
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 1, 0, 0, 255, 0, 255)
			assertPixel(img, 2, 0, 0, 0, 255, 255)
		}

		@test()
		def decodes_8_bit() {
			let palette byte[]
			palette.len(1024)
			palette[200 * 4] = byte(10)
			palette[200 * 4 + 1] = byte(20)
			palette[200 * 4 + 2] = byte(30)
			let entry = dib(2, 1, 8, palette, byte[200, 0, 0, 0], byte[0x40, 0, 0, 0])
			let img = decodeOr(iconFile(1, byte[][entry], int[2]))
			assertPixel(img, 0, 0, 30, 20, 10, 255)
			assertPixel(img, 1, 0, 0, 0, 0, 0)
		}

		@test()
		def decodes_24_bit() {
			let entry = dib(2, 1, 24, byte[], byte[1, 2, 3, 4, 5, 6, 0, 0], byte[0, 0, 0, 0])
			let img = decodeOr(iconFile(1, byte[][entry], int[2]))
			assertPixel(img, 0, 0, 3, 2, 1, 255)
			assertPixel(img, 1, 0, 6, 5, 4, 255)
		}

		@test()
		def decodes_32_bit_alpha() {
			let entry = dib(2, 1, 32, byte[], byte[1, 2, 3, 128, 4, 5, 6, 0], byte[0, 0, 0, 0])
			let img = decodeOr(iconFile(1, byte[][entry], int[2]))
			assertPixel(img, 0, 0, 3, 2, 1, 128)
			assertPixel(img, 1, 0, 6, 5, 4, 0)
		}

		// A 32-bit entry whose alpha is all zero is an old-style icon: the
		// mask says what shows.
		@test()
		def decodes_32_bit_without_alpha_through_the_mask() {
			let entry = dib(2, 1, 32, byte[], byte[1, 2, 3, 0, 4, 5, 6, 0], byte[0x40, 0, 0, 0])
			let img = decodeOr(iconFile(1, byte[][entry], int[2]))
			assertPixel(img, 0, 0, 3, 2, 1, 255)
			assertPixel(img, 1, 0, 6, 5, 4, 0)
		}

		@test()
		def decodes_an_embedded_png() {
			let ico = new ICO()
			let img = ico.decode(iconFile(1, byte[][gradientPNG()], int[8])) onerror recover new Image(1, 1)
			assert int(img.size().width) == 8
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 0, 7, 0, 0, 255, 255)
			let e = ico.entries()
			assert e.len() == 1
			assert e[0].png
			assert e[0].bitDepth == 24
		}

		@test()
		def decode_returns_the_largest_and_keeps_every_entry() {
			let small = dib(1, 1, 24, byte[], byte[0, 0, 255, 0], byte[0, 0, 0, 0])
			let ico = new ICO()
			let img = ico.decode(iconFile(1, byte[][small, gradientPNG()], int[1, 8])) onerror recover new Image(3, 3)
			assert int(img.size().width) == 8
			let sizes = ico.sizes()
			assert sizes.len() == 2
			assert sizes[0] == 1
			assert sizes[1] == 8
			let one = ico.image(1) onerror recover new Image(3, 3)
			assert int(one.size().width) == 1
			assertPixel(one, 0, 0, 255, 0, 0, 255)
		}

		@test()
		def round_trips_through_encode() {
			let src = pattern(20, 13)
			let codec = new ICO()
			let data = codec.encode(src) onerror recover byte[]
			let back = decodeOr(data)
			assert int(back.size().width) == 20
			assert int(back.size().height) == 13
			assert back.raw().equals(src.raw())
		}

		@test()
		def writes_every_size_asked_for() {
			let codec = new ICO()
			codec.encodeSizes = int[16, 32, 48]
			let data = codec.encode(pattern(64, 64)) onerror recover byte[]
			let back = new ICO()
			let img = back.decode(data) onerror recover new Image(1, 1)
			assert int(img.size().width) == 48
			let sizes = back.sizes()
			assert sizes.len() == 3
			assert sizes[0] == 16
			assert sizes[2] == 48
		}

		@test()
		def picks_and_scales_sizes() {
			let ico = new ICO()
			ico.add(pattern(16, 16))
			ico.add(pattern(32, 32))
			let data = ico.encode() onerror recover byte[]
			let back = new ICO()
			back.decode(data) onerror recover new Image(1, 1)
			let exact = back.image(16) onerror recover new Image(1, 1)
			assert exact.raw().equals(pattern(16, 16).raw())
			let down = back.image(24) onerror recover new Image(1, 1)
			assert int(down.size().width) == 24
			let up = back.image(64) onerror recover new Image(1, 1)
			assert int(up.size().width) == 64
		}

		// Downscaling averages by coverage and alpha: a transparent pixel's
		// colour does not bleed into its neighbours.
		@test()
		def scaling_ignores_transparent_colour() {
			let img = new Image(2, 1)
			let px = img.raw()
			px[0] = byte(200)
			px[3] = byte(255)
			px[5] = byte(90)
			let ico = new ICO()
			ico.add(img)
			let one = ico.image(1) onerror recover new Image(3, 3)
			assert int(one.size().width) == 1
			assertPixel(one, 0, 0, 200, 0, 0, 128)
		}

		@test()
		def fits_large_images_into_256() {
			let ico = new ICO()
			ico.add(pattern(300, 150))
			let e = ico.entries()
			assert e[0].width == 256
			assert e[0].height == 128
			let data = ico.encode() onerror recover byte[]
			let back = decodeOr(data)
			assert int(back.size().width) == 256
			assert int(back.size().height) == 128
		}

		@test()
		def rewrites_decoded_entries_unchanged() {
			let small = dib(1, 1, 24, byte[], byte[0, 0, 255, 0], byte[0, 0, 0, 0])
			let file = iconFile(1, byte[][small, gradientPNG()], int[1, 8])
			let ico = new ICO()
			ico.decode(file) onerror recover new Image(1, 1)
			let again = ico.encode() onerror recover byte[]
			// The directory records the stored depth; the entries match.
			assert again.len() == file.len()
			assert again[38:].equals(file[38:])
		}

		@test()
		def matches_its_signature() {
			let file = new ICO().encode(pattern(4, 4)) onerror recover byte[]
			assert new ICO().matchSignature(new bytes.Buffer(file))
			assert !new CUR().matchSignature(new bytes.Buffer(file))
			assert !new ICO().matchSignature(new bytes.Buffer(byte[0, 0, 1, 0]))
			let info = new ICO().info(file) onerror recover ImageInfo{}
			assert int(info.size.width) == 4
		}

		@test()
		def rejects_what_it_cannot_decode() {
			let good = new ICO().encode(pattern(4, 4)) onerror recover byte[]
			let cases = byte[][
				byte[0, 0, 1],
				byte[0, 0, 3, 0, 1, 0],
				byte[0, 0, 1, 0, 0, 0],
				good[:20],
				good[:good.len() - 1],
				iconFile(1, byte[][dib(2, 1, 16, byte[], byte[0, 0, 0, 0], byte[0, 0, 0, 0])], int[2]),
				iconFile(1, byte[][dib(2, 4, 32, byte[], byte[0, 0, 0, 0], byte[])], int[2])
			]
			for let (_, c) in cases {
				let failed = false
				new ICO().decode(c) onerror (err error) {
					failed = true
					recover new Image(1, 1)
				}
				assert failed
			}
		}
	}
}
