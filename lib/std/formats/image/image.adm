partial module std.formats.image {
	use (
		std.gfx.color
		std.math.geom
		std.io
		std.mem
		std.math
		std.simd
	)

	interface ImageDecoder {
		def decode(reader io.Reader) !Image
		def info(reader io.Reader) !ImageInfo
	}

	interface ImageEncoder {
		def encode(writer io.Writer) !none
	}

	struct ImageInfo {
		size        geom.Size
		colorFormat color.ColorFormat
		palette     color.Palette
	}

	// Image represents a 2D image
	type Image {
		// RGBA representation of the image data, row-major, 4 bytes per pixel.
		internal data     byte[]
		// Number of bytes per row in the image data.
		internal rowBytes int
		// Pixel dimensions.
		internal dims     geom.Size<uint>

		def new(width, height int) {
			dims = new geom.Size<uint>(uint(width), uint(height))
			rowBytes = width * 4
			data.len(height * rowBytes)
		}

		// The pixel dimensions of this image.
		def size() geom.Size<uint> {
			return dims
		}

		// Bytes per row of the backing buffer.
		def stride() int {
			return rowBytes
		}

		// The backing RGBA8 buffer, shared with this image, not copied.
		def raw() byte[] {
			return data
		}

		// Adopts a new backing store after a geometry-changing operation.
		def reshape(data byte[], size geom.Size<uint>, stride int) {
			self.data = data
			dims = size
			rowBytes = stride
		}

		// Coverage as a mask (gfx.Mask): the pixel's luminance scaled by its
		// alpha, so opaque white is full effect and black or transparent is
		// none. Pixels outside the image are uncovered.
		def coverage(x, y int) float {
			return 0.0 when x < 0 || y < 0 || x >= int(dims.width) || y >= int(dims.height)
			let o = y * rowBytes + x * 4
			let lum = 0.299 * float(data[o]) + 0.587 * float(data[o + 1]) + 0.114 * float(data[o + 2])
			return ((lum / 255.0) * (float(data[o + 3]) / 255.0)).clamp(0.0, 1.0)
		}

		// Get the color at the specified pixel coordinates.
		def at(x, y int) !color.Color {
			let offset = pixelOffset(x, y)
			return color.Color{
				red:   data[offset],
				green: data[offset + 1],
				blue:  data[offset + 2],
				alpha: data[offset + 3]
			}
		}

		// Set the color at the specified pixel coordinates.
		def at(p geom.Point) !color.Color {
			return at(int(p.x), int(p.y))
		}

		// Set the color at the specified pixel coordinates.
		def setPixel(x, y int, c color.Color) !none {
			let offset = pixelOffset(x, y)
			data[offset] = c.red
			data[offset + 1] = c.green
			data[offset + 2] = c.blue
			data[offset + 3] = c.alpha
		}

		// Set the color at the specified pixel coordinates.
		def setPixel(p geom.Point, c color.Color) !none {
			return setPixel(int(p.x), int(p.y), c)
		}

		// Returns the offset into the image data for the specified pixel coordinates.
		def pixelOffset(x, y int) int {
			return y * rowBytes + x * 4
		}

		// Returns a new Image holding the part of this one inside `r`, leaving
		// this image untouched. The rectangle is clipped to the image, so the
		// result may be smaller than asked for, and empty if the two do not
		// overlap.
		def subImage(r geom.Rectangle) Image {
			let w = int(dims.width)
			let h = int(dims.height)

			let x0 = int(r.position.x)
			let y0 = int(r.position.y)
			let x1 = x0 + int(r.size.width)
			let y1 = y0 + int(r.size.height)
			x0 = 0 when x0 < 0
			y0 = 0 when y0 < 0
			x1 = w when x1 > w
			y1 = h when y1 > h

			let cw = x1 - x0
			let ch = y1 - y0
			return new Image(0, 0) when cw <= 0 || ch <= 0

			let out = new Image(cw, ch)
			let copySpan = cw * 4
			for let y = 0; y < ch; y++ {
				let srcOff = (y0 + y) * rowBytes + x0 * 4
				let dstOff = y * out.rowBytes
				mem.copyN(out.data[dstOff:dstOff + copySpan], data[srcOff:srcOff + copySpan], copySpan)
			}
			return out
		}

		// Rotates this image in place clockwise by `angle` degrees and returns
		// it. Quarter turns are exact; any other angle samples the nearest
		// source pixel into the rotated bounding box, leaving the corners
		// transparent.
		def rotate(angle float64) Image {
			let w = int(dims.width)
			let h = int(dims.height)
			return self when w <= 0 || h <= 0

			let deg = int(angle) % 360
			deg += 360 when deg < 0

			if float64(deg) == angle - float64(int(angle) / 360 * 360) && deg % 90 == 0 {
				return self when deg == 0
				return adopt(quarterTurn(deg))
			}

			let rad = float(angle) * math.Pi / float(180)
			let cs = math.cos(rad)
			let sn = math.sin(rad)

			// Corners of the source mapped through the rotation give the new size.
			let cw = float(w)
			let ch = float(h)
			let absC = cs
			absC = float(0) - absC when absC < float(0)
			let absS = sn
			absS = float(0) - absS when absS < float(0)
			let outW = int(cw * absC + ch * absS + float(0.5))
			let outH = int(cw * absS + ch * absC + float(0.5))
			outW = 1 when outW < 1
			outH = 1 when outH < 1

			let out = new Image(outW, outH)
			let srcCx = cw / float(2)
			let srcCy = ch / float(2)
			let dstCx = float(outW) / float(2)
			let dstCy = float(outH) / float(2)

			for let y = 0; y < outH; y++ {
				let dy = float(y) + float(0.5) - dstCy
				for let x = 0; x < outW; x++ {
					let dx = float(x) + float(0.5) - dstCx
					// Rotate backwards to find the source pixel.
					let sx = int(dx * cs + dy * sn + srcCx)
					let sy = int(dy * cs - dx * sn + srcCy)
					continue when sx < 0 || sy < 0 || sx >= w || sy >= h
					let so = sy * rowBytes + sx * 4
					let dOff = y * out.rowBytes + x * 4
					out.data[dOff] = data[so]
					out.data[dOff + 1] = data[so + 1]
					out.data[dOff + 2] = data[so + 2]
					out.data[dOff + 3] = data[so + 3]
				}
			}
			return adopt(out)
		}

		// Takes over another image's pixels, so an operation that changes the
		// dimensions can still be done in place.
		internal def adopt(src Image) Image {
			data = src.data
			rowBytes = src.rowBytes
			dims = src.dims
			return self
		}

		// Exact 90, 180 and 270 degree rotations.
		internal def quarterTurn(deg int) Image {
			let w = int(dims.width)
			let h = int(dims.height)
			let out = new Image(h, w)
			out = new Image(w, h) when deg == 180

			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					let dx = 0
					let dy = 0
					if deg == 90 {
						dx = h - 1 - y
						dy = x
					} else if deg == 180 {
						dx = w - 1 - x
						dy = h - 1 - y
					} else {
						dx = y
						dy = w - 1 - x
					}
					let so = y * rowBytes + x * 4
					let dof = dy * out.rowBytes + dx * 4
					out.data[dof] = data[so]
					out.data[dof + 1] = data[so + 1]
					out.data[dof + 2] = data[so + 2]
					out.data[dof + 3] = data[so + 3]
				}
			}
			return out
		}

		// Returns an independent copy of this image.
		def copy() Image {
			let w = int(dims.width)
			let h = int(dims.height)
			let out = new Image(w, h)
			mem.copyN(out.data, data, h * rowBytes) when w > 0 && h > 0
			return out
		}

		// Composites `img` onto this image at `(x, y)` and returns this image.
		// Anything outside the bounds is clipped.
		def draw(img Image, x, y int, mode color.BlendMode = color.BlendMode.Normal) Image {
			let w = int(dims.width)
			let h = int(dims.height)
			let sw = int(img.dims.width)
			let sh = int(img.dims.height)
			return self when sw <= 0 || sh <= 0

			let sx0 = 0
			let sy0 = 0
			let dx0 = x
			let dy0 = y
			if dx0 < 0 {
				sx0 = 0 - dx0
				dx0 = 0
			}
			if dy0 < 0 {
				sy0 = 0 - dy0
				dy0 = 0
			}
			let cw = sw - sx0
			let ch = sh - sy0
			cw = w - dx0 when cw > w - dx0
			ch = h - dy0 when ch > h - dy0
			return self when cw <= 0 || ch <= 0

			for let row = 0; row < ch; row++ {
				let so = (sy0 + row) * img.rowBytes + sx0 * 4
				let dOff = (dy0 + row) * rowBytes + dx0 * 4
				for let col = 0; col < cw; col++ {
					let s = so + col * 4
					let d = dOff + col * 4
					let sa = int(img.data[s + 3])
					continue when sa == 0

					if mode == color.BlendMode.Normal && sa == 255 {
						data[d] = img.data[s]
						data[d + 1] = img.data[s + 1]
						data[d + 2] = img.data[s + 2]
						data[d + 3] = byte(255)
						continue
					}

					let out = color.blendRGBA(
						color.RGBA{r: data[d], g: data[d + 1], b: data[d + 2], a: data[d + 3]},
						color.RGBA{r: img.data[s], g: img.data[s + 1], b: img.data[s + 2], a: img.data[s + 3]},
						mode)
					data[d] = out.r
					data[d + 1] = out.g
					data[d + 2] = out.b
					data[d + 3] = out.a
				}
			}
			return self
		}

		def mask(mask Image) Image {
			// @TODO: implement
			return self
		}
	}
	/*
	
	image.transform
	rotate
	crop
	smartCrop
	
	image.filter
	grayscale
	sharpen
	gamma
	contrast
	brightness
	saturation
	hue
	sepia
	exposure
	temperature
	tint
	posterize
	quantize
	replaceColor
	...
	*/
}
