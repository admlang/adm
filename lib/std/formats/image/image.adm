partial module std.formats.image {
	use (
		std.gfx
		std.gfx.color
		std.math.geom
		std.io
		std.os
		std.bytes
		std.mem
		std.math
		std.simd
		std.gfx.bands::forRows
		std.formats.image.loader::*
	)

	// The lanes that reverse four pixels in a 16-byte vector.
	internal const imageReversePixels = byte[12, 13, 14, 15, 8, 9, 10, 11, 4, 5, 6, 7, 0, 1, 2, 3]

	// Writes rows [from, to) of a quarter turn of the w by h source: output
	// row dy is source column dy read upwards (clockwise) or column w - 1 -
	// dy read downwards (counterclockwise), one four-byte move per pixel.
	// The arrays come as parameters: a pixel loop over a local a closure
	// captured runs many times slower.
	internal def imageTurnRows(src byte[], srcStride int, dst byte[], dstStride int, w int, h int, clockwise bool, from int, to int) {
		for let dy = from; dy < to; dy++ {
			let drow = dy * dstStride
			if clockwise {
				let sx = dy * 4
				for let dx = 0; dx < h; dx++ {
					simd.storeBytes4(dst, drow + dx * 4, simd.loadBytes4(src, (h - 1 - dx) * srcStride + sx))
				}
			} else {
				let sx = (w - 1 - dy) * 4
				for let dx = 0; dx < h; dx++ {
					simd.storeBytes4(dst, drow + dx * 4, simd.loadBytes4(src, dx * srcStride + sx))
				}
			}
		}
	}

	// The EXIF Orientation tag (0x0112) of an EXIF block (the TIFF structure
	// a JPEG APP1 segment carries after `Exif\0\0`, or a WebP EXIF chunk,
	// with or without that header): 1 to 8, or 1 when the block has no
	// readable tag.
	def exifOrientation(exif byte[]) int {
		let at = exifOrientationAt(exif)
		return 1 when at < 0
		let value = exifLittleEndian(exif) ?? (int(exif[at]) | int(exif[at + 1]) << 8, int(exif[at]) << 8 | int(exif[at + 1]))
		return value >= 1 && value <= 8 ?? (value, 1)
	}

	// A copy of the EXIF block with its Orientation tag set to `value`; the
	// block as it is when it has no Orientation tag.
	def exifWithOrientation(exif byte[], value int) byte[] {
		let at = exifOrientationAt(exif)
		return exif when at < 0
		let out = exif.clone()
		if exifLittleEndian(exif) {
			out[at] = byte(value & 255)
			out[at + 1] = byte(value >> 8)
		} else {
			out[at] = byte(value >> 8)
			out[at + 1] = byte(value & 255)
		}
		return out
	}

	// Where the EXIF block's TIFF structure starts: after an `Exif\0\0` header
	// when it has one.
	internal def exifStart(exif byte[]) int {
		return 6 when exif.len() >= 8 && exif[0] == byte('E') && exif[1] == byte('x') && exif[2] == byte('i') && exif[3] == byte('f') && exif[4] == byte(0) && exif[5] == byte(0)
		return 0
	}

	internal def exifLittleEndian(exif byte[]) bool {
		let s = exifStart(exif)
		return exif.len() >= s + 2 && exif[s] == byte('I') && exif[s + 1] == byte('I')
	}

	// The offset of the Orientation tag's value in the block, -1 when the
	// first image directory has none.
	internal def exifOrientationAt(exif byte[]) int {
		let s = exifStart(exif)
		return -1 when exif.len() < s + 8
		let little = exif[s] == byte('I') && exif[s + 1] == byte('I')
		return -1 unless little || (exif[s] == byte('M') && exif[s + 1] == byte('M'))
		let u16 = def (at int) int {
			return little ?? (int(exif[at]) | int(exif[at + 1]) << 8, int(exif[at]) << 8 | int(exif[at + 1]))
		}
		let u32 = def (at int) int {
			return little ?? (u16(at) | u16(at + 2) << 16, u16(at) << 16 | u16(at + 2))
		}
		return -1 when u16(s + 2) != 42
		let ifd = s + u32(s + 4)
		return -1 when ifd < s || ifd + 2 > exif.len()
		let count = u16(ifd)
		for let i = 0; i < count; i++ {
			let entry = ifd + 2 + i * 12
			return -1 when entry + 12 > exif.len()
			return entry + 8 when u16(entry) == 0x0112 && u16(entry + 2) == 3 && u32(entry + 4) == 1
		}
		return -1
	}

	// Writes rows [from, to) mirrored: left to right (`horizontal`) or top
	// to bottom.
	internal def imageMirrorRows(src byte[], srcStride int, dst byte[], dstStride int, w int, h int, horizontal bool, from int, to int) {
		let rev = simd.loadBytes16(imageReversePixels, 0)
		for let y = from; y < to; y++ {
			let drow = y * dstStride
			if !horizontal {
				mem.copyN(dst, drow, src, (h - 1 - y) * srcStride, w * 4)
				continue
			}
			let srow = y * srcStride
			let x = 0
			for x + 4 <= w {
				simd.storeBytes16(dst, drow + x * 4, simd.loadBytes16(src, srow + (w - x - 4) * 4).shuffle(rev))
				x += 4
			}
			for x < w {
				simd.storeBytes4(dst, drow + x * 4, simd.loadBytes4(src, srow + (w - 1 - x) * 4))
				x++
			}
		}
	}

	// Writes rows [from, to) of a half turn: the rows in reverse order,
	// each reversed four pixels a vector.
	internal def imageHalfTurnRows(src byte[], srcStride int, dst byte[], dstStride int, w int, h int, from int, to int) {
		let rev = simd.loadBytes16(imageReversePixels, 0)
		for let y = from; y < to; y++ {
			let srow = (h - 1 - y) * srcStride
			let drow = y * dstStride
			let x = 0
			for x + 4 <= w {
				simd.storeBytes16(dst, drow + x * 4, simd.loadBytes16(src, srow + (w - x - 4) * 4).shuffle(rev))
				x += 4
			}
			for x < w {
				simd.storeBytes4(dst, drow + x * 4, simd.loadBytes4(src, srow + (w - 1 - x) * 4))
				x++
			}
		}
	}

	// ImageDecoder reads an image from a reader.
	interface ImageDecoder {
		def decode(reader io.Reader) !Image
		def info(reader io.Reader) !ImageInfo
	}

	// ImageEncoder writes an image to a writer.
	interface ImageEncoder {
		// encode writes the image in the codec's format. What the format
		// cannot hold (alpha, depth) is reduced, never an error. Fails with the
		// writer's own error.
		def encode(img Image, writer io.Writer) !none
	}

	// QualityEncoder is an encoder with a quality setting, `quality` 0
	// (smallest file) to 100 (best image): JPEG and lossy WebP. A tool offers
	// a quality control for any codec that is one, a plugin's included.
	datatype QualityEncoder {
		quality int
	}

	// LosslessEncoder is an encoder that writes either lossless or lossy,
	// as `lossless` says: WebP. A tool offers the switch for any codec that
	// is one.
	datatype LosslessEncoder {
		lossless bool
	}

	// ImageInfo is what a codec learns from the headers alone: the size, the
	// colour format and the rest.
	struct ImageInfo {
		size        geom.Size
		colorFormat color.ColorFormat
		palette     color.Palette
		// How many images the file holds: an animation's frames (GIF, APNG,
		// WebP, ANI), an icon's or cursor's entries, a TIFF's pages; 1 for a
		// still picture. `load` and `decode` give the first; a file with more
		// loses the rest when it is saved from that one image.
		frames      int               = 1
	}

	// Image represents a 2D image
	type Image {
		// RGBA representation of the image data, row-major, 4 bytes per pixel.
		internal data     byte[]
		// Number of bytes per row in the image data.
		internal rowBytes int
		// Pixel dimensions.
		internal dims     geom.Size<uint>

		def new(width, height int) {
			dims = new geom.Size<uint>(uint(width), uint(height))
			rowBytes = width * 4
			data.len(height * rowBytes)
		}

		// The pixel dimensions of this image.
		def size() geom.Size<uint> {
			return dims
		}

		// Bytes per row of the backing buffer.
		def stride() int {
			return rowBytes
		}

		// The backing RGBA8 buffer, shared with this image, not copied; see
		// the gfx.Raster contract. Rows may carry padding: use `stride()`
		// (or `pixelOffset`) rather than `width * 4` to step between rows.
		def raw() byte[] {
			return data
		}

		// Adopts a new backing store after a geometry-changing operation.
		def reshape(data byte[], size geom.Size<uint>, stride int) {
			self.data = data
			dims = size
			rowBytes = stride
		}

		// Coverage as a mask (gfx.Mask): the pixel's luminance scaled by its
		// alpha, so opaque white is full effect and black or transparent is
		// none. Pixels outside the image are uncovered.
		def coverage(x, y int) float {
			return 0.0 when x < 0 || y < 0 || x >= int(dims.width) || y >= int(dims.height)
			let o = y * rowBytes + x * 4
			let lum = 0.299 * float(data[o]) + 0.587 * float(data[o + 1]) + 0.114 * float(data[o + 2])
			return ((lum / 255.0) * (float(data[o + 3]) / 255.0)).clamp(0.0, 1.0)
		}

		// RowMask: luminance scaled by alpha along the row.
		def coverage(x, y int, out float32[]) {
			gfx.luminanceCoverage(self, x, y, out)
		}

		// RowMask: the image; nothing outside it is covered.
		def bounds() ?geom.Rect {
			return geom.Rect{left: 0.0, top: 0.0, right: float(dims.width), bottom: float(dims.height)}
		}

		// Get the color at the specified pixel coordinates.
		// Fails when the point lies outside the image.
		def at(x, y int) !color.Color {
			let offset = pixelOffset(x, y)
			return color.Color{
				red:   data[offset],
				green: data[offset + 1],
				blue:  data[offset + 2],
				alpha: data[offset + 3]
			}
		}

		// Set the color at the specified pixel coordinates.
		// Fails when the point lies outside the image.
		def at(p geom.Point) !color.Color {
			return at(int(p.x), int(p.y))
		}

		// Set the color at the specified pixel coordinates.
		// Fails when the point lies outside the image.
		def setPixel(x, y int, c color.Color) !none {
			let offset = pixelOffset(x, y)
			data[offset] = c.red
			data[offset + 1] = c.green
			data[offset + 2] = c.blue
			data[offset + 3] = c.alpha
		}

		// Set the color at the specified pixel coordinates.
		// Fails when the point lies outside the image.
		def setPixel(p geom.Point, c color.Color) !none {
			return setPixel(int(p.x), int(p.y), c)
		}

		// save encodes the image with the codec registered for the path's
		// extension and writes the file. Fails when no codec has the extension,
		// encoding fails, or the file cannot be written.
		def save(path string) !none {
			let out = new bytes.Buffer()
			try write(out, os.extension(path))
			return os.writeFile(path, out.bytes())
		}

		// write encodes the image to the writer with the codec registered for
		// the file extension (".png", ".gif"). Fails when no codec has the
		// extension, or encoding or the writer does.
		def write(writer io.Writer, extension string) !none {
			let enc = codecRegistry.matchExt(extension)
			fail "no image codec has the extension \"{extension}\"" when enc is none
			return enc.encode(self, writer)
		}

		// Returns the offset into the image data for the specified pixel coordinates.
		def pixelOffset(x, y int) int {
			return y * rowBytes + x * 4
		}

		// Returns a new Image holding the part of this one inside `r`, leaving
		// this image untouched. The rectangle is clipped to the image, so the
		// result may be smaller than asked for, and empty if the two do not
		// overlap.
		def subImage(r geom.Rectangle) Image {
			let w = int(dims.width)
			let h = int(dims.height)

			let x0 = int(r.position.x)
			let y0 = int(r.position.y)
			let x1 = x0 + int(r.size.width)
			let y1 = y0 + int(r.size.height)
			x0 = 0 when x0 < 0
			y0 = 0 when y0 < 0
			x1 = w when x1 > w
			y1 = h when y1 > h

			let cw = x1 - x0
			let ch = y1 - y0
			return new Image(0, 0) when cw <= 0 || ch <= 0

			let out = new Image(cw, ch)
			let copySpan = cw * 4
			for let y = 0; y < ch; y++ {
				let srcOff = (y0 + y) * rowBytes + x0 * 4
				let dstOff = y * out.rowBytes
				mem.copyN(out.data[dstOff:dstOff + copySpan], data[srcOff:srcOff + copySpan], copySpan)
			}
			return out
		}

		// Rotates this image in place clockwise by `angle` degrees and returns
		// it. Quarter turns are exact; any other angle samples the nearest
		// source pixel into the rotated bounding box, leaving the corners
		// transparent.
		def rotate(angle float64) Image {
			let w = int(dims.width)
			let h = int(dims.height)
			return self when w <= 0 || h <= 0

			let deg = int(angle) % 360
			deg += 360 when deg < 0

			if float64(deg) == angle - float64(int(angle) / 360 * 360) && deg % 90 == 0 {
				return self when deg == 0
				return adopt(quarterTurn(deg))
			}

			let rad = float(angle) * math.Pi / float(180)
			let cs = math.cos(rad)
			let sn = math.sin(rad)

			// Corners of the source mapped through the rotation give the new size.
			let cw = float(w)
			let ch = float(h)
			let absC = cs
			absC = float(0) - absC when absC < float(0)
			let absS = sn
			absS = float(0) - absS when absS < float(0)
			let outW = int(cw * absC + ch * absS + float(0.5))
			let outH = int(cw * absS + ch * absC + float(0.5))
			outW = 1 when outW < 1
			outH = 1 when outH < 1

			let out = new Image(outW, outH)
			let srcCx = cw / float(2)
			let srcCy = ch / float(2)
			let dstCx = float(outW) / float(2)
			let dstCy = float(outH) / float(2)

			for let y = 0; y < outH; y++ {
				let dy = float(y) + float(0.5) - dstCy
				for let x = 0; x < outW; x++ {
					let dx = float(x) + float(0.5) - dstCx
					// Rotate backwards to find the source pixel.
					let sx = int(dx * cs + dy * sn + srcCx)
					let sy = int(dy * cs - dx * sn + srcCy)
					continue when sx < 0 || sy < 0 || sx >= w || sy >= h
					let so = sy * rowBytes + sx * 4
					let dOff = y * out.rowBytes + x * 4
					out.data[dOff] = data[so]
					out.data[dOff + 1] = data[so + 1]
					out.data[dOff + 2] = data[so + 2]
					out.data[dOff + 3] = data[so + 3]
				}
			}
			return adopt(out)
		}

		// Applies an EXIF Orientation tag (1 to 8) to this image in place and
		// returns it: 2 mirrors left to right, 3 turns half round, 4 mirrors
		// top to bottom, 5 mirrors and turns a quarter counterclockwise, 6
		// turns a quarter clockwise, 7 mirrors and turns a quarter clockwise,
		// 8 turns a quarter counterclockwise; 1 and any other value leave it.
		// Decoders apply the tag of the file's EXIF and set it to 1.
		def orient(orientation int) Image {
			match orientation {
				case 2:
					return mirror(true)
				case 3:
					return adopt(quarterTurn(180))
				case 4:
					return mirror(false)
				case 5:
					mirror(true)
					return adopt(quarterTurn(270))
				case 6:
					return adopt(quarterTurn(90))
				case 7:
					mirror(true)
					return adopt(quarterTurn(90))
				case 8:
					return adopt(quarterTurn(270))
				default:
					return self
			}
		}

		// Mirrors the image in place, left to right or top to bottom, rows on
		// tasks.
		internal def mirror(horizontal bool) Image {
			let w = int(dims.width)
			let h = int(dims.height)
			return self when w <= 0 || h <= 0
			let out = new Image(w, h)
			let src = data
			let stride = rowBytes
			let dst = out.data
			let outStride = out.rowBytes
			forRows(w, h, def (from int, to int) {
				imageMirrorRows(src, stride, dst, outStride, w, h, horizontal, from, to)
			})
			return adopt(out)
		}

		// Takes over another image's pixels, so an operation that changes the
		// dimensions can still be done in place.
		internal def adopt(src Image) Image {
			data = src.data
			rowBytes = src.rowBytes
			dims = src.dims
			return self
		}

		// Exact 90, 180 and 270 degree rotations: one four-byte move per
		// pixel, the output's rows on tasks; a half turn reverses rows four
		// pixels a vector.
		internal def quarterTurn(deg int) Image {
			let w = int(dims.width)
			let h = int(dims.height)
			let src = data
			let srcStride = rowBytes
			if deg == 180 {
				let out = new Image(w, h)
				let outStride = out.rowBytes
				let dst = out.data
				forRows(w, h, def (from int, to int) {
					imageHalfTurnRows(src, srcStride, dst, outStride, w, h, from, to)
				})
				return out
			}
			let out = new Image(h, w)
			let outStride = out.rowBytes
			let dst = out.data
			forRows(h, w, def (from int, to int) {
				imageTurnRows(src, srcStride, dst, outStride, w, h, deg == 90, from, to)
			})
			return out
		}

		// Returns an independent copy of this image. Bands of rows are copied
		// on tasks.
		def copy() Image {
			let w = int(dims.width)
			let h = int(dims.height)
			let out = new Image(w, h)
			return out when w <= 0 || h <= 0
			let src = data
			let stride = rowBytes
			let dst = out.data
			forRows(w, h, def (from int, to int) {
				mem.copyN(dst, from * stride, src, from * stride, (to - from) * stride)
			})
			return out
		}

		// Composites `img` onto this image at `(x, y)` and returns this image.
		// Anything outside the bounds is clipped.
		def draw(img Image, x, y int, mode color.BlendMode = color.BlendMode.Normal) Image {
			let w = int(dims.width)
			let h = int(dims.height)
			let sw = int(img.dims.width)
			let sh = int(img.dims.height)
			return self when sw <= 0 || sh <= 0

			let sx0 = 0
			let sy0 = 0
			let dx0 = x
			let dy0 = y
			if dx0 < 0 {
				sx0 = 0 - dx0
				dx0 = 0
			}
			if dy0 < 0 {
				sy0 = 0 - dy0
				dy0 = 0
			}
			let cw = sw - sx0
			let ch = sh - sy0
			cw = w - dx0 when cw > w - dx0
			ch = h - dy0 when ch > h - dy0
			return self when cw <= 0 || ch <= 0

			for let row = 0; row < ch; row++ {
				let so = (sy0 + row) * img.rowBytes + sx0 * 4
				let dOff = (dy0 + row) * rowBytes + dx0 * 4
				for let col = 0; col < cw; col++ {
					let s = so + col * 4
					let d = dOff + col * 4
					let sa = int(img.data[s + 3])
					continue when sa == 0

					if mode == color.BlendMode.Normal && sa == 255 {
						data[d] = img.data[s]
						data[d + 1] = img.data[s + 1]
						data[d + 2] = img.data[s + 2]
						data[d + 3] = byte(255)
						continue
					}

					let out = color.blendRGBA(
						color.RGBA{r: data[d], g: data[d + 1], b: data[d + 2], a: data[d + 3]},
						color.RGBA{r: img.data[s], g: img.data[s + 1], b: img.data[s + 2], a: img.data[s + 3]},
						mode)
					data[d] = out.r
					data[d + 1] = out.g
					data[d + 2] = out.b
					data[d + 3] = out.a
				}
			}
			return self
		}

		// mask keeps the pixels the mask image covers and clears the rest. Not
		// implemented: returns the image unchanged.
		def mask(mask Image) Image {
			return self
		}
	}
	/*
	
	image.transform
	
	rotate
	
	crop
	
	smartCrop
	
	image.filter
	
	grayscale
	
	sharpen
	
	gamma
	
	contrast
	
	brightness
	
	saturation
	
	hue
	
	sepia
	
	exposure
	
	temperature
	
	tint
	
	posterize
	
	quantize
	
	replaceColor
	
	...
	
	*/
}
