		@test()
		def draw_composites_and_clips() {
			let dst = patternImage(12, 12)
			let ref = dst.copy()
			let src = patternImage(4, 4)

			dst.draw(src, 3, 5)
			// The source is fully opaque, so those pixels are replaced.
			for let y = 0; y < 4; y++ {
				for let x = 0; x < 4; x++ {
					assert samePixel(dst, x + 3, y + 5, src, x, y)
				}
			}
			// Everything else is untouched.
			assert samePixel(dst, 0, 0, ref, 0, 0)
			assert samePixel(dst, 11, 11, ref, 11, 11)

			// Drawing off the edge clips rather than failing.
			dst.draw(src, 10, 10)
			dst.draw(src, 0 - 2, 0 - 2)
			assert int(dst.size().width) == 12
		}
