partial module std.formats.image {
	use (
		std.testing
		std.math.geom
	)

	// Built once and reused, so a benchmark measures the operation rather than
	// the setup.
	internal let benchSource = new Image(0, 0)

	internal def benchImage() Image {
		if int(benchSource.size().width) == 0 {
			benchSource = patternImage(512, 512)
		}
		return benchSource
	}

	// A deterministic pattern: every pixel differs from its neighbours, so a
	// transform that mixes up coordinates cannot pass by accident.
	internal def patternImage(w int, h int) Image {
		let img = new Image(w, h)
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let o = img.pixelOffset(x, y)
				let px = img.raw()
				px[o] = byte(x % 256)
				px[o + 1] = byte(y % 256)
				px[o + 2] = byte((x * 7 + y * 13) % 256)
				px[o + 3] = byte(255)
			}
		}
		return img
	}

	check "Image operations" {
		internal def samePixel(a Image, ax int, ay int, b Image, bx int, by int) bool {
			let ao = a.pixelOffset(ax, ay)
			let bo = b.pixelOffset(bx, by)
			let ap = a.raw()
			let bp = b.raw()
			return ap[ao] == bp[bo] && ap[ao + 1] == bp[bo + 1] &&
				ap[ao + 2] == bp[bo + 2] && ap[ao + 3] == bp[bo + 3]
		}

		@test()
		def copy_is_independent() {
			let src = patternImage(9, 7)
			let dup = src.copy()
			assert int(dup.size().width) == 9
			assert int(dup.size().height) == 7
			for let y = 0; y < 7; y++ {
				for let x = 0; x < 9; x++ {
					assert samePixel(dup, x, y, src, x, y)
				}
			}
			// Writing through the copy must not disturb the original.
			dup.raw()[0] = byte(1)
			dup.raw()[1] = byte(2)
			assert int(src.raw()[0]) == 0
		}

