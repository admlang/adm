		@test()
		def subImage_leaves_the_original_alone() {
			let src = patternImage(20, 15)
			let part = src.subImage(geom.Rectangle{
				position: new geom.Point(float(4), float(3)),
				size:     new geom.Size(float(6), float(5)),
			})
			assert int(part.size().width) == 6
			assert int(part.size().height) == 5
			assert int(src.size().width) == 20
			for let y = 0; y < 5; y++ {
				for let x = 0; x < 6; x++ {
					assert samePixel(part, x, y, src, x + 4, y + 3)
				}
			}
		}

