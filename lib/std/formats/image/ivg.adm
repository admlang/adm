partial module std.formats.image {
	use (
		std.io
		std.bytes
	)

	// IVG is the IVG vector image codec. Decoding and encoding are not implemented yet;
	// matchSignature reports that nothing matches.
	@codec("Vector Graphics Icon")
	type IVG {
		mimeType string[] {
			def get() string[] {
				return string["image/ivg", "image/x-iconvg", "image/svg+xml"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ivg"]
			}
		}

		// matchSignature reports whether the reader starts with a IVG vector image signature.
		// Not implemented yet: always false.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// info reads the image's dimensions and format from the bytes. Fails, as
		// decoding is not implemented yet.
		def info(data byte[]) !ImageInfo {
			return info(new bytes.Buffer(data))
		}

		// info reads the image's dimensions and format from the reader. Fails, as
		// decoding is not implemented yet.
		def info(reader io.Reader) !ImageInfo {
			fail "not implemented"
		}

		// decode reads a IVG vector image image from the bytes. Fails, as decoding is not
		// implemented yet.
		def decode(data byte[]) !Image {
			return decode(new bytes.Buffer(data))
		}

		// decode reads a IVG vector image image from the reader. Fails, as decoding is not
		// implemented yet.
		def decode(reader io.Reader) !Image {
			fail "not implemented"
		}

		// encode renders the image as IVG vector image. Fails, as encoding is not
		// implemented yet.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as IVG vector image to the writer. Fails, as encoding
		// is not implemented yet.
		def encode(img Image, writer io.Writer) !none {
			fail "not implemented"
		}
	}
}
