partial module std.formats.image {
	use (
		std.testing
		std.bytes
		std.math
		std.gfx.color
		std.formats.image.jpeg2000::*
	)

	// Written by OpenJPEG 2.5.4 from a 32 x 24 gradient with noise; each
	// decodes to the same components as OpenJPEG.
	//
	// 5/3 RGB in 16 x 16 tiles, 16 x 16 and 8 x 8 precincts, SOP and EPH
	// markers, PCRL order, two layers, 8 x 8 code-blocks.
	@embed("testdata/jpeg2000_rct_tiles.j2k")
	const j2kRctTiles byte[]
	// JP2, 9/7 and ICT, RPCL, every code-block style flag (bypass, reset,
	// termination on each pass, vertically causal, predictable termination,
	// segmentation symbols).
	@embed("testdata/jpeg2000_ict_modes.jp2")
	const j2kIctModes byte[]
	// Components sub-sampled 2 x 1 with image offset (3, 5), tiles of 12 x 10
	// offset (1, 2), CPRL order, no colour transform.
	@embed("testdata/jpeg2000_sub.j2k")
	const j2kSub byte[]
	// A region of interest (maxshift 4) on the first component, RLCP order.
	@embed("testdata/jpeg2000_roi.j2k")
	const j2kRoi byte[]
	// 16-bit grey, three layers, two POC progression changes (CPRL, then
	// LRCP).
	@embed("testdata/jpeg2000_grey16.j2k")
	const j2kGrey16 byte[]
	// JP2 with an alpha channel definition.
	@embed("testdata/jpeg2000_alpha.jp2")
	const j2kAlpha byte[]
	// JP2 of 16 palette entries (pclr and cmap), its channels reordered by
	// cdef, a capture resolution of 3780 x 2835 pixels per metre.
	@embed("testdata/jpeg2000_palette.jp2")
	const j2kPalette byte[]
	// JP2 in sYCC with 4:2:0 chroma, 30 x 22.
	@embed("testdata/jpeg2000_ycc420.jp2")
	const j2kYcc420 byte[]

	check "JPEG 2000" {
		// FNV-1a of the bytes, to compare whole images in a few digits.
		internal def fnv(b byte[]) int {
			let h = 2166136261
			for let (_, x) in b {
				h = ((h ^ int(x)) * 16777619) & 0xFFFFFFFF
			}
			return h
		}

		// FNV-1a of samples as 4-byte little-endian words.
		internal def fnvSamples(s int32[]) int {
			let h = 2166136261
			for let (_, v) in s {
				let u = int(v) & 0xFFFFFFFF
				for let k = 0; k < 4; k++ {
					h = ((h ^ ((u >> (8 * k)) & 0xFF)) * 16777619) & 0xFFFFFFFF
				}
			}
			return h
		}

		internal def decodeOr(codec JPEG2000, data byte[]) Image {
			return codec.decode(data) onerror recover new Image(1, 1)
		}

		internal def width(img Image) int {
			return int(img.size().width)
		}

		internal def height(img Image) int {
			return int(img.size().height)
		}

		// Peak signal to noise ratio of b against a over the colour channels,
		// in dB; 100 when equal.
		internal def psnr(a Image, b Image) float {
			let pa = a.raw()
			let pb = b.raw()
			let sum = 0.0
			let n = 0
			for let i = 0; i < pa.len(); i++ {
				continue when i % 4 == 3
				let d = float(int(pa[i]) - int(pb[i]))
				sum += d * d
				n++
			}
			return 100.0 when sum == 0.0
			return 10.0 * math.log10(255.0 * 255.0 * float(n) / sum)
		}

		@test()
		def decodes_like_openjpeg() {
			// Size and checksum of the RGBA each fixture decodes to; the
			// components match OpenJPEG's exactly.
			let files = byte[][j2kRctTiles, j2kIctModes, j2kSub, j2kRoi, j2kAlpha, j2kPalette, j2kYcc420, j2kGrey16]
			let widths = int[32, 32, 63, 32, 32, 32, 30, 32]
			let heights = int[24, 24, 24, 24, 24, 24, 22, 24]
			let sums = int[0x32e0039a, 0xa6a1c509, 0x38774580, 0x4ecf873c, 0x721ffa62, 0x95e31345, 0x0187385d, 0x90289a63]
			for let i = 0; i < files.len(); i++ {
				let img = decodeOr(new JPEG2000(), files[i])
				assert width(img) == widths[i]
				assert height(img) == heights[i]
				assert fnv(img.raw()) == sums[i]
			}
		}

		@test()
		def matches_signatures() {
			let codec = new JPEG2000()
			assert codec.matchSignature(new bytes.Reader(j2kRctTiles))
			assert codec.matchSignature(new bytes.Reader(j2kAlpha))
			assert !codec.matchSignature(new bytes.Reader(byte[0x89, 0x50, 0x4E, 0x47, 13, 10, 26, 10, 0, 0, 0, 13]))
			let raw = new J2K()
			assert raw.matchSignature(new bytes.Reader(j2kRctTiles))
			assert !raw.matchSignature(new bytes.Reader(j2kAlpha))
			assert codec.extension[0] == ".jp2"
			assert raw.extension[0] == ".j2k"
		}

		@test()
		def reads_info_from_headers() {
			let codec = new JPEG2000()
			let info = codec.info(j2kRctTiles) onerror recover ImageInfo{}
			assert int(info.size.width) == 32
			assert int(info.size.height) == 24
			assert info.colorFormat == color.ColorFormat.RGB
			let alpha = codec.info(j2kAlpha) onerror recover ImageInfo{}
			assert alpha.colorFormat == color.ColorFormat.RGBA
			let pal = codec.info(j2kPalette) onerror recover ImageInfo{}
			assert pal.colorFormat == color.ColorFormat.Palette
			let grey = codec.info(j2kGrey16) onerror recover ImageInfo{}
			assert grey.colorFormat == color.ColorFormat.Gray
			let failed = false
			codec.info(byte[1, 2, 3, 4, 5, 6]) onerror (err error) {
				failed = true
				recover ImageInfo{}
			}
			assert failed
		}

		@test()
		def keeps_full_precision_components() {
			let codec = new JPEG2000()
			let comps = codec.components(j2kGrey16) onerror recover JPEG2000Component[]
			assert comps.len() == 1
			assert comps[0].precision == 16
			assert !comps[0].signed
			assert comps[0].width == 32
			assert fnvSamples(comps[0].samples) == 0xc2368a34
			assert !codec.lossy
		}

		@test()
		def decodes_fewer_layers_and_resolutions() {
			let codec = new JPEG2000()
			codec.layers = 1
			let comps = codec.components(j2kGrey16) onerror recover JPEG2000Component[]
			assert comps.len() == 1
			assert fnvSamples(comps[0].samples) == 0xba90deb9
			let small = new JPEG2000()
			small.reduce = 1
			let img = decodeOr(small, j2kRctTiles)
			assert width(img) == 16
			assert height(img) == 12
			assert fnv(img.raw()) == 0xac6384b2
			small.reduce = 9
			let failed = false
			small.decode(j2kRctTiles) onerror (err error) {
				failed = true
				recover new Image(1, 1)
			}
			assert failed
		}

		@test()
		def reads_jp2_boxes() {
			let codec = new JPEG2000()
			decodeOr(codec, j2kPalette)
			assert codec.colorSpace == 16
			assert codec.xResolution == 3780.0
			assert codec.yResolution == 2835.0
			assert codec.iccProfile.len() == 0
			decodeOr(codec, j2kYcc420)
			assert codec.colorSpace == 18
			assert codec.lossy
		}

		// The codestream with its components' depth changed from 8 bits to
		// `prec` (SIZ is left otherwise alone): the 5/3 data then decodes to
		// the same values, shifted by the new depth's half range.
		internal def deepen(prec int) byte[] {
			let b = j2kRctTiles.clone()
			for let c = 0; c < 3; c++ {
				b[42 + 3 * c] = byte(prec - 1)
			}
			return b
		}

		@test()
		def decodes_deep_samples() {
			let codec = new JPEG2000()
			let base = codec.components(j2kRctTiles) onerror recover JPEG2000Component[]
			let deep = codec.components(deepen(31)) onerror recover JPEG2000Component[]
			let widest = codec.components(deepen(38)) onerror recover JPEG2000Component[]
			assert base.len() == 3
			assert deep.len() == 3
			assert widest.len() == 3
			assert deep[1].precision == 31
			assert widest[1].precision == 38
			assert widest[1].samples.len() == 0
			for let i = 0; i < base[1].samples.len(); i++ {
				let v = int(base[1].samples[i]) - 128
				assert int(deep[1].samples[i]) == v + (1 << 30)
				assert int(widest[1].wide[i]) == v + (1 << 37)
			}
			// At 8 bits the 38-bit samples, all within 2^8 of the middle of
			// their range, show as mid grey.
			let img38 = decodeOr(new JPEG2000(), deepen(38))
			assert width(img38) == 32
			for let (_, v) in img38.raw() {
				assert int(v) == 127 || int(v) == 128 || int(v) == 255
			}
		}

		@test()
		def fails_on_damaged_data() {
			let codec = new JPEG2000()
			let failed = false
			codec.decode(byte[0xFF, 0x4F, 0xFF, 0x51, 0, 2]) onerror (err error) {
				failed = true
				recover new Image(1, 1)
			}
			assert failed
			// A codestream cut in its packets decodes what is there.
			let cut = j2kRctTiles[0:j2kRctTiles.len() / 2].clone()
			let img = decodeOr(codec, cut)
			assert width(img) == 32
		}

		@test()
		def round_trips_losslessly() {
			let sources = Image[decodeOr(new JPEG2000(), j2kRctTiles), decodeOr(new JPEG2000(), j2kAlpha), decodeOr(new JPEG2000(), j2kGrey16)]
			for let (_, src) in sources {
				for let tiles = 0; tiles <= 1; tiles++ {
					let codec = new JPEG2000()
					codec.layers = 3
					codec.tileSize = tiles == 1 ?? (13, 0)
					let data = codec.encode(src) onerror recover byte[]
					assert data.len() > 12
					assert jp2IsFile(data)
					let back = decodeOr(new JPEG2000(), data)
					assert width(back) == width(src)
					assert fnv(back.raw()) == fnv(src.raw())
					// The first layer alone is a coarser image.
					let first = new JPEG2000()
					first.layers = 1
					let rough = decodeOr(first, data)
					assert psnr(src, rough) < 100.0
					assert psnr(src, rough) > 20.0
				}
			}
		}

		@test()
		def encodes_grey_and_alpha_components() {
			let src = decodeOr(new JPEG2000(), j2kAlpha)
			let codec = new JPEG2000()
			let data = codec.encode(src) onerror recover byte[]
			let comps = new JPEG2000().components(data) onerror recover JPEG2000Component[]
			assert comps.len() == 4
			let grey = decodeOr(new JPEG2000(), j2kGrey16)
			let gdata = codec.encode(grey) onerror recover byte[]
			let gcomps = new JPEG2000().components(gdata) onerror recover JPEG2000Component[]
			assert gcomps.len() == 1
		}

		@test()
		def encodes_lossy_at_a_quality() {
			let src = decodeOr(new JPEG2000(), j2kRctTiles)
			let codec = new JPEG2000()
			codec.lossy = true
			codec.quality = 90
			let good = codec.encode(src) onerror recover byte[]
			codec.quality = 20
			let small = codec.encode(src) onerror recover byte[]
			assert small.len() < good.len()
			let reader = new JPEG2000()
			let back = decodeOr(reader, good)
			assert reader.lossy
			assert psnr(src, back) > 35.0
			assert psnr(src, decodeOr(new JPEG2000(), small)) > 20.0
		}

		@test()
		def writes_codestreams_and_metadata() {
			let src = decodeOr(new JPEG2000(), j2kRctTiles)
			let raw = new J2K()
			raw.comments = string["made by adm"]
			let cs = raw.encode(src) onerror recover byte[]
			assert cs.len() > 4
			assert int(cs[0]) == 0xFF && int(cs[1]) == 0x4F && int(cs[2]) == 0xFF && int(cs[3]) == 0x51
			let reader = new J2K()
			let back = reader.decode(cs) onerror recover new Image(1, 1)
			assert fnv(back.raw()) == fnv(src.raw())
			assert reader.comments.len() == 1
			assert reader.comments[0] == "made by adm"

			let codec = new JPEG2000()
			codec.iccProfile = byte[1, 2, 3, 4, 5]
			codec.xResolution = 3780.0
			codec.yResolution = 2835.0
			let file = codec.encode(src) onerror recover byte[]
			let kept = new JPEG2000()
			decodeOr(kept, file)
			assert kept.iccProfile.len() == 5
			assert int(kept.iccProfile[4]) == 5
			assert kept.xResolution == 3780.0
			assert kept.yResolution == 2835.0
		}

		@test()
		def truncated_passes_decode_their_bit_planes() {
			// A 16 x 8 block coded by the encoder's tier-1, read back cut
			// after each pass: the decoder must see exactly the bit-planes
			// coded so far.
			let w = 16
			let h = 8
			let enc = new J2kT1Enc()
			enc.mag.len(w * h)
			enc.neg.len(w * h)
			enc.vals.len(w * h)
			let seed = 12345
			for let i = 0; i < w * h; i++ {
				seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
				let m = (seed >> 8) & 0x3FF
				m = m >> ((seed >> 4) & 7)
				enc.mag[i] = int32(m)
				enc.neg[i] = int32((seed >> 3) & 1)
				enc.vals[i] = float32(m)
			}
			let numbps = enc.encodeBlock(w, h, 3, causal = false, rev = true)
			assert numbps == 10
			let passes = enc.rates.len()
			assert passes == 3 * numbps - 2
			let full = enc.rates[passes - 1]
			let dec = new J2kT1()
			let ref = new J2kT1()
			ref.buf.len(full + 2)
			enc.out[1:full + 1].copy(ref.buf[0:full])
			for let k = 0; k < passes; k++ {
				// Cut after pass k, the block decodes as the whole codeword
				// does when told to stop there.
				let len = enc.rates[k]
				dec.buf.len(len + 2)
				enc.out[1:len + 1].copy(dec.buf[0:len])
				dec.decodeBlock(w, h, 3, 0, 0, numbps, int[len], int[k + 1])
				ref.decodeBlock(w, h, 3, 0, 0, numbps, int[full], int[k + 1])
				for let i = 0; i < w * h; i++ {
					assert dec.coef[i] == ref.coef[i]
				}
			}
			// All passes give the values back (at twice their size).
			for let i = 0; i < w * h; i++ {
				let m = int(enc.mag[i])
				let got = int(dec.coef[i]) / 2
				assert got == (int(enc.neg[i]) == 1 ?? (-m, m))
			}
		}
	}
}
