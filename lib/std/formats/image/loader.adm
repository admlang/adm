partial module std.formats.image {
	use (
		std.reflection
		std.os
		std.bytes
		std.formats
		std.io
	)

	// ImageCodec is what an image format registers: a decoder, an encoder and
	// the file format description.
	type ImageCodec = ImageDecoder & ImageEncoder & formats.FileFormat

	// codec registers a type as the image codec of the named format, found
	// through discovery.
	meta def codec<ImageCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	internal let codecRegistry = new formats.CodecRegistry<ImageCodec>("image", codec)

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	// Fails when no codec recognises the data, or decoding does.
	def load(data byte[]) !Image {
		let (dec, r) = try codecRegistry.probe(data)
		return dec.decode(r)
	}

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	// Fails when the file cannot be read, no codec recognises it, or decoding does.
	def load(path string) !Image {
		// The file has to stay open for the decode: `probe` hands back a reader
		// layered over it, so closing it here -- rather than after `decode` --
		// leaves the codec reading a dead descriptor for any file larger than
		// the probe's prebuffer.
		let f = try os.open(path)
		defer f.close()

		let (dec, r) = try codecRegistry.probe(f)
		return dec.decode(r)
	}

	// Load looks in the codecs store and tries to identify which codec can handle the given file.
	// Fails when no codec recognises the data, or decoding does.
	def load(reader io.Reader) !Image {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.decode(r)
	}

	// Info reads what the headers say -- dimensions, colour format, palette --
	// without decoding the pixels, so it stays cheap on a large image.
	// Fails when no codec recognises the data, or reading its headers does.
	def info(data byte[]) !ImageInfo {
		let (dec, r) = try codecRegistry.probe(data)
		return dec.info(r)
	}

	// Info reads what the headers say without decoding the pixels.
	// Fails when the file cannot be read, no codec recognises it, or reading its headers does.
	def info(path string) !ImageInfo {
		// Unlike an audio stream or an archive, this reads everything it needs
		// before returning, so closing the file here is safe.
		let f = try os.open(path)
		defer f.close()

		let (dec, r) = try codecRegistry.probe(f)
		return dec.info(r)
	}

	// Info reads what the headers say without decoding the pixels.
	// Fails when no codec recognises the data, or reading its headers does.
	def info(reader io.Reader) !ImageInfo {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.info(r)
	}
}
