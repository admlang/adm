partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.formats.image.pcx::*
	)

	// PCX is the ZSoft Paintbrush codec. It decodes 1-bit monochrome, 1-bit
	// planar EGA (2 to 4 planes), 2, 4 and 8-bit paletted and 24 and 32-bit
	// (3 or 4 planes) images, run-length encoded or raw. It encodes 8-bit
	// paletted when the image is opaque with at most 256 colours, else 24-bit
	// in three planes; alpha is dropped.
	@codec("Picture Exchange")
	type PCX {
		mimeType string[] {
			def get() string[] {
				return string["image/x-pcx"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".pcx"]
			}
		}

		// matchSignature reports whether the reader starts with the PCX manufacturer
		// byte, a known version and encoding, and a pixel layout the codec reads.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(pcxHeaderLen)
			let n = io.readFull(r, b) onerror recover 0
			return false when n != pcxHeaderLen
			return false unless b[0] == 0x0A
			return false unless b[1] := 0 || 2 || 3 || 4 || 5
			return false unless b[2] := 0 || 1
			let h = pcxParseHeader(b)
			return pcxLayoutValid(h)
		}

		// info reads the dimensions and pixel format from the bytes. Fails when they
		// are not a PCX header.
		def info(data byte[]) !ImageInfo {
			let h = try pcxReadHeader(data)
			let format = color.ColorFormat.Palette
			format = color.ColorFormat.RGB when h.planes == 3
			format = color.ColorFormat.RGBA when h.planes == 4
			return ImageInfo{
				size: new geom.Size(float(h.width), float(h.height)),
				colorFormat: format,
			}
		}

		// info reads the dimensions and pixel format from the reader. Fails when the
		// data is not a PCX header, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let b byte[]
			b.len(pcxHeaderLen)
			try io.readFull(reader, b)
			return info(b)
		}

		// decode reads a PCX image from the bytes. Fails when they are not a
		// PCX the codec understands, or are truncated.
		def decode(data byte[]) !Image {
			let h = try pcxReadHeader(data)
			let w = h.width
			let ht = h.height
			const maxPixels = 256 * 1024 * 1024
			fail "pcx: image too large" when w > maxPixels / ht
			fail "pcx: bytes per line too small" when h.bytesPerLine * 8 < w * h.bitsPerPlane

			// Palette as RGB, 3 bytes per entry.
			let pal = h.egaPalette
			let bits = h.bitsPerPlane * h.planes
			if bits == 8 {
				let n = data.len()
				if h.version >= 5 && n >= pcxHeaderLen + 769 && data[n - 769] == pcxPaletteMarker {
					pal = data[n - 768:n]
				} else {
					// No palette: a grey ramp.
					pal.len(768)
					for let i = 0; i < 256; i++ {
						pal[i * 3], pal[i * 3 + 1], pal[i * 3 + 2] = byte(i), byte(i), byte(i)
					}
				}
			} else if bits == 1 && pal[0] == pal[3] && pal[1] == pal[4] && pal[2] == pal[5] {
				// Monochrome without a usable palette: black and white.
				pal = byte[0, 0, 0, 255, 255, 255]
			}

			let img = new Image(w, ht)
			let px = img.raw()
			let stride = img.stride()
			let lineLen = h.bytesPerLine * h.planes
			let line byte[]
			line.len(lineLen)
			let src = pcxHeaderLen
			// A run may carry over from one scan line into the next.
			let runLeft = 0
			let runByte = byte(0)
			let bpl = h.bytesPerLine

			for let y = 0; y < ht; y++ {
				let i = 0
				if h.method == 0 {
					fail "pcx: truncated pixel data" when src + lineLen > data.len()
					for i < lineLen {
						line[i] = data[src + i]
						i++
					}
					src += lineLen
				} else {
					for i < lineLen {
						if runLeft > 0 {
							line[i] = runByte
							runLeft--
							i++
							continue
						}
						fail "pcx: truncated pixel data" when src >= data.len()
						let c = data[src]
						src++
						if c >= 0xC0 {
							fail "pcx: truncated pixel data" when src >= data.len()
							runLeft = int(c & 0x3F)
							runByte = data[src]
							src++
						} else {
							line[i] = c
							i++
						}
					}
				}

				let d = y * stride
				if h.bitsPerPlane == 8 && h.planes >= 3 {
					for let x = 0; x < w; x++ {
						px[d] = line[x]
						px[d + 1] = line[bpl + x]
						px[d + 2] = line[2 * bpl + x]
						px[d + 3] = h.planes == 4 ?? (line[3 * bpl + x], byte(255))
						d += 4
					}
				} else if h.planes == 1 {
					let bpp = h.bitsPerPlane
					let mask = (1 << bpp) - 1
					for let x = 0; x < w; x++ {
						let bit = x * bpp
						let idx = (int(line[bit >> 3]) >> (8 - bpp - (bit & 7))) & mask
						pcxPutIndex(px, d, pal, idx)
						d += 4
					}
				} else {
					// 1-bit planes, one bit of the index per plane.
					for let x = 0; x < w; x++ {
						let idx = 0
						let shift = 7 - (x & 7)
						for let p = 0; p < h.planes; p++ {
							idx |= ((int(line[p * bpl + (x >> 3)]) >> shift) & 1) << p
						}
						pcxPutIndex(px, d, pal, idx)
						d += 4
					}
				}
			}
			return img
		}

		// decode reads a PCX image from the reader. Fails when the data is not a
		// PCX the codec understands, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// encode renders the image as run-length encoded PCX: 8-bit paletted when
		// it is opaque with at most 256 colours, else 24-bit in three planes. Fails
		// when the image is empty or larger than 65535 pixels on a side.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as PCX to the writer; see the byte overload for
		// the layout. Fails with the writer's error, or when the image is larger
		// than PCX's 65535 pixel limit.
		def encode(img Image, writer io.Writer) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			fail "pcx: empty image" when w <= 0 || h <= 0
			fail "pcx: image larger than 65535 pixels" when w > 65535 || h > 65535
			let px = img.raw()
			let stride = img.stride()

			// The palette while there are at most 256 colours and every pixel is opaque.
			let index = new map<int, int>()
			let colors int[]
			let paletted = true
			for let y = 0; y < h && paletted; y++ {
				let o = y * stride
				for let x = 0; x < w; x++ {
					if px[o + 3] != 255 {
						paletted = false
						break
					}
					let key = int(px[o]) << 16 | int(px[o + 1]) << 8 | int(px[o + 2])
					if !index.hasKey(key) {
						if colors.len() == 256 {
							paletted = false
							break
						}
						index.set(key, colors.len())
						colors.push(key)
					}
					o += 4
				}
			}

			let planes = paletted ?? (1, 3)
			let bpl = (w + 1) / 2 * 2
			// Worst case: every byte escaped as a run of one.
			let size = pcxHeaderLen + h * planes * bpl * 2 + 769
			let out byte[]
			out.len(size)
			out[0] = 0x0A
			out[1] = 5
			out[2] = 1
			out[3] = 8
			pcxPut16(out, 8, w - 1)
			pcxPut16(out, 10, h - 1)
			pcxPut16(out, 12, 72)
			pcxPut16(out, 14, 72)
			out[65] = byte(planes)
			pcxPut16(out, 66, bpl)
			pcxPut16(out, 68, 1)

			let line byte[]
			line.len(bpl)
			let o = pcxHeaderLen
			for let y = 0; y < h; y++ {
				let row = y * stride
				for let p = 0; p < planes; p++ {
					for let x = 0; x < w; x++ {
						let s = row + x * 4
						if paletted {
							line[x] = byte(index[int(px[s]) << 16 | int(px[s + 1]) << 8 | int(px[s + 2])])
						} else {
							line[x] = px[s + p]
						}
					}
					o = pcxPutLine(out, o, line)
				}
			}

			if paletted {
				out[o] = pcxPaletteMarker
				o++
				for let (i, c) in colors {
					out[o + i * 3] = byte((c >> 16) & 0xFF)
					out[o + i * 3 + 1] = byte((c >> 8) & 0xFF)
					out[o + i * 3 + 2] = byte(c & 0xFF)
				}
				o += 768
			}
			try writer.write(out[0:o])
		}
	}
}

internal partial module std.formats.image.pcx {
	use std.formats.image::*

	const (
		pcxHeaderLen     = 128
		pcxPaletteMarker = 0x0C
	)

	// The PCX header fields the codec uses.
	struct PcxHeader {
		// Paintbrush version: 0 (2.5, fixed EGA palette), 2 (2.8 with palette),
		// 3 (2.8 without), 4 (Windows), 5 (3.0, 256 colours and 24-bit).
		version      int
		// 0 raw, 1 run-length encoded.
		method       int
		bitsPerPlane int
		width        int
		height       int
		planes       int
		// Bytes of one plane of one scan line, even and possibly padded.
		bytesPerLine int
		// The 16-colour palette in the header, RGB.
		egaPalette   byte[]
	}

	def pcxParseHeader(b byte[]) PcxHeader {
		let minX = int(b[4]) | int(b[5]) << 8
		let minY = int(b[6]) | int(b[7]) << 8
		let maxX = int(b[8]) | int(b[9]) << 8
		let maxY = int(b[10]) | int(b[11]) << 8
		return PcxHeader{
			version: int(b[1]),
			method: int(b[2]),
			bitsPerPlane: int(b[3]),
			width: maxX - minX + 1,
			height: maxY - minY + 1,
			planes: int(b[65]),
			bytesPerLine: int(b[66]) | int(b[67]) << 8,
			egaPalette: b[16:64].clone(),
		}
	}

	// Whether the header's pixel layout is one the codec decodes.
	def pcxLayoutValid(h PcxHeader) bool {
		return false when h.width <= 0 || h.height <= 0 || h.bytesPerLine == 0
		switch h.bitsPerPlane {
			case 1:
				return h.planes >= 1 && h.planes <= 4
			case 2, 4:
				return h.planes == 1
			case 8:
				return h.planes == 1 || h.planes == 3 || h.planes == 4
		}
		return false
	}

	def pcxReadHeader(data byte[]) !PcxHeader {
		fail "pcx: truncated header" when data.len() < pcxHeaderLen
		fail "pcx: not a PCX file" when data[0] != 0x0A || data[2] > 1
		let h = pcxParseHeader(data)
		fail "pcx: unsupported layout, {h.bitsPerPlane} bits in {h.planes} planes" unless pcxLayoutValid(h)
		return h
	}

	// Writes palette entry `idx` as an opaque RGBA pixel at `d`; indexes past
	// the palette are black.
	def pcxPutIndex(px byte[], d int, pal byte[], idx int) {
		let p = idx * 3
		if p + 2 < pal.len() {
			px[d] = pal[p]
			px[d + 1] = pal[p + 1]
			px[d + 2] = pal[p + 2]
		} else {
			px[d], px[d + 1], px[d + 2] = byte(0), byte(0), byte(0)
		}
		px[d + 3] = byte(255)
	}

	// Run-length encodes one plane of a scan line at `o`; returns the next offset.
	def pcxPutLine(out byte[], o int, line byte[]) int {
		let n = line.len()
		let i = 0
		for i < n {
			let v = line[i]
			let run = 1
			for i + run < n && run < 63 && line[i + run] == v {
				run++
			}
			if run > 1 || v >= 0xC0 {
				out[o] = byte(0xC0 | run)
				out[o + 1] = v
				o += 2
			} else {
				out[o] = v
				o++
			}
			i += run
		}
		return o
	}

	def pcxPut16(out byte[], o int, v int) {
		out[o] = byte(v & 0xFF)
		out[o + 1] = byte((v >> 8) & 0xFF)
	}
}
