partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.reflection
	)

	internal struct pcxHeader {
	    // The fixed header field valued at a hexadecimal 0x0A
	    headerField uint8
	    // The version number refering to the Paintbrush software version.
	    // 0 - version 2.5 using a fixed EGA palette
	    // 2 - version 2.8 using a modifiable EGA palette
	    // 3 - version 2.8 using no palette
	    // 4 - windows version
	    // 5 - version 3.0 including 24-bit images
	    version uint8
	    // The method used for encoding the image.
	    // 0 - no encoding (rarely used)
	    // 1 - RLE
	    method uint8
	    // The number of bits constituting one plane. Most often 1, 2, 4 or 8
	    bitsPerPlane uint8
	    //The minimum x co-ordinate of the image position.
	    minX uint16
	    // The minimum y co-ordinate of the image position.
        minY uint16
        //The maximum x co-ordinate of the image position.
	    maxX uint16
	    //The maximum y co-ordinate of the image position.
        maxY uint16
        // The horizontal image resolution in DPI.
        xDPI uint16
        // The vertical image resolution in DPI.
        yDPI uint16
        // The EGA palette for 16-color images. 48 bytes
        egaPalette byte[]
        // The first reserved field, usually set to zero.
        reserved uint8
        // The number of color planes constituting the pixel data. Mostly chosen to be 1, 3, or 4.
        numPlanes uint8
        // The number of bytes of one color plane representing a single scan line.
        bytesPerLine uint16
        // The mode in which to construe the palette:
        // 1 - The palette contains monochrome or color information.
        // 2 - The palette contrains grayscale information
        paletteType uint16
        // The horizontal resolution of the source system's screen.
        sourceWidth uint16
        // The vertical resolution of the source system's screen.
        sourceHeight uint16
        // The second reserved field, intended for future extensions, and usually set to zero bytes.
        extensions byte[]
	}

	@codec("Picture Exchange")
	type PCX {
        internal header pcxHeader

		mimeType string[] {
			def get() string[] {
				return string["image/x-pcx"]
			}
		}

		extension string[] {
			def get() string[] {
				return string[".pcx"]
			}
		}

		def matchSignature(r io.Reader) bool {
		    let b byte[]
            b.len(128)

            let n = r.read(b) onerror recover 0
            return false when n != 128

            return false unless b[0] != 0x0A
            return false unless b[1] := 0x00 || 0x02 || 0x03 || 0x04 || 0x05
            return false unless b[2] := 0x00 || 0x01

			return true
		}

		def info(data byte[]) !ImageInfo {
		    return info(new bytes.Buffer(data))
		}

		def info(reader io.Reader) !ImageInfo {
		    let b byte[]
			b.len(128)
			b[:] = 0

			try reader.read(b)
			let r = new bytes.Reader(b)

		    let haeder pcxHeader = pcxHeader{}
		    header.headerField = try r.read<uint8>()
		    header.version = try r.read<uint8>()
            header.method = try r.read<uint8>()
            header.bitsPerPlane = try r.read<uint8>()
            header.minX = try r.read<uint16>()
            header.minY = try r.read<uint16>()
            header.maxX = try r.read<uint16>()
            header.maxY = try r.read<uint16>()
            header.xDPI = try r.read<uint16>()
            header.yDPI = try r.read<uint16>()

            header.egaPalette.len(48)
            try r.read(header.egaPalette)

            header.reserved = try r.read<uint8>()
            header.numPlanes = try r.read<uint8>()
            header.bytesPerLine = try r.read<uint16>()
            header.paletteType = try r.read<uint16>()
            header.sourceWidth = try r.read<uint16>()
            header.sourceHeight = try r.read<uint16>()

            header.extensions.len(54)
            try r.read(header.extensions)

			return ImageInfo{
			    size: new geom.Size(float(header.maxX - header.minX), float(header.maxY - header.minY)),
			    colorFormat: color.ColorFormat.RGBA,
			}
		}

		def decode(data byte[]) !Image {
			return decode(new bytes.Buffer(data))
		}

		def decode(reader io.Reader) !Image {
			try info(reader)
			fail "Not implemented"
		}

		def encode() byte[] {}


		def encode(writer io.Writer) !none {}
	}
}
