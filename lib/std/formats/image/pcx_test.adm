partial module std.formats.image {
	use (
		std.testing
		std.bytes
	)

	check "PCX" {
		internal def assertPixel(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			assert int(img.raw()[o]) == r
			assert int(img.raw()[o + 1]) == g
			assert int(img.raw()[o + 2]) == b
			assert int(img.raw()[o + 3]) == a
		}

		// A 128-byte header; the EGA palette holds black, white, red, green.
		internal def header(method int, bits int, planes int, w int, h int, bpl int) byte[] {
			let b byte[]
			b.len(128)
			b[0], b[1], b[2], b[3] = byte(0x0A), byte(5), byte(method), byte(bits)
			b[8], b[10] = byte(w - 1), byte(h - 1)
			b[65], b[66] = byte(planes), byte(bpl)
			let pal = byte[0, 0, 0, 255, 255, 255, 255, 0, 0, 0, 255, 0]
			for let i = 0; i < pal.len(); i++ {
				b[16 + i] = pal[i]
			}
			return b
		}

		internal def decodeOr(data byte[]) Image {
			let codec = new PCX()
			return codec.decode(data) onerror recover new Image(1, 1)
		}

		internal def gradient(w int, h int, alpha int) Image {
			let img = new Image(w, h)
			let px = img.raw()
			for let i = 0; i < px.len(); i += 4 {
				let p = i / 4
				px[i], px[i + 1], px[i + 2], px[i + 3] = byte(p % 251), byte(p / 3 % 256), byte(0xC7), byte(alpha)
			}
			return img
		}

		@test()
		def decodes_24_bit_planes_with_runs_across_lines() {
			// Two lines of 2 pixels in 3 planes; the run of 7 ends line 1's blue
			// plane and starts line 2's red one.
			let data = header(1, 8, 3, 2, 2, 2) + byte[0xC4, 200, 0xC3, 7, 0xC2, 1, 0xC3, 3]
			let img = decodeOr(data)
			assertPixel(img, 0, 0, 200, 200, 7, 255)
			assertPixel(img, 1, 0, 200, 200, 7, 255)
			assertPixel(img, 0, 1, 7, 1, 3, 255)
			assertPixel(img, 1, 1, 1, 3, 3, 255)
		}

		@test()
		def decodes_8_bit_with_the_trailing_palette() {
			let pal byte[]
			pal.len(769)
			pal[0] = 0x0C
			pal[1 + 3 * 5], pal[2 + 3 * 5], pal[3 + 3 * 5] = byte(10), byte(20), byte(30)
			let data = header(0, 8, 1, 3, 1, 4) + byte[5, 0, 5, 0] + pal
			let img = decodeOr(data)
			assertPixel(img, 0, 0, 10, 20, 30, 255)
			assertPixel(img, 1, 0, 0, 0, 0, 255)
			assertPixel(img, 2, 0, 10, 20, 30, 255)
		}

		@test()
		def decodes_32_bit_planes() {
			let img = decodeOr(header(0, 8, 4, 1, 1, 2) + byte[1, 0, 2, 0, 3, 0, 4, 0])
			assertPixel(img, 0, 0, 1, 2, 3, 4)
		}

		@test()
		def decodes_packed_and_planar_palettes() {
			// 1 bit: 0b10100000.
			let img = decodeOr(header(0, 1, 1, 3, 1, 2) + byte[0xA0, 0])
			assertPixel(img, 0, 0, 255, 255, 255, 255)
			assertPixel(img, 1, 0, 0, 0, 0, 255)
			assertPixel(img, 2, 0, 255, 255, 255, 255)
			// 2 bits: indexes 2, 3, 1.
			img = decodeOr(header(0, 2, 1, 3, 1, 2) + byte[0xB4, 0])
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 1, 0, 0, 255, 0, 255)
			assertPixel(img, 2, 0, 255, 255, 255, 255)
			// 4 bits: indexes 3, 2.
			img = decodeOr(header(0, 4, 1, 2, 1, 2) + byte[0x32, 0])
			assertPixel(img, 0, 0, 0, 255, 0, 255)
			assertPixel(img, 1, 0, 255, 0, 0, 255)
			// Two 1-bit planes: pixel 0 has plane bits 0 and 1 set (index 3),
			// pixel 1 only plane 1 (index 2).
			img = decodeOr(header(0, 1, 2, 2, 1, 2) + byte[0x80, 0, 0xC0, 0])
			assertPixel(img, 0, 0, 0, 255, 0, 255)
			assertPixel(img, 1, 0, 255, 0, 0, 255)
		}

		@test()
		def round_trips_true_colour() {
			let img = gradient(301, 5, 255)
			let codec = new PCX()
			let data = codec.encode(img) onerror recover byte[]
			assert int(data[65]) == 3
			assert int(data[66]) | int(data[67]) << 8 == 302
			let back = decodeOr(data)
			assert back.raw().equals(img.raw())
		}

		@test()
		def drops_alpha() {
			let img = gradient(3, 2, 100)
			let codec = new PCX()
			let data = codec.encode(img) onerror recover byte[]
			let back = decodeOr(data)
			assertPixel(back, 1, 0, 1, 0, 0xC7, 255)
		}

		@test()
		def round_trips_a_palette() {
			let img = new Image(9, 4)
			let px = img.raw()
			for let i = 0; i < px.len(); i += 4 {
				let p = i / 4 % 5
				px[i], px[i + 1], px[i + 2], px[i + 3] = byte(p * 50), byte(0xC0 + p), byte(9), byte(255)
			}
			let codec = new PCX()
			let data = codec.encode(img) onerror recover byte[]
			assert int(data[65]) == 1
			assert int(data[data.len() - 769]) == 0x0C
			let back = decodeOr(data)
			assert back.raw().equals(px)
		}

		@test()
		def info_and_signature() {
			let codec = new PCX()
			let hdr = header(1, 8, 3, 7, 5, 8)
			let got = codec.info(hdr) onerror recover ImageInfo{}
			assert int(got.size.width) == 7
			assert int(got.size.height) == 5
			assert codec.matchSignature(new bytes.Reader(hdr))
			assert !codec.matchSignature(new bytes.Reader(header(1, 8, 2, 7, 5, 8)))
			assert !codec.matchSignature(new bytes.Reader(byte[0x0A, 5, 1, 8]))
		}

		@test()
		def rejects_corrupt_input() {
			let codec = new PCX()
			let img = codec.decode(header(1, 8, 3, 2, 2, 2) + byte[0xC4, 200]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
			img = codec.decode(header(0, 8, 3, 2, 2, 2) + byte[1, 2, 3]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
			img = codec.decode(header(0, 16, 1, 2, 2, 4)) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
			img = codec.decode(byte[0x0A, 5]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
		}
	}
}
