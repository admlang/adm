partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.reflection
		std.data.compress.zlib
	)

	internal const (
		ctGrayscale      = 0
		ctTrueColor      = 2
		ctPaletted       = 3
		ctGrayscaleAlpha = 4
		ctTrueColorAlpha = 6
	)

	internal const pngSignature = byte[137, 80, 78, 71, 13, 10, 26, 10]

	// Adam7 puts the image out in seven passes; each row below is one pass's
	// first column, first row, column step and row step.
	internal const pngAdam7 = int[
		0, 0, 8, 8,
		4, 0, 8, 8,
		0, 4, 4, 8,
		2, 0, 4, 4,
		0, 2, 2, 4,
		1, 0, 2, 2,
		0, 1, 1, 2
	]

	internal def pngPaeth(a int, b int, c int) int {
		let p = a + b - c
		let pa = p - a
		pa = 0 - pa when pa < 0
		let pb = p - b
		pb = 0 - pb when pb < 0
		let pc = p - c
		pc = 0 - pc when pc < 0
		return a when pa <= pb && pa <= pc
		return b when pb <= pc
		return c
	}

	// Channels carried per pixel by each colour type.
	internal def pngChannels(colorType int) int {
		return 1 when colorType == ctGrayscale || colorType == ctPaletted
		return 3 when colorType == ctTrueColor
		return 2 when colorType == ctGrayscaleAlpha
		return 4
	}

	@codec("Portable Network Graphics")
	type PNG {
		mimeType string[] {
			def get() string[] {
				return string["image/png"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".png"]
			}
		}

		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(8)
			let n = r.read(b) onerror recover 0
			return false when n != 8
			for let i = 0; i < 8; i++ {
				return false when b[i] != pngSignature[i]
			}
			return true
		}

		def info(data byte[]) !ImageInfo {
			fail "not a PNG" when data.len() < 33
			for let i = 0; i < 8; i++ {
				fail "not a PNG" when data[i] != pngSignature[i]
			}
			// The header chunk is required to come first.
			fail "corrupt PNG: missing header" unless data[12] == byte(73) && data[13] == byte(72) && data[14] == byte(68) && data[15] == byte(82)
			let width = int(data[16]) << 24 | int(data[17]) << 16 | int(data[18]) << 8 | int(data[19])
			let height = int(data[20]) << 24 | int(data[21]) << 16 | int(data[22]) << 8 | int(data[23])
			fail "invalid PNG dimensions" when width <= 0 || height <= 0
			let colorType = int(data[25])
			let format = color.ColorFormat.RGBA
			format = color.ColorFormat.Palette when colorType == ctPaletted
			return ImageInfo{
				size: new geom.Size(float(width), float(height)),
				colorFormat: format,
			}
		}

		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		def decode(data byte[]) !Image {
			fail "not a PNG" when data.len() < 8
			for let i = 0; i < 8; i++ {
				fail "not a PNG" when data[i] != pngSignature[i]
			}

			let width = 0
			let height = 0
			let bitDepth = 0
			let colorType = 0
			let interlace = 0
			let sawHeader = false
			let palette byte[]
			let trans byte[]
			let idat byte[]

			let pos = 8
			for pos + 8 <= data.len() {
				let length = int(data[pos]) << 24 | int(data[pos + 1]) << 16 | int(data[pos + 2]) << 8 | int(data[pos + 3])
				fail "corrupt PNG: bad chunk length" when length < 0
				let kind = pos + 4
				let body = pos + 8
				fail "truncated PNG chunk" when body + length + 4 > data.len()

				let c0 = int(data[kind])
				let c1 = int(data[kind + 1])
				let c2 = int(data[kind + 2])
				let c3 = int(data[kind + 3])

				if c0 == 73 && c1 == 72 && c2 == 68 && c3 == 82 {
					// IHDR
					fail "corrupt PNG: short header" when length < 13
					width = int(data[body]) << 24 | int(data[body + 1]) << 16 | int(data[body + 2]) << 8 | int(data[body + 3])
					height = int(data[body + 4]) << 24 | int(data[body + 5]) << 16 | int(data[body + 6]) << 8 | int(data[body + 7])
					bitDepth = int(data[body + 8])
					colorType = int(data[body + 9])
					interlace = int(data[body + 12])
					fail "invalid PNG dimensions" when width <= 0 || height <= 0
					fail "unsupported PNG compression method" when int(data[body + 10]) != 0
					fail "unsupported PNG filter method" when int(data[body + 11]) != 0
					fail "unsupported PNG interlace method" when interlace != 0 && interlace != 1
					try validateDepth(colorType, bitDepth)
					sawHeader = true
				} else if c0 == 80 && c1 == 76 && c2 == 84 && c3 == 69 {
					// PLTE
					for let i = 0; i < length; i++ {
						palette.push(data[body + i])
					}
				} else if c0 == 116 && c1 == 82 && c2 == 78 && c3 == 83 {
					// tRNS
					for let i = 0; i < length; i++ {
						trans.push(data[body + i])
					}
				} else if c0 == 73 && c1 == 68 && c2 == 65 && c3 == 84 {
					// IDAT
					for let i = 0; i < length; i++ {
						idat.push(data[body + i])
					}
				} else if c0 == 73 && c1 == 69 && c2 == 78 && c3 == 68 {
					// IEND
					break
				}

				pos = body + length + 4
			}

			fail "corrupt PNG: no header" unless sawHeader
			fail "corrupt PNG: no image data" when idat.len() == 0
			fail "corrupt PNG: paletted image without a palette" when colorType == ctPaletted && palette.len() == 0

			let channels = pngChannels(colorType)
			let expected = expectedRawSize(width, height, channels, bitDepth, interlace)
			let raw = try zlib.decompress(idat, expected)
			fail "corrupt PNG: image data ended early" when raw.len() < expected

			let img = new Image(width, height)
			if interlace == 0 {
				try renderPass(img, raw, 0, width, height, 0, 0, 1, 1, channels, bitDepth, colorType, palette, trans)
			} else {
				let off = 0
				for let p = 0; p < 7; p++ {
					let xOrig = pngAdam7[p * 4]
					let yOrig = pngAdam7[p * 4 + 1]
					let xStep = pngAdam7[p * 4 + 2]
					let yStep = pngAdam7[p * 4 + 3]
					let pw = passCount(width, xOrig, xStep)
					let ph = passCount(height, yOrig, yStep)
					if pw > 0 && ph > 0 {
						try renderPass(img, raw, off, pw, ph, xOrig, yOrig, xStep, yStep, channels, bitDepth, colorType, palette, trans)
						off += ph * (1 + rowBytes(pw, channels, bitDepth))
					}
				}
			}
			return img
		}

		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		internal def validateDepth(colorType int, bitDepth int) !none {
			if colorType == ctGrayscale {
				fail "unsupported PNG bit depth" unless bitDepth == 1 || bitDepth == 2 || bitDepth == 4 || bitDepth == 8 || bitDepth == 16
				return none
			}
			if colorType == ctPaletted {
				fail "unsupported PNG bit depth" unless bitDepth == 1 || bitDepth == 2 || bitDepth == 4 || bitDepth == 8
				return none
			}
			fail "unsupported PNG colour type" unless colorType == ctTrueColor || colorType == ctGrayscaleAlpha || colorType == ctTrueColorAlpha
			fail "unsupported PNG bit depth" unless bitDepth == 8 || bitDepth == 16
		}

		internal def narrow16(cur byte[], at int) int {
			let v = (int(cur[at]) << 8) | int(cur[at + 1])
			return (v + 128) / 257
		}

		internal def passCount(total int, origin int, step int) int {
			return 0 when total <= origin
			return (total - origin + step - 1) / step
		}

		internal def rowBytes(w int, channels int, bitDepth int) int {
			return (w * channels * bitDepth + 7) / 8
		}

		internal def expectedRawSize(width int, height int, channels int, bitDepth int, interlace int) int {
			if interlace == 0 {
				return height * (1 + rowBytes(width, channels, bitDepth))
			}
			let total = 0
			for let p = 0; p < 7; p++ {
				let pw = passCount(width, pngAdam7[p * 4], pngAdam7[p * 4 + 2])
				let ph = passCount(height, pngAdam7[p * 4 + 1], pngAdam7[p * 4 + 3])
				total += ph * (1 + rowBytes(pw, channels, bitDepth)) when pw > 0 && ph > 0
			}
			return total
		}

		// Unfilters one pass and writes its pixels into the image.
		internal def renderPass(img Image, raw byte[], rawOff int, pw int, ph int, xOrig int, yOrig int, xStep int, yStep int, channels int, bitDepth int, colorType int, palette byte[], trans byte[]) !none {
			let stride = rowBytes(pw, channels, bitDepth)
			let bpp = (channels * bitDepth + 7) / 8

			let prev byte[]
			prev.len(stride)
			prev[:] = 0
			let cur byte[]
			cur.len(stride)
			cur[:] = 0

			let off = rawOff
			for let row = 0; row < ph; row++ {
				fail "corrupt PNG: image data ended early" when off + 1 + stride > raw.len()
				let filter = int(raw[off])
				off++

				for let i = 0; i < stride; i++ {
					let x = int(raw[off + i])
					let a = 0
					a = int(cur[i - bpp]) when i >= bpp
					let b = int(prev[i])
					let c = 0
					c = int(prev[i - bpp]) when i >= bpp
					if filter == 1 {
						x += a
					} else if filter == 2 {
						x += b
					} else if filter == 3 {
						x += (a + b) / 2
					} else if filter == 4 {
						x += pngPaeth(a, b, c)
					} else {
						fail "unsupported PNG filter type" when filter != 0
					}
					cur[i] = byte(x & 0xFF)
				}
				off += stride

				try emitRow(img, cur, pw, yOrig + row * yStep, xOrig, xStep, channels, bitDepth, colorType, palette, trans)

				for let i = 0; i < stride; i++ {
					prev[i] = cur[i]
				}
			}
		}

		internal def emitRow(img Image, cur byte[], pw int, y int, xOrig int, xStep int, channels int, bitDepth int, colorType int, palette byte[], trans byte[]) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			return none when y < 0 || y >= h

			let px = img.raw()

			for let i = 0; i < pw; i++ {
				let x = xOrig + i * xStep
				break when x >= w

				let r = 0
				let g = 0
				let b = 0
				let a = 255

				if bitDepth == 8 {
					let base = i * channels
					if colorType == ctGrayscale {
						r = int(cur[base])
						g = r
						b = r
						a = 0 when trans.len() >= 2 && r == int(trans[1])
					} else if colorType == ctTrueColor {
						r = int(cur[base])
						g = int(cur[base+1])
						b = int(cur[base+2])
						a = 0 when trans.len() >= 6 && r == int(trans[1]) && g == int(trans[3]) && b == int(trans[5])
					} else if colorType == ctPaletted {
						let idx = int(cur[base])
						fail "corrupt PNG: palette index out of range" when idx * 3 + 2 >= palette.len()
						r = int(palette[idx * 3])
						g = int(palette[idx * 3 + 1])
						b = int(palette[idx * 3 + 2])
						a = int(trans[idx]) when idx < trans.len()
					} else if colorType == ctGrayscaleAlpha {
						r = int(cur[base])
						g = r
						b = r
						a = int(cur[base+1])
					} else {
						r = int(cur[base])
						g = int(cur[base+1])
						b = int(cur[base+2])
						a = int(cur[base+3])
					}
				} else if bitDepth == 16 {
					// Sixteen-bit samples are reduced to eight, rounding.
					let base = i * channels * 2
					if colorType == ctGrayscale {
						r = narrow16(cur, base)
						g = r
						b = r
					} else if colorType == ctTrueColor {
						r = narrow16(cur, base)
						g = narrow16(cur, base + 2)
						b = narrow16(cur, base + 4)
					} else if colorType == ctGrayscaleAlpha {
						r = narrow16(cur, base)
						g = r
						b = r
						a = narrow16(cur, base + 2)
					} else {
						r = narrow16(cur, base)
						g = narrow16(cur, base + 2)
						b = narrow16(cur, base + 4)
						a = narrow16(cur, base + 6)
					}
				} else {
					// One, two and four bit samples are packed big-endian.
					let bitPos = i * bitDepth
					let byteIdx = bitPos / 8
					let shift = 8 - bitDepth - (bitPos % 8)
					let mask = (1 << bitDepth) - 1
					let v = (int(cur[byteIdx]) >> shift) & mask
					if colorType == ctPaletted {
						fail "corrupt PNG: palette index out of range" when v * 3 + 2 >= palette.len()
						r = int(palette[v * 3])
						g = int(palette[v * 3 + 1])
						b = int(palette[v * 3 + 2])
						a = int(trans[v]) when v < trans.len()
					} else {
						// Grayscale: scale the sample up to the full range.
						r = v * 255 / mask
						g = r
						b = r
					}
				}

				let o = img.pixelOffset(x, y)
				px[o] = byte(r)
				px[o + 1] = byte(g)
				px[o + 2] = byte(b)
				px[o + 3] = byte(a)
			}
		}

		def encode() byte[] {}

		def encode(writer io.Writer) !none {}
	}
}
