partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.data.compress.zlib
		std.formats.image.png::*
	)

	// PNG is the PNG codec: reads and writes still PNG images. The encoder
	// picks the smallest lossless colour type and bit depth for the pixels.
	@codec("Portable Network Graphics")
	type PNG {
		// compression is the zlib level of the image data: DefaultCompression,
		// or 0 (none) to 9 (smallest, slowest).
		compression zlib.Level = zlib.Level.DefaultCompression

		mimeType string[] {
			def get() string[] {
				return string["image/png"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".png"]
			}
		}

		// matchSignature reports whether the reader starts with the PNG
		// signature and holds a still image: an animated PNG, whose acTL chunk
		// comes before the image data, belongs to APNG.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(8)
			let n = io.readFull(r, b) onerror recover 0
			return false when n != 8
			return false unless pngHasSignature(b)
			return !pngAnimated(r)
		}

		// info reads the dimensions and pixel format from the bytes. Fails when they
		// are not a PNG header.
		def info(data byte[]) !ImageInfo {
			return pngInfo(data)
		}

		// info reads the dimensions and pixel format from the reader. Fails when the
		// data is not a PNG header, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads a PNG image from the bytes. An animated PNG gives its
		// default image. Fails when they are not a PNG the codec understands.
		def decode(data byte[]) !Image {
			fail "not a PNG" unless pngHasSignature(data)

			let width = 0
			let height = 0
			let bitDepth = 0
			let colorType = 0
			let interlace = 0
			let sawHeader = false
			let palette byte[]
			let trans byte[]
			let idat = new bytes.Buffer()

			let pos = 8
			for pos + 8 <= data.len() {
				let length = pngU32(data, pos)
				fail "corrupt PNG: bad chunk length" when length < 0
				let kind = pos + 4
				let body = pos + 8
				fail "truncated PNG chunk" when body + length + 4 > data.len()

				if pngIsChunk(data, kind, "IHDR") {
					(width, height, bitDepth, colorType, interlace) = try pngHeader(data, body, length)
					sawHeader = true
				} else if pngIsChunk(data, kind, "PLTE") {
					palette = data[body:body + length]
				} else if pngIsChunk(data, kind, "tRNS") {
					trans = data[body:body + length]
				} else if pngIsChunk(data, kind, "IDAT") {
					try idat.write(data[body:body + length])
				} else if pngIsChunk(data, kind, "IEND") {
					break
				}

				pos = body + length + 4
			}

			fail "corrupt PNG: no header" unless sawHeader
			return pngDecodePixels(width, height, bitDepth, colorType, interlace, palette, trans, idat.bytes())
		}

		// decode reads a PNG image from the reader. Fails when the data is not a
		// PNG the codec understands, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// encode renders the image as PNG. Fails when compressing does.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as PNG to the writer, in the smallest lossless
		// colour type: grayscale, grayscale with alpha, truecolour, truecolour
		// with alpha, or a palette of up to 256 colours. Fails when the image is
		// empty, or the writer does.
		def encode(img Image, writer io.Writer) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			fail "png: cannot encode an empty image" when w <= 0 || h <= 0
			let layout = pngChooseLayout(Image[img], false)
			try pngWriteHeader(writer, w, h, layout)
			try pngWriteIDAT(writer, try pngCompress(img, layout, compression))
			try pngWriteChunk(writer, "IEND", byte[])
		}
	}
}

internal partial module std.formats.image.png {
	use (
		std.io
		std.bytes
		std.mem
		std.math.geom
		std.gfx.color
		std.crypto.hash
		std.data.compress.zlib
		std.formats.image::*
	)

	const (
		ctGrayscale      = 0
		ctTrueColor      = 2
		ctPaletted       = 3
		ctGrayscaleAlpha = 4
		ctTrueColorAlpha = 6
	)

	const pngSignature = byte[137, 80, 78, 71, 13, 10, 26, 10]

	// Largest IDAT or fdAT chunk the encoder writes; longer data is split.
	const pngMaxChunk = 1 << 20

	// Adam7 puts the image out in seven passes; each row below is one pass's
	// first column, first row, column step and row step.
	const pngAdam7 = int[
		0, 0, 8, 8,
		4, 0, 8, 8,
		0, 4, 4, 8,
		2, 0, 4, 4,
		0, 2, 2, 4,
		1, 0, 2, 2,
		0, 1, 1, 2
	]

	def pngPaeth(a int, b int, c int) int {
		let p = a + b - c
		let pa = p - a
		pa = 0 - pa when pa < 0
		let pb = p - b
		pb = 0 - pb when pb < 0
		let pc = p - c
		pc = 0 - pc when pc < 0
		return a when pa <= pb && pa <= pc
		return b when pb <= pc
		return c
	}

	// Channels carried per pixel by each colour type.
	def pngChannels(colorType int) int {
		return 1 when colorType == ctGrayscale || colorType == ctPaletted
		return 3 when colorType == ctTrueColor
		return 2 when colorType == ctGrayscaleAlpha
		return 4
	}

	// Big-endian 32-bit value at `at`.
	def pngU32(data byte[], at int) int {
		return int(data[at]) << 24 | int(data[at + 1]) << 16 | int(data[at + 2]) << 8 | int(data[at + 3])
	}

	// Stores `v` big-endian at `at`.
	def pngPut32(data byte[], at int, v int) {
		data[at] = byte((v >> 24) & 0xFF)
		data[at + 1] = byte((v >> 16) & 0xFF)
		data[at + 2] = byte((v >> 8) & 0xFF)
		data[at + 3] = byte(v & 0xFF)
	}

	// Whether the four bytes at `at` spell the chunk type `kind`.
	def pngIsChunk(data byte[], at int, kind string) bool {
		let k = byte[](kind)
		return data[at] == k[0] && data[at + 1] == k[1] && data[at + 2] == k[2] && data[at + 3] == k[3]
	}

	// Reads chunk headers after the signature until IDAT and reports whether an
	// acTL chunk came first, which is what makes a PNG an animated one.
	def pngAnimated(r io.Reader) bool {
		let head byte[]
		head.len(8)
		let skip byte[]
		skip.len(4096)
		for {
			let n = io.readFull(r, head) onerror recover 0
			return false when n != 8
			return true when pngIsChunk(head, 4, "acTL")
			return false when pngIsChunk(head, 4, "IDAT") || pngIsChunk(head, 4, "IEND")
			// The body and its CRC.
			let left = pngU32(head, 0) + 4
			return false when left < 4
			for left > 0 {
				let want = left
				want = skip.len() when want > skip.len()
				let got = io.readFull(r, skip[:want]) onerror recover 0
				return false when got != want
				left -= got
			}
		}
		return false
	}

	// Checks the signature at the start of `data`.
	def pngHasSignature(data byte[]) bool {
		return false when data.len() < 8
		for let i = 0; i < 8; i++ {
			return false when data[i] != pngSignature[i]
		}
		return true
	}

	// Reads the IHDR chunk at the start of a PNG into an ImageInfo.
	def pngInfo(data byte[]) !ImageInfo {
		fail "not a PNG" unless pngHasSignature(data)
		fail "not a PNG" when data.len() < 33
		// The header chunk is required to come first.
		fail "corrupt PNG: missing header" unless pngIsChunk(data, 12, "IHDR")
		let width = pngU32(data, 16)
		let height = pngU32(data, 20)
		fail "invalid PNG dimensions" when width <= 0 || height <= 0
		let colorType = int(data[25])
		let format = color.ColorFormat.RGBA
		format = color.ColorFormat.Palette when colorType == ctPaletted
		return ImageInfo{
			size: new geom.Size(float(width), float(height)),
			colorFormat: format,
		}
	}

	// Checks the fields of an IHDR chunk body at `body` and returns width,
	// height, bit depth, colour type and interlace method.
	def pngHeader(data byte[], body int, length int) !(int, int, int, int, int) {
		fail "corrupt PNG: short header" when length < 13
		let width = pngU32(data, body)
		let height = pngU32(data, body + 4)
		let bitDepth = int(data[body + 8])
		let colorType = int(data[body + 9])
		let interlace = int(data[body + 12])
		fail "invalid PNG dimensions" when width <= 0 || height <= 0
		fail "unsupported PNG compression method" when int(data[body + 10]) != 0
		fail "unsupported PNG filter method" when int(data[body + 11]) != 0
		fail "unsupported PNG interlace method" when interlace != 0 && interlace != 1
		try pngValidateDepth(colorType, bitDepth)
		return (width, height, bitDepth, colorType, interlace)
	}

	def pngValidateDepth(colorType int, bitDepth int) !none {
		if colorType == ctGrayscale {
			fail "unsupported PNG bit depth" unless bitDepth == 1 || bitDepth == 2 || bitDepth == 4 || bitDepth == 8 || bitDepth == 16
			return none
		}
		if colorType == ctPaletted {
			fail "unsupported PNG bit depth" unless bitDepth == 1 || bitDepth == 2 || bitDepth == 4 || bitDepth == 8
			return none
		}
		fail "unsupported PNG colour type" unless colorType == ctTrueColor || colorType == ctGrayscaleAlpha || colorType == ctTrueColorAlpha
		fail "unsupported PNG bit depth" unless bitDepth == 8 || bitDepth == 16
	}

	def pngNarrow16(cur byte[], at int) int {
		let v = (int(cur[at]) << 8) | int(cur[at + 1])
		return (v + 128) / 257
	}

	def pngPassCount(total int, origin int, step int) int {
		return 0 when total <= origin
		return (total - origin + step - 1) / step
	}

	def pngRowBytes(w int, channels int, bitDepth int) int {
		return (w * channels * bitDepth + 7) / 8
	}

	def pngExpectedRawSize(width int, height int, channels int, bitDepth int, interlace int) int {
		if interlace == 0 {
			return height * (1 + pngRowBytes(width, channels, bitDepth))
		}
		let total = 0
		for let p = 0; p < 7; p++ {
			let pw = pngPassCount(width, pngAdam7[p * 4], pngAdam7[p * 4 + 2])
			let ph = pngPassCount(height, pngAdam7[p * 4 + 1], pngAdam7[p * 4 + 3])
			total += ph * (1 + pngRowBytes(pw, channels, bitDepth)) when pw > 0 && ph > 0
		}
		return total
	}

	// Inflates and unfilters the image data of one image (a PNG, or one APNG
	// frame) and returns its pixels.
	def pngDecodePixels(width int, height int, bitDepth int, colorType int, interlace int, palette byte[], trans byte[], zdata byte[]) !Image {
		fail "corrupt PNG: no image data" when zdata.len() == 0
		fail "corrupt PNG: paletted image without a palette" when colorType == ctPaletted && palette.len() == 0

		let channels = pngChannels(colorType)
		let expected = pngExpectedRawSize(width, height, channels, bitDepth, interlace)
		let raw = try zlib.decompress(zdata, expected)
		fail "corrupt PNG: image data ended early" when raw.len() < expected

		let img = new Image(width, height)
		if interlace == 0 {
			try pngRenderPass(img, raw, 0, width, height, 0, 0, 1, 1, channels, bitDepth, colorType, palette, trans)
		} else {
			let off = 0
			for let p = 0; p < 7; p++ {
				let xOrig = pngAdam7[p * 4]
				let yOrig = pngAdam7[p * 4 + 1]
				let xStep = pngAdam7[p * 4 + 2]
				let yStep = pngAdam7[p * 4 + 3]
				let pw = pngPassCount(width, xOrig, xStep)
				let ph = pngPassCount(height, yOrig, yStep)
				if pw > 0 && ph > 0 {
					try pngRenderPass(img, raw, off, pw, ph, xOrig, yOrig, xStep, yStep, channels, bitDepth, colorType, palette, trans)
					off += ph * (1 + pngRowBytes(pw, channels, bitDepth))
				}
			}
		}
		return img
	}

	// Unfilters one pass and writes its pixels into the image.
	def pngRenderPass(img Image, raw byte[], rawOff int, pw int, ph int, xOrig int, yOrig int, xStep int, yStep int, channels int, bitDepth int, colorType int, palette byte[], trans byte[]) !none {
		let stride = pngRowBytes(pw, channels, bitDepth)
		let bpp = (channels * bitDepth + 7) / 8

		let prev byte[]
		prev.len(stride)
		prev[:] = 0
		let cur byte[]
		cur.len(stride)
		cur[:] = 0

		let off = rawOff
		for let row = 0; row < ph; row++ {
			fail "corrupt PNG: image data ended early" when off + 1 + stride > raw.len()
			let filter = int(raw[off])
			off++

			for let i = 0; i < stride; i++ {
				let x = int(raw[off + i])
				let a = 0
				a = int(cur[i - bpp]) when i >= bpp
				let b = int(prev[i])
				let c = 0
				c = int(prev[i - bpp]) when i >= bpp
				if filter == 1 {
					x += a
				} else if filter == 2 {
					x += b
				} else if filter == 3 {
					x += (a + b) / 2
				} else if filter == 4 {
					x += pngPaeth(a, b, c)
				} else {
					fail "unsupported PNG filter type" when filter != 0
				}
				cur[i] = byte(x & 0xFF)
			}
			off += stride

			try pngEmitRow(img, cur, pw, yOrig + row * yStep, xOrig, xStep, channels, bitDepth, colorType, palette, trans)

			for let i = 0; i < stride; i++ {
				prev[i] = cur[i]
			}
		}
	}

	def pngEmitRow(img Image, cur byte[], pw int, y int, xOrig int, xStep int, channels int, bitDepth int, colorType int, palette byte[], trans byte[]) !none {
		let w = int(img.size().width)
		let h = int(img.size().height)
		return none when y < 0 || y >= h

		let px = img.raw()

		for let i = 0; i < pw; i++ {
			let x = xOrig + i * xStep
			break when x >= w

			let r = 0
			let g = 0
			let b = 0
			let a = 255

			if bitDepth == 8 {
				let base = i * channels
				if colorType == ctGrayscale {
					r = int(cur[base])
					g = r
					b = r
					a = 0 when trans.len() >= 2 && r == int(trans[1])
				} else if colorType == ctTrueColor {
					r = int(cur[base])
					g = int(cur[base+1])
					b = int(cur[base+2])
					a = 0 when trans.len() >= 6 && r == int(trans[1]) && g == int(trans[3]) && b == int(trans[5])
				} else if colorType == ctPaletted {
					let idx = int(cur[base])
					fail "corrupt PNG: palette index out of range" when idx * 3 + 2 >= palette.len()
					r = int(palette[idx * 3])
					g = int(palette[idx * 3 + 1])
					b = int(palette[idx * 3 + 2])
					a = int(trans[idx]) when idx < trans.len()
				} else if colorType == ctGrayscaleAlpha {
					r = int(cur[base])
					g = r
					b = r
					a = int(cur[base+1])
				} else {
					r = int(cur[base])
					g = int(cur[base+1])
					b = int(cur[base+2])
					a = int(cur[base+3])
				}
			} else if bitDepth == 16 {
				// Sixteen-bit samples are reduced to eight, rounding.
				let base = i * channels * 2
				if colorType == ctGrayscale {
					r = pngNarrow16(cur, base)
					g = r
					b = r
				} else if colorType == ctTrueColor {
					r = pngNarrow16(cur, base)
					g = pngNarrow16(cur, base + 2)
					b = pngNarrow16(cur, base + 4)
				} else if colorType == ctGrayscaleAlpha {
					r = pngNarrow16(cur, base)
					g = r
					b = r
					a = pngNarrow16(cur, base + 2)
				} else {
					r = pngNarrow16(cur, base)
					g = pngNarrow16(cur, base + 2)
					b = pngNarrow16(cur, base + 4)
					a = pngNarrow16(cur, base + 6)
				}
			} else {
				// One, two and four bit samples are packed big-endian.
				let bitPos = i * bitDepth
				let byteIdx = bitPos / 8
				let shift = 8 - bitDepth - (bitPos % 8)
				let mask = (1 << bitDepth) - 1
				let v = (int(cur[byteIdx]) >> shift) & mask
				if colorType == ctPaletted {
					fail "corrupt PNG: palette index out of range" when v * 3 + 2 >= palette.len()
					r = int(palette[v * 3])
					g = int(palette[v * 3 + 1])
					b = int(palette[v * 3 + 2])
					a = int(trans[v]) when v < trans.len()
				} else {
					// Grayscale: scale the sample up to the full range.
					r = v * 255 / mask
					g = r
					b = r
				}
			}

			let o = img.pixelOffset(x, y)
			px[o] = byte(r)
			px[o + 1] = byte(g)
			px[o + 2] = byte(b)
			px[o + 3] = byte(a)
		}
	}

	// PngLayout is the pixel format the encoder picked for a set of images:
	// the colour type and bit depth, and for a paletted one the palette, the
	// alpha of its leading entries and the index of every colour.
	type PngLayout {
		colorType        int
		bitDepth         int
		palette          byte[]
		trans            byte[]
		lookup           map<int, int>
		// Palette index of a fully transparent entry, -1 when there is none.
		transparentIndex int           = -1

		def new() {
			lookup = new map<int, int>()
		}

		// Whether a fully transparent pixel can be written.
		def canBeTransparent() bool {
			return colorType == ctTrueColorAlpha || colorType == ctGrayscaleAlpha || transparentIndex >= 0
		}
	}

	// Smallest palette bit depth that holds `count` entries.
	def pngPaletteDepth(count int) int {
		return 1 when count <= 2
		return 2 when count <= 4
		return 4 when count <= 16
		return 8
	}

	// Picks the smallest lossless layout that holds every pixel of `images`.
	// With `wantTransparent`, a paletted layout gets a fully transparent entry
	// when one fits, for frames that leave pixels unchanged.
	def pngChooseLayout(images Image[], wantTransparent bool) PngLayout {
		let gray = true
		let opaque = true
		let grayDepth = 1
		let keys int[]
		let seen = new map<int, int>()
		let tooMany = false
		let lastKey = -1

		for let (_, img) in images {
			let w = int(img.size().width)
			let h = int(img.size().height)
			let px = img.raw()
			let stride = img.stride()
			for let y = 0; y < h; y++ {
				let o = y * stride
				for let x = 0; x < w; x++ {
					let r = int(px[o])
					let g = int(px[o + 1])
					let b = int(px[o + 2])
					let a = int(px[o + 3])
					o += 4
					opaque = false when a != 255
					if gray {
						if r != g || r != b {
							gray = false
						} else if grayDepth < 8 {
							if r % 17 != 0 {
								grayDepth = 8
							} else if r % 85 != 0 {
								grayDepth = 4 when grayDepth < 4
							} else if r % 255 != 0 {
								grayDepth = 2 when grayDepth < 2
							}
						}
					}
					continue when tooMany
					let key = r << 24 | g << 16 | b << 8 | a
					continue when key == lastKey
					lastKey = key
					continue when seen.hasKey(key)
					if keys.len() == 256 {
						tooMany = true
						continue
					}
					seen.set(key, keys.len())
					keys.push(key)
				}
			}
		}

		let layout = new PngLayout()
		let usePalette = !tooMany
		if gray && opaque {
			usePalette = usePalette && pngPaletteDepth(keys.len()) < grayDepth
			if !usePalette {
				layout.colorType = ctGrayscale
				layout.bitDepth = grayDepth
				return layout
			}
		}
		if !usePalette {
			layout.bitDepth = 8
			if gray {
				layout.colorType = ctGrayscaleAlpha
			} else if opaque {
				layout.colorType = ctTrueColor
			} else {
				layout.colorType = ctTrueColorAlpha
			}
			return layout
		}

		if wantTransparent && keys.len() < 256 {
			let hasClear = false
			for let (_, k) in keys {
				hasClear = true when k & 0xFF == 0
			}
			keys.push(0) unless hasClear
		}

		// Entries with alpha go first, so tRNS stops at the last of them.
		let ordered int[]
		for let (_, k) in keys {
			ordered.push(k) when k & 0xFF != 255
		}
		let translucent = ordered.len()
		for let (_, k) in keys {
			ordered.push(k) when k & 0xFF == 255
		}

		layout.colorType = ctPaletted
		layout.bitDepth = pngPaletteDepth(ordered.len())
		layout.palette.len(ordered.len() * 3)
		layout.trans.len(translucent)
		for let (i, k) in ordered {
			layout.palette[i * 3] = byte((k >> 24) & 0xFF)
			layout.palette[i * 3 + 1] = byte((k >> 16) & 0xFF)
			layout.palette[i * 3 + 2] = byte((k >> 8) & 0xFF)
			layout.trans[i] = byte(k & 0xFF) when i < translucent
			layout.lookup.set(k, i)
			layout.transparentIndex = i when k & 0xFF == 0 && layout.transparentIndex < 0
		}
		return layout
	}

	// Lays one row of pixels out as the layout's samples into `row`.
	def pngPackRow(img Image, y int, layout PngLayout, row byte[]) !none {
		let w = int(img.size().width)
		let px = img.raw()
		let o = y * img.stride()
		let ct = layout.colorType
		let depth = layout.bitDepth

		if ct == ctTrueColorAlpha {
			mem.copyN(row, px[o:o + w * 4], w * 4)
			return none
		}
		if ct == ctTrueColor {
			let d = 0
			for let x = 0; x < w; x++ {
				row[d] = px[o]
				row[d + 1] = px[o + 1]
				row[d + 2] = px[o + 2]
				d += 3
				o += 4
			}
			return none
		}
		if ct == ctGrayscaleAlpha {
			let d = 0
			for let x = 0; x < w; x++ {
				row[d] = px[o]
				row[d + 1] = px[o + 3]
				d += 2
				o += 4
			}
			return none
		}
		if depth == 8 && ct == ctGrayscale {
			for let x = 0; x < w; x++ {
				row[x] = px[o]
				o += 4
			}
			return none
		}

		row[:] = 0
		let mask = (1 << depth) - 1
		let lastKey = -1
		let lastIdx = 0
		for let x = 0; x < w; x++ {
			let v = 0
			if ct == ctGrayscale {
				v = int(px[o]) * mask / 255
			} else {
				let key = int(px[o]) << 24 | int(px[o + 1]) << 16 | int(px[o + 2]) << 8 | int(px[o + 3])
				if key != lastKey {
					let idx = layout.lookup.get(key)
					fail "png: colour missing from the palette" when idx is none
					lastIdx = idx
					lastKey = key
				}
				v = lastIdx
			}
			o += 4
			if depth == 8 {
				row[x] = byte(v)
			} else {
				let bitPos = x * depth
				let at = bitPos / 8
				row[at] = row[at] | byte(v << (8 - depth - bitPos % 8))
			}
		}
	}

	// Filters and compresses the pixels of `img` in the layout: the payload of
	// the IDAT chunks, or of one APNG frame's fdAT chunks.
	def pngCompress(img Image, layout PngLayout, level zlib.Level) !byte[] {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let channels = pngChannels(layout.colorType)
		let stride = pngRowBytes(w, channels, layout.bitDepth)
		let bpp = (channels * layout.bitDepth + 7) / 8
		// Palettes and packed samples compress best unfiltered.
		let adaptive = layout.colorType != ctPaletted && layout.bitDepth >= 8

		let raw byte[]
		raw.len(h * (stride + 1))
		let prev byte[]
		prev.len(stride)
		prev[:] = 0
		let cur byte[]
		cur.len(stride)

		let off = 0
		for let y = 0; y < h; y++ {
			try pngPackRow(img, y, layout, cur)
			let filter = 0
			filter = pngPickFilter(cur, prev, bpp) when adaptive
			raw[off] = byte(filter)
			off++
			pngFilterRow(cur, prev, bpp, filter, raw, off)
			off += stride
			let t = prev
			prev = cur
			cur = t
		}

		let out = new bytes.Buffer()
		let zw = new zlib.Writer(out, level)
		try zw.write(raw)
		try zw.close()
		return out.bytes()
	}

	// Picks the filter whose output has the smallest sum of absolute values,
	// read as signed bytes.
	def pngPickFilter(cur byte[], prev byte[], bpp int) int {
		let s0 = 0
		let s1 = 0
		let s2 = 0
		let s3 = 0
		let s4 = 0
		for let i = 0; i < cur.len(); i++ {
			let x = int(cur[i])
			let b = int(prev[i])
			let a = 0
			let c = 0
			if i >= bpp {
				a = int(cur[i - bpp])
				c = int(prev[i - bpp])
			}
			let v = x
			s0 += v < 128 ?? (v, 256 - v)
			v = (x - a) & 0xFF
			s1 += v < 128 ?? (v, 256 - v)
			v = (x - b) & 0xFF
			s2 += v < 128 ?? (v, 256 - v)
			v = (x - (a + b) / 2) & 0xFF
			s3 += v < 128 ?? (v, 256 - v)
			v = (x - pngPaeth(a, b, c)) & 0xFF
			s4 += v < 128 ?? (v, 256 - v)
		}
		let best = 0
		let bestSum = s0
		if s1 < bestSum {
			best = 1
			bestSum = s1
		}
		if s2 < bestSum {
			best = 2
			bestSum = s2
		}
		if s3 < bestSum {
			best = 3
			bestSum = s3
		}
		return 4 when s4 < bestSum
		return best
	}

	// Writes `cur` filtered with `filter` into `out` from `at`.
	def pngFilterRow(cur byte[], prev byte[], bpp int, filter int, out byte[], at int) {
		let n = cur.len()
		if filter == 0 {
			mem.copyN(out[at:at + n], cur, n)
			return
		}
		for let i = 0; i < n; i++ {
			let x = int(cur[i])
			let a = 0
			let c = 0
			if i >= bpp {
				a = int(cur[i - bpp])
				c = int(prev[i - bpp])
			}
			let b = int(prev[i])
			let p = 0
			if filter == 1 {
				p = a
			} else if filter == 2 {
				p = b
			} else if filter == 3 {
				p = (a + b) / 2
			} else {
				p = pngPaeth(a, b, c)
			}
			out[at + i] = byte((x - p) & 0xFF)
		}
	}

	// Writes one chunk: length, type, body and the CRC of type and body.
	def pngWriteChunk(writer io.Writer, kind string, body byte[]) !none {
		let k = byte[](kind)
		let head byte[]
		head.len(8)
		pngPut32(head, 0, body.len())
		mem.copyN(head[4:8], k, 4)
		let crc = new hash.CRC32()
		_ = crc.write(k)
		_ = crc.write(body)
		try writer.write(head)
		try writer.write(body) when body.len() > 0
		try writer.write(crc.hash())
	}

	// Writes the signature, IHDR, and the PLTE and tRNS the layout needs.
	def pngWriteHeader(writer io.Writer, width int, height int, layout PngLayout) !none {
		try writer.write(pngSignature)
		let ihdr byte[]
		ihdr.len(13)
		ihdr[:] = 0
		pngPut32(ihdr, 0, width)
		pngPut32(ihdr, 4, height)
		ihdr[8] = byte(layout.bitDepth)
		ihdr[9] = byte(layout.colorType)
		try pngWriteChunk(writer, "IHDR", ihdr)
		if layout.colorType == ctPaletted {
			try pngWriteChunk(writer, "PLTE", layout.palette)
			try pngWriteChunk(writer, "tRNS", layout.trans) when layout.trans.len() > 0
		}
	}

	// Writes compressed image data as IDAT chunks.
	def pngWriteIDAT(writer io.Writer, zdata byte[]) !none {
		let at = 0
		for {
			let n = zdata.len() - at
			n = pngMaxChunk when n > pngMaxChunk
			try pngWriteChunk(writer, "IDAT", zdata[at:at + n])
			at += n
			break when at >= zdata.len()
		}
	}
}
