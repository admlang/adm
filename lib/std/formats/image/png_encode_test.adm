partial module std.formats.image {
	use (
		std.testing
		std.bytes
	)

	check "PNG encoding" {
		// A w x h image of noise over gradients in every channel, with the
		// alpha given (or noise when -1) and grey when `grey` is set.
		internal def encodeSample(w int, h int, alpha int, grey bool) Image {
			let img = new Image(w, h)
			let px = img.raw()
			let s = uint32(w * 31 + h)
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					s = s * uint32(1664525) + uint32(1013904223)
					let o = (y * w + x) * 4
					let n = int(s >> 28)
					let r = (x * 3 + n) & 0xFF
					px[o] = byte(r)
					px[o + 1] = byte(grey ?? (r, (y * 5 + n) & 0xFF))
					px[o + 2] = byte(grey ?? (r, (x + y + n) & 0xFF))
					px[o + 3] = byte(alpha >= 0 ?? (alpha, int(s >> 24)))
				}
			}
			return img
		}

		// The FNV-1a hash of the encoded bytes: pinned when the filter choice
		// and filtering went to vectors, which wrote the same bytes.
		internal def encodedSum(img Image) string {
			let out = new bytes.Buffer()
			new PNG().encode(img, out) onerror recover none
			let h = uint64(14695981039346656037)
			for let (_, b) in out.bytes() {
				h = (h ^ uint64(b)) * uint64(1099511628211)
			}
			return "{out.bytes().len()}:{h.hex()}"
		}

		@test()
		def output_stays_pinned() {
			let want = [
				"99:4805672BC0DDF9ED",
				"86:7A58BE13E6049B56",
				"86:7A58BE13E6049B56",
				"99:4805672BC0DDF9ED",
				"166:7D3A4D1A9EFD57B",
				"139:7C813B051419DA70",
				"126:36ED1A19C6A2A52D",
				"166:961C3975A217580E",
				"5577:94EE572269A04C2B",
				"2916:A3B5CC7F1454A51A",
				"1233:AF1237A41A719AE7",
				"3590:66585E38452A4E27",
				"49940:1CE5A9C6E25C948D",
				"23742:D83B19FA35F016DB",
				"11666:D7142DDCAEFB837E",
				"34489:1E2F65ED0315C5AA",
			]
			let k = 0
			for let (_, size) in [(1, 1), (5, 3), (67, 29), (301, 64)] {
				let (w, h) = size
				assert encodedSum(encodeSample(w, h, -1, false)) == want[k]
				assert encodedSum(encodeSample(w, h, 255, false)) == want[k + 1]
				assert encodedSum(encodeSample(w, h, 255, true)) == want[k + 2]
				assert encodedSum(encodeSample(w, h, -1, true)) == want[k + 3]
				k += 4
			}
		}
	}
}
