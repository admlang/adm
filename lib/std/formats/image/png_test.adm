partial module std.formats.image {
	use std.testing

	check "PNG" {
		internal def assertPixel(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			assert int(img.raw()[o]) == r
			assert int(img.raw()[o + 1]) == g
			assert int(img.raw()[o + 2]) == b
			assert int(img.raw()[o + 3]) == a
		}

		// 8x8 red-to-blue gradient, truecolour.
		internal def truecolorPNG() byte[] {
			return byte[
				137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
				0, 0, 0, 8, 0, 0, 0, 8, 8, 2, 0, 0, 0, 75, 109, 41,
				220, 0, 0, 0, 35, 73, 68, 65, 84, 8, 215, 99, 252, 207, 128, 29,
				176, 220, 97, 80, 193, 46, 113, 155, 65, 149, 214, 58, 24, 85, 24, 110,
				99, 151, 96, 96, 192, 238, 96, 0, 129, 156, 8, 21, 234, 137, 101, 48,
				0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130
			]
		}

		// The same gradient with an alpha channel.
		internal def truecolorAlphaPNG() byte[] {
			return byte[
				137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
				0, 0, 0, 8, 0, 0, 0, 8, 8, 6, 0, 0, 0, 196, 15, 190,
				139, 0, 0, 0, 30, 73, 68, 65, 84, 24, 211, 99, 252, 207, 192, 208,
				192, 128, 7, 176, 220, 97, 80, 97, 192, 171, 224, 54, 131, 42, 195, 144,
				55, 1, 0, 43, 198, 8, 157, 23, 134, 248, 15, 0, 0, 0, 0, 73,
				69, 78, 68, 174, 66, 96, 130
			]
		}

		// Eight-colour palette.
		internal def palettePNG() byte[] {
			return byte[
				137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
				0, 0, 0, 8, 0, 0, 0, 8, 8, 3, 0, 0, 0, 243, 209, 78,
				185, 0, 0, 0, 24, 80, 76, 84, 69, 27, 40, 86, 53, 78, 52, 80,
				90, 91, 78, 79, 153, 30, 95, 94, 13, 51, 145, 64, 135, 69, 31, 32,
				35, 86, 253, 196, 56, 0, 0, 0, 50, 73, 68, 65, 84, 8, 215, 29,
				201, 193, 17, 192, 64, 12, 194, 64, 129, 57, 211, 127, 199, 25, 231, 183,
				35, 1, 242, 56, 143, 144, 245, 204, 35, 137, 132, 127, 152, 226, 67, 45,
				68, 1, 251, 174, 74, 175, 236, 182, 173, 244, 1, 24, 156, 0, 186, 150,
				230, 11, 171, 0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130
			]
		}

		// The gradient again, Adam7 interlaced.
		internal def interlacedPNG() byte[] {
			return byte[
				137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
				0, 0, 0, 8, 0, 0, 0, 8, 8, 2, 0, 0, 1, 60, 106, 25,
				74, 0, 0, 0, 66, 73, 68, 65, 84, 8, 215, 141, 203, 65, 13, 128,
				64, 12, 5, 209, 215, 4, 41, 107, 6, 49, 152, 65, 12, 136, 89, 49,
				229, 68, 74, 147, 61, 48, 183, 201, 255, 35, 145, 196, 225, 68, 36, 202,
				46, 187, 151, 24, 102, 73, 42, 182, 251, 115, 107, 210, 155, 105, 88, 209,
				146, 95, 67, 144, 203, 225, 1, 40, 252, 15, 15, 164, 58, 73, 236, 0,
				0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130
			]
		}

		@test()
		def info_reads_the_header() {
			let codec = new PNG()
			let got = codec.info(truecolorPNG()) onerror recover ImageInfo{}
			assert int(got.size.width) == 8
			assert int(got.size.height) == 8
		}

		@test()
		def decodes_truecolor() {
			let codec = new PNG()
			let img = codec.decode(truecolorPNG()) onerror recover new Image(1, 1)
			assert int(img.size().width) == 8
			assert int(img.size().height) == 8
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 7, 0, 255, 0, 0, 255)
			assertPixel(img, 0, 7, 0, 0, 255, 255)
			assertPixel(img, 4, 4, 109, 0, 146, 255)
		}

		@test()
		def decodes_an_alpha_channel() {
			let codec = new PNG()
			let img = codec.decode(truecolorAlphaPNG()) onerror recover new Image(1, 1)
			assertPixel(img, 0, 0, 255, 0, 0, 128)
			assertPixel(img, 0, 7, 0, 0, 255, 128)
			assertPixel(img, 4, 4, 109, 0, 146, 128)
		}

		@test()
		def decodes_a_palette() {
			let codec = new PNG()
			let img = codec.decode(palettePNG()) onerror recover new Image(1, 1)
			assert int(img.size().width) == 8
			assertPixel(img, 0, 0, 27, 40, 86, 255)
			assertPixel(img, 7, 0, 13, 51, 145, 255)
			assertPixel(img, 0, 7, 64, 135, 69, 255)
			assertPixel(img, 4, 4, 80, 90, 91, 255)
		}

		// Adam7 lays the image out in seven passes; decoding must reassemble
		// the same picture as the non-interlaced form.
		@test()
		def decodes_interlaced() {
			let codec = new PNG()
			let img = codec.decode(interlacedPNG()) onerror recover new Image(1, 1)
			assert int(img.size().width) == 8
			assert int(img.size().height) == 8
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 7, 0, 255, 0, 0, 255)
			assertPixel(img, 0, 7, 0, 0, 255, 255)
			assertPixel(img, 4, 4, 109, 0, 146, 255)
		}

		@test()
		def rejects_what_it_cannot_decode() {
			let codec = new PNG()
			let img = codec.decode(byte[1, 2, 3, 4, 5, 6, 7, 8, 9]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
		}
	}
}
