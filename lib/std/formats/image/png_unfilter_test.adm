internal partial module std.formats.image.png {
	use (
		std.testing
		std.formats.image::*
	)

	// Fixed noise for pass data, with a filter byte per row cycling through
	// 0..4, and the FNV-1a hash of an image: the unfilter and row paths are
	// pinned to the output they gave when they were checked byte for byte
	// against the per-byte code they replaced (same on both backends).
	internal def unfilterNoise(n int, seed int) byte[] {
		let px byte[]
		px.len(n)
		let s = uint32(seed)
		for let i = 0; i < n; i++ {
			s = s * uint32(1664525) + uint32(1013904223)
			px[i] = byte(s >> 24)
		}
		return px
	}

	internal def unfilterChecksum(img Image) string {
		let h = uint64(14695981039346656037)
		for let (_, b) in img.raw() {
			h = (h ^ uint64(b)) * uint64(1099511628211)
		}
		return h.hex()
	}

	internal def unfilterPass(img Image, ct int, depth int, pw int, ph int, xo int, xs int, pal byte[], trans byte[], seed int) !none {
		let stride = pngRowBytes(pw, pngChannels(ct), depth)
		let raw = unfilterNoise((stride + 1) * ph, seed)
		for let r = 0; r < ph; r++ {
			raw[r * (stride + 1)] = byte((r + seed) % 5)
		}
		try pngRenderPass(img, raw, 0, pw, ph, xo, 1, xs, 2, pngChannels(ct), depth, ct, pal, trans)
	}

	check "PNG unfilter" {
		@test()
		def outputs_stay_pinned() {
			let kinds = [(0, 1), (0, 4), (0, 8), (0, 16), (2, 8), (2, 16), (3, 2), (3, 8), (4, 8), (4, 16), (6, 8), (6, 16)]
			let pal = unfilterNoise(768, 3)
			let want = ["30F6E5D531A4E414", "7E9633E302EF0C0C", "59D781FF1FECEF72", "C60D7A0425D378D1", "E9CC26638645E0EC", "4F8BC9313FF94A61", "CEB28324462CE4B3", "7369DDDDF384FEFC", "A107B55C3093E495", "38776FE9AF1E1071", "AC7EE86B69E9E8DB", "46108D51EE89948", "A6B5564C9F097E0D", "C171824CCF8CB9F2", "5A9D1647052E9E17", "82C27D287A4DF720", "98D5EABAB47F5A53", "AAF5997F907B2CE4", "6119F52C2C0317E4", "6990181902A8A70C", "82735FEA78CEA0C9", "92E109A57F0A611F", "8D1CA0C551DEA88F", "8740C8B870A70EE5"]
			for let (k, kind) in kinds {
				let (ct, depth) = kind
				for let g = 0; g < 2; g++ {
					let img = new Image(67, 40)
					let trans byte[] = []
					trans = unfilterNoise(6, 9) when g == 1
					// Full rows, then an interlace pass (every second column from 1).
					let xo = g
					let xs = g + 1
					let pw = (67 - xo + xs - 1) / xs
					unfilterPass(img, ct, depth, pw, 20, xo, xs, pal, trans, k * 2 + g) onerror recover none
					assert unfilterChecksum(img) == want[k * 2 + g]
				}
			}
		}

		@test()
		def bad_filter_and_palette_fail() {
			let img = new Image(9, 2)
			let raw = unfilterNoise(10 * 2, 5)
			raw[0] = byte(5)
			let short = unfilterNoise(30, 4)
			let raw2 = unfilterNoise(10 * 2, 6)
			raw2[0] = byte(0)
			raw2[1] = byte(200)
			let raw3 = unfilterNoise(37 * 2, 7)
			raw3[0] = byte(0)
			raw3[37] = byte(7)
			assert !pngOk(img, raw, 0) && !pngOk(img, raw2, 3, short) && !pngOk(img, raw3, 6)
			raw3[37] = byte(4)
			assert pngOk(img, raw3, 6)
		}
	}

	internal def pngOk(img Image, raw byte[], ct int, pal byte[] = byte[]) bool {
		return pngTry(img, raw, ct, pal) onerror recover false
	}

	internal def pngTry(img Image, raw byte[], ct int, pal byte[]) !bool {
		try pngRenderPass(img, raw, 0, 9, 2, 0, 0, 1, 1, pngChannels(ct), 8, ct, pal, byte[])
		return true
	}
}
