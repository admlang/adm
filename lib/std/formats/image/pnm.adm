partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.formats.image.pnm::*
	)

	// The Netpbm format an encode writes.
	enum PNMFormat {
		// PGM for an opaque grey image, PPM for an opaque colour one, PAM
		// with alpha otherwise.
		Auto,
		// PBM: black and white, a pixel black when its luminance is below
		// half.
		Bitmap,
		// PGM: grey levels.
		Graymap,
		// PPM: RGB.
		Pixmap,
		// PAM: RGB_ALPHA, or GRAYSCALE_ALPHA for a grey image.
		Arbitrary,
		// PFM: 32-bit floating-point RGB (levels over 255), rows bottom-up.
		FloatMap,
	}

	// PNM is the Netpbm codec: PBM (P1, P4), PGM (P2, P5), PPM (P3, P6),
	// PAM (P7, every tuple type of 1 to 4 channels) and PFM (PF, Pf).
	// Samples deeper than 8 bits scale to 8 (v · 255 / maxval, rounded);
	// PFM values are clamped to [0, 1]. A file of several images one after
	// another decodes into `images`.
	@codec("Netpbm")
	type PNM {
		// The format encode writes.
		format   PNMFormat = PNMFormat.Auto
		// Whether encode writes the plain (ASCII) variant of PBM, PGM or PPM.
		plain    bool
		// The largest sample value encode writes (1 to 65535; above 255,
		// two bytes a sample).
		maxValue int       = 255
		// The header comments (`#` lines), read by decode and written by
		// encode, one line each.
		comment  string
		// Every image of the decoded file, in order.
		images   Image[]

		mimeType string[] {
			def get() string[] {
				return string["image/x-portable-anymap", "image/x-portable-bitmap", "image/x-portable-graymap", "image/x-portable-pixmap", "image/x-portable-arbitrarymap", "image/x-portable-floatmap"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".pnm", ".pbm", ".pgm", ".ppm", ".pam", ".pfm"]
			}
		}

		// matchSignature reports whether the reader starts with a Netpbm
		// magic number (P1 to P7, PF, Pf) followed by white space.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(3)
			let n = io.readFull(r, b) onerror recover 0
			return n == 3 && pnmMagic(b, 0) >= 0 && pnmSpace(b[2])
		}

		// info reads the first image's size and format from its header.
		// Fails when the bytes are not a Netpbm header.
		def info(data byte[]) !ImageInfo {
			let h = try pnmHeader(data, 0)
			let format = color.ColorFormat.RGB
			if h.channels == 1 {
				format = color.ColorFormat.Gray
			} else if h.channels == 2 || h.channels == 4 {
				format = color.ColorFormat.RGBA
			}
			return ImageInfo{
				size:        new geom.Size(float(h.width), float(h.height)),
				colorFormat: format,
			}
		}

		// info reads the first image's size and format from the reader.
		// Fails when the data is not a Netpbm header, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads every image of the bytes into `images` and the header
		// comments into `comment`, and returns the first image. Fails when
		// they are not Netpbm data, or are truncated.
		def decode(data byte[]) !Image {
			images = Image[]
			let lines string[]
			let pos = 0
			for {
				let h = try pnmHeader(data, pos)
				lines.push(...h.comments)
				images.push(try pnmRaster(data, h))
				pos = h.end
				// Further images follow only after white space.
				for pos < data.len() && pnmSpace(data[pos]) {
					pos++
				}
				break when pos + 2 >= data.len() || pnmMagic(data, pos) < 0
			}
			comment = lines.join("\n")
			return images[0]
		}

		// decode reads every image from the reader; see the byte overload.
		// Fails when the data is not Netpbm, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// encode renders the image in `format` (plain when `plain` and the
		// format has a plain variant), samples up to `maxValue`. Fails when
		// the image is empty or maxValue is outside 1 to 65535.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image to the writer; see the byte overload.
		// Fails with the writer's error, or as the byte overload does.
		def encode(img Image, writer io.Writer) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			fail "pnm: empty image" when w <= 0 || h <= 0
			fail "pnm: maxValue {maxValue} is outside 1 to 65535" when maxValue < 1 || maxValue > 65535
			try writer.write(pnmEncode(img, w, h, pnmFormatOf(img, w, h, format), plain, maxValue, comment))
		}
	}
}

internal partial module std.formats.image.pnm {
	use (
		std.simd
		std.formats.image::*
		std.formats.image.png::(pngRgbToRgba, pngGrayToRgba)
	)

	// One image's header: its kind (1 to 7 for P1 to P7, 8 for PF, 9 for
	// Pf), size, channels and largest sample, PFM's scale, where its
	// raster starts and where the image ends.
	struct PNMHeader {
		kind     int
		width    int
		height   int
		channels int
		maxval   int
		scale    float
		comments string[]
		start    int
		end      int
	}

	// The kind of the magic number at data[at:at + 2]: 1 to 7 for P1 to
	// P7, 8 for PF, 9 for Pf, -1 for none.
	def pnmMagic(data byte[], at int) int {
		return -1 when at + 2 > data.len() || data[at] != byte('P')
		let c = data[at + 1]
		return int(c) - int(byte('0')) when c >= byte('1') && c <= byte('7')
		return 8 when c == byte('F')
		return 9 when c == byte('f')
		return -1
	}

	def pnmSpace(b byte) bool {
		return b == byte(' ') || b == byte('\t') || b == byte('\n') || b == byte('\r') || b == byte(11) || b == byte(12)
	}

	// Reads header tokens: skips white space and `#` comments (kept in
	// `comments`), then returns the token and the position after it.
	struct PNMCursor {
		pos      int
		comments string[]
	}

	def pnmToken(data byte[], c PNMCursor) !string {
		for c.pos < data.len() {
			let b = data[c.pos]
			if b == byte('#') {
				let from = c.pos + 1
				for c.pos < data.len() && data[c.pos] != byte('\n') && data[c.pos] != byte('\r') {
					c.pos++
				}
				c.comments.push(string(data[from:c.pos]).trim())
				continue
			}
			break unless pnmSpace(b)
			c.pos++
		}
		let from = c.pos
		for c.pos < data.len() && !pnmSpace(data[c.pos]) && data[c.pos] != byte('#') {
			c.pos++
		}
		fail "pnm: truncated header" when from == c.pos
		return string(data[from:c.pos])
	}

	def pnmNumber(data byte[], c PNMCursor, what string) !int {
		let t = try pnmToken(data, c)
		for let (_, b) in t.bytes() {
			fail "pnm: {what} {t} is not a number" unless b >= byte('0') && b <= byte('9')
		}
		fail "pnm: {what} {t} is too large" when t.len() > 9
		return parseInt<int>(t)
	}

	// The header of the image at data[at:].
	// Fails when it is malformed or names values Netpbm does not allow.
	def pnmHeader(data byte[], at int) !PNMHeader {
		let kind = pnmMagic(data, at)
		fail "pnm: not a Netpbm image" when kind < 0
		let c = PNMCursor{pos: at + 2}
		let h = PNMHeader{kind: kind, maxval: 1, scale: 1.0}
		if kind == 7 {
			h.channels = 0
			for {
				let key = try pnmToken(data, c)
				break when key == "ENDHDR"
				match key {
					case "WIDTH":
						h.width = try pnmNumber(data, c, "WIDTH")
					case "HEIGHT":
						h.height = try pnmNumber(data, c, "HEIGHT")
					case "DEPTH":
						h.channels = try pnmNumber(data, c, "DEPTH")
					case "MAXVAL":
						h.maxval = try pnmNumber(data, c, "MAXVAL")
					case "TUPLTYPE":
						// The channels follow from DEPTH (BLACKANDWHITE samples are 0
						// for black, as grey ones are), so the type name is skipped.
						for c.pos < data.len() && data[c.pos] != byte('\n') {
							c.pos++
						}
					default:
						fail "pnm: unknown PAM header line {key}"
				}
			}
			fail "pnm: PAM depth {h.channels} is not 1 to 4" when h.channels < 1 || h.channels > 4
		} else {
			h.width = try pnmNumber(data, c, "width")
			h.height = try pnmNumber(data, c, "height")
			if kind == 8 || kind == 9 {
				let t = try pnmToken(data, c)
				let s = parseFloat<float>(t)
				fail "pnm: PFM scale is 0" when s == 0.0
				h.scale = s
				h.channels = kind == 8 ?? (3, 1)
			} else {
				h.maxval = kind == 1 || kind == 4 ?? (1, try pnmNumber(data, c, "maxval"))
				h.channels = kind == 3 || kind == 6 ?? (3, 1)
			}
		}
		fail "pnm: size {h.width}x{h.height}" when h.width <= 0 || h.height <= 0
		fail "pnm: maxval {h.maxval} is outside 1 to 65535" when h.maxval < 1 || h.maxval > 65535
		const maxPixels = 256 * 1024 * 1024
		fail "pnm: image too large" when h.width > maxPixels / h.height
		// One white space character ends the header of a raw raster.
		if kind != 1 && kind != 2 && kind != 3 && kind != 7 {
			fail "pnm: truncated header" when c.pos >= data.len() || !pnmSpace(data[c.pos])
			c.pos++
		} else if kind == 7 {
			// ENDHDR ends its line.
			for c.pos < data.len() && data[c.pos] != byte('\n') {
				c.pos++
			}
			c.pos++
		}
		h.comments = c.comments
		h.start = c.pos
		return h
	}

	// The image whose header is `h`; sets h.end past its raster.
	// Fails when the raster is truncated or holds a sample above maxval.
	def pnmRaster(data byte[], h PNMHeader) !Image {
		let img = new Image(h.width, h.height)
		let px = img.raw()
		let (w, ht) = (h.width, h.height)
		match h.kind {
			case 1, 2, 3:
				try pnmPlain(data, h, px)
			case 4:
				let rowBytes = (w + 7) / 8
				h.end = h.start + rowBytes * ht
				fail "pnm: truncated raster" when h.end > data.len()
				for let y = 0; y < ht; y++ {
					let src = h.start + y * rowBytes
					let o = y * w * 4
					for let x = 0; x < w; x++ {
						let v = (int(data[src + x / 8]) >> (7 - x % 8)) & 1 == 1 ?? (byte(0), byte(255))
						px[o] = v
						px[o + 1] = v
						px[o + 2] = v
						px[o + 3] = byte(255)
						o += 4
					}
				}
			case 8, 9:
				h.end = h.start + w * ht * h.channels * 4
				fail "pnm: truncated raster" when h.end > data.len()
				let little = h.scale < 0.0
				for let y = 0; y < ht; y++ {
					// Rows run bottom to top.
					let src = h.start + (ht - 1 - y) * w * h.channels * 4
					let o = y * w * 4
					for let x = 0; x < w; x++ {
						for let k = 0; k < 3; k++ {
							let at = src + (x * h.channels + (h.channels == 3 ?? (k, 0))) * 4
							let bits = little ?? (int(data[at]) | int(data[at + 1]) << 8 | int(data[at + 2]) << 16 | int(data[at + 3]) << 24, int(data[at + 3]) | int(data[at + 2]) << 8 | int(data[at + 1]) << 16 | int(data[at]) << 24)
							let v = float(__bitcast_f32_from_u32(uint32(bits)))
							px[o + k] = byte(int((v != v ?? (0.0, v.clamp(0.0, 1.0))) * 255.0 + 0.5))
						}
						px[o + 3] = byte(255)
						o += 4
					}
				}
			default:
				let wide = h.maxval > 255
				let sample = wide ?? (2, 1)
				h.end = h.start + w * ht * h.channels * sample
				fail "pnm: truncated raster" when h.end > data.len()
				if !wide && h.maxval == 255 && (h.channels == 1 || h.channels == 3) {
					pnmSpread(data, h, px)
				} else {
					try pnmScaled(data, h, px, sample)
				}
		}
		return img
	}

	// Raw 8-bit grey or RGB rows of maxval 255 spread to RGBA, sixteen
	// bytes a shuffle, row bands on tasks for large images.
	def pnmSpread(data byte[], h PNMHeader, px byte[]) {
		let (w, ht, ch) = (h.width, h.height, h.channels)
		let tasks = (w * ht / (1 << 18)).clamp(1, 32).min(ht)
		forall let t in 0..tasks {
			let opaque = simd.splat16<byte>(byte(255))
			let rgb = simd.load16<byte>(pngRgbToRgba, 0)
			let g0 = simd.load16<byte>(pngGrayToRgba, 0)
			let g1 = simd.load16<byte>(pngGrayToRgba, 16)
			let g2 = simd.load16<byte>(pngGrayToRgba, 32)
			let g3 = simd.load16<byte>(pngGrayToRgba, 48)
			let alpha = rgb.ge(simd.splat16<byte>(byte(16)))
			for let y = ht * t / tasks; y < ht * (t + 1) / tasks; y++ {
				let src = h.start + y * w * ch
				let o = y * w * 4
				let x = 0
				if ch == 3 {
					// The last load must stay inside the data.
					for x * 3 + 16 <= w * 3 && src + x * 3 + 16 <= data.len() {
						simd.store16<byte>(px, o + x * 4, alpha.blend(opaque, simd.load16<byte>(data, src + x * 3).shuffle(rgb)))
						x += 4
					}
				} else {
					for x + 16 <= w {
						let g = simd.load16<byte>(data, src + x)
						simd.store16<byte>(px, o + x * 4, alpha.blend(opaque, g.shuffle(g0)))
						simd.store16<byte>(px, o + x * 4 + 16, alpha.blend(opaque, g.shuffle(g1)))
						simd.store16<byte>(px, o + x * 4 + 32, alpha.blend(opaque, g.shuffle(g2)))
						simd.store16<byte>(px, o + x * 4 + 48, alpha.blend(opaque, g.shuffle(g3)))
						x += 16
					}
				}
				for; x < w; x++ {
					let s = src + x * ch
					let q = o + x * 4
					px[q] = data[s]
					px[q + 1] = data[s + (ch == 3 ?? (1, 0))]
					px[q + 2] = data[s + (ch == 3 ?? (2, 0))]
					px[q + 3] = byte(255)
				}
			}
		}
	}

	// Raw rows of any maxval and 1 to 4 channels (grey, grey and alpha, RGB,
	// RGBA), samples scaled to 8 bits.
	// Fails when a sample is above maxval.
	def pnmScaled(data byte[], h PNMHeader, px byte[], sample int) !none {
		let (w, ht, ch, maxval) = (h.width, h.height, h.channels, h.maxval)
		let n = w * ht
		let s = h.start
		for let i = 0; i < n; i++ {
			let v int[]
			v.len(ch)
			for let k = 0; k < ch; k++ {
				let raw = sample == 2 ?? (int(data[s]) << 8 | int(data[s + 1]), int(data[s]))
				fail "pnm: sample {raw} above maxval {maxval}" when raw > maxval
				v[k] = (raw * 255 + maxval / 2) / maxval
				s += sample
			}
			let o = i * 4
			if ch <= 2 {
				px[o] = byte(v[0])
				px[o + 1] = byte(v[0])
				px[o + 2] = byte(v[0])
				px[o + 3] = byte(ch == 2 ?? (v[1], 255))
			} else {
				px[o] = byte(v[0])
				px[o + 1] = byte(v[1])
				px[o + 2] = byte(v[2])
				px[o + 3] = byte(ch == 4 ?? (v[3], 255))
			}
		}
		return none
	}

	// The plain (ASCII) rasters: PBM digits (white space optional between
	// them), PGM and PPM decimal samples.
	// Fails when the raster is truncated or holds a bad sample.
	def pnmPlain(data byte[], h PNMHeader, px byte[]) !none {
		let c = PNMCursor{pos: h.start}
		let n = h.width * h.height
		for let i = 0; i < n; i++ {
			let o = i * 4
			if h.kind == 1 {
				for c.pos < data.len() && (pnmSpace(data[c.pos]) || data[c.pos] == byte('#')) {
					if data[c.pos] == byte('#') {
						for c.pos < data.len() && data[c.pos] != byte('\n') {
							c.pos++
						}
					} else {
						c.pos++
					}
				}
				fail "pnm: truncated raster" when c.pos >= data.len()
				let d = data[c.pos]
				fail "pnm: PBM sample {string(data[c.pos:c.pos + 1])} is not 0 or 1" unless d == byte('0') || d == byte('1')
				c.pos++
				let v = d == byte('1') ?? (byte(0), byte(255))
				px[o] = v
				px[o + 1] = v
				px[o + 2] = v
				px[o + 3] = byte(255)
				continue
			}
			for let k = 0; k < h.channels; k++ {
				let raw = try pnmNumber(data, c, "sample")
				fail "pnm: sample {raw} above maxval {h.maxval}" when raw < 0 || raw > h.maxval
				let v = byte((raw * 255 + h.maxval / 2) / h.maxval)
				if h.channels == 1 {
					px[o] = v
					px[o + 1] = v
					px[o + 2] = v
				} else {
					px[o + k] = v
				}
			}
			px[o + 3] = byte(255)
		}
		h.end = c.pos
		return none
	}

	// The format Auto stands for: PAM when a pixel is not opaque, PGM when
	// every pixel is grey, else PPM.
	def pnmFormatOf(img Image, w int, h int, format PNMFormat) PNMFormat {
		return format unless format == PNMFormat.Auto
		let px = img.raw()
		let gray = true
		for let i = 0; i < w * h; i++ {
			let o = i * 4
			return PNMFormat.Arbitrary when px[o + 3] != byte(255)
			gray = gray && px[o] == px[o + 1] && px[o] == px[o + 2]
		}
		return gray ?? (PNMFormat.Graymap, PNMFormat.Pixmap)
	}

	// The file of one image in `format`.
	def pnmEncode(img Image, w int, h int, format PNMFormat, plain bool, maxval int, comment string) byte[] {
		let px = img.raw()
		let header string
		let gray = true
		for let i = 0; i < w * h && gray; i++ {
			gray = px[i * 4] == px[i * 4 + 1] && px[i * 4] == px[i * 4 + 2]
		}
		let comments = ""
		if comment.len() > 0 {
			for let (_, line) in comment.split("\n") {
				comments += "# {line}\n"
			}
		}
		let channels = 3
		match format {
			case PNMFormat.Bitmap:
				header = "{plain ?? ("P1", "P4")}\n{comments}{w} {h}\n"
				channels = 0
			case PNMFormat.Graymap:
				header = "{plain ?? ("P2", "P5")}\n{comments}{w} {h}\n{maxval}\n"
				channels = 1
			case PNMFormat.Pixmap:
				header = "{plain ?? ("P3", "P6")}\n{comments}{w} {h}\n{maxval}\n"
			case PNMFormat.FloatMap:
				header = "PF\n{comments}{w} {h}\n-1.0\n"
				channels = -1
			default:
				channels = gray ?? (2, 4)
				header = "P7\n{comments}WIDTH {w}\nHEIGHT {h}\nDEPTH {channels}\nMAXVAL {maxval}\nTUPLTYPE {gray ?? ("GRAYSCALE_ALPHA", "RGB_ALPHA")}\nENDHDR\n"
		}
		let out = header.bytes()
		let wide = maxval > 255
		if channels == 0 {
			// PBM: black where luminance is below half.
			if plain {
				for let y = 0; y < h; y++ {
					let line = ""
					for let x = 0; x < w; x++ {
						line += pnmBlack(px, (y * w + x) * 4) ?? ("1", "0")
						if line.len() >= 70 {
							out.push(...(line + "\n").bytes())
							line = ""
						}
					}
					out.push(...(line + "\n").bytes())
				}
				return out
			}
			let rowBytes = (w + 7) / 8
			let at = out.len()
			out.len(at + rowBytes * h)
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					if pnmBlack(px, (y * w + x) * 4) {
						let b = at + y * rowBytes + x / 8
						out[b] = byte(int(out[b]) | (0x80 >> (x % 8)))
					}
				}
			}
			return out
		}
		if channels < 0 {
			// PFM, little-endian (negative scale), rows bottom-up.
			let at = out.len()
			out.len(at + w * h * 12)
			for let y = 0; y < h; y++ {
				let src = (h - 1 - y) * w * 4
				for let x = 0; x < w; x++ {
					for let k = 0; k < 3; k++ {
						let bits = int(__bitcast_u32_from_f32(float32(px[src + x * 4 + k]) / float32(255)))
						let o = at + ((y * w + x) * 3 + k) * 4
						out[o] = byte(bits & 255)
						out[o + 1] = byte((bits >> 8) & 255)
						out[o + 2] = byte((bits >> 16) & 255)
						out[o + 3] = byte((bits >> 24) & 255)
					}
				}
			}
			return out
		}
		// Samples: grey, grey and alpha, RGB or RGBA from each pixel.
		let picks int[]
		match channels {
			case 1:
				picks = int[0]
			case 2:
				picks = int[0, 3]
			case 3:
				picks = int[0, 1, 2]
			default:
				picks = int[0, 1, 2, 3]
		}
		if plain && channels <= 3 {
			let line = ""
			for let i = 0; i < w * h; i++ {
				for let (_, k) in picks {
					let v = (int(px[i * 4 + k]) * maxval + 127) / 255
					let word = "{v}"
					if line.len() + word.len() + 1 > 70 {
						out.push(...(line + "\n").bytes())
						line = ""
					}
					line = line.len() == 0 ?? (word, line + " " + word)
				}
			}
			out.push(...(line + "\n").bytes())
			return out
		}
		let sample = wide ?? (2, 1)
		let at = out.len()
		out.len(at + w * h * picks.len() * sample)
		let o = at
		for let i = 0; i < w * h; i++ {
			for let (_, k) in picks {
				let v = (int(px[i * 4 + k]) * maxval + 127) / 255
				if wide {
					out[o] = byte(v >> 8)
					out[o + 1] = byte(v & 255)
				} else {
					out[o] = byte(v)
				}
				o += sample
			}
		}
		return out
	}

	// Whether the pixel at `o` is black in a PBM: luminance below half.
	def pnmBlack(px byte[], o int) bool {
		let lum = 299 * int(px[o]) + 587 * int(px[o + 1]) + 114 * int(px[o + 2])
		return lum < 128 * 1000
	}
}
