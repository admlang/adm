partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.formats.image.psd::*
	)

	// PSDLayer is one layer of a Photoshop document: its pixels and how they
	// composite. A group (folder) is a layer too, with `group` set and no
	// pixels; its members come just before it in `PSD.layers`, one `depth`
	// deeper.
	type PSDLayer {
		// The name the Layers panel shows.
		name      string
		// Where the pixels sit on the canvas, in pixels; may reach past the
		// canvas edges.
		bounds    geom.Rectangle<int>
		// Opacity applied on top of the pixels' own alpha, 0 (clear) to 255.
		opacity   int
		visible   bool
		blendMode color.BlendMode
		// Clipped to the layer below it (a clipping mask).
		clipped   bool
		// A group rather than a pixel layer.
		group     bool
		// How many groups hold the layer, 0 at the top level.
		depth     int
		// The pixels, the size of `bounds`, straight RGBA, with the layer
		// mask applied to the alpha.
		image     Image

		// A group whose members blend straight into the layers below it, as
		// Photoshop groups do by default, rather than as one merged image.
		// `blendMode` is Normal then.
		passThrough bool

		// A visible, opaque, normal pixel layer showing `image` with its top
		// left corner at (x, y).
		def new(name string, image Image, x int = 0, y int = 0) {
			self.name = name
			self.image = image
			bounds = new geom.Rectangle<int>(position = new geom.Point<int>(x, y), size = new geom.Size<int>(int(image.size().width), int(image.size().height)))
			opacity = 255
			visible = true
			blendMode = color.BlendMode.Normal
			clipped = false
			group = false
			depth = 0
			passThrough = false
		}
	}

	// PSD is the Photoshop document codec (PSD, and large-document PSB on
	// decode). `decode` returns the merged image the file stores and keeps
	// the layers, resolution and ICC profile on the codec; `encode(writer)`
	// writes the layers back.
	//
	// ```
	// let psd = new PSD()
	// let merged = try psd.decode(data)
	// for layer in psd.layers { println(layer.name) }
	// let logo = psd.layer("Logo")
	// ```
	@codec("Photoshop PSD")
	type PSD {
		// The layers bottom to top, the order they composite in.
		layers        PSDLayer[]
		// Canvas size in pixels. Set by decode; when zero, encode takes it
		// from the layers.
		width         int
		height        int
		// Resolution in pixels per inch.
		horizontalDpi float      = 72.0
		verticalDpi   float      = 72.0
		// The embedded ICC colour profile, empty when there is none. Decode
		// keeps it; pixels are not colour-managed.
		iccProfile    byte[]

		internal merged ?Image

		mimeType string[] {
			def get() string[] {
				return string["image/psd", "image/vnd.adobe.photoshop", "image/x-psd", "image/photoshop", "image/x-photoshop"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".psd", ".psb"]
			}
		}

		// matchSignature reports whether the reader starts with a Photoshop
		// document (PSD or PSB) header.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(6)
			let n = r.read(b) onerror recover 0
			return false when n != 6
			return b[0] == byte(56) && b[1] == byte(66) && b[2] == byte(80) && b[3] == byte(83) && b[4] == byte(0) && (b[5] == byte(1) || b[5] == byte(2))
		}

		// info reads the canvas size and colour mode from the header. Fails
		// when the bytes are not a Photoshop document header.
		def info(data byte[]) !ImageInfo {
			try psdHeader(data)
			let mode = psdU16(data, 24)
			return ImageInfo{
				size: new geom.Size(float(psdU32(data, 18)), float(psdU32(data, 14))),
				colorFormat: mode == psdModeIndexed ?? (color.ColorFormat.Palette, mode == psdModeGrayscale ?? (color.ColorFormat.Gray, mode == psdModeCMYK ?? (color.ColorFormat.CMYK, color.ColorFormat.RGBA))),
			}
		}

		// info reads the canvas size and colour mode from the reader. Fails
		// when the data is not a Photoshop document header, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads a Photoshop document from the bytes and returns its
		// merged image; the layers land in `layers`. Documents without a
		// merged image are flattened from their layers. Bitmap, grayscale,
		// duotone (as gray), indexed, RGB and CMYK at 1, 8 or 16 bits are
		// read. Fails on other modes and depths, and on corrupt data.
		def decode(data byte[]) !Image {
			layers = []
			iccProfile = []
			merged = none
			horizontalDpi = 72.0
			verticalDpi = 72.0

			try psdHeader(data)
			let big = psdU16(data, 4) == 2
			let channels = psdU16(data, 12)
			height = psdU32(data, 14)
			width = psdU32(data, 18)
			let depth = psdU16(data, 22)
			let mode = psdU16(data, 24)
			fail "psd: unsupported depth {depth}" unless depth := 1 || 8 || 16
			fail "psd: Lab colour is not supported" when mode == psdModeLab
			fail "psd: unsupported colour mode {mode}" unless mode == psdModeBitmap || mode == psdModeGrayscale || mode == psdModeIndexed || mode == psdModeRGB || mode == psdModeCMYK || mode == psdModeMultichannel || mode == psdModeDuotone
			fail "psd: bitmap documents are one bit deep" when (mode == psdModeBitmap) != (depth == 1)

			let pos = 26
			fail "psd: truncated colour mode data" when pos + 4 > data.len()
			let cmLen = psdU32(data, pos)
			pos += 4
			fail "psd: truncated colour mode data" when pos + cmLen > data.len()
			let palette = data[pos:pos + cmLen]
			fail "psd: indexed document without a palette" when mode == psdModeIndexed && cmLen < 768
			pos += cmLen

			fail "psd: truncated image resources" when pos + 4 > data.len()
			let resLen = psdU32(data, pos)
			pos += 4
			fail "psd: truncated image resources" when pos + resLen > data.len()
			let transIndex = try readResources(data, pos, pos + resLen)
			pos += resLen

			let lw = big ?? (8, 4)
			fail "psd: truncated layer section" when pos + lw > data.len()
			let lmLen = psdLen(data, pos, big)
			pos += lw
			fail "psd: truncated layer section" when pos + lmLen > data.len()
			let mergedAlpha = false
			let sawLayers = false
			if lmLen > 0 {
				let lend = pos + lmLen
				let liLen = psdLen(data, pos, big)
				fail "psd: truncated layer info" when pos + lw + liLen > lend
				if liLen > 0 {
					mergedAlpha = try readLayers(data, pos + lw, pos + lw + liLen, depth, mode, big, palette, transIndex)
					sawLayers = true
				}
				// Global mask info, then document-level blocks, which carry the
				// layers of 16-bit documents.
				let p = pos + lw + liLen
				p += 4 + psdU32(data, p) when p + 4 <= lend
				for p + 12 <= lend {
					let sig = psdKey(data, p)
					break unless sig := "8BIM" || "8B64"
					let key = psdKey(data, p + 4)
					let long = big && psdLongKey(key)
					let blen = psdLen(data, p + 8, long)
					let body = p + 8 + (long ?? (8, 4))
					fail "psd: truncated layer block" when body + blen > lend
					if (key == "Lr16" || key == "Layr") && !sawLayers && blen > 0 {
						mergedAlpha = try readLayers(data, body, body + blen, depth, mode, big, palette, transIndex)
						sawLayers = true
					}
					p = body + blen
					// Some writers pad blocks to four bytes without counting it.
					p = body + (blen + 3) / 4 * 4 when p + 4 <= lend && psdKey(data, p) != "8BIM" && psdKey(data, p) != "8B64"
				}
			}
			pos += lmLen

			let colorCh = psdColorChannels(mode)
			let hasAlpha = channels > colorCh && (mergedAlpha || !sawLayers)
			if pos + 2 > data.len() {
				fail "psd: no image data" when layers.len() == 0
				let flat = flatten()
				merged = flat
				return flat
			}
			let img = try readComposite(data, pos, channels, colorCh, hasAlpha, depth, mode, big, palette, transIndex)
			merged = img
			return img
		}

		// decode reads a Photoshop document from the reader; see decode(bytes).
		// Fails when the data is not a document the codec reads, or the reader
		// fails.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// The first layer with the name, groups included; none when there is
		// no such layer.
		def layer(name string) ?PSDLayer {
			for let each in layers {
				return each when each.name == name
			}
			return none
		}

		// add puts a pixel layer on top of the others and returns it, for
		// setting its opacity, blend mode and the rest.
		def add(image Image, name string, x int = 0, y int = 0) PSDLayer {
			let added = new PSDLayer(name, image, x, y)
			layers.push(added)
			return added
		}

		// flatten composites the visible layers bottom to top onto a clear
		// canvas, with their opacity and blend modes. A hidden group hides its
		// members and a group's opacity scales theirs; clipping masks, layer
		// effects and adjustment layers are not rendered.
		def flatten() Image {
			let size = canvasSize()
			let out = new Image(size.width, size.height)
			// Per depth: whether an enclosing group hides the layer, and the
			// opacity the enclosing groups multiply to. A group's own record
			// follows its members, so look ahead for it.
			for let i = 0; i < layers.len(); i++ {
				let item = layers[i]
				continue when item.group || !item.visible
				let shown = true
				let opacity = item.opacity
				let d = item.depth
				for let j = i + 1; j < layers.len() && d > 0; j++ {
					let g = layers[j]
					if g.group && g.depth == d - 1 {
						shown = false unless g.visible
						opacity = opacity * g.opacity / 255
						d--
					}
				}
				continue unless shown
				let src = item.image
				if opacity < 255 {
					src = item.image.copy()
					let px = src.raw()
					for let k = 3; k < px.len(); k += 4 {
						px[k] = byte(int(px[k]) * opacity / 255)
					}
				}
				out.draw(src, item.bounds.position.x, item.bounds.position.y, item.blendMode)
			}
			return out
		}

		// encode renders the image as a one-layer 8-bit RGB Photoshop
		// document, with alpha when any pixel is not opaque. Fails when the
		// image is empty or larger than 30000 pixels on a side.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image to the writer as a one-layer 8-bit RGB
		// Photoshop document. Fails when the image is empty or larger than
		// 30000 pixels on a side, or the writer does.
		def encode(img Image, writer io.Writer) !none {
			let one PSDLayer[]
			one.push(new PSDLayer("Layer 1", img))
			return writeDocument(writer, int(img.size().width), int(img.size().height), one, img)
		}

		// encode renders `layers` as an 8-bit RGB Photoshop document; see
		// encode(writer). Fails as that does.
		def encode() !byte[] {
			let out = new bytes.Buffer()
			try encode(out)
			return out.bytes()
		}

		// encode writes `layers` to the writer as an 8-bit RGB Photoshop
		// document, groups included, with `flatten()` as the merged image.
		// Without layers it writes the image the last decode returned. The
		// canvas is `width` by `height`, or the extent of the layers when
		// those are zero. Fails when there is nothing to write, the canvas is
		// larger than 30000 pixels on a side, the group depths do not nest,
		// or the writer fails.
		def encode(writer io.Writer) !none {
			if layers.len() == 0 {
				let m = merged
				fail "psd: nothing to encode" when m is none
				return encode(m, writer)
			}
			let size = canvasSize()
			return writeDocument(writer, size.width, size.height, layers, flatten())
		}

		// The canvas: `width` by `height`, or the layers' extent when unset.
		internal def canvasSize() geom.Size<int> {
			return new geom.Size<int>(width, height) when width > 0 && height > 0
			let w = 0
			let h = 0
			for let each in layers {
				let r = each.bounds.position.x + each.bounds.size.width
				let b = each.bounds.position.y + each.bounds.size.height
				w = r when r > w
				h = b when b > h
			}
			return new geom.Size<int>(w, h)
		}

		// Checks the fixed header. Fails when it is not a Photoshop document.
		internal def psdHeader(d byte[]) !none {
			expects {
				assert d.len() >= 26 onerror fail "psd: not a Photoshop document"
				assert d[0] == byte(56) && d[1] == byte(66) && d[2] == byte(80) && d[3] == byte(83) onerror fail "psd: not a Photoshop document"
			}
			let version = psdU16(d, 4)
			fail "psd: unsupported version {version}" unless version := 1 || 2
			let channels = psdU16(d, 12)
			fail "psd: bad channel count {channels}" when channels < 1 || channels > 56
			let h = psdU32(d, 14)
			let w = psdU32(d, 18)
			fail "psd: bad dimensions {w}x{h}" when w < 1 || h < 1 || w > 300000 || h > 300000
		}

		// Reads the resources the codec keeps. Returns the transparent palette
		// index, or -1.
		internal def readResources(d byte[], start int, end int) !int {
			let trans = -1
			let p = start
			for p + 12 <= end {
				let id = psdU16(d, p + 4)
				let nameLen = int(d[p + 6])
				let q = p + 6 + 1 + nameLen
				q += 1 when (1 + nameLen) % 2 != 0
				fail "psd: truncated image resource" when q + 4 > end
				let size = psdU32(d, q)
				q += 4
				fail "psd: truncated image resource" when q + size > end
				if id == 1005 && size >= 16 {
					horizontalDpi = float(psdU32(d, q)) / 65536.0
					verticalDpi = float(psdU32(d, q + 8)) / 65536.0
				} else if id == 1039 {
					let icc byte[]
					icc.len(size)
					for let i = 0; i < size; i++ {
						icc[i] = d[q + i]
					}
					iccProfile = icc
				} else if id == 1047 && size >= 2 {
					trans = psdU16(d, q)
				}
				p = q + size + size % 2
			}
			return trans
		}

		// Reads the layer records and their channels. Returns whether the
		// merged image's first extra channel is its transparency.
		internal def readLayers(d byte[], start int, end int, depth int, mode int, big bool, palette byte[], transIndex int) !bool {
			expects {
				assert start + 2 <= end onerror fail "psd: truncated layer info"
			}
			let count = psdI16(d, start)
			let mergedAlpha = count < 0
			count = 0 - count when count < 0
			let p = start + 2
			let cw = big ?? (8, 4)

			let recs psdLayerRecord[]
			for let i = 0; i < count; i++ {
				fail "psd: truncated layer record" when p + 18 > end
				let rec = new psdLayerRecord()
				rec.top = psdI32(d, p)
				rec.left = psdI32(d, p + 4)
				rec.bottom = psdI32(d, p + 8)
				rec.right = psdI32(d, p + 12)
				fail "psd: bad layer bounds" when rec.bottom < rec.top || rec.right < rec.left || rec.right - rec.left > 300000 || rec.bottom - rec.top > 300000
				let nch = psdU16(d, p + 16)
				p += 18
				fail "psd: truncated layer record" when p + nch * (2 + cw) + 16 > end
				for let c = 0; c < nch; c++ {
					rec.channelIds.push(psdI16(d, p))
					rec.channelLens.push(psdLen(d, p + 2, big))
					p += 2 + cw
				}
				fail "psd: bad blend mode signature" unless psdKey(d, p) == "8BIM"
				rec.blendKey = psdKey(d, p + 4)
				rec.opacity = int(d[p + 8])
				rec.clipping = int(d[p + 9]) != 0
				rec.flags = int(d[p + 10])
				let extraLen = psdU32(d, p + 12)
				p += 16
				let extraEnd = p + extraLen
				fail "psd: truncated layer record" when extraEnd > end || p + 4 > extraEnd

				let maskLen = psdU32(d, p)
				p += 4
				fail "psd: truncated layer mask" when p + maskLen > extraEnd
				if maskLen >= 18 {
					rec.maskTop = psdI32(d, p)
					rec.maskLeft = psdI32(d, p + 4)
					rec.maskBottom = psdI32(d, p + 8)
					rec.maskRight = psdI32(d, p + 12)
					rec.maskDefault = int(d[p + 16])
					rec.maskFlags = int(d[p + 17])
				}
				p += maskLen
				fail "psd: truncated blending ranges" when p + 4 > extraEnd
				p += 4 + psdU32(d, p)
				fail "psd: truncated layer name" when p + 1 > extraEnd
				let nameLen = int(d[p])
				fail "psd: truncated layer name" when p + 1 + nameLen > extraEnd
				rec.name = string(d[p + 1:p + 1 + nameLen])
				p += ((1 + nameLen + 3) / 4) * 4

				for p + 12 <= extraEnd {
					let sig = psdKey(d, p)
					break unless sig := "8BIM" || "8B64"
					let key = psdKey(d, p + 4)
					let long = big && psdLongKey(key)
					let blen = psdLen(d, p + 8, long)
					let body = p + 8 + (long ?? (8, 4))
					break when body + blen > extraEnd
					if key == "luni" && blen >= 4 {
						let units = psdU32(d, body)
						rec.name = psdUTF16(d, body + 4, units) when 4 + units * 2 <= blen
					} else if (key == "lsct" || key == "lsdk") && blen >= 4 {
						rec.section = psdU32(d, body)
						rec.blendKey = psdKey(d, body + 8) when blen >= 12 && psdKey(d, body + 4) == "8BIM"
					}
					p = body + blen
				}
				p = extraEnd
				recs.push(rec)
			}

			// Channel image data, layer by layer, channel by channel.
			let groupDepth = 0
			for let rec in recs {
				let w = rec.right - rec.left
				let h = rec.bottom - rec.top
				let colorCh = psdColorChannels(mode)
				let planes byte[]
				planes.len(w * h * colorCh)
				let alpha byte[]
				let mask byte[]
				for let c = 0; c < rec.channelIds.len(); c++ {
					let id = rec.channelIds[c]
					let clen = rec.channelLens[c]
					fail "psd: truncated channel data" when p + clen > end || clen < 0
					if id == -2 && rec.maskRight > rec.maskLeft && rec.maskBottom > rec.maskTop {
						mask = try psdDecodeChannel(d, p, p + clen, rec.maskRight - rec.maskLeft, rec.maskBottom - rec.maskTop, depth, big)
					} else if id == -1 {
						alpha = try psdDecodeChannel(d, p, p + clen, w, h, depth, big)
					} else if id >= 0 && id < colorCh {
						let plane = try psdDecodeChannel(d, p, p + clen, w, h, depth, big)
						for let i = 0; i < w * h; i++ {
							planes[id * w * h + i] = plane[i]
						}
					}
					p += clen
				}

				if rec.section == psdSectionDivider {
					groupDepth++
					continue
				}
				let isGroup = rec.section == psdSectionOpenFolder || rec.section == psdSectionClosedFolder
				groupDepth-- when isGroup && groupDepth > 0

				let img = new Image(w, h)
				psdToRGBA(img, planes, w * h, alpha, mode, palette, transIndex)
				psdApplyMask(img, rec, mask) when mask.len() > 0 && (rec.maskFlags & 2) == 0

				let entry = new PSDLayer(rec.name, img, rec.left, rec.top)
				entry.opacity = rec.opacity
				entry.visible = (rec.flags & 2) == 0
				entry.passThrough = rec.blendKey == "pass"
				entry.blendMode = psdBlendMode(rec.blendKey)
				entry.clipped = rec.clipping
				entry.group = isGroup
				entry.depth = groupDepth
				layers.push(entry)
			}
			return mergedAlpha
		}

		// Reads the merged image section.
		internal def readComposite(d byte[], pos int, channels int, colorCh int, hasAlpha bool, depth int, mode int, big bool, palette byte[], transIndex int) !Image {
			let w = width
			let h = height
			let comp = psdU16(d, pos)
			let p = pos + 2
			let rb = psdRowBytes(w, depth)
			let used = hasAlpha ?? (colorCh + 1, colorCh)
			fail "psd: fewer channels than the colour mode needs" when channels < colorCh
			let planes byte[]
			planes.len(w * h * colorCh)
			let alpha byte[]
			alpha.len(w * h) when hasAlpha

			if comp == 0 {
				fail "psd: truncated image data" when p + rb * h * used > d.len()
				for let c = 0; c < used; c++ {
					let target = c < colorCh ?? (planes, alpha)
					let base = c < colorCh ?? (c * w * h, 0)
					for let y = 0; y < h; y++ {
						psdEmitRow(d, p + (c * h + y) * rb, w, depth, target, base + y * w, 1)
					}
				}
			} else if comp == 1 {
				let cw = big ?? (4, 2)
				fail "psd: truncated image data" when p + channels * h * cw > d.len()
				let q = p + channels * h * cw
				let row byte[]
				row.len(rb)
				for let c = 0; c < used; c++ {
					let target = c < colorCh ?? (planes, alpha)
					let base = c < colorCh ?? (c * w * h, 0)
					for let y = 0; y < h; y++ {
						let at = p + (c * h + y) * cw
						let n = big ?? (psdU32(d, at), psdU16(d, at))
						fail "psd: truncated image data" when q + n > d.len()
						try psdUnpackBits(d, q, q + n, row, rb)
						psdEmitRow(row, 0, w, depth, target, base + y * w, 1)
						q += n
					}
				}
			} else {
				fail "psd: unsupported image data compression {comp}"
			}

			let img = new Image(w, h)
			psdToRGBA(img, planes, w * h, alpha, mode, palette, transIndex)
			psdUnmatte(img) when hasAlpha
			return img
		}

		// Writes a whole document: 8-bit RGB, the layers with their channels
		// PackBits-compressed, and the merged image.
		internal def writeDocument(writer io.Writer, w int, h int, list PSDLayer[], composite Image) !none {
			expects {
				assert w > 0 && h > 0 onerror fail "psd: cannot encode an empty canvas"
				assert w <= 30000 && h <= 30000 onerror fail "psd: canvas is larger than 30000 pixels on a side"
			}
			let alpha = psdHasAlpha(composite)
			let buf = new bytes.Buffer()

			try buf.write(byte[56, 66, 80, 83, 0, 1, 0, 0, 0, 0, 0, 0])
			try buf.write<uint16>(uint16(alpha ?? (4, 3)))
			try buf.write<uint32>(uint32(h))
			try buf.write<uint32>(uint32(w))
			try buf.write<uint16>(uint16(8))
			try buf.write<uint16>(uint16(psdModeRGB))
			try buf.write<uint32>(uint32(0))

			// Resources: resolution, and the ICC profile when there is one.
			let res = new bytes.Buffer()
			try res.write(byte[56, 66, 73, 77, 0x03, 0xED, 0, 0, 0, 0, 0, 16])
			try res.write<uint32>(uint32(int(horizontalDpi * 65536.0)))
			try res.write(byte[0, 1, 0, 1])
			try res.write<uint32>(uint32(int(verticalDpi * 65536.0)))
			try res.write(byte[0, 1, 0, 1])
			if iccProfile.len() > 0 {
				try res.write(byte[56, 66, 73, 77, 0x04, 0x0F, 0, 0])
				try res.write<uint32>(uint32(iccProfile.len()))
				try res.write(iccProfile)
				try res.write(byte[0]) when iccProfile.len() % 2 != 0
			}
			try buf.write<uint32>(uint32(res.len()))
			try buf.write(res.bytes())

			let info = try layerInfo(list, alpha)
			try buf.write<uint32>(uint32(4 + info.len() + 4))
			try buf.write<uint32>(uint32(info.len()))
			try buf.write(info)
			try buf.write<uint32>(uint32(0))

			// The merged image: RLE counts for every row of every channel, then
			// the rows.
			let nch = alpha ?? (4, 3)
			let counts = new bytes.Buffer()
			let rows byte[]
			let px = composite.raw()
			let stride = composite.stride()
			let row byte[]
			row.len(w)
			for let c = 0; c < nch; c++ {
				for let y = 0; y < h; y++ {
					let o = y * stride + c
					let matte = alpha && c < 3
					for let x = 0; x < w; x++ {
						row[x] = matte ?? (byte(psdMatte(int(px[o]), int(px[o + 3 - c]))), px[o])
						o += 4
					}
					let before = rows.len()
					rows = psdPackBits(row, 0, w, rows)
					try counts.write<uint16>(uint16(rows.len() - before))
				}
			}
			try buf.write<uint16>(uint16(1))
			try buf.write(counts.bytes())
			try buf.write(rows)
			try buf.writeTo(writer)
		}

		// The layer info block, padded to four bytes: the records, then every
		// layer's channels. Group depths become section dividers.
		internal def layerInfo(list PSDLayer[], mergedAlpha bool) !byte[] {
			let records = new bytes.Buffer()
			let data = new bytes.Buffer()
			let count = 0
			let cur = 0
			for let each in list {
				fail "psd: layer depth is negative" when each.depth < 0
				let want = each.group ?? (each.depth + 1, each.depth)
				fail "psd: layer \"{each.name}\" leaves a group its depth does not close" when want < cur && !each.group
				for cur < want {
					try psdWriteLayer(records, data, "</Layer group>", none, 0, 0, 255, visible = true, clipped = false, key = "norm", section = psdSectionDivider)
					count++
					cur++
				}
				if each.group {
					try psdWriteLayer(records, data, each.name, none, 0, 0, each.opacity, each.visible, each.clipped, psdLayerKey(each), psdSectionOpenFolder)
					cur = each.depth
				} else {
					try psdWriteLayer(records, data, each.name, each.image, each.bounds.position.x, each.bounds.position.y, each.opacity, each.visible, each.clipped, psdLayerKey(each), 0)
				}
				count++
			}
			fail "psd: a group is not closed: the last layers are {cur} deep" when cur != 0

			let out = new bytes.Buffer()
			try out.write<int16>(int16(mergedAlpha ?? (0 - count, count)))
			try out.write(records.bytes())
			try out.write(data.bytes())
			for out.len() % 4 != 0 {
				try out.write(byte[0])
			}
			return out.bytes()
		}
	}
}

internal partial module std.formats.image.psd {
	use (
		std.bytes
		std.gfx.color
		std.data.compress.zlib
		std.formats.image::*
	)

	// Colour modes of the file header.
	const (
		psdModeBitmap       = 0
		psdModeGrayscale    = 1
		psdModeIndexed      = 2
		psdModeRGB          = 3
		psdModeCMYK         = 4
		psdModeMultichannel = 7
		psdModeDuotone      = 8
		psdModeLab          = 9
	)

	// Section divider kinds of the `lsct` layer block.
	const (
		psdSectionOpenFolder   = 1
		psdSectionClosedFolder = 2
		psdSectionDivider      = 3
	)

	// Blend mode keys in the order of color.BlendMode, which has a mode for
	// every key; "pass" (a group's pass-through) reads as Normal.
	const psdBlendKeys = string[
		"norm", "diss", "dark", "mul ", "idiv", "lbrn", "dkCl", "lite", "scrn", "div ",
		"lddg", "lgCl", "over", "sLit", "hLit", "vLit", "lLit", "pLit", "hMix", "diff",
		"smud", "fsub", "fdiv", "", "", "", "hue ", "sat ", "colr", "lum "
	]

	const psdBlendModes = color.BlendMode[
		color.BlendMode.Normal, color.BlendMode.Dissolve, color.BlendMode.Darken, color.BlendMode.Multiply,
		color.BlendMode.ColorBurn, color.BlendMode.LinearBurn, color.BlendMode.DarkerColor, color.BlendMode.Lighten,
		color.BlendMode.Screen, color.BlendMode.ColorDodge, color.BlendMode.LinearDodge, color.BlendMode.LighterColor,
		color.BlendMode.Overlay, color.BlendMode.SoftLight, color.BlendMode.HardLight, color.BlendMode.VividLight,
		color.BlendMode.LinearLight, color.BlendMode.PinLight, color.BlendMode.HardMix, color.BlendMode.Difference,
		color.BlendMode.Exclusion, color.BlendMode.Subtract, color.BlendMode.Divide, color.BlendMode.Xor,
		color.BlendMode.Average, color.BlendMode.Negation, color.BlendMode.Hue, color.BlendMode.Saturation,
		color.BlendMode.Color, color.BlendMode.Luminosity
	]

	def psdBlendMode(key string) color.BlendMode {
		for let i = 0; i < psdBlendKeys.len(); i++ {
			return psdBlendModes[i] when psdBlendKeys[i] == key && key != ""
		}
		return color.BlendMode.Normal
	}

	// The key for a mode; modes Photoshop lacks (Xor, Average, Negation) are
	// written as Normal.
	def psdBlendKey(mode color.BlendMode) string {
		for let i = 0; i < psdBlendModes.len(); i++ {
			return psdBlendKeys[i] when psdBlendModes[i] == mode && psdBlendKeys[i] != ""
		}
		return "norm"
	}

	// The blend key a layer is written with.
	def psdLayerKey(l PSDLayer) string {
		return "pass" when l.group && l.passThrough
		return psdBlendKey(l.blendMode)
	}

	def psdU16(d byte[], p int) int {
		return int(d[p]) << 8 | int(d[p + 1])
	}

	def psdI16(d byte[], p int) int {
		let v = psdU16(d, p)
		return v >= 0x8000 ?? (v - 0x10000, v)
	}

	def psdU32(d byte[], p int) int {
		return int(d[p]) << 24 | int(d[p + 1]) << 16 | int(d[p + 2]) << 8 | int(d[p + 3])
	}

	def psdI32(d byte[], p int) int {
		let v = psdU32(d, p)
		return v >= 0x80000000 ?? (v - 0x100000000, v)
	}

	def psdU64(d byte[], p int) int {
		return psdU32(d, p) << 32 | psdU32(d, p + 4)
	}

	def psdKey(d byte[], p int) string {
		return string(d[p:p + 4])
	}

	// A section length: four bytes, or eight in a large document (PSB).
	def psdLen(d byte[], p int, big bool) int {
		return big ?? (psdU64(d, p), psdU32(d, p))
	}

	// Additional-information keys whose length is eight bytes in a PSB.
	def psdLongKey(key string) bool {
		return key == "LMsk" || key == "Lr16" || key == "Lr32" || key == "Layr" || key == "Mt16" || key == "Mt32" || key == "Mtrn" || key == "Alph" || key == "FMsk" || key == "lnk2" || key == "FEid" || key == "FXid" || key == "PxSD"
	}

	// UTF-16BE code units to a string.
	def psdUTF16(d byte[], p int, units int) string {
		let out byte[]
		let i = 0
		for i < units {
			let cp = psdU16(d, p + i * 2)
			i++
			if cp >= 0xD800 && cp < 0xDC00 && i < units {
				let lo = psdU16(d, p + i * 2)
				if lo >= 0xDC00 && lo < 0xE000 {
					cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
					i++
				}
			}
			continue when cp == 0
			if cp < 0x80 {
				out.push(byte(cp))
			} else if cp < 0x800 {
				out.push(byte(0xC0 | (cp >> 6)))
				out.push(byte(0x80 | (cp & 0x3F)))
			} else if cp < 0x10000 {
				out.push(byte(0xE0 | (cp >> 12)))
				out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
				out.push(byte(0x80 | (cp & 0x3F)))
			} else {
				out.push(byte(0xF0 | (cp >> 18)))
				out.push(byte(0x80 | ((cp >> 12) & 0x3F)))
				out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
				out.push(byte(0x80 | (cp & 0x3F)))
			}
		}
		return string(out)
	}

	// A string's UTF-8 bytes as UTF-16 code units.
	def psdToUTF16(s string) int[] {
		let b = s.bytes()
		let out int[]
		let i = 0
		for i < b.len() {
			let c = int(b[i])
			let cp = c
			let extra = 0
			if c >= 0xF0 {
				cp = c & 0x07
				extra = 3
			} else if c >= 0xE0 {
				cp = c & 0x0F
				extra = 2
			} else if c >= 0xC0 {
				cp = c & 0x1F
				extra = 1
			}
			i++
			for let k = 0; k < extra && i < b.len(); k++ {
				cp = (cp << 6) | (int(b[i]) & 0x3F)
				i++
			}
			if cp >= 0x10000 {
				cp -= 0x10000
				out.push(0xD800 + (cp >> 10))
				out.push(0xDC00 + (cp & 0x3FF))
			} else {
				out.push(cp)
			}
		}
		return out
	}

	// Expands one PackBits-compressed row into `row`. Fails when the row runs
	// past its bytes or overflows.
	def psdUnpackBits(d byte[], p int, end int, row byte[], n int) !none {
		let o = 0
		let q = p
		for o < n {
			fail "psd: RLE row is truncated" when q >= end
			let h = int(d[q])
			q++
			if h < 128 {
				let count = h + 1
				fail "psd: RLE row overflows" when o + count > n || q + count > end
				for let i = 0; i < count; i++ {
					row[o + i] = d[q + i]
				}
				o += count
				q += count
			} else if h > 128 {
				let count = 257 - h
				fail "psd: RLE row overflows" when o + count > n || q >= end
				let v = d[q]
				q++
				for let i = 0; i < count; i++ {
					row[o + i] = v
				}
				o += count
			}
		}
	}

	// PackBits-compresses `n` bytes of `src` from `p`, appending to `out`.
	def psdPackBits(src byte[], p int, n int, out byte[]) byte[] {
		let res = out
		let i = 0
		for i < n {
			// A run of three or more equal bytes is worth a repeat packet.
			let run = 1
			for i + run < n && run < 128 && src[p + i + run] == src[p + i] {
				run++
			}
			if run >= 3 {
				res.push(byte(257 - run))
				res.push(src[p + i])
				i += run
				continue
			}
			let start = i
			let lit = 0
			for i < n && lit < 128 {
				if i + 2 < n && src[p + i] == src[p + i + 1] && src[p + i] == src[p + i + 2] {
					break
				}
				i++
				lit++
			}
			res.push(byte(lit - 1))
			for let k = 0; k < lit; k++ {
				res.push(src[p + start + k])
			}
		}
		return res
	}

	// Writes one row of samples at the document depth into `dst`, eight bits
	// per sample, `step` bytes apart.
	def psdEmitRow(src byte[], p int, width int, depth int, dst byte[], at int, step int) {
		let o = at
		if depth == 8 {
			for let x = 0; x < width; x++ {
				dst[o] = src[p + x]
				o += step
			}
		} else if depth == 16 {
			for let x = 0; x < width; x++ {
				let v = int(src[p + x * 2]) << 8 | int(src[p + x * 2 + 1])
				dst[o] = byte((v + 128) / 257)
				o += step
			}
		} else {
			// Bitmap: a set bit is black.
			for let x = 0; x < width; x++ {
				let bit = (int(src[p + x / 8]) >> (7 - x % 8)) & 1
				dst[o] = byte(bit == 1 ?? (0, 255))
				o += step
			}
		}
	}

	// Bytes in one row of a channel.
	def psdRowBytes(width int, depth int) int {
		return depth == 1 ?? ((width + 7) / 8, width * depth / 8)
	}

	// Decodes one layer channel (compression field first) into a plane.
	def psdDecodeChannel(d byte[], pos int, end int, w int, h int, depth int, big bool) !byte[] {
		let plane byte[]
		plane.len(w * h)
		return plane when w <= 0 || h <= 0
		fail "psd: truncated channel" when pos + 2 > end || end > d.len()
		let comp = psdU16(d, pos)
		let p = pos + 2
		let rb = psdRowBytes(w, depth)
		if comp == 0 {
			fail "psd: truncated channel" when p + rb * h > end
			for let y = 0; y < h; y++ {
				psdEmitRow(d, p + y * rb, w, depth, plane, y * w, 1)
			}
		} else if comp == 1 {
			let cw = big ?? (4, 2)
			let q = p + h * cw
			fail "psd: truncated channel" when q > end
			let row byte[]
			row.len(rb)
			for let y = 0; y < h; y++ {
				let n = big ?? (psdU32(d, p + y * 4), psdU16(d, p + y * 2))
				try psdUnpackBits(d, q, q + n, row, rb)
				psdEmitRow(row, 0, w, depth, plane, y * w, 1)
				q += n
			}
		} else if comp == 2 || comp == 3 {
			let raw = try zlib.decompress(d[p:end], rb * h)
			fail "psd: compressed channel is short" when raw.len() < rb * h
			psdUnpredict(raw, w, h, depth) when comp == 3
			for let y = 0; y < h; y++ {
				psdEmitRow(raw, y * rb, w, depth, plane, y * w, 1)
			}
		} else {
			fail "psd: unknown channel compression {comp}"
		}
		return plane
	}

	// Undoes the per-row delta coding of compression 3.
	def psdUnpredict(raw byte[], w int, h int, depth int) {
		if depth == 8 {
			for let y = 0; y < h; y++ {
				let o = y * w
				for let x = 1; x < w; x++ {
					raw[o + x] = byte((int(raw[o + x]) + int(raw[o + x - 1])) & 0xFF)
				}
			}
		} else if depth == 16 {
			for let y = 0; y < h; y++ {
				let o = y * w * 2
				for let x = 1; x < w; x++ {
					let a = o + x * 2
					let v = ((int(raw[a]) << 8 | int(raw[a + 1])) + (int(raw[a - 2]) << 8 | int(raw[a - 1]))) & 0xFFFF
					raw[a] = byte(v >> 8)
					raw[a + 1] = byte(v & 0xFF)
				}
			}
		}
	}

	// A layer record as read, before its channels are.
	type psdLayerRecord {
		top         int
		left        int
		bottom      int
		right       int
		channelIds  int[]
		channelLens int[]
		blendKey    string
		opacity     int
		clipping    bool
		flags       int
		name        string
		section     int
		maskTop     int
		maskLeft    int
		maskBottom  int
		maskRight   int
		maskDefault int
		maskFlags   int

		def new() {
			channelIds = []
			channelLens = []
			blendKey = "norm"
			name = ""
			section = 0
			maskTop = 0
			maskLeft = 0
			maskBottom = 0
			maskRight = 0
			maskDefault = 255
			maskFlags = 0
		}
	}

	// Colour channels the mode carries.
	def psdColorChannels(mode int) int {
		return 3 when mode == psdModeRGB
		return 4 when mode == psdModeCMYK
		return 1
	}

	def psdHasAlpha(img Image) bool {
		let px = img.raw()
		let w = int(img.size().width)
		let h = int(img.size().height)
		let stride = img.stride()
		for let y = 0; y < h; y++ {
			let o = y * stride + 3
			for let x = 0; x < w; x++ {
				return true when px[o] != byte(255)
				o += 4
			}
		}
		return false
	}

	// Planes (colour channels back to back, `n` samples each) and an optional
	// alpha plane to RGBA.
	def psdToRGBA(img Image, planes byte[], n int, alpha byte[], mode int, palette byte[], transIndex int) {
		let px = img.raw()
		let w = int(img.size().width)
		let h = int(img.size().height)
		let stride = img.stride()
		let hasAlpha = alpha.len() >= n && n > 0
		for let y = 0; y < h; y++ {
			let o = y * stride
			let s = y * w
			for let x = 0; x < w; x++ {
				let a = hasAlpha ?? (alpha[s], byte(255))
				if mode == psdModeRGB {
					px[o] = planes[s]
					px[o + 1] = planes[n + s]
					px[o + 2] = planes[2 * n + s]
				} else if mode == psdModeCMYK {
					// Samples are stored inverted: 255 is no ink.
					let k = int(planes[3 * n + s])
					px[o] = byte((int(planes[s]) * k + 127) / 255)
					px[o + 1] = byte((int(planes[n + s]) * k + 127) / 255)
					px[o + 2] = byte((int(planes[2 * n + s]) * k + 127) / 255)
				} else if mode == psdModeIndexed {
					let i = int(planes[s])
					px[o] = palette[i]
					px[o + 1] = palette[256 + i]
					px[o + 2] = palette[512 + i]
					a = byte(0) when i == transIndex
				} else {
					let v = planes[s]
					px[o] = v
					px[o + 1] = v
					px[o + 2] = v
				}
				px[o + 3] = a
				o += 4
				s++
			}
		}
	}

	// A merged image with transparency is stored blended over white; this
	// takes the white back out of the partly transparent pixels.
	def psdUnmatte(img Image) {
		let px = img.raw()
		let w = int(img.size().width)
		let h = int(img.size().height)
		let stride = img.stride()
		for let y = 0; y < h; y++ {
			let o = y * stride
			for let x = 0; x < w; x++ {
				let a = int(px[o + 3])
				if a > 0 && a < 255 {
					let fa = float64(a)
					let white = float64(255 - a)
					for let c = 0; c < 3; c++ {
						let v = int((float64(px[o + c]) - white) * float64(255) / fa + float64(0.5))
						px[o + c] = byte(v < 0 ?? (0, v > 255 ?? (255, v)))
					}
				}
				o += 4
			}
		}
	}

	// Blends partly transparent pixels over white, the way a merged image
	// with transparency is stored.
	def psdMatte(v int, a int) int {
		return (v * a + 255 * (255 - a) + 127) / 255
	}

	// Scales a layer's alpha by its mask; outside the mask's rectangle the
	// mask's default colour applies.
	def psdApplyMask(img Image, rec psdLayerRecord, mask byte[]) {
		let px = img.raw()
		let w = int(img.size().width)
		let h = int(img.size().height)
		let stride = img.stride()
		let mw = rec.maskRight - rec.maskLeft
		for let y = 0; y < h; y++ {
			let cy = rec.top + y
			let o = y * stride + 3
			for let x = 0; x < w; x++ {
				let cx = rec.left + x
				let m = rec.maskDefault
				m = int(mask[(cy - rec.maskTop) * mw + (cx - rec.maskLeft)]) when cy >= rec.maskTop && cy < rec.maskBottom && cx >= rec.maskLeft && cx < rec.maskRight
				px[o] = byte(int(px[o]) * m / 255) when m != 255
				o += 4
			}
		}
	}

	// Appends one layer record, and its four channels (alpha, red, green,
	// blue) RLE-compressed, to the two buffers.
	def psdWriteLayer(records bytes.Buffer, data bytes.Buffer, name string, image ?Image, x int, y int, opacity int, visible bool, clipped bool, key string, section int) !none {
		let w = 0
		let h = 0
		if image is Image {
			w = int(image.size().width)
			h = int(image.size().height)
		}
		try records.write<int32>(int32(y))
		try records.write<int32>(int32(x))
		try records.write<int32>(int32(y + h))
		try records.write<int32>(int32(x + w))
		try records.write<uint16>(uint16(4))

		// Channel data first, since the records carry its lengths.
		let ids = int[-1, 0, 1, 2]
		let offs = int[3, 0, 1, 2]
		let row byte[]
		row.len(w)
		for let c = 0; c < 4; c++ {
			let counts = new bytes.Buffer()
			let rows byte[]
			if image is Image {
				let px = image.raw()
				let stride = image.stride()
				for let yy = 0; yy < h; yy++ {
					let o = yy * stride + offs[c]
					for let xx = 0; xx < w; xx++ {
						row[xx] = px[o]
						o += 4
					}
					let before = rows.len()
					rows = psdPackBits(row, 0, w, rows)
					try counts.write<uint16>(uint16(rows.len() - before))
				}
			}
			let blank = w == 0 || h == 0
			try records.write<int16>(int16(ids[c]))
			try records.write<uint32>(uint32(blank ?? (2, 2 + counts.len() + rows.len())))
			try data.write<uint16>(uint16(blank ?? (0, 1)))
			if !blank {
				try data.write(counts.bytes())
				try data.write(rows)
			}
		}

		try records.write(byte[56, 66, 73, 77])
		try records.writeString(key)
		let op = opacity
		op = 0 when op < 0
		op = 255 when op > 255
		try records.write(byte[byte(op), clipped ?? (1, 0), visible ?? (0, 2), 0])

		// Extra data: no mask, no blending ranges, the name, then the Unicode
		// name and the section block.
		let extra = new bytes.Buffer()
		try extra.write<uint32>(uint32(0))
		try extra.write<uint32>(uint32(0))
		let nb = name.bytes()
		let pascal byte[]
		for let b in nb {
			break when pascal.len() >= 255
			pascal.push(int(b) < 128 ?? (b, byte(63)))
		}
		try extra.write(byte[byte(pascal.len())])
		try extra.write(pascal)
		let padded = ((1 + pascal.len() + 3) / 4) * 4
		for let i = 1 + pascal.len(); i < padded; i++ {
			try extra.write(byte[0])
		}

		let units = psdToUTF16(name)
		let uniLen = 4 + units.len() * 2
		uniLen += 2 when uniLen % 4 != 0
		try extra.write(byte[56, 66, 73, 77, 108, 117, 110, 105])
		try extra.write<uint32>(uint32(uniLen))
		try extra.write<uint32>(uint32(units.len()))
		for let u in units {
			try extra.write<uint16>(uint16(u))
		}
		try extra.write(byte[0, 0]) when (4 + units.len() * 2) % 4 != 0

		if section != 0 {
			try extra.write(byte[56, 66, 73, 77, 108, 115, 99, 116])
			if section == psdSectionDivider {
				try extra.write<uint32>(uint32(4))
				try extra.write<uint32>(uint32(section))
			} else {
				try extra.write<uint32>(uint32(12))
				try extra.write<uint32>(uint32(section))
				try extra.write(byte[56, 66, 73, 77])
				try extra.writeString(key)
			}
		}
		try records.write<uint32>(uint32(extra.len()))
		try records.write(extra.bytes())
	}
}
