partial module std.formats.image {
	use (
		std.io
		std.bytes
	)

	// PSD is the Photoshop document (PSD) codec. Decoding and encoding are not implemented yet;
	// matchSignature reports that nothing matches.
	@codec("Photoshop PSD")
	type PSD {
		mimeType string[] {
			def get() string[] {
				return string["image/psd", "image/vnd.adobe.photoshop", "image/x-psd", "image/photoshop", "image/x-photoshop"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".psd"]
			}
		}

		// matchSignature reports whether the reader starts with a Photoshop document (PSD) signature.
		// Not implemented yet: always false.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// info reads the image's dimensions and format from the bytes. Fails, as
		// decoding is not implemented yet.
		def info(data byte[]) !ImageInfo {
			return info(new bytes.Buffer(data))
		}

		// info reads the image's dimensions and format from the reader. Fails, as
		// decoding is not implemented yet.
		def info(reader io.Reader) !ImageInfo {
			fail "not implemented"
		}

		// decode reads a Photoshop document (PSD) image from the bytes. Fails, as decoding is not
		// implemented yet.
		def decode(data byte[]) !Image {
			return decode(new bytes.Buffer(data))
		}

		// decode reads a Photoshop document (PSD) image from the reader. Fails, as decoding is not
		// implemented yet.
		def decode(reader io.Reader) !Image {
			fail "not implemented"
		}

		// encode renders the image as Photoshop document (PSD). Not implemented yet: returns no bytes.
		def encode() byte[] {}

		// encode writes the image as Photoshop document (PSD) to the writer. Not implemented yet; it
		// cannot fail.
		def encode(writer io.Writer) !none {}
	}
}
