partial module std.formats.image {
	use (
		std.testing
		std.bytes
		std.gfx.color
	)

	check "PSD" {
		internal def assertPixel(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			assert int(img.raw()[o]) == r
			assert int(img.raw()[o + 1]) == g
			assert int(img.raw()[o + 2]) == b
			assert int(img.raw()[o + 3]) == a
		}

		internal def u16(buf bytes.Buffer, v int) {
			buf.write<uint16>(uint16(v)) onerror recover none
		}

		internal def u32(buf bytes.Buffer, v int) {
			buf.write<uint32>(uint32(v)) onerror recover none
		}

		internal def raw(buf bytes.Buffer, b byte[]) {
			buf.write(b) onerror recover 0
		}

		// A document from its parts: header fields, colour mode data,
		// resources, the layer section body and the image data section.
		internal def document(version int, channels int, w int, h int, depth int, mode int, colorData byte[], resources byte[], layerSection byte[], image byte[]) byte[] {
			let buf = new bytes.Buffer()
			raw(buf, byte[56, 66, 80, 83])
			u16(buf, version)
			raw(buf, byte[0, 0, 0, 0, 0, 0])
			u16(buf, channels)
			u32(buf, h)
			u32(buf, w)
			u16(buf, depth)
			u16(buf, mode)
			u32(buf, colorData.len())
			raw(buf, colorData)
			u32(buf, resources.len())
			raw(buf, resources)
			u32(buf, 0) when version == 2
			u32(buf, layerSection.len())
			raw(buf, layerSection)
			raw(buf, image)
			return buf.bytes()
		}

		// Uncompressed image data: compression 0, then the planes.
		internal def rawImage(planes byte[]) byte[] {
			let buf = new bytes.Buffer()
			u16(buf, 0)
			raw(buf, planes)
			return buf.bytes()
		}

		internal def opaque(w int, h int, r int, g int, b int) Image {
			let img = new Image(w, h)
			let px = img.raw()
			for let i = 0; i < w * h; i++ {
				px[i * 4] = byte(r)
				px[i * 4 + 1] = byte(g)
				px[i * 4 + 2] = byte(b)
				px[i * 4 + 3] = byte(255)
			}
			return img
		}

		@test()
		def TestMatchAndInfo() {
			let codec = new PSD()
			let doc = document(1, 1, 3, 2, 8, 1, byte[], byte[], byte[], rawImage(byte[1, 2, 3, 4, 5, 6]))
			assert codec.matchSignature(new bytes.Buffer(doc))
			assert !codec.matchSignature(new bytes.Buffer(byte[56, 66, 80, 83, 0, 3]))
			let got = codec.info(doc) onerror recover ImageInfo{}
			assert int(got.size.width) == 3
			assert int(got.size.height) == 2
			assert got.colorFormat == color.ColorFormat.Gray
		}

		@test()
		def TestDecodesGrayscaleRaw() {
			let doc = document(1, 1, 3, 2, 8, 1, byte[], byte[], byte[], rawImage(byte[0, 100, 255, 7, 8, 9]))
			let img = new PSD().decode(doc) onerror recover new Image(1, 1)
			assert int(img.size().width) == 3
			assertPixel(img, 1, 0, 100, 100, 100, 255)
			assertPixel(img, 2, 1, 9, 9, 9, 255)
		}

		@test()
		def TestDecodesSixteenBitRGBWithRLE() {
			// Two pixels per row, one row: each channel's row is a literal packet.
			let img16 = new bytes.Buffer()
			u16(img16, 1)
			u16(img16, 5)
			u16(img16, 5)
			u16(img16, 5)
			raw(img16, byte[3, 0xFF, 0xFF, 0x00, 0x00])
			raw(img16, byte[3, 0x80, 0x00, 0x12, 0x34])
			raw(img16, byte[3, 0x00, 0x00, 0xFF, 0xFF])
			let doc = document(1, 3, 2, 1, 16, 3, byte[], byte[], byte[], img16.bytes())
			let img = new PSD().decode(doc) onerror recover new Image(1, 1)
			assert int(img.size().width) == 2
			assertPixel(img, 0, 0, 255, 128, 0, 255)
			assertPixel(img, 1, 0, 0, 18, 255, 255)
		}

		@test()
		def TestDecodesCMYK() {
			// Stored inverted: 255 is no ink, so this is white, then pure cyan.
			let doc = document(1, 4, 2, 1, 8, 4, byte[], byte[], byte[], rawImage(byte[255, 0, 255, 255, 255, 255, 255, 255]))
			let img = new PSD().decode(doc) onerror recover new Image(1, 1)
			assertPixel(img, 0, 0, 255, 255, 255, 255)
			assertPixel(img, 1, 0, 0, 255, 255, 255)
		}

		@test()
		def TestDecodesIndexedWithTransparentIndex() {
			let pal byte[]
			pal.len(768)
			pal[1] = byte(200)
			pal[256 + 1] = byte(100)
			pal[512 + 1] = byte(50)
			// Resource 1047 marks index 2 transparent.
			let res = byte[56, 66, 73, 77, 0x04, 0x17, 0, 0, 0, 0, 0, 2, 0, 2]
			let doc = document(1, 1, 2, 1, 8, 2, pal, res, byte[], rawImage(byte[1, 2]))
			let img = new PSD().decode(doc) onerror recover new Image(1, 1)
			assertPixel(img, 0, 0, 200, 100, 50, 255)
			assert int(img.raw()[7]) == 0
		}

		@test()
		def TestDecodesBitmap() {
			// Nine pixels in two bytes; a set bit is black.
			let doc = document(1, 1, 9, 1, 1, 0, byte[], byte[], byte[], rawImage(byte[0b10100000, 0b10000000]))
			let img = new PSD().decode(doc) onerror recover new Image(1, 1)
			assert int(img.size().width) == 9
			assertPixel(img, 0, 0, 0, 0, 0, 255)
			assertPixel(img, 1, 0, 255, 255, 255, 255)
			assertPixel(img, 2, 0, 0, 0, 0, 255)
			assertPixel(img, 8, 0, 0, 0, 0, 255)
		}

		@test()
		def TestDecodesLargeDocument() {
			let doc = document(2, 1, 2, 1, 8, 1, byte[], byte[], byte[], rawImage(byte[10, 20]))
			let img = new PSD().decode(doc) onerror recover new Image(1, 1)
			assertPixel(img, 1, 0, 20, 20, 20, 255)
		}

		@test()
		def TestReadsResolutionAndProfile() {
			let res = new bytes.Buffer()
			raw(res, byte[56, 66, 73, 77, 0x03, 0xED, 0, 0, 0, 0, 0, 16])
			u32(res, 300 * 65536)
			raw(res, byte[0, 1, 0, 1])
			u32(res, 150 * 65536)
			raw(res, byte[0, 1, 0, 1])
			raw(res, byte[56, 66, 73, 77, 0x04, 0x0F, 0, 0, 0, 0, 0, 3, 7, 8, 9, 0])
			let psd = new PSD()
			psd.decode(document(1, 1, 1, 1, 8, 1, byte[], res.bytes(), byte[], rawImage(byte[5]))) onerror recover new Image(1, 1)
			assert psd.horizontalDpi == 300.0
			assert psd.verticalDpi == 150.0
			assert psd.iccProfile.len() == 3
			assert int(psd.iccProfile[2]) == 9
		}

		@test()
		def TestAppliesLayerMask() {
			// One 2x1 gray layer with alpha and a user mask covering its left
			// pixel only; outside the mask the default colour (0) hides it.
			let rec = new bytes.Buffer()
			u16(rec, 1)
			u32(rec, 0)
			u32(rec, 0)
			u32(rec, 1)
			u32(rec, 2)
			u16(rec, 3)
			for let id in int[0, -1, -2] {
				rec.write<int16>(int16(id)) onerror recover none
				u32(rec, id == -2 ?? (3, 4))
			}
			raw(rec, byte[56, 66, 73, 77, 110, 111, 114, 109, 255, 0, 0, 0])
			u32(rec, 4 + 20 + 4 + 4)
			u32(rec, 20)
			u32(rec, 0)
			u32(rec, 0)
			u32(rec, 1)
			u32(rec, 1)
			raw(rec, byte[0, 0, 0, 0])
			u32(rec, 0)
			raw(rec, byte[1, 77, 0, 0])
			raw(rec, byte[0, 0, 90, 91])
			raw(rec, byte[0, 0, 255, 255])
			raw(rec, byte[0, 0, 128])
			rec.write(byte[0]) onerror recover 0
			let info = rec.bytes()
			let section = new bytes.Buffer()
			u32(section, info.len())
			raw(section, info)
			u32(section, 0)

			let psd = new PSD()
			let doc = document(1, 1, 2, 1, 8, 1, byte[], byte[], section.bytes(), rawImage(byte[1, 2]))
			psd.decode(doc) onerror recover new Image(1, 1)
			assert psd.layers.len() == 1
			let layer = psd.layers[0]
			assert layer.name == "M"
			assertPixel(layer.image, 0, 0, 90, 90, 90, 128)
			assertPixel(layer.image, 1, 0, 91, 91, 91, 0)
		}

		@test()
		def TestEncodesOneLayerAndRoundTrips() {
			let img = opaque(5, 3, 10, 20, 30)
			img.setPixel(4, 2, new color.Color(color.RGBA{r: 200, g: 100, b: 50, a: 0})) onerror recover none
			img.setPixel(3, 2, new color.Color(color.RGBA{r: 200, g: 100, b: 50, a: 128})) onerror recover none
			let codec = new PSD()
			let data = codec.encode(img) onerror recover byte[]
			assert codec.matchSignature(new bytes.Buffer(data))

			let back = new PSD()
			let merged = back.decode(data) onerror recover new Image(1, 1)
			assert int(merged.size().width) == 5
			assertPixel(merged, 0, 0, 10, 20, 30, 255)
			// The merged image stores partly transparent pixels blended over
			// white, which costs a step of precision.
			let o = merged.pixelOffset(3, 2)
			assert (int(merged.raw()[o]) - 200).abs() <= 1
			assert (int(merged.raw()[o + 2]) - 50).abs() <= 1
			assert int(merged.raw()[o + 3]) == 128
			assert int(merged.raw()[merged.pixelOffset(4, 2) + 3]) == 0
			assert back.layers.len() == 1
			assertPixel(back.layers[0].image, 3, 2, 200, 100, 50, 128)
		}

		@test()
		def TestEncodesLayersAndGroups() {
			let psd = new PSD()
			psd.width = 8
			psd.height = 6
			psd.add(opaque(8, 6, 255, 255, 255), "Background")
			let red = psd.add(opaque(2, 2, 255, 0, 0), "Red ✓", 1, 1)
			red.depth = 1
			red.opacity = 128
			red.blendMode = color.BlendMode.Multiply
			let blue = psd.add(opaque(2, 2, 0, 0, 255), "Blue", 5, 3)
			blue.depth = 1
			blue.visible = false
			let folder = psd.add(new Image(0, 0), "Folder")
			folder.group = true
			folder.passThrough = true
			psd.add(opaque(1, 1, 0, 255, 0), "Top", 7, 0)

			let data = psd.encode() onerror (e error) {
				println(e.message)
				recover byte[]
			}
			let back = new PSD()
			let merged = back.decode(data) onerror recover new Image(1, 1)
			assert back.width == 8 && back.height == 6
			assert back.layers.len() == 5
			assert back.layers[1].name == "Red ✓"
			assert back.layers[1].depth == 1
			assert back.layers[1].opacity == 128
			assert back.layers[1].blendMode == color.BlendMode.Multiply
			assert int(back.layers[1].bounds.position.x) == 1
			assert !back.layers[2].visible
			assert back.layers[3].group && back.layers[3].passThrough && back.layers[3].depth == 0
			assert back.layers[4].depth == 0
			assert int(back.layers[4].bounds.position.x) == 7

			let found = back.layer("Blue")
			assert found is PSDLayer
			assert back.layer("Missing") is none

			// Red at half opacity multiplied over white, green on top, hidden
			// blue absent.
			assertPixel(merged, 1, 1, 255, 127, 127, 255)
			assertPixel(merged, 7, 0, 0, 255, 0, 255)
			assertPixel(merged, 5, 3, 255, 255, 255, 255)
		}

		@test()
		def TestFlattenHidesMembersOfHiddenGroups() {
			let psd = new PSD()
			let inner = psd.add(opaque(2, 2, 255, 0, 0), "Inner")
			inner.depth = 1
			let folder = psd.add(new Image(0, 0), "Folder")
			folder.group = true
			folder.visible = false
			let flat = psd.flatten()
			assert int(flat.size().width) == 2
			assert int(flat.raw()[3]) == 0
			folder.visible = true
			assertPixel(psd.flatten(), 0, 0, 255, 0, 0, 255)
		}

		@test()
		def TestRejectsUnclosedGroups() {
			let psd = new PSD()
			let deep = psd.add(opaque(1, 1, 1, 2, 3), "Deep")
			deep.depth = 2
			let failed = false
			psd.encode() onerror (e error) {
				failed = true
				recover byte[]
			}
			assert failed
		}

		@test()
		def TestRejectsCorruptData() {
			let codec = new PSD()
			let notPsd = codec.decode(byte[1, 2, 3, 4, 5, 6, 7, 8]) onerror recover new Image(7, 7)
			assert int(notPsd.size().width) == 7

			let good = document(1, 1, 3, 2, 8, 1, byte[], byte[], byte[], rawImage(byte[1, 2, 3, 4, 5, 6]))
			let truncated = codec.decode(good[0:good.len() - 3]) onerror recover new Image(7, 7)
			assert int(truncated.size().width) == 7

			let lab = document(1, 3, 1, 1, 8, 9, byte[], byte[], byte[], rawImage(byte[1, 2, 3]))
			let labImg = codec.decode(lab) onerror recover new Image(7, 7)
			assert int(labImg.size().width) == 7

			// An RLE row that claims more bytes than the row holds.
			let rle = new bytes.Buffer()
			u16(rle, 1)
			u16(rle, 3)
			raw(rle, byte[0xFE, 9, 9])
			let over = codec.decode(document(1, 1, 2, 1, 8, 1, byte[], byte[], byte[], rle.bytes())) onerror recover new Image(7, 7)
			assert int(over.size().width) == 7

			let nothing = codec.encode(new Image(0, 0)) onerror recover byte[1]
			assert nothing.len() == 1
		}
	}
}
