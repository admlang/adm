partial module std.formats.image {
	use (
		std.io
		std.os
		std.bytes
		std.math.geom::Path
		std.mem
		std.math.geom
		std.gfx.color
		std.gfx.canvas::(Canvas, Painter, Picture, record)
		std.formats.image.svgwriter::*
		std.formats.image.svgrender
	)

	// SVG is the SVG codec: static SVG 1.1 and the SVG 2 features browsers
	// draw, rendered through the canvas. Encoding takes a Picture (see
	// `encode(picture)`); images have no SVG form.
	@codec("Scalable Vector Graphics")
	type SVG {
		mimeType string[] {
			def get() string[] {
				return string["image/svg+xml"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".svg"]
			}
		}

		// matchSignature reports whether the reader starts an SVG document:
		// an `<svg` element within its first kilobyte, after any XML
		// declaration, comments or document type.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(1024)
			let n = r.read(b) onerror recover 0
			return false when n <= 0
			let head = string(b[:n]).lower()
			let at = head.indexOf("<svg")
			return false when at < 0
			let before = head[:at].trim()
			return before == "" || before.startsWith("<?xml") || before.startsWith("<!--") || before.startsWith("<!doctype") || before.startsWith("\uFEFF")
		}

		// info reads the size the document asks to be drawn at: its width
		// and height, from the view box where they are missing or
		// relative. Fails when the bytes are not an SVG document.
		def info(data byte[]) !ImageInfo {
			let doc = try svgrender.parseDocument(data)
			let (w, h) = svgrender.documentSize(doc)
			return ImageInfo{size: new geom.Size(w, h), colorFormat: color.ColorFormat.RGBA, palette: color.Palette{}}
		}

		// info reads the document's size from the reader, as info(data).
		def info(reader io.Reader) !ImageInfo {
			return info(try io.readAll(reader))
		}

		// decode draws the document at its own size (`info`), rounded up to
		// whole pixels, on a transparent image, as it shows when its
		// animations start. Fails when the bytes are not an SVG document.
		def decode(data byte[]) !Image {
			return try decodeFrom(data, "", 0, 0)
		}

		// decode draws the document at its own size as it shows `at` after
		// its animations start (SMIL `animate`, `set`, `animateTransform`,
		// `animateMotion`). Fails when the bytes are not an SVG document.
		def decode(data byte[], at duration) !Image {
			return try decodeFrom(data, "", 0, 0, "", at)
		}

		// decode reads the SVG file at `path` and draws it at its own size,
		// as decode(data); images it references by relative path are read
		// from the file's folder. Fails when the file cannot be read or is
		// not an SVG document.
		def decode(path string) !Image {
			let data = try os.readFile(path)
			return try decodeFrom(data, os.dir(path), 0, 0, os.base(path))
		}

		// decode reads the SVG file at `path` and draws it at its own size
		// as it shows `at` after its animations start. Fails when the file
		// cannot be read or is not an SVG document.
		def decode(path string, at duration) !Image {
			let data = try os.readFile(path)
			return try decodeFrom(data, os.dir(path), 0, 0, os.base(path), at)
		}

		// decode reads the SVG file at `path` and draws it scaled to `width`
		// by `height` pixels (0: in proportion) as it shows `at` after its
		// animations start, images it references by relative path read from
		// the file's folder. Fails when the file cannot be read, is not an
		// SVG document, or the size is not positive.
		def decode(path string, width int, height int = 0, at duration = 0s) !Image {
			fail "svg: width must be positive" when width <= 0
			let data = try os.readFile(path)
			return try decodeFrom(data, os.dir(path), width, height, os.base(path), at)
		}

		// decode draws the document scaled to `width` by `height` pixels
		// as it shows `at` after its animations start; a height of 0 keeps
		// the document's proportions. Fails when the bytes are not an SVG
		// document or the size is not positive.
		def decode(data byte[], width int, height int = 0, at duration = 0s) !Image {
			fail "svg: width must be positive" when width <= 0
			return try decodeFrom(data, "", width, height, "", at)
		}

		// Draws the document at `width` by `height` (0, 0: its own size;
		// height 0: in proportion) at time `at`, relative hrefs read from
		// `baseDir`.
		internal def decodeFrom(data byte[], baseDir string, width int, height int, name string = "", at duration = 0s) !Image {
			let doc = try svgrender.parseDocument(data)
			// The size comes from the document as written: an animated view
			// box moves inside a viewport that stays put.
			let (w, h) = svgrender.documentSize(doc)
			svgrender.animate(doc, at.seconds())
			let pw = width > 0 ?? (width, int(w.ceil()).max(1))
			let ph = height > 0 ?? (height, width > 0 ?? (int((h * float(width) / w).round()).max(1), int(h.ceil()).max(1)))
			let cv = new Canvas(pw, ph)
			cv.scale(float(pw) / w, float(ph) / h) when width > 0
			let r = new svgrender.Renderer(doc, pw, ph)
			r.time = at.seconds()
			r.baseDir = baseDir
			// The file itself, so an image of it is seen as a cycle.
			r.outer.push(baseDir + "|" + name) when name != ""
			r.draw(cv, w, h)
			let img = new Image(pw, ph)
			mem.copy(img.raw(), cv.pixels)
			return img
		}

		// decode reads an SVG document from the reader and draws it, as
		// decode(data).
		def decode(reader io.Reader) !Image {
			return decode(try io.readAll(reader))
		}

		// The document as a Picture: its drawing recorded at its own size
		// (`info`) as it shows `at` after its animations start, for
		// replaying scaled or onto any Painter. Masks, filters and clip
		// paths that need pixels are rendered at that size. Fails when the
		// bytes are not an SVG document.
		def picture(data byte[], at duration = 0s) !Picture {
			let doc = try svgrender.parseDocument(data)
			let (w, h) = svgrender.documentSize(doc)
			svgrender.animate(doc, at.seconds())
			let pw = int(w.ceil()).max(1)
			let ph = int(h.ceil()).max(1)
			return record(def (p Painter) {
				let r = new svgrender.Renderer(doc, pw, ph)
				r.time = at.seconds()
				r.draw(p, w, h)
			})
		}

		// encode renders the image as SVG. Fails, as encoding is not
		// implemented yet.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as SVG to the writer. Fails, as encoding
		// is not implemented yet.
		def encode(img Image, writer io.Writer) !none {
			fail "not implemented"
		}

		// encode writes the picture as an SVG document spanning (0, 0) to
		// the picture's bounds: shapes, text (as glyph paths), gradients,
		// patterns, images, clips, groups and the effects SVG filters can
		// express as SVG elements. What SVG cannot say (Porter-Duff operators
		// other than SourceOver, the blend modes CSS lacks, conic gradients,
		// outlines, spreads, backdrop blur) becomes a PNG of just the pixels
		// it changes, drawn by the canvas; what it covers is masked out of the
		// vectors below, so erasing works too.
		def encode(picture Picture) string {
			let b = picture.bounds()
			let w = new SvgWriter(int(b.right.ceil()), int(b.bottom.ceil()))
			picture.replay(w)
			return w.document()
		}

		// The path that SVG path data (the `d` attribute: `M10 10 L20 20 C … Z`,
		// every command of SVG 2 in both cases) describes. Fails on malformed
		// data.
		def parsePath(data string) !Path {
			return try parseSvgPathData(data)
		}

		// The path as SVG path data, absolute commands, numbers to six
		// decimals.
		def pathData(path Path) string {
			return svgPathData(path)
		}
	}
}
