partial module std.formats.image {
	use (
		std.math::Pi
		std.math.geom::(Path, PathVerb)
	)

	// The path SVG path data describes (SVG 2 path grammar: M L H V C S Q T
	// A Z in both cases, implicit repeats, compact numbers and arc flags).
	internal def parseSvgPathData(data string) !Path {
		let p = new Path()
		let r = new SvgPathReader(data)
		let cmd = byte(0)
		// The current point, the subpath's start, and the last control point
		// for S and T reflections with the kind of curve that set it.
		let (
			curX     = 0.0
			curY     = 0.0
			startX   = 0.0
			startY   = 0.0
			lastCX   = 0.0
			lastCY   = 0.0
			lastKind = byte(0)
		)
		for {
			r.skipSpace()
			break when r.done()
			let c = r.peek()
			if isAsciiLetter(c) {
				r.at++
				cmd = c
			} else if cmd == 0 {
				fail "svg path data: expected a command at {r.at}"
			} else if (cmd | 0x20) == byte('z') {
				fail "svg path data: expected a command after Z at {r.at}"
			}
			let rel = (cmd & 0x20) != 0
			let ox = rel ?? (curX, 0.0)
			let oy = rel ?? (curY, 0.0)
			let kind = byte(0)
			let u = cmd & 0xDF
			if u == byte('M') {
				curX = ox + (try r.number())
				curY = oy + (try r.number())
				startX = curX
				startY = curY
				p.moveTo(curX, curY)
				// Pairs after the first are implicit line-tos.
				cmd = rel ?? (byte('l'), byte('L'))
			} else if u == byte('L') {
				curX = ox + (try r.number())
				curY = oy + (try r.number())
				p.lineTo(curX, curY)
			} else if u == byte('H') {
				curX = ox + (try r.number())
				p.lineTo(curX, curY)
			} else if u == byte('V') {
				curY = oy + (try r.number())
				p.lineTo(curX, curY)
			} else if u == byte('C') {
				let x1 = ox + (try r.number())
				let y1 = oy + (try r.number())
				lastCX = ox + (try r.number())
				lastCY = oy + (try r.number())
				curX = ox + (try r.number())
				curY = oy + (try r.number())
				p.cubicTo(x1, y1, lastCX, lastCY, curX, curY)
				kind = byte('C')
			} else if u == byte('S') {
				let x1 = lastKind == byte('C') ?? (2.0 * curX - lastCX, curX)
				let y1 = lastKind == byte('C') ?? (2.0 * curY - lastCY, curY)
				lastCX = ox + (try r.number())
				lastCY = oy + (try r.number())
				curX = ox + (try r.number())
				curY = oy + (try r.number())
				p.cubicTo(x1, y1, lastCX, lastCY, curX, curY)
				kind = byte('C')
			} else if u == byte('Q') {
				lastCX = ox + (try r.number())
				lastCY = oy + (try r.number())
				curX = ox + (try r.number())
				curY = oy + (try r.number())
				p.quadTo(lastCX, lastCY, curX, curY)
				kind = byte('Q')
			} else if u == byte('T') {
				lastCX = lastKind == byte('Q') ?? (2.0 * curX - lastCX, curX)
				lastCY = lastKind == byte('Q') ?? (2.0 * curY - lastCY, curY)
				curX = ox + (try r.number())
				curY = oy + (try r.number())
				p.quadTo(lastCX, lastCY, curX, curY)
				kind = byte('Q')
			} else if u == byte('A') {
				let rx = try r.number()
				let ry = try r.number()
				let rot = try r.number()
				let large = try r.flag()
				let sweep = try r.flag()
				curX = ox + (try r.number())
				curY = oy + (try r.number())
				p.arcTo(rx, ry, rot * Pi / 180.0, large, sweep, curX, curY)
			} else if u == byte('Z') {
				p.close()
				curX = startX
				curY = startY
			} else {
				fail "svg path data: unknown command at {r.at - 1}"
			}
			lastKind = kind
		}
		return p
	}

	// The path as SVG path data, absolute commands.
	internal def svgPathData(path Path) string {
		let parts string[]
		let pts = path.coords
		let j = 0
		for let (_, op) in path.verbs {
			match op {
				case PathVerb.Move:
					parts.push("M{svgNumber(pts[j])} {svgNumber(pts[j + 1])}")
					j += 2
				case PathVerb.Line:
					parts.push("L{svgNumber(pts[j])} {svgNumber(pts[j + 1])}")
					j += 2
				case PathVerb.Quad:
					parts.push("Q{svgNumber(pts[j])} {svgNumber(pts[j + 1])} {svgNumber(pts[j + 2])} {svgNumber(pts[j + 3])}")
					j += 4
				case PathVerb.Cubic:
					parts.push("C{svgNumber(pts[j])} {svgNumber(pts[j + 1])} {svgNumber(pts[j + 2])} {svgNumber(pts[j + 3])} {svgNumber(pts[j + 4])} {svgNumber(pts[j + 5])}")
					j += 6
				case PathVerb.Close:
					parts.push("Z")
			}
		}
		return parts.join(" ")
	}

	// A number as SVG path data writes it: no trailing zeros, at most six
	// decimals.
	internal def svgNumber(v float) string {
		let r = (v * 1000000.0).round() / 1000000.0
		r = 0.0 when r == 0.0
		return "{int(r)}" when r == r.floor() && r.abs() < 1e15
		let text = "{r}"
		return text.trimEnd("0").trimSuffix(".") when text.contains(".") && !text.contains("e")
		return text
	}

	// Whether b is an ASCII letter.
	internal def isAsciiLetter(b byte) bool {
		let l = b | 0x20
		return l >= byte('a') && l <= byte('z')
	}

	// SvgPathReader walks SVG path data: numbers, flags, separators.
	internal type SvgPathReader {
		internal text byte[]
		at            int

		def new(data string) {
			text = data.bytes()
		}

		def done() bool {
			return at >= text.len()
		}

		def peek() byte {
			return text[at]
		}

		// Skips white space and at most one comma.
		def skipSpace() {
			let comma = false
			for at < text.len() {
				let c = text[at]
				if c == byte(',') && !comma {
					comma = true
				} else if !(c == byte(' ') || c == byte('\t') || c == byte('\n') || c == byte('\r') || c == 12) {
					return
				}
				at++
			}
		}

		// Whether the byte at i is an ASCII digit.
		def digitAt(i int) bool {
			return i < text.len() && text[i] >= byte('0') && text[i] <= byte('9')
		}

		// The next number: sign, digits, fraction, exponent (`-1.5e3`, `.5`).
		def number() !float {
			skipSpace()
			let start = at
			if at < text.len() && (text[at] == byte('+') || text[at] == byte('-')) {
				at++
			}
			let digits = 0
			for digitAt(at) {
				at++
				digits++
			}
			if at < text.len() && text[at] == byte('.') {
				at++
				for digitAt(at) {
					at++
					digits++
				}
			}
			fail "svg path data: expected a number at {start}" when digits == 0
			if at < text.len() && (text[at] | 0x20) == byte('e') {
				let mark = at
				at++
				if at < text.len() && (text[at] == byte('+') || text[at] == byte('-')) {
					at++
				}
				let expDigits = 0
				for digitAt(at) {
					at++
					expDigits++
				}
				// An `e` with no digits belongs to the next token.
				at = mark when expDigits == 0
			}
			return parseFloat<float>(string(text[start:at]))
		}

		// An arc flag: one `0` or `1`, which needs no separator after it.
		def flag() !bool {
			skipSpace()
			fail "svg path data: expected an arc flag at {at}" when at >= text.len()
			let c = text[at]
			fail "svg path data: expected an arc flag (0 or 1) at {at}" when c != byte('0') && c != byte('1')
			at++
			return c == byte('1')
		}
	}
}
