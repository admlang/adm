partial module std.formats.image {
	use (
		std.math.geom::(Path, PathVerb)
		std.formats.image.svgwriter::(svgNumber)
		std.formats.image.svgrender
	)

	// The path SVG path data describes (SVG 2 path grammar: M L H V C S Q T
	// A Z in both cases, implicit repeats, compact numbers and arc flags).
	// Fails on malformed data.
	internal def parseSvgPathData(data string) !Path {
		return try svgrender.parsePathData(data, false)
	}

	// The path as SVG path data, absolute commands.
	internal def svgPathData(path Path) string {
		let parts string[]
		let pts = path.coords
		let j = 0
		for let (_, op) in path.verbs {
			match op {
				case PathVerb.Move:
					parts.push("M{svgNumber(pts[j])} {svgNumber(pts[j + 1])}")
					j += 2
				case PathVerb.Line:
					parts.push("L{svgNumber(pts[j])} {svgNumber(pts[j + 1])}")
					j += 2
				case PathVerb.Quad:
					parts.push("Q{svgNumber(pts[j])} {svgNumber(pts[j + 1])} {svgNumber(pts[j + 2])} {svgNumber(pts[j + 3])}")
					j += 4
				case PathVerb.Cubic:
					parts.push("C{svgNumber(pts[j])} {svgNumber(pts[j + 1])} {svgNumber(pts[j + 2])} {svgNumber(pts[j + 3])} {svgNumber(pts[j + 4])} {svgNumber(pts[j + 5])}")
					j += 6
				case PathVerb.Close:
					parts.push("Z")
			}
		}
		return parts.join(" ")
	}
}
