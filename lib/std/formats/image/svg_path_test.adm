partial module std.formats.image {
	use (
		std.math.geom::(Path, Point, Rect)
		std.testing
	)

	check "SVG path data" {
		def round(data string) !string {
			let svg = new SVG()
			return svg.pathData(try svg.parsePath(data))
		}

		@test()
		def parsesEveryCommand() !none {
			assert (try round("M10 10 h 5 v5 H10 z")) == "M10 10 L15 10 L15 15 L10 15 Z"
			// Implicit line-tos after a move, relative after absolute.
			assert (try round("m1 1 2 0 0 2")) == "M1 1 L3 1 L3 3"
			// Relative commands after Z start from the subpath's start.
			assert (try round("M5 5 l5 0 z l0 5")) == "M5 5 L10 5 Z M5 5 L5 10"
			// S reflects the previous cubic's second control point.
			assert (try round("M0 0C0 10 10 10 10 0S20-10 20 0")) == "M0 0 C0 10 10 10 10 0 C10 -10 20 -10 20 0"
			// T reflects the previous quadratic's control point.
			assert (try round("M0 0Q5 5 10 0T20 0")) == "M0 0 Q5 5 10 0 Q15 -5 20 0"
			assert (try round("M.5.5L1e1-2.5E-1")) == "M0.5 0.5 L10 -0.25"
		}

		@test()
		def arcsWithCompactFlags() !none {
			let p = try new SVG().parsePath("M0 0a5 5 0 1010 0")
			let b = p.bounds()
			assert (b.right - 10.0).abs() < 1e-9 && b.left.abs() < 1e-9
			assert (b.bottom - 5.0).abs() < 1e-3 || (b.top + 5.0).abs() < 1e-3
			// The arc ends exactly where the data says.
			let c = p.coords
			assert c[c.len() - 2] == 10.0 && c[c.len() - 1] == 0.0
		}

		@test()
		def malformedDataFails() {
			let svg = new SVG()
			for let (_, bad) in string["10 10", "M10", "M0 0 A1 1 0 2 0 3 3", "M0 0 Z 5 5", "M0 0 X1 1"] {
				let failed = false
				svg.parsePath(bad) onerror (err error) {
					failed = true
					recover new Path()
				}
				assert failed
			}
		}

		@test()
		def writesWhatTheBuildersMade() {
			let p = new Path().rect(Rect{left: 0.0, top: 0.0, right: 2.5, bottom: 1.0}).circle(new Point(0.0, 0.0), 1.0)
			let text = new SVG().pathData(p)
			assert text.startsWith("M0 0 L2.5 0 L2.5 1 L0 1 Z M1 0 C")
			assert text.endsWith("Z")
		}
	}
}
