// SVG path data kept as it is written, for a tool that moves a point and
// writes the text back with only the numbers that changed.

partial module std.formats.image {
	use (
		std.data.encoding::XMLSpan
		std.math::(Pi, Tau, atan2, cos, sin, sqrt)
		std.math.geom::(Path, Point, Transform2D)
		std.formats.image.svgrender
	)

	// One command of SVG path data as written: `M 10 20`, `c 1 1 2 2 3 3`, or
	// numbers repeating the command before them without a letter of their
	// own (`implicit`).
	type SVGPathSegment {
		// The command in force, in the case written: `M`, `l`, `h`, `c`, `s`,
		// `q`, `t`, `a`, `z`. Numbers repeating an `M` are an `L` (or `l`).
		command     char
		// Written without a letter, repeating the command before it.
		implicit    bool
		// Where the segment is written: from its letter, or its first number
		// when it has none, to its last number.
		span        XMLSpan
		// The numbers as written (a relative command's are offsets); an arc's
		// flags are 0 and 1.
		numbers     float[]
		// Where each number is written.
		numberSpans XMLSpan[]
		// The current point before the segment, absolute.
		start       Point
		// The points the command names, absolute and in order: `M`, `L`, `H`,
		// `V`, `T` and `A` the end; `C` two controls and the end; `S` and `Q`
		// one control and the end; `Z` the subpath's start it returns to.
		points      Point[]

		def new() {}

		// Whether the numbers are offsets from the current point (a lower-case
		// letter).
		def relative() bool {
			return command >= 'a' && command <= 'z'
		}

		// The point the segment ends at.
		def end() Point {
			return points[points.len() - 1]
		}
	}

	// One letter or number of the data: the separators before it, its text,
	// and for a number its value. Written anew (`fresh`) when an edit changed
	// it, else as it stood.
	internal type PathToken {
		gap   string
		text  string
		value float
		fresh bool

		def new(gap string, text string, value float = 0.0, fresh bool = false) {
			self.gap = gap
			self.text = text
			self.value = value
			self.fresh = fresh
		}
	}

	// The tokens of one segment: its letter, when it has one, and its numbers.
	internal type PathPiece {
		letter  ?PathToken
		numbers PathToken[]
		command byte

		def new() {}
	}

	// SVG path data (the `d` attribute) as a list of segments that keep the
	// form they were written in, from `SVG.parsePathData`. `segments` give
	// each command's absolute points and where its numbers stand in the text;
	// `setPoint`, `split` and `remove` change the geometry and `str` gives the
	// text back with those numbers rewritten and nothing else touched:
	// relative commands stay relative, implicit repeats stay implicit, every
	// other number keeps its spelling, and the separators stay. A command
	// that can no longer say what it has to (`h` whose end moves off its
	// line) is rewritten as the general one (`l`), and an implicit repeat
	// after it is given its letter.
	//
	// Example: Move the end of the second segment
	// ```example
	// use std.formats.image::SVG
	//
	// let d = try new SVG().parsePathData("M10 10 h 5 v5 H10 z")
	// try d.setPoint(1, 0, 15.0, 12.0)
	// println(d.str())        // M10 10 l 5 2 v3 H10 z
	// ```
	type SVGPathData {
		internal text     string
		internal pieces   PathPiece[]
		internal tail     string
		internal geometry Path
		// The segments in order.
		segments          SVGPathSegment[]
		// How many decimals a rewritten number is given, trailing zeros
		// dropped: as many as the most precise number of the data had when it
		// was parsed, unless set.
		decimals          int

		def new() {}

		// The data as text, with every change made.
		def str() string {
			return text
		}

		// The path the data describes, absolute, as `SVG.parsePath` gives it.
		def path() Path {
			return geometry
		}

		// Moves point `index` of segment `at` (as `points` lists them) to the
		// absolute (x, y): the segment's numbers change, and when its end
		// moved, the numbers of the relative segment after it, which keeps
		// its place. Moving a `Z`'s point moves the `M` it returns to, and
		// the relative segment after the `Z` keeps its place too. An `H` or
		// `V` whose end leaves its line becomes an `L`. Fails when there is
		// no such segment or point.
		def setPoint(at int, index int, x, y float) !none {
			fail "svg path data: no segment {at}" when at < 0 || at >= segments.len()
			let seg = segments[at]
			let cmd = byte(seg.command)
			let u = upper(cmd)
			if u == byte('Z') {
				fail "svg path data: a Z has one point" when index != 0
				return try setPoint(subpathStart(at), 0, x, y)
			}
			fail "svg path data: segment {at} has no point {index}" when index < 0 || index >= seg.points.len()
			let points = seg.points.clone()
			points[index] = new Point(x, y)
			let command = cmd
			command = lineLetter(cmd) when (u == byte('H') && y != seg.start.y) || (u == byte('V') && x != seg.start.x)
			rewrite(pieces[at], command, numbersFor(command, points, seg.start, seg.numbers), at, before(at))
			if index == seg.points.len() - 1 {
				let moved = new Point(x, y)
				rebase(at + 1, moved)
				if u == byte('M') {
					let z = closingZ(at)
					rebase(z + 1, moved) when z >= 0
				}
			}
			commit()
		}

		// Maps every point of the data by `t`, rewriting the numbers in one
		// pass and keeping the form: relative commands stay relative with
		// their offsets mapped, implicit repeats stay, an `H` or `V` stays
		// while its line is still on its axis and becomes an `L` otherwise,
		// an arc's radii and rotation become those of the mapped ellipse and
		// its sweep turns with a reflection. Numbers whose value does not
		// change keep their spelling; changed ones are written with
		// `decimals`.
		def transform(t Transform2D) {
			let flips = t.a * t.d - t.b * t.c < 0.0
			for let (at, seg) in segments {
				let cmd = byte(seg.command)
				let u = upper(cmd)
				continue when u == byte('Z')
				// The first command's start is the origin, not a point of the
				// path: a relative first `m` names its point from (0, 0) and
				// so writes the mapped point itself.
				let from = at == 0 ?? (seg.start, t.apply(seg.start))
				let points Point[]
				for let (_, p) in seg.points {
					points.push(t.apply(p))
				}
				let command = cmd
				if u == byte('H') && (points[0].y - from.y).abs() > 1e-9 {
					command = lineLetter(cmd)
				} else if u == byte('V') && (points[0].x - from.x).abs() > 1e-9 {
					command = lineLetter(cmd)
				}
				let head float[]
				head = arcHead(seg.numbers, t, flips) when u == byte('A')
				rewrite(pieces[at], command, numbersFor(command, points, from, seg.numbers, head), at, before(at))
			}
			commit()
		}

		// The segment nearest to `p` along the drawn data, the parameter 0 to
		// 1 of its nearest point and the distance to it: what a press on the
		// line hits, to `split` there. Moves draw nothing and are never
		// returned; an empty path gives (-1, 0, -1).
		def nearest(p Point) (int, float, float) {
			let (best, bestT, bestD) = (-1, 0.0, -1.0)
			for let (at, seg) in segments {
				continue when upper(byte(seg.command)) == byte('M')
				let (t, d) = nearestOn(at, p)
				if bestD < 0.0 || d < bestD {
					best = at
					bestT = t
					bestD = d
				}
			}
			return (best, bestT, bestD)
		}

		// The parameter and distance of the point of segment `at` nearest to
		// `p`: the projection on a line, a sampled then narrowed search on a
		// curve or an arc.
		internal def nearestOn(at int, p Point) (float, float) {
			let seg = segments[at]
			let u = upper(byte(seg.command))
			let a = seg.start
			let b = seg.end()
			if u == byte('L') || u == byte('H') || u == byte('V') || u == byte('Z') || (u == byte('A') && arcOf(at).len() == 0) {
				let dx = b.x - a.x
				let dy = b.y - a.y
				let len2 = dx * dx + dy * dy
				let t = len2 == 0.0 ?? (0.0, (((p.x - a.x) * dx + (p.y - a.y) * dy) / len2).clamp(0.0, 1.0))
				let q = lerp(a, b, t)
				return (t, ddist(q.x, q.y, p.x, p.y))
			}
			let samples = 32
			let (bestK, bestD) = (0, -1.0)
			for let k = 0; k <= samples; k++ {
				let q = pointAt(at, float(k) / float(samples))
				let d = ddist(q.x, q.y, p.x, p.y)
				if bestD < 0.0 || d < bestD {
					bestK = k
					bestD = d
				}
			}
			let lo = (float(bestK - 1) / float(samples)).max(0.0)
			let hi = (float(bestK + 1) / float(samples)).min(1.0)
			for let i = 0; i < 40; i++ {
				let m1 = lo + (hi - lo) / 3.0
				let m2 = hi - (hi - lo) / 3.0
				let q1 = pointAt(at, m1)
				let q2 = pointAt(at, m2)
				if ddist(q1.x, q1.y, p.x, p.y) < ddist(q2.x, q2.y, p.x, p.y) {
					hi = m2
				} else {
					lo = m1
				}
			}
			let t = (lo + hi) / 2.0
			let q = pointAt(at, t)
			return (t, ddist(q.x, q.y, p.x, p.y))
		}

		// The point of segment `at` at parameter `t`.
		internal def pointAt(at int, t float) Point {
			let seg = segments[at]
			let u = upper(byte(seg.command))
			let a = seg.start
			let b = seg.end()
			if u == byte('C') || u == byte('S') {
				let c1 = u == byte('C') ?? (seg.points[0], controlOf(at))
				let c2 = seg.points[seg.points.len() - 2]
				let (x, y) = bezierAt(t, a.x, a.y, c1.x, c1.y, c2.x, c2.y, b.x, b.y)
				return new Point(x, y)
			}
			if u == byte('Q') || u == byte('T') {
				let c = u == byte('Q') ?? (seg.points[0], controlOf(at))
				let s = 1.0 - t
				return new Point(s * s * a.x + 2.0 * s * t * c.x + t * t * b.x, s * s * a.y + 2.0 * s * t * c.y + t * t * b.y)
			}
			if u == byte('A') {
				let arc = arcOf(at)
				return lerp(a, b, t) when arc.len() == 0
				let (cx, cy, rx, ry, theta, dtheta) = (arc[0], arc[1], arc[2], arc[3], arc[4], arc[5])
				let phi = seg.numbers[2] * Pi / 180.0
				let angle = theta + dtheta * t
				return new Point(cx + rx * cos(angle) * cos(phi) - ry * sin(angle) * sin(phi), cy + rx * cos(angle) * sin(phi) + ry * sin(angle) * cos(phi))
			}
			return lerp(a, b, t)
		}

		// The centre form of the arc at `at`, empty when it draws a line.
		internal def arcOf(at int) float[] {
			let seg = segments[at]
			return arcCenter(seg.start, seg.numbers[0], seg.numbers[1], seg.numbers[2], seg.numbers[3] != 0.0, seg.numbers[4] != 0.0, seg.end())
		}

		// Rewrites segment `at` as the cubic that draws the same line or
		// curve, in the case the segment is written in, with controls to move:
		// a line (`L`, `H`, `V`) gets its controls a third and two thirds
		// along it, a quadratic (`Q`, `T`) and a smooth cubic (`S`) their
		// exact cubic, a `Z` keeps closing with the cubic of its closing line
		// written before it. A cubic stays as it is. Fails for a move, an arc
		// (which has no cubic form), or no such segment.
		def toCurve(at int) !none {
			fail "svg path data: no segment {at}" when at < 0 || at >= segments.len()
			let seg = segments[at]
			let cmd = byte(seg.command)
			let u = upper(cmd)
			fail "svg path data: a move has no curve" when u == byte('M')
			fail "svg path data: an arc has no cubic form" when u == byte('A')
			return none when u == byte('C')
			let from = seg.start
			let end = seg.end()
			let command = sameCase(byte('C'), cmd)
			if u == byte('Z') {
				let fresh = new PathPiece()
				let letter = sameCase(byte('C'), char(lineCase(at)))
				rewrite(fresh, letter, numbersFor(letter, [lerp(from, end, 1.0 / 3.0), lerp(from, end, 2.0 / 3.0), end], from, []), -1, pieces[at])
				setFirstGap(fresh, firstGap(pieces[at]))
				pieces = pieces[:at] + [fresh] + pieces[at:]
				commit()
				return none
			}
			let (c1, c2) = (lerp(from, end, 1.0 / 3.0), lerp(from, end, 2.0 / 3.0))
			if u == byte('Q') || u == byte('T') {
				let c = u == byte('Q') ?? (seg.points[0], controlOf(at))
				c1 = lerp(from, c, 2.0 / 3.0)
				c2 = lerp(end, c, 2.0 / 3.0)
			} else if u == byte('S') {
				c1 = controlOf(at)
				c2 = seg.points[0]
			}
			rewrite(pieces[at], command, numbersFor(command, [c1, c2, end], from, seg.numbers), at, before(at))
			commit()
			return none
		}

		// Splits segment `at` at `t` (0 to 1 along it) into two that draw the
		// same: lines, horizontals and verticals in two, curves by de
		// Casteljau (an `S` or `T` first half becomes the `C` or `Q` it is,
		// the second half stays smooth), an arc by its angle, a `Z` gains an
		// `L` to the point before it. The new segment is written before the
		// old one, with its letter. Fails on a move, or a `t` outside the
		// segment.
		def split(at int, t float) !none {
			fail "svg path data: no segment {at}" when at < 0 || at >= segments.len()
			fail "svg path data: t must be between 0 and 1, got {t}" when t <= 0.0 || t >= 1.0
			let seg = segments[at]
			let cmd = byte(seg.command)
			let u = upper(cmd)
			fail "svg path data: a move cannot be split" when u == byte('M')
			let old = pieces[at]
			let fresh = new PathPiece()
			let from = seg.start
			let end = seg.end()
			if u == byte('L') || u == byte('H') || u == byte('V') || u == byte('Z') {
				let mid = lerp(from, end, t)
				let command = u == byte('Z') ?? (lineLetter(lineCase(at)), cmd)
				rewrite(fresh, command, numbersFor(command, [mid], from, []), -1, old)
				rewrite(old, cmd, numbersFor(cmd, seg.points, mid, seg.numbers), at) unless u == byte('Z')
			} else if u == byte('C') || u == byte('S') {
				let c1 = u == byte('C') ?? (seg.points[0], controlOf(at))
				let c2 = seg.points[seg.points.len() - 2]
				let q0 = lerp(from, c1, t)
				let q1 = lerp(c1, c2, t)
				let q2 = lerp(c2, end, t)
				let r0 = lerp(q0, q1, t)
				let r1 = lerp(q1, q2, t)
				let s = lerp(r0, r1, t)
				let command = sameCase(byte('C'), cmd)
				rewrite(fresh, command, numbersFor(command, [q0, r0, s], from, []), -1, old)
				if u == byte('C') {
					rewrite(old, cmd, numbersFor(cmd, [r1, q2, end], s, seg.numbers), at)
				} else {
					rewrite(old, cmd, numbersFor(cmd, [q2, end], s, seg.numbers), at)
				}
			} else if u == byte('Q') || u == byte('T') {
				let c = u == byte('Q') ?? (seg.points[0], controlOf(at))
				let q0 = lerp(from, c, t)
				let q1 = lerp(c, end, t)
				let s = lerp(q0, q1, t)
				let command = sameCase(byte('Q'), cmd)
				rewrite(fresh, command, numbersFor(command, [q0, s], from, []), -1, old)
				if u == byte('Q') {
					rewrite(old, cmd, numbersFor(cmd, [q1, end], s, seg.numbers), at)
				} else {
					rewrite(old, cmd, numbersFor(cmd, [end], s, seg.numbers), at)
				}
			} else if u == byte('A') {
				let arc = arcCenter(from, seg.numbers[0], seg.numbers[1], seg.numbers[2], seg.numbers[3] != 0.0, seg.numbers[4] != 0.0, end)
				if arc.len() == 0 {
					// A degenerate arc draws a line.
					let mid = lerp(from, end, t)
					let command = lineLetter(cmd)
					rewrite(fresh, command, numbersFor(command, [mid], from, []), -1, old)
					rewrite(old, command, numbersFor(command, [end], mid, []), at)
				} else {
					let (cx, cy, rx, ry, theta, dtheta) = (arc[0], arc[1], arc[2], arc[3], arc[4], arc[5])
					let phi = seg.numbers[2] * Pi / 180.0
					let a = theta + dtheta * t
					let mid = new Point(cx + rx * cos(a) * cos(phi) - ry * sin(a) * sin(phi), cy + rx * cos(a) * sin(phi) + ry * sin(a) * cos(phi))
					let sweep = seg.numbers[4]
					let head1 = [rx, ry, seg.numbers[2], (dtheta * t).abs() > Pi ?? (1.0, 0.0), sweep]
					let head2 = [rx, ry, seg.numbers[2], (dtheta * (1.0 - t)).abs() > Pi ?? (1.0, 0.0), sweep]
					rewrite(fresh, cmd, numbersFor(cmd, [mid], from, head1), -1, old)
					rewrite(old, cmd, numbersFor(cmd, [end], mid, head2), at)
				}
			}
			setFirstGap(fresh, firstGap(old))
			pieces = pieces[:at] + [fresh] + pieces[at:]
			commit()
		}

		// Removes segment `at`; the segment after it starts where the removed
		// one did and keeps its points (a relative one is rewritten, an `H` or
		// `V` off its new line becomes an `L`). Removing an `M` makes the
		// segment after it the move, or takes the `Z` with it when the
		// subpath holds nothing else; removing a `Z` leaves the subpath open.
		// Fails when there is no such segment.
		def remove(at int) !none {
			fail "svg path data: no segment {at}" when at < 0 || at >= segments.len()
			let seg = segments[at]
			let u = upper(byte(seg.command))
			let removed = pieces[at]
			let gap = firstGap(removed)
			if u == byte('M') {
				if at + 1 < segments.len() && upper(segments[at + 1].command) == byte('Z') {
					setFirstGap(pieces[at + 2], gap) when at + 2 < pieces.len()
					pieces = pieces[:at] + pieces[at + 2:]
				} else {
					if at + 1 < segments.len() && upper(segments[at + 1].command) != byte('M') {
						let next = segments[at + 1]
						let command = sameCase(byte('M'), next.command)
						rewrite(pieces[at + 1], command, numbersFor(command, [next.end()], seg.start, []), at + 1, removed)
					}
					setFirstGap(pieces[at + 1], gap) when at + 1 < pieces.len()
					pieces = pieces[:at] + pieces[at + 1:]
				}
			} else {
				let letter = removed.letter
				if at + 1 < segments.len() {
					let next = pieces[at + 1]
					if letter is PathToken && next.letter is none {
						next.letter = new PathToken(letter.gap, letter.text, 0.0, true)
						next.numbers[0].gap = afterLetter(removed) when next.numbers.len() > 0
					}
					rebase(at + 1, seg.start)
					setFirstGap(next, gap)
				}
				pieces = pieces[:at] + pieces[at + 1:]
			}
			commit()
		}

		// Replaces everything with `data` parsed anew, as `SVG.parsePathData`
		// does: for data edited as text. `decimals` follows the new data.
		// Fails on malformed data, leaving the model as it was.
		def parse(data string) !none {
			return try read(data, false)
		}

		// Parses the data; `keep` leaves `decimals` as the caller set it.
		internal def read(data string, keep bool) !none {
			let source = data.bytes()
			let p = new Path()
			let found svgrender.PathCommand[]
			try svgrender.readPathData(data, p, def (c svgrender.PathCommand) {
				found.push(c)
			})
			text = data
			geometry = p
			segments = SVGPathSegment[]
			pieces = PathPiece[]
			let prevEnd = 0
			let most = 0
			for let (_, c) in found {
				let seg = new SVGPathSegment()
				seg.command = char(c.command)
				seg.implicit = !c.written
				seg.start = new Point(c.fromX, c.fromY)
				for let i = 0; i + 1 < c.points.len(); i += 2 {
					seg.points.push(new Point(c.points[i], c.points[i + 1]))
				}
				let piece = new PathPiece()
				piece.command = c.command
				let first = c.written ?? (c.at, c.starts[0])
				let last = first
				if c.written {
					piece.letter = new PathToken(string(source[prevEnd:c.at]), string(source[c.at:c.at + 1]))
					prevEnd = c.at + 1
					last = prevEnd
				}
				for let (i, v) in c.numbers {
					let textOf = string(source[c.starts[i]:c.ends[i]])
					piece.numbers.push(new PathToken(string(source[prevEnd:c.starts[i]]), textOf, v))
					seg.numbers.push(v)
					seg.numberSpans.push(XMLSpan{start: c.starts[i], end: c.ends[i]})
					most = most.max(decimalsOf(textOf))
					prevEnd = c.ends[i]
					last = prevEnd
				}
				seg.span = XMLSpan{start: first, end: last}
				segments.push(seg)
				pieces.push(piece)
			}
			tail = string(source[prevEnd:])
			decimals = most unless keep
		}

		// Writes the pieces out and parses the result again; `segments` and
		// the spans then describe the new text.
		internal def commit() {
			let out byte[]
			let fresh = false
			let digitBefore = false
			let put = def (token PathToken) {
				let gap = token.gap
				if gap == "" && (fresh || token.fresh) && digitBefore && token.text.len() > 0 {
					let c = token.text.bytes()[0]
					gap = " " when (c >= byte('0') && c <= byte('9')) || c == byte('.')
				}
				out.push(...gap.bytes())
				out.push(...token.text.bytes())
				fresh = token.fresh
				let bytesOf = token.text.bytes()
				let last = bytesOf.len() > 0 ?? (bytesOf[bytesOf.len() - 1], byte(' '))
				digitBefore = (last >= byte('0') && last <= byte('9')) || last == byte('.')
			}
			for let (_, piece) in pieces {
				let letter = piece.letter
				put(letter) unless letter is none
				for let (_, n) in piece.numbers {
					put(n)
				}
			}
			out.push(...tail.bytes())
			// The pieces were built from parsed data and changed by rules that
			// keep them well formed: parsing them again cannot fail.
			read(string(out), true) onerror recover none
		}

		// Gives `piece` the command and the numbers: a number equal to the one
		// written keeps its text, the others are written anew; a command letter
		// that changes is written, and the implicit repeat after it is given
		// its own letter when it would otherwise read as the new command. `at`
		// is the piece's index among the segments, -1 for a new piece. A letter
		// written where there was none is spaced from its first number as
		// `like`'s letter is from its own (as the piece before, or the piece
		// a new one is cut from, writes it).
		internal def rewrite(piece PathPiece, command byte, numbers float[], at int, like ?PathPiece = none) {
			let spaced = false
			if piece.command != command {
				let letter = piece.letter
				if letter is PathToken {
					piece.letter = new PathToken(letter.gap, string(byte[command]), 0.0, true)
				} else {
					let gap = piece.numbers.len() > 0 ?? (piece.numbers[0].gap, " ")
					piece.letter = new PathToken(gap, string(byte[command]), 0.0, true)
					spaced = true
				}
			}
			let kept = PathToken[]
			for let (i, v) in numbers {
				if i < piece.numbers.len() && !piece.numbers[i].fresh && (piece.numbers[i].value - v).abs() < 1e-12 {
					kept.push(piece.numbers[i])
				} else {
					let gap = i < piece.numbers.len() ?? (piece.numbers[i].gap, " ")
					kept.push(new PathToken(gap, formatNumber(v), v, true))
				}
			}
			kept[0].gap = afterLetter(like) when spaced && kept.len() > 0
			piece.numbers = kept
			if piece.command != command {
				piece.command = command
				if at >= 0 && at + 1 < pieces.len() && pieces[at + 1].letter is none {
					let follower = pieces[at + 1]
					// After a move the numbers that follow are lines, as before.
					let reads = upper(command) == byte('M') ?? (lineLetter(command), command)
					if follower.command != reads && follower.numbers.len() > 0 {
						follower.letter = new PathToken(follower.numbers[0].gap, string(byte[follower.command]), 0.0, true)
						follower.numbers[0].gap = afterLetter(piece)
					}
				}
			}
		}

		// The separators a piece writes between its letter and its first
		// number; none when it has no letter, or no numbers.
		internal def afterLetter(piece ?PathPiece) string {
			return "" when piece is none
			return "" when piece.letter is none || piece.numbers.len() == 0
			return piece.numbers[0].gap
		}

		// The separators before a piece's first token.
		internal def firstGap(piece PathPiece) string {
			let letter = piece.letter
			return letter.gap when letter is PathToken
			return piece.numbers.len() > 0 ?? (piece.numbers[0].gap, "")
		}

		// Puts `gap` before a piece's first token.
		internal def setFirstGap(piece PathPiece, gap string) {
			let letter = piece.letter
			if letter is PathToken {
				letter.gap = gap
			} else if piece.numbers.len() > 0 {
				piece.numbers[0].gap = gap
			}
		}

		// Rewrites segment `at` to keep its points while starting at `from`: a
		// relative one gets new offsets, an `H` or `V` whose line `from` is
		// not on becomes an `L`. Nothing to do past the end, for a `Z`, or for
		// an absolute command that stays as it is.
		internal def rebase(at int, from Point) {
			return when at >= segments.len()
			let seg = segments[at]
			let cmd = byte(seg.command)
			let u = upper(cmd)
			return when u == byte('Z')
			let command = cmd
			command = lineLetter(cmd) when (u == byte('H') && from.y != seg.end().y) || (u == byte('V') && from.x != seg.end().x)
			return when command == cmd && !seg.relative()
			rewrite(pieces[at], command, numbersFor(command, seg.points, from, seg.numbers), at, before(at))
		}

		// The numbers a command writes to name the absolute `points` from
		// `from`: offsets for a relative command. An arc keeps its radii,
		// rotation and flags from `head`, or from `written` when `head` is
		// empty.
		internal def numbersFor(command byte, points Point[], from Point, written float[], head float[] = []) float[] {
			let rel = command >= byte('a') && command <= byte('z')
			let ox = rel ?? (from.x, 0.0)
			let oy = rel ?? (from.y, 0.0)
			let u = upper(command)
			let out float[]
			if u == byte('H') {
				out.push(points[0].x - ox)
			} else if u == byte('V') {
				out.push(points[0].y - oy)
			} else if u == byte('A') {
				let keep = head.len() >= 5 ?? (head, written)
				for let i = 0; i < 5; i++ {
					out.push(keep[i])
				}
				out.push(points[0].x - ox, points[0].y - oy)
			} else if u != byte('Z') {
				for let (_, p) in points {
					out.push(p.x - ox, p.y - oy)
				}
			}
			return out
		}

		// The control point an `S` or `T` at `at` takes from the segment before
		// it: the reflection of that segment's last control about the current
		// point when it is a curve of the same degree, else the current point.
		internal def controlOf(at int) Point {
			let seg = segments[at]
			let u = upper(seg.command)
			return seg.start when at == 0
			let before = segments[at - 1]
			let b = upper(before.command)
			let cubic = u == byte('S') && (b == byte('C') || b == byte('S'))
			let quad = u == byte('T') && (b == byte('Q') || b == byte('T'))
			return seg.start unless cubic || quad
			let last = b == byte('T') ?? (controlOf(at - 1), before.points[before.points.len() - 2])
			return new Point(2.0 * seg.start.x - last.x, 2.0 * seg.start.y - last.y)
		}

		// The piece before segment `at`, whose spacing a letter written anew
		// follows; none for the first.
		internal def before(at int) ?PathPiece {
			return at > 0 ?? (pieces[at - 1], none)
		}

		// The index of the `M` that starts the subpath segment `at` is in.
		internal def subpathStart(at int) int {
			for let i = at; i >= 0; i-- {
				return i when upper(segments[i].command) == byte('M')
			}
			return 0
		}

		// The index of the `Z` that closes the subpath starting at `at`, -1
		// when it is not closed.
		internal def closingZ(at int) int {
			for let i = at + 1; i < segments.len(); i++ {
				let u = upper(segments[i].command)
				return i when u == byte('Z')
				return -1 when u == byte('M')
			}
			return -1
		}

		// The case a line inserted before segment `at` is written in: that of
		// the segment before it.
		internal def lineCase(at int) byte {
			return at > 0 ?? (byte(segments[at - 1].command), byte('L'))
		}

		// A number as the data writes it: `decimals` decimals at most.
		internal def formatNumber(v float) string {
			let text = "%.{decimals}f".format(v)
			text = text.trimEnd("0").trimSuffix(".") when text.contains(".")
			text = "0" when text == "-0"
			return text
		}
	}

	// The upper-case form of a command letter.
	internal def upper(c char) byte {
		return byte(c) & 0xDF
	}

	internal def upper(c byte) byte {
		return c & 0xDF
	}

	// `L` in the case of `like`.
	internal def lineLetter(like char) byte {
		return sameCase(byte('L'), like)
	}

	internal def lineLetter(like byte) byte {
		return sameCase(byte('L'), char(like))
	}

	// `letter` in the case of `like`.
	internal def sameCase(letter byte, like char) byte {
		return sameCase(letter, byte(like))
	}

	internal def sameCase(letter byte, like byte) byte {
		return like & 0x20 != 0 ?? (letter | 0x20, letter & 0xDF)
	}

	// The point of a cubic at `t`.
	internal def bezierAt(t float, x0 float, y0 float, x1 float, y1 float, x2 float, y2 float, x3 float, y3 float) (float, float) {
		let s = 1.0 - t
		let x = s * s * s * x0 + 3.0 * s * s * t * x1 + 3.0 * s * t * t * x2 + t * t * t * x3
		let y = s * s * s * y0 + 3.0 * s * s * t * y1 + 3.0 * s * t * t * y2 + t * t * t * y3
		return (x, y)
	}

	internal def ddist(x0 float, y0 float, x1 float, y1 float) float {
		return sqrt((x0 - x1) * (x0 - x1) + (y0 - y1) * (y0 - y1))
	}

	// An arc's radii, rotation and flags (`written`, as the data has them)
	// after `t`. The ellipse is the unit circle under the rotation and the
	// radii; its image under `t`'s linear part has the singular values of
	// the product for radii and the left singular direction for rotation. A
	// reflection turns the sweep round.
	internal def arcHead(written float[], t Transform2D, flips bool) float[] {
		let rx = written[0].abs()
		let ry = written[1].abs()
		let phi = written[2] * Pi / 180.0
		let (cp, sp) = (cos(phi), sin(phi))
		// M = R(phi) · diag(rx, ry), then A · M with A the linear part.
		let (m00, m01, m10, m11) = (rx * cp, -ry * sp, rx * sp, ry * cp)
		let n00 = t.a * m00 + t.c * m10
		let n01 = t.a * m01 + t.c * m11
		let n10 = t.b * m00 + t.d * m10
		let n11 = t.b * m01 + t.d * m11
		let e = n00 * n00 + n01 * n01
		let f = n10 * n10 + n11 * n11
		let g = n00 * n10 + n01 * n11
		let s1 = e + f
		let s2 = sqrt(((e - f) * (e - f) + 4.0 * g * g).max(0.0))
		let major = sqrt(((s1 + s2) / 2.0).max(0.0))
		let minor = sqrt(((s1 - s2) / 2.0).max(0.0))
		let angle = (major - minor).abs() < 1e-9 ?? (0.0, 0.5 * atan2(2.0 * g, e - f) * 180.0 / Pi)
		let sweep = written[4]
		sweep = sweep != 0.0 ?? (0.0, 1.0) when flips
		return [major, minor, angle, written[3], sweep]
	}

	// The point `t` of the way from `a` to `b`.
	internal def lerp(a Point, b Point, t float) Point {
		return new Point(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t)
	}

	// The digits after the point in a number as written.
	internal def decimalsOf(text string) int {
		let b = text.bytes()
		let dot = b.indexOf(byte('.'))
		return 0 when dot < 0
		let n = 0
		for let i = dot + 1; i < b.len() && b[i] >= byte('0') && b[i] <= byte('9'); i++ {
			n++
		}
		return n
	}

	// The centre form of an SVG arc from `p0` to `p1` (SVG 1.1 F.6.5): centre
	// x and y, the radii as corrected, the start angle and the sweep, in
	// radians. Empty for an arc that draws nothing or a line (equal ends, a
	// zero radius).
	internal def arcCenter(p0 Point, rx float, ry float, rotationDeg float, large bool, sweep bool, p1 Point) float[] {
		return [] when p0.x == p1.x && p0.y == p1.y
		rx = rx.abs()
		ry = ry.abs()
		return [] when rx == 0.0 || ry == 0.0
		let phi = rotationDeg * Pi / 180.0
		let cp = cos(phi)
		let sp = sin(phi)
		let hx = (p0.x - p1.x) / 2.0
		let hy = (p0.y - p1.y) / 2.0
		let x1p = cp * hx + sp * hy
		let y1p = -sp * hx + cp * hy
		let lambda = (x1p * x1p) / (rx * rx) + (y1p * y1p) / (ry * ry)
		if lambda > 1.0 {
			let s = sqrt(lambda)
			rx *= s
			ry *= s
		}
		let num = rx * rx * ry * ry - rx * rx * y1p * y1p - ry * ry * x1p * x1p
		let den = rx * rx * y1p * y1p + ry * ry * x1p * x1p
		let coef = sqrt((num / den).max(0.0))
		coef = -coef when large == sweep
		let cxp = coef * rx * y1p / ry
		let cyp = -coef * ry * x1p / rx
		let cx = cp * cxp - sp * cyp + (p0.x + p1.x) / 2.0
		let cy = sp * cxp + cp * cyp + (p0.y + p1.y) / 2.0
		let theta = atan2((y1p - cyp) / ry, (x1p - cxp) / rx)
		let end = atan2((-y1p - cyp) / ry, (-x1p - cxp) / rx)
		let dtheta = end - theta
		if sweep && dtheta < 0.0 {
			dtheta += Tau
		} else if !sweep && dtheta > 0.0 {
			dtheta -= Tau
		}
		return [cx, cy, rx, ry, theta, dtheta]
	}
}
