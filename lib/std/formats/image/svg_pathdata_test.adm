partial module std.formats.image {
	use (
		std.math.geom::(Point, Transform2D)
		std.testing
	)

	check "SVG path data as written" {
		def near(p Point, x, y float) bool {
			return (p.x - x).abs() < 1e-9 && (p.y - y).abs() < 1e-9
		}

		// Every segment knows its command, its written numbers and their
		// places, its start and its absolute points; the text comes back
		// untouched.
		@test()
		def segmentsAsWritten() !none {
			let source = "M10 10 h 5 v5 H10 z"
			let d = try new SVG().parsePathData(source)
			assert d.str() == source
			assert d.segments.len() == 5
			let h = d.segments[1]
			assert h.command == 'h' && h.relative() && !h.implicit
			assert h.numbers.len() == 1 && h.numbers[0] == 5.0
			assert source[h.span.start:h.span.end] == "h 5"
			assert source[h.numberSpans[0].start:h.numberSpans[0].end] == "5"
			assert near(h.start, 10.0, 10.0) && near(h.end(), 15.0, 10.0)
			let z = d.segments[4]
			assert z.command == 'z' && near(z.end(), 10.0, 10.0) && z.numbers.len() == 0
			assert source[z.span.start:z.span.end] == "z"
			let pairs = try new SVG().parsePathData("m1 1 2 0 0 2")
			assert pairs.segments[1].command == 'l' && pairs.segments[1].implicit
			assert near(pairs.segments[2].end(), 3.0, 3.0)
			assert d.decimals == 0
			assert (try new SVG().parsePathData("M0.5 0.25 l1 1")).decimals == 2
		}

		// Moving a point rewrites its numbers only; a relative segment after
		// the moved end keeps its place; an `h` leaving its line becomes `l`.
		@test()
		def setPointKeepsTheRest() !none {
			let d = try new SVG().parsePathData("M10 10 h 5 v5 H10 z")
			try d.setPoint(1, 0, 15.0, 12.0)
			fail "got {d.str()}" unless d.str() == "M10 10 l 5 2 v3 H10 z"
			assert near(d.segments[2].end(), 15.0, 15.0)
			let a = try new SVG().parsePathData("M10 10 L20 20 L30 10")
			try a.setPoint(1, 0, 25.0, 20.0)
			fail "got {a.str()}" unless a.str() == "M10 10 L25 20 L30 10"
			// Compact negatives get the separator they need, and nothing more.
			let c = try new SVG().parsePathData("M10-5l5-5")
			try c.setPoint(1, 0, 20.0, 0.0)
			fail "got {c.str()}" unless c.str() == "M10-5l10 5"
			// A changed number is written to the data's decimals.
			let p = try new SVG().parsePathData("M0.5 0.25 l1 1")
			try p.setPoint(1, 0, 2.1, 1.3333)
			fail "got {p.str()}" unless p.str() == "M0.5 0.25 l1.6 1.08"
			p.decimals = 3
			try p.setPoint(1, 0, 2.1, 1.3333)
			fail "got {p.str()}" unless p.str() == "M0.5 0.25 l1.6 1.083"
		}

		// Moving a `Z`'s point moves the `M`; the relative segment after the
		// `Z` stays where it was.
		@test()
		def setPointOnClose() !none {
			let d = try new SVG().parsePathData("M5 5 l5 0 z l0 5")
			try d.setPoint(2, 0, 6.0, 7.0)
			fail "got {d.str()}" unless d.str() == "M6 7 l4 -2 z l-1 3"
			assert near(d.segments[3].end(), 5.0, 10.0)
		}

		// An implicit repeat after a rewritten command is given its letter.
		@test()
		def implicitRepeatsGetLetters() !none {
			let d = try new SVG().parsePathData("M0 0 h10 10 10")
			try d.setPoint(2, 0, 20.0, 5.0)
			fail "got {d.str()}" unless d.str() == "M0 0 h10 l10 5 l10 -5"
			assert near(d.segments[3].end(), 30.0, 0.0)
		}

		// Splitting a line, a cubic and an arc keeps the drawing.
		@test()
		def splitKeepsTheDrawing() !none {
			let line = try new SVG().parsePathData("M0 0 L10 0")
			try line.split(1, 0.5)
			fail "got {line.str()}" unless line.str() == "M0 0 L5 0 L10 0"
			let curve = try new SVG().parsePathData("M0 0 C0 10 10 10 10 0")
			curve.decimals = 1
			try curve.split(1, 0.5)
			fail "got {curve.str()}" unless curve.str() == "M0 0 C0 5 2.5 7.5 5 7.5 C7.5 7.5 10 5 10 0"
			let smooth = try new SVG().parsePathData("M0 0C0 10 10 10 10 0S20-10 20 0")
			smooth.decimals = 1
			try smooth.split(2, 0.5)
			fail "got {smooth.str()}" unless smooth.segments.len() == 4 && smooth.segments[2].command == 'C' && smooth.segments[3].command == 'S'
			let before = (try new SVG().parsePath("M0 0C0 10 10 10 10 0S20-10 20 0")).bounds()
			let after = smooth.path().bounds()
			fail "got {smooth.str()} with bounds {after.right} {after.top}, not {before.right} {before.top}" unless (before.right - after.right).abs() < 1e-6 && (before.top - after.top).abs() < 1e-6
			let arc = try new SVG().parsePathData("M0 0 A5 5 0 0 1 10 0")
			try arc.split(1, 0.5)
			fail "got {arc.str()}" unless arc.str() == "M0 0 A5 5 0 0 1 5 -5 A5 5 0 0 1 10 0"
			let closed = try new SVG().parsePathData("M0 0 l10 0 l0 10 z")
			try closed.split(3, 0.5)
			fail "got {closed.str()}" unless closed.str() == "M0 0 l10 0 l0 10 l-5 -5 z"
		}

		// Removing a segment joins its neighbours; removing a move promotes the
		// next segment; removing a `Z` opens the subpath.
		@test()
		def removeJoins() !none {
			let d = try new SVG().parsePathData("M0 0 l10 0 l0 10 z")
			try d.remove(1)
			fail "got {d.str()}" unless d.str() == "M0 0 l10 10 z"
			let h = try new SVG().parsePathData("M0 0 l10 5 h10 z")
			try h.remove(1)
			fail "got {h.str()}" unless h.str() == "M0 0 l20 5 z"
			let m = try new SVG().parsePathData("M0 0 L5 5 L9 9")
			try m.remove(0)
			fail "got {m.str()}" unless m.str() == "M5 5 L9 9"
			let z = try new SVG().parsePathData("M5 5 l5 0 z l0 5")
			try z.remove(2)
			fail "got {z.str()}" unless z.str() == "M5 5 l5 0 l-5 5"
			assert near(z.segments[2].end(), 5.0, 10.0)
		}

		// A transform maps every point in one rewrite and keeps the form: offsets
		// stay offsets, an `h` stays while still horizontal, an arc's radii follow
		// the ellipse and a reflection turns its sweep.
		@test()
		def transformKeepsTheForm() !none {
			let d = try new SVG().parsePathData("M10 10 h 5 v5 H10 z")
			d.transform(new Transform2D(tx = 1.0, ty = 2.0))
			fail "got {d.str()}" unless d.str() == "M11 12 h 5 v5 H11 z"
			d.transform(new Transform2D(a = 2.0))
			fail "got {d.str()}" unless d.str() == "M22 12 h 10 v5 H22 z"
			// A rotation takes the horizontal off its axis.
			let r = try new SVG().parsePathData("M0 0 h 10")
			r.transform(new Transform2D(a = 0.0, b = 1.0, c = -1.0, d = 0.0))
			fail "got {r.str()}" unless r.str() == "M0 0 l 0 10"
			let arc = try new SVG().parsePathData("M0 0 A5 5 0 0 1 10 0")
			arc.transform(new Transform2D(a = 2.0))
			fail "got {arc.str()}" unless arc.str() == "M0 0 A10 5 0 0 1 20 0"
			let flipped = try new SVG().parsePathData("M0 0 A5 5 0 0 1 10 0")
			flipped.transform(new Transform2D(d = -1.0))
			fail "got {flipped.str()}" unless flipped.str() == "M0 0 A5 5 0 0 0 10 0"
			assert near(flipped.segments[1].end(), 10.0, 0.0)
			// A relative first `m` is measured from the origin, so it moves by the
			// whole transform; a later `m` after `z` is an offset from the subpath's
			// start and keeps it.
			let rel = try new SVG().parsePathData("m3 2v12h4z")
			rel.transform(new Transform2D(tx = 2.0, ty = 1.0))
			fail "got {rel.str()}" unless rel.str() == "m5 3v12h4z"
			rel.transform(new Transform2D(a = 2.0, d = 2.0))
			fail "got {rel.str()}" unless rel.str() == "m10 6v24h8z"
			let two = try new SVG().parsePathData("m3 2 4 0 0 4z m10 0 2 2")
			two.transform(new Transform2D(tx = 2.0, ty = 1.0))
			fail "got {two.str()}" unless two.str() == "m5 3 4 0 0 4z m10 0 2 2"
		}

		// The nearest segment to a point, with the parameter and distance of its
		// nearest point: on lines by projection, on curves by search.
		@test()
		def nearestFindsTheSegment() !none {
			let d = try new SVG().parsePathData("M0 0 L10 0 L10 10")
			let (at, t, dist) = d.nearest(new Point(5.0, 1.0))
			assert at == 1 && (t - 0.5).abs() < 1e-9 && (dist - 1.0).abs() < 1e-9
			let (at2, t2, dist2) = d.nearest(new Point(11.0, 5.0))
			assert at2 == 2 && (t2 - 0.5).abs() < 1e-9 && (dist2 - 1.0).abs() < 1e-9
			let curve = try new SVG().parsePathData("M0 0 C0 10 10 10 10 0")
			let (at3, t3, dist3) = curve.nearest(new Point(5.0, 8.0))
			assert at3 == 1 && (t3 - 0.5).abs() < 1e-3 && (dist3 - 0.5).abs() < 1e-3
			let closed = try new SVG().parsePathData("M0 0 L10 0 L10 10 z")
			let (at4, _, dist4) = closed.nearest(new Point(5.0, 4.0))
			assert at4 == 3 && dist4 < 1.0
			let (nothing, _, missing) = (try new SVG().parsePathData("M1 1")).nearest(new Point(0.0, 0.0))
			assert nothing == -1 && missing < 0.0
		}

		// A line becomes the cubic that draws it, in its own case, an implicit
		// repeat after it getting its letter; a quadratic its exact cubic; a `Z`
		// gains the cubic of its closing line; a move or an arc has none.
		@test()
		def toCurveGivesHandles() !none {
			let d = try new SVG().parsePathData("M0 0 L10 0 L10 10")
			d.decimals = 3
			try d.toCurve(1)
			fail "got {d.str()}" unless d.str() == "M0 0 C3.333 0 6.667 0 10 0 L10 10"
			let r = try new SVG().parsePathData("M0 0 l10 0 5 5")
			r.decimals = 3
			try r.toCurve(1)
			fail "got {r.str()}" unless r.str() == "M0 0 c3.333 0 6.667 0 10 0 l5 5"
			let z = try new SVG().parsePathData("M0 0 L10 0 L10 10 z")
			z.decimals = 3
			try z.toCurve(3)
			fail "got {z.str()}" unless z.str() == "M0 0 L10 0 L10 10 C6.667 6.667 3.333 3.333 0 0 z"
			let q = try new SVG().parsePathData("M0 0 Q5 10 10 0")
			q.decimals = 3
			try q.toCurve(1)
			fail "got {q.str()}" unless q.str() == "M0 0 C3.333 6.667 6.667 6.667 10 0"
			let before = (try new SVG().parsePath("M0 0 Q5 10 10 0")).bounds()
			let after = q.path().bounds()
			assert (before.top - after.top).abs() < 1e-2
			assert d.toCurve(0) is error
			assert (try new SVG().parsePathData("M0 0 A5 5 0 0 1 10 0")).toCurve(1) is error
		}

		// Malformed data fails, and `parse` reads new text into the model.
		@test()
		def parseAgain() !none {
			let d = try new SVG().parsePathData("M0 0 L1 1")
			assert new SVG().parsePathData("M0 0 L1") is error
			try d.parse("M2 2 l1 1")
			assert d.segments.len() == 2 && near(d.segments[1].end(), 3.0, 3.0)
		}
	}
}
