// The elements an SVG document draws, with their geometry in document units
// and where each value they draw with was written: for an editor's hit
// testing, handles and property panel.

partial module std.formats.image {
	use (
		std.data.encoding::XMLNode
		std.gfx.canvas::Paint
		std.math.geom::(FillRule, Path, Rect, StrokeStyle, Transform2D)
		std.formats.image.svgrender
	)

	// How an element declared a property value.
	enum SVGValueFrom {
		// A presentation attribute (`fill="red"`).
		Attribute,
		// A declaration in its `style` attribute.
		Style,
		// A rule of a style sheet; `selector` names it.
		Sheet,
	}

	// Where a property value a shape draws with was declared: on the element
	// itself or on an element it inherits from (an ancestor, or the `use` it
	// is drawn through).
	struct SVGValueSource {
		property string
		// The value as written.
		value    string
		element  XMLNode
		from     SVGValueFrom
		// The rule's selector, for a value a sheet set.
		selector string
	}

	// One element as the document draws it.
	type SVGShape {
		// The element as written, to select and edit: the `use` when the
		// shape is drawn through one, else the element itself.
		element       XMLNode
		// The element whose geometry this is: `element`, or what the `use`
		// shows.
		drawn         XMLNode
		// The drawn element's name: `rect`, `path`, `text`, `image`, …
		tag           string
		// From the element's user units to document units: every ancestor's
		// transform, the `use`'s place and the view box's fitting included.
		transform     Transform2D
		// The outline in the element's user units, where its handles are.
		local         Path
		// The outline in document units: `local` under `transform`. A text
		// or an image gives the box it is drawn in.
		outline       Path
		// The stroke's area in document units; none when it is not stroked.
		strokeOutline ?Path
		// The outline's box, and the box with the stroke.
		bounds        Rect
		painted       Rect
		// The fill and stroke as resolved: a colour, or a gradient or
		// pattern; none for `none`, or when a server cannot be drawn and has
		// no fallback colour. A text or an image has neither.
		fill          ?Paint
		fillRule      FillRule
		fillOpacity   float
		stroke        ?Paint
		// The stroke in the element's user units; none when not stroked.
		strokeStyle   ?StrokeStyle
		strokeOpacity float
		// The element's own opacity.
		opacity       float
		// Whether `visibility` shows it; a hidden element is still listed,
		// since it is still written.
		visible       bool
		// Where every property in force on the element was declared: its own
		// declarations, then the inherited ones of each ancestor, the nearest
		// first. A property nothing declared takes its initial value and is
		// not listed.
		sources       SVGValueSource[]

		def new() {}
	}

	// What `SVG.shapes` found: the document's size and view box, and its
	// drawn elements in paint order.
	type SVGShapes {
		width           float
		height          float
		viewBox         ?Rect
		// From view box units to document units; the identity without a
		// view box.
		transform       Transform2D
		shapes          SVGShape[]
		// The frame of every element drawn, by the start of its span.
		internal frames map<int, Transform2D>
		// The parsed document, for the values in force on any of its elements.
		internal doc    ?svgrender.Document   = none

		def new() {
			frames = map<int, Transform2D>{}
		}

		// From the element's user units to document units: inside its own
		// `transform`, and for a viewport (`svg`, `symbol`) its view box, for
		// a `use` its place too: the frame its content is drawn in. For an
		// element drawn through several uses, the first instance drawn. None
		// for an element the drawing never reached (in `defs`, a pattern or a
		// mask, `display: none`), or one not of the parsed tree.
		def transformOf(element XMLNode) ?Transform2D {
			return frames.get(element.span.start)
		}

		// Where every property in force on `element` was declared, as
		// `SVGShape.sources` lists them: its own declarations, then the inherited
		// ones of each ancestor, the nearest first. For any element of the parsed
		// tree, drawn or not (in `defs`, under `display: none`), at its place in
		// the tree, so a `use` that shows it adds nothing. Empty for an element
		// not of the tree.
		def sourcesOf(element XMLNode) SVGValueSource[] {
			let parsed = doc
			return [] when parsed is none
			let trail svgrender.Node[]
			return [] unless trailTo(parsed.root, element.span.start, trail)
			return sourcesFrom(parsed, trail)
		}
	}

	// Finds the node read from the element whose span starts at `start` under
	// `at`, leaving in `trail` the way to it from `at`, root first.
	internal def trailTo(at svgrender.Node, start int, trail svgrender.Node[]) bool {
		trail.push(at)
		let source = at.source
		return true when !(source is none) && source.span.start == start
		for let (_, c) in at.children {
			continue when c.isText
			return true when trailTo(c, start, trail)
		}
		trail.pop()
		return false
	}

	// The declared sources of the properties in force on the last node of
	// `trail`, in the public form; a node without an element of its own (one the
	// renderer made) is left out.
	internal def sourcesFrom(doc svgrender.Document, trail svgrender.Node[]) SVGValueSource[] {
		let out SVGValueSource[]
		for let (_, v) in svgrender.valueSources(doc, trail) {
			let setter = v.node.source
			continue when setter is none
			let from = SVGValueFrom.Attribute
			from = SVGValueFrom.Style when v.from == "style"
			from = SVGValueFrom.Sheet when v.from == "sheet"
			out.push(SVGValueSource{property: v.property, value: v.value, element: setter, from: from, selector: v.selector})
		}
		return out
	}

	// The shape a renderer reported, in the public form.
	internal def shapeOf(doc svgrender.Document, r svgrender.ShapeReport) ?SVGShape {
		let drawn = r.node.source
		return none when drawn is none
		let via = r.via
		let element = via is svgrender.Node ?? (via.source, drawn)
		return none when element is none
		let out = new SVGShape()
		out.element = element
		out.drawn = drawn
		out.tag = r.node.tag
		out.transform = r.transform
		out.local = r.local
		out.outline = r.local.transformed(r.transform)
		out.bounds = out.outline.bounds()
		out.painted = out.bounds
		out.fill = r.fill
		out.fillRule = r.fillRule
		out.fillOpacity = r.fillOpacity
		out.stroke = r.stroke
		out.strokeStyle = r.strokeStyle
		out.strokeOpacity = r.strokeOpacity
		out.opacity = r.opacity
		out.visible = r.visible
		let s = r.strokeStyle
		if s is StrokeStyle {
			let stroked = r.local.stroked(s).transformed(r.transform)
			out.strokeOutline = stroked
			let b = stroked.bounds()
			out.painted = Rect{left: out.bounds.left.min(b.left), top: out.bounds.top.min(b.top), right: out.bounds.right.max(b.right), bottom: out.bounds.bottom.max(b.bottom)}
		}
		out.sources = sourcesFrom(doc, r.trail)
		return out
	}
}
