partial module std.formats.image {
	use (
		std.data.encoding::XML
		std.gfx.color::Color
		std.math.geom::StrokeStyle
		std.testing
	)

	check "SVG shapes" {
		def near(a float, b float) bool {
			return (a - b).abs() < 1e-6
		}

		def source(shape SVGShape, property string) ?SVGValueSource {
			for let (_, s) in shape.sources {
				return s when s.property == property
			}
			return none
		}

		internal def document() string {
			return "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\" width=\"200\" height=\"200\"><style>.a\{fill:red\}</style><g transform=\"translate(10 10)\" stroke=\"blue\"><rect class=\"a\" x=\"0\" y=\"0\" width=\"20\" height=\"10\" stroke-width=\"2\"/><circle cx=\"50\" cy=\"50\" r=\"5\" fill=\"none\" style=\"stroke-width: 3\"/></g><defs><rect id=\"r\" width=\"4\" height=\"4\"/><pattern id=\"p\" width=\"2\" height=\"2\" patternUnits=\"userSpaceOnUse\"><rect width=\"1\" height=\"1\"/></pattern></defs><use href=\"#r\" x=\"80\" y=\"80\" fill=\"green\"/><rect x=\"0\" y=\"90\" width=\"10\" height=\"10\" fill=\"url(#p)\" display=\"none\"/><text x=\"5\" y=\"90\">Hi</text></svg>"
		}

		// Every drawn element is listed in paint order with its outline in
		// document units (the view box fitted), its paints and the element that
		// set each value; what defs hold and what display:none hides is not.
		@test()
		def listsDrawnElements() !none {
			let data = document().bytes()
			let found = try new SVG().shapes(data)
			assert near(found.width, 200.0) && near(found.height, 200.0)
			let box = found.viewBox
			fail "no view box" when box is none
			assert near(box.right, 100.0) && near(found.transform.a, 2.0)
			fail "got {found.shapes.len()} shapes" unless found.shapes.len() == 4
			let (rect, circle, used, text) = (found.shapes[0], found.shapes[1], found.shapes[2], found.shapes[3])
			assert rect.tag == "rect" && circle.tag == "circle" && used.tag == "rect" && text.tag == "text"

			// The rect: translated by the group, scaled by the view box.
			assert rect.element.name == "rect" && string(data[rect.element.span.start:rect.element.span.start + 5]) == "<rect"
			assert near(rect.bounds.left, 20.0) && near(rect.bounds.top, 20.0) && near(rect.bounds.right, 60.0) && near(rect.bounds.bottom, 40.0)
			assert near(rect.local.bounds().right, 20.0)
			let fill = rect.fill
			fail "no fill" unless fill is Color
			assert int(fill.rgba.r) == 255 && int(fill.rgba.g) == 0
			let stroke = rect.stroke
			fail "no stroke" unless stroke is Color
			assert int(stroke.rgba.b) == 255
			let pen = rect.strokeStyle
			fail "no stroke style" unless pen is StrokeStyle
			assert near(float(pen.width), 2.0)
			assert rect.painted.left < rect.bounds.left && !(rect.strokeOutline is none)
			assert rect.visible && near(rect.opacity, 1.0)

			// Where the values come from: the sheet, the group, the rect itself.
			let fillFrom = source(rect, "fill")
			fail "no fill source" when fillFrom is none
			assert fillFrom.from == SVGValueFrom.Sheet && fillFrom.selector == ".a" && fillFrom.element.name == "rect" && fillFrom.value == "red"
			let strokeFrom = source(rect, "stroke")
			fail "no stroke source" when strokeFrom is none
			assert strokeFrom.from == SVGValueFrom.Attribute && strokeFrom.element.name == "g"
			let widthFrom = source(rect, "stroke-width")
			fail "no width source" when widthFrom is none
			assert widthFrom.from == SVGValueFrom.Attribute && widthFrom.element.name == "rect"
			assert source(rect, "transform") is none

			// The circle: no fill, a stroke width from its style attribute.
			assert circle.fill is none && !(circle.stroke is none)
			let circleWidth = source(circle, "stroke-width")
			fail "no circle width source" when circleWidth is none
			assert circleWidth.from == SVGValueFrom.Style && circleWidth.value == "3"
			assert near(circle.bounds.left, 110.0) && near(circle.bounds.right, 130.0)

			// The used rect is selected as its use; its fill comes from the use.
			assert used.element.name == "use" && used.drawn.name == "rect"
			assert near(used.bounds.left, 160.0) && near(used.bounds.right, 168.0)
			let usedFill = source(used, "fill")
			fail "no used fill source" when usedFill is none
			assert usedFill.element.name == "use" && usedFill.value == "green"

			// The text's box is where its glyphs are.
			assert text.element.name == "text" && text.fill is none && text.strokeStyle is none
		}

		// Every element the drawing reached has a frame: a group's user units
		// under its transform and the view box, a used symbol's under the use, a
		// defs-only element none; `parseTransform` reads an attribute's text.
		@test()
		def framesOfElements() !none {
			let data = document().bytes()
			let found = try new SVG().shapes(data)
			let root = try new XML().parse(data)
			let g = root.child("g")
			fail "no g" when g is none
			let frame = found.transformOf(g)
			fail "no frame for g" when frame is none
			assert near(frame.a, 2.0) && near(frame.tx, 20.0) && near(frame.ty, 20.0)
			let rootFrame = found.transformOf(root)
			fail "no frame for the root" when rootFrame is none
			assert near(rootFrame.a, 2.0) && near(rootFrame.tx, 0.0)
			let defs = root.child("defs")
			fail "no defs" when defs is none
			let pattern = defs.child("pattern")
			fail "no pattern" when pattern is none
			assert found.transformOf(pattern) is none
			let used = defs.child("rect")
			fail "no used rect" when used is none
			let usedFrame = found.transformOf(used)
			fail "no frame for the used rect" when usedFrame is none
			assert near(usedFrame.tx, 160.0) && near(usedFrame.ty, 160.0)
			let t = try new SVG().parseTransform("translate(10 10) scale(2)")
			assert near(t.a, 2.0) && near(t.tx, 10.0)
			assert new SVG().parseTransform("spin(1)") is error
		}

		// The values in force on any element of the tree, drawn or not: a circle
		// under `display: none` inherits the root's stroke and keeps its own
		// radius; an element in `defs` is answered at its place, without the
		// `use` that shows it; an element of another tree gets nothing.
		@test()
		def sourcesOfAnyElement() !none {
			let hidden = "<svg xmlns=\"http://www.w3.org/2000/svg\" stroke=\"red\" stroke-width=\"1.75\"><circle r=\"2\" display=\"none\" fill=\"blue\"/></svg>".bytes()
			let found = try new SVG().shapes(hidden)
			assert found.shapes.len() == 0
			let root = try new XML().parse(hidden)
			let circle = root.child("circle")
			fail "no circle" when circle is none
			let got = found.sourcesOf(circle)
			let byName = map<string, SVGValueSource>{}
			for let (_, s) in got {
				byName[s.property] = s
			}
			assert byName.hasKey("stroke") && byName["stroke"].value == "red" && byName["stroke"].element.name == "svg"
			assert byName.hasKey("stroke-width") && byName["stroke-width"].value == "1.75"
			assert byName.hasKey("fill") && byName["fill"].element.name == "circle" && byName["fill"].from == SVGValueFrom.Attribute
			assert byName.hasKey("display") && byName["display"].value == "none"
			// The root's own values, and nothing from below it.
			let onRoot = found.sourcesOf(root)
			assert onRoot.len() == 2

			let data = document().bytes()
			let shapes = try new SVG().shapes(data)
			let tree = try new XML().parse(data)
			let defs = tree.child("defs")
			fail "no defs" when defs is none
			let kept = defs.child("rect")
			fail "no kept rect" when kept is none
			let inDefs = shapes.sourcesOf(kept)
			for let (_, s) in inDefs {
				assert s.property != "fill"
			}
			assert shapes.sourcesOf(root).len() == 0
		}

		// Nothing an element has set lists no source; a hidden element is listed
		// as not visible; malformed data fails.
		@test()
		def edges() !none {
			let plain = try new SVG().shapes("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\"><rect width=\"5\" height=\"5\" visibility=\"hidden\"/></svg>".bytes())
			assert plain.viewBox is none && near(plain.transform.a, 1.0)
			assert plain.shapes.len() == 1 && !plain.shapes[0].visible
			let fill = plain.shapes[0].fill
			fail "no fill" unless fill is Color
			assert int(fill.rgba.r) == 0 && source(plain.shapes[0], "fill") is none
			assert new SVG().shapes("<svg".bytes()) is error
		}
	}
}
