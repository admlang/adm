partial module std.formats.image {
	use (
		std.testing
		std.bytes
		std.gfx.canvas
		std.gfx.canvas::(Canvas)
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Rect, Transform2D)
		std.os
		std.time
	)

	check "SVG decoding" {
		// The pixel at (x, y) as "r g b a".
		def px(img Image, x int, y int) string {
			let i = y * img.stride() + x * 4
			let b = img.raw()
			return "{b[i]} {b[i + 1]} {b[i + 2]} {b[i + 3]}"
		}

		def svg(body string, attrs string = "viewBox=\"0 0 100 100\"") byte[] {
			return "<svg xmlns=\"http://www.w3.org/2000/svg\" {attrs}>{body}</svg>".bytes()
		}

		// The pixel of the canvas at (x, y) as "r g b a".
		def cpx(c Canvas, x int, y int) string {
			let i = (y * c.width + x) * 4
			let b = c.pixels
			return "{b[i]} {b[i + 1]} {b[i + 2]} {b[i + 3]}"
		}

		// The document replayed under a shrink by half and a shift of 20: what a window does
		// with a picture.
		def underTransform(body string, record bool) Canvas {
			let picture = new SVG().picture(svg(body)) onerror (err error) {
				assert err.message == ""
				return new Canvas(100, 100)
			}
			let c = new Canvas(100, 100)
			if record {
				// Through another recording, as a window's frame is.
				let frame = canvas.record(def (p canvas.Painter) {
					p.translate(20.0, 20.0)
					p.scale(0.5, 0.5)
					picture.replay(p)
				})
				frame.replay(c)
			} else {
				c.translate(20.0, 20.0)
				c.scale(0.5, 0.5)
				picture.replay(c)
			}
			return c
		}

		def assertLandsInItsBox(body string) {
			for let (_, record) in [false, true] {
				let c = underTransform(body, record)
				assert cpx(c, 45, 45) == "255 0 0 255"
				// Shrunk and shifted, it covers 30 to 60: left where it was drawn it would cover
				// 20 to 80.
				for let (_, at) in [(5, 5), (25, 45), (45, 25), (65, 45), (45, 65), (90, 90)] {
					assert cpx(c, at.0, at.1) == "0 0 0 0"
				}
			}
		}

		// Effects that take pixels stay under the transform a picture is replayed under.
		@test()
		def pictureEffectsFollowTheTransform() {
			let rect = "<rect x=\"20\" y=\"20\" width=\"60\" height=\"60\" fill=\"#f00\""
			assertLandsInItsBox(rect + "/>")
			// A filter.
			assertLandsInItsBox("<filter id=\"f\"><feOffset dx=\"0\" dy=\"0\"/></filter>" + rect + " filter=\"url(#f)\"/>")
			// A mask and a clip path of more than one shape, which take pixels: each cuts the
			// shape at x = 50 of the document, which is x = 45 of the canvas.
			let masked = "<mask id=\"m\"><rect width=\"50\" height=\"100\" fill=\"#fff\"/></mask>" + rect + " mask=\"url(#m)\"/>"
			let clipped = "<clipPath id=\"c\"><rect width=\"25\" height=\"100\"/><rect x=\"25\" width=\"25\" height=\"100\"/></clipPath>" + rect + " clip-path=\"url(#c)\"/>"
			for let (_, body) in [masked, clipped] {
				for let (_, record) in [false, true] {
					let c = underTransform(body, record)
					assert cpx(c, 40, 45) == "255 0 0 255"
					// Left in document pixels the cut would stand at x = 50 of the canvas.
					assert cpx(c, 47, 45) == "0 0 0 0"
					assert cpx(c, 25, 45) == "0 0 0 0"
				}
			}
			// Through a group, and with opacity around it.
			let half = underTransform("<mask id=\"m\"><rect width=\"50\" height=\"100\" fill=\"#fff\"/></mask>" + rect + " mask=\"url(#m)\" opacity=\"0.5\"/>", false)
			let alpha = int(half.pixels[(45 * 100 + 40) * 4 + 3])
			assert alpha > 100 && alpha < 155
		}

		// A replay composes only what it recorded, and leaves the painter's settings alone.
		@test()
		def replayKeepsTheTransformOfItsPainter() {
			let inner = canvas.record(def (p canvas.Painter) {
				p.setTransform(new Transform2D(tx = 10.0))
				p.fill(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 10.0}, new Color(RGBA{r: 255, g: 0, b: 0, a: 255}))
				p.resetTransform()
				p.fill(Rect{left: 40.0, top: 0.0, right: 50.0, bottom: 10.0}, new Color(RGBA{r: 0, g: 255, b: 0, a: 255}))
			})
			let c = new Canvas(100, 100)
			c.translate(0.0, 20.0)
			c.save()
			inner.replay(c)
			c.restore()
			assert cpx(c, 15, 25) == "255 0 0 255" && cpx(c, 15, 5) == "0 0 0 0"
			assert cpx(c, 45, 25) == "0 255 0 255" && cpx(c, 45, 5) == "0 0 0 0"
		}

		// A picture of a file reads what it references from the file's folder; a picture
		// of bytes has no folder and draws nothing there. A file that shows itself draws
		// what it would without that image.
		@test()
		def pictureOfAFileReadsItsImages() !none {
			let dir = os.join(os.tempDir(), "adm-svg-picture-{time.now().unixNs()}")
			try os.mkdir(dir, parents = true)
			try os.writeFile(os.join(dir, "red.svg"), svg("<rect width=\"100\" height=\"100\" fill=\"#ff0000\"/>"))
			let outer = svg("<image href=\"red.svg\" width=\"100\" height=\"100\"/><image href=\"outer.svg\" width=\"100\" height=\"100\"/>")
			let path = os.join(dir, "outer.svg")
			try os.writeFile(path, outer)
			let codec = new SVG()
			let ofFile = try codec.picture(path)
			let onFile = new Canvas(100, 100)
			ofFile.replay(onFile)
			let ofBytes = try codec.picture(outer)
			let onBytes = new Canvas(100, 100)
			ofBytes.replay(onBytes)
			try os.remove(dir, recursive = true)
			assert cpx(onFile, 50, 50) == "255 0 0 255"
			assert cpx(onBytes, 50, 50) == "0 0 0 0"
			assert codec.picture(os.join(dir, "gone.svg")) is error
		}

		// The document drawn in a 100 square with the text colour red.
		def tinted(body string, attrs string) !Canvas {
			let c = new Canvas(100, 100)
			let picture = try new SVG().picture(svg(body, "viewBox=\"0 0 100 100\" " + attrs), foreground = new Color(RGBA{r: 255, g: 0, b: 0, a: 255}))
			picture.replay(c)
			return c
		}

		// With a foreground, currentColor and a fill no element sets take it; a colour
		// the document sets stays; an unset stroke stays none.
		@test()
		def tintsCurrentColorAndUnsetFills() !none {
			// A stroke icon: the root says stroke="currentColor", the path inherits it.
			let line = try tinted("<path d=\"M0 50 H100\"/>", "fill=\"none\" stroke=\"currentColor\" stroke-width=\"20\"")
			assert cpx(line, 50, 50) == "255 0 0 255" && cpx(line, 50, 20) == "0 0 0 0"
			// One explicit colour beside a currentColor path.
			let mixed = try tinted("<path d=\"M0 0 H50 V50 H0 Z\" fill=\"currentColor\"/><path d=\"M50 0 H100 V50 H50 Z\" fill=\"#00f\"/>", "")
			assert cpx(mixed, 25, 25) == "255 0 0 255" && cpx(mixed, 75, 25) == "0 0 255 255"
			// No fill anywhere up to the root: the foreground; black without one.
			let unset = try tinted("<rect width=\"100\" height=\"100\"/>", "")
			assert cpx(unset, 50, 50) == "255 0 0 255"
			let plain = new Canvas(100, 100)
			let black = try new SVG().picture(svg("<rect width=\"100\" height=\"100\"/>"))
			black.replay(plain)
			assert cpx(plain, 50, 50) == "0 0 0 255"
			// A fill inherited from a group, and an explicit stroke, stay as written.
			let grouped = try tinted("<g fill=\"#0f0\"><rect width=\"100\" height=\"100\"/></g>", "")
			assert cpx(grouped, 50, 50) == "0 255 0 255"
			let stroked = try tinted("<rect x=\"10\" y=\"10\" width=\"80\" height=\"80\" fill=\"none\" stroke=\"#00f\" stroke-width=\"20\"/>", "")
			assert cpx(stroked, 10, 50) == "0 0 255 255" && cpx(stroked, 50, 50) == "0 0 0 0"
			// A gradient stop that says currentColor; a document with a colour of its own.
			let gradient = try tinted("<defs><linearGradient id=\"g\"><stop offset=\"0\" stop-color=\"currentColor\"/><stop offset=\"1\" stop-color=\"currentColor\"/></linearGradient></defs><rect width=\"100\" height=\"100\" fill=\"url(#g)\"/>", "")
			assert cpx(gradient, 50, 50) == "255 0 0 255"
			let coloured = try tinted("<rect width=\"100\" height=\"100\" fill=\"currentColor\"/>", "color=\"#00f\"")
			assert cpx(coloured, 50, 50) == "0 0 255 255"
		}

		@test()
		def recognisesAndSizesDocuments() !none {
			let codec = new SVG()
			assert codec.matchSignature(new bytes.Buffer("<?xml version=\"1.0\"?>\n<svg>".bytes())) // after an XML declaration
			assert !codec.matchSignature(new bytes.Buffer("<html><body/></html>".bytes())) // not SVG
			let info = try codec.info(svg("", "width=\"40\" viewBox=\"0 0 100 50\""))
			assert info.size.width == 40.0 && info.size.height == 20.0 // the missing height from the view box
			assert codec.decode(svg("", "")) is Image // no size at all: 100 by 100
			assert codec.decode("<html/>".bytes()) is error // not an SVG document
		}

		@test()
		def drawsShapesFillsAndStrokes() !none {
			let img = try new SVG().decode(svg("<rect x=\"10\" y=\"10\" width=\"30\" height=\"30\" fill=\"#00f\"/><circle cx=\"75\" cy=\"25\" r=\"10\" fill=\"none\" stroke=\"red\" stroke-width=\"4\"/>"))
			assert img.size().width == 100 // the view box's size
			assert px(img, 20, 20) == "0 0 255 255" // inside the rectangle
			assert px(img, 75, 15) == "255 0 0 255" // on the circle's stroke
			assert px(img, 75, 25) == "0 0 0 0" // its unfilled middle
		}

		@test()
		def scalesToARequestedSize() !none {
			let img = try new SVG().decode(svg("<rect width=\"50\" height=\"100\" fill=\"lime\"/>"), 200)
			assert img.size().width == 200 && img.size().height == 200 // the height kept in proportion
			assert px(img, 90, 100) == "0 255 0 255" && px(img, 110, 100) == "0 0 0 0" // scaled two times
		}

		@test()
		def appliesStylesUseAndGradients() !none {
			let doc = "<style>.a \{ fill: #f00 } #b \{ fill: #0f0 }</style><defs><rect id=\"r\" width=\"10\" height=\"10\"/>"
				+"<linearGradient id=\"g\"><stop offset=\"0\" stop-color=\"#000\"/><stop offset=\"1\" stop-color=\"#fff\"/></linearGradient></defs>"
				+"<use href=\"#r\" class=\"a\"/><rect id=\"b\" x=\"20\" width=\"10\" height=\"10\" class=\"a\"/><rect y=\"50\" width=\"100\" height=\"10\" fill=\"url(#g)\"/>"
			let img = try new SVG().decode(svg(doc))
			assert px(img, 5, 5) == "255 0 0 255" // a used element inherits the use's class style
			assert px(img, 25, 5) == "0 255 0 255" // an id rule beats a class rule
			let left = img.raw()[(55 * img.stride()) + 4 * 4]
			let right = img.raw()[(55 * img.stride()) + 95 * 4]
			assert left < 40 && right > 215 // the gradient runs dark to light
		}

		@test()
		def clipsAndRecords() !none {
			let doc = "<clipPath id=\"c\"><circle cx=\"50\" cy=\"50\" r=\"20\"/></clipPath><rect width=\"100\" height=\"100\" fill=\"#00f\" clip-path=\"url(#c)\"/>"
			let img = try new SVG().decode(svg(doc))
			assert px(img, 50, 50) == "0 0 255 255" && px(img, 5, 5) == "0 0 0 0" // inside and outside the clip
			let picture = try new SVG().picture(svg(doc))
			let cv = new Canvas(100, 100)
			picture.replay(cv)
			assert cv.pixels[(50 * 100 + 50) * 4 + 2] == 255 && cv.pixels[(5 * 100 + 5) * 4 + 3] == 0 // the picture draws the same
		}

		@test()
		def appliesFilters() !none {
			let doc = "<filter id=\"f\"><feFlood flood-color=\"#0f0\"/><feComposite in2=\"SourceAlpha\" operator=\"in\"/></filter>"
				+"<filter id=\"b\"><feGaussianBlur stdDeviation=\"4\"/></filter>"
				+"<rect x=\"10\" y=\"10\" width=\"30\" height=\"30\" fill=\"red\" filter=\"url(#f)\"/>"
				+"<rect x=\"60\" y=\"10\" width=\"30\" height=\"30\" fill=\"#00f\" filter=\"url(#b)\"/>"
				+"<rect x=\"10\" y=\"60\" width=\"30\" height=\"30\" fill=\"#f00\" style=\"filter: grayscale(1)\"/>"
			let img = try new SVG().decode(svg(doc))
			assert px(img, 25, 25) == "0 255 0 255" // the flood cut to the source's shape
			assert px(img, 5, 5) == "0 0 0 0" // nothing outside it
			let edge = img.raw()[10 * img.stride() + 60 * 4 + 3]
			assert edge > 0 && edge < 255 // the blur softens the corner
			let g = img.raw()[75 * img.stride() + 25 * 4]
			assert g == img.raw()[75 * img.stride() + 25 * 4 + 1] && g > 0 // grey from the CSS function
		}

		@test()
		def drawsText() !none {
			let img = try new SVG().decode(svg("<text x=\"10\" y=\"60\" font-size=\"40\" fill=\"#000\">IIII</text>"))
			let ink = 0
			for let y = 20; y < 65; y++ {
				for let x = 10; x < 90; x++ {
					if img.raw()[y * img.stride() + x * 4 + 3] > 128 {
						ink += 1
					}
				}
			}
			assert ink > 100 // glyphs from a system font
			assert px(img, 50, 90) == "0 0 0 0" // nothing below the baseline's descent
		}

		@test()
		def animatesAtATime() !none {
			let doc = svg("<rect width=\"20\" height=\"20\" fill=\"red\"><set attributeName=\"fill\" to=\"lime\" begin=\"1s\" fill=\"freeze\"/></rect>"
				+"<rect y=\"50\" width=\"10\" height=\"10\" fill=\"#00f\"><animate attributeName=\"x\" from=\"0\" to=\"80\" dur=\"8s\" fill=\"freeze\"/></rect>")
			let codec = new SVG()
			assert px(try codec.decode(doc), 5, 5) == "255 0 0 255" // before the set begins
			let later = try codec.decode(doc, 2s)
			assert px(later, 5, 5) == "0 255 0 255" // set, then frozen
			assert px(later, 25, 55) == "0 0 255 255" && px(later, 5, 55) == "0 0 0 0" // x = 20 at a quarter
			let end = try codec.decode(doc, 20s)
			assert px(end, 85, 55) == "0 0 255 255" // frozen at the last value
		}

		@test()
		def chainsSyncbasesAndRepeats() !none {
			let doc = svg("<rect width=\"10\" height=\"10\" fill=\"#00f\" visibility=\"hidden\">"
				+"<set id=\"a\" attributeName=\"visibility\" to=\"visible\" begin=\"0s; a.end + 1s\" dur=\"1s\"/></rect>"
				+"<rect x=\"50\" width=\"10\" height=\"10\" fill=\"#00f\"><animate attributeName=\"x\" values=\"50;80\" dur=\"1s\" repeatCount=\"3\" accumulate=\"sum\" calcMode=\"discrete\"/></rect>")
			let codec = new SVG()
			assert px(try codec.decode(doc, 500ms), 5, 5) == "0 0 255 255" // first interval
			assert px(try codec.decode(doc, 1500ms), 5, 5) == "0 0 0 0" // between intervals
			assert px(try codec.decode(doc, 2500ms), 5, 5) == "0 0 255 255" // begun again by its own end
			// The third iteration's second half: 80 + 2 * 80 = 240, off the view.
			let img = try codec.decode(doc, 2700ms)
			assert px(img, 55, 5) == "0 0 0 0" && px(img, 85, 5) == "0 0 0 0"
		}

		@test()
		def movesAndTurnsAlongPaths() !none {
			let doc = svg("<rect x=\"-5\" y=\"-5\" width=\"10\" height=\"10\" fill=\"#00f\"><animateMotion path=\"M 10 10 H 90\" dur=\"4s\" fill=\"freeze\"/></rect>"
				+"<g transform=\"translate(50 70)\"><rect width=\"20\" height=\"4\" fill=\"red\"><animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"90\" dur=\"2s\" fill=\"freeze\"/></rect></g>"
				+"<circle cx=\"20\" cy=\"90\" r=\"5\" fill=\"lime\"><discard begin=\"1s\"/></circle>")
			let codec = new SVG()
			let start = try codec.decode(doc)
			assert px(start, 10, 10) == "0 0 255 255" && px(start, 60, 72) == "255 0 0 255" && px(start, 20, 90) == "0 255 0 255"
			let mid = try codec.decode(doc, 2s)
			assert px(mid, 50, 10) == "0 0 255 255" && px(mid, 10, 10) == "0 0 0 0" // halfway along
			assert px(mid, 48, 80) == "255 0 0 255" && px(mid, 60, 72) == "0 0 0 0" // turned a quarter
			assert px(mid, 20, 90) == "0 0 0 0" // discarded
		}

		@test()
		def animatesClassesAndKeepsImportantDeclarations() !none {
			let doc = svg("<style>.on \{ fill: lime } rect \{ stroke: none !important }</style>"
				+"<rect width=\"20\" height=\"20\" fill=\"red\" stroke-width=\"8\"><set attributeName=\"class\" to=\"on\" begin=\"1s\"/><set attributeName=\"stroke\" to=\"#00f\"/></rect>")
			let codec = new SVG()
			assert px(try codec.decode(doc), 10, 10) == "255 0 0 255"
			let img = try codec.decode(doc, 2s)
			assert px(img, 10, 10) == "0 255 0 255" // the sheet rule the new class matches
			assert px(img, 21, 10) == "0 0 0 0" // stroke stays none: important beats animation
			let pic = try codec.picture(doc, 2s)
			let cv = new Canvas(100, 100)
			pic.replay(cv)
			assert cv.pixels[(10 * 100 + 10) * 4 + 1] == 255 // the picture shows the same moment
		}
	}
}
