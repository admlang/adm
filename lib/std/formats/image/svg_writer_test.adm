partial module std.formats.image {
	use (
		std.testing
		std.gfx::CircleMask
		std.gfx.canvas::*
		std.gfx.color::(BlendMode, Color, RGBA)
		std.math.geom::(Circle, Line, LineCap, Path, Point, Rect, StrokeStyle, Transform2D, Vec2)
		std.units::(Percent, Pixels)
	)

	check "SVG writer" {
		def rgba(r int, g int, b int, a int = 255) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		def square() Rect {
			return Rect{left: 10.0, top: 10.0, right: 50.0, bottom: 40.0}
		}

		@test()
		def shapesBecomePaths() {
			let svg = record((p Painter) => {
				p.fill(square(), rgba(255, 0, 0))
				p.translate(5.0, 0.0)
				p.stroke(new Line(new Point(0.0, 60.0), new Point(80.0, 60.0)), rgba(0, 0, 255, 128), StrokeStyle{width: 4(px), cap: LineCap.Round, dash: [6(px), 2(px)]})
				p.stroke(new Path().circle(new Point(30.0, 30.0), 10.0), rgba(0, 0, 0), StrokeStyle{width: 1(px), fixedWidth: true})
			}).svg()
			assert svg.startsWith("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"85\" height=\"62\"")
			assert svg.contains("fill=\"#FF0000\"") && svg.contains("fill-rule=\"nonzero\"")
			assert svg.contains("transform=\"matrix(1 0 0 1 5 0)\"")
			assert svg.contains("stroke=\"#0000FF\" stroke-opacity=\"0.501961\"") && svg.contains("stroke-linecap=\"round\"") && svg.contains("stroke-dasharray=\"6 2\"")
			assert svg.contains("vector-effect=\"non-scaling-stroke\"")
			assert !svg.contains("data:image/png")
		}

		@test()
		def gradientsKeepTheirLook() {
			let stops = [ColorStop{offset:0(%), color:rgba(255, 0, 0)}, ColorStop{offset:100(%), color:rgba(0, 0, 255)}]
			let plain = record((p Painter) => p.fill(square(), new LinearGradient(new Point(10.0, 0.0), new Point(50.0, 0.0), stops, space = ColorSpace.SRGB))).svg()
			assert plain.contains("<linearGradient") && plain.split("<stop ").len() == 3
			// OKLab has no SVG form: the canvas's own colours, closely sampled.
			let lab = record((p Painter) => p.fill(square(), new LinearGradient(new Point(10.0, 0.0), new Point(50.0, 0.0), stops))).svg()
			assert lab.split("<stop ").len() == 66
			let focal = record((p Painter) => p.fill(square(), new RadialGradient(new Point(30.0, 25.0), 20.0, stops, focus = new Point(25.0, 20.0), spread = Spread.Reflect))).svg()
			assert focal.contains("fx=\"25\" fy=\"20\"") && focal.contains("spreadMethod=\"reflect\"")
			// Conic gradients are pixels.
			let conic = record((p Painter) => p.fill(square(), new ConicGradient(new Point(30.0, 25.0), 0.0, stops))).svg()
			assert conic.contains("<image") && conic.contains("data:image/png;base64,") && !conic.contains("<path")
		}

		@test()
		def picturePatternsStayVectors() {
			let cell = record((p Painter) => p.fill(new Path().circle(new Point(10.0, 10.0), 3.0), rgba(0, 128, 0)))
			let svg = record((p Painter) => p.fill(square(), new Pattern(cell, tile = Rect{left: 5.0, top: 5.0, right: 15.0, bottom: 15.0}))).svg()
			assert svg.contains("<pattern ") && svg.contains("x=\"5\" y=\"5\" width=\"10\" height=\"10\"")
			// The cell's circle, moved to the tile's corner, inside the pattern.
			let inside = svg.split("<pattern ")[1].split("</pattern>")[0]
			assert inside.contains("<path") && inside.contains("fill=\"#008000\"") && inside.contains("matrix(1 0 0 1 -5 -5)")
			assert svg.contains("fill=\"url(#") && !svg.contains("data:image/png")
		}

		@test()
		def atlasSpritesShareTheirImages() {
			let atlas = new Canvas(4, 2)
			atlas.fill(Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 2.0}, rgba(255, 0, 0))
			let tile = Rect{left: 0.0, top: 0.0, right: 2.0, bottom: 2.0}
			let svg = record((p Painter) => p.drawAtlas(atlas, [tile, tile, tile], [new Transform2D(tx = 0.0), new Transform2D(tx = 10.0), new Transform2D(tx = 20.0)], [rgba(255, 255, 255), rgba(255, 255, 255), rgba(0, 128, 255)])).svg()
			// One image for the three uses of the same tile, one filter for the tint.
			assert svg.split("<image ").len() == 2 && svg.split("<use ").len() == 4
			assert svg.split("<feColorMatrix").len() == 2 && svg.contains("filter=\"url(#")
		}

		@test()
		def clipsWrapWhatFollows() {
			let svg = record((p Painter) => {
				p.save()
				p.clip(new Path().circle(new Point(30.0, 30.0), 20.0))
				p.fill(square(), rgba(0, 128, 0))
				p.restore()
				p.fill(Rect{left: 60.0, top: 0.0, right: 70.0, bottom: 10.0}, rgba(0, 0, 0))
				p.clip(new CircleMask(new Circle(new Point(20.0, 20.0), 5.0)))
				p.fill(square(), rgba(0, 0, 0))
			}).svg()
			assert svg.contains("<clipPath id=") && svg.contains("<g clip-path=\"url(#")
			// The second rect is outside the clip's <g>: after its closing tag.
			let closing = svg.indexOf("</g>")
			assert closing > 0 && svg.indexOf("M60 0") > closing
			assert svg.contains("style=\"mask-type:alpha\"") && svg.contains("<g mask=\"url(#")
		}

		@test()
		def operatorsAndBlendsSvgLacksArePixels() {
			let multiply = record((p Painter) => {
				p.fill(square(), rgba(200, 200, 0))
				p.setBlend(BlendMode.Multiply)
				p.fill(square(), rgba(0, 200, 200))
			}).svg()
			assert multiply.contains("mix-blend-mode:multiply") && !multiply.contains("data:image/png")
			let burn = record((p Painter) => {
				p.fill(square(), rgba(200, 200, 0))
				p.setBlend(BlendMode.LinearBurn)
				p.fill(square(), rgba(0, 200, 200))
			}).svg()
			assert burn.contains("data:image/png") && burn.contains("<mask")
			// Erasing: what was drawn is masked out where the patch goes.
			let erased = record((p Painter) => {
				p.fill(square(), rgba(200, 0, 0))
				p.setComposite(Composite.DestinationOut)
				p.fill(new Circle(new Point(30.0, 25.0), 8.0), rgba(0, 0, 0))
				p.setComposite(Composite.SourceOver)
				p.fill(Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 4.0}, rgba(0, 0, 255))
			}).svg()
			assert erased.contains("fill=\"#000000\"") && erased.contains("<g mask=\"url(#") && erased.contains("data:image/png") && erased.contains("fill=\"#0000FF\"")
		}

		@test()
		def effectsBecomeFilters() {
			let shadow = record((p Painter) => {
				p.beginGroup(effects = [DropShadow{offset:new Vec2(3.0, 4.0), blur:6(px)}, InnerShadow{}])
				p.fill(square(), rgba(240, 120, 40))
				p.endGroup()
			}).svg()
			assert shadow.contains("<filter") && shadow.contains("<feGaussianBlur") && shadow.contains("<use href=\"#g") && !shadow.contains("data:image/png")
			assert shadow.contains("dx=\"3\" dy=\"4\"") && shadow.contains("stdDeviation=\"3\"") && shadow.contains("operator=\"atop\"")
			// Plain group opacity is a <g>.
			let faded = record((p Painter) => {
				p.beginGroup(50(%))
				p.fill(square(), rgba(0, 0, 0))
				p.endGroup()
			}).svg()
			assert faded.contains("<g opacity=\"0.5\"") && !faded.contains("<filter")
			// Outlines are pixels.
			let outlined = record((p Painter) => {
				p.beginGroup(effects = [Outline{width:3(px)}])
				p.fill(square(), rgba(0, 0, 0))
				p.endGroup()
			}).svg()
			assert outlined.contains("data:image/png") && !outlined.contains("<filter")
		}

		@test()
		def clearStartsOver() {
			let svg = record((p Painter) => {
				p.fill(square(), rgba(255, 0, 0))
				p.clear(rgba(255, 255, 255))
				p.fill(square(), rgba(0, 255, 0))
			}).svg()
			assert !svg.contains("#FF0000") && svg.contains("fill=\"#FFFFFF\"") && svg.contains("#00FF00")
		}
	}
}
