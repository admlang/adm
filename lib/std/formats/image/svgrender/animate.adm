// SMIL animation (SVG 1.1 §19, SMIL 3 timing): the values `animate`,
// `set`, `animateColor`, `animateTransform` and `animateMotion` give their
// targets at one moment, written into the document before it is drawn.
// Events never happen in a still document, so begins and ends that wait on
// one stay unresolved.

internal std partial module std.formats.image.svgrender {
	use (
		std.math::(sqrt, atan2, Pi)
		std.math.geom::(Path)
		std.gfx.color::(Color, RGBA)
	)

	// A time no document reaches: the end of what never ends.
	internal const forever = 1.0e18

	// Calculation modes, from `calcMode`.
	internal enum CalcMode {
		Discrete
		Linear
		Paced
		Spline
	}

	// How an animation gives its values, from the attributes it carries.
	internal enum ValueForm {
		List   // values
		FromTo // from and to
		FromBy // from and by
		By     // by alone: from zero, added to the underlying value
		To     // to alone: from the underlying value
		Set    // the set element's to
	}

	// Kinds of animated values.
	internal enum ValueKind {
		Text    // only discrete
		Numbers // a list of numbers, each with its unit
		Colour  // red, green, blue (0–255) and alpha (0–1)
		PathData
	}

	// One animation element: its target, timing and the moment chosen.
	type Anim {
		node        Node
		target      Node
		name        string
		isProp      bool
		order       int
		// Simple duration in seconds; forever when indefinite or unset.
		dur         float   = 1.0e18
		// -1 when unset; forever for indefinite.
		repeatCount float   = -1.0
		repeatDur   float   = -1.0
		minDur      float   = 0.0
		maxDur      float   = 1.0e18
		freeze      bool
		restart     string  = "always"
		// Intervals in seconds, ends exclusive, and where each one stops
		// playing: before its end when `min` holds it in its fill state.
		starts      float[]
		ends        float[]
		plays       float[]
		// The interval the moment falls in or after, and the time spent in it.
		start       float
		elapsed     float
		frozen      bool

		def new(node Node, target Node, name string, order int) {
			self.node = node
			self.target = target
			self.name = name
			self.order = order
		}
	}

	// An animated value read from text.
	internal struct AValue {
		kind  ValueKind
		text  string
		nums  float[]
		units string[]
		// Path data with every number replaced by `#`.
		shape string
	}

	// The animations of one document and the tree they work on.
	type Animator {
		doc      Document
		anims    Anim[]
		byId     map<string, Anim>
		// Elements by serial, and each one's parent serial (-1 at the root).
		nodes    Node[]
		parentOf int[]
		// discard elements: each removes its target (`href`, else its
		// parent) once its begin time has passed.
		discards Node[]

		def new(doc Document) {
			self.doc = doc
			byId = map<string, Anim>{}
		}

		def walk(n Node, parent int) {
			return when n.isText
			n.serial = nodes.len()
			nodes.push(n)
			parentOf.push(parent)
			read(n, parent) when n.tag := "animate" || "set" || "animateColor" || "animateTransform" || "animateMotion"
			discards.push(n) when n.tag == "discard"
			for let (_, c) in n.children {
				walk(c, n.serial)
			}
		}

		// Reads an animation element: its target (`href`, else the parent),
		// the attribute it changes, and its timing attributes.
		def read(n Node, parent int) {
			let href = n.attr("href")
			let target ?Node = none
			if href is string {
				target = doc.resolve(href)
			} else if parent >= 0 {
				target = nodes[parent]
			}
			return when target is none
			let name = n.attrOr("attributeName", "").trim()
			name = "href" when name == "xlink:href"
			if n.tag == "animateMotion" {
				name = ""
			} else {
				return when name == ""
			}
			let a = new Anim(n, target, name, anims.len())
			a.isProp = name != "" && (isPresentationAttribute(name, target.tag) || n.attrOr("attributeType", "").trim() == "CSS")
			let dur = clockValue(n.attrOr("dur", ""))
			a.dur = dur when dur is float && dur > 0.0
			let count = n.attrOr("repeatCount", "").trim()
			if count == "indefinite" {
				a.repeatCount = forever
			} else {
				let c = parseNumber(count)
				a.repeatCount = c when c is float && c > 0.0
			}
			let rdur = n.attrOr("repeatDur", "").trim()
			if rdur == "indefinite" {
				a.repeatDur = forever
			} else {
				let d = clockValue(rdur)
				a.repeatDur = d when d is float && d > 0.0
			}
			let least = clockValue(n.attrOr("min", ""))
			a.minDur = least when least is float && least >= 0.0
			let most = clockValue(n.attrOr("max", ""))
			a.maxDur = most when most is float && most > 0.0
			a.freeze = n.attrOr("fill", "").trim() == "freeze"
			let restart = n.attrOr("restart", "").trim()
			a.restart = restart when restart := "always" || "whenNotActive" || "never"
			anims.push(a)
			let id = n.attrOr("id", "")
			byId[id] = a when id != "" && !byId.hasKey(id)
		}

		// Rebuilds the animation's intervals (SMIL 3 §5.4.5) from the
		// intervals syncbases have so far, and reports whether they changed.
		// Each begin up to `horizon` starts one unless it falls inside the
		// one before (which `restart="always"` cuts short there instead);
		// each ends at the first end at or after its begin, bounded by its
		// active duration.
		def intervalsOf(a Anim, horizon float) bool {
			let starts float[]
			let ends float[]
			let plays float[]
			let (begins, _) = times(a.node.attrOr("begin", "0"), "0")
			let hasEnd = a.node.has("end")
			let (endTimes, endOpen) = times(a.node.attrOr("end", ""), "")
			begins.sort((x float, y float) => x < y)
			endTimes.sort((x float, y float) => x < y)
			for let (_, b) in begins {
				break when b > horizon
				let k = starts.len()
				if k > 0 {
					break when a.restart == "never"
					if b < ends[k - 1] {
						continue unless a.restart == "always" && b > starts[k - 1]
						ends[k - 1] = b
						plays[k - 1] = plays[k - 1].min(b)
					}
				}
				let e = forever
				let resolved = false
				for let (_, x) in endTimes {
					if x >= b {
						e = x
						resolved = true
						break
					}
				}
				// Every end lies before this begin and none waits on an
				// event: no interval begins any more.
				break when hasEnd && !resolved && endTimes.len() > 0 && !endOpen
				let (played, d) = activeDuration(a, b, e, resolved)
				starts.push(b)
				ends.push(b + d)
				plays.push(b + played)
			}
			let same = starts.len() == a.starts.len()
			for let i = 0; same && i < starts.len(); i++ {
				same = starts[i] == a.starts[i] && ends[i] == a.ends[i]
			}
			a.starts = starts
			a.ends = ends
			a.plays = plays
			return !same
		}

		// The resolved times of a begin or end list, and whether it holds
		// one that stays unresolved (events, `indefinite`, wallclock).
		def times(text string, otherwise string) (float[], bool) {
			let out float[]
			let open = false
			let list = text.trim() == "" ?? (otherwise, text)
			for let (_, raw) in list.split(";") {
				let item = raw.trim()
				continue when item == ""
				let b = item.bytes()
				let c = b[0]
				if (c := byte('+') || byte('-') || byte('.')) || (c >= byte('0') && c <= byte('9')) {
					let v = signedClock(item)
					out.push(v) when v is float
					continue
				}
				if item == "indefinite" || item.startsWith("wallclock(") || item.startsWith("accessKey(") {
					open = true
					continue
				}
				// id.begin, id.end, id.repeat(n), each with an offset; any other
				// form is an event.
				let dot = -1
				for let i = 0; i < b.len(); i++ {
					if b[i] == byte('\\') {
						i++
					} else if b[i] == byte('.') {
						dot = i
						break
					}
				}
				if dot <= 0 {
					open = true
					continue
				}
				let id = string(b[:dot]).replace("\\.", ".")
				let rest = b[dot + 1:]
				let w = 0
				for w < rest.len() && ((rest[w] >= byte('a') && rest[w] <= byte('z')) || (rest[w] >= byte('A') && rest[w] <= byte('Z'))) {
					w++
				}
				let event = string(rest[:w])
				let iteration = 0.0
				if event == "repeat" && w < rest.len() && rest[w] == byte('(') {
					let close = w
					for close < rest.len() && rest[close] != byte(')') {
						close++
					}
					let n = parseNumber(string(rest[w + 1:close]))
					if n is none || close >= rest.len() {
						open = true
						continue
					}
					iteration = n
					w = close + 1
				}
				let other = byId.get(id)
				if other is none || !(event := "begin" || "end" || "repeat") {
					open = true
					continue
				}
				let offsetText = string(rest[w:]).trim()
				let offset = 0.0
				if offsetText != "" {
					let o = signedClock(offsetText)
					if o is none {
						open = true
						continue
					}
					offset = o
				}
				for let i = 0; i < other.starts.len(); i++ {
					if event == "begin" {
						out.push(other.starts[i] + offset)
					} else if event == "end" {
						out.push(other.ends[i] + offset) when other.ends[i] < forever
					} else {
						let t = other.starts[i] + iteration * other.dur
						out.push(t + offset) when other.dur < forever && t < other.ends[i]
					}
				}
			}
			return (out, open)
		}

		// Picks the interval `time` falls in, or the last one before it when
		// the animation freezes. False when the animation has no effect then.
		def pick(a Anim, time float) bool {
			let k = -1
			for let i = 0; i < a.starts.len(); i++ {
				k = i when a.starts[i] <= time
			}
			return false when k < 0
			a.start = a.starts[k]
			if time < a.plays[k] {
				a.elapsed = time - a.start
				a.frozen = false
				return true
			}
			// Past its playing time, still active under `min`, or ended.
			return false unless a.freeze
			a.elapsed = a.plays[k] - a.start
			a.frozen = true
			return true
		}

		// The underlying value of what the animation changes: the target's
		// property (inherited from its ancestors, or the initial value) or
		// attribute, with what lower animations already did to it.
		def underlying(a Anim) string {
			return a.target.attrOr(a.name, "") unless a.isProp
			return propertyOf(a.target, a.name)
		}

		def propertyOf(target Node, name string) string {
			let n = target
			for {
				let v = n.props.get(name)
				if v is string {
					return v unless v.trim() == "inherit"
				} else if !isInherited(name) {
					break
				}
				let p = parentOf[n.serial]
				break when p < 0
				n = nodes[p]
			}
			return initialValue(name)
		}

		// Removes the targets of the discard elements whose begin time
		// has come (SVG 2 §19.4); their animations go with them.
		def discard(time float) {
			for let (_, d) in discards {
				let (begins, _) = times(d.attrOr("begin", "0"), "0")
				let due = false
				for let (_, b) in begins {
					due = true when b <= time
				}
				continue unless due
				let href = d.attr("href")
				let target ?Node = none
				if href is string {
					target = doc.resolve(href)
				} else if parentOf[d.serial] >= 0 {
					target = nodes[parentOf[d.serial]]
				}
				continue when target is none
				let parent = parentOf[target.serial]
				continue when parent < 0
				let kept Node[]
				for let (_, c) in nodes[parent].children {
					kept.push(c) unless !c.isText && c.serial == target.serial
				}
				nodes[parent].children = kept
				drop(target)
			}
		}

		// Forgets the animations inside a removed subtree.
		def drop(n Node) {
			return when n.isText
			let kept Anim[]
			for let (_, a) in anims {
				kept.push(a) unless a.node.serial == n.serial
			}
			anims = kept
			for let (_, c) in n.children {
				drop(c)
			}
		}

		// The value a property inherits from the node's parent.
		def inheritedOf(target Node, name string) string {
			let p = parentOf[target.serial]
			return initialValue(name) when p < 0
			return propertyOf(nodes[p], name)
		}

		// Writes the animated value. Animations sit above normal
		// declarations in the cascade and below important ones.
		def write(a Anim, value string) {
			return when a.isProp && a.target.important.indexOf(a.name) >= 0
			a.target.props[a.name] = value when a.isProp
			a.target.attrs[a.name] = value
		}

		def apply(a Anim) {
			let (iteration, p) = progress(a)
			if a.node.tag == "animateMotion" {
				applyMotion(a, iteration, p)
			} else if a.node.tag == "animateTransform" {
				applyTransform(a, iteration, p)
			} else {
				applyValue(a, iteration, p)
			}
		}

		// animate, set, animateColor: values read as numbers, colours or path
		// data where they all can be, else discrete text.
		def applyValue(a Anim, iteration float, p float) {
			let (texts, form) = valueTexts(a.node)
			return when texts.len() == 0
			let current = underlying(a)
			let fg = parseColor(propertyOf(a.target, "color"), new Color(RGBA{r: 0, g: 0, b: 0, a: 255}))
			let ink = fg is Color ?? (fg, new Color(RGBA{r: 0, g: 0, b: 0, a: 255}))
			let additive = a.node.attrOr("additive", "").trim() == "sum"
			let accumulate = a.node.attrOr("accumulate", "").trim() == "sum"
			let list string[]
			match form {
				case ValueForm.To:
					list = string[current, texts[0]]
					additive = false
					accumulate = false
				case ValueForm.By:
					list = string[texts[0], texts[0]]
					additive = true
				default:
					list = texts
			}
			if a.isProp {
				// `inherit` stands for the parent's value.
				for let i = 0; i < list.len(); i++ {
					list[i] = inheritedOf(a.target, a.name) when list[i].trim() == "inherit"
				}
			}
			let vals = parseValues(list, a.name, ink)
			if form == ValueForm.By {
				vals[0] = zeroOf(vals[1])
			} else if form == ValueForm.FromBy {
				let sum = addValues(vals[0], vals[1])
				return when sum is none
				vals[1] = sum
			}
			let kind = vals[0].kind
			let mode = form == ValueForm.Set ?? (CalcMode.Discrete, calcModeOf(a.node, CalcMode.Linear))
			mode = CalcMode.Discrete when kind == ValueKind.Text
			let (i, f, ok) = locate(a.node, mode, vals, p)
			return unless ok
			let v = mode == CalcMode.Discrete || f <= 0.0 ?? (vals[i], lerpValues(vals[i], vals[i + 1], f))
			if accumulate && iteration > 0.0 && kind != ValueKind.Text {
				let more = addValues(v, scaleValue(vals[vals.len() - 1], iteration))
				v = more when more is AValue
			}
			if additive && kind != ValueKind.Text {
				let under = parseValues(string[current, list[list.len() - 1]], a.name, ink)
				if under[0].kind == kind {
					let sum = addValues(under[0], v)
					v = sum when sum is AValue
				}
			}
			write(a, formatValue(v))
		}

		// animateTransform: a transform of its `type` whose parameters are
		// animated, replacing the underlying transform or applied after it.
		def applyTransform(a Anim, iteration float, p float) {
			let kind = a.node.attrOr("type", "translate").trim()
			let arity = transformArity(kind)
			return when arity == 0
			let (texts, form) = valueTexts(a.node)
			return when texts.len() == 0
			let additive = a.node.attrOr("additive", "").trim() == "sum"
			let accumulate = a.node.attrOr("accumulate", "").trim() == "sum"
			let vals AValue[]
			for let (_, t) in texts {
				let v = transformParams(kind, t)
				return when v is none
				vals.push(v)
			}
			match form {
				case ValueForm.To:
					vals = AValue[identityParams(kind), vals[0]]
					accumulate = false
				case ValueForm.By:
					// From the zero value: scale(0) too.
					vals = AValue[zeroOf(vals[0]), vals[0]]
					additive = true
				case ValueForm.FromBy:
					let sum = addValues(vals[0], vals[1])
					return when sum is none
					vals[1] = sum
				default:
			}
			let mode = form == ValueForm.Set ?? (CalcMode.Discrete, calcModeOf(a.node, CalcMode.Linear))
			let skew = kind := "skewX" || "skewY"
			let (i, f, ok) = locate(a.node, mode, vals, p, skew ?? (1, 2))
			return unless ok
			let v = mode == CalcMode.Discrete || f <= 0.0 ?? (vals[i], lerpValues(vals[i], vals[i + 1], f))
			// A paced rotation runs its angle and both centre coordinates
			// each at its own constant speed.
			v = pacedPerComponent(vals, p) when kind == "rotate" && mode == CalcMode.Paced && vals.len() > 1
			if accumulate && iteration > 0.0 {
				let more = addValues(v, scaleValue(vals[vals.len() - 1], iteration))
				v = more when more is AValue
			}
			let parts string[]
			for let (_, n) in v.nums {
				parts.push(formatNumber(n))
			}
			let text = "{kind}({parts.join(" ")})"
			let current = underlying(a)
			write(a, additive && current.trim() != "" ?? (current + " " + text, text))
		}

		// animateMotion: a translation along a path (`mpath`, `path`, or
		// the points of values/from/to/by), turned by `rotate`, added before
		// the target's own transform once every animation is applied.
		def applyMotion(a Anim, iteration float, p float) {
			let path = motionPath(a.node)
			let vals AValue[]
			if path is none {
				let (texts, form) = valueTexts(a.node)
				return when texts.len() == 0
				for let (_, t) in texts {
					let v = pointParams(t)
					return when v is none
					vals.push(v)
				}
				let origin = AValue{kind: ValueKind.Numbers, text: "", nums: float[0.0, 0.0], units: string["", ""], shape: ""}
				match form {
					case ValueForm.To, ValueForm.By:
						vals = AValue[origin, vals[0]]
					case ValueForm.FromBy:
						let sum = addValues(vals[0], vals[1])
						return when sum is none
						vals[1] = sum
					default:
				}
				// keyPoints measure distance along the polyline of the points.
				if a.node.has("keyPoints") {
					let line = new Path().moveTo(vals[0].nums[0], vals[0].nums[1])
					for let i = 1; i < vals.len(); i++ {
						line.lineTo(vals[i].nums[0], vals[i].nums[1])
					}
					path = line
				}
			}
			let x = 0.0
			let y = 0.0
			let heading = 0.0
			let sum = a.node.attrOr("accumulate", "").trim() == "sum" && iteration > 0.0
			if path is Path {
				// Along a path the time fraction is the distance fraction
				// unless keyPoints map one to the other, as browsers do.
				let total = path.length()
				let fraction = p
				let points = a.node.attr("keyPoints")
				if points is string {
					let keys AValue[]
					for let (_, t) in semicolonList(points) {
						let k = parseNumber(t)
						return when k is none || k < 0.0 || k > 1.0
						keys.push(AValue{kind: ValueKind.Numbers, text: t, nums: float[k], units: string[""], shape: ""})
					}
					let mode = calcModeOf(a.node, CalcMode.Paced)
					let (i, f, ok) = locate(a.node, mode == CalcMode.Paced ?? (CalcMode.Linear, mode), keys, p)
					return unless ok
					fraction = mode == CalcMode.Discrete || f <= 0.0 ?? (keys[i].nums[0], keys[i].nums[0] + (keys[i + 1].nums[0] - keys[i].nums[0]) * f)
				}
				let (pt, dir) = path.pointAt(fraction * total)
				x = pt.x
				y = pt.y
				heading = atan2(dir.y, dir.x) * 180.0 / Pi
				if sum {
					let (last, _) = path.pointAt(total)
					x += last.x * iteration
					y += last.y * iteration
				}
			} else {
				let (i, f, ok) = locate(a.node, calcModeOf(a.node, CalcMode.Paced), vals, p, 2)
				return unless ok
				let v = f <= 0.0 ?? (vals[i], lerpValues(vals[i], vals[i + 1], f))
				x = v.nums[0]
				y = v.nums[1]
				if vals.len() > 1 {
					let j = (i + 1).min(vals.len() - 1)
					let from = j > i ?? (i, i - 1)
					heading = atan2(vals[j].nums[1] - vals[from].nums[1], vals[j].nums[0] - vals[from].nums[0]) * 180.0 / Pi
				}
				if sum {
					let last = vals[vals.len() - 1]
					x += last.nums[0] * iteration
					y += last.nums[1] * iteration
				}
			}
			let rotate = a.node.attrOr("rotate", "0").trim()
			let angle = 0.0
			if rotate == "auto" {
				angle = heading
			} else if rotate == "auto-reverse" {
				angle = heading + 180.0
			} else {
				let r = parseNumber(rotate)
				angle = r when r is float
			}
			let text = "translate({formatNumber(x)} {formatNumber(y)}) rotate({formatNumber(angle)})"
			let additive = a.node.attrOr("additive", "").trim() == "sum"
			a.target.motion = additive && a.target.motion != "" ?? (a.target.motion + " " + text, text)
		}

		// The path an `mpath` child names, else the `path` attribute's.
		def motionPath(n Node) ?Path {
			for let (_, c) in n.elements() {
				if c.tag == "mpath" {
					let shape = doc.resolve(c.attrOr("href", ""))
					if shape is Node {
						let d = shape.attr("d")
						if d is string {
							let made = parsePathData(d, true)
							return made when made is Path
						}
					}
					break
				}
			}
			let d = n.attr("path")
			return none when d is none
			let made = parsePathData(d, true)
			return none when made is error
			return made
		}
	}

	// Applies the document's animations at `time` seconds from its start, in
	// SMIL's sandwich order: animations that began later sit on top, document
	// order breaking ties.
	def animate(doc Document, time float) {
		let m = new Animator(doc)
		m.walk(doc.root, -1)
		return when m.anims.len() == 0 && m.discards.len() == 0
		// Syncbases (an element's own end included) add begins and ends as
		// intervals appear, so the intervals are rebuilt until they settle;
		// begins past `time` never matter.
		for let pass = 0; pass < 4096; pass++ {
			let changed = false
			for let (_, a) in m.anims {
				changed = true when m.intervalsOf(a, time)
			}
			break unless changed
		}
		// Discards may wait on syncbases, so they come once intervals settle.
		m.discard(time)
		let active Anim[]
		for let (_, a) in m.anims {
			active.push(a) when m.pick(a, time)
		}
		active.sort((x Anim, y Anim) => x.start < y.start || (x.start == y.start && x.order < y.order))
		// Attributes the cascade reads change first, and the cascade runs
		// again before properties animate on what it gives.
		let restyled = false
		for let (_, a) in active {
			if !a.isProp && (a.name := "class" || "style") {
				m.apply(a)
				restyled = true
			}
		}
		recascade(doc) when restyled
		// `color` next: currentColor in the other values is its computed,
		// animated value.
		for let (_, a) in active {
			m.apply(a) when a.isProp && a.name == "color"
		}
		for let (_, a) in active {
			continue when a.isProp && a.name == "color"
			m.apply(a) unless !a.isProp && (a.name := "class" || "style")
		}
		for let (_, a) in active {
			let t = a.target
			continue when t.motion == "" || t.important.indexOf("transform") >= 0
			let own = t.props.get("transform")
			let moved = own is string && own.trim() != "" ?? (t.motion + " " + own, t.motion)
			t.props["transform"] = moved
			t.attrs["transform"] = moved
			t.motion = ""
		}
	}

	// Where the active time puts the animation: the repeat iteration and the
	// fraction of the simple duration. A frozen animation that ended on a
	// repeat boundary shows the end of its last iteration; an indefinite
	// simple duration stays at its start.
	internal def progress(a Anim) (float, float) {
		return (0.0, 0.0) when a.dur >= forever
		let iteration = (a.elapsed / a.dur).floor()
		let into = a.elapsed - iteration * a.dur
		return (iteration - 1.0, 1.0) when a.frozen && iteration > 0.0 && into <= a.dur * 1.0e-9
		return (iteration, (into / a.dur).clamp(0.0, 1.0))
	}

	// The active duration of an interval beginning at `b` (SMIL 3 §5.4.4):
	// the repeat-bounded simple duration, cut at the end time, then held
	// between min and max; and how much of it plays, the rest (where `min`
	// extends it past the repeat duration) spent in the fill state.
	internal def activeDuration(a Anim, b float, e float, resolved bool) (float, float) {
		let d = a.dur
		if a.repeatCount >= 0.0 || a.repeatDur >= 0.0 {
			d = forever
			if a.repeatCount >= 0.0 && a.dur < forever && a.repeatCount < forever {
				d = a.repeatCount * a.dur
			}
			d = d.min(a.repeatDur) when a.repeatDur >= 0.0
		}
		let repeated = d
		d = d.min(e - b) when resolved
		return (d, d) unless a.minDur <= a.maxDur
		let active = d.max(a.minDur).min(a.maxDur)
		// Within a min-extended interval the element plays on for its
		// repeat duration, whatever the end time said.
		return (repeated.min(active), active)
	}

	// The texts an animation interpolates and the form they came in.
	internal def valueTexts(n Node) (string[], ValueForm) {
		if n.tag == "set" {
			let to = n.attr("to")
			return (string[], ValueForm.Set) when to is none
			return (string[to], ValueForm.Set)
		}
		let values = n.attr("values")
		return (semicolonList(values), ValueForm.List) when values is string
		let from = n.attr("from")
		let to = n.attr("to")
		let by = n.attr("by")
		if from is string {
			return (string[from, to], ValueForm.FromTo) when to is string
			return (string[from, by], ValueForm.FromBy) when by is string
			return (string[], ValueForm.List)
		}
		return (string[to], ValueForm.To) when to is string
		return (string[by], ValueForm.By) when by is string
		return (string[], ValueForm.List)
	}

	// A semicolon-separated list, trimmed, an empty last item dropped.
	internal def semicolonList(text string) string[] {
		let out string[]
		let parts = text.split(";")
		for let i = 0; i < parts.len(); i++ {
			let t = parts[i].trim()
			continue when t == "" && i == parts.len() - 1
			out.push(t)
		}
		return out
	}

	internal def calcModeOf(n Node, otherwise CalcMode) CalcMode {
		match n.attrOr("calcMode", "").trim() {
			case "discrete":
				return CalcMode.Discrete
			case "linear":
				return CalcMode.Linear
			case "paced":
				return CalcMode.Paced
			case "spline":
				return CalcMode.Spline
		}
		return otherwise
	}

	// The segment and the fraction into it that the simple-time fraction `p`
	// falls on, by keyTimes, the even split, distances (paced) and
	// keySplines. Not ok when keyTimes or keySplines do not fit the values,
	// which disables the animation. `pacedWidth` is how many leading
	// numbers paced distances measure (2 for points, 1 for angles), 0 for
	// all.
	internal def locate(n Node, mode CalcMode, vals AValue[], p float, pacedWidth int = 0) (int, float, bool) {
		let count = vals.len()
		return (0, 0.0, true) when count <= 1
		let keyTimes float[]
		let kt = n.attr("keyTimes")
		if kt is string && mode != CalcMode.Paced {
			for let (_, t) in semicolonList(kt) {
				let k = parseNumber(t)
				return (0, 0.0, false) when k is none
				return (0, 0.0, false) when keyTimes.len() > 0 && k < keyTimes[keyTimes.len() - 1]
				keyTimes.push(k)
			}
			return (0, 0.0, false) when keyTimes.len() != count || keyTimes[0] != 0.0
			return (0, 0.0, false) when mode != CalcMode.Discrete && keyTimes[count - 1] != 1.0
		}
		return locateAt(n, mode, vals, keyTimes, p, pacedWidth)
	}

	internal def locateAt(n Node, mode CalcMode, vals AValue[], keyTimes float[], p float, pacedWidth int) (int, float, bool) {
		let count = vals.len()
		if mode == CalcMode.Discrete {
			if keyTimes.len() > 0 {
				let i = 0
				for let k = 0; k < count; k++ {
					i = k when keyTimes[k] <= p
				}
				return (i, 0.0, true)
			}
			return (int((p * float(count)).floor()).min(count - 1), 0.0, true)
		}
		if mode == CalcMode.Paced {
			let cum float[]
			cum.push(0.0)
			for let i = 1; i < count; i++ {
				let d = distance(vals[i - 1], vals[i], pacedWidth)
				return locateAt(n, CalcMode.Discrete, vals, keyTimes, p, pacedWidth) when d < 0.0
				cum.push(cum[i - 1] + d)
			}
			let total = cum[count - 1]
			return (0, 0.0, true) when total <= 0.0
			let goal = p * total
			let i = 0
			for i < count - 2 && goal >= cum[i + 1] {
				i++
			}
			let span = cum[i + 1] - cum[i]
			return (i, span > 0.0 ?? (((goal - cum[i]) / span).clamp(0.0, 1.0), 1.0), true)
		}
		let times = keyTimes
		if times.len() == 0 {
			for let k = 0; k < count; k++ {
				times.push(float(k) / float(count - 1))
			}
		}
		let i = 0
		for i < count - 2 && p >= times[i + 1] {
			i++
		}
		let span = times[i + 1] - times[i]
		let f = span > 0.0 ?? (((p - times[i]) / span).clamp(0.0, 1.0), 1.0)
		if mode == CalcMode.Spline {
			let splines = semicolonList(n.attrOr("keySplines", ""))
			return (0, 0.0, false) when splines.len() != count - 1
			let c = parseNumbers(splines[i])
			return (0, 0.0, false) when c is none || c.len() != 4
			for let (_, v) in c {
				return (0, 0.0, false) when v < 0.0 || v > 1.0
			}
			f = splineAt(c[0], c[1], c[2], c[3], f)
		}
		return (i, f, true)
	}

	// A clock value in seconds: full and partial clock values, timecounts
	// in h, min, s or ms (seconds when unmarked); none when the text is
	// not one.
	internal def clockValue(text string) ?float {
		let t = text.trim()
		return none when t == ""
		if t.contains(":") {
			let parts = t.split(":")
			return none when parts.len() > 3
			let total = 0.0
			for let (_, part) in parts {
				let v = parseNumber(part)
				return none when v is none || v < 0.0
				total = total * 60.0 + v
			}
			return total
		}
		let scale = 1.0
		let digits = t
		if t.endsWith("ms") {
			scale = 0.001
			digits = t[:t.len() - 2]
		} else if t.endsWith("min") {
			scale = 60.0
			digits = t[:t.len() - 3]
		} else if t.endsWith("h") {
			scale = 3600.0
			digits = t[:t.len() - 1]
		} else if t.endsWith("s") {
			digits = t[:t.len() - 1]
		}
		let v = parseNumber(digits)
		return none when v is none || v < 0.0
		return v * scale
	}

	// An offset: a clock value with an optional sign.
	internal def signedClock(text string) ?float {
		let t = text.trim()
		let sign = 1.0
		if t.startsWith("+") {
			t = t[1:]
		} else if t.startsWith("-") {
			sign = -1.0
			t = t[1:]
		}
		let v = clockValue(t)
		return none when v is none
		return sign * v
	}

	// A property's initial value, the underlying value of an animation of
	// a property nothing sets.
	internal def initialValue(name string) string {
		return "black" when name := "fill" || "color" || "stop-color" || "flood-color"
		return "white" when name == "lighting-color"
		return "1" when name := "opacity" || "fill-opacity" || "stroke-opacity" || "stop-opacity" || "flood-opacity" || "stroke-width"
		return "4" when name == "stroke-miterlimit"
		return "visible" when name == "visibility"
		return "inline" when name == "display"
		return "medium" when name == "font-size"
		return "none" when name := "stroke" || "clip-path" || "mask" || "filter" || "marker-start" || "marker-mid" || "marker-end" || "stroke-dasharray"
		return "" when name == "transform"
		return "0"
	}

	internal def isColourName(name string) bool {
		return name := "fill" || "stroke" || "color" || "stop-color" || "flood-color" || "lighting-color"
	}

	// The texts as values of one kind: path data for `d` when every path
	// has the same commands, colours for colour properties, number lists
	// whose units agree (absolute lengths counted in px), else text.
	internal def parseValues(list string[], name string, current Color) AValue[] {
		let out AValue[]
		if name == "d" {
			let mixed = false
			for let (_, t) in list {
				let v = pathValue(t)
				return textValues(list) when v is none || (out.len() > 0 && v.shape.upper() != out[0].shape.upper())
				mixed = true when out.len() > 0 && v.shape != out[0].shape
				out.push(v)
			}
			return out unless mixed
			// Commands that differ only in being relative interpolate in
			// absolute coordinates.
			let absolute AValue[]
			for let (_, v) in out {
				absolute.push(absolutePath(v))
			}
			return absolute
		}
		if isColourName(name) {
			for let (_, t) in list {
				let c = parseColor(t, current)
				return textValues(list) when c is none
				out.push(AValue{kind: ValueKind.Colour, text: t, nums: float[float(c.red), float(c.green), float(c.blue), float(c.alpha) / 255.0], units: string[], shape: ""})
			}
			return out
		}
		for let (_, t) in list {
			let v = numbersValue(t)
			return textValues(list) when v is none || (out.len() > 0 && v.nums.len() != out[0].nums.len())
			out.push(v)
		}
		return out when unitsAgree(out)
		let absolute AValue[]
		for let (_, v) in out {
			absolute.push(inPixels(v))
		}
		return absolute when unitsAgree(absolute)
		return textValues(list)
	}

	internal def textValues(list string[]) AValue[] {
		let out AValue[]
		for let (_, t) in list {
			out.push(AValue{kind: ValueKind.Text, text: t, nums: float[], units: string[], shape: ""})
		}
		return out
	}

	internal def unitsAgree(vals AValue[]) bool {
		for let (_, v) in vals {
			for let i = 0; i < v.units.len(); i++ {
				return false when v.units[i] != vals[0].units[i]
			}
		}
		return true
	}

	// Absolute lengths in px, left unmarked.
	internal def inPixels(v AValue) AValue {
		let nums float[]
		let units string[]
		for let i = 0; i < v.nums.len(); i++ {
			let scale = 0.0
			match v.units[i] {
				case "px":
					scale = 1.0
				case "in":
					scale = 96.0
				case "cm":
					scale = 96.0 / 2.54
				case "mm":
					scale = 96.0 / 25.4
				case "q":
					scale = 96.0 / 101.6
				case "pt":
					scale = 4.0 / 3.0
				case "pc":
					scale = 16.0
			}
			nums.push(scale > 0.0 ?? (v.nums[i] * scale, v.nums[i]))
			units.push(scale > 0.0 ?? ("", v.units[i]))
		}
		return AValue{kind: v.kind, text: v.text, nums: nums, units: units, shape: v.shape}
	}

	// Numbers separated by white space or commas, each with an optional
	// unit; none when the text holds anything else.
	internal def numbersValue(t string) ?AValue {
		let b = t.bytes()
		let nums float[]
		let units string[]
		let at = 0
		for {
			for at < b.len() && (b[at] := byte(' ') || byte('\t') || byte('\n') || byte('\r') || byte(',')) {
				at++
			}
			break when at >= b.len()
			let end = numberEnd(b, at)
			return none when end == at
			let v = parseFloat<float>(string(b[at:end]))
			return none when v is error
			let u = end
			for u < b.len() && ((b[u] >= byte('a') && b[u] <= byte('z')) || (b[u] >= byte('A') && b[u] <= byte('Z')) || b[u] == byte('%')) {
				u++
			}
			let unit = string(b[end:u]).lower()
			return none unless unit := "" || "px" || "%" || "em" || "ex" || "rem" || "ch" || "vw" || "vh" || "vmin" || "vmax" || "in" || "cm" || "mm" || "q" || "pt" || "pc" || "deg" || "rad" || "grad" || "turn"
			nums.push(v)
			units.push(unit)
			at = u
		}
		return none when nums.len() == 0
		return AValue{kind: ValueKind.Numbers, text: t, nums: nums, units: units, shape: ""}
	}

	// Path data as its command letters with `#` for each number (arc flags
	// included, read as one digit each); none when it holds anything else.
	internal def pathValue(t string) ?AValue {
		let b = t.bytes()
		let nums float[]
		let shape = ""
		let command = byte(' ')
		let arg = 0
		let at = 0
		for {
			for at < b.len() && (b[at] := byte(' ') || byte('\t') || byte('\n') || byte('\r') || byte(',')) {
				at++
			}
			break when at >= b.len()
			let c = b[at]
			if (c >= byte('a') && c <= byte('z')) || (c >= byte('A') && c <= byte('Z')) {
				return none unless string(b[at:at + 1]) := "M" || "m" || "L" || "l" || "H" || "h" || "V" || "v" || "C" || "c" || "S" || "s" || "Q" || "q" || "T" || "t" || "A" || "a" || "Z" || "z"
				shape += string(b[at:at + 1])
				command = c
				arg = 0
				at++
				continue
			}
			if (command := byte('A') || byte('a')) && (arg % 7 := 3 || 4) {
				return none unless c := byte('0') || byte('1')
				nums.push(c == byte('1') ?? (1.0, 0.0))
				shape += "#"
				arg++
				at++
				continue
			}
			let end = numberEnd(b, at)
			return none when end == at
			let v = parseFloat<float>(string(b[at:end]))
			return none when v is error
			nums.push(v)
			shape += "#"
			arg++
			at = end
		}
		return AValue{kind: ValueKind.PathData, text: t, nums: nums, units: string[], shape: shape}
	}

	internal def formatValue(v AValue) string {
		match v.kind {
			case ValueKind.Text:
				return v.text
			case ValueKind.Colour:
				let r = v.nums[0].clamp(0.0, 255.0).round()
				let g = v.nums[1].clamp(0.0, 255.0).round()
				let bl = v.nums[2].clamp(0.0, 255.0).round()
				let al = v.nums[3].clamp(0.0, 1.0)
				return "rgba({formatNumber(r)}, {formatNumber(g)}, {formatNumber(bl)}, {formatNumber(al)})"
			case ValueKind.PathData:
				let parts string[]
				let k = 0
				let command = ""
				let arg = 0
				for let (_, ch) in v.shape.bytes() {
					if ch == byte('#') {
						let n = v.nums[k]
						let flag = (command := "A" || "a") && (arg % 7 := 3 || 4)
						parts.push(flag ?? (n != 0.0 ?? ("1", "0"), formatNumber(n)))
						k++
						arg++
					} else {
						command = string(byte[ch])
						arg = 0
						parts.push(command)
					}
				}
				return parts.join(" ")
			default:
				let parts string[]
				for let i = 0; i < v.nums.len(); i++ {
					parts.push(formatNumber(v.nums[i]) + v.units[i])
				}
				return parts.join(" ")
		}
	}

	// A number as attribute text: whole numbers without a fraction.
	internal def formatNumber(v float) string {
		return "{int64(v)}" when v == v.round() && v.abs() < 1.0e15
		let t = "%.6f".format(v)
		for t.endsWith("0") {
			t = t[:t.len() - 1]
		}
		return t.endsWith(".") ?? (t[:t.len() - 1], t)
	}

	internal def lerpValues(a AValue, b AValue, f float) AValue {
		return f < 1.0 ?? (a, b) when a.kind == ValueKind.Text
		let nums float[]
		for let i = 0; i < a.nums.len(); i++ {
			nums.push(a.nums[i] + (b.nums[i] - a.nums[i]) * f)
		}
		return AValue{kind: a.kind, text: b.text, nums: nums, units: b.units, shape: b.shape}
	}

	// The sum of two values of one kind and shape (colours: the higher
	// alpha); none when they do not add.
	internal def addValues(a AValue, b AValue) ?AValue {
		return none when a.kind != b.kind || a.kind == ValueKind.Text || a.nums.len() != b.nums.len() || a.shape != b.shape
		let x = a
		let y = b
		if a.kind == ValueKind.Numbers && !unitsAgree(AValue[a, b]) {
			x = inPixels(a)
			y = inPixels(b)
			return none unless unitsAgree(AValue[x, y])
		}
		let nums float[]
		for let i = 0; i < x.nums.len(); i++ {
			let colourAlpha = x.kind == ValueKind.Colour && i == 3
			nums.push(colourAlpha ?? (x.nums[i].max(y.nums[i]), x.nums[i] + y.nums[i]))
		}
		return AValue{kind: x.kind, text: y.text, nums: nums, units: y.units, shape: y.shape}
	}

	internal def scaleValue(v AValue, k float) AValue {
		let nums float[]
		for let i = 0; i < v.nums.len(); i++ {
			nums.push(v.kind == ValueKind.Colour && i == 3 ?? (v.nums[i], v.nums[i] * k))
		}
		return AValue{kind: v.kind, text: v.text, nums: nums, units: v.units, shape: v.shape}
	}

	internal def zeroOf(v AValue) AValue {
		let nums float[]
		for let i = 0; i < v.nums.len(); i++ {
			nums.push(0.0)
		}
		return AValue{kind: v.kind, text: v.text, nums: nums, units: v.units, shape: v.shape}
	}

	// The paced distance between two values over their first `width`
	// numbers (all when 0; colours by red, green and blue); -1 for kinds
	// without one.
	internal def distance(a AValue, b AValue, width int) float {
		return -1.0 when a.kind == ValueKind.Text || a.kind == ValueKind.PathData
		let n = a.kind == ValueKind.Colour ?? (3, width > 0 ?? (width.min(a.nums.len()), a.nums.len()))
		let sum = 0.0
		for let i = 0; i < n; i++ {
			let d = b.nums[i] - a.nums[i]
			sum += d * d
		}
		return sqrt(sum)
	}

	internal def transformArity(kind string) int {
		match kind {
			case "translate", "scale":
				return 2
			case "rotate":
				return 3
			case "skewX", "skewY":
				return 1
		}
		return 0
	}

	// The parameters of an animateTransform value, the optional ones
	// filled in: translate(tx 0), scale(s s), rotate(a 0 0).
	internal def transformParams(kind string, t string) ?AValue {
		let n = parseNumbers(t)
		return none when n is none || n.len() == 0 || n.len() > transformArity(kind)
		let nums = n.clone()
		if kind == "translate" && nums.len() == 1 {
			nums.push(0.0)
		} else if kind == "scale" && nums.len() == 1 {
			nums.push(nums[0])
		} else if kind == "rotate" {
			return none when nums.len() == 2
			nums.push(0.0) when nums.len() == 1
			nums.push(0.0) when nums.len() == 2
		}
		let units string[]
		for let i = 0; i < nums.len(); i++ {
			units.push("")
		}
		return AValue{kind: ValueKind.Numbers, text: t, nums: nums, units: units, shape: ""}
	}

	internal def identityParams(kind string) AValue {
		let nums float[]
		for let i = 0; i < transformArity(kind); i++ {
			nums.push(kind == "scale" ?? (1.0, 0.0))
		}
		let units string[]
		for let i = 0; i < nums.len(); i++ {
			units.push("")
		}
		return AValue{kind: ValueKind.Numbers, text: "", nums: nums, units: units, shape: ""}
	}

	// A motion point "x,y"; none unless it is two numbers.
	internal def pointParams(t string) ?AValue {
		let n = parseNumbers(t)
		return none when n is none || n.len() != 2
		return AValue{kind: ValueKind.Numbers, text: t, nums: n, units: string["", ""], shape: ""}
	}

	// The keySplines timing curve (0,0) (x1,y1) (x2,y2) (1,1) at `x`: the
	// curve parameter found by bisection on its x, then its y.
	internal def splineAt(x1, y1, x2, y2 float, x float) float {
		let lo = 0.0
		let hi = 1.0
		for let i = 0; i < 48; i++ {
			let t = (lo + hi) / 2.0
			let u = 1.0 - t
			let bx = 3.0 * u * u * t * x1 + 3.0 * u * t * t * x2 + t * t * t
			if bx < x {
				lo = t
			} else {
				hi = t
			}
		}
		let t = (lo + hi) / 2.0
		let u = 1.0 - t
		return 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t
	}

	// Path data with every command made absolute, the numbers rewritten
	// against the current point.
	internal def absolutePath(v AValue) AValue {
		let nums = v.nums.clone()
		let shape = v.shape.bytes()
		let x = 0.0
		let y = 0.0
		let startX = 0.0
		let startY = 0.0
		let k = 0
		let at = 0
		for at < shape.len() {
			let c = shape[at]
			let relative = c >= byte('a') && c <= byte('z')
			let upper = relative ?? (c - 32, c)
			shape[at] = upper
			at++
			let arity = pathArity(upper)
			if arity == 0 {
				x = startX
				y = startY
				continue
			}
			let first = true
			for at + arity <= shape.len() && shape[at] == byte('#') {
				let ox = relative ?? (x, 0.0)
				let oy = relative ?? (y, 0.0)
				if upper == byte('H') {
					nums[k] += ox
					x = nums[k]
				} else if upper == byte('V') {
					nums[k] += oy
					y = nums[k]
				} else if upper == byte('A') {
					nums[k + 5] += ox
					nums[k + 6] += oy
					x = nums[k + 5]
					y = nums[k + 6]
				} else {
					for let j = 0; j < arity; j += 2 {
						nums[k + j] += ox
						nums[k + j + 1] += oy
					}
					x = nums[k + arity - 2]
					y = nums[k + arity - 1]
				}
				if upper == byte('M') && first {
					startX = x
					startY = y
				}
				first = false
				k += arity
				at += arity
			}
		}
		return AValue{kind: v.kind, text: v.text, nums: nums, units: v.units, shape: string(shape)}
	}

	// How many numbers one segment of an (upper-case) path command takes.
	internal def pathArity(c byte) int {
		return 2 when c := byte('M') || byte('L') || byte('T')
		return 1 when c := byte('H') || byte('V')
		return 6 when c == byte('C')
		return 4 when c := byte('S') || byte('Q')
		return 7 when c == byte('A')
		return 0
	}

	// Each number of the values paced on its own: at `p` of the summed
	// distances that number travels.
	internal def pacedPerComponent(vals AValue[], p float) AValue {
		let nums float[]
		for let c = 0; c < vals[0].nums.len(); c++ {
			let total = 0.0
			for let i = 1; i < vals.len(); i++ {
				total += (vals[i].nums[c] - vals[i - 1].nums[c]).abs()
			}
			let goal = p * total
			let value = vals[vals.len() - 1].nums[c]
			for let i = 1; i < vals.len(); i++ {
				let step = (vals[i].nums[c] - vals[i - 1].nums[c]).abs()
				if goal <= step {
					let f = step > 0.0 ?? (goal / step, 0.0)
					value = vals[i - 1].nums[c] + (vals[i].nums[c] - vals[i - 1].nums[c]) * f
					break
				}
				goal -= step
			}
			nums.push(value)
		}
		return AValue{kind: vals[0].kind, text: "", nums: nums, units: vals[0].units, shape: ""}
	}
}
