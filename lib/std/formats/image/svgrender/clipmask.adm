// clip-path and mask: a clip path of one plain shape clips by its outline;
// any other, and every mask, is drawn into a canvas the size of the
// device and used as a coverage or luminance mask.

internal std partial module std.formats.image.svgrender {
	use (
		std.gfx::(Mask)
		std.gfx.canvas::(Canvas, Painter)
		std.gfx.color::(Color, RGBA)
		std.math.geom::(FillRule, Path, Rect, Transform2D)
	)

	// What masking an element gives: whether it draws at all, and the
	// mask to draw it through.
	internal struct MaskResult {
		draws bool
		mask  ?Mask
	}

	// Clips the painter to the clip path `ref` names, for element `n`.
	// False when the element must not be drawn (a reference to something
	// that is not a clipPath, an empty clip).
	// `box`, when given, is the object bounding box to use instead of
	// `n`'s (a clip path on a clip path measures the clipped element).
	internal def applyClipPath(r Renderer, p Painter, n Node, ctx Ctx, ref string, box ?Rect = none) bool {
		let target = r.doc.resolve(ref)
		// A reference to nothing is ignored; to something that is no clip
		// path, it leaves the element out.
		return true when target is none
		return false unless target.tag == "clipPath"
		let id = refId(ref)
		// A reference back into a clip path being built is ignored.
		return true when r.active.indexOf(id) >= 0
		let bbox = box
		bbox = objectBox(r, n, ctx) when bbox is none
		let t = clipTransform(r, target, ctx, bbox)
		return false when t is none
		// A plain clip: one shape child, no clip of its own on either.
		let simple = simpleClip(r, target, ctx)
		if simple is Path {
			let rule = clipRule(r, target, simple, ctx)
			p.clip(simple.transformed(t), rule)
			return true
		}
		r.active.push(id)
		let mask = clipMask(r, p, target, ctx, t, bbox)
		r.active.pop()
		return false when mask is none
		p.clip(mask)
		return true
	}

	// The clip path's own transform with its units: user space, or the
	// element's box. None when the box is empty under objectBoundingBox.
	internal def clipTransform(r Renderer, clip Node, ctx Ctx, bbox ?Rect) ?Transform2D {
		let t = new Transform2D()
		let own = clip.attr("transform")
		if own is string {
			let parsed = parseTransform(own)
			t = aroundOrigin(clip, parsed, ctx.units) when parsed is Transform2D
		}
		if (orEmpty(clip.attr("clipPathUnits"))).trim() == "objectBoundingBox" {
			return none when bbox is none
			let w = bbox.right - bbox.left
			let h = bbox.bottom - bbox.top
			return none when w <= 0.0 || h <= 0.0
			t = t.then(new Transform2D(a = w, d = h, tx = bbox.left, ty = bbox.top))
		}
		return t
	}

	// The outline of a clip path made of exactly one visible shape with
	// no clip path anywhere, none otherwise.
	internal def simpleClip(r Renderer, clip Node, ctx Ctx) ?Path {
		return none unless treeStyle(r.doc, clip).get("clip-path", "none").lower() == "none"
		let shape ?Path = none
		let count = 0
		let cstyle = treeStyle(r.doc, clip)
		for let (_, c) in clip.children {
			continue when c.isText || c.tag == ""
			let s = cstyle.child(c.props)
			continue when s.get("display").lower() == "none"
			return none unless (c.tag := "rect" || "circle" || "ellipse" || "line" || "polyline" || "polygon" || "path")
			return none unless s.get("clip-path", "none").lower() == "none"
			return none unless s.get("visibility", "visible").lower() == "visible"
			let geometry = shapePath(c, ctx.units)
			continue when geometry is none
			count++
			return none when count > 1
			let ct = s.get("transform", "")
			let path Path = geometry
			if ct != "" && ct.lower() != "none" {
				let parsed = parseTransform(ct)
				path = path.transformed(parsed) when parsed is Transform2D
			}
			shape = path
		}
		return shape is none ?? (new Path(), shape)
	}

	internal def clipRule(r Renderer, clip Node, path Path, ctx Ctx) FillRule {
		let cstyle = treeStyle(r.doc, clip)
		for let (_, c) in clip.children {
			continue when c.isText || c.tag == ""
			let s = cstyle.child(c.props)
			continue when s.get("display").lower() == "none"
			return s.get("clip-rule", "nonzero").lower() == "evenodd" ?? (FillRule.EvenOdd, FillRule.NonZero)
		}
		return FillRule.NonZero
	}

	// A device-sized canvas holding the clip path's coverage: its shapes
	// (and text and used shapes) filled opaque white, each through its own
	// clip path, all through the clip path's own.
	internal def clipMask(r Renderer, p Painter, clip Node, ctx Ctx, t Transform2D, bbox ?Rect) ?Canvas {
		let device = p.state().transform
		let c = new Canvas(r.deviceW.max(1), r.deviceH.max(1))
		c.setTransform(device)
		c.transform(t)
		let cctx = Ctx{st: treeStyle(r.doc, clip), units: ctx.units, ctxFill: none, ctxStroke: none}
		// The clip path's own clip path clips the whole coverage.
		let own = cctx.st.get("clip-path", "none")
		if own.lower() != "none" {
			c.setTransform(device)
			return none unless applyClipPath(r, c, clip, ctx, own, bbox)
			c.transform(t)
		}
		let white = new Color(RGBA{r: 255, g: 255, b: 255, a: 255})
		for let (_, child) in clip.children {
			continue when child.isText || child.tag == ""
			clipChild(r, c, child, cctx, white)
		}
		return c
	}

	// One child of a clip path drawn as coverage.
	internal def clipChild(r Renderer, c Canvas, n Node, ctx Ctx, white Color) {
		let s = ctx.st.child(n.props)
		return when s.get("display").lower() == "none" || s.get("visibility", "visible").lower() != "visible"
		let cctx = Ctx{st: s, units: ctx.units, ctxFill: none, ctxStroke: none}
		let target = n
		let shift = new Transform2D()
		if n.tag == "use" {
			let href = n.attr("href")
			return when href is none
			let found = r.doc.resolve(href)
			return when found is none
			// Only shapes and text may be used inside a clip path.
			return unless (found.tag := "rect" || "circle" || "ellipse" || "line" || "polyline" || "polygon" || "path" || "text")
			target = found
			shift = new Transform2D(tx = lengthOf(n, "x", ctx.units, "x", 0.0), ty = lengthOf(n, "y", ctx.units, "y", 0.0))
		}
		c.save()
		let own = s.get("transform", "")
		if own != "" && own.lower() != "none" {
			let parsed = parseTransform(own)
			c.transform(parsed) when parsed is Transform2D
		}
		c.transform(shift)
		let clipRef = s.get("clip-path", "none")
		if clipRef.lower() != "none" && !applyClipPath(r, c, n, cctx, clipRef) {
			c.restore()
			return
		}
		let ts = target == n ?? (s, s.child(target.props))
		if target != n {
			let tt = ts.get("transform", "")
			if tt != "" && tt.lower() != "none" {
				let parsed = parseTransform(tt)
				c.transform(parsed) when parsed is Transform2D
			}
		}
		let rule = ts.get("clip-rule", "nonzero").lower() == "evenodd" ?? (FillRule.EvenOdd, FillRule.NonZero)
		if target.tag == "text" {
			textCoverage(r, c, target, Ctx{st: ts, units: ctx.units, ctxFill: none, ctxStroke: none}, white)
		} else {
			let path = shapePath(target, ctx.units)
			c.fill(path, white, rule) when path is Path
		}
		c.restore()
	}

	// The mask `ref` names for element `n`: none when the reference is not
	// a mask (the element then draws unmasked as SVG 2 says), draws false
	// when its region is empty.
	internal def maskFor(r Renderer, p Painter, n Node, ctx Ctx, ref string, box ?Rect = none) ?MaskResult {
		let target = r.doc.resolve(ref)
		return none when target is none
		return MaskResult{draws: false, mask: none} unless target.tag == "mask"
		let id = refId(ref)
		// A reference back into a mask being built is ignored.
		return none when r.active.indexOf(id) >= 0
		let bbox = box
		bbox = objectBox(r, n, ctx) when bbox is none
		let userUnits = (orEmpty(target.attr("maskUnits"))).trim() == "userSpaceOnUse"
		let contentBox = (orEmpty(target.attr("maskContentUnits"))).trim() == "objectBoundingBox"
		let bw = bbox is Rect ?? (bbox.right - bbox.left, 0.0)
		let bh = bbox is Rect ?? (bbox.bottom - bbox.top, 0.0)
		let region = Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}
		if userUnits {
			let x = lengthOf(target, "x", ctx.units, "x", -0.1 * ctx.units.width)
			let y = lengthOf(target, "y", ctx.units, "y", -0.1 * ctx.units.height)
			let w = lengthOf(target, "width", ctx.units, "x", 1.2 * ctx.units.width)
			let h = lengthOf(target, "height", ctx.units, "y", 1.2 * ctx.units.height)
			region = Rect{left: x, top: y, right: x + w, bottom: y + h}
		} else {
			return MaskResult{draws: false, mask: none} when bbox is none || bw <= 0.0 || bh <= 0.0
			let b Rect = bbox
			let x = fraction(target.attr("x"), -0.1)
			let y = fraction(target.attr("y"), -0.1)
			let w = fraction(target.attr("width"), 1.2)
			let h = fraction(target.attr("height"), 1.2)
			region = Rect{left: b.left + x * bw, top: b.top + y * bh, right: b.left + (x + w) * bw, bottom: b.top + (y + h) * bh}
		}
		return MaskResult{draws: false, mask: none} when region.right <= region.left || region.bottom <= region.top
		let device = p.state().transform
		let c = new Canvas(r.deviceW.max(1), r.deviceH.max(1))
		c.setTransform(device)
		c.clip(region)
		if contentBox {
			return MaskResult{draws: false, mask: none} when bbox is none || bw <= 0.0 || bh <= 0.0
			let b Rect = bbox
			c.transform(new Transform2D(a = bw, d = bh, tx = b.left, ty = b.top))
		}
		let mstyle = treeStyle(r.doc, target)
		let mctx = Ctx{st: mstyle, units: ctx.units, ctxFill: none, ctxStroke: none}
		r.active.push(id)
		// The mask's own mask applies to its content.
		let own = mstyle.get("mask", "none")
		let grouped = false
		if own.lower() != "none" {
			c.setTransform(device)
			let inner = maskFor(r, c, target, ctx, own, bbox)
			if inner is MaskResult {
				if !inner.draws {
					r.active.pop()
					return MaskResult{draws: false, mask: none}
				}
				c.beginGroup(mask = inner.mask)
				grouped = true
			}
			c.setTransform(device)
			c.clip(region)
			if contentBox && bbox is Rect {
				c.transform(new Transform2D(a = bw, d = bh, tx = bbox.left, ty = bbox.top))
			}
		}
		r.children(c, target, mctx)
		c.endGroup() when grouped
		r.active.pop()
		if mstyle.get("mask-type", "luminance").lower() == "alpha" {
			whiten(c)
		} else {
			luminanceToAlpha(c)
		}
		return MaskResult{draws: true, mask: c}
	}

	// Alpha masks: every pixel white with its alpha, so the canvas's
	// luminance coverage is the alpha.
	internal def whiten(c Canvas) {
		let px = c.pixels
		for let i = 0; i + 3 < px.len(); i += 4 {
			px[i] = 255
			px[i + 1] = 255
			px[i + 2] = 255
		}
	}

	// Luminance masks: the luminance of the colour (sRGB coefficients, as
	// SVG's linearRGB-free masking of browsers) times alpha, as a white
	// pixel's alpha.
	internal def luminanceToAlpha(c Canvas) {
		let px = c.pixels
		for let i = 0; i + 3 < px.len(); i += 4 {
			let a = int(px[i + 3])
			if a == 0 {
				continue
			}
			let l = 0.2125 * float(px[i]) + 0.7154 * float(px[i + 1]) + 0.0721 * float(px[i + 2])
			px[i] = 255
			px[i + 1] = 255
			px[i + 2] = 255
			px[i + 3] = byte((l * float(a) / 255.0 + 0.5).floor().clamp(0.0, 255.0))
		}
	}
}
