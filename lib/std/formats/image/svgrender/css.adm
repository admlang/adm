// The CSS an SVG document carries: `<style>` sheets and `style` attributes.
// Selectors of CSS Selectors 3 (type, universal, class, id, attribute,
// :first-child and the other structural pseudo-classes SVG renderers
// support, the four combinators), specificity and `!important`; at-rules are
// skipped.

internal std partial module std.formats.image.svgrender {
	// One `name: value` of a rule or a style attribute.
	struct Declaration {
		name      string
		value     string
		important bool
	}

	// A rule of a sheet: its selector, its declarations, and where it stands
	// for the cascade (specificity, then order in the document).
	struct Rule {
		selector    Selector
		decls       Declaration[]
		specificity int
		order       int
	}

	// One compound selector and how it joins the one before it: byte(' ')
	// (descendant), byte('>') (child), byte('+') (next sibling), byte('~') (later sibling),
	// or none for the first.
	struct Compound {
		combinator string
		tag        string // "" or "*" matches any element
		ids        string[]
		classes    string[]
		attrs      AttrTest[]
		pseudos    string[]
	}

	struct AttrTest {
		name  string
		op    string // "" (present), "=", "~=", "|=", "^=", "$=", "*="
		value string
	}

	struct Selector {
		parts Compound[]
	}

	// Reads CSS text: rules for a sheet.
	internal type CssReader {
		internal s  byte[]
		internal at int

		def new(text string) {
			s = text.bytes()
		}

		// Where `pattern` next starts from `from`, -1 when nowhere.
		def find(pattern string, from int) int {
			let p = pattern.bytes()
			for let i = from; i + p.len() <= s.len(); i++ {
				let hit = true
				for let k = 0; k < p.len(); k++ {
					if s[i + k] != p[k] {
						hit = false
						break
					}
				}
				return i when hit
			}
			return -1
		}

		def done() bool {
			return at >= s.len()
		}

		// Skips spaces and comments.
		def skip() {
			for !done() {
				let c = s[at]
				if (c := byte(' ') || byte('\t') || byte('\n') || byte('\r') || byte(12)) {
					at++
				} else if c == byte('/') && at + 1 < s.len() && s[at + 1] == byte('*') {
					let end = find("*/", at + 2)
					at = end < 0 ?? (s.len(), end + 2)
				} else if find("<!--", at) == at {
					at += 4
				} else if find("-->", at) == at {
					at += 3
				} else {
					return
				}
			}
		}

		// The rules of the sheet, numbered from `first`.
		def rules(first int) Rule[] {
			let out Rule[]
			let order = first
			for {
				skip()
				break when done()
				if s[at] == byte('@') {
					skipAtRule()
					continue
				}
				let open = find("\{", at)
				break when open < 0
				let prelude = string(s[at:open])
				at = open + 1
				let body = block()
				let decls = parseDeclarations(body)
				for let (_, text) in splitTopLevel(prelude, byte(',')) {
					let sel = parseSelector(text.trim())
					continue when sel is none
					out.push(Rule{selector: sel, decls: decls, specificity: specificity(sel), order: order})
					order++
				}
			}
			return out
		}

		// The text up to the `}` that closes the block opened just before.
		def block() string {
			let start = at
			let depth = 1
			for !done() {
				let c = s[at]
				if c == byte('"') || c == byte('\'') {
					skipString(c)
					continue
				}
				if c == byte('{') {
					depth++
				} else if c == byte('}') {
					depth--
					if depth == 0 {
						at++
						return string(s[start:at - 1])
					}
				}
				at++
			}
			return string(s[start:])
		}

		def skipString(q byte) {
			at++
			for !done() && s[at] != q {
				at += s[at] == byte('\\') ?? (2, 1)
			}
			at++
		}

		// An at-rule: up to its `;`, or its block.
		def skipAtRule() {
			for !done() {
				let c = s[at]
				if c == byte(';') {
					at++
					return
				}
				if c == byte('{') {
					at++
					block()
					return
				}
				at++
			}
		}
	}

	// The declarations of a block or a style attribute, in order.
	internal def parseDeclarations(body string) Declaration[] {
		let out Declaration[]
		for let (_, part) in splitTopLevel(stripComments(body), byte(';')) {
			let colon = part.indexOf(":")
			continue when colon <= 0
			let name = part[:colon].trim().lower()
			let value = part[colon + 1:].trim()
			let important = false
			let bang = lastIndex(value, "!")
			if bang >= 0 && value[bang + 1:].trim().lower() == "important" {
				important = true
				value = value[:bang].trim()
			}
			continue when name == "" || value == ""
			out.push(Declaration{name: name, value: value, important: important})
		}
		return out
	}

	// Where `part` last starts in `text` (characters), -1 when nowhere.
	internal def lastIndex(text string, part string) int {
		let found = -1
		let at = text.indexOf(part)
		for at >= 0 {
			found = at
			at = text.indexOf(part, at + 1)
		}
		return found
	}

	internal def stripComments(text string) string {
		return text unless text.contains("/*")
		let out = ""
		let at = 0
		for at < text.len() {
			let open = text.indexOf("/*", at)
			if open < 0 {
				out += text[at:]
				break
			}
			out += text[at:open]
			let close = text.indexOf("*/", open + 2)
			at = close < 0 ?? (text.len(), close + 2)
		}
		return out
	}

	// `text` split at `sep` outside quotes and brackets.
	internal def splitTopLevel(source string, sep byte) string[] {
		let text = source.bytes()
		let out string[]
		let depth = 0
		let quote = byte(0)
		let start = 0
		for let i = 0; i < text.len(); i++ {
			let c = text[i]
			if quote != 0 {
				quote = byte(0) when c == quote
				continue
			}
			if c == byte('"') || c == byte('\'') {
				quote = c
			} else if (c := byte('(') || byte('[')) {
				depth++
			} else if (c := byte(')') || byte(']')) {
				depth--
			} else if c == sep && depth == 0 {
				out.push(string(text[start:i]))
				start = i + 1
			}
		}
		out.push(string(text[start:]))
		return out
	}

	// A selector, none when it does not parse (the rule is dropped).
	internal def parseSelector(source string) ?Selector {
		return none when source == ""
		let text = source.bytes()
		let parts Compound[]
		let at = 0
		let combinator = ""
		for at < text.len() {
			// Combinator and spaces before the next compound.
			let sawSpace = false
			for at < text.len() && (text[at] := byte(' ') || byte('\t') || byte('\n') || byte('\r')) {
				at++
				sawSpace = true
			}
			break when at >= text.len()
			let c = text[at]
			if (c := byte('>') || byte('+') || byte('~')) {
				return none when parts.len() == 0
				combinator = string(char(c))
				at++
				for at < text.len() && (text[at] := byte(' ') || byte('\t') || byte('\n') || byte('\r')) {
					at++
				}
			} else if sawSpace && parts.len() > 0 {
				combinator = " "
			}
			let cp = Compound{combinator: parts.len() == 0 ?? ("", combinator == "" ?? (" ", combinator)), tag: "", ids: string[], classes: string[], attrs: AttrTest[], pseudos: string[]}
			let start = at
			for at < text.len() {
				let ch = text[at]
				if ch == byte('*') {
					cp.tag = "*"
					at++
				} else if isNameChar(ch) && at == start {
					let (name, next) = readName(text, at)
					cp.tag = name
					at = next
				} else if ch == byte('#') {
					let (name, next) = readName(text, at + 1)
					return none when name == ""
					cp.ids.push(name)
					at = next
				} else if ch == byte('.') {
					let (name, next) = readName(text, at + 1)
					return none when name == ""
					cp.classes.push(name)
					at = next
				} else if ch == byte('[') {
					let close = at
					for close < text.len() && text[close] != byte(']') {
						close++
					}
					return none when close >= text.len()
					let test = parseAttrTest(string(text[at + 1:close]))
					return none when test is none
					cp.attrs.push(test)
					at = close + 1
				} else if ch == byte(':') {
					let (name, next) = readName(text, at + 1)
					return none unless (name.lower() := "first-child" || "last-child" || "only-child" || "root" || "empty" || "link" || "visited" || "hover" || "active" || "focus" || "first-of-type" || "last-of-type" || "only-of-type")
					cp.pseudos.push(name.lower())
					at = next
				} else {
					break
				}
			}
			return none when at == start
			parts.push(cp)
			combinator = ""
		}
		return none when parts.len() == 0
		return Selector{parts: parts}
	}

	internal def isNameChar(c byte) bool {
		return (c >= byte('a') && c <= byte('z')) || (c >= byte('A') && c <= byte('Z')) || (c >= byte('0') && c <= byte('9')) || (c := byte('-') || byte('_')) || c >= 0x80 || c == byte('\\')
	}

	internal def readName(text byte[], from int) (string, int) {
		let at = from
		let out byte[]
		for at < text.len() && isNameChar(text[at]) {
			if text[at] == byte('\\') && at + 1 < text.len() {
				out.push(text[at + 1])
				at += 2
				continue
			}
			out.push(text[at])
			at++
		}
		return (string(out), at)
	}

	internal def parseAttrTest(inner string) ?AttrTest {
		let ops = ["~=", "|=", "^=", "$=", "*=", "="]
		for let (_, op) in ops {
			let i = inner.indexOf(op)
			if i > 0 {
				let name = inner[:i].trim()
				let value = inner[i + op.len():].trim()
				if value.len() >= 2 && (value.startsWith("\"") || value.startsWith("'")) && value.endsWith(value[0:1]) {
					value = value[1:value.len() - 1]
				}
				return AttrTest{name: name, op: op, value: value}
			}
		}
		let name = inner.trim()
		return none when name == ""
		return AttrTest{name: name, op: "", value: ""}
	}

	// Specificity as one number: ids, then classes, attributes and
	// pseudo-classes, then types.
	internal def specificity(sel Selector) int {
		let a = 0
		let b = 0
		let c = 0
		for let (_, p) in sel.parts {
			a += p.ids.len()
			b += p.classes.len() + p.attrs.len() + p.pseudos.len()
			c += p.tag != "" && p.tag != "*" ?? (1, 0)
		}
		return a * 1000000 + b * 1000 + c
	}
}
