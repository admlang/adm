// An SVG document as the renderer reads it: elements of the SVG namespace
// with their attributes and the CSS declarations the cascade gives them,
// text nodes for text content, and the ids that references name.

internal std partial module std.formats.image.svgrender {
	use (
		std.data.encoding::(XML, XMLNode, XMLNodeKind)
	)

	internal const svgNamespace = "http://www.w3.org/2000/svg"
	internal const xlinkNamespace = "http://www.w3.org/1999/xlink"

	// One element or text node.
	type Node {
		// Local name of an SVG element; "" for elements of other namespaces,
		// which are kept only so their SVG descendants are not.
		tag       string
		isText    bool
		text      string
		attrs     map<string, string>
		// Property values the cascade picked: presentation attributes, then
		// sheet rules by specificity, then the style attribute, important
		// declarations above all.
		props     map<string, string>
		// Properties an important declaration set, which animations leave
		// alone.
		important string[]
		children  Node[]
		// Position among the parent's element children and their count, for
		// structural selectors.
		index     int
		siblings  int
		// Position in document order, numbered by the animator.
		serial    int
		// The motion animations' transform, set while they are applied.
		motion    string

		def new() {
			attrs = map<string, string>{}
			props = map<string, string>{}
		}

		def attr(name string) ?string {
			return attrs.get(name)
		}

		// An attribute's value, empty when missing.
		def attrOr(name string, otherwise string) string {
			let v = attrs.get(name)
			return v is none ?? (otherwise, v)
		}

		def has(name string) bool {
			return attrs.hasKey(name)
		}

		// The element children, text nodes left out.
		def elements() Node[] {
			let out Node[]
			for let (_, c) in children {
				out.push(c) unless c.isText
			}
			return out
		}
	}

	// A parsed document: its root `svg` element and the elements by id.
	type Document {
		root  Node
		ids   map<string, Node>
		// The style sheets' rules in cascade order.
		rules Rule[]

		def new(root Node) {
			self.root = root
			ids = map<string, Node>{}
		}

		// The element `href` (`#id`, or a `url(#id)` reference) names.
		def resolve(href string) ?Node {
			let id = refId(href)
			return none when id == ""
			return ids.get(id)
		}
	}

	internal def orEmpty(v ?string) string {
		return v is none ?? ("", v)
	}

	// The id an IRI or FuncIRI points at: `#a`, `url(#a)`, `url('#a')`;
	// empty when it names none.
	internal def refId(text string) string {
		let t = text.trim()
		if t.startsWith("url(") {
			let close = t.indexOf(")")
			return "" when close < 0
			t = t[4:close].trim()
			if t.len() >= 2 && (t.startsWith("\"") || t.startsWith("'")) {
				t = t[1:t.len() - 1].trim()
			}
		}
		return "" unless t.startsWith("#")
		return t[1:]
	}

	// Parses the document: fails when the bytes are not XML or the root is
	// not an SVG `svg` element.
	def parseDocument(data byte[]) !Document {
		let xml = try new XML().parse(data)
		let root = convert(xml)
		fail "svg: the root element is not <svg>" unless root.tag == "svg"
		let doc = new Document(root)
		collect(doc, root, doc.rules)
		doc.rules.sort((a Rule, b Rule) => a.specificity < b.specificity || (a.specificity == b.specificity && a.order < b.order))
		let path Node[]
		cascade(root, path, doc.rules)
		return doc
	}

	// Runs the cascade again over the whole document, after what it reads
	// (`class`, `style`) changed.
	internal def recascade(doc Document) {
		clearProps(doc.root)
		let path Node[]
		cascade(doc.root, path, doc.rules)
	}

	internal def clearProps(n Node) {
		n.props = map<string, string>{}
		n.important = string[]
		for let (_, c) in n.children {
			clearProps(c)
		}
	}

	// The XML tree as nodes: SVG elements kept with their attributes (an
	// `xlink:href` read as `href` when the element has no plain one),
	// others kept by structure only.
	internal def convert(x XMLNode) Node {
		let n = new Node()
		if x.kind == XMLNodeKind.Text {
			n.isText = true
			n.text = x.content
			return n
		}
		let inSvg = x.namespace == svgNamespace
		n.tag = inSvg ?? (x.localName, "")
		for let (_, a) in x.attributes {
			if a.namespace == xlinkNamespace && a.localName == "href" {
				n.attrs["href"] = a.value unless n.attrs.hasKey("href")
			} else if a.prefix == "xml" {
				n.attrs["xml:" + a.localName] = a.value
			} else if a.namespace == "" && a.prefix != "xmlns" && a.name != "xmlns" {
				n.attrs[a.localName] = a.value
			}
		}
		let index = 0
		for let (_, c) in x.children {
			let child = convert(c)
			if !child.isText {
				child.index = index
				index++
			}
			n.children.push(child)
		}
		for let (_, c) in n.children {
			c.siblings = index unless c.isText
		}
		return n
	}

	// Ids and sheets, in document order; the first element with an id
	// keeps it.
	internal def collect(doc Document, n Node, rules Rule[]) {
		return when n.isText
		let id = n.attr("id")
		if id is string && id != "" && !doc.ids.hasKey(id) {
			doc.ids[id] = n
		}
		if n.tag == "style" {
			let kind = n.attr("type")
			if kind is none || kind.trim() == "" || kind.trim().lower() == "text/css" {
				let text = ""
				for let (_, c) in n.children {
					text += c.text when c.isText
				}
				for let (_, r) in new CssReader(text).rules(rules.len()) {
					rules.push(r)
				}
			}
		}
		for let (_, c) in n.children {
			collect(doc, c, rules)
		}
	}

	// Gives every element its property declarations: presentation
	// attributes, sheet rules in cascade order, the style attribute, then
	// important ones of sheets and style attribute.
	internal def cascade(n Node, ancestors Node[], rules Rule[]) {
		return when n.isText
		if n.tag != "" {
			for let (name, value) in n.attrs {
				n.props[name] = value when isPresentationAttribute(name, n.tag)
			}
			// xml:space reaches the element's descendants like an inherited
			// property.
			let space = n.attr("xml:space")
			n.props["xml:space"] = space when space is string
			let important Declaration[]
			for let (_, r) in rules {
				continue unless matches(r.selector, n, ancestors)
				for let (_, d) in r.decls {
					if d.important {
						important.push(d)
					} else {
						n.props[d.name] = d.value
					}
				}
			}
			let styleText = n.attr("style")
			let inline = styleText is string ?? (parseDeclarations(styleText), Declaration[])
			for let (_, d) in inline {
				n.props[d.name] = d.value unless d.important
			}
			for let (_, d) in important {
				n.props[d.name] = d.value
				n.important.push(d.name)
			}
			for let (_, d) in inline {
				if d.important {
					n.props[d.name] = d.value
					n.important.push(d.name)
				}
			}
			expandShorthands(n.props)
		}
		ancestors.push(n)
		for let (_, c) in n.children {
			cascade(c, ancestors, rules)
		}
		ancestors.pop()
	}

	// `marker` sets the three marker properties; `font` the font ones it
	// names.
	internal def expandShorthands(props map<string, string>) {
		let marker = props.get("marker")
		if marker is string {
			for let (_, name) in ["marker-start", "marker-mid", "marker-end"] {
				props[name] = marker unless props.hasKey(name)
			}
		}
	}

	// Whether the selector picks `n`, whose ancestors (nearest last) are
	// `ancestors`.
	internal def matches(sel Selector, n Node, ancestors Node[]) bool {
		return matchFrom(sel, sel.parts.len() - 1, n, ancestors, ancestors.len())
	}

	// Matches parts [0, k] with part k on `n`, whose ancestors are the
	// first `depth` of `ancestors`.
	internal def matchFrom(sel Selector, k int, n Node, ancestors Node[], depth int) bool {
		let part = sel.parts[k]
		let parent = depth > 0 ?? (ancestors[depth - 1], none)
		return false unless matchCompound(part, n, parent)
		return true when k == 0
		match part.combinator {
			case ">":
				return depth > 0 && matchFrom(sel, k - 1, ancestors[depth - 1], ancestors, depth - 1)
			case " ":
				for let d = depth; d > 0; d-- {
					return true when matchFrom(sel, k - 1, ancestors[d - 1], ancestors, d - 1)
				}
				return false
			case "+", "~":
				return false when parent is none
				let p Node = parent
				let mine = p.elements()
				for let i = n.index - 1; i >= 0; i-- {
					return true when matchFrom(sel, k - 1, mine[i], ancestors, depth)
					break when part.combinator == "+"
				}
				return false
		}
		return false
	}

	internal def matchCompound(c Compound, n Node, parent ?Node) bool {
		return false when n.tag == ""
		return false unless c.tag == "" || c.tag == "*" || c.tag == n.tag
		for let (_, id) in c.ids {
			let own = n.attr("id")
			return false unless own is string && own == id
		}
		if c.classes.len() > 0 {
			let own = n.attr("class")
			return false when own is none
			let list = own.split(" ")
			for let (_, cls) in c.classes {
				return false when list.indexOf(cls) < 0
			}
		}
		for let (_, t) in c.attrs {
			let v = n.attr(t.name)
			return false when v is none
			let value string = v
			let ok = attrTestPasses(t, value)
			return false unless ok
		}
		for let (_, ps) in c.pseudos {
			let ok = pseudoPasses(ps, n, parent)
			return false unless ok
		}
		return true
	}

	internal def attrTestPasses(t AttrTest, value string) bool {
		match t.op {
			case "":
				return true
			case "=":
				return value == t.value
			case "~=":
				return value.split(" ").indexOf(t.value) >= 0
			case "|=":
				return value == t.value || value.startsWith(t.value + "-")
			case "^=":
				return t.value != "" && value.startsWith(t.value)
			case "$=":
				return t.value != "" && value.endsWith(t.value)
			case "*=":
				return t.value != "" && value.contains(t.value)
		}
		return false
	}

	internal def pseudoPasses(ps string, n Node, parent ?Node) bool {
		match ps {
			case "first-child":
				return n.index == 0
			case "last-child":
				return n.index == n.siblings - 1
			case "only-child":
				return n.siblings == 1
			case "root":
				return parent is none
			case "empty":
				return n.children.len() == 0
		}
		return false
	}
}
