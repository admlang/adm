// Lighting, turbulence and feImage primitives.

internal std partial module std.formats.image.svgrender {
	use (
		std.formats.image as images
		std.gfx.canvas::(Canvas, Painter, Sampling)
		std.gfx.color::(Color, RGBA)
		std.math::(sqrt, cos, sin, Pi)
		std.math.geom::(Rect, Transform2D)
		std.simd
		std.gfx.bands
	)

	internal struct Vec3 {
		x float
		y float
		z float
	}

	internal def v3len(v Vec3) float {
		return sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
	}

	internal def v3norm(v Vec3) Vec3 {
		let l = v3len(v)
		return v when l.abs() < 1e-7
		return Vec3{x: v.x / l, y: v.y / l, z: v.z / l}
	}

	internal def v3dot(a Vec3, b Vec3) float {
		return a.x * b.x + a.y * b.y + a.z * b.z
	}

	// The surface normal at (x, y) from the alpha channel (the spec's
	// Sobel kernels, edges and corners included): factor x, factor y, nx,
	// ny.
	internal def surfaceNormal(img FImage, x int, y int) (float, float, float, float) {
		let w = img.w
		let h = img.h
		let a = (px int, py int) => float(img.px[(py.clamp(0, h - 1) * w + px.clamp(0, w - 1)) * 4 + 3])
		let left = x == 0
		let right = x == w - 1
		let top = y == 0
		let bottom = y == h - 1
		let fx = 0.25
		let fy = 0.25
		let nx = 0.0
		let ny = 0.0
		if top && left {
			fx = 2.0 / 3.0
			fy = 2.0 / 3.0
			nx = -2.0 * a(x, y) + 2.0 * a(x + 1, y) - a(x, y + 1) + a(x + 1, y + 1)
			ny = -2.0 * a(x, y) - a(x + 1, y) + 2.0 * a(x, y + 1) + a(x + 1, y + 1)
		} else if top && right {
			fx = 2.0 / 3.0
			fy = 2.0 / 3.0
			nx = -2.0 * a(x - 1, y) + 2.0 * a(x, y) - a(x - 1, y + 1) + a(x, y + 1)
			ny = -a(x - 1, y) - 2.0 * a(x, y) + a(x - 1, y + 1) + 2.0 * a(x, y + 1)
		} else if bottom && left {
			fx = 2.0 / 3.0
			fy = 2.0 / 3.0
			nx = -a(x, y - 1) + a(x + 1, y - 1) - 2.0 * a(x, y) + 2.0 * a(x + 1, y)
			ny = -2.0 * a(x, y - 1) - a(x + 1, y - 1) + 2.0 * a(x, y) + a(x + 1, y)
		} else if bottom && right {
			fx = 2.0 / 3.0
			fy = 2.0 / 3.0
			nx = -a(x - 1, y - 1) + a(x, y - 1) - 2.0 * a(x - 1, y) + 2.0 * a(x, y)
			ny = -a(x - 1, y - 1) - 2.0 * a(x, y - 1) + a(x - 1, y) + 2.0 * a(x, y)
		} else if top {
			fx = 1.0 / 3.0
			fy = 0.5
			nx = -2.0 * a(x - 1, y) + 2.0 * a(x + 1, y) - a(x - 1, y + 1) + a(x + 1, y + 1)
			ny = -a(x - 1, y) - 2.0 * a(x, y) - a(x + 1, y) + a(x - 1, y + 1) + 2.0 * a(x, y + 1) + a(x + 1, y + 1)
		} else if bottom {
			fx = 1.0 / 3.0
			fy = 0.5
			nx = -a(x - 1, y - 1) + a(x + 1, y - 1) - 2.0 * a(x - 1, y) + 2.0 * a(x + 1, y)
			ny = -a(x - 1, y - 1) - 2.0 * a(x, y - 1) - a(x + 1, y - 1) + a(x - 1, y) + 2.0 * a(x, y) + a(x + 1, y)
		} else if left {
			fx = 0.5
			fy = 1.0 / 3.0
			nx = -a(x, y - 1) + a(x + 1, y - 1) - 2.0 * a(x, y) + 2.0 * a(x + 1, y) - a(x, y + 1) + a(x + 1, y + 1)
			ny = -2.0 * a(x, y - 1) - a(x + 1, y - 1) + 2.0 * a(x, y + 1) + a(x + 1, y + 1)
		} else if right {
			fx = 0.5
			fy = 1.0 / 3.0
			nx = -a(x - 1, y - 1) + a(x, y - 1) - 2.0 * a(x - 1, y) + 2.0 * a(x, y) - a(x - 1, y + 1) + a(x, y + 1)
			ny = -a(x - 1, y - 1) - 2.0 * a(x, y - 1) + a(x - 1, y + 1) + 2.0 * a(x, y + 1)
		} else {
			nx = -a(x - 1, y - 1) + a(x + 1, y - 1) - 2.0 * a(x - 1, y) + 2.0 * a(x + 1, y) - a(x - 1, y + 1) + a(x + 1, y + 1)
			ny = -a(x - 1, y - 1) - 2.0 * a(x, y - 1) - a(x + 1, y - 1) + a(x - 1, y + 1) + 2.0 * a(x, y + 1) + a(x + 1, y + 1)
		}
		return (fx, fy, -nx, -ny)
	}

	// What every pixel of a lighting primitive shares: the light in the
	// region's pixels, a distant light's direction, a spot light's axis and
	// cone, the light's colour.
	internal struct LightSetup {
		lx     float
		ly     float
		lz     float
		// A distant light's unit direction.
		bx     float
		by     float
		bz     float
		// A spot light's unit axis and the cosine of its cone.
		dx     float
		dy     float
		dz     float
		cosine float
		cr     float
		cg     float
		cb     float
	}

	// Diffuse or specular lighting of the input's alpha surface, rows in
	// bands on tasks.
	internal def lighting(p Primitive, ts Transform2D, src FImage, img FImage, out FImage) {
		let w = img.w
		let h = img.h
		return when w < 3 || h < 3
		let light = p.light
		// Point and spot lights move into the region's pixels.
		let sz = sqrt(ts.a * ts.a + ts.d * ts.d) / sqrt(2.0)
		let lx = ts.a * light.x + ts.c * light.y + ts.tx - float(src.x0)
		let ly = ts.b * light.x + ts.d * light.y + ts.ty - float(src.y0)
		let lz = light.z * sz
		let px = ts.a * light.px + ts.c * light.py + ts.tx - float(src.x0)
		let py = ts.b * light.px + ts.d * light.py + ts.ty - float(src.y0)
		let pz = light.pz * sz
		let base = Vec3{x: 1.0, y: 1.0, z: 1.0}
		if light.kind == "distant" {
			let az = light.azimuth * Pi / 180.0
			let el = light.elevation * Pi / 180.0
			base = Vec3{x: cos(az) * cos(el), y: sin(az) * cos(el), z: sin(el)}
		}
		let dir = v3norm(Vec3{x: px - lx, y: py - ly, z: pz - lz})
		let lc = p.color.rgba
		let setup = LightSetup{lx: lx, ly: ly, lz: lz, bx: base.x, by: base.y, bz: base.z, dx: dir.x, dy: dir.y, dz: dir.z, cosine: cos(light.cone * Pi / 180.0), cr: float(lc.r), cg: float(lc.g), cb: float(lc.b)}
		bands.forRows(w, h, def (from int, to int) {
			lightRows(p, setup, img, out, from, to)
		})
	}

	// Rows `from` to `to` of a lighting primitive.
	internal def lightRows(p Primitive, s LightSetup, img FImage, out FImage, from int, to int) {
		let w = img.w
		let h = img.h
		let light = p.light
		let distant = light.kind == "distant"
		let spot = light.kind == "spot"
		let specular = p.kind == "specular"
		let unit = (p.exponentS - 1.0).abs() < 1e-7
		let a = img.px
		for let y = from; y < to; y++ {
			for let x = 0; x < w; x++ {
				let o = (y * w + x) * 4
				// The unit vector towards the light.
				let lvx = s.bx
				let lvy = s.by
				let lvz = s.bz
				if !distant {
					lvx = s.lx - float(x)
					lvy = s.ly - float(y)
					lvz = s.lz - float(a[o + 3]) / 255.0 * p.surface
					let l = sqrt(lvx * lvx + lvy * lvy + lvz * lvz)
					if l.abs() >= 1e-7 {
						lvx = lvx / l
						lvy = lvy / l
						lvz = lvz / l
					}
				}
				// The light's colour, a spot light's cone and fall-off applied.
				let cr = s.cr
				let cg = s.cg
				let cb = s.cb
				if spot {
					let mls = -(lvx * s.dx + lvy * s.dy + lvz * s.dz)
					if mls <= 0.0 || (light.hasCone && mls < s.cosine) {
						cr = 0.0
						cg = 0.0
						cb = 0.0
					} else {
						let f = ((mls) ** (light.specular))
						cr = (cr * f).clamp(0.0, 255.0).floor() + 0.0
						cg = (cg * f).clamp(0.0, 255.0).floor() + 0.0
						cb = (cb * f).clamp(0.0, 255.0).floor() + 0.0
					}
				}
				// The surface normal from the alpha channel (Sobel); the
				// spec's edge kernels on the border.
				let fx = 0.25
				let fy = 0.25
				let nx = 0.0
				let ny = 0.0
				if x > 0 && x < w - 1 && y > 0 && y < h - 1 {
					let up = o - w * 4
					let down = o + w * 4
					let tl = float(a[up - 1])
					let tc = float(a[up + 3])
					let tr = float(a[up + 7])
					let ml = float(a[o - 1])
					let mr = float(a[o + 7])
					let bl = float(a[down - 1])
					let bc = float(a[down + 3])
					let br = float(a[down + 7])
					nx = -(-tl + tr - 2.0 * ml + 2.0 * mr - bl + br)
					ny = -(-tl - 2.0 * tc - tr + bl + 2.0 * bc + br)
				} else {
					let (efx, efy, enx, eny) = surfaceNormal(img, x, y)
					fx = efx
					fy = efy
					nx = enx
					ny = eny
				}
				let factor = 0.0
				let flat = nx.abs() < 1e-7 && ny.abs() < 1e-7
				let nvx = nx * p.surface / 255.0 * fx
				let nvy = ny * p.surface / 255.0 * fy
				let nlen = sqrt(nvx * nvx + nvy * nvy + 1.0 * 1.0)
				if specular {
					let hz = lvz + 1.0
					let hl = sqrt(lvx * lvx + lvy * lvy + hz * hz)
					if hl.abs() > 1e-7 {
						let ndoth = flat ?? (hz / hl, (nvx * lvx + nvy * lvy + 1.0 * hz) / nlen / hl)
						factor = p.constant * (unit ?? (ndoth, ((ndoth) ** (p.exponentS))))
					}
				} else {
					let k = flat ?? (lvz, (nvx * lvx + nvy * lvy + 1.0 * lvz) / nlen)
					factor = p.constant * k
				}
				let r = byte((cr * factor).clamp(0.0, 255.0) + 0.5)
				let g = byte((cg * factor).clamp(0.0, 255.0) + 0.5)
				let b = byte((cb * factor).clamp(0.0, 255.0) + 0.5)
				out.px[o] = r
				out.px[o + 1] = g
				out.px[o + 2] = b
				out.px[o + 3] = specular ?? (r.max(g).max(b), byte(255))
			}
		}
	}

	// The spec's Perlin turbulence: lattice and gradients from the seed.
	internal type Noise2 {
		lattice  int[]
		gradient float[]
		// The gradients again by lattice point, the four channels together:
		// x components at gx[b * 4 + channel], y at gy.
		gx       float[]
		gy       float[]

		def new(seedIn int) {
			let seed = seedIn
			lattice.len(514)
			gradient.len(4 * 514 * 2)
			if seed <= 0 {
				seed = -(seed % 2147483646) + 1
			}
			seed = 2147483646 when seed > 2147483646
			for let k = 0; k < 4; k++ {
				for let i = 0; i < 256; i++ {
					lattice[i] = i
					for let j = 0; j < 2; j++ {
						seed = nextRandom(seed)
						gradient[(k * 514 + i) * 2 + j] = float((seed % 512) - 256) / 256.0
					}
					let gx = gradient[(k * 514 + i) * 2]
					let gy = gradient[(k * 514 + i) * 2 + 1]
					let s = sqrt(gx * gx + gy * gy)
					gradient[(k * 514 + i) * 2] = gx / s
					gradient[(k * 514 + i) * 2 + 1] = gy / s
				}
			}
			for let i = 255; i > 0; i-- {
				let k = lattice[i]
				seed = nextRandom(seed)
				let j = seed % 256
				lattice[i] = lattice[j]
				lattice[j] = k
			}
			for let i = 0; i < 258; i++ {
				lattice[256 + i] = lattice[i]
				for let k = 0; k < 4; k++ {
					gradient[(k * 514 + 256 + i) * 2] = gradient[(k * 514 + i) * 2]
					gradient[(k * 514 + 256 + i) * 2 + 1] = gradient[(k * 514 + i) * 2 + 1]
				}
			}
			gx.len(514 * 4)
			gy.len(514 * 4)
			for let b = 0; b < 514; b++ {
				for let k = 0; k < 4; k++ {
					gx[b * 4 + k] = gradient[(k * 514 + b) * 2]
					gy[b * 4 + k] = gradient[(k * 514 + b) * 2 + 1]
				}
			}
		}
	}

	internal def nextRandom(seed int) int {
		let r = 16807 * (seed % 127773) - 2836 * (seed / 127773)
		return r <= 0 ?? (r + 2147483647, r)
	}

	// feTurbulence into straight colours, rows in bands on tasks.
	internal def turbulence(out FImage, offX float, offY float, sx float, sy float, p Primitive) {
		let noise = new Noise2(p.seed)
		bands.forRows(out.w, out.h, def (from int, to int) {
			turbulenceRows(noise, out, offX, offY, sx, sy, p, from, to)
		})
	}

	// Rows `from` to `to` of the turbulence: each octave's noise for the
	// four channels at once, their lattice lookups shared.
	internal def turbulenceRows(noise Noise2, out FImage, offX float, offY float, sx float, sy float, p Primitive, from int, to int) {
		let w = out.w
		let h = out.h
		let lattice = noise.lattice
		let zero = simd.splat4<float>(0.0)
		let top = simd.splat4<float>(255.0)
		let half = simd.splat4<float>(0.5)
		for let y = from; y < to; y++ {
			for let x = 0; x < w; x++ {
				let tx = (float(x) + offX) / sx
				let ty = (float(y) + offY) / sy
				let (fx, fy, sw0, sh0, wx0, wy0) = stitching(float(x), float(y), float(w), float(h), p)
				let sw = sw0
				let sh = sh0
				let wx = wx0
				let wy = wy0
				let sum = zero
				let nxp = tx * fx
				let nyp = ty * fy
				let ratio = 1.0
				for let o = 0; o < p.octaves; o++ {
					let t = nxp + 4096.0
					let bx0 = int(t)
					let bx1 = bx0 + 1
					let rx0 = t - float(int(t))
					let rx1 = rx0 - 1.0
					let u = nyp + 4096.0
					let by0 = int(u)
					let by1 = by0 + 1
					let ry0 = u - float(int(u))
					let ry1 = ry0 - 1.0
					if p.stitch {
						bx0 -= sw when bx0 >= wx
						bx1 -= sw when bx1 >= wx
						by0 -= sh when by0 >= wy
						by1 -= sh when by1 >= wy
					}
					let i = lattice[bx0 & 255]
					let j = lattice[bx1 & 255]
					let b00 = lattice[i + (by0 & 255)] * 4
					let b10 = lattice[j + (by0 & 255)] * 4
					let b01 = lattice[i + (by1 & 255)] * 4
					let b11 = lattice[j + (by1 & 255)] * 4
					let vx0 = simd.splat4<float>(rx0)
					let vx1 = simd.splat4<float>(rx1)
					let vy0 = simd.splat4<float>(ry0)
					let vy1 = simd.splat4<float>(ry1)
					let ssx = simd.splat4<float>(rx0 * rx0 * (3.0 - 2.0 * rx0))
					let ssy = simd.splat4<float>(ry0 * ry0 * (3.0 - 2.0 * ry0))
					let q00 = vx0 * simd.load4<float>(noise.gx, b00) + vy0 * simd.load4<float>(noise.gy, b00)
					let q10 = vx1 * simd.load4<float>(noise.gx, b10) + vy0 * simd.load4<float>(noise.gy, b10)
					let q01 = vx0 * simd.load4<float>(noise.gx, b01) + vy1 * simd.load4<float>(noise.gy, b01)
					let q11 = vx1 * simd.load4<float>(noise.gx, b11) + vy1 * simd.load4<float>(noise.gy, b11)
					let a = q00 + ssx * (q10 - q00)
					let bb = q01 + ssx * (q11 - q01)
					let n = a + ssy * (bb - a)
					sum = sum + (p.fractal ?? (n, simd.abs(n))) / simd.splat4<float>(ratio)
					nxp *= 2.0
					nyp *= 2.0
					ratio *= 2.0
					if p.stitch {
						sw *= 2
						wx = 2 * wx - 4096
						sh *= 2
						wy = 2 * wy - 4096
					}
				}
				let v = p.fractal ?? ((sum * top + top) / simd.splat4<float>(2.0), sum * top)
				simd.store4<byte>(out.px, (y * w + x) * 4, simd.convert<float, byte>(simd.max(zero, simd.min(top, v)) + half))
			}
		}
	}

	// The base frequencies and stitching state for a tile at (tileX,
	// tileY) of the given size: frequencies adjusted so the tile repeats,
	// the stitch width and height, and where wrapping starts.
	internal def stitching(tileX float, tileY float, tileW float, tileH float, p Primitive) (float, float, int, int, int, int) {
		let fx = p.freqX
		let fy = p.freqY
		return (fx, fy, 0, 0, 0, 0) unless p.stitch
		if fx != 0.0 {
			let lo = (tileW * fx).floor() / tileW
			let hi = (tileW * fx).ceil() / tileW
			fx = fx / lo < hi / fx ?? (lo, hi)
		}
		if fy != 0.0 {
			let lo = (tileH * fy).floor() / tileH
			let hi = (tileH * fy).ceil() / tileH
			fy = fy / lo < hi / fy ?? (lo, hi)
		}
		let sw = int(tileW * fx + 0.5)
		let sh = int(tileH * fy + 0.5)
		return (fx, fy, sw, sh, int(tileX * fx + 4096.0 + float(sw)), int(tileY * fy + 4096.0 + float(sh)))
	}

	// feImage: an element drawn in the user space of the filtered one, or
	// an image fitted into the primitive's subregion.
	internal def feImage(r Renderer, p Primitive, ts Transform2D, src FImage) FImage {
		let c = new Canvas(src.w.max(1), src.h.max(1))
		c.setTransform(new Transform2D(tx = -float(src.x0), ty = -float(src.y0)).then(ts))
		let node = p.imageNode
		if node is Node {
			// An element is drawn from the subregion's corner, at the
			// device scale, as resvg places it.
			let (sx, sy) = scaleOf(ts)
			let (bx0, by0, _, _) = deviceBox(p.region, ts)
			c.setTransform(new Transform2D(a = sx, d = sy, tx = float(bx0 - src.x0), ty = float(by0 - src.y0)))
		}
		let key = node is Node ?? ("feImage:" + orEmpty(node.attr("id")), "")
		if node is Node && r.active.indexOf(key) < 0 {
			r.active.push(key)
			let ctx = Ctx{st: treeStyle(r.doc, node), units: Units{width: 100.0, height: 100.0, fontSize: defaultFontSize, rootSize: defaultFontSize}, ctxFill: none, ctxStroke: none}
			r.node(c, node, Ctx{st: new Style(), units: ctx.units, ctxFill: none, ctxStroke: none})
			r.active.pop()
		} else if node is none && p.imageBytes.len() > 0 {
			let region = p.region
			let nested = parseDocument(p.imageBytes)
			if nested is Document {
				let (iw, ih) = documentSize(nested)
				animate(nested, r.time)
				c.transform(viewBoxTransform(Rect{left: 0.0, top: 0.0, right: iw, bottom: ih}, p.aspect, region.left, region.top, region.right - region.left, region.bottom - region.top))
				let inner = new Renderer(nested, src.w, src.h)
				inner.time = r.time
				inner.draw(c, iw, ih)
			} else {
				let img = images.load(p.imageBytes)
				if !(img is error) {
					let size = img.size()
					let iw = float(size.width)
					let ih = float(size.height)
					c.clip(region)
					c.transform(viewBoxTransform(Rect{left: 0.0, top: 0.0, right: iw, bottom: ih}, p.aspect, region.left, region.top, region.right - region.left, region.bottom - region.top))
					c.drawImage(img, Rect{left: 0.0, top: 0.0, right: iw, bottom: ih}, p.nearest ?? (Sampling.Nearest, Sampling.Bilinear))
				}
			}
		}
		return FImage{px: premultiplied(c.pixels), w: src.w, h: src.h, x0: 0, y0: 0, x1: src.w, y1: src.h, linear: false}
	}
}
