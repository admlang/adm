// Markers at the vertices of paths, lines, polylines and polygons, and the
// object bounding box of any element.

internal std partial module std.formats.image.svgrender {
	use (
		std.gfx.canvas::(Painter)
		std.math::(atan2, Pi, sin, cos)
		std.math.geom::(Path, PathVerb, Rect, Transform2D)
		std.gfx.color::(Color)
	)

	// A vertex of a path: where it is, and the directions of the segments
	// into and out of it (radians; equal at the ends).
	internal struct Vertex {
		x     float
		y     float
		into  float
		out   float
		start bool
		end   bool
	}

	// The vertices markers go on: every segment end, subpath starts
	// included, with the tangents SVG's auto orientation bisects.
	internal def vertices(p Path) Vertex[] {
		let out Vertex[]
		let pts = p.coords
		let j = 0
		let cx = 0.0
		let cy = 0.0
		let sx = 0.0
		let sy = 0.0
		let startIndex = -1
		// The outgoing direction of the subpath's first segment, for a
		// closing vertex.
		let firstOut = 0.0
		let haveFirst = false
		for let (_, v) in p.verbs {
			match v {
				case PathVerb.Move:
					cx = pts[j]
					cy = pts[j + 1]
					sx = cx
					sy = cy
					j += 2
					out.push(Vertex{x: cx, y: cy, into: 0.0, out: 0.0, start: true, end: false})
					startIndex = out.len() - 1
					haveFirst = false
				case PathVerb.Line:
					let x = pts[j]
					let y = pts[j + 1]
					j += 2
					let dir = angleOf(cx, cy, x, y)
					segment(out, dir, dir, x, y, firstOut, haveFirst)
					if !haveFirst {
						firstOut = dir
						haveFirst = true
					}
					cx = x
					cy = y
				case PathVerb.Quad:
					let d0 = tangent(cx, cy, pts[j], pts[j + 1], pts[j + 2], pts[j + 3])
					let d1 = tangent(pts[j + 2], pts[j + 3], pts[j], pts[j + 1], cx, cy) + Pi
					segment(out, d0, d1, pts[j + 2], pts[j + 3], firstOut, haveFirst)
					if !haveFirst {
						firstOut = d0
						haveFirst = true
					}
					cx = pts[j + 2]
					cy = pts[j + 3]
					j += 4
				case PathVerb.Cubic:
					let d0 = tangent3(cx, cy, pts[j], pts[j + 1], pts[j + 2], pts[j + 3], pts[j + 4], pts[j + 5])
					let d1 = tangent3(pts[j + 4], pts[j + 5], pts[j + 2], pts[j + 3], pts[j], pts[j + 1], cx, cy) + Pi
					segment(out, d0, d1, pts[j + 4], pts[j + 5], firstOut, haveFirst)
					if !haveFirst {
						firstOut = d0
						haveFirst = true
					}
					cx = pts[j + 4]
					cy = pts[j + 5]
					j += 6
				case PathVerb.Close:
					let dir = angleOf(cx, cy, sx, sy)
					if cx != sx || cy != sy {
						segment(out, dir, dir, sx, sy, firstOut, haveFirst)
					}
					// The closing vertex joins the last segment to the first.
					let last = out[out.len() - 1]
					last.out = haveFirst ?? (firstOut, last.into)
					out[out.len() - 1] = last
					if startIndex >= 0 {
						let first = out[startIndex]
						first.into = last.into
						out[startIndex] = first
					}
					cx = sx
					cy = sy
			}
		}
		if out.len() > 0 {
			let last = out[out.len() - 1]
			last.end = true
			out[out.len() - 1] = last
		}
		return out
	}

	// Ends a segment of directions d0 (leaving) and d1 (arriving) at (x, y).
	internal def segment(out Vertex[], d0 float, d1 float, x float, y float, firstOut float, haveFirst bool) {
		if out.len() > 0 {
			let prev = out[out.len() - 1]
			prev.out = d0
			prev.into = d0 when prev.start && !haveFirst
			out[out.len() - 1] = prev
		}
		out.push(Vertex{x: x, y: y, into: d1, out: d1, start: false, end: false})
	}

	internal def angleOf(x0 float, y0 float, x1 float, y1 float) float {
		return atan2(y1 - y0, x1 - x0)
	}

	// The direction leaving (x0, y0) toward the first control point that
	// differs from it.
	internal def tangent(x0 float, y0 float, x1 float, y1 float, x2 float, y2 float) float {
		return angleOf(x0, y0, x1, y1) unless x1 == x0 && y1 == y0
		return angleOf(x0, y0, x2, y2)
	}

	internal def tangent3(x0 float, y0 float, x1 float, y1 float, x2 float, y2 float, x3 float, y3 float) float {
		return angleOf(x0, y0, x1, y1) unless x1 == x0 && y1 == y0
		return angleOf(x0, y0, x2, y2) unless x2 == x0 && y2 == y0
		return angleOf(x0, y0, x3, y3)
	}

	// The marker angle at a vertex: the bisector of the two directions.
	internal def bisect(a float, b float) float {
		let d = b - a
		for d > Pi {
			d -= 2.0 * Pi
		}
		for d < -Pi {
			d += 2.0 * Pi
		}
		return a + d / 2.0
	}

	// Draws the element's markers on its path.
	internal def drawMarkers(r Renderer, p Painter, n Node, ctx Ctx, path Path) {
		let startRef = ctx.st.get("marker-start", "none")
		let midRef = ctx.st.get("marker-mid", "none")
		let endRef = ctx.st.get("marker-end", "none")
		return when startRef.lower() == "none" && midRef.lower() == "none" && endRef.lower() == "none"
		let vs = vertices(path)
		return when vs.len() == 0
		let sw = strokeWidthOf(ctx)
		for let (i, v) in vs {
			let ref = i == 0 ?? (startRef, i == vs.len() - 1 ?? (endRef, midRef))
			continue when ref.lower() == "none"
			let marker = r.doc.resolve(ref)
			continue unless marker is Node && marker.tag == "marker"
			drawMarker(r, p, marker, ctx, v, i == 0, sw)
		}
	}

	internal def strokeWidthOf(ctx Ctx) float {
		let l = parseLength(ctx.st.get("stroke-width", "1"))
		return l is none ?? (1.0, toUser(l, ctx.units, ""))
	}

	internal def drawMarker(r Renderer, p Painter, m Node, ctx Ctx, v Vertex, first bool, strokeWidth float) {
		let id = refId("#" + (orEmpty(m.attr("id"))))
		return when r.active.indexOf(id) >= 0
		let mstyle = treeStyle(r.doc, m)
		return when mstyle.get("display").lower() == "none"
		let w = lengthOf(m, "markerWidth", ctx.units, "x", 3.0)
		let h = lengthOf(m, "markerHeight", ctx.units, "y", 3.0)
		return when w <= 0.0 || h <= 0.0
		let orient = orEmpty(m.attr("orient")).trim()
		orient = "0" when orient == ""
		let angle = 0.0
		if orient == "auto" {
			angle = v.start && !v.end ?? (v.out, bisect(v.into, v.out))
			angle = v.into when v.end && !v.start
		} else if orient == "auto-start-reverse" {
			angle = v.start && !v.end ?? (v.out, bisect(v.into, v.out))
			angle = v.into when v.end && !v.start
			angle += Pi when first
		} else {
			angle = angleValue(orient) * Pi / 180.0
		}
		let scale = (orEmpty(m.attr("markerUnits"))).trim() == "userSpaceOnUse" ?? (1.0, strokeWidth)
		let t = new Transform2D(tx = v.x, ty = v.y).then(new Transform2D(a = cos(angle), b = sin(angle), c = -sin(angle), d = cos(angle))).then(new Transform2D(a = scale, d = scale))
		let box = viewBoxOf(m)
		let refX = lengthOf(m, "refX", ctx.units, "x", 0.0)
		let refY = lengthOf(m, "refY", ctx.units, "y", 0.0)
		let content = new Transform2D()
		if box is Rect {
			let ar = parseAspectRatio(orEmpty(m.attr("preserveAspectRatio")))
			content = viewBoxTransform(box, ar, 0.0, 0.0, w, h)
		}
		// refX, refY in the marker's content units land on the vertex.
		let rx = content.a * refX + content.c * refY + content.tx
		let ry = content.b * refX + content.d * refY + content.ty
		r.active.push(id)
		p.save()
		p.transform(t)
		p.transform(new Transform2D(tx = -rx, ty = -ry))
		let overflow = mstyle.get("overflow", "hidden").lower()
		p.clip(Rect{left: 0.0, top: 0.0, right: w, bottom: h}) unless (overflow := "visible" || "auto")
		p.transform(content)
		let fill = r.paintSpec(ctx, "fill", "black")
		let stroke = r.paintSpec(ctx, "stroke", "none")
		let mctx = Ctx{st: mstyle, units: ctx.units, ctxFill: fill, ctxStroke: stroke}
		r.children(p, m, mctx)
		p.restore()
		r.active.pop()
	}

	// An angle in degrees (`45`, `45deg`, `0.5turn`, `1rad`, `100grad`).
	internal def angleValue(text string) float {
		let t = text.trim().lower()
		let n = parseNumber(t)
		return n when n is float
		if t.endsWith("deg") {
			let v = parseNumber(t[:t.len() - 3])
			return v is none ?? (0.0, v)
		}
		if t.endsWith("grad") {
			let v = parseNumber(t[:t.len() - 4])
			return v is none ?? (0.0, v * 0.9)
		}
		if t.endsWith("rad") {
			let v = parseNumber(t[:t.len() - 3])
			return v is none ?? (0.0, v * 180.0 / Pi)
		}
		if t.endsWith("turn") {
			let v = parseNumber(t[:t.len() - 4])
			return v is none ?? (0.0, v * 360.0)
		}
		return 0.0
	}

	// The object bounding box of an element in its own user space: its
	// fill geometry (or its children's through their transforms); none for
	// an element that has none.
	internal def objectBox(r Renderer, n Node, ctx Ctx) ?Rect {
		match n.tag {
			case "rect", "circle", "ellipse", "line", "polyline", "polygon", "path":
				let p = shapePath(n, ctx.units)
				return none when p is none
				return p.bounds()
			case "g", "a", "switch", "svg", "symbol":
				let out ?Rect = none
				for let (_, c) in n.children {
					continue when c.isText || c.tag == ""
					let cctx = r.enter(c, ctx)
					continue when cctx.st.get("display").lower() == "none"
					let b = objectBox(r, c, cctx)
					continue when b is none
					let t = r.elementTransform(c, cctx)
					let placed = t is Transform2D ?? (boxAfter(t, b), b)
					out = unionBox(out, placed)
				}
				return out
			case "use":
				let href = n.attr("href")
				return none when href is none
				let target = r.doc.resolve(href)
				return none when target is none || contains(target, n)
				let b = objectBox(r, target, r.enter(target, ctx))
				return none when b is none
				let x = lengthOf(n, "x", ctx.units, "x", 0.0)
				let y = lengthOf(n, "y", ctx.units, "y", 0.0)
				return Rect{left: b.left + x, top: b.top + y, right: b.right + x, bottom: b.bottom + y}
			case "image":
				let w = lengthOf(n, "width", ctx.units, "x", 0.0)
				let h = lengthOf(n, "height", ctx.units, "y", 0.0)
				let x = lengthOf(n, "x", ctx.units, "x", 0.0)
				let y = lengthOf(n, "y", ctx.units, "y", 0.0)
				return Rect{left: x, top: y, right: x + w, bottom: y + h}
		}
		return none
	}

	// Coverage of `<text>` inside a clip path.
	internal def textCoverage(r Renderer, p Painter, n Node, ctx Ctx, white Color) {
		textCoverageOf(r, p, n, ctx, white)
	}
}
