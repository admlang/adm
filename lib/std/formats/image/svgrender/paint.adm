// Paint servers: linear and radial gradients and patterns, with what they
// inherit through `href`, their units and their transforms.

internal std partial module std.formats.image.svgrender {
	use (
		std.gfx.canvas::(Paint, Painter, ColorStop, ColorSpace, LinearGradient, RadialGradient, Pattern, Picture, Spread, record)
		std.gfx.color::(Color, RGBA)
		std.math::(sqrt)
		std.math.geom::(Point, Rect, Transform2D)
		std.units::(Percent)
	)

	// What a paint server gives a fill: a canvas paint in the space
	// `transform` maps to user space, the alpha to draw it at, or `none`
	// when the server draws nothing (no stops, an empty box).
	internal struct ServerPaint {
		skip      bool
		paint     Paint
		transform Transform2D
		alpha     float
	}

	internal def noPaint() ServerPaint {
		return ServerPaint{skip: true, paint: new Color(RGBA{r: 0, g: 0, b: 0, a: 0}), transform: new Transform2D(), alpha: 1.0}
	}

	// The element of the `href` chain of `n` (itself first) that has
	// attribute `name`, none when none does. Chains stop at a cycle.
	internal def chainAttr(doc Document, n Node, name string) ?string {
		let seen Node[]
		let at = n
		// Attributes only one kind of element has come only from elements
		// of that kind; the shared ones (units, transform, spread, href)
		// from any gradient or pattern of the chain.
		let shared = (name := "gradientUnits" || "gradientTransform" || "spreadMethod")
		for {
			let v = at.attr(name)
			return v when v is string && (shared || at.tag == n.tag)
			seen.push(at)
			let href = at.attr("href")
			return none when href is none
			let next = doc.resolve(href)
			return none when next is none || seen.indexOf(next) >= 0
			return none unless (next.tag := "linearGradient" || "radialGradient" || "pattern")
			at = next
		}
		return none
	}

	// The first element of the chain with stop children (gradients), or
	// with element children (patterns).
	internal def chainContent(doc Document, n Node, stops bool) ?Node {
		let seen Node[]
		let at = n
		for {
			for let (_, c) in at.children {
				if stops {
					return at when c.tag == "stop"
				} else {
					return at when !c.isText && c.tag != ""
				}
			}
			seen.push(at)
			let href = at.attr("href")
			return none when href is none
			let next = doc.resolve(href)
			return none when next is none || seen.indexOf(next) >= 0
			return none unless (next.tag := "linearGradient" || "radialGradient" || "pattern")
			at = next
		}
		return none
	}

	// `t` about the element's transform-origin, in `units`.
	internal def aroundOrigin(n Node, t Transform2D, units Units) Transform2D {
		let origin = n.attr("transform-origin")
		return t when origin is none
		let (ox, oy) = originOf(origin, units)
		let there = new Transform2D(tx = ox, ty = oy)
		return there.then(t).then(new Transform2D(tx = -ox, ty = -oy))
	}

	// Units where percentages are fractions of a unit box.
	internal def unitBox() Units {
		return Units{width: 1.0, height: 1.0, fontSize: 1.0}
	}

	// A stop offset: a number or a percentage; anything else is 0.
	internal def stopOffset(text ?string) float {
		return 0.0 when text is none
		let l = parseLength(text)
		return 0.0 when l is none
		return l.value / 100.0 when l.unit == "%"
		return l.unit == "" ?? (l.value, 0.0)
	}

	// A number or percentage in objectBoundingBox units.
	internal def fraction(text ?string, otherwise float) float {
		return otherwise when text is none
		let l = parseLength(text)
		return otherwise when l is none
		return l.unit == "%" ?? (l.value / 100.0, l.value)
	}

	// The gradient's stops, offsets clamped and made non-decreasing,
	// opacities folded into the colours; colours from each stop's style.
	internal def gradientStops(r Renderer, n Node, opacity float) ColorStop[] {
		let out ColorStop[]
		let holder = chainContent(r.doc, n, true)
		return out when holder is none
		let last = 0.0
		for let (_, s) in holder.children {
			continue unless s.tag == "stop"
			let st = treeStyle(r.doc, s)
			let off = stopOffset(s.attr("offset")).clamp(0.0, 1.0)
			off = off.max(last)
			last = off
			let current = colorOf(st)
			let parsed = parseColor(st.get("stop-color", "black"), current)
			let c = parsed is none ?? (new Color(RGBA{r: 0, g: 0, b: 0, a: 255}), parsed)
			let a = parseOpacity(st.get("stop-opacity", "1")) * opacity
			out.push(ColorStop{offset: off * 100.0 * 1(%), color: withAlpha(c, a)})
		}
		return out
	}

	// The style a node has in the document tree, for elements read by
	// reference (stops, pattern contents): its ancestors' inherited values
	// under its own.
	internal def treeStyle(doc Document, target Node) Style {
		let path Node[]
		if !findPath(doc.root, target, path) {
			return new Style().child(target.props)
		}
		let s = new Style()
		for let (_, n) in path {
			s = s.child(n.props)
		}
		return s
	}

	internal def findPath(at Node, target Node, path Node[]) bool {
		path.push(at)
		return true when at == target
		for let (_, c) in at.children {
			continue when c.isText
			return true when findPath(c, target, path)
		}
		path.pop()
		return false
	}

	internal def spreadOf(text ?string) Spread {
		return Spread.Pad when text is none
		let t = text.trim()
		return Spread.Reflect when t == "reflect"
		return Spread.Repeat when t == "repeat"
		return Spread.Pad
	}

	// The paint `server` gives a shape whose fill box is `bbox`.
	internal def paintServer(r Renderer, p Painter, server Node, ctx Ctx, bbox Rect, opacity float) ?ServerPaint {
		match server.tag {
			case "linearGradient", "radialGradient":
				return gradientPaint(r, server, ctx, bbox, opacity)
			case "pattern":
				return patternPaint(r, server, ctx, bbox, opacity)
		}
		return none
	}

	internal def gradientPaint(r Renderer, g Node, ctx Ctx, bbox Rect, opacity float) ServerPaint {
		let stops = gradientStops(r, g, opacity)
		return noPaint() when stops.len() == 0
		if stops.len() == 1 {
			return ServerPaint{skip: false, paint: stops[0].color, transform: new Transform2D(), alpha: 1.0}
		}
		let doc = r.doc
		let userSpace = (orEmpty(chainAttr(doc, g, "gradientUnits"))).trim() == "userSpaceOnUse"
		let w = bbox.right - bbox.left
		let h = bbox.bottom - bbox.top
		if !userSpace && (w <= 0.0 || h <= 0.0) {
			return noPaint()
		}
		let t = userSpace ?? (new Transform2D(), new Transform2D(a = w, d = h, tx = bbox.left, ty = bbox.top))
		let gt = chainAttr(doc, g, "gradientTransform")
		if gt is string {
			let parsed = parseTransform(gt)
			// A transform that cannot be undone is ignored.
			if parsed is Transform2D && invertible(parsed) {
				t = t.then(aroundOrigin(g, parsed, userSpace ?? (ctx.units, unitBox())))
			}
		}
		let spread = spreadOf(chainAttr(doc, g, "spreadMethod"))
		let coord = (name string, axis string, otherwise string) => gradientCoord(doc, g, name, axis, otherwise, userSpace, ctx.units)
		if g.tag == "linearGradient" {
			let x1 = coord("x1", "x", "0%")
			let y1 = coord("y1", "y", "0%")
			let x2 = coord("x2", "x", "100%")
			let y2 = coord("y2", "y", "0%")
			if x1 == x2 && y1 == y2 {
				// A zero-length gradient paints its last colour.
				return ServerPaint{skip: false, paint: stops[stops.len() - 1].color, transform: new Transform2D(), alpha: 1.0}
			}
			return ServerPaint{skip: false, paint: new LinearGradient(new Point(x1, y1), new Point(x2, y2), stops, spread, ColorSpace.SRGB, premultiplied = false), transform: t, alpha: 1.0}
		}
		let cx = coord("cx", "x", "50%")
		let cy = coord("cy", "y", "50%")
		let radius = coord("r", "", "50%")
		let fx = chainAttr(doc, g, "fx") is none ?? (cx, coord("fx", "x", "50%"))
		let fy = chainAttr(doc, g, "fy") is none ?? (cy, coord("fy", "y", "50%"))
		let fr = coord("fr", "", "0%")
		if radius <= 0.0 {
			return ServerPaint{skip: false, paint: stops[stops.len() - 1].color, transform: new Transform2D(), alpha: 1.0}
		}
		return ServerPaint{skip: false, paint: new RadialGradient(new Point(cx, cy), radius, stops, new Point(fx, fy), fr.max(0.0), spread, ColorSpace.SRGB, premultiplied = false), transform: t, alpha: 1.0}
	}

	// A gradient coordinate: in user units against the viewport, or a
	// fraction of the box.
	internal def gradientCoord(doc Document, g Node, name string, axis string, otherwise string, userSpace bool, u Units) float {
		let text = chainAttr(doc, g, name)
		let t = text is none ?? (otherwise, text)
		for let (_, candidate) in [t, otherwise] {
			let v = parseLength(candidate)
			if v is Length {
				return toUser(v, u, axis) when userSpace
				return v.unit == "%" ?? (v.value / 100.0, v.value)
			}
		}
		return 0.0
	}

	// A pattern: its contents recorded once, tiled over the shape.
	internal def patternPaint(r Renderer, pat Node, ctx Ctx, bbox Rect, opacity float) ServerPaint {
		let doc = r.doc
		let unitsUser = (orEmpty(chainAttr(doc, pat, "patternUnits"))).trim() == "userSpaceOnUse"
		let contentBox = (orEmpty(chainAttr(doc, pat, "patternContentUnits"))).trim() == "objectBoundingBox"
		let bw = bbox.right - bbox.left
		let bh = bbox.bottom - bbox.top
		let num = (name string, axis string) => patternLength(doc, pat, name, axis, unitsUser, ctx.units, bbox)
		let x = num("x", "x")
		let y = num("y", "y")
		let w = num("width", "x")
		let h = num("height", "y")
		return noPaint() when w <= 0.0 || h <= 0.0
		let holder = chainContent(doc, pat, false)
		return noPaint() when holder is none
		let box ?Rect = none
		let vb = chainAttr(doc, pat, "viewBox")
		if vb is string {
			let parsed = parseViewBox(vb)
			box = parsed when parsed is Rect && parsed.right > parsed.left && parsed.bottom > parsed.top
		}
		let content = new Transform2D(tx = x, ty = y)
		if box is Rect {
			let ar = parseAspectRatio(orEmpty(chainAttr(doc, pat, "preserveAspectRatio")))
			content = viewBoxTransform(box, ar, x, y, w, h)
		} else if contentBox {
			return noPaint() when bw <= 0.0 || bh <= 0.0
			content = content.then(new Transform2D(a = bw, d = bh))
		}
		// A pattern reached again while its own content is being recorded
		// would never end: it paints nothing there.
		let key = "pattern:" + orEmpty(pat.attr("id"))
		return noPaint() when r.active.indexOf(key) >= 0
		let patternStyle = treeStyle(doc, holder)
		let inner = Ctx{st: patternStyle, units: ctx.units, ctxFill: none, ctxStroke: none}
		r.active.push(key)
		let picture = record(def (painter Painter) {
			painter.transform(content)
			r.children(painter, holder, inner)
		})
		r.active.pop()
		let t = new Transform2D()
		let pt = chainAttr(doc, pat, "patternTransform")
		if pt is string {
			let parsed = parseTransform(pt)
			t = aroundOrigin(pat, parsed, ctx.units) when parsed is Transform2D && invertible(parsed)
		}
		let tile = Rect{left: x, top: y, right: x + w, bottom: y + h}
		return ServerPaint{skip: false, paint: new Pattern(picture, tile), transform: t, alpha: opacity}
	}

	internal def patternLength(doc Document, pat Node, name string, axis string, userSpace bool, u Units, bbox Rect) float {
		let text = chainAttr(doc, pat, name)
		return 0.0 when text is none
		let l = parseLength(text)
		return 0.0 when l is none
		return toUser(l, u, axis) when userSpace
		let f = l.unit == "%" ?? (l.value / 100.0, l.value)
		let bw = bbox.right - bbox.left
		let bh = bbox.bottom - bbox.top
		match name {
			case "x":
				return bbox.left + f * bw
			case "y":
				return bbox.top + f * bh
			case "width":
				return f * bw
		}
		return f * bh
	}
}
