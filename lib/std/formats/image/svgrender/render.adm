// Draws a parsed SVG document onto a canvas Painter: viewports, groups with
// opacity, clipping, masking and blending, shapes with their fill, stroke
// and markers, `use`, `switch` and images.

internal std partial module std.formats.image.svgrender {
	use (
		std.os
		std.formats.fonts
		std.formats.image as images
		std.data.encoding::(Base64)
		std.gfx::(Mask)
		std.gfx.canvas::(Canvas, Painter, Paint, Composite, Sampling)
		std.gfx.color::(Color, RGBA, BlendMode)
		std.math::(sqrt)
		std.math.geom::(FillRule, LineCap, LineJoin, Path, PathVerb, Point, Rect, StrokeStyle, Transform2D)
		std.units::(Pixels)
	)

	// The size a document asks to be drawn at: its width and height, from
	// the view box where they are missing or relative; 100 by 100 with
	// neither.
	def documentSize(doc Document) (float, float) {
		let root = doc.root
		let box = viewBoxOf(root)
		let units = Units{width: 100.0, height: 100.0, fontSize: defaultFontSize}
		let w = absoluteLength(root.attr("width"), units, "x")
		let h = absoluteLength(root.attr("height"), units, "y")
		let bw = 100.0
		let bh = 100.0
		if box is Rect {
			bw = box.right - box.left
			bh = box.bottom - box.top
		}
		if w is float {
			if h is float {
				return (w, h)
			}
			return (w, box is none ?? (100.0, w * bh / bw))
		}
		if h is float {
			return (box is none ?? (100.0, h * bw / bh), h)
		}
		return (bw, bh)
	}

	// A width or height attribute in user units, none when missing,
	// relative (a percentage) or invalid.
	internal def absoluteLength(text ?string, u Units, axis string) ?float {
		return none when text is none
		let l = parseLength(text)
		return none when l is none || l.unit == "%"
		return toUser(l, u, axis)
	}

	internal def viewBoxOf(n Node) ?Rect {
		let v = n.attr("viewBox")
		return none when v is none
		let box = parseViewBox(v)
		return none when box is none
		return none when box.right <= box.left || box.bottom <= box.top
		return box
	}

	// Font size of `text` as CSS gives it to SVG when none is set.
	internal const defaultFontSize = 12.0

	// What an element draws under: its computed style and the lengths'
	// references.
	internal struct Ctx {
		st        Style
		units     Units
		// The paints `context-fill` and `context-stroke` stand for inside a
		// marker or a used element.
		ctxFill   ?PaintSpec
		ctxStroke ?PaintSpec
	}

	// Draws documents onto one painter.
	type Renderer {
		doc             Document
		// The device the painter draws on, for the masks clipping and
		// masking build in its pixels.
		deviceW         int
		deviceH         int
		// Ids being drawn through references: a reference back to one of
		// them is a cycle and draws nothing.
		internal active string[]
		// The folder relative hrefs resolve in, empty when the document
		// came as bytes: it then reads no files.
		baseDir         string
		// The image hrefs this document is being drawn inside: an image of
		// one of them is a cycle and draws nothing.
		outer           string[]
		// Faces by font properties, found once per document.
		fontCache       map<string, fonts.Face[]>
		// Seconds since the animations started: nested SVG images show
		// the same moment.
		time            float

		def new(doc Document, deviceW int, deviceH int) {
			self.doc = doc
			self.deviceW = deviceW
			self.deviceH = deviceH
			fontCache = map<string, fonts.Face[]>{}
		}

		// Draws the document into the viewport (0, 0, w, h) of the painter.
		def draw(p Painter, w float, h float) {
			let root = doc.root
			let st = rootStyle().child(root.props)
			let rootSize = fontSizeOf(st, defaultFontSize)
			resolveFont(st, rootStyle(), rootSize)
			let ctx = Ctx{st: st, units: Units{width: w, height: h, fontSize: rootSize, rootSize: rootSize}, ctxFill: none, ctxStroke: none}
			return when st.get("display") == "none" || !conditionsHold(root)
			let bg = parseColor(st.get("background-color", "transparent"), colorOf(st))
			if bg is Color && bg.rgba.a > 0 {
				p.fill(Rect{left: 0.0, top: 0.0, right: w, bottom: h}, bg)
			}
			withEffects(p, root, ctx, false, def (q Painter) {
				self.viewport(q, root, ctx, 0.0, 0.0, w, h, false)
			})
		}

		// Children of a viewport element (svg or symbol) drawn into the box
		// (x, y, w, h): its view box fitted in, clipped unless overflow is
		// visible.
		def viewport(p Painter, n Node, ctx Ctx, x float, y float, w float, h float, clips bool) {
			return when w <= 0.0 || h <= 0.0
			let box = viewBoxOf(n)
			let units = ctx.units
			units.width = w
			units.height = h
			p.save()
			if clips {
				let overflow = ctx.st.get("overflow", "hidden").lower()
				p.clip(Rect{left: x, top: y, right: x + w, bottom: y + h}) unless (overflow := "visible" || "auto")
			}
			if box is Rect {
				let ar = parseAspectRatio(orEmpty(n.attr("preserveAspectRatio")))
				p.transform(viewBoxTransform(box, ar, x, y, w, h))
				units.width = box.right - box.left
				units.height = box.bottom - box.top
			} else {
				p.transform(new Transform2D(tx = x, ty = y))
			}
			let inner = Ctx{st: ctx.st, units: units, ctxFill: ctx.ctxFill, ctxStroke: ctx.ctxStroke}
			children(p, n, inner)
			p.restore()
		}

		def children(p Painter, n Node, ctx Ctx) {
			for let (_, c) in n.children {
				node(p, c, ctx) unless c.isText
			}
		}

		// The context one element draws in: its computed style and its font
		// size for em units.
		def enter(n Node, ctx Ctx) Ctx {
			let st = ctx.st.child(n.props)
			let units = ctx.units
			units.fontSize = fontSizeOf(st, ctx.units.fontSize)
			resolveFont(st, ctx.st, units.fontSize)
			return Ctx{st: st, units: units, ctxFill: ctx.ctxFill, ctxStroke: ctx.ctxStroke}
		}

		// Draws one element.
		def node(p Painter, n Node, parent Ctx) {
			return when n.tag == ""
			let ctx = enter(n, parent)
			return when ctx.st.get("display").lower() == "none" || !conditionsHold(n)
			match n.tag {
				case "g", "a":
					withEffects(p, n, ctx, true, def (q Painter) {
						self.children(q, n, ctx)
					})
				case "svg":
					let x = lengthAttr(n, "x", ctx.units, "x", 0.0)
					let y = lengthAttr(n, "y", ctx.units, "y", 0.0)
					let w = lengthAttr(n, "width", ctx.units, "x", ctx.units.width)
					let h = lengthAttr(n, "height", ctx.units, "y", ctx.units.height)
					withEffects(p, n, ctx, true, def (q Painter) {
						self.viewport(q, n, ctx, x, y, w, h, true)
					})
				case "switch":
					let chosen = switchChild(n)
					if chosen is Node {
						withEffects(p, n, ctx, true, def (q Painter) {
							self.node(q, chosen, ctx)
						})
					}
				case "use":
					drawUse(p, n, ctx)
				case "rect", "circle", "ellipse", "line", "polyline", "polygon", "path":
					let path = shapePath(n, ctx.units)
					if path is Path {
						withEffects(p, n, ctx, true, def (q Painter) {
							self.shape(q, n, ctx, path)
						})
					}
				case "image":
					withEffects(p, n, ctx, true, def (q Painter) {
						self.image(q, n, ctx)
					})
				case "text":
					withEffects(p, n, ctx, true, def (q Painter) {
						self.text(q, n, ctx)
					})
				default:
			}
		}

		// Draws `body` under the element's transform, clip path, mask,
		// opacity and blend mode. `transforms` is false for elements whose
		// `transform` the caller already applied or that take none.
		def withEffects(p Painter, n Node, ctx Ctx, transforms bool, body def (Painter)) {
			let st = ctx.st
			let t = transforms ?? (elementTransform(n, ctx), none)
			let opacity = parseOpacity(st.get("opacity", "1"))
			let clipRef = st.get("clip-path", "none")
			let maskRef = st.get("mask", "none")
			let blend = blendModeOf(st.get("mix-blend-mode", "normal"))
			let isolate = st.get("isolation", "auto").lower() == "isolate"
			p.save()
			if t is Transform2D {
				p.transform(t)
			}
			if clipRef.lower() != "none" {
				let clipped = applyClipPath(self, p, n, ctx, clipRef)
				if !clipped {
					p.restore()
					return
				}
			}
			let mask ?Mask = none
			if maskRef.lower() != "none" {
				let made = maskFor(self, p, n, ctx, maskRef)
				if made is MaskResult {
					if !made.draws {
						p.restore()
						return
					}
					mask = made.mask
				}
			}
			let grouped = opacity < 1.0 || !(mask is none) || blend != BlendMode.Normal || isolate
			if grouped {
				p.beginGroup(opacity = opacity, blend = blend, mask = mask)
			}
			let filterRef = st.get("filter", "none")
			if filterRef.lower() != "none" && filterRef != "" {
				let filters = parseFilters(self, n, ctx, filterRef)
				if filters is none {
					// A reference to no filter: the element is not drawn.
					p.endGroup() when grouped
					p.restore()
					return
				}
				filtered(self, p, filters, body)
			} else {
				body(p)
			}
			p.endGroup() when grouped
			p.restore()
		}

		// The element's transform with its transform origin, none when it
		// has none or it does not parse.
		def elementTransform(n Node, ctx Ctx) ?Transform2D {
			let text = ctx.st.get("transform", "")
			return none when text == "" || text.lower() == "none"
			let t = parseTransform(text)
			return none when t is none
			let origin = ctx.st.get("transform-origin", "")
			return t when origin == ""
			let (ox, oy) = originOf(origin, ctx.units)
			return new Transform2D(tx = ox, ty = oy).then(t).then(new Transform2D(tx = -ox, ty = -oy))
		}

		// A shape: fill, stroke and markers in paint order.
		def shape(p Painter, n Node, ctx Ctx, path Path) {
			let vis = ctx.st.get("visibility", "visible").lower()
			let order = paintOrder(ctx.st.get("paint-order", "normal"))
			for let (_, step) in order {
				match step {
					case "fill":
						fillShape(p, n, ctx, path) when vis == "visible"
					case "stroke":
						strokeShape(p, n, ctx, path) when vis == "visible"
					case "markers":
						drawMarkers(self, p, n, ctx, path) when (n.tag := "path" || "line" || "polyline" || "polygon")
				}
			}
		}

		def fillShape(p Painter, n Node, ctx Ctx, path Path) {
			let spec = paintSpec(ctx, "fill", "black")
			return when spec is none
			let rule = ctx.st.get("fill-rule", "nonzero").lower() == "evenodd" ?? (FillRule.EvenOdd, FillRule.NonZero)
			let opacity = parseOpacity(ctx.st.get("fill-opacity", "1"))
			paintPath(p, n, ctx, path, spec, opacity, rule, path.bounds())
		}

		def strokeShape(p Painter, n Node, ctx Ctx, path Path) {
			let spec = paintSpec(ctx, "stroke", "none")
			return when spec is none
			let s = strokeStyleOf(ctx)
			return when s is none
			let opacity = parseOpacity(ctx.st.get("stroke-opacity", "1"))
			let outline = path.stroked(s)
			paintPath(p, n, ctx, outline, spec, opacity, FillRule.NonZero, path.bounds())
		}

		// The paint a fill or stroke property names, the context paints
		// resolved; none for `none`.
		def paintSpec(ctx Ctx, property string, initial string) ?PaintSpec {
			let current = colorOf(ctx.st)
			let text = ctx.st.get(property, initial)
			let parsed = parsePaint(text, current)
			let spec = parsed
			spec = parsePaint(initial, current) when spec is none
			return none when spec is none
			return paintOrContext(spec, ctx)
		}

		def paintOrContext(spec PaintSpec, ctx Ctx) ?PaintSpec {
			if spec.kind == "context-fill" {
				return ctx.ctxFill
			}
			if spec.kind == "context-stroke" {
				return ctx.ctxStroke
			}
			return none when spec.kind == "none"
			return spec
		}

		// Fills `path` with the paint; gradients and patterns lay out over
		// `bbox` (the shape's fill box) when their units say so.
		def paintPath(p Painter, n Node, ctx Ctx, path Path, spec PaintSpec, opacity float, rule FillRule, bbox Rect) {
			if spec.kind == "color" {
				p.fill(path, withAlpha(spec.color, opacity), rule)
				return
			}
			let server = doc.resolve(spec.ref)
			let made = server is Node ?? (paintServer(self, p, server, ctx, bbox, opacity), none)
			if made is ServerPaint {
				if made.skip {
					let fb = spec.fallback
					if fb is PaintSpec && fb.kind == "color" {
						p.fill(path, withAlpha(fb.color, opacity), rule)
					}
					return
				}
				p.save()
				p.setAlpha(made.alpha) when made.alpha < 1.0
				let t = made.transform
				if isIdentity(t) {
					p.fill(path, made.paint, rule)
				} else if invertible(t) {
					p.transform(t)
					p.fill(path.transformed(t.inverse()), made.paint, rule)
				}
				p.restore()
				return
			}
			// A missing or unusable server: the fallback colour, else nothing.
			let fallback = spec.fallback
			if fallback is PaintSpec && fallback.kind == "color" {
				p.fill(path, withAlpha(fallback.color, opacity), rule)
			}
		}

		// `use`: the referenced element drawn at (x, y), inheriting from the
		// `use`; svg and symbol targets fill the use's width and height.
		def drawUse(p Painter, n Node, ctx Ctx) {
			let href = n.attr("href")
			return when href is none
			let target = doc.resolve(href)
			return when target is none
			let id = refId(href)
			return when active.indexOf(id) >= 0 || active.len() > 64
			// A use inside the element it shows would never end.
			return when contains(target, n)
			let x = lengthAttr(n, "x", ctx.units, "x", 0.0)
			let y = lengthAttr(n, "y", ctx.units, "y", 0.0)
			// context-fill and context-stroke inside take the use's paints.
			let used = Ctx{st: ctx.st, units: ctx.units, ctxFill: paintSpec(ctx, "fill", "black"), ctxStroke: paintSpec(ctx, "stroke", "none")}
			active.push(id)
			withEffects(p, n, used, true, def (q Painter) {
				q.save()
				q.transform(new Transform2D(tx = x, ty = y)) when x != 0.0 || y != 0.0
				if target.tag == "symbol" || target.tag == "svg" {
					let tctx = self.enter(target, ctx)
					if tctx.st.get("display").lower() != "none" {
						let w = self.lengthAttr(n, "width", ctx.units, "x", -1.0)
						let h = self.lengthAttr(n, "height", ctx.units, "y", -1.0)
						let tw = w >= 0.0 ?? (w, self.lengthAttr(target, "width", ctx.units, "x", ctx.units.width))
						let th = h >= 0.0 ?? (h, self.lengthAttr(target, "height", ctx.units, "y", ctx.units.height))
						let tx = target.tag == "svg" ?? (self.lengthAttr(target, "x", ctx.units, "x", 0.0), 0.0)
						let ty = target.tag == "svg" ?? (self.lengthAttr(target, "y", ctx.units, "y", 0.0), 0.0)
						// SVG 1.1 symbols take no transform; browsers ignore it too.
						self.withEffects(q, target, tctx, false, def (inner Painter) {
							self.viewport(inner, target, tctx, tx, ty, tw, th, true)
						})
					}
				} else {
					self.node(q, target, used)
				}
				q.restore()
			})
			active.pop()
		}

		// An attribute length in user units, `otherwise` when missing or
		// invalid.
		def lengthAttr(n Node, name string, u Units, axis string, otherwise float) float {
			let text = n.attr(name)
			return otherwise when text is none
			let l = parseLength(text)
			return otherwise when l is none
			return toUser(l, u, axis)
		}

		// `<image>`: a raster or SVG from a data URL fitted into its box.
		def image(p Painter, n Node, ctx Ctx) {
			return unless ctx.st.get("visibility", "visible").lower() == "visible"
			let href = n.attr("href")
			return when href is none
			let key = baseDir + "|" + href
			return when outer.indexOf(key) >= 0 || outer.len() > 16
			let data = resourceBytes(href)
			return when data is none
			let bytes byte[] = data
			let x = lengthAttr(n, "x", ctx.units, "x", 0.0)
			let y = lengthAttr(n, "y", ctx.units, "y", 0.0)
			let ar = parseAspectRatio(orEmpty(n.attr("preserveAspectRatio")))
			let nested = parseDocument(bytes)
			if nested is Document {
				let (iw, ih) = documentSize(nested)
				animate(nested, time)
				let (w, h) = imageSize(n, ctx.units, iw, ih)
				return when w <= 0.0 || h <= 0.0 || iw <= 0.0 || ih <= 0.0
				p.save()
				p.clip(Rect{left: x, top: y, right: x + w, bottom: y + h})
				p.transform(viewBoxTransform(Rect{left: 0.0, top: 0.0, right: iw, bottom: ih}, ar, x, y, w, h))
				let inner = new Renderer(nested, deviceW, deviceH)
				inner.baseDir = baseDir
				inner.time = time
				inner.outer = outer.clone()
				inner.outer.push(key)
				inner.draw(p, iw, ih)
				p.restore()
				return
			}
			let img = images.load(bytes)
			return when img is error
			let size = img.size()
			let iw = float(size.width)
			let ih = float(size.height)
			let (w, h) = imageSize(n, ctx.units, iw, ih)
			return when w <= 0.0 || h <= 0.0 || iw <= 0.0 || ih <= 0.0
			let rendering = ctx.st.get("image-rendering", "auto").lower()
			let sampling = (rendering := "optimizespeed" || "pixelated" || "crisp-edges") ?? (Sampling.Nearest, Sampling.Bilinear)
			p.save()
			p.clip(Rect{left: x, top: y, right: x + w, bottom: y + h})
			p.transform(viewBoxTransform(Rect{left: 0.0, top: 0.0, right: iw, bottom: ih}, ar, x, y, w, h))
			p.drawImage(img, Rect{left: 0.0, top: 0.0, right: iw, bottom: ih}, sampling)
			p.restore()
		}

		// The bytes an href names: a data URL, or a file relative to the
		// document's folder when it came from one; none otherwise.
		def resourceBytes(href string) ?byte[] {
			let data = dataUrlBytes(href)
			return data unless data is none
			return none when baseDir == ""
			let t = href.trim()
			// Other schemes (http:, https:, …) are never fetched.
			let colon = t.indexOf(":")
			let slash = t.indexOf("/")
			return none when colon > 1 && (slash < 0 || colon < slash)
			let local = t.startsWith("file://") ?? (t[7:], t)
			let path = local.startsWith("/") ?? (local, baseDir + "/" + percentDecode(local))
			let read = os.readFile(path)
			return none when read is error
			return read
		}

		def text(p Painter, n Node, ctx Ctx) {
			drawText(self, p, n, ctx)
		}
	}

	// Draws the element with id `id` alone, as its document would draw it
	// in place (its ancestors' inherited style, not their transforms), the
	// text colour `foreground` standing for currentColor and the context
	// paints. False when the document has no such element.
	def drawElement(doc Document, id string, p Painter, foreground Color) bool {
		let target = doc.ids.get(id)
		return false when target is none
		let devW = 1024
		let devH = 1024
		if p is Canvas {
			devW = p.width
			devH = p.height
		}
		let r = new Renderer(doc, devW, devH)
		let path Node[]
		findPath(doc.root, target, path)
		let st = new Style()
		for let i = 0; i + 1 < path.len(); i++ {
			st = st.child(path[i].props)
		}
		let rgba = foreground.rgba
		st.values["color"] = "rgba({rgba.r}, {rgba.g}, {rgba.b}, {float(rgba.a) / 255.0})"
		let (w, h) = documentSize(doc)
		let paint = PaintSpec{kind: "color", color: foreground, ref: "", fallback: none}
		let ctx = Ctx{st: st, units: Units{width: w, height: h, fontSize: defaultFontSize, rootSize: defaultFontSize}, ctxFill: paint, ctxStroke: paint}
		r.node(p, target, ctx)
		return true
	}

	// The style the root inherits from: CSS initial values.
	internal def rootStyle() Style {
		return new Style()
	}

	// The font size in user units, against the parent's.
	internal def fontSizeOf(st Style, parent float) float {
		let text = st.get("font-size", "")
		return parent when text == ""
		let low = text.lower()
		match low {
			case "xx-small":
				return 9.0
			case "x-small":
				return 10.0
			case "small":
				return 13.0
			case "medium":
				return 16.0
			case "large":
				return 18.0
			case "x-large":
				return 24.0
			case "xx-large":
				return 32.0
			case "larger":
				return parent * 1.2
			case "smaller":
				return parent / 1.2
		}
		let l = parseLength(text)
		// A negative size is invalid: the inherited one stands.
		return parent when l is none || l.value < 0.0
		if l.unit == "%" {
			return parent * l.value / 100.0
		}
		return toUser(l, Units{width: 0.0, height: 0.0, fontSize: parent}, "")
	}

	// Stores the computed font size and weight, so descendants inherit
	// values, not the relative units and keywords that gave them.
	internal def resolveFont(st Style, parent Style, size float) {
		st.values["font-size"] = "{size}"
		let w = st.get("font-weight", "")
		return when w == ""
		let pw = fontWeightOf(parent.get("font-weight", "400"))
		let low = w.trim().lower()
		let resolved = fontWeightOf(w)
		if low == "bolder" {
			resolved = pw < 350 ?? (400, pw < 550 ?? (700, 900))
		} else if low == "lighter" {
			resolved = pw < 550 ?? (100, pw < 750 ?? (400, 700))
		}
		st.values["font-weight"] = "{resolved}"
	}

	// The `color` property, black when unset or invalid.
	internal def colorOf(st Style) Color {
		let black = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		let text = st.get("color", "")
		return black when text == ""
		let c = parseColor(text, black)
		return c is none ?? (black, c)
	}

	internal def withAlpha(c Color, k float) Color {
		return c when k >= 1.0
		let x = c.rgba
		return new Color(RGBA{r: x.r, g: x.g, b: x.b, a: byte((float(x.a) * k + 0.5).floor().clamp(0.0, 255.0))})
	}

	internal def isIdentity(t Transform2D) bool {
		return t.a == 1.0 && t.b == 0.0 && t.c == 0.0 && t.d == 1.0 && t.tx == 0.0 && t.ty == 0.0
	}

	internal def invertible(t Transform2D) bool {
		return (t.a * t.d - t.b * t.c).abs() > 1e-12
	}

	// Whether `inner` is `outer` or below it.
	internal def contains(outer Node, inner Node) bool {
		return true when outer == inner
		for let (_, c) in outer.children {
			return true when contains(c, inner)
		}
		return false
	}

	// The paint order: fill, stroke and markers in the order given, the
	// unnamed ones after in their usual order.
	internal def paintOrder(text string) string[] {
		let out string[]
		for let (_, w) in splitList(text.lower()) {
			// Anything but each keyword at most once makes the value
			// invalid: the usual order.
			return ["fill", "stroke", "markers"] unless (w := "fill" || "stroke" || "markers") && out.indexOf(w) < 0
			out.push(w)
		}
		for let (_, w) in ["fill", "stroke", "markers"] {
			out.push(w) when out.indexOf(w) < 0
		}
		return out
	}

	internal def blendModeOf(text string) BlendMode {
		match text.trim().lower() {
			case "multiply":
				return BlendMode.Multiply
			case "screen":
				return BlendMode.Screen
			case "overlay":
				return BlendMode.Overlay
			case "darken":
				return BlendMode.Darken
			case "lighten":
				return BlendMode.Lighten
			case "color-dodge":
				return BlendMode.ColorDodge
			case "color-burn":
				return BlendMode.ColorBurn
			case "hard-light":
				return BlendMode.HardLight
			case "soft-light":
				return BlendMode.SoftLight
			case "difference":
				return BlendMode.Difference
			case "exclusion":
				return BlendMode.Exclusion
			case "hue":
				return BlendMode.Hue
			case "saturation":
				return BlendMode.Saturation
			case "color":
				return BlendMode.Color
			case "luminosity":
				return BlendMode.Luminosity
		}
		return BlendMode.Normal
	}

	// The stroke the style describes, none when it draws nothing (a zero
	// or negative width).
	internal def strokeStyleOf(ctx Ctx) ?StrokeStyle {
		let st = ctx.st
		let wl = parseLength(st.get("stroke-width", "1"))
		let width = wl is none ?? (1.0, toUser(wl, ctx.units, ""))
		return none when width <= 0.0
		let cap = match3(st.get("stroke-linecap", "butt").lower(), "round", "square", LineCap.Round, LineCap.Square, LineCap.Butt)
		let joinText = st.get("stroke-linejoin", "miter").lower()
		let join = joinText == "round" ?? (LineJoin.Round, joinText == "bevel" ?? (LineJoin.Bevel, LineJoin.Miter))
		let limit = parseNumber(st.get("stroke-miterlimit", "4"))
		let miter = limit is none || limit < 1.0 ?? (4.0, limit)
		let s = StrokeStyle{width: width * 1(px), cap: cap, join: join, miterLimit: miter}
		let dashes = dashArray(st.get("stroke-dasharray", "none"), ctx.units)
		if dashes.len() > 0 {
			let px Pixels[]
			for let (_, d) in dashes {
				px.push(d * 1(px))
			}
			s.dash = px
			let off = parseLength(st.get("stroke-dashoffset", "0"))
			s.dashOffset = (off is none ?? (0.0, toUser(off, ctx.units, ""))) * 1(px)
		}
		return s
	}

	internal def match3(text string, a string, b string, ra LineCap, rb LineCap, otherwise LineCap) LineCap {
		return ra when text == a
		return rb when text == b
		return otherwise
	}

	// The dash lengths; empty (a solid line) for none, a negative length,
	// or lengths that add up to zero. An odd list repeats.
	internal def dashArray(text string, u Units) float[] {
		let out float[]
		let t = text.trim()
		return out when t == "" || t.lower() == "none"
		let total = 0.0
		for let (_, part) in splitList(t) {
			let l = parseLength(part)
			return float[] when l is none
			let v = toUser(l, u, "")
			return float[] when v < 0.0
			out.push(v)
			total += v
		}
		return float[] when total <= 0.0
		if out.len() % 2 == 1 {
			let copy = out.clone()
			for let (_, v) in copy {
				out.push(v)
			}
		}
		return out
	}

	// The items of a list separated by commas or spaces.
	internal def splitList(text string) string[] {
		let out string[]
		for let (_, a) in text.replace(",", " ").split(" ") {
			out.push(a) when a != ""
		}
		return out
	}

	// transform-origin: one or two positions (lengths, percentages of the
	// viewport, or keywords), CSS's rules for which axis a keyword names.
	internal def originOf(text string, u Units) (float, float) {
		let parts = splitList(text)
		return (0.0, 0.0) when parts.len() == 0
		let first = parts[0].lower()
		let second = parts.len() > 1 ?? (parts[1].lower(), "center")
		// A vertical keyword first, or a horizontal one second, swaps them.
		if (first := "top" || "bottom") || (second := "left" || "right") {
			let t = first
			first = second
			second = t
		}
		return (originAxis(first, u, "x"), originAxis(second, u, "y"))
	}

	internal def originAxis(part string, u Units, axis string) float {
		let size = axis == "x" ?? (u.width, u.height)
		match part {
			case "left", "top":
				return 0.0
			case "center":
				return size / 2.0
			case "right", "bottom":
				return size
		}
		let l = parseLength(part)
		return l is none ?? (0.0, toUser(l, u, axis))
	}

	// The bytes of a `data:` URL, none for other URLs.
	internal def dataUrlBytes(href string) ?byte[] {
		let t = href.trim()
		return none unless t.lower().startsWith("data:")
		let comma = t.indexOf(",")
		return none when comma < 0
		let header = t[5:comma].lower()
		let payload = t[comma + 1:]
		if header.endsWith(";base64") {
			let clean = payload.replace(" ", "").replace("\n", "").replace("\r", "").replace("\t", "")
			let decoded = new Base64().decode(clean)
			return none when decoded is error
			return decoded
		}
		return percentDecode(payload).bytes()
	}

	internal def percentDecode(text string) string {
		return text unless text.contains("%")
		let b = text.bytes()
		let out byte[]
		for let i = 0; i < b.len(); i++ {
			if b[i] == byte('%') && i + 2 < b.len() {
				let v = parseInt<int>(string(b[i + 1:i + 3]), 16)
				if !(v is error) {
					out.push(byte(v))
					i += 2
					continue
				}
			}
			out.push(b[i])
		}
		return string(out)
	}

	// An image's box: width and height, a missing (or auto) one from the
	// other through the image's proportions, both missing the image's own
	// size.
	internal def imageSize(n Node, u Units, iw float, ih float) (float, float) {
		let wl = n.attr("width")
		let hl = n.attr("height")
		let w = wl is string && wl.trim() != "auto" ?? (lengthOf(n, "width", u, "x", -1.0), -1.0)
		let h = hl is string && hl.trim() != "auto" ?? (lengthOf(n, "height", u, "y", -1.0), -1.0)
		if w < 0.0 && h < 0.0 {
			return (iw, ih)
		}
		if w < 0.0 {
			return (ih > 0.0 ?? (h * iw / ih, 0.0), h)
		}
		if h < 0.0 {
			return (w, iw > 0.0 ?? (w * ih / iw, 0.0))
		}
		return (w, h)
	}

	// The first child of a `switch` whose conditions hold; only elements
	// that draw count.
	internal def switchChild(n Node) ?Node {
		for let (_, c) in n.children {
			continue when c.isText || c.tag == ""
			continue unless (c.tag := "g" || "a" || "svg" || "switch" || "use" || "rect" || "circle" || "ellipse" || "line" || "polyline" || "polygon" || "path" || "image" || "text" || "foreignObject")
			return c when conditionsHold(c)
		}
		return none
	}

	// requiredExtensions (none supported), systemLanguage (English).
	internal def conditionsHold(n Node) bool {
		let ext = n.attr("requiredExtensions")
		return false when ext is string
		let lang = n.attr("systemLanguage")
		if lang is string {
			for let (_, l) in lang.split(",") {
				let t = l.trim().lower()
				return true when t == "en" || t.startsWith("en-")
			}
			return false
		}
		return true
	}
}
