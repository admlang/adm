// The geometry of the basic shapes and paths, and the object bounding box
// that objectBoundingBox units refer to.

internal std partial module std.formats.image.svgrender {
	use (
		std.math.geom::(Path, Point, Rect, Transform2D)
	)

	// The outline of a shape element; none when it draws nothing (a zero
	// size, too few points, no path data).
	internal def shapePath(n Node, u Units) ?Path {
		let len = (name string, axis string, otherwise float) => lengthOf(n, name, u, axis, otherwise)
		match n.tag {
			case "rect":
				let w = len("width", "x", 0.0)
				let h = len("height", "y", 0.0)
				return none when w <= 0.0 || h <= 0.0
				let x = len("x", "x", 0.0)
				let y = len("y", "y", 0.0)
				// rx and ry: a missing or invalid one takes the other's value;
				// both are capped at half the side.
				let rxText = radiusLength(n, "rx", u, "x")
				let ryText = radiusLength(n, "ry", u, "y")
				let rx = rxText
				let ry = ryText
				if rx < 0.0 && ry < 0.0 {
					rx = 0.0
					ry = 0.0
				} else if rx < 0.0 {
					rx = ry
				} else if ry < 0.0 {
					ry = rx
				}
				rx = rx.min(w / 2.0)
				ry = ry.min(h / 2.0)
				return roundedRect(x, y, w, h, rx, ry)
			case "circle":
				let r = len("r", "", 0.0)
				return none when r <= 0.0
				return new Path().ellipse(new Point(len("cx", "x", 0.0), len("cy", "y", 0.0)), r, r)
			case "ellipse":
				let rx = radiusLength(n, "rx", u, "x")
				let ry = radiusLength(n, "ry", u, "y")
				// SVG 2: an auto (missing) radius takes the other's value.
				rx = ry when rx < 0.0
				ry = rx when ry < 0.0
				return none when rx <= 0.0 || ry <= 0.0
				return new Path().ellipse(new Point(len("cx", "x", 0.0), len("cy", "y", 0.0)), rx, ry)
			case "line":
				let p = new Path()
				p.moveTo(len("x1", "x", 0.0), len("y1", "y", 0.0))
				p.lineTo(len("x2", "x", 0.0), len("y2", "y", 0.0))
				return p
			case "polyline", "polygon":
				let pts = pointsOf(n.attr("points"))
				return none when pts.len() < 4
				let p = new Path()
				p.moveTo(pts[0], pts[1])
				for let i = 2; i + 1 < pts.len(); i += 2 {
					p.lineTo(pts[i], pts[i + 1])
				}
				p.close() when n.tag == "polygon"
				return p
			case "path":
				let d = n.attr("d")
				return none when d is none
				let p = parsePathData(d, true)
				return none when p is error || p.isEmpty()
				return p
		}
		return none
	}

	// A length attribute in user units, `otherwise` when missing or
	// invalid.
	internal def lengthOf(n Node, name string, u Units, axis string, otherwise float) float {
		let text = n.attr(name)
		return otherwise when text is none
		let l = parseLength(text)
		return otherwise when l is none
		return toUser(l, u, axis)
	}

	// rx or ry: -1 when missing, auto, negative or invalid.
	internal def radiusLength(n Node, name string, u Units, axis string) float {
		let text = n.attr(name)
		return -1.0 when text is none
		let l = parseLength(text)
		return -1.0 when l is none
		let v = toUser(l, u, axis)
		return v < 0.0 ?? (-1.0, v)
	}

	// The coordinates of a `points` list, an odd last one dropped; the
	// list ends at the first item that is not a number.
	internal def pointsOf(text ?string) float[] {
		let out float[]
		return out when text is none
		let b = text.bytes()
		let at = 0
		for {
			for at < b.len() && (b[at] := byte(' ') || byte('\t') || byte('\n') || byte('\r') || byte(',')) {
				at++
			}
			break when at >= b.len()
			let end = numberEnd(b, at)
			break when end == at
			let v = parseFloat<float>(string(b[at:end]))
			break when v is error
			out.push(v)
			at = end
		}
		out.pop() when out.len() % 2 == 1
		return out
	}

	// A rectangle with elliptical corners of radii rx, ry.
	internal def roundedRect(x float, y float, w float, h float, rx float, ry float) Path {
		let p = new Path()
		if rx <= 0.0 || ry <= 0.0 {
			return p.rect(Rect{left: x, top: y, right: x + w, bottom: y + h})
		}
		// Cubic approximation of a quarter ellipse.
		let k = 0.5522847498
		let kx = rx * k
		let ky = ry * k
		p.moveTo(x + rx, y)
		p.lineTo(x + w - rx, y)
		p.cubicTo(x + w - rx + kx, y, x + w, y + ry - ky, x + w, y + ry)
		p.lineTo(x + w, y + h - ry)
		p.cubicTo(x + w, y + h - ry + ky, x + w - rx + kx, y + h, x + w - rx, y + h)
		p.lineTo(x + rx, y + h)
		p.cubicTo(x + rx - kx, y + h, x, y + h - ry + ky, x, y + h - ry)
		p.lineTo(x, y + ry)
		p.cubicTo(x, y + ry - ky, x + rx - kx, y, x + rx, y)
		p.close()
		return p
	}

	internal def unionBox(a ?Rect, b Rect) Rect {
		return b when a is none
		return Rect{left: a.left.min(b.left), top: a.top.min(b.top), right: a.right.max(b.right), bottom: a.bottom.max(b.bottom)}
	}

	// The box `r` covers after `t`.
	internal def boxAfter(t Transform2D, r Rect) Rect {
		let xs = [r.left, r.right, r.right, r.left]
		let ys = [r.top, r.top, r.bottom, r.bottom]
		let x0 = 1e300
		let y0 = 1e300
		let x1 = -1e300
		let y1 = -1e300
		for let i = 0; i < 4; i++ {
			let x = t.a * xs[i] + t.c * ys[i] + t.tx
			let y = t.b * xs[i] + t.d * ys[i] + t.ty
			x0 = x0.min(x)
			y0 = y0.min(y)
			x1 = x1.max(x)
			y1 = y1.max(y)
		}
		return Rect{left: x0, top: y0, right: x1, bottom: y1}
	}

	internal def boxOfPath(p Path, t Transform2D) Rect {
		return p.bounds() when isIdentity(t)
		return p.transformed(t).bounds()
	}
}
