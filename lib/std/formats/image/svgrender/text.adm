// SVG text: characters collected from text, tspan, tref, a and textPath
// with their white space handled and their x, y, dx, dy and rotate values
// assigned, split into chunks, shaped with font fallback, placed (spacing,
// anchors, baselines, text length, paths), then filled and stroked span by
// span with their decorations.

internal std partial module std.formats.image.svgrender {
	use (
		std.formats.fonts
		std.gfx.canvas::(Painter)
		std.gfx.color::(Color)
		std.math::(Pi, sin, cos, atan2)
		std.math.geom::(FillRule, Path, Point, Rect, Transform2D, Vec2)
		std.text.unicode
	)

	// One addressable character.
	internal struct TChar {
		ch     char
		span   int
		x      ?float
		y      ?float
		dx     float
		dy     float
		rotate ?float
		// Whether an element set x, y, dx, dy or rotate for it: an
		// ancestor's list does not reach it then.
		hasX   bool
		hasY   bool
		hasDx  bool
		hasDy  bool
		hasRot bool
	}

	// A run of characters drawn in one style: the element that holds them
	// and its context.
	internal struct TSpan {
		node      Node
		ctx       Ctx
		// The textPath it lies on, none for plain text.
		path      ?TextPathInfo
		// Baseline shift accumulated from it and its ancestors (user units,
		// positive up).
		shift     float
		// Elements whose text-decoration covers it, outermost first.
		decorators Node[]
		decoCtx   Ctx[]
	}

	internal struct TextPathInfo {
		path        Path
		startOffset float
		length      float
		id          int
	}

	// A placed glyph.
	internal struct TGlyph {
		glyph   fonts.GlyphID
		face    fonts.Face
		x       float
		y       float
		// Size in user units per font unit.
		scale   float
		rotate  float
		span    int
		advance float
		// First character of its cluster.
		char    int
		hidden  bool
		// Along a path: the tangent angle the glyph turns to.
		angle   float
		// Horizontal scale lengthAdjust="spacingAndGlyphs" gives it.
		stretch float
	}

	// A textLength to fit characters [first, last] to.
	internal struct TextFit {
		first   int
		last    int
		length  float
		stretch bool
	}

	// What collecting a text element gives.
	internal type TextLayout {
		chars  TChar[]
		spans  TSpan[]
		glyphs TGlyph[]
		fits   TextFit[]
		// White space state between text nodes (xml:space default).
		internal lastSpace bool
		internal paths      int

		def new() {
			lastSpace = true
		}
	}

	// Lays out and draws a text element.
	internal def drawText(r Renderer, p Painter, n Node, ctx Ctx) {
		let layout = layoutText(r, n, ctx)
		paintText(r, p, n, ctx, layout)
	}

	// Collects, shapes and places the text of `n`.
	internal def layoutText(r Renderer, n Node, ctx Ctx) TextLayout {
		let l = new TextLayout()
		// Decorations declared on ancestors outside the text reach it too,
		// drawn in the text element's own paint.
		let decos Node[]
		let dctx Ctx[]
		let outer = ancestorDecorations(r.doc, n)
		if outer != "" {
			let st = ctx.st.child(map<string, string>{})
			st.values["text-decoration"] = outer
			for let (k, v) in ctx.st.values {
				st.values[k] = v unless k == "text-decoration"
			}
			decos.push(n)
			dctx.push(Ctx{st: st, units: ctx.units, ctxFill: ctx.ctxFill, ctxStroke: ctx.ctxStroke})
		}
		collectText(r, l, n, ctx, 0.0, decos, dctx, none)
		// Trailing white space of default-space text is dropped.
		if l.chars.len() > 0 && l.chars[l.chars.len() - 1].ch == ' ' && !preserves(l.spans[l.chars[l.chars.len() - 1].span].ctx) {
			l.chars.pop()
		}
		placeText(r, l, ctx)
		return l
	}

	// The text-decoration lines the element's ancestors declare.
	internal def ancestorDecorations(doc Document, n Node) string {
		let path Node[]
		return "" unless findPath(doc.root, n, path)
		let kinds string[]
		for let i = 0; i + 1 < path.len(); i++ {
			let d = path[i].props.get("text-decoration")
			continue when d is none
			for let (_, k) in splitList(d.lower()) {
				kinds.push(k) when (k := "underline" || "overline" || "line-through") && kinds.indexOf(k) < 0
			}
		}
		return kinds.join(" ")
	}

	internal def preserves(ctx Ctx) bool {
		let ws = ctx.st.get("white-space", "").lower()
		return true when (ws := "pre" || "pre-wrap" || "break-spaces" || "pre-line")
		return ctx.st.get("xml:space", "") == "preserve"
	}

	// Walks a text content element, adding its characters and assigning
	// its position lists to them.
	internal def collectText(r Renderer, l TextLayout, n Node, ctx Ctx, shift float, decorators Node[], decoCtx Ctx[], path ?TextPathInfo) {
		let first = l.chars.len()
		let decos = decorators.clone()
		let dctx = decoCtx.clone()
		let deco = ctx.st.get("text-decoration", "none").lower()
		if deco != "none" && deco != "" {
			decos.push(n)
			dctx.push(ctx)
		}
		let own = shift + baselineShiftOf(ctx)
		let span = l.spans.len()
		l.spans.push(TSpan{node: n, ctx: ctx, path: path, shift: own, decorators: decos, decoCtx: dctx})
		for let (_, c) in n.children {
			if c.isText {
				addText(l, c.text, span, preserves(ctx))
				continue
			}
			continue when c.tag == ""
			let cctx = r.enter(c, ctx)
			continue when cctx.st.get("display").lower() == "none"
			match c.tag {
				case "tspan", "a":
					collectText(r, l, c, cctx, own, decos, dctx, path)
				case "tref":
					let href = c.attr("href")
					let target = href is string ?? (r.doc.resolve(href), none)
					if target is Node {
						let tspan = l.spans.len()
						l.spans.push(TSpan{node: c, ctx: cctx, path: path, shift: own + baselineShiftOf(cctx), decorators: decos, decoCtx: dctx})
						let start = l.chars.len()
						addText(l, textContent(target), tspan, preserves(cctx))
						assignPositions(c, l, start, cctx)
					}
				case "textPath":
					// A text path inside another is ignored, content and all.
					continue unless path is none
					let info = textPathOf(r, l, c, cctx)
					if info is TextPathInfo {
						collectText(r, l, c, cctx, own, decos, dctx, info)
					}
			}
			// Text after a child continues in this element's style.
			if l.spans.len() - 1 != span {
				span = l.spans.len()
				l.spans.push(TSpan{node: n, ctx: ctx, path: path, shift: own, decorators: decos, decoCtx: dctx})
			}
		}
		assignPositions(n, l, first, ctx)
		let tl = n.attr("textLength")
		if tl is string && l.chars.len() > first {
			let len = parseLength(tl)
			if len is Length && len.value > 0.0 {
				let stretch = orEmpty(n.attr("lengthAdjust")).trim() == "spacingAndGlyphs"
				l.fits.push(TextFit{first: first, last: l.chars.len() - 1, length: toUser(len, ctx.units, "x"), stretch: stretch})
			}
		}
	}

	// Every character below a node, in document order.
	internal def textContent(n Node) string {
		return n.text when n.isText
		let out = ""
		for let (_, c) in n.children {
			out += textContent(c)
		}
		return out
	}

	// Adds a text node's characters, white space handled.
	internal def addText(l TextLayout, text string, span int, preserve bool) {
		for let (_, ch) in text {
			let c = ch
			if preserve {
				c = ' ' when (c := '\n' || '\t' || '\r')
				l.chars.push(newChar(c, span))
				continue
			}
			continue when c == '\n' || c == '\r'
			c = ' ' when c == '\t'
			if c == ' ' {
				continue when l.lastSpace
				l.lastSpace = true
			} else {
				l.lastSpace = false
			}
			l.chars.push(newChar(c, span))
		}
	}

	internal def newChar(c char, span int) TChar {
		return TChar{ch: c, span: span, x: none, y: none, dx: 0.0, dy: 0.0, rotate: none, hasX: false, hasY: false, hasDx: false, hasDy: false, hasRot: false}
	}

	// The element's x, y, dx, dy and rotate lists, given to its characters
	// from `first` in order where a descendant set none; the last rotate
	// value goes on to the rest.
	internal def assignPositions(n Node, l TextLayout, first int, ctx Ctx) {
		let count = l.chars.len() - first
		return when count <= 0
		let xs = lengthList(n.attr("x"), ctx.units, "x")
		let ys = lengthList(n.attr("y"), ctx.units, "y")
		let dxs = lengthList(n.attr("dx"), ctx.units, "x")
		let dys = lengthList(n.attr("dy"), ctx.units, "y")
		let rots = numberList(n.attr("rotate"))
		for let i = 0; i < count; i++ {
			let c = l.chars[first + i]
			if i < xs.len() && !c.hasX {
				c.x = xs[i]
				c.hasX = true
			}
			if i < ys.len() && !c.hasY {
				c.y = ys[i]
				c.hasY = true
			}
			if i < dxs.len() && !c.hasDx {
				c.dx = dxs[i]
				c.hasDx = true
			}
			if i < dys.len() && !c.hasDy {
				c.dy = dys[i]
				c.hasDy = true
			}
			if rots.len() > 0 && !c.hasRot {
				c.rotate = rots[i.min(rots.len() - 1)]
				c.hasRot = true
			}
			l.chars[first + i] = c
		}
	}

	internal def lengthList(text ?string, u Units, axis string) float[] {
		let out float[]
		return out when text is none
		for let (_, part) in splitList(text) {
			let len = parseLength(part)
			return out when len is none
			out.push(toUser(len, u, axis))
		}
		return out
	}

	internal def numberList(text ?string) float[] {
		let out float[]
		return out when text is none
		for let (_, part) in splitList(text) {
			let v = parseNumber(part)
			return out when v is none
			out.push(v)
		}
		return out
	}

	// The path a textPath element follows: its path attribute (SVG 2),
	// else the referenced shape through that shape's transform.
	internal def textPathOf(r Renderer, l TextLayout, n Node, ctx Ctx) ?TextPathInfo {
		let geometry ?Path = none
		let own = n.attr("path")
		if own is string {
			let parsed = parsePathData(own, true)
			geometry = parsed unless parsed is error
		}
		if geometry is none {
			let href = n.attr("href")
			return none when href is none
			let target = r.doc.resolve(href)
			return none when target is none
			let shape = shapePath(target, ctx.units)
			return none when shape is none
			let path Path = shape
			let tt = target.attr("transform")
			if tt is string {
				let parsed = parseTransform(tt)
				path = path.transformed(parsed) when parsed is Transform2D
			}
			geometry = path
		}
		let path = new Path()
		if geometry is Path {
			path = geometry
		}
		if orEmpty(n.attr("side")).trim() == "right" {
			path = reversed(path)
		}
		let length = path.length()
		return none when length <= 0.0
		let off = n.attr("startOffset")
		let start = 0.0
		if off is string {
			let len = parseLength(off)
			if len is Length {
				start = len.unit == "%" ?? (len.value / 100.0 * length, toUser(len, ctx.units, "x"))
			}
		}
		l.paths++
		return TextPathInfo{path: path, startOffset: start, length: length, id: l.paths}
	}

	// The path run backwards, for side="right".
	internal def reversed(p Path) Path {
		let flat = p.flattened(0.1)
		let pts = flat.coords
		let out = new Path()
		let n = pts.len() / 2
		return out when n == 0
		out.moveTo(pts[(n - 1) * 2], pts[(n - 1) * 2 + 1])
		for let i = n - 2; i >= 0; i-- {
			out.lineTo(pts[i * 2], pts[i * 2 + 1])
		}
		return out
	}

	// baseline-shift: sub, super, a length or a percentage of the font
	// size; positive raises.
	internal def baselineShiftOf(ctx Ctx) float {
		let text = ctx.st.get("baseline-shift", "baseline").trim().lower()
		match text {
			case "baseline", "":
				return 0.0
			case "sub":
				return -ctx.units.fontSize * 0.2
			case "super":
				return ctx.units.fontSize * 0.4
		}
		let l = parseLength(text)
		return 0.0 when l is none
		return l.value / 100.0 * ctx.units.fontSize when l.unit == "%"
		return toUser(l, ctx.units, "")
	}
}
