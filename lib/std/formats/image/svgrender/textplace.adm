// Shaping and placing collected text, and painting it.

internal std partial module std.formats.image.svgrender {
	use (
		std.formats.fonts
		std.gfx.canvas::(Painter)
		std.gfx.canvas.glyphs as colorglyphs
		std.gfx.color::(Color, RGBA)
		std.math::(Pi, sin, cos, atan2, sqrt)
		std.math.geom::(FillRule, Path, Point, Rect, Transform2D, Vec2, StrokeStyle)
		std.text.unicode
	)

	// The faces a span's font properties ask for, best first; the set's
	// sans-serif after them as the last resort.
	internal def facesFor(r Renderer, ctx Ctx) fonts.Face[] {
		let st = ctx.st
		let families = fontFamilies(st.get("font-family", "sans-serif"))
		let weight = fontWeightOf(st.get("font-weight", "normal"))
		let slant = st.get("font-style", "normal").lower()
		let italic = (slant := "italic" || "oblique")
		let variations = st.get("font-variation-settings", "normal")
		let stretch = st.get("font-stretch", "normal")
		let key = families.join(",") + "|{weight}|{italic}|" + variations + "|" + stretch + "|{ctx.units.fontSize}|" + slant
		let cached = r.fontCache.get(key)
		return cached unless cached is none
		let set = fonts.systemFonts()
		let out fonts.Face[]
		for let (_, fam) in families {
			let f = set.find(fam, weight, italic)
			if f is fonts.Face {
				out.push(withVariations(f, variations, weight, ctx.units.fontSize, stretch, slant)) unless containsFace(out, f)
			}
		}
		if out.len() == 0 {
			let f = set.find("sans-serif", weight, italic)
			out.push(f) when f is fonts.Face
		}
		r.fontCache[key] = out
		return out
	}

	internal def containsFace(list fonts.Face[], f fonts.Face) bool {
		for let (_, x) in list {
			return true when x == f
		}
		return false
	}

	// A variable face at the axis values `font-variation-settings` names,
	// wght from the weight when it does not.
	// The CSS-driven axes first: wght from font-weight, wdth from
	// font-stretch, opsz from the font size (font-optical-sizing auto),
	// slnt from an oblique style; explicit settings win over them.
	internal def withVariations(f fonts.Face, settings string, weight int, size float, stretch string, slant string) fonts.Face {
		return f unless f is fonts.VariableFace
		let coords = map<string, float>{}
		let axes = string[]
		for let (_, a) in f.axes() {
			axes.push(a.tag)
		}
		coords["wght"] = float(weight) when axes.indexOf("wght") >= 0
		coords["opsz"] = size when axes.indexOf("opsz") >= 0
		let width = stretchPercent(stretch)
		coords["wdth"] = width when axes.indexOf("wdth") >= 0 && width != 100.0
		coords["slnt"] = -14.0 when axes.indexOf("slnt") >= 0 && slant.startsWith("oblique")
		if settings.trim().lower() != "normal" {
			for let (_, part) in settings.split(",") {
				let t = part.trim()
				continue when t.len() < 6
				let q = t[0:1]
				continue unless q == "\"" || q == "'"
				let close = t.indexOf(q, 1)
				continue when close != 5
				let tag = t[1:5]
				let v = parseNumber(t[6:])
				coords[tag] = v when v is float
			}
		}
		let made = f.instance(coords)
		return made is error ?? (f, made)
	}

	// font-stretch as a percentage of normal width.
	internal def stretchPercent(text string) float {
		match text.trim().lower() {
			case "ultra-condensed":
				return 50.0
			case "extra-condensed":
				return 62.5
			case "condensed":
				return 75.0
			case "semi-condensed":
				return 87.5
			case "semi-expanded":
				return 112.5
			case "expanded":
				return 125.0
			case "extra-expanded":
				return 150.0
			case "ultra-expanded":
				return 200.0
		}
		let t = text.trim()
		if t.endsWith("%") {
			let v = parseNumber(t[:t.len() - 1])
			return v is none ?? (100.0, v)
		}
		return 100.0
	}

	internal def fontFamilies(text string) string[] {
		let out string[]
		for let (_, part) in splitTopLevel(text, byte(',')) {
			let t = part.trim()
			if t.len() >= 2 && (t.startsWith("\"") || t.startsWith("'")) {
				t = t[1:t.len() - 1]
			}
			out.push(t) when t != ""
		}
		return out
	}

	internal def fontWeightOf(text string) int {
		match text.trim().lower() {
			case "normal":
				return 400
			case "bold":
				return 700
			case "bolder":
				return 700
			case "lighter":
				return 300
		}
		let n = parseNumber(text)
		return n is none ?? (400, int(n).clamp(1, 1000))
	}

	// The key that groups characters shaped together: same faces, size and
	// features.
	internal def shapeKey(ctx Ctx) string {
		let st = ctx.st
		return st.get("font-family", "") + "|" + st.get("font-weight", "") + "|" + st.get("font-style", "") + "|{ctx.units.fontSize}|" + st.get("font-variant", "") + "|" + st.get("font-kerning", "") + "|" + st.get("font-variation-settings", "") + "|" + st.get("font-feature-settings", "")
	}

	// Shapes and places every character: chunks, clusters, spacing, anchors,
	// baselines, text length and text paths.
	internal def placeText(r Renderer, l TextLayout, ctx Ctx) {
		let n = l.chars.len()
		return when n == 0
		let penX = 0.0
		let penY = 0.0
		let start = 0
		for start < n {
			// A chunk runs to the next character with an absolute position or
			// a different text path.
			let end = start + 1
			let pathId = pathIdOf(l, start)
			for end < n && !(l.chars[end].x is float) && !(l.chars[end].y is float) && pathIdOf(l, end) == pathId {
				end++
			}
			let c0 = l.chars[start]
			if pathId != 0 && pathIdOf(l, start - 1) != pathId {
				// A new text path starts its own line at its start.
				penX = 0.0
				penY = 0.0
			}
			penX = c0.x when c0.x is float
			penY = c0.y when c0.y is float
			let first = l.glyphs.len()
			let startX = penX
			let startY = penY
			let (ex, ey) = shapeChunk(r, l, start, end, penX, penY)
			penX = ex + fitLengths(l, first, start, end)
			penY = ey
			let vertical = isVertical(l.spans[l.chars[start].span].ctx)
			anchorChunk(l, first, vertical ?? (startY, startX), vertical ?? (penY, penX), start)
			baselines(l, first)
			if pathId != 0 {
				alongPath(l, first)
				// Text after the path goes on from where the path text ended.
				if pathIdOf(l, end) != pathId {
					let info = l.spans[l.chars[start].span].path
					if info is TextPathInfo {
						let (pt, _) = info.path.pointAt((info.startOffset + penX).clamp(0.0, info.length))
						penX = pt.x
						penY = pt.y
					}
				}
			}
			start = end
		}
	}

	internal def pathIdOf(l TextLayout, i int) int {
		return 0 when i < 0 || i >= l.chars.len()
		let p = l.spans[l.chars[i].span].path
		return p is none ?? (0, p.id)
	}

	// Shapes characters [start, end) from the pen, appending glyphs; the
	// pen after them.
	internal def shapeChunk(r Renderer, l TextLayout, start int, end int, x float, y float) (float, float) {
		let penX = x
		let penY = y
		let i = start
		for i < end {
			// A segment of characters shaped with the same font.
			let key = shapeKey(l.spans[l.chars[i].span].ctx)
			let vertical = isVertical(l.spans[l.chars[i].span].ctx)
			let mode = vertical ?? (orientation(l.chars[i].ch, l.spans[l.chars[i].span].ctx), 0)
			let j = i + 1
			for j < end && shapeKey(l.spans[l.chars[j].span].ctx) == key && (!vertical || orientation(l.chars[j].ch, l.spans[l.chars[j].span].ctx) == mode) {
				j++
			}
			let sctx = l.spans[l.chars[i].span].ctx
			let faces = facesFor(r, sctx)
			if faces.len() == 0 {
				i = j
				continue
			}
			let text = ""
			for let k = i; k < j; k++ {
				text += string(l.chars[k].ch)
			}
			let lang = sctx.st.get("xml:lang", "")
			let runs = fonts.systemFonts().faceRuns(text, faces, lang)
			for let (_, run) in runs {
				let (nx, ny) = shapeRun(r, l, i, run.start, run.end, text, run.face, sctx, penX, penY, mode)
				penX = nx
				penY = ny
			}
			i = j
		}
		return (penX, penY)
	}

	// Shapes characters [from, to) of the segment starting at character
	// `base` with `face`, placing its clusters from the pen.
	// `mode` is 0 for horizontal text, 1 for upright and 2 for sideways
	// glyphs of vertical text.
	internal def shapeRun(r Renderer, l TextLayout, base int, from int, to int, text string, face fonts.Face, sctx Ctx, x float, y float, mode int) (float, float) {
		let runText = text.slice(from, to)
		let opts = fonts.ShapeOptions{}
		opts.language = sctx.st.get("xml:lang", "")
		opts.script = unicode.script(runText)
		let direction = sctx.st.get("direction", "ltr").lower()
		opts.direction = direction == "rtl" ?? (fonts.TextDirection.RightToLeft, fonts.TextDirection.LeftToRight)
		opts.direction = fonts.TextDirection.TopToBottom when mode == 1
		let features = map<string, bool>{}
		if sctx.st.get("font-kerning", "auto").lower() == "none" {
			features["kern"] = false
		}
		if sctx.st.get("font-variant", "normal").lower().contains("small-caps") {
			features["smcp"] = true
		}
		opts.features = features
		let shaped = fonts.shape(face, runText, opts)
		if shaped is error {
			return (x, y)
		}
		let upem = float(face.info().unitsPerEm)
		let scale = sctx.units.fontSize / (upem > 0.0 ?? (upem, 1000.0))
		// Byte offset in the run text to character index in the run.
		let byteToChar = int[]
		let charIndex = 0
		for let (_, ch) in runText {
			let bytes = string(ch).bytes().len()
			for let b = 0; b < bytes; b++ {
				byteToChar.push(charIndex)
			}
			charIndex++
		}
		let penX = x
		let penY = y
		let letter = spacingOf(sctx, "letter-spacing")
		let word = spacingOf(sctx, "word-spacing")
		let lastCluster = -1
		let glyphs = shaped.glyphs
		for let g = 0; g < glyphs.len(); g++ {
			let sg = glyphs[g]
			let ci = base + from + byteToChar[sg.cluster.clamp(0, byteToChar.len() - 1)]
			if sg.cluster != lastCluster {
				// A cluster's first glyph: its characters' dx and dy, and the
				// spacing of the cluster before it.
				let c = l.chars[ci]
				penX += c.dx
				penY += c.dy
				lastCluster = sg.cluster
			}
			let c = l.chars[ci]
			let rot = 0.0
			let given = c.rotate
			rot = given when given is float
			if mode == 2 {
				// Sideways in vertical text: turned clockwise, its em box
				// centred on the line, advancing down.
				let m = face.metrics()
				let centre = (float(m.ascent) + float(m.descent)) / 2.0 * scale
				l.glyphs.push(TGlyph{stretch: 1.0, glyph: sg.glyph, face: face, x: penX - centre + float(sg.yOffset) * scale, y: penY + float(sg.xOffset) * scale, scale: scale, rotate: rot, span: c.span, advance: float(sg.xAdvance) * scale, char: ci, hidden: false, angle: Pi / 2.0})
				penY += float(sg.xAdvance) * scale
			} else {
				l.glyphs.push(TGlyph{stretch: 1.0, glyph: sg.glyph, face: face, x: penX + float(sg.xOffset) * scale, y: penY - float(sg.yOffset) * scale, scale: scale, rotate: rot, span: c.span, advance: mode == 1 ?? (-float(sg.yAdvance) * scale, float(sg.xAdvance) * scale), char: ci, hidden: false, angle: 0.0})
				penX += float(sg.xAdvance) * scale
				penY -= float(sg.yAdvance) * scale
			}
			let next = g + 1 < glyphs.len() ?? (glyphs[g + 1].cluster, -1)
			if next != sg.cluster {
				// Spacing after the cluster's characters.
				let lastChar = next < 0 ?? (to - from - 1, byteToChar[next.clamp(0, byteToChar.len() - 1)] - 1)
				let firstChar = byteToChar[sg.cluster.clamp(0, byteToChar.len() - 1)]
				let count = (lastChar - firstChar + 1).max(1)
				let extra = letter * float(count)
				for let k = firstChar; k < firstChar + count && base + from + k < l.chars.len(); k++ {
					extra += word when l.chars[base + from + k].ch == ' '
				}
				if mode == 0 {
					penX += extra
				} else {
					penY += extra
				}
			}
		}
		return (penX, penY)
	}

	internal def isVertical(ctx Ctx) bool {
		let wm = ctx.st.get("writing-mode", "").lower()
		return wm.startsWith("tb") || wm.startsWith("vertical")
	}

	// How a character stands in vertical text: 1 upright, 2 sideways. CJK,
	// Hangul and full-width forms stand upright unless glyph orientation
	// or text-orientation says otherwise; the rest turn sideways.
	internal def orientation(ch char, ctx Ctx) int {
		let gov = ctx.st.get("glyph-orientation-vertical", "auto").trim().lower()
		if gov != "auto" && gov != "" {
			return (gov := "0" || "0deg") ?? (1, 2)
		}
		let to = ctx.st.get("text-orientation", "mixed").trim().lower()
		return 1 when to == "upright"
		return 2 when to == "sideways"
		let cp = int(ch)
		return 1 when (cp >= 0x1100 && cp <= 0x11FF) || (cp >= 0x2E80 && cp <= 0xA4CF) || (cp >= 0xAC00 && cp <= 0xD7AF) || (cp >= 0xF900 && cp <= 0xFAFF) || (cp >= 0xFE30 && cp <= 0xFE4F) || (cp >= 0xFF00 && cp <= 0xFFEF) || (cp >= 0x20000 && cp <= 0x3FFFF)
		return 2
	}

	internal def spacingOf(ctx Ctx, name string) float {
		let text = ctx.st.get(name, "normal").trim().lower()
		return 0.0 when text == "normal" || text == ""
		let l = parseLength(text)
		return 0.0 when l is none
		return l.value / 100.0 * ctx.units.fontSize when l.unit == "%"
		return toUser(l, ctx.units, "x")
	}

	// Moves the chunk's glyphs for its text-anchor.
	internal def anchorChunk(l TextLayout, first int, startX float, endX float, startChar int) {
		let ctx = l.spans[l.chars[startChar].span].ctx
		let anchor = ctx.st.get("text-anchor", "start").lower()
		let rtl = ctx.st.get("direction", "ltr").lower() == "rtl"
		let vertical = isVertical(ctx)
		let width = endX - startX
		let shift = 0.0
		if anchor == "middle" {
			shift = -width / 2.0
		} else if (anchor == "end") != rtl {
			shift = -width
		}
		return when shift == 0.0
		for let i = first; i < l.glyphs.len(); i++ {
			let g = l.glyphs[i]
			if vertical {
				g.y += shift
			} else {
				g.x += shift
			}
			l.glyphs[i] = g
		}
	}

	// textLength: each element's characters in [start, end) spread or
	// squeezed to its length, by spacing or by stretching the glyphs too;
	// the glyphs after them move along. The extra advance it adds.
	internal def fitLengths(l TextLayout, firstGlyph int, start int, end int) float {
		let added = 0.0
		for let (_, fit) in l.fits {
			continue when fit.first < start || fit.last >= end || fit.last < fit.first
			let lo = -1
			let hi = -1
			for let i = firstGlyph; i < l.glyphs.len(); i++ {
				let c = l.glyphs[i].char
				if c >= fit.first && c <= fit.last {
					lo = i when lo < 0
					hi = i
				}
			}
			continue when lo < 0
			let x0 = l.glyphs[lo].x
			let x1 = l.glyphs[hi].x + l.glyphs[hi].advance
			let current = x1 - x0
			continue when current <= 0.0
			let delta = fit.length - current
			if fit.stretch {
				let k = fit.length / current
				for let i = lo; i <= hi; i++ {
					let g = l.glyphs[i]
					g.x = x0 + (g.x - x0) * k
					g.advance *= k
					g.stretch *= k
					l.glyphs[i] = g
				}
			} else {
				let chars = fit.last - fit.first + 1
				let gap = chars > 1 ?? (delta / float(chars - 1), 0.0)
				for let i = lo; i <= hi; i++ {
					let g = l.glyphs[i]
					g.x += gap * float(g.char - fit.first)
					l.glyphs[i] = g
				}
			}
			for let i = hi + 1; i < l.glyphs.len(); i++ {
				let g = l.glyphs[i]
				g.x += delta
				l.glyphs[i] = g
			}
			added += delta
		}
		return added
	}

	// dominant-baseline, alignment-baseline and baseline-shift.
	internal def baselines(l TextLayout, first int) {
		for let i = first; i < l.glyphs.len(); i++ {
			let g = l.glyphs[i]
			let span = l.spans[g.span]
			let off = span.shift - baselineOffset(span.ctx, g.face)
			continue when off == 0.0
			g.y -= off
			l.glyphs[i] = g
		}
	}

	// How far the alphabetic baseline sits below the baseline the
	// properties pick, in user units (positive raises the text).
	internal def baselineOffset(ctx Ctx, face fonts.Face) float {
		let which = ctx.st.get("alignment-baseline", "auto").lower()
		if which == "auto" || which == "baseline" || which == "" {
			which = ctx.st.get("dominant-baseline", "auto").lower()
		}
		let m = face.metrics()
		let upem = float(face.info().unitsPerEm)
		let s = ctx.units.fontSize / (upem > 0.0 ?? (upem, 1000.0))
		match which {
			case "middle", "central":
				return which == "middle" ?? (float(m.xHeight) * s / 2.0, (float(m.ascent) + float(m.descent)) * s / 2.0)
			case "hanging":
				return float(m.ascent) * s * 0.8
			case "mathematical":
				return float(m.ascent) * s * 0.5
			case "text-top", "text-before-edge", "before-edge":
				return float(m.ascent) * s
			case "text-bottom", "text-after-edge", "after-edge", "ideographic":
				return float(m.descent) * s
		}
		return 0.0
	}

	// Glyphs on text paths: each glyph's middle at its distance along the
	// path, turned to the path's direction; glyphs off the path hidden.
	internal def alongPath(l TextLayout, first int) {
		for let i = first; i < l.glyphs.len(); i++ {
			let g = l.glyphs[i]
			let info = l.spans[g.span].path
			continue when info is none
			let mid = info.startOffset + g.x + g.advance / 2.0
			if mid < 0.0 || mid > info.length {
				g.hidden = true
				l.glyphs[i] = g
				continue
			}
			let (pt, dir) = info.path.pointAt(mid)
			let angle = atan2(dir.y, dir.x)
			// The glyph's origin half its advance back along the tangent, its
			// baseline offset across it.
			let across = g.y
			g.x = pt.x - cos(angle) * g.advance / 2.0 - sin(angle) * across
			g.y = pt.y - sin(angle) * g.advance / 2.0 + cos(angle) * across
			g.angle = angle
			l.glyphs[i] = g
		}
	}

	// The transform from a glyph's font units (y up) to user space.
	internal def glyphTransform(g TGlyph) Transform2D {
		let t = new Transform2D(tx = g.x, ty = g.y)
		let turn = g.angle + g.rotate * Pi / 180.0
		if turn != 0.0 {
			t = t.then(new Transform2D(a = cos(turn), b = sin(turn), c = -sin(turn), d = cos(turn)))
		}
		return t.then(new Transform2D(a = g.scale * g.stretch, d = -g.scale))
	}

	// The outline of the glyphs of span `s` (all spans with -1).
	internal def spanPath(l TextLayout, s int) Path {
		let out = new Path()
		for let (_, g) in l.glyphs {
			continue when g.hidden || (s >= 0 && g.span != s)
			// Colour glyphs are drawn from their colour data instead.
			continue when g.face.info().color && colorglyphs.hasColorGlyph(g.face, int(g.glyph))
			let outline = g.face.outline(g.glyph)
			continue when outline is error
			out.add(outline.path(1.0).transformed(new Transform2D(d = -1.0)), glyphTransform(g))
		}
		return out
	}

	// The text's box: every glyph's em cell.
	internal def textBox(l TextLayout) ?Rect {
		let out ?Rect = none
		for let (_, g) in l.glyphs {
			continue when g.hidden
			let m = g.face.metrics()
			let cell = Rect{left: 0.0, top: -float(m.descent), right: g.advance / g.scale, bottom: float(m.ascent)}
			out = unionBox(out, boxAfter(glyphTransform(g), cell))
		}
		return out
	}

	// Fills and strokes the text span by span, decorations under (underline,
	// overline) and over (line-through) it.
	internal def paintText(r Renderer, p Painter, n Node, ctx Ctx, l TextLayout) {
		return when l.glyphs.len() == 0
		let box = textBox(l)
		let bbox = box is Rect ?? (box, Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0})
		decorations(r, p, l, bbox, false)
		for let s = 0; s < l.spans.len(); s++ {
			let span = l.spans[s]
			let sctx = span.ctx
			continue unless sctx.st.get("visibility", "visible").lower() == "visible"
			colourGlyphs(r, p, l, s)
			let path = spanPath(l, s)
			continue when path.isEmpty()
			for let (_, step) in paintOrder(sctx.st.get("paint-order", "normal")) {
				if step == "fill" {
					let spec = r.paintSpec(sctx, "fill", "black")
					if spec is PaintSpec {
						let rule = sctx.st.get("fill-rule", "nonzero").lower() == "evenodd" ?? (FillRule.EvenOdd, FillRule.NonZero)
						r.paintPath(p, span.node, sctx, path, spec, parseOpacity(sctx.st.get("fill-opacity", "1")), rule, bbox)
					}
				} else if step == "stroke" {
					let spec = r.paintSpec(sctx, "stroke", "none")
					let stroke = strokeStyleOf(sctx)
					if spec is PaintSpec && stroke is StrokeStyle {
						r.paintPath(p, span.node, sctx, path.stroked(stroke), spec, parseOpacity(sctx.st.get("stroke-opacity", "1")), FillRule.NonZero, bbox)
					}
				}
			}
		}
		decorations(r, p, l, bbox, true)
	}

	// The colour glyphs of span `s`, the span's fill colour as the text
	// colour.
	internal def colourGlyphs(r Renderer, p Painter, l TextLayout, s int) {
		let sctx = l.spans[s].ctx
		let fill = r.paintSpec(sctx, "fill", "black")
		let foreground = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		if fill is PaintSpec && fill.kind == "color" {
			foreground = fill.color
		}
		let t = p.state().transform
		let device = sqrt((t.a * t.d - t.b * t.c).abs())
		for let (_, g) in l.glyphs {
			continue when g.hidden || g.span != s || !g.face.info().color
			continue unless colorglyphs.hasColorGlyph(g.face, int(g.glyph))
			let ppem = g.scale * float(g.face.info().unitsPerEm) * device
			colorglyphs.drawColorGlyph(p, g.face, int(g.glyph), glyphTransform(g), ppem, foreground)
		}
	}

	// The decoration lines of every decorating element over the glyphs
	// they cover: underline and overline (`over` false) or line-through.
	internal def decorations(r Renderer, p Painter, l TextLayout, bbox Rect, over bool) {
		for let s = 0; s < l.spans.len(); s++ {
			let span = l.spans[s]
			for let (k, d) in span.decorators {
				let dctx = span.decoCtx[k]
				let kinds = dctx.st.get("text-decoration", "none").lower()
				for let (_, kind) in splitList(kinds) {
					continue unless (kind := "underline" || "overline" || "line-through")
					continue when (kind == "line-through") != over
					let line = decorationPath(l, s, kind, dctx)
					continue when line.isEmpty()
					let fill = r.paintSpec(dctx, "fill", "black")
					if fill is PaintSpec {
						r.paintPath(p, d, dctx, line, fill, parseOpacity(dctx.st.get("fill-opacity", "1")), FillRule.NonZero, bbox)
					}
					let stroke = r.paintSpec(dctx, "stroke", "none")
					let st = strokeStyleOf(dctx)
					if stroke is PaintSpec && st is StrokeStyle {
						r.paintPath(p, d, dctx, line.stroked(st), stroke, parseOpacity(dctx.st.get("stroke-opacity", "1")), FillRule.NonZero, bbox)
					}
				}
			}
		}
	}

	// One rectangle per glyph of span `s` at the decoration's place and
	// thickness, from the decorating element's font.
	internal def decorationPath(l TextLayout, s int, kind string, dctx Ctx) Path {
		let out = new Path()
		for let (_, g) in l.glyphs {
			continue when g.hidden || g.span != s
			let m = g.face.metrics()
			let thick = float(m.underlineThickness > 0 ?? (m.underlineThickness, int16(float(g.face.info().unitsPerEm) / 14.0)))
			let at = 0.0
			match kind {
				case "underline":
					at = float(m.underlinePosition)
				case "overline":
					at = float(m.ascent)
				default:
					at = float(m.xHeight > 0 ?? (m.xHeight, int16(float(m.ascent) * 0.5))) / 2.0 + thick / 2.0
			}
			let rect = new Path().rect(Rect{left: 0.0, top: at - thick / 2.0, right: g.advance / g.scale, bottom: at + thick / 2.0})
			out.add(rect.transformed(new Transform2D(d = -1.0)).transformed(new Transform2D(d = -1.0)), glyphTransform(g))
		}
		return out
	}

	// Text inside a clip path: its glyphs filled opaque.
	internal def textCoverageOf(r Renderer, p Painter, n Node, ctx Ctx, white Color) {
		let l = layoutText(r, n, ctx)
		let rule = ctx.st.get("clip-rule", "nonzero").lower() == "evenodd" ?? (FillRule.EvenOdd, FillRule.NonZero)
		p.fill(spanPath(l, -1), white, rule)
	}
}
