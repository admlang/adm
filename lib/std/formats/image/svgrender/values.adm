// Property and attribute values: which properties exist and inherit,
// lengths, numbers, transforms, view boxes, colours and paints.

internal std partial module std.formats.image.svgrender {
	use (
		std.math::(Pi, tan, sqrt, sin, cos)
		std.math.geom::(Rect, Transform2D)
		std.gfx.color as colors
		std.gfx.color::(Color, RGBA)
	)

	// The CSS properties SVG elements take, with whether they inherit.
	internal let inheritedProperties = ["xml:space", "clip-rule", "color", "color-interpolation", "color-interpolation-filters", "color-rendering", "cursor", "direction", "dominant-baseline", "fill", "fill-opacity", "fill-rule", "font", "font-family", "font-feature-settings", "font-kerning", "font-size", "font-size-adjust", "font-stretch", "font-style", "font-variant", "font-variation-settings", "font-weight", "glyph-orientation-horizontal", "glyph-orientation-vertical", "image-rendering", "kerning", "letter-spacing", "marker", "marker-end", "marker-mid", "marker-start", "paint-order", "pointer-events", "shape-rendering", "stroke", "stroke-dasharray", "stroke-dashoffset", "stroke-linecap", "stroke-linejoin", "stroke-miterlimit", "stroke-opacity", "stroke-width", "text-anchor", "text-rendering", "visibility", "word-spacing", "writing-mode", "white-space", "text-orientation", "font-variant-ligatures", "font-variant-caps", "font-variant-numeric", "font-variant-east-asian", "font-variant-position", "text-decoration-color"]

	internal let otherProperties = ["alignment-baseline", "baseline-shift", "clip", "clip-path", "display", "filter", "flood-color", "flood-opacity", "isolation", "lighting-color", "mask", "mask-type", "mix-blend-mode", "opacity", "overflow", "stop-color", "stop-opacity", "text-decoration", "transform", "transform-origin", "transform-box", "unicode-bidi", "vector-effect", "enable-background", "background-color", "text-decoration-line", "text-decoration-style"]

	// Whether attribute `name` of element `tag` is a presentation
	// attribute: a property written as an attribute. `transform` is one
	// except on gradients and patterns, which name theirs differently.
	internal def isPresentationAttribute(name string, tag string) bool {
		if name == "transform" {
			return !(tag := "linearGradient" || "radialGradient" || "pattern")
		}
		return inheritedProperties.indexOf(name) >= 0 || otherProperties.indexOf(name) >= 0
	}

	internal def isInherited(name string) bool {
		return inheritedProperties.indexOf(name) >= 0
	}

	// Computed property values of one element: inherited ones carried down
	// the render tree, the element's own on top.
	type Style {
		values map<string, string>

		def new() {
			values = map<string, string>{}
		}

		def get(name string, otherwise string = "") string {
			let v = values.get(name)
			return v is none ?? (otherwise, v)
		}

		def has(name string) bool {
			return values.hasKey(name)
		}

		// The style of a child with `props` declared, under this one.
		def child(props map<string, string>) Style {
			let out = new Style()
			for let (k, v) in values {
				out.values[k] = v when isInherited(k)
			}
			for let (k, v) in props {
				let value = v.trim()
				let low = value.lower()
				if low == "inherit" {
					let p = values.get(k)
					if p is string {
						out.values[k] = p
					} else if k == "overflow" {
						// Nothing to inherit: the initial value, not the
						// user agent's hidden for viewports.
						out.values[k] = "visible"
					} else {
						out.values.delete(k)
					}
				} else if low == "initial" || (low == "unset" && !isInherited(k)) {
					out.values.delete(k)
				} else if low == "unset" {
					// Inherited properties keep the parent's value.
				} else {
					out.values[k] = value
				}
			}
			return out
		}
	}

	// A length or percentage resolved against a reference size; em and ex
	// against the font size.
	internal struct Length {
		value float
		unit  string // "", "px", "%", "em", "ex", "in", "cm", "mm", "pt", "pc", "q", "rem", "vw", "vh"
	}

	// A length, none when the text is not one.
	internal def parseLength(text string) ?Length {
		let t = text.trim()
		return none when t == ""
		let b = t.bytes()
		let end = numberEnd(b, 0)
		return none when end == 0
		let num = parseFloat<float>(string(b[0:end]))
		return none when num is error
		let unit = string(b[end:]).trim().lower()
		return none unless (unit := "" || "px" || "%" || "em" || "ex" || "in" || "cm" || "mm" || "pt" || "pc" || "q" || "rem" || "vw" || "vh" || "vmin" || "vmax" || "ch")
		return Length{value: num, unit: unit}
	}

	// Where the number starting at `from` ends: sign, digits, fraction,
	// exponent; `from` when there is none.
	internal def numberEnd(b byte[], from int) int {
		let at = from
		at++ when at < b.len() && (b[at] := byte('+') || byte('-'))
		let digits = 0
		for at < b.len() && b[at] >= byte('0') && b[at] <= byte('9') {
			at++
			digits++
		}
		if at < b.len() && b[at] == byte('.') {
			at++
			for at < b.len() && b[at] >= byte('0') && b[at] <= byte('9') {
				at++
				digits++
			}
		}
		return from when digits == 0
		if at < b.len() && (b[at] := byte('e') || byte('E')) {
			let mark = at
			at++
			at++ when at < b.len() && (b[at] := byte('+') || byte('-'))
			let exp = 0
			for at < b.len() && b[at] >= byte('0') && b[at] <= byte('9') {
				at++
				exp++
			}
			at = mark when exp == 0
		}
		return at
	}

	// A plain number, none when the text is not exactly one.
	internal def parseNumber(text string) ?float {
		let b = text.trim().bytes()
		let end = numberEnd(b, 0)
		return none when end == 0 || end != b.len()
		let v = parseFloat<float>(string(b))
		return none when v is error
		return v
	}

	// The numbers of a list separated by spaces and commas; none when an
	// item is not a number.
	internal def parseNumbers(text string) ?float[] {
		let b = text.bytes()
		let out float[]
		let at = 0
		for {
			for at < b.len() && (b[at] := byte(' ') || byte('\t') || byte('\n') || byte('\r') || byte(',')) {
				at++
			}
			break when at >= b.len()
			let end = numberEnd(b, at)
			return none when end == at
			let v = parseFloat<float>(string(b[at:end]))
			return none when v is error
			out.push(v)
			at = end
		}
		return out
	}

	// What lengths resolve against: the viewport and the font size.
	internal struct Units {
		width    float
		height   float
		fontSize float
		// The root element's font size, for rem.
		rootSize float = 12.0
	}

	internal def diagonal(u Units) float {
		return sqrt((u.width * u.width + u.height * u.height) / 2.0)
	}

	// The length in user units; `axis` picks what a percentage is of: "x"
	// the viewport width, "y" its height, anything else the normalized
	// diagonal.
	internal def toUser(l Length, u Units, axis string) float {
		match l.unit {
			case "", "px":
				return l.value
			case "%":
				let ref = axis == "x" ?? (u.width, axis == "y" ?? (u.height, diagonal(u)))
				return l.value / 100.0 * ref
			case "em":
				return l.value * u.fontSize
			case "rem":
				return l.value * u.rootSize
			case "ex":
				return l.value * u.fontSize / 2.0
			case "ch":
				return l.value * u.fontSize / 2.0
			case "in":
				return l.value * 96.0
			case "cm":
				return l.value * 96.0 / 2.54
			case "mm":
				return l.value * 96.0 / 25.4
			case "q":
				return l.value * 96.0 / 101.6
			case "pt":
				return l.value * 4.0 / 3.0
			case "pc":
				return l.value * 16.0
			case "vw":
				return l.value / 100.0 * u.width
			case "vh":
				return l.value / 100.0 * u.height
			case "vmin":
				return l.value / 100.0 * u.width.min(u.height)
			case "vmax":
				return l.value / 100.0 * u.width.max(u.height)
		}
		return l.value
	}

	// A transform list (`translate(10) rotate(45 5 5) matrix(…)`); none
	// when it does not parse, which leaves the element untransformed.
	internal def parseTransform(text string) ?Transform2D {
		let b = text.bytes()
		let t = new Transform2D()
		let at = 0
		for {
			for at < b.len() && (b[at] := byte(' ') || byte('\t') || byte('\n') || byte('\r') || byte(',')) {
				at++
			}
			break when at >= b.len()
			let start = at
			for at < b.len() && ((b[at] >= byte('a') && b[at] <= byte('z')) || (b[at] >= byte('A') && b[at] <= byte('Z'))) {
				at++
			}
			let name = string(b[start:at])
			for at < b.len() && (b[at] := byte(' ') || byte('\t') || byte('\n') || byte('\r')) {
				at++
			}
			return none unless at < b.len() && b[at] == byte('(')
			let close = at
			for close < b.len() && b[close] != byte(')') {
				close++
			}
			return none when close >= b.len()
			let args = parseNumbers(string(b[at + 1:close]))
			return none when args is none
			let a float[] = args
			let step = transformOf(name, a)
			return none when step is none
			t = t.then(step)
			at = close + 1
		}
		return t
	}

	internal def transformOf(name string, a float[]) ?Transform2D {
		match name {
			case "matrix":
				return none unless a.len() == 6
				return new Transform2D(a = a[0], b = a[1], c = a[2], d = a[3], tx = a[4], ty = a[5])
			case "translate":
				return none unless a.len() == 1 || a.len() == 2
				return new Transform2D(tx = a[0], ty = a.len() == 2 ?? (a[1], 0.0))
			case "scale":
				return none unless a.len() == 1 || a.len() == 2
				return new Transform2D(a = a[0], d = a.len() == 2 ?? (a[1], a[0]))
			case "rotate":
				return none unless a.len() == 1 || a.len() == 3
				let r = a[0] * Pi / 180.0
				let co = cos(r)
				let si = sin(r)
				let rot = new Transform2D(a = co, b = si, c = -si, d = co)
				return rot when a.len() == 1
				let there = new Transform2D(tx = a[1], ty = a[2])
				return there.then(rot).then(new Transform2D(tx = -a[1], ty = -a[2]))
			case "skewX":
				return none unless a.len() == 1
				return new Transform2D(c = tan(a[0] * Pi / 180.0))
			case "skewY":
				return none unless a.len() == 1
				return new Transform2D(b = tan(a[0] * Pi / 180.0))
		}
		return none
	}

	// A view box: min-x, min-y, width, height; none when malformed or
	// with a negative size.
	internal def parseViewBox(text string) ?Rect {
		let n = parseNumbers(text)
		return none when n is none
		let v float[] = n
		return none unless v.len() == 4 && v[2] >= 0.0 && v[3] >= 0.0
		return Rect{left: v[0], top: v[1], right: v[0] + v[2], bottom: v[1] + v[3]}
	}

	// preserveAspectRatio: the alignment ("none" or xMinYMin … xMaxYMax)
	// and whether to slice instead of meet.
	internal struct AspectRatio {
		align string
		slice bool
	}

	internal def parseAspectRatio(text string) AspectRatio {
		let parts = text.trim().split(" ")
		let words string[]
		for let (_, p) in parts {
			words.push(p) when p != ""
		}
		let out = AspectRatio{align: "xMidYMid", slice: false}
		return out when words.len() == 0
		let i = 0
		i++ when words[0] == "defer"
		return out when i >= words.len()
		let a = words[i]
		return out unless (a := "none" || "xMinYMin" || "xMidYMin" || "xMaxYMin" || "xMinYMid" || "xMidYMid" || "xMaxYMid" || "xMinYMax" || "xMidYMax" || "xMaxYMax")
		out.align = a
		if i + 1 < words.len() {
			return AspectRatio{align: "xMidYMid", slice: false} unless (words[i + 1] := "meet" || "slice")
			out.slice = words[i + 1] == "slice"
		}
		return out
	}

	// The transform that fits `box` into the viewport (x, y, w, h).
	internal def viewBoxTransform(box Rect, ar AspectRatio, x float, y float, w float, h float) Transform2D {
		let bw = box.right - box.left
		let bh = box.bottom - box.top
		let sx = w / bw
		let sy = h / bh
		if ar.align == "none" {
			return new Transform2D(a = sx, d = sy, tx = x - box.left * sx, ty = y - box.top * sy)
		}
		let s = ar.slice ?? (sx.max(sy), sx.min(sy))
		let ax = ar.align[1:4]
		let ay = ar.align[5:8]
		let dx = ax == "Min" ?? (0.0, ax == "Mid" ?? ((w - bw * s) / 2.0, w - bw * s))
		let dy = ay == "Min" ?? (0.0, ay == "Mid" ?? ((h - bh * s) / 2.0, h - bh * s))
		return new Transform2D(a = s, d = s, tx = x + dx - box.left * s, ty = y + dy - box.top * s)
	}

	// A colour value; `current` is what `currentColor` stands for. None
	// when the text is not a colour.
	internal def parseColor(text string, current Color) ?Color {
		let t = text.trim()
		let low = t.lower()
		return current when low == "currentcolor"
		return new Color(RGBA{r: 0, g: 0, b: 0, a: 0}) when low == "transparent"
		// ICC colours are not supported: a value naming one is invalid, as
		// browsers treat it.
		return none when low.contains("icc-color(")
		return none unless consistentRgb(low)
		let c = colors.parse(t)
		return none when c is error
		return c
	}

	// rgb() and rgba() take their three colour components all as numbers
	// or all as percentages.
	internal def consistentRgb(low string) bool {
		return true unless low.startsWith("rgb")
		let open = low.indexOf("(")
		let close = low.indexOf(")")
		return true when open < 0 || close < open
		let parts = splitColorList(low[open + 1:close])
		return true when parts.len() < 3
		let pct = parts[0].endsWith("%")
		return parts[1].endsWith("%") == pct && parts[2].endsWith("%") == pct
	}

	internal def splitColorList(text string) string[] {
		let out string[]
		for let (_, a) in text.replace(",", " ").replace("/", " ").split(" ") {
			out.push(a.trim()) when a.trim() != ""
		}
		return out
	}

	// A paint: none, a colour, a reference to a paint server with an
	// optional fallback, or context-fill / context-stroke.
	internal struct PaintSpec {
		kind     string // "none", "color", "url", "context-fill", "context-stroke"
		color    Color
		ref      string
		fallback ?PaintSpec
	}

	// A paint value; none when it does not parse (the property is then
	// treated as unset).
	internal def parsePaint(text string, current Color) ?PaintSpec {
		let t = text.trim()
		let low = t.lower()
		let black = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		return PaintSpec{kind: "none", color: black, ref: "", fallback: none} when low == "none"
		return PaintSpec{kind: low, color: black, ref: "", fallback: none} when (low := "context-fill" || "context-stroke")
		if low.startsWith("url(") {
			let close = t.indexOf(")")
			return none when close < 0
			let rest = t[close + 1:].trim()
			let fallback ?PaintSpec = none
			if rest != "" {
				// An invalid fallback makes the whole value invalid.
				fallback = parsePaint(rest, current)
				return none when fallback is none
			}
			return PaintSpec{kind: "url", color: black, ref: t[:close + 1], fallback: fallback}
		}
		let c = parseColor(t, current)
		return none when c is none
		return PaintSpec{kind: "color", color: c, ref: "", fallback: none}
	}

	// An opacity: a number or a percentage, clamped to 0..1.
	internal def parseOpacity(text string, otherwise float = 1.0) float {
		let t = text.trim()
		if t.endsWith("%") {
			let n = parseNumber(t[:t.len() - 1])
			return n is none ?? (otherwise, (n / 100.0).clamp(0.0, 1.0))
		}
		let n = parseNumber(t)
		return n is none ?? (otherwise, n.clamp(0.0, 1.0))
	}
}
