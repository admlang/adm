partial module std.formats.image {
	use (
		std.io
		std.bytes
	)

	// TGA is the Targa (TGA) codec. Decoding and encoding are not implemented yet;
	// matchSignature reports that nothing matches.
	@codec("Truevision TGA")
	type TGA {
		mimeType string[] {
			def get() string[] {
				return string["image/x-targa", "image/x-tga"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".tga"]
			}
		}

		// matchSignature reports whether the reader starts with a Targa (TGA) signature.
		// Not implemented yet: always false.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// info reads the image's dimensions and format from the bytes. Fails, as
		// decoding is not implemented yet.
		def info(data byte[]) !ImageInfo {
			return info(new bytes.Buffer(data))
		}

		// info reads the image's dimensions and format from the reader. Fails, as
		// decoding is not implemented yet.
		def info(reader io.Reader) !ImageInfo {
			fail "not implemented"
		}

		// decode reads a Targa (TGA) image from the bytes. Fails, as decoding is not
		// implemented yet.
		def decode(data byte[]) !Image {
			return decode(new bytes.Buffer(data))
		}

		// decode reads a Targa (TGA) image from the reader. Fails, as decoding is not
		// implemented yet.
		def decode(reader io.Reader) !Image {
			fail "not implemented"
		}

		// encode renders the image as Targa (TGA). Not implemented yet: returns no bytes.
		def encode() byte[] {}

		// encode writes the image as Targa (TGA) to the writer. Not implemented yet; it
		// cannot fail.
		def encode(writer io.Writer) !none {}
	}
}
