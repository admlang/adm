partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.formats.image.tga::*
	)

	// TGA is the Truevision Targa codec. It decodes colour-mapped, true colour
	// and grey images, raw or run-length encoded, at 8, 15, 16, 24 and 32
	// bits per pixel, in any origin, and encodes 24-bit (opaque) or 32-bit
	// (with alpha) true colour. The TGA 2.0 extension area's text fields are
	// read by decode and written back by encode.
	@codec("Truevision TGA")
	type TGA {
		// rle chooses run-length encoded output when encoding. On by default.
		rle      bool   = true
		// imageId is the free-form identification field after the header.
		imageId  string
		// author is the TGA 2.0 extension area's author name.
		author   string
		// comment is the TGA 2.0 extension area's comment, its lines joined with
		// newlines.
		comment  string
		// software is the TGA 2.0 extension area's software id.
		software string

		mimeType string[] {
			def get() string[] {
				return string["image/x-targa", "image/x-tga"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".tga"]
			}
		}

		// matchSignature reports whether the reader starts with a plausible TGA
		// header. TGA has no magic number and the TGA 2.0 footer sits at the end of
		// the file, so the check is strict: a known image type, a colour map that
		// agrees with it, a pixel depth the type allows and a non-empty size.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(tgaHeaderLen)
			let n = io.readFull(r, b) onerror recover 0
			return false when n != tgaHeaderLen
			let h = tgaParseHeader(b)
			return tgaHeaderValid(h)
		}

		// info reads the image's dimensions and format from the bytes. Fails when
		// they are not a TGA header.
		def info(data byte[]) !ImageInfo {
			fail "tga: truncated header" when data.len() < tgaHeaderLen
			let h = tgaParseHeader(data)
			fail "tga: not a TGA header" unless tgaHeaderValid(h)
			let format = color.ColorFormat.RGBA
			if h.imageType == tgaColorMapped || h.imageType == tgaRLEColorMapped {
				format = color.ColorFormat.Palette
			} else if h.imageType == tgaGray || h.imageType == tgaRLEGray {
				format = color.ColorFormat.Gray
			} else if h.bpp == 24 || h.alphaBits == 0 {
				format = color.ColorFormat.RGB
			}
			return ImageInfo{
				size: new geom.Size(float(h.width), float(h.height)),
				colorFormat: format,
			}
		}

		// info reads the image's dimensions and format from the reader. Fails when
		// the data is not a TGA header, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let b byte[]
			b.len(tgaHeaderLen)
			try io.readFull(reader, b)
			return info(b)
		}

		// decode reads a TGA image from the bytes, and the ID field and extension
		// area text into the codec's fields. Fails when they are not a TGA the
		// codec understands, or are truncated.
		def decode(data byte[]) !Image {
			fail "tga: truncated header" when data.len() < tgaHeaderLen
			let h = tgaParseHeader(data)
			fail "tga: not a TGA header" unless tgaHeaderValid(h)

			let pos = tgaHeaderLen + h.idLen
			fail "tga: truncated image id" when pos > data.len()
			imageId = tgaText(data[tgaHeaderLen:pos])
			readExtension(data)

			// The colour map as RGBA, 4 bytes per entry.
			let cmap byte[]
			if h.cmType == 1 {
				let entryBytes = (h.cmBits + 7) / 8
				let end = pos + h.cmLen * entryBytes
				fail "tga: truncated colour map" when end > data.len()
				cmap.len(h.cmLen * 4)
				for let i = 0; i < h.cmLen; i++ {
					tgaReadColor(data, pos + i * entryBytes, h.cmBits, h.alphaBits > 0 || h.cmBits == 32, cmap, i * 4)
				}
				pos = end
			}

			let w = h.width
			let ht = h.height
			const maxPixels = 256 * 1024 * 1024
			fail "tga: image too large" when w > maxPixels / ht

			let img = new Image(w, ht)
			let px = img.raw()
			let stride = img.stride()
			let pixBytes = (h.bpp + 7) / 8
			let mapped = h.imageType == tgaColorMapped || h.imageType == tgaRLEColorMapped
			let gray = h.imageType == tgaGray || h.imageType == tgaRLEGray
			let packed = h.imageType >= tgaRLEColorMapped
			let alpha = h.alphaBits > 0

			// Destination of the next pixel: rows run bottom-up unless topDown,
			// columns left to right unless rightLeft.
			let col = 0
			let y = h.topDown ?? (0, ht - 1)
			let xStep = h.rightLeft ?? (-4, 4)
			let d = y * stride + (h.rightLeft ?? ((w - 1) * 4, 0))

			let total = w * ht
			let done = 0
			let runLeft = 0
			let rawLeft = 0
			let src = pos
			for done < total {
				if packed && runLeft == 0 && rawLeft == 0 {
					fail "tga: truncated pixel data" when src >= data.len()
					let c = int(data[src])
					src++
					if c & 0x80 != 0 {
						runLeft = (c & 0x7F) + 1
					} else {
						rawLeft = c + 1
					}
				}
				fail "tga: truncated pixel data" when src + pixBytes > data.len()

				if mapped {
					let idx = int(data[src])
					idx = idx | int(data[src + 1]) << 8 when pixBytes == 2
					idx -= h.cmFirst
					fail "tga: colour index out of range" when idx < 0 || idx >= h.cmLen
					px[d] = cmap[idx * 4]
					px[d + 1] = cmap[idx * 4 + 1]
					px[d + 2] = cmap[idx * 4 + 2]
					px[d + 3] = cmap[idx * 4 + 3]
				} else if gray {
					let g = data[src]
					px[d] = g
					px[d + 1] = g
					px[d + 2] = g
					px[d + 3] = (pixBytes == 2 && alpha) ?? (data[src + 1], byte(255))
				} else {
					tgaReadColor(data, src, h.bpp, alpha, px, d)
				}

				if runLeft > 0 {
					runLeft--
					src += pixBytes when runLeft == 0
				} else {
					src += pixBytes
					rawLeft-- when rawLeft > 0
				}

				done++
				col++
				d += xStep
				if col == w {
					col = 0
					y = h.topDown ?? (y + 1, y - 1)
					d = y * stride + (h.rightLeft ?? ((w - 1) * 4, 0))
				}
			}
			return img
		}

		// decode reads a TGA image from the reader, and the ID field and extension
		// area text into the codec's fields. Fails when the data is not a TGA the
		// codec understands, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// encode renders the image as TGA: 24-bit when every pixel is opaque, else
		// 32-bit with 8 alpha bits, run-length encoded when `rle` is set, with a
		// TGA 2.0 footer and, when author, comment or software is set, an
		// extension area. Fails when the image is empty or larger than 65535
		// pixels on a side.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as TGA to the writer; see the byte overload for
		// the layout. Fails with the writer's error, or when the image is larger
		// than TGA's 65535 pixel limit.
		def encode(img Image, writer io.Writer) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			fail "tga: image larger than 65535 pixels" when w > 65535 || h > 65535
			fail "tga: empty image" when w <= 0 || h <= 0
			let px = img.raw()
			let stride = img.stride()

			let opaque = true
			for let y = 0; y < h && opaque; y++ {
				let o = y * stride + 3
				for let x = 0; x < w; x++ {
					if px[o] != 255 {
						opaque = false
						break
					}
					o += 4
				}
			}
			let pb = opaque ?? (3, 4)

			let id = imageId.bytes()
			id = id[0:255] when id.len() > 255

			let hasExt = author != "" || comment != "" || software != ""
			// Worst case: every row a series of full raw packets.
			let size = tgaHeaderLen + id.len() + h * (w * pb + (w + 127) / 128) + tgaFooterLen
			size += tgaExtensionLen when hasExt
			let out byte[]
			out.len(size)
			out[0] = byte(id.len())
			out[2] = byte(rle ?? (tgaRLETrueColor, tgaTrueColor))
			out[12] = byte(w & 0xFF)
			out[13] = byte(w >> 8)
			out[14] = byte(h & 0xFF)
			out[15] = byte(h >> 8)
			out[16] = byte(pb * 8)
			// Top-left origin, plus the alpha bit count.
			out[17] = byte(0x20 | (opaque ?? (0, 8)))
			let o = tgaHeaderLen
			for let i = 0; i < id.len(); i++ {
				out[o + i] = id[i]
			}
			o += id.len()

			for let y = 0; y < h; y++ {
				let row = y * stride
				if !rle {
					for let x = 0; x < w; x++ {
						o = tgaPutPixel(out, o, px, row + x * 4, pb)
					}
					continue
				}
				let x = 0
				for x < w {
					// A run of two or more equal pixels becomes a run packet.
					let a = row + x * 4
					let n = 1
					for x + n < w && n < 128 && tgaSamePixel(px, a, a + n * 4, pb) {
						n++
					}
					if n > 1 {
						out[o] = byte(0x80 | (n - 1))
						o = tgaPutPixel(out, o + 1, px, a, pb)
						x += n
						continue
					}
					// Otherwise a raw packet up to the next run.
					let head = o
					o++
					n = 0
					for x < w && n < 128 {
						a = row + x * 4
						break when n > 0 && x + 1 < w && tgaSamePixel(px, a, a + 4, pb)
						o = tgaPutPixel(out, o, px, a, pb)
						n++
						x++
					}
					out[head] = byte(n - 1)
				}
			}

			let extOffset = 0
			if hasExt {
				extOffset = o
				out[o] = byte(tgaExtensionLen & 0xFF)
				out[o + 1] = byte(tgaExtensionLen >> 8)
				tgaPutText(out, o + 2, 41, author)
				let lines = comment.split("\n")
				for let i = 0; i < 4 && i < lines.len(); i++ {
					tgaPutText(out, o + 43 + i * 81, 81, lines[i])
				}
				tgaPutText(out, o + 426, 41, software)
				out[o + 494] = byte(opaque ?? (0, 3))
				o += tgaExtensionLen
			}

			// TGA 2.0 footer: extension offset, developer directory offset, signature.
			out[o] = byte(extOffset & 0xFF)
			out[o + 1] = byte((extOffset >> 8) & 0xFF)
			out[o + 2] = byte((extOffset >> 16) & 0xFF)
			out[o + 3] = byte((extOffset >> 24) & 0xFF)
			tgaPutText(out, o + 8, 17, tgaSignature)
			out[o + 24] = byte('.')
			o += tgaFooterLen
			try writer.write(out[0:o])
		}

		// Reads the TGA 2.0 extension area's text fields when the footer points to
		// one; leaves them empty otherwise.
		internal def readExtension(data byte[]) {
			author = ""
			comment = ""
			software = ""
			let n = data.len()
			return when n < tgaHeaderLen + tgaFooterLen
			let sig = n - tgaFooterLen + 8
			return unless string(data[sig:sig + 16]) == tgaSignature
			let o = int(data[n - 26]) | int(data[n - 25]) << 8 | int(data[n - 24]) << 16 | int(data[n - 23]) << 24
			return when o < tgaHeaderLen || o + tgaExtensionLen > n - tgaFooterLen
			author = tgaText(data[o + 2:o + 43])
			let lines string[]
			for let i = 0; i < 4; i++ {
				let s = o + 43 + i * 81
				lines.push(tgaText(data[s:s + 81]))
			}
			for lines.len() > 0 && lines[lines.len() - 1] == "" {
				lines.pop()
			}
			comment = lines.join("\n")
			software = tgaText(data[o + 426:o + 467])
		}
	}
}

internal partial module std.formats.image.tga {
	const (
		tgaHeaderLen    = 18
		tgaFooterLen    = 26
		tgaExtensionLen = 495
		tgaSignature    = "TRUEVISION-XFILE"
	)

	// Image types: colour-mapped, true colour and grey, raw or run-length
	// encoded.
	const (
		tgaColorMapped    = 1
		tgaTrueColor      = 2
		tgaGray           = 3
		tgaRLEColorMapped = 9
		tgaRLETrueColor   = 10
		tgaRLEGray        = 11
	)

	// The fixed header every TGA file starts with.
	struct TgaHeader {
		idLen     int
		cmType    int
		imageType int
		cmFirst   int
		cmLen     int
		cmBits    int
		width     int
		height    int
		bpp       int
		alphaBits int
		rightLeft bool
		topDown   bool
	}

	def tgaParseHeader(b byte[]) TgaHeader {
		let desc = int(b[17])
		return TgaHeader{
			idLen: int(b[0]),
			cmType: int(b[1]),
			imageType: int(b[2]),
			cmFirst: int(b[3]) | int(b[4]) << 8,
			cmLen: int(b[5]) | int(b[6]) << 8,
			cmBits: int(b[7]),
			width: int(b[12]) | int(b[13]) << 8,
			height: int(b[14]) | int(b[15]) << 8,
			bpp: int(b[16]),
			alphaBits: desc & 0x0F,
			rightLeft: desc & 0x10 != 0,
			topDown: desc & 0x20 != 0,
		}
	}

	// Whether the header describes an image the codec decodes, strictly
	// enough that other formats' headers do not pass.
	def tgaHeaderValid(h TgaHeader) bool {
		return false when h.width == 0 || h.height == 0
		return false when h.alphaBits > h.bpp
		if h.cmType == 0 {
			return false when h.cmFirst != 0 || h.cmLen != 0 || h.cmBits != 0
		} else if h.cmType == 1 {
			return false unless h.cmBits := 15 || 16 || 24 || 32
			return false when h.cmLen == 0
		} else {
			return false
		}
		switch h.imageType {
			case tgaColorMapped, tgaRLEColorMapped:
				return h.cmType == 1 && (h.bpp == 8 || h.bpp == 16)
			case tgaTrueColor, tgaRLETrueColor:
				return h.bpp := 15 || 16 || 24 || 32
			case tgaGray, tgaRLEGray:
				return h.bpp == 8 || h.bpp == 16
		}
		return false
	}

	// Reads one little-endian BGR(A) colour of `bits` bits at `s` into `dst` at
	// `d` as RGBA. 15/16-bit colours carry an attribute bit, 32-bit ones an
	// alpha byte, used only when `alpha` is set.
	def tgaReadColor(src byte[], s int, bits int, alpha bool, dst byte[], d int) {
		if bits := 24 || 32 {
			dst[d] = src[s + 2]
			dst[d + 1] = src[s + 1]
			dst[d + 2] = src[s]
			dst[d + 3] = (bits == 32 && alpha) ?? (src[s + 3], byte(255))
			return
		}
		let v = int(src[s]) | int(src[s + 1]) << 8
		let r = (v >> 10) & 0x1F
		let g = (v >> 5) & 0x1F
		let b = v & 0x1F
		dst[d] = byte((r * 255 + 15) / 31)
		dst[d + 1] = byte((g * 255 + 15) / 31)
		dst[d + 2] = byte((b * 255 + 15) / 31)
		dst[d + 3] = (bits == 16 && alpha && v & 0x8000 == 0) ?? (byte(0), byte(255))
	}

	// Writes the RGBA pixel at `s` as BGR or BGRA at `o`; returns the next offset.
	def tgaPutPixel(out byte[], o int, px byte[], s int, n int) int {
		out[o] = px[s + 2]
		out[o + 1] = px[s + 1]
		out[o + 2] = px[s]
		if n == 4 {
			out[o + 3] = px[s + 3]
			return o + 4
		}
		return o + 3
	}

	def tgaSamePixel(px byte[], a int, b int, n int) bool {
		return px[a] == px[b] && px[a + 1] == px[b + 1] && px[a + 2] == px[b + 2] && (n == 3 || px[a + 3] == px[b + 3])
	}

	// A NUL-terminated, space-padded text field as a string.
	def tgaText(b byte[]) string {
		let n = 0
		for n < b.len() && b[n] != 0 {
			n++
		}
		return string(b[0:n]).trimEnd(" ")
	}

	// Writes `s` into the `n`-byte field at `o`, truncated to leave the NUL.
	def tgaPutText(dst byte[], o int, n int, s string) {
		let b = s.bytes()
		for let i = 0; i < b.len() && i < n - 1; i++ {
			dst[o + i] = b[i]
		}
	}
}
