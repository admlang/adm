partial module std.formats.image {
	use (
		std.testing
		std.bytes
	)

	check "TGA" {
		internal def assertPixel(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			assert int(img.raw()[o]) == r
			assert int(img.raw()[o + 1]) == g
			assert int(img.raw()[o + 2]) == b
			assert int(img.raw()[o + 3]) == a
		}

		internal def header(cmType int, imageType int, cmFirst int, cmLen int, cmBits int, w int, h int, bpp int, desc int) byte[] {
			return byte[
				0, byte(cmType), byte(imageType), byte(cmFirst & 0xFF), byte(cmFirst >> 8),
				byte(cmLen & 0xFF), byte(cmLen >> 8), byte(cmBits), 0, 0, 0, 0,
				byte(w), 0, byte(h), 0, byte(bpp), byte(desc)
			]
		}

		internal def decodeOr(data byte[]) Image {
			let codec = new TGA()
			return codec.decode(data) onerror recover new Image(1, 1)
		}

		// A 2x2 opaque test card: red, green / blue, white, top row first.
		internal def card() Image {
			let img = new Image(2, 2)
			let px = img.raw()
			let colors = byte[255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 255, 255]
			for let i = 0; i < 16; i++ {
				px[i] = colors[i]
			}
			return img
		}

		@test()
		def decodes_bottom_up_24_bit() {
			// Rows are stored bottom first: blue, white then red, green.
			let data = header(0, 2, 0, 0, 0, 2, 2, 24, 0) + byte[255, 0, 0, 255, 255, 255, 0, 0, 255, 0, 255, 0]
			let img = decodeOr(data)
			assert int(img.size().width) == 2
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 1, 0, 0, 255, 0, 255)
			assertPixel(img, 0, 1, 0, 0, 255, 255)
			assertPixel(img, 1, 1, 255, 255, 255, 255)
		}

		@test()
		def decodes_right_to_left() {
			let data = header(0, 2, 0, 0, 0, 2, 1, 24, 0x30) + byte[0, 0, 255, 0, 255, 0]
			let img = decodeOr(data)
			assertPixel(img, 0, 0, 0, 255, 0, 255)
			assertPixel(img, 1, 0, 255, 0, 0, 255)
		}

		@test()
		def decodes_32_bit_alpha_only_with_alpha_bits() {
			let px = byte[10, 20, 30, 40]
			let img = decodeOr(header(0, 2, 0, 0, 0, 1, 1, 32, 0x28) + px)
			assertPixel(img, 0, 0, 30, 20, 10, 40)
			img = decodeOr(header(0, 2, 0, 0, 0, 1, 1, 32, 0x20) + px)
			assertPixel(img, 0, 0, 30, 20, 10, 255)
		}

		@test()
		def decodes_15_and_16_bit() {
			// 0x7C1F: red and blue full, green zero; the top bit is the attribute.
			let img = decodeOr(header(0, 2, 0, 0, 0, 2, 1, 16, 0x21) + byte[0x1F, 0x7C, 0x1F, 0xFC])
			assertPixel(img, 0, 0, 255, 0, 255, 0)
			assertPixel(img, 1, 0, 255, 0, 255, 255)
			img = decodeOr(header(0, 2, 0, 0, 0, 1, 1, 15, 0x20) + byte[0x10, 0x02])
			assertPixel(img, 0, 0, 0, 132, 132, 255)
		}

		@test()
		def decodes_a_colour_map_from_its_first_index() {
			// Map entries 3 and 4; pixel values index them as 3 and 4.
			let data = header(1, 1, 3, 2, 24, 2, 1, 8, 0x20) + byte[0, 0, 200, 0, 100, 0] + byte[4, 3]
			let img = decodeOr(data)
			assertPixel(img, 0, 0, 0, 100, 0, 255)
			assertPixel(img, 1, 0, 200, 0, 0, 255)
		}

		@test()
		def decodes_16_bit_indexes_and_32_bit_map_entries() {
			let data = header(1, 1, 0, 2, 32, 2, 1, 16, 0x20) + byte[1, 2, 3, 4, 5, 6, 7, 8] + byte[1, 0, 0, 0]
			let img = decodeOr(data)
			assertPixel(img, 0, 0, 7, 6, 5, 8)
			assertPixel(img, 1, 0, 3, 2, 1, 4)
		}

		@test()
		def decodes_grey_and_grey_alpha() {
			let img = decodeOr(header(0, 3, 0, 0, 0, 2, 1, 8, 0x20) + byte[0, 200])
			assertPixel(img, 1, 0, 200, 200, 200, 255)
			img = decodeOr(header(0, 3, 0, 0, 0, 1, 1, 16, 0x28) + byte[90, 60])
			assertPixel(img, 0, 0, 90, 90, 90, 60)
		}

		// Run-length packets may run across the end of a row.
		@test()
		def decodes_rle_across_rows() {
			let data = header(0, 10, 0, 0, 0, 3, 2, 24, 0x20) + byte[0x83, 0, 0, 255, 0x01, 255, 0, 0, 0, 255, 0]
			let img = decodeOr(data)
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 2, 0, 255, 0, 0, 255)
			assertPixel(img, 0, 1, 255, 0, 0, 255)
			assertPixel(img, 1, 1, 0, 0, 255, 255)
			assertPixel(img, 2, 1, 0, 255, 0, 255)
		}

		@test()
		def decodes_rle_mapped_and_grey() {
			let img = decodeOr(header(1, 9, 0, 1, 24, 2, 1, 8, 0x20) + byte[1, 2, 3] + byte[0x81, 0])
			assertPixel(img, 1, 0, 3, 2, 1, 255)
			img = decodeOr(header(0, 11, 0, 0, 0, 2, 2, 8, 0x20) + byte[0x83, 77])
			assertPixel(img, 1, 1, 77, 77, 77, 255)
		}

		@test()
		def reads_the_id_and_extension_text() {
			let codec = new TGA()
			codec.imageId = "card"
			codec.author = "Ada"
			codec.comment = "first\nsecond"
			codec.software = "adm"
			let data = codec.encode(card()) onerror recover byte[]
			let back = new TGA()
			let img = back.decode(data) onerror recover new Image(1, 1)
			assert int(img.size().width) == 2
			assert back.imageId == "card"
			assert back.author == "Ada"
			assert back.comment == "first\nsecond"
			assert back.software == "adm"
		}

		@test()
		def round_trips_opaque_as_24_bit() {
			for let (_, packed) in bool[true, false] {
				let codec = new TGA()
				codec.rle = packed
				let data = codec.encode(card()) onerror recover byte[]
				assert int(data[16]) == 24
				assert int(data[2]) == (packed ?? (10, 2))
				let img = decodeOr(data)
				assertPixel(img, 0, 0, 255, 0, 0, 255)
				assertPixel(img, 1, 0, 0, 255, 0, 255)
				assertPixel(img, 0, 1, 0, 0, 255, 255)
				assertPixel(img, 1, 1, 255, 255, 255, 255)
			}
		}

		@test()
		def round_trips_alpha_and_runs_as_32_bit() {
			let img = new Image(300, 3)
			let px = img.raw()
			for let i = 0; i < px.len(); i += 4 {
				px[i] = byte((i / 4) % 7 < 3 ?? (9, (i / 4) & 0xFF))
				px[i + 3] = byte(128)
			}
			let codec = new TGA()
			let data = codec.encode(img) onerror recover byte[]
			assert int(data[16]) == 32
			assert data.len() < 18 + 300 * 3 * 4
			let back = decodeOr(data)
			assert back.raw().equals(px)
		}

		@test()
		def info_reads_the_header() {
			let codec = new TGA()
			let got = codec.info(header(1, 1, 0, 2, 24, 7, 5, 8, 0)) onerror recover ImageInfo{}
			assert int(got.size.width) == 7
			assert int(got.size.height) == 5
		}

		@test()
		def matches_only_plausible_headers() {
			let tga = new TGA()
			assert tga.matchSignature(new bytes.Reader(header(0, 2, 0, 0, 0, 2, 2, 24, 0)))
			assert tga.matchSignature(new bytes.Reader(header(1, 9, 0, 16, 24, 2, 2, 8, 0x20)))
			// A true-colour header with a stray pixel depth.
			assert !tga.matchSignature(new bytes.Reader(header(0, 2, 0, 0, 0, 2, 2, 12, 0)))
			// Colour-mapped without a map.
			assert !tga.matchSignature(new bytes.Reader(header(0, 1, 0, 0, 0, 2, 2, 8, 0)))
			// ICO and CUR directories, a PCX and a BMP header.
			assert !tga.matchSignature(new bytes.Reader(byte[0, 0, 1, 0, 1, 0, 16, 16, 0, 0, 1, 0, 32, 0, 104, 4, 0, 0]))
			assert !tga.matchSignature(new bytes.Reader(byte[0, 0, 2, 0, 1, 0, 32, 32, 0, 0, 4, 0, 4, 0, 168, 16, 0, 0]))
			assert !tga.matchSignature(new bytes.Reader(byte[10, 5, 1, 8, 0, 0, 0, 0, 1, 0, 1, 0, 72, 0, 72, 0, 0, 0]))
			assert !tga.matchSignature(new bytes.Reader(byte[66, 77, 70, 0, 0, 0, 0, 0, 0, 0, 54, 0, 0, 0, 40, 0, 0, 0]))
			assert !tga.matchSignature(new bytes.Reader(byte[0, 0, 2]))
		}

		@test()
		def rejects_corrupt_input() {
			let codec = new TGA()
			// Truncated pixels, a bad colour index, a truncated header.
			let img = codec.decode(header(0, 2, 0, 0, 0, 2, 2, 24, 0) + byte[1, 2, 3]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
			img = codec.decode(header(1, 1, 0, 1, 24, 1, 1, 8, 0) + byte[1, 2, 3, 5]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
			img = codec.decode(byte[0, 0, 2, 0]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
			img = codec.decode(header(0, 10, 0, 0, 0, 2, 2, 24, 0) + byte[0x83]) onerror recover new Image(7, 7)
			assert int(img.size().width) == 7
		}
	}
}
