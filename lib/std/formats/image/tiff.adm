partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.data.compress.zlib
		std.formats.image.tiff::*
	)

	// TIFFCompression is how a TIFF page's pixel data is compressed; the values
	// are the codes the format stores. The encoder writes None, LZW, Deflate
	// and PackBits; the decoder also reads JPEG.
	enum TIFFCompression {
		None = 1,
		CCITTRLE = 2,
		CCITTFax3 = 3,
		CCITTFax4 = 4,
		LZW = 5,
		OldJPEG = 6,
		JPEG = 7,
		Deflate = 8,
		PackBits = 32773,
	}

	// TIFFPhotometric is how a TIFF page's samples map to colour; the values
	// are the codes the format stores.
	enum TIFFPhotometric {
		WhiteIsZero = 0,
		BlackIsZero = 1,
		RGB = 2,
		Palette = 3,
		Mask = 4,
		CMYK = 5,
		YCbCr = 6,
		CIELab = 8,
	}

	// TIFFResolutionUnit is the unit of a TIFF page's resolution.
	enum TIFFResolutionUnit {
		None = 1,
		Inch = 2,
		Centimeter = 3,
	}

	// TIFFPage describes one page (image file directory) of a TIFF file, as
	// its tags state it.
	struct TIFFPage {
		// Stored pixel dimensions, before the orientation is applied.
		width           int
		height          int
		bitsPerSample   int
		samplesPerPixel int
		photometric     TIFFPhotometric
		compression     TIFFCompression
		// Whether an extra sample holds alpha.
		alpha           bool
		// Whether the pixels are stored in tiles rather than strips.
		tiled           bool
		// 1 (top-left, the default) to 8, as in EXIF; decoding applies it.
		orientation     int
		xResolution     float
		yResolution     float
		resolutionUnit  TIFFResolutionUnit
		description     string
		software        string
		dateTime        string
		artist          string
		documentName    string
		pageName        string
	}

	// TIFF is the TIFF codec. A file holds pages: decoding reads the tags of
	// every page into `pages` and returns the first page's image, `page(i)`
	// renders any other. Encoding writes RGB or RGBA with 8-bit samples,
	// compressed with `compression`; `add` appends pages that the no-image
	// `encode` writes out together with the decoded ones.
	//
	// Example: Extract the second page
	// ```example
	// let tiff = new TIFF()
	// try tiff.decode(data)
	// let second = try tiff.page(1)
	// ```
	@codec("Tagged Image File Format")
	type TIFF {
		// How the encoder compresses pixel data: None, LZW (the default),
		// Deflate or PackBits. LZW and Deflate use horizontal prediction.
		compression TIFFCompression = TIFFCompression.LZW
		// The pages the last decode found, or the pages added since, in file
		// order.
		pages       TIFFPage[]

		internal source TIFFFile
		internal dirs   TIFFDir[]
		internal images Image[]
		internal loaded bool[]

		mimeType string[] {
			def get() string[] {
				return string["image/tiff"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".tif", ".tiff"]
			}
		}

		// matchSignature reports whether the reader starts with a TIFF or
		// BigTIFF header in either byte order.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(4)
			let n = r.read(b) onerror recover 0
			return false when n != 4
			let b0 = int(b[0])
			let b1 = int(b[1])
			let b2 = int(b[2])
			let b3 = int(b[3])
			return b1 == 0x49 && (b2 := 42 || 43) && b3 == 0 when b0 == 0x49
			return b1 == 0x4D && b2 == 0 && (b3 := 42 || 43) when b0 == 0x4D
			return false
		}

		// info reads the pages' tags into `pages` and describes the first page.
		// Fails when the bytes are not a TIFF file or its first directory is
		// damaged.
		def info(data byte[]) !ImageInfo {
			try parse(data)
			let d = dirs[0]
			let photometric = tiffPhotometric(d)
			let swap = d.orientation >= 5 && d.orientation <= 8
			let format = color.ColorFormat.RGB
			let palette = new color.Palette(0)
			if photometric == 3 {
				format = color.ColorFormat.Palette
				let colors = 1 << d.bits
				if d.bits <= 8 && d.colorMap.len() >= 3 * colors {
					let wide = false
					for let (_, v) in d.colorMap {
						wide = true when v > 255
					}
					for let i = 0; i < colors; i++ {
						let r = d.colorMap[i]
						let g = d.colorMap[colors + i]
						let b = d.colorMap[2 * colors + i]
						if wide {
							r = (r + 128) / 257
							g = (g + 128) / 257
							b = (b + 128) / 257
						}
						palette.add(new color.Color(color.RGBA{r: byte(r), g: byte(g), b: byte(b), a: 0xff}))
					}
				}
			} else if photometric := 0 || 1 {
				format = d.bits > 8 ?? (color.ColorFormat.Gray16, color.ColorFormat.Gray)
			} else if photometric == 5 {
				format = color.ColorFormat.CMYK
			} else if photometric == 6 {
				format = color.ColorFormat.YCbCr
			}
			format = color.ColorFormat.RGBA when d.samples > tiffColorSamples(photometric)
			return ImageInfo{
				size: new geom.Size(float(swap ?? (d.height, d.width)), float(swap ?? (d.width, d.height))),
				colorFormat: format,
				palette: palette,
			}
		}

		// info reads the pages' tags from the reader into `pages` and describes
		// the first page. Fails when the data is not a TIFF file, or the reader
		// fails.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads the pages' tags into `pages` and returns the first page's
		// image, oriented. Fails when the bytes are not a TIFF file or the first
		// page uses a feature the codec does not read.
		def decode(data byte[]) !Image {
			try parse(data)
			return page(0)
		}

		// decode reads the pages' tags from the reader into `pages` and returns
		// the first page's image, oriented. Fails when the data is not a TIFF
		// file, the first page uses a feature the codec does not read, or the
		// reader fails.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// page returns the image of page `index` (from 0), oriented, decoding it
		// on first use. Fails when there is no such page or its data cannot be
		// decoded.
		def page(index int) !Image {
			expects {
				assert index >= 0 && index < pages.len() onerror fail "tiff: no page {index}, the file has {pages.len()}"
			}
			return images[index] when loaded[index]
			let img = try new TIFFPageDecoder(source, dirs[index]).run()
			images[index] = img
			loaded[index] = true
			return img
		}

		// add appends an image as a new page, written by the no-image `encode`.
		def add(img Image) {
			let w = int(img.size().width)
			let h = int(img.size().height)
			let alpha = tiffHasAlpha(img)
			pages.push(TIFFPage{
				width: w,
				height: h,
				bitsPerSample: 8,
				samplesPerPixel: alpha ?? (4, 3),
				photometric: TIFFPhotometric.RGB,
				compression: compression,
				alpha: alpha,
				orientation: 1,
				xResolution: 72.0,
				yResolution: 72.0,
				resolutionUnit: TIFFResolutionUnit.Inch,
			})
			dirs.push(new TIFFDir())
			images.push(img)
			loaded.push(true)
		}

		// encode renders every page as a multi-page TIFF. Fails when there are
		// no pages, a decoded page cannot be read back, or `compression` is not
		// one the encoder writes.
		def encode() !byte[] {
			let out = new bytes.Buffer()
			try encode(out)
			return out.bytes()
		}

		// encode writes every page to the writer as a multi-page TIFF, each with
		// its description, software, date, artist, names and resolution. Fails
		// when there are no pages, a decoded page cannot be read back,
		// `compression` is not one the encoder writes, or the writer fails.
		def encode(writer io.Writer) !none {
			fail "tiff: no pages to encode" when pages.len() == 0
			let imgs Image[]
			for let i = 0; i < pages.len(); i++ {
				imgs.push(try page(i))
			}
			let data = try write(imgs, pages)
			try writer.write(data)
		}

		// encode renders the image as a one-page TIFF. Fails when `compression`
		// is not one the encoder writes.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image to the writer as a one-page TIFF: RGB with
		// 8-bit samples, RGBA when any pixel is not opaque. Fails when
		// `compression` is not one the encoder writes, or the writer fails.
		def encode(img Image, writer io.Writer) !none {
			let info = TIFFPage{
				xResolution: 72.0,
				yResolution: 72.0,
				resolutionUnit: TIFFResolutionUnit.Inch,
			}
			let data = try write(Image[img], TIFFPage[info])
			try writer.write(data)
		}

		internal def parse(data byte[]) !none {
			source = new TIFFFile(data)
			try source.header()
			pages = []
			dirs = []
			images = []
			loaded = []
			let seen = map<int, bool>{}
			let off = source.firstDir()
			for off != 0 {
				break when seen.hasKey(off) || dirs.len() >= 65536
				seen[off] = true
				let d = source.dir(off)
				if d.problem != "" {
					fail d.problem when dirs.len() == 0
					break
				}
				dirs.push(d)
				pages.push(tiffPageOf(d))
				images.push(new Image(0, 0))
				loaded.push(false)
				off = d.next
			}
			fail "tiff: no image directory" when dirs.len() == 0
		}

		internal def write(imgs Image[], infos TIFFPage[]) !byte[] {
			let comp = int(compression)
			fail "tiff: cannot encode with compression {comp}" unless comp := 1 || 5 || 8 || 32773
			let out = new TIFFWriter()
			out.u16(0x4949)
			out.u16(42)
			let link = out.pos()
			out.u32(0)
			let lzw = new TIFFLzwEncoder()
			for let (pageIndex, img) in imgs {
				let w = int(img.size().width)
				let h = int(img.size().height)
				fail "tiff: cannot encode an empty image" when w <= 0 || h <= 0
				let alpha = tiffHasAlpha(img)
				let spp = alpha ?? (4, 3)
				let rowLen = w * spp
				let rps = 65536 / rowLen
				rps = 1 when rps < 1
				rps = h when rps > h
				let predict = comp := 5 || 8
				let offsets int[]
				let counts int[]
				let px = img.raw()
				let stride = img.stride()
				let row byte[]
				row.len(rowLen)
				for let y0 = 0; y0 < h; y0 += rps {
					let rows = y0 + rps > h ?? (h - y0, rps)
					let raw byte[]
					let packed byte[]
					for let r = 0; r < rows; r++ {
						let src = (y0 + r) * stride
						if alpha {
							px[src:src + rowLen].copy(row)
						} else {
							for let x = 0; x < w; x++ {
								row[x * 3] = px[src + x * 4]
								row[x * 3 + 1] = px[src + x * 4 + 1]
								row[x * 3 + 2] = px[src + x * 4 + 2]
							}
						}
						if predict {
							for let i = rowLen - 1; i >= spp; i-- {
								row[i] = byte((int(row[i]) - int(row[i - spp])) & 0xFF)
							}
						}
						if comp == 32773 {
							tiffPackBits(row, packed)
						} else {
							let at = raw.len()
							raw.len(at + rowLen)
							row.copy(raw[at:])
						}
					}
					let strip = packed
					if comp == 1 {
						strip = raw
					} else if comp == 5 {
						strip = lzw.encode(raw)
					} else if comp == 8 {
						let buf = new bytes.Buffer()
						let zw = new zlib.Writer(buf)
						try zw.write(raw)
						try zw.close()
						strip = buf.bytes()
					}
					out.align()
					offsets.push(out.pos())
					counts.push(strip.len())
					out.write(strip)
				}

				let info = infos[pageIndex]
				let entries TIFFOutEntry[]
				entries.push(tiffLongs(254, int[imgs.len() > 1 ?? (2, 0)]))
				entries.push(tiffLongs(256, int[w]))
				entries.push(tiffLongs(257, int[h]))
				entries.push(tiffShorts(258, alpha ?? (int[8, 8, 8, 8], int[8, 8, 8])))
				entries.push(tiffShorts(259, int[comp]))
				entries.push(tiffShorts(262, int[2]))
				entries.push(tiffAscii(269, info.documentName)) when info.documentName != ""
				entries.push(tiffAscii(270, info.description)) when info.description != ""
				entries.push(tiffLongs(273, offsets))
				entries.push(tiffShorts(277, int[spp]))
				entries.push(tiffLongs(278, int[rps]))
				entries.push(tiffLongs(279, counts))
				let xRes = info.xResolution > 0.0 ?? (info.xResolution, 72.0)
				let yRes = info.yResolution > 0.0 ?? (info.yResolution, 72.0)
				entries.push(tiffRational(282, xRes))
				entries.push(tiffRational(283, yRes))
				entries.push(tiffShorts(284, int[1]))
				entries.push(tiffAscii(285, info.pageName)) when info.pageName != ""
				let unit = int(info.resolutionUnit)
				unit = 2 when unit < 1 || unit > 3
				entries.push(tiffShorts(296, int[unit]))
				entries.push(tiffShorts(297, int[pageIndex, imgs.len()])) when imgs.len() > 1
				entries.push(tiffAscii(305, info.software)) when info.software != ""
				entries.push(tiffAscii(306, info.dateTime)) when info.dateTime != ""
				entries.push(tiffAscii(315, info.artist)) when info.artist != ""
				entries.push(tiffShorts(317, int[2])) when predict
				entries.push(tiffShorts(338, int[2])) when alpha

				// Values too large for their entry go before the directory.
				let places int[]
				for let (_, e) in entries {
					if e.value.len() > 4 {
						out.align()
						places.push(out.pos())
						out.write(e.value)
					} else {
						places.push(-1)
					}
				}
				out.align()
				out.patch32(link, out.pos())
				out.u16(entries.len())
				for let (i, e) in entries {
					out.u16(e.tag)
					out.u16(e.typ)
					out.u32(e.count)
					if places[i] >= 0 {
						out.u32(places[i])
					} else {
						let v = e.value.clone()
						v.len(4)
						out.write(v)
					}
				}
				link = out.pos()
				out.u32(0)
			}
			return out.data
		}
	}
}

internal partial module std.formats.image.tiff {
	use (
		std.bytes
		std.data.compress.zlib
		std.formats.image::*
	)

	// One directory entry: its tag, type, count and where its value starts.
	struct TIFFEntry {
		tag   int
		typ   int
		count int
		pos   int
	}

	// The tags of one directory that decoding needs.
	type TIFFDir {
		width        int
		height       int
		bits         int     = 1
		mixedBits    bool
		samples      int     = 1
		sampleFormat int     = 1
		compression  int     = 1
		photometric  int     = -1
		planar       int     = 1
		predictor    int     = 1
		fillOrder    int     = 1
		orientation  int     = 1
		rowsPerStrip int     = 0
		tileWidth    int
		tileHeight   int
		offsets      int[]
		counts       int[]
		colorMap     int[]
		extraSamples int[]
		inkSet       int     = 1
		subH         int     = 2
		subV         int     = 2
		coeffs       float[]
		refBW        float[]
		jpegTables   byte[]
		xRes         float
		yRes         float
		resUnit      int     = 2
		description  string
		software     string
		dateTime     string
		artist       string
		documentName string
		pageName     string
		next         int
		problem      string
	}

	// Size in bytes of one value of a TIFF field type; 0 for an unknown type.
	def tiffTypeSize(t int) int {
		match t {
			case 1, 2, 6, 7:
				return 1
			case 3, 8:
				return 2
			case 4, 9, 11, 13:
				return 4
			case 5, 10, 12, 16, 17, 18:
				return 8
		}
		return 0
	}

	// The bytes of a TIFF file with its byte order and offset width.
	type TIFFFile {
		data   byte[]
		little bool
		big    bool

		def new(data byte[]) {
			self.data = data
		}

		// Reads the header's byte order and version. Fails when it is not a
		// TIFF or BigTIFF header.
		def header() !none {
			fail "tiff: not a TIFF file" when data.len() < 8
			let b0 = int(data[0])
			let b1 = int(data[1])
			if b0 == 0x49 && b1 == 0x49 {
				little = true
			} else {
				fail "tiff: not a TIFF file" unless b0 == 0x4D && b1 == 0x4D
			}
			let magic = u16(2)
			if magic == 43 {
				fail "tiff: truncated BigTIFF header" when data.len() < 16
				fail "tiff: unsupported BigTIFF offset size" when u16(4) != 8
				big = true
			} else {
				fail "tiff: not a TIFF file" when magic != 42
			}
		}

		def u16(p int) int {
			return int(data[p]) | int(data[p + 1]) << 8 when little
			return int(data[p]) << 8 | int(data[p + 1])
		}

		def u32(p int) int {
			return int(data[p]) | int(data[p + 1]) << 8 | int(data[p + 2]) << 16 | int(data[p + 3]) << 24 when little
			return int(data[p]) << 24 | int(data[p + 1]) << 16 | int(data[p + 2]) << 8 | int(data[p + 3])
		}

		// A 16-bit value of another buffer in the file's byte order.
		def u16In(b byte[], p int) int {
			return int(b[p]) | int(b[p + 1]) << 8 when little
			return int(b[p]) << 8 | int(b[p + 1])
		}

		// A 32-bit value of another buffer in the file's byte order.
		def u32In(b byte[], p int) int {
			return int(b[p]) | int(b[p + 1]) << 8 | int(b[p + 2]) << 16 | int(b[p + 3]) << 24 when little
			return int(b[p]) << 24 | int(b[p + 1]) << 16 | int(b[p + 2]) << 8 | int(b[p + 3])
		}

		def put16(b byte[], p int, v int) {
			if little {
				b[p] = byte(v & 0xFF)
				b[p + 1] = byte((v >> 8) & 0xFF)
			} else {
				b[p] = byte((v >> 8) & 0xFF)
				b[p + 1] = byte(v & 0xFF)
			}
		}

		def put32(b byte[], p int, v int) {
			if little {
				b[p] = byte(v & 0xFF)
				b[p + 1] = byte((v >> 8) & 0xFF)
				b[p + 2] = byte((v >> 16) & 0xFF)
				b[p + 3] = byte((v >> 24) & 0xFF)
			} else {
				b[p] = byte((v >> 24) & 0xFF)
				b[p + 1] = byte((v >> 16) & 0xFF)
				b[p + 2] = byte((v >> 8) & 0xFF)
				b[p + 3] = byte(v & 0xFF)
			}
		}

		def u64(p int) int {
			return u32(p) | u32(p + 4) << 32 when little
			return u32(p) << 32 | u32(p + 4)
		}

		// An offset field: four bytes, or eight in BigTIFF.
		def offset(p int) int {
			return u64(p) when big
			return u32(p)
		}

		def firstDir() int {
			return offset(8) when big
			return offset(4)
		}

		def fits(p int, n int) bool {
			return p >= 0 && n >= 0 && p <= data.len() && n <= data.len() - p
		}

		// The entry's integer values; empty for a non-integer type.
		def ints(e TIFFEntry) int[] {
			let out int[]
			let size = tiffTypeSize(e.typ)
			for let i = 0; i < e.count; i++ {
				let p = e.pos + i * size
				match e.typ {
					case 1, 7:
						out.push(int(data[p]))
					case 6:
						out.push(int(int8(data[p])))
					case 3:
						out.push(u16(p))
					case 8:
						out.push(int(int16(u16(p))))
					case 4, 13:
						out.push(u32(p))
					case 9:
						out.push(int(int32(u32(p))))
					case 16, 17, 18:
						out.push(u64(p))
					default:
						return out
				}
			}
			return out
		}

		// The entry's first value as a number, rationals included.
		def number(e TIFFEntry) float {
			return 0.0 when e.count < 1
			if e.typ := 5 || 10 {
				let num = u32(e.pos)
				let den = u32(e.pos + 4)
				if e.typ == 10 {
					num = int(int32(num))
					den = int(int32(den))
				}
				return 0.0 when den == 0
				return float(num) / float(den)
			}
			let v = ints(e)
			return 0.0 when v.len() == 0
			return float(v[0])
		}

		// The entry's values as numbers, rationals included.
		def numbers(e TIFFEntry) float[] {
			let out float[]
			if e.typ := 5 || 10 {
				for let i = 0; i < e.count; i++ {
					let num = u32(e.pos + i * 8)
					let den = u32(e.pos + i * 8 + 4)
					if e.typ == 10 {
						num = int(int32(num))
						den = int(int32(den))
					}
					out.push(den == 0 ?? (0.0, float(num) / float(den)))
				}
				return out
			}
			for let (_, v) in ints(e) {
				out.push(float(v))
			}
			return out
		}

		// The entry's ASCII value up to its first NUL.
		def text(e TIFFEntry) string {
			let n = 0
			for n < e.count && data[e.pos + n] != byte(0) {
				n++
			}
			return string(data[e.pos:e.pos + n])
		}

		// Reads the directory at `off`. Tags whose values lie outside the file
		// are skipped; a directory that does not fit comes back with `problem`
		// set.
		def dir(off int) TIFFDir {
			let entrySize = big ?? (20, 12)
			let countSize = big ?? (8, 2)
			let inline = big ?? (8, 4)
			let d = new TIFFDir()
			if !fits(off, countSize) {
				d.problem = "tiff: directory offset out of range"
				return d
			}
			let n = big ?? (u64(off), u16(off))
			let base = off + countSize
			if n < 0 || n > data.len() || !fits(base, n * entrySize + inline) {
				d.problem = "tiff: truncated directory"
				return d
			}

			for let i = 0; i < n; i++ {
				let p = base + i * entrySize
				let tag = u16(p)
				let typ = u16(p + 2)
				let count = big ?? (u64(p + 4), u32(p + 4))
				let size = tiffTypeSize(typ)
				continue when size == 0 || count < 0 || count > data.len()
				let pos = big ?? (p + 12, p + 8)
				pos = offset(pos) when count * size > inline
				continue unless fits(pos, count * size)
				let e = TIFFEntry{tag: tag, typ: typ, count: count, pos: pos}
				read(d, e)
			}
			d.next = offset(base + n * entrySize)
			return d
		}

		def first(e TIFFEntry, fallback int) int {
			let v = ints(e)
			return fallback when v.len() == 0
			return v[0]
		}

		def read(d TIFFDir, e TIFFEntry) {
			match e.tag {
				case 256:
					d.width = first(e, 0)
				case 257:
					d.height = first(e, 0)
				case 258:
					let v = ints(e)
					if v.len() > 0 {
						d.bits = v[0]
						for let (_, b) in v {
							d.mixedBits = true when b != v[0]
						}
					}
				case 259:
					d.compression = first(e, 1)
				case 262:
					d.photometric = first(e, -1)
				case 266:
					d.fillOrder = first(e, 1)
				case 269:
					d.documentName = text(e)
				case 270:
					d.description = text(e)
				case 273, 324:
					d.offsets = ints(e)
				case 274:
					d.orientation = first(e, 1)
				case 277:
					d.samples = first(e, 1)
				case 278:
					d.rowsPerStrip = first(e, 0)
				case 279, 325:
					d.counts = ints(e)
				case 282:
					d.xRes = number(e)
				case 283:
					d.yRes = number(e)
				case 284:
					d.planar = first(e, 1)
				case 285:
					d.pageName = text(e)
				case 296:
					d.resUnit = first(e, 2)
				case 305:
					d.software = text(e)
				case 306:
					d.dateTime = text(e)
				case 315:
					d.artist = text(e)
				case 317:
					d.predictor = first(e, 1)
				case 320:
					d.colorMap = ints(e)
				case 322:
					d.tileWidth = first(e, 0)
				case 323:
					d.tileHeight = first(e, 0)
				case 332:
					d.inkSet = first(e, 1)
				case 338:
					d.extraSamples = ints(e)
				case 339:
					d.sampleFormat = first(e, 1)
				case 347:
					d.jpegTables = data[e.pos:e.pos + e.count].clone()
				case 529:
					d.coeffs = numbers(e)
				case 530:
					let v = ints(e)
					if v.len() >= 2 {
						d.subH = v[0]
						d.subV = v[1]
					}
				case 532:
					d.refBW = numbers(e)
			}
		}
	}

	// The photometric interpretation a directory means, guessing from the
	// sample count when the tag is missing.
	def tiffPhotometric(d TIFFDir) int {
		return d.photometric when d.photometric >= 0
		return 2 when d.samples >= 3
		return 1
	}

	// Samples that carry colour for a photometric interpretation.
	def tiffColorSamples(photometric int) int {
		return 3 when photometric := 2 || 6 || 8
		return 4 when photometric == 5
		return 1
	}

	def tiffPageOf(d TIFFDir) TIFFPage {
		let photometric = tiffPhotometric(d)
		let comp = d.compression == 32946 ?? (8, d.compression)
		let unit = d.resUnit
		unit = 2 when unit < 1 || unit > 3
		return TIFFPage{
			width: d.width,
			height: d.height,
			bitsPerSample: d.bits,
			samplesPerPixel: d.samples,
			photometric: TIFFPhotometric(photometric),
			compression: TIFFCompression(comp),
			alpha: d.samples > tiffColorSamples(photometric),
			tiled: d.tileWidth > 0,
			orientation: d.orientation,
			xResolution: d.xRes,
			yResolution: d.yRes,
			resolutionUnit: TIFFResolutionUnit(unit),
			description: d.description,
			software: d.software,
			dateTime: d.dateTime,
			artist: d.artist,
			documentName: d.documentName,
			pageName: d.pageName,
		}
	}

	// Reverses the bit order of every byte, for FillOrder 2.
	def tiffReverseBits(src byte[]) byte[] {
		let out = src.clone()
		for let i = 0; i < out.len(); i++ {
			let v = int(out[i])
			v = (v & 0xF0) >> 4 | (v & 0x0F) << 4
			v = (v & 0xCC) >> 2 | (v & 0x33) << 2
			v = (v & 0xAA) >> 1 | (v & 0x55) << 1
			out[i] = byte(v)
		}
		return out
	}

	// Decodes a PackBits run-length stream up to `expected` bytes.
	def tiffUnpackBits(src byte[], expected int) !byte[] {
		let out byte[]
		out.len(expected)
		let o = 0
		let i = 0
		for o < expected && i < src.len() {
			let n = int(src[i])
			i++
			if n < 128 {
				fail "tiff: PackBits literal runs past the data" when i + n + 1 > src.len()
				for let k = 0; k <= n && o < expected; k++ {
					out[o] = src[i + k]
					o++
				}
				i += n + 1
			} else if n > 128 {
				fail "tiff: PackBits run past the data" when i >= src.len()
				let v = src[i]
				i++
				for let k = 0; k < 257 - n && o < expected; k++ {
					out[o] = v
					o++
				}
			}
		}
		fail "tiff: PackBits data ended early" when o < expected
		return out
	}

	// Encodes one row as PackBits.
	def tiffPackBits(row byte[], out byte[]) {
		let n = row.len()
		let i = 0
		for i < n {
			let run = 1
			for i + run < n && run < 128 && row[i + run] == row[i] {
				run++
			}
			if run >= 2 {
				out.push(byte(257 - run))
				out.push(row[i])
				i += run
				continue
			}
			let j = i
			for j < n && j - i < 128 {
				break when j + 2 < n && row[j] == row[j + 1] && row[j] == row[j + 2]
				j++
			}
			out.push(byte(j - i - 1))
			for let k = i; k < j; k++ {
				out.push(row[k])
			}
			i = j
		}
	}

	// Decodes a TIFF LZW stream up to `expected` bytes: codes most significant
	// bit first with the code width growing one code early, or the old
	// least-significant-bit-first variant, recognised by its first bytes.
	def tiffLzwDecode(src byte[], expected int) !byte[] {
		let out byte[]
		out.len(expected)
		let prefix int[]
		prefix.len(4096)
		let suffix byte[]
		suffix.len(4096)
		let head byte[]
		head.len(4096)
		let length int[]
		length.len(4096)
		for let i = 0; i < 256; i++ {
			prefix[i] = -1
			suffix[i] = byte(i)
			head[i] = byte(i)
			length[i] = 1
		}

		let lsb = src.len() >= 2 && src[0] == byte(0) && (int(src[1]) & 1) != 0
		let early = lsb ?? (0, 1)
		let bitBuf = 0
		let bitCnt = 0
		let pos = 0
		let width = 9
		let next = 258
		let prev = -1
		let o = 0
		for o < expected {
			for bitCnt < width && pos < src.len() {
				if lsb {
					bitBuf |= int(src[pos]) << bitCnt
				} else {
					bitBuf = bitBuf << 8 | int(src[pos])
				}
				pos++
				bitCnt += 8
			}
			break when bitCnt < width
			let mask = (1 << width) - 1
			let code = 0
			if lsb {
				code = bitBuf & mask
				bitBuf = bitBuf >> width
				bitCnt -= width
			} else {
				bitCnt -= width
				code = (bitBuf >> bitCnt) & mask
				bitBuf &= (1 << bitCnt) - 1
			}

			if code == 256 {
				width = 9
				next = 258
				prev = -1
				continue
			}
			break when code == 257
			if prev < 0 {
				fail "tiff: bad LZW code" when code > 255
				out[o] = byte(code)
				o++
				prev = code
				continue
			}
			fail "tiff: bad LZW code" when code > next || (code == next && next >= 4096)
			if next < 4096 {
				prefix[next] = prev
				suffix[next] = code == next ?? (head[prev], head[code])
				head[next] = head[prev]
				length[next] = length[prev] + 1
				next++
			}
			let end = o + length[code]
			let c = code
			for let k = end - 1; k >= o; k-- {
				out[k] = suffix[c] when k < expected
				c = prefix[c]
			}
			o = end
			prev = code
			width++ when next + early >= 1 << width && width < 12
		}
		fail "tiff: LZW data ended early" when o < expected
		return out
	}

	// Encodes TIFF LZW streams. The code table is indexed by prefix code and
	// byte, and entries count as present only when stamped with the current
	// generation, so clearing it is one increment.
	type TIFFLzwEncoder {
		table int[]
		gen   int

		// Encodes bytes as one LZW stream.
		def encode(src byte[]) byte[] {
			table.len(4096 * 256) when table.len() == 0
			let bw = new TIFFBitWriter()
			let width = 9
			bw.put(256, 9)
			if src.len() > 0 {
				gen++
				let stamp = gen << 12
				let w = int(src[0])
				let next = 258
				for let i = 1; i < src.len(); i++ {
					let c = int(src[i])
					let slot = w << 8 | c
					let v = table[slot]
					if v >> 12 == gen {
						w = v & 4095
						continue
					}
					bw.put(w, width)
					table[slot] = stamp | next
					next++
					if next == 4094 {
						bw.put(256, width)
						gen++
						stamp = gen << 12
						next = 258
						width = 9
					} else if next > (1 << width) - 1 {
						width++
					}
					w = c
				}
				bw.put(w, width)
				next++
				if next == 4094 {
					bw.put(256, width)
					width = 9
				} else if next > (1 << width) - 1 {
					width++
				}
			}
			bw.put(257, width)
			bw.flush()
			return bw.out
		}
	}

	// Packs codes most significant bit first.
	type TIFFBitWriter {
		out    byte[]
		bitBuf int
		bitCnt int

		def put(code int, bits int) {
			bitBuf = bitBuf << bits | code
			bitCnt += bits
			for bitCnt >= 8 {
				bitCnt -= 8
				out.push(byte((bitBuf >> bitCnt) & 0xFF))
			}
			bitBuf &= (1 << bitCnt) - 1
		}

		def flush() {
			out.push(byte((bitBuf << (8 - bitCnt)) & 0xFF)) when bitCnt > 0
			bitBuf = 0
			bitCnt = 0
		}
	}

	// Decodes the pixels of one directory into an image.
	type TIFFPageDecoder {
		f           TIFFFile
		d           TIFFDir
		w           int
		h           int
		spp         int
		photometric int
		planes      int
		// Samples of every pixel, reduced to eight bits (palette indices kept),
		// chunky.
		canvas      byte[]

		def new(f TIFFFile, d TIFFDir) {
			self.f = f
			self.d = d
			w = d.width
			h = d.height
			spp = d.samples
			photometric = tiffPhotometric(d)
			planes = d.planar == 2 ?? (spp, 1)
		}

		def run() !Image {
			fail "tiff: invalid dimensions" when w <= 0 || h <= 0 || w > 1 << 20 || h > 1 << 20
			fail "tiff: invalid samples per pixel" when spp < 1 || spp > 32
			fail "tiff: samples of mixed sizes are not supported" when d.mixedBits
			fail "tiff: signed integer samples are not supported" when d.sampleFormat == 2
			let bits = d.bits
			if d.sampleFormat == 3 {
				fail "tiff: {bits}-bit floating-point samples are not supported" unless bits := 32 || 64
			} else {
				fail "tiff: {bits}-bit samples are not supported" unless bits := 1 || 2 || 4 || 8 || 16 || 32
			}
			fail "tiff: {spp} samples are too few for the photometric interpretation" when spp < tiffColorSamples(photometric)
			match photometric {
				case 0, 1, 2, 6:
				case 3:
					fail "tiff: palette images deeper than 8 bits are not supported" when bits > 8
				case 5:
					fail "tiff: separated images other than CMYK are not supported" when d.inkSet != 1
				default:
					fail "tiff: photometric interpretation {photometric} is not supported"
			}
			match d.compression {
				case 1, 5, 7, 8, 32946, 32773:
				case 2, 3, 4:
					fail "tiff: CCITT fax compression is not supported"
				case 6:
					fail "tiff: old-style JPEG compression is not supported"
				default:
					fail "tiff: compression {d.compression} is not supported"
			}
			fail "tiff: predictor {d.predictor} is not supported" unless d.predictor := 1 || 2 || 3
			fail "tiff: horizontal prediction needs 8, 16 or 32-bit samples" when d.predictor == 2 && bits < 8
			fail "tiff: JPEG compression needs 8-bit samples" when d.compression == 7 && bits != 8

			canvas.len(w * h * spp)

			let tiled = d.tileWidth > 0 || d.tileHeight > 0
			let bw = w
			let bh = d.rowsPerStrip
			bh = h when bh <= 0 || bh > h
			if tiled {
				bw = d.tileWidth
				bh = d.tileHeight
				fail "tiff: invalid tile size" when bw <= 0 || bh <= 0 || bw > 1 << 16 || bh > 1 << 16
			}
			let across = (w + bw - 1) / bw
			let down = (h + bh - 1) / bh
			let perPlane = across * down
			fail "tiff: missing strip or tile offsets" when d.offsets.len() < perPlane * planes
			fail "tiff: missing strip or tile byte counts" when d.counts.len() < perPlane * planes && d.compression != 1

			for let p = 0; p < planes; p++ {
				for let by = 0; by < down; by++ {
					for let bx = 0; bx < across; bx++ {
						let idx = p * perPlane + by * across + bx
						let x0 = bx * bw
						let y0 = by * bh
						let rows = bh
						rows = h - y0 when !tiled && y0 + rows > h
						try block(idx, x0, y0, bw, rows, p)
					}
				}
			}
			return try toImage()
		}

		// Samples per pixel within one strip or tile.
		def blockSamples() int {
			return planes == 1 ?? (spp, 1)
		}

		def rowBytes(cols int) int {
			return (cols * blockSamples() * d.bits + 7) / 8
		}

		def block(idx int, x0 int, y0 int, cols int, rows int, plane int) !none {
			let off = d.offsets[idx]
			let count = idx < d.counts.len() ?? (d.counts[idx], rows * rowBytes(cols))
			fail "tiff: strip or tile offset out of range" when off < 0 || off > f.data.len()
			count = f.data.len() - off when count > f.data.len() - off || count < 0
			let src = f.data[off:off + count]
			src = tiffReverseBits(src) when d.fillOrder == 2

			return jpegBlock(src, x0, y0, cols, rows, plane) when d.compression == 7
			return subsampledBlock(src, x0, y0, cols, rows) when photometric == 6 && planes == 1 && (d.subH != 1 || d.subV != 1)

			let stride = rowBytes(cols)
			let expected = stride * rows
			let buf byte[]
			match d.compression {
				case 1:
					fail "tiff: strip data ended early" when src.len() < expected
					buf = src
				case 5:
					buf = try tiffLzwDecode(src, expected)
				case 8, 32946:
					buf = try zlib.decompress(src, expected)
					fail "tiff: strip data ended early" when buf.len() < expected
				case 32773:
					buf = try tiffUnpackBits(src, expected)
			}
			if d.predictor == 2 {
				buf = buf.clone() when d.compression == 1
				undoHorizontal(buf, stride, rows)
			} else if d.predictor == 3 {
				buf = buf.clone() when d.compression == 1
				try undoFloat(buf, stride, rows, cols)
			}
			unpack(buf, stride, x0, y0, cols, rows, plane)
		}

		def undoHorizontal(buf byte[], stride int, rows int) {
			let n = blockSamples()
			let bytes = d.bits / 8
			for let r = 0; r < rows; r++ {
				let s = r * stride
				if bytes == 1 {
					for let i = s + n; i < s + stride; i++ {
						buf[i] = byte((int(buf[i]) + int(buf[i - n])) & 0xFF)
					}
				} else if bytes == 2 {
					let step = n * 2
					for let i = s + step; i + 1 < s + stride; i += 2 {
						let v = f.u16In(buf, i) + f.u16In(buf, i - step)
						f.put16(buf, i, v & 0xFFFF)
					}
				} else {
					let step = n * 4
					for let i = s + step; i + 3 < s + stride; i += 4 {
						let v = f.u32In(buf, i) + f.u32In(buf, i - step)
						f.put32(buf, i, v & 0xFFFFFFFF)
					}
				}
			}
		}

		// Floating-point prediction: bytes of each row are differenced, and
		// grouped most significant byte first across the row.
		def undoFloat(buf byte[], stride int, rows int, cols int) !none {
			let bytes = d.bits / 8
			fail "tiff: floating-point prediction needs floating-point samples" when d.sampleFormat != 3
			let n = blockSamples()
			let count = cols * n
			let tmp byte[]
			tmp.len(count * bytes)
			for let r = 0; r < rows; r++ {
				let s = r * stride
				for let i = s + n; i < s + count * bytes; i++ {
					buf[i] = byte((int(buf[i]) + int(buf[i - n])) & 0xFF)
				}
				for let k = 0; k < count; k++ {
					for let b = 0; b < bytes; b++ {
						// Byte b of the sample, most significant first.
						let v = buf[s + b * count + k]
						let at = f.little ?? (k * bytes + bytes - 1 - b, k * bytes + b)
						tmp[at] = v
					}
				}
				tmp.copy(buf[s:s + count * bytes])
			}
		}

		// Sample `k` of a row starting at `s`, reduced to eight bits; palette
		// indices and bilevel values are kept or scaled per `raw`.
		def sample(buf byte[], s int, k int, raw bool) int {
			let bits = d.bits
			if bits < 8 {
				let bitPos = k * bits
				let v = (int(buf[s + bitPos / 8]) >> (8 - bits - bitPos % 8)) & ((1 << bits) - 1)
				return v when raw
				return v * 255 / ((1 << bits) - 1)
			}
			return int(buf[s + k]) when bits == 8
			return (f.u16In(buf, s + k * 2) + 128) / 257 when bits == 16
			if d.sampleFormat == 3 {
				let v = 0.0
				if bits == 32 {
					v = float(__bitcast_f32_from_u32(uint32(f.u32In(buf, s + k * 4))))
				} else {
					let p = s + k * 8
					let u = f.little ?? (f.u32In(buf, p) | f.u32In(buf, p + 4) << 32, f.u32In(buf, p) << 32 | f.u32In(buf, p + 4))
					v = float(__bitcast_f64_from_u64(uint64(u)))
				}
				return 0 unless v > 0.0
				return 255 when v >= 1.0
				return int(v * 255.0 + 0.5)
			}
			return (f.u32In(buf, s + k * 4) + 8421504) / 16843009
		}

		def unpack(buf byte[], stride int, x0 int, y0 int, cols int, rows int, plane int) {
			let xEnd = cols
			xEnd = w - x0 when x0 + xEnd > w
			let n = blockSamples()
			let raw = photometric == 3
			for let r = 0; r < rows; r++ {
				let y = y0 + r
				break when y >= h
				let s = r * stride
				let dst = (y * w + x0) * spp
				if d.bits == 8 && planes == 1 {
					buf[s:s + xEnd * spp].copy(canvas[dst:dst + xEnd * spp])
				} else if planes == 1 {
					for let k = 0; k < xEnd * n; k++ {
						canvas[dst + k] = byte(sample(buf, s, k, raw))
					}
				} else {
					let o = dst + plane
					for let x = 0; x < xEnd; x++ {
						canvas[o] = byte(sample(buf, s, x, raw))
						o += spp
					}
				}
			}
		}

		// YCbCr with subsampled chroma: each data unit holds subH x subV luma
		// samples, then Cb and Cr.
		def subsampledBlock(src byte[], x0 int, y0 int, cols int, rows int) !none {
			let sh = d.subH
			let sv = d.subV
			fail "tiff: invalid YCbCr subsampling" unless (sh := 1 || 2 || 4) && (sv := 1 || 2 || 4)
			fail "tiff: subsampled YCbCr needs 8-bit samples" when d.bits != 8
			fail "tiff: subsampled YCbCr needs 3 samples" when spp != 3
			let unitsAcross = (cols + sh - 1) / sh
			let unitsDown = (rows + sv - 1) / sv
			let unit = sh * sv + 2
			let expected = unitsAcross * unitsDown * unit
			let buf byte[]
			match d.compression {
				case 1:
					fail "tiff: strip data ended early" when src.len() < expected
					buf = src
				case 5:
					buf = try tiffLzwDecode(src, expected)
				case 8, 32946:
					buf = try zlib.decompress(src, expected)
					fail "tiff: strip data ended early" when buf.len() < expected
				case 32773:
					buf = try tiffUnpackBits(src, expected)
			}
			let p = 0
			for let uy = 0; uy < unitsDown; uy++ {
				for let ux = 0; ux < unitsAcross; ux++ {
					let cb = buf[p + sh * sv]
					let cr = buf[p + sh * sv + 1]
					for let j = 0; j < sv; j++ {
						let y = y0 + uy * sv + j
						for let i = 0; i < sh; i++ {
							let x = x0 + ux * sh + i
							if y < h && y - y0 < rows && x < w && x - x0 < cols {
								let o = (y * w + x) * 3
								canvas[o] = buf[p + j * sh + i]
								canvas[o + 1] = cb
								canvas[o + 2] = cr
							}
						}
					}
					p += unit
				}
			}
		}

		// A JPEG strip or tile, completed with the shared tables when the
		// directory has them.
		def jpegBlock(src byte[], x0 int, y0 int, cols int, rows int, plane int) !none {
			let t = d.jpegTables
			let stream byte[]
			if t.len() > 4 && src.len() > 2 {
				stream.len(t.len() - 2 + src.len() - 2)
				t[0:t.len() - 2].copy(stream)
				src[2:].copy(stream[t.len() - 2:])
			} else {
				stream = src
			}
			let img = try new JPEG().decode(stream)
			let jw = int(img.size().width)
			let jh = int(img.size().height)
			let px = img.raw()
			let n = planes == 1 ?? (spp, 1)
			fail "tiff: JPEG with {n} samples per pixel is not supported" when n != 1 && n != 3
			for let r = 0; r < rows && r < jh; r++ {
				let y = y0 + r
				break when y >= h
				let rowOff = img.pixelOffset(0, r)
				for let x = 0; x < cols && x < jw && x0 + x < w; x++ {
					let o = (y * w + x0 + x) * spp
					let i = rowOff + x * 4
					if planes == 1 {
						for let k = 0; k < n; k++ {
							canvas[o + k] = px[i + k]
						}
					} else {
						canvas[o + plane] = px[i]
					}
				}
			}
		}

		// Converts the samples to RGBA and applies the orientation.
		def toImage() !Image {
			let orient = d.orientation
			orient = 1 when orient < 1 || orient > 8
			let swap = orient >= 5
			let img = new Image(swap ?? (h, w), swap ?? (w, h))
			let px = img.raw()
			let stride = img.stride()

			let kind = photometric
			// The JPEG decoder has already turned YCbCr into RGB.
			kind = 2 when kind == 6 && d.compression == 7
			let base = tiffColorSamples(kind)
			let alphaAt = spp > base ?? (base, -1)
			let assoc = alphaAt >= 0 && d.extraSamples.len() > 0 && d.extraSamples[0] == 1

			let pr byte[]
			let pg byte[]
			let pb byte[]
			let colors = 0
			if kind == 3 {
				colors = 1 << d.bits
				fail "tiff: color map too short" when d.colorMap.len() < 3 * colors
				let wide = false
				for let i = 0; i < 3 * colors; i++ {
					wide = true when d.colorMap[i] > 255
				}
				pr.len(colors)
				pg.len(colors)
				pb.len(colors)
				for let i = 0; i < colors; i++ {
					pr[i] = byte(wide ?? ((d.colorMap[i] + 128) / 257, d.colorMap[i]))
					pg[i] = byte(wide ?? ((d.colorMap[colors + i] + 128) / 257, d.colorMap[colors + i]))
					pb[i] = byte(wide ?? ((d.colorMap[2 * colors + i] + 128) / 257, d.colorMap[2 * colors + i]))
				}
			}

			// YCbCr to RGB, with the reference black and white levels.
			let lr = 0.299
			let lg = 0.587
			let lb = 0.114
			if d.coeffs.len() >= 3 {
				lr = d.coeffs[0]
				lg = d.coeffs[1]
				lb = d.coeffs[2]
			}
			let ref = float[0.0, 255.0, 128.0, 255.0, 128.0, 255.0]
			ref = d.refBW when d.refBW.len() >= 6

			for let y = 0; y < h; y++ {
				let o = 0
				let step = 4
				match orient {
					case 1:
						o = y * stride
					case 2:
						o = y * stride + (w - 1) * 4
						step = -4
					case 3:
						o = (h - 1 - y) * stride + (w - 1) * 4
						step = -4
					case 4:
						o = (h - 1 - y) * stride
					case 5:
						o = y * 4
						step = stride
					case 6:
						o = (h - 1 - y) * 4
						step = stride
					case 7:
						o = (w - 1) * stride + (h - 1 - y) * 4
						step = -stride
					case 8:
						o = (w - 1) * stride + y * 4
						step = -stride
				}
				let s = y * w * spp
				for let x = 0; x < w; x++ {
					let r = 0
					let g = 0
					let b = 0
					let a = alphaAt >= 0 ?? (int(canvas[s + alphaAt]), 255)
					match kind {
						case 0:
							r = 255 - int(canvas[s])
							g = r
							b = r
						case 1:
							r = int(canvas[s])
							g = r
							b = r
						case 2:
							r = int(canvas[s])
							g = int(canvas[s + 1])
							b = int(canvas[s + 2])
						case 3:
							let i = int(canvas[s])
							fail "tiff: palette index out of range" when i >= colors
							r = int(pr[i])
							g = int(pg[i])
							b = int(pb[i])
						case 5:
							let k = 255 - int(canvas[s + 3])
							r = ((255 - int(canvas[s])) * k + 127) / 255
							g = ((255 - int(canvas[s + 1])) * k + 127) / 255
							b = ((255 - int(canvas[s + 2])) * k + 127) / 255
						case 6:
							let yv = (float(canvas[s]) - ref[0]) * 255.0 / tiffNonZero(ref[1] - ref[0])
							let cb = (float(canvas[s + 1]) - ref[2]) * 127.0 / tiffNonZero(ref[3] - ref[2])
							let cr = (float(canvas[s + 2]) - ref[4]) * 127.0 / tiffNonZero(ref[5] - ref[4])
							let rf = yv + (2.0 - 2.0 * lr) * cr
							let bf = yv + (2.0 - 2.0 * lb) * cb
							let gf = (yv - lb * bf - lr * rf) / lg
							r = tiffClamp(rf)
							g = tiffClamp(gf)
							b = tiffClamp(bf)
					}
					if assoc && a < 255 {
						if a == 0 {
							r = 0
							g = 0
							b = 0
						} else {
							r = (r * 255 + a / 2) / a
							g = (g * 255 + a / 2) / a
							b = (b * 255 + a / 2) / a
							r = 255 when r > 255
							g = 255 when g > 255
							b = 255 when b > 255
						}
					}
					px[o] = byte(r)
					px[o + 1] = byte(g)
					px[o + 2] = byte(b)
					px[o + 3] = byte(a)
					o += step
					s += spp
				}
			}
			return img
		}
	}

	def tiffNonZero(v float) float {
		return 1.0 when v == 0.0
		return v
	}

	def tiffClamp(v float) int {
		return 0 unless v > 0.0
		return 255 when v >= 255.0
		return int(v + 0.5)
	}

	// A growing little-endian output file.
	type TIFFWriter {
		data byte[]

		def pos() int {
			return data.len()
		}

		def u16(v int) {
			data.push(byte(v & 0xFF))
			data.push(byte((v >> 8) & 0xFF))
		}

		def u32(v int) {
			data.push(byte(v & 0xFF))
			data.push(byte((v >> 8) & 0xFF))
			data.push(byte((v >> 16) & 0xFF))
			data.push(byte((v >> 24) & 0xFF))
		}

		def write(b byte[]) {
			let at = data.len()
			data.len(at + b.len())
			b.copy(data[at:])
		}

		// Pads to an even offset, as values must start on a word boundary.
		def align() {
			data.push(byte(0)) when data.len() % 2 == 1
		}

		def patch32(at int, v int) {
			data[at] = byte(v & 0xFF)
			data[at + 1] = byte((v >> 8) & 0xFF)
			data[at + 2] = byte((v >> 16) & 0xFF)
			data[at + 3] = byte((v >> 24) & 0xFF)
		}
	}

	// One directory entry to write: its value bytes, placed inline when they
	// fit in four.
	struct TIFFOutEntry {
		tag   int
		typ   int
		count int
		value byte[]
	}

	def tiffShorts(tag int, v int[]) TIFFOutEntry {
		let b byte[]
		for let (_, x) in v {
			b.push(byte(x & 0xFF))
			b.push(byte((x >> 8) & 0xFF))
		}
		return TIFFOutEntry{tag: tag, typ: 3, count: v.len(), value: b}
	}

	def tiffLongs(tag int, v int[]) TIFFOutEntry {
		let b byte[]
		for let (_, x) in v {
			b.push(byte(x & 0xFF))
			b.push(byte((x >> 8) & 0xFF))
			b.push(byte((x >> 16) & 0xFF))
			b.push(byte((x >> 24) & 0xFF))
		}
		return TIFFOutEntry{tag: tag, typ: 4, count: v.len(), value: b}
	}

	def tiffRational(tag int, v float) TIFFOutEntry {
		let den = 1
		for den < 10000 && float(int(v * float(den))) != v * float(den) {
			den *= 10
		}
		let e = tiffLongs(tag, int[int(v * float(den) + 0.5), den])
		return TIFFOutEntry{tag: tag, typ: 5, count: 1, value: e.value}
	}

	def tiffAscii(tag int, s string) TIFFOutEntry {
		let b = s.bytes().clone()
		b.push(byte(0))
		return TIFFOutEntry{tag: tag, typ: 2, count: b.len(), value: b}
	}

	// Reports whether any pixel of the image is not opaque.
	def tiffHasAlpha(img Image) bool {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let px = img.raw()
		for let y = 0; y < h; y++ {
			let o = img.pixelOffset(0, y) + 3
			for let x = 0; x < w; x++ {
				return true when px[o] != byte(255)
				o += 4
			}
		}
		return false
	}
}
