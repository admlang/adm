partial module std.formats.image {
	use (
		std.testing
		std.bytes
		std.gfx.color
	)

	// Builds a one-directory TIFF: tags with their values, then strips or
	// tiles whose offsets and byte counts are filled in.
	internal type TIFFTestFile {
		ids      int[]
		types    int[]
		values   int[][]
		blocks   byte[][]
		motorola bool
		tiled    bool
		big      bool

		def tag(id int, typ int, v int[]) TIFFTestFile {
			ids.push(id)
			types.push(typ)
			values.push(v)
			return self
		}

		def text(id int, s string) TIFFTestFile {
			let v int[]
			for let (_, b) in s.bytes() {
				v.push(int(b))
			}
			v.push(0)
			return tag(id, 2, v)
		}

		def block(b byte[]) TIFFTestFile {
			blocks.push(b)
			return self
		}

		internal def put(out byte[], v int, n int) {
			for let i = 0; i < n; i++ {
				let shift = motorola ?? ((n - 1 - i) * 8, i * 8)
				out.push(byte((v >> shift) & 0xFF))
			}
		}

		internal def patch(out byte[], at int, v int, n int) {
			for let i = 0; i < n; i++ {
				let shift = motorola ?? ((n - 1 - i) * 8, i * 8)
				out[at + i] = byte((v >> shift) & 0xFF)
			}
		}

		def bytes() byte[] {
			let out byte[]
			let order = motorola ?? (0x4D, 0x49)
			out.push(byte(order))
			out.push(byte(order))
			put(out, big ?? (43, 42), 2)
			if big {
				put(out, 8, 2)
				put(out, 0, 2)
			}
			let offSize = big ?? (8, 4)
			let first = out.len()
			put(out, 0, offSize)

			let offsets int[]
			let counts int[]
			for let (_, b) in blocks {
				offsets.push(out.len())
				counts.push(b.len())
				for let (_, x) in b {
					out.push(x)
				}
			}
			tag(tiled ?? (324, 273), 4, offsets)
			tag(tiled ?? (325, 279), 4, counts)

			let order2 int[]
			for let i = 0; i < ids.len(); i++ {
				order2.push(i)
			}
			for let i = 1; i < order2.len(); i++ {
				for let j = i; j > 0 && ids[order2[j]] < ids[order2[j - 1]]; j-- {
					let t = order2[j]
					order2[j] = order2[j - 1]
					order2[j - 1] = t
				}
			}

			out.push(byte(0)) when out.len() % 2 == 1
			let ifd = out.len()
			patch(out, first, ifd, offSize)
			let countSize = big ?? (8, 2)
			let entrySize = big ?? (20, 12)
			let extra = ifd + countSize + ids.len() * entrySize + offSize
			let tail byte[]
			put(out, ids.len(), countSize)
			for let (_, k) in order2 {
				let typ = types[k]
				let size = typ == 3 ?? (2, typ == 4 ?? (4, 1))
				let v byte[]
				for let (_, x) in values[k] {
					put(v, x, size)
				}
				put(out, ids[k], 2)
				put(out, typ, 2)
				put(out, values[k].len(), big ?? (8, 4))
				if v.len() <= offSize {
					for let (_, b) in v {
						out.push(b)
					}
					for let i = v.len(); i < offSize; i++ {
						out.push(byte(0))
					}
				} else {
					put(out, extra + tail.len(), offSize)
					for let (_, b) in v {
						tail.push(b)
					}
					tail.push(byte(0)) when tail.len() % 2 == 1
				}
			}
			put(out, 0, offSize)
			for let (_, b) in tail {
				out.push(b)
			}
			return out
		}
	}

	check "TIFF" {
		internal def rgbFile(w int, h int, pixels byte[]) TIFFTestFile {
			return new TIFFTestFile()
				.tag(256, 3, int[w])
				.tag(257, 3, int[h])
				.tag(258, 3, int[8, 8, 8])
				.tag(262, 3, int[2])
				.tag(277, 3, int[3])
				.block(pixels)
		}

		internal def assertPixel(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			assert int(img.raw()[o]) == r
			assert int(img.raw()[o + 1]) == g
			assert int(img.raw()[o + 2]) == b
			assert int(img.raw()[o + 3]) == a
		}

		internal def near(v byte, want int) bool {
			let d = int(v) - want
			return d >= -4 && d <= 4
		}

		internal def decoded(data byte[]) Image {
			return new TIFF().decode(data) onerror recover new Image(1, 1)
		}

		// The message decoding fails with, or "" when it succeeds.
		internal def failure(data byte[]) string {
			let msg = ""
			new TIFF().decode(data) onerror (e error) {
				msg = e.message
				recover new Image(1, 1)
			}
			return msg
		}

		// A 5x3 picture with every pixel different and some translucent.
		internal def sample(alpha bool) Image {
			let img = new Image(5, 3)
			let px = img.raw()
			for let y = 0; y < 3; y++ {
				for let x = 0; x < 5; x++ {
					let o = img.pixelOffset(x, y)
					px[o] = byte(x * 50)
					px[o + 1] = byte(y * 100)
					px[o + 2] = byte(255 - x * 20 - y)
					px[o + 3] = byte(alpha ?? (x * 60 + y, 255))
				}
			}
			return img
		}

		internal def same(a Image, b Image) bool {
			return false when a.size().width != b.size().width || a.size().height != b.size().height
			let pa = a.raw()
			let pb = b.raw()
			for let y = 0; y < int(a.size().height); y++ {
				for let x = 0; x < int(a.size().width) * 4; x++ {
					return false when pa[a.pixelOffset(0, y) + x] != pb[b.pixelOffset(0, y) + x]
				}
			}
			return true
		}

		// 8x8 YCbCr JPEG-compressed TIFF with shared tables.
		internal def jpegTIFF() byte[] {
			return byte[
				73, 73, 42, 0, 120, 0, 0, 0, 255, 216, 255, 192, 0, 17, 8, 0,
