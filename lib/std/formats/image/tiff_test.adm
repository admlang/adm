				168, 0, 0, 0, 0, 2, 205, 204, 76, 0, 0, 0, 0, 1, 205, 204,
				76, 0, 0, 0, 128, 0, 205, 204, 76, 0, 0, 0, 0, 2, 143, 194,
				245, 0, 0, 0, 0, 16, 55, 26, 160, 0, 0, 0, 0, 2, 43, 135,
				10, 0, 0, 0, 32, 0
			]
		}

		@test()
		def decodes_8bit_rgb_little_and_big_endian() {
			let px = byte[255, 0, 0, 0, 255, 0, 0, 0, 255, 10, 20, 30]
			for let (_, mm) in [false, true] {
				let f = rgbFile(2, 2, px)
				f.motorola = mm
				let img = decoded(f.bytes())
				assert int(img.size().width) == 2
				assertPixel(img, 0, 0, 255, 0, 0, 255)
				assertPixel(img, 1, 0, 0, 255, 0, 255)
				assertPixel(img, 0, 1, 0, 0, 255, 255)
				assertPixel(img, 1, 1, 10, 20, 30, 255)
			}
		}

		@test()
		def decodes_gray_both_ways_round() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[2])
				.tag(257, 3, int[1])
				.tag(258, 3, int[8])
				.tag(262, 3, int[1])
				.block(byte[0, 200])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 0, 0, 0, 255)
			assertPixel(img, 1, 0, 200, 200, 200, 255)
			let inv = new TIFFTestFile()
				.tag(256, 3, int[2])
				.tag(257, 3, int[1])
				.tag(258, 3, int[8])
				.tag(262, 3, int[0])
				.block(byte[0, 200])
			let img2 = decoded(inv.bytes())
			assertPixel(img2, 0, 0, 255, 255, 255, 255)
			assertPixel(img2, 1, 0, 55, 55, 55, 255)
		}

		// Ten pixels a row, so each row is padded to two bytes.
		@test()
		def decodes_bilevel_rows() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[10])
				.tag(257, 3, int[2])
				.tag(262, 3, int[0])
				.block(byte[0b10100000, 0b01000000, 0b00000000, 0b11000000])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 0, 0, 0, 255)
			assertPixel(img, 1, 0, 255, 255, 255, 255)
			assertPixel(img, 2, 0, 0, 0, 0, 255)
			assertPixel(img, 9, 0, 0, 0, 0, 255)
			assertPixel(img, 8, 0, 255, 255, 255, 255)
			assertPixel(img, 0, 1, 255, 255, 255, 255)
			assertPixel(img, 8, 1, 0, 0, 0, 255)
		}

		@test()
		def decodes_a_4bit_palette() {
			let map int[]
			for let c = 0; c < 3; c++ {
				for let i = 0; i < 16; i++ {
					map.push(c == 0 ?? (i * 4369, c == 1 ?? (65535 - i * 4369, 32896)))
				}
			}
			let f = new TIFFTestFile()
				.tag(256, 3, int[3])
				.tag(257, 3, int[1])
				.tag(258, 3, int[4])
				.tag(262, 3, int[3])
				.tag(320, 3, map)
				.block(byte[0x0F, 0x50])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 0, 255, 128, 255)
			assertPixel(img, 1, 0, 255, 0, 128, 255)
			assertPixel(img, 2, 0, 85, 170, 128, 255)
			let info = new TIFF().info(f.bytes()) onerror recover ImageInfo{}
			assert info.colorFormat == color.ColorFormat.Palette
			assert info.palette.len() == 16
		}

		@test()
		def decodes_16bit_samples() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[1])
				.tag(257, 3, int[1])
				.tag(258, 3, int[16, 16, 16])
				.tag(262, 3, int[2])
				.tag(277, 3, int[3])
				.block(byte[0xFF, 0xFF, 0x80, 0x00, 0x00, 0x7F])
			f.motorola = true
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 255, 128, 0, 255)
		}

		@test()
		def decodes_32bit_floats() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[4])
				.tag(257, 3, int[1])
				.tag(258, 3, int[32])
				.tag(262, 3, int[1])
				.tag(339, 3, int[3])
				.block(byte[0, 0, 0, 0, 0, 0, 0, 0x3F, 0, 0, 0x80, 0x3F, 0, 0, 0, 0x40])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 0, 0, 0, 255)
			assertPixel(img, 1, 0, 128, 128, 128, 255)
			assertPixel(img, 2, 0, 255, 255, 255, 255)
			assertPixel(img, 3, 0, 255, 255, 255, 255)
		}

		@test()
		def decodes_planar_samples() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[2])
				.tag(257, 3, int[1])
				.tag(258, 3, int[8, 8, 8])
				.tag(262, 3, int[2])
				.tag(277, 3, int[3])
				.tag(284, 3, int[2])
				.block(byte[1, 2])
				.block(byte[3, 4])
				.block(byte[5, 6])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 1, 3, 5, 255)
			assertPixel(img, 1, 0, 2, 4, 6, 255)
		}

		// A 3x3 image in 2x2 tiles; the tiles past the edge are padded.
		@test()
		def decodes_tiles() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[3])
				.tag(257, 3, int[3])
				.tag(258, 3, int[8])
				.tag(262, 3, int[1])
				.tag(322, 3, int[2])
				.tag(323, 3, int[2])
				.block(byte[10, 11, 20, 21])
				.block(byte[12, 0, 22, 0])
				.block(byte[30, 31, 0, 0])
				.block(byte[32, 0, 0, 0])
			f.tiled = true
			let img = decoded(f.bytes())
			assert int(img.size().width) == 3
			assertPixel(img, 0, 0, 10, 10, 10, 255)
			assertPixel(img, 2, 0, 12, 12, 12, 255)
			assertPixel(img, 1, 1, 21, 21, 21, 255)
			assertPixel(img, 0, 2, 30, 30, 30, 255)
			assertPixel(img, 2, 2, 32, 32, 32, 255)
		}

		@test()
		def decodes_strips_with_a_short_last_one() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[1])
				.tag(257, 3, int[3])
				.tag(258, 3, int[8])
				.tag(262, 3, int[1])
				.tag(278, 3, int[2])
				.block(byte[1, 2])
				.block(byte[3])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 1, 1, 1, 255)
			assertPixel(img, 0, 2, 3, 3, 3, 255)
		}

		@test()
		def decodes_packbits() {
			// A literal run of two, then 0x07 repeated three times.
			let f = new TIFFTestFile()
				.tag(256, 3, int[5])
				.tag(257, 3, int[1])
				.tag(258, 3, int[8])
				.tag(259, 3, int[32773])
				.tag(262, 3, int[1])
				.block(byte[1, 5, 6, 0xFE, 7])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 5, 5, 5, 255)
			assertPixel(img, 1, 0, 6, 6, 6, 255)
			assertPixel(img, 4, 0, 7, 7, 7, 255)
		}

		// A red-to-blue gradient, LZW with horizontal prediction, as another
		// encoder wrote it.
		@test()
		def decodes_lzw_with_prediction() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[4])
				.tag(257, 3, int[4])
				.tag(258, 3, int[8, 8, 8])
				.tag(259, 3, int[5])
				.tag(262, 3, int[2])
				.tag(277, 3, int[3])
				.tag(317, 3, int[2])
				.block(byte[128, 63, 192, 16, 56, 36, 20, 0, 170, 0, 21, 96, 208, 88, 84, 34, 23, 5, 129, 67, 192, 16, 16])
			let img = decoded(f.bytes())
			assertPixel(img, 3, 0, 255, 0, 0, 255)
			assertPixel(img, 0, 1, 170, 0, 85, 255)
			assertPixel(img, 2, 2, 85, 0, 170, 255)
			assertPixel(img, 3, 3, 0, 0, 255, 255)
		}

		@test()
		def decodes_jpeg_with_shared_tables() {
			let img = decoded(jpegTIFF())
			assert int(img.size().width) == 8
			let px = img.raw()
			assert near(px[0], 132) && near(px[1], 15) && near(px[2], 5)
			let o = img.pixelOffset(7, 7)
			assert near(px[o], 60) && near(px[o + 1], 45) && near(px[o + 2], 38)
		}

		@test()
		def decodes_cmyk() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[2])
				.tag(257, 3, int[1])
				.tag(258, 3, int[8, 8, 8, 8])
				.tag(262, 3, int[5])
				.tag(277, 3, int[4])
				.block(byte[255, 0, 0, 0, 0, 0, 0, 255])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 0, 255, 255, 255)
			assertPixel(img, 1, 0, 0, 0, 0, 255)
		}

		// Chroma shared by each 2x2 block of luma.
		@test()
		def decodes_subsampled_ycbcr() {
			let f = new TIFFTestFile()
				.tag(256, 3, int[2])
				.tag(257, 3, int[2])
				.tag(258, 3, int[8, 8, 8])
				.tag(262, 3, int[6])
				.tag(277, 3, int[3])
				.tag(530, 3, int[2, 2])
				.block(byte[10, 20, 30, 40, 128, 128])
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 10, 10, 10, 255)
			assertPixel(img, 1, 0, 20, 20, 20, 255)
			assertPixel(img, 0, 1, 30, 30, 30, 255)
			assertPixel(img, 1, 1, 40, 40, 40, 255)
		}

		@test()
		def straightens_associated_alpha() {
			let px = byte[50, 25, 0, 128, 0, 0, 0, 0]
			for let (_, kind) in [1, 2] {
				let f = new TIFFTestFile()
					.tag(256, 3, int[2])
					.tag(257, 3, int[1])
					.tag(258, 3, int[8, 8, 8, 8])
					.tag(262, 3, int[2])
					.tag(277, 3, int[4])
					.tag(338, 3, int[kind])
					.block(px)
				let img = decoded(f.bytes())
				if kind == 1 {
					assertPixel(img, 0, 0, 100, 50, 0, 128)
				} else {
					assertPixel(img, 0, 0, 50, 25, 0, 128)
				}
				assertPixel(img, 1, 0, 0, 0, 0, 0)
			}
		}

		// Orientation 6: the stored rows are the displayed columns, right to
		// left.
		@test()
		def applies_the_orientation() {
			let f = rgbFile(2, 1, byte[255, 0, 0, 0, 0, 255])
				.tag(274, 3, int[6])
			let img = decoded(f.bytes())
			assert int(img.size().width) == 1
			assert int(img.size().height) == 2
			assertPixel(img, 0, 0, 255, 0, 0, 255)
			assertPixel(img, 0, 1, 0, 0, 255, 255)
			let info = new TIFF().info(f.bytes()) onerror recover ImageInfo{}
			assert int(info.size.width) == 1
			assert int(info.size.height) == 2
		}

		@test()
		def reads_bigtiff() {
			let f = rgbFile(1, 1, byte[1, 2, 3])
			f.big = true
			let img = decoded(f.bytes())
			assertPixel(img, 0, 0, 1, 2, 3, 255)
		}

		@test()
		def reads_the_descriptive_tags() {
			let f = rgbFile(1, 1, byte[1, 2, 3])
				.text(270, "a test page")
				.text(305, "adm")
				.text(306, "2026:09:26 10:00:00")
			let t = new TIFF()
			t.decode(f.bytes()) onerror recover new Image(1, 1)
			assert t.pages.len() == 1
			assert t.pages[0].description == "a test page"
			assert t.pages[0].software == "adm"
			assert t.pages[0].dateTime == "2026:09:26 10:00:00"
			assert t.pages[0].photometric == TIFFPhotometric.RGB
			assert t.pages[0].compression == TIFFCompression.None
			assert !t.pages[0].alpha

			// Encoding the decoded state keeps the tags.
			let again = new TIFF()
			let data = t.encode() onerror recover byte[]
			again.decode(data) onerror recover new Image(1, 1)
			assert again.pages.len() == 1
			assert again.pages[0].description == "a test page"
			assert again.pages[0].software == "adm"
		}

		@test()
		def round_trips_every_compression() {
			for let (_, alpha) in [false, true] {
				let img = sample(alpha)
				for let (_, c) in [TIFFCompression.None, TIFFCompression.LZW, TIFFCompression.Deflate, TIFFCompression.PackBits] {
					let t = new TIFF()
					t.compression = c
					let data = t.encode(img) onerror recover byte[]
					assert data.len() > 0
					let back = new TIFF()
					let got = back.decode(data) onerror recover new Image(1, 1)
					assert same(img, got)
					assert back.pages[0].compression == c
					assert back.pages[0].alpha == alpha
				}
			}
		}

		// Enough noise to fill the LZW table and clear it several times.
		@test()
		def round_trips_lzw_through_table_resets() {
			let img = new Image(300, 200)
			let px = img.raw()
			let seed = 12345
			for let i = 0; i < px.len(); i++ {
				seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
				px[i] = byte((seed >> 16) & 0xFF)
				px[i] = byte(255) when i % 4 == 3
			}
			let data = new TIFF().encode(img) onerror recover byte[]
			assert same(img, decoded(data))
		}

		@test()
		def writes_and_reads_pages() {
			let t = new TIFF()
			t.add(sample(false))
			t.add(sample(true))
			let data = t.encode() onerror recover byte[]
			let back = new TIFF()
			let first = back.decode(data) onerror recover new Image(1, 1)
			assert back.pages.len() == 2
			assert same(first, sample(false))
			let second = back.page(1) onerror recover new Image(1, 1)
			assert same(second, sample(true))
			assert back.pages[1].alpha
			let missing = back.page(2) onerror recover new Image(9, 9)
			assert int(missing.size().width) == 9
		}

		@test()
		def matches_the_signature() {
			let t = new TIFF()
			assert t.matchSignature(new bytes.Buffer(byte[0x49, 0x49, 42, 0, 8, 0, 0, 0]))
			assert t.matchSignature(new bytes.Buffer(byte[0x4D, 0x4D, 0, 42, 0, 0, 0, 8]))
			assert t.matchSignature(new bytes.Buffer(byte[0x49, 0x49, 43, 0, 8, 0, 0, 0]))
			assert !t.matchSignature(new bytes.Buffer(byte[137, 80, 78, 71, 13, 10, 26, 10]))
			assert !t.matchSignature(new bytes.Buffer(byte[0x49, 0x49]))
		}

		@test()
		def rejects_what_it_cannot_decode() {
			assert failure(byte[1, 2, 3, 4, 5, 6, 7, 8, 9]) != ""
			assert failure(byte[0x49, 0x49, 42, 0]) != ""
			// The directory points past the end.
			assert failure(byte[0x49, 0x49, 42, 0, 200, 0, 0, 0]) != ""

			let good = new TIFF().encode(sample(false)) onerror recover byte[]
			assert failure(good[0:good.len() / 2]) != ""

			let badLzw = new TIFFTestFile()
				.tag(256, 3, int[4])
				.tag(257, 3, int[1])
				.tag(258, 3, int[8])
				.tag(259, 3, int[5])
				.tag(262, 3, int[1])
				.block(byte[0x80, 0x7F, 0xFF, 0xFF])
			assert failure(badLzw.bytes()) != ""

			// No strip offsets at all.
			let noStrips = new TIFFTestFile()
				.tag(256, 3, int[1])
				.tag(257, 3, int[1])
				.tag(262, 3, int[1])
			assert failure(noStrips.bytes()) != ""

			let shortMap = new TIFFTestFile()
				.tag(256, 3, int[1])
				.tag(257, 3, int[1])
				.tag(258, 3, int[8])
				.tag(262, 3, int[3])
				.tag(320, 3, int[0, 0, 0])
				.block(byte[0])
			assert failure(shortMap.bytes()).contains("color map")

			let fax = new TIFFTestFile()
				.tag(256, 3, int[1])
				.tag(257, 3, int[1])
				.tag(259, 3, int[4])
				.tag(262, 3, int[0])
				.block(byte[0])
			assert failure(fax.bytes()).contains("CCITT")
		}
	}
}
