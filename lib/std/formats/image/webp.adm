partial module std.formats.image {
	use (
		std.io
		std.bytes
	)

	// WEBP is the WebP codec. Decoding and encoding are not implemented yet;
	// matchSignature reports that nothing matches.
	@codec("Web Picture format")
	type WEBP {
		mimeType string[] {
			def get() string[] {
				return string["image/webp"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".webp"]
			}
		}

		// matchSignature reports whether the reader starts with a WebP signature.
		// Not implemented yet: always false.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// info reads the image's dimensions and format from the bytes. Fails, as
		// decoding is not implemented yet.
		def info(data byte[]) !ImageInfo {
			return info(new bytes.Buffer(data))
		}

		// info reads the image's dimensions and format from the reader. Fails, as
		// decoding is not implemented yet.
		def info(reader io.Reader) !ImageInfo {
			fail "not implemented"
		}

		// decode reads a WebP image from the bytes. Fails, as decoding is not
		// implemented yet.
		def decode(data byte[]) !Image {
			return decode(new bytes.Buffer(data))
		}

		// decode reads a WebP image from the reader. Fails, as decoding is not
		// implemented yet.
		def decode(reader io.Reader) !Image {
			fail "not implemented"
		}

		// encode renders the image as WebP. Not implemented yet: returns no bytes.
		def encode() byte[] {}

		// encode writes the image as WebP to the writer. Not implemented yet; it
		// cannot fail.
		def encode(writer io.Writer) !none {}
	}
}
