partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.formats.image.webp::*
	)

	// WEBP is the WebP codec: lossy (VP8) and lossless (VP8L) images, alpha,
	// animation and the metadata chunks.
	//
	// `decode` returns the first frame and fills the fields below; `encode()`
	// writes them back. Encoding is lossless unless `lossy` is set.
	@codec("Web Picture format")
	type WEBP {
		// Every frame of the file, each the full canvas with the frames before
		// it composited in, shown for `length`. A still image has one frame.
		frames              ImageFrame[]
		// How many times an animation plays; 0 is forever.
		loopCount           int          = 0
		// The canvas colour the animation suggests behind its frames. It is
		// kept and written back, but frames composite over transparency, as
		// browsers draw them.
		background          color.Color
		// The embedded ICC colour profile, EXIF and XMP metadata, as stored;
		// empty when absent. `encode` writes the ones that are set.
		iccProfile          byte[]
		exif                byte[]
		xmp                 byte[]
		// Whether the image is stored lossy (VP8) rather than lossless (VP8L):
		// `decode` sets it from the file's first frame, `encode` follows it.
		lossy               bool
		// Lossy encoding quality, 0 (smallest file) to 100 (best image).
		quality             int          = 75
		// Whether the last decoded file declares an alpha channel.
		hasAlpha            bool
		// The codes of the top-level chunks of the last decoded file, in order
		// ("VP8X", "ICCP", "ANIM", "ANMF", ...).
		chunks              string[]
		// Whether the image `decodeImage` read last declared alpha, which
		// decides an animation's key frames.
		internal frameAlpha bool

		mimeType string[] {
			def get() string[] {
				return string["image/webp"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".webp"]
			}
		}

		// matchSignature reports whether the reader starts with a RIFF header
		// of form type WEBP.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(12)
			let n = r.read(b) onerror recover 0
			return false when n != 12
			return webpIsRIFF(b)
		}

		// info reads the image's dimensions and whether it has alpha from the
		// bytes. Fails when they are not WebP or the headers are cut short.
		def info(data byte[]) !ImageInfo {
			let end = try webpRIFFEnd(data)
			let list = try webpChunks(data, 12, end)
			fail "webp: no image data" when list.len() == 0
			let c = list[0]
			let w = 0
			let h = 0
			let alpha = false
			if c.id == "VP8X" {
				fail "webp: bad VP8X chunk" when c.size < 10
				alpha = (int(data[c.start]) & webpFlagAlpha) != 0
				w = webpLE24(data, c.start + 4) + 1
				h = webpLE24(data, c.start + 7) + 1
			} else if c.id == "VP8L" {
				let dec = new WebpLosslessDecoder(data, c.start, c.start + c.size)
				let (lw, lh, la) = try dec.header()
				w = lw
				h = lh
				alpha = la
			} else if c.id == "VP8 " {
				let dec = new WebpLossyDecoder(data, c.start, c.start + c.size)
				let (vw, vh) = try dec.header()
				w = vw
				h = vh
			} else {
				fail "webp: no image data"
			}
			return ImageInfo{
				size: new geom.Size(float(w), float(h)),
				colorFormat: alpha ?? (color.ColorFormat.RGBA, color.ColorFormat.RGB),
			}
		}

		// info reads the image's dimensions and whether it has alpha from the
		// reader. Fails when the data is not WebP, or the reader fails.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads a WebP image from the bytes and returns its first
		// frame, filling `frames` and the other fields. Fails when the bytes
		// are not WebP, a bit stream is corrupt, or the file is cut short.
		def decode(data byte[]) !Image {
			let end = try webpRIFFEnd(data)
			let list = try webpChunks(data, 12, end)
			fail "webp: no image data" when list.len() == 0

			frames = []
			loopCount = 0
			background = new color.Color(color.RGBA{r: byte(0), g: byte(0), b: byte(0), a: byte(0)})
			iccProfile = []
			exif = []
			xmp = []
			lossy = false
			hasAlpha = false
			chunks = []
			for let (_, c) in list {
				chunks.push(c.id)
			}

			let first = list[0]
			if first.id != "VP8X" {
				let img = try decodeImage(data, list, 0, 0)
				frames.push(webpFrame(img, 0))
				return img
			}

			fail "webp: bad VP8X chunk" when first.size < 10
			let flags = int(data[first.start])
			let cw = webpLE24(data, first.start + 4) + 1
			let chh = webpLE24(data, first.start + 7) + 1
			fail "webp: canvas too large" when cw * chh >= 0x100000000
			hasAlpha = (flags & webpFlagAlpha) != 0
			for let (_, c) in list {
				if c.id == "ICCP" {
					iccProfile = data[c.start:c.start + c.size].clone()
				} else if c.id == "EXIF" {
					exif = data[c.start:c.start + c.size].clone()
				} else if c.id == "XMP " {
					xmp = data[c.start:c.start + c.size].clone()
				}
			}

			if (flags & webpFlagAnimation) == 0 {
				let img = try decodeImage(data, list, 1, 0)
				fail "webp: image size differs from the canvas" when int(img.size().width) != cw || int(img.size().height) != chh
				frames.push(webpFrame(img, 0))
				return img
			}

			let canvas = new Image(cw, chh)
			let raw = canvas.raw()
			let stride = canvas.stride()
			// The previous frame's rectangle, whether it asked to be cleared
			// before the next frame, and whether it started afresh.
			let prevX = 0
			let prevY = 0
			let prevW = 0
			let prevH = 0
			let prevDispose = false
			let prevKey = false
			for let (_, c) in list {
				if c.id == "ANIM" {
					fail "webp: bad ANIM chunk" when c.size < 6
					background = new color.Color(color.RGBA{r: data[c.start + 2], g: data[c.start + 1], b: data[c.start], a: data[c.start + 3]})
					loopCount = webpLE16(data, c.start + 4)
					continue
				}
				continue unless c.id == "ANMF"
				fail "webp: bad ANMF chunk" when c.size < 16
				let fx = 2 * webpLE24(data, c.start)
				let fy = 2 * webpLE24(data, c.start + 3)
				let fw = webpLE24(data, c.start + 6) + 1
				let fh = webpLE24(data, c.start + 9) + 1
				let ms = webpLE24(data, c.start + 12)
				let fflags = int(data[c.start + 15])
				fail "webp: frame outside the canvas" when fx + fw > cw || fy + fh > chh

				let sub = try webpChunks(data, c.start + 16, c.start + c.size)
				let img = try decodeImage(data, sub, 0, frames.len())
				fail "webp: frame size differs from its header" when int(img.size().width) != fw || int(img.size().height) != fh
				let blend = (fflags & 2) == 0
				let full = fw == cw && fh == chh
				let prevFull = prevW == cw && prevH == chh
				// A key frame starts from a transparent canvas and is drawn
				// without blending, as nothing before it shows through.
				let key = frames.len() == 0 || (full && (!blend || !frameAlpha)) || (prevDispose && (prevFull || prevKey))
				let clearX = 0
				let clearY = 0
				let clearW = 0
				let clearH = 0
				if key {
					raw.fill(byte(0))
					blend = false
				} else if prevDispose {
					clearX = prevX
					clearY = prevY
					clearW = prevW
					clearH = prevH
					for let y = clearY; y < clearY + clearH; y++ {
						let o = y * stride + clearX * 4
						for let i = 0; i < clearW * 4; i++ {
							raw[o + i] = byte(0)
						}
					}
				}

				let src = img.raw()
				for let y = 0; y < fh; y++ {
					let s = y * img.stride()
					let d = (fy + y) * stride + fx * 4
					let cy = fy + y
					let rowCleared = cy >= clearY && cy < clearY + clearH
					for let x = 0; x < fw; x++ {
						let cx = fx + x
						// Cleared pixels take the frame as it is.
						if blend && !(rowCleared && cx >= clearX && cx < clearX + clearW) {
							webpBlend(raw, d, src, s)
						} else {
							raw[d] = src[s]
							raw[d + 1] = src[s + 1]
							raw[d + 2] = src[s + 2]
							raw[d + 3] = src[s + 3]
						}
						s += 4
						d += 4
					}
				}
				prevX = fx
				prevY = fy
				prevW = fw
				prevH = fh
				prevDispose = (fflags & 1) != 0
				prevKey = key
				frames.push(webpFrame(canvas.copy(), ms))
			}
			fail "webp: animation has no frames" when frames.len() == 0
			return frames[0].image
		}

		// decode reads a WebP image from the reader and returns its first
		// frame. Fails when the data is not WebP, is corrupt or cut short, or
		// the reader fails.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// Decodes the image of a chunk list from chunk `from` on: an optional
		// ALPH chunk, then a VP8 or VP8L chunk. `index` counts frames, the
		// first one setting `lossless`.
		internal def decodeImage(data byte[], list WebpChunk[], from int, index int) !Image {
			let alphaAt = -1
			for let k = from; k < list.len(); k++ {
				let c = list[k]
				if c.id == "ALPH" {
					alphaAt = k when alphaAt < 0
				} else if c.id == "VP8L" {
					let dec = new WebpLosslessDecoder(data, c.start, c.start + c.size)
					let (w, h, alpha) = try dec.header()
					frameAlpha = alpha
					let pix = try dec.image(w, h)
					let img = new Image(0, 0)
					img.reshape(pix, new geom.Size<uint>(uint(w), uint(h)), w * 4)
					if index == 0 && !hasAlpha {
						for let i = 3; i < pix.len(); i += 4 {
							if int(pix[i]) != 255 {
								hasAlpha = true
								break
							}
						}
					}
					return img
				} else if c.id == "VP8 " {
					let dec = new WebpLossyDecoder(data, c.start, c.start + c.size)
					try dec.decode()
					frameAlpha = alphaAt >= 0
					lossy = true when index == 0
					let img = webpPlanesToImage(dec)
					if alphaAt >= 0 {
						let a = list[alphaAt]
						let alpha = try webpDecodeAlpha(data, a.start, a.size, dec.width, dec.height)
						let raw = img.raw()
						for let i = 0; i < alpha.len(); i++ {
							raw[4 * i + 3] = alpha[i]
						}
					}
					return img
				}
			}
			fail "webp: no image data"
		}

		// encode renders the image as a WebP file, lossy when `lossy` is
		// set, else lossless, with the metadata fields that are set. Fails
		// when the image is empty or larger than 16384 pixels a side.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as a WebP file to the writer, lossy when
		// `lossy` is set, else lossless, with the metadata fields that are
		// set. Fails when the image is empty or larger than 16384 pixels a
		// side, or the writer fails.
		def encode(img Image, writer io.Writer) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			try webpCheckSize(w, h)
			let alpha = webpAlphaFlag(img)
			let body byte[]
			if metadataFlags() == 0 && (!lossy || alpha == 0) {
				putImage(body, img)
			} else {
				webpPutVP8X(body, alpha | metadataFlags(), w, h)
				webpPutChunk(body, "ICCP", iccProfile) when iccProfile.len() > 0
				putImage(body, img)
				webpPutChunk(body, "EXIF", exif) when exif.len() > 0
				webpPutChunk(body, "XMP ", xmp) when xmp.len() > 0
			}
			try writer.write(webpRIFF(body))
		}

		// encode writes `frames` as a WebP file: a still image when there is
		// one frame, else an animation that loops `loopCount` times. Each
		// frame stores only the rectangle that changed from the one before.
		// Fails when there are no frames, their sizes differ, or the writer
		// fails.
		def encode(writer io.Writer) !none {
			fail "webp: no frames to encode" when frames.len() == 0
			return encode(frames[0].image, writer) when frames.len() == 1

			let cw = int(frames[0].image.size().width)
			let chh = int(frames[0].image.size().height)
			try webpCheckSize(cw, chh)
			let flags = webpFlagAnimation | metadataFlags()
			for let (_, f) in frames {
				fail "webp: frames differ in size" when int(f.image.size().width) != cw || int(f.image.size().height) != chh
				flags = flags | webpAlphaFlag(f.image)
			}

			let body byte[]
			webpPutVP8X(body, flags, cw, chh)
			webpPutChunk(body, "ICCP", iccProfile) when iccProfile.len() > 0
			let anim byte[]
			anim.push(background.blue, background.green, background.red, background.alpha)
			anim.push(byte(loopCount & 255), byte((loopCount >> 8) & 255))
			webpPutChunk(body, "ANIM", anim)

			let prev ?Image = none
			for let (_, f) in frames {
				let (x, y, w, h) = webpChangedRect(prev, f.image)
				let part = f.image.subImage(new geom.Rectangle(position = new geom.Point(float(x), float(y)), size = new geom.Size(float(w), float(h))))
				let ms = int(f.length) / 1000000
				ms = 0xffffff when ms > 0xffffff
				let frame byte[]
				webpPut24(frame, x / 2)
				webpPut24(frame, y / 2)
				webpPut24(frame, w - 1)
				webpPut24(frame, h - 1)
				webpPut24(frame, ms)
				// Overwrite without blending; never dispose.
				frame.push(byte(2))
				putImage(frame, part)
				webpPutChunk(body, "ANMF", frame)
				prev = f.image
			}
			webpPutChunk(body, "EXIF", exif) when exif.len() > 0
			webpPutChunk(body, "XMP ", xmp) when xmp.len() > 0
			try writer.write(webpRIFF(body))
		}

		// encode renders `frames` as WebP, as `encode(writer)` does. Fails
		// when there are no frames or their sizes differ.
		def encode() !byte[] {
			let out = new bytes.Buffer()
			try encode(out)
			return out.bytes()
		}

		// Appends the chunks of one image: VP8L when lossless, else an ALPH
		// chunk when it has transparency and the VP8 chunk.
		internal def putImage(out byte[], img Image) {
			if !lossy {
				webpPutChunk(out, "VP8L", webpEncodeLossless(img))
				return
			}
			webpPutChunk(out, "ALPH", webpEncodeAlpha(img)) when webpAlphaFlag(img) != 0
			webpPutChunk(out, "VP8 ", webpEncodeLossy(img, quality))
		}

		// The VP8X flags of the metadata fields that are set.
		internal def metadataFlags() int {
			let f = 0
			f = f | webpFlagICC when iccProfile.len() > 0
			f = f | webpFlagEXIF when exif.len() > 0
			f = f | webpFlagXMP when xmp.len() > 0
			return f
		}
	}
}

internal partial module std.formats.image.webp {
	use (
		std.math.geom
		std.gfx.color
		std.formats.image::*
	)

	// Flags of the VP8X chunk.
	const (
		webpFlagAnimation = 0x02
		webpFlagXMP       = 0x04
		webpFlagEXIF      = 0x08
		webpFlagAlpha     = 0x10
		webpFlagICC       = 0x20
	)

	// Little-endian readers over the file bytes.
	def webpLE16(d byte[], o int) int {
		return int(d[o]) | (int(d[o + 1]) << 8)
	}

	def webpLE24(d byte[], o int) int {
		return int(d[o]) | (int(d[o + 1]) << 8) | (int(d[o + 2]) << 16)
	}

	def webpLE32(d byte[], o int) int {
		return webpLE24(d, o) | (int(d[o + 3]) << 24)
	}

	// The four-character code at `o`.
	def webpFourCC(d byte[], o int) string {
		return string(d[o:o + 4].clone())
	}

	// Whether the bytes start with a RIFF header of form type WEBP.
	def webpIsRIFF(d byte[]) bool {
		return false when d.len() < 12
		return webpFourCC(d, 0) == "RIFF" && webpFourCC(d, 8) == "WEBP"
	}

	// The end of the chunk list: the RIFF size, bounded by the data. Fails
	// when the file is not WebP or is cut short.
	def webpRIFFEnd(d byte[]) !int {
		expects {
			assert webpIsRIFF(d) onerror fail "webp: not a WebP file"
		}
		let end = 8 + webpLE32(d, 4)
		fail "webp: truncated file" when end > d.len() || end < 12
		return end
	}

	// A chunk of a RIFF chunk list: its code and where its payload lies.
	struct WebpChunk {
		id    string
		start int
		size  int
	}

	// The chunks from `from` to `to`. Fails when a chunk runs past the end.
	def webpChunks(d byte[], from int, to int) !WebpChunk[] {
		let out WebpChunk[]
		let p = from
		for p + 8 <= to {
			let size = webpLE32(d, p + 4)
			fail "webp: truncated chunk" when p + 8 + size > to
			out.push(WebpChunk{id: webpFourCC(d, p), start: p + 8, size: size})
			p += 8 + size + (size & 1)
		}
		return out
	}

	// One row of chroma upsampled to full width: `near` is the chroma row
	// closest to the luma row, weighted 3 to 1 against `far`, and each pair of
	// output pixels blends the neighbouring columns the same way.
	def webpUpsampleRow(plane byte[], near int, far int, out int[], width int) {
		out[0] = (3 * int(plane[near]) + int(plane[far]) + 2) >> 2
		let pairs = (width - 1) >> 1
		for let x = 1; x <= pairs; x++ {
			let tl = int(plane[near + x - 1])
			let t = int(plane[near + x])
			let l = int(plane[far + x - 1])
			let uv = int(plane[far + x])
			let avg = tl + t + l + uv + 8
			let d12 = (avg + 2 * (t + l)) >> 3
			let d03 = (avg + 2 * (tl + uv)) >> 3
			out[2 * x - 1] = (d12 + tl) >> 1
			out[2 * x] = (d03 + t) >> 1
		}
		if (width & 1) == 0 {
			let x = pairs
			out[width - 1] = (3 * int(plane[near + x]) + int(plane[far + x]) + 2) >> 2
		}
	}

	// Converts the decoded planes to RGBA, upsampling chroma with the
	// bilinear filter, into an opaque image. The colour conversion works in
	// 14-bit fixed point and drops the six fraction bits.
	def webpPlanesToImage(dec WebpLossyDecoder) Image {
		let w = dec.width
		let h = dec.height
		let img = new Image(w, h)
		let raw = img.raw()
		let stride = img.stride()
		let us = webpZeros(w)
		let vs = webpZeros(w)
		let ch = (h + 1) >> 1
		for let y = 0; y < h; y++ {
			let near = y >> 1
			let far = (y & 1) == 1 ?? (near + 1, near - 1)
			far = 0 when far < 0
			far = ch - 1 when far >= ch
			webpUpsampleRow(dec.u, near * dec.cStride, far * dec.cStride, us, w)
			webpUpsampleRow(dec.v, near * dec.cStride, far * dec.cStride, vs, w)
			let yo = y * dec.yStride
			let o = y * stride
			for let x = 0; x < w; x++ {
				let yy = (int(dec.y[yo + x]) * 19077) >> 8
				let u = us[x]
				let v = vs[x]
				let r = yy + ((v * 26149) >> 8) - 14234
				let g = yy - ((u * 6419) >> 8) - ((v * 13320) >> 8) + 8708
				let b = yy + ((u * 33050) >> 8) - 17685
				raw[o] = byte(r < 0 ?? (0, r >= 16384 ?? (255, r >> 6)))
				raw[o + 1] = byte(g < 0 ?? (0, g >= 16384 ?? (255, g >> 6)))
				raw[o + 2] = byte(b < 0 ?? (0, b >= 16384 ?? (255, b >> 6)))
				raw[o + 3] = byte(255)
				o += 4
			}
		}
		return img
	}

	// Decodes an ALPH chunk into one alpha byte per pixel.
	def webpDecodeAlpha(d byte[], start int, size int, w int, h int) !byte[] {
		expects {
			assert size >= 1 onerror fail "webp: empty alpha chunk"
		}
		let hdr = int(d[start])
		let method = hdr & 3
		let filter = (hdr >> 2) & 3
		let alpha byte[]
		if method == 0 {
			fail "webp: truncated alpha" when size - 1 < w * h
			alpha = d[start + 1:start + 1 + w * h].clone()
		} else if method == 1 {
			let dec = new WebpLosslessDecoder(d, start + 1, start + size)
			let pix = try dec.image(w, h)
			alpha.len(w * h)
			for let i = 0; i < w * h; i++ {
				alpha[i] = pix[4 * i + 1]
			}
		} else {
			fail "webp: unknown alpha compression"
		}
		webpUnfilterAlpha(alpha, w, h, filter)
		return alpha
	}

	// Undoes the alpha plane's prediction filter: horizontal, vertical or
	// gradient.
	def webpUnfilterAlpha(a byte[], w int, h int, filter int) {
		return when filter == 0
		for let x = 1; x < w; x++ {
			a[x] = byte((int(a[x]) + int(a[x - 1])) & 255)
		}
		for let y = 1; y < h; y++ {
			let r = y * w
			a[r] = byte((int(a[r]) + int(a[r - w])) & 255)
			for let x = 1; x < w; x++ {
				let i = r + x
				let pred = 0
				if filter == 1 {
					pred = int(a[i - 1])
				} else if filter == 2 {
					pred = int(a[i - w])
				} else {
					pred = webpClamp255(int(a[i - 1]) + int(a[i - w]) - int(a[i - w - 1]))
				}
				a[i] = byte((int(a[i]) + pred) & 255)
			}
		}
	}

	// Composites `src` over `dst` with straight alpha, the frame blending of
	// animated WebP.
	def webpBlend(dst byte[], d int, src byte[], s int) {
		let sa = int(src[s + 3])
		return when sa == 0
		if sa == 255 {
			dst[d] = src[s]
			dst[d + 1] = src[s + 1]
			dst[d + 2] = src[s + 2]
			dst[d + 3] = byte(255)
			return
		}
		let da = int(dst[d + 3])
		let dfa = (da * (256 - sa)) >> 8
		let ba = sa + dfa
		let scale = (1 << 24) / ba
		for let c = 0; c < 3; c++ {
			let v = int(src[s + c]) * sa + int(dst[d + c]) * dfa
			dst[d + c] = byte(((v * scale) >> 24) & 255)
		}
		dst[d + 3] = byte(ba)
	}

	// A frame at the canvas origin shown for `ms` milliseconds.
	def webpFrame(img Image, ms int) ImageFrame {
		let f = new ImageFrame()
		f.image = img
		f.length = duration(ms * 1000000)
		f.offset = new geom.Point(0.0, 0.0)
		f.blendMode = color.BlendMode.Normal
		return f
	}

	def webpCheckSize(w int, h int) !none {
		expects {
			assert w >= 1 && h >= 1 onerror fail "webp: cannot encode an empty image"
			assert w <= 16384 && h <= 16384 onerror fail "webp: image larger than 16384 pixels a side"
		}
	}

	// The alpha flag when any pixel of the image is not opaque.
	def webpAlphaFlag(img Image) int {
		let raw = img.raw()
		let w = int(img.size().width)
		for let y = 0; y < int(img.size().height); y++ {
			let o = y * img.stride()
			for let x = 0; x < w; x++ {
				return webpFlagAlpha when int(raw[o + 4 * x + 3]) != 255
			}
		}
		return 0
	}

	// The smallest rectangle, on even coordinates, holding every pixel of
	// `cur` that differs from `prev`: (x, y, width, height). The whole image
	// when there is no previous frame; one pixel when nothing changed.
	def webpChangedRect(prev ?Image, cur Image) (int, int, int, int) {
		let w = int(cur.size().width)
		let h = int(cur.size().height)
		return (0, 0, w, h) when prev is none
		let a = prev.raw()
		let b = cur.raw()
		let sa = prev.stride()
		let sb = cur.stride()
		let x0 = w
		let y0 = h
		let x1 = -1
		let y1 = -1
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let oa = y * sa + 4 * x
				let ob = y * sb + 4 * x
				if a[oa] != b[ob] || a[oa + 1] != b[ob + 1] || a[oa + 2] != b[ob + 2] || a[oa + 3] != b[ob + 3] {
					x0 = x when x < x0
					x1 = x when x > x1
					y0 = y when y < y0
					y1 = y when y > y1
				}
			}
		}
		return (0, 0, 1, 1) when x1 < 0
		x0 = x0 & (-2)
		y0 = y0 & (-2)
		return (x0, y0, x1 - x0 + 1, y1 - y0 + 1)
	}

	def webpPut24(out byte[], v int) {
		out.push(byte(v & 255), byte((v >> 8) & 255), byte((v >> 16) & 255))
	}

	def webpPut32(out byte[], v int) {
		out.push(byte(v & 255), byte((v >> 8) & 255), byte((v >> 16) & 255), byte((v >> 24) & 255))
	}

	// Appends a chunk: code, size, payload and the pad byte of an odd size.
	def webpPutChunk(out byte[], id string, payload byte[]) {
		for let (_, c) in id.bytes() {
			out.push(c)
		}
		webpPut32(out, payload.len())
		for let (_, b) in payload {
			out.push(b)
		}
		out.push(byte(0)) when (payload.len() & 1) == 1
	}

	def webpPutVP8X(out byte[], flags int, w int, h int) {
		let p byte[]
		p.push(byte(flags), byte(0), byte(0), byte(0))
		webpPut24(p, w - 1)
		webpPut24(p, h - 1)
		webpPutChunk(out, "VP8X", p)
	}

	// Wraps a chunk list in the RIFF header.
	def webpRIFF(body byte[]) byte[] {
		let out byte[]
		for let (_, c) in "RIFF".bytes() {
			out.push(c)
		}
		webpPut32(out, body.len() + 4)
		for let (_, c) in "WEBP".bytes() {
			out.push(c)
		}
		for let (_, b) in body {
			out.push(b)
		}
		return out
	}
}
