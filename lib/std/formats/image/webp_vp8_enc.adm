internal partial module std.formats.image.webp {
	use (
		std.math
		std.formats.image::*
		std.formats.vp8::*
	)

	// Whole-block intra modes the lossy encoder chooses from.
	const webpEncBlockModes = int[0, 1, 2, 3]

	// WebpBoolEncoder writes the boolean entropy code a VP8 partition is made
	// of.
	type WebpBoolEncoder {
		out   byte[]
		range int
		low   int
		count int
		// When not empty, how often each token probability saw a 0 and a 1.
		stats int[]

		def new() {
			out = []
			range = 255
			low = 0
			count = -24
			stats = []
		}

		// Writes a token bit with the probability `probs[i]`, counting it.
		def token(probs int[], i int, bit bool) {
			stats[2 * i + (bit ?? (1, 0))]++ when stats.len() > 0
			put(probs[i], bit)
		}

		// Writes one bit that is zero with probability `prob` / 256.
		def put(prob int, bit bool) {
			let split = 1 + (((range - 1) * prob) >> 8)
			if bit {
				low += split
				range -= split
			} else {
				range = split
			}
			let shift = 0
			for (range << shift) < 128 {
				shift++
			}
			range = range << shift
			count += shift
			if count >= 0 {
				let offset = shift - count
				if ((low << (offset - 1)) & 0x80000000) != 0 {
					let x = out.len() - 1
					for x >= 0 && int(out[x]) == 255 {
						out[x] = byte(0)
						x--
					}
					out[x] = byte(int(out[x]) + 1)
				}
				out.push(byte((low >> (24 - offset)) & 255))
				low = (low << offset) & 0xffffff
				shift = count
				count -= 8
			}
			low = (low << shift) & 0xffffffff
		}

		// Writes an `n`-bit value, most significant bit first, at even odds.
		def literal(v int, n int) {
			for let i = n - 1; i >= 0; i-- {
				put(128, ((v >> i) & 1) == 1)
			}
		}

		// The coded bytes, the coder flushed.
		def bytes() byte[] {
			for let i = 0; i < 32; i++ {
				put(128, false)
			}
			return out
		}
	}

	// The quantiser index of a quality from 0 (smallest) to 100 (best).
	def webpQualityToIndex(quality int) int {
		let q = vp8Clip(quality, 0, 100)
		return vp8Clip(((100 - q) * 127 + 50) / 100, 0, 127)
	}

	// Forward 4x4 DCT of the residual block at `at` (row stride `stride`)
	// into `out` from `o`, in natural order.
	def webpForwardDCT(res int[], at int, stride int, out int[], o int) {
		let tmp = webpZeros(16)
		for let i = 0; i < 4; i++ {
			let r = at + i * stride
			let a1 = (res[r] + res[r + 3]) * 8
			let b1 = (res[r + 1] + res[r + 2]) * 8
			let c1 = (res[r + 1] - res[r + 2]) * 8
			let d1 = (res[r] - res[r + 3]) * 8
			tmp[i * 4] = a1 + b1
			tmp[i * 4 + 2] = a1 - b1
			tmp[i * 4 + 1] = (c1 * 2217 + d1 * 5352 + 14500) >> 12
			tmp[i * 4 + 3] = (d1 * 2217 - c1 * 5352 + 7500) >> 12
		}
		for let i = 0; i < 4; i++ {
			let a1 = tmp[i] + tmp[12 + i]
			let b1 = tmp[4 + i] + tmp[8 + i]
			let c1 = tmp[4 + i] - tmp[8 + i]
			let d1 = tmp[i] - tmp[12 + i]
			out[o + i] = (a1 + b1 + 7) >> 4
			out[o + 8 + i] = (a1 - b1 + 7) >> 4
			out[o + 4 + i] = ((c1 * 2217 + d1 * 5352 + 12000) >> 16) + (d1 != 0 ?? (1, 0))
			out[o + 12 + i] = (d1 * 2217 - c1 * 5352 + 51000) >> 16
		}
	}

	// Forward Walsh-Hadamard transform of the sixteen luma DC coefficients.
	def webpForwardWHT(dc int[], out int[], o int) {
		let tmp = webpZeros(16)
		for let i = 0; i < 4; i++ {
			let r = i * 4
			let a1 = (dc[r] + dc[r + 2]) * 4
			let d1 = (dc[r + 1] + dc[r + 3]) * 4
			let c1 = (dc[r + 1] - dc[r + 3]) * 4
			let b1 = (dc[r] - dc[r + 2]) * 4
			tmp[r] = a1 + d1 + (a1 != 0 ?? (1, 0))
			tmp[r + 1] = b1 + c1
			tmp[r + 2] = b1 - c1
			tmp[r + 3] = a1 - d1
		}
		for let i = 0; i < 4; i++ {
			let a1 = tmp[i] + tmp[8 + i]
			let d1 = tmp[4 + i] + tmp[12 + i]
			let c1 = tmp[4 + i] - tmp[12 + i]
			let b1 = tmp[i] - tmp[8 + i]
			let a2 = a1 + d1
			let b2 = b1 + c1
			let c2 = b1 - c1
			let d2 = a1 - d1
			a2 += 1 when a2 < 0
			b2 += 1 when b2 < 0
			c2 += 1 when c2 < 0
			d2 += 1 when d2 < 0
			out[o + i] = (a2 + 3) >> 3
			out[o + 4 + i] = (b2 + 3) >> 3
			out[o + 8 + i] = (c2 + 3) >> 3
			out[o + 12 + i] = (d2 + 3) >> 3
		}
	}

	// A coefficient quantised with step `q`, rounding towards zero past
	// `bias` / 16 of a step, and clamped to what the tokens can carry.
	def webpQuantize(c int, q int, bias int) int {
		let a = c < 0 ?? (0 - c, c)
		let l = (a * 16 + q * bias) / (q * 16)
		l = 2048 when l > 2048
		return c < 0 ?? (0 - l, l)
	}

	// Writes the tokens of one 4x4 block whose quantised coefficients sit at
	// `base` in natural order, and returns 1 when any is non-zero.
	def webpPutBlock(e WebpBoolEncoder, probs int[], levels int[], base int, plane int, context int, first int) int {
		let last = -1
		for let n = first; n < 16; n++ {
			last = n when levels[base + vp8Zigzag[n]] != 0
		}
		let pb = plane * 264
		let p = pb + (vp8Bands[first] * 3 + context) * 11
		if last < 0 {
			e.token(probs, p, false)
			return 0
		}
		e.token(probs, p, true)
		let n = first
		for n < 16 {
			let c = levels[base + vp8Zigzag[n]]
			let v = c < 0 ?? (0 - c, c)
			n++
			if v == 0 {
				e.token(probs, p + 1, false)
				p = pb + vp8Bands[n] * 33
				continue
			}
			e.token(probs, p + 1, true)
			let ctx = 2
			if v == 1 {
				e.token(probs, p + 2, false)
				ctx = 1
			} else {
				e.token(probs, p + 2, true)
				if v <= 4 {
					e.token(probs, p + 3, false)
					if v == 2 {
						e.token(probs, p + 4, false)
					} else {
						e.token(probs, p + 4, true)
						e.token(probs, p + 5, v == 4)
					}
				} else if v <= 10 {
					e.token(probs, p + 3, true)
					e.token(probs, p + 6, false)
					if v <= 6 {
						e.token(probs, p + 7, false)
						e.put(159, v == 6)
					} else {
						e.token(probs, p + 7, true)
						e.put(165, ((v - 7) >> 1) == 1)
						e.put(145, ((v - 7) & 1) == 1)
					}
				} else {
					e.token(probs, p + 3, true)
					e.token(probs, p + 6, true)
					let cat = v < 19 ?? (0, v < 35 ?? (1, v < 67 ?? (2, 3)))
					e.token(probs, p + 8, cat >= 2)
					e.token(probs, p + 9 + (cat >> 1), (cat & 1) == 1)
					let extra = v - 3 - (8 << cat)
					let t = cat * 12
					let nbits = 0
					for vp8Cat3456[t + nbits] != 0 {
						nbits++
					}
					for let k = 0; k < nbits; k++ {
						e.put(vp8Cat3456[t + k], ((extra >> (nbits - 1 - k)) & 1) == 1)
					}
				}
			}
			e.put(128, c < 0)
			p = pb + (vp8Bands[n] * 3 + ctx) * 11
			return 1 when n == 16
			if n > last {
				e.token(probs, p, false)
				return 1
			}
			e.token(probs, p, true)
		}
		return 1
	}

	// Picks new token probabilities from the counts of a first pass, where
	// the bits saved outweigh the cost of sending the update; marks those in
	// `updated`.
	def webpTuneProbs(stats int[], probs int[], updated int[]) {
		for let i = 0; i < 1056; i++ {
			let n0 = stats[2 * i]
			let n1 = stats[2 * i + 1]
			continue when n0 + n1 == 0
			let p = vp8Clip((n0 * 256 + (n0 + n1) / 2) / (n0 + n1), 1, 255)
			let up = vp8TokenUpdateProb[i]
			let old = webpBitCost(n0, n1, probs[i]) + webpBitCost(1, 0, up)
			let fresh = webpBitCost(n0, n1, p) + webpBitCost(0, 1, up) + 8.0
			if fresh < old {
				probs[i] = p
				updated[i] = 1
			}
		}
	}

	// Bits to code `n0` zeros and `n1` ones when a zero has probability
	// `p` / 256.
	def webpBitCost(n0 int, n1 int, p int) float {
		let zero = math.ln(float(p) / 256.0)
		let one = math.ln(float(256 - p) / 256.0)
		return (0.0 - float(n0) * zero - float(n1) * one) / math.ln(2.0)
	}

	// Sum of squared differences between an `n` x `n` block of the workspace
	// at `at` and the source plane at `so`.
	def webpBlockSSE(ybr int[], at int, src byte[], so int, stride int, n int) int {
		let sum = 0
		for let j = 0; j < n; j++ {
			for let i = 0; i < n; i++ {
				let d = ybr[at + j * 32 + i] - int(src[so + j * stride + i])
				sum += d * d
			}
		}
		return sum
	}

	// Copies an image plane into a buffer padded to whole macroblocks by
	// repeating the last column and row.
	def webpPadPlane(src byte[], w int, h int, stride int, rows int) byte[] {
		let out = vp8Bytes(stride * rows)
		for let y = 0; y < rows; y++ {
			let sy = y < h ?? (y, h - 1)
			for let x = 0; x < stride; x++ {
				out[y * stride + x] = src[sy * w + (x < w ?? (x, w - 1))]
			}
		}
		return out
	}

	// Converts RGBA to the Y, U and V planes the encoder works on, chroma
	// averaged over each 2x2 block.
	def webpRgbaToPlanes(img Image, y byte[], u byte[], v byte[]) {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let raw = img.raw()
		let stride = img.stride()
		for let j = 0; j < h; j++ {
			for let i = 0; i < w; i++ {
				let o = j * stride + i * 4
				let luma = 16839 * int(raw[o]) + 33059 * int(raw[o + 1]) + 6420 * int(raw[o + 2])
				y[j * w + i] = byte((luma + 32768 + (16 << 16)) >> 16)
			}
		}
		let cw = (w + 1) >> 1
		let ch = (h + 1) >> 1
		for let j = 0; j < ch; j++ {
			for let i = 0; i < cw; i++ {
				let r = 0
				let g = 0
				let b = 0
				for let dy = 0; dy < 2; dy++ {
					for let dx = 0; dx < 2; dx++ {
						let sx = 2 * i + dx
						let sy = 2 * j + dy
						sx = w - 1 when sx >= w
						sy = h - 1 when sy >= h
						let o = sy * stride + sx * 4
						r += int(raw[o])
						g += int(raw[o + 1])
						b += int(raw[o + 2])
					}
				}
				let uu = (0 - 9719 * r - 19081 * g + 28800 * b + 131072 + (128 << 18)) >> 18
				let vv = (28800 * r - 24116 * g - 4684 * b + 131072 + (128 << 18)) >> 18
				u[j * cw + i] = byte(vp8Clip(uu, 0, 255))
				v[j * cw + i] = byte(vp8Clip(vv, 0, 255))
			}
		}
	}

	// Encodes an image as a VP8 key frame at the given quality: whole-block
	// intra prediction, default token probabilities, one token partition.
	def webpEncodeLossy(img Image, quality int) byte[] {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let cw = (w + 1) >> 1
		let ch = (h + 1) >> 1
		let py = vp8Bytes(w * h)
		let pu = vp8Bytes(cw * ch)
		let pv = vp8Bytes(cw * ch)
		webpRgbaToPlanes(img, py, pu, pv)

		// The reconstruction, kept exactly as a decoder rebuilds it, so each
		// block predicts from what the decoder will see.
		let rec = new Vp8Decoder()
		rec.width = w
		rec.height = h
		rec.mbw = (w + 15) >> 4
		rec.mbh = (h + 15) >> 4
		rec.yStride = 16 * rec.mbw
		rec.cStride = 8 * rec.mbw
		rec.y = vp8Bytes(rec.yStride * 16 * rec.mbh)
		rec.u = vp8Bytes(rec.cStride * 8 * rec.mbh)
		rec.v = vp8Bytes(rec.cStride * 8 * rec.mbh)
		let sy = webpPadPlane(py, w, h, rec.yStride, 16 * rec.mbh)
		let su = webpPadPlane(pu, cw, ch, rec.cStride, 8 * rec.mbh)
		let sv = webpPadPlane(pv, cw, ch, rec.cStride, 8 * rec.mbh)

		let qi = webpQualityToIndex(quality)
		let y1ac = vp8DequantAC[qi]
		let y2dc = vp8DequantDC[qi] * 2
		let y2ac = vp8DequantAC[qi] * 155 / 100
		y2ac = 8 when y2ac < 8
		let uvdc = vp8DequantDC[qi < 117 ?? (qi, 117)]
		let uvac = vp8DequantAC[qi]

		let probs = vp8DefaultTokenProb.clone()
		let updated = webpZeros(1056)
		let tok = new WebpBoolEncoder()
		let mbCount = rec.mbw * rec.mbh
		let yModes = webpZeros(mbCount)
		let uvModes = webpZeros(mbCount)
		let skips = webpZeros(mbCount)
		let upNz = webpZeros(rec.mbw)
		let upNzY16 = webpZeros(rec.mbw)
		let res = webpZeros(16 * 16)
		let resU = webpZeros(8 * 8)
		let resV = webpZeros(8 * 8)
		let dcs = webpZeros(16)
		let coeffs = webpZeros(400)
		let levels = webpZeros(400)
		let ybr = rec.ybr

		// Two passes: the first counts how the tokens fall to tune their
		// probabilities, the second codes them with the tuned ones.
		for let pass = 0; pass < 2; pass++ {
			tok = new WebpBoolEncoder()
			tok.stats = webpZeros(2 * 1056) when pass == 0
			upNz.fill(0)
			upNzY16.fill(0)
			for let mby = 0; mby < rec.mbh; mby++ {
				let leftNz = 0
				let leftNzY16 = 0
				for let mbx = 0; mbx < rec.mbw; mbx++ {
					let m = mby * rec.mbw + mbx
					rec.prepareYBR(mbx, mby)
					let yo = mby * 16 * rec.yStride + mbx * 16
					let co = mby * 8 * rec.cStride + mbx * 8
					let yAt = vp8YbrYY * 32 + vp8YbrYX
					let uAt = vp8YbrBY * 32 + vp8YbrBX
					let vAt = vp8YbrRY * 32 + vp8YbrRX

					let bestY = 0
					let bestCost = -1
					for let (_, mode) in webpEncBlockModes {
						vp8Predict16(ybr, vp8EdgePred(mbx, mby, mode))
						let cost = webpBlockSSE(ybr, yAt, sy, yo, rec.yStride, 16)
						if bestCost < 0 || cost < bestCost {
							bestCost = cost
							bestY = mode
						}
					}
					let bestUV = 0
					bestCost = -1
					for let (_, mode) in webpEncBlockModes {
						let pm = vp8EdgePred(mbx, mby, mode)
						vp8Predict8(ybr, pm, uAt)
						vp8Predict8(ybr, pm, vAt)
						let cost = webpBlockSSE(ybr, uAt, su, co, rec.cStride, 8) + webpBlockSSE(ybr, vAt, sv, co, rec.cStride, 8)
						if bestCost < 0 || cost < bestCost {
							bestCost = cost
							bestUV = mode
						}
					}
					yModes[m] = bestY
					uvModes[m] = bestUV
					vp8Predict16(ybr, vp8EdgePred(mbx, mby, bestY))
					let pm = vp8EdgePred(mbx, mby, bestUV)
					vp8Predict8(ybr, pm, uAt)
					vp8Predict8(ybr, pm, vAt)

					// Residuals, transforms and quantisation.
					for let j = 0; j < 16; j++ {
						for let i = 0; i < 16; i++ {
							res[j * 16 + i] = int(sy[yo + j * rec.yStride + i]) - ybr[yAt + j * 32 + i]
						}
					}
					for let j = 0; j < 8; j++ {
						for let i = 0; i < 8; i++ {
							resU[j * 8 + i] = int(su[co + j * rec.cStride + i]) - ybr[uAt + j * 32 + i]
							resV[j * 8 + i] = int(sv[co + j * rec.cStride + i]) - ybr[vAt + j * 32 + i]
						}
					}
					for let n = 0; n < 16; n++ {
						webpForwardDCT(res, (n >> 2) * 64 + (n & 3) * 4, 16, coeffs, 16 * n)
						dcs[n] = coeffs[16 * n]
					}
					for let n = 0; n < 4; n++ {
						webpForwardDCT(resU, (n >> 1) * 32 + (n & 1) * 4, 8, coeffs, 256 + 16 * n)
						webpForwardDCT(resV, (n >> 1) * 32 + (n & 1) * 4, 8, coeffs, 320 + 16 * n)
					}
					webpForwardWHT(dcs, coeffs, 384)

					let any = false
					for let k = 0; k < 400; k++ {
						let q = 0
						let bias = 6
						if k >= 384 {
							q = k == 384 ?? (y2dc, y2ac)
							bias = 8
						} else if k >= 256 {
							q = (k & 15) == 0 ?? (uvdc, uvac)
							bias = (k & 15) == 0 ?? (8, 6)
						} else {
							q = y1ac
						}
						let l = 0
						l = webpQuantize(coeffs[k], q, bias) unless k < 256 && (k & 15) == 0
						levels[k] = l
						rec.coeff[k] = l * q
						any = true when l != 0
					}

					// Reconstruct as the decoder will.
					rec.inverseWHT16()
					for let n = 0; n < 16; n++ {
						vp8InverseDCT4(ybr, yAt + (n >> 2) * 128 + (n & 3) * 4, rec.coeff, 16 * n)
					}
					vp8InverseDCT8(ybr, uAt, rec.coeff, 256, 15, 15)
					vp8InverseDCT8(ybr, vAt, rec.coeff, 320, 15, 15)
					for let j = 0; j < 16; j++ {
						for let i = 0; i < 16; i++ {
							rec.y[yo + j * rec.yStride + i] = byte(ybr[yAt + j * 32 + i])
						}
					}
					for let j = 0; j < 8; j++ {
						for let i = 0; i < 8; i++ {
							rec.u[co + j * rec.cStride + i] = byte(ybr[uAt + j * 32 + i])
							rec.v[co + j * rec.cStride + i] = byte(ybr[vAt + j * 32 + i])
						}
					}

					if !any {
						skips[m] = 1
						leftNz = 0
						upNz[mbx] = 0
						leftNzY16 = 0
						upNzY16[mbx] = 0
						continue
					}

					// Tokens, with the same neighbour contexts a decoder keeps.
					let nz = webpPutBlock(tok, probs, levels, 384, vp8PlaneY2, leftNzY16 + upNzY16[mbx], 0)
					leftNzY16 = nz
					upNzY16[mbx] = nz
					let lnz = leftNz & 15
					let unz = upNz[mbx] & 15
					for let j = 0; j < 4; j++ {
						let bnz = (lnz >> j) & 1
						for let i = 0; i < 4; i++ {
							bnz = webpPutBlock(tok, probs, levels, 16 * (j * 4 + i), vp8PlaneY1WithY2, bnz + ((unz >> i) & 1), 1)
							unz = (unz & (15 ^ (1 << i))) | (bnz << i)
						}
						lnz = (lnz & (15 ^ (1 << j))) | (bnz << j)
					}
					let lnzC = leftNz >> 4
					let unzC = upNz[mbx] >> 4
					let base = 256
					for let c = 0; c < 4; c += 2 {
						for let j = 0; j < 2; j++ {
							let bnz = (lnzC >> (j + c)) & 1
							for let i = 0; i < 2; i++ {
								bnz = webpPutBlock(tok, probs, levels, base, vp8PlaneUV, bnz + ((unzC >> (i + c)) & 1), 0)
								unzC = (unzC & (15 ^ (1 << (i + c)))) | (bnz << (i + c))
								base += 16
							}
							lnzC = (lnzC & (15 ^ (1 << (j + c)))) | (bnz << (j + c))
						}
					}
					leftNz = lnz | (lnzC << 4)
					upNz[mbx] = unz | (unzC << 4)
				}
			}

			webpTuneProbs(tok.stats, probs, updated) when pass == 0
		}

		// The first partition: frame header, then each macroblock's modes.
		let hdr = new WebpBoolEncoder()
		hdr.put(128, false)
		hdr.put(128, false)
		hdr.put(128, false)
		let level = vp8Clip(qi / 2, 0, 63)
		hdr.put(128, false)
		hdr.literal(level, 6)
		hdr.literal(0, 3)
		hdr.put(128, false)
		hdr.literal(0, 2)
		hdr.literal(qi, 7)
		for let i = 0; i < 5; i++ {
			hdr.put(128, false)
		}
		hdr.put(128, false)
		for let i = 0; i < 1056; i++ {
			hdr.put(vp8TokenUpdateProb[i], updated[i] == 1)
			hdr.literal(probs[i], 8) when updated[i] == 1
		}
		let skipped = 0
		for let (_, s) in skips {
			skipped += s
		}
		let skipProb = vp8Clip((mbCount - skipped) * 256 / mbCount, 1, 254)
		hdr.put(128, true)
		hdr.literal(skipProb, 8)
		for let m = 0; m < mbCount; m++ {
			hdr.put(skipProb, skips[m] == 1)
			hdr.put(145, true)
			let ym = yModes[m]
			if ym == vp8PredDC || ym == vp8PredVE {
				hdr.put(156, false)
				hdr.put(163, ym == vp8PredVE)
			} else {
				hdr.put(156, true)
				hdr.put(128, ym == vp8PredTM)
			}
			let cm = uvModes[m]
			hdr.put(142, cm != vp8PredDC)
			if cm != vp8PredDC {
				hdr.put(114, cm != vp8PredVE)
				hdr.put(183, cm == vp8PredTM) when cm != vp8PredVE
			}
		}
		let first = hdr.bytes()
		let tokens = tok.bytes()

		let out byte[]
		let tag = (first.len() << 5) | 0x10
		out.push(byte(tag & 255), byte((tag >> 8) & 255), byte((tag >> 16) & 255))
		out.push(byte(0x9d), byte(0x01), byte(0x2a))
		out.push(byte(w & 255), byte(w >> 8), byte(h & 255), byte(h >> 8))
		for let (_, b) in first {
			out.push(b)
		}
		for let (_, b) in tokens {
			out.push(b)
		}
		return out
	}

	// The ALPH chunk payload of an image: its alpha plane, losslessly
	// compressed.
	def webpEncodeAlpha(img Image) byte[] {
		let w = int(img.size().width)
		let h = int(img.size().height)
		let raw = img.raw()
		let argb = webpZeros(w * h)
		for let y = 0; y < h; y++ {
			let o = y * img.stride()
			for let x = 0; x < w; x++ {
				argb[y * w + x] = 0xff000000 | (int(raw[o + 4 * x + 3]) << 8)
			}
		}
		let out byte[]
		out.push(byte(1))
		for let (_, b) in webpEncodeArgb(argb, w, h, header = false, alpha = false) {
			out.push(b)
		}
		return out
	}
}
