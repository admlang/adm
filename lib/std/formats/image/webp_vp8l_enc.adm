internal partial module std.formats.image.webp {
	use (
		std.math
		std.formats.image::*
	)

	// Predictor modes the lossless encoder tries on each tile.
	const webpEncModes = int[1, 2, 3, 4, 7, 11, 12, 13]

	// Tile size of the encoder's predictor transform, as a power of two.
	const webpEncPredictorBits = 4

	// Longest backward reference the format can express.
	const webpMaxLength = 4096

	// Farthest backward reference the format can express.
	const webpMaxDistance = 1048456

	// WebpBitWriter packs a least-significant-bit-first stream.
	type WebpBitWriter {
		out   byte[]
		acc   int
		count int

		def new() {
			out = []
			acc = 0
			count = 0
		}

		// Appends the low `n` bits of `v`, at most 32.
		def put(v int, n int) {
			acc = acc | (v << count)
			count += n
			for count >= 8 {
				out.push(byte(acc & 255))
				acc = acc >> 8
				count -= 8
			}
		}

		// The stream so far, padded with zeros to a whole byte.
		def bytes() byte[] {
			if count > 0 {
				out.push(byte(acc & 255))
				acc = 0
				count = 0
			}
			return out
		}
	}

	// A prefix code ready to write symbols with: code lengths and the codes
	// bit-reversed for the stream. A code with a single symbol takes no bits.
	type WebpPrefixCode {
		lengths int[]
		codes   int[]
		single  bool

		def new(counts int[], n int, limit int) {
			lengths = webpHuffmanLengths(counts, n, limit)
			codes = webpZeros(n)
			let used = 0
			for let s = 0; s < n; s++ {
				used++ when lengths[s] > 0
			}
			single = used <= 1
			let hist = webpZeros(16)
			for let s = 0; s < n; s++ {
				hist[lengths[s]]++
			}
			let next = webpZeros(16)
			let code = 0
			for let l = 1; l < 16; l++ {
				code = (code + (l == 1 ?? (0, hist[l - 1]))) << 1
				next[l] = code
			}
			for let s = 0; s < n; s++ {
				let l = lengths[s]
				continue when l == 0
				codes[s] = webpReverseBits(next[l], l)
				next[l]++
			}
		}

		def emit(w WebpBitWriter, s int) {
			w.put(codes[s], lengths[s]) unless single
		}
	}

	// Code lengths of a Huffman code over `counts`, none longer than `limit`.
	// Rare symbols are made more frequent until the code fits. With one symbol
	// in use it gets length 1; with none every length is 0.
	def webpHuffmanLengths(counts int[], n int, limit int) int[] {
		let lengths = webpZeros(n)
		let syms int[]
		for let s = 0; s < n; s++ {
			syms.push(s) when counts[s] > 0
		}
		let m = syms.len()
		return lengths when m == 0
		if m == 1 {
			lengths[syms[0]] = 1
			return lengths
		}
		let floor = 1
		let weight = webpZeros(2 * m)
		let parent = webpZeros(2 * m)
		let heap = webpZeros(2 * m)
		let depth = webpZeros(2 * m)
		for {
			for let i = 0; i < m; i++ {
				let c = counts[syms[i]]
				weight[i] = c < floor ?? (floor, c)
			}
			let size = 0
			for let i = 0; i < m; i++ {
				size = webpHeapPush(heap, size, weight, i)
			}
			let next = m
			for size > 1 {
				let a = heap[0]
				size = webpHeapPop(heap, size, weight)
				let b = heap[0]
				size = webpHeapPop(heap, size, weight)
				weight[next] = weight[a] + weight[b]
				parent[a] = next
				parent[b] = next
				size = webpHeapPush(heap, size, weight, next)
				next++
			}
			let root = next - 1
			depth[root] = 0
			let longest = 0
			for let i = root - 1; i >= 0; i-- {
				depth[i] = depth[parent[i]] + 1
				longest = depth[i] when i < m && depth[i] > longest
			}
			if longest <= limit {
				for let i = 0; i < m; i++ {
					lengths[syms[i]] = depth[i]
				}
				return lengths
			}
			floor = floor * 2
		}
		return lengths
	}

	// Pushes node `v` on a min-heap of node indices ordered by `weight`, ties
	// by index. Returns the new size.
	def webpHeapPush(heap int[], size int, weight int[], v int) int {
		let i = size
		heap[i] = v
		for i > 0 {
			let p = (i - 1) >> 1
			break unless webpHeapLess(weight, heap[i], heap[p])
			let t = heap[p]
			heap[p] = heap[i]
			heap[i] = t
			i = p
		}
		return size + 1
	}

	// Removes the smallest node of the heap. Returns the new size.
	def webpHeapPop(heap int[], size int, weight int[]) int {
		let n = size - 1
		heap[0] = heap[n]
		let i = 0
		for {
			let l = 2 * i + 1
			break when l >= n
			let c = l
			c = l + 1 when l + 1 < n && webpHeapLess(weight, heap[l + 1], heap[l])
			break unless webpHeapLess(weight, heap[c], heap[i])
			let t = heap[c]
			heap[c] = heap[i]
			heap[i] = t
			i = c
		}
		return n
	}

	def webpHeapLess(weight int[], a int, b int) bool {
		return weight[a] < weight[b] || (weight[a] == weight[b] && a < b)
	}

	// Writes the code lengths of `code` in the form a decoder reads them.
	def webpWriteCode(w WebpBitWriter, code WebpPrefixCode, n int) {
		let syms int[]
		for let s = 0; s < n; s++ {
			syms.push(s) when code.lengths[s] > 0
		}
		if syms.len() == 0 || (syms.len() <= 2 && syms[syms.len() - 1] < 256) {
			// Simple code: one or two symbols below 256.
			w.put(1, 1)
			let first = syms.len() == 0 ?? (0, syms[0])
			w.put(syms.len() == 2 ?? (1, 0), 1)
			if first < 2 {
				w.put(0, 1)
				w.put(first, 1)
			} else {
				w.put(1, 1)
				w.put(first, 8)
			}
			w.put(syms[1], 8) when syms.len() == 2
			return
		}

		w.put(0, 1)
		// Run-length tokens: 0..15 a length, 16 repeats the previous non-zero
		// length 3..6 times, 17 and 18 are runs of 3..10 and 11..138 zeros.
		let tokens int[]
		let extras int[]
		let prev = -1
		let i = 0
		for i < n {
			let l = code.lengths[i]
			let run = 1
			for i + run < n && code.lengths[i + run] == l {
				run++
			}
			if l == 0 && run >= 3 {
				let r = run > 138 ?? (138, run)
				if r >= 11 {
					tokens.push(18)
					extras.push(r - 11)
				} else {
					tokens.push(17)
					extras.push(r - 3)
				}
				i += r
				continue
			}
			if l != 0 && l == prev && run >= 3 {
				let r = run > 6 ?? (6, run)
				tokens.push(16)
				extras.push(r - 3)
				i += r
				continue
			}
			tokens.push(l)
			extras.push(0)
			prev = l when l != 0
			i++
		}

		let hist = webpZeros(19)
		for let (_, t) in tokens {
			hist[t]++
		}
		let lenCode = new WebpPrefixCode(hist, 19, 7)
		let count = 19
		for count > 4 && lenCode.lengths[webpCodeLengthOrder[count - 1]] == 0 {
			count--
		}
		w.put(count - 4, 4)
		for let k = 0; k < count; k++ {
			w.put(lenCode.lengths[webpCodeLengthOrder[k]], 3)
		}
		w.put(0, 1)
		for let k = 0; k < tokens.len(); k++ {
			let t = tokens[k]
			lenCode.emit(w, t)
			if t == 16 {
				w.put(extras[k], 2)
			} else if t == 17 {
				w.put(extras[k], 3)
			} else if t == 18 {
				w.put(extras[k], 7)
			}
		}
	}

	// The prefix symbol of a length or distance, with its extra bits and their
	// count packed as `symbol | extraBits << 8 | extraValue << 16`.
	def webpPrefixOf(value int) int {
		let v = value - 1
		return v when v < 4
		let hi = 0
		for (v >> (hi + 1)) != 0 {
			hi++
		}
		let second = (v >> (hi - 1)) & 1
		let extra = hi - 1
		let sym = 2 * hi + second
		return sym | (extra << 8) | ((v & ((1 << extra) - 1)) << 16)
	}

	// Plane codes by `dy << 4 | (8 - dx)`, the inverse of the distance map;
	// -1 where the offset has no short code.
	def webpPlaneCodes() int[] {
		let lut = webpZeros(128)
		lut.fill(-1)
		for let i = 0; i < 120; i++ {
			lut[webpDistanceMap[i]] = i
		}
		return lut
	}

	// The distance code of a backward reference `dist` pixels back in an image
	// `w` pixels wide.
	def webpDistanceCode(lut int[], w int, dist int) int {
		let dy = dist / w
		let dx = dist - dy * w
		if dx <= 8 && dy < 8 {
			let c = lut[dy * 16 + 8 - dx]
			return c + 1 when c >= 0
		} else if dx > w - 8 && dy < 7 {
			let c = lut[(dy + 1) * 16 + 8 + (w - dx)]
			return c + 1 when c >= 0
		}
		return dist + 120
	}

	// The colour cache slot of a pixel.
	def webpCacheKey(argb int, bits int) int {
		return ((argb * 0x1e35a7bd) & 0xffffffff) >> (32 - bits)
	}

	// Parses `argb` into literals and backward references: `lens[i]` is 0 for
	// a literal at pixel `i`, else the reference length, with `dists[i]` its
	// distance in pixels. Returns the number of tokens.
	def webpBackwardRefs(argb int[], w int, lens int[], dists int[]) int {
		let n = argb.len()
		let hashBits = 18
		let hashShift = 32 - hashBits
		let head = webpZeros(1 << hashBits)
		head.fill(-1)
		let chain = webpZeros(n)
		let tokens = 0
		let i = 0
		for i < n {
			let bestLen = 0
			let bestDist = 0
			let maxLen = n - i
			maxLen = webpMaxLength when maxLen > webpMaxLength
			if maxLen >= 3 {
				// The pixel to the left and the one above first: runs and
				// repeated rows are the common matches.
				let cand = i - 1
				for let k = 0; k < 2; k++ {
					let d = i - cand
					if cand >= 0 && d > 0 && argb[cand] == argb[i] {
						let l = webpMatchLength(argb, cand, i, maxLen)
						if l > bestLen {
							bestLen = l
							bestDist = d
						}
					}
					cand = i - w
				}
				let h = (((argb[i] * 0x9e3779b1) + (argb[i + 1] * 0x85ebca6b)) & 0xffffffff) >> hashShift
				let c = head[h]
				let tries = 8
				for c >= 0 && tries > 0 && bestLen < maxLen && bestLen < 256 {
					let d = i - c
					break when d > webpMaxDistance
					if argb[c + bestLen] == argb[i + bestLen] {
						let l = webpMatchLength(argb, c, i, maxLen)
						if l > bestLen {
							bestLen = l
							bestDist = d
						}
					}
					c = chain[c]
					tries--
				}
			}
			let step = 1
			if bestLen >= 3 {
				lens[tokens] = bestLen
				dists[tokens] = bestDist
				step = bestLen
			} else {
				lens[tokens] = 0
				dists[tokens] = i
			}
			tokens++
			let stop = i + step
			for i < stop {
				if i + 1 < n {
					let h = (((argb[i] * 0x9e3779b1) + (argb[i + 1] * 0x85ebca6b)) & 0xffffffff) >> hashShift
					chain[i] = head[h]
					head[h] = i
				}
				i++
			}
		}
		return tokens
	}

	// How many pixels from `src` repeat those from `at`, up to `max`.
	def webpMatchLength(argb int[], src int, at int, max int) int {
		let l = 0
		for l < max && argb[src + l] == argb[at + l] {
			l++
		}
		return l
	}

	// Estimated size in bits of symbols with the counts `h`, entropy alone.
	def webpEntropy(h int[]) float {
		let total = 0
		for let (_, c) in h {
			total += c
		}
		return 0.0 when total == 0
		let bits = 0.0
		let lt = math.ln(float(total))
		for let (_, c) in h {
			bits += float(c) * (lt - math.ln(float(c))) when c > 0
		}
		return bits / math.ln(2.0)
	}

	// Writes one entropy-coded image: colour cache choice, (for the main
	// image) no meta prefix codes, the five prefix codes and the pixels.
	def webpWriteImage(w WebpBitWriter, argb int[], width int, top bool) {
		let n = argb.len()
		let lens = webpZeros(n)
		let dists = webpZeros(n)
		let tokens = webpBackwardRefs(argb, width, lens, dists)
		let lut = webpPlaneCodes()
		// Distance codes once, shared by every cache size tried.
		let dcodes = webpZeros(tokens)
		for let t = 0; t < tokens; t++ {
			dcodes[t] = webpDistanceCode(lut, width, dists[t]) when lens[t] > 0
		}

		let bestBits = 0
		let bestCost = 0.0
		let sizes = int[0, 4, 7, 10]
		for let (k, bits) in sizes {
			continue when bits > 0 && n < 64
			let cost = webpTokenCost(argb, lens, dcodes, tokens, bits)
			if k == 0 || cost < bestCost {
				bestCost = cost
				bestBits = bits
			}
		}

		let cacheSize = bestBits > 0 ?? (1 << bestBits, 0)
		let greens = 280 + cacheSize
		let hg = webpZeros(greens)
		let hr = webpZeros(256)
		let hb = webpZeros(256)
		let ha = webpZeros(256)
		let hd = webpZeros(40)
		webpHistograms(argb, lens, dcodes, tokens, bestBits, hg, hr, hb, ha, hd)

		if bestBits > 0 {
			w.put(1, 1)
			w.put(bestBits, 4)
		} else {
			w.put(0, 1)
		}
		w.put(0, 1) when top
		let cg = new WebpPrefixCode(hg, greens, 15)
		let cr = new WebpPrefixCode(hr, 256, 15)
		let cb = new WebpPrefixCode(hb, 256, 15)
		let ca = new WebpPrefixCode(ha, 256, 15)
		let cd = new WebpPrefixCode(hd, 40, 15)
		webpWriteCode(w, cg, greens)
		webpWriteCode(w, cr, 256)
		webpWriteCode(w, cb, 256)
		webpWriteCode(w, ca, 256)
		webpWriteCode(w, cd, 40)

		let cache = webpZeros(cacheSize)
		cache.fill(-1)
		let p = 0
		for let t = 0; t < tokens; t++ {
			let l = lens[t]
			if l == 0 {
				let px = argb[p]
				let key = bestBits > 0 ?? (webpCacheKey(px, bestBits), 0)
				if bestBits > 0 && cache[key] == px {
					cg.emit(w, 280 + key)
				} else {
					cg.emit(w, (px >> 8) & 255)
					cr.emit(w, (px >> 16) & 255)
					cb.emit(w, px & 255)
					ca.emit(w, (px >> 24) & 255)
				}
				cache[key] = px when bestBits > 0
				p++
				continue
			}
			let ls = webpPrefixOf(l)
			cg.emit(w, 256 + (ls & 255))
			w.put(ls >> 16, (ls >> 8) & 255)
			let ds = webpPrefixOf(dcodes[t])
			cd.emit(w, ds & 255)
			w.put(ds >> 16, (ds >> 8) & 255)
			if bestBits > 0 {
				for let k = 0; k < l; k++ {
					let px = argb[p + k]
					cache[webpCacheKey(px, bestBits)] = px
				}
			}
			p += l
		}
	}

	// Fills the five histograms of a token stream coded with a colour cache
	// of `bits` (0 for none).
	def webpHistograms(argb int[], lens int[], dcodes int[], tokens int, bits int, hg int[], hr int[], hb int[], ha int[], hd int[]) {
		let cache = webpZeros(bits > 0 ?? (1 << bits, 0))
		cache.fill(-1)
		let p = 0
		for let t = 0; t < tokens; t++ {
			let l = lens[t]
			if l == 0 {
				let px = argb[p]
				if bits > 0 {
					let key = webpCacheKey(px, bits)
					if cache[key] == px {
						hg[280 + key]++
						p++
						continue
					}
					cache[key] = px
				}
				hg[(px >> 8) & 255]++
				hr[(px >> 16) & 255]++
				hb[px & 255]++
				ha[(px >> 24) & 255]++
				p++
				continue
			}
			hg[256 + (webpPrefixOf(l) & 255)]++
			hd[webpPrefixOf(dcodes[t]) & 255]++
			if bits > 0 {
				for let k = 0; k < l; k++ {
					let px = argb[p + k]
					cache[webpCacheKey(px, bits)] = px
				}
			}
			p += l
		}
	}

	// Estimated bits of a token stream with a colour cache of `bits`.
	def webpTokenCost(argb int[], lens int[], dcodes int[], tokens int, bits int) float {
		let hg = webpZeros(280 + (bits > 0 ?? (1 << bits, 0)))
		let hr = webpZeros(256)
		let hb = webpZeros(256)
		let ha = webpZeros(256)
		let hd = webpZeros(40)
		webpHistograms(argb, lens, dcodes, tokens, bits, hg, hr, hb, ha, hd)
		// Code lengths cost roughly a few bits per symbol in use.
		let used = 0
		for let (_, c) in hg {
			used++ when c > 0
		}
		return webpEntropy(hg) + webpEntropy(hr) + webpEntropy(hb) + webpEntropy(ha) + webpEntropy(hd) + float(used * 4)
	}

	// Per-channel difference `a - b` of two ARGB values, each wrapping.
	def webpSubPixels(a int, b int) int {
		let ag = (0x00ff00ff + (a & 0xff00ff00) - (b & 0xff00ff00)) & 0xff00ff00
		let rb = (0xff00ff00 + (a & 0x00ff00ff) - (b & 0x00ff00ff)) & 0x00ff00ff
		return ag | rb
	}

	def webpAverage2(a int, b int) int {
		return (((a ^ b) & 0xfefefefe) >> 1) + (a & b)
	}

	// Per-channel `a + b - c`, clamped to 0..255.
	def webpClampAddSubFull(a int, b int, c int) int {
		let out = 0
		for let s = 0; s < 32; s += 8 {
			let v = webpClamp255(((a >> s) & 255) + ((b >> s) & 255) - ((c >> s) & 255))
			out = out | (v << s)
		}
		return out
	}

	// Per-channel `a + (a - b) / 2`, clamped to 0..255.
	def webpClampAddSubHalf(a int, b int) int {
		let out = 0
		for let s = 0; s < 32; s += 8 {
			let x = (a >> s) & 255
			let v = webpClamp255(x + (x - ((b >> s) & 255)) / 2)
			out = out | (v << s)
		}
		return out
	}

	// The left or top pixel, whichever the gradient between them and the
	// top-left favours.
	def webpSelect(t int, l int, tl int) int {
		let diff = 0
		for let s = 0; s < 32; s += 8 {
			let c = (tl >> s) & 255
			diff += webpAbs(((l >> s) & 255) - c) - webpAbs(((t >> s) & 255) - c)
		}
		return diff <= 0 ?? (t, l)
	}

	// The prediction of pixel `i` (not on the top row or left column) under
	// `mode`.
	def webpPredictPixel(argb int[], i int, w int, mode int) int {
		let l = argb[i - 1]
		let t = argb[i - w]
		if mode == 1 {
			return l
		} else if mode == 2 {
			return t
		} else if mode == 3 {
			return argb[i - w + 1]
		} else if mode == 4 {
			return argb[i - w - 1]
		} else if mode == 5 {
			return webpAverage2(webpAverage2(l, argb[i - w + 1]), t)
		} else if mode == 6 {
			return webpAverage2(l, argb[i - w - 1])
		} else if mode == 7 {
			return webpAverage2(l, t)
		} else if mode == 8 {
			return webpAverage2(argb[i - w - 1], t)
		} else if mode == 9 {
			return webpAverage2(t, argb[i - w + 1])
		} else if mode == 10 {
			return webpAverage2(webpAverage2(l, argb[i - w - 1]), webpAverage2(t, argb[i - w + 1]))
		} else if mode == 11 {
			return webpSelect(t, l, argb[i - w - 1])
		} else if mode == 12 {
			return webpClampAddSubFull(l, t, argb[i - w - 1])
		} else if mode == 13 {
			return webpClampAddSubHalf(webpAverage2(l, t), argb[i - w - 1])
		}
		return 0xff000000
	}

	// Applies the predictor transform: picks a mode per tile, writes the
	// tile modes as a sub-image and returns the residuals.
	def webpForwardPredict(w WebpBitWriter, argb int[], width int, height int) int[] {
		let bits = webpEncPredictorBits
		let tw = webpTiles(width, bits)
		let th = webpTiles(height, bits)
		let modes = webpZeros(tw * th)
		for let ty = 0; ty < th; ty++ {
			for let tx = 0; tx < tw; tx++ {
				let x0 = tx << bits
				let y0 = ty << bits
				let x1 = x0 + (1 << bits)
				let y1 = y0 + (1 << bits)
				x1 = width when x1 > width
				y1 = height when y1 > height
				x0 = 1 when x0 == 0
				y0 = 1 when y0 == 0
				let best = 1
				let bestCost = -1
				for let (_, mode) in webpEncModes {
					// Every other row is enough to rank the modes.
					let cost = 0
					for let y = y0; y < y1; y += 2 {
						for let x = x0; x < x1; x++ {
							let i = y * width + x
							let px = argb[i]
							let pred = webpPredictPixel(argb, i, width, mode)
							for let sh = 0; sh < 32; sh += 8 {
								let d = (((px >> sh) & 255) - ((pred >> sh) & 255)) & 255
								cost += d >= 128 ?? (256 - d, d)
							}
						}
					}
					if bestCost < 0 || cost < bestCost {
						bestCost = cost
						best = mode
					}
				}
				modes[ty * tw + tx] = 0xff000000 | (best << 8)
			}
		}

		w.put(1, 1)
		w.put(0, 2)
		w.put(bits - 2, 3)
		webpWriteImage(w, modes, tw, false)

		let res = webpZeros(argb.len())
		for let y = 0; y < height; y++ {
			for let x = 0; x < width; x++ {
				let i = y * width + x
				let pred = 0xff000000
				if y == 0 {
					pred = x == 0 ?? (0xff000000, argb[i - 1])
				} else if x == 0 {
					pred = argb[i - width]
				} else {
					pred = webpPredictPixel(argb, i, width, (modes[(y >> bits) * tw + (x >> bits)] >> 8) & 15)
				}
				res[i] = webpSubPixels(argb[i], pred)
			}
		}
		return res
	}

	// Encodes an image as a lossless (VP8L) bit stream, without the chunk
	// header.
	def webpEncodeLossless(img Image) byte[] {
		let width = int(img.size().width)
		let height = int(img.size().height)
		let raw = img.raw()
		let stride = img.stride()
		let n = width * height
		let argb = webpZeros(n)
		let alpha = false
		for let y = 0; y < height; y++ {
			let o = y * stride
			for let x = 0; x < width; x++ {
				let a = int(raw[o + 3])
				alpha = true when a != 255
				argb[y * width + x] = (a << 24) | (int(raw[o]) << 16) | (int(raw[o + 1]) << 8) | int(raw[o + 2])
				o += 4
			}
		}

		return webpEncodeArgb(argb, width, height, true, alpha)
	}

	// Encodes ARGB pixels as a lossless bit stream; `header` adds the VP8L
	// signature and size, which an ALPH chunk's stream goes without.
	def webpEncodeArgb(argb int[], width int, height int, header bool, alpha bool) byte[] {
		let n = width * height
		let w = new WebpBitWriter()
		if header {
			w.put(0x2f, 8)
			w.put(width - 1, 14)
			w.put(height - 1, 14)
			w.put(alpha ?? (1, 0), 1)
			w.put(0, 3)
		}

		let palette = webpPaletteOf(argb)
		if palette.len() > 0 {
			let count = palette.len()
			let bits = count > 16 ?? (0, count > 4 ?? (1, count > 2 ?? (2, 3)))
			w.put(1, 1)
			w.put(3, 2)
			w.put(count - 1, 8)
			let delta = webpZeros(count)
			for let i = 0; i < count; i++ {
				delta[i] = i == 0 ?? (palette[0], webpSubPixels(palette[i], palette[i - 1]))
			}
			webpWriteImage(w, delta, count, false)
			w.put(0, 1)

			let packedW = webpTiles(width, bits)
			let packed = webpZeros(packedW * height)
			let perPixel = 8 >> bits
			let index = webpPaletteIndex(palette)
			for let y = 0; y < height; y++ {
				for let x = 0; x < width; x++ {
					let k = webpPaletteLookup(index, argb[y * width + x])
					let at = y * packedW + (x >> bits)
					packed[at] = packed[at] | (k << (perPixel * (x & ((1 << bits) - 1))))
				}
			}
			for let i = 0; i < packed.len(); i++ {
				packed[i] = 0xff000000 | (packed[i] << 8)
			}
			webpWriteImage(w, packed, packedW, true)
			return w.bytes()
		}

		// Subtract green, then predict.
		w.put(1, 1)
		w.put(2, 2)
		for let i = 0; i < n; i++ {
			let p = argb[i]
			let g = (p >> 8) & 255
			let r = (((p >> 16) & 255) - g) & 255
			let b = ((p & 255) - g) & 255
			argb[i] = (p & 0xff00ff00) | (r << 16) | b
		}
		let res = webpForwardPredict(w, argb, width, height)
		w.put(0, 1)
		webpWriteImage(w, res, width, true)
		return w.bytes()
	}

	// The distinct colours of the image in ascending order when there are at
	// most 256 of them, else an empty list.
	def webpPaletteOf(argb int[]) int[] {
		let seen = webpZeros(1024)
		seen.fill(-1)
		let colors int[]
		for let (_, p) in argb {
			let h = webpCacheKey(p, 10)
			let found = false
			for seen[h] != -1 {
				if seen[h] == p {
					found = true
					break
				}
				h = (h + 1) & 1023
			}
			continue when found
			return [] when colors.len() == 256
			seen[h] = p
			colors.push(p)
		}
		return colors.sort((a, b) => a < b)
	}

	// A lookup table from colour to palette index: open addressing over 1024
	// slots, colour and index side by side.
	def webpPaletteIndex(palette int[]) int[] {
		let table = webpZeros(2048)
		table.fill(-1)
		for let (i, p) in palette {
			let h = webpCacheKey(p, 10)
			for table[2 * h] != -1 {
				h = (h + 1) & 1023
			}
			table[2 * h] = p
			table[2 * h + 1] = i
		}
		return table
	}

	def webpPaletteLookup(table int[], p int) int {
		let h = webpCacheKey(p, 10)
		for table[2 * h] != p {
			h = (h + 1) & 1023
		}
		return table[2 * h + 1]
	}
}
