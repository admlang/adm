partial module std.formats.image {
	use (
		std.io
		std.bytes
		std.math.geom
		std.gfx.color
		std.formats.image.xpm::*
	)

	// XPM is the X PixMap (XPM3) codec: the image as C source, one string per
	// row, each pixel spelled with a fixed number of characters defined by a
	// colour table. Colours may be `None` (transparent), #RGB, #RRGGBB,
	// #RRRGGGBBB or #RRRRGGGGBBBB, or X11 colour names; the `c` (colour) key is
	// used, else `g`, `g4` or `m`. Encoding writes a palette of the image's
	// colours with `None` for pixels under half opacity, since XPM holds no
	// partial alpha.
	@codec("X PixMap")
	type XPM {
		mimeType string[] {
			def get() string[] {
				return string["image/x-xpixmap", "image/x-xpm"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".xpm"]
			}
		}

		// matchSignature reports whether the reader starts with the `/* XPM */`
		// comment, after any leading white space.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(64)
			let n = r.read(b) onerror recover 0
			let i = 0
			for i < n && (b[i] == byte(' ') || b[i] == byte('\t') || b[i] == byte('\r') || b[i] == byte('\n')) {
				i++
			}
			return false when i + 9 > n
			return string(b[i:i + 9]) == "/* XPM */"
		}

		// info reads the image's dimensions from the bytes. Fails when they are not
		// XPM source.
		def info(data byte[]) !ImageInfo {
			let strs = try xpmStrings(data, 1)
			let (w, h, _, _) = try xpmValues(data, strs[0], strs[1])
			return ImageInfo{
				size: new geom.Size(float(w), float(h)),
				colorFormat: color.ColorFormat.Palette,
			}
		}

		// info reads the image's dimensions from the reader. Fails when the data is
		// not XPM source, or the reader does.
		def info(reader io.Reader) !ImageInfo {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return info(buf.bytes())
		}

		// decode reads an XPM image from the bytes. Fails when they are not XPM3
		// source, a colour is not one it knows, or a row is short.
		def decode(data byte[]) !Image {
			let head = try xpmStrings(data, 1)
			let (w, h, ncolors, cpp) = try xpmValues(data, head[0], head[1])
			fail "xpm: bad characters per pixel {cpp}" when cpp < 1 || cpp > 4
			fail "xpm: bad colour count {ncolors}" when ncolors < 1
			const maxPixels = 256 * 1024 * 1024
			fail "xpm: image too large" when w > maxPixels / h

			let strs = try xpmStrings(data, 1 + ncolors + h)
			let colors byte[]
			colors.len(ncolors * 4)
			// Pixel keys to colour index: a table for 1 or 2 characters, a map beyond.
			let lut int[]
			let keyed = new map<int, int>()
			lut.len(cpp == 1 ?? (256, 65536)) when cpp <= 2
			lut.fill(-1) when cpp <= 2

			for let i = 0; i < ncolors; i++ {
				let s = strs[2 + 2 * i]
				let e = strs[3 + 2 * i]
				fail "xpm: colour line {i + 1} is too short" when e - s < cpp
				let key = xpmKey(data, s, cpp)
				let rgba = try xpmColor(string(data[s + cpp:e]))
				colors[i * 4] = byte((rgba >> 24) & 0xFF)
				colors[i * 4 + 1] = byte((rgba >> 16) & 0xFF)
				colors[i * 4 + 2] = byte((rgba >> 8) & 0xFF)
				colors[i * 4 + 3] = byte(rgba & 0xFF)
				if cpp <= 2 {
					lut[key] = i
				} else {
					keyed.set(key, i)
				}
			}

			let img = new Image(w, h)
			let px = img.raw()
			let stride = img.stride()
			for let y = 0; y < h; y++ {
				let k = 1 + ncolors + y
				let s = strs[2 * k]
				fail "xpm: row {y + 1} is short" when strs[2 * k + 1] - s < w * cpp
				let d = y * stride
				for let x = 0; x < w; x++ {
					let key = xpmKey(data, s, cpp)
					let idx = -1
					if cpp <= 2 {
						idx = lut[key]
					} else {
						let found = keyed.get(key)
						idx = found when found is int
					}
					fail "xpm: undefined pixel in row {y + 1}" when idx < 0
					px[d] = colors[idx * 4]
					px[d + 1] = colors[idx * 4 + 1]
					px[d + 2] = colors[idx * 4 + 2]
					px[d + 3] = colors[idx * 4 + 3]
					s += cpp
					d += 4
				}
			}
			return img
		}

		// decode reads an XPM image from the reader. Fails when the data is not
		// XPM3 source the codec understands, or the reader does.
		def decode(reader io.Reader) !Image {
			let buf = new bytes.Buffer()
			try buf.readFrom(reader)
			return decode(buf.bytes())
		}

		// encode renders the image as XPM3 source with a palette of its colours:
		// #RRGGBB for pixels at least half opaque, `None` for the rest. It cannot
		// fail; the error type comes from the writer overload.
		def encode(img Image) !byte[] {
			let out = new bytes.Buffer()
			try encode(img, out)
			return out.bytes()
		}

		// encode writes the image as XPM3 source to the writer; see the byte
		// overload. Fails with the writer's error.
		def encode(img Image, writer io.Writer) !none {
			let w = int(img.size().width)
			let h = int(img.size().height)
			let px = img.raw()
			let stride = img.stride()

			// Palette index per pixel, keyed on 0xRRGGBB or -1 for transparent.
			let index = new map<int, int>()
			let keys int[]
			let pix int[]
			pix.len(w * h)
			for let y = 0; y < h; y++ {
				let o = y * stride
				for let x = 0; x < w; x++ {
					let key = -1
					key = int(px[o]) << 16 | int(px[o + 1]) << 8 | int(px[o + 2]) when px[o + 3] >= 128
					let found = index.get(key)
					let i = 0
					if found is int {
						i = found
					} else {
						i = keys.len()
						index.set(key, i)
						keys.push(key)
					}
					pix[y * w + x] = i
					o += 4
				}
			}

			let alphabet = xpmAlphabet.bytes()
			let base = alphabet.len()
			let n = keys.len()
			n = 1 when n == 0
			let cpp = 1
			let span = base
			for span < n {
				cpp++
				span *= base
			}

			let head = "/* XPM */\nstatic char *image[] = {\n/* columns rows colors chars-per-pixel */\n\"{w} {h} {keys.len()} {cpp} \",\n".bytes()
			let size = head.len() + keys.len() * (cpp + 16) + h * (w * cpp + 4) + 4
			let out byte[]
			out.len(size)
			let o = 0
			for let i = 0; i < head.len(); i++ {
				out[o + i] = head[i]
			}
			o += head.len()

			let hex = "0123456789ABCDEF".bytes()
			for let (i, key) in keys {
				out[o] = byte('"')
				o = xpmPutCode(out, o + 1, i, cpp, alphabet)
				out[o] = byte(' ')
				out[o + 1] = byte('c')
				out[o + 2] = byte(' ')
				o += 3
				if key < 0 {
					let word = "None".bytes()
					for let j = 0; j < 4; j++ {
						out[o + j] = word[j]
					}
					o += 4
				} else {
					out[o] = byte('#')
					for let j = 0; j < 6; j++ {
						out[o + 1 + j] = hex[(key >> (20 - 4 * j)) & 0xF]
					}
					o += 7
				}
				out[o] = byte('"')
				out[o + 1] = byte(',')
				out[o + 2] = byte('\n')
				o += 3
			}
			for let y = 0; y < h; y++ {
				out[o] = byte('"')
				o++
				for let x = 0; x < w; x++ {
					o = xpmPutCode(out, o, pix[y * w + x], cpp, alphabet)
				}
				out[o] = byte('"')
				o++
				if y + 1 < h {
					out[o] = byte(',')
					o++
				}
				out[o] = byte('\n')
				o++
			}
			out[o] = byte('}')
			out[o + 1] = byte(';')
			out[o + 2] = byte('\n')
			o += 3
			try writer.write(out[0:o])
		}
	}
}

internal partial module std.formats.image.xpm {
	use std.gfx.color

	// Characters an encoded pixel is spelled with: printable ASCII without the
	// quote and backslash, which C strings would have to escape.
	const xpmAlphabet = " .XoO+@#$%&*=-;:>,<1234567890qwertyuipasdfghjklzxcvbnmMNBVCZASDFGHJKLPIUYTREWQ!~^/()_`'][{}|"

	// X11 colour names XPM files use whose value differs from the CSS name of
	// the same spelling, or that CSS lacks; 0xRRGGBB. Everything else falls back
	// to the CSS table, and grayN/greyN (0-100) and the 1-4 shades of the primary
	// colours are computed.
	const xpmX11Colors = map<string, int>{
		"gray":              0xBEBEBE,
		"grey":              0xBEBEBE,
		"green":             0x00FF00,
		"maroon":            0xB03060,
		"purple":            0xA020F0,
		"navyblue":          0x000080,
		"lightgoldenrod":    0xEEDD82,
		"violetred":         0xD02090,
		"lightslateblue":    0x8470FF,
		"webgray":           0x808080,
		"webgrey":           0x808080,
		"webgreen":          0x008000,
		"webmaroon":         0x800000,
		"webpurple":         0x800080,
		"x11gray":           0xBEBEBE,
		"x11grey":           0xBEBEBE,
		"x11green":          0x00FF00,
		"x11maroon":         0xB03060,
		"x11purple":         0xA020F0,
		"backgroundcolor":   0xC0C0C0,
		"foregroundcolor":   0x000000,
	}

	// Writes palette index `i` as `cpp` alphabet characters at `o`; returns the
	// next offset.
	def xpmPutCode(out byte[], o int, i int, cpp int, alphabet byte[]) int {
		let v = i
		for let j = 0; j < cpp; j++ {
			out[o + j] = alphabet[v % alphabet.len()]
			v /= alphabet.len()
		}
		return o + cpp
	}

	// The pixel key of the `cpp` characters at `s`.
	def xpmKey(data byte[], s int, cpp int) int {
		let k = 0
		for let i = 0; i < cpp; i++ {
			k = k << 8 | int(data[s + i])
		}
		return k
	}

	// The start and end offsets of the first `want` C string literals in the
	// source, flattened, skipping comments. Fails when there are fewer.
	def xpmStrings(data byte[], want int) !int[] {
		let out int[]
		out.cap(want * 2)
		let n = data.len()
		let i = 0
		for i < n && out.len() < want * 2 {
			let c = data[i]
			if c == byte('/') && i + 1 < n && data[i + 1] == byte('*') {
				i += 2
				for i + 1 < n && !(data[i] == byte('*') && data[i + 1] == byte('/')) {
					i++
				}
				i += 2
				continue
			}
			if c == byte('/') && i + 1 < n && data[i + 1] == byte('/') {
				for i < n && data[i] != byte('\n') {
					i++
				}
				continue
			}
			if c == byte('"') {
				let s = i + 1
				i = s
				for i < n && data[i] != byte('"') {
					i++ when data[i] == byte('\\')
					i++
				}
				fail "xpm: unterminated string" when i >= n
				out.push(s, i)
			}
			i++
		}
		fail "xpm: not an XPM3 image" when out.len() == 0
		fail "xpm: truncated, {want} strings expected, {out.len() / 2} found" when out.len() < want * 2
		return out
	}

	// The width, height, colour count and characters per pixel from the values
	// string.
	def xpmValues(data byte[], s int, e int) !(int, int, int, int) {
		let fields = xpmFields(string(data[s:e]))
		fail "xpm: bad values line" when fields.len() < 4
		let w = fields[0].toInt<int>()
		let h = fields[1].toInt<int>()
		let nc = fields[2].toInt<int>()
		let cpp = fields[3].toInt<int>()
		fail "xpm: bad size {w}x{h}" when w <= 0 || h <= 0
		return (w, h, nc, cpp)
	}

	// The colour a colour-table entry (after the pixel characters) defines, as
	// 0xRRGGBBAA. Takes the `c` key, else `g`, `g4` or `m`.
	def xpmColor(spec string) !int {
		let words = xpmFields(spec)
		let keys = string["c", "g", "g4", "m"]
		for let (_, want) in keys {
			let value string[]
			let found = false
			for let (_, word) in words {
				if word := "c" || "g" || "g4" || "m" || "s" {
					break when found
					found = word == want
					continue
				}
				value.push(word) when found
			}
			continue unless found && value.len() > 0
			return xpmParseColor(value.join(" "))
		}
		fail "xpm: colour entry \"{spec.trim()}\" has no colour"
	}

	// The white-space separated fields of a string.
	def xpmFields(s string) string[] {
		let out string[]
		for let (_, f) in s.replace("\t", " ").split(" ") {
			out.push(f) when f != ""
		}
		return out
	}

	// Parses None, a #hex colour or an X11 colour name into 0xRRGGBBAA.
	def xpmParseColor(value string) !int {
		let v = value.lower()
		return 0 when v == "none"
		if v.startsWith("#") {
			let digits = v.slice(1)
			let n = digits.len()
			fail "xpm: bad colour \"{value}\"" unless n := 3 || 6 || 9 || 12
			fail "xpm: bad colour \"{value}\"" unless digits.isHexadecimal()
			let k = n / 3
			let max = (1 << (4 * k)) - 1
			let rgb = 0
			for let i = 0; i < 3; i++ {
				let c = digits.slice(i * k, i * k + k).toInt<int>(16)
				rgb = rgb << 8 | (c * 255 + max / 2) / max
			}
			return rgb << 8 | 0xFF
		}
		let name = v.replace(" ", "")
		let x11 = xpmX11Colors.get(name)
		return x11 << 8 | 0xFF when x11 is int
		let css = color.namedColors.get(name)
		return int(css.r) << 24 | int(css.g) << 16 | int(css.b) << 8 | 0xFF when css is color.RGBA
		// grayN / greyN, 0 to 100.
		for let (_, prefix) in string["gray", "grey"] {
			if name.startsWith(prefix) && name.len() > prefix.len() && name.slice(prefix.len()).isNumeric() {
				let pct = name.slice(prefix.len()).toInt<int>()
				fail "xpm: unknown colour \"{value}\"" when pct < 0 || pct > 100
				let g = (pct * 255 + 50) / 100
				g = 127 when pct == 50
				g = 229 when pct == 90
				return g << 24 | g << 16 | g << 8 | 0xFF
			}
		}
		// red1..red4 and the other primaries: 255, 238, 205, 139 on their channels.
		let shade = int[0, 255, 238, 205, 139]
		let primaries = map<string, int>{
			"red": 0xFF0000,
			"green": 0x00FF00,
			"blue": 0x0000FF,
			"yellow": 0xFFFF00,
			"cyan": 0x00FFFF,
			"magenta": 0xFF00FF,
		}
		if name.len() > 1 {
			let base = name.slice(0, name.len() - 1)
			let digit = name.slice(name.len() - 1)
			let mask = primaries.get(base)
			if mask is int && (digit := "1" || "2" || "3" || "4") {
				let s = shade[digit.toInt<int>()]
				let rgb = 0
				rgb |= s << 16 when mask & 0xFF0000 != 0
				rgb |= s << 8 when mask & 0x00FF00 != 0
				rgb |= s when mask & 0x0000FF != 0
				return rgb << 8 | 0xFF
			}
		}
		fail "xpm: unknown colour \"{value}\""
	}
}
