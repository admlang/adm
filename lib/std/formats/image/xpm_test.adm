partial module std.formats.image {
	use (
		std.testing
		std.bytes
	)

	check "XPM" {
		internal def assertPixel(img Image, x int, y int, r int, g int, b int, a int) {
			let o = img.pixelOffset(x, y)
			assert int(img.raw()[o]) == r
			assert int(img.raw()[o + 1]) == g
			assert int(img.raw()[o + 2]) == b
			assert int(img.raw()[o + 3]) == a
		}

		internal def decodeOr(src string) Image {
			let codec = new XPM()
			return codec.decode(src.bytes()) onerror recover new Image(1, 1)
		}

		internal def named() string {
			return "/* XPM */\n// line comment\nstatic const char * named_xpm[] = {\n/* w h n cpp */\n\"6 2 6 2 0 0\",\n\"  c None s bg\",\n\"r. c red\",\n\"g. m black c green\",\n\"G. c light grey\",\n\"h. c #F0A g #000\",\n\"H. c #1234ABCDFFFF\",\n\"  r.g.G.h.H.\",\n\"H.h.G.g.r.  \"};\n"
		}

		@test()
		def decodes_keys_names_and_hex_forms() {
			let img = decodeOr(named())
			assert int(img.size().width) == 6
			assert int(img.size().height) == 2
			assertPixel(img, 0, 0, 0, 0, 0, 0)
			assertPixel(img, 1, 0, 255, 0, 0, 255)
			// X11 green, not CSS green.
			assertPixel(img, 2, 0, 0, 255, 0, 255)
			assertPixel(img, 3, 0, 211, 211, 211, 255)
			assertPixel(img, 4, 0, 255, 0, 170, 255)
			assertPixel(img, 5, 0, 18, 171, 255, 255)
			assertPixel(img, 0, 1, 18, 171, 255, 255)
			assertPixel(img, 5, 1, 0, 0, 0, 0)
		}

		@test()
		def decodes_x11_numbered_names_and_12_bit_hex() {
			let img = decodeOr("/* XPM */\nstatic char *g[] = {\n\"6 1 6 1\",\n\"a c gray50\", \"b c grey90\", \"c c Red3\", \"d c navy blue\", \"e c #ABCABCABC\", \"f c gray\",\n\"abcdef\"\n};\n")
			assertPixel(img, 0, 0, 127, 127, 127, 255)
			assertPixel(img, 1, 0, 229, 229, 229, 255)
			assertPixel(img, 2, 0, 205, 0, 0, 255)
			assertPixel(img, 3, 0, 0, 0, 128, 255)
			assertPixel(img, 4, 0, 171, 171, 171, 255)
			assertPixel(img, 5, 0, 190, 190, 190, 255)
		}

		@test()
		def decodes_three_characters_per_pixel() {
			let img = decodeOr("/* XPM */\nstatic char *t[] = {\"2 1 2 3\", \"abc c #010203\", \"abd c #040506\", \"abdabc\"};")
			assertPixel(img, 0, 0, 4, 5, 6, 255)
			assertPixel(img, 1, 0, 1, 2, 3, 255)
		}

		@test()
		def round_trips_colours_and_transparency() {
			let img = new Image(40, 3)
			let px = img.raw()
			for let i = 0; i < px.len(); i += 4 {
				let p = i / 4
				px[i] = byte(p * 5 % 256)
				px[i + 1] = byte(p % 3 * 100)
				px[i + 2] = byte(p % 7)
				px[i + 3] = byte(255)
			}
			// Transparent pixels decode as zero.
			px[0], px[1], px[2], px[3] = byte(0), byte(0), byte(0), byte(0)
			let codec = new XPM()
			let data = codec.encode(img) onerror recover byte[]
			assert string(data).startsWith("/* XPM */")
			let back = codec.decode(data) onerror recover new Image(1, 1)
			assert back.raw().equals(px)
		}

		@test()
		def encodes_many_colours_with_two_characters() {
			let img = new Image(200, 1)
			let px = img.raw()
			for let i = 0; i < 200; i++ {
				px[i * 4] = byte(i)
				px[i * 4 + 3] = byte(255)
			}
			let codec = new XPM()
			let data = codec.encode(img) onerror recover byte[]
			assert string(data).contains("\"200 1 200 2 \"")
			let back = codec.decode(data) onerror recover new Image(1, 1)
			assert back.raw().equals(px)
		}

		@test()
		def matches_the_comment() {
			let codec = new XPM()
			assert codec.matchSignature(new bytes.Reader("\n/* XPM */\nstatic".bytes()))
			assert !codec.matchSignature(new bytes.Reader("/* XBM */".bytes()))
			assert !codec.matchSignature(new bytes.Reader(byte[137, 80, 78, 71]))
		}

		@test()
		def info_reads_the_values_line() {
			let codec = new XPM()
			let got = codec.info(named().bytes()) onerror recover ImageInfo{}
			assert int(got.size.width) == 6
			assert int(got.size.height) == 2
		}

		@test()
		def rejects_corrupt_input() {
			let codec = new XPM()
			let bad = string[
				"/* XPM */ static char *x[] = {\"2 1 1 1\", \"a c #000000\", \"ab\"};",
				"/* XPM */ static char *x[] = {\"2 1 1 1\", \"a c #000000\", \"a\"};",
				"/* XPM */ static char *x[] = {\"2 1 1 1\", \"a c nosuchcolour\", \"aa\"};",
				"/* XPM */ static char *x[] = {\"2 2 1 1\", \"a c #000000\", \"aa\"};",
				"/* XPM */ static char *x[] = {\"2 1 1 1\", \"a c #00000\", \"aa\"};",
				"/* XPM */ static char *x[] = {\"2 1 1 1",
				"/* XPM */",
			]
			for let (_, src) in bad {
				let img = codec.decode(src.bytes()) onerror recover new Image(7, 7)
				assert int(img.size().width) == 7
			}
		}
	}
}
