partial module std.formats.mail {
	use std.formats.mail.wire::*

	// Address is a mailbox: a display name and an `addr-spec`
	// (`"Alice Example" <alice@example.com>`). `name` holds the decoded
	// display name, empty when there is none.
	type Address {
		name    string = ""
		address string

		def new(address string, name string = "") {
			self.address = address
			self.name = name
		}

		// The part before the last `@`.
		def localPart() string {
			let at = lastAt(address)
			return at < 0 ?? (address, address[:at])
		}

		// The part after the last `@`, the domain as written (not
		// IDNA-converted).
		def domain() string {
			let at = lastAt(address)
			return at < 0 ?? ("", address[at + 1:])
		}

		// The header form: `address` alone without a name, else the name
		// quoted or RFC 2047-encoded as needed, then `<address>`.
		def str() string {
			return formatAddress(name, address)
		}
	}

	// Parses one mailbox (RFC 5322 `mailbox`, with RFC 6532 UTF-8). Fails
	// when `text` is not one address.
	def parseAddress(text string) !Address {
		let list = try parseAddressList(text)
		fail badAddress(text) unless list.len() == 1
		return list[0]
	}

	// Parses an address list: mailboxes separated by commas, groups
	// (`team: a@x, b@y;`) flattened into their members. Fails when an
	// entry does not parse.
	def parseAddressList(text string) !Address[] {
		return try readAddressList(text)
	}
}
