partial module std.formats.mail {
	use (
		std.formats.mail.wire::*
		std.time
		std.time::(Time)
	)

	// Header is the ordered header block of a message or MIME part. Names
	// match without regard to case and keep the case they were set with.
	// `get` and `values` decode RFC 2047 encoded words; `raw` returns the
	// field as received, unfolded. Setting a value encodes the words that
	// need it and folds long lines when the header is written.
	type Header {
		internal keys   string[] = []
		internal fields string[] = []

		def new() {}

		// The first value of `name`, decoded; none when it is absent.
		def get(name string) ?string {
			let value = raw(name)
			return none when value is none
			return decodeText(value)
		}

		// Every value of `name`, decoded, in order.
		def values(name string) string[] {
			let key = name.lower()
			let out string[] = []
			for let i = 0; i < keys.len(); i++ {
				out.push(decodeText(fields[i])) when keys[i].lower() == key
			}
			return out
		}

		// The first value of `name` as received, unfolded but not decoded.
		def raw(name string) ?string {
			let at = find(name)
			return none when at < 0
			return fields[at]
		}

		// Replaces every value of `name` with `value`.
		def set(name string, value string) {
			let at = find(name)
			if at < 0 {
				add(name, value)
				return
			}
			fields[at] = value
			let key = name.lower()
			for let i = keys.len() - 1; i > at; i-- {
				continue unless keys[i].lower() == key
				keys.remove(i)
				fields.remove(i)
			}
		}

		// Appends a value of `name` after the existing ones.
		def add(name string, value string) {
			keys.push(name)
			fields.push(value)
		}

		// Drops every value of `name`.
		def remove(name string) {
			let key = name.lower()
			for let i = keys.len() - 1; i >= 0; i-- {
				continue unless keys[i].lower() == key
				keys.remove(i)
				fields.remove(i)
			}
		}

		// Whether `name` has a value.
		def has(name string) bool {
			return find(name) >= 0
		}

		// The names present, in first-appearance order.
		def names() string[] {
			let seen string[] = []
			let out string[] = []
			for let key in keys {
				let lower = key.lower()
				continue when seen.indexOf(lower) >= 0
				seen.push(lower)
				out.push(key)
			}
			return out
		}

		// The addresses of `name` (`From`, `To`, `Cc`...), every value
		// joined. Fails when one does not parse.
		def addresses(name string) !Address[] {
			let key = name.lower()
			let out Address[] = []
			for let i = 0; i < keys.len(); i++ {
				continue unless keys[i].lower() == key
				for let a in try readAddressList(fields[i]) {
					out.push(a)
				}
			}
			return out
		}

		// The date of `name` (RFC 5322 `date-time`, with the obsolete forms
		// of RFC 5322 §4.3). Fails when it is absent or does not parse.
		def date(name string) !Time {
			let value = raw(name)
			fail mailError("BadHeader", "no {name} field") when value is none
			return time.parseMailDate(value) onerror (err error) {
				fail MailError{message: "mail: {name}: not a date: {value}", code: "BadHeader", cause: err}
			}
		}

		// The header block in wire form, lines folded at 78 characters,
		// ended by `\r\n`, without the blank line that follows it.
		def str() string {
			let out = ""
			for let i = 0; i < keys.len(); i++ {
				out += fold(keys[i], encodeField(keys[i], fields[i]))
			}
			return out
		}

		// find is the index of the first field named `name`, -1 when none.
		internal def find(name string) int {
			let key = name.lower()
			for let i = 0; i < keys.len(); i++ {
				return i when keys[i].lower() == key
			}
			return -1
		}
	}
}
