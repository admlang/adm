partial module std.formats.mail {
	use (
		std.bytes
		std.errors
		std.io
		std.os
		std.formats.mail.wire::*
	)

	// MailError is the payload of a message, header or address that does
	// not parse. `code` names the kind: `BadAddress`, `BadHeader`,
	// `BadMime`, `BadEncoding`.
	struct MailError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	// Parses a message from its RFC 5322 bytes: headers, then a body that
	// MIME splits into parts. Fails when the header block or the MIME
	// structure does not parse; a part in an unknown transfer encoding is
	// kept undecoded, not an error.
	def parse(data byte[]) !Message {
		let (end, bodyStart) = headerEnd(data)
		let fields = try parseFields(data.slice(0, end))
		let message = new Message()
		let content = new Header()
		for let field in fields {
			let (name, value) = field
			if name.lower().startsWith("content-") {
				content.add(name, value)
			} else {
				message.header.add(name, value)
			}
		}
		message.body = try entityOf(content, data.slice(bodyStart, data.len() - bodyStart), 0)
		return message
	}

	// Parses the message `reader` reads until its end. Fails as `parse`
	// does, or when `reader` fails.
	def read(reader io.Reader) !Message {
		let buffer = new bytes.Buffer()
		try buffer.readFrom(reader)
		return try parse(buffer.bytes())
	}

	// Reads an `.eml` file. Fails when the file cannot be read or does not
	// parse.
	def load(path string) !Message {
		return try parse(try os.readFile(path))
	}
}
