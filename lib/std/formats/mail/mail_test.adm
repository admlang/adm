partial module std.formats.mail {
	use (
		std.bytes
		std.testing
		std.formats::(MediaType)
		std.os
		std.time
		std.formats.mail.wire::*
	)

	// Deletes a scratch file a test wrote, if it is there.
	internal def removeScratch(path string) {
		os.remove(path) onerror recover none
	}

	check "addresses" {
		@test()
		def parsesMailboxForms() !none {
			let a = try parseAddress("alice@example.com")
			assert a.address == "alice@example.com" && a.name == ""
			let b = try parseAddress("\"Example, Alice\" <alice@example.com>")
			assert b.name == "Example, Alice" && b.address == "alice@example.com"
			let c = try parseAddress("Alice Example <alice@example.com> (work)")
			assert c.name == "Alice Example"
			let d = try parseAddress("=?utf-8?q?Zo=C3=AB?= <zoe@example.com>")
			assert d.name == "Zoë"
			let e = try parseAddress("<@relay.example:bob@example.com>")
			assert e.address == "bob@example.com"
			let f = try parseAddress("\"john doe\"@example.com")
			assert f.address == "\"john doe\"@example.com" && f.localPart() == "\"john doe\"" && f.domain() == "example.com"
			let g = try parseAddress("root@[192.0.2.1]")
			assert g.domain() == "[192.0.2.1]"
			assert parseAddress("no at sign") is error
			assert parseAddress("a@x, b@y") is error
			assert parseAddress("<alice@example.com") is error
			return none
		}

		@test()
		def parsesListsAndGroups() !none {
			let list = try parseAddressList("a@x.org, Team: b@x.org, \"C\" <c@x.org>;, , d@x.org")
			assert list.len() == 4
			assert list[1].address == "b@x.org" && list[2].name == "C" && list[3].address == "d@x.org"
			assert (try parseAddressList("Undisclosed recipients:;")).len() == 0
			return none
		}

		@test()
		def formatsNames() !none {
			assert new Address("a@x.org").str() == "a@x.org"
			assert new Address("a@x.org", "Alice Example").str() == "Alice Example <a@x.org>"
			assert new Address("a@x.org", "Example, Alice").str() == "\"Example, Alice\" <a@x.org>"
			assert new Address("z@x.org", "Zoë").str() == "=?utf-8?q?Zo=C3=AB?= <z@x.org>"
			return none
		}
	}

	check "header" {
		@test()
		def keepsOrderAndCase() !none {
			let h = new Header()
			h.add("Received", "one")
			h.add("Subject", "hello")
			h.add("received", "two")
			assert h.values("RECEIVED").equals(["one", "two"])
			assert h.names().equals(["Received", "Subject"])
			h.set("Received", "only")
			assert h.values("received").equals(["only"])
			h.remove("subject")
			assert !h.has("Subject") && h.get("Subject") is none
			return none
		}

		@test()
		def decodesAndEncodesWords() !none {
			let h = new Header()
			h.add("Subject", "=?iso-8859-1?q?caf=E9?= =?utf-8?b?w6k=?=")
			assert orEmpty(h.get("Subject")) == "caféé"
			assert orEmpty(h.raw("Subject")) == "=?iso-8859-1?q?caf=E9?= =?utf-8?b?w6k=?="
			let out = new Header()
			out.set("Subject", "café")
			out.set("To", "Zoë <z@x.org>")
			out.set("Message-ID", "<1@x.org>")
			assert out.str() == "Subject: =?utf-8?q?caf=C3=A9?=\r\nTo: =?utf-8?q?Zo=C3=AB?= <z@x.org>\r\nMessage-ID: <1@x.org>\r\n"
			return none
		}

		@test()
		def foldsLongLines() !none {
			let h = new Header()
			h.set("Subject", "word ".repeat(30).trim())
			for let line in h.str().split("\r\n") {
				assert line.len() <= 78
			}
			let parsed = try parse(h.str().bytes())
			assert parsed.subject() == "word ".repeat(30).trim()
			return none
		}

		@test()
		def readsDatesAndAddresses() !none {
			let h = new Header()
			h.add("Date", "Tue, 1 Jul 2003 10:52:37 +0200")
			h.add("To", "a@x.org, B <b@x.org>")
			h.add("To", "c@x.org")
			assert (try h.date("Date")).hour() == 8
			assert (try h.addresses("to")).len() == 3
			assert h.date("Missing") is error
			return none
		}
	}

	check "parse" {
		@test()
		def parsesPlainMessage() !none {
			let raw = "From: Alice <a@x.org>\r\nTo: b@x.org\r\nSubject: Hi\r\n there\r\nDate: Tue, 1 Jul 2003 10:52:37 +0200\r\nMessage-ID: <abc@x.org>\r\n\r\nLine one\r\nLine two\r\n"
			let m = try parse(raw.bytes())
			assert m.subject() == "Hi there"
			assert (try m.from())[0].name == "Alice"
			assert orEmpty(m.messageId()) == "abc@x.org"
			assert orEmpty(m.text()) == "Line one\r\nLine two\r\n"
			assert m.html() is none
			assert (try m.date()).day() == 1
			return none
		}

		@test()
		def acceptsBareLineFeeds() !none {
			let m = try parse("Subject: lf\n\nbody\n".bytes())
			assert m.subject() == "lf"
			assert orEmpty(m.text()) == "body\n"
			return none
		}

		@test()
		def parsesNestedMultipart() !none {
			let raw = [
				"From: a@x.org",
				"Content-Type: multipart/mixed; boundary=outer",
				"",
				"preamble",
				"--outer",
				"Content-Type: multipart/alternative; boundary=\"inner b\"",
				"",
				"--inner b",
				"Content-Type: text/plain; charset=iso-8859-1",
				"Content-Transfer-Encoding: quoted-printable",
				"",
				"caf=E9 au lait=",
				" soft",
				"--inner b",
				"Content-Type: text/html; charset=utf-8",
				"Content-Transfer-Encoding: base64",
				"",
				"PGI+aGk8L2I+",
				"--inner b--",
				"--outer",
				"Content-Type: application/pdf; name=\"old.pdf\"",
				"Content-Disposition: attachment; filename*=utf-8''r%C3%A9sum%C3%A9.pdf",
				"Content-Transfer-Encoding: base64",
				"",
				"JVBERi0x",
				"LjQ=",
				"--outer--",
				"epilogue",
			].join("\r\n")
			let m = try parse(raw.bytes())
			assert m.body.isMultipart() && m.body.parts.len() == 2
			assert orEmpty(m.text()) == "café au lait soft"
			assert orEmpty(m.html()) == "<b>hi</b>"
			let files = m.attachments()
			assert files.len() == 1
			assert orEmpty(files[0].filename()) == "résumé.pdf"
			assert string(files[0].data()) == "%PDF-1.4"
			assert m.body.walk().len() == 5
			return none
		}

		@test()
		def keepsUnknownEncodingRaw() !none {
			let m = try parse("Content-Type: application/x-thing\r\nContent-Transfer-Encoding: x-uuencode\r\n\r\nbegin 644 f\r\n".bytes())
			assert string(m.body.data()) == "begin 644 f\r\n"
			return none
		}

		@test()
		def rejectsBrokenHeader() !none {
			assert parse("no colon here\r\n\r\nbody".bytes()) is error
			assert parse(" leading continuation\r\n\r\n".bytes()) is error
			return none
		}
	}

	check "build" {
		@test()
		def buildsAndRoundTrips() !none {
			let m = new Message().from("alice@example.com", "Alice").to("bob@example.com").cc("carol@example.com", "Carol").bcc("dave@example.com").subject("Report ✓").text("See attached.\nThanks").html("<p>See attached.</p>")
			m.attach("notes.txt", "plain notes".bytes())
			m.attach("blob.bin", [0x00, 0xFF, 0x10])
			m.embed("logo", [0x89, 0x50, 0x4E, 0x47], new MediaType("image", "png"))
			let wire = m.bytes()
			let back = try parse(wire)
			assert back.subject() == "Report ✓"
			assert orEmpty(back.text()) == "See attached.\r\nThanks"
			assert orEmpty(back.html()) == "<p>See attached.</p>"
			assert (try back.recipients()).equals(["bob@example.com", "carol@example.com", "dave@example.com"])
			assert !(back.messageId() is none)
			assert (try back.date()).year() >= 2026
			assert back.body.contentType().essence() == "multipart/mixed"
			let files = back.attachments()
			assert files.len() == 2
			assert orEmpty(files[0].filename()) == "notes.txt" && files[0].contentType().essence() == "text/plain"
			assert (files[1].data()).equals([0x00, 0xFF, 0x10])
			let inline = back.body.walk().filter(p => orEmpty(p.contentId()) == "logo")
			assert inline.len() == 1
			return none
		}

		@test()
		def flattensSingleBody() !none {
			let m = new Message().text("only text")
			assert m.body.contentType().essence() == "text/plain"
			assert !m.body.isMultipart()
			let wire = string(m.bytes())
			assert wire.contains("MIME-Version: 1.0\r\n") && wire.endsWith("\r\n\r\nonly text")
			return none
		}

		@test()
		def picksTransferEncodings() !none {
			let ascii = new Message().text("plain ascii")
			assert !string(ascii.bytes()).contains("Content-Transfer-Encoding")
			let accents = new Message().text("déjà vu, mostly ascii")
			assert string(accents.bytes()).contains("Content-Transfer-Encoding: quoted-printable")
			let script = new Message().text("日本語のテキスト")
			assert string(script.bytes()).contains("Content-Transfer-Encoding: base64")
			let back = try parse(script.bytes())
			assert orEmpty(back.text()) == "日本語のテキスト"
			return none
		}

		@test()
		def buildsReply() !none {
			let original = try parse("From: Alice <a@x.org>\r\nTo: b@x.org, c@x.org\r\nCc: d@x.org\r\nSubject: Plan\r\nMessage-ID: <2@x.org>\r\nReferences: <1@x.org>\r\n\r\nbody".bytes())
			let answer = try original.reply()
			assert (try answer.to())[0].address == "a@x.org"
			assert answer.subject() == "Re: Plan"
			assert (answer.inReplyTo()).equals(["2@x.org"])
			assert (answer.references()).equals(["1@x.org", "2@x.org"])
			let everyone = try original.reply(true)
			assert (try everyone.cc()).len() == 3
			let again = try answer.reply()
			assert again.subject() == "Re: Plan"
			return none
		}

		@test()
		def savesAndLoads() !none {
			let path = "/tmp/adm-mail-test-{time.now().unixNs()}.eml"
			defer removeScratch(path)
			let m = new Message().from("a@x.org").to("b@x.org").subject("saved").text("hello")
			try m.save(path)
			let back = try load(path)
			assert back.subject() == "saved" && orEmpty(back.text()) == "hello"
			return none
		}

		@test()
		def readsAndWritesThroughStreams() !none {
			let m = new Message().from("a@x.org", "A").sender("desk@x.org", "Front Desk").replyTo("list@x.org").to("b@x.org").subject("streams").text("hi")
			let out = new bytes.Buffer()
			try m.write(out)
			let back = try read(new bytes.Buffer(out.bytes()))
			let sender = try back.sender()
			assert !(sender is none) && sender.address == "desk@x.org" && sender.name == "Front Desk"
			assert (try back.replyTo())[0].address == "list@x.org"
			assert (try new Message().sender()) is none
			let answer = try back.reply()
			assert (try answer.to())[0].address == "list@x.org"
			return none
		}

		@test()
		def classifiesAttachments() !none {
			let plain = new Part(new MediaType("text", "plain"), "x".bytes())
			assert !plain.isAttachment()
			plain.header.set("Content-Disposition", "attachment")
			assert plain.isAttachment()
			let named = new Part(new MediaType("image", "png", map<string, string>{"name": "a.png"}), [])
			assert named.isAttachment() && orEmpty(named.filename()) == "a.png"
			named.header.set("Content-Disposition", "inline; filename=a.png")
			assert !named.isAttachment()
			assert !new Part("mixed").isAttachment()
			return none
		}
	}
}
