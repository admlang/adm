partial module std.formats.mail {
	use (
		std.crypto
		std.os
		std.services::(Application, Runtime)
		std.time
		std.time::(Time)
	)

	// MaildirEntry is one message of a Maildir: its key (the unique part
	// of the file name), size, flags and whether it is still in `new`.
	struct MaildirEntry {
		key      string
		size     int64
		// The Maildir flag letters, sorted: `D` draft, `F` flagged, `P`
		// passed, `R` replied, `S` seen, `T` trashed; lower-case letters
		// are keywords a store numbers itself.
		flags    string
		isNew    bool
		modified Time
	}

	// Maildir is a mail folder on disk in the Maildir layout: one file per
	// message under `tmp`, `new` and `cur`, delivered without locks by
	// writing into `tmp` and renaming into `new`. Subfolders follow
	// Maildir++ (`.Sent`, `.Work.Clients`), so Dovecot, Courier and mutt
	// read the same tree.
	//
	// ```
	// let inbox = new mail.Maildir("/var/mail/alice")
	// try inbox.create()
	// let key = try inbox.deliver(message.bytes())
	// for let entry in try inbox.list() {
	//     let message = try mail.parse(try inbox.read(entry.key))
	// }
	// ```
	type Maildir {
		path string

		def new(path string) {
			self.path = path
		}

		// Creates the folder and its `tmp`, `new` and `cur` directories
		// where missing. Fails when one cannot be made.
		def create() !none {
			for let dir in [path, os.join(path, "tmp"), os.join(path, "new"), os.join(path, "cur")] {
				let there = os.exists(dir) onerror recover false
				try os.mkdir(dir) unless there
			}
			return none
		}

		// Stores a message and returns its key: into `new`, or with `flags`
		// straight into `cur` as already seen by a client. Fails when the
		// folder is missing or the file cannot be written.
		def deliver(data byte[], flags string = "") !string {
			let key = uniqueName()
			let staged = os.join(path, "tmp", key)
			try os.writeFile(staged, data)
			let target = flags == "" ?? (os.join(path, "new", key), os.join(path, "cur", key + ":2," + sortedFlags(flags)))
			os.rename(staged, target) onerror (err error) {
				os.remove(staged) onerror recover none
				fail err
			}
			return key
		}

		// The messages in `new` and `cur`, oldest first. Fails when the
		// folder cannot be read.
		def list() !MaildirEntry[] {
			let out MaildirEntry[] = []
			for let sub in ["new", "cur"] {
				let dir = os.join(path, sub)
				for let entry in try os.readDir(dir) {
					continue when entry.info.isDir || entry.info.name.startsWith(".")
					let name = entry.info.name
					let colon = name.indexOf(":")
					let key = colon < 0 ?? (name, name[:colon])
					let flags = colon >= 0 && name[colon:].startsWith(":2,") ?? (name[colon + 3:], "")
					out.push(MaildirEntry{key: key, size: entry.info.size, flags: flags, isNew: sub == "new", modified: entry.info.modTime})
				}
			}
			out.sort((a, b) => a.key < b.key)
			return out
		}

		// The message stored under `key`. Fails when there is none.
		def read(key string) !byte[] {
			return try os.readFile(try fileOf(key))
		}

		// Deletes the message stored under `key`. Fails when there is none.
		def remove(key string) !none {
			return try os.remove(try fileOf(key))
		}

		// Replaces the flags of message `key`, moving it to `cur`. Fails
		// when there is none or it cannot be renamed.
		def setFlags(key string, flags string) !none {
			let current = try fileOf(key)
			let target = os.join(path, "cur", key + ":2," + sortedFlags(flags))
			return none when current == target
			return try os.rename(current, target)
		}

		// The Maildir++ subfolders, by name with `.` between levels
		// (`Work.Clients`). Fails when the folder cannot be read.
		def folders() !string[] {
			let out string[] = []
			for let entry in try os.readDir(path) {
				let name = entry.info.name
				continue unless entry.info.isDir && name.startsWith(".") && name != "." && name != ".."
				out.push(name[1:])
			}
			out.sort((a, b) => a < b)
			return out
		}

		// The subfolder `name`, which may not exist yet.
		def folder(name string) Maildir {
			return new Maildir(os.join(path, "." + name))
		}

		// Creates the subfolder `name` and returns it. Fails when it exists
		// or cannot be made.
		def createFolder(name string) !Maildir {
			fail MailError{message: "mail: bad folder name \"{name}\"", code: "BadFolder"} unless validFolder(name)
			let sub = folder(name)
			let there = os.exists(sub.path) onerror recover false
			fail MailError{message: "mail: folder \"{name}\" exists", code: "BadFolder"} when there
			try sub.create()
			// Courier and Dovecot mark a Maildir++ folder with this file.
			try os.writeFile(os.join(sub.path, "maildirfolder"), [])
			return sub
		}

		// Deletes the subfolder `name` with its messages. Fails when it does
		// not exist or cannot be removed.
		def removeFolder(name string) !none {
			let sub = folder(name)
			let there = os.exists(sub.path) onerror recover false
			fail MailError{message: "mail: no folder \"{name}\"", code: "BadFolder"} unless there && validFolder(name)
			return try removeTree(sub.path)
		}

		// Renames the subfolder `from` to `to`, and its subfolders with it.
		// Fails when `from` does not exist or `to` does.
		def renameFolder(from string, to string) !none {
			fail MailError{message: "mail: bad folder name \"{to}\"", code: "BadFolder"} unless validFolder(to) && validFolder(from)
			let target = os.exists(folder(to).path) onerror recover false
			fail MailError{message: "mail: folder \"{to}\" exists", code: "BadFolder"} when target
			try os.rename(folder(from).path, folder(to).path)
			for let child in try folders() {
				continue unless child.startsWith(from + ".")
				try os.rename(folder(child).path, folder(to + child[from.len():]).path)
			}
			return none
		}

		// fileOf is the path of the message stored under `key`.
		internal def fileOf(key string) !string {
			fail MailError{message: "mail: bad message key \"{key}\"", code: "BadKey"} when key == "" || key.contains("/") || key.startsWith(".")
			let fresh = os.join(path, "new", key)
			let inNew = os.exists(fresh) onerror recover false
			return fresh when inNew
			for let entry in try os.readDir(os.join(path, "cur")) {
				let name = entry.info.name
				return entry.path when name == key || name.startsWith(key + ":")
			}
			fail MailError{message: "mail: no message \"{key}\"", code: "NoMessage"}
		}

		// uniqueName is a delivery name: seconds, microseconds, process ID,
		// random bits and host (the Dovecot form).
		internal def uniqueName() string {
			let ns = time.now().unixNs()
			let random = crypto.rand(8) onerror recover []
			let host = Runtime.getEnv("HOSTNAME")
			let name = host is none ?? ("localhost", host)
			name = name.replace("/", "\\057").replace(":", "\\072")
			return "{ns / 1000000000}.M{(ns / 1000) % 1000000}P{Application.pid()}R{random.hex().lower()}.{name}"
		}

		// sortedFlags is the flag letters sorted, each once.
		internal def sortedFlags(flags string) string {
			let letters string[] = []
			for let c in flags {
				let letter = string(c)
				letters.push(letter) when c.isLetter() && letters.indexOf(letter) < 0
			}
			letters.sort((a, b) => a < b)
			return letters.join("")
		}

		// validFolder reports a Maildir++ folder name: non-empty levels
		// without `/`.
		internal def validFolder(name string) bool {
			return false when name == "" || name.contains("/") || name.startsWith(".") || name.endsWith(".") || name.contains("..")
			return true
		}

		// removeTree deletes a directory and everything in it.
		internal def removeTree(dir string) !none {
			for let entry in try os.readDir(dir) {
				if entry.info.isDir {
					try removeTree(entry.path)
				} else {
					try os.remove(entry.path)
				}
			}
			return try os.rmdir(dir)
		}
	}
}
