partial module std.formats.mail {
	use (
		std.os
		std.testing
		std.time
	)

	internal def scratchMaildir() !Maildir {
		let box = new Maildir("/tmp/adm-maildir-{time.now().unixNs()}")
		try box.create()
		return box
	}

	check "maildir" {
		@test()
		def deliversListsAndReads() !none {
			let box = try scratchMaildir()
			let first = try box.deliver("Subject: one\r\n\r\nbody one\r\n".bytes())
			let second = try box.deliver("Subject: two\r\n\r\nbody two\r\n".bytes(), "SF")
			let entries = try box.list()
			assert entries.len() == 2
			let fresh = entries.filter(e => e.key == first)
			let seen = entries.filter(e => e.key == second)
			assert fresh.len() == 1 && fresh[0].isNew && fresh[0].flags == "" && fresh[0].size == 26
			assert seen.len() == 1 && !seen[0].isNew && seen[0].flags == "FS"
			assert (try parse(try box.read(second))).subject() == "two"
			assert (try os.readDir(os.join(box.path, "tmp"))).len() == 0
			return none
		}

		@test()
		def movesFlagsAndRemoves() !none {
			let box = try scratchMaildir()
			let key = try box.deliver("Subject: x\r\n\r\ny\r\n".bytes())
			try box.setFlags(key, "TSRS")
			let entry = (try box.list())[0]
			assert !entry.isNew && entry.flags == "RST"
			assert string(try box.read(key)).contains("Subject: x")
			try box.remove(key)
			assert (try box.list()).len() == 0
			assert box.read(key) is error
			assert box.read("../escape") is error
			return none
		}

		@test()
		def managesFolders() !none {
			let box = try scratchMaildir()
			let work = try box.createFolder("Work")
			try box.createFolder("Work.Clients")
			try work.deliver("Subject: w\r\n\r\n".bytes())
			assert (try box.folders()).equals(["Work", "Work.Clients"])
			assert box.createFolder("Work") is error
			assert box.createFolder("bad/name") is error
			try box.renameFolder("Work", "Jobs")
			assert (try box.folders()).equals(["Jobs", "Jobs.Clients"])
			assert (try box.folder("Jobs").list()).len() == 1
			try box.removeFolder("Jobs.Clients")
			assert (try box.folders()).equals(["Jobs"])
			assert box.removeFolder("Missing") is error
			return none
		}
	}
}
