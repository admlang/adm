partial module std.formats.mail {
	use (
		std.formats
		std.formats::(MediaType)
		std.formats.mail.wire::*
		std.io
		std.bytes
		std.os
		std.time
		std.time::(Time, formatMailDate)
	)

	// Message is an Internet message (RFC 5322, MIME per RFC 2045–2049,
	// UTF-8 headers per RFC 6532): its header and its body part. The
	// accessors read and write the header; the body methods build the
	// usual MIME layout, `multipart/mixed` over `multipart/related` over
	// `multipart/alternative` (text and HTML), and flatten it to a single
	// part when there is only one. SMTP sends it, POP3 and IMAP fetch it.
	//
	// ```
	// let msg = new mail.Message()
	//     .from("alice@example.com", "Alice")
	//     .to("bob@example.com")
	//     .subject("Report")
	//     .text("See attached.")
	// try msg.attach("report.pdf")
	// try msg.save("report.eml")
	// ```
	type Message {
		header Header = new Header()
		body   Part   = new Part(new MediaType("text", "plain", map<string, string>{"charset": "utf-8"}), [])

		// An empty message; writing it adds `Date`, `Message-ID` and
		// `MIME-Version` when they are still absent.
		def new() {}

		// `From`; fails when it does not parse.
		def from() !Address[] {
			return try header.addresses("From")
		}

		// Appends an author to `From`.
		def from(address string, name string = "") Message {
			return append("From", address, name)
		}

		// `Sender`, none when absent; fails when it does not parse.
		def sender() !?Address {
			let raw = header.raw("Sender")
			return none when raw is none
			return try parseAddress(raw)
		}

		// Sets `Sender`, the mailbox that sent the message for its authors.
		def sender(address string, name string = "") Message {
			header.set("Sender", new Address(address, name).str())
			return self
		}

		// `To`; fails when it does not parse.
		def to() !Address[] {
			return try header.addresses("To")
		}

		// Appends a recipient to `To`.
		def to(address string, name string = "") Message {
			return append("To", address, name)
		}

		// `Cc`; fails when it does not parse.
		def cc() !Address[] {
			return try header.addresses("Cc")
		}

		// Appends a recipient to `Cc`.
		def cc(address string, name string = "") Message {
			return append("Cc", address, name)
		}

		// `Bcc`; fails when it does not parse.
		def bcc() !Address[] {
			return try header.addresses("Bcc")
		}

		// Appends a blind recipient; `Bcc` is left out when the message is
		// sent.
		def bcc(address string, name string = "") Message {
			return append("Bcc", address, name)
		}

		// `Reply-To`; fails when it does not parse.
		def replyTo() !Address[] {
			return try header.addresses("Reply-To")
		}

		// Appends a mailbox to `Reply-To`, where replies should go.
		def replyTo(address string, name string = "") Message {
			return append("Reply-To", address, name)
		}

		// The addresses of `To`, `Cc` and `Bcc`, without duplicates: the
		// envelope recipients of SMTP. Fails when one does not parse.
		def recipients() !string[] {
			let out string[] = []
			let seen string[] = []
			for let field in ["To", "Cc", "Bcc"] {
				for let a in try header.addresses(field) {
					let key = a.address.lower()
					continue when a.address == "" || seen.indexOf(key) >= 0
					seen.push(key)
					out.push(a.address)
				}
			}
			return out
		}

		// `Subject`, decoded; empty when absent.
		def subject() string {
			let text = header.get("Subject")
			return "" when text is none
			return text
		}

		// Sets `Subject`.
		def subject(text string) Message {
			header.set("Subject", text)
			return self
		}

		// `Date`; fails when it is absent or does not parse.
		def date() !Time {
			return try header.date("Date")
		}

		// Sets `Date`, written in UTC.
		def date(time Time) Message {
			header.set("Date", formatMailDate(time))
			return self
		}

		// `Message-ID` without its angle brackets, none when absent.
		def messageId() ?string {
			let raw = header.raw("Message-ID")
			return none when raw is none
			let ids = messageIds(raw)
			return ids.len() > 0 ?? (ids[0], raw.trim())
		}

		// Sets `Message-ID`; the angle brackets are added.
		def messageId(id string) Message {
			header.set("Message-ID", "<" + id.trimPrefix("<").trimSuffix(">") + ">")
			return self
		}

		// The IDs of `In-Reply-To`.
		def inReplyTo() string[] {
			return messageIds(orEmpty(header.raw("In-Reply-To")))
		}

		// The IDs of `References`, oldest first.
		def references() string[] {
			return messageIds(orEmpty(header.raw("References")))
		}

		// The plain-text body, none when there is none.
		def text() ?string {
			let part = layoutOf(body).text
			return none when part is none
			return part.text() onerror recover string(part.data())
		}

		// Sets the plain-text body.
		def text(content string) Message {
			let layout = layoutOf(body)
			layout.text = new Part(new MediaType("text", "plain", map<string, string>{"charset": "utf-8"}), content.bytes())
			body = assemble(layout)
			return self
		}

		// The HTML body, none when there is none.
		def html() ?string {
			let part = layoutOf(body).html
			return none when part is none
			return part.text() onerror recover string(part.data())
		}

		// Sets the HTML body, beside the plain-text one when both are set.
		def html(content string) Message {
			let layout = layoutOf(body)
			layout.html = new Part(new MediaType("text", "html", map<string, string>{"charset": "utf-8"}), content.bytes())
			body = assemble(layout)
			return self
		}

		// Attaches `data` as `name`; `mediaType` none guesses it from the name's
		// extension, else from the content.
		def attach(name string, data byte[], mediaType ?MediaType = none) Part {
			let part = new Part(typeOf(name, data, mediaType), data)
			part.header.set("Content-Disposition", new MediaType("attachment", "", map<string, string>{"filename": name}).str())
			let layout = layoutOf(body)
			layout.attachments.push(part)
			body = assemble(layout)
			return part
		}

		// Attaches the file at `path` under its base name. Fails when the
		// file cannot be read.
		def attach(path string) !Part {
			let data = try os.readFile(path)
			return attach(os.base(path), data)
		}

		// Adds `data` as an inline part the HTML body refers to as
		// `cid:<contentId>`.
		def embed(contentId string, data byte[], mediaType MediaType) Part {
			let part = new Part(mediaType, data)
			part.header.set("Content-ID", "<" + contentId + ">")
			part.header.set("Content-Disposition", "inline")
			let layout = layoutOf(body)
			layout.inline.push(part)
			body = assemble(layout)
			return part
		}

		// The parts that are attachments, depth first.
		def attachments() Part[] {
			return body.walk().filter(p => !p.isMultipart() && p.isAttachment())
		}

		// A reply: `To` from `Reply-To` or `From`, `Subject` with `Re: `,
		// `In-Reply-To` and `References` set. With `all`, `Cc` gets the
		// other recipients. Fails when an address header does not parse.
		def reply(all bool = false) !Message {
			let answer = new Message()
			let targets = try replyTo()
			targets = try from() when targets.len() == 0
			let taken string[] = []
			for let a in targets {
				answer.to(a.address, a.name)
				taken.push(a.address.lower())
			}
			if all {
				let others = try to()
				for let a in try cc() {
					others.push(a)
				}
				for let a in others {
					continue when taken.indexOf(a.address.lower()) >= 0
					taken.push(a.address.lower())
					answer.cc(a.address, a.name)
				}
			}
			let topic = subject()
			answer.subject(topic.lower().startsWith("re:") ?? (topic, "Re: " + topic))
			let id = messageId()
			if !(id is none) {
				answer.header.set("In-Reply-To", "<" + orEmpty(id) + ">")
				let chain string[] = []
				for let ref in references() {
					chain.push("<" + ref + ">")
				}
				chain.push("<" + orEmpty(id) + ">")
				answer.header.set("References", chain.join(" "))
			}
			return answer
		}

		// The message in wire form, CRLF line ends.
		def bytes() byte[] {
			header.set("Date", formatMailDate(time.now())) unless header.has("Date")
			messageId(randomToken(16) + "@" + idDomain()) unless header.has("Message-ID")
			header.set("MIME-Version", "1.0") unless header.has("MIME-Version")
			let out = new bytes.Buffer()
			put(out, header.str())
			encodeEntity(body, out)
			return out.bytes()
		}

		// Writes the message in wire form. Fails when `writer` does.
		def write(writer io.Writer) !none {
			try writer.write(bytes())
		}

		// Writes the message to an `.eml` file. Fails when the file cannot
		// be written.
		def save(path string) !none {
			return os.writeFile(path, bytes())
		}

		// append adds a mailbox to an address field, after the ones there.
		internal def append(field string, address string, name string) Message {
			let entry = new Address(address, name).str()
			let current = orEmpty(header.raw(field)).trim()
			header.set(field, current == "" ?? (entry, current + ", " + entry))
			return self
		}

		// idDomain is the domain a fresh `Message-ID` uses: the author's,
		// else `localhost`.
		internal def idDomain() string {
			let authors = from() onerror recover []
			let domain = authors.len() > 0 ?? (authors[0].domain(), "")
			return domain == "" ?? ("localhost", domain)
		}

		// typeOf is the media type an attachment gets: `given`, else the one
		// of the name's extension, else the one its content looks like.
		internal def typeOf(name string, data byte[], given ?MediaType) MediaType {
			return given unless given is none
			let byName = formats.typeByExtension(os.extension(name))
			let text = byName is none ?? (formats.detectContentType(data), orEmpty(byName))
			return formats.parseMediaType(text) onerror recover new MediaType("application", "octet-stream")
		}
	}
}
