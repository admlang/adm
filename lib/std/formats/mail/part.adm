partial module std.formats.mail {
	use (
		std.formats
		std.formats::(MediaType)
		std.formats.mail.wire::*
	)

	// Part is one MIME entity (RFC 2045–2046): headers and either content
	// or, for a `multipart/*` type, child parts. The content is kept
	// decoded; the transfer encoding is picked when the part is written
	// (7bit, quoted-printable for mostly-ASCII text, base64 otherwise)
	// unless `Content-Transfer-Encoding` was set by hand.
	type Part {
		header Header = new Header()
		// The children of a multipart part, empty otherwise.
		parts  Part[] = []

		internal content byte[] = []

		// A leaf part holding `data` as `mediaType`.
		def new(mediaType MediaType, data byte[]) {
			header.set("Content-Type", mediaType.str())
			content = data
		}

		// An empty multipart part of `subtype` (`mixed`, `alternative`,
		// `related`), with a fresh boundary.
		def new(subtype string) {
			header.set("Content-Type", formats.formatMediaType("multipart", subtype, map<string, string>{"boundary": newBoundary()}))
		}

		// `Content-Type`, `text/plain; charset=us-ascii` when it is absent
		// (RFC 2045 §5.2).
		def contentType() MediaType {
			return contentTypeOf(header)
		}

		// The decoded content; empty for a multipart part.
		def data() byte[] {
			return content
		}

		// Replaces the content.
		def data(bytes byte[]) {
			content = bytes
			header.remove("Content-Transfer-Encoding")
		}

		// The content as text, converted from the `charset` parameter.
		// Fails when the part is not `text/*` or the charset is unknown.
		def text() !string {
			let mediaType = contentType()
			fail mailError("BadMime", "{mediaType.essence()} is not text") unless mediaType.mainType == "text"
			return try decodeCharset(content, orEmpty(mediaType.charset()))
		}

		// The file name, from `Content-Disposition` `filename` (RFC 2231
		// continuations and charsets decoded) or `Content-Type` `name`;
		// none when neither is set.
		def filename() ?string {
			let name = dispositionParam(header, "filename")
			name = contentType().param("name") when name is none
			return none when name is none
			return decodeText(name)
		}

		// `Content-ID` without its angle brackets, none when absent.
		def contentId() ?string {
			let raw = header.raw("Content-ID")
			return none when raw is none
			return raw.trim().trimPrefix("<").trimSuffix(">")
		}

		// Whether the part is `multipart/*`, holding child parts.
		def isMultipart() bool {
			return contentType().mainType == "multipart"
		}

		// Whether `Content-Disposition` is `attachment`, or the part has a
		// file name and is not `inline`.
		def isAttachment() bool {
			return false when isMultipart()
			let kind = dispositionKind(header)
			return true when kind == "attachment"
			return false when kind == "inline"
			return !(filename() is none)
		}

		// Appends a child to a multipart part and returns it.
		def add(part Part) Part {
			parts.push(part)
			return part
		}

		// This part and every part below it, depth first.
		def walk() Part[] {
			let out Part[] = [self]
			for let child in parts {
				for let p in child.walk() {
					out.push(p)
				}
			}
			return out
		}
	}
}
