internal partial module std.formats.mail.wire {
	use (
		std.bytes
		std.crypto
		std.data.encoding
		std.data.encoding.codepages
		std.formats
		std.formats::(MediaType)
		std.formats.mail::*
		std.strings::(Scanner)
		std.time
	)

	// The deepest MIME nesting parsed; deeper parts are kept as leaves.
	const maxDepth = 50

	// The column a header line is folded at (RFC 5322 §2.1.1).
	const foldColumn = 78

	// mailError is the MailError of `code` with `message`.
	def mailError(code string, message string) MailError {
		return MailError{message: "mail: " + message, code: code}
	}

	// randomToken is 2 × `size` hex digits from the system's random source,
	// a clock reading when it is unavailable.
	def randomToken(size int) string {
		let random = crypto.rand(size) onerror recover []
		return random.hex() unless random.len() == 0
		return "{time.now().unixNs()}"
	}

	// ---- header block ----------------------------------------------------

	// headerEnd finds the blank line that ends a header block: the offset
	// the block ends at and the offset the body starts at. A block with no
	// blank line takes the whole input.
	def headerEnd(data byte[]) (int, int) {
		// An entity that starts with the blank line has no header.
		return (0, 2) when data.len() >= 2 && data[0] == 0x0D && data[1] == 0x0A
		return (0, 1) when data.len() >= 1 && data[0] == 0x0A
		for let i = 0; i < data.len(); i++ {
			continue unless data[i] == 0x0A
			return (i + 1, i + 2) when i + 1 < data.len() && data[i + 1] == 0x0A
			return (i + 1, i + 3) when i + 2 < data.len() && data[i + 1] == 0x0D && data[i + 2] == 0x0A
		}
		return (data.len(), data.len())
	}

	// parseHeader reads a header block: `Name: value` lines, a line that
	// starts with a space or tab continuing the one before (unfolded by
	// dropping the line break). An mbox `From ` line at the very start is
	// skipped. Fails on a line that is neither a field nor a continuation.
	def parseHeader(block byte[]) !Header {
		let header = new Header()
		for let field in try parseFields(block) {
			let (name, value) = field
			header.add(name, value)
		}
		return header
	}

	// parseFields reads the fields of a header block as name and value
	// pairs, in order; see `parseHeader`.
	def parseFields(block byte[]) !(string, string)[] {
		let fields (string, string)[] = []
		let name = ""
		let value = ""
		let first = true
		for let line in splitLines(block) {
			if first && line.startsWith("From ") {
				first = false
				continue
			}
			first = false
			continue when line == ""
			if line[0] := ' ' || '\t' {
				fail mailError("BadHeader", "continuation line before any field") when name == ""
				value += line
				continue
			}
			let colon = line.indexOf(":")
			fail mailError("BadHeader", "not a header field: " + line.truncate(60)) when colon <= 0
			fields.push((name, value.trim())) when name != ""
			name = line[:colon].trimEnd()
			value = line[colon + 1:]
		}
		fields.push((name, value.trim())) when name != ""
		return fields
	}

	// splitLines cuts bytes at LF, dropping a CR before it, and reads each
	// line as UTF-8.
	def splitLines(data byte[]) string[] {
		let lines string[] = []
		let start = 0
		for let i = 0; i <= data.len(); i++ {
			continue unless i == data.len() || data[i] == 0x0A
			let end = i
			end-- when end > start && data[end - 1] == 0x0D
			lines.push(string(data.slice(start, end - start))) unless i == data.len() && start == i
			start = i + 1
		}
		return lines
	}

	// The fields whose value is an address list.
	let addressFields = ["from", "sender", "reply-to", "to", "cc", "bcc", "resent-from", "resent-sender", "resent-to", "resent-cc", "resent-bcc", "disposition-notification-to", "return-receipt-to"]

	// The fields whose value is structured text other than addresses; they
	// are written as given.
	let structuredFields = ["date", "resent-date", "message-id", "resent-message-id", "in-reply-to", "references", "received", "return-path", "mime-version", "content-type", "content-disposition", "content-transfer-encoding", "content-id", "content-location", "list-id", "list-unsubscribe", "list-post", "dkim-signature", "authentication-results", "arc-seal", "arc-message-signature", "arc-authentication-results"]

	// encodeField renders a field value for the wire: printable ASCII as
	// is, else address lists with their display names encoded and
	// unstructured text as RFC 2047 encoded words.
	def encodeField(name string, value string) string {
		return value when isPlainASCII(value)
		let key = name.lower()
		if addressFields.indexOf(key) >= 0 {
			let list = readAddressList(value) onerror recover []
			if list.len() > 0 {
				let parts string[] = []
				for let a in list {
					parts.push(a.str())
				}
				return parts.join(", ")
			}
		}
		return value when structuredFields.indexOf(key) >= 0
		return encoding.encodeWord(value)
	}

	// isPlainASCII reports text of printable ASCII, spaces and tabs only.
	def isPlainASCII(text string) bool {
		for let b in text.bytes() {
			return false when b > 0x7E || (b < 0x20 && b != 0x09)
		}
		return true
	}

	// fold writes `name: value` with CRLF, breaking before whitespace so no
	// line passes 78 columns where the value allows it.
	def fold(name string, value string) string {
		let line = name + ": " + value
		return line + "\r\n" when line.len() <= foldColumn
		let out = ""
		let current = name + ":"
		let words = value.split(" ")
		for let i = 0; i < words.len(); i++ {
			let word = words[i]
			if current.len() + 1 + word.len() > foldColumn && current.trim() != "" && current != name + ":" {
				out += current + "\r\n"
				current = " " + word
				continue
			}
			current += " " + word
		}
		return out + current + "\r\n"
	}

	// ---- MIME entities ---------------------------------------------------

	// parseEntity reads one MIME entity: its header, then its body decoded
	// or, for a multipart type, split into child entities.
	def parseEntity(data byte[], depth int) !Part {
		let (end, bodyStart) = headerEnd(data)
		let header = try parseHeader(data.slice(0, end))
		return try entityOf(header, data.slice(bodyStart, data.len() - bodyStart), depth)
	}

	// entityOf builds the part of a parsed header over its raw body.
	def entityOf(header Header, body byte[], depth int) !Part {
		let mediaType = contentTypeOf(header)
		let boundary = orEmpty(mediaType.boundary())
		if mediaType.mainType == "multipart" && boundary != "" && depth < maxDepth {
			let part = new Part(mediaType.subtype)
			part.header = header
			for let child in splitMultipart(body, boundary) {
				part.add(try parseEntity(child, depth + 1))
			}
			return part
		}
		let part = new Part(mediaType, decodeTransfer(header, body))
		part.header = header
		return part
	}

	// contentTypeOf is a header's `Content-Type`, `text/plain;
	// charset=us-ascii` when it is absent or does not parse (RFC 2045 §5.2).
	def contentTypeOf(header Header) MediaType {
		let raw = header.raw("Content-Type")
		let fallback = new MediaType("text", "plain", map<string, string>{"charset": "us-ascii"})
		return fallback when raw is none
		let parsed = formats.parseMediaType(raw) onerror recover fallback
		return fallback when parsed.subtype == ""
		return parsed
	}

	// dispositionKind is the lower-cased kind of a header's
	// `Content-Disposition` (`attachment`, `inline`), empty when it is
	// absent or does not parse.
	def dispositionKind(header Header) string {
		let raw = header.raw("Content-Disposition")
		return "" when raw is none
		let parsed = formats.parseMediaType(raw) onerror recover new MediaType("", "")
		return parsed.mainType
	}

	// dispositionParam is a parameter of a header's `Content-Disposition`,
	// none when the field or the parameter is absent.
	def dispositionParam(header Header, name string) ?string {
		let raw = header.raw("Content-Disposition")
		return none when raw is none
		let parsed = formats.parseMediaType(raw) onerror recover new MediaType("", "")
		return parsed.param(name)
	}

	// splitMultipart cuts a multipart body at its delimiter lines
	// (`--boundary`, trailing whitespace allowed) and returns the entities
	// between them. The preamble and epilogue are dropped; a body whose
	// closing delimiter is missing ends at its last byte. The line break
	// before a delimiter belongs to the delimiter.
	def splitMultipart(body byte[], boundary string) byte[][] {
		let delimiter = ("--" + boundary).bytes()
		let parts byte[][] = []
		let start = -1
		let lineStart = 0
		for lineStart <= body.len() {
			let lineEnd = lineStart
			for lineEnd < body.len() && body[lineEnd] != 0x0A {
				lineEnd++
			}
			let kind = delimiterKind(body, lineStart, lineEnd, delimiter)
			if kind > 0 {
				if start >= 0 {
					let end = lineStart
					end-- when end > start && body[end - 1] == 0x0A
					end-- when end > start && body[end - 1] == 0x0D
					parts.push(body.slice(start, end - start))
				}
				return parts when kind == 2
				start = lineEnd + 1
			}
			lineStart = lineEnd + 1
		}
		parts.push(body.slice(start, body.len() - start)) when start >= 0 && start <= body.len()
		return parts
	}

	// delimiterKind classifies the line body[from:to]: 1 for a delimiter,
	// 2 for the closing one, 0 for anything else.
	def delimiterKind(body byte[], from int, to int, delimiter byte[]) int {
		return 0 when to - from < delimiter.len()
		for let i = 0; i < delimiter.len(); i++ {
			return 0 when body[from + i] != delimiter[i]
		}
		let i = from + delimiter.len()
		let closing = false
		if i + 1 < to && body[i] == 0x2D && body[i + 1] == 0x2D {
			closing = true
			i += 2
		}
		for i < to {
			return 0 unless body[i] := 0x20 || 0x09 || 0x0D
			i++
		}
		return closing ?? (2, 1)
	}

	// decodeTransfer undoes the `Content-Transfer-Encoding` of a body:
	// base64 and quoted-printable are decoded, 7bit, 8bit, binary and any
	// unknown encoding pass through, as does a body that fails to decode.
	def decodeTransfer(header Header, body byte[]) byte[] {
		let cte = orEmpty(header.raw("Content-Transfer-Encoding")).trim().lower()
		if cte == "base64" {
			let clean byte[] = []
			for let b in body {
				clean.push(b) unless b := 0x20 || 0x09 || 0x0D || 0x0A
			}
			return encoding.base64decode(string(clean)) onerror recover body
		}
		if cte == "quoted-printable" {
			return encoding.quotedPrintableDecode(string(body)) onerror recover body
		}
		return body
	}

	// decodeText undoes the encoded words of a value, keeping it as is
	// when one does not decode.
	def decodeText(value string) string {
		return value unless value.contains("=?")
		return encoding.decodeWords(value) onerror recover value
	}

	// orEmpty is the text of an optional, empty when none.
	def orEmpty(text ?string) string {
		return "" when text is none
		return text
	}

	// encodeEntity writes a part in wire form: its header, a blank line,
	// then its content in a transfer encoding, or its children between
	// delimiters.
	def encodeEntity(part Part, out bytes.Buffer) {
		let mediaType = part.contentType()
		if mediaType.mainType == "multipart" {
			let boundary = orEmpty(mediaType.boundary())
			if boundary == "" {
				boundary = newBoundary()
				part.header.set("Content-Type", mediaType.with("boundary", boundary).str())
			}
			put(out, part.header.str())
			put(out, "\r\n")
			for let child in part.parts {
				put(out, "--{boundary}\r\n")
				encodeEntity(child, out)
				put(out, "\r\n")
			}
			put(out, "--{boundary}--\r\n")
			return
		}
		let data = part.data()
		let isText = mediaType.mainType == "text"
		data = crlfLines(data) when isText
		let given = part.header.raw("Content-Transfer-Encoding")
		let cte = given is none ?? (pickTransfer(mediaType, data), orEmpty(given).trim().lower())
		put(out, part.header.str())
		put(out, "Content-Transfer-Encoding: {cte}\r\n") when given is none && cte != "7bit"
		put(out, "\r\n")
		if cte == "base64" {
			put(out, base64Lines(data))
		} else if cte == "quoted-printable" {
			put(out, encoding.quotedPrintableEncode(data))
		} else {
			put(out, data)
		}
	}

	// put writes text or bytes to a buffer, which does not fail.
	def put(out bytes.Buffer, text string) {
		put(out, text.bytes())
	}

	def put(out bytes.Buffer, data byte[]) {
		let _ = out.write(data) onerror recover 0
	}

	// pickTransfer chooses the transfer encoding of content: 7bit when it is
	// short-lined ASCII (with CRLF line ends for text, no line ends at all
	// otherwise), quoted-printable for mostly-ASCII text, base64 for the
	// rest. `message/*` content is never encoded (RFC 2046 §5.2.1), so it
	// goes as 8bit when it is not 7bit.
	def pickTransfer(mediaType MediaType, data byte[]) string {
		let high = 0
		let lineLength = 0
		let longLine = false
		let bareBreak = false
		let nul = false
		for let i = 0; i < data.len(); i++ {
			let b = data[i]
			high++ when b >= 0x80
			nul = true when b == 0
			if b == 0x0A {
				bareBreak = true unless i > 0 && data[i - 1] == 0x0D
				lineLength = 0
				continue
			}
			bareBreak = true when b == 0x0D && !(i + 1 < data.len() && data[i + 1] == 0x0A)
			lineLength++
			longLine = true when lineLength > 998
		}
		let clean = high == 0 && !nul && !longLine && !bareBreak
		return clean ?? ("7bit", "8bit") when mediaType.mainType == "message"
		if mediaType.mainType == "text" {
			return "7bit" when clean
			return "quoted-printable" when !nul && high * 3 <= data.len()
			return "base64"
		}
		let hasBreak = false
		for let b in data {
			hasBreak = true when b := 0x0A || 0x0D
		}
		return "7bit" when clean && !hasBreak
		return "base64"
	}

	// crlfLines turns every bare LF or CR into CRLF, the canonical line end
	// of text (RFC 2046 §4.1.1).
	def crlfLines(data byte[]) byte[] {
		let clean = true
		for let i = 0; i < data.len(); i++ {
			clean = false when data[i] == 0x0A && !(i > 0 && data[i - 1] == 0x0D)
			clean = false when data[i] == 0x0D && !(i + 1 < data.len() && data[i + 1] == 0x0A)
		}
		return data when clean
		let out byte[] = []
		out.cap(data.len() + data.len() / 16)
		for let i = 0; i < data.len(); i++ {
			let b = data[i]
			if b == 0x0D {
				out.push(0x0D)
				out.push(0x0A)
				i++ when i + 1 < data.len() && data[i + 1] == 0x0A
				continue
			}
			if b == 0x0A {
				out.push(0x0D)
				out.push(0x0A)
				continue
			}
			out.push(b)
		}
		return out
	}

	// base64Lines is base64 cut into 76-column lines joined by CRLF.
	def base64Lines(data byte[]) string {
		let text = encoding.base64encode(data)
		return text when text.len() <= 76
		let lines string[] = []
		for let i = 0; i < text.len(); i += 76 {
			let end = i + 76 > text.len() ?? (text.len(), i + 76)
			lines.push(text[i:end])
		}
		return lines.join("\r\n")
	}

	// newBoundary is a fresh multipart delimiter, a token no content holds.
	def newBoundary() string {
		return "adm-" + randomToken(12)
	}

	// decodeCharset reads bytes in a MIME charset: UTF-8 and US-ASCII, and
	// the code pages `codepages.forCharset` knows. Fails on another one.
	def decodeCharset(data byte[], charset string) !string {
		let cs = charset.trim().lower()
		return string(data) when cs := "" || "utf-8" || "utf8" || "us-ascii" || "ascii"
		let page = codepages.forCharset(cs)
		fail mailError("BadEncoding", "unsupported charset \"{charset}\"") when page is none
		return codepages.decode(data, page)
	}

	// ---- message layout ------------------------------------------------

	// Layout is the pieces of a message body the builder methods arrange:
	// the text and HTML bodies, the inline parts the HTML refers to, and
	// the attachments.
	struct Layout {
		text        ?Part
		html        ?Part
		inline      Part[]
		attachments Part[]
	}

	// layoutOf sorts the leaves of a body into a Layout: the first plain
	// text and the first HTML that are not attachments are the bodies,
	// other parts with a `Content-ID` that are not attachments are inline,
	// the rest are attachments. An empty text leaf is dropped.
	def layoutOf(body Part) Layout {
		let layout = Layout{text: none, html: none, inline: [], attachments: []}
		for let part in body.walk() {
			continue when part.isMultipart()
			let essence = part.contentType().essence()
			let attached = part.isAttachment()
			if !attached && essence == "text/plain" && layout.text is none {
				layout.text = part unless part.data().len() == 0
				continue
			}
			if !attached && essence == "text/html" && layout.html is none {
				layout.html = part
				continue
			}
			if !attached && !(part.contentId() is none) {
				layout.inline.push(part)
				continue
			}
			layout.attachments.push(part)
		}
		return layout
	}

	// assemble builds the body of a Layout: `multipart/alternative` over
	// text and HTML, `multipart/related` over that and the inline parts,
	// `multipart/mixed` over that and the attachments, each level left out
	// when it would hold one part. Inline parts without an HTML body go
	// with the attachments.
	def assemble(layout Layout) Part {
		let core Part[] = []
		let text = layout.text
		let html = layout.html
		core.push(text) unless text is none
		core.push(html) unless html is none
		if core.len() == 2 {
			let alternative = new Part("alternative")
			alternative.add(core[0])
			alternative.add(core[1])
			core = [alternative]
		}
		let attachments = layout.attachments.clone()
		if layout.inline.len() > 0 && !(html is none) {
			let related = new Part("related")
			related.add(core[0])
			for let part in layout.inline {
				related.add(part)
			}
			core = [related]
		} else {
			for let part in layout.inline {
				attachments.push(part)
			}
		}
		if attachments.len() == 0 {
			return core[0] when core.len() == 1
			return new Part(new MediaType("text", "plain", map<string, string>{"charset": "utf-8"}), [])
		}
		let mixed = new Part("mixed")
		mixed.add(core[0]) when core.len() == 1
		for let part in attachments {
			mixed.add(part)
		}
		return mixed
	}

	// ---- addresses (RFC 5322 §3.4, RFC 6532) ------------------------------

	// readAddressList reads an address list, groups flattened, empty
	// entries skipped.
	def readAddressList(text string) !Address[] {
		let s = new Scanner(text)
		let out Address[] = []
		for {
			skipCfws(s)
			break when s.atEnd()
			continue when s.expect(',')
			try readAddress(s, out, true, text)
			skipCfws(s)
			break when s.atEnd()
			fail badAddress(text) unless s.expect(',')
		}
		return out
	}

	// badAddress is the MailError of text that is no address.
	def badAddress(text string) MailError {
		return mailError("BadAddress", "not an address: " + text.truncate(80))
	}

	// readAddress reads a mailbox, or with `group` a group, into `out`.
	def readAddress(s Scanner, out Address[], group bool, text string) !none {
		let (words, raw) = try readPhrase(s, text)
		skipCfws(s)
		if s.expect('<') {
			let spec = try readAngle(s, text)
			out.push(new Address(spec, displayName(words)))
			return none
		}
		if group && s.expect(':') {
			for {
				skipCfws(s)
				break when s.atEnd() || s.expect(';')
				continue when s.expect(',')
				try readAddress(s, out, false, text)
			}
			return none
		}
		if s.expect('@') {
			fail badAddress(text) when raw == ""
			let domain = try readDomain(s, text)
			out.push(new Address(raw + "@" + domain, ""))
			return none
		}
		fail badAddress(text)
	}

	// readPhrase reads words (atoms, dotted atoms and quoted strings): the
	// words decoded, and the text they make without the spaces between
	// them, which is a local part when an `@` follows.
	def readPhrase(s Scanner, text string) !(string[], string) {
		let words string[] = []
		let raw = ""
		for {
			skipCfws(s)
			let c = s.peek()
			break when c is none
			if c == '"' {
				s.next()
				let (word, quoted) = try readQuoted(s, text)
				words.push(word)
				raw += quoted
				continue
			}
			break unless isAtext(c) || c == '.'
			let atom = s.takeWhile(ch => isAtext(ch) || ch == '.')
			words.push(atom)
			raw += atom
		}
		return (words, raw)
	}

	// readQuoted reads a quoted string after its opening quote: its content
	// with the escapes undone, and the string as written, quotes included.
	def readQuoted(s Scanner, text string) !(string, string) {
		let value = ""
		let written = "\""
		for {
			let c = s.next()
			fail badAddress(text) when c is none
			if c == '\\' {
				let escaped = s.next()
				fail badAddress(text) when escaped is none
				value += string(escaped)
				written += "\\" + string(escaped)
				continue
			}
			written += string(c)
			return (value, written) when c == '"'
			value += string(c) unless c := '\r' || '\n'
		}
		return (value, written)
	}

	// readAngle reads `addr-spec>` after `<`, an obsolete source route
	// (`@a,@b:`) skipped; `<>` is the empty address.
	def readAngle(s Scanner, text string) !string {
		skipCfws(s)
		return "" when s.expect('>')
		if peekIs(s, '@') {
			s.takeUntil(c => c == ':')
			fail badAddress(text) unless s.expect(':')
		}
		let (_, local) = try readPhrase(s, text)
		fail badAddress(text) unless local != "" && s.expect('@')
		let domain = try readDomain(s, text)
		skipCfws(s)
		fail badAddress(text) unless s.expect('>')
		return local + "@" + domain
	}

	// readDomain reads a dotted domain or a `[literal]`.
	def readDomain(s Scanner, text string) !string {
		skipCfws(s)
		if s.expect('[') {
			let literal = s.takeUntil(c => c == ']')
			fail badAddress(text) unless s.expect(']')
			return "[" + literal + "]"
		}
		let domain = s.takeWhile(c => isAtext(c) || c == '.')
		fail badAddress(text) when domain == "" || domain.startsWith(".") || domain.endsWith(".")
		return domain
	}

	// peekIs reports whether the next character is `c`.
	def peekIs(s Scanner, c char) bool {
		let next = s.peek()
		return false when next is none
		return next == c
	}

	// skipCfws skips whitespace and comments, nested ones included.
	def skipCfws(s Scanner) {
		for {
			s.skipSpaces()
			return unless peekIs(s, '(')
			let depth = 0
			for {
				let c = s.next()
				return when c is none
				if c == '\\' {
					s.next()
				} else if c == '(' {
					depth++
				} else if c == ')' {
					depth--
					break when depth == 0
				}
			}
		}
	}

	// isAtext reports a character an atom may hold; non-ASCII is allowed
	// (RFC 6532).
	def isAtext(c char) bool {
		return true when c.isAlphanumeric() || int(c) > 0x7F
		return "!#$%&'*+-/=?^_`{|}~".contains(string(c))
	}

	// displayName joins the words of a phrase and decodes its encoded
	// words.
	def displayName(words string[]) string {
		let name = words.join(" ")
		return encoding.decodeWords(name) onerror recover name
	}

	// formatAddress writes a mailbox for a header: the address alone, else
	// the name as an atom phrase, a quoted string or encoded words.
	def formatAddress(name string, address string) string {
		return address when name == ""
		let angle = "<" + address + ">"
		return name + " " + angle when isPhrase(name)
		return "\"" + name.replace("\\", "\\\\").replace("\"", "\\\"") + "\" " + angle when isPlainASCII(name)
		return encoding.encodeWord(name) + " " + angle
	}

	// isPhrase reports a name that can go unquoted: ASCII atoms and single
	// spaces.
	def isPhrase(name string) bool {
		return false when name.trim() != name || name.contains("  ")
		for let c in name {
			return false unless c == ' ' || (int(c) <= 0x7F && isAtext(c))
		}
		return true
	}

	// lastAt is the index of the last `@` in an address, -1 when none.
	def lastAt(address string) int {
		let at = -1
		for let i = 0; i < address.len(); i++ {
			at = i when address[i] == '@'
		}
		return at
	}

	// messageIds reads the `<id>` tokens of `Message-ID`, `In-Reply-To` and
	// `References`, without the brackets.
	def messageIds(text string) string[] {
		let ids string[] = []
		let i = 0
		for {
			let open = text.indexOf("<", i)
			break when open < 0
			let close = text.indexOf(">", open)
			break when close < 0
			let id = text[open + 1:close].trim()
			ids.push(id) when id != ""
			i = close + 1
		}
		return ids
	}
}
