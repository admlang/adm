internal std.formats partial module std.formats.media.asf {
	use (
		std.io
		std.bytes
	)

	// Appends an object: its GUID, its size and its body.
	def asfObject(out bytes.Buffer, guid string, body byte[]) {
		out.write(asfGuid(guid)) onerror recover 0
		asfPut(out, 24 + body.len(), 8)
		out.write(body) onerror recover 0
	}

	// Appends `v` as `size` little-endian bytes.
	def asfPut(out bytes.Buffer, v int, size int) {
		let b byte[]
		b.len(size)
		for let i = 0; i < size; i++ {
			b[i] = byte((v >> (8 * i)) & 0xFF)
		}
		out.write(b) onerror recover 0
	}

	// A string as NUL-terminated UTF-16LE.
	def asfEncodeText(s string) byte[] {
		let out byte[]
		let b = s.bytes()
		let i = 0
		for i < b.len() {
			let c = int(b[i])
			let cp = c
			let extra = 0
			if c >= 0xF0 {
				cp = c & 0x07
				extra = 3
			} else if c >= 0xE0 {
				cp = c & 0x0F
				extra = 2
			} else if c >= 0xC0 {
				cp = c & 0x1F
				extra = 1
			}
			i++
			for let k = 0; k < extra && i < b.len(); k++ {
				cp = (cp << 6) | (int(b[i]) & 0x3F)
				i++
			}
			if cp >= 0x10000 {
				cp -= 0x10000
				let hi = 0xD800 + (cp >> 10)
				let lo = 0xDC00 + (cp & 0x3FF)
				out.push(byte(hi & 0xFF), byte(hi >> 8), byte(lo & 0xFF), byte(lo >> 8))
			} else {
				out.push(byte(cp & 0xFF), byte(cp >> 8))
			}
		}
		out.push(byte(0), byte(0))
		return out
	}

	// Writes all of `data`. Fails when the writer does or stops accepting
	// bytes.
	def asfWriteAll(writer io.Writer, data byte[]) !none {
		let n = 0
		for n < data.len() {
			let got = try writer.write(data[n:])
			fail "asf: the writer accepted no bytes" when got <= 0
			n += got
		}
		return none
	}
}
