partial module std.formats {
	use (
		std.errors
		std.os
		std.strings::(Scanner)
	)

	// MimeError is the payload of every failure in this file: a media type that
	// does not parse, a parameter repeated or malformed, an extension that is
	// not registered.
	struct MimeError {
		message string
		code    string            = "mime"
		cause   ?error
		stack   errors.StackTrace
		// The operation that failed: "parse", "format", "extension".
		op      string
		// The text that was being read.
		text    string
	}

	// MediaType is a parsed `type/subtype; param=value` header value, as found
	// in `Content-Type` and `Content-Disposition` (whose value, `form-data`
	// or `attachment`, has no subtype): the type and subtype are lower-cased, parameter names are lower-cased, parameter values keep
	// their case. RFC 2045 syntax, RFC 2231 continuations and charsets
	// (`title*0*=us-ascii'en'This%20is`) are folded into one value on parse.
	//
	// Example:
	// ```example
	// let mt = try formats.parseMediaType("Text/HTML; Charset=\"utf-8\"")
	// println(mt.essence())     // text/html
	// println(mt.charset())     // utf-8
	// println(mt.str())         // text/html; charset=utf-8
	// println(mt.isText())      // true
	// ```
	type MediaType {
		// The main type: `text`, `image`, `application`, `multipart`.
		mainType string
		// The subtype: `html`, `png`, `json`, `form-data`.
		subtype  string
		// Parameters in first-seen order, names lower-cased.
		params   map<string, string>

		def new(mainType string, subtype string, params map<string, string> = map<string, string>{}) {
			self.mainType = mainType.lower()
			self.subtype = subtype.lower()
			self.params = map<string, string>{}
			for let (name, value) in params {
				self.params.set(name.lower(), value)
			}
		}

		// essence is `type/subtype` without parameters, the form a lookup or
		// comparison wants.
		def essence() string {
			return mainType when subtype == ""
			return mainType + "/" + subtype
		}

		// param returns one parameter by name (case-insensitive), none when
		// absent.
		def param(name string) ?string {
			return params.get(name.lower())
		}

		// charset is the `charset` parameter lower-cased, none when absent.
		def charset() ?string {
			let value = params.get("charset")
			return none when value is none
			return value.lower()
		}

		// with returns a copy with the parameter set; an empty value removes
		// it.
		def with(name string, value string) MediaType {
			let copy = map<string, string>{}
			for let (key, current) in params {
				copy.set(key, current) unless key == name.lower()
			}
			copy.set(name.lower(), value) unless value == ""
			return new MediaType(mainType, subtype, copy)
		}

		// isText reports a `text/*` type or one of the textual application
		// types (`json`, `xml`, `javascript`, `+json`/`+xml` suffixes).
		def isText() bool {
			return true when mainType == "text"
			return false unless mainType == "application"
			return true when subtype := "json" || "xml" || "javascript" || "ecmascript" || "x-www-form-urlencoded" || "yaml" || "toml"
			return subtype.endsWith("+json") || subtype.endsWith("+xml")
		}

		// isMultipart reports a `multipart/*` type; `boundary()` then holds
		// its boundary.
		def isMultipart() bool {
			return mainType == "multipart"
		}

		// boundary is the `boundary` parameter of a multipart type, none
		// otherwise.
		def boundary() ?string {
			return none unless isMultipart()
			return params.get("boundary")
		}

		// matches reports whether this type falls under a pattern such as
		// `image/*`, `*/*` or an exact `text/html`; parameters are ignored.
		def matches(pattern string) bool {
			let want = pattern.trim().lower()
			let slash = want.indexOf("/")
			return false when slash < 0
			let wantType = want[:slash]
			let wantSub = want[slash + 1:]
			return false unless wantType == "*" || wantType == mainType
			return wantSub == "*" || wantSub == subtype
		}

		// str renders the type and its parameters in header form: values are
		// quoted when they hold a tspecial, a space or a non-ASCII byte, and
		// a value that cannot be quoted is written as an RFC 2231 encoded
		// parameter (`name*=utf-8''...`).
		def str() string {
			return formatMediaType(mainType, subtype, params)
		}
	}

	// parseMediaType reads a media type with its parameters. Fails with
	// MimeError (op "parse") when the type is missing a slash, holds an
	// illegal token character, or a parameter is malformed or repeated.
	//
	// Example:
	// ```example
	// let mt = try formats.parseMediaType("multipart/form-data; boundary=xyz")
	// println(mt.boundary())  // xyz
	// ```
	def parseMediaType(text string) !MediaType {
		let s = new Scanner(text)
		s.skipSpaces()
		let head = s.takeUntil(c => c == ';' || c.isSpace())
		// A Content-Disposition value (`form-data; name=x`) has no subtype;
		// it parses the same way with an empty subtype.
		let slash = head.indexOf("/")
		let mainType = slash < 0 ?? (head, head[:slash])
		let subtype = slash < 0 ?? ("", head[slash + 1:])
		fail MimeError{message: "media type has an empty or invalid type", op: "parse", text: text} unless isToken(mainType) && (slash < 0 || isToken(subtype))
		let raw = try parseParams(s, text)
		let params = try foldContinuations(raw, text)
		return new MediaType(mainType, subtype, params)
	}

	// A parameter as written, before RFC 2231 pieces are joined.
	internal struct RawParam {
		name    string
		value   string
		// The name carried a trailing `*`: the value is charset'lang'percent-encoded.
		encoded bool
		// Continuation index from `name*N`, -1 for a plain parameter.
		index   int
	}

	// Reads `; name=value` pairs from the scanner until the text ends. A
	// value is a token or a quoted string with backslash escapes.
	internal def parseParams(s Scanner, text string) !RawParam[] {
		let out RawParam[] = []
		for {
			s.skipSpaces()
			break when s.atEnd()
			fail MimeError{message: "expected ';' before parameter", op: "parse", text: text} unless s.expect(';')
			s.skipSpaces()
			break when s.atEnd()
			let name = s.takeUntil(c => c == '=' || c == ';' || c.isSpace())
			fail MimeError{message: "parameter name is empty", op: "parse", text: text} when name == ""
			s.skipSpaces()
			fail MimeError{message: "parameter '{name}' has no value", op: "parse", text: text} unless s.expect('=')
			s.skipSpaces()
			let value = ""
			if s.expect('"') {
				let closed = false
				for !s.atEnd() {
					let got = s.next()
					break when got is none
					let ch = got
					if ch == '"' {
						closed = true
						break
					}
					if ch == '\\' && !s.atEnd() {
						let escaped = s.next()
						break when escaped is none
						value += string(escaped)
						continue
					}
					value += string(ch)
				}
				fail MimeError{message: "unterminated quoted value for '{name}'", op: "parse", text: text} unless closed
			} else {
				value = s.takeUntil(c => c == ';' || c.isSpace())
			}
			let lowered = name.lower()
			let encoded = lowered.endsWith("*")
			let base = encoded ?? (lowered[:lowered.len() - 1], lowered)
			let index = -1
			let star = lastIndexOf(base, "*")
			if star >= 0 && star < base.len() - 1 && base[star + 1:].isNumeric() {
				index = base[star + 1:].toInt<int>()
				base = base[:star]
			}
			fail MimeError{message: "parameter name '{base}' is not a token", op: "parse", text: text} unless isToken(base)
			out.push(RawParam{name: base, value: value, encoded: encoded, index: index})
		}
		return out
	}

	// Joins RFC 2231 continuations (`title*0*`, `title*1`) into one value per
	// name and decodes the charset'lang'percent form. Fails on a repeated
	// parameter or a charset other than UTF-8, US-ASCII or ISO-8859-1.
	internal def foldContinuations(raw RawParam[], text string) !map<string, string> {
		let out = map<string, string>{}
		let pieces = map<string, RawParam[]>{}
		let order string[] = []
		for let p in raw {
			if p.index < 0 && !p.encoded {
				fail MimeError{message: "parameter '{p.name}' repeated", op: "parse", text: text} when out.hasKey(p.name) || pieces.hasKey(p.name)
				out.set(p.name, p.value)
				continue
			}
			fail MimeError{message: "parameter '{p.name}' repeated", op: "parse", text: text} when out.hasKey(p.name)
			if !pieces.hasKey(p.name) {
				pieces.set(p.name, [])
				order.push(p.name)
			}
			let list = orNoParams(pieces.get(p.name))
			list.push(p)
			pieces.set(p.name, list)
		}
		for let name in order {
			let list = orNoParams(pieces.get(name))
			list.sort((a, b) => a.index < b.index)
			let charset = ""
			let bytes byte[] = []
			let plain = ""
			let first = true
			for let p in list {
				if !p.encoded {
					fail MimeError{message: "parameter '{name}' repeated", op: "parse", text: text} when list.len() > 1 && p.index < 0
					plain += p.value
					continue
				}
				let value = p.value
				if first {
					let q1 = value.indexOf("'")
					let q2 = q1 < 0 ?? (-1, value.indexOf("'", q1 + 1))
					if q1 >= 0 && q2 >= 0 {
						charset = value[:q1].lower()
						value = value[q2 + 1:]
					}
				}
				first = false
				bytes = bytes.concat(try percentDecode(value, text))
			}
			let decoded = try decodeCharset(bytes, charset, text)
			out.set(name, decoded + plain)
		}
		return out
	}

	// percentDecode turns `%XX` escapes into bytes; other bytes pass through.
	internal def percentDecode(value string, text string) !byte[] {
		let raw = value.bytes()
		let out byte[] = []
		let i = 0
		for i < raw.len() {
			let b = raw[i]
			if b == byte('%') {
				fail MimeError{message: "bad percent escape in parameter", op: "parse", text: text} when i + 2 >= raw.len() || !char(raw[i + 1]).isHexDigit() || !char(raw[i + 2]).isHexDigit()
				out.push(byte(char(raw[i + 1]).digitValue(16) * 16 + char(raw[i + 2]).digitValue(16)))
				i += 3
				continue
			}
			out.push(b)
			i++
		}
		return out
	}

	// decodeCharset reads bytes in one of the charsets a header may use.
	internal def decodeCharset(bytes byte[], charset string, text string) !string {
		let name = charset == "" ?? ("utf-8", charset)
		return string(bytes) when name := "utf-8" || "utf8" || "us-ascii" || "ascii"
		if name := "iso-8859-1" || "latin1" || "latin-1" {
			let out = ""
			for let b in bytes {
				out += string(char(b))
			}
			return out
		}
		fail MimeError{message: "unsupported charset '{charset}' in parameter", op: "parse", text: text}
	}

	// lastIndexOf finds the last occurrence of needle in text, -1 when absent.
	internal def lastIndexOf(text string, needle string) int {
		let last = -1
		let at = text.indexOf(needle)
		for at >= 0 {
			last = at
			at = text.indexOf(needle, at + 1)
		}
		return last
	}

	// orEmpty reads an optional lookup as text, "" when absent.
	internal def orEmpty(value ?string) string {
		return "" when value is none
		return value
	}

	internal def orNoStrings(list ?string[]) string[] {
		return [] when list is none
		return list
	}

	internal def orNoParams(list ?RawParam[]) RawParam[] {
		return [] when list is none
		return list
	}

	// isToken reports an RFC 2045 token: printable ASCII without spaces,
	// controls or the tspecials `()<>@,;:\"/[]?=`.
	internal def isToken(text string) bool {
		return false when text == ""
		for let i = 0; i < text.len(); i++ {
			return false unless isTokenChar(text[i])
		}
		return true
	}

	internal def isTokenChar(c char) bool {
		return false unless c.isASCII()
		return false when c <= ' ' || c == '\u007F'
		return "()<>@,;:\\\"/[]?=".indexOf(string(c)) < 0
	}

	// formatMediaType renders `type/subtype` with the parameters, the same
	// as `MediaType.str()` for callers that hold the parts separately. An
	// empty string is returned when the type or a parameter name is not a
	// valid token.
	def formatMediaType(mainType string, subtype string, params map<string, string> = map<string, string>{}) string {
		let lowerType = mainType.lower()
		let lowerSub = subtype.lower()
		return "" unless isToken(lowerType) && (lowerSub == "" || isToken(lowerSub))
		let out = lowerSub == "" ?? (lowerType, lowerType + "/" + lowerSub)
		let names string[] = []
		for let (name, _) in params {
			names.push(name.lower())
		}
		names.sort((a, b) => a < b)
		for let name in names {
			return "" unless isToken(name)
			let value = orEmpty(params.get(name))
			if isToken(value) {
				out += "; " + name + "=" + value
				continue
			}
			if isQuotable(value) {
				out += "; " + name + "=\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
				continue
			}
			out += "; " + name + "*=utf-8''" + percentEncode(value.bytes())
		}
		return out
	}

	// isQuotable reports a value a quoted-string can carry: printable ASCII,
	// space and tab, no CR or LF.
	internal def isQuotable(value string) bool {
		for let i = 0; i < value.len(); i++ {
			let c = value[i]
			return false unless c.isASCII()
			return false when (c < ' ' && c != '\t') || c == '\u007F'
		}
		return true
	}

	// percentEncode writes every byte outside the RFC 2231 attribute-char
	// set as `%XX`.
	internal def percentEncode(bytes byte[]) string {
		let out = ""
		for let b in bytes {
			let c = char(b)
			if c.isASCII() && (c.isAlphanumeric() || (c := '-' || '.' || '_' || '~')) {
				out += string(c)
				continue
			}
			out += "%" + hexByte(b)
		}
		return out
	}

	internal def hexByte(b byte) string {
		let digits = "0123456789ABCDEF"
		return string(digits[int(b) / 16]) + string(digits[int(b) % 16])
	}

	// typeByExtension returns the media type registered for a file
	// extension, with or without the leading dot and in any case (`.JSON`
	// and `json` both give `application/json`). Text types carry
	// `charset=utf-8`. None when the extension is unknown.
	//
	// Example:
	// ```example
	// println(formats.typeByExtension(".png"))   // image/png
	// println(formats.typeByExtension("html"))   // text/html; charset=utf-8
	// println(formats.typeByExtension(".zzz"))   // none
	// ```
	def typeByExtension(ext string) ?string {
		let key = normalizeExtension(ext)
		return none when key == ""
		extensionTable.loadSystemTables()
		return extensionTable.byExtension.get(key)
	}

	// normalizeExtension lower-cases an extension and gives it its dot.
	internal def normalizeExtension(ext string) string {
		let e = ext.trim().lower()
		return "" when e := "" || "."
		return e.startsWith(".") ?? (e, "." + e)
	}

	// typeByName returns the media type for a file name or path from its
	// last extension, none when it has none or it is unknown.
	//
	// Example:
	// ```example
	// println(formats.typeByName("site/assets/app.min.js"))  // text/javascript; charset=utf-8
	// ```
	def typeByName(name string) ?string {
		let slash = lastIndexOf(name, "/")
		let base = slash < 0 ?? (name, name[slash + 1:])
		let dot = lastIndexOf(base, ".")
		return none when dot < 0 || dot == base.len() - 1
		return typeByExtension(base[dot:])
	}

	// extensionsByType lists the extensions (with dots, preferred first)
	// registered for a media type; parameters on the argument are ignored.
	// Empty when the type is unknown.
	//
	// Example:
	// ```example
	// println(formats.extensionsByType("image/jpeg"))  // [".jpg", ".jpeg", ".jpe"]
	// ```
	def extensionsByType(mediaType string) string[] {
		let mt = parseMediaType(mediaType) onerror recover new MediaType("", "")
		return [] when mt.mainType == ""
		extensionTable.loadSystemTables()
		return orNoStrings(extensionTable.byType.get(mt.essence())).clone()
	}

	// addExtensionType registers or replaces the media type for an
	// extension, for a program that serves files the table does not know.
	// The extension must start with a dot; the type must parse. Fails with
	// MimeError (op "extension") otherwise.
	//
	// Example:
	// ```example
	// try formats.addExtensionType(".adm", "text/x-adm; charset=utf-8")
	// ```
	def addExtensionType(ext string, mediaType string) !none {
		fail MimeError{message: "extension must start with a dot", op: "extension", text: ext} unless ext.startsWith(".") && ext.len() > 1
		let mt = parseMediaType(mediaType) onerror (err error) {
			fail MimeError{message: "media type does not parse: {mediaType}", op: "extension", text: ext, cause: err}
		}
		extensionTable.loadSystemTables()
		extensionTable.register(ext.lower(), mt.str())
		return none
	}

	// ExtensionTable maps extensions to media types and back. A small
	// built-in table covers the web types every program needs; the first
	// lookup merges the system's tables on top (`/etc/mime.types`, the
	// Apache copies, and shared-mime-info's `globs2`), when they exist and
	// the policy lets the program read them. Text types carry
	// `charset=utf-8`.
	internal type ExtensionTable {
		byExtension     map<string, string>
		byType          map<string, string[]>
		internal loaded bool                  = false

		def new() {
			self.byExtension = map<string, string>{}
			self.byType = map<string, string[]>{}
			for let entry in builtinTypes() {
				let (ext, mediaType) = entry
				register(ext, mediaType)
			}
		}

		// loadSystemTables reads the platform tables once. Entries never
		// override the built-in ones or a program's `addExtensionType`, and
		// a file that is missing or unreadable is skipped.
		def loadSystemTables() {
			return when loaded
			loaded = true
			for let path in ["/etc/mime.types", "/etc/apache2/mime.types", "/etc/apache/mime.types", "/usr/local/etc/mime.types"] {
				let data = os.readFile(path) onerror recover []
				loadMimeTypes(string(data)) unless data.isEmpty()
			}
			for let path in ["/usr/share/mime/globs2", "/usr/local/share/mime/globs2"] {
				let data = os.readFile(path) onerror recover []
				loadGlobs(string(data)) unless data.isEmpty()
			}
		}

		// loadMimeTypes reads the `type ext ext ...` lines of a mime.types
		// file.
		internal def loadMimeTypes(text string) {
			for let line in text.lines() {
				let hash = line.indexOf("#")
				let body = (hash < 0 ?? (line, line[:hash])).trim()
				continue when body == ""
				let fields = body.words()
				continue when fields.len() < 2
				let mediaType = fields[0].lower()
				continue when mediaType.indexOf("/") < 0
				for let i = 1; i < fields.len(); i++ {
					registerSystem("." + fields[i].lower(), mediaType)
				}
			}
		}

		// loadGlobs reads shared-mime-info's `weight:type:*.ext` lines;
		// patterns that are not a plain extension are skipped.
		internal def loadGlobs(text string) {
			for let line in text.lines() {
				continue when line.startsWith("#") || line.trim() == ""
				let parts = line.split(":")
				continue when parts.len() < 3
				let mediaType = parts[1].lower()
				let pattern = parts[2]
				continue unless pattern.startsWith("*.") && pattern.len() > 2
				let ext = pattern[1:]
				continue when ext.indexOf("*") >= 0 || ext.indexOf("?") >= 0 || ext.indexOf("[") >= 0
				registerSystem(ext.lower(), mediaType)
			}
		}

		// registerSystem adds a system entry unless the extension is known
		// already; text types get the charset the built-in entries carry.
		internal def registerSystem(ext string, mediaType string) {
			return when byExtension.hasKey(ext)
			let full = mediaType.startsWith("text/") ?? (mediaType + "; charset=utf-8", mediaType)
			register(ext, full)
		}

		// register maps an extension to a type and appends the extension to
		// the type's list; the first registered extension stays preferred.
		def register(ext string, mediaType string) {
			let previous = byExtension.get(ext)
			byExtension.set(ext, mediaType)
			let essence = essenceOf(mediaType)
			if previous is none {} else {
				let oldEssence = essenceOf(previous)
				return when oldEssence == essence
				let old = orNoStrings(byType.get(oldEssence))
				byType.set(oldEssence, old.filter(e => e != ext))
			}
			let list = orNoStrings(byType.get(essence))
			list.push(ext) unless list.includes(ext)
			byType.set(essence, list)
		}

		internal def essenceOf(mediaType string) string {
			let semi = mediaType.indexOf(";")
			return (semi < 0 ?? (mediaType, mediaType[:semi])).trim().lower()
		}
	}

	internal let extensionTable = new ExtensionTable()

	// builtinTypes is the table every program has without system files:
	// the web set, in the order extensions are listed for a type (the first
	// one is preferred).
	internal def builtinTypes() (string, string)[] {
		return [
			(".html", "text/html; charset=utf-8"), (".htm", "text/html; charset=utf-8"),
			(".css", "text/css; charset=utf-8"), (".js", "text/javascript; charset=utf-8"),
			(".mjs", "text/javascript; charset=utf-8"), (".txt", "text/plain; charset=utf-8"),
			(".md", "text/markdown; charset=utf-8"), (".csv", "text/csv; charset=utf-8"),
			(".xml", "text/xml; charset=utf-8"), (".adm", "text/x-adm; charset=utf-8"),
			(".json", "application/json"), (".yaml", "application/yaml"), (".yml", "application/yaml"),
			(".toml", "application/toml"), (".wasm", "application/wasm"), (".pdf", "application/pdf"),
			(".zip", "application/zip"), (".gz", "application/gzip"), (".tar", "application/x-tar"),
			(".bin", "application/octet-stream"), (".svg", "image/svg+xml"),
			(".png", "image/png"), (".jpg", "image/jpeg"), (".jpeg", "image/jpeg"), (".jpe", "image/jpeg"),
			(".gif", "image/gif"), (".webp", "image/webp"), (".avif", "image/avif"), (".ico", "image/vnd.microsoft.icon"),
			(".mp3", "audio/mpeg"), (".ogg", "audio/ogg"), (".wav", "audio/wav"), (".mp4", "video/mp4"),
			(".webm", "video/webm"), (".ttf", "font/ttf"), (".otf", "font/otf"), (".woff", "font/woff"), (".woff2", "font/woff2"),
		]
	}

	// detectContentType guesses the media type of content from its first
	// bytes, the way a browser sniffs (the WHATWG MIME sniffing algorithm,
	// as `http.DetectContentType` implements it): HTML, XML (with SVG told
	// apart), PDF, PostScript, the image, audio, video and archive
	// signatures, UTF-8/16 text with a BOM; then the system's magic
	// database (shared-mime-info `magic`, when present and readable) for
	// everything else it knows; plain text otherwise, and
	// `application/octet-stream` when the data looks binary. The WHATWG
	// rules read the first 512 bytes, the magic rules up to 4 KiB. Never
	// fails, always answers a valid type.
	//
	// Example:
	// ```example
	// let data = try os.readFile("photo")
	// println(formats.detectContentType(data))  // image/jpeg
	// println(formats.detectContentType("hello".bytes()))  // text/plain; charset=utf-8
	// ```
	def detectContentType(data byte[]) string {
		let head = data.len() > 512 ?? (data.slice(0, 512), data)
		return "text/plain; charset=utf-16be" when startsWith(head, [0xFE, 0xFF])
		return "text/plain; charset=utf-16le" when startsWith(head, [0xFF, 0xFE])
		return "text/plain; charset=utf-8" when startsWith(head, [0xEF, 0xBB, 0xBF])
		let skipped = skipLeadingSpace(head)
		for let tag in htmlTags() {
			return "text/html; charset=utf-8" when matchesTag(skipped, tag)
		}
		// The sniffing algorithm stops at the XML declaration, which is why
		// servers built on it answer `text/xml` for an SVG and browsers then
		// refuse to render it inline. A root `<svg` element after the
		// prologue (declaration, comments, DOCTYPE) is an image.
		return "image/svg+xml" when isSVG(skipped)
		return "text/xml; charset=utf-8" when startsWith(skipped, "<?xml".bytes())
		return "application/pdf" when startsWith(head, "%PDF-".bytes())
		return "application/postscript" when startsWith(head, "%!PS-Adobe-".bytes())
		for let sig in signatures() {
			let (prefix, mediaType) = sig
			return mediaType when startsWith(head, prefix)
		}
		return "image/webp" when head.len() >= 14 && startsWith(head, "RIFF".bytes()) && startsWith(head.slice(8, 6), "WEBPVP".bytes())
		return "audio/wave" when head.len() >= 12 && startsWith(head, "RIFF".bytes()) && startsWith(head.slice(8, 4), "WAVE".bytes())
		return "video/avi" when head.len() >= 12 && startsWith(head, "RIFF".bytes()) && startsWith(head.slice(8, 4), "AVI ".bytes())
		return "audio/aiff" when head.len() >= 12 && startsWith(head, "FORM".bytes()) && startsWith(head.slice(8, 4), "AIFF".bytes())
		return "video/mp4" when head.len() >= 12 && startsWith(head.slice(4, 4), "ftyp".bytes())
		let known = magicTable.lookup(data.len() > 4096 ?? (data.slice(0, 4096), data))
		if known is none {} else {
			return known + "; charset=utf-8" when known.startsWith("text/")
			return known
		}
		for let b in head {
			return "application/octet-stream" when isBinaryByte(b)
		}
		return "text/plain; charset=utf-8"
	}

	// MagicRule is one line of a shared-mime-info magic section: the bytes
	// expected at an offset (tried over `span` start positions), through a
	// mask when one is given; `indent` nests it under the rule before it.
	internal struct MagicRule {
		indent int
		offset int
		value  byte[]
		mask   byte[]
		span   int
	}

	// MagicSection is one `[priority:type]` block and its rules.
	internal struct MagicSection {
		priority  int
		mediaType string
		rules     MagicRule[]
	}

	// MagicTable is the system's magic database, read once on first use:
	// shared-mime-info's `magic` file (`[priority:type]` headers, rules
	// `>offset=<len><bytes>[&mask][~word][+range]`, nested by a leading
	// indent number). Sections are tried highest priority first.
	internal type MagicTable {
		internal sections MagicSection[] = []
		internal loaded   bool           = false

		def new() {}

		// lookup returns the type of the first section whose rules match,
		// none when nothing does or no database could be read.
		def lookup(data byte[]) ?string {
			load()
			for let section in sections {
				return section.mediaType when matchRules(section.rules, 0, 0, data)
			}
			return none
		}

		// matchRules reports whether any rule at `indent`, starting at
		// index `from`, matches together with one of its children.
		internal def matchRules(rules MagicRule[], from int, indent int, data byte[]) bool {
			let i = from
			for i < rules.len() {
				let rule = rules[i]
				return false when rule.indent < indent
				if rule.indent > indent {
					i++
					continue
				}
				if matchRule(rule, data) {
					let child = i + 1
					return true when child >= rules.len() || rules[child].indent <= indent
					return true when matchRules(rules, child, indent + 1, data)
				}
				i++
			}
			return false
		}

		internal def matchRule(rule MagicRule, data byte[]) bool {
			let n = rule.value.len()
			for let start = rule.offset; start < rule.offset + rule.span; start++ {
				continue when start < 0 || start + n > data.len()
				let ok = true
				for let k = 0; k < n; k++ {
					let m = rule.mask.len() == n ?? (rule.mask[k], byte(0xFF))
					if (data[start + k] & m) != (rule.value[k] & m) {
						ok = false
						break
					}
				}
				return true when ok
			}
			return false
		}

		// load reads the first database found; a missing or unreadable file
		// leaves the table empty.
		internal def load() {
			return when loaded
			loaded = true
			for let path in ["/usr/share/mime/magic", "/usr/local/share/mime/magic"] {
				let data = os.readFile(path) onerror recover []
				continue when data.isEmpty()
				parse(data)
				break
			}
			sections.sort((a, b) => a.priority > b.priority)
		}

		internal def parse(data byte[]) {
			let i = 0
			let header = "MIME-Magic".bytes()
			i = header.len() + 1 when startsWith(data, header)
			let current MagicRule[] = []
			let priority = 0
			let mediaType = ""
			for i < data.len() {
				let b = data[i]
				if b == 0x5B {
					sections.push(MagicSection{priority: priority, mediaType: mediaType, rules: current}) when mediaType != ""
					current = []
					let close = indexOfBytes(data, "]".bytes(), i)
					break when close < 0
					let head string = string(data.slice(i + 1, close - i - 1))
					let colon = head.indexOf(":")
					if colon < 0 {
						priority = 50
						mediaType = head.lower()
					} else {
						let number string = head[:colon]
						let name string = head[colon + 1:]
						priority = number.toInt<int>()
						mediaType = name.lower()
					}
					i = close + 1
					i++ when i < data.len() && data[i] == 0x0A
					continue
				}
				if b == 0x0A {
					i++
					continue
				}
				// Rule: [indent]>offset=<2-byte length><value>[&mask][~word][+range]\n
				let indent = 0
				for i < data.len() && char(data[i]).isDigit() {
					indent = indent * 10 + char(data[i]).digitValue()
					i++
				}
				break unless i < data.len() && data[i] == 0x3E
				i++
				let offset = 0
				for i < data.len() && char(data[i]).isDigit() {
					offset = offset * 10 + char(data[i]).digitValue()
					i++
				}
				break unless i + 2 < data.len() && data[i] == 0x3D
				let n = int(data[i + 1]) * 256 + int(data[i + 2])
				i += 3
				break when i + n > data.len()
				let value = data.slice(i, n)
				i += n
				let mask byte[] = []
				let span = 1
				for i < data.len() && data[i] != 0x0A {
					if data[i] == 0x26 && i + 1 + n <= data.len() {
						mask = data.slice(i + 1, n)
						i += 1 + n
						continue
					}
					if data[i] == 0x2B {
						i++
						let r = 0
						for i < data.len() && char(data[i]).isDigit() {
							r = r * 10 + char(data[i]).digitValue()
							i++
						}
						span = r when r > 0
						continue
					}
					if data[i] == 0x7E {
						i++
						for i < data.len() && char(data[i]).isDigit() {
							i++
						}
						continue
					}
					i++
				}
				i++
				current.push(MagicRule{indent: indent, offset: offset, value: value, mask: mask, span: span})
			}
			sections.push(MagicSection{priority: priority, mediaType: mediaType, rules: current}) when mediaType != ""
		}
	}

	internal let magicTable = new MagicTable()

	// isSVG reports an XML document whose root element is `svg` (with or
	// without a namespace prefix), looking past the declaration, comments,
	// processing instructions and the DOCTYPE.
	internal def isSVG(data byte[]) bool {
		let i = 0
		for i < data.len() {
			let rest = data.slice(i, data.len() - i)
			if startsWith(rest, "<?".bytes()) {
				let end = indexOfBytes(data, "?>".bytes(), i)
				return false when end < 0
				i = end + 2
			} else if startsWith(rest, "<!--".bytes()) {
				let end = indexOfBytes(data, "-->".bytes(), i)
				return false when end < 0
				i = end + 3
			} else if startsWith(rest, "<!".bytes()) {
				let end = indexOfBytes(data, ">".bytes(), i)
				return false when end < 0
				i = end + 1
			} else if rest[0] == 0x3C {
				// The element name runs to the first space, `>` or `/`; a
				// colon inside it is a namespace prefix (`svg:svg`).
				let name = i + 1
				let end = name
				for end < data.len() && !(data[end] := 0x20 || 0x09 || 0x0A || 0x0D || 0x3E || 0x2F) {
					end++
				}
				for let k = name; k < end; k++ {
					if data[k] == 0x3A {
						name = k + 1
						break
					}
				}
				let tag = data.slice(name, end - name)
				return tag.len() == 3 && startsWith(tag, "svg".bytes())
			} else if rest[0] == 0x20 || rest[0] == 0x09 || rest[0] == 0x0A || rest[0] == 0x0D {
				i++
			} else {
				return false
			}
		}
		return false
	}

	internal def indexOfBytes(data byte[], needle byte[], from int) int {
		for let i = from; i + needle.len() <= data.len(); i++ {
			return i when startsWith(data.slice(i, data.len() - i), needle)
		}
		return -1
	}

	internal def startsWith(data byte[], prefix byte[]) bool {
		return false when data.len() < prefix.len()
		for let i = 0; i < prefix.len(); i++ {
			return false when data[i] != prefix[i]
		}
		return true
	}

	internal def skipLeadingSpace(data byte[]) byte[] {
		let i = 0
		for i < data.len() && (data[i] == 0x20 || data[i] == 0x09 || data[i] == 0x0A || data[i] == 0x0D || data[i] == 0x0C) {
			i++
		}
		return data.slice(i, data.len() - i)
	}

	// matchesTag compares case-insensitively and requires a space or `>`
	// after the tag, as the sniffing algorithm does.
	internal def matchesTag(data byte[], tag string) bool {
		let want = tag.bytes()
		return false when data.len() < want.len() + 1
		for let i = 0; i < want.len(); i++ {
			let a = data[i]
			let b = want[i]
			let lowerA = (a >= 0x41 && a <= 0x5A) ?? (a + 0x20, a)
			let lowerB = (b >= 0x41 && b <= 0x5A) ?? (b + 0x20, b)
			return false when lowerA != lowerB
		}
		let next = data[want.len()]
		return next == 0x20 || next == 0x3E
	}

	internal def htmlTags() string[] {
		return ["<!DOCTYPE HTML", "<HTML", "<HEAD", "<SCRIPT", "<IFRAME", "<H1", "<DIV", "<FONT", "<TABLE", "<A", "<STYLE", "<TITLE", "<B", "<BODY", "<BR", "<P", "<!--"]
	}

	// signatures lists the magic-byte prefixes and the types they identify.
	internal def signatures() (byte[], string)[] {
		return [
			([0x00, 0x00, 0x01, 0x00], "image/x-icon"),
			([0x00, 0x00, 0x02, 0x00], "image/x-icon"),
			("BM".bytes(), "image/bmp"),
			("GIF87a".bytes(), "image/gif"),
			("GIF89a".bytes(), "image/gif"),
			([0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A], "image/png"),
			([0xFF, 0xD8, 0xFF], "image/jpeg"),
			([0x00, 0x01, 0x00, 0x00], "font/ttf"),
			("OTTO".bytes(), "font/otf"),
			("ttcf".bytes(), "font/collection"),
			("wOFF".bytes(), "font/woff"),
			("wOF2".bytes(), "font/woff2"),
			(".snd".bytes(), "audio/basic"),
			("ID3".bytes(), "audio/mpeg"),
			([0xFF, 0xFB], "audio/mpeg"),
			("OggS".bytes(), "application/ogg"),
			("MThd".bytes(), "audio/midi"),
			([0x1A, 0x45, 0xDF, 0xA3], "video/webm"),
			([0x1F, 0x8B, 0x08], "application/x-gzip"),
			("PK\u0003\u0004".bytes(), "application/zip"),
			("Rar!\u001A\u0007".bytes(), "application/x-rar-compressed"),
			([0x00, 0x61, 0x73, 0x6D], "application/wasm"),
			([0x25, 0x50, 0x44, 0x46], "application/pdf"),
		]
	}

	// isBinaryByte is the sniffing algorithm's "binary data byte": a control
	// character that text never carries.
	internal def isBinaryByte(b byte) bool {
		return true when b <= 0x08
		return true when b == 0x0B
		return true when b >= 0x0E && b <= 0x1A
		return b >= 0x1C && b <= 0x1F
	}
}
