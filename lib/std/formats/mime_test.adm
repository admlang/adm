partial module std.formats {
	use std.testing

	// orText reads an optional lookup as text, "" when absent.
	internal def orText(value ?string) string {
		return "" when value is none
		return value
	}

	check "MediaType" {
		@test()
		def parsesTypeAndParams() !none {
			let mt = try parseMediaType("Text/HTML; Charset=\"utf-8\"; q=0.8")
			assert mt.mainType == "text"
			assert mt.subtype == "html"
			assert mt.essence() == "text/html"
			assert orText(mt.charset()) == "utf-8"
			assert orText(mt.param("Q")) == "0.8"
			assert mt.param("missing") is none
			assert mt.isText()
			assert !mt.isMultipart()
			assert mt.str() == "text/html; charset=utf-8; q=0.8"
			return none
		}

		@test()
		def quotedValuesAndEscapes() !none {
			let mt = try parseMediaType("text/plain; filename=\"a \\\"b\\\" c.txt\"")
			assert orText(mt.param("filename")) == "a \"b\" c.txt"
			assert mt.str() == "text/plain; filename=\"a \\\"b\\\" c.txt\""
			return none
		}

		@test()
		def rfc2231ContinuationsAndCharset() !none {
			let mt = try parseMediaType("application/x-stuff; title*0*=us-ascii'en'This%20is%20; title*1*=%2A%2A%2Afun%2A%2A%2A%20; title*2=\"isn't it!\"")
			assert orText(mt.param("title")) == "This is ***fun*** isn't it!"
			let latin = try parseMediaType("text/plain; name*=iso-8859-1''caf%E9")
			assert orText(latin.param("name")) == "café"
			return none
		}

		@test()
		def formatsNonTokenValues() !none {
			let mt = new MediaType("Image", "PNG", map<string, string>{"name": "with space", "x": "café", "plain": "token"})
			assert mt.str() == "image/png; name=\"with space\"; plain=token; x*=utf-8''caf%C3%A9"
			assert formatMediaType("text", "bad type") == ""
			assert formatMediaType("text", "plain", map<string, string>{"bad name": "v"}) == ""
			return none
		}

		@test()
		def rejectsMalformed() !none {
			assert parseMediaType("text/") is error
			assert parseMediaType("/html") is error
			assert parseMediaType("text/html; charset") is error
			assert parseMediaType("text/html; a=1; a=2") is error
			assert parseMediaType("text/html; a=\"open") is error
			assert parseMediaType("te xt/html") is error
			let mt = parseMediaType("no pe") onerror (e error) {
				assert e is MimeError
				recover new MediaType("x", "y")
			}
			assert mt.essence() == "x/y"
			return none
		}

		@test()
		def matchesPatternsAndMultipart() !none {
			let mt = try parseMediaType("multipart/form-data; boundary=\"xYz--1\"")
			assert mt.isMultipart()
			assert orText(mt.boundary()) == "xYz--1"
			let disposition = try parseMediaType("form-data; name=\"photo\"; filename=\"a.jpg\"")
			assert disposition.mainType == "form-data"
			assert disposition.subtype == ""
			assert disposition.essence() == "form-data"
			assert orText(disposition.param("filename")) == "a.jpg"
			assert disposition.str() == "form-data; filename=a.jpg; name=photo"
			assert mt.matches("multipart/*")
			assert mt.matches("*/*")
			assert mt.matches("MULTIPART/form-data")
			assert !mt.matches("text/*")
			assert !mt.matches("multipart")
			let json = try parseMediaType("application/vnd.api+json")
			assert json.isText()
			let with = json.with("charset", "utf-8")
			assert orText(with.charset()) == "utf-8"
			assert json.charset() is none
			assert with.with("charset", "").charset() is none
			return none
		}
	}

	check "Extension table" {
		@test()
		def looksUpBothWays() !none {
			assert orText(typeByExtension(".png")) == "image/png"
			assert orText(typeByExtension("PNG")) == "image/png"
			assert orText(typeByExtension("html")) == "text/html; charset=utf-8"
			assert typeByExtension(".zzz") is none
			assert typeByExtension("") is none
			assert orText(typeByName("site/assets/app.min.js")) == "text/javascript; charset=utf-8"
			assert typeByName("Makefile") is none
			assert typeByName("dir.d/file") is none
			// The built-in order comes first; the system tables may append more.
			let jpeg = extensionsByType("image/jpeg")
			assert jpeg.len() >= 3
			assert jpeg.slice(0, 3).equals([".jpg", ".jpeg", ".jpe"])
			assert extensionsByType("image/jpeg; q=1").equals(jpeg)
			assert extensionsByType("no/such").len() == 0
			assert extensionsByType("garbage").len() == 0
			return none
		}

		@test()
		def registersNewTypes() !none {
			try addExtensionType(".zzz", "application/x-zzz")
			assert orText(typeByExtension(".zzz")) == "application/x-zzz"
			assert extensionsByType("application/x-zzz").equals([".zzz"])
			try addExtensionType(".zzz", "application/x-yyy; charset=utf-8")
			assert orText(typeByExtension("zzz")) == "application/x-yyy; charset=utf-8"
			assert extensionsByType("application/x-zzz").len() == 0
			assert extensionsByType("application/x-yyy").equals([".zzz"])
			assert addExtensionType("zzz", "text/plain") is error
			assert addExtensionType(".zzz", "no pe") is error
			return none
		}
	}

	check "Content sniffing" {
		@test()
		def detectsCommonTypes() !none {
			assert detectContentType("hello, world".bytes()) == "text/plain; charset=utf-8"
			assert detectContentType("  <!DOCTYPE html><html>".bytes()) == "text/html; charset=utf-8"
			assert detectContentType("<HTML>".bytes()) == "text/html; charset=utf-8"
			// Not HTML for the WHATWG rules (no space or `>` after the tag);
			// the system magic database may still call it HTML.
			let htmlx = detectContentType("<htmlx>".bytes())
			assert htmlx == "text/plain; charset=utf-8" || htmlx == "text/html; charset=utf-8"
			assert detectContentType("<?xml version=\"1.0\"?>".bytes()) == "text/xml; charset=utf-8"
			assert detectContentType("<?xml version=\"1.0\"?><note><to>a</to></note>".bytes()) == "text/xml; charset=utf-8"
			assert detectContentType("<svg xmlns=\"http://www.w3.org/2000/svg\"><rect/></svg>".bytes()) == "image/svg+xml"
			assert detectContentType("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- made by hand -->\n<!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\" \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\">\n<svg width=\"10\"/>".bytes()) == "image/svg+xml"
			assert detectContentType("  <svg:svg xmlns:svg=\"http://www.w3.org/2000/svg\"></svg:svg>".bytes()) == "image/svg+xml"
			let svgfoo = detectContentType("<svgfoo>".bytes())
			assert svgfoo == "text/plain; charset=utf-8" || svgfoo == "image/svg+xml"
			assert orText(typeByExtension(".svg")) == "image/svg+xml"
			assert detectContentType("%PDF-1.7".bytes()) == "application/pdf"
			assert detectContentType([0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00]) == "image/png"
			assert detectContentType([0xFF, 0xD8, 0xFF, 0xE0]) == "image/jpeg"
			assert detectContentType("GIF89a".bytes()) == "image/gif"
			// RIFF....WEBPVP
			assert detectContentType([0x52, 0x49, 0x46, 0x46, 0, 0, 0, 0, 0x57, 0x45, 0x42, 0x50, 0x56, 0x50]) == "image/webp"
			assert detectContentType([0x1F, 0x8B, 0x08, 0x00]) == "application/x-gzip"
			assert detectContentType([0x50, 0x4B, 0x03, 0x04, 0x41]) == "application/zip"
			assert detectContentType([0xEF, 0xBB, 0xBF, 0x41]) == "text/plain; charset=utf-8"
			assert detectContentType([0xFE, 0xFF, 0x00, 0x41]) == "text/plain; charset=utf-16be"
			// Beyond the built-in rules the system magic database answers when
			// it is there; without it the binary fallback applies.
			let elf = detectContentType([0x7F, 0x45, 0x4C, 0x46, 0x02, 0x01, 0x01, 0x00, 0, 0, 0, 0, 0, 0, 0, 0, 0x02, 0x00])
			assert elf == "application/octet-stream" || elf.startsWith("application/x-")
			let sqlite = detectContentType("SQLite format 3".bytes().concat([0x00, 0x10, 0x00]))
			assert sqlite == "application/octet-stream" || sqlite == "application/vnd.sqlite3"
			let flac = detectContentType("fLaC".bytes().concat([0x00, 0x00, 0x00, 0x22]))
			assert flac == "application/octet-stream" || flac == "audio/flac"
			let script = detectContentType("#!/bin/sh\necho hi\n".bytes())
			assert script := "text/plain; charset=utf-8" || "application/x-shellscript" || "text/x-shellscript; charset=utf-8"
			assert detectContentType([]) == "text/plain; charset=utf-8"
			return none
		}
	}
}
