internal partial module std.formats.mime {
	use (
		std.testing
		std.formats
	)

	check "Media types on Windows" {
		// Extensions Windows registers and the built-in table lacks come from
		// the registry, in mime.types form.
		@test()
		def registryTypesAreLookedUp() !none {
			let avi = formats.typeByExtension(".avi")
			assert !(avi is none) && string(avi).startsWith("video/")
			let flac = formats.typeByExtension(".flac")
			assert !(flac is none) && string(flac).startsWith("audio/")
			let js = formats.typeByExtension(".js")
			assert !(js is none) && string(js) == "text/javascript; charset=utf-8"
			let lines = systemTypeText()
			assert lines.contains(" avi\n") && !lines.contains(";")
			return none
		}
	}
}
