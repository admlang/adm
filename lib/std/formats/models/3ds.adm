partial module std.formats.models {
	use std.io

	// ThreeDS is Autodesk 3D Studio `.3ds`: a tree of binary chunks holding
	// meshes (positions, one texture coordinate set, triangle faces with
	// smoothing groups, a face-to-material map), materials with Phong colours
	// and texture maps named by file, cameras, lights, and keyframe tracks
	// placing the objects. Reads it all into a Z-up model, textures through the
	// ResourceReader; writes meshes, materials, cameras, lights and the
	// hierarchy with a position, rotation and scale track per node. Names are
	// cut to the format's 10 characters.
	@codec("3D Studio")
	type ThreeDS {
		mimeType string[] {
			def get() string[] {
				return string["application/x-3ds", "image/x-3ds"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".3ds"]
			}
		}

		// matchSignature tests for the main chunk id, 0x4D4D.
		def matchSignature(r io.Reader) bool {
			let b = prefix(r, 2)
			return b.len() == 2 && b[0] == 0x4D && b[1] == 0x4D
		}

		// decode reads the whole reader as 3DS. Fails with a ModelError when the
		// main chunk is missing or a chunk runs past its parent, or with the
		// reader's own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {}

		// encode writes the model as 3DS, textures as files through resources
		// and by name only without one. Fails with the writer's own error, or a
		// texture file's.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {}
	}
}
