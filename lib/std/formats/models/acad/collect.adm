internal partial module std.formats.models.acad {
	use std.formats.models::*

	// The most vertices, and the most faces, a polyface mesh holds: its
	// counts and its faces' vertex numbers are 16-bit.
	const polyfaceLimit = 32767

	// The characters a layer's name may not hold.
	const layerNameRefused = "<>/\\\":;?*|=,`"

	// Collector makes a drawing of a model.
	type Collector {
		model   Model
		// Names follow the rules of releases before R13: at most 31 of
		// upper-case letters, digits, `$`, `-` and `_`.
		old     bool
		drawing Drawing
		// The layer names taken, in upper case.
		taken   map<string, bool>

		def new(model Model, old bool) {
			self.model = model
			self.old = old
			drawing = new Drawing()
			taken = new map<string, bool>()
		}

		// layerName is a name no layer has yet, from the node's: its
		// characters a layer's name may not hold as `_`, `Layer<n>` for none,
		// a number after it when taken.
		def layerName(name string, number int) string {
			let clean byte[]
			for let (_, c) in name.trim() {
				let refused = c < ' ' || layerNameRefused.contains(string(byte[].append(c)))
				if old {
					let upper = string(byte[].append(c)).upper()
					let b = upper.bytes()
					refused = b.len() != 1 || !((b[0] >= 0x41 && b[0] <= 0x5A) || (b[0] >= 0x30 && b[0] <= 0x39) || b[0] == 0x24 || b[0] == 0x2D || b[0] == 0x5F)
					clean.push(refused ?? (byte(0x5F), b[0]))
					continue
				}
				if refused {
					clean.push(0x5F)
				} else {
					clean.append(c)
				}
			}
			let base = string(clean)
			base = (old ?? ("LAYER", "Layer")) + "{number}" when base.len() == 0
			let limit = old ?? (31, 255)
			base = base[:limit] when base.len() > limit
			let made = base
			for let n = 2; taken.hasKey(made.upper()); n++ {
				let tail = "_{n}"
				made = (base.len() + tail.len() > limit ?? (base[:limit - tail.len()], base)) + tail
			}
			taken.set(made.upper(), true)
			return made
		}

		// collect makes the drawing: a layer per top-level node, holding
		// every mesh shown at the node and below it in scene coordinates
		// with z up, triangles as polyface meshes, lines as polylines in
		// space and points as points, each with its material's colour.
		def collect() Drawing {
			drawing.layer("0")
			let unit = unitCode(model.unit)
			drawing.header.set("INSUNITS", "{unit}")
			for let (i, root) in model.nodes {
				let layer = drawing.layer(layerName(root.name, i + 1))
				root.walk(def (node Node) bool {
					let mesh = node.mesh
					return true when mesh is none
					let m = node.worldTransform()
					for let (_, prim) in mesh.primitives {
						primitive(prim, m, layer.name)
					}
					return true
				})
			}
			return drawing
		}

		// primitive adds what a primitive draws, placed by the matrix.
		def primitive(prim Primitive, m matrix<float, 4, 4>, layer string) {
			let count = prim.vertexCount()
			return when count == 0
			let positions float[]
			positions.len(count * 3)
			let p = prim.positions
			for let v = 0; v < count; v++ {
				let x = float(p[v * 3])
				let y = float(p[v * 3 + 1])
				let z = float(p[v * 3 + 2])
				let wx = m[0][0] * x + m[0][1] * y + m[0][2] * z + m[0][3]
				let wy = m[1][0] * x + m[1][1] * y + m[1][2] * z + m[1][3]
				let wz = m[2][0] * x + m[2][1] * y + m[2][2] * z + m[2][3]
				// A drawing's z axis points up: the model's up axis is
				// turned onto it.
				match model.upAxis {
					case Axis.Y:
						positions[v * 3] = wx
						positions[v * 3 + 1] = -wz
						positions[v * 3 + 2] = wy
					case Axis.X:
						positions[v * 3] = wy
						positions[v * 3 + 1] = wz
						positions[v * 3 + 2] = wx
					case Axis.Z:
						positions[v * 3] = wx
						positions[v * 3 + 1] = wy
						positions[v * 3 + 2] = wz
				}
			}
			let aci = colorByLayer
			let rgb = -1
			let alpha = 255
			let material = prim.material
			if !(material is none) {
				let c = material.baseColor
				rgb = (int(c.red) << 16) | (int(c.green) << 8) | int(c.blue)
				aci = nearestAci(rgb)
				alpha = int(c.alpha)
				alpha = int((255.0 * (1.0 - material.transparency)).round().clamp(0.0, 255.0)) when alpha == 255 && material.transparency > 0
			}
			match prim.topology {
				case Topology.Triangles, Topology.TriangleStrip, Topology.TriangleFan:
					polyfaces(positions, prim.triangleIndices(), layer, aci, rgb, alpha)
				case Topology.Points:
					for let k = 0; k < prim.indexCount(); k++ {
						let v = drawnIndex(prim, k) * 3
						continue when v + 2 >= positions.len()
						let e = entity(EntityKind.Point, layer, aci, rgb, alpha)
						e.points.push(positions[v], positions[v + 1], positions[v + 2])
					}
				default:
					polylines(positions, prim, layer, aci, rgb, alpha)
			}
		}

		// drawnIndex is the vertex the k-th drawn index names.
		def drawnIndex(prim Primitive, k int) int {
			return int(prim.indices[k]) when prim.indices.len() > 0
			return k
		}

		def entity(kind EntityKind, layer string, aci int, rgb int, alpha int) Entity {
			let e = new Entity(kind)
			e.layer = layer
			e.aci = aci
			e.rgb = rgb
			e.alpha = alpha
			drawing.entities.push(e)
			return e
		}

		// polyfaces adds the triangles as polyface meshes, a new one when
		// the one being filled is full. A mesh holds the vertices its own
		// faces use.
		def polyfaces(positions float[], triangles uint32[], layer string, aci int, rgb int, alpha int) {
			let count = positions.len() / 3
			// The number each vertex has in the mesh being filled, 0 for
			// none, and the vertices that have one.
			let numbers int[]
			numbers.len(count)
			let used int[]
			return when triangles.len() < 3
			let mesh = entity(EntityKind.PolyfaceMesh, layer, aci, rgb, alpha)
			for let t = 0; t + 2 < triangles.len(); t += 3 {
				let a = int(triangles[t])
				let b = int(triangles[t + 1])
				let c = int(triangles[t + 2])
				continue when a >= count || b >= count || c >= count
				if mesh.points.len() / 3 + 3 > polyfaceLimit || mesh.faces.len() / 4 >= polyfaceLimit {
					for let (_, v) in used {
						numbers[v] = 0
					}
					used.len(0)
					mesh = entity(EntityKind.PolyfaceMesh, layer, aci, rgb, alpha)
				}
				for let (_, v) in int[a, b, c] {
					if numbers[v] == 0 {
						mesh.points.push(positions[v * 3], positions[v * 3 + 1], positions[v * 3 + 2])
						numbers[v] = mesh.points.len() / 3
						used.push(v)
					}
					mesh.faces.push(numbers[v])
				}
				mesh.faces.push(0)
			}
		}

		// polylines adds a primitive of lines as polylines in space: a
		// strip or a loop as one, separate segments as one per run in
		// which each starts where the one before ended, closed when the
		// run ends where it started.
		def polylines(positions float[], prim Primitive, layer string, aci int, rgb int, alpha int) {
			let count = positions.len() / 3
			let drawn = prim.indexCount()
			let paired = prim.topology == Topology.Lines
			let run int[]
			for let k = 0; k < drawn; k++ {
				let v = drawnIndex(prim, k)
				continue when v >= count
				if !paired {
					run.push(v)
					continue
				}
				// The first of a pair continues the run when it is the
				// run's last vertex, else starts a new one.
				if k % 2 == 0 {
					if run.len() > 0 && run[run.len() - 1] != v {
						polyline(positions, run, false, layer, aci, rgb, alpha)
						run.len(0)
					}
					run.push(v) when run.len() == 0
				} else {
					run.push(v)
				}
			}
			polyline(positions, run, prim.topology == Topology.LineLoop, layer, aci, rgb, alpha)
		}

		def polyline(positions float[], run int[], closed bool, layer string, aci int, rgb int, alpha int) {
			let n = run.len()
			if n > 3 && run[n - 1] == run[0] {
				closed = true
				n--
			}
			return when n < 2
			let e = entity(EntityKind.Polyline, layer, aci, rgb, alpha)
			e.closed = closed
			for let k = 0; k < n; k++ {
				let v = run[k] * 3
				e.points.push(positions[v], positions[v + 1], positions[v + 2])
			}
		}
	}
}
